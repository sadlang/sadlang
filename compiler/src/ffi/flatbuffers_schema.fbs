// ============================================================================
// FlatBuffers Schema — بروتوكول تبادل بيانات المترجم
// يُستخدم لنقل AST والتشخيصات بين المترجم والمحرر بكفاءة عالية
// ============================================================================

namespace sad.compiler;

// ──── التشخيصات ────

enum Severity : byte { Error = 0, Warning, Info, Hint }

table Position {
  line:int;
  column:int;
  offset:int;
}

table Range {
  start:Position;
  end:Position;
}

table Diagnostic {
  file:string;
  range:Range;
  severity:Severity;
  message:string;
  code:string;
  related:[RelatedInfo];
  fixes:[QuickFix];
}

table RelatedInfo {
  file:string;
  range:Range;
  message:string;
}

table QuickFix {
  title:string;
  edits:[TextEdit];
}

table TextEdit {
  file:string;
  range:Range;
  new_text:string;
}

// ──── نتائج الترجمة ────

table CompileResult {
  success:bool;
  output:string;
  errors:string;
  diagnostics:[Diagnostic];
  ir_output:string;
  elapsed_ms:double;
}

table CheckResult {
  success:bool;
  diagnostics:[Diagnostic];
  elapsed_ms:double;
}

// ──── الإكمال التلقائي ────

enum CompletionKind : byte {
  Function = 0, Variable, Type, Keyword, Snippet, Module, Field, Method, Property
}

table CompletionItem {
  label:string;
  label_ar:string;
  kind:CompletionKind;
  detail:string;
  documentation:string;
  insert_text:string;
  sort_priority:int;
}

table CompletionList {
  is_incomplete:bool;
  items:[CompletionItem];
}

// ──── Hover ────

table HoverInfo {
  contents:string;           // Markdown
  range:Range;
  type_signature:string;
  documentation:string;
  ownership_info:string;     // معلومات الملكية
}

// ──── التعريفات والمراجع ────

table Location {
  file:string;
  range:Range;
}

table DefinitionResult {
  locations:[Location];
}

table ReferencesResult {
  locations:[Location];
}

// ──── AST (مبسط للعرض) ────

enum NodeKind : byte {
  Function = 0, Variable, Type, Class, Trait, Enum, Match, If, Loop,
  Expression, Statement, Block, Import, Module
}

table AstNode {
  kind:NodeKind;
  name:string;
  range:Range;
  type_info:string;
  ownership:string;
  children:[AstNode];
}

table AstTree {
  file:string;
  root:AstNode;
}

// ──── رسالة الطلب/الاستجابة ────

enum RequestType : byte {
  Compile = 0, Check, Complete, Hover, GotoDefinition, References,
  GetAst, Format, Parse_Project, Build_Project
}

table Request {
  id:string;
  type:RequestType;
  file:string;
  line:int;
  column:int;
  options:string;  // JSON
}

table Response {
  id:string;
  type:RequestType;
  success:bool;
  payload:[ubyte];  // Nested FlatBuffer
  error:string;
  elapsed_ms:double;
}

root_type Response;
