# قياس أداء: البرمجة الكائنية
# Benchmark: Object-Oriented Programming
# يختبر: إنشاء الأصناف، الوراثة، استدعاء الدوال، هذا
# ============================================================================

صنف شكل
   باني(النوع)
      هذا.النوع = النوع
      هذا.اللون = "أحمر"
   نهاية

   دالة وصف()
      ارجع "شكل: " + هذا.النوع + " (لون: " + هذا.اللون + ")"
   نهاية
نهاية

صنف مستطيل يرث شكل
   باني(العرض, الارتفاع)
      الأساس("مستطيل")
      هذا.العرض = العرض
      هذا.الارتفاع = الارتفاع
   نهاية

   دالة المساحة()
      ارجع هذا.العرض * هذا.الارتفاع
   نهاية

   دالة المحيط()
      ارجع 2 * (هذا.العرض + هذا.الارتفاع)
   نهاية
نهاية

صنف دائرة يرث شكل
   باني(نصف_القطر)
      الأساس("دائرة")
      هذا.نصف_القطر = نصف_القطر
   نهاية

   دالة المساحة()
      ارجع 3.14159 * هذا.نصف_القطر * هذا.نصف_القطر
   نهاية

   دالة المحيط()
      ارجع 2 * 3.14159 * هذا.نصف_القطر
   نهاية
نهاية

صنف مثلث يرث شكل
   باني(القاعدة, الارتفاع)
      الأساس("مثلث")
      هذا.القاعدة = القاعدة
      هذا.الارتفاع = الارتفاع
   نهاية

   دالة المساحة()
      ارجع 0.5 * هذا.القاعدة * هذا.الارتفاع
   نهاية
نهاية

# --- التشغيل ---
اطبع_سطر("=== قياس أداء: البرمجة الكائنية ===")

# إنشاء كائنات
متغير م1 = جديد مستطيل(10, 5)
متغير د1 = جديد دائرة(7)
متغير ث1 = جديد مثلث(8, 6)

اطبع_سطر(م1.وصف())
اطبع_سطر("  المساحة: " + م1.المساحة())
اطبع_سطر("  المحيط: " + م1.المحيط())

اطبع_سطر(د1.وصف())
اطبع_سطر("  المساحة: " + د1.المساحة())
اطبع_سطر("  المحيط: " + د1.المحيط())

اطبع_سطر(ث1.وصف())
اطبع_سطر("  المساحة: " + ث1.المساحة())

# إنشاء كائنات متعددة
متغير أشكال = []
متغير ت = 0
بينما (ت < 20)
   إذا (ت % 3 == 0)
      أشكال = أشكال + [جديد مستطيل(ت + 1, ت + 2)]
   وإلا
      إذا (ت % 3 == 1)
         أشكال = أشكال + [جديد دائرة(ت + 1)]
      وإلا
         أشكال = أشكال + [جديد مثلث(ت + 1, ت + 2)]
      نهاية
   نهاية
   ت = ت + 1
نهاية

# حساب مجموع المساحات
متغير مجموع_المساحات = 0
لكل شكل في أشكال
   مجموع_المساحات = مجموع_المساحات + شكل.المساحة()
نهاية

اطبع_سطر("مجموع مساحات " + طول(أشكال) + " شكل: " + مجموع_المساحات)

اطبع_سطر("=== انتهى ===")
