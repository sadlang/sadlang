# ============================================================================
# قياس أداء: مطابقة الأنماط
# Benchmark: Pattern Matching
# يختبر: طابق/عندما، أنماط حرفية، نطاقات، افتراضي
# ============================================================================

دالة تصنيف_الدرجة(درجة)
   طابق (درجة)
      عندما 90..100:
         ارجع "ممتاز"
      عندما 80..89:
         ارجع "جيد جداً"
      عندما 70..79:
         ارجع "جيد"
      عندما 60..69:
         ارجع "مقبول"
      افتراضي:
         ارجع "راسب"
   نهاية
نهاية

دالة نوع_اليوم(يوم)
   طابق (يوم)
      عندما "السبت" || "الأحد":
         ارجع "عطلة"
      عندما "الجمعة":
         ارجع "إجازة"
      افتراضي:
         ارجع "عمل"
   نهاية
نهاية

دالة تصنيف_العمر(عمر)
   طابق (عمر)
      عندما 0..2:
         ارجع "رضيع"
      عندما 3..12:
         ارجع "طفل"
      عندما 13..17:
         ارجع "مراهق"
      عندما 18..64:
         ارجع "بالغ"
      افتراضي:
         ارجع "كبير"
   نهاية
نهاية

دالة حساب_ضريبة(دخل)
   طابق (دخل)
      عندما 0..10000:
         ارجع 0
      عندما 10001..30000:
         ارجع دخل * 0.1
      عندما 30001..60000:
         ارجع دخل * 0.2
      افتراضي:
         ارجع دخل * 0.3
   نهاية
نهاية

# --- التشغيل ---
اطبع_سطر("=== قياس أداء: مطابقة الأنماط ===")

# تصنيف الدرجات
متغير درجات = [95, 85, 72, 63, 45, 100, 88, 55]
لكل درجة في درجات
   اطبع_سطر("الدرجة " + درجة + " → " + تصنيف_الدرجة(درجة))
نهاية

# أيام الأسبوع
متغير أيام = ["السبت", "الأحد", "الاثنين", "الثلاثاء", "الجمعة"]
لكل يوم في أيام
   اطبع_سطر(يوم + " → " + نوع_اليوم(يوم))
نهاية

# تصنيف الأعمار
متغير أعمار = [1, 5, 15, 25, 45, 70]
لكل عمر في أعمار
   اطبع_سطر("العمر " + عمر + " → " + تصنيف_العمر(عمر))
نهاية

# حساب الضرائب
متغير دخول = [5000, 20000, 45000, 80000, 150000]
لكل دخل في دخول
   متغير ضريبة = حساب_ضريبة(دخل)
   اطبع_سطر("الدخل " + دخل + " → الضريبة: " + ضريبة)
نهاية

