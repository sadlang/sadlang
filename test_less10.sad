دالة رئيسية()
    متغير مستمر = 1
    بينما (مستمر > 0)
        متغير اختيار = 1
        إذا (اختيار == 0)
            مستمر = 0
        وإلا_إذا (اختيار == 1)
            متغير ناتج = 10
            إذا (ناتج < 5)
                اطبع_سطر("صغير")
            نهاية
        وإلا_إذا (اختيار == 2)
            اطبع_سطر("اثنان")
        نهاية
        مستمر = 0
    نهاية
نهاية
