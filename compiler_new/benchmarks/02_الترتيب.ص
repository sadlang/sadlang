دالة ترتيب_فقاعي(مصفوفة)
   متغير الطول = طول(مصفوفة)
   متغير ت = 0
   بينما (ت < الطول - 1)
      متغير ج = 0
      بينما (ج < الطول - ت - 1)
         إذا (مصفوفة[ج] > مصفوفة[ج + 1])
            متغير مؤقت = مصفوفة[ج]
            مصفوفة[ج] = مصفوفة[ج + 1]
            مصفوفة[ج + 1] = مؤقت
         نهاية
         ج = ج + 1
      نهاية
      ت = ت + 1
   نهاية
   ارجع مصفوفة
نهاية

دالة ترتيب_اختيار(مصفوفة)
   متغير الطول = طول(مصفوفة)
   متغير ت = 0
   بينما (ت < الطول - 1)
      متغير أصغر = ت
      متغير ج = ت + 1
      بينما (ج < الطول)
         إذا (مصفوفة[ج] < مصفوفة[أصغر])
            أصغر = ج
         نهاية
         ج = ج + 1
      نهاية
      إذا (أصغر != ت)
         متغير مؤقت = مصفوفة[ت]
         مصفوفة[ت] = مصفوفة[أصغر]
         مصفوفة[أصغر] = مؤقت
      نهاية
      ت = ت + 1
   نهاية
   ارجع مصفوفة
نهاية

دالة طباعة_مصفوفة(م)
   اطبع("[")
   متغير ت = 0
   بينما (ت < طول(م))
      اطبع(م[ت])
      إذا (ت < طول(م) - 1)
         اطبع(", ")
      نهاية
      ت = ت + 1
   نهاية
   اطبع_سطر("]")
نهاية

