# نظام إدارة طلاب بسيط

صنف طالب
   باني(الاسم, العمر)
      هذا.الاسم = الاسم
      هذا.العمر = العمر
      هذا.الدرجات = []
   نهاية

   دالة أضف_درجة(درجة)
      إذا (درجة < 0 أو درجة > 100)
         ارمي "درجة غير صالحة: " + درجة
      نهاية
      هذا.الدرجات = هذا.الدرجات + [درجة]
   نهاية

   دالة المعدل()
      إذا (طول(هذا.الدرجات) == 0)
         ارجع 0
      نهاية
      متغير مجموع = 0
      لكل درجة في هذا.الدرجات
         مجموع = مجموع + درجة
      نهاية
      ارجع مجموع / طول(هذا.الدرجات)
   نهاية

   دالة التقدير()
      متغير معدل = هذا.المعدل()
      إذا (معدل >= 90)
         ارجع "ممتاز"
      نهاية
      إذا (معدل >= 80)
         ارجع "جيد جداً"
      نهاية
      إذا (معدل >= 70)
         ارجع "جيد"
      نهاية
      إذا (معدل >= 60)
         ارجع "مقبول"
      نهاية
      ارجع "راسب"
   نهاية

   دالة معلومات()
      ارجع هذا.الاسم + " (العمر: " + هذا.العمر + ", المعدل: " + هذا.المعدل() + ", التقدير: " + هذا.التقدير() + ")"
   نهاية
نهاية

صنف فصل
   باني(اسم_الفصل)
      هذا.اسم_الفصل = اسم_الفصل
      هذا.الطلاب = []
   نهاية

   دالة أضف_طالب(طالب)
      هذا.الطلاب = هذا.الطلاب + [طالب]
   نهاية

   دالة معدل_الفصل()
      إذا (طول(هذا.الطلاب) == 0)
         ارجع 0
      نهاية
      متغير مجموع = 0
      لكل ط في هذا.الطلاب
         مجموع = مجموع + ط.المعدل()
      نهاية
      ارجع مجموع / طول(هذا.الطلاب)
   نهاية

   دالة أفضل_طالب()
      إذا (طول(هذا.الطلاب) == 0)
         ارجع لاشيء
      نهاية
      متغير أفضل = هذا.الطلاب[0]
      لكل ط في هذا.الطلاب
         إذا (ط.المعدل() > أفضل.المعدل())
            أفضل = ط
         نهاية
      نهاية
      ارجع أفضل
   نهاية

   دالة عدد_الناجحين()
      متغير عدد = 0
      لكل ط في هذا.الطلاب
         إذا (ط.المعدل() >= 60)
            عدد = عدد + 1
         نهاية
      نهاية
      ارجع عدد
   نهاية

   دالة تقرير()
      اطبع_سطر("=== تقرير فصل: " + هذا.اسم_الفصل + " ===")
      اطبع_سطر("عدد الطلاب: " + طول(هذا.الطلاب))
      لكل ط في هذا.الطلاب
         اطبع_سطر("  " + ط.معلومات())
      نهاية
      اطبع_سطر("معدل الفصل: " + هذا.معدل_الفصل())
      اطبع_سطر("عدد الناجحين: " + هذا.عدد_الناجحين() + " من " + طول(هذا.الطلاب))
      متغير أفضل = هذا.أفضل_طالب()
      إذا (أفضل != لاشيء)
         اطبع_سطر("أفضل طالب: " + أفضل.الاسم)
      نهاية
   نهاية
نهاية

