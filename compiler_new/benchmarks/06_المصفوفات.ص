دالة مجموع(مصفوفة)
   متغير ناتج = 0
   لكل عنصر في مصفوفة
      ناتج = ناتج + عنصر
   نهاية
   ارجع ناتج
نهاية

دالة متوسط(مصفوفة)
   ارجع مجموع(مصفوفة) / طول(مصفوفة)
نهاية

دالة أكبر_قيمة(مصفوفة)
   متغير أكبر = مصفوفة[0]
   لكل عنصر في مصفوفة
      إذا (عنصر > أكبر)
         أكبر = عنصر
      نهاية
   نهاية
   ارجع أكبر
نهاية

دالة أصغر_قيمة(مصفوفة)
   متغير أصغر = مصفوفة[0]
   لكل عنصر في مصفوفة
      إذا (عنصر < أصغر)
         أصغر = عنصر
      نهاية
   نهاية
   ارجع أصغر
نهاية

دالة تصفية_زوجية(مصفوفة)
   متغير ناتج = []
   لكل عنصر في مصفوفة
      إذا (عنصر % 2 == 0)
         ناتج = ناتج + [عنصر]
      نهاية
   نهاية
   ارجع ناتج
نهاية

دالة تربيع(مصفوفة)
   متغير ناتج = []
   لكل عنصر في مصفوفة
      ناتج = ناتج + [عنصر * عنصر]
   نهاية
   ارجع ناتج
نهاية

دالة تسطيح(مصفوفة_متداخلة)
   متغير ناتج = []
   لكل مجموعة في مصفوفة_متداخلة
      لكل عنصر في مجموعة
         ناتج = ناتج + [عنصر]
      نهاية
   نهاية
   ارجع ناتج
نهاية

