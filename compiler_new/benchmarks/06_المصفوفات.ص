# إنشاء مصفوفة كبيرة
متغير بيانات = []
متغير ت = 1
بينما (ت <= 500)
   بيانات = بيانات + [ت]
   ت = ت + 1
نهاية

اطبع_سطر("حجم المصفوفة: " + طول(بيانات))
اطبع_سطر("المجموع: " + مجموع(بيانات))
اطبع_سطر("المتوسط: " + متوسط(بيانات))
اطبع_سطر("الأكبر: " + أكبر_قيمة(بيانات))
اطبع_سطر("الأصغر: " + أصغر_قيمة(بيانات))

# تصفية الأعداد الزوجية
متغير زوجية = تصفية_زوجية(بيانات)
اطبع_سطر("عدد الزوجية: " + طول(زوجية))

# تربيع أول 10 عناصر
متغير أول_عشرة = []
