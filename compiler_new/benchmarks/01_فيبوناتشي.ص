# ============================================================================
# قياس أداء: فيبوناتشي التكراري
# Benchmark: Recursive Fibonacci
# يختبر: أداء الاستدعاء التكراري وإدارة المكدس
# ============================================================================

دالة فيبوناتشي(ن)
   إذا (ن <= 1)
      ارجع ن
   نهاية
   ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

# فيبوناتشي بالتذكير (Memoization)
دالة فيبوناتشي_سريع(ن، ذاكرة)
   إذا (ن <= 1)
      ارجع ن
   نهاية

   متغير عد = 0
   متغير أ = 0
   متغير ب = 1
   بينما (عد < ن - 1)
      متغير مؤقت = أ + ب
      أ = ب
      ب = مؤقت
      عد = عد + 1
   نهاية
   ارجع ب
نهاية

# --- التشغيل ---
اطبع_سطر("=== قياس أداء: فيبوناتشي ===")

# تكراري (بطيء — يختبر عمق المكدس)
متغير ن1 = 20
متغير نتيجة1 = فيبوناتشي(ن1)
اطبع_سطر("فيبوناتشي(" + ن1 + ") = " + نتيجة1)

# تكراري (سريع)
متغير ن2 = 30
متغير نتيجة2 = فيبوناتشي_سريع(ن2، [])
اطبع_سطر("فيبوناتشي_سريع(" + ن2 + ") = " + نتيجة2)

# سلسلة فيبوناتشي
اطبع("سلسلة فيبوناتشي: ")
متغير ت = 0
بينما (ت < 15)
   اطبع(فيبوناتشي_سريع(ت، []) + " ")
   ت = ت + 1
نهاية
اطبع_سطر("")

