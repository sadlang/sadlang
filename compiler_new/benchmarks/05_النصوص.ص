# قياس أداء: معالجة النصوص
# Benchmark: String Processing
# يختبر: جمع النصوص، البحث، التكرار على الأحرف
# ============================================================================

دالة عكس_نص(نص)
   متغير معكوس = ""
   متغير ت = طول(نص) - 1
   بينما (ت >= 0)
      معكوس = معكوس + نص[ت]
      ت = ت - 1
   نهاية
   ارجع معكوس
نهاية

دالة عدد_الأحرف(نص, حرف)
   متغير عداد = 0
   لكل ح في نص
      إذا (ح == حرف)
         عداد = عداد + 1
      نهاية
   نهاية
   ارجع عداد
نهاية

دالة هل_متناظر(نص)
   متغير معكوس = عكس_نص(نص)
   ارجع نص == معكوس
نهاية

دالة تكرار_نص(نص, مرات)
   متغير ناتج = ""
   متغير ت = 0
   بينما (ت < مرات)
      ناتج = ناتج + نص
      ت = ت + 1
   نهاية
   ارجع ناتج
نهاية

دالة بناء_جملة(كلمات)
   متغير جملة = ""
   متغير ت = 0
   بينما (ت < طول(كلمات))
      جملة = جملة + كلمات[ت]
      إذا (ت < طول(كلمات) - 1)
         جملة = جملة + " "
      نهاية
      ت = ت + 1
   نهاية
   ارجع جملة
نهاية

# --- التشغيل ---
اطبع_سطر("=== قياس أداء: معالجة النصوص ===")

# عكس النص
متغير نص1 = "مرحباً بالعربية"
اطبع_سطر("النص: " + نص1)
اطبع_سطر("المعكوس: " + عكس_نص(نص1))

# عد الأحرف
متغير نص2 = "برمجة لغة ص هي لغة برمجة عربية"
اطبع_سطر("عدد حرف 'ب' في النص: " + عدد_الأحرف(نص2, "ب"))

# متناظر
متغير كلمات_اختبار = ["aba", "abc", "racecar", "hello", "madam"]
لكل كلمة في كلمات_اختبار
   إذا (هل_متناظر(كلمة))
      اطبع_سطر(كلمة + " ← متناظرة")
   وإلا
      اطبع_سطر(كلمة + " ← غير متناظرة")
   نهاية
نهاية

# تكرار نص
متغير مكرر = تكرار_نص("ص", 50)
اطبع_سطر("طول النص المكرر: " + طول(مكرر))

# بناء جملة
متغير كلمات = ["لغة", "ص", "هي", "لغة", "برمجة", "عربية", "حديثة"]
اطبع_سطر("جملة: " + بناء_جملة(كلمات))

