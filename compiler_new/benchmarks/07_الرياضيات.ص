دالة قيمة_مطلقة(ن)
   إذا (ن < 0)
      ارجع -ن
   نهاية
   ارجع ن
نهاية

دالة قوة(أساس, أس)
   إذا (أس == 0)
      ارجع 1
   نهاية
   متغير ناتج = 1
   متغير ت = 0
   بينما (ت < أس)
      ناتج = ناتج * أساس
      ت = ت + 1
   نهاية
   ارجع ناتج
نهاية

دالة القاسم_المشترك_الأكبر(أ, ب)
   بينما (ب != 0)
      متغير مؤقت = ب
      ب = أ % ب
      أ = مؤقت
   نهاية
   ارجع قيمة_مطلقة(أ)
نهاية

دالة المضاعف_المشترك_الأصغر(أ, ب)
   ارجع قيمة_مطلقة(أ * ب) / القاسم_المشترك_الأكبر(أ, ب)
نهاية

دالة هل_أولي(ن)
   إذا (ن < 2)
      ارجع خطأ
   نهاية
   إذا (ن < 4)
      ارجع صحيح
   نهاية
   إذا (ن % 2 == 0)
      ارجع خطأ
   نهاية
   متغير ت = 3
   بينما (ت * ت <= ن)
      إذا (ن % ت == 0)
         ارجع خطأ
      نهاية
      ت = ت + 2
   نهاية
   ارجع صحيح
نهاية

دالة الأعداد_الأولية_حتى(حد)
   متغير أولية = []
   متغير ت = 2
   بينما (ت <= حد)
      إذا (هل_أولي(ت))
         أولية = أولية + [ت]
      نهاية
      ت = ت + 1
   نهاية
   ارجع أولية
نهاية

دالة مضروب(ن)
   إذا (ن <= 1)
      ارجع 1
   نهاية
   ارجع ن * مضروب(ن - 1)
نهاية

# --- التشغيل ---
اطبع_سطر("=== قياس أداء: الرياضيات ===")

# الأس
اطبع_سطر("2^10 = " + قوة(2, 10))
اطبع_سطر("3^5 = " + قوة(3, 5))

# GCD & LCM
اطبع_سطر("GCD(48, 18) = " + القاسم_المشترك_الأكبر(48, 18))
اطبع_سطر("LCM(12, 8) = " + المضاعف_المشترك_الأصغر(12, 8))

# الأعداد الأولية
متغير أولية = الأعداد_الأولية_حتى(200)
اطبع_سطر("عدد الأعداد الأولية حتى 200: " + طول(أولية))

# المضروب
متغير ت = 1
بينما (ت <= 12)
   اطبع_سطر(ت + "! = " + مضروب(ت))
   ت = ت + 1
نهاية

# التحقق من أعداد كبيرة
متغير أعداد_كبيرة = [997, 998, 999, 1000, 1009, 1013]
لكل عدد في أعداد_كبيرة
