# ============================================================================
# قياس أداء: الاستثناءات ومعالجة الأخطاء
# Benchmark: Exception Handling & Error Management
# يختبر: حاول/امسك، ارمي، أخيراً، تداخل الاستثناءات
# ============================================================================

دالة قسمة_آمنة(أ, ب)
   إذا (ب == 0)
      ارمي "خطأ: القسمة على صفر"
   نهاية
   ارجع أ / ب
نهاية

دالة جذر_تقريبي(ن)
   إذا (ن < 0)
      ارمي "خطأ: لا يمكن حساب جذر عدد سالب"
   نهاية
   إذا (ن == 0)
      ارجع 0
   نهاية
   # طريقة نيوتن التقريبية
   متغير تخمين = ن / 2
   متغير ت = 0
   بينما (ت < 20)
      تخمين = (تخمين + ن / تخمين) / 2
      ت = ت + 1
   نهاية
   ارجع تخمين
نهاية

دالة تحقق_العمر(عمر)
   إذا (عمر < 0)
      ارمي "خطأ: العمر لا يمكن أن يكون سالباً"
   نهاية
   إذا (عمر > 150)
      ارمي "خطأ: عمر غير واقعي"
   نهاية
   ارجع صحيح
نهاية

# --- التشغيل ---
اطبع_سطر("=== قياس أداء: الاستثناءات ===")

# قسمة آمنة — حالات نجاح
اطبع_سطر("10 / 3 = " + قسمة_آمنة(10, 3))
اطبع_سطر("100 / 4 = " + قسمة_آمنة(100, 4))

# قسمة آمنة — حالة خطأ
حاول
   متغير ناتج = قسمة_آمنة(10, 0)
   اطبع_سطر("لن تصل هنا")
امسك (خطأ)
   اطبع_سطر("تم التقاط: " + خطأ)
نهاية

# جذر تقريبي
حاول
   اطبع_سطر("جذر 25 ≈ " + جذر_تقريبي(25))
   اطبع_سطر("جذر 2 ≈ " + جذر_تقريبي(2))
   اطبع_سطر("جذر -4 ≈ " + جذر_تقريبي(-4))
امسك (خطأ)
   اطبع_سطر("خطأ في الجذر: " + خطأ)
نهاية

# اختبارات العمر المتعددة
متغير أعمار = [25, -5, 200, 0, 100, 150]
لكل عمر في أعمار
   حاول
      تحقق_العمر(عمر)
      اطبع_سطر("العمر " + عمر + " ← صحيح")
   امسك (خطأ)
      اطبع_سطر("العمر " + عمر + " ← " + خطأ)
   نهاية
نهاية

# استثناءات متتالية
متغير نجاحات = 0
متغير إخفاقات = 0
متغير ت = 0
بينما (ت < 50)
   حاول
      قسمة_آمنة(100, ت % 5)
      نجاحات = نجاحات + 1
   امسك (خطأ)
      إخفاقات = إخفاقات + 1
   نهاية
   ت = ت + 1
نهاية
اطبع_سطر("نجاحات: " + نجاحات + ", إخفاقات: " + إخفاقات)

اطبع_سطر("=== انتهى ===")
