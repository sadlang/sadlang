# قياس أداء: البحث الخطي والثنائي
# Benchmark: Linear & Binary Search
# يختبر: حلقات، شروط، فهرسة المصفوفات
# ============================================================================

دالة بحث_خطي(مصفوفة, هدف)
   متغير ت = 0
   بينما (ت < طول(مصفوفة))
      إذا (مصفوفة[ت] == هدف)
         ارجع ت
      نهاية
      ت = ت + 1
   نهاية
   ارجع -1
نهاية

دالة بحث_ثنائي(مصفوفة, هدف)
   متغير بداية = 0
   متغير نهايه = طول(مصفوفة) - 1

   بينما (بداية <= نهايه)
      متغير وسط = بداية + (نهايه - بداية) / 2

      إذا (مصفوفة[وسط] == هدف)
         ارجع وسط
      نهاية

      إذا (مصفوفة[وسط] < هدف)
         بداية = وسط + 1
      وإلا
         نهايه = وسط - 1
      نهاية
   نهاية

   ارجع -1
نهاية

# إنشاء مصفوفة مرتبة
دالة إنشاء_مرتبة(حجم)
   متغير م = []
   متغير ت = 0
   بينما (ت < حجم)
      م = م + [ت * 3]
      ت = ت + 1
   نهاية
   ارجع م
نهاية

# --- التشغيل ---
اطبع_سطر("=== قياس أداء: البحث ===")

متغير بيانات = إنشاء_مرتبة(500)
اطبع_سطر("حجم المصفوفة: " + طول(بيانات))

# بحث خطي
متغير موقع1 = بحث_خطي(بيانات, 150)
اطبع_سطر("بحث خطي عن 150: الموقع = " + موقع1)

متغير موقع2 = بحث_خطي(بيانات, 999)
اطبع_سطر("بحث خطي عن 999: الموقع = " + موقع2)

# بحث ثنائي
متغير موقع3 = بحث_ثنائي(بيانات, 150)
اطبع_سطر("بحث ثنائي عن 150: الموقع = " + موقع3)

متغير موقع4 = بحث_ثنائي(بيانات, 999)
اطبع_سطر("بحث ثنائي عن 999: الموقع = " + موقع4)

# بحث متعدد
متغير عدد_الأهداف = 0
متغير الأهداف = [0, 30, 75, 150, 300, 600, 900, 1200, 1497]
لكل هدف في الأهداف
   متغير نتيجة = بحث_ثنائي(بيانات, هدف)
   إذا (نتيجة >= 0)
      عدد_الأهداف = عدد_الأهداف + 1
   نهاية
نهاية
اطبع_سطر("عدد العناصر الموجودة: " + عدد_الأهداف + " من " + طول(الأهداف))

