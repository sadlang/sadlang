{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sadlang.org/schemas/v5/operator.schema.json",
  "title": "Operator Schema (V5)",
  "description": "مخطط JSON للعوامل في لغة ص — operators.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "symbol",
    "name_ar",
    "name_en",
    "category",
    "arity",
    "precedence",
    "since",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^op\\.[a-z][a-z0-9_]*$",
      "description": "معرّف فريد: op.<snake_case>"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "description": "رمز العامل مثل + - * / == && ..."
    },
    "name_ar": {
      "type": "string",
      "minLength": 1,
      "description": "الاسم الوصفي العربي"
    },
    "name_en": {
      "type": "string",
      "minLength": 1,
      "description": "الاسم الوصفي الإنجليزي"
    },
    "category": {
      "type": "string",
      "enum": [
        "arithmetic",
        "comparison",
        "logical",
        "assignment",
        "bitwise",
        "unary",
        "membership",
        "null_safety",
        "ternary",
        "access"
      ],
      "description": "تصنيف العامل"
    },
    "arity": {
      "type": "string",
      "enum": [
        "unary",
        "binary",
        "ternary"
      ],
      "description": "عدد المعاملات"
    },
    "precedence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "الأسبقية (1=أعلى)"
    },
    "associativity": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "none"
      ],
      "description": "اتجاه الترابط"
    },
    "since": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "أول إصدار يدعم هذا العامل"
    },
    "status": {
      "type": "string",
      "enum": [
        "stable",
        "experimental",
        "deprecated",
        "removed"
      ],
      "description": "حالة العامل"
    },
    "description_ar": {
      "type": "string",
      "description": "وصف بالعربية"
    },
    "description_en": {
      "type": "string",
      "description": "Description in English"
    },
    "example": {
      "type": "string",
      "description": "مثال استخدام بلغة ص"
    },
    "position": {
      "type": "string",
      "enum": [
        "prefix",
        "infix",
        "postfix"
      ],
      "description": "موضع العامل من معامله (لاحقيّ/بادئ/وسطيّ)"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "صيغ مرادفة للعامل (مثل المذكّر/المؤنّث)"
    },
    "operands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepts"
      ],
      "description": "نطاقات المعاملات المسموحة. عاملٌ بلا هذا الحقل لا حارسَ له. والمعامل المجهول النوع (أي/عدم/فراغ/غير مُصرَّح) يمرّ دائماً بلا حكم — قاعدةُ الحارس لا خيارَ لكلّ عامل، كي لا يُعاد الرفض الكاذب من باب آخر.",
      "properties": {
        "accepts": {
          "type": "array",
          "minItems": 1,
          "description": "التوقيعات المسموحة؛ ما لا يوافق أحدها يُرفَض",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left",
              "right",
              "result"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/operandClassRef"
              },
              "right": {
                "$ref": "#/$defs/operandClassRef"
              },
              "result": {
                "type": "string",
                "enum": [
                  "promote",
                  "type.string",
                  "type.array",
                  "type.map"
                ],
                "description": "«promote» ترقيةٌ عدديّة، أو معرّف نوعٍ من types.yaml"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "operandClassRef": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "numeric",
            "textual",
            "logical",
            "sequence",
            "mapping"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "numeric",
              "textual",
              "logical",
              "sequence",
              "mapping"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ],
      "description": "صنف نوعٍ واحد أو قائمة أصناف — من operand_classes"
    }
  }
}
