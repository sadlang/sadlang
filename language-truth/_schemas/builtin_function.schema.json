{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sadlang.org/schemas/v5/builtin_function.schema.json",
  "title": "Builtin Function Schema (V5 Codegen)",
  "type": "object",
  "required": [
    "cpp_id",
    "canonical",
    "namespace"
  ],
  "additionalProperties": true,
  "properties": {
    "cpp_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "canonical": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "enum": [
        "Core",
        "TypeCtor",
        "Concurrency",
        "Math",
        "Strings",
        "Arrays",
        "Basics",
        "Assertions",
        "Maps",
        "Sockets",
        "HttpClient",
        "HttpServer",
        "NetworkUtils",
        "WebSocketClient",
        "WebSocketServer",
        "Platform",
        "Crypto",
        "String",
        "Array",
        "Map",
        "IO",
        "System",
        "AsyncAdvanced",
        "Exceptions",
        "FFI",
        "KernelAudio",
        "KernelCpu",
        "KernelGpu",
        "KernelMemory",
        "KernelNet",
        "KernelSerial",
        "KernelStorage",
        "CompilerIo",
        "CompilerCpuCtl",
        "CompilerHw",
        "CompilerSys",
        "CompilerSec",
        "CompilerSimd",
        "CompilerMem",
        "CompilerEmbed",
        "CompilerUefi",
        "CompilerUi"
      ]
    },
    "since": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "primary_prop": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "معرّف مفتاح الخاصّيّة الأساسيّ للعنصر (id في language-truth/ui_props.yaml). لعناصر UIWidgets ذات الخاصّيّة الأولى فقط."
    },
    "params": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "معاملات الدالّة موصوفةً؛ الأوّل لعنصرٍ ذي primary_prop = مفتاحه العربيّ + وصف"
    },
    "stability": {
      "type": "string",
      "enum": [
        "stable",
        "experimental",
        "deprecated"
      ]
    },
    "arity": {
      "type": "object",
      "description": "الرتبةُ المفروضةُ: أقلُّ عددِ وسائطَ وأكثرُه. عقدٌ آليٌّ يُولَّد منه الفحصُ في الأماميّة — لا نثرَ params الوصفيّ. وللرتبةِ المفتوحةِ أعلاها (`printf` وأخواتُها) يُكتَب `variadic: true` ويُحذَف `max`: علمٌ صريحٌ يُقرَأ، لا رقمٌ سحريٌّ يُخمَّن معناه. ولطرائقِ الأنواعِ في `type_methods.yaml` يُعَدُّ **ما بينَ القوسينِ وحدَه دونَ المستقبِل**: `خ.عين(ك، ق)` رتبتُها ٢ لا ٣ — كما يقرؤها المفسّرُ وكما تُعرَض في الرسالة. والمترجّمُ يُدرجُ المستقبِلَ في متّجهِه فيطرحُه عند الفحص.",
      "required": [
        "min"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "variadic": {
          "type": "boolean",
          "description": "رتبةٌ لا حدَّ لأعلاها — يُمنَع معها `max`."
        }
      },
      "oneOf": [
        {
          "required": [
            "max"
          ],
          "not": {
            "required": [
              "variadic"
            ]
          }
        },
        {
          "required": [
            "variadic"
          ],
          "not": {
            "required": [
              "max"
            ]
          }
        }
      ]
    }
  }
}
