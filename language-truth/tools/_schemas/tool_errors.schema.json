{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sadlang.org/schemas/tools/tool_errors.schema.json",
  "title": "Tool SoT — Errors / أخطاء أداة (مصدر حقيقة)",
  "description": "مخطط errors.yaml لكل أداة. يصف كتالوج أخطاء خاصّ بالأداة (فشل فتح ملفّ، أمر مجهول، خطأ داخليّ للأداة…) — منفصل عن أخطاء اللغة (language-truth/errors/*.yaml). كلّ خطأ ثنائيّ اللغة (عنوان/موجز/تلميح) وقد يحمل تفصيلاً واحداً ({detail}) يُملأ زمن التشغيل. لا نصّ رسالةٍ يُكتب يدوياً في C++.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tool", "description_ar", "description_en", "errors"],
  "properties": {
    "version": { "type": "string" },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "معرّف الأداة — يطابق _meta.tool"
    },
    "description_ar": { "type": "string", "minLength": 1 },
    "description_en": { "type": "string", "minLength": 1 },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/error" }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "id", "severity", "title", "brief"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "description": "اسم C++ الرمزيّ (قيمة enum بعد ::)، مثل FILE_OPEN"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,6}[0-9]{3}$",
          "description": "معرّف نصّيّ ثابت يبدأ ببادئة الأداة، مثل REPL001"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"],
          "description": "درجة الخطورة — تُوجّه القناة (stderr) واللون"
        },
        "title": { "$ref": "#/$defs/bilingual", "description": "عنوان مختصر" },
        "brief": {
          "$ref": "#/$defs/bilingual",
          "description": "الرسالة الموجزة (قد تحوي {detail})"
        },
        "hint": {
          "$ref": "#/$defs/bilingual",
          "description": "تلميح إصلاح اختياريّ (قد يحوي {detail})"
        },
        "has_detail": {
          "type": "boolean",
          "description": "هل تُلحَق قيمة {detail} زمن التشغيل؟ (افتراض false)"
        }
      }
    }
  }
}
