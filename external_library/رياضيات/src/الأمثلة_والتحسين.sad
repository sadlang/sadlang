#**
# دالة: أقصى_من_2
# الوصف: إرجاع الأكبر من عددين
**#
دالة رقم أقصى_من_2(رقم أ، رقم ب)
    إذا (أ >= ب)
        إرجاع أ
    نهاية
    إرجاع ب
نهاية


#**
# دالة: أدنى_من_2
# الوصف: إرجاع الأصغر من عددين
**#
دالة رقم أدنى_من_2(رقم أ، رقم ب)
    إذا (أ <= ب)
        إرجاع أ
    نهاية
    إرجاع ب
نهاية


#**
# دالة: أقصى_من_3
# الوصف: إرجاع الأكبر من ثلاثة أعداد
**#
دالة رقم أقصى_من_3(رقم أ، رقم ب، رقم ج)
    إرجاع أقصى_من_2(أقصى_من_2(أ، ب)، ج)
نهاية


#**
# دالة: أدنى_من_3
# الوصف: إرجاع الأصغر من ثلاثة أعداد
**#
دالة رقم أدنى_من_3(رقم أ، رقم ب، رقم ج)
    إرجاع أدنى_من_2(أدنى_من_2(أ، ب)، ج)
نهاية


#**
# دالة: وسيط_3
# الوصف: القيمة الوسطى من ثلاث قيم (Median of 3)
**#
دالة رقم وسيط_3(رقم أ، رقم ب، رقم ج)
    إذا (أ <= ب)
        إذا (ب <= ج)
            إرجاع ب
        نهاية
        إذا (أ <= ج)
            إرجاع ج
        نهاية
        إرجاع أ
    نهاية
    # أ > ب
    إذا (أ <= ج)
        إرجاع أ
    نهاية
    إذا (ب <= ج)
        إرجاع ج
    نهاية
    إرجاع ب
نهاية


