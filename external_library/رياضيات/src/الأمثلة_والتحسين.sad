#**
# دالة: بحث_ذهبي_تقليص
# الوصف: تقليص فترة البحث بالنسبة الذهبية
#         φ = (√5-1)/2 ≈ 0.618
#         الفترة الجديدة = φ * الفترة القديمة
# المعاملات:
#   - أ: الطرف الأيسر
#   - ب: الطرف الأيمن
# الإرجاع: نقطتا التقييم (x1 = a + (1-φ)(b-a), x2 = a + φ(b-a))
**#
دالة رقم بحث_ذهبي_نقطة_1(رقم أ، رقم ب)
    # x1 = a + (1-φ)(b-a) = a + 0.382*(b-a)
    إرجاع أ + 382 * (ب - أ) / 1000
نهاية

دالة رقم بحث_ذهبي_نقطة_2(رقم أ، رقم ب)
    # x2 = a + φ*(b-a) = a + 0.618*(b-a)
    إرجاع أ + 618 * (ب - أ) / 1000
نهاية


#**
# دالة: تقليص_فترة_أصغرية
# الوصف: تقليص فترة البحث عن الأصغرية
#         إذا f(x1) < f(x2) → الفترة الجديدة [a, x2]
#         إذا f(x1) ≥ f(x2) → الفترة الجديدة [x1, b]
# المعاملات:
#   - ف1: f(x1)
#   - ف2: f(x2)
# الإرجاع: 0 إذا الأصغرية في [a,x2]، 1 إذا في [x1,b]
**#
دالة رقم تقليص_فترة_أصغرية(رقم ف1، رقم ف2)
    إذا (ف1 < ف2)
        إرجاع 0  # [a, x2]
    نهاية
    إرجاع 1  # [x1, b]
نهاية


