# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 1: البحث عن الجذور (Root Finding)                      ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# إيجاد الجذور: f(x) = 0
#
# الطرق الكلاسيكية:
# 1. التنصيف (Bisection) - مضمون لكن بطيء
# 2. نيوتن-رافسون - سريع لكن يحتاج المشتقة
# 3. الوتر (Secant) - لا يحتاج المشتقة
# 4. النقطة الثابتة (Fixed Point)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: تنصيف_خطوة
# الوصف: خطوة واحدة من طريقة التنصيف
#         بمعرفة فترة [a,b] حيث f(a)*f(b) < 0
#         نحسب c = (a+b)/2 ونقلص الفترة
# المعاملات:
#   - أ: الطرف الأيسر
#   - ب: الطرف الأيمن
# الإرجاع: نقطة المنتصف
**#
دالة رقم تنصيف_خطوة(رقم أ، رقم ب)
    إرجاع (أ + ب) / 2
نهاية


#**
# دالة: تنصيف_اختيار_فترة
# الوصف: اختيار الفترة الجديدة بناءً على الإشارات
#         إذا f(a)*f(c) < 0 → الجذر في [a,c]
#         وإلا → الجذر في [c,b]
# المعاملات:
#   - ف_أ: f(a)
#   - ف_ج: f(c)
# الإرجاع: 0 إذا الجذر في [a,c]، 1 إذا في [c,b]
**#
دالة رقم تنصيف_اختيار_فترة(رقم ف_أ، رقم ف_ج)
    متغير رقم حاصل = ف_أ * ف_ج
    إذا (حاصل <= 0)
        إرجاع 0  # الجذر في [a,c]
    نهاية
    إرجاع 1  # الجذر في [c,b]
نهاية


#**
# دالة: نيوتن_خطوة
# الوصف: خطوة واحدة من طريقة نيوتن-رافسون
#         x_{n+1} = x_n - f(x_n)/f'(x_n)
# المعاملات:
#   - س: القيمة الحالية (مكبرة ×1000)
#   - ف: f(x) عند x (مكبرة ×1000)
#   - ف_مشتقة: f'(x) عند x (مكبرة ×1000)
# الإرجاع: x الجديدة (مكبرة ×1000)
**#
دالة رقم نيوتن_خطوة(رقم س، رقم ف، رقم ف_مشتقة)
    إذا (ف_مشتقة == 0)
        إرجاع س
    نهاية
    إرجاع س - (ف * 1000) / ف_مشتقة
نهاية


#**
# دالة: وتر_خطوة
# الوصف: خطوة واحدة من طريقة الوتر (Secant Method)
#         x_{n+1} = x_n - f(x_n) * (x_n - x_{n-1}) / (f(x_n) - f(x_{n-1}))
# المعاملات:
#   - س_سابق، ف_سابق: القيمة السابقة ودالتها
#   - س_حالي، ف_حالي: القيمة الحالية ودالتها
# الإرجاع: x الجديدة (مكبرة ×1000)
**#
دالة رقم وتر_خطوة(رقم س_سابق، رقم ف_سابق، رقم س_حالي، رقم ف_حالي)
    متغير رقم فرق_ف = ف_حالي - ف_سابق
    إذا (فرق_ف == 0)
        إرجاع س_حالي
    نهاية
    إرجاع س_حالي - (ف_حالي * (س_حالي - س_سابق)) / فرق_ف
نهاية


#**
# دالة: جذر_تربيعي_نيوتن
# الوصف: حساب √a بطريقة نيوتن (f(x)=x²-a, f'=2x)
#         x_{n+1} = (x + a/x) / 2
# المعاملات:
#   - عدد: العدد المطلوب جذره
#   - تكرارات: عدد التكرارات
# الإرجاع: √عدد (مع دقة عالية)
**#
دالة رقم جذر_تربيعي_نيوتن(رقم عدد، رقم تكرارات)
    إذا (عدد <= 0)
        إرجاع 0
    نهاية
    
    متغير رقم تخمين = عدد
    إذا (تخمين > 100)
        تخمين = عدد / 10
    نهاية
    إذا (تخمين <= 0)
        تخمين = 1
    نهاية
    
    متغير رقم ع = 0
    طالما (ع < تكرارات)
        إذا (تخمين == 0)
            تخمين = 1
        نهاية
        تخمين = (تخمين + عدد / تخمين) / 2
        ع = ع + 1
    نهاية
    
    إرجاع تخمين
نهاية


