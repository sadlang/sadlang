#**
# دالة: مسألة_حقيبة_ظهر_01_2
# الوصف: مسألة حقيبة الظهر 0/1 لعنصرين
#         تعظيم v1*x1 + v2*x2 بشرط w1*x1 + w2*x2 ≤ W
# المعاملات:
#   - و1، و2: أوزان العناصر
#   - ق1، ق2: قيم العناصر
#   - سعة: السعة القصوى
# الإرجاع: أقصى قيمة ممكنة
**#
دالة رقم مسألة_حقيبة_ظهر_01_2(رقم و1، رقم ق1، رقم و2، رقم ق2، رقم سعة)
    متغير رقم أفضل = 0
    
    # لا شيء
    # أفضل = 0
    
    # عنصر 1 فقط
    إذا (و1 <= سعة)
        إذا (ق1 > أفضل)
            أفضل = ق1
        نهاية
    نهاية
    
    # عنصر 2 فقط
    إذا (و2 <= سعة)
        إذا (ق2 > أفضل)
            أفضل = ق2
        نهاية
    نهاية
    
    # كلاهما
    إذا (و1 + و2 <= سعة)
        متغير رقم كلاهما = ق1 + ق2
        إذا (كلاهما > أفضل)
            أفضل = كلاهما
        نهاية
    نهاية
    
    إرجاع أفضل
نهاية


#**
# دالة: مسألة_حقيبة_ظهر_01_3
# الوصف: حقيبة الظهر 0/1 لثلاثة عناصر
**#
دالة رقم مسألة_حقيبة_ظهر_01_3(رقم و1، رقم ق1، رقم و2، رقم ق2، رقم و3، رقم ق3، رقم سعة)
    متغير رقم أفضل = 0
    
    # كل التوليفات الـ 8
    # 000
    # 001
    إذا (و3 <= سعة)
        أفضل = أقصى_من_2(أفضل، ق3)
    نهاية
    # 010
    إذا (و2 <= سعة)
        أفضل = أقصى_من_2(أفضل، ق2)
    نهاية
    # 011
    إذا (و2 + و3 <= سعة)
        أفضل = أقصى_من_2(أفضل، ق2 + ق3)
    نهاية
    # 100
    إذا (و1 <= سعة)
        أفضل = أقصى_من_2(أفضل، ق1)
    نهاية
    # 101
    إذا (و1 + و3 <= سعة)
        أفضل = أقصى_من_2(أفضل، ق1 + ق3)
    نهاية
    # 110
    إذا (و1 + و2 <= سعة)
        أفضل = أقصى_من_2(أفضل، ق1 + ق2)
    نهاية
    # 111
    إذا (و1 + و2 + و3 <= سعة)
        أفضل = أقصى_من_2(أفضل، ق1 + ق2 + ق3)
    نهاية
    
    إرجاع أفضل
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 6: الخوارزميات الجشعة (Greedy)                         ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: حقيبة_كسرية_2
# الوصف: حقيبة الظهر الكسرية لعنصرين
#         يمكن أخذ جزء من العنصر
#         نأخذ حسب أفضل نسبة قيمة/وزن
# المعاملات: أوزان، قيم، سعة
# الإرجاع: أقصى قيمة ×1000
**#
دالة رقم حقيبة_كسرية_2(رقم و1، رقم ق1، رقم و2، رقم ق2، رقم سعة)
    # نسبة القيمة/الوزن (×1000)
    متغير رقم نسبة1 = 0
    إذا (و1 > 0)
        نسبة1 = (ق1 * 1000) / و1
    نهاية
    متغير رقم نسبة2 = 0
    إذا (و2 > 0)
        نسبة2 = (ق2 * 1000) / و2
    نهاية
    
    متغير رقم قيمة = 0
    متغير رقم باقي = سعة
    
    # أخذ الأفضل أولاً
    إذا (نسبة1 >= نسبة2)
        # أخذ عنصر 1 أولاً
        إذا (و1 <= باقي)
            قيمة = قيمة + ق1 * 1000
            باقي = باقي - و1
        وإلا
            قيمة = قيمة + (نسبة1 * باقي)
            باقي = 0
        نهاية
        
        # ثم عنصر 2
        إذا (باقي > 0)
            إذا (و2 <= باقي)
                قيمة = قيمة + ق2 * 1000
            وإلا
                قيمة = قيمة + (نسبة2 * باقي)
            نهاية
        نهاية
    وإلا
        # أخذ عنصر 2 أولاً
        إذا (و2 <= باقي)
            قيمة = قيمة + ق2 * 1000
            باقي = باقي - و2
        وإلا
            قيمة = قيمة + (نسبة2 * باقي)
            باقي = 0
        نهاية
        
        إذا (باقي > 0)
            إذا (و1 <= باقي)
                قيمة = قيمة + ق1 * 1000
            وإلا
                قيمة = قيمة + (نسبة1 * باقي)
            نهاية
        نهاية
    نهاية
    
    إرجاع قيمة
نهاية


#**
# دالة: مسألة_فكة_العملات
# الوصف: أقل عدد عملات لتبديل مبلغ (خوارزمية جشعة)
#         فئات: 100، 50، 25، 10، 5، 1
# المعاملات:
#   - مبلغ: المبلغ المطلوب تبديله
# الإرجاع: أقل عدد عملات
**#
دالة رقم مسألة_فكة_العملات(رقم مبلغ)
    متغير رقم باقي = مبلغ
    متغير رقم عدد = 0
    
    # 100
    عدد = عدد + باقي / 100
    باقي = باقي - (باقي / 100) * 100
    
    # 50
    عدد = عدد + باقي / 50
    باقي = باقي - (باقي / 50) * 50
    
    # 25
    عدد = عدد + باقي / 25
    باقي = باقي - (باقي / 25) * 25
    
    # 10
    عدد = عدد + باقي / 10
    باقي = باقي - (باقي / 10) * 10
    
    # 5
    عدد = عدد + باقي / 5
    باقي = باقي - (باقي / 5) * 5
    
    # 1
    عدد = عدد + باقي
    
    إرجاع عدد
نهاية


