#**
# دالة: دالة_هدف_خطية_2
# الوصف: حساب الدالة الهدف الخطية z = c₁x₁ + c₂x₂
**#
دالة رقم دالة_هدف_خطية_2(رقم ج1، رقم ج2، رقم س1، رقم س2)
    إرجاع ج1 * س1 + ج2 * س2
نهاية


#**
# دالة: دالة_هدف_خطية_3
# الوصف: z = c₁x₁ + c₂x₂ + c₃x₃
**#
دالة رقم دالة_هدف_خطية_3(رقم ج1، رقم ج2، رقم ج3، رقم س1، رقم س2، رقم س3)
    إرجاع ج1 * س1 + ج2 * س2 + ج3 * س3
نهاية


#**
# دالة: تحقق_قيد_خطي
# الوصف: التحقق: a₁x₁ + a₂x₂ ≤ b ?
# الإرجاع: 1 إذا محقق، 0 إذا لا
**#
دالة رقم تحقق_قيد_خطي(رقم أ1، رقم أ2، رقم س1، رقم س2، رقم ب)
    متغير رقم قيمة = أ1 * س1 + أ2 * س2
    إذا (قيمة <= ب)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: تقاطع_خطين_س
# الوصف: إيجاد نقطة تقاطع خطين (لأركان المنطقة الممكنة)
#         a1*x + b1*y = c1
#         a2*x + b2*y = c2
#         x = (c1*b2 - c2*b1) / (a1*b2 - a2*b1)
# الإرجاع: x مكبر ×1000
**#
دالة رقم تقاطع_خطين_س(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    متغير رقم محدد = أ1 * ب2 - أ2 * ب1
    إذا (محدد == 0)
        إرجاع 0 - 999999  # خطان متوازيان
    نهاية
    إرجاع (ج1 * ب2 - ج2 * ب1) * 1000 / محدد
نهاية

دالة رقم تقاطع_خطين_ص(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    متغير رقم محدد = أ1 * ب2 - أ2 * ب1
    إذا (محدد == 0)
        إرجاع 0 - 999999
    نهاية
    إرجاع (أ1 * ج2 - أ2 * ج1) * 1000 / محدد
نهاية


