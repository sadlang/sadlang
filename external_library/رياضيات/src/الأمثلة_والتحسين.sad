#**
# دالة: فيبوناتشي_ديناميكي
# الوصف: حساب فيبوناتشي بالبرمجة الديناميكية (من الأسفل)
#         O(n) بدلاً من O(2^n) في التكرار
**#
دالة رقم فيبوناتشي_ديناميكي(رقم ن)
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    إذا (ن == 1)
        إرجاع 1
    نهاية
    
    متغير رقم سابق = 0
    متغير رقم حالي = 1
    متغير رقم ع = 2
    
    طالما (ع <= ن)
        متغير رقم جديد = سابق + حالي
        سابق = حالي
        حالي = جديد
        ع = ع + 1
    نهاية
    
    إرجاع حالي
نهاية


#**
# دالة: مسألة_صعود_سلم
# الوصف: عدد طرق صعود سلم من n درجة
#         يمكن صعود 1 أو 2 درجة في كل خطوة
#         = فيبوناتشي(n+1)
**#
دالة رقم مسألة_صعود_سلم(رقم ن)
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    إذا (ن == 1)
        إرجاع 1
    نهاية
    إذا (ن == 2)
        إرجاع 2
    نهاية
    
    متغير رقم سابق = 1
    متغير رقم حالي = 2
    متغير رقم ع = 3
    
    طالما (ع <= ن)
        متغير رقم جديد = سابق + حالي
        سابق = حالي
        حالي = جديد
        ع = ع + 1
    نهاية
    
    إرجاع حالي
نهاية


#**
# دالة: توليفات_اختيار
# الوصف: C(n,k) - عدد التوليفات
#         C(n,k) = n! / (k! * (n-k)!)
#         بطريقة فعالة لتجنب الفيضان
**#
دالة رقم توليفات_اختيار(رقم ن، رقم ك)
    إذا (ك < 0)
        إرجاع 0
    نهاية
    إذا (ك > ن)
        إرجاع 0
    نهاية
    إذا (ك == 0)
        إرجاع 1
    نهاية
    إذا (ك == ن)
        إرجاع 1
    نهاية
    
    # استفد من C(n,k) = C(n,n-k)
    إذا (ك > ن - ك)
        ك = ن - ك
    نهاية
    
    متغير رقم نتيجة = 1
    متغير رقم ع = 0
    طالما (ع < ك)
        نتيجة = نتيجة * (ن - ع) / (ع + 1)
        ع = ع + 1
    نهاية
    
    إرجاع نتيجة
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 8: التحسين بالقيود                                      ║
# ║     Section 8: Constrained Optimization                            ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: لاغرانج_مضاعف_2د
# الوصف: التحسين بمضاعفات لاغرانج (حالة بسيطة)
#         تعظيم/تصغير f = c1*x + c2*y
#         بشرط g = a*x + b*y - d = 0
#         الحل: ∇f = λ∇g → c1 = λa, c2 = λb
#         λ = c1/a = c2/b (إذا متناسقة)
# المعاملات:
#   - ج1، ج2: معاملات الدالة الهدف
#   - أ، ب، د: معاملات القيد ax + by = d
# الإرجاع: قيمة x المثلى (مكبرة ×1000)
**#
دالة رقم لاغرانج_مضاعف_2د_س(رقم ج1، رقم ج2، رقم أ، رقم ب، رقم د)
    # من القيد: y = (d - ax)/b
    # الدالة: f = c1*x + c2*(d-ax)/b = (c1 - c2*a/b)*x + c2*d/b
    # المشتقة = 0: c1 - c2*a/b = 0 → x = (c1*d)/(c1*b + c2*a) فقط إذا متماثل
    # للحالة الخطية مع قيد خطي: الحل على الحدود
    
    # بما أن f خطية والقيد خطي، الحل على رؤوس المنطقة
    # النقطة: x = d/a (عند y=0)
    إذا (أ != 0)
        إرجاع (د * 1000) / أ
    نهاية
    إرجاع 0
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 9: الأمثلة العددية                                     ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: تقييم_كثير_حدود_هورنر
# الوصف: تقييم كثير الحدود بطريقة هورنر (الأكفأ)
#         p(x) = a₃x³ + a₂x² + a₁x + a₀
#             = ((a₃*x + a₂)*x + a₁)*x + a₀
#         فقط n ضرب + n جمع بدلاً من n(n+1)/2 ضرب
# المعاملات:
#   - أ0..أ3: المعاملات (من الدرجة 0 إلى 3)
#   - س: النقطة
# الإرجاع: p(x)
**#
دالة رقم تقييم_كثير_حدود_هورنر(رقم أ3، رقم أ2، رقم أ1، رقم أ0، رقم س)
    متغير رقم نتيجة = أ3
    نتيجة = نتيجة * س + أ2
    نتيجة = نتيجة * س + أ1
    نتيجة = نتيجة * س + أ0
    إرجاع نتيجة
نهاية


#**
# دالة: قوة_سريعة
# الوصف: حساب a^n بالتربيع المتكرر (Binary Exponentiation)
#         التعقيد: O(log n) بدلاً من O(n)
#         a^n = (a^(n/2))² إذا n زوجي
#         a^n = a * (a^((n-1)/2))² إذا n فردي
**#
دالة رقم قوة_سريعة(رقم أ، رقم ن)
    إذا (ن == 0)
        إرجاع 1
    نهاية
    إذا (ن == 1)
        إرجاع أ
    نهاية
    
    متغير رقم نتيجة = 1
    متغير رقم أساس = أ
    متغير رقم أس = ن
    
    طالما (أس > 0)
        # إذا فردي
        إذا (أس - (أس / 2) * 2 == 1)
            نتيجة = نتيجة * أساس
        نهاية
        أساس = أساس * أساس
        أس = أس / 2
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: قوة_مع_باقي
# الوصف: حساب a^n mod m بالتربيع المتكرر
#         مهم جداً في التشفير (RSA مثلاً)
**#
دالة رقم قوة_مع_باقي(رقم أ، رقم ن، رقم م)
    إذا (م == 1)
        إرجاع 0
    نهاية
    
    متغير رقم نتيجة = 1
    متغير رقم أساس = أ - (أ / م) * م
    متغير رقم أس = ن
    
    طالما (أس > 0)
        إذا (أس - (أس / 2) * 2 == 1)
            نتيجة = (نتيجة * أساس) - ((نتيجة * أساس) / م) * م
        نهاية
        أساس = (أساس * أساس) - ((أساس * أساس) / م) * م
        أس = أس / 2
    نهاية
    
    إرجاع نتيجة
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 10: الاختبارات الذاتية                                  ║
# ╚═══════════════════════════════════════════════════════════════════╝


دالة رقم تشغيل_اختبارات_التحسين()
    متغير رقم نجاح = 0
    متغير رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبارات الأمثلة والتحسين")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # √16 = 4
    إذا (جذر_تربيعي_نيوتن(16، 20) == 4)
        نجاح = نجاح + 1
        اطبع_سطر("✓ √16 = 4")
    وإلا
        فشل = فشل + 1
        اطبع("✗ √16: ")
        اطبع_سطر(جذر_تربيعي_نيوتن(16، 20))
    نهاية
    
    # √100 = 10
    إذا (جذر_تربيعي_نيوتن(100، 20) == 10)
        نجاح = نجاح + 1
        اطبع_سطر("✓ √100 = 10")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ √100")
    نهاية
    
    # وسيط 3
    إذا (وسيط_3(3، 1، 5) == 3)
        نجاح = نجاح + 1
        اطبع_سطر("✓ وسيط 3 أعداد")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ وسيط")
    نهاية
    
    # فيبوناتشي ديناميكي
    إذا (فيبوناتشي_ديناميكي(10) == 55)
        نجاح = نجاح + 1
        اطبع_سطر("✓ فيبوناتشي ديناميكي")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فيبوناتشي ديناميكي")
    نهاية
    
    # قوة سريعة: 2^10 = 1024
    إذا (قوة_سريعة(2، 10) == 1024)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 2^10 = 1024")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ قوة سريعة")
    نهاية
    
    # قوة مع باقي: 3^7 mod 5 = 2187 mod 5 = 2
    إذا (قوة_مع_باقي(3، 7، 5) == 2)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 3^7 mod 5 = 2")
    وإلا
        فشل = فشل + 1
        اطبع("✗ قوة مع باقي: ")
        اطبع_سطر(قوة_مع_باقي(3، 7، 5))
    نهاية
    
    # C(5,2) = 10
    إذا (توليفات_اختيار(5، 2) == 10)
        نجاح = نجاح + 1
        اطبع_سطر("✓ C(5,2) = 10")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ توليفات")
    نهاية
    
    # فكة العملات: 186 = 1×100 + 1×50 + 1×25 + 1×10 + 1×1 = 5 عملات
    متغير رقم عملات = مسألة_فكة_العملات(186)
    إذا (عملات == 5)
        نجاح = نجاح + 1
        اطبع_سطر("✓ فكة عملات 186")
    وإلا
        فشل = فشل + 1
        اطبع("✗ فكة عملات: ")
        اطبع_سطر(عملات)
    نهاية
    
    # هورنر: 2x³+3x²+x+5 عند x=2 → 16+12+2+5=35
    إذا (تقييم_كثير_حدود_هورنر(2، 3، 1، 5، 2) == 35)
        نجاح = نجاح + 1
        اطبع_سطر("✓ هورنر")
    وإلا
        فشل = فشل + 1
        اطبع("✗ هورنر: ")
        اطبع_سطر(تقييم_كثير_حدود_هورنر(2، 3، 1، 5، 2))
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


