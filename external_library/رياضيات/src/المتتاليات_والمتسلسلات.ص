# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 1: المتتاليات الحسابية (Arithmetic Sequences)          ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# المتتالية الحسابية:
# a_n = a₁ + (n-1) * d
# حيث a₁ = الحد الأول، d = الأساس (الفرق المشترك)
#
# أمثلة:
# - 2, 5, 8, 11, 14, ... (a₁=2, d=3)
# - 100, 95, 90, 85, ... (a₁=100, d=-5)
#
# مجموع n حد: S_n = n/2 * (2a₁ + (n-1)*d) = n*(a₁+a_n)/2
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: حسابية_حد
# الوصف: حساب الحد n من متتالية حسابية
#         a_n = a₁ + (n-1) * d
# المعاملات:
#   - أ1: الحد الأول
#   - د: الأساس (الفرق المشترك)
#   - ن: رقم الحد المطلوب (يبدأ من 1)
# الإرجاع: الحد n
**#
دالة رقم حسابية_حد(رقم أ1، رقم د، رقم ن)
    إرجاع أ1 + (ن - 1) * د
نهاية


#**
# دالة: حسابية_مجموع
# الوصف: مجموع أول n حد من متتالية حسابية
#         S_n = n * (2a₁ + (n-1)*d) / 2
**#
دالة رقم حسابية_مجموع(رقم أ1، رقم د، رقم ن)
    إرجاع ن * (2 * أ1 + (ن - 1) * د) / 2
نهاية


#**
# دالة: حسابية_أساس
# الوصف: حساب الأساس d من حدين معروفين
#         d = (a_m - a_n) / (m - n)
# المعاملات:
#   - أ_ن: الحد n
#   - أ_م: الحد m
#   - ن: رقم الحد الأول
#   - م: رقم الحد الثاني
# الإرجاع: الأساس d
**#
دالة رقم حسابية_أساس(رقم أ_ن، رقم أ_م، رقم ن، رقم م)
    متغير رقم فرق = م - ن
    إذا (فرق == 0)
        إرجاع 0
    نهاية
    إرجاع (أ_م - أ_ن) / فرق
نهاية


#**
# دالة: حسابية_عدد_الحدود
# الوصف: عدد حدود متتالية حسابية من a₁ إلى a_n
#         n = (a_n - a₁)/d + 1
**#
دالة رقم حسابية_عدد_الحدود(رقم أ1، رقم أخير، رقم د)
    إذا (د == 0)
        إذا (أ1 == أخير)
            إرجاع 1
        نهاية
        إرجاع 0
    نهاية
    إرجاع (أخير - أ1) / د + 1
نهاية


#**
# دالة: حسابية_وسط
# الوصف: الوسط الحسابي بين عددين
#         M = (a + b) / 2
**#
دالة رقم حسابية_وسط(رقم أ، رقم ب)
    إرجاع (أ + ب) / 2
نهاية


#**
# دالة: حسابية_مجموع_بين
# الوصف: مجموع الأعداد الحسابية بين قيمتين
#         S = n*(أول + آخر)/2
**#
دالة رقم حسابية_مجموع_بين(رقم أول، رقم آخر، رقم د)
    إذا (د == 0)
        إرجاع أول
    نهاية
    متغير رقم ن = (آخر - أول) / د + 1
    إرجاع ن * (أول + آخر) / 2
نهاية


