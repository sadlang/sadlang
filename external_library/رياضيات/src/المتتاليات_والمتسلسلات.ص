#**
# دالة: متتالية_كولاتز
# الوصف: حساب طول متتالية كولاتز (3n+1) حتى تصل إلى 1
#         - إذا n زوجي: n ← n/2
#         - إذا n فردي: n ← 3n+1
#         النظرية: كل عدد طبيعي يصل في النهاية إلى 1
#         (لم تُثبت بعد!)
**#
دالة رقم متتالية_كولاتز(رقم ن)
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    
    متغير رقم خطوات = 0
    متغير رقم قيمة = ن
    
    طالما (قيمة > 1)
        إذا (قيمة - (قيمة / 2) * 2 == 0)
            # زوجي
            قيمة = قيمة / 2
        وإلا
            # فردي
            قيمة = 3 * قيمة + 1
        نهاية
        خطوات = خطوات + 1
        
        إذا (خطوات > 10000)
            إرجاع 0 - 1  # حماية من حلقة لانهائية
        نهاية
    نهاية
    
    إرجاع خطوات
نهاية


