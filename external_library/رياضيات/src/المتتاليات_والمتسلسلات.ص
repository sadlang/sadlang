#**
# دالة: باي_لايبنتز
# الوصف: تقريب π باستخدام متسلسلة لايبنتز
#         π/4 = 1 - 1/3 + 1/5 - 1/7 + ...
# المعاملات:
#   - حدود: عدد الحدود
# الإرجاع: π مكبر ×10000
**#
دالة رقم باي_لايبنتز(رقم حدود)
    متغير رقم مجموع = 0
    متغير رقم إشارة = 1
    متغير رقم ع = 0
    
    طالما (ع < حدود)
        مجموع = مجموع + إشارة * 10000 / (2 * ع + 1)
        إشارة = 0 - إشارة
        ع = ع + 1
    نهاية
    
    إرجاع 4 * مجموع
نهاية


#**
# دالة: هـ_متسلسلة
# الوصف: تقريب e باستخدام المتسلسلة
#         e = 1 + 1/1! + 1/2! + 1/3! + ...
# الإرجاع: e مكبر ×10000
**#
دالة رقم هـ_متسلسلة(رقم حدود)
    متغير رقم مجموع = 10000  # الحد الصفري = 1
    متغير رقم مضروب = 1
    
    متغير رقم ع = 1
