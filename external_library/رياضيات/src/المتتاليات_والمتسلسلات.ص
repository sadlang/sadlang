# ║     القسم 2: المتتاليات الهندسية (Geometric Sequences)           ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# المتتالية الهندسية:
# a_n = a₁ * r^(n-1)
# حيث a₁ = الحد الأول، r = النسبة (الأساس الهندسي)
#
# مجموع n حد: S_n = a₁ * (1-r^n) / (1-r) إذا r≠1
# مجموع لانهائي: S = a₁ / (1-r) إذا |r| < 1
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: هندسية_حد
# الوصف: الحد n من متتالية هندسية = a₁ * r^(n-1)
# المعاملات:
#   - أ1: الحد الأول
#   - ر: النسبة
#   - ن: رقم الحد
# الإرجاع: a_n
**#
دالة رقم هندسية_حد(رقم أ1، رقم ر، رقم ن)
    متغير رقم قوة = 1
    متغير رقم ع = 0
    طالما (ع < ن - 1)
        قوة = قوة * ر
        ع = ع + 1
    نهاية
    إرجاع أ1 * قوة
نهاية


#**
# دالة: هندسية_مجموع
# الوصف: مجموع أول n حد
#         S_n = a₁ * (r^n - 1) / (r - 1) إذا r≠1
#         S_n = n * a₁ إذا r=1
**#
دالة رقم هندسية_مجموع(رقم أ1، رقم ر، رقم ن)
    إذا (ر == 1)
        إرجاع ن * أ1
    نهاية
    
    # حساب r^n
    متغير رقم قوة = 1
    متغير رقم ع = 0
    طالما (ع < ن)
        قوة = قوة * ر
        ع = ع + 1
    نهاية
    
    إرجاع أ1 * (قوة - 1) / (ر - 1)
نهاية


#**
# دالة: هندسية_مجموع_لانهائي
# الوصف: مجموع المتسلسلة الهندسية اللانهائية
#         S = a₁ / (1-r)  (فقط إذا |r| < 1)
#         نحسب بتكبير ×1000
# المعاملات:
#   - أ1: الحد الأول
#   - ر_مكبر: النسبة مكبرة ×1000 (|r| < 1000)
# الإرجاع: المجموع مكبر ×1000
**#
دالة رقم هندسية_مجموع_لانهائي(رقم أ1، رقم ر_مكبر)
    متغير رقم ر_مطلق = ر_مكبر
    إذا (ر_مطلق < 0)
        ر_مطلق = 0 - ر_مطلق
    نهاية
    
    إذا (ر_مطلق >= 1000)
        إرجاع 0 - 1  # لا يتقارب
    نهاية
    
    # S = a₁*1000 / (1000 - r)
    متغير رقم مقام = 1000 - ر_مكبر
    إذا (مقام == 0)
        إرجاع 0 - 1
    نهاية
    
    إرجاع (أ1 * 1000000) / مقام
نهاية


#**
# دالة: هندسية_وسط
# الوصف: الوسط الهندسي بين عددين موجبين = √(a*b)
#         نحسبه بطريقة نيوتن
**#
دالة رقم هندسية_وسط(رقم أ، رقم ب)
    متغير رقم حاصل = أ * ب
    إذا (حاصل <= 0)
        إرجاع 0
    نهاية
    
    # جذر حاصل الضرب
    متغير رقم تخمين = (أ + ب) / 2
    إذا (تخمين <= 0)
        تخمين = 1
    نهاية
    
    متغير رقم ع = 0
    طالما (ع < 20)
        إذا (تخمين == 0)
            تخمين = 1
        نهاية
        تخمين = (تخمين + حاصل / تخمين) / 2
        ع = ع + 1
    نهاية
    
    إرجاع تخمين
نهاية


