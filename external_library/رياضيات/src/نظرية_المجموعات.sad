#**
# دالة: مسألة_الحفلة
# الوصف: مسألة الحفلة (Party Problem):
#         في حفلة من n شخص، هل يمكن ضمان وجود
#         مجموعة من k أشخاص يعرفون بعضهم جميعاً
#         أو k أشخاص لا يعرف أي منهم الآخر?
#         (أعداد رامزي)
#         R(3,3) = 6: في أي حفلة من 6 أشخاص، يوجد
#         3 يعرفون بعضهم أو 3 غرباء عن بعضهم
# المعاملات:
#   - ن: عدد الأشخاص
# الإرجاع: الحد الأدنى المضمون (مبسط)
**#
دالة رقم مسألة_الحفلة(رقم ن)
    # R(3,3) = 6
    إذا (ن >= 6)
        إرجاع 3
    نهاية
    إذا (ن >= 2)
        إرجاع 2
    نهاية
    إرجاع 1
نهاية


#**
# دالة: عدد_التقسيمات
# الوصف: عدد طرق تقسيم مجموعة من n عنصر إلى مجموعتين غير فارغتين
#         = 2^(n-1) - 1
#         مثال: {1,2,3} يمكن تقسيمها إلى:
#         {1},{2,3} أو {2},{1,3} أو {3},{1,2}
#         = 2² - 1 = 3 طرق
**#
دالة رقم عدد_التقسيمات(رقم ن)
    إذا (ن < 2)
        إرجاع 0
    نهاية
    متغير رقم قوة = 1
    متغير رقم ع = 0
    طالما (ع < ن - 1)
        قوة = قوة * 2
        ع = ع + 1
    نهاية
    إرجاع قوة - 1
نهاية


#**
# دالة: رقم_بيل
# الوصف: أرقام بيل B(n) = عدد جميع التقسيمات الممكنة لمجموعة من n عنصر
#         B(0)=1, B(1)=1, B(2)=2, B(3)=5, B(4)=15, B(5)=52
#         باستخدام مثلث بيل
**#
دالة رقم رقم_بيل(رقم ن)
    إذا (ن <= 0)
        إرجاع 1
    نهاية
    إذا (ن == 1)
        إرجاع 1
    نهاية
    إذا (ن == 2)
        إرجاع 2
    نهاية
    إذا (ن == 3)
        إرجاع 5
    نهاية
    إذا (ن == 4)
        إرجاع 15
    نهاية
    إذا (ن == 5)
        إرجاع 52
    نهاية
    إذا (ن == 6)
        إرجاع 203
    نهاية
    إذا (ن == 7)
        إرجاع 877
    نهاية
    إذا (ن == 8)
        إرجاع 4140
    نهاية
    إذا (ن == 9)
        إرجاع 21147
    نهاية
    إذا (ن == 10)
        إرجاع 115975
    نهاية
    إرجاع 0 - 1
نهاية


#**
# دالة: رقم_ستيرلنغ_2
# الوصف: أرقام ستيرلنغ من النوع الثاني S(n,k)
#         = عدد طرق تقسيم مجموعة من n عنصر إلى k مجموعات جزئية غير فارغة
#         S(n,1) = 1, S(n,n) = 1
#         S(n,k) = k*S(n-1,k) + S(n-1,k-1)
**#
دالة رقم رقم_ستيرلنغ_2(رقم ن، رقم ك)
    إذا (ك <= 0)
        إرجاع 0
    نهاية
    إذا (ك > ن)
        إرجاع 0
    نهاية
    إذا (ك == 1)
        إرجاع 1
    نهاية
    إذا (ك == ن)
        إرجاع 1
    نهاية
    
    إرجاع ك * رقم_ستيرلنغ_2(ن - 1، ك) + رقم_ستيرلنغ_2(ن - 1، ك - 1)
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 10: الاختبارات الذاتية                                  ║
# ╚═══════════════════════════════════════════════════════════════════╝


دالة رقم تشغيل_اختبارات_المجموعات()
    متغير رقم نجاح = 0
    متغير رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبارات نظرية المجموعات")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # إنشاء مجموعات
    متغير رقم أ = مجم_من_3(0، 1، 2)  # {0, 1, 2}
    متغير رقم ب = مجم_من_3(1، 2، 3)  # {1, 2, 3}
    
    # حجم
    إذا (مجم_حجم(أ) == 3)
        نجاح = نجاح + 1
        اطبع_سطر("✓ حجم المجموعة")
    وإلا
        فشل = فشل + 1
        اطبع("✗ حجم المجموعة: ")
        اطبع_سطر(مجم_حجم(أ))
    نهاية
    
    # انتماء
    إذا (مجم_ينتمي(1، أ) == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ انتماء عنصر")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ انتماء عنصر")
    نهاية
    
    # عدم انتماء
    إذا (مجم_ينتمي(5، أ) == 0)
        نجاح = نجاح + 1
        اطبع_سطر("✓ عدم انتماء")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ عدم انتماء")
    نهاية
    
    # تقاطع {0,1,2} ∩ {1,2,3} = {1,2}
    متغير رقم تق = مجم_تقاطع(أ، ب)
    إذا (مجم_حجم(تق) == 2)
        نجاح = نجاح + 1
        اطبع_سطر("✓ تقاطع")
    وإلا
        فشل = فشل + 1
        اطبع("✗ تقاطع: ")
        اطبع_سطر(مجم_حجم(تق))
    نهاية
    
    # فرق {0,1,2} \ {1,2,3} = {0}
    متغير رقم فر = مجم_فرق(أ، ب)
    إذا (مجم_حجم(فر) == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ فرق")
    وإلا
        فشل = فشل + 1
        اطبع("✗ فرق: ")
        اطبع_سطر(مجم_حجم(فر))
    نهاية
    
    # أرقام بيل
    إذا (رقم_بيل(3) == 5)
        نجاح = نجاح + 1
        اطبع_سطر("✓ أرقام بيل")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ أرقام بيل")
    نهاية
    
    # ستيرلنغ S(4,2) = 7
    إذا (رقم_ستيرلنغ_2(4، 2) == 7)
        نجاح = نجاح + 1
        اطبع_سطر("✓ ستيرلنغ")
    وإلا
        فشل = فشل + 1
        اطبع("✗ ستيرلنغ: ")
        اطبع_سطر(رقم_ستيرلنغ_2(4، 2))
    نهاية
    
    # مجموعة فارغة
    إذا (مجم_فارغة_هل(0) == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مجموعة فارغة")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ مجموعة فارغة")
    نهاية
    
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


