# الوصف: اتحاد ثلاث مجموعات A ∪ B ∪ C
**#
دالة رقم مجم_اتحاد_3(رقم أ، رقم ب، رقم ج)
    إرجاع مجم_اتحاد(مجم_اتحاد(أ، ب)، ج)
نهاية


