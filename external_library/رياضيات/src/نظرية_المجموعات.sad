دالة رقم مجم_اتحاد_4(رقم أ، رقم ب، رقم ج، رقم د)
    إرجاع مجم_اتحاد(مجم_اتحاد_3(أ، ب، ج)، د)
نهاية


#**
# دالة: مجم_تقاطع_4
# الوصف: تقاطع أربع مجموعات
**#
دالة رقم مجم_تقاطع_4(رقم أ، رقم ب، رقم ج، رقم د)
    إرجاع مجم_تقاطع(مجم_تقاطع_3(أ، ب، ج)، د)
نهاية


