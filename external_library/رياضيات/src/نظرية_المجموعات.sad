# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 1: عمليات المجموعات الأساسية                           ║
# ║     Section 1: Basic Set Operations                                ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# المجموعة هي تجميع من عناصر مختلفة بدون تكرار وبدون ترتيب.
# نمثل المجموعات هنا بأعداد صحيحة حيث كل بت يمثل عنصراً:
# المجموعة {0, 2, 3} = البت 0 + البت 2 + البت 3 = 1+4+8 = 13 = 1101₂
#
# هذا التمثيل يسمح بعمليات مجموعات فعالة جداً:
# - الاتحاد = OR (|)
# - التقاطع = AND (&)
# - الفرق = AND NOT
# - المتمم = NOT (~)
# - الفرق المتماثل = XOR (^)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: مجم_فارغة
# الوصف: إنشاء مجموعة فارغة ∅
# الإرجاع: 0 (لا عناصر)
**#
دالة رقم مجم_فارغة()
    إرجاع 0
نهاية


#**
# دالة: مجم_عنصر_واحد
# الوصف: إنشاء مجموعة تحتوي عنصراً واحداً {n}
# المعاملات:
#   - ن: رقم العنصر (0 إلى 30)
# الإرجاع: المجموعة كقناع بتي
**#
دالة رقم مجم_عنصر_واحد(رقم ن)
    إذا (ن < 0)
        إرجاع 0
    نهاية
    إذا (ن > 30)
        إرجاع 0
    نهاية
    
    # حساب 2^n
    متغير رقم نتيجة = 1
    متغير رقم ع = 0
    طالما (ع < ن)
        نتيجة = نتيجة * 2
        ع = ع + 1
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: مجم_من_2
# الوصف: إنشاء مجموعة من عنصرين {أ, ب}
**#
دالة رقم مجم_من_2(رقم أ، رقم ب)
    إرجاع مجم_عنصر_واحد(أ) + مجم_عنصر_واحد(ب)
نهاية


#**
# دالة: مجم_من_3
# الوصف: إنشاء مجموعة من ثلاثة عناصر {أ, ب, ج}
**#
دالة رقم مجم_من_3(رقم أ، رقم ب، رقم ج)
    إرجاع مجم_عنصر_واحد(أ) + مجم_عنصر_واحد(ب) + مجم_عنصر_واحد(ج)
نهاية


#**
# دالة: مجم_من_4
# الوصف: إنشاء مجموعة من أربعة عناصر {أ, ب, ج, د}
**#
دالة رقم مجم_من_4(رقم أ، رقم ب، رقم ج، رقم د)
    إرجاع مجم_عنصر_واحد(أ) + مجم_عنصر_واحد(ب) + مجم_عنصر_واحد(ج) + مجم_عنصر_واحد(د)
نهاية


#**
# دالة: مجم_من_5
# الوصف: إنشاء مجموعة من خمسة عناصر
**#
دالة رقم مجم_من_5(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ)
    إرجاع مجم_عنصر_واحد(أ) + مجم_عنصر_واحد(ب) + مجم_عنصر_واحد(ج) + مجم_عنصر_واحد(د) + مجم_عنصر_واحد(هـ)
نهاية


#**
# دالة: مجم_اتحاد
# الوصف: اتحاد مجموعتين A ∪ B
#         يحتوي جميع عناصر A و B
# المعاملات:
#   - أ: المجموعة الأولى (قناع بتي)
#   - ب: المجموعة الثانية
# الإرجاع: A ∪ B
**#
دالة رقم مجم_اتحاد(رقم أ، رقم ب)
    # عملية OR المنطقية
    # نحسبها بت ببت
    متغير رقم نتيجة = 0
    متغير رقم موضع = 1
    متغير رقم قيمة_أ = أ
    متغير رقم قيمة_ب = ب
    
    طالما (قيمة_أ > 0)
        إذا (قيمة_أ - (قيمة_أ / 2) * 2 == 1)
            نتيجة = نتيجة + موضع
        نهاية
        قيمة_أ = قيمة_أ / 2
        موضع = موضع * 2
    نهاية
    
    # إضافة عناصر ب غير الموجودة في أ
    موضع = 1
    قيمة_ب = ب
    طالما (قيمة_ب > 0)
        إذا (قيمة_ب - (قيمة_ب / 2) * 2 == 1)
            # تحقق إذا لم يُضف مسبقاً
            متغير رقم تحقق = نتيجة / موضع
            إذا (تحقق - (تحقق / 2) * 2 == 0)
                نتيجة = نتيجة + موضع
            نهاية
        نهاية
        قيمة_ب = قيمة_ب / 2
        موضع = موضع * 2
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: مجم_تقاطع
# الوصف: تقاطع مجموعتين A ∩ B
#         يحتوي العناصر المشتركة فقط
**#
دالة رقم مجم_تقاطع(رقم أ، رقم ب)
    متغير رقم نتيجة = 0
    متغير رقم موضع = 1
    متغير رقم قيمة_أ = أ
    متغير رقم قيمة_ب = ب
    
    طالما (قيمة_أ > 0)
        إذا (قيمة_أ - (قيمة_أ / 2) * 2 == 1)
            # تحقق إذا كان موجود في ب
            متغير رقم بت_ب = قيمة_ب - (قيمة_ب / 2) * 2
            إذا (بت_ب == 1)
                نتيجة = نتيجة + موضع
            نهاية
        نهاية
        قيمة_أ = قيمة_أ / 2
        قيمة_ب = قيمة_ب / 2
        موضع = موضع * 2
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: مجم_فرق
# الوصف: فرق مجموعتين A \ B (أو A - B)
#         يحتوي عناصر A غير الموجودة في B
**#
دالة رقم مجم_فرق(رقم أ، رقم ب)
    متغير رقم تقاطع = مجم_تقاطع(أ، ب)
    # A \ B = A - (A ∩ B)
    # نزيل من أ العناصر المشتركة
    إرجاع أ - تقاطع
نهاية


#**
# دالة: مجم_فرق_متماثل
# الوصف: الفرق المتماثل A △ B = (A\B) ∪ (B\A)
#         = (A ∪ B) \ (A ∩ B)
#         يحتوي العناصر في A أو B ولكن ليس في كليهما
**#
دالة رقم مجم_فرق_متماثل(رقم أ، رقم ب)
    متغير رقم اتحاد = مجم_اتحاد(أ، ب)
    متغير رقم تقاطع = مجم_تقاطع(أ، ب)
    إرجاع مجم_فرق(اتحاد، تقاطع)
نهاية


#**
# دالة: مجم_متمم
# الوصف: المتمم A' بالنسبة لمجموعة شاملة من n عنصر
#         A' = U \ A
# المعاملات:
#   - أ: المجموعة
#   - ن: حجم المجموعة الشاملة (عدد العناصر)
# الإرجاع: المتمم
**#
دالة رقم مجم_متمم(رقم أ، رقم ن)
    # المجموعة الشاملة = 2^n - 1
    متغير رقم شاملة = 1
    متغير رقم ع = 0
    طالما (ع < ن)
        شاملة = شاملة * 2
        ع = ع + 1
    نهاية
    شاملة = شاملة - 1
    
    إرجاع مجم_فرق(شاملة، أ)
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 2: اختبارات الانتماء والاحتواء                         ║
# ║     Section 2: Membership & Containment Tests                      ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: مجم_ينتمي
# الوصف: هل العنصر n ينتمي إلى المجموعة A?
#         n ∈ A?
# المعاملات:
#   - ن: رقم العنصر
#   - مجم: المجموعة
# الإرجاع: 1 إذا ينتمي، 0 إذا لا
**#
دالة رقم مجم_ينتمي(رقم ن، رقم مجم)
    إذا (ن < 0)
        إرجاع 0
    نهاية
    إذا (ن > 30)
        إرجاع 0
    نهاية
    
    متغير رقم قيمة = مجم
    متغير رقم ع = 0
    طالما (ع < ن)
        قيمة = قيمة / 2
        ع = ع + 1
    نهاية
    
    # تحقق من البت الأخير
    إرجاع قيمة - (قيمة / 2) * 2
نهاية


#**
# دالة: مجم_مجموعة_جزئية
# الوصف: هل A مجموعة جزئية من B?
#         A ⊆ B (كل عنصر في A موجود في B)
# الإرجاع: 1 إذا A ⊆ B، 0 إذا لا
**#
دالة رقم مجم_مجموعة_جزئية(رقم أ، رقم ب)
    # A ⊆ B يعني A ∩ B = A
    متغير رقم تقاطع = مجم_تقاطع(أ، ب)
    إذا (تقاطع == أ)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: مجم_مجموعة_جزئية_حقيقية
# الوصف: هل A مجموعة جزئية حقيقية من B?
#         A ⊂ B (A ⊆ B و A ≠ B)
**#
دالة رقم مجم_مجموعة_جزئية_حقيقية(رقم أ، رقم ب)
    إذا (أ == ب)
        إرجاع 0
    نهاية
    إرجاع مجم_مجموعة_جزئية(أ، ب)
نهاية


#**
# دالة: مجم_متساويتان
# الوصف: هل مجموعتان متساويتان? A = B
**#
دالة رقم مجم_متساويتان(رقم أ، رقم ب)
    إذا (أ == ب)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: مجم_منفصلتان
# الوصف: هل مجموعتان منفصلتان (لا عناصر مشتركة)?
#         A ∩ B = ∅
**#
دالة رقم مجم_منفصلتان(رقم أ، رقم ب)
    متغير رقم تقاطع = مجم_تقاطع(أ، ب)
    إذا (تقاطع == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 3: العلاقات (Relations)                                 ║
# ║     Section 3: Relations                                           ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# العلاقة هي مجموعة جزئية من حاصل الضرب الديكارتي A × B.
# نمثلها كمصفوفة بتية: R(i,j) = 1 إذا (i,j) ∈ R
#
# لمجموعة من n عنصر، نخزن العلاقة كعدد:
# الموضع i*n + j يمثل (i,j)
#
# خصائص العلاقات:
# - انعكاسية: aRa لكل a (القطر = 1)
# - متماثلة: aRb → bRa
# - متعدية: aRb ∧ bRc → aRc
# - معاكسة للتماثل: aRb ∧ bRa → a=b
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: علاقة_إضافة_زوج
# الوصف: إضافة زوج (i,j) إلى علاقة على مجموعة من n عنصر
# المعاملات:
#   - علاقة: العلاقة الحالية (قناع بتي)
#   - ع1: العنصر الأول (0 إلى n-1)
#   - ع2: العنصر الثاني
#   - ن: حجم المجموعة
# الإرجاع: العلاقة الجديدة
**#
دالة رقم علاقة_إضافة_زوج(رقم علاقة، رقم ع1، رقم ع2، رقم ن)
    متغير رقم موضع = ع1 * ن + ع2
    إذا (موضع > 30)
        إرجاع علاقة
    نهاية
    إرجاع مجم_اتحاد(علاقة، مجم_عنصر_واحد(موضع))
نهاية


#**
# دالة: علاقة_تحتوي_زوج
# الوصف: هل العلاقة تحتوي الزوج (i,j)?
**#
دالة رقم علاقة_تحتوي_زوج(رقم علاقة، رقم ع1، رقم ع2، رقم ن)
    متغير رقم موضع = ع1 * ن + ع2
    إذا (موضع > 30)
        إرجاع 0
    نهاية
    إرجاع مجم_ينتمي(موضع، علاقة)
نهاية


#**
# دالة: علاقة_انعكاسية
# الوصف: إنشاء علاقة انعكاسية (القطر)
#         R = {(0,0), (1,1), ..., (n-1,n-1)}
# المعاملات:
#   - ن: حجم المجموعة
# الإرجاع: العلاقة الانعكاسية
**#
دالة رقم علاقة_انعكاسية(رقم ن)
    متغير رقم نتيجة = 0
    متغير رقم ع = 0
    طالما (ع < ن)
        متغير رقم موضع = ع * ن + ع
        إذا (موضع <= 30)
            نتيجة = نتيجة + مجم_عنصر_واحد(موضع)
        نهاية
        ع = ع + 1
    نهاية
    إرجاع نتيجة
نهاية


#**
# دالة: علاقة_هل_انعكاسية
# الوصف: هل العلاقة انعكاسية? (aRa لكل a)
**#
دالة رقم علاقة_هل_انعكاسية(رقم علاقة، رقم ن)
    متغير رقم انعكاسية = علاقة_انعكاسية(ن)
    # يجب أن تحتوي العلاقة على جميع عناصر القطر
    إرجاع مجم_مجموعة_جزئية(انعكاسية، علاقة)
نهاية


#**
# دالة: علاقة_عكسية
# الوصف: إنشاء العلاقة العكسية R⁻¹
#         (i,j) ∈ R ↔ (j,i) ∈ R⁻¹
**#
دالة رقم علاقة_عكسية(رقم علاقة، رقم ن)
    متغير رقم نتيجة = 0
    متغير رقم ع1 = 0
    طالما (ع1 < ن)
        متغير رقم ع2 = 0
        طالما (ع2 < ن)
            إذا (علاقة_تحتوي_زوج(علاقة، ع1، ع2، ن) == 1)
                نتيجة = علاقة_إضافة_زوج(نتيجة، ع2، ع1، ن)
            نهاية
            ع2 = ع2 + 1
        نهاية
        ع1 = ع1 + 1
    نهاية
    إرجاع نتيجة
نهاية


#**
# دالة: علاقة_هل_متماثلة
# الوصف: هل العلاقة متماثلة? (aRb → bRa)
**#
دالة رقم علاقة_هل_متماثلة(رقم علاقة، رقم ن)
    متغير رقم عكسية = علاقة_عكسية(علاقة، ن)
    إذا (علاقة == عكسية)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 4: خصائص المجموعات                                     ║
# ║     Section 4: Set Properties                                      ║
# ╚═══════════════════════════════════════════════════════════════════╝

#**
# دالة: مجم_حجم
# الوصف: حساب عدد عناصر المجموعة |A|
#         (عدد البتات = 1)
**#
دالة رقم مجم_حجم(رقم مجم)
    متغير رقم عدد = 0
    متغير رقم قيمة = مجم
    
    طالما (قيمة > 0)
        إذا (قيمة - (قيمة / 2) * 2 == 1)
            عدد = عدد + 1
        نهاية
        قيمة = قيمة / 2
    نهاية
    
    إرجاع عدد
نهاية


#**
# دالة: مجم_فارغة_هل
# الوصف: هل المجموعة فارغة? A = ∅?
**#
دالة رقم مجم_فارغة_هل(رقم مجم)
    إذا (مجم == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: مجم_أصغر_عنصر
# الوصف: أصغر عنصر في المجموعة (رقم أول بت = 1)
# الإرجاع: رقم العنصر، أو -1 إذا فارغة
**#
دالة رقم مجم_أصغر_عنصر(رقم مجم)
    إذا (مجم == 0)
        إرجاع 0 - 1
    نهاية
    
    متغير رقم قيمة = مجم
    متغير رقم رقم_بت = 0
    
    طالما (قيمة > 0)
        إذا (قيمة - (قيمة / 2) * 2 == 1)
            إرجاع رقم_بت
        نهاية
        قيمة = قيمة / 2
        رقم_بت = رقم_بت + 1
    نهاية
    
    إرجاع 0 - 1
نهاية


#**
# دالة: مجم_أكبر_عنصر
# الوصف: أكبر عنصر في المجموعة (رقم آخر بت = 1)
**#
دالة رقم مجم_أكبر_عنصر(رقم مجم)
    إذا (مجم == 0)
        إرجاع 0 - 1
    نهاية
    
    متغير رقم قيمة = مجم
    متغير رقم رقم_بت = 0
    متغير رقم آخر = 0 - 1
    
    طالما (قيمة > 0)
        إذا (قيمة - (قيمة / 2) * 2 == 1)
            آخر = رقم_بت
        نهاية
        قيمة = قيمة / 2
        رقم_بت = رقم_بت + 1
    نهاية
    
    إرجاع آخر
نهاية


#**
# دالة: مجم_إزالة_عنصر
# الوصف: إزالة عنصر من المجموعة A \ {n}
**#
دالة رقم مجم_إزالة_عنصر(رقم مجم، رقم ن)
    إذا (مجم_ينتمي(ن، مجم) == 1)
        إرجاع مجم - مجم_عنصر_واحد(ن)
    نهاية
    إرجاع مجم
نهاية


#**
# دالة: مجم_إضافة_عنصر
# الوصف: إضافة عنصر إلى المجموعة A ∪ {n}
**#
دالة رقم مجم_إضافة_عنصر(رقم مجم، رقم ن)
    إذا (مجم_ينتمي(ن، مجم) == 0)
        إرجاع مجم + مجم_عنصر_واحد(ن)
    نهاية
    إرجاع مجم
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 5: مجموعة القوة (Power Set)                            ║
# ║     Section 5: Power Set                                           ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# مجموعة القوة P(A) هي مجموعة جميع المجموعات الجزئية لـ A.
# إذا |A| = n، فإن |P(A)| = 2ⁿ
#
# مثال: P({0,1}) = {∅, {0}, {1}, {0,1}}
#
# لا يمكننا إرجاع مجموعة القوة كمجموعة واحدة،
# لذا نوفر دوال لعد وتوليد المجموعات الجزئية.
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: حجم_مجموعة_القوة
# الوصف: حساب |P(A)| = 2^|A|
**#
دالة رقم حجم_مجموعة_القوة(رقم مجم)
    متغير رقم ن = مجم_حجم(مجم)
    متغير رقم نتيجة = 1
    متغير رقم ع = 0
    طالما (ع < ن)
        نتيجة = نتيجة * 2
        ع = ع + 1
    نهاية
    إرجاع نتيجة
نهاية


#**
# دالة: مجموعة_جزئية_رقم
# الوصف: إرجاع المجموعة الجزئية رقم k من مجموعة {0,...,n-1}
#         K تمثل القناع البتي للمجموعة الجزئية
# المعاملات:
#   - ك: رقم المجموعة الجزئية (0 إلى 2^n - 1)
#   - ن: حجم المجموعة الأصلية
# الإرجاع: المجموعة الجزئية كقناع بتي
**#
دالة رقم مجموعة_جزئية_رقم(رقم ك، رقم ن)
    إذا (ك < 0)
        إرجاع 0
    نهاية
    متغير رقم حد = حجم_مجموعة_القوة(ن)
    إذا (ك >= حد)
        إرجاع 0
    نهاية
    إرجاع ك
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 6: حساب المجموعات (Counting)                           ║
# ║     Section 6: Set Counting                                        ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: مبدأ_الشمول_والاستبعاد_2
# الوصف: |A ∪ B| = |A| + |B| - |A ∩ B|
#         (مبدأ الشمول والاستبعاد لمجموعتين)
**#
دالة رقم مبدأ_الشمول_والاستبعاد_2(رقم أ، رقم ب)
    إرجاع مجم_حجم(أ) + مجم_حجم(ب) - مجم_حجم(مجم_تقاطع(أ، ب))
نهاية


#**
# دالة: مبدأ_الشمول_والاستبعاد_3
# الوصف: |A ∪ B ∪ C| = |A|+|B|+|C|-|A∩B|-|A∩C|-|B∩C|+|A∩B∩C|
**#
دالة رقم مبدأ_الشمول_والاستبعاد_3(رقم أ، رقم ب، رقم ج)
    متغير رقم تأب = مجم_تقاطع(أ، ب)
    متغير رقم تأج = مجم_تقاطع(أ، ج)
    متغير رقم تبج = مجم_تقاطع(ب، ج)
    متغير رقم تأبج = مجم_تقاطع(تأب، ج)
    
    إرجاع مجم_حجم(أ) + مجم_حجم(ب) + مجم_حجم(ج) - مجم_حجم(تأب) - مجم_حجم(تأج) - مجم_حجم(تبج) + مجم_حجم(تأبج)
نهاية


#**
# دالة: حاصل_ضرب_ديكارتي_حجم
# الوصف: |A × B| = |A| * |B|
**#
دالة رقم حاصل_ضرب_ديكارتي_حجم(رقم أ، رقم ب)
    إرجاع مجم_حجم(أ) * مجم_حجم(ب)
نهاية


#**
# دالة: عدد_العلاقات_الممكنة
# الوصف: عدد العلاقات الممكنة على مجموعة من n عنصر
#         = 2^(n²)
**#
دالة رقم عدد_العلاقات_الممكنة(رقم ن)
    متغير رقم أس = ن * ن
    متغير رقم نتيجة = 1
    متغير رقم ع = 0
    طالما (ع < أس)
        نتيجة = نتيجة * 2
        إذا (نتيجة > 1000000000)
            إرجاع نتيجة  # تجنب الفيضان
        نهاية
        ع = ع + 1
    نهاية
    إرجاع نتيجة
نهاية


