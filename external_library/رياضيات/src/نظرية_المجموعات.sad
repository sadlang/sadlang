#**
# دالة: مجم_قواسم
# الوصف: إنشاء مجموعة قواسم عدد (حتى 30)
#         مثال: قواسم 12 = {1,2,3,4,6,12}
#         نمثلها كقناع بتي حيث البت i يعني i من القواسم
# المعاملات:
#   - ن: العدد
# الإرجاع: مجموعة القواسم
**#
دالة رقم مجم_قواسم(رقم ن)
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    
    متغير رقم نتيجة = 0
    متغير رقم ع = 1
    طالما (ع <= ن)
        إذا (ع <= 30)
            إذا (ن - (ن / ع) * ع == 0)
                نتيجة = مجم_إضافة_عنصر(نتيجة، ع)
            نهاية
        نهاية
        ع = ع + 1
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: مجم_أعداد_أولية_حتى
# الوصف: مجموعة الأعداد الأولية حتى n (حتى 30)
#         باستخدام غربال إراتوستينس
**#
دالة رقم مجم_أعداد_أولية_حتى(رقم ن)
    إذا (ن < 2)
        إرجاع 0
    نهاية
    
    # نبدأ بجميع الأعداد من 2 إلى n
    متغير رقم نتيجة = 0
    متغير رقم ع = 2
    طالما (ع <= ن)
        إذا (ع <= 30)
            نتيجة = مجم_إضافة_عنصر(نتيجة، ع)
        نهاية
        ع = ع + 1
    نهاية
    
    # غربال
    متغير رقم ج = 2
    طالما (ج * ج <= ن)
        إذا (مجم_ينتمي(ج، نتيجة) == 1)
            # أزل مضاعفات ج
            متغير رقم م = ج * ج
            طالما (م <= ن)
                إذا (م <= 30)
                    نتيجة = مجم_إزالة_عنصر(نتيجة، م)
                نهاية
                م = م + ج
            نهاية
        نهاية
        ج = ج + 1
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: مجم_أعداد_زوجية_حتى
# الوصف: مجموعة الأعداد الزوجية حتى n
**#
دالة رقم مجم_أعداد_زوجية_حتى(رقم ن)
    متغير رقم نتيجة = 0
    متغير رقم ع = 2
    طالما (ع <= ن)
        إذا (ع <= 30)
            نتيجة = مجم_إضافة_عنصر(نتيجة، ع)
        نهاية
        ع = ع + 2
    نهاية
    إرجاع نتيجة
نهاية


#**
# دالة: مجم_أعداد_فردية_حتى
# الوصف: مجموعة الأعداد الفردية حتى n
**#
دالة رقم مجم_أعداد_فردية_حتى(رقم ن)
    متغير رقم نتيجة = 0
    متغير رقم ع = 1
    طالما (ع <= ن)
        إذا (ع <= 30)
            نتيجة = مجم_إضافة_عنصر(نتيجة، ع)
        نهاية
        ع = ع + 2
    نهاية
    إرجاع نتيجة
نهاية


