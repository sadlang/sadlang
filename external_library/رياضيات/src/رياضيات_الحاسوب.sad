#** ─────────────────────────────────────────────────────────────────
# خوارزميات التقريب العددي المتقدمة:
# 1. تقريب بادي (Padé Approximation)
# 2. استيفاء سبلاين (Spline Interpolation)
# 3. تكامل غاوس (Gaussian Quadrature)
# 4. طرق رانج-كوتا (Runge-Kutta)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: تكامل_شبه_المنحرف
# الوصف: تقريب التكامل بطريقة شبه المنحرف
#         ∫f ≈ h/2 * (f(a) + f(b))
#         هذا أبسط شكل (قطعة واحدة)
# المعاملات:
#   - فأ: قيمة الدالة عند a (مكبرة ×1000)
#   - فب: قيمة الدالة عند b (مكبرة ×1000)
#   - ه: طول الفترة (مكبر ×1000)
# الإرجاع: تقريب التكامل (مكبر ×1000000)
**#
دالة رقم تكامل_شبه_المنحرف(رقم فأ، رقم فب، رقم ه)
    إرجاع ه * (فأ + فب) / 2
نهاية


#**
# دالة: تكامل_سيمبسون
# الوصف: تقريب التكامل بطريقة سيمبسون
#         ∫f ≈ h/3 * (f(a) + 4f(m) + f(b))
#         حيث m = (a+b)/2
#         أدق من شبه المنحرف (خطأ O(h⁵))
# المعاملات:
#   - فأ: قيمة الدالة عند a
#   - فم: قيمة الدالة عند نقطة المنتصف
#   - فب: قيمة الدالة عند b
#   - ه: نصف طول الفترة
# الإرجاع: تقريب التكامل
**#
دالة رقم تكامل_سيمبسون(رقم فأ، رقم فم، رقم فب، رقم ه)
    إرجاع ه * (فأ + 4 * فم + فب) / 3
نهاية


#**
# دالة: تكامل_سيمبسون_3_8
# الوصف: تقريب التكامل بقاعدة سيمبسون 3/8
#         ∫f ≈ 3h/8 * (f₀ + 3f₁ + 3f₂ + f₃)
# المعاملات:
#   - ف0..ف3: قيم الدالة عند 4 نقاط متساوية البعد
#   - ه: المسافة بين النقاط
# الإرجاع: تقريب التكامل
**#
دالة رقم تكامل_سيمبسون_3_8(رقم ف0، رقم ف1، رقم ف2، رقم ف3، رقم ه)
    إرجاع 3 * ه * (ف0 + 3 * ف1 + 3 * ف2 + ف3) / 8
نهاية


#**
# دالة: رانج_كوتا_خطوة_أويلر
# الوصف: خطوة واحدة بطريقة أويلر (أبسط طريقة رانج-كوتا)
#         y_{n+1} = y_n + h * f(t_n, y_n)
#         لمعادلة تفاضلية dy/dt = f(t, y)
#         هنا نفترض f(t,y) = مشتقة (قيمة مُعطاة)
# المعاملات:
#   - ص_حالي: القيمة الحالية لـ y (مكبرة ×1000)
#   - مشتقة: قيمة f(t,y) الحالية (مكبرة ×1000)
#   - ه: حجم الخطوة (مكبر ×1000)
# الإرجاع: القيمة الجديدة لـ y (مكبرة ×1000)
**#
دالة رقم رانج_كوتا_خطوة_أويلر(رقم ص_حالي، رقم مشتقة، رقم ه)
    إرجاع ص_حالي + (ه * مشتقة) / 1000
نهاية


#**
# دالة: رانج_كوتا_2_خطوة
# الوصف: خطوة واحدة بطريقة رانج-كوتا من الرتبة الثانية (نقطة المنتصف)
#         k1 = h * f(t, y)
#         k2 = h * f(t + h/2, y + k1/2)
#         y_{n+1} = y_n + k2
# المعاملات:
#   - ص_حالي: القيمة الحالية (مكبرة ×1000)
#   - ك1: h*f عند النقطة الحالية (مكبرة ×1000)
#   - ك2: h*f عند نقطة المنتصف (مكبرة ×1000)
# الإرجاع: القيمة الجديدة (مكبرة ×1000)
**#
دالة رقم رانج_كوتا_2_خطوة(رقم ص_حالي، رقم ك1، رقم ك2)
    إرجاع ص_حالي + ك2
نهاية


#**
# دالة: رانج_كوتا_4_خطوة
# الوصف: خطوة واحدة بطريقة رانج-كوتا من الرتبة الرابعة (RK4)
#         y_{n+1} = y_n + (k1 + 2*k2 + 2*k3 + k4) / 6
#         هذه أشهر وأدق طريقة لحل المعادلات التفاضلية عددياً
# المعاملات:
#   - ص_حالي: القيمة الحالية (مكبرة ×1000)
#   - ك1..ك4: معاملات RK4 (مكبرة ×1000)
# الإرجاع: القيمة الجديدة (مكبرة ×1000)
**#
دالة رقم رانج_كوتا_4_خطوة(رقم ص_حالي، رقم ك1، رقم ك2، رقم ك3، رقم ك4)
    إرجاع ص_حالي + (ك1 + 2 * ك2 + 2 * ك3 + ك4) / 6
نهاية


#**
# دالة: خطأ_تقريب_نسبي
# الوصف: حساب الخطأ النسبي في التقريب
#         E = |تقريب - حقيقي| / |حقيقي|
# المعاملات:
#   - تقريب: القيمة التقريبية
#   - حقيقي: القيمة الحقيقية
# الإرجاع: الخطأ النسبي مكبر ×1000000 (ppm)
**#
دالة رقم خطأ_تقريب_نسبي(رقم تقريب، رقم حقيقي)
    إذا (حقيقي == 0)
        إذا (تقريب == 0)
            إرجاع 0
        نهاية
        إرجاع 999999
    نهاية
    
    متغير رقم فرق = تقريب - حقيقي
    إذا (فرق < 0)
        فرق = 0 - فرق
    نهاية
    
    متغير رقم قاسم = حقيقي
    إذا (قاسم < 0)
        قاسم = 0 - قاسم
    نهاية
    
    إرجاع (فرق * 1000000) / قاسم
نهاية


#**
# دالة: خطأ_تقريب_مطلق
# الوصف: حساب الخطأ المطلق |تقريب - حقيقي|
# المعاملات:
#   - تقريب: القيمة التقريبية
#   - حقيقي: القيمة الحقيقية
# الإرجاع: الخطأ المطلق
**#
دالة رقم خطأ_تقريب_مطلق(رقم تقريب، رقم حقيقي)
    متغير رقم فرق = تقريب - حقيقي
    إذا (فرق < 0)
        إرجاع 0 - فرق
    نهاية
    إرجاع فرق
نهاية


