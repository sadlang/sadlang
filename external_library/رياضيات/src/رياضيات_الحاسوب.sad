نهاية


#**
# دالة: عدد_التراكيب_مع_التكرار
# الوصف: عدد التراكيب مع التكرار
#         = C(n+r-1, r) حيث n = عدد الأنواع، r = عدد المختارات
# المعاملات:
#   - أنواع: عدد الأنواع المتاحة
#   - مختارات: عدد المختارات
# الإرجاع: عدد التراكيب
**#
دالة رقم عدد_التراكيب_مع_التكرار(رقم أنواع، رقم مختارات)
    # C(n+r-1, r)
    متغير رقم ن = أنواع + مختارات - 1
    متغير رقم ر = مختارات
    
    # حساب C(n, r)
    إذا (ر > ن - ر)
        ر = ن - ر
    نهاية
    
    متغير رقم نتيجة = 1
    متغير رقم ع = 0
    طالما (ع < ر)
        نتيجة = نتيجة * (ن - ع)
        نتيجة = نتيجة / (ع + 1)
        ع = ع + 1
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: عدد_التشوهات
# الوصف: عدد التشوهات (Derangements) = تباديل بلا نقطة ثابتة
#         D(n) = (n-1) * (D(n-1) + D(n-2))
#         D(0) = 1, D(1) = 0
#         مثال: D(3) = 2 ({2,3,1} و {3,1,2})
# المعاملات:
#   - ن: عدد العناصر
# الإرجاع: عدد التشوهات
**#
دالة رقم عدد_التشوهات(رقم ن)
    إذا (ن == 0)
        إرجاع 1
    نهاية
    إذا (ن == 1)
        إرجاع 0
    نهاية
    
    متغير رقم سابق2 = 1
    متغير رقم سابق1 = 0
    متغير رقم حالي = 0
    متغير رقم ع = 2
    طالما (ع <= ن)
        حالي = (ع - 1) * (سابق1 + سابق2)
        سابق2 = سابق1
        سابق1 = حالي
        ع = ع + 1
    نهاية
    
    إرجاع حالي
نهاية


#**
# دالة: عدد_ستيرلنغ_ثاني
# الوصف: أعداد ستيرلنغ من النوع الثاني S(n, k)
#         = عدد طرق تقسيم مجموعة من n عنصر إلى k مجموعة جزئية غير فارغة
#         S(n,k) = k*S(n-1,k) + S(n-1,k-1)
# المعاملات:
#   - ن: عدد العناصر
#   - ك: عدد المجموعات
# الإرجاع: عدد ستيرلنغ S(n,k)
**#
دالة رقم عدد_ستيرلنغ_ثاني(رقم ن، رقم ك)
    إذا (ك == 0)
        إذا (ن == 0)
            إرجاع 1
        نهاية
        إرجاع 0
    نهاية
    إذا (ك == ن)
        إرجاع 1
    نهاية
    إذا (ك > ن)
        إرجاع 0
    نهاية
    إذا (ك == 1)
        إرجاع 1
    نهاية
    إذا (ك == ن - 1)
        # S(n, n-1) = C(n, 2)
        إرجاع ن * (ن - 1) / 2
    نهاية
    
    إرجاع ك * عدد_ستيرلنغ_ثاني(ن - 1، ك) + عدد_ستيرلنغ_ثاني(ن - 1، ك - 1)
نهاية


#**
# دالة: عدد_بيل
# الوصف: أعداد بيل B(n) = عدد طرق تقسيم مجموعة من n عنصر
#         B(n) = Σ S(n, k) لـ k من 0 إلى n
#         B(0)=1, B(1)=1, B(2)=2, B(3)=5, B(4)=15
# المعاملات:
#   - ن: عدد العناصر
# الإرجاع: عدد بيل B(n)
**#
دالة رقم عدد_بيل(رقم ن)
    إذا (ن == 0)
        إرجاع 1
    نهاية
    إذا (ن == 1)
        إرجاع 1
    نهاية
    إذا (ن == 2)
        إرجاع 2
    نهاية
    إذا (ن == 3)
        إرجاع 5
    نهاية
    إذا (ن == 4)
        إرجاع 15
    نهاية
    إذا (ن == 5)
        إرجاع 52
    نهاية
    إذا (ن == 6)
        إرجاع 203
    نهاية
    إذا (ن == 7)
        إرجاع 877
    نهاية
    إذا (ن == 8)
        إرجاع 4140
    نهاية
    إذا (ن == 9)
        إرجاع 21147
    نهاية
    إذا (ن == 10)
        إرجاع 115975
    نهاية
    
    # حساب بمثلث بيل
    متغير رقم مجموع = 0
    متغير رقم ك = 0
    طالما (ك <= ن)
        مجموع = مجموع + عدد_ستيرلنغ_ثاني(ن، ك)
        ك = ك + 1
    نهاية
    إرجاع مجموع
نهاية


