#**
# دالة: قلب_أرقام
# الوصف: قلب ترتيب أرقام عدد (123 → 321)
# المعاملات:
#   - ن: العدد
# الإرجاع: العدد بأرقام مقلوبة
**#
دالة رقم قلب_أرقام(رقم ن)
    متغير رقم سالب = 0
    متغير رقم قيمة = ن
    إذا (قيمة < 0)
        قيمة = 0 - قيمة
        سالب = 1
    نهاية
    
    متغير رقم نتيجة = 0
    طالما (قيمة > 0)
        متغير رقم رقم_واحد = قيمة - (قيمة / 10) * 10
        نتيجة = نتيجة * 10 + رقم_واحد
        قيمة = قيمة / 10
    نهاية
    
    إذا (سالب == 1)
        إرجاع 0 - نتيجة
    نهاية
    إرجاع نتيجة
نهاية


#**
# دالة: عدد_الأرقام
# الوصف: حساب عدد أرقام العدد (في النظام العشري)
# المعاملات:
#   - ن: العدد
# الإرجاع: عدد الأرقام
**#
دالة رقم عدد_الأرقام(رقم ن)
    إذا (ن == 0)
        إرجاع 1
    نهاية
    متغير رقم قيمة = ن
    إذا (قيمة < 0)
        قيمة = 0 - قيمة
    نهاية
    متغير رقم عداد = 0
    طالما (قيمة > 0)
        قيمة = قيمة / 10
        عداد = عداد + 1
    نهاية
    إرجاع عداد
نهاية


#**
# دالة: مجموع_الأرقام
# الوصف: حساب مجموع أرقام العدد
#         مثال: مجموع_الأرقام(123) = 1+2+3 = 6
# المعاملات:
#   - ن: العدد
# الإرجاع: مجموع الأرقام
**#
دالة رقم مجموع_الأرقام(رقم ن)
    متغير رقم قيمة = ن
    إذا (قيمة < 0)
        قيمة = 0 - قيمة
    نهاية
    متغير رقم مجموع = 0
    طالما (قيمة > 0)
        متغير رقم رقم_واحد = قيمة - (قيمة / 10) * 10
        مجموع = مجموع + رقم_واحد
        قيمة = قيمة / 10
    نهاية
    إرجاع مجموع
نهاية


#**
# دالة: الجذر_الرقمي
# الوصف: حساب الجذر الرقمي (تكرار مجموع الأرقام حتى رقم واحد)
#         مثال: الجذر_الرقمي(493) → 4+9+3=16 → 1+6=7
#         صيغة مباشرة: dr(n) = 1 + (n-1) mod 9
# المعاملات:
#   - ن: العدد الموجب
# الإرجاع: الجذر الرقمي (1-9)
**#
دالة رقم الجذر_الرقمي(رقم ن)
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    متغير رقم باقي = (ن - 1) - ((ن - 1) / 9) * 9
    إرجاع باقي + 1
نهاية


#**
# دالة: هل_سعيد
# الوصف: التحقق مما إذا كان العدد "سعيد" (Happy Number)
#         العدد سعيد: تكرار مجموع مربعات أرقامه يُنتج 1
#         مثال: 19 → 1²+9² = 82 → 64+4 = 68 → 36+64 = 100 → 1
# المعاملات:
#   - ن: العدد
# الإرجاع: 1 إذا سعيد، 0 غير ذلك
**#
دالة رقم هل_سعيد(رقم ن)
    متغير رقم بطيء = ن
    متغير رقم سريع = ن
    
    # استخدام طريقة فلويد لكشف الدورات
    متغير رقم ع = 0
    طالما (ع < 100)
        # خطوة واحدة للبطيء
        متغير رقم مجموع1 = 0
        متغير رقم ق1 = بطيء
        إذا (ق1 < 0)
            ق1 = 0 - ق1
        نهاية
        طالما (ق1 > 0)
            متغير رقم ر1 = ق1 - (ق1 / 10) * 10
            مجموع1 = مجموع1 + ر1 * ر1
            ق1 = ق1 / 10
        نهاية
        بطيء = مجموع1
        
        # خطوتان للسريع
        متغير رقم مجموع2 = 0
        متغير رقم ق2 = سريع
        إذا (ق2 < 0)
            ق2 = 0 - ق2
        نهاية
        طالما (ق2 > 0)
            متغير رقم ر2 = ق2 - (ق2 / 10) * 10
            مجموع2 = مجموع2 + ر2 * ر2
            ق2 = ق2 / 10
        نهاية
        سريع = مجموع2
        
        # الخطوة الثانية
        متغير رقم مجموع3 = 0
        متغير رقم ق3 = سريع
        إذا (ق3 < 0)
            ق3 = 0 - ق3
        نهاية
        طالما (ق3 > 0)
            متغير رقم ر3 = ق3 - (ق3 / 10) * 10
            مجموع3 = مجموع3 + ر3 * ر3
            ق3 = ق3 / 10
        نهاية
        سريع = مجموع3
        
        إذا (بطيء == 1)
            إرجاع 1
        نهاية
        إذا (سريع == 1)
            إرجاع 1
        نهاية
        إذا (بطيء == سريع)
            إرجاع 0
        نهاية
        
        ع = ع + 1
    نهاية
    
    إرجاع 0
نهاية


#**
# دالة: عدد_هارشاد
# الوصف: التحقق مما إذا كان العدد هارشاد (Harshad/Niven)
#         عدد هارشاد: يقبل القسمة على مجموع أرقامه
#         مثال: 18 → 1+8=9, 18/9=2 ✓
# المعاملات:
#   - ن: العدد
# الإرجاع: 1 إذا هارشاد، 0 غير ذلك
**#
دالة رقم عدد_هارشاد(رقم ن)
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    متغير رقم مجموع = مجموع_الأرقام(ن)
    إذا (مجموع == 0)
        إرجاع 0
    نهاية
    إذا (ن - (ن / مجموع) * مجموع == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


