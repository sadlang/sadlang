#**
# دالة: تشغيل_اختبارات_رياضيات_الحاسوب
# الوصف: تشغيل جميع الاختبارات
**#
دالة رقم تشغيل_اختبارات_رياضيات_الحاسوب()
    متغير رقم نجاح = 0
    متغير رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبارات رياضيات الحاسوب")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار عدد البتات
    إذا (عدد_البتات(7) == 3)
        نجاح = نجاح + 1
        اطبع_سطر("✓ عدد البتات(7) = 3")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ عدد البتات(7)")
    نهاية
    
    إذا (عدد_البتات(8) == 4)
        نجاح = نجاح + 1
        اطبع_سطر("✓ عدد البتات(8) = 4")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ عدد البتات(8)")
    نهاية
    
    # اختبار عدد الواحدات
    إذا (عدد_الواحدات(7) == 3)
        نجاح = نجاح + 1
        اطبع_سطر("✓ عدد الواحدات(7) = 3")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ عدد الواحدات(7)")
    نهاية
    
    # اختبار قوة اثنين
    إذا (هل_قوة_اثنين(16) == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 16 قوة اثنين")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ 16 قوة اثنين")
    نهاية
    
    إذا (هل_قوة_اثنين(15) == 0)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 15 ليست قوة اثنين")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ 15 ليست قوة اثنين")
    نهاية
    
    # اختبار الإزاحة
    إذا (إزاحة_يسار(1، 3) == 8)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 1 << 3 = 8")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ 1 << 3")
    نهاية
    
    إذا (إزاحة_يمين(16، 2) == 4)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 16 >> 2 = 4")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ 16 >> 2")
    نهاية
    
    # اختبار الأقسام
    إذا (عدد_الأقسام(4) == 5)
        نجاح = نجاح + 1
        اطبع_سطر("✓ أقسام(4) = 5")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ أقسام(4)")
    نهاية
    
    # اختبار التشوهات
    إذا (عدد_التشوهات(3) == 2)
        نجاح = نجاح + 1
        اطبع_سطر("✓ تشوهات(3) = 2")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ تشوهات(3)")
    نهاية
    
    # اختبار أويلر
    إذا (دالة_أويلر_توتينت(12) == 4)
        نجاح = نجاح + 1
        اطبع_سطر("✓ φ(12) = 4")
    وإلا
        فشل = فشل + 1
        اطبع("✗ φ(12) = ")
        اطبع_سطر(دالة_أويلر_توتينت(12))
    نهاية
    
    # اختبار مجموع الأرقام
    إذا (مجموع_الأرقام(123) == 6)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مجموع أرقام(123) = 6")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ مجموع أرقام(123)")
    نهاية
    
    # اختبار الجذر الرقمي
    إذا (الجذر_الرقمي(493) == 7)
        نجاح = نجاح + 1
        اطبع_سطر("✓ الجذر الرقمي(493) = 7")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ الجذر الرقمي(493)")
    نهاية
    
    # اختبار عدد هارشاد
    إذا (عدد_هارشاد(18) == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 18 عدد هارشاد")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ 18 عدد هارشاد")
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


