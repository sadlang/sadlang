#**
# دالة: حد_أدنى_أشجار_ممتدة
# الوصف: حساب الحد الأدنى لعدد الأحرف في شجرة ممتدة
#         = عدد الرؤوس - 1
# المعاملات:
#   - رؤوس: عدد الرؤوس
# الإرجاع: عدد الأحرف في الشجرة الممتدة
**#
دالة رقم حد_أدنى_أشجار_ممتدة(رقم رؤوس)
    إذا (رؤوس <= 0)
        إرجاع 0
    نهاية
    إرجاع رؤوس - 1
نهاية


#**
# دالة: عدد_الأشجار_المسماة
# الوصف: عدد الأشجار المسماة على n رأس (صيغة كايلي)
#         = n^(n-2)
# المعاملات:
#   - ن: عدد الرؤوس
# الإرجاع: عدد الأشجار
**#
دالة رقم عدد_الأشجار_المسماة(رقم ن)
    إذا (ن <= 1)
        إرجاع 1
    نهاية
    إذا (ن == 2)
        إرجاع 1
    نهاية
    
    متغير رقم نتيجة = 1
    متغير رقم ع = 0
    طالما (ع < ن - 2)
        نتيجة = نتيجة * ن
        ع = ع + 1
    نهاية
    إرجاع نتيجة
نهاية


#**
# دالة: أقصى_تدفق_بسيط
# الوصف: تقدير أقصى تدفق في شبكة بسيطة (خطين متوازيين)
#         في حالة خطين متوازيين: التدفق = مجموع السعات
# المعاملات:
#   - سعة1: سعة المسار الأول
#   - سعة2: سعة المسار الثاني
# الإرجاع: أقصى تدفق
**#
دالة رقم أقصى_تدفق_بسيط(رقم سعة1، رقم سعة2)
    إرجاع سعة1 + سعة2
نهاية


#**
# دالة: أقصى_تدفق_متسلسل
# الوصف: أقصى تدفق في شبكة متسلسلة (خطوط على التوالي)
#         = أقل سعة (عنق الزجاجة)
# المعاملات:
#   - سعة1: سعة القطاع الأول
#   - سعة2: سعة القطاع الثاني
# الإرجاع: أقصى تدفق
**#
دالة رقم أقصى_تدفق_متسلسل(رقم سعة1، رقم سعة2)
    إذا (سعة1 < سعة2)
        إرجاع سعة1
    نهاية
    إرجاع سعة2
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 8: التشفير الرقمي                                      ║
# ║     Section 8: Digital Cryptography                                ║
