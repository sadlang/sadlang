#** ─────────────────────────────────────────────────────────────────
# مفاهيم التشفير الرقمي الأساسية:
# 1. شيفرة قيصر - إزاحة أحرف
# 2. XOR cipher - تشفير بالأو الحصري
# 3. مفاهيم RSA - أسس نظرية الأعداد
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: شيفرة_قيصر_تشفير
# الوصف: تشفير عدد بشيفرة قيصر (إزاحة)
#         القيمة المشفرة = (قيمة + إزاحة) mod مجال
# المعاملات:
#   - قيمة: القيمة لتشفيرها
#   - إزاحة: مقدار الإزاحة (المفتاح)
#   - مجال: حجم مجال القيم
# الإرجاع: القيمة المشفرة
**#
دالة رقم شيفرة_قيصر_تشفير(رقم قيمة، رقم إزاحة، رقم مجال)
    إذا (مجال <= 0)
        إرجاع قيمة
    نهاية
    متغير رقم مشفر = قيمة + إزاحة
    # التأكد من أن النتيجة في المجال [0, مجال)
    متغير رقم نتيجة = مشفر - (مشفر / مجال) * مجال
    إذا (نتيجة < 0)
        نتيجة = نتيجة + مجال
    نهاية
    إرجاع نتيجة
نهاية


#**
# دالة: شيفرة_قيصر_فك
# الوصف: فك تشفير شيفرة قيصر
#         القيمة الأصلية = (مشفر - إزاحة) mod مجال
**#
دالة رقم شيفرة_قيصر_فك(رقم مشفر، رقم إزاحة، رقم مجال)
    إرجاع شيفرة_قيصر_تشفير(مشفر، 0 - إزاحة، مجال)
نهاية


#**
# دالة: أس_معياري
# الوصف: حساب (أساس^أس) mod معامل بكفاءة
#         باستخدام التربيع المتكرر (Square-and-Multiply)
#         هذا أساسي في RSA والتشفير بالمفتاح العام
# المعاملات:
#   - أساس: القاعدة
#   - أس: الأس
#   - معامل: المعامل
# الإرجاع: (أساس^أس) mod معامل
**#
دالة رقم أس_معياري(رقم أساس، رقم أس، رقم معامل)
    إذا (معامل == 1)
        إرجاع 0
    نهاية
    إذا (أس == 0)
        إرجاع 1
    نهاية
    
    متغير رقم نتيجة = 1
    متغير رقم قاعدة = أساس - (أساس / معامل) * معامل
    إذا (قاعدة < 0)
        قاعدة = قاعدة + معامل
    نهاية
    متغير رقم ق = أس
    
    طالما (ق > 0)
        # إذا البت الأخير 1
        متغير رقم بت = ق - (ق / 2) * 2
        إذا (بت == 1)
            نتيجة = (نتيجة * قاعدة) - ((نتيجة * قاعدة) / معامل) * معامل
            إذا (نتيجة < 0)
                نتيجة = نتيجة + معامل
            نهاية
        نهاية
        ق = ق / 2
        قاعدة = (قاعدة * قاعدة) - ((قاعدة * قاعدة) / معامل) * معامل
        إذا (قاعدة < 0)
            قاعدة = قاعدة + معامل
        نهاية
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: دالة_أويلر_توتينت
# الوصف: حساب دالة أويلر φ(n)
#         = عدد الأعداد من 1 إلى n-1 التي هي أولية نسبياً مع n
#         مهمة في RSA: φ(pq) = (p-1)(q-1)
# المعاملات:
#   - ن: العدد الموجب
# الإرجاع: φ(n)
**#
دالة رقم دالة_أويلر_توتينت(رقم ن)
    إذا (ن <= 1)
        إرجاع 0
    نهاية
    
    متغير رقم نتيجة = ن
    متغير رقم ع = 2
    متغير رقم عدد = ن
    
    طالما (ع * ع <= عدد)
        إذا (عدد - (عدد / ع) * ع == 0)
            # ع قاسم أولي
            طالما (عدد - (عدد / ع) * ع == 0)
                عدد = عدد / ع
            نهاية
            نتيجة = نتيجة - نتيجة / ع
        نهاية
        ع = ع + 1
    نهاية
    
    إذا (عدد > 1)
        نتيجة = نتيجة - نتيجة / عدد
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: قابل_استخدام_كأس_آر_إس_إيه
# الوصف: التحقق مما إذا كان زوج أعداد أولية صالحاً لـ RSA
#         الشروط: p و q أوليان ومختلفان
# المعاملات:
#   - ع1: العدد الأولي الأول
#   - ع2: العدد الأولي الثاني
# الإرجاع: 1 إذا صالح، 0 غير ذلك
**#
دالة رقم قابل_استخدام_كأس_آر_إس_إيه(رقم ع1، رقم ع2)
    إذا (ع1 == ع2)
        إرجاع 0
    نهاية
    إذا (ع1 < 2)
        إرجاع 0
    نهاية
    إذا (ع2 < 2)
        إرجاع 0
    نهاية
    
    # التحقق من أولية ع1
    متغير رقم أولي1 = 1
    متغير رقم ق = 2
    طالما (ق * ق <= ع1)
        إذا (ع1 - (ع1 / ق) * ق == 0)
            أولي1 = 0
            ق = ع1
        نهاية
        ق = ق + 1
    نهاية
    
    # التحقق من أولية ع2
    متغير رقم أولي2 = 1
    ق = 2
    طالما (ق * ق <= ع2)
        إذا (ع2 - (ع2 / ق) * ق == 0)
            أولي2 = 0
            ق = ع2
        نهاية
        ق = ق + 1
    نهاية
    
    إذا (أولي1 == 1)
        إذا (أولي2 == 1)
            إرجاع 1
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: آر_إس_إيه_ن
# الوصف: حساب n في RSA (n = p * q)
**#
دالة رقم آر_إس_إيه_ن(رقم ع1، رقم ع2)
    إرجاع ع1 * ع2
نهاية


#**
# دالة: آر_إس_إيه_فاي
# الوصف: حساب φ(n) في RSA (φ = (p-1)(q-1))
**#
دالة رقم آر_إس_إيه_فاي(رقم ع1، رقم ع2)
    إرجاع (ع1 - 1) * (ع2 - 1)
نهاية


