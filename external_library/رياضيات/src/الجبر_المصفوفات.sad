# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 1: عمليات المصفوفات 2×2                            ║
# ║          Section 1: 2×2 Matrix Operations                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# المصفوفة 2×2 هي أبسط أشكال المصفوفات المربعة.
# تُستخدم في:
# - التحويلات الهندسية (الدوران، القياس)
# - حل أنظمة المعادلات الخطية 2×2
# - تمثيل الأعداد المركبة
#
# |أ  ب|   أربعة عناصر فقط
# |ج  د|
# ────────────────────────────────────────────────────────────────── **#


# ═══════════════════════════════════════════════════════════════
# §1.1 - جمع مصفوفتين 2×2
# ═══════════════════════════════════════════════════════════════

#**
# دالة: جمع_م2_11
# الوصف: العنصر (1،1) من مجموع مصفوفتين 2×2
#         [أ1 + أ2]
# الأربع دوال التالية تُرجع عناصر المصفوفة الناتجة
**#
دالة رقم جمع_م2_11(رقم أ1، رقم أ2)
    إرجاع أ1 + أ2
نهاية

دالة رقم جمع_م2_12(رقم ب1، رقم ب2)
    إرجاع ب1 + ب2
نهاية

دالة رقم جمع_م2_21(رقم ج1، رقم ج2)
    إرجاع ج1 + ج2
نهاية

دالة رقم جمع_م2_22(رقم د1، رقم د2)
    إرجاع د1 + د2
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.2 - طرح مصفوفتين 2×2
# ═══════════════════════════════════════════════════════════════

دالة رقم طرح_م2_11(رقم أ1، رقم أ2)
    إرجاع أ1 - أ2
نهاية

دالة رقم طرح_م2_12(رقم ب1، رقم ب2)
    إرجاع ب1 - ب2
نهاية

دالة رقم طرح_م2_21(رقم ج1، رقم ج2)
    إرجاع ج1 - ج2
نهاية

دالة رقم طرح_م2_22(رقم د1، رقم د2)
    إرجاع د1 - د2
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.3 - ضرب مصفوفة 2×2 في عدد
# ═══════════════════════════════════════════════════════════════

#**
# ضرب كل عنصر في العدد الثابت
# |ك×أ  ك×ب|
# |ك×ج  ك×د|
**#
دالة رقم ضرب_م2_عدد_11(رقم أ، رقم ك)
    إرجاع أ * ك
نهاية

دالة رقم ضرب_م2_عدد_12(رقم ب، رقم ك)
    إرجاع ب * ك
نهاية

دالة رقم ضرب_م2_عدد_21(رقم ج، رقم ك)
    إرجاع ج * ك
نهاية

دالة رقم ضرب_م2_عدد_22(رقم د، رقم ك)
    إرجاع د * ك
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.4 - ضرب مصفوفتين 2×2
# ═══════════════════════════════════════════════════════════════

#**
# ضرب مصفوفتين 2×2:
# |أ1 ب1|   |أ2 ب2|   |أ1×أ2+ب1×ج2  أ1×ب2+ب1×د2|
# |ج1 د1| × |ج2 د2| = |ج1×أ2+د1×ج2  ج1×ب2+د1×د2|
**#

دالة رقم ضرب_م2_11(رقم أ1، رقم ب1، رقم أ2، رقم ج2)
    إرجاع أ1 * أ2 + ب1 * ج2
نهاية

دالة رقم ضرب_م2_12(رقم أ1، رقم ب1، رقم ب2، رقم د2)
    إرجاع أ1 * ب2 + ب1 * د2
نهاية

دالة رقم ضرب_م2_21(رقم ج1، رقم د1، رقم أ2، رقم ج2)
    إرجاع ج1 * أ2 + د1 * ج2
نهاية

دالة رقم ضرب_م2_22(رقم ج1، رقم د1، رقم ب2، رقم د2)
    إرجاع ج1 * ب2 + د1 * د2
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.5 - المحدد والأثر 2×2
# ═══════════════════════════════════════════════════════════════

#**
# دالة: محدد_م2
# الوصف: حساب محدد مصفوفة 2×2
#         |أ  ب|
#         |ج  د| = أ×د - ب×ج
# التعقيد: O(1)
**#
دالة رقم محدد_م2(رقم أ، رقم ب، رقم ج، رقم د)
    إرجاع أ * د - ب * ج
نهاية


#**
# دالة: أثر_م2
# الوصف: حساب أثر المصفوفة 2×2 (مجموع العناصر القطرية)
#         tr(A) = أ + د
**#
دالة رقم أثر_م2(رقم أ، رقم د)
    إرجاع أ + د
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.6 - المصفوفة المنقولة 2×2
# ═══════════════════════════════════════════════════════════════

#**
# المصفوفة المنقولة (Transpose):
# |أ  ب|ᵀ = |أ  ج|
# |ج  د|    |ب  د|
# العناصر القطرية لا تتغير
**#
دالة رقم منقول_م2_11(رقم أ)
    إرجاع أ
نهاية

دالة رقم منقول_م2_12(رقم ج)
    إرجاع ج
نهاية

دالة رقم منقول_م2_21(رقم ب)
    إرجاع ب
نهاية

دالة رقم منقول_م2_22(رقم د)
    إرجاع د
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.7 - المصفوفة المعكوسة 2×2
# ═══════════════════════════════════════════════════════════════

#** ─────────────────────────────────────────────────────────────────
# المصفوفة المعكوسة A⁻¹:
# |أ  ب|⁻¹ = (1/محدد) × | د  -ب|
# |ج  د|                 |-ج   أ|
#
# شرط الوجود: المحدد ≠ 0
# النتيجة مضروبة في عامل_الدقة (بسبب القسمة)
# ────────────────────────────────────────────────────────────────── **#

#**
# دالة: معكوس_م2_11
# الإرجاع: العنصر (1,1) × عامل_الدقة
**#
دالة رقم معكوس_م2_11(رقم أ، رقم ب، رقم ج، رقم د)
    رقم عامل_دقة = 1000000
    رقم المحدد = أ * د - ب * ج
    إذا (المحدد == 0)
        إرجاع 0 - 999999
    نهاية
    إرجاع (د * عامل_دقة) / المحدد
نهاية

دالة رقم معكوس_م2_12(رقم أ، رقم ب، رقم ج، رقم د)
    رقم عامل_دقة = 1000000
    رقم المحدد = أ * د - ب * ج
    إذا (المحدد == 0)
        إرجاع 0 - 999999
    نهاية
    إرجاع ((0 - ب) * عامل_دقة) / المحدد
نهاية

دالة رقم معكوس_م2_21(رقم أ، رقم ب، رقم ج، رقم د)
    رقم عامل_دقة = 1000000
    رقم المحدد = أ * د - ب * ج
    إذا (المحدد == 0)
        إرجاع 0 - 999999
    نهاية
    إرجاع ((0 - ج) * عامل_دقة) / المحدد
نهاية

دالة رقم معكوس_م2_22(رقم أ، رقم ب، رقم ج، رقم د)
    رقم عامل_دقة = 1000000
    رقم المحدد = أ * د - ب * ج
    إذا (المحدد == 0)
        إرجاع 0 - 999999
    نهاية
    إرجاع (أ * عامل_دقة) / المحدد
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.8 - خصائص المصفوفة 2×2
# ═══════════════════════════════════════════════════════════════

#**
# دالة: هل_م2_متماثلة
# الوصف: هل المصفوفة متماثلة (A = Aᵀ)؟ أي ب = ج
# الإرجاع: 1 نعم، 0 لا
**#
دالة رقم هل_م2_متماثلة(رقم ب، رقم ج)
    إذا (ب == ج)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_م2_قطرية
# الوصف: هل المصفوفة قطرية (ب = 0 و ج = 0)؟
**#
دالة رقم هل_م2_قطرية(رقم ب، رقم ج)
    إذا (ب == 0)
        إذا (ج == 0)
            إرجاع 1
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_م2_وحدة
# الوصف: هل المصفوفة هي مصفوفة الوحدة (الهوية)؟
#         I = |1 0|
#             |0 1|
**#
دالة رقم هل_م2_وحدة(رقم أ، رقم ب، رقم ج، رقم د)
    إذا (أ == 1)
        إذا (ب == 0)
            إذا (ج == 0)
                إذا (د == 1)
                    إرجاع 1
                نهاية
            نهاية
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_م2_صفرية
# الوصف: هل المصفوفة صفرية (جميع العناصر = 0)؟
**#
دالة رقم هل_م2_صفرية(رقم أ، رقم ب، رقم ج، رقم د)
    إذا (أ == 0)
        إذا (ب == 0)
            إذا (ج == 0)
                إذا (د == 0)
                    إرجاع 1
                نهاية
            نهاية
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_م2_منفردة
# الوصف: هل المصفوفة منفردة (المحدد = 0)؟
#         المصفوفة المنفردة ليس لها معكوس
**#
دالة رقم هل_م2_منفردة(رقم أ، رقم ب، رقم ج، رقم د)
    إذا (محدد_م2(أ، ب، ج، د) == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_م2_متعامدة
# الوصف: هل المصفوفة متعامدة (A × Aᵀ = I)؟
#         أي أ² + ب² = 1 و ج² + د² = 1 و أ×ج + ب×د = 0
# يعمل مع أعداد صحيحة (مثل مصفوفات الانعكاس)
**#
دالة رقم هل_م2_متعامدة(رقم أ، رقم ب، رقم ج، رقم د)
    رقم شرط1 = أ * أ + ب * ب
    رقم شرط2 = ج * ج + د * د
    رقم شرط3 = أ * ج + ب * د
    
    إذا (شرط1 == 1)
        إذا (شرط2 == 1)
            إذا (شرط3 == 0)
                إرجاع 1
            نهاية
        نهاية
    نهاية
    إرجاع 0
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.9 - القيم الذاتية 2×2
# ═══════════════════════════════════════════════════════════════

#** ─────────────────────────────────────────────────────────────────
# القيم الذاتية (Eigenvalues) لمصفوفة 2×2:
# المعادلة المميزة: λ² - (أ+د)×λ + (أ×د - ب×ج) = 0
#                   λ² - tr(A)×λ + det(A) = 0
#
# الحل: λ = (tr ± √(tr² - 4×det)) / 2
# ────────────────────────────────────────────────────────────────── **#

#**
# دالة: مميز_ذاتية_م2
# الوصف: مميز المعادلة المميزة (Δ = tr² - 4×det)
**#
دالة رقم مميز_ذاتية_م2(رقم أ، رقم ب، رقم ج، رقم د)
    رقم الأثر = أ + د
    رقم المحدد = أ * د - ب * ج
    إرجاع الأثر * الأثر - 4 * المحدد
نهاية


#**
# دالة: قيمة_ذاتية_م2_1
# الوصف: القيمة الذاتية الأولى (الأكبر) × عامل_دقة
**#
دالة رقم قيمة_ذاتية_م2_1(رقم أ، رقم ب، رقم ج، رقم د)
    رقم عامل_دقة = 1000000
    رقم الأثر = أ + د
    رقم المميز = مميز_ذاتية_م2(أ، ب، ج، د)
    
    إذا (المميز < 0)
        إرجاع 0 - 999999
    نهاية
    
    # حساب جذر المميز
    رقم جذر = 1
    إذا (المميز > 0)
        جذر = المميز / 2
        إذا (جذر == 0)
            جذر = 1
        نهاية
        رقم عداد = 0
        كرر طالما (عداد < 30)
            جذر = (جذر + المميز / جذر) / 2
            عداد = عداد + 1
        نهاية
    وإلا
        جذر = 0
    نهاية
    
    إرجاع ((الأثر + جذر) * عامل_دقة) / 2
نهاية


#**
# دالة: قيمة_ذاتية_م2_2
# الوصف: القيمة الذاتية الثانية (الأصغر) × عامل_دقة
**#
دالة رقم قيمة_ذاتية_م2_2(رقم أ، رقم ب، رقم ج، رقم د)
    رقم عامل_دقة = 1000000
    رقم الأثر = أ + د
    رقم المميز = مميز_ذاتية_م2(أ، ب، ج، د)
    
    إذا (المميز < 0)
        إرجاع 0 - 999999
    نهاية
    
    رقم جذر = 0
    إذا (المميز > 0)
        جذر = المميز / 2
        إذا (جذر == 0)
            جذر = 1
        نهاية
        رقم عداد = 0
        كرر طالما (عداد < 30)
            جذر = (جذر + المميز / جذر) / 2
            عداد = عداد + 1
        نهاية
    نهاية
    
    إرجاع ((الأثر - جذر) * عامل_دقة) / 2
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 2: عمليات المصفوفات 3×3                            ║
# ║          Section 2: 3×3 Matrix Operations                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# المصفوفة 3×3 تُستخدم في:
# - التحويلات الهندسية ثلاثية الأبعاد
# - حل أنظمة المعادلات 3×3
# - ميكانيكا الأجسام الصلبة (مصفوفة العطالة)
# - تشفير Hill
#
# |أ11  أ12  أ13|
# |أ21  أ22  أ23|   9 عناصر
# |أ31  أ32  أ33|
# ────────────────────────────────────────────────────────────────── **#


# ═══════════════════════════════════════════════════════════════
# §2.1 - محدد مصفوفة 3×3
# ═══════════════════════════════════════════════════════════════

#**
# دالة: محدد_م3
# الوصف: حساب محدد مصفوفة 3×3 بالتوسع بالسطر الأول (Cofactor)
#         det = أ11×(أ22×أ33 - أ23×أ32)
#             - أ12×(أ21×أ33 - أ23×أ31)
#             + أ13×(أ21×أ32 - أ22×أ31)
**#
دالة رقم محدد_م3(رقم أ11، رقم أ12، رقم أ13، رقم أ21، رقم أ22، رقم أ23، رقم أ31، رقم أ32، رقم أ33)
    رقم مكمل1 = أ22 * أ33 - أ23 * أ32
    رقم مكمل2 = أ21 * أ33 - أ23 * أ31
    رقم مكمل3 = أ21 * أ32 - أ22 * أ31
    إرجاع أ11 * مكمل1 - أ12 * مكمل2 + أ13 * مكمل3
نهاية


#**
# دالة: أثر_م3
# الوصف: أثر مصفوفة 3×3 (مجموع القطر الرئيسي)
**#
دالة رقم أثر_م3(رقم أ11، رقم أ22، رقم أ33)
    إرجاع أ11 + أ22 + أ33
نهاية


# ═══════════════════════════════════════════════════════════════
# §2.2 - جمع وطرح مصفوفات 3×3
# ═══════════════════════════════════════════════════════════════

#** جمع عنصر-بعنصر **#
دالة رقم جمع_م3(رقم عنصر1، رقم عنصر2)
    إرجاع عنصر1 + عنصر2
نهاية

#** طرح عنصر-بعنصر **#
دالة رقم طرح_م3(رقم عنصر1، رقم عنصر2)
    إرجاع عنصر1 - عنصر2
نهاية

#** ضرب في عدد **#
دالة رقم ضرب_م3_عدد(رقم عنصر، رقم ك)
    إرجاع عنصر * ك
نهاية


# ═══════════════════════════════════════════════════════════════
# §2.3 - ضرب مصفوفتين 3×3
# ═══════════════════════════════════════════════════════════════

#** ─────────────────────────────────────────────────────────────────
# ضرب مصفوفتين 3×3:
# C = A × B حيث C_ij = Σ(k=1→3) A_ik × B_kj
#
# كل عنصر في الناتج هو حاصل الضرب النقطي
# للسطر المقابل من A في العمود المقابل من B
# ────────────────────────────────────────────────────────────────── **#

#**
# دالة: ضرب_م3_عنصر
# الوصف: حساب عنصر واحد من حاصل ضرب مصفوفتين 3×3
#         C_ij = A_i1×B_1j + A_i2×B_2j + A_i3×B_3j
# المعاملات: ثلاثة عناصر من السطر i في A
#             وثلاثة عناصر من العمود j في B
**#
دالة رقم ضرب_م3_عنصر(رقم سطر1، رقم سطر2، رقم سطر3، رقم عمود1، رقم عمود2، رقم عمود3)
    إرجاع سطر1 * عمود1 + سطر2 * عمود2 + سطر3 * عمود3
نهاية


# ═══════════════════════════════════════════════════════════════
# §2.4 - المصفوفة المعكوسة 3×3
# ═══════════════════════════════════════════════════════════════

#** ─────────────────────────────────────────────────────────────────
# المصفوفة المعكوسة A⁻¹ لمصفوفة 3×3:
# A⁻¹ = (1/det(A)) × adj(A)
# حيث adj(A) هي المصفوفة المرافقة (Adjugate)
#
# المرافقة = منقول مصفوفة العوامل المرافقة (Cofactors)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: عامل_مرافق_م3
# الوصف: حساب العامل المرافق C_ij لعنصر في مصفوفة 3×3
#         C_ij = (-1)^(i+j) × M_ij
#         حيث M_ij هو المحدد الثانوي
**#

# العامل المرافق C_11 = +(أ22×أ33 - أ23×أ32)
دالة رقم مرافق_م3_11(رقم أ22، رقم أ23، رقم أ32، رقم أ33)
    إرجاع أ22 * أ33 - أ23 * أ32
نهاية

# C_12 = -(أ21×أ33 - أ23×أ31)
دالة رقم مرافق_م3_12(رقم أ21، رقم أ23، رقم أ31، رقم أ33)
    إرجاع 0 - (أ21 * أ33 - أ23 * أ31)
نهاية

# C_13 = +(أ21×أ32 - أ22×أ31)
دالة رقم مرافق_م3_13(رقم أ21، رقم أ22، رقم أ31، رقم أ32)
    إرجاع أ21 * أ32 - أ22 * أ31
نهاية

# C_21 = -(أ12×أ33 - أ13×أ32)
دالة رقم مرافق_م3_21(رقم أ12، رقم أ13، رقم أ32، رقم أ33)
    إرجاع 0 - (أ12 * أ33 - أ13 * أ32)
نهاية

# C_22 = +(أ11×أ33 - أ13×أ31)
دالة رقم مرافق_م3_22(رقم أ11، رقم أ13، رقم أ31، رقم أ33)
    إرجاع أ11 * أ33 - أ13 * أ31
نهاية

# C_23 = -(أ11×أ32 - أ12×أ31)
دالة رقم مرافق_م3_23(رقم أ11، رقم أ12، رقم أ31، رقم أ32)
    إرجاع 0 - (أ11 * أ32 - أ12 * أ31)
نهاية

# C_31 = +(أ12×أ23 - أ13×أ22)
