#** ─────────────────────────────────────────────────────────────────
# تحليل LU (إلى مصفوفة مثلثية سفلية وعلوية):
# A = L × U
# حيث L مثلثية سفلية (Lower) و U مثلثية علوية (Upper)
#
# لمصفوفة 2×2:
# |أ  ب| = |1    0 | × |أ    ب     |
# |ج  د|   |ج/أ  1 |   |0   د-ب×ج/أ|
# ────────────────────────────────────────────────────────────────── **#


#**
# تحليل LU لمصفوفة 2×2
# L = |1      0|   U = |أ        ب    |
#     |ج/أ    1|       |0   د - بج/أ  |
**#

# عناصر L
دالة رقم لو_2_ل21(رقم أ، رقم ج)
    رقم عامل_دقة = 1000000
    إذا (أ == 0)
        إرجاع 0 - 999999
    نهاية
    إرجاع (ج * عامل_دقة) / أ
نهاية

# عناصر U
دالة رقم لو_2_ف11(رقم أ)
    إرجاع أ
نهاية

دالة رقم لو_2_ف12(رقم ب)
    إرجاع ب
نهاية

دالة رقم لو_2_ف22(رقم أ، رقم ب، رقم ج، رقم د)
    إذا (أ == 0)
        إرجاع 0 - 999999
    نهاية
    # U22 = د - ب×ج/أ = (أ×د - ب×ج) / أ
    إرجاع (أ * د - ب * ج) / أ
نهاية


#**
# دالة: نورم_م2_فروبينيوس
# الوصف: حساب نورم فروبينيوس لمصفوفة 2×2
#         ||A||_F = √(Σ|a_ij|²)
# الإرجاع: النورم² (مجموع مربعات العناصر) لتجنب الجذر
**#
دالة رقم نورم_م2_فروبينيوس_مربع(رقم أ، رقم ب، رقم ج، رقم د)
    إرجاع أ * أ + ب * ب + ج * ج + د * د
نهاية


#**
# دالة: نورم_م3_فروبينيوس_مربع
# الوصف: مربع نورم فروبينيوس لمصفوفة 3×3
**#
دالة رقم نورم_م3_فروبينيوس_مربع(رقم أ11، رقم أ12، رقم أ13، رقم أ21، رقم أ22، رقم أ23، رقم أ31، رقم أ32، رقم أ33)
    إرجاع أ11 * أ11 + أ12 * أ12 + أ13 * أ13 + أ21 * أ21 + أ22 * أ22 + أ23 * أ23 + أ31 * أ31 + أ32 * أ32 + أ33 * أ33
نهاية


#**
# دالة: نورم_م2_صف_أقصى
# الوصف: نورم الصف الأقصى (∞-norm) لمصفوفة 2×2
#         max(|أ|+|ب|, |ج|+|د|)
**#
دالة رقم نورم_م2_صف(رقم أ، رقم ب، رقم ج، رقم د)
    # القيم المطلقة
    رقم أ_م = أ
    إذا (أ_م < 0)
        أ_م = 0 - أ_م
    نهاية
    رقم ب_م = ب
    إذا (ب_م < 0)
        ب_م = 0 - ب_م
    نهاية
    رقم ج_م = ج
    إذا (ج_م < 0)
        ج_م = 0 - ج_م
    نهاية
    رقم د_م = د
    إذا (د_م < 0)
        د_م = 0 - د_م
    نهاية
    
    رقم صف1 = أ_م + ب_م
    رقم صف2 = ج_م + د_م
    
    إذا (صف1 > صف2)
        إرجاع صف1
    نهاية
    إرجاع صف2
نهاية


