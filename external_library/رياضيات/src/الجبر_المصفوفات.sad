#**
# دالة: تشفير_هيل_حرف
# الوصف: تشفير Hill لحرف واحد باستخدام مصفوفة مفتاح 2×2
#         يحول حرفين إلى حرفين مشفرين
#         [ش1']   |أ ب| [ش1]
#         [ش2'] = |ج د|×[ش2]  mod 26
# المعاملات: المصفوفة المفتاح + قيمتا الحرفين (0-25)
**#
دالة رقم تشفير_هيل_1(رقم أ، رقم ب، رقم ش1، رقم ش2)
    رقم النتيجة = أ * ش1 + ب * ش2
    # حساب mod 26 يدوياً
    رقم المقسوم = النتيجة / 26
    إرجاع النتيجة - المقسوم * 26
نهاية

دالة رقم تشفير_هيل_2(رقم ج، رقم د، رقم ش1، رقم ش2)
    رقم النتيجة = ج * ش1 + د * ش2
    رقم المقسوم = النتيجة / 26
    إرجاع النتيجة - المقسوم * 26
نهاية


#**
# سلسلة ماركوف - الحالة التالية
# إذا كان π هو متجه الحالة و P مصفوفة الانتقال:
# π' = P × π
**#
دالة رقم ماركوف_حالة_1(رقم ح11، رقم ح12، رقم حالة1، رقم حالة2)
    إرجاع ح11 * حالة1 + ح12 * حالة2
نهاية

دالة رقم ماركوف_حالة_2(رقم ح21، رقم ح22، رقم حالة1، رقم حالة2)
    إرجاع ح21 * حالة1 + ح22 * حالة2
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 7: الاختبارات                                       ║
# ║          Section 7: Tests                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

دالة رقم اختبار_المصفوفات()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار ملف المصفوفات")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: محدد 2×2
    # |3 1| = 3×2 - 1×5 = 1
    # |5 2|
    رقم ن1 = محدد_م2(3، 1، 5، 2)
    إذا (ن1 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ محدد |3,1;5,2| = 1")
    وإلا
        فشل = فشل + 1
        اطبع("✗ محدد = ")
        اطبع_سطر(ن1)
    نهاية
    
    # اختبار 2: محدد 3×3
    # |2 1 3|
    # |1 0 1| = 2(0-2) - 1(2-3) + 3(2-0) = -4+1+6 = 3
    # |0 2 2|
    رقم ن2 = محدد_م3(2، 1، 3، 1، 0، 1، 0، 2، 2)
    إذا (ن2 == 3)
        نجاح = نجاح + 1
        اطبع_سطر("✓ محدد_3 = 3")
    وإلا
        فشل = فشل + 1
        اطبع("✗ محدد_3 = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: أثر 2×2
    رقم ن3 = أثر_م2(5، 7)
    إذا (ن3 == 12)
        نجاح = نجاح + 1
        اطبع_سطر("✓ أثر(5,_,_,7) = 12")
    وإلا
        فشل = فشل + 1
        اطبع("✗ أثر = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: هل مصفوفة وحدة
    رقم ن4 = هل_م2_وحدة(1، 0، 0، 1)
    إذا (ن4 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ I₂ هي مصفوفة وحدة")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل اختبار مصفوفة الوحدة")
    نهاية
    
    # اختبار 5: ضرب مصفوفتين
    # |1 2| × |5 6| = |1×5+2×7  1×6+2×8| = |19 22|
    # |3 4|   |7 8|   |3×5+4×7  3×6+4×8|   |43 50|
    رقم ن5_11 = ضرب_م2_11(1، 2، 5، 7)
    رقم ن5_12 = ضرب_م2_12(1، 2، 6، 8)
    إذا (ن5_11 == 19)
        إذا (ن5_12 == 22)
            نجاح = نجاح + 1
            اطبع_سطر("✓ ضرب المصفوفتين صحيح")
        وإلا
            فشل = فشل + 1
            اطبع_سطر("✗ فشل ضرب المصفوفات")
        نهاية
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل ضرب المصفوفات")
    نهاية
    
    # اختبار 6: كرونيكر
    رقم ن6 = دلتا_كرونيكر(3، 3)
    إذا (ن6 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ δ(3,3) = 1")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل كرونيكر")
    نهاية
    
    # اختبار 7: ليفي-شيفيتا
    رقم ن7 = ليفي_شيفيتا(1، 2، 3)
    إذا (ن7 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ ε(1,2,3) = 1")
    وإلا
        فشل = فشل + 1
        اطبع("✗ ε(1,2,3) = ")
        اطبع_سطر(ن7)
    نهاية
    
    # اختبار 8: هل منفردة
    # |1 2| محدد = 1×4 - 2×2 = 0 → منفردة
    # |2 4|
    رقم ن8 = هل_م2_منفردة(1، 2، 2، 4)
    إذا (ن8 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ |1 2; 2 4| منفردة")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل اختبار المنفردة")
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


# ═══════════════════════════════════════════════════════════════
# نهاية ملف المصفوفات
# عدد الدوال: ~80 دالة
# الأقسام: 7 أقسام
# ═══════════════════════════════════════════════════════════════
