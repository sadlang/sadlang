#** ─────────────────────────────────────────────────────────────────
# المصفوفة 4×4 تُستخدم بكثرة في:
# - الرسوميات الحاسوبية (التحويلات المتجانسة)
# - الفيزياء النسبية (تنسور متري)
# - 16 عنصر
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: محدد_م4
# الوصف: حساب محدد مصفوفة 4×4 بالتوسع بالسطر الأول
#         يستخدم محددات 3×3 كعوامل مرافقة
**#
دالة رقم محدد_م4(رقم أ11، رقم أ12، رقم أ13، رقم أ14، رقم أ21، رقم أ22، رقم أ23، رقم أ24، رقم أ31، رقم أ32، رقم أ33، رقم أ34، رقم أ41، رقم أ42، رقم أ43، رقم أ44)
    
    # العامل المرافق C_11
    رقم م11 = محدد_م3(أ22، أ23، أ24، أ32، أ33، أ34، أ42، أ43، أ44)
    
    # العامل المرافق C_12
    رقم م12 = محدد_م3(أ21، أ23، أ24، أ31، أ33، أ34، أ41، أ43، أ44)
    
    # العامل المرافق C_13
    رقم م13 = محدد_م3(أ21، أ22، أ24، أ31، أ32، أ34، أ41، أ42، أ44)
    
    # العامل المرافق C_14
    رقم م14 = محدد_م3(أ21، أ22، أ23، أ31، أ32، أ33، أ41، أ42، أ43)
    
    إرجاع أ11 * م11 - أ12 * م12 + أ13 * م13 - أ14 * م14
نهاية


#**
# دالة: أثر_م4
# الوصف: أثر مصفوفة 4×4
**#
دالة رقم أثر_م4(رقم أ11، رقم أ22، رقم أ33، رقم أ44)
    إرجاع أ11 + أ22 + أ33 + أ44
نهاية


