#**
# دالة: دلتا_كرونيكر
# الوصف: رمز كرونيكر δ_ij
#         δ_ij = 1 إذا i = j
#         δ_ij = 0 إذا i ≠ j
# يُستخدم لتعريف مصفوفة الوحدة: I_ij = δ_ij
**#
دالة رقم دلتا_كرونيكر(رقم ع، رقم ج)
    إذا (ع == ج)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: رمز_ليفي_شيفيتا
# الوصف: رمز ليفي-شيفيتا ε_ijk (تنسور التبديل)
#         ε = +1 للتباديل الزوجية (1,2,3), (2,3,1), (3,1,2)
#         ε = -1 للتباديل الفردية (1,3,2), (3,2,1), (2,1,3)
#         ε = 0 إذا تكرر أي مؤشر
# يُستخدم في: الضرب الاتجاهي، المحددات
**#
دالة رقم ليفي_شيفيتا(رقم ع، رقم ج، رقم ك)
    # التحقق من التكرار
    إذا (ع == ج)
        إرجاع 0
    نهاية
    إذا (ج == ك)
        إرجاع 0
    نهاية
    إذا (ع == ك)
        إرجاع 0
    نهاية
    
    # التباديل الزوجية
    إذا (ع == 1)
        إذا (ج == 2)
            إذا (ك == 3)
                إرجاع 1
            نهاية
        نهاية
    نهاية
    إذا (ع == 2)
        إذا (ج == 3)
            إذا (ك == 1)
                إرجاع 1
            نهاية
        نهاية
    نهاية
    إذا (ع == 3)
        إذا (ج == 1)
            إذا (ك == 2)
                إرجاع 1
            نهاية
        نهاية
    نهاية
    
    # التباديل الفردية
    إرجاع 0 - 1
نهاية


#**
# دالة: تحويل_دوران_2_11
# الوصف: عنصر (1,1) من مصفوفة الدوران 2×2
#         R(θ) = |cos(θ)  -sin(θ)|
#                |sin(θ)   cos(θ)|
