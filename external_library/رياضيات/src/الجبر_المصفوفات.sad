    إذا (درجات == 45)
        إرجاع 707107
    نهاية
    إذا (درجات == 60)
        إرجاع 500000
    نهاية
    إذا (درجات == 90)
        إرجاع 0
    نهاية
    إذا (درجات == 120)
        إرجاع 0 - 500000
    نهاية
    إذا (درجات == 135)
        إرجاع 0 - 707107
    نهاية
    إذا (درجات == 150)
        إرجاع 0 - 866025
    نهاية
    إذا (درجات == 180)
        إرجاع 0 - 1000000
    نهاية
    إذا (درجات == 270)
        إرجاع 0
    نهاية
    إذا (درجات == 360)
        إرجاع 1000000
    نهاية
    إرجاع 0 - 999999
نهاية


