#** ═══════════════════════════════════════════════════════════════════
# ملف: الرئيسية.sad
# المكتبة: رياضيات-شاملة (الإصدار 1.0.0)
# الوصف: الملف الرئيسي لمكتبة الرياضيات الشاملة للغة ص
#         يستورد جميع الوحدات الفرعية ويوفر واجهة موحدة
# المؤلف: فريق لغة ص
# الترخيص: MIT
# ═══════════════════════════════════════════════════════════════════
#
# مكتبة الرياضيات الشاملة - أكبر مكتبة رياضيات عربية
# تحتوي على أكثر من 30 وحدة تغطي جميع فروع الرياضيات
#
# الوحدات:
#   - الثوابت: ثوابت رياضية أساسية ومتقدمة
#   - الحساب_الأساسي: العمليات الحسابية الأربع والقوى والجذور
#   - الجبر_المعادلات: حل المعادلات الخطية والتربيعية والتكعيبية
#   - الجبر_كثيرات_الحدود: عمليات كثيرات الحدود
#   - الجبر_المصفوفات: عمليات المصفوفات والمحددات
#   - الجبر_المتجهات: عمليات المتجهات
#   - الجبر_المتقدم: الزمر والحقول والأعداد المركبة
#   - حساب_المثلثات: دوال المثلثات والتحويلات
#   - الهندسة: الأشكال الهندسية ومساحاتها وحجومها
#   - الإحصاء: المتوسطات والانحرافات والتوزيعات
#   - التحليل_العددي: الطرق العددية والتقريبات
#   - نظرية_الأعداد: الأعداد الأولية والقسمة والمعادلات
#   - التفاضل_والتكامل: المشتقات والتكاملات
#   - الاحتمالات_المتقدمة: التوزيعات الاحتمالية
#   - التحويلات: تحويلات الأنظمة والوحدات
#   - رياضيات_الحاسوب: البتات والخوارزميات
#   - الاستيفاء_والتقريب: الاستيفاء والتقريب العددي
#   - التحليل_الرياضي: النهايات والمتسلسلات
#   - الرياضيات_الهندسية: رياضيات الهندسة التطبيقية
#   - الرياضيات_المالية: الفائدة والاستثمار
#   - التشفير_والأمان: خوارزميات التشفير
#   - الهندسة_التحليلية: الإحداثيات والمنحنيات
#   - الهندسة_التفاضلية: المنحنيات والسطوح
#   - المنطق_الرياضي: العمليات المنطقية
#   - نظرية_المجموعات: عمليات المجموعات
#   - نظرية_الرسوم_البيانية: الرسوم البيانية
#   - الجبر_الخطي_المتقدم: التحليلات المتقدمة
#   - المتتاليات_والمتسلسلات: المتسلسلات الشهيرة
#   - الرسوميات_الحاسوبية: الرسوميات ثنائية وثلاثية الأبعاد
#   - الرياضيات_الفيزيائية: رياضيات الفيزياء
# ═══════════════════════════════════════════════════════════════════ **#

# ═══════════════════════════════════════════════════════════════
# معلومات المكتبة
# ═══════════════════════════════════════════════════════════════
متغير _اسم_المكتبة = "رياضيات-شاملة"
متغير _اصدار_المكتبة = "1.0.0"
متغير _مؤلف_المكتبة = "فريق لغة ص"

# ═══════════════════════════════════════════════════════════════
# دالة عرض معلومات المكتبة
# ═══════════════════════════════════════════════════════════════
دالة معلومات_المكتبة()
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  المكتبة: ")
    اطبع_سطر(_اسم_المكتبة)
    اطبع("  الإصدار: ")
    اطبع_سطر(_اصدار_المكتبة)
    اطبع("  المؤلف: ")
    اطبع_سطر(_مؤلف_المكتبة)
    اطبع_سطر("  الترخيص: MIT")
    اطبع_سطر("═══════════════════════════════════════════")
نهاية

# ═══════════════════════════════════════════════════════════════
# نهاية الملف الرئيسي
# ═══════════════════════════════════════════════════════════════
