#**
# طريقة ياكوبي التكرارية (Jacobi Iteration):
# لحل نظام 2×2:
# أ1×س + ب1×ص = ج1
# أ2×س + ب2×ص = ج2
#
# التكرار:
# سن+1 = (ج1 - ب1×صن) / أ1
# صن+1 = (ج2 - أ2×سن) / أ2
**#
دالة رقم ياكوبي_2_س(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم ع = 1000000
    رقم س = 0
    رقم ص = 0
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم س_جديد = (ج1 * ع - ب1 * ص) / أ1
        رقم ص_جديد = (ج2 * ع - أ2 * س) / ب2
        س = س_جديد
        ص = ص_جديد
        عداد = عداد + 1
    نهاية
    
    إرجاع س
نهاية

دالة رقم ياكوبي_2_ص(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم ع = 1000000
    رقم س = 0
    رقم ص = 0
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم س_جديد = (ج1 * ع - ب1 * ص) / أ1
        رقم ص_جديد = (ج2 * ع - أ2 * س) / ب2
        س = س_جديد
        ص = ص_جديد
        عداد = عداد + 1
    نهاية
    
    إرجاع ص
نهاية


