#** ─────────────────────────────────────────────────────────────────
# طريقة التنصيف (Bisection Method):
# - نبدأ بفترة [أ، ب] حيث ف(أ) × ف(ب) < 0
# - ننصف الفترة ونختار النصف الذي يحتوي الجذر
# - نكرر حتى |ب - أ| < ε
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: تنصيف_كثير_حدود_2
# الوصف: إيجاد جذر: أ×س² + ب×س + ج = 0 بالتنصيف
#         في الفترة [يسار، يمين]
# الإرجاع: الجذر × عامل_دقة
**#
دالة رقم تنصيف_متعددة_2(رقم أ، رقم ب، رقم ج، رقم يسار، رقم يمين)
    رقم ع = 1000000
    رقم ي = يسار * ع
    رقم م = يمين * ع
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم منتصف = (ي + م) / 2
        
        # ف(المنتصف) = أ×س² + ب×س + ج (كل شيء مقيّس)
        رقم س = منتصف
        رقم ف_منتصف = أ * س / ع * س / ع + ب * س / ع + ج * ع
        
        # ف(اليسار)
        رقم ف_يسار = أ * ي / ع * ي / ع + ب * ي / ع + ج * ع
        
        إذا (ف_منتصف == 0)
            إرجاع منتصف
        نهاية
        
        # نحدد أي نصف يحتوي الجذر
        إذا ((ف_يسار > 0) == (ف_منتصف > 0))
            ي = منتصف
        وإلا
            م = منتصف
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع (ي + م) / 2
نهاية


#**
# طريقة نيوتن-رافسون (Newton-Raphson Method):
# سن+1 = سن - ف(سن)/ف'(سن)
# تتقارب تربيعياً (أسرع من التنصيف) لكن تحتاج
# نقطة بداية جيدة ومشتقة
**#


#**
# دالة: نيوتن_جذر
# الوصف: إيجاد الجذر التربيعي بطريقة نيوتن
#         ف(س) = س² - ن = 0
#         ف'(س) = 2س
#         سن+1 = (سن + ن/سن) / 2
# الإرجاع: √ن × عامل_دقة
**#
دالة رقم نيوتن_جذر(رقم ن)
    رقم ع = 1000000
    
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    
    رقم تخمين = ن * ع / 2
    إذا (تخمين == 0)
        تخمين = ع
    نهاية
    
    رقم عداد = 0
    كرر طالما (عداد < 40)
        رقم جديد = (تخمين + ن * ع * ع / تخمين) / 2
        إذا (جديد == تخمين)
            إرجاع تخمين
        نهاية
        تخمين = جديد
        عداد = عداد + 1
    نهاية
    
    إرجاع تخمين
نهاية


#**
# دالة: نيوتن_جذر_تكعيبي
# الوصف: الجذر التكعيبي بطريقة نيوتن
#         ف(س) = س³ - ن = 0
#         سن+1 = (2×سن + ن/سن²) / 3
**#
دالة رقم نيوتن_جذر_تكعيبي(رقم ن)
    رقم ع = 1000000
    
    إذا (ن == 0)
        إرجاع 0
    نهاية
    
    رقم سالب = 0
    رقم القيمة = ن
    إذا (القيمة < 0)
        سالب = 1
        القيمة = 0 - القيمة
    نهاية
    
    رقم تخمين = القيمة * ع / 3
    إذا (تخمين == 0)
        تخمين = ع
    نهاية
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم جديد = (2 * تخمين + القيمة * ع * ع * ع / (تخمين * تخمين)) / 3
        إذا (جديد == تخمين)
            إذا (سالب == 1)
                إرجاع 0 - تخمين
            نهاية
            إرجاع تخمين
        نهاية
        تخمين = جديد
        عداد = عداد + 1
    نهاية
    
    إذا (سالب == 1)
        إرجاع 0 - تخمين
    نهاية
    إرجاع تخمين
نهاية


