#**
# فرق أمامي (Forward Difference):
# ف'(س) ≈ [ف(س+ح) - ف(س)] / ح
#
# فرق مركزي (Central Difference):
# ف'(س) ≈ [ف(س+ح) - ف(س-ح)] / (2ح)
#
# فرق مركزي للمشتقة الثانية:
# ف''(س) ≈ [ف(س+ح) - 2×ف(س) + ف(س-ح)] / ح²
**#


#**
# دالة: مشتقة_عددية_تربيع
# الوصف: مشتقة ف(س) = س² باستخدام الفرق المركزي
#         ف'(س) = 2س
# المدخلات: نقطة (قيمة عادية)
# الإرجاع: المشتقة × عامل_دقة
**#
دالة رقم مشتقة_تربيع(رقم س)
    رقم ع = 1000000
    رقم ح = 1  # خطوة صغيرة
    
    # فرق مركزي: [(س+ح)² - (س-ح)²] / (2ح) = 2س
    رقم زائد = (س + ح) * (س + ح)
    رقم ناقص = (س - ح) * (س - ح)
    إرجاع (زائد - ناقص) * ع / (2 * ح)
نهاية


#**
# دالة: مشتقة_تكعيب
# الوصف: مشتقة ف(س) = س³
#         ف'(س) = 3س²
**#
دالة رقم مشتقة_تكعيب(رقم س)
    رقم ع = 1000000
    رقم ح = 1
    رقم زائد = (س + ح) * (س + ح) * (س + ح)
    رقم ناقص = (س - ح) * (س - ح) * (س - ح)
    إرجاع (زائد - ناقص) * ع / (2 * ح)
نهاية


#**
# دالة: مشتقة_ثانية_عددية
# الوصف: المشتقة الثانية لـ ف(س) = س³
#         ف''(س) = 6س
**#
دالة رقم مشتقة_ثانية_تكعيب(رقم س)
    رقم ع = 1000000
    رقم ح = 1
    رقم زائد = (س + ح) * (س + ح) * (س + ح)
    رقم حالي = س * س * س
    رقم ناقص = (س - ح) * (س - ح) * (س - ح)
    إرجاع (زائد - 2 * حالي + ناقص) * ع / (ح * ح)
نهاية


