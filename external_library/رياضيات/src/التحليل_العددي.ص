#**
# دالة: خطأ_مطلق
# الوصف: |القيمة الحقيقية - القيمة التقريبية|
**#
دالة رقم خطأ_مطلق(رقم حقيقي، رقم تقريبي)
    رقم الفرق = حقيقي - تقريبي
    إذا (الفرق < 0)
        إرجاع 0 - الفرق
    نهاية
    إرجاع الفرق
نهاية


#**
# دالة: خطأ_نسبي
# الوصف: |الخطأ المطلق| / |القيمة الحقيقية| × 10^6
**#
دالة رقم خطأ_نسبي(رقم حقيقي، رقم تقريبي)
    رقم ع = 1000000
    رقم مطلق = خطأ_مطلق(حقيقي، تقريبي)
    رقم القيمة = حقيقي
    إذا (القيمة < 0)
        القيمة = 0 - القيمة
    نهاية
    إذا (القيمة == 0)
        إرجاع 0
    نهاية
    إرجاع مطلق * ع / القيمة
نهاية


#**
# دالة: تقريب_أقرب
# الوصف: تقريب رقم إلى أقرب مضاعف لـ الخطوة
**#
دالة رقم تقريب_أقرب(رقم القيمة، رقم الخطوة)
    رقم المقسوم = القيمة / الخطوة
    رقم الباقي = القيمة - المقسوم * الخطوة
    
    إذا (الباقي * 2 >= الخطوة)
        إرجاع (المقسوم + 1) * الخطوة
    نهاية
    إرجاع المقسوم * الخطوة
نهاية


