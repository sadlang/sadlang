نهاية


#**
# دالة: استيفاء_لاغرانج_3
# الوصف: استيفاء لاغرانج بثلاث نقاط
#         P(x) = ص1×L1 + ص2×L2 + ص3×L3
#         Li = ∏(x-xj)/(xi-xj) لـ j≠i
**#
دالة رقم لاغرانج_3(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3، رقم س)
    رقم ع = 1000000
    
    # L1 = (س-س2)(س-س3) / (س1-س2)(س1-س3)
    رقم مقام1 = (س1 - س2) * (س1 - س3)
    رقم بسط1 = (س - س2) * (س - س3)
    
    # L2
    رقم مقام2 = (س2 - س1) * (س2 - س3)
    رقم بسط2 = (س - س1) * (س - س3)
    
    # L3
    رقم مقام3 = (س3 - س1) * (س3 - س2)
    رقم بسط3 = (س - س1) * (س - س2)
    
    رقم نتيجة = 0
    إذا (مقام1 != 0)
        نتيجة = نتيجة + ص1 * بسط1 * ع / مقام1
    نهاية
    إذا (مقام2 != 0)
        نتيجة = نتيجة + ص2 * بسط2 * ع / مقام2
    نهاية
    إذا (مقام3 != 0)
        نتيجة = نتيجة + ص3 * بسط3 * ع / مقام3
    نهاية
    
    إرجاع نتيجة
نهاية


