#**
# الاستيفاء الخطي (Linear Interpolation):
# ص = ص1 + (ص2-ص1) × (س-س1) / (س2-س1)
**#
دالة رقم استيفاء_خطي(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س)
    رقم ع = 1000000
    إذا (س2 == س1)
        إرجاع ص1 * ع
    نهاية
    إرجاع ص1 * ع + (ص2 - ص1) * (س - س1) * ع / (س2 - س1)
نهاية


