#**
# دالة: تكامل_شبه_منحرف
# الوصف: تكامل ف(س) = س² من أ إلى ب
#         بقاعدة شبه المنحرف مع ن قسمة
#         ∫ف = ح/2 × [ف(أ) + 2×Σف(سi) + ف(ب)]
# كمثال: تكامل س² من 0 إلى 1 = 1/3
**#
دالة رقم تكامل_مربع(رقم بداية، رقم نهاية_ح، رقم عدد_أقسام)
    رقم ع = 1000000
    رقم حجم = (نهاية_ح - بداية) * ع / عدد_أقسام
    
    # ف(بداية) + ف(نهاية)
    رقم مجموع = بداية * بداية + نهاية_ح * نهاية_ح
    
    رقم ن = 1
    كرر طالما (ن < عدد_أقسام)
        رقم نقطة = بداية * ع + ن * حجم
        رقم س = نقطة / ع
        مجموع = مجموع + 2 * س * س
        ن = ن + 1
    نهاية
    
    إرجاع حجم * مجموع / (2 * ع)
نهاية


