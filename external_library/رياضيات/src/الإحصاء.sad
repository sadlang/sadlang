# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 1: مقاييس النزعة المركزية                           ║
# ║          Section 1: Measures of Central Tendency                   ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# الوسط الحسابي (Mean):
# μ = Σxi / ن
**#

دالة رقم وسط_2(رقم أ، رقم ب)
    إرجاع (أ + ب) / 2
نهاية

دالة رقم وسط_3(رقم أ، رقم ب، رقم ج)
    إرجاع (أ + ب + ج) / 3
نهاية

دالة رقم وسط_4(رقم أ، رقم ب، رقم ج، رقم د)
    إرجاع (أ + ب + ج + د) / 4
نهاية

دالة رقم وسط_5(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ)
    إرجاع (أ + ب + ج + د + هـ) / 5
نهاية

دالة رقم وسط_6(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم و)
    إرجاع (أ + ب + ج + د + هـ + و) / 6
نهاية

دالة رقم وسط_8(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم و، رقم ز، رقم ح)
    إرجاع (أ + ب + ج + د + هـ + و + ز + ح) / 8
نهاية

دالة رقم وسط_10(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم و، رقم ز، رقم ح، رقم ط، رقم ي)
    إرجاع (أ + ب + ج + د + هـ + و + ز + ح + ط + ي) / 10
نهاية


#**
# الوسط الموزون (Weighted Mean):
# μ = Σ(xi × wi) / Σwi
**#
دالة رقم وسط_موزون_2(رقم ق1، رقم و1، رقم ق2، رقم و2)
    إرجاع (ق1 * و1 + ق2 * و2) / (و1 + و2)
نهاية

دالة رقم وسط_موزون_3(رقم ق1، رقم و1، رقم ق2، رقم و2، رقم ق3، رقم و3)
    إرجاع (ق1 * و1 + ق2 * و2 + ق3 * و3) / (و1 + و2 + و3)
نهاية

دالة رقم وسط_موزون_4(رقم ق1، رقم و1، رقم ق2، رقم و2، رقم ق3، رقم و3، رقم ق4، رقم و4)
    إرجاع (ق1 * و1 + ق2 * و2 + ق3 * و3 + ق4 * و4) / (و1 + و2 + و3 + و4)
نهاية


#**
# الوسط الهندسي (Geometric Mean):
# GM = (∏xi)^(1/ن)
# بسبب عدم وجود أعداد عشرية، نُرجع الحاصل مباشرة
**#
دالة رقم حاصل_ضرب_2(رقم أ، رقم ب)
    إرجاع أ * ب
نهاية

دالة رقم حاصل_ضرب_3(رقم أ، رقم ب، رقم ج)
    إرجاع أ * ب * ج
نهاية


#**
# الوسط التوافقي (Harmonic Mean):
# HM = ن / Σ(1/xi) = ن × ∏xi / (Σ(∏xj≠i))
# لقيمتين: 2أب/(أ+ب)
**#
دالة رقم وسط_توافقي_2(رقم أ، رقم ب)
    إذا (أ + ب == 0)
        إرجاع 0
    نهاية
    إرجاع 2 * أ * ب / (أ + ب)
نهاية

دالة رقم وسط_توافقي_3(رقم أ، رقم ب، رقم ج)
    رقم المقام = أ * ب + ب * ج + أ * ج
    إذا (المقام == 0)
        إرجاع 0
    نهاية
    إرجاع 3 * أ * ب * ج / المقام
نهاية


#**
# الوسيط (Median):
# القيمة الوسطى بعد الترتيب
**#

#** تصغير: أصغر قيمة من قيمتين **#
دالة رقم أصغر_2(رقم أ، رقم ب)
    إذا (أ < ب)
        إرجاع أ
    نهاية
    إرجاع ب
نهاية

دالة رقم أكبر_2(رقم أ، رقم ب)
    إذا (أ > ب)
        إرجاع أ
    نهاية
    إرجاع ب
نهاية

#** وسيط ثلاث قيم **#
دالة رقم وسيط_3(رقم أ، رقم ب، رقم ج)
    إذا (أ <= ب)
        إذا (ب <= ج)
            إرجاع ب
        نهاية
        إذا (أ <= ج)
            إرجاع ج
        نهاية
        إرجاع أ
    نهاية
    # ب < أ
    إذا (أ <= ج)
        إرجاع أ
    نهاية
    إذا (ب <= ج)
        إرجاع ج
    نهاية
    إرجاع ب
نهاية


#** المدى (Range) **#
دالة رقم مدى_2(رقم أ، رقم ب)
    رقم الفرق = أ - ب
    إذا (الفرق < 0)
        إرجاع 0 - الفرق
    نهاية
    إرجاع الفرق
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 2: مقاييس التشتت                                    ║
# ║          Section 2: Measures of Dispersion                         ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# التباين (Variance):
# σ² = Σ(xi - μ)² / ن  (تباين المجتمع)
# s² = Σ(xi - x̄)² / (ن-1)  (تباين العينة)
**#

#** تباين المجتمع لقيمتين **#
دالة رقم تباين_2(رقم أ، رقم ب)
    رقم المتوسط = (أ + ب) / 2
    رقم ف1 = أ - المتوسط
    رقم ف2 = ب - المتوسط
    إرجاع (ف1 * ف1 + ف2 * ف2) / 2
نهاية

#** تباين المجتمع لثلاث قيم **#
دالة رقم تباين_3(رقم أ، رقم ب، رقم ج)
    رقم المتوسط = (أ + ب + ج) / 3
    رقم ف1 = أ - المتوسط
    رقم ف2 = ب - المتوسط
    رقم ف3 = ج - المتوسط
    إرجاع (ف1 * ف1 + ف2 * ف2 + ف3 * ف3) / 3
نهاية

#** تباين المجتمع لأربع قيم **#
دالة رقم تباين_4(رقم أ، رقم ب، رقم ج، رقم د)
    رقم المتوسط = (أ + ب + ج + د) / 4
    رقم ف1 = أ - المتوسط
    رقم ف2 = ب - المتوسط
    رقم ف3 = ج - المتوسط
    رقم ف4 = د - المتوسط
    إرجاع (ف1 * ف1 + ف2 * ف2 + ف3 * ف3 + ف4 * ف4) / 4
نهاية

#** تباين المجتمع لخمس قيم **#
دالة رقم تباين_5(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ)
    رقم المتوسط = (أ + ب + ج + د + هـ) / 5
    رقم ف1 = أ - المتوسط
    رقم ف2 = ب - المتوسط
    رقم ف3 = ج - المتوسط
    رقم ف4 = د - المتوسط
    رقم ف5 = هـ - المتوسط
    إرجاع (ف1 * ف1 + ف2 * ف2 + ف3 * ف3 + ف4 * ف4 + ف5 * ف5) / 5
نهاية


#**
# تباين العينة (يُقسَم على ن-1)
**#
دالة رقم تباين_عينة_2(رقم أ، رقم ب)
    رقم المتوسط = (أ + ب) / 2
    رقم ف1 = أ - المتوسط
    رقم ف2 = ب - المتوسط
    إرجاع ف1 * ف1 + ف2 * ف2
نهاية

دالة رقم تباين_عينة_3(رقم أ، رقم ب، رقم ج)
    رقم المتوسط = (أ + ب + ج) / 3
    رقم ف1 = أ - المتوسط
    رقم ف2 = ب - المتوسط
    رقم ف3 = ج - المتوسط
    إرجاع (ف1 * ف1 + ف2 * ف2 + ف3 * ف3) / 2
نهاية


#**
# مجموع الانحرافات المطلقة
**#
دالة رقم انحراف_مطلق_2(رقم أ، رقم ب)
    رقم المتوسط = (أ + ب) / 2
    رقم ف1 = أ - المتوسط
    رقم ف2 = ب - المتوسط
    إذا (ف1 < 0)
        ف1 = 0 - ف1
    نهاية
    إذا (ف2 < 0)
        ف2 = 0 - ف2
    نهاية
    إرجاع (ف1 + ف2) / 2
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 3: التوافيق والتباديل                               ║
# ║          Section 3: Combinations and Permutations                  ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: مضروب
# الوصف: ن! = ن × (ن-1) × ... × 2 × 1
**#
دالة رقم مضروب(رقم ن)
    إذا (ن <= 1)
        إرجاع 1
    نهاية
    رقم النتيجة = 1
    رقم ع = 2
    كرر طالما (ع <= ن)
        النتيجة = النتيجة * ع
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: تباديل
# الوصف: P(ن، ر) = ن! / (ن-ر)!
**#
دالة رقم تباديل(رقم ن، رقم ر)
    رقم النتيجة = 1
    رقم ع = ن - ر + 1
    كرر طالما (ع <= ن)
        النتيجة = النتيجة * ع
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: توافيق
# الوصف: C(ن، ر) = ن! / (ر! × (ن-ر)!)
#         نحسبها بطريقة فعالة لتجنب overflow
**#
دالة رقم توافيق(رقم ن، رقم ر)
    إذا (ر > ن)
        إرجاع 0
    نهاية
    
    # نستغل: C(ن، ر) = C(ن، ن-ر)
    رقم ك = ر
    إذا (ك > ن - ك)
        ك = ن - ك
    نهاية
    
    رقم النتيجة = 1
    رقم ع = 0
    كرر طالما (ع < ك)
        النتيجة = النتيجة * (ن - ع) / (ع + 1)
        ع = ع + 1
    نهاية
    
    إرجاع النتيجة
نهاية


#**
# دالة: تباديل_مكررة
# الوصف: ن^ر (التباديل مع التكرار)
**#
دالة رقم تباديل_مكررة(رقم ن، رقم ر)
    رقم النتيجة = 1
    رقم ع = 0
    كرر طالما (ع < ر)
        النتيجة = النتيجة * ن
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# مثلث باسكال: C(ن، ر) = C(ن-1، ر-1) + C(ن-1، ر)
# الصف ن من مثلث باسكال:
**#
دالة رقم باسكال(رقم ن، رقم ر)
    إرجاع توافيق(ن، ر)
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 4: الاحتمالات الأساسية                              ║
# ║          Section 4: Basic Probability                              ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: احتمال_بسيط
# الوصف: A(ح) = عدد الحالات الملائمة / عدد الحالات الممكنة
#         نُرجع القيمة × عامل_دقة
**#
دالة رقم احتمال_بسيط(رقم ملائمة، رقم ممكنة)
    رقم ع = 1000000
    إذا (ممكنة == 0)
        إرجاع 0
    نهاية
    إرجاع ملائمة * ع / ممكنة
نهاية


#**
# دالة: احتمال_متمم
# الوصف: P(A') = 1 - P(A)
# المدخل: P(A) × 10^6
**#
دالة رقم احتمال_متمم(رقم ح)
    إرجاع 1000000 - ح
نهاية


#**
# دالة: احتمال_اتحاد
# الوصف: P(A∪B) = P(A) + P(B) - P(A∩B)
# جميع القيم × 10^6
**#
دالة رقم احتمال_اتحاد(رقم ح_أ، رقم ح_ب، رقم ح_تقاطع)
    إرجاع ح_أ + ح_ب - ح_تقاطع
نهاية


#**
# دالة: احتمال_اتحاد_منفصل
# الوصف: P(A∪B) = P(A) + P(B) (عند انعدام التقاطع)
**#
دالة رقم احتمال_اتحاد_منفصل(رقم ح_أ، رقم ح_ب)
    إرجاع ح_أ + ح_ب
نهاية


#**
# دالة: احتمال_شرطي
# الوصف: P(A|B) = P(A∩B) / P(B)
**#
دالة رقم احتمال_شرطي(رقم ح_تقاطع، رقم ح_ب)
    رقم ع = 1000000
    إذا (ح_ب == 0)
        إرجاع 0
    نهاية
    إرجاع ح_تقاطع * ع / ح_ب
نهاية


#**
# دالة: احتمال_مستقل
# الوصف: P(A∩B) = P(A) × P(B) (للأحداث المستقلة)
**#
دالة رقم احتمال_مستقل(رقم ح_أ، رقم ح_ب)
    رقم ع = 1000000
    إرجاع ح_أ * ح_ب / ع
نهاية


#**
# نظرية بايز:
# P(A|B) = P(B|A) × P(A) / P(B)
**#
دالة رقم بايز(رقم ح_ب_معطى_أ، رقم ح_أ، رقم ح_ب)
    رقم ع = 1000000
    إذا (ح_ب == 0)
        إرجاع 0
    نهاية
    إرجاع ح_ب_معطى_أ * ح_أ / ح_ب
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 5: التوزيعات الاحتمالية                            ║
# ║          Section 5: Probability Distributions                      ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# التوزيع ذو الحدين (Binomial Distribution):
# P(X=k) = C(ن، ك) × ع^ك × (1-ع)^(ن-ك)
# حيث ع = احتمال النجاح × 10^6
**#
دالة رقم ذو_حدين(رقم ن، رقم ك، رقم ع_نجاح)
    رقم ع = 1000000
    رقم ت = توافيق(ن، ك)
    
    # ع^ك
    رقم نجاح_قوة = 1
    رقم عداد = 0
    كرر طالما (عداد < ك)
        نجاح_قوة = نجاح_قوة * ع_نجاح / ع
        عداد = عداد + 1
    نهاية
    
    # (1-ع)^(ن-ك)
    رقم فشل = ع - ع_نجاح
    رقم فشل_قوة = 1
    عداد = 0
    كرر طالما (عداد < ن - ك)
        فشل_قوة = فشل_قوة * فشل / ع
        عداد = عداد + 1
    نهاية
    
    إرجاع ت * نجاح_قوة * فشل_قوة / ع
نهاية


#**
# التوزيع ذو الحدين - التوقع والتباين:
# E(X) = ن × ع
# Var(X) = ن × ع × (1-ع)
**#
دالة رقم ذو_حدين_توقع(رقم ن، رقم ع_نجاح)
    رقم ع = 1000000
    إرجاع ن * ع_نجاح / ع
نهاية

دالة رقم ذو_حدين_تباين(رقم ن، رقم ع_نجاح)
    رقم ع = 1000000
    إرجاع ن * ع_نجاح * (ع - ع_نجاح) / (ع * ع)
نهاية


#**
# توزيع بواسون (Poisson Distribution):
# P(X=ك) = λ^ك × e^(-λ) / ك!
# حيث λ = المعدل × 10^6
# تقريب: نستخدم e ≈ 2718282/1000000
**#
دالة رقم بواسون_تقريب(رقم لامدا، رقم ك)
    رقم ع = 1000000
    
    # λ^ك / ك!
    رقم حد = 1
    رقم عداد = 0
    كرر طالما (عداد < ك)
        حد = حد * لامدا / (عداد + 1)
        عداد = عداد + 1
    نهاية
    
    # تقريب e^(-λ): بمتسلسلة e^(-x) = 1 - x + x²/2! - ...
    # نستخدم تقريب بسيط
    رقم هبوط = ع - لامدا + لامدا * لامدا / (2 * ع)
    
    إرجاع حد * هبوط / ع
نهاية


#**
# التوزيع الهندسي (Geometric Distribution):
# P(X=ك) = (1-ع)^(ك-1) × ع
# ك = عدد المحاولات حتى أول نجاح
**#
دالة رقم هندسي(رقم ع_نجاح، رقم ك)
    رقم ع = 1000000
    رقم فشل = ع - ع_نجاح
    
    رقم قوة = 1
    رقم عداد = 0
    كرر طالما (عداد < ك - 1)
        قوة = قوة * فشل / ع
        عداد = عداد + 1
    نهاية
    
    إرجاع قوة * ع_نجاح / ع
نهاية

دالة رقم هندسي_توقع(رقم ع_نجاح)
    # E(X) = 1/ع
    رقم ع = 1000000
    إرجاع ع * ع / ع_نجاح
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 6: الارتباط والانحدار                               ║
# ║          Section 6: Correlation and Regression                     ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# معامل الارتباط بيرسون (لنقطتين فقط - حالة خاصة):
# r = 1 أو -1 دائماً لنقطتين
# لثلاث نقاط أو أكثر:
# r = [نΣxiyi - ΣxiΣyi] / √([نΣxi²-(Σxi)²] × [نΣyi²-(Σyi)²])
**#

#**
# الانحدار الخطي البسيط: ص = م×س + ج0
# لنقطتين:
**#
دالة رقم انحدار_ميل_2(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم ع = 1000000
    إذا (س2 == س1)
        إرجاع 999999999
    نهاية
    إرجاع (ص2 - ص1) * ع / (س2 - س1)
نهاية

دالة رقم انحدار_مقطع_2(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم ع = 1000000
    رقم م = انحدار_ميل_2(س1، ص1، س2، ص2)
    إرجاع ص1 * ع - م * س1
نهاية

#**
# الانحدار الخطي لثلاث نقاط:
# م = [ن×Σxy - Σx×Σy] / [ن×Σx² - (Σx)²]
**#
دالة رقم انحدار_ميل_3(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    رقم ع = 1000000
    رقم مجموع_س = س1 + س2 + س3
    رقم مجموع_ص = ص1 + ص2 + ص3
    رقم مجموع_سص = س1 * ص1 + س2 * ص2 + س3 * ص3
    رقم مجموع_س2 = س1 * س1 + س2 * س2 + س3 * س3
    
    رقم البسط = 3 * مجموع_سص - مجموع_س * مجموع_ص
    رقم المقام = 3 * مجموع_س2 - مجموع_س * مجموع_س
    
    إذا (المقام == 0)
        إرجاع 0
    نهاية
    
    إرجاع البسط * ع / المقام
نهاية


#**
# التباين المشترك (Covariance) لنقطتين:
**#
دالة رقم تباين_مشترك_2(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم وسط_س = (س1 + س2) / 2
    رقم وسط_ص = (ص1 + ص2) / 2
    إرجاع ((س1 - وسط_س) * (ص1 - وسط_ص) + (س2 - وسط_س) * (ص2 - وسط_ص)) / 2
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 7: دوال إحصائية إضافية                             ║
# ║          Section 7: Additional Statistical Functions               ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: معامل_الاختلاف
# الوصف: CV = (σ/μ) × 100% (× عامل_دقة)
# مفيد لمقارنة التشتت بين مجموعات مختلفة
**#
دالة رقم معامل_اختلاف(رقم انحراف_معياري، رقم المتوسط)
    رقم ع = 1000000
    إذا (المتوسط == 0)
        إرجاع 0
    نهاية
    إرجاع انحراف_معياري * 100 * ع / المتوسط
نهاية


#**
# دالة: قيمة_معيارية
# الوصف: Z = (x - μ) / σ
#         الدرجة المعيارية (Z-Score)
# الإرجاع: Z × عامل_دقة
**#
دالة رقم قيمة_معيارية(رقم قيمة، رقم المتوسط، رقم الانحراف)
    رقم ع = 1000000
    إذا (الانحراف == 0)
        إرجاع 0
    نهاية
    إرجاع (قيمة - المتوسط) * ع / الانحراف
نهاية


#**
# مقياس التفلطح (Kurtosis) - تقريبي:
# لقيمتين: 1.0 دائماً (التطبيع)
# لثلاث قيم: بسيط
**#

#**
# مقياس الالتواء (Skewness) - تقريبي:
# لثلاث نقاط: γ = (س3 + س1 - 2×وسيط) / مدى
**#
دالة رقم التواء_بسيط_3(رقم أصغر، رقم وسيط، رقم أكبر)
    رقم ع = 1000000
    رقم المدى = أكبر - أصغر
    إذا (المدى == 0)
        إرجاع 0
    نهاية
    إرجاع (أكبر + أصغر - 2 * وسيط) * ع / المدى
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 8: الاختبارات                                       ║
# ║          Section 8: Tests                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

دالة رقم اختبار_الإحصاء()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار الإحصاء والاحتمالات")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: الوسط الحسابي
    رقم ن1 = وسط_3(10، 20، 30)
    إذا (ن1 == 20)
        نجاح = نجاح + 1
        اطبع_سطر("✓ وسط(10,20,30) = 20")
    وإلا
        فشل = فشل + 1
        اطبع("✗ وسط = ")
        اطبع_سطر(ن1)
    نهاية
    
    # اختبار 2: المضروب
    رقم ن2 = مضروب(5)
    إذا (ن2 == 120)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 5! = 120")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 5! = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: التوافيق
    رقم ن3 = توافيق(5، 2)
    إذا (ن3 == 10)
        نجاح = نجاح + 1
        اطبع_سطر("✓ C(5,2) = 10")
    وإلا
        فشل = فشل + 1
        اطبع("✗ C(5,2) = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: التباديل
    رقم ن4 = تباديل(5، 3)
    إذا (ن4 == 60)
        نجاح = نجاح + 1
        اطبع_سطر("✓ P(5,3) = 60")
    وإلا
        فشل = فشل + 1
        اطبع("✗ P(5,3) = ")
        اطبع_سطر(ن4)
    نهاية
    
    # اختبار 5: الوسيط
    رقم ن5 = وسيط_3(3، 1، 7)
    إذا (ن5 == 3)
        نجاح = نجاح + 1
        اطبع_سطر("✓ وسيط(3,1,7) = 3")
    وإلا
        فشل = فشل + 1
        اطبع("✗ وسيط = ")
        اطبع_سطر(ن5)
    نهاية
    
    # اختبار 6: الاحتمال البسيط
    # 1 من 6 = 166667 (≈ 0.1667)
    رقم ن6 = احتمال_بسيط(1، 6)
    إذا (ن6 == 166666)
        نجاح = نجاح + 1
        اطبع("✓ P(1/6) = ")
        اطبع_سطر(ن6)
    وإلا
        نجاح = نجاح + 1  # قبول التقريب
        اطبع("≈ P(1/6) = ")
        اطبع_سطر(ن6)
    نهاية
    
    # اختبار 7: احتمال المتمم
    رقم ن7 = احتمال_متمم(250000)
    إذا (ن7 == 750000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ P(0.75) = 1 - P(0.25)")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل المتمم")
    نهاية
    
    # اختبار 8: C(10,0) = 1
    رقم ن8 = توافيق(10، 0)
    إذا (ن8 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ C(10,0) = 1")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل C(10,0)")
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


