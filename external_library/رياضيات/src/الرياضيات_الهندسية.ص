#**
# دالة: ديكارتي_إلى_قطبي_نصف_قطر
# الوصف: r = √(x² + y²) (نصف القطر في الإحداثيات القطبية)
# المعاملات:
#   - س: الإحداثي الأفقي
#   - ص: الإحداثي الرأسي
# الإرجاع: نصف القطر (مكبر ×1000)
**#
دالة رقم ديكارتي_إلى_قطبي_نصف_قطر(رقم س، رقم ص)
    متغير رقم مربع = س * س + ص * ص
    # جذر تربيعي بنيوتن
    إذا (مربع <= 0)
        إرجاع 0
    نهاية
    
    متغير رقم تخمين = 0
    إذا (مربع > 10000)
        تخمين = مربع / 100
    وإلا
        تخمين = مربع
    نهاية
    إذا (تخمين <= 0)
        تخمين = 1
    نهاية
    
    متغير رقم ع = 0
    طالما (ع < 25)
        تخمين = (تخمين + مربع / تخمين) / 2
        ع = ع + 1
    نهاية
    
    إرجاع تخمين
نهاية


