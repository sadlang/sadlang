نهاية


#**
# دالة: نسبة_إشارة_ضوضاء_ديسيبل
# الوصف: SNR (dB) = 10 * log10(طاقة_إشارة / طاقة_ضوضاء)
#         نستخدم تقريب لوغاريتمي
# المعاملات:
#   - طاقة_إشارة، طاقة_ضوضاء
# الإرجاع: SNR مكبر ×100 (بالديسيبل)
**#
دالة رقم نسبة_إشارة_ضوضاء_ديسيبل(رقم طاقة_إشارة، رقم طاقة_ضوضاء)
    إذا (طاقة_ضوضاء <= 0)
        إرجاع 9999  # لا نهاية
    نهاية
    إذا (طاقة_إشارة <= 0)
        إرجاع 0 - 9999
    نهاية
    
    # تقريب log10 بسيط
    متغير رقم نسبة = (طاقة_إشارة * 1000) / طاقة_ضوضاء
    
    # log10(ratio/1000) * 10 * 100
    # نقدر log10 عبر عد الأرقام
    متغير رقم عد = 0
    متغير رقم ن = نسبة
    طالما (ن >= 10)
        ن = ن / 10
        عد = عد + 1
    نهاية
    
    # log10(ratio) ≈ عد - 3 (لأن النسبة مكبرة ×1000)
    إرجاع (عد - 3) * 1000
نهاية


