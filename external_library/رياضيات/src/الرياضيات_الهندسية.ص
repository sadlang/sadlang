نهاية


#**
# دالة: متحكم_تفاضلي_خطوة
# الوصف: D Controller: u_D = Kd * (e - e_prev) / dt
# المعاملات:
#   - خطأ: الخطأ الحالي
#   - خطأ_سابق: الخطأ السابق
#   - دت_×1000: فترة العينات
#   - كد_×1000: Kd (مكبر ×1000)
# الإرجاع: إشارة التحكم التفاضلية (×1000)
**#
دالة رقم متحكم_تفاضلي_خطوة(رقم خطأ، رقم خطأ_سابق، رقم دت_×1000، رقم كد_×1000)
    إذا (دت_×1000 == 0)
        إرجاع 0
    نهاية
    متغير رقم مشتقة = ((خطأ - خطأ_سابق) * 1000) / دت_×1000
    إرجاع (كد_×1000 * مشتقة) / 1000
نهاية


#**
# دالة: متحكم_بي_آي_دي
# الوصف: PID Controller الكامل
#         u = Kp*e + Ki*∫e*dt + Kd*de/dt
# المعاملات:
#   - خطأ: الخطأ الحالي
#   - خطأ_سابق: الخطأ السابق
#   - تكامل_سابق: التكامل التراكمي (×1000)
#   - كب_×1000، كت_×1000، كد_×1000: معاملات PID
#   - دت_×1000: فترة العينات
# الإرجاع: إشارة التحكم الإجمالية (×1000)
**#
دالة رقم متحكم_بي_آي_دي(رقم خطأ، رقم خطأ_سابق، رقم تكامل_خطأ، رقم كب_×1000، رقم كت_×1000، رقم كد_×1000، رقم دت_×1000)
    # الجزء التناسبي
    متغير رقم ت_تناسبي = (كب_×1000 * خطأ) / 1000
    
    # الجزء التكاملي
    متغير رقم ت_تكاملي = (كت_×1000 * تكامل_خطأ) / 1000
    
    # الجزء التفاضلي
    متغير رقم ت_تفاضلي = 0
    إذا (دت_×1000 > 0)
        ت_تفاضلي = (كد_×1000 * (خطأ - خطأ_سابق) * 1000) / (دت_×1000 * 1000)
    نهاية
    
    إرجاع ت_تناسبي + ت_تكاملي + ت_تفاضلي
نهاية


