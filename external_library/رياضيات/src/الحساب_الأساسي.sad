#** 
# دالة: اطبع_نتيجة
# الوصف: طباعة نتيجة عملية حسابية بتنسيق جميل
# المعاملات: اسم العملية، النتيجة
**#
دالة رقم اطبع_نتيجة(نص عملية، رقم نتيجة)
    اطبع("[حساب] ")
    اطبع(عملية)
    اطبع(" = ")
    اطبع_سطر(نتيجة)
    إرجاع نتيجة
نهاية


#** 
# دالة: اطبع_بدقة
# الوصف: طباعة عدد بدقة 6 أرقام عشرية
# المعاملات: اسم، قيمة (× 10^6)
**#
دالة رقم اطبع_بدقة(نص اسم، رقم قيمة)
    رقم صحيح = قيمة / 1000000
    رقم كسري = قيمة % 1000000
    إذا (كسري < 0)
        كسري = 0 - كسري
    نهاية
    اطبع(اسم)
    اطبع(" = ")
    اطبع(صحيح)
    اطبع(".")
    
    # طباعة الأصفار البادئة
    إذا (كسري < 100000)
        اطبع("0")
    نهاية
    إذا (كسري < 10000)
        اطبع("0")
    نهاية
    إذا (كسري < 1000)
        اطبع("0")
    نهاية
    إذا (كسري < 100)
        اطبع("0")
    نهاية
    إذا (كسري < 10)
        اطبع("0")
    نهاية
    اطبع_سطر(كسري)
    إرجاع 0
نهاية


#** 
# دالة: اطبع_كسر
# الوصف: طباعة كسر بصيغة بسط/مقام
# المعاملات: اسم، كسر مُعبأ
**#
دالة رقم اطبع_كسر(نص اسم، رقم ك)
    رقم ب = بسط_كسر(ك)
    رقم م = مقام_كسر(ك)
    اطبع(اسم)
    اطبع(" = ")
    اطبع(ب)
    اطبع("/")
    اطبع_سطر(م)
    إرجاع 0
نهاية


#** 
# دالة: اختبار_صحة
# الوصف: التحقق من صحة نتيجة (للاختبارات)
# المعاملات:
#   - اسم: اسم الاختبار
#   - فعلي: الناتج الفعلي
#   - متوقع: الناتج المتوقع
# الإرجاع: 1 إذا نجح، 0 إذا فشل
**#
دالة رقم اختبار_صحة(نص اسم، رقم فعلي، رقم متوقع)
    إذا (فعلي == متوقع)
        اطبع("✓ نجح: ")
        اطبع_سطر(اسم)
        إرجاع 1
    وإلا
        اطبع("✗ فشل: ")
        اطبع(اسم)
        اطبع(" (متوقع: ")
        اطبع(متوقع)
        اطبع("، فعلي: ")
        اطبع(فعلي)
        اطبع_سطر(")")
        إرجاع 0
    نهاية
نهاية


#** 
# دالة: اطبع_ثنائي
# الوصف: طباعة عدد بالتمثيل الثنائي
**#
دالة رقم اطبع_ثنائي(نص اسم، رقم ن)
    اطبع(اسم)
    اطبع(" = 0b")
    اطبع_سطر(عشري_إلى_ثنائي(ن))
    إرجاع 0
نهاية


#** 
# دالة: اطبع_ثماني
# الوصف: طباعة عدد بالتمثيل الثماني
**#
دالة رقم اطبع_ثماني(نص اسم، رقم ن)
    اطبع(اسم)
    اطبع(" = 0o")
    اطبع_سطر(عشري_إلى_ثماني(ن))
    إرجاع 0
نهاية


#** 
# دالة: تشغيل_اختبارات_الحساب
# الوصف: تشغيل مجموعة شاملة من الاختبارات للتحقق من صحة
#         جميع الدوال في هذا الملف
**#
دالة رقم تشغيل_اختبارات_الحساب()
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبارات ملف الحساب الأساسي")
    اطبع_سطر("═══════════════════════════════════════════")
    
    رقم نجاح = 0
    رقم فشل = 0
    
    # اختبارات الجمع
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات الجمع ---")
    إذا (اختبار_صحة("جمع(5، 3)", جمع(5، 3)، 8) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("جمع(-10، 7)", جمع(0 - 10، 7)، 0 - 3) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("جمع_تراكمي(100)", جمع_تراكمي(100)، 5050) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("جمع_مربعات(10)", جمع_مربعات(10)، 385) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات الطرح
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات الطرح ---")
    إذا (اختبار_صحة("طرح(10، 3)", طرح(10، 3)، 7) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("فرق_مطلق(5، 8)", فرق_مطلق(5، 8)، 3) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات الضرب
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات الضرب ---")
    إذا (اختبار_صحة("ضرب(6، 7)", ضرب(6، 7)، 42) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("ضرب_روسي(13، 5)", ضرب_روسي(13، 5)، 65) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات القسمة
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات القسمة ---")
    إذا (اختبار_صحة("قسمة(10، 3)", قسمة(10، 3)، 3) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("قسمة_سقف(7، 2)", قسمة_سقف(7، 2)، 4) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات القوى
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات القوى ---")
    إذا (اختبار_صحة("قوة(2، 10)", قوة(2، 10)، 1024) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("مربع(7)", مربع(7)، 49) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("مكعب(3)", مكعب(3)، 27) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات الجذور
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات الجذور ---")
    إذا (اختبار_صحة("جذر_تربيعي(25)", جذر_تربيعي(25)، 5) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("جذر_تربيعي(144)", جذر_تربيعي(144)، 12) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("جذر_تكعيبي(27)", جذر_تكعيبي(27)، 3) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("هل_مربع_كامل(16)", هل_مربع_كامل(16)، 1) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات GCD و LCM
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات القاسم والمضاعف ---")
    إذا (اختبار_صحة("قاسم_مشترك_أكبر(12، 8)", قاسم_مشترك_أكبر(12، 8)، 4) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("مضاعف_مشترك_أصغر(4، 6)", مضاعف_مشترك_أصغر(4، 6)، 12) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات العاملي والتوافيق
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات العاملي والتوافيق ---")
    إذا (اختبار_صحة("عاملي(5)", عاملي(5)، 120) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("توافيق(5، 2)", توافيق(5، 2)، 10) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("تباديل(5، 2)", تباديل(5، 2)، 20) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات الأعداد الخاصة
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات الأعداد الخاصة ---")
    إذا (اختبار_صحة("فيبوناتشي(10)", فيبوناتشي(10)، 55) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("كاتالان(4)", كاتالان(4)، 14) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("عدد_مثالي(28)", عدد_مثالي(28)، 1) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات التحويل
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات تحويل الأنظمة ---")
    إذا (اختبار_صحة("عشري_إلى_ثنائي(10)", عشري_إلى_ثنائي(10)، 1010) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("ثنائي_إلى_عشري(1010)", ثنائي_إلى_عشري(1010)، 10) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    
    # اختبارات أدوات الأعداد
    اطبع_سطر("")
    اطبع_سطر("--- اختبارات أدوات الأعداد ---")
    إذا (اختبار_صحة("عدد_الخانات(12345)", عدد_الخانات(12345)، 5) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("مجموع_خانات(12345)", مجموع_خانات(12345)، 15) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("عكس_عدد(12345)", عكس_عدد(12345)، 54321) == 1)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية
    إذا (اختبار_صحة("هل_متماثل(12321)", هل_متماثل(12321)، 1) == 1)
