#** 
# دالة: تجزئة_بسيطة
# الوصف: دالة تجزئة بسيطة (Simple Hash)
#         تستخدم لتوزيع الأعداد بشكل متساوٍ
# المعاملات: مفتاح، حجم_جدول
# الإرجاع: قيمة التجزئة (0 إلى حجم_جدول - 1)
**#
دالة رقم تجزئة_بسيطة(رقم مفتاح، رقم حجم_جدول)
    إذا (حجم_جدول <= 0)
        إرجاع 0
    نهاية
    رقم ق = مفتاح
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    # خلط البتات
    ق = ((ق * 2654435761) / 1) % 2147483647
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    إرجاع ق % حجم_جدول
نهاية


#** 
# دالة: تجزئة_FNV
# الوصف: محاكاة خوارزمية FNV-1a للتجزئة
#         (Fowler-Noll-Vo hash function)
# المعاملات: قيمة
# الإرجاع: قيمة التجزئة
**#
دالة رقم تجزئة_FNV(رقم قيمة)
    رقم تجزئة = 2166136261
    
    # معالجة كل بايت
    رقم مؤقت = قيمة
    إذا (مؤقت < 0)
        مؤقت = 0 - مؤقت
    نهاية
    
    رقم ع = 0
    طالما (ع < 4)
        رقم بايت = مؤقت % 256
        # XOR مع البايت (محاكاة)
        تجزئة = تجزئة + بايت
        تجزئة = تجزئة * 16777619
        تجزئة = تجزئة % 2147483647
        مؤقت = مؤقت / 256
        ع = ع + 1
    نهاية
    
    إذا (تجزئة < 0)
        تجزئة = 0 - تجزئة
    نهاية
    إرجاع تجزئة
نهاية


#** 
# دالة: بتات_دوران_يسار
# الوصف: محاكاة دوران البتات لليسار (Rotate Left)
# المعاملات: قيمة، عدد_البتات
# الإرجاع: القيمة بعد الدوران
**#
دالة رقم بتات_دوران_يسار(رقم قيمة، رقم عدد)
    رقم ع = 0
    طالما (ع < عدد)
        # محاكاة: ضرب في 2 (إزاحة يسار) مع إعادة البت العلوي
        رقم بت_علوي = 0
        إذا (قيمة > 1073741823)
            بت_علوي = 1
            قيمة = قيمة - 1073741824
        نهاية
        قيمة = قيمة * 2 + بت_علوي
        ع = ع + 1
    نهاية
    إرجاع قيمة
نهاية


