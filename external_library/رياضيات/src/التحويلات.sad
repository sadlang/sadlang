#**
# دالة: عشري_إلى_ثنائي
# الوصف: تحويل عدد عشري إلى ثنائي (إرجاع رقم بأرقام 0 و 1)
#         يعمل حتى 20 بت
**#
دالة رقم عشري_ثنائي(رقم ن)
    إذا (ن == 0)
        إرجاع 0
    نهاية
    
    رقم القيمة = ن
    إذا (القيمة < 0)
        القيمة = 0 - القيمة
    نهاية
    
    رقم النتيجة = 0
    رقم الموضع = 1
    
    كرر طالما (القيمة > 0)
        رقم باقي = القيمة - (القيمة / 2) * 2
        النتيجة = النتيجة + باقي * الموضع
        القيمة = القيمة / 2
        الموضع = الموضع * 10
    نهاية
    
    إرجاع النتيجة
نهاية


#**
# دالة: ثنائي_إلى_عشري
# الوصف: تحويل عدد ثنائي (مكتوب بـ 0/1) إلى عشري
**#
دالة رقم ثنائي_عشري(رقم ث)
    رقم القيمة = ث
    رقم النتيجة = 0
    رقم الأس = 1
    
    كرر طالما (القيمة > 0)
        رقم رقم_أخير = القيمة - (القيمة / 10) * 10
        النتيجة = النتيجة + رقم_أخير * الأس
        الأس = الأس * 2
        القيمة = القيمة / 10
    نهاية
    
    إرجاع النتيجة
نهاية


#**
# دالة: عشري_إلى_ثماني
# الوصف: تحويل عدد عشري إلى ثماني
**#
دالة رقم عشري_ثماني(رقم ن)
    إذا (ن == 0)
        إرجاع 0
    نهاية
    
    رقم القيمة = ن
    إذا (القيمة < 0)
        القيمة = 0 - القيمة
    نهاية
    
    رقم النتيجة = 0
    رقم الموضع = 1
    
    كرر طالما (القيمة > 0)
        رقم باقي = القيمة - (القيمة / 8) * 8
        النتيجة = النتيجة + باقي * الموضع
        القيمة = القيمة / 8
        الموضع = الموضع * 10
    نهاية
    
    إرجاع النتيجة
نهاية


#**
# دالة: ثماني_إلى_عشري
**#
دالة رقم ثماني_عشري(رقم ث)
    رقم القيمة = ث
    رقم النتيجة = 0
    رقم الأس = 1
    
    كرر طالما (القيمة > 0)
        رقم رقم_أخير = القيمة - (القيمة / 10) * 10
        النتيجة = النتيجة + رقم_أخير * الأس
        الأس = الأس * 8
        القيمة = القيمة / 10
    نهاية
    
    إرجاع النتيجة
نهاية


