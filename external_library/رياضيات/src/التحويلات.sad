    إرجاع (ف - 32) * 5 * 1000000 / 9
نهاية

#** سيلسيوس → كلفن: ك = س + 273 **#
دالة رقم سيلسيوس_كلفن(رقم س)
    إرجاع س + 273
نهاية

#** كلفن → سيلسيوس **#
دالة رقم كلفن_سيلسيوس(رقم ك)
    إرجاع ك - 273
نهاية


