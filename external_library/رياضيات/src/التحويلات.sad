#**
# دالة: ديكارتي_إلى_قطبي_ر
# الوصف: حساب ر = √(س² + ص²) من إحداثيات ديكارتية
#         المدخلات والنتيجة × عامل_دقة
**#
دالة رقم ديكارتي_ر(رقم س، رقم ص)
    رقم مج = س * س + ص * ص
    
    # √مج بتقريب نيوتن
    رقم ت = 1000
    إذا (مج > 1000000)
        ت = مج / 1000
    نهاية
    
    رقم ع = 0
    كرر طالما (ع < 25)
        إذا (ت > 0)
            ت = (ت + مج / ت) / 2
        نهاية
        ع = ع + 1
    نهاية
    
    إرجاع ت
نهاية


#**
# دالة: قطبي_إلى_ديكارتي_س
# الوصف: س = ر × جتا(θ)
#         ر × عامل، θ بالدرجات
#         النتيجة × عامل_دقة
**#
دالة رقم قطبي_س(رقم ر، رقم زاوية_درجات)
    # جتا(θ) بالتقريب - قيم محسوبة مسبقاً للزوايا الشائعة
    رقم جتا = 0
    
    إذا (زاوية_درجات == 0)
        جتا = 1000000
    نهاية
    إذا (زاوية_درجات == 30)
        جتا = 866025
    نهاية
    إذا (زاوية_درجات == 45)
        جتا = 707107
    نهاية
    إذا (زاوية_درجات == 60)
        جتا = 500000
    نهاية
    إذا (زاوية_درجات == 90)
        جتا = 0
    نهاية
    إذا (زاوية_درجات == 120)
        جتا = 0 - 500000
    نهاية
    إذا (زاوية_درجات == 135)
        جتا = 0 - 707107
    نهاية
    إذا (زاوية_درجات == 150)
        جتا = 0 - 866025
    نهاية
    إذا (زاوية_درجات == 180)
        جتا = 0 - 1000000
    نهاية
    إذا (زاوية_درجات == 210)
        جتا = 0 - 866025
    نهاية
    إذا (زاوية_درجات == 225)
        جتا = 0 - 707107
    نهاية
    إذا (زاوية_درجات == 240)
        جتا = 0 - 500000
    نهاية
    إذا (زاوية_درجات == 270)
        جتا = 0
    نهاية
    إذا (زاوية_درجات == 300)
        جتا = 500000
    نهاية
    إذا (زاوية_درجات == 315)
        جتا = 707107
    نهاية
    إذا (زاوية_درجات == 330)
        جتا = 866025
    نهاية
    إذا (زاوية_درجات == 360)
        جتا = 1000000
    نهاية
    
    إرجاع ر * جتا / 1000000
نهاية


