#**
# دالة: قيمة_مطلقة
**#
دالة رقم قيمة_مطلقة(رقم ن)
    إذا (ن < 0)
        إرجاع 0 - ن
    نهاية
    إرجاع ن
نهاية


#**
# دالة: إشارة
# الوصف: دالة الإشارة: sgn(ن)
#   = 1 إذا ن > 0
#   = 0 إذا ن = 0
#   = -1 إذا ن < 0
**#
دالة رقم إشارة(رقم ن)
    إذا (ن > 0)
        إرجاع 1
    نهاية
    إذا (ن < 0)
        إرجاع 0 - 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: دالة_سلّم (Heaviside step)
# الوصف: H(ن) = 0 إذا ن < 0, = 1 إذا ن ≥ 0
**#
دالة رقم سلم_هيفيسايد(رقم ن)
    إذا (ن < 0)
        إرجاع 0
    نهاية
    إرجاع 1
نهاية


#**
# دالة: تقريب_للأعلى
# الوصف: تقريب لأقرب مضاعف أعلى
#         مثال: تقريب 7 لأقرب مضاعف من 5 = 10
**#
دالة رقم تقريب_أعلى(رقم ن، رقم مضاعف)
    إذا (مضاعف <= 0)
        إرجاع ن
    نهاية
    رقم باقي = ن - (ن / مضاعف) * مضاعف
    إذا (باقي == 0)
        إرجاع ن
    نهاية
    إرجاع ن + مضاعف - باقي
نهاية


#**
# دالة: تقريب_للأسفل
**#
دالة رقم تقريب_أسفل(رقم ن، رقم مضاعف)
    إذا (مضاعف <= 0)
        إرجاع ن
    نهاية
    إرجاع (ن / مضاعف) * مضاعف
نهاية


#**
# دالة: قص (clamp)
# الوصف: تقييد القيمة بين حد أدنى وحد أعلى
**#
دالة رقم قص(رقم قيمة، رقم أدنى، رقم أعلى)
    إذا (قيمة < أدنى)
        إرجاع أدنى
    نهاية
    إذا (قيمة > أعلى)
        إرجاع أعلى
    نهاية
    إرجاع قيمة
نهاية


#**
# دالة: ربط_خطي (lerp)
# الوصف: الاستيفاء الخطي بين أ و ب
#         النتيجة = أ + ت × (ب - أ)
#         ت × عامل_دقة (0=عند أ، 1000000=عند ب)
#         النتيجة × عامل_دقة
**#
دالة رقم ربط_خطي(رقم أ، رقم ب، رقم ت_مقياس)
    إرجاع أ * 1000000 + ت_مقياس * (ب - أ)
نهاية


#**
# دالة: تحويل_نطاق
# الوصف: إعادة تعيين قيمة من نطاق [أ1، ب1] إلى [أ2، ب2]
#         النتيجة × عامل_دقة
**#
دالة رقم تحويل_نطاق(رقم قيمة، رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إذا (ب1 == أ1)
        إرجاع أ2 * 1000000
    نهاية
    إرجاع أ2 * 1000000 + (قيمة - أ1) * (ب2 - أ2) * 1000000 / (ب1 - أ1)
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 5: الاختبارات                                       ║
# ║          Section 5: Tests                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

دالة رقم اختبار_التحويلات()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار التحويلات")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: متر → سم
    رقم ن1 = متر_إلى_سم(5)
    إذا (ن1 == 500)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 5 م = 500 سم")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 5 م = ")
        اطبع_سطر(ن1)
    نهاية
    
    # اختبار 2: كغ → رطل
    رقم ن2 = كغ_إلى_رطل(1)
    # المتوقع: 2204620 (2.20462 × 10^6)
    إذا (ن2 == 2204620)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 1 كغ = 2.20462 رطل")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 1 كغ = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: سيلسيوس → فهرنهايت
    # 100°C = 212°F
    رقم ن3 = سيلسيوس_فهرنهايت(100)
    إذا (ن3 == 212000000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 100°C = 212°F")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 100°C = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: عشري → ثنائي
    # 10 = 1010
    رقم ن4 = عشري_ثنائي(10)
    إذا (ن4 == 1010)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 10₁₀ = 1010₂")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 10₁₀ = ")
        اطبع_سطر(ن4)
    نهاية
    
    # اختبار 5: ثنائي → عشري
    رقم ن5 = ثنائي_عشري(1010)
    إذا (ن5 == 10)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 1010₂ = 10₁₀")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 1010₂ = ")
        اطبع_سطر(ن5)
    نهاية
    
    # اختبار 6: ساعة → ثانية
    رقم ن6 = ساعة_إلى_ثانية(2)
    إذا (ن6 == 7200)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 2 ساعة = 7200 ثانية")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 2 ساعة = ")
        اطبع_سطر(ن6)
    نهاية
    
    # اختبار 7: تدوير 90°
    رقم س = تدوير_س(3، 4، 90)
    رقم ص = تدوير_ص(3، 4، 90)
    إذا (س == 0 - 4)
        إذا (ص == 3)
            نجاح = نجاح + 1
            اطبع_سطر("✓ تدوير(3,4) بـ 90° = (-4,3)")
        وإلا
            فشل = فشل + 1
            اطبع_سطر("✗ تدوير خاطئ")
        نهاية
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ تدوير خاطئ")
    نهاية
    
    # اختبار 8: قص
    رقم ن8 = قص(15، 0، 10)
    إذا (ن8 == 10)
        نجاح = نجاح + 1
        اطبع_سطر("✓ قص(15, 0, 10) = 10")
    وإلا
        فشل = فشل + 1
        اطبع("✗ قص = ")
        اطبع_سطر(ن8)
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


