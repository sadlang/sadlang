        جا = 866025
    نهاية
    إذا (زاوية_درجات == 90)
        جا = 1000000
    نهاية
    إذا (زاوية_درجات == 120)
        جا = 866025
    نهاية
    إذا (زاوية_درجات == 135)
        جا = 707107
    نهاية
    إذا (زاوية_درجات == 150)
        جا = 500000
    نهاية
    إذا (زاوية_درجات == 180)
        جا = 0
    نهاية
    إذا (زاوية_درجات == 210)
        جا = 0 - 500000
    نهاية
    إذا (زاوية_درجات == 225)
        جا = 0 - 707107
    نهاية
    إذا (زاوية_درجات == 240)
        جا = 0 - 866025
    نهاية
    إذا (زاوية_درجات == 270)
        جا = 0 - 1000000
    نهاية
    إذا (زاوية_درجات == 300)
        جا = 0 - 866025
    نهاية
    إذا (زاوية_درجات == 315)
        جا = 0 - 707107
    نهاية
    إذا (زاوية_درجات == 330)
        جا = 0 - 500000
    نهاية
    إذا (زاوية_درجات == 360)
        جا = 0
    نهاية
    
    إرجاع ر * جا / 1000000
نهاية


#**
# دالة: تدوير_نقطة_س
# الوصف: تدوير نقطة بزاوية θ حول نقطة الأصل
#         س' = س×جتا(θ) - ص×جا(θ)
#         يعمل مع الزوايا القياسية (0°, 90°, 180°, 270°)
**#
دالة رقم تدوير_س(رقم س، رقم ص، رقم زاوية)
    إذا (زاوية == 90)
        إرجاع 0 - ص
    نهاية
    إذا (زاوية == 180)
        إرجاع 0 - س
    نهاية
    إذا (زاوية == 270)
        إرجاع ص
    نهاية
    إرجاع س
نهاية

دالة رقم تدوير_ص(رقم س، رقم ص، رقم زاوية)
    إذا (زاوية == 90)
        إرجاع س
    نهاية
    إذا (زاوية == 180)
        إرجاع 0 - ص
    نهاية
    إذا (زاوية == 270)
        إرجاع 0 - س
    نهاية
    إرجاع ص
نهاية


