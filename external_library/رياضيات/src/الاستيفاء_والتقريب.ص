#**
# دالة: استيفاء_المسافة_المعكوسة
# الوصف: استيفاء بأوزان المسافة المعكوسة (IDW)
#         w_i = 1/d_i^p
#         f(x) = Σ w_i*f_i / Σ w_i
#         لنقطتين بـ p=2
# المعاملات:
#   - ف1، ف2: القيمتان عند النقطتين
#   - م1، م2: مربع المسافة من كل نقطة
# الإرجاع: القيمة المستوفاة (مكبرة ×1000)
**#
دالة رقم استيفاء_المسافة_المعكوسة(رقم ف1، رقم ف2، رقم م1، رقم م2)
    إذا (م1 == 0)
        إرجاع ف1 * 1000
    نهاية
    إذا (م2 == 0)
        إرجاع ف2 * 1000
    نهاية
    
    # w1 = 1/d1², w2 = 1/d2²
    # f = (f1/d1² + f2/d2²) / (1/d1² + 1/d2²)
    # = (f1*d2² + f2*d1²) / (d1² + d2²)
    متغير رقم بسط = ف1 * م2 + ف2 * م1
    متغير رقم مقام = م1 + م2
    
    إذا (مقام == 0)
        إرجاع (ف1 + ف2) * 500
    نهاية
    
    إرجاع (بسط * 1000) / مقام
نهاية


