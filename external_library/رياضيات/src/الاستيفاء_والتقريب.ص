# الوصف: تحويل عقدة تشيبيشيف من [-1,1] إلى [a,b]
#         x_[a,b] = (b-a)/2 * x_[-1,1] + (a+b)/2
# المعاملات:
#   - عقدة: العقدة على [-1,1] (مكبرة ×1000)
#   - أ: بداية الفترة
#   - ب: نهاية الفترة
# الإرجاع: العقدة على [a,b] (مكبرة ×1000)
**#
دالة رقم تحويل_تشيبيشيف_لفترة(رقم عقدة، رقم أ، رقم ب)
    # x = (b-a)/2 * t + (a+b)/2 (مع مراعاة التكبير)
    متغير رقم منتصف = (أ + ب) * 500
    متغير رقم نصف_طول = (ب - أ) * 500
    إرجاع (نصف_طول * عقدة) / 1000000 + منتصف
