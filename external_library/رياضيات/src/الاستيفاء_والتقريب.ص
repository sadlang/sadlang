#** ─────────────────────────────────────────────────────────────────
# التقريب بالمربعات الصغرى:
# ───────────────────────
# على عكس الاستيفاء الذي يمر بجميع النقاط بالضبط،
# المربعات الصغرى تجد أفضل خط (أو منحنى) يمر "قريباً"
# من جميع النقاط بحيث يُقلل مجموع مربعات الأخطاء.
#
# هذا مفيد عندما:
# 1. البيانات تحتوي على ضوضاء
# 2. عدد النقاط أكبر بكثير من درجة كثير الحدود
# 3. نريد نموذجاً بسيطاً يصف الاتجاه العام
#
# أنواع:
# - خطي: y = ax + b
# - تربيعي: y = ax² + bx + c
# - أسي: y = a * e^(bx)
# - قوة: y = a * x^b
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: مربعات_صغرى_خطي_ميل_3
# الوصف: حساب ميل خط المربعات الصغرى لـ 3 نقاط
#         m = (3*Σxy - Σx*Σy) / (3*Σx² - (Σx)²)
# المعاملات: إحداثيات 3 نقاط
# الإرجاع: الميل مكبر ×1000
**#
دالة رقم مربعات_صغرى_خطي_ميل_3(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    متغير رقم مج_س = س1 + س2 + س3
    متغير رقم مج_ص = ص1 + ص2 + ص3
    متغير رقم مج_س_ص = س1*ص1 + س2*ص2 + س3*ص3
    متغير رقم مج_س2 = س1*س1 + س2*س2 + س3*س3
    
    متغير رقم بسط = 3 * مج_س_ص - مج_س * مج_ص
    متغير رقم مقام = 3 * مج_س2 - مج_س * مج_س
    
    إذا (مقام == 0)
        إرجاع 0
    نهاية
    
    إرجاع (بسط * 1000) / مقام
نهاية


#**
# دالة: مربعات_صغرى_خطي_تقاطع_3
# الوصف: حساب تقاطع خط المربعات الصغرى مع المحور y لـ 3 نقاط
#         b = (Σy - m*Σx) / n
**#
دالة رقم مربعات_صغرى_خطي_تقاطع_3(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    متغير رقم ميل = مربعات_صغرى_خطي_ميل_3(س1، ص1، س2، ص2، س3، ص3)
    متغير رقم مج_ص = ص1 + ص2 + ص3
    متغير رقم مج_س = س1 + س2 + س3
    إرجاع (مج_ص * 1000 - ميل * مج_س) / 3
نهاية


#**
# دالة: مربعات_صغرى_خطي_ميل_4
# الوصف: حساب ميل خط المربعات الصغرى لـ 4 نقاط
**#
دالة رقم مربعات_صغرى_خطي_ميل_4(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3، رقم س4، رقم ص4)
    متغير رقم مج_س = س1 + س2 + س3 + س4
    متغير رقم مج_ص = ص1 + ص2 + ص3 + ص4
    متغير رقم مج_س_ص = س1*ص1 + س2*ص2 + س3*ص3 + س4*ص4
    متغير رقم مج_س2 = س1*س1 + س2*س2 + س3*س3 + س4*س4
    
    متغير رقم بسط = 4 * مج_س_ص - مج_س * مج_ص
