#**
# دالة: جذر_متوسط_مربع_خطأ_3
# الوصف: RMSE لثلاث نقاط
#         = √(Σ(تقريب_i - حقيقي_i)² / n)
# المعاملات:
#   - خ1، خ2، خ3: الأخطاء (تقريب - حقيقي)
# الإرجاع: RMSE مكبر ×1000
**#
دالة رقم جذر_متوسط_مربع_خطأ_3(رقم خ1، رقم خ2، رقم خ3)
    متغير رقم مجموع_مربعات = خ1*خ1 + خ2*خ2 + خ3*خ3
    متغير رقم متوسط = مجموع_مربعات / 3
    
    # حساب الجذر
    إذا (متوسط <= 0)
        إرجاع 0
    نهاية
    
    متغير رقم تخمين = متوسط / 2
    إذا (تخمين <= 0)
        تخمين = 1
    نهاية
    متغير رقم ع = 0
    طالما (ع < 20)
        إذا (تخمين == 0)
            تخمين = 1
        نهاية
        تخمين = (تخمين + (متوسط * 1000000) / تخمين) / 2
        ع = ع + 1
    نهاية
    
    إرجاع تخمين
نهاية


