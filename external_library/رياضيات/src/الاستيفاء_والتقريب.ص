#** ─────────────────────────────────────────────────────────────────
# استيفاء لاغرانج:
# ────────────────
# بمعرفة n نقطة، نبني كثير حدود من الدرجة n-1
# يمر بجميع النقاط:
#
# P(x) = Σᵢ yᵢ * Lᵢ(x)
# حيث Lᵢ(x) = Πⱼ≠ᵢ (x - xⱼ) / (xᵢ - xⱼ)
#
# لـ 2 نقاط: خط مستقيم (مطابق للاستيفاء الخطي)
# لـ 3 نقاط: قطع مكافئ
# لـ 4 نقاط: كثير حدود تكعيبي
#
# المزايا:
# - يمر بجميع نقاط البيانات بالضبط
# - صيغة مباشرة (لا تحتاج حل معادلات)
#
# العيوب:
# - ظاهرة رانج: تذبذبات عند الحواف مع نقاط متساوية البعد
# - إضافة نقطة جديدة تتطلب إعادة الحساب بالكامل
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: لاغرانج_2نقاط
# الوصف: استيفاء لاغرانج بنقطتين (= استيفاء خطي)
#         P(x) = y0*(x-x1)/(x0-x1) + y1*(x-x0)/(x1-x0)
# المعاملات:
#   - س0، ص0: النقطة الأولى
#   - س1، ص1: النقطة الثانية
#   - س: النقطة المطلوبة
# الإرجاع: القيمة المستوفاة مكبرة ×1000
**#
دالة رقم لاغرانج_2نقاط(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س)
    متغير رقم فرق = س0 - س1
    إذا (فرق == 0)
        إرجاع (ص0 + ص1) * 500
    نهاية
    
    # L0 = (x-x1)/(x0-x1)
    متغير رقم ل0 = ((س - س1) * 1000) / فرق
    # L1 = (x-x0)/(x1-x0)
    متغير رقم ل1 = ((س - س0) * 1000) / (س1 - س0)
    
    إرجاع (ص0 * ل0 + ص1 * ل1) / 1000
نهاية


#**
# دالة: لاغرانج_3نقاط
# الوصف: استيفاء لاغرانج بثلاث نقاط (قطع مكافئ)
#         P(x) = y0*L0(x) + y1*L1(x) + y2*L2(x)
# المعاملات:
#   - س0..س2، ص0..ص2: النقاط الثلاث
#   - س: النقطة المطلوبة
# الإرجاع: القيمة المستوفاة مكبرة ×1000
**#
دالة رقم لاغرانج_3نقاط(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س)
    # L0 = (x-x1)(x-x2) / ((x0-x1)(x0-x2))
    متغير رقم مقام0 = (س0 - س1) * (س0 - س2)
    متغير رقم مقام1 = (س1 - س0) * (س1 - س2)
    متغير رقم مقام2 = (س2 - س0) * (س2 - س1)
    
    إذا (مقام0 == 0)
        إرجاع ص0 * 1000
    نهاية
    إذا (مقام1 == 0)
        إرجاع ص1 * 1000
    نهاية
    إذا (مقام2 == 0)
        إرجاع ص2 * 1000
    نهاية
    
    متغير رقم ل0 = ((س - س1) * (س - س2) * 1000) / مقام0
    متغير رقم ل1 = ((س - س0) * (س - س2) * 1000) / مقام1
    متغير رقم ل2 = ((س - س0) * (س - س1) * 1000) / مقام2
    
    إرجاع (ص0 * ل0 + ص1 * ل1 + ص2 * ل2) / 1000
نهاية


#**
# دالة: لاغرانج_4نقاط
# الوصف: استيفاء لاغرانج بأربع نقاط (تكعيبي)
# المعاملات:
#   - س0..س3، ص0..ص3: النقاط الأربع
#   - س: النقطة المطلوبة
# الإرجاع: القيمة المستوفاة مكبرة ×1000
**#
دالة رقم لاغرانج_4نقاط(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3، رقم س)
    متغير رقم م0 = (س0 - س1) * (س0 - س2)
    إذا (م0 == 0)
        م0 = 1
    نهاية
    متغير رقم م0ب = م0 * (س0 - س3)
    إذا (م0ب == 0)
        م0ب = 1
    نهاية
    
    متغير رقم م1 = (س1 - س0) * (س1 - س2)
    إذا (م1 == 0)
        م1 = 1
    نهاية
    متغير رقم م1ب = م1 * (س1 - س3)
    إذا (م1ب == 0)
        م1ب = 1
    نهاية
    
    متغير رقم م2 = (س2 - س0) * (س2 - س1)
    إذا (م2 == 0)
        م2 = 1
    نهاية
    متغير رقم م2ب = م2 * (س2 - س3)
    إذا (م2ب == 0)
        م2ب = 1
    نهاية
    
    متغير رقم م3 = (س3 - س0) * (س3 - س1)
    إذا (م3 == 0)
        م3 = 1
    نهاية
    متغير رقم م3ب = م3 * (س3 - س2)
    إذا (م3ب == 0)
        م3ب = 1
    نهاية
    
    # حساب بسط كل حد (مع تجنب الفيضان)
    متغير رقم ب0 = (س - س1) * (س - س2) / 1
    متغير رقم ل0 = (ب0 * (س - س3) * 1000) / م0ب
    
    متغير رقم ب1 = (س - س0) * (س - س2) / 1 
    متغير رقم ل1 = (ب1 * (س - س3) * 1000) / م1ب
    
    متغير رقم ب2 = (س - س0) * (س - س1) / 1
    متغير رقم ل2 = (ب2 * (س - س3) * 1000) / م2ب
    
    متغير رقم ب3 = (س - س0) * (س - س1) / 1
    متغير رقم ل3 = (ب3 * (س - س2) * 1000) / م3ب
    
    إرجاع (ص0 * ل0 + ص1 * ل1 + ص2 * ل2 + ص3 * ل3) / 1000
نهاية


