#**
# دالة: سبلاين_هيرميت_تقييم
# الوصف: استيفاء هيرميت - يستخدم القيم والمشتقات عند النقاط
#         H(x) = h00(t)*p0 + h10(t)*m0*(x1-x0) + h01(t)*p1 + h11(t)*m1*(x1-x0)
#         حيث h00 = 2t³-3t²+1, h10 = t³-2t²+t, h01 = -2t³+3t², h11 = t³-t²
# المعاملات:
#   - ص0: قيمة الدالة عند بداية الفترة
#   - ص1: قيمة الدالة عند نهاية الفترة
#   - م0: المشتقة عند بداية الفترة (مكبرة ×1000)
#   - م1: المشتقة عند نهاية الفترة (مكبرة ×1000)
#   - ت: المعامل 0≤t≤1 (مكبر ×1000)
#   - ه: طول الفترة (x1-x0)
# الإرجاع: القيمة مكبرة ×1000
**#
دالة رقم سبلاين_هيرميت_تقييم(رقم ص0، رقم ص1، رقم م0، رقم م1، رقم ت، رقم ه)
    # t² و t³ (مكبرين)
    متغير رقم ت2 = (ت * ت) / 1000
    متغير رقم ت3 = (ت2 * ت) / 1000
    
    # دوال هيرميت الأساسية (مكبرة ×1000)
    # h00 = 2t³ - 3t² + 1
    متغير رقم ه00 = 2 * ت3 - 3 * ت2 + 1000
    # h10 = t³ - 2t² + t
    متغير رقم ه10 = ت3 - 2 * ت2 + ت
    # h01 = -2t³ + 3t²
    متغير رقم ه01 = 0 - 2 * ت3 + 3 * ت2
    # h11 = t³ - t²
    متغير رقم ه11 = ت3 - ت2
    
    # H = h00*p0 + h10*m0*h + h01*p1 + h11*m1*h
    متغير رقم نتيجة = (ه00 * ص0 + ه01 * ص1) / 1 + (ه10 * م0 + ه11 * م1) * ه / 1000000
    إرجاع نتيجة
نهاية


