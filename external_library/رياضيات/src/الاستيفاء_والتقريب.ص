#**
# دالة: معامل_الارتباط_3
# الوصف: حساب مربع معامل الارتباط R² لـ 3 نقاط
#         يقيس جودة التوافق (0 = سيء، 1 = مثالي)
#         R² = 1 - SSE/SST
#         حيث SSE = مجموع مربعات الأخطاء
#         و SST = مجموع مربعات الانحرافات عن المتوسط
# المعاملات: إحداثيات 3 نقاط
# الإرجاع: R² مكبر ×1000 (0 إلى 1000)
**#
دالة رقم معامل_الارتباط_3(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    متغير رقم ميل = مربعات_صغرى_خطي_ميل_3(س1، ص1، س2، ص2، س3، ص3)
    متغير رقم تقاطع = مربعات_صغرى_خطي_تقاطع_3(س1، ص1، س2، ص2، س3، ص3)
    
    # المتوسط (مكبر ×1000)
    متغير رقم متوسط_ص = (ص1 + ص2 + ص3) * 1000 / 3
    
    # SST = Σ(yi - ȳ)² (مكبر)
    متغير رقم د1 = ص1 * 1000 - متوسط_ص
    متغير رقم د2 = ص2 * 1000 - متوسط_ص
    متغير رقم د3 = ص3 * 1000 - متوسط_ص
    متغير رقم سست = (د1 * د1 + د2 * د2 + د3 * د3) / 1000
    
    # SSE = Σ(yi - ŷi)² (مكبر)
    متغير رقم ت1 = ميل * س1 / 1000 + تقاطع / 1000
    متغير رقم ت2 = ميل * س2 / 1000 + تقاطع / 1000
    متغير رقم ت3 = ميل * س3 / 1000 + تقاطع / 1000
    
    متغير رقم خ1 = ص1 - ت1
    متغير رقم خ2 = ص2 - ت2
    متغير رقم خ3 = ص3 - ت3
    متغير رقم سسي = خ1 * خ1 + خ2 * خ2 + خ3 * خ3
    
    إذا (سست == 0)
        إرجاع 1000
    نهاية
    
    إرجاع 1000 - (سسي * 1000) / سست
