# ║     القسم 1: الاستيفاء الخطي (Linear Interpolation)             ║
# ║     Section 1: Linear Interpolation                                ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# الاستيفاء الخطي هو أبسط أنواع الاستيفاء:
# بمعرفة نقطتين (x₀,y₀) و (x₁,y₁)، نقدر قيمة y
# عند أي x بينهما باستخدام خط مستقيم:
#
# y = y₀ + (y₁-y₀) * (x-x₀) / (x₁-x₀)
#
# أو بصيغة أخرى:
# y = y₀ * (x₁-x) / (x₁-x₀) + y₁ * (x-x₀) / (x₁-x₀)
#
# المزايا:
# - بسيط وسريع O(1)
# - مستقر عددياً
# - لا يسبب تذبذبات (على عكس الاستيفاء بدرجة عالية)
#
# العيوب:
# - دقة منخفضة (خطأ O(h²))
# - المشتقة غير مستمرة عند نقاط البيانات
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: استيفاء_خطي
# الوصف: استيفاء خطي بين نقطتين
#         y = y0 + (y1-y0) * (x-x0) / (x1-x0)
# المعاملات:
#   - س0، ص0: النقطة الأولى
#   - س1، ص1: النقطة الثانية
#   - س: النقطة المطلوب تقدير قيمتها
# الإرجاع: القيمة المستوفاة (مكبرة ×1000)
**#
دالة رقم استيفاء_خطي(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س)
    متغير رقم فرق_س = س1 - س0
    إذا (فرق_س == 0)
        إرجاع ص0 * 1000
    نهاية
    # y = y0 + (y1-y0)*(x-x0)/(x1-x0) مكبر ×1000
    إرجاع ص0 * 1000 + ((ص1 - ص0) * (س - س0) * 1000) / فرق_س
نهاية


#**
# دالة: استيفاء_خطي_معامل
# الوصف: حساب المعامل t في الاستيفاء الخطي
#         t = (x - x0) / (x1 - x0)
#         t = 0 عند x0, t = 1 عند x1
# المعاملات:
#   - س0، س1: حدود الفترة
#   - س: النقطة
# الإرجاع: المعامل t مكبر ×1000 (0-1000)
**#
دالة رقم استيفاء_خطي_معامل(رقم س0، رقم س1، رقم س)
    متغير رقم فرق = س1 - س0
    إذا (فرق == 0)
        إرجاع 0
    نهاية
    إرجاع ((س - س0) * 1000) / فرق
نهاية


#**
# دالة: استيفاء_باري_مركزي
# الوصف: الاستيفاء الخطي بالأوزان الباريمركزية
#         y = (w0*y0/(x-x0) + w1*y1/(x-x1)) / (w0/(x-x0) + w1/(x-x1))
#         للاستيفاء الخطي: w0 = 1/(x0-x1), w1 = 1/(x1-x0)
#         مستقر عددياً أكثر
# المعاملات:
#   - س0، ص0: النقطة الأولى
#   - س1، ص1: النقطة الثانية
#   - س: النقطة المطلوبة
# الإرجاع: القيمة المستوفاة (مكبرة ×1000)
**#
دالة رقم استيفاء_باري_مركزي(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س)
    # تحقق: هل x تساوي أحد نقاط البيانات
    إذا (س == س0)
        إرجاع ص0 * 1000
    نهاية
    إذا (س == س1)
        إرجاع ص1 * 1000
    نهاية
    
    متغير رقم د0 = س - س0
    متغير رقم د1 = س - س1
    
    إذا (د0 == 0)
        إرجاع ص0 * 1000
    نهاية
    إذا (د1 == 0)
        إرجاع ص1 * 1000
    نهاية
    
    # w0 = -1, w1 = 1 (أوزان الاستيفاء الخطي)
    # y = (-y0/d0 + y1/d1) / (-1/d0 + 1/d1)
    متغير رقم بسط = (0 - ص0) * 1000 / د0 + ص1 * 1000 / د1
    متغير رقم مقام = (0 - 1000) / د0 + 1000 / د1
    
    إذا (مقام == 0)
        إرجاع (ص0 + ص1) * 500
    نهاية
    
    إرجاع (بسط * 1000) / مقام
نهاية


