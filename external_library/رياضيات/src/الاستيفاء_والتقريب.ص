#** ─────────────────────────────────────────────────────────────────
# استيفاء نيوتن بالفروق المقسمة:
# ───────────────────────────────
# P(x) = f[x0] + f[x0,x1](x-x0) + f[x0,x1,x2](x-x0)(x-x1) + ...
#
# حيث الفروق المقسمة:
# f[xi] = yi
# f[xi,xj] = (f[xj] - f[xi]) / (xj - xi)
# f[xi,xj,xk] = (f[xj,xk] - f[xi,xj]) / (xk - xi)
#
# الميزة الكبرى: إضافة نقطة جديدة تتطلب فقط حساب
# فرق مقسم جديد واحد (لا نعيد الحساب كله)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: فرق_مقسم_1
# الوصف: حساب الفرق المقسم من الرتبة الأولى
#         f[x0,x1] = (y1-y0) / (x1-x0)
# المعاملات:
#   - س0، ص0: النقطة الأولى
#   - س1، ص1: النقطة الثانية
# الإرجاع: الفرق المقسم مكبر ×1000
**#
دالة رقم فرق_مقسم_1(رقم س0، رقم ص0، رقم س1، رقم ص1)
    متغير رقم فرق_س = س1 - س0
    إذا (فرق_س == 0)
        إرجاع 0
    نهاية
    إرجاع ((ص1 - ص0) * 1000) / فرق_س
نهاية


#**
# دالة: فرق_مقسم_2
# الوصف: حساب الفرق المقسم من الرتبة الثانية
#         f[x0,x1,x2] = (f[x1,x2] - f[x0,x1]) / (x2 - x0)
# المعاملات:
#   - س0، ص0، س1، ص1، س2، ص2: ثلاث نقاط
# الإرجاع: الفرق المقسم مكبر ×1000
**#
دالة رقم فرق_مقسم_2(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س2، رقم ص2)
    متغير رقم ف01 = فرق_مقسم_1(س0، ص0، س1، ص1)
    متغير رقم ف12 = فرق_مقسم_1(س1، ص1، س2، ص2)
    
    متغير رقم فرق = س2 - س0
    إذا (فرق == 0)
        إرجاع 0
    نهاية
    
    إرجاع ((ف12 - ف01) * 1000) / فرق
نهاية


#**
# دالة: نيوتن_2نقاط
# الوصف: استيفاء نيوتن بنقطتين
#         P(x) = f[x0] + f[x0,x1]*(x-x0)
# المعاملات: نقطتان + x المطلوب
# الإرجاع: القيمة مكبرة ×1000
**#
دالة رقم نيوتن_2نقاط(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س)
    متغير رقم ف01 = فرق_مقسم_1(س0، ص0، س1، ص1)
    إرجاع ص0 * 1000 + ف01 * (س - س0)
نهاية


#**
# دالة: نيوتن_3نقاط
# الوصف: استيفاء نيوتن بثلاث نقاط
#         P(x) = f[x0] + f[x0,x1]*(x-x0) + f[x0,x1,x2]*(x-x0)(x-x1)
# المعاملات: ثلاث نقاط + x المطلوب
# الإرجاع: القيمة مكبرة ×1000
**#
دالة رقم نيوتن_3نقاط(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س)
    متغير رقم ف01 = فرق_مقسم_1(س0، ص0، س1، ص1)
    متغير رقم ف012 = فرق_مقسم_2(س0، ص0، س1، ص1، س2، ص2)
    
    # P = y0 + f01*(x-x0) + f012*(x-x0)(x-x1)
    متغير رقم حد1 = ص0 * 1000
    متغير رقم حد2 = ف01 * (س - س0)
    متغير رقم حد3 = (ف012 * (س - س0) * (س - س1)) / 1000
    
    إرجاع حد1 + حد2 + حد3
نهاية


