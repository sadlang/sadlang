#**
# دالة: تقريب_لوغاريتم_طبيعي
# الوصف: تقريب ln(x) باستخدام المتسلسلة:
#         ln(1+u) = u - u²/2 + u³/3 - u⁴/4 + ...
#         حيث u = (x-1)/(x+1) لتحسين التقارب
#         والصيغة الأفضل: ln(x) = 2*(u + u³/3 + u⁵/5 + ...)
# المعاملات:
#   - س: العدد (يجب > 0)
#   - حدود: عدد حدود المتسلسلة
# الإرجاع: ln(س) مكبر ×1000
**#
دالة رقم تقريب_لوغاريتم_طبيعي(رقم س، رقم حدود)
    إذا (س <= 0)
        إرجاع -999999
    نهاية
    إذا (س == 1)
        إرجاع 0
    نهاية
    
    # u = (x-1)/(x+1) مكبر ×1000
    متغير رقم بسط = (س - 1) * 1000
    متغير رقم مقام = س + 1
    إذا (مقام == 0)
        إرجاع -999999
    نهاية
    متغير رقم ي = بسط / مقام
    
    # ln(x) = 2*(u + u³/3 + u⁵/5 + ...)
    متغير رقم ي2 = (ي * ي) / 1000   # u²
    متغير رقم قوة = ي                  # u^(2k+1) يبدأ بـ u
    متغير رقم مجموع = ي               # المجموع يبدأ بـ u
    
    متغير رقم ع = 1
    طالما (ع < حدود)
        قوة = (قوة * ي2) / 1000    # u^(2k+1)
        متغير رقم مقسوم = 2 * ع + 1
        مجموع = مجموع + قوة / مقسوم
        
        إذا (قوة == 0)
            إرجاع 2 * مجموع
        نهاية
        
        ع = ع + 1
    نهاية
    
    إرجاع 2 * مجموع
