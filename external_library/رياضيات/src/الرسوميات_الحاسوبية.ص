#**
# دالة: هل_نقطة_في_مستطيل
# الوصف: (نس، نص) داخل مستطيل بزاوية (س، ص) وأبعاد (ع، ا)
**#
دالة رقم نقطة_في_مستطيل(رقم نس، رقم نص، رقم س، رقم ص، رقم العرض، رقم الارتفاع)
    إذا (نس >= س)
        إذا (نس <= س + العرض)
            إذا (نص >= ص)
                إذا (نص <= ص + الارتفاع)
                    إرجاع 1
                نهاية
            نهاية
        نهاية
    نهاية
    إرجاع 0
نهاية


