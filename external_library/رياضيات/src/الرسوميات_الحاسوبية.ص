#**
# دالة: منحنى_بيزيه_خطي (درجة 1)
# B(ت) = (1-ت)×ن₀ + ت×ن₁
# ت × عامل_دقة (بين 0 و 1000000)
**#
دالة رقم بيزيه_خطي_س(رقم س0، رقم س1، رقم ت_مقياس)
    إرجاع (1000000 - ت_مقياس) * س0 / 1000000 + ت_مقياس * س1 / 1000000
نهاية

دالة رقم بيزيه_خطي_ص(رقم ص0، رقم ص1، رقم ت_مقياس)
    إرجاع (1000000 - ت_مقياس) * ص0 / 1000000 + ت_مقياس * ص1 / 1000000
نهاية


#**
# دالة: منحنى_بيزيه_تربيعي (درجة 2)
# B(ت) = (1-ت)²×ن₀ + 2(1-ت)ت×ن₁ + ت²×ن₂
**#
دالة رقم بيزيه_تربيعي_س(رقم س0، رقم س1، رقم س2، رقم ت_مقياس)
    رقم عت = 1000000 - ت_مقياس  # (1-ت) × عامل
    
    رقم ج1 = عت * عت / 1000000 * س0 / 1000000
    رقم ج2 = 2 * عت * ت_مقياس / 1000000 * س1 / 1000000
    رقم ج3 = ت_مقياس * ت_مقياس / 1000000 * س2 / 1000000
    
    إرجاع ج1 + ج2 + ج3
نهاية

دالة رقم بيزيه_تربيعي_ص(رقم ص0، رقم ص1، رقم ص2، رقم ت_مقياس)
    رقم عت = 1000000 - ت_مقياس
    
    رقم ج1 = عت * عت / 1000000 * ص0 / 1000000
    رقم ج2 = 2 * عت * ت_مقياس / 1000000 * ص1 / 1000000
    رقم ج3 = ت_مقياس * ت_مقياس / 1000000 * ص2 / 1000000
    
    إرجاع ج1 + ج2 + ج3
نهاية


#**
# دالة: منحنى_بيزيه_تكعيبي (درجة 3)
# B(ت) = (1-ت)³×ن₀ + 3(1-ت)²ت×ن₁ + 3(1-ت)ت²×ن₂ + ت³×ن₃
**#
دالة رقم بيزيه_تكعيبي_س(رقم س0، رقم س1، رقم س2، رقم س3، رقم ت_مقياس)
    رقم عت = 1000000 - ت_مقياس
    
    رقم عت2 = عت * عت / 1000000
    رقم ت2 = ت_مقياس * ت_مقياس / 1000000
    
    رقم ج1 = عت2 * عت / 1000000 * س0 / 1000000
    رقم ج2 = 3 * عت2 * ت_مقياس / 1000000 * س1 / 1000000
    رقم ج3 = 3 * عت * ت2 / 1000000 * س2 / 1000000
    رقم ج4 = ت2 * ت_مقياس / 1000000 * س3 / 1000000
    
    إرجاع ج1 + ج2 + ج3 + ج4
نهاية

دالة رقم بيزيه_تكعيبي_ص(رقم ص0، رقم ص1، رقم ص2، رقم ص3، رقم ت_مقياس)
    رقم عت = 1000000 - ت_مقياس
    
    رقم عت2 = عت * عت / 1000000
    رقم ت2 = ت_مقياس * ت_مقياس / 1000000
    
    رقم ج1 = عت2 * عت / 1000000 * ص0 / 1000000
    رقم ج2 = 3 * عت2 * ت_مقياس / 1000000 * ص1 / 1000000
    رقم ج3 = 3 * عت * ت2 / 1000000 * ص2 / 1000000
    رقم ج4 = ت2 * ت_مقياس / 1000000 * ص3 / 1000000
    
    إرجاع ج1 + ج2 + ج3 + ج4
نهاية


