#**
# دالة: ميل_الخط
# الوصف: م = (ص₂-ص₁)/(س₂-س₁)
#         النتيجة × عامل_دقة
**#
دالة رقم ميل_خط(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إذا (س2 == س1)
        إرجاع 999999999  # عمودي
    نهاية
    إرجاع (ص2 - ص1) * 1000000 / (س2 - س1)
نهاية


#**
# دالة: قيمة_ص_على_خط
# الوصف: ص = ص₁ + م × (س - س₁)
#         م × عامل_دقة
**#
دالة رقم ص_على_خط(رقم س1، رقم ص1، رقم م_مقياس، رقم س)
    إرجاع ص1 * 1000000 + م_مقياس * (س - س1)
نهاية


#**
# دالة: هل_نقطة_على_قطعة
# الوصف: هل النقطة (س، ص) على القطعة المستقيمة
#         من (س₁، ص₁) إلى (س₂، ص₂)
#         نتحقق أن النقطة بين الحدين
**#
دالة رقم هل_بين(رقم قيمة، رقم حد1، رقم حد2)
    رقم أدنى = حد1
    رقم أعلى = حد2
    إذا (حد1 > حد2)
        أدنى = حد2
        أعلى = حد1
    نهاية
    
    إذا (قيمة >= أدنى)
        إذا (قيمة <= أعلى)
            إرجاع 1
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: ضرب_متجهي_2د
# الوصف: الحاصل الخارجي لمتجهين ثنائيين
#         = (س₂-س₁)×(ص₃-ص₁) - (ص₂-ص₁)×(س₃-س₁)
#         يحدد اتجاه الدوران
**#
دالة رقم ضرب_خارجي_نقاط(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    إرجاع (س2 - س1) * (ص3 - ص1) - (ص2 - ص1) * (س3 - س1)
نهاية


#**
# دالة: اتجاه_الدوران
# 0 = خطي, 1 = عكس الساعة, -1 = مع الساعة
**#
دالة رقم اتجاه_دوران(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    رقم الضرب = ضرب_خارجي_نقاط(س1، ص1، س2، ص2، س3، ص3)
    إذا (الضرب > 0)
        إرجاع 1
    نهاية
    إذا (الضرب < 0)
        إرجاع 0 - 1
    نهاية
    إرجاع 0
نهاية


