دالة رقم عكس_لون(رقم لون)
    رقم ح = أحمر(لون)
    رقم خ = أخضر(لون)
    رقم ز = أزرق(لون)
    إرجاع دمج_ألوان(255 - ح، 255 - خ، 255 - ز)
نهاية


#**
# دالة: تدرج_رمادي
# الوصف: تحويل لون إلى رمادي
#         الرمادي = (R + G + B) / 3
**#
دالة رقم رمادي(رقم لون)
    رقم ح = أحمر(لون)
    رقم خ = أخضر(لون)
    رقم ز = أزرق(لون)
    رقم المتوسط = (ح + خ + ز) / 3
    إرجاع دمج_ألوان(المتوسط، المتوسط، المتوسط)
نهاية


