#**
# دالة: المسافة_المربعة
# الوصف: المسافة² بين نقطتين (لتجنب الجذر)
**#
دالة رقم مسافة_مربعة_2د(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم فس = س2 - س1
    رقم فص = ص2 - ص1
    إرجاع فس * فس + فص * فص
نهاية


#**
# دالة: المسافة
# الوصف: المسافة بين نقطتين × عامل_دقة
**#
دالة رقم مسافة_2د(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم م2 = مسافة_مربعة_2د(س1، ص1، س2، ص2)
    رقم م2_مقياس = م2 * 1000000
    
    رقم ت = 1000
    إذا (م2_مقياس > 1000000)
        ت = م2_مقياس / 1000
    نهاية
    
    رقم ع = 0
    كرر طالما (ع < 25)
        إذا (ت > 0)
            ت = (ت + م2_مقياس / ت) / 2
        نهاية
        ع = ع + 1
    نهاية
    
    إرجاع ت
نهاية


#**
# دالة: مسافة_مانهاتن
# الوصف: |س₂-س₁| + |ص₂-ص₁|
**#
دالة رقم مسافة_مانهاتن(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم فس = س2 - س1
    إذا (فس < 0)
        فس = 0 - فس
    نهاية
    رقم فص = ص2 - ص1
    إذا (فص < 0)
        فص = 0 - فص
    نهاية
    إرجاع فس + فص
نهاية


#**
# دالة: مسافة_شيبيشيف
# الوصف: max(|Δس|, |Δص|)
**#
دالة رقم مسافة_شيبيشيف(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم فس = س2 - س1
    إذا (فس < 0)
        فس = 0 - فس
    نهاية
    رقم فص = ص2 - ص1
    إذا (فص < 0)
        فص = 0 - فص
    نهاية
    
    إذا (فس > فص)
        إرجاع فس
    نهاية
    إرجاع فص
نهاية


