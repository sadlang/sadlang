دالة رقم تصادم_دوائر(رقم مس1، رقم مص1، رقم نق1، رقم مس2، رقم مص2، رقم نق2)
    رقم م2 = مسافة_مربعة_2د(مس1، مص1، مس2، مص2)
    رقم مج_نق = نق1 + نق2
    إذا (م2 <= مج_نق * مج_نق)
        إرجاع 1
    نهاية
    إرجاع 0
