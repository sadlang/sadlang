#
# تمثيل الأعداد المركبة:
# العدد المركب ع = أ + ب×ت
# يُمثَّل بمركبتين: الجزء الحقيقي (أ) والجزء التخيلي (ب)
# ═══════════════════════════════════════════════════════════════════
**#


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 1: الأعداد المركبة                                  ║
# ║          Section 1: Complex Numbers                                ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# العدد المركب ع = أ + ب×ت حيث ت² = -1
#
# العمليات:
# - الجمع: (أ1+ب1ت) + (أ2+ب2ت) = (أ1+أ2) + (ب1+ب2)ت
# - الطرح: (أ1+ب1ت) - (أ2+ب2ت) = (أ1-أ2) + (ب1-ب2)ت
# - الضرب: (أ1+ب1ت)(أ2+ب2ت) = (أ1أ2-ب1ب2) + (أ1ب2+ب1أ2)ت
# - المرافق: مرافق(أ+بت) = أ - بت
# - المعيار: |ع| = √(أ²+ب²)
# - القسمة: ع1/ع2 = ع1×مرافق(ع2) / |ع2|²
# ────────────────────────────────────────────────────────────────── **#

# ═══════════════════════════════════════════════════════════════
# §1.1 - العمليات الأساسية
# ═══════════════════════════════════════════════════════════════

#** جمع عددين مركبين **#
دالة رقم جمع_مركب_حقيقي(رقم أ1، رقم أ2)
    إرجاع أ1 + أ2
نهاية

دالة رقم جمع_مركب_تخيلي(رقم ب1، رقم ب2)
    إرجاع ب1 + ب2
نهاية

#** طرح عددين مركبين **#
دالة رقم طرح_مركب_حقيقي(رقم أ1، رقم أ2)
    إرجاع أ1 - أ2
نهاية

دالة رقم طرح_مركب_تخيلي(رقم ب1، رقم ب2)
    إرجاع ب1 - ب2
نهاية


#**
# دالة: ضرب_مركب_حقيقي
# الوصف: الجزء الحقيقي من ضرب عددين مركبين
#         حقيقي(ع1×ع2) = أ1×أ2 - ب1×ب2
**#
دالة رقم ضرب_مركب_حقيقي(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إرجاع أ1 * أ2 - ب1 * ب2
نهاية

#**
# دالة: ضرب_مركب_تخيلي
# الوصف: الجزء التخيلي من ضرب عددين مركبين
#         تخيلي(ع1×ع2) = أ1×ب2 + ب1×أ2
**#
دالة رقم ضرب_مركب_تخيلي(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إرجاع أ1 * ب2 + ب1 * أ2
نهاية


#**
# دالة: مرافق_حقيقي / مرافق_تخيلي
# الوصف: المرافق المركب (Conjugate)
#         مرافق(أ + بت) = أ - بت
**#
دالة رقم مرافق_حقيقي(رقم أ)
    إرجاع أ
نهاية

دالة رقم مرافق_تخيلي(رقم ب)
    إرجاع 0 - ب
نهاية


#**
# دالة: معيار_مركب_مربع
# الوصف: |ع|² = أ² + ب²
**#
دالة رقم معيار_مركب_مربع(رقم أ، رقم ب)
    إرجاع أ * أ + ب * ب
نهاية


#**
# الأس التخيلي وصيغة أويلر:
# e^(ت×θ) = cos(θ) + ت×sin(θ)
#
# يمكن كتابة أي عدد مركب بالصيغة القطبية:
# ع = ر × e^(ت×θ) = ر × (cos(θ) + ت×sin(θ))
# حيث ر = |ع|، θ = arg(ع)
**#


#**
# دالة: تربيع_مركب_حقيقي / _تخيلي
# الوصف: تربيع عدد مركب
#         (أ+بت)² = (أ²-ب²) + (2أب)ت
**#
دالة رقم تربيع_مركب_حقيقي(رقم أ، رقم ب)
    إرجاع أ * أ - ب * ب
نهاية

دالة رقم تربيع_مركب_تخيلي(رقم أ، رقم ب)
    إرجاع 2 * أ * ب
نهاية


#**
# دالة: تكعيب_مركب
# الوصف: (أ+بت)³
#         الحقيقي: أ³ - 3أب²
#         التخيلي: 3أ²ب - ب³
**#
دالة رقم تكعيب_مركب_حقيقي(رقم أ، رقم ب)
    إرجاع أ * أ * أ - 3 * أ * ب * ب
نهاية

دالة رقم تكعيب_مركب_تخيلي(رقم أ، رقم ب)
    إرجاع 3 * أ * أ * ب - ب * ب * ب
نهاية


#**
# دالة: قسمة_مركب
# الوصف: ع1/ع2 = ع1 × مرافق(ع2) / |ع2|²
#         حقيقي: (أ1×أ2 + ب1×ب2) / (أ2²+ب2²)
#         تخيلي: (ب1×أ2 - أ1×ب2) / (أ2²+ب2²)
# ملاحظة: نُرجع بسط الجزء الحقيقي (اقسم على |ع2|²)
**#
دالة رقم قسمة_مركب_حقيقي_بسط(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إرجاع أ1 * أ2 + ب1 * ب2
نهاية

دالة رقم قسمة_مركب_تخيلي_بسط(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إرجاع ب1 * أ2 - أ1 * ب2
نهاية

دالة رقم قسمة_مركب_مقام(رقم أ2، رقم ب2)
    إرجاع أ2 * أ2 + ب2 * ب2
نهاية


#**
# دالة: هل_مركب_حقيقي
# الوصف: هل عدد مركب حقيقي بحت (الجزء التخيلي = 0)
**#
دالة رقم هل_مركب_حقيقي(رقم ب)
    إذا (ب == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية

#**
# دالة: هل_مركب_تخيلي_بحت
# الوصف: هل عدد مركب تخيلي بحت (الجزء الحقيقي = 0)
**#
دالة رقم هل_مركب_تخيلي_بحت(رقم أ)
    إذا (أ == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.2 - أعداد غاوس الصحيحة
# ═══════════════════════════════════════════════════════════════

#** ─────────────────────────────────────────────────────────────────
# أعداد غاوس الصحيحة: أعداد مركبة أ + بت حيث أ، ب أعداد صحيحة
# تشكل حلقة: Z[ت]
# النورم: N(أ + بت) = أ² + ب²
# يمكن تحليلها إلى عوامل أولية غاوسية
# ────────────────────────────────────────────────────────────────── **#

#**
# دالة: نورم_غاوس
# الوصف: نورم عدد غاوس الصحيح N(أ+بت) = أ²+ب²
**#
دالة رقم نورم_غاوس(رقم أ، رقم ب)
    إرجاع أ * أ + ب * ب
نهاية


#**
# دالة: هل_وحدة_غاوس
# الوصف: وحدات غاوس هي: 1، -1، ت، -ت
#         (نورمها = 1)
**#
دالة رقم هل_وحدة_غاوس(رقم أ، رقم ب)
    رقم ن = نورم_غاوس(أ، ب)
    إذا (ن == 1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 2: الحقول المنتهية                                  ║
# ║          Section 2: Finite Fields                                  ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# الحقل المنتهي GF(ع) أو F_ع حيث ع عدد أولي:
# - مجموعة الأعداد {0، 1، 2، ...، ع-1}
# - الجمع والضرب modulo ع
# - كل عنصر غير صفري له معكوس ضربي
#
# يستخدم في:
# - التشفير (AES, RSA)
# - تصحيح الأخطاء (Reed-Solomon)
# - المنحنيات الإهليلجية
# ────────────────────────────────────────────────────────────────── **#

#**
# دالة: باقي_موجب
# الوصف: حساب الباقي الموجب (a mod n) حيث النتيجة دائماً ≥ 0
**#
دالة رقم باقي_موجب(رقم أ، رقم ن)
    رقم ب = أ - (أ / ن) * ن
    إذا (ب < 0)
        ب = ب + ن
    نهاية
    إرجاع ب
نهاية


#**
# دالة: جمع_حقل
# الوصف: الجمع في حقل منتهي F_ع
#         (أ + ب) mod ع
**#
دالة رقم جمع_حقل(رقم أ، رقم ب، رقم ع)
    إرجاع باقي_موجب(أ + ب، ع)
نهاية


#**
# دالة: طرح_حقل
**#
دالة رقم طرح_حقل(رقم أ، رقم ب، رقم ع)
    إرجاع باقي_موجب(أ - ب، ع)
نهاية


#**
# دالة: ضرب_حقل
# الوصف: الضرب في حقل منتهي (أ × ب) mod ع
**#
دالة رقم ضرب_حقل(رقم أ، رقم ب، رقم ع)
    إرجاع باقي_موجب(أ * ب، ع)
نهاية


#**
# دالة: أس_حقل
# الوصف: الأس المعياري (التربيع المتكرر)
#         حساب (قاعدة ^ أس) mod معامل
# الخوارزمية: التربيع السريع (Binary Exponentiation)
**#
دالة رقم أس_حقل(رقم قاعدة، رقم أس، رقم معامل)
    رقم نتيجة = 1
    رقم ق = باقي_موجب(قاعدة، معامل)
    رقم ا = أس
    
    كرر طالما (ا > 0)
        رقم باقي = ا - (ا / 2) * 2
        إذا (باقي == 1)
            نتيجة = باقي_موجب(نتيجة * ق، معامل)
        نهاية
        ا = ا / 2
        ق = باقي_موجب(ق * ق، معامل)
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: معكوس_ضربي
# الوصف: المعكوس الضربي في F_ع باستخدام نظرية فيرما الصغرى
#         أ^(-1) = أ^(ع-2) mod ع (عندما ع أولي)
**#
دالة رقم معكوس_ضربي(رقم أ، رقم ع)
    إرجاع أس_حقل(أ، ع - 2، ع)
نهاية


#**
# دالة: قسمة_حقل
# الوصف: القسمة في حقل منتهي: أ/ب = أ × ب^(-1) mod ع
**#
دالة رقم قسمة_حقل(رقم أ، رقم ب، رقم ع)
    رقم معكوس = معكوس_ضربي(ب، ع)
    إرجاع باقي_موجب(أ * معكوس، ع)
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 3: نظرية الزمر الأساسية                            ║
# ║          Section 3: Basic Group Theory                             ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# مفاهيم أساسية:
# - الزمرة: مجموعة مع عملية تحقق الانغلاق والتجميعية
#           والوحدة والمعكوس
# - رتبة العنصر: أصغر ن > 0 بحيث ع^ن = 1
# - زمرة الأعداد الصحيحة mod ن: (Z/نZ, +)
# - زمرة الوحدات mod ن: (Z/نZ)* = {أ : ق.م.أ(أ، ن) = 1}
# ────────────────────────────────────────────────────────────────── **#

#**
# دالة: ق_م_أ
# الوصف: القاسم المشترك الأكبر (خوارزمية إقليدس)
**#
دالة رقم ق_م_أ(رقم أ، رقم ب)
    رقم س = أ
    رقم ص = ب
    إذا (س < 0)
        س = 0 - س
    نهاية
    إذا (ص < 0)
        ص = 0 - ص
    نهاية
    
    كرر طالما (ص > 0)
        رقم باقي = س - (س / ص) * ص
        س = ص
        ص = باقي
    نهاية
    
    إرجاع س
نهاية


#**
# دالة: رتبة_عنصر
# الوصف: رتبة العنصر أ في زمرة Z/نZ
#         أصغر ك > 0 بحيث أ^ك ≡ 1 (mod ن)
**#
دالة رقم رتبة_عنصر(رقم أ، رقم ن)
    رقم قوة = باقي_موجب(أ، ن)
    رقم ك = 1
    
    كرر طالما (ك <= ن)
        إذا (قوة == 1)
            إرجاع ك
        نهاية
        قوة = باقي_موجب(قوة * أ، ن)
        ك = ك + 1
    نهاية
    
    # العنصر ليس في زمرة الوحدات
    إرجاع 0
نهاية


#**
# دالة: هل_مولد
# الوصف: هل العنصر أ مولد (عنصر بدائي) للزمرة
#         أي رتبته = φ(ن) حيث φ هي دالة أويلر
**#
دالة رقم هل_مولد(رقم أ، رقم ن)
    # حساب φ(ن)
    رقم فاي = حساب_فاي(ن)
    رقم الرتبة = رتبة_عنصر(أ، ن)
    
    إذا (الرتبة == فاي)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: حساب_فاي (دالة أويلر)
# الوصف: φ(ن) = عدد الأعداد من 1 إلى ن-1 التي تكون
#         أولية نسبياً مع ن
**#
دالة رقم حساب_فاي(رقم ن)
    رقم العدد = 0
    رقم ع = 1
    
    كرر طالما (ع < ن)
        إذا (ق_م_أ(ع، ن) == 1)
            العدد = العدد + 1
        نهاية
        ع = ع + 1
    نهاية
    
    إرجاع العدد
نهاية


#**
# دالة: حجم_زمرة_وحدات
# الوصف: حجم زمرة الوحدات (Z/نZ)* = φ(ن)
**#
دالة رقم حجم_زمرة_وحدات(رقم ن)
    إرجاع حساب_فاي(ن)
نهاية


#**
# دالة: هل_أولي
# الوصف: اختبار الأولية (قسمة تجريبية)
**#
دالة رقم هل_أولي_متقدم(رقم ن)
    إذا (ن < 2)
        إرجاع 0
    نهاية
    إذا (ن == 2)
        إرجاع 1
    نهاية
    
    رقم باقي2 = ن - (ن / 2) * 2
    إذا (باقي2 == 0)
        إرجاع 0
    نهاية
    
    رقم ق = 3
    كرر طالما (ق * ق <= ن)
        رقم باقي = ن - (ن / ق) * ق
        إذا (باقي == 0)
            إرجاع 0
        نهاية
        ق = ق + 2
    نهاية
    
    إرجاع 1
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 4: الحسابيات المعيارية المتقدمة                    ║
# ║          Section 4: Advanced Modular Arithmetic                    ║
# ╚═══════════════════════════════════════════════════════════════════╝

#**
# دالة: رمز_لوجندر
# الوصف: رمز لوجندر (أ/ع):
#   = 0 إذا أ ≡ 0 (mod ع)
#   = 1 إذا أ بقايا تربيعية mod ع
#   = -1 خلاف ذلك
# يُحسب بمعيار أويلر: (أ/ع) = أ^((ع-1)/2) mod ع
**#
دالة رقم رمز_لوجندر(رقم أ، رقم ع)
    رقم باقي = باقي_موجب(أ، ع)
    إذا (باقي == 0)
        إرجاع 0
    نهاية
    
    رقم نتيجة = أس_حقل(باقي، (ع - 1) / 2، ع)
    
    إذا (نتيجة == 1)
        إرجاع 1
    نهاية
    # نتيجة = ع - 1 يعني -1
    إرجاع 0 - 1
نهاية


#**
# دالة: هل_بقايا_تربيعية
# الوصف: هل أ بقايا تربيعية فوق F_ع
#         أي هل يوجد س بحيث س² ≡ أ (mod ع)
**#
دالة رقم هل_بقايا_تربيعية(رقم أ، رقم ع)
    رقم لوجندر = رمز_لوجندر(أ، ع)
    إذا (لوجندر == 1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: لوغاريتم_منفصل_قوة_خام
# الوصف: اللوغاريتم المنفصل (بحث شامل)
#         إيجاد س بحيث ق^س ≡ هـ (mod ن)
#         خوارزمية بسيطة (ليست فعالة لأعداد كبيرة)
**#
دالة رقم لوغ_منفصل(رقم ق، رقم هـ، رقم ن)
    رقم قوة = 1
    رقم س = 0
    
    كرر طالما (س < ن)
        إذا (قوة == هـ)
            إرجاع س
        نهاية
        قوة = باقي_موجب(قوة * ق، ن)
        س = س + 1
    نهاية
    
    # لا يوجد حل
    إرجاع 0 - 1
نهاية


#**
# نظرية فيرما الصغرى:
# إذا كان ع أولياً و ق.م.أ(أ، ع) = 1
# فإن: أ^(ع-1) ≡ 1 (mod ع)
# أو بصيغة أخرى: أ^ع ≡ أ (mod ع)
**#
دالة رقم تحقق_فيرما(رقم أ، رقم ع)
    رقم نتيجة = أس_حقل(أ، ع - 1، ع)
    إذا (نتيجة == 1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# نظرية أويلر:
# إذا كان ق.م.أ(أ، ن) = 1
# فإن: أ^φ(ن) ≡ 1 (mod ن)
**#
دالة رقم تحقق_أويلر(رقم أ، رقم ن)
    رقم فاي = حساب_فاي(ن)
    رقم نتيجة = أس_حقل(أ، فاي، ن)
    إذا (نتيجة == 1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: النظرية الصينية للبواقي (حالة معادلتين)
# الوصف: حل النظام:
#         س ≡ أ1 (mod ن1)
#         س ≡ أ2 (mod ن2)
# حيث ق.م.أ(ن1، ن2) = 1
# الإرجاع: س mod (ن1×ن2)
**#
دالة رقم بواقي_صينية(رقم أ1، رقم ن1، رقم أ2، رقم ن2)
    # نبحث عن س بحيث:
    # س = أ1 + ك × ن1 بحيث (أ1 + ك × ن1) ≡ أ2 (mod ن2)
    # أي ك × ن1 ≡ (أ2 - أ1) (mod ن2)
    # أي ك ≡ (أ2 - أ1) × ن1^(-1) (mod ن2)
    
    رقم معكوس_ن1 = معكوس_ضربي(ن1، ن2)
    رقم فرق = باقي_موجب(أ2 - أ1، ن2)
    رقم ك = باقي_موجب(فرق * معكوس_ن1، ن2)
    
    إرجاع أ1 + ك * ن1
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 5: التشفير الأساسي                                 ║
# ║          Section 5: Basic Cryptography                             ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# تطبيقات الجبر المتقدم في التشفير:
# - شفرة قيصر (Caesar Cipher)
# - تشفير RSA الأساسي
# - تبادل مفتاح ديفي-هلمان
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: شفرة_قيصر_تشفير
# الوصف: تشفير بشفرة قيصر (إزاحة mod 26)
#         ح(ن) = (ن + مفتاح) mod 26
**#
دالة رقم قيصر_تشفير(رقم حرف، رقم مفتاح)
    إرجاع باقي_موجب(حرف + مفتاح، 26)
نهاية

#**
# دالة: قيصر_فك
# الوصف: فك شفرة قيصر
#         ف(ن) = (ن - مفتاح) mod 26
**#
دالة رقم قيصر_فك(رقم حرف_مشفر، رقم مفتاح)
    إرجاع باقي_موجب(حرف_مشفر - مفتاح، 26)
نهاية


#**
# تشفير RSA (مبسط):
# 1. اختر عددين أوليين ع1، ع2
# 2. ن = ع1 × ع2
# 3. φ(ن) = (ع1-1)(ع2-1)
# 4. اختر هـ بحيث ق.م.أ(هـ، φ(ن)) = 1
# 5. احسب د = هـ^(-1) mod φ(ن)
# التشفير: ج = م^هـ mod ن
# فك التشفير: م = ج^د mod ن
**#

#**
# دالة: rsa_حساب_ن
# الوصف: حساب ن = ع1 × ع2 (معامل RSA)
**#
دالة رقم rsa_حساب_ن(رقم ع1، رقم ع2)
    إرجاع ع1 * ع2
نهاية

#**
# دالة: rsa_حساب_فاي
# الوصف: φ(ن) = (ع1-1)(ع2-1)
**#
دالة رقم rsa_حساب_فاي(رقم ع1، رقم ع2)
    إرجاع (ع1 - 1) * (ع2 - 1)
نهاية

#**
# دالة: rsa_تشفير
# الوصف: تشفير RSA: ج = م^هـ mod ن
**#
دالة رقم rsa_تشفير(رقم م، رقم هـ، رقم ن)
    إرجاع أس_حقل(م، هـ، ن)
نهاية

#**
# دالة: rsa_فك
# الوصف: فك تشفير RSA: م = ج^د mod ن
**#
دالة رقم rsa_فك(رقم ج، رقم د، رقم ن)
    إرجاع أس_حقل(ج، د، ن)
نهاية

#**
# دالة: rsa_حساب_د
# الوصف: المفتاح الخاص د = هـ^(-1) mod φ(ن)
**#
دالة رقم rsa_حساب_د(رقم هـ، رقم فاي)
    إرجاع معكوس_ضربي(هـ، فاي)
نهاية


#**
# تبادل مفتاح ديفي-هلمان:
# 1. اتفاق على عدد أولي ع ومولد ق
# 2. أليس تختار سراً أ، ترسل ق^أ mod ع
# 3. بوب يختار سراً ب، يرسل ق^ب mod ع  
# 4. المفتاح المشترك: ق^(أب) mod ع
**#

#**
# دالة: dh_حساب_عام
# الوصف: حساب القيمة العامة في ديفي-هلمان
#         ق^سر mod ع
**#
دالة رقم dh_حساب_عام(رقم ق، رقم سر، رقم ع)
    إرجاع أس_حقل(ق، سر، ع)
نهاية

#**
# دالة: dh_حساب_مفتاح
# الوصف: حساب المفتاح المشترك
#         (عام_آخر)^سر mod ع
**#
دالة رقم dh_حساب_مفتاح(رقم عام_آخر، رقم سر، رقم ع)
    إرجاع أس_حقل(عام_آخر، سر، ع)
نهاية


#**
# دالة: هاش_بسيط
# الوصف: دالة هاش بسيطة (مبسطة جداً)
#         هاش(أ) = (أ × 2654435761) mod 2^16
#         (مستوحاة من هاش كنوث)
**#
دالة رقم هاش_بسيط(رقم أ)
    رقم ح = أ * 2654435
    إذا (ح < 0)
        ح = 0 - ح
    نهاية
    إرجاع باقي_موجب(ح، 65536)
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 6: الاختبارات                                       ║
# ║          Section 6: Tests                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

دالة رقم اختبار_الجبر_المتقدم()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار الجبر المتقدم")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: ضرب أعداد مركبة
    # (3+4ت)(1+2ت) = (3-8) + (6+4)ت = -5 + 10ت
    رقم ح1 = ضرب_مركب_حقيقي(3، 4، 1، 2)
    رقم ت1 = ضرب_مركب_تخيلي(3، 4، 1، 2)
    إذا (ح1 == 0 - 5)
        إذا (ت1 == 10)
            نجاح = نجاح + 1
            اطبع_سطر("✓ (3+4i)(1+2i) = -5+10i")
        وإلا
            فشل = فشل + 1
            اطبع_سطر("✗ فشل ضرب مركب (تخيلي)")
        نهاية
    وإلا
        فشل = فشل + 1
        اطبع("✗ ضرب مركب حقيقي = ")
        اطبع_سطر(ح1)
    نهاية
    
    # اختبار 2: معيار مركب
    # |3+4ت|² = 9+16 = 25
    رقم ن2 = معيار_مركب_مربع(3، 4)
    إذا (ن2 == 25)
        نجاح = نجاح + 1
        اطبع_سطر("✓ |3+4i|² = 25")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل معيار مركب")
    نهاية
    
    # اختبار 3: الحقول المنتهية
    # 3^(-1) mod 7 = 5 (لأن 3×5 = 15 ≡ 1 mod 7)
    رقم ن3 = معكوس_ضربي(3، 7)
    إذا (ن3 == 5)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 3^(-1) mod 7 = 5")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 3^(-1) mod 7 = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: أس معياري
    # 2^10 mod 1000 = 1024 mod 1000 = 24
    رقم ن4 = أس_حقل(2، 10، 1000)
    إذا (ن4 == 24)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 2^10 mod 1000 = 24")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 2^10 mod 1000 = ")
        اطبع_سطر(ن4)
    نهاية
    
    # اختبار 5: نظرية فيرما
    # 2^6 ≡ 1 mod 7
    رقم ن5 = تحقق_فيرما(2، 7)
    إذا (ن5 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 2^6 ≡ 1 (mod 7) - فيرما")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل تحقق فيرما")
    نهاية
    
    # اختبار 6: φ(12) = 4 (1، 5، 7، 11)
    رقم ن6 = حساب_فاي(12)
    إذا (ن6 == 4)
        نجاح = نجاح + 1
        اطبع_سطر("✓ φ(12) = 4")
    وإلا
        فشل = فشل + 1
        اطبع("✗ φ(12) = ")
        اطبع_سطر(ن6)
    نهاية
    
    # اختبار 7: RSA مبسط
    # ع1=3، ع2=11، ن=33، φ=20، هـ=3، د=7
    # تشفير: 7^3 mod 33 = 343 mod 33 = 13
    # فك: 13^7 mod 33 = 7
    رقم مشفر = rsa_تشفير(7، 3، 33)
    إذا (مشفر == 13)
        نجاح = نجاح + 1
        اطبع_سطر("✓ RSA: 7^3 mod 33 = 13")
    وإلا
        فشل = فشل + 1
        اطبع("✗ RSA تشفير = ")
        اطبع_سطر(مشفر)
    نهاية
    
    رقم مفكوك = rsa_فك(13، 7، 33)
    إذا (مفكوك == 7)
        نجاح = نجاح + 1
        اطبع_سطر("✓ RSA: 13^7 mod 33 = 7")
    وإلا
        فشل = فشل + 1
        اطبع("✗ RSA فك = ")
        اطبع_سطر(مفكوك)
    نهاية
    
    # اختبار 8: شفرة قيصر
    رقم مشفر_ق = قيصر_تشفير(5، 3)
    رقم مفكوك_ق = قيصر_فك(مشفر_ق، 3)
    إذا (مفكوك_ق == 5)
        نجاح = نجاح + 1
        اطبع_سطر("✓ قيصر: تشفير ثم فك = الأصل")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل شفرة قيصر")
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


