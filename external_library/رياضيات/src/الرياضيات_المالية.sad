# ثوابت مالية
# عامل_الدقة = 1,000,000


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 1: الفائدة البسيطة والمركبة                         ║
# ║          Section 1: Simple & Compound Interest                     ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: فائدة_بسيطة
# الوصف: الفائدة البسيطة = رأس_المال × معدل × الزمن / 100
#         المعدل بالنسبة المئوية (مثلاً 5 = 5%)
#         الزمن بالسنوات
**#
دالة رقم فائدة_بسيطة(رقم رأس_المال، رقم المعدل، رقم الزمن)
    إرجاع رأس_المال * المعدل * الزمن / 100
نهاية


#**
# دالة: المبلغ_بالبسيطة
# الوصف: المبلغ الإجمالي = رأس المال + الفائدة البسيطة
#         = ر × (1 + م × ز / 100)
**#
دالة رقم مبلغ_بسيطة(رقم رأس_المال، رقم المعدل، رقم الزمن)
    إرجاع رأس_المال + فائدة_بسيطة(رأس_المال، المعدل، الزمن)
نهاية


#**
# دالة: فائدة_مركبة_سنوية
# الوصف: الفائدة المركبة بالتركيب السنوي
#         م = ر × (1 + ع/100)^ن - ر
#         حيث ن = عدد السنوات
#         نستخدم حلقة للحساب (بدون أُس عشري)
**#
دالة رقم فائدة_مركبة(رقم رأس_المال، رقم المعدل، رقم السنوات)
    رقم المبلغ = رأس_المال * 1000000
    
    رقم ع = 0
    كرر طالما (ع < السنوات)
        # المبلغ = المبلغ × (1 + المعدل/100)
        # = المبلغ × (100 + المعدل) / 100
        المبلغ = المبلغ * (100 + المعدل) / 100
        ع = ع + 1
    نهاية
    
    إرجاع المبلغ / 1000000 - رأس_المال
نهاية


#**
# دالة: مبلغ_مركب_سنوي
# الوصف: المبلغ الإجمالي بعد ن سنة بالفائدة المركبة
**#
دالة رقم مبلغ_مركب(رقم رأس_المال، رقم المعدل، رقم السنوات)
    رقم المبلغ = رأس_المال * 1000000
    
    رقم ع = 0
    كرر طالما (ع < السنوات)
        المبلغ = المبلغ * (100 + المعدل) / 100
        ع = ع + 1
    نهاية
    
    إرجاع المبلغ / 1000000
نهاية


#**
# دالة: فائدة_مركبة_نصف_سنوية
# الوصف: تركيب نصف سنوي (مرتين في السنة)
#         المعدل الفعلي = المعدل/2 لكل فترة
#         عدد الفترات = السنوات × 2
**#
دالة رقم فائدة_نصف_سنوية(رقم رأس_المال، رقم المعدل، رقم السنوات)
    رقم المبلغ = رأس_المال * 1000000
    رقم نصف_معدل = المعدل  # المعدل لنصف السنة = المعدل/2 بالنسبة المئوية
    رقم الفترات = السنوات * 2
    
    رقم ع = 0
    كرر طالما (ع < الفترات)
        المبلغ = المبلغ * (200 + المعدل) / 200
        ع = ع + 1
    نهاية
    
    إرجاع المبلغ / 1000000 - رأس_المال
نهاية


#**
# دالة: فائدة_مركبة_ربع_سنوية
# الوصف: تركيب ربع سنوي (4 مرات في السنة)
**#
دالة رقم فائدة_ربع_سنوية(رقم رأس_المال، رقم المعدل، رقم السنوات)
    رقم المبلغ = رأس_المال * 1000000
    رقم الفترات = السنوات * 4
    
    رقم ع = 0
    كرر طالما (ع < الفترات)
        المبلغ = المبلغ * (400 + المعدل) / 400
        ع = ع + 1
    نهاية
    
    إرجاع المبلغ / 1000000 - رأس_المال
نهاية


#**
# دالة: فائدة_مركبة_شهرية
# الوصف: تركيب شهري (12 مرة في السنة)
**#
دالة رقم فائدة_شهرية(رقم رأس_المال، رقم المعدل، رقم السنوات)
    رقم المبلغ = رأس_المال * 1000000
    رقم الفترات = السنوات * 12
    
    رقم ع = 0
    كرر طالما (ع < الفترات)
        المبلغ = المبلغ * (1200 + المعدل) / 1200
        ع = ع + 1
    نهاية
    
    إرجاع المبلغ / 1000000 - رأس_المال
نهاية


#**
# دالة: معدل_فعلي_سنوي
# الوصف: المعدل الفعلي السنوي من المعدل الاسمي
#         = (1 + ر/ن)^ن - 1
#         المدخل: المعدل% وعدد فترات التركيب
#         النتيجة × عامل_دقة
**#
دالة رقم معدل_فعلي(رقم المعدل، رقم الفترات)
    رقم المبلغ = 1000000  # 1 × عامل_دقة
    
    رقم ع = 0
    كرر طالما (ع < الفترات)
        المبلغ = المبلغ * (الفترات * 100 + المعدل) / (الفترات * 100)
        ع = ع + 1
    نهاية
    
    إرجاع المبلغ - 1000000
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 2: القيمة الزمنية للنقود                            ║
# ║          Section 2: Time Value of Money                            ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: القيمة_المستقبلية
# الوصف: القيمة المستقبلية لمبلغ حالي
#         FV = PV × (1 + ر/100)^ن
**#
دالة رقم قيمة_مستقبلية(رقم قيمة_حالية، رقم المعدل، رقم السنوات)
    إرجاع مبلغ_مركب(قيمة_حالية، المعدل، السنوات)
نهاية


#**
# دالة: القيمة_الحالية
# الوصف: القيمة الحالية لمبلغ مستقبلي
#         PV = FV / (1 + ر/100)^ن
#         نستخدم القسمة التراجعية
**#
دالة رقم قيمة_حالية(رقم قيمة_مستقبلية، رقم المعدل، رقم السنوات)
    رقم المقام = 1000000  # 1 × عامل_دقة
    
    رقم ع = 0
    كرر طالما (ع < السنوات)
        المقام = المقام * (100 + المعدل) / 100
        ع = ع + 1
    نهاية
    
    إرجاع قيمة_مستقبلية * 1000000 / المقام * 1000000
نهاية


#**
# دالة: قيمة_مستقبلية_دفعات
# الوصف: القيمة المستقبلية لسلسلة دفعات متساوية
#         FV = D × [(1+ر)^ن - 1] / ر
#         D = الدفعة السنوية، ر = المعدل%
**#
دالة رقم مستقبلية_دفعات(رقم الدفعة، رقم المعدل، رقم السنوات)
    رقم المجموع = 0
    
    # كل دفعة تنمو بفائدة مركبة للفترة المتبقية
    رقم ع = 0
    كرر طالما (ع < السنوات)
        رقم سنوات_نمو = السنوات - 1 - ع
        رقم القيمة = الدفعة * 1000000
        
        رقم ع2 = 0
        كرر طالما (ع2 < سنوات_نمو)
            القيمة = القيمة * (100 + المعدل) / 100
            ع2 = ع2 + 1
        نهاية
        
        المجموع = المجموع + القيمة
        ع = ع + 1
    نهاية
    
    إرجاع المجموع / 1000000
نهاية


#**
# دالة: قيمة_حالية_دفعات
# الوصف: القيمة الحالية لسلسلة دفعات متساوية
#         PV = D × [1 - (1+ر)^(-ن)] / ر
**#
دالة رقم حالية_دفعات(رقم الدفعة، رقم المعدل، رقم السنوات)
    رقم المجموع = 0
    
    رقم ع = 1
    كرر طالما (ع <= السنوات)
        # خصم الدفعة في السنة ع
        رقم القيمة = الدفعة * 1000000
        
        رقم ع2 = 0
        كرر طالما (ع2 < ع)
            القيمة = القيمة * 100 / (100 + المعدل)
            ع2 = ع2 + 1
        نهاية
        
        المجموع = المجموع + القيمة
        ع = ع + 1
    نهاية
    
    إرجاع المجموع / 1000000
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 3: التقسيط والإطفاء                                 ║
# ║          Section 3: Installments & Amortization                    ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: قسط_ثابت
# الوصف: القسط الشهري الثابت لقرض
#         PMT = P × ر(1+ر)^ن / [(1+ر)^ن - 1]
#         P = أصل القرض, ر = معدل شهري%, ن = عدد الأشهر
**#
دالة رقم قسط_شهري(رقم أصل_القرض، رقم المعدل_السنوي، رقم الأشهر)
    # المعدل الشهري = المعدل السنوي / 12
    # نعمل بدقة عالية
    
    # (1+ر)^ن
    رقم عامل = 1200000  # 1.0 × 1200 (لتجنب فقد الدقة)
    رقم عامل_ر = 1200 + المعدل_السنوي  # (1 + ر/12) × 1200
    
    رقم قوة = 1000000  # (1+ر)^0 = 1 × عامل_دقة
    رقم ع = 0
    كرر طالما (ع < الأشهر)
        قوة = قوة * عامل_ر / 1200
        ع = ع + 1
    نهاية
    
    # القسط = أصل × ر × (1+ر)^ن / [(1+ر)^ن - 1]
    # ر الشهري = المعدل / 1200
    رقم البسط = أصل_القرض * المعدل_السنوي * قوة / 1200
    رقم المقام = قوة - 1000000
    
    إذا (المقام <= 0)
        إرجاع أصل_القرض / الأشهر
    نهاية
    
    إرجاع البسط / المقام
نهاية


#**
# دالة: إجمالي_المدفوعات
# الوصف: إجمالي ما يُدفع على مدار فترة القرض
**#
دالة رقم إجمالي_مدفوعات(رقم أصل_القرض، رقم المعدل_السنوي، رقم الأشهر)
    رقم القسط = قسط_شهري(أصل_القرض، المعدل_السنوي، الأشهر)
    إرجاع القسط * الأشهر
نهاية


#**
# دالة: إجمالي_الفائدة_المدفوعة
# الوصف: مجموع الفوائد المدفوعة = إجمالي المدفوعات - أصل القرض
**#
دالة رقم فائدة_إجمالية(رقم أصل_القرض، رقم المعدل_السنوي، رقم الأشهر)
    إرجاع إجمالي_مدفوعات(أصل_القرض، المعدل_السنوي، الأشهر) - أصل_القرض
نهاية


#**
# دالة: الرصيد_المتبقي
# الوصف: الرصيد المتبقي بعد عدد أشهر معين
#         بالفائدة البسيطة التقريبية
**#
دالة رقم رصيد_متبقي_بسيط(رقم أصل_القرض، رقم القسط، رقم المعدل، رقم أشهر_مدفوعة)
    رقم الرصيد = أصل_القرض * 1000000
    
    رقم ع = 0
    كرر طالما (ع < أشهر_مدفوعة)
        # فائدة الشهر
        رقم فائدة = الرصيد * المعدل / (12 * 100)
        # تسديد من الأصل
        الرصيد = الرصيد + فائدة - القسط * 1000000
        ع = ع + 1
    نهاية
    
    إرجاع الرصيد / 1000000
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 4: الاستثمار والعائد                                ║
# ║          Section 4: Investment & Return                            ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: عائد_الاستثمار (ROI)
# الوصف: ROI = (الربح / التكلفة) × 100
#         النتيجة بالنسبة المئوية × عامل_دقة
**#
دالة رقم عائد_استثمار(رقم الربح، رقم التكلفة)
    إذا (التكلفة == 0)
        إرجاع 0
    نهاية
    إرجاع الربح * 100 * 1000000 / التكلفة
نهاية


#**
# دالة: صافي_القيمة_الحالية
# الوصف: NPV لتدفقات نقدية متساوية
#         NPV = -الاستثمار + Σ(التدفق/(1+ر)^ع)
**#
دالة رقم صافي_القيمة_الحالية(رقم الاستثمار، رقم التدفق_السنوي، رقم المعدل، رقم السنوات)
    رقم المجموع = 0 - الاستثمار * 1000000
    
    رقم ع = 1
    كرر طالما (ع <= السنوات)
        رقم القيمة = التدفق_السنوي * 1000000
        
        رقم ع2 = 0
        كرر طالما (ع2 < ع)
            القيمة = القيمة * 100 / (100 + المعدل)
            ع2 = ع2 + 1
        نهاية
        
        المجموع = المجموع + القيمة
        ع = ع + 1
    نهاية
    
    إرجاع المجموع / 1000000
نهاية


#**
# دالة: فترة_الاسترداد
# الوصف: عدد السنوات لاسترداد الاستثمار
#         = الاستثمار / التدفق السنوي (بدون خصم)
**#
دالة رقم فترة_استرداد(رقم الاستثمار، رقم التدفق_السنوي)
    إذا (التدفق_السنوي <= 0)
        إرجاع 999
    نهاية
    
    رقم سنوات = 0
    رقم المتبقي = الاستثمار
    
    كرر طالما (المتبقي > 0)
        المتبقي = المتبقي - التدفق_السنوي
        سنوات = سنوات + 1
    نهاية
    
    إرجاع سنوات
نهاية


#**
# دالة: مؤشر_الربحية
# الوصف: PI = القيمة الحالية للتدفقات / الاستثمار الأولي
#         النتيجة × عامل_دقة
**#
دالة رقم مؤشر_ربحية(رقم الاستثمار، رقم التدفق_السنوي، رقم المعدل، رقم السنوات)
    رقم قح = حالية_دفعات(التدفق_السنوي، المعدل، السنوات)
    إذا (الاستثمار == 0)
        إرجاع 0
    نهاية
    إرجاع قح * 1000000 / الاستثمار
نهاية


#**
# دالة: ربح_الأسهم
# الوصف: الربح من بيع أسهم
#         = (سعر_البيع - سعر_الشراء) × الكمية
**#
دالة رقم ربح_أسهم(رقم سعر_شراء، رقم سعر_بيع، رقم الكمية)
    إرجاع (سعر_بيع - سعر_شراء) * الكمية
نهاية


#**
# دالة: عائد_الربح_المئوي
# الوصف: نسبة الربح = (البيع - الشراء) / الشراء × 100
#         النتيجة × عامل_دقة
**#
دالة رقم عائد_ربح(رقم سعر_شراء، رقم سعر_بيع)
    إذا (سعر_شراء == 0)
        إرجاع 0
    نهاية
    إرجاع (سعر_بيع - سعر_شراء) * 100 * 1000000 / سعر_شراء
نهاية


#**
# دالة: توزيعات_أرباح
# الوصف: عائد التوزيعات = التوزيع السنوي / سعر السهم × 100
#         النتيجة × عامل_دقة
**#
دالة رقم عائد_توزيعات(رقم التوزيع، رقم سعر_السهم)
    إذا (سعر_السهم == 0)
        إرجاع 0
    نهاية
    إرجاع التوزيع * 100 * 1000000 / سعر_السهم
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 5: الاستهلاك                                        ║
# ║          Section 5: Depreciation                                   ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: استهلاك_خط_مستقيم
# الوصف: الاستهلاك السنوي = (التكلفة - القيمة_المتبقية) / العمر
**#
دالة رقم استهلاك_خطي(رقم التكلفة، رقم القيمة_المتبقية، رقم العمر)
    إذا (العمر <= 0)
        إرجاع 0
    نهاية
    إرجاع (التكلفة - القيمة_المتبقية) / العمر
نهاية


#**
# دالة: قيمة_بعد_استهلاك_خطي
# الوصف: القيمة الدفترية بعد ن سنة من الاستهلاك الخطي
**#
دالة رقم قيمة_بعد_استهلاك(رقم التكلفة، رقم القيمة_المتبقية، رقم العمر، رقم السنوات)
    رقم الاستهلاك_السنوي = استهلاك_خطي(التكلفة، القيمة_المتبقية، العمر)
    رقم النتيجة = التكلفة - الاستهلاك_السنوي * السنوات
    
    إذا (النتيجة < القيمة_المتبقية)
        إرجاع القيمة_المتبقية
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: استهلاك_متناقص
# الوصف: الاستهلاك بطريقة الرصيد المتناقص بنسبة مئوية
#         D_ن = القيمة × نسبة / 100
**#
دالة رقم استهلاك_متناقص(رقم التكلفة، رقم النسبة، رقم السنة)
    رقم القيمة = التكلفة * 1000000
    
    رقم ع = 1
    كرر طالما (ع < السنة)
        القيمة = القيمة * (100 - النسبة) / 100
        ع = ع + 1
    نهاية
    
    # الاستهلاك في السنة المطلوبة
    إرجاع القيمة * النسبة / (100 * 1000000)
نهاية


#**
# دالة: استهلاك_مجموع_السنوات
# الوصف: طريقة مجموع أرقام السنوات (SYD)
#         D_ن = (التكلفة - المتبقية) × (العمر - ن + 1) / مج
#         مج = العمر × (العمر + 1) / 2
**#
دالة رقم استهلاك_مجموع_سنوات(رقم التكلفة، رقم المتبقية، رقم العمر، رقم السنة)
    رقم المجموع = العمر * (العمر + 1) / 2
    إذا (المجموع == 0)
        إرجاع 0
    نهاية
    إرجاع (التكلفة - المتبقية) * (العمر - السنة + 1) / المجموع
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
