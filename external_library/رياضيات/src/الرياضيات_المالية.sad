#**
# دالة: نسبة_الدين
# الوصف: نسبة الدين = إجمالي الديون / إجمالي الأصول × 100
#         النتيجة × عامل_دقة
**#
دالة رقم نسبة_دين(رقم الديون، رقم الأصول)
    إذا (الأصول == 0)
        إرجاع 0
    نهاية
    إرجاع الديون * 100 * 1000000 / الأصول
نهاية


#**
# دالة: نسبة_السيولة
# الوصف: نسبة السيولة = الأصول المتداولة / الالتزامات المتداولة
#         النتيجة × عامل_دقة
**#
دالة رقم نسبة_سيولة(رقم أصول_متداولة، رقم التزامات_متداولة)
    إذا (التزامات_متداولة == 0)
        إرجاع 999999999
    نهاية
    إرجاع أصول_متداولة * 1000000 / التزامات_متداولة
نهاية


#**
# دالة: هامش_الربح
# الوصف: هامش الربح = صافي الربح / الإيرادات × 100
#         النتيجة × عامل_دقة
**#
دالة رقم هامش_ربح(رقم صافي_الربح، رقم الإيرادات)
    إذا (الإيرادات == 0)
        إرجاع 0
    نهاية
    إرجاع صافي_الربح * 100 * 1000000 / الإيرادات
نهاية


#**
# دالة: العائد_على_حقوق_الملكية
# الوصف: ROE = صافي الربح / حقوق الملكية × 100
**#
دالة رقم عائد_ملكية(رقم صافي_الربح، رقم حقوق_الملكية)
    إذا (حقوق_الملكية == 0)
        إرجاع 0
    نهاية
    إرجاع صافي_الربح * 100 * 1000000 / حقوق_الملكية
نهاية


#**
# دالة: ربحية_السهم
# الوصف: EPS = صافي الربح / عدد الأسهم
#         النتيجة × عامل_دقة
**#
دالة رقم ربحية_سهم(رقم صافي_الربح، رقم عدد_الأسهم)
    إذا (عدد_الأسهم == 0)
        إرجاع 0
    نهاية
    إرجاع صافي_الربح * 1000000 / عدد_الأسهم
نهاية


#**
# دالة: مكرر_الأرباح
# الوصف: P/E Ratio = سعر السهم / ربحية السهم
#         النتيجة × عامل_دقة
**#
دالة رقم مكرر_أرباح(رقم سعر_السهم، رقم ربحية_السهم)
    إذا (ربحية_السهم == 0)
        إرجاع 0
    نهاية
    إرجاع سعر_السهم * 1000000 / ربحية_السهم
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 7: البنوك والتمويل                                  ║
# ║          Section 7: Banking & Finance                              ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: عمولة_بنكية
# الوصف: حساب العمولة = المبلغ × النسبة / 100
**#
دالة رقم عمولة(رقم المبلغ، رقم النسبة_المئوية)
    إرجاع المبلغ * النسبة_المئوية / 100
نهاية


#**
# دالة: مبلغ_بعد_عمولة
# الوصف: المبلغ الصافي بعد خصم العمولة
**#
دالة رقم بعد_عمولة(رقم المبلغ، رقم النسبة)
    إرجاع المبلغ - عمولة(المبلغ، النسبة)
نهاية


#**
# دالة: ضريبة_دخل_بسيطة
# الوصف: ضريبة بنسبة ثابتة
**#
دالة رقم ضريبة_دخل(رقم الدخل، رقم النسبة)
    إرجاع الدخل * النسبة / 100
نهاية


#**
# دالة: صافي_بعد_ضريبة
**#
دالة رقم صافي_دخل(رقم الدخل، رقم النسبة)
    إرجاع الدخل - ضريبة_دخل(الدخل، النسبة)
نهاية


#**
# دالة: ضريبة_تصاعدية_بسيطة
# الوصف: شريحتان: نسبة1 حتى الحد، ونسبة2 لما فوق
**#
دالة رقم ضريبة_تصاعدية(رقم الدخل، رقم الحد، رقم نسبة1، رقم نسبة2)
    إذا (الدخل <= الحد)
        إرجاع الدخل * نسبة1 / 100
    نهاية
    
    رقم ض1 = الحد * نسبة1 / 100
    رقم ض2 = (الدخل - الحد) * نسبة2 / 100
    إرجاع ض1 + ض2
نهاية


#**
# دالة: سعر_الصرف
# الوصف: تحويل عملة: المبلغ × السعر
#         المبلغ والسعر بالأعداد الصحيحة
#         السعر × عامل_دقة
**#
دالة رقم تحويل_عملة(رقم المبلغ، رقم السعر_مقياس)
    إرجاع المبلغ * السعر_مقياس / 1000000
نهاية


#**
# دالة: كلفة_بضاعة_مباعة
# الوصف: COGS = مخزون بداية + مشتريات - مخزون نهاية
**#
دالة رقم كلفة_بضاعة(رقم مخزون_بداية، رقم مشتريات، رقم مخزون_نهاية)
    إرجاع مخزون_بداية + مشتريات - مخزون_نهاية
نهاية


#**
# دالة: إجمالي_الربح
# الوصف: = الإيرادات - كلفة البضاعة المباعة
**#
دالة رقم إجمالي_ربح(رقم الإيرادات، رقم الكلفة)
    إرجاع الإيرادات - الكلفة
نهاية


#**
# دالة: نقطة_التعادل
# الوصف: عدد الوحدات عند نقطة التعادل
#         = التكاليف الثابتة / (سعر الوحدة - تكلفة الوحدة المتغيرة)
**#
دالة رقم نقطة_تعادل(رقم تكاليف_ثابتة، رقم سعر_وحدة، رقم تكلفة_متغيرة)
    رقم الهامش = سعر_وحدة - تكلفة_متغيرة
    إذا (الهامش <= 0)
        إرجاع 999999
    نهاية
    إرجاع تكاليف_ثابتة / الهامش
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 8: التأمين                                          ║
# ║          Section 8: Insurance                                      ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: قسط_تأمين_سنوي
# الوصف: القسط = القيمة المؤمنة × معدل القسط / 1000
**#
دالة رقم قسط_تأمين(رقم القيمة_المؤمنة، رقم المعدل_لكل_ألف)
    إرجاع القيمة_المؤمنة * المعدل_لكل_ألف / 1000
نهاية


#**
# دالة: تعويض_تأمين
# الوصف: التعويض = الخسارة × (المبلغ المؤمن / القيمة الفعلية)
#         قاعدة التناسب
**#
دالة رقم تعويض(رقم الخسارة، رقم المبلغ_المؤمن، رقم القيمة_الفعلية)
    إذا (القيمة_الفعلية == 0)
        إرجاع 0
    نهاية
    إرجاع الخسارة * المبلغ_المؤمن / القيمة_الفعلية
نهاية


#**
# دالة: معدل_الخسارة
# الوصف: = إجمالي التعويضات / إجمالي الأقساط × 100
#         النتيجة × عامل_دقة
**#
دالة رقم معدل_خسارة(رقم التعويضات، رقم الأقساط)
    إذا (الأقساط == 0)
        إرجاع 0
    نهاية
    إرجاع التعويضات * 100 * 1000000 / الأقساط
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 9: الاختبارات                                       ║
# ║          Section 9: Tests                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

دالة رقم اختبار_الرياضيات_المالية()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار الرياضيات المالية")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: فائدة بسيطة
    # 1000 × 5% × 3 سنوات = 150
    رقم ن1 = فائدة_بسيطة(1000، 5، 3)
    إذا (ن1 == 150)
        نجاح = نجاح + 1
        اطبع_سطر("✓ فائدة بسيطة(1000, 5%, 3) = 150")
    وإلا
        فشل = فشل + 1
        اطبع("✗ فائدة = ")
        اطبع_سطر(ن1)
    نهاية
    
    # اختبار 2: مبلغ مركب
    # 1000 × (1.10)² = 1210
    رقم ن2 = مبلغ_مركب(1000، 10، 2)
    إذا (ن2 == 1210)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مبلغ مركب(1000, 10%, 2) = 1210")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مبلغ = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: استهلاك خطي
    # (10000 - 2000) / 4 = 2000
    رقم ن3 = استهلاك_خطي(10000، 2000، 4)
    إذا (ن3 == 2000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ استهلاك خطي = 2000")
    وإلا
        فشل = فشل + 1
        اطبع("✗ استهلاك = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: عائد استثمار
    # ROI = 500/2000 × 100 = 25%
    رقم ن4 = عائد_استثمار(500، 2000)
    إذا (ن4 == 25000000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ ROI(500/2000) = 25%")
    وإلا
        فشل = فشل + 1
        اطبع("✗ ROI = ")
        اطبع_سطر(ن4)
    نهاية
    
    # اختبار 5: هامش ربح
    # 300/1000 × 100 = 30%
    رقم ن5 = هامش_ربح(300، 1000)
    إذا (ن5 == 30000000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ هامش ربح = 30%")
    وإلا
        فشل = فشل + 1
        اطبع("✗ هامش = ")
        اطبع_سطر(ن5)
    نهاية
    
    # اختبار 6: نقطة تعادل
    # 10000 / (50 - 30) = 500 وحدة
    رقم ن6 = نقطة_تعادل(10000، 50، 30)
    إذا (ن6 == 500)
        نجاح = نجاح + 1
        اطبع_سطر("✓ نقطة تعادل = 500 وحدة")
    وإلا
        فشل = فشل + 1
        اطبع("✗ نقطة تعادل = ")
        اطبع_سطر(ن6)
    نهاية
    
    # اختبار 7: ضريبة تصاعدية
    # دخل 150000, حد 100000, نسبة1=10%, نسبة2=20%
    # = 100000×10% + 50000×20% = 10000 + 10000 = 20000
    رقم ن7 = ضريبة_تصاعدية(150000، 100000، 10، 20)
    إذا (ن7 == 20000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ ضريبة تصاعدية = 20000")
    وإلا
        فشل = فشل + 1
        اطبع("✗ ضريبة = ")
        اطبع_سطر(ن7)
    نهاية
    
    # اختبار 8: فترة استرداد
    # 100000 / 25000 = 4 سنوات
    رقم ن8 = فترة_استرداد(100000، 25000)
    إذا (ن8 == 4)
        نجاح = نجاح + 1
        اطبع_سطر("✓ فترة استرداد = 4 سنوات")
    وإلا
        فشل = فشل + 1
        اطبع("✗ فترة = ")
        اطبع_سطر(ن8)
    نهاية
    
    # اختبار 9: ربح أسهم
    # (150 - 100) × 200 = 10000
    رقم ن9 = ربح_أسهم(100، 150، 200)
    إذا (ن9 == 10000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ ربح أسهم = 10000")
    وإلا
        فشل = فشل + 1
        اطبع("✗ ربح = ")
        اطبع_سطر(ن9)
    نهاية
    
    # اختبار 10: قسط تأمين
    # 500000 × 3/1000 = 1500
    رقم ن10 = قسط_تأمين(500000، 3)
    إذا (ن10 == 1500)
        نجاح = نجاح + 1
        اطبع_سطر("✓ قسط تأمين = 1500")
    وإلا
        فشل = فشل + 1
        اطبع("✗ قسط = ")
        اطبع_سطر(ن10)
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


