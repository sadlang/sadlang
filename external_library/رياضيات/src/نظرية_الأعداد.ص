    إذا (ن <= 1)
        إرجاع ن
    نهاية
    
    رقم ب2 = ن - (ن / 2) * 2
    إذا (ب2 == 0)
        إرجاع 2
    نهاية
    
    رقم ق = 3
    كرر طالما (ق * ق <= ن)
        رقم باقي = ن - (ن / ق) * ق
        إذا (باقي == 0)
            إرجاع ق
        نهاية
