**#
دالة رقم عدد_القواسم(رقم ن)
    رقم العدد = 0
    رقم ق = 1
    كرر طالما (ق * ق <= ن)
        رقم باقي = ن - (ن / ق) * ق
        إذا (باقي == 0)
            العدد = العدد + 1
            إذا (ق != ن / ق)
                العدد = العدد + 1
            نهاية
        نهاية
        ق = ق + 1
    نهاية
    إرجاع العدد
نهاية


#**
# دالة: مجموع_القواسم
