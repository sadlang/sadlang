#**
# دالة: دالة_أويلر (φ)
# الوصف: عدد الأعداد من 1 إلى ن الأولية نسبياً مع ن
**#
دالة رقم أويلر_فاي(رقم ن)
    رقم النتيجة = ن
    رقم ع = 2
    رقم القيمة = ن
    
    كرر طالما (ع * ع <= القيمة)
        رقم باقي = القيمة - (القيمة / ع) * ع
        إذا (باقي == 0)
            كرر طالما (باقي == 0)
                القيمة = القيمة / ع
                باقي = القيمة - (القيمة / ع) * ع
            نهاية
            النتيجة = النتيجة - النتيجة / ع
        نهاية
        ع = ع + 1
    نهاية
    
    إذا (القيمة > 1)
        النتيجة = النتيجة - النتيجة / القيمة
    نهاية
    
    إرجاع النتيجة
نهاية


#**
# دالة: دالة_موبيوس
# الوصف: μ(ن):
#   = 1 إذا ن = 1
#   = (-1)^ك إذا ن حاصل ضرب ك عوامل أولية مختلفة
#   = 0 إذا ن يحتوي عامل أولي مربع
**#
دالة رقم موبيوس(رقم ن)
    إذا (ن == 1)
        إرجاع 1
    نهاية
    
    رقم عدد_عوامل = 0
    رقم القيمة = ن
    رقم ع = 2
    
    كرر طالما (ع * ع <= القيمة)
        رقم باقي = القيمة - (القيمة / ع) * ع
        إذا (باقي == 0)
            القيمة = القيمة / ع
            عدد_عوامل = عدد_عوامل + 1
            
            # هل يتكرر؟
            رقم باقي2 = القيمة - (القيمة / ع) * ع
            إذا (باقي2 == 0)
                إرجاع 0  # يحتوي مربع عامل أولي
            نهاية
        نهاية
        ع = ع + 1
    نهاية
    
    إذا (القيمة > 1)
        عدد_عوامل = عدد_عوامل + 1
    نهاية
    
    # (-1)^عدد_عوامل
    رقم باقي_2 = عدد_عوامل - (عدد_عوامل / 2) * 2
    إذا (باقي_2 == 0)
        إرجاع 1
    نهاية
    إرجاع 0 - 1
نهاية


