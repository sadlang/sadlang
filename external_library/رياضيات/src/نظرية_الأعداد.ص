#**
# دالة: هل_متناظر
# الوصف: هل العدد متناظر (palindrome)
#         مثال: 121، 1331
**#
دالة رقم هل_متناظر(رقم ن)
    إذا (ن < 0)
        إرجاع 0
    نهاية
    إذا (ن == عكس_عدد(ن))
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


