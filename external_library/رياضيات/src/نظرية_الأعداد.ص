#**
# دالة: هل_أولي
# الوصف: اختبار الأولية بالقسمة التجريبية
#         نختبر القسمة على 2 ثم الأعداد الفردية حتى √ن
**#
دالة رقم هل_أولي(رقم ن)
    إذا (ن < 2)
        إرجاع 0
    نهاية
    إذا (ن == 2)
        إرجاع 1
    نهاية
    إذا (ن == 3)
        إرجاع 1
    نهاية
    
    رقم ب2 = ن - (ن / 2) * 2
    إذا (ب2 == 0)
        إرجاع 0
    نهاية
    
    رقم ب3 = ن - (ن / 3) * 3
    إذا (ب3 == 0)
        إرجاع 0
    نهاية
    
    # نختبر الأعداد من الشكل 6ك±1
    رقم ق = 5
    كرر طالما (ق * ق <= ن)
        رقم باقي1 = ن - (ن / ق) * ق
        إذا (باقي1 == 0)
            إرجاع 0
        نهاية
        
        رقم ق2 = ق + 2
        رقم باقي2 = ن - (ن / ق2) * ق2
        إذا (باقي2 == 0)
            إرجاع 0
        نهاية
        
        ق = ق + 6
    نهاية
    
    إرجاع 1
نهاية


