#**
# دالة: أكبر_عامل_أولي
# الوصف: أكبر عامل أولي للعدد ن
**#
دالة رقم أكبر_عامل(رقم ن)
    رقم القيمة = ن
    رقم أكبر = 1
    
    # إزالة عامل 2
    رقم ب2 = القيمة - (القيمة / 2) * 2
    كرر طالما (ب2 == 0)
        أكبر = 2
        القيمة = القيمة / 2
        ب2 = القيمة - (القيمة / 2) * 2
    نهاية
    
    # إزالة العوامل الفردية
    رقم ق = 3
    كرر طالما (ق * ق <= القيمة)
        رقم باقي = القيمة - (القيمة / ق) * ق
        كرر طالما (باقي == 0)
            أكبر = ق
            القيمة = القيمة / ق
            باقي = القيمة - (القيمة / ق) * ق
        نهاية
        ق = ق + 2
    نهاية
    
    إذا (القيمة > 1)
        أكبر = القيمة
    نهاية
    
    إرجاع أكبر
نهاية


#**
