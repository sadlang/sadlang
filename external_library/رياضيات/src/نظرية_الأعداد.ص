#**
# دالة: ق_م_أ (القاسم المشترك الأكبر)
# خوارزمية إقليدس
**#
دالة رقم ق_م_أ_عدد(رقم أ، رقم ب)
    رقم س = أ
    رقم ص = ب
    إذا (س < 0)
        س = 0 - س
    نهاية
    إذا (ص < 0)
        ص = 0 - ص
    نهاية
    
    كرر طالما (ص > 0)
        رقم باقي = س - (س / ص) * ص
        س = ص
        ص = باقي
    نهاية
    إرجاع س
نهاية


