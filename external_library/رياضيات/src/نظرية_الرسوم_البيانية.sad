#**
# دالة: العدد_اللوني_للرسم_الكامل
# الوصف: العدد اللوني لرسم كامل K_n هو n
**#
دالة رقم عدد_لوني_كامل(رقم ن)
    إرجاع ن
نهاية


#**
# دالة: العدد_اللوني_لدورة
# الوصف: العدد اللوني لدورة C_n:
#         2 إذا ن زوجي, 3 إذا ن فردي
**#
دالة رقم عدد_لوني_دورة(رقم ن)
    إذا (ن < 3)
        إرجاع ن
    نهاية
    رقم باقي = ن - (ن / 2) * 2
    إذا (باقي == 0)
        إرجاع 2
    نهاية
    إرجاع 3
نهاية


#**
# دالة: كثيرة_حدود_لونية_كامل
# الوصف: p(K_n, k) = k × (k-1) × (k-2) × ... × (k-n+1)
**#
دالة رقم تلوين_كامل(رقم ن، رقم ك)
    رقم النتيجة = 1
    رقم ع = 0
    كرر طالما (ع < ن)
        النتيجة = النتيجة * (ك - ع)
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: كثيرة_حدود_لونية_شجرة
# الوصف: p(T_n, k) = k × (k-1)^(n-1)
**#
دالة رقم تلوين_شجرة(رقم ن، رقم ك)
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    إذا (ن == 1)
        إرجاع ك
    نهاية
    
    رقم النتيجة = ك
    رقم ع = 1
    كرر طالما (ع < ن)
        النتيجة = النتيجة * (ك - 1)
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: كثيرة_حدود_لونية_دورة
# الوصف: p(C_n, k) = (k-1)^n + (-1)^n × (k-1)
**#
دالة رقم تلوين_دورة(رقم ن، رقم ك)
    إذا (ن < 3)
        إرجاع 0
    نهاية
    
    # (k-1)^n
    رقم الجزء1 = 1
    رقم ع = 0
    كرر طالما (ع < ن)
        الجزء1 = الجزء1 * (ك - 1)
        ع = ع + 1
    نهاية
    
    # (-1)^n × (k-1)
    رقم باقي = ن - (ن / 2) * 2
    إذا (باقي == 0)
        إرجاع الجزء1 + (ك - 1)
    وإلا
        إرجاع الجزء1 - (ك - 1)
    نهاية
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 6: رسوم بيانية خاصة                                 ║
# ║          Section 6: Special Graphs                                 ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: أقصى_حواف_رسم_بسيط
# الوصف: أقصى عدد حواف في رسم بسيط = n(n-1)/2
**#
دالة رقم أقصى_حواف(رقم ن)
    إرجاع ن * (ن - 1) / 2
نهاية


#**
# دالة: هل_أويلري
# الوصف: الرسم المتصل أويلري (دورة أويلر) إذا كل الدرجات زوجية
**#
دالة رقم هل_أويلري_3(رقم غ01، رقم غ02، رقم غ12)
    رقم د0 = درجة_3_عقدة0(غ01، غ02)
    رقم د1 = درجة_3_عقدة1(غ01، غ12)
    رقم د2 = درجة_3_عقدة2(غ02، غ12)
    
    رقم ب0 = د0 - (د0 / 2) * 2
    رقم ب1 = د1 - (د1 / 2) * 2
    رقم ب2 = د2 - (د2 / 2) * 2
    
    إذا (ب0 == 0)
        إذا (ب1 == 0)
            إذا (ب2 == 0)
                إذا (هل_متصل_3(غ01، غ02، غ12) == 1)
                    إرجاع 1
                نهاية
            نهاية
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_هاملتوني_4
# الوصف: الرسم هاملتوني إذا يحتوي على دورة تمر بجميع العقد
#         شرط ديراك: إذا درجة كل عقدة >= n/2 فالرسم هاملتوني
**#
دالة رقم ديراك_هاملتوني_4(رقم غ01، رقم غ02، رقم غ03، رقم غ12، رقم غ13، رقم غ23)
    رقم د0 = درجة_4_عقدة0(غ01، غ02، غ03)
    رقم د1 = درجة_4_عقدة1(غ01، غ12، غ13)
    رقم د2 = درجة_4_عقدة2(غ02، غ12، غ23)
    رقم د3 = درجة_4_عقدة3(غ03، غ13، غ23)
    
    # n/2 = 4/2 = 2
    إذا (د0 >= 2)
        إذا (د1 >= 2)
            إذا (د2 >= 2)
                إذا (د3 >= 2)
                    إرجاع 1
                نهاية
            نهاية
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: صيغة_أويلر_مستوي
# الوصف: لرسم مستوي متصل: V - E + F = 2
#         V = عقد, E = حواف, F = وجوه
**#
دالة رقم وجوه_مستوي(رقم عقد، رقم حواف)
    إرجاع 2 - عقد + حواف
نهاية


#**
# دالة: كثافة_الرسم
# الوصف: الكثافة = 2×E / (V×(V-1))
#         نستخدم عامل دقة ×1000
**#
دالة رقم كثافة_رسم(رقم عقد، رقم حواف)
    إذا (عقد <= 1)
        إرجاع 0
    نهاية
    رقم الأقصى = عقد * (عقد - 1) / 2
    إذا (الأقصى == 0)
        إرجاع 0
    نهاية
    إرجاع حواف * 1000 / الأقصى
نهاية


#**
# دالة: عدد_حواف_رسم_بيترسن
# الوصف: رسم بيترسن المعمم GP(n,k) له n عقد خارجية و n داخلية
#         عدد الحواف = 3n
#         رسم بيترسن الأصلي GP(5,2): 15 حافة
**#
دالة رقم حواف_بيترسن(رقم ن)
    إرجاع 3 * ن
نهاية


#**
# دالة: حواف_رسم_ثنائي_كامل
# الوصف: K_{m,n} له m×n حافة
**#
دالة رقم حواف_ثنائي_كامل(رقم م، رقم ن)
    إرجاع م * ن
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 7: الاختبارات                                       ║
# ║          Section 7: Tests                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

دالة رقم اختبار_الرسوم_البيانية()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار نظرية الرسوم البيانية")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: مثلث كامل K₃
    رقم ن1 = هل_كامل_3(1، 1، 1)
    إذا (ن1 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مثلث كامل K₃")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ مثلث كامل")
    نهاية
    
    # اختبار 2: عدد حواف K₃ = 3
    رقم ن2 = عدد_حواف_3(1، 1، 1)
    إذا (ن2 == 3)
        نجاح = نجاح + 1
        اطبع_سطر("✓ عدد حواف K₃ = 3")
    وإلا
        فشل = فشل + 1
        اطبع("✗ حواف K₃ = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: شجرة 3 عقد (مسار)
    # 0-1, 1-2 (غ01=1, غ02=0, غ12=1)
    رقم ن3 = هل_شجرة_3(1، 0، 1)
    إذا (ن3 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مسار P₃ هو شجرة")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ مسار P₃")
    نهاية
    
    # اختبار 4: أقصر مسار
    رقم ن4 = أقصر_مسار_3_من0_إلى2(1، 0، 1)  # 0-1, لا 0-2, 1-2
    إذا (ن4 == 2)
        نجاح = نجاح + 1
        اطبع_سطر("✓ أقصر مسار 0→2 عبر 1 = 2")
    وإلا
        فشل = فشل + 1
        اطبع("✗ أقصر مسار = ")
        اطبع_سطر(ن4)
    نهاية
    
    # اختبار 5: تلوين شجرة 4 عقد بـ 3 ألوان
    # p(T_4, 3) = 3 × 2³ = 24
    رقم ن5 = تلوين_شجرة(4، 3)
    إذا (ن5 == 24)
        نجاح = نجاح + 1
        اطبع_سطر("✓ تلوين T₄ بـ 3 ألوان = 24")
    وإلا
        فشل = فشل + 1
        اطبع("✗ تلوين = ")
        اطبع_سطر(ن5)
    نهاية
    
    # اختبار 6: تلوين رسم كامل K₃ بـ 3 ألوان
    # p(K_3, 3) = 3×2×1 = 6
    رقم ن6 = تلوين_كامل(3، 3)
    إذا (ن6 == 6)
        نجاح = نجاح + 1
        اطبع_سطر("✓ تلوين K₃ بـ 3 ألوان = 6")
    وإلا
        فشل = فشل + 1
        اطبع("✗ تلوين K₃ = ")
        اطبع_سطر(ن6)
    نهاية
    
    # اختبار 7: صيغة أويلر
    # مكعب: V=8, E=12 → F = 2-8+12 = 6
    رقم ن7 = وجوه_مستوي(8، 12)
    إذا (ن7 == 6)
        نجاح = نجاح + 1
        اطبع_سطر("✓ أويلر: مكعب F = 6")
    وإلا
        فشل = فشل + 1
        اطبع("✗ وجوه = ")
        اطبع_سطر(ن7)
    نهاية
    
    # اختبار 8: أقصى حواف
    رقم ن8 = أقصى_حواف(5)
    إذا (ن8 == 10)
        نجاح = نجاح + 1
        اطبع_سطر("✓ أقصى حواف K₅ = 10")
    وإلا
        فشل = فشل + 1
        اطبع("✗ أقصى حواف = ")
        اطبع_سطر(ن8)
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


