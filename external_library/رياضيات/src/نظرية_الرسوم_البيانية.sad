#**
# دالة: هل_متصل_3
# الوصف: هل الرسم البياني 3 عقد متصل
#         متصل إذا كل عقدة يمكن الوصول إليها من أي عقدة أخرى
**#
دالة رقم هل_متصل_3(رقم غ01، رقم غ02، رقم غ12)
    # إذا كانت هناك حافتان على الأقل = متصل
    رقم عدد = غ01 + غ02 + غ12
    إذا (عدد >= 2)
        إرجاع 1
    نهاية
    
    # حافة واحدة فقط = غير متصل (3 عقد)
    إذا (عدد <= 0)
        إرجاع 0
    نهاية
    
    # حافة واحدة = عقدة معزولة
    إرجاع 0
نهاية


#**
# دالة: هل_يوجد_مسار_3
# الوصف: هل يوجد مسار بين عقدتين في رسم 3 عقد
#         البحث: مباشر أو عبر العقدة الثالثة
**#
دالة رقم مسار_3_من0_إلى1(رقم غ01، رقم غ02، رقم غ12)
    # مباشر
    إذا (غ01 == 1)
        إرجاع 1
    نهاية
    # عبر 2
    إذا (غ02 == 1)
        إذا (غ12 == 1)
            إرجاع 1
        نهاية
    نهاية
    إرجاع 0
نهاية

دالة رقم مسار_3_من0_إلى2(رقم غ01، رقم غ02، رقم غ12)
    إذا (غ02 == 1)
        إرجاع 1
    نهاية
    إذا (غ01 == 1)
        إذا (غ12 == 1)
            إرجاع 1
        نهاية
    نهاية
    إرجاع 0
نهاية

دالة رقم مسار_3_من1_إلى2(رقم غ01، رقم غ02، رقم غ12)
    إذا (غ12 == 1)
        إرجاع 1
    نهاية
    إذا (غ01 == 1)
        إذا (غ02 == 1)
            إرجاع 1
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: أقصر_مسار_3_غير_موزون
# الوصف: أقصر مسار بين عقدتين في رسم 3 عقد (وزن = 1 لكل حافة)
#         يرجع عدد الحواف، أو -1 إذا لا يوجد مسار
**#
دالة رقم أقصر_مسار_3_من0_إلى1(رقم غ01، رقم غ02، رقم غ12)
    # مباشر: مسافة 1
    إذا (غ01 == 1)
        إرجاع 1
    نهاية
    # عبر 2: مسافة 2
    إذا (غ02 == 1)
        إذا (غ12 == 1)
            إرجاع 2
        نهاية
    نهاية
    إرجاع 0 - 1  # لا يوجد مسار
نهاية

دالة رقم أقصر_مسار_3_من0_إلى2(رقم غ01، رقم غ02، رقم غ12)
    إذا (غ02 == 1)
        إرجاع 1
    نهاية
    إذا (غ01 == 1)
        إذا (غ12 == 1)
            إرجاع 2
        نهاية
    نهاية
    إرجاع 0 - 1
نهاية

دالة رقم أقصر_مسار_3_من1_إلى2(رقم غ01، رقم غ02، رقم غ12)
    إذا (غ12 == 1)
        إرجاع 1
    نهاية
    إذا (غ01 == 1)
        إذا (غ02 == 1)
            إرجاع 2
        نهاية
    نهاية
    إرجاع 0 - 1
نهاية


#**
# دالة: أقصر_مسارات_4_فلويد_وارشال
# الوصف: خوارزمية فلويد-وارشال لرسم 4 عقد موزون
#         مصفوفة المسافات: م_ij = وزن الحافة أو 999999 إذا لا توجد
#         نرجع أقصر مسافة بين عقدتين محددتين
**#
دالة رقم فلويد_4_مسافة(رقم م00، رقم م01، رقم م02، رقم م03، رقم م10، رقم م11، رقم م12، رقم م13، رقم م20، رقم م21، رقم م22، رقم م23، رقم م30، رقم م31، رقم م32، رقم م33، رقم المصدر، رقم الهدف)
    
    # نسخ المصفوفة لمعالجتها
    رقم د00 = م00
    رقم د01 = م01
    رقم د02 = م02
    رقم د03 = م03
    رقم د10 = م10
    رقم د11 = م11
    رقم د12 = م12
    رقم د13 = م13
    رقم د20 = م20
    رقم د21 = م21
    رقم د22 = م22
    رقم د23 = م23
    رقم د30 = م30
    رقم د31 = م31
    رقم د32 = م32
    رقم د33 = م33
    
    # k = 0: عبر العقدة 0
    # د[i][j] = min(د[i][j], د[i][0] + د[0][j])
    إذا (د10 + د01 < د11)
        د11 = د10 + د01
    نهاية
    إذا (د10 + د02 < د12)
        د12 = د10 + د02
    نهاية
    إذا (د10 + د03 < د13)
        د13 = د10 + د03
    نهاية
    إذا (د20 + د01 < د21)
        د21 = د20 + د01
    نهاية
    إذا (د20 + د02 < د22)
        د22 = د20 + د02
    نهاية
    إذا (د20 + د03 < د23)
        د23 = د20 + د03
    نهاية
    إذا (د30 + د01 < د31)
        د31 = د30 + د01
    نهاية
    إذا (د30 + د02 < د32)
        د32 = د30 + د02
    نهاية
    إذا (د30 + د03 < د33)
        د33 = د30 + د03
    نهاية
    
    # k = 1: عبر العقدة 1
    إذا (د01 + د10 < د00)
        د00 = د01 + د10
    نهاية
    إذا (د01 + د12 < د02)
        د02 = د01 + د12
    نهاية
    إذا (د01 + د13 < د03)
        د03 = د01 + د13
    نهاية
    إذا (د21 + د10 < د20)
        د20 = د21 + د10
    نهاية
    إذا (د21 + د12 < د22)
        د22 = د21 + د12
    نهاية
    إذا (د21 + د13 < د23)
        د23 = د21 + د13
    نهاية
    إذا (د31 + د10 < د30)
        د30 = د31 + د10
    نهاية
    إذا (د31 + د12 < د32)
        د32 = د31 + د12
    نهاية
    إذا (د31 + د13 < د33)
        د33 = د31 + د13
    نهاية
    
    # k = 2: عبر العقدة 2
    إذا (د02 + د20 < د00)
        د00 = د02 + د20
    نهاية
    إذا (د02 + د21 < د01)
        د01 = د02 + د21
    نهاية
    إذا (د02 + د23 < د03)
        د03 = د02 + د23
    نهاية
    إذا (د12 + د20 < د10)
        د10 = د12 + د20
    نهاية
    إذا (د12 + د21 < د11)
        د11 = د12 + د21
    نهاية
    إذا (د12 + د23 < د13)
        د13 = د12 + د23
    نهاية
    إذا (د32 + د20 < د30)
        د30 = د32 + د20
    نهاية
    إذا (د32 + د21 < د31)
        د31 = د32 + د21
    نهاية
    إذا (د32 + د23 < د33)
        د33 = د32 + د23
    نهاية
    
    # k = 3: عبر العقدة 3
    إذا (د03 + د30 < د00)
        د00 = د03 + د30
    نهاية
    إذا (د03 + د31 < د01)
        د01 = د03 + د31
    نهاية
    إذا (د03 + د32 < د02)
        د02 = د03 + د32
    نهاية
    إذا (د13 + د30 < د10)
        د10 = د13 + د30
    نهاية
    إذا (د13 + د31 < د11)
        د11 = د13 + د31
    نهاية
    إذا (د13 + د32 < د12)
        د12 = د13 + د32
    نهاية
    إذا (د23 + د30 < د20)
        د20 = د23 + د30
    نهاية
    إذا (د23 + د31 < د21)
        د21 = د23 + د31
    نهاية
    إذا (د23 + د32 < د22)
        د22 = د23 + د32
    نهاية
    
    # إرجاع المسافة المطلوبة
    إذا (المصدر == 0)
        إذا (الهدف == 0)
            إرجاع د00
        نهاية
        إذا (الهدف == 1)
            إرجاع د01
        نهاية
        إذا (الهدف == 2)
            إرجاع د02
        نهاية
        إذا (الهدف == 3)
            إرجاع د03
        نهاية
    نهاية
    إذا (المصدر == 1)
        إذا (الهدف == 0)
            إرجاع د10
        نهاية
        إذا (الهدف == 1)
            إرجاع د11
        نهاية
        إذا (الهدف == 2)
            إرجاع د12
        نهاية
        إذا (الهدف == 3)
            إرجاع د13
        نهاية
    نهاية
    إذا (المصدر == 2)
        إذا (الهدف == 0)
            إرجاع د20
        نهاية
        إذا (الهدف == 1)
            إرجاع د21
        نهاية
        إذا (الهدف == 2)
            إرجاع د22
        نهاية
        إذا (الهدف == 3)
            إرجاع د23
        نهاية
    نهاية
    إذا (المصدر == 3)
        إذا (الهدف == 0)
            إرجاع د30
        نهاية
        إذا (الهدف == 1)
            إرجاع د31
        نهاية
        إذا (الهدف == 2)
            إرجاع د32
        نهاية
        إذا (الهدف == 3)
            إرجاع د33
        نهاية
    نهاية
    
    إرجاع 999999
نهاية


