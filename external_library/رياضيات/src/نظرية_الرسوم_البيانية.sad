#**
# دالة: هل_شجرة_3
# الوصف: الرسم البياني المتصل شجرة إذا عدد حوافه = عدد عقده - 1
#         3 عقد: شجرة إذا حافتان بالضبط ومتصل
**#
دالة رقم هل_شجرة_3(رقم غ01، رقم غ02، رقم غ12)
    رقم حواف = عدد_حواف_3(غ01، غ02، غ12)
    رقم متصل = هل_متصل_3(غ01، غ02، غ12)
    إذا (حواف == 2)
        إذا (متصل == 1)
            إرجاع 1
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_شجرة_4
# الوصف: 4 عقد: شجرة إذا 3 حواف ومتصل
**#
دالة رقم هل_شجرة_4(رقم غ01، رقم غ02، رقم غ03، رقم غ12، رقم غ13، رقم غ23)
    رقم حواف = عدد_حواف_4(غ01، غ02، غ03، غ12، غ13، غ23)
    إذا (حواف == 3)
        # نتحقق من الاتصال
        # 4 عقد و3 حواف: شجرة إذا لا توجد عقدة معزولة
        رقم د0 = درجة_4_عقدة0(غ01، غ02، غ03)
        رقم د1 = درجة_4_عقدة1(غ01، غ12، غ13)
        رقم د2 = درجة_4_عقدة2(غ02، غ12، غ23)
        رقم د3 = درجة_4_عقدة3(غ03، غ13، غ23)
        
        إذا (د0 >= 1)
            إذا (د1 >= 1)
                إذا (د2 >= 1)
                    إذا (د3 >= 1)
                        إرجاع 1
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_ورقة_4
# الوصف: هل العقدة ورقة (درجتها = 1)
**#
دالة رقم هل_ورقة_4_عقدة0(رقم غ01، رقم غ02، رقم غ03)
    رقم د = درجة_4_عقدة0(غ01، غ02، غ03)
    إذا (د == 1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية

دالة رقم هل_ورقة_4_عقدة1(رقم غ01، رقم غ12، رقم غ13)
    رقم د = درجة_4_عقدة1(غ01، غ12، غ13)
    إذا (د == 1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية

دالة رقم هل_ورقة_4_عقدة2(رقم غ02، رقم غ12، رقم غ23)
    رقم د = درجة_4_عقدة2(غ02، غ12، غ23)
    إذا (د == 1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية

دالة رقم هل_ورقة_4_عقدة3(رقم غ03، رقم غ13، رقم غ23)
    رقم د = درجة_4_عقدة3(غ03، غ13، غ23)
    إذا (د == 1)
        إرجاع 1
