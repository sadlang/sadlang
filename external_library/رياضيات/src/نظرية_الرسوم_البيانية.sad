#**
# دالة: درجة_عقدة_3
# الوصف: درجة العقدة i في رسم 3 عقد
**#
دالة رقم درجة_3_عقدة0(رقم غ01، رقم غ02)
    إرجاع غ01 + غ02
نهاية

دالة رقم درجة_3_عقدة1(رقم غ01، رقم غ12)
    إرجاع غ01 + غ12
نهاية

دالة رقم درجة_3_عقدة2(رقم غ02، رقم غ12)
    إرجاع غ02 + غ12
نهاية


#**
# دالة: درجة_عقدة_4
# الوصف: درجة كل عقدة في رسم 4 عقد
**#
دالة رقم درجة_4_عقدة0(رقم غ01، رقم غ02، رقم غ03)
    إرجاع غ01 + غ02 + غ03
نهاية

دالة رقم درجة_4_عقدة1(رقم غ01، رقم غ12، رقم غ13)
    إرجاع غ01 + غ12 + غ13
نهاية

دالة رقم درجة_4_عقدة2(رقم غ02، رقم غ12، رقم غ23)
    إرجاع غ02 + غ12 + غ23
نهاية

دالة رقم درجة_4_عقدة3(رقم غ03، رقم غ13، رقم غ23)
    إرجاع غ03 + غ13 + غ23
نهاية


#**
# دالة: مجموع_الدرجات_3
# الوصف: مجموع درجات جميع العقد = 2 × عدد الحواف
**#
دالة رقم مجموع_درجات_3(رقم غ01، رقم غ02، رقم غ12)
    إرجاع 2 * عدد_حواف_3(غ01، غ02، غ12)
نهاية


#**
# دالة: مجموع_الدرجات_4
**#
دالة رقم مجموع_درجات_4(رقم غ01، رقم غ02، رقم غ03، رقم غ12، رقم غ13، رقم غ23)
    إرجاع 2 * عدد_حواف_4(غ01، غ02، غ03، غ12، غ13، غ23)
نهاية


#**
# دالة: هل_كامل_3
# الوصف: هل الرسم المكون من 3 عقد كامل (كل عقدتين متصلتان)
**#
دالة رقم هل_كامل_3(رقم غ01، رقم غ02، رقم غ12)
    إذا (غ01 == 1)
        إذا (غ02 == 1)
            إذا (غ12 == 1)
                إرجاع 1
            نهاية
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_كامل_4
# الوصف: هل الرسم المكون من 4 عقد كامل
**#
دالة رقم هل_كامل_4(رقم غ01، رقم غ02، رقم غ03، رقم غ12، رقم غ13، رقم غ23)
    رقم المجموع = غ01 + غ02 + غ03 + غ12 + غ13 + غ23
    إذا (المجموع == 6)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_منتظم_3
# الوصف: هل الرسم المكون من 3 عقد منتظم (جميع الدرجات متساوية)
**#
دالة رقم هل_منتظم_3(رقم غ01، رقم غ02، رقم غ12)
    رقم د0 = درجة_3_عقدة0(غ01، غ02)
    رقم د1 = درجة_3_عقدة1(غ01، غ12)
    رقم د2 = درجة_3_عقدة2(غ02، غ12)
    
    إذا (د0 == د1)
        إذا (د1 == د2)
            إرجاع 1
        نهاية
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_ثنائي_التجزئة_3
# الوصف: هل يمكن تقسيم العقد إلى مجموعتين بحيث لا توجد
#         حافة بين عقدتين في نفس المجموعة
#         لـ 3 عقد: ممكن إذا لم يكن هناك مثلث كامل
**#
دالة رقم هل_ثنائي_3(رقم غ01، رقم غ02، رقم غ12)
    # إذا كانت الثلاث حواف موجودة = مثلث = ليس ثنائي
    إذا (غ01 == 1)
        إذا (غ02 == 1)
            إذا (غ12 == 1)
                إرجاع 0
            نهاية
        نهاية
    نهاية
    إرجاع 1
نهاية


#**
# دالة: عدد_المثلثات_4
# الوصف: عدد المثلثات في رسم من 4 عقد
#         نفحص كل ثلاثية
**#
دالة رقم عدد_مثلثات_4(رقم غ01، رقم غ02، رقم غ03، رقم غ12، رقم غ13، رقم غ23)
    رقم العدد = 0
    
    # المثلث (0,1,2)
    إذا (غ01 == 1)
        إذا (غ02 == 1)
            إذا (غ12 == 1)
                العدد = العدد + 1
            نهاية
        نهاية
    نهاية
    
    # المثلث (0,1,3)
    إذا (غ01 == 1)
        إذا (غ03 == 1)
            إذا (غ13 == 1)
                العدد = العدد + 1
            نهاية
        نهاية
    نهاية
    
    # المثلث (0,2,3)
    إذا (غ02 == 1)
        إذا (غ03 == 1)
            إذا (غ23 == 1)
                العدد = العدد + 1
            نهاية
        نهاية
    نهاية
    
    # المثلث (1,2,3)
    إذا (غ12 == 1)
        إذا (غ13 == 1)
            إذا (غ23 == 1)
                العدد = العدد + 1
            نهاية
        نهاية
    نهاية
    
    إرجاع العدد
نهاية


