#**
# دالة: عدد_الأوراق_4
# الوصف: عدد الأوراق في شجرة 4 عقد
**#
دالة رقم عدد_أوراق_4(رقم غ01، رقم غ02، رقم غ03، رقم غ12، رقم غ13، رقم غ23)
    رقم ع = 0
    ع = ع + هل_ورقة_4_عقدة0(غ01، غ02، غ03)
    ع = ع + هل_ورقة_4_عقدة1(غ01، غ12، غ13)
    ع = ع + هل_ورقة_4_عقدة2(غ02، غ12، غ23)
    ع = ع + هل_ورقة_4_عقدة3(غ03، غ13، غ23)
    إرجاع ع
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 5: خوارزميات التلوين                                ║
# ║          Section 5: Graph Coloring                                 ║
