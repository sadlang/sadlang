#**
# دالة: عدد_الحواف_3
# الوصف: عدد حواف رسم بياني 3 عقد (غير موجه)
#         نعد الحواف في النصف العلوي فقط
**#
دالة رقم عدد_حواف_3(رقم غ01، رقم غ02، رقم غ12)
    إرجاع غ01 + غ02 + غ12
نهاية


#**
# دالة: عدد_الحواف_4
# الوصف: عدد حواف رسم بياني 4 عقد
**#
دالة رقم عدد_حواف_4(رقم غ01، رقم غ02، رقم غ03، رقم غ12، رقم غ13، رقم غ23)
    إرجاع غ01 + غ02 + غ03 + غ12 + غ13 + غ23
نهاية


#**
# دالة: عدد_الحواف_5
# الوصف: عدد حواف رسم بياني 5 عقد
**#
دالة رقم عدد_حواف_5(رقم غ01، رقم غ02، رقم غ03، رقم غ04، رقم غ12، رقم غ13، رقم غ14، رقم غ23، رقم غ24، رقم غ34)
    إرجاع غ01 + غ02 + غ03 + غ04 + غ12 + غ13 + غ14 + غ23 + غ24 + غ34
نهاية


