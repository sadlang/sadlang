# ║          القسم 7: المقاطع المخروطية                                ║
# ║          Section 7: Conic Sections                                 ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# المقاطع المخروطية:
# 1. القطع الناقص: (س/أ)² + (ص/ب)² = 1
# 2. القطع الزائد: (س/أ)² - (ص/ب)² = 1
# 3. القطع المكافئ: ص = أ×س²
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: مساحة_قطع_ناقص
# الوصف: مساحة القطع الناقص = π × أ × ب
**#
دالة رقم مساحة_قطع_ناقص(رقم نصف_محور_كبير، رقم نصف_محور_صغير)
    إرجاع 3141593 * نصف_محور_كبير * نصف_محور_صغير / 1000000
نهاية


#**
# دالة: الاختلاف_المركزي
# الوصف: ε = √(1 - (ب/أ)²) (للقطع الناقص، أ > ب)
# الإرجاع: ε² × 10^6
**#
دالة رقم اختلاف_مركزي_مربع(رقم نصف_كبير، رقم نصف_صغير)
    رقم ع = 1000000
    إرجاع ع - (نصف_صغير * نصف_صغير * ع / (نصف_كبير * نصف_كبير))
نهاية


#**
# دالة: بؤرة_قطع_ناقص
# الوصف: المسافة البؤرية ج² = أ² - ب²
**#
دالة رقم بؤرة_ناقص_مربع(رقم نصف_كبير، رقم نصف_صغير)
    إرجاع نصف_كبير * نصف_كبير - نصف_صغير * نصف_صغير
نهاية


#**
# دالة: هل_نقطة_داخل_قطع_ناقص
# الوصف: (س/أ)² + (ص/ب)² ≤ 1
**#
دالة رقم هل_نقطة_داخل_ناقص(رقم أ، رقم ب، رقم س، رقم ص)
    رقم قيمة = س * س * ب * ب + ص * ص * أ * أ
    إذا (قيمة <= أ * أ * ب * ب)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: بؤرة_مكافئ
# الوصف: بؤرة القطع المكافئ ص = أ×س²
#         البعد البؤري = 1/(4أ)
# الإرجاع: البعد البؤري × عامل_دقة
**#
دالة رقم بؤرة_مكافئ(رقم أ)
    رقم ع = 1000000
    إذا (أ == 0)
        إرجاع 0
    نهاية
    إرجاع ع * ع / (4 * أ)
نهاية


