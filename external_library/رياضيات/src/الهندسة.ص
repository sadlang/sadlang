#**
# دالة: مساحة_قطعة_دائرية
# الوصف: مساحة القطعة = مساحة القطاع - مساحة المثلث
#         = ½نق²(θ - sin(θ))  حيث θ بالراديان
# هنا نستخدم التقريب عبر الفرق
**#
دالة رقم مساحة_قطعة_دائرية(رقم نق، رقم زاوية_درجات)
    رقم قطاع = مساحة_قطاع(نق، زاوية_درجات)
    # مساحة المثلث = ½ نق² sin(θ)
    رقم ع = 1000000
    # تقريب إضافي: نطرح مساحة المثلث المتساوي الساقين
    رقم مثلث = نق * نق / 2
    إرجاع قطاع - مثلث
نهاية


