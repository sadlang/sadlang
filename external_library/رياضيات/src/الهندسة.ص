#**
# دالة: انسحاب_س / _ص
# الوصف: الانسحاب (الترجمة): نقل نقطة بمقدار (هـ، ك)
#         (س، ص) → (س+هـ، ص+ك)
**#
دالة رقم انسحاب_س(رقم س، رقم هـ)
    إرجاع س + هـ
نهاية

دالة رقم انسحاب_ص(رقم ص، رقم ك)
    إرجاع ص + ك
نهاية


#**
# دالة: انعكاس_محور_س
# الوصف: (س، ص) → (س، -ص)
**#
دالة رقم انعكاس_محور_س_ص(رقم ص)
    إرجاع 0 - ص
نهاية

#** انعكاس حول محور ص: (س، ص) → (-س، ص) **#
دالة رقم انعكاس_محور_ص_س(رقم س)
    إرجاع 0 - س
نهاية

#** انعكاس حول الأصل: (س، ص) → (-س، -ص) **#
دالة رقم انعكاس_أصل_س(رقم س)
    إرجاع 0 - س
نهاية

دالة رقم انعكاس_أصل_ص(رقم ص)
    إرجاع 0 - ص
نهاية

#** انعكاس حول ص=س: (س، ص) → (ص، س) **#
دالة رقم انعكاس_ص_يساوي_س_س(رقم ص)
    إرجاع ص
نهاية

دالة رقم انعكاس_ص_يساوي_س_ص(رقم س)
    إرجاع س
نهاية


#**
# دالة: تمدد_س / _ص
# الوصف: التمدد (Scale) بمعامل ك من الأصل
#         (س، ص) → (ك×س، ك×ص)
**#
دالة رقم تمدد_س(رقم س، رقم ك)
    إرجاع س * ك
نهاية

دالة رقم تمدد_ص(رقم ص، رقم ك)
    إرجاع ص * ك
نهاية

#** تمدد من نقطة مركزية **#
دالة رقم تمدد_من_نقطة_س(رقم س، رقم هـ، رقم ك)
    إرجاع هـ + (س - هـ) * ك
نهاية

دالة رقم تمدد_من_نقطة_ص(رقم ص، رقم ك_مركز، رقم معامل)
    إرجاع ك_مركز + (ص - ك_مركز) * معامل
نهاية


