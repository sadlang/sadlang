#** الأسطوانة: V = π×نق²×ع **#
دالة رقم حجم_أسطوانة(رقم نق، رقم ارتفاع)
    إرجاع 3141593 * نق * نق * ارتفاع / 1000000
نهاية

#** مساحة السطح الجانبي = 2π×نق×ع **#
دالة رقم مساحة_جانبية_أسطوانة(رقم نق، رقم ارتفاع)
    إرجاع 6283185 * نق * ارتفاع / 1000000
نهاية

#** مساحة السطح الكلية = 2π×نق(نق+ع) **#
دالة رقم مساحة_كلية_أسطوانة(رقم نق، رقم ارتفاع)
    إرجاع 6283185 * نق * (نق + ارتفاع) / 1000000
نهاية


# ═══════════════════════════════════════════════════════════════
# §6.4 - المخروط
# ═══════════════════════════════════════════════════════════════

#** V = ⅓ π نق² ع **#
دالة رقم حجم_مخروط(رقم نق، رقم ارتفاع)
    إرجاع 3141593 * نق * نق * ارتفاع / (3 * 1000000)
نهاية

#** المساحة الجانبية = π × نق × ل (ل = المائل) **#
#** ل² = نق² + ع² **#
دالة رقم طول_مائل_مخروط_مربع(رقم نق، رقم ارتفاع)
    إرجاع نق * نق + ارتفاع * ارتفاع
نهاية


