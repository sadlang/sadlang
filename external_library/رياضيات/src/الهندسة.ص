    رقم مسافة_مربع = (س - هـ) * (س - هـ) + (ص - ك) * (ص - ك)
    إذا (مسافة_مربع <= نق * نق)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_دائرتان_متقاطعتان
# الوصف: هل دائرتان تتقاطعان
# المدخلات: مراكز وأنصاف أقطار الدائرتين
# الإرجاع: 0=لا تتقاطعان، 1=تتقاطعان، 2=تتماسان
**#
دالة رقم علاقة_دائرتين(رقم هـ1، رقم ك1، رقم نق1، رقم هـ2، رقم ك2، رقم نق2)
    رقم مسافة_مربع = (هـ2 - هـ1) * (هـ2 - هـ1) + (ك2 - ك1) * (ك2 - ك1)
    رقم مجموع_أنصاف = نق1 + نق2
    رقم فرق_أنصاف = نق1 - نق2
    إذا (فرق_أنصاف < 0)
        فرق_أنصاف = 0 - فرق_أنصاف
    نهاية
    
    إذا (مسافة_مربع == مجموع_أنصاف * مجموع_أنصاف)
        إرجاع 2  # متماسان خارجياً
    نهاية
    
    إذا (مسافة_مربع == فرق_أنصاف * فرق_أنصاف)
        إرجاع 2  # متماسان داخلياً
    نهاية
    
    إذا (مسافة_مربع < مجموع_أنصاف * مجموع_أنصاف)
        إذا (مسافة_مربع > فرق_أنصاف * فرق_أنصاف)
            إرجاع 1  # متقاطعتان
        نهاية
    نهاية
    
    إرجاع 0  # لا تتقاطعان
نهاية


