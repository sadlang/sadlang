#**
# طريقة القوة (Power Iteration):
# ────────────────────────────────
# خوارزمية تكرارية لإيجاد القيمة الذاتية الأكبر مطلقاً
# والمتجه الذاتي المقابل لها.
#
# الخوارزمية:
# 1. ابدأ بمتجه عشوائي v₀
# 2. كرر: v_{k+1} = A*v_k / ||A*v_k||
# 3. λ ≈ v^T * A * v / v^T * v (حاصل رايلي)
#
# الشروط:
# - المصفوفة يجب أن تكون قابلة للتقطيع (diagonalizable)
# - القيمة الذاتية المسيطرة يجب أن تكون وحيدة
#
# معدل التقارب:
# - يعتمد على النسبة |λ₂/λ₁| حيث λ₁ أكبر و λ₂ ثاني أكبر
# - كلما كانت النسبة أصغر، كان التقارب أسرع
**#


#**
# دالة: طريقة_القوة_2×2
# الوصف: إيجاد القيمة الذاتية المسيطرة لمصفوفة 2×2
#         باستخدام طريقة القوة التكرارية
# المعاملات:
#   - أ، ب، ج، د: عناصر المصفوفة
#   - تكرارات: عدد التكرارات (أكثر = أدق)
# الإرجاع: القيمة الذاتية المسيطرة مكبرة ×1000
**#
دالة رقم طريقة_القوة_2×2(رقم أ، رقم ب، رقم ج، رقم د، رقم تكرارات)
    # متجه ابتدائي [1000, 1000] (مكبر ×1000)
    متغير رقم س1 = 1000
    متغير رقم س2 = 1000
    متغير رقم لامبدا = 0
    
    متغير رقم ع = 0
    طالما (ع < تكرارات)
        # حاصل ضرب: y = A * x
        متغير رقم ص1 = أ * س1 + ب * س2
        متغير رقم ص2 = ج * س1 + د * س2
        
        # إيجاد العنصر الأكبر مطلقاً للتطبيع
        متغير رقم أكبر = ص1
        إذا (أكبر < 0)
            أكبر = 0 - أكبر
        نهاية
        متغير رقم مطلق_ص2 = ص2
        إذا (مطلق_ص2 < 0)
            مطلق_ص2 = 0 - مطلق_ص2
        نهاية
        إذا (مطلق_ص2 > أكبر)
            أكبر = مطلق_ص2
        نهاية
        
        إذا (أكبر == 0)
            إرجاع 0
        نهاية
        
        # القيمة الذاتية = العنصر الأكبر / 1000 (لأن x مكبر)
        لامبدا = (أكبر * 1000) / 1000
        
        # التطبيع: x = y / max(y)
        س1 = (ص1 * 1000) / أكبر
        س2 = (ص2 * 1000) / أكبر
        
        ع = ع + 1
    نهاية
    
    إرجاع لامبدا
نهاية


#**
# دالة: حاصل_رايلي_2×2
# الوصف: حساب حاصل رايلي (Rayleigh Quotient) لتقدير القيمة الذاتية
#         R(A, v) = v^T * A * v / v^T * v
#         حاصل رايلي يعطي أفضل تقدير للقيمة الذاتية المقابلة لمتجه معين
# المعاملات:
#   - أ، ب، ج، د: عناصر المصفوفة
#   - س1، س2: مركبات المتجه
# الإرجاع: حاصل رايلي مكبر ×1000
**#
دالة رقم حاصل_رايلي_2×2(رقم أ، رقم ب، رقم ج، رقم د، رقم س1، رقم س2)
    # البسط: v^T * A * v
    متغير رقم ص1 = أ * س1 + ب * س2
    متغير رقم ص2 = ج * س1 + د * س2
    متغير رقم بسط = س1 * ص1 + س2 * ص2
    
    # المقام: v^T * v
    متغير رقم مقام = س1 * س1 + س2 * س2
    
    إذا (مقام == 0)
        إرجاع 0
    نهاية
    
    إرجاع (بسط * 1000) / مقام
نهاية


