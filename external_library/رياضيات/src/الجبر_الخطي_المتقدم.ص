نهاية


#**
# دالة: بارسيفال_تحقق
# الوصف: التحقق من نظرية بارسيفال
#         Σ|x[n]|² = (1/N)Σ|X[k]|²
#         طاقة المجال الزمني = طاقة المجال الترددي
# المعاملات:
#   - طاقة_زمنية: طاقة في المجال الزمني
#   - طاقة_ترددية: طاقة في المجال الترددي / N
# الإرجاع: 1 إذا متساوية (تقريباً)، 0 غير ذلك
**#
دالة رقم بارسيفال_تحقق(رقم طاقة_زمنية، رقم طاقة_ترددية)
    متغير رقم فرق = طاقة_زمنية - طاقة_ترددية
    إذا (فرق < 0)
        فرق = 0 - فرق
    نهاية
    # سماح بخطأ 1%
    متغير رقم حد = طاقة_زمنية / 100
    إذا (حد < 0)
        حد = 0 - حد
    نهاية
    إذا (حد < 1)
        حد = 1
    نهاية
    إذا (فرق <= حد)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


