#** ─────────────────────────────────────────────────────────────────
# تحليل المصفوفات هو عملية تفكيك مصفوفة إلى حاصل ضرب مصفوفتين
# أو أكثر. هذه التقنية أساسية في حل أنظمة المعادلات الخطية
# وحساب القيم الذاتية وحل مسائل المربعات الصغرى.
#
# أهم أنواع التحليل:
# 1. تحليل LU: تحليل المصفوفة إلى مصفوفة مثلثية سفلى L
#    ومصفوفة مثلثية عليا U بحيث A = LU
# 2. تحليل LDU: مشابه لـ LU مع مصفوفة قطرية D
# 3. تحليل Cholesky: لمصفوفات موجبة التعريف متماثلة A = LL^T
# 4. تحليل QR: تحليل إلى مصفوفة متعامدة Q ومثلثية عليا R
# ────────────────────────────────────────────────────────────────── **#


# ═══════════════════════════════════════════════════════════════
# §1.1 - تحليل LU (LU Decomposition)
# ═══════════════════════════════════════════════════════════════

#**
# دالة: مصفوفة_صفرية_مربعة
# الوصف: إنشاء مصفوفة مربعة من الأصفار بحجم n×n
#         نستخدم تمثيل مسطح (flat array) حيث العنصر [i][j]
#         يكون في الموقع i*n + j
# المعاملات:
#   - ح: حجم المصفوفة (عدد الصفوف = عدد الأعمدة)
# الإرجاع: 0 (تهيئة ناجحة)
# ملاحظة: المصفوفات تُخزن كمصفوفات أحادية البعد
#         باستخدام فهرسة الصف الرئيسي (Row-major order)
#         أي العنصر (i,j) يُخزن في الموقع i*n + j
**#
دالة رقم مصفوفة_صفرية_مربعة(رقم ح)
    # إنشاء مصفوفة بحجم ح × ح مملوءة بأصفار
    متغير رقم الحجم = ح * ح
    متغير رقم ع = 0
    طالما (ع < الحجم)
        # كل عنصر يبدأ بصفر
        ع = ع + 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: فهرس_مصفوفة
# الوصف: حساب الفهرس في المصفوفة المسطحة من إحداثيات الصف والعمود
#         هذه دالة مساعدة أساسية تُستخدم في جميع عمليات المصفوفات
# المعاملات:
#   - صف: رقم الصف (يبدأ من 0)
#   - عمود: رقم العمود (يبدأ من 0)
#   - عدد_الأعمدة: عدد أعمدة المصفوفة
# الإرجاع: الفهرس في المصفوفة المسطحة
# مثال: فهرس_مصفوفة(2, 3, 5) = 2*5+3 = 13
**#
دالة رقم فهرس_مصفوفة(رقم صف، رقم عمود، رقم عدد_الأعمدة)
    إرجاع صف * عدد_الأعمدة + عمود
نهاية


#**
# دالة: تحليل_لو_2×2
# الوصف: تحليل LU لمصفوفة 2×2
#         إذا كانت A = [[أ، ب]، [ج، د]]
#         فإن L = [[1، 0]، [ج/أ، 1]]
#         و U = [[أ، ب]، [0، د - ب*ج/أ]]
#         لاحظ أن هذا يفترض أن أ ≠ 0 (لا حاجة لتبديل صفوف)
# المعاملات:
#   - أ11: العنصر (1,1)
#   - أ12: العنصر (1,2)
#   - أ21: العنصر (2,1)
#   - أ22: العنصر (2,2)
# الإرجاع: عنصر L21 (المعامل الوحيد غير التافه في L)
# ملاحظة: U11=أ11، U12=أ12، U22=أ22 - أ12*L21
**#
دالة رقم تحليل_لو_2×2(رقم أ11، رقم أ12، رقم أ21، رقم أ22)
    # التحقق من أن العنصر القطري الأول ليس صفراً
    إذا (أ11 == 0)
        # لا يمكن التحليل بدون تبديل صفوف
        إرجاع -999999
    نهاية
    
    # حساب معامل المضاعف L21 = A21 / A11
    # نستخدم الأرقام المكبرة للدقة (×1000)
    متغير رقم ل21_مكبر = (أ21 * 1000) / أ11
    
    # حساب U22 = A22 - L21 * A12
    # U22 = A22 - (A21/A11) * A12
    متغير رقم يو22_مكبر = (أ22 * 1000) - (ل21_مكبر * أ12) / 1000
    
    # إرجاع المعامل L21 (مكبر ×1000)
    إرجاع ل21_مكبر
نهاية


#**
# دالة: تحليل_لو_يو22
# الوصف: حساب عنصر U22 في تحليل LU لمصفوفة 2×2
#         U22 = A22 - (A21 * A12) / A11
#         هذا العنصر هو المحور الثاني في عملية الحذف الغاوسي
# المعاملات:
#   - أ11، أ12، أ21، أ22: عناصر المصفوفة الأصلية
# الإرجاع: قيمة U22 (مكبرة ×1000)
**#
دالة رقم تحليل_لو_يو22(رقم أ11، رقم أ12، رقم أ21، رقم أ22)
    إذا (أ11 == 0)
        إرجاع -999999
    نهاية
    # U22 = A22 - (A21 * A12) / A11
    متغير رقم حاصل = (أ21 * أ12 * 1000) / أ11
    متغير رقم يو22 = أ22 * 1000 - حاصل
    إرجاع يو22
نهاية


#**
# دالة: تحليل_لو_3×3_ل21
# الوصف: حساب المعامل L21 في تحليل LU لمصفوفة 3×3
#         L21 = A21 / A11
#         هذا هو أول معامل مضاعف في عملية الحذف الغاوسي
# المعاملات:
#   - أ21: العنصر في الصف الثاني والعمود الأول
#   - أ11: العنصر المحوري (Pivot) في الصف الأول والعمود الأول
# الإرجاع: L21 مكبر ×10000
**#
دالة رقم تحليل_لو_3×3_ل21(رقم أ21، رقم أ11)
    إذا (أ11 == 0)
        إرجاع -999999
    نهاية
    إرجاع (أ21 * 10000) / أ11
نهاية


#**
# دالة: تحليل_لو_3×3_ل31
# الوصف: حساب المعامل L31 في تحليل LU لمصفوفة 3×3
#         L31 = A31 / A11
# المعاملات:
#   - أ31: العنصر في الصف الثالث والعمود الأول
#   - أ11: العنصر المحوري الأول
# الإرجاع: L31 مكبر ×10000
**#
دالة رقم تحليل_لو_3×3_ل31(رقم أ31، رقم أ11)
    إذا (أ11 == 0)
        إرجاع -999999
    نهاية
    إرجاع (أ31 * 10000) / أ11
نهاية


#**
# دالة: تحليل_لو_3×3_ل32
# الوصف: حساب المعامل L32 في تحليل LU لمصفوفة 3×3
#         L32 = (A32 - L31*U12) / U22
#         حيث U12 = A12 و U22 = A22 - L21*A12
# المعاملات:
#   - أ32: العنصر الأصلي (3,2)
#   - ل31_مكبر: L31 مكبر ×10000
#   - أ12: العنصر الأصلي (1,2)
#   - يو22_مكبر: U22 مكبر ×10000
# الإرجاع: L32 مكبر ×10000
**#
دالة رقم تحليل_لو_3×3_ل32(رقم أ32، رقم ل31_مكبر، رقم أ12، رقم يو22_مكبر)
    إذا (يو22_مكبر == 0)
        إرجاع -999999
    نهاية
    # البسط = A32 - L31*A12 (مكبر ×10000)
    متغير رقم بسط = أ32 * 10000 - (ل31_مكبر * أ12) / 1
    # L32 = بسط / U22
    متغير رقم ل32 = (بسط * 10000) / يو22_مكبر
    إرجاع ل32
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.2 - الحذف الغاوسي (Gaussian Elimination)
# ═══════════════════════════════════════════════════════════════

#**
# الحذف الغاوسي:
# ────────────────
# خوارزمية أساسية في الجبر الخطي لحل أنظمة المعادلات الخطية
# وحساب رتبة المصفوفة ومحددها.
# 
# الفكرة: تحويل المصفوفة إلى شكل مثلثي علوي (درجي)
# باستخدام عمليات الصفوف الأولية:
#   1. تبديل صفين
#   2. ضرب صف في ثابت غير صفري
#   3. إضافة مضاعف صف إلى صف آخر
#
# التعقيد الزمني: O(n³)
# التعقيد المكاني: O(n²)
#
# خطوات الخوارزمية:
# 1. لكل عمود k من 0 إلى n-1:
#    أ. اختر المحور (العنصر الأكبر في العمود) - اختياري لكن مهم
#    ب. بدّل الصفوف إن لزم الأمر
#    ج. لكل صف i > k:
#       - احسب المضاعف m = A[i][k] / A[k][k]
#       - اطرح m * الصف k من الصف i
# 2. استخدم التعويض العكسي لحل النظام
**#


#**
# دالة: حذف_غاوسي_2×2
# الوصف: حل نظام معادلتين خطيتين بمجهولين باستخدام الحذف الغاوسي
#         أ1*س + ب1*ص = ج1
#         أ2*س + ب2*ص = ج2
# المعاملات:
#   - أ1، ب1، ج1: معاملات المعادلة الأولى
#   - أ2، ب2، ج2: معاملات المعادلة الثانية
# الإرجاع: قيمة المتغير الأول (س) مكبرة ×1000
# مثال: 2*س + 3*ص = 8, 4*س + ص = 2 → س = -2/10 * 1000 = -200
**#
دالة رقم حذف_غاوسي_2×2_س(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    # التحقق من المحور
    إذا (أ1 == 0)
        # تبديل المعادلتين
        إذا (أ2 == 0)
            # النظام ليس له حل وحيد
            إرجاع -999999
        نهاية
        # بعد التبديل
        متغير رقم م = (أ1 * 10000) / أ2
        متغير رقم ب_جديد = ب1 * 10000 - م * ب2
        متغير رقم ج_جديد = ج1 * 10000 - م * ج2
        إذا (ب_جديد == 0)
            إرجاع -999999
        نهاية
        متغير رقم ص = (ج_جديد * 1000) / ب_جديد
        متغير رقم س = ((ج2 * 1000) - ب2 * ص) / أ2
        إرجاع س
    نهاية
    
    # حساب المضاعف: م = أ2/أ1
    متغير رقم مضاعف = (أ2 * 10000) / أ1
    
    # الصف الثاني الجديد: ب2' = ب2 - مضاعف*ب1
    متغير رقم ب2_جديد = ب2 * 10000 - مضاعف * ب1
    
    # ج2' = ج2 - مضاعف*ج1
    متغير رقم ج2_جديد = ج2 * 10000 - مضاعف * ج1
    
    # حل ص = ج2'/ب2'
    إذا (ب2_جديد == 0)
        إرجاع -999999
    نهاية
    متغير رقم ص_حل = (ج2_جديد * 1000) / ب2_جديد
    
    # حل س = (ج1 - ب1*ص) / أ1
    متغير رقم س_حل = (ج1 * 1000 - ب1 * ص_حل) / أ1
    
    إرجاع س_حل
نهاية


#**
# دالة: حذف_غاوسي_2×2_ص
# الوصف: حل نظام معادلتين خطيتين - إرجاع قيمة ص
#         أ1*س + ب1*ص = ج1
#         أ2*س + ب2*ص = ج2
# المعاملات: نفس معاملات حذف_غاوسي_2×2_س
# الإرجاع: قيمة المتغير الثاني (ص) مكبرة ×1000
**#
دالة رقم حذف_غاوسي_2×2_ص(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    إذا (أ1 == 0)
        إذا (أ2 == 0)
            إرجاع -999999
        نهاية
        إرجاع (ج2 * 1000 - أ2 * حذف_غاوسي_2×2_س(أ2، ب2، ج2، أ1، ب1، ج1)) / ب2
    نهاية
    
    متغير رقم مضاعف = (أ2 * 10000) / أ1
    متغير رقم ب2_جديد = ب2 * 10000 - مضاعف * ب1
    متغير رقم ج2_جديد = ج2 * 10000 - مضاعف * ج1
    
    إذا (ب2_جديد == 0)
        إرجاع -999999
    نهاية
    
    إرجاع (ج2_جديد * 1000) / ب2_جديد
نهاية


#**
# دالة: حذف_غاوسي_3×3_محدد
# الوصف: حساب محدد مصفوفة 3×3 باستخدام الحذف الغاوسي
#         المحدد = حاصل ضرب العناصر القطرية بعد التحويل إلى
#         شكل مثلثي علوي (مع مراعاة إشارة تبديل الصفوف)
# المعاملات: 9 عناصر المصفوفة (أ11 إلى أ33)
# الإرجاع: قيمة المحدد
# التعقيد: O(n³) لكن هنا n=3 ثابت
**#
دالة رقم حذف_غاوسي_3×3_محدد(رقم أ11، رقم أ12، رقم أ13، رقم أ21، رقم أ22، رقم أ23، رقم أ31، رقم أ32، رقم أ33)
    # استخدام قاعدة ساروس المباشرة (أبسط لـ 3×3)
    # det = أ11*(أ22*أ33 - أ23*أ32) - أ12*(أ21*أ33 - أ23*أ31) + أ13*(أ21*أ32 - أ22*أ31)
    متغير رقم حد1 = أ11 * (أ22 * أ33 - أ23 * أ32)
    متغير رقم حد2 = أ12 * (أ21 * أ33 - أ23 * أ31)
    متغير رقم حد3 = أ13 * (أ21 * أ32 - أ22 * أ31)
    إرجاع حد1 - حد2 + حد3
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.3 - تحليل كوليسكي (Cholesky Decomposition)
# ═══════════════════════════════════════════════════════════════

#**
# تحليل كوليسكي:
# ──────────────
# تحليل مصفوفة متماثلة موجبة التعريف A إلى الصيغة:
#   A = L * L^T
# حيث L مصفوفة مثلثية سفلى
#
# الشروط: المصفوفة يجب أن تكون:
#   1. مربعة
#   2. متماثلة (A = A^T)
#   3. موجبة التعريف (جميع القيم الذاتية > 0)
#
# المميزات:
#   - أسرع مرتين من تحليل LU العام
#   - مستقر عددياً
#   - يُستخدم كثيراً في الإحصاء وتعلم الآلة
#
# الصيغ لمصفوفة 2×2:
#   A = [[a, b], [b, c]]
#   L11 = sqrt(a)
#   L21 = b / L11
#   L22 = sqrt(c - L21²)
**#

#**
# دالة: كوليسكي_2×2_ل11
# الوصف: حساب عنصر L11 في تحليل كوليسكي لمصفوفة 2×2
#         L11 = √(A11)
# المعاملات:
#   - أ11: العنصر (1,1) من المصفوفة الأصلية
# الإرجاع: L11 مكبر ×1000
# شرط: أ11 يجب أن يكون موجباً
**#
دالة رقم كوليسكي_2×2_ل11(رقم أ11)
    إذا (أ11 <= 0)
        # المصفوفة ليست موجبة التعريف
        إرجاع -999999
    نهاية
    
    # حساب الجذر التربيعي بطريقة نيوتن
    # √أ11 مكبر ×1000
    متغير رقم تخمين = أ11 * 500
    إذا (أ11 > 100)
        تخمين = أ11 * 50
    نهاية
    إذا (أ11 > 10000)
        تخمين = أ11 * 5
    نهاية
    إذا (أ11 == 1)
        إرجاع 1000
    نهاية
    إذا (أ11 == 4)
        إرجاع 2000
    نهاية
    إذا (أ11 == 9)
        إرجاع 3000
    نهاية
    إذا (أ11 == 16)
        إرجاع 4000
    نهاية
    إذا (أ11 == 25)
        إرجاع 5000
    نهاية
    
    # تكرار نيوتن: x_new = (x + أ11*1000000/x) / 2
    متغير رقم ع = 0
    طالما (ع < 30)
        إذا (تخمين == 0)
            تخمين = 1
        نهاية
        متغير رقم جديد = (تخمين + (أ11 * 1000000) / تخمين) / 2
        إذا (جديد == تخمين)
            إرجاع تخمين
        نهاية
        تخمين = جديد
        ع = ع + 1
    نهاية
    
    إرجاع تخمين
نهاية


#**
# دالة: كوليسكي_2×2_ل21
# الوصف: حساب عنصر L21 في تحليل كوليسكي لمصفوفة 2×2
#         L21 = A21 / L11
# المعاملات:
#   - أ21: العنصر (2,1) من المصفوفة الأصلية
#   - ل11: قيمة L11 المحسوبة سابقاً (مكبرة ×1000)
# الإرجاع: L21 مكبر ×1000
**#
دالة رقم كوليسكي_2×2_ل21(رقم أ21، رقم ل11)
    إذا (ل11 == 0)
        إرجاع -999999
    نهاية
    إرجاع (أ21 * 1000000) / ل11
نهاية


#**
# دالة: كوليسكي_2×2_ل22
# الوصف: حساب عنصر L22 في تحليل كوليسكي لمصفوفة 2×2
#         L22 = √(A22 - L21²)
# المعاملات:
#   - أ22: العنصر (2,2) من المصفوفة الأصلية
#   - ل21: قيمة L21 المحسوبة سابقاً (مكبرة ×1000)
# الإرجاع: L22 مكبر ×1000
**#
دالة رقم كوليسكي_2×2_ل22(رقم أ22، رقم ل21)
    # A22 - L21² (مع مراعاة التكبير)
    # L21 مكبر ×1000، فـ L21² مكبر ×1000000
    متغير رقم تحت_الجذر = أ22 * 1000000 - ل21 * ل21
    
    إذا (تحت_الجذر < 0)
        # المصفوفة ليست موجبة التعريف
        إرجاع -999999
    نهاية
    إذا (تحت_الجذر == 0)
        إرجاع 0
    نهاية
    
    # حساب الجذر: √(تحت_الجذر) حيث تحت_الجذر مكبر ×1000000
    # النتيجة تكون مكبرة ×1000
    متغير رقم تخمين = تحت_الجذر / 1000
    إذا (تخمين <= 0)
        تخمين = 1
    نهاية
    
    متغير رقم ع = 0
    طالما (ع < 30)
        إذا (تخمين == 0)
            تخمين = 1
        نهاية
