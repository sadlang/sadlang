#** ─────────────────────────────────────────────────────────────────
# تحليل القيم المنفردة (SVD):
# ──────────────────────────
# أي مصفوفة A (m×n) يمكن تحليلها إلى:
#   A = U * Σ * V^T
# حيث:
#   U: مصفوفة متعامدة m×m (المتجهات المنفردة اليسرى)
#   Σ: مصفوفة قطرية m×n (القيم المنفردة σ₁ ≥ σ₂ ≥ ... ≥ 0)
#   V: مصفوفة متعامدة n×n (المتجهات المنفردة اليمنى)
#
# العلاقة بالقيم الذاتية:
#   - القيم المنفردة σᵢ = √(λᵢ(A^T*A))
#   - V = المتجهات الذاتية لـ A^T*A
#   - U = المتجهات الذاتية لـ A*A^T
#
# التطبيقات:
#   1. ضغط الصور (الاحتفاظ بأكبر k قيمة منفردة)
#   2. PCA في تعلم الآلة
#   3. حل المربعات الصغرى
#   4. عدد الشرط (Condition Number) = σ_max / σ_min
#   5. الرتبة العددية (عدد القيم المنفردة غير الصفرية)
#   6. شبه المقلوب (Pseudoinverse)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: قيمة_منفردة_2×2_أولى
# الوصف: حساب القيمة المنفردة الأولى (الأكبر) لمصفوفة 2×2
#         σ₁ = √(λ₁(A^T*A))
#         لمصفوفة 2×2: A^T*A = [[أ²+ج², أب+جد], [أب+جد, ب²+د²]]
# المعاملات: عناصر المصفوفة 2×2
# الإرجاع: القيمة المنفردة الأولى مكبرة ×1000
**#
دالة رقم قيمة_منفردة_2×2_أولى(رقم أ، رقم ب، رقم ج، رقم د)
    # حساب عناصر A^T * A
    متغير رقم م11 = أ * أ + ج * ج
    متغير رقم م12 = أ * ب + ج * د
    متغير رقم م22 = ب * ب + د * د
    
    # القيمة الذاتية الأكبر لـ A^T*A
    # λ = ((م11+م22) + √((م11-م22)² + 4*م12²)) / 2
    متغير رقم مجموع = م11 + م22
    متغير رقم فرق = م11 - م22
    متغير رقم مميز = فرق * فرق + 4 * م12 * م12
    
    متغير رقم جذر_مميز = 0
    إذا (مميز > 0)
        متغير رقم تخمين = مميز / 2
        إذا (تخمين <= 0)
            تخمين = 1
        نهاية
        متغير رقم ع = 0
        طالما (ع < 30)
            إذا (تخمين == 0)
                تخمين = 1
            نهاية
            تخمين = (تخمين + مميز / تخمين) / 2
            ع = ع + 1
        نهاية
        جذر_مميز = تخمين
    نهاية
    
    متغير رقم لامبدا1 = (مجموع + جذر_مميز) / 2
    
    # σ₁ = √λ₁ (مكبرة ×1000)
    إذا (لامبدا1 <= 0)
        إرجاع 0
    نهاية
    
    متغير رقم تخمين2 = لامبدا1 / 2
    إذا (تخمين2 <= 0)
        تخمين2 = 1
    نهاية
    متغير رقم ع2 = 0
    طالما (ع2 < 30)
        إذا (تخمين2 == 0)
            تخمين2 = 1
        نهاية
        تخمين2 = (تخمين2 + (لامبدا1 * 1000000) / تخمين2) / 2
        ع2 = ع2 + 1
    نهاية
    
    إرجاع تخمين2
نهاية


#**
# دالة: قيمة_منفردة_2×2_ثانية
# الوصف: حساب القيمة المنفردة الثانية (الأصغر) لمصفوفة 2×2
#         σ₂ = √(λ₂(A^T*A))
# المعاملات: عناصر المصفوفة 2×2
# الإرجاع: القيمة المنفردة الثانية مكبرة ×1000
**#
دالة رقم قيمة_منفردة_2×2_ثانية(رقم أ، رقم ب، رقم ج، رقم د)
    متغير رقم م11 = أ * أ + ج * ج
    متغير رقم م12 = أ * ب + ج * د
    متغير رقم م22 = ب * ب + د * د
    
    متغير رقم مجموع = م11 + م22
    متغير رقم فرق = م11 - م22
    متغير رقم مميز = فرق * فرق + 4 * م12 * م12
    
    متغير رقم جذر_مميز = 0
    إذا (مميز > 0)
        متغير رقم تخمين = مميز / 2
        إذا (تخمين <= 0)
            تخمين = 1
        نهاية
        متغير رقم ع = 0
        طالما (ع < 30)
            إذا (تخمين == 0)
                تخمين = 1
            نهاية
            تخمين = (تخمين + مميز / تخمين) / 2
            ع = ع + 1
        نهاية
        جذر_مميز = تخمين
    نهاية
    
    متغير رقم لامبدا2 = (مجموع - جذر_مميز) / 2
    
    إذا (لامبدا2 <= 0)
        إرجاع 0
    نهاية
    
    متغير رقم تخمين2 = لامبدا2 / 2
    إذا (تخمين2 <= 0)
        تخمين2 = 1
    نهاية
    متغير رقم ع2 = 0
    طالما (ع2 < 30)
        إذا (تخمين2 == 0)
            تخمين2 = 1
        نهاية
        تخمين2 = (تخمين2 + (لامبدا2 * 1000000) / تخمين2) / 2
        ع2 = ع2 + 1
    نهاية
    
    إرجاع تخمين2
نهاية


#**
# دالة: عدد_شرط_2×2
# الوصف: حساب عدد الشرط (Condition Number) لمصفوفة 2×2
#         κ(A) = σ_max / σ_min
#         عدد الشرط يقيس حساسية حل النظام للاضطرابات:
#         - κ ≈ 1: مصفوفة حسنة التكييف
#         - κ كبير: مصفوفة سيئة التكييف
#         - κ = ∞: مصفوفة منفردة
