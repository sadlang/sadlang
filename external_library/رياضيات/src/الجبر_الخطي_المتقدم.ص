# دالة: ماركوف_2×2_ك_خطوات
# الوصف: حساب احتمال الحالة 1 بعد k خطوات
# المعاملات:
#   - ح1: الاحتمال الابتدائي للحالة 1 (مكبر ×1000)
#   - أ، ب: احتمالات الانتقال (مكبرة ×1000)
#   - ك: عدد الخطوات
# الإرجاع: احتمال الحالة 1 بعد k خطوات (مكبر ×1000)
**#
دالة رقم ماركوف_2×2_ك_خطوات(رقم ح1، رقم أ، رقم ب، رقم ك)
    متغير رقم حالي = ح1
    متغير رقم ع = 0
    طالما (ع < ك)
        حالي = ماركوف_2×2_خطوة(حالي، أ، ب)
        ع = ع + 1
    نهاية
    إرجاع حالي
نهاية


#**
# دالة: هل_مصفوفة_عشوائية_2×2
# الوصف: التحقق مما إذا كانت مصفوفة 2×2 عشوائية (Stochastic)
#         شروط: كل عنصر ≥ 0 و مجموع كل صف = 1 (أو 1000 بالتكبير)
# المعاملات: عناصر المصفوفة (مكبرة ×1000)
# الإرجاع: 1 إذا عشوائية، 0 غير ذلك
**#
دالة رقم هل_مصفوفة_عشوائية_2×2(رقم أ11، رقم أ12، رقم أ21، رقم أ22)
    # كل العناصر ≥ 0
    إذا (أ11 < 0)
        إرجاع 0
    نهاية
    إذا (أ12 < 0)
        إرجاع 0
    نهاية
    إذا (أ21 < 0)
        إرجاع 0
    نهاية
    إذا (أ22 < 0)
        إرجاع 0
    نهاية
    
    # مجموع كل صف = 1000
    متغير رقم صف1 = أ11 + أ12
    متغير رقم صف2 = أ21 + أ22
    
    # سماح بخطأ صغير (±5)
    متغير رقم فرق1 = صف1 - 1000
    إذا (فرق1 < 0)
