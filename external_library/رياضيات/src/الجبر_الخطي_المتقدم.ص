#**
# دالة: معيار_ل2_متجه2
# الوصف: معيار L2 (الإقليدي) لمتجه ثنائي البعد
#         ||v||₂ = √(x² + y²)
# المعاملات:
#   - س، ص: مركبات المتجه
# الإرجاع: معيار L2 مكبر ×1000
**#
دالة رقم معيار_ل2_متجه2(رقم س، رقم ص)
    متغير رقم مربع = س * س + ص * ص
    إذا (مربع == 0)
        إرجاع 0
    نهاية
    
    متغير رقم تخمين = مربع / 2
    إذا (تخمين <= 0)
        تخمين = 1
    نهاية
    متغير رقم ع = 0
    طالما (ع < 30)
        إذا (تخمين == 0)
            تخمين = 1
        نهاية
        تخمين = (تخمين + (مربع * 1000000) / تخمين) / 2
        ع = ع + 1
    نهاية
    إرجاع تخمين
نهاية


