#**
# دالة: هل_تحويل_متعامد
# الوصف: التحقق مما إذا كان التحويل (المصفوفة) متعامد
#         المصفوفة متعامدة إذا A^T * A = I
#         أي: أ²+ج² = 1، ب²+د² = 1، أب+جد = 0
#         (للمصفوفات الصحيحة نستخدم مكبر ×1000)
# المعاملات: عناصر المصفوفة 2×2
# الإرجاع: 1 إذا متعامدة (تقريباً)، 0 إن لم تكن
**#
دالة رقم هل_تحويل_متعامد(رقم أ، رقم ب، رقم ج، رقم د)
    # A^T * A يجب أن تكون I (وحدة)
    # (1,1): أ²+ج² يجب = أ²+ج² ~ 1*1000000
    متغير رقم ع11 = أ * أ + ج * ج
    متغير رقم ع22 = ب * ب + د * د
    متغير رقم ع12 = أ * ب + ج * د
    
    # المحدد يجب أن يكون ±1
    متغير رقم محدد = أ * د - ب * ج
    
    # للمصفوفات المكبرة ×1000:
    # ع11 و ع22 يجب ≈ 1000000
    # ع12 يجب ≈ 0
    # محدد يجب ≈ ±1000000
    متغير رقم فرق11 = ع11 - 1000000
    إذا (فرق11 < 0)
        فرق11 = 0 - فرق11
    نهاية
    متغير رقم فرق22 = ع22 - 1000000
    إذا (فرق22 < 0)
        فرق22 = 0 - فرق22
    نهاية
    متغير رقم مطلق12 = ع12
    إذا (مطلق12 < 0)
        مطلق12 = 0 - مطلق12
    نهاية
    
    # سماح بخطأ 1%
    إذا (فرق11 < 10000)
        إذا (فرق22 < 10000)
            إذا (مطلق12 < 10000)
                إرجاع 1
            نهاية
        نهاية
    نهاية
    إرجاع 0
نهاية


