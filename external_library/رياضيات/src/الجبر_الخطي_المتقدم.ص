    نهاية
    
    إذا (فرق1 <= 5)
        إذا (فرق2 <= 5)
            إرجاع 1
        نهاية
    نهاية
    إرجاع 0
نهاية


# ═══════════════════════════════════════════════════════════════
# §10.3 - تحويلات فورييه المنفصلة البسيطة
# ═══════════════════════════════════════════════════════════════

#**
# تحويل فورييه المنفصل (DFT):
# ──────────────────────────
# يحوّل إشارة من المجال الزمني إلى المجال الترددي
# X[k] = Σ x[n] * e^(-j2πkn/N)
#
# لـ N=2 (أبسط حالة):
# X[0] = x[0] + x[1]
# X[1] = x[0] - x[1]
#
# لـ N=4:
# X[0] = x[0] + x[1] + x[2] + x[3]
# X[1] = x[0] - x[2] + j(x[3] - x[1])
# X[2] = x[0] - x[1] + x[2] - x[3]
# X[3] = x[0] - x[2] + j(x[1] - x[3])
#
# في الحالة الحقيقية (بدون أعداد مركبة):
# نحسب الجزء الحقيقي والجزء التخيلي بشكل منفصل
**#

#**
# دالة: فورييه_2_مركبة_0
# الوصف: المركبة X[0] لـ DFT بحجم 2
#         X[0] = x[0] + x[1] (مجموع العينات)
# المعاملات:
#   - س0: العينة الأولى
#   - س1: العينة الثانية
# الإرجاع: X[0]
**#
دالة رقم فورييه_2_مركبة_0(رقم س0، رقم س1)
    إرجاع س0 + س1
نهاية


#**
# دالة: فورييه_2_مركبة_1
# الوصف: المركبة X[1] لـ DFT بحجم 2
#         X[1] = x[0] - x[1] (فرق العينات)
# المعاملات: نفس السابق
# الإرجاع: X[1]
**#
دالة رقم فورييه_2_مركبة_1(رقم س0، رقم س1)
    إرجاع س0 - س1
نهاية


#**
# دالة: فورييه_4_حقيقي_0
# الوصف: الجزء الحقيقي لـ X[0] في DFT بحجم 4
#         Re(X[0]) = x[0] + x[1] + x[2] + x[3]
**#
دالة رقم فورييه_4_حقيقي_0(رقم س0، رقم س1، رقم س2، رقم س3)
    إرجاع س0 + س1 + س2 + س3
نهاية


#**
# دالة: فورييه_4_حقيقي_1
# الوصف: الجزء الحقيقي لـ X[1] في DFT بحجم 4
#         Re(X[1]) = x[0] - x[2]
**#
دالة رقم فورييه_4_حقيقي_1(رقم س0، رقم س1، رقم س2، رقم س3)
    إرجاع س0 - س2
نهاية


#**
# دالة: فورييه_4_تخيلي_1
# الوصف: الجزء التخيلي لـ X[1] في DFT بحجم 4
#         Im(X[1]) = x[3] - x[1]
**#
