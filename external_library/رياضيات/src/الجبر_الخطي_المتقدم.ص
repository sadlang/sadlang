    متغير رقم خطأ2 = ص2 * 1000 - تقدير2
    متغير رقم خطأ3 = ص3 * 1000 - تقدير3
    
    إرجاع (خطأ1 * خطأ1 + خطأ2 * خطأ2 + خطأ3 * خطأ3) / 1000000
