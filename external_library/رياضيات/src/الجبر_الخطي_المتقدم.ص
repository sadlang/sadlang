#**
# دالة: قيمة_ذاتية_2×2_أولى
# الوصف: حساب القيمة الذاتية الأولى (الأكبر) لمصفوفة 2×2
#         λ1 = ((a+d) + √((a-d)² + 4bc)) / 2
# المعاملات: عناصر المصفوفة 2×2
# الإرجاع: القيمة الذاتية الأكبر مكبرة ×1000
**#
دالة رقم قيمة_ذاتية_2×2_أولى(رقم أ، رقم ب، رقم ج، رقم د)
    # الأثر = a + d
    متغير رقم أثر = أ + د
    
    # المميز = (a-d)² + 4bc
    متغير رقم فرق = أ - د
    متغير رقم مميز = فرق * فرق + 4 * ب * ج
    
    # إذا المميز سالب: قيم ذاتية مركبة
    إذا (مميز < 0)
        # نرجع الجزء الحقيقي فقط
        إرجاع (أثر * 1000) / 2
    نهاية
    
    # حساب الجذر التربيعي للمميز (مكبر ×1000)
    متغير رقم جذر = 0
    إذا (مميز == 0)
        جذر = 0
    وإلا
        # نيوتن لحساب √مميز × 1000
        متغير رقم تخمين = مميز / 2
        إذا (تخمين <= 0)
            تخمين = 1
        نهاية
        متغير رقم ع = 0
        طالما (ع < 40)
            إذا (تخمين == 0)
                تخمين = 1
            نهاية
            متغير رقم جديد = (تخمين + (مميز * 1000000) / تخمين) / 2
            إذا (جديد == تخمين)
                جذر = تخمين
                ع = 40
            نهاية
            تخمين = جديد
            ع = ع + 1
        نهاية
        جذر = تخمين
    نهاية
    
    # λ1 = (أثر*1000 + جذر) / 2
    إرجاع (أثر * 1000 + جذر) / 2
نهاية


