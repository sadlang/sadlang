    # هل المصفوفة صفرية؟
    إذا (أ == 0)
        إذا (ب == 0)
            إذا (ج == 0)
                إذا (د == 0)
                    إرجاع 0
                نهاية
            نهاية
        نهاية
    نهاية
    
    # حساب المحدد
    متغير رقم محدد = أ * د - ب * ج
    إذا (محدد == 0)
        إرجاع 1
    نهاية
    إرجاع 2
