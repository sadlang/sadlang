#**
# دالة: انحدار_خطي_بسيط_ميل
# الوصف: حساب ميل خط الانحدار الخطي البسيط
#         باستخدام طريقة المربعات الصغرى
#         y = mx + b
#         m = (nΣxy - ΣxΣy) / (nΣx² - (Σx)²)
#         نحسب لنقطتين فقط (أبسط حالة)
# المعاملات:
#   - س1، ص1: النقطة الأولى
#   - س2، ص2: النقطة الثانية
# الإرجاع: الميل مكبر ×1000
**#
دالة رقم انحدار_خطي_بسيط_ميل(رقم س1، رقم ص1، رقم س2، رقم ص2)
    متغير رقم فرق_س = س2 - س1
    إذا (فرق_س == 0)
        إرجاع 999999
    نهاية
    إرجاع ((ص2 - ص1) * 1000) / فرق_س
نهاية


#**
# دالة: انحدار_خطي_بسيط_تقاطع
# الوصف: حساب تقاطع خط الانحدار مع المحور y
#         b = ȳ - m*x̄ = (y1+y2)/2 - m*(x1+x2)/2
# المعاملات:
#   - س1، ص1، س2، ص2: نقطتان
# الإرجاع: التقاطع مكبر ×1000
**#
دالة رقم انحدار_خطي_بسيط_تقاطع(رقم س1، رقم ص1، رقم س2، رقم ص2)
    متغير رقم ميل = انحدار_خطي_بسيط_ميل(س1، ص1، س2، ص2)
    # b = y1 - m*x1 (مع مراعاة التكبير)
    إرجاع ص1 * 1000 - (ميل * س1) / 1
نهاية


#**
# دالة: انحدار_خطي_3نقاط_ميل
# الوصف: حساب ميل خط الانحدار لثلاث نقاط بالمربعات الصغرى
#         m = (3*Σxy - Σx*Σy) / (3*Σx² - (Σx)²)
# المعاملات:
#   - س1..س3، ص1..ص3: ثلاث نقاط
# الإرجاع: الميل مكبر ×1000
**#
دالة رقم انحدار_خطي_3نقاط_ميل(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    متغير رقم مج_س = س1 + س2 + س3
    متغير رقم مج_ص = ص1 + ص2 + ص3
    متغير رقم مج_س_ص = س1*ص1 + س2*ص2 + س3*ص3
    متغير رقم مج_س2 = س1*س1 + س2*س2 + س3*س3
    
    متغير رقم بسط = 3 * مج_س_ص - مج_س * مج_ص
    متغير رقم مقام = 3 * مج_س2 - مج_س * مج_س
    
    إذا (مقام == 0)
        إرجاع 999999
    نهاية
    
    إرجاع (بسط * 1000) / مقام
نهاية


#**
# دالة: انحدار_خطي_3نقاط_تقاطع
# الوصف: تقاطع خط الانحدار لثلاث نقاط مع المحور y
#         b = (Σy - m*Σx) / 3
# المعاملات: نفس انحدار_خطي_3نقاط_ميل
# الإرجاع: التقاطع مكبر ×1000
**#
دالة رقم انحدار_خطي_3نقاط_تقاطع(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    متغير رقم ميل = انحدار_خطي_3نقاط_ميل(س1، ص1، س2، ص2، س3، ص3)
    متغير رقم مج_ص = ص1 + ص2 + ص3
    متغير رقم مج_س = س1 + س2 + س3
    # b = (Σy*1000 - m*Σx) / 3
    إرجاع (مج_ص * 1000 - ميل * مج_س / 1000) / 3
نهاية


