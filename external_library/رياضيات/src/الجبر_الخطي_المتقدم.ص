دالة رقم مربعات_صغرى_خطأ_تربيعي(رقم ميل، رقم تقاطع، رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    # ŷ1 = m*x1 + b (مكبرة ×1000)
    متغير رقم تقدير1 = (ميل * س1) / 1000 + تقاطع
    متغير رقم تقدير2 = (ميل * س2) / 1000 + تقاطع
    متغير رقم تقدير3 = (ميل * س3) / 1000 + تقاطع
    
