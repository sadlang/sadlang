#**
# دالة: استيفاء_خطي_ثنائي
# الوصف: الاستيفاء الخطي الثنائي (Bilinear Interpolation)
#         لتقدير قيمة دالة عند نقطة داخلية بمعرفة القيم عند 4 أركان
#         f(x,y) ≈ (1-t)(1-s)f00 + t(1-s)f10 + (1-t)s*f01 + t*s*f11
#         حيث t = (x-x0)/(x1-x0) و s = (y-y0)/(y1-y0)
# المعاملات:
#   - ف00، ف10، ف01، ف11: القيم عند الأركان الأربعة
#   - ت، ص_معامل: معاملات الاستيفاء (مكبرة ×1000)، 0-1000
# الإرجاع: القيمة المستوفاة (مكبرة ×1000)
**#
دالة رقم استيفاء_خطي_ثنائي(رقم ف00، رقم ف10، رقم ف01، رقم ف11، رقم ت، رقم ص_معامل)
    # (1-t)(1-s) = (1000-t)(1000-s)/1000000
    متغير رقم و1 = (1000 - ت) * (1000 - ص_معامل)
    متغير رقم و2 = ت * (1000 - ص_معامل)
    متغير رقم و3 = (1000 - ت) * ص_معامل
    متغير رقم و4 = ت * ص_معامل
    
    # f ≈ (w1*f00 + w2*f10 + w3*f01 + w4*f11) / 1000000
    إرجاع (و1 * ف00 + و2 * ف10 + و3 * ف01 + و4 * ف11) / 1000000
نهاية


#**
# دالة: مربعات_صغرى_خطأ_تربيعي
# الوصف: حساب مجموع مربعات الأخطاء لخط الانحدار عند 3 نقاط
#         SSE = Σ(yᵢ - ŷᵢ)² حيث ŷᵢ = m*xᵢ + b
# المعاملات:
#   - ميل، تقاطع: معاملات الخط (مكبرة ×1000)
#   - س1..س3، ص1..ص3: النقاط
# الإرجاع: SSE (مكبرة)
