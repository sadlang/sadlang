# ═══════════════════════════════════════════════════════════════
# §10.2 - نماذج ماركوف (Markov Chains)
# ═══════════════════════════════════════════════════════════════

#**
# سلاسل ماركوف:
# ─────────────
# نظام عشوائي يتنقل بين حالات محدودة
# مصفوفة الانتقال P حيث P[i][j] = احتمال الانتقال من i إلى j
# الخصائص:
# - كل عناصر P ≥ 0
# - مجموع كل صف = 1 (مصفوفة عشوائية)
# - الحالة المستقرة π تحقق: π*P = π
#
# لمصفوفة 2×2: P = [[p, 1-p], [q, 1-q]]
# الحالة المستقرة: π = [q/(p+q-2pq+...), p/(p+q-...)]
# π₁ = q / (p_comp + q) حيث p_comp = 1-p
# π₂ = p_comp / (p_comp + q)
# بشكل أبسط: π = [q/(q+1-p), (1-p)/(q+1-p)]
**#

#**
# دالة: ماركوف_2×2_حالة_مستقرة_1
# الوصف: حساب احتمال الحالة المستقرة الأولى لسلسلة ماركوف 2×2
#         P = [[1-أ, أ], [ب, 1-ب]]
#         π₁ = ب / (أ + ب)
# المعاملات:
#   - أ: احتمال الانتقال من الحالة 1 إلى 2 (مكبر ×1000)
#   - ب: احتمال الانتقال من الحالة 2 إلى 1 (مكبر ×1000)
# الإرجاع: احتمال الحالة المستقرة الأولى (مكبر ×1000)
**#
دالة رقم ماركوف_2×2_حالة_مستقرة_1(رقم أ، رقم ب)
    متغير رقم مجموع = أ + ب
    إذا (مجموع == 0)
        إرجاع 500
    نهاية
    إرجاع (ب * 1000) / مجموع
نهاية


#**
# دالة: ماركوف_2×2_حالة_مستقرة_2
# الوصف: احتمال الحالة المستقرة الثانية
#         π₂ = أ / (أ + ب)
**#
دالة رقم ماركوف_2×2_حالة_مستقرة_2(رقم أ، رقم ب)
    متغير رقم مجموع = أ + ب
    إذا (مجموع == 0)
        إرجاع 500
    نهاية
    إرجاع (أ * 1000) / مجموع
نهاية


#**
# دالة: ماركوف_2×2_خطوة
# الوصف: حساب احتمالات الحالة بعد خطوة واحدة
#         [p1', p2'] = [p1, p2] * P
#         p1' = p1*(1-أ) + p2*ب
# المعاملات:
#   - ح1: احتمال الحالة 1 الحالي (مكبر ×1000)
#   - أ: احتمال الانتقال 1→2 (مكبر ×1000)
#   - ب: احتمال الانتقال 2→1 (مكبر ×1000)
# الإرجاع: احتمال الحالة 1 بعد خطوة (مكبر ×1000)
**#
دالة رقم ماركوف_2×2_خطوة(رقم ح1، رقم أ، رقم ب)
    # p1' = p1*(1000-أ)/1000 + (1000-ح1)*ب/1000
    متغير رقم ح2 = 1000 - ح1
    إرجاع (ح1 * (1000 - أ) + ح2 * ب) / 1000
نهاية


