# ║          القسم 7: المنحنيات البارامترية                            ║
# ║          Section 7: Parametric Curves                              ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: دائرة_بارامترية
# الوصف: تقريب نقطة على دائرة بزاوية محددة
#         س = ح + نق×cos(θ), ص = ك + نق×sin(θ)
#         للزوايا المعيارية: 0, 90, 180, 270
**#
دالة رقم دائرة_بارم_س(رقم ح، رقم نق، رقم زاوية)
    إذا (زاوية == 0)
        إرجاع ح + نق
    نهاية
    إذا (زاوية == 90)
        إرجاع ح
    نهاية
    إذا (زاوية == 180)
        إرجاع ح - نق
    نهاية
    إذا (زاوية == 270)
        إرجاع ح
    نهاية
    # 45°: cos ≈ 707/1000
    إذا (زاوية == 45)
        إرجاع ح + نق * 707 / 1000
    نهاية
    إذا (زاوية == 135)
        إرجاع ح - نق * 707 / 1000
    نهاية
    إرجاع ح
نهاية

دالة رقم دائرة_بارم_ص(رقم ك، رقم نق، رقم زاوية)
    إذا (زاوية == 0)
        إرجاع ك
    نهاية
    إذا (زاوية == 90)
        إرجاع ك + نق
    نهاية
    إذا (زاوية == 180)
        إرجاع ك
    نهاية
    إذا (زاوية == 270)
        إرجاع ك - نق
    نهاية
    إذا (زاوية == 45)
        إرجاع ك + نق * 707 / 1000
    نهاية
    إذا (زاوية == 135)
        إرجاع ك + نق * 707 / 1000
    نهاية
    إرجاع ك
نهاية


#**
# دالة: ناقص_بارامتري
# الوصف: نقطة على القطع الناقص للزوايا المعيارية
#         س = أ×cos(θ), ص = ب×sin(θ)
**#
دالة رقم ناقص_بارم_س(رقم أ، رقم زاوية)
    إذا (زاوية == 0)
        إرجاع أ
    نهاية
    إذا (زاوية == 90)
        إرجاع 0
    نهاية
    إذا (زاوية == 180)
        إرجاع 0 - أ
    نهاية
    إذا (زاوية == 270)
        إرجاع 0
    نهاية
    إذا (زاوية == 45)
        إرجاع أ * 707 / 1000
    نهاية
    إرجاع أ
نهاية

دالة رقم ناقص_بارم_ص(رقم ب، رقم زاوية)
    إذا (زاوية == 0)
        إرجاع 0
    نهاية
    إذا (زاوية == 90)
        إرجاع ب
    نهاية
    إذا (زاوية == 180)
        إرجاع 0
    نهاية
    إذا (زاوية == 270)
        إرجاع 0 - ب
    نهاية
    إذا (زاوية == 45)
        إرجاع ب * 707 / 1000
    نهاية
    إرجاع 0
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 8: الاختبارات                                       ║
# ║          Section 8: Tests                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

دالة رقم اختبار_الهندسة_التحليلية()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار الهندسة التحليلية")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: المسافة بين (0,0) و (3,4) = 5
    رقم ن1 = مسافة_نقطتين(0، 0، 3، 4)
    إذا (ن1 == 5)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مسافة (0,0)-(3,4) = 5")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مسافة = ")
        اطبع_سطر(ن1)
    نهاية
    
    # اختبار 2: النقطة الوسطى بين (2,4) و (6,8) = (4,6)
    رقم وس = وسطى_س(2، 6)
    رقم وص = وسطى_ص(4، 8)
    إذا (وس == 4)
        إذا (وص == 6)
            نجاح = نجاح + 1
            اطبع_سطر("✓ وسطى (2,4)-(6,8) = (4,6)")
        وإلا
            فشل = فشل + 1
            اطبع_سطر("✗ وسطى خطأ")
        نهاية
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ وسطى خطأ")
    نهاية
    
    # اختبار 3: مساحة مثلث (0,0), (4,0), (0,3) = 6
    رقم ن3 = مساحة_مثلث_إحداثيات(0، 0، 4، 0، 0، 3)
    إذا (ن3 == 6)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مساحة مثلث = 6")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مساحة = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: استقامة ثلاث نقط (0,0), (1,1), (2,2)
    رقم ن4 = على_استقامة(0، 0، 1، 1، 2، 2)
    إذا (ن4 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ (0,0),(1,1),(2,2) على استقامة")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ استقامة خطأ")
    نهاية
    
    # اختبار 5: متعامدان (1,0) و (0,1) → أ1=1,ب1=0 و أ2=0,ب2=1
    رقم ن5 = هل_متعامدان(1، 0، 0، 1)
    إذا (ن5 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ المحوران متعامدان")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ تعامد خطأ")
    نهاية
    
    # اختبار 6: قطع ناقص مساحة (أ=5, ب=3)
    # π×5×3 ≈ 47 (تقريب صحيح)
    رقم ن6 = مساحة_ناقص(5، 3)
    إذا (ن6 == 47)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مساحة قطع ناقص(5,3) ≈ 47")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مساحة ناقص = ")
        اطبع_سطر(ن6)
    نهاية
    
    # اختبار 7: دوران 90° لنقطة (3,0) → (0,3)
    رقم د_س = دوران_90_س(3، 0)
    رقم د_ص = دوران_90_ص(3، 0)
    إذا (د_س == 0)
        إذا (د_ص == 3)
            نجاح = نجاح + 1
            اطبع_سطر("✓ دوران 90°(3,0) = (0,3)")
        وإلا
            فشل = فشل + 1
            اطبع_سطر("✗ دوران خطأ")
        نهاية
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ دوران خطأ")
    نهاية
    
    # اختبار 8: مسافة 3D (1,2,3)-(4,6,3) = √(9+16) = 5
    رقم ن8 = مسافة_3د(1، 2، 3، 4، 6، 3)
    إذا (ن8 == 5)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مسافة 3D = 5")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مسافة 3D = ")
        اطبع_سطر(ن8)
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


