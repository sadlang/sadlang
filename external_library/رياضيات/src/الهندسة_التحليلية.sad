#**
# دالة: المسافة_بين_نقطتين_3د
# الوصف: √((س2-س1)² + (ص2-ص1)² + (ع2-ع1)²)
**#
دالة رقم مسافة_3د(رقم س1، رقم ص1، رقم ع1، رقم س2، رقم ص2، رقم ع2)
    رقم دس = س2 - س1
    رقم دص = ص2 - ص1
    رقم دع = ع2 - ع1
    إرجاع هـ_جذر(دس * دس + دص * دص + دع * دع)
نهاية


#**
# دالة: نقطة_وسطى_3د
**#
دالة رقم وسطى_3د_س(رقم س1، رقم س2)
    إرجاع (س1 + س2) / 2
نهاية
دالة رقم وسطى_3د_ص(رقم ص1، رقم ص2)
    إرجاع (ص1 + ص2) / 2
نهاية
دالة رقم وسطى_3د_ع(رقم ع1، رقم ع2)
    إرجاع (ع1 + ع2) / 2
نهاية


#**
# دالة: معادلة_مستوى
# الوصف: أس + بص + جع + د = 0
#         المسافة من نقطة (س0,ص0,ع0) إلى المستوى:
#         |أس0 + بص0 + جع0 + د| / √(أ²+ب²+ج²)
**#
دالة رقم مسافة_نقطة_مستوى(رقم أ، رقم ب، رقم ج، رقم د، رقم س0، رقم ص0، رقم ع0)
    رقم البسط = أ * س0 + ب * ص0 + ج * ع0 + د
    إذا (البسط < 0)
        البسط = 0 - البسط
    نهاية
    رقم المقام = هـ_جذر(أ * أ + ب * ب + ج * ج)
    إذا (المقام == 0)
        إرجاع 0
    نهاية
    إرجاع البسط / المقام
نهاية


#**
# دالة: زاوية_بين_مستويين
# الوصف: cos(θ) = |أ1أ2+ب1ب2+ج1ج2| / (|ن1|×|ن2|)
#         نرجع cos × 1000
**#
دالة رقم زاوية_مستويين(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم البسط = أ1 * أ2 + ب1 * ب2 + ج1 * ج2
    إذا (البسط < 0)
        البسط = 0 - البسط
    نهاية
    رقم ن1 = هـ_جذر(أ1 * أ1 + ب1 * ب1 + ج1 * ج1)
    رقم ن2 = هـ_جذر(أ2 * أ2 + ب2 * ب2 + ج2 * ج2)
    رقم المقام = ن1 * ن2
    إذا (المقام == 0)
        إرجاع 0
    نهاية
    إرجاع البسط * 1000 / المقام
نهاية


#**
# دالة: حجم_متوازي_سطوح
# الوصف: |V1 · (V2 × V3)| المحدد 3×3
**#
دالة رقم حجم_متوازي(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2، رقم أ3، رقم ب3، رقم ج3)
    رقم المحدد = أ1 * (ب2 * ج3 - ج2 * ب3) - ب1 * (أ2 * ج3 - ج2 * أ3) + ج1 * (أ2 * ب3 - ب2 * أ3)
    إذا (المحدد < 0)
        المحدد = 0 - المحدد
    نهاية
    إرجاع المحدد
نهاية


#**
# دالة: حجم_رباعي_وجوه
# الوصف: = |متوازي السطوح| / 6
**#
دالة رقم حجم_رباعي_وجوه(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2، رقم أ3، رقم ب3، رقم ج3)
    إرجاع حجم_متوازي(أ1، ب1، ج1، أ2، ب2، ج2، أ3، ب3، ج3) / 6
نهاية


