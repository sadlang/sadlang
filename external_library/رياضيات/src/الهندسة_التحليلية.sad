#**
# دالة: انسحاب
# الوصف: إزاحة نقطة (س,ص) بمقدار (دس, دص)
**#
دالة رقم انسحاب_س(رقم س، رقم دس)
    إرجاع س + دس
نهاية

دالة رقم انسحاب_ص(رقم ص، رقم دص)
    إرجاع ص + دص
نهاية


#**
# دالة: تمدد_من_نقطة
# الوصف: تمدد بمعامل ك من نقطة (ح,ك)
#         س' = ح + ك(س-ح), ص' = ك + ك(ص-ك)
#         ك × 1000
**#
دالة رقم تمدد_س(رقم س، رقم ح، رقم ك_1000)
    إرجاع ح + ك_1000 * (س - ح) / 1000
نهاية

دالة رقم تمدد_ص(رقم ص، رقم ح، رقم ك_1000)
    إرجاع ح + ك_1000 * (ص - ح) / 1000
نهاية


