# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 1: النقاط والمسافات في المستوى                      ║
# ║          Section 1: Points & Distances in 2D                       ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: جذر_نيوتن
# الوصف: √ن بطريقة نيوتن (محلية للملف)
**#
دالة رقم هـ_جذر(رقم ن)
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    رقم تخمين = ن / 2
    إذا (تخمين == 0)
        تخمين = 1
    نهاية
    رقم ع = 0
    كرر طالما (ع < 30)
        رقم جديد = (تخمين + ن / تخمين) / 2
        إذا (جديد == تخمين)
            إرجاع تخمين
        نهاية
        تخمين = جديد
        ع = ع + 1
    نهاية
    إرجاع تخمين
نهاية


#**
# دالة: نقطة_وسطى
# الوصف: النقطة الوسطى بين (س1،ص1) و(س2،ص2)
**#
دالة رقم وسطى_س(رقم س1، رقم س2)
    إرجاع (س1 + س2) / 2
نهاية

دالة رقم وسطى_ص(رقم ص1، رقم ص2)
    إرجاع (ص1 + ص2) / 2
نهاية


#**
# دالة: المسافة_بين_نقطتين
# الوصف: √((س2-س1)² + (ص2-ص1)²)
**#
دالة رقم مسافة_نقطتين(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم دس = س2 - س1
    رقم دص = ص2 - ص1
    إرجاع هـ_جذر(دس * دس + دص * دص)
نهاية


#**
# دالة: المسافة_المربعة
# الوصف: (س2-س1)² + (ص2-ص1)² بدون جذر
**#
دالة رقم مسافة_مربعة(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم دس = س2 - س1
    رقم دص = ص2 - ص1
    إرجاع دس * دس + دص * دص
نهاية


#**
# دالة: نقطة_تقسيم
# الوصف: النقطة التي تقسم القطعة المستقيمة بنسبة م:ن
#         من (س1،ص1) إلى (س2،ص2)
#         تقسيم داخلي: ((ن×س1 + م×س2)/(م+ن), (ن×ص1 + م×ص2)/(م+ن))
**#
دالة رقم تقسيم_داخلي_س(رقم س1، رقم س2، رقم م، رقم ن)
    إذا (م + ن == 0)
        إرجاع س1
    نهاية
    إرجاع (ن * س1 + م * س2) / (م + ن)
نهاية

دالة رقم تقسيم_داخلي_ص(رقم ص1، رقم ص2، رقم م، رقم ن)
    إذا (م + ن == 0)
        إرجاع ص1
    نهاية
    إرجاع (ن * ص1 + م * ص2) / (م + ن)
نهاية


#**
# دالة: تقسيم_خارجي
# الوصف: ((ن×س1 - م×س2)/(ن-م), ...)
**#
دالة رقم تقسيم_خارجي_س(رقم س1، رقم س2، رقم م، رقم ن)
    إذا (م - ن == 0)
        إرجاع 0  # غير محدد
    نهاية
    إرجاع (م * س2 - ن * س1) / (م - ن)
نهاية

دالة رقم تقسيم_خارجي_ص(رقم ص1، رقم ص2، رقم م، رقم ن)
    إذا (م - ن == 0)
        إرجاع 0
    نهاية
    إرجاع (م * ص2 - ن * ص1) / (م - ن)
نهاية


#**
# دالة: مركز_ثقل_مثلث
# الوصف: G = ((س1+س2+س3)/3, (ص1+ص2+ص3)/3)
**#
دالة رقم ثقل_مثلث_س(رقم س1، رقم س2، رقم س3)
    إرجاع (س1 + س2 + س3) / 3
نهاية

دالة رقم ثقل_مثلث_ص(رقم ص1، رقم ص2، رقم ص3)
    إرجاع (ص1 + ص2 + ص3) / 3
نهاية


#**
# دالة: مساحة_مثلث_بالإحداثيات
# الوصف: |½ × (س1(ص2-ص3) + س2(ص3-ص1) + س3(ص1-ص2))|
**#
دالة رقم مساحة_مثلث_إحداثيات(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    رقم المساحة = س1 * (ص2 - ص3) + س2 * (ص3 - ص1) + س3 * (ص1 - ص2)
    إذا (المساحة < 0)
        المساحة = 0 - المساحة
    نهاية
    إرجاع المساحة / 2
نهاية


#**
# دالة: هل_على_استقامة
# الوصف: ثلاث نقط على استقامة إذا مساحة المثلث = 0
**#
دالة رقم على_استقامة(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    رقم م = مساحة_مثلث_إحداثيات(س1، ص1، س2، ص2، س3، ص3)
    إذا (م == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 2: المستقيمات                                       ║
# ║          Section 2: Lines                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: ميل_مستقيم
# الوصف: م = (ص2-ص1)/(س2-س1) × 1000 (دقة)
**#
دالة رقم ميل_خط(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم دس = س2 - س1
    إذا (دس == 0)
        إرجاع 999999999  # عمودي
    نهاية
    إرجاع (ص2 - ص1) * 1000 / دس
نهاية


#**
# دالة: معادلة_مستقيم
# الوصف: أس + بص + ج = 0 من نقطتين
#         أ = ص1-ص2, ب = س2-س1, ج = س1×ص2-س2×ص1
**#
دالة رقم خط_أ(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إرجاع ص1 - ص2
نهاية

دالة رقم خط_ب(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إرجاع س2 - س1
نهاية

دالة رقم خط_ج(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إرجاع س1 * ص2 - س2 * ص1
نهاية


#**
# دالة: المسافة_من_نقطة_إلى_مستقيم
# الوصف: |أ×س + ب×ص + ج| / √(أ² + ب²)
**#
دالة رقم مسافة_نقطة_خط(رقم أ، رقم ب، رقم ج، رقم س، رقم ص)
    رقم البسط = أ * س + ب * ص + ج
    إذا (البسط < 0)
        البسط = 0 - البسط
    نهاية
    رقم المقام = هـ_جذر(أ * أ + ب * ب)
    إذا (المقام == 0)
        إرجاع 0
    نهاية
    إرجاع البسط / المقام
نهاية


#**
# دالة: المسافة_بين_مستقيمين_متوازيين
# الوصف: |ج1-ج2| / √(أ² + ب²)
**#
دالة رقم مسافة_متوازيين(رقم أ، رقم ب، رقم ج1، رقم ج2)
    رقم الفرق = ج1 - ج2
    إذا (الفرق < 0)
        الفرق = 0 - الفرق
    نهاية
    رقم المقام = هـ_جذر(أ * أ + ب * ب)
    إذا (المقام == 0)
        إرجاع 0
    نهاية
    إرجاع الفرق / المقام
نهاية


#**
# دالة: هل_متوازيان
# الوصف: مستقيمان أ1س+ب1ص+ج1=0 و أ2س+ب2ص+ج2=0
#         متوازيان إذا أ1×ب2 = أ2×ب1
**#
دالة رقم هل_متوازيان(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إذا (أ1 * ب2 == أ2 * ب1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_متعامدان
# الوصف: متعامدان إذا أ1×أ2 + ب1×ب2 = 0
**#
دالة رقم هل_متعامدان(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إذا (أ1 * أ2 + ب1 * ب2 == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: نقطة_تقاطع_مستقيمين
# الوصف: حل جملة: أ1س + ب1ص + ج1 = 0, أ2س + ب2ص + ج2 = 0
#         س = (ب1×ج2 - ب2×ج1) / (أ1×ب2 - أ2×ب1)
#         ص = (أ2×ج1 - أ1×ج2) / (أ1×ب2 - أ2×ب1)
**#
دالة رقم تقاطع_س(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم المحدد = أ1 * ب2 - أ2 * ب1
    إذا (المحدد == 0)
        إرجاع 999999  # لا تقاطع
    نهاية
    إرجاع (ب1 * ج2 - ب2 * ج1) / المحدد
نهاية

دالة رقم تقاطع_ص(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم المحدد = أ1 * ب2 - أ2 * ب1
    إذا (المحدد == 0)
        إرجاع 999999
    نهاية
    إرجاع (أ2 * ج1 - أ1 * ج2) / المحدد
نهاية


#**
# دالة: زاوية_بين_مستقيمين
# الوصف: tan(θ) = |م1-م2| / (1+م1×م2)
#         بدقة × 1000 (المداخل ميول × 1000)
#         نرجع tan(θ) × 1000
**#
دالة رقم زاوية_خطين(رقم م1_1000، رقم م2_1000)
    رقم الفرق = م1_1000 - م2_1000
    إذا (الفرق < 0)
        الفرق = 0 - الفرق
    نهاية
    رقم المقام = 1000 + م1_1000 * م2_1000 / 1000
    إذا (المقام == 0)
        إرجاع 999999  # متعامدان
    نهاية
    إرجاع الفرق * 1000 / المقام
نهاية


#**
# دالة: إسقاط_نقطة_على_مستقيم
# الوصف: إسقاط النقطة (س0,ص0) على المستقيم أس+بص+ج=0
#         النقطة المسقطة:
#         س' = (ب²×س0 - أ×ب×ص0 - أ×ج) / (أ²+ب²)
#         ص' = (أ²×ص0 - أ×ب×س0 - ب×ج) / (أ²+ب²)
**#
دالة رقم إسقاط_س(رقم أ، رقم ب، رقم ج، رقم س0، رقم ص0)
    رقم المقام = أ * أ + ب * ب
    إذا (المقام == 0)
        إرجاع س0
    نهاية
    إرجاع (ب * ب * س0 - أ * ب * ص0 - أ * ج) / المقام
نهاية

دالة رقم إسقاط_ص(رقم أ، رقم ب، رقم ج، رقم س0، رقم ص0)
    رقم المقام = أ * أ + ب * ب
    إذا (المقام == 0)
        إرجاع ص0
    نهاية
    إرجاع (أ * أ * ص0 - أ * ب * س0 - ب * ج) / المقام
نهاية


#**
# دالة: انعكاس_نقطة_حول_مستقيم
# الوصف: النقطة المنعكسة = 2×الإسقاط - النقطة الأصلية
**#
دالة رقم انعكاس_س(رقم أ، رقم ب، رقم ج، رقم س0، رقم ص0)
    إرجاع 2 * إسقاط_س(أ، ب، ج، س0، ص0) - س0
نهاية

دالة رقم انعكاس_ص(رقم أ، رقم ب، رقم ج، رقم س0، رقم ص0)
    إرجاع 2 * إسقاط_ص(أ، ب، ج، س0، ص0) - ص0
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 3: الدوائر                                         ║
# ║          Section 3: Circles                                        ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: معادلة_دائرة
# الوصف: (س-ح)² + (ص-ك)² = نق²
#         نقطة (س,ص) على الدائرة إذا الناتج = نق²
**#
دالة رقم قيمة_دائرة(رقم س، رقم ص، رقم ح، رقم ك، رقم نق)
    رقم دس = س - ح
    رقم دص = ص - ك
    إرجاع دس * دس + دص * دص - نق * نق
نهاية


#**
# دالة: موقع_نقطة_من_دائرة
# الوصف: 1 = خارج, 0 = على, -1 = داخل
**#
دالة رقم موقع_من_دائرة(رقم س، رقم ص، رقم ح، رقم ك، رقم نق)
    رقم ق = قيمة_دائرة(س، ص، ح، ك، نق)
    إذا (ق > 0)
        إرجاع 1
    نهاية
    إذا (ق < 0)
        إرجاع 0 - 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: طول_مماس
# الوصف: طول المماس من نقطة (س,ص) خارج الدائرة (ح,ك,نق)
#         = √((س-ح)² + (ص-ك)² - نق²)
**#
دالة رقم طول_مماس(رقم س، رقم ص، رقم ح، رقم ك، رقم نق)
    رقم د_مربع = (س - ح) * (س - ح) + (ص - ك) * (ص - ك)
    رقم القيمة = د_مربع - نق * نق
    إذا (القيمة < 0)
        إرجاع 0 - 1  # النقطة داخل الدائرة
    نهاية
    إرجاع هـ_جذر(القيمة)
نهاية


#**
# دالة: وتر_مسافة
# الوصف: طول الوتر الذي يبعد مسافة د عن المركز
#         = 2 × √(نق² - د²)
**#
دالة رقم طول_وتر(رقم نق، رقم المسافة)
    رقم القيمة = نق * نق - المسافة * المسافة
    إذا (القيمة < 0)
        إرجاع 0
    نهاية
    إرجاع 2 * هـ_جذر(القيمة)
نهاية


#**
# دالة: تقاطع_دائرتين
# الوصف: المسافة بين المركزين مقارنة بنصفي القطرين
#         0 = متقاطعتان, 1 = منفصلتان, 2 = إحداهما داخل الأخرى, 3 = متماستان خارجياً, 4 = متماستان داخلياً
**#
دالة رقم علاقة_دائرتين(رقم ح1، رقم ك1، رقم نق1، رقم ح2، رقم ك2، رقم نق2)
    رقم المسافة = مسافة_نقطتين(ح1، ك1، ح2، ك2)
    رقم المجموع = نق1 + نق2
    رقم الفرق = نق1 - نق2
    إذا (الفرق < 0)
        الفرق = 0 - الفرق
    نهاية
    
    إذا (المسافة == المجموع)
        إرجاع 3  # متماستان خارجياً
    نهاية
    إذا (المسافة == الفرق)
        إرجاع 4  # متماستان داخلياً
    نهاية
    إذا (المسافة > المجموع)
        إرجاع 1  # منفصلتان
    نهاية
    إذا (المسافة < الفرق)
        إرجاع 2  # إحداهما داخل الأخرى
    نهاية
    إرجاع 0  # متقاطعتان
نهاية


#**
# دالة: محيط_دائرة
# الوصف: 2 × π × نق ≈ 2 × 3141593 × نق / 1000000
**#
دالة رقم محيط_دائرة_هـ(رقم نق)
    إرجاع 2 * 3141593 * نق / 1000000
نهاية


#**
# دالة: مساحة_دائرة
# الوصف: π × نق² ≈ 3141593 × نق² / 1000000
**#
دالة رقم مساحة_دائرة_هـ(رقم نق)
    إرجاع 3141593 * نق * نق / 1000000
نهاية


#**
# دالة: قوس_دائرة
# الوصف: طول القوس = نق × θ
#         θ بالراديان × 1000
**#
دالة رقم طول_قوس(رقم نق، رقم زاوية_1000)
    إرجاع نق * زاوية_1000 / 1000
نهاية


#**
# دالة: مساحة_قطاع
# الوصف: = ½ × نق² × θ
#         θ بالراديان × 1000
**#
دالة رقم مساحة_قطاع(رقم نق، رقم زاوية_1000)
    إرجاع نق * نق * زاوية_1000 / 2000
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 4: القطوع المخروطية                                 ║
# ║          Section 4: Conic Sections                                 ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: قطع_ناقص_نقطة
# الوصف: القطع الناقص: س²/أ² + ص²/ب² = 1
#         نحسب القيمة: <0 داخل, =0 على, >0 خارج
#         نرجع (س²×ب² + ص²×أ² - أ²×ب²) ← 0 يعني على القطع
**#
دالة رقم ناقص_قيمة(رقم س، رقم ص، رقم أ، رقم ب)
    إرجاع س * س * ب * ب + ص * ص * أ * أ - أ * أ * ب * ب
نهاية


#**
# دالة: محيط_قطع_ناقص_تقريبي
# الوصف: تقريب راماناغان: π(3(أ+ب) - √((3أ+ب)(أ+3ب)))
#         بدقة مبسطة
**#
دالة رقم محيط_ناقص(رقم أ، رقم ب)
    رقم س1 = 3 * أ + ب
    رقم س2 = أ + 3 * ب
    رقم الجذر = هـ_جذر(س1 * س2)
    إرجاع 3141593 * (3 * (أ + ب) - الجذر) / 1000000
نهاية


#**
# دالة: مساحة_قطع_ناقص
# الوصف: π × أ × ب
**#
دالة رقم مساحة_ناقص(رقم أ، رقم ب)
    إرجاع 3141593 * أ * ب / 1000000
نهاية


#**
# دالة: بؤرة_قطع_ناقص
# الوصف: البعد البؤري ج = √(أ²-ب²) حيث أ > ب
**#
دالة رقم بؤرة_ناقص(رقم أ، رقم ب)
    رقم القيمة = أ * أ - ب * ب
    إذا (القيمة < 0)
        القيمة = 0 - القيمة
    نهاية
    إرجاع هـ_جذر(القيمة)
نهاية


#**
# دالة: اختلاف_مركزي_ناقص
# الوصف: e = ج/أ × 1000
**#
دالة رقم اختلاف_مركزي_ناقص(رقم أ، رقم ب)
    رقم ج = بؤرة_ناقص(أ، ب)
    إذا (أ == 0)
        إرجاع 0
    نهاية
    إرجاع ج * 1000 / أ
نهاية


#**
# دالة: قطع_مكافئ
# الوصف: القطع المكافئ: ص = أ×س²
#         بؤرته: (0, 1/(4أ))
#         دليله: ص = -1/(4أ)
**#
دالة رقم مكافئ_قيمة(رقم أ، رقم س)
    إرجاع أ * س * س
نهاية


#**
# دالة: بؤرة_مكافئ
# الوصف: بؤرة ص = أ×س² هي (0, 1000/(4×أ)) بدقة 1000
**#
دالة رقم بؤرة_مكافئ_ص(رقم أ_1000)
    إذا (أ_1000 == 0)
        إرجاع 0
    نهاية
    إرجاع 250000 / أ_1000
نهاية


#**
# دالة: قطع_زائد
# الوصف: القطع الزائد: س²/أ² - ص²/ب² = 1
#         نحسب القيمة: >0 خارج, =0 على, <0 بين الفرعين
**#
دالة رقم زائد_قيمة(رقم س، رقم ص، رقم أ، رقم ب)
    إرجاع س * س * ب * ب - ص * ص * أ * أ - أ * أ * ب * ب
نهاية


#**
# دالة: بؤرة_زائد
# الوصف: ج = √(أ²+ب²)
**#
دالة رقم بؤرة_زائد(رقم أ، رقم ب)
    إرجاع هـ_جذر(أ * أ + ب * ب)
نهاية


#**
# دالة: خط_تقارب_زائد
# الوصف: خطا التقارب: ص = ±(ب/أ)×س
#         نرجع ميل التقارب × 1000
**#
دالة رقم ميل_تقارب(رقم أ، رقم ب)
    إذا (أ == 0)
        إرجاع 999999
    نهاية
    إرجاع ب * 1000 / أ
نهاية


