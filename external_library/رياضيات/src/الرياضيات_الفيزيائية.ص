#**
# دالة: زمن_السقوط
# الوصف: ز = √(2م/ج)
#         م = المسافة, ج = 10
#         النتيجة × عامل_دقة
**#
دالة رقم زمن_سقوط(رقم المسافة)
    # 2م/ج = 2م/10 = م/5
    رقم تحت_جذر = المسافة * 1000000 / 5
    
    # √تحت_جذر بتقريب نيوتن
    رقم ت = 1000
    إذا (تحت_جذر > 1000000)
        ت = تحت_جذر / 1000
    نهاية
    
    رقم ع = 0
    كرر طالما (ع < 25)
        إذا (ت > 0)
            ت = (ت + تحت_جذر / ت) / 2
        نهاية
        ع = ع + 1
    نهاية
    
    إرجاع ت
نهاية


