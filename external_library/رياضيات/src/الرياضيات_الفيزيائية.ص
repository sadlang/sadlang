#**
# دالة: زمن_البندول
# الوصف: ز = 2π × √(ل/ج)
#         ل = طول البندول, ج = 10
#         النتيجة × عامل_دقة
**#
دالة رقم زمن_بندول(رقم الطول)
    # ل/ج = ل/10
    رقم تحت_جذر = الطول * 1000000 / 10
    
    رقم ت = 1000
    إذا (تحت_جذر > 1000000)
        ت = تحت_جذر / 1000
    نهاية
    
    رقم ع = 0
    كرر طالما (ع < 25)
        إذا (ت > 0)
            ت = (ت + تحت_جذر / ت) / 2
        نهاية
        ع = ع + 1
    نهاية
    
    # 2π × √(ل/ج)
    إرجاع 2 * 3141593 * ت / 1000000
نهاية


