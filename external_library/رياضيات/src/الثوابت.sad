# ═══════════════════════════════════════════════════════════════
# §1.10 - ثوابت التوافقيات وأعداد خاصة
# ═══════════════════════════════════════════════════════════════
#**
# أعداد بيرنولي:
# تظهر في صيغ المجاميع والتحليل
# B₀ = 1, B₁ = -1/2, B₂ = 1/6, B₄ = -1/30, ...
#
# أعداد كاتالان:
# C_n = (2n)! / ((n+1)! · n!)
# 1, 1, 2, 5, 14, 42, 132, 429, 1430, ...
# تعد عدد الطرق المختلفة للأقواس المتوازنة وغيرها
**#

# أعداد كاتالان الأولى (C₀ إلى C₂₀)
# C₀ = 1
ثابت رقم كاتالان_عدد_0 = 1
# C₁ = 1
ثابت رقم كاتالان_عدد_1 = 1
# C₂ = 2
ثابت رقم كاتالان_عدد_2 = 2
# C₃ = 5
ثابت رقم كاتالان_عدد_3 = 5
# C₄ = 14
ثابت رقم كاتالان_عدد_4 = 14
# C₅ = 42
