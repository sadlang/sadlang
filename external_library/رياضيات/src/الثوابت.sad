# ═══════════════════════════════════════════════════════════════
# §1.19 - قيم حساب المثلثات الشائعة
# ═══════════════════════════════════════════════════════════════
#**
# قيم الدوال المثلثية للزوايا الشائعة
# جميع القيم مضروبة في 10^6 للدقة
# sin(θ), cos(θ), tan(θ) للزوايا: 0°, 15°, 30°, 45°, 60°, 75°, 90°
**#

# sin(0°) = 0
ثابت رقم جيب_0 = 0
# sin(15°) ≈ 0.25882
ثابت رقم جيب_15_6 = 258819
# sin(30°) = 0.5
ثابت رقم جيب_30_6 = 500000
# sin(45°) = √2/2 ≈ 0.70711
ثابت رقم جيب_45_6 = 707107
# sin(60°) = √3/2 ≈ 0.86603
ثابت رقم جيب_60_6 = 866025
# sin(75°) ≈ 0.96593
ثابت رقم جيب_75_6 = 965926
# sin(90°) = 1
ثابت رقم جيب_90_6 = 1000000

# cos(0°) = 1
ثابت رقم جتا_0 = 1000000
# cos(15°) ≈ 0.96593
ثابت رقم جتا_15_6 = 965926
# cos(30°) = √3/2 ≈ 0.86603
ثابت رقم جتا_30_6 = 866025
# cos(45°) = √2/2 ≈ 0.70711
ثابت رقم جتا_45_6 = 707107
# cos(60°) = 0.5
ثابت رقم جتا_60_6 = 500000
# cos(75°) ≈ 0.25882
ثابت رقم جتا_75_6 = 258819
# cos(90°) = 0
ثابت رقم جتا_90 = 0

# tan(0°) = 0
ثابت رقم ظل_0 = 0
# tan(15°) ≈ 0.26795
ثابت رقم ظل_15_6 = 267949
# tan(30°) = 1/√3 ≈ 0.57735
ثابت رقم ظل_30_6 = 577350
# tan(45°) = 1
ثابت رقم ظل_45_6 = 1000000
# tan(60°) = √3 ≈ 1.73205
ثابت رقم ظل_60_6 = 1732051
# tan(75°) ≈ 3.73205
ثابت رقم ظل_75_6 = 3732051
# tan(90°) = غير معرّف (لانهاية)
# لا يمكن تعريفه كثابت

# قيم عكسية شائعة
# arcsin(0) = 0 rad
ثابت رقم جيب_عكسي_0 = 0
# arcsin(0.5) = π/6
ثابت رقم جيب_عكسي_نصف_6 = 523599
# arcsin(1) = π/2
ثابت رقم جيب_عكسي_1_6 = 1570796

# arccos(0) = π/2
ثابت رقم جتا_عكسي_0_6 = 1570796
# arccos(0.5) = π/3
ثابت رقم جتا_عكسي_نصف_6 = 1047198
# arccos(1) = 0
ثابت رقم جتا_عكسي_1 = 0

# arctan(1) = π/4
ثابت رقم ظل_عكسي_1_6 = 785398


