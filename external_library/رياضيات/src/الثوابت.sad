# ╔═══════════════════════════════════════════════════════════════════╗
# ║                    الثوابت الرياضية الأساسية                      ║
# ║         Basic Mathematical Constants                              ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# القسم الأول: الأعداد الأساسية والثوابت الشهيرة
# ─────────────────────────────────────────────────────────────────
# هذا القسم يحتوي على أهم الثوابت الرياضية المستخدمة في جميع
# فروع الرياضيات والعلوم والهندسة. كل ثابت مُعرّف بدقة عالية
# باستخدام تمثيل الأعداد الصحيحة مع عامل قياس (Scale Factor)
# لتحقيق أقصى دقة ممكنة في الحسابات.
#
# نظام الدقة:
#   - الثوابت ذات اللاحقة _6 : دقة 6 أرقام عشرية (مضروب في 10^6)
#   - الثوابت ذات اللاحقة _9 : دقة 9 أرقام عشرية (مضروب في 10^9)
#   - الثوابت ذات اللاحقة _12: دقة 12 رقم عشري (مضروب في 10^12)
#   - الثوابت بدون لاحقة: قيمة عددية صحيحة أو مقربة
# ────────────────────────────────────────────────────────────────── **#


# ═══════════════════════════════════════════════════════════════
# §1.1 - النسبة الدائرية (باي - π)
# ═══════════════════════════════════════════════════════════════
#** 
# النسبة الدائرية π (باي):
# هي نسبة محيط الدائرة إلى قطرها، وتساوي تقريباً:
# π ≈ 3.14159265358979323846...
#
# التاريخ:
# - عُرفت منذ بابل القديمة (حوالي 1900 ق.م) حيث استخدموا π ≈ 3.125
# - أرخميدس (287-212 ق.م) حسبها بين 3.1408 و 3.1429
# - الكاشي (1380-1429م) حسبها حتى 16 رقماً عشرياً
# - اليوم تم حسابها حتى تريليونات الأرقام
#
# الاستخدامات:
# - حساب محيط ومساحة الدوائر
# - حساب المثلثات (الزوايا بالراديان)
# - تحويلات فورييه
# - توزيع غاوس الطبيعي
# - ميكانيكا الكم
# - النسبية العامة
**#

# π بدقة 6 أرقام عشرية (π × 10^6 = 3141593)
ثابت رقم باي_6 = 3141593

# π بدقة 9 أرقام عشرية (π × 10^9 = 3141592654)
ثابت رقم باي_9 = 3141592654

# π بدقة 12 رقم عشري (π × 10^12 = 3141592653590)
ثابت رقم باي_12 = 3141592653590

# π/2 (نصف باي) - ربع دورة كاملة (90 درجة)
ثابت رقم نصف_باي_6 = 1570796

# π/2 بدقة 9 أرقام
ثابت رقم نصف_باي_9 = 1570796327

# π/4 (ربع باي) - ثمن دورة كاملة (45 درجة)
ثابت رقم ربع_باي_6 = 785398

# π/4 بدقة 9 أرقام
ثابت رقم ربع_باي_9 = 785398163

# 2π (اثنان باي) - دورة كاملة (360 درجة)
ثابت رقم اثنان_باي_6 = 6283185

# 2π بدقة 9 أرقام
ثابت رقم اثنان_باي_9 = 6283185307

# π² (باي تربيع) ≈ 9.8696
ثابت رقم باي_مربع_6 = 9869604

# π² بدقة 9 أرقام
ثابت رقم باي_مربع_9 = 9869604401

# √π (جذر باي) ≈ 1.7724
ثابت رقم جذر_باي_6 = 1772454

# √π بدقة 9 أرقام
ثابت رقم جذر_باي_9 = 1772453851

# 1/π (مقلوب باي) ≈ 0.31831
ثابت رقم مقلوب_باي_6 = 318310

# 1/π بدقة 9 أرقام
ثابت رقم مقلوب_باي_9 = 318309886

# 2/π ≈ 0.63662
ثابت رقم اثنان_على_باي_6 = 636620

# 2/√π ≈ 1.12838
ثابت رقم اثنان_على_جذر_باي_6 = 1128379

# π/3 (ثلث باي) - سدس دورة (60 درجة)
ثابت رقم ثلث_باي_6 = 1047198

# π/6 (سدس باي) - ثلاثون درجة
ثابت رقم سدس_باي_6 = 523599

# 3π/4
ثابت رقم ثلاثة_ارباع_باي_6 = 2356194

# 3π/2
ثابت رقم ثلاثة_انصاف_باي_6 = 4712389

# π/180 (تحويل من درجات إلى راديان)
ثابت رقم درجة_الى_راديان_9 = 17453293

# 180/π (تحويل من راديان إلى درجات)
ثابت رقم راديان_الى_درجة_6 = 57295780


# ═══════════════════════════════════════════════════════════════
# §1.2 - عدد أويلر (هـ - e)
# ═══════════════════════════════════════════════════════════════
#**
# عدد أويلر e (هـ):
# هو أساس اللوغاريتم الطبيعي، ويساوي تقريباً:
# e ≈ 2.71828182845904523536...
#
# التعريف الرياضي:
# e = lim(n→∞) (1 + 1/n)^n
# e = Σ(n=0→∞) 1/n!
# e = 1 + 1 + 1/2 + 1/6 + 1/24 + 1/120 + ...
#
# التاريخ:
# - اكتشفه جاكوب بيرنولي عام 1683 أثناء دراسة الفائدة المركبة
# - سماه أويلر بالرمز e عام 1731
# - أثبت أويلر أنه عدد غير نسبي
# - أثبت هيرمت عام 1873 أنه عدد متسامي
#
# الاستخدامات:
# - الدوال الأسية واللوغاريتمات
# - حساب الفائدة المركبة
# - النمو والاضمحلال
# - التوزيع الطبيعي
# - معادلة أويلر الشهيرة: e^(iπ) + 1 = 0
**#

# e بدقة 6 أرقام عشرية
ثابت رقم هـ_6 = 2718282

# e بدقة 9 أرقام عشرية
ثابت رقم هـ_9 = 2718281828

# e بدقة 12 رقم عشري
ثابت رقم هـ_12 = 2718281828459

# e² ≈ 7.38906
ثابت رقم هـ_مربع_6 = 7389056

# e² بدقة 9 أرقام
ثابت رقم هـ_مربع_9 = 7389056099

# √e ≈ 1.64872
ثابت رقم جذر_هـ_6 = 1648721

# √e بدقة 9 أرقام
ثابت رقم جذر_هـ_9 = 1648721271

# 1/e ≈ 0.36788
ثابت رقم مقلوب_هـ_6 = 367879

# 1/e بدقة 9 أرقام
ثابت رقم مقلوب_هـ_9 = 367879441

# e^π ≈ 23.14069 (ثابت غيلفوند)
ثابت رقم هـ_اس_باي_6 = 23140693

# ln(2) ≈ 0.69315 (اللوغاريتم الطبيعي لـ 2)
ثابت رقم لو_طبيعي_2_6 = 693147

# ln(2) بدقة 9 أرقام
ثابت رقم لو_طبيعي_2_9 = 693147181

# ln(10) ≈ 2.30259 (اللوغاريتم الطبيعي لـ 10)
ثابت رقم لو_طبيعي_10_6 = 2302585

# ln(10) بدقة 9 أرقام
ثابت رقم لو_طبيعي_10_9 = 2302585093

# log₂(e) ≈ 1.44270
ثابت رقم لو2_هـ_6 = 1442695

# log₁₀(e) ≈ 0.43429
ثابت رقم لو10_هـ_6 = 434294

# 1/ln(2) ≈ 1.44270
ثابت رقم مقلوب_لو_طبيعي_2_6 = 1442695


# ═══════════════════════════════════════════════════════════════
# §1.3 - النسبة الذهبية (فاي - φ)
# ═══════════════════════════════════════════════════════════════
#**
# النسبة الذهبية φ (فاي):
# هي النسبة التي يظهر فيها أجمل تناسق في الطبيعة والفن
# φ = (1 + √5) / 2 ≈ 1.61803398874989...
#
# الخصائص الفريدة:
# φ² = φ + 1
# 1/φ = φ - 1
# φ^n = F(n)·φ + F(n-1) حيث F(n) هو عدد فيبوناتشي
#
# التاريخ:
# - عرفها اليونانيون القدماء، خاصة في المخمس المنتظم
# - استخدمها فيدياس في بناء البارثينون
# - درسها فيبوناتشي في القرن 13
# - سماها مارك بار بالنسبة الذهبية عام 1909
#
# الاستخدامات:
# - تصميم الواجهات (قاعدة التثليث)
# - العمارة والفن
# - خوارزمية البحث الذهبي
# - متتالية فيبوناتشي
# - أنماط النباتات (ترتيب الأوراق)
**#

# φ بدقة 6 أرقام
ثابت رقم فاي_6 = 1618034

# φ بدقة 9 أرقام
ثابت رقم فاي_9 = 1618033989

# φ بدقة 12 رقم
ثابت رقم فاي_12 = 1618033988750

# 1/φ = φ - 1 ≈ 0.61803
ثابت رقم مقلوب_فاي_6 = 618034

# φ² = φ + 1 ≈ 2.61803
ثابت رقم فاي_مربع_6 = 2618034

# √φ ≈ 1.27202
ثابت رقم جذر_فاي_6 = 1272020

# النسبة الذهبية الثانية ψ = 1 - φ ≈ -0.61803
ثابت رقم بسي_6 = 618034  # القيمة المطلقة (سالبة فعلياً)


