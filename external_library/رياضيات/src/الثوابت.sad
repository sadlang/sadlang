# ═══════════════════════════════════════════════════════════════
# §1.7 - ثابت أويلر-ماسكيروني (غاما - γ)
# ═══════════════════════════════════════════════════════════════
#**
# ثابت أويلر-ماسكيروني γ:
# γ = lim(n→∞) (1 + 1/2 + 1/3 + ... + 1/n - ln(n))
# γ ≈ 0.57721566490153286...
#
# هذا الثابت يظهر في:
# - نظرية الأعداد (توزيع الأعداد الأولية)
# - دالة غاما
# - دالة زيتا لريمان
# - التكاملات المحددة
# - نظرية المعلومات
#
# لا يزال مجهولاً ما إذا كان عدداً نسبياً أم غير نسبي!
**#

# γ بدقة 6 أرقام
ثابت رقم غاما_أويلر_6 = 577216

# γ بدقة 9 أرقام  
ثابت رقم غاما_أويلر_9 = 577215665

# γ² ≈ 0.33318
ثابت رقم غاما_أويلر_مربع_6 = 333178

# e^γ ≈ 1.78107
ثابت رقم هـ_اس_غاما_6 = 1781072

# 1/γ ≈ 1.73245
ثابت رقم مقلوب_غاما_أويلر_6 = 1732454


# ═══════════════════════════════════════════════════════════════
# §1.8 - ثابت كاتالان (G)
# ═══════════════════════════════════════════════════════════════
#**
# ثابت كاتالان G:
# G = Σ(n=0→∞) (-1)^n / (2n+1)²
# G = 1 - 1/9 + 1/25 - 1/49 + ...
# G ≈ 0.91596559417721901...
#
# يظهر في:
# - التوافقيات
# - تكاملات الدوال المثلثية
# - نظرية الأعداد
# - طول المنحنيات الإهليلجية
**#

# G بدقة 6 أرقام
ثابت رقم كاتالان_6 = 915966

# G بدقة 9 أرقام
ثابت رقم كاتالان_9 = 915965594


