# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: مساحة_مضلع_شوليس
# الوصف: حساب مساحة مضلع بصيغة شوليس (Shoelace)
#         A = |Σ(x_i * y_{i+1} - x_{i+1} * y_i)| / 2
#         لمضلع من 3 رؤوس (مثلث)
**#
دالة رقم مساحة_مضلع_شوليس_3(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    متغير رقم مج = س1 * (ص2 - ص3) + س2 * (ص3 - ص1) + س3 * (ص1 - ص2)
    إذا (مج < 0)
        مج = 0 - مج
    نهاية
    إرجاع مج / 2
نهاية


#**
# دالة: مساحة_مضلع_شوليس_4
# الوصف: صيغة شوليس لمضلع رباعي
**#
دالة رقم مساحة_مضلع_شوليس_4(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3، رقم س4، رقم ص4)
    متغير رقم مج = (س1 * ص2 - س2 * ص1) + (س2 * ص3 - س3 * ص2) + (س3 * ص4 - س4 * ص3) + (س4 * ص1 - س1 * ص4)
    إذا (مج < 0)
        مج = 0 - مج
    نهاية
    إرجاع مج / 2
نهاية


#**
# دالة: هل_نقطة_داخل_مثلث
# الوصف: التحقق هل نقطة P داخل مثلث ABC
#         باستخدام طريقة المساحات
# المعاملات:
#   - نس، نص: إحداثيات النقطة
#   - أس..جص: إحداثيات رؤوس المثلث
# الإرجاع: 1 إذا داخل، 0 إذا خارج
**#
دالة رقم هل_نقطة_داخل_مثلث(رقم نس، رقم نص، رقم أس، رقم أص، رقم بس، رقم بص، رقم جس، رقم جص)
    متغير رقم مج_كلي = مساحة_مضلع_شوليس_3(أس، أص، بس، بص، جس، جص)
    
    متغير رقم مج1 = مساحة_مضلع_شوليس_3(نس، نص، بس، بص، جس، جص)
    متغير رقم مج2 = مساحة_مضلع_شوليس_3(أس، أص، نس، نص، جس، جص)
    متغير رقم مج3 = مساحة_مضلع_شوليس_3(أس، أص، بس، بص، نس، نص)
    
    إذا (مج1 + مج2 + مج3 == مج_كلي)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


