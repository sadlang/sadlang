#**
# دالة: خاصية_أويلر_متعدد_وجوه
# الوصف: نظرية أويلر للمتعددات الوجوه المحدبة:
#         V - E + F = 2
#         حيث V=رؤوس, E=أحرف, F=أوجه
# المعاملات:
#   - رؤوس: عدد الرؤوس V
#   - أحرف: عدد الأحرف E
#   - أوجه: عدد الأوجه F
# الإرجاع: V - E + F (يجب = 2 للمحدب)
**#
دالة رقم خاصية_أويلر_متعدد_وجوه(رقم رؤوس، رقم أحرف، رقم أوجه)
    إرجاع رؤوس - أحرف + أوجه
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 5: الجيوديسيك (Geodesics)                              ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: مسافة_عظمى_كرة
# الوصف: المسافة العظمى (Great Circle) على سطح الكرة
#         d = R * arccos(sin(φ1)*sin(φ2) + cos(φ1)*cos(φ2)*cos(Δλ))
#         تقريب هافرساين مبسط
# المعاملات:
#   - عرض1، طول1: خط العرض والطول للنقطة 1 (درجات)
#   - عرض2، طول2: النقطة الثانية
#   - نصف_قطر: نصف قطر الكرة
# الإرجاع: المسافة (مكبرة ×1000)
**#
دالة رقم مسافة_عظمى_كرة(رقم عرض1، رقم طول1، رقم عرض2، رقم طول2، رقم نصف_قطر)
    # تقريب: d ≈ R * √((Δφ)² + (cos(φ_m)*Δλ)²)
    # أبسط: هافرساين مبسط
    
    متغير رقم دعرض = عرض2 - عرض1
    متغير رقم دطول = طول2 - طول1
    
    # تحويل إلى راديان ×1000
    متغير رقم دعرض_راد = (دعرض * 3142) / 180
    متغير رقم دطول_راد = (دطول * 3142) / 180
    
    # تقريب بسيط: d ≈ R * √(Δφ² + Δλ²) (بدون تصحيح)
    متغير رقم مج = (دعرض_راد * دعرض_راد) / 1000 + (دطول_راد * دطول_راد) / 1000
    
    إذا (مج == 0)
        إرجاع 0
    نهاية
    
    متغير رقم جذر = مج / 2
    إذا (جذر <= 0)
        جذر = 1
    نهاية
    متغير رقم ع = 0
    طالما (ع < 15)
        إذا (جذر == 0)
            جذر = 1
        نهاية
        جذر = (جذر + مج / جذر) / 2
        ع = ع + 1
    نهاية
    
    إرجاع نصف_قطر * جذر
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
