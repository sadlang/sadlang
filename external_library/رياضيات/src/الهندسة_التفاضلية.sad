# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 1: المنحنيات في المستوي (Plane Curves)                 ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# المنحنى في المستوي يمكن تمثيله بعدة طرق:
# 1. صريحة: y = f(x)
# 2. ضمنية: F(x,y) = 0
# 3. بارمترية: (x(t), y(t))
# 4. قطبية: r = f(θ)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: منحنى_دائرة_س
# الوصف: إحداثي x لمنحنى الدائرة البارمتري
#         x(t) = cx + r * cos(t)
#         نستخدم تقريب جيب التمام
# المعاملات:
#   - مركز_س: إحداثي x للمركز
#   - نصف_قطر: نصف القطر
#   - ت_مكبر: المعامل t (زاوية) درجات
# الإرجاع: x(t) مكبر ×1000
**#
دالة رقم منحنى_دائرة_س(رقم مركز_س، رقم نصف_قطر، رقم ت_مكبر)
    # cos(t) بالدرجات - تقريب بسيط
    متغير رقم زاوية = ت_مكبر
    # تطبيع الزاوية 0-360
    طالما (زاوية >= 360)
        زاوية = زاوية - 360
    نهاية
    طالما (زاوية < 0)
        زاوية = زاوية + 360
    نهاية
    
    # تقريب cos بجدول بسيط (×1000)
    متغير رقم جتا = 1000
    إذا (زاوية == 0)
        جتا = 1000
    نهاية
    إذا (زاوية == 90)
        جتا = 0
    نهاية
    إذا (زاوية == 180)
        جتا = 0 - 1000
    نهاية
    إذا (زاوية == 270)
        جتا = 0
    نهاية
    إذا (زاوية == 30)
        جتا = 866
    نهاية
    إذا (زاوية == 45)
        جتا = 707
    نهاية
    إذا (زاوية == 60)
        جتا = 500
    نهاية
    إذا (زاوية == 120)
        جتا = 0 - 500
    نهاية
    إذا (زاوية == 135)
        جتا = 0 - 707
    نهاية
    إذا (زاوية == 150)
        جتا = 0 - 866
    نهاية
    إذا (زاوية == 210)
        جتا = 0 - 866
    نهاية
    إذا (زاوية == 225)
        جتا = 0 - 707
    نهاية
    إذا (زاوية == 240)
        جتا = 0 - 500
    نهاية
    إذا (زاوية == 300)
        جتا = 500
    نهاية
    إذا (زاوية == 315)
        جتا = 707
    نهاية
    إذا (زاوية == 330)
        جتا = 866
    نهاية
    
    إرجاع مركز_س * 1000 + (نصف_قطر * جتا)
نهاية


#**
# دالة: منحنى_قطع_ناقص_س
# الوصف: إحداثي x لمنحنى القطع الناقص البارمتري
#         x(t) = cx + a * cos(t)
# المعاملات:
#   - مركز_س: x المركز
#   - أ: نصف المحور الأكبر
#   - جتا_مكبر: cos(t) مكبر ×1000
# الإرجاع: x(t) مكبر ×1000
**#
دالة رقم منحنى_قطع_ناقص_س(رقم مركز_س، رقم أ، رقم جتا_مكبر)
    إرجاع مركز_س * 1000 + أ * جتا_مكبر
نهاية


#**
# دالة: منحنى_قطع_ناقص_ص
# الوصف: إحداثي y لمنحنى القطع الناقص
#         y(t) = cy + b * sin(t)
**#
دالة رقم منحنى_قطع_ناقص_ص(رقم مركز_ص، رقم ب، رقم جا_مكبر)
    إرجاع مركز_ص * 1000 + ب * جا_مكبر
نهاية


#**
# دالة: منحنى_حلزوني_أرخميدس_ر
# الوصف: حلزون أرخميدس r = a + b*θ
#         المسافة بين اللفات ثابتة
# المعاملات:
#   - أ: القطر الابتدائي
#   - ب: معدل التوسع (مكبر ×1000)
#   - ثيتا: الزاوية (بالدرجات)
# الإرجاع: r (مكبر ×1000)
**#
دالة رقم منحنى_حلزوني_أرخميدس_ر(رقم أ، رقم ب، رقم ثيتا)
    # تحويل الزاوية إلى راديان (تقريب) ×1000
    متغير رقم ثيتا_راد = (ثيتا * 3142) / 180000
    إرجاع أ * 1000 + ب * ثيتا_راد
نهاية


#**
# دالة: منحنى_حلزوني_لوغاريتمي_ر
# الوصف: حلزون لوغاريتمي r = a * e^(bθ)
#         يظهر في الطبيعة (أصداف، مجرات)
# المعاملات:
#   - أ: القطر الابتدائي (مكبر ×1000)
#   - ب_مكبر: معامل النمو (×1000)
#   - ثيتا: الزاوية (درجات)
# الإرجاع: r (مكبر ×1000)
**#
دالة رقم منحنى_حلزوني_لوغاريتمي_ر(رقم أ، رقم ب_مكبر، رقم ثيتا)
    متغير رقم ثيتا_راد = (ثيتا * 3142) / 180000
    
    # e^(b*θ) بتقريب (1+bθ/n)^n
    متغير رقم أس = (ب_مكبر * ثيتا_راد) / 1000
    # تقريب e^x ≈ 1 + x + x²/2
    متغير رقم نتيجة = 1000 + أس + (أس * أس) / 2000
    
    إرجاع (أ * نتيجة) / 1000
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 2: الانحناء (Curvature)                                ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# الانحناء κ يقيس مدى "انحراف" المنحنى عن الخط المستقيم.
#
# لمنحنى y = f(x):
# κ = |f''| / (1 + f'²)^(3/2)
#
# لمنحنى بارمتري (x(t), y(t)):
# κ = |x'y'' - y'x''| / (x'² + y'²)^(3/2)
#
# نصف قطر الانحناء:
# ρ = 1/κ
#
# الانحناء:
# - خط مستقيم: κ = 0
# - دائرة نصف قطرها r: κ = 1/r
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: انحناء_دائرة
# الوصف: انحناء الدائرة κ = 1/r (ثابت)
# المعاملات:
#   - نصف_قطر: r
# الإرجاع: κ مكبر ×10000
**#
دالة رقم انحناء_دائرة(رقم نصف_قطر)
    إذا (نصف_قطر == 0)
        إرجاع 999999
    نهاية
    إرجاع 10000 / نصف_قطر
نهاية


#**
# دالة: انحناء_من_مشتقات
# الوصف: حساب انحناء y=f(x) من المشتقتين الأولى والثانية
#         κ = |f''| / (1 + f'²)^(3/2)
# المعاملات:
#   - م1: f' المشتقة الأولى (مكبرة ×1000)
#   - م2: f'' المشتقة الثانية (مكبرة ×1000)
# الإرجاع: κ مكبر ×10000
**#
دالة رقم انحناء_من_مشتقات(رقم م1، رقم م2)
    # الصيغة: |m2| / (1 + m1²)^(3/2)
    # البسط: |m2|
    متغير رقم بسط = م2
    إذا (بسط < 0)
        بسط = 0 - بسط
    نهاية
    
    # المقام: (1 + m1²/10^6)^(3/2)
    # نحسب 1 + m1²/10^6 (×1000)
    متغير رقم مج = 1000 + (م1 * م1) / 1000
    
    # (مج)^(3/2) = مج * √مج
    # √مج (نيوتن)
    متغير رقم جذر = مج / 2
    إذا (جذر <= 0)
        جذر = 1
    نهاية
    متغير رقم ع = 0
    طالما (ع < 10)
        إذا (جذر == 0)
            جذر = 1
        نهاية
        جذر = (جذر + (مج * 1000) / جذر) / 2
        ع = ع + 1
    نهاية
    
    # مج^(3/2) = مج * جذر/1000
    متغير رقم مقام = (مج * جذر) / 1000
    
    إذا (مقام == 0)
        إرجاع 0
    نهاية
    
    إرجاع (بسط * 10000) / مقام
نهاية


#**
# دالة: نصف_قطر_انحناء_دائرة
# الوصف: حساب نصف قطر الانحناء = 1/κ
# المعاملات:
#   - انحناء: κ (مكبر ×10000)
# الإرجاع: ρ (نصف قطر الانحناء)
**#
دالة رقم نصف_قطر_انحناء_دائرة(رقم انحناء)
    إذا (انحناء == 0)
        إرجاع 999999
    نهاية
    إرجاع 10000 / انحناء
نهاية


#**
# دالة: مركز_انحناء_س
# الوصف: إحداثي x لمركز الانحناء
#         cx = x - f'*(1+f'²)/f''
**#
دالة رقم مركز_انحناء_س(رقم س، رقم م1_مكبر، رقم م2_مكبر)
    إذا (م2_مكبر == 0)
        إرجاع 999999
    نهاية
    متغير رقم بسط = م1_مكبر * (1000 + (م1_مكبر * م1_مكبر) / 1000)
    إرجاع س * 1000 - بسط / م2_مكبر
نهاية


#**
# دالة: مركز_انحناء_ص
# الوصف: إحداثي y لمركز الانحناء
#         cy = y + (1+f'²)/f''
**#
دالة رقم مركز_انحناء_ص(رقم ص، رقم م1_مكبر، رقم م2_مكبر)
    إذا (م2_مكبر == 0)
        إرجاع 999999
    نهاية
    متغير رقم بسط = 1000 + (م1_مكبر * م1_مكبر) / 1000
    إرجاع ص * 1000 + (بسط * 1000) / م2_مكبر
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 3: المنحنيات في الفراغ (Space Curves)                  ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: طول_قوس_تقريبي
# الوصف: تقريب طول القوس بين نقطتين على المنحنى
#         ds ≈ √(Δx² + Δy²)
#         = √((x1-x0)² + (y1-y0)²)
# المعاملات: نقطتان
# الإرجاع: الطول مكبر ×1000
**#
دالة رقم طول_قوس_تقريبي(رقم س0، رقم ص0، رقم س1، رقم ص1)
    متغير رقم دلتا_س = س1 - س0
    متغير رقم دلتا_ص = ص1 - ص0
    متغير رقم مج_مربعات = دلتا_س * دلتا_س + دلتا_ص * دلتا_ص
    
    إذا (مج_مربعات == 0)
        إرجاع 0
    نهاية
    
    # √(مج) بنيوتن
    متغير رقم تخمين = (دلتا_س + دلتا_ص) / 2
    إذا (تخمين < 0)
        تخمين = 0 - تخمين
    نهاية
    إذا (تخمين == 0)
        تخمين = 1
    نهاية
    
    متغير رقم ع = 0
    طالما (ع < 15)
        إذا (تخمين == 0)
            تخمين = 1
        نهاية
        تخمين = (تخمين + مج_مربعات / تخمين) / 2
        ع = ع + 1
    نهاية
    
    إرجاع تخمين * 1000
نهاية


#**
# دالة: طول_قوس_3د_تقريبي
# الوصف: تقريب طول القوس في الفراغ الثلاثي
#         ds ≈ √(Δx² + Δy² + Δz²)
**#
دالة رقم طول_قوس_3د_تقريبي(رقم س0، رقم ص0، رقم ز0، رقم س1، رقم ص1، رقم ز1)
    متغير رقم دس = س1 - س0
    متغير رقم دص = ص1 - ص0
    متغير رقم دز = ز1 - ز0
    متغير رقم مج = دس * دس + دص * دص + دز * دز
    
    إذا (مج == 0)
        إرجاع 0
    نهاية
    
    متغير رقم تخمين = مج / 2
    إذا (تخمين <= 0)
        تخمين = 1
    نهاية
    
    متغير رقم ع = 0
    طالما (ع < 15)
        إذا (تخمين == 0)
            تخمين = 1
        نهاية
        تخمين = (تخمين + مج / تخمين) / 2
        ع = ع + 1
    نهاية
    
    إرجاع تخمين * 1000
نهاية


#**
# دالة: التواء_حلزوني
# الوصف: حساب الالتواء (Torsion) للحلزون الدائري
#         حلزون: (a*cos(t), a*sin(t), bt)
#         τ = b / (a² + b²) (ثابت!)
# المعاملات:
#   - أ: نصف القطر (مكبر ×1000)
#   - ب: الميل (مكبر ×1000)
# الإرجاع: τ مكبر ×10000
**#
دالة رقم التواء_حلزوني(رقم أ، رقم ب)
    متغير رقم مقام = (أ * أ) / 1000 + (ب * ب) / 1000
    إذا (مقام == 0)
        إرجاع 0
    نهاية
    إرجاع (ب * 10000) / مقام
نهاية


