#**
# دالة: محيط_كوخ_ندفة_عند_تكرار
# الوصف: محيط ندفة ثلج كوخ عند التكرار n
#         P(n) = P₀ * (4/3)^n
#         حيث P₀ = 3s (مثلث متساوي الأضلاع)
# المعاملات:
#   - ضلع: طول ضلع المثلث الابتدائي
#   - تكرار: رقم التكرار
# الإرجاع: المحيط
**#
دالة رقم محيط_كوخ_ندفة_عند_تكرار(رقم ضلع، رقم تكرار)
    متغير رقم محيط = 3 * ضلع * 1000
    
    متغير رقم ع = 0
    طالما (ع < تكرار)
        محيط = محيط * 4 / 3
        ع = ع + 1
    نهاية
    
    إرجاع محيط
نهاية


#**
# دالة: مساحة_كوخ_ندفة_عند_تكرار
# الوصف: مساحة ندفة ثلج كوخ عند التكرار n
#         تتقارب إلى 8/5 * مساحة المثلث الأصلي
#         A(n) = A₀ * (1 + 3*Σ(4/9)^k)
# المعاملات:
#   - ضلع: طول الضلع (مثلث ابتدائي)
#   - تكرار: رقم التكرار
# الإرجاع: المساحة مكبرة ×1000
**#
دالة رقم مساحة_كوخ_ندفة_عند_تكرار(رقم ضلع، رقم تكرار)
    # مساحة المثلث = √3/4 * s² ≈ 433*s²/1000
    متغير رقم أ0 = 433 * ضلع * ضلع / 1000
    
    # A_total = A₀ + (A₀/3) * Σ(k=0→n-1)(4/9)^k
    متغير رقم مج = 0
    متغير رقم حد = 1000  # (4/9)^0 = 1 مكبر ×1000
    
    متغير رقم ع = 0
    طالما (ع < تكرار)
        مج = مج + حد
        حد = حد * 4 / 9
        ع = ع + 1
    نهاية
    
    إرجاع أ0 * 1000 + أ0 * مج / 3
نهاية


#**
# دالة: ماندلبرو_تكرارات
# الوصف: عدد تكرارات الإفلات لنقطة في مجموعة ماندلبرو
#         z_{n+1} = z_n² + c
#         z₀ = 0، والنقطة تنتمي إذا لم يتجاوز |z| العتبة 2
# المعاملات:
#   - ج_حقيقي: الجزء الحقيقي من c (مكبر ×1000)
#   - ج_تخيلي: الجزء التخيلي من c (مكبر ×1000)
#   - حد_تكرار: الحد الأقصى للتكرارات
# الإرجاع: عدد التكرارات حتى الإفلات (حد_تكرار إذا لم يفلت)
**#
دالة رقم ماندلبرو_تكرارات(رقم ج_حقيقي، رقم ج_تخيلي، رقم حد_تكرار)
    متغير رقم ز_ح = 0   # الجزء الحقيقي من z
    متغير رقم ز_ت = 0   # الجزء التخيلي من z
    متغير رقم ع = 0
    
    طالما (ع < حد_تكرار)
        # z² = (zr + zi*i)² = zr²-zi² + 2*zr*zi*i
        متغير رقم ز_ح_جديد = (ز_ح * ز_ح - ز_ت * ز_ت) / 1000 + ج_حقيقي
        متغير رقم ز_ت_جديد = 2 * ز_ح * ز_ت / 1000 + ج_تخيلي
        
        ز_ح = ز_ح_جديد
        ز_ت = ز_ت_جديد
        
        # |z|² = zr² + zi²
        متغير رقم مطلق2 = (ز_ح * ز_ح + ز_ت * ز_ت) / 1000
        
        إذا (مطلق2 > 4000)  # |z| > 2
            إرجاع ع
        نهاية
        
        ع = ع + 1
    نهاية
    
    إرجاع حد_تكرار
نهاية


