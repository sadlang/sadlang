# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: ليساجو_س
# الوصف: إحداثي x لمنحنيات ليساجو
#         x(t) = A * sin(a*t + δ)
#         تنتج أشكالاً جميلة عند نسب a:b بسيطة
# المعاملات:
#   - سعة: A
#   - ت_مكبر: معامل t (×1000)
#   - أ: تردد x
#   - دلتا_مكبر: إزاحة الطور (×1000 راديان)
# الإرجاع: x(t) (×1000)
**#
دالة رقم ليساجو_س(رقم سعة، رقم ت_مكبر، رقم أ، رقم دلتا_مكبر)
    # sin(a*t + δ) - تقريب
    متغير رقم زاوية = (أ * ت_مكبر + دلتا_مكبر)
    # sin بتقريب تايلور: sin(x) ≈ x - x³/6
    متغير رقم جا = زاوية - (زاوية * زاوية * زاوية) / 6000000
    إرجاع (سعة * جا) / 1000
نهاية


#**
# دالة: ليساجو_ص
# الوصف: إحداثي y لمنحنيات ليساجو
#         y(t) = B * sin(b*t)
**#
دالة رقم ليساجو_ص(رقم سعة، رقم ت_مكبر، رقم ب)
    متغير رقم زاوية = ب * ت_مكبر
    متغير رقم جا = زاوية - (زاوية * زاوية * زاوية) / 6000000
    إرجاع (سعة * جا) / 1000
نهاية


#**
# دالة: سايكلويد_س
# الوصف: منحنى السايكلويد (Cycloid) - مسار نقطة على دائرة متدحرجة
#         x(t) = r*(t - sin(t))
# المعاملات:
#   - ر: نصف القطر
#   - ت_مكبر: المعامل t (مكبر ×1000 راديان)
#   - جا_مكبر: sin(t) (مكبر ×1000)
# الإرجاع: x(t) (مكبر ×1000)
**#
دالة رقم سايكلويد_س(رقم ر، رقم ت_مكبر، رقم جا_مكبر)
    إرجاع ر * (ت_مكبر - جا_مكبر)
نهاية


#**
# دالة: سايكلويد_ص
# الوصف: y(t) = r*(1 - cos(t))
**#
دالة رقم سايكلويد_ص(رقم ر، رقم جتا_مكبر)
    إرجاع ر * (1000 - جتا_مكبر)
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║     القسم 10: الاختبارات الذاتية                                  ║
# ╚═══════════════════════════════════════════════════════════════════╝


دالة رقم تشغيل_اختبارات_الهندسة_التفاضلية()
    متغير رقم نجاح = 0
    متغير رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبارات الهندسة التفاضلية")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # انحناء الدائرة r=5 → κ=1/5=2000/10000
    إذا (انحناء_دائرة(5) == 2000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ انحناء دائرة")
    وإلا
        فشل = فشل + 1
        اطبع("✗ انحناء دائرة: ")
        اطبع_سطر(انحناء_دائرة(5))
    نهاية
    
    # مساحة سطح كرة r=1 → 4π ≈ 12566
    متغير رقم مس = مساحة_سطح_كرة(1)
    إذا (مس == 12566)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مساحة سطح كرة")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مساحة سطح كرة: ")
        اطبع_سطر(مس)
    نهاية
    
    # صيغة أويلر: مكعب V=8, E=12, F=6 → 8-12+6=2
    إذا (خاصية_أويلر_متعدد_وجوه(8، 12، 6) == 2)
        نجاح = نجاح + 1
        اطبع_سطر("✓ صيغة أويلر (مكعب)")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ صيغة أويلر")
    نهاية
    
    # مساحة مثلث بشوليس (0,0)(4,0)(0,3) → 6
    إذا (مساحة_مضلع_شوليس_3(0، 0، 4، 0، 0، 3) == 6)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مساحة مثلث (شوليس)")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مساحة شوليس: ")
        اطبع_سطر(مساحة_مضلع_شوليس_3(0، 0، 4، 0، 0، 3))
    نهاية
    
    # ماندلبرو: (0,0) يبقى → حد_تكرار
    إذا (ماندلبرو_تكرارات(0، 0، 100) == 100)
        نجاح = نجاح + 1
        اطبع_سطر("✓ ماندلبرو (0,0)")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ ماندلبرو")
    نهاية
    
    # بعد كسري كوخ ≈ 1.2619 → 12619
    إذا (بعد_كسري_كوخ() == 12619)
        نجاح = نجاح + 1
        اطبع_سطر("✓ بعد كسري كوخ")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ بعد كسري كوخ")
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


