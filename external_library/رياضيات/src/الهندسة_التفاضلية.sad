#**
# دالة: تحويل_أفيني_س
# الوصف: التحويل الأفيني في المستوي
#         x' = a*x + b*y + tx
# المعاملات:
#   - س، ص: الإحداثيات الأصلية
#   - أ، ب: معاملات التحويل
#   - إزاحة_س: الانسحاب tx
# الإرجاع: x' (مكبر ×1000)
**#
دالة رقم تحويل_أفيني_س(رقم س، رقم ص، رقم أ، رقم ب، رقم إزاحة_س)
    إرجاع (أ * س + ب * ص) + إزاحة_س * 1000
نهاية


#**
# دالة: تحويل_أفيني_ص
# الوصف: y' = c*x + d*y + ty
**#
دالة رقم تحويل_أفيني_ص(رقم س، رقم ص، رقم ج، رقم د، رقم إزاحة_ص)
    إرجاع (ج * س + د * ص) + إزاحة_ص * 1000
نهاية


#**
# دالة: تحويل_إسقاطي_س
# الوصف: التحويل الإسقاطي (المنظور)
#         x' = (a*x + b*y + c) / (g*x + h*y + 1)
#         يحافظ على الخطوط المستقيمة لكن ليس التوازي
**#
دالة رقم تحويل_إسقاطي_س(رقم س، رقم ص، رقم أ، رقم ب، رقم ج، رقم غ، رقم ه)
    متغير رقم مقام = (غ * س + ه * ص) / 1000 + 1000
    إذا (مقام == 0)
        إرجاع 999999
    نهاية
    إرجاع (أ * س + ب * ص + ج * 1000) * 1000 / مقام
نهاية


