# ─────────────────────────────────────────────────────────────────
#
# تمثيل كثيرات الحدود:
# ─────────────────────────────────────────────────────────────────
# بما أن لغة ص ليس لديها مصفوفات مُدمَجة، نمثل كثيرة الحدود
# بمعاملاتها المنفصلة. مثلاً كثيرة الحدود:
#   ق(س) = أ₃×س³ + أ₂×س² + أ₁×س + أ₀
# تُمثَّل بأربعة معاملات: أ3، أ2، أ1، أ0
#
# الاتفاقية: المعامل الأول هو معامل الدرجة الأعلى
# ═══════════════════════════════════════════════════════════════════
**#


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 1: تقييم كثيرات الحدود                              ║
# ║          Section 1: Polynomial Evaluation                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# تقييم كثيرة الحدود يعني حساب قيمتها عند نقطة معينة.
# الطريقة المباشرة: حساب كل حد على حدة ثم الجمع.
# الطريقة الأكفأ: خوارزمية هورنر (القسم التالي).
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: كثيرة_حدود_1
# الوصف: تقييم كثيرة حدود من الدرجة الأولى
#         ق(س) = أ×س + ب
# المعاملات: المعاملات وقيمة س
# الإرجاع: قيمة كثيرة الحدود
# مثال: كثيرة_حدود_1(3، 2، 5) = 17 (أي 3×5+2)
**#
دالة رقم كثيرة_حدود_1(رقم أ، رقم ب، رقم س)
    إرجاع أ * س + ب
نهاية


#**
# دالة: كثيرة_حدود_2
# الوصف: تقييم كثيرة حدود من الدرجة الثانية
#         ق(س) = أ×س² + ب×س + ج
# مثال: كثيرة_حدود_2(1، -3، 2، 5) = 12 (أي 25-15+2)
**#
دالة رقم كثيرة_حدود_2(رقم أ، رقم ب، رقم ج، رقم س)
    إرجاع أ * س * س + ب * س + ج
نهاية


#**
# دالة: كثيرة_حدود_3
# الوصف: تقييم كثيرة حدود من الدرجة الثالثة
#         ق(س) = أ×س³ + ب×س² + ج×س + د
**#
دالة رقم كثيرة_حدود_3(رقم أ، رقم ب، رقم ج، رقم د، رقم س)
    إرجاع أ * س * س * س + ب * س * س + ج * س + د
نهاية


#**
# دالة: كثيرة_حدود_4
# الوصف: تقييم كثيرة حدود من الدرجة الرابعة
#         ق(س) = أ×س⁴ + ب×س³ + ج×س² + د×س + هـ
**#
دالة رقم كثيرة_حدود_4(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم س)
    رقم س2 = س * س
    إرجاع أ * س2 * س2 + ب * س2 * س + ج * س2 + د * س + هـ
نهاية


#**
# دالة: كثيرة_حدود_5
# الوصف: تقييم كثيرة حدود من الدرجة الخامسة
#         ق(س) = أ×س⁵ + ب×س⁴ + ج×س³ + د×س² + هـ×س + و
**#
دالة رقم كثيرة_حدود_5(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم و، رقم س)
    رقم س2 = س * س
    رقم س3 = س2 * س
    رقم س4 = س3 * س
    رقم س5 = س4 * س
    إرجاع أ * س5 + ب * س4 + ج * س3 + د * س2 + هـ * س + و
نهاية


#**
# دالة: كثيرة_حدود_6
# الوصف: تقييم كثيرة حدود من الدرجة السادسة
**#
دالة رقم كثيرة_حدود_6(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم و، رقم ز، رقم س)
    رقم س2 = س * س
    رقم س3 = س2 * س
    رقم س4 = س3 * س
    رقم س5 = س4 * س
    رقم س6 = س5 * س
    إرجاع أ * س6 + ب * س5 + ج * س4 + د * س3 + هـ * س2 + و * س + ز
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 2: خوارزمية هورنر                                   ║
# ║          Section 2: Horner's Method                                ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# خوارزمية هورنر (Horner's Method):
# طريقة فعالة لتقييم كثيرات الحدود تقلل عدد عمليات الضرب.
#
# بدلاً من: أ₃×س³ + أ₂×س² + أ₁×س + أ₀
# نحسب:    ((أ₃×س + أ₂)×س + أ₁)×س + أ₀
#
# الفائدة:
# - الطريقة المباشرة: 6 عمليات ضرب + 3 عمليات جمع (للدرجة 3)
# - طريقة هورنر: 3 عمليات ضرب + 3 عمليات جمع فقط!
# - للدرجة ن: ن عملية ضرب + ن عملية جمع (بدلاً من ن(ن+1)/2)
#
# التاريخ:
# - سُميت نسبة لوليام جورج هورنر (1819م)
# - لكن عُرفت من قبل بواسطة تشين جيوشاو في الصين (1247م)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: هورنر_2
# الوصف: تقييم كثيرة حدود من الدرجة 2 بطريقة هورنر
#         ق(س) = (أ×س + ب)×س + ج
# المعاملات: أ (معامل س²)، ب (معامل س)، ج (الحد الثابت)، س (النقطة)
# الإرجاع: قيمة كثيرة الحدود
**#
دالة رقم هورنر_2(رقم أ، رقم ب، رقم ج، رقم س)
    رقم نتيجة = أ
    نتيجة = نتيجة * س + ب
    نتيجة = نتيجة * س + ج
    إرجاع نتيجة
نهاية


#**
# دالة: هورنر_3
# الوصف: تقييم كثيرة حدود من الدرجة 3 بطريقة هورنر
#         ق(س) = ((أ×س + ب)×س + ج)×س + د
**#
دالة رقم هورنر_3(رقم أ، رقم ب، رقم ج، رقم د، رقم س)
    رقم نتيجة = أ
    نتيجة = نتيجة * س + ب
    نتيجة = نتيجة * س + ج
    نتيجة = نتيجة * س + د
    إرجاع نتيجة
نهاية


#**
# دالة: هورنر_4
# الوصف: تقييم كثيرة حدود من الدرجة 4 بطريقة هورنر
**#
دالة رقم هورنر_4(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم س)
    رقم نتيجة = أ
    نتيجة = نتيجة * س + ب
    نتيجة = نتيجة * س + ج
    نتيجة = نتيجة * س + د
    نتيجة = نتيجة * س + هـ
    إرجاع نتيجة
نهاية


#**
# دالة: هورنر_5
# الوصف: تقييم كثيرة حدود من الدرجة 5 بطريقة هورنر
**#
دالة رقم هورنر_5(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم و، رقم س)
    رقم نتيجة = أ
    نتيجة = نتيجة * س + ب
    نتيجة = نتيجة * س + ج
    نتيجة = نتيجة * س + د
    نتيجة = نتيجة * س + هـ
    نتيجة = نتيجة * س + و
    إرجاع نتيجة
نهاية


#**
# دالة: هورنر_6
# الوصف: تقييم كثيرة حدود من الدرجة 6 بطريقة هورنر
**#
دالة رقم هورنر_6(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم و، رقم ز، رقم س)
    رقم نتيجة = أ
    نتيجة = نتيجة * س + ب
    نتيجة = نتيجة * س + ج
    نتيجة = نتيجة * س + د
    نتيجة = نتيجة * س + هـ
    نتيجة = نتيجة * س + و
    نتيجة = نتيجة * س + ز
    إرجاع نتيجة
نهاية


#**
# دالة: هورنر_7
# الوصف: تقييم كثيرة حدود من الدرجة 7 بطريقة هورنر
**#
دالة رقم هورنر_7(رقم م7، رقم م6، رقم م5، رقم م4، رقم م3، رقم م2، رقم م1، رقم م0، رقم س)
    رقم نتيجة = م7
    نتيجة = نتيجة * س + م6
    نتيجة = نتيجة * س + م5
    نتيجة = نتيجة * س + م4
    نتيجة = نتيجة * س + م3
    نتيجة = نتيجة * س + م2
    نتيجة = نتيجة * س + م1
    نتيجة = نتيجة * س + م0
    إرجاع نتيجة
نهاية


#**
# دالة: هورنر_8
# الوصف: تقييم كثيرة حدود من الدرجة 8 بطريقة هورنر
**#
دالة رقم هورنر_8(رقم م8، رقم م7، رقم م6، رقم م5، رقم م4، رقم م3، رقم م2، رقم م1، رقم م0، رقم س)
    رقم نتيجة = م8
    نتيجة = نتيجة * س + م7
    نتيجة = نتيجة * س + م6
    نتيجة = نتيجة * س + م5
    نتيجة = نتيجة * س + م4
    نتيجة = نتيجة * س + م3
    نتيجة = نتيجة * س + م2
    نتيجة = نتيجة * س + م1
    نتيجة = نتيجة * س + م0
    إرجاع نتيجة
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 3: عمليات كثيرات الحدود (جمع / طرح)               ║
# ║          Section 3: Polynomial Addition / Subtraction              ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# جمع كثيرتي حدود:
# (أ₂×س² + أ₁×س + أ₀) + (ب₂×س² + ب₁×س + ب₀)
# = (أ₂+ب₂)×س² + (أ₁+ب₁)×س + (أ₀+ب₀)
#
# أي نجمع المعاملات المتناظرة (نفس القوة)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: جمع_حدود_2_م2
# الوصف: جمع كثيرتي حدود من الدرجة 2 - معامل س²
# ق(س) = أ1×س² + ب1×س + ج1
# ج(س) = أ2×س² + ب2×س + ج2
# الإرجاع: معامل س² في المجموع (أ1 + أ2)
**#
دالة رقم جمع_حدود_2_م2(رقم أ1، رقم أ2)
    إرجاع أ1 + أ2
نهاية

#**
# دالة: جمع_حدود_2_م1
# الوصف: معامل س في مجموع كثيرتي حدود من الدرجة 2
**#
دالة رقم جمع_حدود_2_م1(رقم ب1، رقم ب2)
    إرجاع ب1 + ب2
نهاية

#**
# دالة: جمع_حدود_2_م0
# الوصف: الحد الثابت في مجموع كثيرتي حدود من الدرجة 2
**#
دالة رقم جمع_حدود_2_م0(رقم ج1، رقم ج2)
    إرجاع ج1 + ج2
نهاية


#**
# دالة: طرح_حدود_2_م2
# الوصف: طرح كثيرتي حدود من الدرجة 2 - معامل س²
**#
دالة رقم طرح_حدود_2_م2(رقم أ1، رقم أ2)
    إرجاع أ1 - أ2
نهاية

دالة رقم طرح_حدود_2_م1(رقم ب1، رقم ب2)
    إرجاع ب1 - ب2
نهاية

دالة رقم طرح_حدود_2_م0(رقم ج1، رقم ج2)
    إرجاع ج1 - ج2
نهاية


#**
# جمع كثيرتي حدود من الدرجة 3
**#
دالة رقم جمع_حدود_3_م3(رقم أ1، رقم أ2)
    إرجاع أ1 + أ2
نهاية

دالة رقم جمع_حدود_3_م2(رقم ب1، رقم ب2)
    إرجاع ب1 + ب2
نهاية

دالة رقم جمع_حدود_3_م1(رقم ج1، رقم ج2)
    إرجاع ج1 + ج2
نهاية

دالة رقم جمع_حدود_3_م0(رقم د1، رقم د2)
    إرجاع د1 + د2
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 4: ضرب كثيرات الحدود                               ║
# ║          Section 4: Polynomial Multiplication                      ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# ضرب كثيرتي حدود:
# (أ₁×س + أ₀) × (ب₁×س + ب₀)
# = أ₁×ب₁×س² + (أ₁×ب₀ + أ₀×ب₁)×س + أ₀×ب₀
#
# القاعدة العامة: درجة الناتج = مجموع درجتي المضروبين
# ────────────────────────────────────────────────────────────────── **#


#**
# ضرب كثيرتي حدود من الدرجة 1:
# (أ1×س + ب1) × (أ2×س + ب2) = أ1×أ2×س² + (أ1×ب2+ب1×أ2)×س + ب1×ب2
**#

#**
# دالة: ضرب_1×1_م2
# الوصف: معامل س² في ناتج ضرب كثيرتي حدود من الدرجة 1
**#
دالة رقم ضرب_1×1_م2(رقم أ1، رقم أ2)
    إرجاع أ1 * أ2
نهاية

#**
# دالة: ضرب_1×1_م1
# الوصف: معامل س في ناتج الضرب
**#
دالة رقم ضرب_1×1_م1(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إرجاع أ1 * ب2 + ب1 * أ2
نهاية

#**
# دالة: ضرب_1×1_م0
# الوصف: الحد الثابت في ناتج الضرب
**#
دالة رقم ضرب_1×1_م0(رقم ب1، رقم ب2)
    إرجاع ب1 * ب2
نهاية


#**
# ضرب كثيرتي حدود: (أ1×س² + ب1×س + ج1) × (أ2×س + ب2)
# الناتج: درجة 3
**#

#** معامل س³ **#
دالة رقم ضرب_2×1_م3(رقم أ1، رقم أ2)
    إرجاع أ1 * أ2
نهاية

#** معامل س² **#
دالة رقم ضرب_2×1_م2(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إرجاع أ1 * ب2 + ب1 * أ2
نهاية

#** معامل س **#
دالة رقم ضرب_2×1_م1(رقم ب1، رقم ج1، رقم أ2، رقم ب2)
    إرجاع ب1 * ب2 + ج1 * أ2
نهاية

#** الحد الثابت **#
دالة رقم ضرب_2×1_م0(رقم ج1، رقم ب2)
    إرجاع ج1 * ب2
نهاية


#**
# ضرب كثيرتي حدود من الدرجة 2:
# (أ1×س² + ب1×س + ج1) × (أ2×س² + ب2×س + ج2)
# الناتج: درجة 4
#
# معامل س⁴ = أ1×أ2
# معامل س³ = أ1×ب2 + ب1×أ2
# معامل س² = أ1×ج2 + ب1×ب2 + ج1×أ2
# معامل س¹ = ب1×ج2 + ج1×ب2
# معامل س⁰ = ج1×ج2
**#

دالة رقم ضرب_2×2_م4(رقم أ1، رقم أ2)
    إرجاع أ1 * أ2
نهاية

دالة رقم ضرب_2×2_م3(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إرجاع أ1 * ب2 + ب1 * أ2
نهاية

دالة رقم ضرب_2×2_م2(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    إرجاع أ1 * ج2 + ب1 * ب2 + ج1 * أ2
نهاية

دالة رقم ضرب_2×2_م1(رقم ب1، رقم ج1، رقم ب2، رقم ج2)
    إرجاع ب1 * ج2 + ج1 * ب2
نهاية

دالة رقم ضرب_2×2_م0(رقم ج1، رقم ج2)
    إرجاع ج1 * ج2
نهاية


#**
# تربيع كثيرة حدود من الدرجة 2:
# (أ×س² + ب×س + ج)²
# = أ²×س⁴ + 2أب×س³ + (ب²+2أج)×س² + 2بج×س + ج²
**#
دالة رقم تربيع_2_م4(رقم أ)
    إرجاع أ * أ
نهاية

دالة رقم تربيع_2_م3(رقم أ، رقم ب)
    إرجاع 2 * أ * ب
نهاية

دالة رقم تربيع_2_م2(رقم أ، رقم ب، رقم ج)
    إرجاع ب * ب + 2 * أ * ج
نهاية

دالة رقم تربيع_2_م1(رقم ب، رقم ج)
    إرجاع 2 * ب * ج
نهاية

دالة رقم تربيع_2_م0(رقم ج)
    إرجاع ج * ج
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 5: القسمة التركيبية                                 ║
# ║          Section 5: Synthetic Division                             ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# القسمة التركيبية (Synthetic Division):
# طريقة مختصرة لقسمة كثيرة حدود على (س - ر)
# حيث ر هو جذر محتمل.
#
# إذا كانت ق(س) = أ×س³ + ب×س² + ج×س + د
# وقسمنا على (س - ر):
# ق(س) = (س - ر) × خ(س) + ق(ر)
# حيث خ(س) هي خارج القسمة وق(ر) هو الباقي
#
# نظرية الباقي: الباقي = ق(ر) (قيمة كثيرة الحدود عند ر)
# نظرية العامل: إذا كان ق(ر) = 0، فإن (س - ر) عامل لـ ق(س)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: قسمة_تركيبية_3_م2
# الوصف: معامل س² في خارج قسمة كثيرة حدود درجة 3 على (س - ر)
#         ق(س) = أ×س³ + ب×س² + ج×س + د ÷ (س - ر)
# المعاملات: أ (معامل س³)
# الإرجاع: أ (يبقى كما هو)
**#
دالة رقم قسمة_تركيبية_3_م2(رقم أ)
    إرجاع أ
نهاية

#**
# دالة: قسمة_تركيبية_3_م1
# الوصف: معامل س في خارج القسمة
# الإرجاع: ب + أ×ر
**#
دالة رقم قسمة_تركيبية_3_م1(رقم أ، رقم ب، رقم ر)
