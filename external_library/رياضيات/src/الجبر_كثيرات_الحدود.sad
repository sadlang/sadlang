# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 7: تكامل كثيرة الحدود                              ║
# ║          Section 7: Polynomial Integration                         ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# التكامل غير المحدد لكثيرة الحدود:
# ∫(أ×سⁿ)دس = أ×سⁿ⁺¹/(ن+1) + ث
#
# التكامل المحدد:
# ∫[أ→ب](ق(س))دس = ق_تكامل(ب) - ق_تكامل(أ)
#
# ملاحظة: بسبب استخدام الأعداد الصحيحة، نضرب النتيجة
# في عامل دقة أو نعيد البسط والمقام منفصلين
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: تكامل_محدد_حدود_2
# الوصف: حساب التكامل المحدد لكثيرة حدود من الدرجة 2
#         ∫[من→إلى](أ×س² + ب×س + ج)دس
#         = [أ×س³/3 + ب×س²/2 + ج×س] من "من" إلى "إلى"
# المعاملات: معاملات + حدود التكامل
# الإرجاع: القيمة × عامل_الدقة (لتقليل خطأ التقريب)
**#
دالة رقم تكامل_محدد_حدود_2(رقم أ، رقم ب، رقم ج، رقم من، رقم إلى)
    رقم عامل_دقة = 1000000
    
    # ق_تكامل(س) = أ×س³/3 + ب×س²/2 + ج×س
    # ق_تكامل(إلى) - ق_تكامل(من)
    
    # لتجنب القسمة المبكرة نضرب في 6 (المضاعف المشترك الأصغر لـ 2 و 3)
    # 6 × التكامل = 2أ×س³ + 3ب×س² + 6ج×س
    
    رقم حد_علوي3 = إلى * إلى * إلى
    رقم حد_علوي2 = إلى * إلى
    رقم حد_سفلي3 = من * من * من
    رقم حد_سفلي2 = من * من
    
    رقم قيمة_علوية = 2 * أ * حد_علوي3 + 3 * ب * حد_علوي2 + 6 * ج * إلى
    رقم قيمة_سفلية = 2 * أ * حد_سفلي3 + 3 * ب * حد_سفلي2 + 6 * ج * من
    
    رقم الفرق = قيمة_علوية - قيمة_سفلية
    
    # النتيجة = الفرق / 6 × عامل_الدقة
    إرجاع (الفرق * عامل_دقة) / 6
نهاية


#**
# دالة: تكامل_محدد_حدود_3
# الوصف: حساب التكامل المحدد لكثيرة حدود من الدرجة 3
#         ∫[من→إلى](أ×س³ + ب×س² + ج×س + د)دس
# الإرجاع: القيمة × عامل_الدقة
**#
دالة رقم تكامل_محدد_حدود_3(رقم أ، رقم ب، رقم ج، رقم د، رقم من، رقم إلى)
    رقم عامل_دقة = 1000000
    
    # نضرب في 12 (MCM لـ 4,3,2,1)
    # 12 × التكامل = 3أ×س⁴ + 4ب×س³ + 6ج×س² + 12د×س
    
    رقم ع4 = إلى * إلى * إلى * إلى
    رقم ع3 = إلى * إلى * إلى
    رقم ع2 = إلى * إلى
    رقم س4 = من * من * من * من
    رقم س3 = من * من * من
    رقم س2 = من * من
    
    رقم فوق = 3 * أ * ع4 + 4 * ب * ع3 + 6 * ج * ع2 + 12 * د * إلى
    رقم تحت = 3 * أ * س4 + 4 * ب * س3 + 6 * ج * س2 + 12 * د * من
    
    رقم الفرق = فوق - تحت
    إرجاع (الفرق * عامل_دقة) / 12
نهاية


#**
# دالة: تكامل_محدد_ثابت
# الوصف: تكامل محدد لثابت: ∫[أ→ب](ج)دس = ج×(ب-أ)
**#
دالة رقم تكامل_محدد_ثابت(رقم ج، رقم من، رقم إلى)
    إرجاع ج * (إلى - من)
نهاية


#**
# دالة: تكامل_محدد_خطي
# الوصف: ∫[من→إلى](أ×س + ب)دس = [أ×س²/2 + ب×س]
# الإرجاع: القيمة × عامل_الدقة
**#
دالة رقم تكامل_محدد_خطي(رقم أ، رقم ب، رقم من، رقم إلى)
    رقم عامل_دقة = 1000000
    
    # نضرب في 2: 2×التكامل = أ×س² + 2ب×س
    رقم فوق = أ * إلى * إلى + 2 * ب * إلى
    رقم تحت = أ * من * من + 2 * ب * من
    
    إرجاع ((فوق - تحت) * عامل_دقة) / 2
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 8: إيجاد جذور كثيرات الحدود بالطرق العددية        ║
# ║          Section 8: Root Finding (Numerical Methods)               ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# إيجاد الجذور (الأصفار) لكثيرات الحدود باستخدام:
# 1. طريقة نيوتن (Newton-Raphson)
# 2. طريقة التنصيف (Bisection)
# 3. حدود الجذور العقلانية
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: جذر_نيوتن_حدود_2
# الوصف: إيجاد جذر كثيرة حدود من الدرجة 2 بنيوتن
# المعاملات: المعاملات + تخمين أولي
# الإرجاع: الجذر × عامل_الدقة
**#
دالة رقم جذر_نيوتن_حدود_2(رقم أ، رقم ب، رقم ج، رقم تخمين)
    رقم عامل_دقة = 1000000
    رقم س = تخمين
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم ق = أ * س * س + ب * س + ج
        رقم مشتقة = 2 * أ * س + ب
        
        إذا (مشتقة == 0)
            س = س + 1
        وإلا
            رقم تصحيح = ق / مشتقة
            س = س - تصحيح
            إذا (تصحيح == 0)
                عداد = 50
            نهاية
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع س * عامل_دقة
نهاية


#**
# دالة: جذر_نيوتن_حدود_3
# الوصف: إيجاد جذر كثيرة حدود من الدرجة 3 بنيوتن
**#
دالة رقم جذر_نيوتن_حدود_3(رقم أ، رقم ب، رقم ج، رقم د، رقم تخمين)
    رقم عامل_دقة = 1000000
    رقم س = تخمين
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم ق = أ * س * س * س + ب * س * س + ج * س + د
        رقم مشتقة = 3 * أ * س * س + 2 * ب * س + ج
        
        إذا (مشتقة == 0)
            س = س + 1
        وإلا
            رقم تصحيح = ق / مشتقة
            س = س - تصحيح
            إذا (تصحيح == 0)
                عداد = 50
            نهاية
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع س * عامل_دقة
نهاية


#**
# دالة: جذر_نيوتن_حدود_4
# الوصف: إيجاد جذر كثيرة حدود من الدرجة 4 بنيوتن
**#
دالة رقم جذر_نيوتن_حدود_4(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم تخمين)
    رقم عامل_دقة = 1000000
    رقم س = تخمين
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم س2 = س * س
        رقم ق = أ * س2 * س2 + ب * س2 * س + ج * س2 + د * س + هـ
        رقم مشتقة = 4 * أ * س2 * س + 3 * ب * س2 + 2 * ج * س + د
        
        إذا (مشتقة == 0)
            س = س + 1
        وإلا
            رقم تصحيح = ق / مشتقة
            س = س - تصحيح
            إذا (تصحيح == 0)
                عداد = 50
            نهاية
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع س * عامل_دقة
نهاية


#**
# دالة: حد_أعلى_للجذور
# الوصف: حساب الحد الأعلى لقيم جذور كثيرة حدود
#         باستخدام حد كوشي: 1 + max(|أي|) / |أن|
#         حيث أن هو المعامل الرئيسي
# مفيد لتحديد مجال بحث جذور
**#
دالة رقم حد_أعلى_للجذور_3(رقم أ، رقم ب، رقم ج، رقم د)
    إذا (أ == 0)
        إرجاع 0 - 999999
    نهاية
    
    # إيجاد أكبر معامل بالقيمة المطلقة (غير الرئيسي)
    رقم ب_مطلق = ب
    إذا (ب_مطلق < 0)
        ب_مطلق = 0 - ب_مطلق
    نهاية
    رقم ج_مطلق = ج
    إذا (ج_مطلق < 0)
        ج_مطلق = 0 - ج_مطلق
    نهاية
    رقم د_مطلق = د
    إذا (د_مطلق < 0)
        د_مطلق = 0 - د_مطلق
    نهاية
    
    رقم أكبر = ب_مطلق
    إذا (ج_مطلق > أكبر)
        أكبر = ج_مطلق
    نهاية
    إذا (د_مطلق > أكبر)
        أكبر = د_مطلق
    نهاية
    
    رقم أ_مطلق = أ
    إذا (أ_مطلق < 0)
        أ_مطلق = 0 - أ_مطلق
    نهاية
    
    إرجاع 1 + أكبر / أ_مطلق
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 9: كثيرات حدود خاصة                                ║
# ║          Section 9: Special Polynomials                            ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# كثيرات الحدود الخاصة تظهر في العديد من التطبيقات:
#
# 1. كثيرات حدود تشيبيشيف (Chebyshev):
#    T₀(س) = 1
#    T₁(س) = س
#    T_{ن+1}(س) = 2×س×T_ن(س) - T_{ن-1}(س)
#
# 2. كثيرات حدود لاجيندر (Legendre):
#    P₀(س) = 1
#    P₁(س) = س
#    P_{ن+1}(س) = ((2ن+1)×س×P_ن(س) - ن×P_{ن-1}(س)) / (ن+1)
#
# 3. كثيرات حدود هيرميت (Hermite):
#    H₀(س) = 1
#    H₁(س) = 2س
#    H_{ن+1}(س) = 2×س×H_ن(س) - 2×ن×H_{ن-1}(س)
#
# 4. كثيرات حدود لاغير (Laguerre):
#    L₀(س) = 1
#    L₁(س) = 1 - س
#    L_{ن+1}(س) = ((2ن+1-س)×L_ن(س) - ن×L_{ن-1}(س)) / (ن+1)
# ────────────────────────────────────────────────────────────────── **#


#** كثيرات حدود تشيبيشيف **#

#**
# دالة: تشيبيشيف
# الوصف: حساب كثيرة حدود تشيبيشيف من النوع الأول T_ن(س)
# المعاملات: ن (الدرجة)، س (النقطة)
# الإرجاع: T_ن(س)
**#
دالة رقم تشيبيشيف(رقم ن، رقم س)
    إذا (ن == 0)
        إرجاع 1
    نهاية
    إذا (ن == 1)
        إرجاع س
    نهاية
    
    رقم سابق2 = 1
    رقم سابق1 = س
    رقم حالي = 0
    
    رقم ع = 2
    كرر طالما (ع <= ن)
        حالي = 2 * س * سابق1 - سابق2
        سابق2 = سابق1
        سابق1 = حالي
        ع = ع + 1
    نهاية
    
    إرجاع حالي
نهاية


#**
# دالة: تشيبيشيف_نوع2
# الوصف: كثيرة حدود تشيبيشيف من النوع الثاني U_ن(س)
#    U₀(س) = 1
#    U₁(س) = 2×س
#    U_{ن+1}(س) = 2×س×U_ن(س) - U_{ن-1}(س)
**#
دالة رقم تشيبيشيف_نوع2(رقم ن، رقم س)
    إذا (ن == 0)
        إرجاع 1
    نهاية
    إذا (ن == 1)
        إرجاع 2 * س
    نهاية
    
    رقم سابق2 = 1
    رقم سابق1 = 2 * س
    رقم حالي = 0
    
    رقم ع = 2
    كرر طالما (ع <= ن)
        حالي = 2 * س * سابق1 - سابق2
        سابق2 = سابق1
        سابق1 = حالي
        ع = ع + 1
    نهاية
    
    إرجاع حالي
نهاية


#** كثيرات حدود هيرميت **#

#**
# دالة: هيرميت
# الوصف: حساب كثيرة حدود هيرميت H_ن(س)
#     H₀ = 1، H₁ = 2س
#     H_{ن+1} = 2×س×H_ن - 2×ن×H_{ن-1}
# استخدامات: ميكانيكا الكم، نظرية الاحتمالات
**#
دالة رقم هيرميت(رقم ن، رقم س)
    إذا (ن == 0)
        إرجاع 1
    نهاية
    إذا (ن == 1)
        إرجاع 2 * س
    نهاية
    
    رقم سابق2 = 1
    رقم سابق1 = 2 * س
    رقم حالي = 0
    
    رقم ع = 2
    كرر طالما (ع <= ن)
        حالي = 2 * س * سابق1 - 2 * (ع - 1) * سابق2
        سابق2 = سابق1
        سابق1 = حالي
        ع = ع + 1
    نهاية
    
    إرجاع حالي
نهاية


#** كثيرات حدود بيرنشتاين **#

#**
# دالة: بيرنشتاين
# الوصف: حساب كثيرة حدود بيرنشتاين B_{ك،ن}(ت)
#         B_{ك،ن}(ت) = C(ن،ك) × ت^ك × (1-ت)^(ن-ك)
# استخدامات: منحنيات بيزيه، الرسوميات الحاسوبية
# المعاملات: ك، ن، ت (حيث 0 ≤ ت ≤ 1)
**#
دالة رقم بيرنشتاين(رقم ك، رقم ن، رقم ت)
    # حساب C(ن، ك)
    رقم توافيق = 1
    رقم ع = 0
    كرر طالما (ع < ك)
        توافيق = توافيق * (ن - ع) / (ع + 1)
        ع = ع + 1
    نهاية
    
    # حساب ت^ك
    رقم قوة_ت = 1
    ع = 0
    كرر طالما (ع < ك)
        قوة_ت = قوة_ت * ت
        ع = ع + 1
    نهاية
    
    # حساب (1-ت)^(ن-ك)
    رقم واحد_ناقص_ت = 1 - ت
    رقم قوة_مكمل = 1
    ع = 0
    كرر طالما (ع < ن - ك)
        قوة_مكمل = قوة_مكمل * واحد_ناقص_ت
        ع = ع + 1
    نهاية
    
    إرجاع توافيق * قوة_ت * قوة_مكمل
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 10: الاستيفاء (Interpolation)                      ║
# ║          Section 10: Polynomial Interpolation                      ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# الاستيفاء: إيجاد كثيرة حدود تمر بمجموعة من النقاط المعطاة.
#
# استيفاء لاغرانج (Lagrange Interpolation):
# إذا أعطينا ن+1 نقطة، يمكن إيجاد كثيرة حدود وحيدة
# من الدرجة ≤ ن تمر بها جميعاً.
#
# الصيغة:
# ق(س) = Σ(ي=0→ن) [ص_ي × ∏(ج=0→ن, ج≠ي) (س-س_ج)/(س_ي-س_ج)]
#
# يُستخدم في:
# - تقدير القيم بين نقاط البيانات
# - تقريب الدوال
# - الطرق العددية (التكامل العددي)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: استيفاء_خطي
# الوصف: استيفاء خطي بين نقطتين (س0، ص0) و (س1، ص1)
#         ق(س) = ص0 + (ص1 - ص0) × (س - س0) / (س1 - س0)
# المعاملات: النقطتان + قيمة س المطلوبة
# الإرجاع: قيمة ص × عامل_الدقة
**#
دالة رقم استيفاء_خطي(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س)
    رقم عامل_دقة = 1000000
    
    رقم فرق_س = س1 - س0
    إذا (فرق_س == 0)
        إرجاع ص0 * عامل_دقة
    نهاية
    
    إرجاع ص0 * عامل_دقة + ((ص1 - ص0) * (س - س0) * عامل_دقة) / فرق_س
نهاية


#**
# دالة: استيفاء_تربيعي
# الوصف: استيفاء تربيعي بثلاث نقاط (لاغرانج)
# المعاملات: ثلاث نقاط + قيمة س المطلوبة
# الإرجاع: قيمة ص × عامل_الدقة
**#
دالة رقم استيفاء_تربيعي(رقم س0، رقم ص0، رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س)
    رقم عامل_دقة = 1000000
    
    # حد لاغرانج الأول: L0 = (س-س1)(س-س2) / (س0-س1)(س0-س2)
    رقم بسط0 = (س - س1) * (س - س2)
    رقم مقام0 = (س0 - س1) * (س0 - س2)
    
    # حد لاغرانج الثاني: L1 = (س-س0)(س-س2) / (س1-س0)(س1-س2)
    رقم بسط1 = (س - س0) * (س - س2)
    رقم مقام1 = (س1 - س0) * (س1 - س2)
    
    # حد لاغرانج الثالث: L2 = (س-س0)(س-س1) / (س2-س0)(س2-س1)
    رقم بسط2 = (س - س0) * (س - س1)
    رقم مقام2 = (س2 - س0) * (س2 - س1)
    
    # ق(س) = ص0×L0 + ص1×L1 + ص2×L2
    رقم نتيجة = 0
    
    إذا (مقام0 != 0)
        نتيجة = نتيجة + (ص0 * بسط0 * عامل_دقة) / مقام0
    نهاية
    إذا (مقام1 != 0)
        نتيجة = نتيجة + (ص1 * بسط1 * عامل_دقة) / مقام1
    نهاية
    إذا (مقام2 != 0)
        نتيجة = نتيجة + (ص2 * بسط2 * عامل_دقة) / مقام2
    نهاية
    
    إرجاع نتيجة
نهاية


#**
# دالة: فرق_منتهي_أمامي
# الوصف: حساب الفرق المنتهي الأمامي من الدرجة الأولى
#         Δق = ق(س+هـ) - ق(س)
# المعاملات: قيمة الدالة عند نقطتين متتاليتين
# الإرجاع: الفرق
**#
دالة رقم فرق_منتهي_أمامي(رقم ق_س، رقم ق_س_هـ)
    إرجاع ق_س_هـ - ق_س
نهاية


#**
# دالة: فرق_منتهي_ثاني
# الوصف: الفرق المنتهي من الدرجة الثانية
#         Δ²ق = ق(س+2هـ) - 2ق(س+هـ) + ق(س)
**#
دالة رقم فرق_منتهي_ثاني(رقم ق0، رقم ق1، رقم ق2)
    إرجاع ق2 - 2 * ق1 + ق0
نهاية


#**
# دالة: فرق_منتهي_ثالث
# الوصف: الفرق المنتهي من الدرجة الثالثة
**#
دالة رقم فرق_منتهي_ثالث(رقم ق0، رقم ق1، رقم ق2، رقم ق3)
    إرجاع ق3 - 3 * ق2 + 3 * ق1 - ق0
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 11: تقريب تايلور                                    ║
# ║          Section 11: Taylor Approximation                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# متسلسلة تايلور:
# ق(س) ≈ ق(أ) + ق'(أ)×(س-أ) + ق''(أ)×(س-أ)²/2! + ...
#
# تقريب الأُس (e^س) حول أ = 0:
# e^س ≈ 1 + س + س²/2 + س³/6 + س⁴/24 + ...
#
# تقريب جيب (sin):
# sin(س) ≈ س - س³/6 + س⁵/120 - س⁷/5040 + ...
#
# تقريب جيب التمام (cos):
# cos(س) ≈ 1 - س²/2 + س⁴/24 - س⁶/720 + ...
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: تايلور_أس_حدود
# الوصف: تقريب e^س باستخدام ن حد من متسلسلة تايلور
#         e^س ≈ Σ(ك=0→ن) سᵏ/ك!
# المعاملات: س (القيمة)، ن (عدد الحدود)
# الإرجاع: التقريب × عامل_الدقة
**#
دالة رقم تايلور_أس(رقم س، رقم ن)
    رقم عامل_دقة = 1000000
    رقم مجموع = عامل_دقة
    رقم حد = عامل_دقة
    
    رقم ك = 1
    كرر طالما (ك <= ن)
        حد = حد * س / ك
        مجموع = مجموع + حد
        ك = ك + 1
    نهاية
    
    إرجاع مجموع
نهاية


#**
# دالة: تايلور_لن_1_زائد
# الوصف: تقريب ln(1+س) باستخدام متسلسلة تايلور
#         ln(1+س) ≈ س - س²/2 + س³/3 - س⁴/4 + ...
#         صالحة لـ |س| < 1
# المعاملات: س (القيمة)، ن (عدد الحدود)
# الإرجاع: التقريب × عامل_الدقة
**#
دالة رقم تايلور_لن_1_زائد(رقم س، رقم ن)
    رقم عامل_دقة = 1000000
    رقم مجموع = 0
    رقم قوة = س * عامل_دقة
    
    رقم ك = 1
    كرر طالما (ك <= ن)
        إذا (ك / 2 * 2 == ك)
            # حد زوجي: سالب
            مجموع = مجموع - قوة / ك
        وإلا
            # حد فردي: موجب
            مجموع = مجموع + قوة / ك
        نهاية
        قوة = قوة * س / عامل_دقة
        ك = ك + 1
    نهاية
    
    إرجاع مجموع
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 12: الاختبارات                                      ║
# ║          Section 12: Tests                                         ║
# ╚═══════════════════════════════════════════════════════════════════╝

#**
# دالة: اختبار_كثيرات_الحدود
# الوصف: تشغيل اختبارات شاملة لدوال كثيرات الحدود
# الإرجاع: عدد الاختبارات الفاشلة
**#
دالة رقم اختبار_كثيرات_الحدود()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار ملف كثيرات الحدود")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: تقييم كثيرة حدود من الدرجة 2
    # ق(س) = 2س² - 3س + 1 عند س = 4
    # = 32 - 12 + 1 = 21
    رقم ن1 = كثيرة_حدود_2(2، 0 - 3، 1، 4)
    إذا (ن1 == 21)
        نجاح = نجاح + 1
        اطبع_سطر("✓ كثيرة_حدود_2(2,-3,1,4) = 21")
    وإلا
        فشل = فشل + 1
        اطبع("✗ كثيرة_حدود_2(2,-3,1,4) = ")
        اطبع_سطر(ن1)
    نهاية
    
    # اختبار 2: هورنر
    رقم ن2 = هورنر_3(1، 0 - 6، 11، 0 - 6، 3)
    # (((1×3 - 6)×3 + 11)×3 - 6) = ((−3)×3+11)×3−6 = (2)×3−6 = 0
    إذا (ن2 == 0)
        نجاح = نجاح + 1
        اطبع_سطر("✓ هورنر(1,-6,11,-6,3) = 0")
    وإلا
        فشل = فشل + 1
        اطبع("✗ هورنر(1,-6,11,-6,3) = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: القسمة التركيبية - الباقي
    # ق(س) = س³ - 6س² + 11س - 6 ÷ (س - 1)
    # ق(1) = 1 - 6 + 11 - 6 = 0
    رقم ن3 = قسمة_تركيبية_3_باقي(1، 0 - 6، 11، 0 - 6، 1)
    إذا (ن3 == 0)
        نجاح = نجاح + 1
        اطبع_سطر("✓ باقي_القسمة(1,-6,11,-6, ÷(س-1)) = 0")
    وإلا
        فشل = فشل + 1
        اطبع("✗ باقي = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: هل 1 جذر لكثيرة الحدود
    رقم ن4 = هل_ر_جذر_لكثيرة_3(1، 0 - 6، 11، 0 - 6، 1)
    إذا (ن4 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 1 جذر لـ س³-6س²+11س-6")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل: 1 ليس جذراً!")
    نهاية
    
    # اختبار 5: المشتقة
    # ق(س) = 3س² + 2س + 1، ق'(2) = 12 + 2 = 14
    رقم ن5 = مشتقة_2_عند(3، 2، 2)
    إذا (ن5 == 14)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مشتقة(3س²+2س+1) عند 2 = 14")
    وإلا
        فشل = فشل + 1
        اطبع("✗ المشتقة = ")
        اطبع_سطر(ن5)
    نهاية
    
    # اختبار 6: تشيبيشيف T₂(س) = 2س² - 1
    # T₂(3) = 2×9 - 1 = 17
    رقم ن6 = تشيبيشيف(2، 3)
    إذا (ن6 == 17)
        نجاح = نجاح + 1
        اطبع_سطر("✓ T₂(3) = 17")
    وإلا
        فشل = فشل + 1
        اطبع("✗ T₂(3) = ")
        اطبع_سطر(ن6)
    نهاية
    
    # اختبار 7: هيرميت H₂(س) = 4س² - 2
    # H₂(3) = 36 - 2 = 34
    رقم ن7 = هيرميت(2، 3)
    إذا (ن7 == 34)
        نجاح = نجاح + 1
        اطبع_سطر("✓ H₂(3) = 34")
    وإلا
        فشل = فشل + 1
        اطبع("✗ H₂(3) = ")
        اطبع_سطر(ن7)
    نهاية
    
    # اختبار 8: ضرب كثيرتي حدود
    # (2س + 3)(4س + 5) = 8س² + 22س + 15
    رقم م2 = ضرب_1×1_م2(2، 4)
    رقم م1 = ضرب_1×1_م1(2، 3، 4، 5)
    رقم م0 = ضرب_1×1_م0(3، 5)
    إذا (م2 == 8)
        إذا (م1 == 22)
            إذا (م0 == 15)
                نجاح = نجاح + 1
                اطبع_سطر("✓ (2س+3)(4س+5) = 8س²+22س+15")
            وإلا
                فشل = فشل + 1
                اطبع_سطر("✗ فشل ضرب الحدود")
            نهاية
        وإلا
            فشل = فشل + 1
            اطبع_سطر("✗ فشل ضرب الحدود")
        نهاية
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل ضرب الحدود")
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


