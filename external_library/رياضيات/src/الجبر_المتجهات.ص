دالة رقم اختبار_المتجهات()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار ملف المتجهات")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: الضرب النقطي 2D
    # (3، 4) · (1، 2) = 3 + 8 = 11
    رقم ن1 = نقطي_مت2(3، 4، 1، 2)
    إذا (ن1 == 11)
        نجاح = نجاح + 1
        اطبع_سطر("✓ (3,4)·(1,2) = 11")
    وإلا
        فشل = فشل + 1
        اطبع("✗ (3,4)·(1,2) = ")
        اطبع_سطر(ن1)
    نهاية
    
    # اختبار 2: الطول المربع
    # |(3، 4)|² = 9 + 16 = 25
    رقم ن2 = طول_مت2_مربع(3، 4)
    إذا (ن2 == 25)
        نجاح = نجاح + 1
        اطبع_سطر("✓ |(3,4)|² = 25")
    وإلا
        فشل = فشل + 1
        اطبع("✗ |(3,4)|² = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: تعامد
    # (1، 0) ⊥ (0، 1)
    رقم ن3 = هل_مت2_متعامدان(1، 0، 0، 1)
    إذا (ن3 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ (1,0)⊥(0,1)")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل اختبار التعامد")
    نهاية
    
    # اختبار 4: الضرب النقطي 3D
    # (1، 2، 3) · (4، 5، 6) = 4+10+18 = 32
    رقم ن4 = نقطي_مت3(1، 2، 3، 4، 5، 6)
    إذا (ن4 == 32)
        نجاح = نجاح + 1
        اطبع_سطر("✓ (1,2,3)·(4,5,6) = 32")
    وإلا
        فشل = فشل + 1
        اطبع("✗ نقطي = ")
        اطبع_سطر(ن4)
    نهاية
    
    # اختبار 5: الضرب الاتجاهي
    # (1، 0، 0) × (0، 1، 0) = (0، 0، 1)
    رقم ن5_س = اتجاهي_مت3_س(0، 0، 1، 0)
    رقم ن5_ص = اتجاهي_مت3_ص(1، 0، 0، 0)
    رقم ن5_ع = اتجاهي_مت3_ع(1، 0، 0، 1)
    إذا (ن5_س == 0)
        إذا (ن5_ص == 0)
            إذا (ن5_ع == 1)
                نجاح = نجاح + 1
                اطبع_سطر("✓ î×ĵ = k̂")
            وإلا
                فشل = فشل + 1
                اطبع_سطر("✗ فشل الضرب الاتجاهي")
            نهاية
        وإلا
            فشل = فشل + 1
            اطبع_سطر("✗ فشل الضرب الاتجاهي")
        نهاية
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل الضرب الاتجاهي")
    نهاية
    
    # اختبار 6: ضرب كواترنيونين
    # (1، 0، 0، 0) × (1، 0، 0، 0) = (1، 0، 0، 0)
    رقم ن6 = ضرب_كو_و(1، 0، 0، 0، 1، 0، 0، 0)
    إذا (ن6 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 1×1 = 1 (كواترنيون)")
    وإلا
        فشل = فشل + 1
        اطبع("✗ ضرب كواترنيون = ")
        اطبع_سطر(ن6)
    نهاية
    
    # اختبار 7: مساحة مثلث
    # (0، 0)، (4، 0)، (0، 3) → مساحة = 6
    رقم ن7 = مساحة_مثلث_2ضعف(0، 0، 4، 0، 0، 3)
    إذا (ن7 == 12)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مساحة مثلث (0,0)(4,0)(0,3) = 6 (×2=12)")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مساحة×2 = ")
        اطبع_سطر(ن7)
