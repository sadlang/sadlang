دالة رقم جمع_مت2_س(رقم س1، رقم س2)
    إرجاع س1 + س2
نهاية

دالة رقم جمع_مت2_ص(رقم ص1، رقم ص2)
    إرجاع ص1 + ص2
نهاية

#** طرح متجهين ثنائيين **#
