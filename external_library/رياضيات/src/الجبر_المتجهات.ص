#**
# دالة: نقطي_مت3
# الوصف: الضرب النقطي لمتجهين ثلاثيين
#         أ · ب = أ₁ب₁ + أ₂ب₂ + أ₃ب₃
**#
دالة رقم نقطي_مت3(رقم س1، رقم ص1، رقم ع1، رقم س2، رقم ص2، رقم ع2)
    إرجاع س1 * س2 + ص1 * ص2 + ع1 * ع2
نهاية


#**
# دالة: اتجاهي_مت3_س
# الوصف: المركبة السينية للضرب الاتجاهي
#         (أ × ب)_س = أ_ص×ب_ع - أ_ع×ب_ص
**#
دالة رقم اتجاهي_مت3_س(رقم ص1، رقم ع1، رقم ص2، رقم ع2)
    إرجاع ص1 * ع2 - ع1 * ص2
نهاية

#**
# دالة: اتجاهي_مت3_ص
# الوصف: (أ × ب)_ص = أ_ع×ب_س - أ_س×ب_ع
**#
دالة رقم اتجاهي_مت3_ص(رقم س1، رقم ع1، رقم س2، رقم ع2)
    إرجاع ع1 * س2 - س1 * ع2
نهاية

#**
# دالة: اتجاهي_مت3_ع
# الوصف: (أ × ب)_ع = أ_س×ب_ص - أ_ص×ب_س
**#
دالة رقم اتجاهي_مت3_ع(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إرجاع س1 * ص2 - ص1 * س2
نهاية


#**
# دالة: طول_مت3_مربع
# الوصف: |v|² = س² + ص² + ع²
**#
دالة رقم طول_مت3_مربع(رقم س، رقم ص، رقم ع)
    إرجاع س * س + ص * ص + ع * ع
نهاية


#**
# دالة: طول_مت3
# الوصف: طول المتجه الثلاثي (× عامل_دقة)
**#
دالة رقم طول_مت3(رقم س، رقم ص، رقم ع)
    رقم عامل_دقة = 1000000
    رقم مربع = س * س + ص * ص + ع * ع
    
    إذا (مربع == 0)
        إرجاع 0
    نهاية
    
    رقم تخمين = مربع / 2
    إذا (تخمين == 0)
        تخمين = 1
    نهاية
    
    رقم عداد = 0
    كرر طالما (عداد < 30)
        تخمين = (تخمين + مربع / تخمين) / 2
        عداد = عداد + 1
    نهاية
    
    إرجاع تخمين * عامل_دقة
نهاية


#**
# دالة: مسافة_مت3
# الوصف: المسافة بين نقطتين في 3D
**#
دالة رقم مسافة_مت3(رقم س1، رقم ص1، رقم ع1، رقم س2، رقم ص2، رقم ع2)
    إرجاع طول_مت3(س2 - س1، ص2 - ص1، ع2 - ع1)
نهاية


#**
# دالة: هل_مت3_متعامدان
# الوصف: هل متجهان ثلاثيان متعامدان
**#
دالة رقم هل_مت3_متعامدان(رقم س1، رقم ص1، رقم ع1، رقم س2، رقم ص2، رقم ع2)
    إذا (نقطي_مت3(س1، ص1، ع1، س2، ص2، ع2) == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: حاصل_ضرب_ثلاثي
# الوصف: الضرب الثلاثي (Scalar Triple Product)
#         أ · (ب × ج) = محدد المصفوفة المكونة من المتجهات الثلاثة
# يُستخدم لحساب حجم متوازي السطوح
**#
دالة رقم ضرب_ثلاثي(رقم أ_س، رقم أ_ص، رقم أ_ع، رقم ب_س، رقم ب_ص، رقم ب_ع، رقم ج_س، رقم ج_ص، رقم ج_ع)
    # أ · (ب × ج)
    رقم اتجاهي_س = اتجاهي_مت3_س(ب_ص، ب_ع، ج_ص، ج_ع)
    رقم اتجاهي_ص = اتجاهي_مت3_ص(ب_س، ب_ع، ج_س، ج_ع)
    رقم اتجاهي_ع = اتجاهي_مت3_ع(ب_س، ب_ص، ج_س، ج_ص)
    
    إرجاع أ_س * اتجاهي_س + أ_ص * اتجاهي_ص + أ_ع * اتجاهي_ع
نهاية


#**
# دالة: هل_متجهات_مستوية
# الوصف: هل ثلاثة متجهات في نفس المستوى (الضرب الثلاثي = 0)
**#
دالة رقم هل_متجهات_مستوية(رقم أ_س، رقم أ_ص، رقم أ_ع، رقم ب_س، رقم ب_ص، رقم ب_ع، رقم ج_س، رقم ج_ص، رقم ج_ع)
    رقم ثلاثي = ضرب_ثلاثي(أ_س، أ_ص، أ_ع، ب_س، ب_ص، ب_ع، ج_س، ج_ص، ج_ع)
    إذا (ثلاثي == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: مساحة_متوازي_أضلاع
# الوصف: مساحة متوازي الأضلاع المكون من متجهين
#         = |أ × ب| (طول الضرب الاتجاهي)
# الإرجاع: المساحة² (مربع المساحة لتجنب الجذر)
**#
دالة رقم مساحة_متوازي_أضلاع_مربع(رقم س1، رقم ص1، رقم ع1، رقم س2، رقم ص2، رقم ع2)
    رقم اس = اتجاهي_مت3_س(ص1، ع1، ص2، ع2)
    رقم اص = اتجاهي_مت3_ص(س1، ع1، س2، ع2)
    رقم اع = اتجاهي_مت3_ع(س1، ص1، س2، ص2)
    إرجاع اس * اس + اص * اص + اع * اع
نهاية


#**
# دالة: حجم_متوازي_سطوح
# الوصف: حجم متوازي السطوح = |أ · (ب × ج)|
**#
دالة رقم حجم_متوازي_سطوح(رقم أ_س، رقم أ_ص، رقم أ_ع، رقم ب_س، رقم ب_ص، رقم ب_ع، رقم ج_س، رقم ج_ص، رقم ج_ع)
    رقم الحجم = ضرب_ثلاثي(أ_س، أ_ص، أ_ع، ب_س، ب_ص، ب_ع، ج_س، ج_ص، ج_ع)
    إذا (الحجم < 0)
        إرجاع 0 - الحجم
    نهاية
    إرجاع الحجم
نهاية


