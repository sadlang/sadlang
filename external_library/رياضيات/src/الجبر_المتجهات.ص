    إرجاع س1 - س2
نهاية

دالة رقم طرح_مت2_ص(رقم ص1، رقم ص2)
    إرجاع ص1 - ص2
نهاية

#** ضرب متجه في عدد **#
دالة رقم ضرب_مت2_عدد_س(رقم س، رقم ك)
    إرجاع س * ك
نهاية

دالة رقم ضرب_مت2_عدد_ص(رقم ص، رقم ك)
    إرجاع ص * ك
نهاية


#**
# دالة: نقطي_مت2
# الوصف: الضرب النقطي لمتجهين ثنائيين
#         أ · ب = أ₁×ب₁ + أ₂×ب₂
# خصائص:
#   - إذا كان = 0: المتجهان متعامدان
#   - إذا كان > 0: الزاوية بينهما حادة
#   - إذا كان < 0: الزاوية بينهما منفرجة
**#
دالة رقم نقطي_مت2(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إرجاع س1 * س2 + ص1 * ص2
نهاية


#**
# دالة: طول_مت2_مربع
# الوصف: مربع طول المتجه الثنائي |v|² = س² + ص²
#         نُرجع المربع لتجنب حساب الجذر
**#
دالة رقم طول_مت2_مربع(رقم س، رقم ص)
    إرجاع س * س + ص * ص
نهاية


#**
# دالة: طول_مت2
# الوصف: طول المتجه الثنائي بطريقة نيوتن (× عامل_دقة)
**#
دالة رقم طول_مت2(رقم س، رقم ص)
    رقم عامل_دقة = 1000000
    رقم مربع = س * س + ص * ص
    
    إذا (مربع == 0)
        إرجاع 0
    نهاية
    
    # جذر نيوتن
    رقم تخمين = مربع / 2
    إذا (تخمين == 0)
        تخمين = 1
    نهاية
    
    رقم ع = 0
    كرر طالما (ع < 30)
        تخمين = (تخمين + مربع / تخمين) / 2
        ع = ع + 1
    نهاية
    
    إرجاع تخمين * عامل_دقة
نهاية


#**
# دالة: مسافة_مت2
# الوصف: المسافة بين نقطتين في 2D
#         |AB| = √((س2-س1)² + (ص2-ص1)²)
# الإرجاع: المسافة × عامل_دقة
**#
دالة رقم مسافة_مت2(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم فرق_س = س2 - س1
    رقم فرق_ص = ص2 - ص1
    إرجاع طول_مت2(فرق_س، فرق_ص)
نهاية


#**
# دالة: هل_مت2_متعامدان
# الوصف: هل متجهان ثنائيان متعامدان (الضرب النقطي = 0)
**#
دالة رقم هل_مت2_متعامدان(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إذا (نقطي_مت2(س1، ص1، س2، ص2) == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_مت2_متوازيان
# الوصف: هل متجهان متوازيان
#         متوازيان إذا: س1×ص2 = س2×ص1
**#
دالة رقم هل_مت2_متوازيان(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إذا (س1 * ص2 == س2 * ص1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: ضرب_اتجاهي_مت2
# الوصف: "الضرب الاتجاهي" في 2D (يُرجع عدداً - المركبة ع)
#         أ × ب = أ₁×ب₂ - أ₂×ب₁
# يمثل مساحة متوازي الأضلاع المكون من المتجهين
# ويحدد اتجاه الدوران:
#   > 0: دوران عكس عقارب الساعة
#   < 0: دوران مع عقارب الساعة
#   = 0: المتجهان متوازيان
**#
دالة رقم ضرب_اتجاهي_مت2(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إرجاع س1 * ص2 - ص1 * س2
نهاية


#**
# دالة: نقطة_وسط_مت2_س
# الوصف: نقطة المنتصف بين نقطتين - المركبة السينية
**#
دالة رقم نقطة_وسط_مت2_س(رقم س1، رقم س2)
    إرجاع (س1 + س2) / 2
نهاية

دالة رقم نقطة_وسط_مت2_ص(رقم ص1، رقم ص2)
    إرجاع (ص1 + ص2) / 2
نهاية


#**
# دالة: إسقاط_مت2
# الوصف: إسقاط المتجه أ على المتجه ب (Scalar Projection)
#         proj = (أ · ب) / |ب|²
# الإرجاع: معامل الإسقاط × عامل_دقة
**#
دالة رقم إسقاط_مت2_معامل(رقم أ_س، رقم أ_ص، رقم ب_س، رقم ب_ص)
    رقم عامل_دقة = 1000000
    رقم نقطي = نقطي_مت2(أ_س، أ_ص، ب_س، ب_ص)
    رقم طول_مربع = طول_مت2_مربع(ب_س، ب_ص)
    
    إذا (طول_مربع == 0)
        إرجاع 0
    نهاية
    
    إرجاع (نقطي * عامل_دقة) / طول_مربع
نهاية


#**
# دالة: متجه_عمودي_مت2_س / _ص
