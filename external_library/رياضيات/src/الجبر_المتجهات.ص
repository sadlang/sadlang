#** ─────────────────────────────────────────────────────────────────
# الكواترنيون (الرباعي) هو تعميم للأعداد المركبة إلى 4 أبعاد:
# ق = و + س×ع + ص×ج + ع×ك
# حيث ع² = ج² = ك² = عجك = -1
#
# يُستخدم بكثرة في:
# - تمثيل الدوران في 3D (بديل لزوايا أويلر)
# - الرسوميات الحاسوبية والألعاب
# - الملاحة بالقصور الذاتي
# - الروبوتيات
#
# مميزاته على مصفوفات الدوران:
# - لا يعاني من "قفل المحور" (Gimbal Lock)
# - تمثيل أكثر كفاءة (4 أرقام بدلاً من 9)
# - الاستيفاء سلس (SLERP)
# ────────────────────────────────────────────────────────────────── **#


#** جمع كواترنيونين **#
دالة رقم جمع_كو_و(رقم و1، رقم و2)
    إرجاع و1 + و2
نهاية

دالة رقم جمع_كو_س(رقم س1، رقم س2)
    إرجاع س1 + س2
نهاية

دالة رقم جمع_كو_ص(رقم ص1، رقم ص2)
    إرجاع ص1 + ص2
نهاية

دالة رقم جمع_كو_ع(رقم ع1، رقم ع2)
    إرجاع ع1 + ع2
نهاية


#**
# ضرب كواترنيونين (غير تبديلي!)
# ق1 × ق2 = (و1و2 - س1س2 - ص1ص2 - ع1ع2)
#           + (و1س2 + س1و2 + ص1ع2 - ع1ص2)ع
#           + (و1ص2 - س1ع2 + ص1و2 + ع1س2)ج
#           + (و1ع2 + س1ص2 - ص1س2 + ع1و2)ك
**#
دالة رقم ضرب_كو_و(رقم و1، رقم س1، رقم ص1، رقم ع1، رقم و2، رقم س2، رقم ص2، رقم ع2)
    إرجاع و1 * و2 - س1 * س2 - ص1 * ص2 - ع1 * ع2
نهاية

دالة رقم ضرب_كو_س(رقم و1، رقم س1، رقم ص1، رقم ع1، رقم و2، رقم س2، رقم ص2، رقم ع2)
    إرجاع و1 * س2 + س1 * و2 + ص1 * ع2 - ع1 * ص2
نهاية

دالة رقم ضرب_كو_ص(رقم و1، رقم س1، رقم ص1، رقم ع1، رقم و2، رقم س2، رقم ص2، رقم ع2)
    إرجاع و1 * ص2 - س1 * ع2 + ص1 * و2 + ع1 * س2
نهاية

دالة رقم ضرب_كو_ع(رقم و1، رقم س1، رقم ص1، رقم ع1، رقم و2، رقم س2، رقم ص2، رقم ع2)
    إرجاع و1 * ع2 + س1 * ص2 - ص1 * س2 + ع1 * و2
نهاية


#**
# دالة: نورم_كو
# الوصف: نورم (طول) الكواترنيون
#         |ق|² = و² + س² + ص² + ع²
**#
دالة رقم نورم_كو_مربع(رقم و، رقم س، رقم ص، رقم ع)
    إرجاع و * و + س * س + ص * ص + ع * ع
نهاية


#**
# دالة: مرافق_كواترنيون
# الوصف: المرافق (Conjugate) ق* = و - س×ع - ص×ج - ع×ك
**#
دالة رقم مرافق_كو_و(رقم و)
    إرجاع و
نهاية

دالة رقم مرافق_كو_س(رقم س)
    إرجاع 0 - س
نهاية

دالة رقم مرافق_كو_ص(رقم ص)
    إرجاع 0 - ص
نهاية

دالة رقم مرافق_كو_ع(رقم ع)
    إرجاع 0 - ع
نهاية


