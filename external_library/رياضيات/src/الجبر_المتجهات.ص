#**
# دالة: مسافة_نقطة_عن_مستوى
# الوصف: المسافة من نقطة إلى مستوى في 3D
#         |أ×س0 + ب×ص0 + ج×ع0 + د| / √(أ²+ب²+ج²)
# الإرجاع: البسط فقط (القيمة المطلقة)
**#
دالة رقم مسافة_نقطة_مستوى_بسط(رقم أ، رقم ب، رقم ج، رقم د، رقم س0، رقم ص0، رقم ع0)
    رقم القيمة = أ * س0 + ب * ص0 + ج * ع0 + د
    إذا (القيمة < 0)
        إرجاع 0 - القيمة
    نهاية
    إرجاع القيمة
نهاية


#**
# دالة: هل_نقطة_على_مستوى
# الوصف: هل نقطة تقع على المستوى
**#
دالة رقم هل_نقطة_على_مستوى(رقم أ، رقم ب، رقم ج، رقم د، رقم س0، رقم ص0، رقم ع0)
    إذا (أ * س0 + ب * ص0 + ج * ع0 + د == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: معادلة_مستوى_من_نقطة_وعمود
# الوصف: معادلة المستوى المار بنقطة (س0، ص0، ع0)
#         والعمودي على المتجه (أ، ب، ج)
#         أ(س-س0) + ب(ص-ص0) + ج(ع-ع0) = 0
#         أي: أ×س + ب×ص + ج×ع + د = 0
# يحسب قيمة د
**#
دالة رقم مستوى_حساب_د(رقم أ، رقم ب، رقم ج، رقم س0، رقم ص0، رقم ع0)
    إرجاع 0 - (أ * س0 + ب * ص0 + ج * ع0)
نهاية


