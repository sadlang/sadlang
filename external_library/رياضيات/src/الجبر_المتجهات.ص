#**
# دالة: مساحة_مثلث_متجهات
# الوصف: مساحة المثلث المكون من ثلاث نقاط في 2D
#         = ½|أب × أج| = ½|(ب-أ) × (ج-أ)|
#         = ½|س1(ص2-ص3) + س2(ص3-ص1) + س3(ص1-ص2)|
# الإرجاع: مساحة × 2 (لتجنب القسمة)
**#
دالة رقم مساحة_مثلث_2ضعف(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    رقم المساحة = س1 * (ص2 - ص3) + س2 * (ص3 - ص1) + س3 * (ص1 - ص2)
    إذا (المساحة < 0)
        إرجاع 0 - المساحة
    نهاية
    إرجاع المساحة
نهاية


#**
# دالة: هل_نقاط_على_استقامة
# الوصف: هل ثلاث نقاط على خط مستقيم واحد في 2D
#         (المساحة = 0)
**#
دالة رقم هل_نقاط_على_استقامة(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم س3، رقم ص3)
    رقم المساحة = مساحة_مثلث_2ضعف(س1، ص1، س2، ص2، س3، ص3)
    إذا (المساحة == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: مساحة_مضلع_منتظم
# الوصف: مساحة مضلع منتظم بعدد أضلاع ن وطول ضلع جـ
#         تقريبية باستخدام: المساحة ≈ ن × جـ² / (4 × tan(π/ن))
#         لكن بسبب عدم وجود tan، نستخدم تقريبات خاصة
**#
دالة رقم مساحة_مثلث_متساوي(رقم الضلع)
    # مساحة × 1000000 (تقريب √3/4 ≈ 433013/1000000)
    إرجاع 433013 * الضلع * الضلع / 1000000
نهاية

دالة رقم مساحة_مربع(رقم الضلع)
    إرجاع الضلع * الضلع
نهاية

دالة رقم مساحة_سداسي_منتظم(رقم الضلع)
    # 6 × مساحة مثلث متساوي = 6 × √3/4 × a² = 3√3/2 × a²
    # ≈ 2598076 / 1000000 × a²
    إرجاع 2598076 * الضلع * الضلع / 1000000
نهاية


