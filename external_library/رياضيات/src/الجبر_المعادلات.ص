#** ─────────────────────────────────────────────────────────────────
# المعادلة التربيعية هي معادلة من الدرجة الثانية بالصيغة:
#     أ × س² + ب × س + ج = 0
#
# القانون العام (صيغة الحل):
#     س = (-ب ± √(ب² - 4×أ×ج)) / (2×أ)
#
# المميز (Discriminant):
#     Δ = ب² - 4 × أ × ج
#     - إذا Δ > 0: يوجد جذران حقيقيان مختلفان
#     - إذا Δ = 0: يوجد جذر حقيقي مكرر
#     - إذا Δ < 0: لا يوجد جذور حقيقية (جذور مركبة)
#
# العلاقة بين الجذور والمعاملات (علاقات فييتا):
#     مجموع الجذرين: س1 + س2 = -ب/أ
#     حاصل ضرب الجذرين: س1 × س2 = ج/أ
#
# التاريخ:
# - عرف البابليون طرق حل المعادلات التربيعية (2000 ق.م)
# - الخوارزمي (780-850م) وضع القانون العام في كتابه
#   "الكتاب المختصر في حساب الجبر والمقابلة"
# - يُعتبر الخوارزمي أب علم الجبر
# ────────────────────────────────────────────────────────────────── **#


# ═══════════════════════════════════════════════════════════════
# §2.1 - حساب المميز (Discriminant)
# ═══════════════════════════════════════════════════════════════

#**
# دالة: مميز_تربيعية
# الوصف: حساب مميز المعادلة التربيعية (Δ = ب² - 4×أ×ج)
# المعاملات:
#   - أ: معامل الحد التربيعي
#   - ب: معامل الحد الخطي
#   - ج: الحد الثابت
# الإرجاع: قيمة المميز
# أمثلة:
#   مميز_تربيعية(1، -5، 6) = 1    (جذران مختلفان: 2 و 3)
#   مميز_تربيعية(1، -4، 4) = 0    (جذر مكرر: 2)
#   مميز_تربيعية(1، 1، 1) = -3    (لا جذور حقيقية)
**#
دالة رقم مميز_تربيعية(رقم أ، رقم ب، رقم ج)
    إرجاع ب * ب - 4 * أ * ج
نهاية


#**
# دالة: عدد_جذور_تربيعية
# الوصف: تحديد عدد الجذور الحقيقية للمعادلة التربيعية
# الإرجاع:
#   2: جذران حقيقيان مختلفان
#   1: جذر حقيقي مكرر
#   0: لا جذور حقيقية
#  -1: المعادلة ليست تربيعية (أ = 0)
**#
دالة رقم عدد_جذور_تربيعية(رقم أ، رقم ب، رقم ج)
    إذا (أ == 0)
        إرجاع 0 - 1
    نهاية
    
