#**
# دالة: جذر_رابعة_نيوتن
# الوصف: إيجاد جذر معادلة من الدرجة الرابعة بطريقة نيوتن
# المعاملات: معاملات المعادلة + تخمين أولي
# الإرجاع: الجذر × عامل_الدقة
**#
دالة رقم جذر_رابعة_نيوتن(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم تخمين)
    رقم عامل_دقة = 1000000
    رقم س = تخمين
    
    رقم عداد = 0
    كرر طالما (عداد < 100)
        رقم ق = قيمة_دالة_رابعة(أ، ب، ج، د، هـ، س)
        رقم ق_مشتقة = مشتقة_رابعة(أ، ب، ج، د، س)
        
        إذا (ق_مشتقة == 0)
            س = س + 1
        وإلا
            رقم تصحيح = ق / ق_مشتقة
            س = س - تصحيح
            إذا (تصحيح == 0)
                عداد = 100
            نهاية
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع س * عامل_دقة
نهاية


#**
# دالة: جذر_رابعة_تنصيف
# الوصف: إيجاد جذر معادلة من الدرجة الرابعة بطريقة التنصيف
# الإرجاع: الجذر × عامل_الدقة
**#
دالة رقم جذر_رابعة_تنصيف(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ)
    رقم عامل_دقة = 1000000
    رقم يسار = 0 - 100
    رقم يمين = 100
    
    رقم ق_يسار = قيمة_دالة_رابعة(أ، ب، ج، د، هـ، يسار)
    
    رقم عداد = 0
    كرر طالما (عداد < 60)
        رقم وسط = (يسار + يمين) / 2
        رقم ق_وسط = قيمة_دالة_رابعة(أ، ب، ج، د، هـ، وسط)
        
        إذا (ق_وسط == 0)
            إرجاع وسط * عامل_دقة
        نهاية
        
        إذا (ق_يسار * ق_وسط < 0)
            يمين = وسط
        وإلا
            يسار = وسط
            ق_يسار = ق_وسط
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع ((يسار + يمين) / 2) * عامل_دقة
نهاية


