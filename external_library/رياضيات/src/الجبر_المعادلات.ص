#** ─────────────────────────────────────────────────────────────────
# المعادلة الخطية هي معادلة من الدرجة الأولى بالصيغة:
#     أ × س + ب = 0
# حيث الحل هو: س = -ب / أ (بشرط أ ≠ 0)
#
# المعادلة الخطية تمثل خطاً مستقيماً في المستوى الديكارتي.
# إذا كان أ = 0 وب = 0، فالمعادلة لها عدد لا نهائي من الحلول.
# إذا كان أ = 0 وب ≠ 0، فالمعادلة ليس لها حل (تناقض).
#
# تطبيقات المعادلات الخطية:
# - حساب السرعة والمسافة والزمن
# - حساب التكلفة والربح
# - تحويل الوحدات
# - النماذج الاقتصادية البسيطة
# ────────────────────────────────────────────────────────────────── **#


# ═══════════════════════════════════════════════════════════════
# §1.1 - حل المعادلة الخطية البسيطة
# ═══════════════════════════════════════════════════════════════

#**
# دالة: حل_خطية
# الوصف: حل المعادلة الخطية أ × س + ب = 0
#         الحل: س = -ب / أ
# المعاملات:
#   - أ: معامل المتغير (يجب ألا يكون صفراً)
#   - ب: الحد الثابت
# الإرجاع: قيمة س × عامل_الدقة (للحفاظ على الأرقام العشرية)
#           أو -999999 إذا لم يكن للمعادلة حل
# الدقة: 6 أرقام عشرية (القيمة مضروبة في 1,000,000)
#
# أمثلة:
#   حل_خطية(2، -6) = 3000000  (أي س = 3.0)
#   حل_خطية(3، 9) = -3000000  (أي س = -3.0)
#   حل_خطية(4، -10) = 2500000 (أي س = 2.5)
#   حل_خطية(0، 5) = -999999   (لا حل)
**#
دالة رقم حل_خطية(رقم أ، رقم ب)
    رقم عامل_دقة = 1000000
    
    # التحقق من أن المعامل ليس صفراً
    إذا (أ == 0)
        # إذا كان أ = 0، لا يمكن حل المعادلة
        إرجاع 0 - 999999
    نهاية
    
    # الحل: س = -ب / أ
    # نضرب في عامل الدقة أولاً ثم نقسم
    رقم البسط = (0 - ب) * عامل_دقة
    رقم النتيجة = البسط / أ
    
    إرجاع النتيجة
نهاية


#**
# دالة: حل_خطية_صحيح
# الوصف: حل المعادلة الخطية وإرجاع الجزء الصحيح فقط
# المعاملات:
#   - أ: معامل المتغير
#   - ب: الحد الثابت
# الإرجاع: الجزء الصحيح من الحل
# مثال: حل_خطية_صحيح(2، -6) = 3
**#
دالة رقم حل_خطية_صحيح(رقم أ، رقم ب)
    إذا (أ == 0)
        إرجاع 0 - 999999
    نهاية
    إرجاع (0 - ب) / أ
نهاية


#**
# دالة: حل_خطية_باقي
# الوصف: إرجاع باقي قسمة حل المعادلة الخطية
#         مفيد لمعرفة إذا كان الحل صحيحاً أم كسرياً
# المعاملات:
#   - أ: معامل المتغير
#   - ب: الحد الثابت
# الإرجاع: باقي القسمة (0 يعني الحل عدد صحيح)
**#
دالة رقم حل_خطية_باقي(رقم أ، رقم ب)
    إذا (أ == 0)
        إرجاع 0 - 1
    نهاية
    رقم سالب_ب = 0 - ب
    # حساب الباقي
    رقم حاصل_قسمة = سالب_ب / أ
    رقم الباقي = سالب_ب - (حاصل_قسمة * أ)
    إرجاع الباقي
نهاية


#**
# دالة: هل_حل_صحيح
# الوصف: التحقق مما إذا كان حل المعادلة الخطية عدداً صحيحاً
# المعاملات:
#   - أ: معامل المتغير
#   - ب: الحد الثابت
# الإرجاع: 1 إذا كان الحل صحيحاً، 0 إذا كان كسرياً
**#
دالة رقم هل_حل_صحيح(رقم أ، رقم ب)
    إذا (أ == 0)
        إرجاع 0
    نهاية
    رقم باقي = حل_خطية_باقي(أ، ب)
    إذا (باقي == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: حل_خطية_عامة
# الوصف: حل المعادلة أ × س + ب = ج
#         أي: أ × س = ج - ب
#         الحل: س = (ج - ب) / أ
# المعاملات:
#   - أ: معامل المتغير
#   - ب: الحد المضاف للمتغير
#   - ج: الطرف الأيمن
# الإرجاع: الحل × عامل_الدقة
# مثال: حل_خطية_عامة(2، 3، 11) → س = 4 (لأن 2×4+3=11)
**#
دالة رقم حل_خطية_عامة(رقم أ، رقم ب، رقم ج)
    # أ × س + ب = ج → أ × س = ج - ب → س = (ج - ب) / أ
    رقم ب_جديد = ب - ج
    إرجاع حل_خطية(أ، ب_جديد)
نهاية


#**
# دالة: حل_خطية_كسرية
# الوصف: حل المعادلة (أ/ب) × س + (ج/د) = 0
#         يتعامل مع معاملات كسرية
# المعاملات:
#   - أ: بسط المعامل الأول
#   - ب: مقام المعامل الأول
#   - ج: بسط الحد الثابت
#   - د: مقام الحد الثابت
# الإرجاع: الحل × عامل_الدقة
# الصيغة: س = -(ج×ب) / (أ×د)
**#
دالة رقم حل_خطية_كسرية(رقم أ، رقم ب، رقم ج، رقم د)
    رقم عامل_دقة = 1000000
    
    # التحقق من المقامات
    إذا (ب == 0)
        إرجاع 0 - 999999
    نهاية
    إذا (د == 0)
        إرجاع 0 - 999999
    نهاية
    إذا (أ == 0)
        إرجاع 0 - 999999
    نهاية
    
    # (أ/ب) × س + (ج/د) = 0
    # س = -(ج/د) / (أ/ب) = -(ج×ب) / (أ×د)
    رقم البسط = (0 - ج) * ب * عامل_دقة
    رقم المقام = أ * د
    
    إرجاع البسط / المقام
نهاية


# ═══════════════════════════════════════════════════════════════
# §1.2 - المعادلات في متغيرين (صيغة الميل)
# ═══════════════════════════════════════════════════════════════

#**
# دالة: ميل_خط
# الوصف: حساب ميل الخط المار بنقطتين
#         الميل = (ص2 - ص1) / (س2 - س1)
# المعاملات:
#   - س1، ص1: إحداثيات النقطة الأولى
#   - س2، ص2: إحداثيات النقطة الثانية
# الإرجاع: الميل × عامل_الدقة
# مثال: ميل_خط(0، 0، 3، 6) = 2000000 (ميل = 2)
**#
دالة رقم ميل_خط(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم عامل_دقة = 1000000
    
    رقم فرق_س = س2 - س1
    إذا (فرق_س == 0)
        # خط عمودي - ميل غير معرف
        إرجاع 0 - 999999
    نهاية
    
    رقم فرق_ص = ص2 - ص1
    إرجاع (فرق_ص * عامل_دقة) / فرق_س
نهاية


#**
# دالة: تقاطع_ص
# الوصف: حساب نقطة تقاطع الخط مع محور الصادات
#         من معادلة الخط: ص = م × س + ب
#         ب = ص1 - م × س1
# المعاملات: الميل ونقطة على الخط
# الإرجاع: قيمة ب × عامل_الدقة
**#
دالة رقم تقاطع_ص(رقم الميل، رقم س1، رقم ص1)
    # ب = ص1 - م × س1
    # الميل معطى مضروباً في عامل_الدقة
    رقم عامل_دقة = 1000000
    رقم ب = ص1 * عامل_دقة - (الميل * س1) / عامل_دقة
    إرجاع ب
نهاية


#**
# دالة: قيمة_ص_على_خط
# الوصف: حساب قيمة ص لنقطة معلومة السين على خط مستقيم
#         ص = م × س + ب
# المعاملات:
#   - الميل: ميل الخط
#   - ب: تقاطع مع محور الصادات
#   - س: قيمة السين المطلوبة
# الإرجاع: قيمة ص × عامل_الدقة
**#
دالة رقم قيمة_ص_على_خط(رقم الميل، رقم ب، رقم س)
    إرجاع الميل * س + ب
نهاية


#**
# دالة: هل_نقطة_على_خط
# الوصف: التحقق مما إذا كانت نقطة تقع على خط مستقيم
# المعاملات: معادلة الخط (أ×س + ب×ص + ج = 0) والنقطة (س0، ص0)
# الإرجاع: 1 إذا كانت النقطة على الخط، 0 إذا لم تكن
**#
دالة رقم هل_نقطة_على_خط(رقم أ، رقم ب، رقم ج، رقم س0، رقم ص0)
    رقم القيمة = أ * س0 + ب * ص0 + ج
    إذا (القيمة == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: مسافة_نقطة_عن_خط
# الوصف: حساب المسافة العمودية من نقطة إلى خط مستقيم
#         الصيغة: |أ×س0 + ب×ص0 + ج| / √(أ² + ب²)
# المعاملات:
#   - أ، ب، ج: معاملات معادلة الخط (أ×س + ب×ص + ج = 0)
#   - س0، ص0: إحداثيات النقطة
# الإرجاع: المسافة × عامل_الدقة
**#
دالة رقم مسافة_نقطة_عن_خط(رقم أ، رقم ب، رقم ج، رقم س0، رقم ص0)
    رقم عامل_دقة = 1000000
    
    # البسط: |أ×س0 + ب×ص0 + ج|
    رقم البسط = أ * س0 + ب * ص0 + ج
    إذا (البسط < 0)
        البسط = 0 - البسط
    نهاية
    
    # المقام: √(أ² + ب²) - نستخدم جذر نيوتن
    رقم مجموع_مربعات = أ * أ + ب * ب
    رقم الجذر = 1
    رقم تكرار = 0
    كرر طالما (تكرار < 20)
        الجذر = (الجذر + مجموع_مربعات / الجذر) / 2
        تكرار = تكرار + 1
    نهاية
    
    إذا (الجذر == 0)
        إرجاع 0 - 999999
    نهاية
    
    إرجاع (البسط * عامل_دقة) / الجذر
نهاية


#**
# دالة: هل_خطان_متوازيان
# الوصف: التحقق مما إذا كان خطان متوازيين
#         الخطان متوازيان إذا كان لهما نفس الميل
#         أ1/ب1 = أ2/ب2  أي  أ1×ب2 = أ2×ب1
# المعاملات: معاملات الخطين أ1×س + ب1×ص + ج1 = 0
#                              أ2×س + ب2×ص + ج2 = 0
# الإرجاع: 1 إذا كانا متوازيين، 0 إذا لم يكونا
**#
دالة رقم هل_خطان_متوازيان(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    # أ1×ب2 = أ2×ب1 ← الخطان متوازيان
    إذا (أ1 * ب2 == أ2 * ب1)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_خطان_متعامدان
# الوصف: التحقق مما إذا كان خطان متعامدين
#         الخطان متعامدان إذا كان حاصل ضرب ميليهما = -1
#         أ1×أ2 + ب1×ب2 = 0
# المعاملات: معاملات الخطين
# الإرجاع: 1 إذا كانا متعامدين، 0 إذا لم يكونا
**#
دالة رقم هل_خطان_متعامدان(رقم أ1، رقم ب1، رقم أ2، رقم ب2)
    إذا (أ1 * أ2 + ب1 * ب2 == 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: تقاطع_خطين_س
# الوصف: إيجاد إحداثي السين لنقطة تقاطع خطين
#         الخط الأول: أ1×س + ب1×ص + ج1 = 0
#         الخط الثاني: أ2×س + ب2×ص + ج2 = 0
# الحل بقاعدة كرامر:
#   س = (ب1×ج2 - ب2×ج1) / (أ1×ب2 - أ2×ب1)
# الإرجاع: قيمة س × عامل_الدقة
**#
دالة رقم تقاطع_خطين_س(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم عامل_دقة = 1000000
    رقم المحدد = أ1 * ب2 - أ2 * ب1
    
    إذا (المحدد == 0)
        # الخطان متوازيان - لا تقاطع
        إرجاع 0 - 999999
    نهاية
    
    رقم البسط = ب1 * ج2 - ب2 * ج1
    إرجاع (البسط * عامل_دقة) / المحدد
نهاية


#**
# دالة: تقاطع_خطين_ص
# الوصف: إيجاد إحداثي الصاد لنقطة تقاطع خطين
#   ص = (أ2×ج1 - أ1×ج2) / (أ1×ب2 - أ2×ب1)
# الإرجاع: قيمة ص × عامل_الدقة
**#
دالة رقم تقاطع_خطين_ص(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم عامل_دقة = 1000000
    رقم المحدد = أ1 * ب2 - أ2 * ب1
    
    إذا (المحدد == 0)
        إرجاع 0 - 999999
    نهاية
    
    رقم البسط = أ2 * ج1 - أ1 * ج2
    إرجاع (البسط * عامل_دقة) / المحدد
نهاية


#**
# دالة: معادلة_خط_من_نقطتين_أ
# الوصف: إيجاد معامل أ في معادلة الخط أ×س + ب×ص + ج = 0
#         المار بنقطتين (س1، ص1) و (س2، ص2)
#         أ = ص1 - ص2
# الإرجاع: قيمة المعامل أ
**#
دالة رقم معادلة_خط_من_نقطتين_أ(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إرجاع ص1 - ص2
نهاية


#**
# دالة: معادلة_خط_من_نقطتين_ب
# الوصف: إيجاد معامل ب في معادلة الخط
#         ب = س2 - س1
**#
دالة رقم معادلة_خط_من_نقطتين_ب(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إرجاع س2 - س1
نهاية


#**
# دالة: معادلة_خط_من_نقطتين_ج
# الوصف: إيجاد معامل ج في معادلة الخط
#         ج = س1×ص2 - س2×ص1
**#
دالة رقم معادلة_خط_من_نقطتين_ج(رقم س1، رقم ص1، رقم س2، رقم ص2)
    إرجاع س1 * ص2 - س2 * ص1
نهاية


