#**
# دالة: جذر_تكعيبية_نيوتن
# الوصف: إيجاد جذر المعادلة التكعيبية بطريقة نيوتن-رافسون
#         س_جديد = س - ق(س)/ق'(س)
# المعاملات: معاملات المعادلة + تخمين أولي
# الإرجاع: الجذر × عامل_الدقة
**#
دالة رقم جذر_تكعيبية_نيوتن(رقم أ، رقم ب، رقم ج، رقم د، رقم تخمين)
    رقم عامل_دقة = 1000000
    رقم س = تخمين
    
    رقم عداد = 0
    كرر طالما (عداد < 100)
        رقم ق = قيمة_دالة_تكعيبية(أ، ب، ج، د، س)
        رقم ق_مشتقة = مشتقة_تكعيبية(أ، ب، ج، س)
        
        إذا (ق_مشتقة == 0)
            # المشتقة صفر - تحريك بسيط
            س = س + 1
        وإلا
            رقم تصحيح = ق / ق_مشتقة
            س = س - تصحيح
            
            # التحقق من التقارب
            إذا (تصحيح == 0)
                عداد = 100
            نهاية
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع س * عامل_دقة
نهاية


