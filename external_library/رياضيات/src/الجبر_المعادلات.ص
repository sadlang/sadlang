#**
# دالة: جذر_تربيعي_نيوتن
# الوصف: حساب الجذر التربيعي باستخدام طريقة نيوتن التكرارية
#         تبدأ بتخمين أولي وتتقارب تدريجياً
# المعاملات:
#   - ن: العدد المراد إيجاد جذره (يجب ≥ 0)
# الإرجاع: الجذر التربيعي × عامل_الدقة
# الخوارزمية:
#   س_جديد = (س_قديم + ن/س_قديم) / 2
#   تكرر حتى التقارب
**#
دالة رقم جذر_تربيعي_نيوتن(رقم ن)
    رقم عامل_دقة = 1000000
    
    إذا (ن < 0)
        إرجاع 0 - 999999
    نهاية
    إذا (ن == 0)
        إرجاع 0
    نهاية
    إذا (ن == 1)
        إرجاع عامل_دقة
    نهاية
    
    # نضرب ن في عامل_الدقة² للحفاظ على الدقة
    رقم ن_موسع = ن * عامل_دقة * عامل_دقة
    
    # تخمين أولي
    رقم تخمين = ن * عامل_دقة / 2
    إذا (تخمين == 0)
        تخمين = 1
    نهاية
    
    # تكرار نيوتن - 30 خطوة كافية للتقارب
    رقم عداد = 0
    كرر طالما (عداد < 30)
        رقم قسمة = ن_موسع / تخمين
        تخمين = (تخمين + قسمة) / 2
        عداد = عداد + 1
    نهاية
    
    إرجاع تخمين
نهاية


#**
# دالة: جذر_تربيعي_صحيح
