# ║          القسم 8: طريقة نيوتن-رافسون                              ║
# ║          Section 8: Newton-Raphson Method                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# طريقة نيوتن-رافسون هي خوارزمية تكرارية لإيجاد جذور المعادلات
# غير الخطية. تعتمد على تقريب الدالة بخط المماس عند كل خطوة.
#
# الصيغة التكرارية:
#     س_{ن+1} = س_ن - ق(س_ن) / ق'(س_ن)
#
# مميزات:
# - تقارب سريع جداً (تربيعي) بالقرب من الجذر
# - تحتاج تخميناً أولياً قريباً من الجذر
#
# عيوب:
# - قد لا تتقارب إذا كان التخمين بعيداً
# - تفشل عند ق'(س) = 0
# - قد تتأرجح بين قيمتين
#
# التاريخ:
# - اقترحها إسحاق نيوتن (1669م)
# - طورها جوزيف رافسون (1690م)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: نيوتن_جذر_ن
# الوصف: إيجاد الجذر النوني لعدد بطريقة نيوتن
#         أي إيجاد س حيث س^ن = أ
# المعاملات:
#   - عدد: العدد المراد إيجاد جذره
#   - ن: درجة الجذر (2 = تربيعي، 3 = تكعيبي، ...)
# الإرجاع: الجذر × عامل_الدقة
# الخوارزمية:
#   ق(س) = س^ن - أ
#   ق'(س) = ن × س^(ن-1)
#   س_جديد = س - (س^ن - أ) / (ن × س^(ن-1))
#           = ((ن-1) × س + أ / س^(ن-1)) / ن
**#
دالة رقم نيوتن_جذر_ن(رقم عدد، رقم ن)
    رقم عامل_دقة = 1000000
    
    إذا (عدد == 0)
        إرجاع 0
    نهاية
    إذا (ن == 0)
        إرجاع عامل_دقة
    نهاية
    إذا (ن == 1)
        إرجاع عدد * عامل_دقة
    نهاية
    
    رقم سالب = 0
    رقم القيمة = عدد
    إذا (عدد < 0)
        سالب = 1
        القيمة = 0 - عدد
    نهاية
    
    # تخمين أولي
    رقم تخمين = القيمة / ن
    إذا (تخمين == 0)
        تخمين = 1
    نهاية
    
    # تكرار نيوتن
    رقم عداد = 0
    كرر طالما (عداد < 50)
        # حساب تخمين^(ن-1)
        رقم قوة = 1
        رقم ع = 0
        كرر طالما (ع < ن - 1)
            قوة = قوة * تخمين
            ع = ع + 1
        نهاية
        
        إذا (قوة == 0)
            تخمين = تخمين + 1
        وإلا
            # الصيغة: ((ن-1) × تخمين + القيمة / قوة) / ن
            رقم جديد = ((ن - 1) * تخمين + القيمة / قوة) / ن
            إذا (جديد == تخمين)
                عداد = 50
            وإلا
