#** ─────────────────────────────────────────────────────────────────
# طريقة الحذف لغاوس (Gaussian Elimination):
# هي خوارزمية لحل أنظمة المعادلات الخطية عن طريق
# تحويل المصفوفة الموسعة إلى صيغة المثلث العلوي
# ثم التعويض الخلفي لإيجاد قيم المتغيرات.
#
# الخطوات:
# 1. تكوين المصفوفة الموسعة [A|b]
# 2. الاختزال الأمامي: تصفير العناصر تحت القطر
# 3. التعويض الخلفي: حل من الأسفل للأعلى
#
# ملاحظة: بما أن لغة ص ليس لديها مصفوفات مُدمَجة،
# نمثل المصفوفة 2×2 و 3×3 بمتغيرات منفصلة
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: غاوس_2_حل_س
# الوصف: حل نظام 2×2 بطريقة غاوس (الحذف)
#         أ1×س + ب1×ص = ج1
#         أ2×س + ب2×ص = ج2
#
# الخطوة 1: ضرب المعادلة الأولى في أ2 والثانية في أ1
# الخطوة 2: طرح لإلغاء س
# الخطوة 3: إيجاد ص ثم تعويض لإيجاد س
# الإرجاع: قيمة س × عامل_الدقة
**#
دالة رقم غاوس_2_حل_س(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم عامل_دقة = 1000000
    
    # التحقق من أن النظام قابل للحل
    إذا (أ1 == 0)
        إذا (أ2 == 0)
            إرجاع 0 - 999999
        نهاية
        # تبديل المعادلتين
        إرجاع غاوس_2_حل_س(أ2، ب2، ج2، أ1، ب1، ج1)
    نهاية
    
    # الحذف: جعل معامل س في المعادلة الثانية = 0
    # المعادلة الثانية الجديدة: (ب2 - (أ2/أ1)×ب1)×ص = ج2 - (أ2/أ1)×ج1
    # نضرب في أ1 لتجنب الكسور:
    # (أ1×ب2 - أ2×ب1)×ص = أ1×ج2 - أ2×ج1
    
    رقم معامل_ص = أ1 * ب2 - أ2 * ب1
    رقم طرف_أيمن = أ1 * ج2 - أ2 * ج1
    
    إذا (معامل_ص == 0)
        إرجاع 0 - 999999
    نهاية
    
    # ص = طرف_أيمن / معامل_ص
    # س = (ج1 - ب1×ص) / أ1
    
    # حساب ص أولاً (بدون عامل دقة)
    # ص_مضروب = طرف_أيمن × عامل_دقة / معامل_ص
    رقم ص_مقرب = طرف_أيمن / معامل_ص
    
    # التعويض الخلفي: س = (ج1 - ب1×ص) / أ1
    رقم بسط_س = ج1 - ب1 * ص_مقرب
    إرجاع (بسط_س * عامل_دقة) / أ1
نهاية


#**
# دالة: غاوس_2_حل_ص
# الوصف: حل نظام 2×2 بطريقة غاوس لإيجاد ص
# الإرجاع: قيمة ص × عامل_الدقة
**#
دالة رقم غاوس_2_حل_ص(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم عامل_دقة = 1000000
    
    رقم معامل_ص = أ1 * ب2 - أ2 * ب1
    رقم طرف_أيمن = أ1 * ج2 - أ2 * ج1
    
    إذا (معامل_ص == 0)
        إرجاع 0 - 999999
    نهاية
    
    إرجاع (طرف_أيمن * عامل_دقة) / معامل_ص
نهاية


