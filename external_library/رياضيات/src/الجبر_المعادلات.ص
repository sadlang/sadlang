#** ─────────────────────────────────────────────────────────────────
# طريقة التنصيف (Bisection Method):
# خوارزمية لإيجاد جذور المعادلات تعتمد على نظرية القيمة الوسيطية.
#
# الفكرة:
# إذا كانت ق(أ) وق(ب) بإشارتين مختلفتين، فيوجد جذر في [أ، ب].
# نقسم الفترة إلى نصفين ونختار النصف الذي يحتوي على الجذر.
#
# مميزات:
# - مضمونة التقارب (إذا كان هناك تغير إشارة)
# - بسيطة التنفيذ
# - لا تحتاج حساب المشتقة
#
# عيوب:
# - تقارب بطيء (خطي)
# - تحتاج فترة أولية تحتوي على الجذر
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: تنصيف_كثيرة_حدود_2
# الوصف: إيجاد جذر كثيرة حدود من الدرجة الثانية بالتنصيف
#         في الفترة [يسار، يمين]
# المعاملات: معاملات + حدود الفترة
# الإرجاع: الجذر × عامل_الدقة
**#
دالة رقم تنصيف_كثيرة_حدود_2(رقم أ، رقم ب، رقم ج، رقم يسار، رقم يمين)
    رقم عامل_دقة = 1000000
    
    رقم ق_يسار = أ * يسار * يسار + ب * يسار + ج
    
    رقم عداد = 0
    كرر طالما (عداد < 60)
        رقم وسط = (يسار + يمين) / 2
        رقم ق_وسط = أ * وسط * وسط + ب * وسط + ج
        
        إذا (ق_وسط == 0)
            إرجاع وسط * عامل_دقة
        نهاية
        
        إذا (ق_يسار * ق_وسط < 0)
            يمين = وسط
        وإلا
            يسار = وسط
            ق_يسار = ق_وسط
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع ((يسار + يمين) / 2) * عامل_دقة
نهاية


