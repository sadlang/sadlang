    رقم معادلة1 = أ1 * س + ب1 * ص - ج1
    رقم معادلة2 = أ2 * س + ب2 * ص - ج2
    
    إذا (معادلة1 < 0)
        معادلة1 = 0 - معادلة1
    نهاية
    إذا (معادلة2 < 0)
        معادلة2 = 0 - معادلة2
    نهاية
    
    إذا (معادلة1 <= 1)
        إذا (معادلة2 <= 1)
            إرجاع 1
        نهاية
    نهاية
    
    إرجاع 0
نهاية


#**
# دالة: اختبار_المعادلات
# الوصف: تشغيل مجموعة اختبارات شاملة لدوال المعادلات
# الإرجاع: عدد الاختبارات الفاشلة (0 = كل شيء ناجح)
**#
دالة رقم اختبار_المعادلات()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار ملف المعادلات الجبرية")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: المعادلة الخطية 2س - 6 = 0 → س = 3
    رقم ن1 = حل_خطية_صحيح(2، 0 - 6)
    إذا (ن1 == 3)
        نجاح = نجاح + 1
        اطبع_سطر("✓ حل_خطية(2، -6) = 3")
    وإلا
        فشل = فشل + 1
        اطبع("✗ حل_خطية(2، -6) = ")
        اطبع_سطر(ن1)
    نهاية
    
    # اختبار 2: المميز
    رقم ن2 = مميز_تربيعية(1، 0 - 5، 6)
    إذا (ن2 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مميز(1، -5، 6) = 1")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مميز(1، -5، 6) = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: عدد الجذور
    رقم ن3 = عدد_جذور_تربيعية(1، 0 - 5، 6)
    إذا (ن3 == 2)
        نجاح = نجاح + 1
        اطبع_سطر("✓ عدد_جذور(1، -5، 6) = 2")
    وإلا
        فشل = فشل + 1
        اطبع("✗ عدد_جذور(1، -5، 6) = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: محدد 2×2
    رقم ن4 = محدد_2(3، 1، 5، 2)
    إذا (ن4 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ محدد(3،1،5،2) = 1")
    وإلا
        فشل = فشل + 1
        اطبع("✗ محدد(3،1،5،2) = ")
        اطبع_سطر(ن4)
    نهاية
    
    # اختبار 5: محدد 3×3
    # |1 2 3|
    # |4 5 6| = 0
    # |7 8 9|
    رقم ن5 = محدد_3(1، 2، 3، 4، 5، 6، 7، 8، 9)
    إذا (ن5 == 0)
        نجاح = نجاح + 1
        اطبع_سطر("✓ محدد_3(1..9) = 0")
    وإلا
        فشل = فشل + 1
        اطبع("✗ محدد_3(1..9) = ")
        اطبع_سطر(ن5)
    نهاية
    
    # اختبار 6: نظام 2×2
    # 2س + ص = 5
    # س - ص = 1
    # الحل: س = 2، ص = 1
    رقم ن6_س = نظام_2_حل_س(2، 1، 5، 1، 0 - 1، 1)
    إذا (ن6_س == 2000000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ نظام_2 س = 2")
    وإلا
        فشل = فشل + 1
        اطبع("✗ نظام_2 س = ")
        اطبع_سطر(ن6_س)
    نهاية
    
    # اختبار 7: القيمة المطلقة
    رقم ن7 = قيمة_مطلقة(0 - 42)
    إذا (ن7 == 42)
        نجاح = نجاح + 1
        اطبع_سطر("✓ |−42| = 42")
    وإلا
        فشل = فشل + 1
        اطبع("✗ |−42| = ")
        اطبع_سطر(ن7)
    نهاية
    
    # اختبار 8: الخطان المتوازيان
    رقم ن8 = هل_خطان_متوازيان(2، 3، 4، 6)
    إذا (ن8 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 2س+3ص و 4س+6ص متوازيان")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل اختبار التوازي")
    نهاية
    
    # اختبار 9: الخطان المتعامدان
    رقم ن9 = هل_خطان_متعامدان(1، 2، 0 - 2، 1)
    إذا (ن9 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ (1،2) و (-2،1) متعامدان")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل اختبار التعامد")
    نهاية
    
    # اختبار 10: القطع المكافئ
    رقم ن10 = هل_قطع_مفتوح_لأعلى(1)
    إذا (ن10 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ القطع مفتوح لأعلى عندما أ=1")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ فشل اختبار اتجاه القطع")
    نهاية
    
    # اختبار 11: قيمة الدالة التربيعية
    # ص = 2س² + 3س + 1 عند س = 2 → 8 + 6 + 1 = 15
    رقم ن11 = قيمة_دالة_تربيعية(2، 3، 1، 2)
    إذا (ن11 == 15)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 2(2²)+3(2)+1 = 15")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 2(2²)+3(2)+1 = ")
        اطبع_سطر(ن11)
    نهاية
    
    # اختبار 12: الجذر التربيعي الصحيح
    رقم ن12 = جذر_تربيعي_صحيح(144)
    إذا (ن12 == 12)
        نجاح = نجاح + 1
        اطبع_سطر("✓ √144 = 12")
    وإلا
        فشل = فشل + 1
        اطبع("✗ √144 = ")
        اطبع_سطر(ن12)
    نهاية
    
    # ملخص النتائج
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


