# الإرجاع:
#   1: حل وحيد (الخطان متقاطعان)
#   2: حلول لا نهائية (الخطان متطابقان)
#   0: لا حل (الخطان متوازيان)
**#
دالة رقم نظام_2_نوع_الحل(رقم أ1، رقم ب1، رقم ج1، رقم أ2، رقم ب2، رقم ج2)
    رقم المحدد = نظام_2_محدد(أ1، ب1، أ2، ب2)
    
    إذا (المحدد != 0)
        إرجاع 1
    نهاية
    
    # المحدد = 0: إما متوازيان أو متطابقان
    # نتحقق: أ1/أ2 = ب1/ب2 = ج1/ج2 ← متطابقان
    إذا (أ2 != 0)
        إذا (ب2 != 0)
            إذا (أ1 * ج2 == أ2 * ج1)
                إرجاع 2
            نهاية
        نهاية
    نهاية
    
    إرجاع 0
نهاية


