#** ─────────────────────────────────────────────────────────────────
# طريقة الوتر (Secant Method):
# شبيهة بطريقة نيوتن لكن لا تحتاج حساب المشتقة.
# بدلاً من ذلك، تُقرَّب المشتقة بفرق منتهي:
#
#   ق'(سن) ≈ (ق(سن) - ق(سن-1)) / (سن - سن-1)
#
# الصيغة التكرارية:
#   سن+1 = سن - ق(سن) × (سن - سن-1) / (ق(سن) - ق(سن-1))
#
# مميزات:
# - لا تحتاج حساب المشتقة
# - أسرع من التنصيف
#
# عيوب:
# - أبطأ من نيوتن
# - قد لا تتقارب
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: وتر_تربيعية
# الوصف: إيجاد جذر معادلة تربيعية بطريقة الوتر
# المعاملات: معاملات + تخمينان أوليان
# الإرجاع: الجذر × عامل_الدقة
**#
دالة رقم وتر_تربيعية(رقم أ، رقم ب، رقم ج، رقم س0، رقم س1)
    رقم عامل_دقة = 1000000
    
    رقم ق0 = أ * س0 * س0 + ب * س0 + ج
    رقم ق1 = أ * س1 * س1 + ب * س1 + ج
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم فرق_ق = ق1 - ق0
        إذا (فرق_ق == 0)
            عداد = 50
        وإلا
            رقم س2 = س1 - ق1 * (س1 - س0) / فرق_ق
            
            # تحديث
            س0 = س1
            ق0 = ق1
            س1 = س2
            ق1 = أ * س1 * س1 + ب * س1 + ج
            
            إذا (ق1 == 0)
                عداد = 50
            نهاية
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع س1 * عامل_دقة
نهاية


#**
# دالة: وتر_تكعيبية
