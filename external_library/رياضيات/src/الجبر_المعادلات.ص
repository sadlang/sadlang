#** ─────────────────────────────────────────────────────────────────
# طريقة النقطة الثابتة (Fixed-Point Iteration):
# تحويل المعادلة ق(س) = 0 إلى الشكل س = ج(س)
# ثم التكرار: سن+1 = ج(سن)
#
# شرط التقارب:
# |ج'(س)| < 1 في جوار الجذر
#
# مثال: لحل س² - 2 = 0 (أي √2):
# نحول إلى: س = (س + 2/س) / 2
# وهذه هي طريقة نيوتن للجذر التربيعي!
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: نقطة_ثابتة_جذر_تربيعي
# الوصف: حساب الجذر التربيعي بطريقة النقطة الثابتة
#         ج(س) = (س + ن/س) / 2
# المعاملات: العدد المراد إيجاد جذره
# الإرجاع: الجذر × عامل_الدقة
**#
دالة رقم نقطة_ثابتة_جذر_تربيعي(رقم ن)
    رقم عامل_دقة = 1000000
    
    إذا (ن <= 0)
        إرجاع 0
    نهاية
    
    رقم س = ن / 2
    إذا (س == 0)
        س = 1
    نهاية
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم جديد = (س + ن / س) / 2
        إذا (جديد == س)
            عداد = 50
        وإلا
            س = جديد
        نهاية
        عداد = عداد + 1
    نهاية
    
    إرجاع س * عامل_دقة
نهاية


#**
# دالة: نقطة_ثابتة_جذر_تكعيبي
# الوصف: حساب الجذر التكعيبي بطريقة النقطة الثابتة
#         ج(س) = (2×س + ن/(س²)) / 3
# الإرجاع: الجذر × عامل_الدقة
**#
دالة رقم نقطة_ثابتة_جذر_تكعيبي(رقم ن)
    رقم عامل_دقة = 1000000
    
    إذا (ن == 0)
        إرجاع 0
    نهاية
    
    رقم سالب = 0
    رقم القيمة = ن
    إذا (ن < 0)
        سالب = 1
        القيمة = 0 - ن
    نهاية
    
    رقم س = القيمة / 3
    إذا (س == 0)
        س = 1
    نهاية
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم س_مربع = س * س
        إذا (س_مربع == 0)
            س_مربع = 1
        نهاية
        رقم جديد = (2 * س + القيمة / س_مربع) / 3
        إذا (جديد == س)
            عداد = 50
        وإلا
            س = جديد
        نهاية
        عداد = عداد + 1
    نهاية
    
    إذا (سالب == 1)
        إرجاع (0 - س) * عامل_دقة
    نهاية
    إرجاع س * عامل_دقة
نهاية


