# الإرجاع: الجذر التربيعي الصحيح
# مثال: جذر_تربيعي_صحيح(10) = 3 (لأن 3²=9 ≤ 10 < 16=4²)
**#
دالة رقم جذر_تربيعي_صحيح(رقم عدد)
    إذا (عدد < 0)
        إرجاع 0 - 1
    نهاية
    إذا (عدد == 0)
        إرجاع 0
    نهاية
    
    رقم تخمين = عدد / 2
    إذا (تخمين == 0)
        تخمين = 1
    نهاية
    
    رقم عداد = 0
    كرر طالما (عداد < 40)
        رقم قسمة = عدد / تخمين
        رقم جديد = (تخمين + قسمة) / 2
        إذا (جديد == تخمين)
            عداد = 40
        وإلا
            تخمين = جديد
            عداد = عداد + 1
        نهاية
    نهاية
    
    # تصحيح: التأكد أن ن² ≤ العدد
    كرر طالما (تخمين * تخمين > عدد)
        تخمين = تخمين - 1
    نهاية
    
    إرجاع تخمين
