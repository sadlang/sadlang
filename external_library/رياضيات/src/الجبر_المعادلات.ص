#**
# دالة: قيمة_دالة_رابعة
# الوصف: حساب قيمة دالة من الدرجة الرابعة عند نقطة
#         ص = أ×س⁴ + ب×س³ + ج×س² + د×س + هـ
**#
دالة رقم قيمة_دالة_رابعة(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم س)
    رقم س2 = س * س
    رقم س3 = س2 * س
    رقم س4 = س3 * س
    إرجاع أ * س4 + ب * س3 + ج * س2 + د * س + هـ
