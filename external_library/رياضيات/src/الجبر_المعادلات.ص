    رقم ق1 = قيمة_دالة_تكعيبية(أ، ب، ج، د، س1)
    
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم فرق_ق = ق1 - ق0
        إذا (فرق_ق == 0)
            عداد = 50
        وإلا
            رقم س2 = س1 - ق1 * (س1 - س0) / فرق_ق
            
            س0 = س1
            ق0 = ق1
            س1 = س2
            ق1 = قيمة_دالة_تكعيبية(أ، ب، ج، د، س1)
            
            إذا (ق1 == 0)
                عداد = 50
            نهاية
