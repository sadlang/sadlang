#**
# دالة: جذر_تكعيبية_تنصيف
# الوصف: إيجاد جذر المعادلة التكعيبية بطريقة التنصيف
#         أ×س³ + ب×س² + ج×س + د = 0
#         تعمل بالبحث في المجال [-1000، 1000]
# المعاملات: معاملات المعادلة
# الإرجاع: الجذر × عامل_الدقة
**#
دالة رقم جذر_تكعيبية_تنصيف(رقم أ، رقم ب، رقم ج، رقم د)
    رقم عامل_دقة = 1000000
    
    إذا (أ == 0)
        # معادلة تربيعية
        إرجاع جذر1_تربيعية(ب، ج، د)
    نهاية
    
    # البحث عن مجال يحتوي على جذر
    رقم يسار = 0 - 1000
    رقم يمين = 1000
    
    رقم ق_يسار = قيمة_دالة_تكعيبية(أ، ب، ج، د، يسار)
    رقم ق_يمين = قيمة_دالة_تكعيبية(أ، ب، ج، د، يمين)
    
    # التنصيف - 50 تكرار للدقة
    رقم عداد = 0
    كرر طالما (عداد < 50)
        رقم وسط = (يسار + يمين) / 2
        رقم ق_وسط = قيمة_دالة_تكعيبية(أ، ب، ج، د، وسط)
        
        إذا (ق_وسط == 0)
            إرجاع وسط * عامل_دقة
        نهاية
        
        # تحديد أي نصف يحتوي على الجذر
        رقم ضرب = ق_يسار * ق_وسط
        إذا (ضرب < 0)
            يمين = وسط
            ق_يمين = ق_وسط
        وإلا
            يسار = وسط
            ق_يسار = ق_وسط
        نهاية
        
        عداد = عداد + 1
    نهاية
    
    إرجاع ((يسار + يمين) / 2) * عامل_دقة
نهاية


