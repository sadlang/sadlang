#**
# دالة: تشفير_قيصري
# الوصف: إزاحة كل حرف بمقدار المفتاح (mod 26)
#         المدخل: رقم الحرف (0-25), المفتاح
#         الخرج: رقم الحرف المشفر
**#
دالة رقم قيصري_تشفير(رقم الحرف، رقم المفتاح)
    رقم النتيجة = الحرف + المفتاح
    # mod 26
    كرر طالما (النتيجة >= 26)
        النتيجة = النتيجة - 26
    نهاية
    كرر طالما (النتيجة < 0)
        النتيجة = النتيجة + 26
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: فك_قيصري
# الوصف: فك تشفير حرف قيصري
**#
دالة رقم قيصري_فك(رقم الحرف، رقم المفتاح)
    إرجاع قيصري_تشفير(الحرف، 0 - المفتاح)
نهاية


#**
# دالة: ROT13
# الوصف: إزاحة بـ 13 (تشفيره = فك تشفيره)
**#
دالة رقم روت13(رقم الحرف)
    إرجاع قيصري_تشفير(الحرف، 13)
نهاية


