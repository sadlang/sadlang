# ║          القسم 3: الحساب المعياري للتشفير                          ║
# ║          Section 3: Modular Arithmetic for Crypto                  ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: الأس_المعياري_السريع
# الوصف: حساب أ^ن mod م بالتربيع المتكرر
**#
دالة رقم أس_معياري(رقم القاعدة، رقم الأس، رقم المعيار)
    إذا (المعيار == 1)
        إرجاع 0
    نهاية
    
    رقم النتيجة = 1
    رقم ق = القاعدة
    رقم ق_باقي = ق - (ق / المعيار) * المعيار
    ق = ق_باقي
    
    رقم ن = الأس
    كرر طالما (ن > 0)
        رقم باقي_ن = ن - (ن / 2) * 2
        إذا (باقي_ن == 1)
            النتيجة = النتيجة * ق
            رقم ن_باقي = النتيجة - (النتيجة / المعيار) * المعيار
            النتيجة = ن_باقي
        نهاية
        ن = ن / 2
        ق = ق * ق
        رقم ق_باقي2 = ق - (ق / المعيار) * المعيار
        ق = ق_باقي2
    نهاية
    
    إرجاع النتيجة
نهاية


#**
# دالة: ق_م_أ_موسع (Extended GCD)
# الوصف: إيجاد gcd(أ، ب) وكذلك س، ص حيث أ×س + ب×ص = gcd
#         نرجع gcd فقط (الحساب الكامل يحتاج متغيرات متعددة)
**#
دالة رقم ق_م_أ_تشفير(رقم أ، رقم ب)
    رقم س = أ
    رقم ص = ب
    إذا (س < 0)
        س = 0 - س
    نهاية
    إذا (ص < 0)
        ص = 0 - ص
    نهاية
    
    كرر طالما (ص > 0)
        رقم باقي = س - (س / ص) * ص
        س = ص
        ص = باقي
    نهاية
    إرجاع س
نهاية


#**
# دالة: معكوس_معياري_إقليدس
# الوصف: أ⁻¹ mod م بخوارزمية إقليدس الموسعة
**#
دالة رقم معكوس_إقليدس(رقم أ، رقم م)
    رقم م0 = م
    رقم س0 = 0
    رقم س1 = 1
    
    إذا (م == 1)
        إرجاع 0
    نهاية
    
    رقم أ_حالي = أ
    رقم م_حالي = م
    
    كرر طالما (أ_حالي > 1)
        إذا (م_حالي == 0)
            إرجاع 0  # لا يوجد معكوس
        نهاية
        
        رقم ح = أ_حالي / م_حالي
        رقم ت = م_حالي
        
        م_حالي = أ_حالي - ح * م_حالي
        أ_حالي = ت
        ت = س0
        
        س0 = س1 - ح * س0
        س1 = ت
    نهاية
    
    إذا (س1 < 0)
        س1 = س1 + م0
    نهاية
    
    إرجاع س1
نهاية


