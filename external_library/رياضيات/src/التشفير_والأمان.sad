# ║          القسم 5: دوال التجزئة                                     ║
# ║          Section 5: Hash Functions                                 ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: تجزئة_بسيطة
# الوصف: دالة تجزئة بسيطة لعدد
**#
دالة رقم تجزئة_عدد(رقم القيمة، رقم حجم_الجدول)
    إذا (حجم_الجدول <= 0)
        إرجاع 0
    نهاية
    
    رقم ق = القيمة
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    
    # خلط البتات
    ق = ق * 2654435761  # ثابت تجزئة ذهبي
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    
    إرجاع ق - (ق / حجم_الجدول) * حجم_الجدول
نهاية


#**
# دالة: تجزئة_زوج
# الوصف: تجزئة زوج من الأعداد (Cantor pairing + hash)
**#
دالة رقم تجزئة_زوج(رقم أ، رقم ب، رقم حجم_الجدول)
    # تقنية كانتور للتزاوج
    رقم المجموع = أ + ب
    رقم كانتور = المجموع * (المجموع + 1) / 2 + ب
    إرجاع تجزئة_عدد(كانتور، حجم_الجدول)
نهاية


#**
# دالة: تجزئة_أرقام
# الوصف: تجزئة عدد بناءً على أرقامه
**#
دالة رقم تجزئة_أرقام(رقم القيمة، رقم حجم_الجدول)
    رقم ق = القيمة
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    
    رقم التجزئة = 0
    كرر طالما (ق > 0)
        رقم رقم_حالي = ق - (ق / 10) * 10
        التجزئة = التجزئة * 31 + رقم_حالي
        ق = ق / 10
    نهاية
    
    إذا (التجزئة < 0)
        التجزئة = 0 - التجزئة
    نهاية
    
    إرجاع التجزئة - (التجزئة / حجم_الجدول) * حجم_الجدول
نهاية


#**
# دالة: تجزئة_FNV1a_بسيطة
# الوصف: تقريب لـ FNV-1a للأعداد
**#
دالة رقم تجزئة_فنف(رقم القيمة، رقم حجم_الجدول)
    رقم التجزئة = 2166136261  # FNV offset basis (32-bit)
    
    رقم ق = القيمة
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    
    # معالجة كل "بايت"
    رقم بايت1 = ق - (ق / 256) * 256
    التجزئة = التجزئة * 16777619
    إذا (التجزئة < 0)
        التجزئة = 0 - التجزئة
    نهاية
    
    رقم بايت2 = (ق / 256) - (ق / 65536) * 256
    التجزئة = (التجزئة + بايت1) * 16777619
    إذا (التجزئة < 0)
        التجزئة = 0 - التجزئة
    نهاية
    
    التجزئة = التجزئة + بايت2
    إذا (التجزئة < 0)
        التجزئة = 0 - التجزئة
    نهاية
    
    إرجاع التجزئة - (التجزئة / حجم_الجدول) * حجم_الجدول
نهاية


