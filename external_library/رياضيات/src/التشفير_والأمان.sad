#**
# دالة: rsa_حساب_ن
# الوصف: ن = ع₁ × ع₂ (حاصل ضرب عددين أوليين)
**#
دالة رقم آر_إس_إيه_ن(رقم ع1، رقم ع2)
    إرجاع ع1 * ع2
نهاية


#**
# دالة: rsa_حساب_فاي
# الوصف: φ(ن) = (ع₁-1) × (ع₂-1)
**#
دالة رقم آر_إس_إيه_فاي(رقم ع1، رقم ع2)
    إرجاع (ع1 - 1) * (ع2 - 1)
نهاية


#**
# دالة: rsa_تشفير
# الوصف: ج = م^هـ mod ن
#         م = الرسالة (عدد), هـ = المفتاح العام, ن = المعيار
**#
دالة رقم آر_إس_إيه_تشفير(رقم الرسالة، رقم هـ، رقم ن)
    إرجاع أس_معياري(الرسالة، هـ، ن)
نهاية


#**
# دالة: rsa_فك_تشفير
# الوصف: م = ج^د mod ن
#         ج = النص المشفر, د = المفتاح الخاص
**#
دالة رقم آر_إس_إيه_فك(رقم النص_المشفر، رقم د، رقم ن)
    إرجاع أس_معياري(النص_المشفر، د، ن)
نهاية


#**
# دالة: rsa_مفتاح_خاص
# الوصف: د = هـ⁻¹ mod φ(ن)
**#
دالة رقم آر_إس_إيه_مفتاح_خاص(رقم هـ، رقم فاي)
    إرجاع معكوس_إقليدس(هـ، فاي)
نهاية


