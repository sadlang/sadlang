#**
# دالة: ديفي_هلمان_عام
# الوصف: حساب المفتاح العام
#         القيمة_العامة = ق^سر mod ع
#         ق = المولد, سر = المفتاح السري, ع = عدد أولي
**#
دالة رقم ده_عام(رقم المولد، رقم السر، رقم الأولي)
    إرجاع أس_معياري(المولد، السر، الأولي)
نهاية


#**
# دالة: ديفي_هلمان_مشترك
# الوصف: حساب المفتاح المشترك
#         المشترك = القيمة_العامة_الآخر^سري mod ع
**#
دالة رقم ده_مشترك(رقم عام_الآخر، رقم سري، رقم الأولي)
    إرجاع أس_معياري(عام_الآخر، سري، الأولي)
نهاية


#**
# دالة: توقيع_رقمي_بسيط
# الوصف: توقيع = م^د mod ن (تشفير بالمفتاح الخاص)
**#
دالة رقم توقيع(رقم الرسالة، رقم المفتاح_الخاص، رقم ن)
    إرجاع أس_معياري(الرسالة، المفتاح_الخاص، ن)
نهاية


#**
# دالة: تحقق_توقيع
# الوصف: الرسالة_المسترجعة = التوقيع^هـ mod ن
#         ثم نقارنها بالرسالة الأصلية
**#
دالة رقم تحقق_توقيع(رقم التوقيع، رقم المفتاح_العام، رقم ن، رقم الرسالة)
    رقم المسترجع = أس_معياري(التوقيع، المفتاح_العام، ن)
    إذا (المسترجع == الرسالة)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 8: الاختبارات                                       ║
# ║          Section 8: Tests                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

دالة رقم اختبار_التشفير()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار التشفير والأمان")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: قيصري تشفير + فك
    رقم مشفر = قيصري_تشفير(0، 3)  # A+3 = D = 3
    رقم أصلي = قيصري_فك(مشفر، 3)
    إذا (أصلي == 0)
        نجاح = نجاح + 1
        اطبع_سطر("✓ قيصري: تشفير وفك (مفتاح 3)")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ قيصري خطأ")
    نهاية
    
    # اختبار 2: ROT13
    رقم ن2 = روت13(5)  # F(5) + 13 = S(18)
    إذا (ن2 == 18)
        نجاح = نجاح + 1
        اطبع_سطر("✓ ROT13(5) = 18")
    وإلا
        فشل = فشل + 1
        اطبع("✗ ROT13 = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: أفاين
    # E(x) = (5×2 + 8) mod 26 = 18 mod 26 = 18
    رقم ن3 = أفاين_تشفير(2، 5، 8)
    إذا (ن3 == 18)
        نجاح = نجاح + 1
        اطبع_سطر("✓ أفاين(2, 5, 8) = 18")
    وإلا
        فشل = فشل + 1
        اطبع("✗ أفاين = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: أس معياري
    # 3^5 mod 7 = 243 mod 7 = 5
    رقم ن4 = أس_معياري(3، 5، 7)
    إذا (ن4 == 5)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 3^5 mod 7 = 5")
    وإلا
        فشل = فشل + 1
        اطبع("✗ 3^5 mod 7 = ")
        اطبع_سطر(ن4)
    نهاية
    
    # اختبار 5: معكوس معياري
    # 3⁻¹ mod 26 = 9 (لأن 3×9 = 27 ≡ 1 mod 26)
    رقم ن5 = معكوس_معياري_بحث(3، 26)
    إذا (ن5 == 9)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 3⁻¹ mod 26 = 9")
    وإلا
        فشل = فشل + 1
        اطبع("✗ معكوس = ")
        اطبع_سطر(ن5)
    نهاية
    
    # اختبار 6: RSA مبسط
    # ع₁=3, ع₂=11, ن=33, φ=20, هـ=7, د=هـ⁻¹ mod 20 = 3
    رقم ن_آر = آر_إس_إيه_ن(3، 11)
    رقم فاي = آر_إس_إيه_فاي(3، 11)
    رقم د = آر_إس_إيه_مفتاح_خاص(7، فاي)
    
    # تشفير 2: 2^7 mod 33 = 128 mod 33 = 29
    رقم مش = آر_إس_إيه_تشفير(2، 7، ن_آر)
    # فك: 29^3 mod 33 = 24389 mod 33 = 2
    رقم مف = آر_إس_إيه_فك(مش، د، ن_آر)
    
    إذا (مف == 2)
        نجاح = نجاح + 1
        اطبع_سطر("✓ RSA: تشفير وفك (م=2) صحيح")
    وإلا
        فشل = فشل + 1
        اطبع("✗ RSA فك = ")
        اطبع_سطر(مف)
    نهاية
    
    # اختبار 7: ديفي-هلمان
    # ق=5, ع=23, سر_أ=6, سر_ب=15
    رقم عام_أ = ده_عام(5، 6، 23)   # 5^6 mod 23 = 8
    رقم عام_ب = ده_عام(5، 15، 23)  # 5^15 mod 23 = 19
    رقم مشترك_أ = ده_مشترك(عام_ب، 6، 23)
    رقم مشترك_ب = ده_مشترك(عام_أ، 15، 23)
    
    إذا (مشترك_أ == مشترك_ب)
        نجاح = نجاح + 1
        اطبع("✓ ديفي-هلمان: مفتاح مشترك = ")
        اطبع_سطر(مشترك_أ)
    وإلا
        فشل = فشل + 1
        اطبع("✗ المفاتيح مختلفة: ")
        اطبع(مشترك_أ)
        اطبع(" ≠ ")
        اطبع_سطر(مشترك_ب)
    نهاية
    
    # اختبار 8: أفاين فك
    رقم مش8 = أفاين_تشفير(2، 5، 8)
    رقم أص8 = أفاين_فك(مش8، 5، 8)
    إذا (أص8 == 2)
        نجاح = نجاح + 1
        اطبع_سطر("✓ أفاين: فك تشفير صحيح")
    وإلا
        فشل = فشل + 1
        اطبع("✗ أفاين فك = ")
        اطبع_سطر(أص8)
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


# ═══════════════════════════════════════════════════════════════
# نهاية ملف التشفير والأمان
# ═══════════════════════════════════════════════════════════════
