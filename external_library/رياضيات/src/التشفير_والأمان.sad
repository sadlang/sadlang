# ║          القسم 2: شفرة أفاين                                       ║
# ║          Section 2: Affine Cipher                                  ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: أفاين_تشفير
# الوصف: E(x) = (أ × س + ب) mod 26
#         أ يجب أن يكون أولياً مع 26
**#
دالة رقم أفاين_تشفير(رقم الحرف، رقم أ، رقم ب)
    رقم النتيجة = أ * الحرف + ب
    رقم المعيار = النتيجة - (النتيجة / 26) * 26
    كرر طالما (المعيار < 0)
        المعيار = المعيار + 26
    نهاية
    إرجاع المعيار
نهاية


#**
# دالة: معكوس_معياري
# الوصف: إيجاد أ⁻¹ mod م باستخدام البحث
**#
دالة رقم معكوس_معياري_بحث(رقم أ، رقم م)
    رقم ع = 1
    كرر طالما (ع < م)
        رقم حاصل = أ * ع
        رقم باقي = حاصل - (حاصل / م) * م
        إذا (باقي == 1)
            إرجاع ع
        نهاية
        ع = ع + 1
    نهاية
    إرجاع 0  # لا يوجد معكوس
نهاية


#**
# دالة: أفاين_فك
# الوصف: D(y) = أ⁻¹ × (ص - ب) mod 26
**#
دالة رقم أفاين_فك(رقم الحرف، رقم أ، رقم ب)
    رقم أ_معكوس = معكوس_معياري_بحث(أ، 26)
    
    رقم الفرق = الحرف - ب
    كرر طالما (الفرق < 0)
        الفرق = الفرق + 26
    نهاية
    
    رقم النتيجة = أ_معكوس * الفرق
    رقم المعيار = النتيجة - (النتيجة / 26) * 26
    إرجاع المعيار
نهاية


