#**
# دالة: مولد_خطي_متطابق (LCG)
# الوصف: x_(n+1) = (أ × x_n + ج) mod م
#         مولد أعداد شبه عشوائية بسيط
**#
دالة رقم عشوائي_خطي(رقم البذرة، رقم أ، رقم ج، رقم م)
    إذا (م == 0)
        إرجاع 0
    نهاية
    رقم النتيجة = أ * البذرة + ج
    رقم الباقي = النتيجة - (النتيجة / م) * م
    إذا (الباقي < 0)
        الباقي = الباقي + م
    نهاية
    إرجاع الباقي
نهاية


#**
# دالة: مولد_خطي_قياسي
# الوصف: LCG بمعاملات شائعة
#         أ = 1103515245, ج = 12345, م = 2^31
#         نستخدم م = 2147483647 (2^31 - 1)
**#
دالة رقم عشوائي_قياسي(رقم البذرة)
    # نستخدم معاملات مبسطة لتجنب الطفحان
    رقم أ = 16807
    رقم م = 2147483647  # 2^31 - 1
    
    رقم النتيجة = أ * (البذرة - (البذرة / 127773) * 127773)
    النتيجة = النتيجة - 2836 * (البذرة / 127773)
    
    إذا (النتيجة < 0)
        النتيجة = النتيجة + م
    نهاية
    
    إرجاع النتيجة
نهاية


#**
# دالة: عشوائي_في_نطاق
# الوصف: عدد شبه عشوائي في [أدنى، أعلى]
**#
دالة رقم عشوائي_نطاق(رقم البذرة، رقم أدنى، رقم أعلى)
    رقم ع = عشوائي_قياسي(البذرة)
    رقم المدى = أعلى - أدنى + 1
    إذا (المدى <= 0)
        إرجاع أدنى
    نهاية
    رقم الباقي = ع - (ع / المدى) * المدى
    إرجاع أدنى + الباقي
نهاية


#**
# دالة: xorshift
# الوصف: مولد XorShift32 بسيط
**#
دالة رقم عشوائي_إزاحة(رقم الحالة)
    رقم ن = الحالة
    # نحاكي XorShift باستخدام عمليات أساسية
    # بسبب القيود، نستخدم تقريباً
    رقم ن1 = ن * 1103515245 + 12345
    إذا (ن1 < 0)
        ن1 = 0 - ن1
    نهاية
    # mod 2^30
    رقم الباقي = ن1 - (ن1 / 1073741824) * 1073741824
    إرجاع الباقي
نهاية


