#** ─────────────────────────────────────────────────────────────────
# الدوال العكسية:
# arcsin(x): المعرف على [-1, 1]، المدى [-π/2, π/2]
# arccos(x): المعرف على [-1, 1]، المدى [0, π]
# arctan(x): المعرف على كل الأعداد، المدى (-π/2, π/2)
#
# متسلسلة تايلور لـ arctan:
# arctan(x) = x - x³/3 + x⁵/5 - x⁷/7 + ...  (|x| ≤ 1)
#
# arcsin(x) = arctan(x/√(1-x²))
# arccos(x) = π/2 - arcsin(x)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: قوس_ظل_راديان
# الوصف: arctan(x) باستخدام متسلسلة تايلور
# المدخل: x × 10^6
# الإرجاع: arctan(x) × 10^6 (بالراديان)
# ملاحظة: للتقارب الجيد نحتاج |x| ≤ 1
#          لـ |x| > 1: arctan(x) = π/2 - arctan(1/x)
**#
دالة رقم قوس_ظل_راديان(رقم س)
    رقم ع = 1000000
    
    # حالة خاصة
    إذا (س == 0)
        إرجاع 0
    نهاية
    
    رقم سالب = 0
    رقم الإدخال = س
    إذا (الإدخال < 0)
        سالب = 1
        الإدخال = 0 - الإدخال
    نهاية
    
    # إذا |x| > 1 نستخدم: arctan(x) = π/2 - arctan(1/x)
    رقم كبير = 0
    إذا (الإدخال > ع)
        كبير = 1
        الإدخال = ع * ع / الإدخال
    نهاية
    
    # متسلسلة تايلور: arctan(x) = x - x³/3 + x⁵/5 - ...
    رقم حد = الإدخال
    رقم مجموع = حد
    رقم س_مربع = الإدخال * الإدخال / ع
    
    # -x³/3
    حد = 0 - حد * س_مربع / ع
    مجموع = مجموع + حد / 3
    
    # +x⁵/5
    حد = 0 - حد * س_مربع / ع
    مجموع = مجموع + حد / 5
    
    # -x⁷/7
    حد = 0 - حد * س_مربع / ع
    مجموع = مجموع + حد / 7
    
    # +x⁹/9
    حد = 0 - حد * س_مربع / ع
    مجموع = مجموع + حد / 9
    
    # -x¹¹/11
    حد = 0 - حد * س_مربع / ع
    مجموع = مجموع + حد / 11
    
    # +x¹³/13
    حد = 0 - حد * س_مربع / ع
