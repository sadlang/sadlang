#** ─────────────────────────────────────────────────────────────────
# متسلسلة تايلور للجيب:
# sin(x) = x - x³/6 + x⁵/120 - x⁷/5040 + x⁹/362880 - ...
#
# نستخدم:
# - عامل_دقة = 10^6
# - المدخل: الزاوية × عامل_دقة
# - المخرج: الجيب × عامل_دقة
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: جيب_راديان
# الوصف: حساب sin(x) باستخدام متسلسلة تايلور
# المدخل: x × 10^6 (الراديان المقيّس)
# الإرجاع: sin(x) × 10^6
# الخوارزمية: متسلسلة تايلور مع 7 حدود
#              sin(x) ≈ x - x³/3! + x⁵/5! - x⁷/7! + ...
**#
دالة رقم جيب_راديان(رقم س)
    رقم ع = 1000000
    
    # تطبيع إلى [-π, π]
    رقم ز = س
    كرر طالما (ز > 3141593)
        ز = ز - 6283185
    نهاية
    كرر طالما (ز < 0 - 3141593)
        ز = ز + 6283185
    نهاية
    
    # x (المقيّس): ز / 10^6 هو القيمة الحقيقية
    # نحسب: sin = x - x³/6 + x⁵/120 - x⁷/5040 + x⁹/362880
    # كلها بالمقياس
    
    # حدود: ح_ن = (-1)^ن × x^(2ن+1) / (2ن+1)!
    # ح_0 = x
    # ح_1 = -x³/6
    # ح_2 = x⁵/120
    # ...
    
    رقم حد = ز  # الحد الأول = x (مقيّس)
    رقم مجموع = حد
    
    # الحد الثاني: -x³/6
    # حد = -حد × x² / (2×3)
    حد = 0 - حد * ز / ع * ز / ع / 6
    مجموع = مجموع + حد
    
    # الحد الثالث: +x⁵/120
    حد = 0 - حد * ز / ع * ز / ع / 20
    مجموع = مجموع + حد
    
    # الحد الرابع: -x⁷/5040
    حد = 0 - حد * ز / ع * ز / ع / 42
    مجموع = مجموع + حد
    
    # الحد الخامس: +x⁹/362880
    حد = 0 - حد * ز / ع * ز / ع / 72
    مجموع = مجموع + حد
    
    # الحد السادس
    حد = 0 - حد * ز / ع * ز / ع / 110
    مجموع = مجموع + حد
    
    # الحد السابع
    حد = 0 - حد * ز / ع * ز / ع / 156
    مجموع = مجموع + حد
    
    إرجاع مجموع
نهاية


