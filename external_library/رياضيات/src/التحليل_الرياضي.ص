# ║     القسم 5: المعادلات التفاضلية العادية (ODEs)                  ║
# ╚═══════════════════════════════════════════════════════════════════╝

#** ─────────────────────────────────────────────────────────────────
# المعادلات التفاضلية العادية:
# dy/dx = f(x, y)  مع y(x₀) = y₀
#
# طرق الحل العددي:
# 1. أويلر: y_{n+1} = y_n + h*f(x_n, y_n)
# 2. أويلر المحسّن (Heun)
# 3. رونج-كوتا الرابعة (RK4)
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: أويلر_خطوة
# الوصف: خطوة واحدة بطريقة أويلر
#         y_{n+1} = y_n + h * f(x_n, y_n)
# المعاملات:
#   - ص_حالي: y_n (مكبر ×1000)
#   - ميل: f(x_n, y_n) (مكبر ×1000)
#   - ح: خطوة h (مكبر ×1000)
# الإرجاع: y_{n+1} (مكبر ×1000)
**#
دالة رقم أويلر_خطوة(رقم ص_حالي، رقم ميل، رقم ح)
    إرجاع ص_حالي + (ح * ميل) / 1000
نهاية


#**
# دالة: هوين_خطوة
# الوصف: خطوة واحدة بطريقة هوين (أويلر المحسّنة)
#         k1 = f(x, y)
#         k2 = f(x+h, y+h*k1)
#         y_new = y + h/2 * (k1 + k2)
# المعاملات:
#   - ص_حالي: y_n
#   - ك1: f(x_n, y_n) - الميل عند البداية
#   - ك2: f(x_n+h, y_n+h*k1) - الميل عند النهاية
#   - ح: الخطوة
# الإرجاع: y_{n+1}
**#
دالة رقم هوين_خطوة(رقم ص_حالي، رقم ك1، رقم ك2، رقم ح)
    إرجاع ص_حالي + ح * (ك1 + ك2) / 2000
نهاية


#**
# دالة: رك4_خطوة
# الوصف: خطوة واحدة بطريقة رونج-كوتا الرابعة (RK4)
#         y_new = y + h/6 * (k1 + 2*k2 + 2*k3 + k4)
#         (دقة O(h⁴) - أفضل بكثير من أويلر)
# المعاملات:
#   - ص_حالي: y_n (مكبر ×1000)
#   - ك1..ك4: ميول RK4 الأربعة (مكبرة ×1000)
#   - ح: الخطوة (مكبر ×1000)
# الإرجاع: y_{n+1} (مكبر ×1000)
**#
دالة رقم رك4_خطوة(رقم ص_حالي، رقم ك1، رقم ك2، رقم ك3، رقم ك4، رقم ح)
    إرجاع ص_حالي + ح * (ك1 + 2 * ك2 + 2 * ك3 + ك4) / 6000
نهاية


#**
# دالة: حل_معادلة_تفاضلية_أسية
# الوصف: حل dy/dt = k*y بطريقة أويلر
#         الحل التحليلي: y(t) = y₀ * e^(kt)
# المعاملات:
#   - ص0: y(0) القيمة الابتدائية (مكبر ×1000)
#   - ك: ثابت k (مكبر ×1000)
#   - ت_نهائي: الزمن النهائي (مكبر ×1000)
#   - خطوات: عدد الخطوات
# الإرجاع: y(t) النهائية (مكبر ×1000)
**#
دالة رقم حل_معادلة_تفاضلية_أسية(رقم ص0، رقم ك، رقم ت_نهائي، رقم خطوات)
    إذا (خطوات <= 0)
        إرجاع ص0
    نهاية
    
    متغير رقم ح = ت_نهائي / خطوات
    متغير رقم ص = ص0
    متغير رقم ع = 0
    
    طالما (ع < خطوات)
        # dy = k*y ← ميل = k*y/1000
        متغير رقم ميل = (ك * ص) / 1000
        ص = ص + (ح * ميل) / 1000
        ع = ع + 1
    نهاية
    
    إرجاع ص
نهاية


#**
# دالة: حل_معادلة_تفاضلية_تخميد
# الوصف: حل معادلة التخميد dy/dt = -k*y + c (تبريد/تسخين)
#         يتقارب إلى y = c/k
# المعاملات:
#   - ص0: القيمة الابتدائية (مكبر ×1000)
#   - ك: ثابت التخميد (مكبر ×1000)
#   - ج: المصدر الثابت (مكبر ×1000)
#   - ت_نهائي: الزمن (مكبر ×1000)
#   - خطوات: عدد الخطوات
# الإرجاع: y(t) (مكبر ×1000)
**#
دالة رقم حل_معادلة_تفاضلية_تخميد(رقم ص0، رقم ك، رقم ج، رقم ت_نهائي، رقم خطوات)
    إذا (خطوات <= 0)
        إرجاع ص0
    نهاية
    
    متغير رقم ح = ت_نهائي / خطوات
    متغير رقم ص = ص0
    متغير رقم ع = 0
    
    طالما (ع < خطوات)
        متغير رقم ميل = (0 - ك * ص + ج * 1000) / 1000
        ص = ص + (ح * ميل) / 1000
        ع = ع + 1
    نهاية
    
    إرجاع ص
نهاية


