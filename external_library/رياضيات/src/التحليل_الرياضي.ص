#**
# دالة: دالة_ذيتا_جزئية
# الوصف: تقريب جزئي لدالة ذيتا ريمان
#         ζ(s) = Σ(n=1→∞) 1/n^s
#         للأعداد الصحيحة s ≥ 2
# المعاملات:
#   - س: الأس (يجب ≥ 2)
#   - حدود: عدد حدود المتسلسلة
# الإرجاع: ζ(s) مكبر ×10000
**#
دالة رقم دالة_ذيتا_جزئية(رقم س، رقم حدود)
    إذا (س < 2)
        إرجاع 0 - 1  # لا تتقارب
    نهاية
    
    متغير رقم مجموع = 0
    متغير رقم ع = 1
    
    طالما (ع <= حدود)
        # n^s
        متغير رقم قوة = 1
        متغير رقم ج = 0
        طالما (ج < س)
            قوة = قوة * ع
            ج = ج + 1
        نهاية
        
        إذا (قوة > 0)
            مجموع = مجموع + 10000 / قوة
        نهاية
        
        ع = ع + 1
    نهاية
    
    إرجاع مجموع
نهاية


