    إذا (تخمين <= 0)
        تخمين = 1
    نهاية
    
    متغير رقم س = تخمين
    متغير رقم ع = 0
    
    طالما (ع < تكرارات)
        إذا (س == 0)
            س = 1
        نهاية
        س = (س + أ / س) / 2
