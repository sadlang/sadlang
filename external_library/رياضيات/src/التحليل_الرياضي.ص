# المعاملات:
#   - ح_مكبر: خطوة h (×1000)
#   - لامبدا_مكبر: λ (×1000)
# الإرجاع: 1 إذا مستقرة، 0 إذا لا
**#
دالة رقم تحقق_استقرار_أويلر(رقم ح_مكبر، رقم لامبدا_مكبر)
    # |1 + h*λ| < 1
    # 1000 + h*λ/1000
    متغير رقم عامل = 1000 + (ح_مكبر * لامبدا_مكبر) / 1000
    
    إذا (عامل < 0)
        عامل = 0 - عامل
    نهاية
    
    إذا (عامل < 1000)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: رقم_ليابونوف_تقريب
# الوصف: تقريب أس ليابونوف للخريطة اللوجستية
#         λ = (1/n) * Σ ln|f'(x_i)|
#         λ > 0 يعني سلوك فوضوي
# المعاملات:
#   - ر_مكبر: معامل r (×1000) للخريطة اللوجستية
#   - تكرارات: عدد التكرارات
# الإرجاع: أس ليابونوف (×1000)
#   > 0: فوضى، < 0: استقرار
**#
دالة رقم رقم_ليابونوف_تقريب(رقم ر_مكبر، رقم تكرارات)
    متغير رقم س = 500  # x₀ = 0.5
    متغير رقم مج_لن = 0
    متغير رقم ع = 0
    
    # تخطي الحالات العرضية (100 تكرار)
    طالما (ع < 100)
        س = ر_مكبر * س * (1000 - س) / 1000000
        ع = ع + 1
    نهاية
    
    # حساب أس ليابونوف
    ع = 0
    طالما (ع < تكرارات)
        # f'(x) = r(1-2x) → |f'| ≈ r*|1000-2x|/1000
        متغير رقم مشتقة = ر_مكبر * (1000 - 2 * س) / 1000
        إذا (مشتقة < 0)
            مشتقة = 0 - مشتقة
        نهاية
        
        # تقريب ln(مشتقة/1000) بجدول بسيط
        إذا (مشتقة > 1000)
            مج_لن = مج_لن + (مشتقة - 1000) / 2
        وإلا
            مج_لن = مج_لن - (1000 - مشتقة) / 2
        نهاية
        
        # الخطوة التالية
        س = ر_مكبر * س * (1000 - س) / 1000000
        ع = ع + 1
    نهاية
    
    إذا (تكرارات == 0)
        إرجاع 0
    نهاية
    
    إرجاع مج_لن / تكرارات
نهاية


