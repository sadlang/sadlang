#** ─────────────────────────────────────────────────────────────────
# في التحليل الرياضي، النهاية هي القيمة التي تقترب منها الدالة
# أو المتتالية عندما يقترب المدخل من قيمة معينة.
#
# lim(x→a) f(x) = L
#
# حسابياً: نقرب النهاية بحساب f(x) لقيم x قريبة جداً من a
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: نهاية_كثير_حدود_عند
# الوصف: حساب نهاية كثير حدود تربيعي عند نقطة
#         lim(x→a) (ax² + bx + c) = a*a² + b*a + c
# المعاملات:
#   - أ: معامل x²
#   - ب: معامل x
#   - ج: الثابت
#   - نقطة: القيمة التي نقترب منها
# الإرجاع: قيمة النهاية
**#
دالة رقم نهاية_كثير_حدود_عند(رقم أ، رقم ب، رقم ج، رقم نقطة)
    إرجاع أ * نقطة * نقطة + ب * نقطة + ج
نهاية


#**
# دالة: نهاية_نسبية_خطية
# الوصف: نهاية دالة نسبية خطية
#         lim(x→a) (px+q)/(rx+s)
# المعاملات:
#   - ف: معامل البسط
#   - ق: ثابت البسط
#   - ر: معامل المقام
#   - س: ثابت المقام
#   - نقطة: القيمة
# الإرجاع: القيمة مكبرة ×1000، أو ±999999 إذا غير معرفة
**#
دالة رقم نهاية_نسبية_خطية(رقم ف، رقم ق، رقم ر، رقم س، رقم نقطة)
    متغير رقم مقام = ر * نقطة + س
    إذا (مقام == 0)
        متغير رقم بسط = ف * نقطة + ق
        إذا (بسط > 0)
            إرجاع 999999  # +∞
        نهاية
        إذا (بسط < 0)
            إرجاع 0 - 999999  # -∞
        نهاية
        # 0/0 غير محدد
        إرجاع 0 - 888888
    نهاية
    
    إرجاع ((ف * نقطة + ق) * 1000) / مقام
نهاية


#**
# دالة: نهاية_عند_لانهاية
# الوصف: نهاية دالة نسبية عند اللانهاية
#         lim(x→∞) (ax²+bx+c)/(dx²+ex+f)
#         = a/d إذا نفس الدرجة
# الإرجاع: القيمة مكبرة ×1000
**#
دالة رقم نهاية_عند_لانهاية(رقم أ، رقم ب، رقم ج، رقم د، رقم هـ، رقم و)
    # نهاية النسب المتعددة الحدود:
    # إذا درجة البسط = درجة المقام: النهاية = نسبة المعاملات العليا
    إذا (أ == 0)
        إذا (د == 0)
            # درجة 1 / درجة 1
            إذا (هـ == 0)
                إرجاع 0
            نهاية
            إرجاع (ب * 1000) / هـ
        نهاية
        # درجة البسط < درجة المقام
        إرجاع 0
    نهاية
    
    إذا (د == 0)
        # درجة البسط > درجة المقام → ∞
        إذا (أ > 0)
            إرجاع 999999
        نهاية
        إرجاع 0 - 999999
    نهاية
    
    إرجاع (أ * 1000) / د
نهاية


