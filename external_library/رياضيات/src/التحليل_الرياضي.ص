#** ─────────────────────────────────────────────────────────────────
# الاشتقاق العددي يقرب المشتقة باستخدام فرق القيم:
#
# f'(x) ≈ (f(x+h) - f(x-h)) / (2h)     (فرق مركزي)
# f'(x) ≈ (f(x+h) - f(x)) / h           (فرق أمامي)
# f'(x) ≈ (f(x) - f(x-h)) / h           (فرق خلفي)
#
# المشتقة الثانية:
# f''(x) ≈ (f(x+h) - 2f(x) + f(x-h)) / h²
# ────────────────────────────────────────────────────────────────── **#


#**
# دالة: مشتقة_أمامية
# الوصف: تقريب المشتقة بالفرق الأمامي
#         f'(x) ≈ (f(x+h) - f(x)) / h
# المعاملات:
#   - ف_س: f(x) (مكبر ×1000)
#   - ف_س_ح: f(x+h) (مكبر ×1000)
#   - ح: خطوة h (مكبر ×1000)
# الإرجاع: f'(x) (مكبر ×1000)
**#
دالة رقم مشتقة_أمامية(رقم ف_س، رقم ف_س_ح، رقم ح)
    إذا (ح == 0)
        إرجاع 0
    نهاية
    إرجاع ((ف_س_ح - ف_س) * 1000) / ح
نهاية


#**
# دالة: مشتقة_خلفية
# الوصف: تقريب المشتقة بالفرق الخلفي
#         f'(x) ≈ (f(x) - f(x-h)) / h
**#
دالة رقم مشتقة_خلفية(رقم ف_س، رقم ف_س_ناقص_ح، رقم ح)
    إذا (ح == 0)
        إرجاع 0
    نهاية
    إرجاع ((ف_س - ف_س_ناقص_ح) * 1000) / ح
نهاية


#**
# دالة: مشتقة_مركزية
# الوصف: تقريب المشتقة بالفرق المركزي (أدق: خطأ O(h²))
#         f'(x) ≈ (f(x+h) - f(x-h)) / (2h)
**#
دالة رقم مشتقة_مركزية(رقم ف_سالب، رقم ف_موجب، رقم ح)
    إذا (ح == 0)
        إرجاع 0
    نهاية
    إرجاع ((ف_موجب - ف_سالب) * 1000) / (2 * ح)
نهاية


#**
# دالة: مشتقة_ثانية
# الوصف: تقريب المشتقة الثانية
#         f''(x) ≈ (f(x+h) - 2f(x) + f(x-h)) / h²
**#
دالة رقم مشتقة_ثانية(رقم ف_سالب، رقم ف_وسط، رقم ف_موجب، رقم ح)
    إذا (ح == 0)
        إرجاع 0
    نهاية
    متغير رقم ح2 = (ح * ح) / 1000
    إذا (ح2 == 0)
        إرجاع 0
    نهاية
    إرجاع ((ف_موجب - 2 * ف_وسط + ف_سالب) * 1000) / ح2
نهاية


#**
# دالة: مشتقة_ريتشاردسون
# الوصف: استقراء ريتشاردسون لتحسين دقة المشتقة
#         D(h) = (4*D(h/2) - D(h)) / 3
# المعاملات:
#   - م_ح: المشتقة بخطوة h (مكبرة ×1000)
#   - م_ح2: المشتقة بخطوة h/2 (مكبرة ×1000)
# الإرجاع: تقريب محسّن (مكبر ×1000)
**#
دالة رقم مشتقة_ريتشاردسون(رقم م_ح، رقم م_ح2)
    إرجاع (4 * م_ح2 - م_ح) / 3
نهاية


#**
# دالة: مشتقة_5نقاط
# الوصف: صيغة المشتقة بـ 5 نقاط (أعلى دقة)
#         f'(x) ≈ (-f(x+2h) + 8f(x+h) - 8f(x-h) + f(x-2h)) / (12h)
**#
دالة رقم مشتقة_5نقاط(رقم ف_2سالب، رقم ف_سالب، رقم ف_موجب، رقم ف_2موجب، رقم ح)
    إذا (ح == 0)
        إرجاع 0
    نهاية
    إرجاع ((0 - ف_2موجب + 8 * ف_موجب - 8 * ف_سالب + ف_2سالب) * 1000) / (12 * ح)
نهاية


