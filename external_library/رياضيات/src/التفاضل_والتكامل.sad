#**
# دالة: مجموع_أعداد
# الوصف: Σ ع من 1 إلى ن = ن(ن+1)/2
**#
دالة رقم مجموع_طبيعية(رقم ن)
    إرجاع ن * (ن + 1) / 2
نهاية

#**
# دالة: مجموع_مربعات
# الوصف: Σ ع² من 1 إلى ن = ن(ن+1)(2ن+1)/6
**#
دالة رقم مجموع_مربعات(رقم ن)
    إرجاع ن * (ن + 1) * (2 * ن + 1) / 6
نهاية

#**
# دالة: مجموع_مكعبات
# الوصف: Σ ع³ من 1 إلى ن = [ن(ن+1)/2]²
**#
دالة رقم مجموع_مكعبات(رقم ن)
    رقم م = ن * (ن + 1) / 2
    إرجاع م * م
نهاية

#**
# دالة: مجموع_قوى_4
# الوصف: Σ ع⁴ من 1 إلى ن
**#
دالة رقم مجموع_قوى_4(رقم ن)
    رقم المجموع = 0
    رقم ع = 1
    كرر طالما (ع <= ن)
        المجموع = المجموع + ع * ع * ع * ع
        ع = ع + 1
    نهاية
    إرجاع المجموع
نهاية


#**
# دالة: مجموع_متسلسلة_هندسية
# الوصف: أ + أ×ر + أ×ر² + ... + أ×ر^(ن-1)
#         = أ × (1 - ر^ن) / (1 - ر), حيث ر ≠ 1
**#
دالة رقم مجموع_هندسية(رقم أ، رقم ر، رقم ن)
    إذا (ر == 1)
        إرجاع أ * ن
    نهاية
    
    # حساب ر^ن
    رقم ر_أس_ن = 1
    رقم ع = 0
    كرر طالما (ع < ن)
        ر_أس_ن = ر_أس_ن * ر
        ع = ع + 1
    نهاية
    
    إرجاع أ * (1 - ر_أس_ن) / (1 - ر)
نهاية


#**
# دالة: مجموع_متسلسلة_حسابية
# الوصف: أ + (أ+د) + (أ+2د) + ... (ن حد)
#         = ن/2 × (2أ + (ن-1)×د)
**#
دالة رقم مجموع_حسابية(رقم أ، رقم د، رقم ن)
    إرجاع ن * (2 * أ + (ن - 1) * د) / 2
نهاية


#**
# دالة: مجموع_جزئي_هارمونيك
# الوصف: H_ن = 1 + 1/2 + 1/3 + ... + 1/ن
#         النتيجة × عامل_دقة
**#
دالة رقم هارمونيك(رقم ن)
    رقم المجموع = 0
    رقم ع = 1
    كرر طالما (ع <= ن)
        المجموع = المجموع + 1000000 / ع
        ع = ع + 1
    نهاية
    إرجاع المجموع
نهاية


#**
# دالة: متسلسلة_تيلور_أس
# الوصف: تقريب e^س باستخدام متسلسلة تيلور
#         e^س = 1 + س + س²/2! + س³/3! + ...
#         المدخل: س × عامل_دقة
#         النتيجة × عامل_دقة
#         عدد_الحدود: عدد حدود التقريب
**#
دالة رقم تيلور_أس(رقم س_مقياس، رقم عدد_الحدود)
    رقم النتيجة = 1000000  # 1 × عامل_دقة
    رقم الحد = 1000000     # الحد الحالي
    
    رقم ع = 1
    كرر طالما (ع < عدد_الحدود)
        # الحد = الحد × س / ع
        الحد = الحد * س_مقياس / (ع * 1000000)
        النتيجة = النتيجة + الحد
        ع = ع + 1
    نهاية
    
    إرجاع النتيجة
نهاية


