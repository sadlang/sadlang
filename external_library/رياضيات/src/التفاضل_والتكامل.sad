# ║          القسم 3: التكاملات العددية                                ║
# ║          Section 3: Numerical Integration                          ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: تكامل_خطي
# الوصف: ∫(أ×س + ب) من ح₁ إلى ح₂
#         = [أ×س²/2 + ب×س] من ح₁ إلى ح₂
#         النتيجة × عامل_دقة
**#
دالة رقم تكامل_خطي(رقم أ، رقم ب، رقم ح1، رقم ح2)
    # أ×ح₂²/2 + ب×ح₂ - أ×ح₁²/2 - ب×ح₁
    # = أ×(ح₂² - ح₁²)/2 + ب×(ح₂ - ح₁)
    رقم ج1 = أ * (ح2 * ح2 - ح1 * ح1) * 1000000 / 2
    رقم ج2 = ب * (ح2 - ح1) * 1000000
    إرجاع ج1 + ج2
نهاية


#**
# دالة: تكامل_تربيعي
# الوصف: ∫(أ×س² + ب×س + ج) من ح₁ إلى ح₂
#         = [أ×س³/3 + ب×س²/2 + ج×س] من ح₁ إلى ح₂
#         النتيجة × عامل_دقة
**#
دالة رقم تكامل_تربيعي(رقم أ، رقم ب، رقم ج، رقم ح1، رقم ح2)
    # أ×(ح₂³ - ح₁³)/3 + ب×(ح₂² - ح₁²)/2 + ج×(ح₂ - ح₁)
    رقم فرق_مكعب = ح2 * ح2 * ح2 - ح1 * ح1 * ح1
    رقم فرق_مربع = ح2 * ح2 - ح1 * ح1
    رقم فرق = ح2 - ح1
    
    رقم ج1 = أ * فرق_مكعب * 1000000 / 3
    رقم ج2 = ب * فرق_مربع * 1000000 / 2
    رقم ج3 = ج * فرق * 1000000
    
    إرجاع ج1 + ج2 + ج3
نهاية


#**
# دالة: تكامل_قوة
# الوصف: ∫ س^ن من ح₁ إلى ح₂
#         = (ح₂^(ن+1) - ح₁^(ن+1)) / (ن+1)
#         النتيجة × عامل_دقة
**#
دالة رقم تكامل_قوة(رقم ن، رقم ح1، رقم ح2)
    إذا (ن == 0 - 1)
        إرجاع 0  # ln - لا يمكن حسابها بدون تقريب
    نهاية
    
    رقم أس = ن + 1
    
    # حساب ح₂^أس
    رقم ق2 = 1
    رقم ع2 = 0
    كرر طالما (ع2 < أس)
        ق2 = ق2 * ح2
        ع2 = ع2 + 1
    نهاية
    
    # حساب ح₁^أس
    رقم ق1 = 1
    رقم ع1 = 0
    كرر طالما (ع1 < أس)
        ق1 = ق1 * ح1
        ع1 = ع1 + 1
    نهاية
    
    إرجاع (ق2 - ق1) * 1000000 / أس
نهاية


#**
# دالة: تكامل_شبه_منحرف
# الوصف: قاعدة شبه المنحرف لتكامل أ×س² عددياً
#         باستخدام ن خطوة
#         النتيجة × عامل_دقة
**#
دالة رقم شبه_منحرف_مربع(رقم أ، رقم ب، رقم ج، رقم ح1، رقم ح2، رقم خطوات)
    إذا (خطوات <= 0)
        إرجاع 0
    نهاية
    
    # ه = (ح2 - ح1) × عامل / خطوات
    رقم ه_مقياس = (ح2 - ح1) * 1000000 / خطوات
    
    # ف(ح1) + ف(ح2)
    رقم ف_ح1 = أ * ح1 * ح1 + ب * ح1 + ج
    رقم ف_ح2 = أ * ح2 * ح2 + ب * ح2 + ج
    رقم المجموع = ف_ح1 + ف_ح2
    
    # جمع النقاط الداخلية × 2
    رقم ع = 1
    كرر طالما (ع < خطوات)
        # س_ع = ح1 + ع × (ح2-ح1) / خطوات
        رقم س_ع = ح1 * خطوات + ع * (ح2 - ح1)
        # ف(س_ع/خطوات) - نستخدم القياس
        رقم ف = أ * س_ع * س_ع / (خطوات * خطوات) + ب * س_ع / خطوات + ج
        المجموع = المجموع + 2 * ف
        ع = ع + 1
    نهاية
    
    # التكامل = ه/2 × المجموع
    إرجاع ه_مقياس * المجموع / (2 * 1000000)
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 4: المعادلات التفاضلية                              ║
# ║          Section 4: Ordinary Differential Equations                ║
# ╚═══════════════════════════════════════════════════════════════════╝


#**
# دالة: أويلر_خطية
# الوصف: حل ص' = أ×ص بطريقة أويلر
#         ص(0) = ص₀, خطوة = ه, عدد الخطوات = ن
#         النتيجة × عامل_دقة
**#
دالة رقم أويلر_خطية(رقم أ، رقم ص0، رقم ه_مقياس، رقم الخطوات)
    # ص₀ × عامل_دقة
    رقم ص = ص0 * 1000000
    
    رقم ع = 0
    كرر طالما (ع < الخطوات)
        # ص_(ع+1) = ص_ع + ه × أ × ص_ع
        # = ص_ع × (1 + ه × أ / عامل)
        ص = ص + ه_مقياس * أ * ص / (1000000 * 1000000)
        ع = ع + 1
    نهاية
    
    إرجاع ص
نهاية


#**
# دالة: أويلر_تربيعية
# الوصف: حل ص' = أ×س + ب بطريقة أويلر
#         بداية: ص(س₀) = ص₀
#         ه: حجم الخطوة (صحيح)
#         إرجاع ص بعد ن خطوات
**#
دالة رقم أويلر_من_درجة1(رقم أ، رقم ب، رقم س0، رقم ص0، رقم ه، رقم الخطوات)
    رقم ص = ص0
    رقم س = س0
    
    رقم ع = 0
    كرر طالما (ع < الخطوات)
        # ص_(ع+1) = ص_ع + ه × (أ×س + ب)
        ص = ص + ه * (أ * س + ب)
        س = س + ه
        ع = ع + 1
    نهاية
    إرجاع ص
نهاية


#**
# دالة: رنج_كتا_2
# الوصف: طريقة رنج-كتا من الرتبة 2 (نقطة المنتصف)
#         لحل ص' = ف(س، ص)
#         نطبقها على ص' = أ×س + ب
**#
دالة رقم رنج_كتا2_خطية(رقم أ، رقم ب، رقم س0، رقم ص0، رقم ه، رقم الخطوات)
    رقم ص = ص0
    رقم س = س0
    
    رقم ع = 0
    كرر طالما (ع < الخطوات)
        # ك₁ = ه × ف(سن، صن)
        رقم ك1 = ه * (أ * س + ب)
        
        # ك₂ = ه × ف(سن + ه/2، صن + ك₁/2)
        رقم ك2 = ه * (أ * (س + ه / 2) + ب)
        
        ص = ص + ك2
        س = س + ه
        ع = ع + 1
    نهاية
    إرجاع ص
نهاية


