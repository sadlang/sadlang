#**
# دالة: مشتقة_تربيعية
# الوصف: مشتقة ف(س) = أ×س² + ب×س + ج
#         ف'(س) = 2أ×س + ب
**#
دالة رقم مشتقة_تربيعية(رقم أ، رقم ب، رقم ن)
    إرجاع 2 * أ * ن + ب
نهاية


#**
# دالة: مشتقة_تكعيبية
# الوصف: مشتقة ف(س) = أ×س³ + ب×س² + ج×س + د
#         ف'(س) = 3أ×س² + 2ب×س + ج
**#
دالة رقم مشتقة_تكعيبية(رقم أ، رقم ب، رقم ج، رقم ن)
    إرجاع 3 * أ * ن * ن + 2 * ب * ن + ج
نهاية


#**
# دالة: مشتقة_رابعة
# ف(س) = أ×س⁴ + ب×س³ + ج×س² + د×س + هـ
# ف'(س) = 4أ×س³ + 3ب×س² + 2ج×س + د
**#
دالة رقم مشتقة_من4(رقم أ، رقم ب، رقم ج، رقم د، رقم ن)
    إرجاع 4 * أ * ن * ن * ن + 3 * ب * ن * ن + 2 * ج * ن + د
نهاية


#**
# دالة: مشتقة_ثانية_تربيعية
# الوصف: المشتقة الثانية لـ ف(س) = أ×س² + ب×س + ج
#         ف''(س) = 2أ
**#
دالة رقم مشتقة2_تربيعية(رقم أ)
    إرجاع 2 * أ
نهاية


#**
# دالة: مشتقة_ثانية_تكعيبية
# ف''(س) = 6أ×س + 2ب
**#
دالة رقم مشتقة2_تكعيبية(رقم أ، رقم ب، رقم ن)
    إرجاع 6 * أ * ن + 2 * ب
نهاية


#**
# دالة: مشتقة_عددية_تربيعية
# الوصف: تقريب المشتقة عددياً بالفروق المركزية
#         ف'(س) ≈ [ف(س+ه) - ف(س-ه)] / (2ه)
#         ف(س) = أ×س² + ب×س + ج, ه = 1
**#
دالة رقم مشتقة_عددية_درجة2(رقم أ، رقم ب، رقم ج، رقم ن)
    # ه = 1
    رقم ف_زائد = أ * (ن + 1) * (ن + 1) + ب * (ن + 1) + ج
    رقم ف_ناقص = أ * (ن - 1) * (ن - 1) + ب * (ن - 1) + ج
    إرجاع (ف_زائد - ف_ناقص) / 2
نهاية


#**
# دالة: نقطة_حرجة_تربيعية
# الوصف: نقطة حرجة (رأس القطع): س = -ب/(2أ)
#         النتيجة × عامل_دقة
**#
دالة رقم نقطة_حرجة_2(رقم أ، رقم ب)
    إذا (أ == 0)
        إرجاع 0
    نهاية
    إرجاع (0 - ب) * 1000000 / (2 * أ)
نهاية


#**
# دالة: هل_أقصى_محلي
# الوصف: نقطة حرجة هي أقصى محلي إذا ف''(س) < 0
**#
دالة رقم هل_أقصى_تربيعية(رقم أ)
    إذا (أ < 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: هل_أدنى_محلي
# ف''(س) > 0 → أدنى محلي
**#
دالة رقم هل_أدنى_تربيعية(رقم أ)
    إذا (أ > 0)
        إرجاع 1
    نهاية
    إرجاع 0
نهاية


#**
# دالة: ميل_المماس
# الوصف: ميل خط المماس عند نقطة للدالة التربيعية
**#
دالة رقم ميل_مماس_2(رقم أ، رقم ب، رقم ن)
    إرجاع 2 * أ * ن + ب
نهاية


#**
# دالة: معادلة_المماس_ثابت
# الوصف: الحد الثابت في معادلة خط المماس
#         ل: ص = م(س - ن₀) + ف(ن₀)
#         أو ص = م×س + (ف(ن₀) - م×ن₀)
**#
دالة رقم ثابت_المماس_2(رقم أ، رقم ب، رقم ج، رقم ن)
    رقم الميل = 2 * أ * ن + ب
    رقم ف_ن = أ * ن * ن + ب * ن + ج
    إرجاع ف_ن - الميل * ن
نهاية


