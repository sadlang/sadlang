#**
# دالة: مساحة_تحت_مستقيم
# الوصف: المساحة تحت ف(س)=أ×س+ب من ح1 إلى ح2
#         المساحة = |تكامل(ف)| (بالقيمة المطلقة)
**#
دالة رقم مساحة_مستقيم(رقم أ، رقم ب، رقم ح1، رقم ح2)
    رقم التكامل = تكامل_خطي(أ، ب، ح1، ح2)
    إذا (التكامل < 0)
        إرجاع 0 - التكامل
    نهاية
    إرجاع التكامل
نهاية


#**
# دالة: طول_منحنى_خطي
# الوصف: طول المنحنى ف(س)=أ×س+ب من ح1 إلى ح2
#         = √(1 + أ²) × (ح2 - ح1)
#         النتيجة × عامل_دقة
**#
دالة رقم طول_خطي(رقم أ، رقم ح1، رقم ح2)
    # √(1 + أ²) بتقريب نيوتن
    رقم تحت_جذر = 1000000 + أ * أ * 1000000
    
    # تقريب √تحت_جذر
    رقم ت = 1000
    رقم ع = 0
    كرر طالما (ع < 20)
        إذا (ت > 0)
            ت = (ت + تحت_جذر / ت) / 2
        نهاية
        ع = ع + 1
    نهاية
    
    إرجاع ت * (ح2 - ح1)
نهاية


#**
# دالة: حجم_دوران_قرص
# الوصف: حجم الجسم الدوراني بطريقة الأقراص
#         حول محور س لـ ف(س)=ر (ثابت) من ح1 إلى ح2
#         = π × ر² × (ح2 - ح1)
#         النتيجة × عامل_دقة
**#
دالة رقم حجم_أسطوانة_دوران(رقم ر، رقم ح1، رقم ح2)
    # π ≈ 3141593 / 1000000
    رقم النتيجة = 3141593 * ر * ر * (ح2 - ح1) / 1000000
    إرجاع النتيجة
نهاية


#**
# دالة: معدل_التغير
# الوصف: معدل التغير المتوسط لدالة خطية
#         [ف(ب) - ف(أ)] / (ب - أ)
**#
دالة رقم معدل_تغير_خطي(رقم م، رقم ث، رقم أ، رقم ب)
    إذا (أ == ب)
        إرجاع 0
    نهاية
    رقم ف_أ = م * أ + ث
    رقم ف_ب = م * ب + ث
    إرجاع (ف_ب - ف_أ) * 1000000 / (ب - أ)
نهاية


#**
# دالة: معدل_تغير_تربيعية
# الوصف: معدل التغير المتوسط لدالة تربيعية
**#
دالة رقم معدل_تغير_2(رقم أ، رقم ب، رقم ج، رقم س1، رقم س2)
    إذا (س1 == س2)
        إرجاع 0
    نهاية
    رقم ف1 = أ * س1 * س1 + ب * س1 + ج
    رقم ف2 = أ * س2 * س2 + ب * س2 + ج
    إرجاع (ف2 - ف1) * 1000000 / (س2 - س1)
نهاية


# ╔═══════════════════════════════════════════════════════════════════╗
# ║          القسم 7: الاختبارات                                       ║
# ║          Section 7: Tests                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

دالة رقم اختبار_التفاضل_والتكامل()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار التفاضل والتكامل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # اختبار 1: مشتقة تربيعية
    # ف(س) = 3س² + 2س + 1, ف'(2) = 12 + 2 = 14
    رقم ن1 = مشتقة_تربيعية(3، 2، 2)
    إذا (ن1 == 14)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مشتقة 3س²+2س+1 عند 2 = 14")
    وإلا
        فشل = فشل + 1
        اطبع("✗ المشتقة = ")
        اطبع_سطر(ن1)
    نهاية
    
    # اختبار 2: مجموع أعداد طبيعية
    # Σ 1..10 = 55
    رقم ن2 = مجموع_طبيعية(10)
    إذا (ن2 == 55)
        نجاح = نجاح + 1
        اطبع_سطر("✓ Σ(1..10) = 55")
    وإلا
        فشل = فشل + 1
        اطبع("✗ المجموع = ")
        اطبع_سطر(ن2)
    نهاية
    
    # اختبار 3: مجموع مربعات
    # Σ ع² من 1 إلى 5 = 1+4+9+16+25 = 55
    رقم ن3 = مجموع_مربعات(5)
    إذا (ن3 == 55)
        نجاح = نجاح + 1
        اطبع_سطر("✓ Σ(ع², 1..5) = 55")
    وإلا
        فشل = فشل + 1
        اطبع("✗ مجموع المربعات = ")
        اطبع_سطر(ن3)
    نهاية
    
    # اختبار 4: مجموع حسابية
    # أ=1, د=2, ن=5: 1+3+5+7+9 = 25
    رقم ن4 = مجموع_حسابية(1، 2، 5)
    إذا (ن4 == 25)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مجموع حسابية(1,2,5) = 25")
    وإلا
        فشل = فشل + 1
        اطبع("✗ المجموع = ")
        اطبع_سطر(ن4)
    نهاية
    
    # اختبار 5: تكامل خطي
    # ∫(2س+1) من 0 إلى 3 = [س²+س] = 9+3 = 12
    رقم ن5 = تكامل_خطي(2، 1، 0، 3)
    إذا (ن5 == 12000000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ ∫(2س+1, 0→3) = 12")
    وإلا
        فشل = فشل + 1
        اطبع("✗ التكامل = ")
        اطبع_سطر(ن5)
    نهاية
    
    # اختبار 6: نقطة حرجة
    # ف(س) = س² - 4س + 3, نقطة حرجة عند س = 2
    رقم ن6 = نقطة_حرجة_2(1، 0 - 4)
    إذا (ن6 == 2000000)
        نجاح = نجاح + 1
        اطبع_سطر("✓ نقطة حرجة س²-4س+3 عند س=2")
    وإلا
        فشل = فشل + 1
        اطبع("✗ نقطة حرجة = ")
        اطبع_سطر(ن6)
    نهاية
    
    # اختبار 7: مجموع هندسية
    # 1 + 2 + 4 + 8 = 15 (أ=1, ر=2, ن=4)
    رقم ن7 = مجموع_هندسية(1، 2، 4)
    إذا (ن7 == 15)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مجموع هندسية(1,2,4) = 15")
    وإلا
        فشل = فشل + 1
        اطبع("✗ المجموع = ")
        اطبع_سطر(ن7)
    نهاية
    
    # اختبار 8: مشتقة تكعيبية
    # ف(س) = 2س³ + 3س² + 4س + 5
    # ف'(1) = 6 + 6 + 4 = 16
    رقم ن8 = مشتقة_تكعيبية(2، 3، 4، 1)
    إذا (ن8 == 16)
        نجاح = نجاح + 1
        اطبع_سطر("✓ مشتقة 2س³+3س²+4س+5 عند 1 = 16")
    وإلا
        فشل = فشل + 1
        اطبع("✗ المشتقة = ")
        اطبع_سطر(ن8)
    نهاية
    
    # ملخص
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع("  النتيجة: ")
    اطبع(نجاح)
    اطبع(" نجاح، ")
    اطبع(فشل)
    اطبع_سطر(" فشل")
    اطبع_سطر("═══════════════════════════════════════════")
    
    إرجاع فشل
نهاية


