#**
# دالة: نهاية_دالة_خطية
# الوصف: حساب نهاية ف(س) = أ×س + ب عند س → ن
#         النتيجة × 10^6
**#
دالة رقم نهاية_خطية(رقم أ، رقم ب، رقم ن)
    # lim(أ×س + ب) = أ×ن + ب
    إرجاع أ * ن + ب
نهاية


#**
# دالة: نهاية_تربيعية
# الوصف: نهاية ف(س) = أ×س² + ب×س + ج عند س → ن
**#
دالة رقم نهاية_تربيعية(رقم أ، رقم ب، رقم ج، رقم ن)
    إرجاع أ * ن * ن + ب * ن + ج
نهاية


#**
# دالة: نهاية_نسبية
# الوصف: نهاية (أ×س + ب) / (ج×س + د) عند س → ن
#         النتيجة × عامل_دقة
#         يتحقق أن المقام ≠ 0
**#
دالة رقم نهاية_نسبية(رقم أ، رقم ب، رقم ج، رقم د، رقم ن)
    رقم البسط = أ * ن + ب
    رقم المقام = ج * ن + د
    إذا (المقام == 0)
        إرجاع 999999999  # لانهاية
    نهاية
    إرجاع البسط * 1000000 / المقام
نهاية


#**
# دالة: نهاية_عند_لانهاية
# الوصف: نهاية (أ×س² + ب×س + ج)/(د×س² + هـ×س + و) عند س → ∞
#         = أ/د × عامل_دقة
**#
دالة رقم نهاية_لانهاية_2(رقم أ، رقم د)
    إذا (د == 0)
        إرجاع 999999999
    نهاية
    إرجاع أ * 1000000 / د
نهاية


