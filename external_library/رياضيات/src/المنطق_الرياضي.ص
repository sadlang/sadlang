دالة رقم اختبار_المنطق()
    رقم نجاح = 0
    رقم فشل = 0
    
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  اختبار المنطق الرياضي")
    اطبع_سطر("═══════════════════════════════════════════")
    
