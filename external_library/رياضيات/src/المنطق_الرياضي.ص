#**
# دالة: بت_معين
# الوصف: استخراج البت رقم م من العدد ن (م يبدأ من 0)
**#
دالة رقم بت(رقم ن، رقم م)
    رقم القيمة = ن
    رقم ع = 0
    كرر طالما (ع < م)
        القيمة = القيمة / 2
        ع = ع + 1
    نهاية
    إرجاع القيمة - (القيمة / 2) * 2
نهاية


#**
# دالة: تعيين_بت
# الوصف: تعيين البت م في العدد ن
**#
دالة رقم تعيين_بت(رقم ن، رقم م)
    # حساب 2^م
    رقم قوة = 1
    رقم ع = 0
    كرر طالما (ع < م)
        قوة = قوة * 2
        ع = ع + 1
    نهاية
    
    # تحقق هل البت موجود بالفعل
    رقم البت = بت(ن، م)
    إذا (البت == 1)
        إرجاع ن
    نهاية
    إرجاع ن + قوة
نهاية


#**
# دالة: مسح_بت
# الوصف: مسح البت م في العدد ن
**#
دالة رقم مسح_بت(رقم ن، رقم م)
    رقم قوة = 1
    رقم ع = 0
    كرر طالما (ع < م)
        قوة = قوة * 2
        ع = ع + 1
    نهاية
    
    رقم البت = بت(ن، م)
    إذا (البت == 0)
        إرجاع ن
    نهاية
    إرجاع ن - قوة
نهاية


#**
# دالة: عدد_البتات
# الوصف: عدد البتات المعينة (1) في العدد (popcount)
**#
دالة رقم عدد_البتات(رقم ن)
    رقم القيمة = ن
    رقم العدد = 0
    
    كرر طالما (القيمة > 0)
        رقم باقي = القيمة - (القيمة / 2) * 2
        إذا (باقي == 1)
            العدد = العدد + 1
        نهاية
        القيمة = القيمة / 2
    نهاية
    
    إرجاع العدد
نهاية


