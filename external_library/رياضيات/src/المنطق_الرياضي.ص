    # أ ∩ ب = {2} = 0b100 = 4
    رقم ن7 = تقاطع_مجموعات(5، 6)
    إذا (ن7 == 4)
        نجاح = نجاح + 1
        اطبع_سطر("✓ {0,2} ∩ {1,2} = {2}")
