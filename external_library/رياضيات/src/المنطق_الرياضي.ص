#**
# دالة: اتحاد
# الوصف: أ ∪ ب - العناصر في أ أو ب أو كليهما
#         بيتياً: اتحاد = أ OR ب
**#
دالة رقم اتحاد_مجموعات(رقم أ، رقم ب)
    # نحتاج OR بيتي - نبنيه يدوياً
    رقم النتيجة = 0
    رقم القوة = 1
    رقم أ_نسخة = أ
    رقم ب_نسخة = ب
    
    كرر طالما (أ_نسخة > 0)
        رقم بت_أ = أ_نسخة - (أ_نسخة / 2) * 2
        رقم بت_ب = ب_نسخة - (ب_نسخة / 2) * 2
        
        إذا (بت_أ == 1)
            النتيجة = النتيجة + القوة
        وإلا
            إذا (بت_ب == 1)
                النتيجة = النتيجة + القوة
            نهاية
        نهاية
        
        أ_نسخة = أ_نسخة / 2
        ب_نسخة = ب_نسخة / 2
        القوة = القوة * 2
    نهاية
    
    # أضف بتات ب المتبقية
    كرر طالما (ب_نسخة > 0)
        رقم بت2 = ب_نسخة - (ب_نسخة / 2) * 2
        إذا (بت2 == 1)
            النتيجة = النتيجة + القوة
        نهاية
        ب_نسخة = ب_نسخة / 2
        القوة = القوة * 2
    نهاية
    
    إرجاع النتيجة
نهاية


