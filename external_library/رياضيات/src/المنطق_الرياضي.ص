#**
# دالة: عاملي (ن!)
**#
دالة رقم عاملي_منطق(رقم ن)
    إذا (ن <= 1)
        إرجاع 1
    نهاية
    رقم النتيجة = 1
    رقم ع = 2
    كرر طالما (ع <= ن)
        النتيجة = النتيجة * ع
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: عدد_التبديلات
# P(ن، ر) = ن! / (ن-ر)!
**#
دالة رقم تبديلات(رقم ن، رقم ر)
    رقم النتيجة = 1
    رقم ع = 0
    كرر طالما (ع < ر)
        النتيجة = النتيجة * (ن - ع)
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: عدد_التوافيق
# C(ن، ر) = ن! / (ر! × (ن-ر)!)
**#
دالة رقم توافيق(رقم ن، رقم ر)
    إذا (ر > ن)
        إرجاع 0
    نهاية
    # استخدم min(ر، ن-ر) لتقليل الحسابات
    رقم ك = ر
    إذا (ن - ر < ك)
        ك = ن - ر
    نهاية
    
    رقم النتيجة = 1
    رقم ع = 0
    كرر طالما (ع < ك)
        النتيجة = النتيجة * (ن - ع) / (ع + 1)
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: عدد_الأقسام (Stirling 2nd kind تقريب)
# عدد طرق تقسيم ن عنصر إلى ك مجموعات غير فارغة
# نحسب S(ن، 2) = 2^(ن-1) - 1
**#
دالة رقم ستيرلنغ_2(رقم ن)
    إذا (ن < 2)
        إرجاع 0
    نهاية
    
    رقم قوة = 1
    رقم ع = 0
    كرر طالما (ع < ن - 1)
        قوة = قوة * 2
        ع = ع + 1
    نهاية
    
    إرجاع قوة - 1
نهاية


