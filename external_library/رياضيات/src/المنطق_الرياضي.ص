    رقم ن1 = عملية_و(1، 1)
    إذا (ن1 == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ 1 AND 1 = 1")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ AND خطأ")
