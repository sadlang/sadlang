#**
# دالة: انحراف_معياري_تقريبي
# الوصف: σ ≈ √(Var) باستخدام نيوتن
#         المدخل: التباين × 1000, الخرج: σ × 1000
**#
دالة رقم انحراف_معياري_تقريبي(رقم التباين_1000)
    إذا (التباين_1000 <= 0)
        إرجاع 0
    نهاية
    
    # √(التباين) × 1000 = √(التباين × 1000000)
    رقم القيمة = التباين_1000 * 1000
    
    # نيوتن لحساب الجذر
    رقم تخمين = القيمة / 2
    إذا (تخمين == 0)
        تخمين = 1
    نهاية
    
    رقم ع = 0
    كرر طالما (ع < 30)
        إذا (تخمين == 0)
            إرجاع 0
        نهاية
        رقم جديد = (تخمين + القيمة / تخمين) / 2
        إذا (جديد == تخمين)
            إرجاع تخمين
        نهاية
        تخمين = جديد
        ع = ع + 1
