#**
# دالة: توزيع_ذو_حدين_سالب
# الوصف: P(X = k) = C(k-1, r-1) × p^r × (1-p)^(k-r)
#         k = عدد المحاولات للحصول على r نجاح
**#
دالة رقم ذو_حدين_سالب(رقم ك، رقم ر، رقم ح_دقة)
    إذا (ك < ر)
        إرجاع 0
    نهاية
    
    رقم الدقة = 1000000
    رقم ق_دقة = الدقة - ح_دقة
    
    # C(k-1, r-1)
    رقم ت = توافيق(ك - 1، ر - 1)
    
    # p^r
    رقم ح_قوة = الدقة
    رقم ع = 0
    كرر طالما (ع < ر)
        ح_قوة = ح_قوة * ح_دقة / الدقة
        ع = ع + 1
    نهاية
    
    # (1-p)^(k-r)
    رقم ق_قوة = الدقة
    ع = 0
    كرر طالما (ع < ك - ر)
        ق_قوة = ق_قوة * ق_دقة / الدقة
        ع = ع + 1
    نهاية
    
    إرجاع ت * ح_قوة / الدقة * ق_قوة / الدقة
نهاية


#**
# دالة: توزيع_فوق_هندسي
# الوصف: P(X = k) = C(K,k) × C(N-K, n-k) / C(N, n)
#         N = حجم المجتمع, K = عدد النجاح في المجتمع
#         n = حجم العينة, k = عدد النجاح المطلوب
**#
دالة رقم فوق_هندسي(رقم ج_ن، رقم ج_ك، رقم حجم_ن، رقم ك)
    إذا (ك < 0)
        إرجاع 0
    نهاية
    
    رقم ج1 = توافيق(ج_ك، ك)
    رقم ج2 = توافيق(ج_ن - ج_ك، حجم_ن - ك)
    رقم ج3 = توافيق(ج_ن، حجم_ن)
    
    إذا (ج3 == 0)
        إرجاع 0
    نهاية
    
    إرجاع ج1 * ج2 * 1000000 / ج3
نهاية


