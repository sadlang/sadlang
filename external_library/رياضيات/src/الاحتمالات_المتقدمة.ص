نهاية


#**
# دالة: توزيع_بواسون
# الوصف: P(X = k) = e^(-λ) × λ^k / k!
#         λ مُعطى × 1000 (λ=2.5 → 2500)
#         النتيجة × 1000000
# تقريب: e^(-λ) بمتسلسلة
**#
دالة رقم بواسون(رقم لمدا_1000، رقم ك)
    إذا (ك < 0)
        إرجاع 0
    نهاية
    
    # λ^k / k! (بدقة 1000)
    رقم القوة = 1000  # = 1.0
    رقم ع = 0
    كرر طالما (ع < ك)
        القوة = القوة * لمدا_1000 / 1000
        القوة = القوة / (ع + 1)
        ع = ع + 1
    نهاية
    
    # e^(-λ) تقريبي: Σ(-λ)^n/n! أول 10 حدود
    # أسهل: e^(-λ) = 1/e^λ
    # e^λ ≈ Σλ^n/n!
    رقم هـ_لمدا = 1000  # = 1.0
    رقم حد = 1000
    ع = 1
    كرر طالما (ع <= 12)
        حد = حد * لمدا_1000 / (ع * 1000)
        هـ_لمدا = هـ_لمدا + حد
        ع = ع + 1
    نهاية
    
    # 1/e^λ = 1000/هـ_لمدا (بدقة 1000)
    رقم هـ_سالب = 1000000 / هـ_لمدا
    
    # النتيجة = القوة × هـ_سالب / 1000
    إرجاع القوة * هـ_سالب / 1000
نهاية


