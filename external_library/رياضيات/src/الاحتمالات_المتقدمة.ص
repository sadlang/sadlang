#**
# دالة: مضروب
# الوصف: ن! = 1 × 2 × ... × ن
**#
دالة رقم احتمال_مضروب(رقم ن)
    إذا (ن <= 1)
        إرجاع 1
    نهاية
    رقم النتيجة = 1
    رقم ع = 2
    كرر طالما (ع <= ن)
        النتيجة = النتيجة * ع
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: تباديل
# الوصف: P(n,r) = n! / (n-r)!
**#
دالة رقم تباديل(رقم ن، رقم ر)
    إذا (ر > ن)
        إرجاع 0
    نهاية
    إذا (ر < 0)
        إرجاع 0
    نهاية
    رقم النتيجة = 1
    رقم ع = ن - ر + 1
    كرر طالما (ع <= ن)
        النتيجة = النتيجة * ع
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: توافيق
# الوصف: C(n,r) = n! / (r! × (n-r)!)
**#
دالة رقم توافيق(رقم ن، رقم ر)
    إذا (ر > ن)
        إرجاع 0
    نهاية
    إذا (ر < 0)
        إرجاع 0
    نهاية
    إذا (ر > ن - ر)
        ر = ن - ر
    نهاية
    
    رقم النتيجة = 1
    رقم ع = 0
    كرر طالما (ع < ر)
        النتيجة = النتيجة * (ن - ع)
        النتيجة = النتيجة / (ع + 1)
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: تباديل_بتكرار
# الوصف: عدد التباديل مع التكرار = n^r
**#
دالة رقم تباديل_تكرار(رقم ن، رقم ر)
    رقم النتيجة = 1
    رقم ع = 0
    كرر طالما (ع < ر)
        النتيجة = النتيجة * ن
        ع = ع + 1
    نهاية
    إرجاع النتيجة
نهاية


#**
# دالة: توافيق_بتكرار
# الوصف: C(n+r-1, r) = (n+r-1)! / (r! × (n-1)!)
**#
دالة رقم توافيق_تكرار(رقم ن، رقم ر)
    إرجاع توافيق(ن + ر - 1، ر)
نهاية


#**
# دالة: عدد_تيرنجمنت
# الوصف: عدد الاختلالات (Derangements)
#         D(n) = n! × Σ((-1)^k/k!, k=0..n)
#         D(n) = (n-1)(D(n-1) + D(n-2))
**#
دالة رقم اختلالات(رقم ن)
    إذا (ن == 0)
        إرجاع 1
    نهاية
    إذا (ن == 1)
        إرجاع 0
    نهاية
    
    رقم السابق2 = 1  # D(0)
    رقم السابق1 = 0  # D(1)
    رقم الحالي = 0
    
    رقم ع = 2
    كرر طالما (ع <= ن)
        الحالي = (ع - 1) * (السابق1 + السابق2)
        السابق2 = السابق1
        السابق1 = الحالي
        ع = ع + 1
    نهاية
    إرجاع الحالي
نهاية


#**
# دالة: أعداد_ستيرلينغ_النوع_الثاني
# الوصف: S(n, k) = عدد طرق تقسيم n عنصر إلى k مجموعات غير فارغة
#         S(n, k) = k × S(n-1, k) + S(n-1, k-1)
**#
دالة رقم ستيرلينغ_2(رقم ن، رقم ك)
    إذا (ن == 0)
        إذا (ك == 0)
            إرجاع 1
        نهاية
        إرجاع 0
    نهاية
    إذا (ك == 0)
        إرجاع 0
    نهاية
    إذا (ك == 1)
        إرجاع 1
    نهاية
    إذا (ك == ن)
        إرجاع 1
    نهاية
    إذا (ك > ن)
        إرجاع 0
    نهاية
    
    # حالة خاصة: S(n, 2) = 2^(n-1) - 1
    إذا (ك == 2)
        رقم قوة = 1
        رقم ع = 0
        كرر طالما (ع < ن - 1)
            قوة = قوة * 2
            ع = ع + 1
        نهاية
        إرجاع قوة - 1
    نهاية
    
    # حالة S(n, n-1) = C(n, 2)
    إذا (ك == ن - 1)
        إرجاع ن * (ن - 1) / 2
    نهاية
    
    # الحالة العامة بالتكرار
    إرجاع ك * ستيرلينغ_2(ن - 1، ك) + ستيرلينغ_2(ن - 1، ك - 1)
نهاية


#**
# دالة: عدد_بل
# الوصف: B(n) = مجموع S(n,k) لـ k من 0 إلى n
#         عدد طرق تقسيم مجموعة من n عنصر
**#
دالة رقم عدد_بل(رقم ن)
    إذا (ن <= 1)
        إرجاع 1
    نهاية
    رقم المجموع = 0
    رقم ك = 0
    كرر طالما (ك <= ن)
        المجموع = المجموع + ستيرلينغ_2(ن، ك)
        ك = ك + 1
    نهاية
    إرجاع المجموع
نهاية


