#**
# دالة: ماركوف_ن_خطوات
# الوصف: محاكاة سلسلة ماركوف لعدة خطوات
#         نحسب P(الحالة = 0) و P(الحالة = 1) بعد ن خطوات
#         بدءاً من حالة معينة
#         نرجع P(الحالة = 0) × 1000
**#
دالة رقم ماركوف_محاكاة(رقم الحالة_الأولى، رقم الخطوات، رقم ع00، رقم ع01، رقم ع10، رقم ع11)
    # احتمال التواجد في الحالة 0
    رقم ح0 = 0
    إذا (الحالة_الأولى == 0)
        ح0 = 1000
    نهاية
    رقم ح1 = 1000 - ح0
    
    رقم ع = 0
    كرر طالما (ع < الخطوات)
        رقم ح0_جديد = ح0 * ع00 / 1000 + ح1 * ع10 / 1000
        رقم ح1_جديد = ح0 * ع01 / 1000 + ح1 * ع11 / 1000
        ح0 = ح0_جديد
        ح1 = ح1_جديد
        ع = ع + 1
    نهاية
    
    إرجاع ح0
نهاية


