#         نعد عدد الخطوات لليمين و لليسار
**#
دالة رقم مشي_محاكاة(رقم الخطوات، رقم البذرة، رقم الحد)
    رقم الموقع = 0
    رقم بذرة_حالية = البذرة
    رقم ع = 0
    
    كرر طالما (ع < الخطوات)
        # LCG
        بذرة_حالية = بذرة_حالية * 1103515245 + 12345
        إذا (بذرة_حالية < 0)
            بذرة_حالية = 0 - بذرة_حالية
        نهاية
        بذرة_حالية = بذرة_حالية - (بذرة_حالية / 2147483647) * 2147483647
        
        # يمين أو يسار
        رقم الباقي = بذرة_حالية - (بذرة_حالية / 2) * 2
        إذا (الباقي == 0)
            الموقع = الموقع + 1
        وإلا
            الموقع = الموقع - 1
        نهاية
        
        ع = ع + 1
    نهاية
    
    إرجاع الموقع
