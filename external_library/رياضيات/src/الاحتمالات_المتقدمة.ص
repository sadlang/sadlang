#**
# دالة: توزيع_ذو_الحدين
# الوصف: P(X = k) = C(n,k) × p^k × (1-p)^(n-k)
#         نستخدم عامل دقة 1000000
#         p مُعطى × 1000000 (مثلاً 0.5 = 500000)
**#
دالة رقم ذو_حدين(رقم ن، رقم ك، رقم ح_دقة)
    إذا (ك < 0)
        إرجاع 0
    نهاية
    إذا (ك > ن)
        إرجاع 0
    نهاية
    
    رقم الدقة = 1000000
    رقم ق_دقة = الدقة - ح_دقة  # 1-p بدقة
    
    # C(n,k)
    رقم ت = توافيق(ن، ك)
    
    # p^k (بدقة)
    رقم ح_قوة = الدقة  # = 1.0 بدقة
    رقم ع = 0
    كرر طالما (ع < ك)
        ح_قوة = ح_قوة * ح_دقة / الدقة
        ع = ع + 1
    نهاية
    
    # (1-p)^(n-k) (بدقة)
    رقم ق_قوة = الدقة
    ع = 0
    كرر طالما (ع < ن - ك)
        ق_قوة = ق_قوة * ق_دقة / الدقة
        ع = ع + 1
    نهاية
    
    إرجاع ت * ح_قوة / الدقة * ق_قوة / الدقة
نهاية


#**
# دالة: متوسط_ذو_حدين
