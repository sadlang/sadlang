#** ===================================================================
# Sad Math Library - Comprehensive Test Suite v1.0.0
# =================================================================== **#

متغير _ok = 0
متغير _fail = 0

دالة تأكد(رقم فعلي، رقم متوقع، نص وصف)
    اذا (فعلي == متوقع)
        _ok = _ok + 1
    والا
        _fail = _fail + 1
        اطبع("[FAIL] ")
        اطبع(وصف)
        اطبع(" got=")
        اطبع(فعلي)
        اطبع(" want=")
        اطبع_سطر(متوقع)
    نهاية
نهاية

# ===================================================================
# الدوال المختبرة
# ===================================================================

دالة رقم جمع(رقم أ، رقم ب)
    إرجاع أ + ب
نهاية

دالة رقم طرح(رقم أ، رقم ب)
    إرجاع أ - ب
نهاية

دالة رقم ضرب(رقم أ، رقم ب)
    إرجاع أ * ب
نهاية

دالة رقم قسمة(رقم أ، رقم ب)
    اذا (ب == 0)
        إرجاع 0
    نهاية
    إرجاع أ / ب
نهاية

دالة رقم باقي(رقم أ، رقم ب)
    إرجاع أ % ب
نهاية

دالة رقم مربع(رقم أ)
    إرجاع أ * أ
نهاية

دالة رقم مكعب(رقم أ)
    إرجاع أ * أ * أ
نهاية

دالة رقم قوة(رقم أساس، رقم أس)
    اذا (أس == 0)
        إرجاع 1
    نهاية
    متغير ر = 1
    متغير ت = 0
    طالما (ت < أس)
        ر = ر * أساس
        ت = ت + 1
    نهاية
    إرجاع ر
نهاية

دالة رقم مطلق(رقم ن)
    اذا (ن < 0)
        إرجاع 0 - ن
    نهاية
    إرجاع ن
نهاية

دالة رقم أكبر(رقم أ، رقم ب)
    اذا (أ >= ب)
        إرجاع أ
    نهاية
    إرجاع ب
نهاية

دالة رقم أصغر(رقم أ، رقم ب)
    اذا (أ <= ب)
        إرجاع أ
    نهاية
    إرجاع ب
نهاية

دالة رقم قم_أ(رقم أ، رقم ب)
    متغير س = أ
    متغير ص = ب
    اذا (س < 0)
        س = 0 - س
    نهاية
    اذا (ص < 0)
        ص = 0 - ص
    نهاية
    طالما (ص > 0)
        متغير م = ص
        ص = س % ص
        س = م
    نهاية
    إرجاع س
نهاية

دالة رقم مم_أ(رقم أ، رقم ب)
    اذا (أ == 0)
        إرجاع 0
    نهاية
    اذا (ب == 0)
        إرجاع 0
    نهاية
    متغير ح = أ * ب
    اذا (ح < 0)
        ح = 0 - ح
    نهاية
    إرجاع ح / قم_أ(أ، ب)
نهاية

دالة رقم عاملي(رقم ن)
    اذا (ن <= 1)
        إرجاع 1
    نهاية
    إرجاع ن * عاملي(ن - 1)
نهاية

دالة رقم فيب(رقم ن)
    اذا (ن <= 0)
        إرجاع 0
    نهاية
    اذا (ن == 1)
        إرجاع 1
    نهاية
    متغير أ = 0
    متغير ب = 1
    متغير ت = 2
    طالما (ت <= ن)
        متغير م = أ + ب
        أ = ب
        ب = م
        ت = ت + 1
    نهاية
    إرجاع ب
نهاية

دالة رقم أولي(رقم ن)
    اذا (ن < 2)
        إرجاع 0
    نهاية
    اذا (ن == 2)
        إرجاع 1
    نهاية
    اذا (ن % 2 == 0)
        إرجاع 0
    نهاية
    متغير ت = 3
    طالما (ت * ت <= ن)
        اذا (ن % ت == 0)
            إرجاع 0
        نهاية
        ت = ت + 2
    نهاية
    إرجاع 1
نهاية

دالة رقم مج_قواسم(رقم ن)
    اذا (ن <= 1)
        إرجاع 0
    نهاية
    متغير ج = 1
    متغير ت = 2
    طالما (ت * ت <= ن)
        اذا (ن % ت == 0)
            ج = ج + ت
            اذا (ت != ن / ت)
                ج = ج + ن / ت
            نهاية
        نهاية
        ت = ت + 1
    نهاية
    إرجاع ج
نهاية

دالة رقم خانات(رقم ن)
    اذا (ن == 0)
        إرجاع 1
    نهاية
    متغير ع = 0
    متغير م = ن
    اذا (م < 0)
        م = 0 - م
    نهاية
    طالما (م > 0)
        م = م / 10
        ع = ع + 1
    نهاية
    إرجاع ع
نهاية

دالة رقم مج_خانات(رقم ن)
    متغير ج = 0
    متغير م = ن
    اذا (م < 0)
        م = 0 - م
    نهاية
    طالما (م > 0)
        ج = ج + (م % 10)
        م = م / 10
    نهاية
    إرجاع ج
نهاية

دالة رقم عكس(رقم ن)
    متغير ع = 0
    متغير م = ن
    اذا (م < 0)
        م = 0 - م
    نهاية
    طالما (م > 0)
        ع = ع * 10 + (م % 10)
        م = م / 10
    نهاية
    إرجاع ع
نهاية

دالة رقم توافيق(رقم ن، رقم ك)
    اذا (ك == 0)
        إرجاع 1
    نهاية
    اذا (ك == ن)
        إرجاع 1
    نهاية
    اذا (ك > ن)
        إرجاع 0
    نهاية
    متغير كك = ك
    اذا (كك > ن - كك)
        كك = ن - كك
    نهاية
    متغير ر = 1
    متغير ت = 0
    طالما (ت < كك)
        ر = ر * (ن - ت)
        ر = ر / (ت + 1)
        ت = ت + 1
    نهاية
    إرجاع ر
نهاية

دالة رقم مثلثي(رقم ن)
    إرجاع ن * (ن + 1) / 2
نهاية

دالة رقم محيط_مست(رقم ط، رقم ع)
    إرجاع 2 * (ط + ع)
نهاية

دالة رقم مساحة_مست(رقم ط، رقم ع)
    إرجاع ط * ع
نهاية

دالة رقم مساحة_مثلث(رقم ق، رقم هـ)
    إرجاع ق * هـ / 2
نهاية

دالة رقم حجم_مكعب(رقم ض)
    إرجاع ض * ض * ض
نهاية

# ===================================================================
# تشغيل الاختبارات
# ===================================================================
اطبع_سطر("=== Sad Math Library Tests ===")
اطبع_سطر("")

# --- الحساب الاساسي ---
اطبع_سطر("-- Basic Arithmetic --")
تأكد(جمع(3، 5)، 8، "add(3,5)")
تأكد(جمع(0 - 10، 7)، 0 - 3، "add(-10,7)")
تأكد(جمع(0، 0)، 0، "add(0,0)")
تأكد(طرح(10، 3)، 7، "sub(10,3)")
تأكد(طرح(5، 8)، 0 - 3، "sub(5,8)")
تأكد(ضرب(4، 7)، 28، "mul(4,7)")
تأكد(ضرب(0، 100)، 0، "mul(0,100)")
تأكد(ضرب(0 - 3، 5)، 0 - 15، "mul(-3,5)")
تأكد(قسمة(20، 4)، 5، "div(20,4)")
تأكد(قسمة(10، 0)، 0، "div(10,0)")
تأكد(باقي(17، 5)، 2، "mod(17,5)")
تأكد(باقي(10، 3)، 1، "mod(10,3)")

# --- القوى ---
اطبع_سطر("-- Powers --")
تأكد(مربع(7)، 49، "sq(7)")
تأكد(مربع(0 - 5)، 25، "sq(-5)")
تأكد(مكعب(3)، 27، "cube(3)")
تأكد(قوة(2، 10)، 1024، "pow(2,10)")
تأكد(قوة(5، 0)، 1، "pow(5,0)")
تأكد(قوة(3، 4)، 81، "pow(3,4)")

# --- اخرى ---
اطبع_سطر("-- Abs/Min/Max --")
تأكد(مطلق(0 - 7)، 7، "abs(-7)")
تأكد(مطلق(5)، 5، "abs(5)")
تأكد(أكبر(3، 7)، 7، "max(3,7)")
تأكد(أكبر(10، 2)، 10، "max(10,2)")
تأكد(أصغر(3، 7)، 3، "min(3,7)")
تأكد(أصغر(10، 2)، 2، "min(10,2)")

# --- GCD/LCM ---
اطبع_سطر("-- GCD/LCM --")
تأكد(قم_أ(12، 8)، 4، "gcd(12,8)")
تأكد(قم_أ(100، 75)، 25، "gcd(100,75)")
تأكد(قم_أ(17، 13)، 1، "gcd(17,13)")
تأكد(مم_أ(4، 6)، 12، "lcm(4,6)")
تأكد(مم_أ(3، 7)، 21، "lcm(3,7)")

# --- العاملي ---
اطبع_سطر("-- Factorial --")
تأكد(عاملي(0)، 1، "0!")
تأكد(عاملي(1)، 1، "1!")
تأكد(عاملي(5)، 120، "5!")
تأكد(عاملي(7)، 5040، "7!")
تأكد(عاملي(10)، 3628800، "10!")

# --- فيبوناتشي ---
اطبع_سطر("-- Fibonacci --")
تأكد(فيب(0)، 0، "fib(0)")
تأكد(فيب(1)، 1، "fib(1)")
تأكد(فيب(7)، 13، "fib(7)")
تأكد(فيب(10)، 55، "fib(10)")
تأكد(فيب(15)، 610، "fib(15)")
تأكد(فيب(20)، 6765، "fib(20)")

# --- الاعداد الاولية ---
اطبع_سطر("-- Primes --")
تأكد(أولي(2)، 1، "prime(2)")
تأكد(أولي(7)، 1، "prime(7)")
تأكد(أولي(13)، 1، "prime(13)")
تأكد(أولي(97)، 1، "prime(97)")
تأكد(أولي(4)، 0، "prime(4)")
تأكد(أولي(9)، 0، "prime(9)")
تأكد(أولي(1)، 0، "prime(1)")

# --- قواسم ---
اطبع_سطر("-- Divisors --")
تأكد(مج_قواسم(6)، 6، "divsum(6)")
تأكد(مج_قواسم(28)، 28، "divsum(28)")
تأكد(مج_قواسم(12)، 16، "divsum(12)")

# --- الخانات ---
اطبع_سطر("-- Digits --")
تأكد(خانات(12345)، 5، "digits(12345)")
تأكد(خانات(0)، 1، "digits(0)")
تأكد(مج_خانات(12345)، 15، "dsum(12345)")
تأكد(مج_خانات(999)، 27، "dsum(999)")
تأكد(عكس(12345)، 54321، "rev(12345)")

# --- التوافيق ---
اطبع_سطر("-- Combinations --")
تأكد(توافيق(5، 2)، 10، "C(5,2)")
تأكد(توافيق(10، 3)، 120، "C(10,3)")
تأكد(توافيق(6، 0)، 1، "C(6,0)")
تأكد(توافيق(6، 6)، 1، "C(6,6)")

# --- الاعداد المثلثية ---
اطبع_سطر("-- Triangular --")
تأكد(مثلثي(5)، 15، "T(5)")
تأكد(مثلثي(10)، 55، "T(10)")
تأكد(مثلثي(100)، 5050، "T(100)")

# --- الهندسة ---
اطبع_سطر("-- Geometry --")
تأكد(محيط_مست(5، 3)، 16، "rect_p(5,3)")
تأكد(مساحة_مست(5، 3)، 15، "rect_a(5,3)")
تأكد(مساحة_مثلث(10، 6)، 30، "tri_a(10,6)")
تأكد(حجم_مكعب(3)، 27، "cube_v(3)")

# ===================================================================
# ملخص النتائج
# ===================================================================
اطبع_سطر("")
اطبع_سطر("=== Results ===")
اطبع("Passed: ")
اطبع_سطر(_ok)
اطبع("Failed: ")
اطبع_سطر(_fail)
اطبع("Total:  ")
اطبع_سطر(_ok + _fail)

اذا (_fail == 0)
    اطبع_سطر("ALL TESTS PASSED!")
والا
    اطبع(_fail)
    اطبع_سطر(" test(s) FAILED")
نهاية
