# ═══════════════════════════════════════════════════════════════════
# ملف: اختبار_شامل.sad
# المكتبة: رياضيات-شاملة (الإصدار 1.0.0)
# الوصف: ملف الاختبارات الشامل لمكتبة الرياضيات
#         يختبر جميع الأقسام الرئيسية في المكتبة
# المؤلف: فريق لغة ص
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# متغيرات تتبع الاختبارات
# ─────────────────────────────────────────
متغير إجمالي_نجاح = 0
متغير إجمالي_فشل = 0
متغير رقم_اختبار = 0

# ═══════════════════════════════════════════════════════════════
# دالة مساعدة: تحقق من نتيجة اختبار
# ═══════════════════════════════════════════════════════════════
دالة تحقق(اسم, فعلي, متوقع)
    رقم_اختبار = رقم_اختبار + 1
    اذا (فعلي == متوقع)
        اطبع_سطر("  ✓ [" + لنص(رقم_اختبار) + "] " + اسم + " = " + لنص(فعلي))
        إجمالي_نجاح = إجمالي_نجاح + 1
    والا
        اطبع_سطر("  ✗ [" + لنص(رقم_اختبار) + "] " + اسم + " = " + لنص(فعلي) + " (متوقع: " + لنص(متوقع) + ")")
        إجمالي_فشل = إجمالي_فشل + 1
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════
#        القسم 1: العمليات الحسابية الأساسية
# ═══════════════════════════════════════════════════════════════

# --- دوال الجمع ---
دالة جمع(أ, ب)
    ارجع أ + ب
نهاية

دالة جمع_ثلاثة(أ, ب, ج)
    ارجع أ + ب + ج
نهاية

دالة جمع_أربعة(أ, ب, ج, د)
    ارجع أ + ب + ج + د
نهاية

دالة جمع_خمسة(أ, ب, ج, د, هـ)
    ارجع أ + ب + ج + د + هـ
نهاية

# --- دوال الطرح ---
دالة طرح(أ, ب)
    ارجع أ - ب
نهاية

# --- دوال الضرب ---
دالة ضرب(أ, ب)
    ارجع أ * ب
نهاية

# --- دوال القسمة ---
دالة قسمة(أ, ب)
    اذا (ب == 0)
        ارجع 0
    نهاية
    ارجع أ / ب
نهاية

دالة باقي_قسمة(أ, ب)
    اذا (ب == 0)
        ارجع 0
    نهاية
    ارجع أ % ب
نهاية

# --- القيمة المطلقة ---
دالة القيمة_المطلقة(س)
    اذا (س < 0)
        ارجع 0 - س
    نهاية
    ارجع س
نهاية

# --- الأكبر والأصغر ---
دالة الأكبر(أ, ب)
    اذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة الأصغر(أ, ب)
    اذا (أ < ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

# --- القوى ---
دالة قوة(أساس, أس)
    اذا (أس == 0)
        ارجع 1
    نهاية
    متغير ناتج = 1
    متغير ع = 0
    بينما (ع < أس)
        ناتج = ناتج * أساس
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# --- التربيع والتكعيب ---
دالة تربيع(س)
    ارجع س * س
نهاية

دالة تكعيب(س)
    ارجع س * س * س
نهاية

# --- الجذر التربيعي (طريقة نيوتن) ---
دالة جذر_تربيعي(ن)
    اذا (ن <= 0)
        ارجع 0
    نهاية
    متغير تخمين = ن / 2
    اذا (تخمين == 0)
        تخمين = 1
    نهاية
    متغير ع = 0
    بينما (ع < 30)
        تخمين = (تخمين + ن / تخمين) / 2
        ع = ع + 1
    نهاية
    ارجع تخمين
نهاية

# ═══════════════════════════════════════════════════════════════
#        القسم 2: نظرية الأعداد
# ═══════════════════════════════════════════════════════════════

# --- العاملي (Factorial) ---
دالة عاملي(ن)
    اذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * عاملي(ن - 1)
نهاية

# --- فيبوناتشي ---
دالة فيبوناتشي(ن)
    اذا (ن <= 0)
        ارجع 0
    نهاية
    اذا (ن == 1)
        ارجع 1
    نهاية
    متغير أ = 0
    متغير ب = 1
    متغير ع = 2
    بينما (ع <= ن)
        متغير م = أ + ب
        أ = ب
        ب = م
        ع = ع + 1
    نهاية
    ارجع ب
نهاية

# --- هل العدد أولي ---
دالة هل_أولي(ن)
    اذا (ن < 2)
        ارجع 0
    نهاية
    اذا (ن == 2)
        ارجع 1
    نهاية
    اذا (ن % 2 == 0)
        ارجع 0
    نهاية
    متغير ق = 3
    بينما (ق * ق <= ن)
        اذا (ن % ق == 0)
            ارجع 0
        نهاية
        ق = ق + 2
    نهاية
    ارجع 1
نهاية

# --- القاسم المشترك الأكبر (GCD) ---
دالة قمأ(أ, ب)
    # تحويل للقيمة المطلقة
    اذا (أ < 0)
        أ = 0 - أ
    نهاية
    اذا (ب < 0)
        ب = 0 - ب
    نهاية
    بينما (ب != 0)
        متغير م = أ % ب
        أ = ب
        ب = م
    نهاية
    ارجع أ
نهاية

# --- المضاعف المشترك الأصغر (LCM) ---
دالة ممأ(أ, ب)
    اذا (أ == 0)
        ارجع 0
    نهاية
    اذا (ب == 0)
        ارجع 0
    نهاية
    متغير حاصل = أ * ب
    اذا (حاصل < 0)
        حاصل = 0 - حاصل
    نهاية
    ارجع حاصل / قمأ(أ, ب)
نهاية

# --- هل زوجي ---
دالة هل_زوجي(ن)
    اذا (ن % 2 == 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# --- هل فردي ---
دالة هل_فردي(ن)
    اذا (ن % 2 != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# --- عدد قواسم العدد ---
دالة عدد_القواسم(ن)
    اذا (ن <= 0)
        ارجع 0
    نهاية
    متغير عدد = 0
    متغير ق = 1
    بينما (ق * ق <= ن)
        اذا (ن % ق == 0)
            عدد = عدد + 1
            اذا (ق != ن / ق)
                عدد = عدد + 1
            نهاية
        نهاية
        ق = ق + 1
    نهاية
    ارجع عدد
نهاية

# --- مجموع القواسم ---
دالة مجموع_القواسم(ن)
    اذا (ن <= 0)
        ارجع 0
    نهاية
    متغير مج = 0
    متغير ق = 1
    بينما (ق * ق <= ن)
        اذا (ن % ق == 0)
            مج = مج + ق
            اذا (ق != ن / ق)
                مج = مج + (ن / ق)
            نهاية
        نهاية
        ق = ق + 1
    نهاية
    ارجع مج
نهاية

# --- هل عدد كامل (مجموع قواسمه الحقيقية = العدد نفسه) ---
دالة هل_كامل(ن)
    اذا (ن <= 1)
        ارجع 0
    نهاية
    # مجموع القواسم الحقيقية = مجموع كل القواسم - العدد نفسه
    متغير مج = مجموع_القواسم(ن) - ن
    اذا (مج == ن)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════
#        القسم 3: التوافيق والتباديل
# ═══════════════════════════════════════════════════════════════

# --- التوافيق C(n,k) ---
دالة توافيق(ن, ك)
    اذا (ك < 0)
        ارجع 0
    نهاية
    اذا (ك > ن)
        ارجع 0
    نهاية
    اذا (ك == 0)
        ارجع 1
    نهاية
    اذا (ك == ن)
        ارجع 1
    نهاية
    # تحسين: استخدم min(k, n-k)
    متغير ك2 = ك
    اذا (ن - ك < ك2)
        ك2 = ن - ك
    نهاية
    متغير ناتج = 1
    متغير ع = 0
    بينما (ع < ك2)
        ناتج = ناتج * (ن - ع)
        ناتج = ناتج / (ع + 1)
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# --- التباديل P(n,k) ---
دالة تباديل(ن, ك)
    اذا (ك < 0)
        ارجع 0
    نهاية
    اذا (ك > ن)
        ارجع 0
    نهاية
    متغير ناتج = 1
    متغير ع = 0
    بينما (ع < ك)
        ناتج = ناتج * (ن - ع)
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# ═══════════════════════════════════════════════════════════════
#        القسم 4: المتسلسلات والمتتاليات
# ═══════════════════════════════════════════════════════════════

# --- مجموع متسلسلة حسابية ---
دالة مجموع_حسابية(أول, فرق, عدد)
    # S = n/2 * (2a + (n-1)d)
    ارجع عدد * (2 * أول + (عدد - 1) * فرق) / 2
نهاية

# --- الحد النوني من متسلسلة حسابية ---
دالة حد_حسابي(أول, فرق, ن)
    ارجع أول + (ن - 1) * فرق
نهاية

# --- مجموع الأعداد من 1 إلى ن ---
دالة مجموع_أعداد(ن)
    ارجع ن * (ن + 1) / 2
نهاية

# --- مجموع مربعات من 1 إلى ن ---
دالة مجموع_مربعات(ن)
    ارجع ن * (ن + 1) * (2 * ن + 1) / 6
نهاية

# --- مجموع مكعبات من 1 إلى ن ---
دالة مجموع_مكعبات(ن)
    متغير م = ن * (ن + 1) / 2
    ارجع م * م
نهاية

# ═══════════════════════════════════════════════════════════════
#        القسم 5: الهندسة
# ═══════════════════════════════════════════════════════════════

# --- مساحة المستطيل ---
دالة مساحة_مستطيل(طول, عرض)
    ارجع طول * عرض
نهاية

# --- محيط المستطيل ---
دالة محيط_مستطيل(طول, عرض)
    ارجع 2 * (طول + عرض)
نهاية

# --- مساحة المثلث ---
دالة مساحة_مثلث(قاعدة, ارتفاع)
    ارجع قاعدة * ارتفاع / 2
نهاية

# --- حجم المكعب ---
دالة حجم_مكعب(ضلع)
    ارجع ضلع * ضلع * ضلع
نهاية

# --- مساحة سطح المكعب ---
دالة مساحة_سطح_مكعب(ضلع)
    ارجع 6 * ضلع * ضلع
نهاية

# --- حجم متوازي مستطيلات ---
دالة حجم_متوازي(طول, عرض, ارتفاع)
    ارجع طول * عرض * ارتفاع
نهاية

# --- نظرية فيثاغورس (إيجاد الوتر) ---
دالة فيثاغورس_وتر(أ, ب)
    ارجع جذر_تربيعي(أ * أ + ب * ب)
نهاية

# ═══════════════════════════════════════════════════════════════
#        القسم 6: الحساب المعياري
# ═══════════════════════════════════════════════════════════════

# --- جمع معياري ---
دالة جمع_معياري(أ, ب, م)
    ارجع (أ % م + ب % م) % م
نهاية

# --- ضرب معياري ---
دالة ضرب_معياري(أ, ب, م)
    ارجع (أ % م * (ب % م)) % م
نهاية

# --- قوة معيارية (أساس^أس mod م) ---
دالة قوة_معيارية(أساس, أس, م)
    متغير ناتج = 1
    أساس = أساس % م
    بينما (أس > 0)
        اذا (أس % 2 == 1)
            ناتج = (ناتج * أساس) % م
        نهاية
        أس = أس / 2
        أساس = (أساس * أساس) % م
    نهاية
    ارجع ناتج
نهاية

# ═══════════════════════════════════════════════════════════════
#        القسم 7: تحويل الأنظمة العددية
# ═══════════════════════════════════════════════════════════════

# --- عكس العدد ---
دالة عكس_عدد(ن)
    متغير معكوس = 0
    متغير قيمة = ن
    اذا (قيمة < 0)
        قيمة = 0 - قيمة
    نهاية
    بينما (قيمة > 0)
        معكوس = معكوس * 10 + قيمة % 10
        قيمة = قيمة / 10
    نهاية
    اذا (ن < 0)
        ارجع 0 - معكوس
    نهاية
    ارجع معكوس
نهاية

# --- عدد أرقام العدد ---
دالة عدد_الأرقام(ن)
    اذا (ن == 0)
        ارجع 1
    نهاية
    اذا (ن < 0)
        ن = 0 - ن
    نهاية
    متغير عدد = 0
    بينما (ن > 0)
        عدد = عدد + 1
        ن = ن / 10
    نهاية
    ارجع عدد
نهاية

# --- مجموع أرقام العدد ---
دالة مجموع_الأرقام(ن)
    اذا (ن < 0)
        ن = 0 - ن
    نهاية
    متغير مج = 0
    بينما (ن > 0)
        مج = مج + ن % 10
        ن = ن / 10
    نهاية
    ارجع مج
نهاية

# --- هل العدد متماثل (Palindrome) ---
دالة هل_متماثل(ن)
    اذا (ن < 0)
        ارجع 0
    نهاية
    اذا (ن == عكس_عدد(ن))
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════
#        القسم 8: دوال إضافية
# ═══════════════════════════════════════════════════════════════

# --- إشارة العدد ---
دالة إشارة(س)
    اذا (س > 0)
        ارجع 1
    والا_اذا (س < 0)
        ارجع 0 - 1
    والا
        ارجع 0
    نهاية
نهاية

# --- تقييد (Clamp) ---
دالة تقييد(قيمة, حد_أدنى, حد_أقصى)
    اذا (قيمة < حد_أدنى)
        ارجع حد_أدنى
    نهاية
    اذا (قيمة > حد_أقصى)
        ارجع حد_أقصى
    نهاية
    ارجع قيمة
نهاية

# --- التخطيط الخطي (Linear Map) ---
دالة تخطيط_خطي(قيمة, من_بداية, من_نهاية, إلى_بداية, إلى_نهاية)
    # map value from [from_start, from_end] to [to_start, to_end]
    ارجع إلى_بداية + (قيمة - من_بداية) * (إلى_نهاية - إلى_بداية) / (من_نهاية - من_بداية)
نهاية

# --- أعداد كاتالان ---
دالة كاتالان(ن)
    اذا (ن <= 1)
        ارجع 1
    نهاية
    # C(n) = C(2n,n) / (n+1)
    ارجع توافيق(2 * ن, ن) / (ن + 1)
نهاية

# --- أعداد مثلثية ---
دالة عدد_مثلثي(ن)
    ارجع ن * (ن + 1) / 2
نهاية

# --- أعداد مربعية (Pentagonal) ---
دالة عدد_خماسي(ن)
    ارجع ن * (3 * ن - 1) / 2
نهاية


