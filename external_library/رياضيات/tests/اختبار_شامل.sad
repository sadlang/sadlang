اطبع_سطر("")
اطبع_سطر("╔═══════════════════════════════════════════════════════════╗")
اطبع_سطر("║     اختبار شامل لمكتبة الرياضيات - لغة ص v1.0.0       ║")
اطبع_سطر("╚═══════════════════════════════════════════════════════════╝")
اطبع_سطر("")

# ─────────────────────────────────────────────────────────────
# 1. اختبار العمليات الحسابية الأساسية
# ─────────────────────────────────────────────────────────────
اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
اطبع_سطر("  📐 القسم 1: العمليات الحسابية الأساسية")
اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

تحقق("جمع(5, 3)", جمع(5, 3), 8)
تحقق("جمع(0, 0)", جمع(0, 0), 0)
تحقق("جمع(100, 200)", جمع(100, 200), 300)
تحقق("جمع_ثلاثة(1, 2, 3)", جمع_ثلاثة(1, 2, 3), 6)
تحقق("جمع_أربعة(1,2,3,4)", جمع_أربعة(1, 2, 3, 4), 10)
تحقق("جمع_خمسة(1,2,3,4,5)", جمع_خمسة(1, 2, 3, 4, 5), 15)
تحقق("طرح(100, 37)", طرح(100, 37), 63)
تحقق("طرح(0, 5)", طرح(0, 5), 0 - 5)
تحقق("ضرب(7, 8)", ضرب(7, 8), 56)
تحقق("ضرب(0, 1000)", ضرب(0, 1000), 0)
تحقق("ضرب(12, 12)", ضرب(12, 12), 144)
تحقق("قسمة(100, 5)", قسمة(100, 5), 20)
تحقق("قسمة(10, 0)", قسمة(10, 0), 0)
تحقق("باقي_قسمة(17, 5)", باقي_قسمة(17, 5), 2)
تحقق("باقي_قسمة(100, 7)", باقي_قسمة(100, 7), 2)
اطبع_سطر("")

# ─────────────────────────────────────────────────────────────
# 2. اختبار القيمة المطلقة والمقارنات
# ─────────────────────────────────────────────────────────────
اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
اطبع_سطر("  📏 القسم 2: القيمة المطلقة والمقارنات")
اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

تحقق("القيمة_المطلقة(42)", القيمة_المطلقة(42), 42)
تحقق("القيمة_المطلقة(-42)", القيمة_المطلقة(0 - 42), 42)
تحقق("القيمة_المطلقة(0)", القيمة_المطلقة(0), 0)
تحقق("الأكبر(15, 27)", الأكبر(15, 27), 27)
تحقق("الأكبر(99, 1)", الأكبر(99, 1), 99)
تحقق("الأصغر(15, 27)", الأصغر(15, 27), 15)
تحقق("الأصغر(99, 1)", الأصغر(99, 1), 1)
تحقق("إشارة(42)", إشارة(42), 1)
تحقق("إشارة(-5)", إشارة(0 - 5), 0 - 1)
تحقق("إشارة(0)", إشارة(0), 0)
تحقق("تقييد(15, 0, 10)", تقييد(15, 0, 10), 10)
تحقق("تقييد(-5, 0, 10)", تقييد(0 - 5, 0, 10), 0)
تحقق("تقييد(5, 0, 10)", تقييد(5, 0, 10), 5)
اطبع_سطر("")

# ─────────────────────────────────────────────────────────────
# 3. اختبار القوى والجذور
# ─────────────────────────────────────────────────────────────
