من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد تعبير، م_بحث، م_ابحث_من

## اختبار بدون طباعة كائنات كبيرة
متغير نمط = "ص"
متغير نص_م = "أبجد ص هوز"
متغير أعلام = 0

## خطوة 1: إنشاء تعبير
متغير تع = جديد تعبير(نمط، أعلام)
اطبع_سطر("1. تع موجود")

## خطوة 2: تع.عدد_المجموعات
متغير عدد = تع.عدد_المجموعات
اطبع("2. عدد_المجموعات = ")
اطبع_سطر(عدد)

## خطوة 3: تع.المحرك موجود؟
متغير مح = تع.المحرك
اطبع("3. المحرك موجود: ")
اطبع_سطر(مح != لاشيء)

## خطوة 4: شجرة المحرك
متغير شج = مح.الشجرة
اطبع("4. الشجرة موجودة: ")
اطبع_سطر(شج != لاشيء)

## خطوة 5: م_ابحث_من مباشرة
متغير ح = م_ابحث_من(شج، عدد، أعلام، نص_م، 0)
اطبع("5. حالة = ")
اطبع_سطر(ح != لاشيء)

## خطوة 6: متابعة
إذا (ح != لاشيء)
    اطبع("6. مجموعات[0] = ")
    اطبع_سطر(ح.المجموعات[0])
نهاية

## خطوة 7: م_بحث مباشرة
متغير جواب = م_بحث(مح، عدد، أعلام، نص_م)
اطبع("7. جواب == لاشيء ؟ ")
اطبع_سطر(جواب == لاشيء)
إذا (جواب != لاشيء)
    اطبع("7b. جواب.النص_المطابق = ")
    اطبع_سطر(جواب.النص_المطابق)
نهاية

## خطوة 8: تع.بحث()
متغير ن = تع.بحث(نص_م)
اطبع("8. ن == لاشيء ؟ ")
اطبع_سطر(ن == لاشيء)
إذا (ن != لاشيء)
    اطبع("8b. ن.النص_المطابق = ")
    اطبع_سطر(ن.النص_المطابق)
نهاية
