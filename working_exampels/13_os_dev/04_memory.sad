# ===================================================================
# مثال 4: إدارة الذاكرة المباشرة
# Example 4: Direct Memory Management
# ===================================================================
دالة رئيسية ()
اطبع("=== الذاكرة المباشرة ===")

اطبع("كتابة على VGA:")
متغير عنوان = 0xB8000
ذاكرة_اكتب(عنوان, 65)
ذاكرة_اكتب(عنوان + 1, 0x0A)
ذاكرة_اكتب(عنوان + 2, 66)
ذاكرة_اكتب(عنوان + 3, 0x0C)

اطبع("قراءة ذاكرة:")
متغير بيانات = ذاكرة_اقرأ(0x400)
اطبع("  القيمة: " + بيانات)

اطبع("نسخ ذاكرة:")
انسخ_ذاكرة(0xB8000, 0x1000, 160)
اطبع("  تم النسخ")

اطبع("ملء ذاكرة:")
املأ_ذاكرة(0xB8000, 0, 4000)
اطبع("  تم المسح")

اطبع("إعداد المكدس:")
املأ_ذاكرة(0x8C000, 0xCC, 0x4000)
اطبع("  المكدس جاهز")

اطبع("=== انتهى مثال الذاكرة ===")
