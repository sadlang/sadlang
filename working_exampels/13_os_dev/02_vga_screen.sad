# ===================================================================
# مثال 2: شاشة VGA النصية
# Example 2: VGA Text Mode — Direct Screen Writing
# ===================================================================
دالة رئيسية ()
متغير ابيض = 0x0F
متغير اخضر = 0x0A
متغير احمر = 0x0C
متغير اصفر = 0x1E

اطبع("=== شاشة VGA ===")

اطبع("مسح الشاشة:")
شاشة_امسح(ابيض)

اطبع("كتابة Hello OS:")
شاشة_اكتب(0, 0, 72, اخضر)
شاشة_اكتب(0, 1, 101, اخضر)
شاشة_اكتب(0, 2, 108, اخضر)
شاشة_اكتب(0, 3, 108, اخضر)
شاشة_اكتب(0, 4, 111, اخضر)
شاشة_اكتب(0, 5, 32, اخضر)
شاشة_اكتب(0, 6, 79, اخضر)
شاشة_اكتب(0, 7, 83, اخضر)

اطبع("كتابة Sad OS:")
شاشة_اكتب(1, 0, 83, اصفر)
شاشة_اكتب(1, 1, 97, اصفر)
شاشة_اكتب(1, 2, 100, اصفر)
شاشة_اكتب(1, 3, 32, اصفر)
شاشة_اكتب(1, 4, 79, اصفر)
شاشة_اكتب(1, 5, 83, اصفر)

اطبع("كتابة SAD في المنتصف:")
شاشة_اكتب(12, 35, 83, ابيض)
شاشة_اكتب(12, 36, 65, ابيض)
شاشة_اكتب(12, 37, 68, ابيض)

اطبع("=== انتهى مثال VGA ===")
نهاية