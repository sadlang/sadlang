# ===================================================================
# مثال 5: نواة نظام تشغيل بسيطة — Sad OS Kernel
# Example 5: Simple OS Kernel combining all concepts
# ===================================================================
دالة رئيسية ()
اطبع("========================================")
اطبع("    نواة نظام تشغيل ص — Sad OS")
اطبع("========================================")
اطبع("")

# الخطوة 1
اطبع("[نواة] 1: تعطيل المقاطعات...")
تعطيل_مقاطعات()

# الخطوة 2
اطبع("[نواة] 2: مسح الشاشة...")
شاشة_امسح(0x0F)

# الخطوة 3 — رسالة ترحيب SAD OS
اطبع("[نواة] 3: رسالة الترحيب...")
شاشة_اكتب(2, 30, 83, 0x0E)
شاشة_اكتب(2, 31, 65, 0x0E)
شاشة_اكتب(2, 32, 68, 0x0E)
شاشة_اكتب(2, 33, 32, 0x0E)
شاشة_اكتب(2, 34, 79, 0x0E)
شاشة_اكتب(2, 35, 83, 0x0E)

# الخطوة 4 — إعداد PIC
اطبع("[نواة] 4: إعداد PIC...")
منفذ_اكتب(0x20, 0x11)
منفذ_اكتب(0xA0, 0x11)
منفذ_اكتب(0x21, 0x20)
منفذ_اكتب(0xA1, 0x28)
منفذ_اكتب(0x21, 0x04)
منفذ_اكتب(0xA1, 0x02)
منفذ_اكتب(0x21, 0x01)
منفذ_اكتب(0xA1, 0x01)
اطبع("  تم إعداد PIC")

# الخطوة 5
اطبع("[نواة] 5: تفعيل المقاطعات...")
تفعيل_مقاطعات()

# الخطوة 6 — دورات النواة
اطبع("[نواة] 6: حلقة النواة...")
اطبع("")

اطبع("[نواة] دورة 1 — خمول")
متغير وضع1 = منفذ_اقرأ(0x64)
اطبع("  لوحة المفاتيح: " + وضع1)
منفذ_اكتب(0x20, 0x20)
توقف()

اطبع("[نواة] دورة 2 — خمول")
متغير وضع2 = منفذ_اقرأ(0x64)
اطبع("  لوحة المفاتيح: " + وضع2)
منفذ_اكتب(0x20, 0x20)
توقف()

اطبع("[نواة] دورة 3 — خمول")
متغير وضع3 = منفذ_اقرأ(0x64)
اطبع("  لوحة المفاتيح: " + وضع3)
منفذ_اكتب(0x20, 0x20)
توقف()

اطبع("")
اطبع("========================================")
اطبع("    انتهت محاكاة Sad OS بنجاح!")
اطبع("========================================")
نهاية