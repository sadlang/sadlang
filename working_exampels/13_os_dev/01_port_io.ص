# ===================================================================
# مثال 1: عمليات المنافذ — قراءة وكتابة أجهزة الإدخال/الإخراج
# Example 1: Port I/O — Reading and Writing Hardware Ports
# ===================================================================

متغير منفذ_لوحة = 0x60
متغير منفذ_وضع_لوحة = 0x64
متغير منفذ_PIC = 0x20

اطبع("=== عمليات المنافذ ===")

اطبع("إرسال أمر EOI:")
منفذ_اكتب(منفذ_PIC, 0x20)

اطبع("قراءة وضع لوحة المفاتيح:")
متغير وضع_لوحة = منفذ_اقرأ(منفذ_وضع_لوحة)
اطبع("الوضع: " + وضع_لوحة)

اطبع("قراءة رمز المفتاح:")
متغير رمز = منفذ_اقرأ(منفذ_لوحة)
اطبع("الرمز: " + رمز)

اطبع("إعداد المؤقت PIT:")
متغير مقسم = 1193180 / 100
منفذ_اكتب(0x43, 0x36)
منفذ_اكتب(0x40, مقسم % 256)
منفذ_اكتب(0x40, مقسم / 256)
اطبع("تم إعداد المؤقت")

اطبع("=== انتهى مثال المنافذ ===")
