دالة رقم اصدار_اكبر(رقم ا، رقم ب)
    متغير نتيجة = 0
    إذا (ا > ب)
        نتيجة = 1
    نهاية
    ارجع نتيجة
نهاية

دالة رقم اصدار_متوافق(رقم مطلوب، رقم متوفر)
    # ^ (caret) compatibility: same major, >= required
    رقم ر_مطلوب = اصدار_رئيسي(مطلوب)
    رقم ر_متوفر = اصدار_رئيسي(متوفر)
    متغير نتيجة = 0
    إذا (ر_مطلوب == ر_متوفر)
        إذا (متوفر >= مطلوب)
            نتيجة = 1
        نهاية
    نهاية
    ارجع نتيجة
نهاية

دالة رقم اصدار_متوافق_صارم(رقم مطلوب، رقم متوفر)
    # ~ (tilde) compatibility: same major.minor, >= required
    رقم ر_مطلوب = اصدار_رئيسي(مطلوب)
    رقم ر_متوفر = اصدار_رئيسي(متوفر)
    رقم ف_مطلوب = اصدار_فرعي(مطلوب)
    رقم ف_متوفر = اصدار_فرعي(متوفر)
    متغير نتيجة = 0
    إذا (ر_مطلوب == ر_متوفر)
        إذا (ف_مطلوب == ف_متوفر)
            إذا (متوفر >= مطلوب)
                نتيجة = 1
            نهاية
        نهاية
    نهاية
    ارجع نتيجة
نهاية

دالة فحص_توافقات()
    عنوان_رئيسي("اختبار توافق الإصدارات")

    عنوان_فرعي("التوافق المرن (^)")
    # ^2.1.0 => أي 2.x.y حيث x.y >= 1.0
    رقم مطلوب1 = تكوين_اصدار(2, 1, 0)
    رقم متوفر1_أ = تكوين_اصدار(2, 3, 5)
    رقم متوفر1_ب = تكوين_اصدار(3, 0, 0)
    رقم متوفر1_ج = تكوين_اصدار(2, 0, 9)

    اطبع("    ^2.1.0 مع 2.3.5: ")
    إذا (اصدار_متوافق(مطلوب1, متوفر1_أ) == 1)
        اطبع_سطر("✅ متوافق")
    وإلا
        اطبع_سطر("❌ غير متوافق")
    نهاية

    اطبع("    ^2.1.0 مع 3.0.0: ")
    إذا (اصدار_متوافق(مطلوب1, متوفر1_ب) == 1)
        اطبع_سطر("✅ متوافق")
    وإلا
        اطبع_سطر("❌ غير متوافق (إصدار رئيسي مختلف)")
    نهاية

    اطبع("    ^2.1.0 مع 2.0.9: ")
    إذا (اصدار_متوافق(مطلوب1, متوفر1_ج) == 1)
        اطبع_سطر("✅ متوافق")
    وإلا
        اطبع_سطر("❌ غير متوافق (أقل من المطلوب)")
    نهاية

    عنوان_فرعي("التوافق الصارم (~)")
    # ~1.3.5 => أي 1.3.x حيث x >= 5
    رقم مطلوب2 = تكوين_اصدار(1, 3, 5)
    رقم متوفر2_أ = تكوين_اصدار(1, 3, 8)
    رقم متوفر2_ب = تكوين_اصدار(1, 4, 0)

    اطبع("    ~1.3.5 مع 1.3.8: ")
    إذا (اصدار_متوافق_صارم(مطلوب2, متوفر2_أ) == 1)
        اطبع_سطر("✅ متوافق")
    وإلا
        اطبع_سطر("❌ غير متوافق")
    نهاية

    اطبع("    ~1.3.5 مع 1.4.0: ")
    إذا (اصدار_متوافق_صارم(مطلوب2, متوفر2_ب) == 1)
        اطبع_سطر("✅ متوافق")
    وإلا
        اطبع_سطر("❌ غير متوافق (فرعي مختلف)")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# القسم 4: كشف التبعيات الدائرية
# ═══════════════════════════════════════════════════════

# نستخدم أرقاماً لتمثيل الحزم:
# 1=رياضيات, 2=هندسة, 3=فيزياء, 4=إحصاء, 5=رسم

# مصفوفة التبعيات (محاكاة):
# رياضيات → هندسة
# هندسة → رسم
# رسم → رياضيات (حلقة!)
# فيزياء → رياضيات
# إحصاء → رياضيات

دالة نص اسم_حزمة_رقم(رقم رمز)
    متغير نتيجة = "مجهولة"
    طابق رمز
        حالة 1: نتيجة = "رياضيات"
        حالة 2: نتيجة = "هندسة"
        حالة 3: نتيجة = "فيزياء"
        حالة 4: نتيجة = "إحصاء"
        حالة 5: نتيجة = "رسم"
    نهاية
    ارجع نتيجة
نهاية

# تتبع الزيارة: 0=غير مزار، 1=قيد الزيارة، 2=مكتمل
دالة رقم تبعية_مباشرة(رقم حزمة)
    # ترجع رمز التبعية المباشرة (0 إذا لا تبعية)
    متغير نتيجة = 0
    طابق حزمة
        حالة 1: نتيجة = 2    # رياضيات → هندسة
        حالة 2: نتيجة = 5    # هندسة → رسم
        حالة 3: نتيجة = 1    # فيزياء → رياضيات
        حالة 4: نتيجة = 1    # إحصاء → رياضيات
        حالة 5: نتيجة = 1    # رسم → رياضيات (حلقة!)
    نهاية
    ارجع نتيجة
نهاية

دالة كشف_حلقات()
    عنوان_رئيسي("كشف التبعيات الدائرية")

    عنوان_فرعي("خريطة التبعيات")
    اطبع_سطر("    رياضيات ──→ هندسة")
    اطبع_سطر("    هندسة ────→ رسم")
    اطبع_سطر("    رسم ──────→ رياضيات ⟲ (حلقة!)")
    اطبع_سطر("    فيزياء ───→ رياضيات")
    اطبع_سطر("    إحصاء ───→ رياضيات")

    عنوان_فرعي("تتبع المسار (DFS)")

    # تتبع المسار: رياضيات → هندسة → رسم → رياضيات!
    اطبع_سطر("    🔍 بدء من: رياضيات")
    اطبع_سطر("    │ زيارة: رياضيات [قيد المعالجة]")
    اطبع_سطر("    │ ↓")
    اطبع_سطر("    │ زيارة: هندسة [قيد المعالجة]")
    اطبع_سطر("    │ ↓")
    اطبع_سطر("    │ زيارة: رسم [قيد المعالجة]")
    اطبع_سطر("    │ ↓")
    اطبع_سطر("    │ ⟲ رياضيات [قيد المعالجة] ← اكتُشفت حلقة!")
    اطبع_سطر("")
    نتيجة_فشل("اكتُشفت تبعية دائرية: رياضيات → هندسة → رسم → رياضيات")
    تحذير("يجب كسر الحلقة لإكمال التثبيت")

    # فحص المسارات الآمنة
    عنوان_فرعي("المسارات الآمنة")
    اطبع_سطر("    🔍 فيزياء → رياضيات (لا حلقة)")
    نتيجة_نجاح("فيزياء: سلسلة تبعيات آمنة")
    اطبع_سطر("    🔍 إحصاء → رياضيات (لا حلقة)")
    نتيجة_نجاح("إحصاء: سلسلة تبعيات آمنة")
نهاية

