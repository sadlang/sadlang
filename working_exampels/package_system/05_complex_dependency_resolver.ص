# القسم 2: دوال الإصدار الدلالي (Semantic Versioning)
# ═══════════════════════════════════════════════════════

دالة رقم اصدار_رئيسي(رقم اصدار)
    ارجع اصدار / 10000
نهاية

دالة رقم اصدار_فرعي(رقم اصدار)
    ارجع (اصدار / 100) - (اصدار_رئيسي(اصدار) * 100)
نهاية

دالة رقم اصدار_تصحيح(رقم اصدار)
    ارجع اصدار - (اصدار / 100) * 100
نهاية

دالة رقم تكوين_اصدار(رقم رئيسي، رقم فرعي، رقم تصحيح)
    ارجع رئيسي * 10000 + فرعي * 100 + تصحيح
نهاية

دالة عرض_اصدار_مفصل(نص حزمة، رقم اصدار)
    رقم ر = اصدار_رئيسي(اصدار)
    رقم ف = اصدار_فرعي(اصدار)
    رقم ت = اصدار_تصحيح(اصدار)
    اطبع("    ")
    اطبع(حزمة)
    اطبع(" → v")
    اطبع(ر)
    اطبع(".")
    اطبع(ف)
    اطبع(".")
    اطبع(ت)
    اطبع(" (رئيسي=")
    اطبع(ر)
    اطبع(" فرعي=")
    اطبع(ف)
    اطبع(" تصحيح=")
    اطبع(ت)
    اطبع_سطر(")")
نهاية

