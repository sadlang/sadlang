دالة رقم بصمة_بسيطة(رقم اصدار، رقم حجم_ملف)
    # حساب بصمة بسيطة من الإصدار والحجم
    ارجع (اصدار * 31 + حجم_ملف * 17) - ((اصدار * 31 + حجم_ملف * 17) / 10000) * 10000
