    اطبع_سطر("    📚 توليد توثيق مكتبة_رياضيات...")
    اطبع_سطر("")

    عرض_توثيق_دالة("جمع(أ، ب)", "جمع عددين", "رقم أ، رقم ب", "رقم")
    عرض_توثيق_دالة("طرح(أ، ب)", "طرح عددين", "رقم أ، رقم ب", "رقم")
    عرض_توثيق_دالة("ضرب(أ، ب)", "ضرب عددين", "رقم أ، رقم ب", "رقم")
    عرض_توثيق_دالة("قسمة_آمنة(أ، ب)", "قسمة مع حماية من الصفر", "رقم أ، رقم ب", "رقم")
    عرض_توثيق_دالة("قوة(أ، ن)", "رفع عدد لقوة", "رقم أ، رقم ن", "رقم")
    عرض_توثيق_دالة("مضروب(ن)", "حساب المضروب", "رقم ن", "رقم")

    حقل_رقمي("دوال موثقة", 6)
    حقل("تنسيق الإخراج", "HTML + Markdown")
نهاية

