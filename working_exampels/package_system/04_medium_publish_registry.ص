دالة خط_عريض()
    اطبع_سطر("══════════════════════════════════════════════")
نهاية

دالة خط()
    اطبع_سطر("──────────────────────────────────────────────")
نهاية

دالة عنوان(نص ع)
    اطبع_سطر("")
    خط_عريض()
    اطبع("  🚀 ")
    اطبع_سطر(ع)
    خط_عريض()
