# القسم 2: فحوصات ما قبل النشر
# ═══════════════════════════════════════════════════════

دالة رقم فحص_اسم(نص حزمة)
    # التحقق من أن الاسم غير فارغ وصالح
    متغير نتيجة = 1
    إذا (حزمة == "")
        نتيجة = 0
    نهاية
    ارجع نتيجة
نهاية

دالة رقم فحص_اصدار(رقم رئيسي، رقم فرعي، رقم تصحيح)
    # التحقق من أن الإصدار صالح (غير سلبي)
    متغير نتيجة = 1
    إذا (رئيسي < 0)
        نتيجة = 0
    نهاية
    إذا (فرعي < 0)
        نتيجة = 0
    نهاية
    إذا (تصحيح < 0)
        نتيجة = 0
    نهاية
    ارجع نتيجة
نهاية

دالة رقم فحص_رخصة(نص رخصة)
    متغير نتيجة = 0
    طابق رخصة
        حالة "MIT": نتيجة = 1
        حالة "Apache-2.0": نتيجة = 1
        حالة "GPL-3.0": نتيجة = 1
        حالة "BSD-3": نتيجة = 1
        حالة _: نتيجة = 0
    نهاية
    ارجع نتيجة
نهاية

دالة فحوصات_نشر()
    عنوان_قسم("فحوصات ما قبل النشر")

    متغير نقاط = 0
    متغير اجمالي = 7

    # فحص 1: الاسم
    اطبع("    [1/7] فحص اسم الحزمة... ")
    إذا (فحص_اسم("مكتبة_رياضيات") == 1)
        اطبع_سطر("✅ صالح")
        نقاط = نقاط + 1
    وإلا
        اطبع_سطر("❌ فارغ أو غير صالح")
    نهاية

    # فحص 2: الإصدار
    اطبع("    [2/7] فحص الإصدار الدلالي... ")
    إذا (فحص_اصدار(2, 1, 0) == 1)
        اطبع_سطر("✅ 2.1.0 صالح")
        نقاط = نقاط + 1
    وإلا
        اطبع_سطر("❌ إصدار غير صالح")
    نهاية

    # فحص 3: الرخصة
    اطبع("    [3/7] فحص الرخصة... ")
    إذا (فحص_رخصة("MIT") == 1)
        اطبع_سطر("✅ MIT معتمدة")
        نقاط = نقاط + 1
    وإلا
        اطبع_سطر("❌ رخصة غير معتمدة")
    نهاية

    # فحص 4: الوصف
    اطبع("    [4/7] فحص الوصف... ")
    اطبع_سطر("✅ موجود (30 حرف)")
    نقاط = نقاط + 1

    # فحص 5: الاختبارات
    اطبع("    [5/7] تشغيل الاختبارات... ")
    اطبع_سطر("✅ 24/24 نجحت")
    نقاط = نقاط + 1

    # فحص 6: البناء
    اطبع("    [6/7] بناء الحزمة... ")
    اطبع_سطر("✅ بناء ناجح")
    نقاط = نقاط + 1

    # فحص 7: التوثيق
    اطبع("    [7/7] فحص التوثيق... ")
    اطبع_سطر("✅ 12 دالة موثقة")
    نقاط = نقاط + 1

    اطبع_سطر("")
    اطبع("    النتيجة: ")
    اطبع(نقاط)
    اطبع("/")
    اطبع(اجمالي)

    إذا (نقاط == اجمالي)
        اطبع_سطر(" - جاهزة للنشر! 🎉")
    وإلا
        اطبع_سطر(" - يلزم إصلاح المشاكل")
    نهاية
نهاية

