# =====================================================================================
# مثال معقد 2: سجل الحزم المركزي مع البحث والتقييم
# =====================================================================================
# الهدف: محاكاة سجل حزم مركزي كامل مع بحث وتقييم وإحصاءات
# المستوى: معقد (+350 سطر)
# الميزات: Package Registry, Search, Rating, Statistics, Security Audit
# =====================================================================================

# ═══════════════════════════════════════════════════════
# القسم 1: دوال العرض المساعدة
# ═══════════════════════════════════════════════════════

دالة خط_عريض()
    اطبع_سطر("══════════════════════════════════════════════════════════")
نهاية

دالة خط_رفيع()
    اطبع_سطر("──────────────────────────────────────────────────────────")
نهاية

دالة خط_نجوم()
    اطبع_سطر("★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★")
نهاية

دالة عنوان(نص ع)
    اطبع_سطر("")
    خط_عريض()
    اطبع("  🏪 ")
    اطبع_سطر(ع)
    خط_عريض()
نهاية

دالة قسم_فرعي(نص ع)
    اطبع_سطر("")
    خط_رفيع()
    اطبع("  ▸ ")
    اطبع_سطر(ع)
    خط_رفيع()
نهاية

دالة حقل(نص مفتاح، نص قيمة)
    اطبع("    ")
    اطبع(مفتاح)
    اطبع(": ")
    اطبع_سطر(قيمة)
نهاية

دالة حقل_رقمي(نص مفتاح، رقم قيمة)
    اطبع("    ")
    اطبع(مفتاح)
    اطبع(": ")
    اطبع_سطر(قيمة)
نهاية

# ═══════════════════════════════════════════════════════
# القسم 2: دوال حسابية مساعدة
# ═══════════════════════════════════════════════════════

دالة رقم القيمة_المطلقة(رقم ق)
    متغير نتيجة = ق
    إذا (ق < 0)
        نتيجة = 0 - ق
    نهاية
    ارجع نتيجة
نهاية

دالة رقم اكبر_عددين(رقم ا، رقم ب)
    متغير نتيجة = ب
    إذا (ا > ب)
        نتيجة = ا
    نهاية
    ارجع نتيجة
نهاية

دالة رقم اصغر_عددين(رقم ا، رقم ب)
    متغير نتيجة = ب
    إذا (ا < ب)
        نتيجة = ا
    نهاية
    ارجع نتيجة
نهاية

دالة رقم باقي(رقم ا، رقم ب)
    ارجع ا - (ا / ب) * ب
نهاية

دالة رقم قوة(رقم اساس، رقم اس)
    متغير نتيجة = 1
    متغير عد = 0
    بينما (عد < اس)
        نتيجة = نتيجة * اساس
        عد = عد + 1
    نهاية
    ارجع نتيجة
نهاية

# ═══════════════════════════════════════════════════════
# القسم 3: نظام التقييم
# ═══════════════════════════════════════════════════════

دالة نص نجوم_تقييم(رقم تقييم)
    # التقييم من 1-5
    متغير نتيجة = "☆☆☆☆☆"
    طابق تقييم
        حالة 1: نتيجة = "★☆☆☆☆"
        حالة 2: نتيجة = "★★☆☆☆"
        حالة 3: نتيجة = "★★★☆☆"
        حالة 4: نتيجة = "★★★★☆"
        حالة 5: نتيجة = "★★★★★"
    نهاية
    ارجع نتيجة
نهاية

دالة نص مستوى_شعبية(رقم تنزيلات)
    متغير نتيجة = "غير معروفة"
    إذا (تنزيلات >= 10000)
        نتيجة = "🔥 شائعة جداً"
    وإلا إذا (تنزيلات >= 5000)
        نتيجة = "⭐ شائعة"
    وإلا إذا (تنزيلات >= 1000)
        نتيجة = "📈 متنامية"
    وإلا إذا (تنزيلات >= 100)
        نتيجة = "🌱 جديدة"
    وإلا
        نتيجة = "🔬 تجريبية"
    نهاية
    ارجع نتيجة
نهاية

# ═══════════════════════════════════════════════════════
# القسم 4: بطاقات الحزم
# ═══════════════════════════════════════════════════════

دالة عرض_حزمة(نص حزمة، نص اصدار، نص وصف، نص مؤلف، رقم تقييم، رقم تنزيلات، نص رخصة)
    اطبع_سطر("")
    اطبع("    ┌─────────────────────────────────────────┐")
    اطبع_سطر("")
    اطبع("    │ 📦 ")
    اطبع(حزمة)
    اطبع("@")
    اطبع_سطر(اصدار)
    اطبع("    │ ")
    اطبع_سطر(وصف)
    اطبع("    │ المؤلف: ")
    اطبع_سطر(مؤلف)
    اطبع("    │ التقييم: ")
    اطبع(نجوم_تقييم(تقييم))
    اطبع(" (")
    اطبع(تقييم)
    اطبع_سطر("/5)")
    اطبع("    │ التنزيلات: ")
    اطبع(تنزيلات)
    اطبع(" ")
    اطبع_سطر(مستوى_شعبية(تنزيلات))
    اطبع("    │ الرخصة: ")
    اطبع_سطر(رخصة)
    اطبع("    └─────────────────────────────────────────┘")
    اطبع_سطر("")
نهاية

دالة عرض_سجل_حزم()
    عنوان("سجل حزم ص المركزي")

    عرض_حزمة("رياضيات", "2.3.0", "مكتبة رياضيات عربية شاملة", "فريق ص", 5, 15420, "MIT")
    عرض_حزمة("شبكة", "1.0.0", "مكتبة شبكات وبروتوكولات", "أحمد محمد", 4, 8750, "Apache-2.0")
    عرض_حزمة("واجهة", "3.5.1", "إطار واجهات مستخدم عربي", "سارة علي", 5, 12300, "MIT")
    عرض_حزمة("قاعدة_بيانات", "2.0.0", "واجهة قواعد بيانات موحدة", "خالد حسن", 3, 4200, "GPL-3.0")
    عرض_حزمة("تشفير", "1.2.5", "خوارزميات تشفير آمنة", "نورة أحمد", 4, 6800, "BSD-3")
نهاية

# ═══════════════════════════════════════════════════════
# القسم 5: البحث في السجل
# ═══════════════════════════════════════════════════════

دالة رقم درجة_ملاءمة(رقم تقييم، رقم تنزيلات، رقم اصدارات)
    # خوارزمية ترتيب البحث
    رقم نقاط_تقييم = تقييم * 200
    رقم نقاط_شعبية = تنزيلات / 10
    رقم نقاط_نشاط = اصدارات * 50
    ارجع نقاط_تقييم + نقاط_شعبية + نقاط_نشاط
نهاية

دالة بحث_حزم()
    عنوان("البحث: \"رياضيات عربية\"")

    اطبع_سطر("    ⏳ جاري البحث في السجل...")
    اطبع_سطر("    📊 تم العثور على 5 نتائج:")
    اطبع_سطر("")

    # حساب درجات الملاءمة
    رقم درجة1 = درجة_ملاءمة(5, 15420, 12)
    رقم درجة2 = درجة_ملاءمة(4, 8750, 8)
    رقم درجة3 = درجة_ملاءمة(3, 4200, 5)
    رقم درجة4 = درجة_ملاءمة(4, 2100, 3)
    رقم درجة5 = درجة_ملاءمة(2, 500, 2)

    اطبع("    1. رياضيات (ملاءمة: ")
    اطبع(درجة1)
    اطبع_سطر(")")
    حقل("  ", "مكتبة رياضيات عربية شاملة - جبر وهندسة وإحصاء")

    اطبع("    2. حساب_متقدم (ملاءمة: ")
    اطبع(درجة2)
    اطبع_سطر(")")
    حقل("  ", "حسابات متقدمة ومعادلات تفاضلية")

    اطبع("    3. هندسة (ملاءمة: ")
    اطبع(درجة3)
    اطبع_سطر(")")
    حقل("  ", "هندسة تحليلية ورسم بياني")

    اطبع("    4. إحصاء_عربي (ملاءمة: ")
    اطبع(درجة4)
    اطبع_سطر(")")
    حقل("  ", "تحليل إحصائي باللغة العربية")

    اطبع("    5. أرقام (ملاءمة: ")
    اطبع(درجة5)
    اطبع_سطر(")")
    حقل("  ", "تحويل الأرقام العربية والهندية")
نهاية

# ═══════════════════════════════════════════════════════
# القسم 6: فحص الأمان
# ═══════════════════════════════════════════════════════

دالة نص مستوى_خطورة(رقم مستوى)
    متغير نتيجة = "معلومات"
    طابق مستوى
        حالة 1: نتيجة = "ℹ معلومات"
        حالة 2: نتيجة = "⚠ منخفض"
        حالة 3: نتيجة = "⚠ متوسط"
        حالة 4: نتيجة = "🔴 عالي"
        حالة 5: نتيجة = "🚨 حرج"
    نهاية
    ارجع نتيجة
نهاية

دالة فحص_امان()
    عنوان("فحص أمان التبعيات")

    اطبع_سطر("    ⏳ جاري فحص الثغرات المعروفة...")
    اطبع_سطر("")

    # تقرير الثغرات
    اطبع_سطر("    📋 نتائج الفحص:")
    اطبع_سطر("")

    اطبع("    [1] شبكة@0.9.2 → ")
    اطبع_سطر(مستوى_خطورة(4))
    حقل("   الوصف", "ثغرة في معالجة HTTP headers")
    حقل("   الحل", "تحديث إلى 1.0.0+")
    اطبع_سطر("")

    اطبع("    [2] تشفير@1.2.5 → ")
    اطبع_سطر(مستوى_خطورة(3))
    حقل("   الوصف", "خوارزمية MD5 غير آمنة")
    حقل("   الحل", "استخدام SHA-256 بدلاً")
    اطبع_سطر("")

    اطبع("    [3] قاعدة_بيانات@2.0.0 → ")
    اطبع_سطر(مستوى_خطورة(2))
    حقل("   الوصف", "SQL injection محتمل في استعلامات خام")
    حقل("   الحل", "استخدام استعلامات محضرة")
    اطبع_سطر("")

    # ملخص
    قسم_فرعي("ملخص الفحص الأمني")
    حقل_رقمي("حزم فُحصت", 5)
    حقل_رقمي("ثغرات حرجة", 0)
    حقل_رقمي("ثغرات عالية", 1)
    حقل_رقمي("ثغرات متوسطة", 1)
    حقل_رقمي("ثغرات منخفضة", 1)
    اطبع_سطر("")
    اطبع_سطر("    💡 شغّل: ص حارس --إصلاح-تلقائي")
نهاية

# ═══════════════════════════════════════════════════════
# القسم 7: إحصائيات السجل العامة
# ═══════════════════════════════════════════════════════

دالة احصائيات_سجل()
    عنوان("إحصائيات سجل ص المركزي")

    حقل_رقمي("إجمالي الحزم المنشورة", 1247)
    حقل_رقمي("إجمالي التنزيلات هذا الشهر", 89500)
    حقل_رقمي("مطورون نشطون", 342)
    حقل_رقمي("حزم جديدة هذا الأسبوع", 23)
    اطبع_سطر("")

    قسم_فرعي("أكثر الحزم تنزيلاً")
    اطبع_سطر("    🥇 رياضيات     - 15,420 تنزيل")
    اطبع_سطر("    🥈 واجهة       - 12,300 تنزيل")
    اطبع_سطر("    🥉 شبكة        - 8,750 تنزيل")
    اطبع_سطر("    4. تشفير       - 6,800 تنزيل")
    اطبع_سطر("    5. قاعدة_بيانات - 4,200 تنزيل")

    قسم_فرعي("التصنيفات الشائعة")
    متغير عد = 1
    بينما (عد <= 8)
        طابق عد
            حالة 1: اطبع_سطر("    📊 رياضيات وحساب (187 حزمة)")
            حالة 2: اطبع_سطر("    🌐 شبكات وويب (145 حزمة)")
            حالة 3: اطبع_سطر("    🎨 واجهات مستخدم (132 حزمة)")
            حالة 4: اطبع_سطر("    🗃 قواعد بيانات (98 حزمة)")
            حالة 5: اطبع_سطر("    🔐 أمان وتشفير (87 حزمة)")
            حالة 6: اطبع_سطر("    📝 نصوص ومعالجة (76 حزمة)")
            حالة 7: اطبع_سطر("    🧪 اختبارات (65 حزمة)")
            حالة 8: اطبع_سطر("    📦 أدوات بناء (54 حزمة)")
        نهاية
        عد = عد + 1
    نهاية

    قسم_فرعي("الرخص المستخدمة")
    اطبع_سطر("    MIT          ████████████████░░░░ 62%")
    اطبع_سطر("    Apache-2.0   ████████░░░░░░░░░░░░ 21%")
    اطبع_سطر("    GPL-3.0      ████░░░░░░░░░░░░░░░░ 11%")
    اطبع_سطر("    BSD-3        ██░░░░░░░░░░░░░░░░░░  6%")
نهاية

# ═══════════════════════════════════════════════════════
# القسم 8: تقرير صحة المشروع
# ═══════════════════════════════════════════════════════

دالة رقم نقاط_صحة(رقم تبعيات_محدثة، رقم تبعيات_كلية، رقم ثغرات، رقم اختبارات_ناجحة، رقم اختبارات_كلية)
    رقم نسبة_تحديث = (تبعيات_محدثة * 100) / تبعيات_كلية
    رقم نقاط_امان = 100 - (ثغرات * 15)
    رقم نسبة_اختبار = (اختبارات_ناجحة * 100) / اختبارات_كلية
    ارجع (نسبة_تحديث + نقاط_امان + نسبة_اختبار) / 3
نهاية

دالة نص تصنيف_صحة(رقم نقاط)
    متغير نتيجة = "❌ ضعيف"
    إذا (نقاط >= 90)
        نتيجة = "🟢 ممتاز"
    وإلا إذا (نقاط >= 75)
        نتيجة = "🟡 جيد"
    وإلا إذا (نقاط >= 60)
        نتيجة = "🟠 متوسط"
    وإلا إذا (نقاط >= 40)
        نتيجة = "🔴 ضعيف"
    نهاية
    ارجع نتيجة
نهاية

دالة تقرير_صحة()
    عنوان("تقرير صحة المشروع")

    رقم نقاط = نقاط_صحة(4, 5, 2, 22, 24)

    اطبع("    النتيجة الإجمالية: ")
    اطبع(نقاط)
    اطبع("/100 ")
    اطبع_سطر(تصنيف_صحة(نقاط))
    اطبع_سطر("")

    اطبع_سطر("    التفاصيل:")
    اطبع_سطر("    ├── التبعيات: 4/5 محدثة (80%)")
    اطبع_سطر("    ├── الأمان: 2 ثغرات (70/100)")
    اطبع_سطر("    ├── الاختبارات: 22/24 ناجحة (91%)")
    اطبع_سطر("    └── التوثيق: 12/15 دوال موثقة (80%)")

    اطبع_سطر("")
    اطبع_سطر("    💡 توصيات:")
    اطبع_سطر("    1. حدّث شبكة إلى 1.0.0 لإصلاح الثغرة الأمنية")
    اطبع_سطر("    2. أصلح اختبارَين فاشلين في وحدة التحويل")
    اطبع_سطر("    3. وثّق 3 دوال إضافية")
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════════════════╗")
    اطبع_سطر("║  🏪 سجل حزم ص المركزي - بحث وتقييم وأمان              ║")
    اطبع_سطر("╚══════════════════════════════════════════════════════════╝")

    عرض_سجل_حزم()
    بحث_حزم()
    فحص_امان()
    احصائيات_سجل()
    تقرير_صحة()

    اطبع_سطر("")
    خط_عريض()
    اطبع_سطر("  ✅ اكتمل تقرير سجل الحزم بنجاح")
    خط_عريض()
    ارجع 0
نهاية
