# ═══════════════════════════════════════════════════════
# دوال العرض
# ═══════════════════════════════════════════════════════

دالة خط()
    اطبع_سطر("────────────────────────────────────────")
نهاية

دالة عنوان(نص ع)
    اطبع_سطر("")
    خط()
    اطبع("  📋 ")
    اطبع_سطر(ع)
    خط()
نهاية

# ═══════════════════════════════════════════════════════
# محاكاة حالات التبعيات
# ═══════════════════════════════════════════════════════

# حالة التبعية: 1=مثبتة، 2=قديمة، 3=مفقودة
دالة نص حالة_تبعية(رقم وضع)
    متغير نتيجة = "غير معروفة"
    طابق وضع
        حالة 1: نتيجة = "✅ مثبتة ومحدثة"
        حالة 2: نتيجة = "⚠️ مثبتة لكن قديمة"
        حالة 3: نتيجة = "❌ غير مثبتة"
    نهاية
    ارجع نتيجة
نهاية

دالة نص اجراء_مطلوب(رقم وضع)
    متغير نتيجة = "لا شيء"
    طابق وضع
        حالة 1: نتيجة = "لا يلزم إجراء"
        حالة 2: نتيجة = "يلزم تحديث"
        حالة 3: نتيجة = "يلزم تنزيل"
    نهاية
    ارجع نتيجة
نهاية

# ═══════════════════════════════════════════════════════
# فحص التبعيات
# ═══════════════════════════════════════════════════════

دالة فحص_تبعية(نص حزمة، نص اصدار، رقم وضع)
    اطبع("    ")
    اطبع(حزمة)
    اطبع(" (")
    اطبع(اصدار)
    اطبع(") → ")
    اطبع_سطر(حالة_تبعية(وضع))
    اطبع("      الإجراء: ")
    اطبع_سطر(اجراء_مطلوب(وضع))
نهاية

دالة رقم عدد_مشاكل(رقم ح1، رقم ح2، رقم ح3، رقم ح4، رقم ح5)
    متغير مشاكل = 0
    إذا (ح1 != 1)
        مشاكل = مشاكل + 1
    نهاية
    إذا (ح2 != 1)
        مشاكل = مشاكل + 1
    نهاية
    إذا (ح3 != 1)
        مشاكل = مشاكل + 1
    نهاية
    إذا (ح4 != 1)
        مشاكل = مشاكل + 1
    نهاية
    إذا (ح5 != 1)
        مشاكل = مشاكل + 1
    نهاية
    ارجع مشاكل
نهاية

# ═══════════════════════════════════════════════════════
# محاكاة ملف القفل ص.قفل
# ═══════════════════════════════════════════════════════

دالة عرض_ملف_قفل()
    عنوان("محتوى ملف القفل ص.قفل")
    اطبع_سطر("  # هذا الملف يُولَّد تلقائياً - لا تعدله يدوياً")
    اطبع_سطر("")

    اطبع_سطر("  [[حزمة]]")
    اطبع_سطر("    الاسم = \"رياضيات\"")
    اطبع_سطر("    الإصدار = \"2.1.0\"")
    اطبع_سطر("    المصدر = \"سجل:ص\"")
    اطبع_سطر("    بصمة = \"abc123\"")
    اطبع_سطر("")

    اطبع_سطر("  [[حزمة]]")
    اطبع_سطر("    الاسم = \"نصوص\"")
    اطبع_سطر("    الإصدار = \"1.3.5\"")
    اطبع_سطر("    المصدر = \"سجل:ص\"")
    اطبع_سطر("    بصمة = \"def456\"")
    اطبع_سطر("")

    اطبع_سطر("  [[حزمة]]")
    اطبع_سطر("    الاسم = \"شبكة\"")
    اطبع_سطر("    الإصدار = \"0.9.2\"")
    اطبع_سطر("    المصدر = \"محلي:مسار\"")
    اطبع_سطر("    بصمة = \"ghi789\"")
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔════════════════════════════════════════╗")
    اطبع_سطر("║  📦 ص أضف - فحص التبعيات              ║")
    اطبع_سطر("╚════════════════════════════════════════╝")

    عنوان("فحص تبعيات المشروع")

    # محاكاة حالات مختلفة
    رقم ح_رياضيات = 1    # مثبتة
    رقم ح_نصوص = 2       # قديمة
    رقم ح_شبكة = 3       # مفقودة
    رقم ح_ملفات = 1      # مثبتة
    رقم ح_ترميز = 2      # قديمة

    فحص_تبعية("رياضيات", "2.1.0", ح_رياضيات)
    اطبع_سطر("")
    فحص_تبعية("نصوص", "1.3.5", ح_نصوص)
    اطبع_سطر("")
    فحص_تبعية("شبكة", "0.9.2", ح_شبكة)
    اطبع_سطر("")
    فحص_تبعية("ملفات", "1.0.0", ح_ملفات)
    اطبع_سطر("")
    فحص_تبعية("ترميز", "3.2.1", ح_ترميز)

    # ملخص
    عنوان("ملخص الفحص")
    رقم مشاكل = عدد_مشاكل(ح_رياضيات، ح_نصوص، ح_شبكة، ح_ملفات، ح_ترميز)
    اطبع("    إجمالي التبعيات: ")
    اطبع_سطر(5)
    اطبع("    تبعيات بها مشاكل: ")
    اطبع_سطر(مشاكل)
    اطبع("    تبعيات سليمة: ")
    اطبع_سطر(5 - مشاكل)

    إذا (مشاكل == 0)
        اطبع_سطر("    ✅ جميع التبعيات محدثة!")
    وإلا
        اطبع_سطر("    ⚠️ يلزم تشغيل: ص تحديث")
    نهاية

    عرض_ملف_قفل()

    اطبع_سطر("")
    خط()
    اطبع_سطر("  ✅ تم فحص التبعيات بنجاح")
    خط()
    ارجع 0
نهاية
