دالة نص حالة_تحديث(رقم قديم، رقم اصدار_جديد)
    متغير نتيجة = "لا تحديث"
    إذا (اصدار_جديد > قديم)
        نتيجة = "⬆ تحديث متوفر"
    وإلا إذا (اصدار_جديد == قديم)
        نتيجة = "✅ محدثة"
    نهاية
    ارجع نتيجة
نهاية

دالة فحص_تحديثات()
    عنوان_قسم("فحص التحديثات المتوفرة")
    اطبع_سطر("    ⏳ جاري فحص السجل المركزي...")
