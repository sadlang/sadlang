دالة خط_مزدوج()
    اطبع_سطر("══════════════════════════════════════════════════")
نهاية

دالة خط_بسيط()
    اطبع_سطر("──────────────────────────────────────────────────")
نهاية

دالة عنوان_قسم(نص ع)
    اطبع_سطر("")
    خط_مزدوج()
    اطبع("  📦 ")
    اطبع_سطر(ع)
    خط_مزدوج()
نهاية

دالة عنوان_فرعي(نص ع)
    اطبع_سطر("")
    خط_بسيط()
    اطبع("  ▸ ")
    اطبع_سطر(ع)
    خط_بسيط()
نهاية

دالة بيان(نص وصف، نص قيمة)
    اطبع("    ")
    اطبع(وصف)
    اطبع(": ")
    اطبع_سطر(قيمة)
نهاية

دالة بيان_رقمي(نص وصف، رقم قيمة)
    اطبع("    ")
    اطبع(وصف)
    اطبع(": ")
    اطبع_سطر(قيمة)
نهاية

