# القسم 1: حل التبعيات (Dependency Resolution)
# ═══════════════════════════════════════════════════════

# تمثيل شجرة التبعيات كأرقام ترمز لعمق التبعية
# المستوى 0 = مباشر، 1 = غير مباشر، 2 = عميق

دالة نص مستوى_تبعية(رقم مستوى)
    متغير نتيجة = "  "
    إذا (مستوى == 0)
        نتيجة = "├── "
    وإلا إذا (مستوى == 1)
        نتيجة = "│   ├── "
    وإلا إذا (مستوى == 2)
        نتيجة = "│   │   └── "
    نهاية
    ارجع نتيجة
نهاية

دالة عرض_تبعية(نص حزمة، نص اصدار، رقم مستوى)
    اطبع("    ")
    اطبع(مستوى_تبعية(مستوى))
    اطبع(حزمة)
    اطبع("@")
    اطبع_سطر(اصدار)
نهاية

دالة حل_تبعيات()
    عنوان_قسم("حل شجرة التبعيات")
    اطبع_سطر("    مشروعي@1.0.0")

    # تبعية مباشرة 1: رياضيات
    عرض_تبعية("رياضيات", "2.1.0", 0)
    عرض_تبعية("اساسيات", "1.0.0", 1)
    عرض_تبعية("ثوابت", "1.0.0", 2)

    # تبعية مباشرة 2: شبكة
    عرض_تبعية("شبكة", "0.9.2", 0)
    عرض_تبعية("بروتوكول", "1.2.0", 1)
    عرض_تبعية("ترميز", "3.0.0", 2)
    عرض_تبعية("ملفات", "1.0.0", 1)

    # تبعية مباشرة 3: واجهة
    عرض_تبعية("واجهة", "3.5.1", 0)
    عرض_تبعية("رسومات", "2.0.0", 1)
    عرض_تبعية("الوان", "1.1.0", 2)

    اطبع_سطر("")
    اطبع_سطر("    📊 إجمالي: 10 حزم (3 مباشرة + 7 غير مباشرة)")
نهاية

# ═══════════════════════════════════════════════════════
# القسم 2: كشف التعارضات
# ═══════════════════════════════════════════════════════

دالة رقم كشف_تعارض(رقم اصدار1، رقم اصدار2)
    رقم رئيسي1 = اصدار1 / 10000
    رقم رئيسي2 = اصدار2 / 10000
    متغير نتيجة = 0
    إذا (رئيسي1 != رئيسي2)
        نتيجة = 1
    نهاية
    ارجع نتيجة
نهاية

دالة فحص_تعارضات()
    عنوان_فرعي("كشف تعارضات الإصدارات")

    # فحص 1: ترميز مطلوب بإصدارين مختلفين
    رقم ترميز_من_شبكة = 30000     # 3.0.0
    رقم ترميز_من_نصوص = 30200     # 3.2.0

    اطبع("    ترميز: شبكة تطلب 3.0.0، نصوص تطلب 3.2.0 → ")
    إذا (كشف_تعارض(ترميز_من_شبكة، ترميز_من_نصوص) == 1)
        اطبع_سطر("❌ تعارض!")
    وإلا
        اطبع_سطر("✅ متوافق (نفس الإصدار الرئيسي)")
    نهاية

    # فحص 2: اساسيات مطلوب بإصدارين مختلفين
    رقم اساسيات_من_رياضيات = 10000  # 1.0.0
    رقم اساسيات_من_واجهة = 20000    # 2.0.0

    اطبع("    اساسيات: رياضيات تطلب 1.0.0، واجهة تطلب 2.0.0 → ")
    إذا (كشف_تعارض(اساسيات_من_رياضيات، اساسيات_من_واجهة) == 1)
        اطبع_سطر("❌ تعارض! (إصدارات رئيسية مختلفة)")
    وإلا
        اطبع_سطر("✅ متوافق")
    نهاية

    # فحص 3: ملفات
    رقم ملفات_من_شبكة = 10000       # 1.0.0
    رقم ملفات_من_واجهة = 10200      # 1.2.0

    اطبع("    ملفات: شبكة تطلب 1.0.0، واجهة تطلب 1.2.0 → ")
    إذا (كشف_تعارض(ملفات_من_شبكة، ملفات_من_واجهة) == 1)
        اطبع_سطر("❌ تعارض!")
    وإلا
        اطبع_سطر("✅ متوافق (نفس الإصدار الرئيسي)")
    نهاية
نهاية

