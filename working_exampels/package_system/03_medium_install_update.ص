دالة نص شريط_تقدم(رقم نسبة)
    متغير شريط = "["
    متغير عد = 0
    بينما (عد < 20)
        إذا (عد * 5 < نسبة)
            شريط = "█"
        وإلا
            شريط = "░"
        نهاية
        اطبع(شريط)
        عد = عد + 1
    نهاية
    متغير نهائي = "] "
    ارجع نهائي
نهاية

دالة تنزيل_حزمة(نص حزمة، نص اصدار، رقم حجم_ملف)
    اطبع("    ⬇ تنزيل ")
    اطبع(حزمة)
    اطبع("@")
    اطبع(اصدار)
    اطبع(" (")
    اطبع(حجم_ملف)
    اطبع_سطر(" كيلوبايت)")

    # محاكاة التنزيل بخطوات
    اطبع("      [")
    متغير خطوة = 0
    بينما (خطوة < 20)
        اطبع("█")
        خطوة = خطوة + 1
    نهاية
    اطبع_سطر("] 100%")

    اطبع("    ✅ تم تثبيت ")
    اطبع_سطر(حزمة)
نهاية

