# =============================================================
# مثال بسيط 1: معلومات الحزمة الأساسية
# =============================================================
# الهدف: محاكاة إنشاء وعرض معلومات حزمة ص.toml
# المستوى: بسيط
# الميزة: Package System (T169-T176)
# =============================================================

# ═══════════════════════════════════════════════════════
# دوال مساعدة للعرض
# ═══════════════════════════════════════════════════════

دالة خط()
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
نهاية

دالة عنوان(نص نص_عنوان)
    اطبع_سطر("")
    خط()
    اطبع("  📦 ")
    اطبع_سطر(نص_عنوان)
    خط()
نهاية

دالة حقل(نص مفتاح، نص قيمة)
    اطبع("    ")
    اطبع(مفتاح)
    اطبع(" = ")
    اطبع_سطر(قيمة)
نهاية

دالة حقل_رقم(نص مفتاح، رقم قيمة)
    اطبع("    ")
    اطبع(مفتاح)
    اطبع(" = ")
    اطبع_سطر(قيمة)
نهاية

# ═══════════════════════════════════════════════════════
# القسم 1: عرض بيانات ص.toml
# ═══════════════════════════════════════════════════════

دالة عرض_حزمة()
    عنوان("محتوى ملف ص.toml")

    اطبع_سطر("  [حزمة]")
    حقل("الاسم", "تطبيقي")
    حقل("الإصدار", "1.0.0")
    حقل("الوصف", "تطبيق عربي باستخدام لغة ص")
    حقل("المؤلف", "أحمد محمد")
    حقل("الرخصة", "MIT")
    اطبع_سطر("")

    اطبع_سطر("  [تبعيات]")
    حقل("رياضيات", "2.1.0")
    حقل("نصوص", "1.3.5")
    حقل("شبكة", "0.9.2")
نهاية

# ═══════════════════════════════════════════════════════
# القسم 2: التحقق من الإصدار الدلالي
# ═══════════════════════════════════════════════════════

دالة رقم استخرج_رئيسي(رقم اصدار)
    ارجع اصدار / 10000
نهاية

دالة رقم استخرج_فرعي(رقم اصدار)
    ارجع (اصدار / 100) - (استخرج_رئيسي(اصدار) * 100)
نهاية

دالة رقم استخرج_تصحيح(رقم اصدار)
    ارجع اصدار - (اصدار / 100) * 100
نهاية

دالة عرض_اصدار(نص حزمة، رقم اصدار)
    رقم رئيسي = استخرج_رئيسي(اصدار)
    رقم فرعي = استخرج_فرعي(اصدار)
    رقم تصحيح = استخرج_تصحيح(اصدار)

    اطبع("    ")
    اطبع(حزمة)
    اطبع(": ")
    اطبع(رئيسي)
    اطبع(".")
    اطبع(فرعي)
    اطبع(".")
    اطبع_سطر(تصحيح)
نهاية

دالة تحقق_اصدارات()
    عنوان("التحقق من الإصدارات الدلالية")

    # تمثيل الإصدارات بأرقام: major*10000 + minor*100 + patch
    رقم اصدار_رياضيات = 20100     # 2.1.0
    رقم اصدار_نصوص = 10305        # 1.3.5
    رقم اصدار_شبكة = 902          # 0.9.2

    عرض_اصدار("رياضيات", اصدار_رياضيات)
    عرض_اصدار("نصوص", اصدار_نصوص)
    عرض_اصدار("شبكة", اصدار_شبكة)
نهاية

# ═══════════════════════════════════════════════════════
# القسم 3: التحقق من توافق الإصدارات
# ═══════════════════════════════════════════════════════

دالة رقم متوافق(رقم مطلوب، رقم متوفر)
    رقم رئيسي_مطلوب = استخرج_رئيسي(مطلوب)
    رقم رئيسي_متوفر = استخرج_رئيسي(متوفر)

    # التوافق: نفس الإصدار الرئيسي والمتوفر >= المطلوب
    متغير نتيجة = 0
    إذا (رئيسي_مطلوب == رئيسي_متوفر)
        إذا (متوفر >= مطلوب)
            نتيجة = 1
        نهاية
    نهاية
    ارجع نتيجة
نهاية

دالة فحص_توافق()
    عنوان("فحص توافق الإصدارات")

    رقم مطلوب1 = 20100    # 2.1.0
    رقم متوفر1 = 20300    # 2.3.0

    اطبع("    رياضيات: مطلوب 2.1.0، متوفر 2.3.0 → ")
    إذا (متوافق(مطلوب1, متوفر1) == 1)
        اطبع_سطر("✅ متوافق")
    وإلا
        اطبع_سطر("❌ غير متوافق")
    نهاية

    رقم مطلوب2 = 10305    # 1.3.5
    رقم متوفر2 = 20000    # 2.0.0

    اطبع("    نصوص: مطلوب 1.3.5، متوفر 2.0.0 → ")
    إذا (متوافق(مطلوب2, متوفر2) == 1)
        اطبع_سطر("✅ متوافق")
    وإلا
        اطبع_سطر("❌ غير متوافق (إصدار رئيسي مختلف)")
    نهاية

    رقم مطلوب3 = 902      # 0.9.2
    رقم متوفر3 = 910      # 0.9.10

    اطبع("    شبكة: مطلوب 0.9.2، متوفر 0.9.10 → ")
    إذا (متوافق(مطلوب3, متوفر3) == 1)
        اطبع_سطر("✅ متوافق")
    وإلا
        اطبع_سطر("❌ غير متوافق")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  📦 نظام الحزم ص.toml - معلومات     ║")
    اطبع_سطر("╚══════════════════════════════════════╝")

    عرض_حزمة()
    تحقق_اصدارات()
    فحص_توافق()

    اطبع_سطر("")
    خط()
    اطبع_سطر("  ✅ تم عرض معلومات الحزمة بنجاح")
    خط()
    ارجع 0
نهاية
