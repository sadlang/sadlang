# ==============================================
# المثال 29: نظام إدارة المدرسة المتقدم
# Advanced School Management System
# ==============================================
# يوضح: OOP متقدم + وراثة + استيراد/تصدير + تفاعل
# ==============================================

من lib_math_advanced استورد القيمة_المطلقة، الاكبر، الاصغر، المجموع_حتى
من lib_utils استورد اطبع_خط، اطبع_عنوان، اطبع_قائمة_عنصر، اقرأ_اختيار، اطبع_نجاح، اطبع_خطأ، اطبع_معلومة

# ===== صنف الشخص الأساسي =====
صنف شخص
    رقم المعرف
    متغير الاسم_الاول
    متغير اسم_العائلة
    رقم السن
    متغير رقم_الهاتف
    ساكن رقم عداد_اشخاص

    باني(رقم معرف، متغير اسم1، متغير اسم2، رقم سن، متغير هاتف)
        المعرف = معرف
        الاسم_الاول = اسم1
        اسم_العائلة = اسم2
        السن = سن
        رقم_الهاتف = هاتف
        عداد_اشخاص = عداد_اشخاص + 1
    نهاية

    دالة رقم الحصول_على_المعرف()
        ارجع المعرف
    نهاية

    دالة الحصول_على_الاسم_الكامل()
        اطبع(الاسم_الاول)
        اطبع(" ")
        اطبع(اسم_العائلة)
    نهاية

    دالة عرض_معلومات_اساسية()
        اطبع("  المعرف: ")
        اطبع_سطر(المعرف)
        اطبع("  الاسم: ")
        الحصول_على_الاسم_الكامل()
        اطبع_سطر("")
        اطبع("  العمر: ")
        اطبع_سطر(السن)
        اطبع("  الهاتف: ")
        اطبع_سطر(رقم_الهاتف)
    نهاية

    دالة رقم الحصول_على_السن()
        ارجع السن
    نهاية
نهاية

# ===== صنف الطالب يرث من شخص =====
صنف طالب يرث شخص
    رقم الصف
    رقم درجة_عربي
    رقم درجة_رياضيات
    رقم درجة_علوم
    رقم درجة_انجليزي
    رقم درجة_تاريخ
    رقم عدد_الغيابات
    رقم عدد_الملاحظات
    متغير حالة_الطالب

    باني(رقم معرف، متغير اسم1، متغير اسم2، رقم سن، متغير هاتف، رقم صف)
        أساس(معرف، اسم1، اسم2، سن، هاتف)
        الصف = صف
        درجة_عربي = 0
        درجة_رياضيات = 0
        درجة_علوم = 0
        درجة_انجليزي = 0
        درجة_تاريخ = 0
        عدد_الغيابات = 0
        عدد_الملاحظات = 0
        حالة_الطالب = "نشط"
    نهاية

    دالة تعيين_درجة_عربي(رقم درجة)
        إذا (درجة >= 0)
            إذا (درجة <= 100)
                درجة_عربي = درجة
                اطبع_نجاح("تم تسجيل درجة العربي")
            وإلا
                اطبع_خطأ("الدرجة يجب أن تكون 100 أو أقل")
            نهاية
        وإلا
            اطبع_خطأ("الدرجة يجب أن تكون 0 أو أكثر")
        نهاية
    نهاية

    دالة تعيين_درجة_رياضيات(رقم درجة)
        إذا (درجة >= 0)
            إذا (درجة <= 100)
                درجة_رياضيات = درجة
                اطبع_نجاح("تم تسجيل درجة الرياضيات")
            وإلا
                اطبع_خطأ("الدرجة يجب أن تكون 100 أو أقل")
            نهاية
        وإلا
            اطبع_خطأ("الدرجة يجب أن تكون 0 أو أكثر")
        نهاية
    نهاية

    دالة تعيين_درجة_علوم(رقم درجة)
        إذا (درجة >= 0)
            إذا (درجة <= 100)
                درجة_علوم = درجة
                اطبع_نجاح("تم تسجيل درجة العلوم")
            وإلا
                اطبع_خطأ("الدرجة يجب أن تكون 100 أو أقل")
            نهاية
        وإلا
            اطبع_خطأ("الدرجة يجب أن تكون 0 أو أكثر")
        نهاية
    نهاية

    دالة تعيين_درجة_انجليزي(رقم درجة)
        إذا (درجة >= 0)
            إذا (درجة <= 100)
                درجة_انجليزي = درجة
                اطبع_نجاح("تم تسجيل درجة الإنجليزي")
            وإلا
                اطبع_خطأ("الدرجة يجب أن تكون 100 أو أقل")
            نهاية
        وإلا
            اطبع_خطأ("الدرجة يجب أن تكون 0 أو أكثر")
        نهاية
    نهاية

    دالة تعيين_درجة_تاريخ(رقم درجة)
        إذا (درجة >= 0)
            إذا (درجة <= 100)
                درجة_تاريخ = درجة
                اطبع_نجاح("تم تسجيل درجة التاريخ")
            وإلا
                اطبع_خطأ("الدرجة يجب أن تكون 100 أو أقل")
            نهاية
        وإلا
            اطبع_خطأ("الدرجة يجب أن تكون 0 أو أكثر")
        نهاية
    نهاية

    دالة رقم حساب_المجموع()
        رقم مج = درجة_عربي + درجة_رياضيات + درجة_علوم + درجة_انجليزي + درجة_تاريخ
        ارجع مج
    نهاية

    دالة رقم حساب_المعدل()
        رقم مج = حساب_المجموع()
        رقم معدل = مج / 5
        ارجع معدل
    نهاية

    دالة حساب_التقدير()
        رقم معدل = حساب_المعدل()
        إذا (معدل >= 90)
            اطبع("ممتاز")
        وإلا
            إذا (معدل >= 80)
                اطبع("جيد جداً")
            وإلا
                إذا (معدل >= 70)
                    اطبع("جيد")
                وإلا
                    إذا (معدل >= 60)
                        اطبع("مقبول")
                    وإلا
                        اطبع("راسب")
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية

    دالة رقم هل_ناجح()
        رقم معدل = حساب_المعدل()
        إذا (معدل >= 60)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة تسجيل_غياب()
        عدد_الغيابات = عدد_الغيابات + 1
        اطبع_معلومة("تم تسجيل غياب. إجمالي الغيابات: ")
        اطبع_سطر(عدد_الغيابات)
        إذا (عدد_الغيابات >= 15)
            حالة_الطالب = "محروم"
            اطبع_خطأ("تحذير: الطالب محروم بسبب كثرة الغيابات!")
        وإلا
            إذا (عدد_الغيابات >= 10)
                اطبع_خطأ("تحذير: الطالب اقترب من حد الحرمان!")
            نهاية
        نهاية
    نهاية

    دالة اضافة_ملاحظة()
        عدد_الملاحظات = عدد_الملاحظات + 1
        اطبع_معلومة("تم إضافة ملاحظة سلوكية")
    نهاية

    دالة عرض_بطاقة_الطالب()
        اطبع_عنوان("=== بطاقة الطالب ===")
        عرض_معلومات_اساسية()
        اطبع("  الصف: ")
        اطبع_سطر(الصف)
        اطبع("  الحالة: ")
        اطبع_سطر(حالة_الطالب)
        اطبع_سطر("  --- الدرجات ---")
        اطبع("  العربي: ")
        اطبع_سطر(درجة_عربي)
        اطبع("  الرياضيات: ")
        اطبع_سطر(درجة_رياضيات)
        اطبع("  العلوم: ")
        اطبع_سطر(درجة_علوم)
        اطبع("  الإنجليزي: ")
        اطبع_سطر(درجة_انجليزي)
        اطبع("  التاريخ: ")
        اطبع_سطر(درجة_تاريخ)
        اطبع("  المجموع: ")
        اطبع(حساب_المجموع())
        اطبع_سطر(" / 500")
        اطبع("  المعدل: ")
        اطبع(حساب_المعدل())
        اطبع_سطر(" %")
        اطبع("  التقدير: ")
        حساب_التقدير()
        اطبع_سطر("")
        اطبع("  الغيابات: ")
        اطبع_سطر(عدد_الغيابات)
        اطبع("  الملاحظات: ")
        اطبع_سطر(عدد_الملاحظات)
    نهاية

    دالة رقم الحصول_على_الصف()
        ارجع الصف
    نهاية

    دالة رقم الحصول_على_الغيابات()
        ارجع عدد_الغيابات
    نهاية
نهاية

# ===== صنف المعلم يرث من شخص =====
صنف معلم يرث شخص
    متغير التخصص
    رقم سنوات_الخبرة
    رقم الراتب
    رقم عدد_الحصص
    رقم تقييم_الاداء
    متغير المرحلة

    باني(رقم معرف، متغير اسم1، متغير اسم2، رقم سن، متغير هاتف، متغير تخصص، رقم خبرة)
        أساس(معرف، اسم1، اسم2، سن، هاتف)
        التخصص = تخصص
        سنوات_الخبرة = خبرة
        الراتب = 5000 + (خبرة * 200)
        عدد_الحصص = 0
        تقييم_الاداء = 0
        المرحلة = "متوسط"
    نهاية

    دالة تعيين_حصص(رقم عدد)
        إذا (عدد > 0)
            إذا (عدد <= 30)
                عدد_الحصص = عدد
                اطبع_نجاح("تم تعيين الحصص")
            وإلا
                اطبع_خطأ("عدد الحصص كبير جداً")
            نهاية
        وإلا
            اطبع_خطأ("عدد الحصص يجب أن يكون موجباً")
        نهاية
    نهاية

    دالة تعيين_تقييم(رقم تقييم)
        إذا (تقييم >= 1)
            إذا (تقييم <= 10)
                تقييم_الاداء = تقييم
                إذا (تقييم >= 9)
                    اطبع_نجاح("أداء ممتاز!")
                وإلا
                    إذا (تقييم >= 7)
                        اطبع_نجاح("أداء جيد")
                    وإلا
                        إذا (تقييم >= 5)
                            اطبع_معلومة("أداء متوسط")
                        وإلا
                            اطبع_خطأ("أداء ضعيف - يحتاج تحسين")
                        نهاية
                    نهاية
                نهاية
            وإلا
                اطبع_خطأ("التقييم من 1 إلى 10")
            نهاية
        وإلا
            اطبع_خطأ("التقييم من 1 إلى 10")
        نهاية
    نهاية

    دالة رقم حساب_الراتب_الشهري()
        رقم علاوة = 0
        إذا (تقييم_الاداء >= 9)
            علاوة = الراتب / 10
        وإلا
            إذا (تقييم_الاداء >= 7)
                علاوة = الراتب / 20
            نهاية
        نهاية
        رقم بدل_حصص = عدد_الحصص * 50
        ارجع الراتب + علاوة + بدل_حصص
    نهاية

    دالة ترقية()
        سنوات_الخبرة = سنوات_الخبرة + 1
        الراتب = الراتب + 200
        إذا (سنوات_الخبرة >= 15)
            المرحلة = "خبير"
        وإلا
            إذا (سنوات_الخبرة >= 10)
                المرحلة = "أول"
            وإلا
                إذا (سنوات_الخبرة >= 5)
                    المرحلة = "متقدم"
                نهاية
            نهاية
        نهاية
        اطبع_نجاح("تمت الترقية بنجاح!")
        اطبع("  المرحلة الجديدة: ")
        اطبع_سطر(المرحلة)
        اطبع("  الراتب الجديد: ")
        اطبع_سطر(الراتب)
    نهاية

    دالة عرض_بيانات_المعلم()
        اطبع_عنوان("=== بيانات المعلم ===")
        عرض_معلومات_اساسية()
        اطبع("  التخصص: ")
        اطبع_سطر(التخصص)
        اطبع("  سنوات الخبرة: ")
        اطبع_سطر(سنوات_الخبرة)
        اطبع("  المرحلة: ")
        اطبع_سطر(المرحلة)
        اطبع("  الراتب الأساسي: ")
        اطبع_سطر(الراتب)
        اطبع("  عدد الحصص: ")
        اطبع_سطر(عدد_الحصص)
        اطبع("  التقييم: ")
        اطبع(تقييم_الاداء)
        اطبع_سطر(" / 10")
        اطبع("  الراتب الشهري الكلي: ")
        اطبع_سطر(حساب_الراتب_الشهري())
    نهاية

    دالة رقم الحصول_على_الراتب()
        ارجع الراتب
    نهاية

    دالة رقم الحصول_على_الحصص()
        ارجع عدد_الحصص
    نهاية
نهاية

# ===== صنف الإداري يرث من شخص =====
صنف اداري يرث شخص
    متغير المنصب
    رقم الراتب_الاداري
    رقم سنوات_العمل
    متغير القسم

    باني(رقم معرف، متغير اسم1، متغير اسم2، رقم سن، متغير هاتف، متغير منصب، رقم راتب)
        أساس(معرف، اسم1، اسم2، سن، هاتف)
        المنصب = منصب
        الراتب_الاداري = راتب
        سنوات_العمل = 0
        القسم = "إدارة عامة"
    نهاية

    دالة تعيين_قسم(متغير قسم)
        القسم = قسم
        اطبع_نجاح("تم تعيين القسم: ")
        اطبع_سطر(القسم)
    نهاية

    دالة رقم حساب_راتب_اداري()
        رقم بدل_منصب = 0
        إذا (سنوات_العمل >= 10)
            بدل_منصب = 1000
        وإلا
            إذا (سنوات_العمل >= 5)
                بدل_منصب = 500
            وإلا
                بدل_منصب = 200
            نهاية
        نهاية
        ارجع الراتب_الاداري + بدل_منصب
    نهاية

    دالة عرض_بيانات_اداري()
        اطبع_عنوان("=== بيانات الإداري ===")
        عرض_معلومات_اساسية()
        اطبع("  المنصب: ")
        اطبع_سطر(المنصب)
        اطبع("  القسم: ")
        اطبع_سطر(القسم)
        اطبع("  الراتب: ")
        اطبع_سطر(حساب_راتب_اداري())
        اطبع("  سنوات العمل: ")
        اطبع_سطر(سنوات_العمل)
    نهاية
نهاية

# ===== دوال مساعدة =====

دالة رقم حساب_معدل_صف(رقم مج_درجات، رقم عدد_طلاب)
    إذا (عدد_طلاب == 0)
        ارجع 0
    نهاية
    ارجع مج_درجات / عدد_طلاب
نهاية

دالة عرض_احصائيات(رقم ناجحين، رقم راسبين، رقم اجمالي)
    اطبع_عنوان("=== إحصائيات عامة ===")
    اطبع("  إجمالي الطلاب: ")
    اطبع_سطر(اجمالي)
    اطبع("  الناجحون: ")
    اطبع_سطر(ناجحين)
    اطبع("  الراسبون: ")
    اطبع_سطر(راسبين)
    إذا (اجمالي > 0)
        رقم نسبة_نجاح = (ناجحين * 100) / اجمالي
        اطبع("  نسبة النجاح: ")
        اطبع(نسبة_نجاح)
        اطبع_سطر(" %")
    نهاية
نهاية

دالة عرض_تقرير_درجات(رقم عربي، رقم رياضيات، رقم علوم، رقم انجليزي، رقم تاريخ)
    اطبع_سطر("  +------------------+--------+")
    اطبع_سطر("  | المادة           | الدرجة |")
    اطبع_سطر("  +------------------+--------+")
    اطبع("  | العربي           | ")
    اطبع(عربي)
    اطبع_سطر("     |")
    اطبع("  | الرياضيات        | ")
    اطبع(رياضيات)
    اطبع_سطر("     |")
    اطبع("  | العلوم           | ")
    اطبع(علوم)
    اطبع_سطر("     |")
    اطبع("  | الإنجليزي        | ")
    اطبع(انجليزي)
    اطبع_سطر("     |")
    اطبع("  | التاريخ          | ")
    اطبع(تاريخ)
    اطبع_سطر("     |")
    اطبع_سطر("  +------------------+--------+")
نهاية

# ===== القائمة الرئيسية =====

دالة عرض_القائمة_الرئيسية()
    اطبع_عنوان("=== نظام إدارة المدرسة ===")
    اطبع_قائمة_عنصر(1، "إضافة طالب جديد")
    اطبع_قائمة_عنصر(2، "إضافة معلم جديد")
    اطبع_قائمة_عنصر(3، "إضافة إداري جديد")
    اطبع_قائمة_عنصر(4، "تسجيل درجات طالب")
    اطبع_قائمة_عنصر(5، "عرض بطاقة طالب")
    اطبع_قائمة_عنصر(6، "عرض بيانات معلم")
    اطبع_قائمة_عنصر(7، "عرض بيانات إداري")
    اطبع_قائمة_عنصر(8، "تسجيل غياب طالب")
    اطبع_قائمة_عنصر(9، "تقييم معلم")
    اطبع_قائمة_عنصر(10، "ترقية معلم")
    اطبع_قائمة_عنصر(11، "إحصائيات")
    اطبع_قائمة_عنصر(12، "تقرير درجات مفصل")
    اطبع_قائمة_عنصر(0، "خروج")
نهاية

# ===== إنشاء بيانات أولية =====

اطبع_عنوان("مرحباً بك في نظام إدارة المدرسة")
اطبع_معلومة("جاري تحميل البيانات الأولية...")

# إنشاء طلاب
متغير ط1 = جديد طالب(101، "أحمد"، "محمد"، 15، "0501111111"، 10)
متغير ط2 = جديد طالب(102، "سارة"، "علي"، 14، "0502222222"، 9)
متغير ط3 = جديد طالب(103، "خالد"، "عبدالله"، 16، "0503333333"، 11)
متغير ط4 = جديد طالب(104، "فاطمة"، "حسن"، 15، "0504444444"، 10)
متغير ط5 = جديد طالب(105، "يوسف"، "إبراهيم"، 14، "0505555555"، 9)

# تسجيل درجات أولية
ط1.تعيين_درجة_عربي(95)
ط1.تعيين_درجة_رياضيات(88)
ط1.تعيين_درجة_علوم(92)
ط1.تعيين_درجة_انجليزي(85)
ط1.تعيين_درجة_تاريخ(90)

ط2.تعيين_درجة_عربي(78)
ط2.تعيين_درجة_رياضيات(92)
ط2.تعيين_درجة_علوم(85)
ط2.تعيين_درجة_انجليزي(90)
ط2.تعيين_درجة_تاريخ(82)

ط3.تعيين_درجة_عربي(65)
ط3.تعيين_درجة_رياضيات(55)
