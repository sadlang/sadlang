# ============================================
# مثال معقد: نظام معالجة البيانات بالأنابيب
# Complex: Pipeline-based Data Processing System
# ============================================

# ═══════════════════════════════════════
# دوال المعالجة الأساسية
# ═══════════════════════════════════════

دالة ضعف(ع) -> رقم
    ارجع ع * 2
نهاية

دالة ثلث(ع) -> رقم
    ارجع ع / 3
نهاية

دالة خمس_اضعاف(ع) -> رقم
    ارجع ع * 5
نهاية

دالة عشر_اضعاف(ع) -> رقم
    ارجع ع * 10
نهاية

دالة نقص_عشرة(ع) -> رقم
    ارجع ع - 10
نهاية

دالة زيادة_مئة(ع) -> رقم
    ارجع ع + 100
نهاية

دالة تربيع_ع(ع) -> رقم
    ارجع ع * ع
نهاية

دالة تكعيب(ع) -> رقم
    ارجع ع * ع * ع
نهاية

دالة قيمة_مطلقة_م(ع) -> رقم
    اذا (ع < 0)
        ارجع 0 - ع
    نهاية
    ارجع ع
نهاية

دالة تسوية(ع، مقياس) -> رقم
    ارجع ع * 100 / مقياس
نهاية

دالة قص_قيمة(ع، حد) -> رقم
    اذا (ع > حد)
        ارجع حد
    نهاية
    ارجع ع
نهاية

دالة رفع_قيمة(ع، ادني) -> رقم
    اذا (ع < ادني)
        ارجع ادني
    نهاية
    ارجع ع
نهاية

دالة نسبة_مئوية(ع، اجمالي) -> رقم
    ارجع ع * 100 / اجمالي
نهاية

# ═══════════════════════════════════════
# دوال العرض
# ═══════════════════════════════════════

دالة عنوان_م(عنوان: نص)
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════════════════════════╗")
    اطبع("║  ")
    اطبع(عنوان)
    اطبع_سطر("  ║")
    اطبع_سطر("╚══════════════════════════════════════════════╝")
نهاية

دالة فرع(عنوان: نص)
    اطبع_سطر("")
    اطبع("  ▸ ")
    اطبع_سطر(عنوان)
    اطبع_سطر("  ─────────────────────────")
نهاية

دالة نتيجة(تسمية: نص، قيمة)
    اطبع("    ")
    اطبع(تسمية)
    اطبع(" → ")
    اطبع_سطر(قيمة)
نهاية

دالة خط_فاصل()
    اطبع_سطر("  ═════════════════════════════")
نهاية

# ═══════════════════════════════════════
# اختبار 1: نظام معالجة الدرجات
# ═══════════════════════════════════════
دالة اختبار_معالجة_درجات()
    عنوان_م("نظام معالجة الدرجات")

    فرع("درجات الطلاب الخام")
    متغير درجات_خام = [75، 82، 91، 65، 78، 88، 95، 70، 85، 60]
    اطبع("    الدرجات: ")
    اطبع_سطر(درجات_خام)

    فرع("التصنيف حسب المستوى")

    # ممتاز (>= 90)
    متغير ممتاز = [ع لكل ع في [75، 82، 91، 65، 78، 88، 95، 70، 85، 60] اذا ع >= 90]
    اطبع("    ممتاز (≥90): ")
    اطبع_سطر(ممتاز)

    # جيد جداً (80-89)
    متغير جيد_جدا = [ع لكل ع في [75، 82، 91، 65، 78، 88، 95، 70، 85، 60] اذا ع >= 80]
    اطبع("    جيد جداً+ (≥80): ")
    اطبع_سطر(جيد_جدا)

    # أقل من المتوسط
    متغير ضعيف = [ع لكل ع في [75، 82، 91، 65، 78، 88، 95، 70، 85، 60] اذا ع < 70]
    اطبع("    ضعيف (<70): ")
    اطبع_سطر(ضعيف)

    فرع("تحسين الدرجات بالأنبوب")
    # إضافة 5 درجات منحنى ثم تحديد السقف 100
    متغير د1 = 95 |> رفع_قيمة(0) |> قص_قيمة(100)
    متغير د2 = 65 |> رفع_قيمة(60) |> قص_قيمة(100)
    متغير د3 = 82 |> رفع_قيمة(70) |> قص_قيمة(100)
    متغير د4 = 45 |> رفع_قيمة(50) |> قص_قيمة(100)

    نتيجة("95 → حد(0,100)", د1)
    نتيجة("65 → حد(60,100)", د2)
    نتيجة("82 → حد(70,100)", د3)
    نتيجة("45 → حد(50,100)", د4)

    فرع("جدول النسب المئوية")
    متغير نسب = {ع: ع * 100 / 95 لكل ع في [75، 82، 91، 65، 78، 88، 95]}
    اطبع("    نسبة من الأعلى (95): ")
    اطبع_سطر(نسب)

    اطبع_سطر("")
    اطبع_سطر("  [✓] تمت معالجة الدرجات")
نهاية

# ═══════════════════════════════════════
# اختبار 2: نظام تحويل القياسات
# ═══════════════════════════════════════
دالة اختبار_تحويل_قياسات()
    عنوان_م("نظام تحويل القياسات")

    فرع("تحويل درجات الحرارة")

    # سلسيوس إلى فهرنهايت: C * 9/5 + 32
    متغير حرارة_س = [0، 10، 20، 25، 30، 37، 100]
    اطبع("    سلسيوس: ")
    اطبع_سطر(حرارة_س)

    # تحويل يدوي لكل قيمة
    متغير ف_0 = 0 |> ضعف  # تقريب
    متغير ف_10 = 10 |> ضعف
    متغير ف_20 = 20 |> ضعف
    متغير ف_25 = 25 |> ضعف
    متغير ف_100 = 100 |> ضعف

    اطبع("    فهرنهايت (تقريب ×2): ")
    اطبع(ف_0)
    اطبع("، ")
    اطبع(ف_10)
    اطبع("، ")
    اطبع(ف_20)
    اطبع("، ")
    اطبع(ف_25)
    اطبع("، ")
    اطبع_سطر(ف_100)

    فرع("تحويل الأطوال")

    # سنتيمتر بضرب 10
    متغير اطوال_متر = [1، 2، 5، 10، 25، 50، 100]
    متغير سنتيمترات = [ع * 100 لكل ع في [1، 2، 5، 10، 25، 50، 100]]
    اطبع("    أمتار: ")
    اطبع_سطر(اطوال_متر)
    اطبع("    سنتيمتر: ")
    اطبع_سطر(سنتيمترات)

    # ملليمتر
    متغير ملم = [ع * 1000 لكل ع في [1، 2، 5، 10]]
    اطبع("    ملليمتر: ")
    اطبع_سطر(ملم)

    فرع("تحويل الأوزان")

    # كيلوغرام إلى غرام
    متغير كغ = [1، 2، 5، 10، 25، 50]
    متغير غرامات = [ع * 1000 لكل ع في [1، 2، 5، 10، 25، 50]]
    اطبع("    كيلوغرام: ")
    اطبع_سطر(كغ)
    اطبع("    غرام: ")
    اطبع_سطر(غرامات)

    فرع("تحويل الزمن")

    # ساعات إلى دقائق
    متغير دقائق = {ع: ع * 60 لكل ع في [1، 2، 3، 4، 5، 6، 8، 12، 24]}
    اطبع("    ساعة→دقيقة: ")
    اطبع_سطر(دقائق)

    # ساعات إلى ثواني (أول 5 فقط)
    متغير ثواني = {ع: ع * 3600 لكل ع في [1، 2، 3، 4، 5]}
    اطبع("    ساعة→ثانية: ")
    اطبع_سطر(ثواني)

    اطبع_سطر("")
    اطبع_سطر("  [✓] تمت تحويلات القياسات")
نهاية

# ═══════════════════════════════════════
# اختبار 3: نظام تسعير
# ═══════════════════════════════════════
دالة اختبار_نظام_تسعير()
    عنوان_م("نظام تسعير المنتجات")

    فرع("الأسعار الأساسية")
    متغير اسعار = [50، 120، 75، 200، 35، 180، 90، 150]
    اطبع("    الأسعار: ")
    اطبع_سطر(اسعار)

    فرع("خصم 20% على الأسعار فوق 100")
    متغير فوق_مئة = [ع لكل ع في [50، 120، 75، 200، 35، 180، 90، 150] اذا ع > 100]
    اطبع("    المؤهلة للخصم: ")
    اطبع_سطر(فوق_مئة)

    متغير بعد_خصم = [ع * 80 / 100 لكل ع في [120، 200، 180، 150]]
    اطبع("    بعد الخصم 20%: ")
    اطبع_سطر(بعد_خصم)

    فرع("ضريبة القيمة المضافة 15%")
    متغير مع_ضريبة = [ع * 115 / 100 لكل ع في [50، 120، 75، 200، 35]]
    اطبع("    مع الضريبة: ")
    اطبع_سطر(مع_ضريبة)

    فرع("تصنيف الأسعار")
    متغير رخيصة = [ع لكل ع في [50، 120، 75، 200، 35، 180، 90، 150] اذا ع < 60]
    متغير متوسطة = [ع لكل ع في [50، 120، 75، 200، 35، 180، 90، 150] اذا ع >= 60]
    اطبع("    رخيصة (<60): ")
    اطبع_سطر(رخيصة)
    اطبع("    متوسطة+ (≥60): ")
    اطبع_سطر(متوسطة)

    فرع("حساب الضريبة بالأنبوب")
    متغير سعر_1 = 200 |> تسوية(100) |> قص_قيمة(250)
    متغير سعر_2 = 85 |> ضعف |> قص_قيمة(200)
    متغير سعر_3 = 300 |> ثلث |> رفع_قيمة(50)

    نتيجة("200 → تسوية → حد(250)", سعر_1)
    نتيجة("85 → ضعف → حد(200)", سعر_2)
    نتيجة("300 → ثلث → حد(50)", سعر_3)

    فرع("جدول الأسعار مع الضريبة")
    متغير جدول_ضريبة = {ع: ع + ع * 15 / 100 لكل ع في [50، 100، 150، 200، 250، 300]}
    اطبع("    سعر → مع ضريبة: ")
    اطبع_سطر(جدول_ضريبة)

    اطبع_سطر("")
    اطبع_سطر("  [✓] تم نظام التسعير")
نهاية

# ═══════════════════════════════════════
# اختبار 4: مقاييس الأداء
# ═══════════════════════════════════════
دالة اختبار_مقاييس_اداء()
    عنوان_م("مقاييس الأداء")

    فرع("أوقات الاستجابة (مللي ثانية)")
    متغير اوقات = [120، 85، 200، 95، 150، 78، 300، 110، 90، 180]
    اطبع("    الأوقات: ")
    اطبع_سطر(اوقات)

    # المجموع والمتوسط
    متغير مجموع_اوقات = 120 + 85 + 200 + 95 + 150 + 78 + 300 + 110 + 90 + 180
    متغير متوسط_وقت = مجموع_اوقات / 10
    نتيجة("المجموع", مجموع_اوقات)
    نتيجة("المتوسط", متوسط_وقت)

    فرع("تصنيف الأداء")
    متغير سريع = [ع لكل ع في [120، 85، 200، 95، 150، 78، 300، 110، 90، 180] اذا ع < 100]
    متغير بطيء = [ع لكل ع في [120، 85، 200، 95، 150، 78، 300، 110، 90، 180] اذا ع >= 200]
    متغير عادي = [ع لكل ع في [120، 85، 200، 95، 150، 78، 300، 110، 90، 180] اذا ع >= 100]

    اطبع("    سريع (<100ms): ")
    اطبع_سطر(سريع)
    اطبع("    بطيء (≥200ms): ")
    اطبع_سطر(بطيء)
    اطبع("    عادي+ (≥100ms): ")
    اطبع_سطر(عادي)

    فرع("تسوية الأوقات بالأنبوب")
    متغير و1 = 300 |> قص_قيمة(200) |> تسوية(200)
    متغير و2 = 85 |> رفع_قيمة(50) |> تسوية(200)
    متغير و3 = 150 |> تسوية(200)

    نتيجة("300 → حد(200) → نسبة", و1)
    نتيجة("85 → حد(50) → نسبة", و2)
    نتيجة("150 → نسبة من 200", و3)

    فرع("جدول العلامات")
    متغير علامات = {ع: ع * 100 / 300 لكل ع في [120، 85، 200، 95، 150، 300]}
    اطبع("    نسبة من الأبطأ: ")
    اطبع_سطر(علامات)

    خط_فاصل()

    # تحقق نهائي
    متغير عدد_سريع = 3  # 85, 95, 78
    متغير عدد_بطيء = 2  # 200, 300
    اطبع("    عدد سريع: ")
    اطبع_سطر(عدد_سريع)
    اطبع("    عدد بطيء: ")
    اطبع_سطر(عدد_بطيء)

    اذا (عدد_سريع > عدد_بطيء)
        اطبع_سطر("    [✓] الأداء العام جيد")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("  [✓] تمت مقاييس الأداء")
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════════════╗")
    اطبع_سطر("║    نظام معالجة البيانات بالأنابيب          ║")
    اطبع_سطر("╚══════════════════════════════════════════════╝")

    اختبار_معالجة_درجات()
    اختبار_تحويل_قياسات()
    اختبار_نظام_تسعير()
    اختبار_مقاييس_اداء()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى نظام معالجة البيانات بنجاح ===")
    ارجع 0
نهاية
