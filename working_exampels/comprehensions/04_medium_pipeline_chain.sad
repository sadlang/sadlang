# ============================================
# مثال متوسط: سلاسل الأنابيب المتقدمة
# Medium: Advanced Pipeline Chaining
# ============================================

# === دوال التحويل الأساسية ===
دالة زد_واحد(ع) -> رقم
    ارجع ع + 1
نهاية

دالة اطرح_واحد(ع) -> رقم
    ارجع ع - 1
نهاية

دالة ضرب_ثنائي(ع) -> رقم
    ارجع ع * 2
نهاية

دالة ضرب_ثلاثي(ع) -> رقم
    ارجع ع * 3
نهاية

دالة ضرب_خماسي(ع) -> رقم
    ارجع ع * 5
نهاية

دالة قسمة_نصفية(ع) -> رقم
    ارجع ع / 2
نهاية

دالة تربيع_ق(ع) -> رقم
    ارجع ع * ع
نهاية

دالة اضف_مئة(ع) -> رقم
    ارجع ع + 100
نهاية

دالة اضف_خمسين(ع) -> رقم
    ارجع ع + 50
نهاية

دالة باقي_عشرة(ع) -> رقم
    ارجع ع % 10
نهاية

# === دوال مع معاملات إضافية ===
دالة اضف_قيمة(ع، ق) -> رقم
    ارجع ع + ق
نهاية

دالة اضرب_في(ع، ق) -> رقم
    ارجع ع * ق
نهاية

دالة باقي_قسمة(ع، ق) -> رقم
    ارجع ع % ق
نهاية

# === دوال العرض ===
دالة طباعة_عنوان(عنوان: نص)
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════════════════════╗")
    اطبع("║  ")
    اطبع(عنوان)
    اطبع_سطر("  ║")
    اطبع_سطر("╚══════════════════════════════════════════╝")
نهاية

دالة طباعة_نتيجة(تعبير: نص، قيمة)
    اطبع("  ")
    اطبع(تعبير)
    اطبع(" = ")
    اطبع_سطر(قيمة)
نهاية

# === اختبار السلاسل القصيرة ===
دالة اختبار_سلاسل_قصيرة()
    طباعة_عنوان("سلاسل أنابيب قصيرة")

    # سلسلة واحدة
    متغير ن1 = 10 |> ضرب_ثنائي
    طباعة_نتيجة("10 → ×2", ن1)

    متغير ن2 = 7 |> تربيع_ق
    طباعة_نتيجة("7 → تربيع", ن2)

    متغير ن3 = 100 |> قسمة_نصفية
    طباعة_نتيجة("100 → ÷2", ن3)

    # سلسلة من اثنين
    متغير ن4 = 5 |> ضرب_ثنائي |> زد_واحد
    طباعة_نتيجة("5 → ×2 → +1", ن4)

    متغير ن5 = 3 |> تربيع_ق |> اضف_مئة
    طباعة_نتيجة("3 → تربيع → +100", ن5)

    متغير ن6 = 20 |> قسمة_نصفية |> ضرب_ثلاثي
    طباعة_نتيجة("20 → ÷2 → ×3", ن6)

    اطبع_سطر("  [✓] تمت السلاسل القصيرة")
نهاية

# === اختبار السلاسل الطويلة ===
دالة اختبار_سلاسل_طويلة()
    طباعة_عنوان("سلاسل أنابيب طويلة")

    # سلسلة من 3
    متغير ط1 = 2 |> ضرب_ثلاثي |> تربيع_ق |> اطرح_واحد
    طباعة_نتيجة("2 → ×3 → تربيع → -1", ط1)

    # سلسلة من 4
    متغير ط2 = 1 |> زد_واحد |> ضرب_خماسي |> اضف_مئة |> قسمة_نصفية
    طباعة_نتيجة("1 → +1 → ×5 → +100 → ÷2", ط2)

    # سلسلة من 5
    متغير ط3 = 4 |> ضرب_ثنائي |> زد_واحد |> ضرب_ثلاثي |> اضف_خمسين |> اطرح_واحد
    طباعة_نتيجة("4 → ×2 → +1 → ×3 → +50 → -1", ط3)

    # سلسلة أخرى من 4
    متغير ط4 = 10 |> اطرح_واحد |> تربيع_ق |> ضرب_ثنائي |> باقي_عشرة
    طباعة_نتيجة("10 → -1 → تربيع → ×2 → %10", ط4)

    اطبع_سطر("  [✓] تمت السلاسل الطويلة")
نهاية

# === اختبار الأنابيب مع معاملات ===
دالة اختبار_معاملات()
    طباعة_عنوان("أنابيب مع معاملات إضافية")

    # إضافة قيمة
    متغير م1 = 10 |> اضف_قيمة(25)
    طباعة_نتيجة("10 → اضف(25)", م1)

    # ضرب في قيمة
    متغير م2 = 7 |> اضرب_في(8)
    طباعة_نتيجة("7 → اضرب(8)", م2)

    # باقي القسمة
    متغير م3 = 23 |> باقي_قسمة(5)
    طباعة_نتيجة("23 → باقي(5)", م3)

    # سلسلة مع معاملات
    متغير م4 = 5 |> اضرب_في(4) |> اضف_قيمة(10)
    طباعة_نتيجة("5 → ×4 → +10", م4)

    متغير م5 = 3 |> اضف_قيمة(7) |> اضرب_في(3) |> باقي_قسمة(7)
    طباعة_نتيجة("3 → +7 → ×3 → %7", م5)

    # مزج دوال عادية ومعاملات
    متغير م6 = 8 |> ضرب_ثنائي |> اضف_قيمة(4) |> تربيع_ق
    طباعة_نتيجة("8 → ×2 → +4 → تربيع", م6)

    متغير م7 = 2 |> تربيع_ق |> اضرب_في(5) |> اضف_مئة |> باقي_قسمة(13)
    طباعة_نتيجة("2 → تربيع → ×5 → +100 → %13", م7)

    اطبع_سطر("  [✓] تمت اختبارات المعاملات")
نهاية

# === اختبار مقارنة النتائج ===
دالة اختبار_مقارنة()
    طباعة_عنوان("مقارنة نتائج الأنابيب")

    # مسارات مختلفة لنفس البداية
    متغير بداية = 6

    متغير مسار_أ = بداية |> ضرب_ثنائي |> تربيع_ق
    متغير مسار_ب = بداية |> تربيع_ق |> ضرب_ثنائي

    اطبع("  6 → ×2 → تربيع = ")
    اطبع_سطر(مسار_أ)
    اطبع("  6 → تربيع → ×2 = ")
    اطبع_سطر(مسار_ب)

    اذا (مسار_أ != مسار_ب)
        اطبع_سطر("  [✓] الترتيب يؤثر على النتيجة!")
    نهاية

    # مسارات متقاربة
    متغير مسار_ج = 10 |> زد_واحد |> ضرب_ثنائي
    متغير مسار_د = 10 |> ضرب_ثنائي |> زد_واحد

    اطبع("  10 → +1 → ×2 = ")
    اطبع_سطر(مسار_ج)
    اطبع("  10 → ×2 → +1 = ")
    اطبع_سطر(مسار_د)

    # ثلاث مسارات
    متغير مسار_هـ = 4 |> ضرب_ثنائي |> اضف_مئة
    متغير مسار_و = 4 |> اضف_مئة |> ضرب_ثنائي
    متغير مسار_ز = 4 |> ضرب_خماسي |> اضف_خمسين

    اطبع("  4 → ×2 → +100 = ")
    اطبع_سطر(مسار_هـ)
    اطبع("  4 → +100 → ×2 = ")
    اطبع_سطر(مسار_و)
    اطبع("  4 → ×5 → +50 = ")
    اطبع_سطر(مسار_ز)

    اطبع_سطر("  [✓] تمت المقارنات")
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════════╗")
    اطبع_سطر("║     سلاسل الأنابيب المتقدمة            ║")
    اطبع_سطر("╚══════════════════════════════════════════╝")

    اختبار_سلاسل_قصيرة()
    اختبار_سلاسل_طويلة()
    اختبار_معاملات()
    اختبار_مقارنة()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى اختبار سلاسل الأنابيب بنجاح ===")
    ارجع 0
نهاية
