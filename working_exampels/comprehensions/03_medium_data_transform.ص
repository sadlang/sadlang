دالة تربيع(ع) -> رقم
    ارجع ع * ع
نهاية

دالة مكعب(ع) -> رقم
    ارجع ع * ع * ع
نهاية

دالة مضاعفة(ع) -> رقم
    ارجع ع * 2
نهاية

دالة ثلاثي(ع) -> رقم
    ارجع ع * 3
نهاية

دالة اضافة_عشرة(ع) -> رقم
    ارجع ع + 10
نهاية

دالة طرح_واحد(ع) -> رقم
    ارجع ع - 1
نهاية

دالة طباعة_عنوان(عنوان: نص)
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع("║  ")
    اطبع(عنوان)
    اطبع_سطر("  ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
نهاية

دالة طباعة_قسم(عنوان: نص)
    اطبع_سطر("")
    اطبع("--- ")
    اطبع(عنوان)
    اطبع_سطر(" ---")
نهاية

# === تحويلات رقمية ===
دالة اختبار_تحويلات_رقمية()
    طباعة_عنوان("تحويلات رقمية")

    # مربعات الأرقام من 1 إلى 8
    طباعة_قسم("مربعات الأرقام")
    متغير مربعات = [ع * ع لكل ع في مدى(1، 9)]
    اطبع_سطر(مربعات)

    # مكعبات الأرقام الفردية
    طباعة_قسم("مكعبات الأرقام الفردية")
    متغير مكعبات_فردية = [ع * ع * ع لكل ع في مدى(1، 10) اذا ع % 2 != 0]
    اطبع_سطر(مكعبات_فردية)

    # الأرقام القابلة للقسمة على 3
    طباعة_قسم("القابلة للقسمة على 3")
    متغير قابلة_ثلاثة = [ع لكل ع في مدى(1، 31) اذا ع % 3 == 0]
    اطبع_سطر(قابلة_ثلاثة)

    # تحويل بالضرب والجمع
    طباعة_قسم("تحويل مركب: ع*3 + 1")
    متغير مركب = [ع * 3 + 1 لكل ع في [2، 4، 6، 8، 10]]
    اطبع_سطر(مركب)

    # الأرقام الزوجية مضروبة في نفسها
    طباعة_قسم("زوجية مربعة")
    متغير زوجية_مربعة = [ع * ع لكل ع في مدى(2، 13) اذا ع % 2 == 0]
    اطبع_سطر(زوجية_مربعة)

    اطبع_سطر("")
    اطبع_سطر("[✓] تمت التحويلات الرقمية")
نهاية

# === تحويلات مع القواميس ===
دالة اختبار_تحويلات_قواميس()
    طباعة_عنوان("تحويلات القواميس")

    # جدول المربعات
    طباعة_قسم("جدول المربعات")
    متغير جدول_مربعات = {ع: ع * ع لكل ع في مدى(1، 11)}
    اطبع_سطر(جدول_مربعات)

    # جدول المضاعفات
    طباعة_قسم("جدول الضرب في 7")
    متغير جدول_سبعة = {ع: ع * 7 لكل ع في مدى(1، 11)}
    اطبع_سطر(جدول_سبعة)

    # جدول مع فلترة
    طباعة_قسم("مربعات الأرقام الزوجية فقط")
    متغير مربعات_زوجية = {ع: ع * ع لكل ع في مدى(1، 21) اذا ع % 2 == 0}
    اطبع_سطر(مربعات_زوجية)

    # فهرس القيم الكبيرة
    طباعة_قسم("القيم الكبيرة > 50")
    متغير كبيرة = {ع: ع * ع لكل ع في مدى(1، 16) اذا ع * ع > 50}
    اطبع_سطر(كبيرة)

    اطبع_سطر("")
    اطبع_سطر("[✓] تمت تحويلات القواميس")
نهاية

# === تحويلات مع الأنابيب ===
دالة اختبار_انابيب_التحويل()
    طباعة_عنوان("أنابيب التحويل")

    # سلسلة تحويل بسيطة
    طباعة_قسم("تربيع ثم إضافة 10")
    متغير ن1 = 5 |> تربيع |> اضافة_عشرة
    اطبع("5 → تربيع → +10 = ")
    اطبع_سطر(ن1)

    # سلسلة أطول
    طباعة_قسم("مضاعفة ثم تربيع ثم طرح")
    متغير ن2 = 3 |> مضاعفة |> تربيع |> طرح_واحد
    اطبع("3 → ×2 → تربيع → -1 = ")
    اطبع_سطر(ن2)

    # سلسلة تحويلات متعددة
    طباعة_قسم("سلاسل متنوعة")
    متغير ق1 = 2 |> مكعب
    اطبع("2 → مكعب = ")
    اطبع_سطر(ق1)

    متغير ق2 = 4 |> ثلاثي |> مضاعفة
    اطبع("4 → ×3 → ×2 = ")
    اطبع_سطر(ق2)

    متغير ق3 = 7 |> مضاعفة |> اضافة_عشرة |> تربيع
    اطبع("7 → ×2 → +10 → تربيع = ")
    اطبع_سطر(ق3)

    متغير ق4 = 10 |> طرح_واحد |> ثلاثي
    اطبع("10 → -1 → ×3 = ")
    اطبع_سطر(ق4)

    اطبع_سطر("")
    اطبع_سطر("[✓] تمت أنابيب التحويل")
نهاية

# === دمج الأدوات ===
دالة اختبار_الدمج()
    طباعة_عنوان("دمج التعبيرات والأنابيب")

    # إنشاء قائمة ثم تحويل عناصرها
    طباعة_قسم("قائمة ثم أنبوب")
    متغير قائمة_أ = [ع * 2 لكل ع في [3، 6، 9]]
    اطبع("القائمة المضاعفة: ")
    اطبع_سطر(قائمة_أ)

    متغير مجموع_أ = 3 |> ثلاثي |> اضافة_عشرة
    اطبع("3 → ×3 → +10 = ")
    اطبع_سطر(مجموع_أ)

    # قاموس القيم المحولة
    طباعة_قسم("قاموس مع أنبوب")
    متغير نتيجة_ت = 5 |> مضاعفة |> تربيع
    اطبع("5 → ×2 → تربيع = ")
    اطبع_سطر(نتيجة_ت)

    متغير قاموس_ب = {ع: ع * ع + 1 لكل ع في [1، 2، 3، 4، 5]}
    اطبع("قاموس ع²+1: ")
    اطبع_سطر(قاموس_ب)

    # مجموعة فريدة
    طباعة_قسم("مجموعة القيم الفريدة")
    متغير فريدة = {ع % 5 لكل ع في مدى(1، 21)}
    اطبع("باقي القسمة على 5: ")
    اطبع_سطر(فريدة)

    اطبع_سطر("")
    اطبع_سطر("[✓] تم الدمج بنجاح")
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════════╗")
    اطبع_سطر("║   تحويل البيانات بالتعبيرات المختصرة   ║")
    اطبع_سطر("╚══════════════════════════════════════════╝")

    اختبار_تحويلات_رقمية()
    اختبار_تحويلات_قواميس()
    اختبار_انابيب_التحويل()
    اختبار_الدمج()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى اختبار تحويل البيانات بنجاح ===")
    ارجع 0
نهاية
