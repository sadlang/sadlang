# === دوال التحويل ===
دالة تربيع_رقم(ع) -> رقم
    ارجع ع * ع
نهاية

دالة جذر_تقريبي(ع) -> رقم
    # تقريب جذر باستخدام نيوتن
    متغير تخمين = ع / 2
    متغير عداد = 0
    طالما (عداد < 10)
        تخمين = (تخمين + ع / تخمين) / 2
        عداد = عداد + 1
    نهاية
    ارجع تخمين
نهاية

دالة قيمة_مطلقة(ع) -> رقم
    اذا (ع < 0)
        ارجع 0 - ع
    نهاية
    ارجع ع
نهاية

دالة حد_اعلى(ع، سقف) -> رقم
    اذا (ع > سقف)
        ارجع سقف
    نهاية
    ارجع ع
نهاية

دالة حد_ادنى(ع، ارضية) -> رقم
    اذا (ع < ارضية)
        ارجع ارضية
    نهاية
    ارجع ع
نهاية

# === دوال العرض ===
دالة عنوان_رئيسي(عنوان: نص)
    اطبع_سطر("")
    اطبع_سطر("╔════════════════════════════════════════════╗")
    اطبع("║  ")
    اطبع(عنوان)
    اطبع_سطر("  ║")
    اطبع_سطر("╚════════════════════════════════════════════╝")
نهاية

دالة عنوان_فرعي(عنوان: نص)
    اطبع_سطر("")
    اطبع("  ◆ ")
    اطبع_سطر(عنوان)
    اطبع_سطر("  ─────────────────────")
نهاية

دالة طباعة_قيمة(تسمية: نص، قيمة)
    اطبع("    ")
    اطبع(تسمية)
    اطبع(": ")
    اطبع_سطر(قيمة)
نهاية

# ═══════════════════════════════════════
# اختبار 1: تحليل سلسلة أرقام 
# ═══════════════════════════════════════
دالة اختبار_تحليل_ارقام()
    عنوان_رئيسي("تحليل سلسلة أرقام")

    # إنشاء مجموعات بيانات مختلفة
    عنوان_فرعي("المربعات الكاملة من 1 إلى 15")
    متغير مربعات = [ع * ع لكل ع في مدى(1، 16)]
    اطبع("    القيم: ")
    اطبع_سطر(مربعات)

    عنوان_فرعي("الأرقام الزوجية المربعة")
    متغير زوجية_مربعة = [ع * ع لكل ع في مدى(1، 16) اذا ع % 2 == 0]
    اطبع("    القيم: ")
    اطبع_سطر(زوجية_مربعة)

    عنوان_فرعي("الأرقام الفردية المربعة")
    متغير فردية_مربعة = [ع * ع لكل ع في مدى(1، 16) اذا ع % 2 != 0]
    اطبع("    القيم: ")
    اطبع_سطر(فردية_مربعة)

    عنوان_فرعي("القابلة للقسمة على 3 و 5")
    متغير ثلاثة_وخمسة = [ع لكل ع في مدى(1، 101) اذا ع % 15 == 0]
    اطبع("    القيم: ")
    اطبع_سطر(ثلاثة_وخمسة)

    عنوان_فرعي("مجموعة باقي القسمة")
    متغير بواقي = {ع % 7 لكل ع في مدى(1، 31)}
    اطبع("    باقي ÷7: ")
    اطبع_سطر(بواقي)

    اطبع_سطر("")
    اطبع_سطر("  [✓] تم تحليل الأرقام")
نهاية

# ═══════════════════════════════════════
# اختبار 2: جداول رياضية
# ═══════════════════════════════════════
دالة اختبار_جداول_رياضية()
    عنوان_رئيسي("جداول رياضية")

    # جدول الضرب
    عنوان_فرعي("جدول ضرب 6")
    متغير جدول_6 = {ع: ع * 6 لكل ع في مدى(1، 13)}
    اطبع("    ")
    اطبع_سطر(جدول_6)

    عنوان_فرعي("جدول ضرب 9")
    متغير جدول_9 = {ع: ع * 9 لكل ع في مدى(1، 13)}
    اطبع("    ")
    اطبع_سطر(جدول_9)

    # جدول القوى
    عنوان_فرعي("جدول التكعيب")
    متغير مكعبات = {ع: ع * ع * ع لكل ع في مدى(1، 11)}
    اطبع("    ")
    اطبع_سطر(مكعبات)

    # جدول مع تصفية
    عنوان_فرعي("مربعات أقل من 100")
    متغير مربعات_صغيرة = {ع: ع * ع لكل ع في مدى(1، 21) اذا ع * ع < 100}
    اطبع("    ")
    اطبع_سطر(مربعات_صغيرة)

    عنوان_فرعي("مكعبات أقل من 500")
    متغير مكعبات_صغيرة = {ع: ع * ع * ع لكل ع في مدى(1، 21) اذا ع * ع * ع < 500}
    اطبع("    ")
    اطبع_سطر(مكعبات_صغيرة)

    اطبع_سطر("")
    اطبع_سطر("  [✓] تمت الجداول الرياضية")
نهاية

# ═══════════════════════════════════════
# اختبار 3: تحويلات مع الأنابيب
# ═══════════════════════════════════════
دالة اختبار_تحويلات_متقدمة()
    عنوان_رئيسي("تحويلات متقدمة بالأنابيب")

    عنوان_فرعي("حسابات تسلسلية")

    # حساب المسافة (تقريب)
    متغير س1 = 3
    متغير ص1 = 4
    متغير مربع_مسافة = س1 * س1 + ص1 * ص1
    متغير مسافة = مربع_مسافة |> جذر_تقريبي
    طباعة_قيمة("مسافة النقطة (3,4)", مسافة)

    متغير س2 = 5
    متغير ص2 = 12
    متغير مربع_مسافة_2 = س2 * س2 + ص2 * ص2
    متغير مسافة_2 = مربع_مسافة_2 |> جذر_تقريبي
    طباعة_قيمة("مسافة النقطة (5,12)", مسافة_2)

    عنوان_فرعي("تحويلات بالحدود")

    # تحديد القيم ضمن نطاق
    متغير قيم_اختبار = [150، 80، 200، 30، 95، 170، 45، 120]
    اطبع("    القيم الأصلية: ")
    اطبع_سطر(قيم_اختبار)

    متغير ق_محدودة_1 = 150 |> حد_اعلى(100)
    متغير ق_محدودة_2 = 80 |> حد_اعلى(100)
    متغير ق_محدودة_3 = 200 |> حد_اعلى(100)
    متغير ق_محدودة_4 = 30 |> حد_ادنى(50)
    متغير ق_محدودة_5 = 95 |> حد_اعلى(100)

    اطبع("    بعد الحد الأعلى 100: ")
    اطبع(ق_محدودة_1)
    اطبع("، ")
    اطبع(ق_محدودة_2)
    اطبع("، ")
    اطبع(ق_محدودة_3)
    اطبع("، ")
    اطبع(ق_محدودة_5)
    اطبع_سطر("")

    اطبع("    بعد الحد الأدنى 50: ")
    اطبع_سطر(ق_محدودة_4)

    عنوان_فرعي("سلاسل حسابية متعددة")

    متغير ح1 = 8 |> تربيع_رقم |> جذر_تقريبي
    طباعة_قيمة("8 → تربيع → جذر", ح1)

    متغير ح2 = 100 |> جذر_تقريبي |> تربيع_رقم
    طباعة_قيمة("100 → جذر → تربيع", ح2)

    متغير ح3 = 25 |> جذر_تقريبي
    طباعة_قيمة("√25", ح3)

    متغير ح4 = 144 |> جذر_تقريبي
    طباعة_قيمة("√144", ح4)

    اطبع_سطر("")
    اطبع_سطر("  [✓] تمت التحويلات المتقدمة")
نهاية

# ═══════════════════════════════════════
# اختبار 4: تحليل إحصائي
# ═══════════════════════════════════════
دالة اختبار_احصائي()
    عنوان_رئيسي("تحليل إحصائي")

    عنوان_فرعي("بيانات الاختبار")
    متغير بيانات = [23، 45، 67، 12، 89، 34، 56، 78، 90، 11]
    اطبع("    البيانات: ")
    اطبع_سطر(بيانات)

    # حساب المجموع يدوياً
    متغير مجموع = 23 + 45 + 67 + 12 + 89 + 34 + 56 + 78 + 90 + 11
    طباعة_قيمة("المجموع", مجموع)

    متغير متوسط = مجموع / 10
    طباعة_قيمة("المتوسط", متوسط)

    عنوان_فرعي("تصنيف البيانات")

    # القيم فوق المتوسط
    متغير فوق_متوسط = [ع لكل ع في [23، 45، 67، 12، 89، 34، 56، 78، 90، 11] اذا ع > 50]
    اطبع("    فوق 50: ")
    اطبع_سطر(فوق_متوسط)

    متغير تحت_متوسط = [ع لكل ع في [23، 45، 67، 12، 89، 34، 56، 78، 90، 11] اذا ع <= 50]
    اطبع("    تحت أو يساوي 50: ")
    اطبع_سطر(تحت_متوسط)

    عنوان_فرعي("توزيع العشرات")
    متغير عشرات = {ع: ع / 10 لكل ع في [23، 45، 67، 12، 89، 34، 56، 78، 90، 11]}
    اطبع("    عشرة كل رقم: ")
    اطبع_سطر(عشرات)

    عنوان_فرعي("مربعات الانحراف")
    # الانحراف عن المتوسط (50) مربع
    متغير انحرافات = [(ع - 50) * (ع - 50) لكل ع في [23، 45، 67، 12، 89، 34، 56، 78، 90، 11]]
    اطبع("    مربعات الانحراف: ")
    اطبع_سطر(انحرافات)

    اطبع_سطر("")
    اطبع_سطر("  [✓] تم التحليل الإحصائي")
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    اطبع_سطر("╔════════════════════════════════════════════╗")
    اطبع_سطر("║   نظام تحليل البيانات بالتعبيرات المختصرة ║")
    اطبع_سطر("╚════════════════════════════════════════════╝")

    اختبار_تحليل_ارقام()
    اختبار_جداول_رياضية()
    اختبار_تحويلات_متقدمة()
    اختبار_احصائي()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى نظام التحليل بنجاح ===")
    ارجع 0
نهاية
