دالة رئيسية()
    اطبع("اختبار دوال النصوص المتقدمة")
    اطبع_سطر("")
    
    اطبع("استبدال في 'Hello World': ")
    اطبع_سطر(استبدل("Hello World", "World", "Sad"))
    
    اطبع("استخراج من 'Hello': ")
    اطبع_سطر(استخراج("Hello", 1, 3))
    
    اطبع("قص أطراف '  test  ': ")
    اطبع("[")
    اطبع(قص_أطراف("  test  "))
    اطبع_سطر("]")
    
    اطبع("يبدأ بـ 'Hello' بـ 'He': ")
    اطبع(يبدأ_ب("Hello", "He"))
    اطبع_سطر("")
    
    اطبع("ينتهي بـ 'World' بـ 'ld': ")
    اطبع(ينتهي_ب("World", "ld"))
    اطبع_سطر("")
    
    اطبع("يحتوي 'Hello' على 'll': ")
    اطبع(يحتوي_على("Hello", "ll"))
    اطبع_سطر("")
    
    اطبع("بحث عن 'o' في 'Hello': ")
    اطبع(بحث("Hello", "o"))
    اطبع_سطر("")
    
    اطبع_سطر("تم!")
نهاية
