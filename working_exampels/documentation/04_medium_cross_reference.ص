# ---- أدوات مساعدة ----

دالة عرض_نتيجة(نص وصف، رقم ناجح)
    إذا (ناجح == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

دالة نص وسم(نص اسم_و، نص محتوى)
    نص فتح = "<" + اسم_و + ">"
    نص غلق = "</" + اسم_و + ">"
    ارجع فتح + محتوى + غلق
نهاية

# ---- بناء رابط مرجع ----

دالة نص ولد_رابط(نص اسم_ر، نص ملف_ر)
    نص جزء1 = "<a href=\""
    نص جزء2 = جزء1 + ملف_ر
    نص جزء3 = جزء2 + "#"
    نص جزء4 = جزء3 + اسم_ر
    نص جزء5 = جزء4 + "\">"
    نص جزء6 = جزء5 + اسم_ر
    نص كامل = جزء6 + "</a>"
    ارجع كامل
نهاية

# ---- طباعة مرجع ----

دالة طباعة_مرجع(نص اسم_م، نص صنف_م، نص مصدر_م، نص وجهة_م)
    اطبع_سطر("    ┌─ " + اسم_م)
    اطبع_سطر("    │  الصنف: " + صنف_م)
    اطبع_سطر("    │  المصدر: " + مصدر_م)
    اطبع_سطر("    └─ الوجهة: " + وجهة_م)
نهاية

# ---- فحص المرجع ----

دالة رقم تحقق_مرجع(نص اسم_م، نص صنف_م)
    رقم طول_اسم = طول_نص(اسم_م)
    رقم طول_صنف = طول_نص(صنف_م)

    إذا (طول_اسم < 2)
        ارجع 0
    نهاية
    إذا (طول_صنف < 2)
        ارجع 0
    نهاية
    ارجع 1
نهاية

# ---- اختبار 1: تسجيل مراجع مكتبة الرياضيات ----

دالة اختبار_مراجع_رياضيات()
    اطبع_سطر("=== مراجع مكتبة الرياضيات ===")
    اطبع_سطر("")

    رقم عداد = 0

    طباعة_مرجع("احسب_مجموع"، "دالة"، "رياضيات.ص"، "حسابات.ص")
    عداد = عداد + 1

    طباعة_مرجع("احسب_فرق"، "دالة"، "رياضيات.ص"، "حسابات.ص")
    عداد = عداد + 1

    طباعة_مرجع("_تحقق"، "دالة"، "مساعد.ص"، "رياضيات.ص")
    عداد = عداد + 1

    طباعة_مرجع("القيمة_القصوى"، "متغير"، "ثوابت.ص"، "تحقق.ص")
    عداد = عداد + 1

    طباعة_مرجع("آلة_حاسبة"، "فئة"، "حاسبة.ص"، "واجهة.ص")
    عداد = عداد + 1

    طباعة_مرجع("تحويلات"، "وحدة"، "تحويل.ص"، "رئيسي.ص")
    عداد = عداد + 1

    اطبع_سطر("")
    نص عداد_ن = لنص(عداد)
    اطبع_سطر("  تم تسجيل " + عداد_ن + " مرجع")

    إذا (عداد == 6)
        عرض_نتيجة("تسجيل مراجع الرياضيات"، 1)
    وإلا
        عرض_نتيجة("تسجيل مراجع الرياضيات"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 2: مراجع مكتبة النصوص ----

دالة اختبار_مراجع_نصوص()
    اطبع_سطر("=== مراجع مكتبة النصوص ===")
    اطبع_سطر("")

    رقم عداد = 0

    طباعة_مرجع("اقطع_نص"، "دالة"، "نصوص.ص"، "معالج.ص")
    عداد = عداد + 1

    طباعة_مرجع("ادمج_نصوص"، "دالة"، "نصوص.ص"، "تنسيق.ص")
    عداد = عداد + 1

    طباعة_مرجع("طول_الحد"، "متغير"، "إعدادات.ص"، "نصوص.ص")
    عداد = عداد + 1

    طباعة_مرجع("منسق_نص"، "فئة"، "تنسيق.ص"، "طباعة.ص")
