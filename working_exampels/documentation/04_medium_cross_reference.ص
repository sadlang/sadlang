    اطبع_سطر("")
    نص عداد_ن = لنص(عداد)
    اطبع_سطر("  تم تسجيل " + عداد_ن + " مرجع")

    إذا (عداد == 4)
        عرض_نتيجة("تسجيل مراجع النصوص"، 1)
    وإلا
        عرض_نتيجة("تسجيل مراجع النصوص"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 3: التحقق من المراجع ----

دالة اختبار_تحقق()
    اطبع_سطر("=== التحقق من صحة المراجع ===")
    اطبع_سطر("")

    رقم صحيحة = 0

    رقم ت1 = تحقق_مرجع("احسب_مجموع"، "دالة")
    إذا (ت1 == 1)
        عرض_نتيجة("مرجع احسب_مجموع صحيح"، 1)
        صحيحة = صحيحة + 1
    وإلا
        عرض_نتيجة("مرجع احسب_مجموع صحيح"، 0)
    نهاية

    رقم ت2 = تحقق_مرجع("آلة_حاسبة"، "فئة")
    إذا (ت2 == 1)
        عرض_نتيجة("مرجع آلة_حاسبة صحيح"، 1)
        صحيحة = صحيحة + 1
    وإلا
        عرض_نتيجة("مرجع آلة_حاسبة صحيح"، 0)
    نهاية

    رقم ت3 = تحقق_مرجع("أ"، "دالة")
    إذا (ت3 == 0)
        عرض_نتيجة("رفض مرجع قصير"، 1)
        صحيحة = صحيحة + 1
    وإلا
        عرض_نتيجة("رفض مرجع قصير"، 0)
    نهاية

    رقم ت4 = تحقق_مرجع(""، "")
    إذا (ت4 == 0)
        عرض_نتيجة("رفض مرجع فارغ"، 1)
        صحيحة = صحيحة + 1
    وإلا
        عرض_نتيجة("رفض مرجع فارغ"، 0)
    نهاية

    اطبع_سطر("")
    نص صحيحة_ن = لنص(صحيحة)
    اطبع_سطر("  مراجع صحيحة: " + صحيحة_ن + "/4")
    اطبع_سطر("")
نهاية

# ---- اختبار 4: توليد روابط HTML ----

دالة اختبار_روابط()
    اطبع_سطر("=== توليد روابط المراجع HTML ===")
    اطبع_سطر("")

    # توليد روابط مكتبة الرياضيات
    نص ر1 = ولد_رابط("احسب_مجموع"، "حسابات.html")
    نص ر2 = ولد_رابط("احسب_فرق"، "حسابات.html")
    نص ر3 = ولد_رابط("_تحقق"، "رياضيات.html")
    نص ر4 = ولد_رابط("القيمة_القصوى"، "تحقق.html")
    نص ر5 = ولد_رابط("آلة_حاسبة"، "واجهة.html")
    نص ر6 = ولد_رابط("تحويلات"، "رئيسي.html")

    اطبع_سطر("  " + ر1)
    اطبع_سطر("  " + ر2)
    اطبع_سطر("  " + ر3)
    اطبع_سطر("  " + ر4)
    اطبع_سطر("  " + ر5)
    اطبع_سطر("  " + ر6)

    # توليد روابط مكتبة النصوص
    نص ر7 = ولد_رابط("اقطع_نص"، "معالج.html")
    نص ر8 = ولد_رابط("ادمج_نصوص"، "تنسيق.html")
    نص ر9 = ولد_رابط("طول_الحد"، "نصوص.html")
    نص ر10 = ولد_رابط("منسق_نص"، "طباعة.html")

    اطبع_سطر("  " + ر7)
    اطبع_سطر("  " + ر8)
    اطبع_سطر("  " + ر9)
    اطبع_سطر("  " + ر10)

    اطبع_سطر("")
    عرض_نتيجة("توليد 10 روابط"، 1)

    # إحصائيات
    اطبع_سطر("")
    اطبع_سطر("  ── ملخص الروابط ──")
    اطبع_سطر("  إجمالي الروابط: 10")
    اطبع_سطر("  ملفات الوجهة:")
    اطبع_سطر("    • حسابات.html")
    اطبع_سطر("    • رياضيات.html")
    اطبع_سطر("    • تحقق.html")
    اطبع_سطر("    • واجهة.html")
    اطبع_سطر("    • رئيسي.html")
    اطبع_سطر("    • معالج.html")
    اطبع_سطر("    • تنسيق.html")
    اطبع_سطر("    • نصوص.html")
    اطبع_سطر("    • طباعة.html")
    اطبع_سطر("")
نهاية

# ---- اختبار 5: تقرير إحصائي ----

دالة اختبار_تقرير()
    اطبع_سطر("=== تقرير المراجع المتقاطعة ===")
    اطبع_سطر("")

    رقم دوال = 5
    رقم متغيرات = 2
    رقم فئات_ع = 2
    رقم وحدات_ع = 1
    رقم إجمالي = دوال + متغيرات + فئات_ع + وحدات_ع

    نص دوال_ن = لنص(دوال)
    نص متغيرات_ن = لنص(متغيرات)
    نص فئات_ن = لنص(فئات_ع)
    نص وحدات_ن = لنص(وحدات_ع)
    نص إجمالي_ن = لنص(إجمالي)

    اطبع_سطر("  ╔══════════════════════════════╗")
    اطبع_سطر("  ║  تقرير المراجع المتقاطعة   ║")
    اطبع_سطر("  ╠══════════════════════════════╣")
    اطبع_سطر("  ║  الدوال: " + دوال_ن + "                 ║")
    اطبع_سطر("  ║  المتغيرات: " + متغيرات_ن + "             ║")
    اطبع_سطر("  ║  الفئات: " + فئات_ن + "                 ║")
    اطبع_سطر("  ║  الوحدات: " + وحدات_ن + "                ║")
    اطبع_سطر("  ║  الإجمالي: " + إجمالي_ن + "              ║")
    اطبع_سطر("  ╚══════════════════════════════╝")

    إذا (إجمالي == 10)
        عرض_نتيجة("إجمالي المراجع صحيح"، 1)
    وإلا
        عرض_نتيجة("إجمالي المراجع صحيح"، 0)
    نهاية

    # تحقق نسب التصنيف
    رقم نسبة_دوال = (دوال * 100) / إجمالي
    نص نسبة_ن = لنص(نسبة_دوال)
    اطبع_سطر("  نسبة الدوال: " + نسبة_ن + "%")

    إذا (نسبة_دوال == 50)
        عرض_نتيجة("نسبة الدوال صحيحة"، 1)
    وإلا
        عرض_نتيجة("نسبة الدوال صحيحة"، 0)
    نهاية
    اطبع_سطر("")
نهاية

