# ---- اختبار 3: واجهات المصادقة + صفحة HTML كاملة ----

دالة اختبار_صفحة_html()
    اطبع_سطر("=== توليد صفحة HTML كاملة ===")
    اطبع_سطر("")

    اطبع_سطر("  <!DOCTYPE html>")
    اطبع_سطر("  <html lang=\"ar\" dir=\"rtl\">")
    اطبع_سطر("  <head>")
    نص عنوان = وسم("title"، "توثيق واجهات API")
    اطبع_سطر("    " + عنوان)
    اطبع_سطر("    <link rel=\"stylesheet\" href=\"api-docs.css\"/>")
    اطبع_سطر("  </head>")
    اطبع_سطر("  <body>")

    نص رأس = وسم("h1"، "مرجع واجهات API الكامل")
    اطبع_سطر("    " + رأس)

    # الفهرس
    اطبع_سطر("    <nav>")
    نص عنوان_ف = وسم("h2"، "الفهرس")
    اطبع_سطر("      " + عنوان_ف)
    اطبع_سطر("      <ul>")

    نص ف1 = وسم("li"، "المستخدمون (5 واجهات)")
    نص ف2 = وسم("li"، "المنتجات (3 واجهات)")
    نص ف3 = وسم("li"، "الطلبات (2 واجهات)")
    نص ف4 = وسم("li"، "المصادقة (2 واجهات)")

    اطبع_سطر("        " + ف1)
    اطبع_سطر("        " + ف2)
    اطبع_سطر("        " + ف3)
    اطبع_سطر("        " + ف4)

    اطبع_سطر("      </ul>")
    اطبع_سطر("    </nav>")

    # قسم المصادقة
    نص عنوان_مصادقة = وسم("h2"، "واجهات المصادقة")
    اطبع_سطر("    " + عنوان_مصادقة)
    اطبع_سطر("    <section>")

    طباعة_واجهة("تسجيل_الدخول"، "/api/auth/login"، "تسجيل الدخول"، "POST"، "بريد: نص وكلمة_سر: نص"، "رمز JWT"، 0، 2)
    طباعة_واجهة("تسجيل_جديد"، "/api/auth/register"، "إنشاء حساب"، "POST"، "اسم: نص وبريد: نص وكلمة_سر: نص"، "كائن مستخدم"، 0، 2)

    اطبع_سطر("    </section>")
    اطبع_سطر("  </body>")
    اطبع_سطر("  </html>")

    اطبع_سطر("")
    عرض_نتيجة("توليد صفحة HTML كاملة"، 1)
    اطبع_سطر("")
نهاية

# ---- اختبار 4: إحصائيات API ----

دالة اختبار_احصائيات()
    اطبع_سطر("=== إحصائيات واجهات API ===")
    اطبع_سطر("")

    # إحصائيات الطرق
    رقم عدد_GET = 4
    رقم عدد_POST = 5
    رقم عدد_PUT = 1
    رقم عدد_DELETE = 1
    رقم بتحقق = 8
    رقم بلا_تحقق = 4
    رقم إصدار_1 = 5
    رقم إصدار_2 = 7
    رقم إجمالي = 12

    نص ن_GET = لنص(عدد_GET)
    نص ن_POST = لنص(عدد_POST)
    نص ن_PUT = لنص(عدد_PUT)
    نص ن_DELETE = لنص(عدد_DELETE)

    اطبع_سطر("  ── توزيع الطرق ──")
    اطبع_سطر("  GET:    " + ن_GET)
    اطبع_سطر("  POST:   " + ن_POST)
    اطبع_سطر("  PUT:    " + ن_PUT)
    اطبع_سطر("  DELETE: " + ن_DELETE)
    اطبع_سطر("")

    نص بتحقق_ن = لنص(بتحقق)
    نص بلا_ن = لنص(بلا_تحقق)
    اطبع_سطر("  ── المصادقة ──")
    اطبع_سطر("  تتطلب مصادقة: " + بتحقق_ن)
    اطبع_سطر("  بلا مصادقة: " + بلا_ن)
    اطبع_سطر("")

    نص إ1_ن = لنص(إصدار_1)
    نص إ2_ن = لنص(إصدار_2)
    اطبع_سطر("  ── الإصدارات ──")
    اطبع_سطر("  v1: " + إ1_ن + " واجهة")
    اطبع_سطر("  v2: " + إ2_ن + " واجهة")
    اطبع_سطر("")

    # التحقق
    رقم مجموع_طرق = عدد_GET + عدد_POST + عدد_PUT + عدد_DELETE
    إذا (مجموع_طرق == إجمالي)
        عرض_نتيجة("مجموع الطرق صحيح"، 1)
    وإلا
        عرض_نتيجة("مجموع الطرق صحيح"، 0)
    نهاية

    رقم مجموع_مصادقة = بتحقق + بلا_تحقق
    إذا (مجموع_مصادقة == إجمالي)
        عرض_نتيجة("مجموع المصادقة صحيح"، 1)
    وإلا
        عرض_نتيجة("مجموع المصادقة صحيح"، 0)
    نهاية

    رقم مجموع_إصدارات = إصدار_1 + إصدار_2
    إذا (مجموع_إصدارات == إجمالي)
        عرض_نتيجة("مجموع الإصدارات صحيح"، 1)
    وإلا
        عرض_نتيجة("مجموع الإصدارات صحيح"، 0)
    نهاية

    # ملخص
    نص إجمالي_ن = لنص(إجمالي)
    اطبع_سطر("")
    اطبع_سطر("  ╔═══════════════════════════════╗")
    اطبع_سطر("  ║  ملخص توثيق واجهات API       ║")
    اطبع_سطر("  ╠═══════════════════════════════╣")
    اطبع_سطر("  ║  إجمالي الواجهات: " + إجمالي_ن + "        ║")
    اطبع_سطر("  ║  نسبة التوثيق: 100%          ║")
    اطبع_سطر("  ║  أقدم إصدار: v1              ║")
    اطبع_سطر("  ║  أحدث إصدار: v2              ║")
    اطبع_سطر("  ╚═══════════════════════════════╝")
    عرض_نتيجة("توليد الإحصائيات"، 1)
    اطبع_سطر("")
نهاية

