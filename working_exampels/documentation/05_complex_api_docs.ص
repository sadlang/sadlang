# ---- أدوات HTML ----

دالة عرض_نتيجة(نص وصف، رقم ناجح)
    إذا (ناجح == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

دالة نص وسم(نص اسم_و، نص محتوى)
    نص فتح = "<" + اسم_و + ">"
    نص غلق = "</" + اسم_و + ">"
    ارجع فتح + محتوى + غلق
نهاية

دالة نص وسم_صنف(نص اسم_و، نص صنف_و، نص محتوى)
    نص بداية = "<" + اسم_و
    نص وسط = بداية + " class=\""
    نص كامل = وسط + صنف_و
    نص فتح = كامل + "\">"
    نص غلق = "</" + اسم_و + ">"
    ارجع فتح + محتوى + غلق
نهاية

# ---- طباعة واجهة API مفردة ----

دالة طباعة_واجهة(نص اسم_و، نص مسار_و، نص وصف_و، نص طريقة_و، نص معاملات_و، نص استجابة_و، رقم مصادقة، رقم إصدار)
    نص عنوان = وسم("h3"، اسم_و)
    اطبع_سطر("      " + عنوان)

    نص طريقة_ع = وسم_صنف("span"، "method"، طريقة_و)
    نص مسار_ع = وسم("code"، مسار_و)
    اطبع_سطر("      " + طريقة_ع + " " + مسار_ع)

    نص وصف_ع = وسم("p"، وصف_و)
    اطبع_سطر("      " + وصف_ع)

    اطبع_سطر("      <div class=\"params\">")
    نص م_ع = وسم("dt"، "المعاملات")
    نص م_ق = وسم("dd"، معاملات_و)
    اطبع_سطر("        " + م_ع)
    اطبع_سطر("        " + م_ق)

    نص ر_ع = وسم("dt"، "الاستجابة")
    نص ر_ق = وسم("dd"، استجابة_و)
    اطبع_سطر("        " + ر_ع)
    اطبع_سطر("        " + ر_ق)

    إذا (مصادقة == 1)
        نص م_حالة = وسم_صنف("span"، "auth"، "مطلوب مصادقة")
        اطبع_سطر("        " + م_حالة)
    وإلا
        نص م_بلا = وسم_صنف("span"، "no-auth"، "بلا مصادقة")
        اطبع_سطر("        " + م_بلا)
    نهاية

    نص إصدار_ن = لنص(إصدار)
    نص إصدار_ع = وسم_صنف("span"، "version"، "v" + إصدار_ن)
    اطبع_سطر("        " + إصدار_ع)
    اطبع_سطر("      </div>")
    اطبع_سطر("      <hr/>")
نهاية

# ---- اختبار 1: تسجيل واجهات المستخدمين ----

دالة اختبار_واجهات_مستخدمين()
    اطبع_سطر("=== واجهات المستخدمين ===")
    اطبع_سطر("")

    رقم عداد = 0

    طباعة_واجهة("قائمة_المستخدمين"، "/api/users"، "جلب قائمة المستخدمين"، "GET"، "صفحة: رقم"، "مصفوفة مستخدمين"، 1، 2)
    عداد = عداد + 1

    طباعة_واجهة("مستخدم_واحد"، "/api/users/:id"، "جلب مستخدم بالمعرف"، "GET"، "id: رقم"، "كائن مستخدم"، 1، 2)
    عداد = عداد + 1

    طباعة_واجهة("إنشاء_مستخدم"، "/api/users"، "إنشاء مستخدم جديد"، "POST"، "اسم: نص وبريد: نص"، "كائن مستخدم"، 1، 2)
    عداد = عداد + 1

    طباعة_واجهة("تحديث_مستخدم"، "/api/users/:id"، "تحديث بيانات مستخدم"، "PUT"، "id: رقم وبيانات: كائن"، "كائن مستخدم"، 1، 2)
    عداد = عداد + 1

    طباعة_واجهة("حذف_مستخدم"، "/api/users/:id"، "حذف مستخدم"، "DELETE"، "id: رقم"، "رسالة نجاح"، 1، 2)
    عداد = عداد + 1

    اطبع_سطر("")
    نص عداد_ن = لنص(عداد)
    اطبع_سطر("  واجهات المستخدمين: " + عداد_ن)
    إذا (عداد == 5)
        عرض_نتيجة("تسجيل واجهات المستخدمين"، 1)
    وإلا
        عرض_نتيجة("تسجيل واجهات المستخدمين"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 2: واجهات المنتجات والطلبات ----

دالة اختبار_واجهات_منتجات()
