    اطبع_سطر("")

    رقم عداد = 0

    طباعة_واجهة("قائمة_المنتجات"، "/api/products"، "جلب المنتجات"، "GET"، "فئة: نص"، "مصفوفة منتجات"، 0، 1)
    عداد = عداد + 1

    طباعة_واجهة("منتج_واحد"، "/api/products/:id"، "جلب منتج بالمعرف"، "GET"، "id: رقم"، "كائن منتج"، 0، 1)
    عداد = عداد + 1

    طباعة_واجهة("إنشاء_منتج"، "/api/products"، "إضافة منتج جديد"، "POST"، "اسم: نص وسعر: رقم"، "كائن منتج"، 1، 1)
    عداد = عداد + 1

    طباعة_واجهة("قائمة_الطلبات"، "/api/orders"، "جلب طلبات المستخدم"، "GET"، "مستخدم: رقم"، "مصفوفة طلبات"، 1، 1)
    عداد = عداد + 1

    طباعة_واجهة("إنشاء_طلب"، "/api/orders"، "إنشاء طلب جديد"، "POST"، "منتجات: مصفوفة"، "كائن طلب"، 1، 1)
