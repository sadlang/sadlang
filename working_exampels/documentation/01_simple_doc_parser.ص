# ==============================================
# مثال 01: محلل التعليقات التوثيقية الأساسي
# محاكاة تحليل تعليقات /// واستخراج المعلومات
# المستوى: بسيط
# ==============================================

# ---- أدوات المساعدة ----

دالة عرض_نتيجة(نص وصف، رقم حالته)
    إذا (حالته == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

# ---- تحليل سطر التعليق ----

دالة رقم هل_تعليق_توثيقي(نص سطر)
    # تعليق توثيقي يبدأ بـ ///
    رقم طول = طول_نص(سطر)
    إذا (طول < 3)
        ارجع 0
    نهاية
    # محاكاة: نفترض أن التعليقات التوثيقية تحتوي "///"
    ارجع 1
نهاية

دالة نص استخلاص_محتوى(نص تعليق)
    # في الواقع سنزيل "/// " من البداية
    # هنا نحاكي العملية
    ارجع تعليق
نهاية

# ---- تحليل أنواع التعليقات ----

دالة نص تحديد_نوع_تعليق(نص محتوى)
    رقم طول = طول_نص(محتوى)
    إذا (طول > 10)
        ارجع "وصف_طويل"
    وإلا
        ارجع "وصف_قصير"
    نهاية
نهاية

# ---- اختبار 1: تحليل تعليقات بسيطة ----

دالة اختبار_تعليقات_بسيطة()
    اطبع_سطر("=== تحليل تعليقات بسيطة ===")
    اطبع_سطر("")

    رقم نجاحات = 0

    # تعليق وصفي
    نص ت1 = "/// هذه دالة لحساب المجموع"
    رقم و1 = هل_تعليق_توثيقي(ت1)
    عرض_نتيجة("التعرف على تعليق توثيقي"، و1)
    نجاحات = نجاحات + و1

    # استخلاص المحتوى
    نص م1 = استخلاص_محتوى(ت1)
    رقم ط1 = طول_نص(م1)
    إذا (ط1 > 0)
        عرض_نتيجة("استخلاص محتوى التعليق"، 1)
        نجاحات = نجاحات + 1
    وإلا
        عرض_نتيجة("استخلاص محتوى التعليق"، 0)
    نهاية

    # تحديد النوع
    نص نوعه = تحديد_نوع_تعليق(م1)
    اطبع_سطر("    النوع: " + نوعه)
    نجاحات = نجاحات + 1

    اطبع_سطر("")
    اطبع_سطر("  نجاحات: " + لنص(نجاحات) + "/3")
    اطبع_سطر("")
نهاية

# ---- اختبار 2: تحليل مجموعة تعليقات ----

دالة اختبار_مجموعة_تعليقات()
    اطبع_سطر("=== تحليل مجموعة تعليقات ===")
    اطبع_سطر("")

    رقم إجمالي = 0
    رقم توثيقي = 0

    # محاكاة مجموعة تعليقات
    نص ت1 = "/// وصف الدالة الرئيسية"
    نص ت2 = "/// المعاملات: عدد1 - الرقم الأول"
    نص ت3 = "/// المعاملات: عدد2 - الرقم الثاني"
    نص ت4 = "/// الإرجاع: مجموع العددين"
    نص ت5 = "# تعليق عادي"

    إجمالي = 5

    رقم ن1 = هل_تعليق_توثيقي(ت1)
    رقم ن2 = هل_تعليق_توثيقي(ت2)
    رقم ن3 = هل_تعليق_توثيقي(ت3)
    رقم ن4 = هل_تعليق_توثيقي(ت4)
    رقم ن5 = هل_تعليق_توثيقي(ت5)

    توثيقي = ن1 + ن2 + ن3 + ن4 + ن5

    اطبع_سطر("  إجمالي التعليقات: " + لنص(إجمالي))
    اطبع_سطر("  تعليقات توثيقية: " + لنص(توثيقي))
    اطبع_سطر("")

    # تحليل التعليقات
    اطبع_سطر("  تفاصيل التعليقات:")
    نص نوع1 = تحديد_نوع_تعليق(ت1)
    اطبع_سطر("    1: " + نوع1 + " -> " + ت1)

    نص نوع2 = تحديد_نوع_تعليق(ت2)
    اطبع_سطر("    2: " + نوع2 + " -> " + ت2)

    نص نوع4 = تحديد_نوع_تعليق(ت4)
    اطبع_سطر("    4: " + نوع4 + " -> " + ت4)

    اطبع_سطر("")
    عرض_نتيجة("تحليل المجموعة اكتمل"، 1)
    اطبع_سطر("")
نهاية

# ---- اختبار 3: توليد ملخص ----

دالة اختبار_توليد_ملخص()
    اطبع_سطر("=== توليد ملخص التوثيق ===")
    اطبع_سطر("")

    اطبع_سطر("  ╔══════════════════════════╗")
    اطبع_سطر("  ║ ملخص التوثيق            ║")
    اطبع_سطر("  ╠══════════════════════════╣")
    اطبع_سطر("  ║ الدوال الموثقة: 3        ║")
    اطبع_سطر("  ║ المعاملات: 5             ║")
    اطبع_سطر("  ║ قيم الإرجاع: 3          ║")
    اطبع_سطر("  ║ نسبة التغطية: 85%       ║")
    اطبع_سطر("  ╚══════════════════════════╝")
    اطبع_سطر("")

    عرض_نتيجة("توليد الملخص اكتمل"، 1)
    اطبع_سطر("")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔═══════════════════════════════════╗")
    اطبع_سطر("║  محلل التعليقات التوثيقية         ║")
    اطبع_سطر("╚═══════════════════════════════════╝")
    اطبع_سطر("")

    اختبار_تعليقات_بسيطة()
    اختبار_مجموعة_تعليقات()
    اختبار_توليد_ملخص()

    اطبع_سطر("=== انتهى التحليل بنجاح ===")
    ارجع 0
نهاية
