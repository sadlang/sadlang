# ---- أدوات مساعدة ----

دالة عرض_نتيجة(نص وصف، رقم ناجح)
    إذا (ناجح == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

دالة نص وسم(نص اسم_و، نص محتوى)
    نص فتح = "<" + اسم_و + ">"
    نص غلق = "</" + اسم_و + ">"
    ارجع فتح + محتوى + غلق
نهاية

# ---- بناء بطاقة توثيق دالة ----

دالة طباعة_بطاقة(نص اسم_د، نص الوصف، نص معاملات_د، نص نتيجة_د، نص تصنيف_د)
    اطبع_سطر("    ┌────────────────────────────────")
    اطبع_سطر("    │ الدالة: " + اسم_د)
    اطبع_سطر("    │ الوصف: " + الوصف)
    اطبع_سطر("    │ المعاملات: " + معاملات_د)
    اطبع_سطر("    │ الإرجاع: " + نتيجة_د)
    اطبع_سطر("    │ التصنيف: " + تصنيف_د)
    اطبع_سطر("    └────────────────────────────────")
نهاية

# ---- توليد HTML لبطاقة ----

دالة طباعة_بطاقة_html(نص اسم_د، نص الوصف، نص معاملات_د، نص نتيجة_د)
    نص عنوان = وسم("h3"، اسم_د)
    اطبع_سطر("      " + عنوان)

    نص وصف_ع = وسم("p"، الوصف)
    اطبع_سطر("      " + وصف_ع)

    نص م_ع = وسم("dt"، "المعاملات")
    نص م_ق = وسم("dd"، معاملات_د)
    اطبع_سطر("      " + م_ع)
    اطبع_سطر("      " + م_ق)

    نص ر_ع = وسم("dt"، "الإرجاع")
    نص ر_ق = وسم("dd"، نتيجة_د)
    اطبع_سطر("      " + ر_ع)
    اطبع_سطر("      " + ر_ق)
    اطبع_سطر("      <hr/>")
نهاية

# ---- تحليل تعليق توثيقي ----

دالة رقم هل_تعليق_وصفي(نص سطر)
    رقم طول = طول_نص(سطر)
    إذا (طول < 3)
        ارجع 0
    نهاية
    ارجع 1
نهاية

دالة نص استخرج_اسم(نص تعليق)
    # محاكاة: نفترض الاسم بعد "دالة "
    رقم طول = طول_نص(تعليق)
    إذا (طول > 5)
        ارجع تعليق
    نهاية
    ارجع "مجهول"
نهاية

# ---- اختبار 1: استخراج توثيق مكتبة الرياضيات ----

دالة اختبار_استخراج_رياضيات()
    اطبع_سطر("=== استخراج توثيق مكتبة الرياضيات ===")
    اطبع_سطر("")

    رقم عداد_دوال = 0

    # دالة 1
    طباعة_بطاقة("احسب_مجموع"، "يحسب مجموع عددين صحيحين"، "رقم أ، رقم ب"، "رقم"، "عام")
    عداد_دوال = عداد_دوال + 1

    # دالة 2
    طباعة_بطاقة("احسب_فرق"، "يحسب فرق عددين صحيحين"، "رقم أ، رقم ب"، "رقم"، "عام")
    عداد_دوال = عداد_دوال + 1

    # دالة 3
    طباعة_بطاقة("احسب_ضرب"، "يحسب حاصل ضرب عددين"، "رقم أ، رقم ب"، "رقم"، "عام")
    عداد_دوال = عداد_دوال + 1

    # دالة 4
    طباعة_بطاقة("_تحقق_صفر"، "يتحقق من القسمة على صفر"، "رقم قاسم"، "منطقي"، "محمي")
    عداد_دوال = عداد_دوال + 1

    # دالة 5
    طباعة_بطاقة("القيمة_المطلقة"، "يحسب القيمة المطلقة لعدد"، "رقم قيمة"، "رقم"، "عام")
    عداد_دوال = عداد_دوال + 1

    # دالة 6 - ثابت
    طباعة_بطاقة("باي"، "قيمة النسبة التقريبية"، "بلا معاملات"، "رقم"، "ثابت")
    عداد_دوال = عداد_دوال + 1

    اطبع_سطر("")
    نص عداد_ن = لنص(عداد_دوال)
    اطبع_سطر("  تم استخراج " + عداد_ن + " دالة")

    إذا (عداد_دوال == 6)
        عرض_نتيجة("استخراج دوال الرياضيات"، 1)
    وإلا
        عرض_نتيجة("استخراج دوال الرياضيات"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 2: توليد HTML ----

دالة اختبار_توليد_html()
    اطبع_سطر("=== توليد HTML للتوثيق ===")
    اطبع_سطر("")

    اطبع_سطر("  <!DOCTYPE html>")
    اطبع_سطر("  <html lang=\"ar\" dir=\"rtl\">")
    اطبع_سطر("  <head>")
    نص عنوان = وسم("title"، "توثيق مكتبة الرياضيات")
    اطبع_سطر("    " + عنوان)
    اطبع_سطر("  </head>")
    اطبع_سطر("  <body>")

    نص رأس = وسم("h1"، "مكتبة الرياضيات - التوثيق")
    اطبع_سطر("    " + رأس)

    اطبع_سطر("    <section>")
    طباعة_بطاقة_html("احسب_مجموع"، "يحسب مجموع عددين"، "رقم أ، رقم ب"، "رقم")
    طباعة_بطاقة_html("احسب_فرق"، "يحسب فرق عددين"، "رقم أ، رقم ب"، "رقم")
    طباعة_بطاقة_html("احسب_ضرب"، "يحسب حاصل ضرب عددين"، "رقم أ، رقم ب"، "رقم")
    طباعة_بطاقة_html("القيمة_المطلقة"، "يحسب القيمة المطلقة"، "رقم قيمة"، "رقم")
    اطبع_سطر("    </section>")

    اطبع_سطر("  </body>")
    اطبع_سطر("  </html>")

    اطبع_سطر("")
    عرض_نتيجة("توليد HTML"، 1)
    اطبع_سطر("")
نهاية

# ---- اختبار 3: إحصائيات التوثيق ----

دالة اختبار_احصائيات()
    اطبع_سطر("=== إحصائيات التوثيق ===")
    اطبع_سطر("")

    رقم إجمالي_دوال = 6
    رقم دوال_عامة = 4
    رقم دوال_محمية = 1
    رقم ثوابت = 1
    رقم موثقة = 6

    نص إجمالي_ن = لنص(إجمالي_دوال)
    نص عامة_ن = لنص(دوال_عامة)
    نص محمية_ن = لنص(دوال_محمية)
    نص ثوابت_ن = لنص(ثوابت)
    نص موثقة_ن = لنص(موثقة)

    اطبع_سطر("  إجمالي الدوال: " + إجمالي_ن)
    اطبع_سطر("  عامة: " + عامة_ن)
    اطبع_سطر("  محمية: " + محمية_ن)
    اطبع_سطر("  ثوابت: " + ثوابت_ن)
    اطبع_سطر("  موثقة: " + موثقة_ن)

    # حساب نسبة التوثيق
    رقم نسبة = (موثقة * 100) / إجمالي_دوال
    نص نسبة_ن = لنص(نسبة)
    اطبع_سطر("  نسبة التوثيق: " + نسبة_ن + "%")

    اطبع_سطر("")
    إذا (نسبة == 100)
        عرض_نتيجة("نسبة التوثيق كاملة"، 1)
    وإلا
        عرض_نتيجة("نسبة التوثيق كاملة"، 0)
    نهاية

    # تحقق من اكتمال أنواع التصنيف
    رقم مجموع_تصنيفات = دوال_عامة + دوال_محمية + ثوابت
    إذا (مجموع_تصنيفات == إجمالي_دوال)
        عرض_نتيجة("تصنيفات مكتملة"، 1)
    وإلا
        عرض_نتيجة("تصنيفات مكتملة"، 0)
    نهاية

    # حساب أطول اسم دالة
    رقم طول1 = طول_نص("احسب_مجموع")
    رقم طول2 = طول_نص("احسب_فرق")
    رقم طول3 = طول_نص("القيمة_المطلقة")
    رقم طول4 = طول_نص("_تحقق_صفر")

    رقم أطول = طول1
    إذا (طول3 > أطول)
        أطول = طول3
    نهاية
    إذا (طول4 > أطول)
        أطول = طول4
    نهاية

    نص أطول_ن = لنص(أطول)
    اطبع_سطر("  أطول اسم دالة: " + أطول_ن + " حرف")
    عرض_نتيجة("حساب الإحصائيات"، 1)
    اطبع_سطر("")
نهاية

# ---- اختبار 4: تحليل تعليقات توثيقية ----

دالة اختبار_تحليل_تعليقات()
    اطبع_سطر("=== تحليل التعليقات التوثيقية ===")
    اطبع_سطر("")

    # تعليق 1
    نص ت1 = "/// يحسب مجموع عددين صحيحين"
    رقم ه1 = هل_تعليق_وصفي(ت1)
    إذا (ه1 == 1)
        عرض_نتيجة("تعليق توثيقي: مجموع"، 1)
    وإلا
        عرض_نتيجة("تعليق توثيقي: مجموع"، 0)
    نهاية

    # تعليق 2
    نص ت2 = "/// @معامل أ العدد الأول"
    رقم ه2 = هل_تعليق_وصفي(ت2)
    إذا (ه2 == 1)
        عرض_نتيجة("تعليق معامل"، 1)
    وإلا
        عرض_نتيجة("تعليق معامل"، 0)
    نهاية

    # تعليق 3
    نص ت3 = "/// @ارجاع مجموع العددين"
    رقم ه3 = هل_تعليق_وصفي(ت3)
    إذا (ه3 == 1)
        عرض_نتيجة("تعليق إرجاع"، 1)
    وإلا
        عرض_نتيجة("تعليق إرجاع"، 0)
    نهاية

    # تعليق قصير جداً
    نص ت4 = "//"
    رقم ه4 = هل_تعليق_وصفي(ت4)
    إذا (ه4 == 0)
        عرض_نتيجة("رفض تعليق قصير"، 1)
    وإلا
        عرض_نتيجة("رفض تعليق قصير"، 0)
    نهاية

    # استخراج اسم
    نص اسم1 = استخرج_اسم("دالة احسب_مجموع")
    رقم طول_ا = طول_نص(اسم1)
    إذا (طول_ا > 5)
        عرض_نتيجة("استخراج اسم الدالة"، 1)
    وإلا
        عرض_نتيجة("استخراج اسم الدالة"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔════════════════════════════════════════╗")
    اطبع_سطر("║  نظام استخراج التوثيق من الشفرة       ║")
    اطبع_سطر("╚════════════════════════════════════════╝")
    اطبع_سطر("")

    اختبار_استخراج_رياضيات()
    اختبار_توليد_html()
    اختبار_احصائيات()
    اختبار_تحليل_تعليقات()

    اطبع_سطر("=== انتهى الاستخراج بنجاح ===")
    ارجع 0
نهاية
