# ---- أدوات مساعدة ----

دالة عرض_نتيجة(نص وصف، رقم ناجح)
    إذا (ناجح == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

دالة نص وسم(نص اسم_و، نص محتوى)
    نص فتح = "<" + اسم_و + ">"
    نص غلق = "</" + اسم_و + ">"
    ارجع فتح + محتوى + غلق
نهاية

# ---- محاكاة تنفيذ مثال رياضي ----

دالة رقم نفذ_جمع(رقم أ، رقم ب)
    ارجع أ + ب
نهاية

دالة رقم نفذ_ضرب(رقم أ، رقم ب)
    ارجع أ * ب
نهاية

دالة رقم نفذ_طرح(رقم أ، رقم ب)
    ارجع أ - ب
نهاية

دالة رقم نفذ_قسمة(رقم أ، رقم ب)
    إذا (ب == 0)
        ارجع 0
    نهاية
    ارجع أ / ب
نهاية

دالة رقم نفذ_باقي(رقم أ، رقم ب)
    إذا (ب == 0)
        ارجع 0
    نهاية
    ارجع أ % ب
نهاية

# ---- محاكاة تنفيذ مثال نصي ----

دالة رقم نفذ_طول(نص قيمة_ن)
    ارجع طول_نص(قيمة_ن)
نهاية

# ---- اختبار مثال واحد ----

دالة رقم اختبر_رياضي(نص اسم_م، نص كود_م، رقم فعلي، رقم متوقع)
    نص متوقع_ن = لنص(متوقع)
    نص فعلي_ن = لنص(فعلي)

    إذا (فعلي == متوقع)
        عرض_نتيجة(اسم_م، 1)
        اطبع_سطر("      الكود: " + كود_م)
        اطبع_سطر("      المتوقع: " + متوقع_ن + " | الفعلي: " + فعلي_ن + " ✓")
        ارجع 1
    وإلا
        عرض_نتيجة(اسم_م، 0)
        اطبع_سطر("      الكود: " + كود_م)
        اطبع_سطر("      المتوقع: " + متوقع_ن + " | الفعلي: " + فعلي_ن + " ✗")
        ارجع 0
    نهاية
نهاية

# ---- توليد HTML لمثال ----

دالة طباعة_مثال_html(نص اسم_م، نص كود_م، نص فئة_م، رقم ناجح)
    نص عنوان = وسم("h4"، اسم_م)
    اطبع_سطر("        " + عنوان)

    نص فئة_ع = وسم("span"، "[" + فئة_م + "]")
    اطبع_سطر("        " + فئة_ع)

    نص كود_ع = وسم("pre"، كود_م)
    اطبع_سطر("        " + كود_ع)

    إذا (ناجح == 1)
        نص نجاح_ع = وسم("mark"، "نجح ✓")
        اطبع_سطر("        " + نجاح_ع)
    وإلا
        نص فشل_ع = وسم("mark"، "فشل ✗")
        اطبع_سطر("        " + فشل_ع)
    نهاية
نهاية

# ---- اختبار 1: أمثلة الجمع والطرح ----

دالة اختبار_جمع_وطرح()
    اطبع_سطر("=== أمثلة الجمع والطرح ===")
    اطبع_سطر("")

    رقم ناجحة = 0

    رقم ن1 = نفذ_جمع(5، 3)
    رقم ر1 = اختبر_رياضي("جمع 5 + 3"، "رقم ن = 5 + 3"، ن1، 8)
    ناجحة = ناجحة + ر1

    رقم ن2 = نفذ_جمع(100، 200)
    رقم ر2 = اختبر_رياضي("جمع 100 + 200"، "رقم ن = 100 + 200"، ن2، 300)
    ناجحة = ناجحة + ر2

    رقم ن3 = نفذ_جمع(0، 0)
    رقم ر3 = اختبر_رياضي("جمع 0 + 0"، "رقم ن = 0 + 0"، ن3، 0)
    ناجحة = ناجحة + ر3

    رقم ن4 = نفذ_طرح(10، 4)
    رقم ر4 = اختبر_رياضي("طرح 10 - 4"، "رقم ن = 10 - 4"، ن4، 6)
    ناجحة = ناجحة + ر4

    رقم ن5 = نفذ_طرح(50، 50)
    رقم ر5 = اختبر_رياضي("طرح 50 - 50"، "رقم ن = 50 - 50"، ن5، 0)
    ناجحة = ناجحة + ر5

    اطبع_سطر("")
    نص ناجحة_ن = لنص(ناجحة)
    اطبع_سطر("  نتائج الجمع والطرح: " + ناجحة_ن + "/5")

    إذا (ناجحة == 5)
        عرض_نتيجة("كل أمثلة الجمع والطرح"، 1)
    وإلا
        عرض_نتيجة("كل أمثلة الجمع والطرح"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 2: أمثلة الضرب والقسمة ----

دالة اختبار_ضرب_وقسمة()
    اطبع_سطر("=== أمثلة الضرب والقسمة ===")
    اطبع_سطر("")

    رقم ناجحة = 0

    رقم ن1 = نفذ_ضرب(4، 7)
    رقم ر1 = اختبر_رياضي("ضرب 4 * 7"، "رقم ن = 4 * 7"، ن1، 28)
    ناجحة = ناجحة + ر1

    رقم ن2 = نفذ_ضرب(0، 999)
    رقم ر2 = اختبر_رياضي("ضرب 0 * 999"، "رقم ن = 0 * 999"، ن2، 0)
    ناجحة = ناجحة + ر2

    رقم ن3 = نفذ_قسمة(20، 4)
    رقم ر3 = اختبر_رياضي("قسمة 20 / 4"، "رقم ن = 20 / 4"، ن3، 5)
    ناجحة = ناجحة + ر3

    رقم ن4 = نفذ_قسمة(100، 10)
    رقم ر4 = اختبر_رياضي("قسمة 100 / 10"، "رقم ن = 100 / 10"، ن4، 10)
    ناجحة = ناجحة + ر4

    رقم ن5 = نفذ_باقي(17، 5)
    رقم ر5 = اختبر_رياضي("باقي 17 % 5"، "رقم ن = 17 % 5"، ن5، 2)
    ناجحة = ناجحة + ر5

    اطبع_سطر("")
    نص ناجحة_ن = لنص(ناجحة)
    اطبع_سطر("  نتائج الضرب والقسمة: " + ناجحة_ن + "/5")

    إذا (ناجحة == 5)
        عرض_نتيجة("كل أمثلة الضرب والقسمة"، 1)
    وإلا
        عرض_نتيجة("كل أمثلة الضرب والقسمة"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 3: أمثلة النصوص ----

دالة اختبار_نصوص()
    اطبع_سطر("=== أمثلة النصوص ===")
    اطبع_سطر("")

    رقم ناجحة = 0

    رقم ط1 = نفذ_طول("مرحبا")
    رقم ر1 = اختبر_رياضي("طول مرحبا"، "طول_نص(مرحبا)"، ط1، 5)
    ناجحة = ناجحة + ر1

    رقم ط2 = نفذ_طول("")
    رقم ر2 = اختبر_رياضي("طول نص فارغ"، "طول_نص(فارغ)"، ط2، 0)
    ناجحة = ناجحة + ر2

    رقم ط3 = نفذ_طول("سلام عليكم ورحمة الله")
    إذا (ط3 > 10)
        عرض_نتيجة("طول جملة طويلة"، 1)
        ناجحة = ناجحة + 1
    وإلا
        عرض_نتيجة("طول جملة طويلة"، 0)
    نهاية

    اطبع_سطر("")
    نص ناجحة_ن = لنص(ناجحة)
    اطبع_سطر("  نتائج النصوص: " + ناجحة_ن + "/3")

    إذا (ناجحة == 3)
        عرض_نتيجة("كل أمثلة النصوص"، 1)
    وإلا
        عرض_نتيجة("كل أمثلة النصوص"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 4: توليد صفحة HTML ----

دالة اختبار_توليد_html()
    اطبع_سطر("=== توليد صفحة أمثلة HTML ===")
    اطبع_سطر("")

    اطبع_سطر("  <!DOCTYPE html>")
    اطبع_سطر("  <html lang=\"ar\" dir=\"rtl\">")
    اطبع_سطر("  <head>")
    نص عنوان = وسم("title"، "أمثلة توثيقية تفاعلية")
    اطبع_سطر("    " + عنوان)
    اطبع_سطر("  </head>")
    اطبع_سطر("  <body>")

    نص رأس = وسم("h1"، "مكتبة الأمثلة التفاعلية")
    اطبع_سطر("    " + رأس)

    # فهرس الفئات
    نص ف_عنوان = وسم("h2"، "الفئات")
    اطبع_سطر("    " + ف_عنوان)
    اطبع_سطر("    <ul>")
    نص فئ1 = وسم("li"، "رياضيات")
    نص فئ2 = وسم("li"، "نصوص")
    نص فئ3 = وسم("li"، "منطق")
    اطبع_سطر("      " + فئ1)
    اطبع_سطر("      " + فئ2)
    اطبع_سطر("      " + فئ3)
    اطبع_سطر("    </ul>")

    # أمثلة الرياضيات
    نص أ_عنوان = وسم("h2"، "أمثلة الرياضيات")
    اطبع_سطر("    " + أ_عنوان)
    اطبع_سطر("    <section>")

    طباعة_مثال_html("جمع عددين"، "رقم ن = 5 + 3"، "رياضيات"، 1)
    طباعة_مثال_html("ضرب عددين"، "رقم ن = 4 * 7"، "رياضيات"، 1)
    طباعة_مثال_html("قسمة"، "رقم ن = 20 / 4"، "رياضيات"، 1)
    طباعة_مثال_html("باقي القسمة"، "رقم ن = 17 % 5"، "رياضيات"، 1)

    اطبع_سطر("    </section>")

    # أمثلة النصوص
    نص ن_عنوان = وسم("h2"، "أمثلة النصوص")
    اطبع_سطر("    " + ن_عنوان)
    اطبع_سطر("    <section>")

    طباعة_مثال_html("طول نص"، "طول_نص(مرحبا)"، "نصوص"، 1)
    طباعة_مثال_html("نص فارغ"، "طول_نص(فارغ)"، "نصوص"، 1)

    اطبع_سطر("    </section>")

    اطبع_سطر("  </body>")
    اطبع_سطر("  </html>")

    اطبع_سطر("")
    عرض_نتيجة("توليد صفحة HTML"، 1)
    اطبع_سطر("")
نهاية

# ---- اختبار 5: الملخص الشامل ----

دالة اختبار_ملخص()
    اطبع_سطر("=== الملخص الشامل ===")
    اطبع_سطر("")

    رقم أمثلة_رياضيات = 10
    رقم أمثلة_نصوص = 3
    رقم أمثلة_منطق = 0
    رقم إجمالي = أمثلة_رياضيات + أمثلة_نصوص + أمثلة_منطق
    رقم ناجحة = إجمالي
    رقم فاشلة = 0

    نص إجمالي_ن = لنص(إجمالي)
    نص ناجحة_ن = لنص(ناجحة)
    نص فاشلة_ن = لنص(فاشلة)
    نص رياضي_ن = لنص(أمثلة_رياضيات)
    نص نصوص_ن = لنص(أمثلة_نصوص)

    اطبع_سطر("  ╔═══════════════════════════════════╗")
    اطبع_سطر("  ║  تقرير الأمثلة التوثيقية        ║")
    اطبع_سطر("  ╠═══════════════════════════════════╣")
    اطبع_سطر("  ║  إجمالي الأمثلة: " + إجمالي_ن + "            ║")
    اطبع_سطر("  ║  ناجحة: " + ناجحة_ن + "                    ║")
    اطبع_سطر("  ║  فاشلة: " + فاشلة_ن + "                     ║")

    إذا (إجمالي > 0)
        رقم نسبة = (ناجحة * 100) / إجمالي
        نص نسبة_ن = لنص(نسبة)
        اطبع_سطر("  ║  نسبة النجاح: " + نسبة_ن + "%          ║")
    نهاية

    اطبع_سطر("  ╠═══════════════════════════════════╣")
    اطبع_سطر("  ║  رياضيات: " + رياضي_ن + " مثال           ║")
    اطبع_سطر("  ║  نصوص: " + نصوص_ن + " مثال                ║")
    اطبع_سطر("  ║  عدد الفئات: 3                  ║")
    اطبع_سطر("  ╚═══════════════════════════════════╝")

    اطبع_سطر("")
    إذا (فاشلة == 0)
        عرض_نتيجة("جميع الاختبارات ناجحة"، 1)
    وإلا
        عرض_نتيجة("جميع الاختبارات ناجحة"، 0)
    نهاية
    اطبع_سطر("")
نهاية

