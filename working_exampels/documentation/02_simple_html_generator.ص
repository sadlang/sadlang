# ==============================================
# مثال 02: مولد صفحات HTML من التوثيق
# محاكاة تحويل التوثيق إلى صفحات HTML
# المستوى: بسيط
# ==============================================

# ---- أدوات HTML ----

دالة نص وسم_فتح(نص اسم_و)
    ارجع "<" + اسم_و + ">"
نهاية

دالة نص وسم_غلق(نص اسم_و)
    ارجع "</" + اسم_و + ">"
نهاية

دالة نص عنصر_كامل(نص اسم_و، نص محتوى)
    نص فتح = وسم_فتح(اسم_و)
    نص غلق = وسم_غلق(اسم_و)
    ارجع فتح + محتوى + غلق
نهاية

# ---- تقرير ----

دالة عرض_حالة(نص وصف، رقم ناجح)
    إذا (ناجح == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

# ---- توليد عناصر ----

دالة طباعة_عنوان(نص عنوان_د)
    نص ع = عنصر_كامل("h2"، عنوان_د)
    اطبع_سطر("    " + ع)
نهاية

دالة طباعة_فقرة(نص وصف_د)
    نص ف = عنصر_كامل("p"، وصف_د)
    اطبع_سطر("    " + ف)
نهاية

دالة طباعة_معامل(نص اسم_م، نص نوع_م، نص وصف_م)
    نص ا = عنصر_كامل("code"، اسم_م)
    نص ن = عنصر_كامل("em"، نوع_م)
    نص جزء1 = ا + " ("
    نص جزء2 = جزء1 + ن
    نص جزء3 = جزء2 + "): "
    نص جزء4 = جزء3 + وصف_م
    نص سطر = عنصر_كامل("li"، جزء4)
    اطبع_سطر("      " + سطر)
نهاية

دالة طباعة_ارجاع(نص نوع_ر، نص وصف_ر)
    نص كود = عنصر_كامل("code"، نوع_ر)
    نص جزء1 = "الإرجاع: " + كود
    نص جزء2 = جزء1 + " - " + وصف_ر
    نص سطر = عنصر_كامل("p"، جزء2)
    اطبع_سطر("    " + سطر)
نهاية

# ---- اختبار 1: توليد وثيقة ----

دالة اختبار_وثيقة()
    اطبع_سطر("=== توليد وثيقة بسيطة ===")
    اطبع_سطر("")
    اطبع_سطر("  HTML المُولَّد:")
    اطبع_سطر("  ─────────────")

    طباعة_عنوان("دالة احسب_المجموع")
    طباعة_فقرة("تحسب مجموع عددين صحيحين")

    اطبع_سطر("    <ul>")
    طباعة_معامل("عدد1"، "عدد_صحيح"، "العدد الأول")
    طباعة_معامل("عدد2"، "عدد_صحيح"، "العدد الثاني")
    اطبع_سطر("    </ul>")

    طباعة_ارجاع("عدد_صحيح"، "مجموع العددين")

    اطبع_سطر("")
    عرض_حالة("توليد الوثيقة البسيطة"، 1)
    اطبع_سطر("")
نهاية

# ---- اختبار 2: توليد فهرس ----

دالة اختبار_فهرس()
    اطبع_سطر("=== توليد فهرس الوثائق ===")
    اطبع_سطر("")
    اطبع_سطر("  HTML الفهرس:")
    اطبع_سطر("  ────────────")

    نص عنوان_ص = عنصر_كامل("h1"، "توثيق مكتبة الرياضيات")
    اطبع_سطر("  " + عنوان_ص)

    اطبع_سطر("  <nav>")
    اطبع_سطر("    <ul>")

    نص ر1 = عنصر_كامل("a"، "احسب_المجموع")
    نص ر2 = عنصر_كامل("a"، "احسب_الفرق")
    نص ر3 = عنصر_كامل("a"، "احسب_الضرب")
    نص ر4 = عنصر_كامل("a"، "احسب_القسمة")

    نص ع1 = عنصر_كامل("li"، ر1)
    نص ع2 = عنصر_كامل("li"، ر2)
    نص ع3 = عنصر_كامل("li"، ر3)
    نص ع4 = عنصر_كامل("li"، ر4)

    اطبع_سطر("      " + ع1)
    اطبع_سطر("      " + ع2)
    اطبع_سطر("      " + ع3)
    اطبع_سطر("      " + ع4)

    اطبع_سطر("    </ul>")
    اطبع_سطر("  </nav>")

    اطبع_سطر("")
    رقم عدد_دوال = 4
    نص عدد_ن = لنص(عدد_دوال)
    اطبع_سطر("  عدد الدوال في الفهرس: " + عدد_ن)
    عرض_حالة("توليد الفهرس"، 1)
    اطبع_سطر("")
نهاية

# ---- اختبار 3: التحقق من الوسوم ----

دالة اختبار_وسوم()
    اطبع_سطر("=== التحقق من صحة الوسوم ===")
    اطبع_سطر("")

    رقم نجاحات = 0

    # فحص وسم كامل
    نص ك1 = عنصر_كامل("div"، "محتوى")
    رقم ط1 = طول_نص(ك1)
    إذا (ط1 > 10)
        عرض_حالة("وسم div صحيح"، 1)
        نجاحات = نجاحات + 1
    وإلا
        عرض_حالة("وسم div صحيح"، 0)
    نهاية

    # فحص وسم فتح
    نص ف1 = وسم_فتح("span")
    اطبع_سطر("    وسم فتح: " + ف1)
    نجاحات = نجاحات + 1

    # فحص وسم غلق
    نص غ1 = وسم_غلق("span")
    اطبع_سطر("    وسم غلق: " + غ1)
    نجاحات = نجاحات + 1

    # فحص تداخل
    نص فرعي = عنصر_كامل("strong"، "مهم")
    نص احتواء = عنصر_كامل("p"، فرعي)
    اطبع_سطر("    متداخل: " + احتواء)
    نجاحات = نجاحات + 1

    اطبع_سطر("")
    نص عدد_ن = لنص(نجاحات)
    اطبع_سطر("  نجاحات: " + عدد_ن + "/4")
    اطبع_سطر("")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔═══════════════════════════════════╗")
    اطبع_سطر("║  مولد صفحات HTML من التوثيق       ║")
    اطبع_سطر("╚═══════════════════════════════════╝")
    اطبع_سطر("")

    اختبار_وثيقة()
    اختبار_فهرس()
    اختبار_وسوم()

    اطبع_سطر("=== انتهى التوليد بنجاح ===")
    ارجع 0
نهاية
