# مثال 02: المتغيرات والعمليات الحسابية
# الهدف: التعرف على المتغيرات والعمليات الرياضية البسيطة

دالة رئيسية()
    # أعداد صحيحة
    رقم س = 10
    رقم ص = 20
    
    اطبع("س = ")
    اطبع(س)
    اطبع("ص = ")
    اطبع(ص)
    
    # عمليات حسابية
    رقم جمع = س + ص
    رقم طرح = ص - س
    رقم ضرب = س * ص
    رقم قسمة = ص / س
    
    اطبع("الجمع: ")
    اطبع(جمع)
    اطبع("الطرح: ")
    اطبع(طرح)
    اطبع("الضرب: ")
    اطبع(ضرب)
    اطبع("القسمة: ")
    اطبع(قسمة)
نهاية
