# مثال 02: المتغيرات والعمليات الحسابية البسيطة
# الهدف: تعريف متغيرات وإجراء عمليات حسابية

دالة رئيسية()
    # متغيرات رقمية صحيحة
    رقم عدد1 = 10
    رقم عدد2 = 20
    
    اطبع("عدد1 = ")
    اطبع_سطر(عدد1)
    اطبع("عدد2 = ")
    اطبع_سطر(عدد2)
    
    # عملية الجمع
    رقم المجموع = عدد1 + عدد2
    اطبع("المجموع = ")
    اطبع_سطر(المجموع)
    
    # عملية الطرح
    رقم الفرق = عدد2 - عدد1
    اطبع("الفرق = ")
    اطبع_سطر(الفرق)
    
    # عملية الضرب
    رقم الضرب = عدد1 * 3
    اطبع("10 × 3 = ")
    اطبع_سطر(الضرب)
