# مثال 05: نظام محاكاة المهام المتزامنة المعقد
# محاكاة جدولة مهام مع أولويات وتتبع حالة
# المستوى: معقد
# ==============================================

# ---- أدوات المساعدة ----

دالة عرض_نتيجة(نص وصف، رقم ناجح)
    إذا (ناجح == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

# ---- محاكاة مهمة ----

دالة رقم نفذ_مهمة_حساب(رقم عمليات)
    رقم نتيجة = 0
    رقم م = 0
    طالما (م < عمليات)
        نتيجة = نتيجة + م * 2
        م = م + 1
    نهاية
    ارجع نتيجة
نهاية

دالة رقم نفذ_مهمة_بحث(رقم عدد_عناصر، رقم هدف)
    رقم م = 0
    طالما (م < عدد_عناصر)
        إذا (م == هدف)
            ارجع م
        نهاية
        م = م + 1
    نهاية
    ارجع 0 - 1
نهاية

دالة رقم نفذ_مهمة_فرز(رقم عدد_عناصر)
    # محاكاة فرز - إرجاع عدد المقارنات
    رقم مقارنات = 0
    رقم م = 0
    طالما (م < عدد_عناصر)
        رقم ج = 0
        طالما (ج < عدد_عناصر - م - 1)
            مقارنات = مقارنات + 1
            ج = ج + 1
        نهاية
        م = م + 1
    نهاية
    ارجع مقارنات
نهاية

# ---- جدولة المهام ----

دالة طباعة_مهمة(نص اسم_م، رقم أولوية، نص حالة_م)
    نص أولوية_ن = لنص(أولوية)
    اطبع_سطر("    │ " + اسم_م + " [أولوية:" + أولوية_ن + "] - " + حالة_م)
نهاية

دالة رقم تنفيذ_بأولوية(رقم أولوية، رقم عمليات)
    # مهام ذات أولوية أعلى تنفذ المزيد
    رقم عمليات_فعلية = عمليات * أولوية
    ارجع نفذ_مهمة_حساب(عمليات_فعلية)
نهاية

# ---- اختبار 1: تنفيذ مهام بسيطة ----

دالة اختبار_مهام_بسيطة()
    اطبع_سطر("=== تنفيذ مهام بسيطة ===")
    اطبع_سطر("")

    رقم ن1 = نفذ_مهمة_حساب(10)
    نص ن1_ن = لنص(ن1)
    اطبع_سطر("  مهمة حساب (10 عمليات): " + ن1_ن)
    إذا (ن1 > 0)
        عرض_نتيجة("مهمة حساب"، 1)
    وإلا
        عرض_نتيجة("مهمة حساب"، 0)
    نهاية

    رقم ن2 = نفذ_مهمة_بحث(20، 15)
    نص ن2_ن = لنص(ن2)
    اطبع_سطر("  مهمة بحث عن 15 في 20 عنصر: " + ن2_ن)
    إذا (ن2 == 15)
        عرض_نتيجة("مهمة بحث ناجح"، 1)
    وإلا
        عرض_نتيجة("مهمة بحث ناجح"، 0)
    نهاية

    رقم ن3 = نفذ_مهمة_بحث(10، 20)
    إذا (ن3 < 0)
        عرض_نتيجة("مهمة بحث فاشل"، 1)
    وإلا
        عرض_نتيجة("مهمة بحث فاشل"، 0)
    نهاية

    رقم ن4 = نفذ_مهمة_فرز(5)
    نص ن4_ن = لنص(ن4)
    اطبع_سطر("  مهمة فرز (5 عناصر) مقارنات: " + ن4_ن)
    إذا (ن4 == 10)
        عرض_نتيجة("مهمة فرز"، 1)
    وإلا
        عرض_نتيجة("مهمة فرز"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 2: جدولة بأولويات ----

دالة اختبار_جدولة()
    اطبع_سطر("=== جدولة المهام بأولويات ===")
    اطبع_سطر("")

    اطبع_سطر("    ┌────────────────────────────────")
    طباعة_مهمة("حساب_عاجل"، 3، "مكتمل")
    طباعة_مهمة("بحث_عادي"، 2، "منتظر")
    طباعة_مهمة("فرز_منخفض"، 1، "منتظر")
    طباعة_مهمة("نسخ_احتياطي"، 1، "مجدول")
    طباعة_مهمة("تحديث_فهرس"، 2، "قيد_التنفيذ")
    اطبع_سطر("    └────────────────────────────────")
    اطبع_سطر("")

    # تنفيذ بأولوية
    رقم ن1 = تنفيذ_بأولوية(3، 5)
    رقم ن2 = تنفيذ_بأولوية(2، 5)
    رقم ن3 = تنفيذ_بأولوية(1، 5)

    نص ن1_ن = لنص(ن1)
    نص ن2_ن = لنص(ن2)
    نص ن3_ن = لنص(ن3)

    اطبع_سطر("  نتائج التنفيذ:")
    اطبع_سطر("    أولوية 3: " + ن1_ن)
    اطبع_سطر("    أولوية 2: " + ن2_ن)
    اطبع_سطر("    أولوية 1: " + ن3_ن)

    إذا (ن1 > ن2)
        عرض_نتيجة("أولوية أعلى = عمل أكثر"، 1)
    وإلا
        عرض_نتيجة("أولوية أعلى = عمل أكثر"، 0)
    نهاية

    إذا (ن2 > ن3)
        عرض_نتيجة("ترتيب الأولويات صحيح"، 1)
    وإلا
        عرض_نتيجة("ترتيب الأولويات صحيح"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 3: محاكاة تنافس ----

دالة اختبار_تنافس()
    اطبع_سطر("=== محاكاة تنافس المهام ===")
    اطبع_سطر("")

    # 3 مهام تتنافس على المعالج
    رقم دورة = 0
    رقم مهمة1_تقدم = 0
    رقم مهمة2_تقدم = 0
    رقم مهمة3_تقدم = 0
    رقم مهمة1_هدف = 15
    رقم مهمة2_هدف = 10
    رقم مهمة3_هدف = 20

    طالما (دورة < 10)
        # كل دورة تتقدم كل مهمة
        مهمة1_تقدم = مهمة1_تقدم + 2
        مهمة2_تقدم = مهمة2_تقدم + 3
        مهمة3_تقدم = مهمة3_تقدم + 1
        دورة = دورة + 1
    نهاية

    نص ت1_ن = لنص(مهمة1_تقدم)
    نص ت2_ن = لنص(مهمة2_تقدم)
    نص ت3_ن = لنص(مهمة3_تقدم)
    نص هد1_ن = لنص(مهمة1_هدف)
    نص هد2_ن = لنص(مهمة2_هدف)
    نص هد3_ن = لنص(مهمة3_هدف)

    اطبع_سطر("  المهمة 1: " + ت1_ن + "/" + هد1_ن)
    اطبع_سطر("  المهمة 2: " + ت2_ن + "/" + هد2_ن)
    اطبع_سطر("  المهمة 3: " + ت3_ن + "/" + هد3_ن)

    إذا (مهمة1_تقدم >= مهمة1_هدف)
        عرض_نتيجة("المهمة 1 اكتملت"، 1)
    وإلا
        عرض_نتيجة("المهمة 1 اكتملت"، 0)
    نهاية

    إذا (مهمة2_تقدم >= مهمة2_هدف)
        عرض_نتيجة("المهمة 2 اكتملت"، 1)
    وإلا
        عرض_نتيجة("المهمة 2 اكتملت"، 0)
    نهاية

    إذا (مهمة3_تقدم < مهمة3_هدف)
        عرض_نتيجة("المهمة 3 لم تكتمل (متوقع)"، 1)
    وإلا
        عرض_نتيجة("المهمة 3 لم تكتمل (متوقع)"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- اختبار 4: إحصائيات الجدولة ----

دالة اختبار_احصائيات()
    اطبع_سطر("=== إحصائيات الجدولة ===")
    اطبع_سطر("")

    رقم مهام_مكتملة = 7
    رقم مهام_منتظرة = 3
    رقم مهام_ملغاة = 1
    رقم إجمالي = مهام_مكتملة + مهام_منتظرة + مهام_ملغاة

    نص مكتملة_ن = لنص(مهام_مكتملة)
    نص منتظرة_ن = لنص(مهام_منتظرة)
    نص ملغاة_ن = لنص(مهام_ملغاة)
    نص إجمالي_ن = لنص(إجمالي)

    اطبع_سطر("  ╔═════════════════════════════════╗")
    اطبع_سطر("  ║  تقرير المهام المتزامنة       ║")
    اطبع_سطر("  ╠═════════════════════════════════╣")
    اطبع_سطر("  ║  مكتملة: " + مكتملة_ن + "                  ║")
    اطبع_سطر("  ║  منتظرة: " + منتظرة_ن + "                  ║")
    اطبع_سطر("  ║  ملغاة: " + ملغاة_ن + "                   ║")
    اطبع_سطر("  ║  إجمالي: " + إجمالي_ن + "                 ║")

    رقم نسبة = (مهام_مكتملة * 100) / إجمالي
    نص نسبة_ن = لنص(نسبة)
    اطبع_سطر("  ║  نسبة الإنجاز: " + نسبة_ن + "%         ║")
    اطبع_سطر("  ╚═════════════════════════════════╝")

    إذا (إجمالي == 11)
        عرض_نتيجة("إجمالي المهام صحيح"، 1)
    وإلا
        عرض_نتيجة("إجمالي المهام صحيح"، 0)
    نهاية

    إذا (نسبة > 60)
        عرض_نتيجة("نسبة الإنجاز جيدة"، 1)
    وإلا
        عرض_نتيجة("نسبة الإنجاز جيدة"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════════╗")
    اطبع_سطر("║  نظام محاكاة المهام المتزامنة المعقد    ║")
    اطبع_سطر("╚══════════════════════════════════════════╝")
    اطبع_سطر("")

    اختبار_مهام_بسيطة()
    اختبار_جدولة()
    اختبار_تنافس()
    اختبار_احصائيات()

    اطبع_سطر("=== انتهت محاكاة المهام بنجاح ===")
    ارجع 0
نهاية
