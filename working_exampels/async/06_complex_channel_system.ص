# ==============================================
# مثال 06: نظام محاكاة قنوات الاتصال بين المهام
# محاكاة نمط المنتج-المستهلك مع صفوف الرسائل
# المستوى: معقد
# ==============================================

# ---- أدوات المساعدة ----

دالة عرض_نتيجة(نص وصف، رقم ناجح)
    إذا (ناجح == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

# ---- محاكاة صف الرسائل ----

# حالة الصف
رقم صف_رأس = 0
رقم صف_ذيل = 0
رقم صف_حجم = 0
رقم صف_سعة = 100

دالة رقم ارسل_رسالة(رقم قيمة)
    إذا (صف_حجم >= صف_سعة)
        ارجع 0
    نهاية
    صف_ذيل = صف_ذيل + 1
    صف_حجم = صف_حجم + 1
    ارجع 1
نهاية

دالة رقم استلم_رسالة()
    إذا (صف_حجم <= 0)
        ارجع 0 - 1
    نهاية
    صف_رأس = صف_رأس + 1
    صف_حجم = صف_حجم - 1
    ارجع صف_رأس
نهاية

دالة إعادة_تهيئة_صف()
    صف_رأس = 0
    صف_ذيل = 0
    صف_حجم = 0
نهاية

# ---- محاكاة المنتج ----

دالة رقم انتج_عناصر(رقم عدد)
    رقم أنتجت = 0
    رقم م = 0
    طالما (م < عدد)
        رقم نتيجة = ارسل_رسالة(م)
        إذا (نتيجة == 1)
            أنتجت = أنتجت + 1
        نهاية
        م = م + 1
    نهاية
    ارجع أنتجت
نهاية

# ---- محاكاة المستهلك ----

دالة رقم استهلك_عناصر(رقم عدد)
    رقم استهلكت = 0
    رقم م = 0
    طالما (م < عدد)
        رقم نتيجة = استلم_رسالة()
        إذا (نتيجة >= 0)
            استهلكت = استهلكت + 1
        نهاية
        م = م + 1
    نهاية
    ارجع استهلكت
نهاية

# ---- حالة القناة ----

رقم قناة_مفتوحة = 1
رقم رسائل_مرسلة = 0
رقم رسائل_مستلمة = 0
رقم رسائل_مفقودة = 0

دالة تسجيل_إرسال(رقم عدد)
    رسائل_مرسلة = رسائل_مرسلة + عدد
نهاية

دالة تسجيل_استلام(رقم عدد)
    رسائل_مستلمة = رسائل_مستلمة + عدد
نهاية

# ---- اختبار 1: إرسال واستلام بسيط ----

دالة اختبار_ارسال_بسيط()
    اطبع_سطر("=== إرسال واستلام بسيط ===")
    اطبع_سطر("")

    إعادة_تهيئة_صف()

    # إرسال 5 رسائل
    رقم أرسلت = انتج_عناصر(5)
    نص أرسلت_ن = لنص(أرسلت)
    اطبع_سطر("  أُرسلت: " + أرسلت_ن + " رسائل")

    إذا (أرسلت == 5)
        عرض_نتيجة("إرسال 5 رسائل"، 1)
    وإلا
        عرض_نتيجة("إرسال 5 رسائل"، 0)
    نهاية

    # استلام 5 رسائل
    رقم استلمت = استهلك_عناصر(5)
    نص استلمت_ن = لنص(استلمت)
    اطبع_سطر("  استُلمت: " + استلمت_ن + " رسائل")

    إذا (استلمت == 5)
        عرض_نتيجة("استلام 5 رسائل"، 1)
    وإلا
        عرض_نتيجة("استلام 5 رسائل"، 0)
    نهاية

    # تحقق أن الصف فارغ
    نص حجم_ن = لنص(صف_حجم)
    اطبع_سطر("  حجم الصف: " + حجم_ن)
    إذا (صف_حجم == 0)
        عرض_نتيجة("الصف فارغ بعد الاستلام"، 1)
    وإلا
        عرض_نتيجة("الصف فارغ بعد الاستلام"، 0)
    نهاية
    اطبع_سطر("")

    تسجيل_إرسال(أرسلت)
    تسجيل_استلام(استلمت)
نهاية

# ---- اختبار 2: منتج-مستهلك بأحجام مختلفة ----

دالة اختبار_أحجام_مختلفة()
    اطبع_سطر("=== أحجام إرسال واستلام مختلفة ===")
    اطبع_سطر("")

    # إرسال 20 واستلام 10 فقط
    إعادة_تهيئة_صف()
    رقم أ1 = انتج_عناصر(20)
    رقم س1 = استهلك_عناصر(10)

    نص أ1_ن = لنص(أ1)
    نص س1_ن = لنص(س1)
    نص حجم1_ن = لنص(صف_حجم)

    اطبع_سطر("  أرسلت: " + أ1_ن + " | استلمت: " + س1_ن + " | متبقي: " + حجم1_ن)

    إذا (صف_حجم == 10)
        عرض_نتيجة("متبقي في الصف صحيح"، 1)
    وإلا
        عرض_نتيجة("متبقي في الصف صحيح"، 0)
    نهاية

    # محاولة استلام أكثر مما هو متاح
    رقم س2 = استهلك_عناصر(15)
    نص س2_ن = لنص(س2)
    اطبع_سطر("  طلب 15 استلام فعلي: " + س2_ن)

    إذا (س2 == 10)
        عرض_نتيجة("استلام المتاح فقط"، 1)
    وإلا
        عرض_نتيجة("استلام المتاح فقط"، 0)
    نهاية

    تسجيل_إرسال(أ1)
    تسجيل_استلام(س1 + س2)
    اطبع_سطر("")
نهاية

# ---- اختبار 3: سيناريو متقدم ----

دالة اختبار_سيناريو_متقدم()
    اطبع_سطر("=== سيناريو متقدم: منتجون ومستهلكون ===")
    اطبع_سطر("")

    إعادة_تهيئة_صف()

    # المنتج 1 يرسل 30 رسالة
    رقم م1 = انتج_عناصر(30)
    اطبع_سطر("  المنتج 1 أرسل: " + لنص(م1))

    # المستهلك 1 يأخذ 10
    رقم س1 = استهلك_عناصر(10)
    اطبع_سطر("  المستهلك 1 أخذ: " + لنص(س1))

    # المنتج 2 يرسل 15 أخرى
    رقم م2 = انتج_عناصر(15)
    اطبع_سطر("  المنتج 2 أرسل: " + لنص(م2))

    # المستهلك 2 يأخذ 20
    رقم س2 = استهلك_عناصر(20)
    اطبع_سطر("  المستهلك 2 أخذ: " + لنص(س2))

    # المستهلك 3 يأخذ الباقي
    رقم س3 = استهلك_عناصر(100)
    اطبع_سطر("  المستهلك 3 أخذ: " + لنص(س3))

    اطبع_سطر("")

    رقم إجمالي_إرسال = م1 + م2
    رقم إجمالي_استلام = س1 + س2 + س3

    نص إر_ن = لنص(إجمالي_إرسال)
    نص إس_ن = لنص(إجمالي_استلام)

    اطبع_سطر("  إجمالي الإرسال: " + إر_ن)
    اطبع_سطر("  إجمالي الاستلام: " + إس_ن)

    إذا (إجمالي_إرسال == إجمالي_استلام)
        عرض_نتيجة("كل الرسائل وصلت"، 1)
    وإلا
        عرض_نتيجة("كل الرسائل وصلت"، 0)
    نهاية

    إذا (صف_حجم == 0)
        عرض_نتيجة("الصف فارغ في النهاية"، 1)
    وإلا
        عرض_نتيجة("الصف فارغ في النهاية"، 0)
    نهاية

    تسجيل_إرسال(إجمالي_إرسال)
    تسجيل_استلام(إجمالي_استلام)
    اطبع_سطر("")
نهاية

# ---- اختبار 4: تقرير القنوات ----

دالة اختبار_تقرير()
    اطبع_سطر("=== تقرير نظام القنوات ===")
    اطبع_سطر("")

    نص مرسلة_ن = لنص(رسائل_مرسلة)
    نص مستلمة_ن = لنص(رسائل_مستلمة)

    رقم فقدان = رسائل_مرسلة - رسائل_مستلمة
    نص فقدان_ن = لنص(فقدان)

    رقم نسبة_توصيل = 0
    إذا (رسائل_مرسلة > 0)
        نسبة_توصيل = (رسائل_مستلمة * 100) / رسائل_مرسلة
    نهاية
    نص نسبة_ن = لنص(نسبة_توصيل)

    اطبع_سطر("  ╔═══════════════════════════════════╗")
    اطبع_سطر("  ║  تقرير نظام قنوات الاتصال       ║")
    اطبع_سطر("  ╠═══════════════════════════════════╣")
    اطبع_سطر("  ║  رسائل مرسلة: " + مرسلة_ن + "             ║")
    اطبع_سطر("  ║  رسائل مستلمة: " + مستلمة_ن + "            ║")
    اطبع_سطر("  ║  فقدان: " + فقدان_ن + "                     ║")
    اطبع_سطر("  ║  نسبة التوصيل: " + نسبة_ن + "%          ║")
    اطبع_سطر("  ╚═══════════════════════════════════╝")

    إذا (فقدان == 0)
        عرض_نتيجة("لا فقدان في الرسائل"، 1)
    وإلا
        عرض_نتيجة("لا فقدان في الرسائل"، 0)
    نهاية

    إذا (نسبة_توصيل == 100)
        عرض_نتيجة("نسبة توصيل كاملة"، 1)
    وإلا
        عرض_نتيجة("نسبة توصيل كاملة"، 0)
    نهاية
    اطبع_سطر("")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════════════════╗")
    اطبع_سطر("║  نظام محاكاة قنوات الاتصال بين المهام          ║")
    اطبع_سطر("╚══════════════════════════════════════════════════╝")
    اطبع_سطر("")

    اختبار_ارسال_بسيط()
    اختبار_أحجام_مختلفة()
    اختبار_سيناريو_متقدم()
    اختبار_تقرير()

    اطبع_سطر("=== انتهى نظام القنوات بنجاح ===")
    ارجع 0
نهاية
