# ─── 4. اختبار Mutex مع عداد مشترك ───────────────────
اطبع_سطر("")
اطبع_سطر("--- 4. اختبار Mutex مع عداد ---")

متغير قفل = create_mutex()
متغير عداد = create_atomic(0)

# محاكاة قسم حرج متعدد
mutex_lock(قفل)
atomic_add(عداد, 1)
mutex_unlock(قفل)

mutex_lock(قفل)
atomic_add(عداد, 1)
mutex_unlock(قفل)

mutex_lock(قفل)
atomic_add(عداد, 1)
mutex_unlock(قفل)

متغير نهائي = atomic_load(عداد)
اطبع("   العداد بعد 3 عمليات: ")
اطبع_سطر(نهائي)
اطبع_سطر("   Mutex + Atomic Counter - نجح ✓")

