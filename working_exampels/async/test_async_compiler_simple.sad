# اختبار Async/Await البسيط للمترجم
# Simple Async/Await Compiler Test
# ═══════════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("=== اختبار Async للمترجم ===")

    # اختبار النوم
    اطبع_سطر("اختبار async_sleep...")
    async_sleep(50)
    اطبع_سطر("async_sleep نجح")

    # اختبار Yield
    اطبع_سطر("اختبار async_yield...")
    async_yield(0)
    اطبع_سطر("async_yield نجح")

    اطبع_سطر("=== نجح ===")
    ارجع 0
نهاية
