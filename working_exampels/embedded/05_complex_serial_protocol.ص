# ============================================
# مثال معقد: بروتوكول اتصال تسلسلي
# Complex: Serial Communication Protocol
# ============================================

# === ثوابت (عشرية) ===
متغير منفذ_أ = 1016
متغير منفذ_ب = 760
متغير علامة_بدء = 170
متغير علامة_ختم = 85

# === عدادات ===
متغير عدد_مرسلة = 0
متغير عدد_مستقبلة = 0
متغير عدد_رسائل = 0
متغير عدد_فحوصات = 0
متغير آخر_مستقبل = 0

# === دوال العرض ===
دالة عنوان_ب(عنوان: نص)
    اطبع_سطر("")
    اطبع_سطر("╔════════════════════════════════════════════╗")
    اطبع("║  ")
    اطبع(عنوان)
    اطبع_سطر("  ║")
    اطبع_سطر("╚════════════════════════════════════════════╝")
نهاية

دالة فرع_ب(عنوان: نص)
    اطبع_سطر("")
    اطبع("  ▸ ")
    اطبع_سطر(عنوان)
    اطبع_سطر("  ─────────────────────────")
نهاية

# === دوال البروتوكول ===
دالة ارسل_قيمة(منفذ: رقم، قيمة_ب: رقم)
    تسلسلي_ارسل(منفذ، قيمة_ب)
    عدد_مرسلة = عدد_مرسلة + 1
نهاية

دالة استقبل_وسجل(منفذ: رقم)
    آخر_مستقبل = تسلسلي_استقبل(منفذ)
    عدد_مستقبلة = عدد_مستقبلة + 1
نهاية

دالة فحص_وسجل(منفذ: رقم)
    متغير حالة_ج = تسلسلي_جاهز(منفذ)
    عدد_فحوصات = عدد_فحوصات + 1
    اطبع("    جاهزية: ")
    متغير ح_ن = لنص(حالة_ج)
    اطبع_سطر(ح_ن)
نهاية

# === إرسال رسالة مهيكلة ===
دالة ارسل_رسالة(منفذ: رقم، ب1: رقم، ب2: رقم، ب3: رقم)
    ارسل_قيمة(منفذ، علامة_بدء)
    ارسل_قيمة(منفذ، ب1)
    ارسل_قيمة(منفذ، ب2)
    ارسل_قيمة(منفذ، ب3)
    ارسل_قيمة(منفذ، علامة_ختم)
    عدد_رسائل = عدد_رسائل + 1
    اطبع("    [→] رسالة #")
    متغير ر_ن = لنص(عدد_رسائل)
    اطبع(ر_ن)
    اطبع(": [")
    متغير ب1_ن = لنص(ب1)
    اطبع(ب1_ن)
    اطبع("، ")
    متغير ب2_ن = لنص(ب2)
    اطبع(ب2_ن)
    اطبع("، ")
    متغير ب3_ن = لنص(ب3)
    اطبع(ب3_ن)
    اطبع_سطر("]")
نهاية

# === استقبال رسالة ===
دالة استقبل_رسالة(منفذ: رقم)
    استقبل_وسجل(منفذ)
    متغير ب_بداية = آخر_مستقبل
    استقبل_وسجل(منفذ)
    متغير ب_1 = آخر_مستقبل
    استقبل_وسجل(منفذ)
    متغير ب_2 = آخر_مستقبل
    استقبل_وسجل(منفذ)
    متغير ب_3 = آخر_مستقبل
    استقبل_وسجل(منفذ)
    متغير ب_نهاية = آخر_مستقبل

    اطبع("    [←] بداية=")
    متغير بد_ن = لنص(ب_بداية)
    اطبع(بد_ن)
    اطبع(" [")
    متغير ب1_ن = لنص(ب_1)
    اطبع(ب1_ن)
    اطبع("،")
    متغير ب2_ن = لنص(ب_2)
    اطبع(ب2_ن)
    اطبع("،")
    متغير ب3_ن = لنص(ب_3)
    اطبع(ب3_ن)
    اطبع("] نهاية=")
    متغير نه_ن = لنص(ب_نهاية)
    اطبع_سطر(نه_ن)
نهاية

# ═══════════════════════════════════════
# اختبار 1: التهيئة
# ═══════════════════════════════════════
دالة اختبار_تهيئة()
    عنوان_ب("تهيئة المنافذ التسلسلية")

    فرع_ب("COM1 (9600 baud)")
    تسلسلي_هيئ(منفذ_أ، 9600)
    اطبع_سطر("    [✓] COM1 جاهز")
    فحص_وسجل(منفذ_أ)

    فرع_ب("COM2 (115200 baud)")
    تسلسلي_هيئ(منفذ_ب، 115200)
    اطبع_سطر("    [✓] COM2 جاهز")
    فحص_وسجل(منفذ_ب)

    اطبع_سطر("  [✓] تمت التهيئة")
نهاية

# ═══════════════════════════════════════
# اختبار 2: الإرسال
# ═══════════════════════════════════════
دالة اختبار_ارسال()
    عنوان_ب("إرسال البيانات")

    فرع_ب("أحرف فردية عبر COM1")
    ارسل_قيمة(منفذ_أ، 72)
    اطبع_سطر("    H (72)")
    ارسل_قيمة(منفذ_أ، 101)
    اطبع_سطر("    e (101)")
    ارسل_قيمة(منفذ_أ، 108)
    اطبع_سطر("    l (108)")
    ارسل_قيمة(منفذ_أ، 108)
    اطبع_سطر("    l (108)")
    ارسل_قيمة(منفذ_أ، 111)
    اطبع_سطر("    o (111)")

    فرع_ب("رسائل مهيكلة عبر COM2")
    ارسل_رسالة(منفذ_ب، 1، 2، 3)
    ارسل_رسالة(منفذ_ب، 16، 32، 48)
    ارسل_رسالة(منفذ_ب، 255، 0، 127)

    اطبع_سطر("  [✓] تم الإرسال")
نهاية

# ═══════════════════════════════════════
# اختبار 3: الاستقبال
# ═══════════════════════════════════════
دالة اختبار_استقبال()
    عنوان_ب("استقبال البيانات")

    فرع_ب("بيانات من COM1")
    استقبل_وسجل(منفذ_أ)
    اطبع("    قيمة 1: ")
    متغير ق1_ن = لنص(آخر_مستقبل)
    اطبع_سطر(ق1_ن)

    استقبل_وسجل(منفذ_أ)
    اطبع("    قيمة 2: ")
    متغير ق2_ن = لنص(آخر_مستقبل)
    اطبع_سطر(ق2_ن)

    استقبل_وسجل(منفذ_أ)
    اطبع("    قيمة 3: ")
    متغير ق3_ن = لنص(آخر_مستقبل)
    اطبع_سطر(ق3_ن)

    فرع_ب("رسالة كاملة من COM2")
    استقبل_رسالة(منفذ_ب)

    اطبع_سطر("  [✓] تم الاستقبال")
نهاية

# ═══════════════════════════════════════
# اختبار 4: DMA
# ═══════════════════════════════════════
دالة اختبار_نقل()
    عنوان_ب("النقل المباشر DMA")

    فرع_ب("تهيئة القنوات")
    نقل_مباشر_هيئ(0، 4096، 8192، 256)
    اطبع_سطر("    قناة 0: 256 قيمة")
    نقل_مباشر_هيئ(1، 12288، 16384، 512)
    اطبع_سطر("    قناة 1: 512 قيمة")
    نقل_مباشر_هيئ(2، 20480، 24576، 1024)
    اطبع_سطر("    قناة 2: 1024 قيمة")

    فرع_ب("حواجز + تشغيل")
    حاجز_كتابة()
    اطبع_سطر("    [✓] حاجز كتابة")
    نقل_مباشر_ابدأ(0)
    اطبع_سطر("    [→] قناة 0")
    نقل_مباشر_ابدأ(1)
    اطبع_سطر("    [→] قناة 1")
    نقل_مباشر_ابدأ(2)
    اطبع_سطر("    [→] قناة 2")
    حاجز_ذاكرة()
    اطبع_سطر("    [✓] حاجز ذاكرة")
    حاجز_قراءة()
    اطبع_سطر("    [✓] حاجز قراءة")

    اطبع_سطر("  [✓] تم النقل")
نهاية

# === الإحصائيات ===
دالة طباعة_احصائيات_ب()
    عنوان_ب("إحصائيات البروتوكول")

    اطبع("    مرسلة: ")
    متغير مر_ن = لنص(عدد_مرسلة)
    اطبع_سطر(مر_ن)

    اطبع("    مستقبلة: ")
    متغير مس_ن = لنص(عدد_مستقبلة)
    اطبع_سطر(مس_ن)

    اطبع("    رسائل: ")
    متغير رس_ن = لنص(عدد_رسائل)
    اطبع_سطر(رس_ن)

    اطبع("    فحوصات: ")
    متغير فج_ن = لنص(عدد_فحوصات)
    اطبع_سطر(فج_ن)

    متغير اجمالي = عدد_مرسلة + عدد_مستقبلة
    اطبع("    إجمالي: ")
    متغير اج_ن = لنص(اجمالي)
    اطبع_سطر(اج_ن)
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    اطبع_سطر("╔════════════════════════════════════════════╗")
    اطبع_سطر("║     بروتوكول الاتصال التسلسلي            ║")
    اطبع_سطر("╚════════════════════════════════════════════╝")

    اختبار_تهيئة()
    اختبار_ارسال()
    اختبار_استقبال()
    اختبار_نقل()
    طباعة_احصائيات_ب()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى البروتوكول بنجاح ===")
    ارجع 0
نهاية
