# ============================================
# مثال متوسط: نظام التحكم بمنافذ GPIO ومؤقتات
# Medium: GPIO Control & Timer System
# ============================================

# === متغيرات عامة ===
متغير عدد_منافذ_مفعلة = 0
متغير عدد_عمليات_كتابة = 0
متغير عدد_عمليات_قراءة = 0
متغير عدد_تهيئات_مؤقت = 0

# === دوال العرض ===
دالة عنوان_ن(عنوان: نص)
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع("║  ")
    اطبع(عنوان)
    اطبع_سطر("  ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
نهاية

دالة قسم_ن(عنوان: نص)
    اطبع_سطر("")
    اطبع("  ◆ ")
    اطبع_سطر(عنوان)
    اطبع_سطر("  ─────────────────────")
نهاية

# === دوال GPIO ===
دالة تهيئة_منفذ_خرج(رقم_منفذ: رقم)
    حدد_وضع_منفذ(رقم_منفذ، 1)
    عدد_منافذ_مفعلة = عدد_منافذ_مفعلة + 1
    اطبع("    [✓] المنفذ ")
    متغير رقم_ن = لنص(رقم_منفذ)
    اطبع(رقم_ن)
    اطبع_سطر(" → خرج")
نهاية

دالة تهيئة_منفذ_دخل(رقم_منفذ: رقم)
    حدد_وضع_منفذ(رقم_منفذ، 0)
    عدد_منافذ_مفعلة = عدد_منافذ_مفعلة + 1
    اطبع("    [✓] المنفذ ")
    متغير رقم_ن = لنص(رقم_منفذ)
    اطبع(رقم_ن)
    اطبع_سطر(" → دخل")
نهاية

دالة كتابة_منفذ(رقم_منفذ: رقم، قيمة: رقم)
    منفذ_رقمي_اكتب(رقم_منفذ، قيمة)
    عدد_عمليات_كتابة = عدد_عمليات_كتابة + 1
    اطبع("    كتابة → المنفذ ")
    متغير رقم_ن = لنص(رقم_منفذ)
    اطبع(رقم_ن)
    اطبع(" = ")
    متغير ق_ن = لنص(قيمة)
    اطبع_سطر(ق_ن)
نهاية

دالة قراءة_منفذ(رقم_منفذ: رقم) -> رقم
    متغير قيمة = منفذ_رقمي_اقرأ(رقم_منفذ)
    عدد_عمليات_قراءة = عدد_عمليات_قراءة + 1
    اطبع("    قراءة ← المنفذ ")
    متغير رقم_ن = لنص(رقم_منفذ)
    اطبع(رقم_ن)
    اطبع(" = ")
    متغير ق_ن = لنص(قيمة)
    اطبع_سطر(ق_ن)
    ارجع قيمة
نهاية

# === اختبار 1: تهيئة المنافذ ===
دالة اختبار_تهيئة_منافذ()
    عنوان_ن("تهيئة منافذ GPIO")

    قسم_ن("منافذ الخرج (LEDs)")
    تهيئة_منفذ_خرج(13)
    تهيئة_منفذ_خرج(12)
    تهيئة_منفذ_خرج(11)
    تهيئة_منفذ_خرج(10)

    قسم_ن("منافذ الدخل (مستشعرات)")
    تهيئة_منفذ_دخل(2)
    تهيئة_منفذ_دخل(3)
    تهيئة_منفذ_دخل(4)

    اطبع("    إجمالي المنافذ: ")
    متغير ع_ن = لنص(عدد_منافذ_مفعلة)
    اطبع_سطر(ع_ن)
    اطبع_سطر("  [✓] تمت تهيئة المنافذ")
نهاية

# === اختبار 2: قراءة وكتابة ===
دالة اختبار_قراءة_كتابة()
    عنوان_ن("عمليات القراءة والكتابة")

    قسم_ن("تشغيل LEDs")
    كتابة_منفذ(13، 1)
    كتابة_منفذ(12، 1)
    كتابة_منفذ(11، 0)
    كتابة_منفذ(10، 1)

    قسم_ن("قراءة المستشعرات")
    متغير م1 = قراءة_منفذ(2)
    متغير م2 = قراءة_منفذ(3)
    متغير م3 = قراءة_منفذ(4)

    قسم_ن("تبديل حالة LED")
    كتابة_منفذ(13، 0)
    كتابة_منفذ(11، 1)

    متغير ق13 = قراءة_منفذ(13)
    متغير ق11 = قراءة_منفذ(11)

    اطبع_سطر("  [✓] تمت عمليات القراءة والكتابة")
نهاية

# === اختبار 3: المؤقتات ===
دالة اختبار_مؤقتات()
    عنوان_ن("نظام المؤقتات")

    قسم_ن("تهيئة مؤقت سريع (1ms)")
    مؤقت_هيئ(1000)
    عدد_تهيئات_مؤقت = عدد_تهيئات_مؤقت + 1
    اطبع_سطر("    [✓] مؤقت 1ms جاهز")

    قسم_ن("قراءة الوقت")
    متغير وقت_بداية = مؤقت_قراءة()
    اطبع("    وقت البداية: ")
    متغير وب_ن = لنص(وقت_بداية)
    اطبع_سطر(وب_ن)

    قسم_ن("انتظار 50ms")
    مؤقت_انتظر(50)
    متغير وقت_بعد = مؤقت_قراءة()
    اطبع("    وقت بعد الانتظار: ")
    متغير وب2_ن = لنص(وقت_بعد)
    اطبع_سطر(وب2_ن)

    قسم_ن("تهيئة مؤقت بطيء (100ms)")
    مؤقت_هيئ(100)
    عدد_تهيئات_مؤقت = عدد_تهيئات_مؤقت + 1
    اطبع_سطر("    [✓] مؤقت 100ms جاهز")

    متغير وقت_ج = مؤقت_قراءة()
    اطبع("    الوقت الحالي: ")
    متغير وج_ن = لنص(وقت_ج)
    اطبع_سطر(وج_ن)

    اطبع_سطر("  [✓] تمت اختبارات المؤقتات")
نهاية

# === اختبار 4: نظام معلومات ===
دالة اختبار_معلومات_نظام()
    عنوان_ن("معلومات النظام")

    قسم_ن("معلومات المعالج")
    متغير معالج = معرف_المعالج()
    اطبع("    معرف المعالج: ")
    متغير مع_ن = لنص(معالج)
    اطبع_سطر(مع_ن)

    قسم_ن("عداد الأداء")
    متغير دورات_1 = عداد_الدورات()
    اطبع("    الدورات (قبل): ")
    متغير د1_ن = لنص(دورات_1)
    اطبع_سطر(د1_ن)

    متغير دورات_2 = عداد_الدورات()
    اطبع("    الدورات (بعد): ")
    متغير د2_ن = لنص(دورات_2)
    اطبع_سطر(د2_ن)

    قسم_ن("حواجز الذاكرة")
    حاجز_ذاكرة()
    اطبع_سطر("    [✓] حاجز ذاكرة كامل")
    حاجز_قراءة()
    اطبع_سطر("    [✓] حاجز قراءة")
    حاجز_كتابة()
    اطبع_سطر("    [✓] حاجز كتابة")

    اطبع_سطر("  [✓] تمت معلومات النظام")
نهاية

# === الإحصائيات النهائية ===
دالة طباعة_احصائيات()
    عنوان_ن("إحصائيات التشغيل")

    اطبع("    منافذ مفعلة: ")
    متغير أ_ن = لنص(عدد_منافذ_مفعلة)
    اطبع_سطر(أ_ن)

    اطبع("    عمليات كتابة: ")
    متغير ك_ن = لنص(عدد_عمليات_كتابة)
    اطبع_سطر(ك_ن)

    اطبع("    عمليات قراءة: ")
    متغير ق_ن = لنص(عدد_عمليات_قراءة)
    اطبع_سطر(ق_ن)

    اطبع("    تهيئات مؤقت: ")
    متغير م_ن = لنص(عدد_تهيئات_مؤقت)
    اطبع_سطر(م_ن)

    متغير اجمالي = عدد_عمليات_كتابة + عدد_عمليات_قراءة
    اطبع("    إجمالي عمليات IO: ")
    متغير اج_ن = لنص(اجمالي)
    اطبع_سطر(اج_ن)
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════════╗")
    اطبع_سطر("║   نظام التحكم بمنافذ GPIO والمؤقتات   ║")
    اطبع_سطر("╚══════════════════════════════════════════╝")

    اختبار_تهيئة_منافذ()
    اختبار_قراءة_كتابة()
    اختبار_مؤقتات()
    اختبار_معلومات_نظام()
    طباعة_احصائيات()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى نظام GPIO والمؤقتات بنجاح ===")
    ارجع 0
نهاية
