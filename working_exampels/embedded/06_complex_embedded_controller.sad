# ============================================
# مثال معقد: نظام تحكم مدمج متكامل
# Complex: Integrated Embedded Controller
# ============================================

# === ثوابت المنافذ (عشرية) ===
متغير منفذ_كوم1 = 1016   # COM1
متغير منفذ_كوم2 = 760    # COM2
متغير علامة_بدء = 170    # 0xAA
متغير علامة_انتهاء = 85  # 0x55
متغير علامة_حالة = 187   # 0xBB
متغير علامة_حالة_ن = 204 # 0xCC
متغير عنوان_ذاكرة_1 = 4096
متغير عنوان_ذاكرة_2 = 8192
متغير عنوان_ذاكرة_3 = 12288
متغير عنوان_ذاكرة_4 = 16384
متغير عنوان_ذاكرة_5 = 20480
متغير عنوان_ذاكرة_6 = 24576

# === متغيرات النظام ===
متغير حالة_نظام = 0
متغير عداد_أحداث = 0
متغير درجة_حرارة = 25
متغير مستوى_ضوء = 50
متغير وضع_تشغيل = 1
متغير عدد_تنبيهات = 0

# === دوال العرض ===
دالة عنوان_ت(عنوان: نص)
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════════════════════════╗")
    اطبع("║  ")
    اطبع(عنوان)
    اطبع_سطر("  ║")
    اطبع_سطر("╚══════════════════════════════════════════════╝")
نهاية

دالة قسم_ت(عنوان: نص)
    اطبع_سطر("")
    اطبع("  ▶ ")
    اطبع_سطر(عنوان)
    اطبع_سطر("  ──────────────────────────────")
نهاية

دالة سجل_حدث(نبذة: نص)
    عداد_أحداث = عداد_أحداث + 1
    اطبع("    [")
    متغير ع_ن = لنص(عداد_أحداث)
    اطبع(ع_ن)
    اطبع("] ")
    اطبع_سطر(نبذة)
نهاية

# ═══════════════════════════════════════
# تهيئة الأجهزة
# ═══════════════════════════════════════
دالة تهيئة_نظام()
    عنوان_ت("تهيئة نظام التحكم المدمج")

    قسم_ت("تهيئة المؤقت الرئيسي")
    مؤقت_هيئ(1000)
    سجل_حدث("مؤقت النظام: 1ms")

    قسم_ت("تهيئة منافذ LED")
    حدد_وضع_منفذ(13، 1)
    سجل_حدث("LED أحمر (13): خرج")
    حدد_وضع_منفذ(12، 1)
    سجل_حدث("LED أخضر (12): خرج")
    حدد_وضع_منفذ(11، 1)
    سجل_حدث("LED أزرق (11): خرج")
    حدد_وضع_منفذ(10، 1)
    سجل_حدث("LED حالة (10): خرج")

    قسم_ت("تهيئة منافذ الاستشعار")
    حدد_وضع_منفذ(2، 0)
    سجل_حدث("حرارة (2): دخل")
    حدد_وضع_منفذ(3، 0)
    سجل_حدث("ضوء (3): دخل")
    حدد_وضع_منفذ(4، 0)
    سجل_حدث("زر (4): دخل")

    قسم_ت("تهيئة الاتصال التسلسلي")
    تسلسلي_هيئ(منفذ_كوم1، 9600)
    سجل_حدث("COM1: 9600 baud")
    تسلسلي_هيئ(منفذ_كوم2، 115200)
    سجل_حدث("COM2: 115200 baud")

    قسم_ت("تهيئة DMA")
    نقل_مباشر_هيئ(0، عنوان_ذاكرة_1، عنوان_ذاكرة_2، 512)
    سجل_حدث("DMA 0: جاهزة")

    قسم_ت("حواجز الذاكرة الأولية")
    حاجز_ذاكرة()
    سجل_حدث("حاجز ذاكرة: مزامنة التهيئة")

    حالة_نظام = 1
    سجل_حدث("النظام جاهز")
    اطبع_سطر("  [✓] اكتملت التهيئة")
نهاية

# ═══════════════════════════════════════
# قراءة المستشعرات
# ═══════════════════════════════════════
دالة قراءة_مستشعرات()
    عنوان_ت("قراءة المستشعرات")

    قسم_ت("مستشعر الحرارة")
    متغير قراءة_ح = منفذ_رقمي_اقرأ(2)
    درجة_حرارة = 20 + قراءة_ح
    اطبع("    درجة الحرارة: ")
    متغير ح_ن = لنص(درجة_حرارة)
    اطبع(ح_ن)
    اطبع_سطر(" درجة")
    سجل_حدث("قراءة حرارة")

    قسم_ت("مستشعر الإضاءة")
    متغير قراءة_ض = منفذ_رقمي_اقرأ(3)
    مستوى_ضوء = قراءة_ض * 10
    اطبع("    مستوى الإضاءة: ")
    متغير ض_ن = لنص(مستوى_ضوء)
    اطبع(ض_ن)
    اطبع_سطر("%")
    سجل_حدث("قراءة إضاءة")

    قسم_ت("زر التحكم")
    متغير حالة_زر = منفذ_رقمي_اقرأ(4)
    اطبع("    الزر: ")
    متغير ز_ن = لنص(حالة_زر)
    اطبع_سطر(ز_ن)
    سجل_حدث("قراءة زر")

    اطبع_سطر("  [✓] تمت القراءة")
نهاية

# ═══════════════════════════════════════
# التحكم بالمخرجات
# ═══════════════════════════════════════
دالة تحكم_مخرجات()
    عنوان_ت("التحكم بالمخرجات")

    قسم_ت("تحكم LEDs")
    منفذ_رقمي_اكتب(13، 0)
    سجل_حدث("LED أحمر: إطفاء")
    منفذ_رقمي_اكتب(12، 1)
    سجل_حدث("LED أخضر: تشغيل")
    منفذ_رقمي_اكتب(11، 0)
    سجل_حدث("LED أزرق: إطفاء")
    منفذ_رقمي_اكتب(10، 1)
    سجل_حدث("LED حالة: تشغيل")

    قسم_ت("تبديل LEDs")
    منفذ_رقمي_اكتب(13، 1)
    سجل_حدث("LED أحمر: تشغيل")
    منفذ_رقمي_اكتب(12، 0)
    سجل_حدث("LED أخضر: إطفاء")

    قسم_ت("التحقق من الحالة")
    متغير ق13 = منفذ_رقمي_اقرأ(13)
    اطبع("    أحمر: ")
    متغير ق13_ن = لنص(ق13)
    اطبع_سطر(ق13_ن)

    متغير ق12 = منفذ_رقمي_اقرأ(12)
    اطبع("    أخضر: ")
    متغير ق12_ن = لنص(ق12)
    اطبع_سطر(ق12_ن)

    متغير ق11 = منفذ_رقمي_اقرأ(11)
    اطبع("    أزرق: ")
    متغير ق11_ن = لنص(ق11)
    اطبع_سطر(ق11_ن)

    متغير ق10 = منفذ_رقمي_اقرأ(10)
    اطبع("    حالة: ")
    متغير ق10_ن = لنص(ق10)
    اطبع_سطر(ق10_ن)

    اطبع_سطر("  [✓] تم التحكم")
نهاية

# ═══════════════════════════════════════
# الاتصالات التسلسلية
# ═══════════════════════════════════════
دالة ارسال_تقرير()
    عنوان_ت("إرسال تقرير الحالة")

    قسم_ت("فحص الجاهزية")
    متغير جاهز_1 = تسلسلي_جاهز(منفذ_كوم1)
    اطبع("    COM1: ")
    متغير ج1_ن = لنص(جاهز_1)
    اطبع_سطر(ج1_ن)

    متغير جاهز_2 = تسلسلي_جاهز(منفذ_كوم2)
    اطبع("    COM2: ")
    متغير ج2_ن = لنص(جاهز_2)
    اطبع_سطر(ج2_ن)

    قسم_ت("إرسال حرارة عبر COM1")
    تسلسلي_ارسل(منفذ_كوم1، علامة_بدء)
    تسلسلي_ارسل(منفذ_كوم1، 1)
    تسلسلي_ارسل(منفذ_كوم1، درجة_حرارة)
    تسلسلي_ارسل(منفذ_كوم1، علامة_انتهاء)
    سجل_حدث("رسالة حرارة أُرسلت")

    قسم_ت("إرسال إضاءة عبر COM1")
    تسلسلي_ارسل(منفذ_كوم1، علامة_بدء)
    تسلسلي_ارسل(منفذ_كوم1، 2)
    تسلسلي_ارسل(منفذ_كوم1، مستوى_ضوء)
    تسلسلي_ارسل(منفذ_كوم1، علامة_انتهاء)
    سجل_حدث("رسالة إضاءة أُرسلت")

    قسم_ت("حالة النظام عبر COM2")
    تسلسلي_ارسل(منفذ_كوم2، علامة_حالة)
    تسلسلي_ارسل(منفذ_كوم2، حالة_نظام)
    تسلسلي_ارسل(منفذ_كوم2، وضع_تشغيل)
    تسلسلي_ارسل(منفذ_كوم2، علامة_حالة_ن)
    سجل_حدث("حالة أُرسلت عبر COM2")

    اطبع_سطر("  [✓] تم إرسال التقرير")
نهاية

# ═══════════════════════════════════════
# استقبال الأوامر
# ═══════════════════════════════════════
دالة استقبال_اوامر()
    عنوان_ت("استقبال الأوامر")

    قسم_ت("أمر من COM1")
    متغير أمر_1 = تسلسلي_استقبل(منفذ_كوم1)
    اطبع("    الأمر: ")
    متغير أ1_ن = لنص(أمر_1)
    اطبع_سطر(أ1_ن)

    متغير بيانات_أمر = تسلسلي_استقبل(منفذ_كوم1)
    اطبع("    البيانات: ")
    متغير بأ_ن = لنص(بيانات_أمر)
    اطبع_سطر(بأ_ن)
    سجل_حدث("أمر مستقبل")

    قسم_ت("تأكيد من COM2")
    متغير تأكيد = تسلسلي_استقبل(منفذ_كوم2)
    اطبع("    التأكيد: ")
    متغير تأ_ن = لنص(تأكيد)
    اطبع_سطر(تأ_ن)
    سجل_حدث("تأكيد مستقبل")

    اطبع_سطر("  [✓] تم الاستقبال")
نهاية

# ═══════════════════════════════════════
# نقل DMA
# ═══════════════════════════════════════
دالة نقل_بيانات()
    عنوان_ت("نقل البيانات عبر DMA")

    قسم_ت("تهيئة قنوات النقل")
    نقل_مباشر_هيئ(0، عنوان_ذاكرة_1، عنوان_ذاكرة_3، 256)
    سجل_حدث("DMA 0: سجلات (256)")
    نقل_مباشر_هيئ(1، عنوان_ذاكرة_2، عنوان_ذاكرة_4، 512)
    سجل_حدث("DMA 1: مخزن (512)")
    نقل_مباشر_هيئ(2، عنوان_ذاكرة_5، عنوان_ذاكرة_6، 1024)
    سجل_حدث("DMA 2: استشعار (1024)")

    قسم_ت("مزامنة قبل النقل")
    حاجز_كتابة()
    سجل_حدث("حاجز كتابة")

    قسم_ت("تشغيل القنوات")
    نقل_مباشر_ابدأ(0)
    سجل_حدث("DMA 0: بدأ")
    نقل_مباشر_ابدأ(1)
    سجل_حدث("DMA 1: بدأ")
    نقل_مباشر_ابدأ(2)
    سجل_حدث("DMA 2: بدأ")

    قسم_ت("مزامنة بعد النقل")
    حاجز_ذاكرة()
    سجل_حدث("حاجز ذاكرة كامل")
    حاجز_قراءة()
    سجل_حدث("حاجز قراءة")

    اطبع_سطر("  [✓] تم النقل")
نهاية

# ═══════════════════════════════════════
# الأداء
# ═══════════════════════════════════════
دالة قياس_اداء()
    عنوان_ت("قياس أداء النظام")

    قسم_ت("المعالج")
    متغير معالج = معرف_المعالج()
    اطبع("    المعرف: ")
    متغير مع_ن = لنص(معالج)
    اطبع_سطر(مع_ن)

    قسم_ت("عداد الدورات")
    متغير دورات_1 = عداد_الدورات()
    اطبع("    قبل: ")
    متغير د1_ن = لنص(دورات_1)
    اطبع_سطر(د1_ن)

    منفذ_رقمي_اكتب(13، 1)
    منفذ_رقمي_اكتب(13، 0)
    منفذ_رقمي_اكتب(12، 1)
    منفذ_رقمي_اكتب(12، 0)

    متغير دورات_2 = عداد_الدورات()
    اطبع("    بعد: ")
    متغير د2_ن = لنص(دورات_2)
    اطبع_سطر(د2_ن)

    قسم_ت("زمن الانتظار")
    متغير وقت_ق = مؤقت_قراءة()
    اطبع("    قبل: ")
    متغير وق_ن = لنص(وقت_ق)
    اطبع_سطر(وق_ن)

    مؤقت_انتظر(100)

    متغير وقت_ب = مؤقت_قراءة()
    اطبع("    بعد 100ms: ")
    متغير وب_ن = لنص(وقت_ب)
    اطبع_سطر(وب_ن)

    اطبع_سطر("  [✓] تم القياس")
نهاية

# === الملخص ===
دالة ملخص_نظام()
    عنوان_ت("ملخص حالة النظام")

    اطبع("    الحالة: ")
    متغير ح_ن = لنص(حالة_نظام)
    اطبع_سطر(ح_ن)

    اطبع("    التشغيل: ")
    متغير و_ن = لنص(وضع_تشغيل)
    اطبع_سطر(و_ن)

    اطبع("    الحرارة: ")
    متغير حر_ن = لنص(درجة_حرارة)
    اطبع_سطر(حر_ن)

    اطبع("    الإضاءة: ")
    متغير ضو_ن = لنص(مستوى_ضوء)
    اطبع_سطر(ضو_ن)

    اطبع("    الأحداث: ")
    متغير أح_ن = لنص(عداد_أحداث)
    اطبع_سطر(أح_ن)
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════════════╗")
    اطبع_سطر("║      نظام التحكم المدمج المتكامل          ║")
    اطبع_سطر("╚══════════════════════════════════════════════╝")

    تهيئة_نظام()
    قراءة_مستشعرات()
    تحكم_مخرجات()
    ارسال_تقرير()
    استقبال_اوامر()
    نقل_بيانات()
    قياس_اداء()
    ملخص_نظام()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى نظام التحكم المدمج بنجاح ===")
    ارجع 0
نهاية
