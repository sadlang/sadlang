# ═══════════════════════════════════════════════════════════
# مثال معقد: نظام محاكاة لعبة RPG بمطابقة الأنماط
# Complex: RPG Game Simulation with Pattern Matching
# ═══════════════════════════════════════════════════════════

# === حالة اللاعب ===
متغير صحة_لاعب = 100
متغير طاقة_لاعب = 50
متغير ذهب_لاعب = 200
متغير مستوى_لاعب = 1
متغير خبرة_لاعب = 0
متغير درع_لاعب = 10
متغير هجوم_لاعب = 15

# === حالة المعركة ===
متغير ضرر_معركة = 0
متغير صحة_عدو_ح = 0

# ═══════════════════════════════════════
# القسم 1: اختيار الشخصية
# ═══════════════════════════════════════
دالة اختيار_فئة(فئة: نص)
    اطبع("    🎭 الفئة: ")
    طابق فئة
        حالة "محارب":
            اطبع_سطر("محارب")
            صحة_لاعب = 150
            هجوم_لاعب = 20
            درع_لاعب = 15
            اطبع_سطر("    ⚔ صحة 150 | هجوم 20 | درع 15")
        حالة "ساحر":
            اطبع_سطر("ساحر")
            صحة_لاعب = 80
            هجوم_لاعب = 30
            طاقة_لاعب = 100
            اطبع_سطر("    🔮 صحة 80 | هجوم 30 | طاقة 100")
        حالة "لص":
            اطبع_سطر("لص")
            صحة_لاعب = 100
            هجوم_لاعب = 25
            ذهب_لاعب = 500
            اطبع_سطر("    🗡 صحة 100 | هجوم 25 | ذهب 500")
        حالة "راهب":
            اطبع_سطر("راهب")
            صحة_لاعب = 120
            هجوم_لاعب = 15
            طاقة_لاعب = 80
            اطبع_سطر("    🙏 صحة 120 | هجوم 15 | طاقة 80")
        حالة _:
            اطبع_سطر("مقاتل عادي")
            اطبع_سطر("    🛡 إعدادات افتراضية")
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 2: استكشاف المناطق
# ═══════════════════════════════════════
دالة استكشاف_منطقة(منطقة: نص)
    اطبع_سطر("")
    اطبع("    🗺 المنطقة: ")
    طابق منطقة
        حالة "غابة":
            اطبع_سطر("الغابة المظلمة")
            اطبع_سطر("      🌲 أشجار كثيفة ومخلوقات برية")
            خبرة_لاعب = خبرة_لاعب + 10
        حالة "جبل":
            اطبع_سطر("جبل التنين")
            اطبع_سطر("      🏔 قمة شاهقة مع كنوز قديمة")
            خبرة_لاعب = خبرة_لاعب + 25
        حالة "كهف":
            اطبع_سطر("كهف العظام")
            اطبع_سطر("      🦴 ظلام دامس وأخطار خفية")
            خبرة_لاعب = خبرة_لاعب + 20
        حالة "قلعة":
            اطبع_سطر("قلعة الظلام")
            اطبع_سطر("      🏰 حصن قديم محصن بالسحر")
            خبرة_لاعب = خبرة_لاعب + 40
        حالة "صحراء":
            اطبع_سطر("صحراء النسيان")
            اطبع_سطر("      🏜 رمال لا نهائية وسراب")
            خبرة_لاعب = خبرة_لاعب + 15
        حالة "بحر":
            اطبع_سطر("بحر العواصف")
            اطبع_سطر("      🌊 أمواج عاتية ووحوش بحرية")
            خبرة_لاعب = خبرة_لاعب + 30
        حالة _:
            اطبع_سطر("منطقة مجهولة")
            اطبع_سطر("      ❓ خطر غير معروف")
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 3: نظام القتال
# ═══════════════════════════════════════
دالة هجوم_لاعب_على(نوع_هجوم: نص)
    اطبع("    ⚔ هجوم: ")
    طابق نوع_هجوم
        حالة "عادي":
            ضرر_معركة = هجوم_لاعب
            اطبع_سطر("ضربة عادية")
        حالة "قوي":
            ضرر_معركة = هجوم_لاعب * 2
            طاقة_لاعب = طاقة_لاعب - 10
            اطبع_سطر("ضربة قوية!")
        حالة "سحري":
            ضرر_معركة = هجوم_لاعب * 3
            طاقة_لاعب = طاقة_لاعب - 25
            اطبع_سطر("تعويذة سحرية!!")
        حالة "خفي":
            ضرر_معركة = هجوم_لاعب + 10
            طاقة_لاعب = طاقة_لاعب - 5
            اطبع_سطر("هجوم خفي")
        حالة _:
            ضرر_معركة = 5
            اطبع_سطر("هجوم ضعيف")
    نهاية
    اطبع("      الضرر: ")
    اطبع_سطر(ضرر_معركة)
نهاية

# ═══════════════════════════════════════
# القسم 4: المتجر
# ═══════════════════════════════════════
متغير سعر_عنصر = 0

دالة شراء_عنصر(عنصر: نص)
    اطبع("    🛒 ")
    طابق عنصر
        حالة "سيف":
            سعر_عنصر = 100
            هجوم_لاعب = هجوم_لاعب + 5
            اطبع_سطر("سيف حديدي (+5 هجوم) - 100 ذهب")
        حالة "درع_ف":
            سعر_عنصر = 80
            درع_لاعب = درع_لاعب + 5
            اطبع_سطر("درع جلدي (+5 درع) - 80 ذهب")
        حالة "جرعة_صحة":
            سعر_عنصر = 30
            صحة_لاعب = صحة_لاعب + 25
            اطبع_سطر("جرعة صحة (+25 صحة) - 30 ذهب")
        حالة "جرعة_طاقة":
            سعر_عنصر = 25
            طاقة_لاعب = طاقة_لاعب + 20
            اطبع_سطر("جرعة طاقة (+20 طاقة) - 25 ذهب")
        حالة "خاتم":
            سعر_عنصر = 150
            هجوم_لاعب = هجوم_لاعب + 3
            درع_لاعب = درع_لاعب + 3
            اطبع_سطر("خاتم سحري (+3 هجوم/درع) - 150 ذهب")
        حالة _:
            سعر_عنصر = 0
            اطبع_سطر("عنصر غير متوفر")
    نهاية
    ذهب_لاعب = ذهب_لاعب - سعر_عنصر
نهاية

# ═══════════════════════════════════════
# القسم 5: الأعداء
# ═══════════════════════════════════════
دالة مواجهة_عدو(عدو: نص)
    اطبع_سطر("")
    اطبع("    👹 مواجهة: ")
    طابق عدو
        حالة "جرذ":
            اطبع_سطر("جرذ ضخم")
            صحة_عدو_ح = 20
            اطبع_سطر("      صحة: 20 | مكافأة: 5 ذهب + 5 خبرة")
            ذهب_لاعب = ذهب_لاعب + 5
            خبرة_لاعب = خبرة_لاعب + 5
        حالة "ذئب":
            اطبع_سطر("ذئب متوحش")
            صحة_عدو_ح = 50
            اطبع_سطر("      صحة: 50 | مكافأة: 15 ذهب + 12 خبرة")
            ذهب_لاعب = ذهب_لاعب + 15
            خبرة_لاعب = خبرة_لاعب + 12
        حالة "تنين":
            اطبع_سطر("تنين ناري!!")
            صحة_عدو_ح = 200
            اطبع_سطر("      صحة: 200 | مكافأة: 100 ذهب + 50 خبرة")
            ذهب_لاعب = ذهب_لاعب + 100
            خبرة_لاعب = خبرة_لاعب + 50
        حالة "شبح":
            اطبع_سطر("شبح قديم")
            صحة_عدو_ح = 80
            اطبع_سطر("      صحة: 80 | مكافأة: 30 ذهب + 20 خبرة")
            ذهب_لاعب = ذهب_لاعب + 30
            خبرة_لاعب = خبرة_لاعب + 20
        حالة "عملاق":
            اطبع_سطر("عملاق الجبل")
            صحة_عدو_ح = 150
            اطبع_سطر("      صحة: 150 | مكافأة: 60 ذهب + 35 خبرة")
            ذهب_لاعب = ذهب_لاعب + 60
            خبرة_لاعب = خبرة_لاعب + 35
        حالة _:
            اطبع_سطر("مخلوق مجهول")
            صحة_عدو_ح = 30
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 6: نظام المستوى
# ═══════════════════════════════════════
دالة فحص_ترقية()
    طابق مستوى_لاعب
        حالة 1:
            اطبع_سطر("    🌟 المستوى 1 - مبتدئ")
        حالة 2:
            اطبع_سطر("    🌟🌟 المستوى 2 - متعلم")
        حالة 3:
            اطبع_سطر("    🌟🌟🌟 المستوى 3 - ماهر")
        حالة 4:
            اطبع_سطر("    🌟🌟🌟🌟 المستوى 4 - خبير")
        حالة 5:
            اطبع_سطر("    🌟🌟🌟🌟🌟 المستوى 5 - أسطوري!")
        حالة _:
            اطبع_سطر("    🌟 مستوى غير محدد")
    نهاية
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════╗")
    اطبع_سطر("║         محاكاة لعبة RPG                    ║")
    اطبع_سطر("╚══════════════════════════════════════════════╝")

    # === اختيار الشخصية ===
    اطبع_سطر("")
    اطبع_سطر("═══ الفصل 1: اختيار الشخصية ═══")
    اختيار_فئة("ساحر")
    فحص_ترقية()

    # === الاستكشاف ===
    اطبع_سطر("")
    اطبع_سطر("═══ الفصل 2: الاستكشاف ═══")
    استكشاف_منطقة("غابة")
    استكشاف_منطقة("كهف")
    استكشاف_منطقة("جبل")

    # === التسوق ===
    اطبع_سطر("")
    اطبع_سطر("═══ الفصل 3: المتجر ═══")
    اطبع("    💰 الذهب قبل التسوق: ")
    اطبع_سطر(ذهب_لاعب)
    شراء_عنصر("سيف")
    شراء_عنصر("جرعة_صحة")
    شراء_عنصر("جرعة_طاقة")
    اطبع("    💰 الذهب بعد التسوق: ")
    اطبع_سطر(ذهب_لاعب)

    # === المعارك ===
    اطبع_سطر("")
    اطبع_سطر("═══ الفصل 4: المعارك ═══")
    مواجهة_عدو("جرذ")
    هجوم_لاعب_على("عادي")

    مواجهة_عدو("ذئب")
    هجوم_لاعب_على("قوي")

    مواجهة_عدو("شبح")
    هجوم_لاعب_على("سحري")

    مواجهة_عدو("عملاق")
    هجوم_لاعب_على("خفي")

    مواجهة_عدو("تنين")
    هجوم_لاعب_على("سحري")

    # === ترقية المستوى ===
    مستوى_لاعب = 3

    # === الملخص ===
    اطبع_سطر("")
    اطبع_سطر("═══ ملخص المغامرة ═══")
    اطبع("    ❤ الصحة: ")
    اطبع_سطر(صحة_لاعب)
    اطبع("    ⚡ الطاقة: ")
    اطبع_سطر(طاقة_لاعب)
    اطبع("    💰 الذهب: ")
    اطبع_سطر(ذهب_لاعب)
    اطبع("    ⚔ الهجوم: ")
    اطبع_سطر(هجوم_لاعب)
    اطبع("    🛡 الدرع: ")
    اطبع_سطر(درع_لاعب)
    اطبع("    📊 الخبرة: ")
    اطبع_سطر(خبرة_لاعب)
    فحص_ترقية()

    اطبع_سطر("")
    اطبع_سطر("=== انتهت المغامرة ===")
نهاية
