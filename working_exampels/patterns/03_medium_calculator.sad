# ═══════════════════════════════════════════════════════════
# مثال متوسط: آلة حاسبة بمطابقة الأنماط
# Medium: Calculator with Pattern Matching
# ═══════════════════════════════════════════════════════════

# === حساب العملية ===
متغير نتيجة_حساب = 0

دالة حساب_ع(أ: رقم، ب: رقم، عملية: نص)
    طابق عملية
        حالة "جمع":
            نتيجة_حساب = أ + ب
            اطبع_سطر("    جمع")
        حالة "طرح":
            نتيجة_حساب = أ - ب
            اطبع_سطر("    طرح")
        حالة "ضرب":
            نتيجة_حساب = أ * ب
            اطبع_سطر("    ضرب")
        حالة "قسمة":
            نتيجة_حساب = أ / ب
            اطبع_سطر("    قسمة")
        حالة "باقي":
            نتيجة_حساب = أ % ب
            اطبع_سطر("    باقي القسمة")
        حالة _:
            نتيجة_حساب = 0
            اطبع_سطر("    عملية غير معروفة")
    نهاية
نهاية

# === تحويل الشهر ===
دالة وصف_شهر(رقم_شهر: رقم)
    طابق رقم_شهر
        حالة 1:
            اطبع_سطر("    يناير - شتاء")
        حالة 2:
            اطبع_سطر("    فبراير - شتاء")
        حالة 3:
            اطبع_سطر("    مارس - ربيع")
        حالة 4:
            اطبع_سطر("    أبريل - ربيع")
        حالة 5:
            اطبع_سطر("    مايو - ربيع")
        حالة 6:
            اطبع_سطر("    يونيو - صيف")
        حالة 7:
            اطبع_سطر("    يوليو - صيف")
        حالة 8:
            اطبع_سطر("    أغسطس - صيف")
        حالة 9:
            اطبع_سطر("    سبتمبر - خريف")
        حالة 10:
            اطبع_سطر("    أكتوبر - خريف")
        حالة 11:
            اطبع_سطر("    نوفمبر - خريف")
        حالة 12:
            اطبع_سطر("    ديسمبر - شتاء")
        حالة _:
            اطبع_سطر("    شهر غير صالح")
    نهاية
نهاية

# === تقييم الطالب ===
متغير تقدير_ط = "غ"

دالة تقييم_درجة(درجة: رقم)
    طابق درجة
        حالة 100:
            تقدير_ط = "ممتاز+"
        حالة 95:
            تقدير_ط = "ممتاز"
        حالة 90:
            تقدير_ط = "ممتاز"
        حالة 85:
            تقدير_ط = "جيد جداً"
        حالة 80:
            تقدير_ط = "جيد جداً"
        حالة 75:
            تقدير_ط = "جيد"
        حالة 70:
            تقدير_ط = "جيد"
        حالة 65:
            تقدير_ط = "مقبول"
        حالة 60:
            تقدير_ط = "مقبول"
        حالة 50:
            تقدير_ط = "ضعيف"
        حالة _:
            تقدير_ط = "غير محدد"
    نهاية
نهاية

# === تحويل العملة ===
متغير معامل_تحويل = 0

دالة عامل_عملة(عملة: نص)
    طابق عملة
        حالة "دولار":
            معامل_تحويل = 375
            اطبع_سطر("    الدولار الأمريكي")
        حالة "يورو":
            معامل_تحويل = 410
            اطبع_سطر("    اليورو")
        حالة "جنيه":
            معامل_تحويل = 475
            اطبع_سطر("    الجنيه الاسترليني")
        حالة "ين":
            معامل_تحويل = 3
            اطبع_سطر("    الين الياباني")
        حالة "درهم":
            معامل_تحويل = 102
            اطبع_سطر("    الدرهم الإماراتي")
        حالة _:
            معامل_تحويل = 0
            اطبع_سطر("    عملة غير معروفة")
    نهاية
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║   آلة حاسبة بمطابقة الأنماط      ║")
    اطبع_سطر("╚══════════════════════════════════════╝")

    # === العمليات الحسابية ===
    اطبع_سطر("")
    اطبع_سطر("--- العمليات الحسابية ---")

    حساب_ع(10، 5، "جمع")
    متغير نت1 = نتيجة_حساب
    اطبع("    10 + 5 = ")
    اطبع_سطر(نت1)

    حساب_ع(20، 7، "طرح")
    متغير نت2 = نتيجة_حساب
    اطبع("    20 - 7 = ")
    اطبع_سطر(نت2)

    حساب_ع(6، 8، "ضرب")
    متغير نت3 = نتيجة_حساب
    اطبع("    6 × 8 = ")
    اطبع_سطر(نت3)

    حساب_ع(100، 4، "قسمة")
    متغير نت4 = نتيجة_حساب
    اطبع("    100 ÷ 4 = ")
    اطبع_سطر(نت4)

    حساب_ع(17، 5، "باقي")
    متغير نت5 = نتيجة_حساب
    اطبع("    17 %% 5 = ")
    اطبع_سطر(نت5)

    حساب_ع(1، 1، "مجهول")

    # === الشهور ===
    اطبع_سطر("")
    اطبع_سطر("--- أوصاف الشهور ---")
    وصف_شهر(1)
    وصف_شهر(3)
    وصف_شهر(6)
    وصف_شهر(9)
    وصف_شهر(12)
    وصف_شهر(13)

    # === الدرجات ===
    اطبع_سطر("")
    اطبع_سطر("--- تقييم الدرجات ---")

    تقييم_درجة(100)
    متغير تق1 = تقدير_ط
    اطبع("    100 → ")
    اطبع_سطر(تق1)

    تقييم_درجة(85)
    متغير تق2 = تقدير_ط
    اطبع("    85 → ")
    اطبع_سطر(تق2)

    تقييم_درجة(70)
    متغير تق3 = تقدير_ط
    اطبع("    70 → ")
    اطبع_سطر(تق3)

    تقييم_درجة(60)
    متغير تق4 = تقدير_ط
    اطبع("    60 → ")
    اطبع_سطر(تق4)

    تقييم_درجة(50)
    متغير تق5 = تقدير_ط
    اطبع("    50 → ")
    اطبع_سطر(تق5)

    # === العملات ===
    اطبع_سطر("")
    اطبع_سطر("--- تحويل العملات ---")
    عامل_عملة("دولار")
    عامل_عملة("يورو")
    عامل_عملة("جنيه")
    عامل_عملة("ين")
    عامل_عملة("عملة_مجهولة")

    اطبع_سطر("")
    اطبع_سطر("=== انتهت الآلة الحاسبة ===")
نهاية
