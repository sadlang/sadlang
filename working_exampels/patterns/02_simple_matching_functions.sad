# ═══════════════════════════════════════════════════════════
# مثال بسيط: مطابقة الأنماط مع دوال
# Simple: Pattern Matching with Functions
# ═══════════════════════════════════════════════════════════

# === دوال مطابقة الأرقام ===
دالة وصف_عمر(عمر_ق: رقم)
    طابق عمر_ق
        حالة 0:
            اطبع_سطر("    مولود جديد")
        حالة 1:
            اطبع_سطر("    رضيع")
        حالة 5:
            اطبع_سطر("    طفل صغير")
        حالة 10:
            اطبع_سطر("    طفل")
        حالة 15:
            اطبع_سطر("    مراهق")
        حالة 20:
            اطبع_سطر("    شاب")
        حالة 30:
            اطبع_سطر("    بالغ")
        حالة 50:
            اطبع_سطر("    كبير")
        حالة _:
            اطبع_سطر("    عمر آخر")
    نهاية
نهاية

# === دوال مطابقة النصوص ===
دالة وصف_يوم(يوم: نص)
    طابق يوم
        حالة "السبت":
            اطبع_سطر("    بداية الأسبوع")
        حالة "الأحد":
            اطبع_سطر("    يوم عمل")
        حالة "الاثنين":
            اطبع_سطر("    يوم عمل")
        حالة "الثلاثاء":
            اطبع_سطر("    يوم عمل")
        حالة "الأربعاء":
            اطبع_سطر("    منتصف الأسبوع")
        حالة "الخميس":
            اطبع_سطر("    قبل العطلة")
        حالة "الجمعة":
            اطبع_سطر("    عطلة نهاية الأسبوع")
        حالة _:
            اطبع_سطر("    يوم غير معروف")
    نهاية
نهاية

# === مطابقة رموز الحالة ===
دالة وصف_رمز(رمز: رقم)
    طابق رمز
        حالة 200:
            اطبع_سطر("    نجاح (OK)")
        حالة 201:
            اطبع_سطر("    تم الإنشاء (Created)")
        حالة 301:
            اطبع_سطر("    تحويل دائم")
        حالة 302:
            اطبع_سطر("    تحويل مؤقت")
        حالة 400:
            اطبع_سطر("    طلب خاطئ")
        حالة 401:
            اطبع_سطر("    غير مصرح")
        حالة 403:
            اطبع_سطر("    محظور")
        حالة 404:
            اطبع_سطر("    غير موجود")
        حالة 500:
            اطبع_سطر("    خطأ في الخادم")
        حالة _:
            اطبع_سطر("    رمز غير معروف")
    نهاية
نهاية

# === مطابقة الأولويات ===
دالة وصف_أولوية(مستوى: رقم)
    طابق مستوى
        حالة 1:
            اطبع_سطر("    عاجل جداً 🔴")
        حالة 2:
            اطبع_سطر("    عاجل 🟠")
        حالة 3:
            اطبع_سطر("    عادي 🟡")
        حالة 4:
            اطبع_سطر("    منخفض 🟢")
        حالة 5:
            اطبع_سطر("    غير مهم ⚪")
        حالة _:
            اطبع_سطر("    أولوية غير معروفة")
    نهاية
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("=== مطابقة الأنماط مع دوال ===")
    اطبع_سطر("")

    اطبع_سطر("--- الأعمار ---")
    وصف_عمر(0)
    وصف_عمر(1)
    وصف_عمر(10)
    وصف_عمر(20)
    وصف_عمر(50)
    وصف_عمر(99)

    اطبع_سطر("")
    اطبع_سطر("--- الأيام ---")
    وصف_يوم("السبت")
    وصف_يوم("الأربعاء")
    وصف_يوم("الجمعة")
    وصف_يوم("يوم_وهمي")

    اطبع_سطر("")
    اطبع_سطر("--- رموز HTTP ---")
    وصف_رمز(200)
    وصف_رمز(404)
    وصف_رمز(500)
    وصف_رمز(999)

    اطبع_سطر("")
    اطبع_سطر("--- الأولويات ---")
    وصف_أولوية(1)
    وصف_أولوية(3)
    وصف_أولوية(5)
    وصف_أولوية(9)

    اطبع_سطر("")
    اطبع_سطر("=== انتهى ===")
نهاية
