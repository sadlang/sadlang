# مثال متوسط: نظام القوائم بمطابقة الأنماط
# Medium: Menu System with Pattern Matching
# ═══════════════════════════════════════════════════════════

# === حالة النظام ===
متغير رصيد_مح = 1000
متغير عدد_عمليات_منجزة = 0

# === قائمة البنك ===
دالة عملية_بنكية(عملية_ب: نص، مبلغ_ب: رقم)
    طابق عملية_ب
        حالة "إيداع":
            رصيد_مح = رصيد_مح + مبلغ_ب
            اطبع("    ✓ إيداع ")
            اطبع(مبلغ_ب)
            اطبع_سطر(" ريال")
        حالة "سحب":
            رصيد_مح = رصيد_مح - مبلغ_ب
            اطبع("    ✓ سحب ")
            اطبع(مبلغ_ب)
            اطبع_سطر(" ريال")
        حالة "استعلام":
            اطبع("    الرصيد الحالي: ")
            اطبع(رصيد_مح)
            اطبع_سطر(" ريال")
        حالة _:
            اطبع_سطر("    ✗ عملية غير مدعومة")
    نهاية
    عدد_عمليات_منجزة = عدد_عمليات_منجزة + 1
نهاية

# === قائمة المطعم ===
متغير سعر_طبق = 0

دالة اختيار_طبق(طبق: نص)
    طابق طبق
        حالة "كبسة":
            سعر_طبق = 45
            اطبع_سطر("    كبسة لحم - 45 ريال")
        حالة "مندي":
            سعر_طبق = 55
            اطبع_سطر("    مندي دجاج - 55 ريال")
        حالة "مضبي":
            سعر_طبق = 65
            اطبع_سطر("    مضبي حاشي - 65 ريال")
        حالة "سليق":
            سعر_طبق = 40
            اطبع_سطر("    سليق - 40 ريال")
        حالة "جريش":
            سعر_طبق = 35
            اطبع_سطر("    جريش - 35 ريال")
        حالة "مرقوق":
            سعر_طبق = 50
            اطبع_سطر("    مرقوق - 50 ريال")
        حالة _:
            سعر_طبق = 0
            اطبع_سطر("    ✗ طبق غير متوفر")
    نهاية
نهاية

# === قائمة الألوان ===
دالة وصف_لون(لون_: نص)
    طابق لون_
        حالة "احمر":
            اطبع_سطر("    🔴 أحمر - لون الحب والقوة")
        حالة "اخضر":
            اطبع_سطر("    🟢 أخضر - لون الطبيعة")
        حالة "ازرق":
            اطبع_سطر("    🔵 أزرق - لون السماء")
        حالة "اصفر":
            اطبع_سطر("    🟡 أصفر - لون الشمس")
        حالة "ابيض":
            اطبع_سطر("    ⚪ أبيض - لون النقاء")
        حالة "اسود":
            اطبع_سطر("    ⚫ أسود - لون الليل")
        حالة _:
            اطبع_سطر("    ❓ لون غير محدد")
    نهاية
نهاية

# === قائمة الاتجاهات ===
دالة وصف_اتجاه(اتجاه: نص)
    طابق اتجاه
        حالة "شمال":
            اطبع_سطر("    ↑ شمال - نحو القطب الشمالي")
        حالة "جنوب":
            اطبع_سطر("    ↓ جنوب - نحو القطب الجنوبي")
        حالة "شرق":
            اطبع_سطر("    → شرق - مشرق الشمس")
        حالة "غرب":
            اطبع_سطر("    ← غرب - مغرب الشمس")
        حالة _:
            اطبع_سطر("    ❓ اتجاه غير معروف")
    نهاية
نهاية

# === رموز الخطأ ===
دالة وصف_خطأ_نظام(رمز_خ: رقم)
    طابق رمز_خ
        حالة 0:
            اطبع_سطر("    ✓ لا يوجد خطأ")
        حالة 1:
            اطبع_سطر("    ✗ خطأ في الإدخال")
        حالة 2:
            اطبع_سطر("    ✗ خطأ في الشبكة")
        حالة 3:
            اطبع_سطر("    ✗ خطأ في قاعدة البيانات")
        حالة 4:
            اطبع_سطر("    ✗ خطأ في المصادقة")
        حالة 5:
            اطبع_سطر("    ✗ خطأ في الصلاحيات")
        حالة _:
            اطبع_سطر("    ✗ خطأ غير معروف")
    نهاية
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║   نظام القوائم المتعددة           ║")
    اطبع_سطر("╚══════════════════════════════════════╝")

    # === البنك ===
    اطبع_سطر("")
    اطبع_سطر("--- العمليات البنكية ---")
    عملية_بنكية("استعلام"، 0)
    عملية_بنكية("إيداع"، 500)
    عملية_بنكية("استعلام"، 0)
    عملية_بنكية("سحب"، 200)
    عملية_بنكية("استعلام"، 0)
    عملية_بنكية("تحويل"، 100)
    اطبع("    العمليات المنجزة: ")
    اطبع_سطر(عدد_عمليات_منجزة)

    # === المطعم ===
    اطبع_سطر("")
    اطبع_سطر("--- قائمة المطعم ---")
    اختيار_طبق("كبسة")
    اختيار_طبق("مندي")
    اختيار_طبق("مضبي")
    اختيار_طبق("سليق")
    اختيار_طبق("بيتزا")

    # === الألوان ===
    اطبع_سطر("")
    اطبع_سطر("--- وصف الألوان ---")
    وصف_لون("احمر")
    وصف_لون("اخضر")
    وصف_لون("ازرق")
    وصف_لون("اصفر")
    وصف_لون("بنفسجي")

    # === الاتجاهات ===
    اطبع_سطر("")
    اطبع_سطر("--- الاتجاهات ---")
    وصف_اتجاه("شمال")
    وصف_اتجاه("جنوب")
    وصف_اتجاه("شرق")
    وصف_اتجاه("غرب")
    وصف_اتجاه("فوق")

    # === رموز الخطأ ===
    اطبع_سطر("")
    اطبع_سطر("--- رموز الأخطاء ---")
    وصف_خطأ_نظام(0)
    وصف_خطأ_نظام(1)
    وصف_خطأ_نظام(3)
    وصف_خطأ_نظام(5)
    وصف_خطأ_نظام(99)

    اطبع_سطر("")
    اطبع_سطر("=== انتهى نظام القوائم ===")
نهاية
