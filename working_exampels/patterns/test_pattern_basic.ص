# اختبار أساسي لـ Pattern Matching (مطابقة الأنماط)
# Basic Pattern Matching Test
# ═══════════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("=== اختبار Pattern Matching الأساسي ===")
    اطبع_سطر("")

    # ─── 1. مطابقة أرقام صحيحة ──────────────────
    اطبع_سطر("--- 1. مطابقة ارقام ---")
    متغير س = 42
    طابق س
        حالة 1:
            اطبع_سطر("الرقم هو واحد")
        حالة 42:
            اطبع_سطر("الرقم هو 42 - صحيح!")
        حالة _:
            اطبع_سطر("رقم آخر")
    نهاية

    # ─── 2. مطابقة نصوص ──────────────────────────
    اطبع_سطر("")
    اطبع_سطر("--- 2. مطابقة نصوص ---")
    متغير ل = "احمر"
    طابق ل
        حالة "اخضر":
            اطبع_سطر("اللون اخضر")
        حالة "احمر":
            اطبع_سطر("اللون احمر - صحيح!")
        حالة "ازرق":
            اطبع_سطر("اللون ازرق")
        حالة _:
            اطبع_سطر("لون غير معروف")
    نهاية

    # ─── 3. النمط الشامل (Wildcard) ─────────────
    اطبع_سطر("")
    اطبع_سطر("--- 3. النمط الشامل _ ---")
    متغير ق = 999
    طابق ق
        حالة 1:
            اطبع_سطر("واحد")
        حالة 2:
            اطبع_سطر("اثنان")
        حالة _:
            اطبع_سطر("قيمة اخرى (wildcard) - صحيح!")
    نهاية

    # ─── 4. مطابقة قيم منطقية ────────────────────
    اطبع_سطر("")
    اطبع_سطر("--- 4. مطابقة قيم منطقية ---")
    متغير ن = صحيح
    طابق ن
        حالة صحيح:
            اطبع_سطر("النتيجة صحيحة - صحيح!")
        حالة خطأ:
            اطبع_سطر("النتيجة خاطئة")
    نهاية

    # ─── 5. مطابقة الصفر ─────────────────────────
    اطبع_سطر("")
    اطبع_سطر("--- 5. مطابقة الصفر ---")
    متغير ص = 0
    طابق ص
        حالة 0:
            اطبع_سطر("القيمة صفر - صحيح!")
        حالة _:
            اطبع_سطر("القيمة ليست صفر")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("=== انتهى الاختبار الأساسي ===")
    ارجع 0
نهاية
