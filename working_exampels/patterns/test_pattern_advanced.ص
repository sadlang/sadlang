# --- دالة مساعدة ---
دالة حدد_نوع(قيمة)
    طابق قيمة
        حالة 1:
            ارجع "واحد"
        حالة 2:
            ارجع "اثنان"
        حالة 3:
            ارجع "ثلاثة"
        حالة _:
            ارجع "رقم آخر"
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== اختبار Pattern Matching المتقدم ===")
    اطبع_سطر("")

    # --- 1. مطابقة مع حارس (Guard) ---
    اطبع_سطر("--- 1. مطابقة مع حارس ---")
    متغير ع = 15
    طابق ع
        حالة 15 اذا (ع > 10):
            اطبع_سطر("15 وهو اكبر من 10 - صحيح!")
        حالة 15:
            اطبع_سطر("15 بدون حارس")
        حالة _:
            اطبع_سطر("قيمة اخرى")
    نهاية

    اطبع_سطر("")

    # --- 2. نمط OR (||) ---
    اطبع_سطر("--- 2. نمط OR ---")
    متغير ح = "ب"
    طابق ح
        حالة "أ" || "ب" || "ت":
            اطبع_سطر("حرف من الثلاثة الاولى - صحيح!")
        حالة _:
            اطبع_سطر("حرف آخر")
    نهاية

    اطبع_سطر("")

    # --- 3. جسم متعدد الجمل ---
    اطبع_سطر("--- 3. جسم متعدد الجمل ---")
    متغير ر = 100
    طابق ر
        حالة 100:
            متغير نتيجة = "مئة"
            اطبع_سطر("الرقم هو: " + نتيجة)
            اطبع_سطر("وهو عدد كبير - صحيح!")
        حالة _:
            اطبع_سطر("رقم آخر")
    نهاية

    اطبع_سطر("")

    # --- 4. دالة مع match و return ---
    اطبع_سطر("--- 4. دالة مع match و return ---")
    اطبع_سطر("حدد_نوع(1) = " + حدد_نوع(1))
    اطبع_سطر("حدد_نوع(2) = " + حدد_نوع(2))
    اطبع_سطر("حدد_نوع(5) = " + حدد_نوع(5))

    اطبع_سطر("")

    # --- 5. match متداخل ---
    اطبع_سطر("--- 5. match متداخل ---")
    متغير فئة = "طالب"
    متغير عمر = 20
    طابق فئة
        حالة "طالب":
            طابق عمر
                حالة 20:
                    اطبع_سطر("طالب عمره 20 - صحيح!")
                حالة _:
                    اطبع_سطر("طالب بعمر آخر")
            نهاية
        حالة _:
            اطبع_سطر("فئة اخرى")
    نهاية

    اطبع_سطر("")

    # --- 6. match مع حارس على متغير خارجي ---
    اطبع_سطر("--- 6. match مع حارس على متغير خارجي ---")
    متغير حد = 50
    متغير قيم = 75
    طابق قيم
        حالة _ اذا (قيم > حد):
            اطبع_سطر("القيمة " + قيم + " اكبر من الحد " + حد + " - صحيح!")
        حالة _:
            اطبع_سطر("القيمة اصغر من الحد")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("=== اكتمل الاختبار المتقدم بنجاح! ===")
    ارجع 0
نهاية
