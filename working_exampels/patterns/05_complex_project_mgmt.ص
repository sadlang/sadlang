# === حالة النظام العامة ===
متغير مهام_مكتملة = 0
متغير مهام_جارية = 0
متغير مهام_منتظرة = 0
متغير اجمالي_ساعات = 0
متغير ميزانية_مستهلكة = 0
متغير ميزانية_كلية = 10000

# ═══════════════════════════════════════
# القسم 1: إدارة حالات المهام
# ═══════════════════════════════════════
دالة تحديث_مهمة(اسم_مهمة: نص، وضع: نص)
    اطبع("    📋 ")
    اطبع(اسم_مهمة)
    اطبع(": ")
    طابق وضع
        حالة "جديدة":
            اطبع_سطر("⭐ جديدة")
            مهام_منتظرة = مهام_منتظرة + 1
        حالة "جارية":
            اطبع_سطر("🔄 قيد التنفيذ")
            مهام_جارية = مهام_جارية + 1
        حالة "مراجعة":
            اطبع_سطر("👁 قيد المراجعة")
        حالة "مكتملة":
            اطبع_سطر("✅ مكتملة")
            مهام_مكتملة = مهام_مكتملة + 1
        حالة "ملغاة":
            اطبع_سطر("❌ ملغاة")
        حالة _:
            اطبع_سطر("❓ حالة غير معروفة")
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 2: تصنيف الأولوية
# ═══════════════════════════════════════
دالة تصنيف_أولوية(نوع_مهمة: نص)
    اطبع("    ")
    طابق نوع_مهمة
        حالة "حرج":
            اطبع_سطر("🔴 أولوية حرجة - يجب البدء فوراً")
        حالة "عالي":
            اطبع_سطر("🟠 أولوية عالية - هذا الأسبوع")
        حالة "متوسط":
            اطبع_سطر("🟡 أولوية متوسطة - هذا الشهر")
        حالة "منخفض":
            اطبع_سطر("🟢 أولوية منخفضة - لاحقاً")
        حالة "تجميد":
            اطبع_سطر("🔵 مجمدة - غير محددة")
        حالة _:
            اطبع_سطر("⚪ غير مصنفة")
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 3: تصنيف نوع العمل
# ═══════════════════════════════════════
متغير ساعات_عمل_تقدير = 0

دالة تقدير_ساعات(صنف_عمل: نص)
    طابق صنف_عمل
        حالة "تصميم":
            ساعات_عمل_تقدير = 20
            اطبع_سطر("    📐 تصميم - 20 ساعة")
        حالة "برمجة":
            ساعات_عمل_تقدير = 40
            اطبع_سطر("    💻 برمجة - 40 ساعة")
        حالة "اختبار_":
            ساعات_عمل_تقدير = 15
            اطبع_سطر("    🧪 اختبار - 15 ساعة")
        حالة "توثيق":
            ساعات_عمل_تقدير = 10
            اطبع_سطر("    📝 توثيق - 10 ساعة")
        حالة "نشر":
            ساعات_عمل_تقدير = 5
            اطبع_سطر("    🚀 نشر - 5 ساعة")
        حالة "صيانة":
            ساعات_عمل_تقدير = 8
            اطبع_سطر("    🔧 صيانة - 8 ساعات")
        حالة _:
            ساعات_عمل_تقدير = 0
            اطبع_سطر("    ❓ نوع غير معروف - 0 ساعة")
    نهاية
    اجمالي_ساعات = اجمالي_ساعات + ساعات_عمل_تقدير
نهاية

# ═══════════════════════════════════════
# القسم 4: إدارة الفريق
# ═══════════════════════════════════════
دالة دور_عضو(دور: نص)
    اطبع("    ")
    طابق دور
        حالة "مدير":
            اطبع_سطر("👔 مدير المشروع - الإشراف والتنسيق")
        حالة "مبرمج":
            اطبع_سطر("👨‍💻 مبرمج - كتابة الأكواد")
        حالة "مصمم":
            اطبع_سطر("🎨 مصمم - واجهة المستخدم")
        حالة "محلل":
            اطبع_سطر("📊 محلل - تحليل المتطلبات")
        حالة "فاحص":
            اطبع_سطر("🔍 فاحص - ضمان الجودة")
        حالة "مدرب":
            اطبع_سطر("📚 مدرب - تدريب الفريق")
        حالة _:
            اطبع_سطر("❓ دور غير محدد")
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 5: الميزانية
# ═══════════════════════════════════════
دالة بند_ميزانية(بند: نص، مبلغ_م: رقم)
    اطبع("    💰 ")
    اطبع(بند)
    اطبع(": ")
    اطبع(مبلغ_م)
    اطبع_سطر(" ريال")

    طابق بند
        حالة "رواتب":
            ميزانية_مستهلكة = ميزانية_مستهلكة + مبلغ_م
            اطبع_سطر("      ↳ بند ثابت")
        حالة "معدات":
            ميزانية_مستهلكة = ميزانية_مستهلكة + مبلغ_م
            اطبع_سطر("      ↳ بند استثماري")
        حالة "تراخيص":
            ميزانية_مستهلكة = ميزانية_مستهلكة + مبلغ_م
            اطبع_سطر("      ↳ بند سنوي")
        حالة "تدريب_ب":
            ميزانية_مستهلكة = ميزانية_مستهلكة + مبلغ_م
            اطبع_سطر("      ↳ بند تطويري")
        حالة "طوارئ":
            ميزانية_مستهلكة = ميزانية_مستهلكة + مبلغ_م
            اطبع_سطر("      ↳ بند احتياطي")
        حالة _:
            اطبع_سطر("      ↳ بند غير مصنف")
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 6: تقرير المخاطر
# ═══════════════════════════════════════
دالة تقييم_خطر(مستوى_خطر: نص)
    اطبع("    ⚠ ")
    طابق مستوى_خطر
        حالة "كارثي":
            اطبع_سطر("كارثي - إيقاف المشروع")
        حالة "عال":
            اطبع_سطر("عالٍ - خطة طوارئ فورية")
        حالة "متوسط_":
            اطبع_سطر("متوسط - مراقبة مستمرة")
        حالة "قليل":
            اطبع_سطر("قليل - متابعة دورية")
        حالة "معدوم":
            اطبع_سطر("معدوم - لا إجراء مطلوب")
        حالة _:
            اطبع_سطر("غير محدد")
    نهاية
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════╗")
    اطبع_سطر("║     نظام إدارة المشاريع المتكامل         ║")
    اطبع_سطر("╚══════════════════════════════════════════════╝")

    # === 1. المهام ===
    اطبع_سطر("")
    اطبع_سطر("═══ حالات المهام ═══")
    تحديث_مهمة("تصميم الواجهة"، "مكتملة")
    تحديث_مهمة("تطوير API"، "جارية")
    تحديث_مهمة("كتابة الاختبارات"، "جديدة")
    تحديث_مهمة("نشر الإنتاج"، "منتظرة")
    تحديث_مهمة("تحديث التوثيق"، "مراجعة")
    تحديث_مهمة("إصلاح الأخطاء"، "جارية")
    تحديث_مهمة("مراجعة الكود"، "مكتملة")
    تحديث_مهمة("تحسين الأداء"، "ملغاة")

    # === 2. الأولويات ===
    اطبع_سطر("")
    اطبع_سطر("═══ تصنيف الأولويات ═══")
    تصنيف_أولوية("حرج")
    تصنيف_أولوية("عالي")
    تصنيف_أولوية("متوسط")
    تصنيف_أولوية("منخفض")
    تصنيف_أولوية("تجميد")

    # === 3. ساعات العمل ===
    اطبع_سطر("")
    اطبع_سطر("═══ تقدير ساعات العمل ═══")
    تقدير_ساعات("تصميم")
    تقدير_ساعات("برمجة")
    تقدير_ساعات("اختبار_")
    تقدير_ساعات("توثيق")
    تقدير_ساعات("نشر")
    تقدير_ساعات("صيانة")

    # === 4. الفريق ===
    اطبع_سطر("")
    اطبع_سطر("═══ أدوار الفريق ═══")
    دور_عضو("مدير")
    دور_عضو("مبرمج")
    دور_عضو("مصمم")
    دور_عضو("محلل")
    دور_عضو("فاحص")
    دور_عضو("مساعد")

    # === 5. الميزانية ===
    اطبع_سطر("")
    اطبع_سطر("═══ بنود الميزانية ═══")
    بند_ميزانية("رواتب"، 5000)
    بند_ميزانية("معدات"، 2000)
    بند_ميزانية("تراخيص"، 500)
    بند_ميزانية("تدريب_ب"، 800)
    بند_ميزانية("طوارئ"، 700)

    # === 6. المخاطر ===
    اطبع_سطر("")
    اطبع_سطر("═══ تقييم المخاطر ═══")
    تقييم_خطر("كارثي")
    تقييم_خطر("عال")
    تقييم_خطر("متوسط_")
    تقييم_خطر("قليل")
    تقييم_خطر("معدوم")

    # === الملخص ===
    اطبع_سطر("")
    اطبع_سطر("═══ ملخص المشروع ═══")
    اطبع("    مهام مكتملة: ")
    اطبع_سطر(مهام_مكتملة)
    اطبع("    مهام جارية: ")
    اطبع_سطر(مهام_جارية)
    اطبع("    مهام منتظرة: ")
    اطبع_سطر(مهام_منتظرة)
    اطبع("    إجمالي الساعات: ")
    اطبع_سطر(اجمالي_ساعات)
    اطبع("    الميزانية المستهلكة: ")
    اطبع(ميزانية_مستهلكة)
    اطبع_سطر(" ريال")
    متغير متبقي_م = ميزانية_كلية - ميزانية_مستهلكة
    اطبع("    الميزانية المتبقية: ")
    اطبع(متبقي_م)
    اطبع_سطر(" ريال")

    اطبع_سطر("")
    اطبع_سطر("=== انتهى نظام إدارة المشاريع ===")
نهاية
