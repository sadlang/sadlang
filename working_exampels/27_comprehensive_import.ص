# ==============================================
# مثال شامل: نظام الاستيراد والتصدير
# Comprehensive Example: Import/Export System
# ==============================================
# يوضح هذا المثال جميع أنماط الاستيراد والتصدير:
# 1. استيراد انتقائي: من وحدة استورد رمز
# 2. استيراد عام: من وحدة استورد *
# 3. استيراد بأسماء مستعارة: من وحدة استورد رمز كـ اسم
# 4. استيراد كامل: استورد وحدة
# 5. تسلسل الاستيراد: وحدة تستورد من وحدة أخرى
# 6. تصدير متغيرات ودوال
# ==============================================

# --- استيراد انتقائي من مكتبة الرياضيات ---
من mathlib استورد مضاعف، مربع، مكعب

# --- استيراد بأسماء مستعارة من مكتبة الثوابت ---
من constants استورد سرعة_الضوء كـ ضوء

# --- استيراد من مكتبة النصوص ---
من strutils استورد كرر_نص

# --- استيراد وحدة النصوص (تعتمد على الثوابت) ---
من textlib استورد مرحبا

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  اختبار نظام الاستيراد والتصدير      ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")
    
    # === 1. استيراد انتقائي ===
    اطبع_سطر("--- 1. استيراد انتقائي ---")
    متغير ن1 = مضاعف(7)
    اطبع_سطر("مضاعف(7) = ")
    اطبع_سطر(ن1)
    
    متغير ن2 = مربع(5)
    اطبع_سطر("مربع(5) = ")
    اطبع_سطر(ن2)
    
    متغير ن3 = مكعب(3)
    اطبع_سطر("مكعب(3) = ")
    اطبع_سطر(ن3)
    اطبع_سطر("")
    
    # === 2. أسماء مستعارة ===
    اطبع_سطر("--- 2. أسماء مستعارة ---")
    اطبع_سطر("سرعة الضوء (كـ ضوء) = ")
    اطبع_سطر(ضوء)
    اطبع_سطر("")
    
    # === 3. دوال النصوص ===
    اطبع_سطر("--- 3. دوال النصوص ---")
    متغير نجوم = كرر_نص("*", 10)
    اطبع_سطر(نجوم)
    اطبع_سطر("")
    
    # === 4. استيراد متسلسل ===
    اطبع_سطر("--- 4. استيراد متسلسل ---")
    مرحبا("عالم البرمجة")
    اطبع_سطر("")
    
    # === 5. حسابات مركبة ===
    اطبع_سطر("--- 5. حسابات مركبة ---")
    متغير ن4 = مضاعف(مربع(3))
    اطبع_سطر("مضاعف(مربع(3)) = ")
    اطبع_سطر(ن4)
    
    متغير ن5 = مكعب(مضاعف(2))
    اطبع_سطر("مكعب(مضاعف(2)) = ")
    اطبع_سطر(ن5)
    
    اطبع_سطر("")
    اطبع_سطر("=== انتهى الاختبار بنجاح ===")
    
    ارجع 0
