# تشغيل: sad.exe gui_calculator.sad
# عند التشغيل تظهر نافذة حاسبة مع أزرار
# اضغط على الأزرار بالماوس للحساب
# اضغط Exit للخروج
# ===================================================

# --- دالة رسم زر ---
دالة رسم_زر(رس, بx, بy, عرض, ارتفاع, عنوان, لر, لخ, لز)
    رسام_مستطيل(رس, بx, بy, عرض, ارتفاع, لر, لخ, لز, 255, صحيح)
    رسام_مستطيل(رس, بx, بy, عرض, ارتفاع, 25, 25, 25, 255, خطأ)
    رسام_نص(رس, عنوان, بx + 28, بy + 16, 22, 255, 255, 255, 255)
نهاية

# --- دالة فحص النقر ---
دالة داخل(فx, فy, زx, زy, زw, زh)
    اذا (فx > زx)
        اذا (فx < زx + زw)
            اذا (فy > زy)
                اذا (فy < زy + زh)
                    ارجع 1
                نهاية
            نهاية
        نهاية
    نهاية
    ارجع 0
نهاية

# --- إنشاء النافذة ---
متغير نف = نافذة_جديد("Calculator", 400, 500)
متغير رس = رسام_ثنائي_جديد(نف)

# --- حالة الحاسبة ---
متغير الرقم = 0
متغير قبل = 0
متغير عمل = 0
متغير نتج = 0
متغير جاهز = 1
متغير عرض = 0
متغير شغال = 1
متغير سبق = 0

# === الحلقة الرئيسية ===
بينما (شغال == 1)
    نافذة_استقبال_أحداث(نف)
    رسام_بدء_إطار(رس)
    رسام_مسح(رس, 40, 42, 52, 255)

    # ~~~ شريط العنوان ~~~
    رسام_مستطيل(رس, 0, 0, 400, 42, 25, 28, 38, 255, صحيح)
    رسام_نص(رس, "Calculator", 130, 10, 24, 80, 170, 255, 255)

    # ~~~ شاشة العرض ~~~
    رسام_مستطيل(رس, 15, 52, 370, 65, 15, 20, 32, 255, صحيح)
    رسام_مستطيل(رس, 15, 52, 370, 65, 55, 60, 80, 255, خطأ)

    اذا (عرض == 1)
        رسام_نص(رس, "= " + لنص(نتج), 25, 68, 30, 80, 255, 130, 255)
    والا
        رسام_نص(رس, لنص(الرقم), 25, 68, 30, 255, 255, 255, 255)
    نهاية

    # رمز العملية
    اذا (عمل == 1)
        رسام_نص(رس, "+", 358, 55, 14, 255, 180, 50, 255)
    والا_اذا (عمل == 2)
        رسام_نص(رس, "-", 358, 55, 14, 255, 180, 50, 255)
    والا_اذا (عمل == 3)
        رسام_نص(رس, "x", 358, 55, 14, 255, 180, 50, 255)
    والا_اذا (عمل == 4)
        رسام_نص(رس, "/", 358, 55, 14, 255, 180, 50, 255)
    نهاية

    # ~~~ صف 1: 7 8 9 / ~~~
    متغير ي1 = 135
    رسم_زر(رس, 15, ي1, 82, 58, "7", 65, 70, 82)
    رسم_زر(رس, 107, ي1, 82, 58, "8", 65, 70, 82)
    رسم_زر(رس, 199, ي1, 82, 58, "9", 65, 70, 82)
    رسم_زر(رس, 291, ي1, 94, 58, "/", 172, 115, 42)

    # ~~~ صف 2: 4 5 6 x ~~~
    متغير ي2 = 203
    رسم_زر(رس, 15, ي2, 82, 58, "4", 65, 70, 82)
    رسم_زر(رس, 107, ي2, 82, 58, "5", 65, 70, 82)
    رسم_زر(رس, 199, ي2, 82, 58, "6", 65, 70, 82)
    رسم_زر(رس, 291, ي2, 94, 58, "x", 172, 115, 42)

    # ~~~ صف 3: 1 2 3 - ~~~
    متغير ي3 = 271
    رسم_زر(رس, 15, ي3, 82, 58, "1", 65, 70, 82)
    رسم_زر(رس, 107, ي3, 82, 58, "2", 65, 70, 82)
    رسم_زر(رس, 199, ي3, 82, 58, "3", 65, 70, 82)
    رسم_زر(رس, 291, ي3, 94, 58, "-", 172, 115, 42)

    # ~~~ صف 4: C 0 = + ~~~
    متغير ي4 = 339
    رسم_زر(رس, 15, ي4, 82, 58, "C", 172, 52, 52)
    رسم_زر(رس, 107, ي4, 82, 58, "0", 65, 70, 82)
    رسم_زر(رس, 199, ي4, 82, 58, "=", 42, 140, 68)
    رسم_زر(رس, 291, ي4, 94, 58, "+", 172, 115, 42)

    # ~~~ زر الخروج ~~~
    رسم_زر(رس, 15, 410, 370, 45, "Exit", 110, 35, 35)

    # ~~~ معالجة النقر ~~~
    متغير مx = فأرة_x()
    متغير مy = فأرة_y()
    متغير مض = فأرة_زر_مضغوط(1)

    اذا (مض و (سبق == 0))

        # خروج
        اذا (داخل(مx, مy, 15, 410, 370, 45) == 1)
            شغال = 0
        نهاية

        # --- أرقام ---
        اذا (داخل(مx, مy, 15, ي1, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 7
                جاهز = 0
            والا
                الرقم = الرقم * 10 + 7
            نهاية
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 107, ي1, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 8
                جاهز = 0
            والا
                الرقم = الرقم * 10 + 8
            نهاية
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 199, ي1, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 9
                جاهز = 0
            والا
                الرقم = الرقم * 10 + 9
            نهاية
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 15, ي2, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 4
                جاهز = 0
            والا
                الرقم = الرقم * 10 + 4
            نهاية
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 107, ي2, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 5
                جاهز = 0
            والا
                الرقم = الرقم * 10 + 5
            نهاية
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 199, ي2, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 6
                جاهز = 0
            والا
                الرقم = الرقم * 10 + 6
            نهاية
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 15, ي3, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 1
                جاهز = 0
            والا
                الرقم = الرقم * 10 + 1
            نهاية
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 107, ي3, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 2
                جاهز = 0
            والا
                الرقم = الرقم * 10 + 2
            نهاية
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 199, ي3, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 3
                جاهز = 0
            والا
                الرقم = الرقم * 10 + 3
            نهاية
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 107, ي4, 82, 58) == 1)
            اذا (جاهز == 1)
                الرقم = 0
            والا
                الرقم = الرقم * 10
            نهاية
            عرض = 0
        نهاية

        # --- عمليات ---
        اذا (داخل(مx, مy, 291, ي4, 94, 58) == 1)
            قبل = الرقم
            عمل = 1
            جاهز = 1
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 291, ي3, 94, 58) == 1)
            قبل = الرقم
            عمل = 2
            جاهز = 1
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 291, ي2, 94, 58) == 1)
            قبل = الرقم
            عمل = 3
            جاهز = 1
            عرض = 0
        نهاية

        اذا (داخل(مx, مy, 291, ي1, 94, 58) == 1)
            قبل = الرقم
            عمل = 4
            جاهز = 1
            عرض = 0
        نهاية

        # --- يساوي = ---
        اذا (داخل(مx, مy, 199, ي4, 82, 58) == 1)
            اذا (عمل == 1)
                نتج = قبل + الرقم
            والا_اذا (عمل == 2)
                نتج = قبل - الرقم
            والا_اذا (عمل == 3)
                نتج = قبل * الرقم
            والا_اذا (عمل == 4)
                اذا (الرقم == 0)
                    نتج = 0
                والا
                    نتج = قبل / الرقم
                نهاية
            نهاية
            الرقم = نتج
            عرض = 1
            عمل = 0
            جاهز = 1
        نهاية

        # --- مسح C ---
        اذا (داخل(مx, مy, 15, ي4, 82, 58) == 1)
            الرقم = 0
            قبل = 0
            عمل = 0
            نتج = 0
            جاهز = 1
            عرض = 0
        نهاية
    نهاية

    اذا (مض)
        سبق = 1
    والا
        سبق = 0
    نهاية

    رسام_إنهاء_إطار(رس)
    نافذة_تبديل_buffers(نف)
    نم(16)
نهاية

نافذة_إغلاق(نف)
اطبع_سطر("Calculator closed.")
