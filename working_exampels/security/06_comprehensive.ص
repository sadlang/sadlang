# ---- أدوات المساعدة ----

دالة عنوان_قسم(نص عنوان)
    اطبع_سطر("")
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    اطبع_سطر("  " + عنوان)
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
نهاية

دالة نتيجة_فحص(نص وصف، رقم حالته)
    إذا (حالته == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

# ---- القسم 1: التحقق من كلمات المرور ----

دالة رقم فحص_طول_كلمة(نص كلمه، رقم حد_أدنى)
    رقم طول = طول_نص(كلمه)
    إذا (طول >= حد_أدنى)
        ارجع 1
    نهاية
    ارجع 0
نهاية

دالة اختبار_كلمات_مرور()
    عنوان_قسم("القسم 1: التحقق من كلمات المرور")

    رقم نجاحات = 0

    # كلمة قوية
    نص قوية = "كلمة_سر_قوية_جداً"
    رقم ن1 = فحص_طول_كلمة(قوية، 8)
    نتيجة_فحص("كلمة قوية (طول >= 8)"، ن1)
    نجاحات = نجاحات + ن1

    # كلمة قصيرة
    نص قصيرة = "قصير"
    رقم ن2 = فحص_طول_كلمة(قصيرة، 8)
    إذا (ن2 == 0)
        نتيجة_فحص("كلمة قصيرة رُفضت (صحيح)"، 1)
        نجاحات = نجاحات + 1
    وإلا
        نتيجة_فحص("كلمة قصيرة قُبلت (خطأ!)"، 0)
    نهاية

    # كلمة متوسطة
    نص متوسطة = "12345678"
    رقم ن3 = فحص_طول_كلمة(متوسطة، 8)
    نتيجة_فحص("كلمة 8 أحرف (الحد الأدنى)"، ن3)
    نجاحات = نجاحات + ن3

    اطبع_سطر("")
    اطبع_سطر("  نجاحات كلمات المرور: " + لنص(نجاحات) + "/3")
نهاية

# ---- القسم 2: التشفير وفك التشفير ----

دالة اختبار_تشفير()
    عنوان_قسم("القسم 2: التشفير وفك التشفير")

    رقم نجاحات = 0

    # تشفير نص بسيط
    نص أصل1 = "بيانات حساسة"
    نص مفتاح1 = "مفتاح_سري"

    نص مشفر1 = شفّر(أصل1، مفتاح1)
    اطبع_سطر("  النص الأصلي: " + أصل1)
    اطبع_سطر("  المشفر: " + مشفر1)

    نص مفكوك1 = فك_تشفير(مشفر1، مفتاح1)
    اطبع_سطر("  المفكوك: " + مفكوك1)

    تأكد_مساواة(مفكوك1، أصل1)
    نجاحات = نجاحات + 1
    نتيجة_فحص("تشفير + فك = النص الأصلي"، 1)

    # تشفير بمفتاح مختلف
    نص أصل2 = "رسالة سرية جداً"
    نص مفتاح2 = "مفتاح_آخر_طويل"

    نص مشفر2 = شفّر(أصل2، مفتاح2)
    نص مفكوك2 = فك_تشفير(مشفر2، مفتاح2)
    تأكد_مساواة(مفكوك2، أصل2)
    نجاحات = نجاحات + 1
    نتيجة_فحص("مفتاح مختلف يعمل أيضاً"، 1)

    # تشفير نص إنجليزي
    نص أصل3 = "Hello World 123"
    نص مفتاح3 = "key123"

    نص مشفر3 = شفّر(أصل3، مفتاح3)
    نص مفكوك3 = فك_تشفير(مشفر3، مفتاح3)
    تأكد_مساواة(مفكوك3، أصل3)
    نجاحات = نجاحات + 1
    نتيجة_فحص("نص إنجليزي يعمل"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجاحات التشفير: " + لنص(نجاحات) + "/3")
نهاية

# ---- القسم 3: التنظيف من الحقن ----

دالة اختبار_تنظيف()
    عنوان_قسم("القسم 3: حماية من الحقن")

    رقم نجاحات = 0

    # تنظيف HTML
    نص خطير1 = "<script>alert(1)</script>"
    نص نظيف1 = نظّف(خطير1)
    اطبع_سطر("  قبل: " + خطير1)
    اطبع_سطر("  بعد: " + نظيف1)

    # التأكد أن < و > تم تحويلها
    رقم طول_قبل = طول_نص(خطير1)
    رقم طول_بعد = طول_نص(نظيف1)
    تأكد_أكبر(طول_بعد، طول_قبل)
    نجاحات = نجاحات + 1
    نتيجة_فحص("HTML entities أطول من الأصل"، 1)

    # تنظيف علامات اقتباس
    نص خطير2 = "اسم المستخدم: \"admin\""
    نص نظيف2 = نظّف(خطير2)
    اطبع_سطر("  قبل: " + خطير2)
    اطبع_سطر("  بعد: " + نظيف2)
    نجاحات = نجاحات + 1
    نتيجة_فحص("علامات الاقتباس تم تنظيفها"، 1)

    # تنظيف نص عادي (يبقى كما هو)
    نص عادي = "نص عادي بدون رموز"
    نص نظيف3 = نظّف(عادي)
    تأكد_مساواة(نظيف3، عادي)
    نجاحات = نجاحات + 1
    نتيجة_فحص("نص عادي لا يتغير"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجاحات التنظيف: " + لنص(نجاحات) + "/3")
نهاية

# ---- القسم 4: الهاش ومقارنته ----

دالة اختبار_هاش()
    عنوان_قسم("القسم 4: هاش كلمات المرور")

    رقم نجاحات = 0

    # نفس النص = نفس الهاش
    نص كلمة1 = "كلمة_مرور_123"
    نص كلمة2 = "كلمة_مرور_123"
    نص كلمة3 = "كلمة_مرور_456"

    رقم ه1 = هاش(كلمة1)
    رقم ه2 = هاش(كلمة2)
    رقم ه3 = هاش(كلمة3)

    نص ه1ن = لنص(ه1)
    نص ه2ن = لنص(ه2)
    نص ه3ن = لنص(ه3)

    اطبع_سطر("  هاش كلمة1 = " + ه1ن)
    اطبع_سطر("  هاش كلمة2 = " + ه2ن)
    اطبع_سطر("  هاش كلمة3 = " + ه3ن)

    تأكد_مساواة(ه1، ه2)
    نجاحات = نجاحات + 1
    نتيجة_فحص("نفس الكلمة = نفس الهاش"، 1)

    # كلمات مختلفة = هاش مختلف
    إذا (ه1 != ه3)
        نجاحات = نجاحات + 1
        نتيجة_فحص("كلمات مختلفة = هاش مختلف"، 1)
    وإلا
        نتيجة_فحص("كلمات مختلفة = هاش مختلف"، 0)
    نهاية

    # هاش نص فارغ
    رقم ه_فارغ = هاش("")
    نص ه_فارغن = لنص(ه_فارغ)
    اطبع_سطر("  هاش فارغ = " + ه_فارغن)
    نجاحات = نجاحات + 1
    نتيجة_فحص("هاش نص فارغ يعمل"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجاحات الهاش: " + لنص(نجاحات) + "/3")
نهاية

# ---- القسم 5: Base64 والوقت ----

دالة اختبار_ترميز_ووقت()
    عنوان_قسم("القسم 5: ترميز Base64 والوقت")

    رقم نجاحات = 0

    # ترميز Base64
    نص بيانات1 = "Hello World"
    نص مرمز1 = ترميز_64(بيانات1)
    اطبع_سطر("  نص: " + بيانات1)
    اطبع_سطر("  Base64: " + مرمز1)
    نجاحات = نجاحات + 1
    نتيجة_فحص("ترميز Base64 يعمل"، 1)

    # ترميز نص عربي
    نص بيانات2 = "مرحبا بالعالم"
    نص مرمز2 = ترميز_64(بيانات2)
    اطبع_سطر("  نص: " + بيانات2)
    اطبع_سطر("  Base64: " + مرمز2)
    نجاحات = نجاحات + 1
    نتيجة_فحص("ترميز نص عربي يعمل"، 1)

    # رمز وصول
    نص رمز = "user:admin:2024"
    نص مرمز3 = ترميز_64(رمز)
    اطبع_سطر("  رمز: " + رمز)
    اطبع_سطر("  Base64: " + مرمز3)
    نجاحات = نجاحات + 1
    نتيجة_فحص("ترميز رمز وصول"، 1)

    اطبع_سطر("")

    # الوقت الحالي
    رقم الآن = وقت_الآن()
    نص الآنن = لنص(الآن)
    اطبع_سطر("  الطابع الزمني: " + الآنن)
    تأكد_أكبر(الآن، 0)
    نجاحات = نجاحات + 1
    نتيجة_فحص("طابع زمني موجب"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجاحات الترميز: " + لنص(نجاحات) + "/4")
نهاية

# ---- القسم 6: التأكيدات المتقدمة ----

دالة اختبار_تأكيدات()
    عنوان_قسم("القسم 6: التأكيدات المتقدمة")

    رقم نجاحات = 0

    # تأكد بسيط
    تأكد(1 == 1)
    نجاحات = نجاحات + 1
    نتيجة_فحص("1 == 1"، 1)

    # تأكد مساواة أرقام
    رقم حساب = 7 * 8
    تأكد_مساواة(حساب، 56)
    نجاحات = نجاحات + 1
    نتيجة_فحص("7 * 8 == 56"، 1)

    # تأكد أكبر
    تأكد_أكبر(1000، 100)
    نجاحات = نجاحات + 1
    نتيجة_فحص("1000 > 100"، 1)

    # تأكد مساواة نصوص
    نص كلا = "اختبار"
    نص كلب = "اختبار"
    تأكد_مساواة(كلا، كلب)
    نجاحات = نجاحات + 1
    نتيجة_فحص("نص كلا == نص كلب"، 1)

    # تأكد نوع
    تأكد_نوع(42، "رقم")
    نجاحات = نجاحات + 1
    نتيجة_فحص("42 من نوع رقم"، 1)

    تأكد_نوع("مرحبا"، "نص")
    نجاحات = نجاحات + 1
    نتيجة_فحص("مرحبا من نوع نص"، 1)

    # تأكيدات متعددة
    تأكد_أكبر(10، 5)
    تأكد_أكبر(20، 15)
    تأكد_أكبر(30، 25)
    تأكد_أكبر(40، 35)
    تأكد_أكبر(50، 45)
    نجاحات = نجاحات + 1
    نتيجة_فحص("سلسلة 5 تأكيدات أكبر"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجاحات التأكيدات: " + لنص(نجاحات) + "/7")
نهاية

