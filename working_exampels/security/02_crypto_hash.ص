# مثال 2: التشفير والهاش
# المستوى: متوسط

دالة رئيسية()
    اطبع_سطر("=== اختبار التشفير والهاش ===")
    
    # هاش — حساب هاش FNV-1a
    متغير نص1 = "مرحباً بالعالم"
    متغير هاش1 = هاش(نص1)
    اطبع_سطر("هاش النص الأول = " + هاش1)
    
    متغير نص2 = "كلمة المرور السرية"
    متغير هاش2 = هاش(نص2)
    اطبع_سطر("هاش النص الثاني = " + هاش2)
    
    # نفس النص يعطي نفس الهاش
    متغير هاش3 = هاش(نص1)
    تأكد(هاش1 == هاش3)
    اطبع_سطر("نفس النص = نفس الهاش")
    
    اطبع_سطر("")
    
    # شفّر / فك_تشفير — تشفير XOR (تعليمي)
    متغير رسالة = "سري جداً"
    متغير مفتاح = "مفتاح123"
    
    متغير مشفر = شفّر(رسالة، مفتاح)
    اطبع_سطر("النص الأصلي: " + رسالة)
    اطبع_سطر("المشفر: " + مشفر)
    
    متغير مفكوك = فك_تشفير(مشفر، مفتاح)
    اطبع_سطر("بعد فك التشفير: " + مفكوك)
    
    # التأكد أن فك التشفير يعيد النص الأصلي
    تأكد(مفكوك == رسالة)
    اطبع_سطر("التشفير وفك التشفير يعملان بنجاح!")
    
    اطبع_سطر("")
    
    # ترميز_64 — ترميز Base64
    متغير بيانات = "Hello World"
    متغير مرمز = ترميز_64(بيانات)
    اطبع_سطر("ترميز Base64 = " + مرمز)
    
    اطبع_سطر("")
    اطبع_سطر("جميع اختبارات التشفير نجحت!")
