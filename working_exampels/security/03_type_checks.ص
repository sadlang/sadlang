# ---- أدوات التحقق ----

دالة تقرير_فحص(نص وصف، رقم نتيجة)
    إذا (نتيجة == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

# ---- فحص 1: تأكد_مساواة مع أرقام ----

دالة فحص_مساواة_أرقام()
    اطبع_سطر("=== فحص تساوي الأرقام ===")
    اطبع_سطر("")

    رقم عداد = 0

    # حالة 1: أرقام متساوية
    تأكد_مساواة(10، 10)
    عداد = عداد + 1
    تقرير_فحص("10 == 10"، 1)

    # حالة 2: حساب ويتأكد
    رقم أ = 5 + 5
    رقم ب = 2 * 5
    تأكد_مساواة(أ، ب)
    عداد = عداد + 1
    تقرير_فحص("5+5 == 2*5"، 1)

    # حالة 3: عمليات معقدة
    رقم ج = 100 / 4
    رقم د = 25
    تأكد_مساواة(ج، د)
    عداد = عداد + 1
    تقرير_فحص("100/4 == 25"، 1)

    # حالة 4: صفر
    رقم صص = 0
    رقم زز = 10 - 10
    تأكد_مساواة(صص، زز)
    عداد = عداد + 1
    تقرير_فحص("0 == 10-10"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجحت: " + لنص(عداد) + " فحوصات")
    اطبع_سطر("")
نهاية

# ---- فحص 2: تأكد_مساواة مع نصوص ----

دالة فحص_مساواة_نصوص()
    اطبع_سطر("=== فحص تساوي النصوص ===")
    اطبع_سطر("")

    رقم عداد = 0

    # نصوص متطابقة
    تأكد_مساواة("مرحبا"، "مرحبا")
    عداد = عداد + 1
    تقرير_فحص("مرحبا == مرحبا"، 1)

    # نصوص من متغيرات
    نص اسم1 = "أحمد"
    نص اسم2 = "أحمد"
    تأكد_مساواة(اسم1، اسم2)
    عداد = عداد + 1
    تقرير_فحص("أحمد == أحمد (من متغيرات)"، 1)

    # نص فارغ
    نص فراغ1 = ""
    نص فراغ2 = ""
    تأكد_مساواة(فراغ1، فراغ2)
    عداد = عداد + 1
    تقرير_فحص("فراغ == فراغ"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجحت: " + لنص(عداد) + " فحوصات")
    اطبع_سطر("")
