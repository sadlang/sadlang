# ---- فحص 3: تأكد_أكبر ----

دالة فحص_أكبر()
    اطبع_سطر("=== فحص الأكبر ===")
    اطبع_سطر("")

    رقم عداد = 0

    # حالات بسيطة
    تأكد_أكبر(100، 50)
    عداد = عداد + 1
    تقرير_فحص("100 > 50"، 1)

    تأكد_أكبر(1000، 999)
    عداد = عداد + 1
    تقرير_فحص("1000 > 999"، 1)

    # حساب ثم مقارنة
    رقم ض = 50 * 3
    رقم ط = 100
    تأكد_أكبر(ض، ط)
    عداد = عداد + 1
    تقرير_فحص("50*3 > 100"، 1)

    # أرقام سالبة
    تأكد_أكبر(0، -1)
    عداد = عداد + 1
    تقرير_فحص("0 > -1"، 1)

    تأكد_أكبر(5، -100)
    عداد = عداد + 1
    تقرير_فحص("5 > -100"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجحت: " + لنص(عداد) + " فحوصات")
    اطبع_سطر("")
نهاية

# ---- فحص 4: تأكد_نوع ----

دالة فحص_أنواع()
    اطبع_سطر("=== فحص الأنواع ===")
    اطبع_سطر("")

    رقم عداد = 0

    # تحقق نوع رقم
    رقم ق1 = 42
    تأكد_نوع(ق1، "رقم")
    عداد = عداد + 1
    تقرير_فحص("42 هو رقم"، 1)

    # تحقق نوع نص
    نص ق2 = "مرحبا"
    تأكد_نوع(ق2، "نص")
    عداد = عداد + 1
    تقرير_فحص("مرحبا هو نص"، 1)

    # نوع ثابت
    تأكد_نوع(99، "رقم")
    عداد = عداد + 1
    تقرير_فحص("99 هو رقم"، 1)

    # نوع نص ثابت
    تأكد_نوع("اختبار"، "نص")
    عداد = عداد + 1
    تقرير_فحص("اختبار هو نص"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجحت: " + لنص(عداد) + " فحوصات")
    اطبع_سطر("")
نهاية

# ---- فحص 5: تأكد مع شروط ----

دالة فحص_تأكيدات()
    اطبع_سطر("=== فحص التأكيدات ===")
    اطبع_سطر("")

    رقم عداد = 0

    # تأكد بسيط
    تأكد(1 == 1)
    عداد = عداد + 1
    تقرير_فحص("1 == 1"، 1)

    تأكد(10 > 5)
    عداد = عداد + 1
    تقرير_فحص("10 > 5"، 1)

    تأكد(100 != 200)
    عداد = عداد + 1
    تقرير_فحص("100 != 200"، 1)

    # تأكد مع حسابات
    رقم نتيجة = 7 * 7
    تأكد(نتيجة == 49)
    عداد = عداد + 1
    تقرير_فحص("7*7 == 49"، 1)

    اطبع_سطر("")
    اطبع_سطر("  نجحت: " + لنص(عداد) + " فحوصات")
    اطبع_سطر("")
نهاية

