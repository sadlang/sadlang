# مثال 1: تأكيد أساسي (assert)
# المستوى: مبتدئ

دالة رئيسية()
    اطبع_سطر("=== اختبار التأكيدات الأساسية ===")
    
    # تأكد — يرمي خطأ إذا كان الشرط خاطئاً
    متغير س = 10
    تأكد(س == 10)
    اطبع_سطر("تأكد أن س تساوي 10 — نجح")
    
    متغير اسم = "أحمد"
    تأكد(اسم == "أحمد")
    اطبع_سطر("تأكد أن الاسم صحيح — نجح")
    
    # تحقق — يرجع صحيح أو خطأ بدون رمي خطأ
    متغير نتيجة1 = تحقق(5 > 3)
    اطبع_سطر("تحقق(5 > 3) = " + نتيجة1)
    
    متغير نتيجة2 = تحقق(1 > 100)
    اطبع_سطر("تحقق(1 > 100) = " + نتيجة2)
    
    # آمن — يتحقق إذا كانت القيمة غير فارغة
    متغير قيمة = "مرحباً"
    متغير آمنة = آمن(قيمة)
    اطبع_سطر("آمن مرحباً = " + آمنة)
    
    اطبع_سطر("")
    اطبع_سطر("جميع الاختبارات الأساسية نجحت!")
نهاية
