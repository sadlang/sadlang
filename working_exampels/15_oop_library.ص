# ==============================================
# مثال 1: نظام إدارة المكتبة - البرمجة الكائنية مع نظام الملكية
# Example 1: Library Management System - OOP with Ownership System
# ==============================================
# يوضح هذا المثال:
# - تعريف الأصناف مع الحقول والطرق
# - الوراثة
# - المنشئات (الباني)
# - الأعضاء الساكنة
# - نظام الملكية: النقل والاستعارة والنسخ
# ==============================================
# شغّل بـ: sad.exe --ownership 15_oop_library.sad
# ==============================================

# ===== صنف الكتاب الأساسي =====
صنف كتاب
    نص العنوان
    نص المؤلف
    رقم السنة
    رقم متاح

    باني(نص عنوان، نص مؤلف، رقم سنة)
        العنوان = عنوان
        المؤلف = مؤلف
        السنة = سنة
        متاح = 1
    نهاية

    دالة اعرض()
        اطبع("  كتاب: ")
        اطبع(العنوان)
        اطبع(" - ")
        اطبع(المؤلف)
        اطبع(" (")
        اطبع(السنة)
        اطبع_سطر(")")
    نهاية

    دالة رقم هل_متاح()
        ارجع متاح
    نهاية

    دالة استعر_الكتاب()
        متاح = 0
        اطبع("  تمت استعارة: ")
        اطبع_سطر(العنوان)
    نهاية

    دالة ارجع_الكتاب()
        متاح = 1
        اطبع("  تم ارجاع: ")
        اطبع_سطر(العنوان)
    نهاية
نهاية

# ===== صنف الكتاب الرقمي يرث من كتاب =====
صنف كتاب_رقمي يرث كتاب
    نص الصيغة
    رقم الميجابايت

    باني(نص عنوان، نص مؤلف، رقم سنة، نص صيغة، رقم ميجا)
        أساس(عنوان، مؤلف، سنة)
        الصيغة = صيغة
        الميجابايت = ميجا
    نهاية

    دالة اعرض()
        اطبع("  رقمي: ")
        اطبع(العنوان)
        اطبع(" - ")
        اطبع(المؤلف)
        اطبع(" [")
        اطبع(الصيغة)
        اطبع(", ")
        اطبع(الميجابايت)
        اطبع_سطر(" MB]")
    نهاية
نهاية

# ===== صنف العضو =====
صنف عضو_مكتبة
    نص الاسم
    رقم المعرف
    ساكن رقم عدد_الاعضاء

    باني(نص اسم، رقم معرف)
        الاسم = اسم
        المعرف = معرف
        عدد_الاعضاء = عدد_الاعضاء + 1
    نهاية

    دالة اعرض()
        اطبع("  عضو: ")
        اطبع(الاسم)
        اطبع(" (معرف: ")
        اطبع(المعرف)
        اطبع_سطر(")")
    نهاية

    ساكن دالة رقم كم_عضو()
        ارجع عدد_الاعضاء
    نهاية
نهاية

# ===== الدالة الرئيسية =====
دالة رئيسية()
    اطبع_سطر("========================================")
    اطبع_سطر("      نظام ادارة المكتبة")
    اطبع_سطر("========================================")
    اطبع_سطر("")

    # ---- إنشاء الكتب ----
    اطبع_سطر("[1] انشاء الكتب:")
    متغير ك1 = جديد كتاب("البؤساء"، "فيكتور هوغو"، 1862)
    متغير ك2 = جديد كتاب("مئة عام من العزلة"، "ماركيز"، 1967)
    متغير ك3 = جديد كتاب_رقمي("تعلم البرمجة"، "احمد"، 2024، "PDF"، 15)

    ك1.اعرض()
    ك2.اعرض()
    ك3.اعرض()
    اطبع_سطر("")

    # ---- إنشاء الأعضاء ----
    اطبع_سطر("[2] تسجيل الاعضاء:")
    متغير ع1 = جديد عضو_مكتبة("فاطمة"، 101)
    متغير ع2 = جديد عضو_مكتبة("محمد"، 102)
    متغير ع3 = جديد عضو_مكتبة("سارة"، 103)

    ع1.اعرض()
    ع2.اعرض()
    ع3.اعرض()

    اطبع("  اجمالي الاعضاء: ")
    اطبع_سطر(عضو_مكتبة.كم_عضو())
    اطبع_سطر("")

    # ---- نظام الملكية: النسخ ----
    اطبع_سطر("[3] نظام الملكية - النسخ:")
    رقم رصيد = 5
    رقم رصيد_نسخة = رصيد
    رصيد_نسخة = رصيد_نسخة - 1
    اطبع("  الرصيد الاصلي: ")
    اطبع_سطر(رصيد)
    اطبع("  النسخة (مستقلة): ")
    اطبع_سطر(رصيد_نسخة)
    اطبع_سطر("")

    # ---- عمليات الاستعارة ----
    اطبع_سطر("[4] عمليات الاستعارة:")
    ك1.استعر_الكتاب()

    اطبع("  البؤساء متاح؟ ")
    إذا (ك1.هل_متاح() == 1)
        اطبع_سطر("نعم")
    وإلا
        اطبع_سطر("لا (مستعار)")
    نهاية

    اطبع("  مئة عام متاح؟ ")
    إذا (ك2.هل_متاح() == 1)
        اطبع_سطر("نعم")
    وإلا
        اطبع_سطر("لا (مستعار)")
    نهاية

    ك1.ارجع_الكتاب()
    اطبع("  البؤساء متاح الان؟ ")
    إذا (ك1.هل_متاح() == 1)
        اطبع_سطر("نعم")
    وإلا
        اطبع_سطر("لا")
    نهاية
    اطبع_سطر("")

    # ---- نظام الملكية: نقل النصوص ----
    اطبع_سطر("[5] نظام الملكية - نقل النصوص:")
    نص وصف = "كتاب نادر من القرن 19"
    اطبع("  الوصف: ")
    اطبع_سطر(وصف)

    متغير وصف_محفوظ = وصف
    اطبع("  بعد النقل: ")
    اطبع_سطر(وصف_محفوظ)
    # بعد النقل، 'وصف' لم يعد صالحاً
    # اطبع_سطر(وصف)  # خطأ: استخدام بعد النقل!
    اطبع_سطر("")

    # ---- الاستعارة (المراجع) ----
    اطبع_سطر("[6] نظام الملكية - الاستعارة:")
    نص عنوان_مفضل = "البؤساء"
    متغير مرجع1 = &عنوان_مفضل
    متغير مرجع2 = &عنوان_مفضل
    اطبع("  المرجع 1: ")
    اطبع_سطر(مرجع1)
    اطبع("  المرجع 2: ")
    اطبع_سطر(مرجع2)
    اطبع("  الاصل (صالح): ")
    اطبع_سطر(عنوان_مفضل)
    اطبع_سطر("")

    اطبع_سطر("========================================")
    اطبع_سطر("      انتهى البرنامج بنجاح")
    اطبع_سطر("========================================")
نهاية
