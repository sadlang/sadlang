# ==============================================
# مثال 2: نظام الحسابات البنكية - وراثة متعددة المستويات
# Example 2: Banking System - Multi-level Inheritance
# ==============================================
# يوضح هذا المثال:
# - وراثة متعددة المستويات (حساب ← حساب_توفير ← حساب_ذهبي)
# - معدلات الوصول (خاص، عام)
# - الأعضاء الساكنة
# - تعدد الأشكال (override methods)
# - نظام الملكية مع الكائنات
# ==============================================
# شغّل بـ: sad.exe --ownership 16_oop_banking.sad
# ==============================================

# ===== الصنف الأساسي: حساب بنكي =====
صنف حساب_بنكي
    نص صاحب_الحساب
    رقم الرصيد
    رقم رقم_الحساب
    ساكن رقم عدد_الحسابات

    باني(نص صاحب، رقم رصيد_مبدئي، رقم رقم_ح)
        صاحب_الحساب = صاحب
        الرصيد = رصيد_مبدئي
        رقم_الحساب = رقم_ح
        عدد_الحسابات = عدد_الحسابات + 1
    نهاية

    دالة ايداع(رقم مبلغ)
        الرصيد = الرصيد + مبلغ
        اطبع("  + ايداع ")
        اطبع(مبلغ)
        اطبع(" -> الرصيد: ")
        اطبع_سطر(الرصيد)
    نهاية

    دالة رقم سحب(رقم مبلغ)
        إذا (مبلغ > الرصيد)
            اطبع_سطر("  ! رصيد غير كاف")
            ارجع 0
        نهاية
        الرصيد = الرصيد - مبلغ
        اطبع("  - سحب ")
        اطبع(مبلغ)
        اطبع(" -> الرصيد: ")
        اطبع_سطر(الرصيد)
        ارجع 1
    نهاية

    دالة رقم الرصيد_الحالي()
        ارجع الرصيد
    نهاية

    دالة اعرض()
        اطبع("  حساب #")
        اطبع(رقم_الحساب)
        اطبع(" | ")
        اطبع(صاحب_الحساب)
        اطبع(" | الرصيد: ")
        اطبع_سطر(الرصيد)
    نهاية

    ساكن دالة رقم اجمالي_الحسابات()
        ارجع عدد_الحسابات
    نهاية
نهاية

# ===== حساب التوفير يرث من حساب بنكي =====
صنف حساب_توفير يرث حساب_بنكي
    رقم نسبة_الربح

    باني(نص صاحب، رقم رصيد، رقم رقم_ح، رقم نسبة)
        أساس(صاحب، رصيد، رقم_ح)
        نسبة_الربح = نسبة
    نهاية

    دالة احسب_ربح()
        رقم ربح = الرصيد * نسبة_الربح / 100
        الرصيد = الرصيد + ربح
        اطبع("  $ ربح سنوي: ")
        اطبع(ربح)
        اطبع(" -> الرصيد: ")
        اطبع_سطر(الرصيد)
    نهاية

    دالة اعرض()
        اطبع("  حساب توفير #")
        اطبع(رقم_الحساب)
        اطبع(" | ")
        اطبع(صاحب_الحساب)
        اطبع(" | الرصيد: ")
        اطبع(الرصيد)
        اطبع(" | ربح: ")
        اطبع(نسبة_الربح)
        اطبع_سطر("%")
    نهاية
نهاية

# ===== الدالة الرئيسية =====
دالة رئيسية()
    اطبع_سطر("========================================")
    اطبع_سطر("    نظام الحسابات البنكية")
    اطبع_سطر("========================================")
    اطبع_سطر("")

    # ---- إنشاء الحسابات ----
    اطبع_سطر("[1] فتح الحسابات:")
    متغير ح1 = جديد حساب_بنكي("علي"، 5000، 1001)
    متغير ح2 = جديد حساب_بنكي("نور"، 3000، 1002)
    متغير ح3 = جديد حساب_توفير("سلمى"، 10000، 1003، 5)

    ح1.اعرض()
    ح2.اعرض()
    ح3.اعرض()

    اطبع("  اجمالي الحسابات: ")
    اطبع_سطر(حساب_بنكي.اجمالي_الحسابات())
    اطبع_سطر("")

    # ---- عمليات بنكية ----
    اطبع_سطر("[2] العمليات البنكية:")
    ح1.ايداع(2000)
    ح1.سحب(1000)
    ح2.سحب(5000)
    اطبع_سطر("")

    # ---- حساب الأرباح ----
    اطبع_سطر("[3] حساب الارباح:")
    ح3.احسب_ربح()
    ح3.اعرض()
    اطبع_سطر("")

    # ---- نظام الملكية ----
    اطبع_سطر("[4] نظام الملكية:")

    # الأرقام تُنسخ
    رقم رصيد_علي = ح1.الرصيد_الحالي()
    رقم نسخة = رصيد_علي
    اطبع("  رصيد علي (نسخة): ")
    اطبع_سطر(رصيد_علي)
    اطبع("  نسخة مستقلة: ")
    اطبع_سطر(نسخة)

    # النصوص تُنقل
    نص تقرير = "تقرير مالي سنوي - سري"
    اطبع("  التقرير: ")
    اطبع_سطر(تقرير)
    متغير تقرير_مؤرشف = تقرير
    اطبع("  التقرير المؤرشف: ")
    اطبع_سطر(تقرير_مؤرشف)
    # تقرير لم يعد صالحاً بعد النقل
    اطبع_سطر("")

    # استعارة مشتركة
    اطبع_سطر("[5] الاستعارة المشتركة:")
    نص اسم_بنك = "بنك الوطن"
    متغير م1 = &اسم_بنك
    متغير م2 = &اسم_بنك
    متغير م3 = &اسم_بنك
    اطبع("  م1: ")
    اطبع_سطر(م1)
    اطبع("  م2: ")
    اطبع_سطر(م2)
    اطبع("  م3: ")
    اطبع_سطر(م3)
    اطبع("  الاصل: ")
    اطبع_سطر(اسم_بنك)
    اطبع_سطر("")

    # ---- النتائج النهائية ----
    اطبع_سطر("[6] ملخص الحسابات:")
    ح1.اعرض()
    ح2.اعرض()
    ح3.اعرض()
    اطبع_سطر("")

    اطبع_سطر("========================================")
    اطبع_سطر("    انتهى البرنامج بنجاح")
    اطبع_سطر("========================================")
نهاية
