# ===== دوال رياضية محلية =====
دالة رقم القوة(رقم اساس، رقم اس_قيمة)
    رقم ناتج = 1
    رقم عداد = 0
    بينما (عداد < اس_قيمة)
        ناتج = ناتج * اساس
        عداد = عداد + 1
    نهاية
    ارجع ناتج
نهاية

دالة رقم القيمة_المطلقة(رقم قيمة)
    إذا (قيمة < 0)
        ارجع 0 - قيمة
    نهاية
    ارجع قيمة
نهاية

دالة رقم المضاعف(رقم قيمة)
    ارجع قيمة * 2
نهاية

دالة رقم العاملي(رقم ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    رقم ناتج = 1
    رقم عداد = 2
    بينما (عداد <= ن)
        ناتج = ناتج * عداد
        عداد = عداد + 1
    نهاية
    ارجع ناتج
نهاية

دالة رقم فيبوناتشي(رقم ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    رقم أ = 0
    رقم ب = 1
    رقم عداد = 2
    بينما (عداد <= ن)
        رقم جمع = أ + ب
        أ = ب
        ب = جمع
        عداد = عداد + 1
    نهاية
    ارجع ب
نهاية

دالة رقم هل_اولي(رقم ن)
    إذا (ن <= 1)
        ارجع 0
    نهاية
    إذا (ن == 2)
        ارجع 1
    نهاية
    إذا (ن % 2 == 0)
        ارجع 0
    نهاية
    رقم قاسم = 3
    بينما (قاسم * قاسم <= ن)
        إذا (ن % قاسم == 0)
            ارجع 0
        نهاية
        قاسم = قاسم + 2
    نهاية
    ارجع 1
نهاية

# ===== الدالة الرئيسية =====
دالة رئيسية()
    اطبع_سطر("========================================")
    اطبع_سطر("    نظام الاستيراد - مثال عملي")
    اطبع_سطر("========================================")
    اطبع_سطر("")

    # بناء الجملة المدعوم للاستيراد:
    # استورد رياضيات
    # استورد رياضيات كـ ر
    # من رياضيات استورد جذر، قوة
    # من رياضيات استورد *

    # ---- القوة والعاملي ----
    اطبع_سطر("[1] دوال القوة والعاملي:")
    رقم عداد = 1
    بينما (عداد <= 8)
        اطبع("    2^")
        اطبع(عداد)
        اطبع(" = ")
        اطبع_سطر(القوة(2، عداد))
        عداد = عداد + 1
    نهاية
    اطبع_سطر("")

    اطبع_سطر("    العاملي (!):")
    رقم ع2 = 1
    بينما (ع2 <= 7)
        اطبع("    ")
        اطبع(ع2)
        اطبع("! = ")
        اطبع_سطر(العاملي(ع2))
        ع2 = ع2 + 1
    نهاية
    اطبع_سطر("")

    # ---- فيبوناتشي ----
    اطبع_سطر("[2] متتالية فيبوناتشي:")
    اطبع("    ")
    رقم ع3 = 0
    بينما (ع3 <= 12)
        اطبع(فيبوناتشي(ع3))
        اطبع(" ")
        ع3 = ع3 + 1
    نهاية
    اطبع_سطر("")
    اطبع_سطر("")

    # ---- الأعداد الأولية ----
    اطبع_سطر("[3] الاعداد الاولية:")
    اطبع("    ")
    رقم ع4 = 2
    رقم وجد = 0
    بينما (ع4 <= 50)
        إذا (هل_اولي(ع4) == 1)
            اطبع(ع4)
            اطبع(" ")
            وجد = وجد + 1
        نهاية
        ع4 = ع4 + 1
    نهاية
    اطبع_سطر("")
    اطبع("    عدد الاعداد الاولية حتى 50: ")
    اطبع_سطر(وجد)
    اطبع_سطر("")

    # ---- القيمة المطلقة ----
    اطبع_سطر("[4] القيمة المطلقة:")
    اطبع("    |5| = ")
    اطبع_سطر(القيمة_المطلقة(5))
    اطبع("    |-7| = ")
    اطبع_سطر(القيمة_المطلقة(0 - 7))
    اطبع("    |0| = ")
    اطبع_سطر(القيمة_المطلقة(0))
    اطبع_سطر("")

    # ---- نظام الملكية مع نتائج الدوال ----
    اطبع_سطر("[5] نظام الملكية مع الدوال:")

    # نسخ نتائج الدوال (أرقام)
    رقم ناتج1 = القوة(3، 4)
    رقم ناتج2 = ناتج1
    اطبع("    3^4 = ")
    اطبع(ناتج1)
    اطبع(" (نسخة: ")
    اطبع(ناتج2)
    اطبع_سطر(")")

    # نقل النصوص
    نص تقرير = "تقرير الحسابات الرياضية"
    متغير أرشيف = تقرير
    اطبع("    تقرير منقول: ")
    اطبع_سطر(أرشيف)

    # استعارة
    نص عنوان = "مكتبة الرياضيات"
    متغير مرجع = &عنوان
    اطبع("    مرجع: ")
    اطبع_سطر(مرجع)
    اطبع("    اصل: ")
    اطبع_سطر(عنوان)
    اطبع_سطر("")

    # ---- جدول الضرب ----
    اطبع_سطر("[6] جدول الضرب (1-5):")
    رقم سطر = 1
    بينما (سطر <= 5)
        رقم عمود = 1
        اطبع("    ")
        بينما (عمود <= 5)
            رقم حاصل = سطر * عمود
            إذا (حاصل < 10)
                اطبع(" ")
            نهاية
            اطبع(حاصل)
            اطبع(" ")
            عمود = عمود + 1
        نهاية
        اطبع_سطر("")
        سطر = سطر + 1
    نهاية
    اطبع_سطر("")

    اطبع_سطر("========================================")
    اطبع_سطر("    انتهى البرنامج بنجاح")
    اطبع_سطر("========================================")
نهاية
