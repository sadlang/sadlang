# الجزء 1: العمليات الحسابية الأساسية

دالة رقم جمع(رقم ج_أ، رقم ج_ب)
    ارجع ج_أ + ج_ب
نهاية

دالة رقم طرح(رقم ط_أ، رقم ط_ب)
    ارجع ط_أ - ط_ب
نهاية

دالة رقم ضرب(رقم ض_أ، رقم ض_ب)
    ارجع ض_أ * ض_ب
نهاية

دالة عشري قسمة_عشرية(عشري قع_أ، عشري قع_ب)
    إذا (قع_ب == 0.0)
        اطبع_سطر("خطأ: القسمة على صفر!")
        ارجع 0.0
    نهاية
    ارجع قع_أ / قع_ب
نهاية

دالة رقم باقي_قسمة(رقم بق_أ، رقم بق_ب)
    إذا (بق_ب == 0)
        اطبع_سطر("خطأ: القسمة على صفر!")
        ارجع 0
    نهاية
    رقم بق_ناتج = بق_أ / بق_ب
    رقم بق_حاصل = بق_ناتج * بق_ب
    ارجع بق_أ - بق_حاصل
نهاية

# الجزء 2: العمليات الحسابية المتقدمة

دالة رقم قوة(رقم قو_قاعدة، رقم قو_أس)
    رقم قو_نتيجة = 1
    رقم قو_عداد = 0
    بينما (قو_عداد < قو_أس)
        قو_نتيجة = قو_نتيجة * قو_قاعدة
        قو_عداد = قو_عداد + 1
    نهاية
    ارجع قو_نتيجة
نهاية

دالة رقم مضروب(رقم مض_ن)
    إذا (مض_ن <= 1)
        ارجع 1
    نهاية
    رقم مض_نتيجة = 1
    رقم مض_عداد = 2
    بينما (مض_عداد <= مض_ن)
        مض_نتيجة = مض_نتيجة * مض_عداد
        مض_عداد = مض_عداد + 1
    نهاية
    ارجع مض_نتيجة
نهاية

دالة رقم فيبوناتشي(رقم فب_ن)
    إذا (فب_ن <= 0)
        ارجع 0
    نهاية
    إذا (فب_ن == 1)
        ارجع 1
    نهاية
    رقم فب_سابق1 = 0
    رقم فب_سابق2 = 1
    رقم فب_حالي = 0
    رقم فب_عداد = 2
    بينما (فب_عداد <= فب_ن)
        فب_حالي = فب_سابق1 + فب_سابق2
        فب_سابق1 = فب_سابق2
        فب_سابق2 = فب_حالي
        فب_عداد = فب_عداد + 1
    نهاية
    ارجع فب_حالي
نهاية

دالة رقم الاكبر(رقم كب_أ، رقم كب_ب)
    إذا (كب_أ > كب_ب)
        ارجع كب_أ
    نهاية
    ارجع كب_ب
نهاية

دالة رقم الاصغر(رقم صغ_أ، رقم صغ_ب)
    إذا (صغ_أ < صغ_ب)
        ارجع صغ_أ
    نهاية
    ارجع صغ_ب
نهاية

