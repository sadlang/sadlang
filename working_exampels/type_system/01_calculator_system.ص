# الجزء 4: خوارزميات رياضية

دالة رقم القاسم_المشترك_الأكبر(رقم قك_أ، رقم قك_ب)
    إذا (قك_أ < 0)
        قك_أ = 0 - قك_أ
    نهاية
    إذا (قك_ب < 0)
        قك_ب = 0 - قك_ب
    نهاية
    إذا (قك_ب == 0)
        ارجع قك_أ
    نهاية
    بينما (قك_ب != 0)
        رقم قك_باقي = قك_أ - ((قك_أ / قك_ب) * قك_ب)
        قك_أ = قك_ب
        قك_ب = قك_باقي
    نهاية
    ارجع قك_أ
نهاية

دالة رقم المضاعف_المشترك_الأصغر(رقم مص_أ، رقم مص_ب)
    إذا (مص_أ == 0)
        ارجع 0
    نهاية
    إذا (مص_ب == 0)
        ارجع 0
    نهاية
    رقم مص_تأ = مص_أ
    رقم مص_تب = مص_ب
    إذا (مص_تأ < 0)
        مص_تأ = 0 - مص_تأ
    نهاية
    إذا (مص_تب < 0)
        مص_تب = 0 - مص_تب
    نهاية
    بينما (مص_تب != 0)
        رقم مص_باقي = مص_تأ - ((مص_تأ / مص_تب) * مص_تب)
        مص_تأ = مص_تب
        مص_تب = مص_باقي
    نهاية
    إذا (مص_تأ == 0)
        ارجع 0
    نهاية
    رقم مص_ضرب = مص_أ * مص_ب
    إذا (مص_ضرب < 0)
        مص_ضرب = 0 - مص_ضرب
    نهاية
    ارجع مص_ضرب / مص_تأ
نهاية

دالة منطقي هل_أولي(رقم أل_ن)
    إذا (أل_ن <= 1)
        ارجع خطأ
    نهاية
    إذا (أل_ن <= 3)
        ارجع صح
    نهاية
    رقم أل_قاسم = 2
    بينما (أل_قاسم * أل_قاسم <= أل_ن)
        رقم أل_باقي = أل_ن - ((أل_ن / أل_قاسم) * أل_قاسم)
        إذا (أل_باقي == 0)
            ارجع خطأ
        نهاية
        أل_قاسم = أل_قاسم + 1
    نهاية
    ارجع صح
نهاية

دالة رقم عد_الأعداد_الأولية(رقم عأ_حد)
    رقم عأ_عدد = 0
    رقم عأ_رقم = 2
    بينما (عأ_رقم <= عأ_حد)
        منطقي عأ_أولي = صح
        إذا (عأ_رقم <= 1)
            عأ_أولي = خطأ
        نهاية
        إذا (عأ_أولي == صح)
            رقم عأ_قاسم = 2
            بينما (عأ_قاسم * عأ_قاسم <= عأ_رقم)
                رقم عأ_باقي = عأ_رقم - ((عأ_رقم / عأ_قاسم) * عأ_قاسم)
                إذا (عأ_باقي == 0)
                    عأ_أولي = خطأ
                نهاية
                عأ_قاسم = عأ_قاسم + 1
            نهاية
        نهاية
        إذا (عأ_أولي == صح)
            عأ_عدد = عأ_عدد + 1
        نهاية
        عأ_رقم = عأ_رقم + 1
    نهاية
    ارجع عأ_عدد
نهاية

دالة رقم مجموع_القواسم(رقم مق_ن)
    رقم مق_مجموع = 0
    رقم مق_قاسم = 1
    بينما (مق_قاسم < مق_ن)
        رقم مق_باقي = مق_ن - ((مق_ن / مق_قاسم) * مق_قاسم)
        إذا (مق_باقي == 0)
            مق_مجموع = مق_مجموع + مق_قاسم
        نهاية
        مق_قاسم = مق_قاسم + 1
    نهاية
    ارجع مق_مجموع
نهاية

دالة منطقي هل_كامل(رقم كم_ن)
    إذا (كم_ن <= 1)
        ارجع خطأ
    نهاية
    رقم كم_مجموع = 0
    رقم كم_قاسم = 1
    بينما (كم_قاسم < كم_ن)
        رقم كم_باقي = كم_ن - ((كم_ن / كم_قاسم) * كم_قاسم)
        إذا (كم_باقي == 0)
            كم_مجموع = كم_مجموع + كم_قاسم
        نهاية
        كم_قاسم = كم_قاسم + 1
    نهاية
    ارجع كم_مجموع == كم_ن
نهاية

