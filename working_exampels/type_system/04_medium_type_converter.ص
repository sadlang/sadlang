متغير عداد_تحويل = 0

# === دوال تحويل ===
دالة تحويل_رقم_لنص(ق: رقم)
    متغير نتيجة_ن = لنص(ق)
    اطبع("    رقم ")
    اطبع(ق)
    اطبع(" → نص '")
    اطبع(نتيجة_ن)
    اطبع_سطر("'")
    عداد_تحويل = عداد_تحويل + 1
نهاية

# === فحص النطاقات ===
دالة فحص_نطاق(قيمة_ف: رقم، حد_أدنى: رقم، حد_أعلى: رقم)
    اطبع("    فحص ")
    اطبع(قيمة_ف)
    اطبع(" في [")
    اطبع(حد_أدنى)
    اطبع(" - ")
    اطبع(حد_أعلى)
    اطبع("]: ")
    اذا (قيمة_ف >= حد_أدنى)
        اذا (قيمة_ف <= حد_أعلى)
            اطبع_سطر("✓ داخل النطاق")
        نهاية
    نهاية
    اذا (قيمة_ف < حد_أدنى)
        اطبع_سطر("✗ أقل من الحد")
    نهاية
    اذا (قيمة_ف > حد_أعلى)
        اطبع_سطر("✗ أعلى من الحد")
    نهاية
نهاية

# === عمليات النصوص مع الأنواع ===
دالة اختبار_نصوص_منمطة()
    اطبع_سطر("--- النصوص المنمطة ---")

    متغير ن1 = "أحمد"
    متغير ن2 = "سارة"
    متغير ن3 = "محمد"

    # مقارنة أنواع النصوص
    متغير مق1 = ن1 == ن2
    اطبع("    '")
    اطبع(ن1)
    اطبع("' == '")
    اطبع(ن2)
    اطبع("': ")
    اطبع_سطر(مق1)

    متغير مق2 = ن1 == "أحمد"
    اطبع("    '")
    اطبع(ن1)
    اطبع("' == 'أحمد': ")
    اطبع_سطر(مق2)

    # دمج مع أرقام محولة
    متغير عمر1 = 25
    متغير عمر1_نص = لنص(عمر1)
    متغير سجل_1 = ن1 + " - " + عمر1_نص
    اطبع("    سجل: ")
    اطبع_سطر(سجل_1)

    متغير عمر2 = 30
    متغير عمر2_نص = لنص(عمر2)
    متغير سجل_2 = ن2 + " - " + عمر2_نص
    اطبع("    سجل: ")
    اطبع_سطر(سجل_2)
نهاية

# === عمليات حسابية متنوعة ===
دالة اختبار_حسابات_متنوعة()
    اطبع_سطر("")
    اطبع_سطر("--- حسابات متنوعة ---")

    # أعداد صحيحة
    متغير أ = 100
    متغير ب = 37
    متغير مج = أ + ب
    متغير فرق = أ - ب
    متغير حاصل = أ * ب
    متغير قسمة = أ / ب

    اطبع("    100 + 37 = ")
    اطبع_سطر(مج)
    اطبع("    100 - 37 = ")
    اطبع_سطر(فرق)
    اطبع("    100 × 37 = ")
    اطبع_سطر(حاصل)
    اطبع("    100 ÷ 37 = ")
    اطبع_سطر(قسمة)

    # أعداد عشرية
    اطبع_سطر("")
    اطبع_سطر("  عشرية:")
    متغير ع_أ = 10.5
    متغير ع_ب = 3.2
    متغير ع_مج = ع_أ + ع_ب
    متغير ع_فرق = ع_أ - ع_ب
    متغير ع_حاصل = ع_أ * ع_ب

    اطبع("    10.5 + 3.2 = ")
    اطبع_سطر(ع_مج)
    اطبع("    10.5 - 3.2 = ")
    اطبع_سطر(ع_فرق)
    اطبع("    10.5 × 3.2 = ")
    اطبع_سطر(ع_حاصل)
نهاية

# === فحص المنطقيات ===
دالة اختبار_منطقيات()
    اطبع_سطر("")
    اطبع_سطر("--- عمليات منطقية ---")

    متغير م1 = 5 > 3
    متغير م2 = 10 < 20
    متغير م3 = 7 == 7
    متغير م4 = 8 != 9
    متغير م5 = 15 >= 15
    متغير م6 = 3 <= 4

    اطبع("    5 > 3: ")
    اطبع_سطر(م1)
    اطبع("    10 < 20: ")
    اطبع_سطر(م2)
    اطبع("    7 == 7: ")
    اطبع_سطر(م3)
    اطبع("    8 != 9: ")
    اطبع_سطر(م4)
    اطبع("    15 >= 15: ")
    اطبع_سطر(م5)
    اطبع("    3 <= 4: ")
    اطبع_سطر(م6)
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════╗")
    اطبع_سطر("║     محول الأنواع ومعالجها             ║")
    اطبع_سطر("╚══════════════════════════════════════════╝")
    اطبع_سطر("")

    اطبع_سطر("--- تحويل الأرقام ---")
    تحويل_رقم_لنص(0)
    تحويل_رقم_لنص(42)
    تحويل_رقم_لنص(-15)
    تحويل_رقم_لنص(1000)
    اطبع("    عدد التحويلات: ")
    اطبع_سطر(عداد_تحويل)

    اطبع_سطر("")
    اطبع_سطر("--- فحص النطاقات ---")
    فحص_نطاق(5، 1، 10)
    فحص_نطاق(15، 1، 10)
    فحص_نطاق(-5، 0، 100)
    فحص_نطاق(50، 0، 100)
    فحص_نطاق(150، 0، 100)

    اطبع_سطر("")
    اختبار_نصوص_منمطة()
    اختبار_حسابات_متنوعة()
    اختبار_منطقيات()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى محول الأنواع ===")
نهاية
