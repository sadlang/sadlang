# === متغيرات عامة ===
متغير عدد_سجلات = 0
متغير مجموع_أعمار = 0
متغير مجموع_رواتب = 0

# === إدخال سجل موظف ===
دالة سجل_موظف(رقم_م: رقم، اسم_موظف: نص، عمر_م: رقم، قسم_م: نص، راتب_رقم: رقم)
    عدد_سجلات = عدد_سجلات + 1
    مجموع_أعمار = مجموع_أعمار + عمر_م
    مجموع_رواتب = مجموع_رواتب + راتب_رقم

    اطبع("    │ ")
    اطبع(رقم_م)
    اطبع(" │ ")
    اطبع(اسم_موظف)
    اطبع(" │ ")
    اطبع(عمر_م)
    اطبع(" │ ")
    اطبع(قسم_م)
    اطبع(" │ ")
    اطبع(راتب_رقم)
    اطبع_سطر(" │")
نهاية

# === إحصائيات ===
دالة طباعة_إحصائيات()
    اطبع_سطر("")
    اطبع_سطر("  ═══ الإحصائيات ═══")
    اطبع("    عدد السجلات: ")
    اطبع_سطر(عدد_سجلات)

    متغير متوسط_عمر = مجموع_أعمار / عدد_سجلات
    اطبع("    متوسط العمر: ")
    اطبع_سطر(متوسط_عمر)

    متغير متوسط_راتب = مجموع_رواتب / عدد_سجلات
    اطبع("    متوسط الراتب: ")
    اطبع(متوسط_راتب)
    اطبع_سطر(" ريال")

    اطبع("    إجمالي الرواتب: ")
    اطبع(مجموع_رواتب)
    اطبع_سطر(" ريال")
نهاية

# === جدول المنتجات ===
متغير مجموع_مخزون = 0
متغير مجموع_قيمة = 0
متغير عدد_منتجات_ج = 0

دالة سجل_منتج(كود: نص، اسم_المنتج: نص، سعر_وحدة: رقم، كمية_متاحة: رقم)
    عدد_منتجات_ج = عدد_منتجات_ج + 1
    مجموع_مخزون = مجموع_مخزون + كمية_متاحة
    متغير قيمة_سطر = سعر_وحدة * كمية_متاحة
    مجموع_قيمة = مجموع_قيمة + قيمة_سطر

    اطبع("    │ ")
    اطبع(كود)
    اطبع(" │ ")
    اطبع(اسم_المنتج)
    اطبع(" │ ")
    اطبع(سعر_وحدة)
    اطبع(" │ ")
    اطبع(كمية_متاحة)
    اطبع(" │ ")
    اطبع(قيمة_سطر)
    اطبع_سطر(" │")
نهاية

دالة طباعة_إحصائيات_منتجات()
    اطبع_سطر("")
    اطبع_سطر("  ═══ إحصائيات المنتجات ═══")
    اطبع("    عدد المنتجات: ")
    اطبع_سطر(عدد_منتجات_ج)
    اطبع("    إجمالي المخزون: ")
    اطبع(مجموع_مخزون)
    اطبع_سطر(" وحدة")
    اطبع("    إجمالي القيمة: ")
    اطبع(مجموع_قيمة)
    اطبع_سطر(" ريال")
نهاية

# === فحص الأنواع في الشروط ===
دالة فحص_راتب(اسم_فح: نص، راتب_فح: رقم)
    اطبع("    ")
    اطبع(اسم_فح)
    اطبع(": ")
    اذا (راتب_فح >= 10000)
        اطبع_سطر("مرتفع ⬆")
    نهاية
    اذا (راتب_فح >= 5000)
        اذا (راتب_فح < 10000)
            اطبع_سطر("متوسط ↔")
        نهاية
    نهاية
    اذا (راتب_فح < 5000)
        اطبع_سطر("منخفض ⬇")
    نهاية
نهاية

# === التحقق من النصوص ===
دالة فحص_اسم(اسم_فحص: نص)
    متغير طول_ن = strlen(اسم_فحص)
    اطبع("    '")
    اطبع(اسم_فحص)
    اطبع("' → طول: ")
    اطبع(طول_ن)
    اطبع(" بايت")
    اذا (طول_ن > 10)
        اطبع_سطر(" (طويل)")
    نهاية
    اذا (طول_ن <= 10)
        اطبع_سطر(" (قصير)")
    نهاية
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════╗")
    اطبع_سطر("║       جداول البيانات المنمطة          ║")
    اطبع_سطر("╚══════════════════════════════════════════╝")
    اطبع_سطر("")

    # === جدول الموظفين ===
    اطبع_سطر("  ═══ جدول الموظفين ═══")
    اطبع_سطر("    │ رقم │ الاسم │ العمر │ القسم │ الراتب │")
    اطبع_سطر("    ├──────┼───────┼───────┼───────┼────────┤")
    سجل_موظف(1، "أحمد"، 30، "تقنية"، 8000)
    سجل_موظف(2، "سارة"، 28، "مالية"، 7500)
    سجل_موظف(3، "خالد"، 35، "إدارة"، 12000)
    سجل_موظف(4، "نور"، 26، "تسويق"، 6000)
    سجل_موظف(5، "فهد"، 40، "تقنية"، 15000)
    طباعة_إحصائيات()

    # === جدول المنتجات ===
    اطبع_سطر("")
    اطبع_سطر("  ═══ جدول المنتجات ═══")
    اطبع_سطر("    │ كود │ المنتج │ السعر │ الكمية │ القيمة │")
    اطبع_سطر("    ├──────┼────────┼───────┼────────┼────────┤")
    سجل_منتج("P01"، "لابتوب"، 3500، 10)
    سجل_منتج("P02"، "طابعة"، 800، 25)
    سجل_منتج("P03"، "ماوس"، 50، 100)
    سجل_منتج("P04"، "شاشة"، 1200، 15)
    سجل_منتج("P05"، "لوحة"، 150، 50)
    طباعة_إحصائيات_منتجات()

    # === فحص الرواتب ===
    اطبع_سطر("")
    اطبع_سطر("  ═══ تصنيف الرواتب ═══")
    فحص_راتب("أحمد"، 8000)
    فحص_راتب("خالد"، 12000)
    فحص_راتب("نور"، 6000)
    فحص_راتب("فهد"، 15000)
    فحص_راتب("محمد"، 3000)

    # === فحص الأسماء ===
    اطبع_سطر("")
    اطبع_سطر("  ═══ فحص الأسماء ═══")
    فحص_اسم("Ali")
    فحص_اسم("أحمد محمد السعيد")
    فحص_اسم("SAD")
    فحص_اسم("Programming")

    اطبع_سطر("")
    اطبع_سطر("=== انتهت جداول البيانات ===")
نهاية
