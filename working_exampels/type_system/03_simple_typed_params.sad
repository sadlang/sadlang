# ═══════════════════════════════════════════════════════════
# مثال بسيط 2: معاملات الدوال المُنمَّطة
# Simple 2: Typed Function Parameters
# ═══════════════════════════════════════════════════════════

# === دوال بمعاملات رقمية ===
دالة مربع(ع: رقم)
    متغير ناتج = ع * ع
    اطبع("    مربع ")
    اطبع(ع)
    اطبع(" = ")
    اطبع_سطر(ناتج)
نهاية

دالة مضاعف(ع: رقم)
    متغير ناتج = ع * 2
    اطبع("    مضاعف ")
    اطبع(ع)
    اطبع(" = ")
    اطبع_سطر(ناتج)
نهاية

دالة ثلاثي(ع: رقم)
    متغير ناتج = ع * 3
    اطبع("    ثلاثة أضعاف ")
    اطبع(ع)
    اطبع(" = ")
    اطبع_سطر(ناتج)
نهاية

# === دوال بمعاملات نصية ===
دالة تحية(اسم_ش: نص)
    اطبع("    مرحباً يا ")
    اطبع_سطر(اسم_ش)
نهاية

دالة وداع(اسم_ش: نص)
    اطبع("    مع السلامة يا ")
    اطبع_سطر(اسم_ش)
نهاية

# === دوال بمعاملات متعددة الأنواع ===
دالة معلومات_شخص(اسم_مع: نص، عمر_مع: رقم)
    اطبع("    الاسم: ")
    اطبع(اسم_مع)
    اطبع(" | العمر: ")
    اطبع_سطر(عمر_مع)
نهاية

دالة معلومات_منتج(اسم_من: نص، سعر_من: رقم، متوفر: رقم)
    اطبع("    ")
    اطبع(اسم_من)
    اطبع(" - ")
    اطبع(سعر_من)
    اطبع(" ريال")
    اذا (متوفر == 1)
        اطبع_سطر(" ✓")
    نهاية
    اذا (متوفر == 0)
        اطبع_سطر(" ✗")
    نهاية
نهاية

# === عمليات مقارنة الأنواع ===
دالة اختبار_مقارنات()
    اطبع_سطر("--- مقارنات الأنواع ---")

    # مقارنة أرقام
    متغير أ = 10
    متغير ب = 20
    متغير أكبر = أ > ب
    اطبع("    10 > 20: ")
    اطبع_سطر(أكبر)

    متغير أصغر = أ < ب
    اطبع("    10 < 20: ")
    اطبع_سطر(أصغر)

    متغير متساوي = أ == 10
    اطبع("    10 == 10: ")
    اطبع_سطر(متساوي)

    # مقارنة نصوص
    متغير ن_مق = "مرحبا" == "مرحبا"
    اطبع("    'مرحبا' == 'مرحبا': ")
    اطبع_سطر(ن_مق)
نهاية

# === تحويل الأنواع الضمني ===
دالة اختبار_تحويلات()
    اطبع_سطر("")
    اطبع_سطر("--- تحويلات الأنواع ---")

    # رقم إلى نص
    متغير ر1 = 42
    متغير ر1_نص = لنص(ر1)
    اطبع("    رقم 42 كنص: ")
    اطبع_سطر(ر1_نص)

    متغير ر2 = -10
    متغير ر2_نص = لنص(ر2)
    اطبع("    رقم -10 كنص: ")
    اطبع_سطر(ر2_نص)

    # منطقي
    متغير م1 = صحيح
    متغير م1_نص = لنص(م1)
    اطبع("    صحيح كنص: ")
    اطبع_سطر(م1_نص)
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║    معاملات الدوال المنمطة         ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    اطبع_سطر("--- دوال رقمية ---")
    مربع(5)
    مربع(12)
    مضاعف(7)
    ثلاثي(9)

    اطبع_سطر("")
    اطبع_سطر("--- تحيات ---")
    تحية("أحمد")
    تحية("سارة")
    وداع("خالد")

    اطبع_سطر("")
    اطبع_سطر("--- معلومات أشخاص ---")
    معلومات_شخص("أحمد"، 25)
    معلومات_شخص("سارة"، 30)
    معلومات_شخص("محمد"، 45)

    اطبع_سطر("")
    اطبع_سطر("--- معلومات منتجات ---")
    معلومات_منتج("لابتوب"، 3500، 1)
    معلومات_منتج("طابعة"، 800، 0)
    معلومات_منتج("ماوس"، 50، 1)

    اطبع_سطر("")
    اختبار_مقارنات()
    اختبار_تحويلات()

    اطبع_سطر("")
    اطبع_سطر("=== تم اختبار المعاملات المنمطة بنجاح ===")
نهاية
