# === أرقام صحيحة ===
دالة اختبار_ارقام()
    اطبع_سطر("--- أنواع الأرقام الصحيحة ---")
    متغير ر1 = 0
    متغير ر2 = 42
    متغير ر3 = -15
    متغير ر4 = 1000000

    اطبع("    صفر: ")
    اطبع_سطر(ر1)
    اطبع("    موجب: ")
    اطبع_سطر(ر2)
    اطبع("    سالب: ")
    اطبع_سطر(ر3)
    اطبع("    كبير: ")
    اطبع_سطر(ر4)

    # عمليات حسابية
    متغير مجموع = ر2 + ر3
    اطبع("    42 + (-15) = ")
    اطبع_سطر(مجموع)

    متغير حاصل = ر2 * 2
    اطبع("    42 × 2 = ")
    اطبع_سطر(حاصل)

    متغير قسمة_ر = ر4 / 1000
    اطبع("    1000000 ÷ 1000 = ")
    اطبع_سطر(قسمة_ر)

    متغير باقي_ر = ر2 % 5
    اطبع("    42 %% 5 = ")
    اطبع_سطر(باقي_ر)
نهاية

# === نصوص ===
دالة اختبار_نصوص()
    اطبع_سطر("")
    اطبع_سطر("--- أنواع النصوص ---")
    متغير ن1 = "مرحبا"
    متغير ن2 = "بالعالم"
    متغير ن3 = ""
    متغير ن4 = "Hello World"

    اطبع("    عربي: ")
    اطبع_سطر(ن1)
    اطبع("    عربي 2: ")
    اطبع_سطر(ن2)
    اطبع("    فارغ: '")
    اطبع(ن3)
    اطبع_سطر("'")
    اطبع("    إنجليزي: ")
    اطبع_سطر(ن4)
نهاية

# === قيم منطقية ===
دالة اختبار_منطقية()
    اطبع_سطر("")
    اطبع_سطر("--- القيم المنطقية ---")
    متغير م1 = صحيح
    متغير م2 = خطأ

    اطبع("    صحيح: ")
    اطبع_سطر(م1)
    اطبع("    خطأ: ")
    اطبع_سطر(م2)

    # عمليات منطقية
    متغير نتيجة_1 = 10 > 5
    اطبع("    10 > 5: ")
    اطبع_سطر(نتيجة_1)

    متغير نتيجة_2 = 3 > 7
    اطبع("    3 > 7: ")
    اطبع_سطر(نتيجة_2)

    متغير نتيجة_3 = 5 == 5
    اطبع("    5 == 5: ")
    اطبع_سطر(نتيجة_3)

    متغير نتيجة_4 = 5 != 3
    اطبع("    5 != 3: ")
    اطبع_سطر(نتيجة_4)
نهاية

# === أعداد عشرية ===
دالة اختبار_عشرية()
    اطبع_سطر("")
    اطبع_سطر("--- الأعداد العشرية ---")
    متغير ع1 = 3.14
    متغير ع2 = 2.718
    متغير ع3 = 0.0
    متغير ع4 = -1.5

    اطبع("    π ≈ ")
    اطبع_سطر(ع1)
    اطبع("    e ≈ ")
    اطبع_سطر(ع2)
    اطبع("    صفر: ")
    اطبع_سطر(ع3)
    اطبع("    سالب: ")
    اطبع_سطر(ع4)

    متغير مج_ع = ع1 + ع2
    اطبع("    π + e ≈ ")
    اطبع_سطر(مج_ع)
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║    أنواع البيانات الأساسية        ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    اختبار_ارقام()
    اختبار_نصوص()
    اختبار_منطقية()
    اختبار_عشرية()

    اطبع_سطر("")
    اطبع_سطر("=== تم اختبار جميع الأنواع بنجاح ===")
