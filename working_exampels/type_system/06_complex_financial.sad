# ═══════════════════════════════════════════════════════════
# مثال معقد: نظام تحليل مالي بأنواع بيانات متنوعة
# Complex: Financial Analysis System
# ═══════════════════════════════════════════════════════════

# === متغيرات النظام ===
متغير اجمالي_ايرادات = 0
متغير اجمالي_مصروفات = 0
متغير عدد_معاملات_مالية = 0
متغير عدد_تنبيهات = 0

# === أدوات العرض ===
دالة فاصل_م()
    اطبع_سطر("  ══════════════════════════════════════")
نهاية

دالة عنوان_قسم_م(عنوان: نص)
    اطبع_سطر("")
    فاصل_م()
    اطبع("  ◆ ")
    اطبع_سطر(عنوان)
    فاصل_م()
نهاية

# ═══════════════════════════════════════
# القسم 1: الإيرادات
# ═══════════════════════════════════════
دالة إيراد(مصدر: نص، مبلغ_إ: رقم، شهر: نص)
    عدد_معاملات_مالية = عدد_معاملات_مالية + 1
    اجمالي_ايرادات = اجمالي_ايرادات + مبلغ_إ

    اطبع("    ↑ ")
    اطبع(مصدر)
    اطبع(" | ")
    اطبع(مبلغ_إ)
    اطبع(" ريال | ")
    اطبع_سطر(شهر)
نهاية

# ═══════════════════════════════════════
# القسم 2: المصروفات
# ═══════════════════════════════════════
دالة مصروف(بند_م: نص، مبلغ_مص: رقم، فئة_م: نص)
    عدد_معاملات_مالية = عدد_معاملات_مالية + 1
    اجمالي_مصروفات = اجمالي_مصروفات + مبلغ_مص

    اطبع("    ↓ ")
    اطبع(بند_م)
    اطبع(" | ")
    اطبع(مبلغ_مص)
    اطبع(" ريال | ")
    اطبع_سطر(فئة_م)
نهاية

# ═══════════════════════════════════════
# القسم 3: تحليل النسب
# ═══════════════════════════════════════
دالة نسبة_مئوية(جزء_ن: رقم، كل_ن: رقم، وصف_ن: نص)
    متغير نسبة_ح = 0
    اذا (كل_ن > 0)
        نسبة_ح = جزء_ن * 100 / كل_ن
    نهاية
    اطبع("    ")
    اطبع(وصف_ن)
    اطبع(": ")
    اطبع(نسبة_ح)
    اطبع_سطر("%")
نهاية

# ═══════════════════════════════════════
# القسم 4: التنبيهات
# ═══════════════════════════════════════
دالة تنبيه_ميزانية(بند_تن: نص، مصروف_ق: رقم، ميزانية_ق: رقم)
    اطبع("    ")
    اطبع(بند_تن)
    اطبع(": ")
    اذا (مصروف_ق > ميزانية_ق)
        اطبع("⚠ تجاوز! (")
        متغير تجاوز = مصروف_ق - ميزانية_ق
        اطبع(تجاوز)
        اطبع_سطر(" ريال زيادة)")
        عدد_تنبيهات = عدد_تنبيهات + 1
    نهاية
    اذا (مصروف_ق <= ميزانية_ق)
        متغير متبقي_ق = ميزانية_ق - مصروف_ق
        اطبع("✓ ضمن الحدود (")
        اطبع(متبقي_ق)
        اطبع_سطر(" متبقي)")
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 5: حسابات ضريبية
# ═══════════════════════════════════════
دالة حساب_ضري(مبلغ_ض: رقم، نسبة_ض: رقم، وصف_ض: نص)
    متغير ضريبة_م = مبلغ_ض * نسبة_ض / 100
    متغير صافي_م = مبلغ_ض - ضريبة_م

    اطبع("    ")
    اطبع(وصف_ض)
    اطبع_سطر(":")
    اطبع("      المبلغ: ")
    اطبع(مبلغ_ض)
    اطبع_سطر(" ريال")
    اطبع("      الضريبة (")
    اطبع(نسبة_ض)
    اطبع("%): ")
    اطبع(ضريبة_م)
    اطبع_سطر(" ريال")
    اطبع("      الصافي: ")
    اطبع(صافي_م)
    اطبع_سطر(" ريال")
نهاية

# ═══════════════════════════════════════
# القسم 6: تقرير الأقساط
# ═══════════════════════════════════════
دالة قسط_شهري(اسم_قرض: نص، المبلغ_الكلي: رقم، عدد_أشهر: رقم)
    متغير قسط = المبلغ_الكلي / عدد_أشهر
    اطبع("    ")
    اطبع(اسم_قرض)
    اطبع(": ")
    اطبع(المبلغ_الكلي)
    اطبع(" ÷ ")
    اطبع(عدد_أشهر)
    اطبع(" شهر = ")
    اطبع(قسط)
    اطبع_سطر(" ريال/شهر")
نهاية

# ═══════════════════════════════════════
# القسم 7: مقارنة فترات
# ═══════════════════════════════════════
دالة مقارنة_فترة(فترة_أسم: نص، إيراد_ف: رقم، مصروف_ف: رقم)
    متغير صافي_ف = إيراد_ف - مصروف_ف
    اطبع("    ")
    اطبع(فترة_أسم)
    اطبع(": إيراد ")
    اطبع(إيراد_ف)
    اطبع(" - مصروف ")
    اطبع(مصروف_ف)
    اطبع(" = صافي ")
    اطبع(صافي_ف)
    اذا (صافي_ف > 0)
        اطبع_سطر(" ✓ ربح")
    نهاية
    اذا (صافي_ف <= 0)
        اطبع_سطر(" ✗ خسارة")
    نهاية
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════╗")
    اطبع_سطر("║      نظام التحليل المالي المتكامل         ║")
    اطبع_سطر("╚══════════════════════════════════════════════╝")

    # === الإيرادات ===
    عنوان_قسم_م("الإيرادات")
    إيراد("مبيعات"، 50000، "يناير")
    إيراد("خدمات"، 25000، "يناير")
    إيراد("استشارات"، 15000، "يناير")
    إيراد("مبيعات"، 55000، "فبراير")
    إيراد("خدمات"، 28000، "فبراير")
    إيراد("تدريب"، 10000، "فبراير")

    # === المصروفات ===
    عنوان_قسم_م("المصروفات")
    مصروف("رواتب"، 35000، "ثابت")
    مصروف("إيجار"، 8000، "ثابت")
    مصروف("معدات_م"، 12000، "استثماري")
    مصروف("تسويق_م"، 5000، "متغير")
    مصروف("صيانة_م"، 3000، "متغير")
    مصروف("خدمات_ع"، 2000، "ثابت")

    # === الملخص المالي ===
    عنوان_قسم_م("الملخص المالي")
    اطبع("    إجمالي الإيرادات: ")
    اطبع(اجمالي_ايرادات)
    اطبع_سطر(" ريال")
    اطبع("    إجمالي المصروفات: ")
    اطبع(اجمالي_مصروفات)
    اطبع_سطر(" ريال")
    متغير صافي_ربح = اجمالي_ايرادات - اجمالي_مصروفات
    اطبع("    صافي الربح: ")
    اطبع(صافي_ربح)
    اطبع_سطر(" ريال")
    اطبع("    عدد المعاملات: ")
    اطبع_سطر(عدد_معاملات_مالية)

    # === التحليل ===
    عنوان_قسم_م("تحليل النسب")
    نسبة_مئوية(اجمالي_مصروفات، اجمالي_ايرادات، "المصروفات/الإيرادات")
    نسبة_مئوية(صافي_ربح، اجمالي_ايرادات، "هامش الربح")
    نسبة_مئوية(35000، اجمالي_مصروفات، "نسبة الرواتب")
    نسبة_مئوية(8000، اجمالي_مصروفات، "نسبة الإيجار")

    # === التنبيهات ===
    عنوان_قسم_م("تنبيهات الميزانية")
    تنبيه_ميزانية("الرواتب"، 35000، 30000)
    تنبيه_ميزانية("الإيجار"، 8000، 10000)
    تنبيه_ميزانية("التسويق"، 5000، 4000)
    تنبيه_ميزانية("الصيانة"، 3000، 5000)
    اطبع("    عدد التنبيهات: ")
    اطبع_سطر(عدد_تنبيهات)

    # === الضرائب ===
    عنوان_قسم_م("حسابات ضريبية")
    حساب_ضري(50000، 15، "مبيعات يناير")
    حساب_ضري(55000، 15، "مبيعات فبراير")
    حساب_ضري(25000، 5، "خدمات")

    # === الأقساط ===
    عنوان_قسم_م("أقساط القروض")
    قسط_شهري("قرض سيارة"، 120000، 60)
    قسط_شهري("قرض شخصي"، 50000، 24)
    قسط_شهري("قرض عقاري"، 500000، 240)

    # === مقارنة فترات ===
    عنوان_قسم_م("مقارنة الفترات")
    مقارنة_فترة("يناير"، 90000، 30000)
    مقارنة_فترة("فبراير"، 93000، 35000)
    مقارنة_فترة("مارس (تقدير)"، 70000، 80000)

    اطبع_سطر("")
    اطبع_سطر("=== انتهى التحليل المالي ===")
نهاية
