# === متغيرات النظام ===
متغير عدد_طلاب = 0
متغير عدد_ناجحين = 0
متغير عدد_راسبين = 0
متغير مج_درجات_رياضيات = 0
متغير مج_درجات_علوم = 0
متغير مج_درجات_لغة = 0
متغير مج_كل_درجات = 0

# === أدوات ===
دالة فصل_مدرسة()
    اطبع_سطر("  ═══════════════════════════════════════════")
نهاية

دالة عنوان_مدرسة(عنوان: نص)
    اطبع_سطر("")
    فصل_مدرسة()
    اطبع("  ★ ")
    اطبع_سطر(عنوان)
    فصل_مدرسة()
نهاية

# ═══════════════════════════════════════
# القسم 1: تسجيل الطلاب
# ═══════════════════════════════════════
دالة تسجيل_طالب(رقم_ط: رقم، اسم_ط: نص، عمر_ط: رقم، صف_ط: نص)
    عدد_طلاب = عدد_طلاب + 1
    اطبع("    📚 [")
    اطبع(رقم_ط)
    اطبع("] ")
    اطبع(اسم_ط)
    اطبع(" | عمر: ")
    اطبع(عمر_ط)
    اطبع(" | الصف: ")
    اطبع_سطر(صف_ط)
نهاية

# ═══════════════════════════════════════
# القسم 2: إدخال الدرجات
# ═══════════════════════════════════════
دالة درجات_طالب(اسم_در: نص، رياضيات: رقم، علوم: رقم، لغة_عربية: رقم)
    متغير مج = رياضيات + علوم + لغة_عربية
    متغير معدل = مج / 3

    مج_درجات_رياضيات = مج_درجات_رياضيات + رياضيات
    مج_درجات_علوم = مج_درجات_علوم + علوم
    مج_درجات_لغة = مج_درجات_لغة + لغة_عربية
    مج_كل_درجات = مج_كل_درجات + مج

    اطبع("    ")
    اطبع(اسم_در)
    اطبع(": رياضيات=")
    اطبع(رياضيات)
    اطبع(" علوم=")
    اطبع(علوم)
    اطبع(" لغة=")
    اطبع(لغة_عربية)
    اطبع(" | المجموع=")
    اطبع(مج)
    اطبع(" المعدل=")
    اطبع(معدل)

    اذا (معدل >= 60)
        اطبع_سطر(" ✓ ناجح")
        عدد_ناجحين = عدد_ناجحين + 1
    نهاية
    اذا (معدل < 60)
        اطبع_سطر(" ✗ راسب")
        عدد_راسبين = عدد_راسبين + 1
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 3: الجدول الزمني
# ═══════════════════════════════════════
دالة حصة(يوم_ح: نص، وقت_ح: نص، مادة: نص، معلم: نص)
    اطبع("    │ ")
    اطبع(يوم_ح)
    اطبع(" │ ")
    اطبع(وقت_ح)
    اطبع(" │ ")
    اطبع(مادة)
    اطبع(" │ ")
    اطبع(معلم)
    اطبع_سطر(" │")
نهاية

# ═══════════════════════════════════════
# القسم 4: الحضور والغياب
# ═══════════════════════════════════════
متغير أيام_حضور = 0
متغير أيام_غياب = 0

دالة سجل_حضور(اسم_حض: نص، حاضر: رقم، غائب: رقم)
    أيام_حضور = أيام_حضور + حاضر
    أيام_غياب = أيام_غياب + غائب
    متغير اجمالي_أيام = حاضر + غائب
    متغير نسبة_حضور = حاضر * 100 / اجمالي_أيام

    اطبع("    ")
    اطبع(اسم_حض)
    اطبع(": حضور=")
    اطبع(حاضر)
    اطبع(" غياب=")
    اطبع(غائب)
    اطبع(" نسبة=")
    اطبع(نسبة_حضور)
    اطبع("%")
    اذا (نسبة_حضور >= 90)
        اطبع_سطر(" ⭐ ممتاز")
    نهاية
    اذا (نسبة_حضور >= 75)
        اذا (نسبة_حضور < 90)
            اطبع_سطر(" ✓ جيد")
        نهاية
    نهاية
    اذا (نسبة_حضور < 75)
        اطبع_سطر(" ⚠ تحذير")
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 5: الرسوم الدراسية
# ═══════════════════════════════════════
متغير مج_رسوم_محصلة = 0
متغير مج_رسوم_متبقية = 0

دالة رسوم_طالب(اسم_رس: نص، رسوم_كلية: رقم، مدفوع: رقم)
    متغير متبقي_رس = رسوم_كلية - مدفوع
    مج_رسوم_محصلة = مج_رسوم_محصلة + مدفوع
    مج_رسوم_متبقية = مج_رسوم_متبقية + متبقي_رس

    اطبع("    ")
    اطبع(اسم_رس)
    اطبع(": كلي=")
    اطبع(رسوم_كلية)
    اطبع(" مدفوع=")
    اطبع(مدفوع)
    اطبع(" متبقي=")
    اطبع(متبقي_رس)
    اذا (متبقي_رس == 0)
        اطبع_سطر(" ✓ مكتمل")
    نهاية
    اذا (متبقي_رس > 0)
        اطبع_سطر(" ⏳ غير مكتمل")
    نهاية
نهاية

# ═══════════════════════════════════════
# القسم 6: بناء التقارير النصية
# ═══════════════════════════════════════
دالة سطر_تقرير(مفتاح: نص، قيمة_تقر: رقم، وحدة: نص)
    متغير قيمة_نص = لنص(قيمة_تقر)
    متغير سطر_كامل = "    " + مفتاح + ": " + قيمة_نص + " " + وحدة
    اطبع_سطر(سطر_كامل)
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════╗")
    اطبع_سطر("║       نظام إدارة المدرسة المتكامل         ║")
    اطبع_سطر("╚══════════════════════════════════════════════╝")

    # === التسجيل ===
    عنوان_مدرسة("تسجيل الطلاب")
    تسجيل_طالب(101، "أحمد سعيد"، 15، "الثالث متوسط")
    تسجيل_طالب(102، "سارة محمد"، 14، "الثاني متوسط")
    تسجيل_طالب(103، "خالد علي"، 16، "الأول ثانوي")
    تسجيل_طالب(104، "نورة فهد"، 15، "الثالث متوسط")
    تسجيل_طالب(105، "عمر حسن"، 14، "الثاني متوسط")
    تسجيل_طالب(106، "فاطمة عبدالله"، 16، "الأول ثانوي")

    # === الدرجات ===
    عنوان_مدرسة("درجات الطلاب")
    درجات_طالب("أحمد"، 85، 90، 78)
    درجات_طالب("سارة"، 92، 88، 95)
    درجات_طالب("خالد"، 70، 65، 55)
    درجات_طالب("نورة"، 95، 98، 92)
    درجات_طالب("عمر"، 45، 50، 40)
    درجات_طالب("فاطمة"، 80، 75، 82)

    # === الجدول ===
    عنوان_مدرسة("الجدول الزمني - الأحد")
    اطبع_سطر("    │ اليوم │ الوقت │ المادة │ المعلم │")
    اطبع_سطر("    ├───────┼───────┼────────┼────────┤")
    حصة("الأحد"، "08:00"، "رياضيات"، "أ. محمد")
    حصة("الأحد"، "09:00"، "علوم"، "أ. أحمد")
    حصة("الأحد"، "10:00"، "لغة عربية"، "أ. سعيد")
    حصة("الأحد"، "11:00"، "إنجليزي"، "أ. خالد")

    # === الحضور ===
    عنوان_مدرسة("سجل الحضور (30 يوم)")
    سجل_حضور("أحمد"، 28، 2)
    سجل_حضور("سارة"، 30، 0)
    سجل_حضور("خالد"، 25، 5)
    سجل_حضور("نورة"، 29، 1)
    سجل_حضور("عمر"، 20، 10)
    سجل_حضور("فاطمة"، 27، 3)

    # === الرسوم ===
    عنوان_مدرسة("الرسوم الدراسية")
    رسوم_طالب("أحمد"، 5000، 5000)
    رسوم_طالب("سارة"، 5000، 3000)
    رسوم_طالب("خالد"، 5000، 5000)
    رسوم_طالب("نورة"، 5000، 4000)
    رسوم_طالب("عمر"، 5000، 2000)
    رسوم_طالب("فاطمة"، 5000، 5000)

    # === التقرير النهائي ===
    عنوان_مدرسة("التقرير النهائي")
    سطر_تقرير("عدد الطلاب"، عدد_طلاب، "طالب")
    سطر_تقرير("الناجحون"، عدد_ناجحين، "طالب")
    سطر_تقرير("الراسبون"، عدد_راسبين، "طالب")

    متغير معدل_رياضيات = مج_درجات_رياضيات / عدد_طلاب
    متغير معدل_علوم = مج_درجات_علوم / عدد_طلاب
    متغير معدل_لغة = مج_درجات_لغة / عدد_طلاب
    متغير معدل_عام = مج_كل_درجات / عدد_طلاب / 3

    اطبع_سطر("")
    اطبع_سطر("    معدلات المواد:")
    سطر_تقرير("  رياضيات"، معدل_رياضيات، "")
    سطر_تقرير("  علوم"، معدل_علوم، "")
    سطر_تقرير("  لغة عربية"، معدل_لغة، "")
    سطر_تقرير("  المعدل العام"، معدل_عام، "")

    اطبع_سطر("")
    اطبع_سطر("    الرسوم:")
    سطر_تقرير("  محصلة"، مج_رسوم_محصلة، "ريال")
    سطر_تقرير("  متبقية"، مج_رسوم_متبقية، "ريال")

    متغير نسبة_نجاح = عدد_ناجحين * 100 / عدد_طلاب
    اطبع_سطر("")
    سطر_تقرير("نسبة النجاح"، نسبة_نجاح، "%")
    متغير نسبة_تحصيل = مج_رسوم_محصلة * 100 / 30000
    سطر_تقرير("نسبة التحصيل"، نسبة_تحصيل، "%")

    اطبع_سطر("")
    اطبع_سطر("=== انتهى نظام إدارة المدرسة ===")
نهاية
