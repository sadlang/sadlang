# =============================================================
# مثال بسيط 2: برنامج صحيح يستخدم الدوال والتحقق من الأنواع
# =============================================================
# الهدف: اختبار التحقق الصحيح من الأنواع ورسائل النجاح
# المستوى: بسيط
# الميزة: Type Checking, Error Prevention (T162, T165)
# =============================================================

# دالة تحويل الدرجة المئوية
دالة عرض_حرارة(رقم درجة)
    اطبع("  الدرجة: ")
    اطبع(درجة)
    اطبع(" °م")

    # تصنيف الحرارة
    طابق درجة
        حالة 0:
            اطبع_سطر(" - تجمد الماء!")
        حالة 100:
            اطبع_سطر(" - غليان الماء!")
        حالة 37:
            اطبع_سطر(" - حرارة الجسم الطبيعية")
        حالة 25:
            اطبع_سطر(" - درجة حرارة مريحة")
        حالة 50:
            اطبع_سطر(" - حرارة مرتفعة")
        حالة _:
            اطبع_سطر("")
    نهاية
نهاية

# دالة تحويل الأيام
دالة نص اسم_اليوم(رقم رقم_يوم)
    طابق رقم_يوم
        حالة 1:
            ارجع "الاثنين"
        حالة 2:
            ارجع "الثلاثاء"
        حالة 3:
            ارجع "الأربعاء"
        حالة 4:
            ارجع "الخميس"
        حالة 5:
            ارجع "الجمعة"
        حالة 6:
            ارجع "السبت"
        حالة 7:
            ارجع "الأحد"
        حالة _:
            ارجع "يوم غير صحيح"
    نهاية
نهاية

# دالة حساب مساحة المستطيل
دالة رقم مساحة_مستطيل(رقم طول، رقم عرض)
    ارجع طول * عرض
نهاية

# دالة حساب محيط المستطيل
دالة رقم محيط_مستطيل(رقم طول، رقم عرض)
    ارجع 2 * (طول + عرض)
نهاية

# === الدالة الرئيسية ===
دالة رئيسية()
    اطبع_سطر("╔═══════════════════════════════════════════╗")
    اطبع_سطر("║  اختبار التحقق من الأنواع ورسائل الخطأ    ║")
    اطبع_سطر("╚═══════════════════════════════════════════╝")

    # --- 1. اختبار الأنواع الصحيحة ---
    اطبع_سطر("")
    اطبع_سطر("--- 1. أنواع البيانات الصحيحة ---")
    رقم عدد = 42
    نص رسالة = "مرحبا بالعالم"
    منطقي فعال = صحيح

    اطبع("  عدد صحيح: ")
    اطبع_سطر(عدد)
    اطبع("  نص: ")
    اطبع_سطر(رسالة)
    اطبع("  منطقي: ")
    اطبع_سطر(فعال)

    # --- 2. اختبار الدوال مع أنواع صحيحة ---
    اطبع_سطر("")
    اطبع_سطر("--- 2. الدوال الحسابية ---")
    رقم ط = 10
    رقم ع = 5
    اطبع("  مساحة مستطيل (10×5) = ")
    اطبع_سطر(مساحة_مستطيل(ط، ع))
    اطبع("  محيط مستطيل (10×5) = ")
    اطبع_سطر(محيط_مستطيل(ط، ع))

    # --- 3. اختبار الدوال النصية ---
    اطبع_سطر("")
    اطبع_سطر("--- 3. أيام الأسبوع ---")
    متغير يوم = 1
    بينما (يوم <= 7)
        اطبع("  اليوم ")
        اطبع(يوم)
        اطبع(": ")
        اطبع_سطر(اسم_اليوم(يوم))
        يوم = يوم + 1
    نهاية

    # --- 4. اختبار درجات الحرارة ---
    اطبع_سطر("")
    اطبع_سطر("--- 4. درجات الحرارة ---")
    عرض_حرارة(0)
    عرض_حرارة(25)
    عرض_حرارة(37)
    عرض_حرارة(50)
    عرض_حرارة(100)

    # --- 5. تعبيرات منطقية ---
    اطبع_سطر("")
    اطبع_سطر("--- 5. التعبيرات المنطقية ---")
    رقم س = 10
    رقم ص = 20

    إذا (س < ص)
        اطبع_سطر("  10 أصغر من 20 - صحيح")
    نهاية

    إذا (س + ص == 30)
        اطبع_سطر("  10 + 20 = 30 - صحيح")
    نهاية

    إذا (ص - س == 10)
        اطبع_سطر("  20 - 10 = 10 - صحيح")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("=== تم اختبار التحقق من الأنواع بنجاح ===")
    ارجع 0
نهاية
