# =============================================================
# مثال بسيط 1: اختبار رسائل الخطأ الذكية - أخطاء نحوية
# =============================================================
# الهدف: اختبار إظهار رسائل خطأ ذكية عند الأخطاء النحوية
# المستوى: بسيط
# الميزة: Smart Error Messages, Error Recovery (T161-T168)
# =============================================================
# هذا المثال صحيح نحوياً - يختبر التعامل الجيد مع البرنامج

دالة رئيسية()
    اطبع_سطر("=== اختبار رسائل الخطأ الذكية - مثال صحيح ===")
    اطبع_سطر("")

    # --- 1. أنواع البيانات المختلفة ---
    اطبع_سطر("--- اختبار أنواع البيانات ---")
    رقم عدد_صحيح = 42
    نص اسم = "محمد"
    منطقي نتيجة = صحيح

    اطبع("العدد: ")
    اطبع_سطر(عدد_صحيح)
    اطبع("الاسم: ")
    اطبع_سطر(اسم)
    اطبع("النتيجة: ")
    اطبع_سطر(نتيجة)

    # --- 2. عمليات حسابية سليمة ---
    اطبع_سطر("")
    اطبع_سطر("--- العمليات الحسابية ---")
    رقم أ = 100
    رقم ب = 25
    رقم مجموع = أ + ب
    رقم فرق = أ - ب
    رقم ضرب = أ * ب
    رقم قسمة = أ / ب

    اطبع("الجمع: ")
    اطبع(أ)
    اطبع(" + ")
    اطبع(ب)
    اطبع(" = ")
    اطبع_سطر(مجموع)

    اطبع("الطرح: ")
    اطبع(أ)
    اطبع(" - ")
    اطبع(ب)
    اطبع(" = ")
    اطبع_سطر(فرق)

    اطبع("الضرب: ")
    اطبع(أ)
    اطبع(" × ")
    اطبع(ب)
    اطبع(" = ")
    اطبع_سطر(ضرب)

    اطبع("القسمة: ")
    اطبع(أ)
    اطبع(" ÷ ")
    اطبع(ب)
    اطبع(" = ")
    اطبع_سطر(قسمة)

    # --- 3. شروط صحيحة ---
    اطبع_سطر("")
    اطبع_سطر("--- الشروط ---")
    رقم عمر = 25
    إذا (عمر >= 18)
        اطبع_سطر("  بالغ - يمكنه التصويت")
    وإلا
        اطبع_سطر("  قاصر")
    نهاية

    إذا (عمر >= 21)
        اطبع_سطر("  يمكنه قيادة السيارة")
    نهاية

    # --- 4. حلقات سليمة ---
    اطبع_سطر("")
    اطبع_سطر("--- الحلقات ---")
    اطبع("  الأعداد الزوجية: ")
    متغير ع = 2
    بينما (ع <= 20)
        اطبع(ع)
        اطبع(" ")
        ع = ع + 2
    نهاية
    اطبع_سطر("")

    # --- 5. مطابقة أنماط ---
    اطبع_سطر("")
    اطبع_سطر("--- مطابقة الأنماط ---")
    نص لغة = "ص"
    طابق لغة
        حالة "ص":
            اطبع_سطر("  لغة ص - لغة البرمجة العربية!")
        حالة "بايثون":
            اطبع_سطر("  بايثون - لغة سهلة التعلم")
        حالة "جافا":
            اطبع_سطر("  جافا - اكتب مرة واحدة شغّل في كل مكان")
        حالة _:
            اطبع_سطر("  لغة برمجة أخرى")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("=== تم اختبار البرنامج الصحيح بنجاح ===")
    ارجع 0
نهاية
