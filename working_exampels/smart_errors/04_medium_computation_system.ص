# ═══════════════════════════════════════════════════════
# دوال الرياضيات مع معالجة الأخطاء
# ═══════════════════════════════════════════════════════

دالة رقم القيمة_المطلقة(رقم ن)
    إذا (ن < 0)
        ارجع 0 - ن
    نهاية
    ارجع ن
نهاية

دالة رقم أكبر_عددين(رقم أ، رقم ب)
    إذا (أ >= ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة رقم أصغر_عددين(رقم أ، رقم ب)
    إذا (أ <= ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة رقم أكبر_ثلاثة(رقم أ، رقم ب، رقم ج)
    ارجع أكبر_عددين(أكبر_عددين(أ، ب)، ج)
نهاية

دالة رقم أصغر_ثلاثة(رقم أ، رقم ب، رقم ج)
    ارجع أصغر_عددين(أصغر_عددين(أ، ب)، ج)
نهاية

# --- دالة قسمة آمنة ---
دالة رقم قسمة(رقم بسط، رقم مقام)
    إذا (مقام == 0)
        اطبع("  ⚠ تنبيه: قسمة على صفر! ")
        ارجع 0
    نهاية
    ارجع بسط / مقام
نهاية

# --- دالة قوة ---
دالة رقم قوة(رقم اساس، رقم اس)
    إذا (اس <= 0)
        ارجع 1
    نهاية
    ارجع اساس * قوة(اساس، اس - 1)
نهاية

# --- دالة مضروب ---
دالة رقم مضروب(رقم ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

# --- دالة GCD ---
دالة رقم القاسم_المشترك(رقم أ، رقم ب)
    إذا (ب == 0)
        ارجع أ
    نهاية
    ارجع القاسم_المشترك(ب، أ - (أ / ب) * ب)
نهاية

# ═══════════════════════════════════════════════════════
# دوال العرض
# ═══════════════════════════════════════════════════════

دالة خط()
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
نهاية

دالة عرض_قسم(نص عنوان)
    اطبع_سطر("")
    خط()
    اطبع("  ◆ ")
    اطبع_سطر(عنوان)
    خط()
نهاية

# --- تصنيف العدد ---
دالة تصنيف_عدد(رقم ع)
    اطبع("  العدد ")
    اطبع(ع)
    اطبع(": ")

    إذا (ع > 0)
        اطبع("موجب")
    وإلا
        إذا (ع < 0)
            اطبع("سالب")
        وإلا
            اطبع("صفر")
        نهاية
    نهاية

    إذا (ع != 0)
        إذا (ع - (ع / 2) * 2 == 0)
            اطبع("، زوجي")
        وإلا
            اطبع("، فردي")
        نهاية
    نهاية

    اطبع_سطر("")
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔═══════════════════════════════════════════════╗")
    اطبع_سطر("║   نظام حسابي شامل مع معالجة الأخطاء الذكية   ║")
    اطبع_سطر("║   Smart Error Messages - Medium Test 2        ║")
    اطبع_سطر("╚═══════════════════════════════════════════════╝")

    # === القسم 1: القيمة المطلقة ===
    عرض_قسم("القيمة المطلقة")
    اطبع("  |42| = ")
    اطبع_سطر(القيمة_المطلقة(42))
    اطبع("  |-15| = ")
    اطبع_سطر(القيمة_المطلقة(0 - 15))
    اطبع("  |0| = ")
    اطبع_سطر(القيمة_المطلقة(0))
    اطبع("  |-100| = ")
    اطبع_سطر(القيمة_المطلقة(0 - 100))

    # === القسم 2: المقارنات ===
    عرض_قسم("أكبر وأصغر عدد")
    اطبع("  أكبر(15, 27) = ")
    اطبع_سطر(أكبر_عددين(15، 27))
    اطبع("  أصغر(15, 27) = ")
    اطبع_سطر(أصغر_عددين(15، 27))
    اطبع("  أكبر(100, 100) = ")
    اطبع_سطر(أكبر_عددين(100، 100))
    اطبع("  أكبر(10, 20, 15) = ")
    اطبع_سطر(أكبر_ثلاثة(10، 20، 15))
    اطبع("  أصغر(10, 20, 15) = ")
    اطبع_سطر(أصغر_ثلاثة(10، 20، 15))

    # === القسم 3: القسمة الآمنة ===
    عرض_قسم("القسمة الآمنة")
    اطبع("  100 / 4 = ")
    اطبع_سطر(قسمة(100، 4))
    اطبع("  99 / 3 = ")
    اطبع_سطر(قسمة(99، 3))
    اطبع("  50 / 0 = ")
    اطبع_سطر(قسمة(50، 0))
    اطبع("  1000 / 7 = ")
    اطبع_سطر(قسمة(1000، 7))

    # === القسم 4: القوى ===
    عرض_قسم("جدول القوى")
    متغير قاعدة = 2
    بينما (قاعدة <= 5)
        اطبع("  ")
        اطبع(قاعدة)
        اطبع("^0=")
        اطبع(قوة(قاعدة، 0))
        اطبع("  ")
        اطبع(قاعدة)
        اطبع("^1=")
        اطبع(قوة(قاعدة، 1))
        اطبع("  ")
        اطبع(قاعدة)
        اطبع("^2=")
        اطبع(قوة(قاعدة، 2))
        اطبع("  ")
        اطبع(قاعدة)
        اطبع("^3=")
        اطبع(قوة(قاعدة، 3))
        اطبع("  ")
        اطبع(قاعدة)
        اطبع("^4=")
        اطبع_سطر(قوة(قاعدة، 4))
        قاعدة = قاعدة + 1
    نهاية

    # === القسم 5: المضروب ===
    عرض_قسم("جدول المضروب")
    متغير عد_م = 0
    بينما (عد_م <= 10)
        اطبع("  ")
        اطبع(عد_م)
        اطبع("! = ")
        اطبع_سطر(مضروب(عد_م))
        عد_م = عد_م + 1
    نهاية

    # === القسم 6: القاسم المشترك الأكبر ===
    عرض_قسم("القاسم المشترك الأكبر (GCD)")
    اطبع("  GCD(12, 8) = ")
    اطبع_سطر(القاسم_المشترك(12، 8))
    اطبع("  GCD(100, 75) = ")
    اطبع_سطر(القاسم_المشترك(100، 75))
    اطبع("  GCD(48, 18) = ")
    اطبع_سطر(القاسم_المشترك(48، 18))
    اطبع("  GCD(35, 14) = ")
    اطبع_سطر(القاسم_المشترك(35، 14))

    # === القسم 7: تصنيف الأعداد ===
    عرض_قسم("تصنيف الأعداد")
    تصنيف_عدد(42)
    تصنيف_عدد(0)
    تصنيف_عدد(7)
    تصنيف_عدد(100)
    تصنيف_عدد(33)

    # === القسم 8: جدول الضرب ===
    عرض_قسم("جدول ضرب 7")
    متغير ض = 1
    بينما (ض <= 12)
        اطبع("  7 × ")
        اطبع(ض)
        اطبع(" = ")
        اطبع_سطر(7 * ض)
        ض = ض + 1
    نهاية

    # === الختام ===
    اطبع_سطر("")
    خط()
    اطبع_سطر("  ✓ جميع الحسابات تمت بنجاح")
    اطبع_سطر("  ✓ التحقق من الحالات الحدية نجح")
    اطبع_سطر("  ✓ معالجة الأخطاء (القسمة على صفر) تعمل")
    اطبع_سطر("  ✓ الدوال العودية تعمل بشكل صحيح")
    خط()
    اطبع_سطر("")
    اطبع_سطر("=== اكتمل اختبار رسائل الخطأ المتوسط 2 ===")
    ارجع 0
نهاية
