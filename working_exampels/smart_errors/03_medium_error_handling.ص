# ═══════════════════════════════════════════════════════
# دوال التحقق من الصحة (Validation Functions)
# ═══════════════════════════════════════════════════════

دالة منطقي هل_موجب(رقم قيمة)
    إذا (قيمة > 0)
        ارجع صحيح
    نهاية
    ارجع خطأ
نهاية

دالة منطقي هل_زوجي(رقم قيمة)
    إذا (قيمة - (قيمة / 2) * 2 == 0)
        ارجع صحيح
    نهاية
    ارجع خطأ
نهاية

دالة منطقي هل_في_نطاق(رقم قيمة، رقم حد_ادنى، رقم حد_اقصى)
    إذا (قيمة >= حد_ادنى)
        إذا (قيمة <= حد_اقصى)
            ارجع صحيح
        نهاية
    نهاية
    ارجع خطأ
نهاية

# ═══════════════════════════════════════════════════════
# دوال المعالجة
# ═══════════════════════════════════════════════════════

دالة تحقق_درجة(نص اسم_مادة، رقم درجة)
    اطبع("  ")
    اطبع(اسم_مادة)
    اطبع(": ")
    اطبع(درجة)

    إذا (هل_في_نطاق(درجة، 0، 100))
        اطبع(" ✓")
        # تقييم الدرجة
        طابق درجة
            حالة 100:
                اطبع_سطر(" (ممتاز مع مرتبة الشرف)")
            حالة 95:
                اطبع_سطر(" (ممتاز)")
            حالة 90:
                اطبع_سطر(" (جيد جداً عالي)")
            حالة 85:
                اطبع_سطر(" (جيد جداً)")
            حالة 80:
                اطبع_سطر(" (جيد)")
            حالة 75:
                اطبع_سطر(" (مقبول)")
            حالة _:
                اطبع_سطر(" (درجة صالحة)")
        نهاية
    وإلا
        اطبع_سطر(" ✗ خطأ: الدرجة خارج النطاق (0-100)")
    نهاية
نهاية

دالة تحقق_عمر(نص اسم، رقم عمر)
    اطبع("  ")
    اطبع(اسم)
    اطبع(" (العمر: ")
    اطبع(عمر)
    اطبع(")")

    إذا (هل_في_نطاق(عمر، 0، 150))
        إذا (عمر < 6)
            اطبع_سطر(" - طفل صغير")
        نهاية
        إذا (عمر >= 6)
            إذا (عمر < 18)
                اطبع_سطر(" - طالب")
            نهاية
        نهاية
        إذا (عمر >= 18)
            اطبع_سطر(" - بالغ")
        نهاية
    وإلا
        اطبع_سطر(" - عمر غير صالح!")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# دوال الحساب مع التحقق
# ═══════════════════════════════════════════════════════

دالة رقم قسمة_آمنة(رقم بسط، رقم مقام)
    إذا (مقام == 0)
        اطبع_سطر("  ⚠ تحذير: القسمة على صفر!")
        ارجع 0
    نهاية
    ارجع بسط / مقام
نهاية

دالة رقم مضروب_آمن(رقم ن)
    إذا (ن < 0)
        اطبع_سطر("  ⚠ تحذير: لا يمكن حساب مضروب عدد سالب!")
        ارجع 0
    نهاية
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب_آمن(ن - 1)
نهاية

