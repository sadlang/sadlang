دالة خط()
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔═══════════════════════════════════════════╗")
    اطبع_سطر("║  نظام معالجة الأخطاء والتحقق من الصحة     ║")
    اطبع_سطر("║  Smart Error Messages - Test              ║")
    اطبع_سطر("╚═══════════════════════════════════════════╝")

    # === القسم 1: التحقق من الدرجات ===
    اطبع_سطر("")
    خط()
    اطبع_سطر("  التحقق من الدرجات")
    خط()

    تحقق_درجة("الرياضيات"، 95)
    تحقق_درجة("العربي"، 100)
    تحقق_درجة("العلوم"، 85)
    تحقق_درجة("الحاسوب"، 80)
    تحقق_درجة("الإسلامية"، 75)

    # === القسم 2: التحقق من الأعمار ===
    اطبع_سطر("")
    خط()
    اطبع_سطر("  التحقق من الأعمار")
    خط()

    تحقق_عمر("أحمد"، 25)
    تحقق_عمر("سارة"، 15)
    تحقق_عمر("محمد"، 4)
    تحقق_عمر("خالد"، 45)

    # === القسم 3: القسمة الآمنة ===
    اطبع_سطر("")
    خط()
    اطبع_سطر("  القسمة الآمنة")
    خط()

    اطبع("  100 ÷ 5 = ")
    اطبع_سطر(قسمة_آمنة(100، 5))

    اطبع("  42 ÷ 7 = ")
    اطبع_سطر(قسمة_آمنة(42، 7))

    اطبع("  10 ÷ 0 = ")
    اطبع_سطر(قسمة_آمنة(10، 0))

    اطبع("  99 ÷ 3 = ")
    اطبع_سطر(قسمة_آمنة(99، 3))

    # === القسم 4: المضروب الآمن ===
    اطبع_سطر("")
    خط()
    اطبع_سطر("  المضروب الآمن")
    خط()

    متغير ن = 1
    بينما (ن <= 8)
        اطبع("  ")
        اطبع(ن)
        اطبع("! = ")
        اطبع_سطر(مضروب_آمن(ن))
        ن = ن + 1
    نهاية

    # === القسم 5: التحقق من الأعداد ===
    اطبع_سطر("")
    خط()
    اطبع_سطر("  تحقق من خصائص الأعداد")
    خط()

    متغير ع = 1
    بينما (ع <= 10)
        اطبع("  العدد ")
        اطبع(ع)
        اطبع(": ")

        إذا (هل_موجب(ع))
            اطبع("موجب")
        وإلا
            اطبع("غير موجب")
        نهاية

        إذا (هل_زوجي(ع))
            اطبع("، زوجي")
        وإلا
            اطبع("، فردي")
        نهاية

        اطبع_سطر("")
        ع = ع + 1
    نهاية

    # === الختام ===
    اطبع_سطر("")
    خط()
    اطبع_سطر("  ✓ جميع عمليات التحقق تمت بنجاح!")
    اطبع_سطر("  ✓ رسائل الخطأ واضحة ومفيدة")
    اطبع_سطر("  ✓ الدوال تتعامل مع الحالات الحدية")
    خط()
    اطبع_سطر("")
    اطبع_سطر("=== اكتمل اختبار رسائل الخطأ المتوسط 1 ===")
    ارجع 0
نهاية
