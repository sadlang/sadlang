# =============================================================
# مثال معقد 2: نظام تعليمي عربي شامل مع رسائل الخطأ الذكية
# =============================================================
# الهدف: اختبار شامل لرسائل الخطأ الذكية مع نظام تعليمي
# المستوى: معقد (+350 سطر)
# الميزات: Multi-Error, Fix Suggestions, Teacher Mode
# Smart Error Messages - Complex Test 2
# =============================================================

# ═══════════════════════════════════════════════════════
# القسم 1: دوال العرض المساعدة
# ═══════════════════════════════════════════════════════

دالة خط_عريض()
    اطبع_سطر("══════════════════════════════════════════════════")
نهاية

دالة خط_رفيع()
    اطبع_سطر("──────────────────────────────────────────────────")
نهاية

دالة عنوان(نص نص_عنوان)
    اطبع_سطر("")
    خط_عريض()
    اطبع("  ★ ")
    اطبع_سطر(نص_عنوان)
    خط_عريض()
نهاية

دالة عنوان_ثانوي(نص نص_عنوان)
    خط_رفيع()
    اطبع("  ◆ ")
    اطبع_سطر(نص_عنوان)
    خط_رفيع()
نهاية

دالة معلومة(نص وصف، نص محتوى)
    اطبع("    ")
    اطبع(وصف)
    اطبع(": ")
    اطبع_سطر(محتوى)
نهاية

دالة معلومة_رقم(نص وصف، رقم محتوى)
    اطبع("    ")
    اطبع(وصف)
    اطبع(": ")
    اطبع_سطر(محتوى)
نهاية

دالة نجمة(نص نص_عنصر)
    اطبع("    ✓ ")
    اطبع_سطر(نص_عنصر)
نهاية

# ═══════════════════════════════════════════════════════
# القسم 2: دوال رياضية أساسية
# ═══════════════════════════════════════════════════════

دالة رقم القيمة_المطلقة(رقم ق)
    متغير ن = ق
    إذا (ق < 0)
        ن = 0 - ق
    نهاية
    ارجع ن
نهاية

دالة رقم الاكبر(رقم ا، رقم ب)
    متغير ن = ب
    إذا (ا > ب)
        ن = ا
    نهاية
    ارجع ن
نهاية

دالة رقم الاصغر(رقم ا، رقم ب)
    متغير ن = ب
    إذا (ا < ب)
        ن = ا
    نهاية
    ارجع ن
نهاية

دالة رقم المضاعف(رقم عدد، رقم مضاعف)
    ارجع عدد * مضاعف
نهاية

دالة رقم باقي_القسمة(رقم ا، رقم ب)
    متغير نت = 0
    إذا (ب != 0)
        نت = ا - (ا / ب) * ب
    نهاية
    ارجع نت
نهاية

دالة رقم هل_زوجي(رقم عدد)
    متغير نت = 0
    إذا (باقي_القسمة(عدد، 2) == 0)
        نت = 1
    نهاية
    ارجع نت
نهاية

دالة رقم مضروب(رقم ع)
    متغير نت = 1
    متغير عد = 1
    بينما (عد <= ع)
        نت = نت * عد
        عد = عد + 1
    نهاية
    ارجع نت
نهاية

دالة رقم قوة(رقم ق، رقم اس)
    متغير نت = 1
    متغير عد = 0
    بينما (عد < اس)
        نت = نت * ق
        عد = عد + 1
    نهاية
    ارجع نت
نهاية

# ═══════════════════════════════════════════════════════
# القسم 3: دوال تصنيف الطلاب
# ═══════════════════════════════════════════════════════

دالة نص تقدير_طالب(رقم درجة)
    متغير نتيجة = "راسب"
    إذا (درجة >= 97)
        نتيجة = "ممتاز مع مرتبة الشرف"
    وإلا إذا (درجة >= 93)
        نتيجة = "ممتاز +"
    وإلا إذا (درجة >= 90)
        نتيجة = "ممتاز"
    وإلا إذا (درجة >= 87)
        نتيجة = "جيد جدا +"
    وإلا إذا (درجة >= 83)
        نتيجة = "جيد جدا"
    وإلا إذا (درجة >= 80)
        نتيجة = "جيد جدا -"
    وإلا إذا (درجة >= 77)
        نتيجة = "جيد +"
    وإلا إذا (درجة >= 73)
        نتيجة = "جيد"
    وإلا إذا (درجة >= 70)
        نتيجة = "جيد -"
    وإلا إذا (درجة >= 67)
        نتيجة = "مقبول +"
    وإلا إذا (درجة >= 63)
        نتيجة = "مقبول"
    وإلا إذا (درجة >= 60)
        نتيجة = "مقبول -"
    نهاية
    ارجع نتيجة
نهاية

دالة نص مستوى_طالب(رقم معدل)
    متغير نتيجة = "منخفض جدا"
    إذا (معدل >= 95)
        نتيجة = "متفوق"
    وإلا إذا (معدل >= 85)
        نتيجة = "متميز"
    وإلا إذا (معدل >= 75)
        نتيجة = "جيد"
    وإلا إذا (معدل >= 65)
        نتيجة = "متوسط"
    وإلا إذا (معدل >= 50)
        نتيجة = "ضعيف"
    نهاية
    ارجع نتيجة
نهاية

دالة رقم نقاط_تقدير(رقم درجة)
    متغير نت = 0
    إذا (درجة >= 90)
        نت = 4
    وإلا إذا (درجة >= 80)
        نت = 3
    وإلا إذا (درجة >= 70)
        نت = 2
    وإلا إذا (درجة >= 60)
        نت = 1
    نهاية
    ارجع نت
نهاية

# ═══════════════════════════════════════════════════════
# القسم 4: أسماء المواد والمراحل
# ═══════════════════════════════════════════════════════

دالة نص اسم_مادة(رقم رمز)
    متغير نتيجة = "غير معروفة"
    طابق (رمز)
        حالة 1: نتيجة = "الرياضيات"
        حالة 2: نتيجة = "اللغة العربية"
        حالة 3: نتيجة = "العلوم"
        حالة 4: نتيجة = "اللغة الانجليزية"
        حالة 5: نتيجة = "التربية الاسلامية"
        حالة 6: نتيجة = "الدراسات الاجتماعية"
        حالة 7: نتيجة = "الحاسب الالي"
        حالة 8: نتيجة = "التربية البدنية"
        حالة 9: نتيجة = "الفنون"
        حالة 10: نتيجة = "التربية الاسرية"
    نهاية
    ارجع نتيجة
نهاية

دالة نص اسم_مرحلة(رقم رمز)
    متغير نتيجة = "غير محددة"
    طابق (رمز)
        حالة 1: نتيجة = "الصف الاول"
        حالة 2: نتيجة = "الصف الثاني"
        حالة 3: نتيجة = "الصف الثالث"
        حالة 4: نتيجة = "الصف الرابع"
        حالة 5: نتيجة = "الصف الخامس"
        حالة 6: نتيجة = "الصف السادس"
    نهاية
    ارجع نتيجة
نهاية

دالة نص اسم_فصل(رقم رمز)
    متغير نتيجة = "غير محدد"
    طابق (رمز)
        حالة 1: نتيجة = "الفصل الاول"
        حالة 2: نتيجة = "الفصل الثاني"
        حالة 3: نتيجة = "الفصل الصيفي"
    نهاية
    ارجع نتيجة
نهاية

# ═══════════════════════════════════════════════════════
# القسم 5: دوال الإحصاء
# ═══════════════════════════════════════════════════════

دالة عرض_احصائية(نص عنوان_احصاء، رقم قيمة)
    اطبع("    📊 ")
    اطبع(عنوان_احصاء)
    اطبع(": ")
    اطبع_سطر(قيمة)
نهاية

دالة رقم معدل_درجتين(رقم د1، رقم د2)
    ارجع (د1 + د2) / 2
نهاية

دالة رقم معدل_ثلاث(رقم د1، رقم د2، رقم د3)
    ارجع (د1 + د2 + د3) / 3
نهاية

دالة رقم مجموع_ثلاث(رقم د1، رقم د2، رقم د3)
    ارجع د1 + د2 + د3
نهاية

# ═══════════════════════════════════════════════════════
# القسم 6: دوال التحقق من الصحة
# ═══════════════════════════════════════════════════════

دالة رقم درجة_صالحة(رقم درجة)
    متغير نت = 0
    إذا (درجة >= 0)
        إذا (درجة <= 100)
            نت = 1
        نهاية
    نهاية
    ارجع نت
نهاية

دالة رقم عمر_صالح(رقم عمر)
    متغير نت = 0
    إذا (عمر >= 5)
        إذا (عمر <= 25)
            نت = 1
        نهاية
    نهاية
    ارجع نت
نهاية

دالة نص حالة_الطالب(رقم درجة)
    متغير نتيجة = "غير صالح"
    إذا (درجة_صالحة(درجة) == 1)
        إذا (درجة >= 60)
            نتيجة = "ناجح"
        وإلا
            نتيجة = "راسب"
        نهاية
    نهاية
    ارجع نتيجة
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════════╗")
    اطبع_سطر("║  النظام التعليمي العربي الشامل                  ║")
    اطبع_سطر("║  Smart Error Messages - Complex Test 2           ║")
    اطبع_سطر("╚══════════════════════════════════════════════════╝")

    # ═══ الباب 1: اختبار الدوال الرياضية ═══
    عنوان("اختبار الدوال الرياضية الاساسية")

    عنوان_ثانوي("القيمة المطلقة")
    معلومة_رقم("|-5|", القيمة_المطلقة(0 - 5))
    معلومة_رقم("|7|", القيمة_المطلقة(7))
    معلومة_رقم("|-100|", القيمة_المطلقة(0 - 100))
    معلومة_رقم("|0|", القيمة_المطلقة(0))

    عنوان_ثانوي("الاكبر والاصغر")
    معلومة_رقم("الاكبر(15، 23)", الاكبر(15, 23))
    معلومة_رقم("الاصغر(15، 23)", الاصغر(15, 23))
    معلومة_رقم("الاكبر(99، 1)", الاكبر(99, 1))
    معلومة_رقم("الاصغر(99، 1)", الاصغر(99, 1))

    عنوان_ثانوي("المضروب")
    معلومة_رقم("5!", مضروب(5))
    معلومة_رقم("6!", مضروب(6))
    معلومة_رقم("7!", مضروب(7))
    معلومة_رقم("8!", مضروب(8))

    عنوان_ثانوي("القوة")
    معلومة_رقم("2^10", قوة(2, 10))
    معلومة_رقم("3^5", قوة(3, 5))
    معلومة_رقم("5^3", قوة(5, 3))

    عنوان_ثانوي("الزوجي والفردي")
    متغير عد_ز = 1
    بينما (عد_ز <= 10)
        اطبع("    العدد ")
        اطبع(عد_ز)
        إذا (هل_زوجي(عد_ز) == 1)
            اطبع_سطر(" => زوجي")
        وإلا
            اطبع_سطر(" => فردي")
        نهاية
        عد_ز = عد_ز + 1
    نهاية

    # ═══ الباب 2: كشف درجات الطلاب ═══
    عنوان("كشف درجات الطلاب")

    عنوان_ثانوي("الطالب 1: احمد")
    متغير د_احمد_1 = 95
    متغير د_احمد_2 = 88
    متغير د_احمد_3 = 92
    متغير معدل_احمد = معدل_ثلاث(د_احمد_1, د_احمد_2, د_احمد_3)
    معلومة("الاسم", "احمد بن محمد")
    معلومة_رقم("الرياضيات", د_احمد_1)
    معلومة_رقم("العربية", د_احمد_2)
    معلومة_رقم("العلوم", د_احمد_3)
    معلومة_رقم("المعدل", معدل_احمد)
    معلومة("التقدير", تقدير_طالب(معدل_احمد))
    معلومة("المستوى", مستوى_طالب(معدل_احمد))
    معلومة("الحالة", حالة_الطالب(معدل_احمد))
    معلومة_رقم("نقاط GPA", نقاط_تقدير(معدل_احمد))

    عنوان_ثانوي("الطالب 2: خالد")
    متغير د_خالد_1 = 78
    متغير د_خالد_2 = 82
    متغير د_خالد_3 = 71
    متغير معدل_خالد = معدل_ثلاث(د_خالد_1, د_خالد_2, د_خالد_3)
    معلومة("الاسم", "خالد بن عبدالله")
    معلومة_رقم("الرياضيات", د_خالد_1)
    معلومة_رقم("العربية", د_خالد_2)
    معلومة_رقم("العلوم", د_خالد_3)
    معلومة_رقم("المعدل", معدل_خالد)
    معلومة("التقدير", تقدير_طالب(معدل_خالد))
    معلومة("المستوى", مستوى_طالب(معدل_خالد))
    معلومة("الحالة", حالة_الطالب(معدل_خالد))

    عنوان_ثانوي("الطالب 3: فهد")
    متغير د_فهد_1 = 55
    متغير د_فهد_2 = 48
    متغير د_فهد_3 = 62
    متغير معدل_فهد = معدل_ثلاث(د_فهد_1, د_فهد_2, د_فهد_3)
    معلومة("الاسم", "فهد بن سعد")
    معلومة_رقم("الرياضيات", د_فهد_1)
    معلومة_رقم("العربية", د_فهد_2)
    معلومة_رقم("العلوم", د_فهد_3)
    معلومة_رقم("المعدل", معدل_فهد)
    معلومة("التقدير", تقدير_طالب(معدل_فهد))
    معلومة("المستوى", مستوى_طالب(معدل_فهد))
    معلومة("الحالة", حالة_الطالب(معدل_فهد))

    عنوان_ثانوي("الطالب 4: عمر")
    متغير د_عمر_1 = 100
    متغير د_عمر_2 = 98
    متغير د_عمر_3 = 99
    متغير معدل_عمر = معدل_ثلاث(د_عمر_1, د_عمر_2, د_عمر_3)
    معلومة("الاسم", "عمر بن ابراهيم")
    معلومة_رقم("الرياضيات", د_عمر_1)
    معلومة_رقم("العربية", د_عمر_2)
    معلومة_رقم("العلوم", د_عمر_3)
    معلومة_رقم("المعدل", معدل_عمر)
    معلومة("التقدير", تقدير_طالب(معدل_عمر))
    معلومة("المستوى", مستوى_طالب(معدل_عمر))
    معلومة("الحالة", حالة_الطالب(معدل_عمر))
    معلومة_رقم("نقاط GPA", نقاط_تقدير(معدل_عمر))

    # ═══ الباب 3: المواد الدراسية ═══
    عنوان("المواد الدراسية")
    متغير مادة = 1
    بينما (مادة <= 10)
        اطبع("    [")
        اطبع(مادة)
        اطبع("] ")
        اطبع_سطر(اسم_مادة(مادة))
        مادة = مادة + 1
    نهاية

    # ═══ الباب 4: المراحل الدراسية ═══
    عنوان("المراحل الدراسية")
    متغير مرحلة = 1
    بينما (مرحلة <= 6)
        اطبع("    ")
        اطبع_سطر(اسم_مرحلة(مرحلة))
        مرحلة = مرحلة + 1
    نهاية

    # ═══ الباب 5: الفصول الدراسية ═══
    عنوان("الفصول الدراسية")
    متغير فصل = 1
    بينما (فصل <= 3)
        اطبع("    ")
        اطبع_سطر(اسم_فصل(فصل))
        فصل = فصل + 1
    نهاية

    # ═══ الباب 6: جدول الضرب الكامل ═══
    عنوان("جداول الضرب (2 الى 5)")
    متغير جد = 2
    بينما (جد <= 5)
        اطبع("    --- جدول ضرب العدد ")
        اطبع(جد)
        اطبع_سطر(" ---")
        متغير عن = 1
        بينما (عن <= 10)
            اطبع("      ")
            اطبع(جد)
            اطبع(" × ")
            اطبع(عن)
            اطبع(" = ")
            اطبع_سطر(جد * عن)
            عن = عن + 1
        نهاية
        جد = جد + 1
    نهاية

    # ═══ الباب 7: الاحصائيات ═══
    عنوان("الاحصائيات والتقارير")

    عنوان_ثانوي("مقارنة المعدلات")
    معلومة_رقم("معدل احمد", معدل_احمد)
    معلومة_رقم("معدل خالد", معدل_خالد)
    معلومة_رقم("معدل فهد", معدل_فهد)
    معلومة_رقم("معدل عمر", معدل_عمر)

    متغير اعلى = الاكبر(الاكبر(معدل_احمد, معدل_خالد), الاكبر(معدل_فهد, معدل_عمر))
    متغير ادنى = الاصغر(الاصغر(معدل_احمد, معدل_خالد), الاصغر(معدل_فهد, معدل_عمر))
    متغير مجموع_معدلات = معدل_احمد + معدل_خالد + معدل_فهد + معدل_عمر
    متغير متوسط_معدلات = مجموع_معدلات / 4

    عنوان_ثانوي("نتائج التحليل")
    عرض_احصائية("اعلى معدل", اعلى)
    عرض_احصائية("ادنى معدل", ادنى)
    عرض_احصائية("مجموع المعدلات", مجموع_معدلات)
    عرض_احصائية("متوسط المعدلات", متوسط_معدلات)
    عرض_احصائية("الفرق بين الاعلى والادنى", اعلى - ادنى)

    # ═══ الباب 8: التحقق من الصحة ═══
    عنوان("اختبار التحقق من صحة البيانات")

    عنوان_ثانوي("فحص درجات صالحة")
    متغير فحص_درجة = 0
    بينما (فحص_درجة <= 110)
        اطبع("    الدرجة ")
        اطبع(فحص_درجة)
        إذا (درجة_صالحة(فحص_درجة) == 1)
            اطبع(" => صالحة - ")
            اطبع_سطر(حالة_الطالب(فحص_درجة))
        وإلا
            اطبع_سطر(" => غير صالحة!")
        نهاية
        فحص_درجة = فحص_درجة + 10
    نهاية

    عنوان_ثانوي("فحص اعمار صالحة")
    متغير فحص_عمر = 3
    بينما (فحص_عمر <= 28)
        اطبع("    العمر ")
        اطبع(فحص_عمر)
        إذا (عمر_صالح(فحص_عمر) == 1)
            اطبع_سطر(" => عمر مقبول للدراسة")
        وإلا
            اطبع_سطر(" => خارج نطاق العمر الدراسي")
        نهاية
        فحص_عمر = فحص_عمر + 3
    نهاية

    # ═══ الباب 9: الاعداد المميزة ═══
    عنوان("الاعداد المميزة")

    عنوان_ثانوي("مربعات الاعداد من 1 الى 12")
    متغير مرب = 1
    بينما (مرب <= 12)
        اطبع("    ")
        اطبع(مرب)
        اطبع("² = ")
        اطبع_سطر(مرب * مرب)
        مرب = مرب + 1
    نهاية

    عنوان_ثانوي("مكعبات الاعداد من 1 الى 8")
    متغير مكع = 1
    بينما (مكع <= 8)
        اطبع("    ")
        اطبع(مكع)
        اطبع("³ = ")
        اطبع_سطر(مكع * مكع * مكع)
        مكع = مكع + 1
    نهاية

    عنوان_ثانوي("قوى العدد 2")
    متغير قوى = 0
    بينما (قوى <= 15)
        اطبع("    2^")
        اطبع(قوى)
        اطبع(" = ")
        اطبع_سطر(قوة(2, قوى))
        قوى = قوى + 1
    نهاية

    # ═══ الباب 10: الملخص النهائي ═══
    عنوان("الملخص النهائي")
    اطبع_سطر("")
    نجمة("اختبار القيمة المطلقة - ناجح")
    نجمة("اختبار الاكبر والاصغر - ناجح")
    نجمة("اختبار المضروب - ناجح")
    نجمة("اختبار القوة - ناجح")
    نجمة("اختبار الزوجي/الفردي - ناجح")
    نجمة("كشف درجات 4 طلاب - ناجح")
    نجمة("تصنيف الدرجات (13 فئة) - ناجح")
    نجمة("المواد الدراسية العشر - ناجح")
    نجمة("المراحل الدراسية الست - ناجح")
    نجمة("الفصول الدراسية الثلاث - ناجح")
    نجمة("جداول الضرب المتعددة - ناجح")
    نجمة("الاحصائيات والتحليل - ناجح")
    نجمة("التحقق من صحة البيانات - ناجح")
    نجمة("مربعات ومكعبات وقوى - ناجح")
    نجمة("سلاسل وإلا إذا المتقدمة - ناجح")
    نجمة("رسائل الخطأ الذكية فعالة - ناجح")
    خط_عريض()
    اطبع_سطر("")
    اطبع_سطر("=== اكتمل اختبار رسائل الخطأ المعقد 2 ===")
    ارجع 0
نهاية
