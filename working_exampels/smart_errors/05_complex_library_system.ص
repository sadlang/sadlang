# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════════╗")
    اطبع_سطر("║  نظام المعلومات العربي الشامل                   ║")
    اطبع_سطر("║  Smart Error Messages - Complex Test 1           ║")
    اطبع_سطر("╚══════════════════════════════════════════════════╝")

    # === الباب 1: الدول العربية ===
    عنوان_رئيسي("دليل الدول العربية وعواصمها")
    متغير دولة = 1
    بينما (دولة <= 12)
        عرض_دولة(دولة)
        دولة = دولة + 1
    نهاية

    # === الباب 2: الاشهر الميلادية ===
    عنوان_رئيسي("الاشهر الميلادية والفصول")
    متغير شهر = 1
    بينما (شهر <= 12)
        اطبع("    ")
        اطبع(شهر)
        اطبع(". ")
        اطبع(اسم_شهر_ميلادي(شهر))
        اطبع(" - فصل ")
        اطبع_سطر(فصل_الشهر(شهر))
        شهر = شهر + 1
    نهاية

    # === الباب 3: الاشهر الهجرية ===
    عنوان_رئيسي("الاشهر الهجرية")
    متغير هش = 1
    بينما (هش <= 12)
        اطبع("    ")
        اطبع(هش)
        اطبع(". ")
        اطبع_سطر(اسم_شهر_هجري(هش))
        هش = هش + 1
    نهاية

    # === الباب 4: كواكب النظام الشمسي ===
    عنوان_رئيسي("كواكب النظام الشمسي")
    متغير كوكب = 1
    بينما (كوكب <= 8)
        اطبع("    ")
        اطبع(كوكب)
        اطبع(". ")
        اطبع(اسم_كوكب(كوكب))
        اطبع(" [")
        اطبع(نوع_كوكب(كوكب))
        اطبع_سطر("]")
        كوكب = كوكب + 1
    نهاية

    # === الباب 5: ايام الاسبوع ===
    عنوان_رئيسي("ايام الاسبوع")
    متغير يوم_ا = 1
    بينما (يوم_ا <= 7)
        اطبع("    ")
        اطبع(اسم_يوم(يوم_ا))
        اطبع(" - ")
        اطبع_سطر(حالة_يوم(يوم_ا))
        يوم_ا = يوم_ا + 1
    نهاية

    # === الباب 6: تصنيف الاعمار ===
    عنوان_رئيسي("تصنيف الاعمار")
    سطر_معلومة("عمر 1", تصنيف_عمر(1))
    سطر_معلومة("عمر 5", تصنيف_عمر(5))
    سطر_معلومة("عمر 10", تصنيف_عمر(10))
    سطر_معلومة("عمر 15", تصنيف_عمر(15))
    سطر_معلومة("عمر 25", تصنيف_عمر(25))
    سطر_معلومة("عمر 35", تصنيف_عمر(35))
    سطر_معلومة("عمر 55", تصنيف_عمر(55))
    سطر_معلومة("عمر 75", تصنيف_عمر(75))

    # === الباب 7: تصنيف الدرجات ===
    عنوان_رئيسي("تصنيف الدرجات الدراسية")
    سطر_معلومة("درجة 0", تصنيف_درجة(0))
    سطر_معلومة("درجة 55", تصنيف_درجة(55))
    سطر_معلومة("درجة 65", تصنيف_درجة(65))
    سطر_معلومة("درجة 75", تصنيف_درجة(75))
    سطر_معلومة("درجة 85", تصنيف_درجة(85))
    سطر_معلومة("درجة 95", تصنيف_درجة(95))
    سطر_معلومة("درجة 100", تصنيف_درجة(100))

    # === الباب 8: حالة الطقس ===
    عنوان_رئيسي("تصنيف درجات الحرارة")
    سطر_معلومة("-5 درجة", تصنيف_حرارة(0 - 5))
    سطر_معلومة("0 درجة", تصنيف_حرارة(0))
    سطر_معلومة("5 درجات", تصنيف_حرارة(5))
    سطر_معلومة("15 درجة", تصنيف_حرارة(15))
    سطر_معلومة("25 درجة", تصنيف_حرارة(25))
    سطر_معلومة("35 درجة", تصنيف_حرارة(35))
    سطر_معلومة("45 درجة", تصنيف_حرارة(45))

    # === الباب 9: تصنيف الاوزان ===
    عنوان_رئيسي("تصنيف الاوزان")
    سطر_معلومة("30 كغ", تصنيف_وزن(30))
    سطر_معلومة("50 كغ", تصنيف_وزن(50))
    سطر_معلومة("65 كغ", تصنيف_وزن(65))
    سطر_معلومة("80 كغ", تصنيف_وزن(80))
    سطر_معلومة("100 كغ", تصنيف_وزن(100))
    سطر_معلومة("120 كغ", تصنيف_وزن(120))

    # === الباب 10: علماء العرب ===
    عنوان_رئيسي("علماء العرب وتخصصاتهم")
    متغير عالم = 1
    بينما (عالم <= 8)
        اطبع("    ")
        اطبع(عالم)
        اطبع(". ")
        اطبع(اسم_عالم(عالم))
        اطبع(" - ")
        اطبع_سطر(تخصص_عالم(عالم))
        عالم = عالم + 1
    نهاية

    # === الباب 11: جدول ضرب ===
    عنوان_رئيسي("جدول ضرب العدد 8")
    متغير جض = 1
    بينما (جض <= 12)
        اطبع("    8 x ")
        اطبع(جض)
        اطبع(" = ")
        اطبع_سطر(8 * جض)
        جض = جض + 1
    نهاية

    # === الباب 12: العد التنازلي ===
    عنوان_رئيسي("العد التنازلي")
    متغير عد = 10
    بينما (عد >= 0)
        اطبع("    ")
        اطبع(عد)
        إذا (عد == 0)
            اطبع_سطر("... انطلاق!")
        وإلا
            اطبع_سطر("...")
        نهاية
        عد = عد - 1
    نهاية

    # === الباب 13: الملخص ===
    عنوان_رئيسي("ملخص الاختبارات")
    اطبع_سطر("    ✓ قاموس 12 دولة عربية وعواصمها")
    اطبع_سطر("    ✓ الاشهر الميلادية مع الفصول")
    اطبع_سطر("    ✓ الاشهر الهجرية الـ12")
    اطبع_سطر("    ✓ كواكب النظام الشمسي الـ8")
    اطبع_سطر("    ✓ ايام الاسبوع مع حالة العمل")
    اطبع_سطر("    ✓ تصنيف الاعمار (8 فئات)")
    اطبع_سطر("    ✓ تصنيف الدرجات الدراسية")
    اطبع_سطر("    ✓ تصنيف درجات الحرارة")
    اطبع_سطر("    ✓ تصنيف الاوزان")
    اطبع_سطر("    ✓ علماء العرب الـ8 وتخصصاتهم")
    اطبع_سطر("    ✓ جدول الضرب")
    اطبع_سطر("    ✓ العد التنازلي مع وإلا")
    اطبع_سطر("    ✓ مطابقة الانماط (طابق/حالة)")
    اطبع_سطر("    ✓ سلاسل وإلا إذا المتقدمة")
    اطبع_سطر("    ✓ رسائل الخطأ الذكية فعالة")
    خط_مزدوج()
    اطبع_سطر("")
    اطبع_سطر("=== اكتمل اختبار رسائل الخطأ المعقد 1 ===")
    ارجع 0
نهاية
