# مثال 02: قواعد الاستعارة
# محاكاة نظام الاستعارة والملكية
# المستوى: بسيط
# ==============================================

# ---- نظام تتبع المراجع ----

دالة عرض_مالك(نص اسم، نص قيمة)
    اطبع_سطر("  [مالك] " + اسم + " = " + قيمة)
نهاية

دالة عرض_استعارة_قراءة(نص مرجع، نص مالك)
    اطبع_سطر("  [قراءة] " + مرجع + " يقرأ من " + مالك)
نهاية

دالة عرض_استعارة_تعديل(نص مرجع، نص مالك)
    اطبع_سطر("  [تعديل] " + مرجع + " يعدّل " + مالك)
نهاية

دالة عرض_تحرير(نص اسم)
    اطبع_سطر("  [حرر] " + اسم + " تم تحريره")
نهاية

دالة عرض_خطا(نص رسالة)
    اطبع_سطر("  [خطأ!] " + رسالة)
نهاية

دالة عرض_نجاح(نص رسالة)
    اطبع_سطر("  [نجاح] " + رسالة)
نهاية

# ---- فحص قواعد الاستعارة ----
# نستخدم رقم بدل منطقي (0=مرفوض، 1=مسموح)

دالة رقم فحص_استعارة_قراءة(رقم عدد_قراءة، رقم عدد_تعديل)
    إذا (عدد_تعديل > 0)
        عرض_خطا("لا يمكن الاستعارة للقراءة مع وجود تعديل نشط")
        ارجع 0
    نهاية
    نص ن = "استعارة قراءة #" + لنص(عدد_قراءة + 1) + " مسموحة"
    اطبع_سطر("  " + ن)
    ارجع 1
نهاية

دالة رقم فحص_استعارة_تعديل(رقم عدد_قراءة، رقم عدد_تعديل)
    إذا (عدد_قراءة > 0)
        عرض_خطا("لا يمكن التعديل مع وجود قراءة نشطة")
        ارجع 0
    نهاية
    إذا (عدد_تعديل > 0)
        عرض_خطا("لا يمكن وجود أكثر من تعديل واحد")
        ارجع 0
    نهاية
    اطبع_سطر("  استعارة تعديل مسموحة")
    ارجع 1
نهاية

# ---- مثال 1: استعارات القراءة المتعددة ----

دالة مثال_قراءة_متعددة()
    اطبع_سطر("=== استعارات القراءة المتعددة ===")
    اطبع_سطر("")

    عرض_مالك("بيانات"، "[10، 20، 30]")
    اطبع_سطر("")

    رقم عدد_ق = 0
    رقم عدد_ت = 0

    # استعارة قراءة 1
    رقم نتيجة1 = فحص_استعارة_قراءة(عدد_ق، عدد_ت)
    إذا (نتيجة1 == 1)
        عدد_ق = عدد_ق + 1
        عرض_استعارة_قراءة("مرجع_1"، "بيانات")
    نهاية

    # استعارة قراءة 2
    رقم نتيجة2 = فحص_استعارة_قراءة(عدد_ق، عدد_ت)
    إذا (نتيجة2 == 1)
        عدد_ق = عدد_ق + 1
        عرض_استعارة_قراءة("مرجع_2"، "بيانات")
    نهاية

    # استعارة قراءة 3
    رقم نتيجة3 = فحص_استعارة_قراءة(عدد_ق، عدد_ت)
    إذا (نتيجة3 == 1)
        عدد_ق = عدد_ق + 1
        عرض_استعارة_قراءة("مرجع_3"، "بيانات")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("  إجمالي استعارات القراءة: " + لنص(عدد_ق))

    عرض_تحرير("مرجع_3")
    عرض_تحرير("مرجع_2")
    عرض_تحرير("مرجع_1")
    اطبع_سطر("")
نهاية

# ---- مثال 2: تعارض التعديل والقراءة ----

دالة مثال_تعارض_تعديل()
    اطبع_سطر("=== تعارض التعديل والقراءة ===")
    اطبع_سطر("")

    عرض_مالك("قائمة"، "[أ، ب، ج]")
    اطبع_سطر("")

    رقم ق = 0
    رقم ت = 0

    # محاولة استعارة تعديل
    رقم م = فحص_استعارة_تعديل(ق، ت)
    إذا (م == 1)
        ت = ت + 1
        عرض_استعارة_تعديل("معدّل"، "قائمة")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("  محاولة قراءة أثناء التعديل:")
    فحص_استعارة_قراءة(ق، ت)

    اطبع_سطر("")
    اطبع_سطر("  تحرير التعديل...")
    عرض_تحرير("معدّل")
    ت = ت - 1

    اطبع_سطر("  محاولة قراءة بعد التحرير:")
    رقم ق2 = فحص_استعارة_قراءة(ق، ت)
    إذا (ق2 == 1)
        ق = ق + 1
        عرض_استعارة_قراءة("قارئ"، "قائمة")
    نهاية

    عرض_تحرير("قارئ")
    اطبع_سطر("")
نهاية

# ---- مثال 3: نقل الملكية ----

دالة مثال_نقل_ملكية()
    اطبع_سطر("=== نقل الملكية ===")
    اطبع_سطر("")

    اطبع_سطر("  الخطوة 1: إنشاء مورد")
    عرض_مالك("مورد_أ"، "ملف_بيانات.txt")

    اطبع_سطر("  الخطوة 2: نقل إلى مالك جديد")
    اطبع_سطر("     مورد_أ --> مورد_ب")
    عرض_مالك("مورد_ب"، "ملف_بيانات.txt")
    اطبع_سطر("     مورد_أ أصبح غير صالح!")

    اطبع_سطر("  الخطوة 3: استعارة من المالك الجديد")
    عرض_استعارة_قراءة("قارئ"، "مورد_ب")

    اطبع_سطر("  الخطوة 4: تحرير الكل")
    عرض_تحرير("قارئ")
    عرض_تحرير("مورد_ب")
    اطبع_سطر("")
نهاية

# ---- مثال 4: دورة حياة كاملة ----

دالة مثال_دورة_حياة()
    اطبع_سطر("=== دورة حياة المرجع ===")
    اطبع_سطر("")

    رقم خطوة = 1

    نص خ = لنص(خطوة)
    اطبع_سطر("  " + خ + ". إنشاء الكائن")
    عرض_مالك("كائن"، "{بيانات: 100}")
    خطوة = خطوة + 1

    خ = لنص(خطوة)
    اطبع_سطر("  " + خ + ". استعارة قراءة أولى")
    عرض_استعارة_قراءة("ق1"، "كائن")
    خطوة = خطوة + 1

    خ = لنص(خطوة)
    اطبع_سطر("  " + خ + ". استعارة قراءة ثانية")
    عرض_استعارة_قراءة("ق2"، "كائن")
    خطوة = خطوة + 1

    خ = لنص(خطوة)
    اطبع_سطر("  " + خ + ". تحرير القراءات")
    عرض_تحرير("ق2")
    عرض_تحرير("ق1")
    خطوة = خطوة + 1

    خ = لنص(خطوة)
    اطبع_سطر("  " + خ + ". استعارة تعديل")
    عرض_استعارة_تعديل("معدّل"، "كائن")
    خطوة = خطوة + 1

    خ = لنص(خطوة)
    اطبع_سطر("  " + خ + ". تحرير التعديل")
    عرض_تحرير("معدّل")
    خطوة = خطوة + 1

    خ = لنص(خطوة)
    اطبع_سطر("  " + خ + ". تحرير المالك")
    عرض_تحرير("كائن")
    عرض_نجاح("دورة الحياة اكتملت بنجاح")
    اطبع_سطر("")
نهاية

# ---- ملخص القواعد ----

دالة عرض_قاعدة(نص وصف، رقم مستوفى)
    إذا (مستوفى == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

دالة عرض_ملخص()
    اطبع_سطر("=== ملخص قواعد الاستعارة ===")
    اطبع_سطر("")
    رقم ن = 0

    عرض_قاعدة("مالك واحد في كل وقت"، 1)
    ن = ن + 1

    عرض_قاعدة("عدة قراءات أو تعديل واحد"، 1)
    ن = ن + 1

    عرض_قاعدة("المرجع أقصر عمرا من المالك"، 1)
    ن = ن + 1

    عرض_قاعدة("النقل يبطل المالك الأصلي"، 1)
    ن = ن + 1

    عرض_قاعدة("التحرير التلقائي عند نهاية النطاق"، 1)
    ن = ن + 1

    اطبع_سطر("")
    اطبع_سطر("  النتيجة: " + لنص(ن) + "/5 قواعد")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════╗")
    اطبع_سطر("║  قواعد الاستعارة والملكية        ║")
    اطبع_سطر("╚══════════════════════════════════╝")
    اطبع_سطر("")

    مثال_قراءة_متعددة()
    اطبع_سطر("")
    مثال_تعارض_تعديل()
    اطبع_سطر("")
    مثال_نقل_ملكية()
    اطبع_سطر("")
    مثال_دورة_حياة()
    اطبع_سطر("")
    عرض_ملخص()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى ===")
    ارجع 0
نهاية
