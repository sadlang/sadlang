# ==============================================
# مثال 05: نظام الذاكرة المعقد
# محاكاة مخصص ذاكرة مع تتبع الأعمار والملكية
# المستوى: معقد
# ==============================================

# ---- أدوات عرض ----

دالة عرض_فاصل()
    اطبع_سطر("  ────────────────────────────────")
نهاية

# ---- سجل العمليات ----

دالة سج_تخصيص(رقم معرف، رقم بحجم، نص مالكه)
    نص م = لنص(معرف)
    نص ح = لنص(بحجم)
    اطبع_سطر("  [تخصيص] كتلة #" + م + " (" + ح + " بايت) -> " + مالكه)
نهاية

دالة سج_تحرير_ذ(رقم معرف، رقم بحجم)
    نص م = لنص(معرف)
    نص ح = لنص(بحجم)
    اطبع_سطر("  [تحرير] كتلة #" + م + " (" + ح + " بايت)")
نهاية

دالة سج_نقل_م(رقم معرف، نص من_مالك، نص إلى_مالك)
    نص م = لنص(معرف)
    اطبع_سطر("  [نقل] كتلة #" + م + ": " + من_مالك + " -> " + إلى_مالك)
نهاية

دالة سج_استعارة_م(رقم معرف، نص مستعير، رقم للتعديل)
    نص م = لنص(معرف)
    إذا (للتعديل == 1)
        اطبع_سطر("  [استعارة] كتلة #" + م + " <- " + مستعير + " (تعديل)")
    وإلا
        اطبع_سطر("  [استعارة] كتلة #" + م + " <- " + مستعير + " (قراءة)")
    نهاية
نهاية

# ---- إحصائيات الذاكرة ----

دالة عرض_إحصائيات(رقم إجمالي، رقم مستخدم، رقم كتل_نشطة، رقم عمليات)
    اطبع_سطر("  ╔════ إحصائيات الذاكرة ════╗")
    رقم متاح = إجمالي - مستخدم
    اطبع_سطر("  ║ الإجمالي:  " + لنص(إجمالي) + " بايت")
    اطبع_سطر("  ║ المستخدم:  " + لنص(مستخدم) + " بايت")
    اطبع_سطر("  ║ المتاح:    " + لنص(متاح) + " بايت")
    اطبع_سطر("  ║ الكتل:     " + لنص(كتل_نشطة))
    اطبع_سطر("  ║ العمليات:  " + لنص(عمليات))
    اطبع_سطر("  ╚═══════════════════════════╝")
نهاية

# ---- مثال 1: تخصيص وتحرير أساسي ----

دالة مثال_تخصيص_أساسي()
    اطبع_سطر("=== تخصيص وتحرير الذاكرة ===")
    اطبع_سطر("")

    رقم إجمالي = 4096
    رقم مستخدم = 0
    رقم كتل = 0
    رقم عمليات = 0

    عرض_إحصائيات(إجمالي، مستخدم، كتل، عمليات)
    اطبع_سطر("")

    سج_تخصيص(1، 256، "مصفوفة_أ")
    مستخدم = مستخدم + 256
    كتل = كتل + 1
    عمليات = عمليات + 1

    سج_تخصيص(2، 512، "مخزن_مؤقت")
    مستخدم = مستخدم + 512
    كتل = كتل + 1
    عمليات = عمليات + 1

    سج_تخصيص(3، 1024، "صورة_بيانات")
    مستخدم = مستخدم + 1024
    كتل = كتل + 1
    عمليات = عمليات + 1

    سج_تخصيص(4، 128، "معلومات_رأس")
    مستخدم = مستخدم + 128
    كتل = كتل + 1
    عمليات = عمليات + 1

    اطبع_سطر("")
    عرض_إحصائيات(إجمالي، مستخدم، كتل، عمليات)
    اطبع_سطر("")

    اطبع_سطر("  بدء التحرير:")
    سج_تحرير_ذ(4، 128)
    مستخدم = مستخدم - 128
    كتل = كتل - 1
    عمليات = عمليات + 1

    سج_تحرير_ذ(3، 1024)
    مستخدم = مستخدم - 1024
    كتل = كتل - 1
    عمليات = عمليات + 1

    سج_تحرير_ذ(2، 512)
    مستخدم = مستخدم - 512
    كتل = كتل - 1
    عمليات = عمليات + 1

    سج_تحرير_ذ(1، 256)
    مستخدم = مستخدم - 256
    كتل = كتل - 1
    عمليات = عمليات + 1

    اطبع_سطر("")
    عرض_إحصائيات(إجمالي، مستخدم، كتل، عمليات)
    اطبع_سطر("")
نهاية

# ---- مثال 2: نقل الملكية بين المكونات ----

دالة مثال_نقل_ملكية()
    اطبع_سطر("=== نقل ملكية الذاكرة ===")
    اطبع_سطر("")

    رقم عمليات = 0

    سج_تخصيص(10، 512، "قارئ_ملفات")
    عمليات = عمليات + 1

    سج_نقل_م(10، "قارئ_ملفات"، "معالج_بيانات")
    عمليات = عمليات + 1
    اطبع_سطر("     قارئ_ملفات لم يعد يملك الكتلة")

    سج_استعارة_م(10، "مراقب_1"، 0)
    سج_استعارة_م(10، "مراقب_2"، 0)
    عمليات = عمليات + 2
    اطبع_سطر("     استعارتا قراءة نشطتان")

    اطبع_سطر("  [إنهاء] استعارة مراقب_2")
    اطبع_سطر("  [إنهاء] استعارة مراقب_1")
    عمليات = عمليات + 2

    سج_استعارة_م(10، "محرر"، 1)
    عمليات = عمليات + 1
    اطبع_سطر("     استعارة تعديل ممكنة بعد إنهاء القراءات")

    اطبع_سطر("  [إنهاء] استعارة محرر")
    عمليات = عمليات + 1

    سج_نقل_م(10، "معالج_بيانات"، "كاتب_ملفات")
    عمليات = عمليات + 1

    سج_تحرير_ذ(10، 512)
    عمليات = عمليات + 1
    اطبع_سطر("     المالك الأخير حرر الذاكرة")

    اطبع_سطر("")
    اطبع_سطر("  إجمالي العمليات: " + لنص(عمليات))
    اطبع_سطر("")
نهاية

# ---- مثال 3: كشف التسرب ----

دالة مثال_كشف_تسرب()
    اطبع_سطر("=== كشف تسرب الذاكرة ===")
    اطبع_سطر("")

    رقم تخصيصات = 0
    رقم تحريرات = 0

    سج_تخصيص(20، 100، "مؤقت_1")
    تخصيصات = تخصيصات + 1

    سج_تخصيص(21، 200، "مؤقت_2")
    تخصيصات = تخصيصات + 1

    سج_تخصيص(22، 300، "مؤقت_3")
    تخصيصات = تخصيصات + 1

    سج_تخصيص(23، 400، "دائم_1")
    تخصيصات = تخصيصات + 1

    اطبع_سطر("")

    سج_تحرير_ذ(20، 100)
    تحريرات = تحريرات + 1

    سج_تحرير_ذ(22، 300)
    تحريرات = تحريرات + 1

    اطبع_سطر("")

    رقم فرق = تخصيصات - تحريرات
    اطبع_سطر("  تقرير التسرب:")
    اطبع_سطر("    تخصيصات: " + لنص(تخصيصات))
    اطبع_سطر("    تحريرات: " + لنص(تحريرات))

    إذا (فرق > 0)
        اطبع_سطر("    [تحذير] " + لنص(فرق) + " كتل لم تحرر!")
        اطبع_سطر("    الكتل المتسربة:")
        اطبع_سطر("      - كتلة #21 (200 بايت) - مؤقت_2")
        اطبع_سطر("      - كتلة #23 (400 بايت) - دائم_1")
        اطبع_سطر("    إجمالي التسرب: 600 بايت")
    وإلا
        اطبع_سطر("    [نجاح] لا تسرب ذاكرة")
    نهاية
    اطبع_سطر("")
نهاية

# ---- مثال 4: محاكاة مكدس التخصيص ----

دالة مثال_مكدس()
    اطبع_سطر("=== مكدس التخصيص ===")
    اطبع_سطر("")

    رقم مستوى = 0
    رقم ذاكرة = 0

    اطبع_سطر("  دخول الدالة الرئيسية")
    سج_تخصيص(30، 64، "إطار_رئيسي")
    ذاكرة = ذاكرة + 64
    مستوى = مستوى + 1
    اطبع_سطر("    مستوى: " + لنص(مستوى) + " | ذاكرة: " + لنص(ذاكرة))

    اطبع_سطر("  دخول دالة فرعية 1")
    سج_تخصيص(31، 128، "إطار_فرعي_1")
    ذاكرة = ذاكرة + 128
    مستوى = مستوى + 1
    اطبع_سطر("    مستوى: " + لنص(مستوى) + " | ذاكرة: " + لنص(ذاكرة))

    اطبع_سطر("  دخول دالة فرعية 2")
    سج_تخصيص(32، 256، "إطار_فرعي_2")
    ذاكرة = ذاكرة + 256
    مستوى = مستوى + 1
    اطبع_سطر("    مستوى: " + لنص(مستوى) + " | ذاكرة: " + لنص(ذاكرة))

    اطبع_سطر("  دخول دالة فرعية 3")
    سج_تخصيص(33، 512، "إطار_فرعي_3")
    ذاكرة = ذاكرة + 512
    مستوى = مستوى + 1
    اطبع_سطر("    مستوى: " + لنص(مستوى) + " | ذاكرة: " + لنص(ذاكرة))

    عرض_فاصل()
    اطبع_سطر("  أقصى عمق وصلنا إليه")
    عرض_فاصل()

    اطبع_سطر("  خروج من دالة فرعية 3")
    سج_تحرير_ذ(33، 512)
    ذاكرة = ذاكرة - 512
    مستوى = مستوى - 1
    اطبع_سطر("    مستوى: " + لنص(مستوى) + " | ذاكرة: " + لنص(ذاكرة))

    اطبع_سطر("  خروج من دالة فرعية 2")
    سج_تحرير_ذ(32، 256)
    ذاكرة = ذاكرة - 256
    مستوى = مستوى - 1
    اطبع_سطر("    مستوى: " + لنص(مستوى) + " | ذاكرة: " + لنص(ذاكرة))

    اطبع_سطر("  خروج من دالة فرعية 1")
    سج_تحرير_ذ(31، 128)
    ذاكرة = ذاكرة - 128
    مستوى = مستوى - 1
    اطبع_سطر("    مستوى: " + لنص(مستوى) + " | ذاكرة: " + لنص(ذاكرة))

    اطبع_سطر("  خروج من الدالة الرئيسية")
    سج_تحرير_ذ(30، 64)
    ذاكرة = ذاكرة - 64
    مستوى = مستوى - 1
    اطبع_سطر("    مستوى: " + لنص(مستوى) + " | ذاكرة: " + لنص(ذاكرة))

    اطبع_سطر("  المكدس فارغ تماماً")
    اطبع_سطر("")
نهاية

# ---- ملخص ----

دالة عرض_مبدأ_ذ(نص مبدأ، رقم تطبيق)
    إذا (تطبيق == 1)
        اطبع_سطر("  [✓] " + مبدأ)
    وإلا
        اطبع_سطر("  [✗] " + مبدأ)
    نهاية
نهاية

دالة عرض_الملخص()
    اطبع_سطر("=== ملخص نظام الذاكرة ===")
    اطبع_سطر("")

    رقم ع = 0

    عرض_مبدأ_ذ("تخصيص وتحرير متوازن"، 1)
    ع = ع + 1

    عرض_مبدأ_ذ("نقل الملكية يبطل المالك القديم"، 1)
    ع = ع + 1

    عرض_مبدأ_ذ("كشف التسرب عند عدم التحرير"، 1)
    ع = ع + 1

    عرض_مبدأ_ذ("مكدس التخصيص LIFO"، 1)
    ع = ع + 1

    عرض_مبدأ_ذ("الاستعارة لا تنقل الملكية"، 1)
    ع = ع + 1

    عرض_مبدأ_ذ("المالك الأخير مسؤول عن التحرير"، 1)
    ع = ع + 1

    اطبع_سطر("")
    اطبع_سطر("  النتيجة: " + لنص(ع) + "/6 مبادئ مطبقة")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  نظام إدارة الذاكرة المتقدم         ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    مثال_تخصيص_أساسي()
    عرض_فاصل()
    مثال_نقل_ملكية()
    عرض_فاصل()
    مثال_كشف_تسرب()
    عرض_فاصل()
    مثال_مكدس()
    عرض_فاصل()
    عرض_الملخص()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى نظام الذاكرة ===")
    ارجع 0
نهاية
