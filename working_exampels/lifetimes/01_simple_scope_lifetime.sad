# ==============================================
# مثال 01: نطاقات العمر البسيطة
# محاكاة إدارة أعمار المراجع والنطاقات
# المستوى: بسيط
# ==============================================

# ---- نظام تتبع النطاقات ----

دالة تسجيل_دخول(نص اسم_نطاق، رقم عمق)
    نص مسافة = ""
    رقم ع = 0
    بينما (ع < عمق)
        مسافة = مسافة + "  "
        ع = ع + 1
    نهاية
    اطبع_سطر(مسافة + "-> دخول نطاق: " + اسم_نطاق)
نهاية

دالة تسجيل_خروج(نص اسم_نطاق، رقم عمق)
    نص مسافة = ""
    رقم ع = 0
    بينما (ع < عمق)
        مسافة = مسافة + "  "
        ع = ع + 1
    نهاية
    اطبع_سطر(مسافة + "<- خروج نطاق: " + اسم_نطاق + " (تحرير)")
نهاية

# ---- عرض معلومات المتغيرات ----

دالة عرض_متغير(نص اسم، نص قيمة، رقم بداية، رقم نهايته)
    اطبع_سطر("  متغير '" + اسم + "' = " + قيمة)
    اطبع_سطر("    العمر: من السطر " + لنص(بداية) + " إلى " + لنص(نهايته))
نهاية

دالة عرض_مرجع(نص اسم_مرجع، نص اسم_مالك، رقم بداية، رقم نهايته)
    اطبع_سطر("  مرجع '" + اسم_مرجع + "' -> " + اسم_مالك)
    اطبع_سطر("    عمر المرجع: " + لنص(بداية) + " - " + لنص(نهايته))
نهاية

# ---- فحص الاستعارة ----
# ملاحظة: نستخدم رقم بدل منطقي كمعامل (0=قراءة، 1=تعديل)

دالة تحقق_استعارة(نص مالك، نص مستعير، رقم قابل_للتعديل)
    إذا (قابل_للتعديل == 1)
        اطبع_سطر("  استعارة قابلة للتعديل: " + مستعير + " <- " + مالك)
    وإلا
        اطبع_سطر("  استعارة للقراءة فقط: " + مستعير + " <- " + مالك)
    نهاية
نهاية

دالة تحرير_مورد(نص اسم_مورد)
    اطبع_سطر("  [تحرير] المورد '" + اسم_مورد + "' تم تحريره")
نهاية

# ---- مثال 1: النطاقات المتداخلة ----

دالة مثال_نطاقات_متداخلة()
    اطبع_سطر("=== النطاقات المتداخلة ===")
    اطبع_سطر("")

    # النطاق الخارجي
    تسجيل_دخول("خارجي"، 0)
    عرض_متغير("بيانات"، "[1، 2، 3]"، 1، 20)

    # نطاق داخلي أول - استعارة قراءة
    تسجيل_دخول("داخلي_1"، 1)
    عرض_مرجع("مرجع_قراءة"، "بيانات"، 5، 10)
    تحقق_استعارة("بيانات"، "مرجع_قراءة"، 0)
    تسجيل_خروج("داخلي_1"، 1)
    تحرير_مورد("مرجع_قراءة")
    اطبع_سطر("")

    # نطاق داخلي ثاني - استعارة تعديل
    تسجيل_دخول("داخلي_2"، 1)
    عرض_مرجع("مرجع_تعديل"، "بيانات"، 12، 18)
    تحقق_استعارة("بيانات"، "مرجع_تعديل"، 1)

    # نطاق أعمق
    تسجيل_دخول("أعمق"، 2)
    عرض_متغير("محلي"، "42"، 14، 16)
    تسجيل_خروج("أعمق"، 2)
    تحرير_مورد("محلي")

    تسجيل_خروج("داخلي_2"، 1)
    تحرير_مورد("مرجع_تعديل")
    اطبع_سطر("")

    تسجيل_خروج("خارجي"، 0)
    تحرير_مورد("بيانات")
نهاية

# ---- مثال 2: الملكية والنقل ----

دالة مثال_ملكية()
    اطبع_سطر("=== الملكية والنقل ===")
    اطبع_سطر("")

    اطبع_سطر("  1. إنشاء المالك الأصلي")
    عرض_متغير("نص_أصلي"، "مرحبا بالعالم"، 1، 5)

    اطبع_سطر("  2. نقل الملكية (move)")
    اطبع_سطر("     نص_أصلي -> نص_جديد")
    اطبع_سطر("     نص_أصلي أصبح غير صالح بعد النقل!")

    عرض_متغير("نص_جديد"، "مرحبا بالعالم"، 3، 10)

    اطبع_سطر("  3. استعارة مؤقتة من المالك الجديد")
    تحقق_استعارة("نص_جديد"، "مرجع_مؤقت"، 0)
    اطبع_سطر("     المرجع المؤقت ينتهي هنا")

    اطبع_سطر("  4. نسخ القيمة (clone)")
    عرض_متغير("نسخة"، "مرحبا بالعالم"، 6، 10)
    اطبع_سطر("     كلاهما صالح بعد النسخ")
    اطبع_سطر("")
نهاية

# ---- مثال 3: قواعد العمر ----

دالة عرض_قاعدة(نص وصف، رقم مستوفاة)
    إذا (مستوفاة == 1)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
نهاية

دالة مثال_قواعد()
    اطبع_سطر("=== قواعد العمر الأساسية ===")
    اطبع_سطر("")

    رقم نجاح = 0

    عرض_قاعدة("المرجع لا يعيش أطول من المالك"، 1)
    نجاح = نجاح + 1

    عرض_قاعدة("استعارة واحدة قابلة للتعديل فقط"، 1)
    نجاح = نجاح + 1

    عرض_قاعدة("عدة استعارات للقراءة مسموحة"، 1)
    نجاح = نجاح + 1

    عرض_قاعدة("لا تعديل مع قراءة نشطة"، 1)
    نجاح = نجاح + 1

    عرض_قاعدة("النقل يبطل المالك"، 1)
    نجاح = نجاح + 1

    عرض_قاعدة("النسخ يحافظ على الأصل"، 1)
    نجاح = نجاح + 1

    اطبع_سطر("")
    اطبع_سطر("  النتيجة: " + لنص(نجاح) + "/6 قواعد مستوفاة")
    اطبع_سطر("")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════╗")
    اطبع_سطر("║  نطاقات العمر والمراجع          ║")
    اطبع_سطر("╚══════════════════════════════════╝")
    اطبع_سطر("")

    مثال_نطاقات_متداخلة()
    اطبع_سطر("")

    مثال_ملكية()
    اطبع_سطر("")

    مثال_قواعد()

    اطبع_سطر("=== انتهى البرنامج ===")
    ارجع 0
نهاية
