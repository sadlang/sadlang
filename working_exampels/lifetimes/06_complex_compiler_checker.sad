# ==============================================
# مثال 06: فاحص الأعمار في المترجم
# محاكاة تحليل أعمار المتغيرات والمراجع
# المستوى: معقد
# ==============================================

# ---- أدوات التسجيل ----

دالة سج_فحص(نص مرحلة، نص تفاصيل)
    اطبع_سطر("  [فحص] " + مرحلة + ": " + تفاصيل)
نهاية

دالة سج_تحذير(نص تفاصيل)
    اطبع_سطر("  [تحذير] " + تفاصيل)
نهاية

دالة سج_مشكلة(نص تفاصيل)
    اطبع_سطر("  [خطأ!] " + تفاصيل)
نهاية

دالة سج_سليم(نص تفاصيل)
    اطبع_سطر("  [نجاح] " + تفاصيل)
نهاية

# ---- تحليل المتغيرات ----

دالة تحليل_متغير(نص اسم، نص صنفه، رقم سطر_إنشاء، رقم سطر_آخر)
    اطبع_سطر("  المتغير: " + اسم)
    اطبع_سطر("    النوع: " + صنفه)
    اطبع_سطر("    الإنشاء: سطر " + لنص(سطر_إنشاء))
    اطبع_سطر("    آخر استخدام: سطر " + لنص(سطر_آخر))
    رقم عمر = سطر_آخر - سطر_إنشاء
    اطبع_سطر("    مدى العمر: " + لنص(عمر) + " أسطر")
نهاية

دالة رقم فحص_عمر_مرجع(رقم بداية_مرجع، رقم نهاية_مرجع، رقم بداية_مالك، رقم نهاية_مالك)
    إذا (بداية_مرجع < بداية_مالك)
        سج_مشكلة("المرجع يبدأ قبل المالك!")
        ارجع 0
    نهاية
    إذا (نهاية_مرجع > نهاية_مالك)
        سج_مشكلة("المرجع يعيش أطول من المالك!")
        ارجع 0
    نهاية
    سج_سليم("عمر المرجع ضمن عمر المالك")
    ارجع 1
نهاية

# ---- مثال 1: فحص برنامج صحيح ----

دالة مثال_برنامج_صحيح()
    اطبع_سطر("=== فحص برنامج صحيح ===")
    اطبع_سطر("")

    رقم مشاكل = 0
    رقم فحوصات = 0

    اطبع_سطر("  --- تحليل المتغيرات ---")
    تحليل_متغير("بيانات"، "مصفوفة"، 5، 25)
    فحوصات = فحوصات + 1
    اطبع_سطر("")

    تحليل_متغير("مرجع_أ"، "مرجع_قراءة"، 8، 15)
    فحوصات = فحوصات + 1
    اطبع_سطر("")

    تحليل_متغير("مرجع_ب"، "مرجع_قراءة"، 10، 14)
    فحوصات = فحوصات + 1
    اطبع_سطر("")

    اطبع_سطر("  --- فحص الأعمار ---")

    سج_فحص("مرجع_أ"، "هل يعيش ضمن عمر بيانات؟")
    رقم ن1 = فحص_عمر_مرجع(8، 15، 5، 25)
    إذا (ن1 == 1)
        فحوصات = فحوصات + 1
    وإلا
        مشاكل = مشاكل + 1
    نهاية

    سج_فحص("مرجع_ب"، "هل يعيش ضمن عمر بيانات؟")
    رقم ن2 = فحص_عمر_مرجع(10، 14، 5، 25)
    إذا (ن2 == 1)
        فحوصات = فحوصات + 1
    وإلا
        مشاكل = مشاكل + 1
    نهاية

    اطبع_سطر("")
    اطبع_سطر("  --- فحص الاستعارة ---")
    سج_فحص("تعارض"، "مرجع_أ و مرجع_ب كلاهما قراءة")
    سج_سليم("عدة استعارات قراءة مسموحة")
    فحوصات = فحوصات + 1

    اطبع_سطر("")
    اطبع_سطر("  --- النتيجة ---")
    اطبع_سطر("  فحوصات: " + لنص(فحوصات))
    اطبع_سطر("  مشاكل: " + لنص(مشاكل))

    إذا (مشاكل == 0)
        سج_سليم("البرنامج يجتاز فحص الأعمار")
    وإلا
        سج_مشكلة("البرنامج يحتوي أخطاء أعمار")
    نهاية
    اطبع_سطر("")
نهاية

# ---- مثال 2: فحص مرجع معلق ----

دالة مثال_مرجع_معلق()
    اطبع_سطر("=== فحص مرجع معلق (Dangling Reference) ===")
    اطبع_سطر("")

    رقم مشاكل = 0
    رقم فحوصات = 0

    اطبع_سطر("  --- تحليل المتغيرات ---")
    تحليل_متغير("محلي"، "نص"، 10، 15)
    فحوصات = فحوصات + 1
    اطبع_سطر("")

    تحليل_متغير("مرجع_خارجي"، "مرجع"، 12، 25)
    فحوصات = فحوصات + 1
    اطبع_سطر("")

    اطبع_سطر("  --- فحص الأعمار ---")
    سج_فحص("مرجع_خارجي"، "هل يعيش ضمن عمر محلي؟")

    رقم ن3 = فحص_عمر_مرجع(12، 25، 10، 15)
    إذا (ن3 == 1)
        فحوصات = فحوصات + 1
    وإلا
        مشاكل = مشاكل + 1
    نهاية

    اطبع_سطر("")
    اطبع_سطر("  التوضيح:")
    اطبع_سطر("    محلي:        [سطر 10 -------- سطر 15]")
    اطبع_سطر("    مرجع_خارجي: [سطر 12 ──────────────── سطر 25]")
    اطبع_سطر("                               ^ خطر! ^")

    اطبع_سطر("")
    اطبع_سطر("  مشاكل مكتشفة: " + لنص(مشاكل))

    إذا (مشاكل > 0)
        سج_مشكلة("مرجع معلق! المرجع يشير لذاكرة محررة")
        اطبع_سطر("  الحل: تقصير عمر المرجع أو تمديد عمر المالك")
    نهاية
    اطبع_سطر("")
نهاية

# ---- مثال 3: فحص تعارض الاستعارة ----

دالة مثال_تعارض_استعارة()
    اطبع_سطر("=== فحص تعارض الاستعارة ===")
    اطبع_سطر("")

    رقم مشاكل = 0
    رقم فحوصات = 0

    اطبع_سطر("  --- المتغيرات ---")
    تحليل_متغير("مصفوفة"، "مالك"، 1، 30)
    اطبع_سطر("")
    تحليل_متغير("قارئ_1"، "استعارة_قراءة"، 5، 20)
    اطبع_سطر("")
    تحليل_متغير("معدل_1"، "استعارة_تعديل"، 10، 18)
    فحوصات = فحوصات + 3
    اطبع_سطر("")

    اطبع_سطر("  --- فحص الأعمار ---")

    سج_فحص("قارئ_1"، "ضمن عمر مصفوفة؟")
    رقم ن4 = فحص_عمر_مرجع(5، 20، 1، 30)
    إذا (ن4 == 1)
        فحوصات = فحوصات + 1
    وإلا
        مشاكل = مشاكل + 1
    نهاية

    سج_فحص("معدل_1"، "ضمن عمر مصفوفة؟")
    رقم ن5 = فحص_عمر_مرجع(10، 18، 1، 30)
    إذا (ن5 == 1)
        فحوصات = فحوصات + 1
    وإلا
        مشاكل = مشاكل + 1
    نهاية

    اطبع_سطر("")
    اطبع_سطر("  --- فحص التعارض ---")

    رقم بداية_تداخل = 10
    رقم نهاية_تداخل = 18

    إذا (بداية_تداخل < 20)
        سج_مشكلة("تعارض! قراءة وتعديل متداخلان")
        اطبع_سطر("    فترة التداخل: سطر " + لنص(بداية_تداخل) + " - " + لنص(نهاية_تداخل))
        مشاكل = مشاكل + 1
    نهاية

    اطبع_سطر("")
    اطبع_سطر("  التوضيح:")
    اطبع_سطر("    مصفوفة: [1 ─────────────────────── 30]")
    اطبع_سطر("    قارئ_1: [5 ────────────── 20]")
    اطبع_سطر("    معدل_1:      [10 ──── 18]")
    اطبع_سطر("                  ^^^^^^^^^ تعارض!")

    اطبع_سطر("")
    اطبع_سطر("  مشاكل: " + لنص(مشاكل))
    اطبع_سطر("  الحل: فصل فترات القراءة والتعديل")
    اطبع_سطر("")
نهاية

# ---- مثال 4: تحليل دالة كاملة ----

دالة مثال_تحليل_دالة()
    اطبع_سطر("=== تحليل دالة كاملة ===")
    اطبع_سطر("")

    رقم إجمالي_فحص = 0
    رقم إجمالي_مشاكل = 0
    رقم إجمالي_تحذير = 0

    اطبع_سطر("  الدالة: معالجة_بيانات()")
    اطبع_سطر("  النطاق: سطر 1 - 50")
    اطبع_سطر("")

    اطبع_سطر("  الخطوة 1: جمع المتغيرات")
    اطبع_سطر("    متغير: مدخلات (مالك، سطر 2-45)")
    اطبع_سطر("    متغير: نتائج (مالك، سطر 3-48)")
    اطبع_سطر("    متغير: مؤشر (مرجع مدخلات، سطر 5-30)")
    اطبع_سطر("    متغير: محرر (مرجع_تعديل نتائج، سطر 10-40)")
    اطبع_سطر("    متغير: قارئ (مرجع نتائج، سطر 35-42)")
    إجمالي_فحص = إجمالي_فحص + 5
    اطبع_سطر("")

    اطبع_سطر("  الخطوة 2: فحص الأعمار")
    سج_فحص("مؤشر ← مدخلات"، "5-30 ⊂ 2-45")
    رقم ر1 = فحص_عمر_مرجع(5، 30، 2، 45)
    إذا (ر1 == 1)
        إجمالي_فحص = إجمالي_فحص + 1
    وإلا
        إجمالي_مشاكل = إجمالي_مشاكل + 1
    نهاية

    سج_فحص("محرر ← نتائج"، "10-40 ⊂ 3-48")
    رقم ر2 = فحص_عمر_مرجع(10، 40، 3، 48)
    إذا (ر2 == 1)
        إجمالي_فحص = إجمالي_فحص + 1
    وإلا
        إجمالي_مشاكل = إجمالي_مشاكل + 1
    نهاية

    سج_فحص("قارئ ← نتائج"، "35-42 ⊂ 3-48")
    رقم ر3 = فحص_عمر_مرجع(35، 42، 3، 48)
    إذا (ر3 == 1)
        إجمالي_فحص = إجمالي_فحص + 1
    وإلا
        إجمالي_مشاكل = إجمالي_مشاكل + 1
    نهاية
    اطبع_سطر("")

    اطبع_سطر("  الخطوة 3: فحص تعارض الاستعارة")

    إذا (35 < 40)
        سج_مشكلة("تعارض: محرر (تعديل 10-40) و قارئ (قراءة 35-42)")
        اطبع_سطر("    فترة التعارض: سطر 35 - 40")
        إجمالي_مشاكل = إجمالي_مشاكل + 1
    نهاية
    اطبع_سطر("")

    اطبع_سطر("  الخطوة 4: تحذيرات")
    سج_تحذير("متغير 'مؤشر' يمكن تقصير عمره (آخر استخدام سطر 25)")
    إجمالي_تحذير = إجمالي_تحذير + 1
    اطبع_سطر("")

    اطبع_سطر("  ╔══════ تقرير التحليل ══════╗")
    اطبع_سطر("  ║ فحوصات: " + لنص(إجمالي_فحص))
    اطبع_سطر("  ║ مشاكل:  " + لنص(إجمالي_مشاكل))
    اطبع_سطر("  ║ تحذيرات: " + لنص(إجمالي_تحذير))

    إذا (إجمالي_مشاكل > 0)
        اطبع_سطر("  ║ النتيجة: فشل ✗")
    وإلا
        اطبع_سطر("  ║ النتيجة: نجاح ✓")
    نهاية
    اطبع_سطر("  ╚═══════════════════════════╝")
    اطبع_سطر("")
نهاية

# ---- ملخص المبادئ ----

دالة عرض_مبدأ_ف(نص مبدأ، رقم تطبيق)
    إذا (تطبيق == 1)
        اطبع_سطر("  [✓] " + مبدأ)
    وإلا
        اطبع_سطر("  [✗] " + مبدأ)
    نهاية
نهاية

دالة ملخص_فاحص()
    اطبع_سطر("=== ملخص مبادئ فاحص الأعمار ===")
    اطبع_سطر("")

    رقم ع = 0

    عرض_مبدأ_ف("تحليل نطاق كل متغير"، 1)
    ع = ع + 1

    عرض_مبدأ_ف("التحقق من عمر المراجع"، 1)
    ع = ع + 1

    عرض_مبدأ_ف("كشف المراجع المعلقة"، 1)
    ع = ع + 1

    عرض_مبدأ_ف("كشف تعارض الاستعارة"، 1)
    ع = ع + 1

    عرض_مبدأ_ف("تحذيرات تحسين الأعمار"، 1)
    ع = ع + 1

    عرض_مبدأ_ف("تقارير تحليل شاملة"، 1)
    ع = ع + 1

    اطبع_سطر("")
    اطبع_سطر("  النتيجة: " + لنص(ع) + "/6 مبادئ")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  فاحص الأعمار في المترجم            ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    مثال_برنامج_صحيح()
    اطبع_سطر("")
    مثال_مرجع_معلق()
    اطبع_سطر("")
    مثال_تعارض_استعارة()
    اطبع_سطر("")
    مثال_تحليل_دالة()
    اطبع_سطر("")
    ملخص_فاحص()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى الفاحص ===")
    ارجع 0
نهاية
