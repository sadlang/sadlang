# ==============================================
# مثال 03: إدارة الموارد (RAII)
# محاكاة نمط RAII وإدارة الموارد التلقائية
# المستوى: متوسط
# ==============================================

# ---- سجل الموارد ----

دالة سج_إنشاء(نص معرف، نص وصف)
    اطبع_سطر("  [+] إنشاء مورد #" + معرف + ": " + وصف)
نهاية

دالة سج_تحرير(نص معرف، نص وصف)
    اطبع_سطر("  [-] تحرير مورد #" + معرف + ": " + وصف)
نهاية

دالة سج_عملية(نص معرف، نص عملية)
    اطبع_سطر("  [~] استخدام مورد #" + معرف + ": " + عملية)
نهاية

دالة سج_مشكلة(نص رسالة)
    اطبع_سطر("  [!!] خطأ إدارة: " + رسالة)
نهاية

# ---- محاكاة مورد ملف ----

دالة مثال_ملف()
    اطبع_سطر("=== إدارة موارد الملفات ===")
    اطبع_سطر("")

    نص معرف_ملف = "1"
    نص اسم_ملف = "بيانات.txt"
    رقم حال_مفتوح = 1

    سج_إنشاء(معرف_ملف، "ملف: " + اسم_ملف)

    إذا (حال_مفتوح == 1)
        سج_عملية(معرف_ملف، "قراءة محتوى")
        سج_عملية(معرف_ملف، "كتابة سطر جديد")
        سج_عملية(معرف_ملف، "حفظ التغييرات")
    نهاية

    سج_تحرير(معرف_ملف، "ملف: " + اسم_ملف)
    حال_مفتوح = 0
    اطبع_سطر("  الملف مغلق تلقائياً (RAII)")
    اطبع_سطر("")
نهاية

# ---- محاكاة مورد ذاكرة ----

دالة عرض_ذاكرة(رقم مستخدمة، رقم إجمالي)
    نص ن_م = لنص(مستخدمة)
    نص ن_ج = لنص(إجمالي)
    رقم متاح = إجمالي - مستخدمة
    نص ن_ت = لنص(متاح)
    اطبع_سطر("  الذاكرة: " + ن_م + "/" + ن_ج + " (متاح: " + ن_ت + ")")
نهاية

دالة مثال_ذاكرة()
    اطبع_سطر("=== إدارة موارد الذاكرة ===")
    اطبع_سطر("")

    رقم ذاكرة_كلية = 1024
    رقم ذاكرة_مستخدمة = 0

    عرض_ذاكرة(ذاكرة_مستخدمة، ذاكرة_كلية)
    اطبع_سطر("")

    رقم كتلة1 = 256
    سج_إنشاء("2"، "كتلة ذاكرة 256 بايت")
    ذاكرة_مستخدمة = ذاكرة_مستخدمة + كتلة1
    عرض_ذاكرة(ذاكرة_مستخدمة، ذاكرة_كلية)

    رقم كتلة2 = 512
    سج_إنشاء("3"، "كتلة ذاكرة 512 بايت")
    ذاكرة_مستخدمة = ذاكرة_مستخدمة + كتلة2
    عرض_ذاكرة(ذاكرة_مستخدمة، ذاكرة_كلية)

    رقم كتلة3 = 128
    سج_إنشاء("4"، "كتلة ذاكرة 128 بايت")
    ذاكرة_مستخدمة = ذاكرة_مستخدمة + كتلة3
    عرض_ذاكرة(ذاكرة_مستخدمة، ذاكرة_كلية)
    اطبع_سطر("")

    اطبع_سطر("  تحرير بترتيب LIFO:")
    سج_تحرير("4"، "كتلة 128 بايت")
    ذاكرة_مستخدمة = ذاكرة_مستخدمة - كتلة3
    عرض_ذاكرة(ذاكرة_مستخدمة، ذاكرة_كلية)

    سج_تحرير("3"، "كتلة 512 بايت")
    ذاكرة_مستخدمة = ذاكرة_مستخدمة - كتلة2
    عرض_ذاكرة(ذاكرة_مستخدمة، ذاكرة_كلية)

    سج_تحرير("2"، "كتلة 256 بايت")
    ذاكرة_مستخدمة = ذاكرة_مستخدمة - كتلة1
    عرض_ذاكرة(ذاكرة_مستخدمة، ذاكرة_كلية)

    اطبع_سطر("  جميع الموارد محررة")
    اطبع_سطر("")
نهاية

# ---- محاكاة مجمع الاتصالات ----

دالة مثال_مجمع_اتصالات()
    اطبع_سطر("=== مجمع الاتصالات (Connection Pool) ===")
    اطبع_سطر("")

    رقم سعة = 3
    رقم نشطة = 0

    اطبع_سطر("  سعة المجمع: " + لنص(سعة) + " اتصالات")
    اطبع_سطر("")

    إذا (نشطة < سعة)
        نشطة = نشطة + 1
        سج_إنشاء("5"، "اتصال قاعدة بيانات #1")
        اطبع_سطر("  اتصالات نشطة: " + لنص(نشطة))
    نهاية

    إذا (نشطة < سعة)
        نشطة = نشطة + 1
        سج_إنشاء("6"، "اتصال قاعدة بيانات #2")
        اطبع_سطر("  اتصالات نشطة: " + لنص(نشطة))
    نهاية

    إذا (نشطة < سعة)
        نشطة = نشطة + 1
        سج_إنشاء("7"، "اتصال قاعدة بيانات #3")
        اطبع_سطر("  اتصالات نشطة: " + لنص(نشطة))
    نهاية

    اطبع_سطر("")

    إذا (نشطة < سعة)
        نشطة = نشطة + 1
        سج_إنشاء("8"، "اتصال #4")
    وإلا
        سج_مشكلة("المجمع ممتلئ! انتظار تحرير اتصال")
    نهاية

    اطبع_سطر("")

    سج_تحرير("5"، "اتصال #1")
    نشطة = نشطة - 1
    اطبع_سطر("  اتصالات نشطة: " + لنص(نشطة))

    إذا (نشطة < سعة)
        نشطة = نشطة + 1
        سج_إنشاء("8"، "اتصال #4 (بعد التحرير)")
        اطبع_سطر("  اتصالات نشطة: " + لنص(نشطة))
    نهاية

    اطبع_سطر("")
    اطبع_سطر("  تحرير جميع الاتصالات:")
    سج_تحرير("8"، "اتصال #4")
    سج_تحرير("7"، "اتصال #3")
    سج_تحرير("6"، "اتصال #2")
    نشطة = 0
    اطبع_سطر("  اتصالات نشطة: " + لنص(نشطة))
    اطبع_سطر("")
نهاية

# ---- مثال حراسة الموارد ----

دالة مثال_حراسة()
    اطبع_سطر("=== حراسة الموارد (Guard Pattern) ===")
    اطبع_سطر("")

    رقم مقفل = 0

    اطبع_سطر("  إنشاء حارس القفل")
    مقفل = 1
    سج_إنشاء("9"، "قفل mutex")
    اطبع_سطر("  القسم الحرج مؤمّن")

    سج_عملية("9"، "قراءة بيانات مشتركة")
    سج_عملية("9"، "تحديث عدّاد")
    سج_عملية("9"، "كتابة نتيجة")

    سج_تحرير("9"، "قفل mutex")
    مقفل = 0
    اطبع_سطر("  القسم الحرج محرر تلقائياً")
    اطبع_سطر("")

    اطبع_سطر("  إنشاء حارس ملف مؤقت")
    سج_إنشاء("10"، "ملف مؤقت: /tmp/data.tmp")
    سج_عملية("10"، "كتابة بيانات مؤقتة")
    سج_عملية("10"، "قراءة النتائج")
    سج_تحرير("10"، "ملف مؤقت (حذف تلقائي)")
    اطبع_سطر("  الملف المؤقت حُذف عند خروج النطاق")
    اطبع_سطر("")
نهاية

# ---- ملخص ----

دالة عرض_مبدأ(نص قاعدة، رقم مر)
    إذا (مر == 1)
        اطبع_سطر("  [✓] " + قاعدة)
    وإلا
        اطبع_سطر("  [✗] " + قاعدة)
    نهاية
نهاية

دالة عرض_ملخص_إدارة()
    اطبع_سطر("=== ملخص إدارة الموارد ===")
    اطبع_سطر("")

    رقم ع = 0

    عرض_مبدأ("RAII: التحرير التلقائي عند نهاية النطاق"، 1)
    ع = ع + 1

    عرض_مبدأ("LIFO: التحرير بترتيب عكسي"، 1)
    ع = ع + 1

    عرض_مبدأ("المجمع: إدارة السعة والانتظار"، 1)
    ع = ع + 1

    عرض_مبدأ("الحارس: حماية القسم الحرج"، 1)
    ع = ع + 1

    عرض_مبدأ("التنظيف: حذف الموارد المؤقتة"، 1)
    ع = ع + 1

    اطبع_سطر("")
    اطبع_سطر("  النتيجة: " + لنص(ع) + "/5 مبادئ")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════╗")
    اطبع_سطر("║  إدارة الموارد - نمط RAII        ║")
    اطبع_سطر("╚══════════════════════════════════╝")
    اطبع_سطر("")

    مثال_ملف()
    اطبع_سطر("")
    مثال_ذاكرة()
    اطبع_سطر("")
    مثال_مجمع_اتصالات()
    اطبع_سطر("")
    مثال_حراسة()
    اطبع_سطر("")
    عرض_ملخص_إدارة()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى ===")
    ارجع 0
نهاية
