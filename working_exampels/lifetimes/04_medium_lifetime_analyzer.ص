# ==============================================
# مثال 04: محلل الأعمار الثابت
# محاكاة محلل أعمار يتحقق من صحة البرنامج
# المستوى: متوسط
# ==============================================

# ---- أنواع الأعمار ----

دالة نص عمر_لنص(رقم عمر)
    طابق عمر
        حالة 1:
            ارجع "'أ"
        حالة 2:
            ارجع "'ب"
        حالة 3:
            ارجع "'ج"
        حالة 4:
            ارجع "'د"
        حالة _:
            ارجع "'مجهول"
    نهاية
نهاية

# ---- سجل المتغيرات ----

صنف متغير_محلل
    عام
        نص اسم_متغير
        نص نوع_متغير
        رقم عمر_متغير
        رقم سطر_بداية
        رقم سطر_نهاية
        منطقي مملوك
        نص مالك_أصلي

        باني(نص الاسم، نص النوع، رقم العمر، رقم البداية، رقم النهاية)
            اسم_متغير = الاسم
            نوع_متغير = النوع
            عمر_متغير = العمر
            سطر_بداية = البداية
            سطر_نهاية = النهاية
            مملوك = صحيح
            مالك_أصلي = ""
        نهاية

        دالة اجعل_مرجع(نص المالك)
            مملوك = خطأ
            مالك_أصلي = المالك
        نهاية

        دالة اعرض()
            نص عمر_ن = عمر_لنص(عمر_متغير)
            إذا (مملوك)
                اطبع_سطر("  " + اسم_متغير + ": " + نوع_متغير + " [ملك] عمر=" + عمر_ن + " [" + لنص(سطر_بداية) + "-" + لنص(سطر_نهاية) + "]")
            وإلا
                اطبع_سطر("  " + اسم_متغير + ": &" + نوع_متغير + " [مرجع -> " + مالك_أصلي + "] عمر=" + عمر_ن + " [" + لنص(سطر_بداية) + "-" + لنص(سطر_نهاية) + "]")
            نهاية
        نهاية
نهاية

# ---- فحوصات الأعمار ----

دالة منطقي فحص_عمر_مرجع(نص اسم_مرجع، رقم نهاية_مرجع، نص اسم_مالك، رقم نهاية_مالك)
    إذا (نهاية_مرجع > نهاية_مالك)
        اطبع_سطر("  ✗ خطأ: " + اسم_مرجع + " (ينتهي سطر " + لنص(نهاية_مرجع) + ") يعيش أطول من " + اسم_مالك + " (ينتهي سطر " + لنص(نهاية_مالك) + ")")
        ارجع خطأ
    نهاية
    اطبع_سطر("  ✓ " + اسم_مرجع + " لا يتجاوز عمر " + اسم_مالك)
    ارجع صحيح
نهاية

دالة منطقي فحص_استعارة_متوافقة(رقم عدد_قراءة، رقم عدد_تعديل، نص سياق)
    إذا (عدد_تعديل > 1)
        اطبع_سطر("  ✗ خطأ في " + سياق + ": " + لنص(عدد_تعديل) + " استعارات تعديل!")
        ارجع خطأ
    نهاية
    إذا (عدد_تعديل > 0)
        إذا (عدد_قراءة > 0)
            اطبع_سطر("  ✗ خطأ في " + سياق + ": خلط قراءة وتعديل!")
            ارجع خطأ
        نهاية
    نهاية
    اطبع_سطر("  ✓ استعارات " + سياق + " متوافقة (" + لنص(عدد_قراءة) + " قراءة, " + لنص(عدد_تعديل) + " تعديل)")
    ارجع صحيح
نهاية

# ---- تحليل برنامج نموذجي ----

دالة تحليل_برنامج_1()
    اطبع_سطر("=== تحليل البرنامج 1: صحيح ===")
    اطبع_سطر("")
    اطبع_سطر("  الكود:")
    اطبع_سطر("  │ 1: متغير بيانات = [1, 2, 3]")
    اطبع_سطر("  │ 2: {")
    اطبع_سطر("  │ 3:   متغير مرجع = &بيانات")
    اطبع_سطر("  │ 4:   اطبع(مرجع)")
    اطبع_سطر("  │ 5: }")
    اطبع_سطر("  │ 6: بيانات.أضف(4)")
    اطبع_سطر("")

    اطبع_سطر("  المتغيرات:")
    متغير ب = جديد متغير_محلل("بيانات"، "مصفوفة"، 1، 1، 6)
    ب.اعرض()
    متغير م = جديد متغير_محلل("مرجع"، "مصفوفة"، 2، 3، 5)
    م.اجعل_مرجع("بيانات")
    م.اعرض()
    اطبع_سطر("")

    اطبع_سطر("  الفحوصات:")
    فحص_عمر_مرجع("مرجع"، 5، "بيانات"، 6)
    فحص_استعارة_متوافقة(1، 0، "سطر 3-5")
    اطبع_سطر("  ← البرنامج صحيح!")
    اطبع_سطر("")
نهاية

دالة تحليل_برنامج_2()
    اطبع_سطر("=== تحليل البرنامج 2: خطأ عمر ===")
    اطبع_سطر("")
    اطبع_سطر("  الكود:")
    اطبع_سطر("  │ 1: متغير مرجع")
    اطبع_سطر("  │ 2: {")
    اطبع_سطر("  │ 3:   متغير محلي = 42")
    اطبع_سطر("  │ 4:   مرجع = &محلي")
    اطبع_سطر("  │ 5: } // محلي يُحرر هنا!")
    اطبع_سطر("  │ 6: اطبع(مرجع) // خطأ!")
    اطبع_سطر("")

    اطبع_سطر("  المتغيرات:")
    متغير م = جديد متغير_محلل("مرجع"، "رقم"، 1، 1، 6)
    م.اعرض()
    متغير ل = جديد متغير_محلل("محلي"، "رقم"، 2، 3، 5)
    ل.اعرض()
    اطبع_سطر("")

    اطبع_سطر("  الفحوصات:")
    فحص_عمر_مرجع("مرجع"، 6، "محلي"، 5)
    اطبع_سطر("  ← البرنامج به خطأ: مرجع معلق!")
    اطبع_سطر("")
نهاية

دالة تحليل_برنامج_3()
    اطبع_سطر("=== تحليل البرنامج 3: خطأ استعارة ===")
    اطبع_سطر("")
    اطبع_سطر("  الكود:")
    اطبع_سطر("  │ 1: متغير بيانات = [1, 2]")
    اطبع_سطر("  │ 2: متغير م1 = &بيانات")
    اطبع_سطر("  │ 3: متغير م2 = &mut بيانات  // خطأ!")
    اطبع_سطر("  │ 4: اطبع(م1)")
    اطبع_سطر("")

    اطبع_سطر("  الفحوصات:")
    فحص_استعارة_متوافقة(1، 1، "سطر 2-3")
    اطبع_سطر("  ← البرنامج به خطأ: خلط قراءة وتعديل!")
    اطبع_سطر("")
نهاية

# ---- تقرير التحليل ----

دالة تقرير_تحليل()
    اطبع_سطر("=== تقرير التحليل الإجمالي ===")
    اطبع_سطر("──────────────────────────────")
    اطبع_سطر("  البرنامج 1: ✓ صحيح")
    اطبع_سطر("  البرنامج 2: ✗ خطأ عمر (مرجع معلق)")
    اطبع_سطر("  البرنامج 3: ✗ خطأ استعارة (خلط قراءة/تعديل)")
    اطبع_سطر("──────────────────────────────")
    اطبع_سطر("  الملخص: 1/3 برامج صحيحة")
    اطبع_سطر("")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════╗")
    اطبع_سطر("║  محلل الأعمار الثابت             ║")
    اطبع_سطر("╚══════════════════════════════════╝")
    اطبع_سطر("")

    تحليل_برنامج_1()
    تحليل_برنامج_2()
    تحليل_برنامج_3()
    تقرير_تحليل()

    اطبع_سطر("=== انتهى ===")
    ارجع 0
نهاية
