# اختبار متغير داخل الأصناف
صنف حساب
    رقم رصيد

    باني(رقم مبلغ)
        رصيد = مبلغ
    نهاية

    دالة ايداع(رقم مبلغ)
        رصيد = رصيد + مبلغ
        اطبع("الرصيد بعد الإيداع: ")
        اطبع_سطر(رصيد)
    نهاية

    دالة سحب(رقم مبلغ)
        اذا (مبلغ > رصيد)
            اطبع_سطر("رصيد غير كافي!")
            ارجع 0
        نهاية
        رصيد = رصيد - مبلغ
        اطبع("الرصيد بعد السحب: ")
        اطبع_سطر(رصيد)
        ارجع 1
    نهاية

    دالة رقم الرصيد()
        ارجع رصيد
    نهاية
نهاية

متغير ح = جديد حساب(1000)
متغير ر = ح.الرصيد()
اطبع("الرصيد الأولي: ")
اطبع_سطر(ر)
ح.ايداع(500)
ح.سحب(200)
ح.سحب(2000)
متغير ر2 = ح.الرصيد()
اطبع("الرصيد النهائي: ")
اطبع_سطر(ر2)
اطبع_سطر("انتهى!")
