# مكتبة التحقق - دوال مساعدة للتحقق من المدخلات

صدّر دالة رقم هل_موجب(رقم قيمة)
    اذا قيمة > 0
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة رقم هل_سالب(رقم قيمة)
    اذا قيمة < 0
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة رقم هل_زوجي(رقم قيمة)
    اذا قيمة % 2 == 0
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة رقم هل_فردي(رقم قيمة)
    اذا قيمة % 2 != 0
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة رقم القيمة_الاكبر(رقم أ، رقم ب)
    اذا أ > ب
        ارجع أ
    نهاية
    ارجع ب
نهاية

صدّر دالة رقم القيمة_الاصغر(رقم أ، رقم ب)
    اذا أ < ب
        ارجع أ
    نهاية
    ارجع ب
نهاية

صدّر دالة رقم المضروب(رقم عدد)
    اذا عدد <= 1
        ارجع 1
    نهاية
    ارجع عدد * المضروب(عدد - 1)
نهاية
