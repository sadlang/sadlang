# ==============================================
# مثال 5: نظام إدارة المدرسة - OOP + ملكية
# Example 5: School Management - OOP + Ownership
# ==============================================
# يوضح هذا المثال:
# - أصناف متعددة: طالب، مادة، درجة
# - وراثة: طالب_متفوق يرث من طالب
# - أعضاء ساكنة لتتبع الإحصائيات
# - نظام الملكية مع جميع العمليات
# - حلقات وشروط متداخلة
# ==============================================
# شغّل بـ: sad.exe --ownership 19_school.sad
# ==============================================

# ===== صنف المادة الدراسية =====
صنف مادة
    نص الاسم
    رقم الدرجة_القصوى
    ساكن رقم عدد_المواد

    باني(نص اسم، رقم قصوى)
        الاسم = اسم
        الدرجة_القصوى = قصوى
        عدد_المواد = عدد_المواد + 1
    نهاية

    دالة اعرض()
        اطبع("    ")
        اطبع(الاسم)
        اطبع(" (من ")
        اطبع(الدرجة_القصوى)
        اطبع_سطر(")")
    نهاية

    ساكن دالة رقم كم_مادة()
        ارجع عدد_المواد
    نهاية
نهاية

# ===== صنف الطالب =====
صنف طالب
    نص الاسم
    رقم المعرف
    رقم درجة_رياضيات
    رقم درجة_علوم
    رقم درجة_لغة
    ساكن رقم عدد_الطلاب
    ساكن رقم مجموع_المعدلات

    باني(نص اسم، رقم معرف)
        الاسم = اسم
        المعرف = معرف
        درجة_رياضيات = 0
        درجة_علوم = 0
        درجة_لغة = 0
        عدد_الطلاب = عدد_الطلاب + 1
    نهاية

    دالة سجل_درجات(رقم رياضيات، رقم علوم، رقم لغة)
        درجة_رياضيات = رياضيات
        درجة_علوم = علوم
        درجة_لغة = لغة
        رقم معدل = (رياضيات + علوم + لغة) / 3
        مجموع_المعدلات = مجموع_المعدلات + معدل
    نهاية

    دالة رقم المعدل()
        ارجع (درجة_رياضيات + درجة_علوم + درجة_لغة) / 3
    نهاية

    دالة تقدير()
        رقم م = (درجة_رياضيات + درجة_علوم + درجة_لغة) / 3
        اطبع("    التقدير: ")
        إذا (م >= 90)
            اطبع_سطر("ممتاز")
        وإلا_إذا (م >= 80)
            اطبع_سطر("جيد جدا")
        وإلا_إذا (م >= 70)
            اطبع_سطر("جيد")
        وإلا_إذا (م >= 60)
            اطبع_سطر("مقبول")
        وإلا
            اطبع_سطر("راسب")
        نهاية
    نهاية

    دالة اعرض()
        اطبع("    طالب: ")
        اطبع(الاسم)
        اطبع(" (#")
        اطبع(المعرف)
        اطبع(") | رياضيات:")
        اطبع(درجة_رياضيات)
        اطبع(" علوم:")
        اطبع(درجة_علوم)
        اطبع(" لغة:")
        اطبع(درجة_لغة)
        اطبع(" | معدل:")
        اطبع_سطر((درجة_رياضيات + درجة_علوم + درجة_لغة) / 3)
    نهاية

    ساكن دالة رقم كم_طالب()
        ارجع عدد_الطلاب
    نهاية

    ساكن دالة رقم المعدل_العام()
        إذا (عدد_الطلاب == 0)
            ارجع 0
        نهاية
        ارجع مجموع_المعدلات / عدد_الطلاب
    نهاية
نهاية

# ===== الدالة الرئيسية =====
دالة رئيسية()
    اطبع_سطر("========================================")
    اطبع_سطر("      نظام ادارة المدرسة")
    اطبع_سطر("========================================")
    اطبع_سطر("")

    # ---- تعريف المواد ----
    اطبع_سطر("[1] المواد الدراسية:")
    متغير م_رياضيات = جديد مادة("الرياضيات"، 100)
    متغير م_علوم = جديد مادة("العلوم"، 100)
    متغير م_لغة = جديد مادة("اللغة العربية"، 100)

    م_رياضيات.اعرض()
    م_علوم.اعرض()
    م_لغة.اعرض()
    اطبع("    عدد المواد: ")
    اطبع_سطر(مادة.كم_مادة())
    اطبع_سطر("")

    # ---- تسجيل الطلاب ----
    اطبع_سطر("[2] تسجيل الطلاب:")
    متغير ط1 = جديد طالب("احمد"، 1001)
    متغير ط2 = جديد طالب("فاطمة"، 1002)
    متغير ط3 = جديد طالب("خالد"، 1003)
    متغير ط4 = جديد طالب("نورة"، 1004)
    متغير ط5 = جديد طالب("سعد"، 1005)

    اطبع("    عدد الطلاب: ")
    اطبع_سطر(طالب.كم_طالب())
    اطبع_سطر("")

    # ---- تسجيل الدرجات ----
    اطبع_سطر("[3] تسجيل الدرجات:")
    ط1.سجل_درجات(95، 88، 92)
    ط2.سجل_درجات(78، 85، 90)
    ط3.سجل_درجات(60، 55، 65)
    ط4.سجل_درجات(100، 97، 98)
    ط5.سجل_درجات(45، 50، 40)

    ط1.اعرض()
    ط2.اعرض()
    ط3.اعرض()
    ط4.اعرض()
    ط5.اعرض()
    اطبع_سطر("")

    # ---- التقديرات ----
    اطبع_سطر("[4] التقديرات:")
    اطبع("    احمد - ")
    ط1.تقدير()
    اطبع("    فاطمة - ")
    ط2.تقدير()
    اطبع("    خالد - ")
    ط3.تقدير()
    اطبع("    نورة - ")
    ط4.تقدير()
    اطبع("    سعد - ")
    ط5.تقدير()
    اطبع_سطر("")

    # ---- إحصائيات ----
    اطبع_سطر("[5] الاحصائيات:")
    اطبع("    المعدل العام للصف: ")
    اطبع_سطر(طالب.المعدل_العام())
    اطبع_سطر("")

    # تحليل النتائج
    رقم ناجحون = 0
    رقم راسبون = 0

    إذا (ط1.المعدل() >= 60)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية
    إذا (ط2.المعدل() >= 60)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية
    إذا (ط3.المعدل() >= 60)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية
    إذا (ط4.المعدل() >= 60)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية
    إذا (ط5.المعدل() >= 60)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية

    اطبع("    الناجحون: ")
    اطبع_سطر(ناجحون)
    اطبع("    الراسبون: ")
    اطبع_سطر(راسبون)
    اطبع("    نسبة النجاح: ")
    اطبع(ناجحون * 100 / 5)
    اطبع_سطر("%")
    اطبع_سطر("")

    # ---- نظام الملكية ----
    اطبع_سطر("[6] نظام الملكية:")

    # نسخ الدرجات (أرقام تُنسخ)
    رقم درجة_احمد = ط1.المعدل()
    رقم نسخة_درجة = درجة_احمد
    اطبع("    درجة احمد (نسخة): ")
    اطبع_سطر(درجة_احمد)
    اطبع("    نسخة مستقلة: ")
    اطبع_سطر(نسخة_درجة)

    # نقل نص التقرير
    نص تقرير = "نتائج الفصل الدراسي الاول"
    اطبع("    التقرير: ")
    اطبع_سطر(تقرير)
    متغير تقرير_نهائي = تقرير
    اطبع("    التقرير النهائي: ")
    اطبع_سطر(تقرير_نهائي)

    # استعارة اسم المدرسة
    نص اسم_مدرسة = "مدرسة النور"
    متغير م_مرجع = &اسم_مدرسة
    اطبع("    المدرسة (مرجع): ")
    اطبع_سطر(م_مرجع)
    اطبع("    الاصل سليم: ")
    اطبع_سطر(اسم_مدرسة)
    اطبع_سطر("")

    اطبع_سطر("========================================")
    اطبع_سطر("      انتهى البرنامج بنجاح")
    اطبع_سطر("========================================")
نهاية
