# ==============================================
# مكتبة إدارة البيانات
# Data Management Library
# ==============================================

صدّر رقم الحد_الاقصى_للعناصر = 100

صدّر دالة رقم هل_موجب(رقم قيمة)
    إذا (قيمة > 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة رقم هل_سالب(رقم قيمة)
    إذا (قيمة < 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة رقم هل_صفر(رقم قيمة)
    إذا (قيمة == 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة رقم هل_زوجي(رقم قيمة)
    رقم باقي = قيمة - (قيمة / 2) * 2
    إذا (باقي == 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة رقم هل_فردي(رقم قيمة)
    رقم باقي = قيمة - (قيمة / 2) * 2
    إذا (باقي == 0)
        ارجع 0
    نهاية
    ارجع 1
نهاية

صدّر دالة رقم هل_في_نطاق(رقم قيمة، رقم حد_ادنى، رقم حد_اعلى)
    إذا (قيمة >= حد_ادنى)
        إذا (قيمة <= حد_اعلى)
            ارجع 1
        نهاية
    نهاية
    ارجع 0
نهاية

صدّر دالة رقم الباقي(رقم أ، رقم ب)
    رقم ناتج = أ - (أ / ب) * ب
    ارجع ناتج
نهاية

صدّر دالة اطبع_تكرار(حرف، رقم عدد)
    رقم ع = 0
    بينما (ع < عدد)
        اطبع(حرف)
        ع = ع + 1
    نهاية
نهاية
