صدّر دالة رقم طول_سلسلة(محتوى)
    ارجع طول(محتوى)
نهاية

صدّر دالة عرض_مؤطر(محتوى)
    رقم الطول = طول(محتوى) + 4
    رقم ع = 0
    اطبع("+")
    بينما (ع < الطول)
        اطبع("-")
        ع = ع + 1
    نهاية
    اطبع_سطر("+")
    اطبع("| ")
    اطبع(محتوى)
    اطبع_سطر(" |")
    ع = 0
    اطبع("+")
    بينما (ع < الطول)
        اطبع("-")
        ع = ع + 1
    نهاية
    اطبع_سطر("+")
نهاية

صدّر دالة اطبع_مسافة_بادئة(رقم مستوى)
    رقم ع = 0
    بينما (ع < مستوى)
        اطبع("  ")
        ع = ع + 1
    نهاية
نهاية

صدّر دالة اطبع_تقرير_حقل(اسم_حقل، قيمة_حقل)
    اطبع("  ")
    اطبع(اسم_حقل)
    اطبع(": ")
    اطبع_سطر(قيمة_حقل)
نهاية

صدّر دالة اطبع_تقرير_رقم(اسم_حقل، رقم قيمة_حقل)
    اطبع("  ")
    اطبع(اسم_حقل)
    اطبع(": ")
    اطبع_سطر(قيمة_حقل)
نهاية

