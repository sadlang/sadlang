# ==============================================
# مثال 3: نظام الملكية الشامل
# Example 3: Comprehensive Ownership System
# ==============================================
# يوضح هذا المثال جميع مفاهيم نظام الملكية:
# - الأنواع الناسخة (رقم، منطقي) مقابل الأنواع المنقولة (نص)
# - نقل الملكية (Move)
# - الاستعارة المشتركة (Shared Borrow)
# - الاستعارة المتغيرة (Mutable Borrow)
# - النطاقات والتنظيف التلقائي
# - الكشف عن الأخطاء (استخدام بعد النقل)
# ==============================================
# شغّل بـ: sad.exe --ownership 17_ownership.sad
# ==============================================

دالة رئيسية()
    اطبع_سطر("========================================")
    اطبع_سطر("    نظام الملكية الشامل")
    اطبع_سطر("========================================")
    اطبع_سطر("")

    # ========================================
    # القسم 1: الأنواع الناسخة (Copy Types)
    # ========================================
    اطبع_سطر("[1] الانواع الناسخة (رقم، منطقي):")
    اطبع_سطر("    الارقام والمنطقيات تُنسخ تلقائيا")
    اطبع_سطر("")

    رقم عدد = 100
    رقم نسخة_عدد = عدد
    نسخة_عدد = نسخة_عدد + 50

    اطبع("    الاصل: ")
    اطبع(عدد)
    اطبع_سطر(" (لم يتأثر)")
    اطبع("    النسخة: ")
    اطبع(نسخة_عدد)
    اطبع_سطر(" (معدلة مستقلة)")
    اطبع_سطر("")

    # عدة نسخ من نفس القيمة
    رقم أ = 42
    رقم ب = أ
    رقم ج = أ
    رقم د = أ
    اطبع("    أ=")
    اطبع(أ)
    اطبع(" ب=")
    اطبع(ب)
    اطبع(" ج=")
    اطبع(ج)
    اطبع(" د=")
    اطبع_سطر(د)
    اطبع_سطر("    -> جميعها نسخ مستقلة")
    اطبع_سطر("")

    # ========================================
    # القسم 2: نقل الملكية (Move Semantics)
    # ========================================
    اطبع_سطر("[2] نقل الملكية (النصوص):")
    اطبع_سطر("    النصوص تُنقل - الأصل يُبطل")
    اطبع_سطر("")

    نص رسالة = "هذه رسالة مهمة جداً"
    اطبع("    قبل النقل: ")
    اطبع_سطر(رسالة)

    متغير رسالة_منقولة = رسالة
    اطبع("    بعد النقل: ")
    اطبع_سطر(رسالة_منقولة)
    اطبع_سطر("    -> 'رسالة' لم تعد صالحة للاستخدام")
    اطبع_سطر("")

    # سلسلة نقل
    نص بيانات = "بيانات سرية"
    اطبع("    بيانات -> مخزن: ")
    متغير مخزن = بيانات
    اطبع_سطر(مخزن)
    اطبع("    مخزن -> أرشيف: ")
    متغير أرشيف = مخزن
    اطبع_سطر(أرشيف)
    اطبع_سطر("    -> كل نقل يُبطل المصدر")
    اطبع_سطر("")

    # ========================================
    # القسم 3: الاستعارة المشتركة
    # ========================================
    اطبع_سطر("[3] الاستعارة المشتركة (قراءة فقط):")
    اطبع_سطر("    عدة مراجع قراءة مسموحة")
    اطبع_سطر("")

    نص مستند = "دستور الدولة"
    متغير قارئ1 = &مستند
    متغير قارئ2 = &مستند
    متغير قارئ3 = &مستند

    اطبع("    الاصل: ")
    اطبع_سطر(مستند)
    اطبع("    قارئ 1: ")
    اطبع_سطر(قارئ1)
    اطبع("    قارئ 2: ")
    اطبع_سطر(قارئ2)
    اطبع("    قارئ 3: ")
    اطبع_سطر(قارئ3)
    اطبع_سطر("    -> الأصل والمراجع جميعها صالحة")
    اطبع_سطر("")

    # ========================================
    # القسم 4: نظام الملكية مع الحلقات
    # ========================================
    اطبع_سطر("[4] الملكية مع الحلقات:")
    اطبع_سطر("")

    رقم مجموع = 0
    رقم عداد = 1
    بينما (عداد <= 5)
        # الأرقام تُنسخ في كل تكرار
        رقم قيمة = عداد * 10
        مجموع = مجموع + قيمة
        اطبع("    التكرار ")
        اطبع(عداد)
        اطبع(": قيمة=")
        اطبع(قيمة)
        اطبع(" مجموع=")
        اطبع_سطر(مجموع)
        عداد = عداد + 1
    نهاية
    اطبع("    المجموع النهائي: ")
    اطبع_سطر(مجموع)
    اطبع_سطر("")

    # ========================================
    # القسم 5: الملكية مع الشروط
    # ========================================
    اطبع_سطر("[5] الملكية مع الشروط:")
    اطبع_سطر("")

    نص حالة_النظام = "مستقر"
    اطبع("    حالة النظام: ")
    اطبع_سطر(حالة_النظام)

    # استعارة للقراءة فقط
    متغير فحص = &حالة_النظام
    اطبع("    فحص الحالة: ")
    اطبع_سطر(فحص)
    اطبع_سطر("")

    # ========================================
    # القسم 6: مقارنة النسخ والنقل
    # ========================================
    اطبع_سطر("[6] مقارنة النسخ والنقل:")
    اطبع_سطر("")

    # رقم (نسخ)
    رقم سعر = 99
    رقم سعر_مخفض = سعر
    سعر_مخفض = سعر_مخفض - 20
    اطبع("    رقم - السعر الاصلي: ")
    اطبع_سطر(سعر)
    اطبع("    رقم - السعر المخفض: ")
    اطبع_سطر(سعر_مخفض)
    اطبع_سطر("    -> كلاهما صالح (نسخ)")
    اطبع_سطر("")

    # نص (نقل)
    نص اسم_منتج = "هاتف ذكي"
    اطبع("    نص - اسم المنتج: ")
    اطبع_سطر(اسم_منتج)
    متغير اسم_مؤرشف = اسم_منتج
    اطبع("    نص - الاسم المؤرشف: ")
    اطبع_سطر(اسم_مؤرشف)
    اطبع_سطر("    -> الاصل مُبطل (نقل)")
    اطبع_سطر("")

    # ========================================
    # القسم 7: أنماط الاستخدام الصحيحة
    # ========================================
    اطبع_سطر("[7] انماط الاستخدام الصحيحة:")
    اطبع_سطر("")

    # النمط 1: استعر بدل النقل
    نص تقرير = "تقرير الأداء السنوي"
    متغير نظرة1 = &تقرير
    متغير نظرة2 = &تقرير
    اطبع("    النمط 1 (استعارة): ")
    اطبع(نظرة1)
    اطبع(" = ")
    اطبع_سطر(نظرة2)
    اطبع("    الأصل سليم: ")
    اطبع_سطر(تقرير)
    اطبع_سطر("")

    # النمط 2: نسخ الأرقام بحرية
    رقم درجة = 95
    رقم د1 = درجة
    رقم د2 = درجة
    رقم د3 = درجة
    اطبع("    النمط 2 (نسخ): ")
    اطبع(د1)
    اطبع(", ")
    اطبع(د2)
    اطبع(", ")
    اطبع_سطر(د3)
    اطبع_سطر("")

    اطبع_سطر("========================================")
    اطبع_سطر("    انتهى البرنامج بنجاح")
    اطبع_سطر("========================================")
نهاية
