# المثال الثالث: حلقات التكرار
# Example 03: Loops (While Loop)

دالة رئيسية()
    اطبع_سطر("============================")
    اطبع_سطر("   حلقات التكرار")
    اطبع_سطر("============================")
    اطبع_سطر("")

    # اسأل المستخدم عن الحد الأعلى
    اطبع("ادخل عدد مرات العد: ")
    متغير حد = لرقم(اقرأ())

    اطبع_سطر("")
    اطبع_سطر("--- العد التصاعدي ---")

    # حلقة while للعد التصاعدي
    متغير عداد = 1
    بينما (عداد <= حد)
        اطبع(عداد)
        اطبع(" ")
        عداد = عداد + 1
    نهاية

    اطبع_سطر("")
    اطبع_سطر("")
    اطبع_سطر("--- جمع الاعداد ---")

    # حساب مجموع الأعداد من 1 إلى حد
    متغير مجموع = 0
    متغير ي = 1
    بينما (ي <= حد)
        مجموع = مجموع + ي
        ي = ي + 1
    نهاية

    اطبع("مجموع الاعداد من 1 الى ")
    اطبع(حد)
    اطبع(" = ")
    اطبع_سطر(مجموع)

    اطبع_سطر("")
    اطبع_سطر("تم بنجاح!")
نهاية
