دالة رئيسية()
    اطبع_سطر("===================================")
    اطبع_سطر("     لعبة تحليل الأرقام")
    اطبع_سطر("===================================")
    اطبع_سطر("")

    اطبع("ادخل عدد الأرقام التي تريد تحليلها (2-10): ")
    متغير عدد = لرقم(اقرأ())

    متغير المجموع = 0
    متغير الأكبر = 0
    متغير الأصغر = 999999
    متغير عداد = 1
    متغير الموجب = 0
    متغير السالب = 0
    متغير الزوجي = 0
    متغير الفردي = 0

    بينما (عداد <= عدد)
        اطبع("ادخل الرقم ")
        اطبع(عداد)
        اطبع(": ")
        متغير القيمة = لرقم(اقرأ())

        المجموع = المجموع + القيمة

        إذا (القيمة > الأكبر)
            الأكبر = القيمة
        نهاية

        إذا (القيمة < الأصغر)
            الأصغر = القيمة
        نهاية

        إذا (القيمة >= 0)
            الموجب = الموجب + 1
        وإلا
            السالب = السالب + 1
        نهاية

        متغير باقي = القيمة - (القيمة / 2) * 2
        إذا (باقي == 0)
            الزوجي = الزوجي + 1
        وإلا
            الفردي = الفردي + 1
        نهاية

        عداد = عداد + 1
    نهاية

    متغير المتوسط = المجموع / عدد

    اطبع_سطر("")
    اطبع_سطر("===================================")
    اطبع_سطر("         نتائج التحليل")
    اطبع_سطر("===================================")
    اطبع("المجموع: ")
    اطبع_سطر(المجموع)
    اطبع("المتوسط: ")
    اطبع_سطر(المتوسط)
    اطبع("أكبر قيمة: ")
    اطبع_سطر(الأكبر)
    اطبع("أصغر قيمة: ")
    اطبع_سطر(الأصغر)
    اطبع("المدى: ")
    اطبع_سطر(الأكبر - الأصغر)
    اطبع_سطر("-----------------------------------")
    اطبع("أرقام موجبة: ")
    اطبع_سطر(الموجب)
    اطبع("أرقام سالبة: ")
    اطبع_سطر(السالب)
    اطبع("أرقام زوجية: ")
    اطبع_سطر(الزوجي)
    اطبع("أرقام فردية: ")
    اطبع_سطر(الفردي)
    اطبع_سطر("===================================")

    إذا (المتوسط >= 80)
        اطبع_سطر("📊 التقييم: ممتاز!")
    وإلا_إذا (المتوسط >= 60)
        اطبع_سطر("📊 التقييم: جيد")
    وإلا_إذا (المتوسط >= 40)
        اطبع_سطر("📊 التقييم: متوسط")
    وإلا
        اطبع_سطر("📊 التقييم: ضعيف")
    نهاية

    اطبع_سطر("===================================")
نهاية
