دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════════════════╗")
    اطبع_سطر("║             🧮 الآلة الحاسبة العلمية المتقدمة            ║")
    اطبع_سطر("║         Advanced Scientific Calculator System            ║")
    اطبع_سطر("╚══════════════════════════════════════════════════════════╝")
    اطبع_سطر("")
    اطبع_سطر("📌 التعليمات:")
    اطبع_سطر("   أدخل العمليات والأرقام المطلوبة")
    اطبع_سطر("   البرنامج يدعم عمليات حسابية متعددة")
    اطبع_سطر("   أدخل 0 للخروج من البرنامج")
    اطبع_سطر("")

    متغير عمليات_جمع = 0
    متغير عمليات_طرح = 0
    متغير عمليات_ضرب = 0
    متغير عمليات_قسمة = 0
    متغير عمليات_باقي = 0
    متغير عمليات_قوة = 0
    متغير عمليات_مضروب = 0
    متغير عمليات_أخرى = 0
    متغير إجمالي_العمليات = 0
    متغير أكبر_نتيجة = 0
    متغير أصغر_نتيجة = 999999999
    متغير مجموع_النتائج = 0
    متغير مستمر = 1

    بينما (مستمر > 0)
        اطبع_سطر("")
        اطبع_سطر("┌──────────────────────────────────────┐")
        اطبع_سطر("│        📋 قائمة العمليات              │")
        اطبع_سطر("├──────────────────────────────────────┤")
        اطبع_سطر("│  1️⃣  ➕ الجمع                         │")
        اطبع_سطر("│  2️⃣  ➖ الطرح                         │")
        اطبع_سطر("│  3️⃣  ✖️ الضرب                         │")
        اطبع_سطر("│  4️⃣  ➗ القسمة                        │")
        اطبع_سطر("│  5️⃣  🔢 باقي القسمة                   │")
        اطبع_سطر("│  6️⃣  📐 القوة (أس)                    │")
        اطبع_سطر("│  7️⃣  ❗ المضروب (!)                   │")
        اطبع_سطر("│  8️⃣  🔄 تحويل درجة حرارة              │")
        اطبع_سطر("│  9️⃣  📊 سلسلة حسابية                  │")
        اطبع_سطر("│  🔟  📈 جدول الضرب                     │")
        اطبع_سطر("│  0️⃣  🚪 خروج                          │")
        اطبع_سطر("└──────────────────────────────────────┘")

        اطبع("👉 اختر العملية: ")
        متغير اختيار = لرقم(اقرأ())

        إذا (اختيار == 0)
            مستمر = 0
        وإلا_إذا (اختيار == 1)
            اطبع_سطر("")
            اطبع_سطر("  ➕ عملية الجمع")
            اطبع("  أدخل العدد الأول: ")
            متغير أ = لرقم(اقرأ())
            اطبع("  أدخل العدد الثاني: ")
            متغير ب = لرقم(اقرأ())
            متغير ناتج = أ + ب
            اطبع("  ✅ الناتج: ")
            اطبع(أ)
            اطبع(" + ")
            اطبع(ب)
            اطبع(" = ")
            اطبع_سطر(ناتج)
            عمليات_جمع = عمليات_جمع + 1
            إجمالي_العمليات = إجمالي_العمليات + 1
            مجموع_النتائج = مجموع_النتائج + ناتج
            إذا (ناتج > أكبر_نتيجة)
                أكبر_نتيجة = ناتج
            نهاية
            إذا (ناتج < أصغر_نتيجة)
                أصغر_نتيجة = ناتج
            نهاية

        وإلا_إذا (اختيار == 2)
            اطبع_سطر("")
            اطبع_سطر("  ➖ عملية الطرح")
            اطبع("  أدخل العدد الأول: ")
            متغير أ = لرقم(اقرأ())
            اطبع("  أدخل العدد الثاني: ")
            متغير ب = لرقم(اقرأ())
            متغير ناتج = أ - ب
            اطبع("  ✅ الناتج: ")
            اطبع(أ)
            اطبع(" - ")
            اطبع(ب)
            اطبع(" = ")
            اطبع_سطر(ناتج)
            عمليات_طرح = عمليات_طرح + 1
            إجمالي_العمليات = إجمالي_العمليات + 1
            مجموع_النتائج = مجموع_النتائج + ناتج
            إذا (ناتج > أكبر_نتيجة)
                أكبر_نتيجة = ناتج
            نهاية
            إذا (ناتج < أصغر_نتيجة)
                أصغر_نتيجة = ناتج
            نهاية

        وإلا_إذا (اختيار == 3)
            اطبع_سطر("")
            اطبع_سطر("  ✖️ عملية الضرب")
            اطبع("  أدخل العدد الأول: ")
            متغير أ = لرقم(اقرأ())
            اطبع("  أدخل العدد الثاني: ")
            متغير ب = لرقم(اقرأ())
            متغير ناتج = أ * ب
            اطبع("  ✅ الناتج: ")
            اطبع(أ)
            اطبع(" × ")
            اطبع(ب)
            اطبع(" = ")
            اطبع_سطر(ناتج)
            عمليات_ضرب = عمليات_ضرب + 1
            إجمالي_العمليات = إجمالي_العمليات + 1
            مجموع_النتائج = مجموع_النتائج + ناتج
            إذا (ناتج > أكبر_نتيجة)
                أكبر_نتيجة = ناتج
            نهاية
            إذا (ناتج < أصغر_نتيجة)
                أصغر_نتيجة = ناتج
            نهاية

        وإلا_إذا (اختيار == 4)
            اطبع_سطر("")
            اطبع_سطر("  ➗ عملية القسمة")
            اطبع("  أدخل العدد الأول (المقسوم): ")
            متغير أ = لرقم(اقرأ())
            اطبع("  أدخل العدد الثاني (المقسوم عليه): ")
            متغير ب = لرقم(اقرأ())
            إذا (ب == 0)
                اطبع_سطر("  ⚠️ خطأ: لا يمكن القسمة على صفر!")
            وإلا
                متغير ناتج = أ / ب
                متغير باقي = أ - (ناتج * ب)
                اطبع("  ✅ الناتج: ")
                اطبع(أ)
                اطبع(" ÷ ")
                اطبع(ب)
                اطبع(" = ")
                اطبع(ناتج)
                اطبع(" والباقي ")
                اطبع_سطر(باقي)
                عمليات_قسمة = عمليات_قسمة + 1
                إجمالي_العمليات = إجمالي_العمليات + 1
                مجموع_النتائج = مجموع_النتائج + ناتج
                إذا (ناتج > أكبر_نتيجة)
                    أكبر_نتيجة = ناتج
                نهاية
                إذا (ناتج < أصغر_نتيجة)
                    أصغر_نتيجة = ناتج
                نهاية
            نهاية

        وإلا_إذا (اختيار == 5)
            اطبع_سطر("")
            اطبع_سطر("  🔢 باقي القسمة")
            اطبع("  أدخل العدد: ")
            متغير أ = لرقم(اقرأ())
            اطبع("  أدخل المقسوم عليه: ")
            متغير ب = لرقم(اقرأ())
            إذا (ب == 0)
                اطبع_سطر("  ⚠️ خطأ: لا يمكن القسمة على صفر!")
            وإلا
                متغير حاصل = أ / ب
                متغير ناتج = أ - (حاصل * ب)
                اطبع("  ✅ باقي قسمة ")
                اطبع(أ)
                اطبع(" على ")
                اطبع(ب)
                اطبع(" = ")
                اطبع_سطر(ناتج)

                إذا (ناتج == 0)
                    اطبع("  💡 ")
                    اطبع(أ)
                    اطبع(" يقبل القسمة على ")
                    اطبع_سطر(ب)
                وإلا
                    اطبع("  💡 ")
                    اطبع(أ)
                    اطبع(" لا يقبل القسمة على ")
                    اطبع_سطر(ب)
                نهاية
                عمليات_باقي = عمليات_باقي + 1
                إجمالي_العمليات = إجمالي_العمليات + 1
            نهاية

        وإلا_إذا (اختيار == 6)
            اطبع_سطر("")
            اطبع_سطر("  📐 حساب القوة (الأس)")
            اطبع("  أدخل الأساس: ")
            متغير أساس = لرقم(اقرأ())
            اطبع("  أدخل الأس: ")
            متغير أس = لرقم(اقرأ())
            متغير ناتج = 1
            متغير ع = 0
            بينما (ع < أس)
                ناتج = ناتج * أساس
                ع = ع + 1
            نهاية
            اطبع("  ✅ ")
            اطبع(أساس)
            اطبع(" ^ ")
            اطبع(أس)
            اطبع(" = ")
            اطبع_سطر(ناتج)
            عمليات_قوة = عمليات_قوة + 1
            إجمالي_العمليات = إجمالي_العمليات + 1
            مجموع_النتائج = مجموع_النتائج + ناتج
            إذا (ناتج > أكبر_نتيجة)
                أكبر_نتيجة = ناتج
            نهاية

        وإلا_إذا (اختيار == 7)
            اطبع_سطر("")
            اطبع_سطر("  ❗ حساب المضروب (!)")
            اطبع("  أدخل العدد (0-15): ")
            متغير ن = لرقم(اقرأ())
            إذا (ن < 0)
                اطبع_سطر("  ⚠️ خطأ: المضروب غير معرف للأعداد السالبة!")
            وإلا
                متغير ناتج = 1
                متغير ع = 1
                بينما (ع <= ن)
                    ناتج = ناتج * ع
                    ع = ع + 1
                نهاية
                اطبع("  ✅ ")
                اطبع(ن)
                اطبع("! = ")
                اطبع_سطر(ناتج)
                عمليات_مضروب = عمليات_مضروب + 1
                إجمالي_العمليات = إجمالي_العمليات + 1
                مجموع_النتائج = مجموع_النتائج + ناتج
                إذا (ناتج > أكبر_نتيجة)
                    أكبر_نتيجة = ناتج
                نهاية
            نهاية

        وإلا_إذا (اختيار == 8)
            اطبع_سطر("")
            اطبع_سطر("  🔄 تحويل درجة الحرارة")
            اطبع_سطر("  1 = سيليزيوس → فهرنهايت")
            اطبع_سطر("  2 = فهرنهايت → سيليزيوس")
            اطبع("  اختر نوع التحويل: ")
            متغير نوع_تحويل = لرقم(اقرأ())
            إذا (نوع_تحويل == 1)
                اطبع("  أدخل درجة الحرارة بالسيليزيوس: ")
                متغير درجة = لرقم(اقرأ())
                متغير فهرنهايت = (درجة * 9) / 5 + 32
                اطبع("  ✅ ")
                اطبع(درجة)
                اطبع("°C = ")
                اطبع(فهرنهايت)
                اطبع_سطر("°F")
                إذا (درجة >= 100)
                    اطبع_سطر("  🔥 درجة حرارة عالية! (أعلى من الغليان)")
                وإلا_إذا (درجة >= 37)
                    اطبع_سطر("  🌡️ درجة حرارة دافئة إلى حارة")
                وإلا_إذا (درجة >= 0)
                    اطبع_سطر("  ❄️ درجة حرارة باردة إلى معتدلة")
                وإلا
                    اطبع_سطر("  🥶 تحت الصفر! درجة حرارة تجمد")
                نهاية
                عمليات_أخرى = عمليات_أخرى + 1
                إجمالي_العمليات = إجمالي_العمليات + 1
            وإلا_إذا (نوع_تحويل == 2)
                اطبع("  أدخل درجة الحرارة بالفهرنهايت: ")
                متغير درجة = لرقم(اقرأ())
                متغير سيليزيوس = ((درجة - 32) * 5) / 9
                اطبع("  ✅ ")
                اطبع(درجة)
                اطبع("°F = ")
                اطبع(سيليزيوس)
                اطبع_سطر("°C")
                عمليات_أخرى = عمليات_أخرى + 1
                إجمالي_العمليات = إجمالي_العمليات + 1
            وإلا
                اطبع_سطر("  ⚠️ اختيار غير صحيح!")
            نهاية

        وإلا_إذا (اختيار == 9)
            اطبع_سطر("")
            اطبع_سطر("  📊 السلسلة الحسابية (1+2+3+...+ن)")
            اطبع("  أدخل العدد ن: ")
            متغير ن = لرقم(اقرأ())
            متغير مجموع = 0
            متغير ع = 1
            اطبع("  ")
            بينما (ع <= ن)
                مجموع = مجموع + ع
                إذا (ع > 1)
                    اطبع(" + ")
                نهاية
                اطبع(ع)
                ع = ع + 1
            نهاية
            اطبع(" = ")
            اطبع_سطر(مجموع)
            اطبع("  💡 بطريقة غاوس: ن×(ن+1)/2 = ")
            متغير غاوس = (ن * (ن + 1)) / 2
            اطبع_سطر(غاوس)
            عمليات_أخرى = عمليات_أخرى + 1
            إجمالي_العمليات = إجمالي_العمليات + 1

        وإلا_إذا (اختيار == 10)
            اطبع_سطر("")
            اطبع_سطر("  📈 جدول الضرب")
            اطبع("  أدخل الرقم: ")
            متغير ن = لرقم(اقرأ())
            اطبع_سطر("  ┌──────────────────────┐")
            اطبع("  │ جدول ضرب العدد ")
            اطبع(ن)
            اطبع_سطر("       │")
            اطبع_سطر("  ├──────────────────────┤")
            متغير ع = 1
            بينما (ع <= 12)
                اطبع("  │  ")
                اطبع(ن)
                اطبع(" × ")
                اطبع(ع)
                اطبع(" = ")
                اطبع_سطر(ن * ع)
                ع = ع + 1
            نهاية
            اطبع_سطر("  └──────────────────────┘")
            عمليات_أخرى = عمليات_أخرى + 1
            إجمالي_العمليات = إجمالي_العمليات + 1
        وإلا
            اطبع_سطر("  ⚠️ اختيار غير صحيح! الرجاء اختيار 0-10")
        نهاية
    نهاية

    اطبع_سطر("")
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════════════════════════════════════╗")
    اطبع_سطر("║                📊 إحصائيات الجلسة                        ║")
    اطبع_سطر("╠══════════════════════════════════════════════════════════╣")
    اطبع("║  🔢 إجمالي العمليات: ")
    اطبع_سطر(إجمالي_العمليات)
    اطبع_سطر("║                                                          ║")
    اطبع_سطر("║  📋 تفصيل العمليات:")
    اطبع("║     ➕ جمع: ")
    اطبع_سطر(عمليات_جمع)
    اطبع("║     ➖ طرح: ")
    اطبع_سطر(عمليات_طرح)
    اطبع("║     ✖️ ضرب: ")
    اطبع_سطر(عمليات_ضرب)
    اطبع("║     ➗ قسمة: ")
    اطبع_سطر(عمليات_قسمة)
    اطبع("║     🔢 باقي: ")
    اطبع_سطر(عمليات_باقي)
    اطبع("║     📐 قوة: ")
    اطبع_سطر(عمليات_قوة)
    اطبع("║     ❗ مضروب: ")
    اطبع_سطر(عمليات_مضروب)
    اطبع("║     🔄 أخرى: ")
    اطبع_سطر(عمليات_أخرى)
    اطبع_سطر("║                                                          ║")

    إذا (إجمالي_العمليات > 0)
        متغير معدل = مجموع_النتائج / إجمالي_العمليات
        اطبع("║  📈 أكبر نتيجة: ")
        اطبع_سطر(أكبر_نتيجة)
        اطبع("║  📉 أصغر نتيجة: ")
        اطبع_سطر(أصغر_نتيجة)
        اطبع("║  📊 متوسط النتائج: ")
        اطبع_سطر(معدل)

        اطبع_سطر("║                                                          ║")
        اطبع("║  🏆 العملية الأكثر استخداماً: ")
        متغير أكثر = عمليات_جمع
        متغير اسم_أكثر = 1
        إذا (عمليات_طرح > أكثر)
            أكثر = عمليات_طرح
            اسم_أكثر = 2
        نهاية
        إذا (عمليات_ضرب > أكثر)
            أكثر = عمليات_ضرب
            اسم_أكثر = 3
        نهاية
        إذا (عمليات_قسمة > أكثر)
            أكثر = عمليات_قسمة
            اسم_أكثر = 4
        نهاية
        إذا (عمليات_أخرى > أكثر)
            أكثر = عمليات_أخرى
            اسم_أكثر = 5
        نهاية

        إذا (اسم_أكثر == 1)
            اطبع_سطر("الجمع ➕")
        وإلا_إذا (اسم_أكثر == 2)
            اطبع_سطر("الطرح ➖")
        وإلا_إذا (اسم_أكثر == 3)
            اطبع_سطر("الضرب ✖️")
        وإلا_إذا (اسم_أكثر == 4)
            اطبع_سطر("القسمة ➗")
        وإلا
            اطبع_سطر("عمليات أخرى 🔄")
        نهاية
    وإلا
        اطبع_سطر("║  📊 لم يتم إجراء أي عمليات!")
    نهاية

    اطبع_سطر("║                                                          ║")
    اطبع_سطر("╚══════════════════════════════════════════════════════════╝")
    اطبع_سطر("")
    اطبع_سطر("👋 شكراً لاستخدام الآلة الحاسبة العلمية!")
    اطبع_سطر("   Powered by لغة ص (Sad Language) 🇸🇦")
نهاية
