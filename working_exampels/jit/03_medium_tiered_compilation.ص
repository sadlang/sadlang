# ---- أدوات التسجيل ----

دالة سج_درجة(نص درجة، نص تفاصيل)
    اطبع_سطر("  [" + درجة + "] " + تفاصيل)
نهاية

# ---- نظام الدرجات ----

دالة نص اسم_درجة(رقم درجة)
    إذا (درجة == 0)
        ارجع "مفسر (Interpreter)"
    نهاية
    إذا (درجة == 1)
        ارجع "JIT أساسي (Baseline)"
    نهاية
    إذا (درجة == 2)
        ارجع "JIT محسّن (Optimized)"
    نهاية
    إذا (درجة == 3)
        ارجع "AOT كامل (Ahead-of-Time)"
    نهاية
    ارجع "غير معروف"
نهاية

دالة رقم حساب_سرعة(رقم درجة)
    إذا (درجة == 0)
        ارجع 1
    نهاية
    إذا (درجة == 1)
        ارجع 10
    نهاية
    إذا (درجة == 2)
        ارجع 50
    نهاية
    إذا (درجة == 3)
        ارجع 100
    نهاية
    ارجع 1
نهاية

دالة رقم زمن_بناء(رقم درجة)
    إذا (درجة == 0)
        ارجع 0
    نهاية
    إذا (درجة == 1)
        ارجع 5
    نهاية
    إذا (درجة == 2)
        ارجع 50
    نهاية
    إذا (درجة == 3)
        ارجع 500
    نهاية
    ارجع 0
نهاية

# ---- محاكاة تنفيذ دالة ----

دالة محاكاة_دالة(نص اسم، رقم تنفيذات)
    اطبع_سطر("  ── دالة: " + اسم + " ──")
    اطبع_سطر("    تنفيذات مطلوبة: " + لنص(تنفيذات))
    اطبع_سطر("")

    رقم الدرجة_الحالية = 0
    رقم تنفيذ_حالي = 0
    رقم زمن_إجمالي = 0

    طالما (تنفيذ_حالي < تنفيذات)
        رقم حد_ترقية = 0

        إذا (الدرجة_الحالية == 0)
            حد_ترقية = 50
        نهاية
        إذا (الدرجة_الحالية == 1)
            حد_ترقية = 200
        نهاية
        إذا (الدرجة_الحالية == 2)
            حد_ترقية = 1000
        نهاية
        إذا (الدرجة_الحالية == 3)
            حد_ترقية = 999999
        نهاية

        رقم دفعة = حد_ترقية - تنفيذ_حالي
        إذا (دفعة <= 0)
            دفعة = تنفيذات - تنفيذ_حالي
        نهاية
        إذا (تنفيذ_حالي + دفعة > تنفيذات)
            دفعة = تنفيذات - تنفيذ_حالي
        نهاية
        إذا (تنفيذ_حالي + دفعة > حد_ترقية)
            دفعة = حد_ترقية - تنفيذ_حالي
        نهاية

        إذا (دفعة <= 0)
            دفعة = 1
        نهاية

        رقم سرعة = حساب_سرعة(الدرجة_الحالية)
        رقم زمن_دفعة = دفعة / سرعة
        إذا (زمن_دفعة < 1)
            زمن_دفعة = 1
        نهاية

        متغير نص اسم_م = اسم_درجة(الدرجة_الحالية)
        اطبع_سطر("    [" + اسم_م + "] تنفيذ " + لنص(دفعة) + " دورة (زمن: " + لنص(زمن_دفعة) + ")")

        تنفيذ_حالي = تنفيذ_حالي + دفعة
        زمن_إجمالي = زمن_إجمالي + زمن_دفعة

        إذا (تنفيذ_حالي >= حد_ترقية)
            إذا (الدرجة_الحالية < 3)
                الدرجة_الحالية = الدرجة_الحالية + 1
                رقم زمن_ت = زمن_بناء(الدرجة_الحالية)
                زمن_إجمالي = زمن_إجمالي + زمن_ت
                متغير نص اسم_جديد = اسم_درجة(الدرجة_الحالية)
                اطبع_سطر("    ⬆ ترقية إلى: " + اسم_جديد + " (زمن البناء: " + لنص(زمن_ت) + ")")
            نهاية
        نهاية

        إذا (تنفيذ_حالي >= تنفيذات)
            تنفيذ_حالي = تنفيذات
        نهاية
    نهاية

    اطبع_سطر("    ── النتيجة ──")
    اطبع_سطر("    التنفيذات: " + لنص(تنفيذ_حالي))
    اطبع_سطر("    الزمن الإجمالي: " + لنص(زمن_إجمالي))
    متغير نص درجة_نهائية = اسم_درجة(الدرجة_الحالية)
    اطبع_سطر("    الدرجة النهائية: " + درجة_نهائية)
    اطبع_سطر("")
نهاية

# ---- مقارنة الأوضاع ----

دالة مقارنة_أوضاع()
    اطبع_سطر("=== مقارنة أوضاع التنفيذ ===")
    اطبع_سطر("")

    رقم عمليات = 10000

    اطبع_سطر("  لـ " + لنص(عمليات) + " عملية:")
    اطبع_سطر("")

    رقم م = 0
    طالما (م <= 3)
        متغير نص اسم_و = اسم_درجة(م)
        رقم سرعة_و = حساب_سرعة(م)
        رقم زمن_و = عمليات / سرعة_و
        رقم زمن_ب = زمن_بناء(م)
        رقم إجمالي_و = زمن_و + زمن_ب

        اطبع_سطر("  " + اسم_و)
        اطبع_سطر("    السرعة: " + لنص(سرعة_و) + "x")
        اطبع_سطر("    زمن التنفيذ: " + لنص(زمن_و))
        اطبع_سطر("    زمن البناء: " + لنص(زمن_ب))
        اطبع_سطر("    الإجمالي: " + لنص(إجمالي_و))
        اطبع_سطر("")

        م = م + 1
    نهاية
نهاية

