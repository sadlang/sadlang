    اطبع_سطر("    2 → JIT محسّن: بناء أبطأ، أداء أفضل")
    اطبع_سطر("    3 → AOT كامل: بناء طويل، أداء أمثل")
    اطبع_سطر("")
    اطبع_سطر("  الاستراتيجية:")
    اطبع_سطر("    - البدء بالمفسر لجميع الدوال")
    اطبع_سطر("    - مراقبة تكرار التنفيذ")
    اطبع_سطر("    - ترقية الدوال الساخنة تدريجياً")
    اطبع_سطر("    - الدوال الباردة تبقى في المفسر")
نهاية

