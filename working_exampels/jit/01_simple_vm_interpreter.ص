# مثال 01: محاكاة آلة افتراضية بسيطة
# محاكاة مكدس عمليات وسجلات
# المستوى: بسيط
# ==============================================

# ---- تسجيل العمليات ----

دالة سج_عملية(نص عملية، نص تفاصيل)
    اطبع_سطر("  [" + عملية + "] " + تفاصيل)
نهاية

دالة عرض_نتيجة(نص وصف، رقم قيمته)
    نص ق = لنص(قيمته)
    اطبع_سطر("    ← " + وصف + " = " + ق)
نهاية

# ---- محاكاة المكدس ----

دالة محاكاة_مكدس()
    اطبع_سطر("=== محاكاة المكدس ===")
    اطبع_سطر("")

    رقم م0 = 0
    رقم م1 = 0
    رقم م2 = 0
    رقم دليل_م = 0

    سج_عملية("PUSH"، "دفع 10")
    م0 = 10
    دليل_م = 1
    عرض_نتيجة("دليل المكدس"، دليل_م)

    سج_عملية("PUSH"، "دفع 20")
    م1 = 20
    دليل_م = 2
    عرض_نتيجة("دليل المكدس"، دليل_م)

    سج_عملية("PUSH"، "دفع 30")
    م2 = 30
    دليل_م = 3
    عرض_نتيجة("دليل المكدس"، دليل_م)

    سج_عملية("ADD"، "جمع القمتين")
    رقم حاصل = م1 + م2
    دليل_م = 2
    عرض_نتيجة("نتيجة الجمع"، حاصل)

    سج_عملية("MUL"، "ضرب القمتين")
    رقم ناتج = م0 * حاصل
    دليل_م = 1
    عرض_نتيجة("نتيجة الضرب"، ناتج)

    اطبع_سطر("")
    نص ن_ن = لنص(ناتج)
    اطبع_سطر("  النتيجة النهائية: " + ن_ن)
    اطبع_سطر("")
نهاية

# ---- محاكاة السجلات ----

دالة محاكاة_سجلات()
    اطبع_سطر("=== محاكاة السجلات ===")
    اطبع_سطر("")

    رقم ر0 = 0
    رقم ر1 = 0
    رقم ر2 = 0
    رقم ر3 = 0

    سج_عملية("LOAD"، "R0 = 100")
    ر0 = 100
    عرض_نتيجة("R0"، ر0)

    سج_عملية("LOAD"، "R1 = 50")
    ر1 = 50
    عرض_نتيجة("R1"، ر1)

    سج_عملية("ADD"، "R2 = R0 + R1")
    ر2 = ر0 + ر1
    عرض_نتيجة("R2"، ر2)

    سج_عملية("SUB"، "R3 = R0 - R1")
    ر3 = ر0 - ر1
    عرض_نتيجة("R3"، ر3)

    سج_عملية("MUL"، "R0 = R2 * R3")
    ر0 = ر2 * ر3
    عرض_نتيجة("R0"، ر0)

    اطبع_سطر("")
    نص ن0 = لنص(ر0)
    نص ن1 = لنص(ر1)
    نص ن2 = لنص(ر2)
    نص ن3 = لنص(ر3)
    اطبع_سطر("  النتائج النهائية:")
    اطبع_سطر("    R0 = " + ن0)
    اطبع_سطر("    R1 = " + ن1)
    اطبع_سطر("    R2 = " + ن2)
    اطبع_سطر("    R3 = " + ن3)
    اطبع_سطر("")
نهاية

# ---- محاكاة حلقة ----

دالة محاكاة_حلقة()
    اطبع_سطر("=== محاكاة حلقة برنامج ===")
    اطبع_سطر("")

    رقم مجموع = 0
    رقم عداد = 1
    رقم تعليمات = 0

    طالما (عداد <= 10)
        نص ع_ن = لنص(عداد)
        سج_عملية("ADD"، "مجموع += " + ع_ن)
        مجموع = مجموع + عداد
        عداد = عداد + 1
        تعليمات = تعليمات + 2
    نهاية

    اطبع_سطر("")
    نص مج_ن = لنص(مجموع)
    نص تع_ن = لنص(تعليمات)
    اطبع_سطر("  المجموع = " + مج_ن)
    اطبع_سطر("  التعليمات المنفذة = " + تع_ن)
    اطبع_سطر("")
نهاية

# ---- محاكاة التعليمات المشروطة ----

دالة محاكاة_شروط()
    اطبع_سطر("=== محاكاة التعليمات المشروطة ===")
    اطبع_سطر("")

    رقم قاعدة = 42
    رقم مقارنة_ب = 42
    رقم قفزات = 0

    نص ق_ن = لنص(قاعدة)
    نص م_ن = لنص(مقارنة_ب)
    سج_عملية("CMP"، "مقارنة " + ق_ن + " مع " + م_ن)

    إذا (قاعدة == مقارنة_ب)
        سج_عملية("JEQ"، "القفز - متساويان")
        قفزات = قفزات + 1
    نهاية

    إذا (قاعدة > 20)
        سج_عملية("JGT"، "القفز - أكبر من 20")
        قفزات = قفزات + 1
    نهاية

    إذا (قاعدة < 100)
        سج_عملية("JLT"، "القفز - أصغر من 100")
        قفزات = قفزات + 1
    نهاية

    اطبع_سطر("")
    نص ق2_ن = لنص(قفزات)
    اطبع_سطر("  عدد القفزات: " + ق2_ن)
    اطبع_سطر("")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║     محاكاة آلة افتراضية بسيطة       ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    محاكاة_مكدس()
    محاكاة_سجلات()
    محاكاة_حلقة()
    محاكاة_شروط()

    اطبع_سطر("=== انتهى البرنامج ===")
    ارجع 0
نهاية
