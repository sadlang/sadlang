# ==============================================
# مثال 02: كاشف المسارات الساخنة
# محاكاة اكتشاف الأجزاء الأكثر تنفيذاً
# المستوى: بسيط
# ==============================================

# ---- أدوات التسجيل ----

دالة سج_كشف(نص عنصر، نص تفاصيل)
    اطبع_سطر("  [كشف] " + عنصر + ": " + تفاصيل)
نهاية

# ---- عداد التنفيذ ----

دالة رقم تصنيف_حرارة(رقم عدد_تنفيذ)
    إذا (عدد_تنفيذ >= 1000)
        ارجع 3
    نهاية
    إذا (عدد_تنفيذ >= 100)
        ارجع 2
    نهاية
    إذا (عدد_تنفيذ >= 10)
        ارجع 1
    نهاية
    ارجع 0
نهاية

دالة نص وصف_حرارة(رقم درجة)
    إذا (درجة == 3)
        ارجع "🔥🔥🔥 ساخن جداً"
    نهاية
    إذا (درجة == 2)
        ارجع "🔥🔥 ساخن"
    نهاية
    إذا (درجة == 1)
        ارجع "🔥 دافئ"
    نهاية
    ارجع "❄️ بارد"
نهاية

دالة عرض_دالة(نص اسم_الدالة، رقم عدد، رقم درجة)
    متغير نص وضع = وصف_حرارة(درجة)
    اطبع_سطر("  " + اسم_الدالة + ": " + لنص(عدد) + " مرة → " + وضع)
نهاية

# ---- محاكاة تحليل برنامج ----

دالة تحليل_برنامج_1()
    اطبع_سطر("=== تحليل البرنامج: خادم ويب ===")
    اطبع_سطر("")

    اطبع_سطر("  --- تكرار الدوال ---")
    رقم د1 = 5000
    رقم د2 = 2000
    رقم د3 = 50
    رقم د4 = 3
    رقم د5 = 800

    رقم م1 = تصنيف_حرارة(د1)
    رقم م2 = تصنيف_حرارة(د2)
    رقم م3 = تصنيف_حرارة(د3)
    رقم م4 = تصنيف_حرارة(د4)
    رقم م5 = تصنيف_حرارة(د5)

    عرض_دالة("معالجة_طلب()"، د1، م1)
    عرض_دالة("تحليل_رأس()"، د2، م2)
    عرض_دالة("اتصال_قاعدة()"، د3، م3)
    عرض_دالة("تهيئة_خادم()"، د4، م4)
    عرض_دالة("ترميز_json()"، د5، م5)

    اطبع_سطر("")
    اطبع_سطر("  --- المرشحات لترجمة JIT ---")

    رقم مرشحات = 0
    إذا (م1 >= 2)
        سج_كشف("معالجة_طلب()"، "مرشح لترجمة JIT")
        مرشحات = مرشحات + 1
    نهاية
    إذا (م2 >= 2)
        سج_كشف("تحليل_رأس()"، "مرشح لترجمة JIT")
        مرشحات = مرشحات + 1
    نهاية
    إذا (م3 >= 2)
        مرشحات = مرشحات + 0
    نهاية
    إذا (م5 >= 2)
        سج_كشف("ترميز_json()"، "مرشح لترجمة JIT")
        مرشحات = مرشحات + 1
    نهاية

    اطبع_سطر("")
    اطبع_سطر("  عدد المرشحات: " + لنص(مرشحات))
    اطبع_سطر("")
نهاية

# ---- تحليل الحلقات ----

دالة تحليل_حلقات()
    اطبع_سطر("=== تحليل الحلقات الساخنة ===")
    اطبع_سطر("")

    اطبع_سطر("  --- حلقة 1: معالجة البيانات ---")
    رقم تكرار_1 = 0
    رقم ع = 0
    طالما (ع < 20)
        تكرار_1 = تكرار_1 + 1
        ع = ع + 1
    نهاية
    رقم حم1 = تصنيف_حرارة(تكرار_1)
    متغير نص وص1 = وصف_حرارة(حم1)
    اطبع_سطر("    تكرارات: " + لنص(تكرار_1) + " → " + وص1)

    اطبع_سطر("  --- حلقة 2: بحث في مصفوفة ---")
    رقم تكرار_2 = 0
    رقم ب = 0
    طالما (ب < 500)
        تكرار_2 = تكرار_2 + 1
        ب = ب + 1
    نهاية
    رقم حم2 = تصنيف_حرارة(تكرار_2)
    متغير نص وص2 = وصف_حرارة(حم2)
    اطبع_سطر("    تكرارات: " + لنص(تكرار_2) + " → " + وص2)

    اطبع_سطر("  --- حلقة 3: حساب المحرك ---")
    رقم تكرار_3 = 2500
    رقم حم3 = تصنيف_حرارة(تكرار_3)
    متغير نص وص3 = وصف_حرارة(حم3)
    اطبع_سطر("    تكرارات: " + لنص(تكرار_3) + " → " + وص3)

    اطبع_سطر("")
    اطبع_سطر("  --- قرارات التحسين ---")
    إذا (حم1 < 2)
        اطبع_سطر("    حلقة 1: إبقاء في المفسر")
    نهاية
    إذا (حم2 >= 2)
        اطبع_سطر("    حلقة 2: ترجمة JIT درجة 1")
    نهاية
    إذا (حم3 >= 2)
        اطبع_سطر("    حلقة 3: ترجمة JIT درجة 2 (تحسين كامل)")
    نهاية
    اطبع_سطر("")
نهاية

# ---- إحصائيات الكاشف ----

دالة إحصائيات()
    اطبع_سطر("=== إحصائيات الكاشف ===")
    اطبع_سطر("")
    اطبع_سطر("  حدود التصنيف:")
    اطبع_سطر("    بارد:     < 10 تنفيذات")
    اطبع_سطر("    دافئ:     10-99 تنفيذة")
    اطبع_سطر("    ساخن:     100-999 تنفيذة")
    اطبع_سطر("    ساخن جداً: 1000+ تنفيذة")
    اطبع_سطر("")
    اطبع_سطر("  الإجراءات:")
    اطبع_سطر("    بارد → تفسير عادي")
    اطبع_سطر("    دافئ → مراقبة مستمرة")
    اطبع_سطر("    ساخن → ترجمة JIT أساسية")
    اطبع_سطر("    ساخن جداً → ترجمة JIT محسّنة")
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية() -> رقم
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  كاشف المسارات الساخنة              ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    تحليل_برنامج_1()
    تحليل_حلقات()
    إحصائيات()

    اطبع_سطر("")
    اطبع_سطر("=== انتهى الكاشف ===")
    ارجع 0
نهاية
