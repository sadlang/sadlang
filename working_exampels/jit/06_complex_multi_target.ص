# ---- أدوات التسجيل ----

دالة سج_محرك(نص مكون، نص رسالة)
    اطبع_سطر("  [" + مكون + "] " + رسالة)
نهاية

# ---- نظام الأهداف ----

دالة نص اسم_منصة(رقم معرف)
    إذا (معرف == 1)
        ارجع "x86_64-linux"
    نهاية
    إذا (معرف == 2)
        ارجع "aarch64-linux"
    نهاية
    إذا (معرف == 3)
        ارجع "wasm32"
    نهاية
    إذا (معرف == 4)
        ارجع "riscv64"
    نهاية
    ارجع "unknown"
نهاية

دالة رقم مقاس_تعليمة(رقم منصة)
    إذا (منصة == 1)
        ارجع 4
    نهاية
    إذا (منصة == 2)
        ارجع 4
    نهاية
    إذا (منصة == 3)
        ارجع 1
    نهاية
    إذا (منصة == 4)
        ارجع 4
    نهاية
    ارجع 4
نهاية

دالة رقم عدد_مسجلات(رقم منصة)
    إذا (منصة == 1)
        ارجع 16
    نهاية
    إذا (منصة == 2)
        ارجع 31
    نهاية
    إذا (منصة == 3)
        ارجع 0
    نهاية
    إذا (منصة == 4)
        ارجع 32
    نهاية
    ارجع 0
