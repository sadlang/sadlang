# ---- محاكاة التحليل المعجمي للـ IR ----

دالة محاكاة_تحليل_IR()
    اطبع_سطر("=== الجزء 1: تحليل التمثيل الوسيط (IR) ===")
    اطبع_سطر("")

    اطبع_سطر("  البرنامج المصدر:")
    اطبع_سطر("    دالة حساب(رقم أ، رقم ب) -> رقم")
    اطبع_سطر("      رقم نتيجة = (أ + ب) * 2")
    اطبع_سطر("      ارجع نتيجة")
    اطبع_سطر("    نهاية")
    اطبع_سطر("")

    اطبع_سطر("  تعليمات IR المولدة:")
    اطبع_سطر("    IR.00: PARAM r0, أ")
    اطبع_سطر("    IR.01: PARAM r1, ب")
    اطبع_سطر("    IR.02: ADD   r2, r0, r1")
    اطبع_سطر("    IR.03: CONST r3, 2")
    اطبع_سطر("    IR.04: MUL   r4, r2, r3")
    اطبع_سطر("    IR.05: RET   r4")
    اطبع_سطر("")

    رقم عدد_تعليمات = 6
    اطبع_سطر("  عدد تعليمات IR: " + لنص(عدد_تعليمات))
    اطبع_سطر("")
نهاية

# ---- توليد كود لمنصة ----

دالة توليد_كود_منصة(رقم منصة_رقم)
    متغير نص منصة = اسم_منصة(منصة_رقم)
    رقم مق_تعل = مقاس_تعليمة(منصة_رقم)
    رقم عد_مسج = عدد_مسجلات(منصة_رقم)

    اطبع_سطر("  ── توليد كود لـ: " + منصة + " ──")
    اطبع_سطر("    مقاس التعليمة: " + لنص(مق_تعل) + " بايت")
    اطبع_سطر("    عدد المسجلات: " + لنص(عد_مسج))
    اطبع_سطر("")

    إذا (منصة_رقم == 1)
        اطبع_سطر("    الكود المولد (x86_64):")
        اطبع_سطر("      mov  rax, rdi        ; أ")
        اطبع_سطر("      add  rax, rsi        ; أ + ب")
        اطبع_سطر("      shl  rax, 1          ; * 2")
        اطبع_سطر("      ret")
        رقم مق_كود_1 = 4 * مق_تعل
        اطبع_سطر("    مقاس الكود: " + لنص(مق_كود_1) + " بايت")
    نهاية

    إذا (منصة_رقم == 2)
        اطبع_سطر("    الكود المولد (AArch64):")
        اطبع_سطر("      add  x2, x0, x1      ; أ + ب")
        اطبع_سطر("      lsl  x0, x2, #1      ; * 2")
        اطبع_سطر("      ret")
        رقم مق_كود_2 = 3 * مق_تعل
        اطبع_سطر("    مقاس الكود: " + لنص(مق_كود_2) + " بايت")
    نهاية

    إذا (منصة_رقم == 3)
        اطبع_سطر("    الكود المولد (WASM):")
        اطبع_سطر("      local.get 0           ; أ")
        اطبع_سطر("      local.get 1           ; ب")
        اطبع_سطر("      i64.add               ; +")
        اطبع_سطر("      i64.const 2")
        اطبع_سطر("      i64.mul               ; * 2")
        رقم مق_كود_3 = 5 * مق_تعل
        اطبع_سطر("    مقاس الكود: " + لنص(مق_كود_3) + " بايت")
    نهاية

    إذا (منصة_رقم == 4)
        اطبع_سطر("    الكود المولد (RISC-V):")
        اطبع_سطر("      add  a2, a0, a1       ; أ + ب")
        اطبع_سطر("      slli a0, a2, 1        ; * 2")
        اطبع_سطر("      ret")
        رقم مق_كود_4 = 3 * مق_تعل
        اطبع_سطر("    مقاس الكود: " + لنص(مق_كود_4) + " بايت")
    نهاية

    اطبع_سطر("")
نهاية

# ---- مقارنة شاملة بين المنصات ----

دالة مقارنة_منصات()
    اطبع_سطر("=== الجزء 2: توليد الكود لكل المنصات ===")
    اطبع_سطر("")

    رقم م = 1
    طالما (م <= 4)
        توليد_كود_منصة(م)
        م = م + 1
    نهاية
نهاية

# ---- محاكاة تخصيص المسجلات ----

دالة محاكاة_تخصيص()
    اطبع_سطر("=== الجزء 3: تخصيص المسجلات ===")
    اطبع_سطر("")

    اطبع_سطر("  متغيرات IR النشطة:")
    اطبع_سطر("    r0 (أ):     [0-2]  ← حي في تعليمات 0-2")
    اطبع_سطر("    r1 (ب):     [1-2]  ← حي في تعليمات 1-2")
    اطبع_سطر("    r2 (مجموع): [2-4]  ← حي في تعليمات 2-4")
    اطبع_سطر("    r3 (ثابت):  [3-4]  ← حي في تعليمات 3-4")
    اطبع_سطر("    r4 (نتيجة): [4-5]  ← حي في تعليمات 4-5")
    اطبع_سطر("")

    اطبع_سطر("  تحليل التداخل:")
    رقم أقصى_حي = 3
    اطبع_سطر("    أقصى متغيرات حية: " + لنص(أقصى_حي) + " (عند تعليمة 2-4)")
    اطبع_سطر("")

    اطبع_سطر("  تخصيص x86_64 (16 مسجل متاح):")
    اطبع_سطر("    r0 → rdi (مدخل)")
    اطبع_سطر("    r1 → rsi (مدخل)")
    اطبع_سطر("    r2 → rax")
    اطبع_سطر("    r3 → (مُطوى في تعليمة)")
    اطبع_سطر("    r4 → rax (إعادة استعمال)")
    اطبع_سطر("    انسكاب إلى الذاكرة: 0")
    اطبع_سطر("")

    اطبع_سطر("  تخصيص WASM (مكدس):")
    اطبع_سطر("    جميع المتغيرات على المكدس")
    اطبع_سطر("    لا حاجة لتخصيص مسجلات")
    اطبع_سطر("")
نهاية

# ---- محاكاة ذاكرة الكود المؤقتة ----

دالة محاكاة_ذاكرة_كود()
    اطبع_سطر("=== الجزء 4: ذاكرة الكود المؤقتة ===")
    اطبع_سطر("")

    رقم سعة_كاش = 1024
    رقم مستعمل = 0

    اطبع_سطر("  سعة ذاكرة الكود: " + لنص(سعة_كاش) + " بايت")
    اطبع_سطر("")

    اطبع_سطر("  إدخالات:")

    سج_محرك("CACHE"، "معالجة_طلب: 64 بايت")
    مستعمل = مستعمل + 64

    سج_محرك("CACHE"، "تحليل_HTTP: 128 بايت")
    مستعمل = مستعمل + 128

    سج_محرك("CACHE"، "ترميز_استجابة: 96 بايت")
    مستعمل = مستعمل + 96

    سج_محرك("CACHE"، "معالجة_بيانات: 256 بايت")
    مستعمل = مستعمل + 256

    سج_محرك("CACHE"، "تحقق_أمان: 48 بايت")
    مستعمل = مستعمل + 48

    اطبع_سطر("")
    رقم متبقي = سعة_كاش - مستعمل
    رقم نسبة_ش = (مستعمل * 100) / سعة_كاش

    اطبع_سطر("  الوضع:")
    اطبع_سطر("    مستعمل: " + لنص(مستعمل) + " بايت")
    اطبع_سطر("    متبقي: " + لنص(متبقي) + " بايت")
    اطبع_سطر("    الاستعمال: " + لنص(نسبة_ش) + "%")
    اطبع_سطر("")

    إذا (نسبة_ش < 80)
        سج_محرك("CACHE"، "مساحة كافية - لا حاجة لإخلاء")
    وإلا
        سج_محرك("CACHE"، "مساحة منخفضة - تفعيل LRU")
    نهاية
    اطبع_سطر("")
نهاية

# ---- محاكاة إلغاء التحسين ----

دالة محاكاة_إلغاء_تحسين()
    اطبع_سطر("=== الجزء 5: إلغاء التحسين (Deoptimization) ===")
    اطبع_سطر("")

    اطبع_سطر("  السيناريو: افتراض أنواع كُسر")
    اطبع_سطر("")

    سج_محرك("OPT"، "الدالة: معالجة(قيمة)")
    سج_محرك("OPT"، "الافتراض: قيمة دائماً عدد")
    سج_محرك("OPT"، "تخصيص: عمليات عدد صحيح سريعة")
    اطبع_سطر("")

    رقم تكرار_ناجح = 0
    طالما (تكرار_ناجح < 5)
        اطبع_سطر("    التكرار " + لنص(تكرار_ناجح + 1) + ": قيمة = عدد → [JIT: تنفيذ سريع]")
        تكرار_ناجح = تكرار_ناجح + 1
    نهاية

    اطبع_سطر("")
    سج_محرك("DEOPT"، "التكرار 6: قيمة = كلمة! الافتراض كُسر!")
    اطبع_سطر("")
    اطبع_سطر("  خطوات إلغاء التحسين:")
    اطبع_سطر("    1. إيقاف تنفيذ JIT")
    اطبع_سطر("    2. حفظ المسجلات")
    اطبع_سطر("    3. بناء إطار المفسر")
    اطبع_سطر("    4. العودة للمفسر")
    اطبع_سطر("    5. تحديث بيانات المحلل")
    اطبع_سطر("    6. إعادة بناء بدون الافتراض")
    اطبع_سطر("")

    سج_محرك("REBLD"، "إعادة بناء بأنواع عامة (polymorphic)")
    سج_محرك("GO"، "استئناف التنفيذ بالنسخة الجديدة")
    اطبع_سطر("")
نهاية

