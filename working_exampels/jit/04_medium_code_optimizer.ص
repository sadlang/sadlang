# ---- أدوات التسجيل ----

دالة سج_تحسين(نص تحسين، نص تفاصيل)
    اطبع_سطر("  [OPT] " + تحسين + ": " + تفاصيل)
نهاية

دالة سج_حذف(نص عبارة)
    اطبع_سطر("  [DEL] حذف: " + عبارة)
نهاية

دالة سج_استبدال(نص أصلي، نص بديل)
    اطبع_سطر("  [REP] " + أصلي + " → " + بديل)
نهاية

# ---- تحسين 1: طي الثوابت (Constant Folding) ----

دالة تحسين_طي_ثوابت()
    اطبع_سطر("=== تحسين 1: طي الثوابت ===")
    اطبع_سطر("")

    اطبع_سطر("  الكود الأصلي:")
    اطبع_سطر("    x = 3 + 4")
    اطبع_سطر("    y = x * 2")
    اطبع_سطر("    z = y + 1")
    اطبع_سطر("")

    رقم عمليات_أصلية = 3
    رقم عمليات_بعد = 0

    سج_تحسين("طي"، "3 + 4 → 7")
    سج_تحسين("نشر"، "x = 7، لذا y = 7 * 2 → 14")
    سج_تحسين("نشر"، "y = 14، لذا z = 14 + 1 → 15")
    عمليات_بعد = 0

    اطبع_سطر("")
    اطبع_سطر("  الكود المحسّن:")
    اطبع_سطر("    x = 7")
    اطبع_سطر("    y = 14")
    اطبع_سطر("    z = 15")
    اطبع_سطر("")

    رقم توفير = عمليات_أصلية - عمليات_بعد
    اطبع_سطر("  العمليات الأصلية: " + لنص(عمليات_أصلية))
    اطبع_سطر("  العمليات المحسّنة: " + لنص(عمليات_بعد))
    اطبع_سطر("  التوفير: " + لنص(توفير) + " عمليات")
    اطبع_سطر("")
نهاية

# ---- تحسين 2: حذف الكود الميت (Dead Code Elimination) ----

دالة تحسين_كود_ميت()
    اطبع_سطر("=== تحسين 2: حذف الكود الميت ===")
    اطبع_سطر("")

    اطبع_سطر("  الكود الأصلي:")
    اطبع_سطر("    a = 10              # مستخدم")
    اطبع_سطر("    b = 20              # غير مستخدم!")
    اطبع_سطر("    c = a + 5           # مستخدم")
    اطبع_سطر("    d = b * 3           # يعتمد على ميت!")
    اطبع_سطر("    اطبع(c)")
    اطبع_سطر("")

    رقم أسطر_أصلية = 5
    رقم أسطر_محذوفة = 0

    سج_حذف("b = 20 (غير مستخدم في الإخراج)")
    أسطر_محذوفة = أسطر_محذوفة + 1

    سج_حذف("d = b * 3 (يعتمد على متغير ميت)")
    أسطر_محذوفة = أسطر_محذوفة + 1

    اطبع_سطر("")
    اطبع_سطر("  الكود المحسّن:")
    اطبع_سطر("    a = 10")
    اطبع_سطر("    c = a + 5")
    اطبع_سطر("    اطبع(c)")
    اطبع_سطر("")

    رقم أسطر_بعد = أسطر_أصلية - أسطر_محذوفة
    اطبع_سطر("  الأسطر: " + لنص(أسطر_أصلية) + " → " + لنص(أسطر_بعد))
    اطبع_سطر("  محذوف: " + لنص(أسطر_محذوفة) + " أسطر")
    اطبع_سطر("")
نهاية

# ---- تحسين 3: تضمين الدوال (Function Inlining) ----

دالة تحسين_تضمين()
    اطبع_سطر("=== تحسين 3: تضمين الدوال ===")
    اطبع_سطر("")

    اطبع_سطر("  الكود الأصلي:")
    اطبع_سطر("    دالة مربع(x) { ارجع x * x }")
    اطبع_سطر("    دالة مكعب(x) { ارجع x * x * x }")
    اطبع_سطر("    a = مربع(5)")
    اطبع_سطر("    b = مكعب(3)")
    اطبع_سطر("")

    سج_تحسين("تضمين"، "مربع(5) → 5 * 5")
    سج_تحسين("طي"، "5 * 5 → 25")
    سج_تحسين("تضمين"، "مكعب(3) → 3 * 3 * 3")
    سج_تحسين("طي"، "3 * 3 * 3 → 27")

    اطبع_سطر("")
    اطبع_سطر("  الكود المحسّن:")
    اطبع_سطر("    a = 25")
    اطبع_سطر("    b = 27")
    اطبع_سطر("")
    اطبع_سطر("  توفير: استدعاءين + 3 عمليات حسابية")
    اطبع_سطر("")
نهاية

# ---- تحسين 4: فك الحلقات (Loop Unrolling) ----

دالة تحسين_فك_حلقات()
    اطبع_سطر("=== تحسين 4: فك الحلقات ===")
    اطبع_سطر("")

    اطبع_سطر("  الكود الأصلي:")
    اطبع_سطر("    مجموع = 0")
    اطبع_سطر("    لكل i من 0 إلى 3:")
    اطبع_سطر("      مجموع += مصفوفة[i]")
    اطبع_سطر("")

    سج_تحسين("فك"، "الحلقة قصيرة (4 تكرارات) - فكّها")

    اطبع_سطر("")
    اطبع_سطر("  الكود المحسّن:")
    اطبع_سطر("    مجموع = مصفوفة[0]")
    اطبع_سطر("    مجموع += مصفوفة[1]")
    اطبع_سطر("    مجموع += مصفوفة[2]")
    اطبع_سطر("    مجموع += مصفوفة[3]")
    اطبع_سطر("")

    اطبع_سطر("  الفوائد:")
    اطبع_سطر("    - إزالة فحص الشرط")
    اطبع_سطر("    - إزالة زيادة العداد")
    اطبع_سطر("    - إمكانية تنفيذ متوازي")
    اطبع_سطر("")
نهاية

# ---- تحسين 5: تحريك الثوابت خارج الحلقة ----

دالة تحسين_تحريك()
    اطبع_سطر("=== تحسين 5: تحريك الثوابت خارج الحلقة ===")
    اطبع_سطر("")

    اطبع_سطر("  الكود الأصلي:")
    اطبع_سطر("    لكل i من 0 إلى 1000:")
    اطبع_سطر("      x = حجم_المصفوفة * 4  # ثابت!")
    اطبع_سطر("      نتيجة[i] = بيانات[i] + x")
    اطبع_سطر("")

    سج_تحسين("تحريك"، "x = حجم_المصفوفة * 4 ثابت ← خارج الحلقة")

    اطبع_سطر("")
    اطبع_سطر("  الكود المحسّن:")
    اطبع_سطر("    x = حجم_المصفوفة * 4    # مرة واحدة")
    اطبع_سطر("    لكل i من 0 إلى 1000:")
    اطبع_سطر("      نتيجة[i] = بيانات[i] + x")
    اطبع_سطر("")

    اطبع_سطر("  التوفير: 999 عملية ضرب غير ضرورية")
    اطبع_سطر("")
نهاية

