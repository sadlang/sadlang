# مثال 02: ماكرو التوليد التلقائي
# أنماط ماكرو لتوليد الكود تلقائياً
# المستوى: بسيط
# ==============================================

# ---- ماكرو توليد دوال الحساب ----

دالة رقم اضف(رقم أ، رقم ب)
    ارجع أ + ب
نهاية

دالة رقم اطرح(رقم أ، رقم ب)
    ارجع أ - ب
نهاية

دالة رقم اضرب(رقم أ، رقم ب)
    ارجع أ * ب
نهاية

دالة رقم اقسم(رقم أ، رقم ب)
    إذا (ب == 0)
        اطبع_سطر("خطأ: قسمة على صفر!")
        ارجع 0
    نهاية
    ارجع أ / ب
نهاية

دالة رقم باقي_قسمة(رقم أ، رقم ب)
    إذا (ب == 0)
        ارجع 0
    نهاية
    ارجع أ % ب
نهاية

# ---- ماكرو توليد دوال المقارنة ----

دالة رقم الأكبر(رقم أ، رقم ب)
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة رقم الأصغر(رقم أ، رقم ب)
    إذا (أ < ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة رقم القيمة_المطلقة(رقم ق)
    إذا (ق < 0)
        ارجع 0 - ق
    نهاية
    ارجع ق
نهاية

# ---- ماكرو توليد سلاسل التحويل ----

دالة نص رقم_لكلمة(رقم ر)
    طابق ر
        حالة 0:
            ارجع "صفر"
        حالة 1:
            ارجع "واحد"
        حالة 2:
            ارجع "اثنان"
        حالة 3:
            ارجع "ثلاثة"
        حالة 4:
            ارجع "أربعة"
        حالة 5:
            ارجع "خمسة"
        حالة 6:
            ارجع "ستة"
        حالة 7:
            ارجع "سبعة"
        حالة 8:
            ارجع "ثمانية"
        حالة 9:
            ارجع "تسعة"
        حالة 10:
            ارجع "عشرة"
        حالة _:
            ارجع "عدد كبير"
    نهاية
نهاية

# ---- ماكرو توليد الفحوصات ----

دالة منطقي هل_موجب(رقم ق)
    ارجع ق > 0
نهاية

دالة منطقي هل_سالب(رقم ق)
    ارجع ق < 0
نهاية

دالة منطقي هل_زوجي(رقم ق)
    ارجع ق % 2 == 0
نهاية

دالة منطقي هل_فردي(رقم ق)
    ارجع ق % 2 != 0
نهاية

دالة منطقي هل_صفر(رقم ق)
    ارجع ق == 0
نهاية

# ---- ماكرو عرض النتائج ----

دالة اعرض_نتيجة_حساب(نص عملية، رقم أ، رقم ب، رقم نتيجة)
    اطبع_سطر(لنص(أ) + " " + عملية + " " + لنص(ب) + " = " + لنص(نتيجة))
نهاية

دالة اعرض_فحص(نص وصف، منطقي نتيجة)
    إذا (نتيجة)
        اطبع_سطر("  ✓ " + وصف + ": صحيح")
    وإلا
        اطبع_سطر("  ✗ " + وصف + ": خطأ")
    نهاية
نهاية

# ---- ماكرو الاختبارات التلقائية ----

دالة رقم اختبر_حسابات()
    رقم نجاح = 0
    رقم فشل = 0

    # اختبارات الجمع
    إذا (اضف(3، 5) == 8)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
        اطبع_سطر("فشل: 3 + 5 != 8")
    نهاية

    # اختبارات الطرح
    إذا (اطرح(10، 4) == 6)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية

    # اختبارات الضرب
    إذا (اضرب(6، 7) == 42)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية

    # اختبارات القسمة
    إذا (اقسم(20، 4) == 5)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية

    # اختبار القسمة على صفر
    إذا (اقسم(10، 0) == 0)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
    نهاية

    اطبع_سطر("نتائج اختبارات الحساب: " + لنص(نجاح) + " نجاح، " + لنص(فشل) + " فشل")
    ارجع فشل
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية()
    اطبع_سطر("=== ماكرو التوليد التلقائي ===")
    اطبع_سطر("")

    # عرض العمليات الحسابية المولدة
    اطبع_سطر("--- العمليات الحسابية ---")
    اعرض_نتيجة_حساب("+"، 15، 25، اضف(15، 25))
    اعرض_نتيجة_حساب("-"، 100، 37، اطرح(100، 37))
    اعرض_نتيجة_حساب("×"، 12، 8، اضرب(12، 8))
    اعرض_نتيجة_حساب("÷"، 144، 12، اقسم(144، 12))
    اعرض_نتيجة_حساب("%"، 17، 5، باقي_قسمة(17، 5))
    اطبع_سطر("")

    # عرض المقارنات المولدة
    اطبع_سطر("--- المقارنات ---")
    اطبع_سطر("الأكبر(15، 25) = " + لنص(الأكبر(15، 25)))
    اطبع_سطر("الأصغر(15، 25) = " + لنص(الأصغر(15، 25)))
    اطبع_سطر("القيمة المطلقة(-42) = " + لنص(القيمة_المطلقة(-42)))
    اطبع_سطر("")

    # عرض تحويل الأرقام للكلمات
    اطبع_سطر("--- تحويل الأرقام ---")
    رقم ع = 0
    بينما (ع <= 10)
        اطبع_سطر("  " + لنص(ع) + " = " + رقم_لكلمة(ع))
        ع = ع + 1
    نهاية
    اطبع_سطر("")

    # عرض الفحوصات المولدة
    اطبع_سطر("--- فحوصات الأرقام ---")
    اطبع_سطر("فحص الرقم 7:")
    اعرض_فحص("موجب"، هل_موجب(7))
    اعرض_فحص("سالب"، هل_سالب(7))
    اعرض_فحص("زوجي"، هل_زوجي(7))
    اعرض_فحص("فردي"، هل_فردي(7))
    اعرض_فحص("صفر"، هل_صفر(7))
    اطبع_سطر("")

    اطبع_سطر("فحص الرقم -4:")
    اعرض_فحص("موجب"، هل_موجب(-4))
    اعرض_فحص("سالب"، هل_سالب(-4))
    اعرض_فحص("زوجي"، هل_زوجي(-4))
    اعرض_فحص("فردي"، هل_فردي(-4))
    اعرض_فحص("صفر"، هل_صفر(-4))
    اطبع_سطر("")

    # تشغيل الاختبارات التلقائية
    اطبع_سطر("--- الاختبارات التلقائية ---")
    متغير فشل = اختبر_حسابات()
    اطبع_سطر("")

    اطبع_سطر("=== انتهى ماكرو التوليد التلقائي ===")
    ارجع 0
نهاية
