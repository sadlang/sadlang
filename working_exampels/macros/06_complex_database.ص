# ==============================================
# مثال 06: ماكرو قاعدة بيانات
# نظام ماكرو لإدارة قاعدة بيانات وهمية
# المستوى: معقد
# ==============================================

# ---- أدوات مساعدة ----

دالة نص فاصل_طويل()
    ارجع "=============================="
نهاية

دالة اعرض_عنوان(نص عنوان)
    اطبع_سطر(فاصل_طويل())
    اطبع_سطر("  " + عنوان)
    اطبع_سطر(فاصل_طويل())
نهاية

# ---- جدول الموظفين ----

صنف جدول_موظفين
    عام
        رقم عدد_موظفين
        نص اسم1
        نص اسم2
        نص اسم3
        نص اسم4
        نص اسم5
        رقم راتب1
        رقم راتب2
        رقم راتب3
        رقم راتب4
        رقم راتب5
        نص قسم1
        نص قسم2
        نص قسم3
        نص قسم4
        نص قسم5

        باني()
            عدد_موظفين = 0
            اسم1 = ""
            اسم2 = ""
            اسم3 = ""
            اسم4 = ""
            اسم5 = ""
            راتب1 = 0
            راتب2 = 0
            راتب3 = 0
            راتب4 = 0
            راتب5 = 0
            قسم1 = ""
            قسم2 = ""
            قسم3 = ""
            قسم4 = ""
            قسم5 = ""
        نهاية

        دالة أضف(نص الاسم، رقم الراتب، نص القسم)
            عدد_موظفين = عدد_موظفين + 1
            طابق عدد_موظفين
                حالة 1:
                    اسم1 = الاسم
                    راتب1 = الراتب
                    قسم1 = القسم
                حالة 2:
                    اسم2 = الاسم
                    راتب2 = الراتب
                    قسم2 = القسم
                حالة 3:
                    اسم3 = الاسم
                    راتب3 = الراتب
                    قسم3 = القسم
                حالة 4:
                    اسم4 = الاسم
                    راتب4 = الراتب
                    قسم4 = القسم
                حالة 5:
                    اسم5 = الاسم
                    راتب5 = الراتب
                    قسم5 = القسم
            نهاية
            اطبع_سطر("+ إضافة موظف: " + الاسم + " | " + القسم + " | " + لنص(الراتب))
        نهاية

        دالة اعرض_جدول()
            اطبع_سطر("| الاسم         | القسم      | الراتب |")
            اطبع_سطر("|---------------|------------|--------|")
            إذا (عدد_موظفين > 0)
                اطبع_سطر("| " + اسم1 + " | " + قسم1 + " | " + لنص(راتب1) + " |")
            نهاية
            إذا (عدد_موظفين > 1)
                اطبع_سطر("| " + اسم2 + " | " + قسم2 + " | " + لنص(راتب2) + " |")
            نهاية
            إذا (عدد_موظفين > 2)
                اطبع_سطر("| " + اسم3 + " | " + قسم3 + " | " + لنص(راتب3) + " |")
            نهاية
            إذا (عدد_موظفين > 3)
                اطبع_سطر("| " + اسم4 + " | " + قسم4 + " | " + لنص(راتب4) + " |")
            نهاية
            إذا (عدد_موظفين > 4)
                اطبع_سطر("| " + اسم5 + " | " + قسم5 + " | " + لنص(راتب5) + " |")
            نهاية
            اطبع_سطر("المجموع: " + لنص(عدد_موظفين) + " موظف")
        نهاية

        دالة رقم مجموع_رواتب()
            رقم م = 0
            إذا (عدد_موظفين > 0)
                م = م + راتب1
            نهاية
            إذا (عدد_موظفين > 1)
                م = م + راتب2
            نهاية
            إذا (عدد_موظفين > 2)
                م = م + راتب3
            نهاية
            إذا (عدد_موظفين > 3)
                م = م + راتب4
            نهاية
            إذا (عدد_موظفين > 4)
                م = م + راتب5
            نهاية
            ارجع م
        نهاية

        دالة رقم متوسط_رواتب()
            إذا (عدد_موظفين == 0)
                ارجع 0
            نهاية
            ارجع مجموع_رواتب() / عدد_موظفين
        نهاية

        دالة رقم أعلى_راتب()
            رقم أعلى = 0
            إذا (عدد_موظفين > 0)
                أعلى = راتب1
            نهاية
            إذا (عدد_موظفين > 1)
                إذا (راتب2 > أعلى)
                    أعلى = راتب2
                نهاية
            نهاية
            إذا (عدد_موظفين > 2)
                إذا (راتب3 > أعلى)
                    أعلى = راتب3
                نهاية
            نهاية
            إذا (عدد_موظفين > 3)
                إذا (راتب4 > أعلى)
                    أعلى = راتب4
                نهاية
            نهاية
            إذا (عدد_موظفين > 4)
                إذا (راتب5 > أعلى)
                    أعلى = راتب5
                نهاية
            نهاية
            ارجع أعلى
        نهاية

        دالة رقم أدنى_راتب()
            رقم أدنى = 999999
            إذا (عدد_موظفين > 0)
                أدنى = راتب1
            نهاية
            إذا (عدد_موظفين > 1)
                إذا (راتب2 < أدنى)
                    أدنى = راتب2
                نهاية
            نهاية
            إذا (عدد_موظفين > 2)
                إذا (راتب3 < أدنى)
                    أدنى = راتب3
                نهاية
            نهاية
            إذا (عدد_موظفين > 3)
                إذا (راتب4 < أدنى)
                    أدنى = راتب4
                نهاية
            نهاية
            إذا (عدد_موظفين > 4)
                إذا (راتب5 < أدنى)
                    أدنى = راتب5
                نهاية
            نهاية
            ارجع أدنى
        نهاية

        دالة اعرض_إحصائيات()
            اطبع_سطر("إحصائيات الرواتب:")
            اطبع_سطر("  المجموع: " + لنص(مجموع_رواتب()))
            اطبع_سطر("  المتوسط: " + لنص(متوسط_رواتب()))
            اطبع_سطر("  الأعلى: " + لنص(أعلى_راتب()))
            اطبع_سطر("  الأدنى: " + لنص(أدنى_راتب()))
        نهاية
نهاية

# ---- جدول المشاريع ----

صنف جدول_مشاريع
    عام
        رقم عدد_مشاريع
        نص مشروع1
        نص مشروع2
        نص مشروع3
        نص حال1
        نص حال2
        نص حال3
        رقم ميزانية1
        رقم ميزانية2
        رقم ميزانية3
        رقم تقدم1
        رقم تقدم2
        رقم تقدم3

        باني()
            عدد_مشاريع = 0
            مشروع1 = ""
            مشروع2 = ""
            مشروع3 = ""
            حال1 = ""
            حال2 = ""
            حال3 = ""
            ميزانية1 = 0
            ميزانية2 = 0
            ميزانية3 = 0
            تقدم1 = 0
            تقدم2 = 0
            تقدم3 = 0
        نهاية

        دالة أضف_مشروع(نص الاسم، نص الحال، رقم الميزانية، رقم التقدم)
            عدد_مشاريع = عدد_مشاريع + 1
            طابق عدد_مشاريع
                حالة 1:
                    مشروع1 = الاسم
                    حال1 = الحال
                    ميزانية1 = الميزانية
                    تقدم1 = التقدم
                حالة 2:
                    مشروع2 = الاسم
                    حال2 = الحال
                    ميزانية2 = الميزانية
                    تقدم2 = التقدم
                حالة 3:
                    مشروع3 = الاسم
                    حال3 = الحال
                    ميزانية3 = الميزانية
                    تقدم3 = التقدم
            نهاية
            اطبع_سطر("+ مشروع: " + الاسم + " | " + الحال + " | " + لنص(الميزانية) + " | " + لنص(التقدم) + "%")
        نهاية

        دالة اعرض_مشاريع()
            اطبع_سطر("| المشروع      | الحالة     | الميزانية | التقدم |")
            اطبع_سطر("|--------------|-----------|----------|--------|")
            إذا (عدد_مشاريع > 0)
                اطبع_سطر("| " + مشروع1 + " | " + حال1 + " | " + لنص(ميزانية1) + " | " + لنص(تقدم1) + "% |")
            نهاية
            إذا (عدد_مشاريع > 1)
                اطبع_سطر("| " + مشروع2 + " | " + حال2 + " | " + لنص(ميزانية2) + " | " + لنص(تقدم2) + "% |")
            نهاية
            إذا (عدد_مشاريع > 2)
                اطبع_سطر("| " + مشروع3 + " | " + حال3 + " | " + لنص(ميزانية3) + " | " + لنص(تقدم3) + "% |")
            نهاية
        نهاية

        دالة رقم مجموع_ميزانيات()
            رقم م = 0
            إذا (عدد_مشاريع > 0)
                م = م + ميزانية1
            نهاية
            إذا (عدد_مشاريع > 1)
                م = م + ميزانية2
            نهاية
            إذا (عدد_مشاريع > 2)
                م = م + ميزانية3
            نهاية
            ارجع م
        نهاية

        دالة رقم متوسط_تقدم()
            إذا (عدد_مشاريع == 0)
                ارجع 0
            نهاية
            رقم م = 0
            إذا (عدد_مشاريع > 0)
                م = م + تقدم1
            نهاية
            إذا (عدد_مشاريع > 1)
                م = م + تقدم2
            نهاية
            إذا (عدد_مشاريع > 2)
                م = م + تقدم3
            نهاية
            ارجع م / عدد_مشاريع
        نهاية
نهاية

# ---- تقرير متكامل ----

دالة اعرض_تقرير_نهائي(رقم مجموع_ر، رقم متوسط_ر، رقم أعلى_ر، رقم أدنى_ر، رقم عدد_م، رقم مجموع_ميز، رقم متوسط_تق)
    اعرض_عنوان("التقرير النهائي")
    اطبع_سطر("")
    اطبع_سطر("--- الموظفون ---")
    اطبع_سطر("  مجموع الرواتب: " + لنص(مجموع_ر))
    اطبع_سطر("  متوسط الرواتب: " + لنص(متوسط_ر))
    اطبع_سطر("  أعلى راتب: " + لنص(أعلى_ر))
    اطبع_سطر("  أدنى راتب: " + لنص(أدنى_ر))
    اطبع_سطر("")
    اطبع_سطر("--- المشاريع ---")
    اطبع_سطر("  عدد المشاريع: " + لنص(عدد_م))
    اطبع_سطر("  مجموع الميزانيات: " + لنص(مجموع_ميز))
    اطبع_سطر("  متوسط التقدم: " + لنص(متوسط_تق) + "%")
    اطبع_سطر("")

    # مؤشرات الأداء
    اطبع_سطر("--- مؤشرات الأداء ---")
    إذا (متوسط_تق > 70)
        اطبع_سطر("  الأداء: ممتاز")
    وإلا
        إذا (متوسط_تق > 40)
            اطبع_سطر("  الأداء: جيد")
        وإلا
            اطبع_سطر("  الأداء: يحتاج تحسين")
        نهاية
    نهاية

    إذا (أعلى_ر - أدنى_ر > 5000)
        اطبع_سطر("  تحذير: فجوة رواتب كبيرة")
    وإلا
        اطبع_سطر("  الرواتب: متوازنة")
    نهاية
نهاية

# ---- نقطة الدخول ----

دالة رئيسية()
    اعرض_عنوان("نظام قاعدة بيانات الشركة")
    اطبع_سطر("")

    # إنشاء جدول الموظفين
    اطبع_سطر("=== 1. إدخال بيانات الموظفين ===")
    متغير موظفون = جديد جدول_موظفين()
    موظفون.أضف("أحمد"، 8000، "هندسة")
    موظفون.أضف("سارة"، 9500، "إدارة")
    موظفون.أضف("خالد"، 7000، "تسويق")
    موظفون.أضف("فاطمة"، 12000، "هندسة")
    موظفون.أضف("عمر"، 6500، "دعم")
    اطبع_سطر("")

    # عرض جدول الموظفين
    اطبع_سطر("=== 2. جدول الموظفين ===")
    موظفون.اعرض_جدول()
    اطبع_سطر("")

    # إحصائيات الرواتب
    اطبع_سطر("=== 3. إحصائيات الرواتب ===")
    موظفون.اعرض_إحصائيات()
    اطبع_سطر("")

    # إنشاء جدول المشاريع
    اطبع_سطر("=== 4. إدخال بيانات المشاريع ===")
    متغير مشاريع = جديد جدول_مشاريع()
    مشاريع.أضف_مشروع("منصة_ويب"، "نشط"، 50000، 75)
    مشاريع.أضف_مشروع("تطبيق_جوال"، "تطوير"، 30000، 45)
    مشاريع.أضف_مشروع("تحليلات"، "تخطيط"، 20000، 10)
    اطبع_سطر("")

    # عرض جدول المشاريع
    اطبع_سطر("=== 5. جدول المشاريع ===")
    مشاريع.اعرض_مشاريع()
    اطبع_سطر("")

    # التقرير النهائي
    اعرض_تقرير_نهائي(موظفون.مجموع_رواتب()، موظفون.متوسط_رواتب()، موظفون.أعلى_راتب()، موظفون.أدنى_راتب()، مشاريع.عدد_مشاريع، مشاريع.مجموع_ميزانيات()، مشاريع.متوسط_تقدم())

    اطبع_سطر("")
    اطبع_سطر("انتهى النظام بنجاح")
    ارجع 0
نهاية
