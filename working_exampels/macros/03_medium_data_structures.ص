# ---- ماكرو بناء المكدس ----

صنف مكدس
    عام
        رقم قمة
        رقم س0
        رقم س1
        رقم س2
        رقم س3
        رقم س4

        باني()
            قمة = 0
            س0 = 0
            س1 = 0
            س2 = 0
            س3 = 0
            س4 = 0
        نهاية

        دالة ادفع(رقم قيمة)
            إذا (قمة >= 5)
                اطبع_سطر("المكدس ممتلئ!")
            وإلا
                طابق قمة
                    حالة 0:
                        س0 = قيمة
                    حالة 1:
                        س1 = قيمة
                    حالة 2:
                        س2 = قيمة
                    حالة 3:
                        س3 = قيمة
                    حالة 4:
                        س4 = قيمة
                نهاية
                قمة = قمة + 1
            نهاية
        نهاية

        دالة رقم اسحب()
            إذا (قمة == 0)
                اطبع_سطر("المكدس فارغ!")
                ارجع 0
            نهاية
            قمة = قمة - 1
            طابق قمة
                حالة 0:
                    ارجع س0
                حالة 1:
                    ارجع س1
                حالة 2:
                    ارجع س2
                حالة 3:
                    ارجع س3
                حالة 4:
                    ارجع س4
                حالة _:
                    ارجع 0
            نهاية
        نهاية

        دالة رقم انظر_قمة()
            إذا (قمة == 0)
                ارجع 0
            نهاية
            متغير فهرس = قمة - 1
            طابق فهرس
                حالة 0:
                    ارجع س0
                حالة 1:
                    ارجع س1
                حالة 2:
                    ارجع س2
                حالة 3:
                    ارجع س3
                حالة 4:
                    ارجع س4
                حالة _:
                    ارجع 0
            نهاية
        نهاية

        دالة رقم العمق()
            ارجع قمة
        نهاية

        دالة منطقي فارغ()
            ارجع قمة == 0
        نهاية
نهاية

# ---- ماكرو بناء العداد ----

صنف عداد
    عام
        نص اسم_عداد
        رقم قيمة_حالية
        رقم أقصى_حد
        رقم عدد_زيادات

        باني(نص الاسم، رقم الحد)
            اسم_عداد = الاسم
            قيمة_حالية = 0
            أقصى_حد = الحد
            عدد_زيادات = 0
        نهاية

        دالة زد()
            إذا (قيمة_حالية < أقصى_حد)
                قيمة_حالية = قيمة_حالية + 1
                عدد_زيادات = عدد_زيادات + 1
            نهاية
        نهاية

        دالة أنقص()
            إذا (قيمة_حالية > 0)
                قيمة_حالية = قيمة_حالية - 1
            نهاية
        نهاية

        دالة صفّر()
            قيمة_حالية = 0
        نهاية

        دالة رقم القيمة()
            ارجع قيمة_حالية
        نهاية

        دالة اعرض()
            اطبع_سطر("  عداد [" + اسم_عداد + "]: " + لنص(قيمة_حالية) + "/" + لنص(أقصى_حد) + " (زيادات: " + لنص(عدد_زيادات) + ")")
        نهاية
نهاية

# ---- ماكرو بناء السجل ----

صنف سجل_بيانات
    عام
        نص مفتاح1
        نص قيمة1
        نص مفتاح2
        نص قيمة2
        نص مفتاح3
        نص قيمة3
        رقم عدد_حقول

        باني()
            مفتاح1 = ""
            قيمة1 = ""
            مفتاح2 = ""
            قيمة2 = ""
            مفتاح3 = ""
            قيمة3 = ""
            عدد_حقول = 0
        نهاية

        دالة عيّن_حقل(نص مفتاح، نص قيمة)
            طابق عدد_حقول
                حالة 0:
                    مفتاح1 = مفتاح
                    قيمة1 = قيمة
                حالة 1:
                    مفتاح2 = مفتاح
                    قيمة2 = قيمة
                حالة 2:
                    مفتاح3 = مفتاح
                    قيمة3 = قيمة
                حالة _:
                    اطبع_سطر("السجل ممتلئ!")
            نهاية
            إذا (عدد_حقول < 3)
                عدد_حقول = عدد_حقول + 1
            نهاية
        نهاية

        دالة اعرض()
            اطبع_سطر("  {")
            إذا (عدد_حقول >= 1)
                اطبع_سطر("    " + مفتاح1 + ": " + قيمة1)
            نهاية
            إذا (عدد_حقول >= 2)
                اطبع_سطر("    " + مفتاح2 + ": " + قيمة2)
            نهاية
            إذا (عدد_حقول >= 3)
                اطبع_سطر("    " + مفتاح3 + ": " + قيمة3)
            نهاية
            اطبع_سطر("  }")
        نهاية
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية()
    اطبع_سطر("=== ماكرو بناء الهياكل البيانية ===")
    اطبع_سطر("")

    # اختبار المكدس
    اطبع_سطر("--- المكدس ---")
    متغير م = جديد مكدس()
    م.ادفع(10)
    م.ادفع(20)
    م.ادفع(30)
    اطبع_سطر("العمق: " + لنص(م.العمق()))
    اطبع_سطر("القمة: " + لنص(م.انظر_قمة()))

    متغير مسحوب = م.اسحب()
    اطبع_سطر("مسحوب: " + لنص(مسحوب))
    اطبع_سطر("العمق بعد السحب: " + لنص(م.العمق()))
    اطبع_سطر("")

    # اختبار العداد
    اطبع_سطر("--- العدادات ---")
    متغير ع1 = جديد عداد("زوار"، 100)
    متغير ع2 = جديد عداد("طلبات"، 50)

    رقم ت = 0
    بينما (ت < 10)
        ع1.زد()
        ت = ت + 1
    نهاية

    ت = 0
    بينما (ت < 5)
        ع2.زد()
        ت = ت + 1
    نهاية

    ع1.اعرض()
    ع2.اعرض()
    اطبع_سطر("")

    # اختبار السجل
    اطبع_سطر("--- السجلات ---")
    متغير س1 = جديد سجل_بيانات()
    س1.عيّن_حقل("الاسم"، "أحمد")
    س1.عيّن_حقل("العمر"، "25")
    س1.عيّن_حقل("المدينة"، "الرياض")
    اطبع_سطر("سجل 1:")
    س1.اعرض()

    متغير س2 = جديد سجل_بيانات()
    س2.عيّن_حقل("المنتج"، "هاتف")
    س2.عيّن_حقل("السعر"، "2500")
    س2.عيّن_حقل("الكمية"، "100")
    اطبع_سطر("سجل 2:")
    س2.اعرض()
    اطبع_سطر("")

    اطبع_سطر("=== انتهى بناء الهياكل البيانية ===")
    ارجع 0
نهاية
