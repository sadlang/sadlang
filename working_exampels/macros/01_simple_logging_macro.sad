# ==============================================
# مثال 01: ماكرو التسجيل البسيط
# نظام ماكرو للتسجيل والتوكيد
# المستوى: بسيط
# ==============================================

# ---- ماكرو التسجيل بمستويات ----

دالة سجّل_تصحيح(نص رسالة)
    اطبع_سطر("[تصحيح] " + رسالة)
نهاية

دالة سجّل_معلومات(نص رسالة)
    اطبع_سطر("[معلومات] " + رسالة)
نهاية

دالة سجّل_تحذير(نص رسالة)
    اطبع_سطر("[تحذير] " + رسالة)
نهاية

دالة سجّل_مشكلة(نص رسالة)
    اطبع_سطر("[مشكلة] " + رسالة)
نهاية

# ---- ماكرو التسجيل مع السياق ----

دالة سجّل_مع_سياق(نص مستوى، نص مصدر، نص رسالة)
    اطبع_سطر("[" + مستوى + "] [" + مصدر + "] " + رسالة)
نهاية

# ---- ماكرو التوكيد مع رسالة ----

دالة تأكد_مع_رسالة(منطقي شرط، نص رسالة)
    إذا (شرط)
        سجّل_تصحيح("نجح: " + رسالة)
    وإلا
        سجّل_مشكلة("فشل: " + رسالة)
    نهاية
نهاية

# ---- ماكرو الفحص المتسلسل ----

دالة منطقي فحص_قيمة(رقم قيمة، رقم حد_أدنى، رقم حد_أعلى)
    إذا (قيمة < حد_أدنى)
        نص رس1 = "القيمة " + لنص(قيمة) + " أقل من الحد " + لنص(حد_أدنى)
        سجّل_تحذير(رس1)
        ارجع خطأ
    نهاية
    إذا (قيمة > حد_أعلى)
        نص رس2 = "القيمة " + لنص(قيمة) + " أكبر من الحد " + لنص(حد_أعلى)
        سجّل_تحذير(رس2)
        ارجع خطأ
    نهاية
    نص رس3 = "القيمة " + لنص(قيمة) + " ضمن النطاق"
    سجّل_تصحيح(رس3)
    ارجع صحيح
نهاية

# ---- ماكرو بناء التقارير ----

دالة بناء_تقرير(نص عنوان، رقم عدد_نجاح، رقم عدد_فشل)
    اطبع_سطر("==========================")
    اطبع_سطر("تقرير: " + عنوان)
    اطبع_سطر("--------------------------")
    اطبع_سطر("نجاح: " + لنص(عدد_نجاح))
    اطبع_سطر("فشل: " + لنص(عدد_فشل))
    اطبع_سطر("المجموع: " + لنص(عدد_نجاح + عدد_فشل))
    إذا (عدد_فشل == 0)
        اطبع_سطر("الحالة: كل الاختبارات نجحت")
    وإلا
        اطبع_سطر("الحالة: يوجد فشل")
    نهاية
    اطبع_سطر("==========================")
نهاية

# ---- ماكرو الجدول ----

دالة اطبع_صف(نص ع1، نص ع2، نص ع3)
    اطبع_سطر("| " + ع1 + " | " + ع2 + " | " + ع3 + " |")
نهاية

# ---- ماكرو تجميع النتائج ----

دالة رقم أكبر_قيمة(رقم أ، رقم ب، رقم ج)
    رقم نتيجة = أ
    إذا (ب > نتيجة)
        نتيجة = ب
    نهاية
    إذا (ج > نتيجة)
        نتيجة = ج
    نهاية
    ارجع نتيجة
نهاية

دالة رقم أصغر_قيمة(رقم أ، رقم ب، رقم ج)
    رقم نتيجة = أ
    إذا (ب < نتيجة)
        نتيجة = ب
    نهاية
    إذا (ج < نتيجة)
        نتيجة = ج
    نهاية
    ارجع نتيجة
نهاية

# ---- ماكرو تصنيف القيم ----

دالة نص صنّف_درجة(رقم درجة)
    إذا (درجة >= 90)
        ارجع "ممتاز"
    نهاية
    إذا (درجة >= 80)
        ارجع "جيد جدا"
    نهاية
    إذا (درجة >= 70)
        ارجع "جيد"
    نهاية
    إذا (درجة >= 60)
        ارجع "مقبول"
    نهاية
    ارجع "راسب"
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية()
    اطبع_سطر("=== نظام ماكرو التسجيل ===")
    اطبع_سطر("")

    # ماكرو التسجيل
    سجّل_تصحيح("بدء تشغيل النظام")
    سجّل_معلومات("تحميل الإعدادات")
    سجّل_تحذير("الذاكرة منخفضة")
    سجّل_مشكلة("فشل الاتصال")
    اطبع_سطر("")

    # ماكرو التسجيل مع السياق
    سجّل_مع_سياق("معلومات"، "قاعدة_بيانات"، "الاتصال ناجح")
    سجّل_مع_سياق("تحذير"، "شبكة"، "وقت الاستجابة مرتفع")
    سجّل_مع_سياق("مشكلة"، "ملفات"، "الملف غير موجود")
    اطبع_سطر("")

    # ماكرو التوكيد
    تأكد_مع_رسالة(5 > 3، "5 أكبر من 3")
    تأكد_مع_رسالة(10 == 10، "10 تساوي 10")
    تأكد_مع_رسالة(1 > 2، "1 أكبر من 2")
    اطبع_سطر("")

    # ماكرو التكرار مباشرة
    رقم ع = 0
    بينما (ع < 3)
        نص رس_تكرار = "تشغيل [معالجة] المرة " + لنص(ع + 1)
        سجّل_تصحيح(رس_تكرار)
        ع = ع + 1
    نهاية
    سجّل_معلومات("اكتمل التكرار 3 مرات")
    اطبع_سطر("")

    # ماكرو الفحص
    رقم نجاح = 0
    رقم فشل_عدد = 0

    إذا (فحص_قيمة(50، 0، 100))
        نجاح = نجاح + 1
    وإلا
        فشل_عدد = فشل_عدد + 1
    نهاية

    إذا (فحص_قيمة(150، 0، 100))
        نجاح = نجاح + 1
    وإلا
        فشل_عدد = فشل_عدد + 1
    نهاية

    إذا (فحص_قيمة(75، 10، 90))
        نجاح = نجاح + 1
    وإلا
        فشل_عدد = فشل_عدد + 1
    نهاية
    اطبع_سطر("")

    # بناء التقرير
    بناء_تقرير("فحص القيم"، نجاح، فشل_عدد)
    اطبع_سطر("")

    # ماكرو الجدول
    اطبع_سطر("--- جدول البيانات ---")
    اطبع_سطر("+--------+--------+--------+")
    اطبع_صف("الاسم"، "العمر"، "القسم")
    اطبع_سطر("+--------+--------+--------+")
    اطبع_صف("أحمد"، "25"، "هندسة")
    اطبع_صف("فاطمة"، "30"، "تصميم")
    اطبع_صف("خالد"، "28"، "إدارة")
    اطبع_سطر("+--------+--------+--------+")
    اطبع_سطر("")

    # ماكرو التجميع
    اطبع_سطر("--- تجميع القيم ---")
    اطبع_سطر("أكبر(10، 25، 15) = " + لنص(أكبر_قيمة(10، 25، 15)))
    اطبع_سطر("أصغر(10، 25، 15) = " + لنص(أصغر_قيمة(10، 25، 15)))
    اطبع_سطر("")

    # ماكرو تصنيف الدرجات
    اطبع_سطر("--- تصنيف الدرجات ---")
    اطبع_سطر("95: " + صنّف_درجة(95))
    اطبع_سطر("85: " + صنّف_درجة(85))
    اطبع_سطر("72: " + صنّف_درجة(72))
    اطبع_سطر("65: " + صنّف_درجة(65))
    اطبع_سطر("45: " + صنّف_درجة(45))
    اطبع_سطر("")

    اطبع_سطر("=== انتهى نظام ماكرو التسجيل ===")
    ارجع 0
نهاية
