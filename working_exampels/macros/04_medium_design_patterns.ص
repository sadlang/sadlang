# ==============================================
# مثال 04: ماكرو أنماط التصميم
# أنماط ماكرو لتوليد أنماط التصميم الشائعة
# المستوى: متوسط
# ==============================================

# ---- نمط المراقب (Observer Pattern) ----

صنف مراقب
    عام
        نص اسم_مراقب
        رقم عدد_الإشعارات

        باني(نص الاسم)
            اسم_مراقب = الاسم
            عدد_الإشعارات = 0
        نهاية

        دالة عالج(نص حدث_اسم، نص حدث_بيانات)
            عدد_الإشعارات = عدد_الإشعارات + 1
            اطبع_سطر("  [" + اسم_مراقب + "] تلقى: " + حدث_اسم + " -> " + حدث_بيانات)
        نهاية

        دالة رقم عدد_المعالجات()
            ارجع عدد_الإشعارات
        نهاية
نهاية

# ---- نمط الأمر (Command Pattern) ----

صنف أمر
    عام
        نص اسم_أمر
        نص وصف_أمر
        منطقي تم_تشغيله

        باني(نص الاسم، نص الوصف)
            اسم_أمر = الاسم
            وصف_أمر = الوصف
            تم_تشغيله = خطأ
        نهاية

        دالة شغّل()
            اطبع_سطر("  تشغيل: " + اسم_أمر + " - " + وصف_أمر)
            تم_تشغيله = صحيح
        نهاية

        دالة تراجع()
            إذا (تم_تشغيله)
                اطبع_سطر("  تراجع: " + اسم_أمر)
                تم_تشغيله = خطأ
            وإلا
                اطبع_سطر("  لا يمكن التراجع: " + اسم_أمر + " غير مشغل")
            نهاية
        نهاية
نهاية

# ---- نمط الحالة (State Pattern) ----

صنف آلة_حالات
    عام
        نص الحال_الحالية
        رقم عدد_الانتقالات

        باني(نص حالة_ابتدائية)
            الحال_الحالية = حالة_ابتدائية
            عدد_الانتقالات = 0
        نهاية

        دالة انتقل(نص حالة_جديدة)
            اطبع_سطر("  انتقال: " + الحال_الحالية + " -> " + حالة_جديدة)
            الحال_الحالية = حالة_جديدة
            عدد_الانتقالات = عدد_الانتقالات + 1
        نهاية

        دالة نص الحال()
            ارجع الحال_الحالية
        نهاية

        دالة رقم عدد_التغييرات()
            ارجع عدد_الانتقالات
        نهاية
نهاية

# ---- نمط الاستراتيجية (Strategy Pattern) ----

دالة رقم استراتيجية_جمع(رقم أ، رقم ب)
    ارجع أ + ب
نهاية

دالة رقم استراتيجية_ضرب(رقم أ، رقم ب)
    ارجع أ * ب
نهاية

دالة رقم استراتيجية_أكبر(رقم أ، رقم ب)
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة رقم طبق_استراتيجية(نص نوع_إ، رقم أ، رقم ب)
    طابق نوع_إ
        حالة "جمع":
            ارجع استراتيجية_جمع(أ، ب)
        حالة "ضرب":
            ارجع استراتيجية_ضرب(أ، ب)
        حالة "أكبر":
            ارجع استراتيجية_أكبر(أ، ب)
        حالة _:
            اطبع_سطر("استراتيجية غير معروفة")
            ارجع 0
    نهاية
نهاية

# ---- نمط البناء (Builder Pattern) ----

صنف بناء_رسالة
    عام
        نص عنوان_ر
        نص مرسل_ر
        نص محتوى_ر
        رقم أولوية_ر

        باني(نص العنوان)
            عنوان_ر = العنوان
            مرسل_ر = "مجهول"
            محتوى_ر = ""
            أولوية_ر = 0
        نهاية

        دالة حدد_مرسل(نص المرسل)
            مرسل_ر = المرسل
        نهاية

        دالة حدد_محتوى(نص المحتوى)
            محتوى_ر = المحتوى
        نهاية

        دالة حدد_أولوية(رقم الأولوية)
            أولوية_ر = الأولوية
        نهاية

        دالة ابنِ()
            اطبع_سطر("==========================")
            اطبع_سطر("رسالة: " + عنوان_ر)
            اطبع_سطر("من: " + مرسل_ر)
            اطبع_سطر("أولوية: " + لنص(أولوية_ر))
            اطبع_سطر("محتوى: " + محتوى_ر)
            اطبع_سطر("==========================")
        نهاية
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية()
    اطبع_سطر("=== ماكرو أنماط التصميم ===")
    اطبع_سطر("")

    # نمط المراقب
    اطبع_سطر("--- نمط المراقب ---")
    متغير م1 = جديد مراقب("سجل_النظام")
    متغير م2 = جديد مراقب("لوحة_التحكم")

    م1.عالج("تسجيل_دخول"، "المستخدم أحمد")
    م2.عالج("تسجيل_دخول"، "المستخدم أحمد")
    م1.عالج("مشكلة_نظام"، "فشل الاتصال")
    م2.عالج("مشكلة_نظام"، "فشل الاتصال")

    اطبع_سطر("إشعارات " + م1.اسم_مراقب + ": " + لنص(م1.عدد_المعالجات()))
    اطبع_سطر("إشعارات " + م2.اسم_مراقب + ": " + لنص(م2.عدد_المعالجات()))
    اطبع_سطر("")

    # نمط الأمر
    اطبع_سطر("--- نمط الأمر ---")
    متغير أ1 = جديد أمر("حفظ"، "حفظ الملف")
    متغير أ2 = جديد أمر("نسخ"، "نسخ النص")
    متغير أ3 = جديد أمر("حذف"، "حذف السطر")

    أ1.شغّل()
    أ2.شغّل()
    أ3.شغّل()
    اطبع_سطر("")
    أ3.تراجع()
    أ2.تراجع()
    أ1.تراجع()
    اطبع_سطر("")

    # نمط الحالة
    اطبع_سطر("--- نمط الحالة ---")
    متغير آلة = جديد آلة_حالات("خامل")
    آلة.انتقل("جاري_التحميل")
    آلة.انتقل("جاهز")
    آلة.انتقل("قيد_المعالجة")
    آلة.انتقل("مكتمل")
    اطبع_سطر("الحالة النهائية: " + آلة.الحال())
    اطبع_سطر("عدد الانتقالات: " + لنص(آلة.عدد_التغييرات()))
    اطبع_سطر("")

    # نمط الاستراتيجية
    اطبع_سطر("--- نمط الاستراتيجية ---")
    اطبع_سطر("جمع(10، 20) = " + لنص(طبق_استراتيجية("جمع"، 10، 20)))
    اطبع_سطر("ضرب(10، 20) = " + لنص(طبق_استراتيجية("ضرب"، 10، 20)))
    اطبع_سطر("أكبر(10، 20) = " + لنص(طبق_استراتيجية("أكبر"، 10، 20)))
    اطبع_سطر("")

    # نمط البناء
    اطبع_سطر("--- نمط البناء ---")
    متغير ر1 = جديد بناء_رسالة("اجتماع الفريق")
    ر1.حدد_مرسل("مدير المشروع")
    ر1.حدد_محتوى("اجتماع الساعة 10 صباحا غدا")
    ر1.حدد_أولوية(2)
    ر1.ابنِ()
    اطبع_سطر("")

    متغير ر2 = جديد بناء_رسالة("تحديث عاجل")
    ر2.حدد_مرسل("فريق الأمان")
    ر2.حدد_محتوى("يرجى تحديث كلمة المرور فورا")
    ر2.حدد_أولوية(5)
    ر2.ابنِ()
    اطبع_سطر("")

    اطبع_سطر("=== انتهت أنماط التصميم ===")
    ارجع 0
نهاية
