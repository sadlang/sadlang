# ==============================================
# مثال 05: ماكرو محاكاة نظام التشغيل
# نظام ماكرو شامل لمحاكاة بيئة تشغيل
# المستوى: معقد
# ==============================================

# ---- ماكرو التسجيل ----

دالة نص مستوى_لنص_م(رقم مستوى)
    طابق مستوى
        حالة 0:
            ارجع "تصحيح"
        حالة 1:
            ارجع "معلومات"
        حالة 2:
            ارجع "تحذير"
        حالة 3:
            ارجع "مشكلة"
        حالة _:
            ارجع "مجهول"
    نهاية
نهاية

دالة سجّل(رقم مستوى، نص مكوّن، نص رسالة)
    متغير اسم_م = مستوى_لنص_م(مستوى)
    اطبع_سطر("[" + اسم_م + "] [" + مكوّن + "] " + رسالة)
نهاية

# ---- محاكاة العمليات ----

صنف عملية_نظام
    عام
        رقم معرف_عملية
        نص اسم_عملية
        نص وضع_عملية
        رقم أولوية
        رقم وقت_تشغيل
        رقم ذاكرة

        باني(رقم المعرف، نص الاسم، رقم الأولوية)
            معرف_عملية = المعرف
            اسم_عملية = الاسم
            وضع_عملية = "جاهزة"
            أولوية = الأولوية
            وقت_تشغيل = 0
            ذاكرة = المعرف * 100 + 256
        نهاية

        دالة ابدأ()
            وضع_عملية = "قيد_التشغيل"
            نص رس_ب = "بدء [" + لنص(معرف_عملية) + "] " + اسم_عملية
            سجّل(1، "عمليات"، رس_ب)
        نهاية

        دالة خطوة()
            وقت_تشغيل = وقت_تشغيل + 1
        نهاية

        دالة أوقف()
            وضع_عملية = "متوقفة"
            نص رس_و = "إيقاف [" + لنص(معرف_عملية) + "] " + اسم_عملية
            سجّل(1، "عمليات"، رس_و)
        نهاية

        دالة أنهِ()
            وضع_عملية = "منتهية"
            ذاكرة = 0
            نص رس_ن = "إنهاء [" + لنص(معرف_عملية) + "] بعد " + لنص(وقت_تشغيل) + " خطوة"
            سجّل(1، "عمليات"، رس_ن)
        نهاية

        دالة اعرض_وضع()
            اطبع_سطر("  PID:" + لنص(معرف_عملية) + " | " + اسم_عملية + " | " + وضع_عملية + " | أولوية:" + لنص(أولوية) + " | ذاكرة:" + لنص(ذاكرة) + "ب")
        نهاية
نهاية

# ---- محاكاة إدارة الذاكرة ----

صنف كتلة_ذاكرة
    عام
        رقم عنوان_ك
        رقم حجم_كتلة
        منطقي مخصصة
        نص مالك

        باني(رقم العنوان، رقم الحجم_ك)
            عنوان_ك = العنوان
            حجم_كتلة = الحجم_ك
            مخصصة = خطأ
            مالك = "حر"
        نهاية

        دالة خصص(نص لمن)
            مخصصة = صحيح
            مالك = لمن
            نص رس_خ = "تخصيص " + لنص(حجم_كتلة) + "ب لـ " + لمن
            سجّل(0، "ذاكرة"، رس_خ)
        نهاية

        دالة حرّر()
            مخصصة = خطأ
            مالك = "حر"
            نص رس_ح = "تحرير " + لنص(حجم_كتلة) + "ب"
            سجّل(0، "ذاكرة"، رس_ح)
        نهاية

        دالة اعرض()
            نص حال_ذ = "حر"
            إذا (مخصصة)
                حال_ذ = "مخصصة"
            نهاية
            اطبع_سطر("  [" + لنص(عنوان_ك) + "] " + لنص(حجم_كتلة) + "ب | " + حال_ذ + " | " + مالك)
        نهاية
نهاية

# ---- محاكاة الجدولة ----

صنف مجدول
    عام
        رقم دورة_حالية
        رقم عمليات_كلية
        رقم تبديلات

        باني()
            دورة_حالية = 0
            عمليات_كلية = 0
            تبديلات = 0
        نهاية

        دالة جدول_عملية(رقم معرف، نص اسم_ع، رقم ألو)
            دورة_حالية = دورة_حالية + 1
            تبديلات = تبديلات + 1
            عمليات_كلية = عمليات_كلية + 1
            نص رس_ج = "الدورة " + لنص(دورة_حالية) + ": تشغيل [" + لنص(معرف) + "] " + اسم_ع
            سجّل(0، "مجدول"، رس_ج)
        نهاية

        دالة اعرض_إحصائيات()
            اطبع_سطر("==========================")
            اطبع_سطر("إحصائيات المجدول")
            اطبع_سطر("--------------------------")
            اطبع_سطر("الدورات: " + لنص(دورة_حالية))
            اطبع_سطر("العمليات: " + لنص(عمليات_كلية))
            اطبع_سطر("التبديلات: " + لنص(تبديلات))
            اطبع_سطر("==========================")
        نهاية
نهاية

# ---- محاكاة نظام الملفات ----

صنف ملف_وهمي
    عام
        نص اسم_ملف
        نص محتويات
        رقم حجم_ملف
        منطقي للقراءة_فقط

        باني(نص الاسم، رقم الحجم_م)
            اسم_ملف = الاسم
            محتويات = ""
            حجم_ملف = الحجم_م
            للقراءة_فقط = خطأ
        نهاية

        دالة اكتب(نص بيانات)
            إذا (للقراءة_فقط)
                سجّل(3، "ملفات"، "لا يمكن الكتابة: " + اسم_ملف)
            وإلا
                محتويات = بيانات
                سجّل(0، "ملفات"، "كتابة إلى " + اسم_ملف)
            نهاية
        نهاية

        دالة نص اقرأ_محتوى()
            سجّل(0، "ملفات"، "قراءة من " + اسم_ملف)
            ارجع محتويات
        نهاية

        دالة اقفل()
            للقراءة_فقط = صحيح
            سجّل(1، "ملفات"، "قفل " + اسم_ملف)
        نهاية

        دالة اعرض()
            نص حال_م = "كتابة"
            إذا (للقراءة_فقط)
                حال_م = "قراءة فقط"
            نهاية
            اطبع_سطر("  " + اسم_ملف + " | " + لنص(حجم_ملف) + "ب | " + حال_م)
        نهاية
نهاية

# ---- البرنامج الرئيسي ----

دالة رئيسية()
    اطبع_سطر("==========================")
    اطبع_سطر("  نظام محاكاة بيئة التشغيل")
    اطبع_سطر("==========================")
    اطبع_سطر("")

    # إنشاء العمليات
    اطبع_سطر("=== 1. العمليات ===")
    متغير ع1 = جديد عملية_نظام(1، "نواة"، 0)
    متغير ع2 = جديد عملية_نظام(2، "خادم_ويب"، 1)
    متغير ع3 = جديد عملية_نظام(3، "قاعدة_بيانات"، 1)
    متغير ع4 = جديد عملية_نظام(4، "واجهة"، 2)

    ع1.ابدأ()
    ع2.ابدأ()
    ع3.ابدأ()
    ع4.ابدأ()
    اطبع_سطر("")

    # تشغيل خطوات
    ع1.خطوة()
    ع1.خطوة()
    ع1.خطوة()
    ع2.خطوة()
    ع2.خطوة()
    ع2.خطوة()
    ع3.خطوة()
    ع3.خطوة()
    ع3.خطوة()
    سجّل(1، "نظام"، "تم تشغيل 3 خطوات")
    اطبع_سطر("")

    # عرض حالة العمليات
    اطبع_سطر("=== 2. حالة العمليات ===")
    ع1.اعرض_وضع()
    ع2.اعرض_وضع()
    ع3.اعرض_وضع()
    ع4.اعرض_وضع()
    اطبع_سطر("")

    # إدارة الذاكرة
    اطبع_سطر("=== 3. إدارة الذاكرة ===")
    متغير ك1 = جديد كتلة_ذاكرة(4096، 1024)
    متغير ك2 = جديد كتلة_ذاكرة(8192، 2048)
    متغير ك3 = جديد كتلة_ذاكرة(16384، 512)

    ك1.خصص("خادم_ويب")
    ك2.خصص("قاعدة_بيانات")
    ك3.خصص("واجهة")
    اطبع_سطر("")

    اطبع_سطر("خريطة الذاكرة:")
    ك1.اعرض()
    ك2.اعرض()
    ك3.اعرض()
    اطبع_سطر("")

    ك3.حرّر()
    اطبع_سطر("")

    # الجدولة
    اطبع_سطر("=== 4. الجدولة ===")
    متغير مج = جديد مجدول()
    مج.جدول_عملية(1، "نواة"، 0)
    مج.جدول_عملية(2، "خادم_ويب"، 1)
    مج.جدول_عملية(3، "قاعدة_بيانات"، 1)
    مج.جدول_عملية(1، "نواة"، 0)
    مج.جدول_عملية(4، "واجهة"، 2)
    اطبع_سطر("")
    مج.اعرض_إحصائيات()
    اطبع_سطر("")

    # نظام الملفات
    اطبع_سطر("=== 5. نظام الملفات ===")
    متغير مل1 = جديد ملف_وهمي("إعدادات.ص"، 1024)
    متغير مل2 = جديد ملف_وهمي("بيانات.ص"، 4096)
    متغير مل3 = جديد ملف_وهمي("سجل.txt"، 2048)

    مل1.اكتب("إعدادات النظام")
    مل2.اكتب("بيانات المستخدمين")
    مل3.اكتب("سجل الأحداث")

    مل1.اقفل()
    مل1.اكتب("محاولة تعديل ملف مقفل")
    اطبع_سطر("")

    اطبع_سطر("الملفات:")
    مل1.اعرض()
    مل2.اعرض()
    مل3.اعرض()
    اطبع_سطر("")

    # إنهاء
    اطبع_سطر("=== 6. إنهاء ===")
    ع4.أنهِ()
    ع3.أوقف()
    ع2.أنهِ()
    اطبع_سطر("")

    ك1.حرّر()
    ك2.حرّر()
    اطبع_سطر("")

    اطبع_سطر("المحاكاة اكتملت بنجاح")
    ارجع 0
نهاية
