# ==============================================
# مكتبة الرياضيات المتقدمة
# Advanced Math Library
# ==============================================

صدّر دالة رقم القيمة_المطلقة(رقم عدد)
    اذا (عدد < 0)
        ارجع 0 - عدد
    نهاية
    ارجع عدد
نهاية

صدّر دالة رقم الاكبر(رقم أ، رقم ب)
    اذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

صدّر دالة رقم الاصغر(رقم أ، رقم ب)
    اذا (أ < ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

صدّر دالة رقم العاملي(رقم ن)
    اذا (ن <= 1)
        ارجع 1
    نهاية
    رقم ناتج = 1
    رقم ع = 2
    بينما (ع <= ن)
        ناتج = ناتج * ع
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

صدّر دالة رقم القوة(رقم قاعدة، رقم أسّ)
    رقم ناتج = 1
    رقم ع = 0
    بينما (ع < أسّ)
        ناتج = ناتج * قاعدة
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

صدّر دالة رقم المجموع_حتى(رقم ن)
    رقم مج = 0
    رقم ع = 1
    بينما (ع <= ن)
        مج = مج + ع
        ع = ع + 1
    نهاية
    ارجع مج
نهاية

صدّر دالة رقم هل_اولي(رقم ن)
    اذا (ن < 2)
        ارجع 0
    نهاية
    اذا (ن == 2)
        ارجع 1
    نهاية
    رقم قاسم = 2
    بينما (قاسم * قاسم <= ن)
        اذا (ن - (ن / قاسم) * قاسم == 0)
            ارجع 0
        نهاية
        قاسم = قاسم + 1
    نهاية
    ارجع 1
نهاية

صدّر دالة رقم فيبوناتشي(رقم ن)
    اذا (ن <= 0)
        ارجع 0
    نهاية
    اذا (ن == 1)
        ارجع 1
    نهاية
    رقم أ = 0
    رقم ب = 1
    رقم ع = 2
    بينما (ع <= ن)
        رقم مؤقت = أ + ب
        أ = ب
        ب = مؤقت
        ع = ع + 1
    نهاية
    ارجع ب
نهاية

صدّر دالة رقم القاسم_المشترك(رقم أ، رقم ب)
    بينما (ب > 0)
        رقم باقي = أ - (أ / ب) * ب
        أ = ب
        ب = باقي
    نهاية
    ارجع أ
نهاية

صدّر دالة رقم المضاعف_المشترك(رقم أ، رقم ب)
    رقم قمش = القاسم_المشترك(أ، ب)
    اذا (قمش == 0)
        ارجع 0
    نهاية
    ارجع (أ / قمش) * ب
نهاية
