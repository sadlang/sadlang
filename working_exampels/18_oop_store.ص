# ==============================================
# مثال 4: نظام إدارة المتجر - OOP + ملكية متقدم
# Example 4: Store Management - Advanced OOP + Ownership
# ==============================================
# يوضح هذا المثال:
# - أصناف متعددة متفاعلة
# - وراثة مع تخصيص السلوك
# - نظام الملكية مع الكائنات
# - حلقات وشروط مع كائنات
# - أعضاء ساكنة للتتبع
# ==============================================
# شغّل بـ: sad.exe --ownership 18_oop_store.sad
# ==============================================

# ===== صنف المنتج =====
صنف منتج
    نص الاسم
    رقم السعر
    رقم الكمية
    ساكن رقم عدد_المنتجات

    باني(نص اسم، رقم سعر، رقم كمية)
        الاسم = اسم
        السعر = سعر
        الكمية = كمية
        عدد_المنتجات = عدد_المنتجات + 1
    نهاية

    دالة اعرض()
        اطبع("    ")
        اطبع(الاسم)
        اطبع(" | سعر: ")
        اطبع(السعر)
        اطبع(" | كمية: ")
        اطبع_سطر(الكمية)
    نهاية

    دالة رقم القيمة_الكلية()
        ارجع السعر * الكمية
    نهاية

    دالة رقم بيع(رقم عدد)
        إذا (عدد > الكمية)
            اطبع("    ! لا يوجد كمية كافية من ")
            اطبع_سطر(الاسم)
            ارجع 0
        نهاية
        الكمية = الكمية - عدد
        رقم اجمالي = السعر * عدد
        اطبع("    تم بيع ")
        اطبع(عدد)
        اطبع(" من ")
        اطبع(الاسم)
        اطبع(" بقيمة ")
        اطبع_سطر(اجمالي)
        ارجع اجمالي
    نهاية

    دالة اضف_مخزون(رقم عدد)
        الكمية = الكمية + عدد
        اطبع("    + تمت اضافة ")
        اطبع(عدد)
        اطبع(" الى ")
        اطبع_سطر(الاسم)
    نهاية

    ساكن دالة رقم كم_منتج()
        ارجع عدد_المنتجات
    نهاية
نهاية

# ===== صنف المنتج الإلكتروني =====
صنف منتج_الكتروني يرث منتج
    نص الماركة
    رقم الضمان

    باني(نص اسم، رقم سعر، رقم كمية، نص ماركة، رقم ضمان)
        أساس(اسم، سعر، كمية)
        الماركة = ماركة
        الضمان = ضمان
    نهاية

    دالة اعرض()
        اطبع("    [الكتروني] ")
        اطبع(الاسم)
        اطبع(" | ")
        اطبع(الماركة)
        اطبع(" | سعر: ")
        اطبع(السعر)
        اطبع(" | ضمان: ")
        اطبع(الضمان)
        اطبع_سطر(" شهر")
    نهاية
نهاية

# ===== صنف الموظف =====
صنف موظف
    نص الاسم
    رقم المعرف
    رقم المبيعات
    ساكن رقم عدد_الموظفين

    باني(نص اسم، رقم معرف)
        الاسم = اسم
        المعرف = معرف
        المبيعات = 0
        عدد_الموظفين = عدد_الموظفين + 1
    نهاية

    دالة سجل_بيع(رقم قيمة)
        المبيعات = المبيعات + قيمة
    نهاية

    دالة اعرض()
        اطبع("    موظف: ")
        اطبع(الاسم)
        اطبع(" | معرف: ")
        اطبع(المعرف)
        اطبع(" | مبيعات: ")
        اطبع_سطر(المبيعات)
    نهاية

    ساكن دالة رقم كم_موظف()
        ارجع عدد_الموظفين
    نهاية
نهاية

# ===== الدالة الرئيسية =====
دالة رئيسية()
    اطبع_سطر("========================================")
    اطبع_سطر("      نظام ادارة المتجر")
    اطبع_سطر("========================================")
    اطبع_سطر("")

    # ---- تجهيز المتجر ----
    اطبع_سطر("[1] تجهيز المتجر:")
    متغير م1 = جديد منتج("تفاح"، 5، 100)
    متغير م2 = جديد منتج("حليب"، 12، 50)
    متغير م3 = جديد منتج("خبز"، 3، 200)
    متغير م4 = جديد منتج_الكتروني("سماعات"، 150، 20، "سوني"، 12)

    م1.اعرض()
    م2.اعرض()
    م3.اعرض()
    م4.اعرض()

    اطبع("    اجمالي المنتجات: ")
    اطبع_سطر(منتج.كم_منتج())
    اطبع_سطر("")

    # ---- تسجيل الموظفين ----
    اطبع_سطر("[2] الموظفون:")
    متغير مو1 = جديد موظف("احمد"، 201)
    متغير مو2 = جديد موظف("فاطمة"، 202)

    مو1.اعرض()
    مو2.اعرض()
    اطبع("    عدد الموظفين: ")
    اطبع_سطر(موظف.كم_موظف())
    اطبع_سطر("")

    # ---- عمليات البيع ----
    اطبع_سطر("[3] عمليات البيع:")
    رقم بيع1 = م1.بيع(10)
    مو1.سجل_بيع(بيع1)

    رقم بيع2 = م2.بيع(5)
    مو1.سجل_بيع(بيع2)

    رقم بيع3 = م3.بيع(20)
    مو2.سجل_بيع(بيع3)

    رقم بيع4 = م4.بيع(2)
    مو2.سجل_بيع(بيع4)

    # محاولة بيع كمية اكبر
    رقم بيع5 = م4.بيع(50)
    اطبع_سطر("")

    # ---- إضافة مخزون ----
    اطبع_سطر("[4] اضافة مخزون:")
    م1.اضف_مخزون(50)
    م4.اضف_مخزون(10)
    اطبع_سطر("")

    # ---- نظام الملكية ----
    اطبع_سطر("[5] نظام الملكية:")

    # نسخ الأرقام
    رقم اجمالي_بيع1 = بيع1 + بيع2
    رقم اجمالي_بيع2 = بيع3 + بيع4
    اطبع("    مبيعات احمد: ")
    اطبع_سطر(اجمالي_بيع1)
    اطبع("    مبيعات فاطمة: ")
    اطبع_سطر(اجمالي_بيع2)

    رقم اجمالي_كلي = اجمالي_بيع1 + اجمالي_بيع2
    اطبع("    الاجمالي الكلي: ")
    اطبع_سطر(اجمالي_كلي)
    اطبع_سطر("")

    # استعارة نصوص
    اطبع_سطر("[6] تقرير استعارة:")
    نص اسم_متجر = "متجر الخير"
    متغير عنوان = &اسم_متجر
    اطبع("    اسم المتجر (مرجع): ")
    اطبع_سطر(عنوان)
    اطبع("    الاصل سليم: ")
    اطبع_سطر(اسم_متجر)
    اطبع_سطر("")

    # نقل النصوص
    نص تقرير = "تقرير يومي مفصل"
    متغير تقرير_مؤرشف = تقرير
    اطبع("    التقرير المؤرشف: ")
    اطبع_سطر(تقرير_مؤرشف)
    اطبع_سطر("")

    # ---- ملخص نهائي ----
    اطبع_سطر("[7] الملخص النهائي:")
    مو1.اعرض()
    مو2.اعرض()
    اطبع_سطر("")
    م1.اعرض()
    م2.اعرض()
    م3.اعرض()
    م4.اعرض()
    اطبع_سطر("")

    # حساب قيمة المخزون
    رقم قيمة_مخزون = م1.القيمة_الكلية() + م2.القيمة_الكلية() + م3.القيمة_الكلية()
    اطبع("    قيمة المخزون الكلية: ")
    اطبع_سطر(قيمة_مخزون)

    اطبع_سطر("")
    اطبع_سطر("========================================")
    اطبع_سطر("      انتهى البرنامج بنجاح")
    اطبع_سطر("========================================")
نهاية
