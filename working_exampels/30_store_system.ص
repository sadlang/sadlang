نهاية

# ===== صنف العميل =====
صنف عميل
    رقم كود_العميل
    متغير اسم_العميل
    رقم الرصيد
    رقم عدد_المشتريات
    رقم اجمالي_المصروف
    رقم نقاط_الولاء
    متغير مستوى_العضوية

    باني(رقم كود، متغير اسم_ع، رقم رصيد)
        كود_العميل = كود
        اسم_العميل = اسم_ع
        الرصيد = رصيد
        عدد_المشتريات = 0
        اجمالي_المصروف = 0
        نقاط_الولاء = 0
        مستوى_العضوية = "عادي"
    نهاية

    دالة شحن_رصيد(رقم مبلغ)
        إذا (مبلغ > 0)
            الرصيد = الرصيد + مبلغ
            اطبع_نجاح("تم شحن الرصيد")
            اطبع("  الرصيد الجديد: ")
            اطبع_سطر(الرصيد)
        وإلا
            اطبع_خطأ("المبلغ يجب أن يكون موجباً")
        نهاية
    نهاية

    دالة رقم شراء(رقم مبلغ)
        إذا (مبلغ > الرصيد)
            اطبع_خطأ("رصيد غير كافٍ!")
            اطبع("  المطلوب: ")
            اطبع_سطر(مبلغ)
            اطبع("  الرصيد: ")
            اطبع_سطر(الرصيد)
            ارجع 0
        نهاية
        الرصيد = الرصيد - مبلغ
        عدد_المشتريات = عدد_المشتريات + 1
        اجمالي_المصروف = اجمالي_المصروف + مبلغ
        # حساب النقاط
        رقم نقاط = مبلغ / 10
        نقاط_الولاء = نقاط_الولاء + نقاط
        # تحديث مستوى العضوية
        إذا (اجمالي_المصروف >= 10000)
            مستوى_العضوية = "ذهبي"
        وإلا
            إذا (اجمالي_المصروف >= 5000)
                مستوى_العضوية = "فضي"
            وإلا
                إذا (اجمالي_المصروف >= 1000)
                    مستوى_العضوية = "برونزي"
                نهاية
            نهاية
        نهاية
        ارجع 1
    نهاية

    دالة رقم حساب_الخصم()
        إذا (اجمالي_المصروف >= 10000)
            ارجع 15
        نهاية
        إذا (اجمالي_المصروف >= 5000)
            ارجع 10
        نهاية
        إذا (اجمالي_المصروف >= 1000)
            ارجع 5
        نهاية
        ارجع 0
    نهاية

    دالة عرض_ملف_العميل()
        اطبع_عنوان("=== ملف العميل ===")
        اطبع("  الكود: ")
        اطبع_سطر(كود_العميل)
        اطبع("  الاسم: ")
        اطبع_سطر(اسم_العميل)
        اطبع("  الرصيد: ")
        اطبع(الرصيد)
        اطبع_سطر(" ريال")
        اطبع("  المشتريات: ")
        اطبع_سطر(عدد_المشتريات)
        اطبع("  إجمالي المصروف: ")
        اطبع(اجمالي_المصروف)
        اطبع_سطر(" ريال")
        اطبع("  نقاط الولاء: ")
        اطبع_سطر(نقاط_الولاء)
        اطبع("  العضوية: ")
        اطبع_سطر(مستوى_العضوية)
        اطبع("  نسبة الخصم: ")
        اطبع(حساب_الخصم())
        اطبع_سطر(" %")
    نهاية

    دالة رقم الحصول_على_الرصيد()
        ارجع الرصيد
    نهاية
نهاية

# ===== صنف الفاتورة =====
صنف فاتورة
    رقم رقم_الفاتورة
    رقم المبلغ_الاساسي
    رقم الخصم_المطبق
    رقم المبلغ_النهائي
    رقم الضريبة
    ساكن رقم عداد_فواتير

    باني(رقم مبلغ، رقم خصم)
        عداد_فواتير = عداد_فواتير + 1
        رقم_الفاتورة = عداد_فواتير
        المبلغ_الاساسي = مبلغ
        الخصم_المطبق = خصم
        رقم مبلغ_بعد_خصم = مبلغ - ((مبلغ * خصم) / 100)
        الضريبة = (مبلغ_بعد_خصم * 15) / 100
        المبلغ_النهائي = مبلغ_بعد_خصم + الضريبة
    نهاية

    دالة طباعة_فاتورة()
        اطبع_سطر("  +==============================+")
        اطبع_سطر("  |        فاتورة مبيعات         |")
        اطبع_سطر("  +==============================+")
        اطبع("  | رقم الفاتورة: ")
        اطبع_سطر(رقم_الفاتورة)
        اطبع("  | المبلغ الأساسي: ")
        اطبع(المبلغ_الاساسي)
        اطبع_سطر(" ريال")
        اطبع("  | الخصم: ")
        اطبع(الخصم_المطبق)
        اطبع_سطر(" %")
        اطبع("  | الضريبة (15%): ")
        اطبع(الضريبة)
        اطبع_سطر(" ريال")
        اطبع("  | المبلغ النهائي: ")
        اطبع(المبلغ_النهائي)
        اطبع_سطر(" ريال")
        اطبع_سطر("  +==============================+")
    نهاية

    دالة رقم الحصول_على_المبلغ_النهائي()
        ارجع المبلغ_النهائي
    نهاية
نهاية

