# ===== صنف المنتج الأساسي =====
صنف منتج
    رقم كود_المنتج
    متغير اسم_المنتج
    رقم سعر_المنتج
    رقم الكمية_المتوفرة
    رقم عدد_المبيعات
    متغير الفئة
    رقم التقييم
    ساكن رقم عداد_منتجات

    باني(رقم كود، متغير اسم_م، رقم سعر، رقم كمية، متغير فئة)
        كود_المنتج = كود
        اسم_المنتج = اسم_م
        سعر_المنتج = سعر
        الكمية_المتوفرة = كمية
        عدد_المبيعات = 0
        الفئة = فئة
        التقييم = 0
        عداد_منتجات = عداد_منتجات + 1
    نهاية

    دالة رقم الحصول_على_السعر()
        ارجع سعر_المنتج
    نهاية

    دالة رقم الحصول_على_الكمية()
        ارجع الكمية_المتوفرة
    نهاية

    دالة رقم بيع(رقم كمية_بيع)
        إذا (كمية_بيع <= 0)
            اطبع_خطأ("الكمية يجب أن تكون موجبة")
            ارجع 0
        نهاية
        إذا (كمية_بيع > الكمية_المتوفرة)
            اطبع_خطأ("الكمية غير متوفرة!")
            اطبع("  المتوفر: ")
            اطبع_سطر(الكمية_المتوفرة)
            ارجع 0
        نهاية
        الكمية_المتوفرة = الكمية_المتوفرة - كمية_بيع
        عدد_المبيعات = عدد_المبيعات + كمية_بيع
        رقم اجمالي = سعر_المنتج * كمية_بيع
        اطبع_نجاح("تمت عملية البيع بنجاح")
        اطبع("  المبلغ: ")
        اطبع_سطر(اجمالي)
        ارجع اجمالي
    نهاية

    دالة اضافة_مخزون(رقم كمية_جديدة)
        إذا (كمية_جديدة > 0)
            الكمية_المتوفرة = الكمية_المتوفرة + كمية_جديدة
            اطبع_نجاح("تم إضافة المخزون")
            اطبع("  الكمية الجديدة: ")
            اطبع_سطر(الكمية_المتوفرة)
        وإلا
            اطبع_خطأ("الكمية يجب أن تكون موجبة")
        نهاية
    نهاية

    دالة تعيين_تقييم(رقم تق)
        إذا (تق >= 1)
            إذا (تق <= 5)
                التقييم = تق
                اطبع_نجاح("تم تحديث التقييم")
            وإلا
                اطبع_خطأ("التقييم من 1 إلى 5")
            نهاية
        وإلا
            اطبع_خطأ("التقييم من 1 إلى 5")
        نهاية
    نهاية

    دالة تعديل_سعر(رقم سعر_جديد)
        إذا (سعر_جديد > 0)
            رقم سعر_قديم = سعر_المنتج
            سعر_المنتج = سعر_جديد
            اطبع_نجاح("تم تعديل السعر")
            اطبع("  السعر القديم: ")
            اطبع_سطر(سعر_قديم)
            اطبع("  السعر الجديد: ")
            اطبع_سطر(سعر_المنتج)
        وإلا
            اطبع_خطأ("السعر يجب أن يكون موجباً")
        نهاية
    نهاية

    دالة عرض_المنتج()
        اطبع("  [")
        اطبع(كود_المنتج)
        اطبع("] ")
        اطبع(اسم_المنتج)
        اطبع(" - السعر: ")
        اطبع(سعر_المنتج)
        اطبع(" - المتوفر: ")
        اطبع(الكمية_المتوفرة)
        اطبع(" - التقييم: ")
        اطبع(التقييم)
        اطبع_سطر("/5")
    نهاية

    دالة عرض_تفاصيل()
        اطبع_سطر("  +--------------------------+")
        اطبع("  | الكود: ")
        اطبع_سطر(كود_المنتج)
        اطبع("  | الاسم: ")
        اطبع_سطر(اسم_المنتج)
        اطبع("  | الفئة: ")
        اطبع_سطر(الفئة)
        اطبع("  | السعر: ")
        اطبع(سعر_المنتج)
        اطبع_سطر(" ريال")
        اطبع("  | المتوفر: ")
        اطبع(الكمية_المتوفرة)
        اطبع_سطر(" وحدة")
        اطبع("  | المبيعات: ")
        اطبع_سطر(عدد_المبيعات)
        اطبع("  | التقييم: ")
        اطبع(التقييم)
        اطبع_سطر(" / 5")
        رقم ايرادات = سعر_المنتج * عدد_المبيعات
        اطبع("  | إجمالي الإيرادات: ")
        اطبع(ايرادات)
        اطبع_سطر(" ريال")
        اطبع_سطر("  +--------------------------+")
    نهاية

    دالة رقم الحصول_على_المبيعات()
        ارجع عدد_المبيعات
    نهاية

    دالة رقم حساب_الايرادات()
        ارجع سعر_المنتج * عدد_المبيعات
    نهاية
نهاية

# ===== صنف منتج إلكتروني يرث من منتج =====
صنف منتج_الكتروني يرث منتج
    متغير العلامة_التجارية
    رقم مدة_الضمان
    رقم الوزن
    متغير اللون

    باني(رقم كود، متغير اسم_م، رقم سعر، رقم كمية، متغير علامة، رقم ضمان)
        أساس(كود، اسم_م، سعر، كمية، "إلكترونيات")
        العلامة_التجارية = علامة
        مدة_الضمان = ضمان
        الوزن = 0
        اللون = "أسود"
    نهاية

    دالة تعيين_لون(متغير لون)
        اللون = لون
        اطبع_نجاح("تم تعيين اللون")
    نهاية

    دالة تعيين_وزن(رقم وزن)
        إذا (وزن > 0)
            الوزن = وزن
            اطبع_نجاح("تم تعيين الوزن")
        نهاية
    نهاية

    دالة رقم هل_تحت_الضمان(رقم اشهر_منذ_الشراء)
        إذا (اشهر_منذ_الشراء <= مدة_الضمان)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة عرض_تفاصيل_الكتروني()
        عرض_تفاصيل()
        اطبع("  | العلامة: ")
        اطبع_سطر(العلامة_التجارية)
        اطبع("  | الضمان: ")
        اطبع(مدة_الضمان)
        اطبع_سطر(" شهر")
        اطبع("  | اللون: ")
        اطبع_سطر(اللون)
        اطبع("  | الوزن: ")
        اطبع(الوزن)
        اطبع_سطر(" كغ")
    نهاية
نهاية

# ===== صنف منتج غذائي يرث من منتج =====
صنف منتج_غذائي يرث منتج
    متغير تاريخ_الانتاج
    رقم مدة_الصلاحية
    رقم السعرات

    باني(رقم كود، متغير اسم_م، رقم سعر، رقم كمية، رقم صلاحية)
        أساس(كود، اسم_م، سعر، كمية، "أغذية")
        تاريخ_الانتاج = "2024-01-01"
        مدة_الصلاحية = صلاحية
        السعرات = 0
    نهاية

    دالة تعيين_سعرات(رقم سعرات)
        إذا (سعرات >= 0)
            السعرات = سعرات
        نهاية
    نهاية

    دالة رقم هل_صالح(رقم ايام_مضت)
        إذا (ايام_مضت <= مدة_الصلاحية)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة عرض_تفاصيل_غذائي()
        عرض_تفاصيل()
        اطبع("  | الإنتاج: ")
        اطبع_سطر(تاريخ_الانتاج)
        اطبع("  | الصلاحية: ")
        اطبع(مدة_الصلاحية)
        اطبع_سطر(" يوم")
        اطبع("  | السعرات: ")
        اطبع(السعرات)
        اطبع_سطر(" سعرة")
    نهاية
نهاية

