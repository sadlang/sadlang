زر_لون(bac, 165, 165, 165)
نص_لون(bac, 0, 0, 0)
نص_حجم(bac, 28)

متغير bsign = زر_عنصر("+/-")
عنصر_توسيع(bsign, 1)
زر_لون(bsign, 165, 165, 165)
نص_لون(bsign, 0, 0, 0)
نص_حجم(bsign, 28)

متغير bpct = زر_عنصر("%")
عنصر_توسيع(bpct, 1)
زر_لون(bpct, 165, 165, 165)
نص_لون(bpct, 0, 0, 0)
نص_حجم(bpct, 28)

متغير bdiv = زر_عنصر("/")
عنصر_توسيع(bdiv, 1)
زر_لون(bdiv, 255, 159, 10)
نص_حجم(bdiv, 28)

عنصر_اضف(r1, bac)
عنصر_اضف(r1, bsign)
عنصر_اضف(r1, bpct)
عنصر_اضف(r1, bdiv)
عنصر_اضف(main_col, r1)

# ===== صف 2: 7, 8, 9, * =====
متغير r2 = صف_جديد()
عنصر_تباعد(r2, 8)
عنصر_ارتفاع(r2, 60)

متغير b7 = زر_عنصر("7")
عنصر_توسيع(b7, 1)
زر_لون(b7, 80, 80, 80)
نص_حجم(b7, 28)

متغير b8 = زر_عنصر("8")
عنصر_توسيع(b8, 1)
زر_لون(b8, 80, 80, 80)
نص_حجم(b8, 28)

متغير b9 = زر_عنصر("9")
عنصر_توسيع(b9, 1)
زر_لون(b9, 80, 80, 80)
نص_حجم(b9, 28)

متغير bmul = زر_عنصر("*")
عنصر_توسيع(bmul, 1)
زر_لون(bmul, 255, 159, 10)
نص_حجم(bmul, 28)

عنصر_اضف(r2, b7)
عنصر_اضف(r2, b8)
عنصر_اضف(r2, b9)
عنصر_اضف(r2, bmul)
عنصر_اضف(main_col, r2)

# ===== صف 3: 4, 5, 6, - =====
متغير r3 = صف_جديد()
عنصر_تباعد(r3, 8)
عنصر_ارتفاع(r3, 60)

متغير b4 = زر_عنصر("4")
عنصر_توسيع(b4, 1)
زر_لون(b4, 80, 80, 80)
نص_حجم(b4, 28)

متغير b5 = زر_عنصر("5")
عنصر_توسيع(b5, 1)
زر_لون(b5, 80, 80, 80)
نص_حجم(b5, 28)

متغير b6 = زر_عنصر("6")
عنصر_توسيع(b6, 1)
زر_لون(b6, 80, 80, 80)
نص_حجم(b6, 28)

متغير bsub = زر_عنصر("-")
عنصر_توسيع(bsub, 1)
زر_لون(bsub, 255, 159, 10)
نص_حجم(bsub, 28)

عنصر_اضف(r3, b4)
عنصر_اضف(r3, b5)
عنصر_اضف(r3, b6)
عنصر_اضف(r3, bsub)
عنصر_اضف(main_col, r3)

# ===== صف 4: 1, 2, 3, + =====
متغير r4 = صف_جديد()
عنصر_تباعد(r4, 8)
عنصر_ارتفاع(r4, 60)

متغير b1 = زر_عنصر("1")
عنصر_توسيع(b1, 1)
زر_لون(b1, 80, 80, 80)
نص_حجم(b1, 28)

متغير b2 = زر_عنصر("2")
عنصر_توسيع(b2, 1)
زر_لون(b2, 80, 80, 80)
نص_حجم(b2, 28)

متغير b3 = زر_عنصر("3")
عنصر_توسيع(b3, 1)
زر_لون(b3, 80, 80, 80)
نص_حجم(b3, 28)

متغير badd = زر_عنصر("+")
عنصر_توسيع(badd, 1)
زر_لون(badd, 255, 159, 10)
نص_حجم(badd, 28)

عنصر_اضف(r4, b1)
عنصر_اضف(r4, b2)
عنصر_اضف(r4, b3)
عنصر_اضف(r4, badd)
عنصر_اضف(main_col, r4)

# ===== صف 5: 0, ., = =====
متغير r5 = صف_جديد()
عنصر_تباعد(r5, 8)
عنصر_ارتفاع(r5, 60)

متغير b0 = زر_عنصر("0")
عنصر_توسيع(b0, 2)
زر_لون(b0, 80, 80, 80)
نص_حجم(b0, 28)

متغير bdot = زر_عنصر(".")
عنصر_توسيع(bdot, 1)
زر_لون(bdot, 80, 80, 80)
نص_حجم(bdot, 28)

متغير beq = زر_عنصر("=")
عنصر_توسيع(beq, 1)
زر_لون(beq, 255, 159, 10)
نص_حجم(beq, 28)

عنصر_اضف(r5, b0)
عنصر_اضف(r5, bdot)
عنصر_اضف(r5, beq)
عنصر_اضف(main_col, r5)

# تعيين المحتوى / Set content
تطبيق_محتوى(app, main_col)

# ===== دالة إضافة رقم =====
دالة add_digit(d)
    اذا (new_input == 1)
        display_text = d
        new_input = 0
    والا
        display_text = display_text + d
    نهاية
    نص_محتوى(dtext, display_text)
نهاية

# ===== دالة حساب النتيجة =====
دالة calculate()
    متغير sn = display_text + 0
    متغير res = 0

    اذا (op_type == "+")
        res = first_num + sn
    نهاية
    اذا (op_type == "-")
        res = first_num - sn
    نهاية
    اذا (op_type == "*")
        res = first_num * sn
    نهاية
    اذا (op_type == "/")
        اذا (sn != 0)
            res = first_num / sn
        والا
            res = 0
        نهاية
    نهاية

    display_text = res + ""
    نص_محتوى(dtext, display_text)
    new_input = 1
    op_type = ""
نهاية

# ===== دالة اختيار العملية =====
دالة set_op(o)
    first_num = display_text + 0
    op_type = o
    new_input = 1
    has_dot = 0
نهاية

# ===== الحلقة الرئيسية / Main Loop =====
بينما (تطبيق_يعمل(app))
    تطبيق_تحديث(app)

    اذا (زر_ضغط(b0))
        add_digit("0")
    نهاية
    اذا (زر_ضغط(b1))
        add_digit("1")
    نهاية
    اذا (زر_ضغط(b2))
        add_digit("2")
    نهاية
    اذا (زر_ضغط(b3))
        add_digit("3")
    نهاية
    اذا (زر_ضغط(b4))
        add_digit("4")
    نهاية
    اذا (زر_ضغط(b5))
        add_digit("5")
    نهاية
    اذا (زر_ضغط(b6))
        add_digit("6")
    نهاية
    اذا (زر_ضغط(b7))
        add_digit("7")
    نهاية
    اذا (زر_ضغط(b8))
        add_digit("8")
    نهاية
    اذا (زر_ضغط(b9))
        add_digit("9")
    نهاية

    اذا (زر_ضغط(bdot))
        اذا (has_dot == 0)
            اذا (new_input == 1)
                display_text = "0."
                new_input = 0
            والا
                display_text = display_text + "."
            نهاية
            has_dot = 1
            نص_محتوى(dtext, display_text)
        نهاية
    نهاية

    اذا (زر_ضغط(badd))
        set_op("+")
    نهاية
    اذا (زر_ضغط(bsub))
        set_op("-")
    نهاية
    اذا (زر_ضغط(bmul))
        set_op("*")
    نهاية
    اذا (زر_ضغط(bdiv))
        set_op("/")
    نهاية

    اذا (زر_ضغط(beq))
        اذا (op_type != "")
            calculate()
        نهاية
    نهاية

    اذا (زر_ضغط(bac))
        display_text = "0"
        first_num = 0
        op_type = ""
        new_input = 1
        has_dot = 0
        نص_محتوى(dtext, "0")
    نهاية

    اذا (زر_ضغط(bpct))
        متغير pv = display_text + 0
        pv = pv / 100
        display_text = pv + ""
        نص_محتوى(dtext, display_text)
        new_input = 1
    نهاية

    اذا (زر_ضغط(bsign))
        متغير sv = display_text + 0
        sv = sv * -1
        display_text = sv + ""
        نص_محتوى(dtext, display_text)
    نهاية
نهاية

تطبيق_اغلاق(app)
