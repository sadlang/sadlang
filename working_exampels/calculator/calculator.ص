عنصر_تباعد(main_col, 8)

# بطاقة الشاشة / Display card
متغير dcard = بطاقة_جديدة()
عنصر_ارتفاع(dcard, 90)
عنصر_لون(dcard, 50, 50, 60)
عنصر_حدود(dcard, 12)

متغير dtext = نص_عنصر("0")
نص_حجم(dtext, 42)
نص_لون(dtext, 255, 255, 255)
نص_محاذاة(dtext, "right")
عنصر_اضف(dcard, dtext)
