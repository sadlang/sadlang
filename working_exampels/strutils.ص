صدّر دالة طول_نص(قيمة)
    ارجع طول(قيمة)
نهاية

صدّر دالة هل_فارغ(قيمة)
    اذا (طول(قيمة) == 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة كرر_نص(قيمة، عدد)
    متغير ناتج = ""
    متغير ع = 0
    بينما (ع < عدد)
        ناتج = ناتج + قيمة
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية
