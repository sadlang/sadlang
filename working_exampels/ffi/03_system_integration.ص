# أمثلة متقدمة - تكامل النظام
# مستوى: متقدم
# يعمل في: المفسر (sad) والمترجم (sadc)

دالة رئيسية()
    printf("=== تكامل النظام المتقدم ===\n\n")
    
    # === 1. معلومات النظام ===
    printf("--- معلومات النظام ---\n")
    متغير اسم_مستخدم = getenv("USERNAME")
    متغير مسار_النظام = getenv("SYSTEMROOT")
    متغير عدد_معالجات = getenv("NUMBER_OF_PROCESSORS")
    
    printf("المستخدم: %s\n"، اسم_مستخدم)
    printf("نظام التشغيل: %s\n"، مسار_النظام)
    printf("عدد المعالجات: %s\n"، عدد_معالجات)
    
    # === 2. تنفيذ أوامر النظام ===
    printf("\n--- تنفيذ أوامر ---\n")
    system("echo تاريخ اليوم: & date /t")
    system("echo الوقت الآن: & time /t")
    
    # === 3. معالجة نصوص متقدمة ===
    printf("\n--- معالجة النصوص ---\n")
    
    متغير نص1 = "برمجة"
    متغير نص2 = "بلغة ص"
    متغير كامل = strcat(نص1، " ")
    متغير جملة = strcat(كامل، نص2)
    printf("الجملة: %s\n"، جملة)
    printf("طول الجملة: %d\n"، strlen(جملة))
    
    # مقارنة نصوص
    متغير م1 = strcmp("أ"، "ب")
    متغير م2 = strcmp("ب"، "أ")
    متغير م3 = strcmp("نفس"، "نفس")
    printf("مقارنة أ<ب: %d\n"، م1)
    printf("مقارنة ب>أ: %d\n"، م2)
    printf("مقارنة نفس=نفس: %d\n"، م3)
    
    # === 4. تحويل أنواع ===
    printf("\n--- تحويل الأنواع ---\n")
    متغير ع1 = atoi("999")
    متغير ع2 = atoi("-42")
    متغير ع3 = atof("2.71828")
    printf("من نص لعدد: %d\n"، ع1)
    printf("عدد سالب: %d\n"، ع2)
    printf("عدد عشري (e): %f\n"، ع3)
    
    # === 5. كتابة ملف CSV ===
    printf("\n--- إنشاء ملف CSV ---\n")
    متغير ملف = fopen("test_ffi_data.csv"، "w")
    fputs("الاسم,العمر,المدينة\n"، ملف)
    fputs("أحمد,25,الرياض\n"، ملف)
    fputs("سارة,30,جدة\n"، ملف)
    fputs("محمد,22,الدمام\n"، ملف)
    fclose(ملف)
    printf("تم إنشاء ملف CSV بنجاح\n")
    
    # قراءة الملف
    متغير قارئ = fopen("test_ffi_data.csv"، "r")
    متغير رأس = fgets(256، قارئ)
    printf("رأس الجدول: %s"، رأس)
    متغير صف1 = fgets(256، قارئ)
    printf("الصف الأول: %s"، صف1)
    fclose(قارئ)
    
    # === 6. حاسبة بسيطة بـ snprintf ===
    printf("\n--- حاسبة ---\n")
    متغير أ = atoi("15")
    متغير ب = atoi("27")
    
    متغير نتيجة_نص = snprintf("%d + %d = %d"، أ، ب، 42)
    printf("%s\n"، نتيجة_نص)
    
    printf("\n=== انتهت الأمثلة المتقدمة ===\n")
نهاية
