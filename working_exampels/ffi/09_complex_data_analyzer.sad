# ============================================
# مثال معقد: محلل بيانات بـ FFI
# Complex: FFI Data Analyzer
# ============================================

# === متغيرات عامة ===
متغير عدد_تحليلات = 0
متغير عدد_تحويلات = 0

# === أدوات العرض ===
دالة خط_مزدوج()
    printf("  ══════════════════════════════════════════\n")
نهاية

دالة عنوان_تح(عنوان: نص)
    printf("\n")
    خط_مزدوج()
    printf("  ★ %s\n"، عنوان)
    خط_مزدوج()
نهاية

دالة عنصر_فرعي(عنوان: نص)
    printf("\n  ◆ %s\n"، عنوان)
    printf("  ──────────────────────\n")
نهاية

# ═══════════════════════════════════════
# تحليل 1: معالج الأرقام
# ═══════════════════════════════════════
دالة تحليل_ارقام()
    عنوان_تح("معالج الأرقام المتقدم")

    عنصر_فرعي("تحويل مجموعة أرقام")
    متغير ق1 = atoi("15")
    متغير ق2 = atoi("27")
    متغير ق3 = atoi("42")
    متغير ق4 = atoi("58")
    متغير ق5 = atoi("73")
    متغير ق6 = atoi("89")
    متغير ق7 = atoi("34")
    متغير ق8 = atoi("61")
    عدد_تحويلات = عدد_تحويلات + 8

    printf("    البيانات: %d, %d, %d, %d, %d, %d, %d, %d\n"، ق1، ق2، ق3، ق4، ق5، ق6، ق7، ق8)

    عنصر_فرعي("حسابات إحصائية")
    متغير مجموع = ق1 + ق2 + ق3 + ق4 + ق5 + ق6 + ق7 + ق8
    متغير متوسط = مجموع / 8
    printf("    المجموع: %d\n"، مجموع)
    printf("    المتوسط: %d\n"، متوسط)

    # حساب الانحرافات
    متغير ان1 = ق1 - متوسط
    متغير ان2 = ق2 - متوسط
    متغير ان3 = ق3 - متوسط
    متغير ان4 = ق4 - متوسط
    printf("    انحراف %d: %d\n"، ق1، ان1)
    printf("    انحراف %d: %d\n"، ق2، ان2)
    printf("    انحراف %d: %d\n"، ق3، ان3)
    printf("    انحراف %d: %d\n"، ق4، ان4)

    عنصر_فرعي("عمليات حسابية مركبة")
    متغير ض1 = ق1 * ق2
    متغير ض2 = ق3 * ق4
    متغير ض3 = ق5 * ق6
    printf("    %d × %d = %d\n"، ق1، ق2، ض1)
    printf("    %d × %d = %d\n"، ق3، ق4، ض2)
    printf("    %d × %d = %d\n"، ق5، ق6، ض3)

    متغير مج_مربعات = ق1*ق1 + ق2*ق2 + ق3*ق3 + ق4*ق4
    printf("    مجموع المربعات (أول 4): %d\n"، مج_مربعات)

    عدد_تحليلات = عدد_تحليلات + 1
    printf("  [✓] تم تحليل الأرقام\n")
نهاية

# ═══════════════════════════════════════
# تحليل 2: معالج النصوص
# ═══════════════════════════════════════
دالة تحليل_نصوص()
    عنوان_تح("معالج النصوص المتقدم")

    عنصر_فرعي("بناء قاعدة نصوص")
    متغير كلمة_1 = "بيانات"
    متغير كلمة_2 = "تحليل"
    متغير كلمة_3 = "نظام"
    متغير كلمة_4 = "معلومات"

    # أطوال
    متغير ط1 = strlen(كلمة_1)
    متغير ط2 = strlen(كلمة_2)
    متغير ط3 = strlen(كلمة_3)
    متغير ط4 = strlen(كلمة_4)

    printf("    '%s': %d بايت\n"، كلمة_1، ط1)
    printf("    '%s': %d بايت\n"، كلمة_2، ط2)
    printf("    '%s': %d بايت\n"، كلمة_3، ط3)
    printf("    '%s': %d بايت\n"، كلمة_4، ط4)

    متغير مج_أطوال = ط1 + ط2 + ط3 + ط4
    printf("    إجمالي البايتات: %d\n"، مج_أطوال)

    عنصر_فرعي("دمج النصوص المتسلسل")
    متغير سلسلة_أ = strcat("نظام "، "تحليل ")
    متغير سلسلة_ب = strcat(سلسلة_أ، "البيانات ")
    متغير سلسلة_ج = strcat(سلسلة_ب، "المتقدم")
    printf("    النتيجة: %s\n"، سلسلة_ج)

    متغير طول_سلسلة = strlen(سلسلة_ج)
    printf("    الطول: %d بايت\n"، طول_سلسلة)

    عنصر_فرعي("مصفوفة المقارنات")
    # مقارنة كل زوج
    متغير م12 = strcmp(كلمة_1، كلمة_2)
    متغير م13 = strcmp(كلمة_1، كلمة_3)
    متغير م14 = strcmp(كلمة_1، كلمة_4)
    متغير م23 = strcmp(كلمة_2، كلمة_3)
    متغير م24 = strcmp(كلمة_2، كلمة_4)
    متغير م34 = strcmp(كلمة_3، كلمة_4)

    printf("    بيانات vs تحليل: %d\n"، م12)
    printf("    بيانات vs نظام: %d\n"، م13)
    printf("    بيانات vs معلومات: %d\n"، م14)
    printf("    تحليل vs نظام: %d\n"، م23)
    printf("    تحليل vs معلومات: %d\n"، م24)
    printf("    نظام vs معلومات: %d\n"، م34)

    عنصر_فرعي("بناء مسارات")
    متغير مسار_أ = strcat("data"، "/")
    متغير مسار_ب = strcat(مسار_أ، "analysis")
    متغير مسار_ج = strcat(مسار_ب، "/")
    متغير مسار_كامل = strcat(مسار_ج، "results.csv")
    printf("    المسار: %s\n"، مسار_كامل)

    متغير طول_مسار = strlen(مسار_كامل)
    printf("    طول المسار: %d\n"، طول_مسار)

    عدد_تحليلات = عدد_تحليلات + 1
    printf("  [✓] تم تحليل النصوص\n")
نهاية

# ═══════════════════════════════════════
# تحليل 3: معالج البيئة
# ═══════════════════════════════════════
دالة تحليل_بيئة()
    عنوان_تح("تحليل بيئة النظام")

    عنصر_فرعي("متغيرات البيئة الأساسية")
    متغير مستخدم = getenv("USERNAME")
    متغير نظام = getenv("OS")
    متغير معمارية = getenv("PROCESSOR_ARCHITECTURE")

    printf("    المستخدم: %s\n"، مستخدم)
    printf("    النظام: %s\n"، نظام)
    printf("    المعمارية: %s\n"، معمارية)

    عنصر_فرعي("تحليل الأطوال")
    متغير طول_مستخدم = strlen(مستخدم)
    متغير طول_نظام = strlen(نظام)
    متغير طول_معمارية = strlen(معمارية)

    printf("    طول اسم المستخدم: %d\n"، طول_مستخدم)
    printf("    طول اسم النظام: %d\n"، طول_نظام)
    printf("    طول المعمارية: %d\n"، طول_معمارية)

    متغير مجموع_اطوال = طول_مستخدم + طول_نظام + طول_معمارية
    printf("    إجمالي: %d بايت\n"، مجموع_اطوال)

    عنصر_فرعي("بناء ملف تشخيصي")
    متغير تشخيص_1 = strcat("النظام: "، نظام)
    printf("    %s\n"، تشخيص_1)

    متغير تشخيص_2 = strcat("المعمارية: "، معمارية)
    printf("    %s\n"، تشخيص_2)

    متغير تشخيص_3 = strcat("المستخدم: "، مستخدم)
    printf("    %s\n"، تشخيص_3)

    عدد_تحليلات = عدد_تحليلات + 1
    printf("  [✓] تم تحليل البيئة\n")
نهاية

# ═══════════════════════════════════════
# تحليل 4: حسابات مالية
# ═══════════════════════════════════════
دالة تحليل_مالي()
    عنوان_تح("تحليل مالي")

    عنصر_فرعي("أسعار المنتجات")
    متغير س1 = atoi("250")
    متغير س2 = atoi("180")
    متغير س3 = atoi("320")
    متغير س4 = atoi("95")
    متغير س5 = atoi("410")
    عدد_تحويلات = عدد_تحويلات + 5

    printf("    منتج 1: %d ريال\n"، س1)
    printf("    منتج 2: %d ريال\n"، س2)
    printf("    منتج 3: %d ريال\n"، س3)
    printf("    منتج 4: %d ريال\n"، س4)
    printf("    منتج 5: %d ريال\n"، س5)

    عنصر_فرعي("حسابات الفاتورة")
    متغير مج = س1 + س2 + س3 + س4 + س5
    printf("    المجموع: %d ريال\n"، مج)

    متغير ضريبة = مج * 15 / 100
    printf("    الضريبة (15%%): %d ريال\n"، ضريبة)

    متغير اجمالي_ف = مج + ضريبة
    printf("    الإجمالي: %d ريال\n"، اجمالي_ف)

    عنصر_فرعي("خصم الكمية")
    متغير خصم = اجمالي_ف * 10 / 100
    متغير بعد_خصم_ف = اجمالي_ف - خصم
    printf("    خصم 10%%: %d ريال\n"، خصم)
    printf("    بعد الخصم: %d ريال\n"، بعد_خصم_ف)

    عدد_تحليلات = عدد_تحليلات + 1
    printf("  [✓] تم التحليل المالي\n")
نهاية

# === ملخص ===
دالة ملخص_التحليل()
    عنوان_تح("ملخص التحليل")
    printf("    عدد التحليلات: %d\n"، عدد_تحليلات)
    printf("    عدد التحويلات: %d\n"، عدد_تحويلات)
    متغير اجمالي_ع = عدد_تحليلات + عدد_تحويلات
    printf("    الإجمالي: %d عملية\n"، اجمالي_ع)
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    printf("╔══════════════════════════════════════════════╗\n")
    printf("║         محلل البيانات المتقدم بـ FFI       ║\n")
    printf("╚══════════════════════════════════════════════╝\n")

    تحليل_ارقام()
    تحليل_نصوص()
    تحليل_بيئة()
    تحليل_مالي()
    ملخص_التحليل()

    printf("\n=== انتهى محلل البيانات بنجاح ===\n")
    ارجع 0
نهاية
