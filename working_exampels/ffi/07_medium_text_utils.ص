دالة فاصل_ع()
    printf("  ═══════════════════════════════\n")
نهاية

دالة عنوان_نص(عنوان: نص)
    printf("\n")
    فاصل_ع()
    printf("  ▸ %s\n"، عنوان)
    فاصل_ع()
نهاية

# === فحص النصوص ===
دالة اختبار_فحص_نصوص()
    عنوان_نص("فحص خصائص النصوص")

    # أطوال نصوص مختلفة
    printf("  أطوال نصوص:\n")
    متغير ط_أ = strlen("A")
    متغير ط_ب = strlen("AB")
    متغير ط_ج = strlen("ABC")
    متغير ط_د = strlen("ABCDEFGHIJ")
    متغير ط_هـ = strlen("ABCDEFGHIJKLMNOPQRSTUVWXYZ")

    printf("    1 حرف: %d\n"، ط_أ)
    printf("    2 حرف: %d\n"، ط_ب)
    printf("    3 حرف: %d\n"، ط_ج)
    printf("    10 حرف: %d\n"، ط_د)
    printf("    26 حرف: %d\n"، ط_هـ)

    # أطوال نصوص عربية
    printf("\n  أطوال نصوص عربية (بايت):\n")
    متغير طع1 = strlen("أ")
    متغير طع2 = strlen("مرحبا")
    متغير طع3 = strlen("لغة سعد")

    printf("    'أ': %d بايت\n"، طع1)
    printf("    'مرحبا': %d بايت\n"، طع2)
    printf("    'لغة سعد': %d بايت\n"، طع3)

    printf("  [✓] تم\n")
نهاية

# === بناء النصوص ===
دالة اختبار_بناء_نصوص()
    عنوان_نص("بناء النصوص بالدمج")

    # دمج متسلسل
    printf("  دمج نصوص:\n")
    متغير ج1 = strcat("Hello"، " World")
    printf("    %s\n"، ج1)

    متغير ج2 = strcat("SAD"، " Language")
    printf("    %s\n"، ج2)

    متغير ج3 = strcat("أهلا"، " وسهلا")
    printf("    %s\n"، ج3)

    # بناء جملة من أجزاء
    printf("\n  بناء جملة:\n")
    متغير أ = strcat("لغة "، "البرمجة ")
    متغير ب = strcat(أ، "العربية")
    printf("    النتيجة: %s\n"، ب)

    متغير ج = strcat("الإصدار "، "2.0 ")
    متغير د = strcat(ج، "- مستقر")
    printf("    النتيجة: %s\n"، د)

    printf("  [✓] تم\n")
نهاية

# === مقارنة وترتيب ===
دالة اختبار_مقارنة_ترتيب()
    عنوان_نص("مقارنة وترتيب النصوص")

    printf("  مقارنات (0 = متطابق):\n")

    # نصوص متطابقة
    متغير م1 = strcmp("test"، "test")
    printf("    'test' vs 'test': %d\n"، م1)

    متغير م2 = strcmp("hello"، "hello")
    printf("    'hello' vs 'hello': %d\n"، م2)

    # نصوص مختلفة
    متغير م3 = strcmp("apple"، "banana")
    printf("    'apple' vs 'banana': %d\n"، م3)

    متغير م4 = strcmp("banana"، "apple")
    printf("    'banana' vs 'apple': %d\n"، م4)

    متغير م5 = strcmp("cat"، "dog")
    printf("    'cat' vs 'dog': %d\n"، م5)

    # حالة الأحرف
    متغير م6 = strcmp("ABC"، "abc")
    printf("    'ABC' vs 'abc': %d\n"، م6)

    متغير م7 = strcmp("Hello"، "hello")
    printf("    'Hello' vs 'hello': %d\n"، م7)

    # نصوص فارغة
    متغير م8 = strcmp(""، "")
    printf("    '' vs '': %d\n"، م8)

    printf("  [✓] تم\n")
نهاية

# === تحويل البيانات ===
دالة اختبار_تحويل()
    عنوان_نص("تحويل البيانات")

    printf("  أرقام صحيحة:\n")
    متغير ق1 = atoi("1")
    متغير ق2 = atoi("10")
    متغير ق3 = atoi("100")
    متغير ق4 = atoi("1000")
    متغير ق5 = atoi("10000")

    printf("    '1' → %d\n"، ق1)
    printf("    '10' → %d\n"، ق2)
    printf("    '100' → %d\n"، ق3)
    printf("    '1000' → %d\n"، ق4)
    printf("    '10000' → %d\n"، ق5)

    # مجموع التحويلات
    متغير مجموع = ق1 + ق2 + ق3 + ق4 + ق5
    printf("    المجموع: %d\n"، مجموع)

    printf("\n  أرقام عشرية:\n")
    متغير عش1 = atof("0.5")
    متغير عش2 = atof("1.5")
    متغير عش3 = atof("2.5")
    printf("    0.5 + 1.5 + 2.5 = ?\n")
    printf("    %f\n"، عش1)
    printf("    %f\n"، عش2)
    printf("    %f\n"، عش3)

    printf("  [✓] تم\n")
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    printf("╔══════════════════════════════════════════╗\n")
    printf("║       أدوات النصوص بـ FFI             ║\n")
    printf("╚══════════════════════════════════════════╝\n")

    اختبار_فحص_نصوص()
    اختبار_بناء_نصوص()
    اختبار_مقارنة_ترتيب()
    اختبار_تحويل()

    printf("\n=== انتهت أدوات النصوص بنجاح ===\n")
    ارجع 0
نهاية
