# ============================================
# مثال بسيط: دوال FFI للنصوص
# Simple: FFI String Functions
# ============================================

دالة رئيسية() -> رقم
    printf("╔══════════════════════════════════════╗\n")
    printf("║     دوال FFI للنصوص              ║\n")
    printf("╚══════════════════════════════════════╝\n")

    # === طول النصوص ===
    printf("\n--- طول النصوص ---\n")
    متغير ط1 = strlen("Hello")
    printf("طول 'Hello': %d\n"، ط1)

    متغير ط2 = strlen("مرحبا بالعالم")
    printf("طول 'مرحبا بالعالم': %d\n"، ط2)

    متغير ط3 = strlen("")
    printf("طول نص فارغ: %d\n"، ط3)

    متغير ط4 = strlen("Programming in SAD")
    printf("طول 'Programming in SAD': %d\n"، ط4)

    # === مقارنة النصوص ===
    printf("\n--- مقارنة النصوص ---\n")
    متغير م1 = strcmp("أحمد"، "أحمد")
    printf("'أحمد' == 'أحمد': %d (0=متطابق)\n"، م1)

    متغير م2 = strcmp("أحمد"، "سارة")
    printf("'أحمد' vs 'سارة': %d\n"، م2)

    متغير م3 = strcmp("abc"، "abc")
    printf("'abc' == 'abc': %d\n"، م3)

    متغير م4 = strcmp("abc"، "xyz")
    printf("'abc' vs 'xyz': %d\n"، م4)

    متغير م5 = strcmp(""، "")
    printf("'' == '': %d\n"، م5)

    # === دمج النصوص ===
    printf("\n--- دمج النصوص ---\n")
    متغير ج1 = strcat("مرحبا "، "يا عالم!")
    printf("الدمج: %s\n"، ج1)

    متغير ج2 = strcat("SAD "، "Language")
    printf("الدمج: %s\n"، ج2)

    متغير ج3 = strcat("الجزء_1 "، "الجزء_2")
    printf("الدمج: %s\n"، ج3)

    # === تحويل النصوص إلى أرقام ===
    printf("\n--- تحويل النصوص ---\n")
    متغير ر1 = atoi("42")
    printf("atoi('42') = %d\n"، ر1)

    متغير ر2 = atoi("100")
    printf("atoi('100') = %d\n"، ر2)

    متغير ر3 = atoi("-25")
    printf("atoi('-25') = %d\n"، ر3)

    متغير ر4 = atoi("0")
    printf("atoi('0') = %d\n"، ر4)

    متغير ع1 = atof("3.14")
    printf("atof('3.14') = %f\n"، ع1)

    متغير ع2 = atof("2.718")
    printf("atof('2.718') = %f\n"، ع2)

    printf("\n=== انتهى اختبار النصوص بنجاح ===\n")
    ارجع 0
نهاية
