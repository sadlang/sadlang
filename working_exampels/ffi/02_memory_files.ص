# أمثلة متوسطة - إدارة الذاكرة والملفات
# مستوى: متوسط
# يعمل في: المفسر (sad) والمترجم (sadc)

دالة رئيسية()
    printf("=== إدارة الذاكرة ===\n")
    
    # حجز ذاكرة
    متغير ذاكرة1 = malloc(1024)
    printf("تم حجز 1024 بايت\n")
    
    # إعادة حجز بحجم أكبر
    متغير ذاكرة2 = realloc(ذاكرة1، 2048)
    printf("تم إعادة الحجز إلى 2048 بايت\n")
    
    # حجز صفري (مملوء بأصفار)
    متغير ذاكرة3 = calloc(10، 64)
    printf("تم حجز صفري: 10 عناصر × 64 بايت\n")
    
    # تحرير الذاكرة
    free(ذاكرة2)
    free(ذاكرة3)
    printf("تم تحرير كل الذاكرة\n")
    
    printf("\n=== عمليات الملفات ===\n")
    
    # كتابة ملف
    متغير ملف1 = fopen("test_ffi_output.txt"، "w")
    fputs("السطر الأول: مرحبا!\n"، ملف1)
    fputs("السطر الثاني: هذا ملف FFI\n"، ملف1)
    fputs("السطر الثالث: نهاية\n"، ملف1)
    fclose(ملف1)
    printf("تم كتابة الملف بنجاح\n")
    
    # قراءة الملف
    متغير ملف2 = fopen("test_ffi_output.txt"، "r")
    متغير سطر1 = fgets(256، ملف2)
    printf("قراءة: %s"، سطر1)
    متغير سطر2 = fgets(256، ملف2)
    printf("قراءة: %s"، سطر2)
    fclose(ملف2)
    
    printf("\n=== تنسيق النصوص ===\n")
    
    # استخدام snprintf لبناء نصوص
    متغير معلومات = snprintf("الاسم: %s | العمر: %d | المدينة: %s"، "سارة"، 30، "الرياض")
    printf("المعلومات: %s\n"، معلومات)
    
    متغير تقرير = snprintf("العدد %d من %d = %f%%"، 75، 100، 75)
    printf("التقرير: %s\n"، تقرير)
    
    printf("\n=== انتهى المثال المتوسط ===\n")
نهاية
