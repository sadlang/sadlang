# ============================================
# مثال متوسط: نظام معالجة البيانات بـ FFI
# Medium: FFI Data Processing System
# ============================================

# === دوال مساعدة ===
دالة طباعة_فاصل()
    printf("  ─────────────────────────────\n")
نهاية

دالة عنوان_ق(عنوان: نص)
    printf("\n")
    طباعة_فاصل()
    printf("  ◆ %s\n"، عنوان)
    طباعة_فاصل()
نهاية

# === معالجة الأرقام ===
دالة اختبار_تحويل_ارقام()
    عنوان_ق("تحويل ومعالجة الأرقام")

    # تحويل نصوص إلى أرقام صحيحة
    printf("  تحويلات صحيحة:\n")
    متغير ر1 = atoi("100")
    متغير ر2 = atoi("200")
    متغير ر3 = atoi("300")
    متغير مجموع = ر1 + ر2 + ر3
    printf("    %d + %d + %d = %d\n"، ر1، ر2، ر3، مجموع)

    متغير ر4 = atoi("50")
    متغير ر5 = atoi("25")
    متغير حاصل = ر4 * ر5
    printf("    %d × %d = %d\n"، ر4، ر5، حاصل)

    # تحويل نصوص إلى أرقام عشرية
    printf("\n  تحويلات عشرية:\n")
    متغير ع1 = atof("3.14159")
    متغير ع2 = atof("2.71828")
    printf("    π ≈ %f\n"، ع1)
    printf("    e ≈ %f\n"، ع2)

    متغير ع3 = atof("1.414")
    متغير ع4 = atof("1.732")
    printf("    √2 ≈ %f\n"، ع3)
    printf("    √3 ≈ %f\n"، ع4)

    printf("  [✓] تم\n")
نهاية

# === معالجة النصوص المتقدمة ===
دالة اختبار_نصوص_متقدمة()
    عنوان_ق("معالجة النصوص المتقدمة")

    # بناء نصوص بالدمج
    printf("  بناء نصوص:\n")
    متغير جزء_1 = "السلام "
    متغير جزء_2 = "عليكم "
    متغير جملة_أ = strcat(جزء_1، جزء_2)
    printf("    الجملة: %s\n"، جملة_أ)

    متغير اسم = "محمد"
    متغير لقب = " أحمد"
    متغير اسم_كامل = strcat(اسم، لقب)
    printf("    الاسم الكامل: %s\n"، اسم_كامل)

    # مقارنة نصوص متعددة
    printf("\n  مقارنات:\n")
    متغير ن1 = "أحمد"
    متغير ن2 = "أحمد"
    متغير ن3 = "سارة"
    متغير ن4 = "محمد"

    متغير م1 = strcmp(ن1، ن2)
    printf("    '%s' vs '%s': %d\n"، ن1، ن2، م1)

    متغير م2 = strcmp(ن1، ن3)
    printf("    '%s' vs '%s': %d\n"، ن1، ن3، م2)

    متغير م3 = strcmp(ن3، ن4)
    printf("    '%s' vs '%s': %d\n"، ن3، ن4، م3)

    # أطوال نصوص متعددة
    printf("\n  أطوال:\n")
    متغير ط1 = strlen("Hello World")
    متغير ط2 = strlen("مرحبا")
    متغير ط3 = strlen("SAD Programming Language")

    printf("    'Hello World': %d حرف\n"، ط1)
    printf("    'مرحبا': %d بايت\n"، ط2)
    printf("    'SAD Programming Language': %d حرف\n"، ط3)

    printf("  [✓] تم\n")
نهاية

# === متغيرات البيئة ===
دالة اختبار_بيئة()
    عنوان_ق("متغيرات البيئة")

    متغير مستخدم = getenv("USERNAME")
    printf("    المستخدم: %s\n"، مستخدم)

    متغير مسار = getenv("PATH")
    متغير طول_مسار = strlen(مسار)
    printf("    طول PATH: %d حرف\n"، طول_مسار)

    متغير نظام = getenv("OS")
    printf("    نظام التشغيل: %s\n"، نظام)

    متغير معالج_ب = getenv("PROCESSOR_ARCHITECTURE")
    printf("    المعالج: %s\n"، معالج_ب)

    printf("  [✓] تم\n")
نهاية

# === حسابات مركبة ===
دالة اختبار_حسابات()
    عنوان_ق("حسابات مركبة")

    # حساب من نصوص
    متغير سعر_نص = "150"
    متغير كمية_نص = "3"
    متغير سعر = atoi(سعر_نص)
    متغير كمية = atoi(كمية_نص)
    متغير اجمالي = سعر * كمية
    printf("    السعر: %d × الكمية: %d = %d\n"، سعر، كمية، اجمالي)

    متغير خصم_نص = "10"
    متغير خصم = atoi(خصم_نص)
    متغير بعد_خصم = اجمالي - اجمالي * خصم / 100
    printf("    بعد خصم %d%%: %d\n"، خصم، بعد_خصم)

    # حساب مساحة
    متغير طول_نص = "15"
    متغير عرض_نص = "10"
    متغير طول_ق = atoi(طول_نص)
    متغير عرض_ق = atoi(عرض_نص)
    متغير مساحة = طول_ق * عرض_ق
    printf("    المساحة: %d × %d = %d\n"، طول_ق، عرض_ق، مساحة)

    printf("  [✓] تم\n")
نهاية

# === نقطة الدخول ===
دالة رئيسية() -> رقم
    printf("╔══════════════════════════════════════════╗\n")
    printf("║    نظام معالجة البيانات بـ FFI        ║\n")
    printf("╚══════════════════════════════════════════╝\n")

    اختبار_تحويل_ارقام()
    اختبار_نصوص_متقدمة()
    اختبار_بيئة()
    اختبار_حسابات()

    printf("\n=== انتهى نظام المعالجة بنجاح ===\n")
    ارجع 0
نهاية
