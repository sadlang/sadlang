# ============================================
# مثال معقد: نظام معلومات متكامل بـ FFI
# Complex: Integrated Information System
# ============================================

# === متغيرات النظام ===
متغير عداد_عمليات = 0

# === دوال مساعدة ===
دالة فصل_رئيسي()
    printf("  ══════════════════════════════════════\n")
نهاية

دالة عنوان_نظام(عنوان: نص)
    printf("\n")
    فصل_رئيسي()
    printf("  ★ %s\n"، عنوان)
    فصل_رئيسي()
نهاية

دالة عم_فرع(عنوان: نص)
    printf("\n  ▸ %s\n"، عنوان)
    printf("  ─────────────────────\n")
نهاية

# ═══════════════════════════════════════
# القسم 1: نظام السجلات
# ═══════════════════════════════════════
دالة اختبار_سجلات()
    عنوان_نظام("نظام إدارة السجلات")

    عم_فرع("إنشاء سجلات الطلاب")

    # إنشاء أسماء كاملة
    متغير اسم_1 = strcat("أحمد "، "محمد")
    متغير اسم_2 = strcat("سارة "، "علي")
    متغير اسم_3 = strcat("خالد "، "إبراهيم")
    متغير اسم_4 = strcat("فاطمة "، "حسن")
    متغير اسم_5 = strcat("عمر "، "يوسف")

    printf("    1. %s\n"، اسم_1)
    printf("    2. %s\n"، اسم_2)
    printf("    3. %s\n"، اسم_3)
    printf("    4. %s\n"، اسم_4)
    printf("    5. %s\n"، اسم_5)

    عم_فرع("أطوال الأسماء")
    متغير ط1 = strlen(اسم_1)
    متغير ط2 = strlen(اسم_2)
    متغير ط3 = strlen(اسم_3)
    متغير ط4 = strlen(اسم_4)
    متغير ط5 = strlen(اسم_5)

    printf("    أحمد محمد: %d بايت\n"، ط1)
    printf("    سارة علي: %d بايت\n"، ط2)
    printf("    خالد إبراهيم: %d بايت\n"، ط3)
    printf("    فاطمة حسن: %d بايت\n"، ط4)
    printf("    عمر يوسف: %d بايت\n"، ط5)

    عم_فرع("مقارنة الأسماء")
    متغير م1 = strcmp(اسم_1، اسم_2)
    printf("    أحمد vs سارة: %d\n"، م1)
    متغير م2 = strcmp(اسم_1، اسم_1)
    printf("    أحمد vs أحمد: %d (متطابق)\n"، م2)

    عداد_عمليات = عداد_عمليات + 5
    printf("  [✓] تم إنشاء %d سجلات\n"، 5)
نهاية

# ═══════════════════════════════════════
# القسم 2: نظام الدرجات
# ═══════════════════════════════════════
دالة اختبار_درجات()
    عنوان_نظام("نظام حساب الدرجات")

    عم_فرع("تحويل الدرجات من نصوص")

    متغير د1 = atoi("85")
    متغير د2 = atoi("92")
    متغير د3 = atoi("78")
    متغير د4 = atoi("95")
    متغير د5 = atoi("88")

    printf("    الطالب 1: %d\n"، د1)
    printf("    الطالب 2: %d\n"، د2)
    printf("    الطالب 3: %d\n"، د3)
    printf("    الطالب 4: %d\n"، د4)
    printf("    الطالب 5: %d\n"، د5)

    عم_فرع("الإحصائيات")
    متغير مجموع = د1 + د2 + د3 + د4 + د5
    متغير متوسط = مجموع / 5
    printf("    المجموع: %d\n"، مجموع)
    printf("    المتوسط: %d\n"، متوسط)

    # أعلى وأدنى
    متغير اعلى = د4  # 95
    متغير ادنى = د3  # 78
    متغير فرق = اعلى - ادنى
    printf("    أعلى: %d\n"، اعلى)
    printf("    أدنى: %d\n"، ادنى)
    printf("    الفرق: %d\n"، فرق)

    عم_فرع("معدلات من نصوص عشرية")
    متغير مع1 = atof("3.85")
    متغير مع2 = atof("3.92")
    متغير مع3 = atof("3.50")
    printf("    معدل 1: %f\n"، مع1)
    printf("    معدل 2: %f\n"، مع2)
    printf("    معدل 3: %f\n"، مع3)

    عداد_عمليات = عداد_عمليات + 8
    printf("  [✓] تم حساب الدرجات\n")
نهاية

# ═══════════════════════════════════════
# القسم 3: نظام التقارير
# ═══════════════════════════════════════
دالة اختبار_تقارير()
    عنوان_نظام("نظام توليد التقارير")

    عم_فرع("تقرير معلومات النظام")
    متغير مستخدم = getenv("USERNAME")
    متغير نظام_تشغيل = getenv("OS")
    متغير معالج_ن = getenv("PROCESSOR_ARCHITECTURE")

    printf("    المستخدم: %s\n"، مستخدم)
    printf("    النظام: %s\n"، نظام_تشغيل)
    printf("    المعالج: %s\n"، معالج_ن)

    عم_فرع("بناء عنوان التقرير")
    متغير عنوان_جزء1 = strcat("تقرير - "، "نظام المعلومات")
    متغير عنوان_جزء2 = strcat(عنوان_جزء1، " - الإصدار 1.0")
    printf("    العنوان: %s\n"، عنوان_جزء2)

    متغير طول_عنوان = strlen(عنوان_جزء2)
    printf("    طول العنوان: %d حرف\n"، طول_عنوان)

    عم_فرع("تقرير الأداء")
    متغير عمليات_نص = "1500"
    متغير عمليات_رقم = atoi(عمليات_نص)
    متغير زمن_نص = "250"
    متغير زمن_رقم = atoi(زمن_نص)

    printf("    العمليات: %d\n"، عمليات_رقم)
    printf("    الزمن: %d ملي ثانية\n"، زمن_رقم)

    متغير معدل = عمليات_رقم / زمن_رقم
    printf("    المعدل: %d عملية/ملي ثانية\n"، معدل)

    عداد_عمليات = عداد_عمليات + 6
    printf("  [✓] تم توليد التقارير\n")
نهاية

# ═══════════════════════════════════════
# القسم 4: نظام التحقق
# ═══════════════════════════════════════
دالة اختبار_تحقق()
    عنوان_نظام("نظام التحقق والمصادقة")

    عم_فرع("التحقق من الهوية")

    متغير مستخدم_حالي = getenv("USERNAME")
    متغير طول_اسم = strlen(مستخدم_حالي)
    printf("    المستخدم: %s\n"، مستخدم_حالي)
    printf("    طول الاسم: %d\n"، طول_اسم)

    # محاكاة فحص كلمة مرور (مقارنة نصوص)
    عم_فرع("فحص بيانات الدخول")
    متغير ف1 = strcmp("admin"، "admin")
    printf("    admin vs admin: %d (0=صحيح)\n"، ف1)

    متغير ف2 = strcmp("admin"، "user")
    printf("    admin vs user: %d (غير متطابق)\n"، ف2)

    متغير ف3 = strcmp("password123"، "password123")
    printf("    كلمة المرور: %d (0=صحيح)\n"، ف3)

    عم_فرع("بناء رسائل التحقق")
    متغير رسالة_أ = strcat("مرحبا "، مستخدم_حالي)
    متغير رسالة_ب = strcat(رسالة_أ، "! تم تسجيل الدخول")
    printf("    %s\n"، رسالة_ب)

    عداد_عمليات = عداد_عمليات + 4
    printf("  [✓] تم التحقق\n")
نهاية

# === الملخص ===
دالة طباعة_ملخص()
    عنوان_نظام("ملخص النظام")
    printf("    إجمالي العمليات: %d\n"، عداد_عمليات)
    printf("    الحالة: مكتمل\n")
نهاية

# === نقطة الدخول ===
دالة رئيسية()
    printf("╔══════════════════════════════════════════════╗\n")
    printf("║      نظام المعلومات المتكامل بـ FFI       ║\n")
    printf("╚══════════════════════════════════════════════╝\n")

    اختبار_سجلات()
    اختبار_درجات()
    اختبار_تقارير()
    اختبار_تحقق()
    طباعة_ملخص()

    printf("\n=== انتهى نظام المعلومات بنجاح ===\n")
نهاية
