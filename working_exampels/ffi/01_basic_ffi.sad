# أمثلة بسيطة - التكامل مع C/C++ (FFI)
# مستوى: مبتدئ
# يعمل في: المفسر (sad) والمترجم (sadc)

دالة رئيسية()
    # === طباعة منسقة باستخدام printf ===
    printf("مرحبا بالعالم!\n")
    printf("الاسم: %s\n"، "أحمد")
    printf("العمر: %d سنة\n"، 25)
    printf("المعدل: %f\n"، 3.14)
    
    # === تحويل النصوص ===
    متغير رقم1 = atoi("42")
    متغير رقم2 = atoi("100")
    printf("المجموع: %d\n"، رقم1)
    
    متغير عشري1 = atof("2.718")
    printf("الرقم العشري: %f\n"، عشري1)
    
    # === معالجة النصوص ===
    متغير طول1 = strlen("مرحبا")
    printf("طول النص: %d حرف\n"، طول1)
    
    متغير نتيجة = strcmp("أحمد"، "أحمد")
    printf("المقارنة (0 = متطابق): %d\n"، نتيجة)
    
    متغير جملة = strcat("مرحبا "، "يا عالم!")
    printf("الجملة: %s\n"، جملة)
    
    # === متغيرات البيئة ===
    متغير اسم_المستخدم = getenv("USERNAME")
    printf("المستخدم: %s\n"، اسم_المستخدم)
    
    printf("=== انتهى المثال البسيط ===\n")
نهاية
