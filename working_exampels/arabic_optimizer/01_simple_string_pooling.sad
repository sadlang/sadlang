# =============================================================
# مثال بسيط 1: تجميع النصوص العربية (String Pooling)
# =============================================================
# الهدف: اختبار أن النصوص العربية المتكررة تُدمج في مرجع واحد
# المستوى: بسيط
# الميزة: Arabic String Pooling (T154)
# =============================================================

دالة رئيسية()
    اطبع_سطر("=== اختبار تجميع النصوص العربية ===")
    اطبع_سطر("")

    # --- 1. نصوص متكررة تماماً ---
    # المحسّن يجب أن يدمج هذه النصوص الثلاثة في مرجع واحد
    متغير تحية1 = "السلام عليكم ورحمة الله"
    متغير تحية2 = "السلام عليكم ورحمة الله"
    متغير تحية3 = "السلام عليكم ورحمة الله"

    اطبع_سطر("--- النصوص المتكررة ---")
    اطبع_سطر(تحية1)
    اطبع_سطر(تحية2)
    اطبع_سطر(تحية3)

    # --- 2. نصوص عربية مختلفة ---
    اطبع_سطر("")
    اطبع_سطر("--- نصوص متنوعة ---")
    اطبع_سطر("بسم الله الرحمن الرحيم")
    اطبع_سطر("الحمد لله رب العالمين")
    اطبع_سطر("لا إله إلا الله")

    # --- 3. تكرار نص آخر ---
    متغير بلد = "المملكة العربية السعودية"
    اطبع_سطر("")
    اطبع_سطر("--- البلد ---")
    اطبع_سطر(بلد)
    اطبع_سطر("المملكة العربية السعودية")

    # --- 4. أعداد مع نصوص عربية ---
    رقم عدد_التكرارات = 5
    اطبع_سطر("")
    اطبع("عدد التكرارات: ")
    اطبع_سطر(عدد_التكرارات)

    # --- 5. نصوص قصيرة متكررة ---
    اطبع_سطر("")
    اطبع_سطر("--- نصوص قصيرة ---")
    اطبع_سطر("نعم")
    اطبع_سطر("لا")
    اطبع_سطر("نعم")
    اطبع_سطر("لا")

    اطبع_سطر("")
    اطبع_سطر("=== تم اختبار تجميع النصوص بنجاح ===")
    ارجع 0
نهاية
