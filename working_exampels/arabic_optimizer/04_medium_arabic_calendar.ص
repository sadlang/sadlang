# --- دالة حساب العمر بالأيام ---
دالة رقم حساب_ايام(رقم سنوات)
    ارجع سنوات * 365
نهاية

# --- دالة رقم حساب_اسابيع ---
دالة رقم حساب_اسابيع(رقم ايام)
    ارجع ايام / 7
نهاية

# --- دالة طباعة خط ---
دالة خط()
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
نهاية

# --- دالة عرض رأس قسم ---
دالة عرض_عنوان(نص عنوان)
    اطبع_سطر("")
    خط()
    اطبع("  ")
    اطبع_سطر(عنوان)
    خط()
نهاية

# === الدالة الرئيسية ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════╗")
    اطبع_سطر("║      التقويم العربي - لغة ص             ║")
    اطبع_سطر("║      مع تحسين النصوص العربية            ║")
    اطبع_سطر("╚══════════════════════════════════════════╝")

    # === القسم 1: أيام الأسبوع ===
    عرض_عنوان("أيام الأسبوع")
    متغير يوم = 1
    بينما (يوم <= 7)
        اطبع("  اليوم ")
        اطبع(يوم)
        اطبع(": ")
        عرض_يوم(يوم)
        نوع_يوم(يوم)
        يوم = يوم + 1
    نهاية

    # === القسم 2: الأشهر الهجرية ===
    عرض_عنوان("الأشهر الهجرية")
    متغير شهر = 1
    بينما (شهر <= 12)
        اطبع("  الشهر ")
        اطبع(شهر)
        اطبع(": ")
        عرض_شهر_هجري(شهر)
        شهر = شهر + 1
    نهاية

    # === القسم 3: حسابات العمر ===
    عرض_عنوان("حسابات العمر")
    رقم عمر = 25
    رقم الأيام = حساب_ايام(عمر)
    رقم الأسابيع = حساب_اسابيع(الأيام)

    اطبع("  العمر: ")
    اطبع(عمر)
    اطبع_سطر(" سنة")
    اطبع("  بالأيام: ")
    اطبع(الأيام)
    اطبع_سطر(" يوم")
    اطبع("  بالأسابيع: ")
    اطبع(الأسابيع)
    اطبع_سطر(" أسبوع")

    # === القسم 4: الفصول ===
    عرض_عنوان("الفصول الأربعة")

    متغير فصل = 1
    بينما (فصل <= 4)
        طابق فصل
            حالة 1:
                اطبع_سطر("  الربيع - فصل الزهور والاعتدال")
            حالة 2:
                اطبع_سطر("  الصيف - فصل الحرارة والإجازات")
            حالة 3:
                اطبع_سطر("  الخريف - فصل الأوراق المتساقطة")
            حالة 4:
                اطبع_سطر("  الشتاء - فصل البرد والأمطار")
            حالة _:
                اطبع_سطر("  فصل غير معروف")
        نهاية
        فصل = فصل + 1
    نهاية

    # === القسم 5: نصوص متكررة (String Pooling) ===
    عرض_عنوان("اختبار تجميع النصوص")
    اطبع_سطر("  بسم الله الرحمن الرحيم")
    اطبع_سطر("  بسم الله الرحمن الرحيم")
    اطبع_سطر("  الحمد لله رب العالمين")
    اطبع_سطر("  الحمد لله رب العالمين")
    اطبع_سطر("  لا حول ولا قوة إلا بالله")
    اطبع_سطر("  لا حول ولا قوة إلا بالله")

    # الختام
    اطبع_سطر("")
    خط()
    اطبع_سطر("  تم إنشاء التقويم العربي بنجاح!")
    اطبع_سطر("  لغة ص - البرمجة بالعربية")
    خط()
    اطبع_سطر("")
    اطبع_سطر("=== اكتمل الاختبار المتوسط 2 ===")
    ارجع 0
نهاية
