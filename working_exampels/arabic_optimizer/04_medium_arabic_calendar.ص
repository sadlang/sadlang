# --- دالة اسم اليوم بالعربية ---
دالة عرض_يوم(رقم رقم_يوم)
    طابق رقم_يوم
        حالة 1:
            اطبع("الأحد")
        حالة 2:
            اطبع("الاثنين")
        حالة 3:
            اطبع("الثلاثاء")
        حالة 4:
            اطبع("الأربعاء")
        حالة 5:
            اطبع("الخميس")
        حالة 6:
            اطبع("الجمعة")
        حالة 7:
            اطبع("السبت")
        حالة _:
            اطبع("غير معروف")
    نهاية
نهاية

