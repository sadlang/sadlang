# --- دالة نوع اليوم ---
دالة نوع_يوم(رقم رقم_يوم)
    طابق رقم_يوم
        حالة 6:
            اطبع_سطر(" - يوم مبارك (الجمعة)")
        حالة 7:
            اطبع_سطر(" - عطلة (السبت)")
        حالة _:
            اطبع_سطر(" - يوم عمل")
    نهاية
