# =============================================================
# مثال متوسط 1: نظام إدارة الطلاب مع تحسين النصوص العربية
# =============================================================
# الهدف: اختبار تجميع النصوص + مطابقة الأنماط + الدوال + الحلقات
# المستوى: متوسط
# الميزات: String Pooling, Pattern Matching, Functions, Loops
# =============================================================

# --- دالة حساب التقدير ---
دالة تقييم_درجة(رقم درجة)
    طابق درجة
        حالة 100:
            اطبع_سطر("  التقدير: ممتاز مع مرتبة الشرف")
        حالة 95:
            اطبع_سطر("  التقدير: ممتاز")
        حالة 90:
            اطبع_سطر("  التقدير: جيد جداً عالي")
        حالة 85:
            اطبع_سطر("  التقدير: جيد جداً")
        حالة 80:
            اطبع_سطر("  التقدير: جيد")
        حالة 75:
            اطبع_سطر("  التقدير: مقبول")
        حالة 70:
            اطبع_سطر("  التقدير: ضعيف")
        حالة _:
            اطبع_سطر("  التقدير: راسب")
    نهاية
نهاية

# --- دالة طباعة الفاصل ---
دالة طباعة_فاصل()
    اطبع_سطر("────────────────────────────────")
نهاية

# --- دالة عرض معلومات الطالب ---
دالة عرض_طالب(نص اسم، رقم رقم_طالب، رقم درجة_رياضيات، رقم درجة_عربي، رقم درجة_علوم)
    اطبع_سطر("")
    طباعة_فاصل()
    اطبع("  الاسم: ")
    اطبع_سطر(اسم)
    اطبع("  رقم الطالب: ")
    اطبع_سطر(رقم_طالب)
    اطبع_سطر("")

    # عرض الدرجات
    اطبع("  الرياضيات: ")
    اطبع_سطر(درجة_رياضيات)
    تقييم_درجة(درجة_رياضيات)

    اطبع("  اللغة العربية: ")
    اطبع_سطر(درجة_عربي)
    تقييم_درجة(درجة_عربي)

    اطبع("  العلوم: ")
    اطبع_سطر(درجة_علوم)
    تقييم_درجة(درجة_علوم)

    # حساب المجموع والمعدل
    رقم المجموع = درجة_رياضيات + درجة_عربي + درجة_علوم
    اطبع_سطر("")
    اطبع("  المجموع: ")
    اطبع_سطر(المجموع)
    طباعة_فاصل()
نهاية

# --- دالة تحديد الفصل الدراسي ---
دالة عرض_فصل(رقم شهر)
    اطبع("  الفصل الدراسي: ")
    طابق شهر
        حالة 9:
            اطبع_سطر("الفصل الأول - سبتمبر")
        حالة 10:
            اطبع_سطر("الفصل الأول - أكتوبر")
        حالة 11:
            اطبع_سطر("الفصل الأول - نوفمبر")
        حالة 12:
            اطبع_سطر("الفصل الأول - ديسمبر")
        حالة 1:
            اطبع_سطر("الفصل الأول - يناير")
        حالة 2:
            اطبع_سطر("الفصل الثاني - فبراير")
        حالة 3:
            اطبع_سطر("الفصل الثاني - مارس")
        حالة 4:
            اطبع_سطر("الفصل الثاني - أبريل")
        حالة 5:
            اطبع_سطر("الفصل الثاني - مايو")
        حالة 6:
            اطبع_سطر("الفصل الثاني - يونيو")
        حالة _:
            اطبع_سطر("عطلة صيفية")
    نهاية
نهاية

# --- دالة عد تنازلي ---
دالة عد_تنازلي(رقم بداية)
    اطبع_سطر("  العد التنازلي:")
    متغير عداد = بداية
    بينما (عداد > 0)
        اطبع("    ")
        اطبع(عداد)
        اطبع("...")
        اطبع_سطر("")
        عداد = عداد - 1
    نهاية
    اطبع_سطر("  انتهى!")
نهاية

# === الدالة الرئيسية ===
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║   نظام إدارة الطلاب - لغة ص         ║")
    اطبع_سطر("║   مع تحسين النصوص العربية            ║")
    اطبع_سطر("╚══════════════════════════════════════╝")

    # عرض الفصل الحالي
    عرض_فصل(3)

    # تكرار نصوص (يجب أن يتم تجميعها بواسطة المحسّن)
    اطبع_سطر("")
    اطبع_سطر("══════ كشف الدرجات ══════")

    # الطالب الأول
    عرض_طالب("أحمد محمد العلي"، 1001، 95، 90، 85)

    # الطالب الثاني
    عرض_طالب("فاطمة عبدالله السعيد"، 1002، 80، 100، 90)

    # الطالب الثالث
    عرض_طالب("خالد سعد الغامدي"، 1003، 75، 85، 70)

    # ملخص
    اطبع_سطر("")
    اطبع_سطر("══════ الملخص ══════")
    اطبع_سطر("  عدد الطلاب: 3")
    اطبع_سطر("  الفصل: الثاني")

    # العد التنازلي حتى الاختبارات
    اطبع_سطر("")
    اطبع_سطر("  أيام متبقية حتى الاختبارات:")
    عد_تنازلي(5)

    # نصوص متكررة (String Pooling)
    اطبع_سطر("")
    اطبع_سطر("══════ النتيجة ══════")
    اطبع_سطر("  تم إصدار كشف الدرجات بنجاح")
    اطبع_سطر("  تم إصدار كشف الدرجات بنجاح")

    اطبع_سطر("")
    اطبع_سطر("=== اكتمل الاختبار المتوسط 1 ===")
    ارجع 0
نهاية
