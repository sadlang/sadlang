دالة عرض_بطاقة_طالب(نص اسم، رقم رياضيات، رقم عربي، رقم علوم، رقم حاسوب، رقم اسلامية)
    خط_بسيط()
    اطبع("  الطالب: ")
    اطبع_سطر(اسم)
    مسافة()

    عرض_مادة("الرياضيات", رياضيات)
    عرض_مادة("اللغة العربية", عربي)
    عرض_مادة("العلوم الطبيعية", علوم)
    عرض_مادة("الحاسب الآلي", حاسوب)
    عرض_مادة("التربية الإسلامية", اسلامية)

    رقم المجموع = حساب_مجموع(رياضيات، عربي، علوم) + حاسوب + اسلامية
    رقم المعدل = المجموع / 5

    مسافة()
    اطبع("    المجموع الكلي: ")
    اطبع(المجموع)
    اطبع_سطر(" / 500")
    اطبع("    المعدل العام: ")
    اطبع(المعدل)
    اطبع(" - ")
    عرض_تقدير(المعدل)
    اطبع_سطر("")
    خط_بسيط()
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    # --- الترويسة ---
    خط_نجوم()
    اطبع_سطر("  ╔═══════════════════════════════════════════╗")
    اطبع_سطر("  ║  نظام المدرسة الشامل - لغة ص             ║")
    اطبع_سطر("  ║  Arabic Optimizer - اختبار معقد            ║")
    اطبع_سطر("  ║  String Pooling + BiDi + Pattern Match     ║")
    اطبع_سطر("  ╚═══════════════════════════════════════════╝")
    خط_نجوم()

    # ═══ القسم 1: بطاقات الطلاب ═══
    عنوان_قسم("بطاقات الطلاب - كشف الدرجات النهائي")

    عرض_بطاقة_طالب("عبدالله محمد الأحمد"، 95، 90، 85، 100، 95)
    عرض_بطاقة_طالب("نورة سعد العتيبي"، 88، 92، 78، 85، 90)
    عرض_بطاقة_طالب("يوسف خالد الشمري"، 72، 80، 65، 90، 75)
    عرض_بطاقة_طالب("سارة أحمد الدوسري"، 100، 98، 95، 97، 100)

    # ═══ القسم 2: الدول العربية ═══
    عنوان_قسم("الدول العربية وألقابها")

    عرض_لقب_بلد("السعودية")
    عرض_لقب_بلد("مصر")
    عرض_لقب_بلد("الإمارات")
    عرض_لقب_بلد("الأردن")
    عرض_لقب_بلد("العراق")
    عرض_لقب_بلد("سوريا")
    عرض_لقب_بلد("المغرب")
    عرض_لقب_بلد("تونس")

    # ═══ القسم 3: الحكم العربية ═══
    عنوان_قسم("من الحكم والأمثال العربية")

    متغير حكمة_عداد = 1
    بينما (حكمة_عداد <= 10)
        اطبع("  ")
        اطبع(حكمة_عداد)
        اطبع(". ")
        عرض_حكمة(حكمة_عداد)
        حكمة_عداد = حكمة_عداد + 1
    نهاية

    # ═══ القسم 4: العمليات الحسابية المتقدمة ═══
    عنوان_قسم("العمليات الحسابية المتقدمة")

    # المضروب
    عنوان_فرعي("المضروب (Factorial)")
    متغير ي = 1
    بينما (ي <= 8)
        اطبع("    ")
        اطبع(ي)
        اطبع("! = ")
        اطبع_سطر(مضروب(ي))
        ي = ي + 1
    نهاية

    # فيبوناتشي
    عنوان_فرعي("متتالية فيبوناتشي")
    اطبع("    ")
    متغير ف = 0
    بينما (ف <= 10)
        اطبع(فيبوناتشي(ف))
        اطبع(" ")
        ف = ف + 1
    نهاية
    اطبع_سطر("")

    # القوى
    عنوان_فرعي("جدول القوى")
    متغير ق = 1
    بينما (ق <= 5)
        اطبع("    2^")
        اطبع(ق)
        اطبع(" = ")
        اطبع_سطر(قوة(2، ق))
        ق = ق + 1
    نهاية

    # ═══ القسم 5: جدول الضرب ═══
    عنوان_قسم("جدول الضرب")
    متغير جدول = 1
    بينما (جدول <= 5)
        اطبع("    جدول ")
        اطبع(جدول)
        اطبع(": ")
        متغير ض = 1
        بينما (ض <= 10)
            اطبع(جدول * ض)
            اطبع(" ")
            ض = ض + 1
        نهاية
        اطبع_سطر("")
        جدول = جدول + 1
    نهاية

    # ═══ القسم 6: تجميع النصوص (String Pooling) ═══
    عنوان_قسم("اختبار تجميع النصوص العربية المكثف")

    # هذه النصوص المتكررة يجب أن يدمجها المحسّن
    اطبع_سطر("  بسم الله الرحمن الرحيم")
    اطبع_سطر("  الحمد لله رب العالمين")
    اطبع_سطر("  الرحمن الرحيم")
    اطبع_سطر("  بسم الله الرحمن الرحيم")
    اطبع_سطر("  الحمد لله رب العالمين")

    مسافة()
    اطبع_سطر("  لغة ص هي لغة برمجة عربية متكاملة")
    اطبع_سطر("  تدعم التحسين والترجمة والتفسير")
    اطبع_سطر("  لغة ص هي لغة برمجة عربية متكاملة")
    اطبع_سطر("  تدعم التحسين والترجمة والتفسير")

    # ═══ القسم 7: الأعداد ═══
    عنوان_قسم("الأعداد الأولية")
    اطبع("    ")
    # فحص بسيط للأعداد الأولية حتى 50
    متغير عدد = 2
    بينما (عدد <= 50)
        متغير اولي = 1
        متغير قاسم = 2
        بينما (قاسم < عدد)
            إذا (عدد - (عدد / قاسم) * قاسم == 0)
                اولي = 0
            نهاية
            قاسم = قاسم + 1
        نهاية
        إذا (اولي == 1)
            اطبع(عدد)
            اطبع(" ")
        نهاية
        عدد = عدد + 1
    نهاية
    اطبع_سطر("")

    # ═══ الختام ═══
    مسافة()
    خط_نجوم()
    اطبع_سطر("  ╔═══════════════════════════════════════════╗")
    اطبع_سطر("  ║  تم اختبار جميع ميزات المحسّن العربي      ║")
    اطبع_سطر("  ║  ✓ String Pooling - تجميع النصوص          ║")
    اطبع_سطر("  ║  ✓ BiDi Caching - تخزين ثنائي الاتجاه    ║")
    اطبع_سطر("  ║  ✓ Pattern Matching - مطابقة الأنماط      ║")
    اطبع_سطر("  ║  ✓ النصوص العربية الطويلة والمتكررة       ║")
    اطبع_سطر("  ║  ✓ الحسابات والعمليات الرياضية            ║")
    اطبع_سطر("  ║  ✓ الدوال المتعددة والعودية               ║")
    اطبع_سطر("  ╚═══════════════════════════════════════════╝")
    خط_نجوم()
    مسافة()
    اطبع_سطر("=== اكتمل الاختبار المعقد 1 بنجاح ===")
    ارجع 0
نهاية
