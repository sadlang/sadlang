دالة رقم حساب_مجموع(رقم أ، رقم ب، رقم ج)
    ارجع أ + ب + ج
نهاية

دالة رقم حساب_معدل(رقم مجموع، رقم عدد)
    ارجع مجموع / عدد
نهاية

دالة رقم حساب_نسبة(رقم قيمة، رقم اقصى)
    ارجع (قيمة * 100) / اقصى
نهاية

دالة رقم مضروب(رقم ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

دالة رقم فيبوناتشي(رقم ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

دالة رقم قوة(رقم اساس، رقم اس)
    إذا (اس == 0)
        ارجع 1
    نهاية
    ارجع اساس * قوة(اساس، اس - 1)
نهاية

