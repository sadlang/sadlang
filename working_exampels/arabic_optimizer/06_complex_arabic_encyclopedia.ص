دالة رقم القيمة_المطلقة(رقم ن)
    إذا (ن < 0)
        ارجع 0 - ن
    نهاية
    ارجع ن
نهاية

دالة رقم الأكبر(رقم أ، رقم ب)
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة رقم الأصغر(رقم أ، رقم ب)
    إذا (أ < ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة رقم القوة(رقم قاعدة، رقم أُس)
    إذا (أُس == 0)
        ارجع 1
    نهاية
    ارجع قاعدة * القوة(قاعدة، أُس - 1)
نهاية

دالة رقم المضروب(رقم ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * المضروب(ن - 1)
نهاية

دالة رقم فيب(رقم ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيب(ن - 1) + فيب(ن - 2)
نهاية

دالة رقم مجموع_الأرقام(رقم ن)
    إذا (ن < 10)
        ارجع ن
    نهاية
    ارجع (ن - (ن / 10) * 10) + مجموع_الأرقام(ن / 10)
نهاية

دالة رقم عد_أرقام(رقم ن)
    إذا (ن < 10)
        ارجع 1
    نهاية
    ارجع 1 + عد_أرقام(ن / 10)
نهاية

