# ===================================
# الة حاسبة متقدمة بلغة ص
# ===================================

دالة اعرض_القائمة()
    اطبع_سطر("")
    اطبع_سطر("========================================")
    اطبع_سطر("          الة حاسبة متقدمة")
    اطبع_سطر("========================================")
    اطبع_سطر("  1 - جمع (+)")
    اطبع_سطر("  2 - طرح (-)")
    اطبع_سطر("  3 - ضرب (*)")
    اطبع_سطر("  4 - قسمة (/)")
    اطبع_سطر("  5 - باقي القسمة")
    اطبع_سطر("  6 - الاس")
    اطبع_سطر("  0 - خروج")
    اطبع_سطر("========================================")
    اطبع("اختر العملية: ")
نهاية

# --- البرنامج الرئيسي ---
اطبع_سطر("========================================")
اطبع_سطر("  مرحبا بك في الالة الحاسبة!")
اطبع_سطر("========================================")

متغير مستمر = 1

بينما (مستمر == 1)
    اعرض_القائمة()
    متغير اختيار = لرقم(اقرأ())

    اذا (اختيار == 0)
        اطبع_سطر("")
        اطبع_سطر("شكرا لاستخدامك الالة الحاسبة!")
        اطبع_سطر("========================================")
        مستمر = 0
    والا_اذا (اختيار >= 1)
        اطبع("ادخل الرقم الاول: ")
        متغير ر1 = لعشري(اقرأ())
        اطبع("ادخل الرقم الثاني: ")
        متغير ر2 = لعشري(اقرأ())

        اذا (اختيار == 1)
            متغير ناتج = ر1 + ر2
            اطبع_سطر("النتيجة: " + لنص(ر1) + " + " + لنص(ر2) + " = " + لنص(ناتج))
        والا_اذا (اختيار == 2)
            متغير ناتج = ر1 - ر2
            اطبع_سطر("النتيجة: " + لنص(ر1) + " - " + لنص(ر2) + " = " + لنص(ناتج))
        والا_اذا (اختيار == 3)
            متغير ناتج = ر1 * ر2
            اطبع_سطر("النتيجة: " + لنص(ر1) + " * " + لنص(ر2) + " = " + لنص(ناتج))
        والا_اذا (اختيار == 4)
            اذا (ر2 == 0)
                اطبع_سطر("خطأ: لا يمكن القسمة على صفر!")
            والا
                متغير ناتج = ر1 / ر2
                اطبع_سطر("النتيجة: " + لنص(ر1) + " / " + لنص(ر2) + " = " + لنص(ناتج))
            نهاية
        والا_اذا (اختيار == 5)
            اذا (ر2 == 0)
                اطبع_سطر("خطأ: لا يمكن القسمة على صفر!")
            والا
                متغير ن1 = لرقم(لنص(ر1))
                متغير ن2 = لرقم(لنص(ر2))
                متغير ناتج = ن1 % ن2
                اطبع_سطر("النتيجة: " + لنص(ن1) + " % " + لنص(ن2) + " = " + لنص(ناتج))
            نهاية
        والا_اذا (اختيار == 6)
            متغير ن = لرقم(لنص(ر2))
            متغير ناتج = 1
            متغير ع = 0
            بينما (ع < ن)
                ناتج = ناتج * ر1
                ع = ع + 1
            نهاية
            اطبع_سطر("النتيجة: " + لنص(ر1) + " ^ " + لنص(ر2) + " = " + لنص(ناتج))
        والا
            اطبع_سطر("اختيار غير صحيح! اختر من 0 الى 6")
        نهاية
    نهاية
نهاية