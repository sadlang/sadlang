# ==============================================
# المثال 28: نظام إدارة البنك المتقدم
# Advanced Banking Management System
# ==============================================
# يوضح: OOP متقدم + استيراد/تصدير + تفاعل مع المستخدم
# ==============================================

من lib_math_advanced استورد القيمة_المطلقة، الاكبر، الاصغر
من lib_utils استورد اطبع_خط، اطبع_عنوان، اطبع_قائمة_عنصر، اقرأ_اختيار، اطبع_نجاح، اطبع_خطأ، اطبع_معلومة

# ===== صنف الحساب الأساسي =====
صنف حساب
    رقم رقم_ح
    رقم رصيد
    رقم عدد_عمليات
    رقم اجمالي_ايداعات
    رقم اجمالي_سحوبات
    ساكن رقم عداد_حسابات

    باني(رقم رقم_حساب، رقم رصيد_ابتدائي)
        رقم_ح = رقم_حساب
        رصيد = رصيد_ابتدائي
        عدد_عمليات = 0
        اجمالي_ايداعات = 0
        اجمالي_سحوبات = 0
        عداد_حسابات = عداد_حسابات + 1
    نهاية

    دالة رقم الحصول_على_الرصيد()
        ارجع رصيد
    نهاية

    دالة رقم الحصول_على_رقم_الحساب()
        ارجع رقم_ح
    نهاية

    دالة رقم ايداع(رقم مبلغ)
        إذا (مبلغ <= 0)
            اطبع_خطأ("المبلغ يجب أن يكون موجباً")
            ارجع 0
        نهاية
        رصيد = رصيد + مبلغ
        عدد_عمليات = عدد_عمليات + 1
        اجمالي_ايداعات = اجمالي_ايداعات + مبلغ
        ارجع 1
    نهاية

    دالة رقم سحب(رقم مبلغ)
        إذا (مبلغ <= 0)
            ارجع 0
        نهاية
        إذا (مبلغ > رصيد)
            اطبع_خطأ("رصيد غير كاف!")
            ارجع 0
        نهاية
        رصيد = رصيد - مبلغ
        عدد_عمليات = عدد_عمليات + 1
        اجمالي_سحوبات = اجمالي_سحوبات + مبلغ
        ارجع 1
    نهاية

    دالة عرض_معلومات()
        اطبع("    رقم الحساب: ")
        اطبع_سطر(رقم_ح)
        اطبع("    الرصيد: ")
        اطبع_سطر(رصيد)
        اطبع("    عدد العمليات: ")
        اطبع_سطر(عدد_عمليات)
    نهاية

    دالة عرض_ملخص()
        اطبع("  حساب #")
        اطبع(رقم_ح)
        اطبع(" | الرصيد: ")
        اطبع_سطر(رصيد)
    نهاية

    ساكن دالة رقم اجمالي_الحسابات()
        ارجع عداد_حسابات
    نهاية
نهاية

# ===== حساب التوفير =====
صنف حساب_توفير يرث حساب
    رقم نسبة_ربح
    رقم ارباح_متراكمة

    باني(رقم رقم_حساب، رقم رصيد_ابتدائي، رقم نسبة)
        أساس(رقم_حساب، رصيد_ابتدائي)
        نسبة_ربح = نسبة
        ارباح_متراكمة = 0
    نهاية

    دالة رقم احسب_ربح_شهري()
        رقم ربح = رصيد * نسبة_ربح / 1200
        ارباح_متراكمة = ارباح_متراكمة + ربح
        رصيد = رصيد + ربح
        ارجع ربح
    نهاية

    دالة رقم احسب_ربح_سنوي()
        رقم ربح = رصيد * نسبة_ربح / 100
        ارباح_متراكمة = ارباح_متراكمة + ربح
        رصيد = رصيد + ربح
        ارجع ربح
    نهاية

    دالة عرض_تفاصيل_توفير()
        اطبع_سطر("  --- حساب توفير ---")
        عرض_معلومات()
        اطبع("    نسبة الربح: ")
        اطبع(نسبة_ربح)
        اطبع_سطر("%")
        اطبع("    أرباح متراكمة: ")
        اطبع_سطر(ارباح_متراكمة)
    نهاية
نهاية

# ===== حساب الاستثمار =====
صنف حساب_استثمار يرث حساب_توفير
    رقم مستوى_مخاطرة
    رقم ارباح_استثمار
    رقم عدد_استثمارات

    باني(رقم رقم_حساب، رقم رصيد_ابتدائي، رقم نسبة، رقم مخاطرة)
        أساس(رقم_حساب، رصيد_ابتدائي، نسبة)
        مستوى_مخاطرة = مخاطرة
        ارباح_استثمار = 0
        عدد_استثمارات = 0
    نهاية

    دالة رقم استثمر(رقم مبلغ)
        إذا (مبلغ > رصيد)
            ارجع 0
        نهاية
        إذا (مبلغ <= 0)
            ارجع 0
        نهاية
        رقم عائد = مبلغ * نسبة_ربح * مستوى_مخاطرة / 1000
        رصيد = رصيد + عائد
        ارباح_استثمار = ارباح_استثمار + عائد
        عدد_استثمارات = عدد_استثمارات + 1
        ارجع عائد
    نهاية

    دالة عرض_تفاصيل_استثمار()
        اطبع_سطر("  --- حساب استثمار ---")
        عرض_معلومات()
        اطبع("    مستوى المخاطرة: ")
        اطبع_سطر(مستوى_مخاطرة)
        اطبع("    أرباح الاستثمار: ")
        اطبع_سطر(ارباح_استثمار)
        اطبع("    عدد الاستثمارات: ")
        اطبع_سطر(عدد_استثمارات)
    نهاية
نهاية

# ===== حساب جاري =====
صنف حساب_جاري يرث حساب
    رقم حد_سحب_يومي
    رقم مسحوب_اليوم

    باني(رقم رقم_حساب، رقم رصيد_ابتدائي، رقم حد_يومي)
        أساس(رقم_حساب، رصيد_ابتدائي)
        حد_سحب_يومي = حد_يومي
        مسحوب_اليوم = 0
    نهاية

    دالة رقم سحب_جاري(رقم مبلغ)
        إذا (مسحوب_اليوم + مبلغ > حد_سحب_يومي)
            اطبع_خطأ("تجاوزت حد السحب اليومي!")
            ارجع 0
        نهاية
        رقم نتيجة = سحب(مبلغ)
        إذا (نتيجة == 1)
            مسحوب_اليوم = مسحوب_اليوم + مبلغ
        نهاية
        ارجع نتيجة
    نهاية

    دالة عرض_تفاصيل_جاري()
        اطبع_سطر("  --- حساب جاري ---")
        عرض_معلومات()
        اطبع("    حد السحب اليومي: ")
        اطبع_سطر(حد_سحب_يومي)
        اطبع("    مسحوب اليوم: ")
        اطبع_سطر(مسحوب_اليوم)
    نهاية
نهاية

# =============================================
# إنشاء الحسابات
# =============================================
متغير ح_جاري1 = جديد حساب_جاري(1001، 5000، 2000)
متغير ح_جاري2 = جديد حساب_جاري(1002، 10000، 5000)
متغير ح_توفير1 = جديد حساب_توفير(1003، 20000، 5)
متغير ح_توفير2 = جديد حساب_توفير(1004، 50000، 7)
متغير ح_استثمار1 = جديد حساب_استثمار(1005، 100000، 10، 3)
متغير ح_استثمار2 = جديد حساب_استثمار(1006، 200000، 12، 5)

# =============================================
# دوال مساعدة
# =============================================

دالة عرض_كل_الحسابات()
    ح_جاري1.عرض_ملخص()
    ح_جاري2.عرض_ملخص()
    ح_توفير1.عرض_ملخص()
    ح_توفير2.عرض_ملخص()
    ح_استثمار1.عرض_ملخص()
    ح_استثمار2.عرض_ملخص()
نهاية

دالة رقم الحصول_على_رصيد_بالرقم(رقم رقم_ح)
    رقم نت = 0
    إذا (رقم_ح == 1001)
        نت = ح_جاري1.الحصول_على_الرصيد()
    وإلا_إذا (رقم_ح == 1002)
        نت = ح_جاري2.الحصول_على_الرصيد()
    وإلا_إذا (رقم_ح == 1003)
        نت = ح_توفير1.الحصول_على_الرصيد()
    وإلا_إذا (رقم_ح == 1004)
        نت = ح_توفير2.الحصول_على_الرصيد()
    وإلا_إذا (رقم_ح == 1005)
        نت = ح_استثمار1.الحصول_على_الرصيد()
    وإلا_إذا (رقم_ح == 1006)
        نت = ح_استثمار2.الحصول_على_الرصيد()
    نهاية
    ارجع نت
نهاية

دالة رقم ايداع_بالرقم(رقم رقم_ح، رقم مبلغ)
    رقم تم = 0
    إذا (رقم_ح == 1001)
        تم = ح_جاري1.ايداع(مبلغ)
    وإلا_إذا (رقم_ح == 1002)
        تم = ح_جاري2.ايداع(مبلغ)
    وإلا_إذا (رقم_ح == 1003)
        تم = ح_توفير1.ايداع(مبلغ)
    وإلا_إذا (رقم_ح == 1004)
        تم = ح_توفير2.ايداع(مبلغ)
    وإلا_إذا (رقم_ح == 1005)
        تم = ح_استثمار1.ايداع(مبلغ)
    وإلا_إذا (رقم_ح == 1006)
        تم = ح_استثمار2.ايداع(مبلغ)
    نهاية
    ارجع تم
نهاية

دالة رقم سحب_بالرقم(رقم رقم_ح، رقم مبلغ)
    رقم تم = 0
    إذا (رقم_ح == 1001)
        تم = ح_جاري1.سحب_جاري(مبلغ)
    وإلا_إذا (رقم_ح == 1002)
        تم = ح_جاري2.سحب_جاري(مبلغ)
    وإلا_إذا (رقم_ح == 1003)
        تم = ح_توفير1.سحب(مبلغ)
    وإلا_إذا (رقم_ح == 1004)
        تم = ح_توفير2.سحب(مبلغ)
    وإلا_إذا (رقم_ح == 1005)
        تم = ح_استثمار1.سحب(مبلغ)
    وإلا_إذا (رقم_ح == 1006)
        تم = ح_استثمار2.سحب(مبلغ)
    نهاية
    ارجع تم
نهاية

# =============================================
# دوال العمليات
# =============================================

دالة عملية_ايداع()
    اطبع_عنوان("عملية إيداع")
    عرض_كل_الحسابات()
    اطبع("  رقم الحساب: ")
    رقم رقم_ح = لرقم(اقرأ())
    اطبع("  مبلغ الإيداع: ")
    رقم مبلغ = لرقم(اقرأ())
    رقم تم = ايداع_بالرقم(رقم_ح، مبلغ)
    إذا (تم == 1)
        اطبع_نجاح("تم الإيداع بنجاح!")
    نهاية
نهاية

دالة عملية_سحب()
    اطبع_عنوان("عملية سحب")
    عرض_كل_الحسابات()
    اطبع("  رقم الحساب: ")
    رقم رقم_ح = لرقم(اقرأ())
    اطبع("  مبلغ السحب: ")
    رقم مبلغ = لرقم(اقرأ())
    رقم تم = سحب_بالرقم(رقم_ح، مبلغ)
    إذا (تم == 1)
        اطبع_نجاح("تم السحب بنجاح!")
    نهاية
نهاية

دالة عملية_تحويل()
    اطبع_عنوان("تحويل بين حسابات")
    عرض_كل_الحسابات()
    اطبع("  من حساب: ")
    رقم من_ح = لرقم(اقرأ())
    اطبع("  إلى حساب: ")
    رقم الى_ح = لرقم(اقرأ())
    اطبع("  المبلغ: ")
    رقم مبلغ = لرقم(اقرأ())
    رقم تم_سحب = سحب_بالرقم(من_ح، مبلغ)
    إذا (تم_سحب == 1)
        رقم تم_ايداع = ايداع_بالرقم(الى_ح، مبلغ)
        إذا (تم_ايداع == 1)
            اطبع_نجاح("تم التحويل بنجاح!")
        وإلا
            ايداع_بالرقم(من_ح، مبلغ)
            اطبع_خطأ("فشل - تم إعادة المبلغ")
        نهاية
    وإلا
        اطبع_خطأ("فشل التحويل")
    نهاية
نهاية

دالة عرض_تفاصيل()
    اطبع_عنوان("تفاصيل حساب")
    اطبع("  رقم الحساب: ")
    رقم رقم_ح = لرقم(اقرأ())
    إذا (رقم_ح == 1001)
        ح_جاري1.عرض_تفاصيل_جاري()
    وإلا_إذا (رقم_ح == 1002)
        ح_جاري2.عرض_تفاصيل_جاري()
    وإلا_إذا (رقم_ح == 1003)
        ح_توفير1.عرض_تفاصيل_توفير()
    وإلا_إذا (رقم_ح == 1004)
        ح_توفير2.عرض_تفاصيل_توفير()
    وإلا_إذا (رقم_ح == 1005)
        ح_استثمار1.عرض_تفاصيل_استثمار()
    وإلا_إذا (رقم_ح == 1006)
        ح_استثمار2.عرض_تفاصيل_استثمار()
    وإلا
        اطبع_خطأ("رقم حساب غير صحيح")
    نهاية
نهاية

دالة حساب_ارباح()
    اطبع_عنوان("حساب الأرباح")
    اطبع_سطر("  [1003] توفير 1 | [1004] توفير 2")
    اطبع_سطر("  [1005] استثمار 1 | [1006] استثمار 2")
    اطبع("  رقم الحساب: ")
    رقم رقم_ح = لرقم(اقرأ())
    اطبع_سطر("  [1] شهري  [2] سنوي")
    رقم اختيار_ربح = اقرأ_اختيار(1، 2)

    رقم ربح_محسوب = 0
    إذا (رقم_ح == 1003)
        إذا (اختيار_ربح == 1)
            ربح_محسوب = ح_توفير1.احسب_ربح_شهري()
        وإلا
            ربح_محسوب = ح_توفير1.احسب_ربح_سنوي()
        نهاية
    وإلا_إذا (رقم_ح == 1004)
        إذا (اختيار_ربح == 1)
            ربح_محسوب = ح_توفير2.احسب_ربح_شهري()
        وإلا
            ربح_محسوب = ح_توفير2.احسب_ربح_سنوي()
        نهاية
    وإلا_إذا (رقم_ح == 1005)
        إذا (اختيار_ربح == 1)
            ربح_محسوب = ح_استثمار1.احسب_ربح_شهري()
        وإلا
            ربح_محسوب = ح_استثمار1.احسب_ربح_سنوي()
        نهاية
    وإلا_إذا (رقم_ح == 1006)
        إذا (اختيار_ربح == 1)
            ربح_محسوب = ح_استثمار2.احسب_ربح_شهري()
        وإلا
            ربح_محسوب = ح_استثمار2.احسب_ربح_سنوي()
        نهاية
    نهاية
    اطبع("  الربح: ")
    اطبع_سطر(ربح_محسوب)
نهاية

دالة تنفيذ_استثمار()
    اطبع_عنوان("تنفيذ استثمار")
    اطبع_سطر("  [1005] استثمار 1 | [1006] استثمار 2")
    اطبع("  رقم الحساب: ")
    رقم رقم_ح = لرقم(اقرأ())
    اطبع("  مبلغ الاستثمار: ")
    رقم مبلغ = لرقم(اقرأ())
    رقم عائد_ناتج = 0
    إذا (رقم_ح == 1005)
        عائد_ناتج = ح_استثمار1.استثمر(مبلغ)
    وإلا_إذا (رقم_ح == 1006)
        عائد_ناتج = ح_استثمار2.استثمر(مبلغ)
    نهاية
    إذا (عائد_ناتج > 0)
        اطبع_نجاح("تم الاستثمار!")
        اطبع("  العائد: ")
        اطبع_سطر(عائد_ناتج)
    نهاية
نهاية

دالة تقرير_شامل()
    اطبع_عنوان("التقرير الشامل")
    اطبع_سطر("  === جاري ===")
    ح_جاري1.عرض_تفاصيل_جاري()
    ح_جاري2.عرض_تفاصيل_جاري()
    اطبع_سطر("  === توفير ===")
    ح_توفير1.عرض_تفاصيل_توفير()
    ح_توفير2.عرض_تفاصيل_توفير()
    اطبع_سطر("  === استثمار ===")
    ح_استثمار1.عرض_تفاصيل_استثمار()
    ح_استثمار2.عرض_تفاصيل_استثمار()
نهاية

دالة احصائيات()
    اطبع_عنوان("إحصائيات البنك")
    رقم ر1 = ح_جاري1.الحصول_على_الرصيد()
    رقم ر2 = ح_جاري2.الحصول_على_الرصيد()
    رقم ر3 = ح_توفير1.الحصول_على_الرصيد()
    رقم ر4 = ح_توفير2.الحصول_على_الرصيد()
    رقم ر5 = ح_استثمار1.الحصول_على_الرصيد()
    رقم ر6 = ح_استثمار2.الحصول_على_الرصيد()
    رقم مج = ر1 + ر2 + ر3 + ر4 + ر5 + ر6
    اطبع("  عدد الحسابات: ")
    اطبع_سطر(حساب.اجمالي_الحسابات())
    اطبع("  إجمالي الأرصدة: ")
    اطبع_سطر(مج)
    رقم اكبر = الاكبر(الاكبر(الاكبر(ر1، ر2)، الاكبر(ر3، ر4))، الاكبر(ر5، ر6))
    رقم اصغر = الاصغر(الاصغر(الاصغر(ر1، ر2)، الاصغر(ر3، ر4))، الاصغر(ر5، ر6))
    اطبع("  أكبر رصيد: ")
    اطبع_سطر(اكبر)
    اطبع("  أصغر رصيد: ")
    اطبع_سطر(اصغر)
    اطبع("  المتوسط: ")
    اطبع_سطر(مج / 6)
نهاية

دالة مقارنة()
    اطبع_عنوان("مقارنة حسابين")
    اطبع("  الحساب الأول: ")
    رقم ح1 = لرقم(اقرأ())
    اطبع("  الحساب الثاني: ")
    رقم ح2 = لرقم(اقرأ())
    رقم ر1 = الحصول_على_رصيد_بالرقم(ح1)
    رقم ر2 = الحصول_على_رصيد_بالرقم(ح2)
    اطبع("  رصيد ")
    اطبع(ح1)
    اطبع(": ")
    اطبع_سطر(ر1)
    اطبع("  رصيد ")
    اطبع(ح2)
    اطبع(": ")
    اطبع_سطر(ر2)
    رقم فرق = القيمة_المطلقة(ر1 - ر2)
    اطبع("  الفرق: ")
    اطبع_سطر(فرق)
نهاية

دالة حاسبة_ارباح()
    اطبع_عنوان("حاسبة الأرباح المستقبلية")
    اطبع("  المبلغ الأولي: ")
    رقم مبلغ_اولي = لرقم(اقرأ())
    اطبع("  نسبة الربح (%): ")
    رقم نسبة = لرقم(اقرأ())
    اطبع("  عدد السنوات: ")
    رقم سنوات = لرقم(اقرأ())
    رقم رصيد_حالي = مبلغ_اولي
