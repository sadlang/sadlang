# =============================================================
# مثال بسيط 2: محاكاة صنف حساب بنكي
# =============================================================
# الهدف: محاكاة OOP مع عمليات على كائن (إيداع، سحب)
# المستوى: بسيط
# الميزة: OOP Sugar - صنف (Phase 17)
# =============================================================

# ═══════════════════════════════════════════════════════
# دوال مساعدة
# ═══════════════════════════════════════════════════════

دالة خط()
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
نهاية

دالة عنوان(نص نص_عنوان)
    اطبع_سطر("")
    خط()
    اطبع("  🏦 ")
    اطبع_سطر(نص_عنوان)
    خط()
نهاية

# ═══════════════════════════════════════════════════════
# القسم 1: بيانات الحسابات (محاكاة كائنات)
# ═══════════════════════════════════════════════════════
# محاكاة 4 حسابات بنكية

دالة نص حساب_مالك(رقم معرف)
    متغير نتيجة = "غير معروف"
    طابق معرف
        حالة 1: نتيجة = "سعيد المهندس"
        حالة 2: نتيجة = "ليلى الطبيبة"
        حالة 3: نتيجة = "عمر التاجر"
        حالة 4: نتيجة = "هند المعلمة"
    نهاية
    ارجع نتيجة
نهاية

دالة رقم رصيد_ابتدائي(رقم معرف)
    متغير رصيد = 0
    طابق معرف
        حالة 1: رصيد = 5000
        حالة 2: رصيد = 12000
        حالة 3: رصيد = 50000
        حالة 4: رصيد = 3000
    نهاية
    ارجع رصيد
نهاية

دالة نص نوع_حساب(رقم معرف)
    متغير نتيجة = "عادي"
    طابق معرف
        حالة 1: نتيجة = "جاري"
        حالة 2: نتيجة = "توفير"
        حالة 3: نتيجة = "تجاري"
        حالة 4: نتيجة = "طالب"
    نهاية
    ارجع نتيجة
نهاية

# ═══════════════════════════════════════════════════════
# القسم 2: عمليات الحساب (Methods)
# ═══════════════════════════════════════════════════════

دالة رقم ايداع(رقم رصيد، رقم مبلغ)
    ارجع رصيد + مبلغ
نهاية

دالة رقم سحب(رقم رصيد، رقم مبلغ)
    إذا (مبلغ > رصيد)
        اطبع_سطر("    ⚠️ رصيد غير كاف!")
        ارجع رصيد
    نهاية
    ارجع رصيد - مبلغ
نهاية

دالة رقم حساب_فائدة(رقم رصيد، رقم نسبة)
    # نسبة مئوية كرقم صحيح (مثلاً 5 = 5%)
    ارجع رصيد * نسبة / 100
نهاية

دالة عرض_حساب(رقم معرف، رقم رصيد)
    اطبع("    👤 المالك: ")
    اطبع_سطر(حساب_مالك(معرف))
    اطبع("    📋 النوع: ")
    اطبع_سطر(نوع_حساب(معرف))
    اطبع("    💰 الرصيد: ")
    اطبع(رصيد)
    اطبع_سطر(" ريال")
نهاية

# ═══════════════════════════════════════════════════════
# القسم 3: سيناريو العمليات
# ═══════════════════════════════════════════════════════

دالة سيناريو_عمليات()
    عنوان("سيناريو العمليات البنكية")
    
    # حساب سعيد
    متغير رصيد_سعيد = رصيد_ابتدائي(1)
    اطبع_سطر("  📌 حساب سعيد المهندس:")
    عرض_حساب(1, رصيد_سعيد)
    
    اطبع_سطر("")
    اطبع_سطر("    → إيداع 2000 ريال")
    رصيد_سعيد = ايداع(رصيد_سعيد, 2000)
    اطبع("    💰 الرصيد الجديد: ")
    اطبع(رصيد_سعيد)
    اطبع_سطر(" ريال")
    
    اطبع_سطر("    → سحب 1500 ريال")
    رصيد_سعيد = سحب(رصيد_سعيد, 1500)
    اطبع("    💰 الرصيد الجديد: ")
    اطبع(رصيد_سعيد)
    اطبع_سطر(" ريال")
    
    # حساب ليلى
    اطبع_سطر("")
    اطبع_سطر("  📌 حساب ليلى الطبيبة:")
    متغير رصيد_ليلى = رصيد_ابتدائي(2)
    عرض_حساب(2, رصيد_ليلى)
    
    رقم فائدة = حساب_فائدة(رصيد_ليلى, 5)
    اطبع("    📈 فائدة 5%: +")
    اطبع(فائدة)
    اطبع_سطر(" ريال")
    رصيد_ليلى = ايداع(رصيد_ليلى, فائدة)
    اطبع("    💰 بعد الفائدة: ")
    اطبع(رصيد_ليلى)
    اطبع_سطر(" ريال")
    
    # محاولة سحب أكثر من الرصيد
    اطبع_سطر("")
    اطبع_سطر("  📌 محاولة سحب زائد:")
    متغير رصيد_هند = رصيد_ابتدائي(4)
    اطبع("    الرصيد الحالي: ")
    اطبع(رصيد_هند)
    اطبع_سطر(" ريال")
    اطبع_سطر("    → محاولة سحب 5000 ريال:")
    رصيد_هند = سحب(رصيد_هند, 5000)
نهاية

# ═══════════════════════════════════════════════════════
# القسم 4: تقرير الحسابات
# ═══════════════════════════════════════════════════════

دالة تقرير_اجمالي()
    عنوان("تقرير الحسابات الإجمالي")
    
    متغير مجموع = 0
    متغير ع = 1
    بينما (ع <= 4)
        رقم رصيد_حالي = رصيد_ابتدائي(ع)
        اطبع("    ")
        اطبع(حساب_مالك(ع))
        اطبع(": ")
        اطبع(رصيد_حالي)
        اطبع_سطر(" ريال")
        مجموع = مجموع + رصيد_حالي
        ع = ع + 1
    نهاية
    
    اطبع_سطر("")
    اطبع("    📊 إجمالي الأرصدة: ")
    اطبع(مجموع)
    اطبع_سطر(" ريال")
    اطبع("    📊 متوسط الرصيد: ")
    اطبع(مجموع / 4)
    اطبع_سطر(" ريال")
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  🏦 محاكاة OOP - صنف حساب بنكي     ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    
    سيناريو_عمليات()
    تقرير_اجمالي()
    
    اطبع_سطر("")
    خط()
    اطبع_سطر("  ✅ تمت محاكاة صنف حساب بنكي بنجاح")
    خط()
    ارجع 0
نهاية
