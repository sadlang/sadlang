# ═══════════════════════════════════════════════════════
# صنف الطالب
# ═══════════════════════════════════════════════════════

صنف طالب
    عام
        نص الاسم
        رقم رقم_الطالب
        رقم درجة_الرياضيات
        رقم درجة_العلوم
        رقم درجة_اللغة
        رقم درجة_التاريخ
        رقم عدد_الغياب

        باني(نص اسم، رقم رقم_ط)
            الاسم = اسم
            رقم_الطالب = رقم_ط
            درجة_الرياضيات = 0
            درجة_العلوم = 0
            درجة_اللغة = 0
            درجة_التاريخ = 0
            عدد_الغياب = 0
        نهاية

        دالة تسجيل_درجات(رقم رياضيات، رقم علوم، رقم لغة، رقم تاريخ)
            درجة_الرياضيات = رياضيات
            درجة_العلوم = علوم
            درجة_اللغة = لغة
            درجة_التاريخ = تاريخ
        نهاية

        دالة رقم المعدل()
            ارجع (درجة_الرياضيات + درجة_العلوم + درجة_اللغة + درجة_التاريخ) / 4
        نهاية

        دالة نص التقدير()
            متغير معدل = (درجة_الرياضيات + درجة_العلوم + درجة_اللغة + درجة_التاريخ) / 4
            اذا (معدل >= 90)
                ارجع "ممتاز 🌟"
            نهاية
            اذا (معدل >= 80)
                ارجع "جيد جداً ✨"
            نهاية
            اذا (معدل >= 70)
                ارجع "جيد 👍"
            نهاية
            اذا (معدل >= 60)
                ارجع "مقبول ⚠️"
            نهاية
            ارجع "راسب ❌"
        نهاية

        دالة رقم ناجح()
            متغير معدل = (درجة_الرياضيات + درجة_العلوم + درجة_اللغة + درجة_التاريخ) / 4
            اذا (معدل >= 60)
                ارجع 1
            نهاية
            ارجع 0
        نهاية

        دالة رقم أعلى_درجة()
            متغير أعلى = درجة_الرياضيات
            اذا (درجة_العلوم > أعلى)
                أعلى = درجة_العلوم
            نهاية
            اذا (درجة_اللغة > أعلى)
                أعلى = درجة_اللغة
            نهاية
            اذا (درجة_التاريخ > أعلى)
                أعلى = درجة_التاريخ
            نهاية
            ارجع أعلى
        نهاية

        دالة رقم أدنى_درجة()
            متغير أدنى = درجة_الرياضيات
            اذا (درجة_العلوم < أدنى)
                أدنى = درجة_العلوم
            نهاية
            اذا (درجة_اللغة < أدنى)
                أدنى = درجة_اللغة
            نهاية
            اذا (درجة_التاريخ < أدنى)
                أدنى = درجة_التاريخ
            نهاية
            ارجع أدنى
        نهاية

        دالة تسجيل_غياب(رقم أيام)
            عدد_الغياب = عدد_الغياب + أيام
        نهاية

        دالة رقم منذر()
            اذا (عدد_الغياب > 10)
                ارجع 1
            نهاية
            ارجع 0
        نهاية

        دالة عرض_بطاقة()
            اطبع("    ┌──────────────────────────────┐")
            اطبع_سطر("")
            اطبع("    │ 🎓 ")
            اطبع(الاسم)
            اطبع(" (#")
            اطبع(رقم_الطالب)
            اطبع_سطر(")")
            اطبع("    │ رياضيات: ")
            اطبع(درجة_الرياضيات)
            اطبع(" | علوم: ")
            اطبع(درجة_العلوم)
            اطبع(" | لغة: ")
            اطبع(درجة_اللغة)
            اطبع(" | تاريخ: ")
            اطبع_سطر(درجة_التاريخ)
            اطبع("    │ المعدل: ")
            متغير م = (درجة_الرياضيات + درجة_العلوم + درجة_اللغة + درجة_التاريخ) / 4
            اطبع(م)
            اطبع(" | التقدير: ")
            اذا (م >= 90)
                اطبع("ممتاز")
            والا
                اذا (م >= 80)
                    اطبع("جيد جداً")
                والا
                    اذا (م >= 70)
                        اطبع("جيد")
                    والا
                        اذا (م >= 60)
                            اطبع("مقبول")
                        والا
                            اطبع("راسب")
                        نهاية
                    نهاية
                نهاية
            نهاية
            اطبع(" | غياب: ")
            اطبع_سطر(عدد_الغياب)
            اطبع_سطر("    └──────────────────────────────┘")
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف المادة الدراسية
# ═══════════════════════════════════════════════════════

صنف مادة
    عام
        نص اسم_المادة
        رقم مجموع_الدرجات
        رقم عدد_الطلاب
        رقم أعلى_درجة
        رقم أدنى_درجة

        باني(نص اسم)
            اسم_المادة = اسم
            مجموع_الدرجات = 0
            عدد_الطلاب = 0
            أعلى_درجة = 0
            أدنى_درجة = 100
        نهاية

        دالة إضافة_درجة(رقم درجة)
            مجموع_الدرجات = مجموع_الدرجات + درجة
            عدد_الطلاب = عدد_الطلاب + 1
            اذا (درجة > أعلى_درجة)
                أعلى_درجة = درجة
            نهاية
            اذا (درجة < أدنى_درجة)
                أدنى_درجة = درجة
            نهاية
        نهاية

        دالة رقم المتوسط()
            اذا (عدد_الطلاب == 0)
                ارجع 0
            نهاية
            ارجع مجموع_الدرجات / عدد_الطلاب
        نهاية

        دالة عرض_تقرير()
            اطبع("    📊 ")
            اطبع(اسم_المادة)
            اطبع(": متوسط=")
            اذا (عدد_الطلاب > 0)
                اطبع(مجموع_الدرجات / عدد_الطلاب)
            والا
                اطبع(0)
            نهاية
            اطبع(" أعلى=")
            اطبع(أعلى_درجة)
            اطبع(" أدنى=")
            اطبع(أدنى_درجة)
            اطبع(" (")
            اطبع(عدد_الطلاب)
            اطبع_سطر(" طلاب)")
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف تقرير الفصل
# ═══════════════════════════════════════════════════════

صنف تقرير_فصل
    عام
        رقم عدد_الناجحين
        رقم عدد_الراسبين
        رقم عدد_المتفوقين
        رقم عدد_المنذرين
        رقم إجمالي_الطلاب

        باني()
            عدد_الناجحين = 0
            عدد_الراسبين = 0
            عدد_المتفوقين = 0
            عدد_المنذرين = 0
            إجمالي_الطلاب = 0
        نهاية

        دالة إضافة_طالب(رقم ناجح، رقم متفوق، رقم منذر)
            إجمالي_الطلاب = إجمالي_الطلاب + 1
            اذا (ناجح == 1)
                عدد_الناجحين = عدد_الناجحين + 1
            والا
                عدد_الراسبين = عدد_الراسبين + 1
            نهاية
            اذا (متفوق == 1)
                عدد_المتفوقين = عدد_المتفوقين + 1
            نهاية
            اذا (منذر == 1)
                عدد_المنذرين = عدد_المنذرين + 1
            نهاية
        نهاية

        دالة عرض()
            اطبع_سطر("    ╔══════════════════════════════╗")
            اطبع_سطر("    ║     📋 تقرير الفصل           ║")
            اطبع_سطر("    ╠══════════════════════════════╣")
            اطبع("    ║  إجمالي الطلاب:   ")
            اطبع_سطر(إجمالي_الطلاب)
            اطبع("    ║  الناجحون:         ")
            اطبع_سطر(عدد_الناجحين)
            اطبع("    ║  الراسبون:         ")
            اطبع_سطر(عدد_الراسبين)
            اطبع("    ║  المتفوقون (90+):  ")
            اطبع_سطر(عدد_المتفوقين)
            اطبع("    ║  المنذرون (غياب):  ")
            اطبع_سطر(عدد_المنذرين)
            اذا (إجمالي_الطلاب > 0)
                اطبع("    ║  نسبة النجاح:     ")
                اطبع(عدد_الناجحين * 100 / إجمالي_الطلاب)
                اطبع_سطر("%")
            نهاية
            اطبع_سطر("    ╚══════════════════════════════╝")
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  🏫 Phase 17: نظام إدارة مدرسة       ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    # إنشاء الطلاب
    اطبع_سطر("━━━ تسجيل الطلاب والدرجات ━━━")
    متغير ط1 = جديد طالب("أحمد"، 101)
    متغير ط2 = جديد طالب("فاطمة"، 102)
    متغير ط3 = جديد طالب("خالد"، 103)
    متغير ط4 = جديد طالب("مريم"، 104)
    متغير ط5 = جديد طالب("عمر"، 105)

    # تسجيل الدرجات
    ط1.تسجيل_درجات(95، 88، 92، 85)
    ط2.تسجيل_درجات(78، 91، 85، 88)
    ط3.تسجيل_درجات(55، 62، 48، 70)
    ط4.تسجيل_درجات(92، 95، 98، 94)
    ط5.تسجيل_درجات(40، 35، 55، 42)

    # تسجيل الغياب
    ط1.تسجيل_غياب(3)
    ط2.تسجيل_غياب(5)
    ط3.تسجيل_غياب(15)
    ط4.تسجيل_غياب(1)
    ط5.تسجيل_غياب(20)

    # عرض بطاقات الطلاب
    اطبع_سطر("")
    اطبع_سطر("━━━ بطاقات الطلاب ━━━")
    ط1.عرض_بطاقة()
    ط2.عرض_بطاقة()
    ط3.عرض_بطاقة()
    ط4.عرض_بطاقة()
    ط5.عرض_بطاقة()

    # إحصائيات المواد
    اطبع_سطر("━━━ إحصائيات المواد ━━━")
    متغير م_رياضيات = جديد مادة("الرياضيات")
    متغير م_علوم = جديد مادة("العلوم")
    متغير م_لغة = جديد مادة("اللغة العربية")
    متغير م_تاريخ = جديد مادة("التاريخ")

    م_رياضيات.إضافة_درجة(95)
    م_رياضيات.إضافة_درجة(78)
    م_رياضيات.إضافة_درجة(55)
    م_رياضيات.إضافة_درجة(92)
    م_رياضيات.إضافة_درجة(40)

    م_علوم.إضافة_درجة(88)
    م_علوم.إضافة_درجة(91)
    م_علوم.إضافة_درجة(62)
    م_علوم.إضافة_درجة(95)
    م_علوم.إضافة_درجة(35)

    م_لغة.إضافة_درجة(92)
    م_لغة.إضافة_درجة(85)
    م_لغة.إضافة_درجة(48)
    م_لغة.إضافة_درجة(98)
    م_لغة.إضافة_درجة(55)

    م_تاريخ.إضافة_درجة(85)
    م_تاريخ.إضافة_درجة(88)
    م_تاريخ.إضافة_درجة(70)
    م_تاريخ.إضافة_درجة(94)
    م_تاريخ.إضافة_درجة(42)

    م_رياضيات.عرض_تقرير()
    م_علوم.عرض_تقرير()
    م_لغة.عرض_تقرير()
    م_تاريخ.عرض_تقرير()

    # تقرير الفصل
    اطبع_سطر("")
    اطبع_سطر("━━━ تقرير الفصل ━━━")
    متغير تقرير = جديد تقرير_فصل()
    
    # أحمد: معدل 90، ناجح، متفوق، غير منذر
    متغير متفوق1 = 0
    اذا (ط1.المعدل() >= 90)
        متفوق1 = 1
    نهاية
    تقرير.إضافة_طالب(ط1.ناجح()، متفوق1، ط1.منذر())

    # فاطمة: معدل 85، ناجحة، غير متفوقة
    متغير متفوق2 = 0
    اذا (ط2.المعدل() >= 90)
        متفوق2 = 1
    نهاية
    تقرير.إضافة_طالب(ط2.ناجح()، متفوق2، ط2.منذر())

    # خالد: معدل 58، راسب
    متغير متفوق3 = 0
    تقرير.إضافة_طالب(ط3.ناجح()، متفوق3، ط3.منذر())

    # مريم: معدل 94، متفوقة
    متغير متفوق4 = 0
    اذا (ط4.المعدل() >= 90)
        متفوق4 = 1
    نهاية
    تقرير.إضافة_طالب(ط4.ناجح()، متفوق4، ط4.منذر())

    # عمر: معدل 43، راسب، منذر
    متغير متفوق5 = 0
    تقرير.إضافة_طالب(ط5.ناجح()، متفوق5، ط5.منذر())

    تقرير.عرض()

    # أعلى وأدنى درجات
    اطبع_سطر("━━━ أعلى وأدنى درجات ━━━")
    اطبع("    أحمد: أعلى=")
    اطبع(ط1.أعلى_درجة())
    اطبع(" أدنى=")
    اطبع_سطر(ط1.أدنى_درجة())
    اطبع("    مريم: أعلى=")
    اطبع(ط4.أعلى_درجة())
    اطبع(" أدنى=")
    اطبع_سطر(ط4.أدنى_درجة())

    اطبع_سطر("")
    اطبع_سطر("✅ تم اختبار نظام المدرسة بنجاح")

    ارجع 0
نهاية
