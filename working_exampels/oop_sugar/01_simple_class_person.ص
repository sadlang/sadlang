# ═══════════════════════════════════════════════════════
# تعريف صنف شخص
# ═══════════════════════════════════════════════════════

صنف شخص
    عام
        نص الاسم
        رقم العمر
        نص المهنة

        باني(نص اسم، رقم عمر، نص مهنة)
            الاسم = اسم
            العمر = عمر
            المهنة = مهنة
        نهاية

        دالة عرض()
            اطبع("    👤 ")
            اطبع(الاسم)
            اطبع(" | العمر: ")
            اطبع(العمر)
            اطبع(" | المهنة: ")
            اطبع_سطر(المهنة)
        نهاية

        دالة رقم بالغ()
            إذا (العمر >= 18)
                ارجع 1
            نهاية
            ارجع 0
        نهاية

        دالة نص الفئة_العمرية()
            إذا (العمر < 13)
                ارجع "طفل"
            نهاية
            إذا (العمر < 18)
                ارجع "مراهق"
            نهاية
            إذا (العمر < 30)
                ارجع "شاب"
            نهاية
            إذا (العمر < 50)
                ارجع "كهل"
            نهاية
            ارجع "مسن"
        نهاية

        دالة رقم سنوات_تقاعد()
            إذا (العمر >= 60)
                ارجع 0
            نهاية
            ارجع 60 - العمر
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف فريق عمل
# ═══════════════════════════════════════════════════════

صنف فريق
    عام
        نص اسم_الفريق
        رقم عدد_الاعضاء

        باني(نص اسم)
            اسم_الفريق = اسم
            عدد_الاعضاء = 0
        نهاية

        دالة اضافة()
            عدد_الاعضاء = عدد_الاعضاء + 1
        نهاية

        دالة عرض_معلومات()
            اطبع("    🏢 فريق: ")
            اطبع(اسم_الفريق)
            اطبع(" | الأعضاء: ")
            اطبع_سطر(عدد_الاعضاء)
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  🏗️ Phase 17: صنف شخص وفريق         ║")
    اطبع_سطر("╚══════════════════════════════════════╝")

    # إنشاء أشخاص
    اطبع_سطر("")
    اطبع_سطر("━━━ إنشاء الأشخاص ━━━")

    متغير ش1 = جديد شخص("أحمد"، 28، "مهندس")
    متغير ش2 = جديد شخص("فاطمة"، 35، "طبيبة")
    متغير ش3 = جديد شخص("خالد"، 12، "طالب")
    متغير ش4 = جديد شخص("مريم"، 45، "أستاذة")
    متغير ش5 = جديد شخص("عمر"، 62، "متقاعد")

    ش1.عرض()
    ش2.عرض()
    ش3.عرض()
    ش4.عرض()
    ش5.عرض()

    # فحص الفئات العمرية
    اطبع_سطر("")
    اطبع_سطر("━━━ الفئات العمرية ━━━")

    اطبع("    أحمد: ")
    اطبع_سطر(ش1.الفئة_العمرية())
    اطبع("    فاطمة: ")
    اطبع_سطر(ش2.الفئة_العمرية())
    اطبع("    خالد: ")
    اطبع_سطر(ش3.الفئة_العمرية())
    اطبع("    مريم: ")
    اطبع_سطر(ش4.الفئة_العمرية())
    اطبع("    عمر: ")
    اطبع_سطر(ش5.الفئة_العمرية())

    # فحص البلوغ
    اطبع_سطر("")
    اطبع_سطر("━━━ فحص البلوغ ━━━")
    اطبع("    أحمد بالغ: ")
    إذا (ش1.بالغ() == 1)
        اطبع_سطر("نعم ✅")
    وإلا
        اطبع_سطر("لا ❌")
    نهاية
    اطبع("    خالد بالغ: ")
    إذا (ش3.بالغ() == 1)
        اطبع_سطر("نعم ✅")
    وإلا
        اطبع_سطر("لا ❌")
    نهاية

    # سنوات التقاعد
    اطبع_سطر("")
    اطبع_سطر("━━━ سنوات التقاعد ━━━")
    اطبع("    أحمد: ")
    اطبع(ش1.سنوات_تقاعد())
    اطبع_سطر(" سنة")
    اطبع("    عمر: ")
    اطبع(ش5.سنوات_تقاعد())
    اطبع_سطر(" سنة (متقاعد بالفعل)")

    # إنشاء فريق
    اطبع_سطر("")
    اطبع_سطر("━━━ فريق العمل ━━━")
    متغير ف = جديد فريق("التطوير")
    ف.اضافة()
    ف.اضافة()
    ف.اضافة()
    ف.عرض_معلومات()

    اطبع_سطر("")
    اطبع_سطر("✅ تم اختبار صنف/باني/جديد بنجاح")
    ارجع 0
نهاية
