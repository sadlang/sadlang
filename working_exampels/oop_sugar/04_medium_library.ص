# =============================================================
# مثال متوسط 4: نظام مكتبة كتب
# =============================================================
# الهدف: أصناف متعددة مع تفاعل بينها
# المستوى: متوسط
# الميزة: OOP Sugar - صنف/باني/جديد (Phase 17)
# =============================================================

# ═══════════════════════════════════════════════════════
# صنف كتاب
# ═══════════════════════════════════════════════════════

صنف كتاب
    عام
        نص العنوان
        نص المؤلف
        رقم السعر
        رقم عدد_الصفحات
        رقم متاح

        باني(نص عنوان، نص مؤلف، رقم سعر، رقم صفحات)
            العنوان = عنوان
            المؤلف = مؤلف
            السعر = سعر
            عدد_الصفحات = صفحات
            متاح = 1
        نهاية

        دالة عرض()
            اطبع("    📖 ")
            اطبع(العنوان)
            اطبع(" - ")
            اطبع(المؤلف)
            اطبع(" (")
            اطبع(عدد_الصفحات)
            اطبع(" ص) 💰")
            اطبع(السعر)
            اذا (متاح == 1)
                اطبع_سطر(" [متاح ✅]")
            والا
                اطبع_سطر(" [مُعار ❌]")
            نهاية
        نهاية

        دالة رقم استعارة()
            اذا (متاح == 1)
                متاح = 0
                اطبع("    ✅ تمت استعارة: ")
                اطبع_سطر(العنوان)
                ارجع 1
            نهاية
            اطبع("    ❌ الكتاب غير متاح: ")
            اطبع_سطر(العنوان)
            ارجع 0
        نهاية

        دالة رد_كتاب()
            اذا (متاح == 0)
                متاح = 1
                اطبع("    ✅ تم إرجاع: ")
                اطبع_سطر(العنوان)
            والا
                اطبع("    ⚠️ الكتاب ليس مُعاراً: ")
                اطبع_سطر(العنوان)
            نهاية
        نهاية

        دالة نص تصنيف_الحجم()
            اذا (عدد_الصفحات < 100)
                ارجع "كتيب"
            نهاية
            اذا (عدد_الصفحات < 300)
                ارجع "كتاب متوسط"
            نهاية
            اذا (عدد_الصفحات < 600)
                ارجع "كتاب كبير"
            نهاية
            ارجع "موسوعة"
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف عضو مكتبة
# ═══════════════════════════════════════════════════════

صنف عضو
    عام
        نص الاسم
        رقم رقم_العضوية
        رقم عدد_الكتب_المستعارة
        رقم الحد_الأقصى

        باني(نص اسم، رقم رقم_عضوية)
            الاسم = اسم
            رقم_العضوية = رقم_عضوية
            عدد_الكتب_المستعارة = 0
            الحد_الأقصى = 3
        نهاية

        دالة رقم يمكن_الاستعارة()
            اذا (عدد_الكتب_المستعارة < الحد_الأقصى)
                ارجع 1
            نهاية
            ارجع 0
        نهاية

        دالة رقم استعارة_كتاب()
            اذا (عدد_الكتب_المستعارة >= الحد_الأقصى)
                اطبع("    ❌ ")
                اطبع(الاسم)
                اطبع_سطر(" وصل للحد الأقصى من الاستعارات")
                ارجع 0
            نهاية
            عدد_الكتب_المستعارة = عدد_الكتب_المستعارة + 1
            ارجع 1
        نهاية

        دالة إرجاع_كتاب()
            اذا (عدد_الكتب_المستعارة > 0)
                عدد_الكتب_المستعارة = عدد_الكتب_المستعارة - 1
            نهاية
        نهاية

        دالة عرض()
            اطبع("    👤 ")
            اطبع(الاسم)
            اطبع(" (عضوية: ")
            اطبع(رقم_العضوية)
            اطبع(") كتب مستعارة: ")
            اطبع(عدد_الكتب_المستعارة)
            اطبع("/")
            اطبع_سطر(الحد_الأقصى)
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف إحصائيات مكتبة
# ═══════════════════════════════════════════════════════

صنف إحصائيات
    عام
        رقم إجمالي_الكتب
        رقم إجمالي_المُعار
        رقم إجمالي_المتاح
        رقم إجمالي_القيمة

        باني()
            إجمالي_الكتب = 0
            إجمالي_المُعار = 0
            إجمالي_المتاح = 0
            إجمالي_القيمة = 0
        نهاية

        دالة إضافة_كتاب(رقم سعر، رقم حالة_متاح)
            إجمالي_الكتب = إجمالي_الكتب + 1
            إجمالي_القيمة = إجمالي_القيمة + سعر
            اذا (حالة_متاح == 1)
                إجمالي_المتاح = إجمالي_المتاح + 1
            والا
                إجمالي_المُعار = إجمالي_المُعار + 1
            نهاية
        نهاية

        دالة عرض()
            اطبع_سطر("    ╔════════════════════════════╗")
            اطبع("    ║ إجمالي الكتب:    ")
            اطبع_سطر(إجمالي_الكتب)
            اطبع("    ║ المتاحة:          ")
            اطبع_سطر(إجمالي_المتاح)
            اطبع("    ║ المُعارة:          ")
            اطبع_سطر(إجمالي_المُعار)
            اطبع("    ║ القيمة الكلية:     ")
            اطبع_سطر(إجمالي_القيمة)
            اطبع_سطر("    ╚════════════════════════════╝")
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  📚 Phase 17: نظام مكتبة كتب         ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    # إنشاء كتب
    اطبع_سطر("━━━ مجموعة الكتب ━━━")
    متغير ك1 = جديد كتاب("البخلاء"، "الجاحظ"، 45، 280)
    متغير ك2 = جديد كتاب("مقدمة ابن خلدون"، "ابن خلدون"، 120، 750)
    متغير ك3 = جديد كتاب("رسالة الغفران"، "المعري"، 55، 190)
    متغير ك4 = جديد كتاب("ألف ليلة وليلة"، "مجهول"، 85، 520)
    متغير ك5 = جديد كتاب("الأمير الصغير"، "سانت إكزوبيري"، 30، 80)

    ك1.عرض()
    ك2.عرض()
    ك3.عرض()
    ك4.عرض()
    ك5.عرض()

    # تصنيف حجم الكتب
    اطبع_سطر("")
    اطبع_سطر("━━━ تصنيف الأحجام ━━━")
    اطبع("    البخلاء: ")
    اطبع_سطر(ك1.تصنيف_الحجم())
    اطبع("    مقدمة ابن خلدون: ")
    اطبع_سطر(ك2.تصنيف_الحجم())
    اطبع("    الأمير الصغير: ")
    اطبع_سطر(ك5.تصنيف_الحجم())

    # إنشاء أعضاء
    اطبع_سطر("")
    اطبع_سطر("━━━ الأعضاء ━━━")
    متغير ع1 = جديد عضو("سارة"، 1001)
    متغير ع2 = جديد عضو("محمد"، 1002)

    ع1.عرض()
    ع2.عرض()

    # عمليات الاستعارة
    اطبع_سطر("")
    اطبع_سطر("━━━ عمليات الاستعارة ━━━")
    ك1.استعارة()
    ع1.استعارة_كتاب()

    ك2.استعارة()
    ع1.استعارة_كتاب()

    ك4.استعارة()
    ع2.استعارة_كتاب()

    # محاولة استعارة كتاب مُعار
    اطبع_سطر("")
    اطبع_سطر("━━━ محاولة استعارة كتاب مُعار ━━━")
    ك1.استعارة()

    # إرجاع كتاب
    اطبع_سطر("")
    اطبع_سطر("━━━ إرجاع الكتب ━━━")
    ك1.رد_كتاب()
    ع1.إرجاع_كتاب()

    # الحالة بعد العمليات
    اطبع_سطر("")
    اطبع_سطر("━━━ الحالة النهائية ━━━")
    ك1.عرض()
    ك2.عرض()
    ك3.عرض()
    ك4.عرض()
    ك5.عرض()

    اطبع_سطر("")
    ع1.عرض()
    ع2.عرض()

    # إحصائيات
    اطبع_سطر("")
    اطبع_سطر("━━━ إحصائيات المكتبة ━━━")
    متغير إحص = جديد إحصائيات()
    إحص.إضافة_كتاب(45، 1)
    إحص.إضافة_كتاب(120، 0)
    إحص.إضافة_كتاب(55، 1)
    إحص.إضافة_كتاب(85، 0)
    إحص.إضافة_كتاب(30، 1)
    إحص.عرض()

    اطبع_سطر("✅ تم اختبار نظام المكتبة بنجاح")

    ارجع 0
نهاية
