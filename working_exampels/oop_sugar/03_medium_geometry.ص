# مثال متوسط 3: نظام أشكال هندسية مع دوال حسابية
# =============================================================
# الهدف: أصناف متعددة مع عمليات حسابية ومنطقية
# المستوى: متوسط
# الميزة: OOP Sugar - صنف/باني/جديد (Phase 17)
# =============================================================

# ═══════════════════════════════════════════════════════
# صنف نقطة ثنائية الأبعاد
# ═══════════════════════════════════════════════════════

صنف نقطة
    عام
        رقم س
        رقم ص

        باني(رقم قيمة_س، رقم قيمة_ص)
            س = قيمة_س
            ص = قيمة_ص
        نهاية

        دالة عرض()
            اطبع("(")
            اطبع(س)
            اطبع("، ")
            اطبع(ص)
            اطبع(")")
        نهاية

        دالة رقم المسافة_من_الأصل()
            # تقريب بدون sqrt: |س| + |ص| (مسافة مانهاتن)
            متغير مسافة = 0
            اذا (س >= 0)
                مسافة = مسافة + س
            والا
                مسافة = مسافة - س
            نهاية
            اذا (ص >= 0)
                مسافة = مسافة + ص
            والا
                مسافة = مسافة - ص
            نهاية
            ارجع مسافة
        نهاية

        دالة رقم في_الربع()
            اذا (س > 0)
                اذا (ص > 0)
                    ارجع 1
                نهاية
                ارجع 4
            نهاية
            اذا (ص > 0)
                ارجع 2
            نهاية
            ارجع 3
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف مستطيل
# ═══════════════════════════════════════════════════════

صنف مستطيل
    عام
        رقم العرض
        رقم الطول

        باني(رقم عرض، رقم طول)
            العرض = عرض
            الطول = طول
        نهاية

        دالة رقم المساحة()
            ارجع العرض * الطول
        نهاية

        دالة رقم المحيط()
            ارجع 2 * (العرض + الطول)
        نهاية

        دالة رقم مربع()
            اذا (العرض == الطول)
                ارجع 1
            نهاية
            ارجع 0
        نهاية

        دالة عرض_المعلومات()
            اطبع("    📐 مستطيل [")
            اطبع(العرض)
            اطبع(" × ")
            اطبع(الطول)
            اطبع("] المساحة=")
            اطبع(العرض * الطول)
            اطبع(" المحيط=")
            اطبع_سطر(2 * (العرض + الطول))
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف دائرة
# ═══════════════════════════════════════════════════════

صنف دائرة
    عام
        رقم نصف_القطر

        باني(رقم نق)
            نصف_القطر = نق
        نهاية

        # تقريب π ≈ 314/100
        دالة رقم المساحة_التقريبية()
            ارجع 314 * نصف_القطر * نصف_القطر / 100
        نهاية

        دالة رقم المحيط_التقريبي()
            ارجع 2 * 314 * نصف_القطر / 100
        نهاية

        دالة عرض_المعلومات()
            اطبع("    ⭕ دائرة [نق=")
            اطبع(نصف_القطر)
            اطبع("] المساحة≈")
            اطبع(314 * نصف_القطر * نصف_القطر / 100)
            اطبع(" المحيط≈")
            اطبع_سطر(2 * 314 * نصف_القطر / 100)
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف مثلث
# ═══════════════════════════════════════════════════════

صنف مثلث
    عام
        رقم الضلع_أ
        رقم الضلع_ب
        رقم الضلع_ج

        باني(رقم أ، رقم ب، رقم ج)
            الضلع_أ = أ
            الضلع_ب = ب
            الضلع_ج = ج
        نهاية

        دالة رقم المحيط()
            ارجع الضلع_أ + الضلع_ب + الضلع_ج
        نهاية

        دالة رقم متساوي_الأضلاع()
            اذا (الضلع_أ == الضلع_ب)
                اذا (الضلع_ب == الضلع_ج)
                    ارجع 1
                نهاية
            نهاية
            ارجع 0
        نهاية

        دالة رقم متساوي_الساقين()
            اذا (الضلع_أ == الضلع_ب)
                ارجع 1
            نهاية
            اذا (الضلع_ب == الضلع_ج)
                ارجع 1
            نهاية
            اذا (الضلع_أ == الضلع_ج)
                ارجع 1
            نهاية
            ارجع 0
        نهاية

        دالة عرض_المعلومات()
            اطبع("    🔺 مثلث [")
            اطبع(الضلع_أ)
            اطبع("، ")
            اطبع(الضلع_ب)
            اطبع("، ")
            اطبع(الضلع_ج)
            اطبع("] المحيط=")
            اطبع_سطر(الضلع_أ + الضلع_ب + الضلع_ج)
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  📐 Phase 17: أشكال هندسية            ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    # نقاط
    اطبع_سطر("━━━ النقاط ━━━")
    متغير ن1 = جديد نقطة(3، 4)
    متغير ن2 = جديد نقطة(-5، 2)
    متغير ن3 = جديد نقطة(-3، -7)
    متغير ن4 = جديد نقطة(0، 0)

    اطبع("    النقطة 1: ")
    ن1.عرض()
    اطبع(" - مسافة مانهاتن: ")
    اطبع(ن1.المسافة_من_الأصل())
    اطبع(" - الربع: ")
    اطبع_سطر(ن1.في_الربع())

    اطبع("    النقطة 2: ")
    ن2.عرض()
    اطبع(" - مسافة مانهاتن: ")
    اطبع(ن2.المسافة_من_الأصل())
    اطبع(" - الربع: ")
    اطبع_سطر(ن2.في_الربع())

    اطبع("    النقطة 3: ")
    ن3.عرض()
    اطبع(" - مسافة مانهاتن: ")
    اطبع(ن3.المسافة_من_الأصل())
    اطبع(" - الربع: ")
    اطبع_سطر(ن3.في_الربع())

    # مستطيلات
    اطبع_سطر("")
    اطبع_سطر("━━━ المستطيلات ━━━")
    متغير م1 = جديد مستطيل(10، 5)
    متغير م2 = جديد مستطيل(7، 7)
    متغير م3 = جديد مستطيل(15، 3)

    م1.عرض_المعلومات()
    م2.عرض_المعلومات()
    م3.عرض_المعلومات()

    اذا (م2.مربع() == 1)
        اطبع_سطر("    ✅ المستطيل 2 هو مربع")
    والا
        اطبع_سطر("    ❌ المستطيل 2 ليس مربعاً")
    نهاية

    # دوائر
    اطبع_سطر("")
    اطبع_سطر("━━━ الدوائر ━━━")
    متغير د1 = جديد دائرة(5)
    متغير د2 = جديد دائرة(10)
    متغير د3 = جديد دائرة(1)

    د1.عرض_المعلومات()
    د2.عرض_المعلومات()
    د3.عرض_المعلومات()

    # مثلثات
    اطبع_سطر("")
    اطبع_سطر("━━━ المثلثات ━━━")
    متغير ث1 = جديد مثلث(5، 5، 5)
    متغير ث2 = جديد مثلث(3، 4، 5)
    متغير ث3 = جديد مثلث(6، 6، 4)

    ث1.عرض_المعلومات()
    ث2.عرض_المعلومات()
    ث3.عرض_المعلومات()

    اذا (ث1.متساوي_الأضلاع() == 1)
        اطبع_سطر("    ✅ المثلث 1 متساوي الأضلاع")
    نهاية
    اذا (ث3.متساوي_الساقين() == 1)
        اطبع_سطر("    ✅ المثلث 3 متساوي الساقين")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("✅ تم اختبار الأشكال الهندسية بنجاح")

    ارجع 0
نهاية
