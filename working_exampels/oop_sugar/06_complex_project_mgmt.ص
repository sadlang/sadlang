# ═══════════════════════════════════════════════════════
# صنف مهمة
# ═══════════════════════════════════════════════════════

صنف مهمة
    عام
        نص العنوان
        رقم الأولوية
        رقم المدة_المقدرة
        رقم المدة_الفعلية
        رقم مكتملة
        نص المسؤول

        باني(نص عنوان، رقم أولوية، رقم مدة)
            العنوان = عنوان
            الأولوية = أولوية
            المدة_المقدرة = مدة
            المدة_الفعلية = 0
            مكتملة = 0
            المسؤول = ""
        نهاية

        دالة تعيين(نص اسم)
            المسؤول = اسم
            اطبع("    📋 تعيين '")
            اطبع(العنوان)
            اطبع("' إلى ")
            اطبع_سطر(اسم)
        نهاية

        دالة إكمال(رقم مدة_فعلية)
            مكتملة = 1
            المدة_الفعلية = مدة_فعلية
            اطبع("    ✅ اكتملت: ")
            اطبع_سطر(العنوان)
        نهاية

        دالة رقم متأخرة()
            اذا (المدة_الفعلية > المدة_المقدرة)
                ارجع 1
            نهاية
            ارجع 0
        نهاية

        دالة نص حالة_الأولوية()
            اذا (الأولوية == 1)
                ارجع "🔴 عاجل"
            نهاية
            اذا (الأولوية == 2)
                ارجع "🟡 متوسط"
            نهاية
            ارجع "🟢 عادي"
        نهاية

        دالة عرض()
            اطبع("    ")
            اذا (الأولوية == 1)
                اطبع("🔴")
            والا
                اذا (الأولوية == 2)
                    اطبع("🟡")
                والا
                    اطبع("🟢")
                نهاية
            نهاية
            اطبع(" ")
            اطبع(العنوان)
            اذا (مكتملة == 1)
                اطبع(" [✅ مكتملة]")
            والا
                اطبع(" [⏳ قيد التنفيذ]")
            نهاية
            اذا (المسؤول != "")
                اطبع(" → ")
                اطبع(المسؤول)
            نهاية
            اطبع(" (")
            اذا (مكتملة == 1)
                اطبع(المدة_الفعلية)
                اطبع("/")
                اطبع(المدة_المقدرة)
                اطبع(" يوم")
            والا
                اطبع(المدة_المقدرة)
                اطبع(" يوم مقدر")
            نهاية
            اطبع_سطر(")")
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف موظف
# ═══════════════════════════════════════════════════════

صنف موظف
    عام
        نص الاسم
        نص المنصب
        رقم المهام_المكتملة
        رقم المهام_المتأخرة
        رقم إجمالي_الساعات
        رقم التقييم

        باني(نص اسم، نص منصب)
            الاسم = اسم
            المنصب = منصب
            المهام_المكتملة = 0
            المهام_المتأخرة = 0
            إجمالي_الساعات = 0
            التقييم = 50
        نهاية

        دالة إنجاز_مهمة(رقم ساعات، رقم في_الوقت)
            المهام_المكتملة = المهام_المكتملة + 1
            إجمالي_الساعات = إجمالي_الساعات + ساعات
            اذا (في_الوقت == 1)
                التقييم = التقييم + 5
                اذا (التقييم > 100)
                    التقييم = 100
                نهاية
            والا
                المهام_المتأخرة = المهام_المتأخرة + 1
                التقييم = التقييم - 3
                اذا (التقييم < 0)
                    التقييم = 0
                نهاية
            نهاية
        نهاية

        دالة نص مستوى_الأداء()
            اذا (التقييم >= 80)
                ارجع "⭐⭐⭐ ممتاز"
            نهاية
            اذا (التقييم >= 60)
                ارجع "⭐⭐ جيد"
            نهاية
            اذا (التقييم >= 40)
                ارجع "⭐ مقبول"
            نهاية
            ارجع "⚠️ ضعيف"
        نهاية

        دالة رقم نسبة_الإنجاز_في_الوقت()
            اذا (المهام_المكتملة == 0)
                ارجع 0
            نهاية
            ارجع (المهام_المكتملة - المهام_المتأخرة) * 100 / المهام_المكتملة
        نهاية

        دالة عرض_بطاقة()
            اطبع_سطر("    ┌──────────────────────────────┐")
            اطبع("    │ 👨‍💼 ")
            اطبع(الاسم)
            اطبع(" - ")
            اطبع_سطر(المنصب)
            اطبع("    │ المهام: ")
            اطبع(المهام_المكتملة)
            اطبع(" مكتملة (")
            اطبع(المهام_المتأخرة)
            اطبع_سطر(" متأخرة)")
            اطبع("    │ الساعات: ")
            اطبع_سطر(إجمالي_الساعات)
            اطبع("    │ التقييم: ")
            اطبع(التقييم)
            اطبع("/100 - ")
            اذا (التقييم >= 80)
                اطبع_سطر("ممتاز ⭐⭐⭐")
            والا
                اذا (التقييم >= 60)
                    اطبع_سطر("جيد ⭐⭐")
                والا
                    اذا (التقييم >= 40)
                        اطبع_سطر("مقبول ⭐")
                    والا
                        اطبع_سطر("ضعيف ⚠️")
                    نهاية
                نهاية
            نهاية
            اطبع_سطر("    └──────────────────────────────┘")
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# صنف ملخص المشروع
# ═══════════════════════════════════════════════════════

صنف ملخص_مشروع
    عام
        نص اسم_المشروع
        رقم إجمالي_المهام
        رقم المهام_المكتملة
        رقم المهام_المتأخرة
        رقم المهام_العاجلة
        رقم المدة_الكلية_المقدرة
        رقم المدة_الكلية_الفعلية

        باني(نص اسم)
            اسم_المشروع = اسم
            إجمالي_المهام = 0
            المهام_المكتملة = 0
            المهام_المتأخرة = 0
            المهام_العاجلة = 0
            المدة_الكلية_المقدرة = 0
            المدة_الكلية_الفعلية = 0
        نهاية

        دالة إضافة_مهمة(رقم أولوية، رقم مدة_مقدرة، رقم مكتملة، رقم مدة_فعلية)
            إجمالي_المهام = إجمالي_المهام + 1
            المدة_الكلية_المقدرة = المدة_الكلية_المقدرة + مدة_مقدرة
            اذا (أولوية == 1)
                المهام_العاجلة = المهام_العاجلة + 1
            نهاية
            اذا (مكتملة == 1)
                المهام_المكتملة = المهام_المكتملة + 1
                المدة_الكلية_الفعلية = المدة_الكلية_الفعلية + مدة_فعلية
                اذا (مدة_فعلية > مدة_مقدرة)
                    المهام_المتأخرة = المهام_المتأخرة + 1
                نهاية
            نهاية
        نهاية

        دالة رقم نسبة_الإنجاز()
            اذا (إجمالي_المهام == 0)
                ارجع 0
            نهاية
            ارجع المهام_المكتملة * 100 / إجمالي_المهام
        نهاية

        دالة عرض()
            اطبع_سطر("    ╔══════════════════════════════════╗")
            اطبع("    ║  📊 ملخص مشروع: ")
            اطبع_سطر(اسم_المشروع)
            اطبع_سطر("    ╠══════════════════════════════════╣")
            اطبع("    ║  إجمالي المهام:     ")
            اطبع_سطر(إجمالي_المهام)
            اطبع("    ║  المكتملة:           ")
            اطبع_سطر(المهام_المكتملة)
            اطبع("    ║  المتأخرة:           ")
            اطبع_سطر(المهام_المتأخرة)
            اطبع("    ║  العاجلة:            ")
            اطبع_سطر(المهام_العاجلة)
            اطبع("    ║  نسبة الإنجاز:       ")
            اذا (إجمالي_المهام > 0)
                اطبع(المهام_المكتملة * 100 / إجمالي_المهام)
            والا
                اطبع(0)
            نهاية
            اطبع_سطر("%")
            اطبع("    ║  المدة المقدرة:      ")
            اطبع(المدة_الكلية_المقدرة)
            اطبع_سطر(" يوم")
            اطبع("    ║  المدة الفعلية:      ")
            اطبع(المدة_الكلية_الفعلية)
            اطبع_سطر(" يوم")
            اطبع_سطر("    ╚══════════════════════════════════╝")
        نهاية
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════╗")
    اطبع_سطر("║  🏗️ Phase 17: نظام إدارة مشروع      ║")
    اطبع_سطر("╚══════════════════════════════════════╝")
    اطبع_سطر("")

    # إنشاء الموظفين
    اطبع_سطر("━━━ فريق العمل ━━━")
    متغير م1 = جديد موظف("سارة"، "مديرة مشروع")
    متغير م2 = جديد موظف("أحمد"، "مطور أول")
    متغير م3 = جديد موظف("فاطمة"، "مصممة")
    متغير م4 = جديد موظف("خالد"، "مختبر")

    # إنشاء المهام
    اطبع_سطر("")
    اطبع_سطر("━━━ إنشاء المهام ━━━")
    متغير ت1 = جديد مهمة("تصميم قاعدة البيانات"، 1، 5)
    متغير ت2 = جديد مهمة("تطوير واجهة المستخدم"، 2، 10)
    متغير ت3 = جديد مهمة("كتابة التوثيق"، 3، 3)
    متغير ت4 = جديد مهمة("اختبار الأمان"، 1، 7)
    متغير ت5 = جديد مهمة("تحسين الأداء"، 2، 4)
    متغير ت6 = جديد مهمة("إصلاح الأخطاء"، 1، 2)
    متغير ت7 = جديد مهمة("مراجعة الكود"، 3، 3)
    متغير ت8 = جديد مهمة("نشر التحديث"، 2، 1)

    # تعيين المهام
    اطبع_سطر("")
    اطبع_سطر("━━━ تعيين المهام ━━━")
    ت1.تعيين("أحمد")
    ت2.تعيين("فاطمة")
    ت3.تعيين("سارة")
    ت4.تعيين("خالد")
    ت5.تعيين("أحمد")
    ت6.تعيين("أحمد")
    ت7.تعيين("سارة")
    ت8.تعيين("خالد")

    # إكمال بعض المهام
    اطبع_سطر("")
    اطبع_سطر("━━━ إنجاز المهام ━━━")
    ت1.إكمال(4)
    ت3.إكمال(5)
    ت4.إكمال(8)
    ت5.إكمال(3)
    ت6.إكمال(3)

    # تسجيل إنجازات الموظفين
    # سارة: أنجزت ت3 (متأخرة: 5>3)، ت7 قيد التنفيذ
    م1.إنجاز_مهمة(5، 0)
    
    # أحمد: أنجز ت1 (في الوقت: 4<=5)، ت5 (في الوقت: 3<=4)، ت6 (متأخرة: 3>2)
    م2.إنجاز_مهمة(4، 1)
    م2.إنجاز_مهمة(3، 1)
    م2.إنجاز_مهمة(3، 0)
    
    # خالد: أنجز ت4 (متأخرة: 8>7)
    م4.إنجاز_مهمة(8، 0)

    # عرض المهام
    اطبع_سطر("")
    اطبع_سطر("━━━ حالة المهام ━━━")
    ت1.عرض()
    ت2.عرض()
    ت3.عرض()
    ت4.عرض()
    ت5.عرض()
    ت6.عرض()
    ت7.عرض()
    ت8.عرض()

    # بطاقات الموظفين
    اطبع_سطر("")
    اطبع_سطر("━━━ بطاقات الموظفين ━━━")
    م1.عرض_بطاقة()
    م2.عرض_بطاقة()
    م3.عرض_بطاقة()
    م4.عرض_بطاقة()

    # ملخص المشروع
    اطبع_سطر("")
    اطبع_سطر("━━━ ملخص المشروع ━━━")
    متغير ملخص = جديد ملخص_مشروع("بوابة المعرفة")
    ملخص.إضافة_مهمة(1، 5، 1، 4)
    ملخص.إضافة_مهمة(2، 10، 0، 0)
    ملخص.إضافة_مهمة(3، 3، 1، 5)
    ملخص.إضافة_مهمة(1، 7، 1، 8)
    ملخص.إضافة_مهمة(2، 4، 1، 3)
    ملخص.إضافة_مهمة(1، 2، 1، 3)
    ملخص.إضافة_مهمة(3، 3، 0، 0)
    ملخص.إضافة_مهمة(2، 1، 0، 0)
    ملخص.عرض()

    # المهام المتأخرة
    اطبع_سطر("━━━ فحص التأخيرات ━━━")
    اذا (ت1.متأخرة() == 0)
        اطبع_سطر("    ✅ تصميم قاعدة البيانات: في الوقت")
    والا
        اطبع_سطر("    ❌ تصميم قاعدة البيانات: متأخرة")
    نهاية
    اذا (ت3.متأخرة() == 1)
        اطبع_سطر("    ❌ كتابة التوثيق: متأخرة")
    والا
        اطبع_سطر("    ✅ كتابة التوثيق: في الوقت")
    نهاية
    اذا (ت4.متأخرة() == 1)
        اطبع_سطر("    ❌ اختبار الأمان: متأخر")
    والا
        اطبع_سطر("    ✅ اختبار الأمان: في الوقت")
    نهاية
    اذا (ت6.متأخرة() == 1)
        اطبع_سطر("    ❌ إصلاح الأخطاء: متأخر")
    والا
        اطبع_سطر("    ✅ إصلاح الأخطاء: في الوقت")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("✅ تم اختبار نظام إدارة المشروع بنجاح")

    ارجع 0
نهاية
