صدّر دالة اطبع_خط(رقم عرض)
    رقم ع = 0
    بينما (ع < عرض)
        اطبع("=")
        ع = ع + 1
    نهاية
    اطبع_سطر("")
نهاية

صدّر دالة اطبع_فراغات(رقم عدد)
    رقم ع = 0
    بينما (ع < عدد)
        اطبع(" ")
        ع = ع + 1
    نهاية
نهاية

صدّر دالة اطبع_نجوم(رقم عدد)
    رقم ع = 0
    بينما (ع < عدد)
        اطبع("*")
        ع = ع + 1
    نهاية
نهاية

صدّر دالة اطبع_عنوان(عنوان)
    اطبع_سطر("")
    اطبع_خط(50)
    اطبع_سطر(عنوان)
    اطبع_خط(50)
نهاية

صدّر دالة اطبع_قائمة_عنصر(رقم رقم_العنصر، محتوى)
    اطبع("  [")
    اطبع(رقم_العنصر)
    اطبع("] ")
    اطبع_سطر(محتوى)
نهاية

صدّر دالة رقم اقرأ_اختيار(رقم حد_ادنى، رقم حد_اقصى)
    اطبع(">> اختيارك (")
    اطبع(حد_ادنى)
    اطبع("-")
    اطبع(حد_اقصى)
    اطبع("): ")
    متغير مدخل = اقرأ()
    رقم اختيار = لرقم(مدخل)
    ارجع اختيار
نهاية

صدّر دالة اطبع_نجاح(رسالة)
