# تطبيق الطقس - Android
# Weather App with Full UI
# ═══════════════════════════════════════════════════════════════════════════

استورد اندرويد.تطبيق
استورد اندرويد.واجهة
استورد اندرويد.مكونات
استورد اندرويد.حالة

# ═══════════════════════════════════════════════════════════════════════════
# إعداد التطبيق
# ═══════════════════════════════════════════════════════════════════════════

تطبيق طقسي
    الاسم = "طقسي"
    الحزمة = "com.sad.weather"
    الإصدار = "1.0.0"
    دعم_العربية = صحيح
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# بيانات الطقس
# ═══════════════════════════════════════════════════════════════════════════

متغير المدينة_الحالية = إشارة("الرياض")

متغير بيانات_المدن = {
    "الرياض" = {"الحرارة" = 32، "الحالة" = "مشمس"، "الرطوبة" = 20، "الرياح" = 15}،
    "جدة" = {"الحرارة" = 28، "الحالة" = "غائم جزئياً"، "الرطوبة" = 65، "الرياح" = 20}،
    "مكة" = {"الحرارة" = 35، "الحالة" = "مشمس"، "الرطوبة" = 30، "الرياح" = 10}،
    "الدمام" = {"الحرارة" = 26، "الحالة" = "غائم"، "الرطوبة" = 70، "الرياح" = 25}،
    "المدينة" = {"الحرارة" = 30، "الحالة" = "مشمس"، "الرطوبة" = 25، "الرياح" = 12}
}

متغير توقعات_الأسبوع = [
    {"اليوم" = "السبت"، "العظمى" = 33، "الصغرى" = 22، "الحالة" = "مشمس"}،
    {"اليوم" = "الأحد"، "العظمى" = 32، "الصغرى" = 21، "الحالة" = "غائم جزئياً"}،
    {"اليوم" = "الإثنين"، "العظمى" = 30، "الصغرى" = 20، "الحالة" = "غائم"}،
    {"اليوم" = "الثلاثاء"، "العظمى" = 28، "الصغرى" = 19، "الحالة" = "ممطر"}،
    {"اليوم" = "الأربعاء"، "العظمى" = 29، "الصغرى" = 18، "الحالة" = "غائم جزئياً"}،
    {"اليوم" = "الخميس"، "العظمى" = 31، "الصغرى" = 20، "الحالة" = "مشمس"}،
    {"اليوم" = "الجمعة"، "العظمى" = 34، "الصغرى" = 23، "الحالة" = "مشمس"}
]

# ═══════════════════════════════════════════════════════════════════════════
# دوال مساعدة
# ═══════════════════════════════════════════════════════════════════════════

دالة رمز_الطقس(الحالة)
    إذا (الحالة == "مشمس")
        ارجع "☀️"
    وإلا إذا (الحالة == "غائم جزئياً")
        ارجع "⛅"
    وإلا إذا (الحالة == "غائم")
        ارجع "☁️"
    وإلا إذا (الحالة == "ممطر")
        ارجع "🌧️"
    وإلا
        ارجع "🌤️"
    نهاية
نهاية

دالة لون_الخلفية(الحالة)
    إذا (الحالة == "مشمس")
        ارجع [ألوان.برتقالي، ألوان.أصفر]
    وإلا إذا (الحالة == "ممطر")
        ارجع [ألوان.رمادي_غامق، ألوان.أزرق_رمادي]
    وإلا
        ارجع [ألوان.أزرق_فاتح، ألوان.أزرق]
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# الشاشة الرئيسية
# ═══════════════════════════════════════════════════════════════════════════

صنف شاشة_الطقس يرث شاشة
    
    دالة ابنِ()
        متغير المدينة = المدينة_الحالية.القيمة()
        متغير الطقس = بيانات_المدن[المدينة]
        
        ارجع سقالة(
            الجسم = حاوية_متدرجة(
                الألوان = لون_الخلفية(الطقس["الحالة"])،
                ابن = حاشية_آمنة(
                    ابن = عمود([
                        # شريط علوي مخصص
                        صف_بين([
                            زر_أيقونة(
                                أيقونة = أيقونات.موقع،
                                لون = ألوان.أبيض،
                                عند_الضغط = دالة()
                                    انتقل_إلى(شاشة_المدن())
                                نهاية
                            )،
                            نص(المدينة).بنمط(طباعة.عنوان_متوسط).بلون(ألوان.أبيض)،
                            زر_أيقونة(
                                أيقونة = أيقونات.بحث،
                                لون = ألوان.أبيض
                            )
                        ])،
                        
                        مسافة(32)،
                        
                        # عرض الطقس الرئيسي
                        وسط(
                            ابن = عمود([
                                نص(رمز_الطقس(الطقس["الحالة"])).بحجم(100)،
                                مسافة(16)،
                                نص(نص(الطقس["الحرارة"]) + "°")
                                    .بحجم(80)
                                    .بلون(ألوان.أبيض)،
                                نص(الطقس["الحالة"])
                                    .بحجم(24)
                                    .بلون(ألوان.أبيض_شفاف)
                            ])
                        )،
                        
                        مسافة(32)،
                        
                        # تفاصيل الطقس
                        صف_متساوي([
                            عنصر_تفصيل("💨"، "الرياح"، نص(الطقس["الرياح"]) + " كم/س")،
                            عنصر_تفصيل("💧"، "الرطوبة"، نص(الطقس["الرطوبة"]) + "%")،
                            عنصر_تفصيل("🌡️"، "الشعور"، نص(الطقس["الحرارة"] + 2) + "°")
                        ])،
                        
                        مسافة(24)،
                        
                        # توقعات الأسبوع
                        نص("توقعات الأسبوع").بلون(ألوان.أبيض).بنمط(طباعة.عنوان_صغير)،
                        مسافة(12)،
                        
                        حاوية(
                            الارتفاع = 120،
                            ابن = قائمة_أفقية(
                                الأبناء = توقعات_الأسبوع.خريطة(دالة(يوم)
                                    ارجع بطاقة_يوم(يوم)
                                نهاية)
                            )
                        )
                    ])
                )
            )
        )
    نهاية
    
    دالة عنصر_تفصيل(الأيقونة، العنوان، القيمة)
        ارجع عمود([
            نص(الأيقونة).بحجم(30)،
            مسافة(4)،
            نص(العنوان).بحجم(12).بلون(ألوان.أبيض_شفاف)،
            نص(القيمة).بلون(ألوان.أبيض)
        ])
    نهاية
    
    دالة بطاقة_يوم(يوم)
        ارجع حاوية(
            العرض = 80،
            حاشية = 12،
            هامش = 4،
            لون_الخلفية = ألوان.أبيض_شفاف_قليل،
            تدوير_الحواف = 12،
            ابن = عمود([
                نص(يوم["اليوم"]).بحجم(12).بلون(ألوان.أبيض)،
                مسافة(8)،
                نص(رمز_الطقس(يوم["الحالة"])).بحجم(30)،
                مسافة(8)،
                نص(نص(يوم["العظمى"]) + "°").بلون(ألوان.أبيض)،
                نص(نص(يوم["الصغرى"]) + "°").بحجم(12).بلون(ألوان.أبيض_شفاف)
            ])
        )
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# شاشة المدن
# ═══════════════════════════════════════════════════════════════════════════

صنف شاشة_المدن يرث شاشة
    
    دالة ابنِ()
        ارجع سقالة(
            شريط_علوي = شريط_تطبيق(
                العنوان = "🌍 اختر مدينة"،
                لون_الخلفية = ألوان.أزرق
            )،
            
            الجسم = قائمة(
                الأبناء = ["الرياض"، "جدة"، "مكة"، "الدمام"، "المدينة"].خريطة(دالة(مدينة)
                    متغير الطقس = بيانات_المدن[مدينة]
                    
                    ارجع عنصر_قائمة(
                        البادئة = نص(رمز_الطقس(الطقس["الحالة"])).بحجم(40)،
                        العنوان = نص(مدينة)،
                        العنوان_الفرعي = نص(الطقس["الحالة"])،
                        اللاحقة = نص(نص(الطقس["الحرارة"]) + "°").بنمط(طباعة.عنوان_متوسط)،
                        عند_الضغط = دالة()
                            المدينة_الحالية.عيّن(مدينة)
                            ارجع_للخلف()
                        نهاية
                    )
                نهاية)
            )
        )
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# تشغيل التطبيق
# ═══════════════════════════════════════════════════════════════════════════

شغّل(شاشة_الطقس())
