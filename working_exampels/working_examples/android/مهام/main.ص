استورد اندرويد.تطبيق
استورد اندرويد.واجهة
استورد اندرويد.مكونات
استورد اندرويد.حالة

# ═══════════════════════════════════════════════════════════════════════════
# إعداد التطبيق
# ═══════════════════════════════════════════════════════════════════════════

تطبيق مهامي
    الاسم = "مهامي"
    الحزمة = "com.sad.tasks"
    الإصدار = "1.0.0"
    دعم_العربية = صحيح
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# حالة التطبيق
# ═══════════════════════════════════════════════════════════════════════════

متغير المهام = إشارة([
    {"المعرف" = 1، "العنوان" = "إنهاء مشروع لغة ص"، "مكتملة" = خطأ، "الأولوية" = "عالية"}،
    {"المعرف" = 2، "العنوان" = "مراجعة الكود"، "مكتملة" = خطأ، "الأولوية" = "متوسطة"}،
    {"المعرف" = 3، "العنوان" = "اختبار التطبيقات"، "مكتملة" = صحيح، "الأولوية" = "متوسطة"}،
    {"المعرف" = 4، "العنوان" = "قراءة كتاب"، "مكتملة" = خطأ، "الأولوية" = "منخفضة"}
])

متغير آخر_معرف = إشارة(4)

# قيمة محسوبة
متغير عدد_المكتملة = محسوب(دالة()
    متغير العدد = 0
    لكل مهمة في المهام.القيمة()
        إذا (مهمة["مكتملة"])
            العدد += 1
        نهاية
    نهاية
    ارجع العدد
نهاية)

# ═══════════════════════════════════════════════════════════════════════════
# الشاشة الرئيسية
# ═══════════════════════════════════════════════════════════════════════════

صنف شاشة_المهام يرث شاشة
    
    دالة ابنِ()
        ارجع سقالة(
            شريط_علوي = شريط_تطبيق(
                العنوان = "📋 مهامي"،
                لون_الخلفية = ألوان.بنفسجي،
                الإجراءات = [
                    زر_أيقونة(
                        أيقونة = أيقونات.إحصائيات،
                        عند_الضغط = دالة()
                            انتقل_إلى(شاشة_الإحصائيات())
                        نهاية
                    )
                ]
            )،
            
            الجسم = عمود([
                # شريط التقدم
                حاوية(
                    لون_الخلفية = ألوان.بنفسجي_فاتح،
                    حاشية = 16،
                    ابن = عمود([
                        صف_بين([
                            نص("المكتملة")،
                            نص(نص(عدد_المكتملة.القيمة()) + " / " + نص(طول(المهام.القيمة())))
                        ])،
                        مسافة(8)،
                        شريط_تقدم(
                            القيمة = عدد_المكتملة.القيمة() / طول(المهام.القيمة())،
                            اللون = ألوان.بنفسجي
                        )
                    ])
                )،
                
                # قائمة المهام
                موسع(
                    ابن = قائمة(
                        الأبناء = المهام.القيمة().خريطة(دالة(مهمة)
                            ارجع بطاقة_مهمة(مهمة)
                        نهاية)
                    )
                )
            ])،
            
            زر_عائم = زر_عائم(
                أيقونة = أيقونات.إضافة،
                لون_الخلفية = ألوان.بنفسجي،
                عند_الضغط = دالة()
                    انتقل_إلى(شاشة_إضافة_مهمة())
                نهاية
            )
        )
    نهاية
    
    دالة بطاقة_مهمة(مهمة)
        متغير لون_الأولوية = ألوان.أخضر
        إذا (مهمة["الأولوية"] == "عالية")
            لون_الأولوية = ألوان.أحمر
        وإلا إذا (مهمة["الأولوية"] == "متوسطة")
            لون_الأولوية = ألوان.برتقالي
        نهاية
        
        ارجع بطاقة_قابلة_للسحب(
            عند_السحب_يمين = دالة()
                احذف_مهمة(مهمة["المعرف"])
            نهاية،
            ابن = عنصر_قائمة(
                البادئة = مربع_اختيار(
                    القيمة = مهمة["مكتملة"]،
                    عند_التغيير = دالة(قيمة)
                        بدّل_حالة_مهمة(مهمة["المعرف"])
                    نهاية
                )،
                العنوان = نص(مهمة["العنوان"])
                    .بتشطيب(مهمة["مكتملة"])،
                اللاحقة = شارة(
                    النص = مهمة["الأولوية"]،
                    اللون = لون_الأولوية
                )
            )
        )
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# شاشة إضافة مهمة
# ═══════════════════════════════════════════════════════════════════════════

صنف شاشة_إضافة_مهمة يرث شاشة
    متغير عنوان_المهمة = ""
    متغير الأولوية_المختارة = "متوسطة"
    
    دالة ابنِ()
        ارجع سقالة(
            شريط_علوي = شريط_تطبيق(العنوان = "➕ إضافة مهمة")،
            
            الجسم = حاشية(
                مقدار = 24،
                ابن = عمود([
                    أيقونة(أيقونات.مهمة، الحجم = 60، اللون = ألوان.بنفسجي)،
                    مسافة(24)،
                    
                    حقل_نص(
                        التسمية = "عنوان المهمة"،
                        عند_التغيير = دالة(قيمة)
                            هذا.عنوان_المهمة = قيمة
                        نهاية
                    )،
                    
                    مسافة(16)،
                    
                    نص("الأولوية:")،
                    مسافة(8)،
                    
                    صف([
                        شريحة_اختيار(
                            الخيارات = ["منخفضة"، "متوسطة"، "عالية"]،
                            المحدد = هذا.الأولوية_المختارة،
                            عند_التغيير = دالة(قيمة)
                                هذا.الأولوية_المختارة = قيمة
                            نهاية
                        )
                    ])،
                    
                    مسافة(32)،
                    
                    زر(
                        النص = "إضافة المهمة"،
                        العرض_الكامل = صحيح،
                        اللون = ألوان.بنفسجي،
                        عند_الضغط = دالة()
                            إذا (هذا.عنوان_المهمة != "")
                                أضف_مهمة(هذا.عنوان_المهمة، هذا.الأولوية_المختارة)
                                رسالة("تمت إضافة المهمة!")
                                ارجع_للخلف()
                            نهاية
                        نهاية
                    )
                ])
            )
        )
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# شاشة الإحصائيات
# ═══════════════════════════════════════════════════════════════════════════

صنف شاشة_الإحصائيات يرث شاشة
    
    دالة ابنِ()
        متغير الإجمالي = طول(المهام.القيمة())
        متغير المكتملة = عدد_المكتملة.القيمة()
        متغير المعلقة = الإجمالي - المكتملة
        متغير النسبة = 0
        إذا (الإجمالي > 0)
            النسبة = (المكتملة * 100) / الإجمالي
        نهاية
        
        ارجع سقالة(
            شريط_علوي = شريط_تطبيق(العنوان = "📊 الإحصائيات")،
            
            الجسم = حاشية(
                مقدار = 24،
                ابن = عمود([
                    # دائرة التقدم
                    وسط(
                        ابن = مؤشر_دائري(
                            القيمة = النسبة / 100،
                            الحجم = 150،
                            اللون = ألوان.بنفسجي،
                            ابن = نص(نص(النسبة) + "%").بنمط(طباعة.عنوان_كبير)
                        )
                    )،
                    
                    مسافة(32)،
                    
                    # البطاقات
                    شبكة(
                        الأعمدة = 2،
                        التباعد = 16،
                        الأبناء = [
                            بطاقة_إحصاء("📝"، "الإجمالي"، نص(الإجمالي)، ألوان.أزرق)،
                            بطاقة_إحصاء("✅"، "مكتملة"، نص(المكتملة)، ألوان.أخضر)،
                            بطاقة_إحصاء("⏳"، "معلقة"، نص(المعلقة)، ألوان.برتقالي)،
                            بطاقة_إحصاء("📈"، "الإنجاز"، نص(النسبة) + "%"، ألوان.بنفسجي)
                        ]
                    )
                ])
            )
        )
    نهاية
    
    دالة بطاقة_إحصاء(الأيقونة، العنوان، القيمة، اللون)
        ارجع بطاقة(
            ابن = عمود([
                نص(الأيقونة).بحجم(40)،
                مسافة(8)،
                نص(العنوان).بلون(ألوان.رمادي)،
                نص(القيمة).بنمط(طباعة.عنوان_كبير).بلون(اللون)
            ])
        )
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# دوال مساعدة
# ═══════════════════════════════════════════════════════════════════════════

دالة أضف_مهمة(العنوان، الأولوية)
    آخر_معرف.عيّن(آخر_معرف.القيمة() + 1)
    متغير مهمة_جديدة = {
        "المعرف" = آخر_معرف.القيمة()،
        "العنوان" = العنوان،
        "مكتملة" = خطأ،
        "الأولوية" = الأولوية
    }
    المهام.عيّن(المهام.القيمة() + [مهمة_جديدة])
نهاية

دالة بدّل_حالة_مهمة(المعرف)
    متغير قائمة_جديدة = المهام.القيمة().خريطة(دالة(مهمة)
        إذا (مهمة["المعرف"] == المعرف)
            مهمة["مكتملة"] = !مهمة["مكتملة"]
        نهاية
        ارجع مهمة
    نهاية)
    المهام.عيّن(قائمة_جديدة)
نهاية

دالة احذف_مهمة(المعرف)
    متغير قائمة_جديدة = المهام.القيمة().رشح(دالة(مهمة)
        ارجع مهمة["المعرف"] != المعرف
    نهاية)
    المهام.عيّن(قائمة_جديدة)
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# تشغيل التطبيق
# ═══════════════════════════════════════════════════════════════════════════

شغّل(شاشة_المهام())
