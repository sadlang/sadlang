# الشاشة الرئيسية
# ═══════════════════════════════════════════════════════════════════════════

صنف الشاشة_الرئيسية يرث شاشة
    
    دالة ابنِ()
        ارجع سقالة(
            شريط_علوي = شريط_تطبيق(
                العنوان = "🏦 بنك ص"،
                لون_الخلفية = ألوان.أخضر_غامق،
                الإجراءات = [
                    زر_أيقونة(
                        أيقونة = أيقونات.خروج،
                        عند_الضغط = دالة()
                            مسجّل_الدخول.عيّن(خطأ)
                            انتقل_إلى(شاشة_الدخول())
                        نهاية
                    )
                ]
            )،
            
            الجسم = تمرير(
                ابن = عمود([
                    # بطاقة الرصيد
                    بطاقة_متدرجة(
                        الألوان = [ألوان.أخضر، ألوان.أخضر_غامق]،
                        حاشية = 24،
                        ابن = عمود([
                            نص("مرحباً " + المستخدم_الحالي.القيمة()).بلون(ألوان.أبيض)،
                            مسافة(8)،
                            نص("رصيدك الحالي").بلون(ألوان.أبيض_شفاف)،
                            نص(نص(الرصيد.القيمة()) + " ر.س")
                                .بنمط(طباعة.عنوان_كبير_جداً)
                                .بلون(ألوان.أبيض)
                        ])
                    )،
                    
                    مسافة(24)،
                    
                    # أزرار الخدمات
                    نص("الخدمات السريعة").بنمط(طباعة.عنوان_متوسط)،
                    مسافة(16)،
                    
                    شبكة(
                        الأعمدة = 2،
                        التباعد = 12،
                        الأبناء = [
                            بطاقة_خدمة("💰"، "إيداع"، دالة() انتقل_إلى(شاشة_الإيداع()) نهاية)،
                            بطاقة_خدمة("💸"، "سحب"، دالة() انتقل_إلى(شاشة_السحب()) نهاية)،
                            بطاقة_خدمة("➡️"، "تحويل"، دالة() انتقل_إلى(شاشة_التحويل()) نهاية)،
                            بطاقة_خدمة("📜"، "السجل"، دالة() انتقل_إلى(شاشة_السجل()) نهاية)
                        ]
                    )،
                    
                    مسافة(24)،
                    
                    # آخر المعاملات
                    نص("آخر المعاملات").بنمط(طباعة.عنوان_متوسط)،
                    مسافة(8)،
                    
                    لكل معاملة في المعاملات.القيمة().شريحة(0، 3)
                        بطاقة_معاملة(معاملة)
                    نهاية
                ])
            )،
            
            شريط_سفلي = شريط_تنقل_سفلي(
                الفهرس_الحالي = 0،
                العناصر = [
                    عنصر_تنقل(أيقونة = أيقونات.بيت، نص = "الرئيسية")،
                    عنصر_تنقل(أيقونة = أيقونات.تاريخ، نص = "السجل")،
                    عنصر_تنقل(أيقونة = أيقونات.إعدادات، نص = "الإعدادات")
                ]
            )
        )
    نهاية
    
    دالة بطاقة_خدمة(الأيقونة، النص_، عند_الضغط)
        ارجع بطاقة(
            عند_الضغط = عند_الضغط،
            ابن = عمود([
                نص(الأيقونة).بحجم(40)،
                مسافة(8)،
                نص(النص_).بنمط(طباعة.عنوان_صغير)
            ])
        )
    نهاية
    
    دالة بطاقة_معاملة(معاملة)
        متغير الأيقونة = "💰"
        متغير اللون = ألوان.أخضر
        
        إذا (معاملة["النوع"] == "سحب")
            الأيقونة = "💸"
            اللون = ألوان.أحمر
        وإلا إذا (معاملة["النوع"] == "تحويل")
            الأيقونة = "➡️"
            اللون = ألوان.برتقالي
        نهاية
        
        ارجع عنصر_قائمة(
            البادئة = نص(الأيقونة).بحجم(30)،
            العنوان = نص(معاملة["النوع"])،
            العنوان_الفرعي = نص(معاملة["التاريخ"])،
            اللاحقة = نص(نص(معاملة["المبلغ"]) + " ر.س").بلون(اللون)
        )
    نهاية
نهاية

