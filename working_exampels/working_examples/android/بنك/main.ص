# شاشة تسجيل الدخول
# ═══════════════════════════════════════════════════════════════════════════

صنف شاشة_الدخول يرث شاشة
    متغير اسم_المستخدم = ""
    متغير كلمة_المرور = ""
    متغير خطأ_الدخول = إشارة("")
    
    دالة ابنِ()
        ارجع سقالة(
            الجسم = وسط(
                ابن = حاوية(
                    العرض = 300،
                    حاشية = 24،
                    ابن = عمود([
                        # شعار البنك
                        أيقونة(أيقونات.بنك، الحجم = 80، اللون = ألوان.أخضر)،
                        مسافة(16)،
                        نص("بنك ص").بنمط(طباعة.عنوان_كبير)،
                        نص("خدماتك المصرفية بين يديك").بلون(ألوان.رمادي)،
                        مسافة(32)،
                        
                        # حقل اسم المستخدم
                        حقل_نص(
                            التسمية = "اسم المستخدم"،
                            أيقونة_بادئة = أيقونات.شخص،
                            عند_التغيير = دالة(قيمة)
                                هذا.اسم_المستخدم = قيمة
                            نهاية
                        )،
                        مسافة(16)،
                        
                        # حقل كلمة المرور
                        حقل_نص(
                            التسمية = "كلمة المرور"،
                            مخفي = صحيح،
                            أيقونة_بادئة = أيقونات.قفل،
                            عند_التغيير = دالة(قيمة)
                                هذا.كلمة_المرور = قيمة
                            نهاية
                        )،
                        مسافة(8)،
                        
                        # رسالة الخطأ
                        إذا (خطأ_الدخول.القيمة() != "")
                            نص(خطأ_الدخول.القيمة()).بلون(ألوان.أحمر)
                        نهاية،
                        
                        مسافة(24)،
                        
                        # زر الدخول
                        زر(
                            النص = "تسجيل الدخول"،
                            العرض_الكامل = صحيح،
                            اللون = ألوان.أخضر،
                            عند_الضغط = دالة()
                                هذا.تسجيل_دخول()
                            نهاية
                        )،
                        
                        مسافة(16)،
                        نص("المستخدمون: أحمد/1234، فاطمة/5678، محمد/9999")
                            .بحجم(12).بلون(ألوان.رمادي)
                    ])
                )
            )
        )
    نهاية
    
    دالة تسجيل_دخول()
        لكل مستخدم في المستخدمون
            إذا (مستخدم["الاسم"] == هذا.اسم_المستخدم && مستخدم["كلمة_المرور"] == هذا.كلمة_المرور)
                المستخدم_الحالي.عيّن(مستخدم["الاسم"])
                الرصيد.عيّن(مستخدم["الرصيد"])
                مسجّل_الدخول.عيّن(صحيح)
                انتقل_إلى(الشاشة_الرئيسية())
                ارجع
            نهاية
        نهاية
        خطأ_الدخول.عيّن("اسم المستخدم أو كلمة المرور خاطئة")
    نهاية
نهاية

