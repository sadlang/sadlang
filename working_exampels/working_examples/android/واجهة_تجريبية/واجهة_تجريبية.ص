متغير العداد = 0
متغير الاسم = ""
متغير مفعل = صحيح

# ══════════════════════════════════════════════════════════════════════════
#  دالة البناء الرئيسية
# ══════════════════════════════════════════════════════════════════════════

دالة بناء_الواجهة()
    # إنشاء الحاوية الرئيسية
    متغير الجذر = عمود()
    
    # إضافة شريط التطبيق
    متغير الشريط = بطاقة()
    اضف_طفل(الجذر، الشريط)
    
    متغير العنوان = عنوان("🎨 النظام الرسومي الثوري")
    اضف_طفل(الشريط، العنوان)
    
    # ══════════════════════════════════════════════════════════════════════
    #  قسم الأزرار
    # ══════════════════════════════════════════════════════════════════════
    
    متغير قسم_الازرار = بطاقة()
    اضف_طفل(الجذر، قسم_الازرار)
    
    متغير عنوان_الازرار = نص("أنواع الأزرار المتاحة:")
    اضف_طفل(قسم_الازرار، عنوان_الازرار)
    
    متغير صف_الازرار = صف()
    اضف_طفل(قسم_الازرار، صف_الازرار)
    
    # زر مملوء
    متغير زر1 = زر("زر مملوء")
    اضف_طفل(صف_الازرار، زر1)
    
    # زر محدد
    متغير زر2 = زر_محدد("زر محدد")
    اضف_طفل(صف_الازرار، زر2)
    
    # زر نصي
    متغير زر3 = زر_نصي("زر نصي")
    اضف_طفل(صف_الازرار، زر3)
    
    # زر أيقونة
    متغير زر4 = زر_ايقونة("➕")
    اضف_طفل(صف_الازرار، زر4)
    
    # ══════════════════════════════════════════════════════════════════════
    #  قسم العداد
    # ══════════════════════════════════════════════════════════════════════
    
    متغير قسم_العداد = بطاقة()
    اضف_طفل(الجذر، قسم_العداد)
    
    متغير عنوان_العداد = عنوان("العداد التفاعلي")
    اضف_طفل(قسم_العداد، عنوان_العداد)
    
    متغير صف_العداد = صف()
    اضف_طفل(قسم_العداد، صف_العداد)
    
    # زر ناقص
    متغير زر_ناقص = زر("-")
    عند_النقر(زر_ناقص، انقص_العداد)
    اضف_طفل(صف_العداد، زر_ناقص)
    
    # عرض العدد
    متغير نص_العداد = نص("0")
    اضف_طفل(صف_العداد، نص_العداد)
    
    # زر زائد
    متغير زر_زائد = زر("+")
    عند_النقر(زر_زائد، زد_العداد)
    اضف_طفل(صف_العداد، زر_زائد)
    
    # ══════════════════════════════════════════════════════════════════════
    #  قسم الإدخال
    # ══════════════════════════════════════════════════════════════════════
    
    متغير قسم_الادخال = بطاقة()
    اضف_طفل(الجذر، قسم_الادخال)
    
    متغير عنوان_الادخال = عنوان("حقول الإدخال")
    اضف_طفل(قسم_الادخال، عنوان_الادخال)
    
    # حقل نص
    متغير حقل_الاسم = حقل_نص("أدخل اسمك")
    عند_تغير_النص(حقل_الاسم، عند_تغير_الاسم)
    اضف_طفل(قسم_الادخال، حقل_الاسم)
    
    # حقل كلمة المرور
    متغير حقل_كلمة_السر = حقل_كلمة_مرور("كلمة المرور")
    اضف_طفل(قسم_الادخال، حقل_كلمة_السر)
    
    # منطقة نص متعددة الأسطر
    متغير منطقة_النص = منطقة_نص("اكتب ملاحظاتك هنا...")
    اضف_طفل(قسم_الادخال، منطقة_النص)
    
    # ══════════════════════════════════════════════════════════════════════
    #  قسم التبديلات
    # ══════════════════════════════════════════════════════════════════════
    
    متغير قسم_التبديلات = بطاقة()
    اضف_طفل(الجذر، قسم_التبديلات)
    
    متغير عنوان_التبديلات = عنوان("عناصر التبديل")
    اضف_طفل(قسم_التبديلات، عنوان_التبديلات)
    
    # مربع اختيار
    متغير مربع1 = مربع_اختيار("تفعيل الإشعارات"، صحيح)
    اضف_طفل(قسم_التبديلات، مربع1)
    
    متغير مربع2 = مربع_اختيار("الوضع الليلي"، خطأ)
    اضف_طفل(قسم_التبديلات، مربع2)
    
    # مفتاح تبديل
    متغير مفتاح1 = مفتاح("تفعيل الموقع"، صحيح)
    اضف_طفل(قسم_التبديلات، مفتاح1)
    
    # أزرار راديو
    متغير صف_راديو = صف()
    اضف_طفل(قسم_التبديلات، صف_راديو)
    
    متغير راديو1 = زر_راديو("خيار أ"، "مجموعة1"، صحيح)
    متغير راديو2 = زر_راديو("خيار ب"، "مجموعة1"، خطأ)
    متغير راديو3 = زر_راديو("خيار ج"، "مجموعة1"، خطأ)
    اضف_طفل(صف_راديو، راديو1)
    اضف_طفل(صف_راديو، راديو2)
    اضف_طفل(صف_راديو، راديو3)
    
    # ══════════════════════════════════════════════════════════════════════
    #  قسم المنزلقات
    # ══════════════════════════════════════════════════════════════════════
    
    متغير قسم_المنزلقات = بطاقة()
    اضف_طفل(الجذر، قسم_المنزلقات)
    
    متغير عنوان_المنزلقات = عنوان("المنزلقات وأشرطة التقدم")
    اضف_طفل(قسم_المنزلقات، عنوان_المنزلقات)
    
    # منزلق
    متغير نص_منزلق = نص("مستوى الصوت: 50%")
    اضف_طفل(قسم_المنزلقات، نص_منزلق)
    
    متغير منزلق1 = منزلق(0، 100، 50)
    عند_تغير_القيمة(منزلق1، عند_تغير_الصوت)
    اضف_طفل(قسم_المنزلقات، منزلق1)
    
    # شريط تقدم
    متغير نص_تقدم = نص("جاري التحميل...")
    اضف_طفل(قسم_المنزلقات، نص_تقدم)
    
    متغير تقدم1 = شريط_تقدم(0.7)
    اضف_طفل(قسم_المنزلقات، تقدم1)
    
    # شريط تقدم دائري
    متغير تقدم_دائري = شريط_تقدم_دائري(0.45)
    اضف_طفل(قسم_المنزلقات، تقدم_دائري)
    
    # ══════════════════════════════════════════════════════════════════════
    #  قسم القوائم
    # ══════════════════════════════════════════════════════════════════════
    
    متغير قسم_القوائم = بطاقة()
    اضف_طفل(الجذر، قسم_القوائم)
    
    متغير عنوان_القوائم = عنوان("القوائم والتحديد")
    اضف_طفل(قسم_القوائم، عنوان_القوائم)
    
    # قائمة منسدلة
    متغير قائمة1 = قائمة_منسدلة(["خيار 1"، "خيار 2"، "خيار 3"، "خيار 4"])
    اضف_طفل(قسم_القوائم، قائمة1)
    
    # رقائق
    متغير صف_رقائق = صف()
    اضف_طفل(قسم_القوائم، صف_رقائق)
    
    متغير رقاقة1 = رقاقة("تقنية"، صحيح)
    متغير رقاقة2 = رقاقة("تصميم"، خطأ)
    متغير رقاقة3 = رقاقة("برمجة"، صحيح)
    اضف_طفل(صف_رقائق، رقاقة1)
    اضف_طفل(صف_رقائق، رقاقة2)
    اضف_طفل(صف_رقائق، رقاقة3)
    
    # تعيين الجذر
    عين_الجذر(الجذر)
نهاية

# ══════════════════════════════════════════════════════════════════════════
#  معالجات الأحداث
# ══════════════════════════════════════════════════════════════════════════

دالة زد_العداد()
    العداد = العداد + 1
    اطبع_سطر("العداد: " + العداد)
نهاية

دالة انقص_العداد()
    العداد = العداد - 1
    اطبع_سطر("العداد: " + العداد)
نهاية

دالة عند_تغير_الاسم(نص_جديد)
    الاسم = نص_جديد
    اطبع_سطر("الاسم: " + الاسم)
نهاية

دالة عند_تغير_الصوت(قيمة)
    اطبع_سطر("مستوى الصوت: " + قيمة + "%")
نهاية

