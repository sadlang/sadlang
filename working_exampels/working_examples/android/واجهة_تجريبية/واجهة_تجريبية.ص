# ══════════════════════════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("═══════════════════════════════════════════")
    اطبع_سطر("  تطبيق تجريبي للنظام الرسومي الثوري")
    اطبع_سطر("  Revolutionary Graphics System Demo")
    اطبع_سطر("═══════════════════════════════════════════")
    
    # تهيئة النظام الرسومي
    اطبع_سطر("تهيئة النظام الرسومي...")
    
    # بناء الواجهة
    بناء_الواجهة()
    
    # بدء حلقة التحديث
    اطبع_سطر("الواجهة جاهزة!")
نهاية

