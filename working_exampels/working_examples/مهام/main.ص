# تطبيق المهام المبسط - Sad Tasks App
# ═══════════════════════════════════════════════════════════════════════════

# قائمة المهام
متغير المهام = []
متغير عدد_المهام = 0

# ═══════════════════════════════════════════════════════════════════════════
# دوال إدارة المهام
# ═══════════════════════════════════════════════════════════════════════════

دالة أضف_مهمة()
    اطبع_سطر("")
    اطبع("أدخل عنوان المهمة: ")
    متغير العنوان = اقرأ_سطر()
    
    عدد_المهام = عدد_المهام + 1
    اطبع_سطر("تمت إضافة المهمة: " + العنوان)
    اطبع_سطر("رقم المهمة: " + نص(عدد_المهام))
نهاية

دالة اعرض_المهام()
    اطبع_سطر("")
    اطبع_سطر("-------------------------------")
    اطبع_سطر("       قائمة المهام")
    اطبع_سطر("-------------------------------")
    
    إذا (عدد_المهام == 0)
        اطبع_سطر("  لا توجد مهام حالياً")
    وإلا
        اطبع_سطر("  عدد المهام: " + نص(عدد_المهام))
    نهاية
    
    اطبع_سطر("-------------------------------")
نهاية

دالة احذف_مهمة()
    اطبع_سطر("")
    
    إذا (عدد_المهام > 0)
        عدد_المهام = عدد_المهام - 1
        اطبع_سطر("تم حذف المهمة")
        اطبع_سطر("المهام المتبقية: " + نص(عدد_المهام))
    وإلا
        اطبع_سطر("لا توجد مهام للحذف")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# القائمة الرئيسية
# ═══════════════════════════════════════════════════════════════════════════

دالة اعرض_القائمة()
    اطبع_سطر("")
    اطبع_سطر("========================================")
    اطبع_سطر("         تطبيق المهام")
    اطبع_سطر("========================================")
    اطبع_سطر("  1. عرض المهام")
    اطبع_سطر("  2. إضافة مهمة")
    اطبع_سطر("  3. حذف مهمة")
    اطبع_سطر("  4. خروج")
    اطبع_سطر("========================================")
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# البرنامج الرئيسي
# ═══════════════════════════════════════════════════════════════════════════

اطبع_سطر("")
اطبع_سطر("========================================")
اطبع_سطر("      تطبيق المهام - لغة ص")
اطبع_سطر("========================================")

متغير مستمر = صحيح

بينما (مستمر)
    اعرض_القائمة()
    
    اطبع("اختيارك: ")
    متغير الاختيار = اقرأ_سطر()
    
    إذا (الاختيار == "1")
        اعرض_المهام()
    وإلا إذا (الاختيار == "2")
        أضف_مهمة()
    وإلا إذا (الاختيار == "3")
        احذف_مهمة()
    وإلا إذا (الاختيار == "4")
        اطبع_سطر("شكرا لاستخدام تطبيق المهام!")
        مستمر = خطأ
    وإلا
        اطبع_سطر("اختيار غير صحيح")
    نهاية
نهاية
