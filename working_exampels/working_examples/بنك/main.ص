# ═══════════════════════════════════════════════════════════════════════════
# تطبيق البنك المبسط - Sad Bank App
# ═══════════════════════════════════════════════════════════════════════════

# بيانات المستخدمين
متغير رصيد_أحمد = 15000
متغير رصيد_فاطمة = 25000
متغير رصيد_محمد = 50000

متغير المستخدم_الحالي = ""
متغير الرصيد_الحالي = 0

# ═══════════════════════════════════════════════════════════════════════════
# دوال تسجيل الدخول
# ═══════════════════════════════════════════════════════════════════════════

دالة تسجيل_دخول()
    اطبع_سطر("")
    اطبع_سطر("========================================")
    اطبع_سطر("          تسجيل الدخول")
    اطبع_سطر("========================================")
    اطبع_سطر("المستخدمون المتاحون: أحمد، فاطمة، محمد")
    اطبع_سطر("")
    
    اطبع("اسم المستخدم: ")
    متغير الاسم = اقرأ_سطر()
    
    اطبع("كلمة المرور: ")
    متغير كلمة_السر = اقرأ_سطر()
    
    إذا (الاسم == "أحمد" && كلمة_السر == "1234")
        المستخدم_الحالي = "أحمد"
        الرصيد_الحالي = رصيد_أحمد
        ارجع صحيح
    نهاية
    
    إذا (الاسم == "فاطمة" && كلمة_السر == "5678")
        المستخدم_الحالي = "فاطمة"
        الرصيد_الحالي = رصيد_فاطمة
        ارجع صحيح
    نهاية
    
    إذا (الاسم == "محمد" && كلمة_السر == "9999")
        المستخدم_الحالي = "محمد"
        الرصيد_الحالي = رصيد_محمد
        ارجع صحيح
    نهاية
    
    اطبع_سطر("خطأ: اسم المستخدم أو كلمة المرور غير صحيحة")
    ارجع خطأ
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# دوال العمليات البنكية
# ═══════════════════════════════════════════════════════════════════════════

دالة اعرض_الرصيد()
    اطبع_سطر("")
    اطبع_سطر("-------------------------------")
    اطبع_سطر("  رصيدك الحالي: " + نص(الرصيد_الحالي) + " ريال")
    اطبع_سطر("-------------------------------")
نهاية

دالة إيداع()
    اطبع_سطر("")
    اطبع("أدخل مبلغ الإيداع: ")
    متغير المبلغ_نص = اقرأ_سطر()
    متغير المبلغ = عدد(المبلغ_نص)
    
    إذا (المبلغ > 0)
        الرصيد_الحالي = الرصيد_الحالي + المبلغ
        اطبع_سطر("تم الإيداع بنجاح!")
        اعرض_الرصيد()
    وإلا
        اطبع_سطر("خطأ: المبلغ غير صحيح")
    نهاية
نهاية

دالة سحب()
    اطبع_سطر("")
    اطبع("أدخل مبلغ السحب: ")
    متغير المبلغ_نص = اقرأ_سطر()
    متغير المبلغ = عدد(المبلغ_نص)
    
    إذا (المبلغ > 0 && المبلغ <= الرصيد_الحالي)
        الرصيد_الحالي = الرصيد_الحالي - المبلغ
        اطبع_سطر("تم السحب بنجاح!")
        اعرض_الرصيد()
    وإلا
        اطبع_سطر("خطأ: الرصيد غير كافي أو المبلغ غير صحيح")
    نهاية
نهاية

دالة تحويل()
    اطبع_سطر("")
    اطبع("أدخل اسم المستفيد: ")
    متغير المستفيد = اقرأ_سطر()
    
    اطبع("أدخل المبلغ: ")
    متغير المبلغ_نص = اقرأ_سطر()
    متغير المبلغ = عدد(المبلغ_نص)
    
    إذا (المبلغ > 0 && المبلغ <= الرصيد_الحالي)
        الرصيد_الحالي = الرصيد_الحالي - المبلغ
        اطبع_سطر("تم التحويل إلى " + المستفيد + " بنجاح!")
        اعرض_الرصيد()
    وإلا
        اطبع_سطر("خطأ: الرصيد غير كافي")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# القائمة الرئيسية
# ═══════════════════════════════════════════════════════════════════════════

دالة اعرض_القائمة()
    اطبع_سطر("")
    اطبع_سطر("========================================")
    اطبع_سطر("  مرحباً " + المستخدم_الحالي)
    اطبع_سطر("========================================")
    اطبع_سطر("  1. عرض الرصيد")
    اطبع_سطر("  2. إيداع")
    اطبع_سطر("  3. سحب")
    اطبع_سطر("  4. تحويل")
    اطبع_سطر("  5. خروج")
    اطبع_سطر("========================================")
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# البرنامج الرئيسي
# ═══════════════════════════════════════════════════════════════════════════

اطبع_سطر("")
اطبع_سطر("========================================")
اطبع_سطر("      بنك ص - خدماتك المصرفية")
اطبع_سطر("========================================")

متغير دخول_ناجح = تسجيل_دخول()

إذا (دخول_ناجح)
    متغير مستمر = صحيح
    
    بينما (مستمر)
        اعرض_القائمة()
        
        اطبع("اختيارك: ")
        متغير الاختيار = اقرأ_سطر()
        
        إذا (الاختيار == "1")
            اعرض_الرصيد()
        وإلا إذا (الاختيار == "2")
            إيداع()
        وإلا إذا (الاختيار == "3")
            سحب()
        وإلا إذا (الاختيار == "4")
            تحويل()
        وإلا إذا (الاختيار == "5")
            اطبع_سطر("شكرا لاستخدام بنك ص!")
            مستمر = خطأ
        وإلا
            اطبع_سطر("اختيار غير صحيح")
        نهاية
    نهاية
نهاية
