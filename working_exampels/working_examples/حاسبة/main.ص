# محرك الحساب
# ═══════════════════════════════════════════════════════════════════════════

دالة نفذ_عملية(أ, عملية, ب)
    إذا (عملية == "+")
        ارجع أ + ب
    نهاية
    إذا (عملية == "-")
        ارجع أ - ب
    نهاية
    إذا (عملية == "*")
        ارجع أ * ب
    نهاية
    إذا (عملية == "/")
        إذا (ب == 0)
            اطبع_سطر("خطأ: لا يمكن القسمة على صفر")
            ارجع 0
        نهاية
        ارجع أ / ب
    نهاية
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# واجهة العرض  
# ═══════════════════════════════════════════════════════════════════════════

دالة اعرض_القائمة()
    اطبع_سطر("-------------------------------")
    اطبع_سطر("        الحاسبة العربية        ")
    اطبع_سطر("-------------------------------")
    اطبع_سطر("  +  جمع      -  طرح          ")
    اطبع_سطر("  *  ضرب      /  قسمة         ")
    اطبع_سطر("  0  خروج                     ")
    اطبع_سطر("-------------------------------")
نهاية

دالة اعرض_نتيجة(النتيجة)
    اطبع_سطر("-------------------------------")
    اطبع_سطر("  النتيجة: " + نص(النتيجة))
    اطبع_سطر("-------------------------------")
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# البرنامج الرئيسي
# ═══════════════════════════════════════════════════════════════════════════

اطبع_سطر("")
اطبع_سطر("========================================")
اطبع_سطر("     الحاسبة العربية - لغة ص           ")
اطبع_سطر("========================================")
اطبع_سطر("")

اعرض_القائمة()

متغير مستمر = صحيح

بينما (مستمر)
    اطبع_سطر("")
    اطبع("ادخل الرقم الاول: ")
    متغير رقم1_نص = اقرأ_سطر()
    
    إذا (رقم1_نص == "0")
        اطبع_سطر("شكرا لاستخدام الحاسبة!")
        مستمر = خطأ
        تابع
    نهاية
    
    متغير رقم1 = عدد(رقم1_نص)
    
    اطبع("ادخل العملية (+ - * /): ")
    متغير العملية = اقرأ_سطر()
    
    اطبع("ادخل الرقم الثاني: ")
    متغير رقم2_نص = اقرأ_سطر()
    متغير رقم2 = عدد(رقم2_نص)
    
    متغير النتيجة = نفذ_عملية(رقم1, العملية, رقم2)
    
    اعرض_نتيجة(النتيجة)
نهاية
