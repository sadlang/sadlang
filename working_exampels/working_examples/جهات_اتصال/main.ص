# عدد جهات الاتصال
متغير عدد_الجهات = 5

# ═══════════════════════════════════════════════════════════════════════════
# دوال عرض جهات الاتصال
# ═══════════════════════════════════════════════════════════════════════════

دالة اعرض_الجهات()
    اطبع_سطر("")
    اطبع_سطر("-------------------------------")
    اطبع_سطر("      جهات الاتصال")
    اطبع_سطر("-------------------------------")
    اطبع_سطر("  1. أحمد محمد - 0501234567")
    اطبع_سطر("  2. فاطمة علي - 0559876543")
    اطبع_سطر("  3. خالد سعود - 0545556677")
    اطبع_سطر("  4. نورة عبدالله - 0533334444")
    اطبع_سطر("  5. محمد إبراهيم - 0522221111")
    اطبع_سطر("-------------------------------")
    اطبع_سطر("  إجمالي: " + نص(عدد_الجهات) + " جهات")
    اطبع_سطر("-------------------------------")
نهاية

دالة أضف_جهة()
    اطبع_سطر("")
    اطبع("أدخل الاسم: ")
    متغير الاسم = اقرأ_سطر()
    
    اطبع("أدخل رقم الهاتف: ")
    متغير الهاتف = اقرأ_سطر()
    
    عدد_الجهات = عدد_الجهات + 1
    اطبع_سطر("تمت إضافة جهة الاتصال: " + الاسم)
    اطبع_سطر("إجمالي الجهات: " + نص(عدد_الجهات))
نهاية

دالة بحث_جهة()
    اطبع_سطر("")
    اطبع("ابحث عن: ")
    متغير البحث = اقرأ_سطر()
    
    إذا (البحث == "أحمد")
        اطبع_سطر("وجد: أحمد محمد - 0501234567")
    وإلا إذا (البحث == "فاطمة")
        اطبع_سطر("وجد: فاطمة علي - 0559876543")
    وإلا إذا (البحث == "خالد")
        اطبع_سطر("وجد: خالد سعود - 0545556677")
    وإلا إذا (البحث == "نورة")
        اطبع_سطر("وجد: نورة عبدالله - 0533334444")
    وإلا إذا (البحث == "محمد")
        اطبع_سطر("وجد: محمد إبراهيم - 0522221111")
    وإلا
        اطبع_سطر("لم يتم العثور على جهة بهذا الاسم")
    نهاية
نهاية

دالة احذف_جهة()
    اطبع_سطر("")
    
    إذا (عدد_الجهات > 0)
        عدد_الجهات = عدد_الجهات - 1
        اطبع_سطر("تم حذف جهة الاتصال")
        اطبع_سطر("الجهات المتبقية: " + نص(عدد_الجهات))
    وإلا
        اطبع_سطر("لا توجد جهات للحذف")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# القائمة الرئيسية
# ═══════════════════════════════════════════════════════════════════════════

دالة اعرض_القائمة()
    اطبع_سطر("")
    اطبع_سطر("========================================")
    اطبع_سطر("         جهات الاتصال")
    اطبع_سطر("========================================")
    اطبع_سطر("  1. عرض الجهات")
    اطبع_سطر("  2. إضافة جهة")
    اطبع_سطر("  3. بحث")
    اطبع_سطر("  4. حذف جهة")
    اطبع_سطر("  5. خروج")
    اطبع_سطر("========================================")
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# البرنامج الرئيسي
# ═══════════════════════════════════════════════════════════════════════════

اطبع_سطر("")
اطبع_سطر("========================================")
اطبع_سطر("     جهات الاتصال - لغة ص")
اطبع_سطر("========================================")

متغير مستمر = صحيح

بينما (مستمر)
    اعرض_القائمة()
    
    اطبع("اختيارك: ")
    متغير الاختيار = اقرأ_سطر()
    
    إذا (الاختيار == "1")
        اعرض_الجهات()
    وإلا إذا (الاختيار == "2")
        أضف_جهة()
    وإلا إذا (الاختيار == "3")
        بحث_جهة()
    وإلا إذا (الاختيار == "4")
        احذف_جهة()
    وإلا إذا (الاختيار == "5")
        اطبع_سطر("شكرا لاستخدام تطبيق جهات الاتصال!")
        مستمر = خطأ
    وإلا
        اطبع_سطر("اختيار غير صحيح")
    نهاية
نهاية
