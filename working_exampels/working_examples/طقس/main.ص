# تطبيق الطقس المبسط - Sad Weather App
# ═══════════════════════════════════════════════════════════════════════════

# بيانات الطقس للمدن
متغير حرارة_الرياض = 32
متغير حرارة_جدة = 28
متغير حرارة_مكة = 35
متغير حرارة_الدمام = 26

# ═══════════════════════════════════════════════════════════════════════════
# دوال عرض الطقس
# ═══════════════════════════════════════════════════════════════════════════

دالة اعرض_طقس_مدينة(المدينة, الحرارة)
    اطبع_سطر("")
    اطبع_سطر("-------------------------------")
    اطبع_سطر("  المدينة: " + المدينة)
    اطبع_سطر("  الحرارة: " + نص(الحرارة) + " درجة مئوية")
    
    إذا (الحرارة > 30)
        اطبع_سطر("  الجو: حار")
    وإلا إذا (الحرارة > 20)
        اطبع_سطر("  الجو: معتدل")
    وإلا
        اطبع_سطر("  الجو: بارد")
    نهاية
    
    اطبع_سطر("-------------------------------")
نهاية

دالة اعرض_كل_المدن()
    اطبع_سطر("")
    اطبع_سطر("-------------------------------")
    اطبع_سطر("      طقس المدن السعودية")
    اطبع_سطر("-------------------------------")
    اطبع_سطر("  الرياض: " + نص(حرارة_الرياض) + " درجة")
    اطبع_سطر("  جدة: " + نص(حرارة_جدة) + " درجة")
    اطبع_سطر("  مكة: " + نص(حرارة_مكة) + " درجة")
    اطبع_سطر("  الدمام: " + نص(حرارة_الدمام) + " درجة")
    اطبع_سطر("-------------------------------")
نهاية

دالة بحث_مدينة()
    اطبع_سطر("")
    اطبع("أدخل اسم المدينة: ")
    متغير المدينة = اقرأ_سطر()
    
    إذا (المدينة == "الرياض")
        اعرض_طقس_مدينة("الرياض", حرارة_الرياض)
    وإلا إذا (المدينة == "جدة")
        اعرض_طقس_مدينة("جدة", حرارة_جدة)
    وإلا إذا (المدينة == "مكة")
        اعرض_طقس_مدينة("مكة", حرارة_مكة)
    وإلا إذا (المدينة == "الدمام")
        اعرض_طقس_مدينة("الدمام", حرارة_الدمام)
    وإلا
        اطبع_سطر("المدينة غير موجودة")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# القائمة الرئيسية
# ═══════════════════════════════════════════════════════════════════════════

دالة اعرض_القائمة()
    اطبع_سطر("")
    اطبع_سطر("========================================")
    اطبع_سطر("           تطبيق الطقس")
    اطبع_سطر("========================================")
    اطبع_سطر("  1. طقس الرياض")
    اطبع_سطر("  2. طقس كل المدن")
    اطبع_سطر("  3. بحث عن مدينة")
    اطبع_سطر("  4. خروج")
    اطبع_سطر("========================================")
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# البرنامج الرئيسي
# ═══════════════════════════════════════════════════════════════════════════

اطبع_سطر("")
اطبع_سطر("========================================")
اطبع_سطر("      تطبيق الطقس - لغة ص")
اطبع_سطر("========================================")

متغير مستمر = صحيح

بينما (مستمر)
    اعرض_القائمة()
    
    اطبع("اختيارك: ")
    متغير الاختيار = اقرأ_سطر()
    
    إذا (الاختيار == "1")
        اعرض_طقس_مدينة("الرياض", حرارة_الرياض)
    وإلا إذا (الاختيار == "2")
        اعرض_كل_المدن()
    وإلا إذا (الاختيار == "3")
        بحث_مدينة()
    وإلا إذا (الاختيار == "4")
        اطبع_سطر("شكرا لاستخدام تطبيق الطقس!")
        مستمر = خطأ
    وإلا
        اطبع_سطر("اختيار غير صحيح")
    نهاية
نهاية
