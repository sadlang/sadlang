دالة رئيسية()
    # === اختبار FFI في المفسر ===
    printf("=== اختبار FFI في المفسر ===\n")
    
    # اختبار printf مع تنسيق
    printf("رقم: %d\n"، 42)
    printf("نص: %s\n"، "مرحبا بالعالم")
    
    # اختبار malloc/free  
    متغير ذاكرة = malloc(256)
    printf("حجز ذاكرة: نجح\n")
    free(ذاكرة)
    printf("تحرير ذاكرة: نجح\n")
    
    # اختبار strlen
    متغير طول1 = strlen("Hello World")
    printf("طول النص: %d\n"، طول1)
    
    # اختبار strcmp
    متغير مقارنة = strcmp("abc"، "abc")
    printf("مقارنة متطابقة: %d\n"، مقارنة)
    
    # اختبار strcat
    متغير ملحق = strcat("مرحبا "، "بالعالم")
    printf("إلحاق: %s\n"، ملحق)
    
    # اختبار atoi
    متغير عدد = atoi("12345")
    printf("تحويل نص لعدد: %d\n"، عدد)
    
    # اختبار atof
    متغير رقم_عشري = atof("3.14")
    printf("تحويل نص لعشري: %f\n"، رقم_عشري)
    
    # اختبار getenv
    متغير مسار = getenv("PATH")
    printf("متغير البيئة PATH: موجود\n")
    
    # اختبار snprintf
    متغير منسق = snprintf("الاسم: %s، العمر: %d"، "أحمد"، 25)
    printf("نص منسق: %s\n"، منسق)
    
    # اختبار system
    system("echo اختبار system نجح")
    
    printf("=== جميع اختبارات FFI نجحت! ===\n")
نهاية
