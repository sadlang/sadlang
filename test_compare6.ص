من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد تعبير، م_بحث

## اختبار مباشر: متى يعود م_بحث لاشيء؟
متغير نمط = "<.+?>"
متغير نص_م = "<مرحبا><عالم>"
متغير أعلام = 0

متغير تع = جديد تعبير(نمط، أعلام)
متغير مح = تع.المحرك
متغير عدد = تع.عدد_المجموعات
متغير الأعلام = تع.الأعلام

## مباشرة
متغير جواب1 = م_بحث(مح، عدد، الأعلام، نص_م)
اطبع("م_بحث مباشرة == لاشيء؟ ")
اطبع_سطر(جواب1 == لاشيء)

## عبر الـmethod
متغير جواب2 = تع.بحث(نص_م)
اطبع("تع.بحث() == لاشيء؟ ")
اطبع_سطر(جواب2 == لاشيء)
