## Test if م = هذا creates reference or copy

صنف أداة
    رقم قيمة

    باني(رقم ق)
        هذا.قيمة = ق
    نهاية

    دالة قيمة_هذا()
        ارجع هذا.قيمة
    نهاية

    دالة عمل()
        متغير م = هذا
        م.قيمة = 99
        ارجع م.قيمة
    نهاية

    دالة اختبار_مرجع()
        متغير م = هذا
        م.قيمة = 55
        # Now check هذا.قيمة — if reference, should be 55; if copy, stays original
        ارجع هذا.قيمة
    نهاية
نهاية

متغير أ = جديد أداة(10)
اطبع("قيمة أولية: ")
اطبع_سطر(أ.قيمة)

متغير نتيجة = أ.عمل()
اطبع("نتيجة عمل(): ")
اطبع_سطر(نتيجة)

اطبع("قيمة بعد عمل(): ")
اطبع_سطر(أ.قيمة)

متغير نتيجة2 = أ.اختبار_مرجع()
اطبع("نتيجة اختبار_مرجع(): ")
اطبع_سطر(نتيجة2)
اطبع("قيمة هذا بعد م.قيمة=55: ")
اطبع_سطر(أ.قيمة)
