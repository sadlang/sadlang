# اختبار دوال الأمان في المترجم sadc
# Test security functions in sadc compiler

دالة رئيسية()
    اطبع_سطر("=== اختبار الأمان في المترجم ===")
    
    # تأكد — assert
    متغير س = 10
    تأكد(س == 10)
    اطبع_سطر("تأكد(س == 10) — نجح")
    
    # تحقق — verify (returns bool)
    متغير ن1 = تحقق(5 > 3)
    اطبع_سطر("تحقق(5 > 3) نجح")
    
    متغير ن2 = تحقق(1 > 100)
    اطبع_سطر("تحقق(1 > 100) نجح")
    
    # هاش
    متغير هاش1 = هاش("مرحبا")
    اطبع_سطر("هاش مرحبا نجح")
    
    # شفّر وفك_تشفير
    متغير مشفر = شفّر("سري" ، "مفتاح")
    اطبع_سطر("تشفير نجح")
    
    متغير نص1 = فك_تشفير(مشفر ، "مفتاح")
    اطبع_سطر("فك تشفير نجح")
    
    # نظّف
    متغير نظيف = نظّف("<script>خطير</script>")
    اطبع_سطر("تنظيف نجح")
    
    # وقت_الآن
    متغير وقت1 = وقت_الآن()
    اطبع_سطر("وقت الآن نجح")
    
    # عشوائي_آمن
    متغير عشوائي1 = عشوائي_آمن(1 ، 100)
    اطبع_سطر("عشوائي آمن نجح")
    
    # ترميز_64
    متغير ب64 = ترميز_64("مرحبا")
    اطبع_سطر("ترميز 64 نجح")
    
    اطبع_سطر("=== جميع اختبارات الأمان نجحت! ===")
نهاية
