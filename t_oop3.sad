صنف مربع
    عام
        رقم الضلع
        
        باني(رقم ض)
            الضلع = ض
        نهاية
        
        دالة رقم المساحة()
            ارجع الضلع * الضلع
        نهاية
        
        دالة رقم المحيط()
            ارجع الضلع * 4
        نهاية
نهاية

دالة رئيسية()
    متغير م = جديد مربع(5)
    اطبع("المساحة: ")
    اطبع_سطر(م.المساحة())
    اطبع("المحيط: ")
    اطبع_سطر(م.المحيط())
    ارجع 0
نهاية
