    متغير w_value = 512 + config_idx   # 0x0200
    usb_build_setup(setup، 128، 6، w_value، 0، buf_len)
    ارجع uhci_control_transfer(hc_idx، dev_addr، setup، buf، buf_len، 1) + 0
