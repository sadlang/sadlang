صدّر دالة uhci_td_actual_len(td_addr)
    متغير st = uhci_td_get_status(td_addr) + 0
    # bits 0-10 = actual length (ActLen + 1, or 0x7FF for none)
    متغير actlen = st % 2048   # 0x7FF mask
    إذا (actlen == 2047)
        ارجع 0
    نهاية
    ارجع actlen + 1
