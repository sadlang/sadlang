صدّر دالة uhci_td_has_error(td_addr)
    متغير st = uhci_td_get_status(td_addr) + 0
    # check bits 17-22 for errors
    متغير stalled = (st / UHCI_TD_STALLED) % 2
    متغير dbuf = (st / UHCI_TD_DBUF_ERR) % 2
    متغير babble = (st / UHCI_TD_BABBLE) % 2
    متغير crc = (st / UHCI_TD_CRC_ERR) % 2
    متغير bitstuff = (st / UHCI_TD_BITSTUFF) % 2
    إذا (stalled + dbuf + babble + crc + bitstuff > 0)
        ارجع 1
    نهاية
    ارجع 0
