# ═══════════════════════════════════════════════════════════════════════════════
# Bulk Transfer (for mass storage)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_bulk_transfer(hc_idx، dev_addr، endpoint، buf، buf_len، is_in)
    uhci_total_transfers = uhci_total_transfers + 1
    uhci_reset_td_pool(hc_idx)

    متغير qh = uhci_get_qh_pool(hc_idx) + 0
    إذا (qh == 0)
        uhci_transfer_errors = uhci_transfer_errors + 1
        ارجع 0 - 1
    نهاية

    متغير pid = UHCI_PID_OUT + 0
    إذا (is_in == 1)
        pid = UHCI_PID_IN + 0
    نهاية

    متغير first_td = 0 + 0
    متغير last_td = 0 + 0
    متغير toggle = 0 + 0
    متغير remaining = buf_len + 0
    متغير offset = 0 + 0
    متغير max_pkt = 8 + 0

    بينما (remaining > 0)
        متغير td = uhci_alloc_td(hc_idx) + 0
        إذا (td == 0)
            uhci_transfer_errors = uhci_transfer_errors + 1
            ارجع 0 - 1
        نهاية

        إذا (first_td == 0)
            first_td = td + 0
        نهاية
        إذا (last_td != 0)
            uhci_td_set_link(last_td، td، 0، 0)
        نهاية

        متغير pkt = remaining + 0
        إذا (pkt > max_pkt)
            pkt = max_pkt + 0
        نهاية

        uhci_td_set_status(td، 1، 0، 0، 3)
        uhci_td_set_token(td، pid، dev_addr، endpoint، toggle، pkt)
        uhci_td_set_buffer(td، buf + offset)

        last_td = td + 0
        offset = offset + pkt
        remaining = remaining - pkt
        toggle = 1 - toggle
    نهاية

    # IOC on last TD
    إذا (last_td != 0)
        متغير st = uhci_td_get_status(last_td) + 0
        sad_ll_mem_write32(last_td + 4، st + UHCI_TD_IOC)
        uhci_td_set_link(last_td، 0، 1، 0)
    نهاية

    # QH setup
    uhci_qh_set_head_link(qh، 0، 1)
    uhci_qh_set_element(qh، first_td، 0)

    # Frame list
    متغير framelist = uhci_get_framelist(hc_idx) + 0
    sad_ll_mem_write32(framelist، qh + 2)

    # Start
    uhci_write16(hc_idx، UHCI_FRNUM، 0)
    uhci_write16(hc_idx، UHCI_USBCMD، UHCI_CMD_RS + UHCI_CMD_MAXP)

    # Wait
    متغير timeout = 50000 + 0
    بينما (timeout > 0)
        إذا (last_td != 0)
            إذا (uhci_td_is_active(last_td) == 0)
                uhci_write16(hc_idx، UHCI_USBCMD، 0)
                sad_ll_mem_write32(framelist، 1)

                إذا (uhci_td_has_error(last_td) == 1)
                    uhci_transfer_errors = uhci_transfer_errors + 1
                    ارجع 0 - 2
                نهاية

                # Count actual data
                متغير total = 0 + 0
                متغير ct = first_td + 0
                متغير cc = 0
                بينما (cc < 64)
                    total = total + uhci_td_actual_len(ct)
                    إذا (ct == last_td)
                        cc = 64
                    والا
                        ct = ct + 32
                        cc = cc + 1
                    نهاية
                نهاية
                ارجع total + 0
            نهاية
        نهاية
        timeout = timeout - 1
    نهاية

    uhci_write16(hc_idx، UHCI_USBCMD، 0)
    sad_ll_mem_write32(framelist، 1)
    uhci_transfer_errors = uhci_transfer_errors + 1
    ارجع 0 - 5
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# Interrupt Transfer (for HID)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_interrupt_transfer(hc_idx، dev_addr، endpoint، buf، buf_len)
    uhci_total_transfers = uhci_total_transfers + 1
    uhci_reset_td_pool(hc_idx)

    متغير qh = uhci_get_qh_pool(hc_idx) + 0
    إذا (qh == 0)
        uhci_transfer_errors = uhci_transfer_errors + 1
        ارجع 0 - 1
    نهاية

    # Single IN TD for interrupt
    متغير td = uhci_alloc_td(hc_idx) + 0
    إذا (td == 0)
        uhci_transfer_errors = uhci_transfer_errors + 1
        ارجع 0 - 1
    نهاية

    uhci_td_set_status(td، 1، 1، 0، 3)  # active, IOC, 3 retries
    uhci_td_set_token(td، UHCI_PID_IN، dev_addr، endpoint، 0، buf_len)
    uhci_td_set_buffer(td، buf)
    uhci_td_set_link(td، 0، 1، 0)

    uhci_qh_set_head_link(qh، 0، 1)
    uhci_qh_set_element(qh، td، 0)

    متغير framelist = uhci_get_framelist(hc_idx) + 0
    sad_ll_mem_write32(framelist، qh + 2)

    uhci_write16(hc_idx، UHCI_FRNUM، 0)
    uhci_write16(hc_idx، UHCI_USBCMD، UHCI_CMD_RS + UHCI_CMD_MAXP)

    # Short timeout for interrupt
    متغير timeout = 5000 + 0
    بينما (timeout > 0)
        إذا (uhci_td_is_active(td) == 0)
            uhci_write16(hc_idx، UHCI_USBCMD، 0)
            sad_ll_mem_write32(framelist، 1)

            إذا (uhci_td_has_error(td) == 1)
                # NAK is normal for interrupt endpoints
                متغير st = uhci_td_get_status(td) + 0
                متغير nak = (st / UHCI_TD_NAK) % 2
                إذا (nak == 1)
                    ارجع 0  # No data available
                نهاية
                uhci_transfer_errors = uhci_transfer_errors + 1
                ارجع 0 - 2
            نهاية

            ارجع uhci_td_actual_len(td) + 0
        نهاية
        timeout = timeout - 1
    نهاية

    uhci_write16(hc_idx، UHCI_USBCMD، 0)
    sad_ll_mem_write32(framelist، 1)
    ارجع 0  # timeout = no data
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تعداد جهاز على منفذ UHCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_enumerate_device(hc_idx، port_num)
    uhci_serial_اطبع("[UHCI] Enumerating device on HC#")
    uhci_serial_رقم(hc_idx + 0)
    uhci_serial_اطبع(" port ")
    uhci_serial_رقم(port_num + 0)
    uhci_serial_سطر()

    # تحديد السرعة
    متغير speed = 1 + 0
    إذا (port_num == 0)
        إذا (hc_idx == 0) speed = uhci_port1_speed_0 + 0 نهاية
        إذا (hc_idx == 1) speed = uhci_port1_speed_1 + 0 نهاية
        إذا (hc_idx == 2) speed = uhci_port1_speed_2 + 0 نهاية
        إذا (hc_idx == 3) speed = uhci_port1_speed_3 + 0 نهاية
    والا
        إذا (hc_idx == 0) speed = uhci_port2_speed_0 + 0 نهاية
        إذا (hc_idx == 1) speed = uhci_port2_speed_1 + 0 نهاية
        إذا (hc_idx == 2) speed = uhci_port2_speed_2 + 0 نهاية
        إذا (hc_idx == 3) speed = uhci_port2_speed_3 + 0 نهاية
    نهاية

    # تسجيل جهاز جديد
    متغير dev_idx = usb_register_device(hc_idx، port_num، speed) + 0
    إذا (dev_idx < 0)
        ارجع 0 - 1
    نهاية

    # الخطوة 1: قراءة أول 8 بايتات من واصفة الجهاز (عنوان 0)
    متغير data_buf = uhci_get_data_buf(hc_idx) + 0
    sad_ll_memset(data_buf، 0، 64)

    متغير result = uhci_get_device_descriptor(hc_idx، 0، data_buf، 8) + 0
    إذا (result < 0)
        uhci_serial_اطبع("[UHCI] Failed to get initial descriptor")
        uhci_serial_سطر()
        ارجع 0 - 2
    نهاية

    # تحديث maxPacketSize0
    متغير maxpkt = sad_ll_mem_read8(data_buf + 7) + 0
    إذا (maxpkt > 0)
        uhci_serial_اطبع("[UHCI] maxPacketSize0=")
        uhci_serial_رقم(maxpkt + 0)
        uhci_serial_سطر()
    نهاية

    # الخطوة 2: تعيين عنوان
    متغير new_addr = dev_idx + 1
    result = uhci_set_address(hc_idx، 0، new_addr) + 0
    إذا (result < 0)
        uhci_serial_اطبع("[UHCI] SET_ADDRESS failed")
        uhci_serial_سطر()
        ارجع 0 - 3
    نهاية

    # انتظار استقرار بعد SET_ADDRESS
    متغير wait = sad_ll_timer_get_ticks() + 0
    بينما (sad_ll_timer_get_ticks() - wait < 200)
        متغير d = 0
    نهاية

    uhci_serial_اطبع("[UHCI] Device addressed as ")
    uhci_serial_رقم(new_addr + 0)
    uhci_serial_سطر()

    # الخطوة 3: قراءة واصفة الجهاز الكاملة (18 بايت)
    sad_ll_memset(data_buf، 0، 64)
    result = uhci_get_device_descriptor(hc_idx، new_addr، data_buf، 18) + 0
    إذا (result >= 8)
        usb_parse_device_descriptor(data_buf، dev_idx)
    نهاية

    # الخطوة 4: قراءة واصفة التكوين
    sad_ll_memset(data_buf، 0، 256)
    result = uhci_get_config_descriptor(hc_idx، new_addr، 0، data_buf، 9) + 0
    إذا (result >= 4)
        # wTotalLength في bytes 2-3
        متغير total_lo = sad_ll_mem_read8(data_buf + 2) + 0
        متغير total_hi = sad_ll_mem_read8(data_buf + 3) + 0
        متغير total_len = total_hi * 256 + total_lo

        إذا (total_len > 0)
            إذا (total_len > 256)
                total_len = 256
            نهاية
            sad_ll_memset(data_buf، 0، 256)
            result = uhci_get_config_descriptor(hc_idx، new_addr، 0، data_buf، total_len) + 0
            إذا (result > 0)
                usb_parse_config_descriptor(data_buf، total_len، dev_idx)
            نهاية
        نهاية
    نهاية

    # الخطوة 5: تعيين التكوين (عادة config=1)
    result = uhci_set_configuration(hc_idx، new_addr، 1) + 0
    إذا (result < 0)
        uhci_serial_اطبع("[UHCI] SET_CONFIG failed (non-fatal)")
        uhci_serial_سطر()
    نهاية

    # تصنيف الجهاز
    usb_classify_device(dev_idx)

    uhci_serial_اطبع("[UHCI] Device enumeration complete")
    uhci_serial_سطر()

    ارجع dev_idx + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# فحص المنافذ
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_scan_ports(hc_idx)
    uhci_serial_اطبع("[UHCI] Scanning ports on HC#")
    uhci_serial_رقم(hc_idx + 0)
    uhci_serial_سطر()

    # المنفذ 1
    متغير sc1 = uhci_read16(hc_idx، UHCI_PORTSC1) + 0
    متغير connected1 = sc1 % 2
    متغير csc1 = (sc1 / 2) % 2  # bit 1

    إذا (connected1 == 1)
        uhci_serial_اطبع("[UHCI] Port 1: device connected")
        uhci_serial_سطر()
        uhci_port_reset(hc_idx، 0)
        uhci_enumerate_device(hc_idx، 0)
    والا
        uhci_serial_اطبع("[UHCI] Port 1: no device")
        uhci_serial_سطر()
    نهاية

    # مسح CSC
    إذا (csc1 == 1)
        uhci_write16(hc_idx، UHCI_PORTSC1، UHCI_PORT_CSC)
    نهاية

    # المنفذ 2
    متغير sc2 = uhci_read16(hc_idx، UHCI_PORTSC2) + 0
    متغير connected2 = sc2 % 2
    متغير csc2 = (sc2 / 2) % 2

    إذا (connected2 == 1)
        uhci_serial_اطبع("[UHCI] Port 2: device connected")
        uhci_serial_سطر()
        uhci_port_reset(hc_idx، 1)
        uhci_enumerate_device(hc_idx، 1)
    والا
        uhci_serial_اطبع("[UHCI] Port 2: no device")
        uhci_serial_سطر()
    نهاية

    إذا (csc2 == 1)
        uhci_write16(hc_idx، UHCI_PORTSC2، UHCI_PORT_CSC)
    نهاية

    ارجع connected1 + connected2
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تقرير UHCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_تقرير()
    uhci_serial_اطبع("═══ [UHCI] تقرير ═══")
    uhci_serial_سطر()

    uhci_serial_اطبع("  متحكمات UHCI: ")
    uhci_serial_رقم(uhci_count + 0)
    uhci_serial_سطر()

    uhci_serial_اطبع("  عمليات النقل: ")
    uhci_serial_رقم(uhci_total_transfers + 0)
    uhci_serial_سطر()

    uhci_serial_اطبع("  أخطاء: ")
    uhci_serial_رقم(uhci_transfer_errors + 0)
    uhci_serial_سطر()

    uhci_serial_اطبع("  إعادة تعيين منافذ: ")
    uhci_serial_رقم(uhci_port_resets + 0)
    uhci_serial_سطر()

    متغير i = 0 + 0
    بينما (i < uhci_count)
        متغير base = uhci_get_base(i) + 0
        متغير st = uhci_get_status(i) + 0
        uhci_serial_اطبع("  HC#")
        uhci_serial_رقم(i + 0)
        uhci_serial_اطبع(" base=0x")
        uhci_serial_hex16(base + 0)
        uhci_serial_اطبع(" status=")
        uhci_serial_رقم(st + 0)
        uhci_serial_سطر()
        i = i + 1
    نهاية

    uhci_serial_اطبع("═══════════════════════════════════")
    uhci_serial_سطر()
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تهيئة UHCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_هيئ(hc_idx، io_base)
    uhci_serial_اطبع("[UHCI] تهيئة UHCI HC#")
    uhci_serial_رقم(hc_idx + 0)
    uhci_serial_اطبع(" base=0x")
    uhci_serial_hex16(io_base + 0)
    uhci_serial_سطر()

    إذا (uhci_count >= 4)
        uhci_serial_اطبع("[UHCI] Max controllers reached!")
        uhci_serial_سطر()
        ارجع 0
    نهاية

    uhci_set_base(hc_idx، io_base)

    # تخصيص ذاكرة
    # Frame List: 1024 entries × 4 bytes = 4096 bytes (aligned to 4K)
    متغير fl = sad_ll_kmalloc(4096) + 0
    uhci_set_framelist(hc_idx، fl)

    # QH Pool: 16 × 16 bytes = 256 bytes
    متغير qhp = sad_ll_kmalloc(512) + 0
    uhci_set_qh_pool(hc_idx، qhp)

    # TD Pool: 32 × 32 bytes = 1024 bytes
    متغير tdp = sad_ll_kmalloc(1024) + 0
    uhci_set_td_pool(hc_idx، tdp)

    # Data buffer: 512 bytes
    متغير dbuf = sad_ll_kmalloc(512) + 0
    uhci_set_data_buf(hc_idx، dbuf)

    # Setup buffer: 16 bytes
    متغير sbuf = sad_ll_kmalloc(32) + 0
    uhci_set_setup_buf(hc_idx، sbuf)

    # إعادة تعيين المتحكم
    uhci_reset(hc_idx)

    # تهيئة Frame List — كل الإدخالات terminate
    متغير i = 0 + 0
    بينما (i < UHCI_FRAME_COUNT)
        sad_ll_mem_write32(fl + (i * 4)، 1)  # T bit = terminate
        i = i + 1
    نهاية

    # تعيين عنوان Frame List
    uhci_write32(hc_idx، UHCI_FRBASEADD، fl)

    # تعيين رقم الإطار الحالي
    uhci_write16(hc_idx، UHCI_FRNUM، 0)

    # تعيين SOF interval (default = 64)
    متغير base = uhci_get_base(hc_idx) + 0
    sad_ll_port_outb(base + UHCI_SOFMOD، 64)

    # مسح حالة الأخطاء
    uhci_write16(hc_idx، UHCI_USBSTS، 63)  # 0x3F clear all

    # تفعيل المقاطعات
    uhci_write16(hc_idx، UHCI_USBINTR، 15)  # 0x0F all interrupts

    # تشغيل المتحكم
    uhci_write16(hc_idx، UHCI_USBCMD، UHCI_CMD_RS + UHCI_CMD_CF + UHCI_CMD_MAXP)

    uhci_set_status(hc_idx، 2)  # running
    uhci_count = uhci_count + 1

    uhci_serial_اطبع("[UHCI] HC initialized and running")
    uhci_serial_سطر()

    # فحص المنافذ
    uhci_scan_ports(hc_idx)

    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# دورة UHCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_دورة()
    # فحص تغييرات الاتصال في المنافذ
    متغير i = 0 + 0
    بينما (i < uhci_count)
        متغير base = uhci_get_base(i) + 0

        # فحص المنفذ 1
        متغير sc1 = uhci_read16(i، UHCI_PORTSC1) + 0
        متغير csc1 = (sc1 / 2) % 2
        إذا (csc1 == 1)
            uhci_serial_اطبع("[UHCI] Port 1 change detected HC#")
            uhci_serial_رقم(i + 0)
            uhci_serial_سطر()
            uhci_write16(i، UHCI_PORTSC1، UHCI_PORT_CSC)
        نهاية

        # فحص المنفذ 2
        متغير sc2 = uhci_read16(i، UHCI_PORTSC2) + 0
        متغير csc2 = (sc2 / 2) % 2
        إذا (csc2 == 1)
            uhci_serial_اطبع("[UHCI] Port 2 change detected HC#")
            uhci_serial_رقم(i + 0)
            uhci_serial_سطر()
            uhci_write16(i، UHCI_PORTSC2، UHCI_PORT_CSC)
        نهاية

        # فحص حالة الأخطاء
        متغير sts = uhci_read16(i، UHCI_USBSTS) + 0
        إذا ((sts / 2) % 2 == 1)  # Error bit
            uhci_serial_اطبع("[UHCI] Error interrupt HC#")
            uhci_serial_رقم(i + 0)
            uhci_serial_سطر()
            uhci_interrupts = uhci_interrupts + 1
            uhci_write16(i، UHCI_USBSTS، UHCI_STS_ERROR)
        نهاية

        إذا ((sts / UHCI_STS_HSE) % 2 == 1)
            uhci_serial_اطبع("[UHCI] Host System Error HC#")
            uhci_serial_رقم(i + 0)
            uhci_serial_سطر()
            uhci_write16(i، UHCI_USBSTS، UHCI_STS_HSE)
        نهاية

        i = i + 1
    نهاية
    ارجع 0
نهاية
