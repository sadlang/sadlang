# ═══════════════════════════════════════════════════════════════════════════════
# إعادة تعيين المتحكم
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_reset(hc_idx)
    uhci_serial_اطبع("[UHCI] Resetting HC #")
    uhci_serial_رقم(hc_idx + 0)
    uhci_serial_سطر()

    # Global Reset
    uhci_write16(hc_idx، UHCI_USBCMD، UHCI_CMD_GRESET)

    # انتظار ~50ms (5000 ticks تقريباً)
    متغير wait_start = sad_ll_timer_get_ticks() + 0
    بينما (sad_ll_timer_get_ticks() - wait_start < 5000)
        متغير dummy = 0 + 0
    نهاية

    uhci_write16(hc_idx، UHCI_USBCMD، 0)

    # HC Reset
    uhci_write16(hc_idx، UHCI_USBCMD، UHCI_CMD_HCRESET)

    # انتظار انتهاء الإعادة
    متغير timeout = 100 + 0
    بينما (timeout > 0)
        متغير cmd = uhci_read16(hc_idx، UHCI_USBCMD) + 0
        إذا ((cmd % 4) / 2 == 0)  # bit 1 = HCRESET cleared
            uhci_serial_اطبع("[UHCI] Reset complete")
            uhci_serial_سطر()
            ارجع 1
        نهاية
        timeout = timeout - 1
        متغير w2 = sad_ll_timer_get_ticks() + 0
        بينما (sad_ll_timer_get_ticks() - w2 < 100)
            متغير d2 = 0
        نهاية
    نهاية

    uhci_serial_اطبع("[UHCI] Reset timeout!")
    uhci_serial_سطر()
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# بناء Transfer Descriptor (TD) — 16 بايت
# ═══════════════════════════════════════════════════════════════════════════════
# TD Structure (4 DWORDs, 16 bytes each, aligned):
#   DWORD 0: Link Pointer (next TD or QH, bit 0=T terminate, bit 1=QH)
#   DWORD 1: Control & Status
#   DWORD 2: Token (PID, device addr, endpoint, data toggle, max length)
#   DWORD 3: Buffer Pointer

صدّر دالة uhci_td_set_link(td_addr، next_td، terminate، is_qh)
    متغير val = next_td + 0
    إذا (terminate == 1)
        val = 1  # T bit = terminate
    نهاية
    إذا (is_qh == 1)
        val = val + 2  # QH bit
    نهاية
    sad_ll_mem_write32(td_addr، val)
    ارجع 0
نهاية

صدّر دالة uhci_td_set_status(td_addr، active، ioc، ls_dev، cerr_count)
    # Control & Status (DWORD 1)
    # bits 23     = Active
    # bits 24     = IOC
    # bits 26     = LS
    # bits 27-28  = error count (cerr, 2 bits)
    # bits 29     = SPD
    متغير val = 0 + 0
    إذا (active == 1)
        val = val + UHCI_TD_ACTIVE
    نهاية
    إذا (ioc == 1)
        val = val + UHCI_TD_IOC
    نهاية
    إذا (ls_dev == 1)
        val = val + UHCI_TD_LS
    نهاية
    # cerr count في bits 27-28
    val = val + (cerr_count * 134217728)  # 0x08000000 = bit 27
    sad_ll_mem_write32(td_addr + 4، val)
    ارجع 0
نهاية

صدّر دالة uhci_td_set_token(td_addr، pid، dev_addr، endpoint، toggle، max_len)
    # Token (DWORD 2):
    # bits 0-7:   PID
    # bits 8-14:  Device Address (7 bits)
    # bits 15-18: Endpoint (4 bits)
    # bit 19:     Data Toggle
    # bits 21-31: MaxLen (11 bits, actual_len - 1, 0x7FF for 0 bytes)
    متغير val = pid + 0
    val = val + (dev_addr * 256)          # shift left 8
    val = val + (endpoint * 32768)        # shift left 15 = 0x8000
    إذا (toggle == 1)
        val = val + 524288                # bit 19 = 0x80000
    نهاية
    # MaxLen: actual_len - 1 (0x7FF = null packet)
    متغير ml = 0 + 0
    إذا (max_len > 0)
        ml = max_len - 1
    والا
        ml = 2047                         # 0x7FF for zero-length
    نهاية
    val = val + (ml * 2097152)            # shift left 21 = 0x200000
    sad_ll_mem_write32(td_addr + 8، val)
    ارجع 0
نهاية

صدّر دالة uhci_td_set_buffer(td_addr، buf_phys)
