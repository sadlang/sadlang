    # GET_DESCRIPTOR: bmReqType=0x80, bRequest=6, wValue=0x0100, wIndex=0, wLength
    usb_build_setup(setup، 128، 6، 256، 0، buf_len)
    ارجع uhci_control_transfer(hc_idx، dev_addr، setup، buf، buf_len، 1) + 0
