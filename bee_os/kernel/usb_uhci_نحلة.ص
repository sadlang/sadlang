# ═══════════════════════════════════════════════════════════════════════════════
# ثوابت UHCI
# ═══════════════════════════════════════════════════════════════════════════════
ثابت COM1 = 1016

# سجلات UHCI I/O (إزاحة من العنوان القاعدي)
ثابت UHCI_USBCMD    = 0      # 0x00 - USB Command (R/W, 16-bit)
ثابت UHCI_USBSTS    = 2      # 0x02 - USB Status (R/WC, 16-bit)
ثابت UHCI_USBINTR   = 4      # 0x04 - USB Interrupt Enable (R/W, 16-bit)
ثابت UHCI_FRNUM     = 6      # 0x06 - Frame Number (R/W, 16-bit)
ثابت UHCI_FRBASEADD = 8      # 0x08 - Frame List Base Address (R/W, 32-bit)
ثابت UHCI_SOFMOD    = 12     # 0x0C - Start of Frame Modify (R/W, 8-bit)
ثابت UHCI_PORTSC1   = 16     # 0x10 - Port 1 Status/Control (R/WC, 16-bit)
ثابت UHCI_PORTSC2   = 18     # 0x12 - Port 2 Status/Control (R/WC, 16-bit)

# USBCMD بتات
ثابت UHCI_CMD_RS         = 1      # Run/Stop (1=Run)
ثابت UHCI_CMD_HCRESET    = 2      # Host Controller Reset
ثابت UHCI_CMD_GRESET     = 4      # Global Reset
ثابت UHCI_CMD_EGSM       = 8      # Enter Global Suspend Mode
ثابت UHCI_CMD_FGR        = 16     # 0x10 Force Global Resume
ثابت UHCI_CMD_SWDBG      = 32     # 0x20 Software Debug
ثابت UHCI_CMD_CF         = 64     # 0x40 Configure Flag
ثابت UHCI_CMD_MAXP       = 128    # 0x80 Max Packet (0=32, 1=64)

# USBSTS بتات
ثابت UHCI_STS_USBINT     = 1      # USB Interrupt
ثابت UHCI_STS_ERROR      = 2      # USB Error Interrupt
ثابت UHCI_STS_RD         = 4      # Resume Detect
ثابت UHCI_STS_HSE        = 8      # Host System Error
ثابت UHCI_STS_HCPE       = 16     # 0x10 HC Process Error
ثابت UHCI_STS_HCH        = 32     # 0x20 HC Halted

# PORTSC بتات
ثابت UHCI_PORT_CONNECT    = 1      # Current Connect Status
ثابت UHCI_PORT_CSC        = 2      # Connect Status Change
ثابت UHCI_PORT_ENABLE     = 4      # Port Enable
ثابت UHCI_PORT_ENC        = 8      # Port Enable Change
ثابت UHCI_PORT_LS_LO      = 16     # 0x10 Line Status D- (bit 4)
ثابت UHCI_PORT_LS_HI      = 32     # 0x20 Line Status D+ (bit 5)
ثابت UHCI_PORT_RD         = 64     # 0x40 Resume Detect
ثابت UHCI_PORT_LSDA       = 256    # 0x100 Low Speed Device Attached
ثابت UHCI_PORT_RESET      = 512    # 0x200 Port Reset
ثابت UHCI_PORT_SUSP       = 4096   # 0x1000 Suspend

# TD (Transfer Descriptor) بتات
ثابت UHCI_TD_ACTIVE       = 8388608    # 0x800000 - bit 23
ثابت UHCI_TD_STALLED      = 4194304    # 0x400000 - bit 22
ثابت UHCI_TD_DBUF_ERR     = 2097152    # 0x200000 - bit 21
ثابت UHCI_TD_BABBLE       = 1048576    # 0x100000 - bit 20
ثابت UHCI_TD_NAK          = 524288     # 0x080000 - bit 19
ثابت UHCI_TD_CRC_ERR      = 262144     # 0x040000 - bit 18
ثابت UHCI_TD_BITSTUFF     = 131072     # 0x020000 - bit 17
ثابت UHCI_TD_IOC          = 16777216   # 0x01000000 - bit 24 (Interrupt on Complete)
ثابت UHCI_TD_IOS          = 33554432   # 0x02000000 - bit 25 (Isochronous Select)
ثابت UHCI_TD_LS           = 67108864   # 0x04000000 - bit 26 (Low Speed)
ثابت UHCI_TD_SPD          = 536870912  # 0x20000000 - bit 29 (Short Packet Detect)

# PID tokens
ثابت UHCI_PID_SETUP = 45    # 0x2D
ثابت UHCI_PID_IN    = 105   # 0x69
ثابت UHCI_PID_OUT   = 225   # 0xE1

# عدد الإطارات (Frame List)
ثابت UHCI_FRAME_COUNT = 1024


