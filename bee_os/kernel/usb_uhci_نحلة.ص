صدّر دالة uhci_td_is_active(td_addr)
    متغير st = uhci_td_get_status(td_addr) + 0
    # bit 23 = Active
    متغير bit23 = (st / UHCI_TD_ACTIVE) % 2
    ارجع bit23 + 0
