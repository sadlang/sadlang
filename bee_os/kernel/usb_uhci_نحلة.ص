# ═══════════════════════════════════════════════════════════════════════════════
# تخصيص TD من Pool
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_alloc_td(hc_idx)
    متغير used = 0 + 0
    إذا (hc_idx == 0) used = uhci_td_used_0 + 0 نهاية
    إذا (hc_idx == 1) used = uhci_td_used_1 + 0 نهاية
    إذا (hc_idx == 2) used = uhci_td_used_2 + 0 نهاية
    إذا (hc_idx == 3) used = uhci_td_used_3 + 0 نهاية

    إذا (used >= 32)
        ارجع 0
    نهاية

    متغير pool = uhci_get_td_pool(hc_idx) + 0
    متغير td_addr = pool + (used * 32)  # 32-byte aligned TDs

    # مسح TD
    sad_ll_mem_write32(td_addr، 1)       # link = terminate
    sad_ll_mem_write32(td_addr + 4، 0)   # status = 0
    sad_ll_mem_write32(td_addr + 8، 0)   # token = 0
    sad_ll_mem_write32(td_addr + 12، 0)  # buffer = 0

    # تحديث العداد
    إذا (hc_idx == 0) uhci_td_used_0 = used + 1 نهاية
    إذا (hc_idx == 1) uhci_td_used_1 = used + 1 نهاية
    إذا (hc_idx == 2) uhci_td_used_2 = used + 1 نهاية
    إذا (hc_idx == 3) uhci_td_used_3 = used + 1 نهاية

    ارجع td_addr + 0
نهاية

صدّر دالة uhci_reset_td_pool(hc_idx)
    إذا (hc_idx == 0) uhci_td_used_0 = 0 نهاية
    إذا (hc_idx == 1) uhci_td_used_1 = 0 نهاية
    إذا (hc_idx == 2) uhci_td_used_2 = 0 نهاية
    إذا (hc_idx == 3) uhci_td_used_3 = 0 نهاية
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إعادة تعيين منفذ
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_port_reset(hc_idx، port_num)
    uhci_serial_اطبع("[UHCI] Port reset HC#")
    uhci_serial_رقم(hc_idx + 0)
    uhci_serial_اطبع(" port ")
    uhci_serial_رقم(port_num + 0)
    uhci_serial_سطر()

    متغير port_reg = UHCI_PORTSC1 + 0
    إذا (port_num == 1)
        port_reg = UHCI_PORTSC2 + 0
    نهاية

    uhci_port_resets = uhci_port_resets + 1

    # قراءة الحالة الحالية
    متغير sc = uhci_read16(hc_idx، port_reg) + 0

    # تعيين بت الإعادة
    uhci_write16(hc_idx، port_reg، sc + UHCI_PORT_RESET)

    # انتظار 50ms
    متغير wait = sad_ll_timer_get_ticks() + 0
    بينما (sad_ll_timer_get_ticks() - wait < 5000)
        متغير d = 0
    نهاية

    # إزالة بت الإعادة
    sc = uhci_read16(hc_idx، port_reg) + 0
    # مسح bit 9 (RESET) — القيمة بدون UHCI_PORT_RESET
    متغير new_sc = sc % UHCI_PORT_RESET
    uhci_write16(hc_idx، port_reg، new_sc)

    # انتظار قصير
    متغير wait2 = sad_ll_timer_get_ticks() + 0
    بينما (sad_ll_timer_get_ticks() - wait2 < 1000)
        متغير d2 = 0
    نهاية

    # تفعيل المنفذ والتأكد من مسح CSC و ENC
    sc = uhci_read16(hc_idx، port_reg) + 0
    uhci_write16(hc_idx، port_reg، UHCI_PORT_ENABLE + UHCI_PORT_CSC + UHCI_PORT_ENC)

    # انتظار تثبيت
    متغير wait3 = sad_ll_timer_get_ticks() + 0
    بينما (sad_ll_timer_get_ticks() - wait3 < 500)
        متغير d3 = 0
    نهاية

    # قراءة الحالة النهائية
    sc = uhci_read16(hc_idx، port_reg) + 0
    متغير connected = sc % 2         # bit 0
    متغير enabled = (sc / 4) % 2     # bit 2
    متغير low_speed = (sc / 256) % 2 # bit 8 (LSDA)

    uhci_serial_اطبع("[UHCI] Port status: connect=")
    uhci_serial_رقم(connected + 0)
    uhci_serial_اطبع(" enabled=")
    uhci_serial_رقم(enabled + 0)
    uhci_serial_اطبع(" lowspeed=")
    uhci_serial_رقم(low_speed + 0)
    uhci_serial_سطر()

    إذا (connected == 1)
        # تحديث حالة المنفذ
        متغير speed = 1 + 0  # Full speed
        إذا (low_speed == 1)
            speed = 0  # Low speed
        نهاية

        إذا (port_num == 0)
            إذا (hc_idx == 0) uhci_port1_connected_0 = 1 نهاية
            إذا (hc_idx == 1) uhci_port1_connected_1 = 1 نهاية
            إذا (hc_idx == 2) uhci_port1_connected_2 = 1 نهاية
            إذا (hc_idx == 3) uhci_port1_connected_3 = 1 نهاية
            إذا (hc_idx == 0) uhci_port1_speed_0 = speed + 0 نهاية
            إذا (hc_idx == 1) uhci_port1_speed_1 = speed + 0 نهاية
            إذا (hc_idx == 2) uhci_port1_speed_2 = speed + 0 نهاية
            إذا (hc_idx == 3) uhci_port1_speed_3 = speed + 0 نهاية
        والا
            إذا (hc_idx == 0) uhci_port2_connected_0 = 1 نهاية
            إذا (hc_idx == 1) uhci_port2_connected_1 = 1 نهاية
            إذا (hc_idx == 2) uhci_port2_connected_2 = 1 نهاية
            إذا (hc_idx == 3) uhci_port2_connected_3 = 1 نهاية
            إذا (hc_idx == 0) uhci_port2_speed_0 = speed + 0 نهاية
            إذا (hc_idx == 1) uhci_port2_speed_1 = speed + 0 نهاية
            إذا (hc_idx == 2) uhci_port2_speed_2 = speed + 0 نهاية
            إذا (hc_idx == 3) uhci_port2_speed_3 = speed + 0 نهاية
        نهاية
    نهاية

    ارجع connected + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# نقل تحكم (Control Transfer) عبر UHCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uhci_control_transfer(hc_idx، dev_addr، setup_buf، data_buf، data_len، is_read)
    uhci_total_transfers = uhci_total_transfers + 1
    uhci_reset_td_pool(hc_idx)

    متغير ls_dev = 0 + 0  # full speed by default
    متغير qh = uhci_get_qh_pool(hc_idx) + 0
    إذا (qh == 0)
        uhci_transfer_errors = uhci_transfer_errors + 1
        ارجع 0 - 1
    نهاية

    # ─── TD 0: SETUP ───
    متغير td_setup = uhci_alloc_td(hc_idx) + 0
    إذا (td_setup == 0)
        uhci_transfer_errors = uhci_transfer_errors + 1
        ارجع 0 - 1
    نهاية

    # ─── TD 1+: DATA (if any) ───
    متغير td_data_first = 0 + 0
    متغير td_data_last = 0 + 0
    متغير toggle = 1 + 0  # DATA stage starts with DATA1
    متغير remaining = data_len + 0
    متغير buf_offset = 0 + 0
    متغير pid = UHCI_PID_IN + 0
    إذا (is_read == 0)
        pid = UHCI_PID_OUT + 0
    نهاية

    بينما (remaining > 0)
        متغير td_data = uhci_alloc_td(hc_idx) + 0
        إذا (td_data == 0)
            uhci_transfer_errors = uhci_transfer_errors + 1
            ارجع 0 - 1
        نهاية

        إذا (td_data_first == 0)
            td_data_first = td_data + 0
        نهاية
        إذا (td_data_last != 0)
            uhci_td_set_link(td_data_last، td_data، 0، 0)
        نهاية

        متغير pkt_len = remaining + 0
        إذا (pkt_len > 8)
            pkt_len = 8
        نهاية

        uhci_td_set_status(td_data، 1، 0، ls_dev، 3)
        uhci_td_set_token(td_data، pid، dev_addr، 0، toggle، pkt_len)
        uhci_td_set_buffer(td_data، data_buf + buf_offset)

        td_data_last = td_data + 0
        buf_offset = buf_offset + pkt_len
        remaining = remaining - pkt_len
        toggle = 1 - toggle  # alternate toggle
    نهاية

    # ─── TD STATUS: handshake ───
    متغير td_status = uhci_alloc_td(hc_idx) + 0
    إذا (td_status == 0)
        uhci_transfer_errors = uhci_transfer_errors + 1
        ارجع 0 - 1
    نهاية

    متغير status_pid = UHCI_PID_OUT + 0
    إذا (is_read == 0)
        status_pid = UHCI_PID_IN + 0
    نهاية

    uhci_td_set_status(td_status، 1، 1، ls_dev، 3)  # IOC=1
    uhci_td_set_token(td_status، status_pid، dev_addr، 0، 1، 0)  # toggle=1, len=0
    uhci_td_set_buffer(td_status، 0)
    uhci_td_set_link(td_status، 0، 1، 0)  # terminate

    # ─── ربط السلسلة ───
    # Setup TD → first data TD → ... → status TD
    uhci_td_set_status(td_setup، 1، 0، ls_dev، 3)
    uhci_td_set_token(td_setup، UHCI_PID_SETUP، dev_addr، 0، 0، 8)  # toggle=0, len=8
    uhci_td_set_buffer(td_setup، setup_buf)

    إذا (td_data_first != 0)
        uhci_td_set_link(td_setup، td_data_first، 0، 0)
        uhci_td_set_link(td_data_last، td_status، 0، 0)
    والا
        uhci_td_set_link(td_setup، td_status، 0، 0)
    نهاية

    # ─── تعيين QH ───
    uhci_qh_set_head_link(qh، 0، 1)      # no next QH
    uhci_qh_set_element(qh، td_setup، 0)  # first TD

    # ─── تعيين Frame List entry 0 للإشارة إلى QH ───
    متغير framelist = uhci_get_framelist(hc_idx) + 0
    sad_ll_mem_write32(framelist، qh + 2)  # QH bit set

    # ─── تشغيل المتحكم ───
    uhci_write16(hc_idx، UHCI_FRNUM، 0)
    uhci_write16(hc_idx، UHCI_USBCMD، UHCI_CMD_RS + UHCI_CMD_MAXP)

    # ─── انتظار الاكتمال ───
    متغير timeout = 10000 + 0
    بينما (timeout > 0)
        # التحقق من اكتمال TD الأخير (Status TD)
        متغير active = uhci_td_is_active(td_status) + 0
        إذا (active == 0)
            # إيقاف المتحكم
            uhci_write16(hc_idx، UHCI_USBCMD، 0)

            # التحقق من الأخطاء
            إذا (uhci_td_has_error(td_setup) == 1)
                uhci_serial_اطبع("[UHCI] SETUP TD error")
                uhci_serial_سطر()
                uhci_transfer_errors = uhci_transfer_errors + 1
                ارجع 0 - 2
            نهاية

            إذا (uhci_td_has_error(td_status) == 1)
                uhci_serial_اطبع("[UHCI] STATUS TD error")
                uhci_serial_سطر()
                uhci_transfer_errors = uhci_transfer_errors + 1
                ارجع 0 - 3
            نهاية

            # حساب البيانات المنقولة فعلياً
            متغير total_actual = 0 + 0
            إذا (td_data_first != 0)
                متغير check_td = td_data_first + 0
                متغير check_count = 0 + 0
                بينما (check_count < 16)
                    إذا (uhci_td_has_error(check_td) == 1)
                        uhci_serial_اطبع("[UHCI] DATA TD error")
                        uhci_serial_سطر()
                        uhci_transfer_errors = uhci_transfer_errors + 1
                        ارجع 0 - 4
                    نهاية
                    total_actual = total_actual + uhci_td_actual_len(check_td)
                    إذا (check_td == td_data_last)
                        check_count = 16  # خروج
                    والا
                        check_td = check_td + 32  # next TD
                        check_count = check_count + 1
                    نهاية
                نهاية
            نهاية

            # إعادة Frame List entry إلى terminate
            sad_ll_mem_write32(framelist، 1)

            ارجع total_actual + 0
        نهاية

        timeout = timeout - 1
    نهاية

    # Timeout
    uhci_write16(hc_idx، UHCI_USBCMD، 0)
    sad_ll_mem_write32(framelist، 1)
    uhci_serial_اطبع("[UHCI] Transfer timeout!")
    uhci_serial_سطر()
    uhci_transfer_errors = uhci_transfer_errors + 1
    ارجع 0 - 5
نهاية

