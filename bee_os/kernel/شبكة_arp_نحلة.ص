## إرسال ARP Request لعنوان IP معين
صدّر دالة arp_send_request(target_ip)
    # Build full Ethernet frame: header + ARP packet
    متغير frame_size = ETH_HEADER_SIZE + ARP_PKT_SIZE
    متغير frame = sad_ll_kmalloc(frame_size + 32) + 0
    إذا (frame == 0)
        ارجع 0
    نهاية
    
    # Ethernet header — broadcast destination
    sad_ll_mem_write8(frame، 255)      # FF
    sad_ll_mem_write8(frame + 1، 255)
    sad_ll_mem_write8(frame + 2، 255)
    sad_ll_mem_write8(frame + 3، 255)
    sad_ll_mem_write8(frame + 4، 255)
    sad_ll_mem_write8(frame + 5، 255)
    
    # Source MAC
    sad_ll_mem_write8(frame + 6، local_mac_0)
    sad_ll_mem_write8(frame + 7، local_mac_1)
    sad_ll_mem_write8(frame + 8، local_mac_2)
    sad_ll_mem_write8(frame + 9، local_mac_3)
    sad_ll_mem_write8(frame + 10، local_mac_4)
    sad_ll_mem_write8(frame + 11، local_mac_5)
    
    # EtherType = ARP (0x0806)
    sad_ll_mem_write8(frame + 12، 8)    # 0x08
    sad_ll_mem_write8(frame + 13، 6)    # 0x06
    
    # ARP packet (target MAC = 00:00:00:00:00:00)
    arp_build_packet(frame + ETH_HEADER_SIZE، ARP_REQUEST، target_ip، 0، 0)
    
    # Send via NIC — يجب استدعاء net_send من شبكة_نحلة
    # هنا نفترض وجود دالة عامة للإرسال
    # net_send(frame, frame_size) — ستُربط عند التجميع
    
    arp_طلبات_مرسلة = arp_طلبات_مرسلة + 1
    
    arp_serial_اطبع("[ARP] Request sent for ")
    arp_serial_رقم(ip_byte(target_ip، 0))
    sad_ll_serial_write_char(COM1، 46)
    arp_serial_رقم(ip_byte(target_ip، 1))
    sad_ll_serial_write_char(COM1، 46)
    arp_serial_رقم(ip_byte(target_ip، 2))
    sad_ll_serial_write_char(COM1، 46)
    arp_serial_رقم(ip_byte(target_ip، 3))
    sad_ll_serial_write_char(COM1، 10)
    
    sad_ll_kfree(frame)
    ارجع 1
نهاية

## إرسال ARP Reply
صدّر دالة arp_send_reply(target_ip، target_mac_h، target_mac_l)
    متغير frame_size = ETH_HEADER_SIZE + ARP_PKT_SIZE
    متغير frame = sad_ll_kmalloc(frame_size + 32) + 0
    إذا (frame == 0)
        ارجع 0
    نهاية
    
    # Ethernet header — unicast to target
    sad_ll_mem_write8(frame، mac_unpack(target_mac_h، 0))
    sad_ll_mem_write8(frame + 1، mac_unpack(target_mac_h، 1))
    sad_ll_mem_write8(frame + 2، mac_unpack(target_mac_h، 2))
    sad_ll_mem_write8(frame + 3، mac_unpack(target_mac_l، 0))
    sad_ll_mem_write8(frame + 4، mac_unpack(target_mac_l، 1))
    sad_ll_mem_write8(frame + 5، mac_unpack(target_mac_l، 2))
    
    # Source MAC
    sad_ll_mem_write8(frame + 6، local_mac_0)
    sad_ll_mem_write8(frame + 7، local_mac_1)
    sad_ll_mem_write8(frame + 8، local_mac_2)
    sad_ll_mem_write8(frame + 9، local_mac_3)
    sad_ll_mem_write8(frame + 10، local_mac_4)
    sad_ll_mem_write8(frame + 11، local_mac_5)
    
    # EtherType = ARP
    sad_ll_mem_write8(frame + 12، 8)
    sad_ll_mem_write8(frame + 13، 6)
    
    # ARP Reply
    arp_build_packet(frame + ETH_HEADER_SIZE، ARP_REPLY، target_ip، target_mac_h، target_mac_l)
    
    arp_ردود_مرسلة = arp_ردود_مرسلة + 1
    
    sad_ll_kfree(frame)
    ارجع 1
