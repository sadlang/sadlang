## البحث عن IP في الجدول
صدّر دالة arp_lookup(ip_target)
    متغير ت = 0
    بينما (ت < 16)
        متغير st = arp_get_state(ت) + 0
        إذا (st == ARP_RESOLVED)
            متغير ip = arp_get_ip(ت) + 0
            إذا (ip == ip_target)
                arp_cache_hits = arp_cache_hits + 1
                ارجع ت   # found!
            نهاية
        نهاية
        إذا (st == ARP_PERMANENT)
            متغير ip2 = arp_get_ip(ت) + 0
            إذا (ip2 == ip_target)
                arp_cache_hits = arp_cache_hits + 1
                ارجع ت
            نهاية
