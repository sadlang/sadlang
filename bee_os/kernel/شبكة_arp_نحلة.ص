## معالجة حزمة ARP من إطار Ethernet مستقبل
صدّر دالة arp_handle_packet(pkt_addr، pkt_len)
    إذا (pkt_len < ARP_PKT_SIZE)
        ارجع 0
    نهاية
    
    # ARP starts after Ethernet header
    متغير arp = pkt_addr + ETH_HEADER_SIZE
    
    # Read opcode (offset 6-7, big-endian)
    متغير op_hi = sad_ll_mem_read8(arp + 6) + 0
    متغير op_lo = sad_ll_mem_read8(arp + 7) + 0
    متغير opcode = (op_hi * 256) + op_lo
    
    # Read sender MAC (offset 8-13)
    متغير s_mac_0 = sad_ll_mem_read8(arp + 8) + 0
    متغير s_mac_1 = sad_ll_mem_read8(arp + 9) + 0
    متغير s_mac_2 = sad_ll_mem_read8(arp + 10) + 0
    متغير s_mac_3 = sad_ll_mem_read8(arp + 11) + 0
    متغير s_mac_4 = sad_ll_mem_read8(arp + 12) + 0
    متغير s_mac_5 = sad_ll_mem_read8(arp + 13) + 0
    
    # Read sender IP (offset 14-17)
    متغير s_ip_0 = sad_ll_mem_read8(arp + 14) + 0
    متغير s_ip_1 = sad_ll_mem_read8(arp + 15) + 0
    متغير s_ip_2 = sad_ll_mem_read8(arp + 16) + 0
    متغير s_ip_3 = sad_ll_mem_read8(arp + 17) + 0
    
    # Read target IP (offset 24-27)
    متغير t_ip_0 = sad_ll_mem_read8(arp + 24) + 0
    متغير t_ip_1 = sad_ll_mem_read8(arp + 25) + 0
    متغير t_ip_2 = sad_ll_mem_read8(arp + 26) + 0
    متغير t_ip_3 = sad_ll_mem_read8(arp + 27) + 0
    
    متغير sender_ip = ip_to_int(s_ip_0، s_ip_1، s_ip_2، s_ip_3) + 0
    متغير sender_mac_h = mac_pack3(s_mac_0، s_mac_1، s_mac_2) + 0
    متغير sender_mac_l = mac_pack3(s_mac_3، s_mac_4، s_mac_5) + 0
    
    # Always update cache with sender info
    arp_update(sender_ip، sender_mac_h، sender_mac_l، 0)
    
    إذا (opcode == ARP_REQUEST)
        arp_طلبات_مستقبلة = arp_طلبات_مستقبلة + 1
        
        # Is it for our IP?
        إذا (t_ip_0 == local_ip_0)
            إذا (t_ip_1 == local_ip_1)
                إذا (t_ip_2 == local_ip_2)
                    إذا (t_ip_3 == local_ip_3)
                        # Yes! Send reply
                        arp_serial_اطبع("[ARP] Request for us — sending reply\n")
                        arp_send_reply(sender_ip، sender_mac_h، sender_mac_l)
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية
    
    إذا (opcode == ARP_REPLY)
        arp_ردود_مستقبلة = arp_ردود_مستقبلة + 1
        arp_serial_اطبع("[ARP] Reply received from ")
        arp_serial_رقم(s_ip_0)
        sad_ll_serial_write_char(COM1، 46)
        arp_serial_رقم(s_ip_1)
        sad_ll_serial_write_char(COM1، 46)
        arp_serial_رقم(s_ip_2)
        sad_ll_serial_write_char(COM1، 46)
        arp_serial_رقم(s_ip_3)
        sad_ll_serial_write_char(COM1، 10)
    نهاية
    
    ارجع 1
