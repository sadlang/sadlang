## بناء حزمة ARP في عنوان ذاكرة
دالة arp_build_packet(buf، opcode، target_ip، target_mac_h، target_mac_l)
    # hwtype = 1 (Ethernet) — big-endian
    sad_ll_mem_write8(buf، 0)
    sad_ll_mem_write8(buf + 1، 1)
    
    # proto = 0x0800 (IPv4) — big-endian
    sad_ll_mem_write8(buf + 2، 8)
    sad_ll_mem_write8(buf + 3، 0)
    
    # hwlen = 6
    sad_ll_mem_write8(buf + 4، 6)
    
    # protolen = 4
    sad_ll_mem_write8(buf + 5، 4)
    
    # opcode — big-endian
    sad_ll_mem_write8(buf + 6، (opcode / 256) % 256)
    sad_ll_mem_write8(buf + 7، opcode % 256)
    
    # Sender MAC (our MAC)
    sad_ll_mem_write8(buf + 8، local_mac_0)
    sad_ll_mem_write8(buf + 9، local_mac_1)
    sad_ll_mem_write8(buf + 10، local_mac_2)
    sad_ll_mem_write8(buf + 11، local_mac_3)
    sad_ll_mem_write8(buf + 12، local_mac_4)
    sad_ll_mem_write8(buf + 13، local_mac_5)
    
    # Sender IP
    sad_ll_mem_write8(buf + 14، local_ip_0)
    sad_ll_mem_write8(buf + 15، local_ip_1)
    sad_ll_mem_write8(buf + 16، local_ip_2)
    sad_ll_mem_write8(buf + 17، local_ip_3)
    
    # Target MAC
    sad_ll_mem_write8(buf + 18، mac_unpack(target_mac_h، 0))
    sad_ll_mem_write8(buf + 19، mac_unpack(target_mac_h، 1))
    sad_ll_mem_write8(buf + 20، mac_unpack(target_mac_h، 2))
    sad_ll_mem_write8(buf + 21، mac_unpack(target_mac_l، 0))
    sad_ll_mem_write8(buf + 22، mac_unpack(target_mac_l، 1))
    sad_ll_mem_write8(buf + 23، mac_unpack(target_mac_l، 2))
    
    # Target IP
    متغير tip_0 = ip_byte(target_ip، 0) + 0
    متغير tip_1 = ip_byte(target_ip، 1) + 0
    متغير tip_2 = ip_byte(target_ip، 2) + 0
    متغير tip_3 = ip_byte(target_ip، 3) + 0
    sad_ll_mem_write8(buf + 24، tip_0)
    sad_ll_mem_write8(buf + 25، tip_1)
    sad_ll_mem_write8(buf + 26، tip_2)
    sad_ll_mem_write8(buf + 27، tip_3)
    
    ارجع ARP_PKT_SIZE
نهاية

