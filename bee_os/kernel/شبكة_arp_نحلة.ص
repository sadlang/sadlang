دالة arp_serial_رقم(ن)
    إذا (ن < 0)
        sad_ll_serial_write_char(COM1، 45)
        ن = 0 - ن
    نهاية
    إذا (ن == 0)
        sad_ll_serial_write_char(COM1، 48)
        ارجع 0
    نهاية
    متغير أرقام = 0
    متغير مؤقت = ن + 0
    بينما (مؤقت > 0)
        أرقام = أرقام + 1
        مؤقت = مؤقت / 10
    نهاية
    متغير قاسم = 1
    متغير ع = 1
    بينما (ع < أرقام)
        قاسم = قاسم * 10
        ع = ع + 1
    نهاية
    بينما (قاسم > 0)
        متغير رقمي = (ن / قاسم) % 10
        sad_ll_serial_write_char(COM1، 48 + رقمي)
        قاسم = قاسم / 10
    نهاية
    ارجع 0
نهاية

