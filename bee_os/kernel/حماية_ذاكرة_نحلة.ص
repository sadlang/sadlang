# ═══════════════════════════════════════════════════════════════════════════════
# إدارة مستويات الامتياز
# ═══════════════════════════════════════════════════════════════════════════════

# التحقق من مستوى الامتياز الحالي (CPL) من سجل الأعلام
دالة فحص_مستوى_الامتياز_الحالي()
    # CPL محفوظ في بتات 0-1 من محدد CS
    # في نظامنا: إذا كنا في وضع النواة فالـ CPL = 0
    # يمكننا التحقق من خلال EFLAGS (بت IOPL)
    متغير الاعلام = sad_ll_get_eflags()
    # بتات IOPL هي 12-13 في EFLAGS
    متغير iopl = (الاعلام >> 12) & 3
    ارجع iopl
نهاية

# هل نحن في وضع النواة (حلقة 0)
دالة هل_وضع_نواة()
    متغير المستوى = فحص_مستوى_الامتياز_الحالي()
    إذا (المستوى == حلقة_نواة)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# هل نحن في وضع المستخدم (حلقة 3)
دالة هل_وضع_مستخدم()
    متغير المستوى = فحص_مستوى_الامتياز_الحالي()
    إذا (المستوى == حلقة_مستخدم)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# التحقق من صلاحية الوصول لمقطع معين
# يقارن CPL مع DPL في الواصف
دالة فحص_صلاحية_وصول(فهرس_مقطع، مستوى_طالب)
    # قراءة عرض الوصول من الواصف
    متغير وصول = قراءة_وصول_واصف(فهرس_مقطع)

    # استخراج DPL (بتات 5-6)
    متغير dpl_واصف = (وصول >> 5) & 3

    # القاعدة: CPL <= DPL (الطالب أعلى امتيازاً أو مساوٍ)
    إذا (مستوى_طالب <= dpl_واصف)
        ارجع 1
    نهاية

    # فشل الفحص — انتهاك الحماية
    ارجع 0
نهاية

# بناء محدد مقطع من الفهرس ومستوى الامتياز المطلوب والجدول
دالة بناء_محدد_مقطع(فهرس_مقطع، مستوى_rpl، فهرس_جدول)
    # المحدد = (فهرس << 3) | (فهرس_جدول << 2) | RPL
    # فهرس_جدول: 0 = GDT، 1 = LDT
    متغير المحدد = (فهرس_مقطع << 3) | (فهرس_جدول << 2) | (مستوى_rpl & 3)
    ارجع المحدد
نهاية

# تحليل محدد مقطع — استخراج الفهرس
دالة استخراج_فهرس_من_محدد(المحدد)
    ارجع (المحدد >> 3) & 8191
نهاية

# تحليل محدد مقطع — استخراج RPL
دالة استخراج_rpl_من_محدد(المحدد)
    ارجع المحدد & 3
نهاية

# تحليل محدد مقطع — استخراج فهرس الجدول (GDT/LDT)
دالة استخراج_جدول_من_محدد(المحدد)
    ارجع (المحدد >> 2) & 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# حدود ومناطق المقاطع
# ═══════════════════════════════════════════════════════════════════════════════

# التحقق من أن عنواناً معيناً ضمن حدود المقطع
دالة فحص_حدود_مقطع(فهرس_مقطع، العنوان_المطلوب)
    # قراءة القاعدة والحد
    متغير قاعدة = قراءة_قاعدة_واصف(فهرس_مقطع)
    متغير حد = قراءة_حد_واصف(فهرس_مقطع)

    # قراءة الأعلام لمعرفة التفصيلية
    متغير عنوان_واصف = عنوان_gdt + (فهرس_مقطع * ثابت_مقاس_مدخل)
    متغير دبل_علوي = mem_read_dword(عنوان_واصف + 4)
    متغير اعلام = (دبل_علوي >> 20) & 15

    # حساب الحد الفعلي
    متغير حد_فعلي = حد
    # هل التفصيلية بالصفحات (4KB)؟
    إذا ((اعلام & 8) != 0)
        حد_فعلي = (حد * 4096) + 4095
    نهاية

    # حساب الإزاحة النسبية
    متغير إزاحة = العنوان_المطلوب - قاعدة

    # هل الإزاحة ضمن الحد
    إذا (إزاحة <= حد_فعلي)
        ارجع 1
    نهاية

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تهيئة GDT — الإعداد الرئيسي
# ═══════════════════════════════════════════════════════════════════════════════

# تخصيص الذاكرة وإعداد جميع مداخل GDT
دالة تهيئة_جدول_gdt()
    kernel_print_string("  [حماية] بدء تهيئة GDT...")
    kernel_print_number(10)

    # تخصيص ذاكرة لجدول GDT + GDTR
    متغير مقاس_مطلوب = ثابت_مقاس_gdt + ثابت_مقاس_gdtr + 16
    عنوان_gdt = kernel_allocate(مقاس_مطلوب)
    إذا (عنوان_gdt == 0)
        kernel_print_string("  [حماية] فشل تخصيص ذاكرة GDT!")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # عنوان GDTR بعد نهاية GDT
    عنوان_gdtr = عنوان_gdt + ثابت_مقاس_gdt

    # تصفير الجدول بالكامل
    sad_ll_memset(عنوان_gdt، 0، ثابت_مقاس_gdt)

    # ─── المدخل 0: الواصف الفارغ (مطلوب من المعالج) ───
    # يجب أن يكون صفراً بالكامل — لا نكتب شيئاً
    kernel_print_string("    [0] واصف فارغ (Null)")
    kernel_print_number(10)

    # ─── المدخل 1: مقطع كود النواة (Ring 0) ───
    # القاعدة: 0x00000000، الحد: 0xFFFFF (نموذج مسطح — كامل الذاكرة)
    # الوصول: 0x9A (حاضر + DPL0 + كود + قراءة)
    # الأعلام: 0xCF (تفصيلية 4KB + 32بت + حد علوي 0xF)
    كتابة_واصف_gdt(فهرس_كود_نواة، 0، 1048575، وصول_كود_نواة، اعلام_مقطع_عادي)
    kernel_print_string("    [1] كود النواة: القاعدة=0، الحد=4GB، DPL=0")
    kernel_print_number(10)

    # ─── المدخل 2: مقطع بيانات النواة (Ring 0) ───
    # نفس القاعدة والحد — نموذج مسطح
    # الوصول: 0x92 (حاضر + DPL0 + بيانات + كتابة)
    كتابة_واصف_gdt(فهرس_بيانات_نواة، 0، 1048575، وصول_بيانات_نواة، اعلام_مقطع_عادي)
    kernel_print_string("    [2] بيانات النواة: القاعدة=0، الحد=4GB، DPL=0")
    kernel_print_number(10)

    # ─── المدخل 3: مقطع كود المستخدم (Ring 3) ───
    # الوصول: 0xFA (حاضر + DPL3 + كود + قراءة)
    كتابة_واصف_gdt(فهرس_كود_مستخدم، 0، 1048575، وصول_كود_مستخدم، اعلام_مقطع_عادي)
    kernel_print_string("    [3] كود المستخدم: القاعدة=0، الحد=4GB، DPL=3")
    kernel_print_number(10)

    # ─── المدخل 4: مقطع بيانات المستخدم (Ring 3) ───
    # الوصول: 0xF2 (حاضر + DPL3 + بيانات + كتابة)
    كتابة_واصف_gdt(فهرس_بيانات_مستخدم، 0، 1048575، وصول_بيانات_مستخدم، اعلام_مقطع_عادي)
    kernel_print_string("    [4] بيانات المستخدم: القاعدة=0، الحد=4GB، DPL=3")
    kernel_print_number(10)

    تمت_تهيئة_gdt = 1
    kernel_print_string("  [حماية] تم إنشاء مداخل GDT الأساسية")
    kernel_print_number(10)
    ارجع 1
نهاية

# إضافة مدخل TSS إلى GDT (يُستدعى بعد تهيئة TSS)
دالة إضافة_tss_إلى_gdt()
    إذا (تمت_تهيئة_tss == 0)
        kernel_print_string("  [حماية] خطأ: TSS غير مُهيّأ")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # واصف TSS: القاعدة = عنوان TSS، الحد = مقاس TSS - 1
    # الوصول: 0x89 (حاضر + DPL0 + نظام + TSS 32بت نشط)
    # الأعلام: 0x00 (لا تفصيلية صفحات، حد بالبايت)
    متغير حد_tss = ثابت_مقاس_tss - 1
    كتابة_واصف_gdt(فهرس_tss، عنوان_tss، حد_tss، وصول_tss، 0)

    kernel_print_string("    [5] TSS: القاعدة=")
    kernel_print_number(عنوان_tss)
    kernel_print_string("، الحد=")
    kernel_print_number(حد_tss)
    kernel_print_number(10)
    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إعداد GDTR وتحميل GDT
# ═══════════════════════════════════════════════════════════════════════════════

# إعداد مؤشر GDTR وتحميل GDT في المعالج
دالة تحميل_جدول_gdt()
    إذا (تمت_تهيئة_gdt == 0)
        kernel_print_string("  [حماية] خطأ: GDT غير مُهيّأ")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # GDTR: الحد (2 بايت) + القاعدة (4 بايتات)
    # نكتبها كـ dword: الأول يحتوي الحد في البتات السفلية
    # الحد = مقاس الجدول - 1
    متغير حد_gdtr = ثابت_مقاس_gdt - 1

    # كتابة GDTR في الذاكرة
    # الدبل-وورد الأول: الحد في البتات 0-15، والجزء السفلي من القاعدة في 16-31
    متغير gdtr_دبل0 = (عنوان_gdt << 16) | (حد_gdtr & 65535)
    متغير gdtr_دبل1 = (عنوان_gdt >> 16) & 65535

    mem_write_dword(عنوان_gdtr، gdtr_دبل0)
    mem_write_dword(عنوان_gdtr + 4، gdtr_دبل1)

    # تحميل GDT في المعالج
    sad_ll_load_gdt(عنوان_gdtr)

    عداد_تحميل_gdt = عداد_تحميل_gdt + 1

    kernel_print_string("  [حماية] تم تحميل GDT في المعالج")
    kernel_print_number(10)
    kernel_print_string("    عنوان GDT: ")
    kernel_print_number(عنوان_gdt)
    kernel_print_number(10)
    kernel_print_string("    حد GDTR: ")
    kernel_print_number(حد_gdtr)
    kernel_print_number(10)
    ارجع 1
نهاية

