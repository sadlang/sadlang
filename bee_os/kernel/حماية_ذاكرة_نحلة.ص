# ═══════════════════════════════════════════════════════════════════════════════
# بناء واصف بوابة المقاطعة (IDT Entry)
# ═══════════════════════════════════════════════════════════════════════════════
#
# بنية بوابة المقاطعة (8 بايتات):
# ┌──────────────────────────────────────────┐
# │ الدبل-وورد السفلي:                       │
# │   بتات 0-15:  الإزاحة السفلية            │
# │   بتات 16-31: محدد المقطع                │
# ├──────────────────────────────────────────┤
# │ الدبل-وورد العلوي:                       │
# │   بتات 0-7:   صفر (محجوز)                │
# │   بتات 8-15:  فئة البوابة                │
# │   بتات 16-31: الإزاحة العليا             │
# └──────────────────────────────────────────┘

# كتابة بوابة مقاطعة في جدول IDT
دالة كتابة_بوابة_مقاطعة(فهرس، محدد_المقطع، عنوان_معالج، فئة_البوابة)
    متغير عنوان_بوابة = عنوان_idt + (فهرس * ثابت_مقاس_بوابة)

    # الإزاحة السفلية (بتات 0-15 من عنوان المعالج)
    متغير إزاحة_سفلية = عنوان_معالج & 65535
    # الإزاحة العليا (بتات 16-31 من عنوان المعالج)
    متغير إزاحة_عليا = (عنوان_معالج >> 16) & 65535

    # الدبل-وورد السفلي = (محدد_المقطع << 16) | إزاحة_سفلية
    متغير دبل_سفلي = (محدد_المقطع << 16) | إزاحة_سفلية

    # الدبل-وورد العلوي = (إزاحة_عليا << 16) | (فئة_البوابة << 8) | 0
    متغير دبل_علوي = (إزاحة_عليا << 16) | (فئة_البوابة << 8)

    mem_write_dword(عنوان_بوابة، دبل_سفلي)
    mem_write_dword(عنوان_بوابة + 4، دبل_علوي)
نهاية

# قراءة عنوان معالج المقاطعة من بوابة IDT
