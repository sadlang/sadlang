# إعداد إطار مكدس للانتقال من حلقة 0 إلى حلقة 3
# يُستخدم عند إطلاق عملية مستخدم لأول مرة
# يجب دفع: SS3، ESP3، EFLAGS، CS3، EIP على مكدس النواة
دالة بناء_إطار_انتقال_لمستخدم(عنوان_مكدس، عنوان_دخول، مكدس_مستخدم)
    # محاكاة إطار مكدس IRET للانتقال إلى حلقة 3
    # ترتيب الدفع (من الأسفل للأعلى):
    # [SS المستخدم] [ESP المستخدم] [EFLAGS] [CS المستخدم] [EIP]

    متغير موضع = عنوان_مكدس

    # SS المستخدم (محدد بيانات المستخدم مع RPL=3)
    موضع = موضع - 4
    mem_write_dword(موضع، محدد_بيانات_مستخدم)

    # ESP المستخدم (قمة مكدس المستخدم)
    موضع = موضع - 4
    mem_write_dword(موضع، مكدس_مستخدم)

    # EFLAGS مع بت IF (تمكين المقاطعات) + IOPL=3
    # IF = بت 9 = 512، IOPL = بتات 12-13 = 12288
    متغير اعلام_مستخدم = 512 | 12288 | 2
    موضع = موضع - 4
    mem_write_dword(موضع، اعلام_مستخدم)

    # CS المستخدم (محدد كود المستخدم مع RPL=3)
    موضع = موضع - 4
    mem_write_dword(موضع، محدد_كود_مستخدم)

    # EIP (عنوان نقطة دخول البرنامج)
    موضع = موضع - 4
    mem_write_dword(موضع، عنوان_دخول)

    عداد_تبديل_حلقة = عداد_تبديل_حلقة + 1

    # إرجاع عنوان القمة الجديدة للمكدس
    ارجع موضع
