# ═══════════════════════════════════════════════════════════════════════════════
# بناء واصف GDT
# ═══════════════════════════════════════════════════════════════════════════════

# كتابة واصف GDT في الذاكرة
# كل واصف يتكون من دبل-وورد سفلي ودبل-وورد علوي
#
# الدبل-وورد السفلي = (القاعدة_السفلية << 16) | الحد_السفلي
# الدبل-وورد العلوي = (القاعدة_العليا << 24) | (الأعلام_والحد_العلوي << 16) |
#                      (الوصول << 8) | القاعدة_الوسطى
دالة كتابة_واصف_gdt(فهرس، القاعدة، الحد، الوصول، الاعلام)
    # حساب العنوان في جدول GDT
    متغير عنوان_واصف = عنوان_gdt + (فهرس * ثابت_مقاس_مدخل)

    # استخراج أجزاء القاعدة
    متغير قاعدة_سفلية = استخراج_القاعدة_السفلية(القاعدة)
    متغير قاعدة_وسطى = استخراج_القاعدة_الوسطى(القاعدة)
    متغير قاعدة_عليا = استخراج_القاعدة_العليا(القاعدة)

    # استخراج أجزاء الحد
    متغير حد_سفلي = استخراج_الحد_السفلي(الحد)
    متغير حد_علوي = استخراج_الحد_العلوي(الحد)

    # تجميع الأعلام مع الحد العلوي
    متغير اعلام_وحد = (الاعلام & 240) | (حد_علوي & 15)

    # بناء الدبل-وورد السفلي: (القاعدة_السفلية << 16) | الحد_السفلي
    متغير دبل_سفلي = (قاعدة_سفلية << 16) | حد_سفلي

    # بناء الدبل-وورد العلوي: (القاعدة_العليا << 24) | (أعلام_وحد << 16) | (الوصول << 8) | القاعدة_الوسطى
    متغير دبل_علوي = (قاعدة_عليا << 24) | (اعلام_وحد << 16) | (الوصول << 8) | قاعدة_وسطى

    # كتابة في الذاكرة
    mem_write_dword(عنوان_واصف، دبل_سفلي)
    mem_write_dword(عنوان_واصف + 4، دبل_علوي)
نهاية

# قراءة واصف GDT من الذاكرة وإرجاع عرض الوصول
دالة قراءة_وصول_واصف(فهرس)
    متغير عنوان_واصف = عنوان_gdt + (فهرس * ثابت_مقاس_مدخل)
    متغير دبل_علوي = mem_read_dword(عنوان_واصف + 4)
    # عرض الوصول في بتات 8-15 من الدبل-وورد العلوي
    ارجع (دبل_علوي >> 8) & 255
نهاية

# قراءة القاعدة الكاملة من واصف GDT
دالة قراءة_قاعدة_واصف(فهرس)
    متغير عنوان_واصف = عنوان_gdt + (فهرس * ثابت_مقاس_مدخل)
    متغير دبل_سفلي = mem_read_dword(عنوان_واصف)
    متغير دبل_علوي = mem_read_dword(عنوان_واصف + 4)

    # القاعدة السفلية من بتات 16-31 من الدبل السفلي
    متغير قاعدة_سفلية = (دبل_سفلي >> 16) & 65535
    # القاعدة الوسطى من بتات 0-7 من الدبل العلوي
    متغير قاعدة_وسطى = دبل_علوي & 255
    # القاعدة العليا من بتات 24-31 من الدبل العلوي
    متغير قاعدة_عليا = (دبل_علوي >> 24) & 255

    ارجع (قاعدة_عليا << 24) | (قاعدة_وسطى << 16) | قاعدة_سفلية
نهاية

# قراءة الحد الكامل من واصف GDT
دالة قراءة_حد_واصف(فهرس)
    متغير عنوان_واصف = عنوان_gdt + (فهرس * ثابت_مقاس_مدخل)
    متغير دبل_سفلي = mem_read_dword(عنوان_واصف)
    متغير دبل_علوي = mem_read_dword(عنوان_واصف + 4)

    # الحد السفلي من بتات 0-15 من الدبل السفلي
    متغير حد_سفلي = دبل_سفلي & 65535
    # الحد العلوي من بتات 16-19 من الدبل العلوي
    متغير حد_علوي = (دبل_علوي >> 16) & 15

    ارجع (حد_علوي << 16) | حد_سفلي
