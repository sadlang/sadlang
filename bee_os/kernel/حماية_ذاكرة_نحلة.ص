    # IDTR مشابه لـ GDTR
    متغير حد_idtr = ثابت_مقاس_idt - 1

    متغير idtr_دبل0 = (عنوان_idt << 16) | (حد_idtr & 65535)
    متغير idtr_دبل1 = (عنوان_idt >> 16) & 65535

    mem_write_dword(عنوان_idtr، idtr_دبل0)
