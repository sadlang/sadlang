# ═══════════════════════════════════════════════════════════════════════════════
# إدارة TSS (مقطع حالة المهمة)
# ═══════════════════════════════════════════════════════════════════════════════

# تهيئة بنية TSS بالقيم الافتراضية
دالة تهيئة_tss()
    # تخصيص ذاكرة لبنية TSS
    عنوان_tss = kernel_allocate(ثابت_مقاس_tss + 16)
    إذا (عنوان_tss == 0)
        kernel_print_string("  [حماية] فشل تخصيص ذاكرة TSS")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # تصفير جميع حقول TSS
    sad_ll_memset(عنوان_tss، 0، ثابت_مقاس_tss)

    # تخصيص مكدس النواة
    عنوان_مكدس_نواة = kernel_allocate(ثابت_مقاس_مكدس_نواة)
    إذا (عنوان_مكدس_نواة == 0)
        kernel_print_string("  [حماية] فشل تخصيص مكدس النواة")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # تصفير مكدس النواة
    sad_ll_memset(عنوان_مكدس_نواة، 0، ثابت_مقاس_مكدس_نواة)

    # إعداد ESP0 — قمة مكدس النواة (ينمو للأسفل)
    متغير قمة_مكدس = عنوان_مكدس_نواة + ثابت_مقاس_مكدس_نواة
    mem_write_dword(عنوان_tss + إزاحة_tss_esp0، قمة_مكدس)

    # إعداد SS0 — محدد مقطع بيانات النواة
    mem_write_dword(عنوان_tss + إزاحة_tss_ss0، محدد_بيانات_نواة)

    # إعداد مقاطع البيانات الافتراضية
    mem_write_dword(عنوان_tss + إزاحة_tss_ds، محدد_بيانات_نواة)
    mem_write_dword(عنوان_tss + إزاحة_tss_es، محدد_بيانات_نواة)
    mem_write_dword(عنوان_tss + إزاحة_tss_fs، محدد_بيانات_نواة)
    mem_write_dword(عنوان_tss + إزاحة_tss_gs، محدد_بيانات_نواة)
    mem_write_dword(عنوان_tss + إزاحة_tss_ss، محدد_بيانات_نواة)
    mem_write_dword(عنوان_tss + إزاحة_tss_cs، محدد_كود_نواة)

    # إعداد إزاحة خريطة IO (بعد نهاية TSS — لا خريطة IO)
    mem_write_dword(عنوان_tss + إزاحة_tss_iomap، ثابت_مقاس_tss)

    تمت_تهيئة_tss = 1
    kernel_print_string("  [حماية] تم تهيئة TSS بنجاح")
    kernel_print_number(10)
    kernel_print_string("    عنوان TSS: ")
    kernel_print_number(عنوان_tss)
    kernel_print_number(10)
    kernel_print_string("    مكدس النواة: ")
    kernel_print_number(قمة_مكدس)
    kernel_print_number(10)
    ارجع 1
نهاية

