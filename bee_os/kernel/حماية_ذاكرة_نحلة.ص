# ═══════════════════════════════════════════════════════════════════════════════
# تسجيل استثناءات المعالج (Exceptions)
# ═══════════════════════════════════════════════════════════════════════════════

# تسجيل معالجات الاستثناءات الأساسية (0-31)
# هذه الدالة تحتاج عناوين معالجات فعلية من وحدة المقاطعات
دالة تسجيل_استثناء(فهرس_استثناء، عنوان_معالج)
    إذا (تمت_تهيئة_idt == 0)
        ارجع 0
    نهاية

    # الاستثناءات 0-31 محجوزة للمعالج
    إذا (فهرس_استثناء > 31)
        ارجع 0
    نهاية

    # استثناء كبوابة فخ (Trap Gate)
    كتابة_بوابة_مقاطعة(فهرس_استثناء، محدد_كود_نواة، عنوان_معالج، فئة_بوابة_فخ)
    ارجع 1
