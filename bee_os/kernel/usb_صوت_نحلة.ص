        uac_ep_in_0 = in_ep + 0
    نهاية
    إذا (idx == 1)
        uac_ctrl_iface_1 = ctrl_iface + 0
        uac_stream_out_iface_1 = out_iface + 0
        uac_stream_in_iface_1 = in_iface + 0
        uac_ep_out_1 = out_ep + 0
        uac_ep_in_1 = in_ep + 0
    نهاية
    إذا (idx == 2)
        uac_ctrl_iface_2 = ctrl_iface + 0
