# ═══════════════════════════════════════════════════════════════════════════════
# حجم مخزن الحزمة (frame size)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uac_calc_frame_size(dev)
    متغير ch = uac_get_channels(dev) + 0
    متغير bits = uac_get_bits(dev) + 0
    متغير bytes_per_sample = bits / 8
    ارجع ch * bytes_per_sample
