# ═══════════════════════════════════════════════════════════════════════════════
# حجم مخزن ملي ثانية واحدة
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uac_calc_ms_buffer(dev)
    متغير rate = uac_get_rate(dev) + 0
    متغير frame = uac_calc_frame_size(dev) + 0
    # samples per ms = rate / 1000
    متغير samples_per_ms = rate / 1000
    ارجع samples_per_ms * frame
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تقرير USB Audio
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة uac_تقرير()
    uac_serial_اطبع("═══ [UAC] تقرير صوت USB ═══")
    uac_serial_سطر()

    uac_serial_اطبع("  أجهزة: ")
    uac_serial_رقم(uac_device_count + 0)
    uac_serial_سطر()

    uac_serial_اطبع("  terminals: ")
    uac_serial_رقم(uac_term_count + 0)
    uac_serial_سطر()

    uac_serial_اطبع("  feature units: ")
    uac_serial_رقم(uac_fu_count + 0)
    uac_serial_سطر()

    متغير d = 0 + 0
    بينما (d < uac_device_count)
        إذا (uac_get_present(d) == 1)
            uac_serial_اطبع("  Dev ")
            uac_serial_رقم(d + 0)
            uac_serial_اطبع(": ")
            uac_serial_رقم(uac_get_rate(d) + 0)
            uac_serial_اطبع("Hz ")
            uac_serial_رقم(uac_get_bits(d) + 0)
            uac_serial_اطبع("bit ")
            uac_serial_رقم(uac_get_channels(d) + 0)
            uac_serial_اطبع("ch")
            إذا (uac_get_streaming(d) == 1)
                uac_serial_اطبع(" [PLAYING]")
            نهاية
            uac_serial_سطر()
        نهاية
        d = d + 1
    نهاية

    uac_serial_اطبع("  حزم مرسلة: ")
    uac_serial_رقم(uac_packets_sent + 0)
    uac_serial_اطبع(" مستقبلة: ")
    uac_serial_رقم(uac_packets_received + 0)
    uac_serial_اطبع(" أخطاء: ")
    uac_serial_رقم(uac_errors + 0)
    uac_serial_سطر()

    uac_serial_اطبع("═══════════════════════════════════")
    uac_serial_سطر()
    ارجع 0
نهاية

