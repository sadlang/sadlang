        إذا (proc_نشطة[ط] == 1)
            vfs_اطبع("  ")
            vfs_اطبع_رقم(proc_معرف_عملية[ط] + 0)
            vfs_اطبع("       ")
            vfs_اطبع_رقم(proc_حالة_عملية[ط] + 0)
            vfs_اطبع("      ")
            vfs_اطبع_رقم(proc_أولوية[ط] + 0)
            vfs_اطبع("       ")
            vfs_اطبع_رقم(proc_ذاكرة_مستخدمة[ط] + 0)
            vfs_اطبع("      ")
            vfs_اطبع_رقم(proc_والد[ط] + 0)
            vfs_اطبع("      ")
            vfs_اطبع_رقم(proc_مالك_عملية[ط] + 0)
            vfs_اطبع("\n")
        نهاية
        ط = ط + 1
    نهاية
    vfs_اطبع("╚═══════════════════════════════════════════════════╝\n")
نهاية

