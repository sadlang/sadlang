## تسجيل عملية في procfs
صدّر دالة proc_سجّل_عملية(معرف, والد, مالك, أولوية_عملية)
    إذا (proc_عداد >= PROC_أقصى_عمليات)
        ارجع -1
    نهاية
    
    متغير فهرس = -1
    متغير ط = 0
    بينما (ط < PROC_أقصى_عمليات)
        إذا (proc_نشطة[ط] == 0)
            فهرس = ط + 0
            ط = PROC_أقصى_عمليات
        نهاية
        ط = ط + 1
    نهاية
    
    إذا (فهرس < 0)
        ارجع -1
    نهاية
    
    proc_معرف_عملية[فهرس] = معرف + 0
    proc_حالة_عملية[فهرس] = 1  # RUNNING
    proc_أولوية[فهرس] = أولوية_عملية + 0
    proc_ذاكرة_مستخدمة[فهرس] = 4096
    proc_وقت_تنفيذ[فهرس] = 0
    proc_والد[فهرس] = والد + 0
    proc_مالك_عملية[فهرس] = مالك + 0
    proc_نشطة[فهرس] = 1
    proc_عداد = proc_عداد + 1
    sys_عدد_عمليات = sys_عدد_عمليات + 1
    
    ارجع فهرس + 0
نهاية

