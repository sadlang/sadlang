    متغير ط = 0
    بينما (ط < PROC_أقصى_عمليات)
        إذا (proc_نشطة[ط] == 1)
            إذا (proc_معرف_عملية[ط] == معرف)
                proc_حالة_عملية[ط] = الحالة_الجديدة + 0
                ارجع
            نهاية
        نهاية
        ط = ط + 1
    نهاية
نهاية

## قراءة معلومات عملية
صدّر دالة proc_اقرأ_عملية(معرف, حقل)
    متغير ط = 0
    بينما (ط < PROC_أقصى_عمليات)
        إذا (proc_نشطة[ط] == 1)
            إذا (proc_معرف_عملية[ط] == معرف)
                إذا (حقل == 0)
                    ارجع proc_حالة_عملية[ط] + 0
                نهاية
                إذا (حقل == 1)
                    ارجع proc_أولوية[ط] + 0
                نهاية
                إذا (حقل == 2)
                    ارجع proc_ذاكرة_مستخدمة[ط] + 0
                نهاية
                إذا (حقل == 3)
                    ارجع proc_وقت_تنفيذ[ط] + 0
                نهاية
                إذا (حقل == 4)
                    ارجع proc_والد[ط] + 0
                نهاية
                إذا (حقل == 5)
                    ارجع proc_مالك_عملية[ط] + 0
                نهاية
            نهاية
        نهاية
        ط = ط + 1
    نهاية
    ارجع -1
نهاية

## إزالة عملية من procfs
صدّر دالة proc_أزل_عملية(معرف)
    متغير ط = 0
    بينما (ط < PROC_أقصى_عمليات)
        إذا (proc_نشطة[ط] == 1)
            إذا (proc_معرف_عملية[ط] == معرف)
                proc_نشطة[ط] = 0
                proc_عداد = proc_عداد - 1
                sys_عدد_عمليات = sys_عدد_عمليات - 1
                ارجع 0
            نهاية
        نهاية
        ط = ط + 1
    نهاية
    ارجع -1
نهاية

## عرض كل العمليات
