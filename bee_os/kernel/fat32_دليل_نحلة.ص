صدّر دالة دليل_اقرأ_عنقود_مدخل(مخزن، إزاحة_مدخل)
    # البايتان السفليان (إزاحة 26)
    متغير سفلي = mem_read_word(مخزن + 0، إزاحة_مدخل + إزاحة_عنقود_سفلي)
    # البايتان العلويان (إزاحة 20)
    متغير علوي = mem_read_word(مخزن + 0، إزاحة_مدخل + إزاحة_عنقود_عالي)
    # الجمع: العلوي × 65536 + السفلي
    متغير عنقود = علوي * 65536 + سفلي
    ارجع عنقود + 0
