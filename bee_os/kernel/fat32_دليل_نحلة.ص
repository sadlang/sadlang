    نهاية
    
    # كتابة العنقود المهيأ
    fat32_اكتب_عنقود(فهرس_قسم + 0، عنقود_فرعي + 0، مخزن + 0)
    
    kfree(مخزن + 0)
    
    # إنشاء المدخل في الدليل الأب
    دليل_أنشئ_مدخل(فهرس_قسم + 0، عنقود_أب + 0، اسم_83 + 0، سمة_دليل + 0، عنقود_فرعي + 0)
    
