# قراءة محتويات دليل كامل
# يتتبع سلسلة العناقيد ويقرأ جميع المدخلات
# =====================================================================

صدّر دالة دليل_اقرأ_كل(فهرس_قسم، عنقود_دليل)
    serial_puts("[DIR] قراءة دليل عنقود: ")
    serial_put_int(عنقود_دليل + 0)
    serial_puts("\r\n")
    
    # مسح النتائج السابقة
    دليل_امسح_نتائج()
    
    # تخصيص مخزن لعنقود كامل
    متغير مقاس_عنقود = fat32_قطاعات_عنقود(فهرس_قسم + 0) * fat32_عرض_قطاع(فهرس_قسم + 0)
    متغير مخزن = kmalloc(مقاس_عنقود + 0)
    إذا (مخزن == 0)
        serial_puts("[DIR] خطأ: فشل تخصيص ذاكرة\r\n")
        ارجع -1
    نهاية
    
    # تتبع سلسلة العناقيد
    متغير عنقود_حالي = عنقود_دليل + 0
    متغير عداد_عناقيد = 0
    متغير أمان = 1000
    
    بينما (عداد_عناقيد < أمان)
        # قراءة العنقود
        fat32_اقرأ_عنقود(فهرس_قسم + 0، عنقود_حالي + 0، مخزن + 0)
        
        # فحص المدخلات
        دليل_افحص_عنقود(فهرس_قسم + 0، عنقود_حالي + 0، مخزن + 0)
        
        # قراءة العنقود التالي
        متغير تالي = fat32_اقرأ_مدخل_fat(فهرس_قسم + 0، عنقود_حالي + 0)
        
        إذا (fat32_هل_نهاية_سلسلة(تالي + 0) == 1)
            اخرج
        نهاية
        
        عنقود_حالي = تالي + 0
        عداد_عناقيد = عداد_عناقيد + 1
    نهاية
    
    kfree(مخزن + 0)
    
    serial_puts("[DIR] وُجدت ")
    serial_put_int(عدد_نتائج + 0)
    serial_puts(" مدخلات\r\n")
    
    ارجع عدد_نتائج + 0
