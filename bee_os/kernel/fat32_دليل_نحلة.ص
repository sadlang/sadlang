# مقارنة اسم ملف 8.3
# =====================================================================

# مقارنة اسم ملف في مدخل دليل مع اسم مرجعي في الذاكرة
# الاسم المرجعي 11 بايت: 8 بايت اسم + 3 بايت امتداد (مبطن بمسافات)
# يُرجع 1 إذا تطابق، 0 إذا لم يتطابق
صدّر دالة دليل_قارن_اسم(مخزن، إزاحة_مدخل، اسم_مرجع)
    # مقارنة 11 بايت
    متغير موضع = 0
    بينما (موضع < 11)
        متغير حرف_مدخل = mem_read_byte(مخزن + 0، إزاحة_مدخل + موضع)
        متغير حرف_مرجع = mem_read_byte(اسم_مرجع + 0، موضع + 0)
        
        # تحويل أحرف صغيرة إلى كبيرة (a-z → A-Z)
        # a = 97, z = 122, الفرق = 32
        إذا (حرف_مدخل >= 97)
            إذا (حرف_مدخل <= 122)
                حرف_مدخل = حرف_مدخل - 32
            نهاية
        نهاية
        إذا (حرف_مرجع >= 97)
            إذا (حرف_مرجع <= 122)
                حرف_مرجع = حرف_مرجع - 32
            نهاية
        نهاية
        
        إذا (حرف_مدخل != حرف_مرجع)
            ارجع 0
        نهاية
        
        موضع = موضع + 1
    نهاية
    
    ارجع 1
نهاية

# =====================================================================
# تحويل اسم ملف عادي إلى صيغة 8.3
# "hello.txt" → "HELLO   TXT"
# =====================================================================

# تحويل حرف إلى حرف كبير إذا كان صغيراً
صدّر دالة دليل_حرف_كبير(حرف)
    # الأحرف الصغيرة a(97) - z(122)
    إذا (حرف >= 97)
        إذا (حرف <= 122)
            ارجع حرف - 32
        نهاية
    نهاية
    ارجع حرف + 0
نهاية

# تحويل اسم ملف عادي إلى صيغة 8.3 في مخزن 11 بايت
# يُرجع 0 عند النجاح، -1 عند خطأ
صدّر دالة دليل_حوّل_اسم_83(اسم_مصدر، طول_اسم، مخزن_هدف)
    # تهيئة المخزن بمسافات (32 = ASCII space)
    متغير ع = 0
    بينما (ع < 11)
        mem_write_byte(مخزن_هدف + 0، ع + 0، 32)
        ع = ع + 1
    نهاية
    
    # موضع القراءة في الاسم المصدر
    متغير قراءة = 0
    # موضع الكتابة في الاسم (0-7)
    متغير كتابة = 0
    
    # نسخ الاسم (قبل النقطة)
    بينما (قراءة < طول_اسم)
        متغير حرف = mem_read_byte(اسم_مصدر + 0، قراءة + 0)
        
        # النقطة (46 = '.') تفصل الاسم عن الامتداد
        إذا (حرف == 46)
            قراءة = قراءة + 1
            اخرج
        نهاية
        
        # تخطي المسافات
        إذا (حرف == 32)
            قراءة = قراءة + 1
            تابع
        نهاية
        
        # تحويل إلى حرف كبير
        متغير كبير = دليل_حرف_كبير(حرف + 0)
        
        إذا (كتابة < 8)
            mem_write_byte(مخزن_هدف + 0، كتابة + 0، كبير + 0)
            كتابة = كتابة + 1
        نهاية
        
        قراءة = قراءة + 1
    نهاية
    
    # نسخ الامتداد (بعد النقطة)
    كتابة = 8
    بينما (قراءة < طول_اسم)
        متغير حرف_إمتداد = mem_read_byte(اسم_مصدر + 0، قراءة + 0)
        
        متغير كبير_إ = دليل_حرف_كبير(حرف_إمتداد + 0)
        
        إذا (كتابة < 11)
            mem_write_byte(مخزن_هدف + 0، كتابة + 0، كبير_إ + 0)
            كتابة = كتابة + 1
        نهاية
        
        قراءة = قراءة + 1
    نهاية
    
    ارجع 0
نهاية

