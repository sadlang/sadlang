    serial_puts("[DIR] إنشاء مجلد جديد...\r\n")
    
    # تخصيص عنقود للمجلد الجديد
    متغير عنقود_فرعي = fat32_خصص_عنقود(فهرس_قسم + 0)
    إذا (عنقود_فرعي < 0)
        serial_puts("[DIR] خطأ: فشل تخصيص عنقود\r\n")
        ارجع -1
    نهاية
    
    # تهيئة العنقود (مسح بالأصفار)
    متغير مقاس_عنقود = fat32_قطاعات_عنقود(فهرس_قسم + 0) * fat32_عرض_قطاع(فهرس_قسم + 0)
    متغير مخزن = kmalloc(مقاس_عنقود + 0)
    إذا (مخزن == 0)
        fat32_حرر_عنقود(فهرس_قسم + 0، عنقود_فرعي + 0)
        ارجع -1
    نهاية
    
    mem_set(مخزن + 0، 0، مقاس_عنقود + 0)
    
    # إنشاء مدخل "." (المجلد نفسه) — أول 32 بايت
    # اسم: ".          " (نقطة + 10 مسافات)
    mem_write_byte(مخزن + 0، 0، 46)    # '.'
    متغير ع = 1
    بينما (ع < 11)
        mem_write_byte(مخزن + 0، ع + 0، 32)    # مسافة
        ع = ع + 1
    نهاية
    # سمات: دليل فرعي
    mem_write_byte(مخزن + 0، إزاحة_سمات + 0، سمة_دليل + 0)
    # عنقود: المجلد نفسه
    دليل_اكتب_عنقود_مدخل(مخزن + 0، 0، عنقود_فرعي + 0)
    
    # إنشاء مدخل ".." (المجلد الأب) — ثاني 32 بايت (إزاحة 32)
    mem_write_byte(مخزن + 0، 32، 46)    # '.'
    mem_write_byte(مخزن + 0، 33، 46)    # '.'
    ع = 2
    بينما (ع < 11)
        mem_write_byte(مخزن + 0، 32 + ع، 32)    # مسافة
        ع = ع + 1
    نهاية
    # سمات: دليل فرعي
    mem_write_byte(مخزن + 0، 32 + إزاحة_سمات، سمة_دليل + 0)
