# =====================================================================
# البحث عن ملف بالاسم في دليل
# يبحث اسم 8.3 في جميع عناقيد الدليل
# يُرجع رقم العنقود الأول للملف أو -1 إذا لم يُوجد
# =====================================================================

صدّر دالة دليل_ابحث_اسم(فهرس_قسم، عنقود_دليل، اسم_83)
    # تخصيص مخزن
    متغير مقاس_عنقود = fat32_قطاعات_عنقود(فهرس_قسم + 0) * fat32_عرض_قطاع(فهرس_قسم + 0)
    متغير عدد_مدخلات = مقاس_عنقود / مقاس_مدخل
    متغير مخزن = kmalloc(مقاس_عنقود + 0)
    إذا (مخزن == 0)
        ارجع -1
    نهاية
    
    متغير عنقود_حالي = عنقود_دليل + 0
    متغير أمان = 1000
    متغير عداد = 0
    
    بينما (عداد < أمان)
        # قراءة العنقود
        fat32_اقرأ_عنقود(فهرس_قسم + 0، عنقود_حالي + 0، مخزن + 0)
        
        # البحث في كل مدخل
        متغير إزاحة = 0
        متغير ع_مدخل = 0
        
        بينما (ع_مدخل < عدد_مدخلات)
            متغير أول = دليل_اقرأ_أول_محرف(مخزن + 0، إزاحة + 0)
            
            إذا (أول == علامة_حر_نهائي)
                kfree(مخزن + 0)
                ارجع -1
            نهاية
            
            إذا (أول != علامة_محذوف)
                متغير سمات_ملف = دليل_اقرأ_سمات_مدخل(مخزن + 0، إزاحة + 0)
                
                إذا (دليل_هل_lfn(سمات_ملف + 0) == 0)
                    إذا (دليل_هل_تسمية(سمات_ملف + 0) == 0)
                        # مقارنة الاسم
                        إذا (دليل_قارن_اسم(مخزن + 0، إزاحة + 0، اسم_83 + 0) == 1)
                            # وُجد الملف
                            متغير عنقود_ملف = دليل_اقرأ_عنقود_مدخل(مخزن + 0، إزاحة + 0)
                            kfree(مخزن + 0)
                            ارجع عنقود_ملف + 0
                        نهاية
                    نهاية
                نهاية
            نهاية
            
            إزاحة = إزاحة + مقاس_مدخل
            ع_مدخل = ع_مدخل + 1
        نهاية
        
        # العنقود التالي
        متغير تالي = fat32_اقرأ_مدخل_fat(فهرس_قسم + 0، عنقود_حالي + 0)
        إذا (fat32_هل_نهاية_سلسلة(تالي + 0) == 1)
            اخرج
        نهاية
        
        عنقود_حالي = تالي + 0
        عداد = عداد + 1
    نهاية
    
    kfree(مخزن + 0)
    ارجع -1
نهاية

