# فحص مدخلات الدليل في عنقود
# =====================================================================

# فحص جميع مدخلات الدليل في عنقود واحد
# يبحث عن مدخلات صالحة ويخزنها في جدول النتائج
# يُرجع عدد المدخلات الصالحة الموجودة
صدّر دالة دليل_افحص_عنقود(فهرس_قسم، رقم_عنقود، مخزن)
    # حساب عدد المدخلات في العنقود
    متغير مقاس_عنقود = fat32_قطاعات_عنقود(فهرس_قسم + 0) * fat32_عرض_قطاع(فهرس_قسم + 0)
    متغير عدد_مدخلات = مقاس_عنقود / مقاس_مدخل
    
    متغير عداد = 0
    متغير إزاحة = 0
    متغير وجد = 0
    
    بينما (عداد < عدد_مدخلات)
        # قراءة أول محرف
        متغير أول = دليل_اقرأ_أول_محرف(مخزن + 0، إزاحة + 0)
        
        # مدخل فارغ نهائي — لا مزيد من المدخلات
        إذا (أول == علامة_حر_نهائي)
            ارجع وجد + 0
        نهاية
        
        # مدخل محذوف — تخطي
        إذا (أول == علامة_محذوف)
            إزاحة = إزاحة + مقاس_مدخل
            عداد = عداد + 1
            تابع
        نهاية
        
        # قراءة السمات
        متغير سمات_ملف = دليل_اقرأ_سمات_مدخل(مخزن + 0، إزاحة + 0)
        
        # تخطي مدخلات LFN
        إذا (دليل_هل_lfn(سمات_ملف + 0) == 1)
            إزاحة = إزاحة + مقاس_مدخل
            عداد = عداد + 1
            تابع
        نهاية
        
        # تخطي تسمية القرص
        إذا (دليل_هل_تسمية(سمات_ملف + 0) == 1)
            إزاحة = إزاحة + مقاس_مدخل
            عداد = عداد + 1
            تابع
        نهاية
        
        # مدخل صالح — تخزين في جدول النتائج
        متغير عنقود_ملف = دليل_اقرأ_عنقود_مدخل(مخزن + 0، إزاحة + 0)
        متغير مقاس_ملف = دليل_اقرأ_مقاس_مدخل(مخزن + 0، إزاحة + 0)
        
        إذا (عدد_نتائج < 64)
            دليل_عيّن_نتيجة(عدد_نتائج + 0، عنقود_ملف + 0، مقاس_ملف + 0، سمات_ملف + 0، إزاحة + 0، رقم_عنقود + 0)
            عدد_نتائج = عدد_نتائج + 1
        نهاية
        
        وجد = وجد + 1
        إزاحة = إزاحة + مقاس_مدخل
        عداد = عداد + 1
    نهاية
    
    ارجع وجد + 0
نهاية

