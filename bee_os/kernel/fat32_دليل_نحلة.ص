# تحليل اسم N.M حسب المسار
# تقسيم مسار مثل "FOLDER1/FOLDER2/FILE.TXT"
# =====================================================================

# مخزن مؤقت لمكون المسار الحالي (11 بايت بصيغة 8.3)
متغير مسار_مكون_عنقود = 0
متغير مسار_عمق = 0

# تتبع مسار مجلدات وصولاً إلى ملف
# المسار مخزن كقائمة مكونات مفصولة بـ '/' (47)
# يُرجع عنقود آخر مكون في المسار أو -1 عند الفشل
صدّر دالة دليل_تتبع_مسار(فهرس_قسم، مسار، طول_مسار)
    متغير عنقود_حالي = fat32_عنقود_جذر(فهرس_قسم + 0)
    متغير بداية = 0
    متغير موضع = 0
    مسار_عمق = 0
    
    # تخصيص مخزن مؤقت لاسم 8.3
    متغير اسم_مؤقت = kmalloc(16)
    إذا (اسم_مؤقت == 0)
        ارجع -1
    نهاية
    
    # تخطي '/' في البداية إن وُجد
    إذا (طول_مسار > 0)
        متغير أول_حرف = mem_read_byte(مسار + 0، 0)
        إذا (أول_حرف == 47)
            بداية = 1
            موضع = 1
        نهاية
    نهاية
    
    بينما (موضع <= طول_مسار)
        متغير هل_فاصل = 0
        
        إذا (موضع == طول_مسار)
            هل_فاصل = 1
        وإلا
            متغير حرف = mem_read_byte(مسار + 0، موضع + 0)
            إذا (حرف == 47)
                هل_فاصل = 1
            نهاية
        نهاية
        
        إذا (هل_فاصل == 1)
            متغير طول_مكون = موضع - بداية
            
            إذا (طول_مكون > 0)
                # تحويل المكون إلى صيغة 8.3
                متغير عنوان_مكون = مسار + بداية
                دليل_حوّل_اسم_83(عنوان_مكون + 0، طول_مكون + 0، اسم_مؤقت + 0)
                
                # البحث في الدليل الحالي
                متغير عنقود_نتيجة = دليل_ابحث_اسم(فهرس_قسم + 0، عنقود_حالي + 0، اسم_مؤقت + 0)
                
                إذا (عنقود_نتيجة < 0)
                    serial_puts("[DIR] لم يُوجد: مكون مسار\r\n")
                    kfree(اسم_مؤقت + 0)
                    ارجع -1
                نهاية
                
                عنقود_حالي = عنقود_نتيجة + 0
                مسار_عمق = مسار_عمق + 1
            نهاية
            
            بداية = موضع + 1
        نهاية
        
        موضع = موضع + 1
    نهاية
    
    kfree(اسم_مؤقت + 0)
    مسار_مكون_عنقود = عنقود_حالي + 0
    
    ارجع عنقود_حالي + 0
