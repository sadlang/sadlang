دالة جد_أيقونة_عند(سطح_x، سطح_y)
    متغير ف = 0
    بينما (ف < MAX_ICONS)
        إذا (icon_نوع[ف] != ICON_NONE)
            إذا (سطح_x >= icon_x[ف])
                إذا (سطح_y >= icon_y[ف])
                    إذا (سطح_x < icon_x[ف] + ICON_W)
                        إذا (سطح_y < icon_y[ف] + ICON_H)
