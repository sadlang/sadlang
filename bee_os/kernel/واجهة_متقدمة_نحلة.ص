## القسم ٣: نظام الخلفيات (Wallpaper Patterns)
## ═══════════════════════════════════════════════════════════════

ثابت WP_SOLID = 0          # لون صلب
ثابت WP_GRADIENT_V = 1     # تدرج عمودي
ثابت WP_GRADIENT_H = 2     # تدرج أفقي
ثابت WP_STRIPES = 3        # خطوط
ثابت WP_HONEYCOMB = 4      # خلايا نحل
ثابت WP_DOTS = 5           # نقاط

متغير الخلفية_الحالية = 0

صدّر دالة بدّل_الخلفية(خلفية_جديدة)
    إذا (خلفية_جديدة >= 0)
        إذا (خلفية_جديدة <= 5)
            الخلفية_الحالية = خلفية_جديدة
        نهاية
    نهاية
نهاية

صدّر دالة الخلفية_التالية()
    الخلفية_الحالية = (الخلفية_الحالية + 1) % 6
    ارجع الخلفية_الحالية
نهاية

## رسم الخلفية حسب النوع
صدّر دالة ارسم_خلفية()
    متغير لون_قاعدة = theme_bg[الثيم_الحالي]
    
    إذا (الخلفية_الحالية == WP_SOLID)
        ag_fb_fill(0، 0، AG_SCREEN_W، AG_TASKBAR_Y، لون_قاعدة)
        ارجع
    نهاية
    
    إذا (الخلفية_الحالية == WP_GRADIENT_V)
        # تدرج عمودي — من الداكن للفاتح
        متغير صف = 0
        بينما (صف < AG_TASKBAR_Y)
            # حساب اللون المتدرج (تقريبي بسيط)
            متغير نسبة = (صف * 100) / AG_TASKBAR_Y
            متغير ر = ((لون_قاعدة / 65536) % 256)
            متغير ز = ((لون_قاعدة / 256) % 256)
            متغير ب = (لون_قاعدة % 256)
            
            # إضاءة تدريجية
            متغير إضافة = نسبة / 4
            ر = ر + إضافة
            ز = ز + إضافة
            ب = ب + إضافة
            إذا (ر > 255)
                ر = 255
            نهاية
            إذا (ز > 255)
                ز = 255
            نهاية
            إذا (ب > 255)
                ب = 255
            نهاية
            
            متغير لون_صف = (ر * 65536) + (ز * 256) + ب
            ag_fb_fill(0، صف، AG_SCREEN_W، 1، لون_صف)
            صف = صف + 4  # كل 4 صفوف (أسرع)
        نهاية
        ارجع
    نهاية
    
    إذا (الخلفية_الحالية == WP_GRADIENT_H)
        # تدرج أفقي
        متغير عمود = 0
        بينما (عمود < AG_SCREEN_W)
            متغير نسبة = (عمود * 100) / AG_SCREEN_W
            متغير ر = ((لون_قاعدة / 65536) % 256)
            متغير ز = ((لون_قاعدة / 256) % 256)
            متغير ب = (لون_قاعدة % 256)
            متغير إضافة = نسبة / 3
            ر = ر + إضافة
            ز = ز + إضافة
            إذا (ر > 255)
                ر = 255
            نهاية
            إذا (ز > 255)
                ز = 255
            نهاية
            متغير لون_عمود = (ر * 65536) + (ز * 256) + ب
            ag_fb_fill(عمود، 0، 4، AG_TASKBAR_Y، لون_عمود)
            عمود = عمود + 4
        نهاية
        ارجع
    نهاية
    
    إذا (الخلفية_الحالية == WP_STRIPES)
        # خطوط أفقية متبادلة
        ag_fb_fill(0، 0، AG_SCREEN_W، AG_TASKBAR_Y، لون_قاعدة)
        متغير شريط = 0
        بينما (شريط < AG_TASKBAR_Y)
            متغير لون_شريط = theme_accent[الثيم_الحالي]
            ag_fb_fill(0، شريط، AG_SCREEN_W، 2، لون_شريط)
            شريط = شريط + 20
        نهاية
        ارجع
    نهاية
    
    إذا (الخلفية_الحالية == WP_HONEYCOMB)
        # نمط سداسي (خلايا نحل)
        ag_fb_fill(0، 0، AG_SCREEN_W، AG_TASKBAR_Y، لون_قاعدة)
        متغير لون_خلية = theme_accent[الثيم_الحالي]
        متغير cy = 0
        متغير صف_رقم = 0
        بينما (cy < AG_TASKBAR_Y)
            متغير cx = 0
            إذا (صف_رقم % 2 == 1)
                cx = 20
            نهاية
            بينما (cx < AG_SCREEN_W)
                # رسم سداسي مبسط (مستطيل صغير + زوايا)
                ag_fb_fill(cx + 4، cy + 0، 32، 2، لون_خلية)
                ag_fb_fill(cx + 2، cy + 2، 36، 2، لون_خلية)
                ag_fb_fill(cx + 0، cy + 4، 40، 16، لون_خلية)
                ag_fb_fill(cx + 2، cy + 20، 36، 2، لون_خلية)
                ag_fb_fill(cx + 4، cy + 22، 32، 2، لون_خلية)
                
                # تفريغ داخلي (لون الخلفية)
                ag_fb_fill(cx + 6، cy + 4، 28، 16، لون_قاعدة)
                
                cx = cx + 44
            نهاية
            cy = cy + 26
            صف_رقم = صف_رقم + 1
        نهاية
        ارجع
    نهاية
    
    إذا (الخلفية_الحالية == WP_DOTS)
        # نمط نقاط
        ag_fb_fill(0، 0، AG_SCREEN_W، AG_TASKBAR_Y، لون_قاعدة)
        متغير لون_نقطة = theme_accent[الثيم_الحالي]
        متغير ny = 10
        بينما (ny < AG_TASKBAR_Y)
            متغير nx = 10
            بينما (nx < AG_SCREEN_W)
                ag_fb_fill(nx، ny، 3، 3، لون_نقطة)
                nx = nx + 30
            نهاية
            ny = ny + 30
        نهاية
        ارجع
    نهاية
    
    # الافتراضي: لون صلب
    ag_fb_fill(0، 0، AG_SCREEN_W، AG_TASKBAR_Y، لون_قاعدة)
نهاية

