                ارجع vkbd_آخر_مفتاح
            نهاية
        نهاية
        
        # مسافة
        إذا (عمود >= 7)
            vkbd_آخر_مفتاح = 32
            ارجع 32
        نهاية
    نهاية
    
    ارجع -1
