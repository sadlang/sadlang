## مخزن خط وهمي — يُحمَّل في التهيئة
متغير ag_font_عنوان = 0

دالة ag_هيئ_الخط()
    ag_font_عنوان = ag_خصص_صفحة()
    إذا (ag_font_عنوان == 0)
        ارجع -1
    نهاية
    ag_املأ_ذاكرة(ag_font_عنوان، 0، 4096)
    
    # تعبئة أنماط الأحرف الأساسية
    متغير ف = 0
    بينما (ف < 96)
        متغير عنوان_حرف = ag_font_عنوان + (ف * 8)
        ag_اكتب_ذاكرة(عنوان_حرف، 0)
        ag_اكتب_ذاكرة(عنوان_حرف + 1، 126)
        ag_اكتب_ذاكرة(عنوان_حرف + 2، 126)
        ag_اكتب_ذاكرة(عنوان_حرف + 3، 126)
        ag_اكتب_ذاكرة(عنوان_حرف + 4، 126)
        ag_اكتب_ذاكرة(عنوان_حرف + 5، 126)
        ag_اكتب_ذاكرة(عنوان_حرف + 6، 126)
        ag_اكتب_ذاكرة(عنوان_حرف + 7، 0)
        ف = ف + 1
    نهاية
    
    # مسافة (index 0 = ASCII 32)
    ag_املأ_ذاكرة(ag_font_عنوان، 0، 8)
    
    # A (33)
    متغير عنوان_A_val = ag_font_عنوان + (33 * 8)
    ag_اكتب_ذاكرة(عنوان_A_val + 0، 24)
    ag_اكتب_ذاكرة(عنوان_A_val + 1، 60)
    ag_اكتب_ذاكرة(عنوان_A_val + 2، 102)
    ag_اكتب_ذاكرة(عنوان_A_val + 3، 126)
    ag_اكتب_ذاكرة(عنوان_A_val + 4، 102)
    ag_اكتب_ذاكرة(عنوان_A_val + 5، 102)
    ag_اكتب_ذاكرة(عنوان_A_val + 6، 102)
    ag_اكتب_ذاكرة(عنوان_A_val + 7، 0)
    
    ارجع 0
نهاية

## رسم حرف
دالة ag_ارسم_حرف(حرف_ascii، سطح_x، سطح_y، لون_الحرف)
    إذا (حرف_ascii < 32)
        ارجع
    نهاية
    إذا (حرف_ascii > 127)
        ارجع
    نهاية
    
    متغير فهرس = حرف_ascii - 32
    متغير عنوان_حرف = ag_font_عنوان + (فهرس * 8)
    
    متغير صف = 0
    بينما (صف < 8)
        متغير بيانات_الصف = ag_اقرأ_ذاكرة(عنوان_حرف + صف)
        متغير عمود = 0
        بينما (عمود < 8)
            متغير بت = 128
            متغير ش = 0
            بينما (ش < عمود)
                بت = بت / 2
                ش = ش + 1
            نهاية
            إذا ((بيانات_الصف / بت) % 2 == 1)
                ag_fb_pixel(سطح_x + عمود، سطح_y + صف، لون_الحرف)
            نهاية
            عمود = عمود + 1
        نهاية
        صف = صف + 1
    نهاية
نهاية

