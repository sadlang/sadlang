## ─────────────────────────────────────────────────────
خارجي("sad_ll_port_inb") دالة ag_inb(المنفذ)
خارجي("sad_ll_port_outb") دالة ag_outb(المنفذ، القيمة)
خارجي("sad_ll_mem_read64") دالة ag_اقرأ_ذاكرة(عنوان_الذاكرة)
خارجي("sad_ll_mem_write64") دالة ag_اكتب_ذاكرة(عنوان_الذاكرة، قيمة)
خارجي("sad_ll_mem_read32") دالة ag_اقرأ32(عنوان_الذاكرة)
خارجي("sad_ll_mem_write32") دالة ag_اكتب32(عنوان_الذاكرة، قيمة)
خارجي("sad_ll_mem_read16") دالة ag_اقرأ16(عنوان_الذاكرة)
خارجي("sad_ll_mem_write16") دالة ag_اكتب16(عنوان_الذاكرة، قيمة)
خارجي("sad_ll_memset") دالة ag_املأ_ذاكرة(عنوان_الذاكرة، قيمة، طول)
خارجي("sad_ll_memcpy") دالة ag_انسخ_ذاكرة(وجهة، مصدر، طول)
خارجي("sad_ll_serial_write_char") دالة ag_serial_char(منفذ، حرف)
خارجي("sad_ll_page_alloc") دالة ag_خصص_صفحة()
خارجي("sad_ll_page_free") دالة ag_حرر_صفحة(عنوان_الصفحة)
خارجي("sad_ll_pages_alloc") دالة ag_خصص_صفحات(عدد_الصفحات)
خارجي("sad_ll_fb_set_pixel") دالة ag_fb_pixel(س، ص، لون)
خارجي("sad_ll_fb_fill_rect") دالة ag_fb_fill(س، ص، عرض، ارتفاع، لون)
