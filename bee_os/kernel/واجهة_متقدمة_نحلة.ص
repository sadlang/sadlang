    إذا (سطح_y >= base_y3)
        إذا (سطح_y < base_y3 + VKBD_KEY_H)
            صف_ضغط = 3
        نهاية
    نهاية
    
    إذا (صف_ضغط < 0)
        ارجع -1
    نهاية
    
    # صف 0
    إذا (صف_ضغط == 0)
        متغير عمود = (سطح_x - VKBD_X - 10) / (VKBD_KEY_W + 2)
        إذا (عمود >= 0)
            إذا (عمود < VKBD_COLS)
                إذا (vkbd_shift == 1)
                    vkbd_آخر_مفتاح = vkbd_row0_shift[عمود]
                وإلا
                    vkbd_آخر_مفتاح = vkbd_row0[عمود]
                نهاية
                ارجع vkbd_آخر_مفتاح
            نهاية
        نهاية
    نهاية
    
    # صف 1
    إذا (صف_ضغط == 1)
        متغير عمود = (سطح_x - VKBD_X - 20) / (VKBD_KEY_W + 2)
        إذا (عمود >= 0)
            إذا (عمود < VKBD_COLS)
                إذا (vkbd_shift == 1)
                    vkbd_آخر_مفتاح = vkbd_row1_shift[عمود]
                وإلا
                    vkbd_آخر_مفتاح = vkbd_row1[عمود]
                نهاية
                ارجع vkbd_آخر_مفتاح
            نهاية
        نهاية
    نهاية
    
    # صف 2
    إذا (صف_ضغط == 2)
        متغير عمود = (سطح_x - VKBD_X - 30) / (VKBD_KEY_W + 2)
        إذا (عمود >= 0)
