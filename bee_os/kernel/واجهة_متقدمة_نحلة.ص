                    vkbd_آخر_مفتاح = vkbd_row2_shift[عمود]
                وإلا
                    vkbd_آخر_مفتاح = vkbd_row2[عمود]
                نهاية
                ارجع vkbd_آخر_مفتاح
            نهاية
        نهاية
    نهاية
    
    # صف 3: تحقق من Shift أولاً
    إذا (صف_ضغط == 3)
        إذا (سطح_x >= VKBD_X + 10)
            إذا (سطح_x < VKBD_X + 66)
                # زر Shift
                إذا (vkbd_shift == 0)
                    vkbd_shift = 1
                وإلا
                    vkbd_shift = 0
                نهاية
                ارجع -2  # Shift toggled
            نهاية
        نهاية
        
        # أحرف Z-M
        متغير عمود = (سطح_x - VKBD_X - 70) / (VKBD_KEY_W + 2)
        إذا (عمود >= 0)
            إذا (عمود < 7)
                إذا (vkbd_shift == 1)
