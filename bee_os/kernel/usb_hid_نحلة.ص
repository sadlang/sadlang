صدّر دالة hid_poll_mouse()
    إذا (mouse_active == 0) ارجع 0 نهاية

    hid_poll_count = hid_poll_count + 1

    متغير result = uhci_interrupt_transfer(mouse_hc_idx، mouse_dev_addr، mouse_endpoint، mouse_report_buf، MOUSE_REPORT_SIZE) + 0
    إذا (result > 0)
        hid_process_mouse_report(mouse_report_buf، result)
        ارجع 1
    والا_اذا (result < 0)
        hid_errors = hid_errors + 1
    نهاية
    ارجع 0
