صدّر دالة hid_poll_keyboard()
    إذا (kbd_active == 0) ارجع 0 نهاية

    hid_poll_count = hid_poll_count + 1

    متغير result = uhci_interrupt_transfer(kbd_hc_idx، kbd_dev_addr، kbd_endpoint، kbd_report_buf، KBD_REPORT_SIZE) + 0
    إذا (result > 0)
        hid_process_kbd_report(kbd_report_buf)
        ارجع 1
    والا_اذا (result < 0)
        hid_errors = hid_errors + 1
    نهاية
    ارجع 0
