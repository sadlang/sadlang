# إدارة مخزن أحداث الماوس
# ═══════════════════════════════════════════════════════════════════════════════
# حدث الماوس: 4 بايت [buttons, dx, dy, scroll]

صدّر دالة hid_mouse_push_event(buttons، dx، dy، scroll)
    متغير next_tail = (mouse_event_tail + 4) % (MOUSE_BUF_SIZE * 4)
    إذا (next_tail == mouse_event_head)
        ارجع 0
    نهاية

    sad_ll_mem_write8(mouse_event_buf + mouse_event_tail، buttons + 0)
    sad_ll_mem_write8(mouse_event_buf + mouse_event_tail + 1، dx + 128)  # offset
    sad_ll_mem_write8(mouse_event_buf + mouse_event_tail + 2، dy + 128)
    sad_ll_mem_write8(mouse_event_buf + mouse_event_tail + 3، scroll + 128)
    mouse_event_tail = next_tail + 0
    hid_mouse_events = hid_mouse_events + 1
    ارجع 1
نهاية

صدّر دالة hid_mouse_pop_event()
    إذا (mouse_event_head == mouse_event_tail)
        ارجع 0
    نهاية

    متغير buttons = sad_ll_mem_read8(mouse_event_buf + mouse_event_head) + 0
    mouse_event_head = (mouse_event_head + 4) % (MOUSE_BUF_SIZE * 4)
    ارجع buttons + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# معالجة تقرير الماوس (Boot Protocol — 3-4 بايت)
# ═══════════════════════════════════════════════════════════════════════════════
# Byte 0: Buttons (bit0=left, bit1=right, bit2=middle)
# Byte 1: X movement (signed)
# Byte 2: Y movement (signed)
# Byte 3: Scroll wheel (optional, signed)

صدّر دالة hid_process_mouse_report(buf، len)
    متغير buttons = sad_ll_mem_read8(buf) + 0
    متغير raw_dx = sad_ll_mem_read8(buf + 1) + 0
    متغير raw_dy = sad_ll_mem_read8(buf + 2) + 0
    متغير raw_scroll = 0 + 0
    إذا (len >= 4)
        raw_scroll = sad_ll_mem_read8(buf + 3) + 0
    نهاية

    # تحويل إلى أرقام ذات إشارة (8-bit signed)
    متغير dx = raw_dx + 0
    إذا (dx > 127)
        dx = dx - 256
    نهاية

    متغير dy = raw_dy + 0
    إذا (dy > 127)
        dy = dy - 256
    نهاية

    متغير scroll = raw_scroll + 0
    إذا (scroll > 127)
        scroll = scroll - 256
    نهاية

    # تحديث الحالة
    mouse_buttons = buttons + 0
    mouse_dx = dx + 0
    mouse_dy = dy + 0
    mouse_scroll = scroll + 0

    # تحديث الموقع المطلق
    mouse_x = mouse_x + dx
    mouse_y = mouse_y + dy

    # تطبيق الحدود
    إذا (mouse_x < 0) mouse_x = 0 نهاية
    إذا (mouse_y < 0) mouse_y = 0 نهاية
    إذا (mouse_x > mouse_max_x) mouse_x = mouse_max_x + 0 نهاية
    إذا (mouse_y > mouse_max_y) mouse_y = mouse_max_y + 0 نهاية

    # دفع الحدث
    إذا (dx != 0)
        hid_mouse_push_event(buttons، dx، dy، scroll)
    والا_اذا (dy != 0)
        hid_mouse_push_event(buttons، dx، dy، scroll)
    والا_اذا (buttons != 0)
        hid_mouse_push_event(buttons، 0، 0، scroll)
    نهاية

    ارجع 1
نهاية

