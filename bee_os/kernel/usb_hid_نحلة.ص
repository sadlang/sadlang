# ═══════════════════════════════════════════════════════════════════════════════
# معالجة تقرير لوحة المفاتيح (Boot Protocol — 8 بايت)
# ═══════════════════════════════════════════════════════════════════════════════
# Byte 0: Modifier keys
# Byte 1: Reserved (always 0)
# Bytes 2-7: Key codes (up to 6 simultaneous keys)

صدّر دالة hid_process_kbd_report(buf)
    متغير mods = sad_ll_mem_read8(buf) + 0
    kbd_modifiers = mods + 0

    # CapsLock toggle detection (scancode 57)
    # NumLock = 83, ScrollLock = 71

    # معالجة المفاتيح الجديدة
    متغير k = 2 + 0
    بينما (k < 8)
        متغير scancode = sad_ll_mem_read8(buf + k) + 0
        إذا (scancode != 0)
            إذا (scancode != 1)   # 1 = Error Rollover
                # التحقق من أنه مفتاح جديد (ليس في التقرير السابق)
                متغير is_new = 1 + 0

                متغير prev_0 = sad_ll_mem_read8(kbd_prev_report + 2) + 0
                متغير prev_1 = sad_ll_mem_read8(kbd_prev_report + 3) + 0
                متغير prev_2 = sad_ll_mem_read8(kbd_prev_report + 4) + 0
                متغير prev_3 = sad_ll_mem_read8(kbd_prev_report + 5) + 0
                متغير prev_4 = sad_ll_mem_read8(kbd_prev_report + 6) + 0
                متغير prev_5 = sad_ll_mem_read8(kbd_prev_report + 7) + 0

                إذا (scancode == prev_0) is_new = 0 نهاية
                إذا (scancode == prev_1) is_new = 0 نهاية
                إذا (scancode == prev_2) is_new = 0 نهاية
                إذا (scancode == prev_3) is_new = 0 نهاية
                إذا (scancode == prev_4) is_new = 0 نهاية
                إذا (scancode == prev_5) is_new = 0 نهاية

                إذا (is_new == 1)
                    # CapsLock toggle
                    إذا (scancode == 57)
                        kbd_capslock = 1 - kbd_capslock
                    والا
                        متغير ascii = hid_scancode_to_ascii(scancode، mods) + 0
                        إذا (ascii != 0)
                            hid_kbd_push_key(ascii)
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
        k = k + 1
    نهاية

    # حفظ التقرير الحالي كسابق
    sad_ll_memcpy(kbd_prev_report، buf، 8)

    # تحديث المفاتيح المضغوطة
    kbd_pressed_0 = sad_ll_mem_read8(buf + 2) + 0
    kbd_pressed_1 = sad_ll_mem_read8(buf + 3) + 0
    kbd_pressed_2 = sad_ll_mem_read8(buf + 4) + 0
    kbd_pressed_3 = sad_ll_mem_read8(buf + 5) + 0
    kbd_pressed_4 = sad_ll_mem_read8(buf + 6) + 0
    kbd_pressed_5 = sad_ll_mem_read8(buf + 7) + 0

    ارجع 1
نهاية

