# ═══════════════════════════════════════════════════════════════════════════════
# تهيئة HID
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة hid_هيئ()
    hid_serial_اطبع("[HID] تهيئة تعريفات HID...")
    hid_serial_سطر()

    # تخصيص مخازن
    kbd_report_buf = sad_ll_kmalloc(16) + 0
    kbd_prev_report = sad_ll_kmalloc(16) + 0
    kbd_event_buf = sad_ll_kmalloc(KBD_BUF_SIZE) + 0
    mouse_report_buf = sad_ll_kmalloc(16) + 0
    mouse_event_buf = sad_ll_kmalloc(MOUSE_BUF_SIZE * 4) + 0

    sad_ll_memset(kbd_report_buf، 0، 16)
    sad_ll_memset(kbd_prev_report، 0، 16)
    sad_ll_memset(kbd_event_buf، 0، KBD_BUF_SIZE)
    sad_ll_memset(mouse_report_buf، 0، 16)
    sad_ll_memset(mouse_event_buf، 0، MOUSE_BUF_SIZE * 4)

    kbd_event_head = 0
    kbd_event_tail = 0
    mouse_event_head = 0
    mouse_event_tail = 0

    kbd_modifiers = 0
    kbd_capslock = 0
    mouse_x = mouse_max_x / 2
    mouse_y = mouse_max_y / 2

    # البحث عن لوحة مفاتيح
    متغير kb_idx = usb_find_keyboard() + 0
    إذا (kb_idx >= 0)
        kbd_dev_idx = kb_idx + 0
        kbd_active = 1
        kbd_dev_addr = kb_idx + 1  # simplified: dev_addr = idx + 1
        hid_serial_اطبع("[HID] Keyboard found at dev #")
        hid_serial_رقم(kb_idx + 0)
        hid_serial_سطر()
    والا
        hid_serial_اطبع("[HID] No keyboard found")
        hid_serial_سطر()
    نهاية

    # البحث عن ماوس
    متغير ms_idx = usb_find_mouse() + 0
    إذا (ms_idx >= 0)
        mouse_dev_idx = ms_idx + 0
        mouse_active = 1
        mouse_dev_addr = ms_idx + 1
        hid_serial_اطبع("[HID] Mouse found at dev #")
        hid_serial_رقم(ms_idx + 0)
        hid_serial_سطر()
    والا
        hid_serial_اطبع("[HID] No mouse found")
        hid_serial_سطر()
    نهاية

    hid_serial_اطبع("[HID] جاهز")
    hid_serial_سطر()
    ارجع kbd_active + mouse_active
نهاية

