## خط ثابت 8×8 — فقط ASCII 32-127
## كل حرف = 8 بايتات (صفوف) × 8 بتات (أعمدة)
## نخزن فقط الأحرف الأساسية في مصفوفة مسطحة

## مخزن الخط (يُعبأ عند التهيئة)
متغير font_عنوان = 0

## تهيئة الخط
دالة هيئ_الخط()
    # تخصيص صفحة للخط (768 بايت كافية — 96 حرف × 8 بايت)
    font_عنوان = gui_خصص_صفحة()
    إذا (font_عنوان == 0)
        ارجع -1
    نهاية
    gui_املأ_ذاكرة(font_عنوان، 0، 4096)
    
    # تعبئة بعض الأحرف الأساسية
    # مسافة (32) — كل الصفوف صفر
    # بقية الأحرف تُعبّأ بنمط بسيط
    
    # نمط عام لكل حرف غير معرّف: مستطيل ممتلئ
    متغير ف = 0
    بينما (ف < 96)
        متغير عنوان_حرف = font_عنوان + (ف * 8)
        # كل حرف: صف0=0x00, صف1-6=0x7E, صف7=0x00
        gui_اكتب_ذاكرة(عنوان_حرف، 0)
        gui_اكتب_ذاكرة(عنوان_حرف + 1، 126)
        gui_اكتب_ذاكرة(عنوان_حرف + 2، 126)
        gui_اكتب_ذاكرة(عنوان_حرف + 3، 126)
        gui_اكتب_ذاكرة(عنوان_حرف + 4، 126)
        gui_اكتب_ذاكرة(عنوان_حرف + 5، 126)
        gui_اكتب_ذاكرة(عنوان_حرف + 6، 126)
        gui_اكتب_ذاكرة(عنوان_حرف + 7، 0)
        ف = ف + 1
    نهاية
    
    # مسافة (index 0 = ASCII 32) — فارغ
    gui_املأ_ذاكرة(font_عنوان، 0، 8)
    
    # الحرف 'A' (index 33 = ASCII 65)
    متغير عنوان_A = font_عنوان + (33 * 8)
    gui_اكتب_ذاكرة(عنوان_A + 0، 24)    # 0x18 = ...##...
    gui_اكتب_ذاكرة(عنوان_A + 1، 60)    # 0x3C = ..####.
    gui_اكتب_ذاكرة(عنوان_A + 2، 102)   # 0x66 = .##..##
    gui_اكتب_ذاكرة(عنوان_A + 3، 126)   # 0x7E = .######
    gui_اكتب_ذاكرة(عنوان_A + 4، 102)   # 0x66 = .##..##
    gui_اكتب_ذاكرة(عنوان_A + 5، 102)
    gui_اكتب_ذاكرة(عنوان_A + 6، 102)
    gui_اكتب_ذاكرة(عنوان_A + 7، 0)
    
    ارجع 0
نهاية

## رسم حرف واحد
دالة ارسم_حرف(حرف_ascii، سطح_x، سطح_y، لون_الحرف)
    إذا (حرف_ascii < 32)
        ارجع
    نهاية
    إذا (حرف_ascii > 127)
        ارجع
    نهاية
    
    متغير فهرس = حرف_ascii - 32
    متغير عنوان_حرف = font_عنوان + (فهرس * 8)
    
    متغير صف = 0
    بينما (صف < 8)
        متغير بيانات_الصف = gui_اقرأ_ذاكرة(عنوان_حرف + صف)
        متغير عمود = 0
        بينما (عمود < 8)
            متغير بت = 128   # shift right
            متغير ش = 0
            بينما (ش < عمود)
                بت = بت / 2
                ش = ش + 1
            نهاية
            
            إذا ((بيانات_الصف / بت) % 2 == 1)
                gui_fb_pixel(سطح_x + عمود، سطح_y + صف، لون_الحرف)
            نهاية
            عمود = عمود + 1
        نهاية
        صف = صف + 1
    نهاية
نهاية

## رسم نص (مصفوفة أحرف ASCII)
دالة ارسم_نص_ذاكرة(عنوان_النص، طول_النص، سطح_x، سطح_y، لون_الحرف)
    متغير ف = 0
    بينما (ف < طول_النص)
        متغير عنوان_القراءة = عنوان_النص + ف
        ## قراءة بايت واحد
        متغير زوج = gui_اقرأ_ذاكرة16(عنوان_القراءة - (عنوان_القراءة % 2))
        متغير الحرف = زوج % 256
        إذا (عنوان_القراءة % 2 == 1)
            الحرف = زوج / 256
        نهاية
        ارسم_حرف(الحرف، سطح_x + (ف * 8)، سطح_y، لون_الحرف)
        ف = ف + 1
    نهاية
نهاية

