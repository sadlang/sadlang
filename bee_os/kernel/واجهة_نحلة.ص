## فحص نقر على نافذة
دالة جد_نافذة_عند(سطح_x، سطح_y)
    ## البحث من الأمام للخلف (أعلى z أولاً)
    متغير أفضل = -1
    متغير أعلى_z = -1
    
    متغير ف = 0
    بينما (ف < MAX_WINDOWS)
        إذا (win_حالة[ف] != WIN_FREE)
            إذا (win_حالة[ف] != WIN_MINIMIZED)
                إذا (سطح_x >= win_x[ف])
                    إذا (سطح_y >= win_y[ف])
                        إذا (سطح_x < win_x[ف] + win_w[ف])
                            إذا (سطح_y < win_y[ف] + win_h[ف])
                                إذا (win_z[ف] > أعلى_z)
                                    أعلى_z = win_z[ف]
                                    أفضل = ف
                                نهاية
                            نهاية
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    
    ارجع أفضل
نهاية

## فحص نقر على أزرار العنوان
## يُعيد: 0=لا شيء، 1=إغلاق، 2=تكبير، 3=تصغير، 4=شريط عنوان
دالة فحص_أزرار(فهرس، سطح_x، سطح_y)
    متغير wx = win_x[فهرس]
    متغير wy = win_y[فهرس]
    متغير ww = win_w[فهرس]
    
    # هل النقطة في شريط العنوان؟
    إذا (سطح_y < wy + BORDER_W)
        ارجع 0
    نهاية
    إذا (سطح_y > wy + BORDER_W + TITLEBAR_H)
        ارجع 0
    نهاية
    
    # زر إغلاق
    متغير close_x = wx + ww - BORDER_W - BTN_SIZE - 2
    إذا (سطح_x >= close_x)
        إذا (سطح_x <= close_x + BTN_SIZE)
            ارجع 1
        نهاية
    نهاية
    
    # زر تكبير
    متغير max_x = close_x - BTN_SIZE - 2
    إذا (سطح_x >= max_x)
        إذا (سطح_x <= max_x + BTN_SIZE)
            ارجع 2
        نهاية
    نهاية
    
    # زر تصغير
    متغير min_x = max_x - BTN_SIZE - 2
    إذا (سطح_x >= min_x)
        إذا (سطح_x <= min_x + BTN_SIZE)
            ارجع 3
        نهاية
    نهاية
    
    # باقي شريط العنوان
    ارجع 4
نهاية

## فحص مقبض تغيير الحجم
