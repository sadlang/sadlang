## عدد النوافذ المفتوحة
صدّر دالة gui_عدد_النوافذ()
    متغير عدد = 0
    متغير ف = 0
    بينما (ف < MAX_WINDOWS)
        إذا (win_حالة[ف] != WIN_FREE)
            عدد = عدد + 1
        نهاية
        ف = ف + 1
    نهاية
    ارجع عدد
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ١١: اختبارات
## ═══════════════════════════════════════════════════════════════

صدّر دالة اختبر_الواجهة()
    gui_serial_char(COM1، 91)
    gui_serial_char(COM1، 71)  # G
    gui_serial_char(COM1، 85)  # U
    gui_serial_char(COM1، 73)  # I
    gui_serial_char(COM1، 93)
    gui_serial_char(COM1، 10)
    
    متغير نجاح = 0
    
    # اختبار 1: تهيئة النوافذ
    متغير ف = 0
    بينما (ف < MAX_WINDOWS)
        win_حالة[ف] = WIN_FREE
        ف = ف + 1
    نهاية
    
    # اختبار 2: إنشاء نافذة
    متغير n1 = gui_أنشئ_نافذة(50، 50، 200، 150، WIN_TYPE_FILEBROWSER)
    إذا (n1 >= 0)
        نجاح = نجاح + 1
    نهاية
    gui_اطبع_رقم(n1)
    gui_serial_char(COM1، 32)
    
    # اختبار 3: إنشاء نافذة ثانية
    متغير n2 = gui_أنشئ_نافذة(100، 100، 300، 200، WIN_TYPE_EDITOR)
    إذا (n2 >= 0)
        نجاح = نجاح + 1
    نهاية
    
    # اختبار 4: عدد النوافذ
    إذا (gui_عدد_النوافذ() == 2)
        نجاح = نجاح + 1
    نهاية
    
    # اختبار 5: تكبير
    gui_كبّر_نافذة(n1)
    إذا (win_حالة[n1] == WIN_MAXIMIZED)
        نجاح = نجاح + 1
    نهاية
    إذا (win_w[n1] == SCREEN_W)
        نجاح = نجاح + 1
    نهاية
    
    # اختبار 6: استعادة
    gui_كبّر_نافذة(n1)
    إذا (win_حالة[n1] == WIN_NORMAL)
        نجاح = نجاح + 1
    نهاية
    إذا (win_w[n1] == 200)
        نجاح = نجاح + 1
    نهاية
    
    # اختبار 7: تصغير
    gui_صغّر_نافذة(n2)
    إذا (win_حالة[n2] == WIN_MINIMIZED)
        نجاح = نجاح + 1
    نهاية
    
    # اختبار 8: إغلاق
    gui_أغلق_نافذة(n1)
    إذا (win_حالة[n1] == WIN_FREE)
        نجاح = نجاح + 1
    نهاية
    إذا (gui_عدد_النوافذ() == 1)
        نجاح = نجاح + 1
    نهاية
    
    # اختبار 9: النافذة النشطة
    gui_أغلق_نافذة(n2)
    إذا (active_win == -1)
        نجاح = نجاح + 1
    نهاية
    
    gui_serial_char(COM1، 10)
    gui_اطبع_رقم(نجاح)
    gui_serial_char(COM1، 47) # /
    gui_اطبع_رقم(11)
    gui_serial_char(COM1، 10)
نهاية
