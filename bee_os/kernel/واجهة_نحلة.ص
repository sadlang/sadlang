## القسم ٨: تهيئة الواجهة الرسومية
## ═══════════════════════════════════════════════════════════════

صدّر دالة هيئ_الواجهة()
    # تهيئة framebuffer
    gui_fb_init(SCREEN_W، SCREEN_H، BPP)
    
    # تهيئة الخط
    هيئ_الخط()
    
    # تهيئة الماوس
    هيئ_الماوس()
    
    # مسح جدول النوافذ
    متغير ف = 0
    بينما (ف < MAX_WINDOWS)
        win_حالة[ف] = WIN_FREE
        win_نوع[ف] = 0
        win_x[ف] = 0
        win_y[ف] = 0
        win_w[ف] = 0
        win_h[ف] = 0
        win_z[ف] = 0
        win_بيانات[ف] = 0
        win_scroll_y[ف] = 0
        ف = ف + 1
    نهاية
    
    active_win = -1
    next_z = 1
    needs_redraw = 1
    gui_مهيأ = 1
    
    # رسم سطح المكتب الابتدائي
    أعد_الرسم()
    
    gui_serial_char(COM1، 91)  # [
    gui_serial_char(COM1، 71)  # G
    gui_serial_char(COM1، 85)  # U
    gui_serial_char(COM1، 73)  # I
    gui_serial_char(COM1، 93)  # ]
    gui_serial_char(COM1، 10)
    
    ارجع 0
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٩: الحلقة الرئيسية للواجهة
## ═══════════════════════════════════════════════════════════════

صدّر دالة gui_حلقة()
    إذا (gui_مهيأ == 0)
        ارجع
    نهاية
    
    # فحص أحداث الماوس
    متغير يسار_الآن = mouse_btns % 2
    متغير يسار_سابق = mouse_prev_btns % 2
    
    # نقر (ضغط جديد)
    إذا (يسار_الآن == 1)
        إذا (يسار_سابق == 0)
            عالج_نقر(mouse_x، mouse_y)
        نهاية
    نهاية
    
    # سحب
    إذا (يسار_الآن == 1)
        عالج_سحب()
        عالج_تغيير_حجم()
    نهاية
    
    # تحرير
    إذا (يسار_الآن == 0)
        إذا (يسار_سابق == 1)
            عالج_تحرير()
        نهاية
    نهاية
    
    # إعادة الرسم إذا لزم الأمر
    إذا (needs_redraw == 1)
        أعد_الرسم()
    نهاية
نهاية

