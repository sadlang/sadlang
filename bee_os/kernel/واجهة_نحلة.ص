## إنشاء نافذة جديدة
صدّر دالة gui_أنشئ_نافذة(wx، wy، ww، wh، نوع_نافذة)
    متغير ف = 0
    بينما (ف < MAX_WINDOWS)
        إذا (win_حالة[ف] == WIN_FREE)
            win_حالة[ف] = WIN_NORMAL
            win_نوع[ف] = نوع_نافذة
            win_x[ف] = wx
            win_y[ف] = wy
            win_w[ف] = ww
            win_h[ف] = wh
            win_z[ف] = next_z
            win_بيانات[ف] = 0
            win_normal_x[ف] = wx
            win_normal_y[ف] = wy
            win_normal_w[ف] = ww
            win_normal_h[ف] = wh
            win_scroll_y[ف] = 0
            next_z = next_z + 1
            active_win = ف
            needs_redraw = 1
            ارجع ف
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

## إغلاق نافذة
صدّر دالة gui_أغلق_نافذة(فهرس)
    إذا (فهرس < 0)
        ارجع
    نهاية
    إذا (فهرس >= MAX_WINDOWS)
        ارجع
    نهاية
    
    # تحرير بيانات النافذة
    إذا (win_بيانات[فهرس] != 0)
        gui_حرر_صفحة(win_بيانات[فهرس])
    نهاية
    
    win_حالة[فهرس] = WIN_FREE
    win_بيانات[فهرس] = 0
    
    # إذا كانت النافذة النشطة، اختر أخرى
    إذا (active_win == فهرس)
        active_win = -1
        متغير أعلى_z = 0
        متغير ف = 0
        بينما (ف < MAX_WINDOWS)
            إذا (win_حالة[ف] != WIN_FREE)
                إذا (win_حالة[ف] != WIN_MINIMIZED)
                    إذا (win_z[ف] > أعلى_z)
                        أعلى_z = win_z[ف]
                        active_win = ف
                    نهاية
                نهاية
            نهاية
            ف = ف + 1
        نهاية
    نهاية
    
    needs_redraw = 1
