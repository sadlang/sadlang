## كتابة أمر للماوس عبر PS/2 controller
دالة mouse_انتظر_كتابة()
    متغير محاولات = 0
    بينما (محاولات < 10000)
        متغير حالة_ctrl = gui_inb(MOUSE_CMD)
        إذا ((حالة_ctrl / 2) % 2 == 0)
            ارجع 0
        نهاية
        محاولات = محاولات + 1
    نهاية
    ارجع -1
نهاية

دالة mouse_انتظر_قراءة()
    متغير محاولات = 0
    بينما (محاولات < 10000)
        متغير حالة_ctrl = gui_inb(MOUSE_CMD)
        إذا (حالة_ctrl % 2 == 1)
            ارجع 0
        نهاية
        محاولات = محاولات + 1
    نهاية
    ارجع -1
نهاية

دالة mouse_أرسل_أمر(الأمر)
    mouse_انتظر_كتابة()
    gui_outb(MOUSE_CMD، 212)    # 0xD4 = Write to aux port
    mouse_انتظر_كتابة()
    gui_outb(MOUSE_DATA، الأمر)
    mouse_انتظر_قراءة()
    ارجع gui_inb(MOUSE_DATA)   # ACK
نهاية

## تهيئة الماوس PS/2
صدّر دالة هيئ_الماوس()
    # تمكين المنفذ الثانوي (PS/2 aux port)
    mouse_انتظر_كتابة()
    gui_outb(MOUSE_CMD، 168)    # 0xA8 = Enable auxiliary device
    
    # الحصول على "Compaq Status Byte"
    mouse_انتظر_كتابة()
    gui_outb(MOUSE_CMD، 32)     # 0x20 = Read controller config
    mouse_انتظر_قراءة()
    متغير config = gui_inb(MOUSE_DATA)
    
    # تمكين IRQ12 (بت 1)
    config = config + 2   # ضبط بت 1 تقريبياً
    
    mouse_انتظر_كتابة()
    gui_outb(MOUSE_CMD، 96)     # 0x60 = Write controller config
    mouse_انتظر_كتابة()
    gui_outb(MOUSE_DATA، config)
    
    # إعادة تعيين الماوس
    mouse_أرسل_أمر(255)         # 0xFF = Reset
    mouse_انتظر_قراءة()
    gui_inb(MOUSE_DATA)         # Self-test pass (0xAA)
    mouse_انتظر_قراءة()
    gui_inb(MOUSE_DATA)         # Device ID
    
    # تمكين البث (streaming mode)
    mouse_أرسل_أمر(244)         # 0xF4 = Enable data reporting
    
    mouse_x = SCREEN_W / 2
    mouse_y = SCREEN_H / 2
    mouse_btns = 0
    mouse_byte_count = 0
    mouse_مهيأ = 1
    
    gui_serial_char(COM1، 77)  # M
    gui_serial_char(COM1، 79)  # O
    gui_serial_char(COM1، 75)  # K
    gui_serial_char(COM1، 10)
    
    ارجع 0
نهاية

## معالجة بايت ماوس (يُستدعى من IRQ12)
صدّر دالة mouse_معالج_بايت(بايت_الماوس)
    إذا (mouse_byte_count == 0)
        mouse_byte0 = بايت_الماوس
        mouse_byte_count = 1
    نهاية
    إذا (mouse_byte_count == 1)
        إذا (بايت_الماوس != mouse_byte0)
            mouse_byte1 = بايت_الماوس
            mouse_byte_count = 2
        نهاية
    نهاية
    إذا (mouse_byte_count == 2)
        إذا (بايت_الماوس != mouse_byte1)
            mouse_byte2 = بايت_الماوس
            mouse_byte_count = 0
            
            # فك الحزمة
            mouse_prev_btns = mouse_btns + 0
            mouse_btns = mouse_byte0 % 8  # أقل 3 بتات
            
            # delta X (مع الإشارة)
            متغير dx = mouse_byte1
            إذا ((mouse_byte0 / 16) % 2 == 1)
                dx = dx - 256  # X sign bit
            نهاية
            
            # delta Y (مع الإشارة) — PS/2 Y مقلوب
            متغير dy = mouse_byte2
            إذا ((mouse_byte0 / 32) % 2 == 1)
                dy = dy - 256  # Y sign bit
            نهاية
            
            # تحديث الموقع
            mouse_x = mouse_x + dx
            mouse_y = mouse_y - dy   # عكس Y
            
            # حدود الشاشة
            إذا (mouse_x < 0)
                mouse_x = 0
            نهاية
            إذا (mouse_x >= SCREEN_W)
                mouse_x = SCREEN_W - 1
            نهاية
            إذا (mouse_y < 0)
                mouse_y = 0
            نهاية
            إذا (mouse_y >= SCREEN_H)
                mouse_y = SCREEN_H - 1
            نهاية
            
            needs_redraw = 1
        نهاية
    نهاية
نهاية

