## معالجة أحداث النقر
صدّر دالة عالج_نقر(سطح_x، سطح_y)
    # فحص شريط المهام أولاً
    متغير tb_result = فحص_شريط_المهام(سطح_x، سطح_y)
    
    إذا (tb_result == -2)
        # Start — فتح متصفح ملفات جديد
        gui_أنشئ_نافذة(50، 50، 400، 350، WIN_TYPE_FILEBROWSER)
        ارجع
    نهاية
    
    إذا (tb_result >= 0)
        # نقر على زر نافذة في شريط المهام
        إذا (win_حالة[tb_result] == WIN_MINIMIZED)
            win_حالة[tb_result] = WIN_NORMAL
            gui_رفع_نافذة(tb_result)
        وإلا
            إذا (tb_result == active_win)
                gui_صغّر_نافذة(tb_result)
            وإلا
                gui_رفع_نافذة(tb_result)
            نهاية
        نهاية
        ارجع
    نهاية
    
    # فحص النوافذ
    متغير نافذة = جد_نافذة_عند(سطح_x، سطح_y)
    
    إذا (نافذة < 0)
        ارجع
    نهاية
    
    # رفع النافذة للأمام
    gui_رفع_نافذة(نافذة)
    
    # فحص مقبض تغيير الحجم
    إذا (فحص_مقبض_حجم(نافذة، سطح_x، سطح_y) == 1)
        resize_active = 1
        resize_win = نافذة
        resize_start_x = سطح_x
        resize_start_y = سطح_y
        resize_orig_w = win_w[نافذة]
        resize_orig_h = win_h[نافذة]
        ارجع
    نهاية
    
    # فحص أزرار العنوان
    متغير زر = فحص_أزرار(نافذة، سطح_x، سطح_y)
    
    إذا (زر == 1)
        gui_أغلق_نافذة(نافذة)
        ارجع
    نهاية
    
    إذا (زر == 2)
        gui_كبّر_نافذة(نافذة)
        ارجع
    نهاية
    
    إذا (زر == 3)
        gui_صغّر_نافذة(نافذة)
        ارجع
    نهاية
    
    إذا (زر == 4)
        # بدء السحب
        إذا (win_حالة[نافذة] != WIN_MAXIMIZED)
            drag_active = 1
            drag_win = نافذة
            drag_offset_x = سطح_x - win_x[نافذة]
            drag_offset_y = سطح_y - win_y[نافذة]
        نهاية
        ارجع
    نهاية
نهاية

## معالجة السحب
دالة عالج_سحب()
    إذا (drag_active == 0)
        ارجع
    نهاية
    
    # تحديث موقع النافذة
    متغير new_x = mouse_x - drag_offset_x
    متغير new_y = mouse_y - drag_offset_y
    
    # حدود
    إذا (new_x < 0)
        new_x = 0
    نهاية
    إذا (new_y < 0)
        new_y = 0
    نهاية
    إذا (new_x + win_w[drag_win] > SCREEN_W)
        new_x = SCREEN_W - win_w[drag_win]
    نهاية
    إذا (new_y + win_h[drag_win] > TASKBAR_Y)
        new_y = TASKBAR_Y - win_h[drag_win]
    نهاية
    
    win_x[drag_win] = new_x
    win_y[drag_win] = new_y
    needs_redraw = 1
نهاية

## معالجة تغيير الحجم
دالة عالج_تغيير_حجم()
    إذا (resize_active == 0)
        ارجع
    نهاية
    
    متغير dx = mouse_x - resize_start_x
    متغير dy = mouse_y - resize_start_y
    
    متغير new_w = resize_orig_w + dx
    متغير new_h = resize_orig_h + dy
    
    إذا (new_w < MIN_WIN_W)
        new_w = MIN_WIN_W
    نهاية
    إذا (new_h < MIN_WIN_H)
        new_h = MIN_WIN_H
    نهاية
    إذا (new_w > SCREEN_W)
        new_w = SCREEN_W
    نهاية
    إذا (new_h > TASKBAR_Y)
        new_h = TASKBAR_Y
    نهاية
    
    win_w[resize_win] = new_w
    win_h[resize_win] = new_h
    needs_redraw = 1
نهاية

