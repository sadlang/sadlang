#**
 * نواة.ص — نقطة الدخول الرئيسية لنظام النحلة BeeOS
 * BeeOS Kernel Entry Point — الملكة والعسل
 *
 * هذا الملف هو قلب نظام التشغيل — "الملكة"
 * يُنسق بين جميع وحدات النواة:
 *   1. شاشة.ص   — الشاشة والعرض
 *   2. ذاكرة.ص  — إدارة الذاكرة
 *   3. مقاطعات.ص — معالجة المقاطعات
 *   4. جدولة.ص  — جدولة المهام
 *
 * مسار الإقلاع:
 *   Bootloader (Limine/UEFI) 
 *   → entry.asm (إعداد Stack + GDT)
 *   → نواة_رئيسية() ← هنا
 *   → حلقة المنتظرة (Idle Loop)
 *
 * @version 0.1.0 — BeeOS Alpha
 * @date 2026
 **#

# ===================================================================
# إصدار BeeOS
# ===================================================================

متغير إصدار_رئيسي    = 0
متغير إصدار_فرعي     = 1
متغير إصدار_تصحيح    = 0
متغير اسم_الإصدار    = "Alpha"
متغير تاريخ_البناء   = "2026-02-27"

# ===================================================================
# تضمين وحدات النواة (محاكاة الاستيراد)
# ===================================================================

# استورد "kernel/شاشة"      كـ وحدة_الشاشة
# استورد "kernel/ذاكرة"     كـ وحدة_الذاكرة
# استورد "kernel/مقاطعات"   كـ وحدة_المقاطعات
# استورد "kernel/جدولة"     كـ وحدة_الجدولة

# ===================================================================
# نظام هراء الذعر (Kernel Panic)
# ===================================================================

دالة نواة_هلع(سبب_الهلع)
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════════════════════╗")
    اطبع_سطر("║          💀  KERNEL PANIC  💀            ║")
    اطبع_سطر("║          ذعر النواة                      ║")
    اطبع_سطر("╠══════════════════════════════════════════╣")
    اطبع_سطر("║  السبب: " + سبب_الهلع)
    اطبع_سطر("║                                          ║")
    اطبع_سطر("║  النظام متوقف — أعد التشغيل يدوياً      ║")
    اطبع_سطر("╚══════════════════════════════════════════╝")
    # في الوضع الحقيقي: HLT في حلقة لا نهائية
    ارجع خطأ
نهاية

