#   الجزء الثامن: نظام الأوامر التفاعلي (Serial Console)
# ═══════════════════════════════════════════════════════════════════════════════
#
# وحدة تحكم بسيطة عبر المنفذ التسلسلي.
# المستخدم يكتب أوامر من terminal QEMU والنواة تردّ.
#
# الأوامر المدعومة:
#   help    — عرض المساعدة
#   status  — عرض حالة النظام
#   ticks   — عرض عدد نبضات المؤقت
#   keys    — عرض عدد ضغطات لوحة المفاتيح
#   reboot  — إعادة تشغيل (TODO)
#   clear   — مسح الشاشة الطرفية (ANSI)
# ═══════════════════════════════════════════════════════════════════════════════

## قراءة سطر كامل من المنفذ التسلسلي (حتى Enter)
## يقرأ حرفاً بحرف ويطبع الصدى (echo)
## الحد الأقصى: 128 حرف
## ارجع: عدد الأحرف المقروءة
دالة اقرأ_سطر_تسلسلي(رقم_المنفذ، مخزن)
    متغير موقع = 0
    متغير الحد = 127    # حرف واحد للـ null terminator
    
    بينما (موقع < الحد)
        # انتظار وقراءة حرف
        متغير متوفر = انتظر_بيانات(رقم_المنفذ)
        إذا (متوفر == 0)
            تابع
        نهاية
        
        متغير حرف = اقرأ_منفذ(رقم_المنفذ + UART_RBR)
        
        # Enter — نهاية السطر
        إذا (حرف == 13)    # '\r' Carriage Return
            أرسل_بايت(رقم_المنفذ، 13)    # صدى CR
            أرسل_بايت(رقم_المنفذ، 10)    # صدى LF
            ارجع موقع
        نهاية
        
        # Backspace — حذف آخر حرف
        إذا (حرف == 8)
            إذا (موقع > 0)
                موقع = موقع - 1
                أرسل_بايت(رقم_المنفذ، 8)     # حرك المؤشر للخلف
                أرسل_بايت(رقم_المنفذ، 32)    # امسح بفراغ
                أرسل_بايت(رقم_المنفذ، 8)     # ارجع مجدداً
            نهاية
            تابع
        نهاية
        
        # حرف عادي — أضف للمخزن واطبع الصدى
        إذا (حرف >= 32)
            إذا (حرف < 127)
                # في نظام حقيقي: مخزن[موقع] = حرف
                أرسل_بايت(رقم_المنفذ، حرف)    # صدى الحرف
                موقع = موقع + 1
            نهاية
        نهاية
    نهاية
    
    ارجع موقع
نهاية


