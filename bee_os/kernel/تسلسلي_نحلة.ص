## طباعة تفريغ ذاكرة (Hex Dump) — مفيد جداً للتنقيح
## يعرض عنوان + بايتات hex + تمثيل ASCII
## عنوان_البداية: عنوان أول بايت
## الحجم: عدد البايتات لعرضها
## ملاحظة: هذه الدالة مبدئية — تحتاج وصول مباشر للذاكرة
صدّر دالة serial_تفريغ_ذاكرة(عنوان_البداية، الحجم)
    serial_اطبع("\n")
    serial_اطبع("╔══════════════════════════════════════════════════════╗\n")
    serial_اطبع("║  تفريغ ذاكرة (Hex Dump)                             ║\n")
    serial_اطبع("║  العنوان: ")
    serial_اطبع_hex(عنوان_البداية)
    serial_اطبع("  الحجم: ")
    serial_اطبع_رقم(الحجم)
    serial_اطبع(" بايت")
    serial_اطبع("                    ║\n")
    serial_اطبع("╠══════════════════════════════════════════════════════╣\n")
    
    # عرض صف صف (16 بايت لكل صف)
    متغير ط = 0
    بينما (ط < الحجم)
        # عنوان الصف
        serial_اطبع("║ ")
        serial_اطبع_hex(عنوان_البداية + ط)
        serial_اطبع(": ")
        
        # البايتات بالست عشري (سنعرض أصفار مبدئياً)
        متغير ج = 0
        بينما (ج < 16)
            إذا (ط + ج < الحجم)
                serial_اطبع("00 ")    # مبدئي — نحتاج قراءة فعلية
            وإلا
                serial_اطبع("   ")    # حشو للأسطر الأخيرة
            نهاية
            
            إذا (ج == 7)
                serial_اطبع(" ")    # فاصل في المنتصف
            نهاية
            ج = ج + 1
        نهاية
        
        serial_اطبع("║\n")
        ط = ط + 16
    نهاية
    
    serial_اطبع("╚══════════════════════════════════════════════════════╝\n")
نهاية

## طباعة شريط تقدم على Serial
## النسبة: 0-100
## العرض: عدد الأعمدة
صدّر دالة serial_شريط_تقدم(النسبة، العرض)
    serial_اطبع("[")
    
    متغير المملوء = (النسبة * العرض) / 100
    متغير ط = 0
    
    serial_لون(ANSI_أخضر)
    بينما (ط < العرض)
        إذا (ط < المملوء)
            أرسل_بايت(COM1، 35)    # '#' مملوء
        وإلا
            serial_لون(ANSI_أبيض)
            أرسل_بايت(COM1، 45)    # '-' فارغ
        نهاية
        ط = ط + 1
    نهاية
    
    serial_إعادة_لون()
    serial_اطبع("] ")
    serial_اطبع_رقم(النسبة)
    serial_اطبع("%")
نهاية

## طباعة جدول مُنسّق
## مفيد لعرض معلومات النظام
صدّر دالة serial_صف_جدول(العمود1، العمود2)
    serial_اطبع("  │ ")
    serial_لون(ANSI_سماوي)
    serial_اطبع(العمود1)
    serial_إعادة_لون()
    
    # حشو بفراغات (20 حرف كحد أقصى للعمود 1)
    متغير طول_النص = طول(العمود1)
    متغير ط = طول_النص
    بينما (ط < 20)
        أرسل_بايت(COM1، 32)    # فراغ
        ط = ط + 1
    نهاية
    
    serial_اطبع("│ ")
    serial_اطبع(العمود2)
    serial_اطبع_سطر("")
نهاية


