# ═══════════════════════════════════════════════════════════════════════════════
#   الجزء السابع: نظام السجلات (Logging System)
# ═══════════════════════════════════════════════════════════════════════════════
#
# نظام سجلات مُنظّم لتنقيح النواة.
# كل رسالة تحمل:
#   - الطابع الزمني (عدد نبضات المؤقت)
#   - المستوى (تنقيح/معلومة/تحذير/خطأ/حرج)
#   - المكون (مثل: "IDT", "SCHED", "MEM")
#   - الرسالة
#
# مستويات السجل:
#   0 = تتبع (TRACE)   — تفاصيل دقيقة جداً
#   1 = تنقيح (DEBUG)   — معلومات تنقيح
#   2 = معلومة (INFO)   — أحداث عادية
#   3 = تحذير (WARN)    — مشاكل محتملة
#   4 = خطأ (ERROR)     — أخطاء قابلة للاسترداد
#   5 = حرج (FATAL)     — النظام سيتوقف
# ═══════════════════════════════════════════════════════════════════════════════

# المستوى الأدنى المسموح بطباعته
# 0 = طباعة كل شيء، 5 = طباعة الأخطاء الحرجة فقط
متغير مستوى_السجل_الأدنى = 0

ثابت سجل_تتبع   = 0
ثابت سجل_تنقيح   = 1
ثابت سجل_معلومة  = 2
ثابت سجل_تحذير   = 3
ثابت سجل_خطأ     = 4
ثابت سجل_حرج     = 5

## تعيين مستوى السجل الأدنى
## لن تُطبع أي رسالة بمستوى أقل من هذا
صدّر دالة عيّن_مستوى_السجل(مستوى)
    مستوى_السجل_الأدنى = مستوى
نهاية

## كتابة سجل مُنسّق
## المستوى: ثابت سجل_* أعلاه
## المكون: اسم المكون (نص قصير)
## الرسالة: نص الرسالة
صدّر دالة سجّل(مستوى، مكون، رسالة)
    # تجاهل المستويات المنخفضة
    إذا (مستوى < مستوى_السجل_الأدنى)
        ارجع
    نهاية
    
    # لون حسب المستوى
    إذا (مستوى == سجل_تتبع)
        serial_لون(ANSI_أبيض)
        serial_اطبع("[TRACE")
    نهاية
    إذا (مستوى == سجل_تنقيح)
        serial_لون(ANSI_سماوي)
        serial_اطبع("[DEBUG")
    نهاية
    إذا (مستوى == سجل_معلومة)
        serial_لون(ANSI_أخضر)
        serial_اطبع("[INFO ")
    نهاية
    إذا (مستوى == سجل_تحذير)
        serial_لون(ANSI_أصفر)
        serial_اطبع("[WARN ")
    نهاية
    إذا (مستوى == سجل_خطأ)
        serial_لون(ANSI_أحمر)
        serial_اطبع("[ERROR")
    نهاية
    إذا (مستوى == سجل_حرج)
        serial_لون(ANSI_أحمر)
        serial_اطبع("[FATAL")
    نهاية
    
    serial_اطبع("] ")
    serial_إعادة_لون()
    
    # المكون
    serial_لون(ANSI_بنفسجي)
    serial_اطبع(مكون)
    serial_إعادة_لون()
    serial_اطبع(": ")
    
    # الرسالة
    serial_اطبع_سطر(رسالة)
نهاية


