#**
 * ═══════════════════════════════════════════════════════════════════════════════
 *                    تسلسلي_نحلة.ص — نظام الاتصال التسلسلي لنظام النحلة
 *                    BeeOS Serial Communication System
 * ═══════════════════════════════════════════════════════════════════════════════
 *
 * هذا الملف يُنفّذ نظام الاتصال التسلسلي (UART/Serial) الكامل لنظام النحلة.
 *
 * المنفذ التسلسلي هو أبسط وأهم وسيلة اتصال في تطوير أنظمة التشغيل.
 * QEMU يُعيد توجيه المنفذ التسلسلي إلى النافذة الطرفية (terminal)،
 * مما يجعله مثالياً للطباعة التنقيحية بدون الحاجة لشاشة رسومية.
 *
 * بنية UART 16550A:
 * ┌────────────────────────────────────────────────────────────────────┐
 * │                        UART 16550A Chip                           │
 * │  ┌──────────┬─────────────────────────────────────────────────┐   │
 * │  │  السجلات │ الوصف                                           │   │
 * │  ├──────────┼─────────────────────────────────────────────────┤   │
 * │  │ +0 (THR) │ مخزن الإرسال — كتابة بايت للإرسال              │   │
 * │  │ +0 (RBR) │ مخزن الاستقبال — قراءة بايت مُستقبَل           │   │
 * │  │ +0 (DLL) │ مقسم معدل البود (بايت منخفض) [DLAB=1]         │   │
 * │  │ +1 (IER) │ سجل تمكين المقاطعات                           │   │
 * │  │ +1 (DLH) │ مقسم معدل البود (بايت مرتفع) [DLAB=1]        │   │
 * │  │ +2 (IIR) │ سجل تعريف المقاطعة (قراءة)                   │   │
 * │  │ +2 (FCR) │ سجل التحكم بـ FIFO (كتابة)                    │   │
 * │  │ +3 (LCR) │ سجل التحكم بالخط — إعدادات البيانات           │   │
 * │  │ +4 (MCR) │ سجل التحكم بالمودم                             │   │
 * │  │ +5 (LSR) │ سجل حالة الخط — جاهزية الإرسال/الاستقبال      │   │
 * │  │ +6 (MSR) │ سجل حالة المودم                                │   │
 * │  │ +7 (SR)  │ سجل مؤقت (scratch register)                    │   │
 * │  └──────────┴─────────────────────────────────────────────────┘   │
 * │                                                                    │
 * │  إعدادات الخط (LCR):                                             │
 * │    بت 0-1: طول البيانات (00=5, 01=6, 10=7, 11=8 بت)             │
 * │    بت 2:   بتات التوقف (0=1, 1=2)                                │
 * │    بت 3-5: التكافؤ (parity)                                       │
 * │    بت 7:   DLAB (الوصول لسجلات البود)                             │
 * │                                                                    │
 * │  معدل البود = 115200 / مقسم                                      │
 * │    مقسم 1 → 115200 baud                                          │
 * │    مقسم 3 → 38400 baud                                           │
 * │    مقسم 12 → 9600 baud                                           │
 * └────────────────────────────────────────────────────────────────────┘
 *
 * المنافذ التسلسلية القياسية (x86):
 *   COM1: 0x3F8   (IRQ4)  — الأكثر شيوعاً
 *   COM2: 0x2F8   (IRQ3)
 *   COM3: 0x3E8   (IRQ4)
 *   COM4: 0x2E8   (IRQ3)
 *
 * @version 1.0.0
 * @date 2026
 * @author BeeOS Team
 **#

# ═══════════════════════════════════════════════════════════════════════════════
#   الجزء الأول: استيراد الدوال الخارجية (FFI)
# ═══════════════════════════════════════════════════════════════════════════════

## تهيئة المنفذ التسلسلي — تُعدّ UART 16550A
خارجي("sad_ll_serial_init") دالة هيئ_تسلسلي(رقم_المنفذ: رقم)

## كتابة حرف واحد (بايت) إلى المنفذ التسلسلي
## ينتظر حتى يكون المنفذ جاهزاً ثم يكتب
خارجي("sad_ll_serial_write_char") دالة اكتب_حرف(رقم_المنفذ: رقم، رمز: رقم)

## قراءة حرف واحد من المنفذ التسلسلي
## ينتظر حتى يتوفر بيان ثم يقرؤه
خارجي("sad_ll_serial_read_char") دالة اقرأ_حرف(رقم_المنفذ: رقم)

## قراءة بايت من منفذ I/O
خارجي("sad_ll_port_inb") دالة اقرأ_منفذ(رقم_المنفذ: رقم)

## كتابة بايت إلى منفذ I/O
خارجي("sad_ll_port_outb") دالة اكتب_منفذ(رقم_المنفذ: رقم، قيمة: رقم)


# ═══════════════════════════════════════════════════════════════════════════════
#   الجزء الثاني: الثوابت
# ═══════════════════════════════════════════════════════════════════════════════
#
# عناوين المنافذ التسلسلية ومواقع سجلاتها
# ═══════════════════════════════════════════════════════════════════════════════

# ──────────────── عناوين المنافذ الأساسية ────────────────
ثابت COM1 = 0x3F8       # المنفذ التسلسلي الأول
ثابت COM2 = 0x2F8       # المنفذ التسلسلي الثاني
ثابت COM3 = 0x3E8       # المنفذ التسلسلي الثالث
ثابت COM4 = 0x2E8       # المنفذ التسلسلي الرابع

# ──────────────── إزاحات السجلات (بالنسبة للعنوان الأساسي) ────────────────
# مثال: سجل IER لـ COM1 = COM1 + 1 = 0x3F9

ثابت UART_THR = 0       # مخزن الإرسال (Transmit Holding Register) — كتابة
ثابت UART_RBR = 0       # مخزن الاستقبال (Receive Buffer Register) — قراءة
ثابت UART_DLL = 0       # مقسم البود السفلي (DLAB=1)
ثابت UART_IER = 1       # سجل تمكين المقاطعات (Interrupt Enable Register)
ثابت UART_DLH = 1       # مقسم البود العلوي (DLAB=1)
ثابت UART_IIR = 2       # سجل تعريف المقاطعة (قراءة فقط)
ثابت UART_FCR = 2       # سجل التحكم بـ FIFO (كتابة فقط)
ثابت UART_LCR = 3       # سجل التحكم بالخط (Line Control Register)
ثابت UART_MCR = 4       # سجل التحكم بالمودم (Modem Control Register)
ثابت UART_LSR = 5       # سجل حالة الخط (Line Status Register)
ثابت UART_MSR = 6       # سجل حالة المودم (Modem Status Register)
ثابت UART_SR  = 7       # سجل مؤقت (Scratch Register)

# ──────────────── بتات سجل حالة الخط (LSR) ────────────────
# هذا السجل يُخبرنا عن حالة الإرسال والاستقبال
ثابت LSR_DATA_READY    = 0x01    # بت 0: بيانات جاهزة للقراءة
ثابت LSR_OVERRUN_ERR   = 0x02    # بت 1: خطأ تجاوز (بيانات فُقدت)
ثابت LSR_PARITY_ERR    = 0x04    # بت 2: خطأ تكافؤ
ثابت LSR_FRAMING_ERR   = 0x08    # بت 3: خطأ إطار
ثابت LSR_BREAK_INT     = 0x10    # بت 4: كسر في الخط (Break)
ثابت LSR_THR_EMPTY     = 0x20    # بت 5: مخزن الإرسال فارغ — جاهز للكتابة!
ثابت LSR_TX_IDLE       = 0x40    # بت 6: المُرسل خامل (shift register فارغ)
ثابت LSR_FIFO_ERR      = 0x80    # بت 7: خطأ في FIFO

# ──────────────── بتات سجل تمكين المقاطعات (IER) ────────────────
ثابت IER_DATA_AVAIL    = 0x01    # بت 0: مقاطعة عند توفر بيانات للقراءة
ثابت IER_THR_EMPTY     = 0x02    # بت 1: مقاطعة عند فراغ مخزن الإرسال
ثابت IER_LINE_STATUS   = 0x04    # بت 2: مقاطعة عند تغيّر حالة الخط
ثابت IER_MODEM_STATUS  = 0x08    # بت 3: مقاطعة عند تغيّر حالة المودم

# ──────────────── بتات سجل التحكم بالخط (LCR) ────────────────
ثابت LCR_5BITS  = 0x00    # 5 بتات بيانات
ثابت LCR_6BITS  = 0x01    # 6 بتات بيانات
ثابت LCR_7BITS  = 0x02    # 7 بتات بيانات
ثابت LCR_8BITS  = 0x03    # 8 بتات بيانات ← الأكثر شيوعاً
ثابت LCR_1STOP  = 0x00    # بت توقف واحد
ثابت LCR_2STOP  = 0x04    # بتات توقف اثنان
ثابت LCR_NO_PARITY = 0x00 # بدون تكافؤ
ثابت LCR_DLAB   = 0x80    # DLAB — للوصول لسجلات البود

# ──────────────── بتات سجل التحكم بالمودم (MCR) ────────────────
ثابت MCR_DTR       = 0x01    # Data Terminal Ready
ثابت MCR_RTS       = 0x02    # Request To Send
ثابت MCR_OUT1      = 0x04    # Out1 (غير مُستخدم في PC)
ثابت MCR_OUT2      = 0x08    # Out2 — يجب تفعيله لتمكين مقاطعات UART
ثابت MCR_LOOPBACK  = 0x10    # وضع الحلقة المغلقة (للاختبار)

# ──────────────── بتات سجل التحكم بـ FIFO (FCR) ────────────────
ثابت FCR_ENABLE     = 0x01    # تفعيل FIFO
ثابت FCR_CLR_RECV   = 0x02    # مسح FIFO الاستقبال
ثابت FCR_CLR_SEND   = 0x04    # مسح FIFO الإرسال
ثابت FCR_TRIGGER_1  = 0x00    # عتبة المقاطعة: 1 بايت
ثابت FCR_TRIGGER_4  = 0x40    # عتبة المقاطعة: 4 بايتات
ثابت FCR_TRIGGER_8  = 0x80    # عتبة المقاطعة: 8 بايتات
ثابت FCR_TRIGGER_14 = 0xC0   # عتبة المقاطعة: 14 بايت

# ──────────────── معدلات البود الشائعة ────────────────
# المقسم = 115200 / معدل_البود
ثابت مقسم_115200 = 1     # أسرع معدل — الافتراضي لـ QEMU
ثابت مقسم_57600  = 2
ثابت مقسم_38400  = 3
ثابت مقسم_19200  = 6
ثابت مقسم_9600   = 12    # الأكثر توافقاً مع الأجهزة القديمة
ثابت مقسم_4800   = 24
ثابت مقسم_2400   = 48
ثابت مقسم_1200   = 96

# ──────────────── ثوابت الألوان لرسائل التنقيح ────────────────
# رموز ANSI للألوان — تعمل في معظم المحاكيات الطرفية
ثابت ANSI_أحمر    = 31
ثابت ANSI_أخضر    = 32
ثابت ANSI_أصفر    = 33
ثابت ANSI_أزرق    = 34
ثابت ANSI_بنفسجي  = 35
ثابت ANSI_سماوي   = 36
ثابت ANSI_أبيض    = 37
ثابت ANSI_إعادة   = 0

# ──────────────── حالة المنافذ ────────────────
# تتبع حالة كل منفذ تسلسلي
متغير COM1_مُهيّأ = 0
متغير COM2_مُهيّأ = 0
متغير COM3_مُهيّأ = 0
متغير COM4_مُهيّأ = 0

# ──────────────── إحصائيات ────────────────
متغير عدد_بايتات_مُرسَلة_COM1 = 0
متغير عدد_بايتات_مُستقبَلة_COM1 = 0
متغير عدد_أخطاء_COM1 = 0
متغير عدد_بايتات_مُرسَلة_COM2 = 0
متغير عدد_بايتات_مُستقبَلة_COM2 = 0


# ═══════════════════════════════════════════════════════════════════════════════
#   الجزء الثالث: تهيئة المنفذ التسلسلي
# ═══════════════════════════════════════════════════════════════════════════════
#
# تسلسل تهيئة UART 16550A:
#   1. تعطيل جميع المقاطعات (IER = 0)
#   2. تفعيل DLAB لتعيين معدل البود
#   3. كتابة مقسم البود (DLL, DLH)
#   4. إلغاء DLAB وتعيين إعدادات الخط (8N1)
#   5. تفعيل وتنظيف FIFO
#   6. تعيين MCR (DTR, RTS, OUT2)
#   7. اختبار الحلقة المغلقة (Loopback Test)
#   8. تفعيل المقاطعات (اختياري)
# ═══════════════════════════════════════════════════════════════════════════════

## تهيئة منفذ تسلسلي مع إعدادات كاملة
## رقم_المنفذ: عنوان I/O الأساسي (مثل COM1 = 0x3F8)
## معدل_البود: مقسم البود (1 = 115200, 12 = 9600)
## ارجع: 1 = نجاح, 0 = فشل
صدّر دالة هيئ_منفذ_تسلسلي(رقم_المنفذ، معدل_البود)
    # ──────── الخطوة 1: تعطيل المقاطعات ────────
    # نُعطّل كل مقاطعات UART أثناء التهيئة
    اكتب_منفذ(رقم_المنفذ + UART_IER، 0x00)
    
    # ──────── الخطوة 2: تفعيل DLAB ────────
    # DLAB = Divisor Latch Access Bit
    # عندما يكون DLAB = 1:
    #   السجل +0 → بايت المقسم المنخفض (DLL)
    #   السجل +1 → بايت المقسم المرتفع (DLH)
    اكتب_منفذ(رقم_المنفذ + UART_LCR، LCR_DLAB)
    
    # ──────── الخطوة 3: تعيين معدل البود ────────
    # المقسم 16-بت يُحدد معدل البود
    # معدل_البود = 115200 / مقسم
    اكتب_منفذ(رقم_المنفذ + UART_DLL، معدل_البود % 256)     # بايت منخفض
    اكتب_منفذ(رقم_المنفذ + UART_DLH، معدل_البود / 256)     # بايت مرتفع
    
    # ──────── الخطوة 4: إعدادات الخط (8N1) ────────
    # 8 بتات بيانات + لا تكافؤ + 1 بت توقف = الإعداد القياسي
    # هذا أيضاً يُلغي DLAB (بت 7 = 0)
    اكتب_منفذ(رقم_المنفذ + UART_LCR، LCR_8BITS)
    
    # ──────── الخطوة 5: تفعيل FIFO ────────
    # FIFO = First In First Out — مخزن مؤقت للبايتات
    # تفعيل + مسح FIFO الإرسال والاستقبال + عتبة 14 بايت
    اكتب_منفذ(رقم_المنفذ + UART_FCR، FCR_ENABLE + FCR_CLR_RECV + FCR_CLR_SEND + FCR_TRIGGER_14)
    
    # ──────── الخطوة 6: إعدادات المودم ────────
    # DTR (جاهز) + RTS (طلب إرسال) + OUT2 (تمكين مقاطعات)
    اكتب_منفذ(رقم_المنفذ + UART_MCR، MCR_DTR + MCR_RTS + MCR_OUT2)
    
    # ──────── الخطوة 7: اختبار الحلقة المغلقة ────────
    # نُفعّل وضع Loopback ونُرسل بايتاً، ثم نتأكد أنه وصل
    متغير نجح_الاختبار = اختبر_حلقة_مغلقة(رقم_المنفذ)
    
    إذا (نجح_الاختبار == 0)
        # فشل الاختبار — المنفذ غير موجود أو معطل
        ارجع 0
    نهاية
    
    # ──────── الخطوة 8: إعادة الوضع الطبيعي ────────
    # إلغاء وضع الحلقة المغلقة وتفعيل DTR + RTS + OUT2
    اكتب_منفذ(رقم_المنفذ + UART_MCR، MCR_DTR + MCR_RTS + MCR_OUT2)
    
    # تحديث حالة التهيئة
    إذا (رقم_المنفذ == COM1)
        COM1_مُهيّأ = 1
    نهاية
    إذا (رقم_المنفذ == COM2)
        COM2_مُهيّأ = 1
    نهاية
    إذا (رقم_المنفذ == COM3)
        COM3_مُهيّأ = 1
    نهاية
    إذا (رقم_المنفذ == COM4)
        COM4_مُهيّأ = 1
    نهاية
    
    ارجع 1
نهاية

## اختبار الحلقة المغلقة — يتأكد أن الـ UART يعمل
## يُفعّل وضع Loopback ويُرسل بايت اختبار 0xAE
## ثم يتأكد أنه استقبل نفس البايت
## ارجع: 1 = نجاح (UART يعمل)، 0 = فشل
دالة اختبر_حلقة_مغلقة(رقم_المنفذ)
    # تفعيل وضع Loopback + OUT1 + OUT2
    اكتب_منفذ(رقم_المنفذ + UART_MCR، MCR_LOOPBACK + MCR_OUT1 + MCR_OUT2)
    
    # إرسال بايت اختبار
    متغير بايت_اختبار = 0xAE
    اكتب_منفذ(رقم_المنفذ + UART_THR، بايت_اختبار)
    
    # قراءة البايت المُستقبَل
    متغير بايت_مُستقبَل = اقرأ_منفذ(رقم_المنفذ + UART_RBR)
    
    # مقارنة
    إذا (بايت_مُستقبَل == بايت_اختبار)
        ارجع 1
    نهاية
    
    ارجع 0
نهاية


# ═══════════════════════════════════════════════════════════════════════════════
#   الجزء الرابع: العمليات الأساسية — الإرسال والاستقبال
# ═══════════════════════════════════════════════════════════════════════════════
#
# كل عملية إرسال/استقبال تتبع نفس النمط:
#   1. فحص سجل حالة الخط (LSR)
#   2. انتظار الجاهزية
#   3. كتابة/قراءة البيان
#
# الانتظار ضروري لأن UART يعمل بسرعة ثابتة (معدل البود).
# عند 9600 بود: كل حرف يستغرق ~1ms
# عند 115200 بود: كل حرف يستغرق ~87µs
# ═══════════════════════════════════════════════════════════════════════════════

## هل المنفذ جاهز لقبول بايت جديد للإرسال؟
## يفحص بت THR_EMPTY في سجل حالة الخط
دالة هل_جاهز_للإرسال(رقم_المنفذ)
    متغير وضع_السجل = اقرأ_منفذ(رقم_المنفذ + UART_LSR)
    # فحص بت 5 (THR Empty)
    إذا ((وضع_السجل % 64) >= 32)
        ارجع 1
    نهاية
    ارجع 0
نهاية

## هل يوجد بيان جاهز للقراءة من المنفذ؟
## يفحص بت DATA_READY في سجل حالة الخط
دالة هل_يوجد_بيان(رقم_المنفذ)
    متغير وضع_السجل = اقرأ_منفذ(رقم_المنفذ + UART_LSR)
    # فحص بت 0 (Data Ready)
    إذا (وضع_السجل % 2 == 1)
        ارجع 1
    نهاية
    ارجع 0
نهاية

## انتظار حتى يكون المنفذ جاهزاً للإرسال
## تنبيه: قد تعلِّق النظام إذا لم يصبح المنفذ جاهزاً أبداً!
## في نظام حقيقي: أضف حداً أقصى للمحاولات (timeout)
دالة انتظر_جاهزية_إرسال(رقم_المنفذ)
    متغير محاولات = 0
    متغير الحد_الأقصى = 100000    # منع التعليق اللانهائي
    
    بينما (محاولات < الحد_الأقصى)
        إذا (هل_جاهز_للإرسال(رقم_المنفذ) == 1)
            ارجع 1    # جاهز!
        نهاية
        محاولات = محاولات + 1
    نهاية
    
    # انتهت المحاولات — المنفذ لا يستجيب
    عدد_أخطاء_COM1 = عدد_أخطاء_COM1 + 1
    ارجع 0
نهاية

## انتظار حتى تتوفر بيانات للقراءة
## ارجع: 1 = بيانات متوفرة، 0 = انتهت المهلة
دالة انتظر_بيانات(رقم_المنفذ)
    متغير محاولات = 0
    متغير الحد_الأقصى = 100000
    
    بينما (محاولات < الحد_الأقصى)
        إذا (هل_يوجد_بيان(رقم_المنفذ) == 1)
            ارجع 1
        نهاية
        محاولات = محاولات + 1
    نهاية
    
    ارجع 0
نهاية

## إرسال بايت واحد مع انتظار الجاهزية
## رقم_المنفذ: عنوان المنفذ (مثل COM1)
## بايت: القيمة (0-255)
صدّر دالة أرسل_بايت(رقم_المنفذ، قيمة)
