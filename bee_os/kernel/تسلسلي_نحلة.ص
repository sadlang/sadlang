        serial_اطبع("║    COM1: 115200 baud, 8N1                         ║\n")
        serial_اطبع("║                                                   ║\n")
        serial_اطبع("╚═══════════════════════════════════════════════════╝\n")
        serial_إعادة_لون()
        serial_اطبع("\n")
        
        سجّل(سجل_معلومة، "SERIAL"، "COM1 مُهيّأ بنجاح — 115200 baud, 8N1")
    وإلا
        # فشلت التهيئة — لا يمكننا حتى طباعة رسالة الخطأ!
        # نحاول الكتابة المباشرة كمحاولة أخيرة
        اكتب_منفذ(COM1، 69)    # 'E'
        اكتب_منفذ(COM1، 82)    # 'R'
        اكتب_منفذ(COM1، 82)    # 'R'
        اكتب_منفذ(COM1، 10)    # '\n'
    نهاية
    
    ارجع نتيجة
نهاية


