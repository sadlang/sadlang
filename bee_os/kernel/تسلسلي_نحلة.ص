    اكتب_منفذ(رقم_المنفذ + UART_THR، قيمة)
    
    # تحديث الإحصائيات
    إذا (رقم_المنفذ == COM1)
        عدد_بايتات_مُرسَلة_COM1 = عدد_بايتات_مُرسَلة_COM1 + 1
    نهاية
    إذا (رقم_المنفذ == COM2)
        عدد_بايتات_مُرسَلة_COM2 = عدد_بايتات_مُرسَلة_COM2 + 1
    نهاية
نهاية

## استقبال بايت واحد مع انتظار
