#**
 * مقاطعات.ص — وحدة معالجة المقاطعات لنظام النحلة BeeOS
 * Interrupt Handling — BeeAlarm (IDT + ISR + IRQ)
 *
 * التصميم: BeeAlarm
 *   صرخة (top-half < 1μs) → حارسة (threaded handler) → رقصة (event)
 *
 * جدول المقاطعات (IDT):
 *   0-31  : استثناءات المعالج (CPU Exceptions)
 *   32-47 : مقاطعات الأجهزة IRQ0-IRQ15
 *   48-255: مقاطعات البرمجيات (Syscalls, etc.)
 *
 * @version 0.1.0 — BeeOS Alpha
 * @date 2026
 **#

# ===================================================================
# ثوابت المقاطعات
# ===================================================================

متغير عدد_إدخالات_idt    = 256
متغير قاعدة_irq          = 32    # IRQ0 = الإدخال 32

# استثناءات المعالج
متغير استثناء_قسمة_صفر        = 0
متغير استثناء_تصحيح           = 1
متغير استثناء_nmi              = 2
متغير استثناء_نقطة_توقف        = 3
متغير استثناء_خطأ_مزدوج        = 8
متغير استثناء_خطأ_صفحة         = 14
متغير استثناء_حماية_عامة       = 13

# IRQ الأجهزة الشائعة
متغير irq_مؤقت               = 0   # IRQ0: المؤقت (Timer)
متغير irq_لوحة_مفاتيح         = 1   # IRQ1: لوحة المفاتيح
متغير irq_تسلسلي_2            = 3   # IRQ3: COM2
متغير irq_تسلسلي_1            = 4   # IRQ4: COM1
متغير irq_شبكة                = 11  # IRQ11: بطاقة الشبكة

# ===================================================================
# حالة نظام المقاطعات
# ===================================================================

متغير idt_مهيأ               = خطأ
متغير مقاطعات_مفعلة          = خطأ
متغير عداد_مقاطعات_مؤقت      = 0
متغير عداد_مقاطعات_لوحة_مفاتيح = 0
متغير عداد_مقاطعات_إجمالي    = 0

# جدول معالجات IRQ (محاكاة)
متغير معالجات_irq = []

# ===================================================================
# تهيئة IDT
# ===================================================================

دالة مقاطعات_تهيئة_idt()
    # في الوضع الحقيقي نملأ جدول IDT في الذاكرة
    # هنا نحاكي التهيئة
    idt_مهيأ = صحيح
    اطبع_سطر("[مقاطعات] ✓ IDT مهيأ — 256 إدخال")
    اطبع_سطر("[مقاطعات]   استثناءات CPU:       0-31")
    اطبع_سطر("[مقاطعات]   مقاطعات الأجهزة:   32-47  (IRQ0-IRQ15)")
    اطبع_سطر("[مقاطعات]   استدعاءات النظام: 48-255")
نهاية

دالة مقاطعات_تهيئة_pic()
    # إعادة تعيين PIC (8259A)
    # في الوضع الحقيقي: نكتب إلى منافذ 0x20 و 0xA0
    اطبع_سطر("[مقاطعات] ✓ PIC مُعاد إعداده — IRQ قاعدة: 32")
نهاية

دالة مقاطعات_تهيئة()
    مقاطعات_تهيئة_idt()
    مقاطعات_تهيئة_pic()
    مقاطعات_مفعلة = صحيح
    اطبع_سطر("[مقاطعات] ✓ نظام المقاطعات BeeAlarm جاهز")
نهاية

# ===================================================================
# تسجيل معالجات IRQ
# ===================================================================

دالة مقاطعات_سجل_معالج(رقم_irq، اسم_المعالج)
    إذا (رقم_irq < 0)
        اطبع_سطر("[مقاطعات] ✗ رقم IRQ غير صالح: " + رقم_irq)
        ارجع خطأ
    نهاية
    إذا (رقم_irq >= 16)
        اطبع_سطر("[مقاطعات] ✗ رقم IRQ خارج الحدود: " + رقم_irq)
        ارجع خطأ
    نهاية
    اطبع_سطر("[مقاطعات] ✓ تسجيل معالج IRQ" + رقم_irq + " → " + اسم_المعالج)
    ارجع صحيح
نهاية

# ===================================================================
# تفعيل / تعطيل المقاطعات
# ===================================================================

دالة مقاطعات_فعّل()
    # في الوضع الحقيقي: STI (Set Interrupt Flag)
    مقاطعات_مفعلة = صحيح
    اطبع_سطر("[مقاطعات] ✓ المقاطعات مفعّلة (STI)")
نهاية

دالة مقاطعات_عطّل()
    # في الوضع الحقيقي: CLI (Clear Interrupt Flag)
    مقاطعات_مفعلة = خطأ
    اطبع_سطر("[مقاطعات] ✓ المقاطعات معطّلة (CLI)")
نهاية

دالة مقاطعات_جاهزة()
    ارجع مقاطعات_مفعلة
نهاية

# ===================================================================
# محاكاة معالجة مقاطعات
# ===================================================================

## محاكاة وصول مقاطعة المؤقت
دالة مقاطعات_محاكاة_مؤقت()
    عداد_مقاطعات_مؤقت   = عداد_مقاطعات_مؤقت + 1
    عداد_مقاطعات_إجمالي = عداد_مقاطعات_إجمالي + 1
    # في الوضع الحقيقي: نُعلم المُجدوِل بتغيير المهمة
    ارجع صحيح
نهاية

## محاكاة ضغطة مفتاح
دالة مقاطعات_محاكاة_مفتاح(رمز_المفتاح)
    عداد_مقاطعات_لوحة_مفاتيح = عداد_مقاطعات_لوحة_مفاتيح + 1
    عداد_مقاطعات_إجمالي       = عداد_مقاطعات_إجمالي + 1
    اطبع_سطر("[لوحة مفاتيح] مفتاح: " + رمز_المفتاح)
    ارجع صحيح
نهاية

## معالج استثناء قسمة على صفر (محاكاة)
دالة مقاطعات_استثناء_قسمة_صفر()
    اطبع_سطر("[استثناء] ✗ قسمة على صفر! (Division by Zero)")
    اطبع_سطر("[استثناء]   النظام يتوقف (PANIC)...")
    ارجع خطأ
نهاية

## معالج خطأ الصفحة
دالة مقاطعات_استثناء_خطأ_صفحة(العنوان)
    اطبع_سطر("[استثناء] ✗ خطأ صفحة في العنوان: " + العنوان)
    ارجع خطأ
نهاية

# ===================================================================
# إحصائيات
# ===================================================================

دالة مقاطعات_إحصائيات()
    اطبع_سطر("┌──────────────────────────────┐")
    اطبع_سطر("│  إحصائيات BeeAlarm           │")
    اطبع_سطر("├──────────────────────────────┤")
    اطبع_سطر("│  IDT مهيأ:        " + idt_مهيأ)
    اطبع_سطر("│  مقاطعات مفعّلة:  " + مقاطعات_مفعلة)
    اطبع_سطر("│  ضربات المؤقت:    " + عداد_مقاطعات_مؤقت)
    اطبع_سطر("│  ضغطات لوحة مفاتيح: " + عداد_مقاطعات_لوحة_مفاتيح)
    اطبع_سطر("│  إجمالي المقاطعات: " + عداد_مقاطعات_إجمالي)
    اطبع_سطر("└──────────────────────────────┘")
نهاية

# ===================================================================
# اختبار الوحدة
# ===================================================================

اطبع_سطر("=== BeeOS — اختبار وحدة المقاطعات ===")
مقاطعات_تهيئة()

مقاطعات_سجل_معالج(0،  "bee_timer_handler")
مقاطعات_سجل_معالج(1،  "bee_keyboard_handler")
مقاطعات_سجل_معالج(11، "bee_network_handler")

مقاطعات_فعّل()

# محاكاة 5 ضربات مؤقت
متغير ن = 0
بينما (ن < 5)
    مقاطعات_محاكاة_مؤقت()
    ن = ن + 1
نهاية
اطبع_سطر("[اختبار] 5 ضربات مؤقت ✓")

# محاكاة ضغطات مفاتيح
مقاطعات_محاكاة_مفتاح("A")
مقاطعات_محاكاة_مفتاح("ب")

مقاطعات_إحصائيات()
اطبع_سطر("=== اكتمل اختبار المقاطعات ✓ ===")
