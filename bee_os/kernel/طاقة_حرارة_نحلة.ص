## تطبيق الاختناق الحراري
دالة th_طبق_اختناق(منطقة_id، حرارة)
    متغير حد_اخت = 0
    متغير حد_حرج_م = 0
    متغير حد_إيق = 0
    
    إذا (منطقة_id == 0)
        حد_اخت = منطقة_0_حد_اختناق + 0
        حد_حرج_م = منطقة_0_حد_حرج + 0
        حد_إيق = منطقة_0_حد_إيقاف + 0
    نهاية
    إذا (منطقة_id == 1)
        حد_اخت = منطقة_1_حد_اختناق + 0
        حد_حرج_م = منطقة_1_حد_حرج + 0
        حد_إيق = منطقة_1_حد_إيقاف + 0
    نهاية
    إذا (منطقة_id == 2)
        حد_اخت = منطقة_2_حد_اختناق + 0
        حد_حرج_م = منطقة_2_حد_حرج + 0
        حد_إيق = منطقة_2_حد_إيقاف + 0
    نهاية
    إذا (منطقة_id == 3)
        حد_اخت = منطقة_3_حد_اختناق + 0
        حد_حرج_م = منطقة_3_حد_حرج + 0
        حد_إيق = منطقة_3_حد_إيقاف + 0
    نهاية
    
    # فحص الإيقاف الطارئ
    إذا (حرارة >= حد_إيق)
        th_serial_اطبع("[TH] !! إيقاف طارئ !! منطقة ")
        th_serial_رقم(منطقة_id)
        th_serial_اطبع(" عند ")
        th_اطبع_حرارة(حرارة)
        th_serial_اطبع("\n")
        # هنا نستدعي pm_أطفئ() من وحدة الطاقة
        ارجع 3   # طارئ
    نهاية
    
    # فحص الحد الحرج
    إذا (حرارة >= حد_حرج_م)
        th_serial_اطبع("[TH] !! حرارة حرجة !! منطقة ")
        th_serial_رقم(منطقة_id)
        th_serial_اطبع(": ")
        th_اطبع_حرارة(حرارة)
        th_serial_اطبع("\n")
        
        عدد_أحداث_اختناق = عدد_أحداث_اختناق + 1
        إذا (منطقة_id == 0)
            منطقة_0_مختنق = 1
        نهاية
        إذا (منطقة_id == 1)
            منطقة_1_مختنق = 1
        نهاية
        ارجع 2   # حرج
    نهاية
    
    # فحص الاختناق
    إذا (حرارة >= حد_اخت)
        إذا (منطقة_id == 0)
            إذا (منطقة_0_مختنق == 0)
                th_serial_اطبع("[TH] اختناق حراري — CPU عند ")
                th_اطبع_حرارة(حرارة)
                th_serial_اطبع("\n")
                عدد_أحداث_اختناق = عدد_أحداث_اختناق + 1
            نهاية
            منطقة_0_مختنق = 1
        نهاية
        إذا (منطقة_id == 1)
            إذا (منطقة_1_مختنق == 0)
                th_serial_اطبع("[TH] اختناق حراري — GPU عند ")
                th_اطبع_حرارة(حرارة)
                th_serial_اطبع("\n")
                عدد_أحداث_اختناق = عدد_أحداث_اختناق + 1
            نهاية
            منطقة_1_مختنق = 1
        نهاية
        ارجع 1   # اختناق
    نهاية
    
    # إلغاء الاختناق إذا انخفضت الحرارة
    إذا (حرارة < حد_اخت)
        متغير حد_إلغاء = حد_اخت - 5000   # 5°C هامش
        إذا (حرارة < حد_إلغاء)
            إذا (منطقة_id == 0)
                إذا (منطقة_0_مختنق == 1)
                    th_serial_اطبع("[TH] إلغاء اختناق CPU (")
                    th_اطبع_حرارة(حرارة)
                    th_serial_اطبع(")\n")
                نهاية
                منطقة_0_مختنق = 0
            نهاية
            إذا (منطقة_id == 1)
                إذا (منطقة_1_مختنق == 1)
                    th_serial_اطبع("[TH] إلغاء اختناق GPU\n")
                نهاية
                منطقة_1_مختنق = 0
            نهاية
        نهاية
    نهاية
    ارجع 0   # عادي
نهاية

