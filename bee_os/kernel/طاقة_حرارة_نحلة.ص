دالة th_serial_اطبع(رسالة)
    متغير ط = 0
    بينما (ط < طول(رسالة))
        sad_ll_serial_write_char(COM1، رمز(رسالة[ط]))
        ط = ط + 1
    نهاية
نهاية

دالة th_serial_رقم(ن)
    إذا (ن == 0)
        sad_ll_serial_write_char(COM1، 48)
        ارجع 0
    نهاية
    
    متغير سالب = 0
    متغير نسخة = ن + 0
    إذا (نسخة < 0)
        سالب = 1
        نسخة = 0 - نسخة
    نهاية
    
    متغير خانات = 0
    متغير أرقام_0 = 0
    متغير أرقام_1 = 0
    متغير أرقام_2 = 0
    متغير أرقام_3 = 0
    متغير أرقام_4 = 0
    متغير أرقام_5 = 0
    متغير أرقام_6 = 0
    متغير أرقام_7 = 0
    متغير أرقام_8 = 0
    متغير أرقام_9 = 0
    
    بينما (نسخة > 0)
        متغير باقي_ر = نسخة % 10
        إذا (خانات == 0)
            أرقام_0 = باقي_ر
        نهاية
        إذا (خانات == 1)
            أرقام_1 = باقي_ر
        نهاية
        إذا (خانات == 2)
            أرقام_2 = باقي_ر
        نهاية
        إذا (خانات == 3)
            أرقام_3 = باقي_ر
        نهاية
        إذا (خانات == 4)
            أرقام_4 = باقي_ر
        نهاية
        إذا (خانات == 5)
            أرقام_5 = باقي_ر
        نهاية
        إذا (خانات == 6)
            أرقام_6 = باقي_ر
        نهاية
        إذا (خانات == 7)
            أرقام_7 = باقي_ر
        نهاية
        إذا (خانات == 8)
            أرقام_8 = باقي_ر
        نهاية
        إذا (خانات == 9)
            أرقام_9 = باقي_ر
        نهاية
        نسخة = (نسخة - باقي_ر) / 10
        خانات = خانات + 1
    نهاية
    
    إذا (سالب == 1)
        sad_ll_serial_write_char(COM1، 45)  # '-'
    نهاية
    
    متغير ع = خانات - 1
    بينما (ع >= 0)
        متغير رقم_ح = 0
        إذا (ع == 0)
            رقم_ح = أرقام_0
        نهاية
        إذا (ع == 1)
            رقم_ح = أرقام_1
        نهاية
        إذا (ع == 2)
            رقم_ح = أرقام_2
        نهاية
        إذا (ع == 3)
            رقم_ح = أرقام_3
        نهاية
        إذا (ع == 4)
            رقم_ح = أرقام_4
        نهاية
        إذا (ع == 5)
            رقم_ح = أرقام_5
        نهاية
        إذا (ع == 6)
            رقم_ح = أرقام_6
        نهاية
        إذا (ع == 7)
            رقم_ح = أرقام_7
        نهاية
        إذا (ع == 8)
            رقم_ح = أرقام_8
        نهاية
        إذا (ع == 9)
            رقم_ح = أرقام_9
        نهاية
        sad_ll_serial_write_char(COM1، 48 + رقم_ح)
        ع = ع - 1
    نهاية
    ارجع 0
نهاية

## طباعة درجة حرارة بالدرجات (من ملي سيلزيوس)
دالة th_اطبع_حرارة(ملي_سلزيوس)
    متغير درجات = ملي_سلزيوس / 1000
    متغير كسر = (ملي_سلزيوس % 1000) / 100
    th_serial_رقم(درجات)
    sad_ll_serial_write_char(COM1، 46)  # '.'
    th_serial_رقم(كسر)
    th_serial_اطبع(" C")
نهاية

