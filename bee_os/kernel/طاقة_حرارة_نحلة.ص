## حساب نسبة PWM للمروحة بناءً على الحرارة
دالة th_احسب_pwm(حرارة، حد_بدء، حد_أقصى)
    إذا (حرارة <= حد_بدء)
        ارجع 0
    نهاية
    إذا (حرارة >= حد_أقصى)
        ارجع 100
    نهاية
    
    # خطي بين حد_بدء وحد_أقصى
    متغير نطاق = حد_أقصى - حد_بدء
    إذا (نطاق <= 0)
        ارجع 100
    نهاية
    متغير فرق = حرارة - حد_بدء
    ارجع (فرق * 100) / نطاق
نهاية

## تحديث سرعة مروحة بناءً على PWM
دالة th_حدث_مروحة_0(نسبة)
    إذا (مروحة_0_مفعلة == 0)
        ارجع 0
    نهاية
    
    مروحة_0_نسبة_pwm = نسبة + 0
    
    إذا (نسبة == 0)
        مروحة_0_سرعة_هدف = 0
        مروحة_0_وضع = مروحة_مطفأة
    نهاية
    إذا (نسبة > 0)
        متغير نطاق_سرعة = مروحة_0_سرعة_قصوى - مروحة_0_سرعة_دنيا
        مروحة_0_سرعة_هدف = مروحة_0_سرعة_دنيا + (نطاق_سرعة * نسبة) / 100
        
        إذا (نسبة <= 25)
            مروحة_0_وضع = مروحة_منخفضة
        نهاية
        إذا (نسبة > 25)
            إذا (نسبة <= 50)
                مروحة_0_وضع = مروحة_متوسطة
            نهاية
            إذا (نسبة > 50)
                إذا (نسبة <= 75)
                    مروحة_0_وضع = مروحة_عالية
                نهاية
                إذا (نسبة > 75)
                    مروحة_0_وضع = مروحة_قصوى
                نهاية
            نهاية
        نهاية
    نهاية
    
    # محاكاة تغيير تدريجي للسرعة
    إذا (مروحة_0_سرعة < مروحة_0_سرعة_هدف)
        متغير زيادة = (مروحة_0_سرعة_هدف - مروحة_0_سرعة) / 5
        إذا (زيادة < 50)
            زيادة = 50
        نهاية
        مروحة_0_سرعة = مروحة_0_سرعة + زيادة
        إذا (مروحة_0_سرعة > مروحة_0_سرعة_هدف)
            مروحة_0_سرعة = مروحة_0_سرعة_هدف + 0
        نهاية
    نهاية
    إذا (مروحة_0_سرعة > مروحة_0_سرعة_هدف)
        متغير نقص = (مروحة_0_سرعة - مروحة_0_سرعة_هدف) / 3
        إذا (نقص < 30)
            نقص = 30
        نهاية
        مروحة_0_سرعة = مروحة_0_سرعة - نقص
        إذا (مروحة_0_سرعة < مروحة_0_سرعة_هدف)
            مروحة_0_سرعة = مروحة_0_سرعة_هدف + 0
        نهاية
    نهاية
    
    ارجع مروحة_0_سرعة
نهاية

دالة th_حدث_مروحة_1(نسبة)
    إذا (مروحة_1_مفعلة == 0)
        ارجع 0
    نهاية
    
    مروحة_1_نسبة_pwm = نسبة + 0
    
    إذا (نسبة == 0)
        مروحة_1_سرعة_هدف = 0
        مروحة_1_وضع = مروحة_مطفأة
    نهاية
    إذا (نسبة > 0)
        متغير نطاق_س = مروحة_1_سرعة_قصوى - مروحة_1_سرعة_دنيا
        مروحة_1_سرعة_هدف = مروحة_1_سرعة_دنيا + (نطاق_س * نسبة) / 100
        
        إذا (نسبة <= 25)
            مروحة_1_وضع = مروحة_منخفضة
        نهاية
        إذا (نسبة > 25)
            إذا (نسبة <= 60)
                مروحة_1_وضع = مروحة_متوسطة
            نهاية
            إذا (نسبة > 60)
                مروحة_1_وضع = مروحة_قصوى
            نهاية
        نهاية
    نهاية
    
    # تغيير تدريجي
    إذا (مروحة_1_سرعة < مروحة_1_سرعة_هدف)
        مروحة_1_سرعة = مروحة_1_سرعة + 40
        إذا (مروحة_1_سرعة > مروحة_1_سرعة_هدف)
            مروحة_1_سرعة = مروحة_1_سرعة_هدف + 0
        نهاية
    نهاية
    إذا (مروحة_1_سرعة > مروحة_1_سرعة_هدف)
        مروحة_1_سرعة = مروحة_1_سرعة - 25
        إذا (مروحة_1_سرعة < 0)
            مروحة_1_سرعة = 0
        نهاية
    نهاية
    
    ارجع مروحة_1_سرعة
نهاية

