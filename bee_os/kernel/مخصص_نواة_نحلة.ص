# إعادة تخصيص (realloc) - تخصيص جديد ونسخ البيانات
صدّر دالة km_إعادة_تخصيص(عنوان_قديم، مقاس_م)
    إذا (عنوان_قديم == 0)
        ارجع km_تخصيص(مقاس_م)
    نهاية
    
    إذا (مقاس_م == 0)
        km_تحرير(عنوان_قديم)
        ارجع 0
    نهاية
    
    # قراءة المقاس القديم
    متغير ترويسة_قديمة = عنوان_قديم - KM_مقاس_ترويسة
    متغير مقاس_قديم = km_قراءة_ترويسة_حقل(ترويسة_قديمة، 0)
    
    # إذا المقاس الجديد أصغر أو يساوي الفئة الحالية
    متغير مقاس_فئة_ق = km_قراءة_ترويسة_حقل(ترويسة_قديمة، 1)
    إذا (مقاس_م <= مقاس_فئة_ق)
        # يمكن البقاء في نفس الكتلة
        mem_write_dword(ترويسة_قديمة، مقاس_م)
        ارجع عنوان_قديم
    نهاية
    
    # تخصيص كتلة جديدة
    متغير عنوان_م = km_تخصيص(مقاس_م)
    إذا (عنوان_م == 0)
        ارجع 0
    نهاية
    
    # نسخ البيانات القديمة
    متغير مقاس_نسخ = مقاس_قديم
    إذا (مقاس_م < مقاس_نسخ)
        مقاس_نسخ = مقاس_م
    نهاية
    sad_ll_memcpy(عنوان_م، عنوان_قديم، مقاس_نسخ)
    
    # تحرير الكتلة القديمة
    km_تحرير(عنوان_قديم)
    
    ارجع عنوان_م
نهاية

