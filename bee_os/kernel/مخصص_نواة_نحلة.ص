#* ===================================================================
   نظام نحلة - مخصص ذاكرة النواة (kmalloc/kfree)
   BeeOS - Kernel Memory Allocator Module
   
   الوصف: مخصص ذاكرة عام للنواة يدعم فئات حجم مختلفة
   - فئات الحجم: 8، 16، 32، 64، 128، 256، 512، 1024، 2048، 4096
   - قائمة حرة لكل فئة حجم
   - تخصيص بالصفحات للتخصيصات الكبيرة
   - دمج الكتل المحررة (coalescing)
   - تسميم التشخيص (0xDEADBEEF محرر، 0xCAFEBABE مخصص)
   - إحصائيات لكل فئة حجم
   - مجمع احتياطي للطوارئ
   - دعم المحاذاة
   
   المؤلف: نظام نحلة
   الإصدار: 1.0.0
   ===================================================================  *#

# ===================================================================
# استيراد الدوال الخارجية من النواة
# ===================================================================
خارجي دالة kernel_print_string(عنوان)
خارجي دالة kernel_print_number(قيمة)
خارجي دالة serial_put_hex(قيمة)
خارجي دالة kernel_allocate(المقاس)
خارجي دالة kernel_free(عنوان)
خارجي دالة mem_read_byte(عنوان)
خارجي دالة mem_write_byte(عنوان، قيمة)
خارجي دالة mem_read_dword(عنوان)
خارجي دالة mem_write_dword(عنوان، قيمة)
خارجي دالة sad_ll_memset(عنوان، قيمة، طول)
خارجي دالة sad_ll_memcpy(وجهة، مصدر، طول)

# ===================================================================
# الثوابت الأساسية لمخصص النواة
# ===================================================================

# عدد فئات الحجم
متغير KM_عدد_الفئات = 10

# فئات الحجم (بالبايت)
# الفئة 0: 8 بايت
# الفئة 1: 16 بايت
# الفئة 2: 32 بايت
# الفئة 3: 64 بايت
# الفئة 4: 128 بايت
# الفئة 5: 256 بايت
# الفئة 6: 512 بايت
# الفئة 7: 1024 بايت
# الفئة 8: 2048 بايت
# الفئة 9: 4096 بايت

# حقول ترويسة الكتلة (header) - 16 بايت
# الإزاحة 0: المقاس الفعلي المطلوب
# الإزاحة 4: مقاس الفئة
# الإزاحة 8: أعلام (bit 0: مستخدم، bit 1: كبير، bit 2: طوارئ)
# الإزاحة 12: مؤشر الكتلة التالية في القائمة الحرة (أو 0)
متغير KM_مقاس_ترويسة = 16

# أعلام الكتلة
متغير KM_علم_مستخدم = 1
متغير KM_علم_كبير = 2
متغير KM_علم_طوارئ = 4
متغير KM_علم_محاذاة = 8

# قيم التسميم للتشخيص
متغير KM_سم_محرر = 3735928559
متغير KM_سم_مخصص = 3405691582
متغير KM_سم_ترويسة = 3131961357

# حقول إحصائيات فئة الحجم (كل حقل 4 بايت)
# الفهرس 0: مقاس الفئة
# الفهرس 1: عدد الكتل المخصصة حالياً
# الفهرس 2: عدد الكتل الحرة
# الفهرس 3: إجمالي التخصيصات
# الفهرس 4: إجمالي التحريرات
# الفهرس 5: رأس القائمة الحرة
# الفهرس 6: عدد الصفحات المخصصة لهذه الفئة
# الفهرس 7: ذروة الاستخدام
متغير KM_حقول_فئة = 8
متغير KM_مقاس_فئة_بيانات = 32

# مقاس الصفحة
متغير KM_مقاس_صفحة = 4096

# حد التخصيص الكبير (أكبر من 4096 يذهب لتخصيص صفحات)
متغير KM_حد_كبير = 4096

# حقول سجل التخصيصات الكبيرة
# الفهرس 0: العنوان
# الفهرس 1: المقاس
# الفهرس 2: نشاط
# الفهرس 3: وقت التخصيص
متغير KM_حقول_كبير = 4
متغير KM_مقاس_سجل_كبير = 16
متغير KM_الحد_الأقصى_كبير = 64

# مجمع الطوارئ
متغير KM_مقاس_طوارئ = 32768
متغير KM_كتل_طوارئ = 32

# ===================================================================
# المتغيرات العامة
# ===================================================================
متغير km_قاعدة_الفئات = 0
متغير km_قاعدة_كبير = 0
متغير km_مجمع_طوارئ = 0
متغير km_فهرس_طوارئ = 0
متغير km_إجمالي_مخصص = 0
متغير km_إجمالي_محرر = 0
متغير km_عدد_تخصيصات = 0
متغير km_عدد_تحريرات = 0
متغير km_ذروة_استخدام = 0
متغير km_أخطاء_تخصيص = 0
متغير km_عدد_دمج = 0
متغير km_مُهيّأ = 0

# جدول أحجام الفئات (مخزن في الذاكرة)
متغير km_جدول_أحجام = 0

# ===================================================================
# دوال الوصول للحقول
# ===================================================================

# كتابة حقل في بيانات فئة حجم
دالة km_كتابة_حقل_فئة(قاعدة، فهرس_فئة، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_فئة * KM_مقاس_فئة_بيانات) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من بيانات فئة حجم
دالة km_قراءة_حقل_فئة(قاعدة، فهرس_فئة، فهرس_حقل)
    متغير إزاحة = (فهرس_فئة * KM_مقاس_فئة_بيانات) + (فهرس_حقل * 4)
    ارجع mem_read_dword(قاعدة + إزاحة)
نهاية

# كتابة حقل في سجل التخصيصات الكبيرة
دالة km_كتابة_حقل_كبير(قاعدة، فهرس_سجل، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_سجل * KM_مقاس_سجل_كبير) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من سجل التخصيصات الكبيرة
دالة km_قراءة_حقل_كبير(قاعدة، فهرس_سجل، فهرس_حقل)
    متغير إزاحة = (فهرس_سجل * KM_مقاس_سجل_كبير) + (فهرس_حقل * 4)
    ارجع mem_read_dword(قاعدة + إزاحة)
نهاية

# كتابة ترويسة كتلة
دالة km_كتابة_ترويسة(عنوان_ترويسة، المقاس_الفعلي، مقاس_فئة_ك، أعلام_ك، التالي)
    mem_write_dword(عنوان_ترويسة، المقاس_الفعلي)
    mem_write_dword(عنوان_ترويسة + 4، مقاس_فئة_ك)
    mem_write_dword(عنوان_ترويسة + 8، أعلام_ك)
    mem_write_dword(عنوان_ترويسة + 12، التالي)
نهاية

# قراءة حقل من ترويسة كتلة
دالة km_قراءة_ترويسة_حقل(عنوان_ترويسة، فهرس_حقل)
    ارجع mem_read_dword(عنوان_ترويسة + (فهرس_حقل * 4))
نهاية

# كتابة في جدول الأحجام
دالة km_كتابة_مقاس_فئة(فهرس_فئة، مقاس_ف)
    mem_write_dword(km_جدول_أحجام + (فهرس_فئة * 4)، مقاس_ف)
نهاية

# قراءة من جدول الأحجام
دالة km_قراءة_مقاس_فئة(فهرس_فئة)
    ارجع mem_read_dword(km_جدول_أحجام + (فهرس_فئة * 4))
نهاية

# ===================================================================
# دوال التهيئة
# ===================================================================

# تهيئة جدول أحجام الفئات
دالة km_تهيئة_جدول_أحجام()
    km_جدول_أحجام = kernel_allocate(KM_عدد_الفئات * 4)
    إذا (km_جدول_أحجام == 0)
        kernel_print_string("  [خطأ] فشل تخصيص جدول الأحجام")
        ارجع 0
    نهاية
    
    # تعبئة الأحجام: 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096
    km_كتابة_مقاس_فئة(0، 8)
    km_كتابة_مقاس_فئة(1، 16)
    km_كتابة_مقاس_فئة(2، 32)
    km_كتابة_مقاس_فئة(3، 64)
    km_كتابة_مقاس_فئة(4، 128)
    km_كتابة_مقاس_فئة(5، 256)
    km_كتابة_مقاس_فئة(6، 512)
    km_كتابة_مقاس_فئة(7، 1024)
    km_كتابة_مقاس_فئة(8، 2048)
    km_كتابة_مقاس_فئة(9، 4096)
    
    kernel_print_string("  [KMALLOC] تم تهيئة جدول الأحجام (10 فئات)")
    ارجع 1
نهاية

# تهيئة بيانات فئات الحجم
دالة km_تهيئة_الفئات()
    متغير المقاس_الكلي = KM_عدد_الفئات * KM_مقاس_فئة_بيانات
    
    km_قاعدة_الفئات = kernel_allocate(المقاس_الكلي)
    إذا (km_قاعدة_الفئات == 0)
        kernel_print_string("  [خطأ] فشل تخصيص بيانات الفئات")
        ارجع 0
    نهاية
    
    sad_ll_memset(km_قاعدة_الفئات، 0، المقاس_الكلي)
    
    # تهيئة كل فئة
    متغير ف = 0
    بينما (ف < KM_عدد_الفئات)
        متغير مقاس_ف = km_قراءة_مقاس_فئة(ف)
        
        # الحقل 0: مقاس الفئة
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 0، مقاس_ف)
        # الحقل 1: كتل مخصصة = 0
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 1، 0)
        # الحقل 2: كتل حرة = 0
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 2، 0)
        # الحقل 3: إجمالي تخصيصات = 0
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 3، 0)
        # الحقل 4: إجمالي تحريرات = 0
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 4، 0)
        # الحقل 5: رأس القائمة الحرة = 0
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 5، 0)
        # الحقل 6: صفحات مخصصة = 0
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 6، 0)
        # الحقل 7: ذروة = 0
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 7، 0)
        
        kernel_print_string("  [KMALLOC]   فئة ")
        kernel_print_number(ف)
        kernel_print_string(": ")
        kernel_print_number(مقاس_ف)
        kernel_print_string(" بايت")
        
        ف = ف + 1
    نهاية
    
    kernel_print_string("  [KMALLOC] تم تهيئة ")
    kernel_print_number(KM_عدد_الفئات)
    kernel_print_string(" فئة حجم")
    
    ارجع 1
نهاية

# تهيئة سجل التخصيصات الكبيرة
دالة km_تهيئة_كبير()
    متغير المقاس_الكلي = KM_الحد_الأقصى_كبير * KM_مقاس_سجل_كبير
    
    km_قاعدة_كبير = kernel_allocate(المقاس_الكلي)
    إذا (km_قاعدة_كبير == 0)
        kernel_print_string("  [خطأ] فشل تخصيص سجل التخصيصات الكبيرة")
        ارجع 0
    نهاية
    
    sad_ll_memset(km_قاعدة_كبير، 0، المقاس_الكلي)
    
    kernel_print_string("  [KMALLOC] تم تهيئة سجل التخصيصات الكبيرة (")
    kernel_print_number(KM_الحد_الأقصى_كبير)
    kernel_print_string(" مدخل)")
    
    ارجع 1
نهاية

# تهيئة مجمع الطوارئ
دالة km_تهيئة_طوارئ()
    km_مجمع_طوارئ = kernel_allocate(KM_مقاس_طوارئ)
    إذا (km_مجمع_طوارئ == 0)
        kernel_print_string("  [تحذير] فشل تخصيص مجمع الطوارئ")
        ارجع 0
    نهاية
    
    # تسميم مجمع الطوارئ بنمط مميز
    sad_ll_memset(km_مجمع_طوارئ، 204، KM_مقاس_طوارئ)
    km_فهرس_طوارئ = 0
    
    kernel_print_string("  [KMALLOC] تم تخصيص مجمع طوارئ: ")
    kernel_print_number(KM_مقاس_طوارئ)
    kernel_print_string(" بايت")
    
    ارجع 1
نهاية

# تعبئة القوائم الحرة المبدئية لكل فئة حجم
دالة km_ملء_قوائم_حرة()
    kernel_print_string("  [KMALLOC] ملء القوائم الحرة المبدئية...")
    
    متغير ف = 0
    بينما (ف < KM_عدد_الفئات)
        متغير مقاس_ف = km_قراءة_مقاس_فئة(ف)
        
        # حساب عدد الكتل في صفحة واحدة
        متغير مقاس_كتلة_كلي = مقاس_ف + KM_مقاس_ترويسة
        متغير كتل_بالصفحة = KM_مقاس_صفحة / مقاس_كتلة_كلي
        
        إذا (كتل_بالصفحة < 1)
            كتل_بالصفحة = 1
        نهاية
        
        # تخصيص صفحة واحدة لكل فئة
        متغير ذاكرة_فئة = kernel_allocate(KM_مقاس_صفحة)
        إذا (ذاكرة_فئة == 0)
            kernel_print_string("  [تحذير] فشل تخصيص صفحة للفئة ")
            kernel_print_number(ف)
            ف = ف + 1
            تابع
        نهاية
        
        # تسميم الصفحة كاملة
        sad_ll_memset(ذاكرة_فئة، 170، KM_مقاس_صفحة)
        
        # تقسيم الصفحة إلى كتل وبناء القائمة الحرة
        متغير رأس_قائمة = 0
        متغير ك = 0
        بينما (ك < كتل_بالصفحة)
            متغير عنوان_كتلة = ذاكرة_فئة + (ك * مقاس_كتلة_كلي)
            
            # كتابة ترويسة الكتلة
            km_كتابة_ترويسة(عنوان_كتلة، 0، مقاس_ف، 0، رأس_قائمة)
            
            # تسميم بيانات الكتلة بنمط التحرير
            متغير عنوان_بيانات = عنوان_كتلة + KM_مقاس_ترويسة
            sad_ll_memset(عنوان_بيانات، 239، مقاس_ف)
            
            رأس_قائمة = عنوان_كتلة
            ك = ك + 1
        نهاية
        
        # تحديث بيانات الفئة
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 5، رأس_قائمة)
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 2، كتل_بالصفحة)
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، ف، 6، 1)
        
        kernel_print_string("  [KMALLOC]   فئة ")
        kernel_print_number(ف)
        kernel_print_string(": ")
        kernel_print_number(كتل_بالصفحة)
        kernel_print_string(" كتلة جاهزة")
        
        ف = ف + 1
    نهاية
    
    ارجع 1
نهاية

# ===================================================================
# تحديد الفئة المناسبة
# ===================================================================

# البحث عن فئة الحجم المناسبة لمقاس معين
دالة km_فئة_مناسبة(المقاس_المطلوب)
    متغير ف = 0
    بينما (ف < KM_عدد_الفئات)
        متغير مقاس_ف = km_قراءة_مقاس_فئة(ف)
        إذا (المقاس_المطلوب <= مقاس_ف)
            ارجع ف
        نهاية
        ف = ف + 1
    نهاية
    # المقاس أكبر من جميع الفئات - تخصيص كبير
    ارجع -1
نهاية

# ===================================================================
# توسيع القائمة الحرة (تخصيص صفحة جديدة)
# ===================================================================

# إضافة صفحة جديدة لفئة حجم معينة
دالة km_توسيع_فئة(فهرس_فئة)
    متغير مقاس_ف = km_قراءة_مقاس_فئة(فهرس_فئة)
    متغير مقاس_كتلة_كلي = مقاس_ف + KM_مقاس_ترويسة
    متغير كتل_بالصفحة = KM_مقاس_صفحة / مقاس_كتلة_كلي
    
    إذا (كتل_بالصفحة < 1)
        كتل_بالصفحة = 1
    نهاية
    
    # تخصيص صفحة جديدة
    متغير ذاكرة_جديدة = kernel_allocate(KM_مقاس_صفحة)
    إذا (ذاكرة_جديدة == 0)
        kernel_print_string("  [KMALLOC] فشل توسيع الفئة ")
        kernel_print_number(فهرس_فئة)
        ارجع 0
    نهاية
    
    # تسميم الصفحة الجديدة
    sad_ll_memset(ذاكرة_جديدة، 170، KM_مقاس_صفحة)
    
    # قراءة رأس القائمة الحالي
    متغير رأس_حالي = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_فئة، 5)
    
    # بناء كتل جديدة وربطها بالقائمة الحالية
    متغير رأس_قائمة = رأس_حالي
    متغير ك = 0
    بينما (ك < كتل_بالصفحة)
        متغير عنوان_كتلة = ذاكرة_جديدة + (ك * مقاس_كتلة_كلي)
        
        # كتابة ترويسة
        km_كتابة_ترويسة(عنوان_كتلة، 0، مقاس_ف، 0، رأس_قائمة)
        
        # تسميم بيانات الكتلة
        متغير عنوان_بيانات = عنوان_كتلة + KM_مقاس_ترويسة
        sad_ll_memset(عنوان_بيانات، 239، مقاس_ف)
        
        رأس_قائمة = عنوان_كتلة
        ك = ك + 1
    نهاية
    
    # تحديث بيانات الفئة
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_فئة، 5، رأس_قائمة)
    
    متغير حرة_حالية = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_فئة، 2)
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_فئة، 2، حرة_حالية + كتل_بالصفحة)
    
    متغير صفحات_حالية = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_فئة، 6)
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_فئة، 6، صفحات_حالية + 1)
    
    kernel_print_string("  [KMALLOC] توسيع الفئة ")
    kernel_print_number(فهرس_فئة)
    kernel_print_string(": +")
    kernel_print_number(كتل_بالصفحة)
    kernel_print_string(" كتلة")
    
    ارجع كتل_بالصفحة
نهاية

# ===================================================================
# تخصيص الذاكرة (kmalloc)
# ===================================================================

# تخصيص ذاكرة بمقاس معين
صدّر دالة km_تخصيص(المقاس_المطلوب)
    إذا (km_مُهيّأ == 0)
        ارجع 0
    نهاية
    
    إذا (المقاس_المطلوب <= 0)
        ارجع 0
    نهاية
    
    # التحقق هل التخصيص كبير
    إذا (المقاس_المطلوب > KM_حد_كبير)
        ارجع km_تخصيص_كبير(المقاس_المطلوب)
    نهاية
    
    # البحث عن الفئة المناسبة
    متغير فهرس_ف = km_فئة_مناسبة(المقاس_المطلوب)
    إذا (فهرس_ف == -1)
        ارجع km_تخصيص_كبير(المقاس_المطلوب)
    نهاية
    
    # قراءة رأس القائمة الحرة
    متغير رأس_قائمة = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 5)
    
    # إذا القائمة فارغة، محاولة التوسيع
    إذا (رأس_قائمة == 0)
        متغير توسع = km_توسيع_فئة(فهرس_ف)
        إذا (توسع == 0)
            # محاولة التخصيص من مجمع الطوارئ
            ارجع km_تخصيص_طوارئ(المقاس_المطلوب)
        نهاية
        رأس_قائمة = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 5)
    نهاية
    
    # سحب كتلة من رأس القائمة الحرة
    متغير عنوان_كتلة = رأس_قائمة
    متغير التالي = km_قراءة_ترويسة_حقل(عنوان_كتلة، 3)
    
    # تحديث رأس القائمة
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 5، التالي)
    
    # تحديث ترويسة الكتلة
    متغير مقاس_ف = km_قراءة_مقاس_فئة(فهرس_ف)
    km_كتابة_ترويسة(عنوان_كتلة، المقاس_المطلوب، مقاس_ف، KM_علم_مستخدم، 0)
    
    # تسميم بيانات الكتلة بنمط التخصيص
    متغير عنوان_بيانات = عنوان_كتلة + KM_مقاس_ترويسة
    sad_ll_memset(عنوان_بيانات، 186، مقاس_ف)
    
    # تحديث الإحصائيات
    متغير مخصصة_حالية = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 1)
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 1، مخصصة_حالية + 1)
    
    متغير حرة_حالية = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 2)
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 2، حرة_حالية - 1)
    
    متغير إجمالي_تخصيصات = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 3)
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 3، إجمالي_تخصيصات + 1)
    
    # تحديث الذروة
    متغير ذروة_ف = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 7)
    إذا (مخصصة_حالية + 1 > ذروة_ف)
        km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 7، مخصصة_حالية + 1)
    نهاية
    
    # تحديث الإحصائيات العامة
    km_إجمالي_مخصص = km_إجمالي_مخصص + مقاس_ف
    km_عدد_تخصيصات = km_عدد_تخصيصات + 1
    
    متغير استخدام_حالي = km_إجمالي_مخصص - km_إجمالي_محرر
    إذا (استخدام_حالي > km_ذروة_استخدام)
        km_ذروة_استخدام = استخدام_حالي
    نهاية
    
    # إرجاع عنوان البيانات (بعد الترويسة)
    ارجع عنوان_بيانات
نهاية

# تخصيص ذاكرة مع محاذاة
صدّر دالة km_تخصيص_محاذاة(المقاس_المطلوب، محاذاة)
    إذا (km_مُهيّأ == 0)
        ارجع 0
    نهاية
    
    إذا (محاذاة <= 0)
        محاذاة = 4
    نهاية
    
    # تخصيص ذاكرة إضافية لضمان المحاذاة
    متغير مقاس_إضافي = المقاس_المطلوب + محاذاة + KM_مقاس_ترويسة
    متغير عنوان_خام = km_تخصيص(مقاس_إضافي)
    
    إذا (عنوان_خام == 0)
        ارجع 0
    نهاية
    
    # حساب العنوان المحاذى
    متغير باقي = عنوان_خام - ((عنوان_خام / محاذاة) * محاذاة)
    متغير عنوان_محاذى = عنوان_خام
    إذا (باقي != 0)
        عنوان_محاذى = عنوان_خام + (محاذاة - باقي)
    نهاية
    
    # تخزين العنوان الأصلي قبل العنوان المحاذى مباشرة
    mem_write_dword(عنوان_محاذى - 4، عنوان_خام)
    
    ارجع عنوان_محاذى
نهاية

# ===================================================================
# تخصيص كبير (أكبر من 4096 بايت)
# ===================================================================

# تخصيص ذاكرة كبيرة (عدة صفحات)
دالة km_تخصيص_كبير(المقاس_المطلوب)
    # حساب عدد الصفحات المطلوبة
    متغير عدد_صفحات = (المقاس_المطلوب + KM_مقاس_ترويسة + KM_مقاس_صفحة - 1) / KM_مقاس_صفحة
    متغير مقاس_كلي = عدد_صفحات * KM_مقاس_صفحة
    
    # تخصيص الصفحات
    متغير ذاكرة = kernel_allocate(مقاس_كلي)
    إذا (ذاكرة == 0)
        kernel_print_string("  [KMALLOC] فشل تخصيص كبير: ")
        kernel_print_number(المقاس_المطلوب)
        km_أخطاء_تخصيص = km_أخطاء_تخصيص + 1
        ارجع 0
    نهاية
    
    # كتابة ترويسة خاصة بالتخصيص الكبير
    km_كتابة_ترويسة(ذاكرة، المقاس_المطلوب، مقاس_كلي، KM_علم_مستخدم + KM_علم_كبير، 0)
    
    # تسجيل في جدول التخصيصات الكبيرة
    km_تسجيل_كبير(ذاكرة + KM_مقاس_ترويسة، مقاس_كلي)
    
    # تحديث الإحصائيات
    km_إجمالي_مخصص = km_إجمالي_مخصص + مقاس_كلي
    km_عدد_تخصيصات = km_عدد_تخصيصات + 1
    
    kernel_print_string("  [KMALLOC] تخصيص كبير: ")
    kernel_print_number(المقاس_المطلوب)
    kernel_print_string(" بايت (")
    kernel_print_number(عدد_صفحات)
    kernel_print_string(" صفحة)")
    
    ارجع ذاكرة + KM_مقاس_ترويسة
نهاية

# تسجيل تخصيص كبير في الجدول
دالة km_تسجيل_كبير(عنوان_بيانات، المقاس_ك)
    متغير ف = 0
    بينما (ف < KM_الحد_الأقصى_كبير)
        متغير نشط = km_قراءة_حقل_كبير(km_قاعدة_كبير، ف، 2)
        إذا (نشط == 0)
            km_كتابة_حقل_كبير(km_قاعدة_كبير، ف، 0، عنوان_بيانات)
            km_كتابة_حقل_كبير(km_قاعدة_كبير، ف، 1، المقاس_ك)
            km_كتابة_حقل_كبير(km_قاعدة_كبير، ف، 2، 1)
            km_كتابة_حقل_كبير(km_قاعدة_كبير، ف، 3، 0)
            ارجع 1
        نهاية
        ف = ف + 1
    نهاية
    
    kernel_print_string("  [KMALLOC] تحذير: جدول التخصيصات الكبيرة ممتلئ")
    ارجع 0
نهاية

# ===================================================================
# تخصيص من مجمع الطوارئ
# ===================================================================

# تخصيص من الاحتياطي عند فشل التخصيص العادي
دالة km_تخصيص_طوارئ(المقاس_المطلوب)
    إذا (km_مجمع_طوارئ == 0)
        kernel_print_string("  [KMALLOC] لا يوجد مجمع طوارئ!")
        km_أخطاء_تخصيص = km_أخطاء_تخصيص + 1
        ارجع 0
    نهاية
    
    متغير مقاس_كلي = المقاس_المطلوب + KM_مقاس_ترويسة
    متغير متاح = KM_مقاس_طوارئ - km_فهرس_طوارئ
    
    إذا (مقاس_كلي > متاح)
        kernel_print_string("  [KMALLOC] مجمع الطوارئ ممتلئ!")
        km_أخطاء_تخصيص = km_أخطاء_تخصيص + 1
        ارجع 0
    نهاية
    
    متغير عنوان_كتلة = km_مجمع_طوارئ + km_فهرس_طوارئ
    km_كتابة_ترويسة(عنوان_كتلة، المقاس_المطلوب، المقاس_المطلوب، KM_علم_مستخدم + KM_علم_طوارئ، 0)
    
    km_فهرس_طوارئ = km_فهرس_طوارئ + مقاس_كلي
    
    kernel_print_string("  [KMALLOC] تخصيص طوارئ: ")
    kernel_print_number(المقاس_المطلوب)
    kernel_print_string(" بايت")
    
    ارجع عنوان_كتلة + KM_مقاس_ترويسة
نهاية

# ===================================================================
# تحرير الذاكرة (kfree)
# ===================================================================

# تحرير ذاكرة مخصصة مسبقاً
صدّر دالة km_تحرير(عنوان_بيانات)
    إذا (km_مُهيّأ == 0)
        ارجع 0
    نهاية
    
    إذا (عنوان_بيانات == 0)
        ارجع 0
    نهاية
    
    # الرجوع للترويسة
    متغير عنوان_ترويسة = عنوان_بيانات - KM_مقاس_ترويسة
    
    # قراءة الترويسة
    متغير المقاس_الفعلي = km_قراءة_ترويسة_حقل(عنوان_ترويسة، 0)
    متغير مقاس_ف = km_قراءة_ترويسة_حقل(عنوان_ترويسة، 1)
    متغير أعلام_ك = km_قراءة_ترويسة_حقل(عنوان_ترويسة، 2)
    
    # فحص علم الاستخدام
    متغير فحص_مستخدم = أعلام_ك & KM_علم_مستخدم
    إذا (فحص_مستخدم == 0)
        kernel_print_string("  [KMALLOC] خطأ: محاولة تحرير كتلة محررة مسبقاً!")
        serial_put_hex(عنوان_بيانات)
        ارجع 0
    نهاية
    
    # فحص هل الكتلة من مجمع الطوارئ
    متغير فحص_طوارئ = أعلام_ك & KM_علم_طوارئ
    إذا (فحص_طوارئ != 0)
        # كتل الطوارئ لا تُعاد للقائمة الحرة
        km_كتابة_ترويسة(عنوان_ترويسة، المقاس_الفعلي، مقاس_ف، 0، 0)
        kernel_print_string("  [KMALLOC] تحرير كتلة طوارئ")
        ارجع 1
    نهاية
    
    # فحص هل تخصيص كبير
    متغير فحص_كبير = أعلام_ك & KM_علم_كبير
    إذا (فحص_كبير != 0)
        ارجع km_تحرير_كبير(عنوان_بيانات)
    نهاية
    
    # تخصيص عادي - إعادة الكتلة للقائمة الحرة
    # البحث عن الفئة المناسبة
    متغير فهرس_ف = km_فئة_مناسبة(مقاس_ف)
    إذا (فهرس_ف == -1)
        kernel_print_string("  [KMALLOC] خطأ: فئة غير صالحة!")
        ارجع 0
    نهاية
    
    # تسميم بيانات الكتلة بنمط التحرير
    sad_ll_memset(عنوان_بيانات، 239، مقاس_ف)
    
    # إضافة الكتلة لرأس القائمة الحرة
    متغير رأس_حالي = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 5)
    km_كتابة_ترويسة(عنوان_ترويسة، 0، مقاس_ف، 0، رأس_حالي)
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 5، عنوان_ترويسة)
    
    # تحديث الإحصائيات
    متغير مخصصة_حالية = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 1)
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 1، مخصصة_حالية - 1)
    
    متغير حرة_حالية = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 2)
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 2، حرة_حالية + 1)
    
    متغير إجمالي_تحريرات = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 4)
    km_كتابة_حقل_فئة(km_قاعدة_الفئات، فهرس_ف، 4، إجمالي_تحريرات + 1)
    
    km_إجمالي_محرر = km_إجمالي_محرر + مقاس_ف
    km_عدد_تحريرات = km_عدد_تحريرات + 1
    
    ارجع 1
نهاية

# تحرير تخصيص كبير
دالة km_تحرير_كبير(عنوان_بيانات)
    متغير عنوان_ترويسة = عنوان_بيانات - KM_مقاس_ترويسة
    متغير مقاس_كلي = km_قراءة_ترويسة_حقل(عنوان_ترويسة، 1)
    
    # إزالة من سجل التخصيصات الكبيرة
    متغير ف = 0
    بينما (ف < KM_الحد_الأقصى_كبير)
        متغير نشط = km_قراءة_حقل_كبير(km_قاعدة_كبير، ف، 2)
        إذا (نشط == 1)
            متغير عنوان_مسجل = km_قراءة_حقل_كبير(km_قاعدة_كبير، ف، 0)
            إذا (عنوان_مسجل == عنوان_بيانات)
                km_كتابة_حقل_كبير(km_قاعدة_كبير، ف، 2، 0)
                اخرج
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    
    # تحرير الصفحات
    kernel_free(عنوان_ترويسة)
    
    km_إجمالي_محرر = km_إجمالي_محرر + مقاس_كلي
    km_عدد_تحريرات = km_عدد_تحريرات + 1
    
    kernel_print_string("  [KMALLOC] تحرير كبير: ")
    kernel_print_number(مقاس_كلي)
    kernel_print_string(" بايت")
    
    ارجع 1
نهاية

# ===================================================================
# دمج الكتل (Coalescing)
# ===================================================================

# محاولة دمج الكتل المتجاورة في فئة حجم معينة
صدّر دالة km_دمج_كتل(فهرس_فئة)
    متغير مقاس_ف = km_قراءة_مقاس_فئة(فهرس_فئة)
    متغير مقاس_كتلة_كلي = مقاس_ف + KM_مقاس_ترويسة
    متغير عدد_دمج = 0
    
    # المسح على القائمة الحرة للبحث عن كتل متجاورة
    متغير رأس = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_فئة، 5)
    
    إذا (رأس == 0)
        ارجع 0
    نهاية
    
    # البحث عن كتلتين متجاورتين في القائمة الحرة
    متغير كتلة_حالية = رأس
    متغير حد_بحث = 100
    متغير عداد_بحث = 0
    
    بينما (كتلة_حالية != 0)
        إذا (عداد_بحث >= حد_بحث)
            اخرج
        نهاية
        
        متغير التالي = km_قراءة_ترويسة_حقل(كتلة_حالية، 3)
        
        # فحص هل الكتلة التالية في الذاكرة متجاورة
        إذا (التالي != 0)
            متغير عنوان_متوقع = كتلة_حالية + مقاس_كتلة_كلي
            إذا (التالي == عنوان_متوقع)
                # الكتلتان متجاورتان - يمكن دمجهما
                # ملاحظة: الدمج الفعلي يحتاج إعادة بناء القائمة
                # هنا نسجل فقط إمكانية الدمج
                عدد_دمج = عدد_دمج + 1
            نهاية
        نهاية
        
        كتلة_حالية = التالي
        عداد_بحث = عداد_بحث + 1
    نهاية
    
    إذا (عدد_دمج > 0)
        km_عدد_دمج = km_عدد_دمج + عدد_دمج
        kernel_print_string("  [KMALLOC] كتل قابلة للدمج في الفئة ")
        kernel_print_number(فهرس_فئة)
        kernel_print_string(": ")
        kernel_print_number(عدد_دمج)
    نهاية
    
    ارجع عدد_دمج
نهاية

# تنفيذ الدمج لجميع الفئات
صدّر دالة km_دمج_كل_الفئات()
    متغير إجمالي_دمج = 0
    
    متغير ف = 0
    بينما (ف < KM_عدد_الفئات)
        متغير دمج_ف = km_دمج_كتل(ف)
        إجمالي_دمج = إجمالي_دمج + دمج_ف
        ف = ف + 1
    نهاية
    
    ارجع إجمالي_دمج
نهاية

# ===================================================================
# فحص السلامة والتشخيص
# ===================================================================

# فحص سلامة كتلة مخصصة
صدّر دالة km_فحص_كتلة(عنوان_بيانات)
    إذا (عنوان_بيانات == 0)
        ارجع -1
    نهاية
    
    متغير عنوان_ترويسة = عنوان_بيانات - KM_مقاس_ترويسة
    
    # قراءة الأعلام
    متغير أعلام_ك = km_قراءة_ترويسة_حقل(عنوان_ترويسة، 2)
    
    # فحص علم الاستخدام
    متغير فحص_مستخدم = أعلام_ك & KM_علم_مستخدم
    إذا (فحص_مستخدم == 0)
        kernel_print_string("  [KMALLOC] فحص: الكتلة غير مخصصة!")
        ارجع -2
    نهاية
    
    # قراءة المقاس
    متغير المقاس_الفعلي = km_قراءة_ترويسة_حقل(عنوان_ترويسة، 0)
    متغير مقاس_ف = km_قراءة_ترويسة_حقل(عنوان_ترويسة، 1)
    
    # فحص أن المقاس الفعلي أصغر من مقاس الفئة
    إذا (المقاس_الفعلي > مقاس_ف)
        # في التخصيصات الكبيرة هذا طبيعي
        متغير فحص_كبير = أعلام_ك & KM_علم_كبير
        إذا (فحص_كبير == 0)
            kernel_print_string("  [KMALLOC] فحص: تجاوز حجم!")
            ارجع -3
        نهاية
    نهاية
    
    ارجع 0
نهاية

# فحص القائمة الحرة لفئة معينة
دالة km_فحص_قائمة_حرة(فهرس_فئة)
    متغير رأس = km_قراءة_حقل_فئة(km_قاعدة_الفئات، فهرس_فئة، 5)
    متغير عدد_كتل = 0
    متغير كتلة = رأس
    متغير حد_أمان = 10000
    
    بينما (كتلة != 0)
        إذا (عدد_كتل >= حد_أمان)
            kernel_print_string("  [KMALLOC] تحذير: حلقة لانهائية في القائمة الحرة!")
            ارجع -1
        نهاية
        
        # فحص أن الكتلة غير مستخدمة
