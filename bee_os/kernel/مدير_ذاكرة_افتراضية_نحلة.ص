# ============================================================
# وحدة مدير الذاكرة الافتراضية — نظام نحلة (BeeOS)
# الملف: مدير_ذاكرة_افتراضية_نحلة.ص
# الوظيفة: إدارة مساحات العناوين الافتراضية والمناطق
# المعمارية: IA-32 (32-bit)
# ============================================================
#
# هذه الوحدة تدير مساحات العناوين الافتراضية (Virtual Address Spaces)
# لكل عملية في النظام. كل عملية لها مساحة عناوين خاصة بها
# تحتوي على عدة مناطق (Regions) مثل:
# - منطقة الكود (Text): للقراءة فقط + تنفيذ
# - منطقة البيانات (Data): للقراءة والكتابة
# - منطقة الكومة (Heap): قابلة للنمو
# - منطقة المكدس (Stack): قابلة للنمو
# - مناطق الذاكرة المشتركة (Shared Memory)
# - مناطق ربط الملفات (Memory-Mapped Files)
#
# تخطيط مساحة العناوين الافتراضية (4 جيجابايت):
# 0x00000000 - 0x00000FFF: صفحة صفرية (محمية — NULL pointer guard)
# 0x00001000 - 0x003FFFFF: منطقة الكود (4 ميغابايت تقريباً)
# 0x00400000 - 0x07FFFFFF: منطقة البيانات (124 ميغابايت)
# 0x08000000 - 0x3FFFFFFF: منطقة الكومة (نمو للأعلى)
# 0x40000000 - 0x7FFFFFFF: منطقة ربط الملفات والمكتبات المشتركة
# 0x80000000 - 0xBFFFFFFF: منطقة حرة (مستقبلية)
# 0xC0000000 - 0xFFFFFFFF: منطقة النواة (1 جيجابايت — مشتركة بين العمليات)
#
# ============================================================

# ============================================================
# الثوابت — حدود مناطق الذاكرة
# ============================================================

# صفحة صفرية — محمية ضد NULL
متغير ثابت_بداية_صفحة_صفرية = 0
متغير ثابت_نهاية_صفحة_صفرية = 4095

# منطقة الكود
متغير ثابت_بداية_كود = 4096
