# فحص هل العنوان قابل للقراءة
دالة فحص_إذن_قراءة(معرف_مساحة، عنوان)
    متغير فهرس = بحث_منطقة_بالعنوان(معرف_مساحة، عنوان)
    إذا (فهرس < 0)
        ارجع 0
    نهاية
    متغير أذونات = منطقة_أذونات(معرف_مساحة، فهرس)
    متغير فحص = أذونات & إذن_قراءة
    إذا (فحص != 0)
        ارجع 1
    نهاية
    ارجع 0
