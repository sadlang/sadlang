# كتابة
متغير إذن_كتابة = 2
# تنفيذ
متغير إذن_تنفيذ = 4
# قراءة + كتابة
متغير إذن_قراءة_كتابة = 3
# قراءة + تنفيذ
متغير إذن_قراءة_تنفيذ = 5
# الكل
متغير إذن_كامل = 7

# ============================================================
# جدول مناطق الذاكرة الافتراضية
# ============================================================
# نستخدم مصفوفة ثابتة لتخزين معلومات المناطق
# كل منطقة تأخذ 8 خانات (32 بايت):
#   0: بداية المنطقة (عنوان افتراضي)
#   1: نهاية المنطقة (عنوان افتراضي)
#   2: فئة المنطقة
#   3: أذونات المنطقة
#   4: عدد الصفحات المربوطة
#   5: أعلام إضافية
#   6: معرّف العملية المالكة
#   7: محجوز

# أقصى عدد مناطق لكل عملية
متغير ثابت_اقصى_مناطق = 64
# مقاس كل سجل منطقة (بعدد الأعداد الصحيحة)
متغير ثابت_مقاس_سجل = 8
# عنوان جدول المناطق (في ذاكرة النواة)
متغير عنوان_جدول_مناطق = 25165824

# ============================================================
# أقصى عدد مساحات عناوين (= أقصى عدد عمليات)
# ============================================================

متغير ثابت_اقصى_مساحات = 32
# جدول مساحات العناوين:
#   كل مساحة تأخذ 4 خانات:
#   0: عنوان دليل الصفحات
#   1: معرّف العملية
#   2: عدد المناطق
#   3: نقطة كسر الكومة (brk)
متغير ثابت_مقاس_سجل_مساحة = 4
متغير عنوان_جدول_مساحات = 25231360

# ============================================================
# إحصائيات
# ============================================================

متغير إحصاء_مناطق_منشأة = 0
متغير إحصاء_مناطق_محذوفة = 0
متغير إحصاء_مساحات_منشأة = 0
متغير إحصاء_مساحات_محذوفة = 0
متغير إحصاء_صفحات_مخصصة = 0
متغير إحصاء_صفحات_محررة = 0
متغير إحصاء_أخطاء = 0

# ============================================================
# دوال مساعدة — جدول المناطق
# ============================================================

# حساب عنوان سجل منطقة
دالة عنوان_سجل_منطقة(معرف_مساحة، فهرس_منطقة)
    # كل مساحة لها مناطقها الخاصة
    متغير إزاحة_مساحة = معرف_مساحة * ثابت_اقصى_مناطق * ثابت_مقاس_سجل * 4
    متغير إزاحة_منطقة = فهرس_منطقة * ثابت_مقاس_سجل * 4
    ارجع عنوان_جدول_مناطق + إزاحة_مساحة + إزاحة_منطقة
نهاية

# قراءة حقل من سجل منطقة
دالة منطقة_قراءة_حقل(معرف_مساحة، فهرس_منطقة، فهرس_حقل)
    متغير عنوان = عنوان_سجل_منطقة(معرف_مساحة، فهرس_منطقة) + فهرس_حقل * 4
    ارجع mem_read_dword(عنوان)
نهاية

# كتابة حقل في سجل منطقة
دالة منطقة_كتابة_حقل(معرف_مساحة، فهرس_منطقة، فهرس_حقل، قيمة)
    متغير عنوان = عنوان_سجل_منطقة(معرف_مساحة، فهرس_منطقة) + فهرس_حقل * 4
    mem_write_dword(عنوان، قيمة)
نهاية

# قراءة بداية المنطقة
دالة منطقة_بداية(معرف_مساحة، فهرس)
    ارجع منطقة_قراءة_حقل(معرف_مساحة، فهرس، 0)
نهاية

# قراءة نهاية المنطقة
دالة منطقة_نهاية(معرف_مساحة، فهرس)
    ارجع منطقة_قراءة_حقل(معرف_مساحة، فهرس، 1)
نهاية

# قراءة فئة المنطقة
دالة منطقة_فئة(معرف_مساحة، فهرس)
    ارجع منطقة_قراءة_حقل(معرف_مساحة، فهرس، 2)
نهاية

# قراءة أذونات المنطقة
دالة منطقة_أذونات(معرف_مساحة، فهرس)
    ارجع منطقة_قراءة_حقل(معرف_مساحة، فهرس، 3)
نهاية

# ============================================================
# دوال مساعدة — جدول مساحات العناوين
# ============================================================

# حساب عنوان سجل مساحة
دالة عنوان_سجل_مساحة(معرف)
    ارجع عنوان_جدول_مساحات + معرف * ثابت_مقاس_سجل_مساحة * 4
نهاية

# قراءة حقل من سجل مساحة
دالة مساحة_قراءة_حقل(معرف، فهرس_حقل)
    متغير عنوان = عنوان_سجل_مساحة(معرف) + فهرس_حقل * 4
    ارجع mem_read_dword(عنوان)
نهاية

# كتابة حقل في سجل مساحة
دالة مساحة_كتابة_حقل(معرف، فهرس_حقل، قيمة)
    متغير عنوان = عنوان_سجل_مساحة(معرف) + فهرس_حقل * 4
    mem_write_dword(عنوان، قيمة)
نهاية

# الحصول على عنوان دليل الصفحات لمساحة
دالة مساحة_دليل_صفحات(معرف)
    ارجع مساحة_قراءة_حقل(معرف، 0)
نهاية

# الحصول على عدد المناطق في مساحة
دالة مساحة_عدد_مناطق(معرف)
    ارجع مساحة_قراءة_حقل(معرف، 2)
نهاية

# الحصول على نقطة كسر الكومة
دالة مساحة_نقطة_كومة(معرف)
    ارجع مساحة_قراءة_حقل(معرف، 3)
نهاية

# ============================================================
# إنشاء مساحة عناوين جديدة
# ============================================================

# إنشاء مساحة عناوين لعملية جديدة
# المعاملات: معرف_العملية
# النتيجة: معرّف المساحة (0-31)، أو -1 عند الفشل
دالة إنشاء_مساحة_عناوين(معرف_العملية)
    # البحث عن خانة فارغة
    متغير م = 0
    بينما (م < ثابت_اقصى_مساحات)
        متغير دليل = مساحة_دليل_صفحات(م)
        إذا (دليل == 0)
            # خانة فارغة — استخدامها
            # سنطلب دليل صفحات جديد من وحدة جداول الصفحات
            # مؤقتاً: نستخدم عنوان ثابت + إزاحة
            متغير عنوان_دليل_جديد = 26214400 + م * 4096
            sad_ll_memset(عنوان_دليل_جديد، 0، 4096)
            
            # تسجيل المساحة
            مساحة_كتابة_حقل(م، 0، عنوان_دليل_جديد)
            مساحة_كتابة_حقل(م، 1، معرف_العملية)
            مساحة_كتابة_حقل(م، 2، 0)
            مساحة_كتابة_حقل(م، 3، ثابت_بداية_كومة)
            
            إحصاء_مساحات_منشأة = إحصاء_مساحات_منشأة + 1
            ارجع م
        نهاية
        م = م + 1
    نهاية
    
    إحصاء_أخطاء = إحصاء_أخطاء + 1
    ارجع -1
نهاية

# تدمير مساحة عناوين
دالة تدمير_مساحة_عناوين(معرف_مساحة)
    إذا (معرف_مساحة < 0)
        ارجع 0
    نهاية
    إذا (معرف_مساحة >= ثابت_اقصى_مساحات)
        ارجع 0
    نهاية
    
    # تصفير سجل المساحة
    مساحة_كتابة_حقل(معرف_مساحة، 0، 0)
    مساحة_كتابة_حقل(معرف_مساحة، 1، 0)
    مساحة_كتابة_حقل(معرف_مساحة، 2، 0)
    مساحة_كتابة_حقل(معرف_مساحة، 3، 0)
    
    # تصفير جميع المناطق
    متغير ف = 0
    بينما (ف < ثابت_اقصى_مناطق)
        متغير ق = 0
        بينما (ق < ثابت_مقاس_سجل)
            منطقة_كتابة_حقل(معرف_مساحة، ف، ق، 0)
            ق = ق + 1
        نهاية
        ف = ف + 1
    نهاية
    
    إحصاء_مساحات_محذوفة = إحصاء_مساحات_محذوفة + 1
    ارجع 1
نهاية

# ============================================================
# إضافة منطقة ذاكرة
# ============================================================

# إضافة منطقة جديدة لمساحة العناوين
# المعاملات:
#   معرف_مساحة: معرّف مساحة العناوين
#   بداية: عنوان بداية المنطقة (محاذاة 4KB)
#   نهاية: عنوان نهاية المنطقة
#   فئة: فئة المنطقة (كود، بيانات، كومة، ...)
#   أذونات: أذونات المنطقة (قراءة، كتابة، تنفيذ)
# النتيجة: فهرس المنطقة، أو -1 عند الفشل
دالة إضافة_منطقة(معرف_مساحة، بداية، نهاية_م، فئة، أذونات)
    إذا (معرف_مساحة < 0)
        ارجع -1
    نهاية
    إذا (معرف_مساحة >= ثابت_اقصى_مساحات)
        ارجع -1
    نهاية
    
    # فحص هل المساحة موجودة
    متغير دليل = مساحة_دليل_صفحات(معرف_مساحة)
    إذا (دليل == 0)
        ارجع -1
    نهاية
    
    # فحص التداخل مع مناطق موجودة
    متغير عدد_مناطق = مساحة_عدد_مناطق(معرف_مساحة)
    متغير ف = 0
    بينما (ف < عدد_مناطق)
        متغير ب_موجودة = منطقة_بداية(معرف_مساحة، ف)
        متغير ن_موجودة = منطقة_نهاية(معرف_مساحة، ف)
        متغير ت_موجودة = منطقة_فئة(معرف_مساحة، ف)
        
        # تجاهل المناطق المحذوفة (فئة = 0)
        إذا (ت_موجودة != 0)
            # فحص التداخل
            إذا (بداية < ن_موجودة)
                إذا (نهاية_م > ب_موجودة)
                    # تداخل!
                    إحصاء_أخطاء = إحصاء_أخطاء + 1
                    ارجع -1
                نهاية
            نهاية
        نهاية
        
        ف = ف + 1
    نهاية
    
    # البحث عن خانة فارغة
    متغير فهرس_جديد = -1
    ف = 0
    بينما (ف < ثابت_اقصى_مناطق)
        متغير ت = منطقة_فئة(معرف_مساحة، ف)
        إذا (ت == 0)
            فهرس_جديد = ف
            ف = ثابت_اقصى_مناطق
        نهاية
        ف = ف + 1
    نهاية
    
    إذا (فهرس_جديد < 0)
        إحصاء_أخطاء = إحصاء_أخطاء + 1
        ارجع -1
    نهاية
    
    # كتابة سجل المنطقة
    منطقة_كتابة_حقل(معرف_مساحة، فهرس_جديد، 0، بداية)
    منطقة_كتابة_حقل(معرف_مساحة، فهرس_جديد، 1، نهاية_م)
    منطقة_كتابة_حقل(معرف_مساحة، فهرس_جديد، 2، فئة)
    منطقة_كتابة_حقل(معرف_مساحة، فهرس_جديد، 3، أذونات)
    منطقة_كتابة_حقل(معرف_مساحة، فهرس_جديد، 4، 0)
    منطقة_كتابة_حقل(معرف_مساحة، فهرس_جديد، 5، 0)
    
    # تحديث عدد المناطق
    متغير عدد_جديد = مساحة_عدد_مناطق(معرف_مساحة) + 1
    مساحة_كتابة_حقل(معرف_مساحة، 2، عدد_جديد)
    
    إحصاء_مناطق_منشأة = إحصاء_مناطق_منشأة + 1
    ارجع فهرس_جديد
نهاية

# حذف منطقة ذاكرة
دالة حذف_منطقة(معرف_مساحة، فهرس_منطقة)
    إذا (معرف_مساحة < 0)
        ارجع 0
    نهاية
    إذا (فهرس_منطقة < 0)
        ارجع 0
    نهاية
    إذا (فهرس_منطقة >= ثابت_اقصى_مناطق)
        ارجع 0
    نهاية
    
    # تصفير المنطقة
    متغير ق = 0
    بينما (ق < ثابت_مقاس_سجل)
        منطقة_كتابة_حقل(معرف_مساحة، فهرس_منطقة، ق، 0)
        ق = ق + 1
    نهاية
    
    إحصاء_مناطق_محذوفة = إحصاء_مناطق_محذوفة + 1
    ارجع 1
نهاية

# ============================================================
# البحث عن مناطق
# ============================================================

# البحث عن المنطقة التي تحتوي على عنوان افتراضي
# النتيجة: فهرس المنطقة، أو -1 إذا لم يوجد
دالة بحث_منطقة_بالعنوان(معرف_مساحة، عنوان)
    متغير ف = 0
    بينما (ف < ثابت_اقصى_مناطق)
        متغير فئة_م = منطقة_فئة(معرف_مساحة، ف)
        إذا (فئة_م != 0)
            متغير بداية_م = منطقة_بداية(معرف_مساحة، ف)
            متغير نهاية_م = منطقة_نهاية(معرف_مساحة، ف)
            إذا (عنوان >= بداية_م)
                إذا (عنوان < نهاية_م)
                    ارجع ف
                نهاية
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

# البحث عن مساحة حرة بمقاس معين
# يبحث في النطاق المحدد عن فجوة كافية
دالة بحث_مساحة_حرة(معرف_مساحة، مقاس_مطلوب، بداية_بحث، نهاية_بحث)
    # خوارزمية بسيطة: البحث من البداية عن أول فجوة كافية
    متغير عنوان_حالي = بداية_بحث
    
    بينما (عنوان_حالي + مقاس_مطلوب <= نهاية_بحث)
        # فحص هل هذا العنوان داخل منطقة موجودة
        متغير فهرس = بحث_منطقة_بالعنوان(معرف_مساحة، عنوان_حالي)
        إذا (فهرس < 0)
            # ليس داخل منطقة — فحص هل كل النطاق حر
            متغير نهاية_فحص = عنوان_حالي + مقاس_مطلوب
            متغير فهرس2 = بحث_منطقة_بالعنوان(معرف_مساحة، نهاية_فحص - 1)
            إذا (فهرس2 < 0)
                # المساحة حرة!
                ارجع عنوان_حالي
            وإلا
                # نهاية النطاق في منطقة — تجاوزها
                متغير نهاية_منطقة = منطقة_نهاية(معرف_مساحة، فهرس2)
                عنوان_حالي = نهاية_منطقة
            نهاية
        وإلا
            # العنوان في منطقة — تجاوزها
            متغير نهاية_منطقة = منطقة_نهاية(معرف_مساحة، فهرس)
            عنوان_حالي = نهاية_منطقة
        نهاية
    نهاية
    
    ارجع 0
نهاية

# ============================================================
# إدارة الكومة (brk / sbrk)
# ============================================================

# تعيين نقطة كسر الكومة (مثل brk() في Linux)
# المعاملات: معرف_مساحة، عنوان_جديد
# النتيجة: العنوان الجديد، أو 0 عند الفشل
دالة تعيين_كسر_كومة(معرف_مساحة، عنوان_جديد)
    إذا (معرف_مساحة < 0)
        ارجع 0
    نهاية
    
    # الحصول على النقطة الحالية
    متغير كومة_حالية = مساحة_نقطة_كومة(معرف_مساحة)
    
    # فحص الحدود
    إذا (عنوان_جديد < ثابت_بداية_كومة)
        ارجع 0
    نهاية
    إذا (عنوان_جديد > ثابت_اقصى_كومة)
        ارجع 0
    نهاية
    
    # محاذاة العنوان لحدود صفحة
    متغير عنوان_محاذاة = (عنوان_جديد + 4095) & (~4095)
    
    # تحديث نقطة الكسر
    مساحة_كتابة_حقل(معرف_مساحة، 3، عنوان_محاذاة)
    
    ارجع عنوان_محاذاة
نهاية

# زيادة الكومة (مثل sbrk() في Linux)
# المعاملات: معرف_مساحة، زيادة (بالبايت)
# النتيجة: العنوان القديم (بداية المنطقة الجديدة)، أو 0 عند الفشل
دالة زيادة_كومة(معرف_مساحة، زيادة)
    متغير كومة_حالية = مساحة_نقطة_كومة(معرف_مساحة)
    متغير كومة_جديدة = كومة_حالية + زيادة
    
    متغير نتيجة = تعيين_كسر_كومة(معرف_مساحة، كومة_جديدة)
    إذا (نتيجة == 0)
        ارجع 0
    نهاية
    
    ارجع كومة_حالية
نهاية

