# ============================================================
# أنواع المناطق
# ============================================================

# كود — قراءة + تنفيذ
متغير فئة_كود = 1
# بيانات — قراءة + كتابة
متغير فئة_بيانات = 2
# كومة — قراءة + كتابة + نمو
متغير فئة_كومة = 3
# مكدس — قراءة + كتابة + نمو عكسي
متغير فئة_مكدس = 4
# ذاكرة مشتركة
متغير فئة_مشتركة = 5
# ربط ملفات
متغير فئة_ربط_ملف = 6
# نواة
متغير فئة_نواة = 7
