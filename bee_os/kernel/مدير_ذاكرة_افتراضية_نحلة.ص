    منطقة_كتابة_حقل(معرف_مساحة، فهرس، 3، أذونات_جديدة)
    ارجع 1
نهاية

# ============================================================
# توسعة منطقة (لنمو الكومة أو المكدس)
# ============================================================

# توسعة منطقة من جهة النهاية (نمو للأعلى — كومة)
دالة توسعة_منطقة_للأعلى(معرف_مساحة، فهرس_منطقة، مقاس_إضافي)
    إذا (فهرس_منطقة < 0)
        ارجع 0
    نهاية
    
    متغير نهاية_حالية = منطقة_نهاية(معرف_مساحة، فهرس_منطقة)
    متغير نهاية_جديدة = نهاية_حالية + مقاس_إضافي
    
    # محاذاة
    نهاية_جديدة = (نهاية_جديدة + 4095) & (~4095)
    
    # فحص التداخل
    متغير فهرس_تداخل = بحث_منطقة_بالعنوان(معرف_مساحة، نهاية_جديدة - 1)
    إذا (فهرس_تداخل >= 0)
        إذا (فهرس_تداخل != فهرس_منطقة)
            ارجع 0
        نهاية
    نهاية
    
    # تحديث النهاية
    منطقة_كتابة_حقل(معرف_مساحة، فهرس_منطقة، 1، نهاية_جديدة)
    ارجع 1
نهاية

# توسعة منطقة من جهة البداية (نمو للأسفل — مكدس)
دالة توسعة_منطقة_للأسفل(معرف_مساحة، فهرس_منطقة، مقاس_إضافي)
    إذا (فهرس_منطقة < 0)
        ارجع 0
    نهاية
    
    متغير بداية_حالية = منطقة_بداية(معرف_مساحة، فهرس_منطقة)
    
    إذا (بداية_حالية < مقاس_إضافي)
        ارجع 0
    نهاية
    
    متغير بداية_جديدة = بداية_حالية - مقاس_إضافي
    بداية_جديدة = بداية_جديدة & (~4095)
    
    # فحص التداخل
    متغير فهرس_تداخل = بحث_منطقة_بالعنوان(معرف_مساحة، بداية_جديدة)
    إذا (فهرس_تداخل >= 0)
        إذا (فهرس_تداخل != فهرس_منطقة)
            ارجع 0
        نهاية
    نهاية
    
    # تحديث البداية
    منطقة_كتابة_حقل(معرف_مساحة، فهرس_منطقة، 0، بداية_جديدة)
    ارجع 1
نهاية

# ============================================================
# تقسيم منطقة (لتغيير أذونات جزء منها)
# ============================================================

# تقسيم منطقة عند عنوان محدد
# تُنشئ منطقتين: [بداية..عنوان] و [عنوان..نهاية]
دالة تقسيم_منطقة(معرف_مساحة، فهرس_منطقة، عنوان_تقسيم)
    إذا (فهرس_منطقة < 0)
        ارجع -1
    نهاية
    
    متغير بداية_أصلية = منطقة_بداية(معرف_مساحة، فهرس_منطقة)
    متغير نهاية_أصلية = منطقة_نهاية(معرف_مساحة، فهرس_منطقة)
    متغير فئة_أصلية = منطقة_فئة(معرف_مساحة، فهرس_منطقة)
    متغير أذونات_أصلية = منطقة_أذونات(معرف_مساحة، فهرس_منطقة)
    
    # فحص هل عنوان التقسيم ضمن النطاق
    إذا (عنوان_تقسيم <= بداية_أصلية)
        ارجع -1
    نهاية
    إذا (عنوان_تقسيم >= نهاية_أصلية)
        ارجع -1
    نهاية
    
    # تعديل المنطقة الأصلية (النصف الأول)
    منطقة_كتابة_حقل(معرف_مساحة، فهرس_منطقة، 1، عنوان_تقسيم)
    
    # إنشاء المنطقة الثانية
    متغير فهرس_جديد = إضافة_منطقة(معرف_مساحة، عنوان_تقسيم، نهاية_أصلية، فئة_أصلية، أذونات_أصلية)
    
    ارجع فهرس_جديد
نهاية

