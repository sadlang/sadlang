# ============================================================
# نسخ مساحة عناوين (fork)
# ============================================================

# نسخ مساحة عناوين لعملية ابن (fork)
# ينسخ جميع المناطق والمرجعيات
دالة نسخ_مساحة_عناوين(معرف_أب، معرف_ابن)
    # نسخ جميع المناطق
    متغير ف = 0
    بينما (ف < ثابت_اقصى_مناطق)
        متغير فئة_م = منطقة_فئة(معرف_أب، ف)
        إذا (فئة_م != 0)
            # نسخ السجل كاملاً
            متغير ق = 0
            بينما (ق < ثابت_مقاس_سجل)
                متغير قيمة = منطقة_قراءة_حقل(معرف_أب، ف، ق)
                منطقة_كتابة_حقل(معرف_ابن، ف، ق، قيمة)
                ق = ق + 1
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    
    # نسخ نقطة كسر الكومة
    متغير كومة = مساحة_نقطة_كومة(معرف_أب)
    مساحة_كتابة_حقل(معرف_ابن، 3، كومة)
    
    # نسخ عدد المناطق
    متغير عدد = مساحة_عدد_مناطق(معرف_أب)
    مساحة_كتابة_حقل(معرف_ابن، 2، عدد)
    
    ارجع 1
نهاية

