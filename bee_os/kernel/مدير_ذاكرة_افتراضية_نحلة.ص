متغير ثابت_نهاية_بيانات = 134217727

# منطقة الكومة (نمو للأعلى)
متغير ثابت_بداية_كومة = 134217728
متغير ثابت_اقصى_كومة = 1073741823

# منطقة ربط الملفات
