# إنشاء المناطق الافتراضية لعملية جديدة
دالة تهيئة_مناطق_عملية(معرف_مساحة)
    # 1. إضافة منطقة الكود
    إضافة_منطقة(معرف_مساحة، ثابت_بداية_كود، ثابت_نهاية_كود، فئة_كود، إذن_قراءة_تنفيذ)
    
    # 2. إضافة منطقة البيانات
    إضافة_منطقة(معرف_مساحة، ثابت_بداية_بيانات، ثابت_نهاية_بيانات، فئة_بيانات، إذن_قراءة_كتابة)
    
    # 3. إضافة منطقة الكومة (أصغر مقاس مبدئي)
    متغير كومة_مبدئية = ثابت_بداية_كومة + 65536
    إضافة_منطقة(معرف_مساحة، ثابت_بداية_كومة، كومة_مبدئية، فئة_كومة، إذن_قراءة_كتابة)
    
    # 4. إضافة منطقة المكدس (أعلى منطقة المستخدم)
    # المكدس ينمو للأسفل من 0xBFFFFFFF
    متغير قمة_مكدس = 3221225472
    متغير قاع_مكدس = 3221225472 - 65536
    إضافة_منطقة(معرف_مساحة، قاع_مكدس، قمة_مكدس، فئة_مكدس، إذن_قراءة_كتابة)
    
    ارجع 1
نهاية

