#  § 13 — معالجة أحداث لوحة المفاتيح
# ══════════════════════════════════════════════════════════════

# معالج Scan Code Set 1
# يُستدعى من ISR الذي يقرأ Port 0x60

دالة معالجة_مفتاح(scan_code)
    # Key Up event: scan_code >= 0x80
    إذا (scan_code >= 128)
        متغير مفتاح_رفع = scan_code - 128
        # Shift Release
        إذا (مفتاح_رفع == 42 || مفتاح_رفع == 54)
            حالة_شيفت[0] = 0
        نهاية
        # Ctrl Release
        إذا (مفتاح_رفع == 29)
            حالة_كنترول[0] = 0
        نهاية
        # Alt Release
        إذا (مفتاح_رفع == 56)
            حالة_ألت[0] = 0
        نهاية
        ارجع 0
    نهاية

    # Key Down event
    آخر_مفتاح[0] = scan_code

    # Modifier keys
    إذا (scan_code == 42 || scan_code == 54)
        حالة_شيفت[0] = 1
        ارجع 0
    نهاية
    إذا (scan_code == 29)
        حالة_كنترول[0] = 1
        ارجع 0
    نهاية
    إذا (scan_code == 56)
        حالة_ألت[0] = 1
        ارجع 0
    نهاية

    # تحويل Scan Code → ASCII
    إذا (scan_code >= 0 && scan_code < طول(مفاتيح_عادية))
        متغير حرف = مفاتيح_عادية[scan_code]
        إذا (حرف != "")
            ارجع scan_code
        نهاية
    نهاية

    ارجع scan_code
نهاية

