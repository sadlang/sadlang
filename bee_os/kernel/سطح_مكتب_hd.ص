# --- رسم خلفية سطح المكتب ---
# تدرج لوني من الأعلى (داكن) إلى الأسفل (فاتح)
# sad_ll_fb_fill_rect لكل شريط أفقي

دالة رسم_خلفية()
    اطبع("[FB] رسم خلفية HD... ")
    # تدرج لوني: 20 شريط أفقي
    متغير أشرطة = 20
    متغير ارتفاع_شريط = ارتفاع_شاشة / أشرطة
    متغير ش = [0]
    بينما (ش[0] < أشرطة)
        متغير رقم_شريط = ش[0]
        # لون متدرج: أزرق داكن → أزرق فاتح
        متغير قيمة_أزرق = 40 + رقم_شريط * 8
        متغير لون_شريط = قيمة_أزرق + (رقم_شريط * 3) * 256
        # sad_ll_fb_fill_rect(0, ش*ارتفاع, 1920, ارتفاع, لون)
        ش[0] = ش[0] + 1
    نهاية
    اطبع_سطر("✓ (" + أشرطة + " شريط تدرّج)")
    ارجع 1
نهاية

# --- رسم شريط المهام ---
