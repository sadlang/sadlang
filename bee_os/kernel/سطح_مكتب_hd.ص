# --- اختبار 9: لوحة المفاتيح ---
دالة اختبار_لوحة_مفاتيح()
    اطبع_سطر("")
    اطبع_سطر("=== اختبار 9: لوحة المفاتيح — Scan Code Set 1 ===")

    # محاكاة ضغط المفاتيح
    # A = scan code 0x1E (30)
    متغير ن1 = معالجة_مفتاح(30)
    اطبع_سطر("  [+] Scan 0x1E → A (result=" + ن1 + ")")

    # Shift Down = 0x2A (42)
    معالجة_مفتاح(42)
    اطبع_سطر("  [+] Scan 0x2A → Shift ↓ (shift=" + حالة_شيفت[0] + ")")

    # Shift Up = 0x2A + 0x80 = 0xAA (170)
    معالجة_مفتاح(170)
    اطبع_سطر("  [+] Scan 0xAA → Shift ↑ (shift=" + حالة_شيفت[0] + ")")

    # Enter = 0x1C (28)
    متغير ن2 = معالجة_مفتاح(28)
    اطبع_سطر("  [+] Scan 0x1C → Enter (result=" + ن2 + ")")

    # Space = 0x39 (57)
    متغير ن3 = معالجة_مفتاح(57)
    اطبع_سطر("  [+] Scan 0x39 → Space (result=" + ن3 + ")")

    # Ctrl+C = Ctrl(29) then C(46)
    معالجة_مفتاح(29)
    متغير ن4 = معالجة_مفتاح(46)
    اطبع_سطر("  [+] Ctrl+C: ctrl=" + حالة_كنترول[0] + " scan=" + ن4)

    # Ctrl Release
    معالجة_مفتاح(157)

    إذا (ن1 == 30 && حالة_شيفت[0] == 0 && آخر_مفتاح[0] == 46)
        اطبع_سطر("[نجح] لوحة المفاتيح: مفاتيح + modifiers + Scan Codes")
        نجاح_hd[0] = نجاح_hd[0] + 1
    وإلا
        اطبع_سطر("[فشل] معالجة لوحة المفاتيح")
    نهاية
نهاية

