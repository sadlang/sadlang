# محاكاة معالج مقاطعة IRQ12 (PS/2 Mouse)
# يقرأ 3 بايتات من Port 0x60 ويحسب dx, dy, buttons

دالة معالجة_فأرة(dx، dy، أزرار)
    # تحديث الموقع مع حدود الشاشة
    متغير س_جديد = مؤشر_س[0] + dx
    متغير ص_جديد = مؤشر_ص[0] - dy

    # حدود الشاشة (0..1919, 0..1031 — فوق شريط المهام)
    إذا (س_جديد < 0)
        س_جديد = 0
    نهاية
    إذا (س_جديد >= عرض_شاشة)
        س_جديد = عرض_شاشة - 1
    نهاية
    إذا (ص_جديد < 0)
        ص_جديد = 0
    نهاية
    إذا (ص_جديد >= ارتفاع_شاشة)
        ص_جديد = ارتفاع_شاشة - 1
    نهاية

    مؤشر_س[0] = س_جديد
    مؤشر_ص[0] = ص_جديد
    فأرة_زر[0] = أزرار

    # كشف النقرة (الزر الأيسر = bit 0)
    إذا (أزرار == 1)
        فأرة_نقرة[0] = فأرة_نقرة[0] + 1
    نهاية

    ارجع 1
نهاية

