# --- تهيئة PS/2 Mouse ---
# يرسل أوامر إلى وحدة تحكم PS/2 عبر Port 0x64/0x60
# الخطوات:
#   1. تمكين المنفذ الثاني (0x64 ← 0xA8)
#   2. تفعيل مقاطعة IRQ12 في PIC
#   3. تفعيل الفأرة (0x64 ← 0xD4, 0x60 ← 0xF4)
#   4. انتظار ACK (0xFA)

دالة تهيئة_الفأرة()
    اطبع_سطر("[HW] PS/2 Mouse — تهيئة IRQ12")
    اطبع_سطر("  [+] 0x64 ← 0xA8: تمكين المنفذ الثاني")
    اطبع_سطر("  [+] 0x64 ← 0xD4, 0x60 ← 0xF4: تفعيل الإبلاغ")
    اطبع_سطر("  [+] PIC: فتح قناع IRQ12 (0xA1 bit 4)")
    اطبع_سطر("  [+] IDT[44] ← معالج_فأرة (IRQ12 = INT 44)")

    # تعيين الموقع المبدئي: وسط الشاشة
    مؤشر_س[0] = عرض_شاشة / 2
    مؤشر_ص[0] = ارتفاع_شاشة / 2
    فأرة_زر[0] = 0
    فأرة_نقرة[0] = 0
    فأرة_مهيأة[0] = 1

    اطبع_سطر("  ✓ الفأرة جاهزة — الموقع: (" + مؤشر_س[0] + ", " + مؤشر_ص[0] + ")")
    ارجع 1
نهاية

# --- تهيئة PS/2 Keyboard ---
# الخطوات:
#   1. مسح المخزن المؤقت (قراءة 0x60 حتى bit 0 في 0x64 = 0)
#   2. تمكين المقاطعة IRQ1 في PIC
#   3. IDT[33] ← معالج_لوحة_مفاتيح (IRQ1 = INT 33)

دالة تهيئة_لوحة_المفاتيح()
    اطبع_سطر("[HW] PS/2 Keyboard — تهيئة IRQ1")
    اطبع_سطر("  [+] مسح المخزن المؤقت — port 0x60")
    اطبع_سطر("  [+] PIC: فتح قناع IRQ1 (0x21 bit 1)")
    اطبع_سطر("  [+] IDT[33] ← معالج_لوحة_مفاتيح (IRQ1 = INT 33)")
    اطبع_سطر("  [+] جدول المفاتيح: Scan Code Set 1 (" + طول(مفاتيح_عادية) + " مفتاح)")

    آخر_مفتاح[0] = 0
    حالة_شيفت[0] = 0
    حالة_كنترول[0] = 0
    حالة_ألت[0] = 0
    لوحة_مهيأة[0] = 1

    اطبع_سطر("  ✓ لوحة المفاتيح جاهزة — Set 1 Scan Codes")
    ارجع 1
نهاية

# --- اكتشاف وحدات تحكم USB عبر PCI ---
# يبحث عن أجهزة PCI بـ Class=0x0C, Subclass=0x03
# Prog IF: 0x00=UHCI, 0x10=OHCI, 0x20=EHCI, 0x30=xHCI

دالة اكتشاف_usb()
    اطبع_سطر("[USB] PCI Bus Scan — Class 0x0C Sub 0x03")

    # محاكاة اكتشاف متحكمات USB من PCI
    # PCI Config Space: Bus/Dev/Func + Vendor/Device ID + Class/Sub/PI

    # متحكم xHCI (USB 3.0)
    أضف(usb_متحكمات_أنماط، "xHCI")
    أضف(usb_متحكمات_ناقل، 0)
    أضف(usb_متحكمات_جهاز، 20)
    أضف(usb_متحكمات_مصنع، "8086:A12F")
    usb_متحكمات_عدد[0] = usb_متحكمات_عدد[0] + 1

    # متحكم EHCI (USB 2.0)
    أضف(usb_متحكمات_أنماط، "EHCI")
    أضف(usb_متحكمات_ناقل، 0)
    أضف(usb_متحكمات_جهاز، 26)
    أضف(usb_متحكمات_مصنع، "8086:A12D")
    usb_متحكمات_عدد[0] = usb_متحكمات_عدد[0] + 1

    متغير ع = [0]
    بينما (ع[0] < usb_متحكمات_عدد[0])
        متغير فهرس_متحكم = ع[0]
        اطبع_سطر("  [PCI " + usb_متحكمات_ناقل[فهرس_متحكم] + ":" + usb_متحكمات_جهاز[فهرس_متحكم] + "] " + usb_متحكمات_أنماط[فهرس_متحكم] + " — " + usb_متحكمات_مصنع[فهرس_متحكم])
        ع[0] = ع[0] + 1
    نهاية

    # اكتشاف الأجهزة المتصلة بالمتحكمات
    اطبع_سطر("[USB] تعداد الأجهزة المتصلة...")

    # فأرة USB (HID Class 0x03)
    أضف(usb_أجهزة_أسماء، "BeeOS USB Mouse")
    أضف(usb_أجهزة_أنماط، "HID")
    أضف(usb_أجهزة_حالات، "متصل")
    أضف(usb_أجهزة_فئات، 3)
    usb_أجهزة_عدد[0] = usb_أجهزة_عدد[0] + 1

    # لوحة مفاتيح USB (HID Class 0x03)
    أضف(usb_أجهزة_أسماء، "BeeOS USB Keyboard")
    أضف(usb_أجهزة_أنماط، "HID")
    أضف(usb_أجهزة_حالات، "متصل")
    أضف(usb_أجهزة_فئات، 3)
    usb_أجهزة_عدد[0] = usb_أجهزة_عدد[0] + 1

    # قرص تخزين USB (Mass Storage Class 0x08)
    أضف(usb_أجهزة_أسماء، "SanDisk Ultra 32GB")
    أضف(usb_أجهزة_أنماط، "MSC")
    أضف(usb_أجهزة_حالات، "متصل")
    أضف(usb_أجهزة_فئات، 8)
    usb_أجهزة_عدد[0] = usb_أجهزة_عدد[0] + 1

    # USB Hub (Class 0x09)
    أضف(usb_أجهزة_أسماء، "Generic USB 3.0 Hub")
    أضف(usb_أجهزة_أنماط، "HUB")
    أضف(usb_أجهزة_حالات، "متصل")
    أضف(usb_أجهزة_فئات، 9)
    usb_أجهزة_عدد[0] = usb_أجهزة_عدد[0] + 1

    متغير ج = [0]
    بينما (ج[0] < usb_أجهزة_عدد[0])
        متغير فهرس_جهاز = ج[0]
        متغير وصف_فئة = "غير معروف"
        متغير رقم_فئة = usb_أجهزة_فئات[فهرس_جهاز]
        إذا (رقم_فئة == 3)
            وصف_فئة = "واجهة بشرية HID"
        نهاية
        إذا (رقم_فئة == 8)
            وصف_فئة = "تخزين كبير MSC"
        نهاية
        إذا (رقم_فئة == 9)
            وصف_فئة = "موزّع منافذ HUB"
        نهاية
        اطبع_سطر("  [USB:" + فهرس_جهاز + "] " + usb_أجهزة_أسماء[فهرس_جهاز] + " — " + usb_أجهزة_أنماط[فهرس_جهاز] + " (" + وصف_فئة + ") [" + usb_أجهزة_حالات[فهرس_جهاز] + "]")
        ج[0] = ج[0] + 1
    نهاية

    اطبع_سطر("  ✓ USB: " + usb_متحكمات_عدد[0] + " متحكم، " + usb_أجهزة_عدد[0] + " جهاز")
    ارجع usb_أجهزة_عدد[0]
نهاية

