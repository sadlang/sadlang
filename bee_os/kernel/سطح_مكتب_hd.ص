    اطبع_سطر("[GPU] Framebuffer HD — تهيئة")
    اطبع_سطر("  [+] sad_ll_uefi_init_gop() — بروتوكول GOP")
    اطبع_سطر("  [+] sad_ll_uefi_set_gop_mode(4) — 1920×1080")
