    أضف(شريط_عناصر_ألوان، لون_شريط_مهام)
    شريط_عناصر_عدد[0] = شريط_عناصر_عدد[0] + 1

    أضف(شريط_عناصر_أسماء، "📶 الشبكة")
    أضف(شريط_عناصر_ألوان، لون_شريط_مهام)
    شريط_عناصر_عدد[0] = شريط_عناصر_عدد[0] + 1

    أضف(شريط_عناصر_أسماء، "🕐 14:47")
    أضف(شريط_عناصر_ألوان، لون_شريط_مهام)
    شريط_عناصر_عدد[0] = شريط_عناصر_عدد[0] + 1

    # sad_ll_fb_fill_rect(0, ص_شريط, 1920, 48, لون_شريط_مهام)
    اطبع("  [+] الخلفية: 1920×" + ارتفاع_شريط_مهام + " ")

    # عرض العناصر
    متغير ي = [0]
