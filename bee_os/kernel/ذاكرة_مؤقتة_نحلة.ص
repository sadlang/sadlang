# القسم 4: إيجاد خانة حرة أو LRU
# ══════════════════════════════════════════════

#* ── ابحث عن خانة حرة أو أقدم خانة ── *#
دالة ذاكرة_خانة_حرة()
    # أولاً: ابحث عن خانة غير مستخدمة
    متغير ع = 0
    بينما (ع < 8)
        متغير فعالة = اقرأ_خانة(ع، 5)
        إذا (فعالة == 0)
            ارجع ع
        نهاية
        ع = ع + 1
    نهاية
    
    # الكل مستخدم: اختر LRU
    متغير أقدم_فهرس = 0
    متغير أقدم_وصول = اقرأ_خانة(0، 3)
    
    متغير ع2 = 1
    بينما (ع2 < 8)
        متغير وصول = اقرأ_خانة(ع2، 3)
        إذا (وصول < أقدم_وصول)
            أقدم_وصول = وصول
            أقدم_فهرس = ع2
        نهاية
        ع2 = ع2 + 1
    نهاية
    
    إزاحات_lru = إزاحات_lru + 1
    ارجع أقدم_فهرس
نهاية

# ══════════════════════════════════════════════
# القسم 5: قراءة من خلال الذاكرة المؤقتة
# ══════════════════════════════════════════════

#* ── قراءة قطاع مع تخزين مؤقت ──
   يرجع عنوان البيانات في الذاكرة المؤقتة
*#
صدّر دالة ذاكرة_اقرأ_قطاع(قرص، قطاع)
    # هل موجود في الذاكرة؟
    متغير نتيجة = ذاكرة_ابحث(قرص، قطاع)
    إذا (نتيجة >= 0)
        ارجع اقرأ_خانة(نتيجة، 2)
    نهاية
    
    # إخفاق: نحتاج خانة
    متغير خانة = ذاكرة_خانة_حرة()
    
    # هل الخانة القديمة فعالة ومتسخة؟
    متغير فعالة_قديمة = اقرأ_خانة(خانة، 5)
    إذا (فعالة_قديمة == 1)
        متغير متسخة_قديمة = اقرأ_خانة(خانة، 4)
        إذا (متسخة_قديمة == 1)
            # يجب كتابة الخانة المتسخة قبل الاستبدال
            # (في نظام حقيقي: disk_write_sector)
            كتابات_قذرة = كتابات_قذرة + 1
        نهاية
    نهاية
    
    # تخصيص ذاكرة إذا لم تكن موجودة
    متغير عنوان_بيانات = اقرأ_خانة(خانة، 2)
    إذا (عنوان_بيانات == 0)
        عنوان_بيانات = kernel_allocate(512)
        إذا (عنوان_بيانات == 0)
            ارجع 0
        نهاية
    نهاية
    
    # قراءة من القرص
    disk_read_sector(قرص، قطاع، عنوان_بيانات)
    
    # تحديث الخانة
    ساعة_عامة = ساعة_عامة + 1
    اكتب_خانة(خانة، 0، قرص)
    اكتب_خانة(خانة، 1، قطاع)
    اكتب_خانة(خانة، 2، عنوان_بيانات)
    اكتب_خانة(خانة، 3، ساعة_عامة)
    اكتب_خانة(خانة، 4، 0)
    اكتب_خانة(خانة، 5، 1)
    
    ارجع عنوان_بيانات
نهاية

#* ── تعليم خانة كمتسخة ── *#
صدّر دالة ذاكرة_علّم_متسخة(قرص، قطاع)
    متغير نتيجة = ذاكرة_ابحث(قرص، قطاع)
    إذا (نتيجة >= 0)
        اكتب_خانة(نتيجة، 4، 1)
        ارجع 0
    نهاية
    ارجع -1
نهاية

#* ── إبطال خانة ── *#
صدّر دالة ذاكرة_أبطل(قرص، قطاع)
    متغير نتيجة = ذاكرة_ابحث(قرص، قطاع)
    إذا (نتيجة >= 0)
        اكتب_خانة(نتيجة، 5، 0)
        اكتب_خانة(نتيجة، 4، 0)
        ارجع 0
    نهاية
    ارجع -1
