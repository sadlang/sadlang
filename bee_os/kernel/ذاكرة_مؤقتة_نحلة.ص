# القسم 3: البحث في الذاكرة المؤقتة
# ══════════════════════════════════════════════

#* ── البحث عن قطاع في الذاكرة ── *#
صدّر دالة ذاكرة_ابحث(قرص_مطلوب، قطاع_مطلوب)
    متغير ع = 0
    بينما (ع < 8)
        متغير فعالة = اقرأ_خانة(ع، 5)
        إذا (فعالة == 1)
            متغير قرص_خ = اقرأ_خانة(ع، 0)
            متغير قطاع_خ = اقرأ_خانة(ع، 1)
            إذا (قرص_خ == قرص_مطلوب)
                إذا (قطاع_خ == قطاع_مطلوب)
                    # إصابة! تحديث الوصول
                    ساعة_عامة = ساعة_عامة + 1
                    اكتب_خانة(ع، 3، ساعة_عامة)
                    إصابات_ذاكرة = إصابات_ذاكرة + 1
                    ارجع ع
                نهاية
            نهاية
        نهاية
        ع = ع + 1
    نهاية
    إخفاقات_ذاكرة = إخفاقات_ذاكرة + 1
    ارجع -1
نهاية

