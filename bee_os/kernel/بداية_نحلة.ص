## نقطة دخول النواة — تُستدعى من _start (assembly)
صدّر دالة بداية_النواة()
    # ═══════════════════════════════════════════════════════════════════════════
    #                    بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ
    # ═══════════════════════════════════════════════════════════════════════════
    
    # مرحلة 1: Serial
    مرحلة_1_serial()
    
    # طباعة البسملة على Serial
    serial_اطبع("\n")
    serial_اطبع("╔══════════════════════════════════════════════════════╗\n")
    serial_اطبع("║        بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ                ║\n")
    serial_اطبع("║                                                      ║\n")
    serial_اطبع("║     🐝  نِظَامُ النَّحْلَة — BeeOS                   ║\n")
    serial_اطبع("║     الإصدار: 0.1.1 Alpha                             ║\n")
    serial_اطبع("║                                                      ║\n")
    serial_اطبع("║     وَأَوْحَى رَبُّكَ إِلَى النَّحْلِ — ١٦:٦٨           ║\n")
    serial_اطبع("╚══════════════════════════════════════════════════════╝\n")
    serial_اطبع("\n")
    
    # مرحلة 2: GDT
    مرحلة_2_gdt()
    
    # مرحلة 3: المقاطعات (IDT + PIC)
    مرحلة_3_مقاطعات()
    
    # مرحلة 4: المؤقت
    مرحلة_4_مؤقت()
    
    # مرحلة 5: الشاشة
    مرحلة_5_شاشة()
    
    # مرحلة 6: شاشة الترحيب
    مرحلة_6_ترحيب()
    
    # مرحلة 7: تفعيل المقاطعات
    مرحلة_7_تفعيل_مقاطعات()
    
    # رسالة النجاح
    serial_اطبع("\n")
    serial_اطبع("══════════════════════════════════════════════════════\n")
    serial_اطبع("  ✓ BeeOS v0.1.1 جاهز — 7 مراحل مكتملة! 🐝\n")
    serial_اطبع("══════════════════════════════════════════════════════\n")
    serial_اطبع("  المكونات النشطة:\n")
    serial_اطبع("    • Serial/UART   — COM1 @ 115200 baud\n")
    serial_اطبع("    • GDT           — 64-bit flat model\n")
    serial_اطبع("    • IDT + PIC     — 256 entries, IRQ remapped\n")
    serial_اطبع("    • PIT Timer     — ")
    serial_اطبع_رقم(تردد_المؤقت)
    serial_اطبع(" Hz\n")
    serial_اطبع("    • Framebuffer   — ")
    serial_اطبع_رقم(شاشة_عرض)
    serial_اطبع("x")
    serial_اطبع_رقم(شاشة_ارتفاع)
    serial_اطبع("x")
    serial_اطبع_رقم(شاشة_عمق)
    serial_اطبع("\n")
    serial_اطبع("══════════════════════════════════════════════════════\n")
    serial_اطبع("\n")
    
    # ═══════════════════════════════════════════════════════════════════════════
    #                    حلقة الخمول — انتظار المقاطعات
    # ═══════════════════════════════════════════════════════════════════════════
    serial_اطبع("[BeeOS] النواة جاهزة — العودة للمُشغِّل\n")
    
    # نعيد التحكم إلى kernel_boot.c
    # الذي يدير حلقة الخمول الخاصة به
نهاية

