# ═══════════════════════════════════════════════════════════════════════════════

## البحث عن RSDP في نطاق ذاكرة معين
دالة acpi_ابحث_rsdp_في_نطاق(بداية، نهاية_بحث)
    متغير عنوان = بداية + 0
    بينما (عنوان < نهاية_بحث)
        # قراءة أول 4 بايت — "RSD "
        متغير sig_lo = sad_ll_mem_read32(عنوان) + 0
        إذا (sig_lo == RSDP_SIG_LO)
            # قراءة التالية — "PTR "
            متغير sig_hi = sad_ll_mem_read32(عنوان + 4) + 0
            إذا (sig_hi == RSDP_SIG_HI)
                # تحقق من checksum
                متغير مجموع = 0
                متغير ب = 0
                بينما (ب < 20)
                    مجموع = مجموع + (sad_ll_mem_read8(عنوان + ب) + 0)
                    ب = ب + 1
                نهاية
                إذا ((مجموع % 256) == 0)
                    pm_serial_اطبع("[PM] RSDP عثر عليه: ")
                    pm_serial_hex(عنوان)
                    pm_serial_اطبع("\n")
                    ارجع عنوان
                نهاية
            نهاية
        نهاية
        عنوان = عنوان + 16
    نهاية
    ارجع 0
نهاية

## البحث عن RSDP في المواقع القياسية
دالة acpi_ابحث_rsdp()
    # 1. البحث في EBDA (Extended BIOS Data Area)
    متغير ebda_seg = sad_ll_mem_read16(0x040E) + 0
    متغير ebda_addr = ebda_seg * 16
    إذا (ebda_addr > 0)
        متغير نتيجة = acpi_ابحث_rsdp_في_نطاق(ebda_addr، ebda_addr + 1024)
        إذا (نتيجة > 0)
            ارجع نتيجة
        نهاية
    نهاية
    
    # 2. البحث في BIOS ROM area (0xE0000 - 0xFFFFF)
    ارجع acpi_ابحث_rsdp_في_نطاق(917504، 1048576)
نهاية

