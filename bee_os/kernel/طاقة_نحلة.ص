## اختيار حالة C المناسبة بناءً على الخمول
دالة pm_اختر_c_state()
    متغير الآن = sad_ll_timer_get_ticks() + 0
    متغير مدة_الخمول = الآن - وقت_آخر_نشاط
    
    إذا (مدة_الخمول < 100)
        # نشاط قريب → C0 (لا تنتقل)
        ارجع 0
    نهاية
    
    إذا (مدة_الخمول < 1000)
        # خمول قصير → C1
        pm_ادخل_c1()
        ارجع 1
    نهاية
    
    إذا (سياسة_حالية == سياسة_أداء)
        # سياسة أداء → C1 فقط
        pm_ادخل_c1()
        ارجع 1
    نهاية
    
    إذا (مدة_الخمول < 10000)
        # خمول متوسط → C2
        pm_ادخل_c2()
        ارجع 2
    نهاية
    
    # خمول طويل → C3
    pm_ادخل_c3()
    ارجع 3
نهاية

