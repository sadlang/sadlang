## إعادة التشغيل
دالة pm_أعد_التشغيل()
    pm_serial_اطبع("[PM] إعادة تشغيل...\n")
    
    sad_ll_interrupt_disable()
    
    # طريقة 1: لوحة المفاتيح (8042)
    # انتظار حتى يصبح buffer جاهزاً
    متغير محاولة = 0
    بينما (محاولة < 1000)
        متغير حال = sad_ll_port_inb(100) + 0   # 0x64 = keyboard status
        إذا ((حال / 2) % 2 == 0)
            محاولة = 1000
        نهاية
        محاولة = محاولة + 1
    نهاية
    sad_ll_port_outb(100، 254)  # 0x64 ← 0xFE = نبضة إعادة التشغيل
    
    # طريقة 2: ACPI reset (FADT offset 128 — Reset Register)
    إذا (عنوان_fadt > 0)
        إذا (إصدار_acpi >= 2)
            متغير reset_reg = sad_ll_mem_read64(عنوان_fadt + 128) + 0
            متغير reset_val = sad_ll_mem_read8(عنوان_fadt + 128 + 8) + 0
            إذا (reset_reg > 0)
                sad_ll_port_outb(reset_reg، reset_val)
            نهاية
        نهاية
    نهاية
    
    # طريقة 3: Triple fault
    pm_serial_اطبع("[PM] Triple fault!\n")
    # في الحقيقة: تحميل IDT فارغ + INT
    
    بينما (1 == 1)
        # hlt
    نهاية
نهاية

