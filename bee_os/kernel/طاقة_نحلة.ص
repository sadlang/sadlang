## حساب التردد المستهدف بناءً على سياسة الطاقة والحمل
دالة pm_احسب_تردد_مستهدف(حمل_المعالج)
    إذا (سياسة_حالية == سياسة_أداء)
        ارجع تردد_أساسي
    نهاية
    
    إذا (سياسة_حالية == سياسة_توفير)
        # أقل تردد ممكن ما لم الحمل عالٍ
        إذا (حمل_المعالج > 80)
            ارجع تردد_أساسي
        نهاية
        إذا (حمل_المعالج > 50)
            ارجع (تردد_أساسي * 60) / 100
        نهاية
        ارجع (تردد_أساسي * 30) / 100
    نهاية
    
    إذا (سياسة_حالية == سياسة_بطارية)
        إذا (حمل_المعالج > 90)
            ارجع (تردد_أساسي * 80) / 100
        نهاية
        ارجع (تردد_أساسي * 25) / 100
    نهاية
    
    # متوازن (افتراضي)
    إذا (حمل_المعالج > 70)
        ارجع تردد_أساسي
    نهاية
    إذا (حمل_المعالج > 40)
        ارجع (تردد_أساسي * 70) / 100
    نهاية
    إذا (حمل_المعالج > 10)
        ارجع (تردد_أساسي * 50) / 100
    نهاية
    ارجع (تردد_أساسي * 30) / 100
نهاية

## تطبيق P-state (تغيير تردد المعالج)
دالة pm_طبق_p_state(تردد_مطلوب)
    إذا (تردد_مطلوب == تردد_حالي)
        ارجع 0
    نهاية
    
    # حساب P-state
    متغير p_new = 0
    إذا (تردد_مطلوب >= تردد_أساسي)
        p_new = 0   # P0
    وإلا
        إذا (تردد_مطلوب >= (تردد_أساسي * 75) / 100)
            p_new = 1
        وإلا
            إذا (تردد_مطلوب >= (تردد_أساسي * 50) / 100)
                p_new = 2
            وإلا
                إذا (تردد_مطلوب >= (تردد_أساسي * 25) / 100)
                    p_new = 3
                وإلا
                    p_new = 4
                نهاية
            نهاية
        نهاية
    نهاية
    
    إذا (p_new != p_state_حالي)
        p_state_حالي = p_new + 0
        تردد_حالي = تردد_مطلوب + 0
        عدد_انتقالات_p = عدد_انتقالات_p + 1
        
        # حساب الجهد المقابل
        إذا (p_new == 0)
            جهد_حالي = 1200
        نهاية
        إذا (p_new == 1)
            جهد_حالي = 1100
        نهاية
        إذا (p_new == 2)
            جهد_حالي = 1000
        نهاية
        إذا (p_new == 3)
            جهد_حالي = 900
        نهاية
        إذا (p_new == 4)
            جهد_حالي = 800
        نهاية
        
        pm_serial_اطبع("[PM] P-state → P")
        pm_serial_رقم(p_new)
        pm_serial_اطبع(" (تردد: ")
        pm_serial_رقم(تردد_حالي)
        pm_serial_اطبع(" MHz، جهد: ")
        pm_serial_رقم(جهد_حالي)
        pm_serial_اطبع(" mV)\n")
    نهاية
    
    ارجع p_new
نهاية

