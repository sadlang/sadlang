## تهيئة نظام إدارة الطاقة
صدّر دالة pm_هيئ()
    pm_serial_اطبع("\n")
    pm_serial_اطبع("[PM] ═══════════════════════════════════════\n")
    pm_serial_اطبع("[PM]  تهيئة نظام إدارة الطاقة — BeeOS\n")
    pm_serial_اطبع("[PM] ═══════════════════════════════════════\n")
    
    # 1. البحث عن RSDP
    عنوان_rsdp = acpi_ابحث_rsdp() + 0
    إذا (عنوان_rsdp == 0)
        pm_serial_اطبع("[PM] RSDP غير موجود — ACPI غير متاح\n")
        pm_serial_اطبع("[PM] نظام الطاقة يعمل بدون ACPI\n")
        acpi_مهيأ = 0
        ارجع 0
    نهاية
    
    # 2. تحليل RSDP
    acpi_حلل_rsdp(عنوان_rsdp)
    
    # 3. تحليل RSDT
    إذا (عنوان_rsdt > 0)
        acpi_حلل_rsdt(عنوان_rsdt)
    نهاية
    
    # 4. تحليل FADT
    إذا (عنوان_fadt > 0)
        acpi_حلل_fadt(عنوان_fadt)
    نهاية
    
    # 5. تحليل MADT
    إذا (عنوان_madt > 0)
        acpi_حلل_madt(عنوان_madt)
    نهاية
    
    # 6. تفعيل ACPI
    acpi_فعل()
    
    acpi_مهيأ = 1
    
    # 7. ضبط السياسة الافتراضية (متوازن)
    pm_غير_السياسة(سياسة_متوازن)
    
    # 8. طباعة تقرير
    pm_اطبع_تقرير()
    
    pm_serial_اطبع("[PM] ✓ نظام الطاقة جاهز\n\n")
    ارجع 1
نهاية

