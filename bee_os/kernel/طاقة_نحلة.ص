    عدد_انتقالات_c = عدد_انتقالات_c + 1
    c_state_لكل_معالج_0 = 3
    
    # قراءة من P_LVL3 register (FADT offset 120)
    إذا (عنوان_fadt > 0)
        متغير p_lvl3 = sad_ll_mem_read32(عنوان_fadt + 120) + 0
        إذا (p_lvl3 > 0)
