دالة pm_serial_اطبع(رسالة)
    متغير ط = 0
    بينما (ط < طول(رسالة))
        sad_ll_serial_write_char(COM1، رمز(رسالة[ط]))
        ط = ط + 1
    نهاية
نهاية

دالة pm_serial_رقم(ن)
    إذا (ن == 0)
        sad_ll_serial_write_char(COM1، 48)
        ارجع 0
    نهاية
    
    متغير خانات = 0
    متغير مؤقت = ن
    متغير أرقام_0 = 0
    متغير أرقام_1 = 0
    متغير أرقام_2 = 0
    متغير أرقام_3 = 0
    متغير أرقام_4 = 0
    متغير أرقام_5 = 0
    متغير أرقام_6 = 0
    متغير أرقام_7 = 0
    متغير أرقام_8 = 0
    متغير أرقام_9 = 0
    
    بينما (مؤقت > 0)
        متغير باقي = مؤقت % 10
        إذا (خانات == 0)
            أرقام_0 = باقي
        نهاية
        إذا (خانات == 1)
            أرقام_1 = باقي
        نهاية
        إذا (خانات == 2)
            أرقام_2 = باقي
        نهاية
        إذا (خانات == 3)
            أرقام_3 = باقي
        نهاية
        إذا (خانات == 4)
            أرقام_4 = باقي
        نهاية
        إذا (خانات == 5)
            أرقام_5 = باقي
        نهاية
        إذا (خانات == 6)
            أرقام_6 = باقي
        نهاية
        إذا (خانات == 7)
            أرقام_7 = باقي
        نهاية
        مؤقت = (مؤقت - باقي) / 10
        خانات = خانات + 1
    نهاية
    
    متغير ع = خانات - 1
    بينما (ع >= 0)
        متغير رقم_حالي = 0
        إذا (ع == 0)
            رقم_حالي = أرقام_0
        نهاية
        إذا (ع == 1)
            رقم_حالي = أرقام_1
        نهاية
        إذا (ع == 2)
            رقم_حالي = أرقام_2
        نهاية
        إذا (ع == 3)
            رقم_حالي = أرقام_3
        نهاية
        إذا (ع == 4)
            رقم_حالي = أرقام_4
        نهاية
        إذا (ع == 5)
            رقم_حالي = أرقام_5
        نهاية
        إذا (ع == 6)
            رقم_حالي = أرقام_6
        نهاية
        إذا (ع == 7)
            رقم_حالي = أرقام_7
        نهاية
        sad_ll_serial_write_char(COM1، 48 + رقم_حالي)
        ع = ع - 1
    نهاية
    ارجع 0
نهاية

دالة pm_serial_hex(ن)
    متغير أحرف = "0123456789ABCDEF"
    sad_ll_serial_write_char(COM1، 48)  # '0'
    sad_ll_serial_write_char(COM1، 120) # 'x'
    
    متغير تم = 0
    متغير ع = 28
    بينما (ع >= 0)
        متغير رباعي = 0
        إذا (ع == 28)
            رباعي = (ن / 268435456) % 16
        نهاية
        إذا (ع == 24)
            رباعي = (ن / 16777216) % 16
        نهاية
        إذا (ع == 20)
            رباعي = (ن / 1048576) % 16
        نهاية
        إذا (ع == 16)
            رباعي = (ن / 65536) % 16
        نهاية
        إذا (ع == 12)
            رباعي = (ن / 4096) % 16
        نهاية
        إذا (ع == 8)
            رباعي = (ن / 256) % 16
        نهاية
        إذا (ع == 4)
            رباعي = (ن / 16) % 16
        نهاية
        إذا (ع == 0)
            رباعي = ن % 16
        نهاية
        
        إذا (رباعي > 0)
            تم = 1
        نهاية
        إذا (تم == 1)
            sad_ll_serial_write_char(COM1، رمز(أحرف[رباعي]))
        نهاية
        ع = ع - 4
    نهاية
    إذا (تم == 0)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    ارجع 0
نهاية

