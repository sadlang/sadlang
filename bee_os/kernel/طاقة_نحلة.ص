    إذا (p_state_حالي == 1)
        طاقة_المعالج_mw = 45000    # 45W at P1
    نهاية
    إذا (p_state_حالي == 2)
        طاقة_المعالج_mw = 30000    # 30W at P2
    نهاية
    إذا (p_state_حالي == 3)
        طاقة_المعالج_mw = 15000    # 15W at P3
    نهاية
    إذا (p_state_حالي == 4)
        طاقة_المعالج_mw = 8000     # 8W at P4
    نهاية
    
    # C-state يقلل الاستهلاك
    إذا (c_state_لكل_معالج_0 == 1)
        طاقة_المعالج_mw = طاقة_المعالج_mw / 2
    نهاية
    إذا (c_state_لكل_معالج_0 == 2)
        طاقة_المعالج_mw = طاقة_المعالج_mw / 4
    نهاية
    إذا (c_state_لكل_معالج_0 == 3)
        طاقة_المعالج_mw = طاقة_المعالج_mw / 10
    نهاية
    
    # ذاكرة: ~3W ثابتة
    طاقة_الذاكرة_mw = 3000
    
    # أجهزة: ~10W
    طاقة_الأجهزة_mw = 10000
    
    الطاقة_الكلية_mw = طاقة_المعالج_mw + طاقة_الذاكرة_mw + طاقة_الأجهزة_mw
    
    ارجع الطاقة_الكلية_mw
