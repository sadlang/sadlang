## قراءة PM Timer (3.579545 MHz)  
دالة pm_اقرأ_مؤقت()
    إذا (pm_tmr_blk == 0)
        ارجع sad_ll_timer_get_ticks() + 0
    نهاية
    ارجع sad_ll_port_inl(pm_tmr_blk) + 0
نهاية

## تأخير بالميكروثانية باستخدام PM Timer
دالة pm_تأخير_us(ميكرو)
    إذا (pm_tmr_blk == 0)
        # fallback: busy wait
        متغير عد = ميكرو * 10
        بينما (عد > 0)
            عد = عد - 1
        نهاية
        ارجع 0
    نهاية
    
    # PM Timer ticks = microseconds × 3.579545 ≈ microseconds × 3 + microseconds × 579 / 1000
    متغير ticks = ميكرو * 3 + (ميكرو * 579) / 1000
    متغير start = sad_ll_port_inl(pm_tmr_blk) + 0
    
    بينما (1 == 1)
        متغير الآن_t = sad_ll_port_inl(pm_tmr_blk) + 0
        متغير فارق = الآن_t - start
        إذا (فارق < 0)
            # Timer wrap-around (24-bit or 32-bit)
            فارق = فارق + 16777216   # 2^24
        نهاية
        إذا (فارق >= ticks)
            ارجع 0
        نهاية
    نهاية
نهاية

