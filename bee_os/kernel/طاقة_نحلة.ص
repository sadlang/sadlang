    # كتابة SLP_TYP_S5 + SLP_EN
    متغير val = PM1_SLP_TYP_S5 + PM1_SLP_EN
    sad_ll_port_outw(pm1a_cnt_blk، val)
    
    إذا (pm1b_cnt_blk > 0)
