## تحليل RSDP واستخراج عنوان RSDT
دالة acpi_حلل_rsdp(rsdp)
    # إصدار ACPI
    إصدار_acpi = sad_ll_mem_read8(rsdp + 15) + 0
    pm_serial_اطبع("[PM] إصدار ACPI: ")
    pm_serial_رقم(إصدار_acpi)
    pm_serial_اطبع("\n")
    
    # عنوان RSDT (offset 16, 4 bytes)
    عنوان_rsdt = sad_ll_mem_read32(rsdp + 16) + 0
    pm_serial_اطبع("[PM] RSDT: ")
    pm_serial_hex(عنوان_rsdt)
    pm_serial_اطبع("\n")
    
    ارجع عنوان_rsdt
نهاية

## تحليل RSDT والبحث عن الجداول الفرعية
دالة acpi_حلل_rsdt(rsdt)
    # طول الجدول (offset 4)
    متغير الطول = sad_ll_mem_read32(rsdt + 4) + 0
    pm_serial_اطبع("[PM] RSDT طول: ")
    pm_serial_رقم(الطول)
    pm_serial_اطبع("\n")
    
    # عدد المداخل (كل مدخل 4 بايت، بعد الترويسة 36 بايت)
    متغير عدد_المداخل = (الطول - 36) / 4
    pm_serial_اطبع("[PM] عدد جداول ACPI: ")
    pm_serial_رقم(عدد_المداخل)
    pm_serial_اطبع("\n")
    
    # تحليل كل مدخل
    متغير ط = 0
    بينما (ط < عدد_المداخل)
        متغير عنوان_جدول = sad_ll_mem_read32(rsdt + 36 + ط * 4) + 0
        متغير توقيع = sad_ll_mem_read32(عنوان_جدول) + 0
        
        إذا (توقيع == SIG_FACP)
            عنوان_fadt = عنوان_جدول + 0
            pm_serial_اطبع("[PM]   FADT: ")
            pm_serial_hex(عنوان_جدول)
            pm_serial_اطبع("\n")
        نهاية
        
        إذا (توقيع == SIG_APIC)
            عنوان_madt = عنوان_جدول + 0
            pm_serial_اطبع("[PM]   MADT: ")
            pm_serial_hex(عنوان_جدول)
            pm_serial_اطبع("\n")
        نهاية
        
        إذا (توقيع == SIG_HPET)
            عنوان_hpet = عنوان_جدول + 0
            pm_serial_اطبع("[PM]   HPET: ")
            pm_serial_hex(عنوان_جدول)
            pm_serial_اطبع("\n")
        نهاية
        
        إذا (توقيع == SIG_MCFG)
            عنوان_mcfg = عنوان_جدول + 0
            pm_serial_اطبع("[PM]   MCFG: ")
            pm_serial_hex(عنوان_جدول)
            pm_serial_اطبع("\n")
        نهاية
        
        ط = ط + 1
    نهاية
    
    ارجع عدد_المداخل
نهاية

## تحليل FADT (Fixed ACPI Description Table)
دالة acpi_حلل_fadt(fadt)
    إذا (fadt == 0)
        pm_serial_اطبع("[PM] FADT غير موجود!\n")
        ارجع 0
    نهاية
    
    # DSDT عنوان (offset 40)
    عنوان_dsdt = sad_ll_mem_read32(fadt + 40) + 0
    
    # SMI Command Port (offset 48)
    smi_cmd_port = sad_ll_mem_read32(fadt + 48) + 0
    
    # ACPI Enable/Disable Commands (offset 52, 53)
    acpi_enable_cmd = sad_ll_mem_read8(fadt + 52) + 0
    acpi_disable_cmd = sad_ll_mem_read8(fadt + 53) + 0
    
    # SCI Interrupt (offset 46)
    sci_int = sad_ll_mem_read16(fadt + 46) + 0
    
    # PM1a Event Block (offset 56)
    pm1a_evt_blk = sad_ll_mem_read32(fadt + 56) + 0
    
    # PM1a Control Block (offset 64)
    pm1a_cnt_blk = sad_ll_mem_read32(fadt + 64) + 0
    
    # PM1b Control Block (offset 68)
    pm1b_cnt_blk = sad_ll_mem_read32(fadt + 68) + 0
    
    # PM Timer Block (offset 76)
    pm_tmr_blk = sad_ll_mem_read32(fadt + 76) + 0
    
    # PM Timer Length (offset 89)
    pm_tmr_len = sad_ll_mem_read8(fadt + 89) + 0
    
    # Century Register (offset 108)
    century_reg = sad_ll_mem_read8(fadt + 108) + 0
    
    pm_serial_اطبع("[PM] FADT تحليل:\n")
    pm_serial_اطبع("[PM]   DSDT: ")
    pm_serial_hex(عنوان_dsdt)
    pm_serial_اطبع("\n")
    pm_serial_اطبع("[PM]   PM1a_CNT: ")
    pm_serial_hex(pm1a_cnt_blk)
    pm_serial_اطبع("\n")
    pm_serial_اطبع("[PM]   PM_TMR: ")
    pm_serial_hex(pm_tmr_blk)
    pm_serial_اطبع("\n")
    pm_serial_اطبع("[PM]   SCI IRQ: ")
    pm_serial_رقم(sci_int)
    pm_serial_اطبع("\n")
    pm_serial_اطبع("[PM]   SMI CMD: ")
    pm_serial_hex(smi_cmd_port)
    pm_serial_اطبع("\n")
    
    ارجع 1
نهاية

## تحليل MADT (Multiple APIC Description Table)
دالة acpi_حلل_madt(madt)
    إذا (madt == 0)
        pm_serial_اطبع("[PM] MADT غير موجود\n")
        ارجع 0
    نهاية
    
    متغير الطول = sad_ll_mem_read32(madt + 4) + 0
    
    # Local APIC Address (offset 36)
    متغير lapic_addr = sad_ll_mem_read32(madt + 36) + 0
    pm_serial_اطبع("[PM] MADT: LAPIC عند ")
    pm_serial_hex(lapic_addr)
    pm_serial_اطبع("\n")
    
    # Flags (offset 40)
    متغير أعلام = sad_ll_mem_read32(madt + 40) + 0
    
    # تحليل مداخل MADT (بعد offset 44)
    متغير عدد_معالجات = 0
    متغير عدد_io_apic = 0
    متغير موقع = 44
    
    بينما (موقع < الطول)
        متغير نوع_المدخل = sad_ll_mem_read8(madt + موقع) + 0
        متغير طول_المدخل = sad_ll_mem_read8(madt + موقع + 1) + 0
        
        إذا (طول_المدخل == 0)
            # تجنب حلقة لا نهائية
            موقع = الطول + 0
        نهاية
        
        # نوع 0 = Local APIC (معالج)
        إذا (نوع_المدخل == 0)
            متغير proc_id = sad_ll_mem_read8(madt + موقع + 2) + 0
            متغير apic_id = sad_ll_mem_read8(madt + موقع + 3) + 0
            متغير أعلام_م = sad_ll_mem_read32(madt + موقع + 4) + 0
            
            إذا ((أعلام_م % 2) == 1)  # بت 0 = مفعّل
                عدد_معالجات = عدد_معالجات + 1
                pm_serial_اطبع("[PM]   CPU #")
                pm_serial_رقم(apic_id)
                pm_serial_اطبع(" (مفعّل)\n")
            نهاية
        نهاية
        
        # نوع 1 = I/O APIC
        إذا (نوع_المدخل == 1)
            متغير ioapic_id = sad_ll_mem_read8(madt + موقع + 2) + 0
            متغير ioapic_addr = sad_ll_mem_read32(madt + موقع + 4) + 0
            متغير gsi_base = sad_ll_mem_read32(madt + موقع + 8) + 0
            عدد_io_apic = عدد_io_apic + 1
            pm_serial_اطبع("[PM]   I/O APIC #")
            pm_serial_رقم(ioapic_id)
            pm_serial_اطبع(" عند ")
            pm_serial_hex(ioapic_addr)
            pm_serial_اطبع("\n")
        نهاية
        
        # نوع 2 = Interrupt Source Override
        إذا (نوع_المدخل == 2)
            متغير مصدر_irq = sad_ll_mem_read8(madt + موقع + 3) + 0
            متغير gsi = sad_ll_mem_read32(madt + موقع + 4) + 0
            pm_serial_اطبع("[PM]   IRQ Override: ")
            pm_serial_رقم(مصدر_irq)
            pm_serial_اطبع(" → GSI ")
            pm_serial_رقم(gsi)
            pm_serial_اطبع("\n")
        نهاية
        
        إذا (طول_المدخل > 0)
            موقع = موقع + طول_المدخل
        وإلا
            موقع = الطول + 0
        نهاية
    نهاية
    
    pm_serial_اطبع("[PM] عدد المعالجات: ")
    pm_serial_رقم(عدد_معالجات)
    pm_serial_اطبع("، I/O APIC: ")
    pm_serial_رقم(عدد_io_apic)
    pm_serial_اطبع("\n")
    
    ارجع عدد_معالجات
نهاية

