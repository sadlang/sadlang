#* ===================================================================
   نظام الحصص — Disk Quotas
   BeeOS Quota Module
   ===================================================================
   
   يتحكم في استخدام مساحة القرص لكل مستخدم ومجموعة.
   
   ── أنواع الحصص ──
   - حصة المستخدم: حد أقصى لكل مستخدم
   - حصة المجموعة: حد أقصى لكل مجموعة
   
   ── الحدود ──
   - حد ناعم (soft): تحذير عند التجاوز
   - حد صارم (hard): رفض الكتابة عند التجاوز
   
   ── المقاييس ──
   - مساحة: بالكيلوبايت
   - ملفات: عدد الملفات (inodes)
   
   الترخيص: BeeOS Kernel Module
   الإصدار: 1.0
   ================================================================== *#

# ──────────────────────────────────────────────
# الدوال الخارجية
# ──────────────────────────────────────────────
خارجي دالة kernel_print_string(عنوان)
خارجي دالة kernel_print_number(قيمة)

# ──────────────────────────────────────────────
# الثوابت
# ──────────────────────────────────────────────
ثابت اقصى_حصص = 16
ثابت حصة_مستخدم = 1
ثابت حصة_مجموعة = 2

# ══════════════════════════════════════════════
# القسم 1: جدول الحصص
# ══════════════════════════════════════════════

#* ── كل حصة ──
   ص_ق_حصة: 0=حرة، 1=مستخدم، 2=مجموعة
   معرف_حصة: UID أو GID
   حد_ناعم_مساحة: الحد الناعم (كيلوبايت)
   حد_صارم_مساحة: الحد الصارم (كيلوبايت)
   مستخدم_مساحة: المساحة المستخدمة حالياً
   حد_ناعم_ملفات: حد عدد الملفات الناعم
   حد_صارم_ملفات: حد عدد الملفات الصارم
   مستخدم_ملفات: عدد الملفات المستخدمة
*#

متغير حصة_ص_ق_0 = 0
متغير حصة_معرف_0 = 0
متغير حصة_ناعم_م_0 = 0
متغير حصة_صارم_م_0 = 0
متغير حصة_مستخدم_م_0 = 0
متغير حصة_ناعم_ف_0 = 0
متغير حصة_صارم_ف_0 = 0
متغير حصة_مستخدم_ف_0 = 0

متغير حصة_ص_ق_1 = 0
متغير حصة_معرف_1 = 0
متغير حصة_ناعم_م_1 = 0
متغير حصة_صارم_م_1 = 0
متغير حصة_مستخدم_م_1 = 0
متغير حصة_ناعم_ف_1 = 0
متغير حصة_صارم_ف_1 = 0
متغير حصة_مستخدم_ف_1 = 0

متغير حصة_ص_ق_2 = 0
متغير حصة_معرف_2 = 0
متغير حصة_ناعم_م_2 = 0
متغير حصة_صارم_م_2 = 0
متغير حصة_مستخدم_م_2 = 0
متغير حصة_ناعم_ف_2 = 0
متغير حصة_صارم_ف_2 = 0
متغير حصة_مستخدم_ف_2 = 0

متغير حصة_ص_ق_3 = 0
متغير حصة_معرف_3 = 0
متغير حصة_ناعم_م_3 = 0
متغير حصة_صارم_م_3 = 0
متغير حصة_مستخدم_م_3 = 0
متغير حصة_ناعم_ف_3 = 0
متغير حصة_صارم_ف_3 = 0
متغير حصة_مستخدم_ف_3 = 0

متغير عدد_حصص = 0

# ══════════════════════════════════════════════
# القسم 2: إدارة الحصص
# ══════════════════════════════════════════════

#* ── تعيين حصة ── *#
صدّر دالة حصص_عيّن(ص_ق، معرف، ناعم_مساحة، صارم_مساحة، ناعم_ملفات، صارم_ملفات)
    إذا (عدد_حصص >= 4)
        kernel_print_string("  [quota] ERROR: quota table full")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    متغير ف = عدد_حصص + 0
    إذا (ف == 0)
        حصة_ص_ق_0 = ص_ق
        حصة_معرف_0 = معرف
        حصة_ناعم_م_0 = ناعم_مساحة
        حصة_صارم_م_0 = صارم_مساحة
        حصة_مستخدم_م_0 = 0
        حصة_ناعم_ف_0 = ناعم_ملفات
        حصة_صارم_ف_0 = صارم_ملفات
        حصة_مستخدم_ف_0 = 0
    نهاية
    إذا (ف == 1)
        حصة_ص_ق_1 = ص_ق
        حصة_معرف_1 = معرف
        حصة_ناعم_م_1 = ناعم_مساحة
        حصة_صارم_م_1 = صارم_مساحة
        حصة_مستخدم_م_1 = 0
        حصة_ناعم_ف_1 = ناعم_ملفات
        حصة_صارم_ف_1 = صارم_ملفات
        حصة_مستخدم_ف_1 = 0
    نهاية
    إذا (ف == 2)
        حصة_ص_ق_2 = ص_ق
        حصة_معرف_2 = معرف
        حصة_ناعم_م_2 = ناعم_مساحة
        حصة_صارم_م_2 = صارم_مساحة
        حصة_مستخدم_م_2 = 0
        حصة_ناعم_ف_2 = ناعم_ملفات
        حصة_صارم_ف_2 = صارم_ملفات
        حصة_مستخدم_ف_2 = 0
    نهاية
    إذا (ف == 3)
        حصة_ص_ق_3 = ص_ق
        حصة_معرف_3 = معرف
        حصة_ناعم_م_3 = ناعم_مساحة
        حصة_صارم_م_3 = صارم_مساحة
        حصة_مستخدم_م_3 = 0
        حصة_ناعم_ف_3 = ناعم_ملفات
        حصة_صارم_ف_3 = صارم_ملفات
        حصة_مستخدم_ف_3 = 0
    نهاية
    
    عدد_حصص = عدد_حصص + 1
    
    kernel_print_string("    quota: set for ")
    إذا (ص_ق == حصة_مستخدم)
        kernel_print_string("user")
    وإلا
        kernel_print_string("group")
    نهاية
    kernel_print_string(" #")
    kernel_print_number(معرف)
    kernel_print_string(" soft=")
    kernel_print_number(ناعم_مساحة)
    kernel_print_string("KB hard=")
    kernel_print_number(صارم_مساحة)
    kernel_print_string("KB")
    kernel_print_number(10)
    
    ارجع ف
نهاية

#* ── فحص الحصة قبل الكتابة ──
   ترجع 1=مسموح، 0=تحذير (ناعم)، -1=مرفوض (صارم)
*#
صدّر دالة حصص_فحص_مساحة(ص_ق، معرف، مساحة_إضافية)
    متغير ع = 0
    بينما (ع < عدد_حصص)
        متغير ص_ق_ح = 0
        متغير معرف_ح = 0
        متغير مستخدم_ح = 0
        متغير ناعم_ح = 0
        متغير صارم_ح = 0
        
        إذا (ع == 0)
            ص_ق_ح = حصة_ص_ق_0
            معرف_ح = حصة_معرف_0
            مستخدم_ح = حصة_مستخدم_م_0
            ناعم_ح = حصة_ناعم_م_0
            صارم_ح = حصة_صارم_م_0
        نهاية
        إذا (ع == 1)
            ص_ق_ح = حصة_ص_ق_1
            معرف_ح = حصة_معرف_1
            مستخدم_ح = حصة_مستخدم_م_1
            ناعم_ح = حصة_ناعم_م_1
            صارم_ح = حصة_صارم_م_1
        نهاية
        إذا (ع == 2)
            ص_ق_ح = حصة_ص_ق_2
            معرف_ح = حصة_معرف_2
            مستخدم_ح = حصة_مستخدم_م_2
            ناعم_ح = حصة_ناعم_م_2
            صارم_ح = حصة_صارم_م_2
        نهاية
        إذا (ع == 3)
            ص_ق_ح = حصة_ص_ق_3
            معرف_ح = حصة_معرف_3
            مستخدم_ح = حصة_مستخدم_م_3
            ناعم_ح = حصة_ناعم_م_3
            صارم_ح = حصة_صارم_م_3
        نهاية
        
        إذا (ص_ق_ح == ص_ق)
            إذا (معرف_ح == معرف)
                متغير إجمالي = مستخدم_ح + مساحة_إضافية
                إذا (إجمالي > صارم_ح)
                    kernel_print_string("  [quota] DENIED: hard limit exceeded")
                    kernel_print_number(10)
                    ارجع -1
                نهاية
                إذا (إجمالي > ناعم_ح)
                    kernel_print_string("  [quota] WARNING: soft limit exceeded")
                    kernel_print_number(10)
                    ارجع 0
                نهاية
                ارجع 1
            نهاية
        نهاية
        
        ع = ع + 1
    نهاية
    
    # لا حصة محددة = مسموح
    ارجع 1
نهاية

# ══════════════════════════════════════════════
# القسم 3: تقارير
# ══════════════════════════════════════════════

صدّر دالة حصص_تقرير()
    kernel_print_string("=== Quota Report ===")
    kernel_print_number(10)
    kernel_print_string("  Quotas defined: ")
    kernel_print_number(عدد_حصص)
    kernel_print_number(10)
    kernel_print_string("=== End Quota ===")
    kernel_print_number(10)
    ارجع 0
نهاية

