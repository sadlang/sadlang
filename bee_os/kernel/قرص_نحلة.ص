## تهيئة DMA
صدّر دالة هيئ_DMA()
    # تخصيص صفحة لجدول PRDT
    عنوان_PRDT = خصص_صفحة_ذاكرة()
    إذا (عنوان_PRDT == 0)
        ارجع -1
    نهاية
    املأ_ذاكرة(عنوان_PRDT، 0، 4096)
    
    # تخصيص صفحة لمخزن DMA
    عنوان_DMA_مخزن = خصص_صفحة_ذاكرة()
    إذا (عنوان_DMA_مخزن == 0)
