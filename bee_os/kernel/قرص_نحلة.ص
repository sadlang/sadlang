## ═══════════════════════════════════════════════════════════════
## لسان القرص — BeeDisk — مشغّل أقراص ATA/AHCI لنظام النحلة
## ═══════════════════════════════════════════════════════════════
##
## مشغل شامل لأقراص التخزين:
##   • ATA PIO (للتوافق مع أبسط العتاد)
##   • LBA28 و LBA48 (دعم أقراص حتى 128PB)
##   • DMA (لنقل كتل كبيرة بدون إشغال المعالج)
##   • AHCI (لأقراص SATA الحديثة)
##   • اكتشاف الأجهزة تلقائياً
##   • معالجة الأخطاء وإعادة المحاولة
##
## يعتمد على: مقاطعات_نحلة، تسلسلي_نحلة، ذاكرة_نحلة
## ═══════════════════════════════════════════════════════════════

## ─────────────────────────────────────────────────────
## واجهات FFI — العمليات الخارجية
## ─────────────────────────────────────────────────────

# قراءة/كتابة منافذ الأجهزة
خارجي("sad_ll_port_inb") دالة اقرأ_منفذ_بايت(منفذ)
خارجي("sad_ll_port_outb") دالة اكتب_منفذ_بايت(منفذ، قيمة)
خارجي("sad_ll_port_inw") دالة اقرأ_منفذ_كلمة(منفذ)
خارجي("sad_ll_port_outw") دالة اكتب_منفذ_كلمة(منفذ، قيمة)
خارجي("sad_ll_port_inl") دالة اقرأ_منفذ_طويل(منفذ)
خارجي("sad_ll_port_outl") دالة اكتب_منفذ_طويل(منفذ، قيمة)

# قراءة/كتابة الذاكرة
خارجي("sad_ll_mem_read64") دالة اقرأ_ذاكرة(عنوان_الذاكرة)
خارجي("sad_ll_mem_write64") دالة اكتب_ذاكرة(عنوان_الذاكرة، قيمة)
خارجي("sad_ll_mem_read32") دالة اقرأ_ذاكرة32(عنوان_الذاكرة)
خارجي("sad_ll_mem_write32") دالة اكتب_ذاكرة32(عنوان_الذاكرة، قيمة)
خارجي("sad_ll_mem_read16") دالة اقرأ_ذاكرة16(عنوان_الذاكرة)
خارجي("sad_ll_mem_write16") دالة اكتب_ذاكرة16(عنوان_الذاكرة، قيمة)

# عمليات الذاكرة
خارجي("sad_ll_memset") دالة املأ_ذاكرة(عنوان_الذاكرة، قيمة، طول)
خارجي("sad_ll_memcpy") دالة انسخ_ذاكرة(وجهة، مصدر، طول)

# منفذ التسلسلي
خارجي("sad_ll_serial_write_char") دالة اكتب_حرف_تسلسلي(منفذ، حرف)

# المقاطعات
خارجي("sad_ll_interrupt_disable") دالة عطّل_المقاطعات()
خارجي("sad_ll_interrupt_enable") دالة فعّل_المقاطعات()

# تخصيص الذاكرة
خارجي("sad_ll_page_alloc") دالة خصص_صفحة_ذاكرة()
خارجي("sad_ll_page_free") دالة حرر_صفحة_ذاكرة(عنوان_الصفحة)
خارجي("sad_ll_pages_alloc") دالة خصص_صفحات_ذاكرة(عدد_الصفحات)
خارجي("sad_ll_pages_free") دالة حرر_صفحات_ذاكرة(عنوان_الصفحات، عدد_الصفحات)

## ─────────────────────────────────────────────────────
## ثوابت المنفذ التسلسلي
## ─────────────────────────────────────────────────────
ثابت COM1 = 1016  # 0x3F8

## ─────────────────────────────────────────────────────
## طباعة رقم عبر السيريال (للتصحيح)
## ─────────────────────────────────────────────────────
دالة serial_اطبع_رقم(القيمة)
    إذا (القيمة < 0)
        اكتب_حرف_تسلسلي(COM1، 45)  # '-'
        serial_اطبع_رقم(0 - القيمة)
        ارجع
    نهاية
    إذا (القيمة >= 10)
        serial_اطبع_رقم(القيمة / 10)
    نهاية
    اكتب_حرف_تسلسلي(COM1، 48 + (القيمة % 10))
نهاية

## طباعة سلسلة حروف عبر السيريال
دالة serial_اطبع(نوع_الرسالة)
    # نطبع الرقم كمعرف (1=معلومات، 2=تحذير، 3=خطأ)
    اكتب_حرف_تسلسلي(COM1، 91)  # '['
    serial_اطبع_رقم(نوع_الرسالة)
    اكتب_حرف_تسلسلي(COM1، 93)  # ']'
    اكتب_حرف_تسلسلي(COM1، 32)  # ' '
نهاية

