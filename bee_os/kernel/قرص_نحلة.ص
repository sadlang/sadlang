        محاولات = محاولات + 1
    نهاية
    
    # 8. إيقاف DMA
    اكتب_منفذ_بايت(dma_منفذ + DMA_CMD، 0)
    
    # 9. مسح حالة DMA
    اكتب_منفذ_بايت(dma_منفذ + DMA_STAT، 6)
    
    إذا (اكتمل == 0)
