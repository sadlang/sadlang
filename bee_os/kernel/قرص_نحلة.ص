    إذا (فهرس_القرص < 0)
        ارجع -1
    نهاية
    إذا (فهرس_القرص >= أقصى_أقراص)
        ارجع -1
    نهاية
    إذا (قرص_نوع[فهرس_القرص] != 1)
        ارجع -1
    نهاية
    
    متغير منفذ_البيانات = قرص_منفذ_بيانات[فهرس_القرص]
    متغير منفذ_الأوامر = منفذ_أوامر_قرص(فهرس_القرص)
    متغير منفذ_التحكم = منفذ_تحكم_قرص(فهرس_القرص)
    
    # تعطيل المقاطعات أثناء العملية
    عطّل_المقاطعات()
    
    # انتظر حتى يكون القرص غير مشغول
    إذا (انتظر_غير_مشغول(منفذ_الأوامر) != 0)
        فعّل_المقاطعات()
        ارجع -1
    نهاية
    
    # اختيار القرص + بتات LBA العليا
    # القيمة = 0xE0 | (slave << 4) | (lba >> 24 & 0x0F)
    متغير drive_byte = قرص_اختيار[فهرس_القرص]
    # إضافة بت LBA (بت 6) → 0x40
    drive_byte = drive_byte + 64
    # إضافة بتات LBA العليا (بتات 24-27)
    متغير lba_أعلى = (رقم_LBA / 16777216) % 16
    drive_byte = drive_byte + lba_أعلى
    اكتب_منفذ_بايت(منفذ_البيانات + 6، drive_byte)
    
    # كتابة عدد القطاعات (1)
    اكتب_منفذ_بايت(منفذ_البيانات + 2، 1)
    
    # كتابة عنوان LBA
    اكتب_منفذ_بايت(منفذ_البيانات + 3، رقم_LBA % 256)              # LBA Low
    اكتب_منفذ_بايت(منفذ_البيانات + 4، (رقم_LBA / 256) % 256)     # LBA Mid
    اكتب_منفذ_بايت(منفذ_البيانات + 5، (رقم_LBA / 65536) % 256)   # LBA High
    
    # إرسال أمر القراءة PIO
    اكتب_منفذ_بايت(منفذ_الأوامر، ATA_CMD_READ_PIO)
    
