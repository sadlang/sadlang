    متغير نتيجة_DRQ = انتظر_طلب_بيانات(منفذ_الأوامر)
    إذا (نتيجة_DRQ != 0)
        أخطاء_القراءة = أخطاء_القراءة + 1
        فعّل_المقاطعات()
        ارجع -1
    نهاية
    
    # قراءة 256 كلمة (16 بت) = 512 بايت
    متغير ك = 0
    بينما (ك < 256)
        متغير قيمة_الكلمة = اقرأ_منفذ_كلمة(منفذ_البيانات)
        # تفريغ الكلمة إلى بايتين في الذاكرة
        # البايت المنخفض أولاً (little-endian)
        اكتب_ذاكرة16(عنوان_المخزن + (ك * 2)، قيمة_الكلمة)
