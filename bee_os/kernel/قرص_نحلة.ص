## إعداد مدخلة PRDT لنقل إلى/من عنوان فيزيائي
دالة أعدّ_PRDT(عنوان_فيزيائي، عدد_البايتات)
    إذا (عنوان_PRDT == 0)
        ارجع -1
    نهاية
    
    # كتابة العنوان الفيزيائي (32 بت)
    اكتب_ذاكرة32(عنوان_PRDT، عنوان_فيزيائي)
    
    # كتابة عدد البايتات (16 بت) + بت النهاية (بت 15 من الكلمة العليا)
    # عدد 0 = 65536 بايت
    متغير عدد_مع_نهاية = عدد_البايتات + 0
    إذا (عدد_مع_نهاية == 65536)
        عدد_مع_نهاية = 0
    نهاية
    # بت آخر مدخلة (بت 15 من الكلمة 6-7) = 0x8000 = 32768
    اكتب_ذاكرة32(عنوان_PRDT + 4، عدد_مع_نهاية + 2147483648)
    
    ارجع 0
