## ═══════════════════════════════════════════════════════════════
## القسم ٤: انتظار حالة القرص
## ═══════════════════════════════════════════════════════════════

## انتظر حتى يكون القرص غير مشغول
## يُعيد: 0=نجاح، -1=مهلة
دالة انتظر_غير_مشغول(منفذ_الأوامر)
    متغير محاولات = 0
    بينما (محاولات < 100000)
        متغير حالة_القرص = اقرأ_منفذ_بايت(منفذ_الأوامر)
        # BSY = بت 7
        إذا ((حالة_القرص / 128) % 2 == 0)
            ارجع 0
        نهاية
        محاولات = محاولات + 1
    نهاية
    ارجع -1
نهاية

## انتظر حتى يطلب القرص بيانات (DRQ=1) أو خطأ
## يُعيد: 0=DRQ جاهز، -1=خطأ، -2=مهلة
دالة انتظر_طلب_بيانات(منفذ_الأوامر)
    متغير محاولات = 0
    بينما (محاولات < 100000)
        متغير حالة_القرص = اقرأ_منفذ_بايت(منفذ_الأوامر)
        # فحص خطأ (ERR = بت 0) أو خطأ جهاز (DF = بت 5)
        إذا (حالة_القرص % 2 == 1)
            ارجع -1
        نهاية
        إذا ((حالة_القرص / 32) % 2 == 1)
            ارجع -1
        نهاية
        # فحص DRQ (بت 3) وغير مشغول (BSY = بت 7)
        إذا ((حالة_القرص / 128) % 2 == 0)
            إذا ((حالة_القرص / 8) % 2 == 1)
                ارجع 0
            نهاية
        نهاية
        محاولات = محاولات + 1
    نهاية
    ارجع -2
نهاية

## انتظر حتى يكون القرص جاهزاً (DRDY=1، BSY=0)
## يُعيد: 0=جاهز، -1=مهلة
دالة انتظر_جاهز(منفذ_الأوامر)
    متغير محاولات = 0
    بينما (محاولات < 100000)
        متغير حالة_القرص = اقرأ_منفذ_بايت(منفذ_الأوامر)
        # BSY=0 (بت 7) و DRDY=1 (بت 6)
        إذا ((حالة_القرص / 128) % 2 == 0)
            إذا ((حالة_القرص / 64) % 2 == 1)
                ارجع 0
            نهاية
        نهاية
        محاولات = محاولات + 1
    نهاية
    ارجع -1
نهاية

## فحص وقراءة معلومات الخطأ
## يُعيد: رمز الخطأ أو 0 إذا لا خطأ
دالة اقرأ_خطأ_ATA(فهرس_القرص)
    متغير منفذ_الأوامر = منفذ_أوامر_قرص(فهرس_القرص)
    متغير حالة_القرص = اقرأ_منفذ_بايت(منفذ_الأوامر)
    إذا (حالة_القرص % 2 == 1)
        متغير منفذ_الخطأ = منفذ_خطأ_قرص(فهرس_القرص)
        ارجع اقرأ_منفذ_بايت(منفذ_الخطأ)
    نهاية
    ارجع 0
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٥: إعادة تعيين ناقل ATA
## ═══════════════════════════════════════════════════════════════

## إعادة تعيين ناقل ATA (software reset)
## هذا يؤثر على كلا الجهازين (master و slave) على نفس الناقل
صدّر دالة إعادة_تعيين_ATA(رقم_الناقل)
    متغير منفذ_التحكم = ATA_PRIM_CTRL
    إذا (رقم_الناقل == 1)
        منفذ_التحكم = ATA_SEC_CTRL
    نهاية
    
    # ارسل بت SRST (بت 2) = 1
    اكتب_منفذ_بايت(منفذ_التحكم، 4)
    
    # تأخير
    تأخير_ATA(منفذ_التحكم)
    تأخير_ATA(منفذ_التحكم)
    
    # أزل بت SRST
    اكتب_منفذ_بايت(منفذ_التحكم، 0)
    
    # انتظر حتى ينتهي الريسيت
    تأخير_ATA(منفذ_التحكم)
    تأخير_ATA(منفذ_التحكم)
    
    # انتظر حتى يكون الجهاز جاهزاً
    متغير منفذ_الأوامر = ATA_PRIM_CMD
    إذا (رقم_الناقل == 1)
        منفذ_الأوامر = ATA_SEC_CMD
    نهاية
    
    انتظر_غير_مشغول(منفذ_الأوامر)
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٦: اكتشاف الأقراص (IDENTIFY)
## ═══════════════════════════════════════════════════════════════

## اختيار القرص على الناقل
دالة اختر_قرص(فهرس_القرص)
    متغير منفذ_القرص = قرص_منفذ_بيانات[فهرس_القرص]
    متغير قيمة_الاختيار = قرص_اختيار[فهرس_القرص]
    
    # كتابة قيمة الاختيار في سجل DRIVE
    اكتب_منفذ_بايت(منفذ_القرص + 6، قيمة_الاختيار)
    
    # تأخير 400ns (4 قراءات من سجل الحالة البديل)
    متغير منفذ_التحكم = منفذ_تحكم_قرص(فهرس_القرص)
    تأخير_ATA(منفذ_التحكم)
نهاية

## التعرف على قرص واحد (ATA IDENTIFY)
## يُعيد: 1=نجاح (القرص موجود)، 0=القرص غير موجود
دالة تعرّف_على_قرص(فهرس_القرص)
    متغير منفذ_البيانات = قرص_منفذ_بيانات[فهرس_القرص]
    متغير منفذ_الأوامر = منفذ_أوامر_قرص(فهرس_القرص)
    متغير منفذ_التحكم = منفذ_تحكم_قرص(فهرس_القرص)
    
    # اختيار القرص
    اختر_قرص(فهرس_القرص)
    
    # مسح سجلات LBA و عدد القطاعات
    اكتب_منفذ_بايت(منفذ_البيانات + 2، 0)  # عدد القطاعات
    اكتب_منفذ_بايت(منفذ_البيانات + 3، 0)  # LBA Low
    اكتب_منفذ_بايت(منفذ_البيانات + 4، 0)  # LBA Mid
    اكتب_منفذ_بايت(منفذ_البيانات + 5، 0)  # LBA High
    
    # إرسال أمر IDENTIFY
    اكتب_منفذ_بايت(منفذ_الأوامر، ATA_CMD_IDENTIFY)
    
    # قراءة الحالة
    تأخير_ATA(منفذ_التحكم)
    متغير حالة_القرص = اقرأ_منفذ_بايت(منفذ_الأوامر)
    
    # إذا الحالة = 0، القرص غير موجود
    إذا (حالة_القرص == 0)
        قرص_نوع[فهرس_القرص] = 0
        ارجع 0
    نهاية
    
    # انتظر حتى ينتهي BSY
    متغير نتيجة_الانتظار = انتظر_غير_مشغول(منفذ_الأوامر)
    إذا (نتيجة_الانتظار != 0)
        قرص_نوع[فهرس_القرص] = 0
        ارجع 0
    نهاية
    
    # فحص LBA Mid و LBA High — إذا غير صفر فهو ATAPI وليس ATA
    متغير lba_mid = اقرأ_منفذ_بايت(منفذ_البيانات + 4)
    متغير lba_hi = اقرأ_منفذ_بايت(منفذ_البيانات + 5)
    
    إذا (lba_mid != 0)
        # يمكن أن يكون ATAPI
        إذا (lba_mid == 20)   # 0x14
            إذا (lba_hi == 235) # 0xEB
                قرص_نوع[فهرس_القرص] = 2  # ATAPI
                ارجع 0  # لا ندعم ATAPI حالياً
            نهاية
        نهاية
