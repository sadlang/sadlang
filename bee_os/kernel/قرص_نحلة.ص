## قراءة قطاع بـ DMA
## يُعيد: 0=نجاح، -1=خطأ
صدّر دالة اقرأ_قطاع_DMA(فهرس_القرص، رقم_LBA، عنوان_الهدف)
    إذا (dma_منفذ_أساسي == 0)
        # DMA غير مهيأ — استخدم PIO كبديل
        ارجع اقرأ_قطاع_PIO(فهرس_القرص، رقم_LBA، عنوان_الهدف)
    نهاية
    
    إذا (قرص_نوع[فهرس_القرص] != 1)
        ارجع -1
    نهاية
    
    متغير منفذ_البيانات = قرص_منفذ_بيانات[فهرس_القرص]
    متغير منفذ_الأوامر = منفذ_أوامر_قرص(فهرس_القرص)
    متغير منفذ_التحكم = منفذ_تحكم_قرص(فهرس_القرص)
    
    # تحديد منفذ DMA (ناقل أساسي أو ثانوي)
    متغير dma_منفذ = dma_منفذ_أساسي
    إذا (فهرس_القرص >= 2)
        dma_منفذ = dma_منفذ_أساسي + 8
    نهاية
    
    عطّل_المقاطعات()
    
    # 1. إعداد PRDT
    أعدّ_PRDT(عنوان_DMA_مخزن، 512)
    
    # 2. تحميل عنوان PRDT في سجل DMA
    اكتب_منفذ_طويل(dma_منفذ + DMA_PRDT، عنوان_PRDT)
    
    # 3. مسح بتات الحالة (كتابة 1 لمسح)
    اكتب_منفذ_بايت(dma_منفذ + DMA_STAT، 6)  # مسح Error + Interrupt
    
    # 4. ضبط اتجاه DMA → قراءة (بت 3 = 1)
    اكتب_منفذ_بايت(dma_منفذ + DMA_CMD، 8)
    
    # 5. إعداد أمر ATA
    إذا (انتظر_غير_مشغول(منفذ_الأوامر) != 0)
        فعّل_المقاطعات()
        ارجع -1
    نهاية
    
    متغير drive_byte = قرص_اختيار[فهرس_القرص] + 64
    drive_byte = drive_byte + ((رقم_LBA / 16777216) % 16)
    اكتب_منفذ_بايت(منفذ_البيانات + 6، drive_byte)
    
    اكتب_منفذ_بايت(منفذ_البيانات + 2، 1)
    اكتب_منفذ_بايت(منفذ_البيانات + 3، رقم_LBA % 256)
    اكتب_منفذ_بايت(منفذ_البيانات + 4، (رقم_LBA / 256) % 256)
    اكتب_منفذ_بايت(منفذ_البيانات + 5، (رقم_LBA / 65536) % 256)
    
    # إرسال أمر DMA READ
    اكتب_منفذ_بايت(منفذ_الأوامر، ATA_CMD_READ_DMA)
    
    # 6. بدء نقل DMA (بت 0 = Start)
    اكتب_منفذ_بايت(dma_منفذ + DMA_CMD، 9)  # 8 + 1 = قراءة + بدء
    
    # 7. انتظر اكتمال DMA (حلقة فحص بت Interrupt)
    متغير محاولات = 0
    متغير اكتمل = 0
    بينما (محاولات < 500000)
        متغير حالة_dma = اقرأ_منفذ_بايت(dma_منفذ + DMA_STAT)
        # بت 1 = خطأ
        إذا ((حالة_dma / 2) % 2 == 1)
