#* تحليل جدول أقسام MBR لمحرك
   يقرأ القطاع 0 ويحلل 4 مدخلات أقسام
   المعاملات: رقم_محرك
   ترجع: عدد الأقسام المكتشفة *#
صدّر دالة أقسام_حلل_mbr(رقم_محرك)
    عداد_فحص = عداد_فحص + 1
    
    kernel_print_string("  [part] Scanning MBR on drive ")
    kernel_print_number(رقم_محرك)
    kernel_print_number(10)
    
    # تعيين صنف جدول المحرك
    إذا (رقم_محرك == 0)
        محرك_صنف_0 = صنف_جدول_mbr
        محرك_وضعية_0 = 1
    نهاية
    إذا (رقم_محرك == 1)
        محرك_صنف_1 = صنف_جدول_mbr
        محرك_وضعية_1 = 1
    نهاية
    إذا (رقم_محرك == 2)
        محرك_صنف_2 = صنف_جدول_mbr
        محرك_وضعية_2 = 1
    نهاية
    إذا (رقم_محرك == 3)
        محرك_صنف_3 = صنف_جدول_mbr
        محرك_وضعية_3 = 1
    نهاية
    
    عداد_محركات_مكتشفة = عداد_محركات_مكتشفة + 1
    
    # تحليل الأقسام الأربعة الأولية (محاكاة)
    متغير أقسام_عثرنا = 0
    
    # القسم الأول: FAT32
    إذا (عدد_أقسام < حد_أقسام)
        اكتب_قسم(عدد_أقسام، 2، قسم_fat32، رقم_محرك، 2048، 1048576)
        عدد_أقسام = عدد_أقسام + 1
        أقسام_عثرنا = أقسام_عثرنا + 1
        
        kernel_print_string("    Part 1: FAT32, start=2048, size=1048576 secs")
        kernel_print_number(10)
    نهاية
    
    # القسم الثاني: ext2
    إذا (عدد_أقسام < حد_أقسام)
        اكتب_قسم(عدد_أقسام، 1، قسم_linux_ext، رقم_محرك، 1050624، 4194304)
        عدد_أقسام = عدد_أقسام + 1
        أقسام_عثرنا = أقسام_عثرنا + 1
        
        kernel_print_string("    Part 2: Linux ext, start=1050624, size=4194304")
        kernel_print_number(10)
    نهاية
    
    # تحديث عدد أقسام المحرك
    إذا (رقم_محرك == 0)
        محرك_أقسام_0 = أقسام_عثرنا + 0
    نهاية
    إذا (رقم_محرك == 1)
        محرك_أقسام_1 = أقسام_عثرنا + 0
    نهاية
    إذا (رقم_محرك == 2)
        محرك_أقسام_2 = أقسام_عثرنا + 0
    نهاية
    إذا (رقم_محرك == 3)
        محرك_أقسام_3 = أقسام_عثرنا + 0
    نهاية
    
    ارجع أقسام_عثرنا
نهاية

#* البحث عن قسم حسب الصنف *#
صدّر دالة أقسام_جد_صنف(صنف_مطلوب)
    متغير خ = 0
    بينما (خ < حد_أقسام)
        متغير وض = اقرأ_قسم_وضعية(خ)
        إذا (وض != 0)
            متغير ص_ق = اقرأ_قسم_صنف(خ)
            إذا (ص_ق == صنف_مطلوب)
                ارجع خ
            نهاية
        نهاية
        خ = خ + 1
    نهاية
    ارجع -1
نهاية

#* البحث عن قسم قابل للإقلاع *#
