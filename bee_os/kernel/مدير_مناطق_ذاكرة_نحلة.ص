# ═══════════════════════════════════════════════════════════════════════════════

# قراءة/كتابة حقل من مصفوفة
دالة قراءة_حقل(عنوان_مصفوفة، فهرس)
    ارجع mem_read_dword(عنوان_مصفوفة + (فهرس * 4))
نهاية

دالة كتابة_حقل(عنوان_مصفوفة، فهرس، قيمة)
    mem_write_dword(عنوان_مصفوفة + (فهرس * 4)، قيمة)
