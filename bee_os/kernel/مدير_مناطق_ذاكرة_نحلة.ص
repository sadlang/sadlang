# ═══════════════════════════════════════════════════════════════════════════════
# دوال الخريطة البتية
# ═══════════════════════════════════════════════════════════════════════════════

# الحصول على عنوان الخريطة البتية لمنطقة
دالة خريطة_منطقة(فهرس_منطقة)
    إذا (فهرس_منطقة == منطقة_DMA)
        ارجع عنوان_خريطة_dma
    نهاية
    إذا (فهرس_منطقة == منطقة_عادية)
        ارجع عنوان_خريطة_عادية
    نهاية
    إذا (فهرس_منطقة == منطقة_عالية)
        ارجع عنوان_خريطة_عالية
    نهاية
    ارجع 0
نهاية

# الحصول على عدد لفظات الخريطة لمنطقة
دالة لفظات_خريطة_منطقة(فهرس_منطقة)
    إذا (فهرس_منطقة == منطقة_DMA)
        ارجع ثابت_لفظات_خريطة_dma
    نهاية
    إذا (فهرس_منطقة == منطقة_عادية)
        ارجع ثابت_لفظات_خريطة_عادية
    نهاية
    إذا (فهرس_منطقة == منطقة_عالية)
        ارجع ثابت_لفظات_خريطة_عالية
    نهاية
    ارجع 0
نهاية

# فحص بت في خريطة بتية
# يُرجع 1 إذا مستخدمة، 0 إذا حرة
دالة فحص_بت(عنوان_خريطة، فهرس_صفحة)
    متغير فهرس_لفظة = فهرس_صفحة / 32
    متغير فهرس_بت = فهرس_صفحة - (فهرس_لفظة * 32)
    متغير لفظة = mem_read_dword(عنوان_خريطة + (فهرس_لفظة * 4))
    متغير قناع = 1 << فهرس_بت
    متغير نتيجة = لفظة & قناع
    إذا (نتيجة != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ضبط بت (تحديد صفحة كمستخدمة)
دالة ضبط_بت(عنوان_خريطة، فهرس_صفحة)
    متغير فهرس_لفظة = فهرس_صفحة / 32
    متغير فهرس_بت = فهرس_صفحة - (فهرس_لفظة * 32)
    متغير لفظة = mem_read_dword(عنوان_خريطة + (فهرس_لفظة * 4))
    متغير قناع = 1 << فهرس_بت
    متغير نتيجة = لفظة | قناع
    mem_write_dword(عنوان_خريطة + (فهرس_لفظة * 4)، نتيجة)
نهاية

# مسح بت (تحديد صفحة كحرة)
دالة مسح_بت(عنوان_خريطة، فهرس_صفحة)
    متغير فهرس_لفظة = فهرس_صفحة / 32
    متغير فهرس_بت = فهرس_صفحة - (فهرس_لفظة * 32)
    متغير لفظة = mem_read_dword(عنوان_خريطة + (فهرس_لفظة * 4))
    متغير قناع = 1 << فهرس_بت
    متغير قناع_عكسي = ~قناع
    متغير نتيجة = لفظة & قناع_عكسي
    mem_write_dword(عنوان_خريطة + (فهرس_لفظة * 4)، نتيجة)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحديد المنطقة لعنوان فيزيائي
# ═══════════════════════════════════════════════════════════════════════════════

# تحديد المنطقة التي ينتمي إليها عنوان فيزيائي
# تُرجع فهرس المنطقة أو -1 إذا خارج النطاق
دالة تحديد_منطقة(عنوان_فيزيائي)
    إذا (عنوان_فيزيائي < ثابت_نهاية_dma)
        ارجع منطقة_DMA
    نهاية
    إذا (عنوان_فيزيائي < ثابت_نهاية_عادية)
        ارجع منطقة_عادية
    نهاية
    إذا (عنوان_فيزيائي < ثابت_نهاية_عالية)
        ارجع منطقة_عالية
    نهاية
    ارجع -1
نهاية

# تحويل عنوان فيزيائي لفهرس صفحة ضمن منطقته
دالة صفحة_في_منطقة(عنوان_فيزيائي، فهرس_منطقة)
    متغير بداية = قراءة_حقل(عنوان_بدايات، فهرس_منطقة)
    ارجع (عنوان_فيزيائي - بداية) / ثابت_مقاس_صفحة
نهاية

# تحويل فهرس صفحة ضمن منطقة لعنوان فيزيائي
دالة عنوان_صفحة_في_منطقة(فهرس_منطقة، فهرس_صفحة)
    متغير بداية = قراءة_حقل(عنوان_بدايات، فهرس_منطقة)
    ارجع بداية + (فهرس_صفحة * ثابت_مقاس_صفحة)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# فحص العلامات المائية
# ═══════════════════════════════════════════════════════════════════════════════

# فحص مستوى الضغط لمنطقة
# تُرجع: 0=طبيعي (فوق high)، 1=منخفض (بين low وhigh)
#         2=متوسط (بين min وlow)، 3=حرج (تحت min)
دالة فحص_ضغط_منطقة(فهرس_منطقة)
    متغير حرة = قراءة_حقل(عنوان_صفحات_حرة، فهرس_منطقة)
    متغير علامة_د = قراءة_حقل(عنوان_علامة_دنيا، فهرس_منطقة)
    متغير علامة_م = قراءة_حقل(عنوان_علامة_منخفضة، فهرس_منطقة)
    متغير علامة_ع = قراءة_حقل(عنوان_علامة_عليا، فهرس_منطقة)

    إذا (حرة < علامة_د)
        ارجع 3
    نهاية
    إذا (حرة < علامة_م)
        ارجع 2
    نهاية
    إذا (حرة < علامة_ع)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# فحص هل يمكن التخصيص من منطقة (مع مراعاة العلامة المائية)
# ذري = تخصيص طوارئ يتجاوز العلامة الدنيا
دالة يمكن_التخصيص(فهرس_منطقة، ذري)
    متغير حرة = قراءة_حقل(عنوان_صفحات_حرة، فهرس_منطقة)
    إذا (حرة == 0)
        ارجع 0
    نهاية

    إذا (ذري == 1)
        # التخصيص الذري يتجاوز العلامات المائية
        ارجع 1
    نهاية

    # التخصيص العادي: يجب أن نبقى فوق العلامة الدنيا
    متغير علامة_د = قراءة_حقل(عنوان_علامة_دنيا، فهرس_منطقة)
    إذا (حرة <= علامة_د)
        عداد_انتهاك_دنيا = عداد_انتهاك_دنيا + 1
        ارجع 0
    نهاية

    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# البحث عن صفحة حرة في منطقة
# ═══════════════════════════════════════════════════════════════════════════════

# البحث عن أول صفحة حرة في منطقة
# تُرجع فهرس الصفحة ضمن المنطقة، أو -1 إذا لم توجد
دالة بحث_صفحة_حرة(فهرس_منطقة)
    متغير عنوان_خريطة = خريطة_منطقة(فهرس_منطقة)
    متغير لفظات = لفظات_خريطة_منطقة(فهرس_منطقة)
    متغير إجمالي = قراءة_حقل(عنوان_إجمالي_صفحات، فهرس_منطقة)

    # بدء البحث من المؤشر المحفوظ (تسريع)
    متغير بداية_بحث = قراءة_حقل(عنوان_أول_حرة، فهرس_منطقة)

    # البحث في الخريطة البتية
    متغير ل = بداية_بحث / 32
    بينما (ل < لفظات)
        متغير لفظة = mem_read_dword(عنوان_خريطة + (ل * 4))
        # فحص سريع: هل كل البتات مضبوطة (كل الصفحات مستخدمة)
        إذا (لفظة != 4294967295)
            # توجد صفحة حرة في هذه اللفظة
            متغير ب = 0
            بينما (ب < 32)
                متغير فهرس_صفحة = (ل * 32) + ب
                إذا (فهرس_صفحة < إجمالي)
                    متغير قناع = 1 << ب
                    متغير مستخدمة = لفظة & قناع
                    إذا (مستخدمة == 0)
                        # وجدنا صفحة حرة
                        كتابة_حقل(عنوان_أول_حرة، فهرس_منطقة، فهرس_صفحة + 1)
                        ارجع فهرس_صفحة
                    نهاية
                نهاية
                ب = ب + 1
            نهاية
        نهاية
        ل = ل + 1
    نهاية

    # لم نجد — نبحث من البداية
    ل = 0
    متغير حد = بداية_بحث / 32
    بينما (ل < حد)
        متغير لفظة2 = mem_read_dword(عنوان_خريطة + (ل * 4))
        إذا (لفظة2 != 4294967295)
            متغير ب2 = 0
            بينما (ب2 < 32)
                متغير فهرس2 = (ل * 32) + ب2
                إذا (فهرس2 < إجمالي)
                    متغير قناع2 = 1 << ب2
                    متغير مستخدمة2 = لفظة2 & قناع2
                    إذا (مستخدمة2 == 0)
                        كتابة_حقل(عنوان_أول_حرة، فهرس_منطقة، فهرس2 + 1)
                        ارجع فهرس2
                    نهاية
                نهاية
                ب2 = ب2 + 1
            نهاية
        نهاية
        ل = ل + 1
    نهاية

    ارجع -1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحديد منطقة الاحتياط
# ═══════════════════════════════════════════════════════════════════════════════

# الحصول على منطقة الاحتياط لمنطقة معينة
# تُرجع فهرس منطقة الاحتياط أو -1 إذا لا يوجد احتياط
دالة منطقة_احتياط(فهرس_منطقة)
    # HIGHMEM → NORMAL → DMA → لا بديل
    إذا (فهرس_منطقة == منطقة_عالية)
        ارجع منطقة_عادية
    نهاية
    إذا (فهرس_منطقة == منطقة_عادية)
        ارجع منطقة_DMA
    نهاية
    # DMA: لا بديل
    ارجع -1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تخصيص صفحة من منطقة محددة
# ═══════════════════════════════════════════════════════════════════════════════

# تخصيص صفحة من منطقة محددة
# تُرجع العنوان الفيزيائي للصفحة أو 0 عند الفشل
دالة تخصيص_صفحة_من_منطقة(فهرس_منطقة)
    # التحقق من نشاط المنطقة
    متغير نشطة = قراءة_حقل(عنوان_نشاط_منطقة، فهرس_منطقة)
    إذا (نشطة == 0)
        ارجع 0
    نهاية

    # البحث عن صفحة حرة
    متغير فهرس_صفحة = بحث_صفحة_حرة(فهرس_منطقة)
    إذا (فهرس_صفحة < 0)
        ارجع 0
    نهاية

    # تحديد الصفحة كمستخدمة
    متغير عنوان_خريطة = خريطة_منطقة(فهرس_منطقة)
    ضبط_بت(عنوان_خريطة، فهرس_صفحة)

    # تحديث العدادات
    متغير حرة = قراءة_حقل(عنوان_صفحات_حرة، فهرس_منطقة)
    كتابة_حقل(عنوان_صفحات_حرة، فهرس_منطقة، حرة - 1)
    متغير مستخدمة = قراءة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة)
    كتابة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة، مستخدمة + 1)

    # تحديث مستوى الضغط
    متغير ضغط = فحص_ضغط_منطقة(فهرس_منطقة)
    كتابة_حقل(عنوان_ضغط_منطقة، فهرس_منطقة، ضغط)
    إذا (ضغط >= 2)
        عداد_ضغط = عداد_ضغط + 1
    نهاية

    # تحديث إحصائيات التخصيص لكل منطقة
    إذا (فهرس_منطقة == منطقة_DMA)
        عداد_تخصيص_dma = عداد_تخصيص_dma + 1
    نهاية
    إذا (فهرس_منطقة == منطقة_عادية)
        عداد_تخصيص_عادية = عداد_تخصيص_عادية + 1
    نهاية
    إذا (فهرس_منطقة == منطقة_عالية)
        عداد_تخصيص_عالية = عداد_تخصيص_عالية + 1
    نهاية
    عداد_تخصيص_إجمالي = عداد_تخصيص_إجمالي + 1

    # حساب العنوان الفيزيائي
    ارجع عنوان_صفحة_في_منطقة(فهرس_منطقة، فهرس_صفحة)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تخصيص صفحة بأعلام GFP
# ═══════════════════════════════════════════════════════════════════════════════

# تخصيص صفحة حسب أعلام GFP (مثل Linux)
# أعلام: مزيج من أعلام GFP
# تُرجع العنوان الفيزيائي أو 0
دالة تخصيص_صفحة(أعلام)
    إذا (تم_التهيئة == 0)
        kernel_print_string("[مناطق] خطأ: النظام غير مهيأ\n")
        ارجع 0
    نهاية

    # تحديد هل التخصيص ذري
    متغير فحص_ذري = أعلام & علم_GFP_ATOMIC
    متغير هل_ذري = 0
    إذا (فحص_ذري != 0)
        هل_ذري = 1
    نهاية

    # تحديد المنطقة المفضلة
    متغير منطقة_مفضلة = منطقة_عادية

    متغير فحص_dma = أعلام & علم_GFP_DMA
    إذا (فحص_dma != 0)
        منطقة_مفضلة = منطقة_DMA
    نهاية

    متغير فحص_عالية = أعلام & علم_GFP_HIGHMEM
    إذا (فحص_عالية != 0)
        منطقة_مفضلة = منطقة_عالية
    نهاية

    # محاولة التخصيص من المنطقة المفضلة
    متغير منطقة_حالية = منطقة_مفضلة

    بينما (منطقة_حالية >= 0)
        متغير يمكن = يمكن_التخصيص(منطقة_حالية، هل_ذري)
        إذا (يمكن == 1)
            متغير عنوان = تخصيص_صفحة_من_منطقة(منطقة_حالية)
            إذا (عنوان != 0)
                إذا (منطقة_حالية != منطقة_مفضلة)
                    عداد_احتياط = عداد_احتياط + 1
                نهاية
                ارجع عنوان
            نهاية
        نهاية

        # الانتقال لمنطقة الاحتياط
        منطقة_حالية = منطقة_احتياط(منطقة_حالية)
    نهاية

    # فشل كامل
    متغير فحص_تحذير = أعلام & علم_GFP_NOWARN
    إذا (فحص_تحذير == 0)
        kernel_print_string("[مناطق] فشل تخصيص صفحة! أعلام: ")
        kernel_print_number(أعلام)
        kernel_print_string("\n")
    نهاية

    عداد_فشل = عداد_فشل + 1
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحرير صفحة
# ═══════════════════════════════════════════════════════════════════════════════

# تحرير صفحة فيزيائية
# تُرجع 0 عند النجاح أو -1 عند الفشل
دالة تحرير_صفحة(عنوان_فيزيائي)
    إذا (تم_التهيئة == 0)
        ارجع -1
    نهاية

    # تحديد المنطقة
    متغير فهرس_منطقة = تحديد_منطقة(عنوان_فيزيائي)
    إذا (فهرس_منطقة < 0)
        kernel_print_string("[مناطق] خطأ: عنوان خارج النطاق: ")
        kernel_print_number(عنوان_فيزيائي)
        kernel_print_string("\n")
        ارجع -1
    نهاية

    # حساب فهرس الصفحة ضمن المنطقة
    متغير فهرس_صفحة = صفحة_في_منطقة(عنوان_فيزيائي، فهرس_منطقة)

    # فحص: هل الصفحة مستخدمة فعلاً؟
    متغير عنوان_خريطة = خريطة_منطقة(فهرس_منطقة)
    متغير مستخدمة_حالياً = فحص_بت(عنوان_خريطة، فهرس_صفحة)
    إذا (مستخدمة_حالياً == 0)
        kernel_print_string("[مناطق] تحذير: تحرير مزدوج لصفحة: ")
        kernel_print_number(عنوان_فيزيائي)
        kernel_print_string("\n")
        ارجع -1
    نهاية

    # تحرير الصفحة
    مسح_بت(عنوان_خريطة، فهرس_صفحة)

    # تحديث العدادات
    متغير حرة = قراءة_حقل(عنوان_صفحات_حرة، فهرس_منطقة)
    كتابة_حقل(عنوان_صفحات_حرة، فهرس_منطقة، حرة + 1)
    متغير مستخدمة = قراءة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة)
    كتابة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة، مستخدمة - 1)

    # تحديث مؤشر أول صفحة حرة
    متغير أول = قراءة_حقل(عنوان_أول_حرة، فهرس_منطقة)
    إذا (فهرس_صفحة < أول)
        كتابة_حقل(عنوان_أول_حرة، فهرس_منطقة، فهرس_صفحة)
    نهاية

    # تحديث مستوى الضغط
    متغير ضغط = فحص_ضغط_منطقة(فهرس_منطقة)
    كتابة_حقل(عنوان_ضغط_منطقة، فهرس_منطقة، ضغط)

    # تحديث الإحصائيات
    إذا (فهرس_منطقة == منطقة_DMA)
        عداد_تحرير_dma = عداد_تحرير_dma + 1
    نهاية
    إذا (فهرس_منطقة == منطقة_عادية)
        عداد_تحرير_عادية = عداد_تحرير_عادية + 1
    نهاية
    إذا (فهرس_منطقة == منطقة_عالية)
        عداد_تحرير_عالية = عداد_تحرير_عالية + 1
    نهاية
    عداد_تحرير_إجمالي = عداد_تحرير_إجمالي + 1

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تخصيص عدة صفحات متتالية من منطقة
# ═══════════════════════════════════════════════════════════════════════════════

# البحث عن صفحات متتالية حرة في منطقة
# تُرجع فهرس أول صفحة أو -1
دالة بحث_صفحات_متتالية(فهرس_منطقة، عدد_مطلوب)
    متغير عنوان_خريطة = خريطة_منطقة(فهرس_منطقة)
    متغير إجمالي = قراءة_حقل(عنوان_إجمالي_صفحات، فهرس_منطقة)

    متغير فهرس = 0
    بينما (فهرس + عدد_مطلوب <= إجمالي)
        # فحص هل كل الصفحات المطلوبة حرة
        متغير كلها_حرة = 1
        متغير ف = 0
        بينما (ف < عدد_مطلوب)
            متغير مستخدمة = فحص_بت(عنوان_خريطة، فهرس + ف)
            إذا (مستخدمة == 1)
                كلها_حرة = 0
                # القفز للصفحة بعد المستخدمة
                فهرس = فهرس + ف + 1
                ف = عدد_مطلوب
            نهاية
            ف = ف + 1
        نهاية

        إذا (كلها_حرة == 1)
            ارجع فهرس
        نهاية
    نهاية

    ارجع -1
نهاية

# تخصيص عدة صفحات متتالية
# تُرجع العنوان الفيزيائي لأول صفحة أو 0
دالة تخصيص_صفحات_متتالية(فهرس_منطقة، عدد_مطلوب)
    متغير فهرس_أول = بحث_صفحات_متتالية(فهرس_منطقة، عدد_مطلوب)
    إذا (فهرس_أول < 0)
        ارجع 0
    نهاية

    # تحديد جميع الصفحات كمستخدمة
    متغير عنوان_خريطة = خريطة_منطقة(فهرس_منطقة)
    متغير ف = 0
    بينما (ف < عدد_مطلوب)
        ضبط_بت(عنوان_خريطة، فهرس_أول + ف)
        ف = ف + 1
    نهاية

    # تحديث العدادات
    متغير حرة = قراءة_حقل(عنوان_صفحات_حرة، فهرس_منطقة)
    كتابة_حقل(عنوان_صفحات_حرة، فهرس_منطقة، حرة - عدد_مطلوب)
    متغير مستخدمة = قراءة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة)
    كتابة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة، مستخدمة + عدد_مطلوب)

    عداد_تخصيص_إجمالي = عداد_تخصيص_إجمالي + عدد_مطلوب

    ارجع عنوان_صفحة_في_منطقة(فهرس_منطقة، فهرس_أول)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تلوين الصفحات (NUMA Coloring)
# ═══════════════════════════════════════════════════════════════════════════════

# تحديد لون الصفحة بناءً على عنوانها
دالة لون_صفحة(عنوان_فيزيائي)
    متغير فهرس_صفحة = عنوان_فيزيائي / ثابت_مقاس_صفحة
    # اللون = (فهرس / صفحات_لكل_لون) mod عدد_ألوان
    متغير لون = (فهرس_صفحة / ثابت_صفحات_لكل_لون)
    # حساب الباقي يدوياً
    بينما (لون >= ثابت_عدد_ألوان_numa)
        لون = لون - ثابت_عدد_ألوان_numa
    نهاية
    ارجع لون
نهاية

# تخصيص صفحة بلون محدد (لتحسين أداء NUMA)
# تُرجع عنوان صفحة بلون قريب من المطلوب، أو أي صفحة حرة
دالة تخصيص_صفحة_ملونة(فهرس_منطقة، لون_مطلوب)
    متغير عنوان_خريطة = خريطة_منطقة(فهرس_منطقة)
    متغير إجمالي = قراءة_حقل(عنوان_إجمالي_صفحات، فهرس_منطقة)

    # البحث عن صفحة حرة بلون قريب
    متغير بداية = لون_مطلوب * ثابت_صفحات_لكل_لون
    إذا (بداية >= إجمالي)
        بداية = 0
    نهاية

    متغير ف = بداية
    بينما (ف < إجمالي)
        متغير مستخدمة = فحص_بت(عنوان_خريطة، ف)
        إذا (مستخدمة == 0)
            # وجدنا صفحة حرة
            ضبط_بت(عنوان_خريطة، ف)
            متغير حرة = قراءة_حقل(عنوان_صفحات_حرة، فهرس_منطقة)
            كتابة_حقل(عنوان_صفحات_حرة، فهرس_منطقة، حرة - 1)
            متغير مستخدمة_ع = قراءة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة)
            كتابة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة، مستخدمة_ع + 1)
            عداد_تخصيص_إجمالي = عداد_تخصيص_إجمالي + 1
            ارجع عنوان_صفحة_في_منطقة(فهرس_منطقة، ف)
        نهاية
        ف = ف + 1
    نهاية

    # لم نجد بعد بداية اللون — نبحث من البداية
    ف = 0
    بينما (ف < بداية)
        متغير مستخدمة2 = فحص_بت(عنوان_خريطة، ف)
        إذا (مستخدمة2 == 0)
            ضبط_بت(عنوان_خريطة، ف)
            متغير حرة2 = قراءة_حقل(عنوان_صفحات_حرة، فهرس_منطقة)
            كتابة_حقل(عنوان_صفحات_حرة، فهرس_منطقة، حرة2 - 1)
            متغير مستخدمة_ع2 = قراءة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة)
            كتابة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة، مستخدمة_ع2 + 1)
            عداد_تخصيص_إجمالي = عداد_تخصيص_إجمالي + 1
            ارجع عنوان_صفحة_في_منطقة(فهرس_منطقة، ف)
        نهاية
        ف = ف + 1
    نهاية

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إحصائيات مدير المناطق
# ═══════════════════════════════════════════════════════════════════════════════

# طباعة إحصائيات منطقة واحدة
دالة طباعة_إحصائيات_منطقة(فهرس_منطقة)
    متغير نشطة = قراءة_حقل(عنوان_نشاط_منطقة، فهرس_منطقة)
    إذا (نشطة == 0)
        ارجع 0
    نهاية

    # اسم المنطقة
    إذا (فهرس_منطقة == منطقة_DMA)
        kernel_print_string("  ─ منطقة DMA (0 — 16MB):\n")
    نهاية
    إذا (فهرس_منطقة == منطقة_عادية)
        kernel_print_string("  ─ منطقة عادية (16MB — 896MB):\n")
    نهاية
    إذا (فهرس_منطقة == منطقة_عالية)
        kernel_print_string("  ─ منطقة عالية (896MB+):\n")
    نهاية

    متغير إجمالي = قراءة_حقل(عنوان_إجمالي_صفحات، فهرس_منطقة)
    متغير حرة = قراءة_حقل(عنوان_صفحات_حرة، فهرس_منطقة)
    متغير مستخدمة = قراءة_حقل(عنوان_صفحات_مستخدمة، فهرس_منطقة)
    متغير ضغط = قراءة_حقل(عنوان_ضغط_منطقة، فهرس_منطقة)
