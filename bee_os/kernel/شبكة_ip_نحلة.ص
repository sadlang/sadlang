متغير route_dest_0 = 0
متغير route_dest_1 = 0
متغير route_dest_2 = 0
متغير route_dest_3 = 0

متغير route_mask_0 = 0
متغير route_mask_1 = 0
متغير route_mask_2 = 0
متغير route_mask_3 = 0

متغير route_gw_0 = 0
متغير route_gw_1 = 0
متغير route_gw_2 = 0
متغير route_gw_3 = 0

متغير route_active_0 = 0
متغير route_active_1 = 0
متغير route_active_2 = 0
متغير route_active_3 = 0

# ═══════════════════════════════════════════════════════════════════════════════
# دوال الطباعة التسلسلية
# ═══════════════════════════════════════════════════════════════════════════════
دالة ip_serial_اطبع(رسالة)
    متغير i = 0 + 0
    بينما (i < 80)
        متغير ch = sad_ll_mem_read8(رسالة + i) + 0
        إذا (ch == 0)
            ارجع 0
        نهاية
        sad_ll_serial_write_char(COM1، ch)
        i = i + 1
    نهاية
    ارجع 0
نهاية

دالة ip_serial_رقم(ن)
    متغير val = ن + 0
    إذا (val < 0)
        sad_ll_serial_write_char(COM1، 45)
        val = 0 - val
    نهاية
    إذا (val >= 10000)
        متغير d5 = val / 10000
        sad_ll_serial_write_char(COM1، 48 + d5)
        val = val - (d5 * 10000)
    نهاية
    إذا (val >= 1000)
        متغير d4 = val / 1000
        sad_ll_serial_write_char(COM1، 48 + d4)
        val = val - (d4 * 1000)
    والا_اذا (ن >= 10000)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    إذا (val >= 100)
        متغير d3 = val / 100
        sad_ll_serial_write_char(COM1، 48 + d3)
        val = val - (d3 * 100)
    والا_اذا (ن >= 1000)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    إذا (val >= 10)
        متغير d2 = val / 10
        sad_ll_serial_write_char(COM1، 48 + d2)
        val = val - (d2 * 10)
    والا_اذا (ن >= 100)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    sad_ll_serial_write_char(COM1، 48 + val)
    ارجع 0
نهاية

دالة ip_serial_سطر()
    sad_ll_serial_write_char(COM1، 13)
    sad_ll_serial_write_char(COM1، 10)
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# دوال مساعدة لـ IP
# ═══════════════════════════════════════════════════════════════════════════════

# تحويل 4 بايتات IP إلى عدد صحيح
دالة ip_to_int(a، b، c، d)
    ارجع a * 16777216 + b * 65536 + c * 256 + d
نهاية

# استخراج بايت من عنوان IP مُعبّأ
دالة ip_byte(ip_int، byte_num)
    إذا (byte_num == 0)
        ارجع (ip_int / 16777216) % 256
    نهاية
    إذا (byte_num == 1)
        ارجع (ip_int / 65536) % 256
    نهاية
    إذا (byte_num == 2)
        ارجع (ip_int / 256) % 256
    نهاية
    ارجع ip_int % 256
نهاية

# تجميع 3 بايتات MAC في قيمة واحدة
دالة mac_pack3(b0، b1، b2)
    ارجع b0 * 65536 + b1 * 256 + b2
نهاية

# استخراج بايت من MAC مضغوط (3 بايتات)
دالة mac_unpack(packed، byte_num)
    إذا (byte_num == 0)
        ارجع (packed / 65536) % 256
    نهاية
    إذا (byte_num == 1)
        ارجع (packed / 256) % 256
    نهاية
    ارجع packed % 256
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# حساب مجموع التحقق (Internet Checksum — RFC 1071)
# ═══════════════════════════════════════════════════════════════════════════════
دالة ip_checksum(buf، length)
    متغير sum = 0 + 0
    متغير offset = 0 + 0

    # جمع كل كلمة 16 بت
    بينما (offset + 1 < length)
        متغير hi = sad_ll_mem_read8(buf + offset) + 0
        متغير lo = sad_ll_mem_read8(buf + offset + 1) + 0
        متغير word = hi * 256 + lo
        sum = sum + word
        offset = offset + 2
    نهاية

    # إذا كان الطول فردي، أضف البايت الأخير
    إذا (offset < length)
        متغير last_byte = sad_ll_mem_read8(buf + offset) + 0
        sum = sum + last_byte * 256
    نهاية

    # طي الحمل (carry)
    بينما (sum > 65535)
        متغير carry = sum / 65536
        sum = (sum % 65536) + carry
    نهاية

    # المتمم الأحادي
    متغير result = 65535 - sum
    ارجع result + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# بناء رأس IPv4
# ═══════════════════════════════════════════════════════════════════════════════
# يكتب رأس IP (20 بايت) في المخزن المؤقت المحدد
# buf: عنوان بداية الكتابة
# total_len: الطول الكلي (رأس + بيانات)
# protocol: نوع البروتوكول (TCP=6, UDP=17, ICMP=1)
# dst_ip: عنوان IP الوجهة (معبأ)
صدّر دالة ip_build_header(buf، total_len، protocol، dst_ip)
    # البايت 0: الإصدار (4) + طول الرأس (5) = 0x45 = 69
    sad_ll_mem_write8(buf، 69)

    # البايت 1: نوع الخدمة (TOS) = 0
    sad_ll_mem_write8(buf + 1، 0)

    # البايتان 2-3: الطول الكلي (big-endian)
    sad_ll_mem_write8(buf + 2، total_len / 256)
    sad_ll_mem_write8(buf + 3، total_len % 256)

    # البايتان 4-5: معرّف الحزمة
    متغير pkt_id = ip_packet_id + 0
    sad_ll_mem_write8(buf + 4، pkt_id / 256)
    sad_ll_mem_write8(buf + 5، pkt_id % 256)
    ip_packet_id = ip_packet_id + 1

    # البايتان 6-7: أعلام + إزاحة التجزئة (DF=1, MF=0, offset=0) = 0x4000
    # DF flag = bit 14 = 0x40 في البايت 6
    sad_ll_mem_write8(buf + 6، 64)
    sad_ll_mem_write8(buf + 7، 0)

    # البايت 8: TTL
    sad_ll_mem_write8(buf + 8، IP_TTL_DEFAULT)

    # البايت 9: البروتوكول
    sad_ll_mem_write8(buf + 9، protocol)

    # البايتان 10-11: مجموع التحقق (يُكتب لاحقاً)
    sad_ll_mem_write8(buf + 10، 0)
    sad_ll_mem_write8(buf + 11، 0)

    # البايتات 12-15: عنوان IP المصدر
    sad_ll_mem_write8(buf + 12، local_ip_0 + 0)
    sad_ll_mem_write8(buf + 13، local_ip_1 + 0)
    sad_ll_mem_write8(buf + 14، local_ip_2 + 0)
    sad_ll_mem_write8(buf + 15، local_ip_3 + 0)

    # البايتات 16-19: عنوان IP الوجهة
    sad_ll_mem_write8(buf + 16، ip_byte(dst_ip، 0))
    sad_ll_mem_write8(buf + 17، ip_byte(dst_ip، 1))
    sad_ll_mem_write8(buf + 18، ip_byte(dst_ip، 2))
    sad_ll_mem_write8(buf + 19، ip_byte(dst_ip، 3))

    # حساب مجموع التحقق وكتابته
    متغير cksum = ip_checksum(buf، IP_HEADER_SIZE) + 0
    sad_ll_mem_write8(buf + 10، cksum / 256)
    sad_ll_mem_write8(buf + 11، cksum % 256)

    ارجع IP_HEADER_SIZE + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحليل رأس IPv4 المستقبل
# ═══════════════════════════════════════════════════════════════════════════════
# يقرأ رأس IP من حزمة مستقبلة
# pkt: عنوان بداية رأس IP (بعد رأس Ethernet)

# الحصول على إصدار IP
صدّر دالة ip_parse_version(pkt)
    متغير byte0 = sad_ll_mem_read8(pkt) + 0
    ارجع byte0 / 16
نهاية

# الحصول على طول الرأس بالبايتات
صدّر دالة ip_parse_ihl(pkt)
    متغير byte0 = sad_ll_mem_read8(pkt) + 0
    متغير ihl = byte0 % 16
    ارجع ihl * 4
نهاية

# الحصول على الطول الكلي
صدّر دالة ip_parse_total_length(pkt)
    متغير hi = sad_ll_mem_read8(pkt + 2) + 0
    متغير lo = sad_ll_mem_read8(pkt + 3) + 0
    ارجع hi * 256 + lo
نهاية

# الحصول على البروتوكول
صدّر دالة ip_parse_protocol(pkt)
    ارجع sad_ll_mem_read8(pkt + 9) + 0
نهاية

# الحصول على TTL
صدّر دالة ip_parse_ttl(pkt)
    ارجع sad_ll_mem_read8(pkt + 8) + 0
نهاية

# الحصول على عنوان IP المصدر (معبأ)
صدّر دالة ip_parse_src(pkt)
    متغير a = sad_ll_mem_read8(pkt + 12) + 0
    متغير b = sad_ll_mem_read8(pkt + 13) + 0
    متغير c = sad_ll_mem_read8(pkt + 14) + 0
    متغير d = sad_ll_mem_read8(pkt + 15) + 0
    ارجع ip_to_int(a، b، c، d)
نهاية

# الحصول على عنوان IP الوجهة (معبأ)
صدّر دالة ip_parse_dst(pkt)
    متغير a = sad_ll_mem_read8(pkt + 16) + 0
    متغير b = sad_ll_mem_read8(pkt + 17) + 0
    متغير c = sad_ll_mem_read8(pkt + 18) + 0
    متغير d = sad_ll_mem_read8(pkt + 19) + 0
    ارجع ip_to_int(a، b، c، d)
نهاية

# هل الحزمة موجهة لنا؟
صدّر دالة ip_is_for_us(pkt)
    متغير dst_ip = ip_parse_dst(pkt) + 0
    متغير our_ip = ip_to_int(local_ip_0 + 0، local_ip_1 + 0، local_ip_2 + 0، local_ip_3 + 0)

    # مطابقة مباشرة
    إذا (dst_ip == our_ip)
        ارجع 1
    نهاية

    # بث عام (255.255.255.255)
    متغير broadcast = ip_to_int(255، 255، 255، 255)
    إذا (dst_ip == broadcast)
        ارجع 1
    نهاية

    # بث الشبكة الفرعية
    متغير subnet_broadcast = ip_to_int(
        (local_ip_0 + 0) + ((255 - local_mask_0) + 0)،
        (local_ip_1 + 0) + ((255 - local_mask_1) + 0)،
        (local_ip_2 + 0) + ((255 - local_mask_2) + 0)،
        (local_ip_3 + 0) + ((255 - local_mask_3) + 0)
    )
    إذا (dst_ip == subnet_broadcast)
        ارجع 1
    نهاية

    ارجع 0
نهاية

# التحقق من مجموع التحقق
صدّر دالة ip_verify_checksum(pkt)
    متغير ihl = ip_parse_ihl(pkt) + 0
    متغير cksum = ip_checksum(pkt، ihl) + 0
    إذا (cksum == 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إرسال حزمة IP
# ═══════════════════════════════════════════════════════════════════════════════
# ترسل حزمة IP كاملة مع حل ARP تلقائي
# dst_ip: عنوان IP الوجهة (معبأ)
# protocol: البروتوكول (TCP=6, UDP=17, ICMP=1)
# payload_addr: عنوان البيانات
# payload_len: طول البيانات
صدّر دالة ip_send(dst_ip، protocol، payload_addr، payload_len)
    متغير total_len = IP_HEADER_SIZE + payload_len

    إذا (total_len > IP_MAX_PACKET)
        ip_serial_اطبع("[IP] حزمة كبيرة جداً")
        ip_serial_سطر()
        ip_tx_errors = ip_tx_errors + 1
        ارجع 0
    نهاية

    # تخصيص ذاكرة للحزمة الكاملة (ETH + IP + payload)
    متغير frame_size = ETH_HEADER_SIZE + total_len
    متغير frame_buf = sad_ll_kmalloc(frame_size) + 0
    إذا (frame_buf == 0)
        ip_serial_اطبع("[IP] فشل تخصيص الذاكرة")
        ip_serial_سطر()
        ip_tx_errors = ip_tx_errors + 1
        ارجع 0
    نهاية

    sad_ll_memset(frame_buf، 0، frame_size)

    # تحديد عنوان IP للمقصد التالي (next hop)
    متغير next_hop = ip_resolve_next_hop(dst_ip) + 0

    # حل MAC عبر ARP
    متغير arp_idx = arp_lookup(next_hop) + 0
    إذا (arp_idx < 0)
        # لم نجد — أرسل طلب ARP
        arp_send_request(next_hop)
        ip_serial_اطبع("[IP] ARP غير موجود: ")
        ip_serial_رقم(ip_byte(next_hop، 0))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(next_hop، 1))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(next_hop، 2))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(next_hop، 3))
        ip_serial_سطر()
        sad_ll_kfree(frame_buf)
        ip_tx_errors = ip_tx_errors + 1
        ارجع 0
    نهاية

    # التحقق من حالة ARP
    متغير arp_state = arp_get_state(arp_idx) + 0
    إذا (arp_state != ARP_RESOLVED)
        إذا (arp_state != ARP_PERMANENT)
            ip_serial_اطبع("[IP] ARP لم يُحلّ بعد")
            ip_serial_سطر()
            sad_ll_kfree(frame_buf)
            ip_tx_errors = ip_tx_errors + 1
            ارجع 0
        نهاية
    نهاية

    # استخراج MAC الوجهة من ذاكرة ARP المؤقتة
    متغير mac_hi = arp_get_mac_hi(arp_idx) + 0
    متغير mac_lo = arp_get_mac_lo(arp_idx) + 0

    متغير d0 = mac_unpack(mac_hi، 0) + 0
    متغير d1 = mac_unpack(mac_hi، 1) + 0
    متغير d2 = mac_unpack(mac_hi، 2) + 0
    متغير d3 = mac_unpack(mac_lo، 0) + 0
    متغير d4 = mac_unpack(mac_lo، 1) + 0
    متغير d5 = mac_unpack(mac_lo، 2) + 0

    # بناء رأس Ethernet
    eth_build_header(frame_buf، d0، d1، d2، d3، d4، d5، ETHER_TYPE_IP)

    # بناء رأس IP
    ip_build_header(frame_buf + ETH_HEADER_SIZE، total_len، protocol، dst_ip)

    # نسخ البيانات
    sad_ll_memcpy(frame_buf + ETH_HEADER_SIZE + IP_HEADER_SIZE، payload_addr، payload_len)

    # إرسال الإطار
    متغير result = net_send(frame_buf، frame_size) + 0

    sad_ll_kfree(frame_buf)

    إذا (result > 0)
        ip_tx_count = ip_tx_count + 1
    والا
        ip_tx_errors = ip_tx_errors + 1
    نهاية

    ارجع result + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إرسال IP بالبث
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ip_send_broadcast(protocol، payload_addr، payload_len)
    متغير total_len = IP_HEADER_SIZE + payload_len
    متغير dst_ip = ip_to_int(255، 255، 255، 255)

    # تخصيص مخزن IP (بدون Ethernet — eth_send_broadcast يضيفه)
    متغير ip_buf = sad_ll_kmalloc(total_len) + 0
    إذا (ip_buf == 0)
        ip_tx_errors = ip_tx_errors + 1
        ارجع 0
    نهاية

    sad_ll_memset(ip_buf، 0، total_len)
    ip_build_header(ip_buf، total_len، protocol، dst_ip)
    sad_ll_memcpy(ip_buf + IP_HEADER_SIZE، payload_addr، payload_len)

    متغير result = eth_send_broadcast(ip_buf، total_len، ETHER_TYPE_IP) + 0

    sad_ll_kfree(ip_buf)

    إذا (result > 0)
        ip_tx_count = ip_tx_count + 1
    والا
        ip_tx_errors = ip_tx_errors + 1
    نهاية

    ارجع result + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# التوجيه — تحديد المقصد التالي (Next Hop)
# ═══════════════════════════════════════════════════════════════════════════════
دالة ip_resolve_next_hop(dst_ip)
    متغير our_net = ip_to_int(
        local_ip_0 + 0، local_ip_1 + 0، local_ip_2 + 0، local_ip_3 + 0
    )
    متغير mask_int = ip_to_int(
        local_mask_0 + 0، local_mask_1 + 0، local_mask_2 + 0، local_mask_3 + 0
    )

    # التحقق من الشبكة المحلية عبر مقارنة كل بايت
    متغير dst_0 = ip_byte(dst_ip، 0) + 0
    متغير dst_1 = ip_byte(dst_ip، 1) + 0
