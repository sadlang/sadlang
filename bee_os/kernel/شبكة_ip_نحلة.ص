    متغير src_net_0 = (local_ip_0 + 0) - ((local_ip_0 + 0) % (256 - local_mask_0))
    متغير src_net_1 = (local_ip_1 + 0) - ((local_ip_1 + 0) % (256 - local_mask_1))
    متغير src_net_2 = (local_ip_2 + 0) - ((local_ip_2 + 0) % (256 - local_mask_2))
