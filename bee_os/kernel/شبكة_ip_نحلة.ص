# ═══════════════════════════════════════════════════════════════════════════════
# معالجة حزمة IP مستقبلة
# ═══════════════════════════════════════════════════════════════════════════════
# تُستدعى من net_دورة عند استقبال حزمة EtherType=0x0800
# pkt_addr: عنوان الحزمة الكامل (بما فيها رأس Ethernet)
# pkt_len: طول الحزمة الكامل
صدّر دالة ip_handle_packet(pkt_addr، pkt_len)
    # رأس IP يبدأ بعد رأس Ethernet
    متغير ip_hdr = pkt_addr + ETH_HEADER_SIZE

    # التحقق من الإصدار
    متغير version = ip_parse_version(ip_hdr) + 0
    إذا (version != 4)
        ip_serial_اطبع("[IP] إصدار غير مدعوم: ")
        ip_serial_رقم(version)
        ip_serial_سطر()
        ip_rx_errors = ip_rx_errors + 1
        ارجع 0
    نهاية

    # التحقق من مجموع التحقق
    متغير cksum_ok = ip_verify_checksum(ip_hdr) + 0
    إذا (cksum_ok == 0)
        ip_serial_اطبع("[IP] مجموع تحقق خاطئ!")
        ip_serial_سطر()
        ip_checksum_errors = ip_checksum_errors + 1
        ip_rx_errors = ip_rx_errors + 1
        ارجع 0
    نهاية

    # هل الحزمة لنا؟
    متغير for_us = ip_is_for_us(ip_hdr) + 0
    إذا (for_us == 0)
        ip_dropped = ip_dropped + 1
        ارجع 0
    نهاية

    ip_rx_count = ip_rx_count + 1

    # استخراج معلومات الحزمة
    متغير protocol = ip_parse_protocol(ip_hdr) + 0
    متغير ihl = ip_parse_ihl(ip_hdr) + 0
    متغير total_len = ip_parse_total_length(ip_hdr) + 0
    متغير payload_addr = ip_hdr + ihl
    متغير payload_len = total_len - ihl

    # تسجيل في السجل التسلسلي
    متغير src_ip = ip_parse_src(ip_hdr) + 0
    ip_serial_اطبع("[IP] RX proto=")
    ip_serial_رقم(protocol)
    ip_serial_اطبع(" from=")
    ip_serial_رقم(ip_byte(src_ip، 0))
    sad_ll_serial_write_char(COM1، 46)
    ip_serial_رقم(ip_byte(src_ip، 1))
    sad_ll_serial_write_char(COM1، 46)
    ip_serial_رقم(ip_byte(src_ip، 2))
    sad_ll_serial_write_char(COM1، 46)
    ip_serial_رقم(ip_byte(src_ip، 3))
    ip_serial_اطبع(" len=")
    ip_serial_رقم(payload_len)
    ip_serial_سطر()

    # توزيع حسب البروتوكول
    إذا (protocol == IP_PROTO_ICMP)
        ارجع ip_handle_icmp(payload_addr، payload_len، src_ip)
    نهاية

    # TCP و UDP سيُعالجان في الوحدات الأخرى
    # حالياً نسجلهم فقط
    إذا (protocol == IP_PROTO_TCP)
        ip_serial_اطبع("[IP] TCP packet (not handled yet)")
        ip_serial_سطر()
        ارجع 1
    نهاية

    إذا (protocol == IP_PROTO_UDP)
        ip_serial_اطبع("[IP] UDP packet (not handled yet)")
        ip_serial_سطر()
        ارجع 1
    نهاية

    ip_serial_اطبع("[IP] بروتوكول غير معروف: ")
    ip_serial_رقم(protocol)
    ip_serial_سطر()
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# ICMP — Echo Request / Reply (Ping)
# ═══════════════════════════════════════════════════════════════════════════════
ثابت ICMP_ECHO_REQUEST = 8
ثابت ICMP_ECHO_REPLY   = 0

# حساب مجموع تحقق ICMP (نفس خوارزمية IP)
دالة icmp_checksum(buf، length)
    ارجع ip_checksum(buf، length)
نهاية

# معالجة حزمة ICMP
دالة ip_handle_icmp(payload_addr، payload_len، src_ip)
    إذا (payload_len < 8)
        ip_serial_اطبع("[IP] ICMP قصير جداً")
        ip_serial_سطر()
        ارجع 0
    نهاية

    متغير icmp_type = sad_ll_mem_read8(payload_addr) + 0
    متغير icmp_code = sad_ll_mem_read8(payload_addr + 1) + 0

    إذا (icmp_type == ICMP_ECHO_REQUEST)
        ip_serial_اطبع("[IP] ICMP Echo Request from=")
        ip_serial_رقم(ip_byte(src_ip، 0))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(src_ip، 1))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(src_ip، 2))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(src_ip، 3))
        ip_serial_سطر()

        # إرسال Echo Reply
        ارجع ip_send_icmp_reply(src_ip، payload_addr، payload_len)
    نهاية

    إذا (icmp_type == ICMP_ECHO_REPLY)
        ip_serial_اطبع("[IP] ICMP Echo Reply from=")
        ip_serial_رقم(ip_byte(src_ip، 0))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(src_ip، 1))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(src_ip، 2))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(src_ip، 3))
        ip_serial_سطر()
        ارجع 1
    نهاية

    ip_serial_اطبع("[IP] ICMP type=")
    ip_serial_رقم(icmp_type)
    ip_serial_اطبع(" code=")
    ip_serial_رقم(icmp_code)
    ip_serial_سطر()
    ارجع 0
نهاية

# إرسال رد ICMP Echo Reply
دالة ip_send_icmp_reply(dst_ip، req_payload، req_len)
    # تخصيص مخزن للرد
    متغير reply_buf = sad_ll_kmalloc(req_len) + 0
    إذا (reply_buf == 0)
        ارجع 0
    نهاية

    # نسخ بيانات الطلب
    sad_ll_memcpy(reply_buf، req_payload، req_len)

    # تغيير النوع إلى Echo Reply (0) والكود إلى 0
    sad_ll_mem_write8(reply_buf، ICMP_ECHO_REPLY)
    sad_ll_mem_write8(reply_buf + 1، 0)

    # إعادة حساب مجموع التحقق
    sad_ll_mem_write8(reply_buf + 2، 0)
    sad_ll_mem_write8(reply_buf + 3، 0)
    متغير cksum = icmp_checksum(reply_buf، req_len) + 0
    sad_ll_mem_write8(reply_buf + 2، cksum / 256)
    sad_ll_mem_write8(reply_buf + 3، cksum % 256)

    # إرسال عبر IP
    متغير result = ip_send(dst_ip، IP_PROTO_ICMP، reply_buf، req_len) + 0

    sad_ll_kfree(reply_buf)
    ارجع result + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إرسال طلب Ping
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ip_ping(dst_ip، seq_num)
    # بناء حزمة ICMP Echo Request
    ثابت PING_DATA_SIZE = 32
    متغير icmp_len = 8 + PING_DATA_SIZE
    متغير icmp_buf = sad_ll_kmalloc(icmp_len) + 0
    إذا (icmp_buf == 0)
        ارجع 0
    نهاية

    sad_ll_memset(icmp_buf، 0، icmp_len)

    # Type = 8 (Echo Request)
    sad_ll_mem_write8(icmp_buf، ICMP_ECHO_REQUEST)
    # Code = 0
    sad_ll_mem_write8(icmp_buf + 1، 0)
    # Checksum = 0 (مؤقتاً)
    sad_ll_mem_write8(icmp_buf + 2، 0)
    sad_ll_mem_write8(icmp_buf + 3، 0)
    # Identifier = 1
    sad_ll_mem_write8(icmp_buf + 4، 0)
    sad_ll_mem_write8(icmp_buf + 5، 1)
    # Sequence number
    sad_ll_mem_write8(icmp_buf + 6، seq_num / 256)
    sad_ll_mem_write8(icmp_buf + 7، seq_num % 256)

    # ملء البيانات بنمط
    متغير i = 0 + 0
    بينما (i < PING_DATA_SIZE)
        sad_ll_mem_write8(icmp_buf + 8 + i، (i + 65) % 256)
        i = i + 1
    نهاية

    # حساب مجموع التحقق
    متغير cksum = icmp_checksum(icmp_buf، icmp_len) + 0
    sad_ll_mem_write8(icmp_buf + 2، cksum / 256)
    sad_ll_mem_write8(icmp_buf + 3، cksum % 256)

    # إرسال عبر IP
    متغير result = ip_send(dst_ip، IP_PROTO_ICMP، icmp_buf، icmp_len) + 0

    sad_ll_kfree(icmp_buf)

    إذا (result > 0)
        ip_serial_اطبع("[IP] Ping sent to ")
        ip_serial_رقم(ip_byte(dst_ip، 0))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(dst_ip، 1))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(dst_ip، 2))
        sad_ll_serial_write_char(COM1، 46)
        ip_serial_رقم(ip_byte(dst_ip، 3))
        ip_serial_اطبع(" seq=")
        ip_serial_رقم(seq_num)
        ip_serial_سطر()
    نهاية

    ارجع result + 0
نهاية

