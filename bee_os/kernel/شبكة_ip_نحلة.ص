    متغير dst_net_0 = dst_0 - (dst_0 % (256 - local_mask_0))
    متغير dst_net_1 = dst_1 - (dst_1 % (256 - local_mask_1))
    متغير dst_net_2 = dst_2 - (dst_2 % (256 - local_mask_2))
