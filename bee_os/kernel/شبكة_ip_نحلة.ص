# ═══════════════════════════════════════════════════════════════════════════════
# ثوابت
# ═══════════════════════════════════════════════════════════════════════════════
ثابت COM1 = 1016

# أنواع بروتوكولات IP
ثابت ETHER_TYPE_IP  = 2048        # 0x0800
ثابت IP_PROTO_ICMP  = 1
ثابت IP_PROTO_TCP   = 6
ثابت IP_PROTO_UDP   = 17

# أحجام الرؤوس
ثابت ETH_HEADER_SIZE = 14
ثابت IP_HEADER_SIZE  = 20         # بدون خيارات
ثابت IP_VERSION      = 4
ثابت IP_IHL          = 5          # 5 كلمات 32-بت = 20 بايت
ثابت IP_TTL_DEFAULT  = 64
ثابت IP_MAX_PACKET   = 1500       # MTU

# أعلام التجزئة
ثابت IP_FLAG_DF      = 2          # Don't Fragment
ثابت IP_FLAG_MF      = 1          # More Fragments

# حالات ARP
ثابت ARP_RESOLVED    = 2
ثابت ARP_PERMANENT   = 3

# ═══════════════════════════════════════════════════════════════════════════════
# متغيرات عامة — تكوين IP المحلي
# ═══════════════════════════════════════════════════════════════════════════════
متغير local_ip_0 = 0
متغير local_ip_1 = 0
متغير local_ip_2 = 0
متغير local_ip_3 = 0

متغير local_mask_0 = 255
متغير local_mask_1 = 255
متغير local_mask_2 = 255
متغير local_mask_3 = 0

متغير local_gw_0 = 0
متغير local_gw_1 = 0
متغير local_gw_2 = 0
متغير local_gw_3 = 0

# MAC المحلي (نسخة من وحدة الشبكة)
متغير local_mac_0 = 0
متغير local_mac_1 = 0
متغير local_mac_2 = 0
متغير local_mac_3 = 0
متغير local_mac_4 = 0
متغير local_mac_5 = 0

# معرّف الحزمة (يزداد مع كل حزمة مرسلة)
متغير ip_packet_id = 1

# ─── إحصائيات ───
متغير ip_tx_count = 0
متغير ip_rx_count = 0
متغير ip_rx_errors = 0
متغير ip_tx_errors = 0
متغير ip_checksum_errors = 0
متغير ip_ttl_expired = 0
متغير ip_forwarded = 0
متغير ip_dropped = 0

# ─── جدول التوجيه البسيط (4 مسارات) ───
