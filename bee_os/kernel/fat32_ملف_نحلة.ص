# فتح ملف
# =====================================================================

صدّر دالة ملف_افتح(فهرس_قسم، عنقود_دليل، اسم_83، وضع)
    serial_puts("[FILE] فتح ملف، وضع=")
    serial_put_int(وضع + 0)
    serial_puts("\r\n")
    
    # التحقق من صلاحية الوضع
    إذا (وضع < 1)
        ارجع خطأ_صلاحية + 0
    نهاية
    إذا (وضع > 4)
        ارجع خطأ_صلاحية + 0
    نهاية
    
    # البحث عن واصف حر
    متغير واصف = ملف_واصف_حر()
    إذا (واصف < 0)
        serial_puts("[FILE] خطأ: لا يوجد واصف حر\r\n")
        ارجع خطأ_لا_واصف + 0
    نهاية
    
    # البحث عن الملف في الدليل
    متغير عنقود_ملف = دليل_ابحث_اسم(فهرس_قسم + 0، عنقود_دليل + 0، اسم_83 + 0)
    
    إذا (عنقود_ملف < 0)
        # الملف غير موجود
        إذا (وضع == وضع_كتابة)
            # إنشاء ملف جديد
            عنقود_ملف = fat32_خصص_عنقود(فهرس_قسم + 0)
            إذا (عنقود_ملف < 0)
                serial_puts("[FILE] خطأ: فشل تخصيص عنقود\r\n")
                ارجع خطأ_نفاد_مساحة + 0
            نهاية
            
            # إنشاء مدخل في الدليل
            دليل_أنشئ_مدخل(فهرس_قسم + 0، عنقود_دليل + 0، اسم_83 + 0، سمة_أرشيف_ملف + 0، عنقود_ملف + 0)
            
            # تهيئة الواصف
            عيّن_وضعية(واصف + 0، وضع + 0)
            عيّن_قسم(واصف + 0، فهرس_قسم + 0)
            عيّن_عنقود_أول(واصف + 0، عنقود_ملف + 0)
            عيّن_مقاس(واصف + 0، 0)
            عيّن_موضع(واصف + 0، 0)
            عيّن_معدّل(واصف + 0، 0)
            
            إجمالي_ملفات_مفتوحة = إجمالي_ملفات_مفتوحة + 1
            serial_puts("[FILE] أُنشئ ملف جديد، واصف=")
            serial_put_int(واصف + 0)
            serial_puts("\r\n")
            ارجع واصف + 0
        وإلا
            إذا (وضع == وضع_إلحاق)
                # إنشاء ملف جديد للإلحاق أيضاً
                عنقود_ملف = fat32_خصص_عنقود(فهرس_قسم + 0)
                إذا (عنقود_ملف < 0)
                    ارجع خطأ_نفاد_مساحة + 0
                نهاية
                دليل_أنشئ_مدخل(فهرس_قسم + 0، عنقود_دليل + 0، اسم_83 + 0، سمة_أرشيف_ملف + 0، عنقود_ملف + 0)
                
                عيّن_وضعية(واصف + 0، وضع + 0)
                عيّن_قسم(واصف + 0، فهرس_قسم + 0)
                عيّن_عنقود_أول(واصف + 0، عنقود_ملف + 0)
                عيّن_مقاس(واصف + 0، 0)
                عيّن_موضع(واصف + 0، 0)
                عيّن_معدّل(واصف + 0، 0)
                
                إجمالي_ملفات_مفتوحة = إجمالي_ملفات_مفتوحة + 1
                ارجع واصف + 0
            نهاية
        نهاية
        
        serial_puts("[FILE] خطأ: ملف غير موجود\r\n")
        ارجع خطأ_ملف_غير_موجود + 0
    نهاية
    
    # الملف موجود — تهيئة الواصف
    عيّن_وضعية(واصف + 0، وضع + 0)
    عيّن_قسم(واصف + 0، فهرس_قسم + 0)
    عيّن_عنقود_أول(واصف + 0، عنقود_ملف + 0)
    عيّن_مقاس(واصف + 0، 0)
    عيّن_معدّل(واصف + 0، 0)
    
    إذا (وضع == وضع_إلحاق)
        # موضع الإلحاق = نهاية الملف
        متغير مقاس_حالي = هات_مقاس(واصف + 0)
        عيّن_موضع(واصف + 0، مقاس_حالي + 0)
    وإلا
        عيّن_موضع(واصف + 0، 0)
    نهاية
    
    إجمالي_ملفات_مفتوحة = إجمالي_ملفات_مفتوحة + 1
    
    serial_puts("[FILE] تم الفتح، واصف=")
    serial_put_int(واصف + 0)
    serial_puts(" عنقود=")
    serial_put_int(عنقود_ملف + 0)
    serial_puts("\r\n")
    
    ارجع واصف + 0
