# =====================================================================

صدّر دالة ملف_اكتب(واصف، مخزن_مصدر، عدد_مطلوب)
    # التحقق من صلاحية الواصف
    متغير وضع = ملف_وضعية(واصف + 0)
    إذا (وضع == 0)
        ارجع خطأ_واصف_غير_صالح + 0
    نهاية
    
    # التحقق من صلاحية الكتابة
    إذا (وضع == وضع_قراءة)
        serial_puts("[FILE] خطأ: محاولة كتابة إلى ملف مفتوح للقراءة فقط\r\n")
        ارجع خطأ_صلاحية + 0
    نهاية
    
    متغير فهرس_قسم = هات_قسم(واصف + 0)
    متغير عنقود_أول = هات_عنقود_أول(واصف + 0)
    متغير مقاس = هات_مقاس(واصف + 0)
    متغير موضع = هات_موضع(واصف + 0)
    
    # حساب العنقود والإزاحة
    متغير مقاس_عنقود = fat32_قطاعات_عنقود(فهرس_قسم + 0) * fat32_عرض_قطاع(فهرس_قسم + 0)
    متغير رقم_عنقود_في_سلسلة = موضع / مقاس_عنقود
    متغير إزاحة_في_عنقود = موضع % مقاس_عنقود
    
    # الانتقال إلى العنقود المناسب (أو تمديد السلسلة)
    متغير طول_سلسلة = fat32_طول_سلسلة(فهرس_قسم + 0، عنقود_أول + 0)
    
    # تمديد السلسلة إذا لزم الأمر
    بينما (طول_سلسلة <= رقم_عنقود_في_سلسلة)
        متغير نتيجة_تمديد = fat32_مدّد_سلسلة(فهرس_قسم + 0، عنقود_أول + 0)
        إذا (نتيجة_تمديد < 0)
            serial_puts("[FILE] خطأ: فشل تمديد السلسلة\r\n")
            ارجع خطأ_نفاد_مساحة + 0
        نهاية
        طول_سلسلة = طول_سلسلة + 1
    نهاية
    
    متغير عنقود_حالي = fat32_عنقود_رقم_ن(فهرس_قسم + 0، عنقود_أول + 0، رقم_عنقود_في_سلسلة + 0)
    إذا (عنقود_حالي < 0)
        ارجع خطأ_قرص + 0
    نهاية
    
    # تخصيص مخزن مؤقت
    متغير مخزن_عنقود = kmalloc(مقاس_عنقود + 0)
    إذا (مخزن_عنقود == 0)
        ارجع خطأ_ذاكرة + 0
    نهاية
    
    # قراءة العنقود الحالي (للحفاظ على البيانات الموجودة)
    fat32_اقرأ_عنقود(فهرس_قسم + 0، عنقود_حالي + 0، مخزن_عنقود + 0)
    
    # كتابة البيانات
    متغير مكتوب = 0
    بينما (مكتوب < عدد_مطلوب)
        # كتابة بايت واحد
        متغير قيمة_كتابة = mem_read_byte(مخزن_مصدر + 0، مكتوب + 0)
        mem_write_byte(مخزن_عنقود + 0، إزاحة_في_عنقود + 0، قيمة_كتابة + 0)
        
        مكتوب = مكتوب + 1
        إزاحة_في_عنقود = إزاحة_في_عنقود + 1
        
        # الانتقال للعنقود التالي عند الحاجة
        إذا (إزاحة_في_عنقود >= مقاس_عنقود)
            # كتابة العنقود الحالي أولاً
            fat32_اكتب_عنقود(فهرس_قسم + 0، عنقود_حالي + 0، مخزن_عنقود + 0)
            
            إذا (مكتوب < عدد_مطلوب)
                # الحصول على العنقود التالي أو تخصيص واحد جديد
                متغير تالي = fat32_اقرأ_مدخل_fat(فهرس_قسم + 0، عنقود_حالي + 0)
                إذا (fat32_هل_نهاية_سلسلة(تالي + 0) == 1)
                    تالي = fat32_مدّد_سلسلة(فهرس_قسم + 0، عنقود_حالي + 0)
                    إذا (تالي < 0)
                        # فشل التمديد — كتابة ما أمكن
                        اخرج
                    نهاية
                    # مسح العنقود الجديد
                    mem_set(مخزن_عنقود + 0، 0، مقاس_عنقود + 0)
                وإلا
                    fat32_اقرأ_عنقود(فهرس_قسم + 0، تالي + 0، مخزن_عنقود + 0)
                نهاية
                عنقود_حالي = تالي + 0
                إزاحة_في_عنقود = 0
            نهاية
        نهاية
    نهاية
    
    # كتابة آخر عنقود معدّل
    fat32_اكتب_عنقود(فهرس_قسم + 0، عنقود_حالي + 0، مخزن_عنقود + 0)
    
    kfree(مخزن_عنقود + 0)
    
    # تحديث الموضع والمقاس
    متغير موضع_محدث = موضع + مكتوب
    عيّن_موضع(واصف + 0، موضع_محدث + 0)
    
    إذا (موضع_محدث > مقاس)
        عيّن_مقاس(واصف + 0، موضع_محدث + 0)
    نهاية
    
    عيّن_معدّل(واصف + 0، 1)
    
    # تحديث الإحصائيات
    إجمالي_كتابات = إجمالي_كتابات + 1
    إجمالي_بيانات_مكتوبة = إجمالي_بيانات_مكتوبة + مكتوب
    
    ارجع مكتوب + 0
