# =====================================================================
# قراءة بيانات من ملف
# يقرأ عدد معين من البايتات من الموضع الحالي
# يُرجع عدد البايتات المقروءة فعلياً
# =====================================================================

صدّر دالة ملف_اقرأ(واصف، مخزن_هدف، عدد_مطلوب)
    # التحقق من صلاحية الواصف
    متغير وضع = ملف_وضعية(واصف + 0)
    إذا (وضع == 0)
        ارجع خطأ_واصف_غير_صالح + 0
    نهاية
    
    # التحقق من صلاحية القراءة
    إذا (وضع == وضع_كتابة)
        serial_puts("[FILE] خطأ: محاولة قراءة من ملف مفتوح للكتابة فقط\r\n")
        ارجع خطأ_صلاحية + 0
    نهاية
    
    متغير فهرس_قسم = هات_قسم(واصف + 0)
    متغير عنقود_أول = هات_عنقود_أول(واصف + 0)
    متغير مقاس = هات_مقاس(واصف + 0)
    متغير موضع = هات_موضع(واصف + 0)
    
    # التحقق من نهاية الملف
    إذا (موضع >= مقاس)
        ارجع 0
    نهاية
    
    # تحديد عدد البايتات الفعلي للقراءة
    متغير بقية = مقاس - موضع
    متغير عدد_فعلي = عدد_مطلوب + 0
    إذا (عدد_فعلي > بقية)
        عدد_فعلي = بقية + 0
    نهاية
    
    # حساب العنقود والإزاحة
    متغير مقاس_عنقود = fat32_قطاعات_عنقود(فهرس_قسم + 0) * fat32_عرض_قطاع(فهرس_قسم + 0)
    متغير رقم_عنقود_في_سلسلة = موضع / مقاس_عنقود
    متغير إزاحة_في_عنقود = موضع % مقاس_عنقود
    
    # الانتقال إلى العنقود المناسب
    متغير عنقود_حالي = fat32_عنقود_رقم_ن(فهرس_قسم + 0، عنقود_أول + 0، رقم_عنقود_في_سلسلة + 0)
    إذا (عنقود_حالي < 0)
        ارجع خطأ_قرص + 0
    نهاية
    
    # تخصيص مخزن مؤقت لعنقود
    متغير مخزن_عنقود = kmalloc(مقاس_عنقود + 0)
    إذا (مخزن_عنقود == 0)
        ارجع خطأ_ذاكرة + 0
    نهاية
    
    # قراءة العنقود الحالي
    fat32_اقرأ_عنقود(فهرس_قسم + 0، عنقود_حالي + 0، مخزن_عنقود + 0)
    
    # نسخ البيانات
    متغير مقروء = 0
    بينما (مقروء < عدد_فعلي)
        # نسخ بايت واحد
        متغير قيمة_حالية = mem_read_byte(مخزن_عنقود + 0، إزاحة_في_عنقود + 0)
        mem_write_byte(مخزن_هدف + 0، مقروء + 0، قيمة_حالية + 0)
        
        مقروء = مقروء + 1
        إزاحة_في_عنقود = إزاحة_في_عنقود + 1
        
        # الانتقال للعنقود التالي عند الحاجة
        إذا (إزاحة_في_عنقود >= مقاس_عنقود)
            إذا (مقروء < عدد_فعلي)
                متغير تالي = fat32_اقرأ_مدخل_fat(فهرس_قسم + 0، عنقود_حالي + 0)
                إذا (fat32_هل_نهاية_سلسلة(تالي + 0) == 1)
                    اخرج
                نهاية
                عنقود_حالي = تالي + 0
                fat32_اقرأ_عنقود(فهرس_قسم + 0، عنقود_حالي + 0، مخزن_عنقود + 0)
                إزاحة_في_عنقود = 0
            نهاية
        نهاية
    نهاية
    
    kfree(مخزن_عنقود + 0)
    
    # تحديث الموضع
    متغير موضع_محدث = موضع + مقروء
    عيّن_موضع(واصف + 0، موضع_محدث + 0)
    
    # تحديث الإحصائيات
    إجمالي_قراءات = إجمالي_قراءات + 1
    إجمالي_بيانات_مقروءة = إجمالي_بيانات_مقروءة + مقروء
    
    ارجع مقروء + 0
