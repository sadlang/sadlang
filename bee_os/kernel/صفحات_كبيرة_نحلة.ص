# الثوابت
# ═══════════════════════════════════════════════════════════════════════════════

# مقاس الصفحة الصغيرة (4KB)
متغير ثابت_مقاس_صفحة = 4096
# مقاس الصفحة الكبيرة (4MB = 1024 × 4KB)
متغير ثابت_مقاس_صفحة_كبيرة = 4194304
# عدد الصفحات الصغيرة في صفحة كبيرة
متغير ثابت_صفحات_في_كبيرة = 1024

# ─── أعلام مدخلة دليل الصفحات (PDE) ───
متغير بت_حاضر = 1           # بت 0: موجودة
متغير بت_كتابة = 2          # بت 1: قابلة للكتابة
متغير بت_مستخدم = 4         # بت 2: وصول المستخدم
متغير بت_كتابة_مباشرة = 8   # بت 3: Write-Through
متغير بت_تعطيل_مخبأ = 16    # بت 4: Cache Disable
متغير بت_وصول = 32          # بت 5: Accessed
متغير بت_متسخة = 64         # بت 6: Dirty
متغير بت_مقاس_صفحة = 128    # بت 7: PS = 1 → صفحة كبيرة (4MB)
متغير بت_عام = 256           # بت 8: Global

# بت PSE في CR4
متغير بت_CR4_PSE = 16       # بت 4 في CR4: Page Size Extension

# قناع لاستخراج عنوان الإطار (صفحة كبيرة: محاذاة 4MB)
# 4MB = 0x00400000 → القناع = 0xFFC00000
متغير قناع_إطار_كبير = 4290772992   # 0xFFC00000 — أعلى 10 بتات
# قناع صفحة صغيرة
متغير قناع_إطار_صغير = 4294963200   # 0xFFFFF000

# ─── ثوابت حوض الصفحات الكبيرة ───
# أقصى عدد صفحات كبيرة في الحوض
متغير ثابت_اقصى_صفحات_كبيرة = 256
# أقصى عدد حجوزات
متغير ثابت_اقصى_حجوزات = 128

# ─── وضعيات الصفحة الكبيرة ───
متغير وضعية_حرة = 0          # حرة ومتاحة
متغير وضعية_مخصصة = 1        # مخصصة ومستخدمة
متغير وضعية_محجوزة = 2       # محجوزة (hugetlbfs)
متغير وضعية_قيد_تجميع = 3    # قيد التجميع (compaction)
متغير وضعية_قيد_تقسيم = 4    # قيد التقسيم (splitting)

# ─── ثوابت الترقية الشفافة (THP) ───
# الحد الأدنى لعدد الصفحات المتتالية للترقية
متغير ثابت_حد_ترقية = 1024   # 1024 صفحة = 4MB
# عتبة المسح — كل كم صفحة نفحص إمكانية الترقية
متغير ثابت_عتبة_مسح = 256
# هل THP مفعلة
متغير ثابت_thp_مفعلة = 1

# ─── حقول مدخلة حوض الصفحات الكبيرة ───
# كل مدخلة في الحوض (7 حقول × 4 بايتات = 28 بايت):
# [0] عنوان_فيزيائي  — عنوان بداية 4MB المحاذاة
# [1] عنوان_افتراضي  — العنوان الافتراضي المُعيَّن
# [2] وضعية          — وضعية الصفحة
# [3] معرف_عملية     — العملية المالكة
# [4] أعلام          — أعلام إضافية
# [5] عداد_وصول      — عدد مرات الوصول (للإحصائيات)
# [6] مصدر           — 0=حوض، 1=THP، 2=حجز
متغير ثابت_حقول_مدخلة = 7
متغير ثابت_مقاس_مدخلة = 28

# ═══════════════════════════════════════════════════════════════════════════════
# المتغيرات العامة — حالة مدير الصفحات الكبيرة
# ═══════════════════════════════════════════════════════════════════════════════

# هل تم التهيئة
متغير تم_التهيئة = 0

# هل PSE مدعومة ومفعلة
متغير pse_مدعومة = 0
متغير pse_مفعلة = 0

# ─── حوض الصفحات الكبيرة ───
# مصفوفات متوازية لمدخلات الحوض
متغير عنوان_حوض_فيزيائي = 0     # العنوان الفيزيائي
متغير عنوان_حوض_افتراضي = 0     # العنوان الافتراضي
متغير عنوان_حوض_وضعية = 0       # الوضعية
متغير عنوان_حوض_عملية = 0       # معرف العملية
متغير عنوان_حوض_أعلام = 0       # الأعلام
متغير عنوان_حوض_وصول = 0        # عداد الوصول
متغير عنوان_حوض_مصدر = 0        # المصدر

# عدادات الحوض
متغير عدد_صفحات_كبيرة_حرة = 0
متغير عدد_صفحات_كبيرة_مخصصة = 0
متغير عدد_صفحات_كبيرة_محجوزة = 0
متغير إجمالي_صفحات_كبيرة = 0

# ─── جدول الحجوزات ───
# كل حجز (3 حقول):
# [0] معرف_عملية
# [1] عدد_مطلوب (صفحات كبيرة)
# [2] عدد_مخصص (فعلياً)
متغير عنوان_حجز_عملية = 0
متغير عنوان_حجز_مطلوب = 0
متغير عنوان_حجز_مخصص = 0
متغير عدد_حجوزات_نشطة = 0

# ═══════════════════════════════════════════════════════════════════════════════
# إحصائيات الصفحات الكبيرة
# ═══════════════════════════════════════════════════════════════════════════════
متغير عداد_تخصيص = 0              # إجمالي تخصيصات صفحات كبيرة
متغير عداد_تحرير = 0              # إجمالي تحريرات
متغير عداد_ترقية = 0              # عدد الترقيات (THP: صغيرة → كبيرة)
متغير عداد_تقسيم = 0              # عدد التقسيمات (كبيرة → صغيرة)
متغير عداد_حجز = 0                # عدد عمليات الحجز
متغير عداد_إلغاء_حجز = 0          # عدد عمليات إلغاء الحجز
متغير عداد_تجميع = 0              # عدد محاولات التجميع
متغير عداد_تجميع_ناجح = 0         # عدد التجميعات الناجحة
متغير عداد_فشل_تخصيص = 0         # عدد مرات فشل التخصيص
متغير عداد_فشل_ترقية = 0          # عدد مرات فشل الترقية
متغير إجمالي_ذاكرة_كبيرة = 0     # إجمالي الذاكرة في صفحات كبيرة (بالبايتات)

# ═══════════════════════════════════════════════════════════════════════════════
# دوال مساعدة
# ═══════════════════════════════════════════════════════════════════════════════

# قراءة/كتابة حقل من مصفوفة
دالة قراءة_حقل(عنوان_مصفوفة، فهرس)
    ارجع mem_read_dword(عنوان_مصفوفة + (فهرس * 4))
نهاية

دالة كتابة_حقل(عنوان_مصفوفة، فهرس، قيمة)
    mem_write_dword(عنوان_مصفوفة + (فهرس * 4)، قيمة)
نهاية

# فحص محاذاة عنوان على حد 4MB
# 4MB = 0x00400000 = 4194304
# العنوان محاذى إذا كانت أدنى 22 بت = 0
دالة هل_محاذاة_4mb(عنوان)
    متغير قناع = ثابت_مقاس_صفحة_كبيرة - 1
    متغير باقي = عنوان & قناع
    إذا (باقي == 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# محاذاة عنوان لأعلى حد 4MB
دالة محاذاة_4mb_أعلى(عنوان)
    متغير قناع = ثابت_مقاس_صفحة_كبيرة - 1
    متغير باقي = عنوان & قناع
    إذا (باقي == 0)
        ارجع عنوان
    نهاية
    ارجع (عنوان + ثابت_مقاس_صفحة_كبيرة) & قناع_إطار_كبير
نهاية

# محاذاة عنوان لأسفل حد 4MB
دالة محاذاة_4mb_أسفل(عنوان)
    ارجع عنوان & قناع_إطار_كبير
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# فحص دعم PSE في المعالج
# ═══════════════════════════════════════════════════════════════════════════════

# فحص هل المعالج يدعم PSE عبر CPUID
# CPUID function 1, EDX bit 3 = PSE support
دالة فحص_دعم_pse()
    kernel_print_string("[صفحات كبيرة] فحص دعم PSE...\n")

    # CPUID مع EAX=1 → EDX يحتوي على ميزات المعالج
    متغير edx = sad_ll_cpuid_edx(1)

    # بت 3 من EDX = PSE
    متغير بت_pse = 8
    متغير نتيجة = edx & بت_pse
    إذا (نتيجة != 0)
        kernel_print_string("  PSE مدعومة في المعالج\n")
        pse_مدعومة = 1
        ارجع 1
    وإلا
        kernel_print_string("  PSE غير مدعومة!\n")
        pse_مدعومة = 0
        ارجع 0
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تفعيل PSE في CR4
# ═══════════════════════════════════════════════════════════════════════════════

# تفعيل Page Size Extension عبر ضبط بت 4 في CR4
دالة تفعيل_pse()
    إذا (pse_مدعومة == 0)
        kernel_print_string("[صفحات كبيرة] لا يمكن تفعيل PSE — غير مدعومة\n")
        ارجع -1
    نهاية

    kernel_print_string("[صفحات كبيرة] تفعيل PSE في CR4...\n")

    # قراءة CR4 الحالي
    متغير cr4 = sad_ll_read_cr4()
    kernel_print_string("  CR4 الحالي: ")
    kernel_print_number(cr4)
    kernel_print_string("\n")

    # فحص: هل PSE مفعلة بالفعل؟
    متغير فحص = cr4 & بت_CR4_PSE
    إذا (فحص != 0)
        kernel_print_string("  PSE مفعلة مسبقاً\n")
        pse_مفعلة = 1
        ارجع 0
    نهاية

    # تفعيل PSE بضبط بت 4
    متغير cr4_جديد = cr4 | بت_CR4_PSE
    sad_ll_write_cr4(cr4_جديد)

    # تأكيد التفعيل
    متغير cr4_فحص = sad_ll_read_cr4()
    متغير فحص2 = cr4_فحص & بت_CR4_PSE
    إذا (فحص2 != 0)
        kernel_print_string("  تم تفعيل PSE بنجاح! CR4 الجديد: ")
        kernel_print_number(cr4_فحص)
        kernel_print_string("\n")
        pse_مفعلة = 1
        ارجع 0
    وإلا
        kernel_print_string("  فشل تفعيل PSE!\n")
        ارجع -1
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إنشاء مدخلة PDE لصفحة كبيرة (4MB)
# ═══════════════════════════════════════════════════════════════════════════════

# إنشاء مدخلة في دليل الصفحات لصفحة 4MB
# العنوان يجب أن يكون محاذاة على 4MB
دالة إنشاء_pde_كبيرة(عنوان_فيزيائي، أعلام_إضافية)
    # التأكد من المحاذاة
    متغير محاذى = هل_محاذاة_4mb(عنوان_فيزيائي)
    إذا (محاذى == 0)
        kernel_print_string("[صفحات كبيرة] خطأ: عنوان غير محاذى على 4MB!\n")
        ارجع 0
    نهاية

    # إنشاء PDE: عنوان + PS=1 + Present + أعلام
    متغير pde = عنوان_فيزيائي | بت_مقاس_صفحة | بت_حاضر
    pde = pde | أعلام_إضافية

    ارجع pde
نهاية

# تعيين صفحة كبيرة في دليل الصفحات
# عنوان_cr3: عنوان دليل الصفحات
# عنوان_افتراضي: العنوان الافتراضي (يجب أن يكون محاذاة 4MB)
# عنوان_فيزيائي: العنوان الفيزيائي (يجب أن يكون محاذاة 4MB)
# أعلام: أعلام إضافية (كتابة، مستخدم، إلخ)
دالة تعيين_صفحة_كبيرة(عنوان_cr3، عنوان_افتراضي، عنوان_فيزيائي، أعلام)
    # حساب فهرس في دليل الصفحات
    # العنوان الافتراضي >> 22 = فهرس الدليل
    متغير فهرس = عنوان_افتراضي >> 22

    # إنشاء PDE
    متغير pde = إنشاء_pde_كبيرة(عنوان_فيزيائي، أعلام)
    إذا (pde == 0)
        ارجع -1
    نهاية

    # كتابة PDE في دليل الصفحات
    متغير عنوان_مدخلة = عنوان_cr3 + (فهرس * 4)
    mem_write_dword(عنوان_مدخلة، pde)

    # إبطال TLB لهذا النطاق (4MB)
    sad_ll_invlpg(عنوان_افتراضي)

    ارجع 0
نهاية

# إلغاء تعيين صفحة كبيرة من دليل الصفحات
دالة إلغاء_تعيين_صفحة_كبيرة(عنوان_cr3، عنوان_افتراضي)
    متغير فهرس = عنوان_افتراضي >> 22
    متغير عنوان_مدخلة = عنوان_cr3 + (فهرس * 4)

    # تصفير المدخلة
    mem_write_dword(عنوان_مدخلة، 0)

    # إبطال TLB
    sad_ll_invlpg(عنوان_افتراضي)

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إدارة حوض الصفحات الكبيرة
# ═══════════════════════════════════════════════════════════════════════════════

# البحث عن فتحة حرة في الحوض
دالة بحث_فتحة_حوض_حرة()
    متغير م = 0
    بينما (م < ثابت_اقصى_صفحات_كبيرة)
        متغير وضع = قراءة_حقل(عنوان_حوض_وضعية، م)
        إذا (وضع == وضعية_حرة)
            ارجع م
        نهاية
        م = م + 1
    نهاية
    ارجع -1
نهاية

# إضافة صفحة كبيرة للحوض
# عنوان_فيز: عنوان فيزيائي محاذى على 4MB
# تُرجع فهرس المدخلة أو -1
دالة إضافة_للحوض(عنوان_فيز)
    متغير فهرس = بحث_فتحة_حوض_حرة()
    إذا (فهرس < 0)
        kernel_print_string("[صفحات كبيرة] الحوض ممتلئ!\n")
        ارجع -1
    نهاية

    كتابة_حقل(عنوان_حوض_فيزيائي، فهرس، عنوان_فيز)
    كتابة_حقل(عنوان_حوض_افتراضي، فهرس، 0)
    كتابة_حقل(عنوان_حوض_وضعية، فهرس، وضعية_حرة)
    كتابة_حقل(عنوان_حوض_عملية، فهرس، 0)
    كتابة_حقل(عنوان_حوض_أعلام، فهرس، 0)
    كتابة_حقل(عنوان_حوض_وصول، فهرس، 0)
    كتابة_حقل(عنوان_حوض_مصدر، فهرس، 0)

    عدد_صفحات_كبيرة_حرة = عدد_صفحات_كبيرة_حرة + 1
    إجمالي_صفحات_كبيرة = إجمالي_صفحات_كبيرة + 1

    ارجع فهرس
نهاية

# تخصيص صفحة كبيرة من الحوض
# معرف_العملية: العملية الطالبة
# تُرجع العنوان الفيزيائي أو 0 عند الفشل
دالة تخصيص_صفحة_كبيرة(معرف_العملية)
    إذا (تم_التهيئة == 0)
        kernel_print_string("[صفحات كبيرة] النظام غير مهيأ!\n")
        ارجع 0
    نهاية

    إذا (pse_مفعلة == 0)
        kernel_print_string("[صفحات كبيرة] PSE غير مفعلة!\n")
        ارجع 0
    نهاية

    # البحث عن صفحة حرة في الحوض
    متغير م = 0
    بينما (م < ثابت_اقصى_صفحات_كبيرة)
        متغير وضع = قراءة_حقل(عنوان_حوض_وضعية، م)
        إذا (وضع == وضعية_حرة)
            متغير عنوان_فيز = قراءة_حقل(عنوان_حوض_فيزيائي، م)
            إذا (عنوان_فيز != 0)
                # وجدنا صفحة — نخصصها
                كتابة_حقل(عنوان_حوض_وضعية، م، وضعية_مخصصة)
                كتابة_حقل(عنوان_حوض_عملية، م، معرف_العملية)
                كتابة_حقل(عنوان_حوض_مصدر، م، 0)

                عدد_صفحات_كبيرة_حرة = عدد_صفحات_كبيرة_حرة - 1
                عدد_صفحات_كبيرة_مخصصة = عدد_صفحات_كبيرة_مخصصة + 1
                عداد_تخصيص = عداد_تخصيص + 1
                إجمالي_ذاكرة_كبيرة = إجمالي_ذاكرة_كبيرة + ثابت_مقاس_صفحة_كبيرة

                kernel_print_string("[صفحات كبيرة] تخصيص: عملية=")
                kernel_print_number(معرف_العملية)
                kernel_print_string(" عنوان=")
                kernel_print_number(عنوان_فيز)
                kernel_print_string("\n")

                ارجع عنوان_فيز
            نهاية
        نهاية
        م = م + 1
    نهاية

    # لا توجد صفحات حرة — محاولة تجميع
    kernel_print_string("[صفحات كبيرة] لا توجد صفحات حرة — محاولة تجميع...\n")
    متغير عنوان_مجمع = محاولة_تجميع()
    إذا (عنوان_مجمع != 0)
        # التجميع نجح — نخصص الصفحة الجديدة
        متغير فهرس_جديد = إضافة_للحوض(عنوان_مجمع)
        إذا (فهرس_جديد >= 0)
            كتابة_حقل(عنوان_حوض_وضعية، فهرس_جديد، وضعية_مخصصة)
            كتابة_حقل(عنوان_حوض_عملية، فهرس_جديد، معرف_العملية)
            عدد_صفحات_كبيرة_حرة = عدد_صفحات_كبيرة_حرة - 1
            عدد_صفحات_كبيرة_مخصصة = عدد_صفحات_كبيرة_مخصصة + 1
            عداد_تخصيص = عداد_تخصيص + 1
            إجمالي_ذاكرة_كبيرة = إجمالي_ذاكرة_كبيرة + ثابت_مقاس_صفحة_كبيرة
            ارجع عنوان_مجمع
        نهاية
    نهاية

    عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
    kernel_print_string("[صفحات كبيرة] فشل التخصيص!\n")
    ارجع 0
نهاية

# تحرير صفحة كبيرة وإعادتها للحوض
دالة تحرير_صفحة_كبيرة(عنوان_فيزيائي)
    متغير م = 0
    بينما (م < ثابت_اقصى_صفحات_كبيرة)
        متغير عنوان = قراءة_حقل(عنوان_حوض_فيزيائي، م)
        إذا (عنوان == عنوان_فيزيائي)
            متغير وضع = قراءة_حقل(عنوان_حوض_وضعية، م)
            إذا (وضع == وضعية_مخصصة)
                كتابة_حقل(عنوان_حوض_وضعية، م، وضعية_حرة)
                كتابة_حقل(عنوان_حوض_عملية، م، 0)
                كتابة_حقل(عنوان_حوض_افتراضي، م، 0)
                كتابة_حقل(عنوان_حوض_وصول، م، 0)

                عدد_صفحات_كبيرة_حرة = عدد_صفحات_كبيرة_حرة + 1
                عدد_صفحات_كبيرة_مخصصة = عدد_صفحات_كبيرة_مخصصة - 1
                عداد_تحرير = عداد_تحرير + 1
                إجمالي_ذاكرة_كبيرة = إجمالي_ذاكرة_كبيرة - ثابت_مقاس_صفحة_كبيرة

                kernel_print_string("[صفحات كبيرة] تحرير: ")
                kernel_print_number(عنوان_فيزيائي)
                kernel_print_string("\n")

                ارجع 0
            نهاية
        نهاية
        م = م + 1
    نهاية

    kernel_print_string("[صفحات كبيرة] خطأ: عنوان غير موجود في الحوض: ")
    kernel_print_number(عنوان_فيزيائي)
    kernel_print_string("\n")
    ارجع -1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# التجميع (Compaction) — إنشاء صفحات كبيرة من صفحات صغيرة
# ═══════════════════════════════════════════════════════════════════════════════

# محاولة تجميع 1024 صفحة صغيرة متتالية لإنشاء صفحة كبيرة
# تعتمد على تخصيص صفحات من المخصص الأساسي ونقل المحتوى
# تُرجع عنوان الصفحة الكبيرة المُنشأة أو 0
دالة محاولة_تجميع()
    عداد_تجميع = عداد_تجميع + 1

    kernel_print_string("[صفحات كبيرة] بدء محاولة تجميع...\n")

    # نحاول تخصيص 1024 صفحة متتالية
    # نخصص الصفحات ونفحص المحاذاة
    متغير أول_صفحة = sad_ll_page_alloc()
    إذا (أول_صفحة == 0)
        kernel_print_string("[صفحات كبيرة] فشل تخصيص أول صفحة\n")
        ارجع 0
    نهاية

    # فحص: هل الصفحة الأولى محاذاة على 4MB؟
    متغير محاذاة = هل_محاذاة_4mb(أول_صفحة)
    إذا (محاذاة == 0)
        # ليست محاذاة — نحرر ونعيد المحاولة
        sad_ll_page_free(أول_صفحة)

        # نخصص صفحات حتى نجد واحدة محاذاة
        متغير محاولات = 0
        متغير وجدنا = 0
        بينما (محاولات < 2048)
            متغير صفحة = sad_ll_page_alloc()
            إذا (صفحة == 0)
                kernel_print_string("[صفحات كبيرة] نفدت الذاكرة أثناء التجميع\n")
                ارجع 0
            نهاية
            متغير مح = هل_محاذاة_4mb(صفحة)
            إذا (مح == 1)
                أول_صفحة = صفحة
                وجدنا = 1
                محاولات = 2048
            وإلا
                sad_ll_page_free(صفحة)
            نهاية
            محاولات = محاولات + 1
        نهاية

        إذا (وجدنا == 0)
            kernel_print_string("[صفحات كبيرة] فشل إيجاد عنوان محاذى\n")
            ارجع 0
        نهاية
    نهاية

    # الآن نخصص بقية 1023 صفحة (يجب أن تكون متتالية)
    # في المحاكاة، نفترض أن sad_ll_page_alloc يُعطي صفحات متتالية
    متغير ص = 1
    متغير نجح = 1
    بينما (ص < ثابت_صفحات_في_كبيرة)
        متغير صفحة_تالية = sad_ll_page_alloc()
        إذا (صفحة_تالية == 0)
            نجح = 0
            ص = ثابت_صفحات_في_كبيرة
        نهاية
        ص = ص + 1
    نهاية

    إذا (نجح == 0)
        kernel_print_string("[صفحات كبيرة] فشل التجميع — ذاكرة غير كافية\n")
        # نحرر ما خصصناه
        sad_ll_page_free(أول_صفحة)
        ارجع 0
    نهاية

    # تصفير كل الصفحات
    sad_ll_memset(أول_صفحة، 0، ثابت_مقاس_صفحة_كبيرة)

    عداد_تجميع_ناجح = عداد_تجميع_ناجح + 1

    kernel_print_string("[صفحات كبيرة] تجميع ناجح! عنوان: ")
    kernel_print_number(أول_صفحة)
    kernel_print_string("\n")

    ارجع أول_صفحة
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# الترقية الشفافة (THP) — ترقية صفحات صغيرة إلى كبيرة
# ═══════════════════════════════════════════════════════════════════════════════

# فحص هل يمكن ترقية نطاق عناوين إلى صفحة كبيرة
# عنوان_cr3: دليل الصفحات
# عنوان_بداية: بداية النطاق (يجب أن يكون محاذاة 4MB)
# تُرجع 1 إذا يمكن الترقية، 0 خلاف ذلك
دالة يمكن_ترقية(عنوان_cr3، عنوان_بداية)
    # التأكد من المحاذاة
    متغير محاذى = هل_محاذاة_4mb(عنوان_بداية)
    إذا (محاذى == 0)
        ارجع 0
    نهاية

    # فحص مدخلة الدليل
    متغير فهرس_دليل = عنوان_بداية >> 22
    متغير مدخلة = mem_read_dword(عنوان_cr3 + (فهرس_دليل * 4))

    # فحص: هل هي بالفعل صفحة كبيرة؟
    متغير فحص_ps = مدخلة & بت_مقاس_صفحة
    إذا (فحص_ps != 0)
        # بالفعل صفحة كبيرة
        ارجع 0
    نهاية

    # فحص: هل المدخلة حاضرة؟
    متغير فحص_حاضر = مدخلة & بت_حاضر
    إذا (فحص_حاضر == 0)
        ارجع 0
    نهاية

    # الحصول على جدول الصفحات وفحص كل 1024 مدخلة
    متغير قناع_جدول = 4294963200
    متغير عنوان_جدول = مدخلة & قناع_جدول
    متغير أول_إطار = 0
    متغير متتالية = 1

    متغير ف = 0
    بينما (ف < ثابت_صفحات_في_كبيرة)
        متغير pte = mem_read_dword(عنوان_جدول + (ف * 4))

        # هل الصفحة حاضرة؟
        متغير حاضرة = pte & بت_حاضر
        إذا (حاضرة == 0)
            متتالية = 0
            ف = ثابت_صفحات_في_كبيرة
        وإلا
            # استخراج عنوان الإطار
            متغير إطار = pte & قناع_إطار_صغير
            إذا (ف == 0)
                أول_إطار = إطار
            وإلا
                # فحص: هل الإطار متتالي؟
                متغير متوقع = أول_إطار + (ف * ثابت_مقاس_صفحة)
                إذا (إطار != متوقع)
                    متتالية = 0
                    ف = ثابت_صفحات_في_كبيرة
                نهاية
            نهاية
        نهاية
        ف = ف + 1
    نهاية

    إذا (متتالية == 0)
        ارجع 0
    نهاية

    # فحص: هل أول إطار محاذى على 4MB؟
    متغير مح_إطار = هل_محاذاة_4mb(أول_إطار)
    إذا (مح_إطار == 0)
        ارجع 0
    نهاية

    ارجع 1
نهاية

# تنفيذ الترقية: تحويل 1024 صفحة صغيرة إلى صفحة كبيرة واحدة
# عنوان_cr3: دليل الصفحات
# عنوان_بداية: بداية النطاق (محاذاة 4MB)
# تُرجع 0 عند النجاح
دالة ترقية_إلى_كبيرة(عنوان_cr3، عنوان_بداية، معرف_عملية)
    # التأكد أن الترقية ممكنة
    متغير ممكن = يمكن_ترقية(عنوان_cr3، عنوان_بداية)
    إذا (ممكن == 0)
        عداد_فشل_ترقية = عداد_فشل_ترقية + 1
        ارجع -1
    نهاية

    kernel_print_string("[THP] ترقية صفحات صغيرة → كبيرة: ")
    kernel_print_number(عنوان_بداية)
    kernel_print_string("\n")

    # الحصول على عنوان الإطار الفيزيائي من أول PTE
    متغير فهرس_دليل = عنوان_بداية >> 22
    متغير مدخلة_دليل = mem_read_dword(عنوان_cr3 + (فهرس_دليل * 4))
    متغير قناع_جدول = 4294963200
    متغير عنوان_جدول = مدخلة_دليل & قناع_جدول
    متغير أول_pte = mem_read_dword(عنوان_جدول)
    متغير عنوان_إطار = أول_pte & قناع_إطار_صغير

    # جمع الأعلام من PTEs (استخدام أعلام أول PTE)
    متغير أعلام_pte = أول_pte & 7   # أدنى 3 بتات: P, R/W, U/S

    # إنشاء PDE لصفحة كبيرة
    متغير pde = إنشاء_pde_كبيرة(عنوان_إطار، أعلام_pte)

    # استبدال مدخلة الدليل
    mem_write_dword(عنوان_cr3 + (فهرس_دليل * 4)، pde)

    # تحرير جدول الصفحات القديم (اختياري — قد نحتاجه لاحقاً)
    # sad_ll_page_free(عنوان_جدول)

    # إبطال TLB
    sad_ll_flush_tlb()

    # تسجيل في الحوض
    متغير فهرس_حوض = بحث_فتحة_حوض_حرة()
    إذا (فهرس_حوض >= 0)
        كتابة_حقل(عنوان_حوض_فيزيائي، فهرس_حوض، عنوان_إطار)
        كتابة_حقل(عنوان_حوض_افتراضي، فهرس_حوض، عنوان_بداية)
        كتابة_حقل(عنوان_حوض_وضعية، فهرس_حوض، وضعية_مخصصة)
        كتابة_حقل(عنوان_حوض_عملية، فهرس_حوض، معرف_عملية)
        كتابة_حقل(عنوان_حوض_مصدر، فهرس_حوض، 1)
        إجمالي_صفحات_كبيرة = إجمالي_صفحات_كبيرة + 1
        عدد_صفحات_كبيرة_مخصصة = عدد_صفحات_كبيرة_مخصصة + 1
    نهاية

    عداد_ترقية = عداد_ترقية + 1
    إجمالي_ذاكرة_كبيرة = إجمالي_ذاكرة_كبيرة + ثابت_مقاس_صفحة_كبيرة

    kernel_print_string("[THP] تمت الترقية بنجاح\n")
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تقسيم صفحة كبيرة إلى صفحات صغيرة (Splitting)
# ═══════════════════════════════════════════════════════════════════════════════

# تقسيم صفحة كبيرة 4MB إلى 1024 صفحة صغيرة 4KB
# مطلوب عندما نحتاج أذونات مختلفة لأجزاء من الصفحة
# أو عند حدوث COW على جزء منها
دالة تقسيم_صفحة_كبيرة(عنوان_cr3، عنوان_افتراضي)
    # محاذاة العنوان لحد 4MB
    متغير عنوان_محاذى = محاذاة_4mb_أسفل(عنوان_افتراضي)
    متغير فهرس_دليل = عنوان_محاذى >> 22

    # قراءة PDE الحالية
    متغير pde = mem_read_dword(عنوان_cr3 + (فهرس_دليل * 4))

    # فحص: هل هي صفحة كبيرة؟
    متغير فحص_ps = pde & بت_مقاس_صفحة
    إذا (فحص_ps == 0)
        kernel_print_string("[صفحات كبيرة] ليست صفحة كبيرة - لا حاجة للتقسيم\n")
        ارجع -1
    نهاية

    kernel_print_string("[صفحات كبيرة] تقسيم صفحة كبيرة: ")
    kernel_print_number(عنوان_محاذى)
    kernel_print_string("\n")

    # استخراج العنوان الفيزيائي والأعلام
    متغير عنوان_فيزيائي = pde & قناع_إطار_كبير
    متغير أعلام = pde & 7   # P, R/W, U/S

    # تخصيص جدول صفحات جديد (صفحة واحدة = 1024 مدخلة × 4)
    متغير جدول_جديد = sad_ll_page_alloc()
    إذا (جدول_جديد == 0)
        kernel_print_string("[صفحات كبيرة] فشل تخصيص جدول صفحات!\n")
        ارجع -1
    نهاية

    # ملء جدول الصفحات: 1024 مدخلة، كل واحدة لصفحة 4KB
    متغير ف = 0
    بينما (ف < ثابت_صفحات_في_كبيرة)
        متغير عنوان_إطار_صغير = عنوان_فيزيائي + (ف * ثابت_مقاس_صفحة)
        متغير pte = عنوان_إطار_صغير | أعلام
        mem_write_dword(جدول_جديد + (ف * 4)، pte)
        ف = ف + 1
    نهاية

    # استبدال PDE: من صفحة كبيرة إلى مؤشر جدول صفحات
    # إزالة بت PS، إضافة عنوان الجدول الجديد
    متغير pde_جديدة = جدول_جديد | أعلام
    mem_write_dword(عنوان_cr3 + (فهرس_دليل * 4)، pde_جديدة)

    # إبطال TLB
    sad_ll_flush_tlb()

    # تحديث الحوض
    متغير م = 0
    بينما (م < ثابت_اقصى_صفحات_كبيرة)
        متغير عنوان = قراءة_حقل(عنوان_حوض_فيزيائي، م)
        إذا (عنوان == عنوان_فيزيائي)
            كتابة_حقل(عنوان_حوض_وضعية، م، وضعية_حرة)
            كتابة_حقل(عنوان_حوض_عملية، م، 0)
            عدد_صفحات_كبيرة_مخصصة = عدد_صفحات_كبيرة_مخصصة - 1
            إجمالي_صفحات_كبيرة = إجمالي_صفحات_كبيرة - 1
            م = ثابت_اقصى_صفحات_كبيرة
        نهاية
        م = م + 1
    نهاية

    عداد_تقسيم = عداد_تقسيم + 1
    إجمالي_ذاكرة_كبيرة = إجمالي_ذاكرة_كبيرة - ثابت_مقاس_صفحة_كبيرة

    kernel_print_string("[صفحات كبيرة] تم التقسيم إلى ")
    kernel_print_number(ثابت_صفحات_في_كبيرة)
    kernel_print_string(" صفحة صغيرة\n")

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# حجز الصفحات الكبيرة (مثل hugetlbfs)
# ═══════════════════════════════════════════════════════════════════════════════

# حجز عدد من الصفحات الكبيرة لعملية
# تُرجع عدد الصفحات المحجوزة فعلياً
دالة حجز_صفحات_كبيرة(معرف_العملية، عدد_مطلوب)
    kernel_print_string("[صفحات كبيرة] حجز: عملية=")
    kernel_print_number(معرف_العملية)
    kernel_print_string(" عدد=")
    kernel_print_number(عدد_مطلوب)
    kernel_print_string("\n")

    إذا (عدد_حجوزات_نشطة >= ثابت_اقصى_حجوزات)
        kernel_print_string("[صفحات كبيرة] جدول الحجوزات ممتلئ!\n")
        ارجع 0
    نهاية

    # حساب عدد الصفحات المتاحة للحجز
    متغير متاحة = عدد_صفحات_كبيرة_حرة
    متغير محجوزة_فعلياً = 0

    إذا (عدد_مطلوب > متاحة)
        # لا يوجد ما يكفي — نحجز ما هو متاح
