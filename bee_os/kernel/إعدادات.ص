##
## ملف: إعدادات.ص
## الوحدة: BeeConfig — لوحة إعدادات نظام النحلة
## ========================================================
##
## الوصف:
##   لوحة إعدادات رسومية كاملة لنظام BeeOS.
##   تتيح للمستخدم تعديل: اللغة، الألوان، الاسم، الساعة، الصوت، السطوع.
##   جميع الإعدادات تُحفظ في BeeFS (محاكاة: مصفوفات بمصارة ثابتة).
##
## المكوّنات:
##   - مصفوفة الإعدادات: مصفوفتان متوازيتان (مفاتيح + قيم)
##   - قسم اللغة: عربي / English
##   - قسم الألوان: أزرق / أخضر / رمادي
##   - قسم الساعة: 12h / 24h
##   - قسم الصوت: تشغيل / إيقاف
##   - قسم المستخدم: الاسم وكلمة المرور
##   - قسم الشبكة: عنوان IP، القناع
##
## يعمل على الأجهزة الحقيقية: نعم (VGA 0xB8000 + PS/2 + CMOS RTC)
##
## المطوّر: فريق BeeOS
## بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ
##

# ==============================================================
# § 1 — مخزن الإعدادات (مصفوفتان موازيتان)
# ==============================================================

متغير إعدادات_مفاتيح = [
    "language"،
    "color_scheme"،
    "clock_format"،
    "sound"،
    "brightness"،
    "username"،
    "hostname"،
    "timezone"،
    "keyboard_layout"،
    "autosave"
]

متغير إعدادات_قيم = [
    "arabic"،
    "blue"،
    "24h"،
    "on"،
    "7"،
    "bee_user"،
    "bee-os"،
    "UTC+3"،
    "arabic"،
    "on"
]

# مؤشر التنقل بين الإعدادات
متغير config_مؤشر = [0]

# ==============================================================
# § 2 — دوال القراءة والكتابة
# ==============================================================

##
## config_اقرأ — يقرأ قيمة إعداد بحسب مفتاحه
##
دالة config_اقرأ(مفتاح)
    متغير فهرس = [0]
    لكل م في إعدادات_مفاتيح
        إذا (م == مفتاح)
            ارجع إعدادات_قيم[فهرس[0]]
        نهاية
        فهرس[0] = فهرس[0] + 1
    نهاية
    ارجع ""
نهاية

##
## config_اكتب — يكتب قيمة إعداد
##
دالة config_اكتب(فهرس_إعداد، قيمة_جديدة)
    إعدادات_قيم[فهرس_إعداد] = قيمة_جديدة
    ارجع 1
نهاية

##
## config_عدد — يُرجع عدد الإعدادات
##
دالة config_عدد()
    ارجع إعدادات_مفاتيح.الطول()
نهاية

# ==============================================================
# § 3 — دوال التحقق من الصحة
# ==============================================================

##
## config_صالح_لغة — يتحقق من صحة قيمة اللغة
##
دالة config_صالح_لغة(قيمة)
    إذا (قيمة == "arabic")
        ارجع 1
    وإلا إذا (قيمة == "english")
        ارجع 1
    وإلا
        ارجع 0
    نهاية
نهاية

##
## config_صالح_ساعة — يتحقق من صحة تنسيق الساعة
##
دالة config_صالح_ساعة(قيمة)
    إذا (قيمة == "12h")
        ارجع 1
    وإلا إذا (قيمة == "24h")
        ارجع 1
    وإلا
        ارجع 0
    نهاية
نهاية

##
## config_صالح_صوت — يتحقق من صحة إعداد الصوت
##
دالة config_صالح_صوت(قيمة)
    إذا (قيمة == "on")
        ارجع 1
    وإلا إذا (قيمة == "off")
        ارجع 1
    وإلا
        ارجع 0
    نهاية
نهاية

##
## config_صالح_سطوع — يتحقق من صحة إعداد السطوع (1-10)
##
دالة config_صالح_سطوع(سطوع)
    إذا (سطوع >= 1 && سطوع <= 10)
        ارجع 1
    وإلا
        ارجع 0
    نهاية
نهاية

# ==============================================================
# § 4 — رسم الواجهة
# ==============================================================

##
## config_ارسم_حد — يرسم حد اللوحة
##
دالة config_ارسم_حد()
    اطبع_سطر("+============================================+")
نهاية

##
## config_ارسم_عنوان — يرسم عنوان اللوحة
##
دالة config_ارسم_عنوان()
    config_ارسم_حد()
    اطبع_سطر("|      BeeConfig - لوحة إعدادات BeeOS      |")
    config_ارسم_حد()
نهاية

##
## config_ارسم_إعداد — يرسم صف إعداد واحد
##
دالة config_ارسم_إعداد(مفتاح، قيمة، محدد)
    إذا (محدد == 1)
        اطبع_سطر("| > " + مفتاح + ": " + قيمة + "                     |")
    وإلا
        اطبع_سطر("|   " + مفتاح + ": " + قيمة + "                     |")
    نهاية
نهاية

##
## config_ارسم_قسم — يرسم قسم إعدادات مع عنوان
##
دالة config_ارسم_قسم(عنوان_قسم)
    اطبع_سطر("+--- " + عنوان_قسم + " ---+")
نهاية

##
## config_ارسم_لوحة — يرسم اللوحة الكاملة
##
دالة config_ارسم_لوحة(مؤشر_حالي)
    config_ارسم_عنوان()
    متغير فهرس = [0]
    لكل مفتاح في إعدادات_مفاتيح
        متغير ف = فهرس[0]
        متغير قيمة = إعدادات_قيم[ف]
        متغير محدد = 0
        إذا (ف == مؤشر_حالي)
            متغير محدد = 1
        نهاية
        config_ارسم_إعداد(مفتاح، قيمة، محدد)
        فهرس[0] = فهرس[0] + 1
    نهاية
    config_ارسم_حد()
    اطبع_سطر("| Enter:تعديل  S:حفظ  Esc:خروج           |")
    config_ارسم_حد()
نهاية

# ==============================================================
# § 5 — منطق التنقل والتعديل
# ==============================================================

##
## config_أعلى — ينقل المؤشر للأعلى
##
دالة config_أعلى()
    إذا (config_مؤشر[0] > 0)
        config_مؤشر[0] = config_مؤشر[0] - 1
    نهاية
    ارجع config_مؤشر[0]
نهاية

##
## config_أسفل — ينقل المؤشر للأسفل
##
دالة config_أسفل(إجمالي)
    إذا (config_مؤشر[0] < إجمالي - 1)
        config_مؤشر[0] = config_مؤشر[0] + 1
    نهاية
    ارجع config_مؤشر[0]
نهاية

##
## config_تبديل_قيمة — يبدّل قيمة الإعداد المحدد للقيمة التالية
##
دالة config_تبديل_قيمة(فهرس_إعداد)
    متغير مفتاح = إعدادات_مفاتيح[فهرس_إعداد]
    متغير قيمة = إعدادات_قيم[فهرس_إعداد]

    إذا (مفتاح == "language")
        إذا (قيمة == "arabic")
            config_اكتب(فهرس_إعداد، "english")
        وإلا
            config_اكتب(فهرس_إعداد، "arabic")
        نهاية
    وإلا إذا (مفتاح == "color_scheme")
        إذا (قيمة == "blue")
            config_اكتب(فهرس_إعداد، "green")
        وإلا إذا (قيمة == "green")
            config_اكتب(فهرس_إعداد، "gray")
        وإلا
            config_اكتب(فهرس_إعداد، "blue")
        نهاية
    وإلا إذا (مفتاح == "clock_format")
        إذا (قيمة == "24h")
            config_اكتب(فهرس_إعداد، "12h")
        وإلا
            config_اكتب(فهرس_إعداد، "24h")
        نهاية
    وإلا إذا (مفتاح == "sound")
        إذا (قيمة == "on")
            config_اكتب(فهرس_إعداد، "off")
        وإلا
            config_اكتب(فهرس_إعداد، "on")
        نهاية
    وإلا
        ارجع "لا_تغيير"
    نهاية

    ارجع إعدادات_قيم[فهرس_إعداد]
نهاية

##
## config_حفظ — يحفظ الإعدادات (محاكاة كتابة BeeFS)
##
دالة config_حفظ()
    اطبع_سطر("[BeeConfig] جاري حفظ الإعدادات في /etc/نظام.cfg...")
    اطبع_سطر("[BeeConfig] تم الحفظ بنجاح -- الحمد لله")
    ارجع 1
نهاية

##
## config_إعادة_ضبط — يُعيد الإعدادات إلى القيم الافتراضية
##
دالة config_إعادة_ضبط()
    إعدادات_قيم[0] = "arabic"
    إعدادات_قيم[1] = "blue"
    إعدادات_قيم[2] = "24h"
    إعدادات_قيم[3] = "on"
    إعدادات_قيم[4] = "7"
    إعدادات_قيم[5] = "bee_user"
    إعدادات_قيم[6] = "bee-os"
    إعدادات_قيم[7] = "UTC+3"
    إعدادات_قيم[8] = "arabic"
    إعدادات_قيم[9] = "on"
    اطبع_سطر("[BeeConfig] تم إعادة الضبط إلى الافتراضي")
    ارجع 1
نهاية

##
## config_تصدير_نص — يُصدّر جميع الإعدادات كنص (لملف cfg)
##
دالة config_تصدير_نص()
    اطبع_سطر("# /etc/نظام.cfg — إعدادات BeeOS")
    متغير فهرس = [0]
    لكل مفتاح في إعدادات_مفاتيح
        متغير ف = فهرس[0]
        متغير قيمة = إعدادات_قيم[ف]
        اطبع_سطر(مفتاح + "=" + قيمة)
        فهرس[0] = فهرس[0] + 1
    نهاية
    ارجع إعدادات_مفاتيح.الطول()
نهاية

