# ═══════════════════════════════════════════════════════════════════════════════
# إعادة تعيين المتحكم
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ehci_reset(hc_idx)
    ehci_serial_اطبع("[EHCI] Resetting HC #")
    ehci_serial_رقم(hc_idx + 0)
    ehci_serial_سطر()

    # إيقاف المتحكم أولاً
    متغير cmd = ehci_read_op(hc_idx، EHCI_OP_USBCMD) + 0
    # clear RS bit
    متغير new_cmd = cmd - (cmd % 2)
    ehci_write_op(hc_idx، EHCI_OP_USBCMD، new_cmd)

    # انتظار HCH (Halted)
    متغير timeout = 200 + 0
    بينما (timeout > 0)
        متغير sts = ehci_read_op(hc_idx، EHCI_OP_USBSTS) + 0
        متغير halted = (sts / EHCI_STS_HCH) % 2
        إذا (halted == 1)
            timeout = 0
        والا
            timeout = timeout - 1
            متغير w = sad_ll_timer_get_ticks() + 0
            بينما (sad_ll_timer_get_ticks() - w < 100)
                متغير d = 0
            نهاية
        نهاية
    نهاية

    # HC Reset
    ehci_write_op(hc_idx، EHCI_OP_USBCMD، EHCI_CMD_HCRESET)

    # انتظار انتهاء الإعادة
    timeout = 500 + 0
    بينما (timeout > 0)
        cmd = ehci_read_op(hc_idx، EHCI_OP_USBCMD) + 0
        إذا ((cmd / 2) % 2 == 0)  # HCRESET bit cleared
            ehci_serial_اطبع("[EHCI] Reset complete")
            ehci_serial_سطر()
            ارجع 1
        نهاية
        timeout = timeout - 1
        متغير w2 = sad_ll_timer_get_ticks() + 0
        بينما (sad_ll_timer_get_ticks() - w2 < 100)
            متغير d2 = 0
        نهاية
    نهاية

    ehci_serial_اطبع("[EHCI] Reset timeout!")
    ehci_serial_سطر()
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تخصيص qTD (32 بايت، محاذاة 32 بايت)
# ═══════════════════════════════════════════════════════════════════════════════
# qTD Structure (8 DWORDs = 32 bytes):
#   DWORD 0: Next qTD Pointer
#   DWORD 1: Alternate Next qTD Pointer
#   DWORD 2: Token (status, PID, error count, current page, IOC, total bytes, toggle)
#   DWORD 3: Buffer Pointer 0
#   DWORD 4: Buffer Pointer 1
#   DWORD 5: Buffer Pointer 2
#   DWORD 6: Buffer Pointer 3
#   DWORD 7: Buffer Pointer 4

صدّر دالة ehci_alloc_qtd(hc_idx)
    متغير used = 0 + 0
    إذا (hc_idx == 0) used = ehci_qtd_used_0 + 0 نهاية
    إذا (hc_idx == 1) used = ehci_qtd_used_1 + 0 نهاية
    إذا (hc_idx == 2) used = ehci_qtd_used_2 + 0 نهاية
    إذا (hc_idx == 3) used = ehci_qtd_used_3 + 0 نهاية

    إذا (used >= 32)
        ارجع 0
    نهاية

    متغير pool = ehci_get_qtd_pool(hc_idx) + 0
    متغير qtd = pool + (used * 32)

    # Clear
    sad_ll_mem_write32(qtd، 1)        # next = terminate
    sad_ll_mem_write32(qtd + 4، 1)    # alt next = terminate
    sad_ll_mem_write32(qtd + 8، 0)    # token
    sad_ll_mem_write32(qtd + 12، 0)   # buf0
    sad_ll_mem_write32(qtd + 16، 0)   # buf1
    sad_ll_mem_write32(qtd + 20، 0)   # buf2
    sad_ll_mem_write32(qtd + 24، 0)   # buf3
    sad_ll_mem_write32(qtd + 28، 0)   # buf4

    إذا (hc_idx == 0) ehci_qtd_used_0 = used + 1 نهاية
    إذا (hc_idx == 1) ehci_qtd_used_1 = used + 1 نهاية
    إذا (hc_idx == 2) ehci_qtd_used_2 = used + 1 نهاية
    إذا (hc_idx == 3) ehci_qtd_used_3 = used + 1 نهاية

    ارجع qtd + 0
نهاية

صدّر دالة ehci_reset_qtd_pool(hc_idx)
    إذا (hc_idx == 0) ehci_qtd_used_0 = 0 نهاية
    إذا (hc_idx == 1) ehci_qtd_used_1 = 0 نهاية
    إذا (hc_idx == 2) ehci_qtd_used_2 = 0 نهاية
    إذا (hc_idx == 3) ehci_qtd_used_3 = 0 نهاية
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# بناء qTD
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ehci_qtd_set_next(qtd، next_qtd، terminate)
    إذا (terminate == 1)
        sad_ll_mem_write32(qtd، 1)
    والا
        sad_ll_mem_write32(qtd، next_qtd + 0)
    نهاية
    ارجع 0
نهاية

صدّر دالة ehci_qtd_set_token(qtd، pid_code، total_bytes، toggle، cerr، ioc)
    # Token (DWORD 2):
    # bits 0-7:   Status (bit 7=Active)
    # bits 8-9:   PID (0=OUT, 1=IN, 2=SETUP)
    # bits 10-11: Error Counter (CERR)
    # bits 12-14: Current Page (0)
    # bit 15:     IOC
    # bits 16-30: Total Bytes to Transfer
    # bit 31:     Data Toggle
    متغير token = EHCI_QTD_ACTIVE  # bit 7 = active
    token = token + pid_code         # bits 8-9
    token = token + (cerr * 1024)    # bits 10-11 (0x400)
    إذا (ioc == 1)
        token = token + 32768        # bit 15 = 0x8000
    نهاية
    token = token + (total_bytes * 65536)  # bits 16-30
    إذا (toggle == 1)
        token = token + EHCI_QTD_TOGGLE    # bit 31
    نهاية
    sad_ll_mem_write32(qtd + 8، token)
    ارجع 0
نهاية

صدّر دالة ehci_qtd_set_buffer(qtd، buf_phys)
    sad_ll_mem_write32(qtd + 12، buf_phys + 0)  # Buffer Page 0
    # For buffers crossing page boundaries, set buf1-4
    # Simple implementation: assume buffer doesn't cross 4K
    ارجع 0
نهاية

صدّر دالة ehci_qtd_get_token(qtd)
    ارجع sad_ll_mem_read32(qtd + 8) + 0
نهاية

صدّر دالة ehci_qtd_is_active(qtd)
    متغير token = ehci_qtd_get_token(qtd) + 0
    متغير active = (token / EHCI_QTD_ACTIVE) % 2  # bit 7
    ارجع active + 0
نهاية

صدّر دالة ehci_qtd_has_error(qtd)
    متغير token = ehci_qtd_get_token(qtd) + 0
    متغير halted = (token / EHCI_QTD_HALTED) % 2
    متغير dbuf = (token / EHCI_QTD_DBUF_ERR) % 2
    متغير babble = (token / EHCI_QTD_BABBLE) % 2
    متغير xact = (token / EHCI_QTD_XACT_ERR) % 2
    إذا (halted + dbuf + babble + xact > 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة ehci_qtd_actual_len(qtd)
    متغير token = ehci_qtd_get_token(qtd) + 0
    # bits 16-30 = total bytes remaining
    متغير remaining = (token / 65536) % 32768  # 15 bits
    ارجع remaining + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تخصيص QH (48 بايت، محاذاة 32 بايت) 
# ═══════════════════════════════════════════════════════════════════════════════
# QH Structure:
#   DWORD 0:  Queue Head Horizontal Link Pointer
#   DWORD 1:  Endpoint Characteristics
#   DWORD 2:  Endpoint Capabilities
#   DWORD 3:  Current qTD Pointer
#   DWORD 4:  Next qTD Pointer (overlay)
#   DWORD 5:  Alternate Next qTD (overlay)
#   DWORD 6:  Token (overlay)
#   DWORD 7:  Buffer Page 0 (overlay)
#   DWORD 8:  Buffer Page 1 (overlay)
#   DWORD 9:  Buffer Page 2 (overlay)
#   DWORD 10: Buffer Page 3 (overlay)
#   DWORD 11: Buffer Page 4 (overlay)

صدّر دالة ehci_alloc_qh(hc_idx)
    متغير used = 0 + 0
    إذا (hc_idx == 0) used = ehci_qh_used_0 + 0 نهاية
    إذا (hc_idx == 1) used = ehci_qh_used_1 + 0 نهاية
    إذا (hc_idx == 2) used = ehci_qh_used_2 + 0 نهاية
    إذا (hc_idx == 3) used = ehci_qh_used_3 + 0 نهاية

    إذا (used >= 16)
        ارجع 0
    نهاية

    متغير pool = ehci_get_qh_pool(hc_idx) + 0
    متغير قه = pool + (used * 64)  # 64-byte aligned QHs

    # Clear 48 bytes
    sad_ll_memset(قه، 0، 64)
    sad_ll_mem_write32(قه، 1)       # terminate
    sad_ll_mem_write32(قه + 16، 1)  # next qTD = terminate

    إذا (hc_idx == 0) ehci_qh_used_0 = used + 1 نهاية
    إذا (hc_idx == 1) ehci_qh_used_1 = used + 1 نهاية
    إذا (hc_idx == 2) ehci_qh_used_2 = used + 1 نهاية
    إذا (hc_idx == 3) ehci_qh_used_3 = used + 1 نهاية

    ارجع قه + 0
نهاية

صدّر دالة ehci_qh_setup(قه، dev_addr، endpoint، max_pkt، speed، is_head)
    # DWORD 1: Endpoint Characteristics
    متغير chars = dev_addr + 0                # bits 0-6
    chars = chars + (endpoint * 256)           # bits 8-11 (shift 8)
    
    إذا (speed == 2)  # High speed
        chars = chars + EHCI_QH_EPS_HIGH
    والا_اذا (speed == 0)  # Low speed
        chars = chars + EHCI_QH_EPS_LOW
    والا   # Full speed
        chars = chars + EHCI_QH_EPS_FULL
    نهاية

    chars = chars + EHCI_QH_DTC             # Data Toggle from qTD
    chars = chars + (max_pkt * 65536)       # bits 16-26 (shift 16)

    إذا (endpoint == 0)
        chars = chars + EHCI_QH_C_BIT       # Control endpoint flag
    نهاية

    إذا (is_head == 1)
        chars = chars + EHCI_QH_H_BIT       # Head of Reclamation
    نهاية

    # NAK reload = 15
    chars = chars + (15 * 268435456)         # bits 28-31 (0x10000000)

    sad_ll_mem_write32(قه + 4، chars)

    # DWORD 2: Endpoint Capabilities  
    # For high-speed: mult=1 (bits 30-31)
    متغير caps = 1073741824  # 0x40000000 = mult=1
    # Hub/port for split transactions (full/low speed behind TT)
    إذا (speed != 2)
        # S-mask = 1 (bit 0 of byte = micro-frame 0)
        caps = caps + 1
        # C-mask = 0x1C (bits 8-15) 
        caps = caps + 7168  # 0x1C00
    نهاية
    sad_ll_mem_write32(قه + 8، caps)

    ارجع 0
نهاية

صدّر دالة ehci_qh_link_qtd(قه، first_qtd)
    # DWORD 4: Next qTD Pointer (in overlay area)
    sad_ll_mem_write32(قه + 16، first_qtd + 0)
    # Clear overlay token
    sad_ll_mem_write32(قه + 24، 0)
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إعادة تعيين منفذ EHCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ehci_port_reset(hc_idx، port_num)
    ehci_serial_اطبع("[EHCI] Port reset HC#")
    ehci_serial_رقم(hc_idx + 0)
    ehci_serial_اطبع(" port ")
    ehci_serial_رقم(port_num + 0)
    ehci_serial_سطر()

    ehci_port_resets = ehci_port_resets + 1

    متغير sc = ehci_read_port(hc_idx، port_num) + 0

    # تعيين Port Reset + Port Power
    متغير new_sc = EHCI_PORT_RESET + EHCI_PORT_PP
    ehci_write_port(hc_idx، port_num، new_sc)

    # انتظار 50ms
    متغير wait = sad_ll_timer_get_ticks() + 0
    بينما (sad_ll_timer_get_ticks() - wait < 5000)
        متغير d = 0
    نهاية

    # إزالة Reset bit
    sc = ehci_read_port(hc_idx، port_num) + 0
    new_sc = sc - (sc % 512)  # clear bit 8 (reset) and below
    new_sc = new_sc + EHCI_PORT_PP + EHCI_PORT_ENABLE
    ehci_write_port(hc_idx، port_num، EHCI_PORT_PP)

    # انتظار Reset complete
    متغير timeout = 200 + 0
    بينما (timeout > 0)
        sc = ehci_read_port(hc_idx، port_num) + 0
        متغير reset_bit = (sc / EHCI_PORT_RESET) % 2
        إذا (reset_bit == 0)
            timeout = 0
        والا
            timeout = timeout - 1
            متغير w = sad_ll_timer_get_ticks() + 0
            بينما (sad_ll_timer_get_ticks() - w < 100)
                متغير d2 = 0
            نهاية
        نهاية
    نهاية

    # قراءة الحالة النهائية
    sc = ehci_read_port(hc_idx، port_num) + 0
    متغير connected = sc % 2
    متغير enabled = (sc / EHCI_PORT_ENABLE) % 2
    متغير owner = (sc / EHCI_PORT_OWNER) % 2
    متغير line_status = (sc / 1024) % 4  # bits 10-11

    ehci_serial_اطبع("[EHCI] Port: conn=")
    ehci_serial_رقم(connected + 0)
    ehci_serial_اطبع(" en=")
    ehci_serial_رقم(enabled + 0)
    ehci_serial_اطبع(" owner=")
    ehci_serial_رقم(owner + 0)
    ehci_serial_اطبع(" LS=")
    ehci_serial_رقم(line_status + 0)
    ehci_serial_سطر()

    # إذا المنفذ غير مفعل → جهاز low/full speed → route to companion
    إذا (connected == 1)
        إذا (enabled == 0)
            ehci_serial_اطبع("[EHCI] Non-HS device, routing to companion")
            ehci_serial_سطر()
            ehci_write_port(hc_idx، port_num، EHCI_PORT_OWNER + EHCI_PORT_PP)
            ehci_companion_routes = ehci_companion_routes + 1
            ارجع 0
        نهاية
    نهاية

    # Clear CSC
    إذا ((sc / EHCI_PORT_CSC) % 2 == 1)
        ehci_write_port(hc_idx، port_num، EHCI_PORT_PP + EHCI_PORT_CSC)
    نهاية

    ارجع connected + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# نقل تحكم عبر EHCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ehci_control_transfer(hc_idx، dev_addr، setup_buf، data_buf، data_len، is_read)
    ehci_total_transfers = ehci_total_transfers + 1
    ehci_reset_qtd_pool(hc_idx)

    # ─── qTD SETUP ───
    متغير qtd_setup = ehci_alloc_qtd(hc_idx) + 0
    إذا (qtd_setup == 0)
        ehci_transfer_errors = ehci_transfer_errors + 1
        ارجع 0 - 1
    نهاية

    ehci_qtd_set_token(qtd_setup، EHCI_QTD_PID_SETUP، 8، 0، 3، 0)
    ehci_qtd_set_buffer(qtd_setup، setup_buf)

    # ─── qTD DATA ───
    متغير qtd_data_first = 0 + 0
    متغير qtd_data_last = 0 + 0
    متغير toggle = 1 + 0
    متغير remaining = data_len + 0
    متغير offset = 0 + 0

    متغير pid = EHCI_QTD_PID_IN + 0
    إذا (is_read == 0)
        pid = EHCI_QTD_PID_OUT + 0
    نهاية

    بينما (remaining > 0)
        متغير qtd_data = ehci_alloc_qtd(hc_idx) + 0
        إذا (qtd_data == 0)
            ehci_transfer_errors = ehci_transfer_errors + 1
            ارجع 0 - 1
        نهاية

        إذا (qtd_data_first == 0)
            qtd_data_first = qtd_data + 0
        نهاية
        إذا (qtd_data_last != 0)
            ehci_qtd_set_next(qtd_data_last، qtd_data، 0)
        نهاية

        متغير pkt = remaining + 0
        إذا (pkt > 512)
            pkt = 512
        نهاية

        ehci_qtd_set_token(qtd_data، pid، pkt، toggle، 3، 0)
        ehci_qtd_set_buffer(qtd_data، data_buf + offset)

        qtd_data_last = qtd_data + 0
        offset = offset + pkt
        remaining = remaining - pkt
        toggle = 1 - toggle
    نهاية

    # ─── qTD STATUS ───
    متغير qtd_status = ehci_alloc_qtd(hc_idx) + 0
    إذا (qtd_status == 0)
        ehci_transfer_errors = ehci_transfer_errors + 1
        ارجع 0 - 1
    نهاية

    متغير status_pid = EHCI_QTD_PID_OUT + 0
    إذا (is_read == 0)
        status_pid = EHCI_QTD_PID_IN + 0
    نهاية

    ehci_qtd_set_token(qtd_status، status_pid، 0، 1، 3، 1)  # IOC=1
    ehci_qtd_set_next(qtd_status، 0، 1)  # terminate

    # ─── ربط السلسلة ───
    إذا (qtd_data_first != 0)
        ehci_qtd_set_next(qtd_setup، qtd_data_first، 0)
        ehci_qtd_set_next(qtd_data_last، qtd_status، 0)
    والا
        ehci_qtd_set_next(qtd_setup، qtd_status، 0)
    نهاية

    # ─── QH Setup ───
    متغير async_qh = ehci_get_async_qh(hc_idx) + 0
    ehci_qh_setup(async_qh، dev_addr، 0، 64، 2، 1)  # HS, head
    # Point QH to itself (circular)
    sad_ll_mem_write32(async_qh، async_qh + 2)  # type=QH
    # Link qTDs
    ehci_qh_link_qtd(async_qh، qtd_setup)

    # ─── Set Async List Address ───
    ehci_write_op(hc_idx، EHCI_OP_ASYNCLIST، async_qh)

    # ─── Enable Async Schedule ───
    متغير cmd = ehci_read_op(hc_idx، EHCI_OP_USBCMD) + 0
    ehci_write_op(hc_idx، EHCI_OP_USBCMD، cmd + EHCI_CMD_ASE + EHCI_CMD_RS)

    # ─── Wait for completion ───
    متغير timeout = 50000 + 0
    بينما (timeout > 0)
        إذا (ehci_qtd_is_active(qtd_status) == 0)
            # Disable async schedule
            cmd = ehci_read_op(hc_idx، EHCI_OP_USBCMD) + 0
            متغير new_cmd = cmd - EHCI_CMD_ASE
            إذا (new_cmd < 0)
                new_cmd = cmd + 0
            نهاية
            ehci_write_op(hc_idx، EHCI_OP_USBCMD، new_cmd)

            # Check errors
            إذا (ehci_qtd_has_error(qtd_setup) == 1)
                ehci_serial_اطبع("[EHCI] SETUP qTD error")
                ehci_serial_سطر()
                ehci_transfer_errors = ehci_transfer_errors + 1
                ارجع 0 - 2
            نهاية

            إذا (ehci_qtd_has_error(qtd_status) == 1)
                ehci_serial_اطبع("[EHCI] STATUS qTD error")
                ehci_serial_سطر()
                ehci_transfer_errors = ehci_transfer_errors + 1
                ارجع 0 - 3
            نهاية

            # Calculate actual transferred
            متغير total = 0 + 0
            إذا (qtd_data_first != 0)
                متغير cq = qtd_data_first + 0
                متغير cc = 0
                بينما (cc < 32)
                    إذا (ehci_qtd_has_error(cq) == 1)
                        ehci_transfer_errors = ehci_transfer_errors + 1
                        ارجع 0 - 4
                    نهاية
                    متغير rem = ehci_qtd_actual_len(cq) + 0
                    # total bytes = requested - remaining
                    إذا (cq == qtd_data_last)
                        cc = 32
                    والا
                        cq = cq + 32
                        cc = cc + 1
                    نهاية
                نهاية
                total = data_len + 0  # simplified
            نهاية

            ارجع total + 0
        نهاية
        timeout = timeout - 1
    نهاية

    # Timeout
    cmd = ehci_read_op(hc_idx، EHCI_OP_USBCMD) + 0
    ehci_write_op(hc_idx، EHCI_OP_USBCMD، cmd - EHCI_CMD_ASE)
    ehci_serial_اطبع("[EHCI] Transfer timeout!")
    ehci_serial_سطر()
    ehci_transfer_errors = ehci_transfer_errors + 1
    ارجع 0 - 5
نهاية

