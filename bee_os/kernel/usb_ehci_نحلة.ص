# ═══════════════════════════════════════════════════════════════════════════════
# فحص المنافذ
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ehci_scan_ports(hc_idx)
    متغير num_ports = ehci_get_num_ports(hc_idx) + 0
    ehci_serial_اطبع("[EHCI] Scanning ")
    ehci_serial_رقم(num_ports + 0)
    ehci_serial_اطبع(" ports on HC#")
    ehci_serial_رقم(hc_idx + 0)
    ehci_serial_سطر()

    متغير devices_found = 0 + 0
    متغير p = 0 + 0
    بينما (p < num_ports)
        إذا (p >= 8)
            p = num_ports  # limit to 8 ports
        والا
            متغير sc = ehci_read_port(hc_idx، p) + 0
            متغير connected = sc % 2

            إذا (connected == 1)
                ehci_serial_اطبع("[EHCI] Port ")
                ehci_serial_رقم(p + 0)
                ehci_serial_اطبع(": device connected")
                ehci_serial_سطر()

                متغير result = ehci_port_reset(hc_idx، p) + 0
                إذا (result > 0)
                    # Device is high-speed, enumerate
                    متغير dev_idx = usb_register_device(hc_idx، p، 2) + 0
                    إذا (dev_idx >= 0)
                        # Get device descriptor
                        متغير data_buf = ehci_get_data_buf(hc_idx) + 0
                        sad_ll_memset(data_buf، 0، 64)
                        متغير res = ehci_get_device_descriptor(hc_idx، 0، data_buf، 8) + 0
                        إذا (res >= 0)
                            متغير new_addr = dev_idx + 1
                            ehci_set_address(hc_idx، 0، new_addr)

                            متغير wait = sad_ll_timer_get_ticks() + 0
                            بينما (sad_ll_timer_get_ticks() - wait < 200)
                                متغير d = 0
                            نهاية

                            sad_ll_memset(data_buf، 0، 64)
                            res = ehci_get_device_descriptor(hc_idx، new_addr، data_buf، 18) + 0
                            إذا (res >= 0)
                                usb_parse_device_descriptor(data_buf، dev_idx)
                            نهاية

                            ehci_set_configuration(hc_idx، new_addr، 1)
                            usb_classify_device(dev_idx)
                            devices_found = devices_found + 1
                        نهاية
                    نهاية
                نهاية
            والا
                ehci_serial_اطبع("[EHCI] Port ")
                ehci_serial_رقم(p + 0)
                ehci_serial_اطبع(": no device")
                ehci_serial_سطر()
            نهاية
            p = p + 1
        نهاية
    نهاية

    ehci_serial_اطبع("[EHCI] Found ")
    ehci_serial_رقم(devices_found + 0)
    ehci_serial_اطبع(" HS device(s)")
    ehci_serial_سطر()
    ارجع devices_found + 0
نهاية

