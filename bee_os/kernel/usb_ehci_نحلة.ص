# ═══════════════════════════════════════════════════════════════════════════════
# تهيئة EHCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ehci_هيئ(hc_idx، mmio_base)
    ehci_serial_اطبع("[EHCI] تهيئة EHCI HC#")
    ehci_serial_رقم(hc_idx + 0)
    ehci_serial_اطبع(" MMIO=0x")
    ehci_serial_hex16(mmio_base / 65536)
    ehci_serial_hex16(mmio_base % 65536)
    ehci_serial_سطر()

    إذا (ehci_count >= 4)
        ehci_serial_اطبع("[EHCI] Max controllers reached!")
        ehci_serial_سطر()
        ارجع 0
    نهاية

    # حفظ MMIO base
    إذا (hc_idx == 0) ehci_mmio_0 = mmio_base + 0 نهاية
    إذا (hc_idx == 1) ehci_mmio_1 = mmio_base + 0 نهاية
    إذا (hc_idx == 2) ehci_mmio_2 = mmio_base + 0 نهاية
    إذا (hc_idx == 3) ehci_mmio_3 = mmio_base + 0 نهاية

    # قراءة CAPLENGTH
    متغير caplength = sad_ll_mem_read8(mmio_base) + 0
    متغير opbase = mmio_base + caplength

    إذا (hc_idx == 0) ehci_opbase_0 = opbase + 0 نهاية
    إذا (hc_idx == 1) ehci_opbase_1 = opbase + 0 نهاية
    إذا (hc_idx == 2) ehci_opbase_2 = opbase + 0 نهاية
    إذا (hc_idx == 3) ehci_opbase_3 = opbase + 0 نهاية

    ehci_serial_اطبع("[EHCI] CAPLENGTH=")
    ehci_serial_رقم(caplength + 0)
    ehci_serial_سطر()

    # قراءة HCSPARAMS
    متغير hcsparams = ehci_read_cap(hc_idx، EHCI_CAP_HCSPARAMS) + 0
    متغير num_ports = hcsparams % 16  # bits 0-3

    إذا (hc_idx == 0) ehci_num_ports_0 = num_ports + 0 نهاية
    إذا (hc_idx == 1) ehci_num_ports_1 = num_ports + 0 نهاية
    إذا (hc_idx == 2) ehci_num_ports_2 = num_ports + 0 نهاية
    إذا (hc_idx == 3) ehci_num_ports_3 = num_ports + 0 نهاية

    ehci_serial_اطبع("[EHCI] Ports: ")
    ehci_serial_رقم(num_ports + 0)
    ehci_serial_سطر()

    # HCCPARAMS
    متغير hccparams = ehci_read_cap(hc_idx، EHCI_CAP_HCCPARAMS) + 0
    متغير eecp = (hccparams / 256) % 256  # EECP bits 8-15
    ehci_serial_اطبع("[EHCI] EECP=0x")
    ehci_serial_hex8(eecp + 0)
    ehci_serial_سطر()

    # إعادة تعيين
    ehci_reset(hc_idx)

    # تخصيص ذاكرة
    # Periodic Frame List: 1024 * 4 = 4096
    متغير periodic = sad_ll_kmalloc(4096) + 0
    إذا (hc_idx == 0) ehci_periodic_0 = periodic + 0 نهاية
    إذا (hc_idx == 1) ehci_periodic_1 = periodic + 0 نهاية
    إذا (hc_idx == 2) ehci_periodic_2 = periodic + 0 نهاية
    إذا (hc_idx == 3) ehci_periodic_3 = periodic + 0 نهاية

    # تهيئة Periodic list = all terminate
    متغير i = 0 + 0
    بينما (i < 1024)
        sad_ll_mem_write32(periodic + (i * 4)، 1)
        i = i + 1
    نهاية

    # QH Pool: 16 * 64 = 1024
    متغير qhp = sad_ll_kmalloc(1024) + 0
    إذا (hc_idx == 0) ehci_qh_pool_0 = qhp + 0 نهاية
    إذا (hc_idx == 1) ehci_qh_pool_1 = qhp + 0 نهاية
    إذا (hc_idx == 2) ehci_qh_pool_2 = qhp + 0 نهاية
    إذا (hc_idx == 3) ehci_qh_pool_3 = qhp + 0 نهاية
    sad_ll_memset(qhp، 0، 1024)

    # qTD Pool: 32 * 32 = 1024
    متغير qtdp = sad_ll_kmalloc(1024) + 0
    إذا (hc_idx == 0) ehci_qtd_pool_0 = qtdp + 0 نهاية
    إذا (hc_idx == 1) ehci_qtd_pool_1 = qtdp + 0 نهاية
    إذا (hc_idx == 2) ehci_qtd_pool_2 = qtdp + 0 نهاية
    إذا (hc_idx == 3) ehci_qtd_pool_3 = qtdp + 0 نهاية
    sad_ll_memset(qtdp، 0، 1024)

    # Data buffer
    متغير dbuf = sad_ll_kmalloc(1024) + 0
    إذا (hc_idx == 0) ehci_data_buf_0 = dbuf + 0 نهاية
    إذا (hc_idx == 1) ehci_data_buf_1 = dbuf + 0 نهاية
    إذا (hc_idx == 2) ehci_data_buf_2 = dbuf + 0 نهاية
    إذا (hc_idx == 3) ehci_data_buf_3 = dbuf + 0 نهاية

    # Setup buffer
    متغير sbuf = sad_ll_kmalloc(32) + 0
    إذا (hc_idx == 0) ehci_setup_buf_0 = sbuf + 0 نهاية
    إذا (hc_idx == 1) ehci_setup_buf_1 = sbuf + 0 نهاية
    إذا (hc_idx == 2) ehci_setup_buf_2 = sbuf + 0 نهاية
    إذا (hc_idx == 3) ehci_setup_buf_3 = sbuf + 0 نهاية

    # Async QH (head of reclamation)
    متغير aqh = ehci_alloc_qh(hc_idx) + 0
    إذا (hc_idx == 0) ehci_async_qh_0 = aqh + 0 نهاية
    إذا (hc_idx == 1) ehci_async_qh_1 = aqh + 0 نهاية
    إذا (hc_idx == 2) ehci_async_qh_2 = aqh + 0 نهاية
    إذا (hc_idx == 3) ehci_async_qh_3 = aqh + 0 نهاية

    # Point async QH to itself
    sad_ll_mem_write32(aqh، aqh + 2)  # QH type=2

    # Set up operational registers
    ehci_write_op(hc_idx، EHCI_OP_USBINTR، 7)  # enable USB, Error, PCD interrupts
    ehci_write_op(hc_idx، EHCI_OP_PERIODICLIST، periodic)
    ehci_write_op(hc_idx، EHCI_OP_ASYNCLIST، aqh)
    ehci_write_op(hc_idx، EHCI_OP_CTRLDSSEG، 0)  # 32-bit mode
    ehci_write_op(hc_idx، EHCI_OP_FRINDEX، 0)

    # Set CF=1 (configure flag, take ownership from companion)
    ehci_write_op(hc_idx، EHCI_OP_CONFIGFLAG، 1)

    # Start the controller
    متغير cmd = EHCI_CMD_RS + EHCI_CMD_ITC_1
    ehci_write_op(hc_idx، EHCI_OP_USBCMD، cmd)

    # انتظار التشغيل
    متغير wait = sad_ll_timer_get_ticks() + 0
    بينما (sad_ll_timer_get_ticks() - wait < 500)
        متغير d = 0
    نهاية

    # التحقق من أن المتحكم يعمل
    متغير sts = ehci_read_op(hc_idx، EHCI_OP_USBSTS) + 0
    متغير halted = (sts / EHCI_STS_HCH) % 2
    إذا (halted == 0)
        ehci_serial_اطبع("[EHCI] Controller running")
        ehci_serial_سطر()
        إذا (hc_idx == 0) ehci_status_0 = 2 نهاية
        إذا (hc_idx == 1) ehci_status_1 = 2 نهاية
        إذا (hc_idx == 2) ehci_status_2 = 2 نهاية
        إذا (hc_idx == 3) ehci_status_3 = 2 نهاية
    والا
        ehci_serial_اطبع("[EHCI] Controller still halted!")
        ehci_serial_سطر()
        إذا (hc_idx == 0) ehci_status_0 = 1 نهاية
        إذا (hc_idx == 1) ehci_status_1 = 1 نهاية
        إذا (hc_idx == 2) ehci_status_2 = 1 نهاية
        إذا (hc_idx == 3) ehci_status_3 = 1 نهاية
    نهاية

    ehci_count = ehci_count + 1

    # Power on ports
    متغير p = 0 + 0
    بينما (p < num_ports)
        إذا (p < 8)
            ehci_write_port(hc_idx، p، EHCI_PORT_PP)
        نهاية
        p = p + 1
    نهاية

    # Wait for port power stabilization
    متغير wait2 = sad_ll_timer_get_ticks() + 0
    بينما (sad_ll_timer_get_ticks() - wait2 < 2000)
        متغير d2 = 0
    نهاية

    # Scan ports
    ehci_scan_ports(hc_idx)

    ehci_serial_اطبع("[EHCI] تهيئة مكتملة")
    ehci_serial_سطر()
    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# دورة EHCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ehci_دورة()
    متغير i = 0 + 0
    بينما (i < ehci_count)
        # فحص Port Change Detect
        متغير sts = ehci_read_op(i، EHCI_OP_USBSTS) + 0
        إذا ((sts / EHCI_STS_PCD) % 2 == 1)
            ehci_serial_اطبع("[EHCI] Port change HC#")
            ehci_serial_رقم(i + 0)
            ehci_serial_سطر()
            ehci_write_op(i، EHCI_OP_USBSTS، EHCI_STS_PCD)  # Clear
        نهاية

        # فحص Host System Error
        إذا ((sts / EHCI_STS_HSE) % 2 == 1)
            ehci_serial_اطبع("[EHCI] Host System Error HC#")
            ehci_serial_رقم(i + 0)
            ehci_serial_سطر()
            ehci_write_op(i، EHCI_OP_USBSTS، EHCI_STS_HSE)
        نهاية

        i = i + 1
    نهاية
    ارجع 0
نهاية
