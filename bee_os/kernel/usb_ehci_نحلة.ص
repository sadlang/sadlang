# ═══════════════════════════════════════════════════════════════════════════════
# ثوابت EHCI
# ═══════════════════════════════════════════════════════════════════════════════
ثابت COM1 = 1016

# ─── Capability Registers (read from MMIO base) ───
ثابت EHCI_CAP_CAPLENGTH   = 0      # 0x00 - Length of Cap Regs (8-bit)
ثابت EHCI_CAP_HCIVERSION  = 2      # 0x02 - Version (16-bit)
ثابت EHCI_CAP_HCSPARAMS   = 4      # 0x04 - Structural Parameters (32-bit)
ثابت EHCI_CAP_HCCPARAMS   = 8      # 0x08 - Capability Parameters (32-bit)

# ─── Operational Registers (offset = CAPLENGTH from MMIO base) ───
ثابت EHCI_OP_USBCMD       = 0      # 0x00 - USB Command
ثابت EHCI_OP_USBSTS       = 4      # 0x04 - USB Status
ثابت EHCI_OP_USBINTR      = 8      # 0x08 - USB Interrupt Enable
ثابت EHCI_OP_FRINDEX       = 12     # 0x0C - Frame Index
ثابت EHCI_OP_CTRLDSSEG     = 16     # 0x10 - 4G Segment Selector
ثابت EHCI_OP_PERIODICLIST   = 20     # 0x14 - Periodic Frame List Base
ثابت EHCI_OP_ASYNCLIST     = 24     # 0x18 - Async List Address
ثابت EHCI_OP_CONFIGFLAG    = 64     # 0x40 - Config Flag
ثابت EHCI_OP_PORTSC_BASE   = 68     # 0x44 - Port Status/Control (base for port 0)

# USBCMD bits
ثابت EHCI_CMD_RS           = 1      # Run/Stop
ثابت EHCI_CMD_HCRESET      = 2      # HC Reset
ثابت EHCI_CMD_FLS_1024     = 0      # Frame List Size = 1024
ثابت EHCI_CMD_FLS_512      = 4      # Frame List Size = 512
ثابت EHCI_CMD_FLS_256      = 8      # Frame List Size = 256
ثابت EHCI_CMD_PSE          = 16     # 0x10 Periodic Schedule Enable
ثابت EHCI_CMD_ASE          = 32     # 0x20 Async Schedule Enable
ثابت EHCI_CMD_IAAD         = 64     # 0x40 Interrupt on Async Advance Doorbell
ثابت EHCI_CMD_ITC_1        = 65536  # 0x10000 Interrupt Threshold = 1 micro-frame

# USBSTS bits
ثابت EHCI_STS_USBINT       = 1      # USB Interrupt
ثابت EHCI_STS_USBERR       = 2      # USB Error
ثابت EHCI_STS_PCD          = 4      # Port Change Detect
ثابت EHCI_STS_FLR          = 8      # Frame List Rollover
ثابت EHCI_STS_HSE          = 16     # 0x10 Host System Error
ثابت EHCI_STS_IAA          = 32     # 0x20 Interrupt on Async Advance
ثابت EHCI_STS_HCH          = 4096   # 0x1000 HC Halted
ثابت EHCI_STS_RECL         = 8192   # 0x2000 Reclamation
ثابت EHCI_STS_PSS          = 16384  # 0x4000 Periodic Schedule Status
ثابت EHCI_STS_ASS          = 32768  # 0x8000 Async Schedule Status

# PORTSC bits
ثابت EHCI_PORT_CONNECT     = 1      # Current Connect Status
ثابت EHCI_PORT_CSC         = 2      # Connect Status Change
ثابت EHCI_PORT_ENABLE      = 4      # Port Enable
ثابت EHCI_PORT_ENC         = 8      # Port Enable Change
ثابت EHCI_PORT_OCA         = 16     # 0x10 Over-current Active
ثابت EHCI_PORT_OCC         = 32     # 0x20 Over-current Change
ثابت EHCI_PORT_FPR         = 64     # 0x40 Force Port Resume
ثابت EHCI_PORT_SUSPEND     = 128    # 0x80 Suspend
ثابت EHCI_PORT_RESET       = 256    # 0x100 Port Reset
ثابت EHCI_PORT_LS_MASK     = 3072   # 0xC00 Line Status (bits 10-11)
ثابت EHCI_PORT_PP          = 4096   # 0x1000 Port Power
ثابت EHCI_PORT_OWNER       = 8192   # 0x2000 Port Owner (1=companion)
ثابت EHCI_PORT_PIC_OFF     = 0      # Port Indicator Off
ثابت EHCI_PORT_PIC_AMBER   = 16384  # 0x4000
ثابت EHCI_PORT_PIC_GREEN   = 32768  # 0x8000

# QH Endpoint characteristics
ثابت EHCI_QH_RL_SHIFT    = 28     # NAK count reload, bits 28-31
ثابت EHCI_QH_C_BIT       = 134217728   # 0x08000000 bit 27 control endpoint
ثابت EHCI_QH_MAX_PKT_SHIFT = 16   # bits 16-26
ثابت EHCI_QH_H_BIT       = 32768  # 0x8000 Head of Reclamation
ثابت EHCI_QH_DTC         = 16384  # 0x4000 Data Toggle Control
ثابت EHCI_QH_EPS_FULL    = 0      # bits 12-13 = 00 Full Speed
ثابت EHCI_QH_EPS_LOW     = 4096   # 0x1000
ثابت EHCI_QH_EPS_HIGH    = 8192   # 0x2000
ثابت EHCI_QH_EP_SHIFT    = 8      # bits 8-11: endpoint
ثابت EHCI_QH_INACT       = 128    # 0x80 Inactivate on Next
ثابت EHCI_QH_ADDR_MASK   = 127    # bits 0-6: device address

# qTD Token bits
ثابت EHCI_QTD_ACTIVE     = 128     # 0x80 bit 7
ثابت EHCI_QTD_HALTED     = 64      # 0x40 bit 6
ثابت EHCI_QTD_DBUF_ERR   = 32      # 0x20 bit 5
ثابت EHCI_QTD_BABBLE     = 16      # 0x10 bit 4
ثابت EHCI_QTD_XACT_ERR   = 8       # bit 3
ثابت EHCI_QTD_MISS_MF    = 4       # bit 2
ثابت EHCI_QTD_SPLIT_XS   = 2       # bit 1
ثابت EHCI_QTD_PING       = 1       # bit 0

# qTD PID codes (bits 8-9)
ثابت EHCI_QTD_PID_OUT    = 0        # 0x00 bits 8-9
ثابت EHCI_QTD_PID_IN     = 256      # 0x100
ثابت EHCI_QTD_PID_SETUP  = 512      # 0x200

# qTD Toggle
ثابت EHCI_QTD_TOGGLE     = 2147483648  # 0x80000000 bit 31

