## قراءة سجل PCI Configuration
دالة pci_اقرأ(bus، dev، فنك، offset)
    # بناء عنوان PCI Config
    # bit 31 = enable, bits 23:16 = bus, bits 15:11 = device, bits 10:8 = function, bits 7:0 = offset
    متغير عنوان = 0
    عنوان = عنوان + 2147483648  # bit 31 (0x80000000)
    عنوان = عنوان + (bus * 65536)     # bits 23:16
    عنوان = عنوان + (dev * 2048)      # bits 15:11
    عنوان = عنوان + (فنك * 256)      # bits 10:8
    عنوان = عنوان + (offset % 256)    # bits 7:0 (aligned to 4)
    
    sad_ll_port_outl(PCI_CONFIG_ADDR، عنوان)
    ارجع sad_ll_port_inl(PCI_CONFIG_DATA) + 0
نهاية

## كتابة سجل PCI Configuration
دالة pci_اكتب(bus، dev، فنك، offset، قيمة)
    متغير عنوان = 0
    عنوان = عنوان + 2147483648
    عنوان = عنوان + (bus * 65536)
    عنوان = عنوان + (dev * 2048)
    عنوان = عنوان + (فنك * 256)
    عنوان = عنوان + (offset % 256)
    
    sad_ll_port_outl(PCI_CONFIG_ADDR، عنوان)
    sad_ll_port_outl(PCI_CONFIG_DATA، قيمة)
    ارجع 0
نهاية

## البحث عن PCI PM Capability
دالة pci_ابحث_pm_cap(bus، dev، فنك)
    # قراءة Status Register (offset 0x06) — بت 4 = Capabilities List
    متغير status_cmd = pci_اقرأ(bus، dev، فنك، 4) + 0
    متغير status = (status_cmd / 65536) % 65536
    
    إذا ((status / 16) % 2 == 0)
        # لا يدعم Capabilities
        ارجع 0
    نهاية
    
    # قراءة Capabilities Pointer (offset 0x34)
    متغير cap_ptr = pci_اقرأ(bus، dev، فنك، 52) + 0
    cap_ptr = cap_ptr % 256   # byte 0 only
    
    # تجول في القائمة المتسلسلة
    متغير حد = 0
    بينما (cap_ptr > 0)
        إذا (حد > 48)
            ارجع 0   # حماية من حلقة لا نهائية
        نهاية
        
        متغير cap_hdr = pci_اقرأ(bus، dev، فنك، cap_ptr) + 0
        متغير cap_id = cap_hdr % 256
        
        # PM Capability ID = 0x01
        إذا (cap_id == 1)
            ارجع cap_ptr
        نهاية
        
        # التالي
        cap_ptr = (cap_hdr / 256) % 256
        حد = حد + 1
    نهاية
    
    ارجع 0
نهاية

## تعيين حالة طاقة PCI
دالة pci_عين_d_state(bus، dev، فنك، pm_cap، d_state)
    إذا (pm_cap == 0)
        ارجع 0
    نهاية
    
    # قراءة PM Control/Status (pm_cap + 4)
    متغير pm_ctrl = pci_اقرأ(bus، dev، فنك، pm_cap + PCI_PM_CTRL) + 0
    
    # مسح بتات D-state (bits 1:0) وتعيين الجديد
    pm_ctrl = pm_ctrl - (pm_ctrl % 4)   # مسح bits 1:0
    
    إذا (d_state == D0_نشط)
        # bits 1:0 = 00
    نهاية
    إذا (d_state == D1_خمول)
        pm_ctrl = pm_ctrl + 1
    نهاية
    إذا (d_state == D2_خمول_عميق)
        pm_ctrl = pm_ctrl + 2
    نهاية
    إذا (d_state == D3_ساخن)
        pm_ctrl = pm_ctrl + 3
