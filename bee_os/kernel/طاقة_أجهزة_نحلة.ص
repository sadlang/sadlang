## تعيين وضع DPMS
صدّر دالة dpms_عين(وضع)
    إذا (وضع == dpms_حالي)
        ارجع 0
    نهاية
    
    dpms_حالي = وضع + 0
    
    dp_serial_اطبع("[DP] DPMS → ")
    إذا (وضع == DPMS_ON)
        dp_serial_اطبع("ON\n")
        # تشغيل BGA
        sad_ll_port_outw(BGA_INDEX، BGA_REG_ENABLE)
        متغير val = sad_ll_port_inw(BGA_DATA) + 0
        val = val + 1  # enable bit
        sad_ll_port_outw(BGA_DATA، val)
    نهاية
    إذا (وضع == DPMS_STANDBY)
        dp_serial_اطبع("STANDBY\n")
        # VGA Sequencer: Clock Mode → Screen off
        sad_ll_port_outb(VGA_SEQ_INDEX، 1)
        متغير seq = sad_ll_port_inb(VGA_SEQ_DATA) + 0
        seq = seq + 32  # bit 5 = screen off
        sad_ll_port_outb(VGA_SEQ_DATA، seq)
    نهاية
    إذا (وضع == DPMS_SUSPEND)
        dp_serial_اطبع("SUSPEND\n")
        sad_ll_port_outb(VGA_SEQ_INDEX، 1)
        متغير seq_s = sad_ll_port_inb(VGA_SEQ_DATA) + 0
        seq_s = seq_s + 32
        sad_ll_port_outb(VGA_SEQ_DATA، seq_s)
    نهاية
    إذا (وضع == DPMS_OFF)
        dp_serial_اطبع("OFF\n")
        # إيقاف BGA
        sad_ll_port_outw(BGA_INDEX، BGA_REG_ENABLE)
        sad_ll_port_outw(BGA_DATA، 0)
    نهاية
    
    # تحديث حالة جهاز الشاشة
    إذا (وضع == DPMS_ON)
        جهاز_2_حال_طاقة = D0_نشط + 0
    نهاية
    إذا (وضع == DPMS_STANDBY)
        جهاز_2_حال_طاقة = D1_خمول + 0
    نهاية
    إذا (وضع == DPMS_SUSPEND)
        جهاز_2_حال_طاقة = D2_خمول_عميق + 0
    نهاية
    إذا (وضع == DPMS_OFF)
        جهاز_2_حال_طاقة = D3_ساخن + 0
    نهاية
    
    ارجع 1
نهاية

