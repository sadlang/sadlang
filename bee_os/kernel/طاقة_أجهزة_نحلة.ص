## تقدير طاقة جهاز بناءً على نوعه وحالته
دالة dp_قدر_طاقة_جهاز(نوع_ج، d_state)
    # طاقة D0 الأساسية حسب النوع (mW)
    متغير طاقة_d0 = 0
    إذا (نوع_ج == نوع_معالج)
        طاقة_d0 = 65000
    نهاية
    إذا (نوع_ج == نوع_gpu)
        طاقة_d0 = 75000
    نهاية
    إذا (نوع_ج == نوع_شاشة)
        طاقة_d0 = 15000
    نهاية
    إذا (نوع_ج == نوع_تخزين)
        طاقة_d0 = 5000
    نهاية
    إذا (نوع_ج == نوع_شبكة)
        طاقة_d0 = 3000
    نهاية
    إذا (نوع_ج == نوع_usb)
        طاقة_d0 = 2500
    نهاية
    إذا (نوع_ج == نوع_صوت)
        طاقة_d0 = 1000
    نهاية
    
    # تخفيض حسب D-state
    إذا (d_state == D0_نشط)
        ارجع طاقة_d0
    نهاية
    إذا (d_state == D1_خمول)
        ارجع طاقة_d0 / 2
    نهاية
    إذا (d_state == D2_خمول_عميق)
        ارجع طاقة_d0 / 10
    نهاية
    إذا (d_state == D3_ساخن)
        ارجع طاقة_d0 / 100
    نهاية
    إذا (d_state == D3_بارد)
        ارجع 0
    نهاية
    ارجع طاقة_d0
نهاية

## حساب إجمالي طاقة الأجهزة
دالة dp_احسب_إجمالي_الطاقة()
    إجمالي_طاقة_أجهزة_mw = 0
    
    جهاز_0_طاقة_mw = dp_قدر_طاقة_جهاز(جهاز_0_نوع، جهاز_0_حال_طاقة) + 0
    جهاز_1_طاقة_mw = dp_قدر_طاقة_جهاز(جهاز_1_نوع، جهاز_1_حال_طاقة) + 0
    جهاز_2_طاقة_mw = dp_قدر_طاقة_جهاز(جهاز_2_نوع، جهاز_2_حال_طاقة) + 0
    جهاز_3_طاقة_mw = dp_قدر_طاقة_جهاز(جهاز_3_نوع، جهاز_3_حال_طاقة) + 0
    جهاز_4_طاقة_mw = dp_قدر_طاقة_جهاز(جهاز_4_نوع، جهاز_4_حال_طاقة) + 0
    جهاز_5_طاقة_mw = dp_قدر_طاقة_جهاز(جهاز_5_نوع، جهاز_5_حال_طاقة) + 0
    جهاز_6_طاقة_mw = dp_قدر_طاقة_جهاز(جهاز_6_نوع، جهاز_6_حال_طاقة) + 0
    
    إجمالي_طاقة_أجهزة_mw = جهاز_0_طاقة_mw + جهاز_1_طاقة_mw + جهاز_2_طاقة_mw + جهاز_3_طاقة_mw + جهاز_4_طاقة_mw + جهاز_5_طاقة_mw + جهاز_6_طاقة_mw
    
    ارجع إجمالي_طاقة_أجهزة_mw
نهاية

