دالة dp_serial_اطبع(رسالة)
    متغير ط = 0
    بينما (ط < طول(رسالة))
        sad_ll_serial_write_char(COM1، رمز(رسالة[ط]))
        ط = ط + 1
    نهاية
نهاية

دالة dp_serial_رقم(ن)
    إذا (ن == 0)
        sad_ll_serial_write_char(COM1، 48)
        ارجع 0
    نهاية
    متغير سالب = 0
    متغير قيمة_ن = ن + 0
    إذا (قيمة_ن < 0)
        سالب = 1
        قيمة_ن = 0 - قيمة_ن
    نهاية
    متغير خانات = 0
    متغير ارقام_0 = 0
    متغير ارقام_1 = 0
    متغير ارقام_2 = 0
    متغير ارقام_3 = 0
    متغير ارقام_4 = 0
    متغير ارقام_5 = 0
    متغير ارقام_6 = 0
    متغير ارقام_7 = 0
    
    بينما (قيمة_ن > 0)
        متغير باقي_ق = قيمة_ن % 10
        إذا (خانات == 0)
            ارقام_0 = باقي_ق
        نهاية
        إذا (خانات == 1)
            ارقام_1 = باقي_ق
        نهاية
        إذا (خانات == 2)
            ارقام_2 = باقي_ق
        نهاية
        إذا (خانات == 3)
            ارقام_3 = باقي_ق
        نهاية
        إذا (خانات == 4)
            ارقام_4 = باقي_ق
        نهاية
        إذا (خانات == 5)
            ارقام_5 = باقي_ق
        نهاية
        إذا (خانات == 6)
            ارقام_6 = باقي_ق
        نهاية
        إذا (خانات == 7)
            ارقام_7 = باقي_ق
        نهاية
        قيمة_ن = (قيمة_ن - باقي_ق) / 10
        خانات = خانات + 1
    نهاية
    إذا (سالب == 1)
        sad_ll_serial_write_char(COM1، 45)
    نهاية
    متغير ع = خانات - 1
    بينما (ع >= 0)
        متغير رق = 0
        إذا (ع == 0)
            رق = ارقام_0
        نهاية
        إذا (ع == 1)
            رق = ارقام_1
        نهاية
        إذا (ع == 2)
            رق = ارقام_2
        نهاية
        إذا (ع == 3)
            رق = ارقام_3
        نهاية
        إذا (ع == 4)
            رق = ارقام_4
        نهاية
        إذا (ع == 5)
            رق = ارقام_5
        نهاية
        إذا (ع == 6)
            رق = ارقام_6
        نهاية
        إذا (ع == 7)
            رق = ارقام_7
        نهاية
        sad_ll_serial_write_char(COM1، 48 + رق)
        ع = ع - 1
    نهاية
    ارجع 0
نهاية

دالة dp_serial_hex(ن)
    sad_ll_serial_write_char(COM1، 48)
    sad_ll_serial_write_char(COM1، 120)
    متغير تم_طبع = 0
    متغير ي = 28
    بينما (ي >= 0)
        متغير رباعي = 0
        إذا (ي == 28)
            رباعي = (ن / 268435456) % 16
        نهاية
        إذا (ي == 24)
            رباعي = (ن / 16777216) % 16
        نهاية
        إذا (ي == 20)
            رباعي = (ن / 1048576) % 16
        نهاية
        إذا (ي == 16)
            رباعي = (ن / 65536) % 16
        نهاية
        إذا (ي == 12)
            رباعي = (ن / 4096) % 16
        نهاية
        إذا (ي == 8)
            رباعي = (ن / 256) % 16
        نهاية
        إذا (ي == 4)
            رباعي = (ن / 16) % 16
        نهاية
        إذا (ي == 0)
            رباعي = ن % 16
        نهاية
        إذا (رباعي > 0)
            تم_طبع = 1
        نهاية
        إذا (تم_طبع == 1)
            إذا (رباعي < 10)
                sad_ll_serial_write_char(COM1، 48 + رباعي)
            نهاية
            إذا (رباعي >= 10)
                sad_ll_serial_write_char(COM1، 55 + رباعي)  # 'A'=65, 65-10=55
            نهاية
        نهاية
        ي = ي - 4
    نهاية
    إذا (تم_طبع == 0)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    ارجع 0
نهاية

