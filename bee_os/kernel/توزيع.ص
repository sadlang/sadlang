# =======================================================
# BeeOS توزيع.ص — نظام ملفات BeeFS الموزّع P2P
# Decentralized File System for BeeOS Nodes
# بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ
# =======================================================

# ── جدول العقد (Parallel Arrays) ──────────────────────
متغير عقد_عناوين = []
متغير عقد_منافذ  = []
متغير عقد_حالات  = []
متغير عقد_أسماء  = []
متغير عقد_عدد    = [0]

# ── جدول الملفات الموزّعة ─────────────────────────────
متغير ملفات_أسماء  = []
متغير ملفات_أحجام  = []
متغير ملفات_أصحاب  = []
متغير ملفات_هاشات  = []
متغير ملفات_متاح   = []
متغير ملفات_عدد    = [0]

# ── طلبات المزامنة المعلّقة ──────────────────────────
متغير طلبات_ملفات  = []
متغير طلبات_هدف    = []
متغير طلبات_حالة   = []
متغير طلبات_عدد    = [0]

# ══════════════════════════════════════════════
# دوال إدارة العقد
# ══════════════════════════════════════════════

دالة توزيع_أضف_عقدة(عنوان، منفذ، اسم)
    أضف(عقد_عناوين, عنوان)
    أضف(عقد_منافذ,  منفذ)
    أضف(عقد_حالات,  "متصل")
    أضف(عقد_أسماء,  اسم)
    عقد_عدد[0] = عقد_عدد[0] + 1
    اطبع_سطر("[BeeNet] عقدة جديدة: " + اسم + " @ " + عنوان + ":" + منفذ)
    ارجع عقد_عدد[0]
نهاية

دالة توزيع_ابحث_عقدة(عنوان)
    متغير فهرس_عقدة = -1
    لكل عنوان_حالي في عقد_عناوين
        متغير ك = فهرس_عقدة
        إذا (عنوان_حالي == عنوان && فهرس_عقدة == -1)
            فهرس_عقدة = ك + 1
        نهاية
    نهاية
    ارجع فهرس_عقدة
نهاية

دالة توزيع_حالة_الشبكة()
    اطبع_سطر("[BeeNet] ══════ حالة الشبكة الموزّعة ══════")
    اطبع_سطر("[BeeNet] عدد العقد المتصلة: " + عقد_عدد[0])
    متغير عداد_شبكة = [0]
    لكل اسم_عقدة في عقد_أسماء
        متغير رقم_عقدة = عداد_شبكة[0]
        اطبع_سطر("  [" + رقم_عقدة + "] " + اسم_عقدة + " — " + عقد_حالات[رقم_عقدة] + " — " + عقد_عناوين[رقم_عقدة])
        عداد_شبكة[0] = عداد_شبكة[0] + 1
    نهاية
    ارجع عقد_عدد[0]
نهاية

# ══════════════════════════════════════════════
# دوال إدارة الملفات الموزّعة
# ══════════════════════════════════════════════

دالة توزيع_أضف_ملف(اسم_ملف، حجم_ملف، صاحب_ملف، هاش_ملف)
    أضف(ملفات_أسماء, اسم_ملف)
    أضف(ملفات_أحجام, حجم_ملف)
    أضف(ملفات_أصحاب, صاحب_ملف)
    أضف(ملفات_هاشات, هاش_ملف)
    أضف(ملفات_متاح,  "نعم")
    ملفات_عدد[0] = ملفات_عدد[0] + 1
    ارجع ملفات_عدد[0]
نهاية

دالة توزيع_ابحث_ملف(اسم_بحث)
    متغير نتيجة_بحث = -1
    متغير عداد_بحث = [0]
    لكل اسم_حالي في ملفات_أسماء
        متغير رقم_ملف_بحث = عداد_بحث[0]
        إذا (اسم_حالي == اسم_بحث && نتيجة_بحث == -1)
            نتيجة_بحث = رقم_ملف_بحث
        نهاية
        عداد_بحث[0] = عداد_بحث[0] + 1
    نهاية
    ارجع نتيجة_بحث
نهاية

دالة توزيع_قائمة_ملفات()
    اطبع_سطر("[BeeFS] ══════ الملفات الموزّعة ══════")
    اطبع_سطر("[BeeFS] إجمالي الملفات: " + ملفات_عدد[0])
    متغير عداد_ملفات = [0]
    لكل اسم_ملف_حالي في ملفات_أسماء
        متغير رقم_ملف_حالي = عداد_ملفات[0]
        اطبع_سطر("  " + رقم_ملف_حالي + ": " + اسم_ملف_حالي + " (" + ملفات_أحجام[رقم_ملف_حالي] + "B) من " + ملفات_أصحاب[رقم_ملف_حالي])
        عداد_ملفات[0] = عداد_ملفات[0] + 1
    نهاية
    ارجع ملفات_عدد[0]
نهاية

# ══════════════════════════════════════════════
# بروتوكول التزامن P2P
# ══════════════════════════════════════════════

دالة توزيع_طلب_ملف(اسم_ملف_طلب، عنوان_هدف)
    متغير فهرس_ملف_طلب = توزيع_ابحث_ملف(اسم_ملف_طلب)
    إذا (فهرس_ملف_طلب == -1)
        اطبع_سطر("[BeeSync] ✗ الملف غير موجود: " + اسم_ملف_طلب)
        ارجع 0
    نهاية
    أضف(طلبات_ملفات, اسم_ملف_طلب)
    أضف(طلبات_هدف,   عنوان_هدف)
    أضف(طلبات_حالة,  "قيد_التحميل")
    طلبات_عدد[0] = طلبات_عدد[0] + 1
    اطبع_سطر("[BeeSync] ▶ طلب تحميل: " + اسم_ملف_طلب + " من " + عنوان_هدف)
    اطبع_سطر("[BeeSync]   الحجم: " + ملفات_أحجام[فهرس_ملف_طلب] + "B | الهاش: " + ملفات_هاشات[فهرس_ملف_طلب])
    ارجع طلبات_عدد[0]
نهاية

دالة توزيع_أكمل_طلبات()
    متغير عداد_طلبات = [0]
    متغير مُكمَل = [0]
    لكل اسم_طلب في طلبات_ملفات
        متغير رقم_طلب = عداد_طلبات[0]
        إذا (طلبات_حالة[رقم_طلب] == "قيد_التحميل")
            طلبات_حالة[رقم_طلب] = "مكتمل"
            مُكمَل[0] = مُكمَل[0] + 1
            اطبع_سطر("[BeeSync] ✓ اكتمل: " + اسم_طلب + " → " + طلبات_هدف[رقم_طلب])
        نهاية
        عداد_طلبات[0] = عداد_طلبات[0] + 1
    نهاية
    اطبع_سطر("[BeeSync] ✓ اكتملت " + مُكمَل[0] + "/" + طلبات_عدد[0] + " طلبات")
    ارجع مُكمَل[0]
نهاية

دالة توزيع_مزامنة_شاملة()
    اطبع_سطر("[BeeSync] ═══ بدء المزامنة الشاملة ═══")
    اطبع_سطر("[BeeSync] ▶ إرسال جدول الملفات لجميع العقد...")
    متغير عداد_مزامنة = [0]
    لكل اسم_عقدة_مزامنة في عقد_أسماء
        اطبع_سطر("[BeeSync]   → " + اسم_عقدة_مزامنة + ": " + ملفات_عدد[0] + " ملف")
        عداد_مزامنة[0] = عداد_مزامنة[0] + 1
    نهاية
    اطبع_سطر("[BeeSync] ✓ المزامنة اكتملت لـ " + عداد_مزامنة[0] + " عقدة")
    ارجع عداد_مزامنة[0]
نهاية

# ══════════════════════════════════════════════
# اختبارات توزيع.ص
# ══════════════════════════════════════════════

دالة اختبار_تسجيل_العقد()
    اطبع_سطر("=== اختبار 1: تسجيل العقد ===")
    متغير نتيجة_عقد1 = توزيع_أضف_عقدة("192.168.1.10", "8500", "BeeNode-A")
    متغير نتيجة_عقد2 = توزيع_أضف_عقدة("192.168.1.11", "8500", "BeeNode-B")
    متغير نتيجة_عقد3 = توزيع_أضف_عقدة("192.168.1.12", "8500", "BeeNode-C")
    متغير نتيجة_عقد4 = توزيع_أضف_عقدة("10.0.0.5",     "8500", "BeeNode-D")
    إذا (عقد_عدد[0] == 4)
        اطبع_سطر("[نجح] 4 عقد مسجّلة بنجاح")
        ارجع 1
    نهاية
    اطبع_سطر("[فشل] عدد العقد خاطئ: " + عقد_عدد[0])
    ارجع 0
نهاية

دالة اختبار_إضافة_ملفات()
    اطبع_سطر("=== اختبار 2: إضافة الملفات الموزّعة ===")
    متغير نتيجة_ف1 = توزيع_أضف_ملف("القرآن_الكريم.pdf",  "15728640", "192.168.1.10", "a1b2c3d4")
    متغير نتيجة_ف2 = توزيع_أضف_ملف("قاموس_عربي.db",      "5242880",  "192.168.1.11", "e5f6g7h8")
    متغير نتيجة_ف3 = توزيع_أضف_ملف("beeos_kernel.elf",    "26624",    "192.168.1.10", "i9j0k1l2")
    متغير نتيجة_ف4 = توزيع_أضف_ملف("fonts_arabic.ttf",    "2097152",  "192.168.1.12", "m3n4o5p6")
    متغير نتيجة_ف5 = توزيع_أضف_ملف("hadith_bukhari.txt",  "8388608",  "10.0.0.5",     "q7r8s9t0")
    متغير نتيجة_ف6 = توزيع_أضف_ملف("بيانات_المستخدمين",  "1048576",  "192.168.1.10", "u1v2w3x4")
    إذا (ملفات_عدد[0] == 6)
        اطبع_سطر("[نجح] 6 ملفات موزّعة مُسجَّلة")
        ارجع 1
    نهاية
    اطبع_سطر("[فشل] عدد الملفات خاطئ: " + ملفات_عدد[0])
    ارجع 0
نهاية

دالة اختبار_البحث_الموزّع()
    اطبع_سطر("=== اختبار 3: البحث الموزّع ===")
    متغير فهرس_بحث1 = توزيع_ابحث_ملف("beeos_kernel.elf")
    متغير فهرس_بحث2 = توزيع_ابحث_ملف("ملف_غير_موجود.xyz")
    إذا (فهرس_بحث1 == 2 && فهرس_بحث2 == -1)
        اطبع_سطر("[نجح] البحث الموزّع صحيح (وُجد=2، غير موجود=-1)")
        ارجع 1
    نهاية
    اطبع_سطر("[فشل] فهرس البحث خاطئ: " + فهرس_بحث1 + " / " + فهرس_بحث2)
    ارجع 0
نهاية

دالة اختبار_طلبات_التحميل()
    اطبع_سطر("=== اختبار 4: طلبات التحميل P2P ===")
    متغير نتيجة_طلب1 = توزيع_طلب_ملف("القرآن_الكريم.pdf", "192.168.1.11")
    متغير نتيجة_طلب2 = توزيع_طلب_ملف("fonts_arabic.ttf",  "192.168.1.10")
    متغير نتيجة_طلب3 = توزيع_طلب_ملف("ملف_غير_موجود",     "192.168.1.10")
    إذا (طلبات_عدد[0] == 2)
        اطبع_سطر("[نجح] طلبان صالحان + طلب واحد مرفوض")
        ارجع 1
    نهاية
    اطبع_سطر("[فشل] عدد الطلبات خاطئ: " + طلبات_عدد[0])
    ارجع 0
نهاية

دالة اختبار_إكمال_الطلبات()
    اطبع_سطر("=== اختبار 5: إكمال الطلبات ===")
    متغير مكتمل_طلبات = توزيع_أكمل_طلبات()
    إذا (مكتمل_طلبات == 2)
        اطبع_سطر("[نجح] اكتمل " + مكتمل_طلبات + " طلب بنجاح")
        ارجع 1
    نهاية
    اطبع_سطر("[فشل] عدد المُكمَلات خاطئ: " + مكتمل_طلبات)
    ارجع 0
نهاية

دالة اختبار_المزامنة_الشاملة()
    اطبع_سطر("=== اختبار 6: المزامنة الشاملة ===")
    متغير نتيجة_مزامنة = توزيع_مزامنة_شاملة()
    إذا (نتيجة_مزامنة == 4)
        اطبع_سطر("[نجح] مُزامِن مع 4 عقد")
        ارجع 1
    نهاية
    اطبع_سطر("[فشل] عدد العقد المُزامَن معها: " + نتيجة_مزامنة)
    ارجع 0
نهاية

دالة اختبار_إحصاءات_الشبكة()
    اطبع_سطر("=== اختبار 7: إحصاءات الشبكة الموزّعة ===")
    متغير عدد_عقد_النتيجة    = توزيع_حالة_الشبكة()
    متغير عدد_ملفات_النتيجة  = توزيع_قائمة_ملفات()
    إذا (عدد_عقد_النتيجة == 4 && عدد_ملفات_النتيجة == 6)
        اطبع_سطر("[نجح] 4 عقد + 6 ملفات موزّعة")
        ارجع 1
    نهاية
    اطبع_سطر("[فشل] إحصاءات: عقد=" + عدد_عقد_النتيجة + " ملف=" + عدد_ملفات_النتيجة)
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# نقطة الدخول الرئيسية
# ══════════════════════════════════════════════
اطبع_سطر("╔══════════════════════════════════╗")
اطبع_سطر("║  BeeOS توزيع.ص — BeeFS P2P      ║")
اطبع_سطر("║  نظام الملفات اللامركزي          ║")
اطبع_سطر("╚══════════════════════════════════╝")
اطبع_سطر("")

متغير ن1 = اختبار_تسجيل_العقد()
اطبع_سطر("")
متغير ن2 = اختبار_إضافة_ملفات()
اطبع_سطر("")
متغير ن3 = اختبار_البحث_الموزّع()
اطبع_سطر("")
متغير ن4 = اختبار_طلبات_التحميل()
اطبع_سطر("")
متغير ن5 = اختبار_إكمال_الطلبات()
اطبع_سطر("")
متغير ن6 = اختبار_المزامنة_الشاملة()
اطبع_سطر("")
متغير ن7 = اختبار_إحصاءات_الشبكة()
اطبع_سطر("")

متغير نجاح_توزيع = ن1 + ن2 + ن3 + ن4 + ن5 + ن6 + ن7
اطبع_سطر("══════════════════════════════════════")
إذا (نجاح_توزيع == 7)
    اطبع_سطر("✅ الحمد لله — توزيع.ص يعمل بنجاح!")
    اطبع_سطر("   BeeFS P2P: " + نجاح_توزيع + "/7 اختبارات نجحت")
    اطبع_سطر("   الشبكة: " + عقد_عدد[0] + " عقد، " + ملفات_عدد[0] + " ملف")
وإلا
    اطبع_سطر("⚠️  " + نجاح_توزيع + "/7 اختبارات نجحت")
نهاية
اطبع_سطر("══════════════════════════════════════")
