# ═══════════════════════════════════════════════════════════════════════════════
# طلبات USB Hub Class
# ═══════════════════════════════════════════════════════════════════════════════

# GET HUB DESCRIPTOR
صدّر دالة hub_get_descriptor(hub_idx)
    إذا (hub_get_active(hub_idx) == 0) ارجع 0 - 1 نهاية

    متغير hc = hub_get_hc(hub_idx) + 0
    متغير addr = hub_get_addr(hub_idx) + 0

    # Setup: GET_DESCRIPTOR (Class, Device-to-Host)
    # bmRequestType=0xA0, bRequest=6, wValue=0x2900 (Hub descriptor), wIndex=0, wLength=8
    متغير wValue = HUB_DESC_TYPE * 256   # 0x29 << 8 = 0x2900

    usb_build_setup(hub_setup_buf، HUB_REQ_TYPE_GET، GET_DESCRIPTOR، wValue، 0، 8)

    sad_ll_memset(hub_data_buf، 0، 16)
    متغير result = uhci_control_transfer(hc، addr، hub_setup_buf، hub_data_buf، 8) + 0

    إذا (result >= 0)
        # Parse Hub Descriptor
        # Byte 0: bDescLength
        # Byte 1: bDescriptorType (0x29)
        # Byte 2: bNbrPorts
        # Byte 3-4: wHubCharacteristics
        # Byte 5: bPwrOn2PwrGood (in 2ms intervals)
        # Byte 6: bHubContrCurrent

        متغير num_ports = sad_ll_mem_read8(hub_data_buf + 2) + 0
        متغير pwr_delay = sad_ll_mem_read8(hub_data_buf + 5) + 0

        إذا (num_ports > MAX_PORTS_PER_HUB) num_ports = MAX_PORTS_PER_HUB نهاية

        hub_set_num_ports(hub_idx، num_ports)
        hub_set_pwr_delay(hub_idx، pwr_delay)

        hub_serial_اطبع("[HUB] Hub #")
        hub_serial_رقم(hub_idx + 0)
        hub_serial_اطبع(" ports=")
        hub_serial_رقم(num_ports + 0)
        hub_serial_اطبع(" pwr_delay=")
        hub_serial_رقم(pwr_delay * 2)
        hub_serial_اطبع("ms")
        hub_serial_سطر()
    والا
        hub_errors = hub_errors + 1
    نهاية

    ارجع result + 0
نهاية

# GET PORT STATUS
صدّر دالة hub_get_port_status(hub_idx، port)
    إذا (hub_get_active(hub_idx) == 0) ارجع 0 - 1 نهاية

    متغير hc = hub_get_hc(hub_idx) + 0
    متغير addr = hub_get_addr(hub_idx) + 0

    # bmRequestType=0xA3, bRequest=0 (GET_STATUS), wValue=0, wIndex=port, wLength=4
    usb_build_setup(hub_setup_buf، PORT_REQ_TYPE_GET، GET_STATUS، 0، port، 4)

    sad_ll_memset(hub_data_buf، 0، 4)
    متغير result = uhci_control_transfer(hc، addr، hub_setup_buf، hub_data_buf، 4) + 0

    إذا (result >= 0)
        # Port Status (2 bytes, little-endian) + Port Change (2 bytes)
        متغير status_lo = sad_ll_mem_read8(hub_data_buf) + 0
        متغير status_hi = sad_ll_mem_read8(hub_data_buf + 1) + 0
        متغير change_lo = sad_ll_mem_read8(hub_data_buf + 2) + 0
        متغير port_status = status_lo + (status_hi * 256)
        متغير port_change = change_lo + 0

        ارجع port_status + (port_change * 65536)
    نهاية

    hub_errors = hub_errors + 1
    ارجع 0 - 1
نهاية

# SET PORT FEATURE
صدّر دالة hub_set_port_feature(hub_idx، port، feature)
    إذا (hub_get_active(hub_idx) == 0) ارجع 0 - 1 نهاية

    متغير hc = hub_get_hc(hub_idx) + 0
    متغير addr = hub_get_addr(hub_idx) + 0

    usb_build_setup(hub_setup_buf، PORT_REQ_TYPE_SET، SET_FEATURE، feature، port، 0)
    متغير result = uhci_control_transfer(hc، addr، hub_setup_buf، 0، 0) + 0
    ارجع result + 0
نهاية

# CLEAR PORT FEATURE
صدّر دالة hub_clear_port_feature(hub_idx، port، feature)
    إذا (hub_get_active(hub_idx) == 0) ارجع 0 - 1 نهاية

    متغير hc = hub_get_hc(hub_idx) + 0
    متغير addr = hub_get_addr(hub_idx) + 0

    usb_build_setup(hub_setup_buf، PORT_REQ_TYPE_CLR، CLEAR_FEATURE، feature، port، 0)
    متغير result = uhci_control_transfer(hc، addr، hub_setup_buf، 0، 0) + 0
    ارجع result + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تشغيل طاقة المنافذ
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة hub_power_on_ports(hub_idx)
    إذا (hub_get_active(hub_idx) == 0) ارجع 0 - 1 نهاية

    متغير num_ports = hub_get_num_ports(hub_idx) + 0
    متغير pwr_delay = hub_get_pwr_delay(hub_idx) + 0

    hub_serial_اطبع("[HUB] Powering on ")
    hub_serial_رقم(num_ports + 0)
    hub_serial_اطبع(" ports on hub #")
    hub_serial_رقم(hub_idx + 0)
    hub_serial_سطر()

    متغير p = 1 + 0  # USB ports start at 1
    بينما (p <= num_ports)
        hub_set_port_feature(hub_idx، p، PORT_POWER)
        p = p + 1
    نهاية

    # انتظار استقرار الطاقة
    # pwr_delay × 2ms, use timer ticks
    متغير wait_ticks = pwr_delay * 2 + 10
    متغير start = sad_ll_timer_get_ticks() + 0
    بينما ((sad_ll_timer_get_ticks() - start) < wait_ticks)
        # انتظار
    نهاية

    hub_serial_اطبع("[HUB] All ports powered on")
    hub_serial_سطر()
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إعادة تعيين منفذ
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة hub_port_reset(hub_idx، port)
    hub_serial_اطبع("[HUB] Resetting port ")
    hub_serial_رقم(port + 0)
    hub_serial_اطبع(" on hub #")
    hub_serial_رقم(hub_idx + 0)
    hub_serial_سطر()

    # Set PORT_RESET feature
    hub_set_port_feature(hub_idx، port، PORT_RESET)

    # انتظار اكتمال إعادة التعيين (تحقق من C_PORT_RESET)
    متغير timeout = 100 + 0
    متغير reset_done = 0 + 0

    بينما (timeout > 0)
        متغير status_change = hub_get_port_status(hub_idx، port) + 0
        إذا (status_change < 0)
            hub_errors = hub_errors + 1
            ارجع 0 - 1
        نهاية

        # Change bits are in upper 16 bits
        متغير change = status_change / 65536
        إذا ((change / PORT_CHANGE_RESET) % 2 == 1)
            reset_done = 1
            اخرج
        نهاية

        timeout = timeout - 1
    نهاية

    إذا (reset_done == 0)
        hub_serial_اطبع("[HUB] Port reset timeout")
        hub_serial_سطر()
        ارجع 0 - 2
    نهاية

    # مسح علم التغيير
    hub_clear_port_feature(hub_idx، port، C_PORT_RESET)

    hub_serial_اطبع("[HUB] Port ")
    hub_serial_رقم(port + 0)
    hub_serial_اطبع(" reset complete")
    hub_serial_سطر()

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# معالجة توصيل جهاز جديد
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة hub_handle_attach(hub_idx، port)
    hub_serial_اطبع("[HUB] Device attached hub #")
    hub_serial_رقم(hub_idx + 0)
    hub_serial_اطبع(" port ")
    hub_serial_رقم(port + 0)
    hub_serial_سطر()

    # إعادة تعيين المنفذ
    متغير reset_result = hub_port_reset(hub_idx، port) + 0
    إذا (reset_result < 0)
        ارجع 0 - 1
    نهاية

    # قراءة الحالة لمعرفة السرعة
    متغير status = hub_get_port_status(hub_idx، port) + 0
    إذا (status < 0) ارجع 0 - 2 نهاية

    متغير port_status = status % 65536

    متغير speed = 1     # full speed افتراضي
    إذا ((port_status / PORT_STATUS_LOW_SPEED) % 2 == 1)
        speed = 0     # low speed
    نهاية
    إذا ((port_status / PORT_STATUS_HIGH_SPEED) % 2 == 1)
        speed = 2     # high speed
    نهاية

    # تسجيل الجهاز في USB Core
    متغير hc = hub_get_hc(hub_idx) + 0
    متغير new_dev = usb_register_device(hc، port، speed، 0، 0، 0، 0) + 0
    إذا (new_dev >= 0)
        hub_set_port_dev(hub_idx، port - 1، new_dev + 1)
        hub_attach_count = hub_attach_count + 1

        hub_serial_اطبع("[HUB] Registered device #")
        hub_serial_رقم(new_dev + 0)
        hub_serial_اطبع(" speed=")
        hub_serial_رقم(speed + 0)
        hub_serial_سطر()
    والا
        hub_serial_اطبع("[HUB] Failed to register device")
        hub_serial_سطر()
        hub_errors = hub_errors + 1
    نهاية

    # مسح علم تغيير الاتصال
    hub_clear_port_feature(hub_idx، port، C_PORT_CONNECTION)

    ارجع new_dev + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# معالجة فصل جهاز
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة hub_handle_detach(hub_idx، port)
    hub_serial_اطبع("[HUB] Device detached hub #")
    hub_serial_رقم(hub_idx + 0)
    hub_serial_اطبع(" port ")
    hub_serial_رقم(port + 0)
    hub_serial_سطر()

    hub_set_port_dev(hub_idx، port - 1، 0)
    hub_detach_count = hub_detach_count + 1

    # مسح أعلام التغيير
    hub_clear_port_feature(hub_idx، port، C_PORT_CONNECTION)
    hub_clear_port_feature(hub_idx، port، C_PORT_ENABLE)

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# استقصاء الموزع (Poll for status changes)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة hub_poll(hub_idx)
    إذا (hub_get_active(hub_idx) == 0) ارجع 0 نهاية

    hub_poll_count = hub_poll_count + 1

    متغير num_ports = hub_get_num_ports(hub_idx) + 0
    متغير changes = 0 + 0

    متغير p = 1 + 0
    بينما (p <= num_ports)
        متغير status_change = hub_get_port_status(hub_idx، p) + 0

        إذا (status_change >= 0)
            متغير port_status = status_change % 65536
            متغير port_change = status_change / 65536

            # تحقق من تغيير الاتصال
            إذا ((port_change / PORT_CHANGE_CONNECTION) % 2 == 1)
                # جهاز جديد متصل أو مفصول
                إذا ((port_status / PORT_STATUS_CONNECTION) % 2 == 1)
                    hub_handle_attach(hub_idx، p)
                والا
                    hub_handle_detach(hub_idx، p)
                نهاية
                changes = changes + 1
            نهاية

            # تحقق من تجاوز التيار
            إذا ((port_change / PORT_CHANGE_OVERCURRENT) % 2 == 1)
                hub_serial_اطبع("[HUB] Overcurrent on port ")
                hub_serial_رقم(p + 0)
                hub_serial_سطر()
                hub_clear_port_feature(hub_idx، p، C_PORT_OVER_CURRENT)
                hub_errors = hub_errors + 1
            نهاية
        نهاية

        p = p + 1
    نهاية

    ارجع changes + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تسجيل موزع جديد
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة hub_register(hc_idx، dev_addr)
    إذا (hub_count >= MAX_HUBS)
        hub_serial_اطبع("[HUB] Max hubs reached")
        hub_serial_سطر()
        ارجع 0 - 1
    نهاية

    متغير idx = hub_count + 0
    hub_set_active(idx، 1)
    hub_set_hc(idx، hc_idx)
    hub_set_addr(idx، dev_addr)

    hub_serial_اطبع("[HUB] Registered hub #")
    hub_serial_رقم(idx + 0)
    hub_serial_اطبع(" addr=")
    hub_serial_رقم(dev_addr + 0)
    hub_serial_سطر()

    # الحصول على Hub Descriptor
    hub_get_descriptor(idx)

    # تشغيل طاقة المنافذ
    hub_power_on_ports(idx)

    # فحص أولي للمنافذ
    hub_poll(idx)

    hub_count = hub_count + 1
    ارجع idx + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تقرير الموزعات
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة hub_تقرير()
    hub_serial_اطبع("═══ [HUB] تقرير الموزعات ═══")
