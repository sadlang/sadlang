            hub_serial_اطبع(" addr=")
            hub_serial_رقم(hub_get_addr(h) + 0)
            hub_serial_اطبع(" ports=")
            hub_serial_رقم(hub_get_num_ports(h) + 0)
            hub_serial_سطر()

            # عرض حالة المنافذ
            متغير np = hub_get_num_ports(h) + 0
            متغير pp = 0 + 0
            بينما (pp < np)
                متغير dev = hub_get_port_dev(h، pp) + 0
                إذا (dev > 0)
                    hub_serial_اطبع("    Port ")
                    hub_serial_رقم(pp + 1)
                    hub_serial_اطبع(": device #")
                    hub_serial_رقم(dev + 0)
                    hub_serial_سطر()
                نهاية
                pp = pp + 1
            نهاية
        نهاية
        h = h + 1
    نهاية

    hub_serial_اطبع("  أجهزة متصلة: ")
    hub_serial_رقم(hub_attach_count + 0)
    hub_serial_اطبع("  مفصولة: ")
    hub_serial_رقم(hub_detach_count + 0)
    hub_serial_سطر()

    hub_serial_اطبع("  استقصاءات: ")
    hub_serial_رقم(hub_poll_count + 0)
    hub_serial_اطبع("  أخطاء: ")
    hub_serial_رقم(hub_errors + 0)
    hub_serial_سطر()

    hub_serial_اطبع("═══════════════════════════════════")
    hub_serial_سطر()
    ارجع 0
نهاية

