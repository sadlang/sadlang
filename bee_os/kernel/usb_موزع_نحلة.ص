# ─── دوال خارجية (FFI) ───
خارجي دالة sad_ll_mem_read8(addr)
خارجي دالة sad_ll_mem_write8(addr، val)
خارجي دالة sad_ll_mem_read32(addr)
خارجي دالة sad_ll_mem_write32(addr، val)
خارجي دالة sad_ll_serial_write_char(port، ch)
خارجي دالة sad_ll_kmalloc(حجم_طلب)
خارجي دالة sad_ll_memset(عنوان، قيمة، حجم_منطقة)
خارجي دالة sad_ll_memcpy(هدف، مصدر، حجم_نقل)
خارجي دالة sad_ll_timer_get_ticks()

# ─── دوال خارجية من UHCI ───
خارجي دالة uhci_control_transfer(hc_idx، dev_addr، setup_buf، data_buf، data_len)
خارجي دالة uhci_interrupt_transfer(hc_idx، dev_addr، endpoint، buf، buf_len)

# ─── دوال خارجية من USB Core ───
خارجي دالة usb_build_setup(buf، bmRequestType، bRequest، wValue، wIndex، wLength)
خارجي دالة usb_register_device(hc_idx، port، speed، dev_class، proto، vid، pid)

