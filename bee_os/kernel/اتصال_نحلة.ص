# ═══════════════════════════════════════════════════════════════════════════════
# القسم ٧: نداءات النظام — "بوابة النحلة" (BeeGate)
# ═══════════════════════════════════════════════════════════════════════════════
#
# نداءات النظام هي الواجهة الرسمية بين وضع المستخدم والنواة.
# في x86_64 نستخدم تعليمة `syscall` (أو int 0x80 في الوضع القديم).
#
# اتفاقية الاستدعاء (ABI):
#   RAX = رقم النداء (SYS_*)
#   RDI = المعامل الأول
#   RSI = المعامل الثاني
#   RDX = المعامل الثالث
#   R10 = المعامل الرابع
#   RAX = قيمة الإرجاع (سالبة = خطأ)

## ─────────── إحصائيات نداءات النظام ───────────
متغير إجمالي_syscalls = 0
متغير syscalls_ناجحة = 0
متغير syscalls_فاشلة = 0

# عداد لكل نداء
