## ─────────────────────────────────────────────────────
## فحص ومعالجة الإشارات المعلّقة لعملية
## ─────────────────────────────────────────────────────
## تُستدعى عند تبديل السياق (context switch)
## يُعيد: رقم أول إشارة معلّقة، أو 0 إذا لا توجد
صدّر دالة عالج_إشارات(pid)
    إذا (pid < 0)
        ارجع 0
    نهاية
    إذا (pid >= أقصى_عمليات)
        ارجع 0
    نهاية
    
    إذا (إشارات_معلقة[pid] == 0)
        ارجع 0  # لا إشارات معلّقة
    نهاية
    
    # ابحث عن أول إشارة معلّقة (الأولوية الأعلى أولاً)
    متغير إشارة = 1
    بينما (إشارة <= أقصى_إشارات)
        متغير قناع = 1
        متغير ي = 0
        بينما (ي < إشارة - 1)
            قناع = قناع * 2
            ي = ي + 1
        نهاية
        
        متغير بت = (إشارات_معلقة[pid] / قناع) % 2
        إذا (بت == 1)
            # وجدنا إشارة معلّقة!
            # امسح البت
            إشارات_معلقة[pid] = إشارات_معلقة[pid] - قناع
            ارجع إشارة
        نهاية
        
        إشارة = إشارة + 1
    نهاية
    
    ارجع 0
