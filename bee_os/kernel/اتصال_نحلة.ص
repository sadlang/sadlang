## ─────────────────────────────────────────────────────
## Spinlock — قفل دوراني للذاكرة المشتركة
## ─────────────────────────────────────────────────────
## يدور في حلقة حتى يحصل على القفل
صدّر دالة اقفل_منطقة(فهرس)
    إذا (فهرس < 0)
        ارجع
    نهاية
    إذا (فهرس >= أقصى_مناطق_مشتركة)
        ارجع
    نهاية
    
    # Spinlock: انتظر حتى يكون القفل حراً
    بينما (مشترك_قفل[فهرس] != 0)
        # دوران (busy wait) — قد نُضيف pause instruction لاحقاً
        # في بيئة حقيقية نستخدم atomic compare-and-swap
        متغير ي = 0
        بينما (ي < 100)
            ي = ي + 1  # تأخير بسيط لتقليل ضغط الذاكرة
        نهاية
    نهاية
    
    # اقفل
    مشترك_قفل[فهرس] = 1
