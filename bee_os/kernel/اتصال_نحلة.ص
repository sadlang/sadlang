    أنبوب_كتابة[رقم_الأنبوب] = 0
    أنبوب_قراءة[رقم_الأنبوب] = 0
    أنبوب_عدد[رقم_الأنبوب] = 0
    أنبوب_كاتب[رقم_الأنبوب] = 0
    أنبوب_قارئ[رقم_الأنبوب] = 0
    أنبوب_نشط[رقم_الأنبوب] = 0
    عدد_الأنابيب = عدد_الأنابيب - 1
