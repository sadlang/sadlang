    إذا (فتحة < 0)
        ارجع 0
    نهاية
    إذا (فتحة >= OOM_الحد_الأقصى_العمليات)
        ارجع 0
    نهاية
    
    متغير نشط = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 13)
    إذا (نشط == 0)
        ارجع 0
    نهاية
    
    متغير pid_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 0)
    متغير rss_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 1)
    متغير نقاط_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 7)
    
    kernel_print_string("  [OOM] === قتل عملية ===")
    kernel_print_string("  [OOM]   PID: ")
    kernel_print_number(pid_ع)
    kernel_print_string("  [OOM]   RSS: ")
    kernel_print_number(rss_ع)
    kernel_print_string(" صفحة")
    kernel_print_string("  [OOM]   النقاط: ")
    kernel_print_number(نقاط_ع)
    
    # تسجيل حدث القتل
    oom_تسجيل_حدث(OOM_حدث_قتل، pid_ع، نقاط_ع)
    
    # تحرير ذاكرة العملية
    oom_ذاكرة_حرة = oom_ذاكرة_حرة + rss_ع
    
    # تحديث عداد OOM
    متغير عدد_سابق = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 10)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 10، عدد_سابق + 1)
    
    # إلغاء تنشيط العملية
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 13، 0)
    oom_عدد_العمليات = oom_عدد_العمليات - 1
    oom_عدد_القتل = oom_عدد_القتل + 1
    
    kernel_print_string("  [OOM]   ذاكرة حرة بعد القتل: ")
    kernel_print_number(oom_ذاكرة_حرة)
    kernel_print_string("  [OOM] =================")
    
    ارجع rss_ع
