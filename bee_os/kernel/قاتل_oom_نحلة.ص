# تنفيذ دورة فحص OOM كاملة
صدّر دالة oom_دورة_فحص(الوقت_الحالي)
    إذا (oom_مُهيّأ == 0)
        ارجع 0
    نهاية
    
    oom_وقت_آخر_فحص = الوقت_الحالي
    
    # الخطوة 1: حساب مستوى الضغط الحالي
    متغير مستوى = oom_حساب_مستوى_الضغط()
    
    # الخطوة 2: لا شيء نفعله إذا كان المستوى عادياً
    إذا (مستوى == OOM_ضغط_عادي)
        ارجع 0
    نهاية
    
    # الخطوة 3: تسجيل حدث ضغط
    oom_تسجيل_حدث(OOM_حدث_ضغط، 0، مستوى)
    
    # الخطوة 4: فحص تجاوز حدود المجموعات
    متغير مج = 0
    بينما (مج < OOM_الحد_الأقصى_المجموعات)
        متغير مج_نشط = oom_قراءة_حقل_مجموعة(oom_قاعدة_المجموعات، مج، 5)
        إذا (مج_نشط == 1)
            oom_تحديث_إحصائيات_مجموعة(مج)
            متغير تجاوز = oom_فحص_حد_مجموعة(مج)
            إذا (تجاوز == 1)
                متغير مج_id = oom_قراءة_حقل_مجموعة(oom_قاعدة_المجموعات، مج، 0)
                kernel_print_string("  [OOM] تجاوز حد المجموعة ")
                kernel_print_number(مج_id)
                
                متغير فتحة_ق = oom_اختيار_من_مجموعة(مج_id)
                إذا (فتحة_ق != -1)
                    oom_قتل_عملية(فتحة_ق)
                نهاية
            نهاية
        نهاية
        مج = مج + 1
    نهاية
    
    # الخطوة 5: التعامل مع المستوى الحرج أو الطارئ
    إذا (مستوى >= OOM_ضغط_حرج)
        # محاولة الاسترداد أولاً
        متغير محرر = oom_محاولة_استرداد()
        
        # إعادة فحص المستوى
        متغير مستوى_بعد = oom_حساب_مستوى_الضغط()
        
        إذا (مستوى_بعد >= OOM_ضغط_حرج)
            # الاسترداد غير كافٍ - قتل عملية
            kernel_print_string("  [OOM] الاسترداد غير كافٍ - بدء القتل")
            متغير فتحة_مرشح = oom_اختيار_مرشح()
            إذا (فتحة_مرشح != -1)
                oom_قتل_عملية(فتحة_مرشح)
            وإلا
                kernel_print_string("  [OOM] !!! لا يمكن تحرير ذاكرة - ذعر !!!")
                ارجع -1
            نهاية
        نهاية
    نهاية
    
    # الخطوة 6: قتل متعدد في حالة الطوارئ المستمرة
    متغير مستوى_نهائي = oom_حساب_مستوى_الضغط()
    إذا (مستوى_نهائي == OOM_ضغط_طارئ)
        kernel_print_string("  [OOM] !!! حالة طوارئ - قتل متعدد !!!")
        متغير المطلوب = OOM_علامة_حرجة - oom_ذاكرة_حرة
        إذا (المطلوب > 0)
