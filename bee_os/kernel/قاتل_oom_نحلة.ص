#* ===================================================================
   نظام نحلة - قاتل OOM (إدارة نفاد الذاكرة)
   BeeOS - OOM Killer Module
   
   الوصف: نظام كشف نفاد الذاكرة واختيار العمليات للإنهاء
   - حساب نقاط OOM لكل عملية (استخدام الذاكرة، الأولوية، العمر)
   - تتبع ذاكرة العمليات (RSS، افتراضية، مشتركة، تبادل)
   - كشف عتبات OOM (علامات مائية)
   - اختيار المرشح للإنهاء (أعلى نقاط سوء)
   - إدارة مجموعات OOM (حماية/تضحية)
   - مستويات ضغط الذاكرة (منخفض/متوسط/حرج)
   - محاولات استرداد قبل OOM
   - إحصائيات وتسجيل OOM
   
   المؤلف: نظام نحلة
   الإصدار: 1.0.0
   ===================================================================  *#

# ===================================================================
# استيراد الدوال الخارجية من النواة
# ===================================================================
خارجي دالة kernel_print_string(عنوان)
خارجي دالة kernel_print_number(قيمة)
خارجي دالة serial_put_hex(قيمة)
خارجي دالة kernel_allocate(المقاس)
خارجي دالة kernel_free(عنوان)
خارجي دالة mem_read_byte(عنوان)
خارجي دالة mem_write_byte(عنوان، قيمة)
خارجي دالة mem_read_dword(عنوان)
خارجي دالة mem_write_dword(عنوان، قيمة)
خارجي دالة sad_ll_memset(عنوان، قيمة، طول)
خارجي دالة sad_ll_memcpy(وجهة، مصدر، طول)

# ===================================================================
# الثوابت الأساسية لنظام OOM
# ===================================================================

# الحدود القصوى
متغير OOM_الحد_الأقصى_العمليات = 256
متغير OOM_الحد_الأقصى_المجموعات = 32
متغير OOM_مقاس_سجل_الأحداث = 64

# حقول بنية العملية في الذاكرة (كل حقل 4 بايت)
# الفهرس 0: معرف العملية (PID)
# الفهرس 1: ذاكرة RSS بالصفحات
# الفهرس 2: ذاكرة افتراضية بالصفحات
# الفهرس 3: ذاكرة مشتركة بالصفحات
# الفهرس 4: ذاكرة تبادل بالصفحات
# الفهرس 5: الأولوية (0-100)
# الفهرس 6: العمر بالثواني
# الفهرس 7: نقاط OOM المحسوبة
# الفهرس 8: وضعية الحماية (0=عادي، 1=محمي، 2=تضحية)
# الفهرس 9: معرف المجموعة
# الفهرس 10: عدد مرات OOM السابقة
# الفهرس 11: آخر وقت OOM
# الفهرس 12: تعديل النقاط اليدوي
# الفهرس 13: نشاط (0=غير نشط، 1=نشط)
# الفهرس 14: ذاكرة الذروة RSS
# الفهرس 15: عدد الأبناء
متغير OOM_حقول_العملية = 16
متغير OOM_مقاس_العملية = 64

# حقول بنية المجموعة (كل حقل 4 بايت)
# الفهرس 0: معرف المجموعة
# الفهرس 1: وضعية المجموعة (0=عادي، 1=محمي، 2=تضحية)
# الفهرس 2: عدد العمليات
# الفهرس 3: إجمالي RSS
# الفهرس 4: حد الذاكرة
# الفهرس 5: نشاط
# الفهرس 6: الأولوية
# الفهرس 7: تعديل النقاط
متغير OOM_حقول_المجموعة = 8
متغير OOM_مقاس_المجموعة = 32

# حقول سجل الأحداث (كل حقل 4 بايت)
# الفهرس 0: وقت الحدث
# الفهرس 1: فئة الحدث
# الفهرس 2: معرف العملية المتأثرة
# الفهرس 3: النقاط عند الحدث
# الفهرس 4: الذاكرة الحرة عند الحدث
# الفهرس 5: مستوى الضغط
متغير OOM_حقول_السجل = 6
متغير OOM_مقاس_السجل = 24

# مستويات ضغط الذاكرة
متغير OOM_ضغط_عادي = 0
متغير OOM_ضغط_منخفض = 1
متغير OOM_ضغط_متوسط = 2
متغير OOM_ضغط_حرج = 3
متغير OOM_ضغط_طارئ = 4

# وضعيات حماية العمليات
متغير OOM_حماية_عادي = 0
متغير OOM_حماية_محمي = 1
متغير OOM_حماية_تضحية = 2

# العلامات المائية (بالصفحات - كل صفحة 4096 بايت)
متغير OOM_علامة_عالية = 8192
متغير OOM_علامة_منخفضة = 4096
متغير OOM_علامة_حرجة = 1024
متغير OOM_علامة_طوارئ = 256

# أوزان حساب النقاط
متغير OOM_وزن_RSS = 10
متغير OOM_وزن_افتراضي = 3
متغير OOM_وزن_تبادل = 5
متغير OOM_وزن_أولوية = 2
متغير OOM_وزن_عمر = 1

# أنواع الأحداث في السجل
متغير OOM_حدث_قتل = 1
متغير OOM_حدث_تحذير = 2
متغير OOM_حدث_استرداد = 3
متغير OOM_حدث_ضغط = 4

# ===================================================================
# المتغيرات العامة لنظام OOM
# ===================================================================
متغير oom_قاعدة_العمليات = 0
متغير oom_قاعدة_المجموعات = 0
متغير oom_قاعدة_السجل = 0
متغير oom_عدد_العمليات = 0
متغير oom_عدد_المجموعات = 0
متغير oom_فهرس_السجل = 0
متغير oom_مستوى_الضغط = 0
متغير oom_إجمالي_الذاكرة = 0
متغير oom_ذاكرة_حرة = 0
متغير oom_عدد_القتل = 0
متغير oom_عدد_الاسترداد = 0
متغير oom_مُهيّأ = 0
متغير oom_وقت_آخر_فحص = 0
متغير oom_احتياطي_طوارئ = 0
متغير oom_مقاس_احتياطي = 0

# ===================================================================
# دوال الوصول للحقول (نمط المصفوفة)
# ===================================================================

# كتابة حقل في بنية عملية
دالة oom_كتابة_حقل_عملية(قاعدة، فهرس_عملية، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_عملية * OOM_مقاس_العملية) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من بنية عملية
دالة oom_قراءة_حقل_عملية(قاعدة، فهرس_عملية، فهرس_حقل)
    متغير إزاحة = (فهرس_عملية * OOM_مقاس_العملية) + (فهرس_حقل * 4)
    ارجع mem_read_dword(قاعدة + إزاحة)
نهاية

# كتابة حقل في بنية مجموعة
دالة oom_كتابة_حقل_مجموعة(قاعدة، فهرس_مجموعة، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_مجموعة * OOM_مقاس_المجموعة) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من بنية مجموعة
دالة oom_قراءة_حقل_مجموعة(قاعدة، فهرس_مجموعة، فهرس_حقل)
    متغير إزاحة = (فهرس_مجموعة * OOM_مقاس_المجموعة) + (فهرس_حقل * 4)
    ارجع mem_read_dword(قاعدة + إزاحة)
نهاية

# كتابة حقل في سجل الأحداث
دالة oom_كتابة_حقل_سجل(قاعدة، فهرس_سجل_ح، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_سجل_ح * OOM_مقاس_السجل) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من سجل الأحداث
دالة oom_قراءة_حقل_سجل(قاعدة، فهرس_سجل_ح، فهرس_حقل)
    متغير إزاحة = (فهرس_سجل_ح * OOM_مقاس_السجل) + (فهرس_حقل * 4)
    ارجع mem_read_dword(قاعدة + إزاحة)
نهاية

# ===================================================================
# دوال التهيئة الفرعية
# ===================================================================

# تهيئة جدول العمليات
دالة oom_تهيئة_جدول_العمليات()
    # حساب المقاس المطلوب لجدول العمليات
    متغير المقاس_الكلي = OOM_الحد_الأقصى_العمليات * OOM_مقاس_العملية
    
    # تخصيص ذاكرة لجدول العمليات
    oom_قاعدة_العمليات = kernel_allocate(المقاس_الكلي)
    إذا (oom_قاعدة_العمليات == 0)
        kernel_print_string("  [خطأ] فشل تخصيص جدول عمليات OOM")
        ارجع 0
    نهاية
    
    # تصفير الذاكرة المخصصة
    sad_ll_memset(oom_قاعدة_العمليات، 0، المقاس_الكلي)
    
    # تهيئة كل عملية كغير نشطة
    متغير ف = 0
    بينما (ف < OOM_الحد_الأقصى_العمليات)
        # الحقل 13 = نشاط = 0 (غير نشط)
        oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، ف، 13، 0)
        # الحقل 0 = PID = 0
        oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، ف، 0، 0)
        ف = ف + 1
    نهاية
    
    oom_عدد_العمليات = 0
    kernel_print_string("  [OOM] تم تهيئة جدول العمليات - السعة: ")
    kernel_print_number(OOM_الحد_الأقصى_العمليات)
    
    ارجع 1
نهاية

# تهيئة جدول المجموعات
دالة oom_تهيئة_جدول_المجموعات()
    متغير المقاس_الكلي = OOM_الحد_الأقصى_المجموعات * OOM_مقاس_المجموعة
    
    oom_قاعدة_المجموعات = kernel_allocate(المقاس_الكلي)
    إذا (oom_قاعدة_المجموعات == 0)
        kernel_print_string("  [خطأ] فشل تخصيص جدول مجموعات OOM")
        ارجع 0
    نهاية
    
    # تصفير كل الذاكرة
    sad_ll_memset(oom_قاعدة_المجموعات، 0، المقاس_الكلي)
    
    # تهيئة كل مجموعة كغير نشطة (الحقل 5 = نشاط = 0)
    متغير ف = 0
    بينما (ف < OOM_الحد_الأقصى_المجموعات)
        oom_كتابة_حقل_مجموعة(oom_قاعدة_المجموعات، ف، 5، 0)
        ف = ف + 1
    نهاية
    
    oom_عدد_المجموعات = 0
    kernel_print_string("  [OOM] تم تهيئة جدول المجموعات - السعة: ")
    kernel_print_number(OOM_الحد_الأقصى_المجموعات)
    
    ارجع 1
نهاية

# تهيئة سجل الأحداث الدائري
دالة oom_تهيئة_سجل_الأحداث()
    متغير المقاس_الكلي = OOM_مقاس_سجل_الأحداث * OOM_مقاس_السجل
    
    oom_قاعدة_السجل = kernel_allocate(المقاس_الكلي)
    إذا (oom_قاعدة_السجل == 0)
        kernel_print_string("  [خطأ] فشل تخصيص سجل أحداث OOM")
        ارجع 0
    نهاية
    
    sad_ll_memset(oom_قاعدة_السجل، 0، المقاس_الكلي)
    oom_فهرس_السجل = 0
    
    kernel_print_string("  [OOM] تم تهيئة سجل الأحداث - السعة: ")
    kernel_print_number(OOM_مقاس_سجل_الأحداث)
    ارجع 1
نهاية

# تهيئة الاحتياطي الطارئ (64 كيلوبايت محجوزة لحالات الطوارئ)
دالة oom_تهيئة_الاحتياطي()
    oom_مقاس_احتياطي = 65536
    oom_احتياطي_طوارئ = kernel_allocate(oom_مقاس_احتياطي)
    
    إذا (oom_احتياطي_طوارئ == 0)
        kernel_print_string("  [تحذير] فشل تخصيص احتياطي الطوارئ")
        ارجع 0
    نهاية
    
    # تعبئة بنمط مميز للتشخيص (0xAA)
    sad_ll_memset(oom_احتياطي_طوارئ، 170، oom_مقاس_احتياطي)
    
    kernel_print_string("  [OOM] تم تخصيص احتياطي طوارئ: ")
    kernel_print_number(oom_مقاس_احتياطي)
    kernel_print_string(" بايت")
    
    ارجع 1
نهاية

# ===================================================================
# إدارة العمليات - تسجيل وإلغاء وبحث
# ===================================================================

# تسجيل عملية جديدة في نظام OOM
صدّر دالة oom_تسجيل_عملية(معرف_ع، ذاكرة_rss، ذاكرة_افتراضية، أولوية_ع)
    إذا (oom_مُهيّأ == 0)
        ارجع -1
    نهاية
    
    # البحث عن فتحة فارغة في جدول العمليات
    متغير فتحة = -1
    متغير ف = 0
    بينما (ف < OOM_الحد_الأقصى_العمليات)
        متغير نشط = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، ف، 13)
        إذا (نشط == 0)
            فتحة = ف
            اخرج
        نهاية
        ف = ف + 1
    نهاية
    
    # لا توجد فتحات متاحة
    إذا (فتحة == -1)
        kernel_print_string("  [OOM] لا توجد فتحات فارغة لتسجيل عملية")
        ارجع -1
    نهاية
    
    # تعبئة جميع حقول العملية
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 0، معرف_ع)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 1، ذاكرة_rss)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 2، ذاكرة_افتراضية)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 3، 0)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 4، 0)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 5، أولوية_ع)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 6، 0)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 7، 0)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 8، OOM_حماية_عادي)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 9، 0)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 10، 0)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 11، 0)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 12، 0)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 13، 1)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 14، ذاكرة_rss)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 15، 0)
    
    oom_عدد_العمليات = oom_عدد_العمليات + 1
    
    kernel_print_string("  [OOM] تسجيل عملية PID=")
    kernel_print_number(معرف_ع)
    kernel_print_string(" RSS=")
    kernel_print_number(ذاكرة_rss)
    
    ارجع فتحة
نهاية

# إلغاء تسجيل عملية (عند خروجها أو إنهائها)
صدّر دالة oom_إلغاء_تسجيل_عملية(معرف_ع)
    إذا (oom_مُهيّأ == 0)
        ارجع 0
    نهاية
    
    متغير ف = 0
    بينما (ف < OOM_الحد_الأقصى_العمليات)
        متغير نشط = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، ف، 13)
        إذا (نشط == 1)
            متغير pid_حالي = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، ف، 0)
            إذا (pid_حالي == معرف_ع)
                # تعطيل العملية وتصفير السجل
                oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، ف، 13، 0)
                oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، ف، 0، 0)
                oom_عدد_العمليات = oom_عدد_العمليات - 1
                
                kernel_print_string("  [OOM] إلغاء تسجيل عملية PID=")
                kernel_print_number(معرف_ع)
                ارجع 1
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    
    ارجع 0
نهاية

# البحث عن فهرس عملية بواسطة PID
دالة oom_بحث_عملية(معرف_ع)
    متغير ف = 0
    بينما (ف < OOM_الحد_الأقصى_العمليات)
        متغير نشط = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، ف، 13)
        إذا (نشط == 1)
            متغير pid_حالي = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، ف، 0)
            إذا (pid_حالي == معرف_ع)
                ارجع ف
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

# تحديث حقول الذاكرة لعملية معينة
صدّر دالة oom_تحديث_ذاكرة(معرف_ع، ذاكرة_rss، ذاكرة_افتراضية، ذاكرة_مشتركة، ذاكرة_تبادل)
    متغير فتحة = oom_بحث_عملية(معرف_ع)
    إذا (فتحة == -1)
        ارجع 0
    نهاية
    
    # تحديث جميع حقول الذاكرة
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 1، ذاكرة_rss)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 2، ذاكرة_افتراضية)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 3، ذاكرة_مشتركة)
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 4، ذاكرة_تبادل)
    
    # تحديث ذاكرة الذروة إذا تجاوزت القيمة الحالية
    متغير ذروة_حالية = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 14)
    إذا (ذاكرة_rss > ذروة_حالية)
        oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 14، ذاكرة_rss)
    نهاية
    
    ارجع 1
نهاية

# تحديث عمر العملية
صدّر دالة oom_تحديث_عمر(معرف_ع، العمر_م)
    متغير فتحة = oom_بحث_عملية(معرف_ع)
    إذا (فتحة == -1)
        ارجع 0
    نهاية
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 6، العمر_م)
