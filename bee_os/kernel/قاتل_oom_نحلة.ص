# حساب نقاط OOM لعملية واحدة في فتحة معينة
دالة oom_حساب_نقاط_عملية(فتحة)
    # التحقق من نشاط العملية
    متغير نشط = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 13)
    إذا (نشط == 0)
        ارجع 0
    نهاية
    
    # العملية المحمية لا تحصل على نقاط
    متغير وضعية_ح = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 8)
    إذا (وضعية_ح == OOM_حماية_محمي)
        oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 7، 0)
        ارجع 0
    نهاية
    
    # قراءة جميع بيانات الذاكرة والأولوية
    متغير rss_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 1)
    متغير افتراضية_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 2)
    متغير مشتركة_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 3)
    متغير تبادل_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 4)
    متغير أولوية_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 5)
    متغير العمر_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 6)
    متغير تعديل_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 12)
    متغير أبناء_ع = oom_قراءة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 15)
    
    # --- حساب مكونات النقاط ---
    
    # RSS: العنصر الأهم - الذاكرة الفعلية المستخدمة
    متغير نقاط_rss = rss_ع * OOM_وزن_RSS
    
    # الذاكرة الافتراضية: مؤشر على الاستهلاك المحتمل
    متغير نقاط_افتراضية = افتراضية_ع * OOM_وزن_افتراضي
    
    # ذاكرة التبادل: العملية تستهلك موارد التبادل
    متغير نقاط_تبادل = تبادل_ع * OOM_وزن_تبادل
    
    # نقاط الأبناء: المزيد من الأبناء يعني استهلاك أكبر
    متغير نقاط_أبناء = أبناء_ع * 20
    
    # خصم للذاكرة المشتركة (مستخدمة من عمليات أخرى)
    متغير خصم_مشتركة = مشتركة_ع * 3
    
    # خصم للأولوية العالية (قيمة أقل = أولوية أعلى)
    متغير خصم_أولوية = 0
    إذا (أولوية_ع < 20)
        خصم_أولوية = (20 - أولوية_ع) * OOM_وزن_أولوية * 10
    نهاية
    
    # خصم للعمر (العمليات القديمة أقل عرضة للقتل)
    متغير خصم_عمر = 0
    إذا (العمر_ع > 3600)
        # أكثر من ساعة
        خصم_عمر = 100
    والا_اذا (العمر_ع > 600)
        # أكثر من 10 دقائق
        خصم_عمر = 50
    والا_اذا (العمر_ع > 60)
        # أكثر من دقيقة
        خصم_عمر = 20
    نهاية
    
    # مكافأة التضحية (العملية المعلمة كتضحوية تحصل نقاط إضافية)
    متغير مكافأة_تضحية = 0
    إذا (وضعية_ح == OOM_حماية_تضحية)
        مكافأة_تضحية = 500
    نهاية
    
    # --- حساب النقاط النهائية ---
    متغير النقاط = نقاط_rss + نقاط_افتراضية + نقاط_تبادل + نقاط_أبناء
    النقاط = النقاط + مكافأة_تضحية + تعديل_ع
    النقاط = النقاط - خصم_مشتركة - خصم_أولوية - خصم_عمر
    
    # ضمان عدم سلبية النقاط
    إذا (النقاط < 0)
        النقاط = 0
    نهاية
    
    # تخزين النقاط في الحقل 7
    oom_كتابة_حقل_عملية(oom_قاعدة_العمليات، فتحة، 7، النقاط)
    
    ارجع النقاط
نهاية

