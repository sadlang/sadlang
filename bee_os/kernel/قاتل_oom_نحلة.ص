    oom_كتابة_حقل_سجل(oom_قاعدة_السجل، موقع، 3، نقاط_ع)
    oom_كتابة_حقل_سجل(oom_قاعدة_السجل، موقع، 4، oom_ذاكرة_حرة)
    oom_كتابة_حقل_سجل(oom_قاعدة_السجل، موقع، 5، oom_مستوى_الضغط)
    
