#**
 * ذاكرة.ص — وحدة إدارة الذاكرة لنظام النحلة BeeOS
 * Memory Management — BeeWax Memory (Buddy + Slab)
 *
 * التصميم: BeeWax Memory
 *   - Buddy System: تخصيص صفحات 4KB بخوارزمية Buddy
 *   - Slab Allocator: تخصيص سريع للهياكل الصغيرة
 *   - VMalloc: للتخصيصات الكبيرة > 1MB
 *
 * خريطة الذاكرة (مثالي x86_64):
 *   0x0000_0000 - 0x0010_0000 : منطقة حرجة (1MB أولى)
 *   0x0010_0000 - 0x0020_0000 : نواة BeeOS (~1MB)
 *   0x0020_0000 - 0xFFFF_FFFF : ذاكرة حرة للتخصيص
 *
 * @version 0.1.0 — BeeOS Alpha
 * @date 2026
 **#

# ===================================================================
# ثوابت إدارة الذاكرة
# ===================================================================

متغير حجم_صفحة          = 4096       # 4KB لكل صفحة
متغير أقصى_رتبة         = 11         # رتبة 11 = 8MB كتلة أكبر

# حدود الذاكرة المحاكاة
متغير بداية_ذاكرة_حرة   = 0x200000   # 2MB: بداية الذاكرة الحرة
متغير نهاية_ذاكرة        = 0x4000000  # 64MB: ذاكرة للاختبار
متغير حجم_ذاكرة_إجمالي  = 64         # MB

# ===================================================================
# هياكل البيانات المحاكاة
# ===================================================================

# إحصائيات الذاكرة
متغير صفحات_إجمالية     = 0
متغير صفحات_حرة         = 0
متغير صفحات_مستخدمة     = 0
متغير مجموع_مخصص        = 0          # بالبايت
متغير عدد_التخصيصات     = 0
متغير عدد_التحريرات     = 0
متغير ذاكرة_مهيأة       = خطأ

# ===================================================================
# تهيئة نظام الذاكرة
# ===================================================================

دالة ذاكرة_تهيئة()
    # احسب عدد الصفحات المتاحة
    متغير بايتات_حرة = نهاية_ذاكرة - بداية_ذاكرة_حرة
    صفحات_إجمالية = بايتات_حرة / حجم_صفحة
    صفحات_حرة     = صفحات_إجمالية
    صفحات_مستخدمة = 0
    ذاكرة_مهيأة   = صحيح

    اطبع_سطر("[ذاكرة] ✓ نظام Buddy مهيأ")
    اطبع_سطر("[ذاكرة]   الذاكرة الإجمالية: " + حجم_ذاكرة_إجمالي + " MB")
    اطبع_سطر("[ذاكرة]   الصفحات المتاحة:  " + صفحات_إجمالية)
    اطبع_سطر("[ذاكرة]   حجم الصفحة:       " + حجم_صفحة + " بايت")
نهاية

# ===================================================================
# تخصيص الذاكرة — Buddy Allocator
# ===================================================================

## تخصيص عدد من الصفحات (محاكاة)
دالة ذاكرة_خصص_صفحات(عدد_الصفحات)
    إذا (ذاكرة_مهيأة == خطأ)
        اطبع_سطر("[ذاكرة] ✗ خطأ: النظام غير مهيأ!")
        ارجع 0
    نهاية

    إذا (عدد_الصفحات <= 0)
        اطبع_سطر("[ذاكرة] ✗ خطأ: عدد صفحات غير صالح")
        ارجع 0
    نهاية

    إذا (عدد_الصفحات > صفحات_حرة)
        اطبع_سطر("[ذاكرة] ✗ خطأ: لا توجد ذاكرة كافية!")
        ارجع 0
    نهاية

    # محاكاة التخصيص
    متغير عنوان_مخصص = بداية_ذاكرة_حرة + (صفحات_مستخدمة * حجم_صفحة)
    صفحات_مستخدمة = صفحات_مستخدمة + عدد_الصفحات
    صفحات_حرة     = صفحات_حرة - عدد_الصفحات
    مجموع_مخصص    = مجموع_مخصص + (عدد_الصفحات * حجم_صفحة)
    عدد_التخصيصات = عدد_التخصيصات + 1

    ارجع عنوان_مخصص
نهاية

## تخصيص بالبايت
دالة ذاكرة_خصص(حجم_بايت)
    إذا (حجم_بايت <= 0)
        ارجع 0
    نهاية
    # احسب عدد الصفحات المطلوبة
    متغير صفحات_مطلوبة = حجم_بايت / حجم_صفحة
    إذا (حجم_بايت % حجم_صفحة > 0)
        صفحات_مطلوبة = صفحات_مطلوبة + 1
    نهاية
    ارجع ذاكرة_خصص_صفحات(صفحات_مطلوبة)
نهاية

## تحرير الذاكرة
دالة ذاكرة_حرر(عنوان، عدد_الصفحات)
    إذا (عنوان == 0)
        ارجع خطأ
    نهاية
    إذا (عدد_الصفحات > صفحات_مستخدمة)
        اطبع_سطر("[ذاكرة] ✗ خطأ: تحرير أكثر مما خُصص!")
        ارجع خطأ
    نهاية
    صفحات_مستخدمة = صفحات_مستخدمة - عدد_الصفحات
    صفحات_حرة     = صفحات_حرة + عدد_الصفحات
    عدد_التحريرات = عدد_التحريرات + 1
    ارجع صحيح
نهاية

# ===================================================================
# Slab Allocator — للهياكل الصغيرة
# ===================================================================

## تخصيص هيكل صغير من Slab (محاكاة)
دالة ذاكرة_slab_خصص(حجم_الهيكل)
    # Slab مثالي للتخصيصات < 256 بايت
    إذا (حجم_الهيكل <= 0)
        ارجع 0
    نهاية
    إذا (حجم_الهيكل > 256)
        # أكبر من Slab — استخدم Buddy
        ارجع ذاكرة_خصص(حجم_الهيكل)
    نهاية
    # محاكاة: نخصص صفحة واحدة ونقسمها
    متغير عنوان = ذاكرة_خصص_صفحات(1)
    ارجع عنوان
نهاية

# ===================================================================
# إحصائيات وتشخيص
# ===================================================================

دالة ذاكرة_إحصائيات()
    اطبع_سطر("┌─────────────────────────────────┐")
    اطبع_سطر("│  إحصائيات ذاكرة BeeOS           │")
    اطبع_سطر("├─────────────────────────────────┤")
    اطبع_سطر("│  صفحات إجمالية: " + صفحات_إجمالية)
    اطبع_سطر("│  صفحات مستخدمة: " + صفحات_مستخدمة)
    اطبع_سطر("│  صفحات حرة:     " + صفحات_حرة)
    اطبع_سطر("│  مجموع مخصص:    " + مجموع_مخصص + " بايت")
    اطبع_سطر("│  عدد التخصيصات: " + عدد_التخصيصات)
    اطبع_سطر("│  عدد التحريرات: " + عدد_التحريرات)
    اطبع_سطر("└─────────────────────────────────┘")
نهاية

دالة ذاكرة_نسبة_الاستخدام()
    إذا (صفحات_إجمالية == 0)
        ارجع 0
    نهاية
    ارجع (صفحات_مستخدمة * 100) / صفحات_إجمالية
نهاية

# ===================================================================
# اختبار الوحدة
# ===================================================================

اطبع_سطر("=== BeeOS — اختبار وحدة الذاكرة ===")
ذاكرة_تهيئة()

# اختبار 1: تخصيص صفحة واحدة
متغير عنوان1 = ذاكرة_خصص_صفحات(1)
اطبع_سطر("[اختبار 1] تخصيص صفحة واحدة → عنوان: " + عنوان1)

# اختبار 2: تخصيص بالبايت
متغير عنوان2 = ذاكرة_خصص(8192)
اطبع_سطر("[اختبار 2] تخصيص 8KB → عنوان: " + عنوان2)

# اختبار 3: Slab للهياكل الصغيرة
متغير عنوان3 = ذاكرة_slab_خصص(64)
اطبع_سطر("[اختبار 3] Slab 64 بايت → عنوان: " + عنوان3)

# اختبار 4: تحرير الذاكرة
متغير نجح = ذاكرة_حرر(عنوان1، 1)
اطبع_سطر("[اختبار 4] تحرير صفحة → نجح: " + نجح)

# إحصائيات ختامية
ذاكرة_إحصائيات()
اطبع_سطر("نسبة الاستخدام: " + ذاكرة_نسبة_الاستخدام() + "%")
اطبع_سطر("=== اكتمل اختبار الذاكرة ✓ ===")
