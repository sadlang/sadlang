# ═══════════════════════════════════════════════════════════════════════════════
# ترحيل صفحة — النسخ والتبديل
# ═══════════════════════════════════════════════════════════════════════════════

#** ترحيل صفحة من موقع إلى آخر
#   عنوان_قديم: عنوان الصفحة المصدر
#   عنوان_جديد: عنوان الصفحة الوجهة
#   تُرجع 0 عند النجاح
#
#   الخطوات:
#   1. عزل الصفحة المصدر
#   2. نسخ المحتوى
#   3. إبطال TLB للعنوان القديم
#   4. تحديث خريطة التصنيف
**#
صدّر دالة ترحيل_صفحة(عنوان_قديم، عنوان_جديد)
    إذا (تم_تهيئة_ضغط == 0)
        ارجع -1
    نهاية

    # عزل الصفحة
    متغير تصنيف_قديم = عزل_صفحات(عنوان_قديم)
    إذا (تصنيف_قديم < 0)
        عداد_صفحات_فشلت = عداد_صفحات_فشلت + 1
        ارجع -1
    نهاية

    # نسخ محتوى الصفحة
    sad_ll_memcpy(عنوان_جديد، عنوان_قديم، ثابت_مقاس_صفحة)

    # إبطال TLB للعنوان القديم
    sad_ll_invlpg(عنوان_قديم)

    # تحديث خريطة التصنيف
    # الصفحة القديمة تصبح حرة (غير مصنفة فعلياً)
    متغير رقم_قديم = عنوان_قديم / ثابت_مقاس_صفحة
    كتابة_تصنيف(رقم_قديم، فئة_قابل_نقل)

    # الصفحة الجديدة تأخذ تصنيف القديمة
    متغير رقم_جديد = عنوان_جديد / ثابت_مقاس_صفحة
    إذا (رقم_جديد < ثابت_اقصى_صفحات_خريطة)
        كتابة_تصنيف(رقم_جديد، تصنيف_قديم)
    نهاية

    عداد_صفحات_مرحّلة = عداد_صفحات_مرحّلة + 1

    ارجع 0
نهاية

