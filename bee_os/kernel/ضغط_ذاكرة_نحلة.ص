# ضغط مباشر — استجابة لطلب تخصيص فوري
# ═══════════════════════════════════════════════════════════════════════════════

#** ضغط مباشر: يُستدعى عندما يفشل تخصيص كتلة كبيرة
#   صفحات_مطلوبة: حجم الكتلة المطلوبة بالصفحات
#   تُرجع عدد الصفحات المرحّلة
#
#   يُجرب كل المناطق بحثاً عن مساحة كافية
**#
صدّر دالة ضغط_مباشر(صفحات_مطلوبة)
    إذا (تم_تهيئة_ضغط == 0)
        ارجع 0
    نهاية

    kernel_print_string("[ضغط] ضغط مباشر — مطلوب ")
    kernel_print_number(صفحات_مطلوبة)
    kernel_print_string(" صفحة متجاورة\n")

    عداد_ضغط_مباشر = عداد_ضغط_مباشر + 1

    متغير إجمالي_مرحّل = 0

    متغير م = 0
    بينما (م < عدد_مناطق)
        # فحص: هل هذه المنطقة تحتاج ضغط؟
        متغير أكبر = قراءة_ف(عن_منطقة_أكبر_كتلة، م)

        إذا (أكبر < صفحات_مطلوبة)
            # نحتاج ضغط هذه المنطقة
            متغير مرحّل_م = ضغط_منطقة(م، صفحات_مطلوبة * 2)
            إجمالي_مرحّل = إجمالي_مرحّل + مرحّل_م

            # تحديث أكبر كتلة (تقدير)
            متغير حرة = قراءة_ف(عن_منطقة_حرة، م)
            إذا (حرة > أكبر)
                كتابة_ف(عن_منطقة_أكبر_كتلة، م، حرة)
            نهاية
        نهاية

        م = م + 1
    نهاية

    kernel_print_string("[ضغط] ضغط مباشر: مرحّل ")
    kernel_print_number(إجمالي_مرحّل)
    kernel_print_string(" صفحة\n")

    ارجع إجمالي_مرحّل
