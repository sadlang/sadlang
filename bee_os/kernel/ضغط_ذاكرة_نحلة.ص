# إنشاء منطقة CMA
# ═══════════════════════════════════════════════════════════════════════════════

#** إنشاء منطقة CMA (Contiguous Memory Allocator)
#   بداية_cma: عنوان بداية المنطقة
#   نهاية_cma: عنوان نهاية المنطقة
#   تُرجع فهرس المنطقة أو -1
#
#   مناطق CMA تُحجز لتخصيصات كبيرة متجاورة (DMA, framebuffer)
#   الصفحات فيها قابلة للنقل عند الحاجة
**#
صدّر دالة إنشاء_cma(بداية_cma، نهاية_cma)
    إذا (تم_تهيئة_ضغط == 0)
        ارجع -1
    نهاية

    إذا (عدد_cma >= ثابت_اقصى_cma)
        kernel_print_string("[CMA] أقصى عدد مناطق CMA!\n")
        ارجع -1
    نهاية

    متغير فهرس = عدد_cma
    متغير مقاس_ن = نهاية_cma - بداية_cma
    متغير صفحات = مقاس_ن / ثابت_مقاس_صفحة

    كتابة_ف(عن_cma_بداية، فهرس، بداية_cma)
    كتابة_ف(عن_cma_نهاية، فهرس، نهاية_cma)
    كتابة_ف(عن_cma_إجمالي، فهرس، صفحات)
    كتابة_ف(عن_cma_حرة، فهرس، صفحات)
    كتابة_ف(عن_cma_محجوزة، فهرس، 0)

    عدد_cma = عدد_cma + 1

    kernel_print_string("[CMA] منطقة ")
    kernel_print_number(فهرس)
    kernel_print_string(": ")
    serial_put_hex(بداية_cma)
    kernel_print_string(" - ")
    serial_put_hex(نهاية_cma)
    kernel_print_string(" (")
    kernel_print_number(صفحات)
    kernel_print_string(" صفحة)\n")

    # تصنيف كل الصفحات في CMA كقابلة للنقل
    متغير صفحة_أولى = بداية_cma / ثابت_مقاس_صفحة
    تصنيف_نطاق(صفحة_أولى، صفحات، فئة_قابل_نقل)

    ارجع فهرس
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تخصيص CMA — تخصيص كتلة متجاورة
# ═══════════════════════════════════════════════════════════════════════════════

#** تخصيص كتلة متجاورة من منطقة CMA
#   فهرس_cma: فهرس منطقة CMA
#   صفحات_مطلوبة: عدد الصفحات المتجاورة المطلوبة
#   تُرجع عنوان بداية الكتلة أو 0
**#
صدّر دالة تخصيص_cma(فهرس_cma، صفحات_مطلوبة)
    إذا (فهرس_cma >= عدد_cma)
        ارجع 0
    نهاية

    متغير حرة = قراءة_ف(عن_cma_حرة، فهرس_cma)
    إذا (حرة < صفحات_مطلوبة)
        # محاولة ضغط CMA
        kernel_print_string("[CMA] ذاكرة غير كافية — محاولة ضغط\n")
        عداد_cma_ضغط = عداد_cma_ضغط + 1

        # في الواقع سنحتاج لإخلاء الصفحات المستخدمة
        ارجع 0
    نهاية

    # تخصيص من بداية المنطقة الحرة
    متغير بداية = قراءة_ف(عن_cma_بداية، فهرس_cma)
    متغير محجوزة = قراءة_ف(عن_cma_محجوزة، فهرس_cma)

    متغير عنوان_كتلة = بداية + (محجوزة * ثابت_مقاس_صفحة)

    كتابة_ف(عن_cma_حرة، فهرس_cma، حرة - صفحات_مطلوبة)
    كتابة_ف(عن_cma_محجوزة، فهرس_cma، محجوزة + صفحات_مطلوبة)

    عداد_cma_تخصيص = عداد_cma_تخصيص + 1

    kernel_print_string("[CMA] تخصيص ")
    kernel_print_number(صفحات_مطلوبة)
    kernel_print_string(" صفحة @ ")
    serial_put_hex(عنوان_كتلة)
    kernel_print_string("\n")

    ارجع عنوان_كتلة
نهاية

