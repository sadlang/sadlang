    # حفظ التصنيف القديم
    متغير تصنيف_قديم = قراءة_تصنيف(رقم_صفح)

    # فقط الصفحات القابلة للنقل يمكن عزلها
    إذا (تصنيف_قديم != فئة_قابل_نقل)
        إذا (تصنيف_قديم != فئة_قابل_استرداد)
            ارجع -1
        نهاية
    نهاية

    # تغيير التصنيف إلى معزول
    كتابة_تصنيف(رقم_صفح، فئة_معزول)
    عداد_صفحات_معزولة = عداد_صفحات_معزولة + 1

