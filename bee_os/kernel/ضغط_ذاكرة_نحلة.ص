# ضغط خلفي — صيانة دورية
# ═══════════════════════════════════════════════════════════════════════════════

#** ضغط خلفي: يعمل دورياً لمنع التجزئة
#   يفحص كل منطقة ويضغط تلك التي تحت العلامة المائية المنخفضة
#   تُرجع إجمالي الصفحات المرحّلة
**#
صدّر دالة ضغط_خلفي()
    إذا (تم_تهيئة_ضغط == 0)
        ارجع 0
    نهاية

    عداد_ضغط_خلفي = عداد_ضغط_خلفي + 1

    kernel_print_string("[ضغط] ضغط خلفي — فحص المناطق...\n")

    متغير إجمالي = 0

    متغير م = 0
    بينما (م < عدد_مناطق)
        متغير أكبر = قراءة_ف(عن_منطقة_أكبر_كتلة، م)
        متغير علامة_من = قراءة_ف(عن_منطقة_علامة_منخفضة، م)
        متغير علامة_عل = قراءة_ف(عن_منطقة_علامة_عالية، م)

        # فحص: هل أكبر كتلة حرة تحت العلامة المنخفضة؟
        إذا (أكبر < علامة_من)
            kernel_print_string("  منطقة ")
            kernel_print_number(م)
            kernel_print_string(": أكبر كتلة=")
            kernel_print_number(أكبر)
            kernel_print_string(" < علامة=")
            kernel_print_number(علامة_من)
            kernel_print_string(" → ضغط\n")

            # ضغط حتى الوصول للعلامة العالية
            متغير هدف = علامة_عل - أكبر
            متغير مرحّل = ضغط_منطقة(م، هدف)
            إجمالي = إجمالي + مرحّل
        وإلا
            kernel_print_string("  منطقة ")
            kernel_print_number(م)
            kernel_print_string(": أكبر كتلة=")
            kernel_print_number(أكبر)
            kernel_print_string(" — لا حاجة للضغط\n")
        نهاية

        م = م + 1
    نهاية

    kernel_print_string("[ضغط] خلفي اكتمل: ")
    kernel_print_number(إجمالي)
    kernel_print_string(" صفحة مرحّلة\n")

