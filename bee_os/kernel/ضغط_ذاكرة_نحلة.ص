    إذا (عن_خريطة_تصنيف == 0)
        ارجع فئة_غير_قابل
    نهاية
    إذا (رقم_صفح >= ثابت_اقصى_صفحات_خريطة)
        ارجع فئة_غير_قابل
    نهاية
    ارجع قراءة_ف(عن_خريطة_تصنيف، رقم_صفح)
نهاية

#** كتابة تصنيف صفحة في الخريطة **#
دالة كتابة_تصنيف(رقم_صفح، تصنيف)
    إذا (عن_خريطة_تصنيف == 0)
        ارجع -1
    نهاية
    إذا (رقم_صفح >= ثابت_اقصى_صفحات_خريطة)
        ارجع -1
    نهاية
    كتابة_ف(عن_خريطة_تصنيف، رقم_صفح، تصنيف)
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تصنيف نطاق من الصفحات
# ═══════════════════════════════════════════════════════════════════════════════

#** تصنيف نطاق من الصفحات بنفس التصنيف
#   صفحة_بداية: رقم الصفحة الأولى
#   عدد: عدد الصفحات
#   تصنيف: نوع التصنيف
**#
صدّر دالة تصنيف_نطاق(صفحة_بداية، عدد، تصنيف)
    متغير م = 0
    بينما (م < عدد)
        كتابة_تصنيف(صفحة_بداية + م، تصنيف)
        م = م + 1
    نهاية

    kernel_print_string("[ضغط] تصنيف ")
    kernel_print_number(عدد)
    kernel_print_string(" صفحة من ")
    kernel_print_number(صفحة_بداية)
    kernel_print_string(" كـ ")
    إذا (تصنيف == فئة_غير_قابل)
        kernel_print_string("غير قابل للنقل\n")
    وإلا
        إذا (تصنيف == فئة_قابل_نقل)
            kernel_print_string("قابل للنقل\n")
        وإلا
            إذا (تصنيف == فئة_قابل_استرداد)
                kernel_print_string("قابل للاسترداد\n")
            وإلا
                kernel_print_string("معزول\n")
            نهاية
        نهاية
    نهاية

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إضافة منطقة ضغط
# ═══════════════════════════════════════════════════════════════════════════════

#** إضافة منطقة ضغط جديدة
#   بداية: عنوان بداية المنطقة
#   خاتمة: عنوان نهاية المنطقة
#   تُرجع فهرس المنطقة أو -1
**#
صدّر دالة إضافة_منطقة(بداية، خاتمة)
    إذا (تم_تهيئة_ضغط == 0)
        ارجع -1
    نهاية

    إذا (عدد_مناطق >= ثابت_اقصى_مناطق)
        kernel_print_string("[ضغط] أقصى عدد مناطق!\n")
        ارجع -1
    نهاية

    متغير فهرس = عدد_مناطق
    متغير مقاس_ن = خاتمة - بداية
    متغير صفحات = مقاس_ن / ثابت_مقاس_صفحة

    كتابة_ف(عن_منطقة_بداية، فهرس، بداية)
    كتابة_ف(عن_منطقة_نهاية، فهرس، خاتمة)
    كتابة_ف(عن_منطقة_إجمالي، فهرس، صفحات)
    كتابة_ف(عن_منطقة_حرة، فهرس، صفحات)
    كتابة_ف(عن_منطقة_أكبر_كتلة، فهرس، صفحات)
    كتابة_ف(عن_منطقة_علامة_منخفضة، فهرس، ثابت_علامة_منخفضة_افتراضي)
    كتابة_ف(عن_منطقة_علامة_عالية، فهرس، ثابت_علامة_عالية_افتراضي)
    كتابة_ف(عن_منطقة_ماسح_حرة، فهرس، بداية)
    كتابة_ف(عن_منطقة_ماسح_مستخدمة، فهرس، خاتمة)
    كتابة_ف(عن_منطقة_عدد_ضغطات، فهرس، 0)
    كتابة_ف(عن_منطقة_مرحّلة، فهرس، 0)
    كتابة_ف(عن_منطقة_وضعية، فهرس، وضعية_خامل)

    عدد_مناطق = عدد_مناطق + 1

    kernel_print_string("  منطقة ضغط ")
    kernel_print_number(فهرس)
    kernel_print_string(": ")
    serial_put_hex(بداية)
    kernel_print_string(" - ")
    serial_put_hex(خاتمة)
    kernel_print_string(" (")
    kernel_print_number(صفحات)
    kernel_print_string(" صفحة)\n")

    ارجع فهرس
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# ماسح الصفحات الحرة — يبحث من الأسفل للأعلى
# ═══════════════════════════════════════════════════════════════════════════════

#** مسح من أسفل المنطقة بحثاً عن صفحة حرة
#   فهرس_منطقة: فهرس المنطقة
#   تُرجع عنوان الصفحة الحرة أو 0
**#
صدّر دالة مسح_حرة(فهرس_منطقة)
    إذا (فهرس_منطقة >= عدد_مناطق)
        ارجع 0
    نهاية

    متغير موقع_ماسح = قراءة_ف(عن_منطقة_ماسح_حرة، فهرس_منطقة)
    متغير نهاية_م = قراءة_ف(عن_منطقة_نهاية، فهرس_منطقة)
    متغير ماسح_مستخدمة = قراءة_ف(عن_منطقة_ماسح_مستخدمة، فهرس_منطقة)

    # ماسح الحرة يبدأ من الأسفل (البداية) ويتقدم للأعلى
    # يتوقف عندما يلتقي بماسح المستخدمة
    بينما (موقع_ماسح < ماسح_مستخدمة)
        # فحص: هل هذه الصفحة حرة (قابلة للنقل)؟
        متغير رقم_صفح = (موقع_ماسح - قراءة_ف(عن_منطقة_بداية، فهرس_منطقة)) / ثابت_مقاس_صفحة
        متغير تصنيف = قراءة_تصنيف(رقم_صفح)

        إذا (تصنيف == فئة_قابل_نقل)
            # وجدنا صفحة قابلة للنقل — يمكن استبدالها (هي "حرة" بالنسبة للماسح)
            # ولكن نبحث عن صفحة حقاً حرة لاستقبال
            # في المحاكاة نعتبر الصفحات غير المُصنّفة حرة
            كتابة_ف(عن_منطقة_ماسح_حرة، فهرس_منطقة، موقع_ماسح + ثابت_مقاس_صفحة)
            ارجع موقع_ماسح
        نهاية

        موقع_ماسح = موقع_ماسح + ثابت_مقاس_صفحة
    نهاية

    # وصلنا لماسح المستخدمة — لا مزيد من الحرة
    كتابة_ف(عن_منطقة_ماسح_حرة، فهرس_منطقة، موقع_ماسح)
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# ماسح الصفحات المستخدمة — يبحث من الأعلى للأسفل
# ═══════════════════════════════════════════════════════════════════════════════

#** مسح من أعلى المنطقة بحثاً عن صفحة مستخدمة قابلة للنقل
#   فهرس_منطقة: فهرس المنطقة
#   تُرجع عنوان الصفحة المستخدمة أو 0
**#
صدّر دالة مسح_مستخدمة(فهرس_منطقة)
    إذا (فهرس_منطقة >= عدد_مناطق)
        ارجع 0
    نهاية

    متغير موقع_ماسح = قراءة_ف(عن_منطقة_ماسح_مستخدمة، فهرس_منطقة)
    متغير بداية_م = قراءة_ف(عن_منطقة_بداية، فهرس_منطقة)
    متغير ماسح_حرة = قراءة_ف(عن_منطقة_ماسح_حرة، فهرس_منطقة)

    # ماسح المستخدمة يبدأ من الأعلى (النهاية) وينزل للأسفل
    بينما (موقع_ماسح > ماسح_حرة)
        موقع_ماسح = موقع_ماسح - ثابت_مقاس_صفحة

        متغير رقم_صفح = (موقع_ماسح - بداية_م) / ثابت_مقاس_صفحة
        متغير تصنيف = قراءة_تصنيف(رقم_صفح)

        # فقط الصفحات القابلة للنقل يمكن ترحيلها
        إذا (تصنيف == فئة_قابل_نقل)
            كتابة_ف(عن_منطقة_ماسح_مستخدمة، فهرس_منطقة، موقع_ماسح)
            ارجع موقع_ماسح
        نهاية

        # الصفحات غير القابلة تُترك في مكانها
        إذا (تصنيف == فئة_غير_قابل)
            تابع
        نهاية
    نهاية

    كتابة_ف(عن_منطقة_ماسح_مستخدمة، فهرس_منطقة، موقع_ماسح)
    ارجع 0
نهاية

