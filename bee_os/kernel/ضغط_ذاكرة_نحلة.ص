# ضغط منطقة — العملية الرئيسية
# ═══════════════════════════════════════════════════════════════════════════════

#** ضغط منطقة ذاكرة واحدة
#   فهرس_منطقة: فهرس المنطقة المراد ضغطها
#   اقصى_صفحات: أقصى عدد صفحات يتم ترحيلها
#   تُرجع عدد الصفحات المُرحّلة
#
#   الخوارزمية:
#   1. ماسح الحرة يبدأ من الأسفل
#   2. ماسح المستخدمة يبدأ من الأعلى
#   3. كل لقاء: ننقل صفحة مستخدمة من الأعلى إلى صفحة حرة في الأسفل
#   4. نكرر حتى يلتقي الماسحان أو نصل للحد الأقصى
**#
صدّر دالة ضغط_منطقة(فهرس_منطقة، اقصى_صفحات)
    إذا (تم_تهيئة_ضغط == 0)
        ارجع 0
    نهاية

    إذا (فهرس_منطقة >= عدد_مناطق)
        ارجع 0
    نهاية

    kernel_print_string("[ضغط] ضغط منطقة ")
    kernel_print_number(فهرس_منطقة)
    kernel_print_string("...\n")

    # تحديث الوضعية
    كتابة_ف(عن_منطقة_وضعية، فهرس_منطقة، وضعية_جاري)

    # إعادة ضبط الماسحات
    متغير بداية = قراءة_ف(عن_منطقة_بداية، فهرس_منطقة)
    متغير خاتمة = قراءة_ف(عن_منطقة_نهاية، فهرس_منطقة)
    كتابة_ف(عن_منطقة_ماسح_حرة، فهرس_منطقة، بداية)
    كتابة_ف(عن_منطقة_ماسح_مستخدمة، فهرس_منطقة، خاتمة)

    متغير مرحّلة = 0
    متغير حد = اقصى_صفحات
    إذا (حد > ثابت_اقصى_ترحيل_جلسة)
        حد = ثابت_اقصى_ترحيل_جلسة
    نهاية

    بينما (مرحّلة < حد)
        # البحث عن صفحة حرة (من الأسفل)
        متغير عنوان_حرة = مسح_حرة(فهرس_منطقة)
        إذا (عنوان_حرة == 0)
            اخرج
        نهاية

        # البحث عن صفحة مستخدمة (من الأعلى)
        متغير عنوان_مستخدمة = مسح_مستخدمة(فهرس_منطقة)
        إذا (عنوان_مستخدمة == 0)
            اخرج
        نهاية

        # فحص: هل الماسحان التقيا؟
        إذا (عنوان_حرة >= عنوان_مستخدمة)
            اخرج
        نهاية

        # ترحيل الصفحة
        متغير ناتج = ترحيل_صفحة(عنوان_مستخدمة، عنوان_حرة)
        إذا (ناتج == 0)
            مرحّلة = مرحّلة + 1
        نهاية
    نهاية

    # تحديث الإحصائيات
    متغير ضغطات = قراءة_ف(عن_منطقة_عدد_ضغطات، فهرس_منطقة)
    كتابة_ف(عن_منطقة_عدد_ضغطات، فهرس_منطقة، ضغطات + 1)

    متغير مرحّلة_سابقة = قراءة_ف(عن_منطقة_مرحّلة، فهرس_منطقة)
    كتابة_ف(عن_منطقة_مرحّلة، فهرس_منطقة، مرحّلة_سابقة + مرحّلة)

    # تحديث الوضعية
    كتابة_ف(عن_منطقة_وضعية، فهرس_منطقة، وضعية_مكتمل)

    kernel_print_string("  تم ترحيل ")
    kernel_print_number(مرحّلة)
    kernel_print_string(" صفحة\n")

    ارجع مرحّلة
نهاية

