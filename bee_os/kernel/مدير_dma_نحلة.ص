# كتابة حقل في قناة DMA
دالة dma_كتابة_حقل_قناة(قاعدة، فهرس_قناة، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_قناة * DMA_مقاس_قناة) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من قناة DMA
دالة dma_قراءة_حقل_قناة(قاعدة، فهرس_قناة، فهرس_حقل)
    متغير إزاحة = (فهرس_قناة * DMA_مقاس_قناة) + (فهرس_حقل * 4)
    ارجع mem_read_dword(قاعدة + إزاحة)
نهاية

# كتابة حقل في مخزن DMA
دالة dma_كتابة_حقل_مخزن(قاعدة، فهرس_مخزن، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_مخزن * DMA_مقاس_مخزن) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من مخزن DMA
دالة dma_قراءة_حقل_مخزن(قاعدة، فهرس_مخزن، فهرس_حقل)
    متغير إزاحة = (فهرس_مخزن * DMA_مقاس_مخزن) + (فهرس_حقل * 4)
