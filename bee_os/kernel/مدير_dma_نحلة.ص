# إنشاء عملية نقل جديدة
دالة dma_إنشاء_عملية_نقل(ترتيب_قناة، مصدر_ف، وجهة_ف، مقاس_م)
    # البحث عن فتحة فارغة
    متغير فتحة = -1
    متغير ف = 0
    بينما (ف < DMA_الحد_الأقصى_نقل)
        متغير وضعية_ن = dma_قراءة_حقل_نقل(dma_قاعدة_النقل، ف، 1)
        إذا (وضعية_ن == DMA_نقل_خامل)
            فتحة = ف
            اخرج
        نهاية
        # تنظيف العمليات المكتملة
        إذا (وضعية_ن == DMA_نقل_مكتمل)
            فتحة = ف
            اخرج
        نهاية
        إذا (وضعية_ن == DMA_نقل_فشل)
            فتحة = ف
            اخرج
        نهاية
        ف = ف + 1
    نهاية
    
    إذا (فتحة == -1)
        kernel_print_string("  [DMA] جدول النقل ممتلئ!")
        ارجع -1
    نهاية
    
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 0، ترتيب_قناة)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 1، DMA_نقل_جار)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 2، مصدر_ف)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 3، وجهة_ف)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 4، مقاس_م)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 5، 0)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 6، DMA_اتجاه_من_جهاز)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 7، 0)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 8، 0)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 9، 0)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 10، 0)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فتحة، 11، 3)
    
    dma_عدد_النقل = dma_عدد_النقل + 1
    
    ارجع فتحة
نهاية

# إكمال عملية نقل
صدّر دالة dma_إكمال_نقل(فهرس_نقل_م، بايت_منقولة)
    إذا (فهرس_نقل_م < 0)
        ارجع 0
    نهاية
    إذا (فهرس_نقل_م >= DMA_الحد_الأقصى_نقل)
        ارجع 0
    نهاية
    
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 1، DMA_نقل_مكتمل)
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 5، بايت_منقولة)
    
    # تحديث إحصائيات القناة
    متغير ترتيب_ق = dma_قراءة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 0)
    إذا (ترتيب_ق >= 0)
        إذا (ترتيب_ق < DMA_عدد_قنوات_ISA)
            متغير مكتملة = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_ق، 9)
            dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_ق، 9، مكتملة + 1)
            dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_ق، 4، بايت_منقولة)
        نهاية
    نهاية
    
    dma_إجمالي_نقل_مكتمل = dma_إجمالي_نقل_مكتمل + 1
    dma_إجمالي_بايت_منقولة = dma_إجمالي_بايت_منقولة + بايت_منقولة
    
    ارجع 1
نهاية

# فشل عملية نقل
صدّر دالة dma_فشل_نقل(فهرس_نقل_م)
    إذا (فهرس_نقل_م < 0)
        ارجع 0
    نهاية
    إذا (فهرس_نقل_م >= DMA_الحد_الأقصى_نقل)
        ارجع 0
    نهاية
    
    # فحص عدد المحاولات
    متغير محاولات = dma_قراءة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 10)
    متغير أقصى = dma_قراءة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 11)
    
    محاولات = محاولات + 1
    dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 10، محاولات)
    
    إذا (محاولات >= أقصى)
        # فشل نهائي
        dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 1، DMA_نقل_فشل)
        
        متغير ترتيب_ق = dma_قراءة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 0)
        إذا (ترتيب_ق >= 0)
            إذا (ترتيب_ق < DMA_عدد_قنوات_ISA)
                متغير أخطاء_ق = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_ق، 10)
                dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_ق، 10، أخطاء_ق + 1)
            نهاية
        نهاية
        
        dma_إجمالي_أخطاء = dma_إجمالي_أخطاء + 1
        
        kernel_print_string("  [DMA] فشل نهائي في النقل ")
        kernel_print_number(فهرس_نقل_م)
        ارجع 0
    وإلا
        # إعادة المحاولة
        dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 1، DMA_نقل_جار)
        dma_كتابة_حقل_نقل(dma_قاعدة_النقل، فهرس_نقل_م، 5، 0)
        
        kernel_print_string("  [DMA] إعادة محاولة النقل ")
        kernel_print_number(فهرس_نقل_م)
        kernel_print_string(" محاولة ")
        kernel_print_number(محاولات)
        ارجع 1
    نهاية
نهاية

