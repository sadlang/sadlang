# تحرير مخزن DMA
صدّر دالة dma_تحرير_مخزن(فهرس_مخزن)
    إذا (فهرس_مخزن < 0)
        ارجع 0
    نهاية
    إذا (فهرس_مخزن >= DMA_الحد_الأقصى_مخازن)
        ارجع 0
    نهاية
    
    متغير أعلام_مخ = dma_قراءة_حقل_مخزن(dma_قاعدة_المخازن، فهرس_مخزن، 3)
    متغير فحص_نشط = أعلام_مخ & DMA_مخزن_نشط
    إذا (فحص_نشط == 0)
