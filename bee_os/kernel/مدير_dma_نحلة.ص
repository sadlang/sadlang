# قراءة حقل من عملية نقل
دالة dma_قراءة_حقل_نقل(قاعدة، فهرس_نقل، فهرس_حقل)
    متغير إزاحة = (فهرس_نقل * DMA_مقاس_نقل) + (فهرس_حقل * 4)
