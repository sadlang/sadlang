# إنشاء قائمة Scatter-Gather جديدة
صدّر دالة dma_إنشاء_قائمة_SG()
    # إرجاع فهرس أول عنصر فارغ يمكن استخدامه كبداية القائمة
    متغير ف = 0
    بينما (ف < DMA_الحد_الأقصى_SG)
        متغير أعلام_sg = dma_قراءة_حقل_SG(dma_قاعدة_SG، ف، 2)
        متغير فحص_نشط = أعلام_sg & DMA_SG_نشط
        إذا (فحص_نشط == 0)
            # تمييز كبداية قائمة
            dma_كتابة_حقل_SG(dma_قاعدة_SG، ف، 2، DMA_SG_نشط | DMA_SG_آخر)
            dma_كتابة_حقل_SG(dma_قاعدة_SG، ف، 3، ف)
            dma_عدد_SG = dma_عدد_SG + 1
            
            kernel_print_string("  [DMA] إنشاء قائمة SG بداية=")
            kernel_print_number(ف)
            
            ارجع ف
        نهاية
        ف = ف + 1
    نهاية
    
    kernel_print_string("  [DMA] لا توجد عناصر SG فارغة!")
    ارجع -1
نهاية

# إضافة عنصر إلى قائمة Scatter-Gather
صدّر دالة dma_إضافة_SG(فهرس_قائمة، عنوان_فيزيائي، مقاس_جزء)
    إذا (فهرس_قائمة < 0)
        ارجع -1
    نهاية
    
    # البحث عن العنصر الأخير في القائمة
    متغير فهرس_حالي = فهرس_قائمة
    متغير وجدنا_آخر = 0
    
    بينما (وجدنا_آخر == 0)
        متغير أعلام_sg = dma_قراءة_حقل_SG(dma_قاعدة_SG، فهرس_حالي، 2)
        متغير فحص_آخر = أعلام_sg & DMA_SG_آخر
        إذا (فحص_آخر != 0)
            وجدنا_آخر = 1
        وإلا
            فهرس_حالي = فهرس_حالي + 1
            إذا (فهرس_حالي >= DMA_الحد_الأقصى_SG)
                ارجع -1
            نهاية
        نهاية
    نهاية
    
    # إزالة علم "آخر" من العنصر الحالي
    متغير أعلام_حالي = dma_قراءة_حقل_SG(dma_قاعدة_SG، فهرس_حالي، 2)
    متغير فحص_آخر_ح = أعلام_حالي & DMA_SG_آخر
    إذا (فحص_آخر_ح != 0)
        أعلام_حالي = أعلام_حالي - DMA_SG_آخر
        dma_كتابة_حقل_SG(dma_قاعدة_SG، فهرس_حالي، 2، أعلام_حالي)
    نهاية
    
    # البحث عن فتحة فارغة للعنصر الجديد
    متغير فتحة_جديدة = فهرس_حالي + 1
    بينما (فتحة_جديدة < DMA_الحد_الأقصى_SG)
        متغير أعلام_ف = dma_قراءة_حقل_SG(dma_قاعدة_SG، فتحة_جديدة، 2)
        متغير فحص_نشط_ف = أعلام_ف & DMA_SG_نشط
        إذا (فحص_نشط_ف == 0)
            اخرج
        نهاية
        فتحة_جديدة = فتحة_جديدة + 1
    نهاية
    
    إذا (فتحة_جديدة >= DMA_الحد_الأقصى_SG)
        kernel_print_string("  [DMA] SG ممتلئ!")
        ارجع -1
    نهاية
    
    # إضافة العنصر الجديد
    dma_كتابة_حقل_SG(dma_قاعدة_SG، فتحة_جديدة، 0، عنوان_فيزيائي)
    dma_كتابة_حقل_SG(dma_قاعدة_SG، فتحة_جديدة، 1، مقاس_جزء)
    dma_كتابة_حقل_SG(dma_قاعدة_SG، فتحة_جديدة، 2، DMA_SG_نشط | DMA_SG_آخر)
    dma_كتابة_حقل_SG(dma_قاعدة_SG، فتحة_جديدة، 3، فهرس_قائمة)
    
    dma_عدد_SG = dma_عدد_SG + 1
    
    ارجع فتحة_جديدة
نهاية

# حساب المقاس الكلي لقائمة SG
صدّر دالة dma_مقاس_SG(فهرس_قائمة)
    إذا (فهرس_قائمة < 0)
        ارجع 0
    نهاية
    
    متغير المقاس_الكلي = 0
    متغير فهرس_حالي = فهرس_قائمة
    متغير متابعة = 1
    
    بينما (متابعة == 1)
        إذا (فهرس_حالي >= DMA_الحد_الأقصى_SG)
            متابعة = 0
        وإلا
            متغير أعلام_sg = dma_قراءة_حقل_SG(dma_قاعدة_SG، فهرس_حالي، 2)
            متغير فحص_نشط = أعلام_sg & DMA_SG_نشط
            إذا (فحص_نشط == 0)
                متابعة = 0
            وإلا
                متغير مقاس_جزء = dma_قراءة_حقل_SG(dma_قاعدة_SG، فهرس_حالي، 1)
                المقاس_الكلي = المقاس_الكلي + مقاس_جزء
                
                متغير فحص_آخر = أعلام_sg & DMA_SG_آخر
                إذا (فحص_آخر != 0)
                    متابعة = 0
                وإلا
                    فهرس_حالي = فهرس_حالي + 1
                نهاية
            نهاية
        نهاية
    نهاية
    
    ارجع المقاس_الكلي
نهاية

