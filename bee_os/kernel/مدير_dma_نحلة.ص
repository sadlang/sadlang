# ===================================================================
# مخازن الارتداد (Bounce Buffers)
# ===================================================================

# تخصيص مخزن ارتداد لجهاز ذي قناع محدود
صدّر دالة dma_تخصيص_ارتداد(مقاس_مطلوب، قناع_عنوان)
    # مخزن الارتداد هو مخزن في منطقة عناوين منخفضة
    # يُستخدم عندما يكون المخزن الأصلي خارج نطاق الجهاز
    
    متغير فهرس_مخ = dma_تخصيص_مخزن(مقاس_مطلوب، قناع_عنوان)
    إذا (فهرس_مخ == -1)
        kernel_print_string("  [DMA] فشل تخصيص مخزن ارتداد!")
        ارجع -1
    نهاية
    
    # تمييز كمخزن ارتداد
    متغير أعلام_مخ = dma_قراءة_حقل_مخزن(dma_قاعدة_المخازن، فهرس_مخ، 3)
    أعلام_مخ = أعلام_مخ | DMA_مخزن_ارتداد
    dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، فهرس_مخ، 3، أعلام_مخ)
    
    kernel_print_string("  [DMA] مخزن ارتداد #")
    kernel_print_number(فهرس_مخ)
    
    ارجع فهرس_مخ
