# إعداد عملية نقل DMA على قناة محددة
صدّر دالة dma_إعداد_نقل(ترتيب_قناة، عنوان_فيزيائي، مقاس_نقل، اتجاه_م، وضع_نقل)
    إذا (ترتيب_قناة < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_قناة >= DMA_عدد_قنوات_ISA)
        ارجع 0
    نهاية
    
    # فحص أن القناة محجوزة
    متغير وضعية_ق = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 1)
    إذا (وضعية_ق != DMA_وضعية_مشغولة)
        kernel_print_string("  [DMA] القناة غير محجوزة!")
        ارجع 0
    نهاية
    
    # فحص قناع العنوان
    متغير قناع_ق = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 7)
    متغير فحص_قناع = عنوان_فيزيائي & قناع_ق
    إذا (فحص_قناع != عنوان_فيزيائي)
        kernel_print_string("  [DMA] العنوان يتجاوز قناع القناة!")
        serial_put_hex(عنوان_فيزيائي)
        ارجع 0
    نهاية
    
    # فحص عدم تجاوز حدود سطر البايت (DMA ISA: 64K boundary)
    إذا (ترتيب_قناة < 4)
        متغير حد_صفحة = 65536
        متغير صفحة_بداية = عنوان_فيزيائي / حد_صفحة
        متغير خاتمة_عنوان = عنوان_فيزيائي + مقاس_نقل - 1
        متغير صفحة_خاتمة = خاتمة_عنوان / حد_صفحة
        إذا (صفحة_بداية != صفحة_خاتمة)
            kernel_print_string("  [DMA] تحذير: النقل يتجاوز حد 64K!")
        نهاية
    نهاية
    
    # تخزين معلومات النقل
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 2، عنوان_فيزيائي)
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 3، مقاس_نقل)
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 4، 0)
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 5، اتجاه_م)
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 6، وضع_نقل)
    
    kernel_print_string("  [DMA] إعداد نقل: قناة=")
    kernel_print_number(ترتيب_قناة)
    kernel_print_string(" عنوان=")
    serial_put_hex(عنوان_فيزيائي)
    kernel_print_string(" مقاس=")
    kernel_print_number(مقاس_نقل)
    kernel_print_string(" اتجاه=")
    kernel_print_number(اتجاه_م)
    
    ارجع 1
نهاية

# بدء نقل DMA
صدّر دالة dma_بدء_نقل(ترتيب_قناة)
    إذا (ترتيب_قناة < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_قناة >= DMA_عدد_قنوات_ISA)
        ارجع 0
    نهاية
    
    متغير عنوان_ف = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 2)
    متغير مقاس_م = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 3)
    
    إذا (مقاس_م == 0)
        kernel_print_string("  [DMA] مقاس النقل صفر!")
        ارجع 0
    نهاية
    
    # إنشاء سجل عملية نقل
    متغير فهرس_نقل = dma_إنشاء_عملية_نقل(ترتيب_قناة، عنوان_ف، 0، مقاس_م)
    
    # تفعيل القناة
    متغير أعلام_ق = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 11)
    أعلام_ق = أعلام_ق | DMA_علم_نشط
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 11، أعلام_ق)
    
    kernel_print_string("  [DMA] بدء نقل على القناة ")
    kernel_print_number(ترتيب_قناة)
    
    ارجع فهرس_نقل
نهاية

# إيقاف نقل DMA
صدّر دالة dma_إيقاف_نقل(ترتيب_قناة)
    إذا (ترتيب_قناة < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_قناة >= DMA_عدد_قنوات_ISA)
        ارجع 0
    نهاية
    
    # إزالة علم النشاط
    متغير أعلام_ق = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 11)
    متغير فحص_نشط = أعلام_ق & DMA_علم_نشط
    إذا (فحص_نشط != 0)
        أعلام_ق = أعلام_ق - DMA_علم_نشط
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 11، أعلام_ق)
    نهاية
    
    kernel_print_string("  [DMA] إيقاف نقل القناة ")
    kernel_print_number(ترتيب_قناة)
    
    ارجع 1
نهاية

