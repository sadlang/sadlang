خارجي دالة kernel_allocate(المقاس)
خارجي دالة kernel_free(عنوان)
خارجي دالة mem_read_byte(عنوان)
خارجي دالة mem_write_byte(عنوان، قيمة)
خارجي دالة mem_read_dword(عنوان)
خارجي دالة mem_write_dword(عنوان، قيمة)
خارجي دالة sad_ll_memset(عنوان، قيمة، طول)
خارجي دالة sad_ll_memcpy(وجهة، مصدر، طول)

# ===================================================================
# ثوابت نظام DMA
# ===================================================================

# عدد قنوات ISA DMA
متغير DMA_عدد_قنوات_ISA = 8

# الحد الأقصى لعدد المخازن المؤقتة
متغير DMA_الحد_الأقصى_مخازن = 64

# الحد الأقصى لعناصر Scatter-Gather
متغير DMA_الحد_الأقصى_SG = 256

# الحد الأقصى لمخازن الارتداد
