# ===================================================================
# حقول قناة DMA
# ===================================================================
# الفهرس 0: ترتيب القناة (0-7)
# الفهرس 1: الوضعية (0=حرة، 1=مشغولة، 2=مكتملة، 3=خطأ)
# الفهرس 2: العنوان الفيزيائي الأساسي
# الفهرس 3: مقاس النقل (بالبايت)
# الفهرس 4: العداد الحالي
# الفهرس 5: اتجاه النقل (1=قراءة_جهاز، 2=كتابة_جهاز)
# الفهرس 6: وضعية النقل (1=مفرد، 2=كتلة، 3=طلب، 4=متتابع)
# الفهرس 7: قناع العنوان (24 بت أو 32 بت)
# الفهرس 8: معرف الجهاز المالك
# الفهرس 9: عدد عمليات النقل المكتملة
# الفهرس 10: عدد أخطاء النقل
# الفهرس 11: أعلام (bit0: تلقائي_تهيئة، bit1: تزايد_عنوان، bit2: نشط)
متغير DMA_حقول_قناة = 12
متغير DMA_مقاس_قناة = 48

# ===================================================================
# حقول مخزن DMA المؤقت
# ===================================================================
# الفهرس 0: العنوان الافتراضي
# الفهرس 1: العنوان الفيزيائي
# الفهرس 2: مقاس المخزن
# الفهرس 3: الأعلام (bit0: نشط، bit1: isa_متوافق، bit2: مخطط، bit3: ارتداد)
# الفهرس 4: ترتيب القناة المرتبطة
# الفهرس 5: قناع العنوان
# الفهرس 6: عدد مرات الاستخدام
# الفهرس 7: آخر وقت استخدام
متغير DMA_حقول_مخزن = 8
متغير DMA_مقاس_مخزن = 32

# ===================================================================
# حقول عنصر Scatter-Gather
# ===================================================================
# الفهرس 0: العنوان الفيزيائي
# الفهرس 1: مقاس الجزء
# الفهرس 2: أعلام (bit0: نشط، bit1: آخر_عنصر)
# الفهرس 3: فهرس القائمة الأم
متغير DMA_حقول_SG = 4
متغير DMA_مقاس_SG = 16

# ===================================================================
# حقول عملية النقل
# ===================================================================
# الفهرس 0: ترتيب القناة
# الفهرس 1: وضعية النقل (0=خامل، 1=جار، 2=مكتمل، 3=فشل)
# الفهرس 2: العنوان المصدر (فيزيائي)
# الفهرس 3: العنوان الوجهة (فيزيائي)
# الفهرس 4: المقاس الكلي
# الفهرس 5: المقاس المنقول حتى الآن
# الفهرس 6: اتجاه النقل
# الفهرس 7: أعلام
# الفهرس 8: فهرس المخزن المرتبط
# الفهرس 9: فهرس SG (إذا وُجد)
# الفهرس 10: عدد المحاولات
# الفهرس 11: أقصى محاولات
متغير DMA_حقول_نقل = 12
متغير DMA_مقاس_نقل = 48

