# تخطيط عنوان افتراضي إلى فيزيائي لـ DMA
صدّر دالة dma_تخطيط_للجهاز(عنوان_اف، مقاس_م، اتجاه_م)
    # في bare-metal identity mapping
    # العنوان الفيزيائي = الافتراضي
    متغير عنوان_ف = عنوان_اف
    
    # تسجيل التخطيط في أول مخزن فارغ
    متغير ف = 0
    بينما (ف < DMA_الحد_الأقصى_مخازن)
        متغير أعلام_مخ = dma_قراءة_حقل_مخزن(dma_قاعدة_المخازن، ف، 3)
        متغير فحص_نشط = أعلام_مخ & DMA_مخزن_نشط
        إذا (فحص_نشط == 0)
            dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، ف، 0، عنوان_اف)
            dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، ف، 1، عنوان_ف)
            dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، ف، 2، مقاس_م)
            dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، ف، 3، DMA_مخزن_نشط | DMA_مخزن_مخطط)
            dma_عدد_المخازن = dma_عدد_المخازن + 1
            اخرج
        نهاية
        ف = ف + 1
    نهاية
    
    ارجع عنوان_ف
نهاية

# إلغاء تخطيط DMA
صدّر دالة dma_إلغاء_تخطيط(عنوان_ف)
    متغير ف = 0
    بينما (ف < DMA_الحد_الأقصى_مخازن)
        متغير أعلام_مخ = dma_قراءة_حقل_مخزن(dma_قاعدة_المخازن، ف، 3)
        متغير فحص_مخطط = أعلام_مخ & DMA_مخزن_مخطط
        إذا (فحص_مخطط != 0)
            متغير عنوان_ف_م = dma_قراءة_حقل_مخزن(dma_قاعدة_المخازن، ف، 1)
            إذا (عنوان_ف_م == عنوان_ف)
                dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، ف، 3، 0)
                dma_عدد_المخازن = dma_عدد_المخازن - 1
                ارجع 1
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    ارجع 0
نهاية

