    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من عنصر SG
دالة dma_قراءة_حقل_SG(قاعدة، فهرس_sg، فهرس_حقل)
    متغير إزاحة = (فهرس_sg * DMA_مقاس_SG) + (فهرس_حقل * 4)
