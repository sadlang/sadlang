    ارجع 1
نهاية

# تهيئة جدول عمليات النقل
دالة dma_تهيئة_النقل()
    متغير المقاس_الكلي = DMA_الحد_الأقصى_نقل * DMA_مقاس_نقل
    
    dma_قاعدة_النقل = kernel_allocate(المقاس_الكلي)
    إذا (dma_قاعدة_النقل == 0)
        kernel_print_string("  [DMA] خطأ: فشل تخصيص جدول النقل")
        ارجع 0
    نهاية
    
    sad_ll_memset(dma_قاعدة_النقل، 0، المقاس_الكلي)
    dma_عدد_النقل = 0
    
    kernel_print_string("  [DMA] تهيئة جدول النقل - السعة: ")
    kernel_print_number(DMA_الحد_الأقصى_نقل)
    
    ارجع 1
نهاية

# ===================================================================
# إدارة القنوات
# ===================================================================

# حجز قناة DMA
صدّر دالة dma_حجز_قناة(ترتيب_قناة، معرف_جهاز_م)
    إذا (dma_مُهيّأ == 0)
        ارجع -1
    نهاية
    
    إذا (ترتيب_قناة < 0)
        ارجع -1
    نهاية
    إذا (ترتيب_قناة >= DMA_عدد_قنوات_ISA)
        ارجع -1
    نهاية
    
    # فحص هل القناة حرة
    متغير وضعية_ق = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 1)
    إذا (وضعية_ق != DMA_وضعية_حرة)
        kernel_print_string("  [DMA] القناة ")
        kernel_print_number(ترتيب_قناة)
        kernel_print_string(" مشغولة!")
        ارجع -1
    نهاية
    
    # القناة 4 محجوزة للتتابع (cascade)
    إذا (ترتيب_قناة == 4)
        kernel_print_string("  [DMA] القناة 4 محجوزة للتتابع!")
        ارجع -1
    نهاية
    
    # حجز القناة
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 1، DMA_وضعية_مشغولة)
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 8، معرف_جهاز_م)
    
    kernel_print_string("  [DMA] حجز القناة ")
    kernel_print_number(ترتيب_قناة)
    kernel_print_string(" للجهاز ")
    kernel_print_number(معرف_جهاز_م)
    
    ارجع ترتيب_قناة
نهاية

# تحرير قناة DMA
صدّر دالة dma_تحرير_قناة(ترتيب_قناة)
    إذا (ترتيب_قناة < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_قناة >= DMA_عدد_قنوات_ISA)
        ارجع 0
    نهاية
    
    متغير وضعية_ق = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 1)
    إذا (وضعية_ق == DMA_وضعية_حرة)
        ارجع 0
    نهاية
    
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 1، DMA_وضعية_حرة)
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 2، 0)
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 3، 0)
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 4، 0)
    dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ترتيب_قناة، 8، 0)
    
    kernel_print_string("  [DMA] تحرير القناة ")
    kernel_print_number(ترتيب_قناة)
    
    ارجع 1
نهاية

# البحث عن قناة حرة
صدّر دالة dma_قناة_حرة()
    متغير ف = 0
    بينما (ف < DMA_عدد_قنوات_ISA)
        # تخطي القناة 4 (cascade)
        إذا (ف != 4)
            متغير وضعية_ق = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ف، 1)
            إذا (وضعية_ق == DMA_وضعية_حرة)
                ارجع ف
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

# البحث عن قناة حرة بقناع ISA (24 بت)
صدّر دالة dma_قناة_حرة_ISA()
    متغير ف = 0
    بينما (ف < 4)
        متغير وضعية_ق = dma_قراءة_حقل_قناة(dma_قاعدة_القنوات، ف، 1)
        إذا (وضعية_ق == DMA_وضعية_حرة)
            ارجع ف
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

# ===================================================================
# إعداد النقل
