نهاية

# ===================================================================
# دوال التهيئة
# ===================================================================

# تهيئة جدول القنوات
دالة dma_تهيئة_القنوات()
    متغير المقاس_الكلي = DMA_عدد_قنوات_ISA * DMA_مقاس_قناة
    
    dma_قاعدة_القنوات = kernel_allocate(المقاس_الكلي)
    إذا (dma_قاعدة_القنوات == 0)
        kernel_print_string("  [DMA] خطأ: فشل تخصيص جدول القنوات")
        ارجع 0
    نهاية
    
    sad_ll_memset(dma_قاعدة_القنوات، 0، المقاس_الكلي)
    
    # تهيئة كل قناة
    متغير ف = 0
    بينما (ف < DMA_عدد_قنوات_ISA)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 0، ف)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 1، DMA_وضعية_حرة)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 2، 0)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 3، 0)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 4، 0)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 5، 0)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 6، DMA_وضع_مفرد)
        
        # القنوات 0-3 تستخدم قناع 24 بت (ISA)
        # القنوات 4-7 يمكنها استخدام 32 بت
        إذا (ف < 4)
            dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 7، DMA_قناع_ISA_24بت)
        وإلا
            dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 7، DMA_قناع_PCI_32بت)
        نهاية
        
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 8، 0)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 9، 0)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 10، 0)
        dma_كتابة_حقل_قناة(dma_قاعدة_القنوات، ف، 11، DMA_علم_تزايد)
        
        ف = ف + 1
    نهاية
    
    kernel_print_string("  [DMA] تهيئة القنوات - عدد: ")
    kernel_print_number(DMA_عدد_قنوات_ISA)
    
    ارجع 1
نهاية

# تهيئة جدول المخازن المؤقتة
دالة dma_تهيئة_المخازن()
    متغير المقاس_الكلي = DMA_الحد_الأقصى_مخازن * DMA_مقاس_مخزن
    
    dma_قاعدة_المخازن = kernel_allocate(المقاس_الكلي)
    إذا (dma_قاعدة_المخازن == 0)
        kernel_print_string("  [DMA] خطأ: فشل تخصيص جدول المخازن")
        ارجع 0
    نهاية
    
    sad_ll_memset(dma_قاعدة_المخازن، 0، المقاس_الكلي)
    
    متغير ف = 0
    بينما (ف < DMA_الحد_الأقصى_مخازن)
        dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، ف، 3، 0)
        ف = ف + 1
    نهاية
    
    dma_عدد_المخازن = 0
    kernel_print_string("  [DMA] تهيئة المخازن المؤقتة - السعة: ")
    kernel_print_number(DMA_الحد_الأقصى_مخازن)
    
    ارجع 1
نهاية

# تهيئة جدول Scatter-Gather
دالة dma_تهيئة_SG()
    متغير المقاس_الكلي = DMA_الحد_الأقصى_SG * DMA_مقاس_SG
    
    dma_قاعدة_SG = kernel_allocate(المقاس_الكلي)
    إذا (dma_قاعدة_SG == 0)
        kernel_print_string("  [DMA] خطأ: فشل تخصيص جدول SG")
