# تخصيص مخزن DMA (متوافق مع قناع العنوان)
صدّر دالة dma_تخصيص_مخزن(مقاس_مطلوب، قناع_عنوان)
    إذا (dma_مُهيّأ == 0)
        ارجع -1
    نهاية
    
    # البحث عن فتحة فارغة
    متغير فتحة = -1
    متغير ف = 0
    بينما (ف < DMA_الحد_الأقصى_مخازن)
        متغير أعلام_مخ = dma_قراءة_حقل_مخزن(dma_قاعدة_المخازن، ف، 3)
        متغير فحص_نشط = أعلام_مخ & DMA_مخزن_نشط
        إذا (فحص_نشط == 0)
            فتحة = ف
            اخرج
        نهاية
        ف = ف + 1
    نهاية
    
    إذا (فتحة == -1)
        kernel_print_string("  [DMA] جدول المخازن ممتلئ!")
        ارجع -1
    نهاية
    
    # محاذاة المقاس لحدود الصفحة
    متغير باقي_م = مقاس_مطلوب - ((مقاس_مطلوب / DMA_مقاس_صفحة) * DMA_مقاس_صفحة)
    متغير مقاس_محاذى = مقاس_مطلوب
    إذا (باقي_م != 0)
        مقاس_محاذى = مقاس_مطلوب + (DMA_مقاس_صفحة - باقي_م)
    نهاية
    
    # تخصيص الذاكرة
    متغير عنوان_اف = kernel_allocate(مقاس_محاذى)
    إذا (عنوان_اف == 0)
        kernel_print_string("  [DMA] فشل تخصيص مخزن DMA!")
        ارجع -1
    نهاية
    
    # في bare-metal العنوان الفيزيائي = الافتراضي
    متغير عنوان_ف = عنوان_اف
    
    # فحص القناع
    متغير فحص_قناع = عنوان_ف & قناع_عنوان
    إذا (فحص_قناع != عنوان_ف)
        kernel_print_string("  [DMA] تحذير: العنوان يتجاوز قناع DMA!")
        # نحتاج مخزن ارتداد
    نهاية
    
    # تصفير المخزن
    sad_ll_memset(عنوان_اف، 0، مقاس_محاذى)
    
    # تخزين معلومات المخزن
    متغير أعلام_جديدة = DMA_مخزن_نشط
    
    # فحص توافق ISA
    إذا (عنوان_ف < DMA_حد_ISA)
        أعلام_جديدة = أعلام_جديدة | DMA_مخزن_ISA
    نهاية
    
    dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، فتحة، 0، عنوان_اف)
    dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، فتحة، 1، عنوان_ف)
    dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، فتحة، 2، مقاس_محاذى)
    dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، فتحة، 3، أعلام_جديدة)
    dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، فتحة، 4، 0)
    dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، فتحة، 5، قناع_عنوان)
    dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، فتحة، 6، 0)
    dma_كتابة_حقل_مخزن(dma_قاعدة_المخازن، فتحة، 7، 0)
    
    dma_عدد_المخازن = dma_عدد_المخازن + 1
    
    kernel_print_string("  [DMA] مخزن #")
    kernel_print_number(فتحة)
    kernel_print_string(" عنوان=")
    serial_put_hex(عنوان_اف)
    kernel_print_string(" مقاس=")
    kernel_print_number(مقاس_محاذى)
    
    ارجع فتحة
نهاية

