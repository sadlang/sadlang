#** =====================================================================
# نظام إدارة الإطارات الفيزيائية — نحلة أو إس
# Physical Frame Allocator — BeeOS
# =====================================================================
#
# هذا الملف يحتوي على نظام إدارة الإطارات الفيزيائية الكامل لنواة نحلة.
# الإطار الفيزيائي هو وحدة الذاكرة الأساسية بمقاس 4 كيلوبايت (4096 بايت).
#
# المكونات: خريطة بتات، مناطق الذاكرة، عداد المراجع، نظام الرفيق
# الثوابت: صفحة=4096، أقصى_إطارات=32768 (128 ميجابايت)
# رقم الوحدة: init_79
# =====================================================================
**#

# ============================================================
# التصريحات الخارجية
# ============================================================
خارجي دالة kernel_print_string(عنوان_سلسلة)
خارجي دالة kernel_print_number(قيمة)
خارجي دالة serial_put_hex(قيمة)
خارجي دالة kernel_allocate(المقاس)
خارجي دالة kernel_free(عنوان)
خارجي دالة mem_read_byte(عنوان)
خارجي دالة mem_write_byte(عنوان، قيمة)
خارجي دالة mem_read_dword(عنوان)
خارجي دالة mem_write_dword(عنوان، قيمة)
خارجي دالة sad_ll_page_alloc()
خارجي دالة sad_ll_page_free(عنوان)
خارجي دالة sad_ll_pages_alloc(عدد)
خارجي دالة sad_ll_pages_free(عنوان، عدد)
خارجي دالة sad_ll_memset(عنوان، قيمة، طول)
خارجي دالة sad_ll_memcpy(وجهة، مصدر، طول)

# ============================================================
# الثوابت العامة
# ============================================================
متغير ثابت_مقاس_صفحة = 4096
متغير ثابت_اقصى_إطارات = 32768
متغير ثابت_لفظات_خريطة = 1024
متغير ثابت_مقاس_خريطة = 4096
متغير ثابت_بداية_dma = 0
متغير ثابت_نهاية_dma = 16777216
متغير ثابت_بداية_عادية = 16777216
متغير ثابت_نهاية_عادية = 134217728
متغير ثابت_اقصى_رتبة = 10
متغير ثابت_بداية_تجمع = 4194304

# أعلام الإطارات
متغير علم_مستخدم = 1
متغير علم_محجوز = 2
متغير علم_نواة = 4
متغير علم_مستخدم_عمليات = 8
متغير علم_مشترك = 16
متغير علم_قذر = 32
متغير علم_مقفل = 64
متغير علم_تبديل = 128

# ============================================================
# المتغيرات العامة
# ============================================================
متغير عنوان_خريطة_بتات = 0
متغير عنوان_جدول_مراجع = 0
متغير عنوان_جدول_اعلام = 0
متغير عنوان_قوائم_رفيق = 0
متغير إجمالي_إطارات = 0
متغير إطارات_حرة = 0
متغير إطارات_مستخدمة = 0
متغير إطارات_محجوزة = 0
متغير إطارات_مشتركة = 0
متغير عداد_تخصيص = 0
متغير عداد_تحرير = 0
متغير عداد_فشل = 0
متغير dma_إجمالي = 0
متغير dma_حرة = 0
متغير dma_مستخدمة = 0
متغير عادية_إجمالي = 0
متغير عادية_حرة = 0
متغير عادية_مستخدمة = 0
متغير تم_التهيئة = 0

# ============================================================
# خريطة البتات — التهيئة
# ============================================================
دالة تهيئة_خريطة_بتات()
    متغير ذاكرة = kernel_allocate(ثابت_مقاس_خريطة)
    إذا (ذاكرة == 0)
        kernel_print_string("  [خطأ] فشل تخصيص خريطة البتات")
        kernel_print_number(10)
        ارجع 0
    نهاية
    عنوان_خريطة_بتات = ذاكرة
    متغير م = 0
    بينما (م < ثابت_لفظات_خريطة)
        mem_write_dword(عنوان_خريطة_بتات + م * 4، 0)
        م = م + 1
    نهاية
    kernel_print_string("  [إطارات] تم تهيئة خريطة البتات")
    kernel_print_number(10)
    ارجع 1
نهاية

# ============================================================
# خريطة البتات — ضبط/مسح/فحص بت
# ============================================================

# ضبط بت (تعليم إطار كمستخدم)
دالة نقش_ضبط_بت(ترتيب_الإطار)
    إذا (ترتيب_الإطار < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_الإطار >= ثابت_اقصى_إطارات)
        ارجع 0
    نهاية
    متغير فهرس_لفظة = ترتيب_الإطار / 32
    متغير موضع_بت = ترتيب_الإطار % 32
    متغير عنوان_لفظة = عنوان_خريطة_بتات + فهرس_لفظة * 4
    متغير لفظة_حالية = mem_read_dword(عنوان_لفظة)
    متغير قناع = 1 << موضع_بت
    متغير لفظة_جديدة = لفظة_حالية | قناع
    mem_write_dword(عنوان_لفظة، لفظة_جديدة)
    ارجع 1
نهاية

# مسح بت (تعليم إطار كحر)
دالة نقش_مسح_بت(ترتيب_الإطار)
    إذا (ترتيب_الإطار < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_الإطار >= ثابت_اقصى_إطارات)
        ارجع 0
    نهاية
    متغير فهرس_لفظة = ترتيب_الإطار / 32
    متغير موضع_بت = ترتيب_الإطار % 32
    متغير عنوان_لفظة = عنوان_خريطة_بتات + فهرس_لفظة * 4
    متغير لفظة_حالية = mem_read_dword(عنوان_لفظة)
    متغير قناع = 1 << موضع_بت
    متغير قناع_عكسي = ~قناع
    متغير لفظة_جديدة = لفظة_حالية & قناع_عكسي
    mem_write_dword(عنوان_لفظة، لفظة_جديدة)
    ارجع 1
نهاية

# فحص بت — 1=مستخدم، 0=حر
دالة نقش_فحص_بت(ترتيب_الإطار)
    إذا (ترتيب_الإطار < 0)
        ارجع 1
    نهاية
    إذا (ترتيب_الإطار >= ثابت_اقصى_إطارات)
        ارجع 1
    نهاية
    متغير فهرس_لفظة = ترتيب_الإطار / 32
    متغير موضع_بت = ترتيب_الإطار % 32
    متغير لفظة_حالية = mem_read_dword(عنوان_خريطة_بتات + فهرس_لفظة * 4)
    متغير نتيجة = (لفظة_حالية >> موضع_بت) & 1
    ارجع نتيجة
نهاية

# ============================================================
# خريطة البتات — البحث
# ============================================================

# البحث عن أول إطار حر
دالة نقش_بحث_حر()
    متغير ك = 0
    بينما (ك < ثابت_لفظات_خريطة)
        متغير لفظة = mem_read_dword(عنوان_خريطة_بتات + ك * 4)
        إذا (لفظة != 4294967295)
            متغير ب = 0
            بينما (ب < 32)
                متغير قناع = 1 << ب
                إذا ((لفظة & قناع) == 0)
                    متغير ترتيب_إطار = ك * 32 + ب
                    إذا (ترتيب_إطار < ثابت_اقصى_إطارات)
                        ارجع ترتيب_إطار
                    نهاية
                نهاية
                ب = ب + 1
            نهاية
        نهاية
        ك = ك + 1
    نهاية
    ارجع -1
نهاية

# البحث عن أول إطار حر ضمن نطاق
دالة نقش_بحث_حر_نطاق(بداية، نهاية_بحث)
    متغير إ = بداية
    بينما (إ < نهاية_بحث)
        إذا (إ >= ثابت_اقصى_إطارات)
            ارجع -1
        نهاية
        إذا (نقش_فحص_بت(إ) == 0)
            ارجع إ
        نهاية
        إ = إ + 1
    نهاية
    ارجع -1
نهاية

# البحث عن إطارات متتالية حرة
دالة نقش_بحث_متتالي(عدد_مطلوب)
    إذا (عدد_مطلوب <= 0)
        ارجع -1
    نهاية
    إذا (عدد_مطلوب == 1)
        ارجع نقش_بحث_حر()
    نهاية
    متغير بداية_سلسلة = -1
    متغير عدد_متتالي = 0
    متغير إ = 0
    بينما (إ < ثابت_اقصى_إطارات)
        إذا (نقش_فحص_بت(إ) == 0)
            إذا (عدد_متتالي == 0)
                بداية_سلسلة = إ
            نهاية
            عدد_متتالي = عدد_متتالي + 1
            إذا (عدد_متتالي >= عدد_مطلوب)
                ارجع بداية_سلسلة
            نهاية
        وإلا
            عدد_متتالي = 0
            بداية_سلسلة = -1
        نهاية
        إ = إ + 1
    نهاية
    ارجع -1
نهاية

# عد الإطارات الحرة
دالة نقش_عد_حرة()
    متغير عدد = 0
    متغير ك = 0
    بينما (ك < ثابت_لفظات_خريطة)
        متغير لفظة = mem_read_dword(عنوان_خريطة_بتات + ك * 4)
        متغير ب = 0
        بينما (ب < 32)
            متغير ترتيب_إطار = ك * 32 + ب
            إذا (ترتيب_إطار < ثابت_اقصى_إطارات)
                إذا (((لفظة >> ب) & 1) == 0)
                    عدد = عدد + 1
                نهاية
            نهاية
            ب = ب + 1
        نهاية
        ك = ك + 1
    نهاية
    ارجع عدد
نهاية

# عد الإطارات المستخدمة
دالة نقش_عد_مستخدمة()
    متغير عدد = 0
    متغير ك = 0
    بينما (ك < ثابت_لفظات_خريطة)
        متغير لفظة = mem_read_dword(عنوان_خريطة_بتات + ك * 4)
        متغير ب = 0
        بينما (ب < 32)
            متغير ترتيب_إطار = ك * 32 + ب
            إذا (ترتيب_إطار < ثابت_اقصى_إطارات)
                إذا (((لفظة >> ب) & 1) == 1)
                    عدد = عدد + 1
                نهاية
            نهاية
            ب = ب + 1
        نهاية
        ك = ك + 1
    نهاية
    ارجع عدد
نهاية

# حجز مجموعة إطارات
دالة نقش_حجز_مجموعة(بداية_حجز، عدد_حجز)
    متغير إ = 0
    بينما (إ < عدد_حجز)
        نقش_ضبط_بت(بداية_حجز + إ)
        إ = إ + 1
    نهاية
    ارجع عدد_حجز
نهاية

# تحرير مجموعة إطارات
دالة نقش_تحرير_مجموعة(بداية_تحرير، عدد_تحرير)
    متغير إ = 0
    بينما (إ < عدد_تحرير)
        نقش_مسح_بت(بداية_تحرير + إ)
        إ = إ + 1
    نهاية
    ارجع عدد_تحرير
نهاية

# ============================================================
# جدول عداد المراجع
# ============================================================

# تهيئة جدول المراجع (32768 × 4 = 131072 بايت)
دالة تهيئة_جدول_مراجع()
    متغير مقاس_جدول = ثابت_اقصى_إطارات * 4
    متغير ذاكرة = kernel_allocate(مقاس_جدول)
    إذا (ذاكرة == 0)
        kernel_print_string("  [خطأ] فشل تخصيص جدول المراجع")
        kernel_print_number(10)
        ارجع 0
    نهاية
    عنوان_جدول_مراجع = ذاكرة
    sad_ll_memset(عنوان_جدول_مراجع، 0، مقاس_جدول)
    kernel_print_string("  [إطارات] تم تهيئة جدول المراجع")
    kernel_print_number(10)
    ارجع 1
نهاية

# قراءة عداد مراجع
دالة مرجع_قراءة(ترتيب_الإطار)
    إذا (ترتيب_الإطار < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_الإطار >= ثابت_اقصى_إطارات)
        ارجع 0
    نهاية
    ارجع mem_read_dword(عنوان_جدول_مراجع + ترتيب_الإطار * 4)
نهاية

# كتابة عداد مراجع
دالة مرجع_كتابة(ترتيب_الإطار، قيمة_جديدة)
    إذا (ترتيب_الإطار < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_الإطار >= ثابت_اقصى_إطارات)
        ارجع 0
    نهاية
    mem_write_dword(عنوان_جدول_مراجع + ترتيب_الإطار * 4، قيمة_جديدة)
    ارجع 1
نهاية

# زيادة عداد مراجع
دالة مرجع_زيادة(ترتيب_الإطار)
    متغير عداد_حالي = مرجع_قراءة(ترتيب_الإطار)
    متغير عداد_جديد = عداد_حالي + 1
    مرجع_كتابة(ترتيب_الإطار، عداد_جديد)
    إذا (عداد_جديد == 2)
        إطارات_مشتركة = إطارات_مشتركة + 1
    نهاية
    ارجع عداد_جديد
نهاية

# نقصان عداد مراجع — يحرر الإطار إذا وصل 0
دالة مرجع_نقصان(ترتيب_الإطار)
    متغير عداد_حالي = مرجع_قراءة(ترتيب_الإطار)
    إذا (عداد_حالي <= 0)
        ارجع 0
    نهاية
    متغير عداد_جديد = عداد_حالي - 1
    مرجع_كتابة(ترتيب_الإطار، عداد_جديد)
    إذا (عداد_حالي == 2)
        إطارات_مشتركة = إطارات_مشتركة - 1
    نهاية
    إذا (عداد_جديد == 0)
        نقش_مسح_بت(ترتيب_الإطار)
        إطارات_حرة = إطارات_حرة + 1
        إطارات_مستخدمة = إطارات_مستخدمة - 1
    نهاية
    ارجع عداد_جديد
نهاية

# ============================================================
# جدول أعلام الإطارات
# ============================================================

# تهيئة جدول الأعلام
دالة تهيئة_جدول_اعلام()
    متغير مقاس_جدول = ثابت_اقصى_إطارات * 4
    متغير ذاكرة = kernel_allocate(مقاس_جدول)
    إذا (ذاكرة == 0)
        kernel_print_string("  [خطأ] فشل تخصيص جدول الأعلام")
        kernel_print_number(10)
        ارجع 0
    نهاية
    عنوان_جدول_اعلام = ذاكرة
    sad_ll_memset(عنوان_جدول_اعلام، 0، مقاس_جدول)
    kernel_print_string("  [إطارات] تم تهيئة جدول الأعلام")
    kernel_print_number(10)
    ارجع 1
نهاية

# قراءة أعلام إطار
دالة اعلام_قراءة(ترتيب_الإطار)
    إذا (ترتيب_الإطار < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_الإطار >= ثابت_اقصى_إطارات)
        ارجع 0
    نهاية
    ارجع mem_read_dword(عنوان_جدول_اعلام + ترتيب_الإطار * 4)
نهاية

# كتابة أعلام إطار
دالة اعلام_كتابة(ترتيب_الإطار، اعلام)
    إذا (ترتيب_الإطار < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_الإطار >= ثابت_اقصى_إطارات)
        ارجع 0
    نهاية
    mem_write_dword(عنوان_جدول_اعلام + ترتيب_الإطار * 4، اعلام)
    ارجع 1
نهاية

# إضافة علم
دالة اعلام_إضافة(ترتيب_الإطار، علم)
    متغير اعلام_حالية = اعلام_قراءة(ترتيب_الإطار)
    متغير اعلام_جديدة = اعلام_حالية | علم
    اعلام_كتابة(ترتيب_الإطار، اعلام_جديدة)
    ارجع اعلام_جديدة
نهاية

# إزالة علم
دالة اعلام_إزالة(ترتيب_الإطار، علم)
    متغير اعلام_حالية = اعلام_قراءة(ترتيب_الإطار)
    متغير اعلام_جديدة = اعلام_حالية & (~علم)
    اعلام_كتابة(ترتيب_الإطار، اعلام_جديدة)
    ارجع اعلام_جديدة
نهاية

# فحص علم — 1=مضبوط، 0=غير مضبوط
دالة اعلام_فحص(ترتيب_الإطار، علم)
    متغير اعلام_حالية = اعلام_قراءة(ترتيب_الإطار)
    إذا ((اعلام_حالية & علم) != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ============================================================
# تحويل العناوين
# ============================================================

# تحويل ترتيب إطار إلى عنوان فيزيائي
دالة إطار_إلى_عنوان(ترتيب_الإطار)
    ارجع ثابت_بداية_تجمع + ترتيب_الإطار * ثابت_مقاس_صفحة
نهاية

# تحويل عنوان فيزيائي إلى ترتيب إطار
دالة عنوان_إلى_إطار(عنوان)
    إذا (عنوان < ثابت_بداية_تجمع)
        ارجع -1
    نهاية
    ارجع (عنوان - ثابت_بداية_تجمع) / ثابت_مقاس_صفحة
نهاية

# محاذاة للأسفل لحدود صفحة
دالة محاذاة_صفحة(عنوان)
    ارجع عنوان & (~4095)
نهاية

# محاذاة للأعلى لحدود صفحة
دالة محاذاة_صفحة_أعلى(عنوان)
    ارجع (عنوان + 4095) & (~4095)
نهاية

# ============================================================
# تخصيص وتحرير الإطارات
# ============================================================

# تخصيص إطار فيزيائي واحد — يُرجع العنوان أو 0
دالة تخصيص_إطار()
    متغير ترتيب = نقش_بحث_حر()
    إذا (ترتيب < 0)
        عداد_فشل = عداد_فشل + 1
        ارجع 0
    نهاية
    نقش_ضبط_بت(ترتيب)
    مرجع_كتابة(ترتيب، 1)
    اعلام_كتابة(ترتيب، علم_مستخدم)
    متغير عنوان = إطار_إلى_عنوان(ترتيب)
    sad_ll_memset(عنوان، 0، ثابت_مقاس_صفحة)
    إطارات_حرة = إطارات_حرة - 1
    إطارات_مستخدمة = إطارات_مستخدمة + 1
    عداد_تخصيص = عداد_تخصيص + 1
    ارجع عنوان
نهاية

# تحرير إطار فيزيائي — يُرجع 1=نجاح، 0=فشل
دالة تحرير_إطار(عنوان)
    متغير ترتيب = عنوان_إلى_إطار(عنوان)
    إذا (ترتيب < 0)
        ارجع 0
    نهاية
    إذا (ترتيب >= ثابت_اقصى_إطارات)
        ارجع 0
    نهاية
    إذا (نقش_فحص_بت(ترتيب) == 0)
        ارجع 0
    نهاية
    متغير اعلام = اعلام_قراءة(ترتيب)
    إذا ((اعلام & علم_محجوز) != 0)
        ارجع 0
    نهاية
    متغير عداد = مرجع_نقصان(ترتيب)
    إذا (عداد > 0)
        ارجع 1
    نهاية
    اعلام_كتابة(ترتيب، 0)
