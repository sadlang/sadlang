#* حساب تجزئة بسيطة لمسار (تجزئة رقم)
   تُستخدم لمطابقة المسارات في نقاط التركيب
   المعاملات: عدد المكونات ومصفوفة التجزئات
   ترجع: تجزئة مدمجة *#
صدّر دالة مسار_تجزئة_من_مكونات(عدد)
    متغير تجزئة = 5381
    متغير ف = 0
    بينما (ف < عدد)
        متغير قم = اقرأ_مكون(ف)
        # خوارزمية DJB2 مبسطة
        تجزئة = تجزئة * 33 + قم
        # منع الفائض بالقصر إلى 32 بت
        تجزئة = تجزئة - (تجزئة / 4294967296) * 4294967296
        ف = ف + 1
    نهاية
    ارجع تجزئة
نهاية

#* البحث في ذاكرة الحل المؤقتة
   ترجع: فهرس nأو -1 إذا غير موجود*#
صدّر دالة مسار_ابحث_ذاكرة(تجزئة_مسار)
    متغير خ = 0
    بينما (خ < 8)
        متغير تج = اقرأ_حل_تجزئة(خ)
        إذا (تج == تجزئة_مسار)
            عداد_إصابة_ذاكرة = عداد_إصابة_ذاكرة + 1
            ارجع خ
        نهاية
        خ = خ + 1
    نهاية
    ارجع -1
نهاية

#* حل مسار إلى نقطة تركيب
   يبحث عن أطول مسار مطابق في نقاط التركيب
   المعاملات: تجزئة المسار الكامل
   ترجع: فهرس نقطة التركيب أو -1 *#
صدّر دالة مسار_حل(تجزئة_مسار)
    عداد_بحث_مسار = عداد_بحث_مسار + 1
    
    # 1. البحث في الذاكرة المؤقتة أولاً
    متغير ذاكرة = مسار_ابحث_ذاكرة(تجزئة_مسار)
    إذا (ذاكرة >= 0)
        ارجع ذاكرة
    نهاية
    
    # 2. البحث في جدول نقاط التركيب
    متغير نتيجة = vfs_جد_تركيب(تجزئة_مسار)
    إذا (نتيجة >= 0)
        # حفظ في الذاكرة المؤقتة
        متغير فه = حل_مؤشر + 0
        إذا (فه >= 8)
            فه = 0
        نهاية
        اكتب_حل(فه، تجزئة_مسار، نتيجة، 2)
        حل_مؤشر = فه + 1
        ارجع نتيجة
    نهاية
    
    # 3. في حال عدم وجود تركيب مطابق، ارجع الجذر
    متغير جذر = vfs_جد_تركيب(0)
    إذا (جذر >= 0)
        ارجع جذر
    نهاية
    
    ارجع -1
نهاية

#* تحقق هل المسار مطلق (يبدأ بـ /) *#
