#* تعيين الدليل الحالي
   المعاملات: تجزئة المسار، عدد المكونات، فهرس التركيب
   ترجع: 0 عند النجاح *#
صدّر دالة مسار_عيّن_دليل(تجزئة، عدد، فهرس_تركيب)
    # نسخ المكونات إلى جدول الدليل الحالي
    متغير ك = 0
    بينما (ك < 16)
        إذا (ك < عدد)
            متغير قم = اقرأ_مكون(ك)
            اكتب_دليل_حالي(ك، قم)
        وإلا
            اكتب_دليل_حالي(ك، 0)
        نهاية
        ك = ك + 1
    نهاية
    
    عمق_دليل_حالي = عدد + 0
    تركيب_دليل_حالي = فهرس_تركيب + 0
    عداد_تغيير_دليل = عداد_تغيير_دليل + 1
    
    kernel_print_string("  [path] CWD changed, depth=")
    kernel_print_number(عدد)
    kernel_print_number(10)
    ارجع 0
نهاية

#* الانتقال لأعلى في المسار (cd ..)
   ترجع: 0 عند النجاح، -1 إذا في الجذر *#
صدّر دالة مسار_فوق()
    إذا (عمق_دليل_حالي <= 0)
        ارجع -1
    نهاية
    
    عمق_دليل_حالي = عمق_دليل_حالي - 1
    اكتب_دليل_حالي(عمق_دليل_حالي، 0)
    
    عداد_تغيير_دليل = عداد_تغيير_دليل + 1
    ارجع 0
نهاية

#* الانتقال لأسفل في المسار (cd child)
