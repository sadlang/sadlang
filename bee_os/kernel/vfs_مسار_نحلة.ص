#* مقارنة مكونين مسار
   ترجع: 1 إذا متطابقان *#
صدّر دالة مسار_تطابق(عمق1، عمق2)
    إذا (عمق1 != عمق2)
        ارجع 0
    نهاية
    
    متغير ط = 0
    بينما (ط < عمق1)
        متغير م1 = اقرأ_مكون(ط)
        متغير م2 = اقرأ_دليل_حالي(ط)
        إذا (م1 != م2)
            ارجع 0
        نهاية
        ط = ط + 1
    نهاية
    ارجع 1
نهاية

