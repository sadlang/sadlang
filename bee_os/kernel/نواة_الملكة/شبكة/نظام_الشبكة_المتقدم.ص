# نظام_الشبكة_المتقدم.ص - TCP/IP Stack لنظام خلية النحل (BeeOS)
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# حزمة شبكة متقدمة كاملة تشمل:
#
# 1. طبقة Ethernet (L2)
#    - إطارات Ethernet مع MAC مصدر/وجهة
#    - ARP: تحليل عنوان → MAC
#    - جدول ARP مع TTL
#
# 2. طبقة IP (L3)
#    - حزم IPv4 مع مصدر/وجهة
#    - ICMP: ping/pong
#    - جدول التوجيه (routing table)
#    - TTL وتجزئة
#
# 3. طبقة Transport (L4)
#    - TCP: اتصال موثوق (3-way handshake)
#    - UDP: رسائل بدون اتصال
#    - أرقام المنافذ (1-65535)
#
# 4. طبقة Application (L7)
#    - DNS: تحليل أسماء → عناوين IP
#    - HTTP: طلب/استجابة بسيطة
#    - DHCP: تخصيص عناوين IP تلقائياً
#
# 5. مقابس الشبكة (Network Sockets)
#    - واجهة socket() / bind() / listen() / connect() / send() / recv()
#
# الكلمات المحجوزة المتجنَّبة:
# جديد (كمتغير) | سجل (كمتغير) | حجم | نوع | حالة | من
#
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت الشبكة
# ─────────────────────────────────────────────────────────────────────────────

# أنماط البروتوكول
ثابت بروتوكول_IP = 2048
ثابت بروتوكول_ARP = 2054
ثابت بروتوكول_ICMP = 1
ثابت بروتوكول_TCP = 6
ثابت بروتوكول_UDP = 17

# وضعيات TCP
ثابت TCP_مغلق = 0
ثابت TCP_استماع = 1
ثابت TCP_SYN_مُرسل = 2
ثابت TCP_SYN_مستقبل = 3
ثابت TCP_متصل = 4
ثابت TCP_إنهاء_انتظار1 = 5
ثابت TCP_إنهاء_انتظار2 = 6
ثابت TCP_انتظار_وقت = 7

# رايات TCP
ثابت TCP_FIN = 1
ثابت TCP_SYN = 2
ثابت TCP_RST = 4
ثابت TCP_PSH = 8
ثابت TCP_ACK = 16

# أنماط ICMP
ثابت ICMP_ECHO_REPLY = 0
ثابت ICMP_ECHO_REQUEST = 8

# منافذ معروفة
ثابت منفذ_HTTP = 80
ثابت منفذ_HTTPS = 443
ثابت منفذ_DNS = 53
ثابت منفذ_SSH = 22
ثابت منفذ_DHCP_خادم = 67
ثابت منفذ_DHCP_عميل = 68

# ─────────────────────────────────────────────────────────────────────────────
# صنف عنوان_MAC_م - Ethernet MAC Address
# ─────────────────────────────────────────────────────────────────────────────
صنف عنوان_MAC_م
    ## عنوان MAC (6 بايت)
    مصفوفة البايتات             # 6 بايتات

    باني(رقم ب1، رقم ب2، رقم ب3، رقم ب4، رقم ب5، رقم ب6)
        البايتات = [ب1، ب2، ب3، ب4، ب5، ب6]
    نهاية

    دالة نص نص_م()
        متغير ن = ""
        متغير ف = 0
        بينما (ف < 6)
            اذا (ف > 0) ن = ن + ":" نهاية
            ن = ن + البايتات[ف]
            ف = ف + 1
        نهاية
        ارجع ن
    نهاية

    دالة منطقي يساوي(مصفوفة أخرى_ل)
        اذا (طول(أخرى_ل) != 6) ارجع خطأ نهاية
        متغير ف = 0
        بينما (ف < 6)
            اذا (البايتات[ف] != أخرى_ل[ف]) ارجع خطأ نهاية
            ف = ف + 1
        نهاية
        ارجع صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدخلة_ARP - ARP Table Entry
# ─────────────────────────────────────────────────────────────────────────────
صنف مدخلة_ARP
    ## سجل واحد في جدول ARP

    نص عنوان_IP                # عنوان IP
    مصفوفة عنوان_MAC           # MAC بايتات
    رقم TTL_م                  # وقت الحياة (ثوانٍ)

    باني(نص IP_ل، مصفوفة MAC_ل)
        عنوان_IP = IP_ل
        عنوان_MAC = MAC_ل
        TTL_م = 300    # 5 دقائق افتراضياً
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف جدول_ARP_م - ARP Table
# ─────────────────────────────────────────────────────────────────────────────
صنف جدول_ARP_م
    ## جدول ربط IP ↔ MAC

    مصفوفة المدخلات

    باني()
        المدخلات = []
    نهاية

    ## إضافة أو تحديث
    دالة أضف(نص IP_ل، مصفوفة MAC_ل)
        متغير ف = 0
        بينما (ف < طول(المدخلات))
            اذا (المدخلات[ف].عنوان_IP == IP_ل)
                المدخلات[ف].عنوان_MAC = MAC_ل
                المدخلات[ف].TTL_م = 300
                ارجع 0
            نهاية
            ف = ف + 1
        نهاية
        متغير مدخلة = جديد مدخلة_ARP(IP_ل، MAC_ل)
        المدخلات += [مدخلة]
        ارجع 0
    نهاية

    ## البحث عن MAC لعنوان IP
    دالة مصفوفة ابحث(نص IP_ل)
        متغير ف = 0
        بينما (ف < طول(المدخلات))
            اذا (المدخلات[ف].عنوان_IP == IP_ل)
                ارجع المدخلات[ف].عنوان_MAC
            نهاية
            ف = ف + 1
        نهاية
        ارجع []
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف حزمة_IP_م - IPv4 Packet
# ─────────────────────────────────────────────────────────────────────────────
صنف حزمة_IP_م
    ## حزمة IPv4

    نص المصدر_م                # عنوان IP المصدر
    نص الوجهة_م                # عنوان IP الوجهة
    رقم البروتوكول_م           # TCP/UDP/ICMP
    رقم TTL_م                  # Time To Live
    مصفوفة الحمولة             # البيانات
    رقم معرّف_م                # Identification

    باني(نص مصدر_ل، نص وجهة_ل، رقم بروتوكول_ل)
        المصدر_م = مصدر_ل
        الوجهة_م = وجهة_ل
        البروتوكول_م = بروتوكول_ل
        TTL_م = 64
        الحمولة = []
        معرّف_م = 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مسار_توجيه_م - Routing Table Entry
# ─────────────────────────────────────────────────────────────────────────────
صنف مسار_توجيه_م
    ## سجل واحد في جدول التوجيه

    نص الشبكة_م                # عنوان الشبكة (مثلاً "192.168.1.0")
    نص القناع_م                # قناع الشبكة
    نص البوابة_م               # بوابة (gateway)
    نص الواجهة_م               # واجهة الشبكة (eth0)
    رقم المقياس_م              # metric (تكلفة)

    باني(نص شبكة_ل، نص قناع_ل، نص بوابة_ل، نص واجهة_ل)
        الشبكة_م = شبكة_ل
        القناع_م = قناع_ل
        البوابة_م = بوابة_ل
        الواجهة_م = واجهة_ل
        المقياس_م = 1
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مقطع_TCP_م - TCP Segment
# ─────────────────────────────────────────────────────────────────────────────
صنف مقطع_TCP_م
    ## مقطع TCP مع رايات ورقم تسلسل

    رقم منفذ_مصدر              # منفذ المصدر
    رقم منفذ_وجهة              # منفذ الوجهة
    رقم رقم_تسلسل              # Sequence Number
    رقم رقم_إقرار              # Acknowledgment Number
    رقم الرايات_م              # SYN/ACK/FIN/...
    مصفوفة البيانات_م          # حمولة TCP

    باني(رقم مصدر_ل، رقم وجهة_ل)
        منفذ_مصدر = مصدر_ل
        منفذ_وجهة = وجهة_ل
        رقم_تسلسل = 1000        # ISN بسيط
        رقم_إقرار = 0
        الرايات_م = 0
        البيانات_م = []
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف اتصال_TCP_م - TCP Connection State Machine
# ─────────────────────────────────────────────────────────────────────────────
صنف اتصال_TCP_م
    ## اتصال TCP مع محاكاة 3-way handshake

    نص ip_محلي
    رقم منفذ_محلي
    نص ip_بعيد
    رقم منفذ_بعيد
    رقم الوضعية_م              # TCP state
    رقم seq_م                  # رقم تسلسلي
    رقم ack_م                  # رقم إقرار
    مصفوفة مخزن_إرسال         # بيانات الإرسال
    مصفوفة مخزن_استقبال       # بيانات الاستقبال
    مصفوفة مقاطع_مُرسلة        # سجل المقاطع المُرسلة

    باني(نص ip_ل، رقم منفذ_ل)
        ip_محلي = ip_ل
        منفذ_محلي = منفذ_ل
        ip_بعيد = ""
        منفذ_بعيد = 0
        الوضعية_م = TCP_مغلق
        seq_م = 1000
        ack_م = 0
        مخزن_إرسال = []
        مخزن_استقبال = []
        مقاطع_مُرسلة = []
    نهاية

    ## استماع (listen)
    دالة منطقي استمع()
        اذا (الوضعية_م != TCP_مغلق) ارجع خطأ نهاية
        الوضعية_م = TCP_استماع
        ارجع صحيح
    نهاية

    ## فتح اتصال (connect) — 3-way handshake مُحاكى
    دالة منطقي اتصل(نص ip_بعيد_ل، رقم منفذ_بعيد_ل)
        ip_بعيد = ip_بعيد_ل
        منفذ_بعيد = منفذ_بعيد_ل

        # الخطوة 1: أرسل SYN
        الوضعية_م = TCP_SYN_مُرسل
        seq_م = seq_م + 1

        # الخطوة 2: استقبال SYN-ACK (محاكاة)
        الوضعية_م = TCP_SYN_مستقبل
        ack_م = 2001    # ISN الخادم + 1

        # الخطوة 3: أرسل ACK
        الوضعية_م = TCP_متصل
        ارجع صحيح
    نهاية

    ## قبول اتصال (accept)
    دالة منطقي اقبل(نص ip_عميل، رقم منفذ_عميل)
        اذا (الوضعية_م != TCP_استماع) ارجع خطأ نهاية
        ip_بعيد = ip_عميل
        منفذ_بعيد = منفذ_عميل
        الوضعية_م = TCP_متصل
        ارجع صحيح
    نهاية

    ## إرسال بيانات
    دالة رقم أرسل(مصفوفة بيانات_ل)
        اذا (الوضعية_م != TCP_متصل) ارجع -1 نهاية
        متغير ف = 0
        بينما (ف < طول(بيانات_ل))
            مخزن_إرسال += [بيانات_ل[ف]]
            ف = ف + 1
        نهاية
        seq_م = seq_م + طول(بيانات_ل)
        ارجع طول(بيانات_ل)
    نهاية

    ## استقبال بيانات (محاكاة)
    دالة مصفوفة استقبل()
        متغير نتيجة = مخزن_استقبال
        مخزن_استقبال = []
        ارجع نتيجة
    نهاية

    ## إغلاق (4-way teardown محاكى)
    دالة أغلق()
        اذا (الوضعية_م == TCP_متصل)
            الوضعية_م = TCP_إنهاء_انتظار1
            # FIN-ACK محاكاة
            الوضعية_م = TCP_مغلق
        نهاية
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مخطط_UDP_م - UDP Datagram
# ─────────────────────────────────────────────────────────────────────────────
صنف مخطط_UDP_م
    ## رسالة UDP بسيطة

    نص ip_مصدر
    رقم منفذ_مصدر
    نص ip_وجهة
    رقم منفذ_وجهة
    مصفوفة البيانات_م

    باني(نص مصدر_ل، رقم مصدر_منفذ، نص وجهة_ل، رقم وجهة_منفذ)
        ip_مصدر = مصدر_ل
        منفذ_مصدر = مصدر_منفذ
        ip_وجهة = وجهة_ل
        منفذ_وجهة = وجهة_منفذ
        البيانات_م = []
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدخلة_DNS - DNS Record
# ─────────────────────────────────────────────────────────────────────────────
صنف مدخلة_DNS
    ## سجل DNS واحد

    نص الاسم_م                 # hostname
    نص العنوان_م               # IP address
    رقم النمط_م                # A=1, CNAME=5, MX=15
    رقم TTL_م                  # وقت الحياة

    باني(نص الاسم_ل، نص العنوان_ل، رقم النمط_ل)
        الاسم_م = الاسم_ل
        العنوان_م = العنوان_ل
        النمط_م = النمط_ل
        TTL_م = 3600    # ساعة
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف خادم_DNS_م - DNS Server
# ─────────────────────────────────────────────────────────────────────────────
صنف خادم_DNS_م
    ## خادم DNS محلي مع ذاكرة تخبئة (cache)

    مصفوفة السجلات             # قائمة مدخلة_DNS
    رقم استعلامات_م            # عدد الاستعلامات

    باني()
        السجلات = []
        استعلامات_م = 0

        # سجلات افتراضية
        متغير س1 = جديد مدخلة_DNS("beeos.local"، "127.0.0.1"، 1)
        السجلات += [س1]
        متغير س2 = جديد مدخلة_DNS("gateway.local"، "192.168.1.1"، 1)
        السجلات += [س2]
        متغير س3 = جديد مدخلة_DNS("server.local"، "192.168.1.100"، 1)
        السجلات += [س3]
    نهاية

    ## إضافة سجل
    دالة أضف(نص الاسم_ل، نص العنوان_ل، رقم النمط_ل)
        متغير مدخلة = جديد مدخلة_DNS(الاسم_ل، العنوان_ل، النمط_ل)
        السجلات += [مدخلة]
    نهاية

    ## استعلام عن اسم
    دالة نص استعلم(نص الاسم_ل)
        استعلامات_م = استعلامات_م + 1
        متغير ف = 0
        بينما (ف < طول(السجلات))
            اذا (السجلات[ف].الاسم_م == الاسم_ل)
                ارجع السجلات[ف].العنوان_م
            نهاية
            ف = ف + 1
        نهاية
        ارجع ""    # NXDOMAIN
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف طلب_HTTP_م - HTTP Request
# ─────────────────────────────────────────────────────────────────────────────
صنف طلب_HTTP_م
    ## طلب HTTP بسيط

    نص الطريقة_م               # GET, POST, ...
    نص المسار_م                # /index.html
    نص المضيف_م                # Host header
    مصفوفة الترويسات           # ترويسات إضافية
    نص الجسم_م                 # Body

    باني(نص الطريقة_ل، نص المسار_ل، نص المضيف_ل)
        الطريقة_م = الطريقة_ل
        المسار_م = المسار_ل
        المضيف_م = المضيف_ل
        الترويسات = []
        الجسم_م = ""
    نهاية

    ## تحويل لنص HTTP
    دالة نص نص_م()
        متغير ن = الطريقة_م + " " + المسار_م + " HTTP/1.1\r\n"
        ن = ن + "Host: " + المضيف_م + "\r\n"
        ن = ن + "\r\n"
        اذا (الجسم_م != "") ن = ن + الجسم_م نهاية
        ارجع ن
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف استجابة_HTTP_م - HTTP Response
# ─────────────────────────────────────────────────────────────────────────────
صنف استجابة_HTTP_م
    ## استجابة HTTP بسيطة

    رقم رمز_الوضعية             # 200, 404, 500...
    نص وصف_الوضعية             # OK, Not Found...
    نص الجسم_م                 # Body
    نص نمط_المحتوى             # Content-Type

    باني(رقم الرمز_ل، نص الوصف_ل، نص الجسم_ل)
        رمز_الوضعية = الرمز_ل
        وصف_الوضعية = الوصف_ل
        الجسم_م = الجسم_ل
        نمط_المحتوى = "text/html"
    نهاية

    دالة نص نص_م()
        متغير ن = "HTTP/1.1 " + رمز_الوضعية + " " + وصف_الوضعية + "\r\n"
        ن = ن + "Content-Type: " + نمط_المحتوى + "\r\n"
        ن = ن + "\r\n" + الجسم_م
        ارجع ن
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف خادم_HTTP_م - Simple HTTP Server
# ─────────────────────────────────────────────────────────────────────────────
صنف خادم_HTTP_م
    ## خادم HTTP بسيط مع مسارات

    مصفوفة المسارات            # [مسار, محتوى]
    رقم طلبات_معالجة           # عدّاد الطلبات
    رقم المنفذ_م

    باني(رقم المنفذ_ل)
        المسارات = []
        طلبات_معالجة = 0
        المنفذ_م = المنفذ_ل

        # صفحات افتراضية
        المسارات += ["/"]
        المسارات += ["<html><body><h1>مرحباً بك في BeeOS</h1></body></html>"]
        المسارات += ["/about"]
        المسارات += ["<html><body>نظام خلية النحل v1.0</body></html>"]
    نهاية

    ## معالجة طلب
    دالة نص عالج(نص الطريقة_ل، نص المسار_ل)
        طلبات_معالجة = طلبات_معالجة + 1

        # ابحث عن المسار
        متغير ف = 0
        بينما (ف < طول(المسارات) - 1)
            اذا (المسارات[ف] == المسار_ل)
                # المسار التالي هو المحتوى
                متغير استجابة = جديد استجابة_HTTP_م(200، "OK"، المسارات[ف + 1])
                ارجع استجابة.نص_م()
            نهاية
            ف = ف + 2
        نهاية

        # 404
        متغير استجابة_404 = جديد استجابة_HTTP_م(404، "Not Found"، "الصفحة غير موجودة")
        ارجع استجابة_404.نص_م()
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف تخصيص_DHCP_م - DHCP Lease
# ─────────────────────────────────────────────────────────────────────────────
صنف تخصيص_DHCP_م
    نص العنوان_م               # IP مخصص
    مصفوفة MAC_م               # MAC العميل
    رقم وقت_التخصيص            # وقت البدء
    رقم مدة_الإيجار            # مدة الإيجار (ثوانٍ)

    باني(نص عنوان_ل، مصفوفة MAC_ل)
        العنوان_م = عنوان_ل
        MAC_م = MAC_ل
        وقت_التخصيص = 0
        مدة_الإيجار = 3600    # ساعة
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف خادم_DHCP_م - DHCP Server
# ─────────────────────────────────────────────────────────────────────────────
صنف خادم_DHCP_م
    ## خادم DHCP لتخصيص عناوين IP تلقائياً

    نص نطاق_بداية              # أول IP في النطاق
    رقم آخر_رقم                # آخر رقم مُعطى في الـ octet الرابع
    مصفوفة التخصيصات          # تخصيصات حالية
    نص البوابة_م               # بوابة افتراضية
    نص DNS_م                   # خادم DNS

    باني(نص بداية_ل، نص بوابة_ل، نص dns_ل)
        نطاق_بداية = بداية_ل
        آخر_رقم = 100
        التخصيصات = []
        البوابة_م = بوابة_ل
        DNS_م = dns_ل
    نهاية

    ## تخصيص عنوان IP
    دالة نص خصّص(مصفوفة MAC_ل)
        # تحقق إن كان لديه عنوان بالفعل
        متغير ف = 0
        بينما (ف < طول(التخصيصات))
            متغير ت = التخصيصات[ف]
            اذا (طول(ت.MAC_م) == طول(MAC_ل))
                اذا (ت.MAC_م[0] == MAC_ل[0] && ت.MAC_م[5] == MAC_ل[5])
