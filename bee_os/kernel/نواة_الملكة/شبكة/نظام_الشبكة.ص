# ─────────────────────────────────────────────────────────────────────────────
# صنف عنوان_IP - يمثل عنوان IPv4
# ─────────────────────────────────────────────────────────────────────────────
صنف عنوان_IP
    ## تمثيل عنوان IPv4 بأربع أجزاء

    رقم ج1
    رقم ج2
    رقم ج3
    رقم ج4
    نص النص

    باني(رقم ج10، رقم ج20، رقم ج30، رقم ج40)
        ج1 = ج10
        ج2 = ج20
        ج3 = ج30
        ج4 = ج40
        النص = ج1 + "." + ج2 + "." + ج3 + "." + ج4
    نهاية

    دالة منطقي يساوي(عنوان)
        ارجع ج1 == عنوان.ج1 && ج2 == عنوان.ج2 && ج3 == عنوان.ج3 && ج4 == عنوان.ج4
    نهاية

    دالة منطقي محلي()
        ## 127.x.x.x أو 192.168.x.x أو 10.x.x.x
        اذا (ج1 == 127)
            ارجع صحيح
        نهاية
        اذا (ج1 == 192 && ج2 == 168)
            ارجع صحيح
        نهاية
        اذا (ج1 == 10)
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة اطبع()
        اطبع(النص)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف حزمة_شبكة - وحدة البيانات الأساسية
# ─────────────────────────────────────────────────────────────────────────────
صنف حزمة_شبكة
    ## تمثّل حزمة بيانات تنتقل عبر الشبكة

    رقم نوع_الحزمة
    رقم رقم_التسلسل
    رقم رقم_الإقرار
    رقم المنفذ_المصدر
    رقم المنفذ_الوجهة
    نص عنوان_المصدر
    نص عنوان_الوجهة
    نص البيانات
    رقم حجم_البيانات
    رقم مجموع_التحقق
    منطقي تم_استلامها

    باني(رقم نوع0، نص مصدر0، نص وجهة0، رقم منفذ_م0، رقم منفذ_و0، نص بيانات0)
        نوع_الحزمة = نوع0
        رقم_التسلسل = 0
        رقم_الإقرار = 0
        المنفذ_المصدر = منفذ_م0
        المنفذ_الوجهة = منفذ_و0
        عنوان_المصدر = مصدر0
        عنوان_الوجهة = وجهة0
        البيانات = بيانات0
        حجم_البيانات = 64
        مجموع_التحقق = 0
        تم_استلامها = خطأ
    نهاية

    دالة اطبع()
        اطبع("  [حزمة] ")
        اطبع(عنوان_المصدر)
        اطبع(":")
        اطبع(المنفذ_المصدر)
        اطبع(" → ")
        اطبع(عنوان_الوجهة)
        اطبع(":")
        اطبع(المنفذ_الوجهة)
        اطبع(" | نوع=")
        اطبع(نوع_الحزمة)
        اطبع(" | حجم=")
        اطبع(حجم_البيانات)
        اطبع_سطر(" B")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مقبس_TCP - واجهة الاتصال بـ TCP
# ─────────────────────────────────────────────────────────────────────────────
صنف مقبس_TCP
    ## يُمثّل اتصال TCP ثنائي الاتجاه

    رقم المعرف
    نص العنوان_المحلي
    رقم المنفذ_المحلي
    نص العنوان_البعيد
    رقم المنفذ_البعيد
    رقم الحالة
    رقم البيانات_المرسلة
    رقم البيانات_المستلمة
    مصفوفة قائمة_الانتظار
    رقم مهلة_الانتظار

    باني(رقم معرف0، نص عنوان_م0، رقم منفذ_م0)
        المعرف = معرف0
        العنوان_المحلي = عنوان_م0
        المنفذ_المحلي = منفذ_م0
        العنوان_البعيد = ""
        المنفذ_البعيد = 0
        الحالة = حالة_مغلق
        البيانات_المرسلة = 0
        البيانات_المستلمة = 0
        قائمة_الانتظار = []
        مهلة_الانتظار = 30
    نهاية

    دالة منطقي اتصل(نص عنوان0، رقم منفذ0)
        ## محاكاة مصافحة TCP الثلاثية SYN/SYN-ACK/ACK
        اطبع("  🔗 TCP: إرسال SYN إلى ")
        اطبع(عنوان0)
        اطبع(":")
        اطبع_سطر(منفذ0)

        العنوان_البعيد = عنوان0
        المنفذ_البعيد = منفذ0
        الحالة = حالة_انتظار

        ## SYN → SYN-ACK → ACK (محاكى)
        اطبع_سطر("  🔗 TCP: استلام SYN-ACK")
        اطبع_سطر("  🔗 TCP: إرسال ACK — مصافحة مكتملة ✅")
        الحالة = حالة_متصل
        ارجع صحيح
    نهاية

    دالة منطقي أرسل(نص البيانات)
        اذا (الحالة != حالة_متصل)
            اطبع_سطر("  ❌ خطأ: المقبس غير متصل")
            ارجع خطأ
        نهاية
        البيانات_المرسلة = البيانات_المرسلة + 64
        اطبع("  📤 إرسال: ")
        اطبع(البيانات)
        اطبع(" | ")
        اطبع(64)
        اطبع_سطر(" B")
        ارجع صحيح
    نهاية

    دالة نص استلم()
        اذا (الحالة != حالة_متصل)
            ارجع ""
        نهاية
        متغير محاكاة = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n<html>مرحبا من خادم نظام النحلة</html>"
        البيانات_المستلمة = البيانات_المستلمة + 256
        اطبع("  📥 استلام: ")
        اطبع(256)
        اطبع_سطر(" B")
        ارجع محاكاة
    نهاية

    دالة اغلاق()
        اطبع_سطر("  🔌 TCP: إغلاق الاتصال (FIN/ACK)")
        الحالة = حالة_مغلق
    نهاية

    دالة طباعة_إحصاء()
        اطبع("  📊 مقبس[")
        اطبع(المعرف)
        اطبع("]: مرسل=")
        اطبع(البيانات_المرسلة)
        اطبع(" B | مستلم=")
        اطبع(البيانات_المستلمة)
        اطبع(" B | حالة=")
        اطبع_سطر(الحالة)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف جدول_التوجيه - يحدد مسار الحزم
# ─────────────────────────────────────────────────────────────────────────────
صنف جدول_التوجيه
    ## جدول التوجيه لاتخاذ قرارات إرسال الحزم

    مصفوفة المسارات
    نص البوابة_الافتراضية
    نص واجهة_الافتراضية

    باني(نص بوابة0، نص واجهة0)
        المسارات = []
        البوابة_الافتراضية = بوابة0
        واجهة_الافتراضية = واجهة0
    نهاية

    دالة أضف_مسار(نص الشبكة، نص القناع، نص البوابة، نص الواجهة)
        متغير م = {"شبكة": الشبكة
                    , "قناع": القناع
                    , "بوابة": البوابة
                    , "واجهة": الواجهة}
        المسارات += [م]
    نهاية

    دالة نص ابحث_عن_مسار(نص العنوان)
        ## بحث مبسط — في نظام حقيقي يكون Longest Prefix Match
        لكل مسار في المسارات
            المسار = مسار
        نهاية
        ارجع البوابة_الافتراضية
    نهاية

    دالة طباعة()
        اطبع_سطر("  ┌─ جدول التوجيه ─────────────────────────────────┐")
        اطبع("  │  البوابة الافتراضية: ")
        اطبع_سطر(البوابة_الافتراضية)
        لكل مسار في المسارات
            اطبع("  │  ")
            اطبع(مسار["شبكة"])
            اطبع("/")
            اطبع(مسار["قناع"])
            اطبع("  via ")
            اطبع(مسار["بوابة"])
            اطبع("  dev ")
            اطبع_سطر(مسار["واجهة"])
        نهاية
        اطبع_سطر("  └────────────────────────────────────────────────┘")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدير_الشبكة - الادارة الكاملة لمكدس TCP/IP
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_الشبكة
    ##
    ## المدير الشامل لمكدس الشبكة في نظام النحلة.
    ## يدير: المقابس، الحزم، التوجيه، الكاش، DNS.
    ##

    ## المعلومات الأساسية للواجهة
    نص اسم_الواجهة
    نص عنوان_IP_محلي
    نص قناع_الشبكة
    نص عنوان_MAC
    نص خادم_DNS
    رقم سرعة_الرابط        # Mbps

    ## الحالة والإحصاء
    منطقي الشبكة_نشطة
    رقم إجمالي_الحزم_المرسلة
    رقم إجمالي_الحزم_المستلمة
    رقم إجمالي_أخطاء_الشبكة
    رقم إجمالي_الحزم_المفقودة

    ## المقابس والتوجيه والكاش
    مصفوفة المقابس
    مصفوفة كاش_DNS
    رقم عداد_المقابس

    باني(نص اسم0، نص ip0، نص mac0)
        اسم_الواجهة = اسم0
        عنوان_IP_محلي = ip0
        قناع_الشبكة = "255.255.255.0"
        عنوان_MAC = mac0
        خادم_DNS = "8.8.8.8"
        سرعة_الرابط = 1000
        الشبكة_نشطة = خطأ
        إجمالي_الحزم_المرسلة = 0
        إجمالي_الحزم_المستلمة = 0
        إجمالي_أخطاء_الشبكة = 0
        إجمالي_الحزم_المفقودة = 0
        المقابس = []
        كاش_DNS = []
        عداد_المقابس = 1
    نهاية

    دالة منطقي تهيئة()
        اطبع_سطر("  🌐 تهيئة مكدس الشبكة TCP/IP...")
        اطبع("  📡 الواجهة: ")
        اطبع(اسم_الواجهة)
        اطبع(" | IP: ")
        اطبع(عنوان_IP_محلي)
        اطبع(" | MAC: ")
        اطبع_سطر(عنوان_MAC)
        اطبع("  ⚡ السرعة: ")
        اطبع(سرعة_الرابط)
        اطبع_سطر(" Mbps")
        الشبكة_نشطة = صحيح
        اطبع_سطر("  ✅ مكدس الشبكة يعمل")
        ارجع صحيح
    نهاية

    دالة منطقي أنشئ_مقبس(رقم منفذ، رقم بروتوكول)
        اذا (الشبكة_نشطة == خطأ)
            اطبع_سطر("  ❌ الشبكة غير نشطة")
            ارجع خطأ
        نهاية
        متغير مقبس = جديد مقبس_TCP(عداد_المقابس، عنوان_IP_محلي، منفذ)
        عداد_المقابس = عداد_المقابس + 1
        المقابس += [مقبس]
        اطبع("  🔌 إنشاء مقبس [")
        اطبع(مقبس.المعرف)
        اطبع("] منفذ:")
        اطبع(منفذ)
        اطبع(" بروتوكول:")
        اطبع_سطر(بروتوكول)
        ارجع صحيح
    نهاية

    دالة نص حل_DNS(نص اسم_النطاق)
        ## فحص الكاش أولاً
        لكل سجل في كاش_DNS
            اذا (سجل["الاسم"] == اسم_النطاق)
                ارجع سجل["IP"]
            نهاية
        نهاية

        ## محاكاة استعلام DNS
        اطبع("  🔍 DNS: حل '")
        اطبع(اسم_النطاق)
        اطبع("'...")

        متغير ip_محلول = "0.0.0.0"
        اذا (اسم_النطاق == "نحلة.محلي")
            ip_محلول = "192.168.1.1"
        نهاية
        اذا (اسم_النطاق == "google.com")
            ip_محلول = "142.250.80.46"
        نهاية
        اذا (اسم_النطاق == "github.com")
            ip_محلول = "140.82.112.3"
        نهاية

        ## حفظ في الكاش
        متغير سجل_جديد = {"الاسم": اسم_النطاق, "IP": ip_محلول}
        كاش_DNS += [سجل_جديد]

        اطبع(" → ")
        اطبع_سطر(ip_محلول)
        ارجع ip_محلول
    نهاية

    دالة منطقي إرسال_طلب_HTTP(نص عنوان، نص المسار)
        اطبع("  🌐 HTTP GET ")
        اطبع(عنوان)
        اطبع_سطر(المسار)

        ## حل DNS
        متغير IP = حل_DNS(عنوان)

        ## إنشاء مقبس
        أنشئ_مقبس(12345، بروتوكول_TCP)

        ## إيجاد آخر مقبس
        متغير آخر_مقبس = المقابس[0]
        لكل م في المقابس
            آخر_مقبس = م
        نهاية

        ## الاتصال وإرسال
        آخر_مقبس.اتصل(IP، بروتوكول_HTTP)
        آخر_مقبس.أرسل("GET " + المسار + " HTTP/1.1\r\nHost: " + عنوان + "\r\n\r\n")
        متغير الرد = آخر_مقبس.استلم()
        إجمالي_الحزم_المرسلة = إجمالي_الحزم_المرسلة + 1
        إجمالي_الحزم_المستلمة = إجمالي_الحزم_المستلمة + 1
        آخر_مقبس.اغلاق()
        اطبع("  📄 رد: ")
        اطبع_سطر(الرد)
        ارجع صحيح
    نهاية

    دالة منطقي إرسال_ping(نص العنوان)
        اطبع("  🏓 Ping → ")
        اطبع(العنوان)
        اطبع("...")

        إجمالي_الحزم_المرسلة = إجمالي_الحزم_المرسلة + 4
        إجمالي_الحزم_المستلمة = إجمالي_الحزم_المستلمة + 4

        اطبع_سطر(" 4/4 حزم وصلت — تأخير: 12ms")
        ارجع صحيح
    نهاية

    دالة طباعة_إحصاء()
        اطبع_سطر("  ╔══ إحصاءات الشبكة ══════════════════════════════╗")
        اطبع("  ║  الواجهة: ")
        اطبع(اسم_الواجهة)
        اطبع("  IP: ")
        اطبع_سطر(عنوان_IP_محلي)
        اطبع("  ║  إرسال: ")
        اطبع(إجمالي_الحزم_المرسلة)
        اطبع(" حزمة | استلام: ")
        اطبع(إجمالي_الحزم_المستلمة)
        اطبع_سطر(" حزمة")
        اطبع("  ║  أخطاء: ")
        اطبع(إجمالي_أخطاء_الشبكة)
        اطبع(" | مفقودة: ")
        اطبع_سطر(إجمالي_الحزم_المفقودة)

        ## إحصاء المقابس
        متغير عدد_م = 0
        لكل م في المقابس
            عدد_م = عدد_م + 1
        نهاية
        اطبع("  ║  المقابس: ")
        اطبع_سطر(عدد_م)
        اطبع_سطر("  ╚═══════════════════════════════════════════════╝")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف جدار_الحماية - فلترة حزم الشبكة
# ─────────────────────────────────────────────────────────────────────────────
صنف جدار_الحماية
    ## فلترة حزم الشبكة الواردة والصادرة

    مصفوفة قواعد_السماح
    مصفوفة قواعد_الحجب
    رقم حزم_مسموحة
    رقم حزم_محجوبة
    منطقي وضع_صارم

    باني(منطقي صارم0)
        قواعد_السماح = []
        قواعد_الحجب = []
        حزم_مسموحة = 0
        حزم_محجوبة = 0
        وضع_صارم = صارم0
    نهاية

    دالة أضف_قاعدة_سماح(رقم المنفذ، نص الوصف)
        متغير قاعدة = {"منفذ": المنفذ, "وصف": الوصف}
        قواعد_السماح += [قاعدة]
        اطبع("  🟢 سماح: منفذ ")
        اطبع(المنفذ)
        اطبع(" — ")
        اطبع_سطر(الوصف)
    نهاية

    دالة أضف_قاعدة_حجب(رقم المنفذ، نص الوصف)
        متغير قاعدة = {"منفذ": المنفذ, "وصف": الوصف}
        قواعد_الحجب += [قاعدة]
        اطبع("  🔴 حجب: منفذ ")
        اطبع(المنفذ)
        اطبع(" — ")
        اطبع_سطر(الوصف)
    نهاية

    دالة منطقي فلتر_حزمة(رقم المنفذ)
        ## فحص قواعد الحجب أولاً
        لكل ق في قواعد_الحجب
            اذا (ق["منفذ"] == المنفذ)
                حزم_محجوبة = حزم_محجوبة + 1
                ارجع خطأ
            نهاية
        نهاية
        ## ثم قواعد السماح
        لكل ق في قواعد_السماح
            اذا (ق["منفذ"] == المنفذ)
                حزم_مسموحة = حزم_مسموحة + 1
                ارجع صحيح
            نهاية
        نهاية
        ## في الوضع الصارم: حجب كل ما لم يُذكر صراحةً
        اذا (وضع_صارم)
            حزم_محجوبة = حزم_محجوبة + 1
            ارجع خطأ
        نهاية
        حزم_مسموحة = حزم_مسموحة + 1
        ارجع صحيح
    نهاية

    دالة طباعة_إحصاء()
        اطبع("  🛡️  جدار الحماية | مسموح: ")
        اطبع(حزم_مسموحة)
        اطبع(" | محجوب: ")
        اطبع_سطر(حزم_محجوبة)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ─────────────────────────────────────────────────────────────────────────────
دالة رئيسية()
