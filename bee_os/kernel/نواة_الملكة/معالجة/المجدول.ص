# ══════════════════════════════════════════════════════════════════════════════
# المجدول.ص - مجدول العمليات الرئيسي لنظام خلية النحل
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# مجدول العمليات هو قلب نظام التشغيل. يُحدد:
# - أي عملية تعمل الآن
# - كم من الوقت تعمل كل عملية
# - أولويات العمليات
# - إدارة الانتظار والتوقف
#
# خوارزمية الجدولة في نظام النحلة:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# يستخدم نظام النحلة خوارزمية "رقصة السرب" المستوحاة من سلوك النحل الحقيقي:
#
# 1. الملكة (مستوى أعلى) - عمليات النواة الحرجة (أذان، أمان)
# 2. الحارسات (عالي الأولوية) - خدمات النظام
# 3. العاملات (أولوية عادلة) - تطبيقات المستخدم
# 4. الكشّافات (خلفية) - المهام الخلفية
#
# في كل طبقة نستخدم CFS (Completely Fair Scheduler):
# - كل عملية تحصل على نصيب عادل من الوقت
# - العمليات الأطول انتظاراً تُعطى أولوية
# - الميزان: vruntime = runtime × (ثقل_افتراضي / ثقل_العملية)
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت المجدول
# ─────────────────────────────────────────────────────────────────────────────

# حصص زمنية بالميكروثانية
ثابت حصة_الملكة     = 500     # 500 ميكروثانية للعمليات الحرجة
ثابت حصة_الحارسة    = 2000    # 2 ميلي ثانية للخدمات
ثابت حصة_العاملة    = 5000    # 5 ميلي ثانية للتطبيقات
ثابت حصة_الكشافة    = 20000   # 20 ميلي ثانية للخلفية

# أولويات العمليات (أعلى رقم = أولوية أعلى)
ثابت أولوية_الملكة   = 100    # أعلى أولوية (النواة)
ثابت أولوية_الحارسة  = 80     # خدمات النظام الحرجة
ثابت أولوية_العاملة  = 50     # التطبيقات العادية
ثابت أولوية_الكشافة  = 10     # مهام الخلفية

# حالات العملية
ثابت حالة_جاهزة     = 1     # جاهزة للتشغيل
ثابت حالة_تعمل      = 2     # تعمل الآن
ثابت حالة_تنتظر     = 3     # تنتظر حدثاً (I/O مثلاً)
ثابت حالة_نائمة     = 4     # في وضع السكون
ثابت حالة_منتهية    = 5     # انتهت وتنتظر الإنهاء

# أقصى عدد عمليات متزامنة
ثابت أقصى_عمليات = 1024

# حجم المكدس الافتراضي لكل عملية (8 ميغابايت)
ثابت حجم_مكدس_العملية = 8388608

# ─────────────────────────────────────────────────────────────────────────────
# صنف سجلات المعالج (CPU Context)
# يحفظ حالة المعالج عند تبديل العمليات
# ─────────────────────────────────────────────────────────────────────────────
صنف سجلات_المعالج
    ## الوصف: يحفظ حالة جميع سجلات المعالج x86_64
    ## يُحفظ عند إيقاف عملية ويُستعاد عند العودة إليها

    # سجلات عامة
    رقم rax    # Accumulator
    رقم rbx    # Base
    رقم rcx    # Counter
    رقم rdx    # Data
    رقم rsi    # Source Index
    رقم rdi    # Destination Index
    رقم rbp    # Base Pointer
    رقم rsp    # Stack Pointer
    رقم r8
    رقم r9
    رقم r10
    رقم r11
    رقم r12
    رقم r13
    رقم r14
    رقم r15

    # سجلات التحكم
    رقم rip    # Instruction Pointer
    رقم rflags # RFLAGS register
    رقم cs     # Code Segment
    رقم ss     # Stack Segment

    # سجلات الفاصلة العائمة (محاكاة)
    رقم xmm0_lo
    رقم xmm0_hi

    باني()
        rax = 0 ; rbx = 0 ; rcx = 0 ; rdx = 0
        rsi = 0 ; rdi = 0 ; rbp = 0 ; rsp = 0
        r8 = 0 ; r9 = 0 ; r10 = 0 ; r11 = 0
        r12 = 0 ; r13 = 0 ; r14 = 0 ; r15 = 0
        rip = 0 ; rflags = 514   # IF مُفعَّل
        cs = 8 ; ss = 16         # قطاعات النواة القياسية
        xmm0_lo = 0 ; xmm0_hi = 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف العملية (Process Control Block - PCB)
# يحتوي كل المعلومات عن عملية واحدة
# ─────────────────────────────────────────────────────────────────────────────
صنف عملية
    ## الوصف: يمثّل عملية نشطة في النظام (PCB - Process Control Block)
    ## هو مركز المعلومات الذي يحتاجه المجدول لإدارة العملية

    رقم المعرّف         # PID - Process ID (فريد لكل عملية)
    رقم معرّف_الأب      # PPID - PID الأب (العملية التي أنشأتها)
    نص الاسم            # اسم العملية للعرض
    رقم الأولوية        # أولوية الجدولة (0-100)
    رقم الحالة          # حالة_جاهزة / حالة_تعمل / إلخ
    رقم طبقة_النحل      # 0=كشافة 1=عاملة 2=حارسة 3=ملكة

    # معلومات الزمن
    رقم وقت_الإنشاء     # وقت إنشاء العملية (تكّات المؤقت)
    رقم وقت_التشغيل     # إجمالي وقت التشغيل الفعلي
    رقم وقت_الافتراضي  # vruntime للـ CFS (زمن موزون عادل)
    رقم حصة_الوقت      # الحصة الزمنية الحالية
    رقم وقت_بدء_الشريحة # وقت بدء الشريحة الحالية

    # الذاكرة
    رقم عنوان_PML4      # جدول صفحات العملية (CR3)
    رقم عنوان_المكدس    # مؤشر المكدس الحالي
    رقم حجم_الذاكرة    # إجمالي الذاكرة المخصصة

    # السجلات تُهيّأ في الباني

    # ملفات مفتوحة
    مصفوفة الملفات_المفتوحة

    # إشارات معلّقة
    رقم الإشارات_المعلّقة

    # كود الخروج
    رقم كود_الخروج

    باني(رقم pid، نص اسم_العملية، رقم الأولوية_الأولية، رقم طبقة_النحل_أولية)
        المعرّف = pid
        معرّف_الأب = 0
        الاسم = اسم_العملية
        الأولوية = الأولوية_الأولية
        الحالة = حالة_جاهزة
        طبقة_النحل = طبقة_النحل_أولية

        وقت_الإنشاء = 0
        وقت_التشغيل = 0
        وقت_الافتراضي = 0
        اذا (طبقة_النحل_أولية == 3)
            حصة_الوقت = حصة_الملكة
        والا_اذا (طبقة_النحل_أولية == 2)
            حصة_الوقت = حصة_الحارسة
        والا_اذا (طبقة_النحل_أولية == 1)
            حصة_الوقت = حصة_العاملة
        والا
            حصة_الوقت = حصة_الكشافة
        نهاية
        وقت_بدء_الشريحة = 0

        عنوان_PML4 = 0
        عنوان_المكدس = 0
        حجم_الذاكرة = 0

        السجلات = جديد سجلات_المعالج()
        الملفات_المفتوحة = []
        الإشارات_المعلّقة = 0
        كود_الخروج = 0
    نهاية

    ## اسم الطبقة
    دالة نص اسم_الطبقة()
        اذا (طبقة_النحل == 3)   ارجع "ملكة"   نهاية
        اذا (طبقة_النحل == 2)   ارجع "حارسة"  نهاية
        اذا (طبقة_النحل == 1)   ارجع "عاملة"  نهاية
        ارجع "كشافة"
    نهاية

    ## اسم الحالة
    دالة نص اسم_الحالة()
        اذا (الحالة == حالة_تعمل)   ارجع "تعمل"   نهاية
        اذا (الحالة == حالة_جاهزة)  ارجع "جاهزة"  نهاية
        اذا (الحالة == حالة_تنتظر)  ارجع "تنتظر"  نهاية
        اذا (الحالة == حالة_نائمة)  ارجع "نائمة"  نهاية
        اذا (الحالة == حالة_منتهية) ارجع "منتهية" نهاية
        ارجع "مجهولة"
    نهاية

    ## طباعة معلومات العملية
    دالة طباعة_معلومات()
        اطبع("  [")
        اطبع(المعرّف)
        اطبع("] ")
        اطبع(الاسم)
        اطبع(" | طبقة: ")
        اطبع(اسم_الطبقة())
        اطبع(" | حالة: ")
        اطبع(اسم_الحالة())
        اطبع(" | أولوية: ")
        اطبع(الأولوية)
        اطبع(" | وقت تشغيل: ")
        اطبع(وقت_التشغيل / 1000)
        اطبع_سطر(" ms")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الصنف الرئيسي: مجدول رقصة السرب
# ─────────────────────────────────────────────────────────────────────────────
صنف مجدول_رقصة_السرب
    ## الوصف الكامل:
    ## ══════════════
    ## مجدول متعدد الأولويات يُطبّق خوارزمية "رقصة السرب" المستوحاة من سلوك نحل العسل.
    ##
    ## الميزات الرئيسية:
    ## ─────────────────
    ## ✅ جدولة عادلة (CFS) داخل كل طبقة
    ## ✅ دعم 4 طبقات أولوية (ملكة/حارسة/عاملة/كشافة)
    ## ✅ preemption (انتزاع)
    ## ✅ CPU affinity (تثبيت على معالج)
    ## ✅ إحصاءات مفصلة

    مصفوفة العمليات          # جميع العمليات
    رقم العملية_الحالية      # فهرس العملية التي تعمل الآن
    رقم العملية_الخاملة      # العملية الخاملة (تعمل عندما لا يوجد شيء)
    رقم عدد_العمليات         # العدد الحالي
    رقم مجموع_التبديلات      # إحصاء تبديلات السياق
    رقم تكّة_المؤقت          # تكّة المؤقت الحالية (Hz)
    رقم حالة_التهيئة
    رقم pid_التالي           # للتخصيص التلقائي للـ PID

    باني()
        العمليات = []
        العملية_الحالية = -1
        العملية_الخاملة = -1
        عدد_العمليات = 0
        مجموع_التبديلات = 0
        تكّة_المؤقت = 0
        حالة_التهيئة = 0
        pid_التالي = 1
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تهيئة المجدول
    ## ══════════════════════════════════════════════════════════════════════
    دالة رقم تهيئة()
        اطبع_سطر("🐝 مجدول رقصة السرب: بدء التهيئة...")

        # إنشاء العملية الخاملة (idle process)
        # تعمل عندما لا توجد عمليات جاهزة
        متغير عملية_خاملة = جديد عملية(0، "خامل_النحل"، 0، 0)
        العمليات += [عملية_خاملة]
        العملية_الخاملة = 0
        عدد_العمليات = 1

        حالة_التهيئة = 1
        اطبع_سطر("✅ مجدول رقصة السرب: جاهز")
        ارجع 1
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إنشاء عملية جديدة
    ## ══════════════════════════════════════════════════════════════════════
    دالة رقم أنشئ_عملية(نص الاسم، رقم الأولوية، رقم الطبقة)
        اذا (عدد_العمليات >= أقصى_عمليات)
            اطبع_سطر("خطأ: وصل الحد الأقصى من العمليات")
            ارجع -1
        نهاية

        متغير pid = pid_التالي
        pid_التالي = pid_التالي + 1

        متغير عملية_جديدة = جديد عملية(pid، الاسم، الأولوية، الطبقة)
        العمليات += [عملية_جديدة]
        عدد_العمليات = عدد_العمليات + 1

        اطبع("  ✅ أُنشئت عملية: ")
        اطبع(pid)
        اطبع(" / ")
        اطبع_سطر(الاسم)

        ارجع pid
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## الاختيار التالي للجدولة (قلب المجدول)
    ## ══════════════════════════════════════════════════════════════════════
    ## يختار العملية التالية التي ستحصل على وقت المعالج
    ## باستخدام CFS: العملية ذات أصغر vruntime
    دالة رقم اختر_التالي()
        متغير أفضل_فهرس = العملية_الخاملة
        متغير أفضل_طبقة = -1
        متغير أقل_vruntime = 9999999999

        # المسح على جميع العمليات لإيجاد الأنسب
        متغير فهرس = 0
        بينما (فهرس < عدد_العمليات)
            متغير العملية = العمليات[فهرس]

            # تخطي العمليات غير الجاهزة
            اذا (العملية.الحالة != حالة_جاهزة && العملية.الحالة != حالة_تعمل)
                فهرس = فهرس + 1
                استمر
            نهاية

            # أولوية الطبقة أولاً
            اذا (العملية.طبقة_النحل > أفضل_طبقة)
                أفضل_طبقة = العملية.طبقة_النحل
                أفضل_فهرس = فهرس
                أقل_vruntime = العملية.وقت_الافتراضي
            والا_اذا (العملية.طبقة_النحل == أفضل_طبقة)
                # نفس الطبقة: اختر الأقل vruntime (الأكثر جوعاً للوقت)
                اذا (العملية.وقت_الافتراضي < أقل_vruntime)
                    أقل_vruntime = العملية.وقت_الافتراضي
                    أفضل_فهرس = فهرس
                نهاية
            نهاية

            فهرس = فهرس + 1
        نهاية

        ارجع أفضل_فهرس
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تبديل السياق (Context Switch)
    ## ══════════════════════════════════════════════════════════════════════
    ## ينتقل من العملية الحالية للعملية المختارة
    ## يحفظ سجلات العملية الحالية ويُحمّل سجلات الجديدة
    دالة تبديل_سياق(رقم فهرس_العملية_الجديدة)
        اذا (فهرس_العملية_الجديدة == العملية_الحالية)
            ارجع 0    # لا حاجة للتبديل
        نهاية

        # حفظ حالة العملية الحالية
        اذا (العملية_الحالية >= 0 && العملية_الحالية < عدد_العمليات)
            متغير العملية_القديمة = العمليات[العملية_الحالية]
            اذا (العملية_القديمة.الحالة == حالة_تعمل)
                العملية_القديمة.الحالة = حالة_جاهزة
            نهاية
        نهاية

        # تحميل العملية الجديدة
        متغير العملية_الجديدة = العمليات[فهرس_العملية_الجديدة]
        العملية_الجديدة.الحالة = حالة_تعمل
        العملية_الحالية = فهرس_العملية_الجديدة
        مجموع_التبديلات = مجموع_التبديلات + 1

        # في الكود الحقيقي: تبديل السجلات ومساحة العناوين
        # - حفظ RSP, RBP, RBX, R12-R15 في PCB القديم
        # - تحميل CR3 الجديد (جداول الصفحات)
        # - تحميل سجلات العملية الجديدة
        # - IRET أو ret للعودة للعملية الجديدة
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## معالجة تكّة المؤقت (Timer Tick Handler)
    ## يُستدعى من معالج المقاطعة رقم 32 (IRQ0 - PIT) كل 1ms
    ## ══════════════════════════════════════════════════════════════════════
    دالة tick()
        تكّة_المؤقت = تكّة_المؤقت + 1

        # تحديث إحصاءات العملية الحالية
        اذا (العملية_الحالية >= 0 && العملية_الحالية < عدد_العمليات)
            متغير العملية = العمليات[العملية_الحالية]
            العملية.وقت_التشغيل = العملية.وقت_التشغيل + 1000   # 1ms
            العملية.وقت_الافتراضي = العملية.وقت_الافتراضي + 1000

            # هل انتهت الحصة الزمنية؟
            اذا (العملية.وقت_التشغيل - العملية.وقت_بدء_الشريحة >= العملية.حصة_الوقت)
                العملية.وقت_بدء_الشريحة = العملية.وقت_التشغيل
                # اختر العملية التالية
                متغير فهرس_التالي = اختر_التالي()
                تبديل_سياق(فهرس_التالي)
            نهاية
        نهاية

        # إيقاظ العمليات النائمة التي حان وقتها
        أيقظ_العمليات_النائمة()
    نهاية

    ## إيقاظ العمليات التي انتهى وقت نومها
    دالة أيقظ_العمليات_النائمة()
        متغير فهرس = 0
        بينما (فهرس < عدد_العمليات)
            متغير العملية = العمليات[فهرس]
            اذا (العملية.الحالة == حالة_نائمة)
                # في التطبيق الكامل: نتحقق من وقت الإيقاظ
                # العملية.وقت_الإيقاظ <= تكّة_المؤقت
                # العملية.الحالة = حالة_جاهزة
            نهاية
            فهرس = فهرس + 1
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## طباعة قائمة العمليات (ps aux بالعربي)
    ## ══════════════════════════════════════════════════════════════════════
    دالة طباعة_العمليات()
        اطبع_سطر("══════════════════════════════════════════════")
        اطبع_سطر("  🐝 عمليات نظام النحلة")
        اطبع_سطر("══════════════════════════════════════════════")
        اطبع("  المعرّف | الاسم              | الطبقة  | الحالة | الأولوية")
        اطبع_سطر("")
        اطبع_سطر("  ─────────────────────────────────────────")

        لكل عملية في العمليات
            عملية.طباعة_معلومات()
        نهاية

        اطبع("  إجمالي: ")
        اطبع(عدد_العمليات)
        اطبع(" | تبديلات: ")
        اطبع_سطر(مجموع_التبديلات)
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إنهاء عملية
    ## ══════════════════════════════════════════════════════════════════════
    دالة أنهِ_عملية(رقم pid، رقم كود_خروج)
        متغير فهرس = 0
        بينما (فهرس < عدد_العمليات)
            متغير العملية = العمليات[فهرس]
            اذا (العملية.المعرّف == pid)
