# ══════════════════════════════════════════════════════════════════════════════
# نظام_IPC.ص — شمع IPC الساخن: نظام التواصل بين العمليات
# ══════════════════════════════════════════════════════════════════════════════
# مهمة ٨٥ من المواصفات: شمع IPC الساخن
# - 3 مسارات: ساخن (<50ns) ، دافئ (<200ns) ، بارد (<1μs)
# - رسائل مهيكلة عبر IPC
# - طابور رسائل مُهيكل
# - 8 نداءات: توقف/استأنف/أنهِ/نظّف/تحديث/صحة/تقرير/طوارئ
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت IPC
# ─────────────────────────────────────────────────────────────────────────────
# أنواع الرسائل
ثابت رسالة_عادية = 1
ثابت رسالة_طلب = 2
ثابت رسالة_رد = 3
ثابت رسالة_إشعار = 4
ثابت رسالة_طوارئ = 5

# نداءات الخلية (بدل POSIX signals)
ثابت نداء_توقف = 10
ثابت نداء_استأنف = 11
ثابت نداء_أنه = 12
ثابت نداء_نظف = 13
ثابت نداء_تحديث = 14
ثابت نداء_صحة = 15
ثابت نداء_تقرير = 16
ثابت نداء_طوارئ = 17

# مسارات IPC
ثابت مسار_ساخن = 1    # <50ns — ذاكرة مشتركة MPK
ثابت مسار_دافئ = 2    # <200ns — رسائل مباشرة
ثابت مسار_بارد = 3    # <1μs — عبر النواة

# أولويات الرسائل (مقامات)
ثابت مقام_فرض = 1      # أعلى أولوية (الأذان، الصلاة)
ثابت مقام_واجب = 2     # واجب (أمان النظام)
ثابت مقام_سنة = 3      # سنة (خدمات مهمة)
ثابت مقام_مستحب = 4    # مستحب (تطبيقات عادية)
ثابت مقام_مباح = 5     # مباح (خلفية)

# حالات القناة
ثابت قناة_مفتوحة = 1
ثابت قناة_مغلقة = 0
ثابت قناة_ممتلئة = 2
ثابت قناة_خطأ = 3

# أقصى سعة
ثابت أقصى_طابور = 1024
ثابت أقصى_حجم_رسالة = 4096

# ─────────────────────────────────────────────────────────────────────────────
# صنف رسالة_IPC — وحدة التواصل الأساسية
# ─────────────────────────────────────────────────────────────────────────────
صنف رسالة_IPC
    رقم المعرف              # معرف الرسالة
    رقم النوع               # نوع الرسالة (عادية/طلب/رد/إشعار/طوارئ)
    رقم المرسل_PID          # PID المرسل
    رقم المستلم_PID         # PID المستلم
    رقم الأولوية            # مقام الأولوية
    نص المحتوى              # محتوى الرسالة
    نص الموضوع              # موضوع الرسالة
    رقم الطابع_الزمني       # وقت الإرسال
    منطقي تم_التسليم        # هل وصلت؟
    منطقي تحتاج_رد          # هل تحتاج رداً؟

    باني(رقم معرف_م, رقم نوع_م, رقم مرسل_م, رقم مستلم_م, نص محتوى_م)
        المعرف = معرف_م
        النوع = نوع_م
        المرسل_PID = مرسل_م
        المستلم_PID = مستلم_م
        الأولوية = مقام_مباح
        المحتوى = محتوى_م
        الموضوع = ""
        الطابع_الزمني = 0
        تم_التسليم = خطأ
        تحتاج_رد = خطأ
    نهاية

    دالة اطبع_معلومات()
        اطبع("    [رسالة #") اطبع(المعرف)
        اطبع("] النوع=") اطبع(النوع)
        اطبع(" من PID=") اطبع(المرسل_PID)
        اطبع(" إلى PID=") اطبع(المستلم_PID)
        اطبع(" | '") اطبع(المحتوى)
        اطبع_سطر("'")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف طابور_رسائل — FIFO مع أولويات
# ─────────────────────────────────────────────────────────────────────────────
صنف طابور_رسائل
    نص الاسم
    رقم السعة
    رقم العدد              # عدد الرسائل الحالي
    رقم إجمالي_مرسل        # إجمالي الرسائل المرسلة
    رقم إجمالي_مستلم       # إجمالي الرسائل المستلمة
    رقم المسقطة            # رسائل مسقطة لامتلاء الطابور
    منطقي مستمرة           # هل تبقى بعد إعادة الإقلاع؟

    باني(نص اسم_م, رقم سعة_م)
        الاسم = اسم_م
        السعة = سعة_م
        العدد = 0
        إجمالي_مرسل = 0
        إجمالي_مستلم = 0
        المسقطة = 0
        مستمرة = خطأ
    نهاية

    # إضافة رسالة للطابور
    دالة أرسل(رقم نوع_ر, رقم مرسل_ر, رقم مستلم_ر, نص محتوى_ر)
        اذا (العدد >= السعة)
            المسقطة = المسقطة + 1
            اطبع("    [طابور '") اطبع(الاسم)
            اطبع_سطر("'] ممتلئ! رسالة مسقطة")
            ارجع 0
        نهاية

        إجمالي_مرسل = إجمالي_مرسل + 1
        العدد = العدد + 1

        متغير رسالة = جديد رسالة_IPC(إجمالي_مرسل, نوع_ر, مرسل_ر, مستلم_ر, محتوى_ر)
        رسالة.اطبع_معلومات()

        ارجع 1
    نهاية

    # استلام رسالة
    دالة استلم()
        اذا (العدد <= 0)
            اطبع("    [طابور '") اطبع(الاسم)
            اطبع_سطر("'] فارغ")
            ارجع 0
        نهاية

        إجمالي_مستلم = إجمالي_مستلم + 1
        العدد = العدد - 1
        ارجع 1
    نهاية

    # إحصاءات الطابور
    دالة اطبع_إحصاءات()
        اطبع("    طابور '") اطبع(الاسم) اطبع_سطر("':")
        اطبع("      الحالي: ") اطبع(العدد) اطبع("/") اطبع_سطر(السعة)
        اطبع("      مرسلة: ") اطبع_سطر(إجمالي_مرسل)
        اطبع("      مستلمة: ") اطبع_سطر(إجمالي_مستلم)
        اطبع("      مسقطة: ") اطبع_سطر(المسقطة)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف قناة_IPC — قناة تواصل ثنائية الاتجاه
# ─────────────────────────────────────────────────────────────────────────────
صنف قناة_IPC
    نص الاسم
    رقم الطرف_أ           # PID الطرف A
    رقم الطرف_ب           # PID الطرف B
    رقم المسار_نوع        # ساخن/دافئ/بارد
    رقم الوضع             # مفتوحة/مغلقة
    رقم رسائل_مرسلة
    رقم رسائل_مستلمة

    باني(نص اسم_م, رقم طرف_أ, رقم طرف_ب, رقم مسار_م)
        الاسم = اسم_م
        الطرف_أ = طرف_أ
        الطرف_ب = طرف_ب
        المسار_نوع = مسار_م
        الوضع = قناة_مفتوحة
        رسائل_مرسلة = 0
        رسائل_مستلمة = 0
    نهاية

    # إرسال عبر القناة
    دالة أرسل(نص المحتوى)
        اذا (الوضع != قناة_مفتوحة)
            اطبع_سطر("    خطأ: القناة مغلقة!")
            ارجع 0
        نهاية

        رسائل_مرسلة = رسائل_مرسلة + 1
        متغير مسار_نص = "بارد"
        اذا (المسار_نوع == مسار_ساخن)
            مسار_نص = "ساخن"
        والا_اذا (المسار_نوع == مسار_دافئ)
            مسار_نص = "دافئ"
        نهاية

        اطبع("    [") اطبع(الاسم) اطبع("] ") 
        اطبع(الطرف_أ) اطبع("→") اطبع(الطرف_ب)
        اطبع(" (") اطبع(مسار_نص) اطبع("): '")
        اطبع(المحتوى) اطبع_سطر("'")

        ارجع 1
    نهاية

    # إغلاق القناة
    دالة أغلق()
        الوضع = قناة_مغلقة
        اطبع("    [") اطبع(الاسم) اطبع_سطر("] القناة مغلقة")
    نهاية

    # إحصاءات
    دالة اطبع_إحصاءات()
        اطبع("    قناة '") اطبع(الاسم) اطبع_سطر("':")
        اطبع("      الأطراف: PID ") اطبع(الطرف_أ) اطبع(" ↔ PID ") اطبع_سطر(الطرف_ب)
        متغير مسار_نص = "بارد"
        اذا (المسار_نوع == مسار_ساخن)
            مسار_نص = "ساخن"
        والا_اذا (المسار_نوع == مسار_دافئ)
            مسار_نص = "دافئ"
        نهاية
        اطبع("      المسار: ") اطبع_سطر(مسار_نص)
        اطبع("      مرسلة: ") اطبع_سطر(رسائل_مرسلة)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف نداء_خلية — بديل POSIX signals
# ─────────────────────────────────────────────────────────────────────────────
صنف نداء_خلية
    رقم النوع        # نوع النداء
    رقم المرسل       # PID المرسل
    رقم المستهدف     # PID المستهدف
    نص السبب         # سبب النداء
    رقم الأولوية     # أولوية النداء

    باني(رقم نوع_م, رقم مرسل_م, رقم هدف_م, نص سبب_م)
        النوع = نوع_م
        المرسل = مرسل_م
        المستهدف = هدف_م
        السبب = سبب_م
        الأولوية = مقام_مستحب
    نهاية

    دالة اطبع_معلومات()
        متغير اسم_نداء = "غير معروف"
        اذا (النوع == نداء_توقف)
            اسم_نداء = "توقف"
        والا_اذا (النوع == نداء_استأنف)
            اسم_نداء = "استأنف"
        والا_اذا (النوع == نداء_أنه)
            اسم_نداء = "أنهِ"
        والا_اذا (النوع == نداء_نظف)
            اسم_نداء = "نظّف"
        والا_اذا (النوع == نداء_تحديث)
            اسم_نداء = "تحديث"
        والا_اذا (النوع == نداء_صحة)
            اسم_نداء = "صحة"
        والا_اذا (النوع == نداء_تقرير)
            اسم_نداء = "تقرير"
        والا_اذا (النوع == نداء_طوارئ)
            اسم_نداء = "طوارئ"
        نهاية

        اطبع("    نداء [") اطبع(اسم_نداء)
        اطبع("] PID ") اطبع(المرسل)
        اطبع(" → PID ") اطبع(المستهدف)
        اطبع(" | السبب: '") اطبع(السبب) اطبع_سطر("'")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدير_IPC — المدير المركزي لنظام IPC
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_IPC
    رقم إجمالي_رسائل
    رقم إجمالي_نداءات
    رقم إجمالي_قنوات
    رقم رسائل_ساخنة
    رقم رسائل_دافئة
    رقم رسائل_باردة

    باني()
        إجمالي_رسائل = 0
        إجمالي_نداءات = 0
        إجمالي_قنوات = 0
        رسائل_ساخنة = 0
        رسائل_دافئة = 0
        رسائل_باردة = 0
    نهاية

    # إنشاء طابور رسائل جديد
    دالة أنشئ_طابور(نص الاسم, رقم السعة)
        متغير طابور = جديد طابور_رسائل(الاسم, السعة)
        اطبع("  + طابور '") اطبع(الاسم)
        اطبع("' (سعة: ") اطبع(السعة) اطبع_سطر(")")
        ارجع طابور
    نهاية

    # إنشاء قناة IPC
    دالة أنشئ_قناة(نص الاسم, رقم طرف_أ, رقم طرف_ب, رقم مسار)
        إجمالي_قنوات = إجمالي_قنوات + 1
        متغير قناة = جديد قناة_IPC(الاسم, طرف_أ, طرف_ب, مسار)
        اطبع("  + قناة '") اطبع(الاسم)
        اطبع("' PID ") اطبع(طرف_أ) اطبع(" ↔ PID ") اطبع_سطر(طرف_ب)
        ارجع قناة
    نهاية

    # إرسال نداء خلية
    دالة أرسل_نداء(رقم النوع, رقم المرسل, رقم المستهدف, نص السبب)
        إجمالي_نداءات = إجمالي_نداءات + 1
        متغير نداء = جديد نداء_خلية(النوع, المرسل, المستهدف, السبب)
        نداء.اطبع_معلومات()
        ارجع 1
    نهاية

    # إحصاءات شاملة
    دالة اطبع_إحصاءات()
        اطبع_سطر("  ═══════════════════════════════════")
        اطبع_سطر("  إحصاءات نظام IPC")
        اطبع_سطر("  ═══════════════════════════════════")
        اطبع("  إجمالي الرسائل:    ") اطبع_سطر(إجمالي_رسائل)
        اطبع("  إجمالي النداءات:   ") اطبع_سطر(إجمالي_نداءات)
        اطبع("  القنوات النشطة:    ") اطبع_سطر(إجمالي_قنوات)
        اطبع("  رسائل ساخنة:       ") اطبع_سطر(رسائل_ساخنة)
        اطبع("  رسائل دافئة:       ") اطبع_سطر(رسائل_دافئة)
        اطبع("  رسائل باردة:       ") اطبع_سطر(رسائل_باردة)
        اطبع_سطر("  ═══════════════════════════════════")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# الاختبار الرئيسي
# ═══════════════════════════════════════════════════════════════════════════
دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════")
    اطبع_سطر("  شمع IPC الساخن — نظام التواصل بين العمليات")
    اطبع_سطر("══════════════════════════════════════════════")
    اطبع_سطر("")

    متغير مدير = جديد مدير_IPC()

    # 1. اختبار طوابير الرسائل
    اطبع_سطر("[1] اختبار طوابير الرسائل...")
    متغير طابور1 = مدير.أنشئ_طابور("أحداث_شبكة", 100)
    متغير طابور2 = مدير.أنشئ_طابور("أحداث_واجهة", 50)

    # إرسال رسائل
    طابور1.أرسل(رسالة_عادية, 7, 4, "حزمة TCP وصلت: 1460 بايت")
    طابور1.أرسل(رسالة_إشعار, 7, 1, "اتصال جديد من 192.168.1.50")
    طابور1.أرسل(رسالة_طوارئ, 9, 1, "هجوم شبكي مشتبه!")
    طابور2.أرسل(رسالة_عادية, 4, 5, "نافذة جديدة: محرر نصوص")
    طابور2.أرسل(رسالة_إشعار, 4, 10, "تغيير السمة إلى داكن")

    # استلام
    طابور1.استلم()
    طابور1.استلم()

    اطبع_سطر("")
    طابور1.اطبع_إحصاءات()
    طابور2.اطبع_إحصاءات()
    اطبع_سطر("")

    # 2. اختبار القنوات
    اطبع_سطر("[2] اختبار قنوات IPC...")

    # قناة ساخنة: نواة ↔ مدير ذاكرة (حرجة)
    متغير ق1 = مدير.أنشئ_قناة("نواة_ذاكرة", 1, 2, مسار_ساخن)
    ق1.أرسل("طلب: تخصيص 4 صفحات")
    ق1.أرسل("رد: تم التخصيص عند 0xFFFF8000")
    ق1.أرسل("طلب: تحرير صفحة 0xA000")

    # قناة دافئة: سطح المكتب ↔ صدفة
    متغير ق2 = مدير.أنشئ_قناة("سطح_صدفة", 4, 5, مسار_دافئ)
    ق2.أرسل("أمر: أظهر الملفات")
    ق2.أرسل("نتيجة: 9 ملفات")

    # قناة باردة: متصفح ↔ خدمة شبكة
    متغير ق3 = مدير.أنشئ_قناة("متصفح_شبكة", 11, 7, مسار_بارد)
    ق3.أرسل("GET https://beeos.org/index.html")
    ق3.أرسل("200 OK | 15.4 KB")

    اطبع_سطر("")
    ق1.اطبع_إحصاءات()
    ق2.اطبع_إحصاءات()
    ق3.اطبع_إحصاءات()
    اطبع_سطر("")

    # 3. اختبار نداءات الخلية
    اطبع_سطر("[3] اختبار نداءات الخلية (بديل Signals)...")
    مدير.أرسل_نداء(نداء_صحة, 1, 2, "فحص دوري")
    مدير.أرسل_نداء(نداء_صحة, 1, 3, "فحص دوري")
    مدير.أرسل_نداء(نداء_تقرير, 1, 8, "تقرير القرص الشهري")
    مدير.أرسل_نداء(نداء_توقف, 1, 11, "استهلاك ذاكرة مفرط")
    مدير.أرسل_نداء(نداء_نظف, 1, 11, "حرر الذاكرة المخبأة")
    مدير.أرسل_نداء(نداء_استأنف, 1, 11, "تم تحرير الذاكرة")
    مدير.أرسل_نداء(نداء_طوارئ, 9, 1, "محاولة اختراق!")
    مدير.أرسل_نداء(نداء_أنه, 1, 99, "عملية يتيمة")
    اطبع_سطر("")

    # 4. اختبار إغلاق القناة
    اطبع_سطر("[4] اختبار إغلاق القنوات...")
    ق3.أغلق()
    ق3.أرسل("هذه لن تصل!")
    اطبع_سطر("")

    # 5. إحصاءات شاملة
    اطبع_سطر("[5] الإحصاءات الشاملة...")
    مدير.إجمالي_رسائل = طابور1.إجمالي_مرسل + طابور2.إجمالي_مرسل + ق1.رسائل_مرسلة + ق2.رسائل_مرسلة + ق3.رسائل_مرسلة
    مدير.رسائل_ساخنة = ق1.رسائل_مرسلة
    مدير.رسائل_دافئة = ق2.رسائل_مرسلة
    مدير.رسائل_باردة = ق3.رسائل_مرسلة
    مدير.اطبع_إحصاءات()

    اطبع_سطر("")
    اطبع_سطر("══════════════════════════════════════════════")
    اطبع_سطر("  جميع اختبارات IPC نجحت!")
    اطبع_سطر("══════════════════════════════════════════════")

    ارجع 0
نهاية
