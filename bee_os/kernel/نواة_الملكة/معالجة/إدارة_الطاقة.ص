# إدارة_الطاقة.ص — أحوال النحلة: نظام إدارة الطاقة
# ══════════════════════════════════════════════════════════════════════════════
# مهمة ٩٣: 6 أحوال للطاقة + خشوع أثناء الأذان + احتضار آمن
# ══════════════════════════════════════════════════════════════════════════════

# أحوال الطاقة الستة
ثابت وضع_يقظة = 1       # كامل الطاقة
ثابت وضع_نشاط = 2      # نشاط عادي
ثابت وضع_خمول = 3      # شاشة خافتة
ثابت وضع_سبات_خفيف = 4  # RAM فقط
ثابت وضع_سبات_عميق = 5  # على القرص
ثابت وضع_احتضار = 6     # بطارية منخفضة جداً

# أسباب التحول
ثابت سبب_مستخدم = 1
ثابت سبب_مؤقت = 2
ثابت سبب_بطارية = 3
ثابت سبب_أذان = 4
ثابت سبب_حرارة = 5

صنف مدير_الطاقة
    رقم الوضع_الحالي
    رقم مستوى_البطارية     # 0-100
    رقم درجة_الحرارة       # بالمئوية
    منطقي متصل_بالكهرباء
    رقم دقائق_خمول
    رقم انتقالات_وضع
    رقم وفورات_طاقة        # ملي واط وُفّرت
    منطقي وضع_خشوع         # أثناء الأذان

    باني()
        الوضع_الحالي = وضع_يقظة
        مستوى_البطارية = 85
        درجة_الحرارة = 42
        متصل_بالكهرباء = خطأ
        دقائق_خمول = 0
        انتقالات_وضع = 0
        وفورات_طاقة = 0
        وضع_خشوع = خطأ
    نهاية

    دالة انتقل_إلى(رقم الوضع_الجديد, رقم السبب)
        متغير اسم_قديم = اسم_الوضع(الوضع_الحالي)
        متغير اسم_جديد = اسم_الوضع(الوضع_الجديد)
        متغير اسم_سبب = "غير معروف"
        اذا (السبب == سبب_مستخدم)
            اسم_سبب = "طلب المستخدم"
        والا_اذا (السبب == سبب_مؤقت)
            اسم_سبب = "مؤقت الخمول"
        والا_اذا (السبب == سبب_بطارية)
            اسم_سبب = "بطارية منخفضة"
        والا_اذا (السبب == سبب_أذان)
            اسم_سبب = "وقت الأذان"
        والا_اذا (السبب == سبب_حرارة)
            اسم_سبب = "ارتفاع الحرارة"
        نهاية

        اطبع("  ") اطبع(اسم_قديم) اطبع(" → ") اطبع(اسم_جديد)
        اطبع(" (") اطبع(اسم_سبب) اطبع_سطر(")")
        الوضع_الحالي = الوضع_الجديد
        انتقالات_وضع = انتقالات_وضع + 1
    نهاية

    دالة اسم_الوضع(رقم وض)
        اذا (وض == وضع_يقظة)
            ارجع "يقظة"
        والا_اذا (وض == وضع_نشاط)
            ارجع "نشاط"
        والا_اذا (وض == وضع_خمول)
            ارجع "خمول"
        والا_اذا (وض == وضع_سبات_خفيف)
            ارجع "سبات خفيف"
        والا_اذا (وض == وضع_سبات_عميق)
            ارجع "سبات عميق"
        والا_اذا (وض == وضع_احتضار)
            ارجع "احتضار"
        نهاية
        ارجع "مجهول"
    نهاية

    # وضع الخشوع أثناء الأذان
    دالة دخول_خشوع()
        وضع_خشوع = صحيح
        اطبع_سطر("  وضع الخشوع: الشاشة خافتة، الإشعارات متوقفة")
        اطبع_سطر("  حان وقت الأذان... الله أكبر")
    نهاية

    دالة خروج_خشوع()
        وضع_خشوع = خطأ
        اطبع_سطر("  انتهى وقت الخشوع، الإشعارات تعود")
    نهاية

    # وضع الاحتضار — حفظ كل شيء
    دالة احتضار()
        اطبع_سطر("  تحذير: البطارية منخفضة جداً!")
        اطبع_سطر("  حفظ جميع الملفات المفتوحة...")
        اطبع_سطر("  حفظ حالة التطبيقات...")
        اطبع_سطر("  حفظ سجل النظام...")
        اطبع_سطر("  استودعكم الله...")
        انتقل_إلى(وضع_سبات_عميق, سبب_بطارية)
    نهاية

    دالة اطبع_معلومات()
        اطبع_سطر("  ═══════ حالة الطاقة ═══════")
        اطبع("  الوضع: ") اطبع_سطر(اسم_الوضع(الوضع_الحالي))
        اطبع("  البطارية: ") اطبع(مستوى_البطارية) اطبع_سطر("%")
        اطبع("  الحرارة: ") اطبع(درجة_الحرارة) اطبع_سطر(" C")
        اطبع("  متصل: ") اطبع_سطر(متصل_بالكهرباء)
        اطبع("  الانتقالات: ") اطبع_سطر(انتقالات_وضع)
        اطبع_سطر("  ═════════════════════════════")
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════")
    اطبع_سطر("  أحوال النحلة — نظام إدارة الطاقة")
    اطبع_سطر("══════════════════════════════════════════════")

    متغير طاقة = جديد مدير_الطاقة()

    # محاكاة يوم كامل من الاستخدام
    اطبع_سطر("")
    اطبع_سطر("[1] تسلسل يوم عادي...")
    طاقة.انتقل_إلى(وضع_نشاط, سبب_مستخدم)
    طاقة.انتقل_إلى(وضع_خمول, سبب_مؤقت)
    طاقة.انتقل_إلى(وضع_نشاط, سبب_مستخدم)

    اطبع_سطر("")
    اطبع_سطر("[2] وقت الأذان...")
    طاقة.دخول_خشوع()
    طاقة.خروج_خشوع()

    اطبع_سطر("")
    اطبع_سطر("[3] ارتفاع الحرارة...")
    طاقة.درجة_الحرارة = 85
    طاقة.انتقل_إلى(وضع_خمول, سبب_حرارة)
    طاقة.درجة_الحرارة = 55
    طاقة.انتقل_إلى(وضع_نشاط, سبب_حرارة)

    اطبع_سطر("")
    اطبع_سطر("[4] بطارية منخفضة...")
    طاقة.مستوى_البطارية = 5
    طاقة.احتضار()

    اطبع_سطر("")
    طاقة.اطبع_معلومات()

    اطبع_سطر("")
    اطبع_سطر("  جميع اختبارات إدارة الطاقة نجحت!")
    ارجع 0
نهاية
