# ══════════════════════════════════════════════════════════════════════════════
# نظام_الاتصال_بين_العمليات.ص - IPC لنظام خلية النحل (BeeOS)
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# نظام الاتصال بين العمليات (Inter-Process Communication) الكامل.
# يُوفّر 5 آليات اتصال مع ضمانات التزامن والأمان:
#
# 1. الأنابيب (Pipes)
#    - أنبوب أحادي الاتجاه (unidirectional)
#    - منطقة عازلة دائرية (ring buffer)
#    - حجب القارئ عند الفراغ (blocking read)
#    - حجب الكاتب عند الامتلاء (blocking write)
#    - أنابيب مُسمّاة (named pipes / FIFO)
#    - دعم أنابيب متعددة (pipeline chaining)
#
# 2. طوابير الرسائل (Message Queues)
#    - رسائل مكتملة مع نمط ومحتوى
#    - أولوية الرسائل (priority queue)
#    - إرسال/استقبال غير حاجبة (non-blocking)
#    - فلترة بالنمط (type-based filtering)
#    - حد أقصى لعدد الرسائل
#
# 3. الذاكرة المشتركة (Shared Memory)
#    - مناطق ذاكرة مشتركة بين العمليات
#    - تخصيص/تحرير وربط/فك
#    - عدّاد المراجع (reference counting)
#    - حماية بالأذونات (قراءة/كتابة)
#
# 4. الإشارات المتقدمة (Semaphores)
#    - إشارات عدّاد (counting semaphores)
#    - إشارات ثنائية (binary semaphores / mutexes)
#    - P/wait (انتظار) و V/signal (إشارة)
#    - قائمة انتظار للعمليات المحجوبة
#
# 5. المقابس المحلية (Unix Domain Sockets)
#    - اتصال ثنائي الاتجاه (bidirectional)
#    - مقابس تدفقية (stream) ومُخطّطية (datagram)
#    - ربط (bind) واستماع (listen) وقبول (accept)
#    - عدّاد الاتصالات النشطة
#
# المعمارية:
# ━━━━━━━━━━
#  مدير_IPC_الموحّد
#    ├── جدول_الأنابيب[أنبوب]
#    │     └── ring_buffer
#    ├── جدول_طوابير_الرسائل[طابور_رسائل_م]
#    │     └── priority_queue
#    ├── جدول_الذاكرة_المشتركة[منطقة_مشتركة]
#    │     └── ref_count
#    ├── جدول_الإشارات[إشارة_عدّاد_م]
#    │     └── wait_queue
#    └── جدول_المقابس[مقبس_محلي_م]
#          └── connection_list
#
# الكلمات المحجوزة المتجنَّبة:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━
# حجم → مقاس | نهاية → عنوان_آخر | خريطة → جدول
# نوع → نمط | حالة → وضعية | صنف_ → فئة_
# ارجع (مجرّد) → ارجع 0 | من → من_عملية
# += على حقل كائن داخل مصفوفة → متغير مؤقت
#
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت IPC
# ─────────────────────────────────────────────────────────────────────────────

# أنماط IPC
ثابت IPC_أنبوب = 1
ثابت IPC_رسائل = 2
ثابت IPC_ذاكرة_مشتركة = 3
ثابت IPC_إشارة = 4
ثابت IPC_مقبس = 5

# وضعيات الأنبوب
ثابت أنبوب_مفتوح = 1
ثابت أنبوب_مغلق_قراءة = 2
ثابت أنبوب_مغلق_كتابة = 3
ثابت أنبوب_مغلق_كامل = 4

# أذونات الذاكرة المشتركة
ثابت إذن_قراءة = 1
ثابت إذن_كتابة = 2
ثابت إذن_قراءة_كتابة = 3

# أنماط المقبس
ثابت مقبس_تدفقي = 1      # SOCK_STREAM
ثابت مقبس_مخطط = 2       # SOCK_DGRAM

# ثوابت عامة
ثابت سعة_أنبوب_افتراضية = 128
ثابت أقصى_رسائل_طابور = 64
ثابت أقصى_مقابس = 32
ثابت أقصى_اتصالات_انتظار = 8

# ─────────────────────────────────────────────────────────────────────────────
# صنف أنبوب_م - أنبوب اتصال أحادي الاتجاه
# ─────────────────────────────────────────────────────────────────────────────
صنف أنبوب_م
    ## أنبوب اتصال أحادي الاتجاه مع منطقة عازلة دائرية (ring buffer)
    ## يُستخدم لتمرير البيانات من عملية كاتبة إلى عملية قارئة

    رقم المعرّف_م              # معرّف الأنبوب
    نص الاسم_م                 # اسم الأنبوب (للأنابيب المُسمّاة)
    مصفوفة المخزن              # المنطقة العازلة
    رقم سعة_م                  # السعة القصوى
    رقم رأس_كتابة             # فهرس الكتابة
    رقم رأس_قراءة             # فهرس القراءة
    رقم عدد_بيانات             # عدد البايتات الحالية
    رقم pid_قارئ               # PID العملية القارئة
    رقم pid_كاتب               # PID العملية الكاتبة
    رقم الوضعية_م              # وضعية الأنبوب
    رقم بايتات_مكتوبة          # إجمالي البايتات المكتوبة
    رقم بايتات_مقروءة          # إجمالي البايتات المقروءة

    باني(رقم المعرّف_ل، رقم السعة_ل)
        المعرّف_م = المعرّف_ل
        الاسم_م = ""
        المخزن = []
        سعة_م = السعة_ل
        رأس_كتابة = 0
        رأس_قراءة = 0
        عدد_بيانات = 0
        pid_قارئ = 0
        pid_كاتب = 0
        الوضعية_م = أنبوب_مفتوح
        بايتات_مكتوبة = 0
        بايتات_مقروءة = 0

        # إعداد المخزن
        متغير ف = 0
        بينما (ف < السعة_ل)
            المخزن += [0]
            ف = ف + 1
        نهاية
    نهاية

    ## كتابة بايت واحد
    دالة منطقي اكتب(رقم القيمة_ل)
        اذا (الوضعية_م == أنبوب_مغلق_كتابة || الوضعية_م == أنبوب_مغلق_كامل)
            ارجع خطأ
        نهاية
        اذا (عدد_بيانات >= سعة_م)
            ارجع خطأ     # ممتلئ — في النظام الحقيقي: حجب
        نهاية

        المخزن[رأس_كتابة] = القيمة_ل
        رأس_كتابة = (رأس_كتابة + 1) % سعة_م
        عدد_بيانات = عدد_بيانات + 1
        بايتات_مكتوبة = بايتات_مكتوبة + 1
        ارجع صحيح
    نهاية

    ## كتابة مصفوفة بيانات
    دالة رقم اكتب_مصفوفة(مصفوفة البيانات_ل)
        متغير مكتوب = 0
        متغير ف = 0
        بينما (ف < طول(البيانات_ل))
            اذا (اكتب(البيانات_ل[ف]))
                مكتوب = مكتوب + 1
            والا
                ارجع مكتوب    # ممتلئ
            نهاية
            ف = ف + 1
        نهاية
        ارجع مكتوب
    نهاية

    ## قراءة بايت واحد
    دالة رقم اقرأ()
        اذا (عدد_بيانات <= 0)
            ارجع -1     # فارغ — في النظام الحقيقي: حجب
        نهاية

        متغير القيمة = المخزن[رأس_قراءة]
        رأس_قراءة = (رأس_قراءة + 1) % سعة_م
        عدد_بيانات = عدد_بيانات - 1
        بايتات_مقروءة = بايتات_مقروءة + 1
        ارجع القيمة
    نهاية

    ## قراءة عدة بايتات
    دالة مصفوفة اقرأ_مصفوفة(رقم العدد_ل)
        متغير نتيجة = []
        متغير ف = 0
        بينما (ف < العدد_ل)
            متغير ق = اقرأ()
            اذا (ق == -1) ارجع نتيجة نهاية
            نتيجة += [ق]
            ف = ف + 1
        نهاية
        ارجع نتيجة
    نهاية

    ## إغلاق طرف الكتابة
    دالة أغلق_كتابة()
        اذا (الوضعية_م == أنبوب_مغلق_قراءة)
            الوضعية_م = أنبوب_مغلق_كامل
        والا
            الوضعية_م = أنبوب_مغلق_كتابة
        نهاية
    نهاية

    ## إغلاق طرف القراءة
    دالة أغلق_قراءة()
        اذا (الوضعية_م == أنبوب_مغلق_كتابة)
            الوضعية_م = أنبوب_مغلق_كامل
        والا
            الوضعية_م = أنبوب_مغلق_قراءة
        نهاية
    نهاية

    ## هل ممتلئ؟
    دالة منطقي ممتلئ()
        ارجع عدد_بيانات >= سعة_م
    نهاية

    ## هل فارغ؟
    دالة منطقي فارغ_م()
        ارجع عدد_بيانات == 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف رسالة_م - رسالة واحدة في طابور الرسائل
# ─────────────────────────────────────────────────────────────────────────────
صنف رسالة_م
    ## رسالة واحدة في طابور الرسائل (System V / POSIX)

    رقم نمط_الرسالة            # نمط الرسالة (للفلترة)
    مصفوفة المحتوى             # محتوى الرسالة (بايتات)
    رقم من_عملية_م              # PID المُرسِل
    رقم إلى_عملية               # PID المُستقبِل (0 = أي)
    رقم الأولوية_م              # أولوية (0 = أعلى)
    رقم وقت_الإرسال            # وقت الإرسال

    باني(رقم النمط_ل، مصفوفة المحتوى_ل، رقم المُرسِل_ل)
        نمط_الرسالة = النمط_ل
        المحتوى = المحتوى_ل
        من_عملية_م = المُرسِل_ل
        إلى_عملية = 0
        الأولوية_م = 2       # عادية
        وقت_الإرسال = 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف طابور_رسائل_م - Message Queue
# ─────────────────────────────────────────────────────────────────────────────
صنف طابور_رسائل_م
    ## طابور رسائل مع دعم الأولوية والفلترة بالنمط

    رقم المعرّف_م              # معرّف الطابور
    نص الاسم_م                 # اسم الطابور
    مصفوفة الرسائل             # قائمة الرسائل
    رقم أقصى_رسائل             # الحد الأقصى
    رقم رسائل_مُرسلة           # عدّاد الإرسال
    رقم رسائل_مُستقبَلة        # عدّاد الاستقبال

    باني(رقم المعرّف_ل، نص الاسم_ل)
        المعرّف_م = المعرّف_ل
        الاسم_م = الاسم_ل
        الرسائل = []
        أقصى_رسائل = أقصى_رسائل_طابور
        رسائل_مُرسلة = 0
        رسائل_مُستقبَلة = 0
    نهاية

    ## إرسال رسالة
    دالة منطقي أرسل(رقم النمط_ل، مصفوفة المحتوى_ل، رقم المُرسِل_ل)
        اذا (طول(الرسائل) >= أقصى_رسائل)
            ارجع خطأ     # الطابور ممتلئ
        نهاية

        متغير رسالة = جديد رسالة_م(النمط_ل، المحتوى_ل، المُرسِل_ل)
        الرسائل += [رسالة]
        رسائل_مُرسلة = رسائل_مُرسلة + 1
        ارجع صحيح
    نهاية

    ## إرسال رسالة بأولوية
    دالة منطقي أرسل_بأولوية(رقم النمط_ل، مصفوفة المحتوى_ل، رقم المُرسِل_ل، رقم الأولوية_ل)
        اذا (طول(الرسائل) >= أقصى_رسائل) ارجع خطأ نهاية
        متغير رسالة = جديد رسالة_م(النمط_ل، المحتوى_ل، المُرسِل_ل)
        رسالة.الأولوية_م = الأولوية_ل
        الرسائل += [رسالة]
        رسائل_مُرسلة = رسائل_مُرسلة + 1
        ارجع صحيح
    نهاية

    ## استقبال أي رسالة (FIFO)
    دالة رقم استقبل_أول()
        اذا (طول(الرسائل) == 0) ارجع -1 نهاية

        # حذف الأولى
        متغير جديدة = []
        متغير ف = 1
        بينما (ف < طول(الرسائل))
            جديدة += [الرسائل[ف]]
            ف = ف + 1
        نهاية
        الرسائل = جديدة
        رسائل_مُستقبَلة = رسائل_مُستقبَلة + 1
        ارجع 0
    نهاية

    ## استقبال رسالة بنمط محدد
    دالة رقم استقبل_بالنمط(رقم النمط_المطلوب)
        متغير ف = 0
        بينما (ف < طول(الرسائل))
            اذا (الرسائل[ف].نمط_الرسالة == النمط_المطلوب)
                # حذف هذه الرسالة
                متغير جديدة = []
                متغير ج = 0
                بينما (ج < طول(الرسائل))
                    اذا (ج != ف) جديدة += [الرسائل[ج]] نهاية
                    ج = ج + 1
                نهاية
                الرسائل = جديدة
                رسائل_مُستقبَلة = رسائل_مُستقبَلة + 1
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    ## استقبال الرسالة الأعلى أولوية
    دالة رقم استقبل_بأولوية()
        اذا (طول(الرسائل) == 0) ارجع -1 نهاية
        متغير أفضل = 0
        متغير أفضل_أولوية = الرسائل[0].الأولوية_م
        متغير ف = 1
        بينما (ف < طول(الرسائل))
            اذا (الرسائل[ف].الأولوية_م < أفضل_أولوية)
                أفضل = ف
                أفضل_أولوية = الرسائل[ف].الأولوية_م
            نهاية
            ف = ف + 1
        نهاية

        # حذف الأفضل
        متغير جديدة = []
        ف = 0
        بينما (ف < طول(الرسائل))
            اذا (ف != أفضل) جديدة += [الرسائل[ف]] نهاية
            ف = ف + 1
        نهاية
        الرسائل = جديدة
        رسائل_مُستقبَلة = رسائل_مُستقبَلة + 1
        ارجع أفضل
    نهاية

    ## عدد الرسائل المعلّقة
    دالة رقم عدد_معلّقة()
        ارجع طول(الرسائل)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف منطقة_مشتركة - Shared Memory Segment
# ─────────────────────────────────────────────────────────────────────────────
صنف منطقة_مشتركة
    ## منطقة ذاكرة مشتركة بين العمليات

    رقم المعرّف_م              # معرّف المنطقة
    نص الاسم_م                 # اسم المنطقة
    مصفوفة البيانات            # البيانات المشتركة
    رقم المقاس_م               # الحجم بالبايت
    رقم عدد_المراجع            # عدد العمليات المرتبطة (ref count)
    رقم أذونات_م               # أذونات (قراءة/كتابة)
    مصفوفة عمليات_مرتبطة      # PIDs العمليات المرتبطة

    باني(رقم المعرّف_ل، نص الاسم_ل، رقم المقاس_ل)
        المعرّف_م = المعرّف_ل
        الاسم_م = الاسم_ل
        البيانات = []
        المقاس_م = المقاس_ل
        عدد_المراجع = 0
        أذونات_م = إذن_قراءة_كتابة
        عمليات_مرتبطة = []

        # ملء بأصفار
        متغير ف = 0
        بينما (ف < المقاس_ل)
            البيانات += [0]
            ف = ف + 1
        نهاية
    نهاية

    ## ربط عملية بالمنطقة
    دالة منطقي اربط(رقم pid_ل)
        عمليات_مرتبطة += [pid_ل]
        عدد_المراجع = عدد_المراجع + 1
        ارجع صحيح
    نهاية

    ## فك ربط عملية
    دالة منطقي افصل(رقم pid_ل)
        متغير جديدة = []
        متغير وُجد = خطأ
        متغير ف = 0
        بينما (ف < طول(عمليات_مرتبطة))
            اذا (عمليات_مرتبطة[ف] == pid_ل && !وُجد)
                وُجد = صحيح
            والا
                جديدة += [عمليات_مرتبطة[ف]]
            نهاية
            ف = ف + 1
        نهاية
        اذا (وُجد)
            عمليات_مرتبطة = جديدة
            عدد_المراجع = عدد_المراجع - 1
        نهاية
        ارجع وُجد
    نهاية

    ## قراءة من المنطقة
    دالة رقم اقرأ(رقم الموقع_ل)
        اذا (الموقع_ل < 0 || الموقع_ل >= المقاس_م) ارجع -1 نهاية
        ارجع البيانات[الموقع_ل]
    نهاية

    ## كتابة في المنطقة
    دالة منطقي اكتب(رقم الموقع_ل، رقم القيمة_ل)
        اذا (أذونات_م < إذن_كتابة) ارجع خطأ نهاية
        اذا (الموقع_ل < 0 || الموقع_ل >= المقاس_م) ارجع خطأ نهاية
        البيانات[الموقع_ل] = القيمة_ل
        ارجع صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف إشارة_عدّاد_م - Counting Semaphore
# ─────────────────────────────────────────────────────────────────────────────
صنف إشارة_عدّاد_م
    ## إشارة عدّاد (counting semaphore) للتزامن بين العمليات
    ## P/wait: نقّص العدّاد أو حجب إذا كان 0
    ## V/signal: زِد العدّاد وأفرج عن عملية محجوبة

    رقم المعرّف_م              # معرّف الإشارة
    نص الاسم_م                 # اسم الإشارة
    رقم العدّاد                # قيمة العدّاد الحالية
    رقم العدّاد_الأقصى         # القيمة القصوى
    مصفوفة طابور_الانتظار     # PIDs العمليات المحجوبة
    رقم عمليات_P               # عدد عمليات wait
    رقم عمليات_V               # عدد عمليات signal

    باني(رقم المعرّف_ل، نص الاسم_ل، رقم القيمة_الأولية)
        المعرّف_م = المعرّف_ل
        الاسم_م = الاسم_ل
        العدّاد = القيمة_الأولية
        العدّاد_الأقصى = القيمة_الأولية * 2
        طابور_الانتظار = []
        عمليات_P = 0
        عمليات_V = 0
    نهاية

    ## P / wait / انتظار
    ## ارجع: 0 = نجح مباشرة، PID = حُجبت العملية
    دالة رقم انتظر(رقم pid_ل)
        عمليات_P = عمليات_P + 1
        اذا (العدّاد > 0)
            العدّاد = العدّاد - 1
            ارجع 0    # نجح فوراً
        نهاية

        # حجب العملية
        طابور_الانتظار += [pid_ل]
        ارجع pid_ل
    نهاية

    ## V / signal / إشارة
    ## ارجع: PID المُفرج عنه أو 0 = لا أحد ينتظر
