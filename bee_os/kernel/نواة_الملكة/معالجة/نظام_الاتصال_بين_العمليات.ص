            متغير pid_مُفرج = طابور_الانتظار[0]
            متغير بقية = []
            متغير ف = 1
            بينما (ف < طول(طابور_الانتظار))
                بقية += [طابور_الانتظار[ف]]
                ف = ف + 1
            نهاية
            طابور_الانتظار = بقية
            ارجع pid_مُفرج
        نهاية

        # لا أحد ينتظر — زِد العدّاد
        اذا (العدّاد < العدّاد_الأقصى)
