    متغير ن1 = إشارة.انتظر(100)    # عدّاد 2→1
    متغير ن2 = إشارة.انتظر(200)    # عدّاد 1→0
    اذا (ن1 == 0 && ن2 == 0 && إشارة.العدّاد == 0)
        اطبع_سطر("  ✓ wait ناجح لعمليتين")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ wait ناجح لعمليتين")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 2: العملية الثالثة تُحجب
    متغير ن3 = إشارة.انتظر(300)    # عدّاد 0 → حجب
    اذا (ن3 == 300 && إشارة.عدد_المنتظرين() == 1)
        اطبع_سطر("  ✓ حجب العملية الثالثة")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ حجب العملية الثالثة")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 3: signal يُفرج عن المحجوبة
    متغير مُفرج = إشارة.أشِر()
    اذا (مُفرج == 300 && إشارة.عدد_المنتظرين() == 0)
        اطبع_سطر("  ✓ signal يُفرج عن محجوبة")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ signal يُفرج عن محجوبة")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 4: signal يزيد العدّاد (لا منتظرين)
    متغير مُفرج2 = إشارة.أشِر()
    اذا (مُفرج2 == 0 && إشارة.العدّاد == 1)
        اطبع_سطر("  ✓ signal يزيد العدّاد")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ signal يزيد العدّاد")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 5: عدّادات P/V
    اذا (إشارة.عمليات_P == 3 && إشارة.عمليات_V == 2)
        اطبع_سطر("  ✓ عدّادات P/V")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ عدّادات P/V")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    اطبع("  نجاح=") اطبع(نتيجة_نجاح) اطبع(" فشل=") اطبع_سطر(نتيجة_فشل)
    ارجع نتيجة_فشل
نهاية

دالة اختبار_المقابس()
    اطبع_سطر("🔷🔷 اختبار المقابس المحلية 🔷🔷")
    متغير نتيجة_نجاح = 0
    متغير نتيجة_فشل = 0

    # اختبار 1: إنشاء مقبس خادم
    متغير خادم = جديد مقبس_محلي_م(1، مقبس_تدفقي)
    متغير ربط_نجح = خادم.اربط("/tmp/bee.sock")
    اذا (ربط_نجح && خادم.مرتبط)
        اطبع_سطر("  ✓ bind المقبس")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ bind المقبس")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 2: استماع
    خادم.استمع(5)
    اذا (خادم.يستمع)
        اطبع_سطر("  ✓ listen المقبس")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ listen المقبس")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 3: اتصال عميل
    خادم.اتصل(100)
    خادم.اتصل(200)
    اذا (طول(خادم.اتصالات_واردة) == 2)
        اطبع_سطر("  ✓ connect من عملاء")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ connect من عملاء")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 4: قبول اتصال
    متغير pid_مقبول = خادم.اقبل()
    اذا (pid_مقبول == 100 && طول(خادم.اتصالات_نشطة) == 1)
        اطبع_سطر("  ✓ accept الاتصال")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ accept الاتصال")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 5: إرسال بيانات
    خادم.أرسل([72، 101، 108، 108، 111])    # "Hello"
    اذا (طول(خادم.مخزن_إرسال) == 5)
        اطبع_سطر("  ✓ send بيانات")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ send بيانات")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 6: إغلاق المقبس
    خادم.أغلق()
    اذا (!خادم.مرتبط && !خادم.يستمع)
        اطبع_سطر("  ✓ close المقبس")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ close المقبس")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    اطبع("  نجاح=") اطبع(نتيجة_نجاح) اطبع(" فشل=") اطبع_سطر(نتيجة_فشل)
    ارجع نتيجة_فشل
نهاية

دالة اختبار_مدير_IPC()
    اطبع_سطر("🔷🔷 اختبار مدير IPC الموحّد 🔷🔷")
    متغير نتيجة_نجاح = 0
    متغير نتيجة_فشل = 0

    متغير مدير = جديد مدير_IPC_الموحّد()

    # اختبار 1: إنشاء أنبوب
    متغير id_أنبوب = مدير.أنشئ_أنبوب(64)
    اذا (id_أنبوب > 0 && طول(مدير.الأنابيب) == 1)
        اطبع_سطر("  ✓ إنشاء أنبوب من المدير")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ إنشاء أنبوب من المدير")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 2: إنشاء أنبوب مسمّى
    متغير id_مسمّى = مدير.أنشئ_أنبوب_مسمّى("أنبوب_التسجيل"، 128)
    اذا (id_مسمّى > 0 && مدير.الأنابيب[1].الاسم_م == "أنبوب_التسجيل")
        اطبع_سطر("  ✓ أنبوب مُسمّى")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ أنبوب مُسمّى")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # اختبار 3: إنشاء طابور + إشارة + مقبس + مشتركة
    مدير.أنشئ_طابور("طابور_أحداث")
    مدير.أنشئ_إشارة("mutex_ملف"، 1)
    مدير.أنشئ_مقبس(مقبس_تدفقي)
    مدير.أنشئ_مشتركة("ذاكرة_عرض"، 256)

    اذا (طول(مدير.الطوابير) == 1 && طول(مدير.الإشارات) == 1 && طول(مدير.المقابس) == 1 && طول(مدير.المناطق_المشتركة) == 1)
        اطبع_سطر("  ✓ إنشاء جميع أنواع IPC")
        نتيجة_نجاح = نتيجة_نجاح + 1
    والا
        اطبع_سطر("  ✗ إنشاء جميع أنواع IPC")
        نتيجة_فشل = نتيجة_فشل + 1
    نهاية

    # طباعة الإحصائيات
    مدير.اطبع_إحصائيات()

    اطبع("  نجاح=") اطبع(نتيجة_نجاح) اطبع(" فشل=") اطبع_سطر(نتيجة_فشل)
    ارجع نتيجة_فشل
نهاية

