# صنف مقبس_محلي_م - Unix Domain Socket
# ─────────────────────────────────────────────────────────────────────────────
صنف مقبس_محلي_م
    ## مقبس محلي (Unix Domain Socket) ثنائي الاتجاه

    رقم المعرّف_م              # معرّف المقبس
    نص المسار_م                # مسار الملف (/tmp/bee.sock)
    رقم نمط_المقبس             # تدفقي أو مخطط
    منطقي مرتبط                # هل تم bind؟
    منطقي يستمع                # هل يستمع لاتصالات؟
    مصفوفة اتصالات_واردة      # PIDs في طابور الانتظار
    مصفوفة اتصالات_نشطة       # PIDs الاتصالات المقبولة
    مصفوفة مخزن_استقبال       # بيانات مستقبلة
    مصفوفة مخزن_إرسال         # بيانات مُرسلة
    رقم أقصى_انتظار            # أقصى طابور الانتظار (backlog)

    باني(رقم المعرّف_ل، رقم النمط_ل)
        المعرّف_م = المعرّف_ل
        المسار_م = ""
        نمط_المقبس = النمط_ل
        مرتبط = خطأ
        يستمع = خطأ
        اتصالات_واردة = []
        اتصالات_نشطة = []
        مخزن_استقبال = []
        مخزن_إرسال = []
        أقصى_انتظار = أقصى_اتصالات_انتظار
    نهاية

    ## ربط المقبس بمسار
    دالة منطقي اربط(نص المسار_ل)
        اذا (مرتبط) ارجع خطأ نهاية
        المسار_م = المسار_ل
        مرتبط = صحيح
        ارجع صحيح
    نهاية

    ## بدء الاستماع
    دالة منطقي استمع(رقم الطابور_ل)
        اذا (!مرتبط) ارجع خطأ نهاية
        يستمع = صحيح
        أقصى_انتظار = الطابور_ل
        ارجع صحيح
    نهاية

    ## طلب اتصال (من عميل)
    دالة منطقي اتصل(رقم pid_عميل)
        اذا (!يستمع) ارجع خطأ نهاية
        اذا (طول(اتصالات_واردة) >= أقصى_انتظار) ارجع خطأ نهاية
        اتصالات_واردة += [pid_عميل]
        ارجع صحيح
    نهاية

    ## قبول اتصال (من الخادم)
    دالة رقم اقبل()
        اذا (طول(اتصالات_واردة) == 0) ارجع -1 نهاية

        متغير pid = اتصالات_واردة[0]
        # حذف من الواردة
        متغير جديدة = []
        متغير ف = 1
        بينما (ف < طول(اتصالات_واردة))
            جديدة += [اتصالات_واردة[ف]]
            ف = ف + 1
        نهاية
        اتصالات_واردة = جديدة

        # إضافة للنشطة
        اتصالات_نشطة += [pid]
        ارجع pid
    نهاية

    ## إرسال بيانات
    دالة منطقي أرسل(مصفوفة البيانات_ل)
        متغير ف = 0
        بينما (ف < طول(البيانات_ل))
            مخزن_إرسال += [البيانات_ل[ف]]
            ف = ف + 1
        نهاية
        ارجع صحيح
    نهاية

    ## استقبال بيانات
    دالة مصفوفة استقبل()
        متغير نتيجة = مخزن_استقبال
        مخزن_استقبال = []
        ارجع نتيجة
    نهاية

    ## إغلاق المقبس
    دالة أغلق()
        مرتبط = خطأ
        يستمع = خطأ
        اتصالات_واردة = []
        اتصالات_نشطة = []
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدير_IPC_الموحّد - Unified IPC Manager
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_IPC_الموحّد
    ## يدير جميع موارد IPC في النظام

    مصفوفة الأنابيب
    مصفوفة الطوابير
    مصفوفة المناطق_المشتركة
    مصفوفة الإشارات
    مصفوفة المقابس
    رقم آخر_معرّف

    باني()
        الأنابيب = []
        الطوابير = []
        المناطق_المشتركة = []
        الإشارات = []
        المقابس = []
        آخر_معرّف = 0
    نهاية

    ## إنشاء أنبوب جديد
    دالة رقم أنشئ_أنبوب(رقم السعة_ل)
        آخر_معرّف = آخر_معرّف + 1
        متغير أنبوب = جديد أنبوب_م(آخر_معرّف، السعة_ل)
        الأنابيب += [أنبوب]
        ارجع آخر_معرّف
    نهاية

    ## إنشاء أنبوب مُسمّى
    دالة رقم أنشئ_أنبوب_مسمّى(نص الاسم_ل، رقم السعة_ل)
        آخر_معرّف = آخر_معرّف + 1
        متغير أنبوب = جديد أنبوب_م(آخر_معرّف، السعة_ل)
        أنبوب.الاسم_م = الاسم_ل
        الأنابيب += [أنبوب]
        ارجع آخر_معرّف
    نهاية

    ## إنشاء طابور رسائل
    دالة رقم أنشئ_طابور(نص الاسم_ل)
        آخر_معرّف = آخر_معرّف + 1
        متغير طابور = جديد طابور_رسائل_م(آخر_معرّف، الاسم_ل)
        الطوابير += [طابور]
        ارجع آخر_معرّف
    نهاية

    ## إنشاء منطقة ذاكرة مشتركة
    دالة رقم أنشئ_مشتركة(نص الاسم_ل، رقم المقاس_ل)
        آخر_معرّف = آخر_معرّف + 1
        متغير منطقة = جديد منطقة_مشتركة(آخر_معرّف، الاسم_ل، المقاس_ل)
        المناطق_المشتركة += [منطقة]
        ارجع آخر_معرّف
    نهاية

    ## إنشاء إشارة عدّاد
    دالة رقم أنشئ_إشارة(نص الاسم_ل، رقم القيمة_ل)
        آخر_معرّف = آخر_معرّف + 1
        متغير إشارة = جديد إشارة_عدّاد_م(آخر_معرّف، الاسم_ل، القيمة_ل)
        الإشارات += [إشارة]
        ارجع آخر_معرّف
    نهاية

    ## إنشاء مقبس محلي
    دالة رقم أنشئ_مقبس(رقم النمط_ل)
        آخر_معرّف = آخر_معرّف + 1
        متغير مقبس = جديد مقبس_محلي_م(آخر_معرّف، النمط_ل)
        المقابس += [مقبس]
        ارجع آخر_معرّف
    نهاية

    ## إحصائيات عامة
    دالة اطبع_إحصائيات()
        اطبع_سطر("────── إحصائيات IPC ──────")
        اطبع("  أنابيب: ") اطبع_سطر(طول(الأنابيب))
        اطبع("  طوابير رسائل: ") اطبع_سطر(طول(الطوابير))
        اطبع("  مناطق مشتركة: ") اطبع_سطر(طول(المناطق_المشتركة))
        اطبع("  إشارات: ") اطبع_سطر(طول(الإشارات))
        اطبع("  مقابس: ") اطبع_سطر(طول(المقابس))
    نهاية
نهاية

