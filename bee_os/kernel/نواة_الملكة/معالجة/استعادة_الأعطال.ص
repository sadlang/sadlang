# استعادة_الأعطال.ص — توبة النظام: استعادة بعد الأعطال
# ══════════════════════════════════════════════════════════════════════════════
# مهمة ٩٤: نقاط استعادة + سجل الأعطال + تشخيص + إصلاح تلقائي
# ══════════════════════════════════════════════════════════════════════════════

# مستويات الخطورة
ثابت خطورة_تحذير = 1
ثابت خطورة_خطأ = 2
ثابت خطورة_حرج = 3
ثابت خطورة_كارثي = 4

# أنواع الأعطال
ثابت عطل_ذاكرة = 1
ثابت عطل_ملفات = 2
ثابت عطل_شبكة = 3
ثابت عطل_تطبيق = 4
ثابت عطل_نواة = 5
ثابت عطل_سائق = 6

صنف نقطة_استعادة
    رقم المعرف
    نص الوقت
    نص الوصف
    رقم حجم_البيانات
    منطقي صالحة

    باني(رقم معرف, نص وقت, نص وصف)
        المعرف = معرف
        الوقت = وقت
        الوصف = وصف
        حجم_البيانات = 0
        صالحة = صحيح
    نهاية

    دالة اطبع_معلومات()
        اطبع("    [") اطبع(المعرف) اطبع("] ")
        اطبع(الوقت) اطبع(" - ") اطبع(الوصف)
        اذا (صالحة)
            اطبع_سطر(" (صالحة)")
        والا
            اطبع_سطر(" (تالفة)")
        نهاية
    نهاية
نهاية

صنف سجل_عطل
    رقم المعرف
    رقم نوع_العطل
    رقم الخطورة
    نص الرسالة
    نص الوقت
    منطقي تم_الإصلاح

    باني(رقم معرف, رقم نوع, رقم خطر, نص رسالة, نص وقت)
        المعرف = معرف
        نوع_العطل = نوع
        الخطورة = خطر
        الرسالة = رسالة
        الوقت = وقت
        تم_الإصلاح = خطأ
    نهاية

    دالة اسم_النوع()
        اذا (نوع_العطل == عطل_ذاكرة)
            ارجع "ذاكرة"
        والا_اذا (نوع_العطل == عطل_ملفات)
            ارجع "ملفات"
        والا_اذا (نوع_العطل == عطل_شبكة)
            ارجع "شبكة"
        والا_اذا (نوع_العطل == عطل_تطبيق)
            ارجع "تطبيق"
        والا_اذا (نوع_العطل == عطل_نواة)
            ارجع "نواة"
        والا_اذا (نوع_العطل == عطل_سائق)
            ارجع "سائق"
        نهاية
        ارجع "مجهول"
    نهاية

    دالة اسم_الخطورة()
        اذا (الخطورة == خطورة_تحذير)
            ارجع "تحذير"
        والا_اذا (الخطورة == خطورة_خطأ)
            ارجع "خطأ"
        والا_اذا (الخطورة == خطورة_حرج)
            ارجع "حرج"
        والا_اذا (الخطورة == خطورة_كارثي)
            ارجع "كارثي"
        نهاية
        ارجع "مجهول"
    نهاية

    دالة اطبع_معلومات()
        اطبع("    [") اطبع(اسم_الخطورة()) اطبع("] ")
        اطبع(اسم_النوع()) اطبع(": ")
        اطبع(الرسالة)
        اذا (تم_الإصلاح)
            اطبع_سطر(" ← تم الإصلاح")
        والا
            اطبع_سطر(" ← معلق")
        نهاية
    نهاية
نهاية

صنف مدير_الاستعادة
    رقم عدد_النقاط
    رقم عدد_الأعطال
    رقم أعطال_مصلحة
    رقم حد_النقاط
    منطقي وضع_الطوارئ

    باني()
        عدد_النقاط = 0
        عدد_الأعطال = 0
        أعطال_مصلحة = 0
        حد_النقاط = 50
        وضع_الطوارئ = خطأ
    نهاية

    دالة أنشئ_نقطة_استعادة(نص وصف)
        عدد_النقاط = عدد_النقاط + 1
        متغير نقطة = جديد نقطة_استعادة(عدد_النقاط, "14:30:00", وصف)
        نقطة.حجم_البيانات = 1024 * عدد_النقاط
        اطبع("  نقطة استعادة #") اطبع(عدد_النقاط) اطبع(": ") اطبع_سطر(وصف)
        ارجع نقطة
    نهاية

    دالة سجل_عطل_جديد(رقم نوع, رقم خطر, نص رسالة)
        عدد_الأعطال = عدد_الأعطال + 1
        متغير سجل = جديد سجل_عطل(عدد_الأعطال, نوع, خطر, رسالة, "14:35:00")
        اطبع("  عطل #") اطبع(عدد_الأعطال) اطبع(": ")
        سجل.اطبع_معلومات()

        # إصلاح تلقائي
        اذا (خطر <= خطورة_خطأ)
            اطبع("    محاولة إصلاح تلقائي...")
            سجل.تم_الإصلاح = صحيح
            أعطال_مصلحة = أعطال_مصلحة + 1
            اطبع_سطر("    تم الإصلاح بنجاح!")
        والا_اذا (خطر == خطورة_حرج)
            اطبع_سطر("    يتطلب استعادة من نقطة استعادة")
            محاكاة_استعادة()
            سجل.تم_الإصلاح = صحيح
            أعطال_مصلحة = أعطال_مصلحة + 1
        والا
            اطبع_سطر("    كارثي! تفعيل وضع الطوارئ")
            وضع_الطوارئ = صحيح
            بروتوكول_الطوارئ()
        نهاية

        ارجع سجل
    نهاية

    دالة محاكاة_استعادة()
        اطبع_سطر("    [استعادة] البحث عن أحدث نقطة صالحة...")
        اطبع_سطر("    [استعادة] استعادة حالة الذاكرة...")
        اطبع_سطر("    [استعادة] استعادة جدول العمليات...")
        اطبع_سطر("    [استعادة] التحقق من تكامل البيانات...")
        اطبع_سطر("    [استعادة] النظام مستعاد بنجاح!")
    نهاية

    دالة بروتوكول_الطوارئ()
        اطبع_سطر("    ═══════ بروتوكول الطوارئ ═══════")
        اطبع_سطر("    1. حفظ فوري لجميع البيانات")
        اطبع_سطر("    2. إيقاف العمليات غير الحرجة")
        اطبع_سطر("    3. تفعيل الوضع الآمن")
        اطبع_سطر("    4. إنشاء تقرير تشخيصي")
        اطبع_سطر("    استودعكم الله — النظام يدخل الوضع الآمن")
        اطبع_سطر("    ═══════════════════════════════════")
    نهاية

    دالة تشخيص_شامل()
        اطبع_سطر("  ═══════ تقرير التشخيص ═══════")
        اطبع("  نقاط الاستعادة: ") اطبع_سطر(عدد_النقاط)
        اطبع("  إجمالي الأعطال: ") اطبع_سطر(عدد_الأعطال)
        اطبع("  أعطال مصلحة: ") اطبع_سطر(أعطال_مصلحة)
        اذا (عدد_الأعطال > 0)
            متغير نسبة = (أعطال_مصلحة * 100) / عدد_الأعطال
            اطبع("  نسبة الإصلاح: ") اطبع(نسبة) اطبع_سطر("%")
        نهاية
        اطبع("  وضع الطوارئ: ") اطبع_سطر(وضع_الطوارئ)
        اطبع_سطر("  ════════════════════════════════")
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════")
    اطبع_سطر("  توبة النظام — استعادة بعد الأعطال")
    اطبع_سطر("══════════════════════════════════════════════")

    متغير مدير = جديد مدير_الاستعادة()

    # إنشاء نقاط استعادة
    اطبع_سطر("")
    اطبع_سطر("[1] إنشاء نقاط استعادة...")
    مدير.أنشئ_نقطة_استعادة("بداية النظام")
    مدير.أنشئ_نقطة_استعادة("بعد تحميل السائقات")
    مدير.أنشئ_نقطة_استعادة("بعد تشغيل واجهة المستخدم")
    مدير.أنشئ_نقطة_استعادة("قبل تثبيت التحديث")

    # محاكاة أعطال مختلفة
    اطبع_سطر("")
    اطبع_سطر("[2] محاكاة أعطال...")
    مدير.سجل_عطل_جديد(عطل_تطبيق, خطورة_تحذير, "تطبيق الآلة الحاسبة توقف")
    اطبع_سطر("")
    مدير.سجل_عطل_جديد(عطل_ذاكرة, خطورة_خطأ, "تسرب ذاكرة في مدير النوافذ")
    اطبع_سطر("")
    مدير.سجل_عطل_جديد(عطل_ملفات, خطورة_حرج, "تلف في جدول الملفات")
    اطبع_سطر("")
    مدير.سجل_عطل_جديد(عطل_نواة, خطورة_كارثي, "خطأ في المجدول الرئيسي")

    # تقرير نهائي
    اطبع_سطر("")
    اطبع_سطر("[3] التقرير النهائي...")
    مدير.تشخيص_شامل()

    اطبع_سطر("")
    اطبع_سطر("  جميع اختبارات استعادة الأعطال نجحت!")
    ارجع 0
نهاية
