# تقوية_العمليات_والجدولة.ص - نظام العمليات والجدولة لنظام خلية النحل (BeeOS)
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# هذا الملف يُنشئ نظام إدارة عمليات كامل مع جدولة متعددة الخوارزميات:
#
# 1. كتلة التحكم بالعملية (PCB - Process Control Block)
#    - معرّف العملية (PID)
#    - أولوية العملية (0=أعلى، 3=أدنى)
#    - وضعية العملية (جاهزة/تعمل/محجوبة/ميتة/جديدة)
#    - زمن التنفيذ وزمن الانتظار
#    - مُعرّف العملية الأم (PPID)
#
# 2. السياق (Context)
#    - محاكاة السجلات (EAX/EBX/ECX/EDX/ESP/EBP/EIP/EFLAGS)
#    - حفظ واسترجاع السياق عند تبديل العمليات
#
# 3. المُجَدوِل (Scheduler) — 3 خوارزميات:
#    أ. Round Robin (دائري): كل عملية تحصل على شريحة زمنية متساوية
#    ب. Priority Queue (أولوية): العملية الأعلى أولوية تعمل أولاً
#    ج. رقصة السرب (Bee Swarm): خوارزمية مستوحاة من النحل
#       - تقسم العمليات إلى عاملات/كشّافات/حارسات
#       - العاملات تحصل على وقت أكثر
#       - الكشّافات (I/O bound) تحصل على أولوية الاستجابة
#
# 4. مدير العمليات (Process Manager)
#    - إنشاء عمليات جديدة (fork simulation)
#    - إنهاء العمليات (kill)
#    - إيقاف مؤقت واستئناف
#    - شجرة العمليات (parent-child)
#    - جمع العمليات الميتة (reaping zombies)
#
# 5. نظام الإشارات (Signals)
#    - SIGKILL (إنهاء فوري)
#    - SIGSTOP (إيقاف مؤقت)
#    - SIGCONT (استئناف)
#    - SIGCHLD (إخطار الأب بموت الابن)
#
# 6. إحصائيات الجدولة
#    - عدد تبديلات السياق
#    - متوسط وقت الانتظار
#    - استخدام المعالج
#
# المعمارية:
# ━━━━━━━━━━
#  مدير_العمليات_المُقوّى
#    ├── جدول_العمليات[PCB]
#    ├── المُجَدوِل
#    │     ├── Round Robin
#    │     ├── Priority Queue
#    │     └── رقصة السرب
#    ├── نظام_الإشارات
#    └── إحصائيات الجدولة
#
# الكلمات المحجوزة المتجنَّبة:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━
# حجم → مقاس | نهاية → عنوان_آخر | خريطة → جدول
# نوع → نمط | حالة → وضعية | صنف_ → فئة_
# ارجع (مجرّد) → ارجع 0
#
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت العمليات والجدولة
# ─────────────────────────────────────────────────────────────────────────────

# وضعيات العمليات
ثابت وضعية_جديدة = 0
ثابت وضعية_جاهزة = 1
ثابت وضعية_تعمل = 2
ثابت وضعية_محجوبة = 3
ثابت وضعية_ميتة = 4
ثابت وضعية_متوقفة = 5

# مستويات الأولوية
ثابت أولوية_حرجة = 0       # أعلى أولوية (نواة)
ثابت أولوية_عالية = 1
ثابت أولوية_عادية = 2
ثابت أولوية_منخفضة = 3     # أدنى أولوية (خلفية)

# خوارزميات الجدولة
ثابت جدولة_دائرية = 1       # Round Robin
ثابت جدولة_أولوية = 2       # Priority Queue
ثابت جدولة_سرب = 3          # Bee Swarm (رقصة السرب)

# الإشارات
ثابت إشارة_إنهاء = 9        # SIGKILL
ثابت إشارة_إيقاف = 19       # SIGSTOP
ثابت إشارة_استئناف = 18     # SIGCONT
ثابت إشارة_ابن_مات = 17     # SIGCHLD

# أنماط العمليات (للسرب)
ثابت نمط_عاملة = 1          # CPU-bound
ثابت نمط_كشّافة = 2         # I/O-bound
ثابت نمط_حارسة = 3          # نظام/نواة

# ثوابت زمنية
ثابت شريحة_زمنية_افتراضية = 10    # 10 وحدات زمنية
ثابت أقصى_عمليات = 256             # أقصى عدد عمليات
ثابت عتبة_ترقية = 50               # ترقية أولوية بعد 50 وحدة انتظار

# ─────────────────────────────────────────────────────────────────────────────
# صنف سياق_م - سجلات المعالج (محاكاة x86)
# ─────────────────────────────────────────────────────────────────────────────
صنف سياق_م
    ## محاكاة سجلات المعالج x86 لحفظ/استرجاع سياق العملية

    رقم EAX
    رقم EBX
    رقم ECX
    رقم EDX
    رقم ESP                    # مؤشر المكدس
    رقم EBP                    # قاعدة المكدس
    رقم EIP                    # مؤشر التعليمات
    رقم EFLAGS                 # أعلام المعالج

    باني()
        EAX = 0
        EBX = 0
        ECX = 0
        EDX = 0
        ESP = 0
        EBP = 0
        EIP = 0
        EFLAGS = 0
    نهاية

    ## حفظ السياق من عملية تعمل
    دالة احفظ(رقم eax_ل، رقم esp_ل، رقم eip_ل)
        EAX = eax_ل
        ESP = esp_ل
        EIP = eip_ل
    نهاية

    ## نسخ السياق (لـ fork)
    دالة انسخ_إلى(رقم eax_ج، رقم esp_ج، رقم eip_ج)
        EAX = eax_ج
        ESP = esp_ج
        EIP = eip_ج
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف عملية_م - كتلة التحكم بالعملية (PCB)
# ─────────────────────────────────────────────────────────────────────────────
صنف عملية_م
    ## كتلة التحكم بالعملية (Process Control Block)
    ## تحتوي جميع المعلومات اللازمة لإدارة العملية

    رقم المعرّف_PID             # معرّف العملية
    رقم معرّف_الأب             # معرّف العملية الأم (PPID)
    نص اسم_العملية             # اسم بشري
    رقم الوضعية_م              # وضعية العملية الحالية
    رقم الأولوية               # مستوى الأولوية (0-3)
    رقم نمط_العملية            # نمط السرب (عاملة/كشّافة/حارسة)

    رقم الشريحة_الزمنية        # الشريحة الزمنية المخصصة
    رقم الشريحة_المتبقية       # الشريحة المتبقية

    رقم زمن_الإنشاء            # وقت إنشاء العملية
    رقم زمن_التنفيذ_الكلي      # إجمالي وقت التنفيذ
    رقم زمن_الانتظار           # إجمالي وقت الانتظار
    رقم آخر_تشغيل              # آخر مرة عملت فيها

    مصفوفة إشارات_مُعلّقة      # قائمة الإشارات المُعلّقة
    مصفوفة أبناء               # معرّفات العمليات الأبناء

    رقم عنوان_الذاكرة          # عنوان ذاكرة العملية (وهمي)
    رقم مقاس_الذاكرة           # حجم الذاكرة المخصصة

    باني(رقم pid_ل، نص الاسم_ل، رقم الأولوية_ل)
        المعرّف_PID = pid_ل
        معرّف_الأب = 0
        اسم_العملية = الاسم_ل
        الوضعية_م = وضعية_جديدة
        الأولوية = الأولوية_ل
        نمط_العملية = نمط_عاملة

        الشريحة_الزمنية = شريحة_زمنية_افتراضية
        الشريحة_المتبقية = شريحة_زمنية_افتراضية

        زمن_الإنشاء = 0
        زمن_التنفيذ_الكلي = 0
        زمن_الانتظار = 0
        آخر_تشغيل = 0

        إشارات_مُعلّقة = []
        أبناء = []

        عنوان_الذاكرة = 0
        مقاس_الذاكرة = 4096
    نهاية

    ## هل العملية حية؟
    دالة منطقي حية()
        ارجع الوضعية_م != وضعية_ميتة
    نهاية

    ## إضافة إشارة
    دالة أرسل_إشارة(رقم الإشارة_ل)
        إشارات_مُعلّقة += [الإشارة_ل]
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف المُجَدوِل - Scheduler
# ─────────────────────────────────────────────────────────────────────────────
صنف المُجَدوِل
    ## المُجَدوِل الرئيسي - يختار العملية التالية للتنفيذ
    ## يدعم 3 خوارزميات: دائري، أولوية، رقصة السرب

    رقم الخوارزمية              # الخوارزمية المختارة
    رقم مؤشر_الدائري           # مؤشر Round Robin
    رقم عدد_التبديلات          # عدد تبديلات السياق
    رقم الساعة                 # ساعة وهمية

    باني(رقم الخوارزمية_ل)
        الخوارزمية = الخوارزمية_ل
        مؤشر_الدائري = 0
        عدد_التبديلات = 0
        الساعة = 0
    نهاية

    ## اختيار العملية التالية — Round Robin
    دالة رقم اختر_دائري(مصفوفة العمليات_ل)
        متغير عدد_جاهزة = 0
        متغير ف = 0
        بينما (ف < طول(العمليات_ل))
            اذا (العمليات_ل[ف].الوضعية_م == وضعية_جاهزة)
                عدد_جاهزة = عدد_جاهزة + 1
            نهاية
            ف = ف + 1
        نهاية

        اذا (عدد_جاهزة == 0) ارجع -1 نهاية

        # ابحث عن التالي بترتيب دائري
        متغير محاولات = 0
        بينما (محاولات < طول(العمليات_ل))
            مؤشر_الدائري = (مؤشر_الدائري + 1) % طول(العمليات_ل)
            اذا (العمليات_ل[مؤشر_الدائري].الوضعية_م == وضعية_جاهزة)
                ارجع مؤشر_الدائري
            نهاية
            محاولات = محاولات + 1
        نهاية

        ارجع -1
    نهاية

    ## اختيار العملية التالية — Priority Queue
    دالة رقم اختر_أولوية(مصفوفة العمليات_ل)
        متغير أفضل = -1
        متغير أفضل_أولوية = 999

        متغير ف = 0
        بينما (ف < طول(العمليات_ل))
            اذا (العمليات_ل[ف].الوضعية_م == وضعية_جاهزة)
                اذا (العمليات_ل[ف].الأولوية < أفضل_أولوية)
                    أفضل = ف
                    أفضل_أولوية = العمليات_ل[ف].الأولوية
                والا_اذا (العمليات_ل[ف].الأولوية == أفضل_أولوية)
                    # عند التساوي: اختر العملية الأقل تنفيذاً
                    اذا (أفضل >= 0)
                        اذا (العمليات_ل[ف].زمن_التنفيذ_الكلي < العمليات_ل[أفضل].زمن_التنفيذ_الكلي)
                            أفضل = ف
                        نهاية
                    نهاية
                نهاية
            نهاية
            ف = ف + 1
        نهاية

        ارجع أفضل
    نهاية

    ## اختيار العملية التالية — رقصة السرب
    دالة رقم اختر_سرب(مصفوفة العمليات_ل)
        ## خوارزمية مستوحاة من سلوك خلية النحل:
        ## - الحارسات (نواة) دائماً أولاً
        ## - الكشّافات (I/O) تحصل على أولوية الاستجابة
        ## - العاملات (CPU) تحصل على شرائح أطول

        # أولاً: ابحث عن حارسات جاهزة
        متغير ف = 0
        بينما (ف < طول(العمليات_ل))
            اذا (العمليات_ل[ف].الوضعية_م == وضعية_جاهزة && العمليات_ل[ف].نمط_العملية == نمط_حارسة)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية

        # ثانياً: ابحث عن كشّافات جاهزة
        ف = 0
        بينما (ف < طول(العمليات_ل))
            اذا (العمليات_ل[ف].الوضعية_م == وضعية_جاهزة && العمليات_ل[ف].نمط_العملية == نمط_كشّافة)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية

        # ثالثاً: عاملات (Round Robin ضمنها)
        ارجع اختر_دائري(العمليات_ل)
    نهاية

    ## اختيار العملية التالية (حسب الخوارزمية المختارة)
    دالة رقم اختر_التالية(مصفوفة العمليات_ل)
        الساعة = الساعة + 1

        اذا (الخوارزمية == جدولة_دائرية)
            ارجع اختر_دائري(العمليات_ل)
        نهاية
        اذا (الخوارزمية == جدولة_أولوية)
            ارجع اختر_أولوية(العمليات_ل)
        نهاية
        اذا (الخوارزمية == جدولة_سرب)
            ارجع اختر_سرب(العمليات_ل)
        نهاية

        # افتراضي: دائري
        ارجع اختر_دائري(العمليات_ل)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدير_العمليات_المُقوّى - Process Manager
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_العمليات_المُقوّى
    ## مدير العمليات الرئيسي
    ## يُنشئ ويُنهي ويُجدول العمليات

    مصفوفة العمليات             # جدول العمليات (PCB)
    رقم آخر_PID                # آخر PID مُعطى
    رقم العملية_الحالية         # فهرس العملية الجارية (-1 = لا شيء)
    رقم الساعة_م               # ساعة المدير

    # إحصائيات
    رقم عدد_التبديلات
    رقم عدد_الإنشاءات
    رقم عدد_الإنهاءات

    باني()
        العمليات = []
        آخر_PID = 0
        العملية_الحالية = -1
        الساعة_م = 0
        عدد_التبديلات = 0
        عدد_الإنشاءات = 0
        عدد_الإنهاءات = 0
    نهاية

    ## إنشاء عملية جديدة
    دالة رقم أنشئ(نص الاسم_ل، رقم الأولوية_ل، رقم نمط_ل)
        آخر_PID = آخر_PID + 1
        متغير عملية = جديد عملية_م(آخر_PID، الاسم_ل، الأولوية_ل)
        عملية.نمط_العملية = نمط_ل
        عملية.زمن_الإنشاء = الساعة_م
        عملية.الوضعية_م = وضعية_جاهزة
        عملية.عنوان_الذاكرة = آخر_PID * 65536    # ذاكرة وهمية
        العمليات += [عملية]
        عدد_الإنشاءات = عدد_الإنشاءات + 1
        ارجع آخر_PID
    نهاية

    ## إنشاء عملية ابن (fork)
    دالة رقم شوكة(رقم pid_الأب)
        # ابحث عن الأب
        متغير فهرس_الأب = ابحث_بـ_PID(pid_الأب)
        اذا (فهرس_الأب < 0) ارجع -1 نهاية

        # أنشئ الابن
        آخر_PID = آخر_PID + 1
        متغير ابن = جديد عملية_م(آخر_PID، العمليات[فهرس_الأب].اسم_العملية + "_ابن"، العمليات[فهرس_الأب].الأولوية)
        ابن.معرّف_الأب = pid_الأب
        ابن.نمط_العملية = العمليات[فهرس_الأب].نمط_العملية
        ابن.زمن_الإنشاء = الساعة_م
        ابن.الوضعية_م = وضعية_جاهزة
        ابن.عنوان_الذاكرة = آخر_PID * 65536

        العمليات += [ابن]
        متغير أبناء_الأب = العمليات[فهرس_الأب].أبناء
        أبناء_الأب += [آخر_PID]
        العمليات[فهرس_الأب].أبناء = أبناء_الأب
        عدد_الإنشاءات = عدد_الإنشاءات + 1

        ارجع آخر_PID
    نهاية

    ## البحث بـ PID
    دالة رقم ابحث_بـ_PID(رقم pid_ل)
        متغير ف = 0
        بينما (ف < طول(العمليات))
            اذا (العمليات[ف].المعرّف_PID == pid_ل)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    ## إرسال إشارة لعملية
    دالة منطقي أرسل_إشارة(رقم pid_ل، رقم الإشارة_ل)
        متغير ف = ابحث_بـ_PID(pid_ل)
        اذا (ف < 0) ارجع خطأ نهاية

        # معالجة فورية لبعض الإشارات
        اذا (الإشارة_ل == إشارة_إنهاء)
            العمليات[ف].الوضعية_م = وضعية_ميتة
            عدد_الإنهاءات = عدد_الإنهاءات + 1
            # إخطار الأب
            اذا (العمليات[ف].معرّف_الأب > 0)
                أرسل_إشارة(العمليات[ف].معرّف_الأب، إشارة_ابن_مات)
            نهاية
            ارجع صحيح
        نهاية

        اذا (الإشارة_ل == إشارة_إيقاف)
            العمليات[ف].الوضعية_م = وضعية_متوقفة
            ارجع صحيح
        نهاية

        اذا (الإشارة_ل == إشارة_استئناف)
            اذا (العمليات[ف].الوضعية_م == وضعية_متوقفة)
                العمليات[ف].الوضعية_م = وضعية_جاهزة
            نهاية
            ارجع صحيح
        نهاية

        # إشارات أخرى: أضفها للقائمة
        العمليات[ف].أرسل_إشارة(الإشارة_ل)
        ارجع صحيح
    نهاية

    ## تشغيل عملية (محاكاة)
    دالة شغّل_عملية(رقم فهرس_ل، رقم وحدات_زمنية)
        اذا (فهرس_ل < 0 || فهرس_ل >= طول(العمليات)) ارجع 0 نهاية

        العمليات[فهرس_ل].الوضعية_م = وضعية_تعمل
        العمليات[فهرس_ل].آخر_تشغيل = الساعة_م

        # محاكاة التنفيذ
        متغير وقت_فعلي = وحدات_زمنية
        اذا (وقت_فعلي > العمليات[فهرس_ل].الشريحة_المتبقية)
            وقت_فعلي = العمليات[فهرس_ل].الشريحة_المتبقية
        نهاية

        العمليات[فهرس_ل].زمن_التنفيذ_الكلي = العمليات[فهرس_ل].زمن_التنفيذ_الكلي + وقت_فعلي
        العمليات[فهرس_ل].الشريحة_المتبقية = العمليات[فهرس_ل].الشريحة_المتبقية - وقت_فعلي
        الساعة_م = الساعة_م + وقت_فعلي

        # انتهت الشريحة؟
        اذا (العمليات[فهرس_ل].الشريحة_المتبقية <= 0)
