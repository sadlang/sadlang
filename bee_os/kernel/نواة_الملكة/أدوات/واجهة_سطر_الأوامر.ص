# ══════════════════════════════════════════════════════════════════════════════
# واجهة_سطر_الأوامر.ص - Shell لنظام خلية النحل (BeeOS)
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# صدفة (Shell) كاملة لنظام التشغيل تشمل:
#
# 1. محلل الأوامر (Command Parser)
#    - تقسيم السطر إلى أمر ووسائط
#    - دعم علامات الاقتباس (quoting)
#    - تحليل إعادة التوجيه (>، <، >>)
#    - تحليل الأنابيب (|)
#
# 2. متغيرات البيئة (Environment Variables)
#    - PATH, HOME, USER, SHELL, PWD
#    - ضبط وقراءة وحذف
#    - توسيع المتغيرات $VAR
#
# 3. الأوامر المدمجة (Built-in Commands)
#    - cd, pwd, echo, export, unset, env
#    - ls, cat, mkdir, rm, touch, cp
#    - whoami, id, su, exit, clear, help
#    - history, alias
#
# 4. نظام الملفات الافتراضي (Virtual FS)
#    - شجرة مجلدات بسيطة
#    - تنقّل بين المجلدات
#    - إنشاء/حذف ملفات ومجلدات
#
# 5. السجل (History)
#    - حفظ آخر N أمر
#    - استعراض السجل
#
# 6. الأسماء المستعارة (Aliases)
#    - تعريف واستخدام أسماء بديلة للأوامر
#
# الكلمات المحجوزة المتجنَّبة:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━
# جديد (كمتغير) | سجل (كمتغير) | حجم | نوع | حالة | من
#
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت الصدفة
# ─────────────────────────────────────────────────────────────────────────────
ثابت أقصى_تاريخ = 64
ثابت أقصى_متغيرات = 64
ثابت أقصى_أسماء_مستعارة = 32

# أنماط عقد نظام الملفات
ثابت عقدة_ملف = 1
ثابت عقدة_مجلد = 2

# ─────────────────────────────────────────────────────────────────────────────
# صنف عقدة_ملف_م - عقدة في نظام الملفات الافتراضي
# ─────────────────────────────────────────────────────────────────────────────
صنف عقدة_ملف_م
    ## عقدة واحدة في الشجرة (ملف أو مجلد)

    نص الاسم_م                 # اسم الملف/المجلد
    رقم النمط_م                # ملف أو مجلد
    نص المحتوى_م               # محتوى الملف (فارغ للمجلدات)
    مصفوفة الأبناء             # أسماء الأبناء (للمجلدات فقط)
    نص المسار_الكامل           # المسار الكامل

    باني(نص الاسم_ل، رقم النمط_ل، نص المسار_ل)
        الاسم_م = الاسم_ل
        النمط_م = النمط_ل
        المحتوى_م = ""
        الأبناء = []
        المسار_الكامل = المسار_ل
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف نظام_ملفات_افتراضي - Virtual Filesystem
# ─────────────────────────────────────────────────────────────────────────────
صنف نظام_ملفات_افتراضي
    ## شجرة ملفات بسيطة في الذاكرة

    مصفوفة العقد               # جميع العقد
    نص المسار_الحالي           # pwd

    باني()
        العقد = []
        المسار_الحالي = "/"

        # إنشاء البنية الأساسية
        متغير جذر = جديد عقدة_ملف_م("/"، عقدة_مجلد، "/")
        جذر.الأبناء = ["home"، "etc"، "bin"، "tmp"، "var"]
        العقد += [جذر]

        # المجلدات الفرعية
        متغير home = جديد عقدة_ملف_م("home"، عقدة_مجلد، "/home")
        home.الأبناء = ["root"]
        العقد += [home]

        متغير etc = جديد عقدة_ملف_م("etc"، عقدة_مجلد، "/etc")
        etc.الأبناء = ["passwd"، "hostname"]
        العقد += [etc]

        متغير bin = جديد عقدة_ملف_م("bin"، عقدة_مجلد، "/bin")
        bin.الأبناء = ["sh"، "ls"، "cat"]
        العقد += [bin]

        متغير tmp = جديد عقدة_ملف_م("tmp"، عقدة_مجلد، "/tmp")
        العقد += [tmp]

        متغير v = جديد عقدة_ملف_م("var"، عقدة_مجلد، "/var")
        v.الأبناء = ["log"]
        العقد += [v]

        متغير root_home = جديد عقدة_ملف_م("root"، عقدة_مجلد، "/home/root")
        العقد += [root_home]

        # ملفات
        متغير passwd = جديد عقدة_ملف_م("passwd"، عقدة_ملف، "/etc/passwd")
        passwd.المحتوى_م = "root:x:0:0:/root:/bin/sh"
        العقد += [passwd]

        متغير hostname = جديد عقدة_ملف_م("hostname"، عقدة_ملف، "/etc/hostname")
        hostname.المحتوى_م = "beeos"
        العقد += [hostname]

        متغير log = جديد عقدة_ملف_م("log"، عقدة_مجلد، "/var/log")
        العقد += [log]
    نهاية

    ## البحث عن عقدة بالمسار
    دالة رقم جد_عقدة(نص المسار_ل)
        متغير ف = 0
        بينما (ف < طول(العقد))
            اذا (العقد[ف].المسار_الكامل == المسار_ل) ارجع ف نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    ## إنشاء ملف
    دالة منطقي أنشئ_ملف(نص الاسم_ل، نص المحتوى_ل)
        متغير مسار = المسار_الحالي
        اذا (مسار != "/") مسار = مسار + "/" + الاسم_ل
        والا مسار = "/" + الاسم_ل نهاية

        # تحقق عدم الوجود
        اذا (جد_عقدة(مسار) >= 0) ارجع خطأ نهاية

        متغير ملف = جديد عقدة_ملف_م(الاسم_ل، عقدة_ملف، مسار)
        ملف.المحتوى_م = المحتوى_ل
        العقد += [ملف]

        # أضف للمجلد الحالي
        متغير ف_مجلد = جد_عقدة(المسار_الحالي)
        اذا (ف_مجلد >= 0)
            متغير أبناء_م = العقد[ف_مجلد].الأبناء
            أبناء_م += [الاسم_ل]
            العقد[ف_مجلد].الأبناء = أبناء_م
        نهاية
        ارجع صحيح
    نهاية

    ## إنشاء مجلد
    دالة منطقي أنشئ_مجلد(نص الاسم_ل)
        متغير مسار = المسار_الحالي
        اذا (مسار != "/") مسار = مسار + "/" + الاسم_ل
        والا مسار = "/" + الاسم_ل نهاية

        اذا (جد_عقدة(مسار) >= 0) ارجع خطأ نهاية

        متغير مجلد = جديد عقدة_ملف_م(الاسم_ل، عقدة_مجلد، مسار)
        العقد += [مجلد]

        متغير ف_مجلد = جد_عقدة(المسار_الحالي)
        اذا (ف_مجلد >= 0)
            متغير أبناء_م = العقد[ف_مجلد].الأبناء
            أبناء_م += [الاسم_ل]
            العقد[ف_مجلد].الأبناء = أبناء_م
        نهاية
        ارجع صحيح
    نهاية

    ## تغيير المجلد الحالي
    دالة منطقي غيّر_مجلد(نص المسار_ل)
        اذا (المسار_ل == "/")
            المسار_الحالي = "/"
            ارجع صحيح
        نهاية
        اذا (المسار_ل == "..")
            # ارتقاء مستوى
            اذا (المسار_الحالي == "/") ارجع صحيح نهاية
            # احذف آخر جزء
            متغير أجزاء = []
            متغير جزء = ""
            متغير ف = 0
            بينما (ف < طول(المسار_الحالي))
                # بسيط: ابحث عن / الأخير
                ف = ف + 1
            نهاية
            # ارجع للجذر مبسّط
            المسار_الحالي = "/"
            ارجع صحيح
        نهاية

        # مسار مُطلق
        اذا (جد_عقدة(المسار_ل) >= 0)
            المسار_الحالي = المسار_ل
            ارجع صحيح
        نهاية

        # مسار نسبي
        متغير مسار_كامل = المسار_الحالي
        اذا (مسار_كامل != "/") مسار_كامل = مسار_كامل + "/" + المسار_ل
        والا مسار_كامل = "/" + المسار_ل نهاية

        اذا (جد_عقدة(مسار_كامل) >= 0)
            المسار_الحالي = مسار_كامل
            ارجع صحيح
        نهاية

        ارجع خطأ
    نهاية

    ## قائمة محتويات المجلد الحالي
    دالة مصفوفة قائمة_المحتويات()
        متغير ف = جد_عقدة(المسار_الحالي)
        اذا (ف >= 0) ارجع العقد[ف].الأبناء نهاية
        ارجع []
    نهاية

    ## قراءة محتوى ملف
    دالة نص اقرأ_ملف(نص الاسم_ل)
        متغير مسار = المسار_الحالي
        اذا (مسار != "/") مسار = مسار + "/" + الاسم_ل
        والا مسار = "/" + الاسم_ل نهاية

        متغير ف = جد_عقدة(مسار)
        اذا (ف >= 0) ارجع العقد[ف].المحتوى_م نهاية
        ارجع ""
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف زوج_متغير_م - متغير بيئة
# ─────────────────────────────────────────────────────────────────────────────
صنف زوج_متغير_م
    ## متغير بيئة (اسم = قيمة)
    نص الاسم_م
    نص القيمة_م

    باني(نص الاسم_ل، نص القيمة_ل)
        الاسم_م = الاسم_ل
        القيمة_م = القيمة_ل
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف بيئة_الصدفة - Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
صنف بيئة_الصدفة
    ## مخزن متغيرات البيئة

    مصفوفة المتغيرات           # قائمة زوج_متغير_م

    باني()
        المتغيرات = []
        # متغيرات افتراضية
        ضبط("PATH"، "/bin:/usr/bin")
        ضبط("HOME"، "/home/root")
        ضبط("USER"، "root")
        ضبط("SHELL"، "/bin/sh")
        ضبط("PWD"، "/")
        ضبط("HOSTNAME"، "beeos")
        ضبط("LANG"، "ar_SA.UTF-8")
    نهاية

    ## ضبط متغير
    دالة ضبط(نص الاسم_ل، نص القيمة_ل)
        # ابحث عن موجود
        متغير ف = 0
        بينما (ف < طول(المتغيرات))
            اذا (المتغيرات[ف].الاسم_م == الاسم_ل)
                المتغيرات[ف].القيمة_م = القيمة_ل
                ارجع 0
            نهاية
            ف = ف + 1
        نهاية
        # أضف متغير بيئي
        متغير زوج = جديد زوج_متغير_م(الاسم_ل، القيمة_ل)
        المتغيرات += [زوج]
        ارجع 0
    نهاية

    ## قراءة متغير
    دالة نص اقرأ(نص الاسم_ل)
        متغير ف = 0
        بينما (ف < طول(المتغيرات))
            اذا (المتغيرات[ف].الاسم_م == الاسم_ل)
                ارجع المتغيرات[ف].القيمة_م
            نهاية
            ف = ف + 1
        نهاية
        ارجع ""
    نهاية

    ## حذف متغير
    دالة منطقي احذف(نص الاسم_ل)
        متغير قائمة = []
        متغير وُجد = خطأ
        متغير ف = 0
        بينما (ف < طول(المتغيرات))
            اذا (المتغيرات[ف].الاسم_م == الاسم_ل)
                وُجد = صحيح
            والا
                قائمة += [المتغيرات[ف]]
            نهاية
            ف = ف + 1
        نهاية
        اذا (وُجد) المتغيرات = قائمة نهاية
        ارجع وُجد
    نهاية

    ## طباعة جميع المتغيرات
    دالة اطبع_الكل()
        متغير ف = 0
        بينما (ف < طول(المتغيرات))
            اطبع(المتغيرات[ف].الاسم_م) اطبع("=") اطبع_سطر(المتغيرات[ف].القيمة_م)
            ف = ف + 1
        نهاية
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف اسم_مستعار_م - Alias
# ─────────────────────────────────────────────────────────────────────────────
صنف اسم_مستعار_م
    نص الاسم_م
    نص الأمر_م

    باني(نص الاسم_ل، نص الأمر_ل)
        الاسم_م = الاسم_ل
        الأمر_م = الأمر_ل
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف أمر_مُحلّل_م - نتيجة تحليل سطر الأمر
# ─────────────────────────────────────────────────────────────────────────────
صنف أمر_مُحلّل_م
    ## أمر مُحلَّل مع وسائطه

    نص الأمر_م                 # اسم الأمر
    مصفوفة الوسائط             # قائمة الوسائط
    نص إعادة_توجيه_خرج         # اسم ملف الخرج (> file)
    نص إعادة_توجيه_دخل         # اسم ملف الدخل (< file)
    منطقي إلحاق               # >> بدل >

    باني(نص الأمر_ل)
        الأمر_م = الأمر_ل
        الوسائط = []
        إعادة_توجيه_خرج = ""
        إعادة_توجيه_دخل = ""
        إلحاق = خطأ
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف الصدفة_م - Shell الرئيسي
# ─────────────────────────────────────────────────────────────────────────────
صنف الصدفة_م
    ## صدفة الأوامر الرئيسية

    مصفوفة التاريخ             # أوامر سابقة
    مصفوفة الأسماء_المستعارة   # aliases
    رقم عدد_أوامر_منفذة

    باني()
        التاريخ = []
        الأسماء_المستعارة = []
        عدد_أوامر_منفذة = 0

        # أسماء مستعارة افتراضية
        متغير ll = جديد اسم_مستعار_م("ll"، "ls -l")
        الأسماء_المستعارة += [ll]
        متغير la = جديد اسم_مستعار_م("la"، "ls -a")
        الأسماء_المستعارة += [la]
    نهاية

    ## إضافة اسم مستعار
    دالة أضف_مستعار(نص الاسم_ل، نص الأمر_ل)
        # تحديث إن وجد
        متغير ف = 0
        بينما (ف < طول(الأسماء_المستعارة))
            اذا (الأسماء_المستعارة[ف].الاسم_م == الاسم_ل)
                الأسماء_المستعارة[ف].الأمر_م = الأمر_ل
                ارجع 0
            نهاية
            ف = ف + 1
        نهاية
        متغير مستعار = جديد اسم_مستعار_م(الاسم_ل، الأمر_ل)
        الأسماء_المستعارة += [مستعار]
        ارجع 0
    نهاية

    ## البحث عن اسم مستعار
    دالة نص جد_مستعار(نص الاسم_ل)
        متغير ف = 0
        بينما (ف < طول(الأسماء_المستعارة))
            اذا (الأسماء_المستعارة[ف].الاسم_م == الاسم_ل)
                ارجع الأسماء_المستعارة[ف].الأمر_م
            نهاية
            ف = ف + 1
        نهاية
        ارجع ""
    نهاية

    ## تحليل سطر أمر بسيط
    ## يقسّم على المسافات ويعالج إعادة التوجيه
    دالة تحليل_أمر(نص السطر_ل)
        متغير أمر = جديد أمر_مُحلّل_م("")
        متغير كلمات = []
        متغير كلمة_حالية = ""

        # تقسيم بسيط على المسافات
        متغير ف = 0
        بينما (ف < طول(السطر_ل))
            متغير حرف = السطر_ل[ف]
            اذا (حرف == " ")
                اذا (كلمة_حالية != "")
                    كلمات += [كلمة_حالية]
                    كلمة_حالية = ""
                نهاية
            والا
                كلمة_حالية = كلمة_حالية + حرف
            نهاية
            ف = ف + 1
        نهاية
        اذا (كلمة_حالية != "") كلمات += [كلمة_حالية] نهاية

        # معالجة الكلمات
        اذا (طول(كلمات) == 0) ارجع أمر نهاية

        أمر.الأمر_م = كلمات[0]
        ف = 1
        بينما (ف < طول(كلمات))
            اذا (كلمات[ف] == ">" && ف + 1 < طول(كلمات))
                أمر.إعادة_توجيه_خرج = كلمات[ف + 1]
                ف = ف + 2
                تابع
            نهاية
            اذا (كلمات[ف] == ">>" && ف + 1 < طول(كلمات))
                أمر.إعادة_توجيه_خرج = كلمات[ف + 1]
                أمر.إلحاق = صحيح
                ف = ف + 2
                تابع
            نهاية
            اذا (كلمات[ف] == "<" && ف + 1 < طول(كلمات))
                أمر.إعادة_توجيه_دخل = كلمات[ف + 1]
                ف = ف + 2
                تابع
            نهاية
            أمر.الوسائط += [كلمات[ف]]
            ف = ف + 1
        نهاية

        ارجع أمر
    نهاية

    ## تنفيذ أمر مدمج (built-in)
    دالة نص نفّذ_أمر(نص اسم_الأمر، مصفوفة الوسائط_ل)
        عدد_أوامر_منفذة = عدد_أوامر_منفذة + 1

        # echo
        اذا (اسم_الأمر == "echo")
            متغير نتيجة = ""
            متغير ف = 0
            بينما (ف < طول(الوسائط_ل))
                اذا (ف > 0) نتيجة = نتيجة + " " نهاية
                نتيجة = نتيجة + الوسائط_ل[ف]
                ف = ف + 1
            نهاية
            ارجع نتيجة
        نهاية

        # whoami
        اذا (اسم_الأمر == "whoami") ارجع "root" نهاية

        # hostname
        اذا (اسم_الأمر == "hostname") ارجع "beeos" نهاية

        # date
        اذا (اسم_الأمر == "date") ارجع "2025-01-01 00:00:00" نهاية

        # uname
        اذا (اسم_الأمر == "uname")
            اذا (طول(الوسائط_ل) > 0 && الوسائط_ل[0] == "-a")
                ارجع "BeeOS 1.0 bee-kernel aarch64"
            نهاية
            ارجع "BeeOS"
        نهاية

        # clear
        اذا (اسم_الأمر == "clear") ارجع "[CLEAR]" نهاية

        # help
        اذا (اسم_الأمر == "help")
            ارجع "أوامر متاحة: echo, whoami, hostname, date, uname, clear, help, history, alias, exit"
        نهاية

        # exit
        اذا (اسم_الأمر == "exit") ارجع "[EXIT]" نهاية

        # أمر غير معروف
        ارجع "خطأ: أمر غير معروف '" + اسم_الأمر + "'"
    نهاية

    ## إضافة للتاريخ
    دالة أضف_للتاريخ(نص السطر_ل)
        التاريخ += [السطر_ل]
        اذا (طول(التاريخ) > أقصى_تاريخ)
            # أزل الأقدم
            متغير قائمة = []
            متغير ف = 1
            بينما (ف < طول(التاريخ))
                قائمة += [التاريخ[ف]]
                ف = ف + 1
            نهاية
            التاريخ = قائمة
        نهاية
    نهاية

    ## طباعة التاريخ
    دالة نص اطبع_التاريخ()
        متغير نتيجة = ""
        متغير ف = 0
        بينما (ف < طول(التاريخ))
