# ══════════════════════════════════════════════════════════════════════════════
#                           الثوابت
# ══════════════════════════════════════════════════════════════════════════════

ثابت ذا_حجم_صفحة = 4096
ثابت ذا_إدخالات_جدول = 512

# أنواع VMA
ثابت VMA_مجهول = 0
ثابت VMA_كود = 1
ثابت VMA_بيانات = 2
ثابت VMA_مكدس = 3
ثابت VMA_كومة = 4
ثابت VMA_مشترك = 5
ثابت VMA_ملف = 6
ثابت VMA_حارس = 7

# أذونات VMA
ثابت إذن_قراءة = 1
ثابت إذن_كتابة = 2
ثابت إذن_تنفيذ = 4
ثابت إذن_مستخدم = 8
ثابت إذن_COW = 16          # نسخ عند الكتابة

# حالة الصفحة الافتراضية
ثابت صفحة_غير_موجودة = 0
ثابت صفحة_محمّلة = 1
ثابت صفحة_مبدّلة = 2        # في Swap
ثابت صفحة_COW = 3           # نسخ عند الكتابة
ثابت صفحة_معيّنة_ملف = 4    # mmap

# حالة Swap
ثابت أقصى_صفحات_مبدّلة = 1024


# ══════════════════════════════════════════════════════════════════════════════
#            صنف إدخال صفحة افتراضية
# ══════════════════════════════════════════════════════════════════════════════

صنف إدخال_صفحة_اف
    ## يمثل معلومات صفحة افتراضية واحدة

    رقم العنوان_الافتراضي
    رقم العنوان_الفعلي       # -1 إذا غير محمّلة
    رقم الوضع_الحالي          # صفحة_غير_موجودة / محمّلة / مبدّلة / COW
    رقم الأذونات
    رقم عدد_المشاركات        # عدد العمليات المشتركة
    رقم فهرس_المبادلة        # موقعها في Swap (-1 = لا)
    منطقي متسخة_م            # هل تم التعديل عليها؟
    منطقي مقفلة_م            # لا يمكن إخراجها للمبادلة

    باني(رقم عنوان_اف)
        العنوان_الافتراضي = عنوان_اف
        العنوان_الفعلي = -1
        الوضع_الحالي = صفحة_غير_موجودة
        الأذونات = إذن_قراءة
        عدد_المشاركات = 0
        فهرس_المبادلة = -1
        متسخة_م = خطأ
        مقفلة_م = خطأ
    نهاية

    # هل محمّلة في الذاكرة؟
    دالة منطقي محمّلة()
        ارجع الوضع_الحالي == صفحة_محمّلة
    نهاية

    # هل مشتركة (COW)؟
    دالة منطقي مشتركة()
        ارجع الوضع_الحالي == صفحة_COW || عدد_المشاركات > 1
    نهاية

    # هل يمكن الكتابة عليها؟
    دالة منطقي قابلة_كتابة()
        متغير فحص = الأذونات - ((الأذونات / 2) * 2)
        متغير بت_كتابة = (الأذونات / 2) - ((الأذونات / 4) * 2)
        ارجع بت_كتابة == 1
    نهاية

    # تعيين كـ COW
    دالة عيّن_COW()
        الوضع_الحالي = صفحة_COW
        الأذونات = إذن_قراءة + إذن_COW     # قراءة فقط + علامة COW
        عدد_المشاركات = عدد_المشاركات + 1
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#            صنف منطقة الذاكرة الافتراضية VMA
# ══════════════════════════════════════════════════════════════════════════════

صنف منطقة_VMA
    ## تمثل منطقة متجاورة من الذاكرة الافتراضية

    رقم عنوان_أول_م          # بداية المنطقة
    رقم عنوان_آخر_م          # نهاية المنطقة
    رقم النمط_م               # نوع VMA
    رقم الأذونات_م
    مصفوفة الصفحات           # إدخالات الصفحات
    نص الاسم_م                # اسم وصفي
    رقم ملف_معيّن            # معرّف الملف (-1 = لا)
    رقم إزاحة_الملف          # إزاحة في الملف

    باني(رقم عنوان_أول، رقم عنوان_آخر، رقم أذونات)
        عنوان_أول_م = عنوان_أول
        عنوان_آخر_م = عنوان_آخر
        النمط_م = VMA_مجهول
        الأذونات_م = أذونات
        الصفحات = []
        الاسم_م = "مجهول"
        ملف_معيّن = -1
        إزاحة_الملف = 0

        # تهيئة مصفوفة الصفحات
        متغير عدد_ص = (عنوان_آخر - عنوان_أول) / ذا_حجم_صفحة
        متغير ف = 0
        بينما (ف < عدد_ص)
            الصفحات += [جديد إدخال_صفحة_اف(عنوان_أول + ف * ذا_حجم_صفحة)]
            ف = ف + 1
        نهاية
    نهاية

    # عدد الصفحات
    دالة رقم عدد_ص()
        ارجع طول(الصفحات)
    نهاية

    # هل العنوان داخل المنطقة؟
    دالة منطقي يحتوي(رقم العنوان)
        ارجع العنوان >= عنوان_أول_م && العنوان < عنوان_آخر_م
    نهاية

    # الحصول على صفحة بالعنوان
    دالة رقم فهرس_صفحة(رقم العنوان)
        اذا (يحتوي(العنوان) == خطأ)
            ارجع -1
        نهاية
        ارجع (العنوان - عنوان_أول_م) / ذا_حجم_صفحة
    نهاية

    # طباعة
    دالة اطبع_VMA()
        اطبع("  VMA [")
        اطبع(الاسم_م)
        اطبع("] ")
        اطبع(عنوان_أول_م)
        اطبع("-")
        اطبع(عنوان_آخر_م)
        اطبع(" أذونات=")
        اطبع(الأذونات_م)
        اطبع(" صفحات=")
        اطبع_سطر(عدد_ص())
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#            صنف مدير المبادلة (Swap Manager)
# ══════════════════════════════════════════════════════════════════════════════

صنف مدير_المبادلة
    ## يدير منطقة المبادلة (Swap Space)

    مصفوفة الفتحات           # كل فتحة تخزن بيانات صفحة
    مصفوفة الحالات            # 0=حرة, 1=مشغولة
    رقم إجمالي_الفتحات
    رقم فتحات_مشغولة_م
    رقم عمليات_كتابة_م
    رقم عمليات_قراءة_م

    باني()
        الفتحات = []
        الحالات = []
        إجمالي_الفتحات = أقصى_صفحات_مبدّلة
        فتحات_مشغولة_م = 0
        عمليات_كتابة_م = 0
        عمليات_قراءة_م = 0

        # تهيئة
        متغير ف = 0
        بينما (ف < إجمالي_الفتحات)
            الفتحات += [0]       # بيانات فارغة
            الحالات += [0]       # حرة
            ف = ف + 1
        نهاية
    نهاية

    # كتابة صفحة في Swap
    دالة رقم اكتب(رقم بيانات_الصفحة)
        # إيجاد فتحة حرة
        متغير ف = 0
        بينما (ف < إجمالي_الفتحات)
            اذا (الحالات[ف] == 0)
                الفتحات[ف] = بيانات_الصفحة
                الحالات[ف] = 1
                فتحات_مشغولة_م = فتحات_مشغولة_م + 1
                عمليات_كتابة_م = عمليات_كتابة_م + 1
                ارجع ف      # إرجاع فهرس الفتحة
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1     # Swap ممتلئ
    نهاية

    # قراءة صفحة من Swap
    دالة رقم اقرأ(رقم فهرس)
        اذا (فهرس < 0 || فهرس >= إجمالي_الفتحات)
            ارجع -1
        نهاية
        اذا (الحالات[فهرس] == 0)
            ارجع -1     # فتحة فارغة
        نهاية
        عمليات_قراءة_م = عمليات_قراءة_م + 1
        ارجع الفتحات[فهرس]
    نهاية

    # تحرير فتحة
    دالة حرّر(رقم فهرس)
        اذا (فهرس < 0 || فهرس >= إجمالي_الفتحات)
            ارجع 0
        نهاية
        اذا (الحالات[فهرس] == 1)
            الفتحات[فهرس] = 0
            الحالات[فهرس] = 0
            فتحات_مشغولة_م = فتحات_مشغولة_م - 1
        نهاية
    نهاية

    # نسبة الامتلاء
    دالة رقم نسبة_الامتلاء()
        اذا (إجمالي_الفتحات == 0)
            ارجع 100
        نهاية
        ارجع (فتحات_مشغولة_م * 100) / إجمالي_الفتحات
    نهاية

    # إحصاءات
    دالة اطبع_إحصاءات()
        اطبع_سطر("── Swap ──")
        اطبع("  إجمالي: ")
        اطبع_سطر(إجمالي_الفتحات)
        اطبع("  مشغولة: ")
        اطبع_سطر(فتحات_مشغولة_م)
        اطبع("  كتابات: ")
        اطبع_سطر(عمليات_كتابة_م)
        اطبع("  قراءات: ")
        اطبع_سطر(عمليات_قراءة_م)
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#            صنف مدير TLB
# ══════════════════════════════════════════════════════════════════════════════

صنف مدير_TLB
    ## محاكاة Translation Lookaside Buffer

    مصفوفة العناوين_الافتراضية
    مصفوفة العناوين_الفعلية
    رقم سعة_TLB
    رقم إصابات_م
    رقم أخطاء_م
    رقم عمليات_طرد_م

    باني(رقم السعة)
        العناوين_الافتراضية = []
        العناوين_الفعلية = []
        سعة_TLB = السعة
        إصابات_م = 0
        أخطاء_م = 0
        عمليات_طرد_م = 0
    نهاية

    # بحث في TLB
    دالة رقم ابحث(رقم عنوان_افتراضي)
        متغير ف = 0
        بينما (ف < طول(العناوين_الافتراضية))
            اذا (العناوين_الافتراضية[ف] == عنوان_افتراضي)
                إصابات_م = إصابات_م + 1
                ارجع العناوين_الفعلية[ف]
            نهاية
            ف = ف + 1
        نهاية
        أخطاء_م = أخطاء_م + 1
        ارجع -1
    نهاية

    # إضافة ترجمة
    دالة أضف(رقم عنوان_افتراضي، رقم عنوان_فعلي)
        # التحقق من التكرار
        متغير ف = 0
        بينما (ف < طول(العناوين_الافتراضية))
            اذا (العناوين_الافتراضية[ف] == عنوان_افتراضي)
                العناوين_الفعلية[ف] = عنوان_فعلي
                ارجع 0
            نهاية
            ف = ف + 1
        نهاية

        # إذا TLB ممتلئ، أزل الأقدم FIFO
        اذا (طول(العناوين_الافتراضية) >= سعة_TLB)
            # حذف أول إدخال (FIFO بسيط)
            متغير اف_جديدة = []
            متغير ف_جديدة = []
            متغير ت = 1
            بينما (ت < طول(العناوين_الافتراضية))
                اف_جديدة += [العناوين_الافتراضية[ت]]
                ف_جديدة += [العناوين_الفعلية[ت]]
                ت = ت + 1
            نهاية
            العناوين_الافتراضية = اف_جديدة
            العناوين_الفعلية = ف_جديدة
            عمليات_طرد_م = عمليات_طرد_م + 1
        نهاية

        العناوين_الافتراضية += [عنوان_افتراضي]
        العناوين_الفعلية += [عنوان_فعلي]
    نهاية

    # طرد عنوان
    دالة اطرد(رقم عنوان_افتراضي)
        متغير اف_جديدة = []
        متغير ف_جديدة = []
        متغير ف = 0
        بينما (ف < طول(العناوين_الافتراضية))
            اذا (العناوين_الافتراضية[ف] != عنوان_افتراضي)
                اف_جديدة += [العناوين_الافتراضية[ف]]
                ف_جديدة += [العناوين_الفعلية[ف]]
            نهاية
            ف = ف + 1
        نهاية
        العناوين_الافتراضية = اف_جديدة
        العناوين_الفعلية = ف_جديدة
        عمليات_طرد_م = عمليات_طرد_م + 1
    نهاية

    # طرد الكل
    دالة اطرد_الكل()
        العناوين_الافتراضية = []
        العناوين_الفعلية = []
        عمليات_طرد_م = عمليات_طرد_م + 1
    نهاية

    # نسبة الإصابة
    دالة رقم نسبة_الإصابة()
        متغير إجمالي = إصابات_م + أخطاء_م
        اذا (إجمالي == 0)
            ارجع 0
        نهاية
        ارجع (إصابات_م * 100) / إجمالي
    نهاية

    # طباعة
    دالة اطبع_إحصاءات()
        اطبع_سطر("── TLB ──")
        اطبع("  إصابات: ")
        اطبع_سطر(إصابات_م)
        اطبع("  أخطاء: ")
        اطبع_سطر(أخطاء_م)
        اطبع("  طرد: ")
        اطبع_سطر(عمليات_طرد_م)
        اطبع("  نسبة الإصابة: ")
        اطبع(نسبة_الإصابة())
        اطبع_سطر("%")
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#            صنف مُعالج COW (Copy-on-Write)
# ══════════════════════════════════════════════════════════════════════════════

صنف معالج_COW
    ## يدير عمليات النسخ عند الكتابة

    رقم عمليات_نسخ_م
    رقم صفحات_محمية_م
    رقم توفير_ذاكرة_م        # الصفحات التي لم تُنسخ بعد

    باني()
        عمليات_نسخ_م = 0
        صفحات_محمية_م = 0
        توفير_ذاكرة_م = 0
    نهاية

    # تحضير صفحة لـ COW (عند fork)
    دالة رقم حماية_للCOW(رقم عنوان_فعلي)
        صفحات_محمية_م = صفحات_محمية_م + 1
        توفير_ذاكرة_م = توفير_ذاكرة_م + 1
        ارجع عنوان_فعلي
    نهاية

    # معالجة كتابة على صفحة COW
    دالة رقم عالج_كتابة(رقم عنوان_فعلي_أصلي، رقم عدد_مشاركات)
        اذا (عدد_مشاركات <= 1)
            # آخر مشارك — ألغِ الحماية فقط
            ارجع عنوان_فعلي_أصلي
        نهاية

        # أنشئ نسخة
        متغير عنوان_جديد = عنوان_فعلي_أصلي + (عمليات_نسخ_م + 1) * ذا_حجم_صفحة
        عمليات_نسخ_م = عمليات_نسخ_م + 1
        توفير_ذاكرة_م = توفير_ذاكرة_م - 1
        ارجع عنوان_جديد
    نهاية

    # إحصاءات
    دالة اطبع_إحصاءات()
        اطبع_سطر("── COW ──")
        اطبع("  نسخ فعلية: ")
        اطبع_سطر(عمليات_نسخ_م)
        اطبع("  صفحات محمية: ")
        اطبع_سطر(صفحات_محمية_م)
        اطبع("  توفير الذاكرة: ")
        اطبع(توفير_ذاكرة_م)
        اطبع_سطر(" صفحة")
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#            صنف مدير المناطق الافتراضية
# ══════════════════════════════════════════════════════════════════════════════

صنف مدير_المناطق
    ## يدير قائمة مناطق VMA لفضاء عناوين

    مصفوفة المناطق_م
    رقم عدد_المناطق_م

    باني()
        المناطق_م = []
        عدد_المناطق_م = 0
    نهاية

    # إضافة منطقة جديدة
    دالة أضف(رقم عنوان_أول، رقم عنوان_آخر، رقم أذونات، نص اسم، رقم نمط)
        # فحص التداخل
        متغير ف = 0
        بينما (ف < طول(المناطق_م))
            متغير م = المناطق_م[ف]
            اذا (عنوان_أول < م.عنوان_آخر_م && عنوان_آخر > م.عنوان_أول_م)
                اطبع_سطر("  ⚠ تداخل مع منطقة موجودة!")
                ارجع -1
            نهاية
            ف = ف + 1
        نهاية

        متغير منطقه = جديد منطقة_VMA(عنوان_أول، عنوان_آخر، أذونات)
        منطقه.الاسم_م = اسم
        منطقه.النمط_م = نمط
        المناطق_م += [منطقه]
        عدد_المناطق_م = عدد_المناطق_م + 1
        ارجع عدد_المناطق_م - 1
    نهاية

    # البحث عن منطقة تحتوي عنوان
    دالة رقم ابحث(رقم العنوان)
        متغير ف = 0
        بينما (ف < طول(المناطق_م))
            اذا (المناطق_م[ف].يحتوي(العنوان))
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    # طباعة جميع المناطق
    دالة اطبع_الكل()
        اطبع_سطر("── مناطق VMA ──")
        متغير ف = 0
        بينما (ف < طول(المناطق_م))
            المناطق_م[ف].اطبع_VMA()
            ف = ف + 1
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#            المتغيرات العالمية
# ══════════════════════════════════════════════════════════════════════════════

متغير ع_مبادلة = جديد مدير_المبادلة()
متغير ع_TLB = جديد مدير_TLB(64)
متغير ع_COW = جديد معالج_COW()
متغير ع_مناطق = جديد مدير_المناطق()


# ══════════════════════════════════════════════════════════════════════════════
#            صنف مدير الذاكرة الافتراضية المُقوّى
# ══════════════════════════════════════════════════════════════════════════════

صنف مدير_VMM_المُقوّى
    ## المدير الرئيسي المُقوّى

    رقم عنوان_PML4_النواة
    رقم صفحات_مُعيّنة_م
    رقم أخطاء_صفحات_م
    رقم عمليات_ترحيل_م
    منطقي مُهيّأ_م

    باني()
        عنوان_PML4_النواة = 0
        صفحات_مُعيّنة_م = 0
        أخطاء_صفحات_م = 0
        عمليات_ترحيل_م = 0
        مُهيّأ_م = خطأ
    نهاية

    # التهيئة
    دالة تهيئة(رقم عنوان_PML4)
        اطبع_سطر("🐝 VMM المُقوّى: بدء التهيئة")
        عنوان_PML4_النواة = عنوان_PML4
        مُهيّأ_م = صحيح
        اطبع_سطر("🐝 VMM المُقوّى: جاهز")
    نهاية

    # تعيين صفحة مع TLB
    دالة رقم عيّن_صفحة(رقم عنوان_افتراضي، رقم عنوان_فعلي، رقم أعلام)
        اذا (مُهيّأ_م != صحيح)
            ارجع -1
        نهاية

        # أضف التعيين في TLB
        ع_TLB.أضف(عنوان_افتراضي، عنوان_فعلي)
        صفحات_مُعيّنة_م = صفحات_مُعيّنة_م + 1
        عمليات_ترحيل_م = عمليات_ترحيل_م + 1
        ارجع 1
    نهاية

    # ترجمة عنوان (مع TLB)
    دالة رقم ترجم(رقم عنوان_افتراضي)
        # بحث في TLB أولاً
        متغير نتيجة = ع_TLB.ابحث(عنوان_افتراضي)
        ارجع نتيجة
    نهاية

    # معالجة خطأ الصفحة
    دالة رقم عالج_خطأ_صفحة(رقم العنوان، رقم رمز_الخطأ)
        أخطاء_صفحات_م = أخطاء_صفحات_م + 1

        # فحص هل العنوان في منطقة VMA
        متغير فهرس_م = ع_مناطق.ابحث(العنوان)
        اذا (فهرس_م < 0)
            اطبع("  ✗ خطأ صفحة: عنوان غير صالح ")
            اطبع_سطر(العنوان)
            ارجع -1
        نهاية

        # التحقق من أنه خطأ كتابة على COW
        متغير كانت_كتابة = (رمز_الخطأ / 2) - ((رمز_الخطأ / 4) * 2)
        اذا (كانت_كتابة == 1)
            # كتابة على صفحة COW — أنشئ نسخة
            متغير عنوان_جديد = ع_COW.عالج_كتابة(العنوان، 2)
            عيّن_صفحة(العنوان، عنوان_جديد، إذن_قراءة + إذن_كتابة)
            ارجع 1
        نهاية

        # الترحيل حسب الطلب (Demand Paging)
        # فحص Swap
        متغير بيانات = ع_مبادلة.اقرأ(العنوان)
        اذا (بيانات >= 0)
            عيّن_صفحة(العنوان، بيانات، إذن_قراءة + إذن_كتابة)
            ارجع 2     # تم تحميل من Swap
        نهاية

        # صفحة جديدة (allocate on demand)
        عيّن_صفحة(العنوان، العنوان + 1048576، إذن_قراءة + إذن_كتابة)
        ارجع 3     # صفحة جديدة
    نهاية

    # mmap — تعيين ملف على الذاكرة
    دالة رقم عيّن_ملف(رقم عنوان_اف، رقم طول_ملف، رقم معرّف_ملف، رقم أذونات)
        # إنشاء منطقة VMA جديدة
        متغير عنوان_نهاية_م = عنوان_اف + طول_ملف
        متغير فهرس = ع_مناطق.أضف(عنوان_اف، عنوان_نهاية_م، أذونات، "ملف", VMA_ملف)
        اذا (فهرس < 0)
            ارجع -1
        نهاية

        # تعيين الصفحات (lazy — لا نحمّل الآن)
        اطبع("  mmap: ملف ")
        اطبع(معرّف_ملف)
        اطبع(" على ")
        اطبع_سطر(عنوان_اف)
        ارجع عنوان_اف
    نهاية

    # إخراج صفحة للمبادلة
    دالة رقم بدّل_صفحة(رقم عنوان_افتراضي)
        # اكتب في Swap
        متغير فهرس = ع_مبادلة.اكتب(عنوان_افتراضي)
        اذا (فهرس < 0)
            اطبع_سطر("  ✗ Swap ممتلئ!")
            ارجع -1
        نهاية

        # أزل من TLB
        ع_TLB.اطرد(عنوان_افتراضي)
        صفحات_مُعيّنة_م = صفحات_مُعيّنة_م - 1
        ارجع فهرس
    نهاية

    # طباعة حالة شاملة
    دالة اطبع_حالة()
        اطبع_سطر("══ حالة VMM المُقوّاة ══")
        اطبع("  PML4: ")
        اطبع_سطر(عنوان_PML4_النواة)
        اطبع("  صفحات مُعيّنة: ")
        اطبع_سطر(صفحات_مُعيّنة_م)
        اطبع("  أخطاء صفحات: ")
        اطبع_سطر(أخطاء_صفحات_م)
        اطبع("  عمليات ترحيل: ")
        اطبع_سطر(عمليات_ترحيل_م)
        ع_TLB.اطبع_إحصاءات()
        ع_مبادلة.اطبع_إحصاءات()
        ع_COW.اطبع_إحصاءات()
        ع_مناطق.اطبع_الكل()
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                          الاختبارات
# ══════════════════════════════════════════════════════════════════════════════

دالة رقم اختبار_TLB()
    اطبع_سطر("── اختبار TLB ──")
    متغير نجاح = 0
    متغير فشل_ع = 0

    متغير ت = جديد مدير_TLB(4)

    # إضافة ترجمات
    ت.أضف(4096، 1048576)
    ت.أضف(8192، 2097152)

    # بحث ناجح
    متغير ن1 = ت.ابحث(4096)
    اذا (ن1 == 1048576)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ بحث TLB ناجح")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل بحث TLB")
    نهاية

    # بحث فاشل
    متغير ن2 = ت.ابحث(12288)
    اذا (ن2 == -1)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ عنوان غير موجود = -1")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ يجب أن يكون -1")
    نهاية

    # طرد
    ت.اطرد(4096)
    متغير ن3 = ت.ابحث(4096)
    اذا (ن3 == -1)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ طرد ناجح")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل الطرد")
    نهاية

    # FIFO عند الامتلاء
    ت.أضف(1000، 100)
    ت.أضف(2000، 200)
    ت.أضف(3000، 300)
    ت.أضف(4000، 400)
    ت.أضف(5000، 500)   # يجب أن يطرد الأقدم

    متغير ن4 = ت.ابحث(5000)
    اذا (ن4 == 500)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ FIFO يعمل")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل FIFO")
    نهاية

    اطبع("  نجاح=")
    اطبع(نجاح)
    اطبع(" فشل=")
    اطبع_سطر(فشل_ع)
    ارجع فشل_ع
نهاية

دالة رقم اختبار_Swap()
    اطبع_سطر("── اختبار Swap ──")
    متغير نجاح = 0
    متغير فشل_ع = 0

    متغير مب = جديد مدير_المبادلة()

    # كتابة
    متغير ف1 = مب.اكتب(12345)
    اذا (ف1 >= 0)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ كتابة Swap")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل كتابة Swap")
    نهاية

    # قراءة
    متغير بيانات = مب.اقرأ(ف1)
    اذا (بيانات == 12345)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ قراءة Swap")
    والا
        فشل_ع = فشل_ع + 1
        اطبع("  ✗ بيانات = ")
        اطبع_سطر(بيانات)
    نهاية

    # تحرير
    مب.حرّر(ف1)
    متغير بيانات2 = مب.اقرأ(ف1)
    اذا (بيانات2 == -1)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ تحرير Swap")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فتحة لم تُحرر")
    نهاية

    اطبع("  نجاح=")
    اطبع(نجاح)
    اطبع(" فشل=")
    اطبع_سطر(فشل_ع)
    ارجع فشل_ع
نهاية

دالة رقم اختبار_COW()
    اطبع_سطر("── اختبار COW ──")
    متغير نجاح = 0
    متغير فشل_ع = 0

    متغير كاو = جديد معالج_COW()

    # حماية صفحة
    كاو.حماية_للCOW(4096)
    اذا (كاو.صفحات_محمية_م == 1)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ حماية COW")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل الحماية")
    نهاية

    # كتابة (مع مشاركة)
    متغير عنوان_جديد = كاو.عالج_كتابة(4096، 2)
    اذا (عنوان_جديد != 4096)
        نجاح = نجاح + 1
        اطبع("  ✓ نسخة جديدة عند ")
        اطبع_سطر(عنوان_جديد)
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ لم تُنشأ نسخة")
    نهاية

    # كتابة (آخر مشارك)
    متغير عنوان2 = كاو.عالج_كتابة(8192، 1)
    اذا (عنوان2 == 8192)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ آخر مشارك = نفس العنوان")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ يجب أن يكون نفس العنوان")
    نهاية

    اطبع("  نجاح=")
    اطبع(نجاح)
    اطبع(" فشل=")
    اطبع_سطر(فشل_ع)
    ارجع فشل_ع
نهاية

دالة رقم اختبار_VMM_المُقوّى()
    اطبع_سطر("── اختبار VMM المُقوّى ──")
    متغير نجاح = 0
    متغير فشل_ع = 0

    متغير مدير = جديد مدير_VMM_المُقوّى()
    مدير.تهيئة(1048576)

    # إنشاء منطقة VMA
    متغير فهرس_م = ع_مناطق.أضف(4096, 20480, إذن_قراءة + إذن_كتابة, "كود", VMA_كود)
    اذا (فهرس_م >= 0)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ إنشاء VMA")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل VMA")
    نهاية

    # تعيين صفحة
    مدير.عيّن_صفحة(4096, 1048576, إذن_قراءة + إذن_كتابة)

    # ترجمة
    متغير ن = مدير.ترجم(4096)
    اذا (ن == 1048576)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ ترجمة العنوان")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل الترجمة")
    نهاية

    # خطأ صفحة (عنوان صالح)
    متغير ن2 = مدير.عالج_خطأ_صفحة(8192, 0)
    اذا (ن2 >= 0)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ معالجة خطأ الصفحة")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل معالجة الخطأ")
    نهاية

    # مبادلة صفحة
    متغير SW = مدير.بدّل_صفحة(4096)
    اذا (SW >= 0)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ مبادلة صفحة")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل المبادلة")
    نهاية

    # mmap
    متغير عن_ملف = مدير.عيّن_ملف(32768, 8192, 1, إذن_قراءة)
    اذا (عن_ملف >= 0)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ mmap")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل mmap")
    نهاية

    مدير.اطبع_حالة()

    اطبع("  نجاح=")
    اطبع(نجاح)
    اطبع(" فشل=")
    اطبع_سطر(فشل_ع)
    ارجع فشل_ع
نهاية


