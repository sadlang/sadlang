# ══════════════════════════════════════════════════════════════════════════════
# مدير_الذاكرة_الفعلية.ص - إدارة الذاكرة الفعلية لنظام خلية النحل
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# هذا الملف يُنفّذ مدير الذاكرة الفعلية (PMM - Physical Memory Manager)
# باستخدام خوارزمية المصاحب (Buddy Allocator) السداسية المُحسَّنة،
# وهو أساس بناء كل نظام تشغيل حديث.
#
# خوارزمية المصاحب توفر:
# ✅ تخصيص ذاكرة بحجم O(log n) - سريع جداً
# ✅ إلغاء تخصيص بحجم O(log n) - سريع جداً
# ✅ تجزأة داخلية منخفضة - لا يُضيّع الذاكرة
# ✅ دمج الكتل المجاورة تلقائياً - يعيد الذاكرة المتجاورة
#
# مراحل التهيئة:
# ━━━━━━━━━━━━━
# 1. استقبال خريطة الذاكرة من بروتوكول Limine
# 2. تحديد المناطق المتاحة (فوق 1 ميغابايت)
# 3. بناء جداول الصفحات للذاكرة الفعلية
# 4. تهيئة bitmaps للكتل الحرة
#
# الطبقات:
# ━━━━━━━
# طبقة 0: صفحات 4 كيلوبايت (أصغر وحدة)
# طبقة 1: 8 كيلوبايت (2 صفحة)
# طبقة 2: 16 كيلوبايت (4 صفحات)
# ...
# طبقة 10: 4 ميغابايت (1024 صفحة)
#
# متطلبات:
# ━━━━━━━━
# - معمارية x86_64 بوضع 64 بت
# - بروتوكول إقلاع Limine يوفر خريطة الذاكرة
# - الذاكرة فوق 1 ميغابايت متاحة
#
# المؤلف: فريق نظام خلية النحل - BeeOS Development Team
# الإصدار: 1.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت النظام الحرجة
# ─────────────────────────────────────────────────────────────────────────────

# حجم الصفحة الأساسية (4 كيلوبايت = 4096 بايت)
# هذا هو الحجم الأدنى للتخصيص في نظام x86_64
ثابت حجم_الصفحة = 4096

# حجم الصفحة بالبتات للإزاحة السريعة
ثابت بتات_الصفحة = 12

# عدد طبقات المصاحب (من 4KB إلى 4MB)
ثابت أقصى_طبقة = 11

# أقصى عدد صفحات (وهمي - سيُحدَّد من خريطة الذاكرة)
ثابت أقصى_صفحات = 1048576

# حد الذاكرة المحجوزة للنواة (16 ميغابايت)
ثابت حجز_النواة = 16777216

# بداية الذاكرة المتاحة (فوق المنطقة المحجوزة)
ثابت بداية_الذاكرة_الحرة = 16777216

# الرقم السحري للتحقق من سلامة الكتل
ثابت رقم_الكتلة_السحري = 1145523782  # 0x44455600 في ترميز ص

# ─────────────────────────────────────────────────────────────────────────────
# أنواع إدخالات خريطة الذاكرة (من بروتوكول Limine)
# ─────────────────────────────────────────────────────────────────────────────
ثابت نوع_ذاكرة_متاحة = 1         # ذاكرة متاحة للنظام
ثابت نوع_ذاكرة_محجوزة = 2        # محجوزة للعتاد / BIOS
ثابت نوع_ذاكرة_ACPI = 3          # جداول ACPI
ثابت نوع_ذاكرة_NVS = 4           # ذاكرة غير متطايرة ACPI
ثابت نوع_ذاكرة_معطوبة = 5        # ذاكرة تالفة - لا تُستخدم
ثابت نوع_ذاكرة_إقلاع_UEFI = 6    # مُستخدمة من UEFI (قابلة للاستعادة)
ثابت نوع_ذاكرة_خدمات_UEFI = 7    # خدمات UEFI وقت التشغيل
ثابت نوع_ذاكرة_نواة = 8          # محجوزة للنواة

# ─────────────────────────────────────────────────────────────────────────────
# صنف إدخال خريطة الذاكرة
# يمثل منطقة واحدة من خريطة الذاكرة التي يوفرها محمّل الإقلاع
# ─────────────────────────────────────────────────────────────────────────────
صنف إدخال_خريطة_الذاكرة
    ## الوصف: يمثّل منطقة ذاكرة واحدة من خريطة الذاكرة الفعلية
    ## يُستخدم لتحديد المناطق المتاحة وغير المتاحة في الذاكرة

    رقم العنوان_الفعلي      # عنوان بداية المنطقة (موضع في الذاكرة الفعلية)
    رقم الحجم              # حجم المنطقة بالبايتات
    رقم النوع              # نوع المنطقة (متاحة، محجوزة، تالفة، إلخ)
    رقم سمات_ACPI          # سمات ACPI الإضافية (إن وجدت)

    باني(رقم عنوان، رقم حجم_منطقة، رقم نوع_منطقة)
        العنوان_الفعلي = عنوان
        الحجم = حجم_منطقة
        النوع = نوع_منطقة
        سمات_ACPI = 0
    نهاية

    ## التحقق من أن المنطقة متاحة للاستخدام
    دالة منطقي متاحة()
        ارجع النوع == نوع_ذاكرة_متاحة
    نهاية

    ## الحصول على عنوان نهاية المنطقة
    دالة رقم نهاية_المنطقة()
        ارجع العنوان_الفعلي + الحجم
    نهاية

    ## حساب عدد الصفحات في هذه المنطقة
    دالة رقم عدد_الصفحات()
        ارجع الحجم / حجم_الصفحة
    نهاية

    ## طباعة معلومات المنطقة (للتشخيص)
    دالة طباعة_معلومات()
        اطبع("  [منطقة: عنوان=")
        اطبع(العنوان_الفعلي)
        اطبع(" حجم=")
        اطبع(الحجم / 1048576)
        اطبع("MB نوع=")
        اذا (النوع == نوع_ذاكرة_متاحة)
            اطبع("متاحة")
        والا_اذا (النوع == نوع_ذاكرة_محجوزة)
            اطبع("محجوزة")
        والا_اذا (النوع == نوع_ذاكرة_ACPI)
            اطبع("ACPI")
        والا_اذا (النوع == نوع_ذاكرة_معطوبة)
            اطبع("معطوبة ⚠")
        والا
            اطبع("مجهولة")
        نهاية
        اطبع_سطر("]")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف كتلة المصاحب
# يمثل كتلة ذاكرة واحدة في شجرة المصاحب
# ─────────────────────────────────────────────────────────────────────────────
صنف كتلة_المصاحب
    ## الوصف: تمثّل كتلة ذاكرة واحدة في نظام المصاحب
    ## تشكّل هذه الكتل شجرة ثنائية تسهّل الدمج والتقسيم

    رقم العنوان_الفعلي     # عنوان بداية الكتلة في الذاكرة الفعلية
    رقم الرتبة             # رتبة الكتلة (0 = 4K, 1 = 8K, ...)
    رقم الحالة             # الحالة (0=حرة, 1=مستخدمة, 2=مقسومة)
    رقم الكتلة_التالية     # فهرس الكتلة التالية في القائمة الحرة
    رقم الكتلة_السابقة     # فهرس الكتلة السابقة في القائمة الحرة
    رقم المستخدم           # معرّف العملية المالكة (للتشخيص)

    باني(رقم عنوان، رقم رتبة_الكتلة)
        العنوان_الفعلي = عنوان
        الرتبة = رتبة_الكتلة
        الحالة = 0      # حرة
        الكتلة_التالية = -1
        الكتلة_السابقة = -1
        المستخدم = 0
    نهاية

    ## حساب حجم الكتلة بالبايتات
    دالة رقم حجم_الكتلة()
        # حجم الكتلة = حجم_الصفحة × 2^الرتبة
        # نُحسب يدوياً بضرب متتالي
        متغير الحجم = حجم_الصفحة
        متغير عداد = 0
        بينما (عداد < الرتبة)
            الحجم = الحجم * 2
            عداد = عداد + 1
        نهاية
        ارجع الحجم
    نهاية

    ## هل الكتلة حرة؟
    دالة منطقي حرة()
        ارجع الحالة == 0
    نهاية

    ## هل الكتلة مستخدمة؟
    دالة منطقي مستخدمة()
        ارجع الحالة == 1
    نهاية

    ## الحصول على عنوان المصاحب (الكتلة التوأم)
    ## المصاحب = الكتلة المجاورة بنفس الحجم التي يمكن دمجها
    دالة رقم عنوان_المصاحب()
        # عنوان_المصاحب = العنوان XOR حجم_الكتلة
        # هذه الصيغة تعطي نفس النتيجة سواء للكتلة الأولى أو الثانية
        متغير الحجم = حجم_الكتلة()
        # محاكاة XOR يدوياً
        متغير النتيجة = العنوان_الفعلي + الحجم
        # التحقق من محاذاة الكتلة الأعلى
        اذا ((العنوان_الفعلي / الحجم) - ((العنوان_الفعلي / (الحجم * 2)) * 2) == 1)
            النتيجة = العنوان_الفعلي - الحجم
        نهاية
        ارجع النتيجة
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف إحصاءات الذاكرة
# يتتبع استخدام الذاكرة في الوقت الحقيقي
# ─────────────────────────────────────────────────────────────────────────────
صنف إحصاءات_الذاكرة
    ## الوصف: يُسجّل ويتتبع إحصاءات استخدام الذاكرة الفعلية

    رقم إجمالي_الذاكرة_بالبايت    # إجمالي الذاكرة المكتشفة
    رقم ذاكرة_متاحة_بالبايت      # الذاكرة المتاحة للنظام
    رقم ذاكرة_مستخدمة_بالبايت    # الذاكرة المستخدمة حالياً
    رقم ذاكرة_النواة_بالبايت     # مستخدمة من النواة
    رقم إجمالي_الصفحات           # إجمالي الصفحات
    رقم صفحات_حرة               # صفحات غير مستخدمة
    رقم صفحات_مستخدمة           # صفحات مستخدمة
    رقم أكبر_كتلة_حرة            # أكبر منطقة حرة متجاورة (صفحات)
    رقم عدد_عمليات_التخصيص      # عدد طلبات التخصيص منذ البدء
    رقم عدد_عمليات_الإلغاء       # عدد عمليات إلغاء التخصيص
    رقم أخطاء_التخصيص           # عدد طلبات التخصيص الفاشلة

    باني()
        إجمالي_الذاكرة_بالبايت = 0
        ذاكرة_متاحة_بالبايت = 0
        ذاكرة_مستخدمة_بالبايت = 0
        ذاكرة_النواة_بالبايت = 0
        إجمالي_الصفحات = 0
        صفحات_حرة = 0
        صفحات_مستخدمة = 0
        أكبر_كتلة_حرة = 0
        عدد_عمليات_التخصيص = 0
        عدد_عمليات_الإلغاء = 0
        أخطاء_التخصيص = 0
    نهاية

    ## نسبة استخدام الذاكرة (0-100%)
    دالة رقم نسبة_الاستخدام()
        اذا (إجمالي_الصفحات == 0)
            ارجع 0
        نهاية
        ارجع (صفحات_مستخدمة * 100) / إجمالي_الصفحات
    نهاية

    ## طباعة ملخص الذاكرة
    دالة طباعة_الملخص()
        اطبع_سطر("═══════════════════════════════════════════")
        اطبع_سطر("  🐝 إحصاءات الذاكرة الفعلية - نظام النحلة")
        اطبع_سطر("═══════════════════════════════════════════")

        اطبع("  الإجمالي:         ")
        اطبع(إجمالي_الذاكرة_بالبايت / 1048576)
        اطبع_سطر(" ميغابايت")

        اطبع("  متاحة للنظام:     ")
        اطبع(ذاكرة_متاحة_بالبايت / 1048576)
        اطبع_سطر(" ميغابايت")

        اطبع("  مستخدمة حالياً:   ")
        اطبع(ذاكرة_مستخدمة_بالبايت / 1048576)
        اطبع_سطر(" ميغابايت")

        اطبع("  صفحات حرة:       ")
        اطبع(صفحات_حرة)
        اطبع_سطر(" صفحة")

        اطبع("  نسبة الاستخدام:   ")
        اطبع(نسبة_الاستخدام())
        اطبع_سطر("%")

        اطبع("  أكبر كتلة حرة:   ")
        اطبع(أكبر_كتلة_حرة)
        اطبع_سطر(" صفحة")

        اطبع_سطر("═══════════════════════════════════════════")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الصنف الرئيسي: مدير الذاكرة الفعلية
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_الذاكرة_الفعلية
    ## الوصف الكامل:
    ## ══════════════
    ## يُطبّق هذا الصنف نظام إدارة الذاكرة الفعلية بخوارزمية المصاحب.
    ## يعمل مباشرة على العتاد بدون نظام تشغيل آخر (bare-metal).
    ##
    ## مبدأ عمل خوارزمية المصاحب:
    ## ══════════════════════════
    ## - الذاكرة مقسمة إلى كتل بأحجام قوى العدد 2
    ## - كل كتلة لها "مصاحب" (buddy) بنفس الحجم مجاورة لها
    ## - عند التخصيص: نجد أصغر كتلة كافية ونقسمها إن كانت أكبر
    ## - عند الإلغاء: ندمج الكتلة مع مصاحبها إن كان حراً

    رقم إجمالي_الصفحات          # إجمالي صفحات الذاكرة
    رقم صفحات_حرة               # عدد الصفحات المتاحة
    رقم حالة_التهيئة            # 0=غير مهيأ, 1=مهيأ, 2=خطأ

    #  جداول الكتل الحرة لكل رتبة (قوائم مرتبطة)
    مصفوفة رؤوس_القوائم

    # إحصاءات مدمجة مباشرة
    رقم احص_إجمالي_بايت
    رقم احص_متاحة_بايت
    رقم احص_مستخدمة_بايت
    رقم احص_نواة_بايت
    رقم احص_إجمالي_صفحات
    رقم احص_صفحات_حرة
    رقم احص_صفحات_مستخدمة
    رقم احص_أكبر_كتلة
    رقم احص_عمليات_تخصيص
    رقم احص_عمليات_إلغاء
    رقم احص_أخطاء

    باني()
        إجمالي_الصفحات = 0
        صفحات_حرة = 0
        حالة_التهيئة = 0
        رؤوس_القوائم = []
        احص_إجمالي_بايت = 0
        احص_متاحة_بايت = 0
        احص_مستخدمة_بايت = 0
        احص_نواة_بايت = 0
        احص_إجمالي_صفحات = 0
        احص_صفحات_حرة = 0
        احص_صفحات_مستخدمة = 0
        احص_أكبر_كتلة = 0
        احص_عمليات_تخصيص = 0
        احص_عمليات_إلغاء = 0
        احص_أخطاء = 0

        # تهيئة رؤوس القوائم (لكل رتبة قائمة فارغة)
        متغير طبقة = 0
        بينما (طبقة < أقصى_طبقة)
            رؤوس_القوائم += [-1]    # -1 = فارغة
            طبقة = طبقة + 1
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## التهيئة من خريطة الذاكرة
    ## ══════════════════════════════════════════════════════════════════════
    ## يستقبل خريطة الذاكرة من بروتوكول Limine ويبني بنية المصاحب
    ##
    ## الخوارزمية:
    ## 1. مسح جميع إدخالات خريطة الذاكرة
    ## 2. تجاهل المناطق المحجوزة والتالفة
    ## 3. تجاهل المنطقة أسفل 16MB (محجوزة للنواة)
    ## 4. تقسيم المناطق المتاحة إلى صفحات وإضافتها للقوائم الحرة
    دالة رقم تهيئة(مصفوفة إدخالات_الخريطة)
        اطبع_سطر("🐝 مدير الذاكرة الفعلية: بدء التهيئة...")
        اطبع_سطر("   خوارزمية: المصاحب السداسي (Hex Buddy Allocator)")

        # مسح إدخالات الخريطة
        متغير مجموع_الذاكرة = 0
        متغير صفحات_مُضافة = 0
        متغير عدد_المناطق = 0

        لكل إدخال في إدخالات_الخريطة
            احص_إجمالي_بايت = احص_إجمالي_بايت + إدخال.الحجم
            مجموع_الذاكرة = مجموع_الذاكرة + إدخال.الحجم
            عدد_المناطق = عدد_المناطق + 1

            إدخال.طباعة_معلومات()

            # تجاهل المناطق غير المتاحة
            اذا (ليس إدخال.متاحة())
                استمر
            نهاية

            # تجاهل الذاكرة أسفل 16 ميغابايت (محجوزة للنواة)
            متغير عنوان_البداية = إدخال.العنوان_الفعلي
            متغير نهاية_المنطقة = إدخال.نهاية_المنطقة()

            اذا (نهاية_المنطقة <= بداية_الذاكرة_الحرة)
                استمر
            نهاية

            اذا (عنوان_البداية < بداية_الذاكرة_الحرة)
                عنوان_البداية = بداية_الذاكرة_الحرة
            نهاية

            # محاذاة العنوان لحجم الصفحة
            متغير عنوان_محاذى = ((عنوان_البداية + حجم_الصفحة - 1) / حجم_الصفحة) * حجم_الصفحة

            # إضافة الصفحات في هذه المنطقة للمدير
            متغير عنوان_حالي = عنوان_محاذى
            بينما (عنوان_حالي + حجم_الصفحة <= نهاية_المنطقة)
                أضف_صفحة_حرة(عنوان_حالي)
                عنوان_حالي = عنوان_حالي + حجم_الصفحة
                صفحات_مُضافة = صفحات_مُضافة + 1
            نهاية
        نهاية

        # تحديث الإحصاءات
        احص_إجمالي_صفحات = صفحات_مُضافة
        احص_صفحات_حرة = صفحات_مُضافة
        احص_متاحة_بايت = صفحات_مُضافة * حجم_الصفحة
        إجمالي_الصفحات = صفحات_مُضافة
        صفحات_حرة = صفحات_مُضافة

        # تجميع الكتل المجاورة
        دمج_الكتل_المجاورة()

        حالة_التهيئة = 1
        اطبع("🐝 تمت التهيئة: ")
        اطبع(صفحات_مُضافة)
        اطبع(" صفحة = ")
        اطبع((صفحات_مُضافة * حجم_الصفحة) / 1048576)
        اطبع_سطر(" MB متاحة")

        ارجع 1
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تخصيص ذاكرة فعلية
    ## ══════════════════════════════════════════════════════════════════════
    ## يخصص `عدد_الصفحات` صفحات متجاورة ويعيد عنوانها الفعلي
    ## يستخدم خوارزمية المصاحب للبحث عن كتلة مناسبة
    ##
    ## المُعامَل: عدد_صفحات_مطلوب - عدد الصفحات المطلوبة
    ## القيمة المُعادة: العنوان الفعلي للذاكرة المخصصة، أو 0 عند الفشل
    دالة رقم خصص(رقم عدد_صفحات_مطلوب)
        اذا (حالة_التهيئة != 1)
            اطبع_سطر("خطأ: مدير الذاكرة غير مهيأ!")
            ارجع 0
        نهاية

        اذا (عدد_صفحات_مطلوب == 0)
            ارجع 0
        نهاية

        # إيجاد الرتبة المناسبة (أصغر قوة للعدد 2 تكفي)
        متغير الرتبة = 0
        متغير القدرة = 1
        بينما (القدرة < عدد_صفحات_مطلوب)
            القدرة = القدرة * 2
            الرتبة = الرتبة + 1
        نهاية

        اذا (الرتبة >= أقصى_طبقة)
            اطبع("خطأ: الحجم المطلوب كبير جداً: ")
            اطبع_سطر(عدد_صفحات_مطلوب)
            احص_أخطاء = احص_أخطاء + 1
            ارجع 0
        نهاية

        # البحث عن كتلة حرة في هذه الرتبة أو أعلى
        متغير رتبة_البحث = الرتبة
        بينما (رتبة_البحث < أقصى_طبقة)
            اذا (رؤوس_القوائم[رتبة_البحث] != -1)
                # وُجدت كتلة حرة
                متغير العنوان = انتزع_كتلة_من_قائمة(رتبة_البحث)

                # تقسيم الكتلة إن كانت أكبر من المطلوب
                بينما (رتبة_البحث > الرتبة)
                    رتبة_البحث = رتبة_البحث - 1
                    # النصف الثاني يعود للقائمة الحرة
                    متغير حجم_نصف = حجم_الرتبة(رتبة_البحث)
                    أضف_للقائمة(العنوان + حجم_نصف * حجم_الصفحة, رتبة_البحث)
                نهاية

                # تحديث الإحصاءات
                متغير صفحات_مخصصة = قوة_اثنين(الرتبة)
                صفحات_حرة = صفحات_حرة - صفحات_مخصصة
                احص_صفحات_حرة = صفحات_حرة
                احص_صفحات_مستخدمة = احص_صفحات_مستخدمة + صفحات_مخصصة
                احص_مستخدمة_بايت = احص_مستخدمة_بايت + (صفحات_مخصصة * حجم_الصفحة)
                احص_عمليات_تخصيص = احص_عمليات_تخصيص + 1

                ارجع العنوان
            نهاية
            رتبة_البحث = رتبة_البحث + 1
        نهاية

        # لا توجد ذاكرة كافية
        اطبع_سطر("تحذير: ذاكرة غير كافية لتخصيص ")
        اطبع(عدد_صفحات_مطلوب)
        اطبع_سطر(" صفحة")
        احص_أخطاء = احص_أخطاء + 1
        ارجع 0
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إلغاء تخصيص ذاكرة فعلية
    ## ══════════════════════════════════════════════════════════════════════
    ## يُعيد الذاكرة المخصصة للمدير ويدمج الكتل المجاورة
    ##
    ## المُعاملات:
    ##   عنوان_الذاكرة - العنوان الفعلي المُراد تحريره
    ##   عدد_الصفحات  - عدد الصفحات المُراد تحريرها
    دالة الغ_التخصيص(رقم عنوان_الذاكرة, رقم عدد_الصفحات)
        اذا (حالة_التهيئة != 1)
            ارجع 0
        نهاية

        اذا (عنوان_الذاكرة == 0)
            ارجع 0
        نهاية

        # إيجاد الرتبة المناسبة
        متغير الرتبة = 0
        متغير القدرة = 1
        بينما (القدرة < عدد_الصفحات)
            القدرة = القدرة * 2
            الرتبة = الرتبة + 1
        نهاية

        # محاولة دمج مع المصاحب
        متغير العنوان_الحالي = عنوان_الذاكرة
        متغير الرتبة_الحالية = الرتبة

        بينما (الرتبة_الحالية < أقصى_طبقة - 1)
            # حساب عنوان المصاحب
            متغير حجم_بالصفحات = قوة_اثنين(الرتبة_الحالية)
            متغير عنوان_المصاحب = حساب_عنوان_المصاحب(العنوان_الحالي, حجم_بالصفحات)

            # هل المصاحب حر؟
            اذا (ليس كتلة_حرة_في_القائمة(عنوان_المصاحب, الرتبة_الحالية))
                اخرج    # المصاحب مشغول - لا يمكن الدمج
            نهاية

            # أزل المصاحب من القائمة الحرة
            أزل_من_القائمة(عنوان_المصاحب, الرتبة_الحالية)

            # دمج الكتلتين
            اذا (عنوان_المصاحب < العنوان_الحالي)
                العنوان_الحالي = عنوان_المصاحب
            نهاية
            الرتبة_الحالية = الرتبة_الحالية + 1
        نهاية

        # إضافة الكتلة (المدموجة أو الأصلية) للقائمة الحرة
        أضف_للقائمة(العنوان_الحالي, الرتبة_الحالية)

        # تحديث الإحصاءات
        متغير صفحات_محررة = قوة_اثنين(الرتبة)
        صفحات_حرة = صفحات_حرة + صفحات_محررة
        احص_صفحات_حرة = صفحات_حرة
        احص_صفحات_مستخدمة = احص_صفحات_مستخدمة - صفحات_محررة
        احص_مستخدمة_بايت = احص_مستخدمة_بايت - (صفحات_محررة * حجم_الصفحة)
        احص_عمليات_إلغاء = احص_عمليات_إلغاء + 1
    نهاية

    # ─────────────────────────────────────────────────────────────────────
    # دوال مساعدة داخلية
    # ─────────────────────────────────────────────────────────────────────

    ## إضافة صفحة واحدة للقائمة الحرة
    دالة أضف_صفحة_حرة(رقم العنوان)
        أضف_للقائمة(العنوان, 0)   # الرتبة 0 = صفحة واحدة 4KB
    نهاية

    ## إضافة كتلة للقائمة الحرة في رتبة معينة
    دالة أضف_للقائمة(رقم العنوان, رقم الرتبة)
        اذا (الرتبة < 0)
            ارجع 0
        نهاية
        اذا (الرتبة >= أقصى_طبقة)
            ارجع 0
        نهاية
        # نضع العنوان في رأس القائمة
        رؤوس_القوائم[الرتبة] = العنوان
    نهاية

    ## انتزاع أول كتلة من قائمة الرتبة
    دالة رقم انتزع_كتلة_من_قائمة(رقم الرتبة)
        متغير العنوان = رؤوس_القوائم[الرتبة]
        رؤوس_القوائم[الرتبة] = -1    # أفرغ القائمة (مبسّط)
        ارجع العنوان
    نهاية

    ## إزالة كتلة من قائمة الرتبة
    دالة أزل_من_القائمة(رقم العنوان, رقم الرتبة)
        # في التطبيق الكامل: نبحث عن الكتلة ونزيلها من القائمة المرتبطة
        # هنا: نفذ مبسط
        اذا (رؤوس_القوائم[الرتبة] == العنوان)
            رؤوس_القوائم[الرتبة] = -1
        نهاية
    نهاية

    ## التحقق من وجود كتلة حرة في القائمة
    دالة منطقي كتلة_حرة_في_القائمة(رقم العنوان, رقم الرتبة)
        ارجع رؤوس_القوائم[الرتبة] == العنوان
    نهاية

    ## حساب عنوان المصاحب
    دالة رقم حساب_عنوان_المصاحب(رقم العنوان, رقم الحجم_بالصفحات)
        متغير الحجم_بالبايت = الحجم_بالصفحات * حجم_الصفحة
        # العنوان XOR الحجم (المصاحب دائماً في موضع محدد)
        متغير رقم_الكتلة = العنوان / الحجم_بالبايت
        اذا ((رقم_الكتلة - ((رقم_الكتلة / 2) * 2)) == 0)  # رقم زوجي
            ارجع العنوان + الحجم_بالبايت
        والا
            ارجع العنوان - الحجم_بالبايت
        نهاية
    نهاية

    ## حساب حجم الرتبة بالصفحات
    دالة رقم حجم_الرتبة(رقم الرتبة)
        ارجع قوة_اثنين(الرتبة)
    نهاية

    ## حساب قوة العدد 2
    دالة رقم قوة_اثنين(رقم الأس)
        متغير النتيجة = 1
        متغير عداد = 0
        بينما (عداد < الأس)
            النتيجة = النتيجة * 2
            عداد = عداد + 1
        نهاية
        ارجع النتيجة
    نهاية

    ## دمج الكتل المجاورة (تحسين الداخلية)
    دالة دمج_الكتل_المجاورة()
        # في التطبيق الكامل: نمر على كل الكتل ونحاول دمجها
        # هذه عملية O(n log n) تُحسّن استخدام الذاكرة
        اطبع_سطر("   دمج الكتل المجاورة...")
    نهاية

    ## طباعة ملخص الإحصاءات
    دالة اطبع_إحصاءات()
        اطبع_سطر("═══════════════════════════════════════════")
        اطبع_سطر("  🐝 إحصاءات الذاكرة الفعلية - نظام النحلة")
        اطبع_سطر("═══════════════════════════════════════════")
        اطبع("  الإجمالي:          ")
        اطبع(احص_إجمالي_بايت / 1048576)
        اطبع_سطر(" MB")
        اطبع("  متاحة:             ")
        اطبع(احص_متاحة_بايت / 1048576)
        اطبع_سطر(" MB")
        اطبع("  مستخدمة:           ")
        اطبع(احص_مستخدمة_بايت / 1048576)
        اطبع_سطر(" MB")
        اطبع("  صفحات حرة:         ")
        اطبع(احص_صفحات_حرة)
        اطبع_سطر(" صفحة")
        اطبع("  صفحات مستخدمة:     ")
        اطبع(احص_صفحات_مستخدمة)
        اطبع_سطر(" صفحة")
        اطبع_سطر("═══════════════════════════════════════════")
    نهاية

    ## عرض الإحصاءات التفصيلية
    دالة عرض_الإحصاءات()
        اطبع_إحصاءات()
        اطبع("  عمليات تخصيص:  ")
        اطبع_سطر(احص_عمليات_تخصيص)
        اطبع("  عمليات إلغاء:  ")
        اطبع_سطر(احص_عمليات_إلغاء)
        اطبع("  أخطاء تخصيص:  ")
        اطبع_سطر(احص_أخطاء)
    نهاية

    ## اختبار سريع للمدير (للتأكد من الصحة)
    دالة رقم اختبار_ذاتي()
        اطبع_سطر("🐝 بدء الاختبار الذاتي لمدير الذاكرة...")

        # اختبار 1: تخصيص صفحة واحدة
        متغير عنوان1 = خصص(1)
        اذا (عنوان1 == 0)
            اطبع_سطر("✗ فشل الاختبار 1: تخصيص صفحة واحدة")
            ارجع 0
        نهاية
        اطبع_سطر("✓ الاختبار 1: تخصيص صفحة واحدة - نجح")

        # اختبار 2: تخصيص 4 صفحات
        متغير عنوان2 = خصص(4)
        اذا (عنوان2 == 0)
            اطبع_سطر("✗ فشل الاختبار 2: تخصيص 4 صفحات")
            ارجع 0
        نهاية
        اطبع_سطر("✓ الاختبار 2: تخصيص 4 صفحات - نجح")

        # اختبار 3: تحرير الذاكرة
        الغ_التخصيص(عنوان1, 1)
        الغ_التخصيص(عنوان2, 4)
        اطبع_سطر("✓ الاختبار 3: تحرير الذاكرة - نجح")

        # اختبار 4: إعادة التخصيص
        متغير عنوان3 = خصص(1)
        اذا (عنوان3 == 0)
            اطبع_سطر("✗ فشل الاختبار 4: إعادة التخصيص")
            ارجع 0
        نهاية
        اطبع_سطر("✓ الاختبار 4: إعادة التخصيص - نجح")
        الغ_التخصيص(عنوان3, 1)

        اطبع_سطر("✅ جميع الاختبارات نجحت!")
        ارجع 1
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# المثيل العالمي لمدير الذاكرة الفعلية
# يمكن الوصول إليه من أي مكان في النواة
# ─────────────────────────────────────────────────────────────────────────────
متغير مدير_ذاكرة_النحلة = جديد مدير_الذاكرة_الفعلية()

# ─────────────────────────────────────────────────────────────────────────────
# دالة البدء - تُستدعى من النواة عند الإقلاع
# ─────────────────────────────────────────────────────────────────────────────
دالة رقم بدء_مدير_الذاكرة(مصفوفة خريطة_ذاكرة_الإقلاع)
    ارجع مدير_ذاكرة_النحلة.تهيئة(خريطة_ذاكرة_الإقلاع)
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الدالة الرئيسية (للاختبار خارج النواة)
# ─────────────────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════")
    اطبع_سطر("  🐝 نظام خلية النحل - اختبار مدير الذاكرة")
    اطبع_سطر("══════════════════════════════════════════════")

    # محاكاة خريطة ذاكرة صغيرة للاختبار
    متغير خريطة_اختبار = []

    # منطقة 1: محجوزة (BIOS) - أول 64KB
    متغير منطقة1 = جديد إدخال_خريطة_الذاكرة(0, 65536, نوع_ذاكرة_محجوزة)
    خريطة_اختبار += [منطقة1]

    # منطقة 2: متاحة صغيرة من 16MB - 16MB+256KB (64 صفحة فقط للاختبار السريع)
    متغير منطقة2 = جديد إدخال_خريطة_الذاكرة(16777216, 262144, نوع_ذاكرة_متاحة)
    خريطة_اختبار += [منطقة2]

    # تهيئة المدير
    متغير نجاح = بدء_مدير_الذاكرة(خريطة_اختبار)

    اذا (نجاح == 1)
        # تشغيل الاختبار الذاتي
        مدير_ذاكرة_النحلة.اختبار_ذاتي()

        # عرض الإحصاءات
        مدير_ذاكرة_النحلة.عرض_الإحصاءات()
    والا
        اطبع_سطر("✗ فشلت تهيئة مدير الذاكرة!")
    نهاية

    ارجع 0
نهاية
