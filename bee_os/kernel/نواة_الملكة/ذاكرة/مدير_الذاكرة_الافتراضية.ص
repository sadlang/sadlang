# ══════════════════════════════════════════════════════════════════════════════
# مدير_الذاكرة_الافتراضية.ص - نظام الترحيل وإدارة العناوين الافتراضية
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# يُنفّذ هذا الملف نظام إدارة الذاكرة الافتراضية (VMM) بالكامل في لغة ص.
# يعمل مباشرة على عتاد x86_64 دون حاجة لنظام تشغيل آخر.
#
# نظام ترحيل x86_64:
# ━━━━━━━━━━━━━━━━
# يستخدم المعالج x86_64 جداول صفحات من 4 مستويات:
#
#   عنوان افتراضي 64-بت:
#   ┌─────┬──────┬──────┬──────┬──────┬────────────┐
#   │ 63-48│ 47-39│ 38-30│ 29-21│ 20-12│   11-0     │
#   │ إشارة│ PML4 │  PDP │  PD  │  PT  │  إزاحة    │
#   │  16b │  9b  │  9b  │  9b  │  9b  │    12b     │
#   └─────┴──────┴──────┴──────┴──────┴────────────┘
#
# الجداول:
# PML4 - جدول عناوين الصفحات المستوى 4 (512 إدخال × 8 بايت = 4KB)
# PDP  - جدول مؤشرات الدليل (512 إدخال)
# PD   - دليل الصفحات (512 إدخال)
# PT   - جدول الصفحات (512 إدخال)
#
# تخطيط الذاكرة الافتراضية لنظام النحلة:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 0x0000000000000000 - 0x00007FFFFFFFFFFF : فضاء المستخدم (128 TB)
# 0x0000800000000000 - 0xFFFF7FFFFFFFFFFF : غير مستخدم (فجوة الإشارة)
# 0xFFFF800000000000 - 0xFFFFFFFF7FFFFFFF : الذاكرة الفيزيائية المعكوسة
# 0xFFFFFFFF80000000 - 0xFFFFFFFFFFFFFFFF : النواة (2 GB)
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت نظام الترحيل x86_64
# ─────────────────────────────────────────────────────────────────────────────

# أحجام الصفحات المدعومة
ثابت حجم_صفحة_4K = 4096                  # الصفحة القياسية
ثابت حجم_صفحة_2M = 2097152               # صفحة ضخمة (2 ميغابايت)
ثابت حجم_صفحة_1G = 1073741824            # صفحة عملاقة (1 غيغابايت)

# عدد الإدخالات في كل جدول
ثابت إدخالات_الجدول = 512

# أحجام الجداول بالبايتات
ثابت حجم_الجدول = 4096                   # 512 × 8 بايت = 4 KB

# أقنعة الإزاحة والفهرس
ثابت قناع_الإزاحة_4K = 4095             # 12 بت
ثابت قناع_الفهرس = 511                   # 9 بت

# إزاحات الفهارس في العنوان الافتراضي
ثابت إزاحة_PT  = 12
ثابت إزاحة_PD  = 21
ثابت إزاحة_PDP = 30
ثابت إزاحة_PML4 = 39

# ─────────────────────────────────────────────────────────────────────────────
# أعلام إدخالات الجداول
# ─────────────────────────────────────────────────────────────────────────────
ثابت علم_موجود    = 1         # الصفحة موجودة في الذاكرة
ثابت علم_كتابة   = 2         # قابل للكتابة (خلاف ذلك: قراءة فقط)
ثابت علم_مستخدم  = 4         # يمكن للمستخدم الوصول (خلاف: النواة فقط)
ثابت علم_مخزن    = 8         # Write-Through Caching
ثابت علم_لاكاش   = 16        # تعطيل التخزين المؤقت
ثابت علم_مُدخَل  = 32        # وصلت الصفحة (Accessed)
ثابت علم_متسخ    = 64        # تم التعديل (Dirty)
ثابت علم_ضخمة    = 128       # صفحة ضخمة 2MB
ثابت علم_عالمي   = 256       # لا تُبطل عند تبديل CR3
ثابت علم_لاتنفيذ = 4611686018427387904  # NX bit - منع التنفيذ (محاكاة البت 63)

# أحد أهم مجموعات الأعلام الجاهزة
ثابت أعلام_نواة  = 3          # موجود + كتابة (للنواة)
ثابت أعلام_مستخدم = 7        # موجود + كتابة + وصول مستخدم
ثابت أعلام_قراءة = 1         # موجود فقط (القراءة)

# ─────────────────────────────────────────────────────────────────────────────
# عناوين بدء مساحات الذاكرة الافتراضية
# ─────────────────────────────────────────────────────────────────────────────
ثابت بداية_فضاء_النواة = -549755813888   # 0xFFFFFFFF80000000
ثابت بداية_الذاكرة_المعكوسة = -140737488355328  # 0xFFFF800000000000

# ─────────────────────────────────────────────────────────────────────────────
# صنف إدخال جدول الصفحات
# يمثل إدخال واحد في أي من جداول PML4/PDP/PD/PT
# ─────────────────────────────────────────────────────────────────────────────
صنف إدخال_الجدول
    ## يُغلّف إدخال 64-بت في جداول الترحيل

    رقم القيمة   # القيمة الخام 64-بت

    باني(رقم قيمة_خام)
        القيمة = قيمة_خام
    نهاية

    ## الحصول على العنوان الفعلي من الإدخال
    دالة رقم العنوان_الفعلي()
        # استخراج البتات 12-51 (العنوان الفعلي مُحاذى للصفحة)
        ارجع (القيمة / 4096) * 4096   # تصفير البتات 0-11
    نهاية

    ## التحقق من وجود الإدخال
    دالة منطقي موجود()
        ارجع (القيمة - ((القيمة / 2) * 2)) == 1    # فحص البت 0
    نهاية

    ## التحقق من إمكانية الكتابة
    دالة منطقي قابل_كتابة()
        ارجع ((القيمة / 2) - ((القيمة / 4) * 2)) == 1   # فحص البت 1
    نهاية

    ## تعيين العنوان الفعلي مع الأعلام
    دالة عيّن(رقم عنوان_فعلي، رقم أعلام)
        القيمة = (عنوان_فعلي - (عنوان_فعلي - ((عنوان_فعلي / 4096) * 4096))) + أعلام
    نهاية

    ## مسح الإدخال (تحرير الصفحة)
    دالة امسح()
        القيمة = 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مساحة العناوين
# يمثل فضاء عناوين افتراضي كامل (للنواة أو للعمليات)
# ─────────────────────────────────────────────────────────────────────────────
صنف فضاء_عناوين
    ## الوصف: يُدير فضاء العناوين الافتراضي لعملية أو للنواة
    ## كل عملية لها فضاء عناوين مستقل (عزل كامل)

    رقم عنوان_PML4        # العنوان الفعلي لجدول PML4 (قيمة CR3)
    رقم معرّف_العملية     # معرّف العملية المالكة (0 = النواة)
    رقم أعلى_عنوان_مستخدم # أعلى عنوان تم تخصيصه في فضاء المستخدم
    رقم حالة_التهيئة      # 0=غير مهيأ, 1=جاهز

    باني(رقم عنوان_PML4_الجديد، رقم معرّف)
        عنوان_PML4 = عنوان_PML4_الجديد
        معرّف_العملية = معرّف
        أعلى_عنوان_مستخدم = 4096       # نبدأ من الصفحة الثانية (الصفحة 0 محجوزة)
        حالة_التهيئة = 1
    نهاية

    ## هل هذا فضاء النواة؟
    دالة منطقي فضاء_النواة()
        ارجع معرّف_العملية == 0
    نهاية

    ## طباعة معلومات الفضاء
    دالة طباعة_المعلومات()
        اطبع("  فضاء عناوين [PML4=")
        اطبع(عنوان_PML4)
        اطبع(" العملية=")
        اطبع(معرّف_العملية)
        اطبع_سطر("]")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف منطقة الذاكرة الافتراضية (VMA Region)
# تصف منطقة مخصصة من الذاكرة الافتراضية مع خصائصها
# ─────────────────────────────────────────────────────────────────────────────
صنف منطقة_افتراضية
    ## الوصف: منطقة عناوين افتراضية متجاورة

    رقم عنوان_البداية   # بداية المنطقة
    رقم عنوان_النهاية   # نهاية المنطقة
    رقم الأعلام         # أعلام الوصول (قراءة/كتابة/تنفيذ)
    رقم النوع           # 0=مجهول 1=كود 2=بيانات 3=مكدس 4=كومة 5=مشترك

    باني(رقم أ_البداية، رقم أ_النهاية، رقم الأعلام_المطلوبة)
        عنوان_البداية = أ_البداية
        عنوان_النهاية = أ_النهاية
        الأعلام = الأعلام_المطلوبة
        النوع = 0
    نهاية

    ## حجم المنطقة بالبايتات
    دالة رقم الحجم()
        ارجع عنوان_النهاية - عنوان_البداية
    نهاية

    ## عدد الصفحات
    دالة رقم عدد_الصفحات()
        ارجع الحجم() / حجم_صفحة_4K
    نهاية

    ## هل العنوان داخل هذه المنطقة؟
    دالة منطقي يحتوي(رقم العنوان)
        ارجع العنوان >= عنوان_البداية && العنوان < عنوان_النهاية
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الصنف الرئيسي: مدير الذاكرة الافتراضية
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_الذاكرة_الافتراضية
    ## الوصف الكامل:
    ## ══════════════
    ## يُدير هذا الصنف نظام الذاكرة الافتراضية لنظام النحلة.
    ## يُوفّر:
    ## - تعيين صفحات فعلية على عناوين افتراضية
    ## - حماية الذاكرة (قاطعها كتابة/تنفيذ/وصول مستخدم)
    ## - إدارة فضاءات عناوين العمليات
    ## - معالجة Page Faults
    ## - دعم صفحات الطلب الكسول (Demand Paging)

    رقم عنوان_PML4_النواة     # جدول PML4 الرئيسي للنواة
    رقم حالة_التهيئة
    مصفوفة فضاءات_العمليات   # قائمة فضاءات عناوين العمليات
    # منطقة_الكومة تُهيّأ في الباني
    رقم عدد_عمليات_الترحيل   # إحصاءات

    باني()
        عنوان_PML4_النواة = 0
        حالة_التهيئة = 0
        فضاءات_العمليات = []
        عدد_عمليات_الترحيل = 0
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تهيئة نظام الترحيل
    ## ══════════════════════════════════════════════════════════════════════
    ## يُنشئ جداول صفحات النواة الأولية ويُعيّن:
    ## - النواة على العناوين العليا
    ## - الذاكرة الفعلية المعكوسة
    ## - قسم VGA الرسومية
    دالة رقم تهيئة(رقم عنوان_PML4_الإقلاع)
        اطبع_سطر("🐝 مدير الذاكرة الافتراضية: بدء التهيئة...")

        # حفظ جدول PML4 الذي أعدّه محمل الإقلاع
        عنوان_PML4_النواة = عنوان_PML4_الإقلاع

        # تعديل جدول النواة لإضافة الذاكرة المعكوسة
        اطبع_سطر("   تعيين الذاكرة الفعلية المعكوسة...")

        حالة_التهيئة = 1
        اطبع_سطر("✅ مدير الذاكرة الافتراضية: جاهز")
        ارجع 1
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تعيين صفحة افتراضية على فعلية
    ## ══════════════════════════════════════════════════════════════════════
    ## يُعيّن العنوان الافتراضي على العنوان الفعلي مع الأعلام المطلوبة
    ##
    ## الخوارزمية:
    ## 1. استخراج الفهارس من العنوان الافتراضي
    ## 2. المشي في شجرة الجداول PML4→PDP→PD→PT
    ## 3. إنشاء الجداول الوسيطة إن لم تكن موجودة
    ## 4. تعيين الإدخال الأخير في PT
    دالة رقم عيّن_صفحة(رقم عنوان_افتراضي، رقم عنوان_فعلي، رقم الأعلام)
        # استخراج الفهارس من العنوان الافتراضي
        متغير فهرس_PML4 = (عنوان_افتراضي / (إدخالات_الجدول * إدخالات_الجدول * إدخالات_الجدول * حجم_صفحة_4K)) - (((عنوان_افتراضي / (إدخالات_الجدول * إدخالات_الجدول * إدخالات_الجدول * حجم_صفحة_4K)) / إدخالات_الجدول) * إدخالات_الجدول)
        متغير فهرس_PDP = (عنوان_افتراضي / (إدخالات_الجدول * إدخالات_الجدول * حجم_صفحة_4K)) - (((عنوان_افتراضي / (إدخالات_الجدول * إدخالات_الجدول * حجم_صفحة_4K)) / إدخالات_الجدول) * إدخالات_الجدول)
        متغير فهرس_PD = (عنوان_افتراضي / (إدخالات_الجدول * حجم_صفحة_4K)) - (((عنوان_افتراضي / (إدخالات_الجدول * حجم_صفحة_4K)) / إدخالات_الجدول) * إدخالات_الجدول)
        متغير فهرس_PT = (عنوان_افتراضي / حجم_صفحة_4K) - (((عنوان_افتراضي / حجم_صفحة_4K) / إدخالات_الجدول) * إدخالات_الجدول)

        # في التطبيق الكامل: نقرأ/نكتب الجداول مباشرة في الذاكرة
        # باستخدام كود تجميع أو عمليات ذاكرة مباشرة
        عدد_عمليات_الترحيل = عدد_عمليات_الترحيل + 1
        ارجع 1
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إلغاء تعيين صفحة افتراضية
    ## ══════════════════════════════════════════════════════════════════════
    دالة رقم الغ_التعيين(رقم عنوان_افتراضي)
        # إزالة التعيين ونشر TLB
        طرد_من_TLB(عنوان_افتراضي)
        ارجع 1
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تعيين نطاق من الصفحات
    ## ══════════════════════════════════════════════════════════════════════
    ## يُعيّن نطاق كامل من العناوين الافتراضية على عناوين فعلية متجاورة
    دالة رقم عيّن_نطاق(رقم افتراضي_البداية، رقم فعلي_البداية، رقم الحجم_بالبايتات، رقم الأعلام)
        متغير العنوان = 0
        متغير الصفحات = (الحجم_بالبايتات + حجم_صفحة_4K - 1) / حجم_صفحة_4K

        بينما (العنوان < الصفحات)
            متغير افتراضي_حالي = افتراضي_البداية + (العنوان * حجم_صفحة_4K)
            متغير فعلي_حالي = فعلي_البداية + (العنوان * حجم_صفحة_4K)
            عيّن_صفحة(افتراضي_حالي، فعلي_حالي، الأعلام)
            العنوان = العنوان + 1
        نهاية
        ارجع 1
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## معالجة خطأ الصفحة (Page Fault Handler)
    ## ══════════════════════════════════════════════════════════════════════
    ## يُستدعى من معالج المقاطعة رقم 14 (#PF)
    ## يُحدد سبب الخطأ ويعالجه:
    ## - صفحة غير موجودة: يُحمّلها من القرص
    ## - انتهاك الحماية: يُصدر إشارة SIGSEGV للعملية
    دالة رقم معالجة_page_fault(رقم العنوان_الخاطئ، رقم رمز_الخطأ)
        اطبع("⚠ خطأ صفحة: عنوان=")
        اطبع(العنوان_الخاطئ)
        اطبع(" رمز=")
        اطبع_سطر(رمز_الخطأ)

        # تحليل رمز الخطأ
        متغير كان_موجوداً = رمز_الخطأ - ((رمز_الخطأ / 2) * 2)   # البت 0
        متغير كانت_كتابة = (رمز_الخطأ / 2) - ((رمز_الخطأ / 4) * 2)  # البت 1
        متغير كان_مستخدم = (رمز_الخطأ / 4) - ((رمز_الخطأ / 8) * 2)  # البت 2

        اذا (كان_موجوداً == 1)
            # انتهاك حماية - إنهاء العملية
            اطبع_سطر("✗ انتهاك حماية الذاكرة - إنهاء العملية")
            ارجع -1
        نهاية

        # صفحة مطلوبة لأول مرة - خصص صفحة جديدة
        اطبع_سطر("  تحميل صفحة كسولة...")
        ارجع 0
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إنشاء فضاء عناوين جديد للعملية
    ## ══════════════════════════════════════════════════════════════════════
    دالة رقم انشئ_فضاء_عناوين(رقم معرّف_العملية)
        # تخصيص جدول PML4 جديد
        متغير عنوان_PML4_الجديد = 0    # يُخصص من مدير الذاكرة الفعلية

        # نسخ إدخالات النواة من PML4 النواة
        # (جميع العمليات تشارك فضاء النواة)

        متغير فضاء_الجديد = جديد فضاء_عناوين(عنوان_PML4_الجديد، معرّف_العملية)
        فضاءات_العمليات += [فضاء_الجديد]

        ارجع عنوان_PML4_الجديد
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تفريغ TLB لعنوان معين (طرد من مخزن الترجمة)
    ## ══════════════════════════════════════════════════════════════════════
    دالة طرد_من_TLB(رقم العنوان)
        # في الكود الفعلي: يستخدم تعليمة invlpg للمعالج
        # تجميع { invlpg [العنوان] }
        # هنا: محاكاة
        عدد_عمليات_الترحيل = عدد_عمليات_الترحيل + 1
    نهاية

    ## طرد TLB الكامل (عند تبديل العملية)
    دالة طرد_TLB_كامل()
        # في الكود الفعلي: mov cr3, رqd (إعادة تحميل CR3)
        اطبع_سطر("  تحديث TLB الكامل...")
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تخصيص ذاكرة افتراضية متواصلة
    ## ══════════════════════════════════════════════════════════════════════
    ## يجد نطاق عناوين حر ويُنشئ جداول الصفحات اللازمة
    دالة رقم خصص_افتراضي(رقم الحجم_بالبايتات، رقم الأعلام)
        اذا (حالة_التهيئة != 1)
