#              صنف كاشف تسرب الذاكرة
# ══════════════════════════════════════════════════════════════════════════════

صنف كاشف_التسرب
    ## يتتبع عمليات التخصيص والتحرير لكشف التسرب

    مصفوفة التخصيصات_النشطة     # [عنوان، حجم، نوع]
    رقم عدد_تخصيصات_م
    رقم عدد_تحريرات_م
    رقم إجمالي_مُسرّب

    باني()
        التخصيصات_النشطة = []
        عدد_تخصيصات_م = 0
        عدد_تحريرات_م = 0
        إجمالي_مُسرّب = 0
    نهاية

    # تسجيل تخصيص
    دالة سجّل_تخصيص(رقم العنوان، رقم الحجم، رقم النوع)
        التخصيصات_النشطة += [العنوان]
        عدد_تخصيصات_م = عدد_تخصيصات_م + 1
    نهاية

    # تسجيل تحرير
    دالة سجّل_تحرير(رقم العنوان)
        # البحث وإزالة
        متغير ف = 0
        بينما (ف < طول(التخصيصات_النشطة))
            اذا (التخصيصات_النشطة[ف] == العنوان)
                التخصيصات_النشطة[ف] = 0         # علّم كمحرّر
                عدد_تحريرات_م = عدد_تحريرات_م + 1
                ارجع 0
            نهاية
            ف = ف + 1
        نهاية
        اطبع_سطر("  ⚠ تحرير مزدوج أو غير صالح!")
    نهاية

    # فحص التسرب
    دالة رقم افحص()
        متغير تسرب = 0
        متغير ف = 0
        بينما (ف < طول(التخصيصات_النشطة))
            اذا (التخصيصات_النشطة[ف] != 0)
                تسرب = تسرب + 1
            نهاية
            ف = ف + 1
        نهاية
        إجمالي_مُسرّب = تسرب
        ارجع تسرب
    نهاية

    # طباعة التقرير
    دالة اطبع_تقرير()
        متغير تسرب = افحص()
        اطبع_سطر("── تقرير تسرب الذاكرة ──")
        اطبع("  تخصيصات: ")
        اطبع_سطر(عدد_تخصيصات_م)
        اطبع("  تحريرات: ")
        اطبع_سطر(عدد_تحريرات_م)
        اذا (تسرب > 0)
            اطبع("  ⚠ تسربات نشطة: ")
            اطبع_سطر(تسرب)
        والا
            اطبع_سطر("  ✓ لا توجد تسربات")
        نهاية
    نهاية
نهاية


