# ══════════════════════════════════════════════════════════════════════════════
#              صنف مدير الذاكرة الفعلية المُقوّى
# ══════════════════════════════════════════════════════════════════════════════

صنف مدير_الذاكرة_المُقوّى
    ## المدير الرئيسي

    مصفوفة المناطق
    رقم إجمالي_الصفحات_م
    رقم صفحات_حرة_م
    منطقي مُهيّأ_م

    باني()
        المناطق = []
        إجمالي_الصفحات_م = 0
        صفحات_حرة_م = 0
        مُهيّأ_م = خطأ
    نهاية

    # تهيئة النظام
    دالة تهيئة(رقم عدد_الصفحات)
        اطبع_سطر("🐝 مدير الذاكرة المُقوّى: بدء التهيئة")

        إجمالي_الصفحات_م = عدد_الصفحات
        صفحات_حرة_م = عدد_الصفحات

        # تهيئة خريطة البت
        ع_البت_خريطة.تهيئة(عدد_الصفحات)

        # تهيئة المراجع
        ع_المراجع.تهيئة(عدد_الصفحات)

        # إنشاء مناطق NUMA (محاكاة)
        # منطقة DMA: أول 1024 صفحة
        متغير حجم_DMA = 1024
        اذا (حجم_DMA > عدد_الصفحات)
            حجم_DMA = عدد_الصفحات / 4
        نهاية
        المناطق += [جديد منطقة_NUMA(0، "DMA"، 0، حجم_DMA * ذ_حجم_الصفحة)]

        # منطقة عادية: الباقي
        متغير بداية_عادية = حجم_DMA * ذ_حجم_الصفحة
        المناطق += [جديد منطقة_NUMA(1، "عادية"، بداية_عادية، عدد_الصفحات * ذ_حجم_الصفحة)]

        # إضافة الصفحات للمناطق
        متغير ف = 0
        بينما (ف < عدد_الصفحات)
            متغير عنوان = ف * ذ_حجم_الصفحة
            اذا (ف < حجم_DMA)
                المناطق[0].قوائم_الرتب[0].أضف(عنوان، 1)
            والا
                المناطق[1].قوائم_الرتب[0].أضف(عنوان، 1)
            نهاية
            ف = ف + 1
        نهاية

        مُهيّأ_م = صحيح
        اطبع("  إجمالي الصفحات: ")
        اطبع_سطر(عدد_الصفحات)
        اطبع_سطر("🐝 مدير الذاكرة المُقوّى: التهيئة اكتملت")
    نهاية

    # تخصيص صفحات
    دالة رقم خصص(رقم عدد_مطلوب، رقم سياسة)
        اذا (مُهيّأ_م != صحيح)
            ارجع -1
        نهاية
        اذا (عدد_مطلوب <= 0)
            ارجع -1
        نهاية

        متغير العنوان = -1

        # تطبيق السياسة
        اذا (سياسة == سياسة_DMA)
            # DMA فقط
            اذا (طول(المناطق) > 0)
                العنوان = المناطق[0].خصص(عدد_مطلوب)
            نهاية
        والا
            # عادية أولاً، ثم DMA
            اذا (طول(المناطق) > 1)
                العنوان = المناطق[1].خصص(عدد_مطلوب)
            نهاية
            اذا (العنوان < 0)
                اذا (طول(المناطق) > 0)
                    العنوان = المناطق[0].خصص(عدد_مطلوب)
                نهاية
            نهاية
        نهاية

        اذا (العنوان >= 0)
            # تحديث البت خريطة
            متغير فهرس_صفحة = العنوان / ذ_حجم_الصفحة
            ع_البت_خريطة.عيّن_نطاق(فهرس_صفحة، عدد_مطلوب)

            # تحديث المراجع
            متغير ف = 0
            بينما (ف < عدد_مطلوب)
                ع_المراجع.أضف_مرجع(فهرس_صفحة + ف)
                ف = ف + 1
            نهاية

            # تسجيل في كاشف التسرب
            ع_الكاشف.سجّل_تخصيص(العنوان، عدد_مطلوب، تخصيص_نواة)

            صفحات_حرة_م = صفحات_حرة_م - عدد_مطلوب
        نهاية

        ارجع العنوان
    نهاية

    # تحرير صفحات
    دالة حرّر(رقم العنوان، رقم عدد_صفحات)
        اذا (مُهيّأ_م != صحيح)
            ارجع 0
        نهاية
        اذا (العنوان < 0)
            ارجع 0
        نهاية

        متغير فهرس_صفحة = العنوان / ذ_حجم_الصفحة

        # إنقاص المراجع والتحقق
        متغير ف = 0
        بينما (ف < عدد_صفحات)
            متغير مرجع = ع_المراجع.أنقص_مرجع(فهرس_صفحة + ف)
            اذا (مرجع == 0)
                ع_البت_خريطة.امسح(فهرس_صفحة + ف)
            نهاية
            ف = ف + 1
        نهاية

        # إعادة للمنطقة المناسبة
        اذا (العنوان < المناطق[0].العنوان_النهاية)
            المناطق[0].حرّر(العنوان، عدد_صفحات)
        والا
            اذا (طول(المناطق) > 1)
                المناطق[1].حرّر(العنوان، عدد_صفحات)
            نهاية
        نهاية

        ع_الكاشف.سجّل_تحرير(العنوان)
        صفحات_حرة_م = صفحات_حرة_م + عدد_صفحات
    نهاية

    # مستوى ضغط الذاكرة الإجمالي
    دالة رقم مستوى_الضغط()
        اذا (إجمالي_الصفحات_م == 0)
            ارجع ضغط_حرج
        نهاية
        متغير نسبة_حرة = (صفحات_حرة_م * 100) / إجمالي_الصفحات_م
        اذا (نسبة_حرة >= علامة_عُليا_نسبة)
            ارجع ضغط_لا_يوجد
        والا_اذا (نسبة_حرة >= علامة_وُسطى_نسبة)
            ارجع ضغط_منخفض
        والا_اذا (نسبة_حرة >= علامة_دُنيا_نسبة)
            ارجع ضغط_متوسط
        نهاية
        ارجع ضغط_حرج
    نهاية

    # طباعة حالة شاملة
    دالة اطبع_حالة()
        اطبع_سطر("══ حالة الذاكرة الفعلية المُقوّاة ══")
        اطبع("  إجمالي: ")
        اطبع(إجمالي_الصفحات_م)
        اطبع(" صفحة = ")
        اطبع((إجمالي_الصفحات_م * ذ_حجم_الصفحة) / 1048576)
        اطبع_سطر(" MB")
        اطبع("  حرة: ")
        اطبع_سطر(صفحات_حرة_م)

        # المناطق
        متغير ف = 0
        بينما (ف < طول(المناطق))
            المناطق[ف].اطبع_حالة()
            ف = ف + 1
        نهاية

        # تقرير التسرب
        ع_الكاشف.اطبع_تقرير()
    نهاية
نهاية


