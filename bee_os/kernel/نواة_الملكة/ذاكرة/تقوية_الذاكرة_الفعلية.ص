# تقوية_الذاكرة_الفعلية.ص - تقوية نظام إدارة الذاكرة الفعلية
# ══════════════════════════════════════════════════════════════════════════════
#
# يُضيف الميزات المتقدمة المفقودة من مدير_الذاكرة_الفعلية.ص:
#
# 1. خريطة البت (Bitmap) لتتبع حالة الصفحات
# 2. مرجعية الصفحات (Reference Counting)
# 3. دعم NUMA (مناطق ذاكرة متعددة)
# 4. القوائم المرتبطة الحقيقية (بدلاً من عنوان واحد)
# 5. نظام العلامات المائية (Watermark) لضغط الذاكرة
# 6. مخصص Slab للأحجام الصغيرة
# 7. كشف تسرب الذاكرة وتشخيصه
#
# البنية المُحسّنة:
# ════════════════
# ┌──────────────────────────────────────────────┐
# │         مدير الذاكرة الفعلية المُقوّى        │
# ├──────────────────────────────────────────────┤
# │  خريطة البت (Bitmap)                         │
# │  ├── تتبع صفحة بصفحة (0=حرة، 1=مشغولة)     │
# │  ├── عمليات O(1) للتحقق والتعيين             │
# │  └── 1 بت لكل صفحة = كفاءة ذاكرة عالية       │
# ├──────────────────────────────────────────────┤
# │  مرجعية الصفحات (Ref Count)                  │
# │  ├── عدّاد لكل صفحة                          │
# │  ├── COW / مشاركة ذاكرة                      │
# │  └── تحرير عند وصول العدّاد لصفر              │
# ├──────────────────────────────────────────────┤
# │  مناطق NUMA                                  │
# │  ├── كل منطقة بسياسة خاصة                    │
# │  ├── تفضيل المنطقة القريبة                    │
# │  └── موازنة الحمل بين المناطق                 │
# ├──────────────────────────────────────────────┤
# │  القوائم المرتبطة الحقيقية                   │
# │  ├── سابق ← [رأس] → تالي                    │
# │  ├── إضافة/حذف O(1)                          │
# │  └── بحث O(n) عند الحاجة                     │
# ├──────────────────────────────────────────────┤
# │  العلامات المائية (Watermarks)                │
# │  ├── علامة_عليا: كل شيء جيد                  │
# │  ├── علامة_وسطى: بدء التفريغ                  │
# │  └── علامة_دنيا: ذاكرة حرجة!                 │
# └──────────────────────────────────────────────┘
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 2.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
#                           الثوابت
# ══════════════════════════════════════════════════════════════════════════════

ثابت ذ_حجم_الصفحة = 4096
ثابت ذ_بتات_الصفحة = 12
ثابت ذ_أقصى_طبقة = 11
ثابت ذ_أقصى_صفحات_اختبار = 4096           # للاختبار
ثابت ذ_بتات_لكل_كلمة = 32                 # عدد البتات في كلمة واحدة

# حالات الصفحة
ثابت صفحة_حرة = 0
ثابت صفحة_مخصصة = 1
ثابت صفحة_نواة = 2
ثابت صفحة_محجوزة = 3
ثابت صفحة_معطوبة = 4

# مناطق NUMA
ثابت أقصى_مناطق_NUMA = 4
ثابت منطقة_DMA = 0             # 0 - 16MB
ثابت منطقة_عادية = 1           # 16MB - 4GB
ثابت منطقة_عُليا = 2           # > 4GB

# سياسات التخصيص
ثابت سياسة_عادية = 0           # أي منطقة
ثابت سياسة_DMA = 1             # DMA فقط
ثابت سياسة_محلية = 2           # المنطقة القريبة أولاً

# العلامات المائية (نسبة من إجمالي الصفحات)
ثابت علامة_عُليا_نسبة = 90     # 90% حر = ممتاز
ثابت علامة_وُسطى_نسبة = 50    # 50% حر = بدء التحذير
ثابت علامة_دُنيا_نسبة = 10    # 10% حر = حرج!

# أنواع التخصيص (للتتبع)
ثابت تخصيص_نواة = 1
ثابت تخصيص_مستخدم = 2
ثابت تخصيص_سائق = 3
ثابت تخصيص_ذاكرة_مخبأة = 4

# مستوى ضغط الذاكرة
ثابت ضغط_لا_يوجد = 0
ثابت ضغط_منخفض = 1
ثابت ضغط_متوسط = 2
ثابت ضغط_عالي = 3
ثابت ضغط_حرج = 4


# ══════════════════════════════════════════════════════════════════════════════
#                 صنف خريطة البت (Bitmap)
# ══════════════════════════════════════════════════════════════════════════════

صنف خريطة_بت
    ## تتبع حالة الصفحات: 0 = حرة، 1 = مشغولة
    ## عنصر واحد لكل صفحة (أبسط وأكثر موثوقية)

    مصفوفة الحالات
    رقم عدد_الصفحات_الإجمالي

    باني()
        الحالات = []
        عدد_الصفحات_الإجمالي = 0
    نهاية

    # تهيئة
    دالة تهيئة(رقم عدد_الصفحات)
        عدد_الصفحات_الإجمالي = عدد_الصفحات
        الحالات = []
        متغير ف = 0
        بينما (ف < عدد_الصفحات)
            الحالات += [0]
            ف = ف + 1
        نهاية
        اطبع("  خريطة البت: ")
        اطبع(عدد_الصفحات)
        اطبع_سطر(" صفحة")
    نهاية

    # تعيين (تخصيص)
    دالة عيّن(رقم فهرس_الصفحة)
        اذا (فهرس_الصفحة >= عدد_الصفحات_الإجمالي)
            ارجع 0
        نهاية
        اذا (فهرس_الصفحة < 0)
            ارجع 0
        نهاية
        الحالات[فهرس_الصفحة] = 1
    نهاية

    # مسح (تحرير)
    دالة امسح(رقم فهرس_الصفحة)
        اذا (فهرس_الصفحة >= عدد_الصفحات_الإجمالي)
            ارجع 0
        نهاية
        اذا (فهرس_الصفحة < 0)
            ارجع 0
        نهاية
        الحالات[فهرس_الصفحة] = 0
    نهاية

    # تحقق
    دالة منطقي مُعيّن(رقم فهرس_الصفحة)
        اذا (فهرس_الصفحة >= عدد_الصفحات_الإجمالي)
            ارجع صحيح
        نهاية
        اذا (فهرس_الصفحة < 0)
            ارجع صحيح
        نهاية
        ارجع الحالات[فهرس_الصفحة] == 1
    نهاية

    # أول صفحة حرة
    دالة رقم أول_حرة()
        متغير ف = 0
        بينما (ف < عدد_الصفحات_الإجمالي)
            اذا (الحالات[ف] == 0)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    # بحث متجاور
    دالة رقم ابحث_متجاورة(رقم عدد_مطلوب)
        متغير بداية_سلسلة = 0
        متغير متجاور = 0
        متغير ف = 0
        بينما (ف < عدد_الصفحات_الإجمالي)
            اذا (الحالات[ف] == 0)
                اذا (متجاور == 0)
                    بداية_سلسلة = ف
                نهاية
                متجاور = متجاور + 1
                اذا (متجاور >= عدد_مطلوب)
                    ارجع بداية_سلسلة
                نهاية
            والا
                متجاور = 0
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    # عدد الحرة
    دالة رقم عدد_حرة()
        متغير مجموع = 0
        متغير ف = 0
        بينما (ف < عدد_الصفحات_الإجمالي)
            اذا (الحالات[ف] == 0)
                مجموع = مجموع + 1
            نهاية
            ف = ف + 1
        نهاية
        ارجع مجموع
    نهاية

    # تعيين نطاق
    دالة عيّن_نطاق(رقم البداية، رقم العد)
        متغير ف = 0
        بينما (ف < العد)
            عيّن(البداية + ف)
            ف = ف + 1
        نهاية
    نهاية

    # مسح نطاق
    دالة امسح_نطاق(رقم البداية، رقم العد)
        متغير ف = 0
        بينما (ف < العد)
            امسح(البداية + ف)
            ف = ف + 1
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#               صنف مرجعية الصفحات (Reference Count)
# ══════════════════════════════════════════════════════════════════════════════

صنف مرجعية_الصفحات
    ## يتتبع عدد المراجع لكل صفحة فعلية
    ## يُستخدم لدعم COW (Copy-on-Write) ومشاركة الذاكرة

    مصفوفة العدّادات              # عدّاد لكل صفحة
    رقم عدد_الصفحات_الإجمالي

    باني()
        العدّادات = []
        عدد_الصفحات_الإجمالي = 0
    نهاية

    # تهيئة
    دالة تهيئة(رقم عدد_الصفحات)
        عدد_الصفحات_الإجمالي = عدد_الصفحات
        العدّادات = []
        متغير ف = 0
        بينما (ف < عدد_الصفحات)
            العدّادات += [0]
            ف = ف + 1
        نهاية
    نهاية

    # زيادة المرجع
    دالة رقم أضف_مرجع(رقم فهرس_الصفحة)
        اذا (فهرس_الصفحة >= عدد_الصفحات_الإجمالي)
            ارجع -1
        نهاية
        العدّادات[فهرس_الصفحة] = العدّادات[فهرس_الصفحة] + 1
        ارجع العدّادات[فهرس_الصفحة]
    نهاية

    # إنقاص المرجع
    دالة رقم أنقص_مرجع(رقم فهرس_الصفحة)
        اذا (فهرس_الصفحة >= عدد_الصفحات_الإجمالي)
            ارجع -1
        نهاية
        اذا (العدّادات[فهرس_الصفحة] > 0)
            العدّادات[فهرس_الصفحة] = العدّادات[فهرس_الصفحة] - 1
        نهاية
        ارجع العدّادات[فهرس_الصفحة]
    نهاية

    # قراءة المرجع
    دالة رقم اقرأ(رقم فهرس_الصفحة)
        اذا (فهرس_الصفحة >= عدد_الصفحات_الإجمالي)
            ارجع 0
        نهاية
        ارجع العدّادات[فهرس_الصفحة]
    نهاية

    # هل الصفحة مشتركة؟ (مرجعية > 1)
    دالة منطقي مشتركة(رقم فهرس_الصفحة)
        ارجع اقرأ(فهرس_الصفحة) > 1
    نهاية

    # هل الصفحة قابلة للتحرير؟ (مرجعية = 0)
    دالة منطقي قابلة_للتحرير(رقم فهرس_الصفحة)
        ارجع اقرأ(فهرس_الصفحة) == 0
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#               صنف عقدة القائمة المرتبطة
# ══════════════════════════════════════════════════════════════════════════════

صنف عقدة_ذاكرة
    ## عقدة في قائمة مرتبطة مزدوجة لتتبع الكتل الحرة

    رقم العنوان
    رقم الحجم_بالصفحات
    رقم فهرس_التالية         # -1 = لا يوجد
    رقم فهرس_السابقة         # -1 = لا يوجد

    باني(رقم عنوان، رقم مقاس_ع)
        العنوان = عنوان
        الحجم_بالصفحات = مقاس_ع
        فهرس_التالية = -1
        فهرس_السابقة = -1
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#               صنف القائمة المرتبطة المزدوجة
# ══════════════════════════════════════════════════════════════════════════════

صنف قائمة_الكتل
    ## قائمة مرتبطة مزدوجة حقيقية للكتل الحرة

    مصفوفة العقد
    رقم فهرس_الرأس            # -1 = فارغة
    رقم عدد_العناصر

    باني()
        العقد = []
        فهرس_الرأس = -1
        عدد_العناصر = 0
    نهاية

    # إضافة كتلة في المقدمة
    دالة أضف(رقم العنوان، رقم الحجم)
        متغير عقدة = جديد عقدة_ذاكرة(العنوان، الحجم)
        متغير فهرس_جديد = طول(العقد)

        اذا (فهرس_الرأس >= 0)
            عقدة.فهرس_التالية = فهرس_الرأس
            العقد[فهرس_الرأس].فهرس_السابقة = فهرس_جديد
        نهاية

        العقد += [عقدة]
        فهرس_الرأس = فهرس_جديد
        عدد_العناصر = عدد_العناصر + 1
    نهاية

    # انتزاع أول كتلة
    دالة رقم انتزع()
        اذا (فهرس_الرأس < 0)
            ارجع -1
        نهاية

        متغير العنوان = العقد[فهرس_الرأس].العنوان
        متغير تالي = العقد[فهرس_الرأس].فهرس_التالية

        اذا (تالي >= 0)
            العقد[تالي].فهرس_السابقة = -1
        نهاية

        فهرس_الرأس = تالي
        عدد_العناصر = عدد_العناصر - 1
        ارجع العنوان
    نهاية

    # البحث عن كتلة بعنوان
    دالة رقم ابحث(رقم العنوان)
        متغير فهرس = فهرس_الرأس
        بينما (فهرس >= 0)
            اذا (العقد[فهرس].العنوان == العنوان)
                ارجع فهرس
            نهاية
            فهرس = العقد[فهرس].فهرس_التالية
        نهاية
        ارجع -1
    نهاية

    # حذف كتلة بعنوان
    دالة منطقي احذف(رقم العنوان)
        متغير فهرس = ابحث(العنوان)
        اذا (فهرس < 0)
            ارجع خطأ
        نهاية

        متغير سابق = العقد[فهرس].فهرس_السابقة
        متغير تالي = العقد[فهرس].فهرس_التالية

        اذا (سابق >= 0)
            العقد[سابق].فهرس_التالية = تالي
        والا
            فهرس_الرأس = تالي
        نهاية

        اذا (تالي >= 0)
            العقد[تالي].فهرس_السابقة = سابق
        نهاية

        عدد_العناصر = عدد_العناصر - 1
        ارجع صحيح
    نهاية

    # هل فارغة؟
    دالة منطقي فارغة()
        ارجع فهرس_الرأس < 0
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#               صنف منطقة NUMA
# ══════════════════════════════════════════════════════════════════════════════

صنف منطقة_NUMA
    ## تمثل منطقة ذاكرة في عقدة NUMA

    رقم المعرّف_م
    نص الاسم_م
    رقم العنوان_البداية
    رقم العنوان_النهاية
    رقم إجمالي_الصفحات_م
    رقم صفحات_حرة_م
    رقم صفحات_مشغولة_م

    # القوائم الحرة لكل رتبة
    مصفوفة قوائم_الرتب

    # العلامات المائية
    رقم علامة_عليا_م
    رقم علامة_وسطى_م
    رقم علامة_دنيا_م

    باني(رقم معرّف، نص اسم، رقم عنوان_أول، رقم عنوان_آخر)
        المعرّف_م = معرّف
        الاسم_م = اسم
        العنوان_البداية = عنوان_أول
        العنوان_النهاية = عنوان_آخر
        إجمالي_الصفحات_م = (عنوان_آخر - عنوان_أول) / ذ_حجم_الصفحة
        صفحات_حرة_م = إجمالي_الصفحات_م
        صفحات_مشغولة_م = 0

        # تهيئة القوائم
        قوائم_الرتب = []
        متغير ف = 0
        بينما (ف < ذ_أقصى_طبقة)
            قوائم_الرتب += [جديد قائمة_الكتل()]
            ف = ف + 1
        نهاية

        # حساب العلامات المائية
        علامة_عليا_م = (إجمالي_الصفحات_م * علامة_عُليا_نسبة) / 100
        علامة_وسطى_م = (إجمالي_الصفحات_م * علامة_وُسطى_نسبة) / 100
        علامة_دنيا_م = (إجمالي_الصفحات_م * علامة_دُنيا_نسبة) / 100
    نهاية

    # مستوى ضغط الذاكرة
    دالة رقم مستوى_الضغط()
        اذا (صفحات_حرة_م >= علامة_عليا_م)
            ارجع ضغط_لا_يوجد
        والا_اذا (صفحات_حرة_م >= علامة_وسطى_م)
            ارجع ضغط_منخفض
        والا_اذا (صفحات_حرة_م >= علامة_دنيا_م)
            ارجع ضغط_متوسط
        نهاية
        ارجع ضغط_حرج
    نهاية

    # هل يمكن التخصيص؟
    دالة منطقي يمكن_التخصيص(رقم عدد_مطلوب)
        ارجع صفحات_حرة_م >= عدد_مطلوب
    نهاية

    # تخصيص من هذه المنطقة
    دالة رقم خصص(رقم عدد_مطلوب)
        اذا (يمكن_التخصيص(عدد_مطلوب) == خطأ)
            ارجع -1
        نهاية

        # إيجاد الرتبة المناسبة
        متغير الرتبة = 0
        متغير القدرة = 1
        بينما (القدرة < عدد_مطلوب)
            القدرة = القدرة * 2
            الرتبة = الرتبة + 1
        نهاية

        اذا (الرتبة >= ذ_أقصى_طبقة)
            ارجع -1
        نهاية

        # البحث في الرتبة المناسبة أو أعلى
        متغير رتبة_البحث = الرتبة
        بينما (رتبة_البحث < ذ_أقصى_طبقة)
            اذا (قوائم_الرتب[رتبة_البحث].فارغة() == خطأ)
                # وُجدت كتلة
                متغير العنوان = قوائم_الرتب[رتبة_البحث].انتزع()

                # تقسيم إن كانت أكبر
                بينما (رتبة_البحث > الرتبة)
                    رتبة_البحث = رتبة_البحث - 1
                    متغير حجم_قوة = 1
                    متغير ت = 0
                    بينما (ت < رتبة_البحث)
                        حجم_قوة = حجم_قوة * 2
                        ت = ت + 1
                    نهاية
                    قوائم_الرتب[رتبة_البحث].أضف(العنوان + حجم_قوة * ذ_حجم_الصفحة، حجم_قوة)
                نهاية

                # تحديث الإحصاءات
                متغير حجم_مخصص = 1
                متغير ت2 = 0
                بينما (ت2 < الرتبة)
                    حجم_مخصص = حجم_مخصص * 2
                    ت2 = ت2 + 1
                نهاية
                صفحات_حرة_م = صفحات_حرة_م - حجم_مخصص
                صفحات_مشغولة_م = صفحات_مشغولة_م + حجم_مخصص

                ارجع العنوان
            نهاية
            رتبة_البحث = رتبة_البحث + 1
        نهاية
        ارجع -1
    نهاية

    # تحرير
    دالة حرّر(رقم العنوان، رقم عدد_صفحات)
        متغير الرتبة = 0
        متغير القدرة = 1
        بينما (القدرة < عدد_صفحات)
            القدرة = القدرة * 2
            الرتبة = الرتبة + 1
        نهاية
        قوائم_الرتب[الرتبة].أضف(العنوان، عدد_صفحات)
        صفحات_حرة_م = صفحات_حرة_م + عدد_صفحات
        صفحات_مشغولة_م = صفحات_مشغولة_م - عدد_صفحات
    نهاية

    # طباعة حالة المنطقة
    دالة اطبع_حالة()
        اطبع("  منطقة [")
        اطبع(الاسم_م)
        اطبع("] صفحات=")
        اطبع(إجمالي_الصفحات_م)
        اطبع(" حرة=")
        اطبع(صفحات_حرة_م)
        اطبع(" ضغط=")
        متغير ض = مستوى_الضغط()
        اذا (ض == ضغط_لا_يوجد)
            اطبع("لا يوجد")
        والا_اذا (ض == ضغط_منخفض)
            اطبع("منخفض")
        والا_اذا (ض == ضغط_متوسط)
            اطبع("متوسط")
        والا
            اطبع("حرج!")
        نهاية
        اطبع_سطر("")
    نهاية
نهاية


