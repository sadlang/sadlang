# ─────────────────────────────────────────────────────────────────────────────
# صنف اللون
# يتعامل مع ألوان ARGB بشكل تام
# ─────────────────────────────────────────────────────────────────────────────
صنف لون
    ## الوصف: يمثّل لون ARGB بمرونة كاملة وعمليات خلط وتعديل

    رقم أحمر     # 0-255
    رقم أخضر     # 0-255
    رقم أزرق     # 0-255
    رقم ألفا      # 0-255 (0=شفاف, 255=مكتمل)

    باني(رقم أ، رقم خ، رقم ز، رقم ال)
        أحمر = أ
        أخضر = خ
        أزرق = ز
        ألفا = ال
    نهاية

    ## إنشاء لون من قيمة ARGB 32-بت
    دالة من_ARGB32(رقم قيمة)
        متغير الألفا = قيمة / 16777216
        متغير المتبقي1 = قيمة - (الألفا * 16777216)
        متغير الأحمر = المتبقي1 / 65536
        متغير المتبقي2 = المتبقي1 - (الأحمر * 65536)
        متغير الأخضر = المتبقي2 / 256
        متغير الأزرق = المتبقي2 - (الأخضر * 256)
        ارجع جديد لون(الأحمر، الأخضر، الأزرق، الألفا)
    نهاية

    ## تحويل إلى قيمة ARGB 32-بت
    دالة رقم إلى_ARGB32()
        ارجع (ألفا * 16777216) + (أحمر * 65536) + (أخضر * 256) + أزرق
    نهاية

    ## خلط لون مع لون آخر بناءً على الشفافية (Alpha Blending)
    ## معادلة Porter-Duff:
    ## Cout = Cs × αs + Cd × αd × (1 - αs)
    دالة خلط_مع(لون_تحت)
        اذا (ألفا == 255)
            ارجع هذا    # مكتمل - لا حاجة للخلط
        نهاية
        اذا (ألفا == 0)
            ارجع لون_تحت  # شفاف تماماً
        نهاية

        # حساب الوزن (0-255 → 0.0-1.0)
        متغير وزن = ألفا
        متغير وزن_معاكس = 255 - وزن

        متغير أحمر_مخلوط = ((أحمر * وزن) + (لون_تحت.أحمر * وزن_معاكس)) / 255
        متغير أخضر_مخلوط = ((أخضر * وزن) + (لون_تحت.أخضر * وزن_معاكس)) / 255
        متغير أزرق_مخلوط = ((أزرق * وزن) + (لون_تحت.أزرق * وزن_معاكس)) / 255
        متغير ألفا_مخلوط = 255

        ارجع جديد لون(أحمر_مخلوط، أخضر_مخلوط، أزرق_مخلوط، ألفا_مخلوط)
    نهاية

    ## تفتيح اللون بنسبة (0-100%)
    دالة تفتيح(رقم النسبة)
        متغير مُعدِّل = النسبة * 255 / 100
        متغير أ = أحمر + ((255 - أحمر) * مُعدِّل / 255)
        متغير خ = أخضر + ((255 - أخضر) * مُعدِّل / 255)
        متغير ز = أزرق + ((255 - أزرق) * مُعدِّل / 255)
        ارجع جديد لون(أ، خ، ز، ألفا)
    نهاية

    ## تغميق اللون بنسبة (0-100%)
    دالة تغميق(رقم النسبة)
        متغير مُعدِّل = النسبة * 255 / 100
        متغير أ = أحمر - (أحمر * مُعدِّل / 255)
        متغير خ = أخضر - (أخضر * مُعدِّل / 255)
        متغير ز = أزرق - (أزرق * مُعدِّل / 255)
        ارجع جديد لون(أ، خ، ز، ألفا)
    نهاية

    ## تعيين الشفافية
    دالة بشفافية(رقم قيمة_ألفا)
        ارجع جديد لون(أحمر، أخضر، أزرق، قيمة_ألفا)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف نقطة
# يمثل خاصية (x,y) في مساحة الشاشة
# ─────────────────────────────────────────────────────────────────────────────
صنف نقطة
    رقم س   # الإحداثي الأفقي (يزداد يميناً)
    رقم ص   # الإحداثي الرأسي (يزداد للأسفل)

    باني(رقم س_أولي، رقم ص_أولي)
        س = س_أولي
        ص = ص_أولي
    نهاية

    ## حساب المسافة لنقطة أخرى
    دالة مسافة(نقطة_ثانية)
        متغير فرق_س = س - نقطة_ثانية.س
        متغير فرق_ص = ص - نقطة_ثانية.ص
        اذا (فرق_س < 0)
            فرق_س = 0 - فرق_س
        نهاية
        اذا (فرق_ص < 0)
            فرق_ص = 0 - فرق_ص
        نهاية
        ارجع فرق_س + فرق_ص    # تقريبي (مانهاتن)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف المستطيل
# ─────────────────────────────────────────────────────────────────────────────
صنف مستطيل
    رقم س        # إحداثي اليسار
    رقم ص        # إحداثي الأعلى
    رقم العرض   # العرض
    رقم الارتفاع # الارتفاع

    باني(رقم س0، رقم ص0، رقم ع، رقم ار)
        س = س0
        ص = ص0
        العرض = ع
        الارتفاع = ار
    نهاية

    دالة رقم اليمين()   ارجع س + العرض   نهاية
    دالة رقم الأسفل()   ارجع ص + الارتفاع نهاية

    ## هل النقطة داخل المستطيل؟
    دالة منطقي يحتوي_نقطة(رقم نقطة_س، رقم نقطة_ص)
        ارجع نقطة_س >= س && نقطة_س < اليمين() && نقطة_ص >= ص && نقطة_ص < الأسفل()
    نهاية

    ## هل مستطيل آخر يتقاطع معه؟
    دالة منطقي يتقاطع_مع(آخر)
        ارجع ليس (آخر.س >= اليمين() || آخر.اليمين() <= س || آخر.ص >= الأسفل() || آخر.الأسفل() <= ص)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف الإطار المؤقت - الفريم بافر
# التجريد الأساسي للتفاعل مع ذاكرة الشاشة
# ─────────────────────────────────────────────────────────────────────────────
صنف إطار_مؤقت
    ## الوصف: يمثّل ذاكرة الشاشة المباشرة (Framebuffer)
    ## هو التجريد الأدنى مستوى لعرض الرسوميات

    رقم العنوان_الفعلي    # عنوان ذاكرة الFramebuffer (من Limine)
    رقم العرض             # عرض الشاشة بالبكسل
    رقم الارتفاع          # ارتفاع الشاشة بالبكسل
    رقم الخطوة            # بايتات لكل صف (قد تكون أكبر من العرض × 4)
    رقم بتات_البكسل        # عمق الألوان (32 بت ARGB)
    رقم إجمالي_البكسلات   # العرض × الارتفاع

    باني(رقم عنوان، رقم ع، رقم ار، رقم خطوة، رقم بتات)
        العنوان_الفعلي = عنوان
        العرض = ع
        الارتفاع = ار
        الخطوة = خطوة
        بتات_البكسل = بتات
        إجمالي_البكسلات = ع * ار
    نهاية

    ## حساب موضع بكسل (س,ص) في الذاكرة
    دالة رقم موضع_البكسل(رقم س، رقم ص)
        ارجع العنوان_الفعلي + (ص * الخطوة) + (س * بايتات_البكسل)
    نهاية

    ## طباعة معلومات الإطار
    دالة طباعة_المعلومات()
        اطبع("  🖥 الشاشة: ")
        اطبع(العرض)
        اطبع(" × ")
        اطبع(الارتفاع)
        اطبع(" × ")
        اطبع(بتات_البكسل)
        اطبع_سطر(" بت")
        اطبع("  العنوان: 0x")
        اطبع_سطر(العنوان_الفعلي)
        اطبع("  الخطوة: ")
        اطبع_سطر(الخطوة)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الصنف الرئيسي: محرك الرسوميات عالي الدقة
# ─────────────────────────────────────────────────────────────────────────────
صنف محرك_الرسوميات_HD
    ## الوصف الكامل:
    ## ══════════════
    ## محرك الرسوميات الرئيسي لنظام النحلة.
    ## يوفر طبقة عالية المستوى فوق الFramebuffer الخام.
    ## يُنفّذ كل عمليات الرسم مع دعم الشفافية والتحريك.

    رقم الإطار_الأمامي     # الشاشة الفعلية (كائن إطار_مؤقت)
    مصفوفة المخزن_الخلفي         # مخزن ثانٍ للرسم بدون وميض
    رقم العرض
    رقم الارتفاع
    رقم حالة_التهيئة
    رقم معدل_الإطارات           # الإطارات في الثانية المستهدفة

    باني()
        العرض = 0
        الارتفاع = 0
        حالة_التهيئة = 0
        معدل_الإطارات = 60
        المخزن_الخلفي = []
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تهيئة المحرك من معلومات Limine
    ## ══════════════════════════════════════════════════════════════════════
    دالة رقم تهيئة(رقم عنوان_الإطار، رقم العرض_المطلوب، رقم الارتفاع_المطلوب، رقم الخطوة)
        اطبع_سطر("🎨 محرك الرسوميات HD: بدء التهيئة...")

        العرض = العرض_المطلوب
        الارتفاع = الارتفاع_المطلوب

        # إنشاء كائن الإطار المؤقت
        الإطار_الأمامي = جديد إطار_مؤقت(عنوان_الإطار، العرض، الارتفاع، الخطوة، 32)
        الإطار_الأمامي.طباعة_المعلومات()

        # تهيئة المخزن الخلفي (نفس حجم الشاشة)
        متغير حجم_المخزن = العرض * الارتفاع
        المخزن_الخلفي = []

        # ملء المخزن بالأسود (سيُملأ لاحقاً بالخلفية الفعلية)
        متغير عداد = 0
        بينما (عداد < حجم_المخزن)
            المخزن_الخلفي += [لون_أسود]
            عداد = عداد + 1
        نهاية

        حالة_التهيئة = 1
        اطبع("✅ محرك الرسوميات HD: جاهز - ")
        اطبع(العرض)
        اطبع(" × ")
        اطبع_سطر(الارتفاع)
        ارجع 1
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم بكسل واحد (أسرع دالة)
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_بكسل(رقم س، رقم ص، رقم قيمة_اللون)
        اذا (س < 0 || س >= العرض)   ارجع 0   نهاية
        اذا (ص < 0 || ص >= الارتفاع) ارجع 0   نهاية

        متغير فهرس = ص * العرض + س
        المخزن_الخلفي[فهرس] = قيمة_اللون
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم بكسل بشفافية (Alpha Blending)
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_بكسل_مع_شفافية(رقم س، رقم ص، لون_الرسم)
        اذا (س < 0 || س >= العرض)   ارجع 0   نهاية
        اذا (ص < 0 || ص >= الارتفاع) ارجع 0   نهاية
        اذا (لون_الرسم.ألفا == 0)     ارجع 0   نهاية

        متغير فهرس = ص * العرض + س

        اذا (لون_الرسم.ألفا == 255)
            # لا حاجة للخلط - غير شفاف
            المخزن_الخلفي[فهرس] = لون_الرسم.إلى_ARGB32()
            ارجع 0
        نهاية

        # قراءة اللون الحالي وخلطه
        متغير لون_حالي = لون.من_ARGB32(المخزن_الخلفي[فهرس])
        متغير لون_مخلوط = لون_الرسم.خلط_مع(لون_حالي)
        المخزن_الخلفي[فهرس] = لون_مخلوط.إلى_ARGB32()
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## ملء الشاشة بلون واحد
    ## ══════════════════════════════════════════════════════════════════════
    دالة امسح_الشاشة(رقم لون_الخلفية)
        متغير إجمالي = العرض * الارتفاع
        متغير عداد = 0
        بينما (عداد < إجمالي)
            المخزن_الخلفي[عداد] = لون_الخلفية
            عداد = عداد + 1
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم مستطيل مملوء
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_مستطيل(رقم س، رقم ص، رقم عرض_م، رقم ارتفاع_م، رقم اللون)
        متغير صف = ص
        بينما (صف < ص + ارتفاع_م)
            متغير عمود = س
            بينما (عمود < س + عرض_م)
                ارسم_بكسل(عمود، صف، اللون)
                عمود = عمود + 1
            نهاية
            صف = صف + 1
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم مستطيل بإطار (Border)
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_إطار(رقم س، رقم ص، رقم عرض_م، رقم ارتفاع_م، رقم سماكة، رقم اللون)
        # الحافة العلوية
        ارسم_مستطيل(س، ص، عرض_م، سماكة، اللون)
        # الحافة السفلية
        ارسم_مستطيل(س، ص + ارتفاع_م - سماكة، عرض_م، سماكة، اللون)
        # الحافة اليسرى
        ارسم_مستطيل(س، ص، سماكة، ارتفاع_م، اللون)
        # الحافة اليمنى
        ارسم_مستطيل(س + عرض_م - سماكة، ص، سماكة، ارتفاع_م، اللون)
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم مستطيل بزوايا مدوّرة (Rounded Rectangle)
    ## المستخدم في نوافذ النظام - ميزة فائقة لسطح المكتب
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_مستطيل_مدوّر(رقم س، رقم ص، رقم عرض_م، رقم ارتفاع_م، رقم نصف_القطر، رقم اللون)
        # رسم الجسم الرئيسي (3 مستطيلات تغطي الوسط والأجناب)
        ارسم_مستطيل(س + نصف_القطر، ص، عرض_م - (2 * نصف_القطر)، ارتفاع_م، اللون)
        ارسم_مستطيل(س، ص + نصف_القطر، نصف_القطر، ارتفاع_م - (2 * نصف_القطر)، اللون)
        ارسم_مستطيل(س + عرض_م - نصف_القطر، ص + نصف_القطر، نصف_القطر، ارتفاع_م - (2 * نصف_القطر)، اللون)

        # رسم الزوايا المدوّرة (ربع دائرة في كل زاوية)
        ارسم_ربع_دائرة(س + نصف_القطر، ص + نصف_القطر، نصف_القطر، 0، اللون)
        ارسم_ربع_دائرة(س + عرض_م - نصف_القطر - 1، ص + نصف_القطر، نصف_القطر، 1، اللون)
        ارسم_ربع_دائرة(س + نصف_القطر، ص + ارتفاع_م - نصف_القطر - 1، نصف_القطر، 2، اللون)
        ارسم_ربع_دائرة(س + عرض_م - نصف_القطر - 1، ص + ارتفاع_م - نصف_القطر - 1، نصف_القطر، 3، اللون)
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم ربع دائرة في زاوية معينة (مساعدة لـ ارسم_مستطيل_مدوّر)
    ## الربع: 0=أعلى يسار 1=أعلى يمين 2=أسفل يسار 3=أسفل يمين
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_ربع_دائرة(رقم مركز_س، رقم مركز_ص، رقم نصف_القطر، رقم الربع، رقم اللون)
        متغير ص_حالي = 0
        بينما (ص_حالي <= نصف_القطر)
            # حساب عرض الصف بالتربيع التقريبي
            # ‫نستخدم نقاط دائرة: s² + y² ≤ r²
            متغير س_حالي = 0
            بينما (س_حالي <= نصف_القطر)
                متغير مربع_المسافة = (س_حالي * س_حالي) + (ص_حالي * ص_حالي)
                متغير مربع_القطر = نصف_القطر * نصف_القطر

                اذا (مربع_المسافة <= مربع_القطر)
                    # النقطة داخل الدائرة
                    اذا (الربع == 0)  # أعلى يسار
                        ارسم_بكسل(مركز_س - س_حالي، مركز_ص - ص_حالي، اللون)
                    نهاية
                    اذا (الربع == 1)  # أعلى يمين
                        ارسم_بكسل(مركز_س + س_حالي، مركز_ص - ص_حالي، اللون)
                    نهاية
                    اذا (الربع == 2)  # أسفل يسار
                        ارسم_بكسل(مركز_س - س_حالي، مركز_ص + ص_حالي، اللون)
                    نهاية
                    اذا (الربع == 3)  # أسفل يمين
                        ارسم_بكسل(مركز_س + س_حالي، مركز_ص + ص_حالي، اللون)
                    نهاية
                نهاية
                س_حالي = س_حالي + 1
            نهاية
            ص_حالي = ص_حالي + 1
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم دائرة مملوءة
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_دائرة(رقم مركز_س، رقم مركز_ص، رقم نصف_القطر، رقم اللون)
        متغير ص = 0 - نصف_القطر
        بينما (ص <= نصف_القطر)
            متغير س = 0 - نصف_القطر
            بينما (س <= نصف_القطر)
                اذا (س * س + ص * ص <= نصف_القطر * نصف_القطر)
                    ارسم_بكسل(مركز_س + س، مركز_ص + ص، اللون)
                نهاية
                س = س + 1
            نهاية
            ص = ص + 1
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم خط مستقيم (خوارزمية Bresenham)
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_خط(رقم س1، رقم ص1، رقم س2، رقم ص2، رقم اللون)
        متغير فرق_س = س2 - س1
        متغير فرق_ص = ص2 - ص1
        اذا (فرق_س < 0)
            فرق_س = 0 - فرق_س
        نهاية
        اذا (فرق_ص < 0)
            فرق_ص = 0 - فرق_ص
        نهاية

        متغير خطوة_س = 1
        اذا (س1 > س2)
            خطوة_س = -1
        نهاية
        متغير خطوة_ص = 1
        اذا (ص1 > ص2)
            خطوة_ص = -1
        نهاية

        متغير انحراف = فرق_س - فرق_ص
        متغير س_حالي = س1
        متغير ص_حالي = ص1

        بينما (صحيح)
            ارسم_بكسل(س_حالي، ص_حالي، اللون)

            اذا (س_حالي == س2 && ص_حالي == ص2)
                اخرج
            نهاية

            متغير انحراف2 = انحراف * 2

            اذا (انحراف2 > 0 - فرق_ص)
                انحراف = انحراف - فرق_ص
                س_حالي = س_حالي + خطوة_س
            نهاية

            اذا (انحراف2 < فرق_س)
                انحراف = انحراف + فرق_س
                ص_حالي = ص_حالي + خطوة_ص
            نهاية
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم تدرج أفقي (Horizontal Gradient)
    ## يُستخدم لخلفيات النوافذ وأشرطة العنوان
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_تدرج_أفقي(رقم س، رقم ص، رقم عرض_م، رقم ارتفاع_م، لون_يسار، لون_يمين)
        متغير صف_ص = ص
        بينما (صف_ص < ص + ارتفاع_م)
            متغير عمود_س = س
            بينما (عمود_س < س + عرض_م)
                # احسب نسبة الموضع (0-255)
                متغير نسبة = ((عمود_س - س) * 255) / عرض_م

                # خلط اللونين
                متغير أحمر = ((لون_يسار.أحمر * (255 - نسبة)) + (لون_يمين.أحمر * نسبة)) / 255
                متغير أخضر = ((لون_يسار.أخضر * (255 - نسبة)) + (لون_يمين.أخضر * نسبة)) / 255
                متغير أزرق = ((لون_يسار.أزرق * (255 - نسبة)) + (لون_يمين.أزرق * نسبة)) / 255

                متغير لون_البكسل = (255 * 16777216) + (أحمر * 65536) + (أخضر * 256) + أزرق
                ارسم_بكسل(عمود_س، صف_ص، لون_البكسل)
                عمود_س = عمود_س + 1
            نهاية
            صف_ص = صف_ص + 1
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## رسم تدرج رأسي (Vertical Gradient)
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_تدرج_رأسي(رقم س، رقم ص، رقم عرض_م، رقم ارتفاع_م، لون_أعلى، لون_أسفل)
        متغير صف_ص = ص
        بينما (صف_ص < ص + ارتفاع_م)
            متغير نسبة = ((صف_ص - ص) * 255) / ارتفاع_م

            متغير أحمر = ((لون_أعلى.أحمر * (255 - نسبة)) + (لون_أسفل.أحمر * نسبة)) / 255
            متغير أخضر = ((لون_أعلى.أخضر * (255 - نسبة)) + (لون_أسفل.أخضر * نسبة)) / 255
            متغير أزرق = ((لون_أعلى.أزرق * (255 - نسبة)) + (لون_أسفل.أزرق * نسبة)) / 255

            متغير لون_صف = (255 * 16777216) + (أحمر * 65536) + (أخضر * 256) + أزرق

            ارسم_مستطيل(س، صف_ص، عرض_م، 1، لون_صف)
            صف_ص = صف_ص + 1
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تأثير الظل (Box Shadow)
    ## يُضيف ظلاً ناعماً أسفل النوافذ
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_ظل(رقم س، رقم ص، رقم عرض_م، رقم ارتفاع_م، رقم نصف_قطر_ظل)
        # طبقات متعددة من الظل بشفافية متناقصة
        متغير طبقة = نصف_قطر_ظل
        بينما (طبقة > 0)
            متغير شفافية = طبقة * 20    # كل طبقة أقل غتامة
            اذا (شفافية > 200)
                شفافية = 200
            نهاية
            متغير لون_الظل = شفافية * 16777216  # أسود بشفافية

            ارسم_مستطيل_مدوّر(
                س + طبقة،
                ص + طبقة،
                عرض_م,
                ارتفاع_م،
                8،
                لون_الظل
            )
            طبقة = طبقة - 1
        نهاية
    نهاية

