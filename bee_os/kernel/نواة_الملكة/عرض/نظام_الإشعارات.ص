# ══════════════════════════════════════════════════════════════════════════════
# نظام_الإشعارات.ص - نظام إشعارات خلية النحل
# BeeOS Notification System - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

# ألوان
متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296

# أنواع الإشعارات
متغير نوع_معلومات = 0
متغير نوع_تحذير   = 1
متغير نوع_خطأ     = 2
متغير نوع_نجاح    = 3
متغير نوع_رسالة   = 4

# ──────────────────────────────────────────────────────────────────
# صنف إشعار
# ──────────────────────────────────────────────────────────────────
صنف إشعار
    نص عنوان
    نص محتوى
    نص مصدر
    رقم نوع
    رقم مقروء
    رقم وقت
    رقم عرض_إشعار
    رقم ارتفاع_إشعار
    رقم شفافية

    باني(ع، م، مص، ن، وق)
        هذا.عنوان = ع
        هذا.محتوى = م
        هذا.مصدر = مص
        هذا.نوع = ن
        هذا.مقروء = 0
        هذا.وقت = وق
        هذا.عرض_إشعار = 350
        هذا.ارتفاع_إشعار = 80
        هذا.شفافية = 100
    نهاية

    دالة لون_نوع()
        اذا (هذا.نوع == نوع_معلومات)
            ارجع ل_أزرق_غ
        نهاية
        اذا (هذا.نوع == نوع_تحذير)
            ارجع ل_برتقالي
        نهاية
        اذا (هذا.نوع == نوع_خطأ)
            ارجع ل_أحمر
        نهاية
        اذا (هذا.نوع == نوع_نجاح)
            ارجع ل_أخضر
        نهاية
        اذا (هذا.نوع == نوع_رسالة)
            ارجع ل_أصفر
        نهاية
        ارجع ل_رمادي
    نهاية

    دالة رمز_نوع()
        اذا (هذا.نوع == نوع_معلومات)
            ارجع "i"
        نهاية
        اذا (هذا.نوع == نوع_تحذير)
            ارجع "!"
        نهاية
        اذا (هذا.نوع == نوع_خطأ)
            ارجع "X"
        نهاية
        اذا (هذا.نوع == نوع_نجاح)
            ارجع "OK"
        نهاية
        اذا (هذا.نوع == نوع_رسالة)
            ارجع "@"
        نهاية
        ارجع "?"
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# صنف نظام الإشعارات
# ──────────────────────────────────────────────────────────────────
صنف نظام_إشعارات
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    مصفوفة إشعارات_حية
    مصفوفة إشعارات_سجل
    رقم لوحة_مفتوحة

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.إشعارات_حية = []
        هذا.إشعارات_سجل = []
        هذا.لوحة_مفتوحة = 0
    نهاية

    دالة أضف_إشعار(عنوان، محتوى، مصدر، نوع، وقت)
        متغير إش = جديد إشعار(عنوان، محتوى، مصدر، نوع، وقت)
        هذا.إشعارات_حية = هذا.إشعارات_حية + [إش]
        هذا.إشعارات_سجل = هذا.إشعارات_سجل + [إش]
        ارجع 1
    نهاية

    # رسم إشعار منبثق واحد
    دالة رسم_إشعار_منبثق(ف، إش، y_موضع)
        متغير ew = إش.عرض_إشعار
        متغير eh = إش.ارتفاع_إشعار
        متغير ex = عرض_شاشة - ew - 20
        متغير ey = y_موضع

        # خلفية الإشعار
        متغير لون_خلف = امزج_لون(ل_أسود، ل_أزرق_غ، 40)
        ارسم_مستطيل_أصلي(ف، ex، ey، ew، eh، لون_خلف)

        # شريط اللون الجانبي
        متغير لون_ن = إش.لون_نوع()
        ارسم_مستطيل_أصلي(ف، ex، ey، 4، eh، لون_ن)

        # إطار
        ارسم_إطار_أصلي(ف، ex، ey، ew، eh، 1، ل_رمادي_غ)

        # أيقونة النوع
        ارسم_دائرة_مصمتة(ف، ex + 25، ey + 25، 12، لون_ن)
        ارسم_نص_أصلي(ف، ex + 20، ey + 20، إش.رمز_نوع()، 1، ل_أبيض)

        # العنوان
        ارسم_نص_أصلي(ف، ex + 48، ey + 10، إش.عنوان، 1، ل_أبيض)

        # المصدر
        ارسم_نص_أصلي(ف، ex + 48 + طول(إش.عنوان) * 8 + 10، ey + 10، إش.مصدر، 1، ل_رمادي_غ)

        # المحتوى
        ارسم_نص_أصلي(ف، ex + 48، ey + 35، إش.محتوى، 1، ل_رمادي)

        # وقت
        ارسم_نص_أصلي(ف، ex + 48، ey + 55، "Time: " + إش.وقت + "s ago"، 1، ل_رمادي_غ)

        # زر إغلاق
        ارسم_نص_أصلي(ف، ex + ew - 20، ey + 5، "x"، 1، ل_رمادي)

        ارجع 1
    نهاية

    # رسم لوحة الإشعارات (notification center)
    دالة رسم_لوحة(ف)
        اذا (!هذا.لوحة_مفتوحة)
            ارجع 0
        نهاية

        متغير لوحة_ع = 380
        متغير لوحة_x = عرض_شاشة - لوحة_ع
        متغير لوحة_y = 0
        متغير لوحة_ا = ارت_شاشة - 40

        # خلفية اللوحة
        متغير لون_لوحة = امزج_لون(ل_أسود، ل_أزرق_غ، 35)
        ارسم_مستطيل_أصلي(ف، لوحة_x، لوحة_y، لوحة_ع، لوحة_ا، لون_لوحة)
        ارسم_خط_أصلي(ف، لوحة_x، لوحة_y، لوحة_x، لوحة_y + لوحة_ا، ل_رمادي_غ)

        # عنوان
        ارسم_مستطيل_أصلي(ف، لوحة_x، لوحة_y، لوحة_ع، 40، امزج_لون(ل_أصفر، ل_أسود، 60))
        ارسم_نص_أصلي(ف، لوحة_x + 15، لوحة_y + 12، "Notifications"، 2، ل_أصفر)
        ارسم_نص_أصلي(ف، لوحة_x + لوحة_ع - 80، لوحة_y + 14، "Clear All"، 1، ل_رمادي)

        # عدد الإشعارات
        ارسم_نص_أصلي(ف، لوحة_x + 15، لوحة_y + 50، "" + طول(هذا.إشعارات_سجل) + " notifications"، 1، ل_رمادي)

        # قائمة الإشعارات
        متغير ey = لوحة_y + 75
        متغير ت = 0
        بينما (ت < طول(هذا.إشعارات_سجل))
            متغير إش = هذا.إشعارات_سجل[ت]

            اذا (ey > لوحة_ا - 50)
                اخرج
            نهاية

            # بطاقة الإشعار
            متغير لون_ن = إش.لون_نوع()
            ارسم_مستطيل_أصلي(ف، لوحة_x + 10، ey، لوحة_ع - 20، 70، امزج_لون(ل_أسود، ل_أزرق_غ، 25))
            ارسم_مستطيل_أصلي(ف، لوحة_x + 10، ey، 3، 70، لون_ن)
            ارسم_إطار_أصلي(ف، لوحة_x + 10، ey، لوحة_ع - 20، 70، 1، ل_رمادي_غ)

            # أيقونة
            ارسم_دائرة_مصمتة(ف، لوحة_x + 30، ey + 20، 8، لون_ن)

            # العنوان والمحتوى
            ارسم_نص_أصلي(ف، لوحة_x + 48، ey + 8، إش.عنوان، 1، ل_أبيض)
            ارسم_نص_أصلي(ف، لوحة_x + 48، ey + 28، إش.محتوى، 1، ل_رمادي)
            ارسم_نص_أصلي(ف، لوحة_x + 48، ey + 48، إش.مصدر + " - " + إش.وقت + "s"، 1، ل_رمادي_غ)

            # مؤشر القراءة
            اذا (!إش.مقروء)
                ارسم_دائرة_مصمتة(ف، لوحة_x + لوحة_ع - 30، ey + 10، 4، ل_أصفر)
            نهاية

            ey = ey + 80
            ت = ت + 1
        نهاية

        ارجع 1
    نهاية

    # رسم الشاشة
    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        # خلفية
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)

        # شريط المهام
        متغير لون_شريط = امزج_لون(ل_أسود، ل_أزرق_غ، 30)
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، لون_شريط)

        # أيقونة الإشعارات في الشريط
        متغير عدد_غير_مقروء = 0
        متغير ت = 0
        بينما (ت < طول(هذا.إشعارات_سجل))
            اذا (!هذا.إشعارات_سجل[ت].مقروء)
                عدد_غير_مقروء = عدد_غير_مقروء + 1
            نهاية
            ت = ت + 1
        نهاية

        ارسم_مستطيل_أصلي(ف، عرض_شاشة - 135، ارت_شاشة - 35، 25، 25، ل_رمادي_غ)
        اذا (عدد_غير_مقروء > 0)
            ارسم_دائرة_مصمتة(ف، عرض_شاشة - 115، ارت_شاشة - 33، 6، ل_أحمر)
            ارسم_نص_أصلي(ف، عرض_شاشة - 118، ارت_شاشة - 38، "" + عدد_غير_مقروء، 1، ل_أبيض)
        نهاية

        # إشعارات منبثقة (أعلى يمين)
        متغير popup_y = 20
        متغير ب = 0
        بينما (ب < طول(هذا.إشعارات_حية))
            هذا.رسم_إشعار_منبثق(ف، هذا.إشعارات_حية[ب]، popup_y)
            popup_y = popup_y + 90
            ب = ب + 1
        نهاية

        # لوحة الإشعارات
        هذا.رسم_لوحة(ف)

        # swap
        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)

        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS Notification System ===")
    اطبع_سطر("")

    متغير نظام = جديد نظام_إشعارات()
    اطبع_سطر("[NOTIF] System initialized")

    # إطار 1: بدون إشعارات
    اطبع_سطر("")
    اطبع_سطر("-- Frame 1: No notifications --")
    نظام.رسم(1)
    نظام.تصدير("C:\\beeos_notif_empty.ppm")
    اطبع_سطر("  Clean screen")

    # إطار 2: إشعار واحد
    اطبع_سطر("")
    اطبع_سطر("-- Frame 2: One notification --")
    نظام.أضف_إشعار("WiFi Connected", "BeeHive-5G network active", "Network", نوع_نجاح، 5)
    نظام.رسم(2)
    اطبع_سطر("  Added: WiFi Connected")

    # إطار 3: عدة إشعارات
    اطبع_سطر("")
    اطبع_سطر("-- Frame 3: Multiple notifications --")
    نظام.أضف_إشعار("Low Battery", "Battery at 15%", "System", نوع_تحذير، 12)
    نظام.أضف_إشعار("Update Available", "BeeOS v1.1 ready", "Updater", نوع_معلومات، 30)
    نظام.رسم(3)
    نظام.تصدير("C:\\beeos_notif_popup.ppm")
    اطبع_سطر("  Added: Low Battery, Update")

    # إطار 4: المزيد من الإشعارات
    اطبع_سطر("")
    اطبع_سطر("-- Frame 4: More notifications --")
    نظام.أضف_إشعار("Download Complete", "File saved to Downloads", "Browser", نوع_نجاح، 45)
    نظام.أضف_إشعار("Disk Full Warning", "90% disk usage", "Storage", نوع_خطأ، 60)
    نظام.أضف_إشعار("New Message", "Hello from BeeChat!", "Messages", نوع_رسالة، 90)
    نظام.رسم(4)
    اطبع_سطر("  Total popups: " + طول(نظام.إشعارات_حية))

    # إطار 5: فتح لوحة الإشعارات
    اطبع_سطر("")
    اطبع_سطر("-- Frame 5: Notification center open --")
    نظام.لوحة_مفتوحة = 1
    نظام.إشعارات_حية = []
    نظام.رسم(5)
    نظام.تصدير("C:\\beeos_notif_center.ppm")
    اطبع_سطر("  Notification center opened")
    اطبع_سطر("  Total in log: " + طول(نظام.إشعارات_سجل))

    # إحصائيات
    اطبع_سطر("")
    متغير أسود = عد_بكسلات(نظام.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("  Total pixels: ")
    اطبع_سطر(إجمالي)
    اطبع("  Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("")
    اطبع_سطر("=== Notification System: SUCCESS ===")

    ارجع 0
نهاية
