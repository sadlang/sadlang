# طرفية مبكرة - طرفية نصية مبكرة للنواة
# ══════════════════════════════════════════════════════════════════════

صنف موقع_مؤشر
    رقم عمود
    رقم صف
    رقم مرئي

    باني()
        عمود = 0
        صف = 0
        مرئي = 1
    نهاية

    دالة تقدم()
        عمود = عمود + 1
        اذا (عمود >= 80)
            عمود = 0
            صف = صف + 1
        نهاية
    نهاية

    دالة سطر_جديد()
        عمود = 0
        صف = صف + 1
    نهاية

    دالة عرض()
        اطبع("  مؤشر: (")
        اطبع(عمود)
        اطبع("،")
        اطبع(صف)
        اطبع_سطر(")")
    نهاية
نهاية

صنف مخزن_طرفية
    رقم أقصى_أعمدة
    رقم أقصى_صفوف
    رقم لون_أمامي
    رقم لون_خلفي
    رقم عدد_أحرف

    باني(رقم أعمدة، رقم صفوف)
        أقصى_أعمدة = أعمدة
        أقصى_صفوف = صفوف
        لون_أمامي = 15
        لون_خلفي = 0
        عدد_أحرف = 0
    نهاية

    دالة كتابة_حرف(رقم حرف، رقم عمود، رقم صف)
        عدد_أحرف = عدد_أحرف + 1
    نهاية

    دالة مسح()
        عدد_أحرف = 0
    نهاية

    دالة تمرير()
        اطبع_سطر("  تمرير الطرفية")
    نهاية
نهاية

صنف طرفية_نواة
    رقم عرض_أعمدة
    رقم ارتفاع_صفوف
    رقم مهيأة

    باني()
        عرض_أعمدة = 80
        ارتفاع_صفوف = 25
        مهيأة = 0
    نهاية

    دالة تهيئة()
        اطبع_سطر("═══ الطرفية المبكرة ═══")
        اطبع("  ")
        اطبع(عرض_أعمدة)
        اطبع("x")
        اطبع_سطر(ارتفاع_صفوف)
        مهيأة = 1
    نهاية

    دالة كتابة_نص(نص محتوى)
        اطبع("  طباعة: ")
        اطبع_سطر(محتوى)
    نهاية

    دالة كتابة_رقم_عرض(رقم قيمة)
        اطبع("  عدد: ")
        اطبع_سطر(قيمة)
    نهاية
نهاية

دالة رئيسية()
    متغير طرفية = جديد طرفية_نواة()
    طرفية.تهيئة()

    متغير موقعنا = جديد موقع_مؤشر()
    موقعنا.تقدم()
    موقعنا.تقدم()
    موقعنا.عرض()

    متغير مخزن = جديد مخزن_طرفية(80، 25)
    مخزن.كتابة_حرف(65، 0، 0)

    طرفية.كتابة_نص("مرحباً بكم في خلية النحل")
    طرفية.كتابة_رقم_عرض(42)
    اطبع_سطر("  ✅ الطرفية المبكرة تعمل")
    ارجع 0
نهاية
