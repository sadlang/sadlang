# حركات_النوافذ.ص - نظام حركات النوافذ
# BeeOS Window Animations - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296

صنف نافذة_متحركة
    نص عنوان
    رقم هدف_x
    رقم هدف_y
    رقم هدف_ع
    رقم هدف_ا
    رقم حالي_x
    رقم حالي_y
    رقم حالي_ع
    رقم حالي_ا
    رقم لون_عنوان_ق
    رقم شفافية

    باني(عن، هx، هy، هع، ها، لعن)
        هذا.عنوان = عن
        هذا.هدف_x = هx
        هذا.هدف_y = هy
        هذا.هدف_ع = هع
        هذا.هدف_ا = ها
        هذا.حالي_x = هx
        هذا.حالي_y = هy
        هذا.حالي_ع = هع
        هذا.حالي_ا = ها
        هذا.لون_عنوان_ق = لعن
        هذا.شفافية = 100
    نهاية
نهاية

صنف محرك_حركات
    رقم مقبض_شاشة
    رقم مقبض_خلفي

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
    نهاية

    دالة رسم_خلفية(ف)
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)
        # أيقونات سطح المكتب
        متغير آي = 0
        بينما (آي < 6)
            متغير ix = 50 + آي % 2 * 100
            متغير iy = 80 + آي / 2 * 110
            ارسم_مستطيل_أصلي(ف، ix، iy، 60، 60، ل_رمادي_غ)
            ارسم_نص_أصلي(ف، ix + 10، iy + 70، "App" + آي، 1، ل_رمادي)
            آي = آي + 1
        نهاية
        # شريط مهام
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، امزج_لون(ل_أسود، ل_أزرق_غ، 30))
        ارسم_نص_أصلي(ف، 20، ارت_شاشة - 28، "Start"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، عرض_شاشة - 100، ارت_شاشة - 28، "12:00"، 1، ل_رمادي)
        ارجع 1
    نهاية

    دالة رسم_نافذة(ف، نف)
        اذا (نف.شفافية <= 0)
            ارجع 0
        نهاية
        اذا (نف.حالي_ع < 5)
            ارجع 0
        نهاية
        اذا (نف.حالي_ا < 5)
            ارجع 0
        نهاية

        متغير nx = نف.حالي_x
        متغير ny = نف.حالي_y
        متغير nw = نف.حالي_ع
        متغير nh = نف.حالي_ا

        # ظل
        متغير لون_ظل = امزج_لون(ل_أسود، ل_أسود، 50)
        ارسم_مستطيل_أصلي(ف، nx + 6، ny + 6، nw، nh، لون_ظل)

        # جسم النافذة
        متغير لون_جسم = امزج_لون(ل_أسود، ل_أبيض، 12)
        اذا (نف.شفافية < 100)
            لون_جسم = امزج_لون(لون_جسم، ل_أسود، 100 - نف.شفافية)
        نهاية
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، nh، لون_جسم)
        ارسم_إطار_أصلي(ف، nx، ny، nw، nh، 2، ل_رمادي_غ)

        # شريط العنوان
        متغير لون_عنوان = نف.لون_عنوان_ق
        اذا (نف.شفافية < 100)
            لون_عنوان = امزج_لون(لون_عنوان، ل_أسود، 100 - نف.شفافية)
        نهاية
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، 28، لون_عنوان)
        ارسم_نص_أصلي(ف، nx + 10، ny + 7، نف.عنوان، 1، ل_أبيض)

        # أزرار
        ارسم_دائرة_مصمتة(ف، nx + nw - 16، ny + 14، 8، ل_أحمر)
        ارسم_دائرة_مصمتة(ف، nx + nw - 35، ny + 14، 8، ل_أصفر)
        ارسم_دائرة_مصمتة(ف، nx + nw - 54، ny + 14، 8، ل_أخضر)

        # محتوى
        اذا (nh > 60)
            ارسم_نص_أصلي(ف، nx + 15، ny + 40، "Window Content"، 1، ل_أبيض)
            ارسم_خط_أصلي(ف، nx + 15، ny + 58، nx + nw - 15، ny + 58، ل_رمادي_غ)
            اذا (nh > 100)
                ارسم_نص_أصلي(ف، nx + 15، ny + 70، "Lorem ipsum dolor sit"، 1، ل_رمادي)
                ارسم_نص_أصلي(ف، nx + 15، ny + 90، "amet consectetur"، 1، ل_رمادي)
            نهاية
        نهاية

        ارجع 1
    نهاية

    # حركة فتح نافذة (من صغير في المنتصف إلى حجم كامل)
    دالة حركة_فتح(نف، تقدم)
        متغير مركز_x = نف.هدف_x + نف.هدف_ع / 2
        متغير مركز_y = نف.هدف_y + نف.هدف_ا / 2

        نف.حالي_ع = نف.هدف_ع * تقدم / 100
        نف.حالي_ا = نف.هدف_ا * تقدم / 100
        نف.حالي_x = مركز_x - نف.حالي_ع / 2
        نف.حالي_y = مركز_y - نف.حالي_ا / 2
        نف.شفافية = تقدم
        ارجع 1
    نهاية

    # حركة إغلاق (تصغر إلى نقطة)
    دالة حركة_إغلاق(نف، تقدم)
        متغير عكس = 100 - تقدم
        متغير مركز_x = نف.هدف_x + نف.هدف_ع / 2
        متغير مركز_y = نف.هدف_y + نف.هدف_ا / 2

        نف.حالي_ع = نف.هدف_ع * عكس / 100
        نف.حالي_ا = نف.هدف_ا * عكس / 100
        نف.حالي_x = مركز_x - نف.حالي_ع / 2
        نف.حالي_y = مركز_y - نف.حالي_ا / 2
        نف.شفافية = عكس
        ارجع 1
    نهاية

    # حركة تصغير (انزلاق لأسفل شريط المهام)
    دالة حركة_تصغير(نف، تقدم)
        متغير عكس = 100 - تقدم
        نف.حالي_x = نف.هدف_x
        نف.حالي_y = نف.هدف_y + (ارت_شاشة - نف.هدف_y) * تقدم / 100
        نف.حالي_ع = نف.هدف_ع * عكس / 100 + 10
        نف.حالي_ا = نف.هدف_ا * عكس / 100 + 5
        نف.شفافية = عكس
        ارجع 1
    نهاية

    # حركة تكبير (ملء الشاشة)
    دالة حركة_تكبير(نف، تقدم)
        نف.حالي_x = نف.هدف_x * (100 - تقدم) / 100
        نف.حالي_y = نف.هدف_y * (100 - تقدم) / 100
        نف.حالي_ع = نف.هدف_ع + (عرض_شاشة - نف.هدف_ع) * تقدم / 100
        نف.حالي_ا = نف.هدف_ا + (ارت_شاشة - 40 - نف.هدف_ا) * تقدم / 100
        نف.شفافية = 100
        ارجع 1
    نهاية

    دالة رسم_إطار(نف1، نف2، نف3، عنوان_حركة)
        متغير ف = هذا.مقبض_خلفي
        هذا.رسم_خلفية(ف)

        # عنوان الحركة
        ارسم_نص_أصلي(ف، عرض_شاشة / 2 - 100، 10، عنوان_حركة، 2، ل_أصفر)

        هذا.رسم_نافذة(ف، نف1)
        هذا.رسم_نافذة(ف، نف2)
        هذا.رسم_نافذة(ف، نف3)

        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)
        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== BeeOS Window Animations ===")

    متغير محرك = جديد محرك_حركات()
    اطبع_سطر("[ANIM] Initialized")

    # إنشاء 3 نوافذ
    متغير نف1 = جديد نافذة_متحركة("Browser"، 300، 100، 600، 400، ل_أزرق_غ)
    متغير نف2 = جديد نافذة_متحركة("Editor"، 500، 200، 550، 380، ل_رمادي_غ)
    متغير نف3 = جديد نافذة_متحركة("Terminal"، 700، 300، 500، 350، ل_أسود)

    # حركة 1: فتح النافذة الأولى (5 خطوات - نأخذ الخطوة الأولى والأخيرة)
    اطبع_سطر("-- Frame 1: Opening Browser 20% --")
    محرك.حركة_فتح(نف1، 20)
    نف2.شفافية = 0
    نف3.شفافية = 0
    محرك.رسم_إطار(نف1، نف2، نف3، "Open Animation: 20%")
    محرك.تصدير("C:\\beeos_anim_open1.ppm")

    اطبع_سطر("-- Frame 2: Opening Browser 60% --")
    محرك.حركة_فتح(نف1، 60)
    محرك.رسم_إطار(نف1، نف2، نف3، "Open Animation: 60%")
    محرك.تصدير("C:\\beeos_anim_open2.ppm")

    اطبع_سطر("-- Frame 3: Browser fully open --")
    محرك.حركة_فتح(نف1، 100)
    محرك.رسم_إطار(نف1، نف2، نف3، "Open Animation: 100%")
    محرك.تصدير("C:\\beeos_anim_open3.ppm")

    # حركة 2: فتح Editor مع Browser مفتوح
    اطبع_سطر("-- Frame 4: Opening Editor --")
    محرك.حركة_فتح(نف2، 50)
    محرك.رسم_إطار(نف1، نف2، نف3، "Second Window: 50%")
    محرك.تصدير("C:\\beeos_anim_second.ppm")

    اطبع_سطر("-- Frame 5: Both windows open --")
    محرك.حركة_فتح(نف2، 100)
    محرك.حركة_فتح(نف3، 100)
    محرك.رسم_إطار(نف1، نف2، نف3، "All Windows Open")
    محرك.تصدير("C:\\beeos_anim_all.ppm")

    # حركة 3: تصغير النافذة الثانية
    اطبع_سطر("-- Frame 6: Minimizing Editor --")
    محرك.حركة_تصغير(نف2، 60)
    محرك.رسم_إطار(نف1، نف2، نف3، "Minimize: 60%")
    محرك.تصدير("C:\\beeos_anim_minimize.ppm")

    # حركة 4: تكبير النافذة الأولى
    اطبع_سطر("-- Frame 7: Maximizing Browser --")
    نف2.شفافية = 0
    محرك.حركة_تكبير(نف1، 50)
    محرك.رسم_إطار(نف1، نف2، نف3، "Maximize: 50%")
    محرك.تصدير("C:\\beeos_anim_maximize.ppm")

    # حركة 5: إغلاق Terminal
    اطبع_سطر("-- Frame 8: Closing Terminal --")
    نف1.حالي_x = نف1.هدف_x
    نف1.حالي_y = نف1.هدف_y
    نف1.حالي_ع = نف1.هدف_ع
    نف1.حالي_ا = نف1.هدف_ا
    نف1.شفافية = 100
    محرك.حركة_إغلاق(نف3، 60)
    محرك.رسم_إطار(نف1، نف2، نف3، "Close Animation: 60%")
    محرك.تصدير("C:\\beeos_anim_close.ppm")

    متغير أسود = عد_بكسلات(محرك.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("=== Window Animations: SUCCESS ===")
    ارجع 0
نهاية
