# ══════════════════════════════════════════════════════════════════════════════
# مدير_الإطارات.ص - نظام إدارة النوافذ لنظام خلية النحل
# BeeOS Window/Frame Manager - Compositing, Z-order, Interaction
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# أبعاد الشاشة
# ─────────────────────────────────────────────────────────────────────
متغير عرض_الشاشة  = 1920
متغير ارتفاع_الشاشة = 1080

# ─────────────────────────────────────────────────────────────────────
# ألوان النظام
# ─────────────────────────────────────────────────────────────────────
متغير لون_أسود       = -16777216
متغير لون_أبيض       = -1
متغير لون_أحمر       = -65536
متغير لون_أخضر       = -16711936
متغير لون_أزرق       = -16776961
متغير لون_رمادي_فاتح = -3355444
متغير لون_رمادي_غامق = -12303292
متغير لون_أصفر       = -256

# ألوان سطح المكتب الخاصة
متغير لون_خلفية_نافذة     = -1
متغير لون_شريط_عنوان      = -14575885
متغير لون_شريط_مهام        = -15132391
متغير لون_زر_إغلاق        = -65536
متغير لون_زر_تصغير        = -256
متغير لون_زر_تكبير        = -16711936
متغير لون_حدود_نافذة      = -8882056
متغير لون_نص_عنوان        = -1
متغير لون_خلفية_سطح       = -14575885
متغير لون_تحديد           = -16744193

# ─────────────────────────────────────────────────────────────────────
# ثوابت واجهة المستخدم
# ─────────────────────────────────────────────────────────────────────
متغير ارتفاع_شريط_عنوان = 30
متغير ارتفاع_شريط_مهام  = 48
متغير حجم_زر_تحكم       = 20
متغير فجوة_أزرار        = 4
متغير سمك_حدود          = 2
متغير أقصى_نوافذ        = 20

# حالات النافذة
متغير وضع_عادي   = 0
متغير وضع_مصغر   = 1
متغير وضع_مكبر   = 2
متغير وضع_مغلق   = 3

# ─────────────────────────────────────────────────────────────────────
# صنف معلومات النافذة (flattened - لا كائنات مركبة)
# ─────────────────────────────────────────────────────────────────────
صنف نافذة
    رقم معرف
    نص عنوان
    رقم x
    رقم y
    رقم عرض
    رقم ارتفاع
    رقم وضع
    رقم مقبض_fb
    رقم ترتيب_z
    منطقي مركزة
    منطقي قابلة_تحريك
    منطقي قابلة_تغيير_حجم
    رقم لون_خلفية_محلي
    نص نوع_تطبيق

    باني(م، ع، ن_x، ن_y، ن_عرض، ن_ارتفاع، ن_عنوان، ن_نوع)
        هذا.معرف = م
        هذا.عنوان = ن_عنوان
        هذا.x = ن_x
        هذا.y = ن_y
        هذا.عرض = ن_عرض
        هذا.ارتفاع = ن_ارتفاع
        هذا.وضع = وضع_عادي
        هذا.مقبض_fb = أنشئ_مخزن_رسوم(ن_عرض، ن_ارتفاع)
        هذا.ترتيب_z = ع
        هذا.مركزة = خطأ
        هذا.قابلة_تحريك = صحيح
        هذا.قابلة_تغيير_حجم = صحيح
        هذا.لون_خلفية_محلي = لون_خلفية_نافذة
        هذا.نوع_تطبيق = ن_نوع
    نهاية

    # ────────────────────────────────────────
    # رسم إطار النافذة (chrome)
    # ────────────────────────────────────────

    دالة رسم_إطار_نافذة()
        اذا (هذا.وضع == وضع_مغلق || هذا.وضع == وضع_مصغر)
            ارجع 0
        نهاية

        متغير fb = هذا.مقبض_fb
        متغير ع = هذا.عرض
        متغير ا = هذا.ارتفاع

        # مسح خلفية النافذة
        املأ_مخزن(fb، هذا.لون_خلفية_محلي)

        # شريط العنوان
        ارسم_مستطيل_أصلي(fb، 0، 0، ع، ارتفاع_شريط_عنوان، لون_شريط_عنوان)

        # عنوان النافذة
        ارسم_نص_أصلي(fb، 10، 8، هذا.عنوان، 2، لون_نص_عنوان)

        # أزرار التحكم (إغلاق، تكبير، تصغير) من اليمين
        متغير زر_x = ع - حجم_زر_تحكم - فجوة_أزرار

        # زر إغلاق (أحمر)
        ارسم_مستطيل_أصلي(fb، زر_x، 5، حجم_زر_تحكم، حجم_زر_تحكم، لون_زر_إغلاق)
        ارسم_نص_أصلي(fb، زر_x + 5، 7، "X"، 1، لون_أبيض)

        # زر تكبير (أخضر)
        زر_x = زر_x - حجم_زر_تحكم - فجوة_أزرار
        ارسم_مستطيل_أصلي(fb، زر_x، 5، حجم_زر_تحكم، حجم_زر_تحكم، لون_زر_تكبير)

        # زر تصغير (أصفر)
        زر_x = زر_x - حجم_زر_تحكم - فجوة_أزرار
        ارسم_مستطيل_أصلي(fb، زر_x، 5، حجم_زر_تحكم، حجم_زر_تحكم، لون_زر_تصغير)
        ارسم_نص_أصلي(fb، زر_x + 5، 7، "_"، 1، لون_أسود)

        # حدود النافذة
        اذا (هذا.مركزة)
            ارسم_إطار_أصلي(fb، 0، 0، ع، ا، سمك_حدود، لون_تحديد)
        والا
            ارسم_إطار_أصلي(fb، 0، 0، ع، ا، سمك_حدود، لون_حدود_نافذة)
        نهاية

        ارجع 1
    نهاية

    # ────────────────────────────────────────
    # رسم محتوى التطبيق داخل النافذة
    # ────────────────────────────────────────

    دالة رسم_محتوى()
        اذا (هذا.وضع == وضع_مغلق || هذا.وضع == وضع_مصغر)
            ارجع 0
        نهاية

        متغير fb = هذا.مقبض_fb
        متغير ع = هذا.عرض
        متغير ا = هذا.ارتفاع
        متغير content_y = ارتفاع_شريط_عنوان + 5
        متغير content_x = 10
        متغير content_w = ع - 20
        متغير content_h = ا - ارتفاع_شريط_عنوان - 10

        اذا (هذا.نوع_تطبيق == "متصفح")
            # شريط عنوان URL
            ارسم_مستطيل_أصلي(fb، content_x، content_y، content_w، 25، لون_رمادي_فاتح)
            ارسم_إطار_أصلي(fb، content_x، content_y، content_w، 25، 1، لون_رمادي_غامق)
            ارسم_نص_أصلي(fb، content_x + 5، content_y + 6، "https://beeos.local/"، 1، لون_أسود)

            # محتوى الويب
            متغير web_y = content_y + 30
            ارسم_مستطيل_أصلي(fb، content_x، web_y، content_w، content_h - 35، لون_أبيض)
            ارسم_نص_أصلي(fb، content_x + 20، web_y + 20، "BeeOS Web Portal"، 3، لون_شريط_عنوان)
            ارسم_نص_أصلي(fb، content_x + 20، web_y + 60، "Welcome to BeeOS Browser"، 2، لون_أسود)

            # أزرار
            ارسم_مستطيل_أصلي(fb، content_x + 20، web_y + 100، 120، 30، لون_شريط_عنوان)
            ارسم_نص_أصلي(fb، content_x + 35، web_y + 108، "Home"، 1، لون_أبيض)

            ارسم_مستطيل_أصلي(fb، content_x + 160، web_y + 100، 120، 30، لون_أخضر)
            ارسم_نص_أصلي(fb، content_x + 175، web_y + 108، "Settings"، 1، لون_أبيض)

        والا
            اذا (هذا.نوع_تطبيق == "آلة_حاسبة")
                # شاشة العرض
                ارسم_مستطيل_أصلي(fb، content_x، content_y، content_w، 40، لون_أسود)
                ارسم_نص_أصلي(fb، content_x + content_w - 80، content_y + 12، "0"، 2، لون_أخضر)

                # صفوف الأزرار
                متغير btn_w = 50
                متغير btn_h = 40
                متغير btn_gap = 5
                متغير row_y = content_y + 50

                متغير col = 0
                بينما (col < 4)
                    متغير row = 0
                    بينما (row < 4)
                        متغير bx = content_x + col * (btn_w + btn_gap)
                        متغير by = row_y + row * (btn_h + btn_gap)
                        ارسم_مستطيل_أصلي(fb، bx، by، btn_w، btn_h، لون_رمادي_فاتح)
                        ارسم_إطار_أصلي(fb، bx، by، btn_w، btn_h، 1، لون_رمادي_غامق)
                        row = row + 1
                    نهاية
                    col = col + 1
                نهاية

                # تسميات الأزرار
                ارسم_نص_أصلي(fb، content_x + 18، row_y + 12، "7"، 2، لون_أسود)
                ارسم_نص_أصلي(fb، content_x + 73، row_y + 12، "8"، 2، لون_أسود)
                ارسم_نص_أصلي(fb، content_x + 128، row_y + 12، "9"، 2، لون_أسود)
                ارسم_نص_أصلي(fb، content_x + 183، row_y + 12، "+"، 2، لون_أحمر)

            والا
                اذا (هذا.نوع_تطبيق == "محرر_نصوص")
                    # شريط أدوات
                    ارسم_مستطيل_أصلي(fb، content_x، content_y، content_w، 25، لون_رمادي_فاتح)
                    ارسم_نص_أصلي(fb، content_x + 5، content_y + 7، "File  Edit  View"، 1، لون_أسود)

                    # منطقة النص
                    متغير txt_y = content_y + 30
                    ارسم_مستطيل_أصلي(fb، content_x، txt_y، content_w، content_h - 35، لون_أبيض)

                    # أرقام الأسطر
                    ارسم_مستطيل_أصلي(fb، content_x، txt_y، 30، content_h - 35، لون_رمادي_فاتح)
                    ارسم_نص_أصلي(fb، content_x + 5، txt_y + 5، "1"، 1، لون_رمادي_غامق)
                    ارسم_نص_أصلي(fb، content_x + 5، txt_y + 20، "2"، 1، لون_رمادي_غامق)
                    ارسم_نص_أصلي(fb، content_x + 5، txt_y + 35، "3"، 1، لون_رمادي_غامق)

                    # نص المحرر
                    ارسم_نص_أصلي(fb، content_x + 40، txt_y + 5، "BeeOS Text Editor"، 1، لون_أسود)
                    ارسم_نص_أصلي(fb، content_x + 40، txt_y + 20، "Hello World!"، 1، لون_أسود)

                    # مؤشر النص الوامض
                    ارسم_مستطيل_أصلي(fb، content_x + 112، txt_y + 20، 2، 12، لون_أسود)

                والا
                    اذا (هذا.نوع_تطبيق == "مدير_ملفات")
                        # شريط التنقل
                        ارسم_مستطيل_أصلي(fb، content_x، content_y، content_w، 25، لون_رمادي_فاتح)
                        ارسم_نص_أصلي(fb، content_x + 5، content_y + 7، "/ > خلية_النحل > مستندات"، 1، لون_أسود)

                        # قائمة الملفات
                        متغير file_y = content_y + 30
                        ارسم_مستطيل_أصلي(fb، content_x، file_y، content_w، content_h - 35، لون_أبيض)

                        # عناصر الملفات
                        متغير fy = file_y + 5
                        ارسم_مستطيل_أصلي(fb، content_x + 5، fy، content_w - 10، 24، لون_رمادي_فاتح)
                        ارسم_نص_أصلي(fb، content_x + 35، fy + 6، "Documents"، 1، لون_أسود)

                        fy = fy + 28
                        ارسم_نص_أصلي(fb، content_x + 35، fy + 6، "Pictures"، 1، لون_أسود)

                        fy = fy + 28
                        ارسم_نص_أصلي(fb، content_x + 35، fy + 6، "readme.txt"، 1، لون_رمادي_غامق)

                    والا
                        # تطبيق افتراضي
                        ارسم_نص_أصلي(fb، content_x + 20، content_y + 30، هذا.نوع_تطبيق، 2، لون_أسود)
                        ارسم_نص_أصلي(fb، content_x + 20، content_y + 60، "Application Running"، 1، لون_رمادي_غامق)
                    نهاية
                نهاية
            نهاية
        نهاية

        ارجع 1
    نهاية

    # ────────────────────────────────────────
    # نقطة داخل النافذة؟
    # ────────────────────────────────────────

    دالة يحتوي(نقطة_x، نقطة_y)
        اذا (نقطة_x >= هذا.x && نقطة_x < هذا.x + هذا.عرض)
            اذا (نقطة_y >= هذا.y && نقطة_y < هذا.y + هذا.ارتفاع)
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    # نقطة على شريط العنوان؟
    دالة على_شريط_عنوان(نقطة_x، نقطة_y)
        اذا (نقطة_x >= هذا.x && نقطة_x < هذا.x + هذا.عرض)
            اذا (نقطة_y >= هذا.y && نقطة_y < هذا.y + ارتفاع_شريط_عنوان)
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    # نقطة على زر الإغلاق؟
    دالة على_زر_إغلاق(نقطة_x، نقطة_y)
        متغير زر_x = هذا.x + هذا.عرض - حجم_زر_تحكم - فجوة_أزرار
        متغير زر_y = هذا.y + 5
        اذا (نقطة_x >= زر_x && نقطة_x < زر_x + حجم_زر_تحكم)
            اذا (نقطة_y >= زر_y && نقطة_y < زر_y + حجم_زر_تحكم)
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    # تحريك النافذة
    دالة حرك(dx، dy)
        هذا.x = هذا.x + dx
        هذا.y = هذا.y + dy

        # منع الخروج من الشاشة
        اذا (هذا.x < 0)
            هذا.x = 0
        نهاية
        اذا (هذا.y < 0)
            هذا.y = 0
        نهاية
        اذا (هذا.x + هذا.عرض > عرض_الشاشة)
            هذا.x = عرض_الشاشة - هذا.عرض
        نهاية
        اذا (هذا.y + هذا.ارتفاع > ارتفاع_الشاشة - ارتفاع_شريط_مهام)
            هذا.y = ارتفاع_الشاشة - ارتفاع_شريط_مهام - هذا.ارتفاع
        نهاية
    نهاية

    # تكبير / استعادة
    دالة تبديل_تكبير()
        اذا (هذا.وضع == وضع_مكبر)
            هذا.وضع = وضع_عادي
        والا
            هذا.وضع = وضع_مكبر
            هذا.x = 0
            هذا.y = 0
            هذا.عرض = عرض_الشاشة
            هذا.ارتفاع = ارتفاع_الشاشة - ارتفاع_شريط_مهام
        نهاية
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────
# صنف مدير الإطارات (Window Manager)
# ─────────────────────────────────────────────────────────────────────
صنف مدير_الإطارات
    رقم عدد_النوافذ
    رقم المعرف_التالي
    رقم مقبض_الشاشة
    رقم مقبض_خلفي
    رقم النافذة_المركزة
    رقم إجمالي_بكسلات

    باني()
        هذا.عدد_النوافذ = 0
        هذا.المعرف_التالي = 1
        هذا.مقبض_الشاشة = أنشئ_مخزن_رسوم(عرض_الشاشة، ارتفاع_الشاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_الشاشة، ارتفاع_الشاشة)
        هذا.النافذة_المركزة = -1
        هذا.إجمالي_بكسلات = 0

        اطبع_سطر("  [مدير الإطارات] تم التهيئة - شاشة 1920x1080")
    نهاية

    # ════════════════════════════════════════════════════════════════
    # رسم خلفية سطح المكتب
    # ════════════════════════════════════════════════════════════════

    دالة رسم_خلفية()
        متغير fb = هذا.مقبض_خلفي

        # تدرج خلفية
        ارسم_تدرج_أفقي(fb، 0، 0، عرض_الشاشة، ارتفاع_الشاشة - ارتفاع_شريط_مهام، لون_خلفية_سطح، لون_أسود)

        # شعار في المنتصف
        متغير cx = عرض_الشاشة / 2 - 100
        متغير cy = ارتفاع_الشاشة / 2 - 40

        # رسم شكل النحلة (هيكساغون مبسط)
        ارسم_دائرة_مصمتة(fb، cx + 100، cy، 60، لون_أصفر)
        ارسم_دائرة_مصمتة(fb، cx + 100، cy، 55، لون_أسود)
        ارسم_دائرة_مصمتة(fb، cx + 100، cy، 50، لون_أصفر)
        # خطوط النحل
        ارسم_مستطيل_أصلي(fb، cx + 70، cy - 8، 60، 5، لون_أسود)
        ارسم_مستطيل_أصلي(fb، cx + 70، cy + 3، 60، 5، لون_أسود)

        # نص الشعار
        ارسم_نص_أصلي(fb، cx + 40، cy + 70، "BeeOS HD"، 3، لون_أبيض)
        ارسم_نص_أصلي(fb، cx + 30، cy + 100، "Honeycomb Desktop"، 2، لون_رمادي_فاتح)

        ارجع 1
    نهاية

    # ════════════════════════════════════════════════════════════════
    # رسم شريط المهام
    # ════════════════════════════════════════════════════════════════

    دالة رسم_شريط_مهام(نوافذ)
        متغير fb = هذا.مقبض_خلفي
        متغير شريط_y = ارتفاع_الشاشة - ارتفاع_شريط_مهام

        # خلفية الشريط
        ارسم_مستطيل_أصلي(fb، 0، شريط_y، عرض_الشاشة، ارتفاع_شريط_مهام، لون_شريط_مهام)

        # خط فاصل علوي
        ارسم_مستطيل_أصلي(fb، 0، شريط_y، عرض_الشاشة، 2، لون_رمادي_غامق)

        # زر القائمة الرئيسية
        ارسم_مستطيل_أصلي(fb، 5، شريط_y + 8، 80، 32، لون_أصفر)
        ارسم_نص_أصلي(fb، 15، شريط_y + 16، "BeeOS"، 2، لون_أسود)

        # أيقونات النوافذ المفتوحة
        متغير أيقونة_x = 100
        متغير ن = 0
        بينما (ن < طول(نوافذ))
            متغير نف = نوافذ[ن]
            اذا (نف.وضع != وضع_مغلق)
                # مربع الأيقونة
                اذا (نف.مركزة)
                    ارسم_مستطيل_أصلي(fb، أيقونة_x، شريط_y + 6، 140، 36، لون_تحديد)
                والا
                    ارسم_مستطيل_أصلي(fb، أيقونة_x، شريط_y + 6، 140، 36، لون_رمادي_غامق)
                نهاية

                # اسم التطبيق
                ارسم_نص_أصلي(fb، أيقونة_x + 10، شريط_y + 16، نف.عنوان، 1، لون_أبيض)

                أيقونة_x = أيقونة_x + 150
            نهاية
            ن = ن + 1
        نهاية

        # الساعة (يمين)
        ارسم_نص_أصلي(fb، عرض_الشاشة - 100، شريط_y + 16، "12:00 PM"، 1، لون_أبيض)

        ارجع 1
    نهاية

    # ════════════════════════════════════════════════════════════════
    # تركيب النوافذ (compositing) على المخزن الخلفي
    # ════════════════════════════════════════════════════════════════

    دالة تركيب_نوافذ(نوافذ)
        متغير total_px = 0

        # رسم الخلفية أولاً
        هذا.رسم_خلفية()

        # رسم النوافذ بترتيب z (من الخلف للأمام)
        متغير z = 0
        بينما (z < طول(نوافذ))
