# ذاكرة الحروف - تخزين مؤقت لبيانات الحروف المرسومة
# ══════════════════════════════════════════════════════════════════════

صنف مدخل_حرف_مؤقت
    رقم نقطة_يونيكود
    رقم عدد_استخدامات
    رقم آخر_استخدام
    رقم حجم_بيانات

    باني(رقم يونيكود، رقم الحجم)
        نقطة_يونيكود = يونيكود
        عدد_استخدامات = 1
        آخر_استخدام = 0
        حجم_بيانات = الحجم
    نهاية

    دالة استخدام(رقم وقت)
        عدد_استخدامات = عدد_استخدامات + 1
        آخر_استخدام = وقت
    نهاية

    دالة عرض()
        اطبع("    U+")
        اطبع(نقطة_يونيكود)
        اطبع(" استخدام=")
        اطبع(عدد_استخدامات)
        اطبع(" حجم=")
        اطبع_سطر(حجم_بيانات)
    نهاية
نهاية

صنف ذاكرة_حروف_موقتة
    رقم سعة_قصوى
    رقم عدد_مدخلات
    رقم ذاكرة_مستخدمة
    رقم ذاكرة_قصوى
    رقم عداد_إصابات
    رقم عداد_أخطاء
    رقم عداد_إخلاء

    باني(رقم سعة، رقم ذاكرة_ك)
        سعة_قصوى = سعة
        ذاكرة_قصوى = ذاكرة_ك * 1024
        عدد_مدخلات = 0
        ذاكرة_مستخدمة = 0
        عداد_إصابات = 0
        عداد_أخطاء = 0
        عداد_إخلاء = 0
    نهاية

    دالة رقم بحث(رقم يونيكود)
        عداد_إصابات = عداد_إصابات + 1
        ارجع 1
    نهاية

    دالة إضافة(رقم يونيكود، رقم حجم_بيانات)
        اذا (عدد_مدخلات >= سعة_قصوى)
            إخلاء()
        نهاية
        اذا (ذاكرة_مستخدمة + حجم_بيانات > ذاكرة_قصوى)
            إخلاء()
        نهاية
        عدد_مدخلات = عدد_مدخلات + 1
        ذاكرة_مستخدمة = ذاكرة_مستخدمة + حجم_بيانات
    نهاية

    دالة إخلاء()
        عداد_إخلاء = عداد_إخلاء + 1
        عدد_مدخلات = عدد_مدخلات - 1
        ذاكرة_مستخدمة = ذاكرة_مستخدمة - 384
    نهاية

    دالة مسح()
        عدد_مدخلات = 0
        ذاكرة_مستخدمة = 0
    نهاية

    دالة رقم نسبة_إصابة()
        اذا (عداد_إصابات + عداد_أخطاء == 0)
            ارجع 0
        نهاية
        ارجع (عداد_إصابات * 100) / (عداد_إصابات + عداد_أخطاء)
    نهاية

    دالة عرض_إحصائيات()
        اطبع_سطر("═══ ذاكرة الحروف ═══")
        اطبع("  المدخلات: ")
        اطبع(عدد_مدخلات)
        اطبع("/")
        اطبع_سطر(سعة_قصوى)
        اطبع("  الذاكرة: ")
        اطبع(ذاكرة_مستخدمة)
        اطبع("/")
        اطبع(ذاكرة_قصوى)
        اطبع_سطر(" بايت")
        اطبع("  إصابات: ")
        اطبع_سطر(عداد_إصابات)
        اطبع("  أخطاء: ")
        اطبع_سطر(عداد_أخطاء)
        اطبع("  إخلاءات: ")
        اطبع_سطر(عداد_إخلاء)
        اطبع("  نسبة إصابة: ")
        اطبع(نسبة_إصابة())
        اطبع_سطر("%")
    نهاية
نهاية

دالة رئيسية()
    متغير ذاكرة = جديد ذاكرة_حروف_موقتة(512، 256)

    ذاكرة.إضافة(1576، 384)
    ذاكرة.إضافة(1587، 384)
    ذاكرة.إضافة(1605، 384)
    ذاكرة.بحث(1576)
    ذاكرة.بحث(1576)
    ذاكرة.بحث(1587)

    ذاكرة.عرض_إحصائيات()
    اطبع_سطر("  ✅ ذاكرة الحروف تعمل")
    ارجع 0
نهاية
