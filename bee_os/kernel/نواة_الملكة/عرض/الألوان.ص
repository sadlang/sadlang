دالة رئيسية()
    متغير لون = جديد لون_ثلاثي(255، 200، 0)
    اطبع("  سطوع الذهبي: ")
    اطبع_سطر(لون.سطوع())
    اطبع("  هل فاتح: ")
    اطبع_سطر(لون.هل_فاتح())
    اطبع("  القيمة المدمجة: ")
    اطبع_سطر(لون.إلى_قيمة_مدمجة())

    متغير محول = جديد محول_ألوان()
    اطبع("  أحمر من 16711680: ")
    اطبع_سطر(محول.من_مدمج_لأحمر(16711680))
    اطبع("  رمادي (255,128,0): ")
    اطبع_سطر(محول.إلى_رمادي(255، 128، 0))

    متغير لوحة = جديد لوحة_ألوان_النحل()
    اطبع("  الذهبي: ")
    اطبع_سطر(لوحة.اعط_الذهبي())
    اطبع("  الأبيض: ")
    اطبع_سطر(لوحة.اعط_الأبيض())

    اطبع_سطر("  ✅ الألوان يعمل")
    ارجع 0
نهاية
