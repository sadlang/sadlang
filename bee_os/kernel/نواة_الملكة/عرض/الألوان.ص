صنف لون_ثلاثي
    رقم أحمر
    رقم أخضر
    رقم أزرق

    باني(رقم ح، رقم خ، رقم ز)
        أحمر = ح
        أخضر = خ
        أزرق = ز
    نهاية

    دالة رقم اعط_أحمر()
        ارجع أحمر
    نهاية

    دالة رقم اعط_أخضر()
        ارجع أخضر
    نهاية

    دالة رقم اعط_أزرق()
        ارجع أزرق
    نهاية

    دالة رقم إلى_قيمة_مدمجة()
        ارجع (أحمر * 65536) + (أخضر * 256) + أزرق
    نهاية

    دالة رقم سطوع()
        # حساب مبسط للسطوع
        ارجع (أحمر * 30 + أخضر * 59 + أزرق * 11) / 100
    نهاية

    دالة رقم هل_فاتح()
        اذا (سطوع() > 127)
            ارجع 1
        نهاية
        ارجع 0
    نهاية
نهاية

صنف محول_ألوان
    رقم معامل_غاما

    باني()
        معامل_غاما = 220
    نهاية

    دالة رقم من_مدمج_لأحمر(رقم القيمة)
        ارجع القيمة / 65536
    نهاية

    دالة رقم من_مدمج_لأخضر(رقم القيمة)
        ارجع (القيمة / 256) - ((القيمة / 65536) * 256)
    نهاية

    دالة رقم من_مدمج_لأزرق(رقم القيمة)
        ارجع القيمة - ((القيمة / 256) * 256)
    نهاية

    دالة رقم إلى_رمادي(رقم ح، رقم خ، رقم ز)
        ارجع (ح * 30 + خ * 59 + ز * 11) / 100
    نهاية

    دالة رقم اخلط_لونين(رقم لون1، رقم لون2، رقم نسبة)
        # نسبة من 0 إلى 100
        متغير ح1 = من_مدمج_لأحمر(لون1)
        متغير ح2 = من_مدمج_لأحمر(لون2)
        متغير حن = (ح1 * نسبة + ح2 * (100 - نسبة)) / 100

        متغير خ1 = من_مدمج_لأخضر(لون1)
        متغير خ2 = من_مدمج_لأخضر(لون2)
        متغير خن = (خ1 * نسبة + خ2 * (100 - نسبة)) / 100

        متغير ز1 = من_مدمج_لأزرق(لون1)
        متغير ز2 = من_مدمج_لأزرق(لون2)
        متغير زن = (ز1 * نسبة + ز2 * (100 - نسبة)) / 100

        ارجع (حن * 65536) + (خن * 256) + زن
    نهاية
نهاية

صنف لوحة_ألوان_النحل
    رقم ذهبي
    رقم بني_داكن
    رقم أبيض
    رقم أسود

    باني()
        # ألوان موضوع النحل
        ذهبي = 16768256
        بني_داكن = 4468512
        أبيض = 16777215
        أسود = 0
    نهاية

    دالة رقم اعط_الذهبي()
        ارجع ذهبي
    نهاية

    دالة رقم اعط_البني()
        ارجع بني_داكن
    نهاية

    دالة رقم اعط_الأبيض()
        ارجع أبيض
    نهاية

    دالة رقم اعط_الأسود()
        ارجع أسود
    نهاية
نهاية

