# القسم 4: نظام الأحداث (Event System)
# ═══════════════════════════════════════════════════════════════════════════

## حدث إدخال واحد (فأرة أو لوحة مفاتيح)
صنف حدث_م
    رقم النوع_ح       # نوع الحدث
    رقم بيانات1     # بيانات إضافية 1 (مثل: x الفأرة، رمز المفتاح)
    رقم بيانات2     # بيانات إضافية 2 (مثل: y الفأرة، معدّل)
    رقم الطابع_الزمني

    باني(نوع_حدث، ب1، ب2)
        هذا.النوع_ح = نوع_حدث
        هذا.بيانات1 = ب1
        هذا.بيانات2 = ب2
        هذا.الطابع_الزمني = 0
    نهاية
نهاية

## مدير الأحداث — طابور FIFO للأحداث
صنف مدير_أحداث_م
    مصفوفة الأحداث      # طابور أحداث الإدخال
    رقم عدد_أحداث_معالجة
    رقم فأرة_س           # موقع الفأرة الحالي
    رقم فأرة_ص
    منطقي فأرة_ضاغطة     # هل الزر مضغوط

    باني()
        هذا.الأحداث = []
        هذا.عدد_أحداث_معالجة = 0
        هذا.فأرة_س = 960
        هذا.فأرة_ص = 540
        هذا.فأرة_ضاغطة = خطأ
    نهاية

    ## إضافة حدث جديد للطابور
    دالة أضف_حدث(حدث_جديد)
        هذا.الأحداث += [حدث_جديد]
        ارجع 0
    نهاية

    ## سحب أول حدث من الطابور
    دالة سحب_حدث()
        اذا (طول(هذا.الأحداث) == 0)
            ارجع -1
        نهاية
        متغير أول = هذا.الأحداث[0]
        # إعادة بناء الطابور بدون أول عنصر
        متغير بقية = []
        متغير ع = 1
        بينما (ع < طول(هذا.الأحداث))
            بقية += [هذا.الأحداث[ع]]
            ع = ع + 1
        نهاية
        هذا.الأحداث = بقية
        هذا.عدد_أحداث_معالجة = هذا.عدد_أحداث_معالجة + 1
        ارجع أول
    نهاية

    ## محاكاة تحريك الفأرة
    دالة حرّك_فأرة(س_جديد، ص_جديد)
        هذا.فأرة_س = س_جديد
