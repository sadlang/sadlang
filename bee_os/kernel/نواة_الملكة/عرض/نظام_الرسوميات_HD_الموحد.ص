# ═══════════════════════════════════════════════════════════════════════════
# القسم 1: نظام الألوان المتقدم (RGBA)
# ═══════════════════════════════════════════════════════════════════════════

## صنف لون RGBA يدعم مزج الألوان والشفافية
صنف لون_م
    رقم أحمر     # 0-255
    رقم أخضر     # 0-255
    رقم أزرق     # 0-255
    رقم شفافية   # 0-255 (255 = معتم)

    باني(ح، خ، ز، ش)
        هذا.أحمر = ح
        هذا.أخضر = خ
        هذا.أزرق = ز
        هذا.شفافية = ش
    نهاية

    ## تحويل إلى قيمة عددية واحدة (32-bit RGBA)
    دالة إلى_رقم()
        ارجع هذا.أحمر * 16777216 + هذا.أخضر * 65536 + هذا.أزرق * 256 + هذا.شفافية
    نهاية

    ## مزج لونين (alpha blending)
    دالة مزج_مع(لون_آخر)
        متغير نسبة = هذا.شفافية / 255
        متغير نسبة_عكس = 1 - نسبة
        متغير ح_جديد = هذا.أحمر * نسبة + لون_آخر.أحمر * نسبة_عكس
        متغير خ_جديد = هذا.أخضر * نسبة + لون_آخر.أخضر * نسبة_عكس
        متغير ز_جديد = هذا.أزرق * نسبة + لون_آخر.أزرق * نسبة_عكس
        ارجع جديد لون_م(ح_جديد، خ_جديد، ز_جديد، 255)
    نهاية

    ## تفتيح اللون
    دالة تفتيح(نسبة)
        متغير ح = هذا.أحمر + (255 - هذا.أحمر) * نسبة
        متغير خ = هذا.أخضر + (255 - هذا.أخضر) * نسبة
        متغير ز = هذا.أزرق + (255 - هذا.أزرق) * نسبة
        ارجع جديد لون_م(ح، خ، ز، هذا.شفافية)
    نهاية

    ## تعتيم اللون
    دالة تعتيم(نسبة)
        متغير ح = هذا.أحمر * (1 - نسبة)
        متغير خ = هذا.أخضر * (1 - نسبة)
        متغير ز = هذا.أزرق * (1 - نسبة)
        ارجع جديد لون_م(ح، خ، ز، هذا.شفافية)
    نهاية

    ## مقارنة لونين
    دالة يساوي(آخر)
        ارجع هذا.أحمر == آخر.أحمر && هذا.أخضر == آخر.أخضر && هذا.أزرق == آخر.أزرق
    نهاية

    ## نسخ اللون
    دالة نسخ()
        ارجع جديد لون_م(هذا.أحمر، هذا.أخضر، هذا.أزرق، هذا.شفافية)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# القسم 2: مخزن الإطار HD (Framebuffer)
# ═══════════════════════════════════════════════════════════════════════════

## مخزن إطار بسيط يستخدم خريطة بكسلات
## نستخدم خريطة (hash map) بدلاً من مصفوفة ضخمة 2M بكسل
صنف مخزن_إطار_م
    رقم العرض
    رقم الارتفاع
    رقم عدد_البكسلات_المعدّلة
    مصفوفة بكسلات_س      # إحداثيات x للبكسلات المعدّلة
    مصفوفة بكسلات_ص      # إحداثيات y
    مصفوفة بكسلات_لون    # ألوان البكسلات
    رقم لون_الخلفية

    باني(عرض_مخزن، ارتفاع_مخزن)
        هذا.العرض = عرض_مخزن
        هذا.الارتفاع = ارتفاع_مخزن
        هذا.عدد_البكسلات_المعدّلة = 0
        هذا.بكسلات_س = []
        هذا.بكسلات_ص = []
        هذا.بكسلات_لون = []
        هذا.لون_الخلفية = لون_أسود
    نهاية

    ## رسم بكسل واحد على الشاشة
    دالة ضع_بكسل(س، ص، لون)
        اذا (س < 0 || س >= هذا.العرض || ص < 0 || ص >= هذا.الارتفاع)
            ارجع -1
        نهاية
        هذا.بكسلات_س += [س]
        هذا.بكسلات_ص += [ص]
        هذا.بكسلات_لون += [لون]
        هذا.عدد_البكسلات_المعدّلة = هذا.عدد_البكسلات_المعدّلة + 1
        ارجع 0
    نهاية

    ## مسح الشاشة بلون معيّن
    دالة مسح(لون)
        هذا.بكسلات_س = []
        هذا.بكسلات_ص = []
        هذا.بكسلات_لون = []
        هذا.عدد_البكسلات_المعدّلة = 0
        هذا.لون_الخلفية = لون
        ارجع 0
    نهاية

    ## الحصول على عدد البكسلات المرسومة
    دالة عدد_البكسلات()
        ارجع هذا.عدد_البكسلات_المعدّلة
    نهاية

    ## نقل محتويات مخزن إلى آخر (blit)
    دالة نقل_إلى(مخزن_هدف، إزاحة_س، إزاحة_ص)
        متغير ع = 0
        بينما (ع < طول(هذا.بكسلات_س))
            متغير س_جديد = هذا.بكسلات_س[ع] + إزاحة_س
            متغير ص_جديد = هذا.بكسلات_ص[ع] + إزاحة_ص
            مخزن_هدف.ضع_بكسل(س_جديد، ص_جديد، هذا.بكسلات_لون[ع])
            ع = ع + 1
        نهاية
        ارجع 0
    نهاية

    ## طباعة معلومات المخزن
    دالة طباعة_معلومات()
        اطبع("  [FB] ") اطبع(هذا.العرض) اطبع("x") اطبع(هذا.الارتفاع)
        اطبع(" بكسلات=") اطبع_سطر(هذا.عدد_البكسلات_المعدّلة)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# القسم 3: محرك الأشكال الهندسية (Shape Engine)
# ═══════════════════════════════════════════════════════════════════════════

## محرك رسم الأشكال الهندسية على مخزن الإطار
## يدعم: مستطيل، خط أفقي/عمودي، دائرة، مثلث، تعبئة متدرجة
صنف محرك_أشكال_م
    رقم أشكال_مرسومة

    باني()
        هذا.أشكال_مرسومة = 0
    نهاية

    ## رسم مستطيل مملوء
    دالة مستطيل_مملوء(مخزن، س، ص، عرض_ش، ارتفاع_ش، لون)
        متغير صف = 0
        بينما (صف < ارتفاع_ش)
            متغير عمود = 0
            بينما (عمود < عرض_ش)
                مخزن.ضع_بكسل(س + عمود، ص + صف، لون)
                عمود = عمود + 1
            نهاية
            صف = صف + 1
        نهاية
        هذا.أشكال_مرسومة = هذا.أشكال_مرسومة + 1
        ارجع 0
    نهاية

    ## رسم إطار مستطيل (حدود فقط)
    دالة مستطيل_إطار(مخزن، س، ص، عرض_ش، ارتفاع_ش، لون، سُمك)
        # الحافة العلوية
        هذا.خط_أفقي(مخزن، س، ص، عرض_ش، سُمك، لون)
        # الحافة السفلية
        هذا.خط_أفقي(مخزن، س، ص + ارتفاع_ش - سُمك، عرض_ش، سُمك، لون)
        # الحافة اليسرى
        هذا.خط_عمودي(مخزن، س، ص، سُمك، ارتفاع_ش، لون)
        # الحافة اليمنى
        هذا.خط_عمودي(مخزن، س + عرض_ش - سُمك، ص، سُمك، ارتفاع_ش، لون)
        هذا.أشكال_مرسومة = هذا.أشكال_مرسومة + 1
        ارجع 0
    نهاية

    ## رسم خط أفقي
    دالة خط_أفقي(مخزن، س، ص، طول_خط، سُمك، لون)
        متغير صف = 0
        بينما (صف < سُمك)
            متغير عمود = 0
            بينما (عمود < طول_خط)
                مخزن.ضع_بكسل(س + عمود، ص + صف، لون)
                عمود = عمود + 1
            نهاية
            صف = صف + 1
        نهاية
        ارجع 0
    نهاية

    ## رسم خط عمودي
    دالة خط_عمودي(مخزن، س، ص، سُمك، طول_خط، لون)
        متغير صف = 0
        بينما (صف < طول_خط)
            متغير عمود = 0
            بينما (عمود < سُمك)
                مخزن.ضع_بكسل(س + عمود، ص + صف، لون)
                عمود = عمود + 1
            نهاية
            صف = صف + 1
        نهاية
        ارجع 0
    نهاية

    ## رسم دائرة مملوءة (خوارزمية تقريبية)
    ## نرسم مربعاً ونتحقق من كل نقطة إذا كانت داخل الدائرة
    دالة دائرة_مملوءة(مخزن، مركز_س، مركز_ص، نصف_قطر، لون)
        متغير ص_ب = مركز_ص - نصف_قطر
        بينما (ص_ب <= مركز_ص + نصف_قطر)
            متغير س_ب = مركز_س - نصف_قطر
            بينما (س_ب <= مركز_س + نصف_قطر)
                متغير فرق_س = س_ب - مركز_س
                متغير فرق_ص = ص_ب - مركز_ص
                متغير مسافة_مربعة = فرق_س * فرق_س + فرق_ص * فرق_ص
                اذا (مسافة_مربعة <= نصف_قطر * نصف_قطر)
                    مخزن.ضع_بكسل(س_ب، ص_ب، لون)
                نهاية
                س_ب = س_ب + 1
            نهاية
            ص_ب = ص_ب + 1
        نهاية
        هذا.أشكال_مرسومة = هذا.أشكال_مرسومة + 1
        ارجع 0
    نهاية

    ## رسم مستطيل بزوايا مستديرة
    دالة مستطيل_مستدير(مخزن، س، ص، عرض_ش، ارتفاع_ش، نصف_قطر_زاوية، لون)
        # المنطقة الوسطى
        هذا.مستطيل_مملوء(مخزن، س + نصف_قطر_زاوية، ص، عرض_ش - نصف_قطر_زاوية * 2، ارتفاع_ش، لون)
        # الجوانب
        هذا.مستطيل_مملوء(مخزن، س، ص + نصف_قطر_زاوية، نصف_قطر_زاوية، ارتفاع_ش - نصف_قطر_زاوية * 2، لون)
        هذا.مستطيل_مملوء(مخزن، س + عرض_ش - نصف_قطر_زاوية، ص + نصف_قطر_زاوية، نصف_قطر_زاوية، ارتفاع_ش - نصف_قطر_زاوية * 2، لون)
        # الزوايا الأربع (ربع دائرة لكل زاوية)
        هذا.ربع_دائرة(مخزن، س + نصف_قطر_زاوية، ص + نصف_قطر_زاوية، نصف_قطر_زاوية، لون)
        هذا.ربع_دائرة(مخزن، س + عرض_ش - نصف_قطر_زاوية، ص + نصف_قطر_زاوية، نصف_قطر_زاوية، لون)
        هذا.ربع_دائرة(مخزن، س + نصف_قطر_زاوية، ص + ارتفاع_ش - نصف_قطر_زاوية، نصف_قطر_زاوية، لون)
        هذا.ربع_دائرة(مخزن، س + عرض_ش - نصف_قطر_زاوية، ص + ارتفاع_ش - نصف_قطر_زاوية، نصف_قطر_زاوية، لون)
        ارجع 0
    نهاية

    ## رسم ربع دائرة (مساعد للزوايا المستديرة)
    دالة ربع_دائرة(مخزن، مركز_س، مركز_ص، نصف_قطر، لون)
        متغير ص_ب = مركز_ص - نصف_قطر
        بينما (ص_ب <= مركز_ص)
            متغير س_ب = مركز_س - نصف_قطر
            بينما (س_ب <= مركز_س)
                متغير فرق_س = س_ب - مركز_س
                متغير فرق_ص = ص_ب - مركز_ص
                اذا (فرق_س * فرق_س + فرق_ص * فرق_ص <= نصف_قطر * نصف_قطر)
                    مخزن.ضع_بكسل(س_ب، ص_ب، لون)
                نهاية
                س_ب = س_ب + 1
            نهاية
            ص_ب = ص_ب + 1
        نهاية
        ارجع 0
    نهاية

    ## رسم تدرج لوني أفقي (من لون_ابتداء إلى لون_انتهاء)
    دالة تدرج_أفقي(مخزن، س، ص، عرض_ش، ارتفاع_ش، لون1، لون2)
        متغير عمود = 0
        بينما (عمود < عرض_ش)
            متغير نسبة_ع = 0
            اذا (عرض_ش > 1)
                نسبة_ع = عمود / (عرض_ش - 1)
            نهاية
            # حساب اللون المتدرج
            متغير ح = لون1.أحمر + (لون2.أحمر - لون1.أحمر) * نسبة_ع
            متغير خ = لون1.أخضر + (لون2.أخضر - لون1.أخضر) * نسبة_ع
            متغير ز = لون1.أزرق + (لون2.أزرق - لون1.أزرق) * نسبة_ع
            متغير لون_حسبة = جديد لون_م(ح، خ، ز، 255)
            متغير قيمة_لون = لون_حسبة.إلى_رقم()

            متغير صف = 0
            بينما (صف < ارتفاع_ش)
                مخزن.ضع_بكسل(س + عمود، ص + صف، قيمة_لون)
                صف = صف + 1
            نهاية
            عمود = عمود + 1
        نهاية
        هذا.أشكال_مرسومة = هذا.أشكال_مرسومة + 1
        ارجع 0
    نهاية
نهاية

