## نافذة رسومية مع شريط عنوان وأزرار تحكم
صنف نافذة_م
    رقم المعرف_ن
    نص العنوان
    رقم موقع_س
    رقم موقع_ص
    رقم عرض_النافذة
    رقم ارتفاع_النافذة
    رقم الحالة_ن        # عادية، مكبرة، مصغرة
    منطقي مرئية
    منطقي نشطة          # هل هي النافذة المركّزة
    رقم لون_الشريط
    رقم لون_الخلفية_ن
    رقم ارتفاع_الشريط
    مصفوفة العناصر_الداخلية   # عناصر واجهة داخل النافذة

    باني(معرف، عنوان_ن، س، ص، عرض_ن، ارتفاع_ن)
        هذا.المعرف_ن = معرف
        هذا.العنوان = عنوان_ن
        هذا.موقع_س = س
        هذا.موقع_ص = ص
        هذا.عرض_النافذة = عرض_ن
        هذا.ارتفاع_النافذة = ارتفاع_ن
        هذا.الحالة_ن = نافذة_عادية
        هذا.مرئية = صحيح
        هذا.نشطة = خطأ
        هذا.لون_الشريط = لون_شريط_عنوان
        هذا.لون_الخلفية_ن = لون_أبيض
        هذا.ارتفاع_الشريط = 30
        هذا.العناصر_الداخلية = []
    نهاية

    ## إضافة عنصر واجهة داخل النافذة
    دالة أضف_عنصر(عنصر)
        هذا.العناصر_الداخلية += [عنصر]
        ارجع 0
    نهاية

    ## تحريك النافذة
    دالة حرّك(س_جديد، ص_جديد)
        هذا.موقع_س = س_جديد
        هذا.موقع_ص = ص_جديد
        ارجع 0
    نهاية

    ## تغيير حجم النافذة
    دالة غيّر_الحجم(عرض_ن، ارتفاع_ن)
        هذا.عرض_النافذة = عرض_ن
        هذا.ارتفاع_النافذة = ارتفاع_ن
        ارجع 0
    نهاية

    ## تكبير/استعادة
    دالة بدّل_تكبير()
        اذا (هذا.الحالة_ن == نافذة_مكبرة)
            هذا.الحالة_ن = نافذة_عادية
        والا
            هذا.الحالة_ن = نافذة_مكبرة
        نهاية
        ارجع 0
    نهاية

    ## تصغير
    دالة صغّر()
        هذا.الحالة_ن = نافذة_مصغرة
        هذا.مرئية = خطأ
        ارجع 0
    نهاية

    ## هل النقطة في شريط العنوان؟
    دالة في_شريط_العنوان(س، ص)
        ارجع س >= هذا.موقع_س && س < هذا.موقع_س + هذا.عرض_النافذة && ص >= هذا.موقع_ص && ص < هذا.موقع_ص + هذا.ارتفاع_الشريط
    نهاية

    ## هل النقطة في منطقة المحتوى؟
    دالة في_المحتوى(س، ص)
        ارجع س >= هذا.موقع_س && س < هذا.موقع_س + هذا.عرض_النافذة && ص >= هذا.موقع_ص + هذا.ارتفاع_الشريط && ص < هذا.موقع_ص + هذا.ارتفاع_النافذة
    نهاية

    ## رسم النافذة كاملة
    دالة ارسم(مخزن، محرك)
        اذا (!هذا.مرئية) ارجع 0 نهاية
        # شريط العنوان
        متغير لون_شريط_فعلي = هذا.لون_الشريط
        اذا (هذا.نشطة)
            لون_شريط_فعلي = لون_ذهبي
        نهاية
        محرك.مستطيل_مملوء(مخزن، هذا.موقع_س، هذا.موقع_ص، هذا.عرض_النافذة، هذا.ارتفاع_الشريط، لون_شريط_فعلي)
        # منطقة المحتوى
        متغير ص_محتوى = هذا.موقع_ص + هذا.ارتفاع_الشريط
        متغير ارتفاع_محتوى = هذا.ارتفاع_النافذة - هذا.ارتفاع_الشريط
        محرك.مستطيل_مملوء(مخزن، هذا.موقع_س، ص_محتوى، هذا.عرض_النافذة، ارتفاع_محتوى، هذا.لون_الخلفية_ن)
        # حدود النافذة
        محرك.مستطيل_إطار(مخزن، هذا.موقع_س، هذا.موقع_ص، هذا.عرض_النافذة، هذا.ارتفاع_النافذة، لون_حدود، 2)
        # زر إغلاق (مربع أحمر صغير في الزاوية العلوية اليسرى)
        محرك.مستطيل_مملوء(مخزن، هذا.موقع_س + 5، هذا.موقع_ص + 5، 20، 20، لون_أحمر)
        ارجع 0
    نهاية
نهاية

## مدير النوافذ — يدير جميع النوافذ والتركيز والطبقات
صنف مدير_نوافذ_م
    مصفوفة النوافذ       # قائمة النوافذ (الأخيرة = أعلى z-order)
    رقم عداد_معرفات
    رقم النافذة_النشطة   # معرف النافذة المركّزة
    رقم عدد_إجراءات

    باني()
        هذا.النوافذ = []
        هذا.عداد_معرفات = 1
        هذا.النافذة_النشطة = -1
        هذا.عدد_إجراءات = 0
    نهاية

    ## إنشاء نافذة جديدة
    دالة أنشئ_نافذة(عنوان، س، ص، عرض_ن، ارتفاع_ن)
        متغير معرف = هذا.عداد_معرفات
        هذا.عداد_معرفات = هذا.عداد_معرفات + 1
        متغير نافذة = جديد نافذة_م(معرف، عنوان، س، ص، عرض_ن، ارتفاع_ن)
        هذا.النوافذ += [نافذة]
        هذا.النافذة_النشطة = معرف
        هذا.عدد_إجراءات = هذا.عدد_إجراءات + 1
        ارجع نافذة
    نهاية

    ## البحث عن نافذة بمعرفها
    دالة جد_نافذة(معرف)
        متغير ع = 0
        بينما (ع < طول(هذا.النوافذ))
            اذا (هذا.النوافذ[ع].المعرف_ن == معرف)
                ارجع هذا.النوافذ[ع]
            نهاية
            ع = ع + 1
        نهاية
        ارجع -1
    نهاية

    ## إغلاق نافذة
    دالة أغلق_نافذة(معرف)
        متغير ناتج_جديد = []
        متغير ع = 0
        بينما (ع < طول(هذا.النوافذ))
            اذا (هذا.النوافذ[ع].المعرف_ن != معرف)
                ناتج_جديد += [هذا.النوافذ[ع]]
            نهاية
            ع = ع + 1
        نهاية
        هذا.النوافذ = ناتج_جديد
        هذا.عدد_إجراءات = هذا.عدد_إجراءات + 1
        ارجع 0
    نهاية

    ## تنشيط نافذة (رفعها للأعلى)
    دالة نشّط(معرف)
        # إلغاء تنشيط الكل
        متغير ع = 0
        بينما (ع < طول(هذا.النوافذ))
            هذا.النوافذ[ع].نشطة = خطأ
            ع = ع + 1
        نهاية
        # تنشيط المطلوبة
        ع = 0
        بينما (ع < طول(هذا.النوافذ))
            اذا (هذا.النوافذ[ع].المعرف_ن == معرف)
                هذا.النوافذ[ع].نشطة = صحيح
                هذا.النافذة_النشطة = معرف
            نهاية
            ع = ع + 1
        نهاية
        هذا.عدد_إجراءات = هذا.عدد_إجراءات + 1
        ارجع 0
    نهاية

    ## رسم جميع النوافذ بترتيب Z
    دالة ارسم_الكل(مخزن، محرك)
        متغير ع = 0
        بينما (ع < طول(هذا.النوافذ))
            هذا.النوافذ[ع].ارسم(مخزن، محرك)
            ع = ع + 1
        نهاية
        ارجع 0
    نهاية

    ## عدد النوافذ المفتوحة
    دالة عدد_النوافذ()
        ارجع طول(هذا.النوافذ)
    نهاية
نهاية

