## شريط التقدم
صنف شريط_تقدم_م
    رقم موقع_س
    رقم موقع_ص
    رقم عرض_العنصر
    رقم ارتفاع_العنصر
    رقم القيمة_الحالية   # 0-100
    رقم القيمة_القصوى    # عادة 100
    رقم لون_الخلفية_ع
    رقم لون_التقدم
    منطقي مرئي

    باني(س، ص، عرض_ع، ارتفاع_ع)
        هذا.موقع_س = س
        هذا.موقع_ص = ص
        هذا.عرض_العنصر = عرض_ع
        هذا.ارتفاع_العنصر = ارتفاع_ع
        هذا.القيمة_الحالية = 0
        هذا.القيمة_القصوى = 100
        هذا.لون_الخلفية_ع = لون_رمادي_غامق
        هذا.لون_التقدم = لون_أخضر
        هذا.مرئي = صحيح
    نهاية

    ## تعيين النسبة المئوية
    دالة عيّن_قيمة(قيمة)
        اذا (قيمة < 0) قيمة = 0 نهاية
        اذا (قيمة > هذا.القيمة_القصوى) قيمة = هذا.القيمة_القصوى نهاية
        هذا.القيمة_الحالية = قيمة
        ارجع 0
    نهاية

    ## رسم الشريط
    دالة ارسم(مخزن، محرك)
        اذا (!هذا.مرئي) ارجع 0 نهاية
        # خلفية الشريط
        محرك.مستطيل_مملوء(مخزن، هذا.موقع_س، هذا.موقع_ص، هذا.عرض_العنصر، هذا.ارتفاع_العنصر، هذا.لون_الخلفية_ع)
        # الجزء المملوء
        متغير نسبة = هذا.القيمة_الحالية / هذا.القيمة_القصوى
        # حساب العرض المملوء بدون أعداد عشرية في الفهارس
        متغير عرض_مملوء = هذا.عرض_العنصر * هذا.القيمة_الحالية
        # قسمة يدوية لتجنب الأعداد العشرية
        متغير ناتج_قسمة = 0
        متغير عداد_ق = 0
        بينما (عداد_ق * هذا.القيمة_القصوى <= عرض_مملوء)
            ناتج_قسمة = عداد_ق
            عداد_ق = عداد_ق + 1
        نهاية
        اذا (ناتج_قسمة > 0)
            محرك.مستطيل_مملوء(مخزن، هذا.موقع_س، هذا.موقع_ص، ناتج_قسمة، هذا.ارتفاع_العنصر، هذا.لون_التقدم)
        نهاية
        ارجع 0
    نهاية
نهاية

