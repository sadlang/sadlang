# الشفافية.ص - مزج الشفافية (Alpha Blending)
# نظام خلية النحل - نواة الملكة / عرض
# عمليات دمج البكسلات مع الشفافية
# ══════════════════════════════════════════════════════════════════════

صنف لون_شفاف
    رقم أحمر
    رقم أخضر
    رقم أزرق
    رقم ألفا

    باني(رقم ح، رقم خ، رقم ز، رقم ش)
        أحمر = ح
        أخضر = خ
        أزرق = ز
        ألفا = ش
    نهاية

    دالة رقم اعط_أحمر()
        ارجع أحمر
    نهاية

    دالة رقم اعط_أخضر()
        ارجع أخضر
    نهاية

    دالة رقم اعط_أزرق()
        ارجع أزرق
    نهاية

    دالة رقم اعط_ألفا()
        ارجع ألفا
    نهاية

    دالة رقم هل_معتم()
        اذا (ألفا == 255)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم هل_شفاف_كليا()
        اذا (ألفا == 0)
            ارجع 1
        نهاية
        ارجع 0
    نهاية
نهاية

صنف مازج_ألفا
    رقم عدد_عمليات_المزج

    باني()
        عدد_عمليات_المزج = 0
    نهاية

    دالة رقم امزج_مكون(رقم أمامي، رقم خلفي، رقم ألفا_أمامي)
        # الصيغة: نتيجة = (أمامي * ألفا + خلفي * (255 - ألفا)) / 255
        متغير نتيجة = (أمامي * ألفا_أمامي + خلفي * (255 - ألفا_أمامي)) / 255
        ارجع نتيجة
    نهاية

    دالة رقم امزج_بكسل(رقم أمامي_ح، رقم أمامي_خ، رقم أمامي_ز، رقم ألفا_أمامي، رقم خلفي_ح، رقم خلفي_خ، رقم خلفي_ز)
        متغير ح = امزج_مكون(أمامي_ح، خلفي_ح، ألفا_أمامي)
        متغير خ = امزج_مكون(أمامي_خ، خلفي_خ، ألفا_أمامي)
        متغير ز = امزج_مكون(أمامي_ز، خلفي_ز، ألفا_أمامي)
        عدد_عمليات_المزج = عدد_عمليات_المزج + 1
        ارجع (ح * 65536) + (خ * 256) + ز
    نهاية

    دالة رقم اعط_عدد_العمليات()
        ارجع عدد_عمليات_المزج
    نهاية
نهاية

صنف طبقة_عرض
    رقم العرض
    رقم الارتفاع
    رقم مستوى_الشفافية
    رقم مرئية

    باني(رقم عرض_الطبقة، رقم ارتفاع_الطبقة، رقم الشفافية)
        العرض = عرض_الطبقة
        الارتفاع = ارتفاع_الطبقة
        مستوى_الشفافية = الشفافية
        مرئية = 1
    نهاية

    دالة رقم اعط_العرض()
        ارجع العرض
    نهاية

    دالة رقم اعط_الارتفاع()
        ارجع الارتفاع
    نهاية

    دالة رقم اعط_الشفافية()
        ارجع مستوى_الشفافية
    نهاية

    دالة رقم غير_الشفافية(رقم مستوى_جديد)
        اذا (مستوى_جديد < 0)
            مستوى_الشفافية = 0
        والا
            اذا (مستوى_جديد > 255)
                مستوى_الشفافية = 255
            والا
                مستوى_الشفافية = مستوى_جديد
            نهاية
        نهاية
        ارجع مستوى_الشفافية
    نهاية

    دالة رقم هل_مرئية()
        ارجع مرئية
    نهاية
نهاية

