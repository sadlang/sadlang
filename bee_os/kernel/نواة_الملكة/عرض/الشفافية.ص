دالة رئيسية()
    متغير لون1 = جديد لون_شفاف(255، 0، 0، 128)
    اطبع("  أحمر شفاف - ألفا: ")
    اطبع_سطر(لون1.اعط_ألفا())
    اطبع("  هل معتم: ")
    اطبع_سطر(لون1.هل_معتم())

    متغير مازج = جديد مازج_ألفا()
    متغير نتيجة_مكون = مازج.امزج_مكون(255، 0، 128)
    اطبع("  مزج مكون (255,0,a=128): ")
    اطبع_سطر(نتيجة_مكون)
    متغير نتيجة = مازج.امزج_بكسل(255، 0، 0، 128، 0، 0، 255)
    اطبع("  مزج أحمر+أزرق: ")
    اطبع_سطر(نتيجة)
    اطبع("  عدد العمليات: ")
    اطبع_سطر(مازج.اعط_عدد_العمليات())

    متغير طبقة = جديد طبقة_عرض(640، 480، 200)
    طبقة.غير_الشفافية(180)
    اطبع("  شفافية الطبقة: ")
    اطبع_سطر(طبقة.اعط_الشفافية())

    اطبع_سطر("  ✅ الشفافية يعمل")
    ارجع 0
نهاية
