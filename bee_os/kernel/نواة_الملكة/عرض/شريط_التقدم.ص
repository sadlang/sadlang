# شريط_التقدم.ص - شريط التقدم
# نظام خلية النحل - نواة الملكة / عرض
# عرض تقدم العمليات بشريط مرئي
# ══════════════════════════════════════════════════════════════════════

صنف تقدم_عملية
    رقم القيمة_الحالية
    رقم القيمة_القصوى
    نص وصف_العملية

    باني(رقم الحد_الأقصى، نص الوصف)
        القيمة_الحالية = 0
        القيمة_القصوى = الحد_الأقصى
        وصف_العملية = الوصف
    نهاية

    دالة رقم تقدم(رقم مقدار)
        القيمة_الحالية = القيمة_الحالية + مقدار
        اذا (القيمة_الحالية > القيمة_القصوى)
            القيمة_الحالية = القيمة_القصوى
        نهاية
        ارجع القيمة_الحالية
    نهاية

    دالة رقم نسبة_مئوية()
        اذا (القيمة_القصوى == 0)
            ارجع 0
        نهاية
        ارجع (القيمة_الحالية * 100) / القيمة_القصوى
    نهاية

    دالة رقم اكتمل()
        اذا (القيمة_الحالية >= القيمة_القصوى)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة نص اعط_الوصف()
        ارجع وصف_العملية
    نهاية
نهاية

صنف شريط_مرئي
    رقم موضع_س
    رقم موضع_ص
    رقم العرض_الكلي
    رقم الارتفاع
    رقم لون_الإطار
    رقم لون_التعبئة
    رقم لون_الخلفية

    باني(رقم س، رقم ص، رقم العرض، رقم ارت)
        موضع_س = س
        موضع_ص = ص
        العرض_الكلي = العرض
        الارتفاع = ارت
        لون_الإطار = 16777215
        لون_التعبئة = 16768256
        لون_الخلفية = 2236962
    نهاية

    دالة رقم عرض_التعبئة(رقم نسبة)
        اذا (نسبة > 100)
            ارجع العرض_الكلي - 4
        نهاية
        ارجع ((العرض_الكلي - 4) * نسبة) / 100
    نهاية

    دالة رقم اعط_موضع_س()
        ارجع موضع_س
    نهاية

    دالة رقم اعط_موضع_ص()
        ارجع موضع_ص
    نهاية

    دالة رقم اعط_لون_التعبئة()
        ارجع لون_التعبئة
    نهاية

    دالة رقم اعط_العرض()
        ارجع العرض_الكلي
    نهاية
نهاية

صنف مدير_تقدم_الإقلاع
    رقم عدد_المراحل
    رقم المرحلة_الحالية
    نص مرحلة_وصف

    باني(رقم إجمالي_المراحل)
        عدد_المراحل = إجمالي_المراحل
        المرحلة_الحالية = 0
        مرحلة_وصف = "بدء الإقلاع"
    نهاية

    دالة رقم المرحلة_التالية(نص وصف_جديد)
        اذا (المرحلة_الحالية >= عدد_المراحل)
            ارجع 100
        نهاية
        المرحلة_الحالية = المرحلة_الحالية + 1
        مرحلة_وصف = وصف_جديد
        ارجع (المرحلة_الحالية * 100) / عدد_المراحل
    نهاية

    دالة نص اعط_الوصف()
        ارجع مرحلة_وصف
    نهاية

    دالة رقم اعط_المرحلة()
        ارجع المرحلة_الحالية
    نهاية

    دالة رقم نسبة_الاكتمال()
        ارجع (المرحلة_الحالية * 100) / عدد_المراحل
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير تقدم = جديد تقدم_عملية(100، "تحميل النظام")
    تقدم.تقدم(25)
    تقدم.تقدم(30)
    اطبع("  النسبة: ")
    اطبع_سطر(تقدم.نسبة_مئوية())
    اطبع("  الوصف: ")
    اطبع_سطر(تقدم.اعط_الوصف())

    متغير شريط = جديد شريط_مرئي(170، 400، 300، 20)
    اطبع("  عرض التعبئة 55%: ")
    اطبع_سطر(شريط.عرض_التعبئة(55))
    اطبع("  لون التعبئة: ")
    اطبع_سطر(شريط.اعط_لون_التعبئة())

    متغير مدير = جديد مدير_تقدم_الإقلاع(5)
    مدير.المرحلة_التالية("تهيئة الذاكرة")
    مدير.المرحلة_التالية("تحميل برامج التشغيل")
    اطبع("  مرحلة: ")
    اطبع_سطر(مدير.اعط_الوصف())
    اطبع("  النسبة: ")
    اطبع_سطر(مدير.نسبة_الاكتمال())

    اطبع_سطر("  ✅ شريط_التقدم يعمل")
    ارجع 0
نهاية
