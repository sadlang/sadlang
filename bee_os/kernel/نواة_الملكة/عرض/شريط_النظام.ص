# ══════════════════════════════════════════════════════════════════════════════
# شريط_النظام.ص - أدوات شريط النظام (System Tray) لنظام خلية النحل
# BeeOS System Tray Widgets - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296

# ──────────────────────────────────────────────────────────────────
# صنف أداة صغيرة
# ──────────────────────────────────────────────────────────────────
صنف أداة_شريط
    نص اسم
    رقم لون
    رقم مفعل
    رقم قيمة

    باني(اسم_أ، لون_أ، مفعل_أ، قيمة_أ)
        هذا.اسم = اسم_أ
        هذا.لون = لون_أ
        هذا.مفعل = مفعل_أ
        هذا.قيمة = قيمة_أ
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# صنف شريط النظام
# ──────────────────────────────────────────────────────────────────
صنف شريط_نظام
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    مصفوفة أدوات
    رقم لوحة_مفتوحة
    رقم ساعة
    رقم دقيقة
    رقم بطارية
    رقم مستوى_صوت

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.لوحة_مفتوحة = 0
        هذا.ساعة = 14
        هذا.دقيقة = 30
        هذا.بطارية = 72
        هذا.مستوى_صوت = 65

        هذا.أدوات = []
        هذا.أدوات = هذا.أدوات + [جديد أداة_شريط("WiFi", ل_أخضر، 1، 85)]
        هذا.أدوات = هذا.أدوات + [جديد أداة_شريط("Bluetooth", ل_أزرق_غ، 1، 0)]
        هذا.أدوات = هذا.أدوات + [جديد أداة_شريط("Airplane", ل_برتقالي، 0، 0)]
        هذا.أدوات = هذا.أدوات + [جديد أداة_شريط("DND", ل_أحمر، 0، 0)]
        هذا.أدوات = هذا.أدوات + [جديد أداة_شريط("Night", ل_أصفر، 0، 0)]
        هذا.أدوات = هذا.أدوات + [جديد أداة_شريط("Screen", ل_أبيض، 1، 50)]
    نهاية

    # رسم شريط المهام
    دالة رسم_شريط(ف)
        متغير لون_شريط = امزج_لون(ل_أسود، ل_أزرق_غ، 30)
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، لون_شريط)
        ارسم_خط_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، ارت_شاشة - 40، ل_رمادي_غ)

        # زر ابدأ
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، 50، 40، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، 10، ارت_شاشة - 30، "BEE"، 1، ل_أبيض)

        # منطقة الإشعارات (يمين)
        متغير تراي_x = عرض_شاشة - 250

        # واي فاي
        اذا (هذا.أدوات[0].مفعل)
            ارسم_دائرة_مصمتة(ف، تراي_x، ارت_شاشة - 20، 4، ل_أخضر)
        والا
            ارسم_دائرة_مصمتة(ف، تراي_x، ارت_شاشة - 20، 4، ل_رمادي_غ)
        نهاية
        تراي_x = تراي_x + 18

        # بلوتوث
        اذا (هذا.أدوات[1].مفعل)
            ارسم_نص_أصلي(ف، تراي_x، ارت_شاشة - 28، "B"، 1، ل_أزرق_غ)
        نهاية
        تراي_x = تراي_x + 18

        # فاصل
        ارسم_خط_أصلي(ف، تراي_x، ارت_شاشة - 35، تراي_x، ارت_شاشة - 5، ل_رمادي_غ)
        تراي_x = تراي_x + 10

        # صوت
        ارسم_نص_أصلي(ف، تراي_x، ارت_شاشة - 28، "Vol"، 1، ل_أبيض)
        تراي_x = تراي_x + 30

        # بطارية
        ارسم_مستطيل_أصلي(ف، تراي_x، ارت_شاشة - 30، 25، 14، ل_أسود)
        ارسم_إطار_أصلي(ف، تراي_x، ارت_شاشة - 30، 25، 14، 1، ل_أبيض)
        متغير ملء = 21 * هذا.بطارية / 100
        متغير لون_ب = ل_أخضر
        اذا (هذا.بطارية < 20)
            لون_ب = ل_أحمر
        نهاية
        ارسم_مستطيل_أصلي(ف، تراي_x + 2، ارت_شاشة - 28، ملء، 10، لون_ب)
        تراي_x = تراي_x + 30
        ارسم_نص_أصلي(ف، تراي_x، ارت_شاشة - 28، "" + هذا.بطارية + "%"، 1، ل_أبيض)
        تراي_x = تراي_x + 35

        # فاصل
        ارسم_خط_أصلي(ف، تراي_x، ارت_شاشة - 35، تراي_x، ارت_شاشة - 5، ل_رمادي_غ)
        تراي_x = تراي_x + 10

        # ساعة
        متغير نص_ساعة = "" + هذا.ساعة
        متغير نص_دقيقة = ""
        اذا (هذا.دقيقة < 10)
            نص_دقيقة = "0" + هذا.دقيقة
        والا
            نص_دقيقة = "" + هذا.دقيقة
        نهاية
        ارسم_نص_أصلي(ف، تراي_x، ارت_شاشة - 28، نص_ساعة + ":" + نص_دقيقة، 1، ل_أبيض)

        ارجع 1
    نهاية

    # رسم لوحة الإعدادات السريعة
    دالة رسم_لوحة(ف)
        اذا (!هذا.لوحة_مفتوحة)
            ارجع 0
        نهاية

        متغير لوحة_ع = 350
        متغير لوحة_ا = 400
        متغير لوحة_x = عرض_شاشة - لوحة_ع - 10
        متغير لوحة_y = ارت_شاشة - 40 - لوحة_ا - 5

        # خلفية
        متغير لون_لوحة = امزج_لون(ل_أسود، ل_أزرق_غ، 40)
        ارسم_مستطيل_أصلي(ف، لوحة_x، لوحة_y، لوحة_ع، لوحة_ا، لون_لوحة)
        ارسم_إطار_أصلي(ف، لوحة_x، لوحة_y، لوحة_ع، لوحة_ا، 2، ل_رمادي_غ)

        # عنوان
        ارسم_نص_أصلي(ف، لوحة_x + 15، لوحة_y + 12، "Quick Settings"، 2، ل_أصفر)

        # شبكة أدوات التبديل (3x2)
        متغير gx = لوحة_x + 15
        متغير gy = لوحة_y + 50
        متغير عمود = 0
        متغير ت = 0
        بينما (ت < طول(هذا.أدوات))
            متغير أداة = هذا.أدوات[ت]
            متغير بطاقة_x = gx + عمود * 108
            متغير بطاقة_y = gy

            # بطاقة الأداة
            اذا (أداة.مفعل)
                ارسم_مستطيل_أصلي(ف، بطاقة_x، بطاقة_y، 100، 65، امزج_لون(أداة.لون، ل_أسود، 60))
                ارسم_إطار_أصلي(ف، بطاقة_x، بطاقة_y، 100، 65، 1، أداة.لون)
            والا
                ارسم_مستطيل_أصلي(ف، بطاقة_x، بطاقة_y، 100، 65، ل_رمادي_غ)
                ارسم_إطار_أصلي(ف، بطاقة_x، بطاقة_y، 100، 65، 1، ل_رمادي)
            نهاية

            # أيقونة
            ارسم_دائرة_مصمتة(ف، بطاقة_x + 50، بطاقة_y + 22، 12، أداة.لون)

            # اسم
            ارسم_نص_أصلي(ف، بطاقة_x + 15، بطاقة_y + 45، أداة.اسم، 1، ل_أبيض)

            عمود = عمود + 1
            اذا (عمود >= 3)
                عمود = 0
                gy = gy + 75
            نهاية
            ت = ت + 1
        نهاية

        # شريط السطوع
        متغير slider_y = لوحة_y + 220
        ارسم_نص_أصلي(ف، لوحة_x + 15، slider_y، "Brightness"، 1، ل_رمادي)
        ارسم_مستطيل_أصلي(ف، لوحة_x + 15، slider_y + 20، 320، 8، ل_رمادي_غ)
        متغير سطوع_ملء = 320 * 80 / 100
        ارسم_مستطيل_أصلي(ف، لوحة_x + 15، slider_y + 20، سطوع_ملء، 8، ل_أصفر)
        ارسم_دائرة_مصمتة(ف، لوحة_x + 15 + سطوع_ملء، slider_y + 24، 8، ل_أبيض)

        # شريط الصوت
        slider_y = slider_y + 50
        ارسم_نص_أصلي(ف، لوحة_x + 15، slider_y، "Volume"، 1، ل_رمادي)
        ارسم_مستطيل_أصلي(ف، لوحة_x + 15، slider_y + 20، 320، 8، ل_رمادي_غ)
        متغير صوت_ملء = 320 * هذا.مستوى_صوت / 100
        ارسم_مستطيل_أصلي(ف، لوحة_x + 15، slider_y + 20، صوت_ملء، 8، ل_أزرق_غ)
        ارسم_دائرة_مصمتة(ف، لوحة_x + 15 + صوت_ملء، slider_y + 24، 8، ل_أبيض)

        # معلومات المستخدم
        slider_y = slider_y + 55
        ارسم_خط_أصلي(ف، لوحة_x + 15، slider_y، لوحة_x + لوحة_ع - 15، slider_y، ل_رمادي_غ)
        ارسم_دائرة_مصمتة(ف، لوحة_x + 30، slider_y + 22، 12، ل_رمادي)
        ارسم_نص_أصلي(ف، لوحة_x + 50، slider_y + 15، "BeeOS User"، 1، ل_أبيض)

        # أزرار الطاقة
        ارسم_مستطيل_أصلي(ف، لوحة_x + لوحة_ع - 90، slider_y + 8، 30، 25، ل_أحمر)
        ارسم_نص_أصلي(ف، لوحة_x + لوحة_ع - 82، slider_y + 12، "O"، 1، ل_أبيض)
        ارسم_مستطيل_أصلي(ف، لوحة_x + لوحة_ع - 50، slider_y + 8، 30، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، لوحة_x + لوحة_ع - 42، slider_y + 12، "L"، 1، ل_أبيض)

        ارجع 1
    نهاية

    # رسم الشاشة
    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة - 40، ل_أزرق_غ، ل_أسود)
        هذا.رسم_شريط(ف)
        هذا.رسم_لوحة(ف)

        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)
        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS System Tray ===")

    متغير شريط = جديد شريط_نظام()
    اطبع_سطر("[TRAY] Initialized with " + طول(شريط.أدوات) + " widgets")

    # إطار 1: شريط فقط
    اطبع_سطر("-- Frame 1: Tray bar only --")
    شريط.رسم(1)
    شريط.تصدير("C:\\beeos_tray.ppm")

    # إطار 2: لوحة مفتوحة
    اطبع_سطر("-- Frame 2: Quick settings open --")
    شريط.لوحة_مفتوحة = 1
    شريط.رسم(2)
    شريط.تصدير("C:\\beeos_tray_open.ppm")

    # إطار 3: تغيير إعدادات
    اطبع_سطر("-- Frame 3: Toggled settings --")
    شريط.أدوات[2].مفعل = 1
    شريط.أدوات[4].مفعل = 1
    شريط.رسم(3)
    شريط.تصدير("C:\\beeos_tray_toggle.ppm")

    متغير أسود = عد_بكسلات(شريط.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("=== System Tray: SUCCESS ===")
    ارجع 0
نهاية
