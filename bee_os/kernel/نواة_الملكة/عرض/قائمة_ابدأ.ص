# ══════════════════════════════════════════════════════════════════════════════
# قائمة_ابدأ.ص - قائمة ابدأ لنظام خلية النحل
# BeeOS Start Menu - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

# ألوان
متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296

# ──────────────────────────────────────────────────────────────────
# صنف عنصر التطبيق
# ──────────────────────────────────────────────────────────────────
صنف عنصر_تطبيق
    نص اسم
    نص وصف
    رقم لون_أيقونة
    رقم مثبت

    باني(اسم_تطبيق، وصف_تطبيق، لون، تثبيت)
        هذا.اسم = اسم_تطبيق
        هذا.وصف = وصف_تطبيق
        هذا.لون_أيقونة = لون
        هذا.مثبت = تثبيت
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# صنف قائمة ابدأ
# ──────────────────────────────────────────────────────────────────
صنف قائمة_ابدأ
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    رقم مفتوحة
    رقم عنصر_محدد
    مصفوفة تطبيقات
    رقم قائمة_x
    رقم قائمة_y
    رقم قائمة_ع
    رقم قائمة_ا

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مفتوحة = 0
        هذا.عنصر_محدد = -1
        هذا.تطبيقات = []
        هذا.قائمة_x = 0
        هذا.قائمة_y = ارت_شاشة - 40 - 600
        هذا.قائمة_ع = 350
        هذا.قائمة_ا = 600

        # إضافة التطبيقات
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Browser", "Web browser", ل_أزرق_غ، 1)]
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Calculator", "Math tool", ل_أخضر، 1)]
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Editor", "Code editor", ل_أصفر، 1)]
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Files", "File manager", ل_برتقالي، 1)]
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Terminal", "System shell", ل_رمادي_غ، 1)]
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Settings", "System config", ل_رمادي، 0)]
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Task Mgr", "Process viewer", ل_أحمر، 0)]
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Notes", "Text editor", ل_أبيض، 0)]
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Image View", "Photo viewer", ل_أخضر، 0)]
        هذا.تطبيقات = هذا.تطبيقات + [جديد عنصر_تطبيق("Monitor", "System monitor", ل_أزرق_غ، 0)]
    نهاية

    # رسم شريط المهام
    دالة رسم_شريط_مهام(ف)
        # خلفية الشريط
        متغير لون_شريط = امزج_لون(ل_أسود، ل_أزرق_غ، 30)
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، لون_شريط)
        ارسم_خط_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، ارت_شاشة - 40، ل_رمادي_غ)

        # زر ابدأ (نحلة)
        اذا (هذا.مفتوحة)
            ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، 50، 40، ل_أصفر)
            ارسم_نص_أصلي(ف، 10، ارت_شاشة - 30، "BEE"، 1، ل_أسود)
        والا
            ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، 50، 40، ل_رمادي_غ)
            ارسم_نص_أصلي(ف، 10، ارت_شاشة - 30، "BEE"، 1، ل_أبيض)
        نهاية

        # ساعة في الشريط (يمين)
        ارسم_نص_أصلي(ف، عرض_شاشة - 80، ارت_شاشة - 28، "12:00"، 1، ل_أبيض)

        # فاصل قبل الساعة
        ارسم_خط_أصلي(ف، عرض_شاشة - 100، ارت_شاشة - 35، عرض_شاشة - 100، ارت_شاشة - 5، ل_رمادي_غ)

        ارجع 1
    نهاية

    # رسم أيقونة تطبيق مصغرة
    دالة رسم_أيقونة(ف، x، y، لون)
        ارسم_مستطيل_أصلي(ف، x + 4، y + 4، 24، 24، لون)
        ارسم_إطار_أصلي(ف، x + 4، y + 4، 24، 24، 1، ل_أبيض)
        ارجع 1
    نهاية

    # رسم قائمة ابدأ
    دالة رسم_قائمة(ف)
        اذا (!هذا.مفتوحة)
            ارجع 0
        نهاية

        متغير mx = هذا.قائمة_x
        متغير my = هذا.قائمة_y
        متغير mw = هذا.قائمة_ع
        متغير mh = هذا.قائمة_ا

        # خلفية القائمة
        متغير لون_قائمة = امزج_لون(ل_أسود، ل_أزرق_غ، 50)
        ارسم_مستطيل_أصلي(ف، mx، my، mw، mh، لون_قائمة)
        ارسم_إطار_أصلي(ف، mx، my، mw، mh، 2، ل_أصفر)

        # عنوان القائمة
        ارسم_مستطيل_أصلي(ف، mx + 2، my + 2، mw - 4، 40، ل_أصفر)
        ارسم_نص_أصلي(ف، mx + 15، my + 12، "BeeOS Start"، 2، ل_أسود)

        # شريط البحث
        ارسم_مستطيل_أصلي(ف، mx + 15، my + 50، mw - 30، 30، ل_أسود)
        ارسم_إطار_أصلي(ف، mx + 15، my + 50، mw - 30، 30، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، mx + 25، my + 58، "Search apps..."، 1، ل_رمادي_غ)

        # قسم التطبيقات المثبتة
        ارسم_نص_أصلي(ف، mx + 15، my + 95، "Pinned"، 1، ل_أصفر)
        ارسم_خط_أصلي(ف، mx + 15، my + 110، mx + mw - 15، my + 110، ل_رمادي_غ)

        # رسم التطبيقات المثبتة (شبكة 3x2)
        متغير مثبت_x = mx + 20
        متغير مثبت_y = my + 120
        متغير عمود = 0
        متغير ت = 0
        بينما (ت < طول(هذا.تطبيقات))
            متغير تطبيق = هذا.تطبيقات[ت]
            اذا (تطبيق.مثبت == 1)
                متغير ix = مثبت_x + عمود * 105
                متغير iy = مثبت_y

                # خلفية العنصر
                اذا (هذا.عنصر_محدد == ت)
                    ارسم_مستطيل_أصلي(ف، ix، iy، 95، 70، امزج_لون(ل_أصفر، ل_أسود، 70))
                نهاية

                # أيقونة
                ارسم_مستطيل_أصلي(ف، ix + 30، iy + 5، 35، 35، تطبيق.لون_أيقونة)
                ارسم_إطار_أصلي(ف، ix + 30، iy + 5، 35، 35، 1، ل_أبيض)

                # اسم
                ارسم_نص_أصلي(ف، ix + 10، iy + 50، تطبيق.اسم، 1، ل_أبيض)

                عمود = عمود + 1
                اذا (عمود >= 3)
                    عمود = 0
                    مثبت_y = مثبت_y + 80
                نهاية
            نهاية
            ت = ت + 1
        نهاية

        # قسم كل التطبيقات
        متغير قائمة_y2 = my + 300
        ارسم_نص_أصلي(ف، mx + 15، قائمة_y2، "All Apps"، 1، ل_أصفر)
        ارسم_خط_أصلي(ف، mx + 15، قائمة_y2 + 15، mx + mw - 15، قائمة_y2 + 15، ل_رمادي_غ)

        # قائمة كل التطبيقات
        متغير عنصر_y = قائمة_y2 + 25
        متغير ي = 0
        بينما (ي < طول(هذا.تطبيقات))
            متغير تطبيق2 = هذا.تطبيقات[ي]

            # تظليل العنصر المحدد
            اذا (هذا.عنصر_محدد == ي)
                ارسم_مستطيل_أصلي(ف، mx + 5، عنصر_y - 3، mw - 10، 28، امزج_لون(ل_أصفر، ل_أسود، 60))
            نهاية

            # أيقونة صغيرة
            هذا.رسم_أيقونة(ف، mx + 15، عنصر_y، تطبيق2.لون_أيقونة)

            # اسم + وصف
            ارسم_نص_أصلي(ف، mx + 50، عنصر_y + 5، تطبيق2.اسم، 1، ل_أبيض)
            ارسم_نص_أصلي(ف، mx + 150، عنصر_y + 5، تطبيق2.وصف، 1، ل_رمادي_غ)

            عنصر_y = عنصر_y + 28
            ي = ي + 1
        نهاية

        # شريط الطاقة أسفل القائمة
        متغير طاقة_y = my + mh - 45
        ارسم_خط_أصلي(ف، mx + 15، طاقة_y، mx + mw - 15، طاقة_y، ل_رمادي_غ)

        # صورة المستخدم
        ارسم_دائرة_مصمتة(ف، mx + 30، طاقة_y + 22، 12، ل_رمادي)
        ارسم_نص_أصلي(ف، mx + 50، طاقة_y + 15، "BeeOS User"، 1، ل_أبيض)

        # أزرار الطاقة
        # إيقاف
        ارسم_مستطيل_أصلي(ف، mx + mw - 90، طاقة_y + 8، 30، 25، ل_أحمر)
        ارسم_نص_أصلي(ف، mx + mw - 85، طاقة_y + 12، "OFF"، 1، ل_أبيض)
        # إعادة تشغيل
        ارسم_مستطيل_أصلي(ف، mx + mw - 50، طاقة_y + 8، 35، 25، ل_برتقالي)
        ارسم_نص_أصلي(ف، mx + mw - 48، طاقة_y + 12، "RST"، 1، ل_أبيض)

        ارجع 1
    نهاية

    # رسم سطح المكتب خلف القائمة
    دالة رسم_خلفية(ف)
        # تدرج سطح المكتب
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة - 40، ل_أزرق_غ، ل_أسود)

        # بعض أيقونات سطح المكتب
        متغير أيقونة_x = 40
        متغير أيقونة_y = 40

        # أيقونة المتصفح
        ارسم_مستطيل_أصلي(ف، أيقونة_x، أيقونة_y، 48، 48، ل_أزرق_غ)
        ارسم_إطار_أصلي(ف، أيقونة_x، أيقونة_y، 48، 48، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، أيقونة_x + 5، أيقونة_y + 55، "Browser"، 1، ل_أبيض)

        # أيقونة المحرر
        أيقونة_y = أيقونة_y + 90
        ارسم_مستطيل_أصلي(ف، أيقونة_x، أيقونة_y، 48، 48، ل_أصفر)
        ارسم_إطار_أصلي(ف، أيقونة_x، أيقونة_y، 48، 48، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، أيقونة_x + 5، أيقونة_y + 55، "Editor"، 1، ل_أبيض)

        # أيقونة الآلة الحاسبة
        أيقونة_y = أيقونة_y + 90
        ارسم_مستطيل_أصلي(ف، أيقونة_x، أيقونة_y، 48، 48، ل_أخضر)
        ارسم_إطار_أصلي(ف، أيقونة_x، أيقونة_y، 48، 48، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، أيقونة_x + 2، أيقونة_y + 55، "Calc"، 1، ل_أبيض)

        ارجع 1
    نهاية

    # إطار كامل
    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        هذا.رسم_خلفية(ف)
        هذا.رسم_شريط_مهام(ف)
        هذا.رسم_قائمة(ف)

        # swap buffer
        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)

        ارجع 1
    نهاية

    دالة فتح()
        هذا.مفتوحة = 1
        هذا.عنصر_محدد = -1
    نهاية

    دالة غلق()
        هذا.مفتوحة = 0
        هذا.عنصر_محدد = -1
    نهاية

    دالة حدد_عنصر(فهرس)
        هذا.عنصر_محدد = فهرس
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS Start Menu ===")
    اطبع_سطر("")

    متغير قائمة = جديد قائمة_ابدأ()
    اطبع_سطر("[MENU] Initialized with " + طول(قائمة.تطبيقات) + " apps")

    # إطار 1: سطح المكتب بدون قائمة
    اطبع_سطر("")
    اطبع_سطر("-- Frame 1: Desktop (menu closed) --")
    قائمة.رسم(1)
    قائمة.تصدير("C:\\beeos_menu_closed.ppm")
    اطبع_سطر("  Exported: menu closed")

    # إطار 2: فتح القائمة
    اطبع_سطر("")
    اطبع_سطر("-- Frame 2: Menu opened --")
    قائمة.فتح()
    قائمة.رسم(2)
    قائمة.تصدير("C:\\beeos_menu_open.ppm")
    اطبع_سطر("  Exported: menu open")

    # إطار 3: تحديد تطبيق
    اطبع_سطر("")
    اطبع_سطر("-- Frame 3: App selected (Browser) --")
    قائمة.حدد_عنصر(0)
    قائمة.رسم(3)
    اطبع_سطر("  Selected: Browser")

    # إطار 4: تحديد تطبيق آخر
    اطبع_سطر("")
    اطبع_سطر("-- Frame 4: App selected (Calculator) --")
    قائمة.حدد_عنصر(1)
    قائمة.رسم(4)
    اطبع_سطر("  Selected: Calculator")

    # إطار 5: تحديد تطبيق آخر
    اطبع_سطر("")
    اطبع_سطر("-- Frame 5: App selected (Settings) --")
    قائمة.حدد_عنصر(5)
    قائمة.رسم(5)
    اطبع_سطر("  Selected: Settings")

    # إطار 6: إغلاق القائمة
    اطبع_سطر("")
    اطبع_سطر("-- Frame 6: Menu closed --")
    قائمة.غلق()
    قائمة.رسم(6)
    قائمة.تصدير("C:\\beeos_menu_final.ppm")
    اطبع_سطر("  Exported: menu closed again")

    # إحصائيات
    اطبع_سطر("")
    متغير أسود = عد_بكسلات(قائمة.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("  Total pixels: ")
    اطبع_سطر(إجمالي)
    اطبع("  Non-black: ")
    اطبع_سطر(إجمالي - أسود)
    اطبع("  Total apps: ")
    اطبع_سطر(طول(قائمة.تطبيقات))

    اطبع_سطر("")
    اطبع_سطر("=== Start Menu: SUCCESS ===")

    ارجع 0
نهاية
