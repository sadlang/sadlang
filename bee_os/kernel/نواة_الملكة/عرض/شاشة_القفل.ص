# ══════════════════════════════════════════════════════════════════════════════
# شاشة_القفل.ص - شاشة القفل لنظام خلية النحل
# BeeOS Lock Screen - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936

# ──────────────────────────────────────────────────────────────────
# صنف شاشة القفل
# ──────────────────────────────────────────────────────────────────
صنف شاشة_قفل
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    رقم ساعة
    رقم دقيقة
    رقم يوم
    رقم شهر
    رقم سنة
    رقم مؤشر_قفل
    رقم نسبة_بطارية
    رقم واي_فاي

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.ساعة = 12
        هذا.دقيقة = 0
        هذا.يوم = 15
        هذا.شهر = 6
        هذا.سنة = 2024
        هذا.مؤشر_قفل = 0
        هذا.نسبة_بطارية = 85
        هذا.واي_فاي = 1
    نهاية

    # رسم الساعة الكبيرة
    دالة رسم_ساعة(ف)
        متغير cx = عرض_شاشة / 2
        متغير cy = ارت_شاشة / 3

        # نص الساعة
        متغير نص_ساعة = ""
        اذا (هذا.ساعة < 10)
            نص_ساعة = "0" + هذا.ساعة
        والا
            نص_ساعة = "" + هذا.ساعة
        نهاية

        متغير نص_دقيقة = ""
        اذا (هذا.دقيقة < 10)
            نص_دقيقة = "0" + هذا.دقيقة
        والا
            نص_دقيقة = "" + هذا.دقيقة
        نهاية

        متغير وقت_كامل = نص_ساعة + ":" + نص_دقيقة

        # الساعة بحجم كبير
        ارسم_نص_أصلي(ف، cx - 80، cy - 30، وقت_كامل، 5، ل_أبيض)

        # التاريخ
        متغير تاريخ = "" + هذا.يوم + "/" + هذا.شهر + "/" + هذا.سنة
        ارسم_نص_أصلي(ف، cx - 50، cy + 40، تاريخ، 2، ل_رمادي)

        # يوم الأسبوع
        ارسم_نص_أصلي(ف، cx - 40، cy + 70، "Saturday"، 2، ل_رمادي)

        ارجع 1
    نهاية

    # رسم مؤشر فتح القفل
    دالة رسم_مؤشر_قفل(ف، نسبة_سحب)
        متغير cx = عرض_شاشة / 2
        متغير cy = ارت_شاشة * 3 / 4

        # مسار السحب
        متغير مسار_ع = 300
        متغير مسار_x = cx - مسار_ع / 2
        ارسم_مستطيل_أصلي(ف، مسار_x، cy، مسار_ع، 6، ل_رمادي_غ)

        # الجزء المسحوب
        متغير سحب_ع = مسار_ع * نسبة_سحب / 100
        اذا (سحب_ع > 0)
            ارسم_مستطيل_أصلي(ف، مسار_x، cy، سحب_ع، 6، ل_أصفر)
        نهاية

        # مقبض السحب
        متغير مقبض_x = مسار_x + سحب_ع
        ارسم_دائرة_مصمتة(ف، مقبض_x، cy + 3، 15، ل_أصفر)
        ارسم_دائرة_أصلي(ف، مقبض_x، cy + 3، 15، ل_أبيض)

        # سهم اليمين
        ارسم_نص_أصلي(ف، مقبض_x - 5، cy - 3، ">>"، 1، ل_أسود)

        # نص تعليمات
        اذا (نسبة_سحب < 100)
            ارسم_نص_أصلي(ف، cx - 60، cy + 30، "Slide to unlock"، 1، ل_رمادي)
        والا
            ارسم_نص_أصلي(ف، cx - 40، cy + 30، "Unlocked!"، 1، ل_أخضر)
        نهاية

        ارجع 1
    نهاية

    # رسم شريط الحالة العلوي
    دالة رسم_شريط_علوي(ف)
        # واي فاي
        اذا (هذا.واي_فاي)
            ارسم_دائرة_أصلي(ف، عرض_شاشة - 50، 25، 8، ل_أبيض)
            ارسم_دائرة_أصلي(ف، عرض_شاشة - 50، 25، 5، ل_أبيض)
            ارسم_دائرة_مصمتة(ف، عرض_شاشة - 50، 25، 2، ل_أبيض)
        نهاية

        # بطارية
        ارسم_مستطيل_أصلي(ف، عرض_شاشة - 100، 15، 35، 18، ل_أسود)
        ارسم_إطار_أصلي(ف، عرض_شاشة - 100، 15، 35، 18، 1، ل_أبيض)
        متغير ملء_بطارية = 31 * هذا.نسبة_بطارية / 100
        متغير لون_بطارية = ل_أخضر
        اذا (هذا.نسبة_بطارية < 20)
            لون_بطارية = -65536
        نهاية
        ارسم_مستطيل_أصلي(ف، عرض_شاشة - 98، 17، ملء_بطارية، 14، لون_بطارية)
        ارسم_مستطيل_أصلي(ف، عرض_شاشة - 65، 19، 3، 10، ل_أبيض)

        ارسم_نص_أصلي(ف، عرض_شاشة - 140، 18، "" + هذا.نسبة_بطارية + "%"، 1، ل_أبيض)

        ارجع 1
    نهاية

    # رسم الشاشة
    دالة رسم(إطار، نسبة_فتح)
        متغير ف = هذا.مقبض_خلفي

        # خلفية متدرجة جميلة
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة / 2، ل_أسود، ل_أزرق_غ)
        ارسم_تدرج_أفقي(ف، 0، ارت_شاشة / 2، عرض_شاشة، ارت_شاشة / 2، ل_أزرق_غ، ل_أسود)

        # نجوم (نقاط صغيرة)
        متغير نجم = 0
        بينما (نجم < 80)
            متغير nx = (نجم * 137 + 43) % عرض_شاشة
            متغير ny = (نجم * 89 + 17) % (ارت_شاشة / 2)
            اكتب_بكسل(ف، nx، ny، ل_أبيض)
            اكتب_بكسل(ف، nx + 1، ny، ل_أبيض)
            اكتب_بكسل(ف، nx، ny + 1، ل_أبيض)
            نجم = نجم + 1
        نهاية

        # قمر (دائرة)
        ارسم_دائرة_مصمتة(ف، عرض_شاشة - 200، 150، 40، ل_أصفر)
        ارسم_دائرة_مصمتة(ف، عرض_شاشة - 180، 140، 35، امزج_لون(ل_أسود، ل_أزرق_غ، 50))

        # شريط الحالة
        هذا.رسم_شريط_علوي(ف)

        # الساعة
        هذا.رسم_ساعة(ف)

        # مؤشر فتح القفل
        هذا.رسم_مؤشر_قفل(ف، نسبة_فتح)

        # شعار BeeOS أسفل
        ارسم_نص_أصلي(ف، عرض_شاشة / 2 - 30، ارت_شاشة - 50، "BeeOS"، 1، ل_رمادي_غ)

        # swap
        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)

        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS Lock Screen ===")
    اطبع_سطر("")

    متغير شاشة = جديد شاشة_قفل()
    اطبع_سطر("[LOCK] Screen initialized")

    # إطار 1: شاشة قفل - 12:00
    اطبع_سطر("")
    اطبع_سطر("-- Frame 1: Lock screen 12:00 --")
    شاشة.رسم(1، 0)
    شاشة.تصدير("C:\\beeos_lock.ppm")
    اطبع_سطر("  Time: 12:00, Battery: " + شاشة.نسبة_بطارية + "%")

    # إطار 2: وقت مختلف
    اطبع_سطر("")
    اطبع_سطر("-- Frame 2: Lock screen 15:30 --")
    شاشة.ساعة = 15
    شاشة.دقيقة = 30
    شاشة.رسم(2، 0)
    اطبع_سطر("  Time: 15:30")

    # إطار 3: بداية السحب
    اطبع_سطر("")
    اطبع_سطر("-- Frame 3: Slide 30% --")
    شاشة.رسم(3، 30)
    اطبع_سطر("  Sliding: 30%")

    # إطار 4: نصف السحب
    اطبع_سطر("")
    اطبع_سطر("-- Frame 4: Slide 60% --")
    شاشة.رسم(4، 60)
    اطبع_سطر("  Sliding: 60%")

    # إطار 5: القفل مفتوح
    اطبع_سطر("")
    اطبع_سطر("-- Frame 5: Unlocked! --")
    شاشة.رسم(5، 100)
    شاشة.تصدير("C:\\beeos_lock_unlock.ppm")
    اطبع_سطر("  Unlocked!")

    # إطار 6: بطارية منخفضة
    اطبع_سطر("")
    اطبع_سطر("-- Frame 6: Low battery --")
    شاشة.نسبة_بطارية = 12
    شاشة.ساعة = 23
    شاشة.دقيقة = 45
    شاشة.رسم(6، 0)
    شاشة.تصدير("C:\\beeos_lock_lowbat.ppm")
    اطبع_سطر("  Battery: " + شاشة.نسبة_بطارية + "%, Time: 23:45")

    # إحصائيات
    اطبع_سطر("")
    متغير أسود = عد_بكسلات(شاشة.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("  Total pixels: ")
    اطبع_سطر(إجمالي)
    اطبع("  Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("")
    اطبع_سطر("=== Lock Screen: SUCCESS ===")

    ارجع 0
نهاية
