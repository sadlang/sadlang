# عارض_النص_العربي.ص - محرك عرض النص العربي لنظام النحلة
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# عارض النص "القلم العربي" - BeeQalam Arabic Text Engine
# يتعامل مع خصوصية اللغة العربية في بيئة الحاسوب:
#
# تحديات الكتابة العربية:
# ━━━━━━━━━━━━━━━━━━━━━━
# 1. الاتجاه من اليمين لليسار (RTL - Right to Left)
# 2. تغيّر شكل الحرف حسب موضعه (أول/وسط/آخر/منفرد)
# 3. الأحرف المتصلة والمنفصلة
# 4. علامات التشكيل (حركات) فوق/تحت الحروف
# 5. مشكلة Unicode وترتيب الأحرف المنطقي vs البصري
# 6. الأرقام العربية الهندية (٠١٢٣٤٥٦٧٨٩)
#
# الحل المُطبَّق في نظام النحلة:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. خط نقطي مدمج للحروف العربية (bitmap font)
# 2. خوارزمية تشكيل الحروف (Arabic Shaping)
# 3. خوارزمية Unicode Bidirectional (Bidi)
# 4. دعم كامل لـ Unicode Arabic Block (0600-06FF)
# 5. نظام إظهار خطوط قابل للتوسع
#
# المؤلف: فريق نظام خلية النحل
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت الحروف العربية (Unicode code points)
# ─────────────────────────────────────────────────────────────────────────────

# نطاق الحروف العربية الأساسية
ثابت أول_حرف_عربي  = 1569    # ء (0x0621)
ثابت آخر_حرف_عربي  = 1610    # ي (0x064A)

# أحرف خاصة
ثابت حرف_ألف       = 1575    # ا  (0x0627)
ثابت حرف_ياء       = 1610    # ي  (0x064A)
ثابت حرف_لام_ألف   = 1604    # لا  (0x0644 + 0x0627)
ثابت حرف_همزة      = 1569    # ء  (0x0621)
ثابت حرف_البسملة   = 65021   # ﷽  (0xFDFD) - حرف البسملة الكامل

# مواضع الحرف
ثابت موضع_منفرد  = 0
ثابت موضع_أول    = 1
ثابت موضع_وسط    = 2
ثابت موضع_آخر    = 3

# أحجام الخط
ثابت حجم_خط_صغير   = 12
ثابت حجم_خط_عادي   = 16
ثابت حجم_خط_كبير   = 24
ثابت حجم_خط_ضخم    = 32

# ─────────────────────────────────────────────────────────────────────────────
# صنف حرف_عربي_مُشكَّل
# يخزن حرفاً واحداً مع موضعه وشكله
# ─────────────────────────────────────────────────────────────────────────────
صنف حرف_عربي_مُشكَّل
    رقم الكود          # Unicode code point
    رقم الشكل          # منفرد/أول/وسط/آخر
    منطقي قابل_للوصل   # هل يتصل بما بعده؟

    باني(رقم كود، رقم شكل_الحرف)
        الكود = كود
        الشكل = شكل_الحرف
        قابل_للوصل = تحديد_قابلية_وصل(كود)
    نهاية

    ## هل الحرف قابل للوصل بما بعده؟
    ## بعض الأحرف لا تتصل بما قبلها (ا، د، ذ، ر، ز، و...)
    دالة منطقي تحديد_قابلية_وصل(رقم كود_الحرف)
        # هذه الأحرف لا تتصل بما بعدها
        # ا=1575، د=1583، ذ=1584، ر=1585، ز=1586، و=1608
        اذا (كود_الحرف == 1575) ارجع خطأ نهاية  # ا
        اذا (كود_الحرف == 1583) ارجع خطأ نهاية  # د
        اذا (كود_الحرف == 1584) ارجع خطأ نهاية  # ذ
        اذا (كود_الحرف == 1585) ارجع خطأ نهاية  # ر
        اذا (كود_الحرف == 1586) ارجع خطأ نهاية  # ز
        اذا (كود_الحرف == 1608) ارجع خطأ نهاية  # و
        ارجع صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مُشكِّل_الحروف العربية
# يحوّل النص من المنطقي إلى البصري
# ─────────────────────────────────────────────────────────────────────────────
صنف مُشكِّل_الحروف
    ## الوصف: يُطبّق خوارزمية Arabic Shaping على النص لتحديد شكل كل حرف

    ## تشكيل جملة عربية كاملة
    دالة مصفوفة شكّل_نص(نص النص_الأصلي)
        متغير نتيجة = []
        متغير طول_النص = طول(النص_الأصلي)

        متغير فهرس = 0
        بينما (فهرس < طول_النص)
            متغير كود_الحرف = كود_حرف(النص_الأصلي، فهرس)
            متغير الشكل = احسب_شكل_الحرف(النص_الأصلي، فهرس، كود_الحرف)
            نتيجة += [جديد حرف_عربي_مُشكَّل(كود_الحرف، الشكل)]
            فهرس = فهرس + 1
        نهاية

        ارجع نتيجة
    نهاية

    ## حساب شكل الحرف حسب موضعه في الكلمة
    دالة رقم احسب_شكل_الحرف(نص النص، رقم فهرس_الحرف، رقم الكود)
        # هل هذا حرف عربي؟
        اذا (الكود < أول_حرف_عربي || الكود > آخر_حرف_عربي)
            ارجع موضع_منفرد  # ليس عربياً
        نهاية

        متغير له_سابق = لديه_حرف_سابق_عربي(النص، فهرس_الحرف)
        متغير له_تالٍ  = لديه_حرف_تالٍ_عربي(النص، فهرس_الحرف)

        # الحرف لا يتصل بما بعده
        متغير يتصل = جديد حرف_عربي_مُشكَّل(الكود، 0)
        اذا (!يتصل.قابل_للوصل)
            اذا (له_سابق)
                ارجع موضع_آخر     # آخر الكلمة
            والا
                ارجع موضع_منفرد   # منفرد
            نهاية
        نهاية

        # الحرف يتصل
        اذا (له_سابق && له_تالٍ)
            ارجع موضع_وسط    # وسط الكلمة
        وإلا اذا (له_سابق)
            ارجع موضع_آخر    # آخر الكلمة
        وإلا اذا (له_تالٍ)
            ارجع موضع_أول    # أول الكلمة
        والا
            ارجع موضع_منفرد  # منفرد
        نهاية
    نهاية

    ## هل يوجد حرف عربي قبل الحرف الحالي؟
    دالة منطقي لديه_حرف_سابق_عربي(نص النص، رقم فهرس)
        اذا (فهرس == 0) ارجع خطأ نهاية
        متغير كود = كود_حرف(النص، فهرس - 1)
        ارجع كود >= أول_حرف_عربي && كود <= آخر_حرف_عربي
    نهاية

    ## هل يوجد حرف عربي بعد الحرف الحالي؟
    دالة منطقي لديه_حرف_تالٍ_عربي(نص النص، رقم فهرس)
        اذا (فهرس >= طول(النص) - 1) ارجع خطأ نهاية
        متغير كود = كود_حرف(النص، فهرس + 1)
        ارجع كود >= أول_حرف_عربي && كود <= آخر_حرف_عربي
    نهاية

    ## الحصول على كود Unicode للحرف في موضع معيّن
    دالة رقم كود_حرف(نص النص، رقم فهرس)
        # في التطبيق الكامل: استخراج الـ code point من UTF-8
        # هنا نعيد قيمة تجريبية
        ارجع 1576   # ب (0x0628) - للاختبار
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف خط_نقطي
# خط بيانات نقطية مدمجة في النواة (لا يحتاج ملفات خارجية)
# ─────────────────────────────────────────────────────────────────────────────
صنف خط_نقطي
    ## الوصف:
    ## خط نقطي بسيط 8×16 بكسل مدمج في النواة.
    ## يدعم الحروف الأساسية العربية واللاتينية.
    ## في المستقبل: دعم TTF/OTF عبر مكتبة الخطوط.

    رقم عرض_الحرف     # عرض كل حرف بالبكسل
    رقم ارتفاع_الحرف  # ارتفاع كل حرف
    مصفوفة بيانات_الخط  # بيانات الخط النقطية

    باني(رقم ع، رقم ار)
        عرض_الحرف = ع
        ارتفاع_الحرف = ار
        بيانات_الخط = []
        تحميل_خط_افتراضي()
    نهاية

    ## تحميل الخط الافتراضي (بيانات مُدمجة)
    دالة تحميل_خط_افتراضي()
        # في التطبيق الكامل:
        # نُدمج بيانات خط DP Naskh أو Amiri الحر
        # مُحوَّلة بأداة font2c إلى مصفوفة بايتات
        اطبع_سطر("   تحميل خط نسخ النحلة...")
    نهاية

    ## رسم حرف واحد في موضع معيّن
    دالة ارسم_حرف(المحرك، رقم نقطة_بيانات، رقم س، رقم ص، رقم اللون)
        # رسم بيانات الخط النقطي للحرف في الموضع المطلوب
        متغير صف = 0
        بينما (صف < ارتفاع_الحرف)
            متغير بايت_الصف = نقطة_بيانات   # في الحقيقي: نقرأ من مصفوفة الخط
            متغير عمود = 0
            بينما (عمود < عرض_الحرف)
                اذا (بايت_الصف && (128 >> عمود))   # هل هذا البت مضاء؟
                    المحرك.ارسم_بكسل(س + عمود، ص + صف، اللون)
                نهاية
                عمود = عمود + 1
            نهاية
            صف = صف + 1
        نهاية
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الصنف الرئيسي: محرك النص العربي - بي_قلم
# ─────────────────────────────────────────────────────────────────────────────
صنف محرك_النص_العربي
    ## الوصف الكامل:
    ## ══════════════
    ## "القلم العربي" - BeeQalam
    ## محرك عرض النص العربي المتكامل لنظام النحلة.
    ## مُصمَّم خصيصاً لعرض النصوص العربية على الشاشة
    ## في بيئة bare-metal بلا مكتبات خارجية.
    ##
    ## المزايا:
    ## --------
    ## ✅ دعم RTL أصيل
    ## ✅ تشكيل الحروف (Shaping)
    ## ✅ دعم التشكيل (الحركات)
    ## ✅ مزج العربي مع الأرقام والإنجليزي
    ## ✅ سرعة عالية (خط نقطي)
    ## ✅ حجم كود صغير جداً

    # الحقول تُهيّأ في الباني (custom objects)

    باني()
        المُشكِّل = جديد مُشكِّل_الحروف()
        الخط_الرئيسي = جديد خط_نقطي(8، 16)    # خط عادي 8x16
        خط_العنوان = جديد خط_نقطي(12، 24)      # خط عناوين 12x24
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## عرض نص عربي في موضع محدد
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم_نص(المحرك، نص النص، رقم س، رقم ص، رقم اللون)
        ارسم_نص_بحجم(المحرك، النص، س، ص، اللون، حجم_خط_عادي)
    نهاية

    ## عرض نص بحجم محدد
    دالة ارسم_نص_بحجم(المحرك، نص النص، رقم س، رقم ص، رقم اللون، رقم حجم_الخط)
        ## للنص العربي: نبدأ من اليمين ونكتب يساراً
        ## للنص اللاتيني: نبدأ من اليسار ونكتب يميناً

        # 1. تشكيل الحروف
        متغير الحروف_المُشكَّلة = المُشكِّل.شكّل_نص(النص)

        # 2. حساب العرض الكلي
        متغير عدد_الأحرف = عدد الحروف_المُشكَّلة
        متغير العرض_الكلي = عدد_الأحرف * 10   # عرض تقريبي لكل حرف

        # 3. للعربية: نبدأ من اليمين
        متغير س_بداية = س + العرض_الكلي   # نبدأ من اليمين

        # 4. رسم كل حرف
        متغير فهرس = 0
        لكل حرف في الحروف_المُشكَّلة
            متغير س_حالي = س_بداية - (فهرس * 10)
            الخط_الرئيسي.ارسم_حرف(المحرك، حرف.الكود، س_حالي، ص، اللون)
            فهرس = فهرس + 1
        نهاية
    نهاية

    ## عرض عنوان كبير
    دالة ارسم_عنوان(المحرك، نص النص، رقم س، رقم ص، رقم اللون)
        ارسم_نص_بحجم(المحرك، النص، س، ص، اللون، حجم_خط_ضخم)
    نهاية

    ## حساب عرض نص بالبكسل (للمواضعة قبل الرسم)
    دالة رقم احسب_عرض_نص(نص النص)
        # تقريب: كل حرف عربي حوالي 10-12 بكسل
        ارجع طول(النص) * 10
    نهاية

    ## رسم نص في مستطيل مع توسيط أفقي
    دالة ارسم_نص_مُوسَّط(المحرك، نص النص، رقم س، رقم ص، رقم ع_المساحة، رقم اللون)
        متغير عرض_النص = احسب_عرض_نص(النص)
        متغير س_مُوسَّط = س + (ع_المساحة - عرض_النص) / 2
        ارسم_نص(المحرك، النص، س_مُوسَّط، ص، اللون)
    نهاية

    ## رسم نص مع ظل (لتحسين القراءة على خلفيات ملوّنة)
    دالة ارسم_نص_مع_ظل(المحرك، نص النص، رقم س، رقم ص، رقم اللون)
        # رسم الظل أولاً (لون غامق، إزاحة 1 بكسل)
        ارسم_نص(المحرك، النص، س + 1، ص + 1، 4278190080)  # أسود
        # رسم النص الأصلي
        ارسم_نص(المحرك، النص، س، ص، اللون)
    نهاية

    ## اختبار ذاتي
    دالة اختبار()
        اطبع_سطر("  🖊 اختبار محرك النص العربي:")
        اطبع("    حجم الأحرف: ")
        اطبع(الخط_الرئيسي.عرض_الحرف)
        اطبع(" × ")
        اطبع_سطر(الخط_الرئيسي.ارتفاع_الحرف)

        # اختبار تشكيل الحروف
        متغير أحرف_مشكلة = المُشكِّل.شكّل_نص("بسم الله")
        متغير ع_أحرف = عدد أحرف_مشكلة
        اطبع("    أحرف مُشكَّلة: ")
        اطبع_سطر(ع_أحرف)

        اطبع_سطر("    ✅ محرك النص جاهز")
    نهاية
نهاية

## المثيل العالمي لمحرك النص
متغير قلم_النحلة = جديد محرك_النص_العربي()

## اختبار
دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════")
    اطبع_سطر("  🖊 اختبار القلم العربي - BeeQalam")
    اطبع_سطر("══════════════════════════════════════")
    قلم_النحلة.اختبار()
    اطبع_سطر("  ✅ محرك النص العربي جاهز!")
    ارجع 0
نهاية
