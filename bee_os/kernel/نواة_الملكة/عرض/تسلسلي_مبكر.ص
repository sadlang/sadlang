# تسلسلي_مبكر.ص - الإخراج التسلسلي (منفذ COM)
# نظام خلية النحل - نواة الملكة / عرض
# إخراج تسلسلي مبكر للتصحيح عبر COM1
# ══════════════════════════════════════════════════════════════════════

صنف منفذ_تسلسلي
    رقم عنوان_القاعدة
    رقم معدل_البود
    رقم مُهيّأ
    رقم بتات_البيانات

    باني(رقم العنوان، رقم المعدل)
        عنوان_القاعدة = العنوان
        معدل_البود = المعدل
        مُهيّأ = 0
        بتات_البيانات = 8
    نهاية

    دالة رقم هيّئ()
        # تعطيل المقاطعات (عنوان + 1) = 0
        # تمكين DLAB (عنوان + 3) = 0x80
        # تعيين المقسم حسب معدل البود
        # 8 بتات بيانات، لا تماثل، بت توقف واحد
        مُهيّأ = 1
        ارجع 1
    نهاية

    دالة رقم اعط_العنوان()
        ارجع عنوان_القاعدة
    نهاية

    دالة رقم هل_مُهيّأ()
        ارجع مُهيّأ
    نهاية

    دالة رقم احسب_المقسم(رقم تردد_الساعة)
        اذا (معدل_البود == 0)
            ارجع 1
        نهاية
        ارجع تردد_الساعة / معدل_البود
    نهاية
نهاية

صنف كاتب_تسلسلي
    رقم بايتات_مرسلة
    رقم منفذ_نشط

    باني(رقم عنوان_المنفذ)
        بايتات_مرسلة = 0
        منفذ_نشط = عنوان_المنفذ
    نهاية

    دالة رقم هل_جاهز_للإرسال()
        # قراءة سجل حالة السطر (عنوان + 5)
        # البت 5 = مخزن الإرسال فارغ
        ارجع 1
    نهاية

    دالة رقم أرسل_بايت(رقم القيمة)
        بايتات_مرسلة = بايتات_مرسلة + 1
        ارجع 1
    نهاية

    دالة رقم أرسل_سطر_جديد()
        أرسل_بايت(13)
        أرسل_بايت(10)
        ارجع 1
    نهاية

    دالة رقم اعط_عدد_البايتات()
        ارجع بايتات_مرسلة
    نهاية
نهاية

صنف مصحح_تسلسلي
    رقم مفعل
    رقم عدد_الرسائل

    باني()
        مفعل = 0
        عدد_الرسائل = 0
    نهاية

    دالة رقم فعّل()
        مفعل = 1
        ارجع 1
    نهاية

    دالة رقم عطّل()
        مفعل = 0
        ارجع 0
    نهاية

    دالة رقم هل_مفعل()
        ارجع مفعل
    نهاية

    دالة رقم سجل_رسالة(نص بادئة)
        اذا (مفعل == 0)
            ارجع 0
        نهاية
        عدد_الرسائل = عدد_الرسائل + 1
        ارجع عدد_الرسائل
    نهاية

    دالة رقم اعط_العدد()
        ارجع عدد_الرسائل
    نهاية
نهاية

صنف منافذ_معروفة
    رقم عنوان_كوم1
    رقم عنوان_كوم2
    رقم عنوان_كوم3
    رقم عنوان_كوم4

    باني()
        عنوان_كوم1 = 1016
        عنوان_كوم2 = 760
        عنوان_كوم3 = 1000
        عنوان_كوم4 = 744
    نهاية

    دالة رقم اعط_كوم1()
        ارجع عنوان_كوم1
    نهاية

    دالة رقم اعط_كوم2()
        ارجع عنوان_كوم2
    نهاية

    دالة رقم هل_منفذ_صالح(رقم العنوان)
        اذا (العنوان == عنوان_كوم1)
            ارجع 1
        نهاية
        اذا (العنوان == عنوان_كوم2)
            ارجع 1
        نهاية
        اذا (العنوان == عنوان_كوم3)
            ارجع 1
        نهاية
        اذا (العنوان == عنوان_كوم4)
            ارجع 1
        نهاية
        ارجع 0
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير منفذ = جديد منفذ_تسلسلي(1016، 115200)
    منفذ.هيّئ()
    اطبع("  عنوان COM1: ")
    اطبع_سطر(منفذ.اعط_العنوان())
    اطبع("  مُهيّأ: ")
    اطبع_سطر(منفذ.هل_مُهيّأ())
    اطبع("  المقسم: ")
    اطبع_سطر(منفذ.احسب_المقسم(1843200))

    متغير كاتب = جديد كاتب_تسلسلي(1016)
    كاتب.أرسل_بايت(72)
    كاتب.أرسل_بايت(101)
    كاتب.أرسل_سطر_جديد()
    اطبع("  بايتات مرسلة: ")
    اطبع_سطر(كاتب.اعط_عدد_البايتات())

    متغير مصحح = جديد مصحح_تسلسلي()
    مصحح.فعّل()
    مصحح.سجل_رسالة("[نواة]")
    مصحح.سجل_رسالة("[ذاكرة]")
    اطبع("  رسائل التصحيح: ")
    اطبع_سطر(مصحح.اعط_العدد())

    متغير منافذ = جديد منافذ_معروفة()
    اطبع("  كوم1: ")
    اطبع_سطر(منافذ.اعط_كوم1())
    اطبع("  هل صالح (1016): ")
    اطبع_سطر(منافذ.هل_منفذ_صالح(1016))

    اطبع_سطر("  ✅ تسلسلي_مبكر يعمل")
    ارجع 0
نهاية
