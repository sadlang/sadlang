    متغير راسم = جديد راسم_أشكال(16777215)
    راسم.ارسم_نقطة(100، 100)
    راسم.ارسم_مستطيل(10، 10، 200، 100)
    راسم.املأ_مستطيل(50، 50، 80، 40)
    اطبع("  عدد العمليات: ")
