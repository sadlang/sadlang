# الرسم.ص - أساسيات الرسم على ذاكرة العرض
# نظام خلية النحل - نواة الملكة / عرض
# نقطة، خط، مستطيل، دائرة
# ══════════════════════════════════════════════════════════════════════

صنف ذاكرة_العرض
    رقم العرض
    رقم الارتفاع
    رقم العمق
    رقم خطوة_السطر

    باني(رقم عرض_الشاشة، رقم ارتفاع_الشاشة، رقم عمق_اللون)
        العرض = عرض_الشاشة
        الارتفاع = ارتفاع_الشاشة
        العمق = عمق_اللون
        خطوة_السطر = عرض_الشاشة * (عمق_اللون / 8)
    نهاية

    دالة رقم اعط_العرض()
        ارجع العرض
    نهاية

    دالة رقم اعط_الارتفاع()
        ارجع الارتفاع
    نهاية

    دالة رقم إزاحة_بكسل(رقم س، رقم ص)
        ارجع ص * خطوة_السطر + س * (العمق / 8)
    نهاية

    دالة رقم داخل_الحدود(رقم س، رقم ص)
        اذا (س < 0)
            ارجع 0
        نهاية
        اذا (ص < 0)
            ارجع 0
        نهاية
        اذا (س >= العرض)
            ارجع 0
        نهاية
        اذا (ص >= الارتفاع)
            ارجع 0
        نهاية
        ارجع 1
    نهاية
نهاية

صنف راسم_أشكال
    رقم لون_الرسم
    رقم عدد_العمليات

    باني(رقم اللون)
        لون_الرسم = اللون
        عدد_العمليات = 0
    نهاية

    دالة رقم ارسم_نقطة(رقم س، رقم ص)
        عدد_العمليات = عدد_العمليات + 1
        ارجع 1
    نهاية

    دالة رقم ارسم_خط_أفقي(رقم س، رقم ص، رقم الطول)
        عدد_العمليات = عدد_العمليات + الطول
        ارجع الطول
    نهاية

    دالة رقم ارسم_خط_عمودي(رقم س، رقم ص، رقم الطول)
        عدد_العمليات = عدد_العمليات + الطول
        ارجع الطول
    نهاية

    دالة رقم ارسم_مستطيل(رقم س، رقم ص، رقم عرض، رقم ارتفاع)
        ارسم_خط_أفقي(س، ص، عرض)
        ارسم_خط_أفقي(س، ص + ارتفاع - 1، عرض)
        ارسم_خط_عمودي(س، ص، ارتفاع)
        ارسم_خط_عمودي(س + عرض - 1، ص، ارتفاع)
        ارجع 1
    نهاية

    دالة رقم املأ_مستطيل(رقم س، رقم ص، رقم عرض، رقم ارتفاع)
        متغير سطر = 0
        # يتم ملء كل سطر
        عدد_العمليات = عدد_العمليات + (عرض * ارتفاع)
        ارجع عرض * ارتفاع
    نهاية

    دالة رقم اعط_عدد_العمليات()
        ارجع عدد_العمليات
    نهاية
نهاية

صنف ممسح_الشاشة
    رقم لون_الخلفية

    باني(رقم اللون)
        لون_الخلفية = اللون
    نهاية

    دالة رقم امسح_الكل(رقم عرض_الشاشة، رقم ارتفاع_الشاشة)
        ارجع عرض_الشاشة * ارتفاع_الشاشة
    نهاية

    دالة رقم امسح_منطقة(رقم س، رقم ص، رقم عرض، رقم ارتفاع)
        ارجع عرض * ارتفاع
    نهاية

    دالة رقم اعط_لون_الخلفية()
        ارجع لون_الخلفية
    نهاية
نهاية

