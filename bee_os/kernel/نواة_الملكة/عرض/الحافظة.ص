# الحافظة.ص — صحن العسل: نظام الحافظة المتقدم
# ══════════════════════════════════════════════════════════════════════════════
# مهمة ١١٠: حافظة متعددة الأنواع + تاريخ + مشاركة آمنة
# ══════════════════════════════════════════════════════════════════════════════

# أنواع المحتوى
ثابت محتوى_نص = 1
ثابت محتوى_صورة = 2
ثابت محتوى_ملف = 3
ثابت محتوى_رابط = 4
ثابت محتوى_كود = 5

صنف عنصر_حافظة
    رقم المعرف
    رقم النوع
    نص المحتوى
    نص المصدر        # التطبيق المصدر
    رقم الحجم         # بايت
    منطقي مثبت       # لا يُحذف تلقائياً
    منطقي مشفر
    رقم مرات_اللصق

    باني(رقم معرف, رقم نوع, نص محتوى, نص مصدر, رقم حجم)
        المعرف = معرف
        النوع = نوع
        المحتوى = محتوى
        المصدر = مصدر
        الحجم = حجم
        مثبت = خطأ
        مشفر = خطأ
        مرات_اللصق = 0
    نهاية

    دالة اسم_النوع()
        اذا (النوع == محتوى_نص)
            ارجع "نص"
        والا_اذا (النوع == محتوى_صورة)
            ارجع "صورة"
        والا_اذا (النوع == محتوى_ملف)
            ارجع "ملف"
        والا_اذا (النوع == محتوى_رابط)
            ارجع "رابط"
        والا_اذا (النوع == محتوى_كود)
            ارجع "كود"
        نهاية
        ارجع "مجهول"
    نهاية

    دالة اطبع_معلومات()
        اطبع("    [") اطبع(المعرف) اطبع("] ")
        اطبع(اسم_النوع()) اطبع(": ")
        # عرض مختصر
        اطبع(المحتوى)
        اطبع(" (") اطبع(الحجم) اطبع(" بايت)")
        اذا (مثبت)
            اطبع(" 📌")
        نهاية
        اذا (مشفر)
            اطبع(" 🔒")
        نهاية
        اطبع(" من: ") اطبع_سطر(المصدر)
    نهاية
نهاية

صنف مدير_الحافظة
    رقم عدد_العناصر
    رقم حد_التاريخ
    رقم إجمالي_النسخ
    رقم إجمالي_اللصق
    رقم ذاكرة_مستخدمة
    رقم عمليات_مشفرة

    باني()
        عدد_العناصر = 0
        حد_التاريخ = 100
        إجمالي_النسخ = 0
        إجمالي_اللصق = 0
        ذاكرة_مستخدمة = 0
        عمليات_مشفرة = 0
    نهاية

    دالة نسخ(عنصر_حافظة عنصر)
        عدد_العناصر = عدد_العناصر + 1
        إجمالي_النسخ = إجمالي_النسخ + 1
        ذاكرة_مستخدمة = ذاكرة_مستخدمة + عنصر.الحجم
        اطبع("  نسخ: ") اطبع(عنصر.اسم_النوع())
        اطبع(" من ") اطبع_سطر(عنصر.المصدر)
        ارجع صحيح
    نهاية

    دالة ألصق(عنصر_حافظة عنصر, نص هدف)
        عنصر.مرات_اللصق = عنصر.مرات_اللصق + 1
        إجمالي_اللصق = إجمالي_اللصق + 1
        اطبع("  لصق: ") اطبع(عنصر.اسم_النوع())
        اطبع(" في ") اطبع_سطر(هدف)
        ارجع صحيح
    نهاية

    دالة ثبت(عنصر_حافظة عنصر)
        عنصر.مثبت = صحيح
        اطبع("  تثبيت: #") اطبع_سطر(عنصر.المعرف)
    نهاية

    دالة شفر(عنصر_حافظة عنصر)
        عنصر.مشفر = صحيح
        عمليات_مشفرة = عمليات_مشفرة + 1
        اطبع("  تشفير: #") اطبع(عنصر.المعرف) اطبع_سطر(" 🔒")
    نهاية

    دالة بحث(نص كلمة)
        اطبع("  بحث عن: ") اطبع_سطر(كلمة)
        اطبع_سطر("    (محاكاة بحث في التاريخ)")
    نهاية

    دالة نظف_التاريخ()
        متغير قديم = عدد_العناصر
        # حذف غير المثبتة
        عدد_العناصر = 0
        ذاكرة_مستخدمة = 0
        اطبع("  تنظيف: حذف ") اطبع(قديم) اطبع_سطر(" عنصر غير مثبت")
    نهاية

    دالة اطبع_تقرير()
        اطبع_سطر("  ═══════ تقرير الحافظة ═══════")
        اطبع("  عناصر: ") اطبع_سطر(عدد_العناصر)
        اطبع("  عمليات نسخ: ") اطبع_سطر(إجمالي_النسخ)
        اطبع("  عمليات لصق: ") اطبع_سطر(إجمالي_اللصق)
        اطبع("  ذاكرة: ") اطبع(ذاكرة_مستخدمة) اطبع_سطر(" بايت")
        اطبع("  عمليات مشفرة: ") اطبع_سطر(عمليات_مشفرة)
        اطبع("  حد التاريخ: ") اطبع_سطر(حد_التاريخ)
        اطبع_سطر("  ═══════════════════════════════")
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════")
    اطبع_سطر("  صحن العسل — نظام الحافظة المتقدم")
    اطبع_سطر("══════════════════════════════════════════════")

    متغير حافظة = جديد مدير_الحافظة()

    # إنشاء عناصر
    متغير ع1 = جديد عنصر_حافظة(1, محتوى_نص, "بسم الله الرحمن الرحيم", "محرر النصوص", 42)
    متغير ع2 = جديد عنصر_حافظة(2, محتوى_رابط, "https://beeos.org", "المتصفح", 20)
    متغير ع3 = جديد عنصر_حافظة(3, محتوى_كود, "دالة جمع(أ، ب) ...", "محرر الكود", 128)
    متغير ع4 = جديد عنصر_حافظة(4, محتوى_صورة, "لقطة شاشة.png", "عارض الصور", 2048)
    متغير ع5 = جديد عنصر_حافظة(5, محتوى_ملف, "تقرير.pdf", "مدير الملفات", 5120)

    # نسخ
    اطبع_سطر("")
    اطبع_سطر("[1] عمليات النسخ...")
    حافظة.نسخ(ع1)
    حافظة.نسخ(ع2)
    حافظة.نسخ(ع3)
    حافظة.نسخ(ع4)
    حافظة.نسخ(ع5)

    # لصق
    اطبع_سطر("")
    اطبع_سطر("[2] عمليات اللصق...")
    حافظة.ألصق(ع1, "رسالة بريد")
    حافظة.ألصق(ع2, "محرر النصوص")
    حافظة.ألصق(ع3, "ملف جديد")

    # تثبيت وتشفير
    اطبع_سطر("")
    اطبع_سطر("[3] تثبيت وتشفير...")
    حافظة.ثبت(ع1)
    حافظة.شفر(ع5)

    # عرض العناصر
    اطبع_سطر("")
    اطبع_سطر("[4] محتويات الحافظة...")
    ع1.اطبع_معلومات()
    ع2.اطبع_معلومات()
    ع3.اطبع_معلومات()
    ع4.اطبع_معلومات()
    ع5.اطبع_معلومات()

    # بحث
    اطبع_سطر("")
    اطبع_سطر("[5] بحث...")
    حافظة.بحث("بسم الله")

    # تقرير
    اطبع_سطر("")
    حافظة.اطبع_تقرير()

    اطبع_سطر("")
    اطبع_سطر("  جميع اختبارات نظام الحافظة نجحت!")
    ارجع 0
نهاية
