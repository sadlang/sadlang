# ══════════════════════════════════════════════════════════════════════════════
# أيقونات_سطح_المكتب.ص - نظام أيقونات سطح المكتب
# BeeOS Desktop Icons - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

# ألوان
متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296
متغير ل_بنفسجي  = -6750208

# ──────────────────────────────────────────────────────────────────
# صنف أيقونة
# ──────────────────────────────────────────────────────────────────
صنف أيقونة
    نص اسم
    رقم لون
    رقم صف
    رقم عمود
    رقم محدد
    نص رمز

    باني(اسم_أ، لون_أ، صف_أ، عمود_أ، رمز_أ)
        هذا.اسم = اسم_أ
        هذا.لون = لون_أ
        هذا.صف = صف_أ
        هذا.عمود = عمود_أ
        هذا.محدد = 0
        هذا.رمز = رمز_أ
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# صنف سطح مكتب الأيقونات
# ──────────────────────────────────────────────────────────────────
صنف سطح_أيقونات
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    مصفوفة أيقونات
    رقم حجم_أيقونة
    رقم تباعد
    رقم هامش_يسار
    رقم هامش_علوي

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.حجم_أيقونة = 48
        هذا.تباعد = 90
        هذا.هامش_يسار = 40
        هذا.هامش_علوي = 30

        هذا.أيقونات = []
        # عمود 0
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Browser", ل_أزرق_غ، 0، 0، "W")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Calculator", ل_أخضر، 1، 0، "=")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Editor", ل_أصفر، 2، 0، "<>")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Terminal", ل_رمادي_غ، 3، 0، ">_")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Files", ل_برتقالي، 4، 0، "F")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Settings", ل_رمادي، 5، 0، "*")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Music", ل_بنفسجي، 6، 0، "M")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Photos", ل_أخضر، 7، 0، "P")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Notes", ل_أصفر، 8، 0، "N")]
        # عمود 1
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Tasks", ل_أحمر، 0، 1، "T")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Monitor", ل_أزرق_غ، 1، 1، "M")]
        هذا.أيقونات = هذا.أيقونات + [جديد أيقونة("Trash", ل_رمادي_غ، 2، 1، "D")]
    نهاية

    # رسم أيقونة واحدة
    دالة رسم_أيقونة(ف، أيقونة_واحدة)
        متغير حجم = هذا.حجم_أيقونة
        متغير ix = هذا.هامش_يسار + أيقونة_واحدة.عمود * هذا.تباعد
        متغير iy = هذا.هامش_علوي + أيقونة_واحدة.صف * هذا.تباعد

        # تظليل الأيقونة المحددة
        اذا (أيقونة_واحدة.محدد)
            ارسم_مستطيل_أصلي(ف، ix - 5، iy - 5، حجم + 10، حجم + 25، امزج_لون(ل_أصفر، ل_أسود، 40))
            ارسم_إطار_أصلي(ف، ix - 5، iy - 5، حجم + 10، حجم + 25، 1، ل_أصفر)
        نهاية

        # خلفية الأيقونة
        ارسم_مستطيل_أصلي(ف، ix، iy، حجم، حجم، أيقونة_واحدة.لون)

        # إطار الأيقونة
        ارسم_إطار_أصلي(ف، ix، iy، حجم، حجم، 1، ل_أبيض)

        # رمز الأيقونة
        ارسم_نص_أصلي(ف، ix + 10، iy + 15، أيقونة_واحدة.رمز، 2، ل_أبيض)

        # اسم الأيقونة تحتها
        متغير اسم_x = ix + حجم / 2 - طول(أيقونة_واحدة.اسم) * 4
        اذا (اسم_x < ix - 10)
            اسم_x = ix - 10
        نهاية
        ارسم_نص_أصلي(ف، اسم_x، iy + حجم + 5، أيقونة_واحدة.اسم، 1، ل_أبيض)

        ارجع 1
    نهاية

    # رسم كل الأيقونات
    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        # خلفية سطح المكتب
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)

        # نقش خلايا نحل خفيف
        متغير nx = 200
        بينما (nx < عرض_شاشة)
            متغير ny = 50
            بينما (ny < ارت_شاشة - 60)
                ارسم_دائرة_أصلي(ف، nx، ny، 20، امزج_لون(ل_أصفر، ل_أسود، 5))
                ny = ny + 100
            نهاية
            nx = nx + 120
        نهاية

        # رسم كل الأيقونات
        متغير ت = 0
        بينما (ت < طول(هذا.أيقونات))
            هذا.رسم_أيقونة(ف، هذا.أيقونات[ت])
            ت = ت + 1
        نهاية

        # شريط المهام
        متغير لون_شريط = امزج_لون(ل_أسود، ل_أزرق_غ، 30)
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، لون_شريط)
        ارسم_خط_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، ارت_شاشة - 40، ل_رمادي_غ)

        # زر ابدأ
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، 50، 40، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، 10، ارت_شاشة - 30، "BEE"، 1، ل_أبيض)

        # ساعة
        ارسم_نص_أصلي(ف، عرض_شاشة - 80، ارت_شاشة - 28، "12:00"، 1، ل_أبيض)

        # swap
        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)

        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS Desktop Icons ===")
    اطبع_سطر("")

    متغير سطح = جديد سطح_أيقونات()
    اطبع_سطر("[ICONS] Initialized with " + طول(سطح.أيقونات) + " icons")

    # إطار 1: أيقونات بدون تحديد
    اطبع_سطر("")
    اطبع_سطر("-- Frame 1: All icons --")
    سطح.رسم(1)
    سطح.تصدير("C:\\beeos_icons.ppm")
    اطبع_سطر("  Exported: desktop icons")

    # إطار 2: تحديد أيقونة
    اطبع_سطر("")
    اطبع_سطر("-- Frame 2: Browser selected --")
    سطح.أيقونات[0].محدد = 1
    سطح.رسم(2)
    اطبع_سطر("  Selected: " + سطح.أيقونات[0].اسم)

    # إطار 3: تحديد عدة أيقونات
    اطبع_سطر("")
    اطبع_سطر("-- Frame 3: Multiple selected --")
    سطح.أيقونات[1].محدد = 1
    سطح.أيقونات[4].محدد = 1
    سطح.رسم(3)
    سطح.تصدير("C:\\beeos_icons_sel.ppm")
    اطبع_سطر("  Selected: Browser, Calculator, Files")

    # إطار 4: إلغاء التحديد
    اطبع_سطر("")
    اطبع_سطر("-- Frame 4: Deselected --")
    متغير ت = 0
    بينما (ت < طول(سطح.أيقونات))
        سطح.أيقونات[ت].محدد = 0
        ت = ت + 1
    نهاية
    سطح.رسم(4)
    اطبع_سطر("  All deselected")

    # إحصائيات
    اطبع_سطر("")
    متغير أسود = عد_بكسلات(سطح.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("  Total pixels: ")
    اطبع_سطر(إجمالي)
    اطبع("  Non-black: ")
    اطبع_سطر(إجمالي - أسود)
    اطبع("  Icons: ")
    اطبع_سطر(طول(سطح.أيقونات))

    اطبع_سطر("")
    اطبع_سطر("=== Desktop Icons: SUCCESS ===")

    ارجع 0
نهاية
