# قائمة_السياق.ص - قائمة النقر الأيمن لنظام خلية النحل
# BeeOS Right-Click Context Menu - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536

# ──────────────────────────────────────────────────────────────────
# صنف عنصر قائمة
# ──────────────────────────────────────────────────────────────────
صنف عنصر_سياق
    نص تسمية
    نص اختصار
    رقم مفعل
    رقم فاصل

    باني(تسمية_ع، اختصار_ع، مفعل_ع، فاصل_ع)
        هذا.تسمية = تسمية_ع
        هذا.اختصار = اختصار_ع
        هذا.مفعل = مفعل_ع
        هذا.فاصل = فاصل_ع
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# صنف قائمة السياق
# ──────────────────────────────────────────────────────────────────
صنف قائمة_سياق
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    رقم ظاهرة
    رقم موقع_x
    رقم موقع_y
    رقم عنصر_محدد
    مصفوفة عناصر
    رقم عرض_قائمة
    رقم نوع_سياق

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.ظاهرة = 0
        هذا.موقع_x = 0
        هذا.موقع_y = 0
        هذا.عنصر_محدد = -1
        هذا.عناصر = []
        هذا.عرض_قائمة = 220
        هذا.نوع_سياق = 0
    نهاية

    # تحميل قائمة سطح المكتب
    دالة تحميل_سطح_مكتب()
        هذا.عناصر = []
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("View", "", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Sort By", "", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Refresh", "F5", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("", "", 0، 1)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("New Folder", "Ctrl+N", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("New File", "Ctrl+F", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("", "", 0، 1)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Paste", "Ctrl+V", 0، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("", "", 0، 1)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Display Settings", "", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Personalize", "", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Terminal Here", "Ctrl+T", 1، 0)]
        هذا.نوع_سياق = 0
        ارجع 1
    نهاية

    # تحميل قائمة ملف
    دالة تحميل_ملف()
        هذا.عناصر = []
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Open", "Enter", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Open With...", "", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("", "", 0، 1)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Cut", "Ctrl+X", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Copy", "Ctrl+C", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Paste", "Ctrl+V", 0، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("", "", 0، 1)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Rename", "F2", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Delete", "Del", 1، 0)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("", "", 0، 1)]
        هذا.عناصر = هذا.عناصر + [جديد عنصر_سياق("Properties", "Alt+P", 1، 0)]
        هذا.نوع_سياق = 1
        ارجع 1
    نهاية

    # فتح القائمة
    دالة فتح(mx، my)
        هذا.ظاهرة = 1
        هذا.موقع_x = mx
        هذا.موقع_y = my
        هذا.عنصر_محدد = -1
    نهاية

    # رسم القائمة
    دالة رسم_القائمة(ف)
        اذا (!هذا.ظاهرة)
            ارجع 0
        نهاية

        متغير mx = هذا.موقع_x
        متغير my = هذا.موقع_y
        متغير mw = هذا.عرض_قائمة

        # حساب الارتفاع
        متغير mh = 8
        متغير ت = 0
        بينما (ت < طول(هذا.عناصر))
            اذا (هذا.عناصر[ت].فاصل)
                mh = mh + 8
            والا
                mh = mh + 26
            نهاية
            ت = ت + 1
        نهاية

        # ظل
        ارسم_مستطيل_أصلي(ف، mx + 3، my + 3، mw، mh، امزج_لون(ل_أسود، ل_أزرق_غ، 20))

        # خلفية
        متغير لون_خلف = امزج_لون(ل_أسود، ل_أزرق_غ، 45)
        ارسم_مستطيل_أصلي(ف، mx، my، mw، mh، لون_خلف)
        ارسم_إطار_أصلي(ف، mx، my، mw، mh، 1، ل_رمادي_غ)

        # رسم العناصر
        متغير ey = my + 4
        متغير عداد = 0
        متغير ي = 0
        بينما (ي < طول(هذا.عناصر))
            متغير عنصر = هذا.عناصر[ي]

            اذا (عنصر.فاصل)
                # خط فاصل
                ارسم_خط_أصلي(ف، mx + 10، ey + 4، mx + mw - 10، ey + 4، ل_رمادي_غ)
                ey = ey + 8
            والا
                # تظليل العنصر المحدد
                اذا (عداد == هذا.عنصر_محدد)
                    ارسم_مستطيل_أصلي(ف، mx + 2، ey، mw - 4، 24، امزج_لون(ل_أصفر، ل_أسود، 50))
                نهاية

                # التسمية
                اذا (عنصر.مفعل)
                    ارسم_نص_أصلي(ف، mx + 15، ey + 5، عنصر.تسمية، 1، ل_أبيض)
                والا
                    ارسم_نص_أصلي(ف، mx + 15، ey + 5، عنصر.تسمية، 1، ل_رمادي_غ)
                نهاية

                # الاختصار
                اذا (طول(عنصر.اختصار) > 0)
                    ارسم_نص_أصلي(ف، mx + mw - 70، ey + 5، عنصر.اختصار، 1، ل_رمادي_غ)
                نهاية

                ey = ey + 26
                عداد = عداد + 1
            نهاية

            ي = ي + 1
        نهاية

        ارجع 1
    نهاية

    # رسم الشاشة
    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        # خلفية
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)

        # أيقونات ثابتة
        ارسم_مستطيل_أصلي(ف، 40، 30، 48، 48، ل_أزرق_غ)
        ارسم_إطار_أصلي(ف، 40، 30، 48، 48، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، 45، 85، "Browser"، 1، ل_أبيض)

        ارسم_مستطيل_أصلي(ف، 40، 120، 48، 48، ل_أخضر)
        ارسم_إطار_أصلي(ف، 40، 120، 48، 48، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، 52، 175، "Calc"، 1، ل_أبيض)

        # شريط المهام
        متغير لون_شريط = امزج_لون(ل_أسود، ل_أزرق_غ، 30)
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، لون_شريط)

        # مؤشر الماوس
        اذا (هذا.ظاهرة)
            # مؤشر عند مكان النقر
            ارسم_خط_أصلي(ف، هذا.موقع_x - 2، هذا.موقع_y - 2، هذا.موقع_x + 8، هذا.موقع_y + 12، ل_أبيض)
            ارسم_خط_أصلي(ف، هذا.موقع_x - 2، هذا.موقع_y - 2، هذا.موقع_x + 2، هذا.موقع_y + 14، ل_أبيض)
        نهاية

        # القائمة
        هذا.رسم_القائمة(ف)

        # swap
        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)

        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS Context Menu ===")
    اطبع_سطر("")

    متغير قائمة = جديد قائمة_سياق()
    اطبع_سطر("[CONTEXT] Menu system initialized")

    # إطار 1: سطح مكتب بدون قائمة
    اطبع_سطر("")
    اطبع_سطر("-- Frame 1: No menu --")
    قائمة.رسم(1)
    اطبع_سطر("  Clean desktop")

    # إطار 2: نقر أيمن على سطح المكتب
    اطبع_سطر("")
    اطبع_سطر("-- Frame 2: Desktop context menu --")
    قائمة.تحميل_سطح_مكتب()
    قائمة.فتح(500، 300)
    قائمة.رسم(2)
    قائمة.تصدير("C:\\beeos_ctx_desktop.ppm")
    اطبع_سطر("  Desktop menu at (500,300), items: " + طول(قائمة.عناصر))

    # إطار 3: تحديد عنصر
    اطبع_سطر("")
    اطبع_سطر("-- Frame 3: Item selected --")
    قائمة.عنصر_محدد = 2
    قائمة.رسم(3)
    اطبع_سطر("  Selected: Refresh")

    # إطار 4: قائمة ملف
    اطبع_سطر("")
    اطبع_سطر("-- Frame 4: File context menu --")
    قائمة.تحميل_ملف()
    قائمة.فتح(200، 100)
    قائمة.عنصر_محدد = 0
    قائمة.رسم(4)
    قائمة.تصدير("C:\\beeos_ctx_file.ppm")
    اطبع_سطر("  File menu at (200,100), items: " + طول(قائمة.عناصر))

    # إطار 5: تحديد Delete
    اطبع_سطر("")
    اطبع_سطر("-- Frame 5: Delete selected --")
    قائمة.عنصر_محدد = 7
    قائمة.رسم(5)
    قائمة.تصدير("C:\\beeos_ctx_delete.ppm")
    اطبع_سطر("  Selected: Delete")

    # إحصائيات
    اطبع_سطر("")
    متغير أسود = عد_بكسلات(قائمة.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("  Total pixels: ")
    اطبع_سطر(إجمالي)
    اطبع("  Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("")
    اطبع_سطر("=== Context Menu: SUCCESS ===")

    ارجع 0
نهاية
