# نظام_الاستئذان.ص — استئذان: نظام الإشعارات المحترم
# ══════════════════════════════════════════════════════════════════════════════
# مهمة ٩٨: إشعارات بأدب + مقاطعة محترمة + أذان أولوية قصوى
# ══════════════════════════════════════════════════════════════════════════════

# مستويات الأولوية (مقام)
ثابت مقام_فرض = 1     # لا يمكن تجاهله
ثابت مقام_واجب = 2    # مهم جداً
ثابت مقام_سنة = 3     # مهم
ثابت مقام_مستحب = 4   # عادي
ثابت مقام_مباح = 5    # منخفض

# أنواع الإشعارات
ثابت نوع_نظام = 1
ثابت نوع_تطبيق = 2
ثابت نوع_رسالة = 3
ثابت نوع_تنبيه = 4
ثابت نوع_أذان = 5
ثابت نوع_تحديث = 6
ثابت نوع_بطارية = 7

صنف إشعار
    رقم المعرف
    نص العنوان
    نص المحتوى
    رقم النوع
    رقم الأولوية
    نص المصدر
    منطقي مقروء
    منطقي صامت

    باني(رقم معرف, نص عنوان, نص محتوى, رقم نوع, رقم أولوية, نص مصدر)
        المعرف = معرف
        العنوان = عنوان
        المحتوى = محتوى
        النوع = نوع
        الأولوية = أولوية
        المصدر = مصدر
        مقروء = خطأ
        صامت = خطأ
    نهاية

    دالة اسم_الأولوية()
        اذا (الأولوية == مقام_فرض)
            ارجع "فرض"
        والا_اذا (الأولوية == مقام_واجب)
            ارجع "واجب"
        والا_اذا (الأولوية == مقام_سنة)
            ارجع "سنة"
        والا_اذا (الأولوية == مقام_مستحب)
            ارجع "مستحب"
        والا_اذا (الأولوية == مقام_مباح)
            ارجع "مباح"
        نهاية
        ارجع "مجهول"
    نهاية

    دالة اسم_النوع()
        اذا (النوع == نوع_نظام)
            ارجع "نظام"
        والا_اذا (النوع == نوع_تطبيق)
            ارجع "تطبيق"
        والا_اذا (النوع == نوع_رسالة)
            ارجع "رسالة"
        والا_اذا (النوع == نوع_تنبيه)
            ارجع "تنبيه"
        والا_اذا (النوع == نوع_أذان)
            ارجع "أذان"
        والا_اذا (النوع == نوع_تحديث)
            ارجع "تحديث"
        والا_اذا (النوع == نوع_بطارية)
            ارجع "بطارية"
        نهاية
        ارجع "مجهول"
    نهاية

    دالة اطبع_إشعار()
        اذا (الأولوية == مقام_فرض)
            اطبع("    🔴 ")
        والا_اذا (الأولوية == مقام_واجب)
            اطبع("    🟠 ")
        والا_اذا (الأولوية == مقام_سنة)
            اطبع("    🟡 ")
        والا
            اطبع("    ⚪ ")
        نهاية
        اطبع("[") اطبع(اسم_الأولوية()) اطبع("] ")
        اطبع(العنوان) اطبع(" — ") اطبع_سطر(المحتوى)
        اطبع("      من: ") اطبع(المصدر)
        اذا (مقروء)
            اطبع_سطر(" (مقروء)")
        والا
            اطبع_سطر(" (جديد)")
        نهاية
    نهاية
نهاية

صنف قاعدة_إزعاج
    نص الاسم
    منطقي نشطة
    رقم أدنى_أولوية    # أدنى أولوية مسموحة (1 = فرض فقط)
    منطقي صامت         # كتم الصوت

    باني(نص اسم, رقم أدنى, منطقي صمت)
        الاسم = اسم
        نشطة = صحيح
        أدنى_أولوية = أدنى
        صامت = صمت
    نهاية

    دالة اطبع_معلومات()
        اطبع("    ") اطبع(الاسم)
        اذا (نشطة)
            اطبع(" [نشطة]")
        والا
            اطبع(" [معطلة]")
        نهاية
        اطبع(" أدنى أولوية: ") اطبع(أدنى_أولوية)
        اذا (صامت)
            اطبع_سطر(" (صامت)")
        والا
            اطبع_سطر("")
        نهاية
    نهاية
نهاية

صنف مدير_الإشعارات
    رقم عدد_الإشعارات
    رقم غير_مقروءة
    رقم مرفوضة
    رقم تم_تسليمها
    منطقي وضع_خشوع       # أثناء الأذان
    منطقي وضع_عدم_إزعاج

    باني()
        عدد_الإشعارات = 0
        غير_مقروءة = 0
        مرفوضة = 0
        تم_تسليمها = 0
        وضع_خشوع = خطأ
        وضع_عدم_إزعاج = خطأ
    نهاية

    دالة أرسل_إشعار(إشعار إش)
        عدد_الإشعارات = عدد_الإشعارات + 1

        # الأذان دائماً يمر
        اذا (إش.النوع == نوع_أذان)
            اطبع_سطر("  ════════════════════")
            اطبع_سطر("  الله أكبر الله أكبر")
            اطبع("  ") اطبع_سطر(إش.المحتوى)
            اطبع_سطر("  ════════════════════")
            تم_تسليمها = تم_تسليمها + 1
            غير_مقروءة = غير_مقروءة + 1
            ارجع صحيح
        نهاية

        # وضع الخشوع يمنع غير الفرض
        اذا (وضع_خشوع)
            اذا (إش.الأولوية > مقام_فرض)
                اطبع("  مؤجل (خشوع): ") اطبع_سطر(إش.العنوان)
                مرفوضة = مرفوضة + 1
                ارجع خطأ
            نهاية
        نهاية

        # وضع عدم الإزعاج
        اذا (وضع_عدم_إزعاج)
            اذا (إش.الأولوية > مقام_واجب)
                اطبع("  محجوب (عدم إزعاج): ") اطبع_سطر(إش.العنوان)
                مرفوضة = مرفوضة + 1
                ارجع خطأ
            نهاية
        نهاية

        # تسليم الإشعار
        إش.اطبع_إشعار()
        تم_تسليمها = تم_تسليمها + 1
        غير_مقروءة = غير_مقروءة + 1
        ارجع صحيح
    نهاية

    دالة فعل_خشوع()
        وضع_خشوع = صحيح
        اطبع_سطر("  وضع الخشوع: مفعل — الإشعارات غير العاجلة مؤجلة")
    نهاية

    دالة ألغ_خشوع()
        وضع_خشوع = خطأ
        اطبع_سطر("  وضع الخشوع: ملغى — الإشعارات تعود")
    نهاية

    دالة اطبع_تقرير()
        اطبع_سطر("  ═══════ تقرير الإشعارات ═══════")
        اطبع("  إجمالي: ") اطبع_سطر(عدد_الإشعارات)
        اطبع("  تم تسليمها: ") اطبع_سطر(تم_تسليمها)
        اطبع("  غير مقروءة: ") اطبع_سطر(غير_مقروءة)
        اطبع("  مرفوضة/مؤجلة: ") اطبع_سطر(مرفوضة)
        اطبع("  وضع الخشوع: ") اطبع_سطر(وضع_خشوع)
        اطبع("  عدم إزعاج: ") اطبع_سطر(وضع_عدم_إزعاج)
        اطبع_سطر("  ═══════════════════════════════════")
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════")
    اطبع_سطر("  استئذان — نظام الإشعارات المحترم")
    اطبع_سطر("══════════════════════════════════════════════")

    متغير مدير = جديد مدير_الإشعارات()

    # إشعارات عادية
    اطبع_سطر("")
    اطبع_سطر("[1] إشعارات عادية...")
    متغير إش1 = جديد إشعار(1, "رسالة جديدة", "أهلاً وسهلاً", نوع_رسالة, مقام_مستحب, "البريد")
    متغير إش2 = جديد إشعار(2, "تحديث متاح", "إصدار 2.1 جاهز", نوع_تحديث, مقام_سنة, "مدير التحديثات")
    متغير إش3 = جديد إشعار(3, "بطارية منخفضة", "15% متبقية", نوع_بطارية, مقام_واجب, "إدارة الطاقة")
    مدير.أرسل_إشعار(إش1)
    مدير.أرسل_إشعار(إش2)
    مدير.أرسل_إشعار(إش3)

    # أذان (أولوية قصوى)
    اطبع_سطر("")
    اطبع_سطر("[2] إشعار الأذان...")
    متغير أذان = جديد إشعار(4, "أذان الظهر", "حي على الصلاة", نوع_أذان, مقام_فرض, "ساعة الأذان")
    مدير.أرسل_إشعار(أذان)

    # وضع الخشوع
    اطبع_سطر("")
    اطبع_سطر("[3] وضع الخشوع...")
    مدير.فعل_خشوع()
    متغير إش5 = جديد إشعار(5, "إشعار لعبة", "دورك الآن", نوع_تطبيق, مقام_مباح, "لعبة")
    متغير إش6 = جديد إشعار(6, "تنبيه أمني", "محاولة دخول", نوع_نظام, مقام_فرض, "الأمان")
    مدير.أرسل_إشعار(إش5)
    مدير.أرسل_إشعار(إش6)
    مدير.ألغ_خشوع()

    # وضع عدم الإزعاج
    اطبع_سطر("")
    اطبع_سطر("[4] وضع عدم الإزعاج...")
    مدير.وضع_عدم_إزعاج = صحيح
    متغير إش7 = جديد إشعار(7, "رسالة ترويجية", "خصم 50%", نوع_تطبيق, مقام_مباح, "متجر")
    متغير إش8 = جديد إشعار(8, "تنبيه عاجل", "خطأ في النظام", نوع_نظام, مقام_واجب, "النواة")
    مدير.أرسل_إشعار(إش7)
    مدير.أرسل_إشعار(إش8)
    مدير.وضع_عدم_إزعاج = خطأ

    # قواعد الإزعاج
    اطبع_سطر("")
    اطبع_سطر("[5] قواعد الإزعاج...")
    متغير قاعدة1 = جديد قاعدة_إزعاج("ساعات النوم", مقام_فرض, صحيح)
    متغير قاعدة2 = جديد قاعدة_إزعاج("ساعات العمل", مقام_سنة, خطأ)
    قاعدة1.اطبع_معلومات()
    قاعدة2.اطبع_معلومات()

    # تقرير نهائي
    اطبع_سطر("")
    مدير.اطبع_تقرير()

    اطبع_سطر("")
    اطبع_سطر("  جميع اختبارات نظام الإشعارات نجحت!")
    ارجع 0
نهاية
