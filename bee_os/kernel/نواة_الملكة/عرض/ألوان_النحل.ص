# ألوان النحل - لوحة ألوان نظام خلية النحل
# ══════════════════════════════════════════════════════════════════════

صنف لون_نحل
    رقم أحمر
    رقم أخضر
    رقم أزرق
    نص الاسم_عربي

    باني(رقم ح، رقم خ، رقم ز، نص اسم)
        أحمر = ح
        أخضر = خ
        أزرق = ز
        الاسم_عربي = اسم
    نهاية

    دالة رقم قيمة_مدمجة()
        ارجع (255 * 16777216) + (أحمر * 65536) + (أخضر * 256) + أزرق
    نهاية

    دالة عرض()
        اطبع("  ")
        اطبع(الاسم_عربي)
        اطبع(": (")
        اطبع(أحمر)
        اطبع("،")
        اطبع(أخضر)
        اطبع("،")
        اطبع(أزرق)
        اطبع(") = ")
        اطبع_سطر(قيمة_مدمجة())
    نهاية
نهاية

صنف لوحة_ألوان
    رقم عدد_ألوان

    باني()
        عدد_ألوان = 0
    نهاية

    دالة عرض_كل_الألوان()
        اطبع_سطر("═══ لوحة ألوان النحل ═══")

        متغير عسلي_ذهبي = جديد لون_نحل(255، 165، 0، "عسلي ذهبي")
        عسلي_ذهبي.عرض()

        متغير أسود_نحل = جديد لون_نحل(30، 30، 30، "أسود النحل")
        أسود_نحل.عرض()

        متغير أصفر_نحل = جديد لون_نحل(255، 218، 51، "أصفر النحل")
        أصفر_نحل.عرض()

        متغير بني_شمع = جديد لون_نحل(139، 101، 55، "بني الشمع")
        بني_شمع.عرض()

        متغير أبيض_حليبي = جديد لون_نحل(250، 245، 230، "أبيض حليبي")
        أبيض_حليبي.عرض()

        متغير أخضر_نعناع = جديد لون_نحل(60، 179، 113، "أخضر نعناع")
        أخضر_نعناع.عرض()

        متغير أحمر_خطر = جديد لون_نحل(220، 50، 47، "أحمر الخطر")
        أحمر_خطر.عرض()

        متغير أزرق_سماء = جديد لون_نحل(100، 149، 237، "أزرق السماء")
        أزرق_سماء.عرض()

        عدد_ألوان = 8
        اطبع("  عدد الألوان: ")
        اطبع_سطر(عدد_ألوان)
    نهاية
نهاية

دالة رئيسية()
    متغير لوحة = جديد لوحة_ألوان()
    لوحة.عرض_كل_الألوان()
    اطبع_سطر("  ✅ ألوان النحل تعمل")
    ارجع 0
نهاية
