# ══════════════════════════════════════════════════════════════════════
# راسم الخط - عرض الحروف من خط البسملة المضغوط
# ══════════════════════════════════════════════════════════════════════

صنف بيانات_حرف
    رقم نقطة_يونيكود
    رقم عرض_بكسل
    رقم ارتفاع_بكسل
    رقم تقدم_عرض
    رقم علامات_حرف

    باني(رقم يونيكود، رقم عرض، رقم ارتفاع)
        نقطة_يونيكود = يونيكود
        عرض_بكسل = عرض
        ارتفاع_بكسل = ارتفاع
        تقدم_عرض = عرض
        علامات_حرف = 0
    نهاية

    دالة رقم من_يمين()
        ارجع علامات_حرف / 2
    نهاية

    دالة رقم واصل()
        اذا (علامات_حرف == 2)
            ارجع 1
        نهاية
        اذا (علامات_حرف == 3)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة عرض()
        اطبع("  حرف U+")
        اطبع(نقطة_يونيكود)
        اطبع(" ")
        اطبع(عرض_بكسل)
        اطبع("x")
        اطبع_سطر(ارتفاع_بكسل)
    نهاية
نهاية

صنف ذاكرة_موقتة_حروف
    رقم أقصى_حروف
    رقم عدد_حالي
    رقم إصابات
    رقم أخطاء

    باني(رقم أقصى)
        أقصى_حروف = أقصى
        عدد_حالي = 0
        إصابات = 0
        أخطاء = 0
    نهاية

    دالة بحث(رقم يونيكود)
        إصابات = إصابات + 1
    نهاية

    دالة إضافة(رقم يونيكود)
        عدد_حالي = عدد_حالي + 1
    نهاية

    دالة عرض_إحصائيات()
        اطبع("  ذاكرة موقتة: ")
        اطبع(عدد_حالي)
        اطبع("/")
        اطبع(أقصى_حروف)
        اطبع("  إصابات=")
        اطبع_سطر(إصابات)
    نهاية
نهاية

صنف راسم_خط_عربي
    رقم عرض_حرف_قياسي
    رقم ارتفاع_حرف_قياسي
    رقم لون_أمامي
    رقم لون_خلفي
    رقم تباعد_حروف
    رقم تباعد_أسطر
    رقم عدد_حروف_مرسومة

    باني()
        عرض_حرف_قياسي = 16
        ارتفاع_حرف_قياسي = 24
        لون_أمامي = 4294962355
        لون_خلفي = 0
        تباعد_حروف = 1
        تباعد_أسطر = 4
        عدد_حروف_مرسومة = 0
    نهاية

    دالة رسم_حرف(رقم يونيكود، رقم س، رقم ص)
        عدد_حروف_مرسومة = عدد_حروف_مرسومة + 1
        اطبع("  رسم U+")
        اطبع(يونيكود)
        اطبع(" @ (")
        اطبع(س)
        اطبع("،")
        اطبع(ص)
        اطبع_سطر(")")
    نهاية

    دالة رقم رسم_نص(نص محتوى، رقم س، رقم ص)
        اطبع("  رسم نص: ")
        اطبع(محتوى)
        اطبع(" @ (")
        اطبع(س)
        اطبع("،")
        اطبع(ص)
        اطبع_سطر(")")
        ارجع س + 100
    نهاية

    دالة تعيين_ألوان(رقم أمامي، رقم خلفي)
        لون_أمامي = أمامي
        لون_خلفي = خلفي
    نهاية

    دالة رقم عرض_نص_بكسل(نص محتوى)
        ارجع 10 * (عرض_حرف_قياسي + تباعد_حروف)
    نهاية

    دالة عرض_إحصائيات()
        اطبع("  حروف مرسومة: ")
        اطبع_سطر(عدد_حروف_مرسومة)
        اطبع("  حجم الحرف: ")
        اطبع(عرض_حرف_قياسي)
        اطبع("x")
        اطبع_سطر(ارتفاع_حرف_قياسي)
    نهاية
نهاية

دالة رئيسية()
    متغير راسم = جديد راسم_خط_عربي()
    متغير ذاكرة = جديد ذاكرة_موقتة_حروف(256)

    راسم.رسم_حرف(1576، 100، 50)
    راسم.رسم_حرف(1587، 116، 50)
    راسم.رسم_حرف(1605، 132، 50)
    راسم.رسم_نص("بسم الله", 50، 100)

    ذاكرة.بحث(1576)
    ذاكرة.إضافة(1576)

    راسم.عرض_إحصائيات()
    ذاكرة.عرض_إحصائيات()
    اطبع_سطر("  ✅ راسم الخط يعمل")
    ارجع 0
نهاية
