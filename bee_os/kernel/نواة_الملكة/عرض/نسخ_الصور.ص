# نسخ_الصور.ص - نسخ الصور النقطية (Blitting)
# نظام خلية النحل - نواة الملكة / عرض
# نسخ مناطق من صورة إلى ذاكرة العرض
# ══════════════════════════════════════════════════════════════════════

صنف صورة_نقطية
    رقم العرض
    رقم الارتفاع
    رقم عمق_البت
    رقم خطوة_البايت

    باني(رقم عرض_الصورة، رقم ارتفاع_الصورة، رقم العمق)
        العرض = عرض_الصورة
        الارتفاع = ارتفاع_الصورة
        عمق_البت = العمق
        خطوة_البايت = عرض_الصورة * (العمق / 8)
    نهاية

    دالة رقم اعط_العرض()
        ارجع العرض
    نهاية

    دالة رقم اعط_الارتفاع()
        ارجع الارتفاع
    نهاية

    دالة رقم اعط_مساحة_البايت()
        ارجع خطوة_البايت * الارتفاع
    نهاية

    دالة رقم إزاحة_صف(رقم ص)
        اذا (ص < 0)
            ارجع 0
        نهاية
        اذا (ص >= الارتفاع)
            ارجع 0
        نهاية
        ارجع ص * خطوة_البايت
    نهاية
نهاية

صنف ناسخ_مناطق
    رقم عدد_النسخ
    رقم عدد_البكسلات_المنسوخة

    باني()
        عدد_النسخ = 0
        عدد_البكسلات_المنسوخة = 0
    نهاية

    دالة رقم انسخ_منطقة(رقم مصدر_س، رقم مصدر_ص، رقم هدف_س، رقم هدف_ص، رقم عرض_منطقة، رقم ارتفاع_منطقة)
        متغير بكسلات = عرض_منطقة * ارتفاع_منطقة
        عدد_البكسلات_المنسوخة = عدد_البكسلات_المنسوخة + بكسلات
        عدد_النسخ = عدد_النسخ + 1
        ارجع بكسلات
    نهاية

    دالة رقم انسخ_كامل(رقم هدف_س، رقم هدف_ص، رقم عرض_مصدر، رقم ارتفاع_مصدر)
        ارجع انسخ_منطقة(0، 0، هدف_س، هدف_ص، عرض_مصدر، ارتفاع_مصدر)
    نهاية

    دالة رقم اعط_عدد_النسخ()
        ارجع عدد_النسخ
    نهاية

    دالة رقم اعط_مجموع_البكسلات()
        ارجع عدد_البكسلات_المنسوخة
    نهاية
نهاية

صنف قصاص_منطقة
    رقم حد_س1
    رقم حد_ص1
    رقم حد_س2
    رقم حد_ص2

    باني(رقم س1، رقم ص1، رقم س2، رقم ص2)
        حد_س1 = س1
        حد_ص1 = ص1
        حد_س2 = س2
        حد_ص2 = ص2
    نهاية

    دالة رقم قص_س(رقم س)
        اذا (س < حد_س1)
            ارجع حد_س1
        نهاية
        اذا (س > حد_س2)
            ارجع حد_س2
        نهاية
        ارجع س
    نهاية

    دالة رقم قص_ص(رقم ص)
        اذا (ص < حد_ص1)
            ارجع حد_ص1
        نهاية
        اذا (ص > حد_ص2)
            ارجع حد_ص2
        نهاية
        ارجع ص
    نهاية

    دالة رقم داخل_الحدود(رقم س، رقم ص)
        اذا (س < حد_س1)
            ارجع 0
        نهاية
        اذا (ص < حد_ص1)
            ارجع 0
        نهاية
        اذا (س > حد_س2)
            ارجع 0
        نهاية
        اذا (ص > حد_ص2)
            ارجع 0
        نهاية
        ارجع 1
    نهاية

    دالة رقم عرض_المنطقة()
        ارجع حد_س2 - حد_س1
    نهاية
نهاية

