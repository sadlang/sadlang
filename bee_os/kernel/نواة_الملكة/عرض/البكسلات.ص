دالة رئيسية()
    متغير ب = جديد بكسل(255، 128، 64، 255)
    اطبع("  أحمر: ")
    اطبع_سطر(ب.اعط_أحمر())
    اطبع("  أخضر: ")
    اطبع_سطر(ب.اعط_أخضر())
    اطبع("  قيمة 32 بت: ")
    اطبع_سطر(ب.إلى_رقم_32())

    متغير عمليات = جديد عمليات_بكسل(640، 480)
    عمليات.اكتب_بكسل(100، 200، 16711680)
    عمليات.اكتب_بكسل(300، 400، 65280)
    اطبع("  عدد الكتابات: ")
    اطبع_سطر(عمليات.اعط_عدد_الكتابات())
    اطبع("  أحمر من 16711680: ")
    اطبع_سطر(عمليات.استخرج_أحمر(16711680))

    متغير مخزن = جديد مخزن_بكسلات(320، 240)
    اطبع("  مجموع البكسلات: ")
    اطبع_سطر(مخزن.اعط_المجموع())
    اطبع("  فهرس (10,5): ")
    اطبع_سطر(مخزن.فهرس(10، 5))

    اطبع_سطر("  ✅ البكسلات يعمل")
    ارجع 0
نهاية
