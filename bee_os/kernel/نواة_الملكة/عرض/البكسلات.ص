# البكسلات.ص - عمليات البكسل
# نظام خلية النحل - نواة الملكة / عرض
# قراءة وكتابة وتعديل البكسلات
# ══════════════════════════════════════════════════════════════════════

صنف بكسل
    رقم أحمر
    رقم أخضر
    رقم أزرق
    رقم شفافية

    باني(رقم ح، رقم خ، رقم ز، رقم ش)
        أحمر = ح
        أخضر = خ
        أزرق = ز
        شفافية = ش
    نهاية

    دالة رقم اعط_أحمر()
        ارجع أحمر
    نهاية

    دالة رقم اعط_أخضر()
        ارجع أخضر
    نهاية

    دالة رقم اعط_أزرق()
        ارجع أزرق
    نهاية

    دالة رقم اعط_شفافية()
        ارجع شفافية
    نهاية

    دالة رقم إلى_رقم_32()
        ارجع (شفافية * 16777216) + (أحمر * 65536) + (أخضر * 256) + أزرق
    نهاية
نهاية

صنف عمليات_بكسل
    رقم عرض_المخزن
    رقم ارتفاع_المخزن
    رقم عدد_الكتابات

    باني(رقم العرض، رقم الارتفاع)
        عرض_المخزن = العرض
        ارتفاع_المخزن = الارتفاع
        عدد_الكتابات = 0
    نهاية

    دالة رقم اكتب_بكسل(رقم س، رقم ص، رقم قيمة_اللون)
        اذا (س < 0)
            ارجع 0
        نهاية
        اذا (ص < 0)
            ارجع 0
        نهاية
        اذا (س >= عرض_المخزن)
            ارجع 0
        نهاية
        اذا (ص >= ارتفاع_المخزن)
            ارجع 0
        نهاية
        عدد_الكتابات = عدد_الكتابات + 1
        ارجع 1
    نهاية

    دالة رقم استخرج_أحمر(رقم قيمة_32)
        ارجع (قيمة_32 / 65536) - ((قيمة_32 / 16777216) * 256)
    نهاية

    دالة رقم استخرج_أخضر(رقم قيمة_32)
        ارجع (قيمة_32 / 256) - ((قيمة_32 / 65536) * 256)
    نهاية

    دالة رقم استخرج_أزرق(رقم قيمة_32)
        ارجع قيمة_32 - ((قيمة_32 / 256) * 256)
    نهاية

    دالة رقم اعط_عدد_الكتابات()
        ارجع عدد_الكتابات
    نهاية
نهاية

صنف مخزن_بكسلات
    رقم العرض
    رقم الارتفاع
    رقم مجموع_البكسلات

    باني(رقم عرض_المخزن، رقم ارتفاع_المخزن)
        العرض = عرض_المخزن
        الارتفاع = ارتفاع_المخزن
        مجموع_البكسلات = عرض_المخزن * ارتفاع_المخزن
    نهاية

    دالة رقم اعط_المجموع()
        ارجع مجموع_البكسلات
    نهاية

    دالة رقم فهرس(رقم س، رقم ص)
        ارجع ص * العرض + س
    نهاية

    دالة رقم املأ_لون(رقم قيمة_اللون)
        # ملء كل البكسلات بلون واحد
        ارجع مجموع_البكسلات
    نهاية
نهاية

