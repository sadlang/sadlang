# حركة_الإقلاع.ص - حركة الإقلاع (موضوع النحل)
# نظام خلية النحل - نواة الملكة / عرض
# رسم حركي لنحلة أثناء إقلاع النظام
# ══════════════════════════════════════════════════════════════════════

صنف إطار_حركة
    رقم رقم_الإطار
    رقم مدة_الإطار
    رقم موضع_س
    رقم موضع_ص

    باني(رقم الرقم، رقم المدة، رقم س، رقم ص)
        رقم_الإطار = الرقم
        مدة_الإطار = المدة
        موضع_س = س
        موضع_ص = ص
    نهاية

    دالة رقم اعط_الرقم()
        ارجع رقم_الإطار
    نهاية

    دالة رقم اعط_المدة()
        ارجع مدة_الإطار
    نهاية

    دالة رقم اعط_س()
        ارجع موضع_س
    نهاية

    دالة رقم اعط_ص()
        ارجع موضع_ص
    نهاية
نهاية

صنف نحلة_متحركة
    رقم موضع_س
    رقم موضع_ص
    رقم سرعة_س
    رقم سرعة_ص
    رقم عرض_النحلة
    رقم ارتفاع_النحلة
    رقم إطار_الجناح

    باني(رقم بداية_س، رقم بداية_ص)
        موضع_س = بداية_س
        موضع_ص = بداية_ص
        سرعة_س = 3
        سرعة_ص = 1
        عرض_النحلة = 32
        ارتفاع_النحلة = 24
        إطار_الجناح = 0
    نهاية

    دالة رقم حرك()
        موضع_س = موضع_س + سرعة_س
        موضع_ص = موضع_ص + سرعة_ص
        # تبديل إطار الجناح للخفقان
        اذا (إطار_الجناح == 0)
            إطار_الجناح = 1
        والا
            إطار_الجناح = 0
        نهاية
        ارجع 1
    نهاية

    دالة رقم اعط_س()
        ارجع موضع_س
    نهاية

    دالة رقم اعط_ص()
        ارجع موضع_ص
    نهاية

    دالة رقم اعط_إطار_الجناح()
        ارجع إطار_الجناح
    نهاية

    دالة رقم هل_وصل_الهدف(رقم هدف_س، رقم هدف_ص)
        اذا (موضع_س >= هدف_س)
            اذا (موضع_ص >= هدف_ص)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية
نهاية

صنف تسلسل_إقلاع
    رقم الإطار_الحالي
    رقم إجمالي_الإطارات
    رقم اكتمل_التسلسل

    باني(رقم عدد_الإطارات)
        الإطار_الحالي = 0
        إجمالي_الإطارات = عدد_الإطارات
        اكتمل_التسلسل = 0
    نهاية

    دالة رقم الإطار_التالي()
        اذا (الإطار_الحالي >= إجمالي_الإطارات)
            اكتمل_التسلسل = 1
            ارجع -1
        نهاية
        الإطار_الحالي = الإطار_الحالي + 1
        ارجع الإطار_الحالي
    نهاية

    دالة رقم نسبة_الاكتمال()
        ارجع (الإطار_الحالي * 100) / إجمالي_الإطارات
    نهاية

    دالة رقم هل_اكتمل()
        ارجع اكتمل_التسلسل
    نهاية

    دالة رقم اعط_الإطار_الحالي()
        ارجع الإطار_الحالي
    نهاية
نهاية

صنف رسام_قرص_العسل
    رقم مركز_س
    رقم مركز_ص
    رقم نصف_قطر_الخلية
    رقم عدد_الخلايا

    باني(رقم س، رقم ص، رقم نصف_القطر)
        مركز_س = س
        مركز_ص = ص
        نصف_قطر_الخلية = نصف_القطر
        عدد_الخلايا = 0
    نهاية

    دالة رقم ارسم_خلية(رقم صف، رقم عمود)
        عدد_الخلايا = عدد_الخلايا + 1
        متغير س = مركز_س + (عمود * نصف_قطر_الخلية * 2)
        متغير ص = مركز_ص + (صف * نصف_قطر_الخلية * 2)
        ارجع عدد_الخلايا
    نهاية

    دالة رقم اعط_عدد_الخلايا()
        ارجع عدد_الخلايا
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير إطار = جديد إطار_حركة(1، 33، 100، 200)
    اطبع("  إطار رقم: ")
    اطبع_سطر(إطار.اعط_الرقم())

    متغير نحلة = جديد نحلة_متحركة(50، 100)
    نحلة.حرك()
    نحلة.حرك()
    نحلة.حرك()
    اطبع("  موضع النحلة س: ")
    اطبع_سطر(نحلة.اعط_س())
    اطبع("  إطار الجناح: ")
    اطبع_سطر(نحلة.اعط_إطار_الجناح())

    متغير تسلسل = جديد تسلسل_إقلاع(60)
    تسلسل.الإطار_التالي()
    تسلسل.الإطار_التالي()
    اطبع("  نسبة الاكتمال: ")
    اطبع_سطر(تسلسل.نسبة_الاكتمال())

    متغير قرص = جديد رسام_قرص_العسل(320، 240، 8)
    قرص.ارسم_خلية(0، 0)
    قرص.ارسم_خلية(0، 1)
    قرص.ارسم_خلية(1، 0)
    اطبع("  عدد خلايا العسل: ")
    اطبع_سطر(قرص.اعط_عدد_الخلايا())

    اطبع_سطر("  ✅ حركة_الإقلاع يعمل")
    ارجع 0
نهاية
