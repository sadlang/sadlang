# محرك_السمات.ص - محرك السمات / الثيمات
# BeeOS Theme Engine - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296

صنف سمة
    نص اسم_سمة
    رقم لون_خلفية
    رقم لون_خلفية2
    رقم لون_نافذة
    رقم لون_عنوان
    رقم لون_نص_رئيسي
    رقم لون_نص_ثانوي
    رقم لون_تمييز
    رقم لون_زر
    رقم لون_شريط
    رقم لون_إطار

    باني(اسم، خلف، خلف2، ناف، عنو، نص1، نص2، تمي، زرر، شري، إطا)
        هذا.اسم_سمة = اسم
        هذا.لون_خلفية = خلف
        هذا.لون_خلفية2 = خلف2
        هذا.لون_نافذة = ناف
        هذا.لون_عنوان = عنو
        هذا.لون_نص_رئيسي = نص1
        هذا.لون_نص_ثانوي = نص2
        هذا.لون_تمييز = تمي
        هذا.لون_زر = زرر
        هذا.لون_شريط = شري
        هذا.لون_إطار = إطا
    نهاية
نهاية

صنف محرك_سمات
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    مصفوفة سمات_قائمة
    رقم سمة_نشطة

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.سمات_قائمة = []
        هذا.سمة_نشطة = 0
    نهاية

    دالة إضافة_سمة(سم)
        هذا.سمات_قائمة = هذا.سمات_قائمة + [سم]
    نهاية

    دالة رسم_نموذج_نافذة(ف، سم، wx، wy، ww، wh)
        # النافذة
        ارسم_مستطيل_أصلي(ف، wx، wy، ww، wh، سم.لون_نافذة)
        ارسم_إطار_أصلي(ف، wx، wy، ww، wh، 2، سم.لون_إطار)

        # شريط العنوان
        ارسم_مستطيل_أصلي(ف، wx، wy، ww، 28، سم.لون_عنوان)
        ارسم_نص_أصلي(ف، wx + 10، wy + 7، "Sample Window"، 1، سم.لون_نص_رئيسي)

        # أزرار النافذة
        ارسم_دائرة_مصمتة(ف، wx + ww - 18، wy + 14، 8، ل_أحمر)
        ارسم_دائرة_مصمتة(ف، wx + ww - 38، wy + 14، 8، ل_أصفر)
        ارسم_دائرة_مصمتة(ف، wx + ww - 58، wy + 14، 8، ل_أخضر)

        # محتوى النافذة
        ارسم_نص_أصلي(ف، wx + 15، wy + 40، "BeeOS Theme Preview"، 2، سم.لون_نص_رئيسي)
        ارسم_خط_أصلي(ف، wx + 15، wy + 62، wx + ww - 15، wy + 62، سم.لون_إطار)

        ارسم_نص_أصلي(ف، wx + 15، wy + 75، "Primary text sample"، 1، سم.لون_نص_رئيسي)
        ارسم_نص_أصلي(ف، wx + 15، wy + 95، "Secondary text sample"، 1، سم.لون_نص_ثانوي)

        # أزرار
        ارسم_مستطيل_أصلي(ف، wx + 15، wy + 125، 90، 28، سم.لون_زر)
        ارسم_نص_أصلي(ف، wx + 25، wy + 132، "Primary"، 1، سم.لون_نص_رئيسي)

        ارسم_مستطيل_أصلي(ف، wx + 115، wy + 125، 90، 28، سم.لون_تمييز)
        ارسم_نص_أصلي(ف، wx + 125، wy + 132، "Accent"، 1، ل_أبيض)

        ارسم_إطار_أصلي(ف، wx + 215، wy + 125، 90، 28، 1، سم.لون_إطار)
        ارسم_نص_أصلي(ف، wx + 225، wy + 132، "Outline"، 1، سم.لون_نص_ثانوي)

        # شريط تقدم
        ارسم_مستطيل_أصلي(ف، wx + 15، wy + 170، ww - 30، 12، سم.لون_إطار)
        ارسم_مستطيل_أصلي(ف، wx + 15، wy + 170، (ww - 30) * 65 / 100، 12، سم.لون_تمييز)

        # قائمة
        متغير ق = 0
        بينما (ق < 3)
            متغير ly = wy + 200 + ق * 28
            اذا (ق == 1)
                ارسم_مستطيل_أصلي(ف، wx + 15، ly، ww - 30، 26، سم.لون_تمييز)
                ارسم_نص_أصلي(ف، wx + 25، ly + 6، "Item " + (ق + 1) + " (selected)"، 1، ل_أبيض)
            والا
                ارسم_مستطيل_أصلي(ف، wx + 15، ly، ww - 30، 26، سم.لون_نافذة)
                ارسم_نص_أصلي(ف، wx + 25، ly + 6، "Item " + (ق + 1)، 1، سم.لون_نص_رئيسي)
            نهاية
            ق = ق + 1
        نهاية

        ارجع 1
    نهاية

    دالة رسم(إطار، سم_مفعلة)
        متغير ف = هذا.مقبض_خلفي
        متغير سم = سم_مفعلة

        # خلفية سطح المكتب
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، سم.لون_خلفية، سم.لون_خلفية2)

        # شريط مهام
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 44، عرض_شاشة، 44، سم.لون_شريط)
        ارسم_خط_أصلي(ف، 0، ارت_شاشة - 44، عرض_شاشة، ارت_شاشة - 44، سم.لون_إطار)
        ارسم_نص_أصلي(ف، 20، ارت_شاشة - 32، "Start"، 1، سم.لون_نص_رئيسي)
        ارسم_نص_أصلي(ف، عرض_شاشة - 100، ارت_شاشة - 32، "12:00 PM"، 1، سم.لون_نص_ثانوي)

        # عنوان
        ارسم_نص_أصلي(ف، عرض_شاشة / 2 - 120، 15، "BeeOS Theme Engine"، 3، سم.لون_تمييز)
        ارسم_نص_أصلي(ف، عرض_شاشة / 2 - 50، 55، "Theme: " + سم.اسم_سمة، 2، سم.لون_نص_رئيسي)

        # نافذة عرض 1 (يسار)
        هذا.رسم_نموذج_نافذة(ف، سم، 100، 100، 380، 310)

        # نافذة عرض 2 (وسط)
        هذا.رسم_نموذج_نافذة(ف، سم، 520، 130، 380، 310)

        # لوحة ألوان يمين
        متغير لوحة_x = 950
        متغير لوحة_y = 100
        ارسم_مستطيل_أصلي(ف، لوحة_x، لوحة_y، 450، 340، سم.لون_نافذة)
        ارسم_إطار_أصلي(ف، لوحة_x، لوحة_y، 450، 340، 2، سم.لون_إطار)
        ارسم_مستطيل_أصلي(ف، لوحة_x، لوحة_y، 450، 30، سم.لون_عنوان)
        ارسم_نص_أصلي(ف، لوحة_x + 10، لوحة_y + 8، "Color Palette"، 1، سم.لون_نص_رئيسي)

        # عرض الألوان
        مصفوفة أسماء = ["Background", "Window", "Title Bar", "Primary Text", "Secondary", "Accent", "Button", "Taskbar", "Border"]
        مصفوفة ألوان = [سم.لون_خلفية، سم.لون_نافذة، سم.لون_عنوان، سم.لون_نص_رئيسي، سم.لون_نص_ثانوي، سم.لون_تمييز، سم.لون_زر، سم.لون_شريط، سم.لون_إطار]

        متغير لأ = 0
        بينما (لأ < طول(أسماء))
            متغير cy = لوحة_y + 45 + لأ * 32
            ارسم_مستطيل_أصلي(ف، لوحة_x + 15، cy، 30، 22، ألوان[لأ])
            ارسم_إطار_أصلي(ف، لوحة_x + 15، cy، 30، 22، 1، سم.لون_إطار)
            ارسم_نص_أصلي(ف، لوحة_x + 55، cy + 4، أسماء[لأ]، 1، سم.لون_نص_رئيسي)
            لأ = لأ + 1
        نهاية

        # نافذة صغيرة أسفل يسار
        ارسم_مستطيل_أصلي(ف، 100، 450، 800، 160، سم.لون_نافذة)
        ارسم_إطار_أصلي(ف، 100، 450، 800، 160، 2، سم.لون_إطار)
        ارسم_مستطيل_أصلي(ف، 100، 450، 800، 28، سم.لون_عنوان)
        ارسم_نص_أصلي(ف، 115، 457، "System Status Bar"، 1، سم.لون_نص_رئيسي)

        # محتوى شريط
        مصفوفة widgets = ["CPU: 45%", "RAM: 62%", "Disk: 33%", "Net: 12MB/s", "Temp: 52C"]
        متغير ود = 0
        بينما (ود < طول(widgets))
            متغير wx_w = 115 + ود * 155
            ارسم_مستطيل_أصلي(ف، wx_w، 490، 140، 50، امزج_لون(سم.لون_نافذة، سم.لون_تمييز، 80))
            ارسم_نص_أصلي(ف، wx_w + 10، 500، widgets[ود]، 1، سم.لون_نص_رئيسي)
            # شريط صغير
            ارسم_مستطيل_أصلي(ف، wx_w + 5، 525، 130، 8، سم.لون_إطار)
            ارسم_مستطيل_أصلي(ف، wx_w + 5، 525، 130 * (30 + ود * 10) / 100، 8، سم.لون_تمييز)
            ود = ود + 1
        نهاية

        # اختيار السمات أسفل يمين
        متغير sel_x = 950
        متغير sel_y = 470
        ارسم_مستطيل_أصلي(ف، sel_x، sel_y، 450، 140، سم.لون_نافذة)
        ارسم_إطار_أصلي(ف، sel_x، sel_y، 450، 140، 2، سم.لون_إطار)
        ارسم_مستطيل_أصلي(ف، sel_x، sel_y، 450، 28، سم.لون_عنوان)
        ارسم_نص_أصلي(ف، sel_x + 10، sel_y + 8، "Available Themes"، 1، سم.لون_نص_رئيسي)

        مصفوفة ثيمات = ["Dark Hive", "Light Bee", "Ocean Blue", "Forest Green", "Sunset Amber"]
        متغير ثم = 0
        بينما (ثم < طول(ثيمات))
            متغير thy = sel_y + 35 + ثم * 20
            اذا (ثم == إطار - 1)
                ارسم_مستطيل_أصلي(ف، sel_x + 10، thy، 430، 18، سم.لون_تمييز)
                ارسم_نص_أصلي(ف، sel_x + 20، thy + 2، ثيمات[ثم] + " [Active]"، 1، ل_أبيض)
            والا
                ارسم_نص_أصلي(ف، sel_x + 20، thy + 2، ثيمات[ثم]، 1، سم.لون_نص_ثانوي)
            نهاية
            ثم = ثم + 1
        نهاية

        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)
        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== BeeOS Theme Engine ===")

    متغير محرك = جديد محرك_سمات()

    # السمة 1: خلية داكنة
    متغير سمة_داكنة = جديد سمة("Dark Hive"، ل_أزرق_غ، ل_أسود، امزج_لون(ل_أسود، ل_أبيض، 10)، امزج_لون(ل_أسود، ل_رمادي_غ، 50)، ل_أبيض، ل_رمادي، لون_من_rgb(0، 150، 255)، ل_رمادي_غ، امزج_لون(ل_أسود، ل_أزرق_غ، 30)، ل_رمادي_غ)

    # السمة 2: نحلة فاتحة
    متغير سمة_فاتحة = جديد سمة("Light Bee"، لون_من_rgb(220، 220، 240)، لون_من_rgb(180، 200، 230)، لون_من_rgb(245، 245، 250)، لون_من_rgb(200، 200، 220)، لون_من_rgb(30، 30، 50)، لون_من_rgb(100، 100، 130)، لون_من_rgb(255، 180، 0)، لون_من_rgb(210، 210، 230)، لون_من_rgb(230، 230، 245)، لون_من_rgb(180، 180، 200))

    # السمة 3: محيط أزرق
    متغير سمة_محيط = جديد سمة("Ocean Blue"، لون_من_rgb(10، 20، 60)، لون_من_rgb(0، 10، 40)، لون_من_rgb(20، 40، 80)، لون_من_rgb(15، 30، 70)، لون_من_rgb(200، 220، 255)، لون_من_rgb(120، 150، 200)، لون_من_rgb(0، 180، 255)، لون_من_rgb(30، 60، 100)، لون_من_rgb(10، 25، 55)، لون_من_rgb(40، 80، 140))

    # السمة 4: غابة خضراء
    متغير سمة_غابة = جديد سمة("Forest Green"، لون_من_rgb(15، 30، 15)، لون_من_rgb(5، 20، 5)، لون_من_rgb(20، 40، 20)، لون_من_rgb(15، 35، 15)، لون_من_rgb(200، 255، 200)، لون_من_rgb(120، 180، 120)، لون_من_rgb(50، 220، 50)، لون_من_rgb(25، 50، 25)، لون_من_rgb(10، 28، 10)، لون_من_rgb(40، 100، 40))

    # السمة 5: غروب برتقالي
    متغير سمة_غروب = جديد سمة("Sunset Amber"، لون_من_rgb(50، 20، 10)، لون_من_rgb(30، 10، 5)، لون_من_rgb(60، 30، 20)، لون_من_rgb(80، 35، 15)، لون_من_rgb(255، 220، 180)، لون_من_rgb(200، 160، 120)، لون_من_rgb(255، 150، 0)، لون_من_rgb(70، 35، 15)، لون_من_rgb(45، 20، 8)، لون_من_rgb(120، 60، 20))

    محرك.إضافة_سمة(سمة_داكنة)
    محرك.إضافة_سمة(سمة_فاتحة)
    محرك.إضافة_سمة(سمة_محيط)
    محرك.إضافة_سمة(سمة_غابة)
    محرك.إضافة_سمة(سمة_غروب)

    اطبع_سطر("[THEME] 5 themes loaded")

    # إطار 1: Dark Hive
    اطبع_سطر("-- Frame 1: Dark Hive --")
    محرك.رسم(1، سمة_داكنة)
    محرك.تصدير("C:\\beeos_theme_dark.ppm")

    # إطار 2: Light Bee
    اطبع_سطر("-- Frame 2: Light Bee --")
    محرك.رسم(2، سمة_فاتحة)
    محرك.تصدير("C:\\beeos_theme_light.ppm")

    # إطار 3: Ocean Blue
    اطبع_سطر("-- Frame 3: Ocean Blue --")
    محرك.رسم(3، سمة_محيط)
    محرك.تصدير("C:\\beeos_theme_ocean.ppm")

    # إطار 4: Forest Green
    اطبع_سطر("-- Frame 4: Forest Green --")
    محرك.رسم(4، سمة_غابة)
    محرك.تصدير("C:\\beeos_theme_forest.ppm")

    # إطار 5: Sunset Amber
    اطبع_سطر("-- Frame 5: Sunset Amber --")
    محرك.رسم(5، سمة_غروب)
    محرك.تصدير("C:\\beeos_theme_sunset.ppm")

    متغير أسود = عد_بكسلات(محرك.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("=== Theme Engine: SUCCESS ===")
    ارجع 0
نهاية
