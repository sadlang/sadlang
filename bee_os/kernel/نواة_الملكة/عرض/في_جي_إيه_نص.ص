# في_جي_إيه_نص.ص - وضع النص VGA
# نظام خلية النحل - نواة الملكة / عرض
# التحكم في وضع النص 80×25 VGA
# ══════════════════════════════════════════════════════════════════════

صنف خلية_نص
    رقم الحرف
    رقم لون_الأمام
    رقم لون_الخلف

    باني(رقم رمز_الحرف، رقم أمامي، رقم خلفي)
        الحرف = رمز_الحرف
        لون_الأمام = أمامي
        لون_الخلف = خلفي
    نهاية

    دالة رقم اعط_الحرف()
        ارجع الحرف
    نهاية

    دالة رقم اعط_لون_الأمام()
        ارجع لون_الأمام
    نهاية

    دالة رقم اعط_لون_الخلف()
        ارجع لون_الخلف
    نهاية

    دالة رقم إلى_بايت_مزدوج()
        # VGA: بايت حرف + بايت سمة
        ارجع الحرف + (لون_الأمام + لون_الخلف * 16) * 256
    نهاية
نهاية

صنف شاشة_في_جي_إيه
    رقم الأعمدة
    رقم الأسطر
    رقم عنوان_الذاكرة
    رقم مؤشر_العمود
    رقم مؤشر_السطر
    رقم لون_افتراضي

    باني()
        الأعمدة = 80
        الأسطر = 25
        عنوان_الذاكرة = 753664
        مؤشر_العمود = 0
        مؤشر_السطر = 0
        لون_افتراضي = 7
    نهاية

    دالة رقم إزاحة_خلية(رقم عمود، رقم سطر)
        ارجع (سطر * الأعمدة + عمود) * 2
    نهاية

    دالة رقم اكتب_حرف(رقم عمود، رقم سطر، رقم الحرف، رقم اللون)
        اذا (عمود >= الأعمدة)
            ارجع 0
        نهاية
        اذا (سطر >= الأسطر)
            ارجع 0
        نهاية
        ارجع إزاحة_خلية(عمود، سطر)
    نهاية

    دالة رقم تقدم_المؤشر()
        مؤشر_العمود = مؤشر_العمود + 1
        اذا (مؤشر_العمود >= الأعمدة)
            مؤشر_العمود = 0
            مؤشر_السطر = مؤشر_السطر + 1
            اذا (مؤشر_السطر >= الأسطر)
                مؤشر_السطر = الأسطر - 1
                ارجع -1
            نهاية
        نهاية
        ارجع 1
    نهاية

    دالة رقم سطر_جديد()
        مؤشر_العمود = 0
        مؤشر_السطر = مؤشر_السطر + 1
        اذا (مؤشر_السطر >= الأسطر)
            مؤشر_السطر = الأسطر - 1
            ارجع -1
        نهاية
        ارجع 1
    نهاية

    دالة رقم امسح_الشاشة()
        مؤشر_العمود = 0
        مؤشر_السطر = 0
        ارجع الأعمدة * الأسطر
    نهاية

    دالة رقم اعط_العمود()
        ارجع مؤشر_العمود
    نهاية

    دالة رقم اعط_السطر()
        ارجع مؤشر_السطر
    نهاية
نهاية

صنف ألوان_في_جي_إيه
    رقم أسود
    رقم أزرق
    رقم أخضر
    رقم سماوي
    رقم أحمر_داكن
    رقم أبيض_ساطع

    باني()
        أسود = 0
        أزرق = 1
        أخضر = 2
        سماوي = 3
        أحمر_داكن = 4
        أبيض_ساطع = 15
    نهاية

    دالة رقم اعط_أزرق()
        ارجع أزرق
    نهاية

    دالة رقم اعط_أخضر()
        ارجع أخضر
    نهاية

    دالة رقم اعط_أبيض()
        ارجع أبيض_ساطع
    نهاية

    دالة رقم سمة_لون(رقم أمامي، رقم خلفي)
        ارجع أمامي + خلفي * 16
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير خلية = جديد خلية_نص(65، 7، 0)
    اطبع("  حرف A - بايت مزدوج: ")
    اطبع_سطر(خلية.إلى_بايت_مزدوج())

    متغير شاشة = جديد شاشة_في_جي_إيه()
    اطبع("  إزاحة (0,0): ")
    اطبع_سطر(شاشة.إزاحة_خلية(0، 0))
    اطبع("  إزاحة (40,12): ")
    اطبع_سطر(شاشة.إزاحة_خلية(40، 12))
    شاشة.تقدم_المؤشر()
    شاشة.تقدم_المؤشر()
    اطبع("  عمود المؤشر: ")
    اطبع_سطر(شاشة.اعط_العمود())
    اطبع("  مسح الشاشة: ")
    اطبع_سطر(شاشة.امسح_الشاشة())

    متغير ألوان = جديد ألوان_في_جي_إيه()
    اطبع("  سمة أبيض/أزرق: ")
    اطبع_سطر(ألوان.سمة_لون(15، 1))

    اطبع_سطر("  ✅ في_جي_إيه_نص يعمل")
    ارجع 0
نهاية
