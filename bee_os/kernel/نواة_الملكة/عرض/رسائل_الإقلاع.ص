# رسائل_الإقلاع.ص - عرض رسائل الإقلاع
# نظام خلية النحل - نواة الملكة / عرض
# عرض رسائل مراحل الإقلاع بالعربية
# ══════════════════════════════════════════════════════════════════════

صنف رسالة_إقلاع
    نص نص_الرسالة
    رقم مستوى_الأهمية
    رقم طابع_زمني

    باني(نص الرسالة، رقم المستوى، رقم الطابع)
        نص_الرسالة = الرسالة
        مستوى_الأهمية = المستوى
        طابع_زمني = الطابع
    نهاية

    دالة نص اعط_الرسالة()
        ارجع نص_الرسالة
    نهاية

    دالة رقم اعط_المستوى()
        ارجع مستوى_الأهمية
    نهاية

    دالة رقم اعط_الطابع()
        ارجع طابع_زمني
    نهاية

    دالة نص رمز_المستوى()
        اذا (مستوى_الأهمية == 0)
            ارجع "🟢"
        نهاية
        اذا (مستوى_الأهمية == 1)
            ارجع "🟡"
        نهاية
        ارجع "🔴"
    نهاية
نهاية

صنف دفتر_إقلاع
    رقم عدد_الرسائل
    رقم أقصى_رسائل
    رقم عدد_أخطاء
    رقم عدد_تحذيرات

    باني()
        عدد_الرسائل = 0
        أقصى_رسائل = 256
        عدد_أخطاء = 0
        عدد_تحذيرات = 0
    نهاية

    دالة رقم أضف_رسالة(رقم المستوى)
        اذا (عدد_الرسائل >= أقصى_رسائل)
            ارجع 0
        نهاية
        عدد_الرسائل = عدد_الرسائل + 1
        اذا (المستوى == 2)
            عدد_أخطاء = عدد_أخطاء + 1
        نهاية
        اذا (المستوى == 1)
            عدد_تحذيرات = عدد_تحذيرات + 1
        نهاية
        ارجع عدد_الرسائل
    نهاية

    دالة رقم اعط_العدد()
        ارجع عدد_الرسائل
    نهاية

    دالة رقم اعط_عدد_الأخطاء()
        ارجع عدد_أخطاء
    نهاية

    دالة رقم اعط_عدد_التحذيرات()
        ارجع عدد_تحذيرات
    نهاية

    دالة رقم هل_إقلاع_نظيف()
        اذا (عدد_أخطاء == 0)
            ارجع 1
        نهاية
        ارجع 0
    نهاية
نهاية

صنف عارض_رسائل
    رقم سطر_حالي
    رقم أقصى_أسطر
    رقم موضع_س
    رقم لون_عادي
    رقم لون_تحذير
    رقم لون_خطير

    باني(رقم أسطر_الشاشة)
        سطر_حالي = 0
        أقصى_أسطر = أسطر_الشاشة
        موضع_س = 620
        لون_عادي = 11184810
        لون_تحذير = 16776960
        لون_خطير = 16711680
    نهاية

    دالة رقم اعرض_رسالة(رقم المستوى)
        اذا (سطر_حالي >= أقصى_أسطر)
            # تمرير: العودة للأعلى
            سطر_حالي = 0
        نهاية
        سطر_حالي = سطر_حالي + 1
        اذا (المستوى == 0)
            ارجع لون_عادي
        نهاية
        اذا (المستوى == 1)
            ارجع لون_تحذير
        نهاية
        ارجع لون_خطير
    نهاية

    دالة رقم اعط_السطر_الحالي()
        ارجع سطر_حالي
    نهاية

    دالة رقم اعط_موضع_س()
        ارجع موضع_س
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير رسالة = جديد رسالة_إقلاع("تهيئة الذاكرة"، 0، 1000)
    اطبع("  الرسالة: ")
    اطبع_سطر(رسالة.اعط_الرسالة())
    اطبع("  الرمز: ")
    اطبع_سطر(رسالة.رمز_المستوى())

    متغير دفتر = جديد دفتر_إقلاع()
    دفتر.أضف_رسالة(0)
    دفتر.أضف_رسالة(0)
    دفتر.أضف_رسالة(1)
    دفتر.أضف_رسالة(0)
    اطبع("  عدد الرسائل: ")
    اطبع_سطر(دفتر.اعط_العدد())
    اطبع("  تحذيرات: ")
    اطبع_سطر(دفتر.اعط_عدد_التحذيرات())
    اطبع("  إقلاع نظيف: ")
    اطبع_سطر(دفتر.هل_إقلاع_نظيف())

    متغير عارض = جديد عارض_رسائل(30)
    عارض.اعرض_رسالة(0)
    عارض.اعرض_رسالة(1)
    اطبع("  السطر الحالي: ")
    اطبع_سطر(عارض.اعط_السطر_الحالي())

    اطبع_سطر("  ✅ رسائل_الإقلاع يعمل")
    ارجع 0
نهاية
