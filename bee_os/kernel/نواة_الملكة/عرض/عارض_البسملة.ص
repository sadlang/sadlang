    اطبع("  موضع البسملة ص: ")
    اطبع_سطر(عارض.اعط_موضع_ص())
    اطبع("  نص البسملة: ")
    اطبع_سطر(عارض.اعط_النص())
    اطبع("  عرض النص: ")
    اطبع_سطر(عارض.احسب_عرض_النص(10، 22))

    متغير تأثير = جديد تأثير_ظهور(2000، 30)
