# عارض_البسملة.ص - عرض البسملة
# نظام خلية النحل - نواة الملكة / عرض
# عرض "بسم الله الرحمن الرحيم" عند الإقلاع
# ══════════════════════════════════════════════════════════════════════

صنف حرف_بسملة
    رقم رمز_يونيكود
    رقم عرض_الحرف
    رقم ارتفاع_الحرف
    رقم إزاحة_س

    باني(رقم الرمز، رقم العرض، رقم الارتفاع، رقم الإزاحة)
        رمز_يونيكود = الرمز
        عرض_الحرف = العرض
        ارتفاع_الحرف = الارتفاع
        إزاحة_س = الإزاحة
    نهاية

    دالة رقم اعط_الرمز()
        ارجع رمز_يونيكود
    نهاية

    دالة رقم اعط_العرض()
        ارجع عرض_الحرف
    نهاية

    دالة رقم اعط_الإزاحة()
        ارجع إزاحة_س
    نهاية
نهاية

صنف عارض_بسملة
    رقم موضع_س
    رقم موضع_ص
    رقم لون_النص
    رقم مقياس_الخط
    نص نص_البسملة

    باني(رقم عرض_الشاشة، رقم ارتفاع_الشاشة)
        # توسيط البسملة في الشاشة
        موضع_س = عرض_الشاشة / 2
        موضع_ص = ارتفاع_الشاشة / 3
        لون_النص = 16768256
        مقياس_الخط = 2
        نص_البسملة = "بسم الله الرحمن الرحيم"
    نهاية

    دالة رقم اعط_موضع_س()
        ارجع موضع_س
    نهاية

    دالة رقم اعط_موضع_ص()
        ارجع موضع_ص
    نهاية

    دالة نص اعط_النص()
        ارجع نص_البسملة
    نهاية

    دالة رقم احسب_عرض_النص(رقم عرض_حرف_واحد، رقم عدد_الحروف)
        ارجع عرض_حرف_واحد * عدد_الحروف * مقياس_الخط
    نهاية

    دالة رقم اعط_اللون()
        ارجع لون_النص
    نهاية
نهاية

صنف تأثير_ظهور
    رقم المدة_الكلية
    رقم الخطوة_الحالية
    رقم أقصى_خطوات
    رقم شفافية_حالية

    باني(رقم المدة، رقم عدد_الخطوات)
        المدة_الكلية = المدة
        الخطوة_الحالية = 0
        أقصى_خطوات = عدد_الخطوات
        شفافية_حالية = 0
    نهاية

    دالة رقم تقدم()
        اذا (الخطوة_الحالية >= أقصى_خطوات)
            ارجع 255
        نهاية
        الخطوة_الحالية = الخطوة_الحالية + 1
        شفافية_حالية = (الخطوة_الحالية * 255) / أقصى_خطوات
        ارجع شفافية_حالية
    نهاية

    دالة رقم اكتمل()
        اذا (الخطوة_الحالية >= أقصى_خطوات)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم اعط_الشفافية()
        ارجع شفافية_حالية
    نهاية

    دالة رقم أعد_البداية()
        الخطوة_الحالية = 0
        شفافية_حالية = 0
        ارجع 0
    نهاية
نهاية

