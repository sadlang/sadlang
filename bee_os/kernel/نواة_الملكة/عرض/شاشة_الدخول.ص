# ══════════════════════════════════════════════════════════════════════════════
# شاشة_الدخول.ص - شاشة تسجيل الدخول لنظام خلية النحل
# BeeOS Login Screen - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

# ألوان
متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536

# حالة الدخول
متغير دخول_انتظار  = 0
متغير دخول_كتابة   = 1
متغير دخول_تحقق    = 2
متغير دخول_ناجح     = 3
متغير دخول_فاشل     = 4

# ──────────────────────────────────────────────────────────────────
# صنف شاشة تسجيل الدخول
# ──────────────────────────────────────────────────────────────────
صنف شاشة_دخول
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    نص اسم_المستخدم
    نص كلمة_المرور
    رقم وضع_دخول
    رقم محاولات
    نص رسالة_خطأ
    رقم مؤشر_حقل

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.اسم_المستخدم = ""
        هذا.كلمة_المرور = ""
        هذا.وضع_دخول = دخول_انتظار
        هذا.محاولات = 0
        هذا.رسالة_خطأ = ""
        هذا.مؤشر_حقل = 0
    نهاية

    # رسم الخلفية
    دالة رسم_خلفية()
        متغير ف = هذا.مقبض_خلفي

        # تدرج خلفية من أزرق غامق لأسود
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)

        # نمط خلايا نحل خافتة
        متغير hx = 100
        بينما (hx < عرض_شاشة)
            متغير hy = 100
            بينما (hy < ارت_شاشة)
                متغير لون_خلية = امزج_لون(ل_أصفر، ل_أسود، 8)
                ارسم_دائرة_أصلي(ف، hx، hy، 30، لون_خلية)
                hy = hy + 130
            نهاية
            hx = hx + 150
        نهاية

        ارجع 1
    نهاية

    # رسم صورة المستخدم (دائرة + أيقونة)
    دالة رسم_صورة_مستخدم(ف، cx، cy)
        # دائرة خلفية
        ارسم_دائرة_مصمتة(ف، cx، cy، 50، ل_رمادي_غ)
        ارسم_دائرة_أصلي(ف، cx، cy، 50، ل_أصفر)
        ارسم_دائرة_أصلي(ف، cx، cy، 51، ل_أصفر)

        # رأس الشخص (دائرة صغيرة)
        ارسم_دائرة_مصمتة(ف، cx، cy - 15، 15، ل_أبيض)

        # جسم (نصف دائرة مبسط)
        ارسم_دائرة_مصمتة(ف، cx، cy + 25، 25، ل_أبيض)
        # مسح الجزء السفلي
        ارسم_مستطيل_أصلي(ف، cx - 30، cy + 25، 60، 30، ل_رمادي_غ)

        ارجع 1
    نهاية

    # رسم حقل إدخال
    دالة رسم_حقل(ف، x، y، عرض_حقل، ارتفاع_حقل، نص_تسمية، قيمة، مركز، سري)
        # التسمية فوق الحقل
        ارسم_نص_أصلي(ف، x، y - 18، نص_تسمية، 1، ل_رمادي)

        # الحقل
        اذا (مركز)
            ارسم_مستطيل_أصلي(ف، x، y، عرض_حقل، ارتفاع_حقل، ل_أسود)
            ارسم_إطار_أصلي(ف، x، y، عرض_حقل، ارتفاع_حقل، 2، ل_أصفر)
        والا
            ارسم_مستطيل_أصلي(ف، x، y، عرض_حقل، ارتفاع_حقل، ل_أسود)
            ارسم_إطار_أصلي(ف، x، y، عرض_حقل، ارتفاع_حقل، 1، ل_رمادي)
        نهاية

        # النص داخل الحقل
        اذا (طول(قيمة) > 0)
            اذا (سري)
                # عرض نجوم بدل النص
                متغير نجوم = ""
                متغير ن = 0
                بينما (ن < طول(قيمة))
                    نجوم = نجوم + "*"
                    ن = ن + 1
                نهاية
                ارسم_نص_أصلي(ف، x + 10، y + 9، نجوم، 2، ل_أبيض)
            والا
                ارسم_نص_أصلي(ف، x + 10، y + 9، قيمة، 2، ل_أبيض)
            نهاية
        والا
            اذا (سري)
                ارسم_نص_أصلي(ف، x + 10، y + 12، "Password"، 1، ل_رمادي_غ)
            والا
                ارسم_نص_أصلي(ف، x + 10، y + 12، "Username"، 1، ل_رمادي_غ)
            نهاية
        نهاية

        # مؤشر نص وامض إذا مركز
        اذا (مركز)
            متغير نص_عرض = طول(قيمة) * 12
            اذا (سري)
                نص_عرض = طول(قيمة) * 12
            نهاية
            ارسم_مستطيل_أصلي(ف، x + 10 + نص_عرض، y + 8، 2، 18، ل_أصفر)
        نهاية

        ارجع 1
    نهاية

    # رسم شاشة الدخول كاملة
    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        هذا.رسم_خلفية()

        # مركز الشاشة
        متغير cx = عرض_شاشة / 2
        متغير cy = ارت_شاشة / 2

        # بطاقة تسجيل الدخول (مستطيل شبه شفاف)
        متغير بطاقة_ع = 400
        متغير بطاقة_ا = 450
        متغير بطاقة_x = cx - بطاقة_ع / 2
        متغير بطاقة_y = cy - بطاقة_ا / 2

        # خلفية البطاقة
        متغير لون_بطاقة = امزج_لون(ل_أسود، ل_أزرق_غ، 40)
        ارسم_مستطيل_أصلي(ف، بطاقة_x، بطاقة_y، بطاقة_ع، بطاقة_ا، لون_بطاقة)
        ارسم_إطار_أصلي(ف، بطاقة_x، بطاقة_y، بطاقة_ع، بطاقة_ا، 2، ل_أصفر)

        # صورة المستخدم
        هذا.رسم_صورة_مستخدم(ف، cx، بطاقة_y + 70)

        # اسم المستخدم تحت الصورة
        اذا (طول(هذا.اسم_المستخدم) > 0)
            ارسم_نص_أصلي(ف، cx - 30، بطاقة_y + 135، هذا.اسم_المستخدم، 2، ل_أبيض)
        والا
            ارسم_نص_أصلي(ف، cx - 20، بطاقة_y + 135، "User"، 2، ل_رمادي)
        نهاية

        # حقول الإدخال
        متغير حقل_x = بطاقة_x + 40
        متغير حقل_ع = بطاقة_ع - 80

        # حقل اسم المستخدم
        هذا.رسم_حقل(ف، حقل_x، بطاقة_y + 180، حقل_ع، 35، "Username"، هذا.اسم_المستخدم، هذا.مؤشر_حقل == 0، خطأ)

        # حقل كلمة المرور
        هذا.رسم_حقل(ف، حقل_x، بطاقة_y + 250، حقل_ع، 35، "Password"، هذا.كلمة_المرور، هذا.مؤشر_حقل == 1، صحيح)

        # زر تسجيل الدخول
        متغير زر_ع = 200
        متغير زر_x = cx - زر_ع / 2
        متغير زر_y = بطاقة_y + 320

        اذا (هذا.وضع_دخول == دخول_ناجح)
            ارسم_مستطيل_أصلي(ف، زر_x، زر_y، زر_ع، 40، ل_أخضر)
            ارسم_نص_أصلي(ف، زر_x + 50، زر_y + 12، "Welcome!"، 2، ل_أبيض)
        والا
            اذا (هذا.وضع_دخول == دخول_فاشل)
                ارسم_مستطيل_أصلي(ف، زر_x، زر_y، زر_ع، 40، ل_أحمر)
                ارسم_نص_أصلي(ف، زر_x + 40، زر_y + 12، "Try Again"، 2، ل_أبيض)
            والا
                ارسم_مستطيل_أصلي(ف، زر_x، زر_y، زر_ع، 40، ل_أصفر)
                ارسم_نص_أصلي(ف، زر_x + 50، زر_y + 12، "Sign In"، 2، ل_أسود)
            نهاية
        نهاية

        # رسالة خطأ
        اذا (طول(هذا.رسالة_خطأ) > 0)
            ارسم_نص_أصلي(ف، حقل_x، بطاقة_y + 380، هذا.رسالة_خطأ، 1، ل_أحمر)
        نهاية

        # عدد المحاولات
        اذا (هذا.محاولات > 0)
            ارسم_نص_أصلي(ف، حقل_x، بطاقة_y + 400، "Attempts: " + هذا.محاولات، 1، ل_رمادي_غ)
        نهاية

        # معلومات النظام أسفل الشاشة
        ارسم_نص_أصلي(ف، 20، ارت_شاشة - 30، "BeeOS v1.0 Honeycomb"، 1، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، عرض_شاشة - 180، ارت_شاشة - 30، "Press Enter to login"، 1، ل_رمادي_غ)

        # خيارات الطاقة (أسفل يمين)
        ارسم_مستطيل_أصلي(ف، عرض_شاشة - 120، ارت_شاشة - 55، 30، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، عرض_شاشة - 115، ارت_شاشة - 50، "O"، 1، ل_أبيض)

        ارسم_مستطيل_أصلي(ف، عرض_شاشة - 80، ارت_شاشة - 55، 30، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، عرض_شاشة - 75، ارت_شاشة - 50، "R"، 1، ل_أبيض)

        # swap
        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)

        ارجع 1
    نهاية

    # محاكاة كتابة اسم مستخدم
    دالة كتابة_مستخدم(نص_جديد)
        هذا.اسم_المستخدم = نص_جديد
        هذا.مؤشر_حقل = 0
    نهاية

    # محاكاة كتابة كلمة مرور
    دالة كتابة_كلمة_مرور(نص_جديد)
        هذا.كلمة_المرور = نص_جديد
        هذا.مؤشر_حقل = 1
    نهاية

    # التحقق من بيانات الدخول
    دالة تحقق()
        هذا.محاولات = هذا.محاولات + 1
        اذا (هذا.اسم_المستخدم == "admin" && هذا.كلمة_المرور == "beeos")
            هذا.وضع_دخول = دخول_ناجح
            هذا.رسالة_خطأ = ""
            ارجع صحيح
        والا
            هذا.وضع_دخول = دخول_فاشل
            هذا.رسالة_خطأ = "Invalid username or password"
            ارجع خطأ
        نهاية
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS Login Screen ===")
    اطبع_سطر("")

    متغير شاشة = جديد شاشة_دخول()
    اطبع_سطر("[LOGIN] Screen initialized")

    # إطار 1: شاشة فارغة (انتظار)
    اطبع_سطر("")
    اطبع_سطر("-- Frame 1: Empty login --")
    شاشة.رسم(1)
    شاشة.تصدير("C:\\beeos_login1.ppm")
    اطبع_سطر("  Exported login screen (empty)")

    # إطار 2: كتابة اسم المستخدم
    اطبع_سطر("")
    اطبع_سطر("-- Frame 2: Typing username --")
    شاشة.كتابة_مستخدم("admin")
    شاشة.رسم(2)
    اطبع_سطر("  Username: admin")

    # إطار 3: كتابة كلمة المرور
    اطبع_سطر("")
    اطبع_سطر("-- Frame 3: Typing password --")
    شاشة.كتابة_كلمة_مرور("beeos")
    شاشة.رسم(3)
    اطبع_سطر("  Password: *****")

    # إطار 4: محاولة دخول فاشلة
    اطبع_سطر("")
    اطبع_سطر("-- Frame 4: Failed login attempt --")
    شاشة.كتابة_كلمة_مرور("wrong")
    متغير نتيجة1 = شاشة.تحقق()
    شاشة.رسم(4)
    اطبع("  Login result: ")
    اطبع_سطر(نتيجة1)
    اطبع("  Error: ")
    اطبع_سطر(شاشة.رسالة_خطأ)
    شاشة.تصدير("C:\\beeos_login_fail.ppm")
    اطبع_سطر("  Exported failed login screen")

    # إطار 5: محاولة ناجحة
    اطبع_سطر("")
    اطبع_سطر("-- Frame 5: Successful login --")
    شاشة.كتابة_كلمة_مرور("beeos")
    متغير نتيجة2 = شاشة.تحقق()
    شاشة.رسم(5)
    اطبع("  Login result: ")
    اطبع_سطر(نتيجة2)
    شاشة.تصدير("C:\\beeos_login_ok.ppm")
    اطبع_سطر("  Exported successful login screen")

    # تحقق بكسلات
    اطبع_سطر("")
    متغير أسود = عد_بكسلات(شاشة.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("  Total screen pixels: ")
    اطبع_سطر(إجمالي)
    اطبع("  Black pixels: ")
    اطبع_سطر(أسود)
    اطبع("  Non-black pixels: ")
    اطبع_سطر(إجمالي - أسود)
    اطبع("  Attempts: ")
    اطبع_سطر(شاشة.محاولات)

    اطبع_سطر("")
    اطبع_سطر("=== Login Screen: SUCCESS ===")

    ارجع 0
نهاية
