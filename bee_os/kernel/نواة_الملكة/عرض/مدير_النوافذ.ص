# ثوابت مدير النوافذ
متغير ارتفاع_شريط_العنوان  = 36
متغير عرض_زر_تحكم         = 44
متغير سماكة_الحدود         = 2
متغير عمق_شريط_المهام      = 52

# أنواع النوافذ
متغير نوع_عادية            = 0
متغير نوع_مشروطة           = 1
متغير نوع_كاملة            = 3

# حالات النافذة
متغير حالة_عادية           = 0
متغير حالة_مصغرة           = 1
متغير حالة_مكبرة           = 2

# ألوان النظام
متغير لون_شريط_فعال        = 4283522355
متغير لون_شريط_خامل        = 4283782197
متغير لون_زر_اغلاق         = 4293645816
متغير لون_زر_تكبير         = 4284771627
متغير لون_زر_تصغير         = 4292748544
متغير لون_جسم_النافذة       = 4278782242
متغير لون_شريط_مهام        = 4279044118

# ─────────────────────────────────────────────────────────────────────────────
# صنف زر_التحكم
# ─────────────────────────────────────────────────────────────────────────────
صنف زر_التحكم
    ## زر في شريط عنوان النافذة (إغلاق / تكبير / تصغير)
    رقم س
    رقم ص
    رقم العرض
    رقم الارتفاع
    رقم النوع
    رقم لون_عادي

    باني(رقم س0، رقم ص0، رقم نوع0، رقم لون0)
        س = س0
        ص = ص0
        العرض = عرض_زر_تحكم
        الارتفاع = ارتفاع_شريط_العنوان - 8
        النوع = نوع0
        لون_عادي = لون0
    نهاية

    دالة منطقي يحتوي_نقطة(رقم س_ن، رقم ص_ن)
        متغير داخل = صحيح
        اذا (س_ن < س)
            داخل = خطأ
        نهاية
        اذا (س_ن >= س + العرض)
            داخل = خطأ
        نهاية
        اذا (ص_ن < ص)
            داخل = خطأ
        نهاية
        اذا (ص_ن >= ص + الارتفاع)
            داخل = خطأ
        نهاية
        ارجع داخل
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف نافذة
# ─────────────────────────────────────────────────────────────────────────────
صنف نافذة
    ##
    ## يمثل نافذة كاملة في نظام النحلة
    ## مع شريط عنوان وأزرار تحكم ودعم التكبير والسحب
    ##
    رقم المعرف
    نص العنوان
    رقم س
    رقم ص
    رقم العرض
    رقم الارتفاع
    رقم س_مسبق
    رقم ص_مسبق
    رقم عرض_مسبق
    رقم ارتفاع_مسبق
    رقم الحالة
    رقم النوع
    منطقي نشطة
    منطقي تُسحب
    رقم لون_خلفية
    مصفوفة أزرار_التحكم
    رقم الترتيب_العمقي

    باني(رقم معرف0، نص عنوان0، رقم س0، رقم ص0، رقم عرض0، رقم ارتفاع0)
        المعرف = معرف0
        العنوان = عنوان0
        س = س0
        ص = ص0
        العرض = عرض0
        الارتفاع = ارتفاع0
        س_مسبق = س0
        ص_مسبق = ص0
        عرض_مسبق = عرض0
        ارتفاع_مسبق = ارتفاع0
        الحالة = حالة_عادية
        النوع = نوع_عادية
        نشطة = خطأ
        تُسحب = خطأ
        لون_خلفية = لون_جسم_النافذة
        الترتيب_العمقي = 0

        ## تهيئة أزرار التحكم
        متغير س_إغلاق = عرض0 - (عرض_زر_تحكم + 4)
        متغير س_تكبير = عرض0 - (2 * عرض_زر_تحكم + 8)
        متغير س_تصغير = عرض0 - (3 * عرض_زر_تحكم + 12)
        أزرار_التحكم = [
            جديد زر_التحكم(س_إغلاق، 4، 0، لون_زر_اغلاق)،
            جديد زر_التحكم(س_تكبير، 4، 1، لون_زر_تكبير)،
            جديد زر_التحكم(س_تصغير، 4، 2، لون_زر_تصغير)
        ]
    نهاية

    دالة تحديث_أزرار()
        ## تحديث موقع الأزرار بعد تغيير حجم النافذة
        ## ملاحظة: يحتاج دعم تعديل عناصر مصفوفة الكائنات
        متغير عرض_حالي = العرض
        متغير س_جديد = عرض_حالي - (عرض_زر_تحكم + 4)
        ## حفظ الموضع للاستخدام المستقبلي
    نهاية

    دالة رقم عرض_المحتوى()
        ارجع العرض - (2 * سماكة_الحدود)
    نهاية

    دالة رقم ارتفاع_المحتوى()
        ارجع الارتفاع - ارتفاع_شريط_العنوان - سماكة_الحدود
    نهاية

    دالة منطقي يحتوي_نقطة(رقم س_ن، رقم ص_ن)
        متغير نتيجة = صحيح
        اذا (س_ن < س)
            نتيجة = خطأ
        نهاية
        اذا (س_ن >= س + العرض)
            نتيجة = خطأ
        نهاية
        اذا (ص_ن < ص)
            نتيجة = خطأ
        نهاية
        اذا (ص_ن >= ص + الارتفاع)
            نتيجة = خطأ
        نهاية
        ارجع نتيجة
    نهاية

    دالة منطقي نقطة_في_شريط_العنوان(رقم س_ن، رقم ص_ن)
        متغير نتيجة = صحيح
        اذا (س_ن < س)
            نتيجة = خطأ
        نهاية
        اذا (س_ن >= س + العرض)
            نتيجة = خطأ
        نهاية
        اذا (ص_ن < ص)
            نتيجة = خطأ
        نهاية
        اذا (ص_ن >= ص + ارتفاع_شريط_العنوان)
            نتيجة = خطأ
        نهاية
        ارجع نتيجة
    نهاية

    دالة تبديل_التكبير(رقم عرض_شاشة، رقم ارتفاع_شاشة)
        اذا (الحالة == حالة_مكبرة)
            س = س_مسبق
            ص = ص_مسبق
            العرض = عرض_مسبق
            الارتفاع = ارتفاع_مسبق
            الحالة = حالة_عادية
        والا
            س_مسبق = س
            ص_مسبق = ص
            عرض_مسبق = العرض
            ارتفاع_مسبق = الارتفاع
            س = 0
            ص = 0
            العرض = عرض_شاشة
            الارتفاع = ارتفاع_شاشة - عمق_شريط_المهام
            الحالة = حالة_مكبرة
        نهاية
    نهاية

    دالة ارسم()
        اذا (الحالة == حالة_مصغرة)
            ارجع 0
        نهاية
        اطبع("  🪟 [")
        اطبع(المعرف)
        اطبع("] ")
        اطبع(العنوان)
        اطبع("  📍(")
        اطبع(س)
        اطبع(",")
        اطبع(ص)
        اطبع(") 📐")
        اطبع(العرض)
        اطبع("×")
        اطبع(الارتفاع)
        اذا (نشطة)
            اطبع("  ★ نشطة")
        نهاية
        اذا (الحالة == حالة_مكبرة)
            اطبع("  🔲 مكبرة")
        نهاية
        اطبع_سطر("")
        ارجع 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف عنصر_شريط_المهام
# ─────────────────────────────────────────────────────────────────────────────
صنف عنصر_شريط_المهام
    ## أيقونة تطبيق في شريط المهام
    نص الاسم
    رقم معرف_النافذة
    منطقي نشط

    باني(نص اسم0، رقم معرف0)
        الاسم = اسم0
        معرف_النافذة = معرف0
        نشط = خطأ
    نهاية

    دالة اطبع_معلومات()
        اطبع(" [")
        اطبع(الاسم)
        اذا (نشط)
            اطبع("●")
        نهاية
        اطبع("]")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف شريط_المهام
# ─────────────────────────────────────────────────────────────────────────────
صنف شريط_المهام
    ##
    ## شريط المهام السفلي: زر القائمة + تطبيقات + إشعارات
    ##
    رقم العرض
    رقم ص_الشريط
    مصفوفة عناصر

    باني(رقم عرض_شاشة، رقم ارتفاع_شاشة)
        العرض = عرض_شاشة
        ص_الشريط = ارتفاع_شاشة - عمق_شريط_المهام
        عناصر = []
    نهاية

    دالة اضف_تطبيق(نص اسم، رقم معرف)
        عناصر += [جديد عنصر_شريط_المهام(اسم، معرف)]
    نهاية

    دالة تحديث_النشط(رقم معرف_نشط)
        لكل عنصر في عناصر
            اذا (عنصر.معرف_النافذة == معرف_نشط)
                عنصر.نشط = صحيح
            والا
                عنصر.نشط = خطأ
            نهاية
        نهاية
    نهاية

    دالة ارسم()
        اطبع_سطر("  ══════════════════════════════════════════════════════")
        اطبع("  🐝 القائمة |")
        لكل عنصر في عناصر
            عنصر.اطبع_معلومات()
        نهاية
        اطبع_سطر(" | 🔊 📶 🔋  10:30 ص")
        اطبع_سطر("  ══════════════════════════════════════════════════════")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الصنف الرئيسي: مدير_النوافذ
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_النوافذ
    ##
    ## مدير النوافذ الكامل لسطح مكتب نظام النحلة.
    ## يدير دورة حياة النوافذ، الأحداث، وترتيب الرسم.
    ##
    مصفوفة النوافذ
    رقم نافذة_نشطة_معرف
    رقم عداد_المعرفات
    رقم عرض_الشاشة
    رقم ارتفاع_الشاشة
    رقم مؤشر_س
    رقم مؤشر_ص
    منطقي الفأرة_مضغوطة
    رقم نافذة_مسحوبة_معرف
    رقم سحب_إزاحة_س
    رقم سحب_إزاحة_ص

    باني(رقم عرض0، رقم ارتفاع0)
        النوافذ = []
        نافذة_نشطة_معرف = -1
        عداد_المعرفات = 1
        عرض_الشاشة = عرض0
        ارتفاع_الشاشة = ارتفاع0
        مؤشر_س = عرض0 / 2
        مؤشر_ص = ارتفاع0 / 2
        الفأرة_مضغوطة = خطأ
        نافذة_مسحوبة_معرف = -1
        سحب_إزاحة_س = 0
        سحب_إزاحة_ص = 0
    نهاية

    دالة رقم إنشاء_نافذة(نص عنوان، رقم س، رقم ص، رقم عرض، رقم ارتفاع)
        متغير معرف = عداد_المعرفات
        عداد_المعرفات = عداد_المعرفات + 1
        متغير نافذة_جديدة = جديد نافذة(معرف، عنوان، س، ص، عرض، ارتفاع)
        نافذة_جديدة.الترتيب_العمقي = عداد_المعرفات
        النوافذ += [نافذة_جديدة]
        تفعيل_نافذة(معرف)
        اطبع("  ┌── نافذة جديدة: «")
        اطبع(عنوان)
        اطبع("»  معرف=")
        اطبع_سطر(معرف)
        ارجع معرف
    نهاية

    دالة اغلاق_نافذة(رقم معرف)
        متغير بقية = []
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.المعرف != معرف)
                بقية += [نافذة_م]
            نهاية
        نهاية
        النوافذ = بقية
        اذا (نافذة_نشطة_معرف == معرف)
            نافذة_نشطة_معرف = -1
            اذا (النوافذ.عدد_العناصر > 0)
                تفعيل_نافذة(النوافذ[0].المعرف)
            نهاية
        نهاية
        اطبع("  └── إغلاق نافذة معرف=")
        اطبع_سطر(معرف)
    نهاية

    دالة تفعيل_نافذة(رقم معرف)
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.المعرف == معرف)
                نافذة_م.نشطة = صحيح
                نافذة_م.الترتيب_العمقي = عداد_المعرفات + 1000
            والا
                نافذة_م.نشطة = خطأ
            نهاية
        نهاية
        نافذة_نشطة_معرف = معرف
    نهاية

    دالة نقل_نافذة(رقم معرف، رقم س_جديد، رقم ص_جديد)
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.المعرف == معرف)
                اذا (س_جديد < 0)
                    س_جديد = 0
                نهاية
                اذا (ص_جديد < 0)
                    ص_جديد = 0
                نهاية
                اذا (س_جديد > عرض_الشاشة - 100)
                    س_جديد = عرض_الشاشة - 100
                نهاية
                اذا (ص_جديد > ارتفاع_الشاشة - 50)
                    ص_جديد = ارتفاع_الشاشة - 50
                نهاية
                نافذة_م.س = س_جديد
                نافذة_م.ص = ص_جديد
            نهاية
        نهاية
    نهاية

    دالة تغيير_حجم_نافذة(رقم معرف، رقم عرض_جديد، رقم ارتفاع_جديد)
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.المعرف == معرف)
                اذا (عرض_جديد < 300)
                    عرض_جديد = 300
                نهاية
                اذا (ارتفاع_جديد < 200)
                    ارتفاع_جديد = 200
                نهاية
                نافذة_م.العرض = عرض_جديد
                نافذة_م.الارتفاع = ارتفاع_جديد
            نهاية
        نهاية
    نهاية

    دالة تكبير_نافذة(رقم معرف)
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.المعرف == معرف)
                نافذة_م.تبديل_التكبير(عرض_الشاشة، ارتفاع_الشاشة)
            نهاية
        نهاية
    نهاية

    دالة تصغير_نافذة(رقم معرف)
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.المعرف == معرف)
                نافذة_م.الحالة = حالة_مصغرة
                نافذة_م.نشطة = خطأ
            نهاية
        نهاية
        ## تفعيل نافذة أخرى مرئية
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.المعرف != معرف && نافذة_م.الحالة != حالة_مصغرة)
                تفعيل_نافذة(نافذة_م.المعرف)
            نهاية
        نهاية
    نهاية

    دالة استعادة_نافذة(رقم معرف)
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.المعرف == معرف)
                نافذة_م.الحالة = حالة_عادية
            نهاية
        نهاية
        تفعيل_نافذة(معرف)
    نهاية

    دالة معالجة_ضغط_فأرة(رقم سم، رقم صم)
        الفأرة_مضغوطة = صحيح
        مؤشر_س = سم
        مؤشر_ص = صم
        ## البحث عن أعلى نافذة عند النقطة
        متغير هدف_معرف = -1
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.الحالة != حالة_مصغرة)
                اذا (نافذة_م.يحتوي_نقطة(سم، صم))
                    هدف_معرف = نافذة_م.المعرف
                نهاية
            نهاية
        نهاية
        اذا (هدف_معرف != -1)
            تفعيل_نافذة(هدف_معرف)
            لكل نافذة_م في النوافذ
                اذا (نافذة_م.المعرف == هدف_معرف)
                    اذا (نافذة_م.نقطة_في_شريط_العنوان(سم، صم))
                        نافذة_م.تُسحب = صحيح
                        نافذة_مسحوبة_معرف = هدف_معرف
                        سحب_إزاحة_س = سم - نافذة_م.س
                        سحب_إزاحة_ص = صم - نافذة_م.ص
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية

    دالة معالجة_حركة_فأرة(رقم سم_جديد، رقم صم_جديد)
        مؤشر_س = سم_جديد
        مؤشر_ص = صم_جديد
        اذا (الفأرة_مضغوطة && نافذة_مسحوبة_معرف != -1)
            متغير نس = سم_جديد - سحب_إزاحة_س
            متغير نص_ = صم_جديد - سحب_إزاحة_ص
            نقل_نافذة(نافذة_مسحوبة_معرف، نس، نص_)
        نهاية
    نهاية

    دالة معالجة_رفع_فأرة(رقم سم، رقم صم)
        الفأرة_مضغوطة = خطأ
        نافذة_مسحوبة_معرف = -1
        لكل نافذة_م في النوافذ
            نافذة_م.تُسحب = خطأ
        نهاية
    نهاية

    دالة ارسم_كل_النوافذ()
        ## أولاً: النوافذ غير النشطة
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.الحالة != حالة_مصغرة)
                اذا (نافذة_م.نشطة == خطأ)
                    نافذة_م.ارسم()
                نهاية
            نهاية
        نهاية
        ## ثانياً: النافذة النشطة (في الأمام)
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.الحالة != حالة_مصغرة)
                اذا (نافذة_م.نشطة == صحيح)
                    نافذة_م.ارسم()
                نهاية
            نهاية
        نهاية
    نهاية

    دالة طباعة_الحالة()
        اطبع("  📊 مدير النوافذ | النافذة النشطة: ")
        اطبع_سطر(نافذة_نشطة_معرف)
        اطبع("  🖱️  المؤشر: (")
        اطبع(مؤشر_س)
        اطبع(", ")
        اطبع(مؤشر_ص)
        اطبع_سطر(")")
    نهاية

    دالة رقم عدد_المرئية()
        متغير عدد = 0
        لكل نافذة_م في النوافذ
            اذا (نافذة_م.الحالة != حالة_مصغرة)
                عدد = عدد + 1
            نهاية
        نهاية
        ارجع عدد
    نهاية
نهاية

