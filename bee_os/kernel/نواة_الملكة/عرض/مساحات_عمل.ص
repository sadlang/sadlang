# مساحات_عمل.ص - مساحات العمل المتعددة
# BeeOS Multi-Workspace - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296

صنف نافذة_مساحة
    نص عنوان
    رقم نف_x
    رقم نف_y
    رقم نف_ع
    رقم نف_ا
    رقم لون_نف

    باني(عن، nx، ny، nw، nh، لن)
        هذا.عنوان = عن
        هذا.نف_x = nx
        هذا.نف_y = ny
        هذا.نف_ع = nw
        هذا.نف_ا = nh
        هذا.لون_نف = لن
    نهاية
نهاية

صنف مساحة_عمل
    نص اسم_مساحة
    رقم لون_خلفية_م
    مصفوفة نوافذ_م

    باني(اسم، لخ)
        هذا.اسم_مساحة = اسم
        هذا.لون_خلفية_م = لخ
        هذا.نوافذ_م = []
    نهاية

    دالة إضافة_نافذة(نف)
        هذا.نوافذ_م = هذا.نوافذ_م + [نف]
    نهاية
نهاية

صنف مدير_مساحات
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    مصفوفة مساحات_ق
    رقم مساحة_نشطة

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مساحات_ق = []
        هذا.مساحة_نشطة = 0
    نهاية

    دالة إضافة_مساحة(مس)
        هذا.مساحات_ق = هذا.مساحات_ق + [مس]
    نهاية

    دالة رسم_نافذة(ف، نف، مقياس، إزاحة_x، إزاحة_y)
        متغير nx = إزاحة_x + نف.نف_x * مقياس / 100
        متغير ny = إزاحة_y + نف.نف_y * مقياس / 100
        متغير nw = نف.نف_ع * مقياس / 100
        متغير nh = نف.نف_ا * مقياس / 100

        اذا (nw < 10)
            ارجع 0
        نهاية
        اذا (nh < 10)
            ارجع 0
        نهاية

        # ظل
        ارسم_مستطيل_أصلي(ف، nx + 3، ny + 3، nw، nh، امزج_لون(ل_أسود، ل_أسود، 50))
        # جسم
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، nh، امزج_لون(ل_أسود، ل_أبيض، 12))
        # عنوان
        متغير عنوان_ه = nh / 8
        اذا (عنوان_ه > 28)
            عنوان_ه = 28
        نهاية
        اذا (عنوان_ه < 8)
            عنوان_ه = 8
        نهاية
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، عنوان_ه، نف.لون_نف)
        اذا (مقياس > 30)
            ارسم_نص_أصلي(ف، nx + 5، ny + 3، نف.عنوان، 1، ل_أبيض)
        نهاية
        # إطار
        ارسم_إطار_أصلي(ف، nx، ny، nw، nh، 1، ل_رمادي_غ)

        # محتوى مبسط
        اذا (مقياس > 50)
            ارسم_نص_أصلي(ف، nx + 10، ny + عنوان_ه + 10، "Content"، 1، ل_رمادي)
            ارسم_خط_أصلي(ف، nx + 10، ny + عنوان_ه + 28، nx + nw - 10، ny + عنوان_ه + 28، ل_رمادي_غ)
        نهاية

        ارجع 1
    نهاية

    دالة رسم_مساحة_كاملة(ف، مس، مقياس، إزاحة_x، إزاحة_y، نشطة)
        # خلفية المساحة
        متغير mx = إزاحة_x
        متغير my = إزاحة_y
        متغير mw = عرض_شاشة * مقياس / 100
        متغير mh = ارت_شاشة * مقياس / 100

        ارسم_مستطيل_أصلي(ف، mx، my، mw، mh، مس.لون_خلفية_م)

        # إطار نشط
        اذا (نشطة == 1)
            ارسم_إطار_أصلي(ف، mx - 2، my - 2، mw + 4، mh + 4، 3، ل_أصفر)
        والا
            ارسم_إطار_أصلي(ف، mx، my، mw، mh، 1، ل_رمادي_غ)
        نهاية

        # شريط مهام مصغر
        متغير شريط_ه = mh / 25
        اذا (شريط_ه < 3)
            شريط_ه = 3
        نهاية
        ارسم_مستطيل_أصلي(ف، mx، my + mh - شريط_ه، mw، شريط_ه، امزج_لون(ل_أسود، ل_أزرق_غ، 30))

        # رسم النوافذ
        متغير عن = 0
        متغير عدد_ن = طول(مس.نوافذ_م)
        بينما (عن < عدد_ن)
            هذا.رسم_نافذة(ف، مس.نوافذ_م[عن]، مقياس، إزاحة_x، إزاحة_y)
            عن = عن + 1
        نهاية

        # اسم المساحة
        اذا (مقياس > 20)
            ارسم_نص_أصلي(ف، mx + mw / 2 - 30، my + mh + 5، مس.اسم_مساحة، 1، ل_أبيض)
        نهاية

        ارجع 1
    نهاية

    # وضع عرض المساحة النشطة بملء الشاشة
    دالة رسم_مساحة_فعالة(ف، مس)
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، مس.لون_خلفية_م، امزج_لون(مس.لون_خلفية_م، ل_أسود، 40))

        # أيقونات
        متغير آي = 0
        بينما (آي < 4)
            ارسم_مستطيل_أصلي(ف، 30، 50 + آي * 100، 55، 55، ل_رمادي_غ)
            ارسم_نص_أصلي(ف، 35، 110 + آي * 100، "App" + آي، 1، ل_رمادي)
            آي = آي + 1
        نهاية

        # شريط مهام
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، امزج_لون(ل_أسود، ل_أزرق_غ، 30))
        ارسم_نص_أصلي(ف، 20، ارت_شاشة - 28، "Start"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، عرض_شاشة - 100، ارت_شاشة - 28، "12:00"، 1، ل_رمادي)

        # نوافذ المساحة
        متغير عن = 0
        متغير عدد_ن = طول(مس.نوافذ_م)
        بينما (عن < عدد_ن)
            هذا.رسم_نافذة(ف، مس.نوافذ_م[عن]، 100، 0، 0)
            عن = عن + 1
        نهاية

        # مؤشر المساحة أعلى يمين
        ارسم_مستطيل_أصلي(ف، عرض_شاشة - 200، 5، 190، 25، امزج_لون(ل_أسود، ل_أبيض، 15))
        ارسم_نص_أصلي(ف، عرض_شاشة - 190، 10، "Workspace: " + مس.اسم_مساحة، 1، ل_أصفر)

        ارجع 1
    نهاية

    # وضع المبدل (كل المساحات بجانب بعض)
    دالة رسم_مبدل(ف، مساحات، نشطة_idx)
        ارسم_مستطيل_أصلي(ف، 0، 0، عرض_شاشة، ارت_شاشة، امزج_لون(ل_أسود، ل_أزرق_غ، 15))

        ارسم_نص_أصلي(ف، عرض_شاشة / 2 - 100، 20، "Workspace Switcher"، 3، ل_أبيض)

        متغير عدد = طول(مساحات)
        متغير ثنائي_ع = 420
        متغير ثنائي_ا = 250
        متغير فجوة = 40
        متغير بداية_x = (عرض_شاشة - عدد * ثنائي_ع - (عدد - 1) * فجوة) / 2

        متغير مس = 0
        بينما (مس < عدد)
            متغير mx = بداية_x + مس * (ثنائي_ع + فجوة)
            متغير my = 120
            متغير نشط_حالي = 0
            اذا (مس == نشطة_idx)
                نشط_حالي = 1
            نهاية
            هذا.رسم_مساحة_كاملة(ف، مساحات[مس]، 22، mx، my، نشط_حالي)
            مس = مس + 1
        نهاية

        # شريط المساحات أسفل
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 60، عرض_شاشة، 60، امزج_لون(ل_أسود، ل_أبيض، 8))
        متغير مؤشر = 0
        بينما (مؤشر < عدد)
            متغير بx = عرض_شاشة / 2 - عدد * 50 / 2 + مؤشر * 55
            اذا (مؤشر == نشطة_idx)
                ارسم_دائرة_مصمتة(ف، بx + 15، ارت_شاشة - 30، 12، ل_أصفر)
            والا
                ارسم_دائرة_مصمتة(ف، بx + 15، ارت_شاشة - 30، 12، ل_رمادي_غ)
            نهاية
            ارسم_نص_أصلي(ف، بx + 7، ارت_شاشة - 35، "" + (مؤشر + 1)، 1، ل_أبيض)
            مؤشر = مؤشر + 1
        نهاية

        ارجع 1
    نهاية

    دالة رسم(إطار، مساحات، نشطة_idx)
        متغير ف = هذا.مقبض_خلفي

        اذا (إطار <= 4)
            # عرض المساحة النشطة
            هذا.رسم_مساحة_فعالة(ف، مساحات[نشطة_idx])
        والا
            # عرض المبدل
            هذا.رسم_مبدل(ف، مساحات، نشطة_idx)
        نهاية

        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)
        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== BeeOS Multi-Workspace ===")

    متغير مدير = جديد مدير_مساحات()

    # مساحة 1: التطوير
    متغير مس1 = جديد مساحة_عمل("Dev"، امزج_لون(ل_أزرق_غ، ل_أسود، 40))
    مس1.إضافة_نافذة(جديد نافذة_مساحة("Code Editor"، 200، 60، 700، 500، ل_أزرق_غ))
    مس1.إضافة_نافذة(جديد نافذة_مساحة("Terminal"، 920، 300، 500، 350، ل_أسود))

    # مساحة 2: التصفح
    متغير مس2 = جديد مساحة_عمل("Web"، امزج_لون(ل_أسود، ل_أبيض، 8))
    مس2.إضافة_نافذة(جديد نافذة_مساحة("Browser"، 150، 50، 900، 600، لون_من_rgb(0، 100، 200)))
    مس2.إضافة_نافذة(جديد نافذة_مساحة("Notes"، 1080، 200، 400، 300، ل_رمادي_غ))

    # مساحة 3: التصميم
    متغير مس3 = جديد مساحة_عمل("Design"، امزج_لون(ل_أسود، ل_رمادي_غ، 10))
    مس3.إضافة_نافذة(جديد نافذة_مساحة("Image Editor"، 100، 80، 800، 550، لون_من_rgb(150، 50، 150)))
    مس3.إضافة_نافذة(جديد نافذة_مساحة("Color Picker"، 950، 100، 350، 250، لون_من_rgb(200، 100، 0)))
    مس3.إضافة_نافذة(جديد نافذة_مساحة("Layers"، 950، 380، 350، 300، ل_رمادي_غ))

    # مساحة 4: الوسائط
    متغير مس4 = جديد مساحة_عمل("Media"، امزج_لون(ل_أسود، ل_أسود، 5))
    مس4.إضافة_نافذة(جديد نافذة_مساحة("Music Player"، 300، 100، 600، 400، لون_من_rgb(30، 30، 60)))
    مس4.إضافة_نافذة(جديد نافذة_مساحة("Visualizer"، 400، 520، 500، 200، لون_من_rgb(80، 0، 80)))

    مصفوفة كل_مساحات = [مس1، مس2، مس3، مس4]
    اطبع_سطر("[WORKSPACE] 4 workspaces created")

    # إطار 1: مساحة Dev نشطة
    اطبع_سطر("-- Frame 1: Dev workspace --")
    مدير.رسم(1، كل_مساحات، 0)
    مدير.تصدير("C:\\beeos_ws_dev.ppm")

    # إطار 2: مساحة Web نشطة
    اطبع_سطر("-- Frame 2: Web workspace --")
    مدير.رسم(2، كل_مساحات، 1)
    مدير.تصدير("C:\\beeos_ws_web.ppm")

    # إطار 3: مساحة Design نشطة
    اطبع_سطر("-- Frame 3: Design workspace --")
    مدير.رسم(3، كل_مساحات، 2)
    مدير.تصدير("C:\\beeos_ws_design.ppm")

    # إطار 4: مساحة Media نشطة
    اطبع_سطر("-- Frame 4: Media workspace --")
    مدير.رسم(4، كل_مساحات، 3)
    مدير.تصدير("C:\\beeos_ws_media.ppm")

    # إطار 5: المبدل - Dev نشطة
    اطبع_سطر("-- Frame 5: Switcher (Dev) --")
    مدير.رسم(5، كل_مساحات، 0)
    مدير.تصدير("C:\\beeos_ws_switch1.ppm")

    # إطار 6: المبدل - Design نشطة
    اطبع_سطر("-- Frame 6: Switcher (Design) --")
    مدير.رسم(6، كل_مساحات، 2)
    مدير.تصدير("C:\\beeos_ws_switch2.ppm")

    متغير أسود = عد_بكسلات(مدير.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("=== Multi-Workspace: SUCCESS ===")
    ارجع 0
نهاية
