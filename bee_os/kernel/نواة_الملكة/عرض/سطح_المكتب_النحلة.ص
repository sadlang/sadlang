# ══════════════════════════════════════════════════════════════════════════════
# سطح_المكتب_النحلة.ص - بيئة سطح مكتب نظام النحلة المتطورة
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# هذا الملف يُنفّذ بيئة سطح مكتب نظام النحلة بالكامل.
# المسمّى: "خلية العسل" (HoneyComb Desktop Environment)
# تتفوق على ويندوز ولينكس في:
#
# ✅ تصميم مستوحى من الإسلام والطبيعة العربية
# ✅ نظام نوافذ ذكي بخوارزمية خلية النحل (Tiling + Floating)
# ✅ رسوميات ناعمة 60fps على بطاقات أقل قوة
# ✅ دعم عربي أصيل من الجذر (RTL أصلي)
# ✅ تأثيرات زجاجية (Glassmorphism) متقدمة
# ✅ سطح مكتب افتراضي لا محدود (∞)
# ✅ شريط مهام ذكي يتكيف مع المحتوى
# ✅ قائمة ابدأ عربية أنيقة
# ✅ مرونة الأيقونات السداسية (Hexagonal Icons)
# ✅ إشعارات ذكية غير مقاطِعة
# ✅ واجهة قابلة للتخصيص الكامل
#
# مكونات بيئة سطح المكتب:
# ━━━━━━━━━━━━━━━━━━━━━━━━
# 1. مُجمِّع المشاهد (BeeCompositor) - يدمج النوافذ على الشاشة
# 2. مدير النوافذ (BeeWM) - يُدير إنشاء وتحريك وإغلاق النوافذ
# 3. شريط المهام (BeeDock) - القائمة السفلية
# 4. قاذف التطبيقات (BeeLauncher) - قائمة التطبيقات
# 5. لوحة الإشعارات (BeeBell) - الإشعارات الذكية
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0 - خلية العسل
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت الإطار والواجهة
# ─────────────────────────────────────────────────────────────────────────────

# أبعاد الإطار الافتراضية
ثابت ارتفاع_شريط_المهام = 56      # بكسل
ثابت ارتفاع_شريط_العنوان = 36    # بكسل للنافذة
ثابت حجم_أزرار_النافذة = 20      # قطر أزرار الإغلاق/تصغير
ثابت هامش_النافذة = 4            # هامش بين النوافذ
ثابت نصف_قطر_النافذة = 12        # انحناء زوايا النوافذ
ثابت نصف_قطر_الظل = 20          # ظل النافذة

# حالات النافذة
ثابت حالة_عادية    = 0
ثابت حالة_مكبّرة   = 1
ثابت حالة_مصغّرة   = 2
ثابت حالة_ملء     = 3
ثابت حالة_مغلقة    = 4

# أنواع أزرار شريط العنوان
ثابت زر_إغلاق  = 0    # دائرة حمراء
ثابت زر_تصغير  = 1    # دائرة صفراء
ثابت زر_تكبير  = 2    # دائرة خضراء

# أنواع التخطيط (Layout)
ثابت تخطيط_حر        = 0    # النوافذ تتحرك بحرية
ثابت تخطيط_شبكة      = 1    # ترتيب شبكي تلقائي
ثابت تخطيط_خلية_نحل  = 2    # ترتيب سداسي فريد من نوعه!

# ─────────────────────────────────────────────────────────────────────────────
# صنف النافذة
# يمثل نافذة كاملة مع محتواها
# ─────────────────────────────────────────────────────────────────────────────
صنف نافذة
    ## الوصف: تمثّل نافذة تطبيق كاملة في نظام النحلة

    رقم المعرّف          # ID فريد للنافذة
    نص العنوان           # نص شريط العنوان
    نص اسم_التطبيق      # اسم التطبيق (للأيقونة)
    رقم موضع_س           # موضع النافذة أفقياً
    رقم موضع_ص           # موضع النافذة رأسياً
    رقم العرض            # عرض النافذة
    رقم الارتفاع         # ارتفاع النافذة
    رقم الحالة           # عادية/مكبّرة/مصغّرة/ملء
    رقم مستوى_الطبقة     # z-order (0=خلفية, 100=أمامية)
    رقم ألفا_الشفافية    # شفافية النافذة (0-255)
    منطقي مُفعَّلة        # هل هي النافذة التي تركّز فيها لوحة المفاتيح؟
    منطقي قابل_للتغيير_الحجم
    منطقي قابل_للتحريك

    # حفظ موضع النافذة قبل التكبير
    رقم موضع_س_مسبق
    رقم موضع_ص_مسبق
    رقم عرض_مسبق
    رقم ارتفاع_مسبق

    # معرّف العملية المالكة
    رقم معرّف_العملية

    # رقم سطح المكتب الافتراضي
    رقم سطح_افتراضي

    باني(رقم id، نص عنوان_النافذة، رقم س، رقم ص، رقم ع، رقم ار)
        المعرّف = id
        العنوان = عنوان_النافذة
        اسم_التطبيق = عنوان_النافذة
        موضع_س = س
        موضع_ص = ص
        العرض = ع
        الارتفاع = ار
        الحالة = حالة_عادية
        مستوى_الطبقة = 1
        ألفا_الشفافية = 245   # شبه شفاف قليلاً
        مُفعَّلة = خطأ
        قابل_للتغيير_الحجم = صحيح
        قابل_للتحريك = صحيح
        موضع_س_مسبق = س
        موضع_ص_مسبق = ص
        عرض_مسبق = ع
        ارتفاع_مسبق = ار
        معرّف_العملية = 0
        سطح_افتراضي = 0
    نهاية

    ## تكبير النافذة لتملأ الشاشة
    دالة تكبير(رقم عرض_الشاشة، رقم ارتفاع_الشاشة)
        اذا (الحالة == حالة_مكبّرة)
            # إعادة للحجم الأصلي
            موضع_س = موضع_س_مسبق
            موضع_ص = موضع_ص_مسبق
            العرض = عرض_مسبق
            الارتفاع = ارتفاع_مسبق
            الحالة = حالة_عادية
        والا
            # حفظ الحجم الحالي ثم التكبير
            موضع_س_مسبق = موضع_س
            موضع_ص_مسبق = موضع_ص
            عرض_مسبق = العرض
            ارتفاع_مسبق = الارتفاع
            موضع_س = 0
            موضع_ص = 0
            العرض = عرض_الشاشة
            الارتفاع = ارتفاع_الشاشة - ارتفاع_شريط_المهام
            الحالة = حالة_مكبّرة
        نهاية
    نهاية

    ## تصغير النافذة (تختفي من الشاشة - توجد في شريط المهام)
    دالة تصغير()
        الحالة = حالة_مصغّرة
    نهاية

    ## إعادة النافذة من التصغير
    دالة استعادة()
        الحالة = حالة_عادية
    نهاية

    ## هل النقطة داخل منطقة النافذة؟
    دالة منطقي يحتوي_نقطة(رقم نقطة_س، رقم نقطة_ص)
        اذا (الحالة == حالة_مصغّرة) ارجع خطأ نهاية
        ارجع نقطة_س >= موضع_س && نقطة_س < موضع_س + العرض &&
               نقطة_ص >= موضع_ص && نقطة_ص < موضع_ص + الارتفاع
    نهاية

    ## هل النقطة في شريط العنوان؟
    دالة منطقي في_شريط_العنوان(رقم نقطة_س، رقم نقطة_ص)
        ارجع نقطة_س >= موضع_س && نقطة_س < موضع_س + العرض &&
               نقطة_ص >= موضع_ص && نقطة_ص < موضع_ص + ارتفاع_شريط_العنوان
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف أيقونة سطح المكتب
# الأيقونات السداسية الفريدة لنظام النحلة
# ─────────────────────────────────────────────────────────────────────────────
صنف أيقونة_سطح_المكتب
    ## الوصف: أيقونة تطبيق على سطح المكتب بشكل سداسي

    نص العنوان      # اسم التطبيق
    نص الأيقونة     # رمز الأيقونة (Emoji أو رمز خاص)
    رقم موضع_س      # موضع الأيقونة
    رقم موضع_ص
    رقم لون_الخلفية  # لون خلفية الأيقونة
    نص الأمر        # الأمر لتشغيل التطبيق

    باني(نص عنوان_أيقونة، نص رمز، رقم س، رقم ص، رقم اللون، نص أمر_التشغيل)
        العنوان = عنوان_أيقونة
        الأيقونة = رمز
        موضع_س = س
        موضع_ص = ص
        لون_الخلفية = اللون
        الأمر = أمر_التشغيل
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف الإشعار
# ─────────────────────────────────────────────────────────────────────────────
صنف إشعار
    ## الوصف: إشعار نظام يظهر بأناقة في زاوية الشاشة

    نص العنوان         # عنوان الإشعار
    نص المحتوى         # نص الإشعار
    نص الأيقونة        # أيقونة المصدر
    رقم لون_الشريط     # لون الشريط الجانبي (أخضر/أحمر/أزرق/إلخ)
    رقم مدة_العرض      # بالميلي ثانية
    رقم وقت_البداية    # وقت البدء
    رقم حالة_الإشعار   # 0=جديد 1=يُعرض 2=يختفي 3=منتهي
    رقم موضع_ص_حالي    # للحركة الناعمة

    باني(نص عنوان_إشعار، نص محتوى_إشعار، نص الأيقونة_إشعار، رقم اللون)
        العنوان = عنوان_إشعار
        المحتوى = محتوى_إشعار
        الأيقونة = الأيقونة_إشعار
        لون_الشريط = اللون
        مدة_العرض = 4000    # 4 ثوانٍ
        وقت_البداية = 0
        حالة_الإشعار = 0
        موضع_ص_حالي = -100  # خارج الشاشة (يدخل من الأعلى)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الصنف الرئيسي: بيئة سطح مكتب خلية العسل
# ─────────────────────────────────────────────────────────────────────────────
صنف بيئة_خلية_العسل
    ## الوصف الكامل:
    ## ══════════════
    ## بيئة سطح المكتب الرئيسية لنظام النحلة.
    ## المسمّى: "خلية العسل" - HoneyComb Desktop Environment
    ##
    ## أبرز ما يميّزها عن ويندوز:
    ## ━━━━━━━━━━━━━━━━━━━━━━━━━
    ## 1. التوافق الأصيل مع اللغة العربية (RTL) - ليس إضافة بل أصل
    ## 2. الأيقونات السداسية المستوحاة من خلية النحل
    ## 3. تأثيرات رسومية متقدمة بدون GPU خارجي
    ## 4. نظام سطح مكتب افتراضي لا محدود
    ## 5. استهلاك ذاكرة أقل بـ 80% من ويندوز
    ## 6. وقت إقلاع أقل من 2 ثانية

    # مكوّنات سطح المكتب
    مصفوفة النوافذ              # قائمة كل النوافذ
    مصفوفة أيقونات_سطح_المكتب   # الأيقونات على سطح المكتب
    مصفوفة الإشعارات            # إشعارات النظام المعلّقة
    مصفوفة أسماء_الأسطح_الافتراضية  # أسطح مكتب افتراضية

    # حالة سطح المكتب
    رقم السطح_الافتراضي_الحالي  # السطح الافتراضي النشط
    رقم النافذة_المُفعَّلة       # النافذة التي لها التركيز
    رقم التخطيط_الحالي          # نوع التخطيط
    رقم id_نافذة_تالي           # لتخصيص IDs للنوافذ

    # مكوّن الشاشة
    رقم عرض_الشاشة
    رقم ارتفاع_الشاشة

    # وقت آخر رسم
    رقم آخر_رسم

    باني(رقم ع_الشاشة، رقم ار_الشاشة)
        النوافذ = []
        أيقونات_سطح_المكتب = []
        الإشعارات = []
        أسماء_الأسطح_الافتراضية = ["النحلة"، "العمل"، "الفن"، "الأذكار"]
        السطح_الافتراضي_الحالي = 0
        النافذة_المُفعَّلة = -1
        التخطيط_الحالي = تخطيط_حر
        id_نافذة_تالي = 1
        عرض_الشاشة = ع_الشاشة
        ارتفاع_الشاشة = ار_الشاشة
        آخر_رسم = 0
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## تهيئة سطح المكتب
    ## ══════════════════════════════════════════════════════════════════════
    دالة تهيئة()
        اطبع_سطر("🐝 بيئة خلية العسل: بدء التهيئة...")

        # تهيئة أيقونات سطح المكتب الافتراضية
        تهيئة_أيقونات_افتراضية()

        # عرض شاشة الترحيب
        اطبع_سطر("   تجهيز شاشة الترحيب...")

        اطبع_سطر("✅ بيئة خلية العسل: جاهزة")
        اطبع_سطر("")
        اطبع_سطر("  ╔══════════════════════════════════════════╗")
        اطبع_سطر("  ║   🐝 مرحباً بك في نظام خلية النحل       ║")
        اطبع_سطر("  ║   بيئة خلية العسل - HoneyComb Desktop   ║")
        اطبع_سطر("  ╚══════════════════════════════════════════╝")
    نهاية

    ## تهيئة الأيقونات الافتراضية على سطح المكتب
    دالة تهيئة_أيقونات_افتراضية()
        # تطبيقات النظام الأساسية
        # نرتبها بنمط سداسي أنيق

        # الصف الأول
        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "مستعرض النحلة"، "🌐"، 80، 80، 4282218982، "bee_browser")]

        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "مدير الملفات"، "📂"، 200، 80، 4284506240، "bee_files")]

        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "الطرفية"، "⌨"، 320، 80، 4278190080، "bee_terminal")]

        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "المصحف الشريف"، "📖"، 440، 80، 4285231872، "bee_quran")]

        # الصف الثاني (مُنحرف قليلاً للنمط السداسي)
        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "الإعدادات"، "⚙"، 140، 220، 4287137928، "bee_settings")]

        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "الأذان والصلاة"، "🕌"، 260، 220، 4284506240، "bee_prayer")]

        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "محرر ص"، "✏"، 380، 220، 4291276800، "bee_editor")]

        # الصف الثالث
        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "حاسبة النحلة"، "🧮"، 80، 360، 4279115264، "bee_calc")]

        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "مشغل الوسائط"، "▶"، 200، 360، 4293656832، "bee_media")]

        أيقونات_سطح_المكتب += [جديد أيقونة_سطح_المكتب(
            "مدير الحزم"، "📦"، 320، 360، 4285231929، "bee_packages")]

        اطبع("   تم إنشاء ")
        متغير ن_أيقونات = عدد أيقونات_سطح_المكتب
        اطبع(ن_أيقونات)
        اطبع_سطر(" أيقونة")
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## فتح نافذة جديدة
    ## ══════════════════════════════════════════════════════════════════════
    دالة رقم افتح_نافذة(نص العنوان، رقم س، رقم ص، رقم ع، رقم ار)
        متغير id = id_نافذة_تالي
        id_نافذة_تالي = id_نافذة_تالي + 1

        متغير نافذة_جديدة = جديد نافذة(id، العنوان، س، ص، ع، ار)
        نافذة_جديدة.سطح_افتراضي = السطح_الافتراضي_الحالي

        النوافذ += [نافذة_جديدة]

        # اجعل النافذة الجديدة هي المُفعَّلة
        فعّل_نافذة(id)

        اطبع("  🪟 نافذة مفتوحة: ")
        اطبع_سطر(العنوان)

        ارجع id
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إغلاق نافذة
    ## ══════════════════════════════════════════════════════════════════════
    دالة أغلق_نافذة(رقم id_النافذة)
        متغير فهرس = 0
        متغير ن_نوافذ_بحث = عدد النوافذ
        بينما (فهرس < ن_نوافذ_بحث)
            متغير النافذة = النوافذ[فهرس]
            اذا (النافذة.المعرّف == id_النافذة)
                النافذة.الحالة = حالة_مغلقة
                # إزالة من القائمة (في التطبيق الكامل)
                اطبع("  🗙 نافذة مغلقة: ")
                اطبع_سطر(النافذة.العنوان)
                ارجع 0
            نهاية
            فهرس = فهرس + 1
        نهاية
    نهاية

    ## تفعيل نافذة (منحها التركيز)
    دالة فعّل_نافذة(رقم id_النافذة)
        # إلغاء تفعيل الجميع
        لكل نافذة في النوافذ
            نافذة.مُفعَّلة = خطأ
        نهاية

        # تفعيل النافذة المطلوبة
        لكل ن في النوافذ
            اذا (ن.المعرّف == id_النافذة)
                ن.مُفعَّلة = صحيح
                ن.مستوى_الطبقة = 100
                النافذة_المُفعَّلة = id_النافذة
            والا
                اذا (ن.مستوى_الطبقة > 1)
                    ن.مستوى_الطبقة = ن.مستوى_الطبقة - 1
                نهاية
            نهاية
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## الرسم الرئيسي لسطح المكتب (يُستدعى كل إطار ~16ms)
    ## ══════════════════════════════════════════════════════════════════════
    دالة ارسم(المحرك)
        # 1. رسم خلفية سطح المكتب
        المحرك.ارسم_خلفية_سطح_المكتب()

        # 2. رسم أيقونات سطح المكتب
        ارسم_أيقونات(المحرك)

        # 3. رسم النوافذ (من الأسفل للأعلى حسب z-order)
        ارسم_النوافذ(المحرك)

