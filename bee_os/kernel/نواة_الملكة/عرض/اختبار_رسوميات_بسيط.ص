# اختبار رسوميات بسيط

ثابت عرض_الشاشة = 1920
ثابت ارتفاع_الشاشة = 1080

صنف محرك_رسوميات_بسيط
    رقم عرض
    رقم ارتفاع
    رقم عداد_بكسلات

    باني(رقم w، رقم h)
        عرض = w
        ارتفاع = h
        عداد_بكسلات = 0
    نهاية

    دالة رسم_بكسل(رقم x، رقم y، رقم لون)
        اذا (x >= 0)
            اذا (x < عرض)
                اذا (y >= 0)
                    اذا (y < ارتفاع)
                        عداد_بكسلات = عداد_بكسلات + 1
                    نهاية
                نهاية
            نهاية
        نهاية
        ارجع 1
    نهاية

    دالة رسم_خط_أفقي(رقم x، رقم y، رقم طول)
        متغير i = 0
        بينما (i < طول)
            رسم_بكسل(x + i، y، 255)
            i = i + 1
        نهاية
    نهاية

    دالة رسم_مستطيل(رقم x، رقم y، رقم w، رقم h)
        متغير j = 0
        بينما (j < h)
            رسم_خط_أفقي(x، y + j، w)
            j = j + 1
        نهاية
    نهاية

    دالة عرض_إحصاءات()
        اطبع("  عدد البكسلات: ")
        اطبع_سطر(عداد_بكسلات)
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("═══ اختبار رسوميات بسيط ═══")

    متغير محرك = جديد محرك_رسوميات_بسيط(1920، 1080)

    # رسم مستطيل صغير (10×10 = 100 بكسل فقط)
    محرك.رسم_مستطيل(100، 100، 10، 10)

    محرك.عرض_إحصاءات()

    اطبع_سطر("✅ النجاح!")
    ارجع 0
نهاية
