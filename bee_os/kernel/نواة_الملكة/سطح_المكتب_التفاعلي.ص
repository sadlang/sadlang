# سطح_المكتب_التفاعلي.ص - نظام سطح المكتب التفاعلي الكامل لنظام خلية النحل
# BeeOS Interactive Desktop - Full HD 1920×1080 - Real Pixel Compositing
# ══════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# ثوابت الشاشة
# ─────────────────────────────────────────────────────────────────────
متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

# ─────────────────────────────────────────────────────────────────────
# ألوان ARGB (signed int32)
# ─────────────────────────────────────────────────────────────────────
متغير ل_أسود       = -16777216
متغير ل_أبيض       = -1
متغير ل_أحمر       = -65536
متغير ل_أخضر       = -16711936
متغير ل_أزرق       = -16776961
متغير ل_أصفر       = -256
متغير ل_رمادي_ف    = -3355444
متغير ل_رمادي_غ    = -12303292
متغير ل_شريط       = -14575885
متغير ل_شريط_مهام  = -15132391
متغير ل_تحديد      = -16744193
متغير ل_حدود       = -8882056

# ─────────────────────────────────────────────────────────────────────
# ثوابت واجهة المستخدم
# ─────────────────────────────────────────────────────────────────────
متغير ارت_عنوان = 30
متغير ارت_مهام  = 48
متغير حجم_زر    = 20
متغير فجوة      = 4
متغير سمك       = 2

# حالات النوافذ
متغير و_عادي  = 0
متغير و_مصغر  = 1
متغير و_مكبر  = 2
متغير و_مغلق  = 3

# ══════════════════════════════════════════════════════════════════════
# صنف الماوس
# ══════════════════════════════════════════════════════════════════════
صنف ماوس_النظام
    رقم x_حالي
    رقم y_حالي
    منطقي زر_أيسر
    منطقي زر_أيمن
    رقم عدد_أحداث

    باني()
        هذا.x_حالي = عرض_شاشة / 2
        هذا.y_حالي = ارت_شاشة / 2
        هذا.زر_أيسر = خطأ
        هذا.زر_أيمن = خطأ
        هذا.عدد_أحداث = 0
    نهاية

    دالة تحريك(dx، dy)
        هذا.x_حالي = هذا.x_حالي + dx
        هذا.y_حالي = هذا.y_حالي - dy
        اذا (هذا.x_حالي < 0)
            هذا.x_حالي = 0
        نهاية
        اذا (هذا.y_حالي < 0)
            هذا.y_حالي = 0
        نهاية
        اذا (هذا.x_حالي >= عرض_شاشة)
            هذا.x_حالي = عرض_شاشة - 1
        نهاية
        اذا (هذا.y_حالي >= ارت_شاشة)
            هذا.y_حالي = ارت_شاشة - 1
        نهاية
        هذا.عدد_أحداث = هذا.عدد_أحداث + 1
    نهاية

    دالة نقر_أيسر()
        هذا.زر_أيسر = صحيح
        هذا.عدد_أحداث = هذا.عدد_أحداث + 1
    نهاية

    دالة إفلات_أيسر()
        هذا.زر_أيسر = خطأ
        هذا.عدد_أحداث = هذا.عدد_أحداث + 1
    نهاية

    دالة رسم_مؤشر(مقبض_fb)
        متغير mx = هذا.x_حالي
        متغير my = هذا.y_حالي
        متغير بكسلات = 0

        # مؤشر سهم أبيض بحدود سوداء (16x16)
        # الحدود السوداء
        متغير ص = 0
        بينما (ص < 16)
            اكتب_بكسل(مقبض_fb، mx، my + ص، ل_أسود)
            بكسلات = بكسلات + 1
            ص = ص + 1
        نهاية

        # جسم السهم الأبيض
        ص = 1
        بينما (ص < 14)
            متغير عرض_سطر = ص
            اذا (عرض_سطر > 8)
                عرض_سطر = 8
            نهاية
            متغير ع = 1
            بينما (ع < عرض_سطر)
                اكتب_بكسل(مقبض_fb، mx + ع، my + ص، ل_أبيض)
                بكسلات = بكسلات + 1
                ع = ع + 1
            نهاية
            ص = ص + 1
        نهاية

        ارجع بكسلات
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
# صنف لوحة المفاتيح
# ══════════════════════════════════════════════════════════════════════
صنف لوحة_النظام
    منطقي شيفت
    منطقي كنترول
    رقم آخر_مفتاح
    رقم عدد_أحداث

    باني()
        هذا.شيفت = خطأ
        هذا.كنترول = خطأ
        هذا.آخر_مفتاح = 0
        هذا.عدد_أحداث = 0
    نهاية

    دالة ضغط(رمز)
        هذا.آخر_مفتاح = رمز
        هذا.عدد_أحداث = هذا.عدد_أحداث + 1
        اذا (رمز == 256)
            هذا.شيفت = صحيح
        نهاية
        اذا (رمز == 257)
            هذا.كنترول = صحيح
        نهاية
    نهاية

    دالة إفلات(رمز)
        هذا.عدد_أحداث = هذا.عدد_أحداث + 1
        اذا (رمز == 256)
            هذا.شيفت = خطأ
        نهاية
        اذا (رمز == 257)
            هذا.كنترول = خطأ
        نهاية
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
# صنف نافذة التطبيق
# ══════════════════════════════════════════════════════════════════════
صنف نافذة_تطبيق
    رقم معرف
    نص عنوان
    رقم nx
    رقم ny
    رقم nw
    رقم nh
    رقم وضع
    رقم مقبض
    رقم ترتيب
    منطقي مركزة
    نص نوع

    باني(م، ز، ن_x، ن_y، ن_w، ن_h، ن_عنوان، ن_نوع)
        هذا.معرف = م
        هذا.عنوان = ن_عنوان
        هذا.nx = ن_x
        هذا.ny = ن_y
        هذا.nw = ن_w
        هذا.nh = ن_h
        هذا.وضع = و_عادي
        هذا.مقبض = أنشئ_مخزن_رسوم(ن_w، ن_h)
        هذا.ترتيب = ز
        هذا.مركزة = خطأ
        هذا.نوع = ن_نوع
    نهاية

    # رسم إطار وشريط عنوان
    دالة رسم_إطار()
        اذا (هذا.وضع == و_مغلق || هذا.وضع == و_مصغر)
            ارجع 0
        نهاية

        متغير f = هذا.مقبض

        # خلفية بيضاء
        املأ_مخزن(f، ل_أبيض)

        # شريط العنوان
        ارسم_مستطيل_أصلي(f، 0، 0، هذا.nw، ارت_عنوان، ل_شريط)

        # نص العنوان
        ارسم_نص_أصلي(f، 10، 8، هذا.عنوان، 2، ل_أبيض)

        # أزرار التحكم
        متغير بx = هذا.nw - حجم_زر - فجوة
        # إغلاق (أحمر)
        ارسم_مستطيل_أصلي(f، بx، 5، حجم_زر، حجم_زر، ل_أحمر)
        ارسم_نص_أصلي(f، بx + 5، 7، "X"، 1، ل_أبيض)

        # تكبير (أخضر)
        بx = بx - حجم_زر - فجوة
        ارسم_مستطيل_أصلي(f، بx، 5، حجم_زر، حجم_زر، ل_أخضر)

        # تصغير (أصفر)
        بx = بx - حجم_زر - فجوة
        ارسم_مستطيل_أصلي(f، بx، 5، حجم_زر، حجم_زر، ل_أصفر)
        ارسم_نص_أصلي(f، بx + 5، 7، "_"، 1، ل_أسود)

        # حدود
        اذا (هذا.مركزة)
            ارسم_إطار_أصلي(f، 0، 0، هذا.nw، هذا.nh، سمك، ل_تحديد)
        والا
            ارسم_إطار_أصلي(f، 0، 0، هذا.nw، هذا.nh، سمك، ل_حدود)
        نهاية

        ارجع 1
    نهاية

    # رسم محتوى التطبيق
    دالة رسم_محتوى()
        اذا (هذا.وضع == و_مغلق || هذا.وضع == و_مصغر)
            ارجع 0
        نهاية

        متغير f = هذا.مقبض
        متغير cy = ارت_عنوان + 5
        متغير cx = 10
        متغير cw = هذا.nw - 20
        متغير ch = هذا.nh - ارت_عنوان - 10

        اذا (هذا.نوع == "متصفح")
            # شريط URL
            ارسم_مستطيل_أصلي(f، cx، cy، cw، 25، ل_رمادي_ف)
            ارسم_إطار_أصلي(f، cx، cy، cw، 25، 1، ل_رمادي_غ)
            ارسم_نص_أصلي(f، cx + 5، cy + 6، "https://beeos.local/"، 1، ل_أسود)

            # محتوى
            متغير wy = cy + 30
            ارسم_مستطيل_أصلي(f، cx، wy، cw، ch - 35، ل_أبيض)

            # عنوان الصفحة
            ارسم_نص_أصلي(f، cx + 20، wy + 15، "BeeOS Web Portal"، 3، ل_شريط)
            ارسم_خط_أصلي(f، cx + 20، wy + 45، cx + cw - 20، wy + 45، ل_رمادي_ف)
            ارسم_نص_أصلي(f، cx + 20، wy + 55، "Welcome to BeeOS Browser"، 2، ل_أسود)
            ارسم_نص_أصلي(f، cx + 20، wy + 85، "Your gateway to the web."، 1، ل_رمادي_غ)

            # أزرار
            ارسم_مستطيل_أصلي(f، cx + 20، wy + 115، 100، 30، ل_شريط)
            ارسم_نص_أصلي(f، cx + 40، wy + 123، "Home"، 1، ل_أبيض)

            ارسم_مستطيل_أصلي(f، cx + 140، wy + 115، 100، 30، ل_أخضر)
            ارسم_نص_أصلي(f، cx + 150، wy + 123، "Settings"، 1، ل_أبيض)

            ارسم_مستطيل_أصلي(f، cx + 260، wy + 115، 100، 30، ل_أزرق)
            ارسم_نص_أصلي(f، cx + 270، wy + 123، "About"، 1، ل_أبيض)

            # قائمة روابط
            ارسم_نص_أصلي(f، cx + 20، wy + 165، "Quick Links:"، 2، ل_أسود)
            ارسم_نص_أصلي(f، cx + 30، wy + 190، "> BeeOS Documentation"، 1، ل_أزرق)
            ارسم_نص_أصلي(f، cx + 30، wy + 208، "> App Store"، 1، ل_أزرق)
            ارسم_نص_أصلي(f، cx + 30، wy + 226، "> System Settings"، 1، ل_أزرق)

        والا
            اذا (هذا.نوع == "حاسبة")
                # شاشة العرض
                ارسم_مستطيل_أصلي(f، cx، cy، cw، 45، ل_أسود)
                ارسم_نص_أصلي(f، cx + cw - 60، cy + 14، "42"، 2، ل_أخضر)

                # شبكة الأزرار 4x5
                متغير bw = (cw - 15) / 4
                متغير bh = 38
                متغير bg = 3
                متغير ry = cy + 55

                # صف 1: C ( ) /
                ارسم_مستطيل_أصلي(f، cx، ry، bw، bh، ل_رمادي_ف)
                ارسم_نص_أصلي(f، cx + bw / 2 - 3، ry + 12، "C"، 1، ل_أحمر)
                ارسم_مستطيل_أصلي(f، cx + bw + bg، ry، bw، bh، ل_رمادي_ف)
                ارسم_نص_أصلي(f، cx + bw + bg + bw / 2 - 3، ry + 12، "("، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 2 * (bw + bg)، ry، bw، bh، ل_رمادي_ف)
                ارسم_نص_أصلي(f، cx + 2 * (bw + bg) + bw / 2 - 3، ry + 12، ")"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 3 * (bw + bg)، ry، bw، bh، ل_أصفر)
                ارسم_نص_أصلي(f، cx + 3 * (bw + bg) + bw / 2 - 3، ry + 12، "/"، 1، ل_أسود)

                # صف 2: 7 8 9 x
                ry = ry + bh + bg
                ارسم_مستطيل_أصلي(f، cx، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + bw / 2 - 3، ry + 12، "7"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + bw + bg، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + bw + bg + bw / 2 - 3، ry + 12، "8"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 2 * (bw + bg)، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + 2 * (bw + bg) + bw / 2 - 3، ry + 12، "9"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 3 * (bw + bg)، ry، bw، bh، ل_أصفر)
                ارسم_نص_أصلي(f، cx + 3 * (bw + bg) + bw / 2 - 3، ry + 12، "x"، 1، ل_أسود)

                # صف 3: 4 5 6 -
                ry = ry + bh + bg
                ارسم_مستطيل_أصلي(f، cx، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + bw / 2 - 3، ry + 12، "4"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + bw + bg، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + bw + bg + bw / 2 - 3، ry + 12، "5"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 2 * (bw + bg)، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + 2 * (bw + bg) + bw / 2 - 3، ry + 12، "6"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 3 * (bw + bg)، ry، bw، bh، ل_أصفر)
                ارسم_نص_أصلي(f، cx + 3 * (bw + bg) + bw / 2 - 3، ry + 12، "-"، 1، ل_أسود)

                # صف 4: 1 2 3 +
                ry = ry + bh + bg
                ارسم_مستطيل_أصلي(f، cx، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + bw / 2 - 3، ry + 12، "1"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + bw + bg، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + bw + bg + bw / 2 - 3، ry + 12، "2"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 2 * (bw + bg)، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + 2 * (bw + bg) + bw / 2 - 3، ry + 12، "3"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 3 * (bw + bg)، ry، bw، bh، ل_أصفر)
                ارسم_نص_أصلي(f، cx + 3 * (bw + bg) + bw / 2 - 3، ry + 12، "+"، 1، ل_أسود)

                # صف 5: 0 . =
                ry = ry + bh + bg
                ارسم_مستطيل_أصلي(f، cx، ry، 2 * bw + bg، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + bw - 3، ry + 12، "0"، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 2 * (bw + bg)، ry، bw، bh، ل_أبيض)
                ارسم_نص_أصلي(f، cx + 2 * (bw + bg) + bw / 2 - 3، ry + 12، "."، 1، ل_أسود)
                ارسم_مستطيل_أصلي(f، cx + 3 * (bw + bg)، ry، bw، bh، ل_شريط)
                ارسم_نص_أصلي(f، cx + 3 * (bw + bg) + bw / 2 - 3، ry + 12، "="، 1، ل_أبيض)

            والا
                اذا (هذا.نوع == "محرر")
                    # شريط أدوات
                    ارسم_مستطيل_أصلي(f، cx، cy، cw، 22، ل_رمادي_ف)
                    ارسم_نص_أصلي(f، cx + 5، cy + 5، "File  Edit  View  Help"، 1، ل_أسود)

                    # أرقام الأسطر
                    متغير ty = cy + 27
                    ارسم_مستطيل_أصلي(f، cx، ty، 35، ch - 32، ل_رمادي_ف)

                    متغير سطر = 1
                    بينما (سطر <= 15)
                        متغير sy = ty + (سطر - 1) * 15
                        ارسم_نص_أصلي(f، cx + 3، sy + 2، "" + سطر، 1، ل_رمادي_غ)
                        سطر = سطر + 1
                    نهاية

                    # محتوى النص
                    ارسم_مستطيل_أصلي(f، cx + 35، ty، cw - 35، ch - 32، ل_أبيض)

                    ارسم_نص_أصلي(f، cx + 42، ty + 2، "# BeeOS Source Code"، 1، ل_أزرق)
                    ارسم_نص_أصلي(f، cx + 42، ty + 17، ""، 1، ل_أسود)
                    ارسم_نص_أصلي(f، cx + 42، ty + 32، "function main():"، 1، ل_شريط)
                    ارسم_نص_أصلي(f، cx + 42، ty + 47، "    print(BeeOS v1.0)"، 1، ل_أسود)
                    ارسم_نص_أصلي(f، cx + 42، ty + 62، "    init_desktop()"، 1، ل_أسود)
                    ارسم_نص_أصلي(f، cx + 42، ty + 77، "    run_event_loop()"، 1، ل_أسود)
                    ارسم_نص_أصلي(f، cx + 42، ty + 92، ""، 1، ل_أسود)
                    ارسم_نص_أصلي(f، cx + 42، ty + 107، "# -- Kernel Module --"، 1، ل_أزرق)
                    ارسم_نص_أصلي(f، cx + 42، ty + 122، "import memory_manager"، 1، ل_أحمر)
                    ارسم_نص_أصلي(f، cx + 42، ty + 137، "import scheduler"، 1، ل_أحمر)

                    # مؤشر نص
                    ارسم_مستطيل_أصلي(f، cx + 200، ty + 47، 2، 12، ل_أسود)

                    # شريط حالة
                    ارسم_مستطيل_أصلي(f، cx، cy + ch - 5، cw، 15، ل_شريط)
                    ارسم_نص_أصلي(f، cx + 5، cy + ch - 2، "Line 4, Col 21 | UTF-8 | Sad Lang"، 1، ل_أبيض)

                والا
                    اذا (هذا.نوع == "ملفات")
                        # شريط التنقل
                        ارسم_مستطيل_أصلي(f، cx، cy، cw، 22، ل_رمادي_ف)
                        ارسم_نص_أصلي(f، cx + 5، cy + 5، "> / > beeos > documents"، 1، ل_أسود)

                        # شريط جانبي
                        متغير fy = cy + 27
                        متغير sw = 140
                        ارسم_مستطيل_أصلي(f، cx، fy، sw، ch - 32، ل_رمادي_ف)
                        ارسم_نص_أصلي(f، cx + 8، fy + 8، "Favorites"، 1، ل_شريط)
                        ارسم_نص_أصلي(f، cx + 15، fy + 26، "Desktop"، 1، ل_أسود)
                        ارسم_نص_أصلي(f، cx + 15، fy + 44، "Documents"، 1، ل_أسود)
                        ارسم_نص_أصلي(f، cx + 15، fy + 62، "Downloads"، 1، ل_أسود)
                        ارسم_نص_أصلي(f، cx + 15، fy + 80، "Pictures"، 1، ل_أسود)
                        ارسم_خط_أصلي(f، cx + 8، fy + 98، cx + sw - 8، fy + 98، ل_رمادي_غ)
                        ارسم_نص_أصلي(f، cx + 8، fy + 106، "Devices"، 1، ل_شريط)
                        ارسم_نص_أصلي(f، cx + 15، fy + 124، "HDD 256GB"، 1، ل_أسود)

                        # محتوى الملفات
                        متغير fx = cx + sw + 5
                        متغير fw = cw - sw - 10
                        ارسم_مستطيل_أصلي(f، fx، fy، fw، ch - 32، ل_أبيض)

                        # عناصر الملفات كقائمة
                        متغير ey = fy + 5
                        # ملف 1 (مجلد محدد)
                        ارسم_مستطيل_أصلي(f، fx + 5، ey، fw - 10، 22، ل_تحديد)
                        ارسم_نص_أصلي(f، fx + 30، ey + 5، "Projects"، 1، ل_أبيض)

                        # ملف 2
                        ey = ey + 26
                        ارسم_نص_أصلي(f، fx + 30، ey + 5، "Notes"، 1، ل_أسود)

                        # ملف 3
                        ey = ey + 26
                        ارسم_نص_أصلي(f، fx + 30، ey + 5، "readme.txt"، 1، ل_رمادي_غ)

                        # ملف 4
                        ey = ey + 26
                        ارسم_نص_أصلي(f، fx + 30، ey + 5، "config.json"، 1، ل_رمادي_غ)

                        # ملف 5
                        ey = ey + 26
                        ارسم_نص_أصلي(f، fx + 30، ey + 5، "kernel.sad"، 1، ل_رمادي_غ)

                        # شريط حالة
                        ارسم_مستطيل_أصلي(f، cx، cy + ch - 5، cw، 15، ل_رمادي_ف)
                        ارسم_نص_أصلي(f، cx + 5، cy + ch - 2، "5 items | 12.4 MB free"، 1، ل_رمادي_غ)

                    والا
                        اذا (هذا.نوع == "طرفية")
                            # خلفية سوداء
                            ارسم_مستطيل_أصلي(f، cx، cy، cw، ch، ل_أسود)

                            # سطور الطرفية
                            ارسم_نص_أصلي(f، cx + 5، cy + 5، "BeeOS Terminal v1.0"، 1، ل_أخضر)
                            ارسم_نص_أصلي(f، cx + 5، cy + 20، "Type 'help' for commands"، 1، ل_رمادي_ف)
                            ارسم_نص_أصلي(f، cx + 5، cy + 40، "root@beeos:~$ uname -a"، 1، ل_أبيض)
                            ارسم_نص_أصلي(f، cx + 5، cy + 55، "BeeOS 1.0.0 Honeycomb HD x86_64"، 1، ل_أصفر)
                            ارسم_نص_أصلي(f، cx + 5، cy + 75، "root@beeos:~$ ls"، 1، ل_أبيض)
                            ارسم_نص_أصلي(f، cx + 5، cy + 90، "bin/  etc/  home/  kernel/  usr/"، 1، ل_أزرق)
                            ارسم_نص_أصلي(f، cx + 5، cy + 110، "root@beeos:~$ free -h"، 1، ل_أبيض)
                            ارسم_نص_أصلي(f، cx + 5، cy + 125، "Total: 512MB  Used: 128MB  Free: 384MB"، 1، ل_أصفر)
                            ارسم_نص_أصلي(f، cx + 5، cy + 145، "root@beeos:~$ _"، 1، ل_أبيض)

                            # مؤشر وامض
                            ارسم_مستطيل_أصلي(f، cx + 135، cy + 145، 8، 12، ل_أخضر)

                        والا
                            # تطبيق عام
                            ارسم_نص_أصلي(f، cx + 20، cy + 30، هذا.نوع، 2، ل_أسود)
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية

        ارجع 1
    نهاية

    # هل النقطة داخل النافذة
    دالة يحتوي(px، py)
        اذا (px >= هذا.nx && px < هذا.nx + هذا.nw)
            اذا (py >= هذا.ny && py < هذا.ny + هذا.nh)
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    # هل النقطة على شريط العنوان
    دالة على_عنوان(px، py)
        اذا (px >= هذا.nx && px < هذا.nx + هذا.nw)
            اذا (py >= هذا.ny && py < هذا.ny + ارت_عنوان)
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    # تحريك
    دالة حرك(dx، dy)
        هذا.nx = هذا.nx + dx
        هذا.ny = هذا.ny + dy
        اذا (هذا.nx < 0)
            هذا.nx = 0
        نهاية
        اذا (هذا.ny < 0)
            هذا.ny = 0
        نهاية
        اذا (هذا.nx + هذا.nw > عرض_شاشة)
            هذا.nx = عرض_شاشة - هذا.nw
        نهاية
        اذا (هذا.ny + هذا.nh > ارت_شاشة - ارت_مهام)
            هذا.ny = ارت_شاشة - ارت_مهام - هذا.nh
        نهاية
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
# صنف مدير سطح المكتب (Desktop Manager)
# ══════════════════════════════════════════════════════════════════════
صنف مدير_سطح_المكتب
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    رقم إجمالي_إطارات
    رقم إجمالي_بكسلات

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.إجمالي_إطارات = 0
        هذا.إجمالي_بكسلات = 0
    نهاية

    # رسم خلفية سطح المكتب مع شعار نحل
    دالة رسم_خلفية()
        متغير ف = هذا.مقبض_خلفي

        # تدرج خلفية من أزرق غامق لأسود
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة - ارت_مهام، ل_شريط، ل_أسود)

        # نمط خلايا نحل (hexagonal pattern)
        متغير hx = 80
        بينما (hx < عرض_شاشة)
            متغير hy = 80
            بينما (hy < ارت_شاشة - ارت_مهام - 100)
                # خلية نحل صغيرة شفافة
                متغير لون_خلية = امزج_لون(ل_أصفر، ل_أسود، 15)
                ارسم_دائرة_أصلي(ف، hx، hy، 25، لون_خلية)
                hy = hy + 120
            نهاية
            hx = hx + 140
        نهاية

        # شعار كبير في المنتصف
        متغير لx = عرض_شاشة / 2 - 80
        متغير لy = ارت_شاشة / 2 - 80

        # جسم النحلة (كرتان)
        ارسم_دائرة_مصمتة(ف، لx + 80، لy + 50، 45، ل_أصفر)
        ارسم_مستطيل_أصلي(ف، لx + 55، لy + 42، 50، 5، ل_أسود)
        ارسم_مستطيل_أصلي(ف، لx + 55، لy + 52، 50، 5، ل_أسود)

        # أجنحة
        ارسم_دائرة_أصلي(ف، لx + 55، لy + 20، 20، ل_أبيض)
        ارسم_دائرة_أصلي(ف، لx + 105، لy + 20، 20، ل_أبيض)

        # نص الشعار
        ارسم_نص_أصلي(ف، لx + 15، لy + 110، "BeeOS HD"، 4، ل_أصفر)
        ارسم_نص_أصلي(ف، لx - 5، لy + 150، "Honeycomb Desktop v1.0"، 2، ل_رمادي_ف)

        ارجع 1
    نهاية

    # رسم شريط المهام
    دالة رسم_شريط_مهام(نوافذ)
        متغير ف = هذا.مقبض_خلفي
        متغير شy = ارت_شاشة - ارت_مهام

        # خلفية شريط المهام
        ارسم_مستطيل_أصلي(ف، 0، شy، عرض_شاشة، ارت_مهام، ل_شريط_مهام)
        ارسم_مستطيل_أصلي(ف، 0، شy، عرض_شاشة، 2، ل_رمادي_غ)

        # زر Start
        ارسم_مستطيل_أصلي(ف، 4، شy + 6، 90، 36، ل_أصفر)
        ارسم_نص_أصلي(ف، 12، شy + 14، "BeeOS"، 2، ل_أسود)

        # أيقونات النوافذ
        متغير أx = 110
        متغير ن = 0
        بينما (ن < طول(نوافذ))
            متغير ن_ف = نوافذ[ن]
            اذا (ن_ف.وضع != و_مغلق)
                اذا (ن_ف.مركزة)
                    ارسم_مستطيل_أصلي(ف، أx، شy + 6، 130، 36، ل_تحديد)
                والا
                    ارسم_مستطيل_أصلي(ف، أx، شy + 6، 130، 36، ل_رمادي_غ)
                نهاية
                ارسم_نص_أصلي(ف، أx + 8، شy + 16، ن_ف.عنوان، 1، ل_أبيض)
                أx = أx + 140
            نهاية
            ن = ن + 1
        نهاية

        # منطقة الإشعارات (يمين)
        ارسم_مستطيل_أصلي(ف، عرض_شاشة - 200، شy + 6، 190، 36، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، عرض_شاشة - 190، شy + 10، "CPU: 12%  RAM: 25%"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، عرض_شاشة - 130، شy + 26، "12:00 PM"، 1، ل_أصفر)
    نهاية

    # تركيب إطار كامل
    دالة تركيب(نوافذ، ماوس)
        هذا.إجمالي_إطارات = هذا.إجمالي_إطارات + 1
        متغير px_total = 0

        # 1. رسم الخلفية
        هذا.رسم_خلفية()

        # 2. رسم النوافذ بترتيب z
        متغير z = 0
        بينما (z < طول(نوافذ))
            متغير ن = 0
            بينما (ن < طول(نوافذ))
                متغير ن_ف = نوافذ[ن]
                اذا (ن_ف.ترتيب == z && ن_ف.وضع == و_عادي)
                    # رسم النافذة
                    ن_ف.رسم_إطار()
                    ن_ف.رسم_محتوى()

                    # blit للمخزن الخلفي
                    متغير بك = انسخ_منطقة(ن_ف.مقبض، هذا.مقبض_خلفي، 0، 0، ن_ف.nx، ن_ف.ny، ن_ف.nw، ن_ف.nh)
                    px_total = px_total + بك
                نهاية
                ن = ن + 1
            نهاية
            z = z + 1
        نهاية

        # 3. شريط المهام
        هذا.رسم_شريط_مهام(نوافذ)

        # 4. مؤشر الماوس
        متغير مؤشر_بك = ماوس.رسم_مؤشر(هذا.مقبض_خلفي)
        px_total = px_total + مؤشر_بك

        # 5. تبديل المخازن
        انسخ_منطقة(هذا.مقبض_خلفي، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)

        هذا.إجمالي_بكسلات = هذا.إجمالي_بكسلات + px_total
        ارجع px_total
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

