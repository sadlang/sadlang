# ══════════════════════════════════════════════════════════════════════════════
# مدير_المهام.ص - تطبيق مدير المهام لنظام خلية النحل
# BeeOS Task Manager - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

# ألوان
متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296

# ──────────────────────────────────────────────────────────────────
# صنف عملية
# ──────────────────────────────────────────────────────────────────
صنف عملية_نظام
    نص اسم
    رقم معرف_عملية
    رقم استخدام_معالج
    رقم استخدام_ذاكرة
    نص وضع_عملية
    رقم أولوية

    باني(اسم_ع، معرف، معالج، ذاكرة، وضع، أول)
        هذا.اسم = اسم_ع
        هذا.معرف_عملية = معرف
        هذا.استخدام_معالج = معالج
        هذا.استخدام_ذاكرة = ذاكرة
        هذا.وضع_عملية = وضع
        هذا.أولوية = أول
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# صنف مدير المهام
# ──────────────────────────────────────────────────────────────────
صنف مدير_مهام
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    مصفوفة عمليات
    رقم عملية_محددة
    رقم تبويب_حالي
    رقم نافذة_x
    رقم نافذة_y
    رقم نافذة_ع
    رقم نافذة_ا
    رقم إجمالي_معالج
    رقم إجمالي_ذاكرة

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.عملية_محددة = -1
        هذا.تبويب_حالي = 0
        هذا.نافذة_x = 150
        هذا.نافذة_y = 60
        هذا.نافذة_ع = 1100
        هذا.نافذة_ا = 750

        هذا.عمليات = []
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("queen_kernel", 1, 2, 48, "Running", 10)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("memory_mgr", 2, 1, 32, "Running", 9)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("scheduler", 3, 3, 16, "Running", 9)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("file_system", 4, 1, 24, "Running", 8)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("desktop_mgr", 5, 12, 128, "Running", 7)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("window_mgr", 6, 8, 64, "Running", 7)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("graphics_hd", 7, 22, 256, "Running", 8)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("browser", 8, 15, 180, "Running", 5)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("calculator", 9, 1, 8, "Running", 5)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("editor", 10, 5, 45, "Running", 5)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("terminal", 11, 3, 20, "Running", 5)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("settings", 12, 2, 15, "Running", 4)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("task_manager", 13, 4, 22, "Running", 4)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("mouse_driver", 14, 1, 4, "Running", 9)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("kbd_driver", 15, 1, 4, "Running", 9)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("network_svc", 16, 2, 12, "Sleeping", 6)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("audio_svc", 17, 0, 8, "Sleeping", 6)]
        هذا.عمليات = هذا.عمليات + [جديد عملية_نظام("notif_daemon", 18, 0, 6, "Sleeping", 4)]

        # حساب الإجمالي
        هذا.إجمالي_معالج = 0
        هذا.إجمالي_ذاكرة = 0
        متغير ت = 0
        بينما (ت < طول(هذا.عمليات))
            متغير ع = هذا.عمليات[ت]
            هذا.إجمالي_معالج = هذا.إجمالي_معالج + ع.استخدام_معالج
            هذا.إجمالي_ذاكرة = هذا.إجمالي_ذاكرة + ع.استخدام_ذاكرة
            ت = ت + 1
        نهاية
    نهاية

    # رسم شريط التبويبات
    دالة رسم_تبويبات(ف)
        متغير tx = هذا.نافذة_x + 2
        متغير ty = هذا.نافذة_y + 32

        مصفوفة تبويبات = ["Processes", "Performance", "Details"]
        متغير ت = 0
        بينما (ت < طول(تبويبات))
            متغير tw = 120
            متغير تب_x = tx + ت * tw
            اذا (هذا.تبويب_حالي == ت)
                ارسم_مستطيل_أصلي(ف، تب_x، ty، tw، 28، امزج_لون(ل_أصفر، ل_أسود، 50))
                ارسم_نص_أصلي(ف، تب_x + 10، ty + 8، تبويبات[ت]، 1، ل_أصفر)
            والا
                ارسم_مستطيل_أصلي(ف، تب_x، ty، tw، 28، ل_رمادي_غ)
                ارسم_نص_أصلي(ف، تب_x + 10، ty + 8، تبويبات[ت]، 1، ل_أبيض)
            نهاية
            ت = ت + 1
        نهاية

        ارسم_خط_أصلي(ف، tx، ty + 28، tx + هذا.نافذة_ع - 4، ty + 28، ل_رمادي_غ)

        ارجع 1
    نهاية

    # شريط CPU بصري
    دالة رسم_شريط_استخدام(ف، x، y، عرض_ش، نسبة، لون_ش)
        ارسم_مستطيل_أصلي(ف، x، y، عرض_ش، 14، ل_رمادي_غ)
        متغير ملو = عرض_ش * نسبة / 100
        اذا (ملو > عرض_ش)
            ملو = عرض_ش
        نهاية
        اذا (ملو > 0)
            ارسم_مستطيل_أصلي(ف، x، y، ملو، 14، لون_ش)
        نهاية
        ارجع 1
    نهاية

    # تبويب العمليات
    دالة رسم_عمليات(ف)
        متغير bx = هذا.نافذة_x + 10
        متغير by = هذا.نافذة_y + 68

        # رأس الجدول
        ارسم_مستطيل_أصلي(ف، bx، by، هذا.نافذة_ع - 20، 22، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، bx + 10، by + 4، "Name"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، bx + 250، by + 4، "PID"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، bx + 330، by + 4، "CPU %"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، bx + 500، by + 4، "Memory MB"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، bx + 700، by + 4، "Status"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، bx + 850، by + 4، "Priority"، 1، ل_أبيض)

        by = by + 25

        # صفوف العمليات
        متغير ت = 0
        بينما (ت < طول(هذا.عمليات))
            متغير ع = هذا.عمليات[ت]
            متغير ry = by + ت * 24

            اذا (ry > هذا.نافذة_y + هذا.نافذة_ا - 80)
                اخرج
            نهاية

            # تظليل الصف المحدد
            اذا (ت == هذا.عملية_محددة)
                ارسم_مستطيل_أصلي(ف، bx، ry، هذا.نافذة_ع - 20، 22، امزج_لون(ل_أصفر، ل_أسود، 60))
            والا
                اذا (ت % 2 == 0)
                    ارسم_مستطيل_أصلي(ف، bx، ry، هذا.نافذة_ع - 20، 22، امزج_لون(ل_أسود، ل_أزرق_غ، 15))
                نهاية
            نهاية

            # بيانات العملية
            ارسم_نص_أصلي(ف، bx + 10، ry + 4، ع.اسم، 1، ل_أبيض)
            ارسم_نص_أصلي(ف، bx + 250، ry + 4، "" + ع.معرف_عملية، 1، ل_رمادي)

            # شريط CPU
            هذا.رسم_شريط_استخدام(ف، bx + 330، ry + 4، 120، ع.استخدام_معالج، ل_أخضر)
            ارسم_نص_أصلي(ف، bx + 460، ry + 4، "" + ع.استخدام_معالج + "%"، 1، ل_أبيض)

            # شريط ذاكرة
            متغير نسبة_ذاكرة = ع.استخدام_ذاكرة * 100 / 1024
            هذا.رسم_شريط_استخدام(ف، bx + 500، ry + 4، 120، نسبة_ذاكرة، ل_أزرق_غ)
            ارسم_نص_أصلي(ف، bx + 630، ry + 4، "" + ع.استخدام_ذاكرة + " MB"، 1، ل_أبيض)

            # الحالة
            متغير لون_وضع = ل_أخضر
            اذا (ع.وضع_عملية == "Sleeping")
                لون_وضع = ل_رمادي
            نهاية
            ارسم_دائرة_مصمتة(ف، bx + 710، ry + 11، 4، لون_وضع)
            ارسم_نص_أصلي(ف، bx + 720، ry + 4، ع.وضع_عملية، 1، ل_أبيض)

            # الأولوية
            ارسم_نص_أصلي(ف، bx + 870، ry + 4، "" + ع.أولوية، 1، ل_رمادي)

            ت = ت + 1
        نهاية

        # شريط الملخص أسفل
        متغير ملخص_y = هذا.نافذة_y + هذا.نافذة_ا - 45
        ارسم_خط_أصلي(ف، bx، ملخص_y، bx + هذا.نافذة_ع - 20، ملخص_y، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، bx + 10، ملخص_y + 10، "Processes: " + طول(هذا.عمليات)، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، bx + 200، ملخص_y + 10، "CPU: " + هذا.إجمالي_معالج + "%"، 1، ل_أخضر)
        ارسم_نص_أصلي(ف، bx + 400، ملخص_y + 10، "Memory: " + هذا.إجمالي_ذاكرة + " MB / 1024 MB"، 1، ل_أزرق_غ)

        # زر إنهاء عملية
        ارسم_مستطيل_أصلي(ف، bx + هذا.نافذة_ع - 180، ملخص_y + 5، 140، 28، ل_أحمر)
        ارسم_نص_أصلي(ف، bx + هذا.نافذة_ع - 170، ملخص_y + 10، "End Process"، 1، ل_أبيض)

        ارجع 1
    نهاية

    # تبويب الأداء
    دالة رسم_أداء(ف)
        متغير bx = هذا.نافذة_x + 20
        متغير by = هذا.نافذة_y + 70
        متغير bw = هذا.نافذة_ع - 40

        # CPU
        ارسم_نص_أصلي(ف، bx، by، "CPU Usage"، 2، ل_أخضر)
        ارسم_نص_أصلي(ف، bx + 300، by، "" + هذا.إجمالي_معالج + "%"، 3، ل_أخضر)

        # رسم بياني CPU
        متغير رسم_y = by + 35
        ارسم_مستطيل_أصلي(ف، bx، رسم_y، 500، 150، ل_أسود)
        ارسم_إطار_أصلي(ف، bx، رسم_y، 500، 150، 1، ل_رمادي_غ)

        # خطوط شبكة أفقية
        متغير خط = 1
        بينما (خط < 4)
            متغير خط_y = رسم_y + خط * 37
            ارسم_خط_أصلي(ف، bx + 1، خط_y، bx + 499، خط_y، امزج_لون(ل_رمادي_غ، ل_أسود، 70))
            خط = خط + 1
        نهاية

        # بيانات CPU (محاكاة تاريخية)
        مصفوفة cpu_data = [35, 42, 38, 55, 78, 65, 45, 52, 60, 40, 48, 75, 62, 50, 55, 80, 70, 45, 50, 81]
        متغير نقطة = 0
        بينما (نقطة < طول(cpu_data) - 1)
            متغير x1 = bx + نقطة * 25
            متغير x2 = bx + (نقطة + 1) * 25
            متغير y1 = رسم_y + 150 - cpu_data[نقطة] * 150 / 100
            متغير y2 = رسم_y + 150 - cpu_data[نقطة + 1] * 150 / 100
            ارسم_خط_أصلي(ف، x1، y1، x2، y2، ل_أخضر)
            ارسم_خط_أصلي(ف، x1، y1 + 1، x2، y2 + 1، ل_أخضر)
            نقطة = نقطة + 1
        نهاية

        # Memory
        متغير my = رسم_y + 180
        ارسم_نص_أصلي(ف، bx، my، "Memory Usage"، 2، ل_أزرق_غ)
        ارسم_نص_أصلي(ف، bx + 300، my، "" + هذا.إجمالي_ذاكرة + " / 1024 MB"، 2، ل_أزرق_غ)

        # رسم بياني ذاكرة
        متغير رسم_y2 = my + 35
        ارسم_مستطيل_أصلي(ف، bx، رسم_y2، 500، 150، ل_أسود)
        ارسم_إطار_أصلي(ف، bx، رسم_y2، 500، 150، 1، ل_رمادي_غ)

        # ملء لمستوى الذاكرة
        متغير نسبة_ذاكرة = هذا.إجمالي_ذاكرة * 100 / 1024
        متغير ارتفاع_ملء = 150 * نسبة_ذاكرة / 100
        ارسم_مستطيل_أصلي(ف، bx + 1، رسم_y2 + 150 - ارتفاع_ملء، 498، ارتفاع_ملء، امزج_لون(ل_أزرق_غ، ل_أسود، 50))

        # معلومات جانبية
        متغير ix = bx + 550
        ارسم_نص_أصلي(ف، ix، by + 40، "Cores: 4"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، ix، by + 65، "Total RAM: 1024 MB"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، ix، by + 90، "Used RAM: " + هذا.إجمالي_ذاكرة + " MB"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، ix، by + 115، "Free RAM: " + (1024 - هذا.إجمالي_ذاكرة) + " MB"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، ix، by + 150، "Processes: " + طول(هذا.عمليات)، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، ix، by + 175، "Uptime: 2h 15m"، 1، ل_أبيض)

        ارجع 1
    نهاية

    # الرسم الكامل
    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        # خلفية
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)

        # شريط المهام
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، امزج_لون(ل_أسود، ل_أزرق_غ، 30))

        # نافذة مدير المهام
        متغير nx = هذا.نافذة_x
        متغير ny = هذا.نافذة_y
        متغير nw = هذا.نافذة_ع
        متغير nh = هذا.نافذة_ا

        ارسم_مستطيل_أصلي(ف، nx، ny، nw، nh، امزج_لون(ل_أسود، ل_أزرق_غ، 20))
        ارسم_إطار_أصلي(ف، nx، ny، nw، nh، 2، ل_رمادي)

        # شريط العنوان
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، 30، امزج_لون(ل_أسود، ل_رمادي_غ، 50))
        ارسم_نص_أصلي(ف، nx + 10، ny + 8، "Task Manager"، 1، ل_أبيض)

        # أزرار النافذة
        ارسم_مستطيل_أصلي(ف، nx + nw - 30، ny + 5، 20، 20، ل_أحمر)
        ارسم_نص_أصلي(ف، nx + nw - 25، ny + 8، "X"، 1، ل_أبيض)

        # التبويبات
        هذا.رسم_تبويبات(ف)

        # المحتوى
        اذا (هذا.تبويب_حالي == 0)
            هذا.رسم_عمليات(ف)
        والا
            اذا (هذا.تبويب_حالي == 1)
                هذا.رسم_أداء(ف)
            نهاية
        نهاية

        # swap
        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)

        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS Task Manager ===")
    اطبع_سطر("")

    متغير مدير = جديد مدير_مهام()
    اطبع_سطر("[TASKMGR] Initialized with " + طول(مدير.عمليات) + " processes")
    اطبع_سطر("[TASKMGR] Total CPU: " + مدير.إجمالي_معالج + "%, Total RAM: " + مدير.إجمالي_ذاكرة + " MB")

    # إطار 1: تبويب العمليات
    اطبع_سطر("")
    اطبع_سطر("-- Frame 1: Processes tab --")
    مدير.تبويب_حالي = 0
    مدير.رسم(1)
    مدير.تصدير("C:\\beeos_taskmgr_proc.ppm")
    اطبع_سطر("  Exported: processes view")

    # إطار 2: تحديد عملية
    اطبع_سطر("")
    اطبع_سطر("-- Frame 2: Process selected --")
    مدير.عملية_محددة = 7
    مدير.رسم(2)
    اطبع_سطر("  Selected: " + مدير.عمليات[7].اسم)

    # إطار 3: تبويب الأداء
    اطبع_سطر("")
    اطبع_سطر("-- Frame 3: Performance tab --")
    مدير.تبويب_حالي = 1
    مدير.رسم(3)
    مدير.تصدير("C:\\beeos_taskmgr_perf.ppm")
    اطبع_سطر("  Exported: performance view")

    # إحصائيات
    اطبع_سطر("")
    متغير أسود = عد_بكسلات(مدير.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("  Total pixels: ")
    اطبع_سطر(إجمالي)
    اطبع("  Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("")
    اطبع_سطر("=== Task Manager: SUCCESS ===")

    ارجع 0
نهاية
