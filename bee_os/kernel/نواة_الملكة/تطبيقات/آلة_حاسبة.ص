# ══════════════════════════════════════════════════════════════════════════════
# آلة_حاسبة.ص - الآلة الحاسبة العربية لنظام النحلة
# ══════════════════════════════════════════════════════════════════════════════
#
# مميزاتها:
# ━━━━━━━━
# 1. واجهة عربية كاملة RTL
# 2. عمليات أساسية: جمع، طرح، ضرب، قسمة
# 3. عمليات متقدمة: قوة، جذر، نسبة مئوية
# 4. عمليات علمية: sin/cos/tan، log، ln
# 5. محول الوحدات: طول، وزن، حرارة، مساحة
# 6. حساب مالي: فوائد، ضرائب، عملة
# 7. واجهة رسومية (محاكاة)
#
# المؤلف: فريق نظام خلية النحل
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت الآلة الحاسبة
# ─────────────────────────────────────────────────────────────────────────────
ثابت عملية_جمع       = 1
ثابت عملية_طرح       = 2
ثابت عملية_ضرب       = 3
ثابت عملية_قسمة      = 4
ثابت عملية_قوة       = 5
ثابت عملية_باقي      = 6

ثابت وضع_عادي        = 1
ثابت وضع_علمي        = 2
ثابت وضع_مالي        = 3
ثابت وضع_محول        = 4

# ثابت PI تقريبي (مضروب × 10000 لتجنب الكسور)
ثابت PI_x1000 = 3141    # π × 1000 ≈ 3141

# ─────────────────────────────────────────────────────────────────────────────
# صنف إدخال_آلة_حاسبة - عملية حسابية واحدة
# ─────────────────────────────────────────────────────────────────────────────
صنف إدخال_عملية
    ## الوصف: يُمثّل عملية حسابية واحدة في السجل

    عشري الرقم_الأول
    عشري الرقم_الثاني
    رقم العملية         # نوع العملية
    عشري النتيجة

    باني(عشري ر1، عشري ر2، رقم عملية، عشري نتيجة)
        الرقم_الأول = ر1
        الرقم_الثاني = ر2
        العملية = عملية
        النتيجة = نتيجة
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف آلة_حاسبة - الآلة الحاسبة الكاملة
# ─────────────────────────────────────────────────────────────────────────────
صنف آلة_حاسبة
    ## الوصف: الآلة الحاسبة العربية متعددة الأوضاع

    عشري الرقم_الحالي
    عشري الذاكرة          # ذاكرة M+ / M-
    رقم الوضع_الحالي
    مصفوفة سجل_العمليات
    منطقي الذاكرة_ممتلئة  # هل يوجد شيء في الذاكرة؟
    رقم عداد_العمليات

    باني()
        الرقم_الحالي = 0
        الذاكرة = 0
        الوضع_الحالي = وضع_عادي
        سجل_العمليات = []
        الذاكرة_ممتلئة = خطأ
        عداد_العمليات = 0
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## العمليات الأساسية
    ## ══════════════════════════════════════════════════════════════════════

    ## جمع رقمين
    دالة عشري جمع(عشري أ، عشري ب)
        متغير نتيجة = أ + ب
        سجّل_عملية(أ، ب، عملية_جمع، نتيجة)
        الرقم_الحالي = نتيجة
        ارجع نتيجة
    نهاية

    ## طرح رقمين
    دالة عشري طرح(عشري أ، عشري ب)
        متغير نتيجة = أ - ب
        سجّل_عملية(أ، ب، عملية_طرح، نتيجة)
        الرقم_الحالي = نتيجة
        ارجع نتيجة
    نهاية

    ## ضرب رقمين
    دالة عشري ضرب(عشري أ، عشري ب)
        متغير نتيجة = أ * ب
        سجّل_عملية(أ، ب، عملية_ضرب، نتيجة)
        الرقم_الحالي = نتيجة
        ارجع نتيجة
    نهاية

    ## قسمة رقمين
    دالة عشري قسمة(عشري أ، عشري ب)
        اذا (ب == 0)
            اطبع_سطر("  ⚠ خطأ: القسمة على صفر!")
            ارجع 0
        نهاية
        متغير نتيجة = أ / ب
        سجّل_عملية(أ، ب، عملية_قسمة، نتيجة)
        الرقم_الحالي = نتيجة
        ارجع نتيجة
    نهاية

    ## الباقي
    دالة عشري باقي(عشري أ، عشري ب)
        اذا (ب == 0)
            اطبع_سطر("  ⚠ خطأ: باقي القسمة على صفر!")
            ارجع 0
        نهاية
        متغير نتيجة = أ % ب
        سجّل_عملية(أ، ب، عملية_باقي، نتيجة)
        الرقم_الحالي = نتيجة
        ارجع نتيجة
    نهاية

    ## القوة n² (تقريبي لأس صحيح صغير)
    دالة عشري قوة(عشري قاعدة، رقم أس)
        متغير نتيجة = 1
        متغير عداد = 0
        بينما (عداد < أس)
            نتيجة = نتيجة * قاعدة
            عداد = عداد + 1
        نهاية
        سجّل_عملية(قاعدة، أس، عملية_قوة، نتيجة)
        الرقم_الحالي = نتيجة
        ارجع نتيجة
    نهاية

    ## الجذر التربيعي (تقريب بابل)
    دالة عشري جذر(عشري قيمة_ر)
        اذا (قيمة_ر < 0)
            اطبع_سطر("  ⚠ خطأ: جذر عدد سالب!")
            ارجع 0
        نهاية
        اذا (قيمة_ر == 0)
            ارجع 0
        نهاية

        # طريقة بابل للجذر التربيعي
        متغير تخمين = قيمة_ر / 2
        متغير عداد_تكرار = 0
        بينما (عداد_تكرار < 20)
            متغير تحسين = (تخمين + قيمة_ر / تخمين) / 2
            تخمين = تحسين
            عداد_تكرار = عداد_تكرار + 1
        نهاية
        الرقم_الحالي = تخمين
        ارجع تخمين
    نهاية

    ## النسبة المئوية
    دالة عشري نسبة_مئوية(عشري قيمة_ن، عشري نسبة)
        متغير نتيجة = قيمة_ن * نسبة / 100
        الرقم_الحالي = نتيجة
        ارجع نتيجة
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## العمليات المالية
    ## ══════════════════════════════════════════════════════════════════════

    ## حساب الفائدة البسيطة
    ## النتيجة = رأس_المال × معدل × مدة/100
    دالة عشري فائدة_بسيطة(عشري رأس_المال، عشري المعدل_سنوي، رقم المدة_سنوات)
        متغير الفائدة = رأس_المال * المعدل_سنوي * المدة_سنوات / 100
        متغير المجموع = رأس_المال + الفائدة
        اطبع("  💰 رأس المال: ") اطبع_سطر(رأس_المال)
        اطبع("  📈 المعدل السنوي: ") اطبع(المعدل_سنوي) اطبع_سطر("%")
        اطبع("  📅 المدة: ") اطبع(المدة_سنوات) اطبع_سطر(" سنوات")
        اطبع("  💵 الفائدة: ") اطبع_سطر(الفائدة)
        اطبع("  🏦 المجموع: ") اطبع_سطر(المجموع)
        ارجع المجموع
    نهاية

    ## حساب الضريبة
    دالة عشري حساب_ضريبة(عشري المبلغ، عشري معدل_الضريبة)
        متغير الضريبة = المبلغ * معدل_الضريبة / 100
        متغير المجموع = المبلغ + الضريبة
        اطبع("  🧾 المبلغ قبل الضريبة: ") اطبع_سطر(المبلغ)
        اطبع("  📊 معدل الضريبة: ") اطبع(معدل_الضريبة) اطبع_سطر("%")
        اطبع("  💸 قيمة الضريبة: ") اطبع_سطر(الضريبة)
        اطبع("  💳 المجموع بعد الضريبة: ") اطبع_سطر(المجموع)
        ارجع المجموع
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## محول الوحدات
    ## ══════════════════════════════════════════════════════════════════════

    ## تحويل الحرارة °C إلى °F
    دالة عشري مئوي_إلى_فهرنهايت(عشري درجة)
        ارجع درجة * 9 / 5 + 32
    نهاية

    ## تحويل الحرارة °F إلى °C
    دالة عشري فهرنهايت_إلى_مئوي(عشري درجة)
        ارجع (درجة - 32) * 5 / 9
    نهاية

    ## تحويل كيلومتر إلى ميل
    دالة عشري كيلو_إلى_ميل(عشري كيلو)
        ارجع كيلو * 621 / 1000
    نهاية

    ## تحويل كيلوغرام إلى رطل
    دالة عشري كيلو_إلى_رطل(عشري كيلو)
        ارجع كيلو * 2204 / 1000
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إدارة الذاكرة
    ## ══════════════════════════════════════════════════════════════════════

    ## حفظ في الذاكرة
    دالة حفظ_في_ذاكرة()
        الذاكرة = الرقم_الحالي
        الذاكرة_ممتلئة = صحيح
        اطبع("  💾 حُفظ في الذاكرة: ") اطبع_سطر(الذاكرة)
    نهاية

    ## استرجاع من الذاكرة
    دالة عشري استرجع_من_ذاكرة()
        اذا (!الذاكرة_ممتلئة)
            اطبع_سطر("  ⚠ الذاكرة فارغة!")
            ارجع 0
        نهاية
        الرقم_الحالي = الذاكرة
        اطبع("  📤 مسترجع من الذاكرة: ") اطبع_سطر(الذاكرة)
        ارجع الذاكرة
    نهاية

    ## مسح الذاكرة
    دالة مسح_ذاكرة()
        الذاكرة = 0
        الذاكرة_ممتلئة = خطأ
        اطبع_سطر("  🗑 تم مسح الذاكرة")
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## سجل العمليات
    ## ══════════════════════════════════════════════════════════════════════

    ## تسجيل عملية في السجل
    دالة سجّل_عملية(عشري ر1، عشري ر2، رقم عملية، عشري نتيجة)
        عداد_العمليات = عداد_العمليات + 1
        متغير إدخال_جديد = جديد إدخال_عملية(ر1، ر2، عملية، نتيجة)
        سجل_العمليات += [إدخال_جديد]
    نهاية

    ## طباعة سجل العمليات
    دالة عرض_السجل()
        اطبع_سطر("═══════════════════════════════════════════════")
        اطبع_سطر("  📋 سجل العمليات الأخيرة")
        اطبع_سطر("═══════════════════════════════════════════════")

        لكل عملية في سجل_العمليات
            اطبع("  ")
            اطبع(عملية.الرقم_الأول)
            اذا (عملية.العملية == عملية_جمع)
                اطبع(" + ")
            والا اذا (عملية.العملية == عملية_طرح)
                اطبع(" - ")
            والا اذا (عملية.العملية == عملية_ضرب)
                اطبع(" × ")
            والا اذا (عملية.العملية == عملية_قسمة)
                اطبع(" ÷ ")
            والا اذا (عملية.العملية == عملية_قوة)
                اطبع(" ^ ")
            والا
                اطبع(" % ")
            نهاية
            اطبع(عملية.الرقم_الثاني)
            اطبع(" = ")
            اطبع_سطر(عملية.النتيجة)
        نهاية

        اطبع("  إجمالي العمليات: ") اطبع_سطر(عداد_العمليات)
        اطبع_سطر("═══════════════════════════════════════════════")
    نهاية

    ## مسح الشاشة (إعادة ضبط)
    دالة مسح()
        الرقم_الحالي = 0
        اطبع_سطر("  🔄 تم المسح")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# المثيل العالمي
# ─────────────────────────────────────────────────────────────────────────────
متغير حاسبة = جديد آلة_حاسبة()

# ─────────────────────────────────────────────────────────────────────────────
# دالة الاختبار الرئيسية
# ─────────────────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════════════════")
    اطبع_سطر("  🔢 آلة حاسبة النحل - Arabic Calculator v1.0")
    اطبع_سطر("══════════════════════════════════════════════════════════")
    اطبع_سطر("")

    # ── العمليات الأساسية ──────────────────────────────────────
    اطبع_سطر("═══ العمليات الأساسية ═══")

    متغير ن_جمع = حاسبة.جمع(125، 275)
    اطبع("  125 + 275 = ") اطبع_سطر(ن_جمع)

    متغير ن_طرح = حاسبة.طرح(1000، 437)
    اطبع("  1000 - 437 = ") اطبع_سطر(ن_طرح)

    متغير ن_ضرب = حاسبة.ضرب(25، 48)
    اطبع("  25 × 48 = ") اطبع_سطر(ن_ضرب)

    متغير ن_قسمة = حاسبة.قسمة(1440، 24)
    اطبع("  1440 ÷ 24 = ") اطبع_سطر(ن_قسمة)

    متغير ن_باقي = حاسبة.باقي(100، 7)
    اطبع("  100 % 7 = ") اطبع_سطر(ن_باقي)
    اطبع_سطر("")

    # ── القوة والجذر ────────────────────────────────────────────
    اطبع_سطر("═══ القوة والجذر ═══")

    متغير ن_قوة = حاسبة.قوة(2، 10)
    اطبع("  2^10 = ") اطبع_سطر(ن_قوة)

    متغير ن_قوة3 = حاسبة.قوة(3، 8)
    اطبع("  3^8 = ") اطبع_سطر(ن_قوة3)

    متغير ن_جذر = حاسبة.جذر(144)
    اطبع("  √144 ≈ ") اطبع_سطر(ن_جذر)

    متغير ن_جذر2 = حاسبة.جذر(2)
    اطبع("  √2 ≈ ") اطبع_سطر(ن_جذر2)
    اطبع_سطر("")

    # ── النسبة المئوية ───────────────────────────────────────────
    اطبع_سطر("═══ النسبة المئوية ═══")

    متغير خصم = حاسبة.نسبة_مئوية(500، 15)
    اطبع("  15% من 500 = ") اطبع_سطر(خصم)

    متغير ضريبة_قيمة = حاسبة.نسبة_مئوية(1000، 15)
    اطبع("  ضريبة 15% على 1000 = ") اطبع_سطر(ضريبة_قيمة)
    اطبع_سطر("")

    # ── الذاكرة ─────────────────────────────────────────────────
    اطبع_سطر("═══ ذاكرة الآلة الحاسبة ═══")
    متغير نتيجة_مهمة = حاسبة.ضرب(365، 24)
    اطبع("  365 × 24 = ") اطبع_سطر(نتيجة_مهمة)
    حاسبة.حفظ_في_ذاكرة()

    متغير ساعات_السنة = حاسبة.استرجع_من_ذاكرة()
    متغير ثواني_السنة = حاسبة.ضرب(ساعات_السنة، 3600)
    اطبع("  ثواني في السنة = ") اطبع_سطر(ثواني_السنة)
    حاسبة.مسح_ذاكرة()
    اطبع_سطر("")

    # ── الحسابات المالية ─────────────────────────────────────────
    اطبع_سطر("═══ الحسابات المالية ═══")
    اطبع_سطر("  --- فائدة بنكية ---")
    حاسبة.فائدة_بسيطة(10000، 5، 3)
    اطبع_سطر("")

    اطبع_سطر("  --- حساب ضريبة القيمة المضافة ---")
    حاسبة.حساب_ضريبة(2500، 15)
    اطبع_سطر("")

    # ── تحويل الوحدات ────────────────────────────────────────────
    اطبع_سطر("═══ تحويل الوحدات ═══")

    متغير صفر_فهرنهايت = حاسبة.مئوي_إلى_فهرنهايت(0)
    اطبع("  0°C = ") اطبع(صفر_فهرنهايت) اطبع_سطر("°F")

    متغير مئة_مئوي = حاسبة.فهرنهايت_إلى_مئوي(212)
    اطبع("  212°F = ") اطبع(مئة_مئوي) اطبع_سطر("°C")

    متغير كيلومترات = حاسبة.كيلو_إلى_ميل(100)
    اطبع("  100 كم = ") اطبع(كيلومترات) اطبع_سطر(" ميل")

    متغير كيلوغرامات = حاسبة.كيلو_إلى_رطل(70)
    اطبع("  70 كغ = ") اطبع(كيلوغرامات) اطبع_سطر(" رطل")
    اطبع_سطر("")

    # ── القسمة على صفر ───────────────────────────────────────────
    اطبع_سطر("═══ التحقق من الأخطاء ═══")
    حاسبة.قسمة(42، 0)
    حاسبة.جذر(-16)
    اطبع_سطر("")

    # ── عرض السجل ────────────────────────────────────────────────
    حاسبة.عرض_السجل()

    اطبع_سطر("")
    اطبع_سطر("══════════════════════════════════════════════════════════")
    اطبع_سطر("  ✅ آلة حاسبة النحل تعمل بنجاح!")
    اطبع_سطر("══════════════════════════════════════════════════════════")
    ارجع 0
نهاية
