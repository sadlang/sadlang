# ══════════════════════════════════════════════════════════════════════════════
# مراقب_النظام.ص - تطبيق مراقبة موارد النظام
# BeeOS System Monitor - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296
متغير ل_بنفسجي  = -6750208

صنف مراقب_نظام
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    رقم نافذة_x
    رقم نافذة_y
    رقم نافذة_ع
    رقم نافذة_ا
    مصفوفة تاريخ_معالج
    مصفوفة تاريخ_ذاكرة
    رقم معالج_حالي
    رقم ذاكرة_حالية
    رقم درجة_حرارة
    رقم سرعة_شبكة
    رقم مساحة_قرص

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.نافذة_x = 100
        هذا.نافذة_y = 40
        هذا.نافذة_ع = 1200
        هذا.نافذة_ا = 780

        هذا.تاريخ_معالج = [25, 30, 45, 55, 42, 38, 60, 72, 65, 48, 35, 42, 55, 70, 82, 75, 58, 45, 50, 62]
        هذا.تاريخ_ذاكرة = [40, 42, 43, 45, 48, 50, 52, 55, 56, 58, 60, 62, 63, 65, 66, 67, 68, 70, 71, 72]

        هذا.معالج_حالي = 62
        هذا.ذاكرة_حالية = 72
        هذا.درجة_حرارة = 58
        هذا.سرعة_شبكة = 45
        هذا.مساحة_قرص = 66
    نهاية

    # رسم بياني خطي
    دالة رسم_بياني(ف، gx، gy، gw، gh، بيانات، لون_خط، عنوان)
        # خلفية الرسم
        ارسم_مستطيل_أصلي(ف، gx، gy، gw، gh، ل_أسود)
        ارسم_إطار_أصلي(ف، gx، gy، gw، gh، 1، ل_رمادي_غ)

        # عنوان
        ارسم_نص_أصلي(ف، gx + 5، gy - 15، عنوان، 1، لون_خط)

        # خطوط الشبكة
        متغير خط = 1
        بينما (خط < 4)
            متغير خط_y = gy + خط * gh / 4
            ارسم_خط_أصلي(ف، gx + 1، خط_y، gx + gw - 1، خط_y، امزج_لون(ل_رمادي_غ، ل_أسود، 70))
            خط = خط + 1
        نهاية

        # رسم البيانات
        متغير عدد_نقاط = طول(بيانات)
        اذا (عدد_نقاط < 2)
            ارجع 0
        نهاية

        متغير خطوة_x = gw / (عدد_نقاط - 1)
        متغير نق = 0
        بينما (نق < عدد_نقاط - 1)
            متغير x1 = gx + نق * خطوة_x
            متغير x2 = gx + (نق + 1) * خطوة_x
            متغير y1 = gy + gh - بيانات[نق] * gh / 100
            متغير y2 = gy + gh - بيانات[نق + 1] * gh / 100
            ارسم_خط_أصلي(ف، x1، y1، x2، y2، لون_خط)
            ارسم_خط_أصلي(ف، x1، y1 + 1، x2، y2 + 1، لون_خط)

            # تعبئة تحت الخط
            متغير لون_تعبئة = امزج_لون(لون_خط، ل_أسود، 75)
            ارسم_خط_أصلي(ف، x1، y1، x1، gy + gh - 1، لون_تعبئة)

            نق = نق + 1
        نهاية

        ارجع 1
    نهاية

    # رسم مقياس دائري
    دالة رسم_مقياس(ف، cx، cy، نصف_قطر، نسبة، لون_م، تسمية)
        # الدائرة الخارجية
        ارسم_دائرة_أصلي(ف، cx، cy، نصف_قطر، ل_رمادي_غ)
        ارسم_دائرة_أصلي(ف، cx، cy، نصف_قطر - 1، ل_رمادي_غ)

        # قوس الملء (مبسط بخطوط)
        متغير زاوية = 0
        بينما (زاوية < نسبة * 36 / 10)
            متغير rad_approx = زاوية * 3
            متغير خارجي_ن = نصف_قطر - 3
            متغير داخلي_ن = نصف_قطر - 12

            # تقريب: نرسم نقاط على المحيط
            اذا (زاوية < 90)
                متغير px = cx + خارجي_ن * زاوية / 90
                متغير py = cy - خارجي_ن * (90 - زاوية) / 90
                ارسم_مستطيل_أصلي(ف، px، py، 3، 3، لون_م)
            نهاية

            زاوية = زاوية + 3
        نهاية

        # النسبة في المنتصف
        ارسم_نص_أصلي(ف، cx - 15، cy - 8، "" + نسبة + "%"، 2، لون_م)
        ارسم_نص_أصلي(ف، cx - طول(تسمية) * 4، cy + 15، تسمية، 1، ل_رمادي)

        ارجع 1
    نهاية

    # رسم شريط أفقي مع تسمية
    دالة رسم_شريط_مسمى(ف، bx، by، bw، نسبة، لون_ب، تسمية، قيمة_نص)
        ارسم_نص_أصلي(ف، bx، by، تسمية، 1، ل_أبيض)
        ارسم_مستطيل_أصلي(ف، bx + 100، by، bw، 14، ل_رمادي_غ)
        متغير ملء = bw * نسبة / 100
        ارسم_مستطيل_أصلي(ف، bx + 100، by، ملء، 14، لون_ب)
        ارسم_نص_أصلي(ف، bx + 105 + bw، by، قيمة_نص، 1، ل_رمادي)
        ارجع 1
    نهاية

    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        # خلفية
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، امزج_لون(ل_أسود، ل_أزرق_غ، 30))

        متغير nx = هذا.نافذة_x
        متغير ny = هذا.نافذة_y
        متغير nw = هذا.نافذة_ع
        متغير nh = هذا.نافذة_ا

        # نافذة
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، nh، امزج_لون(ل_أسود، ل_أزرق_غ، 20))
        ارسم_إطار_أصلي(ف، nx، ny، nw، nh، 2، ل_رمادي)
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، 30، امزج_لون(ل_أسود، ل_رمادي_غ، 50))
        ارسم_نص_أصلي(ف، nx + 10، ny + 8، "System Monitor"، 1، ل_أبيض)
        ارسم_مستطيل_أصلي(ف، nx + nw - 30، ny + 5، 20، 20، ل_أحمر)
        ارسم_نص_أصلي(ف، nx + nw - 25، ny + 8، "X"، 1، ل_أبيض)

        # CPU Graph
        هذا.رسم_بياني(ف، nx + 20، ny + 60، 520، 180، هذا.تاريخ_معالج، ل_أخضر، "CPU Usage")

        # Memory Graph
        هذا.رسم_بياني(ف، nx + 570، ny + 60، 520، 180، هذا.تاريخ_ذاكرة، ل_أزرق_غ، "Memory Usage")

        # مقاييس دائرية
        متغير gauge_y = ny + 300
        هذا.رسم_مقياس(ف، nx + 100، gauge_y، 45، هذا.معالج_حالي، ل_أخضر، "CPU")
        هذا.رسم_مقياس(ف، nx + 250، gauge_y، 45، هذا.ذاكرة_حالية، ل_أزرق_غ، "RAM")
        هذا.رسم_مقياس(ف، nx + 400، gauge_y، 45، هذا.مساحة_قرص، ل_برتقالي، "Disk")
        هذا.رسم_مقياس(ف، nx + 550، gauge_y، 45، هذا.درجة_حرارة، ل_أحمر، "Temp")

        # معلومات يمين المقاييس
        متغير info_x = nx + 680
        متغير info_y = gauge_y - 40
        ارسم_نص_أصلي(ف، info_x، info_y، "System Information"، 2، ل_أصفر)
        ارسم_خط_أصلي(ف، info_x، info_y + 22، info_x + 400، info_y + 22، ل_رمادي_غ)

        ارسم_نص_أصلي(ف، info_x، info_y + 35، "CPU: Queen-Bee Q4 @ 3.6 GHz"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، info_x، info_y + 55، "RAM: 1024 MB  DDR4"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، info_x، info_y + 75، "GPU: HoneyRender HD 1080p"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، info_x، info_y + 95، "Disk: 512 GB SSD HoneyDrive"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، info_x، info_y + 115، "Network: BeeHive-5G  45 Mbps"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، info_x، info_y + 135، "Uptime: 3h 42m 15s"، 1، ل_أبيض)

        # أشرطة الموارد أسفل
        متغير bar_y = ny + 430
        ارسم_نص_أصلي(ف، nx + 20، bar_y، "Resource Breakdown"، 2، ل_أصفر)
        ارسم_خط_أصلي(ف، nx + 20، bar_y + 22، nx + nw - 20، bar_y + 22، ل_رمادي_غ)

        هذا.رسم_شريط_مسمى(ف، nx + 20، bar_y + 35، 400، هذا.معالج_حالي، ل_أخضر، "CPU", "" + هذا.معالج_حالي + "%")
        هذا.رسم_شريط_مسمى(ف، nx + 20، bar_y + 60، 400، هذا.ذاكرة_حالية، ل_أزرق_غ، "Memory", "" + هذا.ذاكرة_حالية + "%")
        هذا.رسم_شريط_مسمى(ف، nx + 20، bar_y + 85، 400، هذا.مساحة_قرص، ل_برتقالي، "Disk", "" + هذا.مساحة_قرص + "%")
        هذا.رسم_شريط_مسمى(ف، nx + 20، bar_y + 110، 400، هذا.سرعة_شبكة، ل_بنفسجي، "Network", "" + هذا.سرعة_شبكة + " Mbps")
        هذا.رسم_شريط_مسمى(ف، nx + 20، bar_y + 135، 400، هذا.درجة_حرارة، ل_أحمر، "Temp", "" + هذا.درجة_حرارة + " C")

        # أهم العمليات
        متغير proc_x = nx + 650
        متغير proc_y = bar_y + 35
        ارسم_نص_أصلي(ف، proc_x، bar_y، "Top Processes"، 2، ل_أصفر)

        مصفوفة top_names = ["graphics_hd", "browser", "desktop_mgr", "window_mgr", "editor"]
        مصفوفة top_cpu = [22, 15, 12, 8, 5]
        مصفوفة top_mem = [256, 180, 128, 64, 45]

        متغير ت = 0
        بينما (ت < طول(top_names))
            ارسم_نص_أصلي(ف، proc_x، proc_y + ت * 25، top_names[ت]، 1، ل_أبيض)
            هذا.رسم_شريط_استخدام_صغير(ف، proc_x + 140، proc_y + ت * 25 + 2، 100، top_cpu[ت]، ل_أخضر)
            ارسم_نص_أصلي(ف، proc_x + 250، proc_y + ت * 25، "" + top_cpu[ت] + "%"، 1، ل_رمادي)
            ارسم_نص_أصلي(ف، proc_x + 300، proc_y + ت * 25، "" + top_mem[ت] + "MB"، 1، ل_رمادي)
            ت = ت + 1
        نهاية

        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)
        ارجع 1
    نهاية

    دالة رسم_شريط_استخدام_صغير(ف، bx، by، bw، نسبة، لون_ب)
        ارسم_مستطيل_أصلي(ف، bx، by، bw، 10، ل_رمادي_غ)
        متغير ملء = bw * نسبة / 100
        اذا (ملء > bw)
            ملء = bw
        نهاية
        اذا (ملء > 0)
            ارسم_مستطيل_أصلي(ف، bx، by، ملء، 10، لون_ب)
        نهاية
        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== BeeOS System Monitor ===")

    متغير مراقب = جديد مراقب_نظام()
    اطبع_سطر("[MONITOR] Initialized")

    اطبع_سطر("-- Frame 1: Monitor view --")
    مراقب.رسم(1)
    مراقب.تصدير("C:\\beeos_monitor.ppm")
    اطبع_سطر("  CPU: " + مراقب.معالج_حالي + "%, RAM: " + مراقب.ذاكرة_حالية + "%")

    اطبع_سطر("-- Frame 2: High load --")
    مراقب.معالج_حالي = 95
    مراقب.ذاكرة_حالية = 88
    مراقب.درجة_حرارة = 78
    مراقب.رسم(2)
    مراقب.تصدير("C:\\beeos_monitor_high.ppm")
    اطبع_سطر("  CPU: " + مراقب.معالج_حالي + "%, RAM: " + مراقب.ذاكرة_حالية + "%")

    متغير أسود = عد_بكسلات(مراقب.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("=== System Monitor: SUCCESS ===")
    ارجع 0
نهاية
