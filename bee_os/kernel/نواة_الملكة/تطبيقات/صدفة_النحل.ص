# ─────────────────────────────────────────────────────════════════════════════
# صنف محلل_الأوامر — يحلل سطر الأمر ويحوله لهيكل
# ─────────────────────────────────────────────────────════════════════════════
صنف محلل_الأوامر
    رقم عدد_أوامر_محللة

    باني()
        عدد_أوامر_محللة = 0
    نهاية

    # تحليل سطر أمر
    دالة حلل(نص السطر)
        عدد_أوامر_محللة = عدد_أوامر_محللة + 1
        متغير أمر = جديد أمر_مُحلَّل()

        # استخراج اسم الأمر (أول كلمة)
        متغير المسافة = 0
        متغير ط = طول(السطر)

        اذا (ط == 0)
            أمر.الاسم = ""
            ارجع أمر
        نهاية

        # بحث بسيط عن أول مسافة
        متغير وجد_مسافة = خطأ
        متغير موقع_مسافة = ط

        متغير ع = 0
        بينما (ع < ط)
            اذا (قطع(السطر, ع, ع + 1) == " ")
                اذا (وجد_مسافة == خطأ)
                    وجد_مسافة = صحيح
                    موقع_مسافة = ع
                نهاية
            نهاية
            ع = ع + 1
        نهاية

        اذا (وجد_مسافة)
            أمر.الاسم = قطع(السطر, 0, موقع_مسافة)
            متغير الباقي = قطع(السطر, موقع_مسافة + 1, ط)
            أمر.المعامل1 = الباقي
            أمر.عدد_المعاملات = 1
        والا
            أمر.الاسم = السطر
            أمر.عدد_المعاملات = 0
        نهاية

        # التحقق من وجود أنبوب
        متغير ع2 = 0
        بينما (ع2 < ط)
            اذا (قطع(السطر, ع2, ع2 + 1) == "|")
                أمر.بأنبوب = صحيح
            نهاية
            ع2 = ع2 + 1
        نهاية

        ارجع أمر
    نهاية
نهاية

