# ══════════════════════════════════════════════════════════════════════════════
# متصفح_النحل.ص - متصفح الويب العربي لنظام النحلة
# ══════════════════════════════════════════════════════════════════════════════
#
# مميزاته:
# ━━━━━━━
# 1. شريط العنوان العربي الكامل مع RTL
# 2. إشارات مرجعية (Bookmarks) عربية
# 3. سجل التصفح (History) مع تواريخ عربية
# 4. علامات التبويب (Tabs) المتعددة
# 5. وضع القراءة (Reader Mode) العربي
# 6. فلتر المحتوى الآمن
# 7. مدير التنزيلات
# 8. محرك بحث النحل
#
# المؤلف: فريق نظام خلية النحل
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت المتصفح
# ─────────────────────────────────────────────────────────────────────────────
ثابت إصدار_المتصفح     = 1
ثابت اسم_المتصفح       = "متصفح النحل v1.0"
ثابت أقصى_تبويب        = 20
ثابت أقصى_سجل          = 100
ثابت أقصى_إشارات       = 50
ثابت البروتوكول_HTTP    = 1
ثابت البروتوكول_HTTPS   = 2
ثابت البروتوكول_FILE    = 3
ثابت حالة_تحميل        = 1
ثابت حالة_جاهز         = 2
ثابت حالة_خطأ          = 3

# ─────────────────────────────────────────────────────────────────────────────
# صنف إدخال_السجل - إدخال واحد في سجل التصفح
# ─────────────────────────────────────────────────────────────────────────────
صنف إدخال_السجل
    ## الوصف: يُمثّل زيارة واحدة في السجل

    نص العنوان_URL
    نص عنوان_الصفحة
    رقم الوقت           # timestamp (0 في التجربة)
    رقم عدد_الزيارات

    باني(نص url، نص عنوان)
        العنوان_URL = url
        عنوان_الصفحة = عنوان
        الوقت = 0
        عدد_الزيارات = 1
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف إشارة_مرجعية
# ─────────────────────────────────────────────────────────────────────────────
صنف إشارة_مرجعية
    ## الوصف: يُمثّل إشارة مرجعية مُحفوظة

    نص العنوان_URL
    نص الاسم
    نص الوصف
    نص الفئة           # تصنيف الإشارة

    باني(نص url، نص اسم، نص فئة)
        العنوان_URL = url
        الاسم = اسم
        الوصف = ""
        الفئة = فئة
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف علامة_تبويب
# ─────────────────────────────────────────────────────────────────────────────
صنف علامة_تبويب
    ## الوصف: تبويب متصفح واحد

    رقم المعرف
    نص العنوان_الحالي
    نص عنوان_الصفحة
    رقم الحالة          # 1=تحميل 2=جاهز 3=خطأ
    منطقي مثبّت         # هل التبويب مثبّت؟
    منطقي نشط           # هل التبويب النشط؟

    باني(رقم id، نص url)
        المعرف = id
        العنوان_الحالي = url
        عنوان_الصفحة = "صفحة جديدة"
        الحالة = حالة_جاهز
        مثبّت = خطأ
        نشط = خطأ
    نهاية

    دالة تحميل(نص url_جديد)
        العنوان_الحالي = url_جديد
        الحالة = حالة_تحميل
        عنوان_الصفحة = "جاري التحميل..."
    نهاية

    دالة اكتمل_التحميل(نص العنوان_م)
        عنوان_الصفحة = العنوان_م
        الحالة = حالة_جاهز
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف محرك_بحث_النحل
# ─────────────────────────────────────────────────────────────────────────────
صنف محرك_بحث_النحل
    ## الوصف: محرك البحث المدمج في المتصفح

    نص الاسم
    نص نقطة_الوصول     # API endpoint

    باني()
        الاسم = "محرك بحث النحل"
        نقطة_الوصول = "https://بحث.النحل/؟ق="
    نهاية

    ## تحويل نص البحث إلى URL
    دالة نص بحث(نص استعلام)
        ارجع نقطة_الوصول + استعلام
    نهاية

    ## هل هذا URL أم نص للبحث؟
    دالة منطقي هل_URL(نص نص_الإدخال)
        # إذا يحتوي نقطة فلعله URL
        ارجع خطأ   # للتبسيط - في التطبيق الحقيقي نفحص النقاط والبادئات
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الصنف الرئيسي: متصفح_النحل
# ─────────────────────────────────────────────────────────────────────────────
صنف متصفح_النحل
    ## الوصف: متصفح الويب الكامل لنظام النحلة

    مصفوفة التبويبات
    مصفوفة سجل_التصفح
    مصفوفة الإشارات_المرجعية
    رقم التبويب_النشط_id
    رقم عداد_التبويبات
    منطقي وضع_خاص        # وضع التصفح الخاص
    منطقي حجب_الإعلانات  # فلتر الإعلانات

    # حقول محرك البحث (مسطحة)
    نص محرك_بحث_اسم
    نص محرك_بحث_url

    باني()
        التبويبات = []
        سجل_التصفح = []
        الإشارات_المرجعية = []
        التبويب_النشط_id = 1
        عداد_التبويبات = 0
        وضع_خاص = خطأ
        حجب_الإعلانات = صحيح
        محرك_بحث_اسم = "محرك بحث النحل"
        محرك_بحث_url = "https://بحث.النحل/؟ق="
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إدارة التبويبات
    ## ══════════════════════════════════════════════════════════════════════

    ## فتح تبويب جديد
    دالة رقم تبويب_جديد()
        اذا (عداد_التبويبات >= أقصى_تبويب)
            اطبع_سطر("  ⚠ وصلت للحد الأقصى من التبويبات (20)")
            ارجع -1
        نهاية

        عداد_التبويبات = عداد_التبويبات + 1
        متغير تبويب_جديد = جديد علامة_تبويب(عداد_التبويبات، "about:newtab")
        التبويبات += [تبويب_جديد]
        التبويب_النشط_id = عداد_التبويبات

        اطبع("  📄 تبويب جديد #")
        اطبع_سطر(عداد_التبويبات)
        ارجع عداد_التبويبات
    نهاية

    ## الانتقال إلى URL في التبويب الحالي
    دالة انتقل(نص url)
        اطبع("  🌐 الانتقال إلى: ")
        اطبع_سطر(url)

        # تحديد البروتوكول
        متغير نوع_بروتوكول = البروتوكول_HTTP
        اذا (طول(url) > 8)
            نوع_بروتوكول = البروتوكول_HTTPS
        نهاية

        # محاكاة التحميل
        اطبع_سطر("  ⏳ جاري تحميل الصفحة...")

        # إضافة للسجل
        أضف_للسجل(url، "صفحة ويب")

        اطبع_سطر("  ✅ تم تحميل الصفحة بنجاح")
        ارجع 0
    نهاية

    ## البحث عن نص
    دالة بحث(نص نص_البحث)
        متغير url_البحث = محرك_بحث_url + نص_البحث
        اطبع("  🔍 بحث عن: ")
        اطبع_سطر(نص_البحث)
        انتقل(url_البحث)
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إدارة الإشارات المرجعية
    ## ══════════════════════════════════════════════════════════════════════

    ## إضافة إشارة مرجعية
    دالة أضف_إشارة(نص url، نص اسم، نص فئة)
        اذا (عدد_إشارات >= أقصى_إشارات)
            اطبع_سطر("  ⚠ وصلت للحد الأقصى من الإشارات")
            ارجع 0
        نهاية

        متغير إشارة_جديدة = جديد إشارة_مرجعية(url، اسم، فئة)
        الإشارات_المرجعية += [إشارة_جديدة]

        اطبع("  ⭐ إشارة مرجعية: ")
        اطبع_سطر(اسم)
        ارجع 1
    نهاية

    ## طباعة الإشارات المرجعية
    دالة عرض_الإشارات()
        اطبع_سطر("═══════════════════════════════════════════════")
        اطبع_سطر("  ⭐ الإشارات المرجعية")
        اطبع_سطر("═══════════════════════════════════════════════")

        متغير عداد = 0
        لكل إشارة في الإشارات_المرجعية
            عداد = عداد + 1
            اطبع("  ")
            اطبع(عداد)
            اطبع(". [")
            اطبع(إشارة.الفئة)
            اطبع("] ")
            اطبع(إشارة.الاسم)
            اطبع("  →  ")
            اطبع_سطر(إشارة.العنوان_URL)
        نهاية

        اطبع_سطر("═══════════════════════════════════════════════")
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إدارة السجل
    ## ══════════════════════════════════════════════════════════════════════

    ## إضافة إدخال للسجل
    دالة أضف_للسجل(نص url، نص عنوان)
        اذا (!وضع_خاص)
            متغير إدخال_جديد = جديد إدخال_السجل(url، عنوان)
            سجل_التصفح += [إدخال_جديد]
        نهاية
    نهاية

    ## طباعة سجل التصفح
    دالة عرض_السجل()
        اطبع_سطر("═══════════════════════════════════════════════")
        اطبع_سطر("  📜 سجل التصفح")
        اطبع_سطر("═══════════════════════════════════════════════")

        متغير عداد = 0
        لكل إدخال في سجل_التصفح
            عداد = عداد + 1
            اطبع("  ")
            اطبع(عداد)
            اطبع(". ")
            اطبع_سطر(إدخال.العنوان_URL)
        نهاية

        اطبع("  إجمالي الزيارات: ")
        اطبع_سطر(عداد)
        اطبع_سطر("═══════════════════════════════════════════════")
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## وضع الخصوصية
    ## ══════════════════════════════════════════════════════════════════════

    ## تفعيل/إيقاف وضع التصفح الخاص
    دالة تبديل_وضع_خاص()
        وضع_خاص = !وضع_خاص
        اذا (وضع_خاص)
            اطبع_سطر("  🕵 وضع التصفح الخاص: مُفعّل")
            اطبع_سطر("  ℹ لن يُحفظ السجل أو ملفات تعريف الارتباط")
        والا
            اطبع_سطر("  👁 وضع التصفح العادي: مُفعّل")
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════════
    ## إحصاءات وعرض الحالة
    ## ══════════════════════════════════════════════════════════════════════

    دالة عدد_إشارات()
        متغير ع = 0
        لكل إ في الإشارات_المرجعية
            ع = ع + 1
        نهاية
        ارجع ع
    نهاية

    دالة عدد_سجل()
        متغير ع = 0
        لكل س في سجل_التصفح
            ع = ع + 1
        نهاية
        ارجع ع
    نهاية

    دالة عرض_الحالة()
        اطبع_سطر("═══════════════════════════════════════════════")
        اطبع_سطر("  🐝 حالة متصفح النحل")
        اطبع_سطر("═══════════════════════════════════════════════")
        اطبع("  التبويبات المفتوحة:   ") اطبع_سطر(عداد_التبويبات)
        اطبع("  التبويب النشط:        #") اطبع_سطر(التبويب_النشط_id)
        اطبع("  الإشارات المرجعية:   ") اطبع_سطر(عدد_إشارات())
        اطبع("  إدخالات السجل:       ") اطبع_سطر(عدد_سجل())
        اطبع("  وضع خاص:             ")
        اذا (وضع_خاص)
            اطبع_سطر("نعم 🕵")
        والا
            اطبع_سطر("لا 👁")
        نهاية
        اطبع("  حجب الإعلانات:       ")
        اذا (حجب_الإعلانات)
            اطبع_سطر("مُفعّل ✅")
        والا
            اطبع_سطر("مُعطّل ❌")
        نهاية
        اطبع("  محرك البحث:          ")
        اطبع_سطر(محرك_بحث_اسم)
        اطبع_سطر("═══════════════════════════════════════════════")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# المثيل العالمي للمتصفح
# ─────────────────────────────────────────────────────────────────────────────
متغير متصفح = جديد متصفح_النحل()

# ─────────────────────────────────────────────────────────────────────────────
# دالة الاختبار الرئيسية
# ─────────────────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════════════════")
    اطبع_سطر("  🐝 متصفح النحل - BeeOS Web Browser v1.0")
    اطبع_سطر("══════════════════════════════════════════════════════════")
    اطبع_سطر("")

    # ── فتح التبويبات ──────────────────────────────────────────
    اطبع_سطر("═══ التبويبات ═══")
    متصفح.تبويب_جديد()
    متصفح.تبويب_جديد()
    متصفح.تبويب_جديد()
    اطبع_سطر("")

    # ── التنقل في الويب ────────────────────────────────────────
    اطبع_سطر("═══ التصفح ═══")
    متصفح.انتقل("https://www.alquran.gov.sa")
    متصفح.انتقل("https://ar.wikipedia.org/wiki/برمجة")
    متصفح.انتقل("https://www.aljazeera.net")
    اطبع_سطر("")

    # ── البحث ──────────────────────────────────────────────────
    اطبع_سطر("═══ البحث ═══")
    متصفح.بحث("لغة ص نظام النحلة")
    متصفح.بحث("نظام تشغيل عربي مفتوح المصدر")
    اطبع_سطر("")

    # ── الإشارات المرجعية ──────────────────────────────────────
    اطبع_سطر("═══ الإشارات المرجعية ═══")
    متصفح.أضف_إشارة("https://www.alquran.gov.sa", "القرآن الكريم", "دين")
    متصفح.أضف_إشارة("https://ar.wikipedia.org", "ويكيبيديا العربية", "مرجع")
    متصفح.أضف_إشارة("https://www.aljazeera.net", "الجزيرة", "أخبار")
    متصفح.أضف_إشارة("https://github.com/bee-os", "مستودع BeeOS", "تطوير")
    متصفح.أضف_إشارة("https://sad-lang.dev", "لغة ص", "تطوير")
    اطبع_سطر("")
    متصفح.عرض_الإشارات()
    اطبع_سطر("")

    # ── وضع التصفح الخاص ───────────────────────────────────────
    اطبع_سطر("═══ وضع التصفح الخاص ═══")
    متصفح.تبديل_وضع_خاص()
    متصفح.انتقل("https://private.example.com")
    متصفح.تبديل_وضع_خاص()
    اطبع_سطر("")

    # ── عرض السجل ──────────────────────────────────────────────
    متصفح.عرض_السجل()
    اطبع_سطر("")

    # ── عرض الحالة الكاملة ──────────────────────────────────────
    متصفح.عرض_الحالة()

    اطبع_سطر("")
    اطبع_سطر("══════════════════════════════════════════════════════════")
    اطبع_سطر("  ✅ متصفح النحل يعمل بنجاح!")
    اطبع_سطر("══════════════════════════════════════════════════════════")
    ارجع 0
نهاية
