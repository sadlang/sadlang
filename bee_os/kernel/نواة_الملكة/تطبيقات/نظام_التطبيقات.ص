دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════════════╗")
    اطبع_سطر("║    🐝 نظام النحلة - إطار عمل التطبيقات v1.0        ║")
    اطبع_سطر("╚══════════════════════════════════════════════════════╝")
    اطبع_سطر("")

    ## إنشاء مدير التطبيقات (8 GB = 8,388,608 KB ذاكرة)
    متغير المدير = جديد مدير_التطبيقات(8388608)
    اطبع_سطر("  ✅ تهيئة مدير التطبيقات: 8 GB ذاكرة متاحة")
    اطبع_سطر("")

    ## إنشاء التطبيقات
    اطبع_سطر("  ── تسجيل التطبيقات ──")
