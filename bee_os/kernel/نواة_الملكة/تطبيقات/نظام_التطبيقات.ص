        لكل سطر في السطور
            اطبع("  ")
            اذا (رقم_سطر < 10)
                اطبع(" ")
            نهاية
            اطبع(رقم_سطر)
            اطبع(" │ ")
            اطبع_سطر(سطر)
            رقم_سطر = رقم_سطر + 1
        نهاية
        اطبع_سطر("  ╚══════════════════════════════════════════════")
        اطبع("  الأسطر: ")
        اطبع(عدد_الأسطر)
        اطبع(" | السطر: ")
        اطبع(سطر_المؤشر + 1)
        اطبع(" | العمود: ")
