    نهاية

    دالة ارسم()
        اطبع("  📝 [محرر: ")
        اطبع(اسم_الملف)
        اذا (تم_التعديل)
            اطبع("*")
        نهاية
        اطبع_سطر("]")
    نهاية
نهاية

