# ─────────────────────────────────────────────────────────────────────────────
# ثوابت حالات التطبيق
# ─────────────────────────────────────────────────────────────────────────────
متغير حالة_تطبيق_جاهز      = 0
متغير حالة_تطبيق_يعمل      = 1
متغير حالة_تطبيق_معلق      = 2
متغير حالة_تطبيق_ينتهي     = 4
متغير حالة_تطبيق_منتهي     = 5

متغير أولوية_منخفضة        = 0
متغير أولوية_عادية          = 5
متغير أولوية_عالية          = 10

متغير نوع_تطبيق_رسومي      = 0
متغير نوع_تطبيق_طرفية      = 1
متغير نوع_تطبيق_خدمة       = 2
متغير نوع_تطبيق_نظام       = 3

# ─────────────────────────────────────────────────────────────────────────────
# صنف تطبيق - الصنف الأساسي لكل تطبيقات النحلة
# ─────────────────────────────────────────────────────────────────────────────
صنف تطبيق
    ##
    ## الصنف الأب لجميع تطبيقات نظام النحلة.
    ## يُخزّن البيانات الأساسية: الاسم، الإصدار، الحالة، الذاكرة.
    ## كل تطبيق يعرّف دوال: تهيئة، تحديث، ارسم، اغلاق.
    ##

    ## البيانات الهوياتية
    رقم المعرف
    نص اسم_التطبيق
    نص مختصر_التطبيق
    نص إصدار_التطبيق
    نص وصف_التطبيق
    رقم نوع_التطبيق
    رقم أولوية_التطبيق

    ## حالة التشغيل
    رقم الحالة
    رقم معرف_النافذة
    رقم ذاكرة_مستخدمة
    نص رسالة_الحالة
    منطقي يقبل_لوحة_مفاتيح
    منطقي يقبل_فأرة

    باني(رقم معرف0، نص اسم0، نص مختصر0، نص إصدار0)
        المعرف = معرف0
        اسم_التطبيق = اسم0
        مختصر_التطبيق = مختصر0
        إصدار_التطبيق = إصدار0
        وصف_التطبيق = "تطبيق نظام النحلة"
        نوع_التطبيق = نوع_تطبيق_رسومي
        أولوية_التطبيق = أولوية_عادية
        الحالة = حالة_تطبيق_جاهز
        معرف_النافذة = -1
        ذاكرة_مستخدمة = 256
        رسالة_الحالة = "جاهز"
        يقبل_لوحة_مفاتيح = صحيح
        يقبل_فأرة = صحيح
    نهاية

    دالة منطقي تهيئة()
        الحالة = حالة_تطبيق_يعمل
        رسالة_الحالة = "يعمل"
        ارجع صحيح
    نهاية

    دالة تحديث()
        ## يُعيد كل تطبيق تعريف هذه الدالة
    نهاية

    دالة ارسم()
        اطبع("  [تطبيق: ")
        اطبع(اسم_التطبيق)
        اطبع_سطر("]")
    نهاية

    دالة اغلاق()
        الحالة = حالة_تطبيق_ينتهي
        رسالة_الحالة = "ينتهي..."
    نهاية

    دالة تعليق()
        الحالة = حالة_تطبيق_معلق
        رسالة_الحالة = "معلق"
    نهاية

    دالة استئناف()
        الحالة = حالة_تطبيق_يعمل
        رسالة_الحالة = "يعمل"
    نهاية

    دالة منطقي يعمل_الان()
        ارجع الحالة == حالة_تطبيق_يعمل
    نهاية

    دالة اطبع_حالة()
        اطبع("  🐝 ")
        اطبع(اسم_التطبيق)
        اطبع(" v")
        اطبع(إصدار_التطبيق)
        اطبع(" [")
        اطبع(المعرف)
        اطبع("] | ")
        اطبع(رسالة_الحالة)
        اطبع(" | ذاكرة: ")
        اطبع(ذاكرة_مستخدمة)
        اطبع_سطر(" KB")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدير_التطبيقات
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_التطبيقات
    ##
    ## يدير دورة حياة جميع التطبيقات:
    ## - التسجيل والإطلاق
    ## - التوقف والحذف
    ## - التحديث الدوري
    ## - مراقبة الذاكرة
    ##
    مصفوفة التطبيقات
    رقم تطبيق_مركّز
    رقم عداد_المعرفات
    رقم ذاكرة_إجمالية
    رقم ذاكرة_متاحة

    باني(رقم ذاكرة0)
        التطبيقات = []
        تطبيق_مركّز = -1
        عداد_المعرفات = 1
        ذاكرة_إجمالية = 0
        ذاكرة_متاحة = ذاكرة0
    نهاية

    دالة تسجيل_تطبيق(ت)
        التطبيقات += [ت]
        ذاكرة_إجمالية = ذاكرة_إجمالية + ت.ذاكرة_مستخدمة
        اطبع("  📝 تسجيل: ")
        اطبع(ت.اسم_التطبيق)
        اطبع(" [معرف=")
        اطبع(ت.المعرف)
        اطبع_سطر("]")
    نهاية

    دالة منطقي اطلاق_تطبيق(رقم معرف)
        لكل ت في التطبيقات
            اذا (ت.المعرف == معرف)
                متغير نجاح = ت.تهيئة()
                اذا (نجاح)
                    اطبع("  ▶️  إطلاق: ")
                    اطبع_سطر(ت.اسم_التطبيق)
                    تطبيق_مركّز = معرف
                    ارجع صحيح
                نهاية
                ارجع خطأ
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    دالة اغلاق_تطبيق(رقم معرف)
        لكل ت في التطبيقات
            اذا (ت.المعرف == معرف)
                ت.اغلاق()
                اطبع("  ⏹️  إغلاق: ")
                اطبع_سطر(ت.اسم_التطبيق)
            نهاية
        نهاية
        ## إزالة التطبيقات المنتهية
        متغير بقية = []
        لكل ت في التطبيقات
            اذا (ت.الحالة != حالة_تطبيق_ينتهي)
                بقية += [ت]
            نهاية
        نهاية
        التطبيقات = بقية
    نهاية

    دالة تحديث_الكل()
        لكل ت في التطبيقات
            اذا (ت.الحالة == حالة_تطبيق_يعمل)
                ت.تحديث()
            نهاية
        نهاية
    نهاية

    دالة ارسم_الكل()
        لكل ت في التطبيقات
            اذا (ت.الحالة == حالة_تطبيق_يعمل)
                ت.ارسم()
            نهاية
        نهاية
    نهاية

    دالة رقم عدد_العاملة()
        متغير عدد = 0
        لكل ت في التطبيقات
            اذا (ت.الحالة == حالة_تطبيق_يعمل)
                عدد = عدد + 1
            نهاية
        نهاية
        ارجع عدد
    نهاية

    دالة طباعة_تقرير()
        اطبع_سطر("  ╔══ تقرير التطبيقات ════════════════════════════════╗")
        اطبع("  ║  الذاكرة: ")
        اطبع(ذاكرة_إجمالية)
        اطبع(" / ")
        اطبع(ذاكرة_متاحة)
        اطبع_سطر(" KB")
        لكل ت في التطبيقات
            اطبع("  ║  ")
            ت.اطبع_حالة()
        نهاية
        اطبع_سطر("  ╚═══════════════════════════════════════════════════╝")
    نهاية
نهاية

