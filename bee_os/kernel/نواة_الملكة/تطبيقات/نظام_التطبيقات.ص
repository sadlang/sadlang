صنف تطبيق_محرر_النصوص يرث تطبيق
    ## محرر نصوص عربي متقدم

    نص اسم_الملف
    مصفوفة السطور
    رقم سطر_المؤشر
    رقم عمود_المؤشر
    منطقي تم_التعديل
    رقم عدد_الكلمات
    رقم عدد_الأسطر

    باني(رقم معرف0)
        المعرف = معرف0
        اسم_التطبيق = "📝 محرر النصوص"
        مختصر_التطبيق = "محرر"
        إصدار_التطبيق = "4.0.0"
        وصف_التطبيق = "محرر نصوص عربي متقدم"
        نوع_التطبيق = نوع_تطبيق_رسومي
        أولوية_التطبيق = أولوية_عادية
        الحالة = حالة_تطبيق_جاهز
        معرف_النافذة = -1
        ذاكرة_مستخدمة = 384
        رسالة_الحالة = "جاهز"
        يقبل_لوحة_مفاتيح = صحيح
        يقبل_فأرة = صحيح
        اسم_الملف = "ملف_جديد.نح"
        السطور = [""]
        سطر_المؤشر = 0
        عمود_المؤشر = 0
        تم_التعديل = خطأ
        عدد_الكلمات = 0
        عدد_الأسطر = 1
    نهاية

    دالة منطقي تهيئة()
        الحالة = حالة_تطبيق_يعمل
        رسالة_الحالة = "يعمل"
        اطبع_سطر("  ✅ تهيئة محرر النصوص...")
        ارجع صحيح
    نهاية

    دالة فتح_ملف(نص مسار_الملف)
        اسم_الملف = مسار_الملف
        ## تحميل ملف تجريبي
        السطور = [
            "بسم الله الرحمن الرحيم"،
            ""،
            "## مرحباً بك في محرر النحلة 🐝"،
            ""،
            "هذا ملف نصي تجريبي لاختبار المحرر."،
            "يدعم المحرر اللغة العربية بالكامل مع RTL."،
            ""،
            "### الميزات:"،
            "- تمييز الصياغة (Syntax Highlighting)"،
            "- إكمال تلقائي (Auto-complete)"،
            "- بحث واستبدال"،
            "- دعم مشاريع متعددة الملفات"،
            ""،
            "نهاية الملف."
        ]
        ## احسب عدد الأسطر بحلقة لكل لأن .عدد_العناصر لا يعمل داخل الأصناف
        عدد_الأسطر = 0
        لكل س في السطور
            عدد_الأسطر = عدد_الأسطر + 1
        نهاية
        تم_التعديل = خطأ
        اطبع("  📄 فتح: ")
        اطبع_سطر(اسم_الملف)
    نهاية

    دالة عرض_المحتوى()
        اطبع("  ╔══ ")
        اطبع(اسم_الملف)
        اذا (تم_التعديل)
            اطبع(" *")
        نهاية
        اطبع_سطر(" ══════════════════════")
