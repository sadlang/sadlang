صنف تطبيق_الطرفية يرث تطبيق
    ## طرفية أوامر عربية كاملة لنظام النحلة

    نص المسار_الحالي
    مصفوفة سجل_الأوامر
    نص الإدخال_الحالي

    باني(رقم معرف0)
        المعرف = معرف0
        اسم_التطبيق = "💻 طرفية النحلة"
        مختصر_التطبيق = "طرفية"
        إصدار_التطبيق = "3.0.0"
        وصف_التطبيق = "طرفية أوامر عربية كاملة"
        نوع_التطبيق = نوع_تطبيق_طرفية
        أولوية_التطبيق = أولوية_عادية
        الحالة = حالة_تطبيق_جاهز
        معرف_النافذة = -1
        ذاكرة_مستخدمة = 256
        رسالة_الحالة = "جاهز"
        يقبل_لوحة_مفاتيح = صحيح
        يقبل_فأرة = صحيح
        ## الحقول الخاصة بالطرفية
        المسار_الحالي = "/المنزل/مستخدم"
        سجل_الأوامر = []
        الإدخال_الحالي = ""
    نهاية

    دالة منطقي تهيئة()
        الحالة = حالة_تطبيق_يعمل
        رسالة_الحالة = "يعمل"
        اطبع_سطر("  ══════════════════════════════════════════════")
        اطبع_سطر("  💻 طرفية نظام النحلة BeeOS v3.0")
        اطبع_سطر("  المطوّر: فريق خلية النحلة 🐝")
        اطبع_سطر("  اكتب 'مساعدة' لعرض الأوامر المتاحة")
        اطبع_سطر("  ══════════════════════════════════════════════")
        ارجع صحيح
    نهاية

    دالة نص تنفيذ_أمر(نص الأمر)
        سجل_الأوامر += [الأمر]

        اذا (الأمر == "مساعدة")
            ارجع "─── الأوامر المتاحة ───\n  اعرض      - محتوى المجلد الحالي\n  مكاني     - المسار الحالي\n  انتقل     - الانتقال لمجلد\n  أنشئ      - إنشاء ملف\n  احذف      - حذف ملف\n  امسح      - مسح الشاشة\n  تاريخ     - سجل الأوامر\n  خروج      - إغلاق الطرفية"
        نهاية
        اذا (الأمر == "اعرض")
            ارجع "📁 " + المسار_الحالي + ":\n  📁 المستندات/\n  📁 الصور/\n  📁 التنزيلات/\n  📁 المشاريع/\n  📄 ملف_مرحبا.نح\n  📄 الإعدادات.خلية"
        نهاية
        اذا (الأمر == "مكاني")
            ارجع المسار_الحالي
        نهاية
        اذا (الأمر == "تاريخ")
            متغير سجل = "─── السجل ───\n"
            متغير ع = 1
            لكل أمر_سابق في سجل_الأوامر
                سجل = سجل + "  " + ع + ". " + أمر_سابق + "\n"
                ع = ع + 1
            نهاية
            ارجع سجل
        نهاية
        اذا (الأمر == "امسح")
            ارجع "[مسح الشاشة]"
        نهاية
        اذا (الأمر == "خروج")
            ارجع "[تم طلب الإغلاق]"
        نهاية
        ارجع "خطأ: '" + الأمر + "' غير معروف. اكتب 'مساعدة'"
    نهاية

    دالة ارسم()
        اطبع("  $ ")
        اطبع(المسار_الحالي)
        اطبع(" > ")
    نهاية
نهاية

