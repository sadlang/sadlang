# ══════════════════════════════════════════════════════════════════════════════
# عارض_الصور.ص - عارض صور نظام خلية النحل
# BeeOS Image Viewer - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296

# ──────────────────────────────────────────────────────────────────
# صنف عارض الصور
# ──────────────────────────────────────────────────────────────────
صنف عارض_صور
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    رقم مقبض_صورة
    رقم صورة_حالية
    رقم تكبير
    رقم نافذة_x
    رقم نافذة_y
    رقم نافذة_ع
    رقم نافذة_ا
    مصفوفة أسماء_صور

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_صورة = أنشئ_مخزن_رسوم(640، 480)
        هذا.صورة_حالية = 0
        هذا.تكبير = 100
        هذا.نافذة_x = 200
        هذا.نافذة_y = 50
        هذا.نافذة_ع = 900
        هذا.نافذة_ا = 700

        هذا.أسماء_صور = ["sunset.ppm", "mountain.ppm", "flower.ppm", "city.ppm", "ocean.ppm"]
    نهاية

    # إنشاء صورة اختبارية - غروب
    دالة صورة_غروب()
        متغير ف = هذا.مقبض_صورة
        # سماء متدرجة
        ارسم_تدرج_أفقي(ف، 0، 0، 640، 240، ل_أزرق_غ، ل_برتقالي)
        # شمس
        ارسم_دائرة_مصمتة(ف، 320، 200، 50، ل_أصفر)
        ارسم_دائرة_مصمتة(ف، 320، 200، 45، ل_برتقالي)
        # أرض
        ارسم_مستطيل_أصلي(ف، 0، 240، 640، 240، امزج_لون(ل_أسود، ل_أخضر، 30))
        # أشجار
        متغير شجرة = 0
        بينما (شجرة < 8)
            متغير sx = 40 + شجرة * 80
            ارسم_مستطيل_أصلي(ف، sx، 200، 8، 50، امزج_لون(ل_أسود، ل_برتقالي، 40))
            ارسم_دائرة_مصمتة(ف، sx + 4، 195، 18، امزج_لون(ل_أخضر، ل_أسود، 50))
            شجرة = شجرة + 1
        نهاية
        ارجع 1
    نهاية

    # إنشاء صورة اختبارية - جبل
    دالة صورة_جبل()
        متغير ف = هذا.مقبض_صورة
        # سماء
        ارسم_تدرج_أفقي(ف، 0، 0، 640، 300، ل_أزرق_غ، ل_أبيض)
        # جبل
        متغير جبل_لون = امزج_لون(ل_رمادي_غ، ل_أسود، 50)
        # مثلث الجبل (خطوط)
        متغير سطر = 0
        بينما (سطر < 200)
            متغير عرض_سطر = سطر * 3
            ارسم_خط_أصلي(ف، 320 - عرض_سطر / 2، 100 + سطر، 320 + عرض_سطر / 2، 100 + سطر، جبل_لون)
            سطر = سطر + 1
        نهاية
        # قمة ثلجية
        سطر = 0
        بينما (سطر < 40)
            متغير عرض_ق = سطر * 3
            ارسم_خط_أصلي(ف، 320 - عرض_ق / 2، 100 + سطر، 320 + عرض_ق / 2، 100 + سطر، ل_أبيض)
            سطر = سطر + 1
        نهاية
        # أرض خضراء
        ارسم_مستطيل_أصلي(ف، 0، 300، 640، 180، امزج_لون(ل_أخضر، ل_أسود، 40))
        ارجع 1
    نهاية

    # إنشاء صورة - وردة
    دالة صورة_وردة()
        متغير ف = هذا.مقبض_صورة
        ارسم_مستطيل_أصلي(ف، 0، 0، 640، 480، امزج_لون(ل_أخضر، ل_أسود، 30))
        # بتلات
        ارسم_دائرة_مصمتة(ف، 320، 220، 60، ل_أحمر)
        ارسم_دائرة_مصمتة(ف، 280، 240، 50، ل_أحمر)
        ارسم_دائرة_مصمتة(ف، 360، 240، 50، ل_أحمر)
        ارسم_دائرة_مصمتة(ف، 300، 270، 50، ل_أحمر)
        ارسم_دائرة_مصمتة(ف، 340، 270، 50، ل_أحمر)
        # مركز
        ارسم_دائرة_مصمتة(ف، 320، 250، 20، ل_أصفر)
        # ساق
        ارسم_مستطيل_أصلي(ف، 318، 300، 4، 150، ل_أخضر)
        # أوراق
        ارسم_دائرة_مصمتة(ف، 300، 370، 15، ل_أخضر)
        ارسم_دائرة_مصمتة(ف، 340، 400، 15، ل_أخضر)
        ارجع 1
    نهاية

    # رسم الأدوات
    دالة رسم_أدوات(ف، ty)
        متغير tx = هذا.نافذة_x + 10

        # أزرار التنقل
        ارسم_مستطيل_أصلي(ف، tx، ty، 30، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، tx + 8، ty + 6، "<"، 1، ل_أبيض)
        tx = tx + 35

        ارسم_مستطيل_أصلي(ف، tx، ty، 30، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، tx + 8، ty + 6، ">"، 1، ل_أبيض)
        tx = tx + 45

        # فاصل
        ارسم_خط_أصلي(ف، tx، ty + 3، tx، ty + 22، ل_رمادي_غ)
        tx = tx + 15

        # تكبير
        ارسم_مستطيل_أصلي(ف، tx، ty، 30، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، tx + 8، ty + 6، "-"، 1، ل_أبيض)
        tx = tx + 35

        ارسم_نص_أصلي(ف، tx، ty + 6، "" + هذا.تكبير + "%"، 1، ل_أبيض)
        tx = tx + 45

        ارسم_مستطيل_أصلي(ف، tx، ty، 30، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، tx + 8، ty + 6، "+"، 1، ل_أبيض)
        tx = tx + 45

        # فاصل
        ارسم_خط_أصلي(ف، tx، ty + 3، tx، ty + 22، ل_رمادي_غ)
        tx = tx + 15

        # تدوير
        ارسم_مستطيل_أصلي(ف، tx، ty، 55، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، tx + 5، ty + 6، "Rotate"، 1، ل_أبيض)
        tx = tx + 65

        # ملء الشاشة
        ارسم_مستطيل_أصلي(ف، tx، ty، 40، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، tx + 5، ty + 6، "Full"، 1، ل_أبيض)

        # معلومات الصورة يمين
        متغير معلومات_x = هذا.نافذة_x + هذا.نافذة_ع - 200
        ارسم_نص_أصلي(ف، معلومات_x، ty + 6، "" + (هذا.صورة_حالية + 1) + " / " + طول(هذا.أسماء_صور)، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، معلومات_x + 60، ty + 6، "640x480"، 1، ل_رمادي)

        ارجع 1
    نهاية

    # رسم الشاشة
    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        # خلفية
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، امزج_لون(ل_أسود، ل_أزرق_غ، 30))

        متغير nx = هذا.نافذة_x
        متغير ny = هذا.نافذة_y
        متغير nw = هذا.نافذة_ع
        متغير nh = هذا.نافذة_ا

        # نافذة
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، nh، ل_أسود)
        ارسم_إطار_أصلي(ف، nx، ny، nw، nh، 2، ل_رمادي)

        # شريط العنوان
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، 30، امزج_لون(ل_أسود، ل_رمادي_غ، 50))
        ارسم_نص_أصلي(ف، nx + 10، ny + 8، "Image Viewer - " + هذا.أسماء_صور[هذا.صورة_حالية]، 1، ل_أبيض)
        ارسم_مستطيل_أصلي(ف، nx + nw - 30، ny + 5، 20، 20، ل_أحمر)
        ارسم_نص_أصلي(ف، nx + nw - 25، ny + 8، "X"، 1، ل_أبيض)

        # شريط الأدوات
        هذا.رسم_أدوات(ف، ny + 33)

        # منطقة الصورة
        متغير صورة_x = nx + (nw - 640) / 2
        متغير صورة_y = ny + 65
        متغير صورة_ع = 640
        متغير صورة_ا = 480

        اذا (صورة_y + صورة_ا > ny + nh - 30)
            صورة_ا = ny + nh - 30 - صورة_y
        نهاية

        # خلفية رقعة شطرنج
        متغير بلاط = 0
        بينما (بلاط < 40)
            متغير bx = صورة_x + (بلاط % 20) * 32
            متغير by = صورة_y + (بلاط / 20) * 32
            اذا (بلاط % 2 == 0)
                ارسم_مستطيل_أصلي(ف، bx، by، 32، 32، ل_رمادي_غ)
            نهاية
            بلاط = بلاط + 1
        نهاية

        # نسخ الصورة
        انسخ_منطقة(هذا.مقبض_صورة، ف، 0، 0، صورة_x، صورة_y، صورة_ع، صورة_ا)

        # إطار الصورة
        ارسم_إطار_أصلي(ف، صورة_x - 1، صورة_y - 1، صورة_ع + 2، صورة_ا + 2، 1، ل_رمادي)

        # شريط الحالة
        متغير شريط_y = ny + nh - 25
        ارسم_مستطيل_أصلي(ف، nx، شريط_y، nw، 25، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، nx + 10، شريط_y + 6، هذا.أسماء_صور[هذا.صورة_حالية]، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، nx + 200، شريط_y + 6، "640 x 480 px"، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، nx + 400، شريط_y + 6، "Zoom: " + هذا.تكبير + "%"، 1، ل_رمادي)

        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)
        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS Image Viewer ===")

    متغير عارض = جديد عارض_صور()
    اطبع_سطر("[VIEWER] Initialized, " + طول(عارض.أسماء_صور) + " images")

    # إطار 1: غروب
    اطبع_سطر("-- Frame 1: Sunset --")
    عارض.صورة_غروب()
    عارض.صورة_حالية = 0
    عارض.رسم(1)
    عارض.تصدير("C:\\beeos_viewer_sunset.ppm")
    اطبع_سطر("  Showing: sunset.ppm")

    # إطار 2: جبل
    اطبع_سطر("-- Frame 2: Mountain --")
    عارض.صورة_جبل()
    عارض.صورة_حالية = 1
    عارض.رسم(2)
    عارض.تصدير("C:\\beeos_viewer_mountain.ppm")
    اطبع_سطر("  Showing: mountain.ppm")

    # إطار 3: وردة
    اطبع_سطر("-- Frame 3: Flower --")
    عارض.صورة_وردة()
    عارض.صورة_حالية = 2
    عارض.تكبير = 150
    عارض.رسم(3)
    عارض.تصدير("C:\\beeos_viewer_flower.ppm")
    اطبع_سطر("  Showing: flower.ppm at 150%")

    متغير أسود = عد_بكسلات(عارض.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("=== Image Viewer: SUCCESS ===")
    ارجع 0
نهاية
