# ══════════════════════════════════════════════════════════════════════════════
# إعدادات_النظام.ص - تطبيق إعدادات نظام خلية النحل
# BeeOS System Settings - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

# ألوان
متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296

# أقسام الإعدادات
متغير قسم_عام     = 0
متغير قسم_عرض     = 1
متغير قسم_صوت     = 2
متغير قسم_شبكة    = 3
متغير قسم_تخزين   = 4
متغير قسم_حول     = 5

# ──────────────────────────────────────────────────────────────────
# صنف عنصر إعداد
# ──────────────────────────────────────────────────────────────────
صنف عنصر_قائمة
    نص تسمية
    نص أيقونة
    رقم لون
    رقم معرف

    باني(ت، أ، ل، م)
        هذا.تسمية = ت
        هذا.أيقونة = أ
        هذا.لون = ل
        هذا.معرف = م
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────
# صنف الإعدادات
# ──────────────────────────────────────────────────────────────────
صنف إعدادات_النظام
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    رقم قسم_حالي
    مصفوفة أقسام
    رقم نافذة_x
    رقم نافذة_y
    رقم نافذة_ع
    رقم نافذة_ا

    # إعدادات عرض
    رقم سطوع
    رقم دقة_عرض
    رقم وضع_ليلي

    # إعدادات صوت
    رقم مستوى_صوت
    رقم صامت

    # إعدادات شبكة
    رقم واي_فاي
    نص اسم_شبكة

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.قسم_حالي = قسم_عام
        هذا.سطوع = 80
        هذا.دقة_عرض = 1080
        هذا.وضع_ليلي = 0
        هذا.مستوى_صوت = 65
        هذا.صامت = 0
        هذا.واي_فاي = 1
        هذا.اسم_شبكة = "BeeHive-5G"

        هذا.نافذة_x = 200
        هذا.نافذة_y = 80
        هذا.نافذة_ع = 1000
        هذا.نافذة_ا = 700

        هذا.أقسام = []
        هذا.أقسام = هذا.أقسام + [جديد عنصر_قائمة("General", "G", ل_رمادي، قسم_عام)]
        هذا.أقسام = هذا.أقسام + [جديد عنصر_قائمة("Display", "D", ل_أزرق_غ، قسم_عرض)]
        هذا.أقسام = هذا.أقسام + [جديد عنصر_قائمة("Sound", "S", ل_أخضر، قسم_صوت)]
        هذا.أقسام = هذا.أقسام + [جديد عنصر_قائمة("Network", "N", ل_برتقالي، قسم_شبكة)]
        هذا.أقسام = هذا.أقسام + [جديد عنصر_قائمة("Storage", "T", ل_أحمر، قسم_تخزين)]
        هذا.أقسام = هذا.أقسام + [جديد عنصر_قائمة("About", "A", ل_أصفر، قسم_حول)]
    نهاية

    # رسم شريط القوائم الجانبي
    دالة رسم_شريط_جانبي(ف)
        متغير sx = هذا.نافذة_x + 2
        متغير sy = هذا.نافذة_y + 32
        متغير sw = 200
        متغير sh = هذا.نافذة_ا - 34

        ارسم_مستطيل_أصلي(ف، sx، sy، sw، sh، امزج_لون(ل_أسود، ل_أزرق_غ، 20))
        ارسم_خط_أصلي(ف، sx + sw، sy، sx + sw، sy + sh، ل_رمادي_غ)

        متغير ey = sy + 10
        متغير ت = 0
        بينما (ت < طول(هذا.أقسام))
            متغير قسم = هذا.أقسام[ت]

            # تظليل القسم المحدد
            اذا (قسم.معرف == هذا.قسم_حالي)
                ارسم_مستطيل_أصلي(ف، sx + 5، ey، sw - 10، 35، امزج_لون(ل_أصفر، ل_أسود، 60))
                ارسم_مستطيل_أصلي(ف، sx + 5، ey، 3، 35، ل_أصفر)
            نهاية

            # أيقونة دائرية
            ارسم_دائرة_مصمتة(ف، sx + 25، ey + 17، 10، قسم.لون)
            ارسم_نص_أصلي(ف، sx + 20، ey + 12، قسم.أيقونة، 1، ل_أبيض)

            # اسم القسم
            ارسم_نص_أصلي(ف، sx + 45، ey + 10، قسم.تسمية، 1، ل_أبيض)

            ey = ey + 40
            ت = ت + 1
        نهاية

        ارجع 1
    نهاية

    # رسم شريط التمرير (slider)
    دالة رسم_شريط_تمرير(ف، x، y، عرض_ش، قيمة_ش، لون_ش)
        # المسار
        ارسم_مستطيل_أصلي(ف، x، y + 3، عرض_ش، 6، ل_رمادي_غ)

        # الجزء المملوء
        متغير ملو = عرض_ش * قيمة_ش / 100
        ارسم_مستطيل_أصلي(ف، x، y + 3، ملو، 6، لون_ش)

        # المقبض
        ارسم_دائرة_مصمتة(ف، x + ملو، y + 6، 8، ل_أبيض)
        ارسم_دائرة_أصلي(ف، x + ملو، y + 6، 8، لون_ش)

        # القيمة
        ارسم_نص_أصلي(ف، x + عرض_ش + 15، y، "" + قيمة_ش + "%"، 1، ل_أبيض)

        ارجع 1
    نهاية

    # رسم مفتاح تبديل (toggle)
    دالة رسم_تبديل(ف، x، y، مفعل)
        اذا (مفعل)
            ارسم_مستطيل_أصلي(ف، x، y، 44، 22، ل_أخضر)
            ارسم_دائرة_مصمتة(ف، x + 33، y + 11، 9، ل_أبيض)
            ارسم_نص_أصلي(ف، x + 50، y + 4، "ON"، 1، ل_أخضر)
        والا
            ارسم_مستطيل_أصلي(ف، x، y، 44، 22، ل_رمادي_غ)
            ارسم_دائرة_مصمتة(ف، x + 11، y + 11، 9، ل_أبيض)
            ارسم_نص_أصلي(ف، x + 50، y + 4، "OFF"، 1، ل_رمادي_غ)
        نهاية
        ارجع 1
    نهاية

    # رسم محتوى الإعدادات - عام
    دالة رسم_عام(ف، cx، cy، cw، ch)
        ارسم_نص_أصلي(ف، cx + 20، cy + 15، "General Settings"، 2، ل_أصفر)
        ارسم_خط_أصلي(ف، cx + 20، cy + 40، cx + cw - 20، cy + 40، ل_رمادي_غ)

        # اسم الجهاز
        ارسم_نص_أصلي(ف، cx + 20، cy + 60، "Device Name:"، 1، ل_رمادي)
        ارسم_مستطيل_أصلي(ف، cx + 20، cy + 78، 300، 30، ل_أسود)
        ارسم_إطار_أصلي(ف، cx + 20، cy + 78، 300، 30، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، cx + 30، cy + 84، "BeeOS-Desktop"، 1، ل_أبيض)

        # اللغة
        ارسم_نص_أصلي(ف، cx + 20، cy + 130، "Language:"، 1، ل_رمادي)
        ارسم_مستطيل_أصلي(ف، cx + 20، cy + 148، 300، 30، ل_أسود)
        ارسم_إطار_أصلي(ف، cx + 20، cy + 148، 300، 30، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، cx + 30، cy + 155، "Arabic + English"، 1، ل_أبيض)

        # المنطقة الزمنية
        ارسم_نص_أصلي(ف، cx + 20، cy + 200، "Timezone:"، 1، ل_رمادي)
        ارسم_مستطيل_أصلي(ف، cx + 20، cy + 218، 300، 30، ل_أسود)
        ارسم_إطار_أصلي(ف، cx + 20، cy + 218، 300، 30، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، cx + 30، cy + 225، "UTC+3 (Asia/Riyadh)"، 1، ل_أبيض)

        # التحديثات
        ارسم_نص_أصلي(ف، cx + 20، cy + 280، "Auto Updates:"، 1، ل_رمادي)
        هذا.رسم_تبديل(ف، cx + 150، cy + 278، 1)

        ارجع 1
    نهاية

    # رسم محتوى العرض
    دالة رسم_عرض(ف، cx، cy، cw، ch)
        ارسم_نص_أصلي(ف، cx + 20، cy + 15، "Display Settings"، 2، ل_أزرق_غ)
        ارسم_خط_أصلي(ف، cx + 20، cy + 40، cx + cw - 20، cy + 40، ل_رمادي_غ)

        # السطوع
        ارسم_نص_أصلي(ف، cx + 20، cy + 60، "Brightness:"، 1، ل_رمادي)
        هذا.رسم_شريط_تمرير(ف، cx + 20، cy + 82، 350، هذا.سطوع، ل_أصفر)

        # الدقة
        ارسم_نص_أصلي(ف، cx + 20، cy + 120، "Resolution:"، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، cx + 20، cy + 140، "1920 x " + هذا.دقة_عرض، 2، ل_أبيض)

        # وضع ليلي
        ارسم_نص_أصلي(ف، cx + 20، cy + 185، "Night Mode:"، 1، ل_رمادي)
        هذا.رسم_تبديل(ف، cx + 150، cy + 183، هذا.وضع_ليلي)

        # معاينة شاشة مصغرة
        ارسم_نص_أصلي(ف، cx + 20، cy + 230، "Preview:"، 1، ل_رمادي)
        ارسم_مستطيل_أصلي(ف، cx + 20، cy + 250، 320، 180، ل_أسود)
        ارسم_تدرج_أفقي(ف، cx + 22، cy + 252، 316، 176، ل_أزرق_غ، ل_أسود)
        ارسم_إطار_أصلي(ف، cx + 20، cy + 250، 320، 180، 2، ل_رمادي)

        ارجع 1
    نهاية

    # رسم محتوى الصوت
    دالة رسم_صوت(ف، cx، cy، cw، ch)
        ارسم_نص_أصلي(ف، cx + 20، cy + 15، "Sound Settings"، 2، ل_أخضر)
        ارسم_خط_أصلي(ف، cx + 20، cy + 40، cx + cw - 20، cy + 40، ل_رمادي_غ)

        # مستوى الصوت
        ارسم_نص_أصلي(ف، cx + 20، cy + 60، "Volume:"، 1، ل_رمادي)
        هذا.رسم_شريط_تمرير(ف، cx + 20، cy + 82، 350، هذا.مستوى_صوت، ل_أخضر)

        # وضع الصامت
        ارسم_نص_أصلي(ف، cx + 20، cy + 125، "Mute:"، 1، ل_رمادي)
        هذا.رسم_تبديل(ف، cx + 100، cy + 123، هذا.صامت)

        # مؤشرات بصرية للصوت
        ارسم_نص_أصلي(ف، cx + 20، cy + 175، "Audio Levels:"، 1، ل_رمادي)
        متغير بار = 0
        بينما (بار < 20)
            متغير بار_ا = 10 + بار * 4
            متغير بار_لون = ل_أخضر
            اذا (بار > 15)
                بار_لون = ل_أحمر
            والا
                اذا (بار > 10)
                    بار_لون = ل_أصفر
                نهاية
            نهاية

            اذا (بار * 5 <= هذا.مستوى_صوت)
                ارسم_مستطيل_أصلي(ف، cx + 20 + بار * 20، cy + 270 - بار_ا، 15، بار_ا، بار_لون)
            والا
                ارسم_مستطيل_أصلي(ف، cx + 20 + بار * 20، cy + 270 - بار_ا، 15، بار_ا، ل_رمادي_غ)
            نهاية
            بار = بار + 1
        نهاية

        ارجع 1
    نهاية

    # رسم محتوى الشبكة
    دالة رسم_شبكة(ف، cx، cy، cw، ch)
        ارسم_نص_أصلي(ف، cx + 20، cy + 15، "Network Settings"، 2، ل_برتقالي)
        ارسم_خط_أصلي(ف، cx + 20، cy + 40، cx + cw - 20، cy + 40، ل_رمادي_غ)

        # WiFi
        ارسم_نص_أصلي(ف، cx + 20، cy + 60، "WiFi:"، 1، ل_رمادي)
        هذا.رسم_تبديل(ف، cx + 100، cy + 58، هذا.واي_فاي)

        # الشبكة الحالية
        ارسم_نص_أصلي(ف، cx + 20، cy + 100، "Connected to:"، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، cx + 20، cy + 120، هذا.اسم_شبكة، 2، ل_أبيض)

        # قوة الإشارة
        ارسم_نص_أصلي(ف، cx + 20، cy + 160، "Signal Strength:"، 1، ل_رمادي)
        متغير قوة = 75
        هذا.رسم_شريط_تمرير(ف، cx + 20، cy + 180، 350، قوة، ل_برتقالي)

        # قائمة الشبكات
        ارسم_نص_أصلي(ف، cx + 20، cy + 225، "Available Networks:"، 1، ل_رمادي)

        مصفوفة شبكات = ["BeeHive-5G", "BeeHive-2.4G", "Neighbor-WiFi", "Guest-Net", "IoT-Devices"]
        متغير sy = cy + 250
        متغير ش = 0
        بينما (ش < طول(شبكات))
            اذا (شبكات[ش] == هذا.اسم_شبكة)
                ارسم_مستطيل_أصلي(ف، cx + 20، sy، cw - 40، 28، امزج_لون(ل_برتقالي، ل_أسود، 70))
                ارسم_نص_أصلي(ف، cx + 50، sy + 7، شبكات[ش] + "  [Connected]"، 1، ل_أبيض)
            والا
                ارسم_نص_أصلي(ف، cx + 50، sy + 7، شبكات[ش]، 1، ل_رمادي)
            نهاية
            # أيقونة wifi
            ارسم_دائرة_أصلي(ف، cx + 35، sy + 14، 5، ل_أخضر)
            sy = sy + 32
            ش = ش + 1
        نهاية

        ارجع 1
    نهاية

    # رسم محتوى التخزين
    دالة رسم_تخزين(ف، cx، cy، cw، ch)
        ارسم_نص_أصلي(ف، cx + 20، cy + 15، "Storage"، 2، ل_أحمر)
        ارسم_خط_أصلي(ف، cx + 20، cy + 40، cx + cw - 20، cy + 40، ل_رمادي_غ)

        # القرص الرئيسي
        ارسم_نص_أصلي(ف، cx + 20، cy + 60، "Main Disk: HoneyDrive"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، cx + 20، cy + 80، "512 GB SSD - 340 GB Used"، 1، ل_رمادي)

        # شريط استخدام
        متغير استخدام = 66
        ارسم_مستطيل_أصلي(ف، cx + 20، cy + 100، 400، 20، ل_رمادي_غ)
        متغير مستخدم_ع = 400 * استخدام / 100
        ارسم_مستطيل_أصلي(ف، cx + 20، cy + 100، مستخدم_ع، 20، ل_أحمر)
        ارسم_نص_أصلي(ف، cx + 430، cy + 103، "" + استخدام + "%"، 1، ل_أبيض)

        # تفصيل الاستخدام
        ارسم_نص_أصلي(ف، cx + 20، cy + 140، "Breakdown:"، 1، ل_رمادي)

        # أشرطة التفصيل
        مصفوفة أسماء = ["System", "Apps", "Documents", "Media", "Other"]
        مصفوفة أحجام = [45, 80, 30, 120, 65]
        مصفوفة ألوان_تخزين = [ل_أحمر, ل_أزرق_غ, ل_أخضر, ل_أصفر, ل_رمادي]
        متغير by = cy + 165
        متغير ت = 0
        بينما (ت < طول(أسماء))
            ارسم_نص_أصلي(ف، cx + 20، by + 4، أسماء[ت]، 1، ل_أبيض)
            متغير شريط_ع = أحجام[ت] * 2
            ارسم_مستطيل_أصلي(ف، cx + 120، by، شريط_ع، 18، ألوان_تخزين[ت])
            ارسم_نص_أصلي(ف، cx + 125 + شريط_ع، by + 2، "" + أحجام[ت] + " GB"، 1، ل_رمادي)
            by = by + 28
            ت = ت + 1
        نهاية

        ارجع 1
    نهاية

    # رسم معلومات عن النظام
    دالة رسم_حول(ف، cx، cy، cw، ch)
        ارسم_نص_أصلي(ف، cx + 20، cy + 15، "About BeeOS"، 2، ل_أصفر)
        ارسم_خط_أصلي(ف، cx + 20، cy + 40، cx + cw - 20، cy + 40، ل_رمادي_غ)

        # شعار النحلة
        ارسم_دائرة_مصمتة(ف، cx + 80، cy + 100، 30، ل_أصفر)
        ارسم_دائرة_مصمتة(ف، cx + 80، cy + 140، 25، ل_أصفر)
        ارسم_مستطيل_أصلي(ف، cx + 55، cy + 110، 50، 8، ل_أسود)
        ارسم_مستطيل_أصلي(ف، cx + 55، cy + 125، 50، 8، ل_أسود)

        # أجنحة
        ارسم_دائرة_أصلي(ف، cx + 55، cy + 85، 15، ل_أبيض)
        ارسم_دائرة_أصلي(ف، cx + 105، cy + 85، 15، ل_أبيض)

        # معلومات
        متغير ix = cx + 160
        ارسم_نص_أصلي(ف، ix، cy + 70، "BeeOS Honeycomb"، 3، ل_أصفر)
        ارسم_نص_أصلي(ف، ix، cy + 110، "Version: 1.0.0"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، ix، cy + 135، "Build: 2024.06.HD"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، ix، cy + 160، "Kernel: QueenBee v1.0"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، ix، cy + 185، "Graphics: HoneyRender HD"، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، ix، cy + 210، "Interpreter: Sad v1.0"، 1، ل_أبيض)

        ارسم_خط_أصلي(ف، cx + 20، cy + 250، cx + cw - 20، cy + 250، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، cx + 20، cy + 270، "Written in Sad lang"، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، cx + 20، cy + 295، "1920x1080 HD native rendering"، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، cx + 20، cy + 320، "Handle-based C++ framebuffer"، 1، ل_رمادي)

        ارجع 1
    نهاية

    # رسم إطار كامل
    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي

        # خلفية سطح المكتب
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)

        # شريط المهام
        متغير لون_شريط = امزج_لون(ل_أسود، ل_أزرق_غ، 30)
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، لون_شريط)

        # نافذة الإعدادات
        متغير nx = هذا.نافذة_x
        متغير ny = هذا.نافذة_y
        متغير nw = هذا.نافذة_ع
        متغير nh = هذا.نافذة_ا

        # خلفية النافذة
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، nh، امزج_لون(ل_أسود، ل_أزرق_غ، 25))
        ارسم_إطار_أصلي(ف، nx، ny، nw، nh، 2، ل_رمادي)

        # شريط العنوان
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، 30، امزج_لون(ل_أسود، ل_رمادي_غ، 50))
        ارسم_نص_أصلي(ف، nx + 10، ny + 8، "Settings"، 1، ل_أبيض)

        # أزرار النافذة
        ارسم_مستطيل_أصلي(ف، nx + nw - 30، ny + 5، 20، 20، ل_أحمر)
        ارسم_نص_أصلي(ف، nx + nw - 25، ny + 8، "X"، 1، ل_أبيض)

        ارسم_مستطيل_أصلي(ف، nx + nw - 55، ny + 5، 20، 20، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، nx + nw - 51، ny + 8، "-"، 1، ل_أبيض)

        # الشريط الجانبي
        هذا.رسم_شريط_جانبي(ف)

        # المحتوى الرئيسي
        متغير cx = nx + 204
        متغير cy = ny + 32
        متغير cw = nw - 206
        متغير ch = nh - 34

        اذا (هذا.قسم_حالي == قسم_عام)
