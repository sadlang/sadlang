# محرر_نصوص.ص - تطبيق المفكرة / محرر النصوص
# BeeOS Notepad - HD 1920×1080
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_أزرق_غ  = -14575885
متغير ل_أخضر    = -16711936
متغير ل_أحمر    = -65536
متغير ل_برتقالي = -23296
متغير ل_بنفسجي  = -6750208

صنف مفكرة
    رقم مقبض_شاشة
    رقم مقبض_خلفي
    رقم نافذة_x
    رقم نافذة_y
    رقم نافذة_ع
    رقم نافذة_ا
    مصفوفة سطور
    رقم سطر_حالي
    رقم عمود_حالي
    نص اسم_ملف
    منطقي تم_تعديل

    باني()
        هذا.مقبض_شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.مقبض_خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
        هذا.نافذة_x = 80
        هذا.نافذة_y = 30
        هذا.نافذة_ع = 1300
        هذا.نافذة_ا = 800
        هذا.سطور = []
        هذا.سطر_حالي = 0
        هذا.عمود_حالي = 0
        هذا.اسم_ملف = "untitled.txt"
        هذا.تم_تعديل = خطأ
    نهاية

    دالة إضافة_سطر(نص_سطر)
        هذا.سطور = هذا.سطور + [نص_سطر]
    نهاية

    دالة رسم(إطار)
        متغير ف = هذا.مقبض_خلفي
        متغير nx = هذا.نافذة_x
        متغير ny = هذا.نافذة_y
        متغير nw = هذا.نافذة_ع
        متغير nh = هذا.نافذة_ا

        # خلفية سطح المكتب
        ارسم_تدرج_أفقي(ف، 0، 0، عرض_شاشة، ارت_شاشة، ل_أزرق_غ، ل_أسود)
        ارسم_مستطيل_أصلي(ف، 0، ارت_شاشة - 40، عرض_شاشة، 40، امزج_لون(ل_أسود، ل_أزرق_غ، 30))

        # النافذة
        ارسم_مستطيل_أصلي(ف، nx - 2، ny - 2، nw + 4، nh + 4، ل_رمادي_غ)
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، nh، امزج_لون(ل_أسود، ل_أبيض، 10))

        # شريط العنوان
        ارسم_مستطيل_أصلي(ف، nx، ny، nw، 30، امزج_لون(ل_أسود، ل_رمادي_غ، 60))
        متغير عنوان = "Notepad - " + هذا.اسم_ملف
        اذا (هذا.تم_تعديل)
            عنوان = عنوان + " *"
        نهاية
        ارسم_نص_أصلي(ف، nx + 10، ny + 8، عنوان، 1، ل_أبيض)

        # أزرار النافذة
        ارسم_مستطيل_أصلي(ف، nx + nw - 30، ny + 5، 20، 20، ل_أحمر)
        ارسم_نص_أصلي(ف، nx + nw - 25، ny + 8، "X"، 1، ل_أبيض)
        ارسم_مستطيل_أصلي(ف، nx + nw - 55، ny + 5، 20، 20، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، nx + nw - 51، ny + 8، "="، 1، ل_أبيض)
        ارسم_مستطيل_أصلي(ف، nx + nw - 80، ny + 5، 20، 20، ل_رمادي_غ)
        ارسم_نص_أصلي(ف، nx + nw - 76، ny + 8، "_"، 1، ل_أبيض)

        # القائمة العلوية
        متغير menu_y = ny + 30
        ارسم_مستطيل_أصلي(ف، nx، menu_y، nw، 24، امزج_لون(ل_أسود، ل_رمادي_غ، 40))
        مصفوفة قوائم = ["File", "Edit", "View", "Format", "Help"]
        متغير قم = 0
        بينما (قم < طول(قوائم))
            ارسم_نص_أصلي(ف، nx + 15 + قم * 80، menu_y + 5، قوائم[قم]، 1، ل_أبيض)
            قم = قم + 1
        نهاية

        # شريط الأدوات
        متغير tool_y = menu_y + 24
        ارسم_مستطيل_أصلي(ف، nx، tool_y، nw، 28، امزج_لون(ل_أسود، ل_رمادي_غ، 25))

        مصفوفة أدوات = ["New", "Open", "Save", "|", "Undo", "Redo", "|", "Cut", "Copy", "Paste", "|", "Find"]
        متغير أد = 0
        متغير tool_off = 10
        بينما (أد < طول(أدوات))
            اذا (أدوات[أد] == "|")
                ارسم_خط_أصلي(ف، nx + tool_off + 5، tool_y + 4، nx + tool_off + 5، tool_y + 24، ل_رمادي_غ)
                tool_off = tool_off + 15
            والا
                ارسم_مستطيل_أصلي(ف، nx + tool_off، tool_y + 3، 40، 22، امزج_لون(ل_أسود، ل_رمادي_غ، 40))
                ارسم_نص_أصلي(ف، nx + tool_off + 4، tool_y + 7، أدوات[أد]، 1، ل_رمادي)
                tool_off = tool_off + 50
            نهاية
            أد = أد + 1
        نهاية

        # منطقة أرقام الأسطر + النص
        متغير text_y = tool_y + 30
        متغير text_h = nh - (text_y - ny) - 28
        متغير line_num_w = 50

        # خلفية أرقام الأسطر
        ارسم_مستطيل_أصلي(ف، nx، text_y، line_num_w، text_h، امزج_لون(ل_أسود، ل_رمادي_غ، 30))

        # خلفية النص
        ارسم_مستطيل_أصلي(ف، nx + line_num_w، text_y، nw - line_num_w، text_h، امزج_لون(ل_أسود، ل_أبيض، 5))

        # رسم الأسطر
        متغير سط = 0
        متغير سطور_عدد = طول(هذا.سطور)
        بينما (سط < سطور_عدد)
            متغير ly = text_y + سط * 18
            اذا (ly + 18 > text_y + text_h)
                اخرج
            نهاية

            # تمييز السطر الحالي
            اذا (سط == هذا.سطر_حالي)
                ارسم_مستطيل_أصلي(ف، nx + line_num_w، ly، nw - line_num_w، 18، امزج_لون(ل_أزرق_غ، ل_أسود، 80))
                ارسم_مستطيل_أصلي(ف، nx، ly، line_num_w، 18، امزج_لون(ل_أزرق_غ، ل_أسود، 60))
            نهاية

            # رقم السطر
            ارسم_نص_أصلي(ف، nx + 5، ly + 2، "" + (سط + 1)، 1، ل_رمادي)

            # محتوى السطر
            متغير محتوى = هذا.سطور[سط]
            متغير لون_نص = ل_أبيض

            # تلوين بسيط: الكلمات المفتاحية
            اذا (طول(محتوى) > 0)
                # تلوين الكلمات المفتاحية العربية
                متغير أول_حرف = ""
                اذا (طول(محتوى) >= 4)
                    أول_حرف = محتوى
                نهاية

                ارسم_نص_أصلي(ف، nx + line_num_w + 10، ly + 2، محتوى، 1، لون_نص)
            نهاية

            # مؤشر الكتابة (خط عمودي وامض)
            اذا (سط == هذا.سطر_حالي)
                متغير cursor_x = nx + line_num_w + 10 + هذا.عمود_حالي * 8
                ارسم_خط_أصلي(ف، cursor_x، ly + 1، cursor_x، ly + 16، ل_أصفر)
                ارسم_خط_أصلي(ف، cursor_x + 1، ly + 1، cursor_x + 1، ly + 16، ل_أصفر)
            نهاية

            سط = سط + 1
        نهاية

        # شريط الخط الفاصل
        ارسم_خط_أصلي(ف، nx + line_num_w، text_y، nx + line_num_w، text_y + text_h، ل_رمادي_غ)

        # شريط الحالة
        متغير status_y = ny + nh - 24
        ارسم_مستطيل_أصلي(ف، nx، status_y، nw، 24، امزج_لون(ل_أسود، ل_رمادي_غ، 50))
        ارسم_نص_أصلي(ف، nx + 10، status_y + 5، "Line: " + (هذا.سطر_حالي + 1) + "  Col: " + (هذا.عمود_حالي + 1)، 1، ل_أبيض)
        ارسم_نص_أصلي(ف، nx + 250، status_y + 5، "Lines: " + سطور_عدد، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، nx + 400، status_y + 5، "UTF-8"، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، nx + 500، status_y + 5، "LF"، 1، ل_رمادي)
        ارسم_نص_أصلي(ف، nx + nw - 180، status_y + 5، "Sad Language"، 1، ل_أصفر)

        # شريط تمرير عمودي
        متغير scroll_x = nx + nw - 14
        ارسم_مستطيل_أصلي(ف، scroll_x، text_y، 14، text_h، ل_رمادي_غ)
        متغير thumb_h = 60
        اذا (سطور_عدد > 0)
            متغير thumb_y = text_y + هذا.سطر_حالي * (text_h - thumb_h) / سطور_عدد
            ارسم_مستطيل_أصلي(ف، scroll_x + 2، thumb_y، 10، thumb_h، ل_رمادي)
        نهاية

        انسخ_منطقة(ف، هذا.مقبض_شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)
        ارجع 1
    نهاية

    دالة تصدير(مسار)
        صدر_مخزن_ppm(هذا.مقبض_شاشة، مسار)
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== BeeOS Notepad ===")

    متغير محرر = جديد مفكرة()
    اطبع_سطر("[NOTEPAD] Initialized")

    # ملء بكود ص كمثال
    محرر.اسم_ملف = "hello.sad"
    محرر.إضافة_سطر("# BeeOS Hello World")
    محرر.إضافة_سطر("")
    محرر.إضافة_سطر("var message = 'Hello BeeOS!'")
    محرر.إضافة_سطر("var count = 10")
    محرر.إضافة_سطر("")
    محرر.إضافة_سطر("function greet(name)")
    محرر.إضافة_سطر("    print('Hello ' + name)")
    محرر.إضافة_سطر("    return 1")
    محرر.إضافة_سطر("end")
    محرر.إضافة_سطر("")
    محرر.إضافة_سطر("if (count > 5)")
    محرر.إضافة_سطر("    greet('World')")
    محرر.إضافة_سطر("else")
    محرر.إضافة_سطر("    print('Too few')")
    محرر.إضافة_سطر("end")
    محرر.إضافة_سطر("")
    محرر.إضافة_سطر("# Loop example")
    محرر.إضافة_سطر("var i = 0")
    محرر.إضافة_سطر("while (i < count)")
    محرر.إضافة_سطر("    print(i)")
    محرر.إضافة_سطر("    i = i + 1")
    محرر.إضافة_سطر("end")
    محرر.إضافة_سطر("")
    محرر.إضافة_سطر("class Bee")
    محرر.إضافة_سطر("    constructor(n)")
    محرر.إضافة_سطر("        this.name = n")
    محرر.إضافة_سطر("    end")
    محرر.إضافة_سطر("    function buzz()")
    محرر.إضافة_سطر("        print(this.name + ' buzz!')")
    محرر.إضافة_سطر("    end")
    محرر.إضافة_سطر("end")

    محرر.سطر_حالي = 6
    محرر.عمود_حالي = 12
    محرر.تم_تعديل = خطأ

    # إطار 1: ملف مفتوح
    اطبع_سطر("-- Frame 1: File open --")
    محرر.رسم(1)
    محرر.تصدير("C:\\beeos_notepad.ppm")

    # إطار 2: تعديل الملف
    اطبع_سطر("-- Frame 2: Editing --")
    محرر.سطر_حالي = 19
    محرر.عمود_حالي = 15
    محرر.تم_تعديل = صحيح
    محرر.رسم(2)
    محرر.تصدير("C:\\beeos_notepad_edit.ppm")

    # إطار 3: أعلى الملف
    اطبع_سطر("-- Frame 3: Top of file --")
    محرر.سطر_حالي = 0
    محرر.عمود_حالي = 0
    محرر.رسم(3)
    محرر.تصدير("C:\\beeos_notepad_top.ppm")

    متغير أسود = عد_بكسلات(محرر.مقبض_شاشة، ل_أسود)
    متغير إجمالي = عرض_شاشة * ارت_شاشة
    اطبع("Non-black: ")
    اطبع_سطر(إجمالي - أسود)

    اطبع_سطر("=== Notepad: SUCCESS ===")
    ارجع 0
نهاية
