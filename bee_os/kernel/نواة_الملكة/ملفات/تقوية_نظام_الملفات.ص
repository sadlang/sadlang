    رقم معرّف_العقدة
    رقم فئة_المُدخلة

    باني(نص الاسم_ل، رقم المعرّف_ل، رقم الفئة_ل)
        الاسم_م = الاسم_ل
        معرّف_العقدة = المعرّف_ل
        فئة_المُدخلة = الفئة_ل
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف سجل_عملية - عملية واحدة في السجل (Journal Entry)
# ─────────────────────────────────────────────────────────────────────────────
صنف سجل_عملية
    ## عملية مُسجّلة في سجل التغييرات

    رقم الرقم_التسلسلي
    رقم فئة_العملية          # سجل_إنشاء / سجل_حذف / ...
    رقم معرّف_العقدة_المتأثرة
    نص المسار_المتأثر
    رقم الكتلة_المتأثرة
    منطقي مُكتملة

    باني(رقم رقم_ت، رقم الفئة_ل، رقم المعرّف_ل، نص المسار_ل)
        الرقم_التسلسلي = رقم_ت
        فئة_العملية = الفئة_ل
        معرّف_العقدة_المتأثرة = المعرّف_ل
        المسار_المتأثر = المسار_ل
        الكتلة_المتأثرة = 0
        مُكتملة = خطأ
    نهاية

    دالة أكمل()
        مُكتملة = صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف سجل_التغييرات - شمع التوبة (Journaling)
# ─────────────────────────────────────────────────────────────────────────────
صنف سجل_التغييرات
    ## سجل التغييرات (Journal) - شمع التوبة
    ## يضمن سلامة البيانات عند الأعطال

    مصفوفة العمليات
    رقم العداد
    رقم آخر_نقطة_توبة        # آخر checkpoint

    باني()
        العمليات = []
        العداد = 0
        آخر_نقطة_توبة = 0
    نهاية

    ## بدء عملية جديدة
    دالة رقم ابدأ_عملية(رقم الفئة_ل، رقم المعرّف_ل، نص المسار_ل)
        العداد = العداد + 1
        متغير عملية_ج = جديد سجل_عملية(العداد، الفئة_ل، المعرّف_ل، المسار_ل)
        العمليات += [عملية_ج]
        ارجع العداد
    نهاية

    ## إتمام عملية
    دالة أتمم_عملية(رقم رقم_العملية)
        متغير ف = 0
        بينما (ف < طول(العمليات))
            اذا (العمليات[ف].الرقم_التسلسلي == رقم_العملية)
                العمليات[ف].أكمل()
                ارجع 0
            نهاية
            ف = ف + 1
        نهاية
    نهاية

    ## نقطة توبة (Checkpoint)
    دالة نقطة_توبة()
        # حذف العمليات المكتملة القديمة
        متغير جديدة = []
        متغير ف = 0
        بينما (ف < طول(العمليات))
            اذا (!العمليات[ف].مُكتملة)
                جديدة += [العمليات[ف]]
            نهاية
            ف = ف + 1
        نهاية
        العمليات = جديدة
        آخر_نقطة_توبة = العداد
    نهاية

    ## التعافي - إعادة العمليات غير المكتملة
    دالة رقم تعافي()
        متغير غير_مكتملة = 0
        متغير ف = 0
        بينما (ف < طول(العمليات))
            اذا (!العمليات[ف].مُكتملة)
                غير_مكتملة = غير_مكتملة + 1
            نهاية
            ف = ف + 1
        نهاية
        ارجع غير_مكتملة
    نهاية

    ## عدد العمليات المُعلّقة
    دالة رقم عدد_معلّقة()
        متغير عدد_م = 0
        متغير ف = 0
        بينما (ف < طول(العمليات))
            اذا (!العمليات[ف].مُكتملة)
                عدد_م = عدد_م + 1
            نهاية
            ف = ف + 1
        نهاية
        ارجع عدد_م
    نهاية

    دالة اطبع_إحصاءات()
        اطبع("  📝 إجمالي العمليات: ") اطبع_سطر(العداد)
        اطبع("  ⏳ معلّقة: ") اطبع_سطر(عدد_معلّقة())
        اطبع("  🔖 آخر نقطة توبة: ") اطبع_سطر(آخر_نقطة_توبة)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف ذاكرة_مؤقتة - Buffer Cache
# ─────────────────────────────────────────────────────────────────────────────
صنف ذاكرة_مؤقتة
    ## ذاكرة مؤقتة للكتل - تقلل القراءة من القرص

    مصفوفة فهارس_محمّلة     # فهارس الكتل المحمّلة
    مصفوفة بيانات_محمّلة     # البيانات (محاكاة)
    مصفوفة متسخة             # هل الكتلة مُعدّلة؟
    مصفوفة آخر_وصول          # وقت آخر استخدام
    رقم سعة_ذ
    رقم إصابات
    رقم إخفاقات
    رقم عداد_وصول

    باني()
        فهارس_محمّلة = []
        بيانات_محمّلة = []
        متسخة = []
        آخر_وصول = []
        سعة_ذ = 64
        إصابات = 0
        إخفاقات = 0
        عداد_وصول = 0
    نهاية

    ## البحث عن كتلة في الذاكرة المؤقتة
    دالة رقم ابحث(رقم فهرس_ك)
        متغير ف = 0
        بينما (ف < طول(فهارس_محمّلة))
            اذا (فهارس_محمّلة[ف] == فهرس_ك)
                إصابات = إصابات + 1
                عداد_وصول = عداد_وصول + 1
                آخر_وصول[ف] = عداد_وصول
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        إخفاقات = إخفاقات + 1
        ارجع -1
    نهاية

    ## إضافة كتلة للذاكرة المؤقتة
    دالة أضف(رقم فهرس_ك، رقم بيانات_ك)
        عداد_وصول = عداد_وصول + 1

        اذا (طول(فهارس_محمّلة) >= سعة_ذ)
            # طرد أقدم كتلة (LRU)
            متغير أقدم_فهرس = 0
            متغير أقدم_وقت = آخر_وصول[0]
            متغير ف = 1
            بينما (ف < طول(آخر_وصول))
                اذا (آخر_وصول[ف] < أقدم_وقت)
                    أقدم_وقت = آخر_وصول[ف]
                    أقدم_فهرس = ف
                نهاية
                ف = ف + 1
            نهاية
            # استبدال
            فهارس_محمّلة[أقدم_فهرس] = فهرس_ك
            بيانات_محمّلة[أقدم_فهرس] = بيانات_ك
            متسخة[أقدم_فهرس] = 0
            آخر_وصول[أقدم_فهرس] = عداد_وصول
        والا
            فهارس_محمّلة += [فهرس_ك]
            بيانات_محمّلة += [بيانات_ك]
            متسخة += [0]
            آخر_وصول += [عداد_وصول]
        نهاية
    نهاية

    ## تعليم كتلة كمُتّسخة
    دالة علّم_متسخة(رقم فهرس_ك)
        متغير موقع = ابحث(فهرس_ك)
        اذا (موقع >= 0)
            متسخة[موقع] = 1
        نهاية
    نهاية

    ## مسح الكتل المُتّسخة (flush)
    دالة رقم امسح()
        متغير مكتوبة = 0
        متغير ف = 0
        بينما (ف < طول(متسخة))
            اذا (متسخة[ف] == 1)
                # في الواقع: كتابة على القرص
                متسخة[ف] = 0
                مكتوبة = مكتوبة + 1
            نهاية
            ف = ف + 1
        نهاية
        ارجع مكتوبة
    نهاية

    ## نسبة الإصابة (0-100)
    دالة رقم نسبة_إصابة()
        متغير إجمالي = إصابات + إخفاقات
        اذا (إجمالي == 0) ارجع 0 نهاية
        ارجع (إصابات * 100) / إجمالي
    نهاية

    دالة اطبع_إحصاءات()
        اطبع("  💾 كتل محمّلة: ") اطبع_سطر(طول(فهارس_محمّلة))
        اطبع("  ✅ إصابات: ") اطبع_سطر(إصابات)
        اطبع("  ❌ إخفاقات: ") اطبع_سطر(إخفاقات)
        اطبع("  📊 نسبة الإصابة: ") اطبع(نسبة_إصابة()) اطبع_سطر("%")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف لقطة - Snapshot (CoW)
# ─────────────────────────────────────────────────────────────────────────────
صنف لقطة
    ## لقطة لنظام الملفات (Copy-on-Write)

    رقم المعرّف_ل
    نص الاسم_ل
    رقم وقت_اللقطة
    مصفوفة عقد_اللقطة         # نسخة من معرّفات العقد
    مصفوفة كتل_اللقطة          # نسخة من فهارس الكتل
    منطقي نشطة

    باني(رقم المعرّف_ج، نص الاسم_ج)
        المعرّف_ل = المعرّف_ج
        الاسم_ل = الاسم_ج
        وقت_اللقطة = 0
        عقد_اللقطة = []
        كتل_اللقطة = []
        نشطة = صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف واصف_ملف - File Descriptor
# ─────────────────────────────────────────────────────────────────────────────
صنف واصف_ملف
    ## واصف ملف مفتوح

    رقم الرقم_و               # رقم الواصف
    رقم معرّف_عقدة_و          # عقدة الملف
    رقم وضع_الفتح            # قراءة / كتابة / إلحاق
    رقم موقع_الرأس           # الموقع الحالي في الملف
    منطقي مفتوح

    باني(رقم الرقم_ج، رقم المعرّف_ج، رقم الوضع_ج)
        الرقم_و = الرقم_ج
        معرّف_عقدة_و = المعرّف_ج
        وضع_الفتح = الوضع_ج
        موقع_الرأس = 0
        مفتوح = صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف فاحص_السلامة - fsck
# ─────────────────────────────────────────────────────────────────────────────
صنف فاحص_السلامة
    ## فاحص سلامة نظام الملفات

    رقم عقد_مفحوصة
    رقم كتل_مفحوصة
    رقم أخطاء_وُجدت
    رقم إصلاحات
    مصفوفة تقارير

    باني()
        عقد_مفحوصة = 0
        كتل_مفحوصة = 0
        أخطاء_وُجدت = 0
        إصلاحات = 0
        تقارير = []
    نهاية

    ## فحص عقدة
    دالة افحص_عقدة(رقم المعرّف_ل، رقم الفئة_ل، رقم المقاس_ل، رقم عدد_كتل)
        عقد_مفحوصة = عقد_مفحوصة + 1

        # التحقق من صنف صالح
        اذا (الفئة_ل < 1 || الفئة_ل > 5)
            أخطاء_وُجدت = أخطاء_وُجدت + 1
            تقارير += ["عقدة " + المعرّف_ل + ": صنف غير صالح"]
        نهاية

        # التحقق من تطابق الحجم مع الكتل
        متغير كتل_متوقعة = المقاس_ل / ملف_مقاس_كتلة
        اذا (المقاس_ل % ملف_مقاس_كتلة > 0)
            كتل_متوقعة = كتل_متوقعة + 1
        نهاية
    نهاية

    ## فحص كتلة
    دالة افحص_كتلة(رقم فهرس_ك، رقم مخصصة)
        كتل_مفحوصة = كتل_مفحوصة + 1
        اذا (فهرس_ك < 0)
            أخطاء_وُجدت = أخطاء_وُجدت + 1
            تقارير += ["كتلة سالبة: " + فهرس_ك]
        نهاية
    نهاية

    ## إصلاح
    دالة أصلح()
        # في الحقيقي: إصلاح الأخطاء المكتشفة
        إصلاحات = أخطاء_وُجدت
    نهاية

    دالة اطبع_تقرير()
        اطبع_سطر("══════ تقرير فحص السلامة ══════")
        اطبع("  عقد مفحوصة: ") اطبع_سطر(عقد_مفحوصة)
        اطبع("  كتل مفحوصة: ") اطبع_سطر(كتل_مفحوصة)
        اطبع("  أخطاء: ") اطبع_سطر(أخطاء_وُجدت)
        اطبع("  إصلاحات: ") اطبع_سطر(إصلاحات)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# المتغيرات العامة (بديل تركيب الأصناف)
# ─────────────────────────────────────────────────────────────────────────────
متغير ع_مخصّص = جديد مُخصّص_الكتل()
متغير ع_سجل = جديد سجل_التغييرات()
متغير ع_ذاكرة = جديد ذاكرة_مؤقتة()
متغير ع_فاحص = جديد فاحص_السلامة()

# ─────────────────────────────────────────────────────────────────────────────
# صنف نظام_الملفات_المُقوّى - النظام الرئيسي
# ─────────────────────────────────────────────────────────────────────────────
صنف نظام_الملفات_المُقوّى
    ## نظام ملفات BeeFS المُقوّى مع journal + cache + CoW

    مصفوفة العقد               # جميع العقد (inodes)
    مصفوفة الأدلة              # مدخلات الأدلة: [دليل_أب_معرّف، إدخال]
    مصفوفة الملفات_المفتوحة    # واصفات الملفات المفتوحة
    مصفوفة اللقطات             # لقطات النظام
    رقم عداد_العقد
    رقم عداد_الواصفات
    رقم عداد_اللقطات
    منطقي جاهز

    باني()
        العقد = []
        الأدلة = []
        الملفات_المفتوحة = []
        اللقطات = []
        عداد_العقد = 10         # أول 10 محجوزة
        عداد_الواصفات = 0
        عداد_اللقطات = 0
        جاهز = خطأ
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## تهيئة النظام
    ## ══════════════════════════════════════════════════════════════════
    دالة هيئ_النظام(رقم عدد_كتل)
        اطبع("🐝 BeeFS المُقوّى: بدء التهيئة")

        # تهيئة مُخصّص الكتل
        ع_مخصّص.هيئ(عدد_كتل)

        # إنشاء عقدة الجذر (معرّف = 2)
        عداد_العقد = 2
        متغير جذر = جديد عقدة_ملفات(2، فئة_دليل)
        جذر.أذونات_قيمة = 493     # 0755
        جذر.عدد_روابط = 2         # . و ..
        العقد += [جذر]
        عداد_العقد = 3

        # تسجيل في السجل
        متغير رقم_ع = ع_سجل.ابدأ_عملية(سجل_إنشاء، 2، "/")
        ع_سجل.أتمم_عملية(رقم_ع)

        # إنشاء المجلدات الأساسية
        أنشئ_دليل_داخلي(2، "نظام")
        أنشئ_دليل_داخلي(2، "مستخدمون")
        أنشئ_دليل_داخلي(2، "أجهزة")
        أنشئ_دليل_داخلي(2، "مؤقت")
        أنشئ_دليل_داخلي(2، "إقلاع")
        أنشئ_دليل_داخلي(2، "تطبيقات")

        جاهز = صحيح
        اطبع_سطر("🐝 BeeFS المُقوّى: جاهز")
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## إنشاء دليل داخلي
    ## ══════════════════════════════════════════════════════════════════
    دالة رقم أنشئ_دليل_داخلي(رقم دليل_أب، نص الاسم_ج)
        # تخصيص عقدة جديدة
        متغير معرّف_ج = عداد_العقد
        عداد_العقد = عداد_العقد + 1

        متغير عقدة_ج = جديد عقدة_ملفات(معرّف_ج، فئة_دليل)
        عقدة_ج.أذونات_قيمة = 493
        عقدة_ج.عدد_روابط = 2
        العقد += [عقدة_ج]

        # إضافة مدخلة في الدليل الأب
        متغير مُدخلة = جديد إدخال_دليل_م(الاسم_ج، معرّف_ج، فئة_دليل)
        الأدلة += [مُدخلة]

        # تسجيل في السجل
        متغير رقم_ع = ع_سجل.ابدأ_عملية(سجل_إنشاء، معرّف_ج، الاسم_ج)
        ع_سجل.أتمم_عملية(رقم_ع)

        ارجع معرّف_ج
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## إنشاء ملف
    ## ══════════════════════════════════════════════════════════════════
    دالة رقم أنشئ_ملف_م(رقم دليل_أب، نص الاسم_ج، رقم مالك)
        اذا (!جاهز) ارجع ملف_خطأ_تالف نهاية

        # التحقق من عدم وجود ملف بنفس الاسم
        اذا (ابحث_بالاسم(دليل_أب، الاسم_ج) != -1)
            ارجع ملف_خطأ_موجود
        نهاية

        # تخصيص عقدة
        متغير معرّف_ج = عداد_العقد
        عداد_العقد = عداد_العقد + 1

        متغير عقدة_ج = جديد عقدة_ملفات(معرّف_ج، فئة_عادي)
        عقدة_ج.مالك_المعرّف = مالك
        عقدة_ج.أذونات_قيمة = 420  # 0644
        العقد += [عقدة_ج]

        # إضافة مدخلة الدليل
        متغير مُدخلة = جديد إدخال_دليل_م(الاسم_ج، معرّف_ج، فئة_عادي)
        الأدلة += [مُدخلة]

        # تخصيص كتلة أولى
        متغير كتلة = ع_مخصّص.خصّص()
        اذا (كتلة >= 0)
            عقدة_ج.أضف_كتلة(كتلة)
            ع_ذاكرة.أضف(كتلة، 0)
        نهاية

        # التسجيل
        متغير رقم_ع = ع_سجل.ابدأ_عملية(سجل_إنشاء، معرّف_ج، الاسم_ج)
        ع_سجل.أتمم_عملية(رقم_ع)

        ارجع معرّف_ج
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## فتح ملف
    ## ══════════════════════════════════════════════════════════════════
    دالة رقم افتح_ملف(رقم معرّف_عقدة، رقم وضع_ف، رقم مستخدم)
        اذا (!جاهز) ارجع -1 نهاية

        # البحث عن العقدة
        متغير عقدة_م = جد_عقدة(معرّف_عقدة)
        اذا (عقدة_م == -1) ارجع -1 نهاية

        # فحص الأذونات
        متغير العقدة = العقد[عقدة_م]
        اذا (وضع_ف == وضع_قراءة)
            اذا (!العقدة.يمكن_قراءة(مستخدم))
                ارجع -1
            نهاية
        نهاية
        اذا (وضع_ف == وضع_كتابة || وضع_ف == وضع_إلحاق)
            اذا (!العقدة.يمكن_كتابة(مستخدم))
                ارجع -1
            نهاية
        نهاية

        # إنشاء واصف
        عداد_الواصفات = عداد_الواصفات + 1
        متغير واصف = جديد واصف_ملف(عداد_الواصفات، معرّف_عقدة، وضع_ف)
        اذا (وضع_ف == وضع_إلحاق)
            واصف.موقع_الرأس = العقدة.المقاس_ع
        نهاية
        الملفات_المفتوحة += [واصف]

        ارجع عداد_الواصفات
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## إغلاق ملف
    ## ══════════════════════════════════════════════════════════════════
    دالة أغلق_ملف(رقم رقم_واصف)
        متغير ف = 0
        بينما (ف < طول(الملفات_المفتوحة))
            اذا (الملفات_المفتوحة[ف].الرقم_و == رقم_واصف)
                الملفات_المفتوحة[ف].مفتوح = خطأ
                ارجع 0
            نهاية
            ف = ف + 1
        نهاية
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## كتابة بيانات
    ## ══════════════════════════════════════════════════════════════════
    دالة رقم اكتب(رقم رقم_واصف، رقم مقاس_بيانات)
        اذا (!جاهز) ارجع ملف_خطأ_تالف نهاية

        # البحث عن الواصف
        متغير ف = 0
        متغير وُجد = خطأ
        متغير فهرس_و = -1
        بينما (ف < طول(الملفات_المفتوحة))
            اذا (الملفات_المفتوحة[ف].الرقم_و == رقم_واصف && الملفات_المفتوحة[ف].مفتوح)
                وُجد = صحيح
                فهرس_و = ف
                اخرج
            نهاية
            ف = ف + 1
        نهاية
        اذا (!وُجد) ارجع ملف_خطأ_مفقود نهاية

        # حساب الكتل المطلوبة
        متغير كتل_مطلوبة = مقاس_بيانات / ملف_مقاس_كتلة
        اذا (مقاس_بيانات % ملف_مقاس_كتلة > 0)
            كتل_مطلوبة = كتل_مطلوبة + 1
        نهاية

        # تخصيص الكتل
        متغير عقدة_م = جد_عقدة(الملفات_المفتوحة[فهرس_و].معرّف_عقدة_و)
        اذا (عقدة_م == -1) ارجع ملف_خطأ_مفقود نهاية

        متغير ك = 0
        بينما (ك < كتل_مطلوبة)
            متغير كتلة_ج = ع_مخصّص.خصّص()
            اذا (كتلة_ج == -1) ارجع ملف_خطأ_ممتلئ نهاية
            العقد[عقدة_م].أضف_كتلة(كتلة_ج)
            ع_ذاكرة.أضف(كتلة_ج، مقاس_بيانات)
            ع_ذاكرة.علّم_متسخة(كتلة_ج)
            ك = ك + 1
        نهاية

        # تحديث الحجم
        العقد[عقدة_م].المقاس_ع = العقد[عقدة_م].المقاس_ع + مقاس_بيانات
        الملفات_المفتوحة[فهرس_و].موقع_الرأس = الملفات_المفتوحة[فهرس_و].موقع_الرأس + مقاس_بيانات

        # تسجيل العملية
        متغير رقم_ع = ع_سجل.ابدأ_عملية(سجل_كتابة، الملفات_المفتوحة[فهرس_و].معرّف_عقدة_و، "كتابة")
        ع_سجل.أتمم_عملية(رقم_ع)

        ارجع مقاس_بيانات
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## حذف ملف
    ## ══════════════════════════════════════════════════════════════════
    دالة رقم احذف_ملف_م(رقم دليل_أب، نص الاسم_ج)
        اذا (!جاهز) ارجع ملف_خطأ_تالف نهاية

        # البحث عن الملف
        متغير معرّف_ه = ابحث_بالاسم(دليل_أب، الاسم_ج)
        اذا (معرّف_ه == -1) ارجع ملف_خطأ_مفقود نهاية

        # جد العقدة
        متغير فهرس_ع = جد_عقدة(معرّف_ه)
        اذا (فهرس_ع == -1) ارجع ملف_خطأ_مفقود نهاية

        # تحرير الكتل
        متغير كتل = العقد[فهرس_ع].فهارس_الكتل
        متغير ك = 0
        بينما (ك < طول(كتل))
            ع_مخصّص.حرّر(كتل[ك])
            ك = ك + 1
        نهاية

        # ألغِ عدد الروابط
        العقد[فهرس_ع].عدد_روابط = العقد[فهرس_ع].عدد_روابط - 1

        # تسجيل العملية
        متغير رقم_ع = ع_سجل.ابدأ_عملية(سجل_حذف، معرّف_ه، الاسم_ج)
        ع_سجل.أتمم_عملية(رقم_ع)

        ارجع ملف_نجاح
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## إنشاء لقطة (Snapshot)
    ## ══════════════════════════════════════════════════════════════════
    دالة رقم أنشئ_لقطة(نص الاسم_ج)
        اذا (!جاهز) ارجع -1 نهاية

        عداد_اللقطات = عداد_اللقطات + 1
        متغير لقطة_ج = جديد لقطة(عداد_اللقطات، الاسم_ج)

        # نسخ معرّفات العقد
        متغير ع = 0
        بينما (ع < طول(العقد))
            لقطة_ج.عقد_اللقطة += [العقد[ع].المُعرّف]
            ع = ع + 1
        نهاية

        اللقطات += [لقطة_ج]

        # مسح الذاكرة المؤقتة
        ع_ذاكرة.امسح()

        ارجع عداد_اللقطات
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## فحص سلامة النظام
    ## ══════════════════════════════════════════════════════════════════
    دالة رقم افحص_سلامة()
        اذا (!جاهز) ارجع -1 نهاية

        # فحص كل العقد
        متغير ع = 0
        بينما (ع < طول(العقد))
            ع_فاحص.افحص_عقدة(
                العقد[ع].المُعرّف،
                العقد[ع].الفئة_ع،
                العقد[ع].المقاس_ع،
                العقد[ع].عدد_كتل_مستخدمة
            )

            # فحص كتل العقدة
            متغير ك = 0
            بينما (ك < طول(العقد[ع].فهارس_الكتل))
                ع_فاحص.افحص_كتلة(العقد[ع].فهارس_الكتل[ك]، 1)
                ك = ك + 1
            نهاية

            ع = ع + 1
        نهاية

        ارجع ع_فاحص.أخطاء_وُجدت
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## نقطة توبة (Sync + Checkpoint)
    ## ══════════════════════════════════════════════════════════════════
    دالة مزامنة()
        # مسح الذاكرة المؤقتة
        متغير مكتوبة = ع_ذاكرة.امسح()
        # نقطة توبة في السجل
        ع_سجل.نقطة_توبة()
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## البحث بالاسم في دليل
    ## ══════════════════════════════════════════════════════════════════
    دالة رقم ابحث_بالاسم(رقم دليل_أب، نص الاسم_ج)
        متغير ف = 0
        بينما (ف < طول(الأدلة))
            اذا (الأدلة[ف].الاسم_م == الاسم_ج)
                ارجع الأدلة[ف].معرّف_العقدة
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## البحث عن عقدة بالمعرّف
    ## ══════════════════════════════════════════════════════════════════
    دالة رقم جد_عقدة(رقم المعرّف_ل)
        متغير ف = 0
        بينما (ف < طول(العقد))
            اذا (العقد[ف].المُعرّف == المعرّف_ل)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    ## ══════════════════════════════════════════════════════════════════
    ## طباعة حالة النظام
    ## ══════════════════════════════════════════════════════════════════
    دالة اطبع_وضع()
        اطبع_سطر("🐝🐝 وضع نظام BeeFS المُقوّى 🐝🐝")
        اطبع("  عقد: ") اطبع_سطر(طول(العقد))
        اطبع("  أدلة: ") اطبع_سطر(طول(الأدلة))
        اطبع("  ملفات مفتوحة: ") اطبع_سطر(طول(الملفات_المفتوحة))
        اطبع("  لقطات: ") اطبع_سطر(طول(اللقطات))
        اطبع("  كتل حرة: ") اطبع_سطر(ع_مخصّص.عدد_حرة())
        اطبع("  استخدام القرص: ") اطبع(ع_مخصّص.نسبة_الاستخدام()) اطبع_سطر("%")
        اطبع_سطر("🐝🐝 السجل 🐝🐝")
        ع_سجل.اطبع_إحصاءات()
        اطبع_سطر("🐝🐝 الذاكرة المؤقتة 🐝🐝")
        ع_ذاكرة.اطبع_إحصاءات()
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# الاختبارات
# ═══════════════════════════════════════════════════════════════════════════

دالة اختبار_مخصّص_الكتل()
