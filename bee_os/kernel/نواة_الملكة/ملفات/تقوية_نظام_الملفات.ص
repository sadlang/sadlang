# ─────────────────────────────────────────────────────────────────────────────
# صنف مُخصّص الكتل - إدارة الكتل الحرة
# ─────────────────────────────────────────────────────────────────────────────
صنف مُخصّص_الكتل
    ## مُخصّص كتل القرص - كل عنصر 0=حر، 1=مشغول

    رقم سعة_الكتل
    مصفوفة جدول_كتل
    رقم عدد_المشغولة
    رقم آخر_بحث

    باني()
        سعة_الكتل = 0
        جدول_كتل = []
        عدد_المشغولة = 0
        آخر_بحث = 0
    نهاية

    دالة هيئ(رقم عدد_كتل)
        سعة_الكتل = عدد_كتل
        جدول_كتل = []
        متغير ع = 0
        بينما (ع < عدد_كتل)
            جدول_كتل += [0]
            ع = ع + 1
        نهاية

        # حجز أول 16 كتلة للبنية التحتية
        متغير ج = 0
        بينما (ج < 16)
            جدول_كتل[ج] = 1
            عدد_المشغولة = عدد_المشغولة + 1
            ج = ج + 1
        نهاية
        آخر_بحث = 16
    نهاية

    ## تخصيص كتلة واحدة - ارجع الفهرس أو -1
    دالة رقم خصّص()
        متغير بداية = آخر_بحث
        متغير فهرس = بداية
        بينما (فهرس < سعة_الكتل)
            اذا (جدول_كتل[فهرس] == 0)
                جدول_كتل[فهرس] = 1
                عدد_المشغولة = عدد_المشغولة + 1
                آخر_بحث = فهرس + 1
                ارجع فهرس
            نهاية
            فهرس = فهرس + 1
        نهاية
        # لف من البداية
        فهرس = 16
        بينما (فهرس < بداية)
            اذا (جدول_كتل[فهرس] == 0)
                جدول_كتل[فهرس] = 1
                عدد_المشغولة = عدد_المشغولة + 1
                آخر_بحث = فهرس + 1
                ارجع فهرس
            نهاية
            فهرس = فهرس + 1
        نهاية
        ارجع -1
    نهاية

    ## تخصيص كتل متجاورة
    دالة رقم خصّص_متجاورة(رقم مقاس_ط)
        متغير فهرس = 16
        بينما (فهرس + مقاس_ط <= سعة_الكتل)
            متغير كلها_حرة = صحيح
            متغير ت = 0
            بينما (ت < مقاس_ط)
                اذا (جدول_كتل[فهرس + ت] != 0)
                    كلها_حرة = خطأ
                    اخرج
                نهاية
                ت = ت + 1
            نهاية
            اذا (كلها_حرة)
                # وجدنا نطاقًا حرًا
                متغير ر = 0
                بينما (ر < مقاس_ط)
                    جدول_كتل[فهرس + ر] = 1
                    عدد_المشغولة = عدد_المشغولة + 1
                    ر = ر + 1
                نهاية
                ارجع فهرس
            نهاية
            فهرس = فهرس + 1
        نهاية
        ارجع -1
    نهاية

    ## تحرير كتلة
    دالة حرّر(رقم فهرس_ك)
        اذا (فهرس_ك >= 0 && فهرس_ك < سعة_الكتل)
            اذا (جدول_كتل[فهرس_ك] == 1)
                جدول_كتل[فهرس_ك] = 0
                عدد_المشغولة = عدد_المشغولة - 1
            نهاية
        نهاية
    نهاية

    ## تحرير نطاق كتل
    دالة حرّر_نطاق(رقم بدء، رقم مقاس_ط)
        متغير ع = 0
        بينما (ع < مقاس_ط)
            حرّر(بدء + ع)
            ع = ع + 1
        نهاية
    نهاية

    ## عدد الكتل الحرة
    دالة رقم عدد_حرة()
        ارجع سعة_الكتل - عدد_المشغولة
    نهاية

    ## نسبة الاستخدام (0-100)
    دالة رقم نسبة_الاستخدام()
        اذا (سعة_الكتل == 0) ارجع 0 نهاية
        ارجع (عدد_المشغولة * 100) / سعة_الكتل
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف عقدة_ملفات - inode مُقوّى
# ─────────────────────────────────────────────────────────────────────────────
صنف عقدة_ملفات
    ## عقدة معلومات الملف (inode) مع دعم CoW والأذونات

    رقم المُعرّف
    رقم الفئة_ع              # فئة_عادي / فئة_دليل / ...
    رقم المقاس_ع             # حجم بالبايت
    رقم عدد_كتل_مستخدمة
    مصفوفة فهارس_الكتل       # فهارس الكتل المخصصة

    # الأذونات
    رقم مالك_المعرّف
    رقم مجموعة_المعرّف
    رقم أذونات_قيمة           # rwxrwxrwx مشفّرة

    # الأوقات
    رقم وقت_إنشاء
    رقم وقت_تعديل
    رقم وقت_وصول

    # روابط
    رقم عدد_روابط

    # CoW
    رقم معرّف_لقطة           # 0 = أصلي
    منطقي مُعدَّل

    باني(رقم المعرّف_م، رقم الفئة_م)
        المُعرّف = المعرّف_م
        الفئة_ع = الفئة_م
        المقاس_ع = 0
        عدد_كتل_مستخدمة = 0
        فهارس_الكتل = []
        مالك_المعرّف = 0
        مجموعة_المعرّف = 0
        أذونات_قيمة = 420      # 0644
        وقت_إنشاء = 0
        وقت_تعديل = 0
        وقت_وصول = 0
        عدد_روابط = 1
        معرّف_لقطة = 0
        مُعدَّل = خطأ
    نهاية

    ## هل هذا دليل؟
    دالة منطقي دليل_ه()
        ارجع الفئة_ع == فئة_دليل
    نهاية

    ## هل هذا ملف عادي؟
    دالة منطقي عادي_ه()
        ارجع الفئة_ع == فئة_عادي
    نهاية

    ## فحص إذن القراءة لمستخدم
    دالة منطقي يمكن_قراءة(رقم معرّف_مستخدم)
        اذا (معرّف_مستخدم == 0) ارجع صحيح نهاية  # الجذر
        اذا (معرّف_مستخدم == مالك_المعرّف)
            ارجع (أذونات_قيمة >= 400)
        نهاية
        ارجع (أذونات_قيمة % 10 >= 4)
    نهاية

    ## فحص إذن الكتابة
    دالة منطقي يمكن_كتابة(رقم معرّف_مستخدم)
        اذا (معرّف_مستخدم == 0) ارجع صحيح نهاية
        اذا (معرّف_مستخدم == مالك_المعرّف)
            ارجع (أذونات_قيمة >= 200)
        نهاية
        ارجع (أذونات_قيمة % 10 >= 2)
    نهاية

    ## إضافة كتلة
    دالة أضف_كتلة(رقم فهرس_ك)
        فهارس_الكتل += [فهرس_ك]
        عدد_كتل_مستخدمة = عدد_كتل_مستخدمة + 1
        مُعدَّل = صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف إدخال_دليل_م - مدخلة دليل مُقوّاة
# ─────────────────────────────────────────────────────────────────────────────
صنف إدخال_دليل_م
    ## مدخلة في دليل مع دعم الترتيب الأبجدي

