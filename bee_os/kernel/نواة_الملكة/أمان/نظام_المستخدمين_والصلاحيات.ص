                اذا (قاعدة.النمط_م == ACL_سماح) ارجع صحيح نهاية
            نهاية
            ف = ف + 1
        نهاية

        # تحقق من صلاحيات Unix التقليدية
        ف = 0
        بينما (ف < طول(صلاحيات_الملفات))
            اذا (صلاحيات_الملفات[ف].مسار_الملف == المسار_ل)
