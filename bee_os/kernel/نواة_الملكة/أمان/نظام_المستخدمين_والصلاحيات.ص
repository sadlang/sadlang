                متغير ف_م = جد_مستخدم(uid_ل)
                متغير gid = 0
                اذا (ف_م >= 0) gid = المستخدمون[ف_م].gid_أساسي نهاية
                ارجع صلاحيات_الملفات[ف].تحقق(uid_ل، gid، الصلاحية_ل)
            نهاية
            ف = ف + 1
        نهاية

        # لا صلاحيات مُحدّدة — السماح افتراضياً
        ارجع صحيح
    نهاية

    ## إضافة قاعدة ACL
