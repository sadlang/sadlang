# ══════════════════════════════════════════════════════════════════════════════
# نظام_المستخدمين_والصلاحيات.ص - Users & Permissions لنظام خلية النحل (BeeOS)
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# نظام إدارة المستخدمين والصلاحيات الكامل مع دعم:
#
# 1. المستخدمون (Users)
#    - إنشاء / حذف / تعطيل / تفعيل
#    - UID/GID، اسم المستخدم، كلمة مرور (مُشفّرة بسيطة)
#    - مجلد المنزل (home directory)
#    - صدفة (shell) الافتراضية
#    - المستخدم الجذر (root/UID=0)
#
# 2. المجموعات (Groups)
#    - إنشاء / حذف / إضافة أعضاء / إزالة
#    - مجموعة أساسية لكل مستخدم (primary group)
#    - عضوية متعددة (secondary groups)
#
# 3. الصلاحيات (Permissions)
#    - rwx (قراءة/كتابة/تنفيذ) — 3 بتات لكل فئة
#    - مالك / مجموعة / آخرون (owner/group/others)
#    - صلاحيات ملفات ومجلدات
#    - أقنعة (umask) لصلاحيات افتراضية
#    - SUID، SGID، sticky bit
#
# 4. قوائم التحكم بالوصول (ACL)
#    - قواعد وصول إضافية لمستخدمين/مجموعات محددة
#    - سماح / رفض صريح
#
# 5. المصادقة (Authentication)
#    - تسجيل دخول بكلمة مرور
#    - تبديل المستخدم (su)
#    - صلاحيات الجذر المؤقتة (sudo)
#    - سجل تسجيل الدخول (login log)
#
# 6. نظام /etc/passwd و /etc/shadow المُحاكى
#    - ملف passwd: اسم:UID:GID:home:shell
#    - ملف shadow: اسم:hash
#
# الكلمات المحجوزة المتجنَّبة:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━
# حجم → مقاس | نهاية → عنوان_آخر | خريطة → جدول
# نوع → نمط | حالة → وضعية | صنف_ → فئة_
# جديد (كاسم متغير) → بديل آخر
# ارجع (مجرّد) → ارجع 0
#
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت نظام المستخدمين
# ─────────────────────────────────────────────────────────────────────────────

# معرّفات خاصة
ثابت UID_ROOT = 0
ثابت GID_ROOT = 0
ثابت UID_NOBODY = 65534

# وضعية المستخدم
ثابت مستخدم_نشط = 1
ثابت مستخدم_معطّل = 2
ثابت مستخدم_مقفل = 3

# صلاحيات (بتات)
# rwx = 7 (4+2+1)
ثابت صلاحية_قراءة = 4      # r = 4
ثابت صلاحية_كتابة = 2      # w = 2
ثابت صلاحية_تنفيذ = 1      # x = 1
ثابت صلاحية_كاملة = 7      # rwx = 7
ثابت صلاحية_قراءة_كتابة = 6  # rw- = 6
ثابت صلاحية_قراءة_تنفيذ = 5  # r-x = 5

# صلاحيات خاصة
ثابت SUID_BIT = 4096        # Set UID
ثابت SGID_BIT = 2048        # Set GID
ثابت STICKY_BIT = 1024      # Sticky bit

# أنماط ACL
ثابت ACL_سماح = 1
ثابت ACL_رفض = 2

# أقصى حدود
ثابت أقصى_مستخدمين = 256
ثابت أقصى_مجموعات = 64
ثابت أقصى_أعضاء_مجموعة = 32

# ─────────────────────────────────────────────────────────────────────────────
# صنف مستخدم_م - حساب مستخدم واحد
# ─────────────────────────────────────────────────────────────────────────────
صنف مستخدم_م
    ## يُمثّل حساب مستخدم واحد في النظام (مشابه لسجل /etc/passwd)

    رقم uid_م                  # معرّف المستخدم الفريد
    رقم gid_أساسي              # معرّف المجموعة الأساسية
    نص اسم_المستخدم            # اسم تسجيل الدخول
    نص كلمة_المرور_مشفّرة      # كلمة المرور المُشفّرة (hash بسيط)
    نص مجلد_المنزل             # /home/username
    نص صدفة_م                  # /bin/sh   (الصدفة الافتراضية)
    رقم الوضعية_م              # نشط / معطّل / مقفل
    مصفوفة مجموعات_ثانوية     # GIDs المجموعات الإضافية
    رقم محاولات_فاشلة          # عدد محاولات تسجيل الدخول الفاشلة
    رقم آخر_دخول               # وقت آخر تسجيل دخول ناجح
    رقم umask_م                # قناع الصلاحيات الافتراضي (022 مثلاً)

    باني(رقم uid_ل، نص الاسم_ل، نص كلمة_ل)
        uid_م = uid_ل
        gid_أساسي = uid_ل       # الافتراضي: مجموعة بنفس الـ UID
        اسم_المستخدم = الاسم_ل
        كلمة_المرور_مشفّرة = كلمة_ل
        مجلد_المنزل = "/home/" + الاسم_ل
        صدفة_م = "/bin/sh"
        الوضعية_م = مستخدم_نشط
        مجموعات_ثانوية = []
        محاولات_فاشلة = 0
        آخر_دخول = 0
        umask_م = 22     # 022 → صلاحيات الملفات الافتراضية: 755
    نهاية

    ## هل هذا المستخدم هو الجذر؟
    دالة منطقي هل_جذر()
        ارجع uid_م == UID_ROOT
    نهاية

    ## هل المستخدم نشط ويمكنه تسجيل الدخول؟
    دالة منطقي يمكنه_الدخول()
        ارجع الوضعية_م == مستخدم_نشط
    نهاية

    ## تطبيق قناع الصلاحيات (umask)
    دالة رقم طبّق_umask(رقم صلاحيات_ل)
        # umask يحذف بتات — مثلاً 777 & ~022 = 755
        # في محاكاتنا: صلاحيات - umask (مبسّط)
        متغير نتيجة = صلاحيات_ل - umask_م
        اذا (نتيجة < 0) نتيجة = 0 نهاية
        ارجع نتيجة
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مجموعة_م - مجموعة مستخدمين
# ─────────────────────────────────────────────────────────────────────────────
صنف مجموعة_م
    ## مجموعة مستخدمين (مشابهة لـ /etc/group)

    رقم gid_م                  # معرّف المجموعة
    نص اسم_المجموعة            # اسم المجموعة
    مصفوفة الأعضاء             # UIDs الأعضاء

    باني(رقم gid_ل، نص الاسم_ل)
        gid_م = gid_ل
        اسم_المجموعة = الاسم_ل
        الأعضاء = []
    نهاية

    ## إضافة عضو
    دالة منطقي أضف_عضو(رقم uid_ل)
        # تحقق من عدم التكرار
        متغير ف = 0
        بينما (ف < طول(الأعضاء))
            اذا (الأعضاء[ف] == uid_ل) ارجع خطأ نهاية   # موجود
            ف = ف + 1
        نهاية
        اذا (طول(الأعضاء) >= أقصى_أعضاء_مجموعة) ارجع خطأ نهاية
        الأعضاء += [uid_ل]
        ارجع صحيح
    نهاية

    ## إزالة عضو
    دالة منطقي أزل_عضو(رقم uid_ل)
        متغير قائمة = []
        متغير وُجد = خطأ
        متغير ف = 0
        بينما (ف < طول(الأعضاء))
            اذا (الأعضاء[ف] == uid_ل && !وُجد)
                وُجد = صحيح
            والا
                قائمة += [الأعضاء[ف]]
            نهاية
            ف = ف + 1
        نهاية
        اذا (وُجد) الأعضاء = قائمة نهاية
        ارجع وُجد
    نهاية

    ## هل عضو في المجموعة؟
    دالة منطقي هل_عضو(رقم uid_ل)
        متغير ف = 0
        بينما (ف < طول(الأعضاء))
            اذا (الأعضاء[ف] == uid_ل) ارجع صحيح نهاية
            ف = ف + 1
        نهاية
        ارجع خطأ
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف صلاحيات_ملف_م - أذونات ملف/مجلد
# ─────────────────────────────────────────────────────────────────────────────
صنف صلاحيات_ملف_م
    ## أذونات ملف على نمط Unix (owner/group/others × rwx)

    نص مسار_الملف              # مسار الملف
    رقم uid_المالك              # UID المالك
    رقم gid_المالك              # GID المجموعة المالكة
    رقم صلاحيات_المالك          # rwx المالك (0-7)
    رقم صلاحيات_المجموعة        # rwx المجموعة (0-7)
    رقم صلاحيات_الآخرين         # rwx الآخرون (0-7)
    رقم بتات_خاصة              # SUID / SGID / sticky
    منطقي هو_مجلد              # هل هو مجلد؟

    باني(نص المسار_ل، رقم uid_ل، رقم gid_ل)
        مسار_الملف = المسار_ل
        uid_المالك = uid_ل
        gid_المالك = gid_ل
        صلاحيات_المالك = صلاحية_كاملة       # 7 = rwx
        صلاحيات_المجموعة = صلاحية_قراءة_تنفيذ    # 5 = r-x
        صلاحيات_الآخرين = صلاحية_قراءة_تنفيذ     # 5 = r-x
        بتات_خاصة = 0
        هو_مجلد = خطأ
    نهاية

    ## ضبط الصلاحيات الرقمية (مثلاً 755)
    دالة ضبط_رقمي(رقم الرقم_ل)
        # 755 → مالك=7, مجموعة=5, آخرون=5
        صلاحيات_الآخرين = الرقم_ل % 10
        متغير مؤقت = (الرقم_ل - صلاحيات_الآخرين) / 10
        صلاحيات_المجموعة = مؤقت % 10
        متغير مؤقت2 = (مؤقت - صلاحيات_المجموعة) / 10
        صلاحيات_المالك = مؤقت2 % 10
    نهاية

    ## الحصول على الرقم الكامل
    دالة رقم رقم_الصلاحيات()
        ارجع صلاحيات_المالك * 100 + صلاحيات_المجموعة * 10 + صلاحيات_الآخرين
    نهاية

    ## هل يملك المستخدم صلاحية معيّنة؟
    دالة منطقي تحقق(رقم uid_ل، رقم gid_ل، رقم الصلاحية_المطلوبة)
        # الجذر يملك كل شيء
        اذا (uid_ل == UID_ROOT) ارجع صحيح نهاية

        # المالك
        اذا (uid_ل == uid_المالك)
            متغير نتيجة = صلاحيات_المالك % (الصلاحية_المطلوبة * 2)
            ارجع نتيجة >= الصلاحية_المطلوبة
        نهاية

        # المجموعة
        اذا (gid_ل == gid_المالك)
            متغير نتيجة = صلاحيات_المجموعة % (الصلاحية_المطلوبة * 2)
            ارجع نتيجة >= الصلاحية_المطلوبة
        نهاية

        # آخرون
        متغير نتيجة = صلاحيات_الآخرين % (الصلاحية_المطلوبة * 2)
        ارجع نتيجة >= الصلاحية_المطلوبة
    نهاية

    ## تمثيل نصي: rwxr-xr-x
    دالة نص نص_الصلاحيات()
        متغير ن = ""
        # المالك
        اذا (صلاحيات_المالك >= 4) ن = ن + "r" والا ن = ن + "-" نهاية
        اذا (صلاحيات_المالك % 4 >= 2) ن = ن + "w" والا ن = ن + "-" نهاية
        اذا (صلاحيات_المالك % 2 >= 1) ن = ن + "x" والا ن = ن + "-" نهاية
        # المجموعة
        اذا (صلاحيات_المجموعة >= 4) ن = ن + "r" والا ن = ن + "-" نهاية
        اذا (صلاحيات_المجموعة % 4 >= 2) ن = ن + "w" والا ن = ن + "-" نهاية
        اذا (صلاحيات_المجموعة % 2 >= 1) ن = ن + "x" والا ن = ن + "-" نهاية
        # الآخرون
        اذا (صلاحيات_الآخرين >= 4) ن = ن + "r" والا ن = ن + "-" نهاية
        اذا (صلاحيات_الآخرين % 4 >= 2) ن = ن + "w" والا ن = ن + "-" نهاية
        اذا (صلاحيات_الآخرين % 2 >= 1) ن = ن + "x" والا ن = ن + "-" نهاية
        ارجع ن
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف قاعدة_ACL - Access Control List entry
# ─────────────────────────────────────────────────────────────────────────────
صنف قاعدة_ACL
    ## قاعدة تحكم بالوصول إضافية لملف/مجلد

    نص المسار_م                # مسار الملف
    رقم النمط_م                # سماح أو رفض
    رقم uid_هدف                # UID المستخدم (-1 = أي)
    رقم gid_هدف                # GID المجموعة (-1 = أي)
    رقم الصلاحيات_م            # rwx

    باني(نص المسار_ل، رقم النمط_ل، رقم uid_ل، رقم الصلاحيات_ل)
        المسار_م = المسار_ل
        النمط_م = النمط_ل
        uid_هدف = uid_ل
        gid_هدف = -1
        الصلاحيات_م = الصلاحيات_ل
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف سجل_دخول_م - Login log entry
# ─────────────────────────────────────────────────────────────────────────────
صنف سجل_دخول_م
    ## سجل واحد لتسجيل دخول/خروج

    رقم uid_م                  # المستخدم
    نص النشاط_م                # "دخول" أو "خروج" أو "فشل" أو "sudo"
    رقم الوقت_م                # وقت الحدث
    نص التفاصيل_م             # تفاصيل إضافية

    باني(رقم uid_ل، نص النشاط_ل، رقم الوقت_ل)
        uid_م = uid_ل
        النشاط_م = النشاط_ل
        الوقت_م = الوقت_ل
        التفاصيل_م = ""
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدير_المستخدمين - User & Permission Manager
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_المستخدمين
    ## المدير المركزي لنظام المستخدمين والصلاحيات

    مصفوفة المستخدمون         # قائمة مستخدم_م
    مصفوفة المجموعات          # قائمة مجموعة_م
    مصفوفة صلاحيات_الملفات    # قائمة صلاحيات_ملف_م
    مصفوفة قواعد_ACL          # قائمة قاعدة_ACL
    مصفوفة سجل_الدخول        # قائمة سجل_دخول_م
    رقم آخر_UID               # آخر UID مُعطى
    رقم آخر_GID               # آخر GID مُعطى
    رقم المستخدم_الحالي        # UID المستخدم المسجّل حالياً
    رقم عدّاد_الوقت           # مُحاكي الوقت

    باني()
        المستخدمون = []
        المجموعات = []
        صلاحيات_الملفات = []
        قواعد_ACL = []
        سجل_الدخول = []
        آخر_UID = 0
        آخر_GID = 0
        المستخدم_الحالي = -1
        عدّاد_الوقت = 1000

        # إنشاء المستخدم الجذر تلقائياً
        متغير جذر = جديد مستخدم_م(UID_ROOT، "root"، "root_hash_123")
        جذر.مجلد_المنزل = "/root"
        جذر.gid_أساسي = GID_ROOT
        جذر.umask_م = 22
        المستخدمون += [جذر]

        # إنشاء مجموعة root
        متغير مجموعة_جذر = جديد مجموعة_م(GID_ROOT، "root")
        مجموعة_جذر.أضف_عضو(UID_ROOT)
        المجموعات += [مجموعة_جذر]
    نهاية

    ## إنشاء مستخدم
    دالة رقم أنشئ_مستخدم(نص الاسم_ل، نص كلمة_ل)
        # تحقق من عدم تكرار الاسم
        متغير ف = 0
        بينما (ف < طول(المستخدمون))
            اذا (المستخدمون[ف].اسم_المستخدم == الاسم_ل)
                ارجع -1     # موجود مسبقاً
            نهاية
            ف = ف + 1
        نهاية

        آخر_UID = آخر_UID + 1
        متغير مستخدم = جديد مستخدم_م(آخر_UID، الاسم_ل، كلمة_ل)
        المستخدمون += [مستخدم]

        # إنشاء مجموعة أساسية بنفس الاسم
        آخر_GID = آخر_GID + 1
        متغير مجم = جديد مجموعة_م(آخر_GID، الاسم_ل)
        مجم.أضف_عضو(آخر_UID)
        المجموعات += [مجم]

        مستخدم.gid_أساسي = آخر_GID
        ارجع آخر_UID
    نهاية

    ## البحث عن مستخدم بالـ UID
    دالة رقم جد_مستخدم(رقم uid_ل)
        متغير ف = 0
        بينما (ف < طول(المستخدمون))
            اذا (المستخدمون[ف].uid_م == uid_ل)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    ## البحث عن مستخدم بالاسم
    دالة رقم جد_بالاسم(نص الاسم_ل)
        متغير ف = 0
        بينما (ف < طول(المستخدمون))
            اذا (المستخدمون[ف].اسم_المستخدم == الاسم_ل)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    ## تعطيل مستخدم
    دالة منطقي عطّل_مستخدم(رقم uid_ل)
        متغير ف = جد_مستخدم(uid_ل)
        اذا (ف < 0) ارجع خطأ نهاية
        اذا (uid_ل == UID_ROOT) ارجع خطأ نهاية   # لا يمكن تعطيل الجذر
        المستخدمون[ف].الوضعية_م = مستخدم_معطّل
        ارجع صحيح
    نهاية

    ## تفعيل مستخدم
    دالة منطقي فعّل_مستخدم(رقم uid_ل)
        متغير ف = جد_مستخدم(uid_ل)
        اذا (ف < 0) ارجع خطأ نهاية
        المستخدمون[ف].الوضعية_م = مستخدم_نشط
        ارجع صحيح
    نهاية

    ## تسجيل الدخول
    دالة منطقي سجّل_دخول(نص الاسم_ل، نص كلمة_ل)
        عدّاد_الوقت = عدّاد_الوقت + 1
        متغير ف = جد_بالاسم(الاسم_ل)
        اذا (ف < 0)
            ارجع خطأ
        نهاية

        متغير م = المستخدمون[ف]

        # تحقق من الوضعية
        اذا (!م.يمكنه_الدخول())
            متغير مُدخل_م = جديد سجل_دخول_م(م.uid_م، "فشل"، عدّاد_الوقت)
            مُدخل_م.التفاصيل_م = "حساب معطّل"
            سجل_الدخول += [مُدخل_م]
            ارجع خطأ
        نهاية

        # تحقق من كلمة المرور
        اذا (م.كلمة_المرور_مشفّرة != كلمة_ل)
            # محاولة فاشلة
            م.محاولات_فاشلة = م.محاولات_فاشلة + 1

            # قفل بعد 5 محاولات
            اذا (م.محاولات_فاشلة >= 5)
                م.الوضعية_م = مستخدم_مقفل
            نهاية

            متغير مُدخل_م = جديد سجل_دخول_م(م.uid_م، "فشل"، عدّاد_الوقت)
            مُدخل_م.التفاصيل_م = "كلمة مرور خاطئة"
            سجل_الدخول += [مُدخل_م]
