                            س = س + 1
                        نهاية
                        متغير اسم_ملف_ح = إدخال_ق[0]
                        متغير محدث = [اسم_ملف_ح، محتوى_كامل]
                        هذا.نظام_الملفات[ع_ف] = محدث
                    نهاية
                    ع_ف = ع_ف + 1
                نهاية
            نهاية
            ارجع 0
        نهاية
        ارجع -1
    نهاية

    ## fwrite — كتابة إلى ملف
    دالة fwrite(واصفة، بيانات)
