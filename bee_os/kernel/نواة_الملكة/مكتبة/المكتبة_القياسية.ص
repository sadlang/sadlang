# القسم 5: الترتيب والبحث (stdlib.h)
# ═══════════════════════════════════════════════════════════════════════════
#
# محاكاة qsort (ترتيب سريع)، bsearch (بحث ثنائي)،
# ودوال مساعدة أخرى
# ═══════════════════════════════════════════════════════════════════════════

صنف دوال_الترتيب_م

    باني()
    نهاية

    ## bubble_sort — ترتيب فقاعي (بسيط)
    ## يرتب المصفوفة تصاعدياً
    دالة ترتيب_فقاعي(مصفوفة_مدخلة)
        متغير ن = طول(مصفوفة_مدخلة)
        متغير ع = 0
        بينما (ع < ن)
            متغير ج = 0
            بينما (ج < ن - ع - 1)
                اذا (مصفوفة_مدخلة[ج] > مصفوفة_مدخلة[ج + 1])
                    # تبديل
                    متغير مؤقت = مصفوفة_مدخلة[ج]
                    مصفوفة_مدخلة[ج] = مصفوفة_مدخلة[ج + 1]
                    مصفوفة_مدخلة[ج + 1] = مؤقت
                نهاية
                ج = ج + 1
            نهاية
            ع = ع + 1
        نهاية
        ارجع مصفوفة_مدخلة
    نهاية

    ## insertion_sort — ترتيب إدراجي
    دالة ترتيب_إدراجي(مصفوفة_مدخلة)
        متغير ن = طول(مصفوفة_مدخلة)
        متغير ع = 1
        بينما (ع < ن)
            متغير مفتاح = مصفوفة_مدخلة[ع]
            متغير ج = ع - 1
            بينما (ج >= 0 && مصفوفة_مدخلة[ج] > مفتاح)
                مصفوفة_مدخلة[ج + 1] = مصفوفة_مدخلة[ج]
                ج = ج - 1
            نهاية
            مصفوفة_مدخلة[ج + 1] = مفتاح
            ع = ع + 1
        نهاية
        ارجع مصفوفة_مدخلة
    نهاية

    ## selection_sort — ترتيب انتقائي
    دالة ترتيب_انتقائي(مصفوفة_مدخلة)
        متغير ن = طول(مصفوفة_مدخلة)
        متغير ع = 0
        بينما (ع < ن - 1)
            متغير أصغر_فهرس = ع
            متغير ج = ع + 1
            بينما (ج < ن)
                اذا (مصفوفة_مدخلة[ج] < مصفوفة_مدخلة[أصغر_فهرس])
                    أصغر_فهرس = ج
                نهاية
                ج = ج + 1
            نهاية
            # تبديل
            اذا (أصغر_فهرس != ع)
                متغير مؤقت_ان = مصفوفة_مدخلة[ع]
                مصفوفة_مدخلة[ع] = مصفوفة_مدخلة[أصغر_فهرس]
                مصفوفة_مدخلة[أصغر_فهرس] = مؤقت_ان
            نهاية
            ع = ع + 1
        نهاية
        ارجع مصفوفة_مدخلة
    نهاية

    ## bsearch — بحث ثنائي في مصفوفة مرتبة
    ## يُرجع الفهرس أو -1
    ## ملاحظة: نحسب الوسط بدون قسمة / 2 لتجنب الأعداد العشرية
    دالة بحث_ثنائي(مصفوفة_مدخلة، هدف)
        متغير يسار = 0
        متغير يمين = طول(مصفوفة_مدخلة) - 1
        بينما (يسار <= يمين)
            # حساب الوسط يدوياً بدون قسمة عشرية
            متغير مجموع_حدود = يسار + يمين
            متغير وسط = 0
            متغير عداد_م = 0
            بينما (عداد_م + عداد_م <= مجموع_حدود)
                وسط = عداد_م
                عداد_م = عداد_م + 1
            نهاية
            اذا (مصفوفة_مدخلة[وسط] == هدف)
                ارجع وسط
            والا_اذا (مصفوفة_مدخلة[وسط] < هدف)
                يسار = وسط + 1
            والا
                يمين = وسط - 1
            نهاية
        نهاية
        ارجع -1
    نهاية

    ## linear_search — بحث خطي
    دالة بحث_خطي(مصفوفة_مدخلة، هدف)
        متغير ع = 0
        بينما (ع < طول(مصفوفة_مدخلة))
            اذا (مصفوفة_مدخلة[ع] == هدف)
                ارجع ع
            نهاية
            ع = ع + 1
        نهاية
        ارجع -1
    نهاية

    ## reverse — عكس مصفوفة
    دالة عكس(مصفوفة_مدخلة)
        متغير معكوسة = []
        متغير ع = طول(مصفوفة_مدخلة) - 1
        بينما (ع >= 0)
            معكوسة += [مصفوفة_مدخلة[ع]]
            ع = ع - 1
        نهاية
        ارجع معكوسة
    نهاية

    ## unique — إزالة التكرارات
    دالة فريدة(مصفوفة_مدخلة)
        متغير ناتج_فريد = []
        متغير ع = 0
        بينما (ع < طول(مصفوفة_مدخلة))
            متغير موجود_ف = خطأ
            متغير ج = 0
            بينما (ج < طول(ناتج_فريد))
                اذا (ناتج_فريد[ج] == مصفوفة_مدخلة[ع])
                    موجود_ف = صحيح
                نهاية
                ج = ج + 1
            نهاية
            اذا (!موجود_ف)
                ناتج_فريد += [مصفوفة_مدخلة[ع]]
            نهاية
            ع = ع + 1
        نهاية
        ارجع ناتج_فريد
    نهاية
نهاية

