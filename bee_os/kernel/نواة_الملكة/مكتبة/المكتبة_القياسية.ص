# القسم 8: مولّد أرقام عشوائية (rand / srand)
# ═══════════════════════════════════════════════════════════════════════════
#
# خوارزمية LCG (Linear Congruential Generator)
# ═══════════════════════════════════════════════════════════════════════════

صنف مولد_عشوائي_م
    رقم البذرة
    رقم المعامل_أ      # LCG multiplier
    رقم المعامل_ج      # LCG increment
    رقم المعامل_م      # LCG modulus

    باني()
        هذا.البذرة = 12345
        هذا.المعامل_أ = 1103515245
        هذا.المعامل_ج = 12345
        هذا.المعامل_م = 2147483648
    نهاية

    ## srand — تعيين البذرة
    دالة srand(بذرة_قيمة)
        هذا.البذرة = بذرة_قيمة
        ارجع 0
    نهاية

    ## rand — توليد رقم عشوائي
    دالة rand()
        هذا.البذرة = (هذا.المعامل_أ * هذا.البذرة + هذا.المعامل_ج) % هذا.المعامل_م
        # نريد قيمة موجبة
        متغير قيمة_ع = هذا.البذرة
        اذا (قيمة_ع < 0)
            قيمة_ع = 0 - قيمة_ع
        نهاية
        ارجع قيمة_ع
    نهاية

    ## rand_range — رقم عشوائي في نطاق [أدنى، أقصى]
    دالة rand_range(أدنى، أقصى)
        متغير مدى = أقصى - أدنى + 1
        متغير قيمة_ر = هذا.rand() % مدى
        اذا (قيمة_ر < 0)
            قيمة_ر = 0 - قيمة_ر
        نهاية
        ارجع أدنى + قيمة_ر
    نهاية
نهاية

