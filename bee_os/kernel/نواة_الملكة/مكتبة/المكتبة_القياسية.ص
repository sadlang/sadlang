                ملف_ع.المؤشر = طول(ملف_ع.المحتوى)
                ارجع طول(بيانات)
            نهاية
        نهاية
        ارجع -1
    نهاية

    ## fread — قراءة من ملف
    دالة fread(واصفة)
        متغير فهرس = واصفة - 3
        اذا (فهرس >= 0 && فهرس < طول(هذا.الملفات_المفتوحة))
            متغير ملف_ق = هذا.الملفات_المفتوحة[فهرس]
            اذا (ملف_ق.مفتوح && ملف_ق.المؤشر < طول(ملف_ق.المحتوى))
