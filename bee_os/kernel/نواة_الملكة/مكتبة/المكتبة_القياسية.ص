# القسم 1: إدارة الذاكرة الديناميكية (malloc / free / calloc / realloc)
# ═══════════════════════════════════════════════════════════════════════════
#
# محاكاة كومة ذاكرة بسيطة باستخدام مصفوفة موحّدة.
# كل كتلة تحتوي على: [حالة، حجم_المساحة، بيانات...]
#   حالة: 0 = حرة، 1 = مشغولة
#   حجم_المساحة: عدد الخلايا المحجوزة
# ═══════════════════════════════════════════════════════════════════════════

صنف مدير_الذاكرة_م
    رقم عدد_التخصيصات    # عداد التخصيصات الناجحة
    رقم عدد_التحريرات     # عداد التحريرات الناجحة
    رقم الذاكرة_المستخدمة # إجمالي الذاكرة المستعملة حالياً
    رقم أعلى_استخدام      # أعلى نقطة استخدام (watermark)
    رقم المؤشر_الحالي     # مؤشر التخصيص التالي (bump allocator)
    مصفوفة العناوين       # عناوين التخصيصات [عنوان، حجم_تخصيص، حالة]
    مصفوفة الأحجام        # أحجام التخصيصات (متوازية مع العناوين)
    مصفوفة الحالات        # حالات التخصيصات: 1=مشغول، 0=حر

    باني()
        هذا.عدد_التخصيصات = 0
        هذا.عدد_التحريرات = 0
        هذا.الذاكرة_المستخدمة = 0
        هذا.أعلى_استخدام = 0
        هذا.المؤشر_الحالي = 0
        هذا.العناوين = []
        هذا.الأحجام = []
        هذا.الحالات = []
    نهاية

    ## malloc — تخصيص ذاكرة بحجم معيّن (Bump Allocator)
    ## يُرجع عنوان البداية أو -1 عند الفشل
    دالة malloc(مقدار)
        # أولاً: بحث في الكتل المحرّرة (First Fit)
        متغير ع = 0
        بينما (ع < طول(هذا.العناوين))
            اذا (هذا.الحالات[ع] == 0 && هذا.الأحجام[ع] >= مقدار)
                # وجدنا كتلة حرة كافية — أعد استخدامها
                هذا.الحالات[ع] = 1
                هذا.عدد_التخصيصات = هذا.عدد_التخصيصات + 1
                هذا.الذاكرة_المستخدمة = هذا.الذاكرة_المستخدمة + هذا.الأحجام[ع]
                اذا (هذا.الذاكرة_المستخدمة > هذا.أعلى_استخدام)
                    هذا.أعلى_استخدام = هذا.الذاكرة_المستخدمة
                نهاية
                ارجع هذا.العناوين[ع]
            نهاية
            ع = ع + 1
        نهاية

        # لم نجد كتلة حرة — خصص من الكومة
        اذا (هذا.المؤشر_الحالي + مقدار > حجم_الكومة)
            ارجع -1
        نهاية

        متغير عنوان_بداية = هذا.المؤشر_الحالي
        هذا.العناوين += [عنوان_بداية]
        هذا.الأحجام += [مقدار]
        هذا.الحالات += [1]

        هذا.المؤشر_الحالي = هذا.المؤشر_الحالي + مقدار
        هذا.عدد_التخصيصات = هذا.عدد_التخصيصات + 1
        هذا.الذاكرة_المستخدمة = هذا.الذاكرة_المستخدمة + مقدار
        اذا (هذا.الذاكرة_المستخدمة > هذا.أعلى_استخدام)
            هذا.أعلى_استخدام = هذا.الذاكرة_المستخدمة
        نهاية
        ارجع عنوان_بداية
    نهاية

    ## free — تحرير ذاكرة مخصصة سابقاً
    دالة free(عنوان)
        متغير ع = 0
        بينما (ع < طول(هذا.العناوين))
            اذا (هذا.العناوين[ع] == عنوان && هذا.الحالات[ع] == 1)
                هذا.الحالات[ع] = 0
                هذا.عدد_التحريرات = هذا.عدد_التحريرات + 1
                هذا.الذاكرة_المستخدمة = هذا.الذاكرة_المستخدمة - هذا.الأحجام[ع]
                ارجع 0
            نهاية
            ع = ع + 1
        نهاية
        ارجع -1
    نهاية

    ## calloc — تخصيص ذاكرة مع تصفيرها
    دالة calloc(عدد_العناصر، حجم_العنصر)
        متغير المقدار_الكلي = عدد_العناصر * حجم_العنصر
        ارجع هذا.malloc(المقدار_الكلي)
    نهاية

    ## realloc — إعادة تخصيص ذاكرة بحجم مختلف
    دالة realloc(عنوان_قديم، مقدار_طلب)
        متغير عنوان_مكان = هذا.malloc(مقدار_طلب)
        اذا (عنوان_مكان < 0) ارجع -1 نهاية
        هذا.free(عنوان_قديم)
        ارجع عنوان_مكان
    نهاية

    ## إحصائيات الذاكرة
    دالة طباعة_إحصائيات()
        اطبع("  [HEAP] تخصيص=") اطبع(هذا.عدد_التخصيصات)
        اطبع(" تحرير=") اطبع(هذا.عدد_التحريرات)
        اطبع(" مستخدم=") اطبع(هذا.الذاكرة_المستخدمة)
        اطبع(" أعلى=") اطبع(هذا.أعلى_استخدام)
        اطبع(" كتل=") اطبع_سطر(طول(هذا.العناوين))
        ارجع 0
    نهاية
نهاية

