# بداية_النواة.ص - نقطة الدخول الرئيسية لنواة نظام النحلة
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# هذا الملف هو قلب نواة نظام النحلة. يُستدعى من assembly (نقطة_دخول.تراب)
# بعد أن يتهيأ المعالج ويدخل Long Mode 64-bit.
#
# تسلسل التهيئة النواة:
# ━━━━━━━━━━━━━━━━━━━━━
# 1. التحقق من بروتوكول Limine وقراءة خريطة الذاكرة
# 2. تهيئة المدير الذاكرة الفعلية (PMM) - buddy allocator
# 3. تهيئة مدير الذاكرة الافتراضية (VMM) - 4-level paging
# 4. تهيئة GDT (جدول واصفات الشرائح) عبر ص-assembly
# 5. تهيئة IDT (جدول مؤشرات المقاطعات)
# 6. تهيئة PIC/APIC (متحكم المقاطعات)
# 7. تهيئة الموقّت (PIT) لضبطات المجدول
# 8. تهيئة محرك الرسوميات (Framebuffer من Limine)
# 9. تهيئة المجدول
# 10. عرض شاشة الإقلاع (بسم الله)
# 11. تشغيل سطح المكتب
# 12. الدخول في حلقة الأحداث الرئيسية
#
# المؤلف: فريق نظام خلية النحل
# ══════════════════════════════════════════════════════════════════════════════

## معلومات Limine Framebuffer (من بروتوكول الإقلاع)
صنف معلومات_الإطار
    ## الوصف: معلومات الإطار الرسومي المستلمة من Limine
    رقم العنوان_الفعلي      # عنوان الذاكرة للفريم بافر
    رقم العرض               # عرض الشاشة بالبكسل
    رقم الارتفاع             # ارتفاع الشاشة بالبكسل
    رقم الخطوة              # bytes per row (pitch)
    رقم عمق_اللون           # bits per pixel (عادة 32)

    باني(رقم عنوان، رقم ع، رقم ار، رقم خطوة، رقم عمق)
        العنوان_الفعلي = عنوان
        العرض = ع
        الارتفاع = ار
        الخطوة = خطوة
        عمق_اللون = عمق
    نهاية
نهاية

## ثوابت أنواع مناطق الذاكرة
ثابت نوع_ذاكرة_حرة         = 1
ثابت نوع_ذاكرة_محجوزة      = 2
ثابت نوع_ذاكرة_بيوس        = 3
ثابت نوع_ذاكرة_أيكفي       = 4
ثابت نوع_ذاكرة_نواة        = 5
ثابت نوع_ذاكرة_إطار_رسومي  = 6

## معلومات منطقة الذاكرة من خريطة الذاكرة
صنف منطقة_ذاكرة_إقلاع
    ## الوصف: منطقة ذاكرة من خريطة ذاكرة Limine/BIOS
    رقم عنوان_البداية    # عنوان بداية المنطقة
    رقم الحجم            # حجم المنطقة بالبايت
    رقم النوع            # نوع المنطقة (حرة / محجوزة / إلخ)

    باني(رقم عنوان، رقم حجم، رقم النوع_م)
        عنوان_البداية = عنوان
        الحجم = حجم
        النوع = النوع_م
    نهاية
نهاية

## ══════════════════════════════════════════════════════════════════════════
## صنف مدير_التهيئة - يُدير عملية إقلاع النواة
## ══════════════════════════════════════════════════════════════════════════
صنف مدير_التهيئة
    ## الوصف: يتحكم في تسلسل إقلاع نواة نظام النحلة

    # مراحل التهيئة
    ثابت مرحلة_بدء         = 0
    ثابت مرحلة_ذاكرة       = 1
    ثابت مرحلة_مقاطعات     = 2
    ثابت مرحلة_رسوميات     = 3
    ثابت مرحلة_مجدول       = 4
    ثابت مرحلة_سطح_مكتب   = 5
    ثابت مرحلة_مكتملة      = 6

    رقم المرحلة_الحالية
    منطقي الذاكرة_جاهزة
    منطقي المقاطعات_جاهزة
    منطقي الرسوميات_جاهزة
    منطقي المجدول_جاهز
    رقم عدد_الأخطاء

    باني()
        المرحلة_الحالية = مرحلة_بدء
        الذاكرة_جاهزة = خطأ
        المقاطعات_جاهزة = خطأ
        الرسوميات_جاهزة = خطأ
        المجدول_جاهز = خطأ
        عدد_الأخطاء = 0
    نهاية

    ## تسجيل نجاح مرحلة
    دالة نجحت(نص اسم_المرحلة)
        اطبع("  ✅ ")
        اطبع_سطر(اسم_المرحلة)
        المرحلة_الحالية = المرحلة_الحالية + 1
    نهاية

    ## تسجيل خطأ في مرحلة
    دالة فشلت(نص اسم_المرحلة، نص سبب_الفشل)
        اطبع("  ❌ ")
        اطبع(اسم_المرحلة)
        اطبع(": ")
        اطبع_سطر(سبب_الفشل)
        عدد_الأخطاء = عدد_الأخطاء + 1
    نهاية

    ## عرض شاشة الإقلاع الابتدائية
    دالة عرض_شاشة_الإقلاع()
        اطبع_سطر("")
        اطبع_سطر("  ┌─────────────────────────────────────────────┐")
        اطبع_سطر("  │                                             │")
        اطبع_سطر("  │          بِسْمِ اللَّهِ الرَّحْمٰنِ الرَّحِيمِ           │")
        اطبع_سطر("  │                                             │")
        اطبع_سطر("  │    🐝   نظام النحلة - BeeOS v1.0            │")
        اطبع_سطر("  │         خلية العسل - HoneyComb              │")
        اطبع_سطر("  │                                             │")
        اطبع_سطر("  │    مبني بلغة ص | Built with Sad Language    │")
        اطبع_سطر("  │                                             │")
        اطبع_سطر("  └─────────────────────────────────────────────┘")
        اطبع_سطر("")
    نهاية
نهاية

## المثيل العالمي لمدير التهيئة
متغير مدير_الإقلاع = جديد مدير_التهيئة()

