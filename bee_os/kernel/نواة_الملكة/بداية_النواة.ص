## معالج خطأ الصفحة (Page Fault)
دالة معالج_خطأ_الصفحة(رقم عنوان_الخطأ، رقم رمز_الخطأ)
    ## الوصف: يُستدعى عند الوصول لعنوان ذاكرة غير مُعيَّن
    اطبع("  ⚠ Page Fault @ 0x")
    اطبع(عنوان_الخطأ)
    اطبع(" رمز خطأ: ")
    اطبع_سطر(رمز_الخطأ)

    # محاولة إصلاح تلقائي عبر VMM
    اذا (مدير_ذاكرة_افتراضية_النحلة.معالجة_page_fault(عنوان_الخطأ، رمز_الخطأ))
        اطبع_سطر("  ✅ تم إصلاح خطأ الصفحة تلقائياً")
    والا
        اطبع_سطر("  ❌ فشل إصلاح خطأ الصفحة - Kernel Panic!")
        panic_النحلة("خطأ صفحة غير قابل للاسترداد")
    نهاية
نهاية

## معالج الاستثناء العام (General Protection Fault)
دالة معالج_الحماية_العامة(رقم رمز_الخطأ)
    اطبع_سطر("  💀 General Protection Fault!")
    اطبع(" رمز: ")
    اطبع_سطر(رمز_الخطأ)
    panic_النحلة("انتهاك حماية الذاكرة")
نهاية

## معالج انهيار النواة (Kernel Panic)
دالة panic_النحلة(نص الرسالة)
    ## الوصف: يُستدعى عند الوصول لحالة غير قابلة للاسترداد
    اطبع_سطر("")
    اطبع_سطر("  ╔══════════════════════════════════╗")
    اطبع_سطر("  ║   💀 انهيار نواة نظام النحلة    ║")
    اطبع_سطر("  ║   Bee Kernel Panic               ║")
    اطبع_سطر("  ╠══════════════════════════════════╣")
    اطبع("  ║  ")
    اطبع_سطر(الرسالة)
    اطبع_سطر("  ╚══════════════════════════════════╝")

