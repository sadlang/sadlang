# ─────────────────────────────────────────────────────────────────────────────
# ثوابت نظام الصوت
# ─────────────────────────────────────────────────────────────────────────────
متغير معدل_أقراص_44K    = 44100
متغير معدل_أقراص_48K    = 48000
متغير معدل_أقراص_96K    = 96000
متغير معدل_أقراص_192K   = 192000

متغير عمق_8_بت          = 8
متغير عمق_16_بت         = 16
متغير عمق_24_بت         = 24
متغير عمق_32_بت         = 32

متغير قنوات_أحادي       = 1
متغير قنوات_ستيريو      = 2
متغير قنوات_51          = 6
متغير قنوات_71          = 8

متغير حالة_صوت_موقف     = 0
متغير حالة_صوت_يعمل     = 1
متغير حالة_صوت_معلق     = 2
متغير حالة_صوت_منتهي    = 3

متغير تأثير_لا_شيء      = 0
متغير تأثير_صدى         = 1
متغير تأثير_تأخير       = 2
متغير تأثير_ضوضاء       = 3
متغير تأثير_مرشح_باس    = 4
متغير تأثير_مرشح_ترِبل  = 5

# ─────────────────────────────────────────────────────────────────────────────
# صنف مقطع_صوتي - وحدة بيانات صوتية
# ─────────────────────────────────────────────────────────────────────────────
صنف مقطع_صوتي
    ## يمثل مقطعاً صوتياً يمكن تشغيله ومعالجته

    رقم المعرف
    نص اسم_الملف
    نص النوع            ## WAV، MP3، OGG، FLAC
    رقم مدة_MS           ## المدة بالميلي ثانية
    رقم معدل_الأقراص
    رقم عمق_البت
    رقم عدد_القنوات
    رقم حجم_الملف_KB
    منطقي تم_التحميل

    باني(رقم معرف0، نص اسم0، نص نوع0، رقم مدة0)
        المعرف = معرف0
        اسم_الملف = اسم0
        النوع = نوع0
        مدة_MS = مدة0
        معدل_الأقراص = معدل_أقراص_44K
        عمق_البت = عمق_16_بت
        عدد_القنوات = قنوات_ستيريو
        حجم_الملف_KB = 0
        تم_التحميل = خطأ
        ## تقدير الحجم: مدة × معدل × قنوات × (عمق÷8) ÷ 1024
        حجم_الملف_KB = مدة0 * 44100 * 2 * 2 / 1024000
    نهاية

    دالة منطقي تحميل()
        اطبع("  📂 تحميل: ")
        اطبع(اسم_الملف)
        اطبع(" (")
        اطبع(النوع)
        اطبع(" | ")
        اطبع(مدة_MS)
        اطبع("ms | ")
        اطبع(حجم_الملف_KB)
        اطبع_سطر(" KB)")
        تم_التحميل = صحيح
        ارجع صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف قناة_صوت - قناة تشغيل فردية
# ─────────────────────────────────────────────────────────────────────────────
صنف قناة_صوت
    ## تمثل قناة تشغيل مستقلة في الخلاط

    رقم رقم_القناة
    رقم حالة_القناة
    عشري مستوى_الصوت
    عشري موضع_التوازن   ## -1.0 يمين كامل، 0.0 وسط، 1.0 يسار كامل
    رقم التأثير_المطبق
    رقم تقدم_التشغيل    ## بالميلي ثانية
    نص اسم_مقطع_حالي

    باني(رقم رقم0)
        رقم_القناة = رقم0
        حالة_القناة = حالة_صوت_موقف
        مستوى_الصوت = 1.0
        موضع_التوازن = 0.0
        التأثير_المطبق = تأثير_لا_شيء
        تقدم_التشغيل = 0
        اسم_مقطع_حالي = ""
    نهاية

    دالة تشغيل(نص اسم_المقطع، رقم مدة_كاملة)
        اسم_مقطع_حالي = اسم_المقطع
        حالة_القناة = حالة_صوت_يعمل
        تقدم_التشغيل = 0
        اطبع("  ▶️  قناة[")
        اطبع(رقم_القناة)
        اطبع("] تشغيل: ")
        اطبع(اسم_المقطع)
        اطبع(" | صوت=")
        اطبع(مستوى_الصوت)
        اطبع(" | توازن=")
        اطبع_سطر(موضع_التوازن)
    نهاية

    دالة وقف()
        حالة_القناة = حالة_صوت_موقف
        تقدم_التشغيل = 0
        اطبع("  ⏹️  قناة[")
        اطبع(رقم_القناة)
        اطبع_سطر("] وقف")
    نهاية

    دالة تعليق()
        حالة_القناة = حالة_صوت_معلق
        اطبع("  ⏸️  قناة[")
        اطبع(رقم_القناة)
        اطبع_سطر("] تعليق")
    نهاية

    دالة تطبيق_تأثير(رقم تأثير)
        التأثير_المطبق = تأثير
        متغير اسم_ت = "لا شيء"
        اذا (تأثير == تأثير_صدى)
            اسم_ت = "صدى (Echo)"
        نهاية
        اذا (تأثير == تأثير_تأخير)
            اسم_ت = "تأخير (Delay)"
        نهاية
        اذا (تأثير == تأثير_ضوضاء)
            اسم_ت = "ضوضاء (Reverb)"
        نهاية
        اذا (تأثير == تأثير_مرشح_باس)
            اسم_ت = "باس (Low-Pass)"
        نهاية
        اذا (تأثير == تأثير_مرشح_ترِبل)
            اسم_ت = "تِربل (High-Pass)"
        نهاية
        اطبع("  🎛️  قناة[")
        اطبع(رقم_القناة)
        اطبع("] تأثير: ")
        اطبع_سطر(اسم_ت)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مشغل_موسيقى - مشغل موسيقى كامل
# ─────────────────────────────────────────────────────────────────────────────
صنف مشغل_موسيقى
    ## مشغل موسيقى بأوضاع تشغيل متعددة

    مصفوفة قائمة_التشغيل
    رقم الأغنية_الحالية
    رقم حالة_المشغل
    منطقي وضع_تكرار
    منطقي وضع_عشوائي
    عشري مستوى_الصوت
    رقم إجمالي_المشغلة
    رقم الوقت_المنقضي   ## بالثواني

    باني()
        قائمة_التشغيل = []
        الأغنية_الحالية = 0
        حالة_المشغل = حالة_صوت_موقف
        وضع_تكرار = خطأ
        وضع_عشوائي = خطأ
        مستوى_الصوت = 0.8
        إجمالي_المشغلة = 0
        الوقت_المنقضي = 0
    نهاية

    دالة أضف_أغنية(نص اسم0، نص فنان0، رقم مدة0)
        متغير أغنية = {"اسم": اسم0, "فنان": فنان0, "مدة": مدة0}
        قائمة_التشغيل += [أغنية]
    نهاية

    دالة تشغيل()
        ## احسب حجم القائمة
        متغير حجم_ق = 0
        لكل أ في قائمة_التشغيل
            حجم_ق = حجم_ق + 1
        نهاية
        اذا (حجم_ق == 0)
            اطبع_سطر("  ⚠️  قائمة التشغيل فارغة")
            ارجع 0
        نهاية
        حالة_المشغل = حالة_صوت_يعمل
        متغير أغنية = قائمة_التشغيل[الأغنية_الحالية]
        اطبع("  ▶️  🎵 ")
        اطبع(أغنية["اسم"])
        اطبع(" — ")
        اطبع(أغنية["فنان"])
        اطبع(" (")
        اطبع(أغنية["مدة"])
        اطبع_سطر("s)")
        إجمالي_المشغلة = إجمالي_المشغلة + 1
    نهاية

    دالة التالي()
        ## احسب حجم القائمة
        متغير حجم = 0
        لكل أ في قائمة_التشغيل
            حجم = حجم + 1
        نهاية

        اذا (حجم == 0)
            ارجع 0
        نهاية

        الأغنية_الحالية = الأغنية_الحالية + 1
        اذا (الأغنية_الحالية >= حجم)
            الأغنية_الحالية = 0
        نهاية
        تشغيل()
    نهاية

    دالة السابق()
        متغير حجم = 0
        لكل أ في قائمة_التشغيل
            حجم = حجم + 1
        نهاية

        اذا (حجم == 0)
            ارجع 0
        نهاية

        اذا (الأغنية_الحالية <= 0)
            الأغنية_الحالية = حجم - 1
        وإلا
            الأغنية_الحالية = الأغنية_الحالية - 1
        نهاية
        تشغيل()
    نهاية

    دالة طباعة_القائمة()
        اطبع_سطر("  ╔══ قائمة التشغيل ═══════════════════════════════╗")
        متغير عدد_س = 0
        لكل أغنية في قائمة_التشغيل
            اطبع("  ║  ")
            اذا (عدد_س == الأغنية_الحالية && حالة_المشغل == حالة_صوت_يعمل)
                اطبع("▶️  ")
            وإلا
                اطبع("   ")
            نهاية
            اطبع(عدد_س + 1)
            اطبع(". ")
            اطبع(أغنية["اسم"])
            اطبع(" — ")
            اطبع(أغنية["فنان"])
            اطبع(" (")
            اطبع(أغنية["مدة"])
            اطبع_سطر("s)")
            عدد_س = عدد_س + 1
        نهاية
        اطبع_سطر("  ╚═══════════════════════════════════════════════╝")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدير_الصوت - النواة المحورية لنظام الصوت
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_الصوت
    ##
    ## مدير الصوت الرئيسي لنظام النحلة.
    ## يتحكم في الجهاز الصوتي، الخلاط، المقاطع المحملة.
    ##

    ## إعدادات الجهاز
    نص اسم_الجهاز
    رقم معدل_الأقراص_الحالي
    رقم عمق_البت_الحالي
    رقم عدد_القنوات_الحالي
    رقم حجم_الحاجز          ## Buffer size بالعينات

    ## الحالة
    منطقي الجهاز_نشط
    عشري مستوى_الصوت_الرئيسي
    منطقي كتم_الصوت

    ## الموارد
    مصفوفة المقاطع_المحملة
    مصفوفة القنوات
    رقم عداد_المقاطع

    ## الإحصاء
    رقم إجمالي_ملفات_مشغلة
    رقم وقت_تشغيل_إجمالي    ## بالثواني

    باني(نص جهاز0، رقم معدل0)
        اسم_الجهاز = جهاز0
        معدل_الأقراص_الحالي = معدل0
        عمق_البت_الحالي = عمق_16_بت
        عدد_القنوات_الحالي = قنوات_ستيريو
        حجم_الحاجز = 1024
        الجهاز_نشط = خطأ
        مستوى_الصوت_الرئيسي = 1.0
        كتم_الصوت = خطأ
        المقاطع_المحملة = []
        القنوات = []
        عداد_المقاطع = 1
        إجمالي_ملفات_مشغلة = 0
        وقت_تشغيل_إجمالي = 0
    نهاية

    دالة منطقي تهيئة()
        اطبع("  🔊 تهيئة جهاز الصوت: ")
        اطبع_سطر(اسم_الجهاز)
        اطبع("  📻 معدل الأقراص: ")
        اطبع(معدل_الأقراص_الحالي)
        اطبع(" Hz | عمق: ")
        اطبع(عمق_البت_الحالي)
        اطبع(" بت | قنوات: ")
        اطبع_سطر(عدد_القنوات_الحالي)

        ## إنشاء 8 قنوات صوت
        متغير ع = 0
        بينما (ع < 8)
            متغير قناة = جديد قناة_صوت(ع + 1)
            القنوات += [قناة]
            ع = ع + 1
        نهاية

        الجهاز_نشط = صحيح
        اطبع_سطر("  ✅ نظام الصوت جاهز — 8 قنوات متاحة")
        ارجع صحيح
    نهاية

    دالة رقم تحميل_مقطع(نص اسم، نص نوع، رقم مدة)
        متغير مقطع = جديد مقطع_صوتي(عداد_المقاطع، اسم، نوع، مدة)
        مقطع.تحميل()
        المقاطع_المحملة += [مقطع]
        متغير معرف = عداد_المقاطع
        عداد_المقاطع = عداد_المقاطع + 1
        ارجع معرف
    نهاية

    دالة تشغيل_على_قناة(رقم رقم_القناة، نص اسم_المقطع، رقم مدة)
        اذا (الجهاز_نشط == خطأ)
            اطبع_سطر("  ❌ الجهاز غير نشط")
            ارجع 0
        نهاية
        اذا (كتم_الصوت)
            اطبع_سطر("‫ 🔇 الصوت مكتوم‬")
            ارجع 0
        نهاية

        ## نبحث عن القناة المطلوبة
        لكل قناة في القنوات
            اذا (قناة.رقم_القناة == رقم_القناة)
                قناة.مستوى_الصوت = مستوى_الصوت_الرئيسي
                قناة.تشغيل(اسم_المقطع، مدة)
                إجمالي_ملفات_مشغلة = إجمالي_ملفات_مشغلة + 1
                وقت_تشغيل_إجمالي = وقت_تشغيل_إجمالي + مدة
            نهاية
        نهاية
    نهاية

    دالة تطبيق_تأثير_على_قناة(رقم رقم_القناة، رقم التأثير)
        لكل قناة في القنوات
            اذا (قناة.رقم_القناة == رقم_القناة)
                قناة.تطبيق_تأثير(التأثير)
            نهاية
        نهاية
    نهاية

    دالة تغيير_مستوى_الصوت(عشري مستوى_جديد)
        اذا (مستوى_جديد < 0.0)
            مستوى_جديد = 0.0
        نهاية
        اذا (مستوى_جديد > 1.0)
            مستوى_جديد = 1.0
        نهاية
        مستوى_الصوت_الرئيسي = مستوى_جديد
        اطبع("  🔊 مستوى الصوت الرئيسي: ")
        اطبع(مستوى_الصوت_الرئيسي)
        اطبع_سطر(" (")
        اطبع(مستوى_الصوت_الرئيسي * 100)
        اطبع_سطر("%)")
    نهاية

    دالة تبديل_كتم()
        اذا (كتم_الصوت)
            كتم_الصوت = خطأ
            اطبع_سطر("  🔊 تم رفع الكتم")
        وإلا
            كتم_الصوت = صحيح
            اطبع_سطر("  🔇 تم كتم الصوت")
        نهاية
    نهاية

    دالة طباعة_تقرير()
        اطبع_سطر("  ╔══ تقرير نظام الصوت ══════════════════════════╗")
        اطبع("  ║  الجهاز: ")
        اطبع_سطر(اسم_الجهاز)
        اطبع("  ║  معدل: ")
        اطبع(معدل_الأقراص_الحالي)
        اطبع(" Hz | ")
        اطبع(عمق_البت_الحالي)
        اطبع(" بت | ")
        اطبع(عدد_القنوات_الحالي)
        اطبع_سطر(" قنوات")
        اطبع("  ║  الصوت: ")
        اطبع(مستوى_الصوت_الرئيسي * 100)
        اطبع_سطر("%")
        متغير عدد_م = 0
        لكل م في المقاطع_المحملة
            عدد_م = عدد_م + 1
        نهاية
        اطبع("  ║  مقاطع محملة: ")
        اطبع_سطر(عدد_م)
        اطبع("  ║  ملفات مشغلة: ")
        اطبع(إجمالي_ملفات_مشغلة)
        اطبع(" | وقت تشغيل: ")
        اطبع(وقت_تشغيل_إجمالي)
        اطبع_سطر("s")
        اطبع_سطر("  ╚═══════════════════════════════════════════════╝")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ─────────────────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════════════╗")
    اطبع_سطر("║    🔊 نظام النحلة - نظام الصوت BeeAudio v3.0       ║")
    اطبع_سطر("╚══════════════════════════════════════════════════════╝")
    اطبع_سطر("")

    ## ─── تهيئة مدير الصوت ───
    اطبع_سطر("═══ [1] تهيئة نظام الصوت ════════════════════════════")
    متغير صوت = جديد مدير_الصوت("BeeAudio HD — Intel HDA"، معدل_أقراص_48K)
    صوت.تهيئة()

    ## ─── تحميل المقاطع الصوتية ───
    اطبع_سطر("")
    اطبع_سطر("═══ [2] تحميل الأصوات ════════════════════════════════")
    متغير صوت_تنبيه    = صوت.تحميل_مقطع("نغمة_التنبيه.wav"،   "WAV"،  1)
    متغير صوت_تلقيم    = صوت.تحميل_مقطع("نغمة_الاستقبال.wav"، "WAV"،  2)
    متغير صوت_خطأ      = صوت.تحميل_مقطع("نغمة_الخطأ.wav"،     "WAV"،  1)
    متغير صوت_نجاح     = صوت.تحميل_مقطع("نغمة_النجاح.wav"،    "WAV"،  2)
    متغير صوت_نحلة     = صوت.تحميل_مقطع("طنين_النحلة.ogg"،    "OGG"،  5)

    ## ─── تشغيل الأصوات ───
    اطبع_سطر("")
    اطبع_سطر("═══ [3] تشغيل الأصوات ════════════════════════════════")
    صوت.تشغيل_على_قناة(1، "نغمة_التنبيه.wav"، 1)
    صوت.تشغيل_على_قناة(2، "طنين_النحلة.ogg"، 5)
    صوت.تشغيل_على_قناة(3، "نغمة_النجاح.wav"، 2)

    ## ─── تطبيق التأثيرات ───
    اطبع_سطر("")
    اطبع_سطر("═══ [4] التأثيرات الصوتية ════════════════════════════")
    صوت.تطبيق_تأثير_على_قناة(1، تأثير_صدى)
    صوت.تطبيق_تأثير_على_قناة(2، تأثير_مرشح_باس)
    صوت.تطبيق_تأثير_على_قناة(3، تأثير_تأخير)

    ## ─── التحكم بمستوى الصوت ───
    اطبع_سطر("")
    اطبع_سطر("═══ [5] التحكم في مستوى الصوت ═══════════════════════")
    صوت.تغيير_مستوى_الصوت(0.75)
    صوت.تبديل_كتم()
    صوت.تبديل_كتم()

    ## ─── مشغل الموسيقى ───
    اطبع_سطر("")
