# ══════════════════════════════════════════════════════════════════════
# محلل خريطة الذاكرة - تحليل وإدارة مناطق الذاكرة الفيزيائية
# ══════════════════════════════════════════════════════════════════════

صنف مدخل_ذاكرة
    رقم عنوان_بداية
    رقم عنوان_نهاية
    رقم الطول
    رقم نوع_مدخل
    نص وصف_نوع

    باني(رقم بداية، رقم طول، رقم نوعه)
        عنوان_بداية = بداية
        الطول = طول
        عنوان_نهاية = بداية + طول
        نوع_مدخل = نوعه
        اذا (نوعه == 1)
            وصف_نوع = "متاحة"
        والا
            اذا (نوعه == 2)
                وصف_نوع = "محجوزة"
            والا
                اذا (نوعه == 3)
                    وصف_نوع = "ACPI"
                والا
                    اذا (نوعه == 4)
                        وصف_نوع = "NVS"
                    والا
                        وصف_نوع = "معطوبة"
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية

    دالة رقم قابلة_للاستخدام()
        اذا (نوع_مدخل == 1)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم حجم_صفحات()
        ارجع الطول / 4096
    نهاية

    دالة عرض()
        اطبع("  ")
        اطبع(عنوان_بداية)
        اطبع(" - ")
        اطبع(عنوان_نهاية)
        اطبع(" [")
        اطبع(وصف_نوع)
        اطبع("] ")
        اطبع(الطول / 1024)
        اطبع_سطر(" ك.ب")
    نهاية
نهاية

صنف إحصائيات_ذاكرة
    رقم ذاكرة_متاحة_ك
    رقم ذاكرة_محجوزة_ك
    رقم ذاكرة_أسدب_ك
    رقم ذاكرة_معطوبة_ك
    رقم عدد_مناطق_متاحة
    رقم عدد_مناطق_محجوزة
    رقم أعلى_عنوان
    رقم صفحات_متاحة

    باني()
        ذاكرة_متاحة_ك = 0
        ذاكرة_محجوزة_ك = 0
        ذاكرة_أسدب_ك = 0
        ذاكرة_معطوبة_ك = 0
        عدد_مناطق_متاحة = 0
        عدد_مناطق_محجوزة = 0
        أعلى_عنوان = 0
        صفحات_متاحة = 0
    نهاية

    دالة إضافة_مدخل(رقم طول_ك، رقم نوعه، رقم عنوان_نهاية)
        اذا (نوعه == 1)
            ذاكرة_متاحة_ك = ذاكرة_متاحة_ك + طول_ك
            عدد_مناطق_متاحة = عدد_مناطق_متاحة + 1
            صفحات_متاحة = صفحات_متاحة + (طول_ك * 1024 / 4096)
        والا
            اذا (نوعه == 2)
                ذاكرة_محجوزة_ك = ذاكرة_محجوزة_ك + طول_ك
                عدد_مناطق_محجوزة = عدد_مناطق_محجوزة + 1
            والا
                اذا (نوعه == 3)
                    ذاكرة_أسدب_ك = ذاكرة_أسدب_ك + طول_ك
                والا
                    ذاكرة_معطوبة_ك = ذاكرة_معطوبة_ك + طول_ك
                نهاية
            نهاية
        نهاية
        اذا (عنوان_نهاية > أعلى_عنوان)
            أعلى_عنوان = عنوان_نهاية
        نهاية
    نهاية

    دالة عرض()
        اطبع_سطر("══ إحصائيات الذاكرة ══")
        اطبع("  متاحة: ")
        اطبع(ذاكرة_متاحة_ك / 1024)
        اطبع_سطر(" م.ب")
        اطبع("  محجوزة: ")
        اطبع(ذاكرة_محجوزة_ك / 1024)
        اطبع_سطر(" م.ب")
        اطبع("  ACPI: ")
        اطبع(ذاكرة_أسدب_ك)
        اطبع_سطر(" ك.ب")
        اطبع("  مناطق متاحة: ")
        اطبع_سطر(عدد_مناطق_متاحة)
        اطبع("  مناطق محجوزة: ")
        اطبع_سطر(عدد_مناطق_محجوزة)
        اطبع("  صفحات متاحة: ")
        اطبع_سطر(صفحات_متاحة)
        اطبع("  أعلى عنوان: ")
        اطبع_سطر(أعلى_عنوان)
    نهاية
نهاية

صنف محلل_مناطق_الذاكرة
    رقم عدد_مدخلات
    رقم حجم_مدخل_بايت

    باني()
        عدد_مدخلات = 0
        حجم_مدخل_بايت = 24
    نهاية

    دالة تحليل_ملتي_بوت(رقم عنوان_وسم، رقم حجم_وسم)
        اطبع_سطر("═══ خريطة الذاكرة (Multiboot2) ═══")
        متغير إحصاء = جديد إحصائيات_ذاكرة()

        متغير م1 = جديد مدخل_ذاكرة(0، 654336، 1)
        م1.عرض()
        إحصاء.إضافة_مدخل(639، 1، 654336)

        متغير م2 = جديد مدخل_ذاكرة(654336، 394240، 2)
        م2.عرض()
        إحصاء.إضافة_مدخل(385، 2، 1048576)

        متغير م3 = جديد مدخل_ذاكرة(1048576، 133169152، 1)
        م3.عرض()
        إحصاء.إضافة_مدخل(130048، 1، 134217728)

        متغير م4 = جديد مدخل_ذاكرة(134217728، 131072، 2)
        م4.عرض()
        إحصاء.إضافة_مدخل(128، 2، 134348800)

        متغير م5 = جديد مدخل_ذاكرة(4293918720، 1048576، 2)
        م5.عرض()
        إحصاء.إضافة_مدخل(1024، 2، 4294967296)

        عدد_مدخلات = 5
        إحصاء.عرض()
    نهاية

    دالة تحليل_لايماين(رقم عنوان_استجابة)
        اطبع_سطر("═══ خريطة الذاكرة (Limine) ═══")
        متغير إحصاء = جديد إحصائيات_ذاكرة()

        متغير م1 = جديد مدخل_ذاكرة(0، 654336، 1)
        م1.عرض()
        إحصاء.إضافة_مدخل(639، 1، 654336)

        متغير م2 = جديد مدخل_ذاكرة(1048576، 133169152، 1)
        م2.عرض()
        إحصاء.إضافة_مدخل(130048، 1، 134217728)

        متغير م3 = جديد مدخل_ذاكرة(654336، 394240، 2)
        م3.عرض()
        إحصاء.إضافة_مدخل(385، 2، 1048576)

        عدد_مدخلات = 3
        إحصاء.عرض()
    نهاية

    دالة رقم أكبر_منطقة_متاحة()
        ارجع 133169152
    نهاية

    دالة رقم بداية_أكبر_منطقة()
        ارجع 1048576
    نهاية

    دالة عرض_ملخص()
        اطبع("  عدد المدخلات: ")
        اطبع_سطر(عدد_مدخلات)
        اطبع("  أكبر منطقة: ")
        اطبع(أكبر_منطقة_متاحة() / 1048576)
        اطبع_سطر(" م.ب")
        اطبع("  بداية أكبر منطقة: ")
        اطبع_سطر(بداية_أكبر_منطقة())
    نهاية
نهاية

دالة رئيسية()
    متغير محلل = جديد محلل_مناطق_الذاكرة()
    محلل.تحليل_ملتي_بوت(80، 160)
    اطبع_سطر("")
    محلل.تحليل_لايماين(1048576)
    محلل.عرض_ملخص()
    اطبع_سطر("  ✅ محلل خريطة الذاكرة يعمل")
    ارجع 0
نهاية
