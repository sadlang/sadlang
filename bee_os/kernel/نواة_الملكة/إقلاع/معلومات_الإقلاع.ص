# ══════════════════════════════════════════════════════════════════════
# معلومات الإقلاع - هيكل بيانات معلومات بدء التشغيل
# ══════════════════════════════════════════════════════════════════════

صنف منطقة_ذاكرة
    رقم بداية_العنوان
    رقم نهاية_العنوان
    رقم الطول_بايت
    رقم نوع_المنطقة
    نص وصف_المنطقة

    باني(رقم بداية، رقم طول، رقم نوعه)
        بداية_العنوان = بداية
        الطول_بايت = طول
        نهاية_العنوان = بداية + طول
        نوع_المنطقة = نوعه
        اذا (نوعه == 1)
            وصف_المنطقة = "متاحة"
        والا
            اذا (نوعه == 2)
                وصف_المنطقة = "محجوزة"
            والا
                وصف_المنطقة = "غير معروف"
            نهاية
        نهاية
    نهاية

    دالة رقم حجم_كيلوبايت()
        ارجع الطول_بايت / 1024
    نهاية

    دالة عرض()
        اطبع("    ")
        اطبع(بداية_العنوان)
        اطبع(" - ")
        اطبع(نهاية_العنوان)
        اطبع(" (")
        اطبع(حجم_كيلوبايت())
        اطبع(" ك.ب) ")
        اطبع_سطر(وصف_المنطقة)
    نهاية
نهاية

صنف معلومات_إطار_مخزن
    رقم عنوان_فيزيائي
    رقم عنوان_افتراضي
    رقم عرض_بكسل
    رقم ارتفاع_بكسل
    رقم عمق_بت
    رقم خطوة_سطر
    رقم نمط_ألوان

    باني()
        عنوان_فيزيائي = 0
        عنوان_افتراضي = 0
        عرض_بكسل = 0
        ارتفاع_بكسل = 0
        عمق_بت = 0
        خطوة_سطر = 0
        نمط_ألوان = 1
    نهاية

    دالة رقم حجم_المخزن_بايت()
        ارجع خطوة_سطر * ارتفاع_بكسل
    نهاية

    دالة رقم متاح()
        اذا (عنوان_فيزيائي != 0)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة عرض()
        اذا (متاح() == 1)
            اطبع("  إطار المخزن: ")
            اطبع(عرض_بكسل)
            اطبع("x")
            اطبع(ارتفاع_بكسل)
            اطبع("x")
            اطبع(عمق_بت)
            اطبع_سطر(" bpp")
            اطبع("    حجم: ")
            اطبع(حجم_المخزن_بايت() / 1024)
            اطبع_سطر(" ك.ب")
        والا
            اطبع_سطر("  إطار المخزن: غير متاح")
        نهاية
    نهاية
نهاية

صنف معلومات_معالج
    رقم معرف_بداية
    رقم معرف_محلي_أبيك
    رقم بداية_مكدس
    رقم رقم_المعالج

    باني(رقم ترتيب، رقم معرف)
        رقم_المعالج = ترتيب
        معرف_بداية = معرف
        معرف_محلي_أبيك = معرف
        بداية_مكدس = 0
    نهاية

    دالة عرض()
        اطبع("    CPU#")
        اطبع(رقم_المعالج)
        اطبع(" LAPIC=")
        اطبع_سطر(معرف_محلي_أبيك)
    نهاية
نهاية

صنف معلومات_بدء_التشغيل
    نص اسم_المحمل
    نص بروتوكول_إقلاع
    رقم سحر_إقلاع
    رقم عدد_مناطق_ذاكرة
    رقم عدد_معالجات
    رقم ذاكرة_كلية_ك
    رقم عنوان_نواة_فيزيائي
    رقم عنوان_نواة_افتراضي
    رقم إزاحة_هايماب
    رقم عنوان_أسدب
    نص سطر_أوامر_نواة

    باني()
        اسم_المحمل = "غير معروف"
        بروتوكول_إقلاع = "غير محدد"
        سحر_إقلاع = 0
        عدد_مناطق_ذاكرة = 0
        عدد_معالجات = 1
        ذاكرة_كلية_ك = 0
        عنوان_نواة_فيزيائي = 0
        عنوان_نواة_افتراضي = 0
        إزاحة_هايماب = 0
        عنوان_أسدب = 0
        سطر_أوامر_نواة = ""
    نهاية

    دالة تعيين_ملتي_بوت(رقم سحر، رقم عنوان_بيانات)
        بروتوكول_إقلاع = "Multiboot2"
        سحر_إقلاع = سحر
    نهاية

    دالة تعيين_لايماين()
        بروتوكول_إقلاع = "Limine"
    نهاية

    دالة إضافة_ذاكرة(رقم طول_ك)
        ذاكرة_كلية_ك = ذاكرة_كلية_ك + طول_ك
        عدد_مناطق_ذاكرة = عدد_مناطق_ذاكرة + 1
    نهاية

    دالة عرض_ملخص()
        اطبع_سطر("═══ معلومات الإقلاع ═══")
        اطبع("  المحمل: ")
        اطبع_سطر(اسم_المحمل)
        اطبع("  البروتوكول: ")
        اطبع_سطر(بروتوكول_إقلاع)
        اطبع("  مناطق الذاكرة: ")
        اطبع_سطر(عدد_مناطق_ذاكرة)
        اطبع("  ذاكرة كلية: ")
        اطبع(ذاكرة_كلية_ك / 1024)
        اطبع_سطر(" م.ب")
        اطبع("  المعالجات: ")
        اطبع_سطر(عدد_معالجات)
        اطبع("  سطر الأوامر: ")
        اطبع_سطر(سطر_أوامر_نواة)
    نهاية
نهاية

دالة رئيسية()
    متغير معلومات = جديد معلومات_بدء_التشغيل()
    معلومات.اسم_المحمل = "GRUB 2.06"
    معلومات.تعيين_ملتي_بوت(920085513، 1048576)
    معلومات.سطر_أوامر_نواة = "debug loglevel=7"

    معلومات.إضافة_ذاكرة(639)
    معلومات.إضافة_ذاكرة(130048)
    معلومات.عدد_معالجات = 4

    متغير إطار = جديد معلومات_إطار_مخزن()
    إطار.عنوان_فيزيائي = 4026531840
    إطار.عرض_بكسل = 1024
    إطار.ارتفاع_بكسل = 768
    إطار.عمق_بت = 32
    إطار.خطوة_سطر = 4096

    معلومات.عرض_ملخص()
    إطار.عرض()

    متغير م = جديد منطقة_ذاكرة(0، 654336، 1)
    م.عرض()

    متغير ع = جديد معلومات_معالج(0، 0)
    ع.عرض()

    اطبع_سطر("  ✅ معلومات الإقلاع تعمل")
    ارجع 0
نهاية
