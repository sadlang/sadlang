# ══════════════════════════════════════════════════════════════════════
# محلل لايماين - تحليل بروتوكول Limine
# ══════════════════════════════════════════════════════════════════════

صنف طلب_لايماين
    رقم المعرف_أول
    رقم المعرف_ثاني
    رقم المراجعة
    رقم العنوان_استجابة

    باني(رقم معرف1، رقم معرف2)
        المعرف_أول = معرف1
        المعرف_ثاني = معرف2
        المراجعة = 0
        العنوان_استجابة = 0
    نهاية

    دالة رقم موجود()
        اذا (العنوان_استجابة != 0)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة عرض_حالة(نص اسم)
        اطبع("  [")
        اذا (موجود() == 1)
            اطبع("✓")
        والا
            اطبع("✗")
        نهاية
        اطبع("] ")
        اطبع_سطر(اسم)
    نهاية
نهاية

صنف ذاكرة_لايماين
    رقم عنوان_البداية
    رقم الطول_بايت
    رقم نوع_المنطقة

    باني(رقم بداية، رقم طول، رقم نوعه)
        عنوان_البداية = بداية
        الطول_بايت = طول
        نوع_المنطقة = نوعه
    نهاية

    دالة نص وصف_النوع()
        اذا (نوع_المنطقة == 0)
            ارجع "قابلة للاستخدام"
        نهاية
        اذا (نوع_المنطقة == 1)
            ارجع "محجوزة"
        نهاية
        اذا (نوع_المنطقة == 2)
            ارجع "ACPI استرداد"
        نهاية
        اذا (نوع_المنطقة == 3)
            ارجع "ACPI NVS"
        نهاية
        اذا (نوع_المنطقة == 4)
            ارجع "معطوبة"
        نهاية
        اذا (نوع_المنطقة == 5)
            ارجع "محمل الإقلاع"
        نهاية
        اذا (نوع_المنطقة == 6)
            ارجع "نواة وحدات"
        نهاية
        ارجع "غير معروف"
    نهاية

    دالة عرض()
        اطبع("    ")
        اطبع(عنوان_البداية)
        اطبع(" + ")
        اطبع(الطول_بايت / 1024)
        اطبع(" ك.ب = ")
        اطبع_سطر(وصف_النوع())
    نهاية
نهاية

صنف إطار_لايماين
    رقم العنوان
    رقم العرض_بكسل
    رقم الارتفاع_بكسل
    رقم بت_لكل_بكسل
    رقم خطوة

    باني()
        العنوان = 0
        العرض_بكسل = 0
        الارتفاع_بكسل = 0
        بت_لكل_بكسل = 0
        خطوة = 0
    نهاية

    دالة رقم حجم_المخزن()
        ارجع خطوة * الارتفاع_بكسل
    نهاية

    دالة عرض()
        اطبع("  إطار مخزن: ")
        اطبع(العرض_بكسل)
        اطبع("x")
        اطبع(الارتفاع_بكسل)
        اطبع("x")
        اطبع(بت_لكل_بكسل)
        اطبع(" خطوة=")
        اطبع(خطوة)
        اطبع(" حجم=")
        اطبع(حجم_المخزن() / 1024)
        اطبع_سطر(" ك.ب")
    نهاية
نهاية

صنف معالج_لايماين
    رقم معرف_المعالج
    رقم معرف_محلي
    رقم عنوان_دالة_بدء

    باني(رقم معرف، رقم محلي)
        معرف_المعالج = معرف
        معرف_محلي = محلي
        عنوان_دالة_بدء = 0
    نهاية

    دالة عرض()
        اطبع("    معالج #")
        اطبع(معرف_المعالج)
        اطبع(" LAPIC=")
        اطبع_سطر(معرف_محلي)
    نهاية
نهاية

صنف محلل_بروتوكول_لايماين
    رقم عدد_معالجات_مكتشفة
    رقم عدد_مناطق_مكتشفة
    رقم ذاكرة_كلية_ك
    رقم إزاحة_هايماب

    باني()
        عدد_معالجات_مكتشفة = 0
        عدد_مناطق_مكتشفة = 0
        ذاكرة_كلية_ك = 0
        إزاحة_هايماب = 0
    نهاية

    دالة تحليل_كل_الطلبات()
        اطبع_سطر("═══ تحليل Limine ═══")

        متغير ط1 = جديد طلب_لايماين(1، 1)
        ط1.العنوان_استجابة = 1
        ط1.عرض_حالة("HHDM")

        متغير ط2 = جديد طلب_لايماين(2، 2)
        ط2.العنوان_استجابة = 1
        ط2.عرض_حالة("إطار المخزن")

        متغير ط3 = جديد طلب_لايماين(3، 3)
        ط3.العنوان_استجابة = 1
        ط3.عرض_حالة("خريطة ذاكرة")

        متغير ط4 = جديد طلب_لايماين(4، 4)
        ط4.العنوان_استجابة = 1
        ط4.عرض_حالة("RSDP")

        متغير ط5 = جديد طلب_لايماين(5، 5)
        ط5.العنوان_استجابة = 1
        ط5.عرض_حالة("SMP")

        متغير ط6 = جديد طلب_لايماين(6، 6)
        ط6.العنوان_استجابة = 1
        ط6.عرض_حالة("عنوان النواة")
    نهاية

    دالة تحليل_ذاكرة()
        اطبع_سطر("  ── مناطق الذاكرة (Limine) ──")

        متغير م1 = جديد ذاكرة_لايماين(0، 654336، 0)
        م1.عرض()
        ذاكرة_كلية_ك = ذاكرة_كلية_ك + 639

        متغير م2 = جديد ذاكرة_لايماين(1048576، 133169152، 0)
        م2.عرض()
        ذاكرة_كلية_ك = ذاكرة_كلية_ك + 130048

        متغير م3 = جديد ذاكرة_لايماين(654336، 394240، 1)
        م3.عرض()

        متغير م4 = جديد ذاكرة_لايماين(4026531840، 3145728، 5)
        م4.عرض()

        عدد_مناطق_مكتشفة = 4
        اطبع("  ذاكرة متاحة: ")
        اطبع(ذاكرة_كلية_ك / 1024)
        اطبع_سطر(" م.ب")
    نهاية

    دالة تحليل_إطار_مخزن()
        متغير إطار = جديد إطار_لايماين()
        إطار.العنوان = 4026531840
        إطار.العرض_بكسل = 1024
        إطار.الارتفاع_بكسل = 768
        إطار.بت_لكل_بكسل = 32
        إطار.خطوة = 4096
        إطار.عرض()
    نهاية

    دالة تحليل_معالجات()
        اطبع_سطر("  ── معالجات SMP ──")

        متغير ع1 = جديد معالج_لايماين(0، 0)
        ع1.عرض()

        متغير ع2 = جديد معالج_لايماين(1، 1)
        ع2.عرض()

        متغير ع3 = جديد معالج_لايماين(2، 2)
        ع3.عرض()

        متغير ع4 = جديد معالج_لايماين(3، 3)
        ع4.عرض()

        عدد_معالجات_مكتشفة = 4
        اطبع("  عدد المعالجات: ")
        اطبع_سطر(عدد_معالجات_مكتشفة)
    نهاية

    دالة تحليل_هايماب()
        إزاحة_هايماب = 18446603336221196288
        اطبع("  إزاحة HHDM: ")
        اطبع_سطر(إزاحة_هايماب)
    نهاية
نهاية

دالة رئيسية()
    متغير محلل = جديد محلل_بروتوكول_لايماين()
    محلل.تحليل_كل_الطلبات()
    محلل.تحليل_ذاكرة()
    محلل.تحليل_إطار_مخزن()
    محلل.تحليل_معالجات()
    محلل.تحليل_هايماب()
    اطبع_سطر("  ✅ محلل لايماين يعمل")
    ارجع 0
نهاية
