# مهيئ إطار المخزن - تهيئة وإدارة المخزن المؤقت للعرض
# ══════════════════════════════════════════════════════════════════════

صنف لون_بكسل
    رقم أحمر
    رقم أخضر
    رقم أزرق
    رقم شفافية

    باني(رقم ح، رقم خ، رقم ز)
        أحمر = ح
        أخضر = خ
        أزرق = ز
        شفافية = 255
    نهاية

    دالة رقم قيمة_مدمجة()
        ارجع (شفافية * 16777216) + (أحمر * 65536) + (أخضر * 256) + أزرق
    نهاية

    دالة عرض()
        اطبع("(")
        اطبع(أحمر)
        اطبع("،")
        اطبع(أخضر)
        اطبع("،")
        اطبع(أزرق)
        اطبع(")")
    نهاية
نهاية

صنف ألوان_نظام
    رقم أسود
    رقم أبيض
    رقم أحمر_فاتح
    رقم أخضر_فاتح
    رقم أزرق_فاتح
    رقم أصفر
    رقم خلفية_نظام
    رقم نص_نظام

    باني()
        أسود = 0
        أبيض = 4294967295
        أحمر_فاتح = 4294901760
        أخضر_فاتح = 4278255360
        أزرق_فاتح = 4278190335
        أصفر = 4294967040
        خلفية_نظام = 4281348144
        نص_نظام = 4294962355
    نهاية

    دالة عرض()
        اطبع_سطر("  ألوان النظام:")
        اطبع("    خلفية: ")
        اطبع_سطر(خلفية_نظام)
        اطبع("    نص: ")
        اطبع_سطر(نص_نظام)
    نهاية
نهاية

صنف تكوين_إطار
    رقم العرض_المطلوب
    رقم الارتفاع_المطلوب
    رقم العمق_المطلوب
    رقم تحجيم_مفعل
    رقم مؤشر_مفعل

    باني()
        العرض_المطلوب = 1024
        الارتفاع_المطلوب = 768
        العمق_المطلوب = 32
        تحجيم_مفعل = 0
        مؤشر_مفعل = 1
    نهاية
نهاية

صنف مهيئ_إطار
    رقم عنوان_مخزن
    رقم عرض_فعلي
    رقم ارتفاع_فعلي
    رقم عمق_فعلي
    رقم خطوة_فعلية
    رقم حجم_مخزن_بايت
    رقم مهيأ
    رقم مخزن_ثاني_عنوان
    رقم مخزن_ثاني_مفعل

    باني()
        عنوان_مخزن = 0
        عرض_فعلي = 0
        ارتفاع_فعلي = 0
        عمق_فعلي = 0
        خطوة_فعلية = 0
        حجم_مخزن_بايت = 0
        مهيأ = 0
        مخزن_ثاني_عنوان = 0
        مخزن_ثاني_مفعل = 0
    نهاية

    دالة تهيئة(رقم عنوان، رقم عرض، رقم ارتفاع، رقم عمق، رقم خطوة)
        عنوان_مخزن = عنوان
        عرض_فعلي = عرض
        ارتفاع_فعلي = ارتفاع
        عمق_فعلي = عمق
        خطوة_فعلية = خطوة
        حجم_مخزن_بايت = خطوة * ارتفاع
        مهيأ = 1

        اطبع_سطر("═══ تهيئة إطار المخزن ═══")
        اطبع("  الوضع: ")
        اطبع(عرض)
        اطبع("x")
        اطبع(ارتفاع)
        اطبع("x")
        اطبع_سطر(عمق)
        اطبع("  الخطوة: ")
        اطبع(خطوة)
        اطبع_سطر(" بايت/سطر")
        اطبع("  الحجم: ")
        اطبع(حجم_مخزن_بايت / 1024)
        اطبع_سطر(" ك.ب")
        اطبع("  العنوان: ")
        اطبع_سطر(عنوان)
    نهاية

    دالة رقم موقع_بكسل(رقم س، رقم ص)
        ارجع عنوان_مخزن + (ص * خطوة_فعلية) + (س * 4)
    نهاية

    دالة مسح_شاشة(رقم لون)
        اطبع("  مسح الشاشة بلون: ")
        اطبع_سطر(لون)
    نهاية

    دالة رسم_مستطيل(رقم س، رقم ص، رقم عرض، رقم ارتفاع، رقم لون)
        اطبع("  مستطيل: (")
        اطبع(س)
        اطبع("،")
        اطبع(ص)
        اطبع(") ")
        اطبع(عرض)
        اطبع("x")
        اطبع_سطر(ارتفاع)
    نهاية

    دالة تبديل_مخازن()
        اذا (مخزن_ثاني_مفعل == 1)
            اطبع_سطر("  تبديل المخازن")
        نهاية
    نهاية

    دالة عرض_حالة()
        اذا (مهيأ == 1)
            اطبع_سطر("  ✅ إطار المخزن مهيأ")
        والا
            اطبع_سطر("  ❌ إطار المخزن غير مهيأ")
        نهاية
    نهاية
نهاية

دالة رئيسية()
    متغير مهيئ = جديد مهيئ_إطار()
    متغير تكوين = جديد تكوين_إطار()
    متغير ألوان = جديد ألوان_نظام()

    مهيئ.تهيئة(4026531840، 1024، 768، 32، 4096)

    ألوان.عرض()

    متغير لون1 = جديد لون_بكسل(255، 165، 0)
    اطبع("  لون نحل: ")
    لون1.عرض()
    اطبع(" = ")
    اطبع_سطر(لون1.قيمة_مدمجة())

    متغير لون_خلف = ألوان.خلفية_نظام
    مهيئ.مسح_شاشة(لون_خلف)
    متغير لون_ازرق = ألوان.أزرق_فاتح
    مهيئ.رسم_مستطيل(10، 10، 200، 100، لون_ازرق)

    اطبع("  موقع (100،50): ")
    اطبع_سطر(مهيئ.موقع_بكسل(100، 50))

    مهيئ.عرض_حالة()
    اطبع_سطر("  ✅ مهيئ إطار المخزن يعمل")
    ارجع 0
نهاية
