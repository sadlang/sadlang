# معالج الذعر - معالجة حالات الذعر المبكرة في النواة
# ══════════════════════════════════════════════════════════════════════

صنف معلومات_ذعر
    نص الرسالة
    نص الملف
    رقم السطر
    نص الدالة
    رقم رمز_خطأ

    باني(نص رسالة، نص ملف، رقم سطر)
        الرسالة = رسالة
        الملف = ملف
        السطر = سطر
        الدالة = "غير معروفة"
        رمز_خطأ = 0
    نهاية

    دالة عرض()
        اطبع_سطر("")
        اطبع_سطر("╔══════════════════════════════════════════════╗")
        اطبع_سطر("║        🐝 ذعر نواة خلية النحل! 🐝          ║")
        اطبع_سطر("╚══════════════════════════════════════════════╝")
        اطبع_سطر("")
        اطبع("  الرسالة: ")
        اطبع_سطر(الرسالة)
        اطبع("  الملف: ")
        اطبع_سطر(الملف)
        اطبع("  السطر: ")
        اطبع_سطر(السطر)
        اطبع("  الدالة: ")
        اطبع_سطر(الدالة)
        اذا (رمز_خطأ != 0)
            اطبع("  رمز الخطأ: ")
            اطبع_سطر(رمز_خطأ)
        نهاية
    نهاية
نهاية

صنف سجلات_معالج
    رقم قيمة_عامة_أ
    رقم قيمة_عامة_ب
    رقم قيمة_عامة_ج
    رقم مؤشر_مكدس
    رقم مؤشر_تعليمة
    رقم سجل_أعلام
    رقم سجل_تحكم_0
    رقم سجل_تحكم_2
    رقم سجل_تحكم_3

    باني()
        قيمة_عامة_أ = 0
        قيمة_عامة_ب = 0
        قيمة_عامة_ج = 0
        مؤشر_مكدس = 0
        مؤشر_تعليمة = 0
        سجل_أعلام = 0
        سجل_تحكم_0 = 0
        سجل_تحكم_2 = 0
        سجل_تحكم_3 = 0
    نهاية

    دالة عرض()
        اطبع_سطر("  ── سجلات المعالج ──")
        اطبع("    RAX=")
        اطبع_سطر(قيمة_عامة_أ)
        اطبع("    RBX=")
        اطبع_سطر(قيمة_عامة_ب)
        اطبع("    RCX=")
        اطبع_سطر(قيمة_عامة_ج)
        اطبع("    RSP=")
        اطبع_سطر(مؤشر_مكدس)
        اطبع("    RIP=")
        اطبع_سطر(مؤشر_تعليمة)
        اطبع("    RFLAGS=")
        اطبع_سطر(سجل_أعلام)
        اطبع("    CR0=")
        اطبع_سطر(سجل_تحكم_0)
        اطبع("    CR2=")
        اطبع_سطر(سجل_تحكم_2)
        اطبع("    CR3=")
        اطبع_سطر(سجل_تحكم_3)
    نهاية
نهاية

صنف تتبع_مكدس
    رقم مستوى
    رقم عنوان_إطار
    رقم عنوان_عودة

    باني(رقم م، رقم إطار، رقم عودة)
        مستوى = م
        عنوان_إطار = إطار
        عنوان_عودة = عودة
    نهاية

    دالة عرض()
        اطبع("    #")
        اطبع(مستوى)
        اطبع("  إطار=")
        اطبع(عنوان_إطار)
        اطبع("  عودة=")
        اطبع_سطر(عنوان_عودة)
    نهاية
نهاية

صنف معالج_حالة_ذعر
    رقم عدد_حالات_ذعر
    رقم آخر_رمز_خطأ
    رقم في_ذعر

    باني()
        عدد_حالات_ذعر = 0
        آخر_رمز_خطأ = 0
        في_ذعر = 0
    نهاية

    دالة ذعر(نص رسالة، نص ملف، رقم سطر)
        اذا (في_ذعر == 1)
            اطبع_سطر("!!! ذعر مزدوج - توقف فوري !!!")
        والا
            في_ذعر = 1
            عدد_حالات_ذعر = عدد_حالات_ذعر + 1

            متغير معلومات = جديد معلومات_ذعر(رسالة، ملف، سطر)
            معلومات.عرض()

            متغير سجلات = جديد سجلات_معالج()
            سجلات.مؤشر_تعليمة = 4294967296
            سجلات.مؤشر_مكدس = 4294901760
            سجلات.سجل_أعلام = 518
            سجلات.عرض()

            عرض_تتبع_مكدس()

            اطبع_سطر("")
            اطبع_سطر("  النظام متوقف. أعد التشغيل.")
            في_ذعر = 0
        نهاية
    نهاية

    دالة عرض_تتبع_مكدس()
        اطبع_سطر("  ── تتبع المكدس ──")
        متغير ت1 = جديد تتبع_مكدس(0، 4294901760، 4294967296)
        ت1.عرض()
        متغير ت2 = جديد تتبع_مكدس(1، 4294901824، 4294967200)
        ت2.عرض()
        متغير ت3 = جديد تتبع_مكدس(2، 4294901888، 4294967100)
        ت3.عرض()
    نهاية

    دالة تأكيد(رقم شرط، نص رسالة)
        اذا (شرط == 0)
            ذعر(رسالة، "تأكيد", 0)
        نهاية
    نهاية

    دالة عرض_إحصائيات()
        اطبع("  عدد حالات الذعر: ")
        اطبع_سطر(عدد_حالات_ذعر)
    نهاية
نهاية

دالة رئيسية()
    متغير معالج = جديد معالج_حالة_ذعر()

    معالج.ذعر("خطأ صفحة في عنوان غير صالح", "ذاكرة/ترحيل.ص", 142)

    اطبع_سطر("")
    معالج.تأكيد(1، "هذا التأكيد ناجح")
    اطبع_سطر("  التأكيد الأول نجح")

    معالج.عرض_إحصائيات()
    اطبع_سطر("  ✅ معالج الذعر يعمل")
    ارجع 0
نهاية
