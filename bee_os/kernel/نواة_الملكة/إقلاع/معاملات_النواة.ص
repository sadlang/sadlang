# معاملات النواة - تحليل سطر أوامر النواة ومعاملات التشغيل
# ══════════════════════════════════════════════════════════════════════

صنف معامل_نواة
    نص المفتاح
    نص القيمة
    رقم نوع_معامل
    رقم مفعل

    باني(نص مفتاح، نص قيمة)
        المفتاح = مفتاح
        القيمة = قيمة
        نوع_معامل = 1
        مفعل = 1
    نهاية

    دالة عرض()
        اطبع("    ")
        اطبع(المفتاح)
        اطبع(" = ")
        اطبع(القيمة)
        اذا (مفعل == 1)
            اطبع_سطر(" [مفعل]")
        والا
            اطبع_سطر(" [معطل]")
        نهاية
    نهاية
نهاية

صنف مستوى_تسجيل
    رقم مستوى
    نص وصف

    باني(رقم م)
        مستوى = م
        اذا (م == 0)
            وصف = "صامت"
        والا
            اذا (م == 1)
                وصف = "أخطاء فقط"
            والا
                اذا (م == 3)
                    وصف = "تحذيرات"
                والا
                    اذا (م == 5)
                        وصف = "معلومات"
                    والا
                        اذا (م == 7)
                            وصف = "تنقيح"
                        والا
                            وصف = "غير معروف"
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية

    دالة عرض()
        اطبع("  مستوى التسجيل: ")
        اطبع(مستوى)
        اطبع(" (")
        اطبع(وصف)
        اطبع_سطر(")")
    نهاية
نهاية

صنف تكوين_تنقيح
    رقم تنقيح_مفعل
    رقم كسر_عند_ذعر
    رقم تنقيح_ذاكرة
    رقم تنقيح_جدول
    رقم منفذ_تسلسلي_تنقيح

    باني()
        تنقيح_مفعل = 0
        كسر_عند_ذعر = 0
        تنقيح_ذاكرة = 0
        تنقيح_جدول = 0
        منفذ_تسلسلي_تنقيح = 1016
    نهاية

    دالة تفعيل_كل()
        تنقيح_مفعل = 1
        كسر_عند_ذعر = 1
        تنقيح_ذاكرة = 1
        تنقيح_جدول = 1
    نهاية

    دالة عرض()
        اطبع_سطر("  إعدادات التنقيح:")
        اطبع("    تنقيح: ")
        اطبع_سطر(تنقيح_مفعل)
        اطبع("    كسر عند ذعر: ")
        اطبع_سطر(كسر_عند_ذعر)
        اطبع("    تنقيح ذاكرة: ")
        اطبع_سطر(تنقيح_ذاكرة)
        اطبع("    منفذ تسلسلي: ")
        اطبع_سطر(منفذ_تسلسلي_تنقيح)
    نهاية
نهاية

صنف تكوين_عرض
    رقم عرض_مطلوب
    رقم ارتفاع_مطلوب
    رقم عمق_مطلوب
    رقم وضع_نصي
    نص خط_مطلوب

    باني()
        عرض_مطلوب = 1024
        ارتفاع_مطلوب = 768
        عمق_مطلوب = 32
        وضع_نصي = 0
        خط_مطلوب = "البسملة"
    نهاية

    دالة عرض()
        اطبع_سطر("  إعدادات العرض:")
        اطبع("    الوضع: ")
        اذا (وضع_نصي == 1)
            اطبع_سطر("نصي")
        والا
            اطبع(عرض_مطلوب)
            اطبع("x")
            اطبع(ارتفاع_مطلوب)
            اطبع("x")
            اطبع_سطر(عمق_مطلوب)
        نهاية
        اطبع("    الخط: ")
        اطبع_سطر(خط_مطلوب)
    نهاية
نهاية

صنف محلل_معاملات
    رقم عدد_معاملات
    نص سطر_أوامر_كامل

    باني()
        عدد_معاملات = 0
        سطر_أوامر_كامل = ""
    نهاية

    دالة تحليل(نص سطر_أوامر)
        سطر_أوامر_كامل = سطر_أوامر
        اطبع_سطر("═══ معاملات النواة ═══")
        اطبع("  سطر الأوامر: ")
        اطبع_سطر(سطر_أوامر)

        متغير م1 = جديد معامل_نواة("debug", "true")
        م1.عرض()
        عدد_معاملات = عدد_معاملات + 1

        متغير م2 = جديد معامل_نواة("loglevel", "7")
        م2.عرض()
        عدد_معاملات = عدد_معاملات + 1

        متغير م3 = جديد معامل_نواة("console", "serial")
        م3.عرض()
        عدد_معاملات = عدد_معاملات + 1

        متغير م4 = جديد معامل_نواة("root", "/dev/vda1")
        م4.عرض()
        عدد_معاملات = عدد_معاملات + 1

        اطبع("  عدد المعاملات: ")
        اطبع_سطر(عدد_معاملات)
    نهاية

    دالة تطبيق_تنقيح()
        متغير تنقيح = جديد تكوين_تنقيح()
        تنقيح.تفعيل_كل()
        تنقيح.عرض()
    نهاية

    دالة تطبيق_تسجيل()
        متغير تسجيل = جديد مستوى_تسجيل(7)
        تسجيل.عرض()
    نهاية

    دالة تطبيق_عرض()
        متغير عرض = جديد تكوين_عرض()
        عرض.عرض()
    نهاية
نهاية

دالة رئيسية()
    متغير محلل = جديد محلل_معاملات()
    محلل.تحليل("debug loglevel=7 console=serial root=/dev/vda1")
    محلل.تطبيق_تنقيح()
    محلل.تطبيق_تسجيل()
    محلل.تطبيق_عرض()
    اطبع_سطر("  ✅ معاملات النواة تعمل")
    ارجع 0
نهاية
