# حركة_إقلاع_HD.ص - حركة إقلاع عالية الدقة لنظام خلية النحل
# BeeOS HD Boot Animation - 1920×1080 Full HD
# ══════════════════════════════════════════════════════════════════════════════

متغير عرض_شاشة  = 1920
متغير ارت_شاشة  = 1080

# ألوان
متغير ل_أسود    = -16777216
متغير ل_أبيض    = -1
متغير ل_أصفر    = -256
متغير ل_رمادي   = -3355444
متغير ل_رمادي_غ = -12303292
متغير ل_برتقالي = -32768
متغير ل_ذهبي    = -2752

# ──────────────────────────────────────────────────────────────────
# رسم شعار النحلة (كبير في المنتصف)
# ──────────────────────────────────────────────────────────────────
دالة رسم_شعار(مقبض، cx، cy، مقياس)
    # جسم النحلة - دائرة رئيسية
    متغير نصف_قطر = 40 * مقياس
    ارسم_دائرة_مصمتة(مقبض، cx، cy، نصف_قطر، ل_أصفر)

    # خطوط سوداء على الجسم
    متغير خط_ع = 4 * مقياس
    متغير خط_ص = خط_ع * 2
    ارسم_مستطيل_أصلي(مقبض، cx - نصف_قطر + 10، cy - خط_ص، نصف_قطر * 2 - 20، خط_ع، ل_أسود)
    ارسم_مستطيل_أصلي(مقبض، cx - نصف_قطر + 10، cy + خط_ع، نصف_قطر * 2 - 20، خط_ع، ل_أسود)

    # أجنحة (دائرتان شفافتان فوق الجسم)
    متغير جناح_ر = 25 * مقياس
    متغير لون_جناح = امزج_لون(ل_أبيض، ل_أصفر، 30)
    ارسم_دائرة_مصمتة(مقبض، cx - 20 * مقياس، cy - 35 * مقياس، جناح_ر، لون_جناح)
    ارسم_دائرة_مصمتة(مقبض، cx + 20 * مقياس، cy - 35 * مقياس، جناح_ر، لون_جناح)

    # حدود الأجنحة
    ارسم_دائرة_أصلي(مقبض، cx - 20 * مقياس، cy - 35 * مقياس، جناح_ر، ل_أصفر)
    ارسم_دائرة_أصلي(مقبض، cx + 20 * مقياس، cy - 35 * مقياس، جناح_ر، ل_أصفر)

    # عيون
    ارسم_دائرة_مصمتة(مقبض، cx - 10 * مقياس، cy - 10 * مقياس، 4 * مقياس، ل_أسود)
    ارسم_دائرة_مصمتة(مقبض، cx + 10 * مقياس، cy - 10 * مقياس، 4 * مقياس، ل_أسود)

    # ابتسامة
    ارسم_خط_أصلي(مقبض، cx - 8 * مقياس، cy + 8 * مقياس، cx + 8 * مقياس، cy + 8 * مقياس، ل_أسود)

    # إبرة (مثلث مبسط)
    ارسم_مستطيل_أصلي(مقبض، cx - 2، cy + نصف_قطر، 4، 15 * مقياس، ل_أسود)

    ارجع 1
نهاية

# ──────────────────────────────────────────────────────────────────
# رسم شريط تحميل
# ──────────────────────────────────────────────────────────────────
دالة رسم_شريط_تحميل(مقبض، x، y، عرض_شريط، ارتفاع_شريط، نسبة)
    # الإطار الخارجي
    ارسم_إطار_أصلي(مقبض، x، y، عرض_شريط، ارتفاع_شريط، 2، ل_رمادي)

    # الخلفية الداخلية
    ارسم_مستطيل_أصلي(مقبض، x + 2، y + 2، عرض_شريط - 4، ارتفاع_شريط - 4، ل_رمادي_غ)

    # الشريط المملوء
    متغير عرض_ممتلئ = (عرض_شريط - 4) * نسبة / 100
    اذا (عرض_ممتلئ > 0)
        # تدرج ذهبي
        ارسم_تدرج_أفقي(مقبض، x + 2، y + 2، عرض_ممتلئ، ارتفاع_شريط - 4، ل_أصفر، ل_ذهبي)
    نهاية

    ارجع 1
نهاية

# ──────────────────────────────────────────────────────────────────
# مرحلة إقلاع واحدة
# ──────────────────────────────────────────────────────────────────
دالة رسم_إطار_إقلاع(مقبض، رقم_إطار، إجمالي_إطارات)
    متغير نسبة = رقم_إطار * 100 / إجمالي_إطارات

    # مسح الشاشة بالأسود
    املأ_مخزن(مقبض، ل_أسود)

    # حساب المركز
    متغير cx = عرض_شاشة / 2
    متغير cy = ارت_شاشة / 2 - 80

    # رسم الشعار
    رسم_شعار(مقبض، cx، cy، 2)

    # اسم النظام تحت الشعار
    ارسم_نص_أصلي(مقبض، cx - 80، cy + 120، "BeeOS"، 4، ل_أصفر)
    ارسم_نص_أصلي(مقبض، cx - 130، cy + 165، "Honeycomb Kernel v1.0"، 2، ل_رمادي)

    # شريط التحميل
    متغير شريط_x = cx - 200
    متغير شريط_y = cy + 210
    رسم_شريط_تحميل(مقبض، شريط_x، شريط_y، 400، 20، نسبة)

    # نص النسبة
    ارسم_نص_أصلي(مقبض، cx - 15، شريط_y + 30، "" + نسبة + "%"، 2، ل_أبيض)

    # رسائل الإقلاع حسب المرحلة
    متغير رسالة_y = شريط_y + 65

    اذا (نسبة < 15)
        ارسم_نص_أصلي(مقبض، cx - 120، رسالة_y، "Initializing kernel..."، 1، ل_رمادي)
    والا
        اذا (نسبة < 30)
            ارسم_نص_أصلي(مقبض، cx - 120، رسالة_y، "Loading memory manager..."، 1، ل_رمادي)
        والا
            اذا (نسبة < 45)
                ارسم_نص_أصلي(مقبض، cx - 120، رسالة_y، "Starting scheduler..."، 1، ل_رمادي)
            والا
                اذا (نسبة < 60)
                    ارسم_نص_أصلي(مقبض، cx - 120، رسالة_y، "Loading filesystem..."، 1، ل_رمادي)
                والا
                    اذا (نسبة < 75)
                        ارسم_نص_أصلي(مقبض، cx - 120، رسالة_y، "Initializing graphics..."، 1، ل_رمادي)
                    والا
                        اذا (نسبة < 90)
                            ارسم_نص_أصلي(مقبض، cx - 120، رسالة_y، "Starting desktop..."، 1، ل_رمادي)
                        والا
                            ارسم_نص_أصلي(مقبض، cx - 120، رسالة_y، "Welcome to BeeOS!"، 1، ل_أصفر)
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية

    # نقاط تحميل متحركة
    متغير نقطة_x = cx - 20
    متغير نقطة_y = رسالة_y + 25
    متغير ن = 0
    بينما (ن < 5)
        متغير شفافية = 20 + (رقم_إطار + ن * 2) % 5 * 15
        متغير لون_نقطة = امزج_لون(ل_أصفر، ل_أسود، شفافية)
        ارسم_دائرة_مصمتة(مقبض، نقطة_x + ن * 12، نقطة_y، 3، لون_نقطة)
        ن = ن + 1
    نهاية

    ارجع نسبة
نهاية

# ──────────────────────────────────────────────────────────────────
# الدالة الرئيسية
# ──────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== BeeOS Boot Animation ===")
    اطبع_سطر("")

    # إنشاء شاشة مزدوجة
    متغير شاشة = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)
    متغير خلفي = أنشئ_مخزن_رسوم(عرض_شاشة، ارت_شاشة)

    متغير إجمالي = 8
    متغير إطار = 0
    متغير مجموع_بكسل = 0

    اطبع_سطر("[BOOT] Starting animation sequence...")
    اطبع_سطر("")

    بينما (إطار <= إجمالي)
        متغير نسبة = رسم_إطار_إقلاع(خلفي، إطار، إجمالي)

        # swap
        انسخ_منطقة(خلفي، شاشة، 0، 0، 0، 0، عرض_شاشة، ارت_شاشة)

        # إحصاء البكسلات غير السوداء
        متغير أسود = عد_بكسلات(شاشة، ل_أسود)
        متغير غير_أسود = عرض_شاشة * ارت_شاشة - أسود
        مجموع_بكسل = مجموع_بكسل + غير_أسود

        اطبع("  Frame ")
        اطبع(إطار)
        اطبع(": ")
        اطبع(نسبة)
        اطبع("% - drawn pixels: ")
        اطبع_سطر(غير_أسود)

        إطار = إطار + 1
    نهاية

    # تصدير الإطار الأخير
    صدر_مخزن_ppm(شاشة، "C:\\beeos_boot.ppm")
    اطبع_سطر("")
    اطبع("Total non-black pixels across all frames: ")
    اطبع_سطر(مجموع_بكسل)
    اطبع_سطر("[EXPORT] C:\\beeos_boot.ppm")
    اطبع_سطر("")
    اطبع_سطر("=== Boot Animation: SUCCESS ===")

    ارجع 0
نهاية
