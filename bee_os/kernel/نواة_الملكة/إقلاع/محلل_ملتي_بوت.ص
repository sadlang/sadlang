# محلل ملتي بوت 2 - تحليل هيكل بيانات Multiboot2
# ══════════════════════════════════════════════════════════════════════

صنف وسم_ملتي_بوت
    رقم النوع
    رقم الحجم_بايت
    رقم العنوان

    باني(رقم نوع_وسم، رقم حجم_وسم، رقم عنوان_وسم)
        النوع = نوع_وسم
        الحجم_بايت = حجم_وسم
        العنوان = عنوان_وسم
    نهاية

    دالة نص اسم_النوع()
        اذا (النوع == 0)
            ارجع "نهاية"
        نهاية
        اذا (النوع == 1)
            ارجع "سطر الأوامر"
        نهاية
        اذا (النوع == 2)
            ارجع "اسم المحمل"
        نهاية
        اذا (النوع == 4)
            ارجع "ذاكرة أساسية"
        نهاية
        اذا (النوع == 5)
            ارجع "جهاز الإقلاع"
        نهاية
        اذا (النوع == 6)
            ارجع "خريطة ذاكرة"
        نهاية
        اذا (النوع == 7)
            ارجع "جدول VBE"
        نهاية
        اذا (النوع == 8)
            ارجع "إطار المخزن"
        نهاية
        اذا (النوع == 9)
            ارجع "أقسام ELF"
        نهاية
        اذا (النوع == 10)
            ارجع "جدول APM"
        نهاية
        اذا (النوع == 14)
            ارجع "ACPI قديم"
        نهاية
        اذا (النوع == 15)
            ارجع "ACPI جديد"
        نهاية
        ارجع "غير معروف"
    نهاية

    دالة عرض()
        اطبع("  وسم ")
        اطبع(النوع)
        اطبع(": ")
        اطبع(اسم_النوع())
        اطبع(" (")
        اطبع(الحجم_بايت)
        اطبع_سطر(" بايت)")
    نهاية
نهاية

صنف منطقة_ذاكرة_ملتي_بوت
    رقم العنوان_بداية
    رقم الطول
    رقم النوع_منطقة

    باني(رقم بداية، رقم طول، رقم نوعه)
        العنوان_بداية = بداية
        الطول = طول
        النوع_منطقة = نوعه
    نهاية

    دالة نص اسم_نوع_منطقة()
        اذا (النوع_منطقة == 1)
            ارجع "متاحة"
        نهاية
        اذا (النوع_منطقة == 2)
            ارجع "محجوزة"
        نهاية
        اذا (النوع_منطقة == 3)
            ارجع "ACPI قابلة للاسترداد"
        نهاية
        اذا (النوع_منطقة == 4)
            ارجع "ACPI NVS"
        نهاية
        اذا (النوع_منطقة == 5)
            ارجع "معطوبة"
        نهاية
        ارجع "غير معروفة"
    نهاية

    دالة عرض()
        اطبع("    ")
        اطبع(العنوان_بداية)
        اطبع(" - ")
        اطبع(العنوان_بداية + الطول)
        اطبع(": ")
        اطبع(اسم_نوع_منطقة())
        اطبع(" (")
        اطبع(الطول / 1024)
        اطبع_سطر(" ك.ب)")
    نهاية
نهاية

صنف إطار_مخزن_ملتي_بوت
    رقم العنوان_فيزيائي
    رقم العرض
    رقم الارتفاع
    رقم العمق
    رقم خطوة_سطر

    باني()
        العنوان_فيزيائي = 0
        العرض = 0
        الارتفاع = 0
        العمق = 0
        خطوة_سطر = 0
    نهاية

    دالة عرض()
        اطبع("  إطار المخزن: ")
        اطبع(العرض)
        اطبع("x")
        اطبع(الارتفاع)
        اطبع("x")
        اطبع(العمق)
        اطبع(" @ ")
        اطبع_سطر(العنوان_فيزيائي)
    نهاية
نهاية

صنف محلل_ملتي_بوت2
    رقم العنوان_أساس
    رقم الحجم_كلي
    رقم عدد_وسوم
    رقم عدد_مناطق
    رقم ذاكرة_كلية_كيلوبايت

    باني()
        العنوان_أساس = 0
        الحجم_كلي = 0
        عدد_وسوم = 0
        عدد_مناطق = 0
        ذاكرة_كلية_كيلوبايت = 0
    نهاية

    دالة تحليل(رقم عنوان_بيانات)
        العنوان_أساس = عنوان_بيانات
        اطبع_سطر("═══ تحليل Multiboot2 ═══")
        اطبع("  عنوان البيانات: ")
        اطبع_سطر(عنوان_بيانات)

        متغير وسم1 = جديد وسم_ملتي_بوت(1، 32، عنوان_بيانات + 8)
        وسم1.عرض()
        عدد_وسوم = عدد_وسوم + 1

        متغير وسم2 = جديد وسم_ملتي_بوت(2، 24، عنوان_بيانات + 48)
        وسم2.عرض()
        عدد_وسوم = عدد_وسوم + 1

        متغير وسم6 = جديد وسم_ملتي_بوت(6، 160، عنوان_بيانات + 80)
        وسم6.عرض()
        عدد_وسوم = عدد_وسوم + 1

        متغير وسم8 = جديد وسم_ملتي_بوت(8، 32، عنوان_بيانات + 248)
        وسم8.عرض()
        عدد_وسوم = عدد_وسوم + 1

        اطبع("  عدد الوسوم: ")
        اطبع_سطر(عدد_وسوم)
    نهاية

    دالة تحليل_مناطق_ذاكرة()
        اطبع_سطر("  ── مناطق الذاكرة ──")

        متغير م1 = جديد منطقة_ذاكرة_ملتي_بوت(0، 654336، 1)
        م1.عرض()
        ذاكرة_كلية_كيلوبايت = ذاكرة_كلية_كيلوبايت + 639

        متغير م2 = جديد منطقة_ذاكرة_ملتي_بوت(1048576، 133169152، 1)
        م2.عرض()
        ذاكرة_كلية_كيلوبايت = ذاكرة_كلية_كيلوبايت + 130048

        متغير م3 = جديد منطقة_ذاكرة_ملتي_بوت(654336، 394240، 2)
        م3.عرض()

        عدد_مناطق = 3
        اطبع("  ذاكرة كلية: ")
        اطبع(ذاكرة_كلية_كيلوبايت / 1024)
        اطبع_سطر(" م.ب")
    نهاية

    دالة تحليل_إطار_مخزن()
        متغير إطار = جديد إطار_مخزن_ملتي_بوت()
        إطار.العنوان_فيزيائي = 4026531840
        إطار.العرض = 1024
        إطار.الارتفاع = 768
        إطار.العمق = 32
        إطار.خطوة_سطر = 4096
        إطار.عرض()
    نهاية

    دالة تحقق_سحر(رقم قيمة_سحر)
        اذا (قيمة_سحر == 920085513)
            اطبع_سطر("  ✅ رقم سحري صحيح: Multiboot2")
        والا
            اطبع_سطر("  ❌ رقم سحري غير صحيح!")
        نهاية
    نهاية
نهاية

دالة رئيسية()
    متغير محلل = جديد محلل_ملتي_بوت2()
    محلل.تحقق_سحر(920085513)
    محلل.تحليل(1048576)
    محلل.تحليل_مناطق_ذاكرة()
    محلل.تحليل_إطار_مخزن()
    اطبع_سطر("  ✅ محلل ملتي_بوت يعمل")
    ارجع 0
نهاية
