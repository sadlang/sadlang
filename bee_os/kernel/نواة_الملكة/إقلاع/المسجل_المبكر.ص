# ══════════════════════════════════════════════════════════════════════
# المسجل المبكر - تسجيل مبكر عبر المنفذ التسلسلي
# ══════════════════════════════════════════════════════════════════════

صنف منفذ_تسلسلي
    رقم عنوان_أساس
    رقم معدل_بود
    رقم مهيأ

    باني(رقم عنوان، رقم معدل)
        عنوان_أساس = عنوان
        معدل_بود = معدل
        مهيأ = 0
    نهاية

    دالة تهيئة()
        اطبع("  تهيئة COM @ ")
        اطبع(عنوان_أساس)
        اطبع(" بمعدل ")
        اطبع_سطر(معدل_بود)
        مهيأ = 1
    نهاية

    دالة إرسال_حرف(رقم حرف)
        اذا (مهيأ == 0)
            تهيئة()
        نهاية
    نهاية

    دالة إرسال_نص(نص محتوى)
        اذا (مهيأ == 0)
            تهيئة()
        نهاية
        اطبع(محتوى)
    نهاية
نهاية

صنف مستوى_تسجيل
    رقم القيمة
    نص الاسم
    نص الرمز

    باني(رقم قيمة، نص اسم، نص رمز)
        القيمة = قيمة
        الاسم = اسم
        الرمز = رمز
    نهاية
نهاية

صنف مدخل_تسجيل
    نص الوقت
    نص المستوى_اسم
    نص المصدر
    نص الرسالة
    رقم رقم_تسلسلي

    باني(رقم تسلسلي، نص مستوى، نص مصدر، نص رسالة)
        رقم_تسلسلي = تسلسلي
        المستوى_اسم = مستوى
        المصدر = مصدر
        الرسالة = رسالة
        الوقت = "0.000"
    نهاية

    دالة تنسيق()
        اطبع("[")
        اطبع(الوقت)
        اطبع("] [")
        اطبع(المستوى_اسم)
        اطبع("] [")
        اطبع(المصدر)
        اطبع("] ")
        اطبع_سطر(الرسالة)
    نهاية
نهاية

صنف المسجل_المبكر
    رقم مستوى_تصفية
    رقم عداد_رسائل
    رقم تسلسلي_مفعل
    رقم شاشة_مفعل

    باني()
        مستوى_تصفية = 7
        عداد_رسائل = 0
        تسلسلي_مفعل = 1
        شاشة_مفعل = 0
    نهاية

    دالة تهيئة()
        اطبع_سطر("═══ المسجل المبكر ═══")
        متغير منفذ = جديد منفذ_تسلسلي(1016، 115200)
        منفذ.تهيئة()
        اطبع_سطر("  ✅ المنفذ التسلسلي مهيأ")
    نهاية

    دالة تسجيل(نص مستوى، نص مصدر، نص رسالة)
        عداد_رسائل = عداد_رسائل + 1
        متغير مدخل = جديد مدخل_تسجيل(عداد_رسائل، مستوى، مصدر، رسالة)
        مدخل.تنسيق()
    نهاية

    دالة تسجيل_خطأ(نص مصدر، نص رسالة)
        تسجيل("خطأ", مصدر، رسالة)
    نهاية

    دالة تسجيل_تحذير(نص مصدر، نص رسالة)
        تسجيل("تحذير", مصدر، رسالة)
    نهاية

    دالة تسجيل_معلومة(نص مصدر، نص رسالة)
        تسجيل("معلومة", مصدر، رسالة)
    نهاية

    دالة تنقيح_رسالة(نص مصدر، نص رسالة)
        اذا (مستوى_تصفية >= 7)
            تسجيل("تنقيح", مصدر، رسالة)
        نهاية
    نهاية

    دالة فاصل()
        اطبع_سطر("────────────────────────────────────")
    نهاية

    دالة عرض_إحصائيات()
        اطبع("  عدد الرسائل: ")
        اطبع_سطر(عداد_رسائل)
        اطبع("  مستوى التصفية: ")
        اطبع_سطر(مستوى_تصفية)
        اطبع("  تسلسلي: ")
        اطبع_سطر(تسلسلي_مفعل)
    نهاية
نهاية

دالة رئيسية()
    متغير مسجلنا = جديد المسجل_المبكر()
    مسجلنا.تهيئة()
    مسجلنا.فاصل()

    مسجلنا.تسجيل_معلومة("إقلاع", "بدء تهيئة النواة")
    مسجلنا.تسجيل_معلومة("ذاكرة", "كشف خريطة الذاكرة")
    مسجلنا.تسجيل_معلومة("ذاكرة", "ذاكرة متاحة: 128 م.ب")
    مسجلنا.تنقيح_رسالة("ذاكرة", "تهيئة مخصص الصفحات")
    مسجلنا.تسجيل_معلومة("مقاطعات", "تهيئة IDT")
    مسجلنا.تسجيل_تحذير("عرض", "إطار المخزن غير مكتشف بعد")
    مسجلنا.تسجيل_معلومة("عرض", "تم كشف إطار المخزن")
    مسجلنا.تنقيح_رسالة("عرض", "تحميل خط عربي")
    مسجلنا.تسجيل_خطأ("شبكة", "لا توجد بطاقة شبكة")

    مسجلنا.فاصل()
    مسجلنا.عرض_إحصائيات()
    اطبع_سطر("  ✅ المسجل المبكر يعمل")
    ارجع 0
نهاية
