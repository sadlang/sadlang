# ══════════════════════════════════════════════════════════════════════
# دوال الإقلاع - تهيئة النواة بعد الإقلاع
# ══════════════════════════════════════════════════════════════════════

صنف مرحلة_إقلاع
    نص الاسم
    رقم مكتملة
    رقم المدة

    باني(نص اسم_مرحلة)
        الاسم = اسم_مرحلة
        مكتملة = 0
        المدة = 0
    نهاية

    دالة عرض()
        اطبع("  [")
        اذا (مكتملة == 1)
            اطبع("✓")
        والا
            اطبع(" ")
        نهاية
        اطبع("] ")
        اطبع(الاسم)
        اطبع(" (")
        اطبع(المدة)
        اطبع_سطر(" مل ث)")
    نهاية
نهاية

صنف سجل_إقلاع
    نص اسم_المحمل
    رقم رقم_سحري
    رقم عنوان_معلومات
    رقم عدد_المراحل
    رقم مرحلة_حالية

    باني()
        اسم_المحمل = "غير معروف"
        رقم_سحري = 0
        عنوان_معلومات = 0
        عدد_المراحل = 0
        مرحلة_حالية = 0
    نهاية

    دالة عرض()
        اطبع_سطر("")
        اطبع_سطر("══════════════════════════════════════════════")
        اطبع_سطر("  🐝 إقلاع نظام خلية النحل")
        اطبع_سطر("══════════════════════════════════════════════")
        اطبع("  المحمل: ")
        اطبع_سطر(اسم_المحمل)
        اطبع("  الرقم السحري: ")
        اطبع_سطر(رقم_سحري)
    نهاية
نهاية

صنف مدير_الإقلاع
    رقم حالة_عملية
    نص ترتيب_بايت
    رقم عدد_معالجات

    باني()
        حالة_عملية = 0
        ترتيب_بايت = "صغير"
        عدد_معالجات = 1
    نهاية

    دالة تهيئة_مبكرة(رقم سحر_محمل، رقم عنوان_بيانات)
        متغير السجل = جديد سجل_إقلاع()
        السجل.رقم_سحري = سحر_محمل
        السجل.عنوان_معلومات = عنوان_بيانات

        اذا (سحر_محمل == 920085513)
            السجل.اسم_المحمل = "Multiboot2"
        والا
            السجل.اسم_المحمل = "Limine"
        نهاية

        السجل.عرض()
        حالة_عملية = 1
    نهاية

    دالة تهيئة_تسلسلي()
        متغير م = جديد مرحلة_إقلاع("تهيئة المنفذ التسلسلي")
        اطبع_سطر("  تهيئة COM1 @ 115200")
        م.مكتملة = 1
        م.المدة = 2
        م.عرض()
    نهاية

    دالة تهيئة_ذاكرة()
        متغير م = جديد مرحلة_إقلاع("تهيئة الذاكرة")
        اطبع_سطر("  كشف خريطة الذاكرة")
        اطبع_سطر("  تهيئة مخصص الصفحات")
        اطبع_سطر("  إعداد الترحيل")
        م.مكتملة = 1
        م.المدة = 50
        م.عرض()
    نهاية

    دالة تهيئة_مقاطعات()
        متغير م = جديد مرحلة_إقلاع("تهيئة المقاطعات")
        اطبع_سطر("  إعداد IDT")
        اطبع_سطر("  تسجيل المعالجات")
        اطبع_سطر("  تفعيل المقاطعات")
        م.مكتملة = 1
        م.المدة = 10
        م.عرض()
    نهاية

    دالة تهيئة_مؤقت()
        متغير م = جديد مرحلة_إقلاع("تهيئة المؤقت")
        اطبع_سطر("  إعداد PIT @ 1000Hz")
        م.مكتملة = 1
        م.المدة = 5
        م.عرض()
    نهاية

    دالة تهيئة_عرض()
        متغير م = جديد مرحلة_إقلاع("تهيئة العرض")
        اطبع_سطر("  كشف إطار المخزن")
        اطبع_سطر("  تحميل خط البسملة")
        م.مكتملة = 1
        م.المدة = 100
        م.عرض()
    نهاية

    دالة بدء_النواة()
        اطبع_سطر("")
        اطبع_سطر("  ✅ الإقلاع مكتمل")
        اطبع("  عدد المعالجات: ")
        اطبع_سطر(عدد_معالجات)
        اطبع_سطر("  نقل التحكم إلى النواة...")
        حالة_عملية = 2
    نهاية

    دالة تنفيذ_إقلاع_كامل(رقم سحر_محمل، رقم عنوان_بيانات)
        تهيئة_مبكرة(سحر_محمل، عنوان_بيانات)
        تهيئة_تسلسلي()
        تهيئة_ذاكرة()
        تهيئة_مقاطعات()
        تهيئة_مؤقت()
        تهيئة_عرض()
        بدء_النواة()
    نهاية
نهاية

دالة رئيسية()
    متغير مدير = جديد مدير_الإقلاع()
    مدير.تنفيذ_إقلاع_كامل(920085513، 1048576)
    اطبع_سطر("  ✅ دوال الإقلاع تعمل")
    ارجع 0
نهاية
