        الناقل = ناقل_ل
        الجهاز_رقم = جهاز_ل
        الوظيفة = وظيفة_ل
        معرّف_المصنّع = 0
        معرّف_الجهاز_م = 0
        فئة_الجهاز = 0
        فئة_فرعية = 0
        وصف_الجهاز = "غير معروف"
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف معلومات_المعالج - نتائج CPUID
# ─────────────────────────────────────────────────────────────────────────────
صنف معلومات_المعالج
    ## معلومات المعالج المكتشفة عبر CPUID

    نص اسم_المُصنّع           # "GenuineIntel" أو "AuthenticAMD"
    رقم العائلة               # Family
    رقم الطراز                # Model
    رقم الخطوة                # Stepping
    منطقي دعم_SSE             # SSE مدعوم؟
    منطقي دعم_SSE2            # SSE2 مدعوم؟
    منطقي دعم_AVX             # AVX مدعوم؟
    منطقي دعم_x86_64          # 64-bit مدعوم؟
    منطقي دعم_APIC            # APIC مدعوم؟
    رقم تردد_تقريبي           # بالميغاهرتز (تقدير)

    باني()
        اسم_المُصنّع = "غير_معروف"
        العائلة = 0
        الطراز = 0
        الخطوة = 0
        دعم_SSE = خطأ
        دعم_SSE2 = خطأ
        دعم_AVX = خطأ
        دعم_x86_64 = خطأ
        دعم_APIC = خطأ
        تردد_تقريبي = 0
    نهاية

    دالة اطبع_معلومات()
        اطبع("  🖥️ المُصنّع: ") اطبع_سطر(اسم_المُصنّع)
        اطبع("  📊 العائلة/الطراز/الخطوة: ")
        اطبع(العائلة) اطبع("/") اطبع(الطراز) اطبع("/") اطبع_سطر(الخطوة)
        اطبع("  ⚡ التردد: ") اطبع(تردد_تقريبي) اطبع_سطر(" MHz")
        اطبع("  SSE: ") اطبع(دعم_SSE) اطبع("  SSE2: ") اطبع(دعم_SSE2)
        اطبع("  AVX: ") اطبع(دعم_AVX) اطبع("  x64: ") اطبع_سطر(دعم_x86_64)
        اطبع("  APIC: ") اطبع_سطر(دعم_APIC)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف منطقة_عازلة_تسلسلية - UART Ring Buffer
# ─────────────────────────────────────────────────────────────────────────────
صنف منطقة_عازلة_تسلسلية
    ## منطقة عازلة دائرية للمنفذ التسلسلي (ring buffer)

    مصفوفة المخزن             # المصفوفة الداخلية
    رقم سعة_المخزن            # السعة القصوى
    رقم رأس_الكتابة          # فهرس الكتابة
    رقم رأس_القراءة          # فهرس القراءة
    رقم عدد_العناصر           # العناصر الحالية

    باني(رقم السعة_ل)
        المخزن = []
        سعة_المخزن = السعة_ل
        رأس_الكتابة = 0
        رأس_القراءة = 0
        عدد_العناصر = 0
        # ملء المخزن بأصفار
        متغير ع = 0
        بينما (ع < السعة_ل)
            المخزن += [0]
            ع = ع + 1
        نهاية
    نهاية

    ## إضافة عنصر
    دالة منطقي اكتب(رقم قيمة_ل)
        اذا (عدد_العناصر >= سعة_المخزن) ارجع خطأ نهاية
        المخزن[رأس_الكتابة] = قيمة_ل
        رأس_الكتابة = (رأس_الكتابة + 1) % سعة_المخزن
        عدد_العناصر = عدد_العناصر + 1
        ارجع صحيح
    نهاية

    ## قراءة عنصر
    دالة رقم اقرأ()
        اذا (عدد_العناصر <= 0) ارجع -1 نهاية
        متغير قيمة = المخزن[رأس_القراءة]
        رأس_القراءة = (رأس_القراءة + 1) % سعة_المخزن
        عدد_العناصر = عدد_العناصر - 1
        ارجع قيمة
    نهاية

    ## هل ممتلئة؟
    دالة منطقي ممتلئة()
        ارجع عدد_العناصر >= سعة_المخزن
    نهاية

    ## هل فارغة؟
    دالة منطقي فارغة()
        ارجع عدد_العناصر == 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# المتغيرات العامة (بديل تركيب الأصناف)
# ─────────────────────────────────────────────────────────────────────────────
متغير ع_معالج = جديد معلومات_المعالج()
متغير ع_عازلة_COM1 = جديد منطقة_عازلة_تسلسلية(256)

# ─────────────────────────────────────────────────────────────────────────────
# صنف كاشف_العتاد - Hardware Detector
# ─────────────────────────────────────────────────────────────────────────────
صنف كاشف_العتاد
    ## يكتشف ويسجّل العتاد المتاح أثناء الإقلاع المبكر
    ## يُحاكي CPUID وE820 memory map وPCI bus scan

    مصفوفة مناطق_الذاكرة     # مناطق الذاكرة المكتشفة
    مصفوفة أجهزة_PCI         # أجهزة PCI المكتشفة
    رقم إجمالي_الذاكرة       # إجمالي RAM بالبايت
    رقم ذاكرة_متاحة          # RAM المتاحة بالبايت

    باني()
        مناطق_الذاكرة = []
        أجهزة_PCI = []
        إجمالي_الذاكرة = 0
        ذاكرة_متاحة = 0
    نهاية

    ## محاكاة CPUID - اكتشاف المعالج
    دالة اكشف_المعالج()
        اطبع_سطر("  🔍 كشف المعالج (CPUID)...")
        # محاكاة: معالج Intel حديث
        ع_معالج.اسم_المُصنّع = "GenuineIntel"
        ع_معالج.العائلة = 6
        ع_معالج.الطراز = 158
        ع_معالج.الخطوة = 10
        ع_معالج.دعم_SSE = صحيح
        ع_معالج.دعم_SSE2 = صحيح
        ع_معالج.دعم_AVX = صحيح
        ع_معالج.دعم_x86_64 = صحيح
        ع_معالج.دعم_APIC = صحيح
        ع_معالج.تردد_تقريبي = 3600
    نهاية

    ## محاكاة E820 - خريطة الذاكرة الفعلية
    دالة اكشف_الذاكرة()
        اطبع_سطر("  🔍 كشف الذاكرة (E820)...")

        # منطقة 1: 0-640KB (RAM التقليدي)
        متغير م1 = جديد منطقة_ذاكرة(0، 655360، 1)
        مناطق_الذاكرة += [م1]

        # منطقة 2: 640KB-1MB (ROM/BIOS محجوز)
        متغير م2 = جديد منطقة_ذاكرة(655360، 393216، 2)
        مناطق_الذاكرة += [م2]

        # منطقة 3: 1MB-256MB (RAM رئيسي)
        متغير م3 = جديد منطقة_ذاكرة(1048576، 267386880، 1)
        مناطق_الذاكرة += [م3]

        # منطقة 4: ACPI
        متغير م4 = جديد منطقة_ذاكرة(268435456، 65536، 3)
        مناطق_الذاكرة += [م4]

        # حساب الإجمالي والمتاح
        متغير ف = 0
        بينما (ف < طول(مناطق_الذاكرة))
            إجمالي_الذاكرة = إجمالي_الذاكرة + مناطق_الذاكرة[ف].المقاس_بايت
            اذا (مناطق_الذاكرة[ف].قابلة_استخدام)
                ذاكرة_متاحة = ذاكرة_متاحة + مناطق_الذاكرة[ف].المقاس_بايت
            نهاية
            ف = ف + 1
        نهاية
    نهاية

    ## محاكاة مسح PCI
    دالة اكشف_PCI()
        اطبع_سطر("  🔍 مسح ناقل PCI...")

        # محاكاة اكتشاف أجهزة
        # جهاز 1: بطاقة VGA
        متغير ج1 = جديد جهاز_PCI(0، 2، 0)
        ج1.معرّف_المصنّع = 32902      # 0x8086 Intel
        ج1.معرّف_الجهاز_م = 16146     # VGA
        ج1.فئة_الجهاز = 3             # Display
        ج1.فئة_فرعية = 0              # VGA compatible
        ج1.وصف_الجهاز = "بطاقة عرض VGA"
        أجهزة_PCI += [ج1]

        # جهاز 2: متحكم Ethernet
        متغير ج2 = جديد جهاز_PCI(0، 25، 0)
        ج2.معرّف_المصنّع = 32902
        ج2.معرّف_الجهاز_م = 5369      # Ethernet
        ج2.فئة_الجهاز = 2             # Network
        ج2.فئة_فرعية = 0              # Ethernet
        ج2.وصف_الجهاز = "متحكم شبكة Ethernet"
        أجهزة_PCI += [ج2]

        # جهاز 3: متحكم AHCI (SATA)
        متغير ج3 = جديد جهاز_PCI(0، 31، 2)
        ج3.معرّف_المصنّع = 32902
        ج3.معرّف_الجهاز_م = 40961     # AHCI
        ج3.فئة_الجهاز = 1             # Mass Storage
        ج3.فئة_فرعية = 6              # SATA
        ج3.وصف_الجهاز = "متحكم تخزين AHCI/SATA"
        أجهزة_PCI += [ج3]
    نهاية

    ## طباعة ملخص العتاد
    دالة اطبع_ملخص()
        اطبع_سطر("────── ملخص العتاد المكتشف ──────")
        ع_معالج.اطبع_معلومات()
        اطبع("  💾 إجمالي RAM: ") اطبع(إجمالي_الذاكرة / 1048576) اطبع_سطر(" MB")
        اطبع("  📦 RAM متاح: ") اطبع(ذاكرة_متاحة / 1048576) اطبع_سطر(" MB")
        اطبع("  🔌 مناطق ذاكرة: ") اطبع_سطر(طول(مناطق_الذاكرة))
        اطبع("  🔌 أجهزة PCI: ") اطبع_سطر(طول(أجهزة_PCI))
        متغير ف = 0
        بينما (ف < طول(أجهزة_PCI))
            اطبع("    PCI ") اطبع(أجهزة_PCI[ف].الناقل) اطبع(":")
            اطبع(أجهزة_PCI[ف].الجهاز_رقم) اطبع(".")
            اطبع(أجهزة_PCI[ف].الوظيفة) اطبع(" → ")
            اطبع_سطر(أجهزة_PCI[ف].وصف_الجهاز)
            ف = ف + 1
        نهاية
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مُهيّئ_الجداول - GDT + IDT Setup
# ─────────────────────────────────────────────────────────────────────────────
صنف مُهيّئ_الجداول
    ## يُنشئ ويُحمّل GDT و IDT
    ## GDT: 6 مدخلات (فارغ + كود حلقة0 + بيانات حلقة0 + كود حلقة3 + بيانات حلقة3 + TSS)
    ## IDT: 256 مدخلة لمعالجة المقاطعات

    مصفوفة جدول_GDT           # مدخلات GDT
    مصفوفة جدول_IDT           # مدخلات IDT
    منطقي GDT_محمّل
    منطقي IDT_محمّل

    باني()
        جدول_GDT = []
        جدول_IDT = []
        GDT_محمّل = خطأ
        IDT_محمّل = خطأ
    نهاية

    ## إعداد GDT
    دالة أعدّ_GDT()
        اطبع_سطر("  📋 إعداد GDT...")

        # المدخلة 0: فارغة (إلزامية)
        متغير م0 = جديد مدخلة_GDT(0، 0، 0، 0، "فارغة (Null)")
        جدول_GDT += [م0]

        # المدخلة 1: كود حلقة 0 (النواة)
        # الحد=0xFFFFF، القاعدة=0، الوصول=0x9A (Present+Ring0+Code+Execute+Read)
        متغير م1 = جديد مدخلة_GDT(0، 1048575، 154، 12، "كود النواة (Ring 0)")
        جدول_GDT += [م1]

        # المدخلة 2: بيانات حلقة 0
        # الوصول=0x92 (Present+Ring0+Data+Read+Write)
        متغير م2 = جديد مدخلة_GDT(0، 1048575، 146، 12، "بيانات النواة (Ring 0)")
        جدول_GDT += [م2]

        # المدخلة 3: كود حلقة 3 (المستخدم)
        # الوصول=0xFA (Present+Ring3+Code+Execute+Read)
        متغير م3 = جديد مدخلة_GDT(0، 1048575، 250، 12، "كود المستخدم (Ring 3)")
        جدول_GDT += [م3]

        # المدخلة 4: بيانات حلقة 3
        # الوصول=0xF2 (Present+Ring3+Data+Read+Write)
        متغير م4 = جديد مدخلة_GDT(0، 1048575، 242، 12، "بيانات المستخدم (Ring 3)")
        جدول_GDT += [م4]

        # المدخلة 5: TSS (Task State Segment)
        # الوصول=0x89 (Present+TSS Available)
        متغير م5 = جديد مدخلة_GDT(0، 104، 137، 0، "TSS")
        جدول_GDT += [م5]

        GDT_محمّل = صحيح
        اطبع("    → ") اطبع(طول(جدول_GDT)) اطبع_سطر(" مدخلات GDT")
    نهاية

    ## إعداد IDT
    دالة أعدّ_IDT()
        اطبع_سطر("  📋 إعداد IDT...")

        # أول 32 مقاطعة: استثناءات المعالج
        متغير ف = 0
        بينما (ف < 32)
            متغير مدخلة = جديد مدخلة_IDT(0، 8، 142)  # 0x8E = بوابة مقاطعة
            جدول_IDT += [مدخلة]
            ف = ف + 1
        نهاية

        # مقاطعات 32-47: IRQ من PIC (عتاد)
        بينما (ف < 48)
            متغير مدخلة_عتاد = جديد مدخلة_IDT(0، 8، 142)
            جدول_IDT += [مدخلة_عتاد]
            ف = ف + 1
        نهاية

        # الباقي: 48-255 (لاستدعاءات النظام والمستقبل)
        بينما (ف < 256)
            متغير مدخلة_عامة = جديد مدخلة_IDT(0، 8، 238)  # 0xEE = Ring3 بوابة
            جدول_IDT += [مدخلة_عامة]
            ف = ف + 1
        نهاية

        IDT_محمّل = صحيح
        اطبع("    → ") اطبع(طول(جدول_IDT)) اطبع_سطر(" مدخلة IDT")
    نهاية

    ## طباعة جدول GDT
    دالة اطبع_GDT()
        اطبع_سطر("────── جدول الواصفات العام (GDT) ──────")
        متغير ف = 0
        بينما (ف < طول(جدول_GDT))
            اطبع("  [") اطبع(ف) اطبع("] ")
            اطبع(جدول_GDT[ف].الوصف)
            اطبع(" القاعدة=") اطبع(جدول_GDT[ف].القاعدة)
            اطبع(" الحد=") اطبع_سطر(جدول_GDT[ف].الحد)
            ف = ف + 1
        نهاية
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مُهيّئ_PIC - Programmable Interrupt Controller
# ─────────────────────────────────────────────────────────────────────────────
صنف مُهيّئ_PIC
    ## يُبرمج PIC 8259 (الرئيسي والثانوي)
    ## يُعيد توجيه IRQ 0-15 إلى INT 32-47

    مصفوفة قناع_IRQ            # 16 عنصر (0=مفعّل، 1=معطّل)
    رقم إزاحة_رئيسي            # إزاحة المتحكم الرئيسي (عادة 32)
    رقم إزاحة_ثانوي            # إزاحة الثانوي (عادة 40)
    منطقي مُبرمَج

    باني()
        قناع_IRQ = []
        إزاحة_رئيسي = 32
        إزاحة_ثانوي = 40
        مُبرمَج = خطأ
        # جميع IRQ مُفعّلة مبدئياً
        متغير ف = 0
        بينما (ف < 16)
            قناع_IRQ += [0]
            ف = ف + 1
        نهاية
    نهاية

    ## برمجة PIC (محاكاة ICW1-ICW4)
    دالة برمج()
        اطبع_سطر("  ⚡ برمجة PIC 8259...")

        # ICW1: بدء التهيئة (0x11 = cascade + ICW4 مطلوب)
        # في الحقيقي: outb(PIC1_CMD, 0x11); outb(PIC2_CMD, 0x11)

        # ICW2: إزاحة (رئيسي=32، ثانوي=40)
        # في الحقيقي: outb(PIC1_DATA, 32); outb(PIC2_DATA, 40)

        # ICW3: ربط الثانوي بـ IRQ2
        # في الحقيقي: outb(PIC1_DATA, 4); outb(PIC2_DATA, 2)

        # ICW4: وضع 8086
        # في الحقيقي: outb(PIC1_DATA, 1); outb(PIC2_DATA, 1)

        مُبرمَج = صحيح
        اطبع("    → PIC1 إزاحة=") اطبع(إزاحة_رئيسي)
        اطبع("  PIC2 إزاحة=") اطبع_سطر(إزاحة_ثانوي)
    نهاية

    ## تعطيل IRQ محدد
    دالة عطّل_IRQ(رقم رقم_IRQ)
        اذا (رقم_IRQ >= 0 && رقم_IRQ < 16)
            قناع_IRQ[رقم_IRQ] = 1
        نهاية
    نهاية

    ## تفعيل IRQ محدد
    دالة فعّل_IRQ(رقم رقم_IRQ)
        اذا (رقم_IRQ >= 0 && رقم_IRQ < 16)
            قناع_IRQ[رقم_IRQ] = 0
        نهاية
    نهاية

    ## إعداد PIT (مؤقت الحفرة)
    دالة أعدّ_PIT(رقم تردد_مطلوب)
        اطبع("  ⏱️ إعداد PIT بتردد ") اطبع(تردد_مطلوب) اطبع_سطر(" Hz")
        متغير المقسوم = عتاد_PIT_تردد / تردد_مطلوب
        # في الحقيقي:
        # outb(PIT_CMD, 0x36)    # قناة 0 + موجة مربعة + 2 بايت
        # outb(PIT_CH0, divisor & 0xFF)
        # outb(PIT_CH0, divisor >> 8)
        اطبع("    → المقسوم=") اطبع_سطر(المقسوم)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مُخصّص_الذاكرة_المبكر - Bootmem Allocator
# ─────────────────────────────────────────────────────────────────────────────
صنف مُخصّص_الذاكرة_المبكر
    ## مُخصّص ذاكرة خطي بسيط للإقلاع المبكر
    ## يعمل قبل تهيئة مدير الذاكرة الكامل (PMM/VMM)

    رقم عنوان_البداية         # عنوان البداية (عادة بعد النواة)
    رقم المقاس_الكلي          # الحجم الكلي بالبايت
    رقم المستخدم              # البايتات المستخدمة
    مصفوفة تخصيصات           # سجل التخصيصات [عنوان، حجم]

    باني()
        عنوان_البداية = 0
        المقاس_الكلي = 0
        المستخدم = 0
        تخصيصات = []
    نهاية

    ## تهيئة مع نطاق الذاكرة المتاحة
    دالة هيئ(رقم عنوان_ل، رقم مقاس_ل)
        عنوان_البداية = عنوان_ل
        المقاس_الكلي = مقاس_ل
        المستخدم = 0
        اطبع("  📦 Bootmem: ") اطبع(عنوان_ل) اطبع(" → ")
        اطبع(عنوان_ل + مقاس_ل) اطبع(" (") اطبع(مقاس_ل / 1024) اطبع_سطر(" KB)")
    نهاية

    ## تخصيص بايتات (محاذاة للصفحة)
    دالة رقم خصّص(رقم مقاس_ل)
        # محاذاة لحدود الصفحة
        متغير مقاس_محاذى = مقاس_ل
        اذا (مقاس_ل % BOOTMEM_مقاس_صفحة > 0)
            مقاس_محاذى = ((مقاس_ل / BOOTMEM_مقاس_صفحة) + 1) * BOOTMEM_مقاس_صفحة
        نهاية

        # فحص المتاح
        اذا (المستخدم + مقاس_محاذى > المقاس_الكلي)
            ارجع -1
        نهاية

        # تخصيص خطي
        متغير عنوان_مخصص = عنوان_البداية + المستخدم
        المستخدم = المستخدم + مقاس_محاذى
        تخصيصات += [عنوان_مخصص]

        ارجع عنوان_مخصص
    نهاية

    ## الذاكرة المتبقية
    دالة رقم المتبقي()
        ارجع المقاس_الكلي - المستخدم
    نهاية

    ## نسبة الاستخدام
    دالة رقم نسبة_الاستخدام()
        اذا (المقاس_الكلي == 0) ارجع 0 نهاية
        ارجع (المستخدم * 100) / المقاس_الكلي
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مراقب_الإقلاع - Boot Watchdog
# ─────────────────────────────────────────────────────────────────────────────
صنف مراقب_الإقلاع
    ## رقابة الإقلاع: يراقب نجاح الإقلاع ويتعامل مع الفشل المتكرر

    رقم محاولة_حالية          # رقم المحاولة الحالية
    رقم أقصى_محاولات          # أقصى عدد محاولات
    مصفوفة سجل_المحاولات     # نتائج المحاولات السابقة (0=فشل، 1=نجاح)
    منطقي وضع_آمن             # هل دخلنا الوضع الآمن؟
    رقم آخر_نبضة              # آخر نبضة قلب (heartbeat)

    باني()
        محاولة_حالية = 1
        أقصى_محاولات = أقصى_محاولات_إقلاع
        سجل_المحاولات = []
        وضع_آمن = خطأ
        آخر_نبضة = 0
    نهاية

    ## تسجيل بدء محاولة إقلاع
    دالة ابدأ_محاولة()
        اطبع("  🔄 محاولة إقلاع #") اطبع_سطر(محاولة_حالية)
        اذا (محاولة_حالية > أقصى_محاولات)
            اطبع_سطر("  ⚠️ تجاوز أقصى محاولات — الوضع الآمن!")
            وضع_آمن = صحيح
        نهاية
    نهاية

    ## تسجيل نجاح الإقلاع
    دالة سجّل_نجاح()
        سجل_المحاولات += [1]
        محاولة_حالية = محاولة_حالية + 1
    نهاية

    ## تسجيل فشل الإقلاع
    دالة سجّل_فشل()
        سجل_المحاولات += [0]
        محاولة_حالية = محاولة_حالية + 1
    نهاية

    ## نبضة قلب (heartbeat)
    دالة نبض(رقم الوقت_الحالي)
        آخر_نبضة = الوقت_الحالي
    نهاية

    ## فحص تجاوز المهلة
    دالة منطقي تجاوز_المهلة(رقم الوقت_الحالي)
        اذا (آخر_نبضة == 0) ارجع خطأ نهاية
        ارجع (الوقت_الحالي - آخر_نبضة) > مهلة_مراقبة
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف نظام_الإقلاع_المُقوّى - النظام الرئيسي
# ─────────────────────────────────────────────────────────────────────────────
صنف نظام_الإقلاع_المُقوّى
    ## نظام الإقلاع الكامل المُقوّى
    ## يُنسّق جميع مراحل الإقلاع من POST إلى تسليم النواة

    مصفوفة المراحل             # مراحل الإقلاع
    رقم الوقت_الحالي           # ساعة وهمية (مللي ثانية)
    منطقي إقلاع_ناجح

    باني()
        المراحل = []
        الوقت_الحالي = 0
        إقلاع_ناجح = خطأ
    نهاية

    ## تهيئة مراحل الإقلاع
    دالة هيئ()
        اطبع_سطر("🐝 بسم الله الرحمن الرحيم 🐝")
        اطبع_سطر("🐝 بيضة الإقلاع — نظام خلية النحل 🐝")

        متغير م1 = جديد مرحلة_إقلاع_م(م_كشف_عتاد، "كشف العتاد"، صحيح)
        متغير م2 = جديد مرحلة_إقلاع_م(م_GDT_IDT، "GDT + IDT"، صحيح)
        متغير م3 = جديد مرحلة_إقلاع_م(م_مقاطعات، "المقاطعات"، صحيح)
        متغير م4 = جديد مرحلة_إقلاع_م(م_تسلسلي، "المنفذ التسلسلي"، خطأ)
        متغير م5 = جديد مرحلة_إقلاع_م(م_ذاكرة_مبكرة، "Bootmem"، صحيح)
        متغير م6 = جديد مرحلة_إقلاع_م(م_تسليم_النواة، "تسليم النواة"، صحيح)
        المراحل += [م1]
        المراحل += [م2]
        المراحل += [م3]
        المراحل += [م4]
        المراحل += [م5]
        المراحل += [م6]
    نهاية

    ## تنفيذ مرحلة كشف العتاد
    دالة منطقي نفّذ_كشف_عتاد()
        الوقت_الحالي = الوقت_الحالي + 50
        المراحل[0].ابدأ(الوقت_الحالي)

        متغير كاشف = جديد كاشف_العتاد()
        كاشف.اكشف_المعالج()
        كاشف.اكشف_الذاكرة()
        كاشف.اكشف_PCI()

        الوقت_الحالي = الوقت_الحالي + 200
        المراحل[0].نجحت_م(الوقت_الحالي، "تم كشف العتاد")

        كاشف.اطبع_ملخص()
        ارجع صحيح
    نهاية

    ## تنفيذ مرحلة GDT/IDT
    دالة منطقي نفّذ_GDT_IDT()
        الوقت_الحالي = الوقت_الحالي + 10
        المراحل[1].ابدأ(الوقت_الحالي)

        متغير جداول = جديد مُهيّئ_الجداول()
        جداول.أعدّ_GDT()
        جداول.أعدّ_IDT()

        الوقت_الحالي = الوقت_الحالي + 30
        المراحل[1].نجحت_م(الوقت_الحالي، "GDT + IDT محمّلان")

        جداول.اطبع_GDT()
        ارجع صحيح
    نهاية

    ## تنفيذ مرحلة المقاطعات
    دالة منطقي نفّذ_مقاطعات()
        الوقت_الحالي = الوقت_الحالي + 5
        المراحل[2].ابدأ(الوقت_الحالي)

        متغير pic = جديد مُهيّئ_PIC()
        pic.برمج()
        pic.أعدّ_PIT(1000)      # 1000 Hz = 1ms لكل tick
        pic.فعّل_IRQ(0)         # Timer
        pic.فعّل_IRQ(1)         # Keyboard
        pic.عطّل_IRQ(3)         # COM2 (لا حاجة مبدئياً)

        الوقت_الحالي = الوقت_الحالي + 20
        المراحل[2].نجحت_م(الوقت_الحالي، "PIC + PIT جاهزان")
        ارجع صحيح
    نهاية

    ## تنفيذ مرحلة المنفذ التسلسلي
    دالة منطقي نفّذ_تسلسلي()
        الوقت_الحالي = الوقت_الحالي + 5
        المراحل[3].ابدأ(الوقت_الحالي)

        # محاكاة إعداد UART COM1
        # في الحقيقي: كتابة إلى سجلات UART
        اطبع_سطر("  📡 إعداد UART COM1...")
        اطبع("    → المنفذ: ") اطبع_سطر(عتاد_منفذ_COM1)
        اطبع("    → سعة المنطقة العازلة: ") اطبع_سطر(256)

        # اختبار الكتابة للمنطقة العازلة
        ع_عازلة_COM1.اكتب(66)    # 'B'
        ع_عازلة_COM1.اكتب(101)   # 'e'
        ع_عازلة_COM1.اكتب(101)   # 'e'

        الوقت_الحالي = الوقت_الحالي + 15
        المراحل[3].نجحت_م(الوقت_الحالي، "COM1 جاهز")
        ارجع صحيح
    نهاية

    ## تنفيذ مرحلة Bootmem
    دالة منطقي نفّذ_ذاكرة_مبكرة()
        الوقت_الحالي = الوقت_الحالي + 10
        المراحل[4].ابدأ(الوقت_الحالي)

        متغير bootmem = جديد مُخصّص_الذاكرة_المبكر()
        # تهيئة بعد النواة (1MB) بحجم 16MB
        bootmem.هيئ(1048576، 16777216)

        # تخصيصات مبكرة
