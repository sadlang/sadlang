# ─────────────────────────────────────────────────────────────────────────────
# صنف مرحلة_إقلاع_م - مرحلة واحدة من الإقلاع
# ─────────────────────────────────────────────────────────────────────────────
صنف مرحلة_إقلاع_م
    ## يمثّل مرحلة واحدة من مراحل الإقلاع مع التوقيت والحالة

    رقم الرقم_م             # رقم المرحلة (1-6)
    نص الاسم_م              # اسم المرحلة
    رقم الوضعية_م           # وضعية المرحلة (انتظار/جارية/نجحت/فشلت)
    رقم وقت_البدء           # وقت بدء المرحلة (مللي ثانية)
    رقم وقت_الانتهاء        # وقت انتهاء المرحلة
    نص رسالة_نتيجة          # رسالة النتيجة
    منطقي إلزامية           # هل المرحلة إلزامية؟

    باني(رقم رقم_ل، نص اسم_ل، منطقي إلزامية_ل)
        الرقم_م = رقم_ل
        الاسم_م = اسم_ل
        الوضعية_م = مرحلة_انتظار
        وقت_البدء = 0
        وقت_الانتهاء = 0
        رسالة_نتيجة = ""
        إلزامية = إلزامية_ل
    نهاية

    ## بدء المرحلة
    دالة ابدأ(رقم الوقت_الحالي)
        الوضعية_م = مرحلة_جارية
        وقت_البدء = الوقت_الحالي
    نهاية

    ## نجاح المرحلة
    دالة نجحت_م(رقم الوقت_الحالي، نص رسالة)
        الوضعية_م = مرحلة_نجحت
        وقت_الانتهاء = الوقت_الحالي
        رسالة_نتيجة = رسالة
    نهاية

    ## فشل المرحلة
    دالة فشلت_م(رقم الوقت_الحالي، نص رسالة)
        الوضعية_م = مرحلة_فشلت
        وقت_الانتهاء = الوقت_الحالي
        رسالة_نتيجة = رسالة
    نهاية

    ## المدة بالمللي ثانية
    دالة رقم المدة()
        اذا (وقت_الانتهاء > 0)
            ارجع وقت_الانتهاء - وقت_البدء
        نهاية
        ارجع 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدخلة_GDT - واصف في جدول الواصفات
# ─────────────────────────────────────────────────────────────────────────────
صنف مدخلة_GDT
    ## واصف واحد في جدول الواصفات العام (GDT)
    ## كل واصف 8 بايت يحدد: القاعدة، الحد، الأذونات، النمط

    رقم القاعدة              # العنوان الأساسي
    رقم الحد                 # الحد الأقصى
    رقم أذونات_الوصول        # بايت الوصول (type, S, DPL, P)
    رقم الأعلام              # الأعلام (G, D/B, L, AVL)
    نص الوصف                 # وصف بشري

    باني(رقم القاعدة_ل، رقم الحد_ل، رقم الأذونات_ل، رقم الأعلام_ل، نص الوصف_ل)
        القاعدة = القاعدة_ل
        الحد = الحد_ل
        أذونات_الوصول = الأذونات_ل
        الأعلام = الأعلام_ل
        الوصف = الوصف_ل
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدخلة_IDT - واصف مقاطعة
# ─────────────────────────────────────────────────────────────────────────────
صنف مدخلة_IDT
    ## واصف مقاطعة واحدة في IDT
    ## يحدد: عنوان المعالج، المُختار، النمط

    رقم عنوان_المعالج        # عنوان دالة معالجة المقاطعة
    رقم مُختار_القطعة        # مختار قطعة الكود في GDT
    رقم أعلام_م              # أعلام: بوابة مقاطعة / بوابة فخ
    منطقي مُفعَّل             # هل المقاطعة مُفعّلة؟

    باني(رقم العنوان_ل، رقم المُختار_ل، رقم الأعلام_ل)
        عنوان_المعالج = العنوان_ل
        مُختار_القطعة = المُختار_ل
        أعلام_م = الأعلام_ل
        مُفعَّل = صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف منطقة_ذاكرة - منطقة في الخريطة الفعلية
# ─────────────────────────────────────────────────────────────────────────────
صنف منطقة_ذاكرة
    ## منطقة ذاكرة فعلية مكتشفة من E820/Multiboot

    رقم العنوان_المبدأ       # العنوان الفعلي الأول
    رقم المقاس_بايت          # الحجم بالبايت
    رقم نمط_المنطقة          # 1=متاحة، 2=محجوزة، 3=ACPI، 4=NVS، 5=تالفة
    منطقي قابلة_استخدام

    باني(رقم العنوان_ل، رقم المقاس_ل، رقم النمط_ل)
        العنوان_المبدأ = العنوان_ل
        المقاس_بايت = المقاس_ل
        نمط_المنطقة = النمط_ل
        قابلة_استخدام = (النمط_ل == 1)
    نهاية

    ## عدد الصفحات في هذه المنطقة
    دالة رقم عدد_الصفحات()
        ارجع المقاس_بايت / BOOTMEM_مقاس_صفحة
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
