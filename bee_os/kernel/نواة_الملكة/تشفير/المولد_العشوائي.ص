دالة رقم اختبار_الحالة_الداخلية()
    اطبع_سطر("── اختبار الحالة الداخلية (ChaCha20) ──")
    متغير نجاح = 0
    متغير فشل = 0

    متغير داخلي = جديد حالة_مولد()
    داخلي.بذر(42)

    # التحقق من التهيئة
    اذا (داخلي.مُبذَر == 1)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ تم بذر المولد")
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ فشل بذر المولد")
    نهاية

    # توليد بايتات والتحقق من عدم التصفير
    متغير ب1 = داخلي.بايت_تالي()
    متغير ب2 = داخلي.بايت_تالي()
    اذا (ب1 >= 0)
        اذا (ب1 < 256)
            نجاح = نجاح + 1
            اطبع("  ✓ بايت في نطاق: ")
            اطبع_سطر(ب1)
        والا
            فشل = فشل + 1
            اطبع("  ✗ بايت خارج النطاق: ")
            اطبع_سطر(ب1)
        نهاية
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ بايت سالب")
    نهاية

    # التحقق من أن القيم متغيرة (ليست ثابتة)
    متغير مختلف = 0
    متغير سابقة = داخلي.بايت_تالي()
    متغير عد = 0
    بينما (عد < 20)
        متغير حالية = داخلي.بايت_تالي()
        اذا (حالية != سابقة)
            مختلف = مختلف + 1
        نهاية
        سابقة = حالية
        عد = عد + 1
    نهاية

    اذا (مختلف > 5)
        نجاح = نجاح + 1
        اطبع("  ✓ تنوع القيم: ")
        اطبع(مختلف)
        اطبع_سطر("/20")
    والا
        فشل = فشل + 1
        اطبع("  ✗ تنوع منخفض: ")
        اطبع_سطر(مختلف)
    نهاية

    اطبع("  النتيجة: نجاح=")
    اطبع(نجاح)
    اطبع(" فشل=")
    اطبع_سطر(فشل)
    ارجع فشل
نهاية

دالة رقم اختبار_المولد_الرئيسي()
    اطبع_سطر("── اختبار المولد الرئيسي ──")
    متغير نجاح = 0
    متغير فشل = 0

    متغير مولد = جديد المولد_العشوائي()
    مولد.بذر(777)

    # اختبار توليد بايتات
    متغير بايتات = مولد.بايتات_عشوائية(16)
    اذا (عدد بايتات == 16)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ توليد 16 بايت")
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ فشل توليد 16 بايت")
    نهاية

    # اختبار توليد رقم
    متغير رقم1 = مولد.التالي()
    اذا (رقم1 >= 0)
        نجاح = نجاح + 1
        اطبع("  ✓ رقم عشوائي: ")
        اطبع_سطر(رقم1)
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ رقم سالب")
    نهاية

    # اختبار النطاق
    متغير ف = 0
    متغير في_النطاق = صحيح
    بينما (ف < 20)
        متغير ق = مولد.التالي_في_نطاق(10، 100)
        اذا (ق < 10 || ق >= 100)
            في_النطاق = خطأ
        نهاية
        ف = ف + 1
    نهاية
    اذا (في_النطاق)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ جميع القيم في النطاق [10, 100)")
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ قيم خارج النطاق")
    نهاية

    # اختبار مفتاح تشفير
    متغير مفتاح = مولد.مفتاح_تشفير()
    اذا (عدد مفتاح == 32)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ مفتاح تشفير 32 بايت")
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ مفتاح بحجم خاطئ")
    نهاية

    # اختبار UUID
    متغير معرف = مولد.معرف_فريد()
    اذا (عدد معرف == 16)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ UUID عشوائي 16 بايت")
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ UUID بحجم خاطئ")
    نهاية

    # اختبار الصحة
    اذا (مولد.سليم())
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ المولد سليم")
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ المولد غير سليم")
    نهاية

    مولد.طباعة_إحصائيات()

    اطبع("  النتيجة: نجاح=")
    اطبع(نجاح)
    اطبع(" فشل=")
    اطبع_سطر(فشل)
    ارجع فشل
نهاية

دالة رقم اختبار_المجمّع()
