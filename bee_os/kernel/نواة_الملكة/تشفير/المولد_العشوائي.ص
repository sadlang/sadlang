صنف المولد_العشوائي
    ## مولد أرقام شبه عشوائية آمن تشفيرياً
    ## مبني على ChaCha20 مع إعادة تمفتح تلقائية وفحوصات صحة

    حالة_مولد النواة              # النواة ChaCha20
    فاحص_الصحة الفاحص            # فحوصات الصحة
    رقم إجمالي_البايتات          # عدد البايتات المولّدة
    رقم حد_البايتات               # حد إعادة التمفتح (بالبايتات)
    رقم مُهيّأ                    # هل المولد مهيأ؟

    باني()
        النواة = جديد حالة_مولد()
        الفاحص = جديد فاحص_الصحة()
        إجمالي_البايتات = 0
        حد_البايتات = 1048576    # 1 ميغابايت
        مُهيّأ = 0
    نهاية

    # تهيئة من رقم بذرة واحد
    دالة بذر(رقم بذرة)
        النواة.بذر(بذرة)
        الفاحص.إعادة_ضبط()
        إجمالي_البايتات = 0
        مُهيّأ = 1
    نهاية

    # تهيئة من مصفوفة بايتات (32 بايت مفتاح + 8 بايت nonce)
    دالة بذر_من_بايتات(مصفوفة المفتاح، مصفوفة النونس)
        النواة.بذر_من_مصفوفة(المفتاح، النونس)
        الفاحص.إعادة_ضبط()
        إجمالي_البايتات = 0
        مُهيّأ = 1
    نهاية

    # توليد بايت عشوائي واحد
    دالة رقم بايت_عشوائي()
        اذا (مُهيّأ != 1)
            اطبع_سطر("تحذير: المولد غير مُبذَر! يتم البذر بقيمة افتراضية.")
            بذر(12345)
        نهاية

        # فحص حد إعادة التمفتح
        اذا (إجمالي_البايتات >= حد_البايتات)
            النواة.إعادة_تمفتح()
            إجمالي_البايتات = 0
        نهاية

        متغير البايت = النواة.بايت_تالي()

        # فحص الصحة
        الفاحص.فحص(البايت)

        إجمالي_البايتات = إجمالي_البايتات + 1
        ارجع البايت
    نهاية

    # توليد رقم عشوائي (0 إلى 2^32-1)
    دالة رقم التالي()
        متغير ب0 = بايت_عشوائي()
        متغير ب1 = بايت_عشوائي()
        متغير ب2 = بايت_عشوائي()
        متغير ب3 = بايت_عشوائي()
        ارجع ب0 + ب1 * 256 + ب2 * 65536 + ب3 * 16777216
    نهاية

    # توليد رقم في نطاق [الأدنى، الأعلى)
    دالة رقم التالي_في_نطاق(رقم الأدنى، رقم الأعلى)
        متغير نطاق = الأعلى - الأدنى
        اذا (نطاق <= 0)
            ارجع الأدنى
        نهاية

        # لتجنب التحيّز: نرفض القيم خارج أكبر مضاعف للنطاق
        متغير خام = التالي()
        ارجع الأدنى + (خام % نطاق)
    نهاية

    # توليد مصفوفة بايتات عشوائية
    دالة مصفوفة بايتات_عشوائية(رقم عدد_البايتات)
        متغير النتيجة = []
        متغير ف = 0
        بينما (ف < عدد_البايتات)
            النتيجة += [بايت_عشوائي()]
            ف = ف + 1
        نهاية
        ارجع النتيجة
    نهاية

    # توليد مفتاح تشفير (32 بايت = 256 بت)
    دالة مصفوفة مفتاح_تشفير()
        ارجع بايتات_عشوائية(32)
    نهاية

    # توليد nonce (12 بايت = 96 بت)
    دالة مصفوفة نونس_عشوائي()
        ارجع بايتات_عشوائية(12)
    نهاية

    # توليد UUID v4 عشوائي (16 بايت)
    دالة مصفوفة معرف_فريد()
        متغير بايتات = بايتات_عشوائية(16)
        # تعيين الإصدار (4) في البايت 6
        بايتات[6] = مع_حصو(بايتات[6]، 15) + 64
        # تعيين المتغير (10xx) في البايت 8
        بايتات[8] = مع_حصو(بايتات[8]، 63) + 128
        ارجع بايتات
    نهاية

    # هل المولد سليم؟
    دالة منطقي سليم()
        ارجع الفاحص.سليم()
    نهاية

    # إحصائيات المولد
    دالة طباعة_إحصائيات()
        اطبع("  البايتات المولّدة: ")
        اطبع_سطر(إجمالي_البايتات)
        اطبع("  الكتل المولّدة: ")
        اطبع_سطر(النواة.عداد_التوليد)
        اطبع("  فحوصات الصحة: ")
        اطبع_سطر(الفاحص.إجمالي_الفحوصات)
        اطبع("  أخطاء الصحة: ")
        اطبع_سطر(الفاحص.إجمالي_الأخطاء)
        اذا (الفاحص.سليم())
            اطبع_سطر("  الحالة: سليم ✓")
        والا
            اطبع_سطر("  الحالة: خلل مكتشف ✗")
        نهاية
    نهاية

    # مسح آمن
    دالة مسح()
        النواة.مسح()
        الفاحص.إعادة_ضبط()
        إجمالي_البايتات = 0
        مُهيّأ = 0
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف مُجمِّع العشوائية (Entropy Pool)
# ══════════════════════════════════════════════════════════════════════════════

صنف مجمّع_العشوائية
    ## مجمّع عشوائية يجمع من مصادر متعددة ويمزجها
    ## يستخدم خلط تشاتشا لدمج مصادر منخفضة العشوائية

    مصفوفة المجمّع          # مجمّع 256 بايت
    رقم حجم_المجمّع          # الحجم الحالي
    رقم فهرس_الإدخال        # فهرس الإدخال التالي
    رقم عداد_المصادر        # عدد المصادر المُضافة
    رقم إجمالي_العشوائية    # تقدير العشوائية المتراكمة (بتات)

    باني()
        حجم_المجمّع = 256
        المجمّع = []
        متغير ف = 0
        بينما (ف < حجم_المجمّع)
            المجمّع += [0]
            ف = ف + 1
        نهاية
        فهرس_الإدخال = 0
        عداد_المصادر = 0
        إجمالي_العشوائية = 0
    نهاية

    # إضافة بايت من مصدر عشوائية
    دالة أضف_بايت(رقم البايت، رقم عشوائية_مقدّرة)
        # خلط البايت في المجمّع
        المجمّع[فهرس_الإدخال] = مع_حصأو(المجمّع[فهرس_الإدخال]، البايت)

        # خلط إضافي مع البايتات المجاورة
        متغير التالي = (فهرس_الإدخال + 1) % حجم_المجمّع
        المجمّع[التالي] = مع_حصأو(المجمّع[التالي]، البايت * 7 + المجمّع[فهرس_الإدخال])
        المجمّع[التالي] = المجمّع[التالي] % 256

        فهرس_الإدخال = (فهرس_الإدخال + 1) % حجم_المجمّع
        عداد_المصادر = عداد_المصادر + 1
        إجمالي_العشوائية = إجمالي_العشوائية + عشوائية_مقدّرة
    نهاية

    # إضافة مصفوفة بايتات
    دالة أضف_مصفوفة(مصفوفة البيانات، رقم عشوائية_لكل_بايت)
        متغير ف = 0
        بينما (ف < عدد البيانات)
            أضف_بايت(البيانات[ف]، عشوائية_لكل_بايت)
            ف = ف + 1
        نهاية
    نهاية

    # إضافة رقم (مثل عداد أو طابع زمني)
    دالة أضف_رقم(رقم القيمة، رقم عشوائية)
        أضف_بايت(القيمة % 256، عشوائية)
        أضف_بايت((القيمة / 256) % 256، عشوائية)
        أضف_بايت((القيمة / 65536) % 256، عشوائية)
        أضف_بايت((القيمة / 16777216) % 256، عشوائية)
    نهاية

    # خلط المجمّع (stirring)
    دالة اخلط()
        متغير ف = 0
        بينما (ف < حجم_المجمّع - 1)
            المجمّع[ف + 1] = مع_حصأو(المجمّع[ف + 1]، المجمّع[ف] * 3 + 1)
            المجمّع[ف + 1] = المجمّع[ف + 1] % 256
            ف = ف + 1
        نهاية
        المجمّع[0] = مع_حصأو(المجمّع[0]، المجمّع[حجم_المجمّع - 1] * 5 + 7)
        المجمّع[0] = المجمّع[0] % 256
    نهاية

    # استخراج بذرة (32 بايت) من المجمّع
    دالة مصفوفة استخرج_بذرة()
        # خلط قبل الاستخراج
        اخلط()
        اخلط()

        # استخراج 32 بايت
        متغير البذرة = []
        متغير ف = 0
        بينما (ف < 32)
            متغير قيمة = 0
            متغير ج = 0
            بينما (ج < 8)
                قيمة = مع_حصأو(قيمة، المجمّع[(ف * 8 + ج) % حجم_المجمّع])
                ج = ج + 1
            نهاية
            البذرة += [قيمة % 256]
            ف = ف + 1
        نهاية

        # خلط بعد الاستخراج (أمان أمامي)
        اخلط()
        اخلط()
        اخلط()

        ارجع البذرة
    نهاية

    # هل يوجد عشوائية كافية؟
    دالة منطقي كافي()
        ارجع إجمالي_العشوائية >= 256
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف المولد العشوائي للنواة
# ══════════════════════════════════════════════════════════════════════════════

صنف مولد_النواة
    ## مولد عشوائي خاص بنواة نظام التشغيل
    ## يجمع بين CSPRNG ومجمّع العشوائية

    المولد_العشوائي المولد
    مجمّع_العشوائية المجمّع
    رقم مُنشَّط
    رقم عداد_إعادة_البذر

    باني()
        المولد = جديد المولد_العشوائي()
        المجمّع = جديد مجمّع_العشوائية()
        مُنشَّط = 0
        عداد_إعادة_البذر = 0
    نهاية

    # تهيئة المولد بعشوائية مبدئية
    دالة تهيئة(مصفوفة عشوائية_أولية)
        المجمّع.أضف_مصفوفة(عشوائية_أولية، 4)

        # إضافة عشوائية من مصادر بسيطة
        المجمّع.أضف_رقم(123456789، 1)
        المجمّع.أضف_رقم(987654321، 1)

        # استخراج بذرة وبذر المولد
        متغير بذرة = المجمّع.استخرج_بذرة()
        متغير نونس = [0، 0، 0، 0، 0، 0، 0، 0]
        المولد.بذر_من_بايتات(بذرة، نونس)

        مُنشَّط = 1
        اطبع_سطر("  مولد النواة: تم التهيئة بنجاح")
    نهاية

    # إضافة عشوائية من مصدر خارجي
    دالة أضف_عشوائية(مصفوفة البيانات، رقم جودة)
        المجمّع.أضف_مصفوفة(البيانات، جودة)

        # إعادة بذر دورية
        اذا (المجمّع.إجمالي_العشوائية > 512)
            إعادة_بذر()
        نهاية
    نهاية

    # إعادة بذر المولد من المجمّع
    دالة إعادة_بذر()
        اذا (المجمّع.كافي())
            متغير بذرة = المجمّع.استخرج_بذرة()
            متغير نونس_جديد = []
            متغير ف = 0
            بينما (ف < 8)
                نونس_جديد += [بذرة[ف]]
                ف = ف + 1
            نهاية
            المولد.بذر_من_بايتات(بذرة، نونس_جديد)
            عداد_إعادة_البذر = عداد_إعادة_البذر + 1
        نهاية
    نهاية

    # توليد بايتات عشوائية
    دالة مصفوفة بايتات(رقم عدد_المطلوب)
        اذا (مُنشَّط != 1)
            اطبع_سطر("تحذير: مولد النواة غير مُنشَّط!")
            ارجع []
        نهاية
        ارجع المولد.بايتات_عشوائية(عدد_المطلوب)
    نهاية

    # توليد رقم عشوائي
    دالة رقم رقم_عشوائي()
        اذا (مُنشَّط != 1)
            ارجع 0
        نهاية
        ارجع المولد.التالي()
    نهاية

    # توليد رقم في نطاق
    دالة رقم رقم_في_نطاق(رقم أدنى، رقم أعلى)
        اذا (مُنشَّط != 1)
            ارجع أدنى
        نهاية
        ارجع المولد.التالي_في_نطاق(أدنى، أعلى)
    نهاية

    # الإحصائيات
    دالة اطبع_وضع()
        اطبع_سطر("── وضع مولد النواة ──")
        اطبع("  منشط: ")
        اطبع_سطر(مُنشَّط)
        اطبع("  مرات إعادة البذر: ")
        اطبع_سطر(عداد_إعادة_البذر)
        اطبع("  عشوائية المجمّع (بتات): ")
        اطبع_سطر(المجمّع.إجمالي_العشوائية)
        المولد.طباعة_إحصائيات()
    نهاية
نهاية


