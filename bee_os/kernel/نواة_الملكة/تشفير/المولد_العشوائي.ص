# ثوابت ChaCha20
ثابت تشاتشا_ثابت0 = 1634760805     # "expa"
ثابت تشاتشا_ثابت1 = 857760878      # "nd 3"
ثابت تشاتشا_ثابت2 = 2036477234     # "2-by"
ثابت تشاتشا_ثابت3 = 1797285236     # "te k"

# عدد الجولات
ثابت تشاتشا_جولات = 20

# حجم الكتلة (بايت)
ثابت حجم_كتلة_تشاتشا = 64

# أقصى عدد كتل قبل إعادة التمفتح
ثابت حد_إعادة_التمفتح = 16384

# حد فحص الصحة (عدد العينات)
ثابت حد_فحص_الصحة = 1024

# قيم أولية لاختبار التكرار
ثابت حد_تكرار_متتالي = 24

# مقياس mod لتجنب الفيضان
ثابت مقياس_فيضان = 4294967296


# ══════════════════════════════════════════════════════════════════════════════
#                     دوال بتّية أساسية
# ══════════════════════════════════════════════════════════════════════════════

# إزاحة يسارية 32 بت
دالة رقم مع_إزاحة_يسار(رقم قيمة، رقم عدد_البتات)
    متغير نتيجة = قيمة
    متغير ع = 0
    بينما (ع < عدد_البتات)
        نتيجة = نتيجة * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة - (نتيجة / مقياس_فيضان) * مقياس_فيضان
نهاية

# إزاحة يمينية 32 بت
دالة رقم مع_إزاحة_يمين(رقم قيمة، رقم عدد_البتات)
    متغير نتيجة = قيمة
    متغير ع = 0
    بينما (ع < عدد_البتات)
        نتيجة = (نتيجة - (نتيجة % 2)) / 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# XOR بتّي
دالة رقم مع_حصأو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 != ب2)
            نتيجة = نتيجة + قيمة_بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# AND بتّي
دالة رقم مع_حصو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 == 1)
            اذا (ب2 == 1)
                نتيجة = نتيجة + قيمة_بت
            نهاية
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# OR بتّي
دالة رقم مع_حصأو_منطقي(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 == 1 || ب2 == 1)
            نتيجة = نتيجة + قيمة_بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# NOT بتّي (قلب 32 بت)
دالة رقم مع_قلب(رقم أ)
    ارجع مع_حصأو(أ، 4294967295)
نهاية

# دوران يساري 32 بت
دالة رقم مع_دوران_يسار(رقم قيمة، رقم عدد_البتات)
    متغير يسار = مع_إزاحة_يسار(قيمة، عدد_البتات)
    متغير يمين = مع_إزاحة_يمين(قيمة، 32 - عدد_البتات)
    ارجع مع_حصأو_منطقي(يسار، يمين)
نهاية

# جمع mod 2^32
دالة رقم مع_جمع32(رقم أ، رقم ب)
    متغير مجموع = أ + ب
    ارجع مجموع - (مجموع / مقياس_فيضان) * مقياس_فيضان
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                  صنف الحالة الداخلية (ChaCha20 State)
# ══════════════════════════════════════════════════════════════════════════════

صنف حالة_مولد
    ## الحالة الداخلية لمولد ChaCha20 CSPRNG
    ## مصفوفة 16 كلمة 32 بت (512 بت)
    ## البنية:
    ##   [0-3]   ثوابت "expand 32-byte k"
    ##   [4-11]  المفتاح (256 بت)
    ##   [12]    العداد
    ##   [13]    العداد (عالي)
    ##   [14-15] nonce

    مصفوفة وضع              # 16 كلمة 32 بت (الحالة)
    رقم عداد_التوليد        # عدد الكتل المولّدة
    رقم فهرس_الخرج          # الفهرس الحالي في كتلة الخرج
    مصفوفة كتلة_الخرج       # 64 بايت مخرجات مخزنة مؤقتاً
    رقم مُبذَر              # هل تم بذر المولد؟

    باني()
        # تهيئة حالة فارغة
        وضع = []
        متغير ف = 0
        بينما (ف < 16)
            وضع += [0]
            ف = ف + 1
        نهاية

        كتلة_الخرج = []
        ف = 0
        بينما (ف < 64)
            كتلة_الخرج += [0]
            ف = ف + 1
        نهاية

        عداد_التوليد = 0
        فهرس_الخرج = 64
        مُبذَر = 0
    نهاية

    # بذر المولد من مصفوفة 32 بايت (مفتاح) + 8 بايت (nonce)
    دالة بذر_من_مصفوفة(مصفوفة المفتاح، مصفوفة النونس)
        # الثوابت
        وضع[0] = تشاتشا_ثابت0
        وضع[1] = تشاتشا_ثابت1
        وضع[2] = تشاتشا_ثابت2
        وضع[3] = تشاتشا_ثابت3

        # المفتاح (8 كلمات × 4 بايت = 32 بايت)
        متغير ف = 0
        بينما (ف < 8)
            متغير فهرس = ف * 4
            اذا (فهرس + 3 < عدد المفتاح)
                وضع[4 + ف] = المفتاح[فهرس] + المفتاح[فهرس + 1] * 256 + المفتاح[فهرس + 2] * 65536 + المفتاح[فهرس + 3] * 16777216
            والا_اذا (فهرس < عدد المفتاح)
                وضع[4 + ف] = المفتاح[فهرس]
            والا
                وضع[4 + ف] = 0
            نهاية
            ف = ف + 1
        نهاية

        # العداد = 0
        وضع[12] = 0
        وضع[13] = 0

        # النونس (2 كلمة × 4 بايت = 8 بايت)
        اذا (عدد النونس >= 4)
            وضع[14] = النونس[0] + النونس[1] * 256 + النونس[2] * 65536 + النونس[3] * 16777216
        والا
            وضع[14] = 0
        نهاية
        اذا (عدد النونس >= 8)
            وضع[15] = النونس[4] + النونس[5] * 256 + النونس[6] * 65536 + النونس[7] * 16777216
        والا
            وضع[15] = 0
        نهاية

        عداد_التوليد = 0
        فهرس_الخرج = 64
        مُبذَر = 1
    نهاية

    # بذر من رقم واحد (للاستخدام السريع)
    دالة بذر(رقم بذرة)
        متغير مفتاح = []
        متغير ف = 0
        بينما (ف < 32)
            متغير بايت = (بذرة * (ف + 1) * 2654435761) % 256
            اذا (بايت < 0)
                بايت = بايت * (-1)
            نهاية
            مفتاح += [بايت]
            ف = ف + 1
        نهاية
        متغير نونس = []
        ف = 0
        بينما (ف < 8)
            متغير ن_بايت = (بذرة * (ف + 33) * 2246822519) % 256
            اذا (ن_بايت < 0)
                ن_بايت = ن_بايت * (-1)
            نهاية
            نونس += [ن_بايت]
            ف = ف + 1
        نهاية
        بذر_من_مصفوفة(مفتاح، نونس)
    نهاية

    # جولة ربع (Quarter Round) - العملية الأساسية في ChaCha20
    دالة ربع_جولة(رقم أ_ف، رقم ب_ف، رقم ت_ف، رقم د_ف)
        # a += b; d ^= a; d <<<= 16
        وضع[أ_ف] = مع_جمع32(وضع[أ_ف]، وضع[ب_ف])
        وضع[د_ف] = مع_حصأو(وضع[د_ف]، وضع[أ_ف])
        وضع[د_ف] = مع_دوران_يسار(وضع[د_ف]، 16)

        # c += d; b ^= c; b <<<= 12
        وضع[ت_ف] = مع_جمع32(وضع[ت_ف]، وضع[د_ف])
        وضع[ب_ف] = مع_حصأو(وضع[ب_ف]، وضع[ت_ف])
        وضع[ب_ف] = مع_دوران_يسار(وضع[ب_ف]، 12)

        # a += b; d ^= a; d <<<= 8
        وضع[أ_ف] = مع_جمع32(وضع[أ_ف]، وضع[ب_ف])
        وضع[د_ف] = مع_حصأو(وضع[د_ف]، وضع[أ_ف])
        وضع[د_ف] = مع_دوران_يسار(وضع[د_ف]، 8)

        # c += d; b ^= c; b <<<= 7
        وضع[ت_ف] = مع_جمع32(وضع[ت_ف]، وضع[د_ف])
        وضع[ب_ف] = مع_حصأو(وضع[ب_ف]، وضع[ت_ف])
        وضع[ب_ف] = مع_دوران_يسار(وضع[ب_ف]، 7)
    نهاية

    # توليد كتلة واحدة (64 بايت) من ChaCha20
    دالة توليد_كتلة()
        # حفظ الحالة الأصلية
        متغير أصلي = []
        متغير ف = 0
        بينما (ف < 16)
            أصلي += [وضع[ف]]
            ف = ف + 1
        نهاية

        # 20 جولة (10 جولات مزدوجة)
        متغير جولة = 0
        بينما (جولة < 10)
            # جولات أعمدة
            ربع_جولة(0، 4، 8، 12)
            ربع_جولة(1، 5، 9، 13)
            ربع_جولة(2، 6، 10، 14)
            ربع_جولة(3، 7، 11، 15)

            # جولات قطرية
            ربع_جولة(0، 5، 10، 15)
            ربع_جولة(1، 6، 11، 12)
            ربع_جولة(2، 7، 8، 13)
            ربع_جولة(3، 4، 9، 14)

            جولة = جولة + 1
        نهاية

        # إضافة الحالة الأصلية (mod 2^32)
        ف = 0
        بينما (ف < 16)
            وضع[ف] = مع_جمع32(وضع[ف]، أصلي[ف])
            ف = ف + 1
        نهاية

        # تحويل إلى بايتات (Little-Endian)
        ف = 0
        بينما (ف < 16)
            متغير ق = وضع[ف]
            كتلة_الخرج[ف * 4] = ق % 256
            كتلة_الخرج[ف * 4 + 1] = (ق / 256) % 256
            كتلة_الخرج[ف * 4 + 2] = (ق / 65536) % 256
            كتلة_الخرج[ف * 4 + 3] = (ق / 16777216) % 256
            ف = ف + 1
        نهاية

        # استعادة الحالة الأصلية وزيادة العداد
        ف = 0
        بينما (ف < 16)
            وضع[ف] = أصلي[ف]
            ف = ف + 1
        نهاية
        وضع[12] = وضع[12] + 1
        اذا (وضع[12] >= مقياس_فيضان)
            وضع[12] = 0
            وضع[13] = وضع[13] + 1
        نهاية

        فهرس_الخرج = 0
        عداد_التوليد = عداد_التوليد + 1
    نهاية

    # الحصول على بايت عشوائي واحد
    دالة رقم بايت_تالي()
        اذا (فهرس_الخرج >= 64)
            توليد_كتلة()
        نهاية
        متغير البايت = كتلة_الخرج[فهرس_الخرج]
        فهرس_الخرج = فهرس_الخرج + 1
        ارجع البايت
    نهاية

    # إعادة تمفتح: توليد مفتاح جديد من الخرج الحالي
    دالة إعادة_تمفتح()
        # توليد 32 بايت مفتاح جديد + 8 بايت nonce جديد
        متغير مفتاح_جديد = []
        متغير ف = 0
        بينما (ف < 32)
            مفتاح_جديد += [بايت_تالي()]
            ف = ف + 1
        نهاية
        متغير نونس_جديد = []
        ف = 0
        بينما (ف < 8)
            نونس_جديد += [بايت_تالي()]
            ف = ف + 1
        نهاية

        # مسح الحالة القديمة
        ف = 0
        بينما (ف < 64)
            كتلة_الخرج[ف] = 0
            ف = ف + 1
        نهاية

        # بذر بالمفتاح الجديد
        بذر_من_مصفوفة(مفتاح_جديد، نونس_جديد)
    نهاية

    # مسح آمن للحالة
    دالة مسح()
        متغير ف = 0
        بينما (ف < 16)
            وضع[ف] = 0
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < 64)
            كتلة_الخرج[ف] = 0
            ف = ف + 1
        نهاية
        عداد_التوليد = 0
        فهرس_الخرج = 64
        مُبذَر = 0
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     صنف فحص الصحة
# ══════════════════════════════════════════════════════════════════════════════

صنف فاحص_الصحة
    ## فحوصات صحة مستمرة للمولد العشوائي
    ## NIST SP 800-90B: اختبار التكرار واختبار التكيّف

    رقم آخر_قيمة              # آخر بايت مُولَّد
    رقم عداد_التكرار          # عدد مرات تكرار نفس القيمة
    مصفوفة سجل_القيم          # سجل آخر N قيمة
    رقم فهرس_السجل            # الفهرس الحالي في السجل
    رقم حجم_السجل             # الحجم الأقصى للسجل
    رقم إجمالي_الفحوصات        # عدد الفحوصات المنفذة
    رقم إجمالي_الأخطاء        # عدد الأخطاء المكتشفة

    باني()
        آخر_قيمة = -1
        عداد_التكرار = 0
        حجم_السجل = 256
        سجل_القيم = []
        متغير ف = 0
        بينما (ف < حجم_السجل)
            سجل_القيم += [0]
            ف = ف + 1
        نهاية
        فهرس_السجل = 0
        إجمالي_الفحوصات = 0
        إجمالي_الأخطاء = 0
    نهاية

    # اختبار التكرار المتتالي (Repetition Count Test)
    # إذا تكررت نفس القيمة أكثر من الحد، فاشل
    دالة منطقي فحص_تكرار(رقم قيمة)
        إجمالي_الفحوصات = إجمالي_الفحوصات + 1

        اذا (قيمة == آخر_قيمة)
            عداد_التكرار = عداد_التكرار + 1
            اذا (عداد_التكرار >= حد_تكرار_متتالي)
                إجمالي_الأخطاء = إجمالي_الأخطاء + 1
                ارجع خطأ
            نهاية
        والا
            عداد_التكرار = 1
            آخر_قيمة = قيمة
        نهاية

        ارجع صحيح
    نهاية

    # اختبار التكيّف النسبي (Adaptive Proportion Test)
    # إذا ظهرت قيمة واحدة بنسبة عالية جداً في النافذة، فاشل
    دالة منطقي فحص_تكيف(رقم قيمة)
        # تسجيل القيمة
        سجل_القيم[فهرس_السجل] = قيمة
        فهرس_السجل = (فهرس_السجل + 1) % حجم_السجل

        # عدّ تكرار القيمة في السجل
        متغير تكرارات = 0
        متغير ف = 0
        بينما (ف < حجم_السجل)
            اذا (سجل_القيم[ف] == قيمة)
                تكرارات = تكرارات + 1
            نهاية
            ف = ف + 1
        نهاية

        # الحد: لا يجب أن تظهر أي قيمة أكثر من 50% من الوقت
        متغير الحد = حجم_السجل / 2
        اذا (تكرارات > الحد)
            إجمالي_الأخطاء = إجمالي_الأخطاء + 1
            ارجع خطأ
        نهاية

        ارجع صحيح
    نهاية

    # فحص شامل: يشمل التكرار والتكيّف
    دالة منطقي فحص(رقم قيمة)
        متغير نتيجة1 = فحص_تكرار(قيمة)
        متغير نتيجة2 = فحص_تكيف(قيمة)
        ارجع نتيجة1 && نتيجة2
    نهاية

    # هل المولد سليم؟
    دالة منطقي سليم()
        ارجع إجمالي_الأخطاء == 0
    نهاية

    # إعادة ضبط الفاحص
    دالة إعادة_ضبط()
        آخر_قيمة = -1
        عداد_التكرار = 0
        فهرس_السجل = 0
        إجمالي_الفحوصات = 0
        إجمالي_الأخطاء = 0
        متغير ف = 0
        بينما (ف < حجم_السجل)
            سجل_القيم[ف] = 0
            ف = ف + 1
        نهاية
    نهاية
نهاية


