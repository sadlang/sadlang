# ──────────────────────────────────────────────────────────────────────
# حاجز المتنبئ: يمنع Spectre بإبطاء التنبؤ بالتفرع
# في النواة الحقيقية يُستخدم LFENCE أو CPUID
# ──────────────────────────────────────────────────────────────────────
دالة حاجز_تنبؤ()
    # محاكاة: نفّذ عمليات حسابية لا معنى لها
    # لإجبار المعالج على إكمال جميع العمليات المعلقة
    متغير مؤقت = 0
    متغير ف = 0
    بينما (ف < 32)
        مؤقت = مؤقت + ف * 3
        مؤقت = مؤقت - (مؤقت / 1000000) * 1000000
        ف = ف + 1
    نهاية
