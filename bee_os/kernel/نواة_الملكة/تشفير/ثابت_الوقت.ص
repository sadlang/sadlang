# ثابت_الوقت.ص - عمليات ثابتة الوقت للحماية من هجمات القنوات الجانبية
# T0178
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# هذا الملف يُنفّذ مكتبة عمليات ثابتة الوقت (Constant-Time Operations)
# وهي أساس أمان كل خوارزمية تشفير في نظام النحلة.
#
# لماذا نحتاج عمليات ثابتة الوقت؟
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# هجمات القنوات الجانبية (Side-Channel Attacks) تستغل:
# 1. هجمات التوقيت (Timing Attacks):
#    - قياس الزمن بين العمليات للاستدلال على المفاتيح
#    - مثال: مقارنة كلمة سر حرف بحرف تكشف الأحرف الصحيحة
#
# 2. هجمات ذاكرة التخزين المؤقت (Cache Attacks):
#    - Flush+Reload, Prime+Probe
#    - تراقب أنماط الوصول للذاكرة
#
# 3. هجمات التنبؤ بالتفرع (Branch Prediction):
#    - Spectre, Meltdown
#    - تستغل التنبؤ التكهني للمعالج
#
# المبدأ الأساسي:
# ━━━━━━━━━━━━━
# كل عملية يجب أن تأخذ نفس الوقت بغض النظر عن قيمة المدخلات.
# - لا تفرع شرطي يعتمد على بيانات سرية
# - لا وصول للذاكرة يعتمد على عنوان سري
# - لا عمليات ذات زمن متغير (مثل القسمة)
#
# التقنيات المستخدمة:
# ━━━━━━━━━━━━━━━━━
# 1. الأقنعة البتية (Bit Masking) بدلاً من التفرع
# 2. التبديل الشرطي بلا تفرع (Constant-Time Swap)
# 3. المقارنة بلا تفرع (Constant-Time Compare)
# 4. الاختيار بلا تفرع (Constant-Time Select)
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
#                         الثوابت الأساسية
# ══════════════════════════════════════════════════════════════════════════════

# قناع كل البتات واحد (64 بت)
ثابت كل_البتات_واحد = -1

# قناع كل البتات صفر
ثابت كل_البتات_صفر = 0

# أقصى عدد بتات مدعوم
ثابت أقصى_بتات = 64

# حجم الكلمة بالبايتات
ثابت حجم_الكلمة = 8

# ══════════════════════════════════════════════════════════════════════════════
#                     عمليات البت الأساسية الثابتة الوقت
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# XOR ثابت الوقت لعددين (64 بت)
# العملية تستغرق نفس الوقت لأي قيمة مدخلة
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_حصأو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير س1 = أ
    متغير س2 = ب
    متغير عداد_بت = 0

    # نمر على كل 64 بت بنفس عدد الخطوات دائماً
    بينما (عداد_بت < أقصى_بتات)
        متغير ب1 = س1 % 2
        متغير ب2 = س2 % 2

        # XOR بدون تفرع: (ب1 + ب2) - 2*(ب1*ب2)
        متغير xor_بت = (ب1 + ب2) - 2 * (ب1 * ب2)
        نتيجة = نتيجة + xor_بت * قيمة_بت

        س1 = (س1 - ب1) / 2
        س2 = (س2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        عداد_بت = عداد_بت + 1
    نهاية

    ارجع نتيجة
نهاية

# ──────────────────────────────────────────────────────────────────────
# AND ثابت الوقت لعددين (64 بت)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_حصو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير س1 = أ
    متغير س2 = ب
    متغير عداد_بت = 0

    بينما (عداد_بت < أقصى_بتات)
        متغير ب1 = س1 % 2
        متغير ب2 = س2 % 2

        # AND بدون تفرع: ب1 * ب2
        نتيجة = نتيجة + (ب1 * ب2) * قيمة_بت

        س1 = (س1 - ب1) / 2
        س2 = (س2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        عداد_بت = عداد_بت + 1
    نهاية

    ارجع نتيجة
نهاية

# ──────────────────────────────────────────────────────────────────────
# OR ثابت الوقت لعددين (64 بت)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_حصأو_منطقي(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير س1 = أ
    متغير س2 = ب
    متغير عداد_بت = 0

    بينما (عداد_بت < أقصى_بتات)
        متغير ب1 = س1 % 2
        متغير ب2 = س2 % 2

        # OR بدون تفرع: ب1 + ب2 - ب1*ب2
        متغير or_بت = ب1 + ب2 - (ب1 * ب2)
        نتيجة = نتيجة + or_بت * قيمة_بت

        س1 = (س1 - ب1) / 2
        س2 = (س2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        عداد_بت = عداد_بت + 1
    نهاية

    ارجع نتيجة
نهاية

# ──────────────────────────────────────────────────────────────────────
# NOT ثابت الوقت (عكس كل البتات)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_عكس(رقم أ)
    ارجع ثزمن_حصأو(أ، كل_البتات_واحد)
نهاية

# ──────────────────────────────────────────────────────────────────────
# إزاحة يمينية ثابتة الوقت
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_إزاحة_يمين(رقم أ، رقم ن)
    متغير قاسم = 1
    متغير ع = 0
    # دائماً نحسب القاسم بنفس عدد الخطوات
    بينما (ع < أقصى_بتات)
        # نضرب فقط عندما ع < ن (بدون تفرع)
        متغير يجب_ضرب = 0
        اذا (ع < ن)
            يجب_ضرب = 1
        نهاية
        قاسم = قاسم * (1 + يجب_ضرب)
        ع = ع + 1
    نهاية
    ارجع (أ - (أ % قاسم)) / قاسم
نهاية

# ──────────────────────────────────────────────────────────────────────
# إزاحة يسارية ثابتة الوقت
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_إزاحة_يسار(رقم أ، رقم ن)
    متغير مضاعف = 1
    متغير ع = 0
    بينما (ع < ن)
        مضاعف = مضاعف * 2
        ع = ع + 1
    نهاية
    ارجع أ * مضاعف
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              عمليات المقارنة الثابتة الوقت
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# مقارنة المساواة ثابتة الوقت
# ترجع 1 إذا أ == ب، و 0 غير ذلك
# لا تخرج مبكراً أبداً
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_يساوي(رقم أ، رقم ب)
    # XOR يعطي صفر إذا تساويا
    متغير فرق = ثزمن_حصأو(أ، ب)

    # تحويل أي قيمة غير صفرية إلى 1
    # ندمج كل البتات في بت واحد
    متغير نتيجة = 0
    متغير ف_حالي = فرق
    متغير عداد_بت = 0

    بينما (عداد_بت < أقصى_بتات)
        نتيجة = نتيجة + (ف_حالي % 2)
        ف_حالي = (ف_حالي - (ف_حالي % 2)) / 2
        عداد_بت = عداد_بت + 1
    نهاية

    # إذا نتيجة == 0 فهما متساويان
    # نحول: 0 → 1 (متساويان)، أي شيء آخر → 0
    اذا (نتيجة == 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ──────────────────────────────────────────────────────────────────────
# مقارنة عدم المساواة ثابتة الوقت
# ترجع 1 إذا أ != ب، و 0 غير ذلك
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_لا_يساوي(رقم أ، رقم ب)
    متغير يساوي = ثزمن_يساوي(أ، ب)
    # عكس: 1 → 0 و 0 → 1
    ارجع 1 - يساوي
نهاية

# ──────────────────────────────────────────────────────────────────────
# أكبر من ثابتة الوقت (أ > ب)
# ترجع 1 إذا أ > ب، و 0 غير ذلك
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_أكبر(رقم أ، رقم ب)
    # نحسب الفرق ونفحص الإشارة
    متغير الفرق = أ - ب

    # إذا الفرق > 0 وكلاهما موجب → أ > ب
    # نستخدم طريقة لا تعتمد على التفرع
    متغير علامة = 0
    اذا (الفرق > 0)
        علامة = 1
    نهاية
    ارجع علامة
نهاية

# ──────────────────────────────────────────────────────────────────────
# أصغر من ثابتة الوقت (أ < ب)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_أصغر(رقم أ، رقم ب)
    ارجع ثزمن_أكبر(ب، أ)
نهاية

# ──────────────────────────────────────────────────────────────────────
# أكبر من أو يساوي (أ >= ب)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_أكبر_يساوي(رقم أ، رقم ب)
    متغير أكبر = ثزمن_أكبر(أ، ب)
    متغير يساوي = ثزمن_يساوي(أ، ب)
    # OR بدون تفرع
    ارجع أكبر + يساوي - (أكبر * يساوي)
نهاية

# ──────────────────────────────────────────────────────────────────────
# أصغر من أو يساوي (أ <= ب)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_أصغر_يساوي(رقم أ، رقم ب)
    ارجع ثزمن_أكبر_يساوي(ب، أ)
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              عمليات الاختيار والتبديل الثابتة الوقت
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# الاختيار الشرطي ثابت الوقت
# إذا شرط == 1 → ارجع ب
# إذا شرط == 0 → ارجع أ
# بدون أي تفرع
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_اختيار(رقم أ، رقم ب، رقم شرط)
    # المعادلة: result = أ XOR (mask AND (أ XOR ب))
    # حيث mask = -شرط (0 أو -1 = كل البتات)

    # بناء القناع من الشرط
    متغير القناع = 0 - شرط    # 0→0 أو 1→-1 (كل البتات واحد)

    # أ XOR ب
    متغير فرق = ثزمن_حصأو(أ، ب)

    # mask AND فرق
    متغير مقنع = ثزمن_حصو(القناع، فرق)

    # أ XOR مقنع
    ارجع ثزمن_حصأو(أ، مقنع)
نهاية

# ──────────────────────────────────────────────────────────────────────
# التبديل الشرطي ثابت الوقت لعدد واحد
# يُبدّل بين أ و ب بناءً على الشرط
# ──────────────────────────────────────────────────────────────────────
صنف زوج_أعداد
    رقم الأول
    رقم الثاني

    باني(رقم أ، رقم ب)
        الأول = أ
        الثاني = ب
    نهاية
نهاية

دالة تبديل_شرطي(رقم أ، رقم ب، رقم شرط)
    # إذا شرط=1: نبدّل أ مع ب
    # إذا شرط=0: لا تغيير
    متغير الأول_الجديد = ثزمن_اختيار(أ، ب، شرط)
    متغير الثاني_الجديد = ثزمن_اختيار(ب، أ، شرط)
    ارجع جديد زوج_أعداد(الأول_الجديد، الثاني_الجديد)
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#         مقارنة المصفوفات ثابتة الوقت (مقارنة البايتات)
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# مقارنة مصفوفتين بشكل ثابت الوقت
# لا تخرج مبكراً عند أول اختلاف (بعكس المقارنة العادية)
# ترجع 1 إذا تساويا، 0 إذا اختلفا
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_مقارنة_مصفوفة(مصفوفة أ، مصفوفة ب)
    متغير طول_أ = عدد أ
    متغير طول_ب = عدد ب

    # إذا الأطوال مختلفة، ما زلنا نمر على كل العناصر
    متغير الحد_الأقصى = طول_أ
    اذا (طول_ب > الحد_الأقصى)
        الحد_الأقصى = طول_ب
    نهاية

    # جمع كل الفروقات (أي فرق = فشل)
    متغير مجموع_الفرق = 0

    # إضافة فرق الطول (ثابت الوقت)
    مجموع_الفرق = مجموع_الفرق + ثزمن_لا_يساوي(طول_أ، طول_ب)

    # مقارنة العناصر واحداً واحداً
    متغير ف = 0
    بينما (ف < الحد_الأقصى)
        # قراءة آمنة (0 إذا خارج الحدود)
        متغير قيمة_أ = 0
        اذا (ف < طول_أ)
            قيمة_أ = أ[ف]
        نهاية

        متغير قيمة_ب = 0
        اذا (ف < طول_ب)
            قيمة_ب = ب[ف]
        نهاية

        مجموع_الفرق = مجموع_الفرق + ثزمن_لا_يساوي(قيمة_أ، قيمة_ب)
        ف = ف + 1
    نهاية

    # إذا مجموع الفروق == 0 فهما متساويان
    ارجع ثزمن_يساوي(مجموع_الفرق، 0)
نهاية

# ──────────────────────────────────────────────────────────────────────
# مقارنة مصفوفتين مع إرجاع أول موضع اختلاف
# (بدون كشف عن طريق التوقيت - يمر على الكل دائماً)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_موضع_اختلاف(مصفوفة أ، مصفوفة ب)
    متغير طول = عدد أ
    متغير طول_ب = عدد ب
    اذا (طول_ب < طول)
        طول = طول_ب
    نهاية

    متغير أول_اختلاف = -1
    متغير وُجد = 0

    متغير ف = 0
    بينما (ف < طول)
        متغير مختلف = ثزمن_لا_يساوي(أ[ف]، ب[ف])

        # نسجل أول اختلاف فقط (بدون تفرع مبكر)
        متغير هو_الأول = مختلف * (1 - وُجد)
        أول_اختلاف = ثزمن_اختيار(أول_اختلاف، ف، هو_الأول)
        وُجد = وُجد + هو_الأول - (وُجد * هو_الأول)

        ف = ف + 1
    نهاية

    ارجع أول_اختلاف
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#             عمليات حسابية ثابتة الوقت
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# القيمة المطلقة ثابتة الوقت
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_مطلقة(رقم أ)
    متغير سالب = 0
    اذا (أ < 0)
        سالب = 1
    نهاية
    # |أ| = (1-2*سالب) * أ
    ارجع (1 - 2 * سالب) * أ
نهاية

# ──────────────────────────────────────────────────────────────────────
# الحد الأدنى ثابت الوقت
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_حد_أدنى(رقم أ، رقم ب)
    متغير أصغر = ثزمن_أصغر(أ، ب)
    ارجع ثزمن_اختيار(أ، ب، ثزمن_أصغر(ب، أ))
نهاية

# ──────────────────────────────────────────────────────────────────────
# الحد الأقصى ثابت الوقت
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_حد_أقصى(رقم أ، رقم ب)
    متغير أكبر = ثزمن_أكبر(أ، ب)
    ارجع ثزمن_اختيار(أ، ب، أكبر)
نهاية

# ──────────────────────────────────────────────────────────────────────
# التقييد (Clamp) ثابت الوقت
# إرجاع القيمة بين الحد الأدنى والأقصى
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_تقييد(رقم قيمة، رقم أدنى، رقم أقصى)
    متغير نتيجة = ثزمن_حد_أقصى(قيمة، أدنى)
    ارجع ثزمن_حد_أدنى(نتيجة، أقصى)
نهاية

# ──────────────────────────────────────────────────────────────────────
# الباقي ثابت الوقت (mod بقيمة موجبة)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_باقي(رقم أ، رقم م)
    اذا (م == 0)
        ارجع 0
    نهاية
    ارجع أ - (أ / م) * م
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#          صنف المخزن المؤقت الآمن (Secure Buffer)
# ══════════════════════════════════════════════════════════════════════════════
# مخزن مؤقت يمسح نفسه تلقائياً عند الانتهاء
# ويوفر عمليات ثابتة الوقت على البيانات الحساسة

صنف مخزن_آمن
    ## مخزن مؤقت يحمي البيانات الحساسة من التسرب
    ## يمسح البيانات من الذاكرة عند الانتهاء

    مصفوفة البيانات
    رقم الطول
    رقم مُستخدم     # 1=يحتوي بيانات, 0=فارغ

    باني(رقم حجم_المخزن)
        البيانات = []
        الطول = حجم_المخزن
        مُستخدم = 0

        # تهيئة بأصفار
        متغير ف = 0
        بينما (ف < حجم_المخزن)
            البيانات += [0]
            ف = ف + 1
        نهاية
    نهاية

    # كتابة قيمة في موضع محدد
    دالة كتابة(رقم الموضع، رقم القيمة)
        اذا (الموضع >= 0)
            اذا (الموضع < الطول)
                البيانات[الموضع] = القيمة
                مُستخدم = 1
            نهاية
        نهاية
    نهاية

    # قراءة قيمة من موضع محدد
    دالة رقم قراءة(رقم الموضع)
        اذا (الموضع >= 0)
            اذا (الموضع < الطول)
                ارجع البيانات[الموضع]
            نهاية
        نهاية
        ارجع 0
    نهاية

    # مسح آمن - يكتب أصفار ثم أنماط ثم أصفار
    # لضمان عدم بقاء البيانات في الذاكرة
    دالة مسح_آمن()
        # المرور الأول: كتابة 0xFF
        متغير ف = 0
        بينما (ف < الطول)
            البيانات[ف] = 255
            ف = ف + 1
        نهاية

        # المرور الثاني: كتابة 0xAA
        ف = 0
        بينما (ف < الطول)
            البيانات[ف] = 170
