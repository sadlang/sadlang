            ف = ف + 1
        نهاية

        # المرور الرابع: كتابة أصفار نهائية
        ف = 0
        بينما (ف < الطول)
            البيانات[ف] = 0
            ف = ف + 1
        نهاية

        مُستخدم = 0
    نهاية

