# ──────────────────────────────────────────────────────────────────────
# تحويل 8 بايتات إلى عدد 64 بت (Little-Endian)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_من_بايتات_64(مصفوفة بايتات، رقم بداية)
    متغير نتيجة = بايتات[بداية]
    متغير مضاعف = 256
    متغير ف = 1

    بينما (ف < 8)
        نتيجة = نتيجة + بايتات[بداية + ف] * مضاعف
        مضاعف = مضاعف * 256
        ف = ف + 1
    نهاية

    ارجع نتيجة
