# ──────────────────────────────────────────────────────────────────────
# تحويل عدد 64 بت إلى 8 بايتات (Little-Endian)
# ──────────────────────────────────────────────────────────────────────
دالة مصفوفة ثزمن_إلى_بايتات_64(رقم قيمة)
    متغير النتيجة = []
    متغير ق = قيمة
    متغير ف = 0

    بينما (ف < 8)
        النتيجة += [ثزمن_باقي(ق، 256)]
        ق = (ق - ثزمن_باقي(ق، 256)) / 256
        ف = ف + 1
    نهاية

    ارجع النتيجة
