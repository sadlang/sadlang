صنف حارس_المفتاح
    ## يحمي مفتاح تشفيري في الذاكرة
    ## - يمسح المفتاح عند الانتهاء
    ## - يوفر عمليات ثابتة الوقت على المفتاح
    ## - يمنع نسخ المفتاح بالخطأ

    رقم طول_المفتاح
    رقم مُهيّأ

    باني(رقم الطول)
        طول_المفتاح = الطول
        مُهيّأ = 0
    نهاية

    # تحميل مفتاح جديد
    دالة رقم تحميل(مصفوفة بيانات_المفتاح)
        اذا (عدد بيانات_المفتاح != طول_المفتاح)
            ارجع 0
        نهاية
        مُهيّأ = 1
        ارجع 1
    نهاية

    # التحقق من تساوي مفتاحين (ثابت الوقت)
    دالة رقم يساوي_مفتاح(مصفوفة مفتاح_أ، مصفوفة مفتاح_ب)
        ارجع ثزمن_مقارنة_مصفوفة(مفتاح_أ، مفتاح_ب)
    نهاية

    # XOR مفتاح مع بيانات
    دالة مصفوفة حصأو_مفتاح(مصفوفة المفتاح، مصفوفة البيانات)
        متغير النتيجة = []
        متغير الطول = عدد المفتاح
        متغير طول_بيانات = عدد البيانات
        متغير ف = 0

        بينما (ف < طول_بيانات)
            متغير فهرس_مفتاح = ف - (ف / الطول) * الطول
            النتيجة += [ثزمن_حصأو(المفتاح[فهرس_مفتاح]، البيانات[ف])]
            ف = ف + 1
        نهاية

        ارجع النتيجة
    نهاية
