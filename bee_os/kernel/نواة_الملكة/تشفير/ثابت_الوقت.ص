صنف عمليات_مصفوفة_ثابتة
    ## عمليات على المصفوفات تضمن عدم تسرب المعلومات عبر التوقيت

    # نسخ ثابت الوقت: يمر على كل العناصر دائماً
    # المصدر/الهدف لهما نفس الطول
    دالة نسخ(مصفوفة الهدف، مصفوفة المصدر، رقم الطول)
        متغير ف = 0
        بينما (ف < الطول)
            الهدف[ف] = المصدر[ف]
            ف = ف + 1
        نهاية
    نهاية

    # XOR مصفوفتين ثابت الوقت
    دالة مصفوفة حصأو_مصفوفات(مصفوفة أ، مصفوفة ب)
        متغير الطول = عدد أ
        متغير النتيجة = []
        متغير ف = 0

        بينما (ف < الطول)
            النتيجة += [ثزمن_حصأو(أ[ف]، ب[ف])]
            ف = ف + 1
        نهاية

        ارجع النتيجة
    نهاية

    # AND مصفوفتين ثابت الوقت
    دالة مصفوفة حصو_مصفوفات(مصفوفة أ، مصفوفة ب)
        متغير الطول = عدد أ
        متغير النتيجة = []
        متغير ف = 0

        بينما (ف < الطول)
            النتيجة += [ثزمن_حصو(أ[ف]، ب[ف])]
            ف = ف + 1
        نهاية

        ارجع النتيجة
    نهاية

    # اختيار شرطي لمصفوفة كاملة
    # إذا شرط=1: ارجع ب، وإلا: ارجع أ
    دالة مصفوفة اختيار_مصفوفة(مصفوفة أ، مصفوفة ب، رقم شرط)
        متغير الطول = عدد أ
        متغير النتيجة = []
        متغير ف = 0

        بينما (ف < الطول)
            النتيجة += [ثزمن_اختيار(أ[ف]، ب[ف]، شرط)]
            ف = ف + 1
        نهاية

        ارجع النتيجة
    نهاية

    # تبديل شرطي لمصفوفتين كاملتين
    دالة تبديل_مصفوفات(مصفوفة أ، مصفوفة ب، رقم شرط)
        متغير الطول = عدد أ
        متغير ف = 0

        بينما (ف < الطول)
            متغير أ_أصلي = أ[ف]
            متغير ب_أصلي = ب[ف]
            أ[ف] = ثزمن_اختيار(أ_أصلي، ب_أصلي، شرط)
            ب[ف] = ثزمن_اختيار(ب_أصلي، أ_أصلي، شرط)
            ف = ف + 1
        نهاية
    نهاية

    # تصفير شرطي: إذا شرط=1 نمسح المصفوفة
    دالة تصفير_شرطي(مصفوفة البيانات، رقم شرط)
        متغير الطول = عدد البيانات
        متغير ف = 0

        بينما (ف < الطول)
            البيانات[ف] = ثزمن_اختيار(البيانات[ف]، 0، شرط)
            ف = ف + 1
        نهاية
    نهاية
