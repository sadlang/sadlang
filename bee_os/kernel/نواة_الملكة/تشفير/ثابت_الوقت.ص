# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# تحويل عدد 32 بت إلى 4 بايتات (Little-Endian)
# ──────────────────────────────────────────────────────────────────────
دالة مصفوفة ثزمن_إلى_بايتات_32(رقم قيمة)
    متغير النتيجة = []
    متغير ق = قيمة

    # البايت 0 (الأقل أهمية)
    النتيجة += [ثزمن_باقي(ق، 256)]
    ق = (ق - ثزمن_باقي(ق، 256)) / 256

    # البايت 1
    النتيجة += [ثزمن_باقي(ق، 256)]
    ق = (ق - ثزمن_باقي(ق، 256)) / 256

    # البايت 2
    النتيجة += [ثزمن_باقي(ق، 256)]
    ق = (ق - ثزمن_باقي(ق، 256)) / 256

    # البايت 3
    النتيجة += [ثزمن_باقي(ق، 256)]

    ارجع النتيجة
نهاية

# ──────────────────────────────────────────────────────────────────────
# تحويل 4 بايتات إلى عدد 32 بت (Little-Endian)
# ──────────────────────────────────────────────────────────────────────
دالة رقم ثزمن_من_بايتات_32(مصفوفة بايتات، رقم بداية)
    متغير نتيجة = بايتات[بداية]
    نتيجة = نتيجة + بايتات[بداية + 1] * 256
    نتيجة = نتيجة + بايتات[بداية + 2] * 65536
    نتيجة = نتيجة + بايتات[بداية + 3] * 16777216
    ارجع نتيجة
