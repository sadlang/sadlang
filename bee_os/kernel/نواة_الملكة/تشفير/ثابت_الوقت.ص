# ──────────────────────────────────────────────────────────────────────
# مسح مصفوفة بشكل آمن (لا يُحسّنه المُحسِّن بعيداً)
# يكتب عدة أنماط لضمان مسح الذاكرة فعلياً
# ──────────────────────────────────────────────────────────────────────
دالة مسح_مصفوفة_آمن(مصفوفة البيانات)
    متغير الطول = عدد البيانات

    # المرور 1: كتابة 0xFF
    متغير ف = 0
    بينما (ف < الطول)
        البيانات[ف] = 255
        ف = ف + 1
    نهاية

    # المرور 2: كتابة 0x55 (نمط متناوب)
    ف = 0
    بينما (ف < الطول)
        البيانات[ف] = 85
        ف = ف + 1
    نهاية

    # المرور 3: كتابة 0xAA (نمط متناوب معكوس)
    ف = 0
    بينما (ف < الطول)
        البيانات[ف] = 170
        ف = ف + 1
    نهاية

    # المرور 4: كتابة أصفار
    ف = 0
    بينما (ف < الطول)
        البيانات[ف] = 0
        ف = ف + 1
    نهاية
نهاية

