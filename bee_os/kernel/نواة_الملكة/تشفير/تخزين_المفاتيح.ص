# أنواع المفاتيح
ثابت مفتاح_متماثل = 1          # AES/ChaCha20
ثابت مفتاح_عام = 2             # Ed25519 public
ثابت مفتاح_خاص = 3             # Ed25519 private
ثابت مفتاح_HMAC = 4            # مفتاح HMAC
ثابت مفتاح_اشتقاق = 5         # Key Derivation

# أحجام المفاتيح (بايت)
ثابت حجم_128بت = 16
ثابت حجم_256بت = 32
ثابت حجم_512بت = 64

# حالة المفتاح
ثابت مفتاح_نشط = 0
ثابت مفتاح_معطل = 1
ثابت مفتاح_منتهي = 2
ثابت مفتاح_محذوف = 3
ثابت مفتاح_مُعلَّق = 4

# أذونات المفتاح
ثابت إذن_قراءة = 1
ثابت إذن_استخدام = 2
ثابت إذن_تصدير = 4
ثابت إذن_حذف = 8
ثابت إذن_كامل = 15

# أقصى عدد مفاتيح
ثابت أقصى_مفاتيح = 256


# ══════════════════════════════════════════════════════════════════════════════
#                      دوال مساعدة
# ══════════════════════════════════════════════════════════════════════════════

دالة مصفوفة تخ_تجزئة(مصفوفة البيانات)
    متغير ح = [1779033703، 3144134277، 1013904242، 2773480762، 1359893119، 2600822924، 528734635، 1541459225]
    متغير ف = 0
    بينما (ف < عدد البيانات)
        متغير ب = البيانات[ف]
        متغير ق = 0
        بينما (ق < 8)
            ح[ق] = (ح[ق] + ب * (2654435761 + ق * 1000000007)) % 4294967296
            اذا (ح[ق] < 0)
                ح[ق] = ح[ق] * (-1)
            نهاية
            ق = ق + 1
        نهاية
        ف = ف + 1
    نهاية
    متغير النتيجة = []
    متغير ق2 = 0
    بينما (ق2 < 8)
        متغير ر = ح[ق2]
        النتيجة += [ر % 256]
        النتيجة += [(ر / 256) % 256]
        النتيجة += [(ر / 65536) % 256]
        النتيجة += [(ر / 16777216) % 256]
        ق2 = ق2 + 1
    نهاية
    ارجع النتيجة
نهاية

دالة رقم تخ_حصأو(رقم أ، رقم ب)
    متغير نت = 0
    متغير بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 8)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 != ب2)
            نت = نت + بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        بت = بت * 2
        ع = ع + 1
    نهاية
    ارجع نت
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف بيانات المفتاح (Key Material)
# ══════════════════════════════════════════════════════════════════════════════

صنف بيانات_مفتاح
    ## يخزن مادة المفتاح الخام (مشفّرة في الذاكرة)

    مصفوفة البيانات_المشفّرة   # بيانات المفتاح مشفّرة
    مصفوفة قناع_التشفير       # قناع XOR لحماية الذاكرة
    رقم الحجم_الأصلي          # حجم المفتاح الأصلي
    منطقي مُحمَّل             # هل محمّل في الذاكرة؟

    باني()
        البيانات_المشفّرة = []
        قناع_التشفير = []
        الحجم_الأصلي = 0
        مُحمَّل = خطأ
    نهاية

    # تخزين مفتاح (يُشفّر تلقائياً في الذاكرة)
    دالة خزّن(مصفوفة البيانات_الخام، مصفوفة القناع)
        قناع_التشفير = القناع
        الحجم_الأصلي = عدد البيانات_الخام

        # تشفير XOR
        البيانات_المشفّرة = []
        متغير ف = 0
        بينما (ف < عدد البيانات_الخام)
            البيانات_المشفّرة += [تخ_حصأو(البيانات_الخام[ف]، القناع[ف % عدد القناع])]
            ف = ف + 1
        نهاية
        مُحمَّل = صحيح
    نهاية

    # قراءة المفتاح (يفك التشفير)
    دالة مصفوفة اقرأ()
        اذا (مُحمَّل != صحيح)
            ارجع []
        نهاية
        متغير النتيجة = []
        متغير ف = 0
        بينما (ف < عدد البيانات_المشفّرة)
            النتيجة += [تخ_حصأو(البيانات_المشفّرة[ف]، قناع_التشفير[ف % عدد قناع_التشفير])]
            ف = ف + 1
        نهاية
        ارجع النتيجة
    نهاية

    # مسح آمن
    دالة امسح()
        متغير ف = 0
        بينما (ف < عدد البيانات_المشفّرة)
            البيانات_المشفّرة[ف] = 0
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد قناع_التشفير)
            قناع_التشفير[ف] = 0
            ف = ف + 1
        نهاية
        مُحمَّل = خطأ
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف إدخال المفتاح (Key Entry)
# ══════════════════════════════════════════════════════════════════════════════

صنف إدخال_مفتاح
    ## يمثل مفتاحاً واحداً في المخزن

    نص المعرّف                 # معرّف فريد
    رقم النوع                  # نوع المفتاح
    رقم الحجم                  # حجم المفتاح (بايت)
    رقم الحالة_م                # حالة المفتاح
    رقم الأذونات              # أذونات الاستخدام
    رقم وقت_الإنشاء            # وقت الإنشاء
    رقم وقت_الانتهاء          # وقت الانتهاء
    رقم عدد_الاستخدامات       # عدد مرات الاستخدام
    رقم أقصى_استخدامات        # أقصى عدد استخدامات (0 = بلا حد)
    بيانات_مفتاح المادة       # مادة المفتاح
    نص الوصف                   # وصف المفتاح
    مصفوفة البصمة             # بصمة المفتاح (تجزئة)

    باني(نص معرّف، رقم نوع)
        المعرّف = معرّف
        النوع = نوع
        الحجم = 0
        الحالة_م = مفتاح_نشط
        الأذونات = إذن_استخدام
        وقت_الإنشاء = 0
        وقت_الانتهاء = 0
        عدد_الاستخدامات = 0
        أقصى_استخدامات = 0
        المادة = جديد بيانات_مفتاح()
        الوصف = ""
        البصمة = []
    نهاية

    # هل المفتاح نشط وصالح؟
    دالة منطقي نشط(رقم الوقت_الحالي)
        اذا (الحالة_م != مفتاح_نشط)
            ارجع خطأ
        نهاية
        اذا (وقت_الانتهاء > 0)
            اذا (الوقت_الحالي > وقت_الانتهاء)
                ارجع خطأ
            نهاية
        نهاية
        اذا (أقصى_استخدامات > 0)
            اذا (عدد_الاستخدامات >= أقصى_استخدامات)
                ارجع خطأ
            نهاية
        نهاية
        ارجع صحيح
    نهاية

    # استخدام المفتاح
    دالة منطقي استخدم()
        عدد_الاستخدامات = عدد_الاستخدامات + 1
        اذا (أقصى_استخدامات > 0)
            اذا (عدد_الاستخدامات >= أقصى_استخدامات)
                الحالة_م = مفتاح_منتهي
            نهاية
        نهاية
        ارجع صحيح
    نهاية

    # هل لديه إذن معين؟
    دالة منطقي لديه_إذن(رقم الإذن)
        متغير قسمة = الأذونات / الإذن
        ارجع قسمة % 2 >= 1
    نهاية

    # حساب البصمة
    دالة احسب_البصمة()
        متغير بيانات = المادة.اقرأ()
        اذا (عدد بيانات > 0)
            البصمة = تخ_تجزئة(بيانات)
        نهاية
    نهاية

    # طباعة معلومات
    دالة اطبع_معلومات()
        اطبع("  [")
        اطبع(المعرّف)
        اطبع("] نوع=")
        اذا (النوع == مفتاح_متماثل)
            اطبع("متماثل")
        والا_اذا (النوع == مفتاح_عام)
            اطبع("عام")
        والا_اذا (النوع == مفتاح_خاص)
            اطبع("خاص")
        والا_اذا (النوع == مفتاح_HMAC)
            اطبع("HMAC")
        والا
            اطبع("اشتقاق")
        نهاية
        اطبع(" حالة=")
        اذا (الحالة_م == مفتاح_نشط)
            اطبع("نشط")
        والا_اذا (الحالة_م == مفتاح_معطل)
            اطبع("معطل")
        والا_اذا (الحالة_م == مفتاح_منتهي)
            اطبع("منتهي")
        والا
            اطبع("محذوف")
        نهاية
        اطبع(" استخدامات=")
        اطبع_سطر(عدد_الاستخدامات)
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف اشتقاق المفاتيح (Key Derivation)
# ══════════════════════════════════════════════════════════════════════════════

صنف مشتق_المفاتيح
    ## يشتق مفاتيح فرعية من مفتاح رئيسي (HKDF مبسط)

    باني()
    نهاية

    # استخراج (Extract): PRK = Hash(salt || IKM)
    دالة مصفوفة استخرج(مصفوفة الملح، مصفوفة المادة)
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد الملح)
            مدخل += [الملح[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد المادة)
            مدخل += [المادة[ف]]
            ف = ف + 1
        نهاية
        ارجع تخ_تجزئة(مدخل)
    نهاية

    # توسيع (Expand): OKM = Hash(PRK || info || counter)
    دالة مصفوفة وسّع(مصفوفة المفتاح_المستخرج، مصفوفة المعلومات، رقم الطول)
        متغير النتيجة = []
        متغير ت_سابق = []
        متغير عداد = 1

        بينما (عدد النتيجة < الطول)
            متغير مدخل = []
            # T_previous
            متغير ف = 0
            بينما (ف < عدد ت_سابق)
                مدخل += [ت_سابق[ف]]
                ف = ف + 1
            نهاية
            # PRK
            ف = 0
            بينما (ف < عدد المفتاح_المستخرج)
                مدخل += [المفتاح_المستخرج[ف]]
                ف = ف + 1
            نهاية
            # info
            ف = 0
            بينما (ف < عدد المعلومات)
                مدخل += [المعلومات[ف]]
                ف = ف + 1
            نهاية
            # counter
            مدخل += [عداد % 256]

            ت_سابق = تخ_تجزئة(مدخل)
            ف = 0
            بينما (ف < عدد ت_سابق)
                اذا (عدد النتيجة < الطول)
                    النتيجة += [ت_سابق[ف]]
                نهاية
                ف = ف + 1
            نهاية
            عداد = عداد + 1
        نهاية

        ارجع النتيجة
    نهاية

    # اشتقاق مفتاح كامل (HKDF)
    دالة مصفوفة اشتق(مصفوفة المادة، مصفوفة الملح، مصفوفة المعلومات، رقم الطول)
        متغير مستخرج = استخرج(الملح، المادة)
        ارجع وسّع(مستخرج، المعلومات، الطول)
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف مخزن المفاتيح (Key Store)
# ══════════════════════════════════════════════════════════════════════════════

صنف مخزن_المفاتيح
    ## مخزن مفاتيح آمن ومشفّر

    مصفوفة المفاتيح           # قائمة إدخالات المفاتيح
    مشتق_المفاتيح المشتق      # نظام اشتقاق المفاتيح
    مصفوفة مفتاح_التشفير     # مفتاح تشفير المخزن نفسه
    رقم العدّاد               # عداد المفاتيح
    منطقي مُهيّأ              # هل المخزن مهيأ؟

    باني()
        المفاتيح = []
        المشتق = جديد مشتق_المفاتيح()
        مفتاح_التشفير = []
        العدّاد = 0
        مُهيّأ = خطأ
    نهاية

    # تهيئة المخزن بمفتاح رئيسي
    دالة تهيئة(مصفوفة المفتاح_الرئيسي)
        # اشتقاق مفتاح تشفير المخزن من المفتاح الرئيسي
        مفتاح_التشفير = المشتق.اشتق(المفتاح_الرئيسي، [78، 97، 104، 108], [75، 83، 116، 111، 114، 101]، 32)
        مُهيّأ = صحيح
        اطبع_سطر("  مخزن المفاتيح: مُهيّأ")
    نهاية

    # إضافة مفتاح
    دالة نص أضف_مفتاح(نص المعرّف، رقم النوع، مصفوفة البيانات، رقم الأذونات)
        اذا (مُهيّأ != صحيح)
            ارجع ""
        نهاية
        اذا (العدّاد >= أقصى_مفاتيح)
            اطبع_سطر("  ✗ المخزن ممتلئ")
            ارجع ""
        نهاية

        # التحقق من عدم وجود تكرار
        متغير ف = 0
        بينما (ف < عدد المفاتيح)
            اذا (المفاتيح[ف].المعرّف == المعرّف)
                اطبع("  ✗ المعرّف موجود: ")
                اطبع_سطر(المعرّف)
                ارجع ""
            نهاية
            ف = ف + 1
        نهاية

        # إنشاء إدخال المفتاح
        متغير إدخال = جديد إدخال_مفتاح(المعرّف، النوع)
        إدخال.الحجم = عدد البيانات
        إدخال.الأذونات = الأذونات
        إدخال.المادة.خزّن(البيانات، مفتاح_التشفير)
        إدخال.احسب_البصمة()
        إدخال.وقت_الإنشاء = العدّاد

        المفاتيح += [إدخال]
        العدّاد = العدّاد + 1

        ارجع المعرّف
    نهاية

    # قراءة مفتاح
    دالة مصفوفة اقرأ_مفتاح(نص المعرّف)
        متغير ف = 0
        بينما (ف < عدد المفاتيح)
            اذا (المفاتيح[ف].المعرّف == المعرّف)
                اذا (المفاتيح[ف].لديه_إذن(إذن_قراءة))
                    المفاتيح[ف].استخدم()
                    ارجع المفاتيح[ف].المادة.اقرأ()
                والا
                    اطبع("  ✗ لا إذن قراءة: ")
                    اطبع_سطر(المعرّف)
                    ارجع []
                نهاية
            نهاية
            ف = ف + 1
        نهاية
        اطبع("  ✗ مفتاح غير موجود: ")
        اطبع_سطر(المعرّف)
        ارجع []
    نهاية

    # حذف مفتاح (مسح آمن)
    دالة منطقي احذف_مفتاح(نص المعرّف)
        متغير ف = 0
        بينما (ف < عدد المفاتيح)
            اذا (المفاتيح[ف].المعرّف == المعرّف)
                اذا (المفاتيح[ف].لديه_إذن(إذن_حذف))
                    المفاتيح[ف].المادة.امسح()
                    المفاتيح[ف].الحالة_م = مفتاح_محذوف
                    ارجع صحيح
                والا
                    اطبع_سطر("  ✗ لا إذن حذف")
                    ارجع خطأ
                نهاية
            نهاية
            ف = ف + 1
        نهاية
        ارجع خطأ
    نهاية

    # اشتقاق مفتاح جديد من مفتاح موجود
    دالة نص اشتق(نص معرّف_أصل، نص معرّف_جديد، مصفوفة معلومات، رقم الطول)
        متغير مادة_أصل = اقرأ_مفتاح(معرّف_أصل)
        اذا (عدد مادة_أصل == 0)
            ارجع ""
        نهاية

        متغير مشتق_م = المشتق.اشتق(مادة_أصل، [0]، معلومات، الطول)
        ارجع أضف_مفتاح(معرّف_جديد، مفتاح_اشتقاق، مشتق_م، إذن_استخدام + إذن_قراءة)
    نهاية

    # طباعة المفاتيح
    دالة اطبع_المفاتيح()
        اطبع_سطر("── مخزن المفاتيح ──")
        اطبع("  عدد المفاتيح: ")
        اطبع_سطر(عدد المفاتيح)
        متغير ف = 0
        بينما (ف < عدد المفاتيح)
            المفاتيح[ف].اطبع_معلومات()
            ف = ف + 1
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف مدير المفاتيح (Key Manager)
# ══════════════════════════════════════════════════════════════════════════════

صنف مدير_المفاتيح
    ## واجهة عليا لإدارة المفاتيح

    مخزن_المفاتيح المخزن
    رقم عداد_العمليات

    باني()
        المخزن = جديد مخزن_المفاتيح()
        عداد_العمليات = 0
    نهاية

    # تهيئة
    دالة تهيئة(مصفوفة المفتاح_الرئيسي)
        المخزن.تهيئة(المفتاح_الرئيسي)
    نهاية

    # توليد مفتاح عشوائي وتخزينه
    دالة نص ولّد_وخزّن(نص المعرّف، رقم النوع، رقم الحجم، رقم بذرة)
        متغير مفتاح = []
        متغير ف = 0
        بينما (ف < الحجم)
            مفتاح += [(بذرة * (ف + 1) * 2654435761) % 256]
            اذا (مفتاح[ف] < 0)
                مفتاح[ف] = مفتاح[ف] * (-1)
            نهاية
            ف = ف + 1
        نهاية
        عداد_العمليات = عداد_العمليات + 1
        ارجع المخزن.أضف_مفتاح(المعرّف، النوع، مفتاح، إذن_كامل)
    نهاية

    # استخدام مفتاح للتشفير
    دالة مصفوفة شفّر(نص معرّف_المفتاح، مصفوفة البيانات)
        متغير مفتاح = المخزن.اقرأ_مفتاح(معرّف_المفتاح)
        اذا (عدد مفتاح == 0)
            ارجع []
        نهاية

        # تشفير XOR بسيط
        متغير مشفّر = []
        متغير ف = 0
        بينما (ف < عدد البيانات)
            مشفّر += [تخ_حصأو(البيانات[ف]، مفتاح[ف % عدد مفتاح])]
            ف = ف + 1
        نهاية
        عداد_العمليات = عداد_العمليات + 1
        ارجع مشفّر
    نهاية

    # فك التشفير
    دالة مصفوفة فك_التشفير(نص معرّف_المفتاح، مصفوفة البيانات)
        ارجع شفّر(معرّف_المفتاح، البيانات)   # XOR متماثل
    نهاية

    # دوران المفتاح (إنشاء مفتاح جديد واستبداله)
    دالة نص دوران_مفتاح(نص المعرّف_القديم، نص المعرّف_الجديد، رقم بذرة)
        متغير إدخال = المخزن.اقرأ_مفتاح(المعرّف_القديم)
        اذا (عدد إدخال == 0)
            ارجع ""
        نهاية

        # إنشاء المفتاح الجديد
        متغير نتيجة = ولّد_وخزّن(المعرّف_الجديد، مفتاح_متماثل، عدد إدخال، بذرة)

        # تعطيل المفتاح القديم
        المخزن.احذف_مفتاح(المعرّف_القديم)

        اطبع("  🔄 دوران: ")
        اطبع(المعرّف_القديم)
        اطبع(" → ")
        اطبع_سطر(المعرّف_الجديد)
        ارجع نتيجة
    نهاية

    # طباعة الإحصاءات
    دالة اطبع_إحصاءات()
        اطبع_سطر("── إحصاءات مدير المفاتيح ──")
        اطبع("  العمليات: ")
        اطبع_سطر(عداد_العمليات)
        المخزن.اطبع_المفاتيح()
    نهاية
نهاية


