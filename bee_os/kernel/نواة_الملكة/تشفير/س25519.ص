    # الخطوة 3: t1 = f * t2 = f^9
    ت1_0 = حقل_ضرب(ف0، ف1، ف2، ف3، ف4، ف5، ف6، ف7، ف8، ف9، ت2_0، ت2_1، ت2_2، ت2_3، ت2_4، ت2_5، ت2_6، ت2_7، ت2_8، ت2_9، 0)
