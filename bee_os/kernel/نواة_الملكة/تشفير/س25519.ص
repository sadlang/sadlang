# ══════════════════════════════════════════════════════════════════════════════
#                    الضرب في الحقل GF(2^255 - 19)
# ══════════════════════════════════════════════════════════════════════════════
#
# خوارزمية الضرب مع الاختزال:
#   h = f * g  حيث f,g عناصر حقل بـ 10 أطراف
#
# الضرب الكامل ينتج 19 (10+9) منتجاً جزئياً
# الاختزال يستفيد من: 2^255 ≡ 19 (mod p)
# لذا المنتجات الملتفة تُضرب بـ 19
#
# تحسينات:
#   - الأطراف الفردية تُضرب بـ 2 قبل الضرب (لتعويض فرق 25/26 بت)
#   - المنتجات الملتفة (مؤشر >= 10) تُضرب بـ 19
#
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# ضرب عنصرين في الحقل: ن = ف × ج
# يأخذ 10 أطراف لكل عنصر + فهرس الخرج (0-9)
# يعيد الطرف المطلوب بعد الاختزال والحمل
# ──────────────────────────────────────────────────────────────────────
دالة رقم حقل_ضرب(رقم ف0، رقم ف1، رقم ف2، رقم ف3، رقم ف4، رقم ف5، رقم ف6، رقم ف7، رقم ف8، رقم ف9، رقم ج0، رقم ج1، رقم ج2، رقم ج3، رقم ج4، رقم ج5، رقم ج6، رقم ج7، رقم ج8، رقم ج9، رقم ف)
    # إعداد المضاعفات: الأطراف الفردية × 2
    متغير ف1_2 = ف1 * 2
    متغير ف3_2 = ف3 * 2
    متغير ف5_2 = ف5 * 2
    متغير ف7_2 = ف7 * 2
    متغير ف9_2 = ف9 * 2

    # المنتجات الملتفة × 19
    متغير ج1_19 = ج1 * 19
    متغير ج2_19 = ج2 * 19
    متغير ج3_19 = ج3 * 19
    متغير ج4_19 = ج4 * 19
    متغير ج5_19 = ج5 * 19
    متغير ج6_19 = ج6 * 19
    متغير ج7_19 = ج7 * 19
    متغير ج8_19 = ج8 * 19
    متغير ج9_19 = ج9 * 19

    # حساب الأطراف العشرة للمنتج
    # h0 = f0*g0 + 19*(f1_2*g9 + f2*g8 + f3_2*g7 + f4*g6 + f5_2*g5
    #                  + f6*g4 + f7_2*g3 + f8*g2 + f9_2*g1)
    متغير ح0 = ف0*ج0 + ف1_2*ج9_19 + ف2*ج8_19 + ف3_2*ج7_19 + ف4*ج6_19
    ح0 = ح0 + ف5_2*ج5_19 + ف6*ج4_19 + ف7_2*ج3_19 + ف8*ج2_19 + ف9_2*ج1_19

    # h1 = f0*g1 + f1*g0 + 19*(f2*g9 + f3_2*g8 + f4*g7 + f5_2*g6
    #                          + f6*g5 + f7_2*g4 + f8*g3 + f9_2*g2)
    متغير ح1 = ف0*ج1 + ف1*ج0 + ف2*ج9_19 + ف3_2*ج8_19 + ف4*ج7_19
    ح1 = ح1 + ف5_2*ج6_19 + ف6*ج5_19 + ف7_2*ج4_19 + ف8*ج3_19 + ف9_2*ج2_19

    # h2 = f0*g2 + f1_2*g1 + f2*g0 + 19*(f3_2*g9 + f4*g8 + f5_2*g7
    #                                     + f6*g6 + f7_2*g5 + f8*g4 + f9_2*g3)
    متغير ح2 = ف0*ج2 + ف1_2*ج1 + ف2*ج0 + ف3_2*ج9_19 + ف4*ج8_19
    ح2 = ح2 + ف5_2*ج7_19 + ف6*ج6_19 + ف7_2*ج5_19 + ف8*ج4_19 + ف9_2*ج3_19

    # h3 = f0*g3 + f1*g2 + f2*g1 + f3*g0 + 19*(f4*g9 + f5_2*g8
    #                                          + f6*g7 + f7_2*g6 + f8*g5 + f9_2*g4)
    متغير ح3 = ف0*ج3 + ف1*ج2 + ف2*ج1 + ف3*ج0 + ف4*ج9_19
    ح3 = ح3 + ف5_2*ج8_19 + ف6*ج7_19 + ف7_2*ج6_19 + ف8*ج5_19 + ف9_2*ج4_19

    # h4 = f0*g4 + f1_2*g3 + f2*g2 + f3_2*g1 + f4*g0
    #      + 19*(f5_2*g9 + f6*g8 + f7_2*g7 + f8*g6 + f9_2*g5)
    متغير ح4 = ف0*ج4 + ف1_2*ج3 + ف2*ج2 + ف3_2*ج1 + ف4*ج0
    ح4 = ح4 + ف5_2*ج9_19 + ف6*ج8_19 + ف7_2*ج7_19 + ف8*ج6_19 + ف9_2*ج5_19

    # h5 = f0*g5 + f1*g4 + f2*g3 + f3*g2 + f4*g1 + f5*g0
    #      + 19*(f6*g9 + f7_2*g8 + f8*g7 + f9_2*g6)
    متغير ح5 = ف0*ج5 + ف1*ج4 + ف2*ج3 + ف3*ج2 + ف4*ج1 + ف5*ج0
    ح5 = ح5 + ف6*ج9_19 + ف7_2*ج8_19 + ف8*ج7_19 + ف9_2*ج6_19

    # h6 = f0*g6 + f1_2*g5 + f2*g4 + f3_2*g3 + f4*g2 + f5_2*g1 + f6*g0
    #      + 19*(f7_2*g9 + f8*g8 + f9_2*g7)
    متغير ح6 = ف0*ج6 + ف1_2*ج5 + ف2*ج4 + ف3_2*ج3 + ف4*ج2 + ف5_2*ج1 + ف6*ج0
    ح6 = ح6 + ف7_2*ج9_19 + ف8*ج8_19 + ف9_2*ج7_19

    # h7 = f0*g7 + f1*g6 + f2*g5 + f3*g4 + f4*g3 + f5*g2 + f6*g1 + f7*g0
    #      + 19*(f8*g9 + f9_2*g8)
    متغير ح7 = ف0*ج7 + ف1*ج6 + ف2*ج5 + ف3*ج4 + ف4*ج3 + ف5*ج2 + ف6*ج1 + ف7*ج0
    ح7 = ح7 + ف8*ج9_19 + ف9_2*ج8_19

    # h8 = f0*g8 + f1_2*g7 + f2*g6 + f3_2*g5 + f4*g4 + f5_2*g3 + f6*g2
    #      + f7_2*g1 + f8*g0 + 19*(f9_2*g9)
    متغير ح8 = ف0*ج8 + ف1_2*ج7 + ف2*ج6 + ف3_2*ج5 + ف4*ج4 + ف5_2*ج3 + ف6*ج2
    ح8 = ح8 + ف7_2*ج1 + ف8*ج0 + ف9_2*ج9_19

    # h9 = f0*g9 + f1*g8 + f2*g7 + f3*g6 + f4*g5 + f5*g4 + f6*g3
    #      + f7*g2 + f8*g1 + f9*g0
    متغير ح9 = ف0*ج9 + ف1*ج8 + ف2*ج7 + ف3*ج6 + ف4*ج5 + ف5*ج4 + ف6*ج3
    ح9 = ح9 + ف7*ج2 + ف8*ج1 + ف9*ج0

    # معالجة الحمل
    ارجع حقل_حمل(ح0، ح1، ح2، ح3، ح4، ح5، ح6، ح7، ح8، ح9، ف)
