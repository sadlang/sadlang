# ══════════════════════════════════════════════════════════════════════════════
#                       معالجة الحمل (Carry Propagation)
# ══════════════════════════════════════════════════════════════════════════════
#
# بعد الجمع/الطرح/الضرب، قد تتجاوز الأطراف حدودها
# يجب نقل الفائض (carry) من كل طرف إلى الطرف التالي
#
# الأطراف الزوجية (0,2,4,6,8): الحد = 2^26، الحمل = ق >> 26
# الأطراف الفردية (1,3,5,7,9): الحد = 2^25، الحمل = ق >> 25
#
# طرف 9 يلتف إلى طرف 0 مع الضرب بـ 19
# (لأن 2^255 ≡ 19 mod p)
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# معالجة الحمل الكاملة لعنصر حقل
# تأخذ 10 أطراف وتعيد الطرف المطلوب بعد معالجة الحمل
# ──────────────────────────────────────────────────────────────────────
دالة رقم حقل_حمل(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4، رقم أ5، رقم أ6، رقم أ7، رقم أ8، رقم أ9، رقم ف)
    # الجولة الأولى: معالجة الحمل من كل طرف إلى التالي
    # حمل طرف 0 (26 بت) → طرف 1
    متغير ح0 = إزاحة_يمين(أ0، 26)
    متغير ت0 = أ0 - ح0 * قوة_2_26()
    متغير ت1 = أ1 + ح0

    # حمل طرف 1 (25 بت) → طرف 2
    متغير ح1 = إزاحة_يمين(ت1، 25)
    ت1 = ت1 - ح1 * قوة_2_25()
    متغير ت2 = أ2 + ح1

    # حمل طرف 2 (26 بت) → طرف 3
    متغير ح2 = إزاحة_يمين(ت2، 26)
    ت2 = ت2 - ح2 * قوة_2_26()
    متغير ت3 = أ3 + ح2

    # حمل طرف 3 (25 بت) → طرف 4
    متغير ح3 = إزاحة_يمين(ت3، 25)
    ت3 = ت3 - ح3 * قوة_2_25()
    متغير ت4 = أ4 + ح3

    # حمل طرف 4 (26 بت) → طرف 5
    متغير ح4 = إزاحة_يمين(ت4، 26)
    ت4 = ت4 - ح4 * قوة_2_26()
    متغير ت5 = أ5 + ح4

    # حمل طرف 5 (25 بت) → طرف 6
    متغير ح5 = إزاحة_يمين(ت5، 25)
    ت5 = ت5 - ح5 * قوة_2_25()
    متغير ت6 = أ6 + ح5

    # حمل طرف 6 (26 بت) → طرف 7
    متغير ح6 = إزاحة_يمين(ت6، 26)
    ت6 = ت6 - ح6 * قوة_2_26()
    متغير ت7 = أ7 + ح6

    # حمل طرف 7 (25 بت) → طرف 8
    متغير ح7 = إزاحة_يمين(ت7، 25)
    ت7 = ت7 - ح7 * قوة_2_25()
    متغير ت8 = أ8 + ح7

    # حمل طرف 8 (26 بت) → طرف 9
    متغير ح8 = إزاحة_يمين(ت8، 26)
    ت8 = ت8 - ح8 * قوة_2_26()
    متغير ت9 = أ9 + ح8

    # حمل طرف 9 (25 بت) → يلتف إلى طرف 0 مع ×19
    متغير ح9 = إزاحة_يمين(ت9، 25)
    ت9 = ت9 - ح9 * قوة_2_25()
    ت0 = ت0 + ح9 * 19

    # جولة ثانية لمعالجة الفائض الناتج من الالتفاف
    متغير ح0ب = إزاحة_يمين(ت0، 26)
    ت0 = ت0 - ح0ب * قوة_2_26()
    ت1 = ت1 + ح0ب

    # إرجاع الطرف المطلوب
    اذا (ف == 0)
        ارجع ت0
    نهاية
    اذا (ف == 1)
        ارجع ت1
    نهاية
    اذا (ف == 2)
        ارجع ت2
    نهاية
    اذا (ف == 3)
        ارجع ت3
    نهاية
    اذا (ف == 4)
        ارجع ت4
    نهاية
    اذا (ف == 5)
        ارجع ت5
    نهاية
    اذا (ف == 6)
        ارجع ت6
    نهاية
    اذا (ف == 7)
        ارجع ت7
    نهاية
    اذا (ف == 8)
        ارجع ت8
    نهاية
    ارجع ت9
