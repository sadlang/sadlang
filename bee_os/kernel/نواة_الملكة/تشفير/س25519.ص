#
# تربيع محسّن: يستفيد من تماثل المنتجات الجزئية
# h = f² أسرع من h = f * f لأن نصف المنتجات متكررة
#
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# تربيع عنصر في الحقل: ن = ف²
# ──────────────────────────────────────────────────────────────────────
دالة رقم حقل_تربيع(رقم ف0، رقم ف1، رقم ف2، رقم ف3، رقم ف4، رقم ف5، رقم ف6، رقم ف7، رقم ف8، رقم ف9، رقم ف)
    # المضاعفات
    متغير ف0_2 = ف0 * 2
    متغير ف1_2 = ف1 * 2
    متغير ف2_2 = ف2 * 2
    متغير ف3_2 = ف3 * 2
    متغير ف4_2 = ف4 * 2
    متغير ف5_2 = ف5 * 2
    متغير ف6_2 = ف6 * 2
    متغير ف7_2 = ف7 * 2

    # الأطراف الفردية × 2 (لفرق 25/26 بت)
    متغير ف5_38 = ف5 * 38
    متغير ف6_19 = ف6 * 19
    متغير ف7_38 = ف7 * 38
    متغير ف8_19 = ف8 * 19
    متغير ف9_38 = ف9 * 38

    # h0 = f0² + 2*(f1*f9*38 + f2*f8*19 + f3*f7*38 + f4*f6*19) + f5²*38
    متغير ح0 = ف0*ف0 + ف1_2*ف9_38 + ف2_2*ف8_19 + ف3_2*ف7_38 + ف4_2*ف6_19 + ف5*ف5_38

    # h1 = 2*(f0*f1 + f2*f9*19 + f4*f7*19 + f6*f5*19) + f3*f8*38
    متغير ح1 = ف0_2*ف1 + ف2*ف9_38 + ف3_2*ف8_19 + ف4*ف7_38 + ف5_2*ف6_19

    # h2 = 2*(f0*f2 + f1*f1 + f4*f8*19 + f6*f6*19) + f3*f9*38 + f5*f7*38
    متغير ح2 = ف0_2*ف2 + ف1_2*ف1 + ف3_2*ف9_38 + ف4_2*ف8_19 + ف5_2*ف7_38 + ف6*ف6_19

    # h3 = 2*(f0*f3 + f1*f2 + f5*f8*19 + f7*f6*19) + f4*f9*38
    متغير ح3 = ف0_2*ف3 + ف1_2*ف2 + ف4*ف9_38 + ف5_2*ف8_19 + ف6*ف7_38

    # h4 = 2*(f0*f4 + f1*f3*2 + f2*f2 + f6*f8*19) + f5*f9*38 + f7*f7*38
    متغير ح4 = ف0_2*ف4 + ف1_2*ف3_2 + ف2*ف2 + ف5_2*ف9_38 + ف6_2*ف8_19 + ف7*ف7_38

    # h5 = 2*(f0*f5 + f1*f4 + f2*f3 + f7*f8*19) + f6*f9*38
    متغير ح5 = ف0_2*ف5 + ف1_2*ف4 + ف2_2*ف3 + ف6*ف9_38 + ف7_2*ف8_19

    # h6 = 2*(f0*f6 + f1*f5*2 + f2*f4 + f3*f3 + f8*f8*19) + f7*f9*38
    متغير ح6 = ف0_2*ف6 + ف1_2*ف5_2 + ف2_2*ف4 + ف3*ف3 + ف7_2*ف9_38 + ف8*ف8_19

    # h7 = 2*(f0*f7 + f1*f6 + f2*f5 + f3*f4 + f9*f8*19)
    متغير ح7 = ف0_2*ف7 + ف1_2*ف6 + ف2_2*ف5 + ف3_2*ف4 + ف8*ف9_38

    # h8 = 2*(f0*f8 + f1*f7*2 + f2*f6 + f3*f5*2 + f4*f4) + f9*f9*38
    متغير ح8 = ف0_2*ف8 + ف1_2*ف7_2 + ف2_2*ف6 + ف3_2*ف5_2 + ف4*ف4 + ف9*ف9_38

    # h9 = 2*(f0*f9 + f1*f8 + f2*f7 + f3*f6 + f4*f5)
    متغير ح9 = ف0_2*ف9 + ف1_2*ف8 + ف2_2*ف7 + ف3_2*ف6 + ف4_2*ف5

    # معالجة الحمل
    ارجع حقل_حمل(ح0، ح1، ح2، ح3، ح4، ح5، ح6، ح7، ح8، ح9، ف)
