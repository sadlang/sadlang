    متغير ت1_6 = حقل_تربيع(ت0_0، ت0_1، ت0_2، ت0_3، ت0_4، ت0_5، ت0_6، ت0_7، ت0_8، ت0_9، 6)
    متغير ت1_7 = حقل_تربيع(ت0_0، ت0_1، ت0_2، ت0_3، ت0_4، ت0_5، ت0_6، ت0_7، ت0_8، ت0_9، 7)
