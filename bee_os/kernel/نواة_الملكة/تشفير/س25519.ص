# س25519 - تبادل المفاتيح X25519 (Diffie-Hellman)
# T0165
# ══════════════════════════════════════════════════════════════════════════════
#
# التنفيذ حسب RFC 7748
# بروتوكول تبادل مفاتيح آمن باستخدام منحنى إهليلجي Curve25519
#
# المبادئ الرياضية:
#   المنحنى: y² = x³ + 486662x² + x  (mod p)
#   الحقل الأولي: p = 2²⁵⁵ - 19
#   نقطة الأساس: x = 9
#   الثابت: a24 = 121666  (حيث a = 486662, a24 = (a-2)/4)
#   رتبة المجموعة: n = 2²⁵² + 27742317777372353535851937790883648493
#
# الخوارزمية (سلم مونتغمري):
#   المدخلات: عدد صحيح k (المفتاح الخاص)، إحداثي x لنقطة P
#   المخرجات: إحداثي x لنقطة k*P
#
#   تقييد k: تصفير البتات 0,1,2 و 255، وتعيين البت 254
#   x2 = 1, z2 = 0    (نقطة المحايد = 0)
#   x3 = xP, z3 = 1   (نقطة البداية = P)
#
#   لكل بت من k (من البت 254 إلى 0):
#     swap = bit_i XOR bit_{i+1}
#     تبديل شرطي (x2,z2) و (x3,z3) إذا swap=1
#     عملية سلم مونتغمري:
#       A = x2 + z2
#       AA = A²
#       B = x2 - z2
#       BB = B²
#       E = AA - BB
#       C = x3 + z3
#       D = x3 - z3
#       DA = D * A
#       CB = C * B
#       x3 = (DA + CB)²
#       z3 = xP * (DA - CB)²
#       x2 = AA * BB
#       z2 = E * (AA + a24 * E)
#
#   النتيجة = x2 * z2⁻¹ mod p
#
# التمثيل الداخلي:
#   عنصر الحقل GF(p) يُمثّل بـ 10 أطراف (limbs):
#   الأطراف 0,2,4,6,8: 26 بت (قناع = 67108863)
#   الأطراف 1,3,5,7,9: 25 بت (قناع = 33554431)
#   المجموع: 5×26 + 5×25 = 255 بت
#
#   القيمة = ط0 + ط1×2²⁶ + ط2×2⁵¹ + ط3×2⁷⁷ + ط4×2¹⁰² +
#             ط5×2¹²⁸ + ط6×2¹⁵³ + ط7×2¹⁷⁹ + ط8×2⁰⁴ + ط9×2²³⁰
#
# ══════════════════════════════════════════════════════════════════════════════


