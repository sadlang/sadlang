# ──────────────────────────────────────────────────────────────────────
# XOR لعددين (32 بت)
# ──────────────────────────────────────────────────────────────────────
دالة رقم حص_أو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير س1 = أ
    متغير س2 = ب
    متغير عداد = 0

    بينما (عداد < 64)
        متغير ب1 = س1 % 2
        متغير ب2 = س2 % 2

        اذا (ب1 != ب2)
            نتيجة = نتيجة + قيمة_بت
        نهاية

        س1 = (س1 - ب1) / 2
        س2 = (س2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        عداد = عداد + 1
    نهاية

    ارجع نتيجة
نهاية


# ──────────────────────────────────────────────────────────────────────
# AND لعددين (64 بت)
# ──────────────────────────────────────────────────────────────────────
دالة رقم حص_و(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير س1 = أ
    متغير س2 = ب
    متغير عداد = 0

    بينما (عداد < 64)
        متغير ب1 = س1 % 2
        متغير ب2 = س2 % 2

        اذا (ب1 == 1)
            اذا (ب2 == 1)
                نتيجة = نتيجة + قيمة_بت
            نهاية
        نهاية

        س1 = (س1 - ب1) / 2
        س2 = (س2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        عداد = عداد + 1
    نهاية

    ارجع نتيجة
نهاية


# ──────────────────────────────────────────────────────────────────────
# OR لعددين (64 بت)
# ──────────────────────────────────────────────────────────────────────
دالة رقم حص_أو_منطقي(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير س1 = أ
    متغير س2 = ب
    متغير عداد = 0

    بينما (عداد < 64)
        متغير ب1 = س1 % 2
        متغير ب2 = س2 % 2

        اذا (ب1 == 1)
            نتيجة = نتيجة + قيمة_بت
        والا
            اذا (ب2 == 1)
                نتيجة = نتيجة + قيمة_بت
            نهاية
        نهاية

        س1 = (س1 - ب1) / 2
        س2 = (س2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        عداد = عداد + 1
    نهاية

    ارجع نتيجة
نهاية


# ──────────────────────────────────────────────────────────────────────
# إزاحة يمينية: أ >> ن
# ──────────────────────────────────────────────────────────────────────
دالة رقم إزاحة_يمين(رقم أ، رقم ن)
    متغير قاسم = 1
    متغير ع = 0
    بينما (ع < ن)
        قاسم = قاسم * 2
        ع = ع + 1
    نهاية
    ارجع (أ - (أ % قاسم)) / قاسم
نهاية


# ──────────────────────────────────────────────────────────────────────
# إزاحة يسارية: أ << ن (مع تحديد عدد البتات)
# ──────────────────────────────────────────────────────────────────────
دالة رقم إزاحة_يسار(رقم أ، رقم ن)
    متغير مضاعف = 1
    متغير ع = 0
    بينما (ع < ن)
        مضاعف = مضاعف * 2
        ع = ع + 1
    نهاية
    ارجع أ * مضاعف
نهاية


# ──────────────────────────────────────────────────────────────────────
# استخراج بت محدد من عدد
# الموضع: 0 = أقل بت أهمية (LSB)
# ──────────────────────────────────────────────────────────────────────
دالة رقم استخراج_بت(رقم قيمة، رقم موضع)
    متغير ق = قيمة
    متغير ع = 0
    بينما (ع < موضع)
        ق = (ق - (ق % 2)) / 2
        ع = ع + 1
    نهاية
    ارجع ق % 2
نهاية


# ──────────────────────────────────────────────────────────────────────
# التبديل الشرطي: إذا شرط=1 ارجع ب، وإلا ارجع أ
# (بدون تفرع مرئي - مفيد للحماية من هجمات القنوات الجانبية)
# ──────────────────────────────────────────────────────────────────────
دالة رقم اختيار_شرطي(رقم أ، رقم ب، رقم شرط)
    # mask = -شرط (إذا شرط=1 فالقناع = -1 = كل البتات 1)
    # result = أ XOR (mask AND (أ XOR ب))
    # تبسيط: إذا شرط=0 نرجع أ، إذا شرط=1 نرجع ب
    اذا (شرط == 1)
        ارجع ب
    نهاية
    ارجع أ
نهاية


