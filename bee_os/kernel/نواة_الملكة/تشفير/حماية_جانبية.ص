# حجم قناع التعمية (بايت)
ثابت حجم_قناع_تعمية = 32

# حد أقصى لعدد المحاولات في عمليات التعمية
ثابت أقصى_محاولات_تعمية = 10

# أنواع حواجز الحماية
ثابت حاجز_LFENCE = 1         # حاجز تحميل
ثابت حاجز_MFENCE = 2         # حاجز ذاكرة كامل
ثابت حاجز_مضارب = 3          # حاجز تنبؤ الفروع

# مستويات الحماية
ثابت مستوى_أساسي = 1         # حماية أساسية (ثابت الوقت فقط)
ثابت مستوى_متوسط = 2        # + تعمية + حواجز
