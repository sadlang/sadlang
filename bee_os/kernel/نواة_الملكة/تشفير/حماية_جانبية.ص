# ══════════════════════════════════════════════════════════════════════════════
#                     دوال بتّية مساعدة
# ══════════════════════════════════════════════════════════════════════════════

دالة رقم حج_حصأو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 != ب2)
            نتيجة = نتيجة + قيمة_بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

دالة رقم حج_حصو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 == 1)
            اذا (ب2 == 1)
                نتيجة = نتيجة + قيمة_بت
            نهاية
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# NOT
دالة رقم حج_قلب(رقم أ)
    ارجع حج_حصأو(أ، 4294967295)
نهاية

# اختيار شرطي ثابت الوقت: اذا شرط==1 اختر أ، والا اختر ب
دالة رقم حج_اختيار(رقم شرط، رقم أ، رقم ب)
    # قناع = شرط == 1 ? 0xFFFFFFFF : 0x00000000
    متغير قناع = 0 - شرط    # 0 → 0، 1 → -1 = 0xFFFFFFFF
    اذا (قناع < 0)
        قناع = 4294967295
    نهاية
    # result = (a & mask) | (b & ~mask)
    ارجع حج_حصأو(حج_حصو(أ، قناع)، حج_حصو(ب، حج_قلب(قناع)))
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     صنف مولد عشوائية التعمية
# ══════════════════════════════════════════════════════════════════════════════

صنف مولد_تعمية
    ## مولد عشوائي بسيط خاص بعمليات التعمية

    رقم وضع0
    رقم وضع1
    رقم عداد

    باني()
        وضع0 = 123456789
        وضع1 = 362436069
        عداد = 0
    نهاية

    دالة بذر(رقم بذرة)
        وضع0 = بذرة * 2654435761
        اذا (وضع0 < 0)
            وضع0 = وضع0 * (-1)
        نهاية
        وضع1 = بذرة * 2246822519
        اذا (وضع1 < 0)
            وضع1 = وضع1 * (-1)
        نهاية
        اذا (وضع0 == 0)
            وضع0 = 1
        نهاية
        اذا (وضع1 == 0)
            وضع1 = 1
        نهاية
        عداد = 0
    نهاية

    دالة رقم التالي()
        وضع0 = وضع0 * 1103515245 + 12345
        وضع0 = وضع0 - (وضع0 / 4294967296) * 4294967296
        اذا (وضع0 < 0)
            وضع0 = وضع0 * (-1)
        نهاية
        وضع1 = وضع1 * 1664525 + 1013904223
        وضع1 = وضع1 - (وضع1 / 4294967296) * 4294967296
        اذا (وضع1 < 0)
            وضع1 = وضع1 * (-1)
        نهاية

        عداد = عداد + 1
        ارجع حج_حصأو(وضع0، وضع1) % 4294967296
    نهاية

    دالة رقم بايت_تالي()
        ارجع التالي() % 256
    نهاية

    دالة مصفوفة بايتات(رقم عدد_م)
        متغير النتيجة = []
        متغير ف = 0
        بينما (ف < عدد_م)
            النتيجة += [بايت_تالي()]
            ف = ف + 1
        نهاية
        ارجع النتيجة
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف مدير التعمية (Blinding Manager)
# ══════════════════════════════════════════════════════════════════════════════

صنف مدير_التعمية
    ## يدير أقنعة التعمية للعمليات التشفيرية
    ## التعمية: تحويل المدخل x إلى x' = x ⊕ r (حيث r عشوائي)
    ## ثم تحويل النتيجة من y' إلى y = y' ⊕ r'

    مولد_تعمية المولد         # مولد الأقنعة
    مصفوفة القناع_الحالي      # القناع الحالي
    رقم مُهيّأ                # هل مُهيّأ؟
    رقم عداد_التعميات        # عدد مرات التعمية

    باني()
        المولد = جديد مولد_تعمية()
        القناع_الحالي = []
        مُهيّأ = 0
        عداد_التعميات = 0
    نهاية

    # تهيئة مع بذرة
    دالة تهيئة(رقم بذرة)
        المولد.بذر(بذرة)
        تجديد_القناع()
        مُهيّأ = 1
    نهاية

    # توليد قناع جديد
    دالة تجديد_القناع()
        القناع_الحالي = المولد.بايتات(حجم_قناع_تعمية)
    نهاية

    # تعمية مصفوفة بايتات (XOR مع القناع)
    دالة مصفوفة عمّي(مصفوفة البيانات)
        متغير النتيجة = []
        متغير ف = 0
        بينما (ف < عدد البيانات)
            متغير فهرس_قناع = ف % حجم_قناع_تعمية
            النتيجة += [حج_حصأو(البيانات[ف]، القناع_الحالي[فهرس_قناع]) % 256]
            ف = ف + 1
        نهاية
        عداد_التعميات = عداد_التعميات + 1
        ارجع النتيجة
    نهاية

    # إزالة التعمية (نفس العملية: XOR مرتين = الأصل)
    دالة مصفوفة أزل_التعمية(مصفوفة البيانات)
        ارجع عمّي(البيانات)    # XOR مع نفس القناع يعيد الأصل
    نهاية

    # تعمية مع تجديد القناع
    دالة مصفوفة عمّي_وجدّد(مصفوفة البيانات)
        متغير النتيجة = عمّي(البيانات)
        تجديد_القناع()
        ارجع النتيجة
    نهاية

    # تعمية عدد (32 بت)
    دالة رقم عمّي_عدد(رقم القيمة)
        متغير ق0 = القناع_الحالي[0]
        متغير ق1 = القناع_الحالي[1]
        متغير ق2 = القناع_الحالي[2]
        متغير ق3 = القناع_الحالي[3]
        متغير قناع_32 = ق0 + ق1 * 256 + ق2 * 65536 + ق3 * 16777216
        ارجع حج_حصأو(القيمة، قناع_32)
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف حارس الذاكرة المخبأة (Cache Guard)
# ══════════════════════════════════════════════════════════════════════════════

صنف حارس_الذاكرة_المخبأة
    ## حماية ضد هجمات الذاكرة المخبأة
    ##
    ## تقنيات:
    ## 1. إزاحة عشوائية لعناوين الوصول
    ## 2. الوصول الوهمي (Dummy Access) لتمويه النمط
    ## 3. تنظيف خطوط الكاش بعد العمليات الحساسة
    ## 4. تقسيم البيانات عبر خطوط كاش متعددة

    مولد_تعمية المولد
    رقم حجم_خط_الكاش          # عادة 64 بايت
    رقم عدد_الوصولات_الوهمية  # عدد الوصولات الإضافية

    باني()
        المولد = جديد مولد_تعمية()
        حجم_خط_الكاش = 64
        عدد_الوصولات_الوهمية = 4
    نهاية

    دالة تهيئة(رقم بذرة)
        المولد.بذر(بذرة)
    نهاية

    # وصول آمن لمصفوفة بايتات (يقرأ كل العناصر لإخفاء العنصر المطلوب)
    # يقرأ كل العناصر دائماً بغض النظر عن الفهرس المطلوب
    دالة رقم وصول_آمن(مصفوفة البيانات، رقم الفهرس)
        متغير النتيجة = 0
        متغير ف = 0
        بينما (ف < عدد البيانات)
            # مقارنة ثابتة الوقت
            متغير متطابق = 0
            اذا (ف == الفهرس)
                متطابق = 1
            نهاية
            # اختيار ثابت الوقت
            النتيجة = حج_اختيار(متطابق، البيانات[ف]، النتيجة)
            ف = ف + 1
        نهاية
        ارجع النتيجة
    نهاية

    # كتابة آمنة (تكتب في كل المواقع لإخفاء الموقع الحقيقي)
    دالة كتابة_آمنة(مصفوفة البيانات، رقم الفهرس، رقم القيمة)
        متغير ف = 0
        بينما (ف < عدد البيانات)
            متغير متطابق = 0
            اذا (ف == الفهرس)
                متطابق = 1
            نهاية
            البيانات[ف] = حج_اختيار(متطابق، القيمة، البيانات[ف])
            ف = ف + 1
        نهاية
    نهاية

    # وصول بترتيب عشوائي (يخفي نمط الوصول)
    دالة مصفوفة وصول_مبعثر(مصفوفة البيانات)
        # إنشاء ترتيب عشوائي (Fisher-Yates)
        متغير الفهارس = []
        متغير ف = 0
        بينما (ف < عدد البيانات)
            الفهارس += [ف]
            ف = ف + 1
        نهاية

        # خلط عشوائي
        ف = عدد البيانات - 1
        بينما (ف > 0)
            متغير ج = المولد.التالي() % (ف + 1)
            # تبديل
            متغير مؤقت = الفهارس[ف]
            الفهارس[ف] = الفهارس[ج]
            الفهارس[ج] = مؤقت
            ف = ف - 1
        نهاية

        # قراءة بالترتيب العشوائي
        متغير النتيجة = []
        ف = 0
        بينما (ف < عدد البيانات)
            النتيجة += [البيانات[الفهارس[ف]]]
            ف = ف + 1
        نهاية
        ارجع النتيجة
    نهاية

    # تقسيم قيمة حساسة إلى حصص (Secret Sharing)
    # القيمة = حصة1 ⊕ حصة2 ⊕ حصة3
    دالة مصفوفة قسّم_إلى_حصص(رقم القيمة، رقم عدد_الحصص)
        متغير الحصص = []
        متغير مجموع_حصأو = 0
        متغير ف = 0
        بينما (ف < عدد_الحصص - 1)
            متغير حصة = المولد.التالي()
            الحصص += [حصة]
            مجموع_حصأو = حج_حصأو(مجموع_حصأو، حصة)
            ف = ف + 1
        نهاية
        # الحصة الأخيرة = القيمة ⊕ مجموع الحصص الأخرى
        الحصص += [حج_حصأو(القيمة، مجموع_حصأو)]
        ارجع الحصص
    نهاية

    # إعادة تجميع الحصص
    دالة رقم اجمع_الحصص(مصفوفة الحصص)
        متغير النتيجة = 0
        متغير ف = 0
        بينما (ف < عدد الحصص)
            النتيجة = حج_حصأو(النتيجة، الحصص[ف])
            ف = ف + 1
        نهاية
        ارجع النتيجة
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف حارس التنفيذ التخميني (Spectre Guard)
# ══════════════════════════════════════════════════════════════════════════════

صنف حارس_التخمين
    ## حماية ضد هجمات Spectre

    رقم عداد_الحواجز       # عدد الحواجز المُدرَجة

    باني()
        عداد_الحواجز = 0
    نهاية

    # حاجز LFENCE (يمنع التنفيذ التخميني عبر حدود التحميل)
    # في التنفيذ الحقيقي: LFENCE (0F AE E8)
    دالة حاجز_تحميل()
        # محاكاة: عملية تأخير دائرية
        متغير مؤقت = 0
        متغير ف = 0
        بينما (ف < 16)
            مؤقت = مؤقت + 1
            ف = ف + 1
        نهاية
        عداد_الحواجز = عداد_الحواجز + 1
    نهاية

    # حاجز MFENCE (حاجز ذاكرة كامل)
    دالة حاجز_ذاكرة()
        متغير مؤقت = 0
        متغير ف = 0
        بينما (ف < 32)
            مؤقت = مؤقت + ف
            ف = ف + 1
        نهاية
        عداد_الحواجز = عداد_الحواجز + 1
    نهاية

    # فحص حدود آمن ضد Spectre v1
    # بدلاً من: اذا (فهرس < حجم) ... ← عرضة لـ Spectre
    # نستخدم: فحص + حاجز + قناع
    دالة رقم فهرس_آمن(رقم الفهرس، رقم الحجم)
        حاجز_تحميل()  # منع التخمين

        # قناع ثابت الوقت: إذا الفهرس خارج الحدود → 0
        متغير داخل_الحدود = 0
        اذا (الفهرس >= 0)
            اذا (الفهرس < الحجم)
                داخل_الحدود = 1
            نهاية
        نهاية

        # إرجاع 0 إذا خارج الحدود (بدون فرع)
        ارجع حج_اختيار(داخل_الحدود، الفهرس، 0)
    نهاية

    # وصول آمن لمصفوفة مع حماية Spectre
    دالة رقم وصول_محمي(مصفوفة البيانات، رقم الفهرس)
        متغير فهرس_آمن_م = فهرس_آمن(الفهرس، عدد البيانات)
        حاجز_تحميل()
        ارجع البيانات[فهرس_آمن_م]
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف مُنظِّف الحساسات (Sensitive Data Cleaner)
# ══════════════════════════════════════════════════════════════════════════════

صنف منظّف_الحساسات
    ## ينظف البيانات الحساسة بعد الاستخدام
    ## يمنع تسرب المفاتيح عبر سجلات المعالج أو الذاكرة المخبأة

    رقم عداد_التنظيفات

    باني()
        عداد_التنظيفات = 0
    نهاية

    # مسح مصفوفة (4 تمريرات)
    دالة مسح_مصفوفة(مصفوفة البيانات)
        # تمرير 1: أصفار
        متغير ف = 0
        بينما (ف < عدد البيانات)
            البيانات[ف] = 0
            ف = ف + 1
        نهاية

        # تمرير 2: واحدات
        ف = 0
        بينما (ف < عدد البيانات)
            البيانات[ف] = 255
            ف = ف + 1
        نهاية

        # تمرير 3: نمط متبادل
        ف = 0
        بينما (ف < عدد البيانات)
            اذا (ف % 2 == 0)
                البيانات[ف] = 170    # 10101010
            والا
                البيانات[ف] = 85     # 01010101
            نهاية
            ف = ف + 1
        نهاية

        # تمرير 4: أصفار نهائي
        ف = 0
        بينما (ف < عدد البيانات)
            البيانات[ف] = 0
            ف = ف + 1
        نهاية

        عداد_التنظيفات = عداد_التنظيفات + 1
    نهاية

    # مسح مع تحقق
    دالة منطقي مسح_متحقق(مصفوفة البيانات)
        مسح_مصفوفة(البيانات)

        # التحقق من أن كل شيء أصفار
        متغير غير_صفري = 0
        متغير ف = 0
        بينما (ف < عدد البيانات)
            اذا (البيانات[ف] != 0)
                غير_صفري = غير_صفري + 1
            نهاية
            ف = ف + 1
        نهاية

        ارجع غير_صفري == 0
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف حارس التوقيت (Timing Guard)
# ══════════════════════════════════════════════════════════════════════════════

صنف حارس_التوقيت
    ## يضيف تأخيراً عشوائياً لإخفاء توقيت العمليات الحقيقي

    مولد_تعمية المولد
    رقم أقل_تأخير               # أقل تأخير (حلقات)
    رقم أقصى_تأخير              # أقصى تأخير (حلقات)

    باني()
        المولد = جديد مولد_تعمية()
        أقل_تأخير = 10
        أقصى_تأخير = 100
    نهاية

    دالة تهيئة(رقم بذرة، رقم أدنى، رقم أعلى)
        المولد.بذر(بذرة)
        أقل_تأخير = أدنى
        أقصى_تأخير = أعلى
    نهاية

    # تأخير عشوائي
    دالة تأخير_عشوائي()
        متغير نطاق = أقصى_تأخير - أقل_تأخير
        متغير تأخير = أقل_تأخير
        اذا (نطاق > 0)
            تأخير = أقل_تأخير + (المولد.التالي() % نطاق)
        نهاية

        # حلقة تأخير (لا يمكن للمترجم حذفها لأن النتيجة تُستخدم)
        متغير مؤقت = 1
        متغير ف = 0
        بينما (ف < تأخير)
            مؤقت = مؤقت * 3 + 1
            مؤقت = مؤقت - (مؤقت / 1000000007) * 1000000007
            ف = ف + 1
        نهاية
    نهاية

    # تأخير ثابت (لتوحيد وقت العمليات)
    دالة تأخير_ثابت(رقم الحلقات)
        متغير مؤقت = 1
        متغير ف = 0
        بينما (ف < الحلقات)
            مؤقت = مؤقت * 3 + 1
            مؤقت = مؤقت - (مؤقت / 1000000007) * 1000000007
            ف = ف + 1
        نهاية
    نهاية
