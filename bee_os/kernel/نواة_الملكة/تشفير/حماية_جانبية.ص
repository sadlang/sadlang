صنف نظام_الحماية_الجانبية
    ## النظام المركزي للحماية ضد الهجمات الجانبية

    مدير_التعمية التعمية               # مدير التعمية
    حارس_الذاكرة_المخبأة الكاش         # حارس الكاش
    حارس_التخمين المضارب               # حارس التخمين
    منظّف_الحساسات المنظّف             # منظف البيانات
    حارس_التوقيت التوقيت               # حارس التوقيت
    رقم مستوى_الحماية                   # المستوى الحالي
    رقم مُهيّأ                          # هل النظام مهيأ؟

    باني()
        التعمية = جديد مدير_التعمية()
        الكاش = جديد حارس_الذاكرة_المخبأة()
        المضارب = جديد حارس_التخمين()
        المنظّف = جديد منظّف_الحساسات()
        التوقيت = جديد حارس_التوقيت()
        مستوى_الحماية = مستوى_أساسي
        مُهيّأ = 0
    نهاية

    # تهيئة مع مستوى حماية
    دالة تهيئة(رقم المستوى، رقم بذرة)
        مستوى_الحماية = المستوى
        التعمية.تهيئة(بذرة)
        الكاش.تهيئة(بذرة + 1)
        التوقيت.تهيئة(بذرة + 2، 10، 100)
        مُهيّأ = 1
        اطبع("  نظام الحماية الجانبية: مُهيّأ بمستوى ")
        اطبع_سطر(المستوى)
    نهاية

    # عملية تشفير محمية (تحيط بالعملية بالحماية)
    دالة مصفوفة عملية_محمية(مصفوفة البيانات)
        اذا (مُهيّأ != 1)
            ارجع البيانات
        نهاية

        # قبل العملية
        اذا (مستوى_الحماية >= مستوى_متوسط)
            المضارب.حاجز_تحميل()
            التوقيت.تأخير_عشوائي()
        نهاية

        # تعمية المدخل
        متغير معمّى = التعمية.عمّي(البيانات)

        # إزالة التعمية (في التنفيذ الحقيقي: العملية تتم على البيانات المعمّاة)
        متغير النتيجة = التعمية.أزل_التعمية(معمّى)

        # بعد العملية
        اذا (مستوى_الحماية >= مستوى_عالي)
            المنظّف.مسح_مصفوفة(معمّى)
            المضارب.حاجز_ذاكرة()
            التوقيت.تأخير_عشوائي()
        نهاية

        ارجع النتيجة
    نهاية

    # وصول آمن لمصفوفة
    دالة رقم وصول_آمن(مصفوفة البيانات، رقم الفهرس)
        اذا (مستوى_الحماية >= مستوى_متوسط)
            ارجع الكاش.وصول_آمن(البيانات، الفهرس)
        نهاية
        اذا (الفهرس >= 0)
            اذا (الفهرس < عدد البيانات)
                ارجع البيانات[الفهرس]
            نهاية
        نهاية
        ارجع 0
    نهاية

    # تقسيم سرّ إلى حصص
    دالة مصفوفة قسّم_سر(رقم السر)
        ارجع الكاش.قسّم_إلى_حصص(السر، 3)
    نهاية

    # تجميع حصص
    دالة رقم اجمع_سر(مصفوفة الحصص)
        ارجع الكاش.اجمع_الحصص(الحصص)
    نهاية

    # مسح بيانات حساسة
    دالة مسح_آمن(مصفوفة البيانات)
        المنظّف.مسح_مصفوفة(البيانات)
    نهاية

    # طباعة الوضع
    دالة اطبع_وضع()
        اطبع_سطر("── وضع نظام الحماية الجانبية ──")
        اطبع("  المستوى: ")
        اذا (مستوى_الحماية == مستوى_أساسي)
            اطبع_سطر("أساسي")
        والا_اذا (مستوى_الحماية == مستوى_متوسط)
            اطبع_سطر("متوسط")
        والا
            اطبع_سطر("عالي")
        نهاية
        اطبع("  الحواجز المُدرَجة: ")
        اطبع_سطر(المضارب.عداد_الحواجز)
        اطبع("  التنظيفات: ")
        اطبع_سطر(المنظّف.عداد_التنظيفات)
        اطبع("  التعميات: ")
        اطبع_سطر(التعمية.عداد_التعميات)
    نهاية
نهاية


