# الإقلاع_الآمن.ص - نظام الإقلاع الآمن لنواة النحلة
# T0171
# ══════════════════════════════════════════════════════════════════════════════
#
# نظام التحقق من سلامة الإقلاع (Secure Boot Verification)
#
# سلسلة الإقلاع الآمن:
# ═══════════════════════
# 1. البرنامج الثابت (Firmware/BIOS) → يتحقق من محمّل الإقلاع
# 2. محمّل الإقلاع (Bootloader) → يتحقق من النواة
# 3. النواة (Kernel) → تتحقق من السائقين والوحدات
# 4. كل مكون يجب أن يكون موقّعاً رقمياً
#
# البنية:
# ════════
# ┌─────────────────────┐
# │   جذر الثقة (TPM)   │ ← مفتاح الجذر مخزّن في الأجهزة
# └─────────┬───────────┘
#           │ يتحقق
# ┌─────────▼───────────┐
# │   البرنامج الثابت    │ ← UEFI Secure Boot
# └─────────┬───────────┘
#           │ يتحقق
# ┌─────────▼───────────┐
# │   محمّل الإقلاع      │ ← GRUB/المحمّل الخاص
# └─────────┬───────────┘
#           │ يتحقق
# ┌─────────▼───────────┐
# │      النواة          │ ← beeos32.elf
# └─────────┬───────────┘
#           │ يتحقق
# ┌─────────▼───────────┐
# │   الوحدات/السائقين   │ ← .ko modules
# └─────────────────────┘
#
# الخوارزميات المستخدمة:
# - BLAKE3 للتجزئة (من بليك3.ص)
# - Ed25519 للتوقيع الرقمي (من إي_دي25519.ص)
# - سلسلة شهادات X.509 مبسطة
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
#                           الثوابت
# ══════════════════════════════════════════════════════════════════════════════

# حجم التجزئة (بايت)
ثابت حجم_التجزئة = 32

# حجم التوقيع (بايت)
ثابت حجم_التوقيع = 64

# حجم المفتاح العام (بايت)
ثابت حجم_المفتاح_العام = 32

# أنواع المكونات في سلسلة الإقلاع
ثابت مكون_ثابت = 1           # البرنامج الثابت (Firmware)
ثابت مكون_محمّل = 2          # محمّل الإقلاع (Bootloader)
ثابت مكون_نواة = 3           # النواة (Kernel)
ثابت مكون_سائق = 4           # سائق (Driver)
ثابت مكون_وحدة = 5           # وحدة نواة (Module)

# نتائج التحقق
ثابت نتيجة_صالح = 0           # التحقق نجح
ثابت نتيجة_تجزئة_فاشلة = 1   # تجزئة غير مطابقة
ثابت نتيجة_توقيع_فاشل = 2   # توقيع غير صالح
ثابت نتيجة_شهادة_منتهية = 3 # شهادة منتهية الصلاحية
ثابت نتيجة_سلسلة_مكسورة = 4 # سلسلة الثقة مكسورة
ثابت نتيجة_مفتاح_مرفوض = 5  # مفتاح في قائمة الحظر
ثابت نتيجة_غير_معروف = 6     # خطأ غير معروف

# حالة الإقلاع
ثابت إقلاع_آمن = 1            # إقلاع آمن بالكامل
ثابت إقلاع_تحذير = 2         # إقلاع مع تحذيرات
ثابت إقلاع_مرفوض = 3         # رفض الإقلاع
ثابت إقلاع_معطل = 4          # الإقلاع الآمن معطل

# سياسات التعامل مع الفشل
ثابت سياسة_صارمة = 1          # رفض أي فشل
ثابت سياسة_تحذير = 2         # تحذير فقط
ثابت سياسة_تسجيل = 3         # تسجيل وإكمال


# ══════════════════════════════════════════════════════════════════════════════
#                      دوال تجزئة مبسطة
# ══════════════════════════════════════════════════════════════════════════════

# تجزئة بسيطة (محاكاة BLAKE3)
دالة مصفوفة إق_تجزئة(مصفوفة البيانات)
    متغير ح0 = 1779033703
    متغير ح1 = 3144134277
    متغير ح2 = 1013904242
    متغير ح3 = 2773480762
    متغير ح4 = 1359893119
    متغير ح5 = 2600822924
    متغير ح6 = 528734635
    متغير ح7 = 1541459225

    متغير ف = 0
    بينما (ف < عدد البيانات)
        متغير ب = البيانات[ف]
        ح0 = (ح0 + ب * 2654435761) % 4294967296
        ح1 = (ح1 + ب * 2246822519 + ح0) % 4294967296
        ح2 = (ح2 + ب * 3266489917 + ح1) % 4294967296
        ح3 = (ح3 + ب * 668265263 + ح2) % 4294967296
        ح4 = (ح4 + ب * 374761393 + ح3) % 4294967296
        ح5 = (ح5 + ب * 1103515245 + ح4) % 4294967296
        ح6 = (ح6 + ب * 1664525 + ح5) % 4294967296
        ح7 = (ح7 + ب * 1013904223 + ح6) % 4294967296
        ف = ف + 1
    نهاية

    # تحويل إلى 32 بايت
    متغير النتيجة = []
    متغير قيم = [ح0، ح1، ح2، ح3، ح4، ح5، ح6، ح7]
    متغير ق = 0
    بينما (ق < 8)
        متغير ر = قيم[ق]
        اذا (ر < 0)
            ر = ر * (-1)
        نهاية
        النتيجة += [ر % 256]
        النتيجة += [(ر / 256) % 256]
        النتيجة += [(ر / 65536) % 256]
        النتيجة += [(ر / 16777216) % 256]
        ق = ق + 1
    نهاية
    ارجع النتيجة
نهاية

# مقارنة تجزئتين (ثابتة الوقت)
دالة منطقي إق_مقارنة_تجزئة(مصفوفة أ، مصفوفة ب)
    اذا (عدد أ != عدد ب)
        ارجع خطأ
    نهاية
    متغير فرق = 0
    متغير ف = 0
    بينما (ف < عدد أ)
        متغير د = أ[ف] - ب[ف]
        اذا (د < 0)
            د = د * (-1)
        نهاية
        فرق = فرق + د
        ف = ف + 1
    نهاية
    ارجع فرق == 0
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف بصمة المكون (Component Fingerprint)
# ══════════════════════════════════════════════════════════════════════════════

صنف بصمة_مكون
    ## بصمة رقمية لمكون إقلاع

    نص الاسم                   # اسم المكون
    رقم النوع                  # نوع المكون (مكون_*)
    مصفوفة التجزئة            # تجزئة BLAKE3 (32 بايت)
    مصفوفة التوقيع            # توقيع Ed25519 (64 بايت)
    رقم الإصدار               # رقم الإصدار
    رقم الطابع_الزمني         # وقت التوقيع
    رقم الحالة                 # حالة التحقق (نتيجة_*)

    باني(نص اسم، رقم نوع)
        الاسم = اسم
        النوع = نوع
        التجزئة = []
        التوقيع = []
        الإصدار = 1
        الطابع_الزمني = 0
        الحالة = نتيجة_غير_معروف
    نهاية

    # حساب التجزئة من البيانات
    دالة احسب_التجزئة(مصفوفة البيانات)
        التجزئة = إق_تجزئة(البيانات)
    نهاية

    # تعيين التوقيع
    دالة عيّن_التوقيع(مصفوفة توقيع، رقم طابع)
        التوقيع = توقيع
        الطابع_الزمني = طابع
    نهاية

    # هل مُوقَّع؟
    دالة منطقي موقّع()
        ارجع عدد التوقيع > 0
    نهاية

    # طباعة معلومات
    دالة اطبع_معلومات()
        اطبع("  المكون: ")
        اطبع(الاسم)
        اطبع(" | النوع: ")
        اذا (النوع == مكون_ثابت)
            اطبع("ثابت")
        والا_اذا (النوع == مكون_محمّل)
            اطبع("محمّل")
        والا_اذا (النوع == مكون_نواة)
            اطبع("نواة")
        والا_اذا (النوع == مكون_سائق)
            اطبع("سائق")
        والا
            اطبع("وحدة")
        نهاية
        اطبع(" | الإصدار: ")
        اطبع(الإصدار)
        اطبع(" | الحالة: ")
        اذا (الحالة == نتيجة_صالح)
            اطبع_سطر("✓ صالح")
        والا_اذا (الحالة == نتيجة_تجزئة_فاشلة)
            اطبع_سطر("✗ تجزئة فاشلة")
        والا_اذا (الحالة == نتيجة_توقيع_فاشل)
            اطبع_سطر("✗ توقيع فاشل")
        والا
            اطبع_سطر("? غير معروف")
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف مفتاح التحقق (Verification Key)
# ══════════════════════════════════════════════════════════════════════════════

صنف مفتاح_تحقق
    ## يمثل مفتاح عام للتحقق من التوقيعات

    نص المعرّف                 # معرّف فريد للمفتاح
    مصفوفة المفتاح_العام      # المفتاح العام (32 بايت)
    رقم الصلاحية_من           # بداية الصلاحية
    رقم الصلاحية_إلى          # نهاية الصلاحية
    رقم النوع_المسموح         # نوع المكون المسموح توقيعه
    منطقي نشط                 # هل المفتاح نشط؟
    منطقي جذر                 # هل مفتاح جذر؟

    باني(نص معرّف)
        المعرّف = معرّف
        المفتاح_العام = []
        الصلاحية_من = 0
        الصلاحية_إلى = 999999999
        النوع_المسموح = 0
        نشط = صحيح
        جذر = خطأ
    نهاية

    # تعيين المفتاح العام
    دالة عيّن_مفتاح(مصفوفة مفتاح)
        المفتاح_العام = مفتاح
    نهاية

    # تعيين فترة الصلاحية
    دالة عيّن_صلاحية(رقم بداية، رقم نهاية_ص)
        الصلاحية_من = بداية
        الصلاحية_إلى = نهاية_ص
    نهاية

    # هل صالح في الوقت الحالي؟
    دالة منطقي صالح_الآن(رقم الوقت_الحالي)
        اذا (نشط != صحيح)
            ارجع خطأ
        نهاية
        اذا (الوقت_الحالي < الصلاحية_من)
            ارجع خطأ
        نهاية
        اذا (الوقت_الحالي > الصلاحية_إلى)
            ارجع خطأ
        نهاية
        ارجع صحيح
    نهاية

    # هل مسموح بتوقيع هذا النوع؟
    دالة منطقي مسموح_للنوع(رقم نوع_المكون)
        اذا (جذر)
            ارجع صحيح
        نهاية
        اذا (النوع_المسموح == 0)
            ارجع صحيح
        نهاية
        ارجع النوع_المسموح == نوع_المكون
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف قائمة الحظر (Revocation List)
# ══════════════════════════════════════════════════════════════════════════════

صنف قائمة_الحظر
    ## قائمة المفاتيح والتجزئات المحظورة

    مصفوفة مفاتيح_محظورة     # معرّفات مفاتيح محظورة
    مصفوفة تجزئات_محظورة     # تجزئات مكونات محظورة
    رقم العدد                  # عدد العناصر المحظورة

    باني()
        مفاتيح_محظورة = []
        تجزئات_محظورة = []
        العدد = 0
    نهاية

    # إضافة مفتاح للحظر
    دالة احظر_مفتاح(نص معرّف)
        مفاتيح_محظورة += [معرّف]
        العدد = العدد + 1
    نهاية

    # إضافة تجزئة للحظر
    دالة احظر_تجزئة(مصفوفة تجزئة)
        تجزئات_محظورة += [تجزئة]
        العدد = العدد + 1
    نهاية

    # هل المفتاح محظور؟
    دالة منطقي مفتاح_محظور(نص معرّف)
        متغير ف = 0
        بينما (ف < عدد مفاتيح_محظورة)
            اذا (مفاتيح_محظورة[ف] == معرّف)
                ارجع صحيح
            نهاية
            ف = ف + 1
        نهاية
        ارجع خطأ
    نهاية

    # هل التجزئة محظورة؟
    دالة منطقي تجزئة_محظورة(مصفوفة تجزئة)
        متغير ف = 0
        بينما (ف < عدد تجزئات_محظورة)
            اذا (إق_مقارنة_تجزئة(تجزئات_محظورة[ف]، تجزئة))
                ارجع صحيح
            نهاية
            ف = ف + 1
        نهاية
        ارجع خطأ
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف سجل القياسات (Measurement Log)
# ══════════════════════════════════════════════════════════════════════════════

صنف إدخال_قياس
    ## إدخال واحد في سجل القياسات

    رقم الرقم_التسلسلي
    نص اسم_المكون
    رقم نوع_المكون
    مصفوفة التجزئة
    رقم النتيجة
    رقم الطابع_الزمني

    باني(رقم رقم، نص اسم، رقم نوع)
        الرقم_التسلسلي = رقم
        اسم_المكون = اسم
        نوع_المكون = نوع
        التجزئة = []
        النتيجة = نتيجة_غير_معروف
        الطابع_الزمني = 0
    نهاية
نهاية

صنف سجل_القياسات
    ## يسجل كل عملية تحقق أثناء الإقلاع (مشابه لـ TPM PCR)

    مصفوفة الإدخالات          # قائمة إدخالات القياس
    رقم العداد                 # عداد تسلسلي
    مصفوفة القيمة_التراكمية  # قيمة PCR التراكمية (32 بايت)

    باني()
        الإدخالات = []
        العداد = 0
        # تهيئة القيمة التراكمية بأصفار
        القيمة_التراكمية = []
        متغير ف = 0
        بينما (ف < 32)
            القيمة_التراكمية += [0]
            ف = ف + 1
        نهاية
    نهاية

    # تمديد القيمة التراكمية: PCR_new = Hash(PCR_old || measurement)
    دالة مدّد(مصفوفة القياس)
        متغير مُدخل = []
        # إضافة القيمة التراكمية الحالية
        متغير ف = 0
        بينما (ف < عدد القيمة_التراكمية)
            مُدخل += [القيمة_التراكمية[ف]]
            ف = ف + 1
        نهاية
        # إضافة القياس الجديد
        ف = 0
        بينما (ف < عدد القياس)
            مُدخل += [القياس[ف]]
            ف = ف + 1
        نهاية
        # حساب التجزئة الجديدة
        القيمة_التراكمية = إق_تجزئة(مُدخل)
    نهاية

    # تسجيل قياس جديد
    دالة سجّل(نص اسم، رقم نوع، مصفوفة تجزئة، رقم نتيجة)
        العداد = العداد + 1
        متغير إدخال = جديد إدخال_قياس(العداد، اسم، نوع)
        إدخال.التجزئة = تجزئة
        إدخال.النتيجة = نتيجة
        إدخال.الطابع_الزمني = العداد * 1000
        الإدخالات += [إدخال]
        # تمديد القيمة التراكمية
        مدّد(تجزئة)
    نهاية

    # طباعة السجل
    دالة اطبع_السجل()
        اطبع_سطر("── سجل قياسات الإقلاع الآمن ──")
        اطبع("  عدد الإدخالات: ")
        اطبع_سطر(العداد)
        متغير ف = 0
        بينما (ف < عدد الإدخالات)
            متغير إدخال = الإدخالات[ف]
            اطبع("  [")
            اطبع(إدخال.الرقم_التسلسلي)
            اطبع("] ")
            اطبع(إدخال.اسم_المكون)
            اطبع(" → ")
            اذا (إدخال.النتيجة == نتيجة_صالح)
                اطبع_سطر("✓ صالح")
            والا_اذا (إدخال.النتيجة == نتيجة_تجزئة_فاشلة)
                اطبع_سطر("✗ تجزئة فاشلة")
            والا_اذا (إدخال.النتيجة == نتيجة_توقيع_فاشل)
                اطبع_سطر("✗ توقيع فاشل")
            والا
                اطبع_سطر("? غير محدد")
            نهاية
            ف = ف + 1
        نهاية
        # طباعة أول 4 بايتات من القيمة التراكمية
        اطبع("  PCR التراكمي: [")
        ف = 0
        بينما (ف < 4)
            اذا (ف < عدد القيمة_التراكمية)
                اطبع(القيمة_التراكمية[ف])
                اذا (ف < 3)
                    اطبع("، ")
                نهاية
            نهاية
            ف = ف + 1
        نهاية
        اطبع_سطر("، ...]")
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف محقق التوقيع المبسط (Signature Verifier)
# ══════════════════════════════════════════════════════════════════════════════

صنف محقق_توقيع_إقلاع
    ## يتحقق من التوقيعات الرقمية للمكونات
    ## في التنفيذ الحقيقي: يستخدم Ed25519 من إي_دي25519.ص

    مصفوفة المفاتيح           # قائمة مفاتيح التحقق
    قائمة_الحظر الحظر        # قائمة الحظر

    باني()
        المفاتيح = []
        الحظر = جديد قائمة_الحظر()
    نهاية

    # إضافة مفتاح تحقق
    دالة أضف_مفتاح(مفتاح_تحقق المفتاح)
        المفاتيح += [المفتاح]
    نهاية

    # البحث عن مفتاح بمعرّفه
    دالة مفتاح_تحقق ابحث_عن_مفتاح(نص معرّف)
        متغير ف = 0
        بينما (ف < عدد المفاتيح)
            اذا (المفاتيح[ف].المعرّف == معرّف)
                ارجع المفاتيح[ف]
            نهاية
            ف = ف + 1
        نهاية
        # لم يُوجد — نرجع أول مفتاح (احتياطي)
        اذا (عدد المفاتيح > 0)
            ارجع المفاتيح[0]
        نهاية
        # لا مفاتيح
        متغير فارغ = جديد مفتاح_تحقق("فارغ")
        فارغ.نشط = خطأ
        ارجع فارغ
    نهاية

    # التحقق من توقيع مكون
    # محاكاة: يتحقق أن التوقيع = Hash(بيانات || مفتاح) بتبسيط
    دالة رقم تحقق(بصمة_مكون البصمة، نص معرّف_المفتاح، رقم الوقت)
        # التحقق من قائمة الحظر
        اذا (الحظر.مفتاح_محظور(معرّف_المفتاح))
            ارجع نتيجة_مفتاح_مرفوض
        نهاية

