# ══════════════════════════════════════════════════════════════════════════════
#                     صنف محرك التشفير TPM
# ══════════════════════════════════════════════════════════════════════════════

صنف محرك_تشفير_TPM
    ## معالج العمليات التشفيرية داخل TPM

    مصفوفة المفاتيح_المخزنة
    رقم عدّاد_المفاتيح

    باني()
        المفاتيح_المخزنة = []
        عدّاد_المفاتيح = 0
    نهاية

    # إنشاء مفتاح
    دالة مفتاح_TPM أنشئ_مفتاح(نص المعرّف، رقم النوع، رقم الحجم، رقم بذرة)
        متغير م = جديد مفتاح_TPM(المعرّف، النوع)
        م.ولّد(الحجم، بذرة + عدّاد_المفاتيح)
        المفاتيح_المخزنة += [م]
        عدّاد_المفاتيح = عدّاد_المفاتيح + 1
        ارجع م
    نهاية

    # البحث عن مفتاح
    دالة مفتاح_TPM ابحث_عن_مفتاح(نص المعرّف)
        متغير ف = 0
        بينما (ف < عدد المفاتيح_المخزنة)
            اذا (المفاتيح_المخزنة[ف].المعرّف == المعرّف)
                ارجع المفاتيح_المخزنة[ف]
            نهاية
            ف = ف + 1
        نهاية
        ارجع 0
    نهاية

    # التوقيع
    دالة مصفوفة وقّع(نص معرّف_المفتاح، مصفوفة البيانات)
        متغير م = ابحث_عن_مفتاح(معرّف_المفتاح)
        اذا (م == 0)
            ارجع []
        نهاية

        # توقيع = Hash(private_key || data)
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد م.المادة_الخاصة)
            مدخل += [م.المادة_الخاصة[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد البيانات)
            مدخل += [البيانات[ف]]
            ف = ف + 1
        نهاية
        ارجع تجزئة_TPM(مدخل)
    نهاية

    # التحقق من التوقيع
    دالة منطقي تحقق(نص معرّف_المفتاح، مصفوفة البيانات، مصفوفة التوقيع)
        متغير توقيع_م = وقّع(معرّف_المفتاح، البيانات)
        اذا (عدد توقيع_م == 0)
            ارجع خطأ
        نهاية
        ارجع TPM_مقارنة_بايت(توقيع_م، التوقيع)
    نهاية

    # الختم (Seal) — يشفّر بيانات ويربطها بسجلات PCR
    دالة مصفوفة اختم(نص معرّف_المفتاح، مصفوفة البيانات، مصفوفة قيم_PCR)
        متغير م = ابحث_عن_مفتاح(معرّف_المفتاح)
        اذا (م == 0)
            ارجع []
        نهاية

        # مفتاح الختم = Hash(private_key || PCR_values)
        متغير مدخل_مفتاح = []
        متغير ف = 0
        بينما (ف < عدد م.المادة_الخاصة)
            مدخل_مفتاح += [م.المادة_الخاصة[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد قيم_PCR)
            مدخل_مفتاح += [قيم_PCR[ف]]
            ف = ف + 1
        نهاية
        متغير مفتاح_ختم = تجزئة_TPM(مدخل_مفتاح)

        # XOR encryption
        متغير مختوم = []
        ف = 0
        بينما (ف < عدد البيانات)
            مختوم += [TPM_حصأو(البيانات[ف]، مفتاح_ختم[ف % عدد مفتاح_ختم])]
            ف = ف + 1
        نهاية
        ارجع مختوم
    نهاية

    # فتح الختم (Unseal)
    دالة مصفوفة فك_الختم(نص معرّف_المفتاح، مصفوفة المختوم، مصفوفة قيم_PCR_حالية)
        ارجع اختم(معرّف_المفتاح، المختوم، قيم_PCR_حالية)
    نهاية

    # طباعة
    دالة اطبع_مفاتيح()
        اطبع("  مفاتيح TPM: ")
        اطبع_سطر(عدد المفاتيح_المخزنة)
        متغير ف = 0
        بينما (ف < عدد المفاتيح_المخزنة)
            المفاتيح_المخزنة[ف].اطبع_معلومات()
            ف = ف + 1
        نهاية
    نهاية
نهاية


