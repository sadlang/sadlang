        نهاية
        اطبع("  الأوامر المنفذة: ")
        اطبع_سطر(عداد_الأوامر_TPM)
        اطبع("  الجلسات: ")
        اطبع_سطر(عدد الجلسات)
        البنك.اطبع_حالة()
        المحرك.اطبع_مفاتيح()
        التخزين.اطبع_حالة()
    نهاية
نهاية


