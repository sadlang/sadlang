# عدد سجلات PCR
ثابت عدد_سجلات_PCR = 24
ثابت حجم_سجل_PCR = 32

# خوارزميات التجزئة
ثابت خوارزمية_BLAKE3 = 1
ثابت خوارزمية_SHA256 = 2

# أنواع المفاتيح
ثابت TPM_مفتاح_ECC = 1
ثابت TPM_مفتاح_متماثل = 2
ثابت TPM_مفتاح_HMAC = 3

# أنواع الكيانات
ثابت TPM_مالك = 1
ثابت TPM_نطاق = 2
ثابت TPM_منصة = 3
ثابت TPM_قفل = 4

# حالات TPM
ثابت TPM_غير_مهيأ = 0
ثابت TPM_مهيأ = 1
ثابت TPM_مقفل = 2
ثابت TPM_معطل = 3

# أنواع الجلسات
ثابت جلسة_HMAC = 1
ثابت جلسة_سياسة = 2
ثابت جلسة_تدقيق = 3

# أنواع NV
ثابت NV_عادي = 1
ثابت NV_عداد = 2
ثابت NV_بت = 3
ثابت NV_تمديد = 4

# أذونات NV
ثابت NV_قراءة_مالك = 1
ثابت NV_كتابة_مالك = 2
ثابت NV_قراءة_عامة = 4
ثابت NV_كتابة_محدودة = 8

# رموز الاستجابة
ثابت TPM_نجاح = 0
ثابت TPM_فشل = 1
ثابت TPM_غير_مصرح = 2
ثابت TPM_غير_موجود = 3
ثابت TPM_نطاق_خاطئ = 4
ثابت TPM_قيمة_خاطئة = 5


# ══════════════════════════════════════════════════════════════════════════════
#                      دوال التجزئة والمساعدة
# ══════════════════════════════════════════════════════════════════════════════

دالة مصفوفة تجزئة_TPM(مصفوفة البيانات)
    # تجزئة BLAKE3 مبسطة (32 بايت)
    متغير ح = [1779033703، 3144134277، 1013904242، 2773480762، 1359893119، 2600822924، 528734635، 1541459225]
    متغير ف = 0
    بينما (ف < عدد البيانات)
        متغير ب = البيانات[ف]
        متغير ق = 0
        بينما (ق < 8)
            ح[ق] = (ح[ق] + ب * (2654435761 + ق * 1000000007)) % 4294967296
            اذا (ح[ق] < 0)
                ح[ق] = ح[ق] * (-1)
            نهاية
            ق = ق + 1
        نهاية
        ف = ف + 1
    نهاية
    متغير النتيجة = []
    متغير ق2 = 0
    بينما (ق2 < 8)
        متغير ر = ح[ق2]
        النتيجة += [ر % 256]
        النتيجة += [(ر / 256) % 256]
        النتيجة += [(ر / 65536) % 256]
        النتيجة += [(ر / 16777216) % 256]
        ق2 = ق2 + 1
    نهاية
    ارجع النتيجة
نهاية

دالة رقم TPM_حصأو(رقم أ، رقم ب)
    متغير نت = 0
    متغير بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 8)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 != ب2)
            نت = نت + بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        بت = بت * 2
        ع = ع + 1
    نهاية
    ارجع نت
نهاية

دالة منطقي TPM_مقارنة_بايت(مصفوفة أ، مصفوفة ب)
    اذا (عدد أ != عدد ب)
        ارجع خطأ
    نهاية
    متغير فرق = 0
    متغير ف = 0
    بينما (ف < عدد أ)
        فرق = فرق + (أ[ف] - ب[ف])
        اذا (فرق < 0)
            فرق = فرق * (-1)
        نهاية
        ف = ف + 1
    نهاية
    ارجع فرق == 0
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                 صنف سجل PCR (Platform Configuration Register)
# ══════════════════════════════════════════════════════════════════════════════

صنف سجل_TPM_PCR
    ## سجل واحد من سجلات قياس المنصة

    مصفوفة القيمة             # 32 بايت
    رقم الفهرس               # رقم السجل (0-23)
    منطقي مقفل               # مقفل ضد التمديد؟
    رقم عدد_التمديدات        # عدد عمليات التمديد
    رقم آخر_تمديد            # وقت آخر تمديد

    باني(رقم فهرس)
        الفهرس = فهرس
        القيمة = []
        متغير ف = 0
        بينما (ف < حجم_سجل_PCR)
            القيمة += [0]
            ف = ف + 1
        نهاية
        مقفل = خطأ
        عدد_التمديدات = 0
        آخر_تمديد = 0
    نهاية

    # تمديد السجل (PCR Extend)
    دالة رقم مدّد(مصفوفة البيانات، رقم الوقت)
        اذا (مقفل)
            ارجع TPM_فشل
        نهاية

        # PCR_new = Hash(PCR_old || data)
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد القيمة)
            مدخل += [القيمة[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد البيانات)
            مدخل += [البيانات[ف]]
            ف = ف + 1
        نهاية

        القيمة = تجزئة_TPM(مدخل)
        عدد_التمديدات = عدد_التمديدات + 1
        آخر_تمديد = الوقت
        ارجع TPM_نجاح
    نهاية

    # إعادة تعيين
    دالة رقم أعد_تعيين()
        اذا (الفهرس >= 17)
            ارجع TPM_فشل     # PCR 17-23 لا تُعاد
        نهاية
        متغير ف = 0
        بينما (ف < حجم_سجل_PCR)
            القيمة[ف] = 0
            ف = ف + 1
        نهاية
        مقفل = خطأ
        عدد_التمديدات = 0
        ارجع TPM_نجاح
    نهاية

    # قفل السجل
    دالة اقفل()
        مقفل = صحيح
    نهاية

    # هل فارغ؟
    دالة منطقي فارغ()
        متغير ف = 0
        بينما (ف < عدد القيمة)
            اذا (القيمة[ف] != 0)
                ارجع خطأ
            نهاية
            ف = ف + 1
        نهاية
        ارجع صحيح
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     صنف بنك PCR (PCR Bank)
# ══════════════════════════════════════════════════════════════════════════════

صنف بنك_TPM_PCR
    ## مجموعة كاملة من 24 سجل PCR

    مصفوفة السجلات

    باني()
        السجلات = []
        متغير ف = 0
        بينما (ف < عدد_سجلات_PCR)
            السجلات += [جديد سجل_TPM_PCR(ف)]
            ف = ف + 1
        نهاية
    نهاية

    # تمديد سجل
    دالة رقم مدّد(رقم الفهرس، مصفوفة البيانات، رقم الوقت)
        اذا (الفهرس < 0)
            ارجع TPM_نطاق_خاطئ
        نهاية
        اذا (الفهرس >= عدد_سجلات_PCR)
            ارجع TPM_نطاق_خاطئ
        نهاية
        ارجع السجلات[الفهرس].مدّد(البيانات، الوقت)
    نهاية

    # قراءة سجل
    دالة مصفوفة اقرأ(رقم الفهرس)
        اذا (الفهرس < 0)
            ارجع []
        نهاية
        اذا (الفهرس >= عدد_سجلات_PCR)
            ارجع []
        نهاية
        ارجع السجلات[الفهرس].القيمة
    نهاية

    # اقتباس (Quote) مجموعة سجلات
    دالة مصفوفة اقتبس(مصفوفة الفهارس)
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد الفهارس)
            متغير قيم = اقرأ(الفهارس[ف])
            متغير ق = 0
            بينما (ق < عدد قيم)
                مدخل += [قيم[ق]]
                ق = ق + 1
            نهاية
            ف = ف + 1
        نهاية
        ارجع تجزئة_TPM(مدخل)
    نهاية

    # طباعة حالة البنك
    دالة اطبع_حالة()
        اطبع_سطر("  بنك PCR:")
        متغير ف = 0
        بينما (ف < عدد_سجلات_PCR)
            اذا (السجلات[ف].فارغ() == خطأ)
                اطبع("    PCR[")
                اطبع(ف)
                اطبع("] تمديدات=")
                اطبع(السجلات[ف].عدد_التمديدات)
                اذا (السجلات[ف].مقفل)
                    اطبع(" [مقفل]")
                نهاية
                اطبع_سطر("")
            نهاية
            ف = ف + 1
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     صنف مفتاح TPM
# ══════════════════════════════════════════════════════════════════════════════

صنف مفتاح_TPM
    ## مفتاح تشفيري مُدار بواسطة TPM

    نص المعرّف
    رقم النوع
    مصفوفة المادة_العامة       # الجزء العام
    مصفوفة المادة_الخاصة      # الجزء الخاص (مشفّر)
    منطقي قابل_للتصدير
    رقم سياسة_الاستخدام       # ربط بـ PCR
    رقم الحالة_م               # نشط/معطل

    باني(نص معرّف، رقم نوع)
        المعرّف = معرّف
        النوع = نوع
        المادة_العامة = []
        المادة_الخاصة = []
        قابل_للتصدير = خطأ
        سياسة_الاستخدام = -1
        الحالة_م = مفتاح_نشط
    نهاية

    # توليد مادة المفتاح
    دالة ولّد(رقم الحجم، رقم بذرة)
        المادة_العامة = []
        المادة_الخاصة = []
        متغير ف = 0
        بينما (ف < الحجم)
            المادة_الخاصة += [(بذرة * (ف + 1) * 2654435761) % 256]
            اذا (المادة_الخاصة[ف] < 0)
                المادة_الخاصة[ف] = المادة_الخاصة[ف] * (-1)
            نهاية
            ف = ف + 1
        نهاية
        المادة_العامة = تجزئة_TPM(المادة_الخاصة)
    نهاية

    # ربط المفتاح بسجل PCR
    دالة اربط_بـPCR(رقم فهرس_PCR)
        سياسة_الاستخدام = فهرس_PCR
    نهاية

    # طباعة
    دالة اطبع_معلومات()
        اطبع("    مفتاح[")
        اطبع(المعرّف)
        اطبع("] نوع=")
        اذا (النوع == TPM_مفتاح_ECC)
            اطبع("ECC")
        والا_اذا (النوع == TPM_مفتاح_متماثل)
            اطبع("متماثل")
        والا
            اطبع("HMAC")
        نهاية
        اذا (سياسة_الاستخدام >= 0)
            اطبع(" مربوط=PCR[")
            اطبع(سياسة_الاستخدام)
            اطبع("]")
        نهاية
        اطبع_سطر("")
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     صنف تخزين NV (Non-Volatile)
# ══════════════════════════════════════════════════════════════════════════════

صنف إدخال_NV
    ## إدخال واحد في التخزين غير المتطاير

    رقم الفهرس
    رقم النمط                   # عادي/عداد/بت/تمديد
    مصفوفة البيانات
    رقم الحجم_الأقصى
    رقم الأذونات_م
    منطقي مكتوب               # هل تمت الكتابة؟
    منطقي مقفل_للكتابة       # مقفل ضد الكتابة

    باني(رقم فهرس، رقم نمط، رقم حجم)
        الفهرس = فهرس
        النمط = نمط
        الحجم_الأقصى = حجم
        البيانات = []
        الأذونات_م = NV_قراءة_مالك + NV_كتابة_مالك
        مكتوب = خطأ
        مقفل_للكتابة = خطأ

        # تهيئة البيانات
        متغير ف = 0
        بينما (ف < حجم)
            البيانات += [0]
            ف = ف + 1
        نهاية
    نهاية

    # كتابة
    دالة رقم اكتب(مصفوفة القيمة)
        اذا (مقفل_للكتابة)
            ارجع TPM_فشل
        نهاية
        اذا (النمط == NV_عداد)
            # العداد فقط يزيد
            متغير قيمة_حالية = 0
            اذا (عدد البيانات > 0)
                قيمة_حالية = البيانات[0]
            نهاية
            اذا (عدد القيمة > 0)
                اذا (القيمة[0] <= قيمة_حالية)
                    ارجع TPM_قيمة_خاطئة
                نهاية
            نهاية
        نهاية

        متغير ف = 0
        بينما (ف < عدد القيمة)
            اذا (ف < الحجم_الأقصى)
                البيانات[ف] = القيمة[ف]
            نهاية
            ف = ف + 1
        نهاية
        مكتوب = صحيح
        ارجع TPM_نجاح
    نهاية

    # قراءة
    دالة مصفوفة اقرأ()
        اذا (مكتوب != صحيح)
            ارجع []
        نهاية
        ارجع البيانات
    نهاية

    # قفل
    دالة اقفل_كتابة()
        مقفل_للكتابة = صحيح
    نهاية

    # زيادة العداد
    دالة رقم زد_عداد()
        اذا (النمط != NV_عداد)
            ارجع TPM_فشل
        نهاية
        اذا (مقفل_للكتابة)
            ارجع TPM_فشل
        نهاية
        اذا (عدد البيانات > 0)
            البيانات[0] = البيانات[0] + 1
        نهاية
        مكتوب = صحيح
        ارجع TPM_نجاح
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     صنف مخزن NV
# ══════════════════════════════════════════════════════════════════════════════

صنف مخزن_NV
    ## يدير مناطق التخزين غير المتطاير

    مصفوفة الإدخالات
    رقم أقصى_إدخالات

    باني()
        الإدخالات = []
        أقصى_إدخالات = 64
    نهاية

    # تعريف منطقة NV
    دالة رقم عرّف(رقم الفهرس، رقم النمط، رقم الحجم)
        # التحقق من عدم وجود تكرار
        متغير ف = 0
        بينما (ف < عدد الإدخالات)
            اذا (الإدخالات[ف].الفهرس == الفهرس)
                ارجع TPM_فشل
            نهاية
            ف = ف + 1
        نهاية

        اذا (عدد الإدخالات >= أقصى_إدخالات)
            ارجع TPM_فشل
        نهاية

        الإدخالات += [جديد إدخال_NV(الفهرس، النمط، الحجم)]
        ارجع TPM_نجاح
    نهاية

    # البحث عن إدخال
    دالة إدخال_NV ابحث(رقم الفهرس)
        متغير ف = 0
        بينما (ف < عدد الإدخالات)
            اذا (الإدخالات[ف].الفهرس == الفهرس)
                ارجع الإدخالات[ف]
            نهاية
            ف = ف + 1
        نهاية
        ارجع 0
    نهاية

    # كتابة
    دالة رقم اكتب(رقم الفهرس، مصفوفة القيمة)
        متغير إ = ابحث(الفهرس)
        اذا (إ == 0)
            ارجع TPM_غير_موجود
        نهاية
        ارجع إ.اكتب(القيمة)
    نهاية

    # قراءة
    دالة مصفوفة اقرأ(رقم الفهرس)
        متغير إ = ابحث(الفهرس)
        اذا (إ == 0)
            ارجع []
        نهاية
        ارجع إ.اقرأ()
    نهاية

    # طباعة
    دالة اطبع_حالة()
        اطبع("  إدخالات NV: ")
        اطبع_سطر(عدد الإدخالات)
        متغير ف = 0
        بينما (ف < عدد الإدخالات)
            اطبع("    NV[")
            اطبع(الإدخالات[ف].الفهرس)
            اطبع("] نمط=")
            اذا (الإدخالات[ف].النمط == NV_عداد)
                اطبع("عداد")
            والا_اذا (الإدخالات[ف].النمط == NV_بت)
                اطبع("بت")
            والا
                اطبع("عادي")
            نهاية
            اذا (الإدخالات[ف].مقفل_للكتابة)
                اطبع(" [مقفل]")
            نهاية
            اطبع_سطر("")
            ف = ف + 1
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     صنف جلسة TPM (Session)
# ══════════════════════════════════════════════════════════════════════════════

صنف جلسة_TPM
    ## تمثل جلسة مصادقة مع TPM

    رقم المعرّف_ج
    رقم النوع_ج
    مصفوفة المفتاح_ج           # مفتاح الجلسة (مشتق)
    مصفوفة الرقم_العشوائي     # nonce
    منطقي نشطة
    رقم عداد_الأوامر         # عدد الأوامر المنفذة
    رقم وقت_الإنشاء_ج
    رقم وقت_الانتهاء_ج

    باني(رقم معرّف، رقم نوع، رقم وقت)
        المعرّف_ج = معرّف
        النوع_ج = نوع
        المفتاح_ج = []
        الرقم_العشوائي = []
        نشطة = صحيح
        عداد_الأوامر = 0
        وقت_الإنشاء_ج = وقت
        وقت_الانتهاء_ج = وقت + 3600    # ساعة واحدة
    نهاية

    # تعيين مفتاح الجلسة
    دالة عيّن_مفتاح(مصفوفة المفتاح)
        المفتاح_ج = المفتاح
    نهاية

    # جدّد الرقم العشوائي
    دالة جدّد_عشوائي(رقم بذرة)
        الرقم_العشوائي = []
        متغير ف = 0
        بينما (ف < 32)
            الرقم_العشوائي += [(بذرة * (ف + 1) * 2654435761) % 256]
            اذا (الرقم_العشوائي[ف] < 0)
                الرقم_العشوائي[ف] = الرقم_العشوائي[ف] * (-1)
            نهاية
            ف = ف + 1
        نهاية
    نهاية

    # التحقق من الصلاحية
    دالة منطقي صالحة(رقم الوقت)
        اذا (نشطة != صحيح)
            ارجع خطأ
        نهاية
        اذا (الوقت > وقت_الانتهاء_ج)
            ارجع خطأ
        نهاية
        ارجع صحيح
    نهاية

    # تسجيل أمر
    دالة سجّل_أمر()
        عداد_الأوامر = عداد_الأوامر + 1
    نهاية

    # إنهاء الجلسة
    دالة أنهِ()
        نشطة = خطأ
        # مسح آمن
        متغير ف = 0
        بينما (ف < عدد المفتاح_ج)
            المفتاح_ج[ف] = 0
            ف = ف + 1
        نهاية
    نهاية
