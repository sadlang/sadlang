        متغير د2 = مر_ه2 * مفتاح_ر0 + مر_ه1 * مفتاح_ر1 + مر_ه0 * مفتاح_ر2 + مر_ه4 * مفتاح_ر3_5 + مر_ه3 * مفتاح_ر4_5
        متغير د3 = مر_ه3 * مفتاح_ر0 + مر_ه2 * مفتاح_ر1 + مر_ه1 * مفتاح_ر2 + مر_ه0 * مفتاح_ر3 + مر_ه4 * مفتاح_ر4_5
        متغير د4 = مر_ه4 * مفتاح_ر0 + مر_ه3 * مفتاح_ر1 + مر_ه2 * مفتاح_ر2 + مر_ه1 * مفتاح_ر3 + مر_ه0 * مفتاح_ر4

        # الحمل والتقليص - الجولة الأولى
        متغير حم0 = د0 / 67108864
        مر_ه0 = د0 - حم0 * 67108864
        د1 = د1 + حم0

        متغير حم1 = د1 / 67108864
        مر_ه1 = د1 - حم1 * 67108864
        د2 = د2 + حم1

        متغير حم2 = د2 / 67108864
        مر_ه2 = د2 - حم2 * 67108864
        د3 = د3 + حم2

