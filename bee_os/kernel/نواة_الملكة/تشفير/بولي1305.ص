        ه2 = 0
        ه3 = 0
        ه4 = 0
        عدد_كتل = 0
    نهاية

    # إضافة كتلة إلى المراكم: h += c
    دالة إضافة_كتلة(رقم ج0، رقم ج1، رقم ج2، رقم ج3، رقم ج4)
        ه0 = ه0 + ج0
        ه1 = ه1 + ج1
        ه2 = ه2 + ج2
        ه3 = ه3 + ج3
        ه4 = ه4 + ج4
    نهاية

    # ضرب المراكم بـ r: h *= r (مع r*5 المحسوبة مسبقاً)
    # هذه هو جوهر العملية الحسابية في Poly1305
    دالة ضرب_بالمعامل(رقم ر0، رقم ر1، رقم ر2، رقم ر3، رقم ر4، رقم ر1_5، رقم ر2_5، رقم ر3_5، رقم ر4_5)
        # حساب المنتجات الجزئية
        # d0 = h0*r0 + h4*r1*5 + h3*r2*5 + h2*r3*5 + h1*r4*5
        متغير د0 = ه0 * ر0 + ه4 * ر1_5 + ه3 * ر2_5 + ه2 * ر3_5 + ه1 * ر4_5

        # d1 = h1*r0 + h0*r1 + h4*r2*5 + h3*r3*5 + h2*r4*5
        متغير د1 = ه1 * ر0 + ه0 * ر1 + ه4 * ر2_5 + ه3 * ر3_5 + ه2 * ر4_5

        # d2 = h2*r0 + h1*r1 + h0*r2 + h4*r3*5 + h3*r4*5
        متغير د2 = ه2 * ر0 + ه1 * ر1 + ه0 * ر2 + ه4 * ر3_5 + ه3 * ر4_5

        # d3 = h3*r0 + h2*r1 + h1*r2 + h0*r3 + h4*r4*5
        متغير د3 = ه3 * ر0 + ه2 * ر1 + ه1 * ر2 + ه0 * ر3 + ه4 * ر4_5

        # d4 = h4*r0 + h3*r1 + h2*r2 + h1*r3 + h0*r4
        متغير د4 = ه4 * ر0 + ه3 * ر1 + ه2 * ر2 + ه1 * ر3 + ه0 * ر4

        # الحمل والتقليص
        # جولة 1
        متغير حمل0 = د0 / 67108864
        ه0 = د0 - حمل0 * 67108864
        د1 = د1 + حمل0

        متغير حمل1 = د1 / 67108864
        ه1 = د1 - حمل1 * 67108864
        د2 = د2 + حمل1

        متغير حمل2 = د2 / 67108864
        ه2 = د2 - حمل2 * 67108864
        د3 = د3 + حمل2

        متغير حمل3 = د3 / 67108864
        ه3 = د3 - حمل3 * 67108864
        د4 = د4 + حمل3

        متغير حمل4 = د4 / 67108864
        ه4 = د4 - حمل4 * 67108864
        # 2^130 ≡ 5 mod p، لذا حمل الطرف 4 يُضرب في 5
        ه0 = ه0 + حمل4 * 5

        # جولة 2 (لإكمال التقليص)
        متغير حمل0_2 = ه0 / 67108864
        ه0 = ه0 - حمل0_2 * 67108864
        ه1 = ه1 + حمل0_2

        عدد_كتل = عدد_كتل + 1
    نهاية

    # معالجة كتلة كاملة: h = ((h + c) * r) mod p
    دالة معالجة_كتلة(رقم ج0، رقم ج1، رقم ج2، رقم ج3، رقم ج4، رقم ر0، رقم ر1، رقم ر2، رقم ر3، رقم ر4، رقم ر1_5، رقم ر2_5، رقم ر3_5، رقم ر4_5)
