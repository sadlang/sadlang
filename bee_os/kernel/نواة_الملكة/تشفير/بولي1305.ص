# مراكم بولي - المُراكِم h في خوارزمية Poly1305
# يحفظ القيمة الحالية h = ((h + c) * r) mod p
# ──────────────────────────────────────────────────────────────────────
صنف مراكم_بولي
    # المراكم h (5 أطراف)
    رقم ه0
    رقم ه1
