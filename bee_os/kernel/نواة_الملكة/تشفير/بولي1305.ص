# ══════════════════════════════════════════════════════════════════════
# بولي1305 - خوارزمية توثيق الرسائل Poly1305 MAC
# T0162
# ══════════════════════════════════════════════════════════════════════
#
# تنفيذ خوارزمية Poly1305 لتوثيق الرسائل (Message Authentication Code)
# المواصفة: RFC 7539 / RFC 8439
#
# الخوارزمية:
#   المدخلات: مفتاح 32 بايت (r || s) ورسالة بطول متغير
#   المخرجات: وسم توثيق 16 بايت (128 بت)
#
#   p = 2^130 - 5 (عدد أولي)
#   r = مفتاح[0..15] مع تقييد (clamping)
#   s = مفتاح[16..31]
#
#   h = 0
#   لكل كتلة 16 بايت من الرسالة:
#     h = ((h + كتلة) * r) mod p
#   وسم = (h + s) mod 2^128
#
# التمثيل الداخلي:
#   نستخدم 5 أطراف (limbs) بحجم 26 بت لكل عنصر في الحقل
#   هذا يسمح بالضرب بدون فيضان في أرقام 64 بت
#
# ══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# طرف خماسي - تمثيل عنصر في الحقل GF(2^130 - 5)
# يتكون من 5 أطراف، كل طرف يحمل ~26 بت
# ──────────────────────────────────────────────────────────────────────
صنف طرف_خماسي
    رقم ط0
    رقم ط1
    رقم ط2
    رقم ط3
    رقم ط4

    باني()
        ط0 = 0
        ط1 = 0
        ط2 = 0
        ط3 = 0
        ط4 = 0
    نهاية

    # تعيين القيم مباشرة
    دالة تعيين(رقم ق0، رقم ق1، رقم ق2، رقم ق3، رقم ق4)
        ط0 = ق0
        ط1 = ق1
        ط2 = ق2
        ط3 = ق3
        ط4 = ق4
    نهاية

    # نسخ من طرف آخر
    دالة نسخ_من(رقم م0، رقم م1، رقم م2، رقم م3، رقم م4)
        ط0 = م0
        ط1 = م1
        ط2 = م2
        ط3 = م3
        ط4 = م4
    نهاية

    # تصفير كل الأطراف
    دالة مسح()
        ط0 = 0
        ط1 = 0
        ط2 = 0
        ط3 = 0
        ط4 = 0
    نهاية

    # التحقق من أن القيمة صفرية
    دالة رقم صفري()
        اذا (ط0 == 0)
            اذا (ط1 == 0)
                اذا (ط2 == 0)
                    اذا (ط3 == 0)
                        اذا (ط4 == 0)
                            ارجع 1
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
        ارجع 0
    نهاية

    # المقارنة مع طرف آخر
    دالة رقم يساوي(رقم م0، رقم م1، رقم م2، رقم م3، رقم م4)
        اذا (ط0 != م0)
            ارجع 0
        نهاية
        اذا (ط1 != م1)
            ارجع 0
        نهاية
        اذا (ط2 != م2)
            ارجع 0
        نهاية
        اذا (ط3 != م3)
            ارجع 0
        نهاية
        اذا (ط4 != م4)
            ارجع 0
        نهاية
        ارجع 1
    نهاية

    # عرض القيمة للتنقيح
    دالة عرض(نص تسمية)
        اطبع("  ")
        اطبع(تسمية)
        اطبع(": [")
        اطبع(ط0)
        اطبع("، ")
        اطبع(ط1)
        اطبع("، ")
        اطبع(ط2)
        اطبع("، ")
        اطبع(ط3)
        اطبع("، ")
        اطبع(ط4)
        اطبع_سطر("]")
    نهاية

    # تحميل من 4 أعداد 32 بت إلى 5 أطراف 26 بت
    دالة تحميل_من_أعداد(رقم ع0، رقم ع1، رقم ع2، رقم ع3)
        # قناع 26 بت = 67108863
        متغير قناع = 67108863
        ط0 = ع0 - (ع0 / 67108864) * 67108864
        متغير باقي0 = ع0 / 67108864
        ط1 = (باقي0 + (ع1 * 64)) - ((باقي0 + (ع1 * 64)) / 67108864) * 67108864
        متغير باقي1 = (باقي0 + (ع1 * 64)) / 67108864
        ط2 = (باقي1 + (ع2 * 4096)) - ((باقي1 + (ع2 * 4096)) / 67108864) * 67108864
        متغير باقي2 = (باقي1 + (ع2 * 4096)) / 67108864
        ط3 = (باقي2 + (ع3 * 262144)) - ((باقي2 + (ع3 * 262144)) / 67108864) * 67108864
        ط4 = (باقي2 + (ع3 * 262144)) / 67108864
    نهاية

    # تصدير إلى 4 أعداد 32 بت
    دالة رقم تصدير_ع0()
        ارجع ط0 + (ط1 * 67108864)
    نهاية

    دالة رقم تصدير_ع1()
        متغير بقية = ط1 / 64
        ارجع بقية + (ط2 * 1048576)
    نهاية

    دالة رقم تصدير_ع2()
        متغير بقية = ط2 / 4096
        ارجع بقية + (ط3 * 16384)
    نهاية

    دالة رقم تصدير_ع3()
        متغير بقية = ط3 / 262144
        ارجع بقية + (ط4 * 4)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────────
# عمليات الحقل - العمليات الحسابية في GF(2^130 - 5)
# ──────────────────────────────────────────────────────────────────────
صنف عمليات_الحقل
    رقم قناع_26
    رقم الأولي_منخفض
    رقم عدد_عمليات_جمع
    رقم عدد_عمليات_ضرب
    رقم عدد_عمليات_تقليص

    باني()
        # قناع 26 بت = 2^26 - 1 = 67108863
        قناع_26 = 67108863
        # الجزء المنخفض من p = 2^130 - 5
        الأولي_منخفض = 5
        عدد_عمليات_جمع = 0
        عدد_عمليات_ضرب = 0
        عدد_عمليات_تقليص = 0
    نهاية

    # ──────────────────────────────────────────────────────────────────
    # الجمع: نتيجة = أ + ب (بدون تقليص)
    # ──────────────────────────────────────────────────────────────────
    دالة جمع(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4، رقم ب0، رقم ب1، رقم ب2، رقم ب3، رقم ب4)
        عدد_عمليات_جمع = عدد_عمليات_جمع + 1
    نهاية

    دالة رقم جمع_ط0(رقم أ0، رقم ب0)
        ارجع أ0 + ب0
    نهاية

    دالة رقم جمع_ط1(رقم أ1، رقم ب1)
        ارجع أ1 + ب1
    نهاية

    دالة رقم جمع_ط2(رقم أ2، رقم ب2)
        ارجع أ2 + ب2
    نهاية

    دالة رقم جمع_ط3(رقم أ3، رقم ب3)
        ارجع أ3 + ب3
    نهاية

    دالة رقم جمع_ط4(رقم أ4، رقم ب4)
        ارجع أ4 + ب4
    نهاية

    # ──────────────────────────────────────────────────────────────────
    # الطرح: نتيجة = أ - ب (مع إضافة p لتجنب السالب)
    # ──────────────────────────────────────────────────────────────────
    دالة رقم طرح_ط0(رقم أ0، رقم ب0)
        # إضافة 5 * 2^26 لتجنب السالب
        ارجع أ0 - ب0 + 335544315
    نهاية

    دالة رقم طرح_ط1(رقم أ1، رقم ب1)
        ارجع أ1 - ب1 + 335544315
    نهاية

    دالة رقم طرح_ط2(رقم أ2، رقم ب2)
        ارجع أ2 - ب2 + 335544315
    نهاية

    دالة رقم طرح_ط3(رقم أ3، رقم ب3)
        ارجع أ3 - ب3 + 335544315
    نهاية

    دالة رقم طرح_ط4(رقم أ4، رقم ب4)
        ارجع أ4 - ب4 + 335544315
    نهاية

    # ──────────────────────────────────────────────────────────────────
    # الحمل والتقليص - نقل الفائض بين الأطراف
    # carry & reduce: h[i] = h[i] mod 2^26, carry → h[i+1]
    # الطرف الأخير: carry * 5 يُضاف إلى h[0] (لأن 2^130 ≡ 5 mod p)
    # ──────────────────────────────────────────────────────────────────
    دالة رقم حمل_طرف(رقم قيمة)
        # الحمل = قيمة >> 26
        ارجع قيمة / 67108864
    نهاية

    دالة رقم باقي_طرف(رقم قيمة)
        # الباقي = قيمة & 0x3FFFFFF
        ارجع قيمة - (قيمة / 67108864) * 67108864
    نهاية

    # تقليص كامل لـ 5 أطراف
    دالة تقليص_خماسي(رقم ق0، رقم ق1، رقم ق2، رقم ق3، رقم ق4)
        عدد_عمليات_تقليص = عدد_عمليات_تقليص + 1
    نهاية

    دالة رقم تقليص_ط0(رقم ق0، رقم حمل_أخير)
        # نضيف حمل الطرف الأخير * 5 (بسبب 2^130 ≡ 5 mod p)
        متغير مجموع = ق0 + حمل_أخير * 5
        ارجع باقي_طرف(مجموع)
    نهاية

    دالة رقم تقليص_حمل0(رقم ق0، رقم حمل_أخير)
        متغير مجموع = ق0 + حمل_أخير * 5
        ارجع حمل_طرف(مجموع)
    نهاية

    دالة رقم تقليص_ط1(رقم ق1، رقم حمل_سابق)
        متغير مجموع = ق1 + حمل_سابق
        ارجع باقي_طرف(مجموع)
    نهاية

    دالة رقم تقليص_حمل1(رقم ق1، رقم حمل_سابق)
        متغير مجموع = ق1 + حمل_سابق
        ارجع حمل_طرف(مجموع)
    نهاية

    دالة رقم تقليص_ط2(رقم ق2، رقم حمل_سابق)
        متغير مجموع = ق2 + حمل_سابق
        ارجع باقي_طرف(مجموع)
    نهاية

    دالة رقم تقليص_حمل2(رقم ق2، رقم حمل_سابق)
        متغير مجموع = ق2 + حمل_سابق
        ارجع حمل_طرف(مجموع)
    نهاية

    دالة رقم تقليص_ط3(رقم ق3، رقم حمل_سابق)
        متغير مجموع = ق3 + حمل_سابق
        ارجع باقي_طرف(مجموع)
    نهاية

    دالة رقم تقليص_حمل3(رقم ق3، رقم حمل_سابق)
        متغير مجموع = ق3 + حمل_سابق
        ارجع حمل_طرف(مجموع)
    نهاية

    دالة رقم تقليص_ط4(رقم ق4، رقم حمل_سابق)
        متغير مجموع = ق4 + حمل_سابق
        ارجع باقي_طرف(مجموع)
    نهاية

    دالة رقم تقليص_حمل4(رقم ق4، رقم حمل_سابق)
        متغير مجموع = ق4 + حمل_سابق
        ارجع حمل_طرف(مجموع)
    نهاية

    # ──────────────────────────────────────────────────────────────────
    # التقليص النهائي: التأكد أن h < p
    # إذا h >= p، نطرح p
    # p = 2^130 - 5 = [0x3FFFFFB, 0x3FFFFFF, 0x3FFFFFF, 0x3FFFFFF, 0x3]
    # ──────────────────────────────────────────────────────────────────
    دالة رقم تقليص_نهائي_ط0(رقم ق0)
        # نضيف 5 ونتحقق إذا حدث فيضان
        متغير مجموع = ق0 + 5
        ارجع باقي_طرف(مجموع)
    نهاية

    دالة رقم يحتاج_تقليص(رقم ق0، رقم ق1، رقم ق2، رقم ق3، رقم ق4)
        # التحقق إذا h >= p
        # h >= p عندما ط4 > 3 أو (ط4 == 3 والأطراف الأخرى >= 0x3FFFFFF)
        اذا (ق4 > 3)
            ارجع 1
        نهاية
        اذا (ق4 == 3)
            اذا (ق3 == 67108863)
                اذا (ق2 == 67108863)
                    اذا (ق1 == 67108863)
                        اذا (ق0 >= 67108859)
                            ارجع 1
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
        ارجع 0
    نهاية

    # ──────────────────────────────────────────────────────────────────
    # الضرب: حساب a * b mod p
    # نستخدم الطريقة الكلاسيكية مع تحسين:
    # بما أن 2^130 ≡ 5 mod p، فإن أي حمل من الطرف 4
    # يُضرب في 5 ويُضاف للطرف 0
    #
    # المنتجات الجزئية:
    # d0 = a0*b0 + 5*(a4*b1 + a3*b2 + a2*b3 + a1*b4)
    # d1 = a1*b0 + a0*b1 + 5*(a4*b2 + a3*b3 + a2*b4)
    # d2 = a2*b0 + a1*b1 + a0*b2 + 5*(a4*b3 + a3*b4)
    # d3 = a3*b0 + a2*b1 + a1*b2 + a0*b3 + 5*(a4*b4)
    # d4 = a4*b0 + a3*b1 + a2*b2 + a1*b3 + a0*b4
    # ──────────────────────────────────────────────────────────────────
    دالة ضرب(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4، رقم ب0، رقم ب1، رقم ب2، رقم ب3، رقم ب4)
        عدد_عمليات_ضرب = عدد_عمليات_ضرب + 1
    نهاية

    # حساب الحد d0 من حاصل الضرب
    دالة رقم ضرب_د0(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4، رقم ب0، رقم ب1، رقم ب2، رقم ب3، رقم ب4)
        # d0 = a0*b0 + 5*(a4*b1 + a3*b2 + a2*b3 + a1*b4)
        متغير مباشر = أ0 * ب0
        متغير ب1_5 = ب1 * 5
        متغير ب2_5 = ب2 * 5
        متغير ب3_5 = ب3 * 5
        متغير ب4_5 = ب4 * 5
        متغير ملفوف = أ4 * ب1_5 + أ3 * ب2_5 + أ2 * ب3_5 + أ1 * ب4_5
        ارجع مباشر + ملفوف
    نهاية

    # حساب الحد d1 من حاصل الضرب
    دالة رقم ضرب_د1(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4، رقم ب0، رقم ب1، رقم ب2، رقم ب3، رقم ب4)
        # d1 = a1*b0 + a0*b1 + 5*(a4*b2 + a3*b3 + a2*b4)
        متغير مباشر = أ1 * ب0 + أ0 * ب1
        متغير ب2_5 = ب2 * 5
        متغير ب3_5 = ب3 * 5
        متغير ب4_5 = ب4 * 5
        متغير ملفوف = أ4 * ب2_5 + أ3 * ب3_5 + أ2 * ب4_5
        ارجع مباشر + ملفوف
    نهاية

    # حساب الحد d2 من حاصل الضرب
    دالة رقم ضرب_د2(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4، رقم ب0، رقم ب1، رقم ب2، رقم ب3، رقم ب4)
        # d2 = a2*b0 + a1*b1 + a0*b2 + 5*(a4*b3 + a3*b4)
        متغير مباشر = أ2 * ب0 + أ1 * ب1 + أ0 * ب2
        متغير ب3_5 = ب3 * 5
        متغير ب4_5 = ب4 * 5
        متغير ملفوف = أ4 * ب3_5 + أ3 * ب4_5
        ارجع مباشر + ملفوف
    نهاية

    # حساب الحد d3 من حاصل الضرب
    دالة رقم ضرب_د3(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4، رقم ب0، رقم ب1، رقم ب2، رقم ب3، رقم ب4)
        # d3 = a3*b0 + a2*b1 + a1*b2 + a0*b3 + 5*(a4*b4)
        متغير مباشر = أ3 * ب0 + أ2 * ب1 + أ1 * ب2 + أ0 * ب3
        متغير ب4_5 = ب4 * 5
        متغير ملفوف = أ4 * ب4_5
        ارجع مباشر + ملفوف
    نهاية

    # حساب الحد d4 من حاصل الضرب
    دالة رقم ضرب_د4(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4، رقم ب0، رقم ب1، رقم ب2، رقم ب3، رقم ب4)
        # d4 = a4*b0 + a3*b1 + a2*b2 + a1*b3 + a0*b4
        ارجع أ4 * ب0 + أ3 * ب1 + أ2 * ب2 + أ1 * ب3 + أ0 * ب4
    نهاية

    # ──────────────────────────────────────────────────────────────────
    # التربيع: a^2 mod p (أسرع من الضرب العام)
    # ──────────────────────────────────────────────────────────────────
    دالة رقم تربيع_د0(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4)
        # d0 = a0^2 + 2*5*(a4*a1 + a3*a2)
        متغير مربع = أ0 * أ0
        متغير متقاطع = 10 * (أ4 * أ1 + أ3 * أ2)
        ارجع مربع + متقاطع
    نهاية

    دالة رقم تربيع_د1(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4)
        # d1 = 2*a0*a1 + 2*5*(a4*a2) + 5*a3^2
        متغير مباشر = 2 * أ0 * أ1
        متغير ملفوف = 10 * أ4 * أ2 + 5 * أ3 * أ3
        ارجع مباشر + ملفوف
    نهاية

    دالة رقم تربيع_د2(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4)
        # d2 = 2*a0*a2 + a1^2 + 2*5*a4*a3
        متغير مباشر = 2 * أ0 * أ2 + أ1 * أ1
        متغير ملفوف = 10 * أ4 * أ3
        ارجع مباشر + ملفوف
    نهاية

    دالة رقم تربيع_د3(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4)
        # d3 = 2*a0*a3 + 2*a1*a2 + 5*a4^2
        ارجع 2 * أ0 * أ3 + 2 * أ1 * أ2 + 5 * أ4 * أ4
    نهاية

    دالة رقم تربيع_د4(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم أ4)
        # d4 = 2*a0*a4 + 2*a1*a3 + a2^2
        ارجع 2 * أ0 * أ4 + 2 * أ1 * أ3 + أ2 * أ2
    نهاية

    # عرض إحصائيات العمليات
    دالة عرض_إحصائيات()
        اطبع_سطر("  ── إحصائيات عمليات الحقل ──")
        اطبع("    جمع: ")
        اطبع_سطر(عدد_عمليات_جمع)
        اطبع("    ضرب: ")
        اطبع_سطر(عدد_عمليات_ضرب)
        اطبع("    تقليص: ")
        اطبع_سطر(عدد_عمليات_تقليص)
    نهاية
نهاية

# ──────────────────────────────────────────────────────────────────────
# مفتاح بولي1305 - معالجة وتخزين المفتاح
# يتكون من جزأين:
#   r (16 بايت): مُعامِل الحقل (مع تقييد)
#   s (16 بايت): مُضاف لتوليد الوسم
# ──────────────────────────────────────────────────────────────────────
صنف مفتاح_بولي1305
    # الجزء r مُقيَّد (5 أطراف)
    رقم ر0
    رقم ر1
    رقم ر2
    رقم ر3
    رقم ر4
    # الجزء s (4 أعداد 32 بت)
    رقم س0
    رقم س1
    رقم س2
    رقم س3
    # قيم r المسبقة الحساب (r*5 للأطراف 1-4)
    رقم ر1_5
    رقم ر2_5
    رقم ر3_5
    رقم ر4_5
    # علامة التهيئة
    رقم مهيأ

    باني()
        ر0 = 0
        ر1 = 0
        ر2 = 0
        ر3 = 0
        ر4 = 0
        س0 = 0
        س1 = 0
        س2 = 0
        س3 = 0
        ر1_5 = 0
        ر2_5 = 0
        ر3_5 = 0
        ر4_5 = 0
        مهيأ = 0
    نهاية

    # تحميل المفتاح من 8 أعداد 32 بت
    # الأعداد 0-3: الجزء r
    # الأعداد 4-7: الجزء s
    دالة تحميل(رقم ك0، رقم ك1، رقم ك2، رقم ك3، رقم ك4، رقم ك5، رقم ك6، رقم ك7)
        # تقييد r (RFC 7539 Section 2.5):
        # - البتات العليا 4 من كل عدد 32 بت تُمسح
        # - البتان السفليان من ك1, ك2, ك3 تُمسحان
        متغير ر_ك0 = ك0 - (ك0 / 268435456) * 268435456
