        ه4 = ه4 - ح4 * 67108864
        ه0 = ه0 + ح4 * 5

        متغير ح0_2 = ه0 / 67108864
        ه0 = ه0 - ح0_2 * 67108864
        ه1 = ه1 + ح0_2

        # التحقق إذا h >= p وطرح p إذا لزم الأمر
        # g = h + 5، إذا g >= 2^130 فإن h >= p
        متغير ق0 = ه0 + 5
        متغير قح0 = ق0 / 67108864
        ق0 = ق0 - قح0 * 67108864

        متغير ق1 = ه1 + قح0
