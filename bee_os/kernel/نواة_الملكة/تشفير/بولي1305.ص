        متغير د0 = مر_ه0 * مفتاح_ر0 + مر_ه4 * مفتاح_ر1_5 + مر_ه3 * مفتاح_ر2_5 + مر_ه2 * مفتاح_ر3_5 + مر_ه1 * مفتاح_ر4_5
