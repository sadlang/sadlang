        مر_ه3 = د3 - حم3 * 67108864
        د4 = د4 + حم3

        متغير حم4 = د4 / 67108864
        مر_ه4 = د4 - حم4 * 67108864
        مر_ه0 = مر_ه0 + حم4 * 5

