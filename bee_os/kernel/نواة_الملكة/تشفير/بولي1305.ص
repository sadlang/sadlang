        ق2 = ق2 - قح2 * 67108864

        متغير ق3 = ه3 + قح2
        متغير قح3 = ق3 / 67108864
        ق3 = ق3 - قح3 * 67108864

        متغير ق4 = ه4 + قح3
        متغير قح4 = ق4 / 67108864

        # إذا حدث حمل من الطرف 4، فإن g >= 2^130 → h >= p
        # في هذه الحالة نستخدم g - 2^130 = h - p
        # القناع: إذا قح4 != 0 فالقناع = -1 (نستخدم g)
        اذا (قح4 != 0)
            ه0 = ق0
            ه1 = ق1
            ه2 = ق2
            ه3 = ق3
            ه4 = ق4 - قح4 * 67108864
        نهاية
    نهاية

    # إضافة s وإخراج الوسم النهائي كـ 4 أعداد 32 بت
    دالة رقم وسم0(رقم س0)
        # تحويل h من 5 أطراف إلى 4 أعداد
