# صنف: ربع دورة تشاتشا
# العملية الأساسية في الخوارزمية
# QR(a, b, c, d):
#   a += b; d ^= a; d <<<= 16
#   c += d; b ^= c; b <<<= 12
#   a += b; d ^= a; d <<<= 8
#   c += d; b ^= c; b <<<= 7
# ══════════════════════════════════════════════════════════════════════════════

صنف ربع_دورة
    # قيم العمل الأربع
    رقم أ
    رقم ب
    رقم ج
    رقم د

    باني()
        أ = 0
        ب = 0
        ج = 0
        د = 0
    نهاية

    # ──────────────────────────────────────────
    # تحميل القيم من الحالة
    # ──────────────────────────────────────────
    دالة تحميل(رقم قا، رقم قب، رقم قج، رقم قد)
        أ = قا
        ب = قب
