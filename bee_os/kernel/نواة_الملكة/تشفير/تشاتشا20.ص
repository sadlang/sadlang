    # ──────────────────────────────────────────
    دالة اختبار_فريدة()
        اختبارات_كلية = اختبارات_كلية + 1
        اطبع_سطر("  [اختبار] الفريدة")

        متغير فريدة = جديد فريدة_تشاتشا()
        فريدة.تعيين_اختبار(100)

