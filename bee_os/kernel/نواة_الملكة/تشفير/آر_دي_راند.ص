# آر_دي_راند.ص - دعم تعليمات RDRAND/RDSEED للعشوائية من الأجهزة
# T0170
# ══════════════════════════════════════════════════════════════════════════════
#
# واجهة لتعليمات Intel/AMD للعشوائية من الأجهزة:
#   - RDRAND: مولد أرقام عشوائية حقيقية (TRNG) مبني في المعالج
#   - RDSEED: بذرة عشوائية من مصدر عشوائية فيزيائي
#
# RDRAND vs RDSEED:
# ══════════════════
#   RDRAND: يولّد أرقاماً من CSPRNG مبني في المعالج (أسرع)
#   RDSEED: يولّد بذوراً مباشرة من مصدر عشوائية حراري (أبطأ لكن أقوى)
#
# كشف الدعم:
#   CPUID(EAX=01h): ECX.bit30 = RDRAND
#   CPUID(EAX=07h, ECX=0): EBX.bit18 = RDSEED
#
# التعليمات:
#   RDRAND reg32/reg64: يملأ المسجل بقيمة عشوائية، CF=1 إذا نجح
#   RDSEED reg32/reg64: يملأ المسجل ببذرة عشوائية، CF=1 إذا نجح
#
# في بيئة نظام التشغيل نستخدم inline assembly أو port I/O
# هذا الملف يوفر واجهة ص عالية المستوى + محاكاة للاختبار
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
#                           الثوابت
# ══════════════════════════════════════════════════════════════════════════════

# بتات CPUID
ثابت بت_RDRAND = 30          # ECX bit 30 from CPUID(1)
ثابت بت_RDSEED = 18          # EBX bit 18 from CPUID(7,0)

# أقصى عدد محاولات لـ RDRAND/RDSEED قبل الفشل
ثابت أقصى_محاولات_RDRAND = 10
ثابت أقصى_محاولات_RDSEED = 32

# أوضاع العمل
ثابت وضع_أجهزة = 1           # استخدام RDRAND/RDSEED الحقيقي
ثابت وضع_محاكاة = 2          # محاكاة برمجية (للاختبار)
ثابت وضع_هجين = 3            # أجهزة + محاكاة احتياطية

# حجم المخزن المؤقت (بايت)
ثابت حجم_مخزن_RDRAND = 256

# ثوابت خلط المحاكاة
ثابت محاكاة_ثابت1 = 6364136223846793005
ثابت محاكاة_ثابت2 = 1442695040888963407


# ══════════════════════════════════════════════════════════════════════════════
#                     دوال بتّية مساعدة
# ══════════════════════════════════════════════════════════════════════════════

دالة رقم رد_حصأو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 != ب2)
            نتيجة = نتيجة + قيمة_بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

دالة رقم رد_حصو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 == 1)
            اذا (ب2 == 1)
                نتيجة = نتيجة + قيمة_بت
            نهاية
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

دالة رقم رد_يمين(رقم قيمة، رقم عدد)
    متغير نتيجة = قيمة
    متغير ع = 0
    بينما (ع < عدد)
        نتيجة = (نتيجة - (نتيجة % 2)) / 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# استخراج بت من قيمة
دالة رقم رد_بت(رقم قيمة، رقم موضع)
    ارجع رد_يمين(قيمة، موضع) % 2
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف كاشف ميزات المعالج (CPUID)
# ══════════════════════════════════════════════════════════════════════════════

صنف كاشف_CPUID
    ## يحاكي CPUID لكشف دعم RDRAND و RDSEED
    ## في النواة الحقيقية يستخدم تعليمة CPUID فعلية

    رقم يدعم_RDRAND
    رقم يدعم_RDSEED
    رقم يدعم_AES_NI
    رقم تم_الكشف

    باني()
        يدعم_RDRAND = 0
        يدعم_RDSEED = 0
        يدعم_AES_NI = 0
        تم_الكشف = 0
    نهاية

    # كشف الميزات (محاكاة)
    # في النواة الحقيقية: CPUID(EAX=1) → ECX bit 30 = RDRAND
    #                       CPUID(EAX=7, ECX=0) → EBX bit 18 = RDSEED
    دالة كشف()
        # في المحاكاة نفترض وجود الميزات
        يدعم_RDRAND = 1
        يدعم_RDSEED = 1
        يدعم_AES_NI = 1
        تم_الكشف = 1
        اطبع_سطر("  CPUID: تم كشف ميزات المعالج")
        اطبع("    RDRAND: ")
        اذا (يدعم_RDRAND == 1)
            اطبع_سطر("مدعوم ✓")
        والا
            اطبع_سطر("غير مدعوم ✗")
        نهاية
        اطبع("    RDSEED: ")
        اذا (يدعم_RDSEED == 1)
            اطبع_سطر("مدعوم ✓")
        والا
            اطبع_سطر("غير مدعوم ✗")
        نهاية
    نهاية

    # كشف حقيقي باستخدام CPUID (يُستخدم في النواة)
    دالة كشف_حقيقي(رقم ecx_leaf1، رقم ebx_leaf7)
        # RDRAND: ECX bit 30
        يدعم_RDRAND = رد_بت(ecx_leaf1، بت_RDRAND)
        # RDSEED: EBX bit 18
        يدعم_RDSEED = رد_بت(ebx_leaf7، بت_RDSEED)
        # AES-NI: ECX bit 25
        يدعم_AES_NI = رد_بت(ecx_leaf1، 25)
        تم_الكشف = 1
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف محاكي RDRAND (للاختبار)
# ══════════════════════════════════════════════════════════════════════════════

صنف محاكي_RDRAND
    ## محاكي RDRAND يستخدم PCG-like PRNG
    ## يحاكي سلوك RDRAND بما في ذلك:
    ##   - احتمال فشل عشوائي (underflow)
    ##   - تأخير واقعي
    ##   - إنتاج 32/64 بت

    رقم وضع0              # حالة PCG
    رقم وضع1
    رقم عداد_التوليد
    رقم معدل_الفشل        # نسبة الفشل (من 1000)
    رقم مُبذَر

    باني()
        وضع0 = 0
        وضع1 = 0
        عداد_التوليد = 0
        معدل_الفشل = 5     # 0.5% فشل
        مُبذَر = 0
    نهاية

    # بذر المحاكي
    دالة بذر(رقم بذرة)
        وضع0 = بذرة * محاكاة_ثابت1
        وضع0 = وضع0 - (وضع0 / 4294967296) * 4294967296
        وضع1 = بذرة * محاكاة_ثابت2 + 1
        وضع1 = وضع1 - (وضع1 / 4294967296) * 4294967296
        مُبذَر = 1
    نهاية

    # خطوة PCG
    دالة خطوة()
        # PCG-XSH-RR
        وضع0 = وضع0 * 6364136223 + وضع1
        وضع0 = وضع0 - (وضع0 / 4294967296) * 4294967296
        عداد_التوليد = عداد_التوليد + 1
    نهاية

    # توليد 32 بت (محاكاة RDRAND)
    # ارجع -1 إذا فشل (محاكاة underflow)
    دالة رقم rdrand32()
        اذا (مُبذَر != 1)
            بذر(12345)
        نهاية

        # محاكاة فشل عشوائي
        متغير فحص_فشل = (وضع0 + عداد_التوليد) % 1000
        اذا (فحص_فشل < معدل_الفشل)
            خطوة()
            ارجع -1
        نهاية

        خطوة()
        # إنتاج القيمة
        متغير خرج = رد_حصأو(وضع0، رد_يمين(وضع0، 18))
        اذا (خرج < 0)
            خرج = خرج * (-1)
        نهاية
        ارجع خرج % 4294967296
    نهاية

    # توليد 64 بت (محاكاة RDRAND 64-bit)
    دالة رقم rdrand64()
        متغير سفلي = rdrand32()
        اذا (سفلي == -1)
            ارجع -1
        نهاية
        متغير علوي = rdrand32()
        اذا (علوي == -1)
            ارجع -1
        نهاية
        ارجع سفلي + علوي * 4294967296
    نهاية

    # محاكاة RDSEED 32 بت (أبطأ، عشوائية أعلى)
    دالة رقم rdseed32()
        # RDSEED أبطأ بـ ~10x من RDRAND
        # ومعدل فشله أعلى
        متغير فحص = (وضع0 + عداد_التوليد * 3) % 100
        اذا (فحص < 10)    # 10% فشل
            خطوة()
            ارجع -1
        نهاية

        # خطوات إضافية للتمييز عن RDRAND
        خطوة()
        خطوة()
        خطوة()

        متغير خرج = رد_حصأو(وضع0 * 7 + 3، رد_يمين(وضع1، 5))
        اذا (خرج < 0)
            خرج = خرج * (-1)
        نهاية
        ارجع خرج % 4294967296
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف مخزن RDRAND المؤقت
# ══════════════════════════════════════════════════════════════════════════════

صنف مخزن_RDRAND
    ## مخزن مؤقت يجمع مخرجات RDRAND لتقليل الاستدعاءات
    ## يملأ المخزن بالكامل ثم يقدم بايتاً بايتاً

    مصفوفة المخزن           # مصفوفة البايتات
    رقم الحجم               # حجم المخزن
    رقم فهرس_القراءة       # فهرس القراءة الحالي
    رقم ممتلئ               # هل المخزن ممتلئ؟

    باني()
        الحجم = حجم_مخزن_RDRAND
        المخزن = []
        متغير ف = 0
        بينما (ف < الحجم)
            المخزن += [0]
            ف = ف + 1
        نهاية
        فهرس_القراءة = الحجم
        ممتلئ = 0
    نهاية

    # ملء المخزن من مصدر RDRAND
    دالة رقم ملء(محاكي_RDRAND المصدر)
        متغير ف = 0
        بينما (ف < الحجم)
            # أخذ 4 بايتات من كل استدعاء RDRAND
            متغير محاولة = 0
            متغير نجح = 0
            بينما (محاولة < أقصى_محاولات_RDRAND)
                متغير قيمة = المصدر.rdrand32()
                اذا (قيمة >= 0)
                    المخزن[ف] = قيمة % 256
                    اذا (ف + 1 < الحجم)
                        المخزن[ف + 1] = رد_يمين(قيمة، 8) % 256
                    نهاية
                    اذا (ف + 2 < الحجم)
                        المخزن[ف + 2] = رد_يمين(قيمة، 16) % 256
                    نهاية
                    اذا (ف + 3 < الحجم)
                        المخزن[ف + 3] = رد_يمين(قيمة، 24) % 256
                    نهاية
                    نجح = 1
                    محاولة = أقصى_محاولات_RDRAND  # خروج
                نهاية
                محاولة = محاولة + 1
            نهاية

            اذا (نجح != 1)
                ارجع 0
            نهاية
            ف = ف + 4
        نهاية
        فهرس_القراءة = 0
        ممتلئ = 1
        ارجع 1
    نهاية

    # قراءة بايت من المخزن
    دالة رقم اقرأ_بايت()
        اذا (فهرس_القراءة >= الحجم)
            ارجع -1    # المخزن فارغ
        نهاية
        متغير البايت = المخزن[فهرس_القراءة]
        فهرس_القراءة = فهرس_القراءة + 1
        ارجع البايت
    نهاية

    # هل توجد بايتات متبقية؟
    دالة منطقي متاح()
        ارجع فهرس_القراءة < الحجم
    نهاية

    # البايتات المتبقية
    دالة رقم المتبقي()
        ارجع الحجم - فهرس_القراءة
    نهاية

    # مسح آمن للمخزن
    دالة مسح()
        متغير ف = 0
        بينما (ف < الحجم)
            المخزن[ف] = 0
            ف = ف + 1
        نهاية
        فهرس_القراءة = الحجم
        ممتلئ = 0
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف واجهة RDRAND الرئيسية
# ══════════════════════════════════════════════════════════════════════════════

صنف واجهة_RDRAND
    ## واجهة عالية المستوى لاستخدام RDRAND/RDSEED
    ## تدعم الكشف التلقائي والمحاكاة والمخزن المؤقت

    كاشف_CPUID الكاشف         # كاشف الميزات
    محاكي_RDRAND المحاكي       # محاكي RDRAND
    مخزن_RDRAND المخزن         # مخزن مؤقت
    رقم الوضع                  # وضع العمل
    رقم مُهيّأ                 # هل الواجهة مهيأة؟
    رقم إجمالي_الطلبات        # عدد الطلبات
    رقم إجمالي_الفشل          # عدد مرات الفشل
    رقم إجمالي_البايتات       # عدد البايتات المولّدة

    باني()
        الكاشف = جديد كاشف_CPUID()
        المحاكي = جديد محاكي_RDRAND()
        المخزن = جديد مخزن_RDRAND()
        الوضع = وضع_محاكاة
        مُهيّأ = 0
        إجمالي_الطلبات = 0
        إجمالي_الفشل = 0
        إجمالي_البايتات = 0
    نهاية

    # تهيئة مع كشف تلقائي
    دالة تهيئة()
        الكاشف.كشف()

        اذا (الكاشف.يدعم_RDRAND == 1)
            الوضع = وضع_أجهزة
            اطبع_سطر("  RDRAND: وضع الأجهزة")
        والا
            الوضع = وضع_محاكاة
            اطبع_سطر("  RDRAND: وضع المحاكاة (أجهزة غير متوفرة)")
        نهاية

        المحاكي.بذر(987654321)
        مُهيّأ = 1
    نهاية

    # تهيئة بوضع محدد
    دالة تهيئة_بوضع(رقم الوضع_م، رقم بذرة)
        الوضع = الوضع_م
        المحاكي.بذر(بذرة)
        مُهيّأ = 1
    نهاية

    # الحصول على 32 بت عشوائي
    دالة رقم عشوائي32()
        اذا (مُهيّأ != 1)
            تهيئة()
        نهاية

        إجمالي_الطلبات = إجمالي_الطلبات + 1

        # محاولة RDRAND مع إعادة المحاولة
        متغير محاولة = 0
        بينما (محاولة < أقصى_محاولات_RDRAND)
            متغير قيمة = المحاكي.rdrand32()
            اذا (قيمة >= 0)
                إجمالي_البايتات = إجمالي_البايتات + 4
                ارجع قيمة
            نهاية
            محاولة = محاولة + 1
        نهاية

        # فشل بعد كل المحاولات
        إجمالي_الفشل = إجمالي_الفشل + 1
        ارجع -1
    نهاية

    # الحصول على بذرة 32 بت (RDSEED)
    دالة رقم بذرة32()
        اذا (مُهيّأ != 1)
            تهيئة()
        نهاية

        إجمالي_الطلبات = إجمالي_الطلبات + 1

        متغير محاولة = 0
        بينما (محاولة < أقصى_محاولات_RDSEED)
            متغير قيمة = المحاكي.rdseed32()
            اذا (قيمة >= 0)
                إجمالي_البايتات = إجمالي_البايتات + 4
                ارجع قيمة
            نهاية
            محاولة = محاولة + 1
        نهاية

        إجمالي_الفشل = إجمالي_الفشل + 1
        ارجع -1
    نهاية

    # الحصول على بايت عشوائي واحد
    دالة رقم بايت_عشوائي()
        # أولاً من المخزن المؤقت
        اذا (المخزن.متاح())
            إجمالي_البايتات = إجمالي_البايتات + 1
            ارجع المخزن.اقرأ_بايت()
        نهاية

        # إعادة ملء المخزن
        متغير نجح = المخزن.ملء(المحاكي)
        اذا (نجح == 1)
            إجمالي_البايتات = إجمالي_البايتات + 1
            ارجع المخزن.اقرأ_بايت()
        نهاية

        # فشل: توليد مباشر
        متغير قيمة = عشوائي32()
        اذا (قيمة >= 0)
            ارجع قيمة % 256
        نهاية
        ارجع -1
    نهاية

    # الحصول على مصفوفة بايتات عشوائية
    دالة مصفوفة بايتات_عشوائية(رقم العدد)
        متغير النتيجة = []
        متغير ف = 0
        بينما (ف < العدد)
            متغير ب = بايت_عشوائي()
            اذا (ب >= 0)
                النتيجة += [ب]
            والا
                النتيجة += [0]    # قيمة بديلة عند الفشل
            نهاية
            ف = ف + 1
        نهاية
        ارجع النتيجة
    نهاية

    # الحصول على بذرة 32 بايت (للمولد العشوائي)
    دالة مصفوفة بذرة_256بت()
        متغير البذرة = []
        متغير ف = 0
        بينما (ف < 8)
            متغير قيمة = بذرة32()
            اذا (قيمة < 0)
                قيمة = عشوائي32()
            نهاية
            اذا (قيمة < 0)
                قيمة = 0
            نهاية
            البذرة += [قيمة % 256]
            البذرة += [رد_يمين(قيمة، 8) % 256]
            البذرة += [رد_يمين(قيمة، 16) % 256]
            البذرة += [رد_يمين(قيمة، 24) % 256]
            ف = ف + 1
        نهاية
        ارجع البذرة
    نهاية

    # هل RDRAND متوفر؟
    دالة منطقي rdrand_متوفر()
        ارجع الكاشف.يدعم_RDRAND == 1
    نهاية

    # هل RDSEED متوفر؟
    دالة منطقي rdseed_متوفر()
        ارجع الكاشف.يدعم_RDSEED == 1
    نهاية

    # إحصائيات
    دالة اطبع_إحصائيات()
        اطبع_سطر("── إحصائيات RDRAND ──")
        اطبع("  الوضع: ")
        اذا (الوضع == وضع_أجهزة)
            اطبع_سطر("أجهزة")
        والا_اذا (الوضع == وضع_محاكاة)
            اطبع_سطر("محاكاة")
        والا
            اطبع_سطر("هجين")
        نهاية
        اطبع("  الطلبات: ")
        اطبع_سطر(إجمالي_الطلبات)
        اطبع("  الفشل: ")
        اطبع_سطر(إجمالي_الفشل)
        اطبع("  البايتات: ")
