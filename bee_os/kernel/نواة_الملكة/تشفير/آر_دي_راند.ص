#              صنف مراقب جودة RDRAND
# ══════════════════════════════════════════════════════════════════════════════

صنف مراقب_جودة_RDRAND
    ## يراقب جودة مخرجات RDRAND ويكتشف الأنماط المشبوهة

    مصفوفة سجل_القيم          # آخر N قيمة
    رقم حجم_السجل
    رقم فهرس_السجل
    رقم عداد_الفحوصات
    رقم عداد_التحذيرات

    باني()
        حجم_السجل = 64
        سجل_القيم = []
        متغير ف = 0
        بينما (ف < حجم_السجل)
            سجل_القيم += [0]
            ف = ف + 1
        نهاية
        فهرس_السجل = 0
        عداد_الفحوصات = 0
        عداد_التحذيرات = 0
    نهاية

    # فحص قيمة جديدة
    دالة منطقي افحص(رقم قيمة)
        عداد_الفحوصات = عداد_الفحوصات + 1

        # تسجيل القيمة
        سجل_القيم[فهرس_السجل] = قيمة
        فهرس_السجل = (فهرس_السجل + 1) % حجم_السجل

        # فحص 1: القيمة ليست صفراً
        اذا (قيمة == 0)
            عداد_التحذيرات = عداد_التحذيرات + 1
            ارجع خطأ
        نهاية

        # فحص 2: القيمة ليست أقصى قيمة
        اذا (قيمة == 4294967295)
            عداد_التحذيرات = عداد_التحذيرات + 1
            ارجع خطأ
        نهاية

        # فحص 3: هل القيمة مكررة في السجل الحديث؟
        متغير تكرارات = 0
        متغير ف = 0
        بينما (ف < حجم_السجل)
            اذا (سجل_القيم[ف] == قيمة)
                تكرارات = تكرارات + 1
            نهاية
            ف = ف + 1
        نهاية

        اذا (تكرارات > 3)
            عداد_التحذيرات = عداد_التحذيرات + 1
            ارجع خطأ
        نهاية

        # فحص 4: توزيع البتات (تقريبي)
        متغير واحدات = 0
        متغير مؤقت = قيمة
        بينما (مؤقت > 0)
            واحدات = واحدات + (مؤقت % 2)
            مؤقت = (مؤقت - (مؤقت % 2)) / 2
        نهاية

        # يجب أن يكون عدد الواحدات بين 8 و 24 (من 32 بت)
        اذا (واحدات < 4 || واحدات > 28)
            عداد_التحذيرات = عداد_التحذيرات + 1
            ارجع خطأ
        نهاية

        ارجع صحيح
    نهاية

    # نسبة التحذيرات
    دالة رقم نسبة_التحذيرات()
        اذا (عداد_الفحوصات == 0)
            ارجع 0
        نهاية
        ارجع (عداد_التحذيرات * 100) / عداد_الفحوصات
    نهاية

    # هل الجودة مقبولة؟
    دالة منطقي جودة_مقبولة()
        ارجع نسبة_التحذيرات() < 5
    نهاية
نهاية


