#
# نظام شهادات X.509 مبسط لنواة النحلة
#
# البنية الهرمية:
# ═══════════════════
# شهادة الجذر (Root CA)
#   └── شهادة وسيطة (Intermediate CA)
#         └── شهادة الكيان النهائي (End Entity)
#
# كل شهادة تحتوي:
# - معلومات الموضوع (Subject)
# - المُصدِر (Issuer)
# - المفتاح العام
# - فترة الصلاحية
# - الامتدادات (Extensions)
# - التوقيع
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
#                           الثوابت
# ══════════════════════════════════════════════════════════════════════════════

# أنواع الشهادات
ثابت شهادة_جذر = 1
ثابت شهادة_وسيطة = 2
ثابت شهادة_كيان = 3

# حالة الشهادة
ثابت شهادة_صالحة = 0
ثابت شهادة_منتهية = 1
ثابت شهادة_ملغاة = 2
ثابت شهادة_غير_موثوقة = 3
ثابت شهادة_توقيع_فاشل = 4

# استخدامات المفتاح
ثابت استخدام_توقيع = 1
ثابت استخدام_تشفير = 2
ثابت استخدام_توقيع_شهادات = 4
ثابت استخدام_توقيع_CRL = 8

# أحجام
ثابت حجم_رقم_تسلسلي = 8
ثابت حجم_تجزئة_شهادة = 32
ثابت حجم_توقيع_شهادة = 64


# ══════════════════════════════════════════════════════════════════════════════
#                      دوال مساعدة
# ══════════════════════════════════════════════════════════════════════════════

دالة مصفوفة شه_تجزئة(مصفوفة البيانات)
    متغير ح = [1779033703، 3144134277، 1013904242، 2773480762، 1359893119، 2600822924، 528734635، 1541459225]
    متغير ف = 0
    بينما (ف < عدد البيانات)
        متغير ب = البيانات[ف]
        متغير ق = 0
        بينما (ق < 8)
            ح[ق] = (ح[ق] + ب * (2654435761 + ق * 1000000007)) % 4294967296
            اذا (ح[ق] < 0)
                ح[ق] = ح[ق] * (-1)
            نهاية
            ق = ق + 1
        نهاية
        ف = ف + 1
    نهاية
    متغير النتيجة = []
    متغير ق2 = 0
    بينما (ق2 < 8)
        متغير ر = ح[ق2]
        النتيجة += [ر % 256]
        النتيجة += [(ر / 256) % 256]
        النتيجة += [(ر / 65536) % 256]
        النتيجة += [(ر / 16777216) % 256]
        ق2 = ق2 + 1
    نهاية
    ارجع النتيجة
نهاية

دالة منطقي شه_مقارنة(مصفوفة أ، مصفوفة ب)
    اذا (عدد أ != عدد ب)
        ارجع خطأ
    نهاية
    متغير فرق = 0
    متغير ف = 0
    بينما (ف < عدد أ)
        متغير د = أ[ف] - ب[ف]
        اذا (د < 0)
            د = د * (-1)
        نهاية
        فرق = فرق + د
        ف = ف + 1
    نهاية
    ارجع فرق == 0
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف معلومات الموضوع (Subject Info)
# ══════════════════════════════════════════════════════════════════════════════

صنف معلومات_موضوع
    نص الاسم_الشائع          # Common Name (CN)
    نص المنظمة              # Organization (O)
    نص الوحدة               # Organizational Unit (OU)
    نص البلد                # Country (C)
    نص المعرّف_الفريد       # Unique ID

    باني(نص اسم)
        الاسم_الشائع = اسم
        المنظمة = ""
        الوحدة = ""
        البلد = ""
        المعرّف_الفريد = ""
    نهاية

    دالة عيّن_المنظمة(نص منظمة، نص وحدة_م، نص بلد_م)
        المنظمة = منظمة
        الوحدة = وحدة_م
        البلد = بلد_م
    نهاية

    # تحويل إلى بايتات للتجزئة
    دالة مصفوفة إلى_بايتات()
        متغير النتيجة = []
        # تحويل الاسم لبايتات (محاكاة بسيطة)
        متغير ف = 0
        بينما (ف < عدد الاسم_الشائع)
            النتيجة += [(ف + 1) * 17 % 256]
            ف = ف + 1
        نهاية
        ارجع النتيجة
    نهاية

    دالة اطبع_المعلومات()
        اطبع("    CN=")
        اطبع(الاسم_الشائع)
        اذا (المنظمة != "")
            اطبع("، O=")
            اطبع(المنظمة)
        نهاية
        اذا (البلد != "")
            اطبع("، C=")
            اطبع(البلد)
        نهاية
        اطبع_سطر("")
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف امتدادات الشهادة (Extensions)
# ══════════════════════════════════════════════════════════════════════════════

صنف امتدادات_شهادة
    ## امتدادات X.509 v3

    منطقي CA                  # هل هذه شهادة CA؟
    رقم أقصى_عمق_سلسلة       # أقصى عمق (pathLenConstraint)
    رقم استخدامات_المفتاح    # استخدامات المفتاح (bitfield)
    منطقي حرج_CA             # هل امتداد CA حرج؟

    باني()
        CA = خطأ
        أقصى_عمق_سلسلة = 0
        استخدامات_المفتاح = استخدام_توقيع
        حرج_CA = خطأ
    نهاية

    # تعيين كشهادة CA
    دالة عيّن_CA(رقم عمق)
        CA = صحيح
        أقصى_عمق_سلسلة = عمق
        حرج_CA = صحيح
        استخدامات_المفتاح = استخدام_توقيع_شهادات + استخدام_توقيع_CRL
    نهاية

    # هل مسموح بتوقيع شهادات؟
    دالة منطقي مسموح_توقيع_شهادات()
        اذا (CA != صحيح)
            ارجع خطأ
        نهاية
        # التحقق من بت استخدام_توقيع_شهادات
        متغير قسمة = استخدامات_المفتاح / استخدام_توقيع_شهادات
        ارجع قسمة % 2 >= 1
    نهاية

    دالة اطبع_المعلومات()
        اطبع("    CA: ")
        اذا (CA)
            اطبع("نعم")
            اطبع("، أقصى عمق: ")
            اطبع_سطر(أقصى_عمق_سلسلة)
        والا
            اطبع_سطر("لا")
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف الشهادة الرقمية (Digital Certificate)
# ══════════════════════════════════════════════════════════════════════════════

صنف شهادة
    ## شهادة رقمية X.509 مبسطة

    رقم الإصدار                       # إصدار X.509 (3)
    مصفوفة الرقم_التسلسلي            # الرقم التسلسلي
    رقم النوع                         # نوع الشهادة
    معلومات_موضوع الموضوع             # معلومات الموضوع
    معلومات_موضوع المُصدِر            # معلومات المُصدِر
    مصفوفة المفتاح_العام             # المفتاح العام (32 بايت)
    رقم الصلاحية_من                   # بداية الصلاحية
    رقم الصلاحية_إلى                  # نهاية الصلاحية
    امتدادات_شهادة الامتدادات         # الامتدادات
    مصفوفة التوقيع                    # التوقيع (64 بايت)
    مصفوفة البصمة                     # بصمة الشهادة (32 بايت)
    رقم الحالة_م                       # حالة التحقق
    منطقي موثوقة                      # هل موثوقة؟

    باني(نص اسم_الموضوع، رقم نوع_ش)
        الإصدار = 3
        الرقم_التسلسلي = []
        النوع = نوع_ش
        الموضوع = جديد معلومات_موضوع(اسم_الموضوع)
        المُصدِر = جديد معلومات_موضوع("")
        المفتاح_العام = []
        الصلاحية_من = 0
        الصلاحية_إلى = 999999999
        الامتدادات = جديد امتدادات_شهادة()
        التوقيع = []
        البصمة = []
        الحالة_م = شهادة_غير_موثوقة
        موثوقة = خطأ

        # إذا كانت جذر → CA
        اذا (نوع_ش == شهادة_جذر)
            الامتدادات.عيّن_CA(3)
        والا_اذا (نوع_ش == شهادة_وسيطة)
            الامتدادات.عيّن_CA(1)
        نهاية
    نهاية

    # تعيين الرقم التسلسلي
    دالة عيّن_رقم_تسلسلي(مصفوفة رقم_ت)
        الرقم_التسلسلي = رقم_ت
    نهاية

    # تعيين المفتاح العام
    دالة عيّن_مفتاح(مصفوفة مفتاح)
        المفتاح_العام = مفتاح
    نهاية

    # تعيين فترة الصلاحية
    دالة عيّن_صلاحية(رقم بداية، رقم نهاية_ص)
        الصلاحية_من = بداية
        الصلاحية_إلى = نهاية_ص
    نهاية

    # تعيين المُصدِر
    دالة عيّن_المُصدِر(نص اسم_المصدر)
        المُصدِر = جديد معلومات_موضوع(اسم_المصدر)
    نهاية

    # حساب بصمة الشهادة
    دالة احسب_البصمة()
        متغير بيانات = []
        # إضافة بيانات الموضوع
        متغير بيانات_موضوع = الموضوع.إلى_بايتات()
        متغير ف = 0
        بينما (ف < عدد بيانات_موضوع)
            بيانات += [بيانات_موضوع[ف]]
            ف = ف + 1
        نهاية
        # إضافة المفتاح العام
        ف = 0
        بينما (ف < عدد المفتاح_العام)
            بيانات += [المفتاح_العام[ف]]
            ف = ف + 1
        نهاية
        # إضافة فترة الصلاحية
        بيانات += [الصلاحية_من % 256]
        بيانات += [(الصلاحية_من / 256) % 256]
        بيانات += [الصلاحية_إلى % 256]
        بيانات += [(الصلاحية_إلى / 256) % 256]

        البصمة = شه_تجزئة(بيانات)
    نهاية

    # التوقيع بمفتاح خاص (محاكاة)
    دالة وقّع(مصفوفة مفتاح_التوقيع)
        احسب_البصمة()
        # توقيع = Hash(بصمة || مفتاح_التوقيع)
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد البصمة)
            مدخل += [البصمة[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد مفتاح_التوقيع)
            مدخل += [مفتاح_التوقيع[ف]]
            ف = ف + 1
        نهاية
        متغير تج = شه_تجزئة(مدخل)
        # تمديد إلى 64 بايت
        التوقيع = []
        ف = 0
        بينما (ف < عدد تج)
            التوقيع += [تج[ف]]
            ف = ف + 1
        نهاية
        # النصف الثاني
        متغير مدخل2 = []
        ف = 0
        بينما (ف < عدد تج)
            مدخل2 += [تج[ف]]
            ف = ف + 1
        نهاية
        مدخل2 += [42]
        متغير تج2 = شه_تجزئة(مدخل2)
        ف = 0
        بينما (ف < عدد تج2)
            التوقيع += [تج2[ف]]
            ف = ف + 1
        نهاية
    نهاية

    # هل الشهادة صالحة زمنياً؟
    دالة منطقي صالحة_الآن(رقم الوقت)
        اذا (الوقت < الصلاحية_من)
            ارجع خطأ
        نهاية
        اذا (الوقت > الصلاحية_إلى)
            ارجع خطأ
        نهاية
        ارجع صحيح
    نهاية

    # هل شهادة ذاتية التوقيع؟
    دالة منطقي ذاتية_التوقيع()
        ارجع الموضوع.الاسم_الشائع == المُصدِر.الاسم_الشائع
    نهاية

    # طباعة معلومات الشهادة
    دالة اطبع_المعلومات()
        اطبع_سطر("  ┌─── شهادة رقمية ───")
        اطبع("  │ النوع: ")
        اذا (النوع == شهادة_جذر)
            اطبع_سطر("جذر (Root CA)")
        والا_اذا (النوع == شهادة_وسيطة)
            اطبع_سطر("وسيطة (Intermediate CA)")
        والا
            اطبع_سطر("كيان نهائي (End Entity)")
        نهاية
        اطبع("  │ الموضوع: ")
        اطبع_سطر(الموضوع.الاسم_الشائع)
        اطبع("  │ المُصدِر: ")
        اطبع_سطر(المُصدِر.الاسم_الشائع)
        اطبع("  │ الصلاحية: ")
        اطبع(الصلاحية_من)
        اطبع(" → ")
        اطبع_سطر(الصلاحية_إلى)
        اطبع("  │ الحالة: ")
        اذا (الحالة_م == شهادة_صالحة)
            اطبع_سطر("✓ صالحة")
        والا_اذا (الحالة_م == شهادة_منتهية)
            اطبع_سطر("✗ منتهية")
        والا_اذا (الحالة_م == شهادة_ملغاة)
            اطبع_سطر("✗ ملغاة")
        والا
            اطبع_سطر("? غير موثوقة")
        نهاية
        الامتدادات.اطبع_المعلومات()
        اطبع_سطر("  └────────────────────")
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف مخزن الشهادات الموثوقة (Trust Store)
# ══════════════════════════════════════════════════════════════════════════════

صنف مخزن_الثقة
    ## مخزن شهادات الجذر الموثوقة

    مصفوفة الشهادات           # شهادات الجذر الموثوقة
    مصفوفة الملغاة            # أرقام تسلسلية ملغاة

    باني()
        الشهادات = []
        الملغاة = []
    نهاية

    # إضافة شهادة جذر موثوقة
    دالة أضف(شهادة الشه)
        الشه.موثوقة = صحيح
        الشه.الحالة_م = شهادة_صالحة
        الشهادات += [الشه]
    نهاية

    # البحث عن شهادة بالاسم
    دالة شهادة ابحث(نص اسم)
        متغير ف = 0
        بينما (ف < عدد الشهادات)
            اذا (الشهادات[ف].الموضوع.الاسم_الشائع == اسم)
                ارجع الشهادات[ف]
            نهاية
            ف = ف + 1
        نهاية
        # لم تُوجد
        متغير فارغة = جديد شهادة("غير_موجودة"، شهادة_كيان)
        فارغة.الحالة_م = شهادة_غير_موثوقة
        ارجع فارغة
    نهاية

    # هل الرقم التسلسلي ملغى؟
    دالة منطقي ملغى(مصفوفة رقم_ت)
        متغير ف = 0
        بينما (ف < عدد الملغاة)
            اذا (شه_مقارنة(الملغاة[ف]، رقم_ت))
                ارجع صحيح
            نهاية
            ف = ف + 1
        نهاية
        ارجع خطأ
    نهاية

    # إلغاء شهادة
    دالة ألغِ(مصفوفة رقم_ت)
        الملغاة += [رقم_ت]
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#          صنف سلسلة الشهادات (Certificate Chain)
# ══════════════════════════════════════════════════════════════════════════════

صنف سلسلة_الشهادات
    ## يبني ويتحقق من سلسلة شهادات كاملة

    مصفوفة السلسلة            # الشهادات مرتبة (كيان → وسيطة → جذر)
    مخزن_الثقة المخزن         # مخزن شهادات الجذر
    رقم أقصى_عمق              # أقصى عمق مسموح
    رقم الحالة_م               # حالة السلسلة

    باني()
        السلسلة = []
        المخزن = جديد مخزن_الثقة()
        أقصى_عمق = 5
        الحالة_م = شهادة_غير_موثوقة
    نهاية

    # تعيين مخزن الثقة
    دالة عيّن_المخزن(مخزن_الثقة مخزن)
        المخزن = مخزن
    نهاية

    # إضافة شهادة للسلسلة
    دالة أضف(شهادة الشه)
        السلسلة += [الشه]
    نهاية

    # التحقق من الشهادات بالتسلسل
    دالة رقم تحقق(رقم الوقت_الحالي)
        اطبع_سطر("  ── التحقق من سلسلة الشهادات ──")

        اذا (عدد السلسلة == 0)
            اطبع_سطر("  ✗ السلسلة فارغة")
            ارجع شهادة_غير_موثوقة
        نهاية

        # التحقق من العمق
        اذا (عدد السلسلة > أقصى_عمق)
            اطبع_سطر("  ✗ السلسلة أعمق من الحد المسموح")
            ارجع شهادة_غير_موثوقة
        نهاية

        # التحقق من كل شهادة
        متغير ف = 0
        بينما (ف < عدد السلسلة)
            متغير الشه = السلسلة[ف]

            # 1. التحقق من الصلاحية الزمنية
            اذا (الشه.صالحة_الآن(الوقت_الحالي) != صحيح)
                اطبع("  ✗ شهادة منتهية: ")
                اطبع_سطر(الشه.الموضوع.الاسم_الشائع)
                الشه.الحالة_م = شهادة_منتهية
                الحالة_م = شهادة_منتهية
                ارجع شهادة_منتهية
            نهاية

            # 2. التحقق من الإلغاء
            اذا (عدد الشه.الرقم_التسلسلي > 0)
                اذا (المخزن.ملغى(الشه.الرقم_التسلسلي))
                    اطبع("  ✗ شهادة ملغاة: ")
                    اطبع_سطر(الشه.الموضوع.الاسم_الشائع)
                    الشه.الحالة_م = شهادة_ملغاة
                    الحالة_م = شهادة_ملغاة
                    ارجع شهادة_ملغاة
                نهاية
            نهاية

            # 3. التحقق من أن الشهادة الوسيطة CA
            اذا (ف < عدد السلسلة - 1)
                # ليست الشهادة الأخيرة (كيان)
                اذا (الشه.الامتدادات.CA != صحيح)
                    اذا (الشه.النوع != شهادة_كيان)
                        اطبع("  ✗ شهادة غير CA في منتصف السلسلة: ")
                        اطبع_سطر(الشه.الموضوع.الاسم_الشائع)
                        الحالة_م = شهادة_غير_موثوقة
                        ارجع شهادة_غير_موثوقة
                    نهاية
                نهاية
            نهاية

            # 4. التحقق من التوقيع
            اذا (عدد الشه.التوقيع >= حجم_توقيع_شهادة)
                # التوقيع موجود
                متغير مجموع_توقيع = 0
                متغير ق = 0
                بينما (ق < عدد الشه.التوقيع)
                    مجموع_توقيع = مجموع_توقيع + الشه.التوقيع[ق]
                    ق = ق + 1
                نهاية
                اذا (مجموع_توقيع > 0)
                    الشه.الحالة_م = شهادة_صالحة
                    اطبع("  ✓ ")
                    اطبع(الشه.الموضوع.الاسم_الشائع)
                    اطبع_سطر(": توقيع صالح")
                والا
                    اطبع("  ✗ توقيع فارغ: ")
                    اطبع_سطر(الشه.الموضوع.الاسم_الشائع)
                    الحالة_م = شهادة_توقيع_فاشل
                    ارجع شهادة_توقيع_فاشل
                نهاية
            والا
                اطبع("  ✗ لا توقيع: ")
                اطبع_سطر(الشه.الموضوع.الاسم_الشائع)
                الحالة_م = شهادة_توقيع_فاشل
                ارجع شهادة_توقيع_فاشل
            نهاية

            ف = ف + 1
        نهاية

        # 5. التحقق من أن شهادة الجذر موثوقة
        متغير جذر = السلسلة[0]
        متغير جذر_موثوق = المخزن.ابحث(جذر.الموضوع.الاسم_الشائع)
        اذا (جذر_موثوق.موثوقة)
            اطبع_سطر("  ✓ شهادة الجذر موثوقة")
            الحالة_م = شهادة_صالحة
        والا
            اذا (جذر.ذاتية_التوقيع())
                اطبع_سطر("  ⚠ شهادة ذاتية التوقيع (قد لا تكون موثوقة)")
                الحالة_م = شهادة_صالحة
            والا
                اطبع_سطر("  ✗ شهادة الجذر غير موثوقة")
                الحالة_م = شهادة_غير_موثوقة
                ارجع شهادة_غير_موثوقة
            نهاية
        نهاية

        اطبع_سطر("  ✅ سلسلة الشهادات صالحة")
        ارجع شهادة_صالحة
    نهاية

    # طباعة السلسلة
    دالة اطبع_السلسلة()
        اطبع_سطر("── سلسلة الشهادات ──")
        متغير ف = 0
        بينما (ف < عدد السلسلة)
            اطبع("  [")
            اطبع(ف)
            اطبع("]")
            السلسلة[ف].اطبع_المعلومات()
            ف = ف + 1
        نهاية
    نهاية
