# ══════════════════════════════════════════════════════════════════════════════
#                           الثوابت
# ══════════════════════════════════════════════════════════════════════════════

# رموز الأوامر (Command Codes)
ثابت أمر_GetCapability = 0x17A
ثابت أمر_SelfTest = 0x143
ثابت أمر_PCR_Event = 0x13C
ثابت أمر_NV_Increment = 0x134
ثابت أمر_NV_SetBits = 0x135
ثابت أمر_PolicyPCR = 0x17F
ثابت أمر_PolicySecret = 0x151
ثابت أمر_MakeCredential = 0x168
ثابت أمر_ActivateCredential = 0x147
ثابت أمر_Certify = 0x148
ثابت أمر_GetRandom = 0x17B
ثابت أمر_StirRandom = 0x146
ثابت أمر_DA_Reset = 0x139
ثابت أمر_Clear = 0x126

# أنواع القدرات
ثابت قدرة_خوارزميات = 1
ثابت قدرة_مقابض = 2
ثابت قدرة_أوامر = 3
ثابت قدرة_خصائص = 4
ثابت قدرة_PCR = 5

# نتائج الاختبار الذاتي
ثابت اختبار_نجاح = 0
ثابت اختبار_فشل = 1
ثابت اختبار_غير_مكتمل = 2

# رموز الاستجابة
ثابت أمر_نجاح = 0
ثابت أمر_فشل = 1
ثابت أمر_غير_مصرح = 2
ثابت أمر_نطاق_خاطئ = 3
ثابت أمر_مقفل = 4

# حماية القاموس
ثابت أقصى_محاولات_فاشلة = 10
ثابت وقت_القفل = 3600


# ══════════════════════════════════════════════════════════════════════════════
#                      دوال مساعدة
# ══════════════════════════════════════════════════════════════════════════════

دالة مصفوفة أمر_تجزئة(مصفوفة البيانات)
    متغير ح = [1779033703، 3144134277، 1013904242، 2773480762، 1359893119، 2600822924، 528734635، 1541459225]
    متغير ف = 0
    بينما (ف < عدد البيانات)
        متغير ب = البيانات[ف]
        متغير ق = 0
        بينما (ق < 8)
            ح[ق] = (ح[ق] + ب * (2654435761 + ق * 1000000007)) % 4294967296
            اذا (ح[ق] < 0)
                ح[ق] = ح[ق] * (-1)
            نهاية
            ق = ق + 1
        نهاية
        ف = ف + 1
    نهاية
    متغير النتيجة = []
    متغير ق2 = 0
    بينما (ق2 < 8)
        متغير ر = ح[ق2]
        النتيجة += [ر % 256]
        النتيجة += [(ر / 256) % 256]
        النتيجة += [(ر / 65536) % 256]
        النتيجة += [(ر / 16777216) % 256]
        ق2 = ق2 + 1
    نهاية
    ارجع النتيجة
نهاية

دالة رقم أمر_حصأو(رقم أ، رقم ب)
    متغير نت = 0
    متغير بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 8)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 != ب2)
            نت = نت + بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        بت = بت * 2
        ع = ع + 1
    نهاية
    ارجع نت
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف نتيجة الأمر (Command Response)
# ══════════════════════════════════════════════════════════════════════════════

صنف نتيجة_أمر
    ## يحمل نتيجة تنفيذ أمر TPM

    رقم الرمز                   # رمز الاستجابة
    مصفوفة البيانات            # بيانات الاستجابة
    رقم رمز_الأمر              # رمز الأمر الأصلي
    نص الرسالة                 # رسالة وصفية

    باني(رقم رمز، رقم أمر)
        الرمز = رمز
        رمز_الأمر = أمر
        البيانات = []
        الرسالة = ""
    نهاية

    دالة منطقي ناجح()
        ارجع الرمز == أمر_نجاح
    نهاية

    دالة اطبع()
        اطبع("    أمر=")
        اطبع(رمز_الأمر)
        اطبع(" نتيجة=")
        اذا (الرمز == أمر_نجاح)
            اطبع("نجاح")
        والا_اذا (الرمز == أمر_غير_مصرح)
            اطبع("غير مصرح")
        والا_اذا (الرمز == أمر_مقفل)
            اطبع("مقفل")
        والا
            اطبع("فشل")
        نهاية
        اذا (الرسالة != "")
            اطبع(" [")
            اطبع(الرسالة)
            اطبع("]")
        نهاية
        اطبع_سطر("")
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف سياسة TPM (Policy)
# ══════════════════════════════════════════════════════════════════════════════

صنف سياسة_TPM
    ## تمثل سياسة تحكم بالوصول

    مصفوفة ملخص_السياسة       # Policy digest
    مصفوفة شروط_PCR           # فهارس PCR المطلوبة
    مصفوفة قيم_PCR_المطلوبة   # قيم PCR المطلوبة
    منطقي يتطلب_سر             # هل يتطلب كلمة مرور؟
    مصفوفة السر_المجزأ        # تجزئة كلمة المرور

    باني()
        ملخص_السياسة = []
        شروط_PCR = []
        قيم_PCR_المطلوبة = []
        يتطلب_سر = خطأ
        السر_المجزأ = []

        # تهيئة الملخص
        متغير ف = 0
        بينما (ف < 32)
            ملخص_السياسة += [0]
            ف = ف + 1
        نهاية
    نهاية

    # إضافة شرط PCR
    دالة أضف_شرط_PCR(رقم فهرس، مصفوفة القيمة_المطلوبة)
        شروط_PCR += [فهرس]

        # حفظ القيمة المطلوبة
        متغير ف = 0
        بينما (ف < عدد القيمة_المطلوبة)
            قيم_PCR_المطلوبة += [القيمة_المطلوبة[ف]]
            ف = ف + 1
        نهاية

        # تحديث الملخص
        متغير مدخل = []
        ف = 0
        بينما (ف < عدد ملخص_السياسة)
            مدخل += [ملخص_السياسة[ف]]
            ف = ف + 1
        نهاية
        مدخل += [أمر_PolicyPCR % 256]
        مدخل += [فهرس]
        ف = 0
        بينما (ف < عدد القيمة_المطلوبة)
            مدخل += [القيمة_المطلوبة[ف]]
            ف = ف + 1
        نهاية
        ملخص_السياسة = أمر_تجزئة(مدخل)
    نهاية

    # إضافة شرط كلمة مرور
    دالة أضف_شرط_سر(مصفوفة السر)
        يتطلب_سر = صحيح
        السر_المجزأ = أمر_تجزئة(السر)

        # تحديث الملخص
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد ملخص_السياسة)
            مدخل += [ملخص_السياسة[ف]]
            ف = ف + 1
        نهاية
        مدخل += [أمر_PolicySecret % 256]
        ف = 0
        بينما (ف < عدد السر_المجزأ)
            مدخل += [السر_المجزأ[ف]]
            ف = ف + 1
        نهاية
        ملخص_السياسة = أمر_تجزئة(مدخل)
    نهاية

    # التحقق من شروط PCR
    دالة منطقي تحقق_PCR(مصفوفة قيم_PCR_حالية)
        اذا (عدد شروط_PCR == 0)
            ارجع صحيح
        نهاية

        متغير متطابق = صحيح
        متغير ف = 0
        بينما (ف < عدد قيم_PCR_حالية)
            اذا (ف < عدد قيم_PCR_المطلوبة)
                اذا (قيم_PCR_حالية[ف] != قيم_PCR_المطلوبة[ف])
                    متطابق = خطأ
                نهاية
            نهاية
            ف = ف + 1
        نهاية
        ارجع متطابق
    نهاية

    # التحقق من كلمة المرور
    دالة منطقي تحقق_سر(مصفوفة السر)
        اذا (يتطلب_سر != صحيح)
            ارجع صحيح
        نهاية
        متغير تجزئة = أمر_تجزئة(السر)
        متغير ف = 0
        بينما (ف < عدد تجزئة)
            اذا (ف < عدد السر_المجزأ)
                اذا (تجزئة[ف] != السر_المجزأ[ف])
                    ارجع خطأ
                نهاية
            نهاية
            ف = ف + 1
        نهاية
        ارجع صحيح
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              صنف حماية القاموس (Dictionary Attack)
# ══════════════════════════════════════════════════════════════════════════════

صنف حماية_القاموس
    ## يحمي من هجمات القاموس على كلمات المرور

    رقم المحاولات_الفاشلة
    رقم أقصى_محاولات
    رقم وقت_الإغلاق            # مدة الإغلاق (ثوانٍ)
    رقم وقت_آخر_فشل           # وقت آخر محاولة فاشلة
    منطقي مغلق                 # هل مغلق حالياً؟

    باني()
        المحاولات_الفاشلة = 0
        أقصى_محاولات = أقصى_محاولات_فاشلة
        وقت_الإغلاق = وقت_القفل
        وقت_آخر_فشل = 0
        مغلق = خطأ
    نهاية

    # تسجيل محاولة فاشلة
    دالة سجّل_فشل(رقم الوقت)
        المحاولات_الفاشلة = المحاولات_الفاشلة + 1
        وقت_آخر_فشل = الوقت

        اذا (المحاولات_الفاشلة >= أقصى_محاولات)
            مغلق = صحيح
            اطبع_سطر("  ⚠ حماية القاموس: تم الإغلاق!")
        نهاية
    نهاية

    # تسجيل محاولة ناجحة
    دالة سجّل_نجاح()
        المحاولات_الفاشلة = 0
        مغلق = خطأ
    نهاية

    # هل مسموح بالمحاولة؟
    دالة منطقي مسموح(رقم الوقت)
        اذا (مغلق != صحيح)
            ارجع صحيح
        نهاية

        # التحقق من انتهاء مدة الإغلاق
        اذا (الوقت - وقت_آخر_فشل >= وقت_الإغلاق)
            مغلق = خطأ
            المحاولات_الفاشلة = 0
            اطبع_سطر("  حماية القاموس: تم رفع الإغلاق تلقائياً")
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    # إعادة تعيين (بصلاحيات المالك)
    دالة إعادة_تعيين()
        المحاولات_الفاشلة = 0
        مغلق = خطأ
        اطبع_سطر("  حماية القاموس: تمت إعادة التعيين")
    نهاية

    # طباعة الحالة
    دالة اطبع_حالة()
        اطبع("  DA: محاولات فاشلة=")
        اطبع(المحاولات_الفاشلة)
        اطبع("/")
        اطبع(أقصى_محاولات)
        اذا (مغلق)
            اطبع(" [مغلق]")
        نهاية
        اطبع_سطر("")
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#          صنف مولد العشوائية TPM (RNG)
# ══════════════════════════════════════════════════════════════════════════════

صنف مولد_عشوائية_TPM
    ## مولد أرقام عشوائية لوحدة TPM

    مصفوفة حالة_المولد         # الحالة الداخلية (32 بايت)
    رقم عداد_التوليد

    باني()
        حالة_المولد = []
        متغير ف = 0
        بينما (ف < 32)
            حالة_المولد += [0]
            ف = ف + 1
        نهاية
        عداد_التوليد = 0
    نهاية

    # تهيئة بالبذرة
    دالة هيّئ(رقم بذرة)
        متغير بيانات = []
        متغير ف = 0
        بينما (ف < 32)
            بيانات += [(بذرة * (ف + 1) * 2654435761) % 256]
            اذا (بيانات[ف] < 0)
                بيانات[ف] = بيانات[ف] * (-1)
            نهاية
            ف = ف + 1
        نهاية
        حالة_المولد = أمر_تجزئة(بيانات)
    نهاية

    # إضافة إنتروبي (StirRandom)
    دالة أضف_إنتروبي(مصفوفة البيانات)
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد حالة_المولد)
            مدخل += [حالة_المولد[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد البيانات)
            مدخل += [البيانات[ف]]
            ف = ف + 1
        نهاية
        حالة_المولد = أمر_تجزئة(مدخل)
    نهاية

    # توليد بايتات عشوائية (GetRandom)
    دالة مصفوفة ولّد(رقم العدد)
        متغير النتيجة = []

        بينما (عدد النتيجة < العدد)
            # تحديث الحالة
            متغير مدخل = []
            متغير ف = 0
            بينما (ف < عدد حالة_المولد)
                مدخل += [حالة_المولد[ف]]
                ف = ف + 1
            نهاية
            مدخل += [عداد_التوليد % 256]
            مدخل += [(عداد_التوليد / 256) % 256]

            متغير خرج = أمر_تجزئة(مدخل)

            # نصف للخرج، نصف لتحديث الحالة
            ف = 0
            بينما (ف < 16)
                اذا (عدد النتيجة < العدد)
                    النتيجة += [خرج[ف]]
                نهاية
                ف = ف + 1
            نهاية

            # تحديث الحالة
            ف = 16
            بينما (ف < 32)
                حالة_المولد[ف - 16] = أمر_حصأو(حالة_المولد[ف - 16]، خرج[ف])
                ف = ف + 1
            نهاية

            عداد_التوليد = عداد_التوليد + 1
        نهاية

        ارجع النتيجة
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#          صنف الاختبار الذاتي (SelfTest)
# ══════════════════════════════════════════════════════════════════════════════

صنف اختبار_ذاتي_TPM
    ## تنفيذ الاختبار الذاتي لوحدة TPM

    منطقي تم_الاختبار
    رقم النتيجة_الأخيرة
    مصفوفة نتائج_المكونات      # [اسم، نتيجة]

    باني()
        تم_الاختبار = خطأ
        النتيجة_الأخيرة = اختبار_غير_مكتمل
        نتائج_المكونات = []
    نهاية

    # اختبار التجزئة
    دالة رقم اختبر_تجزئة()
        متغير بيانات = [1، 2، 3، 4، 5]
        متغير ت1 = أمر_تجزئة(بيانات)
        متغير ت2 = أمر_تجزئة(بيانات)

        # التحقق من التحديد (نفس المدخل = نفس الخرج)
        متغير متطابق = صحيح
        متغير ف = 0
        بينما (ف < عدد ت1)
            اذا (ت1[ف] != ت2[ف])
                متطابق = خطأ
            نهاية
            ف = ف + 1
        نهاية

        اذا (متطابق)
            ارجع اختبار_نجاح
        نهاية
        ارجع اختبار_فشل
    نهاية

    # اختبار XOR
    دالة رقم اختبر_XOR()
        متغير أ = 170     # 10101010
        متغير ب = 85      # 01010101
        متغير ن = أمر_حصأو(أ، ب)

        # a XOR b XOR b = a
        متغير ع = أمر_حصأو(ن، ب)
        اذا (ع == أ)
            ارجع اختبار_نجاح
        نهاية
        ارجع اختبار_فشل
    نهاية

    # اختبار RNG
    دالة رقم اختبر_RNG()
        متغير مولد = جديد مولد_عشوائية_TPM()
        مولد.هيّئ(42)
        متغير ع1 = مولد.ولّد(16)
        متغير ع2 = مولد.ولّد(16)

        # التحقق من أنهما مختلفان
        متغير مختلف = خطأ
        متغير ف = 0
        بينما (ف < 16)
            اذا (ع1[ف] != ع2[ف])
                مختلف = صحيح
            نهاية
            ف = ف + 1
        نهاية

        اذا (مختلف)
            ارجع اختبار_نجاح
        نهاية
        ارجع اختبار_فشل
    نهاية

    # تشغيل الاختبار الذاتي الكامل
    دالة رقم نفّذ_كامل()
        اطبع_سطر("  اختبار ذاتي TPM...")
        نتائج_المكونات = []

        # اختبار التجزئة
        متغير ن1 = اختبر_تجزئة()
        نتائج_المكونات += [ن1]
        اذا (ن1 == اختبار_نجاح)
            اطبع_سطر("    ✓ التجزئة")
        والا
            اطبع_سطر("    ✗ التجزئة")
        نهاية

        # اختبار XOR
        متغير ن2 = اختبر_XOR()
        نتائج_المكونات += [ن2]
        اذا (ن2 == اختبار_نجاح)
            اطبع_سطر("    ✓ XOR")
        والا
            اطبع_سطر("    ✗ XOR")
        نهاية

        # اختبار RNG
        متغير ن3 = اختبر_RNG()
        نتائج_المكونات += [ن3]
        اذا (ن3 == اختبار_نجاح)
            اطبع_سطر("    ✓ RNG")
        والا
            اطبع_سطر("    ✗ RNG")
        نهاية

        # الحكم النهائي
        متغير كل_نجاح = صحيح
        متغير ف = 0
        بينما (ف < عدد نتائج_المكونات)
            اذا (نتائج_المكونات[ف] != اختبار_نجاح)
                كل_نجاح = خطأ
            نهاية
            ف = ف + 1
        نهاية

        اذا (كل_نجاح)
            النتيجة_الأخيرة = اختبار_نجاح
        والا
            النتيجة_الأخيرة = اختبار_فشل
        نهاية

        تم_الاختبار = صحيح
        ارجع النتيجة_الأخيرة
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#          صنف شهادة الاعتماد (Credential)
# ══════════════════════════════════════════════════════════════════════════════

صنف اعتماد_TPM
    ## يدير عمليات MakeCredential / ActivateCredential

    باني()
    نهاية

    # MakeCredential: تشفير سر باستخدام مفتاح EK
    دالة مصفوفة أنشئ_اعتماد(مصفوفة مفتاح_EK، مصفوفة السر، مصفوفة اسم_الكائن)
        # credentialBlob = Hash(EK || secret || name) XOR secret
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد مفتاح_EK)
            مدخل += [مفتاح_EK[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد السر)
            مدخل += [السر[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد اسم_الكائن)
            مدخل += [اسم_الكائن[ف]]
            ف = ف + 1
        نهاية

        متغير مفتاح_تغليف = أمر_تجزئة(مدخل)

        # تشفير السر
        متغير مشفّر = []
        ف = 0
        بينما (ف < عدد السر)
            مشفّر += [أمر_حصأو(السر[ف]، مفتاح_تغليف[ف % عدد مفتاح_تغليف])]
            ف = ف + 1
        نهاية

        # إلحاق HMAC (للتكامل)
        متغير همك_مدخل = []
        ف = 0
        بينما (ف < عدد مشفّر)
            همك_مدخل += [مشفّر[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد مفتاح_تغليف)
            همك_مدخل += [مفتاح_تغليف[ف]]
            ف = ف + 1
        نهاية
        متغير همك = أمر_تجزئة(همك_مدخل)

        # النتيجة = مشفّر + HMAC
        ف = 0
        بينما (ف < عدد همك)
            مشفّر += [همك[ف]]
            ف = ف + 1
        نهاية

        ارجع مشفّر
    نهاية

    # ActivateCredential: فك تشفير الاعتماد
    دالة مصفوفة فعّل_اعتماد(مصفوفة مفتاح_EK، مصفوفة الاعتماد_المشفّر، مصفوفة اسم_الكائن، رقم حجم_السر)
        # إعادة حساب مفتاح التغليف
        # نحتاج السر الأصلي لإعادة الحساب — نستخدم طريقة تقريبية
        # في التنفيذ الحقيقي: نستخدم المفتاح الخاص لفك التشفير

        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد مفتاح_EK)
            مدخل += [مفتاح_EK[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد اسم_الكائن)
            مدخل += [اسم_الكائن[ف]]
            ف = ف + 1
        نهاية

        متغير مفتاح_فك = أمر_تجزئة(مدخل)

        # فك التشفير (XOR)
        متغير مفكوك = []
        ف = 0
        بينما (ف < حجم_السر)
            اذا (ف < عدد الاعتماد_المشفّر)
                مفكوك += [أمر_حصأو(الاعتماد_المشفّر[ف]، مفتاح_فك[ف % عدد مفتاح_فك])]
            نهاية
            ف = ف + 1
        نهاية
        ارجع مفكوك
    نهاية
نهاية


