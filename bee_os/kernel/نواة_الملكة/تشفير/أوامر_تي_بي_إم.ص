صنف معالج_أوامر_TPM
    ## معالج أوامر TPM 2.0 المركزي

    اختبار_ذاتي_TPM الاختبار
    حماية_القاموس الحماية
    مولد_عشوائية_TPM المولد
    اعتماد_TPM الاعتماد
    مصفوفة السياسات
    رقم عداد_الأوامر_المعالج
    مصفوفة سجل_الأوامر          # سجل تدقيق

    باني()
        الاختبار = جديد اختبار_ذاتي_TPM()
        الحماية = جديد حماية_القاموس()
        المولد = جديد مولد_عشوائية_TPM()
        الاعتماد = جديد اعتماد_TPM()
        السياسات = []
        عداد_الأوامر_المعالج = 0
        سجل_الأوامر = []
    نهاية

    # تهيئة
    دالة تهيئة(رقم بذرة)
        المولد.هيّئ(بذرة)
        اطبع_سطر("  معالج أوامر TPM: مهيأ")
    نهاية

    # ══════════════════════════════
    # TPM2_SelfTest
    # ══════════════════════════════
    دالة نتيجة_أمر أمر_SelfTest()
        متغير ن = الاختبار.نفّذ_كامل()
        متغير نتيجة = جديد نتيجة_أمر(أمر_نجاح، أمر_SelfTest)
        اذا (ن != اختبار_نجاح)
            نتيجة.الرمز = أمر_فشل
            نتيجة.الرسالة = "فشل الاختبار الذاتي"
        والا
            نتيجة.الرسالة = "الاختبار الذاتي ناجح"
        نهاية
        عداد_الأوامر_المعالج = عداد_الأوامر_المعالج + 1
        سجل_الأوامر += [أمر_SelfTest]
        ارجع نتيجة
    نهاية

    # ══════════════════════════════
    # TPM2_GetRandom
    # ══════════════════════════════
    دالة نتيجة_أمر أمر_GetRandom(رقم العدد)
        متغير نتيجة = جديد نتيجة_أمر(أمر_نجاح، أمر_GetRandom)
        نتيجة.البيانات = المولد.ولّد(العدد)
        نتيجة.الرسالة = "عشوائية"
        عداد_الأوامر_المعالج = عداد_الأوامر_المعالج + 1
        سجل_الأوامر += [أمر_GetRandom]
        ارجع نتيجة
    نهاية

    # ══════════════════════════════
    # TPM2_StirRandom
    # ══════════════════════════════
    دالة نتيجة_أمر أمر_StirRandom(مصفوفة البيانات)
        المولد.أضف_إنتروبي(البيانات)
        متغير نتيجة = جديد نتيجة_أمر(أمر_نجاح، أمر_StirRandom)
        نتيجة.الرسالة = "إنتروبي مضاف"
        عداد_الأوامر_المعالج = عداد_الأوامر_المعالج + 1
        سجل_الأوامر += [أمر_StirRandom]
        ارجع نتيجة
    نهاية

    # ══════════════════════════════
    # TPM2_MakeCredential
    # ══════════════════════════════
    دالة نتيجة_أمر أمر_MakeCredential(مصفوفة مفتاح_EK، مصفوفة السر، مصفوفة الاسم)
        متغير نتيجة = جديد نتيجة_أمر(أمر_نجاح، أمر_MakeCredential)
        نتيجة.البيانات = الاعتماد.أنشئ_اعتماد(مفتاح_EK، السر، الاسم)
        نتيجة.الرسالة = "اعتماد"
        عداد_الأوامر_المعالج = عداد_الأوامر_المعالج + 1
        سجل_الأوامر += [أمر_MakeCredential]
        ارجع نتيجة
    نهاية

    # ══════════════════════════════
    # TPM2_DA_Reset
    # ══════════════════════════════
    دالة نتيجة_أمر أمر_DA_Reset()
        الحماية.إعادة_تعيين()
        متغير نتيجة = جديد نتيجة_أمر(أمر_نجاح، أمر_DA_Reset)
        نتيجة.الرسالة = "DA reset"
        عداد_الأوامر_المعالج = عداد_الأوامر_المعالج + 1
        سجل_الأوامر += [أمر_DA_Reset]
        ارجع نتيجة
    نهاية

    # ══════════════════════════════
    # TPM2_GetCapability
    # ══════════════════════════════
    دالة نتيجة_أمر أمر_GetCapability(رقم النمط)
        متغير نتيجة = جديد نتيجة_أمر(أمر_نجاح، أمر_GetCapability)

        اذا (النمط == قدرة_خوارزميات)
            نتيجة.البيانات = [1، 2]    # BLAKE3، SHA256
            نتيجة.الرسالة = "خوارزميات"
        والا_اذا (النمط == قدرة_PCR)
            نتيجة.البيانات = [24]       # 24 سجل
            نتيجة.الرسالة = "PCR"
        والا_اذا (النمط == قدرة_خصائص)
            نتيجة.البيانات = [2، 0]    # إصدار 2.0
            نتيجة.الرسالة = "خصائص"
        والا
            نتيجة.البيانات = []
            نتيجة.الرسالة = "غير معروف"
        نهاية

        عداد_الأوامر_المعالج = عداد_الأوامر_المعالج + 1
        سجل_الأوامر += [أمر_GetCapability]
        ارجع نتيجة
    نهاية

    # ══════════════════════════════
    # إنشاء سياسة
    # ══════════════════════════════
    دالة سياسة_TPM أنشئ_سياسة()
        متغير س = جديد سياسة_TPM()
        السياسات += [س]
        ارجع س
    نهاية

    # طباعة سجل التدقيق
    دالة اطبع_سجل()
        اطبع_سطر("── سجل أوامر TPM ──")
        اطبع("  إجمالي الأوامر: ")
        اطبع_سطر(عداد_الأوامر_المعالج)
        متغير ف = 0
        بينما (ف < عدد سجل_الأوامر)
            اطبع("    #")
            اطبع(ف + 1)
            اطبع(" رمز=")
            اطبع_سطر(سجل_الأوامر[ف])
            ف = ف + 1
        نهاية
    نهاية
نهاية


