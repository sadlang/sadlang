# ══════════════════════════════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════════════════")
    اطبع_سطر("  🐝 نظام النحلة - اختبار أوامر TPM 2.0")
    اطبع_سطر("══════════════════════════════════════════════════════════")

    متغير إجمالي = 0

    إجمالي = إجمالي + اختبار_الأوامر_الأساسية()
    إجمالي = إجمالي + اختبار_السياسات()
    إجمالي = إجمالي + اختبار_حماية_القاموس()
    إجمالي = إجمالي + اختبار_الاعتماد()

    اطبع_سطر("══════════════════════════════════════════════════════════")
    اذا (إجمالي == 0)
        اطبع_سطر("  ✅ جميع اختبارات أوامر TPM نجحت!")
    والا
        اطبع("  ❌ عدد الاختبارات الفاشلة: ")
        اطبع_سطر(إجمالي)
    نهاية
    اطبع_سطر("══════════════════════════════════════════════════════════")

    ارجع إجمالي
نهاية
