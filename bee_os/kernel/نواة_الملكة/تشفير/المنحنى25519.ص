دالة رقم اختبار_عناصر_الحقل()
    اطبع_سطر("── اختبار عناصر الحقل ──")
    متغير نجاح = 0
    متغير فشل = 0

    # اختبار الصفر
    متغير صفر = عنصر_صفر()
    اذا (صفر.هو_صفر())
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ عنصر الصفر")
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ عنصر الصفر فشل")
    نهاية

    # اختبار الواحد
    متغير واحد = عنصر_واحد()
