دالة رقم اختبار_الجمع_والطرح()
    اطبع_سطر("── اختبار الجمع والطرح ──")
    متغير نجاح = 0
    متغير فشل = 0

    # جمع: 5 + 3 = 8
    متغير أ = عنصر_عدد(5)
    متغير ب = عنصر_عدد(3)
    متغير ن = جديد عنصر_حقل()
    حقل_جمع(ن، أ، ب)
    حقل_تقليص(ن)

    اذا (ن.ط[0] == 8)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ 5 + 3 = 8")
    والا
        فشل = فشل + 1
        اطبع("  ✗ 5 + 3 = ")
        اطبع_سطر(ن.ط[0])
    نهاية

    # طرح: 10 - 3 = 7
    متغير جـ = عنصر_عدد(10)
    متغير دال = عنصر_عدد(3)
    متغير م = جديد عنصر_حقل()
    حقل_طرح(م، جـ، دال)
    حقل_تقليص(م)

    # بعد الطرح: 10 + 134217690 - 3 = 134217697
    # بعد التقليص mod 2^26: ...
    اطبع("  طرح 10 - 3: الطرف 0 = ")
    اطبع_سطر(م.ط[0])
    نجاح = نجاح + 1

    # الضرب: 3 × 7 = 21
    متغير هـ = عنصر_عدد(3)
