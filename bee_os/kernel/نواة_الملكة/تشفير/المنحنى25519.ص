#
# الوصف التفصيلي:
# ════════════════
# تنفيذ كامل لعمليات منحنى Curve25519 الإهليلجي في لغة ص.
# هذا الملف هو الأساس الرياضي لـ X25519 (تبادل المفاتيح) و
# Ed25519 (التوقيعات الرقمية).
#
# المنحنى الإهليلجي Curve25519:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━
# المعادلة (شكل مونتغمري): y² = x³ + 486662x² + x  (mod p)
# المعادلة (شكل إدواردز): -x² + y² = 1 + d·x²·y²  (mod p)
#   حيث d = -121665/121666 mod p
#
# الحقل الأولي:
#   p = 2²⁵⁵ - 19 (عدد أولي ميرسن المعمم)
#   p = 57896044618658097711785492504343953926634992332820282019728792003956564819949
#
# نقاط مميزة:
#   نقطة الأساس (Base Point): G_x = 9
#   رتبة المجموعة الفرعية: ℓ = 2²⁵² + 27742317777372353535851937790883648493
#   العامل المشترك (Cofactor): h = 8
#
# التمثيل الداخلي:
# ━━━━━━━━━━━━━━━
# عنصر الحقل GF(p) يُمثّل بمصفوفة من 10 أطراف (limbs):
#   الأطراف الزوجية (0,2,4,6,8): 26 بت (قناع = 2²⁶-1 = 67108863)
#   الأطراف الفردية (1,3,5,7,9): 25 بت (قناع = 2²⁵-1 = 33554431)
#   المجموع: 5×26 + 5×25 = 255 بت ≥ ⌈log₂(p)⌉
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════


