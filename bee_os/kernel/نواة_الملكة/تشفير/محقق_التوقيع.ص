# أنواع التوقيع
ثابت توقيع_إد25519 = 1
ثابت توقيع_HMAC = 2
ثابت توقيع_حلقي = 3

# أحجام التوقيعات
ثابت حجم_توقيع_إد = 64
ثابت حجم_مفتاح_إد = 32
ثابت حجم_HMAC = 32

# نتائج التحقق
ثابت تحقق_ناجح = 0
ثابت تحقق_فاشل = 1
ثابت تحقق_مفتاح_غير_صالح = 2
