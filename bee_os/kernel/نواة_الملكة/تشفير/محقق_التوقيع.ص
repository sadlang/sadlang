# ══════════════════════════════════════════════════════════════════════════════
#                      دوال بتّية مساعدة
# ══════════════════════════════════════════════════════════════════════════════

دالة رقم محقق_حصأو(رقم أ، رقم ب)
    متغير نت = 0
    متغير بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 != ب2)
            نت = نت + بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        بت = بت * 2
        ع = ع + 1
    نهاية
    ارجع نت
نهاية

دالة رقم محقق_حصو(رقم أ، رقم ب)
    متغير نت = 0
    متغير بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 == 1)
            اذا (ب2 == 1)
                نت = نت + بت
            نهاية
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        بت = بت * 2
        ع = ع + 1
    نهاية
    ارجع نت
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     دوال التجزئة
