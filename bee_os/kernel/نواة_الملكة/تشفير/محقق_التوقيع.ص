# تجزئة BLAKE3 مبسطة (32 بايت)
دالة مصفوفة مت_تجزئة(مصفوفة البيانات)
    متغير ح = [1779033703، 3144134277، 1013904242، 2773480762، 1359893119، 2600822924، 528734635، 1541459225]

    متغير ف = 0
    بينما (ف < عدد البيانات)
        متغير ب = البيانات[ف]
        متغير ق = 0
        بينما (ق < 8)
            ح[ق] = (ح[ق] + ب * (2654435761 + ق * 1000000007)) % 4294967296
            اذا (ح[ق] < 0)
                ح[ق] = ح[ق] * (-1)
            نهاية
            ق = ق + 1
        نهاية
        ف = ف + 1
    نهاية

    متغير النتيجة = []
    متغير ق2 = 0
    بينما (ق2 < 8)
        متغير ر = ح[ق2]
        النتيجة += [ر % 256]
        النتيجة += [(ر / 256) % 256]
        النتيجة += [(ر / 65536) % 256]
        النتيجة += [(ر / 16777216) % 256]
        ق2 = ق2 + 1
    نهاية
    ارجع النتيجة
نهاية

# HMAC: Hash(key || data)
دالة مصفوفة مت_HMAC(مصفوفة المفتاح، مصفوفة البيانات)
    # HMAC = Hash((key ⊕ opad) || Hash((key ⊕ ipad) || message))
    متغير ipad = 0x36
    متغير opad = 0x5C
    متغير حجم_كتلة = 64

    # تحضير المفتاح (تبطين إلى حجم_كتلة)
    متغير مفتاح_مبطن = []
    متغير ف = 0
    بينما (ف < حجم_كتلة)
        اذا (ف < عدد المفتاح)
            مفتاح_مبطن += [المفتاح[ف]]
        والا
            مفتاح_مبطن += [0]
        نهاية
        ف = ف + 1
    نهاية

    # Inner hash: Hash((key ⊕ ipad) || message)
    متغير مدخل_داخلي = []
    ف = 0
    بينما (ف < حجم_كتلة)
        مدخل_داخلي += [محقق_حصأو(مفتاح_مبطن[ف]، ipad) % 256]
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < عدد البيانات)
        مدخل_داخلي += [البيانات[ف]]
        ف = ف + 1
    نهاية
    متغير تجزئة_داخلية = مت_تجزئة(مدخل_داخلي)

    # Outer hash: Hash((key ⊕ opad) || inner_hash)
    متغير مدخل_خارجي = []
    ف = 0
    بينما (ف < حجم_كتلة)
        مدخل_خارجي += [محقق_حصأو(مفتاح_مبطن[ف]، opad) % 256]
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < عدد تجزئة_داخلية)
        مدخل_خارجي += [تجزئة_داخلية[ف]]
        ف = ف + 1
    نهاية

    ارجع مت_تجزئة(مدخل_خارجي)
نهاية

# مقارنة ثابتة الوقت
دالة منطقي مت_مقارنة(مصفوفة أ، مصفوفة ب)
    اذا (عدد أ != عدد ب)
        ارجع خطأ
    نهاية
    متغير فرق = 0
    متغير ف = 0
    بينما (ف < عدد أ)
        فرق = فرق + محقق_حصأو(أ[ف]، ب[ف])
        ف = ف + 1
    نهاية
    ارجع فرق == 0
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف محقق Ed25519 (مبسط)
# ══════════════════════════════════════════════════════════════════════════════

صنف محقق_إد25519
    ## يتحقق من توقيعات Ed25519

    باني()
    نهاية

    # التحقق من صحة التوقيع
    # محاكاة: يتحقق أن التوقيع = Hash(R || PK || msg) mod q
    دالة رقم تحقق(مصفوفة المفتاح_العام، مصفوفة الرسالة، مصفوفة التوقيع)
        # التحقق من الأحجام
        اذا (عدد المفتاح_العام != حجم_مفتاح_إد)
            ارجع تحقق_مفتاح_غير_صالح
        نهاية
        اذا (عدد التوقيع != حجم_توقيع_إد)
            ارجع تحقق_توقيع_تالف
        نهاية

        # R = التوقيع[0..31]، S = التوقيع[32..63]
        متغير ر_بايتات = []
        متغير ف = 0
        بينما (ف < 32)
            ر_بايتات += [التوقيع[ف]]
            ف = ف + 1
        نهاية

        متغير س_بايتات = []
        ف = 32
        بينما (ف < 64)
            س_بايتات += [التوقيع[ف]]
            ف = ف + 1
        نهاية

        # k = Hash(R || PK || msg)
        متغير مدخل_ك = []
        ف = 0
        بينما (ف < عدد ر_بايتات)
            مدخل_ك += [ر_بايتات[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد المفتاح_العام)
            مدخل_ك += [المفتاح_العام[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد الرسالة)
            مدخل_ك += [الرسالة[ف]]
            ف = ف + 1
        نهاية
        متغير ك = مت_تجزئة(مدخل_ك)

        # محاكاة: التحقق أن S×B == R + k×A
        # في هذه المحاكاة: نتحقق أن R و S غير صفريين
        متغير مجموع_ر = 0
        ف = 0
        بينما (ف < عدد ر_بايتات)
            مجموع_ر = مجموع_ر + ر_بايتات[ف]
            ف = ف + 1
        نهاية

        متغير مجموع_س = 0
        ف = 0
        بينما (ف < عدد س_بايتات)
            مجموع_س = مجموع_س + س_بايتات[ف]
            ف = ف + 1
        نهاية

        اذا (مجموع_ر == 0)
            ارجع تحقق_توقيع_تالف
        نهاية
        اذا (مجموع_س == 0)
            ارجع تحقق_توقيع_تالف
        نهاية

        ارجع تحقق_ناجح
    نهاية

    # إنشاء توقيع وهمي للاختبار
    دالة مصفوفة وقّع_اختبار(مصفوفة المفتاح_الخاص، مصفوفة الرسالة)
        # R = Hash(prefix || msg)
        متغير مدخل_ر = []
        متغير ف = 0
        بينما (ف < عدد المفتاح_الخاص)
            مدخل_ر += [المفتاح_الخاص[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد الرسالة)
            مدخل_ر += [الرسالة[ف]]
            ف = ف + 1
        نهاية
        متغير ر = مت_تجزئة(مدخل_ر)

        # S = Hash(R || msg || key)
        متغير مدخل_س = []
        ف = 0
        بينما (ف < عدد ر)
            مدخل_س += [ر[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد الرسالة)
            مدخل_س += [الرسالة[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد المفتاح_الخاص)
            مدخل_س += [المفتاح_الخاص[ف]]
            ف = ف + 1
        نهاية
        متغير س = مت_تجزئة(مدخل_س)

        # التوقيع = R || S
        متغير التوقيع = []
        ف = 0
        بينما (ف < عدد ر)
            التوقيع += [ر[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد س)
            التوقيع += [س[ف]]
            ف = ف + 1
        نهاية
        ارجع التوقيع
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف محقق HMAC
