صنف محقق_HMAC
    ## يتحقق من مصادقة الرسائل باستخدام HMAC

    باني()
    نهاية

    # إنشاء MAC
    دالة مصفوفة أنشئ_MAC(مصفوفة المفتاح، مصفوفة الرسالة)
        ارجع مت_HMAC(المفتاح، الرسالة)
    نهاية

    # التحقق من MAC
    دالة رقم تحقق(مصفوفة المفتاح، مصفوفة الرسالة، مصفوفة الMAC)
        اذا (عدد المفتاح < 16)
            ارجع تحقق_مفتاح_غير_صالح
        نهاية
        اذا (عدد الMAC != حجم_HMAC)
            ارجع تحقق_توقيع_تالف
        نهاية

        متغير mac_محسوب = مت_HMAC(المفتاح، الرسالة)

        اذا (مت_مقارنة(mac_محسوب، الMAC))
            ارجع تحقق_ناجح
        نهاية
        ارجع تحقق_فاشل
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف محقق التوقيع الحلقي (Ring Signature)
# ══════════════════════════════════════════════════════════════════════════════

صنف محقق_حلقي
    ## توقيع حلقي مبسط: يثبت أن أحد أعضاء المجموعة وقّع بدون كشف هويته
    ## المخطط: Spontaneous Anonymous Group (SAG) مبسط

    باني()
    نهاية

    # إنشاء توقيع حلقي وهمي
    # المفاتيح: مصفوفة من مصفوفات (كل عنصر = مفتاح عام 32 بايت)
    # فهرس_الموقّع: أي مفتاح يملك الموقّع
    # المفتاح_الخاص: المفتاح الخاص للموقّع
    دالة مصفوفة وقّع(مصفوفة المفاتيح، رقم فهرس_الموقّع، مصفوفة المفتاح_الخاص، مصفوفة الرسالة)
        متغير عدد_الأعضاء = عدد المفاتيح
        اذا (عدد_الأعضاء < 2)
            ارجع []
        نهاية

        # c_0 = Hash(msg || keyImage)
        متغير صورة_المفتاح = مت_تجزئة(المفتاح_الخاص)

        # إنشاء التحديات والاستجابات
        متغير التحديات = []
        متغير الاستجابات = []
        متغير ف = 0
        بينما (ف < عدد_الأعضاء)
            اذا (ف == فهرس_الموقّع)
                # التحدي الحقيقي (سيُحسب لاحقاً)
                التحديات += [0]
                الاستجابات += [0]
            والا
                # تحديات واستجابات عشوائية وهمية
                متغير مدخل_ت = []
                متغير ق = 0
                بينما (ق < عدد الرسالة)
                    مدخل_ت += [الرسالة[ق]]
                    ق = ق + 1
                نهاية
                مدخل_ت += [ف * 137 % 256]
                مدخل_ت += [(ف + 1) * 251 % 256]
                متغير تجزئة_ت = مت_تجزئة(مدخل_ت)
                التحديات += [تجزئة_ت[0] * 256 + تجزئة_ت[1]]
                الاستجابات += [تجزئة_ت[2] * 256 + تجزئة_ت[3]]
            نهاية
            ف = ف + 1
        نهاية

        # حساب تحدي الموقّع
        متغير مدخل_موقع = []
        ف = 0
        بينما (ف < عدد الرسالة)
            مدخل_موقع += [الرسالة[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد صورة_المفتاح)
            مدخل_موقع += [صورة_المفتاح[ف]]
            ف = ف + 1
        نهاية
        متغير تجزئة_موقع = مت_تجزئة(مدخل_موقع)
        التحديات[فهرس_الموقّع] = تجزئة_موقع[0] * 256 + تجزئة_موقع[1]
        الاستجابات[فهرس_الموقّع] = تجزئة_موقع[2] * 256 + تجزئة_موقع[3]

        # تجميع التوقيع: صورة_المفتاح || التحديات || الاستجابات
        متغير التوقيع = []
        ف = 0
        بينما (ف < عدد صورة_المفتاح)
            التوقيع += [صورة_المفتاح[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد_الأعضاء)
            التوقيع += [التحديات[ف] % 256]
            التوقيع += [(التحديات[ف] / 256) % 256]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد_الأعضاء)
            التوقيع += [الاستجابات[ف] % 256]
            التوقيع += [(الاستجابات[ف] / 256) % 256]
            ف = ف + 1
        نهاية

        ارجع التوقيع
    نهاية

    # التحقق من توقيع حلقي
    دالة رقم تحقق(مصفوفة المفاتيح، مصفوفة الرسالة، مصفوفة التوقيع)
        متغير عدد_الأعضاء = عدد المفاتيح
        اذا (عدد_الأعضاء < 2)
            ارجع تحقق_فاشل
        نهاية

        # الحجم المتوقع: 32 (صورة) + 2*أعضاء (تحديات) + 2*أعضاء (استجابات)
        متغير حجم_متوقع = 32 + عدد_الأعضاء * 4
        اذا (عدد التوقيع != حجم_متوقع)
            ارجع تحقق_توقيع_تالف
        نهاية

        # استخراج صورة المفتاح
        متغير صورة = []
        متغير ف = 0
        بينما (ف < 32)
            صورة += [التوقيع[ف]]
            ف = ف + 1
        نهاية

        # التحقق أن صورة المفتاح غير صفرية
        متغير مجموع_صورة = 0
        ف = 0
        بينما (ف < عدد صورة)
            مجموع_صورة = مجموع_صورة + صورة[ف]
            ف = ف + 1
        نهاية

        اذا (مجموع_صورة == 0)
            ارجع تحقق_توقيع_تالف
        نهاية

        # استخراج التحديات والتحقق من اتساقها
        متغير مجموع_تحديات = 0
        ف = 0
        بينما (ف < عدد_الأعضاء)
            متغير موقع = 32 + ف * 2
            متغير تحدي = التوقيع[موقع] + التوقيع[موقع + 1] * 256
            مجموع_تحديات = مجموع_تحديات + تحدي
            ف = ف + 1
        نهاية

        اذا (مجموع_تحديات > 0)
            ارجع تحقق_ناجح
        نهاية

        ارجع تحقق_فاشل
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف واجهة التحقق الموحدة
# ══════════════════════════════════════════════════════════════════════════════

صنف محقق_التوقيع
    ## واجهة موحدة للتحقق من جميع أنواع التوقيعات

    محقق_إد25519 إد25519
    محقق_HMAC hmac
    محقق_حلقي حلقي
    رقم عدد_التحققات
    رقم عدد_النجاح
    رقم عدد_الفشل

    باني()
        إد25519 = جديد محقق_إد25519()
        hmac = جديد محقق_HMAC()
        حلقي = جديد محقق_حلقي()
        عدد_التحققات = 0
        عدد_النجاح = 0
        عدد_الفشل = 0
    نهاية

    # التحقق حسب النوع
    دالة رقم تحقق(رقم النوع، مصفوفة المفتاح، مصفوفة الرسالة، مصفوفة التوقيع)
        عدد_التحققات = عدد_التحققات + 1
        متغير نتيجة = تحقق_خوارزمية_غير_مدعومة

        اذا (النوع == توقيع_إد25519)
            نتيجة = إد25519.تحقق(المفتاح، الرسالة، التوقيع)
        والا_اذا (النوع == توقيع_HMAC)
            نتيجة = hmac.تحقق(المفتاح، الرسالة، التوقيع)
        نهاية

        اذا (نتيجة == تحقق_ناجح)
            عدد_النجاح = عدد_النجاح + 1
        والا
            عدد_الفشل = عدد_الفشل + 1
        نهاية

        ارجع نتيجة
    نهاية

    # التحقق من توقيع حلقي
    دالة رقم تحقق_حلقي_م(مصفوفة المفاتيح، مصفوفة الرسالة، مصفوفة التوقيع)
        عدد_التحققات = عدد_التحققات + 1
        متغير نتيجة = حلقي.تحقق(المفاتيح، الرسالة، التوقيع)
        اذا (نتيجة == تحقق_ناجح)
            عدد_النجاح = عدد_النجاح + 1
        والا
            عدد_الفشل = عدد_الفشل + 1
        نهاية
