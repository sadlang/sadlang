            اطبع(ح.الوصف)
            اطبع_سطر("")
            ف = ف + 1
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف مخزن القياسات المرجعية
# ══════════════════════════════════════════════════════════════════════════════

صنف قياس_مرجعي
    نص المعرّف
    رقم رقم_PCR
    مصفوفة التجزئة_المتوقعة

    باني(نص معرّف، رقم pcr)
        المعرّف = معرّف
        رقم_PCR = pcr
        التجزئة_المتوقعة = []
    نهاية
نهاية

صنف مخزن_القياسات
    ## يخزن القياسات المرجعية المعروفة للمقارنة

    مصفوفة القياسات

    باني()
        القياسات = []
    نهاية

    دالة أضف(نص معرّف، رقم pcr، مصفوفة تجزئة)
        متغير ق = جديد قياس_مرجعي(معرّف، pcr)
        ق.التجزئة_المتوقعة = تجزئة
        القياسات += [ق]
    نهاية

    # البحث عن قياس مرجعي
    دالة مصفوفة ابحث(نص معرّف)
        متغير ف = 0
        بينما (ف < عدد القياسات)
            اذا (القياسات[ف].المعرّف == معرّف)
                ارجع القياسات[ف].التجزئة_المتوقعة
            نهاية
            ف = ف + 1
        نهاية
        ارجع []
    نهاية

    # التحقق من تطابق
    دالة منطقي تطابق(نص معرّف، مصفوفة تجزئة)
        متغير مرجعية = ابحث(معرّف)
        اذا (عدد مرجعية == 0)
            ارجع خطأ    # غير معروف
        نهاية
        ارجع جث_مقارنة(مرجعية، تجزئة)
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف جذر الثقة (Root of Trust)
# ══════════════════════════════════════════════════════════════════════════════

صنف جذر_الثقة
    ## النظام المركزي لجذر الثقة

    بنك_PCR البنك                      # سجلات PCR
    سجل_الأحداث الأحداث               # سجل الأحداث
    مخزن_القياسات المرجعيات           # القياسات المرجعية
    رقم حالة_النظام                    # حالة النظام الحالية
    منطقي مُهيّأ                      # هل مُهيّأ؟
    مصفوفة مفتاح_الجذر              # مفتاح الجذر (Endorsement Key)
    مصفوفة مفتاح_الهوية             # مفتاح الهوية (Attestation Identity Key)

    باني()
        البنك = جديد بنك_PCR()
        الأحداث = جديد سجل_الأحداث()
        المرجعيات = جديد مخزن_القياسات()
        حالة_النظام = نظام_موثوق
        مُهيّأ = خطأ
        مفتاح_الجذر = []
        مفتاح_الهوية = []
    نهاية

    # تهيئة جذر الثقة
    دالة تهيئة()
        # توليد مفتاح الجذر (Endorsement Key)
        مفتاح_الجذر = []
        متغير ف = 0
        بينما (ف < 32)
            مفتاح_الجذر += [(ف + 1) * 37 % 256]
            ف = ف + 1
        نهاية

        # توليد مفتاح الهوية (AIK)
        مفتاح_الهوية = جث_تجزئة(مفتاح_الجذر)

        مُهيّأ = صحيح
        اطبع_سطر("  جذر الثقة: مُهيّأ")
    نهاية

    # قياس مكون (Measure)
    دالة قِس(رقم رقم_PCR، نص الوصف، مصفوفة البيانات، رقم نوع_الحدث)
        اذا (مُهيّأ != صحيح)
            ارجع 0
        نهاية

        # حساب التجزئة
        متغير تجزئة = جث_تجزئة(البيانات)

        # تمديد PCR
        البنك.مدّد(رقم_PCR، تجزئة)

        # تسجيل الحدث
        الأحداث.سجّل(رقم_PCR، نوع_الحدث، الوصف، تجزئة)

        # التحقق من المرجعية
        متغير مرجعي = المرجعيات.ابحث(الوصف)
        اذا (عدد مرجعي > 0)
            اذا (جث_مقارنة(تجزئة، مرجعي) != صحيح)
                اطبع("  ⚠ قياس غير متطابق: ")
                اطبع_سطر(الوصف)
                حالة_النظام = نظام_مشبوه
            نهاية
        نهاية

        ارجع 1
    نهاية

    # ختم بيانات (Seal) — ربط البيانات بحالة PCR
    دالة مصفوفة اختم(مصفوفة البيانات، مصفوفة أرقام_PCR)
        # الحصول على اقتباس PCR
        متغير اقتباس = البنك.اقتبس(أرقام_PCR)

        # التشفير: XOR مع مشتق من الاقتباس + مفتاح الجذر
        متغير مدخل_مفتاح = []
        متغير ف = 0
        بينما (ف < عدد اقتباس)
            مدخل_مفتاح += [اقتباس[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد مفتاح_الجذر)
            مدخل_مفتاح += [مفتاح_الجذر[ف]]
            ف = ف + 1
        نهاية
        متغير مفتاح_ختم = جث_تجزئة(مدخل_مفتاح)

        # تشفير XOR
        متغير مختوم = []
        ف = 0
        بينما (ف < عدد البيانات)
            متغير ب_مفتاح = مفتاح_ختم[ف % عدد مفتاح_ختم]
            متغير ب_د = البيانات[ف]
            # XOR بسيط
            متغير نتيجة_xor = 0
            متغير بت = 1
            متغير ق1 = ب_مفتاح
            متغير ق2 = ب_د
            متغير ع = 0
            بينما (ع < 8)
                متغير ب1 = ق1 % 2
                متغير ب2 = ق2 % 2
                اذا (ب1 != ب2)
                    نتيجة_xor = نتيجة_xor + بت
                نهاية
                ق1 = (ق1 - ب1) / 2
                ق2 = (ق2 - ب2) / 2
                بت = بت * 2
                ع = ع + 1
            نهاية
            مختوم += [نتيجة_xor]
            ف = ف + 1
        نهاية

        # إضافة اقتباس PCR للتحقق عند فك الختم
        متغير الحزمة = []
        # أولاً: الاقتباس (32 بايت)
        ف = 0
        بينما (ف < عدد اقتباس)
            الحزمة += [اقتباس[ف]]
            ف = ف + 1
        نهاية
        # ثم: البيانات المختومة
        ف = 0
        بينما (ف < عدد مختوم)
            الحزمة += [مختوم[ف]]
            ف = ف + 1
        نهاية

        ارجع الحزمة
    نهاية

    # فك الختم (Unseal) — يتطلب نفس حالة PCR
    دالة مصفوفة فك_الختم(مصفوفة الحزمة، مصفوفة أرقام_PCR)
        اذا (عدد الحزمة <= 32)
            اطبع_سطر("  ✗ حزمة مختومة قصيرة جداً")
            ارجع []
        نهاية

        # استخراج اقتباس PCR المحفوظ
        متغير اقتباس_محفوظ = []
        متغير ف = 0
        بينما (ف < 32)
            اقتباس_محفوظ += [الحزمة[ف]]
            ف = ف + 1
        نهاية

        # اقتباس PCR الحالي
        متغير اقتباس_حالي = البنك.اقتبس(أرقام_PCR)

        # مقارنة
        اذا (جث_مقارنة(اقتباس_محفوظ، اقتباس_حالي) != صحيح)
            اطبع_سطر("  ✗ حالة PCR مختلفة — رفض فك الختم")
            ارجع []
        نهاية

        # فك التشفير
        متغير مدخل_مفتاح = []
        ف = 0
        بينما (ف < عدد اقتباس_حالي)
            مدخل_مفتاح += [اقتباس_حالي[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد مفتاح_الجذر)
            مدخل_مفتاح += [مفتاح_الجذر[ف]]
            ف = ف + 1
        نهاية
        متغير مفتاح_ختم = جث_تجزئة(مدخل_مفتاح)

        متغير مفكوك = []
        ف = 32
        بينما (ف < عدد الحزمة)
            متغير ب_مفتاح = مفتاح_ختم[(ف - 32) % عدد مفتاح_ختم]
            متغير ب_م = الحزمة[ف]
            متغير نتيجة_xor = 0
            متغير بت = 1
            متغير ق1 = ب_مفتاح
            متغير ق2 = ب_م
            متغير ع = 0
            بينما (ع < 8)
                متغير ب1 = ق1 % 2
                متغير ب2 = ق2 % 2
                اذا (ب1 != ب2)
                    نتيجة_xor = نتيجة_xor + بت
                نهاية
                ق1 = (ق1 - ب1) / 2
                ق2 = (ق2 - ب2) / 2
                بت = بت * 2
                ع = ع + 1
            نهاية
            مفكوك += [نتيجة_xor]
            ف = ف + 1
        نهاية

        ارجع مفكوك
    نهاية

    # إنشاء شهادة attestation
    دالة مصفوفة أنشئ_شهادة(مصفوفة أرقام_PCR، مصفوفة بيانات_إضافية)
        متغير اقتباس = البنك.اقتبس(أرقام_PCR)

        # الشهادة = Hash(اقتباس || AIK || بيانات إضافية)
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد اقتباس)
            مدخل += [اقتباس[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد مفتاح_الهوية)
