صنف حدث_قياس
    رقم رقم_PCR
    رقم نوع_الحدث
    نص الوصف
    مصفوفة التجزئة

    باني(رقم pcr، رقم نوع، نص وصف)
        رقم_PCR = pcr
        نوع_الحدث = نوع
        الوصف = وصف
        التجزئة = []
    نهاية
نهاية

صنف سجل_الأحداث
    مصفوفة الأحداث

    باني()
        الأحداث = []
    نهاية

    دالة سجّل(رقم pcr، رقم نوع، نص وصف، مصفوفة تجزئة)
