# ══════════════════════════════════════════════════════════════════════════════
#
# جذر الثقة (Root of Trust) — الأساس الذي تُبنى عليه كل الثقة التشفيرية
#
# المكونات:
# ═══════════
# 1. جذر الثقة للقياس (RTM - Root of Trust for Measurement)
#    - يقيس البرنامج الثابت قبل تنفيذه
#    - يسجل القياسات في PCR
#
# 2. جذر الثقة للتخزين (RTS - Root of Trust for Storage)
#    - يحمي المفاتيح والبيانات السرية
#    - يربط البيانات بحالة النظام (Sealing)
#
# 3. جذر الثقة للإبلاغ (RTR - Root of Trust for Reporting)
#    - يُبلغ عن حالة النظام لأطراف خارجية
#    - يُصدر شهادات attestation
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
#                           الثوابت
# ══════════════════════════════════════════════════════════════════════════════

# عدد سجلات PCR
ثابت عدد_PCR = 24

# حجم PCR (بايت)
ثابت حجم_PCR = 32

# أنواع جذر الثقة
ثابت جذر_قياس = 1       # RTM
ثابت جذر_تخزين = 2     # RTS
ثابت جذر_إبلاغ = 3     # RTR

# حالات النظام
ثابت نظام_موثوق = 0
ثابت نظام_مشبوه = 1
ثابت نظام_مخترق = 2

# أحداث الإقلاع
ثابت حدث_BIOS = 0
ثابت حدث_محمّل = 1
ثابت حدث_نواة = 2
ثابت حدث_سائق = 3
ثابت حدث_تطبيق = 4
ثابت حدث_إعداد = 5


# ══════════════════════════════════════════════════════════════════════════════
#                      دوال تجزئة مساعدة
# ══════════════════════════════════════════════════════════════════════════════

دالة مصفوفة جث_تجزئة(مصفوفة البيانات)
    متغير ح = [1779033703، 3144134277، 1013904242، 2773480762، 1359893119، 2600822924، 528734635، 1541459225]
    متغير ف = 0
    بينما (ف < عدد البيانات)
        متغير ب = البيانات[ف]
        متغير ق = 0
        بينما (ق < 8)
            ح[ق] = (ح[ق] + ب * (2654435761 + ق * 1000000007)) % 4294967296
            اذا (ح[ق] < 0)
                ح[ق] = ح[ق] * (-1)
            نهاية
            ق = ق + 1
        نهاية
        ف = ف + 1
    نهاية
    متغير النتيجة = []
    متغير ق2 = 0
    بينما (ق2 < 8)
        متغير ر = ح[ق2]
        النتيجة += [ر % 256]
        النتيجة += [(ر / 256) % 256]
        النتيجة += [(ر / 65536) % 256]
        النتيجة += [(ر / 16777216) % 256]
        ق2 = ق2 + 1
    نهاية
    ارجع النتيجة
نهاية

دالة منطقي جث_مقارنة(مصفوفة أ، مصفوفة ب)
    اذا (عدد أ != عدد ب)
        ارجع خطأ
    نهاية
    متغير فرق = 0
    متغير ف = 0
    بينما (ف < عدد أ)
        متغير د = أ[ف] - ب[ف]
        اذا (د < 0)
            د = د * (-1)
        نهاية
        فرق = فرق + د
        ف = ف + 1
    نهاية
    ارجع فرق == 0
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف سجل PCR (Platform Configuration Register)
# ══════════════════════════════════════════════════════════════════════════════

صنف سجل_PCR
    ## سجل تكوين المنصة — يسجل قياسات تراكمية

    مصفوفة القيمة             # القيمة الحالية (32 بايت)
    رقم عدد_التمديدات        # عدد مرات التمديد
    منطقي مُقفل              # هل السجل مقفل؟

    باني()
        القيمة = []
        متغير ف = 0
        بينما (ف < حجم_PCR)
            القيمة += [0]
            ف = ف + 1
        نهاية
        عدد_التمديدات = 0
        مُقفل = خطأ
    نهاية

    # تمديد: PCR = Hash(PCR_old || data)
    دالة منطقي مدّد(مصفوفة البيانات)
        اذا (مُقفل)
            ارجع خطأ
        نهاية

        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد القيمة)
            مدخل += [القيمة[ف]]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < عدد البيانات)
            مدخل += [البيانات[ف]]
            ف = ف + 1
        نهاية

        القيمة = جث_تجزئة(مدخل)
        عدد_التمديدات = عدد_التمديدات + 1
        ارجع صحيح
    نهاية

    # قراءة القيمة الحالية
    دالة مصفوفة اقرأ()
        متغير نسخة = []
        متغير ف = 0
        بينما (ف < عدد القيمة)
            نسخة += [القيمة[ف]]
            ف = ف + 1
        نهاية
        ارجع نسخة
    نهاية

    # هل القيمة كلها أصفار؟ (لم يُمدَّد بعد)
    دالة منطقي فارغ()
        متغير ف = 0
        بينما (ف < عدد القيمة)
            اذا (القيمة[ف] != 0)
                ارجع خطأ
            نهاية
            ف = ف + 1
        نهاية
        ارجع صحيح
    نهاية

    # إعادة تعيين (فقط عند الإقلاع)
    دالة أعد_تعيين()
        متغير ف = 0
        بينما (ف < عدد القيمة)
            القيمة[ف] = 0
            ف = ف + 1
        نهاية
        عدد_التمديدات = 0
        مُقفل = خطأ
    نهاية

    # قفل السجل (لا يمكن التمديد بعد ذلك)
    دالة اقفل()
        مُقفل = صحيح
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                صنف بنك PCR (PCR Bank)
# ══════════════════════════════════════════════════════════════════════════════

صنف بنك_PCR
    ## مجموعة سجلات PCR

    مصفوفة السجلات

    باني()
        السجلات = []
        متغير ف = 0
        بينما (ف < عدد_PCR)
            السجلات += [جديد سجل_PCR()]
            ف = ف + 1
        نهاية
    نهاية

    # تمديد سجل محدد
    دالة منطقي مدّد(رقم رقم_السجل، مصفوفة البيانات)
        اذا (رقم_السجل < 0)
            ارجع خطأ
        نهاية
        اذا (رقم_السجل >= عدد_PCR)
            ارجع خطأ
        نهاية
        ارجع السجلات[رقم_السجل].مدّد(البيانات)
    نهاية

    # قراءة سجل
    دالة مصفوفة اقرأ(رقم رقم_السجل)
        اذا (رقم_السجل < 0)
            ارجع []
        نهاية
        اذا (رقم_السجل >= عدد_PCR)
            ارجع []
        نهاية
        ارجع السجلات[رقم_السجل].اقرأ()
    نهاية

    # اقتباس: تجزئة مجموعة من PCRs
    دالة مصفوفة اقتبس(مصفوفة أرقام_السجلات)
        متغير مدخل = []
        متغير ف = 0
        بينما (ف < عدد أرقام_السجلات)
            متغير رقم = أرقام_السجلات[ف]
            اذا (رقم >= 0)
                اذا (رقم < عدد_PCR)
                    متغير قيمة = السجلات[رقم].اقرأ()
                    متغير ق = 0
                    بينما (ق < عدد قيمة)
                        مدخل += [قيمة[ق]]
                        ق = ق + 1
                    نهاية
                نهاية
            نهاية
            ف = ف + 1
        نهاية
        ارجع جث_تجزئة(مدخل)
    نهاية

    # طباعة ملخص
    دالة اطبع_ملخص()
        اطبع_سطر("── بنك PCR ──")
        متغير ف = 0
        بينما (ف < عدد_PCR)
            اذا (السجلات[ف].فارغ() != صحيح)
                اطبع("  PCR[")
                اطبع(ف)
                اطبع("] تمديدات=")
                اطبع(السجلات[ف].عدد_التمديدات)
                اطبع(" القيمة=[")
                متغير قيمة = السجلات[ف].اقرأ()
                اطبع(قيمة[0])
                اطبع("، ")
                اطبع(قيمة[1])
                اطبع("، ")
                اطبع(قيمة[2])
                اطبع_سطر("، ...]")
            نهاية
            ف = ف + 1
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
