دالة رقم اختبار_الختم()
    اطبع_سطر("── اختبار الختم وفك الختم ──")
    متغير نجاح = 0
    متغير فشل_ع = 0

    متغير جذر = جديد جذر_الثقة()
    جذر.تهيئة()

    # قياس بعض المكونات
    جذر.قِس(0، "BIOS"، [0x7F، 0x45، 0x4C]، حدث_BIOS)
    جذر.قِس(1، "محمّل"، [0xEB، 0x3C]، حدث_محمّل)

    # ختم بيانات
    متغير بيانات_سرية = [42، 43، 44، 45، 46]
    متغير مختوم = جذر.اختم(بيانات_سرية، [0، 1])

    اذا (عدد مختوم > 32)
        نجاح = نجاح + 1
        اطبع("  ✓ ختم ناجح، حجم الحزمة = ")
        اطبع_سطر(عدد مختوم)
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فشل الختم")
    نهاية

    # فك الختم (نفس حالة PCR)
    متغير مفكوك = جذر.فك_الختم(مختوم، [0، 1])
    اذا (عدد مفكوك == عدد بيانات_سرية)
        متغير متطابق = صحيح
        متغير ف = 0
        بينما (ف < عدد بيانات_سرية)
            اذا (مفكوك[ف] != بيانات_سرية[ف])
                متطابق = خطأ
            نهاية
            ف = ف + 1
        نهاية
        اذا (متطابق)
            نجاح = نجاح + 1
            اطبع_سطر("  ✓ فك الختم: البيانات مطابقة")
        والا
            فشل_ع = فشل_ع + 1
            اطبع_سطر("  ✗ فك الختم: البيانات مختلفة")
        نهاية
    والا
        فشل_ع = فشل_ع + 1
        اطبع("  ✗ حجم البيانات المفكوكة خاطئ: ")
        اطبع_سطر(عدد مفكوك)
    نهاية

    # محاولة فك بعد تغيير PCR (يجب أن تفشل)
    جذر.قِس(0، "تعديل_مشبوه"، [0xFF، 0xFF]، حدث_تطبيق)
    متغير مفكوك2 = جذر.فك_الختم(مختوم، [0، 1])
    اذا (عدد مفكوك2 == 0)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ رفض فك الختم بعد تغيير PCR")
    والا
        فشل_ع = فشل_ع + 1
        اطبع_سطر("  ✗ فك الختم نجح رغم تغيير PCR!")
    نهاية

    اطبع("  النتيجة: نجاح=")
    اطبع(نجاح)
    اطبع(" فشل=")
    اطبع_سطر(فشل_ع)
    ارجع فشل_ع
