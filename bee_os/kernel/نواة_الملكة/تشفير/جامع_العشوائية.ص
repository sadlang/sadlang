صنف محاكي_المؤقت
    ## محاكي لمؤقت TSC (Timestamp Counter)
    ## في النواة الحقيقية يقرأ من rdtsc

    رقم العداد
    رقم خطوة_أساسية
    رقم تذبذب

    باني()
        العداد = 1000000
        خطوة_أساسية = 100
        تذبذب = 7
    نهاية

    # قراءة المؤقت (محاكاة)
    دالة رقم اقرأ()
        # محاكاة تذبذب طبيعي (jitter)
        متغير جيتر = (العداد * ثابت_خلط_1 + تذبذب) % 17
        العداد = العداد + خطوة_أساسية + جيتر
        تذبذب = (تذبذب * 13 + جيتر) % 256
        ارجع العداد
    نهاية
نهاية

صنف محاكي_المقاطعات
    ## محاكي لمقاطعات الأجهزة

    رقم عداد_المقاطعات
    رقم آخر_وقت

    باني()
        عداد_المقاطعات = 0
        آخر_وقت = 0
    نهاية

    # محاكاة مقاطعة لوحة مفاتيح
    دالة مصفوفة مقاطعة_لوحة_مفاتيح(رقم رمز_المفتاح، رقم الوقت)
        عداد_المقاطعات = عداد_المقاطعات + 1
        متغير فرق_الوقت = جع_مطلق(الوقت - آخر_وقت)
        آخر_وقت = الوقت
        # العينة: رمز المفتاح + فرق الوقت
        ارجع [رمز_المفتاح، فرق_الوقت % 256، جع_حصأو(رمز_المفتاح، فرق_الوقت) % 256]
    نهاية

    # محاكاة مقاطعة ماوس
    دالة مصفوفة مقاطعة_ماوس(رقم س، رقم ص، رقم الوقت)
        عداد_المقاطعات = عداد_المقاطعات + 1
        متغير فرق_الوقت = جع_مطلق(الوقت - آخر_وقت)
        آخر_وقت = الوقت
        ارجع [س % 256، ص % 256، فرق_الوقت % 256، جع_حصأو(س، ص) % 256]
    نهاية
نهاية


