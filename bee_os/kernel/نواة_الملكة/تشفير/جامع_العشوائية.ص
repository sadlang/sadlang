# جامع_العشوائية.ص - نظام جمع العشوائية من مصادر الأجهزة
# T0169
# ══════════════════════════════════════════════════════════════════════════════
#
# نظام جمع العشوائية (Entropy Harvester) لنواة نظام النحلة
# يجمع العشوائية من مصادر متعددة:
#   1. مؤقتات الأجهزة عالية الدقة (TSC, HPET)
#   2. مقاطعات الأجهزة (حركة الماوس، ضغطات لوحة المفاتيح)
#   3. RDRAND/RDSEED (إذا متوفر)
#   4. مؤقتات النظام (jitter)
#   5. نشاط القرص (أوقات I/O)
#
# المعمارية:
# ════════════
#   ┌──────────────────┐  ┌──────────────────┐  ┌──────────────────┐
#   │ مصدر TSC/HPET   │  │ مصدر المقاطعات  │  │   مصدر RDRAND   │
#   └────────┬─────────┘  └────────┬─────────┘  └────────┬─────────┘
#            │                     │                     │
#            └─────────────────────┼─────────────────────┘
#                                  ▼
#                    ┌──────────────────────────┐
#                    │   مُقدِّر العشوائية     │
#                    │  (Entropy Estimator)     │
#                    └──────────┬───────────────┘
#                               ▼
#                    ┌──────────────────────────┐
#                    │   مجمّع العشوائية       │
#                    │  (Entropy Pool)          │
#                    │  SHA-256 State (256 بت)  │
#                    └──────────┬───────────────┘
#                               ▼
#                    ┌──────────────────────────┐
#                    │   المولد العشوائي       │
#                    │  (CSPRNG - ChaCha20)     │
#                    └─────────────────────────┘
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
#                           الثوابت
# ══════════════════════════════════════════════════════════════════════════════

# حجم مجمّع العشوائية (بايت)
ثابت حجم_المجمّع_عشوائي = 512

# أقل عشوائية مطلوبة قبل الإنتاج (بتات)
ثابت حد_العشوائية_الأدنى = 256

# أقصى عشوائية يمكن تقديرها لكل عينة (بتات)
ثابت حد_عشوائية_عينة = 8

# العدد الأقصى لمصادر العشوائية
ثابت أقصى_مصادر = 16

# ثوابت خلط الحالة
ثابت ثابت_خلط_1 = 2654435761
ثابت ثابت_خلط_2 = 2246822519
ثابت ثابت_خلط_3 = 3266489917
ثابت ثابت_خلط_4 = 668265263

# أنواع مصادر العشوائية
ثابت مصدر_غير_معروف = 0
ثابت مصدر_مؤقت = 1
ثابت مصدر_مقاطعة = 2
ثابت مصدر_أجهزة = 3
ثابت مصدر_مستخدم = 4
ثابت مصدر_قرص = 5
ثابت مصدر_شبكة = 6


# ══════════════════════════════════════════════════════════════════════════════
#                     دوال بتّية مساعدة
# ══════════════════════════════════════════════════════════════════════════════

# XOR بتّي 32 بت
دالة رقم جع_حصأو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 != ب2)
            نتيجة = نتيجة + قيمة_بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# AND بتّي
دالة رقم جع_حصو(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 32)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 == 1)
            اذا (ب2 == 1)
                نتيجة = نتيجة + قيمة_بت
            نهاية
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# إزاحة يمينية
دالة رقم جع_يمين(رقم قيمة، رقم عدد)
    متغير نتيجة = قيمة
    متغير ع = 0
    بينما (ع < عدد)
        نتيجة = (نتيجة - (نتيجة % 2)) / 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# إزاحة يسارية مع قناع 32 بت
دالة رقم جع_يسار(رقم قيمة، رقم عدد)
    متغير نتيجة = قيمة
    متغير ع = 0
    بينما (ع < عدد)
        نتيجة = نتيجة * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة - (نتيجة / 4294967296) * 4294967296
نهاية

# القيمة المطلقة
دالة رقم جع_مطلق(رقم قيمة)
    اذا (قيمة < 0)
        ارجع قيمة * (-1)
    نهاية
    ارجع قيمة
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     صنف مُقدِّر العشوائية
# ══════════════════════════════════════════════════════════════════════════════

صنف مقدّر_العشوائية
    ## يقدّر كمية العشوائية في العينات الواردة
    ## يستخدم أسلوب قياس التباين بين العينات المتتالية

    رقم آخر_قيمة            # آخر عينة
    رقم آخر_فرق             # آخر فرق بين عينتين
    رقم آخر_فرق2            # الفرق الثاني
    رقم عداد_العينات        # عدد العينات المعالجة
    مصفوفة سجل_التقديرات    # سجل آخر 16 تقدير
    رقم فهرس_التقدير        # فهرس السجل

    باني()
        آخر_قيمة = 0
        آخر_فرق = 0
        آخر_فرق2 = 0
        عداد_العينات = 0
        سجل_التقديرات = []
        فهرس_التقدير = 0
        متغير ف = 0
        بينما (ف < 16)
            سجل_التقديرات += [0]
            ف = ف + 1
        نهاية
    نهاية

    # تقدير العشوائية في عينة جديدة (بتات)
    # يستخدم أسلوب: إذا كان الفرق كبيراً = عشوائية أكثر
    دالة رقم قدّر(رقم قيمة)
        عداد_العينات = عداد_العينات + 1

        # العينة الأولى: لا يمكن التقدير
        اذا (عداد_العينات <= 2)
            آخر_قيمة = قيمة
            ارجع 0
        نهاية

        # حساب الفرق الأول (delta)
        متغير فرق = جع_مطلق(قيمة - آخر_قيمة)

        # حساب الفرق الثاني (delta-delta)
        متغير فرق2 = جع_مطلق(فرق - آخر_فرق)

        # حساب الفرق الثالث
        متغير فرق3 = جع_مطلق(فرق2 - آخر_فرق2)

        # أخذ أكبر الفروقات
        متغير أكبر_فرق = فرق
        اذا (فرق2 > أكبر_فرق)
            أكبر_فرق = فرق2
        نهاية
        اذا (فرق3 > أكبر_فرق)
            أكبر_فرق = فرق3
        نهاية

        # تقدير البتات: log2(أكبر_فرق) تقريباً
        متغير بتات = 0
        متغير مؤقت = أكبر_فرق
        بينما (مؤقت > 0)
            بتات = بتات + 1
            مؤقت = (مؤقت - (مؤقت % 2)) / 2
        نهاية

        # تحديد الحد الأقصى
        اذا (بتات > حد_عشوائية_عينة)
            بتات = حد_عشوائية_عينة
        نهاية

        # تحديث الحالة
        آخر_فرق2 = آخر_فرق
        آخر_فرق = فرق
        آخر_قيمة = قيمة

        # تسجيل التقدير
        سجل_التقديرات[فهرس_التقدير] = بتات
        فهرس_التقدير = (فهرس_التقدير + 1) % 16

        ارجع بتات
    نهاية

    # متوسط التقديرات الأخيرة
    دالة رقم متوسط_التقدير()
        متغير مجموع = 0
        متغير ف = 0
        بينما (ف < 16)
            مجموع = مجموع + سجل_التقديرات[ف]
            ف = ف + 1
        نهاية
        ارجع مجموع / 16
    نهاية

    # إعادة ضبط المقدّر
    دالة إعادة_ضبط()
        آخر_قيمة = 0
        آخر_فرق = 0
        آخر_فرق2 = 0
        عداد_العينات = 0
        فهرس_التقدير = 0
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                     صنف مصدر العشوائية
# ══════════════════════════════════════════════════════════════════════════════

صنف مصدر_عشوائية
    ## يمثل مصدراً واحداً من مصادر العشوائية

    رقم المعرف                   # معرف المصدر
    رقم النمط                    # نوع المصدر
    رقم الجودة                   # جودة العشوائية (0-8 بتات لكل عينة)
    رقم عداد_العينات             # عدد العينات المقدمة
    رقم إجمالي_العشوائية         # إجمالي العشوائية المقدمة (بتات)
    مقدّر_العشوائية المقدّر     # مقدّر العشوائية الخاص بهذا المصدر
    رقم نشط                      # هل المصدر نشط؟
    رقم آخر_طابع_زمني            # آخر طابع زمني للعينة

    باني()
        المعرف = 0
        النمط = مصدر_غير_معروف
        الجودة = 1
        عداد_العينات = 0
        إجمالي_العشوائية = 0
        المقدّر = جديد مقدّر_العشوائية()
        نشط = 0
        آخر_طابع_زمني = 0
    نهاية

    # تهيئة المصدر
    دالة تهيئة(رقم المعرف_م، رقم النمط_م، رقم الجودة_م)
        المعرف = المعرف_م
        النمط = النمط_م
        الجودة = الجودة_م
        نشط = 1
    نهاية

    # إضافة عينة من هذا المصدر
    دالة رقم أضف_عينة(رقم العينة، رقم الطابع_الزمني)
        اذا (نشط != 1)
            ارجع 0
        نهاية

        عداد_العينات = عداد_العينات + 1

        # تقدير العشوائية
        متغير تقدير = المقدّر.قدّر(العينة)

        # استخدام الحد الأدنى بين التقدير والجودة المعلنة
        اذا (تقدير > الجودة)
            تقدير = الجودة
        نهاية

        # إضافة عشوائية من الطابع الزمني أيضاً
        اذا (الطابع_الزمني > 0)
            متغير فرق_زمني = جع_مطلق(الطابع_الزمني - آخر_طابع_زمني)
            # البتات السفلى من الفرق الزمني عشوائية عادةً
            اذا (فرق_زمني > 0)
                تقدير = تقدير + 1
            نهاية
            آخر_طابع_زمني = الطابع_الزمني
        نهاية

        إجمالي_العشوائية = إجمالي_العشوائية + تقدير
        ارجع تقدير
    نهاية

    # حالة المصدر
    دالة اطبع_وضع()
        اطبع("    المصدر ")
        اطبع(المعرف)
        اطبع(": نمط=")
        اطبع(النمط)
        اطبع(" عينات=")
        اطبع(عداد_العينات)
        اطبع(" عشوائية=")
        اطبع(إجمالي_العشوائية)
        اطبع(" بت")
        اذا (نشط == 1)
            اطبع_سطر(" [نشط]")
        والا
            اطبع_سطر(" [متوقف]")
        نهاية
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                  صنف مجمّع العشوائية المتقدم
# ══════════════════════════════════════════════════════════════════════════════

صنف مجمّع_متقدم
    ## مجمّع عشوائية متقدم مع تقنيات خلط قوية
    ## يستخدم بنية مزدوجة: مجمّع إدخال + مجمّع إخراج

    مصفوفة مجمّع_الإدخال      # مجمّع لاستقبال العينات الخام
    مصفوفة مجمّع_الإخراج      # مجمّع للإنتاج (أقوى خلطاً)
    رقم حجم_الإدخال            # حجم مجمّع الإدخال
    رقم حجم_الإخراج            # حجم مجمّع الإخراج
    رقم فهرس_إدخال             # موقع الكتابة التالي
    رقم عشوائية_متراكمة       # العشوائية المتراكمة (بتات)
    رقم عدد_عمليات_الخلط       # عدد مرات الخلط
    رقم عداد_الكتابة           # عدد مرات الكتابة

    باني()
        حجم_الإدخال = 256
        حجم_الإخراج = 64
        فهرس_إدخال = 0
        عشوائية_متراكمة = 0
        عدد_عمليات_الخلط = 0
        عداد_الكتابة = 0

        مجمّع_الإدخال = []
        مجمّع_الإخراج = []
        متغير ف = 0
        بينما (ف < حجم_الإدخال)
            مجمّع_الإدخال += [0]
            ف = ف + 1
        نهاية
        ف = 0
        بينما (ف < حجم_الإخراج)
            مجمّع_الإخراج += [0]
            ف = ف + 1
        نهاية
    نهاية

    # إدخال بايت في المجمّع (XOR + خلط)
    دالة أدخل_بايت(رقم البايت)
        # XOR مع الموقع الحالي
        مجمّع_الإدخال[فهرس_إدخال] = جع_حصأو(مجمّع_الإدخال[فهرس_إدخال]، البايت)

        # خلط مع الجيران
        متغير التالي = (فهرس_إدخال + 1) % حجم_الإدخال
        متغير السابق = (فهرس_إدخال + حجم_الإدخال - 1) % حجم_الإدخال
        مجمّع_الإدخال[التالي] = جع_حصأو(مجمّع_الإدخال[التالي]، البايت * 3 + 1)
        مجمّع_الإدخال[التالي] = مجمّع_الإدخال[التالي] % 256
        مجمّع_الإدخال[السابق] = جع_حصأو(مجمّع_الإدخال[السابق]، البايت * 7 + 5)
        مجمّع_الإدخال[السابق] = مجمّع_الإدخال[السابق] % 256

        # تقدم الفهرس
        فهرس_إدخال = (فهرس_إدخال + 1) % حجم_الإدخال
        عداد_الكتابة = عداد_الكتابة + 1

        # خلط تلقائي كل 64 بايت
        اذا (عداد_الكتابة % 64 == 0)
            خلط_داخلي()
        نهاية
    نهاية

    # إدخال كلمة 32 بت
    دالة أدخل_كلمة(رقم القيمة)
        أدخل_بايت(القيمة % 256)
        أدخل_بايت(جع_يمين(القيمة، 8) % 256)
        أدخل_بايت(جع_يمين(القيمة، 16) % 256)
        أدخل_بايت(جع_يمين(القيمة، 24) % 256)
    نهاية

    # إدخال مصفوفة بايتات
    دالة أدخل_مصفوفة(مصفوفة البيانات)
        متغير ف = 0
        بينما (ف < عدد البيانات)
            أدخل_بايت(البيانات[ف])
            ف = ف + 1
        نهاية
    نهاية

    # خلط داخلي (Stirring) باستخدام تحويل غير خطي
    دالة خلط_داخلي()
        # تمرير أول: خلط أمامي
        متغير ف = 0
        بينما (ف < حجم_الإدخال - 1)
            متغير مختلط = مجمّع_الإدخال[ف] * ثابت_خلط_1 + مجمّع_الإدخال[ف + 1]
            اذا (مختلط < 0)
                مختلط = مختلط * (-1)
            نهاية
            مجمّع_الإدخال[ف + 1] = جع_حصأو(مجمّع_الإدخال[ف + 1]، مختلط % 256)
            مجمّع_الإدخال[ف + 1] = مجمّع_الإدخال[ف + 1] % 256
            ف = ف + 1
        نهاية

        # تمرير ثاني: خلط خلفي
        ف = حجم_الإدخال - 1
        بينما (ف > 0)
            متغير مختلط2 = مجمّع_الإدخال[ف] * ثابت_خلط_2 + مجمّع_الإدخال[ف - 1]
            اذا (مختلط2 < 0)
                مختلط2 = مختلط2 * (-1)
            نهاية
            مجمّع_الإدخال[ف - 1] = جع_حصأو(مجمّع_الإدخال[ف - 1]، مختلط2 % 256)
            مجمّع_الإدخال[ف - 1] = مجمّع_الإدخال[ف - 1] % 256
            ف = ف - 1
        نهاية

        # إغلاق الحلقة
        مجمّع_الإدخال[0] = جع_حصأو(مجمّع_الإدخال[0]، مجمّع_الإدخال[حجم_الإدخال - 1] * 11 + 13)
        مجمّع_الإدخال[0] = مجمّع_الإدخال[0] % 256

        عدد_عمليات_الخلط = عدد_عمليات_الخلط + 1
    نهاية

    # نقل من مجمّع الإدخال إلى مجمّع الإخراج
    دالة نقل_إلى_إخراج()
        # خلط قبل النقل
        خلط_داخلي()
        خلط_داخلي()

        # استخراج بٌيانات مكثفة من مجمّع الإدخال
        متغير ف = 0
        بينما (ف < حجم_الإخراج)
            متغير مُكثَّف = 0
            متغير ج = 0
            بينما (ج < 4)
                متغير فهرس = (ف * 4 + ج) % حجم_الإدخال
                مُكثَّف = جع_حصأو(مُكثَّف، مجمّع_الإدخال[فهرس])
                ج = ج + 1
            نهاية
            مجمّع_الإخراج[ف] = مُكثَّف % 256
            ف = ف + 1
        نهاية

        # خلط مجمّع الإدخال بعد النقل (أمان أمامي)
        خلط_داخلي()
        خلط_داخلي()
        خلط_داخلي()
    نهاية

    # استخراج بذرة (32 بايت)
    دالة مصفوفة استخرج_بذرة()
        نقل_إلى_إخراج()

        متغير البذرة = []
        متغير ف = 0
        بينما (ف < 32)
            البذرة += [مجمّع_الإخراج[ف]]
            ف = ف + 1
        نهاية

        # مسح ما تم استخراجه
        ف = 0
        بينما (ف < 32)
            مجمّع_الإخراج[ف] = 0
            ف = ف + 1
        نهاية

        ارجع البذرة
    نهاية

    # استخراج مصفوفة بالحجم المطلوب
    دالة مصفوفة استخرج(رقم الحجم_المطلوب)
        متغير النتيجة = []
        متغير المتبقي = الحجم_المطلوب
        بينما (المتبقي > 0)
            نقل_إلى_إخراج()
            متغير الكمية = المتبقي
            اذا (الكمية > حجم_الإخراج)
                الكمية = حجم_الإخراج
            نهاية
            متغير ف = 0
            بينما (ف < الكمية)
                النتيجة += [مجمّع_الإخراج[ف]]
                ف = ف + 1
            نهاية
            المتبقي = المتبقي - الكمية
        نهاية
        ارجع النتيجة
    نهاية

    # هل تتوفر عشوائية كافية؟
    دالة منطقي كافي()
        ارجع عشوائية_متراكمة >= حد_العشوائية_الأدنى
    نهاية
نهاية


