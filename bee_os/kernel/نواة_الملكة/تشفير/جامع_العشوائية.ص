دالة رقم اختبار_المقدّر()
    اطبع_سطر("── اختبار مقدّر العشوائية ──")
    متغير نجاح = 0
    متغير فشل = 0

    متغير مقدّر = جديد مقدّر_العشوائية()

    # عينات متنوعة (يجب أن تنتج تقديرات > 0)
    متغير مجموع_التقديرات = 0
    متغير ف = 0
    بينما (ف < 20)
        متغير عينة = (ف * 37 + 13) % 256
        متغير تقدير = مقدّر.قدّر(عينة)
        مجموع_التقديرات = مجموع_التقديرات + تقدير
        ف = ف + 1
    نهاية

    اذا (مجموع_التقديرات > 0)
        نجاح = نجاح + 1
        اطبع("  ✓ عينات متنوعة: تقدير=")
        اطبع_سطر(مجموع_التقديرات)
    والا
        فشل = فشل + 1
        اطبع_سطر("  ✗ لم يتم تقدير أي عشوائية")
    نهاية

    # عينات ثابتة (يجب أن تنتج تقديرات = 0)
    مقدّر.إعادة_ضبط()
    متغير تقديرات_ثابتة = 0
    ف = 0
    بينما (ف < 10)
        متغير ت = مقدّر.قدّر(42)
        تقديرات_ثابتة = تقديرات_ثابتة + ت
        ف = ف + 1
    نهاية

    # القيم الثابتة يجب أن تنتج تقديرات صفرية أو منخفضة
    اذا (تقديرات_ثابتة < 10)
        نجاح = نجاح + 1
        اطبع("  ✓ عينات ثابتة: تقدير منخفض=")
        اطبع_سطر(تقديرات_ثابتة)
    والا
        فشل = فشل + 1
        اطبع("  ✗ تقدير عالي لعينات ثابتة: ")
        اطبع_سطر(تقديرات_ثابتة)
    نهاية

    اطبع("  النتيجة: نجاح=")
    اطبع(نجاح)
    اطبع(" فشل=")
    اطبع_سطر(فشل)
    ارجع فشل
نهاية

دالة رقم اختبار_المجمّع_المتقدم()
