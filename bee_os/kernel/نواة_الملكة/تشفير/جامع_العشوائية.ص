صنف جامع_العشوائية
    ## النظام المركزي لجمع وإدارة العشوائية في النواة

    مجمّع_متقدم المجمّع               # مجمّع العشوائية
    مصفوفة المصادر                     # مصادر العشوائية المسجلة
    رقم عدد_المصادر                    # عدد المصادر المسجلة
    محاكي_المؤقت المؤقت               # محاكي المؤقت
    محاكي_المقاطعات المقاطعات         # محاكي المقاطعات
    رقم إجمالي_العشوائية              # العشوائية الإجمالية (بتات)
    رقم إجمالي_العينات                # عدد العينات الإجمالي
    رقم جاهز                           # هل الجامع جاهز للإنتاج؟

    باني()
        المجمّع = جديد مجمّع_متقدم()
        المؤقت = جديد محاكي_المؤقت()
        المقاطعات = جديد محاكي_المقاطعات()
        المصادر = []
        عدد_المصادر = 0
        إجمالي_العشوائية = 0
        إجمالي_العينات = 0
        جاهز = 0
    نهاية

    # تسجيل مصدر عشوائية جديد
    دالة رقم سجّل_مصدر(رقم المعرف، رقم النمط، رقم الجودة)
        اذا (عدد_المصادر >= أقصى_مصادر)
            اطبع_سطر("خطأ: تجاوز الحد الأقصى لمصادر العشوائية!")
            ارجع -1
        نهاية

        متغير مصدر = جديد مصدر_عشوائية()
        مصدر.تهيئة(المعرف، النمط، الجودة)
        المصادر += [مصدر]
        عدد_المصادر = عدد_المصادر + 1

        اطبع("  تم تسجيل مصدر عشوائية: معرف=")
        اطبع(المعرف)
        اطبع(" نمط=")
        اطبع_سطر(النمط)

        ارجع عدد_المصادر - 1
    نهاية

    # إضافة عينة من مصدر معين
    دالة أضف_عينة(رقم فهرس_المصدر، رقم العينة)
        اذا (فهرس_المصدر < 0 || فهرس_المصدر >= عدد_المصادر)
            ارجع 0
        نهاية

        # قراءة المؤقت للطابع الزمني
        متغير الطابع = المؤقت.اقرأ()

        # تقدير العشوائية عبر المصدر
        متغير مصدر_حالي = المصادر[فهرس_المصدر]
        متغير بتات = مصدر_حالي.أضف_عينة(العينة، الطابع)

        # إدخال في المجمّع
        المجمّع.أدخل_بايت(العينة % 256، 0)
        المجمّع.أدخل_كلمة(الطابع)

        إجمالي_العشوائية = إجمالي_العشوائية + بتات
        المجمّع.عشوائية_متراكمة = إجمالي_العشوائية
        إجمالي_العينات = إجمالي_العينات + 1

        # تحقق من الجاهزية
        اذا (إجمالي_العشوائية >= حد_العشوائية_الأدنى)
            جاهز = 1
        نهاية

        ارجع بتات
    نهاية

    # إضافة عينات من مقاطعة لوحة مفاتيح
    دالة أضف_مقاطعة_لوحة_مفاتيح(رقم فهرس_المصدر، رقم رمز_المفتاح، رقم الوقت)
        متغير بيانات = المقاطعات.مقاطعة_لوحة_مفاتيح(رمز_المفتاح، الوقت)
        متغير ف = 0
        بينما (ف < عدد بيانات)
            أضف_عينة(فهرس_المصدر، بيانات[ف])
            ف = ف + 1
        نهاية
    نهاية

    # إضافة عينات من مقاطعة ماوس
    دالة أضف_مقاطعة_ماوس(رقم فهرس_المصدر، رقم س، رقم ص، رقم الوقت)
        متغير بيانات = المقاطعات.مقاطعة_ماوس(س، ص، الوقت)
        متغير ف = 0
        بينما (ف < عدد بيانات)
            أضف_عينة(فهرس_المصدر، بيانات[ف])
            ف = ف + 1
        نهاية
    نهاية

    # إضافة عشوائية مباشرة (مثل RDRAND)
    دالة أضف_مباشر(مصفوفة البيانات، رقم الجودة)
        متغير ف = 0
        بينما (ف < عدد البيانات)
            المجمّع.أدخل_بايت(البيانات[ف])
            ف = ف + 1
        نهاية
        إجمالي_العشوائية = إجمالي_العشوائية + (عدد البيانات * الجودة)
        المجمّع.عشوائية_متراكمة = إجمالي_العشوائية
        اذا (إجمالي_العشوائية >= حد_العشوائية_الأدنى)
            جاهز = 1
        نهاية
    نهاية

    # استخراج بذرة عشوائية
    دالة مصفوفة استخرج_بذرة()
        اذا (جاهز != 1)
            اطبع_سطر("تحذير: العشوائية غير كافية! يُفضَّل الانتظار.")
        نهاية
        ارجع المجمّع.استخرج_بذرة()
    نهاية

    # هل يوجد عشوائية كافية؟
    دالة منطقي جاهز_للإنتاج()
        ارجع جاهز == 1
    نهاية

    # وضع الجامع
    دالة اطبع_وضع()
        اطبع_سطر("── وضع جامع العشوائية ──")
        اطبع("  المصادر المسجلة: ")
        اطبع_سطر(عدد_المصادر)
        اطبع("  إجمالي العينات: ")
        اطبع_سطر(إجمالي_العينات)
        اطبع("  العشوائية المتراكمة: ")
        اطبع(إجمالي_العشوائية)
        اطبع_سطر(" بت")
        اذا (جاهز == 1)
            اطبع_سطر("  الحالة: جاهز ✓")
        والا
            اطبع_سطر("  الحالة: غير جاهز (عشوائية غير كافية) ✗")
        نهاية

        # طباعة وضع كل مصدر
        متغير ف = 0
        بينما (ف < عدد_المصادر)
            متغير م = المصادر[ف]
            م.اطبع_وضع()
            ف = ف + 1
        نهاية
    نهاية
نهاية


