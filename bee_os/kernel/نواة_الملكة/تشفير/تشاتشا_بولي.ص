    متغير طول_ct_بايت = طول_نص * 4
    هـ0 = بولي_معالجة_كتلة_ط0(هـ0، هـ1، هـ2، هـ3، هـ4، طول_aad_بايت، 0، طول_ct_بايت، 0، بولي_ر0، بولي_ر1، بولي_ر2، بولي_ر3، بولي_ر0، 1)

    # حساب الوسم النهائي
    متغير وسم0 = حساب_وسم_كلمة(هـ0، هـ1، هـ2، هـ3، هـ4، بولي_ح0، بولي_ح1، بولي_ح2، بولي_ح3، 0)
    متغير وسم1 = حساب_وسم_كلمة(هـ0، هـ1، هـ2، هـ3، هـ4، بولي_ح0، بولي_ح1، بولي_ح2، بولي_ح3، 1)
