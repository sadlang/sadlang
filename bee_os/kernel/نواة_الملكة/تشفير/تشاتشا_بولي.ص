# بناء بيانات الحشو (Padding) حسب RFC 8439
# يُضاف حشو أصفار حتى يصبح الطول مضاعفاً لـ 16
# ══════════════════════════════════════════════════════════════════════════════
دالة رقم حساب_حشو(رقم طول)
    # عدد بايتات الحشو = (16 - (طول mod 16)) mod 16
    متغير باقي = طول - (طول / 16) * 16
    اذا (باقي == 0)
        ارجع 0
    نهاية
    ارجع 16 - باقي
