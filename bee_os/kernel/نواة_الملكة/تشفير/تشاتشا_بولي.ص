    نهاية

    # ══════════════════════════════════════════
    # الخطوة 3: حساب وسم Poly1305
    # بيانات MAC = AAD || pad || ciphertext || pad || len(AAD) || len(CT)
    # ══════════════════════════════════════════

    # تهيئة المُراكم
    متغير هـ0 = 0
    متغير هـ1 = 0
    متغير هـ2 = 0
    متغير هـ3 = 0
