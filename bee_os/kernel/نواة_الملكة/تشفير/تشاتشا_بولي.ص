# ══════════════════════════════════════════════════════════════════════════════
# حساب الوسم النهائي
# tag = (h + s) mod 2^128
# ══════════════════════════════════════════════════════════════════════════════
دالة رقم حساب_وسم_كلمة(رقم هـ0، رقم هـ1، رقم هـ2، رقم هـ3، رقم هـ4، رقم حش0، رقم حش1، رقم حش2، رقم حش3، رقم رقم_الكلمة)
    متغير عمل = جديد عمليات_مساعدة()
    # إعادة تجميع h من 5 أطراف إلى 4 كلمات
    # تبسيط: استخدام الأطراف مباشرة
    متغير كـ0 = هـ0 + هـ1 * 67108864
    متغير كـ1 = هـ2 + هـ3 * 67108864
    متغير كـ2 = هـ4

    # إضافة s
    متغير و0 = عمل.جمع_32(هـ0، حش0)
    متغير و1 = عمل.جمع_32(هـ1، حش1)
    متغير و2 = عمل.جمع_32(هـ2، حش2)
    متغير و3 = عمل.جمع_32(هـ3، حش3)

    # حمل الفائض
    متغير حمل = و0 / 4294967296
    و0 = و0 - حمل * 4294967296
    و1 = عمل.جمع_32(و1، حمل)

    حمل = و1 / 4294967296
    و1 = و1 - حمل * 4294967296
    و2 = عمل.جمع_32(و2، حمل)

    حمل = و2 / 4294967296
    و2 = و2 - حمل * 4294967296
    و3 = عمل.جمع_32(و3، حمل)

    # اختصار mod 2^128
    بينما (و3 >= 4294967296)
        و3 = و3 - 4294967296
    نهاية

    اذا (رقم_الكلمة == 0)
        ارجع و0
    نهاية
    اذا (رقم_الكلمة == 1)
        ارجع و1
    نهاية
    اذا (رقم_الكلمة == 2)
        ارجع و2
    نهاية
    ارجع و3
