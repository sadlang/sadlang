#
# النتيجة: نص مشفّر + وسم 4 كلمات
# ══════════════════════════════════════════════════════════════════════════════
دالة رقم ختم_كلمة(رقم م0، رقم م1، رقم م2، رقم م3، رقم م4، رقم م5، رقم م6، رقم م7، رقم ف0، رقم ف1، رقم ف2، رقم ن0، رقم ن1، رقم ن2، رقم ن3، رقم طول_نص، رقم إ0، رقم إ1، رقم إ2، رقم إ3، رقم طول_إضافي، رقم رقم_الخرج)
    متغير عمل = جديد عمليات_مساعدة()

    # ══════════════════════════════════════════
    # الخطوة 1: توليد مفتاح Poly1305
    # ══════════════════════════════════════════
    متغير بولي_ر0 = توليد_مفتاح_بولي_كلمة(م0، م1، م2، م3، م4، م5، م6، م7، ف0، ف1، ف2، 0)
    متغير بولي_ر1 = توليد_مفتاح_بولي_كلمة(م0، م1، م2، م3، م4، م5، م6، م7، ف0، ف1، ف2، 1)
