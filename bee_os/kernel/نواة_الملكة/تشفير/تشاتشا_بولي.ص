        هـ2 = بولي_معالجة_كتلة_ط2(هـ2، إ1، إ2، بولي_ر2)
        هـ3 = بولي_معالجة_كتلة_ط3(هـ3، إ2، إ3، بولي_ر3)
        هـ4 = بولي_معالجة_كتلة_ط4(هـ4، إ3، بولي_ر0، 0)
