# بناء البيانات المُصادق عليها حسب RFC 8439 القسم 2.8
#
# mac_data = AAD || pad(AAD) || ciphertext || pad(CT) || len(AAD) || len(CT)
#
# حيث len() هو الطول الأصلي بالبايتات مُرمّزاً كـ little-endian 64-bit
# ══════════════════════════════════════════════════════════════════════════════
دالة رقم طول_بيانات_mac(رقم طول_aad، رقم طول_ct)
    # طول AAD + حشو AAD
    متغير حشو_aad = حساب_حشو(طول_aad)
    # طول CT + حشو CT
    متغير حشو_ct = حساب_حشو(طول_ct)
    # طولي AAD و CT (8 بايت لكل)
    متغير إجمالي = طول_aad + حشو_aad + طول_ct + حشو_ct + 16
    ارجع إجمالي
