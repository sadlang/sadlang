# تشفير كلمة واحدة بـ ChaCha20 (XOR مع تدفق المفتاح)
# العداد يبدأ من 1 (العداد 0 مخصص لتوليد مفتاح Poly1305)
# ══════════════════════════════════════════════════════════════════════════════
دالة رقم تشفير_كلمة(رقم نص_عادي، رقم م0، رقم م1، رقم م2، رقم م3، رقم م4، رقم م5، رقم م6، رقم م7، رقم ف0، رقم ف1، رقم ف2، رقم رقم_الكلمة)
    متغير عمل = جديد عمليات_مساعدة()

    # حساب رقم الكتلة والكلمة داخل الكتلة
    متغير رقم_كتلة = رقم_الكلمة / 16
    متغير كلمة_في_كتلة = رقم_الكلمة - رقم_كتلة * 16

    # العداد = رقم_الكتلة + 1 (العداد 0 مستخدم لمفتاح بولي)
    متغير عداد = رقم_كتلة + 1

    # توليد كلمة تدفق المفتاح
    متغير تدفق = توليد_كتلة_كلمة(م0، م1، م2، م3، م4، م5، م6، م7، عداد، ف0، ف1، ف2، كلمة_في_كتلة)

    # XOR النص العادي مع تدفق المفتاح
    متغير نص_مشفر = عمل.حص_أو_32(نص_عادي، تدفق)

    ارجع نص_مشفر
