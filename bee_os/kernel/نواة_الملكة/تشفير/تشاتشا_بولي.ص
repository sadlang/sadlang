دالة رقم فتح_كلمة(رقم م0، رقم م1، رقم م2، رقم م3، رقم م4، رقم م5، رقم م6، رقم م7، رقم ف0، رقم ف1، رقم ف2، رقم مش0، رقم مش1، رقم مش2، رقم مش3، رقم طول_مشفر، رقم إ0، رقم إ1، رقم إ2، رقم إ3، رقم طول_إضافي، رقم وسم_متوقع0، رقم وسم_متوقع1، رقم وسم_متوقع2، رقم وسم_متوقع3، رقم رقم_الخرج)
