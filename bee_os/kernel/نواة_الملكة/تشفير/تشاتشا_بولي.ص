    متغير بولي_ح1 = توليد_مفتاح_بولي_كلمة(م0، م1، م2، م3، م4، م5، م6، م7، ف0، ف1، ف2، 5)
    متغير بولي_ح2 = توليد_مفتاح_بولي_كلمة(م0، م1، م2، م3، م4، م5، م6، م7، ف0، ف1، ف2، 6)
    متغير بولي_ح3 = توليد_مفتاح_بولي_كلمة(م0، م1، م2، م3، م4، م5، م6، م7، ف0، ف1، ف2، 7)

