# ══════════════════════════════════════════════════════════════════════════════
دالة رقم مقارنة_وسم_ثابت(رقم أ0، رقم أ1، رقم أ2، رقم أ3، رقم ب0، رقم ب1، رقم ب2، رقم ب3)
    متغير عمل = جديد عمليات_مساعدة()

