# تشاتشا20-بولي1305 - تشفير مُصادق عليه مع بيانات إضافية (AEAD)
# T0163
# ══════════════════════════════════════════════════════════════════════════════
#
# التنفيذ حسب RFC 8439 (RFC 7539 المحدّث)
# ChaCha20-Poly1305 Authenticated Encryption with Associated Data
#
# خوارزمية AEAD:
#   المدخلات:
#     - مفتاح 256 بت (32 بايت)
#     - قيمة فريدة (nonce) 96 بت (12 بايت)
#     - نص عادي (plaintext) بطول متغير
#     - بيانات إضافية (AAD) بطول متغير
#
#   المخرجات:
#     - نص مشفّر (ciphertext) بنفس طول النص العادي
#     - وسم توثيق (tag) 128 بت (16 بايت)
#
#   الخطوات:
#     1. توليد مفتاح Poly1305 من ChaCha20 (العداد = 0)
#     2. تشفير النص بـ ChaCha20 (العداد = 1)
#     3. بناء بيانات MAC حسب RFC:
#        AAD || pad(AAD) || ciphertext || pad(CT) || len(AAD) || len(CT)
#     4. حساب وسم Poly1305
#
#   التحقق (فتح/Open):
#     1. توليد مفتاح Poly1305 (العداد = 0)
#     2. إعادة بناء بيانات MAC
#     3. حساب الوسم والمقارنة (ثابت الوقت)
#     4. فك التشفير فقط إذا تطابق الوسم
#
# الأمان:
#   - كل زوج (مفتاح، قيمة فريدة) يُستخدم مرة واحدة فقط
#   - الوسم يحمي كلاً من النص المشفّر والبيانات الإضافية
#   - مقارنة الوسم بزمن ثابت لمنع هجمات التوقيت
#
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
# الثوابت والأقنعة الأساسية
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# صنف: عمليات مساعدة 32 بت
# يوفر العمليات الحسابية مع قناع 32 بت
# ──────────────────────────────────────────────────────────────────────
صنف عمليات_مساعدة
    رقم قناع_32
    رقم بت_16
    رقم بت_12
    رقم بت_8
    رقم بت_7
    رقم بت_1
    رقم قناع_بايت

    باني()
        قناع_32 = 4294967296
        بت_16 = 65536
        بت_12 = 4096
        بت_8 = 256
        بت_7 = 128
        بت_1 = 2
        قناع_بايت = 256
    نهاية

    # ──────────────────────────────────────────
    # جمع مع قناع 32 بت — محاكاة U32
    # ──────────────────────────────────────────
    دالة رقم جمع_32(رقم أ، رقم ب)
        متغير نتيجة = أ + ب
        بينما (نتيجة >= قناع_32)
            نتيجة = نتيجة - قناع_32
        نهاية
        بينما (نتيجة < 0)
            نتيجة = نتيجة + قناع_32
        نهاية
        ارجع نتيجة
    نهاية

    # ──────────────────────────────────────────
    # طرح مع قناع 32 بت
    # ──────────────────────────────────────────
    دالة رقم طرح_32(رقم أ، رقم ب)
        متغير نتيجة = أ - ب
        بينما (نتيجة < 0)
            نتيجة = نتيجة + قناع_32
        نهاية
        ارجع نتيجة
    نهاية

    # ──────────────────────────────────────────
    # حصري أو لبايت (0-255)
    # ──────────────────────────────────────────
    دالة رقم حص_أو_بايت(رقم أ، رقم ب)
        متغير نتيجة = 0
        متغير قوة = 1
        متغير أ_م = أ
        متغير ب_م = ب
        متغير ع = 0
        بينما (ع < 8)
            متغير بت_أ = أ_م - (أ_م / 2) * 2
            متغير بت_ب = ب_م - (ب_م / 2) * 2
            اذا (بت_أ != بت_ب)
                نتيجة = نتيجة + قوة
            نهاية
            أ_م = أ_م / 2
            ب_م = ب_م / 2
            قوة = قوة * 2
            ع = ع + 1
        نهاية
        ارجع نتيجة
    نهاية

    # ──────────────────────────────────────────
    # حصري أو لكلمة 32 بت (4 بايتات)
    # ──────────────────────────────────────────
    دالة رقم حص_أو_32(رقم أ، رقم ب)
        # بايت 0
        متغير أ_ب0 = أ - (أ / 256) * 256
        متغير ب_ب0 = ب - (ب / 256) * 256
        متغير ن0 = حص_أو_بايت(أ_ب0، ب_ب0)

        # بايت 1
        متغير أ_ب1 = (أ / 256) - ((أ / 256) / 256) * 256
        متغير ب_ب1 = (ب / 256) - ((ب / 256) / 256) * 256
        متغير ن1 = حص_أو_بايت(أ_ب1، ب_ب1)

        # بايت 2
        متغير أ_ب2 = (أ / 65536) - ((أ / 65536) / 256) * 256
        متغير ب_ب2 = (ب / 65536) - ((ب / 65536) / 256) * 256
        متغير ن2 = حص_أو_بايت(أ_ب2، ب_ب2)

        # بايت 3
        متغير أ_ب3 = أ / 16777216
        متغير ب_ب3 = ب / 16777216
        متغير ن3 = حص_أو_بايت(أ_ب3، ب_ب3)

        ارجع ن0 + ن1 * 256 + ن2 * 65536 + ن3 * 16777216
    نهاية

    # ──────────────────────────────────────────
    # ضرب مع قناع 32 بت
    # ──────────────────────────────────────────
    دالة رقم ضرب_32(رقم أ، رقم ب)
        متغير نتيجة = أ * ب
        بينما (نتيجة >= قناع_32)
            نتيجة = نتيجة - قناع_32
        نهاية
        ارجع نتيجة
    نهاية

    # ──────────────────────────────────────────
    # تدوير دائري لليسار 32 بت
    # ──────────────────────────────────────────
    دالة رقم تدوير_يسار(رقم قيمة، رقم عدد)
        # أزاح لليسار
        متغير قوة_يسار = 1
        متغير ع_يسار = 0
        بينما (ع_يسار < عدد)
            قوة_يسار = قوة_يسار * 2
            ع_يسار = ع_يسار + 1
        نهاية
        متغير يسار = قيمة * قوة_يسار
        بينما (يسار >= قناع_32)
            يسار = يسار - قناع_32
        نهاية

        # أزاح لليمين (32 - عدد)
        متغير قوة_يمين = 1
        متغير ع_يمين = 0
        متغير إزاحة_يمين = 32 - عدد
        بينما (ع_يمين < إزاحة_يمين)
            قوة_يمين = قوة_يمين * 2
            ع_يمين = ع_يمين + 1
        نهاية
        متغير يمين = قيمة / قوة_يمين

        ارجع حص_أو_32(يسار، يمين)
    نهاية

    # ──────────────────────────────────────────
    # و المنطقي لبايت واحد
    # ──────────────────────────────────────────
    دالة رقم و_بايت(رقم أ، رقم ب)
        متغير نتيجة = 0
        متغير قوة = 1
        متغير أ_م = أ
        متغير ب_م = ب
        متغير ع = 0
        بينما (ع < 8)
            متغير بت_أ = أ_م - (أ_م / 2) * 2
            متغير بت_ب = ب_م - (ب_م / 2) * 2
            اذا (بت_أ == 1)
                اذا (بت_ب == 1)
                    نتيجة = نتيجة + قوة
                نهاية
            نهاية
            أ_م = أ_م / 2
            ب_م = ب_م / 2
            قوة = قوة * 2
            ع = ع + 1
        نهاية
        ارجع نتيجة
    نهاية

    # ──────────────────────────────────────────
    # و المنطقي لكلمة 32 بت
    # ──────────────────────────────────────────
    دالة رقم و_32(رقم أ، رقم ب)
        متغير أ_ب0 = أ - (أ / 256) * 256
        متغير ب_ب0 = ب - (ب / 256) * 256
        متغير ن0 = و_بايت(أ_ب0، ب_ب0)

        متغير أ_ب1 = (أ / 256) - ((أ / 256) / 256) * 256
        متغير ب_ب1 = (ب / 256) - ((ب / 256) / 256) * 256
        متغير ن1 = و_بايت(أ_ب1، ب_ب1)

        متغير أ_ب2 = (أ / 65536) - ((أ / 65536) / 256) * 256
        متغير ب_ب2 = (ب / 65536) - ((ب / 65536) / 256) * 256
        متغير ن2 = و_بايت(أ_ب2، ب_ب2)

        متغير أ_ب3 = أ / 16777216
        متغير ب_ب3 = ب / 16777216
        متغير ن3 = و_بايت(أ_ب3، ب_ب3)

        ارجع ن0 + ن1 * 256 + ن2 * 65536 + ن3 * 16777216
    نهاية
نهاية


