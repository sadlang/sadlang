    # معالجة AAD
    اذا (طول_إضافي > 0)
        هـ0 = بولي_معالجة_كتلة_ط0(هـ0، هـ1، هـ2، هـ3، هـ4، إ0، إ1، إ2، إ3، بولي_ر0، بولي_ر1، بولي_ر2، بولي_ر3، بولي_ر0، 0)
