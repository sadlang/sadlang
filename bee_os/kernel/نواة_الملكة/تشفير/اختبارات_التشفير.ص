دالة نتيجة_اختبار اختبار_06_تشفير_XOR()
    # XOR encryption / decryption
    متغير ن = جديد نتيجة_اختبار(6، "تشفير XOR وفك التشفير")
    متغير مفتاح = [42، 99، 13، 77، 255، 128، 64، 200]
    متغير نص_أصلي = [72، 101، 108، 108، 111، 33، 0، 1]

    # تشفير
    متغير مشفّر = []
    متغير ف = 0
    بينما (ف < عدد نص_أصلي)
        مشفّر += [اخت_حصأو(نص_أصلي[ف]، مفتاح[ف % عدد مفتاح])]
        ف = ف + 1
    نهاية

    # فك التشفير
    متغير مفكوك = []
    ف = 0
    بينما (ف < عدد مشفّر)
        مفكوك += [اخت_حصأو(مشفّر[ف]، مفتاح[ف % عدد مفتاح])]
        ف = ف + 1
    نهاية

    ن.نجح = اخت_مقارنة(نص_أصلي، مفكوك)
    ارجع ن
نهاية

