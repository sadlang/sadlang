دالة نتيجة_اختبار اختبار_28_PRNG_توزيع()
    # التحقق من توزيع مقبول (ليست كلها في نطاق ضيق)
    متغير ن = جديد نتيجة_اختبار(28، "توزيع PRNG")
    متغير حالة_م = 12345
    متغير أقل = 255
    متغير أعلى = 0
    متغير ف = 0
    بينما (ف < 100)
        حالة_م = (حالة_م * 2654435761 + 1) % 4294967296
        اذا (حالة_م < 0)
            حالة_م = حالة_م * (-1)
        نهاية
        متغير قيمة = حالة_م % 256
        اذا (قيمة < أقل)
            أقل = قيمة
        نهاية
        اذا (قيمة > أعلى)
            أعلى = قيمة
        نهاية
        ف = ف + 1
    نهاية

    # النطاق يجب أن يكون واسعاً (أكثر من 128)
    ن.نجح = (أعلى - أقل) >= 128
    ن.الملاحظات = "نطاق=" + (أعلى - أقل)
    ارجع ن
