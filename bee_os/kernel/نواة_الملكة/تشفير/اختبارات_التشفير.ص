دالة مصفوفة اخت_تجزئة(مصفوفة البيانات)
    متغير ح = [1779033703، 3144134277، 1013904242، 2773480762، 1359893119، 2600822924، 528734635، 1541459225]
    متغير ف = 0
    بينما (ف < عدد البيانات)
        متغير ب = البيانات[ف]
        متغير ق = 0
        بينما (ق < 8)
            ح[ق] = (ح[ق] + ب * (2654435761 + ق * 1000000007)) % 4294967296
            اذا (ح[ق] < 0)
                ح[ق] = ح[ق] * (-1)
            نهاية
            ق = ق + 1
        نهاية
        ف = ف + 1
    نهاية
    متغير النتيجة = []
    متغير ق2 = 0
    بينما (ق2 < 8)
        متغير ر = ح[ق2]
        النتيجة += [ر % 256]
        النتيجة += [(ر / 256) % 256]
        النتيجة += [(ر / 65536) % 256]
        النتيجة += [(ر / 16777216) % 256]
        ق2 = ق2 + 1
    نهاية
    ارجع النتيجة
نهاية

دالة رقم اخت_حصأو(رقم أ، رقم ب)
    متغير نت = 0
    متغير بت = 1
    متغير ق1 = أ
    متغير ق2 = ب
    متغير ع = 0
    بينما (ع < 8)
        متغير ب1 = ق1 % 2
        متغير ب2 = ق2 % 2
        اذا (ب1 != ب2)
            نت = نت + بت
        نهاية
        ق1 = (ق1 - ب1) / 2
        ق2 = (ق2 - ب2) / 2
        بت = بت * 2
        ع = ع + 1
    نهاية
    ارجع نت
نهاية

دالة منطقي اخت_مقارنة(مصفوفة أ، مصفوفة ب)
    اذا (عدد أ != عدد ب)
        ارجع خطأ
    نهاية
    متغير فرق = 0
    متغير ف = 0
    بينما (ف < عدد أ)
        فرق = فرق + (أ[ف] - ب[ف])
        اذا (فرق < 0)
            فرق = فرق * (-1)
        نهاية
        ف = ف + 1
    نهاية
    ارجع فرق == 0
نهاية

دالة مصفوفة اخت_HMAC(مصفوفة المفتاح، مصفوفة الرسالة)
    # HMAC = Hash((key XOR opad) || Hash((key XOR ipad) || message))
    متغير مفتاح_م = []
    متغير ف = 0
    بينما (ف < حجم_كتلة)
        اذا (ف < عدد المفتاح)
            مفتاح_م += [المفتاح[ف]]
        والا
            مفتاح_م += [0]
        نهاية
        ف = ف + 1
    نهاية

    # ipad
    متغير مدخل_داخلي = []
    ف = 0
    بينما (ف < حجم_كتلة)
        مدخل_داخلي += [اخت_حصأو(مفتاح_م[ف]، 54)]     # 0x36
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < عدد الرسالة)
        مدخل_داخلي += [الرسالة[ف]]
        ف = ف + 1
    نهاية
    متغير تجزئة_داخلية = اخت_تجزئة(مدخل_داخلي)

    # opad
    متغير مدخل_خارجي = []
    ف = 0
    بينما (ف < حجم_كتلة)
        مدخل_خارجي += [اخت_حصأو(مفتاح_م[ف]، 92)]     # 0x5C
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < عدد تجزئة_داخلية)
        مدخل_خارجي += [تجزئة_داخلية[ف]]
        ف = ف + 1
    نهاية

    ارجع اخت_تجزئة(مدخل_خارجي)
نهاية


