دالة نتيجة_اختبار اختبار_26_PRNG_تفرد()
    # خرجات PRNG متتالية مختلفة
    متغير ن = جديد نتيجة_اختبار(26، "تفرد خرج PRNG")
    متغير حالة_م = 42
    متغير خرجات = []
    متغير ف = 0
    بينما (ف < 10)
        حالة_م = (حالة_م * 6364136223846793005 + 1442695040888963407) % 4294967296
        اذا (حالة_م < 0)
            حالة_م = حالة_م * (-1)
        نهاية
        خرجات += [حالة_م % 256]
        ف = ف + 1
    نهاية

    # التحقق من عدم تطابق كل القيم
    متغير كل_متساوي = صحيح
    ف = 1
    بينما (ف < 10)
        اذا (خرجات[ف] != خرجات[0])
            كل_متساوي = خطأ
        نهاية
        ف = ف + 1
    نهاية
    ن.نجح = كل_متساوي == خطأ
    ارجع ن
نهاية

