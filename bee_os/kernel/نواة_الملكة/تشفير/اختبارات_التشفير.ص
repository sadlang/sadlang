دالة نتيجة_اختبار اختبار_04_تجزئة_حساسية()
    # تغيير بت واحد يغير التجزئة
    متغير ن = جديد نتيجة_اختبار(4، "حساسية التجزئة (Avalanche)")
    متغير ت1 = اخت_تجزئة([100، 200، 50])
    متغير ت2 = اخت_تجزئة([100، 201، 50])     # تغيير بسيط
    متغير مختلف = 0
    متغير ف = 0
    بينما (ف < حجم_تجزئة)
        اذا (ت1[ف] != ت2[ف])
            مختلف = مختلف + 1
        نهاية
        ف = ف + 1
    نهاية
    # يجب أن تختلف عدة بايتات (avalanche effect)
    ن.نجح = مختلف >= 8
    ن.الملاحظات = "اختلاف " + مختلف + " بايت"
    ارجع ن
نهاية

دالة نتيجة_اختبار اختبار_05_تجزئة_طويلة()
