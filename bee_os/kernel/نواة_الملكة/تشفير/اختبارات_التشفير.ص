دالة نتيجة_اختبار اختبار_29_مقارنة_ثابتة_الوقت()
    # المقارنة الثابتة الوقت تعطي نفس النتيجة كالمقارنة العادية
    متغير ن = جديد نتيجة_اختبار(29، "مقارنة ثابتة الوقت")

    متغير أ = [1، 2، 3، 4، 5]
    متغير ب = [1، 2، 3، 4، 5]
    متغير ج = [1، 2، 3، 4، 6]

    # مقارنة ثابتة الوقت (بدون خروج مبكر)
    متغير فرق_1 = 0
    متغير ف = 0
    بينما (ف < عدد أ)
        فرق_1 = فرق_1 + (أ[ف] - ب[ف])
        اذا (فرق_1 < 0)
            فرق_1 = فرق_1 * (-1)
        نهاية
        ف = ف + 1
    نهاية

    متغير فرق_2 = 0
    ف = 0
    بينما (ف < عدد أ)
        فرق_2 = فرق_2 + (أ[ف] - ج[ف])
        اذا (فرق_2 < 0)
            فرق_2 = فرق_2 * (-1)
        نهاية
        ف = ف + 1
    نهاية

    متغير متساوي_صحيح = فرق_1 == 0
    متغير مختلف_صحيح = فرق_2 > 0

    ن.نجح = متساوي_صحيح
    اذا (مختلف_صحيح)
        اذا (متساوي_صحيح)
            ن.نجح = صحيح
        نهاية
    والا
        ن.نجح = خطأ
    نهاية
    ارجع ن
نهاية

دالة نتيجة_اختبار اختبار_30_تعمية_XOR()
