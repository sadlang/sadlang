دالة نتيجة_اختبار اختبار_03_تجزئة_تفرد()
    # مدخلات مختلفة = مخرجات مختلفة
    متغير ن = جديد نتيجة_اختبار(3، "تجزئة فريدة لمدخلات مختلفة")
    متغير ت1 = اخت_تجزئة([1، 2، 3])
    متغير ت2 = اخت_تجزئة([4، 5، 6])
