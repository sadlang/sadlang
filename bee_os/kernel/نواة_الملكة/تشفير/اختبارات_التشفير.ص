صنف نتيجة_اختبار
    ## يخزن نتيجة اختبار واحد

    رقم الرقم
    نص الاسم
    منطقي نجح
    نص الملاحظات

    باني(رقم رقم، نص اسم)
        الرقم = رقم
        الاسم = اسم
        نجح = خطأ
        الملاحظات = ""
    نهاية

    دالة اطبع()
        اذا (نجح)
            اطبع("  ✓ [")
        والا
            اطبع("  ✗ [")
        نهاية
        اطبع(الرقم)
        اطبع("] ")
        اطبع(الاسم)
        اذا (الملاحظات != "")
            اطبع(" — ")
            اطبع(الملاحظات)
        نهاية
        اطبع_سطر("")
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#             صنف مجموعة الاختبارات
# ══════════════════════════════════════════════════════════════════════════════

صنف مجموعة_اختبارات
    ## تدير جميع الاختبارات وتجمع النتائج

    مصفوفة النتائج
    رقم عدد_النجاح
    رقم عدد_الفشل

    باني()
        النتائج = []
        عدد_النجاح = 0
        عدد_الفشل = 0
    نهاية

    دالة سجّل(نتيجة_اختبار ن)
        النتائج += [ن]
        اذا (ن.نجح)
            عدد_النجاح = عدد_النجاح + 1
        والا
            عدد_الفشل = عدد_الفشل + 1
        نهاية
        ن.اطبع()
    نهاية

    دالة اطبع_ملخص()
        اطبع_سطر("══════════════════════════════════════════════════════════")
        اطبع("  الإجمالي: ")
        اطبع(عدد النتائج)
        اطبع(" | نجاح: ")
        اطبع(عدد_النجاح)
        اطبع(" | فشل: ")
        اطبع_سطر(عدد_الفشل)

        اذا (عدد_الفشل == 0)
            اطبع_سطر("  ✅ جميع الاختبارات نجحت!")
        والا
            اطبع_سطر("  ❌ بعض الاختبارات فشلت:")
            متغير ف = 0
            بينما (ف < عدد النتائج)
                اذا (النتائج[ف].نجح == خطأ)
                    اطبع("    ✗ ")
                    اطبع_سطر(النتائج[ف].الاسم)
                نهاية
                ف = ف + 1
            نهاية
        نهاية
        اطبع_سطر("══════════════════════════════════════════════════════════")
    نهاية
نهاية


