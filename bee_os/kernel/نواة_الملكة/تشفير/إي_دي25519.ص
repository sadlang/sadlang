# إي_دي25519.ص - التوقيعات الرقمية Ed25519
# T0166
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# تنفيذ كامل لخوارزمية التوقيع الرقمي Ed25519 في لغة ص.
# Ed25519 هو نظام توقيع رقمي يعتمد على منحنى إدواردز الملتوي
# (Twisted Edwards Curve) وهو أحد أكثر خوارزميات التوقيع أماناً وسرعة.
#
# المنحنى (شكل إدواردز الملتوي):
#   -x² + y² = 1 + d·x²·y²  (mod p)
#   حيث:
#     p = 2²⁵⁵ - 19
#     d = -121665/121666 mod p
#     a = -1
#
# نقط الأساس B = (Bx, By):
#   By = 4/5 mod p
#   Bx = √((By²-1)/(d·By²+1)) mod p (الجذر الموجب)
#
# رتبة المجموعة الفرعية:
#   ℓ = 2²⁵² + 27742317777372353535851937790883648493
#
# خوارزمية التوقيع (RFC 8032):
#   المفتاح الخاص: 32 بايت عشوائي → SHA-512 → (مفتاح_عددي, nonce_prefix)
#   المفتاح العام: A = مفتاح_عددي × B
#   التوقيع: (R, S) حيث:
#     r = SHA-512(nonce_prefix ‖ message) mod ℓ
#     R = r × B
#     S = (r + SHA-512(R ‖ A ‖ message) × مفتاح_عددي) mod ℓ
#   التحقق: S × B = R + SHA-512(R ‖ A ‖ message) × A
#
# المؤلف: فريق نظام خلية النحل
# الإصدار: 1.0.0
# الرخصة: رخصة الوقف الإسلامي
# ══════════════════════════════════════════════════════════════════════════════


