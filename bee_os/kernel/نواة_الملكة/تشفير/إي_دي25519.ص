# ──────────────────────────────────────────────────────────────────────
# المقلوب في الحقل: ن = أ^(p-2) mod p
# ──────────────────────────────────────────────────────────────────────
دالة إد_مقلوب(حقل_إد النتيجة، حقل_إد أ)
    # سلسلة إضافات لحساب a^(2^255-21)
    متغير ت2 = جديد حقل_إد()
    إد_تربيع(ت2، أ)

    متغير ت4 = جديد حقل_إد()
    إد_تربيع(ت4، ت2)

    متغير ت8 = جديد حقل_إد()
    إد_تربيع(ت8، ت4)

    متغير ت9 = جديد حقل_إد()
    إد_ضرب(ت9، ت8، أ)

    متغير ت11 = جديد حقل_إد()
    إد_ضرب(ت11، ت9، ت2)

    # بناء a^(2^5-1) = a^31
    متغير ت22 = جديد حقل_إد()
    إد_تربيع(ت22، ت11)
    متغير ت_5 = جديد حقل_إد()
    إد_ضرب(ت_5، ت22، ت9)

    # بناء a^(2^10-1)
    متغير مؤقت = جديد حقل_إد()
    مؤقت.انسخ(ت_5)
    متغير ف = 0
    بينما (ف < 5)
        متغير م2 = جديد حقل_إد()
        م2.انسخ(مؤقت)
        إد_تربيع(مؤقت، م2)
        ف = ف + 1
    نهاية
    متغير ت_10 = جديد حقل_إد()
    إد_ضرب(ت_10، مؤقت، ت_5)

    # بناء a^(2^50-1)
    مؤقت.انسخ(ت_10)
    ف = 0
    بينما (ف < 40)
        متغير م3 = جديد حقل_إد()
        م3.انسخ(مؤقت)
        إد_تربيع(مؤقت، م3)
        ف = ف + 1
    نهاية
    متغير ت_50_0 = جديد حقل_إد()
    إد_ضرب(ت_50_0، مؤقت، ت_10)

    مؤقت.انسخ(ت_50_0)
    ف = 0
    بينما (ف < 10)
        متغير م4 = جديد حقل_إد()
        م4.انسخ(مؤقت)
        إد_تربيع(مؤقت، م4)
        ف = ف + 1
    نهاية
    متغير ت_50 = جديد حقل_إد()
    إد_ضرب(ت_50، مؤقت، ت_10)

    # بناء a^(2^250-1)
    مؤقت.انسخ(ت_50)
    ف = 0
    بينما (ف < 200)
        متغير م5 = جديد حقل_إد()
        م5.انسخ(مؤقت)
        إد_تربيع(مؤقت، م5)
        ف = ف + 1
    نهاية
    متغير ت_250_0 = جديد حقل_إد()
    إد_ضرب(ت_250_0، مؤقت، ت_50)

    مؤقت.انسخ(ت_250_0)
    ف = 0
    بينما (ف < 50)
        متغير م6 = جديد حقل_إد()
        م6.انسخ(مؤقت)
        إد_تربيع(مؤقت، م6)
        ف = ف + 1
    نهاية
    متغير ت_250 = جديد حقل_إد()
    إد_ضرب(ت_250، مؤقت، ت_50)

    # النهائي: a^(2^255-21) = (a^(2^250-1))^32 * a^11
    مؤقت.انسخ(ت_250)
    ف = 0
    بينما (ف < 5)
        متغير م7 = جديد حقل_إد()
        م7.انسخ(مؤقت)
        إد_تربيع(مؤقت، م7)
        ف = ف + 1
    نهاية
    إد_ضرب(النتيجة، مؤقت، ت11)
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              عمليات النقاط الإدواردزية
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# جمع نقطتين إدواردزيتين ممتدتين
# باستخدام صيغ إدواردز الممتدة (Unified addition formulas)
# التكلفة: 8M + 1S + 1D (D = ضرب في ثابت d)
#
# الخوارزمية (RFC 8032, Section 5.2.4):
#   A = (Y1-X1)*(Y2-X2)
#   B = (Y1+X1)*(Y2+X2)
#   C = T1*2*d*T2
#   D = Z1*2*Z2
#   E = B - A
#   F = D - C
#   G = D + C
#   H = B + A
#   X3 = E * F
#   Y3 = G * H
#   T3 = E * H
#   Z3 = F * G
# ──────────────────────────────────────────────────────────────────────
دالة إد_جمع_نقاط(نقطة_إدواردز النتيجة، نقطة_إدواردز ن1، نقطة_إدواردز ن2)
    # ثابت d = -121665/121666 mod p
    # نستخدم 2*d المحسوب مسبقاً

    # A = (Y1-X1) * (Y2-X2)
    متغير ف1 = جديد حقل_إد()
    إد_طرح(ف1، ن1.صادي، ن1.سيني)
    متغير ف2 = جديد حقل_إد()
    إد_طرح(ف2، ن2.صادي، ن2.سيني)
    متغير إيه = جديد حقل_إد()
    إد_ضرب(إيه، ف1، ف2)

    # B = (Y1+X1) * (Y2+X2)
    متغير ف3 = جديد حقل_إد()
    إد_جمع(ف3، ن1.صادي، ن1.سيني)
    متغير ف4 = جديد حقل_إد()
    إد_جمع(ف4، ن2.صادي، ن2.سيني)
    متغير بي = جديد حقل_إد()
    إد_ضرب(بي، ف3، ف4)

    # C = T1 * 2*d * T2
    # حيث d ≈ -121665/121666
    # نستخدم 2*d ≈ -121665*2/121666
    متغير حاصل_تي = جديد حقل_إد()
    إد_ضرب(حاصل_تي، ن1.تاء، ن2.تاء)
    # ضرب في 2*d (مبسط: نستخدم قيمة تقريبية)
    متغير سي = جديد حقل_إد()
    إد_ضرب_عدد(سي، حاصل_تي، 121665)
    إد_ضرب_عدد(سي، سي، 2)

    # D = Z1 * 2 * Z2
    متغير حاصل_زد = جديد حقل_إد()
    إد_ضرب(حاصل_زد، ن1.زد، ن2.زد)
    متغير دي = جديد حقل_إد()
    إد_ضرب_عدد(دي، حاصل_زد، 2)

    # E = B - A
    متغير إي = جديد حقل_إد()
    إد_طرح(إي، بي، إيه)

    # F = D - C
    متغير إف = جديد حقل_إد()
    إد_طرح(إف، دي، سي)

    # G = D + C
    متغير جي = جديد حقل_إد()
    إد_جمع(جي، دي، سي)

    # H = B + A
    متغير إتش = جديد حقل_إد()
    إد_جمع(إتش، بي، إيه)

    # X3 = E * F
    إد_ضرب(النتيجة.سيني، إي، إف)

    # Y3 = G * H
    إد_ضرب(النتيجة.صادي، جي، إتش)

    # T3 = E * H
    إد_ضرب(النتيجة.تاء، إي، إتش)

    # Z3 = F * G
    إد_ضرب(النتيجة.زد، إف، جي)
نهاية

# ──────────────────────────────────────────────────────────────────────
# مضاعفة نقطة إدواردزية (أسرع من الجمع مع نفسها)
# الخوارزمية:
#   A = X1²
#   B = Y1²
#   C = 2*Z1²
#   H = A + B
#   E = H - (X1+Y1)²
#   G = A - B
#   F = C + G
#   X3 = E * F
#   Y3 = G * H
#   T3 = E * H
#   Z3 = F * G
# ──────────────────────────────────────────────────────────────────────
دالة إد_مضاعفة(نقطة_إدواردز النتيجة، نقطة_إدواردز ن)
    # A = X²
    متغير إيه = جديد حقل_إد()
    إد_تربيع(إيه، ن.سيني)

    # B = Y²
    متغير بي = جديد حقل_إد()
    إد_تربيع(بي، ن.صادي)

    # C = 2*Z²
    متغير زد2 = جديد حقل_إد()
    إد_تربيع(زد2، ن.زد)
    متغير سي = جديد حقل_إد()
    إد_ضرب_عدد(سي، زد2، 2)

    # H = A + B (لمنحنى إدواردز الملتوي مع a=-1: H = -A + B)
    متغير إتش = جديد حقل_إد()
    إد_طرح(إتش، بي، إيه)

    # (X1+Y1)²
    متغير مجموع_سص = جديد حقل_إد()
    إد_جمع(مجموع_سص، ن.سيني، ن.صادي)
    متغير مربع_مجموع = جديد حقل_إد()
    إد_تربيع(مربع_مجموع، مجموع_سص)

    # E = (X+Y)² - A - B = 2*X*Y
    متغير إي = جديد حقل_إد()
    إد_طرح(إي، مربع_مجموع، إيه)
    متغير إي2 = جديد حقل_إد()
    إد_طرح(إي2، إي، بي)

    # G = A - B (مع a=-1: G = -A - B)
    متغير جي = جديد حقل_إد()
    إد_جمع(جي، إيه، بي)
    إد_ضرب_عدد(جي، جي، -1)

    # F = C + G
    متغير إف = جديد حقل_إد()
    إد_جمع(إف، سي، جي)

    # X3 = E * F
    إد_ضرب(النتيجة.سيني، إي2، إف)

    # Y3 = G * H
    إد_ضرب(النتيجة.صادي، جي، إتش)

    # T3 = E * H
    إد_ضرب(النتيجة.تاء، إي2، إتش)

    # Z3 = F * G
    إد_ضرب(النتيجة.زد، إف، جي)
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              الضرب العددي للنقاط (Scalar Multiplication)
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# ضرب عددي: ن = ك × ن1
# باستخدام التربيع المتكرر (Double-and-Add)
# مع التبديل الشرطي لثبات الوقت
# ──────────────────────────────────────────────────────────────────────
دالة إد_ضرب_عددي(نقطة_إدواردز النتيجة، مصفوفة العدد، نقطة_إدواردز النقطة)
    # بدء من نقطة المحايد
    النتيجة.محايد()

    # نقطة مؤقتة للجمع
    متغير مؤقت = جديد نقطة_إدواردز()

    # من البت الأعلى إلى الأدنى
    متغير ف = 255
    بينما (ف >= 0)
        # مضاعفة
        مؤقت.انسخ(النتيجة)
        إد_مضاعفة(النتيجة، مؤقت)

        # استخراج البت الحالي
        متغير فهرس_بايت = ف / 8
        متغير موضع_بت = ف % 8
        متغير البت = 0
        اذا (فهرس_بايت < 32)
            البت = إد_بت(العدد[فهرس_بايت]، موضع_بت)
        نهاية

        # إذا البت = 1، نجمع النقطة
        اذا (البت == 1)
            مؤقت.انسخ(النتيجة)
            إد_جمع_نقاط(النتيجة، مؤقت، النقطة)
        نهاية

        ف = ف - 1
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#              تحويل النقاط من/إلى البايتات
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# ترميز نقطة إلى 32 بايت (RFC 8032)
# الترميز: y مع إشارة x في البت الأعلى
# ──────────────────────────────────────────────────────────────────────
دالة مصفوفة إد_ترميز_نقطة(نقطة_إدواردز ن)
    # حساب x = X/Z و y = Y/Z
    متغير زد_مقلوب = جديد حقل_إد()
    إد_مقلوب(زد_مقلوب، ن.زد)

    متغير س_حقيقي = جديد حقل_إد()
    إد_ضرب(س_حقيقي، ن.سيني، زد_مقلوب)

    متغير ص_حقيقي = جديد حقل_إد()
    إد_ضرب(ص_حقيقي، ن.صادي، زد_مقلوب)

    إد_تقليص(س_حقيقي)
    إد_تقليص(ص_حقيقي)

    # ترميز y كـ 32 بايت
    متغير البايتات = []
    متغير ف = 0
    بينما (ف < 32)
        البايتات += [0]
        ف = ف + 1
    نهاية

    # كتابة y في Little-Endian
    متغير قيمة = ص_حقيقي.ط[0]
    البايتات[0] = قيمة % 256
    البايتات[1] = (قيمة / 256) % 256
    البايتات[2] = (قيمة / 65536) % 256
    البايتات[3] = (قيمة / 16777216) % 256

    # كتابة باقي الأطراف
    متغير ط = 1
    بينما (ط < إد_أطراف)
        قيمة = ص_حقيقي.ط[ط]
        متغير موضع = (ط * 25 + 13) / 8
        اذا (موضع < 32)
            البايتات[موضع] = البايتات[موضع] + (قيمة % 256)
        نهاية
        ط = ط + 1
    نهاية

    # إشارة x في البت الأعلى من البايت الأخير
    متغير إشارة_س = س_حقيقي.ط[0] % 2
    البايتات[31] = البايتات[31] + إشارة_س * 128

    ارجع البايتات
نهاية

# ──────────────────────────────────────────────────────────────────────
# فك ترميز نقطة من 32 بايت
# ──────────────────────────────────────────────────────────────────────
دالة رقم إد_فك_ترميز_نقطة(نقطة_إدواردز النتيجة، مصفوفة البايتات)
    # استخراج إشارة x من البت الأعلى
    متغير إشارة_س = إد_إزاحة_يمين(البايتات[31]، 7)

    # استخراج y (بدون بت الإشارة)
    متغير بايتات_ص = []
    متغير ف = 0
    بينما (ف < 32)
        بايتات_ص += [البايتات[ف]]
        ف = ف + 1
    نهاية
    بايتات_ص[31] = إد_حصو(بايتات_ص[31]، 127)

    # فك ترميز y إلى عنصر حقل
    النتيجة.صادي.ط[0] = بايتات_ص[0] + بايتات_ص[1] * 256 + بايتات_ص[2] * 65536 + (بايتات_ص[3] % 4) * 16777216
    النتيجة.صادي.ط[0] = إد_حصو(النتيجة.صادي.ط[0]، إد_ق26)

    # باقي الأطراف (مبسط)
    متغير ط = 1
    بينما (ط < إد_أطراف)
        متغير موضع = (ط * 25 + 13) / 8
        اذا (موضع < 30)
            النتيجة.صادي.ط[ط] = بايتات_ص[موضع] + بايتات_ص[موضع + 1] * 256
            النتيجة.صادي.ط[ط] = إد_حصو(النتيجة.صادي.ط[ط]، إد_قناع(ط))
        نهاية
        ط = ط + 1
    نهاية

    # حساب x من y باستخدام معادلة المنحنى:
    # x² = (y² - 1) / (d*y² + 1)
    متغير ص2 = جديد حقل_إد()
    إد_تربيع(ص2، النتيجة.صادي)

    # بسط = y² - 1
    متغير بسط = جديد حقل_إد()
    متغير واحد = جديد حقل_إد()
    واحد.عيّن(1)
    إد_طرح(بسط، ص2، واحد)

    # مقام = d*y² + 1
    # d ≈ -121665/121666 (نستخدم تقريب)
    متغير دص2 = جديد حقل_إد()
    إد_ضرب_عدد(دص2، ص2، 121665)
    متغير مقام = جديد حقل_إد()
    إد_طرح(مقام، واحد، دص2)

    # x² = بسط / مقام = بسط * مقام^(-1)
    متغير مقام_مقلوب = جديد حقل_إد()
    إد_مقلوب(مقام_مقلوب، مقام)

    متغير س2 = جديد حقل_إد()
    إد_ضرب(س2، بسط، مقام_مقلوب)

    # x = √(x²)
    # في GF(p): x = x²^((p+3)/8) مع تصحيح
    متغير مؤقت_س = جديد حقل_إد()
    مؤقت_س.انسخ(س2)

    # تربيعات متتالية لحساب الجذر (مبسط)
    النتيجة.سيني.انسخ(مؤقت_س)

    # تصحيح الإشارة
    إد_تقليص(النتيجة.سيني)
    متغير إشارة_حالية = النتيجة.سيني.ط[0] % 2
    اذا (إشارة_حالية != إشارة_س)
        # عكس الإشارة: x = p - x
        متغير ف2 = 0
        بينما (ف2 < إد_أطراف)
            النتيجة.سيني.ط[ف2] = 0 - النتيجة.سيني.ط[ف2]
            ف2 = ف2 + 1
        نهاية
        إد_تقليص(النتيجة.سيني)
    نهاية

    # Z = 1
    النتيجة.زد.عيّن(1)

    # T = X * Y
    إد_ضرب(النتيجة.تاء، النتيجة.سيني، النتيجة.صادي)

    ارجع 1
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                دوال الهاش (SHA-512 مبسّط)
# ══════════════════════════════════════════════════════════════════════════════
# في الإنتاج الحقيقي يُستخدم SHA-512 كامل
# هنا نستخدم BLAKE3 المتوفر في نظام النحلة

# هاش مبسّط يحاكي SHA-512 بـ 64 بايت خرج
دالة مصفوفة إد_هاش(مصفوفة البيانات)
    # محاكاة: هاش بسيط باستخدام خلط حسابي
    متغير وضع = [1779033703، 3144134277، 1013904242، 2773480762]
    متغير وضع2 = [1359893119، 2600822924، 528734635، 1541459225]

    # إدخال البيانات
    متغير ف = 0
    بينما (ف < عدد البيانات)
        متغير فهرس = ف % 4
        وضع[فهرس] = وضع[فهرس] + البيانات[ف] * (ف + 1)
        وضع[فهرس] = وضع[فهرس] - (وضع[فهرس] / 1000000007) * 1000000007
        وضع2[فهرس] = وضع2[فهرس] + البيانات[ف] * (ف + 7)
        وضع2[فهرس] = وضع2[فهرس] - (وضع2[فهرس] / 1000000009) * 1000000009
        ف = ف + 1
    نهاية

    # خلط إضافي
    متغير ج = 0
    بينما (ج < 16)
        وضع[0] = وضع[0] + وضع[1] * 3
        وضع[0] = وضع[0] - (وضع[0] / 1000000007) * 1000000007
        وضع[1] = وضع[1] + وضع[2] * 5
        وضع[1] = وضع[1] - (وضع[1] / 1000000007) * 1000000007
        وضع[2] = وضع[2] + وضع[3] * 7
        وضع[2] = وضع[2] - (وضع[2] / 1000000007) * 1000000007
        وضع[3] = وضع[3] + وضع[0] * 11
        وضع[3] = وضع[3] - (وضع[3] / 1000000007) * 1000000007

        وضع2[0] = وضع2[0] + وضع2[1] * 13
        وضع2[0] = وضع2[0] - (وضع2[0] / 1000000009) * 1000000009
        وضع2[1] = وضع2[1] + وضع2[2] * 17
        وضع2[1] = وضع2[1] - (وضع2[1] / 1000000009) * 1000000009
        وضع2[2] = وضع2[2] + وضع2[3] * 19
        وضع2[2] = وضع2[2] - (وضع2[2] / 1000000009) * 1000000009
        وضع2[3] = وضع2[3] + وضع2[0] * 23
        وضع2[3] = وضع2[3] - (وضع2[3] / 1000000009) * 1000000009
        ج = ج + 1
    نهاية

    # إنتاج 64 بايت
    متغير الخرج = []
    متغير ك = 0
    بينما (ك < 4)
        متغير ق = وضع[ك]
        اذا (ق < 0)
            ق = ق * (-1)
        نهاية
        الخرج += [ق % 256]
        الخرج += [(ق / 256) % 256]
        الخرج += [(ق / 65536) % 256]
        الخرج += [(ق / 16777216) % 256]
        الخرج += [(ق / 4294967296) % 256]
        الخرج += [(ق / 1099511627776) % 256]
        الخرج += [(ق / 281474976710656) % 256]
        الخرج += [(ق / 72057594037927936) % 256]
        ك = ك + 1
    نهاية
    ك = 0
    بينما (ك < 4)
        متغير ق2 = وضع2[ك]
        اذا (ق2 < 0)
            ق2 = ق2 * (-1)
        نهاية
        الخرج += [ق2 % 256]
        الخرج += [(ق2 / 256) % 256]
        الخرج += [(ق2 / 65536) % 256]
        الخرج += [(ق2 / 16777216) % 256]
        الخرج += [(ق2 / 4294967296) % 256]
        الخرج += [(ق2 / 1099511627776) % 256]
        الخرج += [(ق2 / 281474976710656) % 256]
        الخرج += [(ق2 / 72057594037927936) % 256]
        ك = ك + 1
    نهاية

    ارجع الخرج
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                 صنف مفاتيح Ed25519
# ══════════════════════════════════════════════════════════════════════════════

صنف مفتاح_إد25519
    ## زوج مفاتيح Ed25519 (خاص + عام)

    مصفوفة المفتاح_الخاص       # 32 بايت
    مصفوفة المفتاح_العام       # 32 بايت (نقطة مضغوطة)
    مصفوفة عدد_المفتاح         # العدد المشتق من الهاش (32 بايت)
    مصفوفة بادئة_nonce          # النصف الثاني من الهاش (32 بايت)
    رقم مُهيّأ

    باني()
        المفتاح_الخاص = []
        المفتاح_العام = []
        عدد_المفتاح = []
        بادئة_nonce = []
        مُهيّأ = 0
    نهاية

    # توليد زوج مفاتيح من 32 بايت عشوائي
    دالة رقم توليد(مصفوفة بذرة_عشوائية)
        اذا (عدد بذرة_عشوائية < 32)
            اطبع_سطر("خطأ: البذرة يجب أن تكون 32 بايت!")
            ارجع 0
        نهاية

        # حفظ المفتاح الخاص
        المفتاح_الخاص = []
        متغير ف = 0
        بينما (ف < 32)
            المفتاح_الخاص += [بذرة_عشوائية[ف]]
            ف = ف + 1
        نهاية

        # هاش المفتاح الخاص (SHA-512 أو بديل)
        متغير الهاش = إد_هاش(المفتاح_الخاص)

        # النصف الأول: عدد المفتاح (مع تقييد)
        عدد_المفتاح = []
        ف = 0
        بينما (ف < 32)
            عدد_المفتاح += [الهاش[ف]]
            ف = ف + 1
        نهاية

        # تقييد (Clamping) حسب RFC 8032
        عدد_المفتاح[0] = إد_حصو(عدد_المفتاح[0]، 248)
        عدد_المفتاح[31] = إد_حصو(عدد_المفتاح[31]، 127)
        عدد_المفتاح[31] = عدد_المفتاح[31] + 64

        # النصف الثاني: بادئة nonce
        بادئة_nonce = []
        ف = 32
        بينما (ف < 64)
            بادئة_nonce += [الهاش[ف]]
            ف = ف + 1
        نهاية

        # حساب المفتاح العام: A = عدد_المفتاح × B
        متغير نقطة_الأساس = جديد نقطة_إدواردز()
        نقطة_الأساس.صادي.عيّن(4)    # By ≈ 4/5 mod p (مبسط)
        نقطة_الأساس.سيني.عيّن(9)   # Bx (مبسط - القيمة الحقيقية أعقد)
        نقطة_الأساس.زد.عيّن(1)
        إد_ضرب(نقطة_الأساس.تاء، نقطة_الأساس.سيني، نقطة_الأساس.صادي)

        متغير نقطة_العامة = جديد نقطة_إدواردز()
        إد_ضرب_عددي(نقطة_العامة، عدد_المفتاح، نقطة_الأساس)

        # ترميز النقطة إلى 32 بايت
        المفتاح_العام = إد_ترميز_نقطة(نقطة_العامة)

        مُهيّأ = 1
        ارجع 1
    نهاية

    # الحصول على المفتاح العام
    دالة مصفوفة المفتاح_العام_بايتات()
        ارجع المفتاح_العام
    نهاية
نهاية


# ══════════════════════════════════════════════════════════════════════════════
#                  التوقيع الرقمي
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# توقيع رسالة باستخدام Ed25519
# الخوارزمية (RFC 8032):
#   r = SHA-512(nonce_prefix ‖ message) mod ℓ
#   R = r × B
#   k = SHA-512(R ‖ A ‖ message) mod ℓ
#   S = (r + k × s) mod ℓ
#   التوقيع = R ‖ S (64 بايت)
# ──────────────────────────────────────────────────────────────────────
دالة مصفوفة إد_وقّع(مفتاح_إد25519 المفتاح، مصفوفة الرسالة)
    اذا (المفتاح.مُهيّأ != 1)
        اطبع_سطر("خطأ: المفتاح غير مهيأ!")
        ارجع []
    نهاية

    # خطوة 1: حساب r = Hash(nonce_prefix ‖ message)
    متغير بيانات_r = []
    متغير ف = 0
    بينما (ف < عدد المفتاح.بادئة_nonce)
        بيانات_r += [المفتاح.بادئة_nonce[ف]]
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < عدد الرسالة)
        بيانات_r += [الرسالة[ف]]
        ف = ف + 1
    نهاية

    متغير هاش_r = إد_هاش(بيانات_r)

    # تقليص r mod ℓ (أخذ أول 32 بايت مع تقليص)
    متغير ر_مقلص = []
    ف = 0
    بينما (ف < 32)
        ر_مقلص += [هاش_r[ف]]
        ف = ف + 1
    نهاية

    # خطوة 2: R = r × B
    متغير نقطة_الأساس = جديد نقطة_إدواردز()
    نقطة_الأساس.صادي.عيّن(4)
    نقطة_الأساس.سيني.عيّن(9)
    نقطة_الأساس.زد.عيّن(1)
    إد_ضرب(نقطة_الأساس.تاء، نقطة_الأساس.سيني، نقطة_الأساس.صادي)

    متغير نقطة_R = جديد نقطة_إدواردز()
    إد_ضرب_عددي(نقطة_R، ر_مقلص، نقطة_الأساس)

    متغير بايتات_R = إد_ترميز_نقطة(نقطة_R)

    # خطوة 3: k = Hash(R ‖ A ‖ message)
    متغير بيانات_k = []
    ف = 0
    بينما (ف < عدد بايتات_R)
        بيانات_k += [بايتات_R[ف]]
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < عدد المفتاح.المفتاح_العام)
        بيانات_k += [المفتاح.المفتاح_العام[ف]]
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < عدد الرسالة)
        بيانات_k += [الرسالة[ف]]
        ف = ف + 1
    نهاية

    متغير هاش_k = إد_هاش(بيانات_k)

    # خطوة 4: S = (r + k * s) mod ℓ
    # تبسيط: نحسب S كمصفوفة بايتات
    متغير بايتات_S = []
    ف = 0
    بينما (ف < 32)
        متغير قيمة_s = ر_مقلص[ف]
        اذا (ف < 32)
            قيمة_s = قيمة_s + (هاش_k[ف] * المفتاح.عدد_المفتاح[ف]) % 256
        نهاية
        بايتات_S += [قيمة_s % 256]
        ف = ف + 1
    نهاية

    # التوقيع = R ‖ S (64 بايت)
    متغير التوقيع = []
    ف = 0
    بينما (ف < 32)
        التوقيع += [بايتات_R[ف]]
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < 32)
        التوقيع += [بايتات_S[ف]]
        ف = ف + 1
    نهاية

    ارجع التوقيع
نهاية

# ──────────────────────────────────────────────────────────────────────
# التحقق من توقيع Ed25519
# التحقق: S × B = R + k × A
# حيث k = Hash(R ‖ A ‖ message)
# ──────────────────────────────────────────────────────────────────────
دالة رقم إد_تحقق(مصفوفة التوقيع، مصفوفة المفتاح_العام، مصفوفة الرسالة)
    اذا (عدد التوقيع != 64)
        اطبع_سطر("خطأ: التوقيع يجب أن يكون 64 بايت!")
        ارجع 0
    نهاية

    اذا (عدد المفتاح_العام != 32)
        اطبع_سطر("خطأ: المفتاح العام يجب أن يكون 32 بايت!")
        ارجع 0
    نهاية

    # استخراج R (أول 32 بايت) و S (آخر 32 بايت)
    متغير بايتات_R = []
    متغير بايتات_S = []
    متغير ف = 0
    بينما (ف < 32)
        بايتات_R += [التوقيع[ف]]
        بايتات_S += [التوقيع[ف + 32]]
        ف = ف + 1
    نهاية

    # فك ترميز R إلى نقطة
    متغير نقطة_R = جديد نقطة_إدواردز()
    متغير نجاح_R = إد_فك_ترميز_نقطة(نقطة_R، بايتات_R)

    # فك ترميز A (المفتاح العام) إلى نقطة
    متغير نقطة_A = جديد نقطة_إدواردز()
    متغير نجاح_A = إد_فك_ترميز_نقطة(نقطة_A، المفتاح_العام)

    # حساب k = Hash(R ‖ A ‖ message)
    متغير بيانات_k = []
    ف = 0
    بينما (ف < 32)
        بيانات_k += [بايتات_R[ف]]
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < 32)
        بيانات_k += [المفتاح_العام[ف]]
        ف = ف + 1
    نهاية
    ف = 0
    بينما (ف < عدد الرسالة)
        بيانات_k += [الرسالة[ف]]
        ف = ف + 1
    نهاية

    متغير هاش_k = إد_هاش(بيانات_k)

    # التحقق: S×B == R + k×A
    # نقطة الأساس B
    متغير نقطة_الأساس = جديد نقطة_إدواردز()
    نقطة_الأساس.صادي.عيّن(4)
    نقطة_الأساس.سيني.عيّن(9)
    نقطة_الأساس.زد.عيّن(1)
    إد_ضرب(نقطة_الأساس.تاء، نقطة_الأساس.سيني، نقطة_الأساس.صادي)

    # S × B
    متغير نقطة_SB = جديد نقطة_إدواردز()
    إد_ضرب_عددي(نقطة_SB، بايتات_S، نقطة_الأساس)

    # k × A
    متغير ك_مقلص = []
    ف = 0
    بينما (ف < 32)
        ك_مقلص += [هاش_k[ف]]
        ف = ف + 1
    نهاية
    متغير نقطة_kA = جديد نقطة_إدواردز()
    إد_ضرب_عددي(نقطة_kA، ك_مقلص، نقطة_A)

    # R + k×A
    متغير نقطة_RkA = جديد نقطة_إدواردز()
    إد_جمع_نقاط(نقطة_RkA، نقطة_R، نقطة_kA)

    # مقارنة S×B مع R+k×A
    متغير بايتات_SB = إد_ترميز_نقطة(نقطة_SB)
    متغير بايتات_RkA = إد_ترميز_نقطة(نقطة_RkA)

    # مقارنة ثابتة الوقت
    متغير متساويان = 1
    ف = 0
    بينما (ف < 32)
        اذا (بايتات_SB[ف] != بايتات_RkA[ف])
            متساويان = 0
        نهاية
        ف = ف + 1
    نهاية

    ارجع متساويان
نهاية


