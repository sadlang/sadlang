دالة إد_ضرب_عدد(حقل_إد النتيجة، حقل_إد أ، رقم ك)
    متغير ف = 0
    بينما (ف < إد_أطراف)
        النتيجة.ط[ف] = أ.ط[ف] * ك
        ف = ف + 1
    نهاية
