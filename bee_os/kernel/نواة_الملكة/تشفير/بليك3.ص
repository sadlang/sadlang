# ──────────────────────────────────────────────────────────────────────
دالة رقم حص_عكس_32(رقم أ)
    ارجع حص_أو_32(أ، 4294967295)
نهاية


# ──────────────────────────────────────────────────────────────────────
# دوران يميني 32 بت
# ROTR(x, n) = (x >> n) | (x << (32-n))
# ──────────────────────────────────────────────────────────────────────
دالة رقم دوران_يمين(رقم ق، رقم ن)
    متغير قيمة = قص_32(ق)

    # الإزاحة اليمينية: القسمة على 2^n
    متغير مقسوم = 1
    متغير ع = 0
    بينما (ع < ن)
        مقسوم = مقسوم * 2
        ع = ع + 1
    نهاية
    متغير يمين = (قيمة - (قيمة % مقسوم)) / مقسوم

    # الإزاحة اليسارية: الضرب في 2^(32-n)
    متغير مضروب = 1
    متغير ع2 = 0
    متغير فرق = 32 - ن
    بينما (ع2 < فرق)
        مضروب = مضروب * 2
        ع2 = ع2 + 1
    نهاية
    متغير يسار = قص_32((قيمة % مقسوم) * مضروب)

    ارجع حص_أو_منطقي(يمين، يسار)
نهاية


# ──────────────────────────────────────────────────────────────────────
# إزاحة يمينية
# ──────────────────────────────────────────────────────────────────────
دالة رقم إزاحة_يمين(رقم ق، رقم ن)
    متغير قيمة = قص_32(ق)
    متغير مقسوم = 1
    متغير ع = 0
    بينما (ع < ن)
        مقسوم = مقسوم * 2
        ع = ع + 1
    نهاية
    ارجع (قيمة - (قيمة % مقسوم)) / مقسوم
نهاية


# ──────────────────────────────────────────────────────────────────────
# إزاحة يسارية
# ──────────────────────────────────────────────────────────────────────
دالة رقم إزاحة_يسار(رقم ق، رقم ن)
    متغير قيمة = قص_32(ق)
    متغير مضروب = 1
    متغير ع = 0
    بينما (ع < ن)
        مضروب = مضروب * 2
        ع = ع + 1
    نهاية
    ارجع قص_32(قيمة * مضروب)
