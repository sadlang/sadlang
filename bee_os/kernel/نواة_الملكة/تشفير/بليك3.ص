# ──────────────────────────────────────────────────────────────────────
# قص 32 بت: إبقاء فقط أدنى 32 بت
# ──────────────────────────────────────────────────────────────────────
دالة رقم قص_32(رقم ق)
    متغير ن = ق % 4294967296
    اذا (ن < 0)
        ن = ن + 4294967296
    نهاية
    ارجع ن
نهاية


# ──────────────────────────────────────────────────────────────────────
# جمع 32 بت مع القص
# ──────────────────────────────────────────────────────────────────────
دالة رقم جمع_32(رقم أ، رقم ب)
    متغير ن = أ + ب
    ارجع قص_32(ن)
نهاية


# ──────────────────────────────────────────────────────────────────────
# XOR: حصري أو
# معالجة بت ببت باستخدام الجدول:
#   0 XOR 0 = 0
#   0 XOR 1 = 1
#   1 XOR 0 = 1
#   1 XOR 1 = 0
# ──────────────────────────────────────────────────────────────────────
دالة رقم حص_أو_32(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير س1 = قص_32(أ)
    متغير س2 = قص_32(ب)
    متغير عداد = 0

    بينما (عداد < 32)
        متغير ب1 = س1 % 2
        متغير ب2 = س2 % 2

        اذا (ب1 != ب2)
            نتيجة = نتيجة + قيمة_بت
        نهاية

        س1 = (س1 - ب1) / 2
        س2 = (س2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        عداد = عداد + 1
    نهاية

    ارجع نتيجة
نهاية


# ──────────────────────────────────────────────────────────────────────
# AND: حصري و
# ──────────────────────────────────────────────────────────────────────
دالة رقم حص_و_32(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير س1 = قص_32(أ)
    متغير س2 = قص_32(ب)
    متغير عداد = 0

    بينما (عداد < 32)
        متغير ب1 = س1 % 2
        متغير ب2 = س2 % 2

        اذا (ب1 == 1)
            اذا (ب2 == 1)
                نتيجة = نتيجة + قيمة_بت
            نهاية
        نهاية

        س1 = (س1 - ب1) / 2
        س2 = (س2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        عداد = عداد + 1
    نهاية

    ارجع نتيجة
نهاية


# ──────────────────────────────────────────────────────────────────────
# OR: أو منطقية
# ──────────────────────────────────────────────────────────────────────
دالة رقم حص_أو_منطقي(رقم أ، رقم ب)
    متغير نتيجة = 0
    متغير قيمة_بت = 1
    متغير س1 = قص_32(أ)
    متغير س2 = قص_32(ب)
    متغير عداد = 0

    بينما (عداد < 32)
        متغير ب1 = س1 % 2
        متغير ب2 = س2 % 2

        اذا (ب1 == 1)
            نتيجة = نتيجة + قيمة_بت
        والا
            اذا (ب2 == 1)
                نتيجة = نتيجة + قيمة_بت
            نهاية
        نهاية

        س1 = (س1 - ب1) / 2
        س2 = (س2 - ب2) / 2
        قيمة_بت = قيمة_بت * 2
        عداد = عداد + 1
    نهاية

    ارجع نتيجة
نهاية


