# التشكيل العربي - تشكيل الحروف العربية حسب موقعها
# ══════════════════════════════════════════════════════════════════════

صنف شكل_حرف
    رقم معزول
    رقم بداية
    رقم وسط
    رقم نهائي
    رقم يتصل_يسار

    باني(رقم م، رقم ب، رقم وسطي، رقم ن، رقم يسار)
        معزول = م
        بداية = ب
        وسط = وسطي
        نهائي = ن
        يتصل_يسار = يسار
    نهاية

    دالة رقم شكل_في_موقع(رقم موقع)
        اذا (موقع == 0)
            ارجع معزول
        نهاية
        اذا (موقع == 1)
            ارجع بداية
        نهاية
        اذا (موقع == 2)
            ارجع وسط
        نهاية
        ارجع نهائي
    نهاية
نهاية

صنف مشكل_عربي
    رقم عدد_حروف
    رقم عدد_تحويلات

    باني()
        عدد_حروف = 0
        عدد_تحويلات = 0
    نهاية

    دالة رقم حرف_عربي(رقم يونيكود)
        اذا (يونيكود >= 1569)
            اذا (يونيكود <= 1610)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    دالة رقم يتصل_يسار(رقم يونيكود)
        اذا (يونيكود == 1575)
            ارجع 0
        نهاية
        اذا (يونيكود == 1583)
            ارجع 0
        نهاية
        اذا (يونيكود == 1584)
            ارجع 0
        نهاية
        اذا (يونيكود == 1585)
            ارجع 0
        نهاية
        اذا (يونيكود == 1586)
            ارجع 0
        نهاية
        اذا (يونيكود == 1608)
            ارجع 0
        نهاية
        ارجع 1
    نهاية

    دالة رقم تحديد_موقع(رقم سابق_يتصل، رقم لاحق_موجود)
        اذا (سابق_يتصل == 0)
            اذا (لاحق_موجود == 0)
                ارجع 0
            نهاية
            ارجع 1
        نهاية
        اذا (لاحق_موجود == 0)
            ارجع 3
        نهاية
        ارجع 2
    نهاية

    دالة تشكيل_نص(نص مدخل)
        اطبع("  تشكيل: ")
        اطبع_سطر(مدخل)
        عدد_تحويلات = عدد_تحويلات + 1
    نهاية

    دالة عرض_إحصائيات()
        اطبع("  تحويلات: ")
        اطبع_سطر(عدد_تحويلات)
    نهاية
نهاية

دالة رئيسية()
    متغير مشكل = جديد مشكل_عربي()
    اطبع("  ألف عربي: ")
    اطبع_سطر(مشكل.حرف_عربي(1575))
    اطبع("  ألف يتصل يسار: ")
    اطبع_سطر(مشكل.يتصل_يسار(1575))

    متغير شكل_باء = جديد شكل_حرف(65169، 65171، 65172، 65170، 1)
    اطبع("  باء معزولة: ")
    اطبع_سطر(شكل_باء.شكل_في_موقع(0))
    اطبع("  باء بداية: ")
    اطبع_سطر(شكل_باء.شكل_في_موقع(1))

    مشكل.تشكيل_نص("بسم الله الرحمن الرحيم")
    مشكل.عرض_إحصائيات()
    اطبع_سطر("  ✅ التشكيل العربي يعمل")
    ارجع 0
نهاية
