# النص_المختلط.ص - معالجة النص المختلط عربي/لاتيني
# نظام خلية النحل - نواة الملكة / نص
# إدارة المقاطع المتعددة الاتجاهات في نص واحد
# ══════════════════════════════════════════════════════════════════════

صنف مقطع_نصي
    رقم البداية
    رقم الطول
    رقم الاتجاه_المحلي
    رقم فهرس_الرسم

    باني(رقم موضع_البداية، رقم طول_المقطع، رقم اتجاه_المقطع)
        البداية = موضع_البداية
        الطول = طول_المقطع
        الاتجاه_المحلي = اتجاه_المقطع
        فهرس_الرسم = 0
    نهاية

    دالة رقم اعط_البداية()
        ارجع البداية
    نهاية

    دالة رقم اعط_الطول()
        ارجع الطول
    نهاية

    دالة رقم هل_عربي()
        ارجع الاتجاه_المحلي
    نهاية

    دالة رقم حدد_فهرس_الرسم(رقم الفهرس)
        فهرس_الرسم = الفهرس
        ارجع 1
    نهاية

    دالة رقم اعط_فهرس_الرسم()
        ارجع فهرس_الرسم
    نهاية
نهاية

صنف مقسم_المقاطع
    رقم عدد_المقاطع
    رقم أقصى_مقاطع
    رقم اتجاه_سابق

    باني()
        عدد_المقاطع = 0
        أقصى_مقاطع = 32
        اتجاه_سابق = -1
    نهاية

    دالة رقم حدد_اتجاه_رمز(رقم الرمز)
        اذا (الرمز >= 1536)
            اذا (الرمز <= 1791)
                ارجع 1
            نهاية
        نهاية
        اذا (الرمز >= 65)
            اذا (الرمز <= 122)
                ارجع 0
            نهاية
        نهاية
        ارجع -1
    نهاية

    دالة رقم هل_حد_مقطع(رقم الرمز)
        متغير اتجاه_حالي = حدد_اتجاه_رمز(الرمز)
        اذا (اتجاه_حالي == -1)
            ارجع 0
        نهاية
        اذا (اتجاه_حالي != اتجاه_سابق)
            اتجاه_سابق = اتجاه_حالي
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم سجل_مقطع()
        اذا (عدد_المقاطع >= أقصى_مقاطع)
            ارجع 0
        نهاية
        عدد_المقاطع = عدد_المقاطع + 1
        ارجع عدد_المقاطع
    نهاية

    دالة رقم اعط_عدد_المقاطع()
        ارجع عدد_المقاطع
    نهاية
نهاية

صنف مرتب_المقاطع
    رقم الاتجاه_القاعدي

    باني(رقم الاتجاه)
        الاتجاه_القاعدي = الاتجاه
    نهاية

    دالة رقم احسب_ترتيب_العرض(رقم فهرس_المقطع، رقم اتجاه_المقطع، رقم إجمالي)
        اذا (الاتجاه_القاعدي == 1)
            # الاتجاه القاعدي عربي: المقاطع العربية بترتيب عادي
            اذا (اتجاه_المقطع == 1)
                ارجع فهرس_المقطع
            والا
                ارجع إجمالي - 1 - فهرس_المقطع
            نهاية
        والا
            اذا (اتجاه_المقطع == 0)
                ارجع فهرس_المقطع
            والا
                ارجع إجمالي - 1 - فهرس_المقطع
            نهاية
        نهاية
    نهاية

    دالة رقم اعط_الاتجاه_القاعدي()
        ارجع الاتجاه_القاعدي
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير مقطع = جديد مقطع_نصي(0، 10، 1)
    اطبع("  مقطع عربي - بداية: ")
    اطبع_سطر(مقطع.اعط_البداية())
    اطبع("  مقطع عربي - طول: ")
    اطبع_سطر(مقطع.اعط_الطول())

    متغير مقسم = جديد مقسم_المقاطع()
    مقسم.سجل_مقطع()
    مقسم.سجل_مقطع()
    مقسم.سجل_مقطع()
    اطبع("  عدد المقاطع: ")
    اطبع_سطر(مقسم.اعط_عدد_المقاطع())

    اطبع("  اتجاه 1580: ")
    اطبع_سطر(مقسم.حدد_اتجاه_رمز(1580))
    اطبع("  اتجاه 72: ")
    اطبع_سطر(مقسم.حدد_اتجاه_رمز(72))

    متغير مرتب = جديد مرتب_المقاطع(1)
    اطبع("  ترتيب عرض (عربي في RTL): ")
    اطبع_سطر(مرتب.احسب_ترتيب_العرض(0، 1، 3))
    اطبع("  ترتيب عرض (لاتيني في RTL): ")
    اطبع_سطر(مرتب.احسب_ترتيب_العرض(1، 0، 3))

    اطبع_سطر("  ✅ النص_المختلط يعمل")
    ارجع 0
نهاية
