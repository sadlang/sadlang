# التركيبات.ص - التركيبات والروابط الحرفية
# نظام خلية النحل - نواة الملكة / نص
# لا، لأ، لإ، لآ
# ══════════════════════════════════════════════════════════════════════

صنف تركيبة
    رقم رمز_أول
    رقم رمز_ثاني
    نص الشكل_المركب
    رقم العرض_بالبكسل

    باني(رقم الأول، رقم الثاني، نص المركب، رقم العرض)
        رمز_أول = الأول
        رمز_ثاني = الثاني
        الشكل_المركب = المركب
        العرض_بالبكسل = العرض
    نهاية

    دالة رقم يطابق(رقم ر1، رقم ر2)
        اذا (ر1 == رمز_أول)
            اذا (ر2 == رمز_ثاني)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    دالة نص اعط_الشكل()
        ارجع الشكل_المركب
    نهاية

    دالة رقم اعط_العرض()
        ارجع العرض_بالبكسل
    نهاية
نهاية

صنف جدول_التركيبات
    رقم عدد_التركيبات
    رقم رمز_لام
    رقم رمز_ألف

    باني()
        عدد_التركيبات = 4
        رمز_لام = 1604
        رمز_ألف = 1575
    نهاية

    دالة رقم هل_تركيبة_لام_ألف(رقم ر1، رقم ر2)
        اذا (ر1 == رمز_لام)
            اذا (ر2 == رمز_ألف)
                ارجع 1
            نهاية
            # ألف مع همزة فوق
            اذا (ر2 == 1571)
                ارجع 1
            نهاية
            # ألف مع همزة تحت
            اذا (ر2 == 1573)
                ارجع 1
            نهاية
            # ألف مع مدة
            اذا (ر2 == 1570)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    دالة نص اعط_تركيبة(رقم ر1، رقم ر2)
        نص نتيجة_بحث
        نتيجة_بحث = ""
        اذا (ر1 == رمز_لام)
            اذا (ر2 == رمز_ألف)
                نتيجة_بحث = "لا"
            نهاية
            اذا (ر2 == 1571)
                نتيجة_بحث = "لأ"
            نهاية
            اذا (ر2 == 1573)
                نتيجة_بحث = "لإ"
            نهاية
            اذا (ر2 == 1570)
                نتيجة_بحث = "لآ"
            نهاية
        نهاية
        ارجع نتيجة_بحث
    نهاية

    دالة رقم اعط_عدد_التركيبات()
        ارجع عدد_التركيبات
    نهاية
نهاية

صنف معالج_التركيبات
    رقم عدد_الاستبدالات

    باني()
        عدد_الاستبدالات = 0
    نهاية

    دالة رقم عالج_زوج(رقم ر1، رقم ر2)
        متغير جدول = جديد جدول_التركيبات()
        اذا (جدول.هل_تركيبة_لام_ألف(ر1، ر2) == 1)
            عدد_الاستبدالات = عدد_الاستبدالات + 1
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم اعط_عدد_الاستبدالات()
        ارجع عدد_الاستبدالات
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير تركيبتنا = جديد تركيبة(1604، 1575، "لا"، 16)
    اطبع("  تركيبة لام-ألف: ")
    اطبع_سطر(تركيبتنا.اعط_الشكل())
    اطبع("  يطابق (1604,1575): ")
    اطبع_سطر(تركيبتنا.يطابق(1604، 1575))

    متغير جدول = جديد جدول_التركيبات()
    اطبع("  عدد التركيبات: ")
    اطبع_سطر(جدول.اعط_عدد_التركيبات())
    اطبع("  لام+ألف: ")
    اطبع_سطر(جدول.اعط_تركيبة(1604، 1575))
    اطبع("  لام+ألف_همزة: ")
    اطبع_سطر(جدول.اعط_تركيبة(1604، 1571))

    متغير معالج = جديد معالج_التركيبات()
    معالج.عالج_زوج(1604، 1575)
    معالج.عالج_زوج(1604، 1571)
    اطبع("  عدد الاستبدالات: ")
    اطبع_سطر(معالج.اعط_عدد_الاستبدالات())

    اطبع_سطر("  ✅ التركيبات يعمل")
    ارجع 0
نهاية
