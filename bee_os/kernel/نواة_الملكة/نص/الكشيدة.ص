# الكشيدة.ص - التمديد بالكشيدة للمحاذاة
# نظام خلية النحل - نواة الملكة / نص
# تمديد الحروف العربية المتصلة لملء السطر
# ══════════════════════════════════════════════════════════════════════

صنف نقطة_كشيدة
    رقم الموضع
    رقم الأولوية
    رقم العرض_الأقصى

    باني(رقم موضع_الإدراج، رقم مستوى_الأولوية، رقم أقصى_عرض)
        الموضع = موضع_الإدراج
        الأولوية = مستوى_الأولوية
        العرض_الأقصى = أقصى_عرض
    نهاية

    دالة رقم اعط_الموضع()
        ارجع الموضع
    نهاية

    دالة رقم اعط_الأولوية()
        ارجع الأولوية
    نهاية

    دالة رقم يمكن_التمديد(رقم المقدار)
        اذا (المقدار <= العرض_الأقصى)
            ارجع 1
        نهاية
        ارجع 0
    نهاية
نهاية

صنف محرك_الكشيدة
    رقم عدد_النقاط
    رقم الحد_الأدنى_للتمديد
    رقم الحد_الأقصى_للتمديد

    باني()
        عدد_النقاط = 0
        الحد_الأدنى_للتمديد = 2
        الحد_الأقصى_للتمديد = 20
    نهاية

    دالة رقم هل_حرف_قابل_للتمديد(رقم الرمز)
        # الحروف التي تقبل الكشيدة بعد الاتصال
        اذا (الرمز >= 1576)
            اذا (الرمز <= 1610)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    دالة رقم احسب_أولوية(رقم رمز_قبل، رقم رمز_بعد)
        # أعلى أولوية: بين حروف متصلة وسطية
        اذا (رمز_قبل >= 1576)
            اذا (رمز_بعد >= 1576)
                ارجع 1
            نهاية
        نهاية
        اذا (رمز_قبل >= 1576)
            ارجع 2
        نهاية
        ارجع 3
    نهاية

    دالة رقم وزع_التمديد(رقم إجمالي_التمديد، رقم عدد_مواضع)
        اذا (عدد_مواضع == 0)
            ارجع 0
        نهاية
        متغير لكل_موضع = إجمالي_التمديد / عدد_مواضع
        اذا (لكل_موضع > الحد_الأقصى_للتمديد)
            ارجع الحد_الأقصى_للتمديد
        نهاية
        اذا (لكل_موضع < الحد_الأدنى_للتمديد)
            ارجع الحد_الأدنى_للتمديد
        نهاية
        ارجع لكل_موضع
    نهاية
نهاية

صنف محاذي_النص
    رقم عرض_السطر
    رقم عرض_الهدف

    باني(رقم العرض_المتاح)
        عرض_السطر = 0
        عرض_الهدف = العرض_المتاح
    نهاية

    دالة رقم احسب_الفجوة(رقم عرض_حالي)
        عرض_السطر = عرض_حالي
        اذا (عرض_حالي >= عرض_الهدف)
            ارجع 0
        نهاية
        ارجع عرض_الهدف - عرض_حالي
    نهاية

    دالة رقم اعط_عرض_الهدف()
        ارجع عرض_الهدف
    نهاية

    دالة رقم يحتاج_كشيدة()
        اذا (عرض_السطر < عرض_الهدف)
            ارجع 1
        نهاية
        ارجع 0
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير نقطة = جديد نقطة_كشيدة(5، 1، 15)
    اطبع("  موضع الكشيدة: ")
    اطبع_سطر(نقطة.اعط_الموضع())
    اطبع("  يمكن التمديد 10: ")
    اطبع_سطر(نقطة.يمكن_التمديد(10))

    متغير محرك = جديد محرك_الكشيدة()
    اطبع("  قابل للتمديد (1580): ")
    اطبع_سطر(محرك.هل_حرف_قابل_للتمديد(1580))
    متغير توزيع = محرك.وزع_التمديد(30، 3)
    اطبع("  التمديد لكل موضع: ")
    اطبع_سطر(توزيع)

    متغير محاذي = جديد محاذي_النص(640)
    متغير فجوة = محاذي.احسب_الفجوة(580)
    اطبع("  الفجوة: ")
    اطبع_سطر(فجوة)
    اطبع("  يحتاج كشيدة: ")
    اطبع_سطر(محاذي.يحتاج_كشيدة())

    اطبع_سطر("  ✅ الكشيدة يعمل")
    ارجع 0
نهاية
