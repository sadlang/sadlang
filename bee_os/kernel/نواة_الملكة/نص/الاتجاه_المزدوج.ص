# الاتجاه_المزدوج.ص - خوارزمية الاتجاه المزدوج (BiDi)
# نظام خلية النحل - نواة الملكة / نص
# تطبيق مبسط لخوارزمية يونيكود BiDi
# ══════════════════════════════════════════════════════════════════════

صنف مستوى_تضمين
    رقم المستوى
    رقم الاتجاه
    رقم هل_تجاوز

    باني(رقم مستوى_بداية، رقم اتجاه_بداية)
        المستوى = مستوى_بداية
        الاتجاه = اتجاه_بداية
        هل_تجاوز = 0
    نهاية

    دالة رقم اعط_المستوى()
        ارجع المستوى
    نهاية

    دالة رقم اعط_الاتجاه()
        ارجع الاتجاه
    نهاية

    دالة رقم ادفع_مستوى(رقم اتجاه_جديد)
        اذا (المستوى >= 125)
            هل_تجاوز = 1
            ارجع 0
        نهاية
        المستوى = المستوى + 1
        الاتجاه = اتجاه_جديد
        ارجع 1
    نهاية

    دالة رقم انزع_مستوى()
        اذا (المستوى <= 0)
            ارجع 0
        نهاية
        المستوى = المستوى - 1
        ارجع 1
    نهاية
نهاية

صنف محلل_ثنائي_الاتجاه
    رقم المستوى_القاعدي
    رقم عدد_الأحرف
    رقم عدد_التبديلات

    باني()
        المستوى_القاعدي = 1
        عدد_الأحرف = 0
        عدد_التبديلات = 0
    نهاية

    دالة رقم حدد_فئة_الحرف(رقم الرمز)
        # 1 = عربي (RTL)، 0 = لاتيني (LTR)، 2 = رقمي، 3 = محايد
        اذا (الرمز >= 1569)
            اذا (الرمز <= 1610)
                ارجع 1
            نهاية
        نهاية
        اذا (الرمز >= 65)
            اذا (الرمز <= 122)
                ارجع 0
            نهاية
        نهاية
        اذا (الرمز >= 48)
            اذا (الرمز <= 57)
                ارجع 2
            نهاية
        نهاية
        ارجع 3
    نهاية

    دالة رقم حدد_المستوى(رقم الفئة، رقم المستوى_الحالي)
        اذا (الفئة == 1)
            اذا (المستوى_الحالي == 0)
                ارجع 1
            نهاية
            ارجع المستوى_الحالي
        نهاية
        اذا (الفئة == 0)
            اذا (المستوى_الحالي == 1)
                ارجع 2
            نهاية
            ارجع المستوى_الحالي
        نهاية
        ارجع المستوى_الحالي
    نهاية

    دالة رقم يحتاج_عكس(رقم المستوى_المحلل)
        اذا (المستوى_المحلل != المستوى_القاعدي)
            عدد_التبديلات = عدد_التبديلات + 1
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم اعط_عدد_التبديلات()
        ارجع عدد_التبديلات
    نهاية
نهاية

صنف معكوس_النص
    رقم طول_المخرج

    باني()
        طول_المخرج = 0
    نهاية

    دالة رقم اعكس_مجال(رقم البداية، رقم الطول)
        طول_المخرج = الطول
        ارجع الطول
    نهاية

    دالة رقم اعط_الطول()
        ارجع طول_المخرج
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير مستوى = جديد مستوى_تضمين(0، 1)
    اطبع("  المستوى: ")
    اطبع_سطر(مستوى.اعط_المستوى())
    مستوى.ادفع_مستوى(0)
    اطبع("  بعد الدفع: ")
    اطبع_سطر(مستوى.اعط_المستوى())

    متغير محلل = جديد محلل_ثنائي_الاتجاه()
    اطبع("  فئة 1576 (باء): ")
    اطبع_سطر(محلل.حدد_فئة_الحرف(1576))
    اطبع("  فئة 65 (A): ")
    اطبع_سطر(محلل.حدد_فئة_الحرف(65))
    اطبع("  فئة 50 (رقم): ")
    اطبع_سطر(محلل.حدد_فئة_الحرف(50))
    اطبع("  يحتاج عكس: ")
    اطبع_سطر(محلل.يحتاج_عكس(0))

    متغير معكوس = جديد معكوس_النص()
    معكوس.اعكس_مجال(0، 10)
    اطبع("  طول المعكوس: ")
    اطبع_سطر(معكوس.اعط_الطول())

    اطبع_سطر("  ✅ الاتجاه_المزدوج يعمل")
    ارجع 0
نهاية
