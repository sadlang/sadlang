# الحركات.ص - الحركات والتشكيل
# نظام خلية النحل - نواة الملكة / نص
# فتحة، كسرة، ضمة، شدة، سكون، تنوين
# ══════════════════════════════════════════════════════════════════════

صنف حركة
    رقم رمز_الحركة
    نص اسم_الحركة
    رقم إزاحة_ص
    رقم فوق_الحرف

    باني(رقم الرمز، نص الاسم، رقم الإزاحة، رقم الاتجاه)
        رمز_الحركة = الرمز
        اسم_الحركة = الاسم
        إزاحة_ص = الإزاحة
        فوق_الحرف = الاتجاه
    نهاية

    دالة رقم اعط_الرمز()
        ارجع رمز_الحركة
    نهاية

    دالة نص اعط_الاسم()
        ارجع اسم_الحركة
    نهاية

    دالة رقم هل_فوقية()
        ارجع فوق_الحرف
    نهاية

    دالة رقم اعط_الإزاحة()
        ارجع إزاحة_ص
    نهاية
نهاية

صنف جدول_الحركات
    رقم رمز_فتحة
    رقم رمز_كسرة
    رقم رمز_ضمة
    رقم رمز_شدة
    رقم رمز_سكون
    رقم رمز_تنوين_فتح
    رقم رمز_تنوين_كسر
    رقم رمز_تنوين_ضم

    باني()
        رمز_فتحة = 1614
        رمز_كسرة = 1616
        رمز_ضمة = 1615
        رمز_شدة = 1617
        رمز_سكون = 1618
        رمز_تنوين_فتح = 1611
        رمز_تنوين_كسر = 1613
        رمز_تنوين_ضم = 1612
    نهاية

    دالة رقم هل_حركة(رقم الرمز)
        اذا (الرمز >= 1611)
            اذا (الرمز <= 1618)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    دالة رقم هل_فوقية(رقم الرمز)
        اذا (الرمز == رمز_فتحة)
            ارجع 1
        نهاية
        اذا (الرمز == رمز_ضمة)
            ارجع 1
        نهاية
        اذا (الرمز == رمز_شدة)
            ارجع 1
        نهاية
        اذا (الرمز == رمز_سكون)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم اعط_إزاحة(رقم الرمز)
        اذا (الرمز == رمز_فتحة)
            ارجع -4
        نهاية
        اذا (الرمز == رمز_كسرة)
            ارجع 12
        نهاية
        اذا (الرمز == رمز_ضمة)
            ارجع -6
        نهاية
        اذا (الرمز == رمز_شدة)
            ارجع -8
        نهاية
        ارجع 0
    نهاية
نهاية

صنف مرسم_الحركات
    رقم عدد_الحركات_المرسومة

    باني()
        عدد_الحركات_المرسومة = 0
    نهاية

    دالة رقم ارسم_حركة(رقم س، رقم ص، رقم رمز_حركة)
        متغير جدول = جديد جدول_الحركات()
        اذا (جدول.هل_حركة(رمز_حركة) == 0)
            ارجع 0
        نهاية
        متغير إزاحة = جدول.اعط_إزاحة(رمز_حركة)
        متغير ص_ختامي = ص + إزاحة
        عدد_الحركات_المرسومة = عدد_الحركات_المرسومة + 1
        ارجع ص_ختامي
    نهاية

    دالة رقم اعط_العدد()
        ارجع عدد_الحركات_المرسومة
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير حركة_فتحة = جديد حركة(1614، "فتحة"، -4، 1)
    اطبع("  حركة: ")
    اطبع_سطر(حركة_فتحة.اعط_الاسم())
    اطبع("  فوقية: ")
    اطبع_سطر(حركة_فتحة.هل_فوقية())

    متغير جدول = جديد جدول_الحركات()
    اطبع("  هل 1614 حركة: ")
    اطبع_سطر(جدول.هل_حركة(1614))
    اطبع("  هل 1616 فوقية: ")
    اطبع_سطر(جدول.هل_فوقية(1616))
    اطبع("  إزاحة فتحة: ")
    اطبع_سطر(جدول.اعط_إزاحة(1614))

    متغير مرسم = جديد مرسم_الحركات()
    مرسم.ارسم_حركة(100، 50، 1614)
    مرسم.ارسم_حركة(120، 50، 1616)
    اطبع("  عدد الحركات المرسومة: ")
    اطبع_سطر(مرسم.اعط_العدد())

    اطبع_سطر("  ✅ الحركات يعمل")
    ارجع 0
نهاية
