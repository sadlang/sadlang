# فصل_الأسطر.ص - خوارزمية فصل الأسطر
# نظام خلية النحل - نواة الملكة / نص
# كسر السطور مع مراعاة خصائص النص العربي
# ══════════════════════════════════════════════════════════════════════

صنف فرصة_كسر
    رقم الموضع
    رقم العرض_قبل
    رقم الجزاء
    رقم إلزامي

    باني(رقم موضع_الكسر، رقم العرض، رقم قيمة_الجزاء)
        الموضع = موضع_الكسر
        العرض_قبل = العرض
        الجزاء = قيمة_الجزاء
        إلزامي = 0
    نهاية

    دالة رقم اعط_الموضع()
        ارجع الموضع
    نهاية

    دالة رقم اعط_العرض()
        ارجع العرض_قبل
    نهاية

    دالة رقم اعط_الجزاء()
        ارجع الجزاء
    نهاية

    دالة رقم اجعل_إلزامي()
        إلزامي = 1
        ارجع 1
    نهاية

    دالة رقم هل_إلزامي()
        ارجع إلزامي
    نهاية
نهاية

صنف محلل_الكسر
    رقم عرض_السطر_الأقصى
    رقم عدد_الأسطر
    رقم الموضع_الحالي

    باني(رقم أقصى_عرض)
        عرض_السطر_الأقصى = أقصى_عرض
        عدد_الأسطر = 1
        الموضع_الحالي = 0
    نهاية

    دالة رقم هل_مسافة(رقم الرمز)
        اذا (الرمز == 32)
            ارجع 1
        نهاية
        اذا (الرمز == 9)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم هل_سطر_جديد(رقم الرمز)
        اذا (الرمز == 10)
            ارجع 1
        نهاية
        اذا (الرمز == 13)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم هل_علامة_ترقيم_عربية(رقم الرمز)
        # فاصلة عربية
        اذا (الرمز == 1548)
            ارجع 1
        نهاية
        # فاصلة منقوطة عربية
        اذا (الرمز == 1563)
            ارجع 1
        نهاية
        # علامة استفهام عربية
        اذا (الرمز == 1567)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم يمكن_الكسر_بعد(رقم الرمز)
        اذا (هل_مسافة(الرمز) == 1)
            ارجع 1
        نهاية
        اذا (هل_علامة_ترقيم_عربية(الرمز) == 1)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم سطر_جديد()
        عدد_الأسطر = عدد_الأسطر + 1
        الموضع_الحالي = 0
        ارجع عدد_الأسطر
    نهاية

    دالة رقم اعط_عدد_الأسطر()
        ارجع عدد_الأسطر
    نهاية
نهاية

صنف مقسم_الفقرات
    رقم أقصى_أسطر_في_صفحة
    رقم عدد_الصفحات

    باني(رقم أسطر_الصفحة)
        أقصى_أسطر_في_صفحة = أسطر_الصفحة
        عدد_الصفحات = 1
    نهاية

    دالة رقم احسب_الصفحات(رقم عدد_الأسطر)
        اذا (عدد_الأسطر <= 0)
            ارجع 1
        نهاية
        عدد_الصفحات = (عدد_الأسطر / أقصى_أسطر_في_صفحة) + 1
        ارجع عدد_الصفحات
    نهاية

    دالة رقم اعط_عدد_الصفحات()
        ارجع عدد_الصفحات
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير فرصة = جديد فرصة_كسر(15، 200، 10)
    اطبع("  موضع الكسر: ")
    اطبع_سطر(فرصة.اعط_الموضع())
    فرصة.اجعل_إلزامي()
    اطبع("  إلزامي: ")
    اطبع_سطر(فرصة.هل_إلزامي())

    متغير محلل = جديد محلل_الكسر(600)
    اطبع("  هل مسافة (32): ")
    اطبع_سطر(محلل.هل_مسافة(32))
    اطبع("  هل ترقيم عربي (1548): ")
    اطبع_سطر(محلل.هل_علامة_ترقيم_عربية(1548))
    اطبع("  يمكن كسر بعد مسافة: ")
    اطبع_سطر(محلل.يمكن_الكسر_بعد(32))
    محلل.سطر_جديد()
    محلل.سطر_جديد()
    اطبع("  عدد الأسطر: ")
    اطبع_سطر(محلل.اعط_عدد_الأسطر())

    متغير مقسم = جديد مقسم_الفقرات(50)
    اطبع("  صفحات (120 سطر): ")
    اطبع_سطر(مقسم.احسب_الصفحات(120))

    اطبع_سطر("  ✅ فصل_الأسطر يعمل")
    ارجع 0
نهاية
