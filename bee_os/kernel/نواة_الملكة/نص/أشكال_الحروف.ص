# أشكال_الحروف.ص - جدول أشكال الحروف العربية
# نظام خلية النحل - نواة الملكة / نص
# الأشكال: منفصل، بدائي، وسطي، ختامي
# ══════════════════════════════════════════════════════════════════════

صنف شكل_حرف
    رقم رمز_يونيكود
    نص شكل_منفصل
    نص شكل_بدائي
    نص شكل_وسطي
    نص شكل_ختامي

    باني(رقم الرمز، نص المنفصل، نص البدائي، نص الوسطي، نص الختامي)
        رمز_يونيكود = الرمز
        شكل_منفصل = المنفصل
        شكل_بدائي = البدائي
        شكل_وسطي = الوسطي
        شكل_ختامي = الختامي
    نهاية

    دالة نص اعط_الشكل(رقم الموضع)
        اذا (الموضع == 0)
            ارجع شكل_منفصل
        نهاية
        اذا (الموضع == 1)
            ارجع شكل_بدائي
        نهاية
        اذا (الموضع == 2)
            ارجع شكل_وسطي
        نهاية
        ارجع شكل_ختامي
    نهاية

    دالة رقم يقبل_الاتصال()
        اذا (شكل_وسطي != "")
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم اعط_الرمز()
        ارجع رمز_يونيكود
    نهاية
نهاية

صنف جدول_الحروف
    رقم عدد_الحروف
    رقم سعة_الجدول
    رقم رمز_ألف
    رقم رمز_ياء

    باني()
        عدد_الحروف = 0
        سعة_الجدول = 36
        رمز_ألف = 1575
        رمز_ياء = 1610
    نهاية

    دالة رقم اعط_رمز_ألف()
        ارجع رمز_ألف
    نهاية

    دالة رقم اعط_رمز_ياء()
        ارجع رمز_ياء
    نهاية

    دالة رقم هل_حرف_عربي(رقم الرمز)
        اذا (الرمز >= 1569)
            اذا (الرمز <= 1610)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    دالة رقم موضع_الحرف(رقم الرمز، رقم قبله، رقم بعده)
        # 0=منفصل، 1=بدائي، 2=وسطي، 3=ختامي
        اذا (قبله == 0)
            اذا (بعده == 0)
                ارجع 0
            والا
                ارجع 1
            نهاية
        والا
            اذا (بعده == 0)
                ارجع 3
            والا
                ارجع 2
            نهاية
        نهاية
    نهاية
نهاية

صنف محلل_أشكال
    رقم عدد_المعالجات

    باني()
        عدد_المعالجات = 0
    نهاية

    دالة رقم حلل_سياق(رقم رمز_قبل، رقم رمز_حالي، رقم رمز_بعد)
        متغير جدول = جديد جدول_الحروف()
        اذا (جدول.هل_حرف_عربي(رمز_حالي) == 0)
            ارجع 0
        نهاية
        متغير الموضع = جدول.موضع_الحرف(رمز_حالي، رمز_قبل، رمز_بعد)
        عدد_المعالجات = عدد_المعالجات + 1
        ارجع الموضع
    نهاية

    دالة رقم اعط_عدد_المعالجات()
        ارجع عدد_المعالجات
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير شكل = جديد شكل_حرف(1576، "ب"، "بـ"، "ـبـ"، "ـب")
    اطبع_سطر("شكل حرف الباء:")
    اطبع("  منفصل: ")
    اطبع_سطر(شكل.اعط_الشكل(0))
    اطبع("  بدائي: ")
    اطبع_سطر(شكل.اعط_الشكل(1))

    متغير جدول = جديد جدول_الحروف()
    اطبع("  رمز الألف: ")
    اطبع_سطر(جدول.اعط_رمز_ألف())
    اطبع("  هل عربي (1576): ")
    اطبع_سطر(جدول.هل_حرف_عربي(1576))

    متغير محلل = جديد محلل_أشكال()
    متغير موضع = محلل.حلل_سياق(0، 1576، 1575)
    اطبع("  موضع: ")
    اطبع_سطر(موضع)

    اطبع_سطر("  ✅ أشكال_الحروف يعمل")
    ارجع 0
نهاية
