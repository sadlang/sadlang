    اطبع_سطر(م2)
    اطبع("  المساحة المتبقية: ")
    اطبع_سطر(محرك.اعط_المساحة_المتبقية())

    متغير محاذاة = جديد محاذاة_عربية(640، 20، 20)
    اطبع("  بداية السطر: ")
