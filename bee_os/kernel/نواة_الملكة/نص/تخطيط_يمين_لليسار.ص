    متغير محرك = جديد محرك_يمين_لليسار(640، 16)
    متغير م1 = محرك.ضع_عنصر(80)
    اطبع("  موضع أول: ")
    اطبع_سطر(م1)
    متغير م2 = محرك.ضع_عنصر(60)
