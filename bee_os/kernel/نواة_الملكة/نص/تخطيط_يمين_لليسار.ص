# تخطيط_يمين_لليسار.ص - محرك التخطيط من اليمين لليسار
# نظام خلية النحل - نواة الملكة / نص
# ترتيب العناصر وتموضعها في الاتجاه العربي
# ══════════════════════════════════════════════════════════════════════

صنف عنصر_تخطيط
    رقم الموضع_س
    رقم الموضع_ص
    رقم العرض
    رقم الارتفاع
    رقم هل_معكوس

    باني(رقم عرض_العنصر، رقم ارتفاع_العنصر)
        الموضع_س = 0
        الموضع_ص = 0
        العرض = عرض_العنصر
        الارتفاع = ارتفاع_العنصر
        هل_معكوس = 0
    نهاية

    دالة رقم اعط_س()
        ارجع الموضع_س
    نهاية

    دالة رقم اعط_ص()
        ارجع الموضع_ص
    نهاية

    دالة رقم اعط_العرض()
        ارجع العرض
    نهاية

    دالة رقم ضع_في(رقم س، رقم ص)
        الموضع_س = س
        الموضع_ص = ص
        ارجع 1
    نهاية
نهاية

صنف محرك_يمين_لليسار
    رقم عرض_الحاوية
    رقم المؤشر_الحالي
    رقم ارتفاع_السطر
    رقم الهامش

    باني(رقم العرض_الكلي، رقم ارتفاع_سطر_واحد)
        عرض_الحاوية = العرض_الكلي
        المؤشر_الحالي = العرض_الكلي
        ارتفاع_السطر = ارتفاع_سطر_واحد
        الهامش = 4
    نهاية

    دالة رقم ضع_عنصر(رقم عرض_العنصر)
        متغير موضع_جديد = المؤشر_الحالي - عرض_العنصر
        اذا (موضع_جديد < الهامش)
            ارجع -1
        نهاية
        المؤشر_الحالي = موضع_جديد
        ارجع موضع_جديد
    نهاية

    دالة رقم سطر_جديد()
        المؤشر_الحالي = عرض_الحاوية
        ارجع المؤشر_الحالي
    نهاية

    دالة رقم اعط_المساحة_المتبقية()
        ارجع المؤشر_الحالي - الهامش
    نهاية

    دالة رقم اعط_المؤشر()
        ارجع المؤشر_الحالي
    نهاية
نهاية

صنف محاذاة_عربية
    رقم عرض_الصفحة
    رقم هامش_يمين
    رقم هامش_يسار

    باني(رقم العرض، رقم اليمين، رقم اليسار)
        عرض_الصفحة = العرض
        هامش_يمين = اليمين
        هامش_يسار = اليسار
    نهاية

    دالة رقم موضع_بداية_السطر()
        ارجع عرض_الصفحة - هامش_يمين
    نهاية

    دالة رقم عرض_السطر_المتاح()
        ارجع عرض_الصفحة - هامش_يمين - هامش_يسار
    نهاية

    دالة رقم وسط_النص(رقم عرض_النص)
        متغير مساحة = عرض_السطر_المتاح()
        اذا (عرض_النص >= مساحة)
            ارجع هامش_يسار
        نهاية
        ارجع هامش_يسار + (مساحة - عرض_النص) / 2
    نهاية
نهاية

