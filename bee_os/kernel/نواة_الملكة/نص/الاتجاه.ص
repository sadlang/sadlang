# الاتجاه.ص - كشف اتجاه النص
# نظام خلية النحل - نواة الملكة / نص
# تحديد اتجاه النص: يمين-لليسار أم يسار-لليمين
# ══════════════════════════════════════════════════════════════════════

صنف كاشف_الاتجاه
    رقم عدد_عربي
    رقم عدد_لاتيني
    رقم عتبة_الكشف

    باني()
        عدد_عربي = 0
        عدد_لاتيني = 0
        عتبة_الكشف = 50
    نهاية

    دالة رقم هل_عربي(رقم الرمز)
        اذا (الرمز >= 1536)
            اذا (الرمز <= 1791)
                ارجع 1
            نهاية
        نهاية
        # الأرقام العربية-الهندية
        اذا (الرمز >= 1632)
            اذا (الرمز <= 1641)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    دالة رقم هل_لاتيني(رقم الرمز)
        اذا (الرمز >= 65)
            اذا (الرمز <= 90)
                ارجع 1
            نهاية
        نهاية
        اذا (الرمز >= 97)
            اذا (الرمز <= 122)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    دالة رقم حلل_رمز(رقم الرمز)
        اذا (هل_عربي(الرمز) == 1)
            عدد_عربي = عدد_عربي + 1
            ارجع 1
        نهاية
        اذا (هل_لاتيني(الرمز) == 1)
            عدد_لاتيني = عدد_لاتيني + 1
            ارجع 0
        نهاية
        ارجع -1
    نهاية

    دالة رقم اعط_الاتجاه_الرئيسي()
        اذا (عدد_عربي >= عدد_لاتيني)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    دالة رقم اعط_نسبة_عربي()
        متغير المجموع = عدد_عربي + عدد_لاتيني
        اذا (المجموع == 0)
            ارجع 0
        نهاية
        ارجع (عدد_عربي * 100) / المجموع
    نهاية
نهاية

صنف نطاق_اتجاه
    رقم البداية
    رقم الطول
    رقم الاتجاه_المحلي

    باني(رقم موضع_البداية، رقم طول_النطاق، رقم اتجاه_النطاق)
        البداية = موضع_البداية
        الطول = طول_النطاق
        الاتجاه_المحلي = اتجاه_النطاق
    نهاية

    دالة رقم اعط_البداية()
        ارجع البداية
    نهاية

    دالة رقم اعط_الطول()
        ارجع الطول
    نهاية

    دالة رقم اعط_النهاية()
        ارجع البداية + الطول
    نهاية

    دالة رقم هل_يمين_لليسار()
        ارجع الاتجاه_المحلي
    نهاية
نهاية

صنف قائمة_النطاقات
    رقم عدد_النطاقات
    رقم أقصى_عدد

    باني()
        عدد_النطاقات = 0
        أقصى_عدد = 64
    نهاية

    دالة رقم أضف_نطاق(رقم البداية، رقم الطول، رقم الاتجاه)
        اذا (عدد_النطاقات >= أقصى_عدد)
            ارجع 0
        نهاية
        عدد_النطاقات = عدد_النطاقات + 1
        ارجع 1
    نهاية

    دالة رقم اعط_العدد()
        ارجع عدد_النطاقات
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
دالة رئيسية()
    متغير كاشف = جديد كاشف_الاتجاه()
    كاشف.حلل_رمز(1576)
    كاشف.حلل_رمز(1578)
    كاشف.حلل_رمز(65)
    اطبع("  الاتجاه الرئيسي (1=RTL): ")
    اطبع_سطر(كاشف.اعط_الاتجاه_الرئيسي())
    اطبع("  نسبة عربي: ")
    اطبع_سطر(كاشف.اعط_نسبة_عربي())

    متغير نطاق = جديد نطاق_اتجاه(0، 15، 1)
    اطبع("  بداية النطاق: ")
    اطبع_سطر(نطاق.اعط_البداية())
    اطبع("  نهاية النطاق: ")
    اطبع_سطر(نطاق.اعط_النهاية())

    متغير قائمة = جديد قائمة_النطاقات()
    قائمة.أضف_نطاق(0، 10، 1)
    قائمة.أضف_نطاق(10، 5، 0)
    اطبع("  عدد النطاقات: ")
    اطبع_سطر(قائمة.اعط_العدد())

    اطبع_سطر("  ✅ الاتجاه يعمل")
    ارجع 0
نهاية
