# اختبار 1: نظام الذاكرة
# ─────────────────────────────────────────────────────────────────────────────
دالة منطقي اختبر_الذاكرة()
    اطبع_فاصل("اختبار الذاكرة")

    متغير إجمالي = 8192    ## 8 GB بالـ MB
    متغير مستخدم = 0
    متغير حر     = إجمالي

    ## محاكاة تخصيص صفحات
    متغير صفحة = 4096       ## 4 KB لكل صفحة

    ## 1. اختبار الحسابات الأساسية
    متغير صفحات_إجمالي = إجمالي * 1024 / صفحة
    اختبر("صفحات الذاكرة = 2048", صفحات_إجمالي == 2048)

    ## 2. اختبار التخصيص المتعدد
    متغير كتل = [128, 256, 512, 1024, 2048]
    لكل كتلة في كتل
        مستخدم = مستخدم + كتلة
        حر = إجمالي - مستخدم / 1024
    نهاية
    اختبر("تخصيص 5 كتل ذاكرة", مستخدم == 3968)

    ## 3. اختبار حماية الذاكرة
    متغير نطاق_قانوني = صحيح
    متغير عنوان = 0x1000
    متغير حد_عليه = 0xFFFFFFFF
    اذا (عنوان > حد_عليه)
        نطاق_قانوني = خطأ
    نهاية
    اختبر("حماية النطاق: عنوان 0x1000 في نطاق قانوني", نطاق_قانوني)

    ## 4. اختبار الكاش
    متغير حجم_L1 = 32     ## KB
    متغير حجم_L2 = 256    ## KB
    متغير حجم_L3 = 8192   ## KB
    اختبر("هرمية الكاش L1<L2<L3", حجم_L1 < حجم_L2 && حجم_L2 < حجم_L3)

    اطبع_سطر("  الذاكرة المتاحة: 8 GB | الكاش: L1=32K، L2=256K، L3=8M")
    ارجع عدد_اختبارات_فاشلة == 0
نهاية

