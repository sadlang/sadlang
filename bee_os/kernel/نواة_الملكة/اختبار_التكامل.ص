# ─────────────────────────────────────────────────────────────────────────────
# دوال الاختبار
# ─────────────────────────────────────────────────────────────────────────────

دالة منطقي اختبر(نص اسم_الاختبار، منطقي شرط)
    اذا (شرط)
        عدد_اختبارات_ناجحة = عدد_اختبارات_ناجحة + 1
        اطبع("  ✅ ")
        اطبع_سطر(اسم_الاختبار)
        ارجع صحيح
    وإلا
        عدد_اختبارات_فاشلة = عدد_اختبارات_فاشلة + 1
        اطبع("  ❌ فشل: ")
        اطبع_سطر(اسم_الاختبار)
        ارجع خطأ
    نهاية
نهاية

دالة اطبع_فاصل(نص عنوان)
    اطبع("")
    اطبع("  ═══ ")
    اطبع(عنوان)
    اطبع_سطر(" ═══")
نهاية

