    نهاية
    اختبر("6 تأثيرات صوتية", عدد_ت == 6)

    ## اختبار مستوى الصوت
    متغير صوت = 0.75
    اختبر("مستوى الصوت 75%", صوت == 0.75)
    اختبر("مستوى صالح (0-1)", صوت >= 0.0 && صوت <= 1.0)

    اطبع_سطر("  الصوت: 48kHz | 16bt | ستيريو | 6 تأثيرات")
    ارجع صحيح
نهاية

