    اختبر("WAV 48k: ~10.5 MB/min", MB_لكل_دقيقة > 10 && MB_لكل_دقيقة < 12)

    ## اختبار التأثيرات
    متغير تأثيرات = [0, 1, 2, 3, 4, 5]
    متغير عدد_ت = 0
    لكل ت في تأثيرات
