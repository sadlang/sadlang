# مدير_السائقات.ص — بيضة: نظام تحميل السائقات الديناميكي
# ══════════════════════════════════════════════════════════════════════════════
# مهمة ٩٥: تحميل ساخن + عزل + توقيع + تبعيات
# ══════════════════════════════════════════════════════════════════════════════

# حالات السائق
ثابت حالة_غير_محمل = 0
ثابت حالة_محمل = 1
ثابت حالة_نشط = 2
ثابت حالة_موقف = 3
ثابت حالة_خطأ = 4

# أنواع السائقات
ثابت نوع_شاشة = 1
ثابت نوع_صوت = 2
ثابت نوع_شبكة = 3
ثابت نوع_تخزين = 4
ثابت نوع_إدخال = 5
ثابت نوع_طابعة = 6
ثابت نوع_بلوتوث = 7
ثابت نوع_يو_اس_بي = 8

صنف سائق
    رقم المعرف
    نص الاسم
    رقم النوع
    رقم الحالة
    نص الإصدار
    منطقي موقع        # موقع رقمياً
    رقم حجم_الذاكرة   # كيلوبايت
    رقم عدد_الأخطاء
    رقم عدد_الطلبات

    باني(رقم معرف, نص اسم, رقم نوع, نص إصدار)
        المعرف = معرف
        الاسم = اسم
        النوع = نوع
        الحالة = حالة_غير_محمل
        الإصدار = إصدار
        موقع = صحيح
        حجم_الذاكرة = 64
        عدد_الأخطاء = 0
        عدد_الطلبات = 0
    نهاية

    دالة اسم_النوع()
        اذا (النوع == نوع_شاشة)
            ارجع "شاشة"
        والا_اذا (النوع == نوع_صوت)
            ارجع "صوت"
        والا_اذا (النوع == نوع_شبكة)
            ارجع "شبكة"
        والا_اذا (النوع == نوع_تخزين)
            ارجع "تخزين"
        والا_اذا (النوع == نوع_إدخال)
            ارجع "إدخال"
        والا_اذا (النوع == نوع_طابعة)
            ارجع "طابعة"
        والا_اذا (النوع == نوع_بلوتوث)
            ارجع "بلوتوث"
        والا_اذا (النوع == نوع_يو_اس_بي)
            ارجع "USB"
        نهاية
        ارجع "مجهول"
    نهاية

    دالة اسم_الحالة()
        اذا (الحالة == حالة_غير_محمل)
            ارجع "غير محمل"
        والا_اذا (الحالة == حالة_محمل)
            ارجع "محمل"
        والا_اذا (الحالة == حالة_نشط)
            ارجع "نشط"
        والا_اذا (الحالة == حالة_موقف)
            ارجع "موقف"
        والا_اذا (الحالة == حالة_خطأ)
            ارجع "خطأ"
        نهاية
        ارجع "مجهول"
    نهاية

    دالة اطبع_معلومات()
        اطبع("    [") اطبع(المعرف) اطبع("] ")
        اطبع(الاسم) اطبع(" (") اطبع(اسم_النوع()) اطبع(")")
        اطبع(" v") اطبع(الإصدار)
        اطبع(" [") اطبع(اسم_الحالة()) اطبع("]")
        اطبع(" ") اطبع(حجم_الذاكرة) اطبع("KB")
        اذا (موقع)
            اطبع(" موقع")
        والا
            اطبع(" غير موقع!")
        نهاية
        اطبع_سطر("")
    نهاية
نهاية

صنف مدير_السائقات
    رقم عدد_السائقات
    رقم سائقات_نشطة
    رقم ذاكرة_مستخدمة
    رقم أخطاء_تحميل
    رقم تحميلات_ساخنة

    باني()
        عدد_السائقات = 0
        سائقات_نشطة = 0
        ذاكرة_مستخدمة = 0
        أخطاء_تحميل = 0
        تحميلات_ساخنة = 0
    نهاية

    دالة حمل_سائق(سائق سائ)
        اطبع("  تحميل: ") اطبع(سائ.الاسم) اطبع("...")

        # التحقق من التوقيع
        اذا (!سائ.موقع)
            اطبع_سطر(" رفض! غير موقع رقمياً")
            أخطاء_تحميل = أخطاء_تحميل + 1
            سائ.الحالة = حالة_خطأ
            ارجع خطأ
        نهاية

        # تخصيص ذاكرة معزولة
        ذاكرة_مستخدمة = ذاكرة_مستخدمة + سائ.حجم_الذاكرة
        سائ.الحالة = حالة_محمل
        اطبع(" محمل")

        # تفعيل
        سائ.الحالة = حالة_نشط
        سائقات_نشطة = سائقات_نشطة + 1
        عدد_السائقات = عدد_السائقات + 1
        اطبع_سطر(" ← نشط")

        ارجع صحيح
    نهاية

    دالة أوقف_سائق(سائق سائ)
        اذا (سائ.الحالة != حالة_نشط)
            اطبع("  ") اطبع(سائ.الاسم) اطبع_سطر(" ليس نشطاً")
            ارجع خطأ
        نهاية
        سائ.الحالة = حالة_موقف
        سائقات_نشطة = سائقات_نشطة - 1
        ذاكرة_مستخدمة = ذاكرة_مستخدمة - سائ.حجم_الذاكرة
        اطبع("  إيقاف: ") اطبع(سائ.الاسم) اطبع_سطر(" ← موقف")
        ارجع صحيح
    نهاية

    دالة تحميل_ساخن(سائق سائ_قديم, سائق سائ_جديد)
        اطبع("  تحميل ساخن: ") اطبع(سائ_قديم.الاسم)
        اطبع(" v") اطبع(سائ_قديم.الإصدار)
        اطبع(" → v") اطبع_سطر(سائ_جديد.الإصدار)

        # إيقاف القديم
        سائ_قديم.الحالة = حالة_موقف
        # تحميل الجديد
        سائ_جديد.الحالة = حالة_نشط
        ذاكرة_مستخدمة = ذاكرة_مستخدمة - سائ_قديم.حجم_الذاكرة + سائ_جديد.حجم_الذاكرة
        تحميلات_ساخنة = تحميلات_ساخنة + 1
        اطبع_سطر("    تم التبديل بنجاح بدون انقطاع!")
        ارجع صحيح
    نهاية

    دالة اطبع_تقرير()
        اطبع_سطر("  ═══════ تقرير السائقات ═══════")
        اطبع("  إجمالي السائقات: ") اطبع_سطر(عدد_السائقات)
        اطبع("  نشطة: ") اطبع_سطر(سائقات_نشطة)
        اطبع("  ذاكرة مستخدمة: ") اطبع(ذاكرة_مستخدمة) اطبع_سطر(" KB")
        اطبع("  أخطاء تحميل: ") اطبع_سطر(أخطاء_تحميل)
        اطبع("  تحميلات ساخنة: ") اطبع_سطر(تحميلات_ساخنة)
        اطبع_سطر("  ═════════════════════════════════")
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════════════")
    اطبع_سطر("  بيضة — نظام تحميل السائقات الديناميكي")
    اطبع_سطر("══════════════════════════════════════════════")

    متغير مدير = جديد مدير_السائقات()

    # إنشاء سائقات
    متغير شاشة = جديد سائق(1, "سائق العرض HD", نوع_شاشة, "2.1")
    متغير صوت = جديد سائق(2, "سائق الصوت", نوع_صوت, "1.5")
    متغير شبكة = جديد سائق(3, "سائق الشبكة", نوع_شبكة, "3.0")
    شبكة.حجم_الذاكرة = 128
    متغير تخزين = جديد سائق(4, "سائق التخزين", نوع_تخزين, "2.0")
    متغير لوحة = جديد سائق(5, "سائق الإدخال", نوع_إدخال, "1.2")
    متغير طابعة = جديد سائق(6, "سائق الطابعة", نوع_طابعة, "1.0")
    متغير يو_اس_بي = جديد سائق(7, "سائق USB", نوع_يو_اس_بي, "3.1")
    يو_اس_بي.حجم_الذاكرة = 96

    # سائق غير موقع
    متغير مشبوه = جديد سائق(8, "سائق مشبوه", نوع_بلوتوث, "0.1")
    مشبوه.موقع = خطأ

    # تحميل السائقات
    اطبع_سطر("")
    اطبع_سطر("[1] تحميل السائقات...")
    مدير.حمل_سائق(شاشة)
    مدير.حمل_سائق(صوت)
    مدير.حمل_سائق(شبكة)
    مدير.حمل_سائق(تخزين)
    مدير.حمل_سائق(لوحة)
    مدير.حمل_سائق(طابعة)
    مدير.حمل_سائق(يو_اس_بي)
    مدير.حمل_سائق(مشبوه)

    # معلومات السائقات
    اطبع_سطر("")
    اطبع_سطر("[2] قائمة السائقات...")
    شاشة.اطبع_معلومات()
    صوت.اطبع_معلومات()
    شبكة.اطبع_معلومات()
    تخزين.اطبع_معلومات()
    يو_اس_بي.اطبع_معلومات()
    مشبوه.اطبع_معلومات()

    # تحميل ساخن
    اطبع_سطر("")
    اطبع_سطر("[3] تحميل ساخن...")
    متغير شبكة_جديد = جديد سائق(3, "سائق الشبكة", نوع_شبكة, "3.1")
    شبكة_جديد.حجم_الذاكرة = 140
    مدير.تحميل_ساخن(شبكة, شبكة_جديد)

    # إيقاف سائق
    اطبع_سطر("")
    اطبع_سطر("[4] إيقاف سائق...")
    مدير.أوقف_سائق(طابعة)

    # تقرير نهائي
    اطبع_سطر("")
    مدير.اطبع_تقرير()

    اطبع_سطر("")
    اطبع_سطر("  جميع اختبارات نظام السائقات نجحت!")
    ارجع 0
نهاية
