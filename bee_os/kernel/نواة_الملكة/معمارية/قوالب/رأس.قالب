; ─────────────────────────────────────────────────────────────────────────────
; ثوابت عامة
; ─────────────────────────────────────────────────────────────────────────────

; أحجام الصفحات
%define حجم_الصفحة         0x1000        ; 4 كيلوبايت
%define حجم_الصفحة_الكبيرة 0x200000      ; 2 ميغابايت
%define حجم_الصفحة_العملاقة 0x40000000   ; 1 غيغابايت

; قيم منطقية
%define صحيح  1
%define خطأ   0

; أساس العنوان الافتراضي للنواة
%define KERNEL_VMA     0xFFFFFFFF80000000
%define KERNEL_LMA     0x100000

; ─────────────────────────────────────────────────────────────────────────────
; ثوابت المنافذ
; ─────────────────────────────────────────────────────────────────────────────
%define PORT_COM1      0x3F8
%define PORT_COM2      0x2F8
%define PORT_VGA       0x3D4
%define PORT_PIC1_CMD  0x20
%define PORT_PIC1_DATA 0x21
%define PORT_PIC2_CMD  0xA0
%define PORT_PIC2_DATA 0xA1
%define PORT_PS2_DATA  0x60
%define PORT_PS2_CMD   0x64
%define PORT_PIT_CH0   0x40
%define PORT_PIT_CMD   0x43

; ─────────────────────────────────────────────────────────────────────────────
; ماكروات مفيدة
; ─────────────────────────────────────────────────────────────────────────────

; حفظ واستعادة كل السجلات
%macro احفظ_الكل 0
    push rax
    push rbx
    push rcx
    push rdx
    push rsi
    push rdi
    push rbp
    push r8
    push r9
    push r10
    push r11
    push r12
    push r13
    push r14
    push r15
%endmacro

%macro استعد_الكل 0
    pop r15
    pop r14
    pop r13
    pop r12
    pop r11
    pop r10
    pop r9
    pop r8
    pop rbp
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rbx
    pop rax
%endmacro

; كتابة إلى منفذ
%macro اكتب_منفذ 2
    mov dx, %1
    mov al, %2
    out dx, al
%endmacro

; قراءة من منفذ
%macro اقرأ_منفذ 1
    mov dx, %1
    in al, dx
%endmacro

; طباعة حرف على المنفذ التسلسلي
%macro اطبع_حرف 1
    mov dx, PORT_COM1
    mov al, %1
    out dx, al
%endmacro

