# ══════════════════════════════════════════════════════════════════════════════
# مدير_الماوس.ص - نظام إدارة الماوس لنظام خلية النحل
# BeeOS Mouse Manager - PS/2 Mouse Driver + Event System
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# ثوابت أزرار الماوس
# ─────────────────────────────────────────────────────────────────────
متغير زر_أيسر    = 1
متغير زر_أيمن    = 2
متغير زر_أوسط    = 4

# ─────────────────────────────────────────────────────────────────────
# أنواع أحداث الماوس
# ─────────────────────────────────────────────────────────────────────
متغير حدث_تحريك     = 1
متغير حدث_ضغط       = 2
متغير حدث_إفلات     = 3
متغير حدث_نقر       = 4
متغير حدث_نقر_مزدوج = 5
متغير حدث_عجلة      = 6
متغير حدث_سحب       = 7

# ─────────────────────────────────────────────────────────────────────
# صنف حدث الماوس
# ─────────────────────────────────────────────────────────────────────
صنف حدث_ماوس
    رقم نوع_حدث
    رقم x_الموضع
    رقم y_الموضع
    رقم x_فرق
    رقم y_فرق
    رقم زر_الحدث
    رقم عجلة_فرق
    رقم وقت_الحدث

    باني(ح_نوع، ح_x، ح_y، ح_dx، ح_dy، ح_زر، ح_عجلة)
        هذا.نوع_حدث = ح_نوع
        هذا.x_الموضع = ح_x
        هذا.y_الموضع = ح_y
        هذا.x_فرق = ح_dx
        هذا.y_فرق = ح_dy
        هذا.زر_الحدث = ح_زر
        هذا.عجلة_فرق = ح_عجلة
        هذا.وقت_الحدث = 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────
# صنف مدير الماوس
# ─────────────────────────────────────────────────────────────────────
صنف مدير_الماوس
    رقم x_الحالي
    رقم y_الحالي
    رقم x_سابق
    رقم y_سابق
    رقم عرض_شاشة
    رقم ارتفاع_شاشة
    رقم أزرار_حالية
    رقم أزرار_سابقة
    رقم سرعة_الماوس
    رقم عدد_الأحداث
    رقم وقت_آخر_نقرة
    رقم x_آخر_نقرة
    رقم y_آخر_نقرة
    منطقي يسحب
    رقم x_بداية_السحب
    رقم y_بداية_السحب
    منطقي مرئي
    منطقي مفعل

    باني(م_عرض، م_ارتفاع)
        هذا.عرض_شاشة = م_عرض
        هذا.ارتفاع_شاشة = م_ارتفاع
        هذا.x_الحالي = م_عرض / 2
        هذا.y_الحالي = م_ارتفاع / 2
        هذا.x_سابق = هذا.x_الحالي
        هذا.y_سابق = هذا.y_الحالي
        هذا.أزرار_حالية = 0
        هذا.أزرار_سابقة = 0
        هذا.سرعة_الماوس = 2
        هذا.عدد_الأحداث = 0
        هذا.وقت_آخر_نقرة = 0
        هذا.x_آخر_نقرة = 0
        هذا.y_آخر_نقرة = 0
        هذا.يسحب = خطأ
        هذا.x_بداية_السحب = 0
        هذا.y_بداية_السحب = 0
        هذا.مرئي = صحيح
        هذا.مفعل = صحيح

        اطبع("  [ماوس] تم التهيئة عند (")
        اطبع(هذا.x_الحالي)
        اطبع(",")
        اطبع(هذا.y_الحالي)
        اطبع(") شاشة ")
        اطبع(م_عرض)
        اطبع("x")
        اطبع_سطر(م_ارتفاع)
    نهاية

    # ════════════════════════════════════════════════════════════════
    # معالجة حزمة PS/2 الخام
    # ════════════════════════════════════════════════════════════════

    دالة معالجة_حزمة(بايت1، بايت2، بايت3)
        اذا (هذا.مفعل == خطأ)
            ارجع 0
        نهاية

        # حفظ الحالة السابقة
        هذا.x_سابق = هذا.x_الحالي
        هذا.y_سابق = هذا.y_الحالي
        هذا.أزرار_سابقة = هذا.أزرار_حالية

        # استخراج الأزرار من البايت الأول
        هذا.أزرار_حالية = بايت1 % 8

        # استخراج الحركة (بايت2 = dx، بايت3 = dy)
        متغير dx = بايت2
        متغير dy = بايت3

        # معالجة الإشارة السالبة (PS/2 signed)
        اذا (dx > 127)
            dx = dx - 256
        نهاية
        اذا (dy > 127)
            dy = dy - 256
        نهاية

        # تطبيق السرعة
        dx = dx * هذا.سرعة_الماوس
        dy = dy * هذا.سرعة_الماوس

        # تحديث الموضع مع حدود الشاشة
        هذا.x_الحالي = هذا.x_الحالي + dx
        هذا.y_الحالي = هذا.y_الحالي - dy

        # ضبط الحدود
        اذا (هذا.x_الحالي < 0)
            هذا.x_الحالي = 0
        نهاية
        اذا (هذا.x_الحالي >= هذا.عرض_شاشة)
            هذا.x_الحالي = هذا.عرض_شاشة - 1
        نهاية
        اذا (هذا.y_الحالي < 0)
            هذا.y_الحالي = 0
        نهاية
        اذا (هذا.y_الحالي >= هذا.ارتفاع_شاشة)
            هذا.y_الحالي = هذا.ارتفاع_شاشة - 1
        نهاية

        هذا.عدد_الأحداث = هذا.عدد_الأحداث + 1

        # كشف الأحداث
        اذا (dx != 0 || dy != 0)
            # تحريك
            اذا (هذا.يسحب)
                ارجع حدث_سحب
            نهاية
            ارجع حدث_تحريك
        نهاية

        # كشف ضغط/إفلات
        اذا (هذا.أزرار_حالية != هذا.أزرار_سابقة)
            اذا (هذا.أزرار_حالية > هذا.أزرار_سابقة)
                # زر ضُغط
                هذا.يسحب = صحيح
                هذا.x_بداية_السحب = هذا.x_الحالي
                هذا.y_بداية_السحب = هذا.y_الحالي
                ارجع حدث_ضغط
            والا
                # زر أُفلت
                هذا.يسحب = خطأ
                ارجع حدث_إفلات
            نهاية
        نهاية

        ارجع 0
    نهاية

    # ════════════════════════════════════════════════════════════════
    # استعلامات الحالة
    # ════════════════════════════════════════════════════════════════

    دالة الموضع_x()
        ارجع هذا.x_الحالي
    نهاية

    دالة الموضع_y()
        ارجع هذا.y_الحالي
    نهاية

    دالة زر_أيسر_مضغوط()
        ارجع (هذا.أزرار_حالية % 2) == 1
    نهاية

    دالة زر_أيمن_مضغوط()
        ارجع (هذا.أزرار_حالية / 2) % 2 == 1
    نهاية

    دالة هل_يسحب()
        ارجع هذا.يسحب
    نهاية

    دالة نقطة_في_مستطيل(ت_x، ت_y، م_x، م_y، م_ع، م_ا)
        ارجع ت_x >= م_x && ت_x < م_x + م_ع && ت_y >= م_y && ت_y < م_y + م_ا
    نهاية

    # ════════════════════════════════════════════════════════════════
    # رسم المؤشر
    # ════════════════════════════════════════════════════════════════

    دالة رسم_مؤشر(مقبض_fb)
        اذا (هذا.مرئي == خطأ)
            ارجع 0
        نهاية

        متغير cx = هذا.x_الحالي
        متغير cy = هذا.y_الحالي
        متغير بكسلات = 0

        # مؤشر السهم (16x16 تقريباً)
        # رسم جسم السهم (مثلث أبيض)
        متغير صف = 0
        بينما (صف < 16)
            متغير عمود = 0
            بينما (عمود <= صف / 2)
                بكسلات = بكسلات + اكتب_بكسل(مقبض_fb، cx + عمود، cy + صف، -1)
                عمود = عمود + 1
            نهاية

            # حدود سوداء
            بكسلات = بكسلات + اكتب_بكسل(مقبض_fb، cx + صف / 2 + 1، cy + صف، -16777216)
            صف = صف + 1
        نهاية

        # حد أيسر أسود
        صف = 0
        بينما (صف < 16)
            بكسلات = بكسلات + اكتب_بكسل(مقبض_fb، cx، cy + صف، -16777216)
            صف = صف + 1
        نهاية

        ارجع بكسلات
    نهاية

    # ════════════════════════════════════════════════════════════════
    # محاكاة حركة الماوس (للاختبار)
    # ════════════════════════════════════════════════════════════════

    دالة محاكاة_تحريك(م_dx، م_dy)
        # بايت1=0 (لا أزرار)، بايت2=dx، بايت3=dy
        متغير b2 = م_dx
        متغير b3 = م_dy
        اذا (م_dx < 0)
            b2 = 256 + م_dx
        نهاية
        اذا (م_dy < 0)
            b3 = 256 + م_dy
        نهاية
        ارجع معالجة_حزمة(0، b2، b3)
    نهاية

    دالة محاكاة_نقر_أيسر()
        معالجة_حزمة(1، 0، 0)
        ارجع معالجة_حزمة(0، 0، 0)
    نهاية

    دالة محاكاة_نقر_أيمن()
        معالجة_حزمة(2، 0، 0)
        ارجع معالجة_حزمة(0، 0، 0)
    نهاية

    # ════════════════════════════════════════════════════════════════
    # إحصاءات
    # ════════════════════════════════════════════════════════════════

    دالة إحصاءات_ماوس()
        اطبع_سطر("  --- إحصاءات الماوس ---")
        اطبع("  الموضع: (")
        اطبع(هذا.x_الحالي)
        اطبع(",")
        اطبع(هذا.y_الحالي)
        اطبع_سطر(")")
        اطبع("  أزرار: ")
        اطبع_سطر(هذا.أزرار_حالية)
        اطبع("  سرعة: x")
        اطبع_سطر(هذا.سرعة_الماوس)
        اطبع("  أحداث: ")
        اطبع_سطر(هذا.عدد_الأحداث)
        اطبع("  يسحب: ")
        اطبع_سطر(هذا.يسحب)
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────
# اختبار
# ─────────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== اختبار مدير الماوس ===")
    اطبع_سطر("")

    متغير ماوس = جديد مدير_الماوس(1920، 1080)
    اطبع_سطر("")

    # محاكاة حركة الماوس
    اطبع_سطر("-- محاكاة حركات --")
    ماوس.محاكاة_تحريك(50، 30)
    اطبع("  بعد تحريك(50,30): (")
    اطبع(ماوس.الموضع_x())
    اطبع(",")
    اطبع(ماوس.الموضع_y())
    اطبع_سطر(")")

    ماوس.محاكاة_تحريك(-20، 10)
    اطبع("  بعد تحريك(-20,10): (")
    اطبع(ماوس.الموضع_x())
    اطبع(",")
    اطبع(ماوس.الموضع_y())
    اطبع_سطر(")")

    # محاكاة نقر
    اطبع_سطر("")
    اطبع_سطر("-- محاكاة نقر --")
    ماوس.محاكاة_نقر_أيسر()
    اطبع("  نقر أيسر، أزرار: ")
    اطبع_سطر(ماوس.زر_أيسر_مضغوط())

    # اختبار حدود الشاشة
    اطبع_سطر("")
    اطبع_سطر("-- اختبار حدود الشاشة --")
    ماوس.محاكاة_تحريك(100، 100)
    ماوس.محاكاة_تحريك(100، 100)
    ماوس.محاكاة_تحريك(100، 100)
    اطبع("  موضع بعد حركة كبيرة: (")
    اطبع(ماوس.الموضع_x())
    اطبع(",")
    اطبع(ماوس.الموضع_y())
    اطبع_سطر(")")

    # اختبار نقطة في مستطيل
    اطبع_سطر("")
    اطبع_سطر("-- اختبار نقطة_في_مستطيل --")
    متغير نتيجة_فحص = ماوس.نقطة_في_مستطيل(500، 400، 100، 100، 800، 600)
    اطبع("  (500,400) في مستطيل (100,100,800,600): ")
    اطبع_سطر(نتيجة_فحص)

    # رسم المؤشر على FB
    اطبع_سطر("")
    اطبع_سطر("-- رسم المؤشر --")
    متغير fb = أنشئ_مخزن_رسوم(200، 200)
    املأ_مخزن(fb، -16776961)
    ماوس.x_الحالي = 50
    ماوس.y_الحالي = 50
    متغير بكسل_مؤشر = ماوس.رسم_مؤشر(fb)
    اطبع("  بكسلات المؤشر: ")
    اطبع_سطر(بكسل_مؤشر)

    # إحصاءات
    اطبع_سطر("")
    ماوس.إحصاءات_ماوس()

    اطبع_سطر("")
    اطبع_سطر("=== مدير الماوس يعمل بنجاح! ===")
    ارجع 0
نهاية
