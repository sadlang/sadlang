# ══════════════════════════════════════════════════════════════════════════════
# تقوية_برامج_التعريف.ص - برامج تعريف الأجهزة المُقوّاة لنظام خلية النحل
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# هذا الملف يُقوّي منظومة برامج التعريف بإضافة مكونات كانت مفقودة:
#
# 1. مُعرّف القرص (Disk Driver / AHCI-SATA)
#    - الكشف عن أقراص SATA المتصلة
#    - قراءة وكتابة القطاعات (LBA addressing)
#    - ذاكرة مؤقتة للقطاعات (sector cache)
#    - جدول الأقسام (partition table)
#    - DMA وهمي لنقل البيانات
#
# 2. مُعرّف DMA (Direct Memory Access)
#    - 8 قنوات DMA (4 رئيسية + 4 ثانوية)
#    - حجز وتحرير القنوات
#    - نقل البيانات بين الأجهزة والذاكرة
#    - أقنعة ووضعيات النقل
#
# 3. مُعرّف RTC/CMOS المُحسّن
#    - قراءة التاريخ والوقت الحالي (BCD/Binary)
#    - إنذارات مبرمجة (alarms)
#    - تحديث دوري (periodic interrupt)
#    - حفظ إعدادات CMOS
#
# 4. مُعرّف الشاشة المتقدم (Framebuffer)
#    - دعم أوضاع عرض متعددة (text + graphics)
#    - رسم المستطيلات والخطوط
#    - مسح الشاشة
#    - تمرير (scrolling)
#
# 5. مدير الأجهزة الموحّد (Device Manager)
#    - تسجيل الأجهزة ديناميكياً
#    - شجرة الأجهزة
#    - استعلام الأجهزة بالنمط أو بالاسم
#
# المعمارية:
# ━━━━━━━━━━
#  مدير_الأجهزة_الموحّد
#    ├── مُعرّف_القرص_AHCI
#    │     ├── ذاكرة_القطاعات (sector cache)
#    │     └── جدول_الأقسام
#    ├── متحكم_DMA
#    │     └── قنوات DMA[8]
#    ├── ساعة_RTC_م
#    │     └── إنذارات + CMOS
#    └── شاشة_عرض_م
#          ├── وضع_نصي 80×25
#          └── وضع_رسومي 1024×768
#
# الكلمات المحجوزة المتجنَّبة:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━
# حجم → مقاس | نهاية → عنوان_آخر | خريطة → جدول
# نوع → نمط | حالة → وضعية | صنف_ → فئة_
# ارجع (مجرّد) → ارجع 0
#
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت الأجهزة
# ─────────────────────────────────────────────────────────────────────────────

# ثوابت القرص (AHCI/SATA)
ثابت مقاس_القطاع = 512          # 512 بايت لكل قطاع
ثابت أقصى_أقراص = 8              # 8 منافذ SATA كحد أقصى
ثابت سعة_كاش_قطاعات = 64        # 64 قطاع في الذاكرة المؤقتة
ثابت AHCI_قاعدة = 4261609472    # 0xFE000000 - عنوان AHCI MMIO الوهمي

# أنماط الأجهزة
ثابت نمط_جهاز_قرص = 1
ثابت نمط_جهاز_شاشة = 2
ثابت نمط_جهاز_لوحة_مفاتيح = 3
ثابت نمط_جهاز_شبكة = 4
ثابت نمط_جهاز_صوت = 5
ثابت نمط_جهاز_DMA = 6
ثابت نمط_جهاز_ساعة = 7

# ثوابت DMA
ثابت DMA_عدد_القنوات = 8
ثابت DMA_وضع_قراءة = 1          # من الجهاز إلى الذاكرة
ثابت DMA_وضع_كتابة = 2          # من الذاكرة إلى الجهاز
ثابت DMA_وضع_تلقائي = 3         # auto-initialize

# ثوابت RTC
ثابت RTC_منفذ_عنوان = 112       # 0x70
ثابت RTC_منفذ_بيانات = 113      # 0x71
ثابت RTC_سجل_ثوان = 0
ثابت RTC_سجل_دقائق = 2
ثابت RTC_سجل_ساعات = 4
ثابت RTC_سجل_يوم = 7
ثابت RTC_سجل_شهر = 8
ثابت RTC_سجل_سنة = 9
ثابت RTC_سجل_حالة_أ = 10        # Status Register A
ثابت RTC_سجل_حالة_ب = 11        # Status Register B

# ثوابت الشاشة
ثابت VGA_عرض_نص = 80
ثابت VGA_ارتفاع_نص = 25
ثابت VGA_عنوان_ذاكرة = 753664   # 0xB8000
ثابت لون_أبيض = 15
ثابت لون_أسود = 0
ثابت لون_أخضر = 2
ثابت لون_أحمر = 4
ثابت لون_أزرق = 1
ثابت لون_أصفر = 14

# ─────────────────────────────────────────────────────────────────────────────
# صنف قطاع_مُخبّأ - قطاع في الذاكرة المؤقتة
# ─────────────────────────────────────────────────────────────────────────────
صنف قطاع_مُخبّأ
    ## قطاع قرص مُخزّن في ذاكرة التخبئة (cache)

    رقم رقم_القطاع_LBA         # عنوان LBA
    مصفوفة البيانات            # بيانات القطاع (512 بايت)
    منطقي متسخ                 # هل تغيّرت البيانات؟
    رقم آخر_وصول               # وقت آخر وصول (للـ LRU)
    رقم رقم_القرص              # أي قرص

    باني(رقم القطاع_ل، رقم القرص_ل)
        رقم_القطاع_LBA = القطاع_ل
        البيانات = []
        متسخ = خطأ
        آخر_وصول = 0
        رقم_القرص = القرص_ل

        # ملء بأصفار (محاكاة 512 بايت)
        متغير ف = 0
        بينما (ف < 16)
            البيانات += [0]
            ف = ف + 1
        نهاية
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف قسم_قرص - قسم واحد في جدول الأقسام
# ─────────────────────────────────────────────────────────────────────────────
صنف قسم_قرص
    ## قسم واحد في جدول أقسام MBR/GPT

    رقم رقم_القسم              # ترتيب القسم (0-3 لـ MBR)
    رقم قطاع_البداية           # LBA البداية
    رقم عدد_القطاعات           # عدد القطاعات
    رقم معرّف_النظام           # نوع نظام الملفات (0x83=Linux، 0x07=NTFS، etc)
    منطقي نشط                  # هل هو القسم النشط (bootable)؟
    نص تسمية                   # اسم القسم

    باني(رقم رقم_ل، رقم بداية_ل، رقم عدد_ل، رقم معرّف_ل)
        رقم_القسم = رقم_ل
        قطاع_البداية = بداية_ل
        عدد_القطاعات = عدد_ل
        معرّف_النظام = معرّف_ل
        نشط = خطأ
        تسمية = "بدون_تسمية"
    نهاية

    ## حجم القسم بالبايت
    دالة رقم المقاس_بالبايت()
        ارجع عدد_القطاعات * مقاس_القطاع
    نهاية

    ## حجم القسم بالميغابايت
    دالة رقم المقاس_بالميغا()
        ارجع (عدد_القطاعات * مقاس_القطاع) / 1048576
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مُعرّف_القرص - AHCI/SATA Disk Driver
# ─────────────────────────────────────────────────────────────────────────────
صنف مُعرّف_القرص
    ## مُعرّف قرص AHCI/SATA
    ## يدير: اكتشاف الأقراص، قراءة/كتابة القطاعات، التخبئة، الأقسام

    مصفوفة الأقراص_المتصلة     # أسماء الأقراص المتصلة
    مصفوفة أحجام_الأقراص       # أحجام الأقراص بالقطاعات
    مصفوفة الكاش               # ذاكرة القطاعات المؤقتة
    مصفوفة الأقسام             # أقسام القرص
    رقم الساعة                 # ساعة وهمية
    رقم عمليات_قراءة           # عدّاد القراءة
    رقم عمليات_كتابة           # عدّاد الكتابة
    رقم إصابات_الكاش           # عدد إصابات الكاش (cache hits)
    رقم أخطاء_الكاش            # عدد أخطاء الكاش (cache misses)

    باني()
        الأقراص_المتصلة = []
        أحجام_الأقراص = []
        الكاش = []
        الأقسام = []
        الساعة = 0
        عمليات_قراءة = 0
        عمليات_كتابة = 0
        إصابات_الكاش = 0
        أخطاء_الكاش = 0
    نهاية

    ## اكتشاف الأقراص المتصلة (محاكاة AHCI port scanning)
    دالة اكشف_الأقراص()
        اطبع_سطر("  💿 مسح منافذ AHCI...")

        # محاكاة: قرص SATA رئيسي
        الأقراص_المتصلة += ["sda"]
        أحجام_الأقراص += [2097152]    # 1GB (2M قطاع × 512)

        # محاكاة: قرص SATA ثانوي
        الأقراص_المتصلة += ["sdb"]
        أحجام_الأقراص += [8388608]    # 4GB

        اطبع("    → عدد الأقراص: ") اطبع_سطر(طول(الأقراص_المتصلة))
        متغير ف = 0
        بينما (ف < طول(الأقراص_المتصلة))
            اطبع("    ") اطبع(الأقراص_المتصلة[ف])
            اطبع(": ") اطبع(أحجام_الأقراص[ف] * مقاس_القطاع / 1048576)
            اطبع_سطر(" MB")
            ف = ف + 1
        نهاية
    نهاية

    ## قراءة أقسام القرص (محاكاة MBR)
    دالة اقرأ_جدول_الأقسام(رقم رقم_القرص_ل)
        اطبع("  📂 قراءة جدول أقسام القرص ") اطبع_سطر(رقم_القرص_ل)

        # محاكاة 3 أقسام
        متغير ق1 = جديد قسم_قرص(0، 2048، 1048576، 131)   # Linux (0x83)
        ق1.نشط = صحيح
        ق1.تسمية = "النظام"
        الأقسام += [ق1]

        متغير ق2 = جديد قسم_قرص(1، 1050624، 524288، 130)  # Linux swap (0x82)
        ق2.تسمية = "التبديل"
        الأقسام += [ق2]

        متغير ق3 = جديد قسم_قرص(2، 1574912، 522240، 131)  # Linux data
        ق3.تسمية = "البيانات"
        الأقسام += [ق3]
    نهاية

    ## البحث في الكاش
    دالة رقم ابحث_في_الكاش(رقم القطاع_ل، رقم القرص_ل)
        متغير ف = 0
        بينما (ف < طول(الكاش))
            اذا (الكاش[ف].رقم_القطاع_LBA == القطاع_ل && الكاش[ف].رقم_القرص == القرص_ل)
                الكاش[ف].آخر_وصول = الساعة
                إصابات_الكاش = إصابات_الكاش + 1
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        أخطاء_الكاش = أخطاء_الكاش + 1
        ارجع -1
    نهاية

    ## إخلاء أقدم عنصر في الكاش (LRU)
    دالة رقم اخلِ_LRU()
        اذا (طول(الكاش) < سعة_كاش_قطاعات)
            ارجع -1
        نهاية

        متغير أقدم = 0
        متغير أقدم_وقت = الكاش[0].آخر_وصول
        متغير ف = 1
        بينما (ف < طول(الكاش))
            اذا (الكاش[ف].آخر_وصول < أقدم_وقت)
                أقدم = ف
                أقدم_وقت = الكاش[ف].آخر_وصول
            نهاية
            ف = ف + 1
        نهاية

        # مسح القطاع المتسخ قبل الإخلاء
        اذا (الكاش[أقدم].متسخ)
            عمليات_كتابة = عمليات_كتابة + 1
        نهاية

        ارجع أقدم
    نهاية

    ## قراءة قطاع (مع تخبئة)
    دالة مصفوفة اقرأ_قطاع(رقم القطاع_ل، رقم القرص_ل)
        الساعة = الساعة + 1

        # فحص الكاش أولاً
        متغير فهرس = ابحث_في_الكاش(القطاع_ل، القرص_ل)
        اذا (فهرس >= 0)
            ارجع الكاش[فهرس].البيانات
        نهاية

        # قراءة من القرص (محاكاة)
        عمليات_قراءة = عمليات_قراءة + 1
        متغير قطاع_جديد = جديد قطاع_مُخبّأ(القطاع_ل، القرص_ل)
        قطاع_جديد.آخر_وصول = الساعة

        # محاكاة بيانات
        قطاع_جديد.البيانات[0] = القطاع_ل % 256
        قطاع_جديد.البيانات[1] = القرص_ل

        # إضافة للكاش
        اذا (طول(الكاش) >= سعة_كاش_قطاعات)
            متغير موقع_إخلاء = اخلِ_LRU()
            اذا (موقع_إخلاء >= 0)
                الكاش[موقع_إخلاء] = قطاع_جديد
            نهاية
        والا
            الكاش += [قطاع_جديد]
        نهاية

        ارجع قطاع_جديد.البيانات
    نهاية

    ## كتابة قطاع
    دالة اكتب_قطاع(رقم القطاع_ل، رقم القرص_ل، مصفوفة البيانات_ل)
        الساعة = الساعة + 1

        # فحص الكاش
        متغير فهرس = ابحث_في_الكاش(القطاع_ل، القرص_ل)
        اذا (فهرس >= 0)
            الكاش[فهرس].البيانات = البيانات_ل
            الكاش[فهرس].متسخ = صحيح
            الكاش[فهرس].آخر_وصول = الساعة
        والا
            # إنشاء مدخلة كاش جديدة
            متغير قطاع_جديد = جديد قطاع_مُخبّأ(القطاع_ل، القرص_ل)
            قطاع_جديد.البيانات = البيانات_ل
            قطاع_جديد.متسخ = صحيح
            قطاع_جديد.آخر_وصول = الساعة

            اذا (طول(الكاش) >= سعة_كاش_قطاعات)
                متغير موقع = اخلِ_LRU()
                اذا (موقع >= 0) الكاش[موقع] = قطاع_جديد نهاية
            والا
                الكاش += [قطاع_جديد]
            نهاية
        نهاية
        عمليات_كتابة = عمليات_كتابة + 1
    نهاية

    ## مسح الكاش (كتابة المتسخ)
    دالة رقم امسح_الكاش()
        متغير عدد_ممسوح = 0
        متغير ف = 0
        بينما (ف < طول(الكاش))
            اذا (الكاش[ف].متسخ)
                الكاش[ف].متسخ = خطأ
                عدد_ممسوح = عدد_ممسوح + 1
            نهاية
            ف = ف + 1
        نهاية
        ارجع عدد_ممسوح
    نهاية

    ## إحصائيات
    دالة اطبع_إحصائيات()
        اطبع_سطر("  ── إحصائيات القرص ──")
        اطبع("  قراءة: ") اطبع_سطر(عمليات_قراءة)
        اطبع("  كتابة: ") اطبع_سطر(عمليات_كتابة)
        اطبع("  إصابات كاش: ") اطبع_سطر(إصابات_الكاش)
        اطبع("  أخطاء كاش: ") اطبع_سطر(أخطاء_الكاش)
        اطبع("  عناصر الكاش: ") اطبع_سطر(طول(الكاش))
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف قناة_DMA - قناة واحدة في متحكم DMA
# ─────────────────────────────────────────────────────────────────────────────
صنف قناة_DMA
    ## قناة DMA واحدة من 8 قنوات

    رقم الرقم_م                # رقم القناة (0-7)
    رقم عنوان_الذاكرة          # عنوان الذاكرة المستهدف
    رقم عدد_البايتات           # عدد البايتات للنقل
    رقم وضع_النقل             # قراءة/كتابة/تلقائي
    منطقي محجوزة               # هل القناة محجوزة؟
    منطقي مشغولة               # هل يجري نقل حالياً؟
    نص مالك_القناة             # اسم الجهاز المالك

    باني(رقم الرقم_ل)
        الرقم_م = الرقم_ل
        عنوان_الذاكرة = 0
        عدد_البايتات = 0
        وضع_النقل = 0
        محجوزة = خطأ
        مشغولة = خطأ
        مالك_القناة = ""
    نهاية

    ## حجز القناة
    دالة منطقي احجز(نص المالك_ل)
        اذا (محجوزة) ارجع خطأ نهاية
        محجوزة = صحيح
        مالك_القناة = المالك_ل
        ارجع صحيح
    نهاية

    ## تحرير القناة
    دالة حرّر()
        محجوزة = خطأ
        مشغولة = خطأ
        مالك_القناة = ""
        عنوان_الذاكرة = 0
        عدد_البايتات = 0
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف متحكم_DMA - DMA Controller (8237A simulation)
# ─────────────────────────────────────────────────────────────────────────────
صنف متحكم_DMA
    ## يُحاكي متحكم DMA 8237A مع 8 قنوات
    ## القنوات 0-3: رئيسي (byte transfer)
    ## القنوات 4-7: ثانوي (word transfer، القناة 4 = cascade)

    مصفوفة القنوات             # 8 قنوات DMA
    رقم عمليات_نقل             # عدد عمليات النقل المكتملة
    رقم بايتات_منقولة          # إجمالي البايتات المنقولة

    باني()
        القنوات = []
        عمليات_نقل = 0
        بايتات_منقولة = 0

        # إنشاء 8 قنوات
        متغير ف = 0
        بينما (ف < DMA_عدد_القنوات)
            متغير قناة = جديد قناة_DMA(ف)
            القنوات += [قناة]
            ف = ف + 1
        نهاية

        # القناة 4 محجوزة دائماً (cascade)
        القنوات[4].احجز("cascade")
    نهاية

    ## حجز قناة حرة
    دالة رقم احجز_قناة(نص المالك_ل)
        متغير ف = 0
        بينما (ف < طول(القنوات))
            اذا (!القنوات[ف].محجوزة)
                القنوات[ف].احجز(المالك_ل)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    ## بدء نقل DMA
    دالة منطقي انقل(رقم رقم_القناة، رقم العنوان_ل، رقم العدد_ل، رقم الوضع_ل)
        اذا (رقم_القناة < 0 || رقم_القناة >= DMA_عدد_القنوات)
            ارجع خطأ
        نهاية
        اذا (!القنوات[رقم_القناة].محجوزة)
            ارجع خطأ
        نهاية

        القنوات[رقم_القناة].عنوان_الذاكرة = العنوان_ل
        القنوات[رقم_القناة].عدد_البايتات = العدد_ل
        القنوات[رقم_القناة].وضع_النقل = الوضع_ل
        القنوات[رقم_القناة].مشغولة = صحيح

        # محاكاة اكتمال النقل
        القنوات[رقم_القناة].مشغولة = خطأ
        عمليات_نقل = عمليات_نقل + 1
        بايتات_منقولة = بايتات_منقولة + العدد_ل

        ارجع صحيح
    نهاية

    ## تحرير قناة
    دالة حرّر_قناة(رقم رقم_القناة)
        اذا (رقم_القناة >= 0 && رقم_القناة < DMA_عدد_القنوات)
            اذا (رقم_القناة != 4)  # لا تحرّر القناة 4 (cascade)
                القنوات[رقم_القناة].حرّر()
            نهاية
        نهاية
    نهاية

    ## عدد القنوات الحرة
    دالة رقم قنوات_حرة()
        متغير عدد = 0
        متغير ف = 0
        بينما (ف < طول(القنوات))
            اذا (!القنوات[ف].محجوزة) عدد = عدد + 1 نهاية
            ف = ف + 1
        نهاية
        ارجع عدد
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف ساعة_RTC_م - Real Time Clock Enhanced
# ─────────────────────────────────────────────────────────────────────────────
صنف ساعة_RTC_م
    ## ساعة الوقت الحقيقي (RTC/CMOS) المُحسّنة
    ## تقرأ التاريخ والوقت وتدعم الإنذارات

    رقم الثواني
    رقم الدقائق
    رقم الساعات
    رقم اليوم
    رقم الشهر
    رقم السنة
    منطقي صيغة_24              # صيغة 24 ساعة؟
    منطقي صيغة_ثنائية          # binary أم BCD؟
    مصفوفة الإنذارات_ساعات     # ساعات الإنذارات
    مصفوفة الإنذارات_دقائق     # دقائق الإنذارات
    مصفوفة الإنذارات_نشطة      # هل الإنذار نشط؟
    مصفوفة سجلات_CMOS          # 128 سجل CMOS

    باني()
        الثواني = 0
        الدقائق = 0
        الساعات = 0
        اليوم = 1
        الشهر = 1
        السنة = 2025
        صيغة_24 = صحيح
        صيغة_ثنائية = صحيح
        الإنذارات_ساعات = []
        الإنذارات_دقائق = []
        الإنذارات_نشطة = []
        سجلات_CMOS = []

        # ملء سجلات CMOS بأصفار
        متغير ف = 0
        بينما (ف < 128)
            سجلات_CMOS += [0]
            ف = ف + 1
        نهاية
    نهاية

    ## قراءة الوقت الحالي (محاكاة)
    دالة اقرأ_الوقت()
        # محاكاة قراءة من سجلات CMOS
        الثواني = 30
        الدقائق = 45
        الساعات = 14
        اليوم = 15
        الشهر = 6
        السنة = 2025

        # تخزين في CMOS
        سجلات_CMOS[RTC_سجل_ثوان] = الثواني
        سجلات_CMOS[RTC_سجل_دقائق] = الدقائق
        سجلات_CMOS[RTC_سجل_ساعات] = الساعات
        سجلات_CMOS[RTC_سجل_يوم] = اليوم
        سجلات_CMOS[RTC_سجل_شهر] = الشهر
        سجلات_CMOS[RTC_سجل_سنة] = السنة
    نهاية

    ## تنسيق الوقت كنص
    دالة نص الوقت_نص()
        ارجع الساعات + ":" + الدقائق + ":" + الثواني
    نهاية

    ## تنسيق التاريخ كنص
    دالة نص التاريخ_نص()
        ارجع السنة + "/" + الشهر + "/" + اليوم
    نهاية

    ## إضافة إنذار
    دالة أضف_إنذار(رقم ساعة_ل، رقم دقيقة_ل)
        الإنذارات_ساعات += [ساعة_ل]
        الإنذارات_دقائق += [دقيقة_ل]
        الإنذارات_نشطة += [صحيح]
    نهاية

    ## فحص الإنذارات
    دالة مصفوفة افحص_الإنذارات()
        متغير نتائج = []
        متغير ف = 0
        بينما (ف < طول(الإنذارات_ساعات))
            اذا (الإنذارات_نشطة[ف])
                اذا (الإنذارات_ساعات[ف] == الساعات && الإنذارات_دقائق[ف] == الدقائق)
                    نتائج += [ف]
                    الإنذارات_نشطة[ف] = خطأ
                نهاية
            نهاية
            ف = ف + 1
        نهاية
        ارجع نتائج
    نهاية

    ## كتابة سجل CMOS
    دالة اكتب_CMOS(رقم السجل_ل، رقم القيمة_ل)
        اذا (السجل_ل >= 0 && السجل_ل < 128)
            سجلات_CMOS[السجل_ل] = القيمة_ل
        نهاية
    نهاية

    ## قراءة سجل CMOS
    دالة رقم اقرأ_CMOS(رقم السجل_ل)
        اذا (السجل_ل >= 0 && السجل_ل < 128)
            ارجع سجلات_CMOS[السجل_ل]
        نهاية
        ارجع 0
    نهاية
نهاية

