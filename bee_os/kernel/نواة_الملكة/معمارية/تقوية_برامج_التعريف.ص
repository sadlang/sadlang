            اذا (الأجهزة[ف].النمط_م == النمط_ل)
                عدد = عدد + 1
            نهاية
            ف = ف + 1
        نهاية
        ارجع عدد
    نهاية

    ## البحث عن جهاز بالاسم
    دالة رقم ابحث(نص الاسم_ل)
        متغير ف = 0
        بينما (ف < طول(الأجهزة))
            اذا (الأجهزة[ف].الاسم == الاسم_ل)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    ## طباعة شجرة الأجهزة
    دالة اطبع_الشجرة()
        اطبع_سطر("🌳 شجرة الأجهزة:")
        متغير ف = 0
        بينما (ف < طول(الأجهزة))
            اطبع("  ├── [") اطبع(الأجهزة[ف].النمط_م) اطبع("] ")
            اطبع(الأجهزة[ف].الاسم) اطبع(" — ")
            اطبع(الأجهزة[ف].الوصف)
            اذا (الأجهزة[ف].مُهيّأ) اطبع(" ✓") والا اطبع(" ✗") نهاية
            اطبع_سطر("")
            ف = ف + 1
        نهاية
    نهاية
نهاية

