# ─────────────────────────────────────────────────────────────────────────────
# صنف شاشة_عرض_م - VGA/Framebuffer Driver
# ─────────────────────────────────────────────────────────────────────────────
صنف شاشة_عرض_م
    ## مُعرّف شاشة VGA مع وضع نصي ورسومي

    رقم العرض_م                # عرض الشاشة (حروف أو بكسل)
    رقم الارتفاع_م             # ارتفاع الشاشة
    رقم مؤشر_عمود              # عمود المؤشر الحالي
    رقم مؤشر_سطر               # سطر المؤشر الحالي
    رقم لون_أمامي_حالي         # اللون الأمامي الحالي
    رقم لون_خلفي_حالي          # اللون الخلفي الحالي
    مصفوفة ذاكرة_الفيديو      # محتوى الشاشة
    رقم عدد_الأحرف_مكتوبة     # عدّاد

    باني()
        العرض_م = VGA_عرض_نص
        الارتفاع_م = VGA_ارتفاع_نص
        مؤشر_عمود = 0
        مؤشر_سطر = 0
        لون_أمامي_حالي = لون_أبيض
        لون_خلفي_حالي = لون_أسود
        ذاكرة_الفيديو = []
        عدد_الأحرف_مكتوبة = 0

        # ملء ذاكرة الفيديو (80×25 = 2000 خلية)
        متغير ف = 0
        بينما (ف < العرض_م * الارتفاع_م)
            ذاكرة_الفيديو += [32]    # مسافة
            ف = ف + 1
        نهاية
    نهاية

    ## مسح الشاشة
    دالة امسح()
        متغير ف = 0
        بينما (ف < طول(ذاكرة_الفيديو))
            ذاكرة_الفيديو[ف] = 32    # مسافة
            ف = ف + 1
        نهاية
        مؤشر_عمود = 0
        مؤشر_سطر = 0
    نهاية

    ## كتابة حرف في الموقع الحالي
    دالة اكتب_حرف(رقم الحرف_ل)
        اذا (مؤشر_سطر >= الارتفاع_م)
            # تمرير لأعلى
            مرّر()
        نهاية

        متغير فهرس = مؤشر_سطر * العرض_م + مؤشر_عمود
        اذا (فهرس >= 0 && فهرس < طول(ذاكرة_الفيديو))
            ذاكرة_الفيديو[فهرس] = الحرف_ل
        نهاية

        مؤشر_عمود = مؤشر_عمود + 1
        اذا (مؤشر_عمود >= العرض_م)
            مؤشر_عمود = 0
            مؤشر_سطر = مؤشر_سطر + 1
        نهاية
        عدد_الأحرف_مكتوبة = عدد_الأحرف_مكتوبة + 1
    نهاية

    ## تمرير الشاشة سطراً واحداً لأعلى
    دالة مرّر()
        # نقل كل سطر لأعلى بسطر واحد
        متغير ف = 0
        بينما (ف < (الارتفاع_م - 1) * العرض_م)
            ذاكرة_الفيديو[ف] = ذاكرة_الفيديو[ف + العرض_م]
            ف = ف + 1
        نهاية
        # مسح السطر الأخير
        بينما (ف < الارتفاع_م * العرض_م)
            ذاكرة_الفيديو[ف] = 32
            ف = ف + 1
        نهاية
        مؤشر_سطر = الارتفاع_م - 1
    نهاية

    ## تحريك المؤشر
    دالة حرّك_المؤشر(رقم عمود_ل، رقم سطر_ل)
        اذا (عمود_ل >= 0 && عمود_ل < العرض_م)
            مؤشر_عمود = عمود_ل
        نهاية
        اذا (سطر_ل >= 0 && سطر_ل < الارتفاع_م)
            مؤشر_سطر = سطر_ل
        نهاية
    نهاية

    ## تغيير اللون
    دالة غيّر_اللون(رقم أمام_ل، رقم خلف_ل)
        لون_أمامي_حالي = أمام_ل
        لون_خلفي_حالي = خلف_ل
    نهاية
نهاية

