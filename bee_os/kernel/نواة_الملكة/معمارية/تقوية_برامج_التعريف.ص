    متغير نتيجة_نقل = dma.انقل(رقم_قناة، 1048576، 4096، DMA_وضع_قراءة)
    اذا (نتيجة_نقل && dma.عمليات_نقل == 1 && dma.بايتات_منقولة == 4096)
        اطبع_سطر("  ✓ نقل DMA")
