صنف مدير_الأجهزة_الموحّد
    ## يدير جميع الأجهزة المسجّلة في النظام
    ## يسمح بتسجيل واستعلام وتعداد الأجهزة

    مصفوفة الأجهزة             # قائمة الأجهزة المسجّلة
    رقم آخر_معرّف              # آخر معرّف مُعطى

    باني()
        الأجهزة = []
        آخر_معرّف = 0
    نهاية

    ## تسجيل جهاز جديد
    دالة رقم سجّل(نص الاسم_ل، رقم النمط_ل، نص الوصف_ل)
        متغير جهاز = جديد سجل_جهاز(الاسم_ل، النمط_ل، الوصف_ل)
        جهاز.مُهيّأ = صحيح
        الأجهزة += [جهاز]
        آخر_معرّف = آخر_معرّف + 1
        ارجع آخر_معرّف
    نهاية

    ## عدد الأجهزة بنمط معين
    دالة رقم عدد_بالنمط(رقم النمط_ل)
        متغير عدد = 0
        متغير ف = 0
