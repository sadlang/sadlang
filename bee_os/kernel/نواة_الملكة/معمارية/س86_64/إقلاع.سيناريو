/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 1: ثوابت الإقلاع
 * ─────────────────────────────────────────────────────────────────────────────
 */

/* أوضاع المعالج */
REAL_MODE_BASE     = 0x7C00;      /* عنوان قطاع الإقلاع */
PROTECTED_MODE_GDT = 0x0800;      /* عنوان GDT المؤقت */
LONG_MODE_STACK    = 0x70000;     /* مكدس مؤقت للوضع الطويل */
PAGE_TABLE_BASE    = 0x1000;      /* جداول الصفحات الأولية */

/* عناوين هياكل الإقلاع */
BOOT_INFO_ADDR     = 0x80000;    /* معلومات الإقلاع */
MEMORY_MAP_ADDR    = 0x90000;    /* خريطة الذاكرة */
FRAMEBUFFER_ADDR   = 0xA0000;    /* إطار العرض */

/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 2: خريطة الذاكرة الفعلية
 * ─────────────────────────────────────────────────────────────────────────────
 *
 * 0x00000000 - 0x000003FF : جدول متجهات المقاطعات (IVT)
 * 0x00000400 - 0x000004FF : منطقة بيانات BIOS (BDA)
 * 0x00000500 - 0x00000FFF : حرة - متاحة
 * 0x00001000 - 0x00004FFF : جداول الصفحات المبكرة (PML4, PDPT, PD, PT)
 * 0x00005000 - 0x00006FFF : حرة - متاحة
 * 0x00007C00 - 0x00007DFF : قطاع الإقلاع (MBR)
 * 0x00007E00 - 0x0006FFFF : حرة - منطقة التحميل
 * 0x00070000 - 0x0007FFFF : مكدس الإقلاع المؤقت
 * 0x00080000 - 0x0008FFFF : معلومات الإقلاع
 * 0x00090000 - 0x0009FFFF : خريطة الذاكرة
 * 0x000A0000 - 0x000BFFFF : ذاكرة الفيديو (VGA)
 * 0x000C0000 - 0x000FFFFF : ROM / BIOS
 * 0x00100000 - ........... : النواة (نواة الملكة)
 */

/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 3: تكوين Limine
 * ─────────────────────────────────────────────────────────────────────────────
 */

/* طلبات Limine المطلوبة */
LIMINE_BASE_REVISION = 2;

/* مميزات Limine المطلوبة */
LIMINE_FEATURE_FRAMEBUFFER  = 1;
LIMINE_FEATURE_MEMMAP       = 1;
LIMINE_FEATURE_KERNEL_FILE  = 1;
LIMINE_FEATURE_RSDP         = 1;
LIMINE_FEATURE_SMP          = 1;
LIMINE_FEATURE_BOOT_TIME    = 1;
LIMINE_FEATURE_STACK_SIZE   = 1;
LIMINE_FEATURE_HHDM         = 1;

/* تكوين إطار العرض */
FRAMEBUFFER_WIDTH  = 1024;
FRAMEBUFFER_HEIGHT = 768;
FRAMEBUFFER_BPP    = 32;

/* حجم المكدس */
LIMINE_STACK_SIZE  = 0x10000;  /* 64 كيلوبايت */

/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 4: هياكل GDT الأولية
 * ─────────────────────────────────────────────────────────────────────────────
 */

/* واصف فارغ */
GDT_NULL       = 0x0000000000000000;

/* واصف شفرة النواة (Ring 0, 64-bit) */
GDT_KERNEL_CODE = 0x00AF9A000000FFFF;

/* واصف بيانات النواة (Ring 0) */
GDT_KERNEL_DATA = 0x00CF92000000FFFF;

/* واصف شفرة المستخدم (Ring 3, 64-bit) */
GDT_USER_CODE   = 0x00AFFA000000FFFF;

/* واصف بيانات المستخدم (Ring 3) */
GDT_USER_DATA   = 0x00CFF2000000FFFF;

/* واصف TSS (يُملأ في وقت التشغيل) */
GDT_TSS_LOW     = 0x0000000000000000;
GDT_TSS_HIGH    = 0x0000000000000000;

/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 5: إعدادات المقاطعات الأولية
 * ─────────────────────────────────────────────────────────────────────────────
 */

/* عدد مداخل IDT */
IDT_ENTRIES = 256;

/* أنواع البوابات */
GATE_INTERRUPT_64 = 0x8E;  /* بوابة مقاطعة 64-بت، DPL=0 */
GATE_TRAP_64      = 0x8F;  /* بوابة مصيدة 64-بت، DPL=0 */
GATE_USER_INT_64  = 0xEE;  /* بوابة مقاطعة 64-بت، DPL=3 */

/* مقاطعات الاستثناءات */
EXCEPTION_DE = 0;    /* قسمة على صفر */
EXCEPTION_DB = 1;    /* تنقيح */
EXCEPTION_NMI = 2;   /* مقاطعة غير قابلة للإخفاء */
EXCEPTION_BP = 3;    /* نقطة توقف */
EXCEPTION_OF = 4;    /* فيضان */
EXCEPTION_BR = 5;    /* تجاوز حدود */
EXCEPTION_UD = 6;    /* عملية غير صالحة */
EXCEPTION_NM = 7;    /* جهاز غير متاح */
EXCEPTION_DF = 8;    /* خطأ مزدوج */
EXCEPTION_TS = 10;   /* TSS غير صالح */
EXCEPTION_NP = 11;   /* قطاع غير موجود */
EXCEPTION_SS = 12;   /* خطأ مكدس */
EXCEPTION_GP = 13;   /* حماية عامة */
EXCEPTION_PF = 14;   /* خطأ صفحة */
EXCEPTION_MF = 16;   /* خطأ فاصلة عائمة */
EXCEPTION_AC = 17;   /* فحص محاذاة */
EXCEPTION_MC = 18;   /* فحص آلة */
EXCEPTION_XM = 19;   /* استثناء SIMD */
EXCEPTION_VE = 20;   /* استثناء افتراضي */

/* IRQ الأساسية (بعد إعادة التوجيه) */
IRQ_BASE = 32;
IRQ_TIMER     = 32;  /* مؤقت PIT */
IRQ_KEYBOARD  = 33;  /* لوحة المفاتيح */
IRQ_CASCADE   = 34;  /* تسلسل PIC */
IRQ_COM2      = 35;  /* منفذ تسلسلي 2 */
IRQ_COM1      = 36;  /* منفذ تسلسلي 1 */
IRQ_LPT2      = 37;  /* طابعة 2 */
IRQ_FLOPPY    = 38;  /* قرص مرن */
IRQ_LPT1      = 39;  /* طابعة 1 */
IRQ_RTC       = 40;  /* ساعة الوقت الحقيقي */
IRQ_MOUSE     = 44;  /* فأرة PS/2 */
IRQ_FPU       = 45;  /* وحدة الفاصلة العائمة */
IRQ_ATA1      = 46;  /* قرص ATA الأول */
IRQ_ATA2      = 47;  /* قرص ATA الثاني */

/* استدعاء النظام */
SYSCALL_VECTOR = 0x80;

/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 6: سجلات التحكم
 * ─────────────────────────────────────────────────────────────────────────────
 */

/* CR0 flags */
CR0_PE = (1 << 0);    /* وضع محمي */
CR0_MP = (1 << 1);    /* مراقبة المعالج المساعد */
CR0_EM = (1 << 2);    /* محاكاة */
CR0_TS = (1 << 3);    /* تبديل مهمة */
CR0_ET = (1 << 4);    /* نوع الامتداد */
CR0_NE = (1 << 5);    /* خطأ رقمي */
CR0_WP = (1 << 16);   /* حماية الكتابة */
CR0_AM = (1 << 18);   /* قناع المحاذاة */
CR0_NW = (1 << 29);   /* بدون كتابة خلفية */
CR0_CD = (1 << 30);   /* تعطيل المخبأة */
CR0_PG = (1 << 31);   /* تمكين الصفحات */

/* CR4 flags */
CR4_PSE        = (1 << 4);    /* امتداد حجم الصفحة */
CR4_PAE        = (1 << 5);    /* امتداد العنوان الفعلي */
CR4_PGE        = (1 << 7);    /* تمكين الصفحات العامة */
CR4_OSFXSR     = (1 << 9);    /* دعم FXSAVE/FXRSTOR */
CR4_OSXMMEXCPT = (1 << 10);   /* دعم استثناءات SIMD */
CR4_FSGSBASE   = (1 << 16);   /* تمكين تعليمات FSGSBASE */
CR4_OSXSAVE    = (1 << 18);   /* دعم XSAVE */

/* MSR */
MSR_EFER       = 0xC0000080;  /* سجل الميزات الموسعة */
MSR_STAR       = 0xC0000081;  /* تكوين SYSCALL */
MSR_LSTAR      = 0xC0000082;  /* عنوان SYSCALL (64-bit) */
MSR_CSTAR      = 0xC0000083;  /* عنوان SYSCALL (compat) */
MSR_SFMASK     = 0xC0000084;  /* قناع SYSCALL */
MSR_FS_BASE    = 0xC0000100;  /* قاعدة FS */
MSR_GS_BASE    = 0xC0000101;  /* قاعدة GS */
MSR_KGS_BASE   = 0xC0000102;  /* قاعدة GS للنواة */

/* EFER bits */
EFER_SCE = (1 << 0);   /* تمكين SYSCALL */
EFER_LME = (1 << 8);   /* تمكين الوضع الطويل */
EFER_LMA = (1 << 10);  /* الوضع الطويل نشط */
EFER_NXE = (1 << 11);  /* تمكين بت عدم التنفيذ */

