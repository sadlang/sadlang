; ══════════════════════════════════════════════════════════════════════════════
; القطاعات.تراب - إعداد القطاعات لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: إعداد سجلات القطاعات وإدارة GS/FS للمعالجات المتعددة
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الثوابت
; ──────────────────────────────────────────────────────────────────────────────
SEL_KERNEL_CODE     equ 0x08
SEL_KERNEL_DATA     equ 0x10
SEL_USER_DATA       equ 0x1B
SEL_USER_CODE       equ 0x23

; عناوين MSR
MSR_FS_BASE         equ 0xC0000100
MSR_GS_BASE         equ 0xC0000101
MSR_KERNEL_GS_BASE  equ 0xC0000102

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global كتابة_قاعدة_جي_إس
global قراءة_قاعدة_جي_إس
global كتابة_قاعدة_إف_إس
global قراءة_قاعدة_إف_إس
global تبديل_جي_إس
global تحميل_قطاعات_النواة
global تحميل_قطاعات_المستخدم

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; كتابة_قاعدة_جي_إس - كتابة قاعدة GS عبر MSR
; المدخلات: rdi = القيمة الجديدة لقاعدة GS
; ──────────────────────────────────────────────────────────────────────────────
كتابة_قاعدة_جي_إس:
    mov eax, edi           ; الجزء السفلي
    shr rdi, 32
    mov edx, edi           ; الجزء العلوي
    mov ecx, MSR_GS_BASE
    wrmsr
    ret

; ──────────────────────────────────────────────────────────────────────────────
; قراءة_قاعدة_جي_إس - قراءة قاعدة GS
; المخرجات: rax = قيمة قاعدة GS
; ──────────────────────────────────────────────────────────────────────────────
قراءة_قاعدة_جي_إس:
    mov ecx, MSR_GS_BASE
    rdmsr
    shl rdx, 32
    or rax, rdx
    ret

; ──────────────────────────────────────────────────────────────────────────────
; كتابة_قاعدة_إف_إس - كتابة قاعدة FS عبر MSR
; المدخلات: rdi = القيمة الجديدة لقاعدة FS
; ──────────────────────────────────────────────────────────────────────────────
كتابة_قاعدة_إف_إس:
    mov eax, edi
    shr rdi, 32
    mov edx, edi
    mov ecx, MSR_FS_BASE
    wrmsr
    ret

; ──────────────────────────────────────────────────────────────────────────────
; قراءة_قاعدة_إف_إس - قراءة قاعدة FS
; المخرجات: rax = قيمة قاعدة FS
; ──────────────────────────────────────────────────────────────────────────────
قراءة_قاعدة_إف_إس:
    mov ecx, MSR_FS_BASE
    rdmsr
    shl rdx, 32
    or rax, rdx
    ret

; ──────────────────────────────────────────────────────────────────────────────
; تبديل_جي_إس - تبديل GS Base مع KernelGSBase (swapgs)
; ──────────────────────────────────────────────────────────────────────────────
تبديل_جي_إس:
    swapgs
    ret

; ──────────────────────────────────────────────────────────────────────────────
; تحميل_قطاعات_النواة - تحميل سجلات قطاعات وضع النواة
; ──────────────────────────────────────────────────────────────────────────────
تحميل_قطاعات_النواة:
    mov ax, SEL_KERNEL_DATA
    mov ds, ax
    mov es, ax
    mov ss, ax
    ret

; ──────────────────────────────────────────────────────────────────────────────
; تحميل_قطاعات_المستخدم - إعداد قطاعات وضع المستخدم
; ──────────────────────────────────────────────────────────────────────────────
تحميل_قطاعات_المستخدم:
    mov ax, SEL_USER_DATA
    mov ds, ax
    mov es, ax
    ret
