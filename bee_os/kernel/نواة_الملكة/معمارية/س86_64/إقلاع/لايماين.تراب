; ══════════════════════════════════════════════════════════════════════════════
; لايماين.تراب - دعم بروتوكول Limine لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: تعريف بنى طلبات بروتوكول Limine لتمرير المعلومات للنواة
; المعمارية: x86_64
; البروتوكول: Limine Boot Protocol v5+
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; ثوابت Limine
; ──────────────────────────────────────────────────────────────────────────────
LIMINE_COMMON_MAGIC_0       equ 0xC7B1DD30DF4C8B88
LIMINE_COMMON_MAGIC_1       equ 0x0A82E883A194F07B

; معرّفات الطلبات
LIMINE_BOOTLOADER_ID_0      equ 0xF55038D8E2A1202F
LIMINE_BOOTLOADER_ID_1      equ 0x279426FCF5F59740

LIMINE_HHDM_ID_0            equ 0x48DCF1CB8AD2B852
LIMINE_HHDM_ID_1            equ 0x63984E959A98244B

LIMINE_FRAMEBUFFER_ID_0     equ 0x9D5827DCD881DD75
LIMINE_FRAMEBUFFER_ID_1     equ 0xA3148604F6FAB11B

LIMINE_MEMMAP_ID_0          equ 0x67CF3D9D378A806F
LIMINE_MEMMAP_ID_1          equ 0xE304ACDFC50C3C62

LIMINE_RSDP_ID_0            equ 0xC5E77B6B397E7B43
LIMINE_RSDP_ID_1            equ 0x27637845ACCDCFE3

LIMINE_KERNEL_ADDR_ID_0     equ 0x71BA76863CC55F63
LIMINE_KERNEL_ADDR_ID_1     equ 0xB2644A48C516A487

LIMINE_SMP_ID_0             equ 0x95A67B819A1B857E
LIMINE_SMP_ID_1             equ 0xA0B61B723B6A73E0

; المراجعة المطلوبة
LIMINE_BASE_REVISION        equ 2

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global طلب_المحمل
global طلب_الذاكرة_العالية
global طلب_إطار_المخزن
global طلب_خريطة_الذاكرة
global طلب_جدول_أيه_سي_بي_آي
global طلب_عنوان_النواة
global طلب_معالجات_متعددة
global المراجعة_الأساسية

; ══════════════════════════════════════════════════════════════════════════════
; قسم الطلبات - يجب أن تكون قابلة للكتابة
; ══════════════════════════════════════════════════════════════════════════════
section .limine_reqs align=8

; ── المراجعة الأساسية ──
المراجعة_الأساسية:
    dq 0xF9562B2D5C95A6C8       ; سحر المراجعة
    dq 0x6A7B384944536BDC
    dq LIMINE_BASE_REVISION     ; المراجعة المطلوبة

; ── طلب معلومات المحمل ──
طلب_المحمل:
    dq LIMINE_COMMON_MAGIC_0
    dq LIMINE_COMMON_MAGIC_1
    dq LIMINE_BOOTLOADER_ID_0
    dq LIMINE_BOOTLOADER_ID_1
    dq 0                        ; المراجعة
    dq 0                        ; مؤشر الاستجابة

; ── طلب HHDM (الخريطة المباشرة للذاكرة العالية) ──
طلب_الذاكرة_العالية:
    dq LIMINE_COMMON_MAGIC_0
    dq LIMINE_COMMON_MAGIC_1
    dq LIMINE_HHDM_ID_0
    dq LIMINE_HHDM_ID_1
    dq 0
    dq 0

; ── طلب إطار المخزن (Framebuffer) ──
طلب_إطار_المخزن:
    dq LIMINE_COMMON_MAGIC_0
    dq LIMINE_COMMON_MAGIC_1
    dq LIMINE_FRAMEBUFFER_ID_0
    dq LIMINE_FRAMEBUFFER_ID_1
    dq 0
    dq 0

; ── طلب خريطة الذاكرة ──
طلب_خريطة_الذاكرة:
    dq LIMINE_COMMON_MAGIC_0
    dq LIMINE_COMMON_MAGIC_1
    dq LIMINE_MEMMAP_ID_0
    dq LIMINE_MEMMAP_ID_1
    dq 0
    dq 0

; ── طلب RSDP (ACPI) ──
طلب_جدول_أيه_سي_بي_آي:
    dq LIMINE_COMMON_MAGIC_0
    dq LIMINE_COMMON_MAGIC_1
    dq LIMINE_RSDP_ID_0
    dq LIMINE_RSDP_ID_1
    dq 0
    dq 0

; ── طلب عنوان النواة ──
طلب_عنوان_النواة:
    dq LIMINE_COMMON_MAGIC_0
    dq LIMINE_COMMON_MAGIC_1
    dq LIMINE_KERNEL_ADDR_ID_0
    dq LIMINE_KERNEL_ADDR_ID_1
    dq 0
    dq 0

; ── طلب معالجات متعددة (SMP) ──
طلب_معالجات_متعددة:
    dq LIMINE_COMMON_MAGIC_0
    dq LIMINE_COMMON_MAGIC_1
    dq LIMINE_SMP_ID_0
    dq LIMINE_SMP_ID_1
    dq 0                        ; المراجعة
    dq 0                        ; الاستجابة
    dq 0                        ; أعلام (x2APIC)
