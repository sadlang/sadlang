; ══════════════════════════════════════════════════════════════════════════════
; نقطة_دخول.تراب - نقطة الدخول الرئيسية لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: نقطة الدخول الأولى التي يصل إليها المعالج بعد الإقلاع
;         تقوم بتهيئة البيئة الأساسية ثم تنقل التحكم إلى كود ص
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; القسم: الثوابت العامة
; ──────────────────────────────────────────────────────────────────────────────
KERNEL_STACK_SIZE       equ 16384       ; 16 كيلوبايت للمكدس الأولي
KERNEL_VIRT_BASE        equ 0xFFFFFFFF80000000  ; العنوان الافتراضي للنواة
PAGE_SIZE               equ 4096        ; حجم الصفحة القياسي
MAGIC_BEE               equ 0x4E504842  ; 'HBPN' - النحلة

; ──────────────────────────────────────────────────────────────────────────────
; القسم: الرموز الخارجية
; ──────────────────────────────────────────────────────────────────────────────
extern بداية_النواة              ; الدالة الرئيسية في كود ص
extern تصفير_بي_إس_إس           ; تصفير قسم BSS
extern إعداد_المكدس             ; تهيئة المكدس
extern تحميل_جدول_الواصفات      ; تحميل GDT
extern تحميل_المقاطعات          ; تحميل IDT
extern تهيئة_التسلسلي_المبكر    ; الإخراج التسلسلي المبكر

; ──────────────────────────────────────────────────────────────────────────────
; القسم: الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global _start
global نقطة_الدخول
global معلومات_الإقلاع_المحفوظة
global سحر_الإقلاع_المحفوظ

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص - الكود القابل للتنفيذ
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; _start - نقطة الدخول الأولى (رمز الربط)
; الوصف: أول تعليمة يتم تنفيذها بعد الإقلاع
; المدخلات:
;   rax = الرقم السحري (Multiboot2 أو Limine)
;   rbx = مؤشر معلومات الإقلاع
; ──────────────────────────────────────────────────────────────────────────────
_start:
نقطة_الدخول:
    ; تعطيل المقاطعات فوراً للحماية
    cli

    ; حفظ معلومات الإقلاع من محمّل الإقلاع
    mov [rel سحر_الإقلاع_المحفوظ], eax
    mov [rel معلومات_الإقلاع_المحفوظة], rbx

    ; تصفير سجلات القطاعات
    xor eax, eax
    mov ds, ax
    mov es, ax
    mov fs, ax
    mov gs, ax
    mov ss, ax

    ; إعداد المكدس الأولي
    lea rsp, [rel مكدس_النواة + KERNEL_STACK_SIZE]
    mov rbp, rsp

    ; تصفير الأعلام
    push qword 0
    popfq

    ; ── المرحلة 1: تصفير BSS ──
    call تصفير_بي_إس_إس

    ; ── المرحلة 2: تهيئة الإخراج المبكر ──
    call تهيئة_التسلسلي_المبكر

    ; طباعة رسالة ترحيبية مبكرة
    lea rdi, [rel رسالة_الترحيب]
    call طباعة_سلسلة_مبكرة

    ; ── المرحلة 3: إعداد GDT ──
    call تحميل_جدول_الواصفات

    ; ── المرحلة 4: إعداد IDT ──
    call تحميل_المقاطعات

    ; ── المرحلة 5: نقل التحكم إلى كود ص ──
    ; تمرير معلومات الإقلاع كمعامل أول
    mov rdi, [rel سحر_الإقلاع_المحفوظ]
    mov rsi, [rel معلومات_الإقلاع_المحفوظة]

    ; الانتقال إلى النواة (لا رجعة)
    call بداية_النواة

    ; لا ينبغي الوصول إلى هنا أبداً
    jmp توقف_تام

; ──────────────────────────────────────────────────────────────────────────────
; طباعة_سلسلة_مبكرة - طباعة نص عبر المنفذ التسلسلي
; المدخلات: rdi = مؤشر إلى السلسلة
; ──────────────────────────────────────────────────────────────────────────────
طباعة_سلسلة_مبكرة:
    push rax
    push rdx
    push rsi
    mov rsi, rdi
.حلقة:
    lodsb
    test al, al
    jz .نهاية
    mov dx, 0x3F8           ; المنفذ التسلسلي COM1
.انتظار:
    push rax
    mov dx, 0x3FD           ; سجل حالة الخط
    in al, dx
    test al, 0x20           ; هل المخزن المؤقت فارغ؟
    jz .انتظار
    pop rax
    mov dx, 0x3F8
    out dx, al
    jmp .حلقة
.نهاية:
    pop rsi
    pop rdx
    pop rax
    ret

; ──────────────────────────────────────────────────────────────────────────────
; توقف_تام - إيقاف المعالج نهائياً
; ──────────────────────────────────────────────────────────────────────────────
توقف_تام:
    cli
    hlt
    jmp توقف_تام

; ══════════════════════════════════════════════════════════════════════════════
; قسم البيانات
; ══════════════════════════════════════════════════════════════════════════════
section .data
align 8

رسالة_الترحيب:
    db 0x0D, 0x0A
    db "=== BeeOS / Khaliyat An-Nahl ===", 0x0D, 0x0A
    db "Entry Point OK", 0x0D, 0x0A, 0

; ══════════════════════════════════════════════════════════════════════════════
; قسم BSS - البيانات غير المهيأة
; ══════════════════════════════════════════════════════════════════════════════
section .bss
align 16

سحر_الإقلاع_المحفوظ:       resq 1
معلومات_الإقلاع_المحفوظة:    resq 1

align 4096
مكدس_النواة:                 resb KERNEL_STACK_SIZE
