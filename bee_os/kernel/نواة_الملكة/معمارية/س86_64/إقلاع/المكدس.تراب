; ══════════════════════════════════════════════════════════════════════════════
; المكدس.تراب - إعداد المكدس لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: تهيئة مكدس النواة مع صفحات حماية وتحقق من المحاذاة
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الثوابت
; ──────────────────────────────────────────────────────────────────────────────
STACK_SIZE          equ 65536       ; 64 KB لمكدس النواة الرئيسي
GUARD_PAGE_SIZE     equ 4096        ; صفحة حماية 4 KB
STACK_CANARY        equ 0xDEADBEEF4E50484E  ; قيمة الحراسة

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global إعداد_المكدس
global تحقق_من_المكدس
global أعلى_المكدس

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; إعداد_المكدس - تهيئة المكدس الرئيسي للنواة
; المخرجات: rsp = أعلى المكدس
; ──────────────────────────────────────────────────────────────────────────────
إعداد_المكدس:
    ; تحميل عنوان أعلى المكدس
    lea rsp, [rel منطقة_المكدس + STACK_SIZE]
    mov rbp, rsp

    ; وضع قيمة الحماية في أسفل المكدس
    lea rax, [rel منطقة_المكدس]
    mov qword [rax], STACK_CANARY

    ; حفظ أعلى المكدس
    lea rax, [rel أعلى_المكدس]
    mov [rax], rsp

    ret

; ──────────────────────────────────────────────────────────────────────────────
; تحقق_من_المكدس - التحقق من سلامة المكدس
; المخرجات: rax = 1 إذا سليم، 0 إذا تالف
; ──────────────────────────────────────────────────────────────────────────────
تحقق_من_المكدس:
    lea rax, [rel منطقة_المكدس]
    mov rax, [rax]
    mov rcx, STACK_CANARY
    cmp rax, rcx
    je .سليم
    xor eax, eax                ; تالف
    ret
.سليم:
    mov eax, 1                  ; سليم
    ret

; ══════════════════════════════════════════════════════════════════════════════
; قسم BSS
; ══════════════════════════════════════════════════════════════════════════════
section .bss
align 4096

صفحة_حماية_سفلى:             resb GUARD_PAGE_SIZE
منطقة_المكدس:                resb STACK_SIZE
صفحة_حماية_علوى:             resb GUARD_PAGE_SIZE

section .data
align 8
أعلى_المكدس:                 dq 0
