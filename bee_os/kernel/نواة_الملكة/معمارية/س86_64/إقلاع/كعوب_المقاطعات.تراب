; ══════════════════════════════════════════════════════════════════════════════
; كعوب_المقاطعات.تراب - كعوب IDT لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: معالجات الاستثناءات والمقاطعات (ISR/IRQ stubs)
;         تحفظ السجلات وتستدعي المعالج المناسب في كود ص
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الثوابت
; ──────────────────────────────────────────────────────────────────────────────
NUM_EXCEPTIONS      equ 32          ; عدد الاستثناءات المعيارية
NUM_IRQS            equ 16          ; عدد المقاطعات الخارجية
IRQ_BASE            equ 32          ; بداية المقاطعات الخارجية

; ──────────────────────────────────────────────────────────────────────────────
; الرموز الخارجية
; ──────────────────────────────────────────────────────────────────────────────
extern معالج_الاستثناء           ; void معالج_الاستثناء(رقم, كود_خطأ, إطار*)
extern معالج_المقاطعة           ; void معالج_المقاطعة(رقم, إطار*)

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global جدول_كعوب_الاستثناءات
global جدول_كعوب_المقاطعات

; ══════════════════════════════════════════════════════════════════════════════
; ماكرو لحفظ واستعادة السجلات
; ══════════════════════════════════════════════════════════════════════════════

%macro حفظ_السجلات 0
    push rax
    push rbx
    push rcx
    push rdx
    push rsi
    push rdi
    push rbp
    push r8
    push r9
    push r10
    push r11
    push r12
    push r13
    push r14
    push r15
    mov ax, ds
    push rax
    mov ax, 0x10            ; SEL_KERNEL_DATA
    mov ds, ax
    mov es, ax
%endmacro

%macro استعادة_السجلات 0
    pop rax
    mov ds, ax
    mov es, ax
    pop r15
    pop r14
    pop r13
    pop r12
    pop r11
    pop r10
    pop r9
    pop r8
    pop rbp
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rbx
    pop rax
%endmacro

; ══════════════════════════════════════════════════════════════════════════════
; ماكرو كعب استثناء بدون كود خطأ
; ══════════════════════════════════════════════════════════════════════════════
%macro كعب_استثناء_بدون_كود 1
كعب_استثناء_%1:
    push qword 0            ; كود خطأ وهمي
    push qword %1           ; رقم الاستثناء
    jmp معالج_استثناء_مشترك
%endmacro

; ══════════════════════════════════════════════════════════════════════════════
; ماكرو كعب استثناء مع كود خطأ
; ══════════════════════════════════════════════════════════════════════════════
%macro كعب_استثناء_مع_كود 1
كعب_استثناء_%1:
    push qword %1           ; رقم الاستثناء (كود الخطأ موجود مسبقاً)
    jmp معالج_استثناء_مشترك
%endmacro

; ══════════════════════════════════════════════════════════════════════════════
; ماكرو كعب مقاطعة
; ══════════════════════════════════════════════════════════════════════════════
%macro كعب_مقاطعة 1
كعب_مقاطعة_%1:
    push qword 0            ; كود خطأ وهمي
    push qword (%1 + IRQ_BASE)  ; رقم المقاطعة
    jmp معالج_مقاطعة_مشترك
%endmacro

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ── كعوب الاستثناءات (0-31) ──
; استثناءات بدون كود خطأ: 0-7, 9, 15, 16, 18-20, 22-31
كعب_استثناء_بدون_كود 0      ; القسمة على صفر
كعب_استثناء_بدون_كود 1      ; التنقيح
كعب_استثناء_بدون_كود 2      ; NMI
كعب_استثناء_بدون_كود 3      ; نقطة التوقف
كعب_استثناء_بدون_كود 4      ; الفيضان
كعب_استثناء_بدون_كود 5      ; تجاوز الحدود
كعب_استثناء_بدون_كود 6      ; تعليمة غير صالحة
كعب_استثناء_بدون_كود 7      ; الجهاز غير متوفر
; استثناءات مع كود خطأ: 8, 10-14, 17, 21
كعب_استثناء_مع_كود    8      ; خطأ مزدوج
كعب_استثناء_بدون_كود 9      ; تجاوز مقطع المعالج المساعد
كعب_استثناء_مع_كود    10     ; TSS غير صالح
كعب_استثناء_مع_كود    11     ; مقطع غير موجود
كعب_استثناء_مع_كود    12     ; خطأ مكدس
كعب_استثناء_مع_كود    13     ; حماية عامة
كعب_استثناء_مع_كود    14     ; خطأ صفحة
كعب_استثناء_بدون_كود 15     ; محجوز
كعب_استثناء_بدون_كود 16     ; خطأ حسابي
كعب_استثناء_مع_كود    17     ; فحص المحاذاة
كعب_استثناء_بدون_كود 18     ; فحص الآلة
كعب_استثناء_بدون_كود 19     ; SIMD
كعب_استثناء_بدون_كود 20     ; الافتراضية
كعب_استثناء_مع_كود    21     ; حماية التحكم
كعب_استثناء_بدون_كود 22
كعب_استثناء_بدون_كود 23
كعب_استثناء_بدون_كود 24
كعب_استثناء_بدون_كود 25
كعب_استثناء_بدون_كود 26
كعب_استثناء_بدون_كود 27
كعب_استثناء_بدون_كود 28
كعب_استثناء_بدون_كود 29
كعب_استثناء_بدون_كود 30
كعب_استثناء_بدون_كود 31

; ── كعوب المقاطعات (IRQ 0-15) ──
كعب_مقاطعة 0               ; المؤقت
كعب_مقاطعة 1               ; لوحة المفاتيح
كعب_مقاطعة 2               ; التسلسل (cascade)
كعب_مقاطعة 3               ; COM2
كعب_مقاطعة 4               ; COM1
كعب_مقاطعة 5               ; LPT2
كعب_مقاطعة 6               ; القرص المرن
كعب_مقاطعة 7               ; LPT1
كعب_مقاطعة 8               ; ساعة حقيقية
كعب_مقاطعة 9               ; حر
كعب_مقاطعة 10              ; حر
كعب_مقاطعة 11              ; حر
كعب_مقاطعة 12              ; الفأرة
كعب_مقاطعة 13              ; FPU
كعب_مقاطعة 14              ; ATA أولي
كعب_مقاطعة 15              ; ATA ثانوي

; ──────────────────────────────────────────────────────────────────────────────
; معالج_استثناء_مشترك - نقطة الدخول المشتركة للاستثناءات
; ──────────────────────────────────────────────────────────────────────────────
معالج_استثناء_مشترك:
    حفظ_السجلات

    ; تمرير المعاملات: rdi=رقم, rsi=كود_خطأ, rdx=مؤشر_الإطار
    mov rdi, [rsp + 128]    ; رقم الاستثناء
    mov rsi, [rsp + 136]    ; كود الخطأ
    mov rdx, rsp            ; مؤشر إلى الإطار المحفوظ

    call معالج_الاستثناء

    استعادة_السجلات
    add rsp, 16             ; إزالة رقم الاستثناء وكود الخطأ
    iretq

; ──────────────────────────────────────────────────────────────────────────────
; معالج_مقاطعة_مشترك - نقطة الدخول المشتركة للمقاطعات
; ──────────────────────────────────────────────────────────────────────────────
معالج_مقاطعة_مشترك:
    حفظ_السجلات

    mov rdi, [rsp + 128]    ; رقم المقاطعة
    mov rsi, rsp            ; مؤشر إلى الإطار

    call معالج_المقاطعة

    استعادة_السجلات
    add rsp, 16
    iretq

; ══════════════════════════════════════════════════════════════════════════════
; قسم البيانات - جداول الكعوب
; ══════════════════════════════════════════════════════════════════════════════
section .data
align 8

جدول_كعوب_الاستثناءات:
%assign i 0
%rep NUM_EXCEPTIONS
    dq كعب_استثناء_ %+ i
%assign i i+1
%endrep

جدول_كعوب_المقاطعات:
%assign i 0
%rep NUM_IRQS
    dq كعب_مقاطعة_ %+ i
%assign i i+1
%endrep
