; ══════════════════════════════════════════════════════════════════════════════
; ملتي_بوت2.تراب - ترويسة Multiboot2 لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: ترويسة Multiboot2 المطلوبة لتحميل النواة عبر GRUB2
; المعمارية: x86_64
; المعيار: Multiboot2 Specification
; ══════════════════════════════════════════════════════════════════════════════

bits 64

; ──────────────────────────────────────────────────────────────────────────────
; ثوابت Multiboot2
; ──────────────────────────────────────────────────────────────────────────────
MULTIBOOT2_MAGIC            equ 0xE85250D6
MULTIBOOT2_ARCH_I386        equ 0
MULTIBOOT2_HEADER_LENGTH    equ (نهاية_الترويسة - بداية_الترويسة)
MULTIBOOT2_CHECKSUM         equ -(MULTIBOOT2_MAGIC + MULTIBOOT2_ARCH_I386 + MULTIBOOT2_HEADER_LENGTH)

; أنواع الوسوم
TAG_TYPE_END                equ 0
TAG_TYPE_INFO_REQUEST       equ 1
TAG_TYPE_FRAMEBUFFER        equ 5
TAG_TYPE_ALIGN              equ 6

; أعلام
TAG_REQUIRED                equ 0
TAG_OPTIONAL                equ 1

; ══════════════════════════════════════════════════════════════════════════════
; قسم الترويسة - يجب أن يكون في أول 32 كيلوبايت
; ══════════════════════════════════════════════════════════════════════════════
section .multiboot2 align=8

بداية_الترويسة:
    ; الترويسة الرئيسية
    dd MULTIBOOT2_MAGIC             ; الرقم السحري
    dd MULTIBOOT2_ARCH_I386         ; المعمارية (i386/x86)
    dd MULTIBOOT2_HEADER_LENGTH     ; طول الترويسة
    dd MULTIBOOT2_CHECKSUM          ; مجموع التحقق

    ; ── وسم طلب المعلومات ──
    align 8
    dw TAG_TYPE_INFO_REQUEST        ; النوع: طلب معلومات
    dw TAG_REQUIRED                 ; أعلام: مطلوب
    dd 24                           ; الحجم
    dd 4                            ; خريطة الذاكرة
    dd 6                            ; جدول ELF
    dd 8                            ; إطار المخزن المؤقت

    ; ── وسم إطار المخزن المؤقت (Framebuffer) ──
    align 8
    dw TAG_TYPE_FRAMEBUFFER         ; النوع: إطار المخزن
    dw TAG_OPTIONAL                 ; أعلام: اختياري
    dd 20                           ; الحجم
    dd 1024                         ; العرض المطلوب
    dd 768                          ; الارتفاع المطلوب
    dd 32                           ; عمق اللون (بت)

    ; ── وسم المحاذاة ──
    align 8
    dw TAG_TYPE_ALIGN               ; النوع: محاذاة الوحدات
    dw TAG_REQUIRED                 ; أعلام: مطلوب
    dd 8                            ; الحجم

    ; ── وسم النهاية ──
    align 8
    dw TAG_TYPE_END                 ; النوع: النهاية
    dw 0                            ; أعلام
    dd 8                            ; الحجم

نهاية_الترويسة:
