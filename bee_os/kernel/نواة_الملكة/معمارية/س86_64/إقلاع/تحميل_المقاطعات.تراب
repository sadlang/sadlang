; ══════════════════════════════════════════════════════════════════════════════
; تحميل_المقاطعات.تراب - تحميل IDT لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: بناء وتحميل جدول واصفات المقاطعات (IDT)
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الثوابت
; ──────────────────────────────────────────────────────────────────────────────
NUM_IDT_ENTRIES     equ 256         ; عدد مدخلات IDT
IDT_ENTRY_SIZE      equ 16          ; حجم كل مدخلة (16 بايت في x86_64)
SEL_KERNEL_CODE     equ 0x08        ; محدد كود النواة

; أنواع البوابات
GATE_INTERRUPT      equ 0x8E        ; بوابة مقاطعة (P=1, DPL=0, Type=0xE)
GATE_TRAP           equ 0x8F        ; بوابة فخ (P=1, DPL=0, Type=0xF)
GATE_USER_INT       equ 0xEE        ; بوابة مقاطعة (P=1, DPL=3, Type=0xE)

; ──────────────────────────────────────────────────────────────────────────────
; الرموز الخارجية
; ──────────────────────────────────────────────────────────────────────────────
extern جدول_كعوب_الاستثناءات
extern جدول_كعوب_المقاطعات

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global تحميل_المقاطعات
global تعيين_مقاطعة
global جدول_المقاطعات

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; تحميل_المقاطعات - بناء وتحميل IDT
; ──────────────────────────────────────────────────────────────────────────────
تحميل_المقاطعات:
    push rbx
    push rcx
    push rdx
    push rdi

    ; ── تصفير جدول IDT ──
    lea rdi, [rel جدول_المقاطعات]
    mov rcx, NUM_IDT_ENTRIES * IDT_ENTRY_SIZE / 8
    xor eax, eax
    rep stosq

    ; ── تسجيل الاستثناءات (0-31) ──
    lea rbx, [rel جدول_كعوب_الاستثناءات]
    xor ecx, ecx                ; العداد = 0
.حلقة_الاستثناءات:
    cmp ecx, 32
    jge .حلقة_المقاطعات_بداية

    mov rdi, rcx                ; رقم المدخلة
    mov rsi, [rbx + rcx * 8]   ; عنوان المعالج
    mov dl, GATE_INTERRUPT      ; نوع البوابة
    xor r8d, r8d                ; IST = 0
    call تعيين_مقاطعة

    inc ecx
    jmp .حلقة_الاستثناءات

    ; ── تسجيل المقاطعات الخارجية (32-47) ──
.حلقة_المقاطعات_بداية:
    lea rbx, [rel جدول_كعوب_المقاطعات]
    xor ecx, ecx
.حلقة_المقاطعات:
    cmp ecx, 16
    jge .تحميل

    mov rdi, rcx
    add rdi, 32                 ; IRQ + 32
    mov rsi, [rbx + rcx * 8]   ; عنوان المعالج
    mov dl, GATE_INTERRUPT
    xor r8d, r8d
    call تعيين_مقاطعة

    inc ecx
    jmp .حلقة_المقاطعات

    ; ── تحميل IDT ──
.تحميل:
    lea rax, [rel مؤشر_المقاطعات]
    lidt [rax]

    pop rdi
    pop rdx
    pop rcx
    pop rbx
    ret

; ──────────────────────────────────────────────────────────────────────────────
; تعيين_مقاطعة - تعيين مدخلة في جدول IDT
; المدخلات:
;   rdi = رقم المدخلة (0-255)
;   rsi = عنوان المعالج
;   dl  = نوع البوابة
;   r8b = رقم IST (0-7)
; ──────────────────────────────────────────────────────────────────────────────
تعيين_مقاطعة:
    push rax
    push rbx

    ; حساب عنوان المدخلة
    lea rax, [rel جدول_المقاطعات]
    shl rdi, 4                  ; rdi *= 16
    add rax, rdi

    ; العنوان [15:0]
    mov word [rax], si

    ; محدد القطاع
    mov word [rax + 2], SEL_KERNEL_CODE

    ; IST
    mov byte [rax + 4], r8b

    ; نوع البوابة
    mov byte [rax + 5], dl

    ; العنوان [31:16]
    mov rbx, rsi
    shr rbx, 16
    mov word [rax + 6], bx

    ; العنوان [63:32]
    shr rbx, 16
    mov dword [rax + 8], ebx

    ; محجوز
    mov dword [rax + 12], 0

    pop rbx
    pop rax
    ret

; ══════════════════════════════════════════════════════════════════════════════
; قسم البيانات
; ══════════════════════════════════════════════════════════════════════════════
section .data
align 8

مؤشر_المقاطعات:
    dw (NUM_IDT_ENTRIES * IDT_ENTRY_SIZE) - 1   ; الحجم
    dq جدول_المقاطعات                            ; العنوان

; ══════════════════════════════════════════════════════════════════════════════
; قسم BSS
; ══════════════════════════════════════════════════════════════════════════════
section .bss
align 16

جدول_المقاطعات:             resb NUM_IDT_ENTRIES * IDT_ENTRY_SIZE
