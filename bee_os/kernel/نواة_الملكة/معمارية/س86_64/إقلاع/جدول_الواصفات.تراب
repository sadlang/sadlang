; ══════════════════════════════════════════════════════════════════════════════
; جدول_الواصفات.تراب - تعريف GDT لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: جدول الواصفات العامة (Global Descriptor Table) لوضع 64-بت
;         يتضمن واصفات للنواة والمستخدم ومقطع TSS
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; ثوابت GDT
; ──────────────────────────────────────────────────────────────────────────────
; أعلام الوصول
GDT_PRESENT         equ 0x80        ; الواصف موجود
GDT_DPL0            equ 0x00        ; مستوى امتياز 0 (نواة)
GDT_DPL3            equ 0x60        ; مستوى امتياز 3 (مستخدم)
GDT_CODE            equ 0x18        ; مقطع كود
GDT_DATA            equ 0x10        ; مقطع بيانات
GDT_READABLE        equ 0x02        ; كود قابل للقراءة
GDT_WRITABLE        equ 0x02        ; بيانات قابلة للكتابة
GDT_TSS_TYPE        equ 0x09        ; نوع TSS 64-بت

; أعلام الحبيبات
GDT_LONG_MODE       equ 0x20        ; وضع 64-بت
GDT_GRANULARITY     equ 0x80        ; حبيبات 4KB
GDT_SIZE_32         equ 0x40        ; حجم 32-بت

; محددات المقاطع (Selectors)
SEL_NULL            equ 0x00        ; 0x00 - واصف فارغ
SEL_KERNEL_CODE     equ 0x08        ; 0x08 - كود النواة
SEL_KERNEL_DATA     equ 0x10        ; 0x10 - بيانات النواة
SEL_USER_DATA       equ 0x1B        ; 0x18 | RPL3 - بيانات المستخدم
SEL_USER_CODE       equ 0x23        ; 0x20 | RPL3 - كود المستخدم
SEL_TSS             equ 0x28        ; 0x28 - مقطع TSS

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global جدول_الواصفات
global مؤشر_الجدول
global إعداد_تي_إس_إس
global بنية_تي_إس_إس

; ══════════════════════════════════════════════════════════════════════════════
; قسم البيانات - جدول GDT
; ══════════════════════════════════════════════════════════════════════════════
section .data
align 16

جدول_الواصفات:
    ; 0x00 - الواصف الفارغ (مطلوب)
    dq 0x0000000000000000

    ; 0x08 - كود النواة (Ring 0)
    ; الحد=0, القاعدة=0, الوصول=P|DPL0|Code|Readable, الأعلام=LongMode
    dw 0xFFFF               ; الحد [15:0]
    dw 0x0000               ; القاعدة [15:0]
    db 0x00                 ; القاعدة [23:16]
    db GDT_PRESENT | GDT_DPL0 | GDT_CODE | GDT_READABLE    ; الوصول
    db GDT_LONG_MODE | 0x0F ; الأعلام | الحد [19:16]
    db 0x00                 ; القاعدة [31:24]

    ; 0x10 - بيانات النواة (Ring 0)
    dw 0xFFFF
    dw 0x0000
    db 0x00
    db GDT_PRESENT | GDT_DPL0 | GDT_DATA | GDT_WRITABLE
    db GDT_GRANULARITY | GDT_SIZE_32 | 0x0F
    db 0x00

    ; 0x18 - بيانات المستخدم (Ring 3) - قبل الكود لتوافق syscall/sysret
    dw 0xFFFF
    dw 0x0000
    db 0x00
    db GDT_PRESENT | GDT_DPL3 | GDT_DATA | GDT_WRITABLE
    db GDT_GRANULARITY | GDT_SIZE_32 | 0x0F
    db 0x00

    ; 0x20 - كود المستخدم (Ring 3)
    dw 0xFFFF
    dw 0x0000
    db 0x00
    db GDT_PRESENT | GDT_DPL3 | GDT_CODE | GDT_READABLE
    db GDT_LONG_MODE | 0x0F
    db 0x00

    ; 0x28 - TSS (يتم ملؤه ديناميكياً) - واصف 128 بت
واصف_تي_إس_إس:
    dw 0                    ; الحد [15:0] (يُملأ لاحقاً)
    dw 0                    ; القاعدة [15:0]
    db 0                    ; القاعدة [23:16]
    db GDT_PRESENT | GDT_TSS_TYPE   ; الوصول
    db 0                    ; الأعلام | الحد [19:16]
    db 0                    ; القاعدة [31:24]
    dd 0                    ; القاعدة [63:32]
    dd 0                    ; محجوز

نهاية_الجدول:

; ──────────────────────────────────────────────────────────────────────────────
; مؤشر GDT
; ──────────────────────────────────────────────────────────────────────────────
مؤشر_الجدول:
    dw نهاية_الجدول - جدول_الواصفات - 1   ; الحجم - 1
    dq جدول_الواصفات                        ; العنوان

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص - إعداد TSS
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; إعداد_تي_إس_إس - تهيئة بنية TSS وتحديث واصفها في GDT
; المدخلات: rdi = عنوان مكدس IST1
; ──────────────────────────────────────────────────────────────────────────────
إعداد_تي_إس_إس:
    push rax
    push rbx
    push rcx

    ; تصفير بنية TSS
    lea rdi, [rel بنية_تي_إس_إس]
    mov rcx, 104                ; حجم TSS = 104 بايت
    xor eax, eax
    rep stosb

    ; تحديث واصف TSS في GDT
    lea rax, [rel بنية_تي_إس_إس]
    lea rbx, [rel واصف_تي_إس_إس]

    ; الحد = 103 (حجم TSS - 1)
    mov word [rbx], 103

    ; القاعدة [15:0]
    mov rcx, rax
    mov word [rbx + 2], cx

    ; القاعدة [23:16]
    shr rcx, 16
    mov byte [rbx + 4], cl

    ; القاعدة [31:24]
    shr rcx, 8
    mov byte [rbx + 7], cl

    ; القاعدة [63:32]
    shr rcx, 8
    mov dword [rbx + 8], ecx

    pop rcx
    pop rbx
    pop rax
    ret

; ══════════════════════════════════════════════════════════════════════════════
; قسم BSS - بنية TSS
; ══════════════════════════════════════════════════════════════════════════════
section .bss
align 16

بنية_تي_إس_إس:              resb 104        ; 104 بايت لبنية TSS
