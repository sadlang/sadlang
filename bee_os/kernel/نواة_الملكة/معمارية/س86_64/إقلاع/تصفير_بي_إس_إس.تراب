; ══════════════════════════════════════════════════════════════════════════════
; تصفير_بي_إس_إس.تراب - تصفير قسم BSS لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: يقوم بتصفير كامل قسم BSS (البيانات غير المهيأة)
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الرموز الخارجية (يحددها الرابط)
; ──────────────────────────────────────────────────────────────────────────────
extern __bss_start
extern __bss_end

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global تصفير_بي_إس_إس

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; تصفير_بي_إس_إس - تصفير كامل قسم BSS
; الوصف: يستخدم rep stosq لتصفير BSS بسرعة (8 بايت في المرة)
;         ثم rep stosb للباقي
; ──────────────────────────────────────────────────────────────────────────────
تصفير_بي_إس_إس:
    push rdi
    push rcx
    push rax

    ; حساب حجم BSS
    lea rdi, [rel __bss_start]
    lea rcx, [rel __bss_end]
    sub rcx, rdi                ; rcx = الحجم بالبايتات

    ; التحقق من أن الحجم > 0
    test rcx, rcx
    jz .انتهى

    ; حفظ الحجم الكامل
    mov rdx, rcx

    ; تصفير باستخدام qwords أولاً (8 بايت كل مرة)
    xor eax, eax
    shr rcx, 3                  ; rcx = عدد qwords
    rep stosq

    ; تصفير الباقي بالبايت
    mov rcx, rdx
    and rcx, 7                  ; rcx = البايتات المتبقية
    rep stosb

.انتهى:
    pop rax
    pop rcx
    pop rdi
    ret
