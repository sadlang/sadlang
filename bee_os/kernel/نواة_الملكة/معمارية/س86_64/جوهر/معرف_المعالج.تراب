; ══════════════════════════════════════════════════════════════════════════════
; معرف_المعالج.تراب - كشف ميزات المعالج (CPUID)
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: استدعاء CPUID لكشف ميزات المعالج ومعلوماته
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الثوابت
; ──────────────────────────────────────────────────────────────────────────────
; ميزات EDX (ورقة 1)
CPUID_FPU       equ (1 << 0)
CPUID_SSE       equ (1 << 25)
CPUID_SSE2      equ (1 << 26)
CPUID_APIC      equ (1 << 9)
CPUID_MSR       equ (1 << 5)
CPUID_PAE       equ (1 << 6)

; ميزات ECX (ورقة 1)
CPUID_SSE3      equ (1 << 0)
CPUID_SSE41     equ (1 << 19)
CPUID_SSE42     equ (1 << 20)
CPUID_AVX       equ (1 << 28)
CPUID_X2APIC    equ (1 << 21)

; ميزات موسعة
CPUID_NX        equ (1 << 20)   ; EDX من 0x80000001
CPUID_1GB_PAGE  equ (1 << 26)
CPUID_LONG_MODE equ (1 << 29)

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global استدعاء_معرف_المعالج
global كشف_ميزات_المعالج
global اسم_المعالج
global ميزات_المعالج

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; استدعاء_معرف_المعالج - استدعاء CPUID
; المدخلات: edi = الورقة (leaf)، esi = الورقة الفرعية
; المخرجات: eax, ebx, ecx, edx = نتائج CPUID
; ──────────────────────────────────────────────────────────────────────────────
استدعاء_معرف_المعالج:
    push rbx
    mov eax, edi
    mov ecx, esi
    cpuid
    ; النتائج: eax, ebx, ecx, edx
    ; نحفظ في بنية النتيجة
    mov [rel نتيجة_معرف + 0], eax
    mov [rel نتيجة_معرف + 4], ebx
    mov [rel نتيجة_معرف + 8], ecx
    mov [rel نتيجة_معرف + 12], edx
    pop rbx
    ret

; ──────────────────────────────────────────────────────────────────────────────
; كشف_ميزات_المعالج - كشف ميزات المعالج وتخزينها
; ──────────────────────────────────────────────────────────────────────────────
كشف_ميزات_المعالج:
    push rbx
    push r12

    ; ── الورقة 0: معلومات الشركة ──
    xor eax, eax
    cpuid
    mov [rel أقصى_ورقة], eax
    mov [rel اسم_المعالج], ebx
    mov [rel اسم_المعالج + 4], edx
    mov [rel اسم_المعالج + 8], ecx

    ; ── الورقة 1: الميزات الأساسية ──
    mov eax, 1
    cpuid
    mov [rel ميزات_المعالج], edx          ; EDX ميزات
    mov [rel ميزات_المعالج + 4], ecx      ; ECX ميزات

    ; استخراج معرف APIC
    shr ebx, 24
    mov [rel معرف_أبيك], bl

    ; ── الورقة الموسعة 0x80000001 ──
    mov eax, 0x80000001
    cpuid
    mov [rel ميزات_موسعة], edx
    mov [rel ميزات_موسعة + 4], ecx

    ; ── الأوراق 0x80000002-4: اسم المعالج الكامل ──
    mov r12d, 0x80000002
.حلقة_الاسم:
    mov eax, r12d
    cpuid
    lea rbx, [rel الاسم_الكامل]
    mov ecx, r12d
    sub ecx, 0x80000002
    shl ecx, 4              ; * 16
    mov [rbx + rcx], eax
    mov [rbx + rcx + 4], ebx
    mov [rbx + rcx + 8], ecx
    mov [rbx + rcx + 12], edx

    inc r12d
    cmp r12d, 0x80000005
    jl .حلقة_الاسم

    pop r12
    pop rbx
    ret

; ══════════════════════════════════════════════════════════════════════════════
; قسم البيانات
; ══════════════════════════════════════════════════════════════════════════════
section .data
align 8
أقصى_ورقة:                  dd 0

section .bss
align 16
نتيجة_معرف:                 resb 16
اسم_المعالج:                resb 16
ميزات_المعالج:              resb 8
ميزات_موسعة:                resb 8
معرف_أبيك:                  resb 1
الاسم_الكامل:               resb 48
