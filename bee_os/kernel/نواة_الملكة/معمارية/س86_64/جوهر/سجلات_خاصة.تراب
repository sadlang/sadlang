; ══════════════════════════════════════════════════════════════════════════════
; سجلات_خاصة.تراب - وصول MSR لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: قراءة وكتابة سجلات MSR (Model Specific Registers)
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; ثوابت عناوين MSR الشائعة
; ──────────────────────────────────────────────────────────────────────────────
MSR_APIC_BASE       equ 0x0000001B
MSR_MTRR_CAP        equ 0x000000FE
MSR_SYSENTER_CS     equ 0x00000174
MSR_SYSENTER_ESP    equ 0x00000175
MSR_SYSENTER_EIP    equ 0x00000176
MSR_PAT             equ 0x00000277
MSR_EFER            equ 0xC0000080
MSR_STAR            equ 0xC0000081
MSR_LSTAR           equ 0xC0000082
MSR_CSTAR           equ 0xC0000083
MSR_FMASK           equ 0xC0000084
MSR_FS_BASE         equ 0xC0000100
MSR_GS_BASE         equ 0xC0000101
MSR_KERNEL_GS_BASE  equ 0xC0000102
MSR_TSC_AUX         equ 0xC0000103

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global قراءة_سجل_خاص
global كتابة_سجل_خاص
global قراءة_عداد_الوقت
global قراءة_عداد_الأداء
global تفعيل_نو_إكسيكيوت

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; قراءة_سجل_خاص - قراءة MSR
; المدخلات: edi = عنوان MSR
; المخرجات: rax = القيمة (64 بت)
; ──────────────────────────────────────────────────────────────────────────────
قراءة_سجل_خاص:
    mov ecx, edi
    rdmsr
    shl rdx, 32
    or rax, rdx
    ret

; ──────────────────────────────────────────────────────────────────────────────
; كتابة_سجل_خاص - كتابة MSR
; المدخلات: edi = عنوان MSR، rsi = القيمة (64 بت)
; ──────────────────────────────────────────────────────────────────────────────
كتابة_سجل_خاص:
    mov ecx, edi
    mov eax, esi
    mov rdx, rsi
    shr rdx, 32
    wrmsr
    ret

; ──────────────────────────────────────────────────────────────────────────────
; قراءة_عداد_الوقت - قراءة TSC
; المخرجات: rax = القيمة (64 بت)
; ──────────────────────────────────────────────────────────────────────────────
قراءة_عداد_الوقت:
    rdtsc
    shl rdx, 32
    or rax, rdx
    ret

; ──────────────────────────────────────────────────────────────────────────────
; قراءة_عداد_الأداء - قراءة TSC مع ترتيب تسلسلي
; المخرجات: rax = القيمة (64 بت)
; ──────────────────────────────────────────────────────────────────────────────
قراءة_عداد_الأداء:
    rdtscp
    shl rdx, 32
    or rax, rdx
    ret

; ──────────────────────────────────────────────────────────────────────────────
; تفعيل_نو_إكسيكيوت - تفعيل NX bit عبر EFER
; ──────────────────────────────────────────────────────────────────────────────
تفعيل_نو_إكسيكيوت:
    mov ecx, MSR_EFER
    rdmsr
    or eax, (1 << 11)       ; NXE bit
    wrmsr
    ret
