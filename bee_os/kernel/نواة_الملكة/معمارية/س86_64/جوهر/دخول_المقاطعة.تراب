; ══════════════════════════════════════════════════════════════════════════════
; دخول_المقاطعة.تراب - دخول المقاطعات الخارجية (IRQ)
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: نقطة دخول المقاطعات الخارجية مع دعم APIC/PIC
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الثوابت
; ──────────────────────────────────────────────────────────────────────────────
PIC_MASTER_CMD      equ 0x20
PIC_MASTER_DATA     equ 0x21
PIC_SLAVE_CMD       equ 0xA0
PIC_SLAVE_DATA      equ 0xA1
PIC_EOI             equ 0x20

APIC_EOI_REG        equ 0xB0       ; إزاحة سجل EOI في APIC

; ──────────────────────────────────────────────────────────────────────────────
; الرموز الخارجية
; ──────────────────────────────────────────────────────────────────────────────
extern معالج_المقاطعة_ص        ; معالج المقاطعات في كود ص

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global تهيئة_بي_آي_سي
global تعطيل_بي_آي_سي
global إرسال_نهاية_مقاطعة
global عنوان_أبيك_المحلي

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; تهيئة_بي_آي_سي - تهيئة PIC 8259 مع إعادة تعيين IRQ
; المدخلات: edi = إزاحة IRQ الرئيسي (عادة 32)
;           esi = إزاحة IRQ الثانوي (عادة 40)
; ──────────────────────────────────────────────────────────────────────────────
تهيئة_بي_آي_سي:
    push rax

    ; ICW1 - بدء التهيئة
    mov al, 0x11
    out PIC_MASTER_CMD, al
    out PIC_SLAVE_CMD, al
    call تأخير_منفذ

    ; ICW2 - إزاحة المتجهات
    mov eax, edi
    out PIC_MASTER_DATA, al
    call تأخير_منفذ
    mov eax, esi
    out PIC_SLAVE_DATA, al
    call تأخير_منفذ

    ; ICW3 - التسلسل
    mov al, 4               ; IRQ2 متصل بالثانوي
    out PIC_MASTER_DATA, al
    call تأخير_منفذ
    mov al, 2               ; هوية التسلسل
    out PIC_SLAVE_DATA, al
    call تأخير_منفذ

    ; ICW4 - وضع 8086
    mov al, 0x01
    out PIC_MASTER_DATA, al
    call تأخير_منفذ
    out PIC_SLAVE_DATA, al
    call تأخير_منفذ

    ; تفريغ كل المقاطعات (كلها مقنعة)
    mov al, 0xFF
    out PIC_MASTER_DATA, al
    out PIC_SLAVE_DATA, al

    pop rax
    ret

; ──────────────────────────────────────────────────────────────────────────────
; تعطيل_بي_آي_سي - تعطيل PIC عند استخدام APIC
; ──────────────────────────────────────────────────────────────────────────────
تعطيل_بي_آي_سي:
    mov al, 0xFF
    out PIC_SLAVE_DATA, al
    out PIC_MASTER_DATA, al
    ret

; ──────────────────────────────────────────────────────────────────────────────
; إرسال_نهاية_مقاطعة - إرسال EOI
; المدخلات: edi = رقم IRQ
; ──────────────────────────────────────────────────────────────────────────────
إرسال_نهاية_مقاطعة:
    ; التحقق من وجود APIC
    mov rax, [rel عنوان_أبيك_المحلي]
    test rax, rax
    jnz .أبيك

    ; EOI عبر PIC
    cmp edi, 8
    jl .رئيسي_فقط
    ; إرسال EOI للثانوي أولاً
    mov al, PIC_EOI
    out PIC_SLAVE_CMD, al
.رئيسي_فقط:
    mov al, PIC_EOI
    out PIC_MASTER_CMD, al
    ret

.أبيك:
    ; EOI عبر APIC
    mov dword [rax + APIC_EOI_REG], 0
    ret

; ──────────────────────────────────────────────────────────────────────────────
; تأخير_منفذ - تأخير قصير بين عمليات المنفذ
; ──────────────────────────────────────────────────────────────────────────────
تأخير_منفذ:
    push rax
    xor eax, eax
    out 0x80, al             ; المنفذ 0x80 للتأخير
    pop rax
    ret

; ══════════════════════════════════════════════════════════════════════════════
; قسم BSS
; ══════════════════════════════════════════════════════════════════════════════
section .bss
align 8
عنوان_أبيك_المحلي:          resq 1
