; ══════════════════════════════════════════════════════════════════════════════
; دخول_النداء.تراب - دخول نداء النظام لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: معالج نداءات النظام (syscall) عبر تعليمة SYSCALL/SYSRET
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الثوابت
; ──────────────────────────────────────────────────────────────────────────────
MSR_STAR            equ 0xC0000081  ; سجل STAR
MSR_LSTAR           equ 0xC0000082  ; عنوان معالج SYSCALL
MSR_FMASK           equ 0xC0000084  ; قناع RFLAGS
MSR_EFER            equ 0xC0000080  ; سجل EFER

SEL_KERNEL_CODE     equ 0x08
SEL_KERNEL_DATA     equ 0x10
SEL_USER_CODE       equ 0x20
SEL_USER_DATA       equ 0x18

EFER_SCE            equ 0x01        ; تفعيل SYSCALL/SYSRET

; أقصى عدد نداءات النظام
MAX_SYSCALLS        equ 256

; ──────────────────────────────────────────────────────────────────────────────
; الرموز الخارجية
; ──────────────────────────────────────────────────────────────────────────────
extern معالج_نداء_النظام      ; معالج نداءات النظام في كود ص
extern جدول_نداءات_النظام     ; جدول مؤشرات نداءات النظام

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global تهيئة_نداء_النظام
global معالج_نداء_النظام_تراب

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; تهيئة_نداء_النظام - إعداد SYSCALL/SYSRET
; ──────────────────────────────────────────────────────────────────────────────
تهيئة_نداء_النظام:
    push rcx
    push rdx
    push rax

    ; تفعيل SCE في EFER
    mov ecx, MSR_EFER
    rdmsr
    or eax, EFER_SCE
    wrmsr

    ; إعداد STAR: محددات القطاعات
    ; [63:48] = SYSRET CS/SS (user), [47:32] = SYSCALL CS/SS (kernel)
    mov ecx, MSR_STAR
    xor eax, eax
    mov edx, (SEL_USER_CODE - 16) << 16 | SEL_KERNEL_CODE
    wrmsr

    ; إعداد LSTAR: عنوان معالج SYSCALL
    mov ecx, MSR_LSTAR
    lea rax, [rel معالج_نداء_النظام_تراب]
    mov rdx, rax
    shr rdx, 32
    wrmsr

    ; إعداد FMASK: أعلام يتم تصفيرها عند SYSCALL
    mov ecx, MSR_FMASK
    mov eax, 0x200          ; تعطيل IF (المقاطعات)
    xor edx, edx
    wrmsr

    pop rax
    pop rdx
    pop rcx
    ret

; ──────────────────────────────────────────────────────────────────────────────
; معالج_نداء_النظام_تراب - نقطة دخول SYSCALL
; عند الدخول (حسب تعليمة SYSCALL):
;   rcx = عنوان الإرجاع (RIP المحفوظ)
;   r11 = RFLAGS المحفوظة
;   rax = رقم نداء النظام
;   rdi, rsi, rdx, r10, r8, r9 = المعاملات
; ──────────────────────────────────────────────────────────────────────────────
معالج_نداء_النظام_تراب:
    ; التبديل إلى GS النواة
    swapgs

    ; حفظ مكدس المستخدم والتبديل إلى مكدس النواة
    mov [rel مكدس_المستخدم_المحفوظ], rsp
    mov rsp, [rel مكدس_النواة_للنداء]

    ; حفظ السجلات
    push rcx                ; RIP المحفوظ
    push r11                ; RFLAGS المحفوظة
    push rbx
    push rbp
    push r12
    push r13
    push r14
    push r15

    ; تحميل قطاعات النواة
    mov cx, SEL_KERNEL_DATA
    mov ds, cx
    mov es, cx

    ; التحقق من صحة رقم النداء
    cmp rax, MAX_SYSCALLS
    jae .نداء_غير_صالح

    ; استدعاء المعالج
    ; r10 يحل محل rcx (لأن SYSCALL يستخدم rcx)
    mov rcx, r10
    call معالج_نداء_النظام

    ; النتيجة في rax
    jmp .إرجاع

.نداء_غير_صالح:
    mov rax, -1             ; ENOSYS

.إرجاع:
    ; استعادة السجلات
    pop r15
    pop r14
    pop r13
    pop r12
    pop rbp
    pop rbx
    pop r11                 ; RFLAGS
    pop rcx                 ; RIP

    ; استعادة مكدس المستخدم
    mov rsp, [rel مكدس_المستخدم_المحفوظ]

    ; العودة إلى GS المستخدم
    swapgs

    ; العودة إلى وضع المستخدم
    o64 sysret

; ══════════════════════════════════════════════════════════════════════════════
; قسم BSS
; ══════════════════════════════════════════════════════════════════════════════
section .bss
align 8
مكدس_المستخدم_المحفوظ:      resq 1
مكدس_النواة_للنداء:          resq 1
