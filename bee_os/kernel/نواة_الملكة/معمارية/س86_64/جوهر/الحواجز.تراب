; ══════════════════════════════════════════════════════════════════════════════
; الحواجز.تراب - حواجز الذاكرة لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: حواجز ترتيب الذاكرة وإدارة المخبأ
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global حاجز_ذاكرة
global حاجز_تخزين
global حاجز_تحميل
global إبطال_صفحة
global إبطال_كل_الصفحات
global تنظيف_سطر_مخبأ
global تنظيف_المخبأ
global تعليمة_توقف
global تعليمة_لا_عملية
global تفعيل_المقاطعات
global تعطيل_المقاطعات
global حفظ_المقاطعات

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; حاجز ذاكرة كامل (قراءة+كتابة)
حاجز_ذاكرة:
    mfence
    ret

; حاجز تخزين (كتابة فقط)
حاجز_تخزين:
    sfence
    ret

; حاجز تحميل (قراءة فقط)
حاجز_تحميل:
    lfence
    ret

; إبطال صفحة من TLB
; المدخلات: rdi = العنوان الافتراضي
إبطال_صفحة:
    invlpg [rdi]
    ret

; إبطال كل الصفحات (إعادة تحميل CR3)
إبطال_كل_الصفحات:
    mov rax, cr3
    mov cr3, rax
    ret

; تنظيف سطر واحد من المخبأ
; المدخلات: rdi = العنوان
تنظيف_سطر_مخبأ:
    clflush [rdi]
    ret

; تنظيف كامل المخبأ
تنظيف_المخبأ:
    wbinvd
    ret

; إيقاف المعالج حتى وصول مقاطعة
تعليمة_توقف:
    hlt
    ret

; لا عملية
تعليمة_لا_عملية:
    nop
    ret

; تفعيل المقاطعات
تفعيل_المقاطعات:
    sti
    ret

; تعطيل المقاطعات
تعطيل_المقاطعات:
    cli
    ret

; حفظ حالة المقاطعات وتعطيلها
; المخرجات: rax = حالة RFLAGS القديمة
حفظ_المقاطعات:
    pushfq
    pop rax
    cli
    ret
