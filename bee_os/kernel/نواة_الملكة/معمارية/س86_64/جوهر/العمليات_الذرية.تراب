; ══════════════════════════════════════════════════════════════════════════════
; العمليات_الذرية.تراب - العمليات الذرية لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: عمليات ذرية (atomic operations) للمزامنة بين المعالجات
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global ذرية_تحميل
global ذرية_تخزين
global ذرية_جمع
global ذرية_طرح
global ذرية_أو
global ذرية_وصل
global ذرية_مقارنة_تبديل
global ذرية_تبديل
global ذرية_زيادة
global ذرية_نقصان
global ذرية_اختبار_تعيين
global ذرية_اختبار_مسح
global قفل_دوراني_أخذ
global قفل_دوراني_إطلاق
global قفل_دوراني_محاولة

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_تحميل - تحميل ذري لقيمة 64 بت
; المدخلات: rdi = مؤشر القيمة
; المخرجات: rax = القيمة
; ──────────────────────────────────────────────────────────────────────────────
ذرية_تحميل:
    mov rax, [rdi]
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_تخزين - تخزين ذري لقيمة 64 بت
; المدخلات: rdi = مؤشر الوجهة، rsi = القيمة
; ──────────────────────────────────────────────────────────────────────────────
ذرية_تخزين:
    mov [rdi], rsi
    mfence
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_جمع - جمع ذري وإرجاع القيمة القديمة
; المدخلات: rdi = مؤشر، rsi = القيمة المضافة
; المخرجات: rax = القيمة القديمة
; ──────────────────────────────────────────────────────────────────────────────
ذرية_جمع:
    mov rax, rsi
    lock xadd [rdi], rax
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_طرح - طرح ذري وإرجاع القيمة القديمة
; المدخلات: rdi = مؤشر، rsi = القيمة المطروحة
; المخرجات: rax = القيمة القديمة
; ──────────────────────────────────────────────────────────────────────────────
ذرية_طرح:
    neg rsi
    mov rax, rsi
    lock xadd [rdi], rax
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_أو - أو ذري
; المدخلات: rdi = مؤشر، rsi = القيمة
; ──────────────────────────────────────────────────────────────────────────────
ذرية_أو:
    lock or [rdi], rsi
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_وصل - و ذري
; المدخلات: rdi = مؤشر، rsi = القيمة
; ──────────────────────────────────────────────────────────────────────────────
ذرية_وصل:
    lock and [rdi], rsi
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_مقارنة_تبديل - CAS (Compare And Swap)
; المدخلات: rdi = مؤشر، rsi = القيمة المتوقعة، rdx = القيمة الجديدة
; المخرجات: rax = القيمة المقروءة (= rsi إذا نجحت)
; ──────────────────────────────────────────────────────────────────────────────
ذرية_مقارنة_تبديل:
    mov rax, rsi
    lock cmpxchg [rdi], rdx
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_تبديل - تبديل ذري
; المدخلات: rdi = مؤشر، rsi = القيمة الجديدة
; المخرجات: rax = القيمة القديمة
; ──────────────────────────────────────────────────────────────────────────────
ذرية_تبديل:
    mov rax, rsi
    xchg [rdi], rax
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_زيادة - زيادة ذرية بواحد
; المدخلات: rdi = مؤشر
; المخرجات: rax = القيمة الجديدة
; ──────────────────────────────────────────────────────────────────────────────
ذرية_زيادة:
    mov rax, 1
    lock xadd [rdi], rax
    inc rax                 ; القيمة الجديدة = القديمة + 1
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_نقصان - نقصان ذري بواحد
; المدخلات: rdi = مؤشر
; المخرجات: rax = القيمة الجديدة
; ──────────────────────────────────────────────────────────────────────────────
ذرية_نقصان:
    mov rax, -1
    lock xadd [rdi], rax
    dec rax
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_اختبار_تعيين - اختبار بت وتعيينه ذرياً
; المدخلات: rdi = مؤشر، rsi = رقم البت
; المخرجات: rax = 1 إذا كان البت معيناً مسبقاً
; ──────────────────────────────────────────────────────────────────────────────
ذرية_اختبار_تعيين:
    xor eax, eax
    lock bts [rdi], rsi
    setc al
    ret

; ──────────────────────────────────────────────────────────────────────────────
; ذرية_اختبار_مسح - اختبار بت ومسحه ذرياً
; المدخلات: rdi = مؤشر، rsi = رقم البت
; المخرجات: rax = 1 إذا كان البت معيناً مسبقاً
; ──────────────────────────────────────────────────────────────────────────────
ذرية_اختبار_مسح:
    xor eax, eax
    lock btr [rdi], rsi
    setc al
    ret

; ══════════════════════════════════════════════════════════════════════════════
; أقفال دورانية (Spinlocks)
; ══════════════════════════════════════════════════════════════════════════════

; ──────────────────────────────────────────────────────────────────────────────
; قفل_دوراني_أخذ - أخذ قفل دوراني (حظر حتى النجاح)
; المدخلات: rdi = مؤشر القفل (0 = حر، 1 = مقفل)
; ──────────────────────────────────────────────────────────────────────────────
قفل_دوراني_أخذ:
.محاولة:
    mov eax, 1
    xchg [rdi], eax
    test eax, eax
    jz .نجاح
.انتظار:
    pause                   ; تلميح للمعالج (توفير طاقة)
    cmp dword [rdi], 0
    jne .انتظار
    jmp .محاولة
.نجاح:
    ret

; ──────────────────────────────────────────────────────────────────────────────
; قفل_دوراني_إطلاق - إطلاق قفل دوراني
; المدخلات: rdi = مؤشر القفل
; ──────────────────────────────────────────────────────────────────────────────
قفل_دوراني_إطلاق:
    mov dword [rdi], 0
    mfence
    ret

; ──────────────────────────────────────────────────────────────────────────────
; قفل_دوراني_محاولة - محاولة أخذ القفل بدون حظر
; المدخلات: rdi = مؤشر القفل
; المخرجات: rax = 1 إذا نجح، 0 إذا فشل
; ──────────────────────────────────────────────────────────────────────────────
قفل_دوراني_محاولة:
    mov eax, 1
    xchg [rdi], eax
    xor eax, 1              ; عكس: 0→1 (نجح)، 1→0 (فشل)
    ret
