; ══════════════════════════════════════════════════════════════════════════════
; سجلات_التحكم.تراب - سجلات التحكم لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: قراءة وكتابة سجلات التحكم CR0-CR4
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; ثوابت بتات التحكم
; ──────────────────────────────────────────────────────────────────────────────
; CR0
CR0_PE      equ (1 << 0)       ; الوضع المحمي
CR0_MP      equ (1 << 1)       ; مراقبة المعالج المساعد
CR0_EM      equ (1 << 2)       ; محاكاة FPU
CR0_TS      equ (1 << 3)       ; تبديل المهمة
CR0_ET      equ (1 << 4)       ; نوع الامتداد
CR0_NE      equ (1 << 5)       ; استثناءات رقمية
CR0_WP      equ (1 << 16)      ; حماية الكتابة
CR0_AM      equ (1 << 18)      ; فحص المحاذاة
CR0_NW      equ (1 << 29)      ; عدم الكتابة المباشرة
CR0_CD      equ (1 << 30)      ; تعطيل المخبأ
CR0_PG      equ (1 << 31)      ; الترحيل

; CR4
CR4_VME     equ (1 << 0)       ; امتدادات الوضع الافتراضي
CR4_PVI     equ (1 << 1)       ; مقاطعات افتراضية
CR4_TSD     equ (1 << 2)       ; عد الوقت تعطيل
CR4_DE      equ (1 << 3)       ; امتدادات التنقيح
CR4_PSE     equ (1 << 4)       ; امتداد حجم الصفحة
CR4_PAE     equ (1 << 5)       ; امتداد العناوين الفعلية
CR4_MCE     equ (1 << 6)       ; فحص الآلة
CR4_PGE     equ (1 << 7)       ; صفحات عامة
CR4_OSFXSR  equ (1 << 9)       ; دعم FXSAVE/FXRSTOR
CR4_OSXMMEX equ (1 << 10)      ; استثناءات SIMD
CR4_UMIP    equ (1 << 11)      ; حماية تعليمات المستخدم
CR4_OSXSAVE equ (1 << 18)      ; دعم XSAVE
CR4_SMEP    equ (1 << 20)      ; حماية تنفيذ المشرف
CR4_SMAP    equ (1 << 21)      ; حماية وصول المشرف

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global قراءة_تحكم_0
global كتابة_تحكم_0
global قراءة_تحكم_2
global قراءة_تحكم_3
global كتابة_تحكم_3
global قراءة_تحكم_4
global كتابة_تحكم_4
global تفعيل_إس_إس_إي
global تبطيل_مخبأ

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

قراءة_تحكم_0:
    mov rax, cr0
    ret

كتابة_تحكم_0:
    mov cr0, rdi
    ret

قراءة_تحكم_2:
    mov rax, cr2
    ret

قراءة_تحكم_3:
    mov rax, cr3
    ret

كتابة_تحكم_3:
    mov cr3, rdi
    ret

قراءة_تحكم_4:
    mov rax, cr4
    ret

كتابة_تحكم_4:
    mov cr4, rdi
    ret

; ──────────────────────────────────────────────────────────────────────────────
; تفعيل_إس_إس_إي - تفعيل SSE/SSE2 في CR0 و CR4
; ──────────────────────────────────────────────────────────────────────────────
تفعيل_إس_إس_إي:
    ; CR0: مسح EM، تعيين MP
    mov rax, cr0
    and rax, ~CR0_EM
    or rax, CR0_MP
    mov cr0, rax

    ; CR4: تعيين OSFXSR و OSXMMEXCPT
    mov rax, cr4
    or rax, CR4_OSFXSR | CR4_OSXMMEX
    mov cr4, rax
    ret

; ──────────────────────────────────────────────────────────────────────────────
; تبطيل_مخبأ - تعطيل المخبأ مؤقتاً (للتهيئة)
; ──────────────────────────────────────────────────────────────────────────────
تبطيل_مخبأ:
    mov rax, cr0
    or rax, CR0_CD | CR0_NW
    mov cr0, rax
    wbinvd
    ret
