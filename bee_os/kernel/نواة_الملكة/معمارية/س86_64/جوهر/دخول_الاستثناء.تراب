; ══════════════════════════════════════════════════════════════════════════════
; دخول_الاستثناء.تراب - معالج الاستثناءات لنواة خلية النحل
; ══════════════════════════════════════════════════════════════════════════════
; الوصف: معالجة استثناءات المعالج مع طباعة معلومات التشخيص
; المعمارية: x86_64
; ══════════════════════════════════════════════════════════════════════════════

bits 64
default rel

; ──────────────────────────────────────────────────────────────────────────────
; الثوابت
; ──────────────────────────────────────────────────────────────────────────────
SERIAL_PORT         equ 0x3F8

; ──────────────────────────────────────────────────────────────────────────────
; الرموز الخارجية
; ──────────────────────────────────────────────────────────────────────────────
extern معالج_الذعر          ; panic handler in S language

; ──────────────────────────────────────────────────────────────────────────────
; الرموز المصدّرة
; ──────────────────────────────────────────────────────────────────────────────
global معالج_الاستثناء
global ذعر_النواة

; ══════════════════════════════════════════════════════════════════════════════
; قسم النص
; ══════════════════════════════════════════════════════════════════════════════
section .text

; ──────────────────────────────────────────────────────────────────────────────
; معالج_الاستثناء - المعالج المشترك للاستثناءات
; المدخلات:
;   rdi = رقم الاستثناء
;   rsi = كود الخطأ
;   rdx = مؤشر إطار السجلات المحفوظة
; ──────────────────────────────────────────────────────────────────────────────
معالج_الاستثناء:
    push rbx
    push r12
    push r13

    mov r12, rdi            ; حفظ رقم الاستثناء
    mov r13, rsi            ; حفظ كود الخطأ

    ; طباعة ترويسة الخطأ
    lea rdi, [rel رسالة_استثناء]
    call طباعة_تسلسلي

    ; طباعة رقم الاستثناء
    mov rdi, r12
    call طباعة_عدد_تسلسلي

    ; طباعة اسم الاستثناء
    cmp r12, 31
    ja .بدون_اسم
    lea rax, [rel جدول_أسماء_الاستثناءات]
    mov rdi, [rax + r12 * 8]
    test rdi, rdi
    jz .بدون_اسم
    call طباعة_تسلسلي
.بدون_اسم:

    ; طباعة كود الخطأ
    lea rdi, [rel رسالة_كود_خطأ]
    call طباعة_تسلسلي
    mov rdi, r13
    call طباعة_عدد_ست_عشري

    ; ── التعامل مع الاستثناءات القابلة للاستعادة ──
    cmp r12, 14             ; خطأ صفحة
    je .خطأ_صفحة

    ; الاستثناءات القاتلة
    cmp r12, 8              ; خطأ مزدوج
    je .قاتل
    cmp r12, 13             ; حماية عامة
    je .قاتل
    cmp r12, 18             ; فحص الآلة
    je .قاتل

    ; استثناءات أخرى - محاولة الاستمرار
    pop r13
    pop r12
    pop rbx
    ret

.خطأ_صفحة:
    ; طباعة عنوان CR2
    lea rdi, [rel رسالة_عنوان_خطأ]
    call طباعة_تسلسلي
    mov rax, cr2
    mov rdi, rax
    call طباعة_عدد_ست_عشري

    ; استدعاء معالج الذعر
    mov rdi, r12
    mov rsi, r13
    mov rdx, cr2
    call معالج_الذعر
    jmp .توقف

.قاتل:
    lea rdi, [rel رسالة_قاتل]
    call طباعة_تسلسلي

.توقف:
    cli
    hlt
    jmp .توقف

; ──────────────────────────────────────────────────────────────────────────────
; ذعر_النواة - توقف النواة عند خطأ حرج
; المدخلات: rdi = مؤشر رسالة الخطأ
; ──────────────────────────────────────────────────────────────────────────────
ذعر_النواة:
    cli
    lea rsi, [rel رسالة_ذعر]
    xchg rdi, rsi
    call طباعة_تسلسلي
    mov rdi, rsi
    call طباعة_تسلسلي
.توقف_ذعر:
    hlt
    jmp .توقف_ذعر

; ──────────────────────────────────────────────────────────────────────────────
; طباعة_تسلسلي - طباعة سلسلة عبر COM1
; المدخلات: rdi = مؤشر السلسلة
; ──────────────────────────────────────────────────────────────────────────────
طباعة_تسلسلي:
    push rax
    push rdx
    push rsi
    mov rsi, rdi
.حلقة:
    lodsb
    test al, al
    jz .نهاية
    mov dx, SERIAL_PORT + 5
.انتظار:
    in al, dx
    test al, 0x20
    jz .انتظار
    mov al, [rsi - 1]
    mov dx, SERIAL_PORT
    out dx, al
    jmp .حلقة
.نهاية:
    pop rsi
    pop rdx
    pop rax
    ret

; ──────────────────────────────────────────────────────────────────────────────
; طباعة_عدد_ست_عشري - طباعة عدد كـ Hex
; المدخلات: rdi = العدد
; ──────────────────────────────────────────────────────────────────────────────
طباعة_عدد_ست_عشري:
    push rax
    push rcx
    push rdx
    mov rax, rdi
    mov rcx, 16             ; 16 رقم
.حلقة_ست:
    rol rax, 4
    push rax
    and al, 0x0F
    add al, '0'
    cmp al, '9'
    jle .رقم
    add al, 7               ; A-F
.رقم:
    mov dx, SERIAL_PORT + 5
.انتظار2:
    push rax
    in al, dx
    test al, 0x20
    jz .انتظار2
    pop rax
    mov dx, SERIAL_PORT
    out dx, al
    pop rax
    dec rcx
    jnz .حلقة_ست
    pop rdx
    pop rcx
    pop rax
    ret

; طباعة_عدد_تسلسلي - مرادف
طباعة_عدد_تسلسلي:
    jmp طباعة_عدد_ست_عشري

; ══════════════════════════════════════════════════════════════════════════════
; قسم البيانات
; ══════════════════════════════════════════════════════════════════════════════
section .data
align 8

رسالة_استثناء:       db 0x0D, 0x0A, "!!! EXCEPTION #", 0
رسالة_كود_خطأ:       db " err=0x", 0
رسالة_عنوان_خطأ:     db " CR2=0x", 0
رسالة_قاتل:          db " [FATAL - HALT]", 0x0D, 0x0A, 0
رسالة_ذعر:           db 0x0D, 0x0A, "KERNEL PANIC: ", 0

جدول_أسماء_الاستثناءات:
    dq اسم_0, اسم_1, اسم_2, اسم_3
    dq اسم_4, اسم_5, اسم_6, اسم_7
    dq اسم_8, 0, اسم_10, اسم_11
    dq اسم_12, اسم_13, اسم_14, 0
    dq اسم_16, اسم_17, اسم_18, اسم_19
    dq 0, 0, 0, 0
    dq 0, 0, 0, 0
    dq 0, 0, 0, 0

اسم_0:  db " (Divide by Zero)", 0
اسم_1:  db " (Debug)", 0
اسم_2:  db " (NMI)", 0
اسم_3:  db " (Breakpoint)", 0
اسم_4:  db " (Overflow)", 0
اسم_5:  db " (Bound Range)", 0
اسم_6:  db " (Invalid Opcode)", 0
اسم_7:  db " (Device N/A)", 0
اسم_8:  db " (Double Fault)", 0
اسم_10: db " (Invalid TSS)", 0
اسم_11: db " (Segment N/P)", 0
اسم_12: db " (Stack Fault)", 0
اسم_13: db " (Gen. Protection)", 0
اسم_14: db " (Page Fault)", 0
اسم_16: db " (x87 FP)", 0
اسم_17: db " (Alignment)", 0
اسم_18: db " (Machine Check)", 0
اسم_19: db " (SIMD FP)", 0
