/* ══════════════════════════════════════════════════════════════════════════════
 * سيناريو الربط - نظام خلية النحل
 * ══════════════════════════════════════════════════════════════════════════════
 * الوصف: سكربت الرابط لنواة الملكة (x86_64)
 * المعمارية: x86_64 - وضع طويل (Long Mode)
 * الإقلاع: بروتوكول Limine
 * ══════════════════════════════════════════════════════════════════════════════
 */

/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 1: تنسيق الخرج والدخول
 * ─────────────────────────────────────────────────────────────────────────────
 */
OUTPUT_FORMAT(elf64-x86-64)
OUTPUT_ARCH(i386:x86-64)
ENTRY(_start)

/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 2: ثوابت العناوين
 * ─────────────────────────────────────────────────────────────────────────────
 */

/* عنوان النواة العلوي - الميغابايتين العلويين من الذاكرة الافتراضية */
KERNEL_VMA = 0xFFFFFFFF80000000;

/* عنوان التحميل الفعلي - فوق الميغابايت الأول */
KERNEL_LMA = 0x100000;

/* محاذاة الصفحات */
PAGE_SIZE = 0x1000;

/* حجم المكدس الافتراضي */
STACK_SIZE = 0x4000;       /* 16 كيلوبايت */

/* حجم الكومة الأولية */
HEAP_SIZE = 0x100000;      /* 1 ميغابايت */

/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 3: تعريف الأقسام
 * ─────────────────────────────────────────────────────────────────────────────
 */
SECTIONS
{
    /* ════════════════════════════════════════════════════════════════════════
     * قسم ما قبل النواة - عنوان فعلي منخفض
     * ════════════════════════════════════════════════════════════════════════
     */

    /* بداية ترويسة Limine - يجب أن تكون في بداية الملف */
    . = KERNEL_LMA;

    /* ────────────────────────────────────────────────────────────────────────
     * .limine_reqs: طلبات بروتوكول Limine
     * ────────────────────────────────────────────────────────────────────────
     */
    .limine_reqs : AT(ADDR(.limine_reqs))
    {
        KEEP(*(.limine_reqs))
        KEEP(*(.limine_reqs.*))
    }

    /* ════════════════════════════════════════════════════════════════════════
     * النواة الرئيسية - فضاء العناوين العلوي
     * ════════════════════════════════════════════════════════════════════════
     */

    . = KERNEL_VMA;

    /* حفظ عنوان بداية النواة */
    __kernel_start = .;

    /* ────────────────────────────────────────────────────────────────────────
     * .text: شفرة النواة القابلة للتنفيذ
     * ────────────────────────────────────────────────────────────────────────
     */
    .text ALIGN(PAGE_SIZE) : AT(ADDR(.text) - KERNEL_VMA + KERNEL_LMA)
    {
        __text_start = .;

        /* نقطة الدخول أولاً */
        *(.text.boot)
        *(.text.entry)
        *(.text._start)

        /* شفرة النواة الأساسية */
        *(.text)
        *(.text.*)

        /* جداول التعامل مع الاستثناءات */
        *(.text.isr*)
        *(.text.irq*)
        *(.text.syscall*)

        /* دوال المكتبة المدمجة */
        *(.text.builtin*)
        *(.text.runtime*)

        __text_end = .;
    }

    /* حجم قسم النص */
    __text_size = __text_end - __text_start;

    /* ────────────────────────────────────────────────────────────────────────
     * .rodata: البيانات للقراءة فقط
     * ────────────────────────────────────────────────────────────────────────
     */
    .rodata ALIGN(PAGE_SIZE) : AT(ADDR(.rodata) - KERNEL_VMA + KERNEL_LMA)
    {
        __rodata_start = .;

        /* سلاسل نصية ثابتة */
        *(.rodata)
        *(.rodata.*)
        *(.rodata.str*)

        /* جداول ثابتة */
        *(.rodata.tables)
        *(.rodata.gdt)
        *(.rodata.idt)

        /* بيانات الأنواع للنظام الشرعي */
        *(.rodata.sharia)
        *(.rodata.halal)

        /* رسائل الأخطاء */
        *(.rodata.errors)
        *(.rodata.messages)

        /* معلومات النواة */
        *(.rodata.version)
        *(.rodata.buildinfo)

        __rodata_end = .;
    }

    __rodata_size = __rodata_end - __rodata_start;

    /* ────────────────────────────────────────────────────────────────────────
     * .data: البيانات المُهيَّأة
     * ────────────────────────────────────────────────────────────────────────
     */
    .data ALIGN(PAGE_SIZE) : AT(ADDR(.data) - KERNEL_VMA + KERNEL_LMA)
    {
        __data_start = .;

        *(.data)
        *(.data.*)

        /* جداول GDT و IDT المعدلة في وقت التشغيل */
        *(.data.gdt)
        *(.data.idt)
        *(.data.tss)

        /* جداول صفحات أولية */
        . = ALIGN(PAGE_SIZE);
        __page_tables_start = .;
        *(.data.page_tables)
        *(.data.pml4)
        *(.data.pdpt)
        *(.data.pd)
        *(.data.pt)
        __page_tables_end = .;

        /* البناة والمهدمة العامة */
        . = ALIGN(8);
        __init_array_start = .;
        KEEP(*(.init_array))
        KEEP(*(.init_array.*))
        __init_array_end = .;

        . = ALIGN(8);
        __fini_array_start = .;
        KEEP(*(.fini_array))
        KEEP(*(.fini_array.*))
        __fini_array_end = .;

        /* متغيرات لكل معالج */
        . = ALIGN(PAGE_SIZE);
        __percpu_start = .;
        *(.data.percpu)
        *(.data.percpu.*)
        __percpu_end = .;

        __data_end = .;
    }

    __data_size = __data_end - __data_start;

    /* ────────────────────────────────────────────────────────────────────────
     * .bss: البيانات غير المُهيَّأة (تُصفَّر عند الإقلاع)
     * ────────────────────────────────────────────────────────────────────────
     */
    .bss ALIGN(PAGE_SIZE) : AT(ADDR(.bss) - KERNEL_VMA + KERNEL_LMA)
    {
        __bss_start = .;

        *(.bss)
        *(.bss.*)
        *(COMMON)

        /* مكدس الإقلاع */
        . = ALIGN(PAGE_SIZE);
        __boot_stack_bottom = .;
        . += STACK_SIZE;
        __boot_stack_top = .;

        /* مكدسات المقاطعات */
        . = ALIGN(PAGE_SIZE);
        __ist_stack_bottom = .;
        . += STACK_SIZE;
        __ist_stack_top = .;

        /* مكدس Double Fault */
        . = ALIGN(PAGE_SIZE);
        __df_stack_bottom = .;
        . += STACK_SIZE;
        __df_stack_top = .;

        /* الكومة الأولية */
        . = ALIGN(PAGE_SIZE);
        __heap_start = .;
        . += HEAP_SIZE;
        __heap_end = .;

        /* مخازن مؤقتة للإقلاع */
        . = ALIGN(PAGE_SIZE);
        __boot_buffer_start = .;
        . += 0x10000;  /* 64 كيلوبايت */
        __boot_buffer_end = .;

        __bss_end = .;
    }

    __bss_size = __bss_end - __bss_start;

    /* ────────────────────────────────────────────────────────────────────────
     * معلومات النواة (محفوظة)
     * ────────────────────────────────────────────────────────────────────────
     */
    . = ALIGN(PAGE_SIZE);
    __kernel_end = .;
    __kernel_size = __kernel_end - __kernel_start;

    /* ────────────────────────────────────────────────────────────────────────
     * معلومات التحميل الفعلي
     * ────────────────────────────────────────────────────────────────────────
     */
    __kernel_phys_start = __kernel_start - KERNEL_VMA + KERNEL_LMA;
    __kernel_phys_end = __kernel_end - KERNEL_VMA + KERNEL_LMA;
    __kernel_phys_size = __kernel_phys_end - __kernel_phys_start;

    /* ────────────────────────────────────────────────────────────────────────
     * أقسام التنقيح (تُحذف في الإصدار)
     * ────────────────────────────────────────────────────────────────────────
     */
    .debug_info     0 : { *(.debug_info)     }
    .debug_abbrev   0 : { *(.debug_abbrev)   }
    .debug_line     0 : { *(.debug_line)     }
    .debug_str      0 : { *(.debug_str)      }
    .debug_ranges   0 : { *(.debug_ranges)   }
    .debug_loc      0 : { *(.debug_loc)      }
    .debug_frame    0 : { *(.debug_frame)    }
    .debug_aranges  0 : { *(.debug_aranges)  }

    /* ────────────────────────────────────────────────────────────────────────
     * أقسام مرفوضة
     * ────────────────────────────────────────────────────────────────────────
     */
    /DISCARD/ :
    {
        *(.comment)
        *(.comment.*)
        *(.note)
        *(.note.*)
        *(.eh_frame)
        *(.eh_frame_hdr)
        *(.gnu.hash)
        *(.dynsym)
        *(.dynstr)
        *(.dynamic)
        *(.plt)
        *(.plt.*)
        *(.got)
        *(.got.*)
        *(.interp)
    }
}

/* ─────────────────────────────────────────────────────────────────────────────
 * القسم 4: تأكيدات
 * ─────────────────────────────────────────────────────────────────────────────
 */

/* التحقق من محاذاة الأقسام */
ASSERT(__text_start % PAGE_SIZE == 0, "قسم النص غير محاذٍ للصفحة!")
ASSERT(__rodata_start % PAGE_SIZE == 0, "قسم البيانات الثابتة غير محاذٍ!")
ASSERT(__data_start % PAGE_SIZE == 0, "قسم البيانات غير محاذٍ!")
ASSERT(__bss_start % PAGE_SIZE == 0, "قسم BSS غير محاذٍ!")

/* التحقق من حجم النواة */
ASSERT(__kernel_size < 0x1000000, "حجم النواة يتجاوز 16 ميغابايت!")

/* التحقق من وجود نقطة الدخول */
ASSERT(DEFINED(_start), "نقطة الدخول _start غير معرفة!")

