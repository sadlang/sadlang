# ══════════════════════════════════════════════════════════════════════════════
# مدير_لوحة_المفاتيح.ص - نظام إدارة لوحة المفاتيح لنظام خلية النحل
# BeeOS Keyboard Manager - PS/2 Keyboard Driver + Arabic Support
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# ثوابت المفاتيح الخاصة
# ─────────────────────────────────────────────────────────────────────
متغير مفتاح_ESC       = 27
متغير مفتاح_ENTER     = 13
متغير مفتاح_TAB       = 9
متغير مفتاح_DELETE    = 127
متغير مفتاح_BACKSPACE = 8
متغير مفتاح_SPACE     = 32

# المفاتيح المعدلة (modifiers)
متغير مفتاح_SHIFT     = 256
متغير مفتاح_CTRL      = 257
متغير مفتاح_ALT       = 258
متغير مفتاح_CAPS      = 259

# مفاتيح الأسهم
متغير مفتاح_أعلى      = 300
متغير مفتاح_أسفل      = 301
متغير مفتاح_يسار      = 302
متغير مفتاح_يمين      = 303

# مفاتيح F1-F12
متغير مفتاح_F1  = 400
متغير مفتاح_F2  = 401
متغير مفتاح_F3  = 402
متغير مفتاح_F4  = 403
متغير مفتاح_F5  = 404
متغير مفتاح_F6  = 405
متغير مفتاح_F7  = 406
متغير مفتاح_F8  = 407
متغير مفتاح_F9  = 408
متغير مفتاح_F10 = 409
متغير مفتاح_F11 = 410
متغير مفتاح_F12 = 411

# ─────────────────────────────────────────────────────────────────────
# أنواع أحداث لوحة المفاتيح
# ─────────────────────────────────────────────────────────────────────
متغير حدث_مفتاح_ضغط     = 1
متغير حدث_مفتاح_إفلات   = 2
متغير حدث_حرف            = 3

# ─────────────────────────────────────────────────────────────────────
# صنف حدث لوحة المفاتيح
# ─────────────────────────────────────────────────────────────────────
صنف حدث_مفتاح
    رقم نوع_حدث
    رقم رمز_المفتاح
    نص حرف_الناتج
    منطقي شيفت
    منطقي كنترول
    منطقي ألت

    باني(ح_نوع، ح_رمز، ح_حرف، ح_شيفت، ح_كنترول، ح_ألت)
        هذا.نوع_حدث = ح_نوع
        هذا.رمز_المفتاح = ح_رمز
        هذا.حرف_الناتج = ح_حرف
        هذا.شيفت = ح_شيفت
        هذا.كنترول = ح_كنترول
        هذا.ألت = ح_ألت
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────
# صنف مدير لوحة المفاتيح
# ─────────────────────────────────────────────────────────────────────
صنف مدير_لوحة_المفاتيح
    منطقي شيفت_مضغوط
    منطقي كنترول_مضغوط
    منطقي ألت_مضغوط
    منطقي كابس_مفعل
    رقم تخطيط_حالي
    رقم عدد_الأحداث
    نص نص_المخزن
    منطقي مفعل

    باني()
        هذا.شيفت_مضغوط = خطأ
        هذا.كنترول_مضغوط = خطأ
        هذا.ألت_مضغوط = خطأ
        هذا.كابس_مفعل = خطأ
        هذا.تخطيط_حالي = 0
        هذا.عدد_الأحداث = 0
        هذا.نص_المخزن = ""
        هذا.مفعل = صحيح

        اطبع_سطر("  [لوحة المفاتيح] تم التهيئة - تخطيط: لاتيني + عربي")
    نهاية

    # ════════════════════════════════════════════════════════════════
    # معالجة مفتاح خام (scancode)
    # ════════════════════════════════════════════════════════════════

    دالة معالجة_scancode(رمز_خام)
        اذا (هذا.مفعل == خطأ)
            ارجع 0
        نهاية

        هذا.عدد_الأحداث = هذا.عدد_الأحداث + 1

        # كشف key-up (bit 7 = 1 → scancode >= 128)
        متغير key_up = رمز_خام >= 128
        متغير scan = رمز_خام
        اذا (key_up)
            scan = رمز_خام - 128
        نهاية

        # معالجة المفاتيح المعدلة
        اذا (scan == 42 || scan == 54)
            هذا.شيفت_مضغوط = !key_up
            ارجع مفتاح_SHIFT
        نهاية
        اذا (scan == 29)
            هذا.كنترول_مضغوط = !key_up
            ارجع مفتاح_CTRL
        نهاية
        اذا (scan == 56)
            هذا.ألت_مضغوط = !key_up
            ارجع مفتاح_ALT
        نهاية
        اذا (scan == 58 && !key_up)
            هذا.كابس_مفعل = !هذا.كابس_مفعل
            ارجع مفتاح_CAPS
        نهاية

        # فقط عند الضغط
        اذا (key_up)
            ارجع 0
        نهاية

        # ترجمة scancode للحرف
        ارجع ترجم_scancode(scan)
    نهاية

    دالة ترجم_scancode(scan)
        # جدول scancode → ASCII (تخطيط US QWERTY)
        اذا (scan == 1)
            ارجع مفتاح_ESC
        نهاية
        اذا (scan == 14)
            ارجع مفتاح_BACKSPACE
        نهاية
        اذا (scan == 15)
            ارجع مفتاح_TAB
        نهاية
        اذا (scan == 28)
            ارجع مفتاح_ENTER
        نهاية
        اذا (scan == 57)
            ارجع مفتاح_SPACE
        نهاية

        # أرقام (2-11 → '1'-'0')
        اذا (scan >= 2 && scan <= 11)
            متغير رقم_حرف = scan - 2
            اذا (رقم_حرف == 9)
                ارجع 48
            نهاية
            ارجع 49 + رقم_حرف
        نهاية

        # أحرف (16-25 = qwertyuiop، 30-38 = asdfghjkl، 44-50 = zxcvbnm)
        # صف أول
        اذا (scan == 16)
            ارجع 113
        نهاية
        اذا (scan == 17)
            ارجع 119
        نهاية
        اذا (scan == 18)
            ارجع 101
        نهاية
        اذا (scan == 19)
            ارجع 114
        نهاية
        اذا (scan == 20)
            ارجع 116
        نهاية
        اذا (scan == 21)
            ارجع 121
        نهاية
        اذا (scan == 22)
            ارجع 117
        نهاية
        اذا (scan == 23)
            ارجع 105
        نهاية
        اذا (scan == 24)
            ارجع 111
        نهاية
        اذا (scan == 25)
            ارجع 112
        نهاية

        # صف ثاني
        اذا (scan == 30)
            ارجع 97
        نهاية
        اذا (scan == 31)
            ارجع 115
        نهاية
        اذا (scan == 32)
            ارجع 100
        نهاية
        اذا (scan == 33)
            ارجع 102
        نهاية
        اذا (scan == 34)
            ارجع 103
        نهاية
        اذا (scan == 35)
            ارجع 104
        نهاية
        اذا (scan == 36)
            ارجع 106
        نهاية
        اذا (scan == 37)
            ارجع 107
        نهاية
        اذا (scan == 38)
            ارجع 108
        نهاية

        # صف ثالث
        اذا (scan == 44)
            ارجع 122
        نهاية
        اذا (scan == 45)
            ارجع 120
        نهاية
        اذا (scan == 46)
            ارجع 99
        نهاية
        اذا (scan == 47)
            ارجع 118
        نهاية
        اذا (scan == 48)
            ارجع 98
        نهاية
        اذا (scan == 49)
            ارجع 110
        نهاية
        اذا (scan == 50)
            ارجع 109
        نهاية

        # أسهم
        اذا (scan == 72)
            ارجع مفتاح_أعلى
        نهاية
        اذا (scan == 80)
            ارجع مفتاح_أسفل
        نهاية
        اذا (scan == 75)
            ارجع مفتاح_يسار
        نهاية
        اذا (scan == 77)
            ارجع مفتاح_يمين
        نهاية

        # F1-F12
        اذا (scan >= 59 && scan <= 68)
            ارجع مفتاح_F1 + scan - 59
        نهاية
        اذا (scan == 87)
            ارجع مفتاح_F11
        نهاية
        اذا (scan == 88)
            ارجع مفتاح_F12
        نهاية

        ارجع 0
    نهاية

    # ════════════════════════════════════════════════════════════════
    # تبديل التخطيط (Alt+Shift)
    # ════════════════════════════════════════════════════════════════

    دالة تبديل_تخطيط()
        اذا (هذا.تخطيط_حالي == 0)
            هذا.تخطيط_حالي = 1
            اطبع_سطر("  [لوحة المفاتيح] تخطيط: عربي")
        والا
            هذا.تخطيط_حالي = 0
            اطبع_سطر("  [لوحة المفاتيح] تخطيط: لاتيني")
        نهاية
    نهاية

    # ════════════════════════════════════════════════════════════════
    # إحصاءات
    # ════════════════════════════════════════════════════════════════

    دالة إحصاءات_لوحة()
        اطبع_سطر("  --- إحصاءات لوحة المفاتيح ---")
        اطبع("  أحداث: ")
        اطبع_سطر(هذا.عدد_الأحداث)
        اطبع("  Shift: ")
        اطبع_سطر(هذا.شيفت_مضغوط)
        اطبع("  Ctrl: ")
        اطبع_سطر(هذا.كنترول_مضغوط)
        اطبع("  Alt: ")
        اطبع_سطر(هذا.ألت_مضغوط)
        اطبع("  CapsLock: ")
        اطبع_سطر(هذا.كابس_مفعل)
        اطبع("  تخطيط: ")
        اذا (هذا.تخطيط_حالي == 0)
            اطبع_سطر("لاتيني")
        والا
            اطبع_سطر("عربي")
        نهاية
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────
# اختبار
# ─────────────────────────────────────────────────────────────────────
دالة رئيسية()
    اطبع_سطر("=== اختبار مدير لوحة المفاتيح ===")
    اطبع_سطر("")

    متغير لوحة = جديد مدير_لوحة_المفاتيح()
    اطبع_سطر("")

    # محاكاة ضغط مفاتيح (scancode)
    اطبع_سطر("-- محاكاة ضغط مفاتيح --")

    # ضغط 'a' (scancode 30)
    متغير ن1 = لوحة.معالجة_scancode(30)
    اطبع("  scancode 30 (a): رمز = ")
    اطبع_سطر(ن1)

    # ضغط 'b' (scancode 48)
    متغير ن2 = لوحة.معالجة_scancode(48)
    اطبع("  scancode 48 (b): رمز = ")
    اطبع_سطر(ن2)

    # ضغط Enter (scancode 28)
    متغير ن3 = لوحة.معالجة_scancode(28)
    اطبع("  scancode 28 (Enter): رمز = ")
    اطبع_سطر(ن3)

    # ضغط ESC (scancode 1)
    متغير ن4 = لوحة.معالجة_scancode(1)
    اطبع("  scancode 1 (ESC): رمز = ")
    اطبع_سطر(ن4)

    # ضغط Shift (scancode 42)
    اطبع_سطر("")
    اطبع_سطر("-- اختبار المعدلات --")
    لوحة.معالجة_scancode(42)
    اطبع("  Shift مضغوط: ")
    اطبع_سطر(لوحة.شيفت_مضغوط)

    لوحة.معالجة_scancode(170)
    اطبع("  Shift أُفلت: ")
    اطبع_سطر(لوحة.شيفت_مضغوط)

    # ضغط CapsLock
    لوحة.معالجة_scancode(58)
    اطبع("  CapsLock: ")
    اطبع_سطر(لوحة.كابس_مفعل)

    # أسهم
    اطبع_سطر("")
    اطبع_سطر("-- اختبار الأسهم --")
    متغير سهم = لوحة.معالجة_scancode(72)
    اطبع("  سهم أعلى (72): ")
    اطبع_سطر(سهم)

    سهم = لوحة.معالجة_scancode(77)
    اطبع("  سهم يمين (77): ")
    اطبع_سطر(سهم)

    # تبديل التخطيط
    اطبع_سطر("")
    لوحة.تبديل_تخطيط()
    لوحة.تبديل_تخطيط()

    # إحصاءات
    اطبع_سطر("")
    لوحة.إحصاءات_لوحة()

    اطبع_سطر("")
    اطبع_سطر("=== مدير لوحة المفاتيح يعمل بنجاح! ===")
    ارجع 0
نهاية
