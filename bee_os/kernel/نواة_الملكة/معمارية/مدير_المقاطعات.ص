# مدير_المقاطعات.ص - نظام إدارة المقاطعات لنواة نظام النحلة
# ══════════════════════════════════════════════════════════════════════════════
#
# الوصف التفصيلي:
# ════════════════
# هذا الملف يُوفّر واجهة ص عالية المستوى لإدارة المقاطعات.
# يجمع بين:
# 1. Wrapper لتجميعات IDT/GDT الموجودة في assembly
# 2. جدول معالجات المقاطعات بالعربية
# 3. نظام تسجيل معالجات مخصصة (IRQ hooks)
# 4. إحصاءات وتتبع المقاطعات
#
# أنواع المقاطعات:
# ━━━━━━━━━━━━━━━
# - الاستثناءات (Exceptions) 0-31: أخطاء المعالج
# - IRQ0-IRQ15 (32-47): الأجهزة الخارجية
# - System Calls (0x80): طلبات من التطبيقات
#
# المؤلف: فريق نظام خلية النحل
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ثوابت الاستثناءات والمقاطعات
# ─────────────────────────────────────────────────────────────────────────────

# استثناءات المعالج (Intel x86_64)
ثابت استثناء_قسمة_على_صفر    = 0    # Division by Zero
ثابت استثناء_نقطة_توقف       = 3    # Breakpoint (DEBUG)
ثابت استثناء_تجاوز_حد        = 4    # Overflow
ثابت استثناء_نطاق_محدد       = 5    # Bound Range Exceeded
ثابت استثناء_كود_خاطئ        = 6    # Invalid Opcode
ثابت استثناء_جهاز_غير_متاح   = 7    # Device Not Available (FPU)
ثابت استثناء_خطأ_مزدوج       = 8    # Double Fault (حرج!)
ثابت استثناء_خطأ_مقطع        = 11   # Segment Not Present
ثابت استثناء_مكدس_خاطئ       = 12   # Stack Fault
ثابت استثناء_حماية_عامة      = 13   # General Protection Fault (شائع!)
ثابت استثناء_خطأ_صفحة        = 14   # Page Fault (الأكثر شيوعاً!)
ثابت استثناء_خطأ_حساب         = 16   # x87 FPU Error
ثابت استثناء_محاذاة_خاطئة    = 17   # Alignment Check
ثابت استثناء_آلة_تدقيق       = 18   # Machine Check
ثابت استثناء_كسر_نافذة_SIMD  = 19   # SIMD FP Exception

# مقاطعات الأجهزة (IRQ) - تبدأ من 32 بعد PIC إعادة التعيين
ثابت irq_مؤقت_PIT      = 32   # IRQ0 - المؤقت (1000/s الافتراضي)
ثابت irq_لوحة_مفاتيح   = 33   # IRQ1 - PS/2 لوحة المفاتيح
ثابت irq_شلال          = 34   # IRQ2 - منسدل الـ IRQ الثانوي
ثابت irq_منفذ_COM2     = 35   # IRQ3 - منفذ تسلسلي 2
ثابت irq_منفذ_COM1     = 36   # IRQ4 - منفذ تسلسلي 1
ثابت irq_فأرة_PS2      = 44   # IRQ12 - PS/2 الفأرة
ثابت irq_قرص_أول_IDE   = 46   # IRQ14 - محرك الأقراص الأول
ثابت irq_قرص_ثان_IDE   = 47   # IRQ15 - محرك الأقراص الثاني

# مقاطعة استدعاءات النظام
ثابت مقاطعة_نداء_النظام = 128  # 0x80 - مثل Linux

# ─────────────────────────────────────────────────────────────────────────────
# صنف إحصاءات_المقاطعات
# ─────────────────────────────────────────────────────────────────────────────
صنف إحصاءات_المقاطعات
    ## الوصف: تتبع وإحصاء المقاطعات لأغراض تشخيصية

    رقم إجمالي_المقاطعات     # مجموع المقاطعات منذ الإقلاع
    رقم مقاطعات_متجاهلة      # مقاطعات بلا معالج
    رقم خطأ_الصفحة_عدد       # عدد أخطاء الصفحة
    رقم خطأ_حماية_عدد        # عدد أخطاء الحماية
    رقم ضربات_المؤقت          # عدد ضربات PIT
    رقم أحداث_لوحة_المفاتيح   # عدد أحداث لوحة المفاتيح
    رقم أحداث_الفأرة           # عدد أحداث الفأرة

    باني()
        إجمالي_المقاطعات = 0
        مقاطعات_متجاهلة = 0
        خطأ_الصفحة_عدد = 0
        خطأ_حماية_عدد = 0
        ضربات_المؤقت = 0
        أحداث_لوحة_المفاتيح = 0
        أحداث_الفأرة = 0
    نهاية

    ## طباعة إحصاءات مفصّلة
    دالة اطبع_إحصاءات()
        اطبع_سطر("═══════════════════════════════════")
        اطبع_سطر("  📊 إحصاءات المقاطعات")
        اطبع_سطر("═══════════════════════════════════")
        اطبع("  إجمالي المقاطعات:   ") اطبع_سطر(إجمالي_المقاطعات)
        اطبع("  ضربات المؤقت:       ") اطبع_سطر(ضربات_المؤقت)
        اطبع("  لوحة المفاتيح:      ") اطبع_سطر(أحداث_لوحة_المفاتيح)
        اطبع("  الفأرة:             ") اطبع_سطر(أحداث_الفأرة)
        اطبع("  أخطاء الصفحة:      ") اطبع_سطر(خطأ_الصفحة_عدد)
        اطبع("  أخطاء الحماية:     ") اطبع_سطر(خطأ_حماية_عدد)
        اطبع("  متجاهلة:           ") اطبع_سطر(مقاطعات_متجاهلة)
        اطبع_سطر("═══════════════════════════════════")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف مدير_المقاطعات الرئيسي
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_المقاطعات
    ## الوصف: يُدير جميع المقاطعات والاستثناءات في نواة نظام النحلة

    منطقي معالجات_مُسجَّلة    # هل تم تسجيل المعالجات؟
    منطقي مفعّلة              # هل المقاطعات مفعّلة؟
    رقم إجمالي_مق             # إجمالي المقاطعات
    رقم متجاهلة_مق            # مقاطعات متجاهلة
    رقم خطأ_صفحة_مق           # أخطاء الصفحة
    رقم خطأ_حماية_مق          # أخطاء الحماية
    رقم ضربات_مؤقت_مق         # ضربات المؤقت
    رقم أحداث_كيبورد_مق       # أحداث لوحة المفاتيح
    رقم أحداث_فأرة_مق         # أحداث الفأرة

    باني()
        معالجات_مُسجَّلة = خطأ
        مفعّلة = خطأ
        إجمالي_مق = 0
        متجاهلة_مق = 0
        خطأ_صفحة_مق = 0
        خطأ_حماية_مق = 0
        ضربات_مؤقت_مق = 0
        أحداث_كيبورد_مق = 0
        أحداث_فأرة_مق = 0
    نهاية

    ## تهيئة نظام المقاطعات الكاملة
    دالة تهيئة()
        اطبع("    إعادة تعيين PIC...")
        إعادة_تعيين_PIC()

        اطبع("    تسجيل معالجات الاستثناءات...")
        تسجيل_معالجات_الاستثناءات()

        اطبع("    تسجيل معالجات IRQ...")
        تسجيل_معالجات_IRQ()

        اطبع("    إعداد PIT للجدولة...")
        إعداد_PIT(1000)  # 1000 Hz = 1ms

        # تفعيل المقاطعات
        # تجميع {
        #     sti
        # }
        مفعّلة = صحيح
        معالجات_مُسجَّلة = صحيح
        اطبع_سطر("    ✅ نظام المقاطعات جاهز")
    نهاية

    ## إعادة تعيين PIC (8259A) لتجنب تعارض IRQ مع Exceptions
    دالة إعادة_تعيين_PIC()
        # PIC الأساسي (Master): منافذ 0x20 و 0x21
        # PIC الثانوي (Slave): منافذ 0xA0 و 0xA1
        # إعادة التعيين: رفع IRQ0-7 إلى 32-39 وIRQ8-15 إلى 40-47

        # تجميع {
        #     ; ICW1: بدء التهيئة
        #     mov al, 0x11
        #     out 0x20, al    ; PIC أساسي
        #     out 0xA0, al    ; PIC ثانوي
        #
        #     ; ICW2: عناوين المقاطعات
        #     mov al, 0x20    ; IRQ0-7 → 32-39
        #     out 0x21, al
        #     mov al, 0x28    ; IRQ8-15 → 40-47
        #     out 0xA1, al
        #
        #     ; ICW3: التوصيل بين الـPICs
        #     mov al, 0x04
        #     out 0x21, al    ; Master: IRQ2 للشلال
        #     mov al, 0x02
        #     out 0xA1, al    ; Slave: وصّله عبر IRQ2
        #
        #     ; ICW4: وضع 80x86
        #     mov al, 0x01
        #     out 0x21, al
        #     out 0xA1, al
        #
        #     ; إخفاء جميع المقاطعات مؤقتاً
        #     mov al, 0xFE    ; فقط IRQ0 (PIT) مفعّل
        #     out 0x21, al
        #     mov al, 0xFF    ; Slave: كل شيء مخفي
        #     out 0xA1, al
        # }
        اطبع_سطر(" تم")
    نهاية

    ## إعداد PIT (Programmable Interval Timer) لعدد Hz مطلوب
    دالة إعداد_PIT(رقم التردد_Hz)
        متغير قيمة_التقسيم = 1193182 / التردد_Hz   # تردد PIT الداخلي ÷ Hz المطلوب

        # تجميع {
        #     mov al, 0x36        ; Mode 3: Square Wave
        #     out 0x43, al        ; Command port
        #
        #     mov ax, [قيمة_التقسيم]
        #     out 0x40, al        ; Low byte
        #     mov al, ah
        #     out 0x40, al        ; High byte
        # }

        اطبع("  PIT @ ")
        اطبع(التردد_Hz)
        اطبع_سطر(" Hz")
    نهاية

    ## تسجيل معالجات الاستثناءات القياسية
    دالة تسجيل_معالجات_الاستثناءات()
        # الاستثناءات الحرجة مسجّلة في IDT عبر assembly
        # هنا نُسجّل المعالجات عالية المستوى بلغة ص
        اطبع_سطر("     - معالجات الاستثناءات 0-31 مُسجَّلة")
    نهاية

    ## تسجيل معالجات أجهزة IRQ
    دالة تسجيل_معالجات_IRQ()
        # المعالجات الافتراضية للأجهزة
        اطبع_سطر("     - IRQ0 (المؤقت) مُسجَّل")
        اطبع_سطر("     - IRQ1 (لوحة المفاتيح) مُسجَّل")
        اطبع_سطر("     - IRQ12 (الفأرة) مُسجَّل")
        اطبع_سطر("     - IRQ14/15 (IDE) مُسجَّل")
    نهاية

    ## المعالج العام لمقاطعات الأجهزة
    دالة معالج_IRQ(رقم رقم_IRQ)
        إجمالي_مق = إجمالي_مق + 1

        حالة (رقم_IRQ)
            عندما irq_مؤقت_PIT:
                معالج_المؤقت()
            عندما irq_لوحة_مفاتيح:
                معالج_لوحة_المفاتيح()
            عندما irq_فأرة_PS2:
                معالج_الفأرة()
            افتراضي:
                متجاهلة_مق = متجاهلة_مق + 1
        نهاية

        # إرسال End-of-Interrupt (EOI) للـ PIC
        # تجميع {
        #     mov al, 0x20
        #     out 0x20, al    ; EOI للـ PIC الأساسي
        # }
        اذا (رقم_IRQ >= 40)
            # تجميع {
            #     out 0xA0, al    ; EOI للـ PIC الثانوي أيضاً
            # }
        نهاية
    نهاية

    ## معالج ضربة المؤقت
    دالة معالج_المؤقت()
        ضربات_مؤقت_مق = ضربات_مؤقت_مق + 1
        # مجدول_النحلة.tick()  # إعطاء المجدول فرصة التبديل
    نهاية

    ## معالج لوحة المفاتيح PS/2
    دالة معالج_لوحة_المفاتيح()
        أحداث_كيبورد_مق = أحداث_كيبورد_مق + 1

        # قراءة scan code من منفذ 0x60
        # تجميع {
        #     in al, 0x60     ; قراءة الكود من PS/2
        #     mov [آخر_مسح_لوحة], al
        # }

        # إرسال الحدث لمدير النوافذ
        # سطح_مكتب_النحلة.معالجة_مفتاح(آخر_مسح_لوحة)
    نهاية

    ## معالج الفأرة PS/2
    دالة معالج_الفأرة()
        أحداث_فأرة_مق = أحداث_فأرة_مق + 1
        # معالجة حزمة الفأرة 3 bytes
    نهاية

    ## تفعيل/تعطيل مقاطعة IRQ معيّنة
    دالة فعّل_IRQ(رقم رقم_IRQ)
        اذا (رقم_IRQ < 8)
            # تجميع {
            #     in al, 0x21
            #     and al, ~(1 << رقم_IRQ)
            #     out 0x21, al
            # }
        والا
            # تجميع {
            #     in al, 0xA1
            #     and al, ~(1 << (رقم_IRQ - 8))
            #     out 0xA1, al
            # }
        نهاية
    نهاية

    دالة عطّل_IRQ(رقم رقم_IRQ)
        اذا (رقم_IRQ < 8)
            # تجميع {
            #     in al, 0x21
            #     or al, (1 << رقم_IRQ)
            #     out 0x21, al
            # }
        والا
            # تجميع {
            #     in al, 0xA1
            #     or al, (1 << (رقم_IRQ - 8))
            #     out 0xA1, al
            # }
        نهاية
    نهاية
نهاية

## المثيل العالمي لمدير المقاطعات
متغير مدير_مقاطعات_النحلة = جديد مدير_المقاطعات()

## اختبار
دالة رئيسية()
    اطبع_سطر("══════════════════════════════════════")
    اطبع_سطر("  🔔 اختبار مدير المقاطعات")
    اطبع_سطر("══════════════════════════════════════")

    مدير_مقاطعات_النحلة.تهيئة()

    # محاكاة بعض المقاطعات
    مدير_مقاطعات_النحلة.معالج_IRQ(irq_مؤقت_PIT)
    مدير_مقاطعات_النحلة.معالج_IRQ(irq_مؤقت_PIT)
    مدير_مقاطعات_النحلة.معالج_IRQ(irq_لوحة_مفاتيح)
    مدير_مقاطعات_النحلة.معالج_IRQ(irq_فأرة_PS2)

    # طباعة إحصاءات المقاطعات
    اطبع_سطر("═══════════════════════════════════")
    اطبع_سطر("  📊 إحصاءات المقاطعات")
    اطبع_سطر("═══════════════════════════════════")
    اطبع("  إجمالي المقاطعات:   ") اطبع_سطر(مدير_مقاطعات_النحلة.إجمالي_مق)
    اطبع("  ضربات المؤقت:       ") اطبع_سطر(مدير_مقاطعات_النحلة.ضربات_مؤقت_مق)
    اطبع("  لوحة المفاتيح:      ") اطبع_سطر(مدير_مقاطعات_النحلة.أحداث_كيبورد_مق)
    اطبع("  الفأرة:             ") اطبع_سطر(مدير_مقاطعات_النحلة.أحداث_فأرة_مق)
    اطبع("  متجاهلة:           ") اطبع_سطر(مدير_مقاطعات_النحلة.متجاهلة_مق)
    اطبع_سطر("═══════════════════════════════════")

    ارجع 0
نهاية
