# ─────────────────────────────────────────────────────────────────────────────
# صنف: مدير_الإقلاع — يُدير مراحل الإقلاع
# ─────────────────────────────────────────────────────────────────────────────
صنف مدير_الإقلاع
    رقم مرحلة_الإقلاع
    رقم إجمالي_المراحل
    نص  اسم_النظام
    نص  إصدار_النظام
    رقم وقت_الإقلاع_ms
    منطقي إقلاع_ناجح

    باني(نص اسم، نص إصدار)
        مرحلة_الإقلاع   = 0
        إجمالي_المراحل  = 8
        اسم_النظام      = اسم
        إصدار_النظام    = إصدار
        وقت_الإقلاع_ms  = 0
        إقلاع_ناجح      = خطأ
    نهاية

    دالة اطبع_شريط_تقدم(رقم حالي، رقم إجمالي، نص تسمية)
        اطبع("  [")
        متغير منجز = حالي * 20 / إجمالي
        متغير ع_شريط = 0
        بينما (ع_شريط < 20)
            اذا (ع_شريط < منجز)
                اطبع("█")
            وإلا
                اطبع("░")
            نهاية
            ع_شريط = ع_شريط + 1
        نهاية
        اطبع("] ")
        اطبع(حالي * 100 / إجمالي)
        اطبع("% — ")
        اطبع_سطر(تسمية)
    نهاية

    دالة بدء_مرحلة(نص عنوان)
        مرحلة_الإقلاع = مرحلة_الإقلاع + 1
        اطبع("  🐝 المرحلة ")
        اطبع(مرحلة_الإقلاع)
        اطبع("/")
        اطبع(إجمالي_المراحل)
        اطبع(": ")
        اطبع_سطر(عنوان)
        اطبع_شريط_تقدم(مرحلة_الإقلاع، إجمالي_المراحل، عنوان)
    نهاية

    دالة نهاية_الإقلاع()
        إقلاع_ناجح = صحيح
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# صنف: نظام_الذاكرة_الموحد — إدارة ذاكرة BeeOS
# ─────────────────────────────────────────────────────────────────────────────
صنف نظام_الذاكرة_الموحد
    رقم إجمالي_MB
    رقم نواة_MB
    رقم تطبيقات_MB
    رقم مؤقت_MB
    رقم حر_MB
    منطقي نشط

    باني(رقم إجمالي)
        إجمالي_MB    = إجمالي
        نواة_MB      = 256
        تطبيقات_MB  = 1024
        مؤقت_MB     = 512
        حر_MB        = إجمالي - 256 - 1024 - 512
        نشط          = صحيح
    نهاية

    دالة تقرير()
        اطبع_سطر("  📊 حالة الذاكرة:")
        اطبع("    • إجمالي: ")
        اطبع(إجمالي_MB / 1024)
        اطبع_سطر(" GB")
        اطبع("    • النواة: ")
        اطبع(نواة_MB)
        اطبع_سطر(" MB")
        اطبع("    • التطبيقات: ")
        اطبع(تطبيقات_MB)
        اطبع_سطر(" MB")
        اطبع("    • حر: ")
        اطبع(حر_MB)
        اطبع_سطر(" MB")
    نهاية
نهاية

