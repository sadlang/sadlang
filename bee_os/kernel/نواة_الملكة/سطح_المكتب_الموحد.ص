    نهاية

    دالة إنشاء_هيكل_أدلة()
        متغير أدلة = [
            "/",
            "/نظام",
            "/نظام/نواة",
            "/نظام/مكتبات",
            "/نظام/خدمات",
            "/منزل",
            "/منزل/مستخدم",
            "/منزل/مستخدم/المستندات",
            "/منزل/مستخدم/الصور",
            "/منزل/مستخدم/الموسيقى",
            "/تطبيقات",
            "/تطبيقات/النظام",
            "/تطبيقات/المستخدم",
            "/مؤقت",
            "/وسائط"
        ]
        متغير عدد = 0
        لكل د في أدلة
            عدد = عدد + 1
        نهاية
        اطبع("  📂 تم إنشاء ")
        اطبع(عدد)
        اطبع_سطر(" دليلاً في HoneycombFS")
    نهاية

    دالة تقرير()
        اطبع("  💾 نظام الملفات: ")
        اطبع(نظام_الملفات)
        اطبع(" | القرص: ")
        اطبع(حجم_القرص_GB)
        اطبع(" GB | الكتلة: ")
        اطبع(حجم_الكتلة_KB)
        اطبع_سطر(" KB")
    نهاية
نهاية

