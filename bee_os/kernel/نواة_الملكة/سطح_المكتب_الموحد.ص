    رقم  حجم_القرص_GB
    رقم  حجم_الكتلة_KB
    رقم  كتل_مستخدمة
    رقم  كتل_حرة
    منطقي نشط

    باني(رقم حجم_GB)
        نظام_الملفات   = "HoneycombFS"
