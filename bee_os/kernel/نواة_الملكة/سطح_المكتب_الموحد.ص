# ─────────────────────────────────────────────────────────────────────────────
دالة رئيسية()
    ## ═══ شاشة البداية (Splash Screen) ═══
    اطبع_سطر("╔══════════════════════════════════════════════════════════════════╗")
    اطبع_سطر("║                                                                  ║")
    اطبع_سطر("║         🐝  بسم الله الرحمن الرحيم  🐝                         ║")
    اطبع_سطر("║                                                                  ║")
    اطبع_سطر("║    ██████╗ ███████╗███████╗ ██████╗ ███████╗                    ║")
    اطبع_سطر("║    ██╔══██╗██╔════╝██╔════╝██╔═══██╗██╔════╝                    ║")
    اطبع_سطر("║    ██████╔╝█████╗  █████╗  ██║   ██║███████╗                    ║")
    اطبع_سطر("║    ██╔══██╗██╔══╝  ██╔══╝  ██║   ██║╚════██║                    ║")
    اطبع_سطر("║    ██████╔╝███████╗███████╗╚██████╔╝███████║                    ║")
    اطبع_سطر("║    ╚═════╝ ╚══════╝╚══════╝ ╚═════╝ ╚══════╝                    ║")
    اطبع_سطر("║                                                                  ║")
    اطبع_سطر("║    نظام تشغيل عربي — مكتوب بالكامل بلغة ص                     ║")
    اطبع_سطر("║    Arabic Operating System — Written Entirely in Sad Language   ║")
    اطبع_سطر("║                    الإصدار 2.0.0                                ║")
    اطبع_سطر("║                                                                  ║")
    اطبع_سطر("╚══════════════════════════════════════════════════════════════════╝")
    اطبع_سطر("")

    ## ═══ تهيئة مدير الإقلاع ═══
    متغير مدير = جديد مدير_الإقلاع("BeeOS", "2.0.0")
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    اطبع_سطر("  بدء إجراءات الإقلاع...")
    اطبع_سطر("")

    ## ═══ المرحلة 1: تهيئة الذاكرة ═══
    مدير.بدء_مرحلة("تهيئة نظام الذاكرة")
    متغير ذاكرة = جديد نظام_الذاكرة_الموحد(8192)  ## 8 GB
    ذاكرة.تقرير()
    اطبع_سطر("")

    ## ═══ المرحلة 2: تحميل نظام الملفات ═══
    مدير.بدء_مرحلة("تحميل نظام الملفات HoneycombFS")
    متغير ملفات = جديد نظام_الملفات_الموحد(512)  ## 512 GB
    ملفات.إنشاء_هيكل_أدلة()
    ملفات.تقرير()
    اطبع_سطر("")

    ## ═══ المرحلة 3: تشغيل مجدول العمليات ═══
    مدير.بدء_مرحلة("تشغيل مجدول العمليات")
    متغير مجدول = جديد مجدول_العمليات_الموحد(8, 10)  ## 8 نوى، 10ms
    مجدول.تسجيل_عمليات_النظام()
    اطبع_سطر("")

    ## ═══ المرحلة 4: تهيئة الشبكة ═══
    مدير.بدء_مرحلة("تهيئة مكدس الشبكة TCP/IP")
    متغير شبكة = جديد نظام_الشبكة_الموحد("192.168.1.100", "255.255.255.0", "192.168.1.1", 1000)
    شبكة.تقرير()
    اطبع_سطر("")

    ## ═══ المرحلة 5: تشغيل نظام الصوت ═══
    مدير.بدء_مرحلة("تشغيل نظام الصوت")
    متغير صوت = جديد نظام_الصوت_الموحد("Intel HDA", 48000, 16, 2)
    صوت.تشغيل_صوت_الإقلاع()
    اطبع_سطر("")

