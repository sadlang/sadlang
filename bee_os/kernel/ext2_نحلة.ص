# =====================================================================
# التعامل مع خريطة بت الكتل
# =====================================================================

# التحقق مما إذا كانت كتلة مستخدمة
# يُرجع 1 إذا مستخدمة، 0 إذا حرة
صدّر دالة ext2_هل_كتلة_مستخدمة(فهرس_قسم، رقم_كتلة)
    # حساب رقم المجموعة
    متغير كتل_لكل = ext2_كتل_مجموعة(فهرس_قسم + 0)
    متغير رقم_مجموعة = رقم_كتلة / كتل_لكل
    متغير فهرس_في_مجموعة = رقم_كتلة % كتل_لكل
    
    # قراءة واصف المجموعة للحصول على عنوان خريطة البت
    ext2_اقرأ_واصف_مجموعة(فهرس_قسم + 0، رقم_مجموعة + 0)
    متغير كتلة_خريطة = وم_خريطة_كتل_نتيجة + 0
    
    # قراءة خريطة البت
    متغير عرض_كتلة = ext2_مقاس_كتلة(فهرس_قسم + 0)
    متغير مخزن = kmalloc(عرض_كتلة + 0)
    إذا (مخزن == 0)
        ارجع 1
    نهاية
    
    ext2_اقرأ_كتلة(فهرس_قسم + 0، كتلة_خريطة + 0، مخزن + 0)
    
    # فحص البت المناسب
    متغير فهرس_بايت_خريطة = فهرس_في_مجموعة / 8
    متغير فهرس_بت = فهرس_في_مجموعة % 8
    
    متغير قيمه = mem_read_byte(مخزن + 0، فهرس_بايت_خريطة + 0)
    
    # استخراج البت المطلوب باستخدام القسمة
    # bit_n = (value / (2^n)) % 2
    متغير قوة = 1
    متغير ع = 0
    بينما (ع < فهرس_بت)
        قوة = قوة * 2
        ع = ع + 1
    نهاية
    
    متغير نتيجة = (قيمه / قوة) % 2
    
    kfree(مخزن + 0)
    ارجع نتيجة + 0
نهاية

# تخصيص كتلة حرة في مجموعة معينة
# يُرجع رقم الكتلة المخصصة أو -1 عند الفشل
صدّر دالة ext2_خصص_كتلة_في_مجموعة(فهرس_قسم، رقم_مجموعة)
    # قراءة واصف المجموعة
    ext2_اقرأ_واصف_مجموعة(فهرس_قسم + 0، رقم_مجموعة + 0)
    
    إذا (وم_كتل_حرة_نتيجة == 0)
        ارجع -1
    نهاية
    
    متغير كتلة_خريطة = وم_خريطة_كتل_نتيجة + 0
    متغير عرض_كتلة = ext2_مقاس_كتلة(فهرس_قسم + 0)
    متغير كتل_لكل = ext2_كتل_مجموعة(فهرس_قسم + 0)
    
    # قراءة خريطة البت
    متغير مخزن = kmalloc(عرض_كتلة + 0)
    إذا (مخزن == 0)
        ارجع -1
    نهاية
    
    ext2_اقرأ_كتلة(فهرس_قسم + 0، كتلة_خريطة + 0، مخزن + 0)
    
    # البحث عن أول بت حر
    متغير فهرس_في_خريطة = 0
    بينما (فهرس_في_خريطة < كتل_لكل)
        متغير فهرس_بايت_خ = فهرس_في_خريطة / 8
        متغير فهرس_بت = فهرس_في_خريطة % 8
        
        متغير قيمه = mem_read_byte(مخزن + 0، فهرس_بايت_خ + 0)
        
        # استخراج البت
        متغير قوة = 1
        متغير ع = 0
        بينما (ع < فهرس_بت)
            قوة = قوة * 2
            ع = ع + 1
        نهاية
        
        متغير بت = (قيمه / قوة) % 2
        
        إذا (بت == 0)
            # كتلة حرة! تعيين البت
            متغير قيمه_محدثة = قيمه + قوة
            mem_write_byte(مخزن + 0، فهرس_بايت_خ + 0، قيمه_محدثة + 0)
            
            # كتابة خريطة البت المعدّلة
            ext2_اكتب_كتلة(فهرس_قسم + 0، كتلة_خريطة + 0، مخزن + 0)
            
            kfree(مخزن + 0)
            
            # حساب رقم الكتلة المطلق
            متغير رقم_كتلة = رقم_مجموعة * كتل_لكل + فهرس_في_خريطة
            ارجع رقم_كتلة + 0
        نهاية
        
        فهرس_في_خريطة = فهرس_في_خريطة + 1
    نهاية
    
    kfree(مخزن + 0)
    ارجع -1
نهاية

# تخصيص كتلة حرة (يبحث في جميع المجموعات)
صدّر دالة ext2_خصص_كتلة(فهرس_قسم)
    متغير عدد = ext2_عدد_مجموعات(فهرس_قسم + 0)
    متغير ع = 0
    
    بينما (ع < عدد)
        متغير نتيجة = ext2_خصص_كتلة_في_مجموعة(فهرس_قسم + 0، ع + 0)
        إذا (نتيجة >= 0)
            ارجع نتيجة + 0
        نهاية
        ع = ع + 1
    نهاية
    
    serial_puts("[EXT2] خطأ: لا توجد كتل حرة\r\n")
    ارجع -1
نهاية

# تحرير كتلة (مسح البت في خريطة البت)
صدّر دالة ext2_حرر_كتلة(فهرس_قسم، رقم_كتلة)
    متغير كتل_لكل = ext2_كتل_مجموعة(فهرس_قسم + 0)
    متغير رقم_مجموعة = رقم_كتلة / كتل_لكل
    متغير فهرس_في_مجموعة = رقم_كتلة % كتل_لكل
    
    ext2_اقرأ_واصف_مجموعة(فهرس_قسم + 0، رقم_مجموعة + 0)
    متغير كتلة_خريطة = وم_خريطة_كتل_نتيجة + 0
    متغير عرض_كتلة = ext2_مقاس_كتلة(فهرس_قسم + 0)
    
    متغير مخزن = kmalloc(عرض_كتلة + 0)
    إذا (مخزن == 0)
        ارجع -1
    نهاية
    
    ext2_اقرأ_كتلة(فهرس_قسم + 0، كتلة_خريطة + 0، مخزن + 0)
    
    متغير فهرس_بايت_ف = فهرس_في_مجموعة / 8
    متغير فهرس_بت = فهرس_في_مجموعة % 8
    
    متغير قيمه = mem_read_byte(مخزن + 0، فهرس_بايت_ف + 0)
    
    # مسح البت
    متغير قوة = 1
    متغير ع = 0
    بينما (ع < فهرس_بت)
        قوة = قوة * 2
        ع = ع + 1
    نهاية
    
    # التحقق من أن البت كان مُعيّناً
    متغير بت = (قيمه / قوة) % 2
    إذا (بت == 1)
        متغير قيمه_محدثة = قيمه - قوة
        mem_write_byte(مخزن + 0، فهرس_بايت_ف + 0، قيمه_محدثة + 0)
        ext2_اكتب_كتلة(فهرس_قسم + 0، كتلة_خريطة + 0، مخزن + 0)
    نهاية
    
    kfree(مخزن + 0)
    ارجع 0
نهاية

