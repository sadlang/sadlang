# المتغيرات المؤقتة لتخزين واصف المجموعة
متغير وم_خريطة_كتل_نتيجة = 0
متغير وم_خريطة_عقد_نتيجة = 0
متغير وم_جدول_عقد_نتيجة = 0
متغير وم_كتل_حرة_نتيجة = 0
متغير وم_عقد_حرة_نتيجة = 0
متغير وم_عدد_دلائل_نتيجة = 0

صدّر دالة ext2_اقرأ_واصف_مجموعة(فهرس_قسم، رقم_مجموعة)
    # واصفات المجموعات تقع في الكتلة التي تلي الكتلة العليا
    متغير أول_كتلة = 0
    إذا (فهرس_قسم == 0)
        أول_كتلة = ext2_أول_كتلة_0 + 0
    نهاية
    إذا (فهرس_قسم == 1)
        أول_كتلة = ext2_أول_كتلة_1 + 0
    نهاية
    إذا (فهرس_قسم == 2)
        أول_كتلة = ext2_أول_كتلة_2 + 0
    نهاية
    إذا (فهرس_قسم == 3)
        أول_كتلة = ext2_أول_كتلة_3 + 0
    نهاية
    
    # واصفات المجموعات تبدأ من الكتلة (أول_كتلة + 1)
    متغير كتلة_واصفات = أول_كتلة + 1
    
    # حساب الإزاحة داخل الكتلة
    متغير إزاحة_في_كتلة = رقم_مجموعة * مقاس_واصف_مجموعة
    
    # حساب رقم الكتلة الفعلي
    متغير عرض_كتلة = ext2_مقاس_كتلة(فهرس_قسم + 0)
    متغير كتلة_فعلية = كتلة_واصفات + إزاحة_في_كتلة / عرض_كتلة
    متغير إزاحة_ف = إزاحة_في_كتلة % عرض_كتلة
    
    # قراءة الكتلة
    متغير مخزن = kmalloc(عرض_كتلة + 0)
    إذا (مخزن == 0)
        ارجع -1
    نهاية
    
    ext2_اقرأ_كتلة(فهرس_قسم + 0، كتلة_فعلية + 0، مخزن + 0)
    
    # تحليل الواصف
    وم_خريطة_كتل_نتيجة = mem_read_dword(مخزن + 0، إزاحة_ف + وم_خريطة_كتل)
    وم_خريطة_عقد_نتيجة = mem_read_dword(مخزن + 0، إزاحة_ف + وم_خريطة_عقد)
    وم_جدول_عقد_نتيجة = mem_read_dword(مخزن + 0، إزاحة_ف + وم_جدول_عقد)
    وم_كتل_حرة_نتيجة = mem_read_word(مخزن + 0، إزاحة_ف + وم_كتل_حرة)
    وم_عقد_حرة_نتيجة = mem_read_word(مخزن + 0، إزاحة_ف + وم_عقد_حرة)
    وم_عدد_دلائل_نتيجة = mem_read_word(مخزن + 0، إزاحة_ف + وم_عدد_دلائل)
    
    kfree(مخزن + 0)
    ارجع 0
نهاية

