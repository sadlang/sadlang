# ملف: ext2_نحلة.ص
# الوصف: نظام ملفات ext2 — النواة الأساسية
# المشروع: نظام نحلة (BeeOS)
#
# يحتوي هذا الملف على:
#   - قراءة وتحليل الكتلة العليا (Superblock) على الإزاحة 1024
#   - إدارة مجموعات الكتل (Block Groups)
#   - واصف مجموعة الكتل (Block Group Descriptor)
#   - خرائط البت للكتل (Block Bitmap)
#   - خرائط البت للعُقد (Inode Bitmap)
#   - تخصيص وتحرير الكتل
#   - عمليات القراءة والكتابة على مستوى الكتل
#
# بنية الكتلة العليا (Superblock) — 1024 بايت على الإزاحة 1024:
#   0x00: عدد العُقد الكلي (4 بايت)
#   0x04: عدد الكتل الكلي (4 بايت)
#   0x08: كتل محجوزة للمشرف (4 بايت)
#   0x0C: كتل حرة (4 بايت)
#   0x10: عُقد حرة (4 بايت)
#   0x14: أول كتلة بيانات (عادة 0 أو 1) (4 بايت)
#   0x18: log2(مقاس_الكتلة) - 10 (4 بايت)
#   0x1C: log2(مقاس_الشظية) - 10 (4 بايت)
#   0x20: كتل لكل مجموعة (4 بايت)
#   0x24: شظايا لكل مجموعة (4 بايت)
#   0x28: عُقد لكل مجموعة (4 بايت)
#   0x2C: وقت آخر تركيب (4 بايت)
#   0x30: وقت آخر كتابة (4 بايت)
#   0x34: عدد مرات التركيب (2 بايت)
#   0x36: أقصى تركيب قبل الفحص (2 بايت)
#   0x38: الرقم السحري 0xEF53 (2 بايت)
#   0x3A: الوضعية (2 بايت): 1=نظيف، 2=به أخطاء
#   0x3C: إجراء عند خطأ (2 بايت)
#   0x3E: الإصدار الثانوي (2 بايت)
#   0x40: وقت آخر فحص (4 بايت)
#   0x44: فترة الفحص (4 بايت)
#   0x48: معرّف نظام التشغيل (4 بايت)
#   0x4C: الإصدار الرئيسي (4 بايت)
#   0x50: معرّف المستخدم المحجوز (2 بايت)
#   0x52: معرّف المجموعة المحجوزة (2 بايت)
#«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»

