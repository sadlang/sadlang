# =====================================================================
# قراءة وتحليل الكتلة العليا (Superblock)
# =====================================================================

صدّر دالة ext2_حلل_كتلة_عليا(فهرس_قسم، محرك، بداية)
    serial_puts("[EXT2] تحليل الكتلة العليا...\r\n")
    
    # تخصيص مخزن مؤقت (1024 بايت)
    متغير مخزن = kmalloc(مقاس_كتلة_عليا + 0)
    إذا (مخزن == 0)
        serial_puts("[EXT2] خطأ: فشل تخصيص ذاكرة\r\n")
        ارجع -1
    نهاية
    
    # قراءة القطاعين الثالث والرابع (الإزاحة 1024 = القطاع 2 من بداية القسم)
    متغير قطاع_كتلة_عليا = بداية + 2
    ata_read_sectors(محرك + 0، قطاع_كتلة_عليا + 0، 2، مخزن + 0)
    
    # التحقق من الرقم السحري (الإزاحة 0x38 = 56)
    متغير سحري = mem_read_word(مخزن + 0، ك_الرقم_السحري + 0)
    إذا (سحري != رقم_سحري_ext2)
        serial_puts("[EXT2] خطأ: رقم سحري غير صالح: ")
        serial_put_hex(سحري + 0)
        serial_puts("\r\n")
        kfree(مخزن + 0)
        ارجع -1
    نهاية
    
    serial_puts("[EXT2] رقم سحري صحيح: 0xEF53\r\n")
    
    # قراءة الحقول
    متغير عدد_عقد = mem_read_dword(مخزن + 0، ك_عدد_عقد + 0)
    متغير عدد_كتل = mem_read_dword(مخزن + 0، ك_عدد_كتل + 0)
    متغير كتل_حرة = mem_read_dword(مخزن + 0، ك_كتل_حرة + 0)
    متغير عقد_حرة = mem_read_dword(مخزن + 0، ك_عقد_حرة + 0)
    متغير أول_كتلة = mem_read_dword(مخزن + 0، ك_أول_كتلة + 0)
    متغير لوغ_مقاس = mem_read_dword(مخزن + 0، ك_لوغ_مقاس_كتلة + 0)
    متغير كتل_لكل = mem_read_dword(مخزن + 0، ك_كتل_لكل_مجموعة + 0)
    متغير عقد_لكل = mem_read_dword(مخزن + 0، ك_عقد_لكل_مجموعة + 0)
    متغير إصدار = mem_read_dword(مخزن + 0، ك_إصدار_رئيسي + 0)
    
    # حساب مقاس الكتلة
    # log2(block_size) - 10 → block_size = 1024 << value
    # لوغ = 0 → 1024، لوغ = 1 → 2048، لوغ = 2 → 4096
    متغير عرض_كتلة = 1024
    إذا (لوغ_مقاس == 1)
        عرض_كتلة = 2048
    نهاية
    إذا (لوغ_مقاس == 2)
        عرض_كتلة = 4096
    نهاية
    إذا (لوغ_مقاس == 3)
        عرض_كتلة = 8192
    نهاية
    
    # حساب عدد مجموعات الكتل
    متغير عدد_مجموعات = عدد_كتل / كتل_لكل
    إذا (عدد_كتل % كتل_لكل != 0)
        عدد_مجموعات = عدد_مجموعات + 1
    نهاية
    
    # تخزين في قاعدة البيانات
    إذا (فهرس_قسم == 0)
        ext2_محرك_0 = محرك + 0
        ext2_بداية_0 = بداية + 0
        ext2_عدد_عقد_0 = عدد_عقد + 0
        ext2_عدد_كتل_0 = عدد_كتل + 0
        ext2_كتل_حرة_0 = كتل_حرة + 0
        ext2_عقد_حرة_0 = عقد_حرة + 0
        ext2_مقاس_كتلة_0 = عرض_كتلة + 0
        ext2_كتل_مجموعة_0 = كتل_لكل + 0
