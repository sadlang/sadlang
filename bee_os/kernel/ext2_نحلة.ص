# =====================================================================
# تحويل رقم كتلة إلى رقم قطاع
# =====================================================================

صدّر دالة ext2_كتلة_إلى_قطاع(فهرس_قسم، رقم_كتلة)
    متغير عرض_كتلة = ext2_مقاس_كتلة(فهرس_قسم + 0)
    متغير قطاعات_لكل_كتلة = عرض_كتلة / مقاس_قطاع
    متغير بداية = ext2_بداية_قسم(فهرس_قسم + 0)
    ارجع بداية + رقم_كتلة * قطاعات_لكل_كتلة
نهاية

