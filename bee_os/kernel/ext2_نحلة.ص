صدّر دالة ext2_اقرأ_كتلة(فهرس_قسم، رقم_كتلة، مخزن)
    متغير محرك = ext2_محرك_قسم(فهرس_قسم + 0)
    متغير قطاع = ext2_كتلة_إلى_قطاع(فهرس_قسم + 0، رقم_كتلة + 0)
    متغير عرض_كتلة = ext2_مقاس_كتلة(فهرس_قسم + 0)
    متغير عدد_قطاعات = عرض_كتلة / مقاس_قطاع
    
    ata_read_sectors(محرك + 0، قطاع + 0، عدد_قطاعات + 0، مخزن + 0)
    ارجع 0
