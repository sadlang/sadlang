##
## حاسبة_جمع — يجمع عددين
## على الأجهزة الحقيقية: FPU FADD ST0, ST1
##
دالة حاسبة_جمع(رقم_أول، رقم_ثاني)
    متغير ناتج = رقم_أول + رقم_ثاني
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع ناتج
نهاية

##
## حاسبة_طرح — يطرح العدد الثاني من الأول
## على الأجهزة الحقيقية: FPU FSUB ST0, ST1
##
دالة حاسبة_طرح(رقم_أول، رقم_ثاني)
    متغير ناتج = رقم_أول - رقم_ثاني
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع ناتج
نهاية

##
## حاسبة_ضرب — يضرب عددين
## على الأجهزة الحقيقية: FPU FMUL ST0, ST1
##
دالة حاسبة_ضرب(رقم_أول، رقم_ثاني)
    متغير ناتج = رقم_أول * رقم_ثاني
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع ناتج
نهاية

##
## حاسبة_قسمة — يقسم الأول على الثاني
## يتحقق من القسمة على صفر (مرفوضة رياضياً)
## على الأجهزة الحقيقية: FPU FDIV + فحص ZF flag
##
دالة حاسبة_قسمة(رقم_أول، رقم_ثاني)
    إذا (رقم_ثاني == 0)
        اطبع_سطر("[BeeCalc] خطأ: قسمة على صفر محظورة!")
        ارجع 0
    نهاية
    متغير ناتج = رقم_أول / رقم_ثاني
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع ناتج
نهاية

##
## حاسبة_باقي — يحسب باقي القسمة
## مثال: 17 % 5 = 2
##
دالة حاسبة_باقي(رقم_أول، رقم_ثاني)
    إذا (رقم_ثاني == 0)
        ارجع 0
    نهاية
    متغير ناتج = رقم_أول % رقم_ثاني
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع ناتج
نهاية

##
## حاسبة_قوة — يرفع رقم إلى أس
## مثال: قوة(2, 10) = 1024
## على الأجهزة الحقيقية: FPU FMUL في حلقة أو FYL2X
##
دالة حاسبة_قوة(عدد_اساس، عدد_اس)
    إذا (عدد_اس == 0)
        ارجع 1
    نهاية
    متغير ناتج_قوة = 1
    متغير عداد_اس = 0
    بينما (عداد_اس < عدد_اس)
        متغير ناتج_قوة = ناتج_قوة * عدد_اساس
        متغير عداد_اس = عداد_اس + 1
    نهاية
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع ناتج_قوة
نهاية

