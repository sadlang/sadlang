##
## حاسبة_جذر — يحسب الجذر التربيعي بطريقة نيوتن
## الخوارزمية: Newton-Raphson (x1 = (x0 + n/x0) / 2)
## على الأجهزة الحقيقية: x87 FPU FSQRT (دقة 80 بت)
##
دالة حاسبة_جذر(الرقم)
    إذا (الرقم < 0)
        اطبع_سطر("[BeeCalc] خطأ: جذر عدد سالب غير حقيقي")
        ارجع 0
    نهاية
    إذا (الرقم == 0)
        ارجع 0
    نهاية
    # تقريب أولي: n/2
    متغير تخمين = الرقم / 2.0
    # 10 تكرارات نيوتن-رافسون — كافية لدقة 15 خانة
    متغير تكرار = 0
    بينما (تكرار < 10)
        متغير تخمين = (تخمين + الرقم / تخمين) / 2.0
        متغير تكرار = تكرار + 1
    نهاية
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع تخمين
نهاية

##
## حاسبة_مطلق — يعيد القيمة المطلقة
##
دالة حاسبة_مطلق(الرقم)
    إذا (الرقم < 0)
        ارجع الرقم * -1
    نهاية
    ارجع الرقم
نهاية

##
## حاسبة_log2 — يحسب log₂ بطريقة تكرارية
## على الأجهزة الحقيقية: FPU FYL2X
##
دالة حاسبة_log2(الرقم)
    إذا (الرقم <= 0)
        اطبع_سطر("[BeeCalc] خطأ: log من صفر أو سالب غير محدد")
        ارجع 0
    نهاية
    # تقريب: عدد مرات تقسيم الرقم على 2 حتى يصل إلى 1
    متغير قيمة_مؤقتة = الرقم
    متغير عداد_log = 0
    بينما (قيمة_مؤقتة >= 2.0)
        متغير قيمة_مؤقتة = قيمة_مؤقتة / 2.0
        متغير عداد_log = عداد_log + 1
    نهاية
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع عداد_log
نهاية

##
## حاسبة_floor — يُقرّب للأسفل (أكبر صحيح أصغر من أو يساوي x)
## على الأجهزة: FPU FRNDINT مع RC=downward
##
دالة حاسبة_floor(الرقم)
    متغير جزء_صحيح = 0
    إذا (الرقم >= 0)
        متغير جزء_صحيح = الرقم - (الرقم % 1.0)
    وإلا
        متغير جزء_صحيح = الرقم - (الرقم % 1.0) - 1
    نهاية
    ارجع جزء_صحيح
نهاية

##
## حاسبة_ceil — يُقرّب للأعلى (أصغر صحيح أكبر من أو يساوي x)
##
دالة حاسبة_ceil(الرقم)
    متغير قاع = حاسبة_floor(الرقم)
    إذا (قاع == الرقم)
        ارجع قاع
    نهاية
    ارجع قاع + 1
نهاية

