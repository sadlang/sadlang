##
## حاسبة_زكاة — يحسب مقدار الزكاة الواجبة
##
## الشروط: بلوغ النصاب + مرور الحول
## النصاب: 85 جرام ذهب أو ما يعادله
## المقدار: 2.5% من المال
##
## المدخلات:
##   مجموع_المال  — إجمالي المال بالريال/الدولار
##   سعر_الذهب   — سعر جرام الذهب بنفس العملة
##
دالة حاسبة_زكاة(مجموع_المال، سعر_الذهب)
    متغير نصاب_بالنقود = نصاب_الذهب * سعر_الذهب
    إذا (مجموع_المال < نصاب_بالنقود)
        اطبع_سطر("[BeeCalc] المال دون النصاب - لا زكاة واجبة")
        ارجع 0
    نهاية
    متغير مقدار_الزكاة = مجموع_المال * نسبة_الزكاة
    اطبع_سطر("[BeeCalc] النصاب: " + نصاب_بالنقود)
    اطبع_سطر("[BeeCalc] الزكاة الواجبة: " + مقدار_الزكاة)
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع مقدار_الزكاة
نهاية

##
## حاسبة_حصة_إرث — يحسب حصة وارث من التركة
##
## أنواع الورثة وحصصهم الفرضية (القرآن الكريم):
##   زوج    — 1/2 بدون ولد، 1/4 مع ولد
##   زوجة   — 1/4 بدون ولد، 1/8 مع ولد
##   ابن    — عصبة (تقاسم البقية)
##   بنت    — 1/2 واحدة، 2/3 أكثر من واحدة
##   أب     — 1/6 مع ولد، عصبة بدون ولد
##   أم     — 1/3 بدون ولد، 1/6 مع ولد
##
## هذه المحاكاة تحسب حصصاً تبسيطية (للتعليم فقط)
## للمسائل التفصيلية استشر عالم شريعة
##
دالة حاسبة_حصة_إرث(التركة، نوع_الوارث، وجود_ولد)
    متغير نسبة_الحصة = 0.0
    إذا (نوع_الوارث == "زوج")
        إذا (وجود_ولد == صحيح)
            متغير نسبة_الحصة = 0.25
        وإلا
            متغير نسبة_الحصة = 0.5
        نهاية
    نهاية
    إذا (نوع_الوارث == "زوجة")
        إذا (وجود_ولد == صحيح)
            متغير نسبة_الحصة = 0.125
        وإلا
            متغير نسبة_الحصة = 0.25
        نهاية
    نهاية
    إذا (نوع_الوارث == "بنت_واحدة")
        متغير نسبة_الحصة = 0.5
    نهاية
    إذا (نوع_الوارث == "ابنتان_فأكثر")
        متغير نسبة_الحصة = 0.6667
    نهاية
    إذا (نوع_الوارث == "أم_مع_ولد")
        متغير نسبة_الحصة = 0.1667
    نهاية
    إذا (نوع_الوارث == "أم_بدون_ولد")
        متغير نسبة_الحصة = 0.3333
    نهاية
    إذا (نوع_الوارث == "أب_مع_ولد")
        متغير نسبة_الحصة = 0.1667
    نهاية
    متغير الحصة_المحسوبة = التركة * نسبة_الحصة
    متغير عداد_حسابات = عداد_حسابات + 1
    ارجع الحصة_المحسوبة
نهاية

##
## حاسبة_قبلة — يحسب انحراف اتجاه القبلة تقريباً
##
## يستخدم الإحداثيات الجغرافية لحساب الاتجاه نحو مكة المكرمة
## مكة: خط عرض 21.4225 درجة شمالاً، طول 39.8262 درجة شرقاً
##
## على الأجهزة الحقيقية: يستخدم GPS NMEA data
##
دالة حاسبة_قبلة(خط_عرض_المستخدم، خط_طول_المستخدم)
    # إحداثيات مكة المكرمة
    متغير خط_عرض_مكة = 21.4225
    متغير خط_طول_مكة = 39.8262

    # الفرق في خطوط الطول
    متغير دلتا_طول = خط_طول_مكة - خط_طول_المستخدم

    # تحويل إلى راديان
    متغير عرض1_rad = درجة_إلى_راديان(خط_عرض_المستخدم)
    متغير عرض2_rad = درجة_إلى_راديان(خط_عرض_مكة)
    متغير طول_rad = درجة_إلى_راديان(دلتا_طول)

    # حساب المسافة التقريبية (Haversine لاحقاً — هنا نعطي اتجاهاً تقريبياً)
    متغير مكون_جنوبي = حاسبة_cos_تقريبي(عرض2_rad) * حاسبة_sin_تقريبي(طول_rad)
    متغير مكون_شمالي = حاسبة_cos_تقريبي(عرض1_rad) * حاسبة_sin_تقريبي(عرض2_rad) - حاسبة_sin_تقريبي(عرض1_rad) * حاسبة_cos_تقريبي(عرض2_rad) * حاسبة_cos_تقريبي(طول_rad)

    # الزاوية التقريبية بالراديان (atan2 تقريبي)
    متغير زاوية_تقريبية = 0.0
    إذا (مكون_شمالي != 0)
        متغير زاوية_تقريبية = مكون_جنوبي / مكون_شمالي
    نهاية

    متغير اتجاه_درجات = راديان_إلى_درجة(زاوية_تقريبية)
    إذا (اتجاه_درجات < 0)
        متغير اتجاه_درجات = اتجاه_درجات + 360
    نهاية

    اطبع_سطر("[BeeCalc] الاتجاه التقريبي للقبلة: " + اتجاه_درجات + " درجة")
    ارجع اتجاه_درجات
نهاية

