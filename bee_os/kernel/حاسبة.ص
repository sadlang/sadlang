##
## BeeCalc تعمل بنظام المكدس (Stack-based RPN calculator)
## مثل HP calculators — تضع الأرقام في المكدس ثم تُطبّق العملية
##
## مثال RPN: 3 5 + → 8
##           2 3 قوة → 8
##           100000 250 زكاة → 2500
##
متغير مكدس_حاسبة = []
متغير عداد_مكدس = 0

##
## مكدس_ادفع — يضع رقماً في المكدس
##
دالة مكدس_ادفع(الرقم)
    أضف(مكدس_حاسبة، الرقم)
    متغير عداد_مكدس = عداد_مكدس + 1
    ارجع عداد_مكدس
نهاية

##
## مكدس_اسحب — يأخذ رقماً من قمة المكدس
##
دالة مكدس_اسحب()
    إذا (مكدس_حاسبة.الطول() == 0)
        اطبع_سطر("[BeeCalc] المكدس فارغ!")
        ارجع 0
    نهاية
    متغير آخر_فهرس = مكدس_حاسبة.الطول() - 1
    متغير القيمة = مكدس_حاسبة[آخر_فهرس]
    متغير عداد_مكدس = عداد_مكدس - 1
    ارجع القيمة
نهاية

##
## مكدس_عرض — يطبع محتوى المكدس
##
دالة مكدس_عرض()
    اطبع_سطر("[Stack] " + مكدس_حاسبة.الطول() + " عناصر")
    متغير رقم_عرض = 0
    لكل عنصر_مكدس في مكدس_حاسبة
        اطبع_سطر("  [" + رقم_عرض + "] = " + عنصر_مكدس)
        متغير رقم_عرض = رقم_عرض + 1
    نهاية
    ارجع 0
نهاية

##
## beecalc_تنفيذ_rpn — يُنفذ عملية RPN على المكدس
##
دالة beecalc_تنفيذ_rpn(عملية_rpn)
    إذا (عملية_rpn == "+")
        متغير قيمة2 = مكدس_اسحب()
        متغير قيمة1 = مكدس_اسحب()
        متغير ناتج_rpn = حاسبة_جمع(قيمة1، قيمة2)
        مكدس_ادفع(ناتج_rpn)
        ارجع ناتج_rpn
    نهاية
    إذا (عملية_rpn == "-")
        متغير قيمة2 = مكدس_اسحب()
        متغير قيمة1 = مكدس_اسحب()
        متغير ناتج_rpn = حاسبة_طرح(قيمة1، قيمة2)
        مكدس_ادفع(ناتج_rpn)
        ارجع ناتج_rpn
    نهاية
    إذا (عملية_rpn == "*")
        متغير قيمة2 = مكدس_اسحب()
        متغير قيمة1 = مكدس_اسحب()
        متغير ناتج_rpn = حاسبة_ضرب(قيمة1، قيمة2)
        مكدس_ادفع(ناتج_rpn)
        ارجع ناتج_rpn
    نهاية
    إذا (عملية_rpn == "/")
        متغير قيمة2 = مكدس_اسحب()
        متغير قيمة1 = مكدس_اسحب()
        متغير ناتج_rpn = حاسبة_قسمة(قيمة1، قيمة2)
        مكدس_ادفع(ناتج_rpn)
        ارجع ناتج_rpn
    نهاية
    إذا (عملية_rpn == "جذر")
        متغير قيمة1 = مكدس_اسحب()
        متغير ناتج_rpn = حاسبة_جذر(قيمة1)
        مكدس_ادفع(ناتج_rpn)
        ارجع ناتج_rpn
    نهاية
    إذا (عملية_rpn == "مطلق")
        متغير قيمة1 = مكدس_اسحب()
        متغير ناتج_rpn = حاسبة_مطلق(قيمة1)
        مكدس_ادفع(ناتج_rpn)
        ارجع ناتج_rpn
    نهاية
