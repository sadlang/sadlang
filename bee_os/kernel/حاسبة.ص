##
## درجة_إلى_راديان — تحويل الزوايا من درجات إلى راديان
## القانون: راديان = درجة × (Pi / 180)
## مفيد لحساب اتجاه القبلة
##
دالة درجة_إلى_راديان(درجات)
    ارجع درجات * Pi / 180.0
نهاية

##
## راديان_إلى_درجة — تحويل من راديان إلى درجات
##
دالة راديان_إلى_درجة(راديانات)
    ارجع راديانات * 180.0 / Pi
نهاية

##
## حاسبة_sin_تقريبي — يحسب الجيب تقريباً بسلسلة تيلور
## sin(x) ≈ x - x³/3! + x⁵/5! - x⁷/7!
## على الأجهزة: FPU FSIN (دقة كاملة)
##
دالة حاسبة_sin_تقريبي(راديانات)
    متغير حد1 = راديانات
    متغير حد2 = راديانات * راديانات * راديانات / 6.0
    متغير حد3 = راديانات * راديانات * راديانات * راديانات * راديانات / 120.0
    متغير حد4 = راديانات * راديانات * راديانات * راديانات * راديانات * راديانات * راديانات / 5040.0
    ارجع حد1 - حد2 + حد3 - حد4
نهاية

##
## حاسبة_cos_تقريبي — يحسب جيب التمام تقريباً
## cos(x) ≈ 1 - x²/2! + x⁴/4! - x⁶/6!
##
دالة حاسبة_cos_تقريبي(راديانات)
    متغير مربع = راديانات * راديانات
    متغير حد1 = 1.0
    متغير حد2 = مربع / 2.0
    متغير حد3 = مربع * مربع / 24.0
    متغير حد4 = مربع * مربع * مربع / 720.0
    ارجع حد1 - حد2 + حد3 - حد4
نهاية

