##
## قسّم_أمر — يقسم سطر الأمر إلى كلمات
## مثال: "اكتب /مسار محتوى هنا" → ["اكتب", "/مسار", "محتوى هنا"]
## ملاحظة: الكلمة الثالثة فصاحاً تُدمج كمحتوى الملف
##
دالة قسّم_أمر(سطر_أمر)
    متغير الأجزاء = []
    متغير كلمة_حالية = ""
    متغير رقم_حرف = 0
    بينما (رقم_حرف < سطر_أمر.الطول())
        متغير الحرف = سطر_أمر[رقم_حرف]
        إذا (الحرف == " ")
            إذا (كلمة_حالية.الطول() > 0)
                أضف(الأجزاء، كلمة_حالية)
                متغير كلمة_حالية = ""
            نهاية
        وإلا
            متغير كلمة_حالية = كلمة_حالية + الحرف
        نهاية
        متغير رقم_حرف = رقم_حرف + 1
    نهاية
    إذا (كلمة_حالية.الطول() > 0)
        أضف(الأجزاء، كلمة_حالية)
    نهاية
    ارجع الأجزاء
نهاية

##
## نفّذ_أمر — يفسر ويُنفذ أمراً واحداً
## يعيد: "خروج" إذا طلب المستخدم الخروج، وإلا "" للمتابعة
##
دالة نفّذ_أمر(سطر_أمر)
    # تجاهل الأسطر الفارغة والتعليقات
    إذا (سطر_أمر == "" أو سطر_أمر == " ")
        ارجع ""
    نهاية
    إذا (سطر_أمر[0] == "#")
        ارجع ""
    نهاية

    # حفظ الأمر في التاريخ
    سجل_أمر(سطر_أمر)

    # تقسيم الأمر إلى كلمات
    متغير أجزاء = قسّم_أمر(سطر_أمر)
    إذا (أجزاء.الطول() == 0)
        ارجع ""
    نهاية

    متغير الأمر = أجزاء[0]

    # ─── الخروج ───
    إذا (الأمر == "خروج" أو الأمر == "exit")
        اطبع_سطر_ملون("مع السلامة 🐝 بسم الله", اللون_أصفر)
        ارجع "خروج"
    نهاية

    # ─── المساعدة ───
    إذا (الأمر == "مساعدة" أو الأمر == "help")
        أمر_مساعدة()
        ارجع ""
    نهاية

    # ─── الطباعة ───
    إذا (الأمر == "اطبع" أو الأمر == "echo")
        إذا (أجزاء.الطول() > 1)
            اطبع_سطر(أجزاء[1])
        نهاية
        ارجع ""
    نهاية

    # ─── مسح الشاشة ───
    إذا (الأمر == "مسح" أو الأمر == "cls" أو الأمر == "clear")
        # على الأجهزة الحقيقية: ANSI escape أو مسح ذاكرة VGA مباشرة
        اطبع_سطر("")
        اطبع_سطر("--- الشاشة نظفت ---")
        اطبع_سطر("")
        ارجع ""
    نهاية

    # ─── تاريخ الأوامر ───
    إذا (الأمر == "تاريخ" أو الأمر == "history")
        اعرض_تاريخ()
        ارجع ""
    نهاية

    # ─── معلومات النظام ───
    إذا (الأمر == "معلومات_نظام" أو الأمر == "sysinfo")
        أمر_معلومات_نظام()
        ارجع ""
    نهاية

    # ─── قرآن ───
    إذا (الأمر == "قرآن" أو الأمر == "quran")
        إذا (أجزاء.الطول() > 1)
            أمر_قرآن(أجزاء[1])
        وإلا
            أمر_قرآن("1")
        نهاية
        ارجع ""
    نهاية

    # ─── أذان ───
    إذا (الأمر == "أذان" أو الأمر == "adhan")
        أمر_أذان()
        ارجع ""
    نهاية

    # ─── شجرة الأدلة ───
    إذا (الأمر == "شجرة" أو الأمر == "tree")
        إذا (أجزاء.الطول() > 1)
            beesh_شجرة(أجزاء[1])
        وإلا
            beesh_شجرة(مجلد_حالي)
        نهاية
        ارجع ""
    نهاية

    # ─── قراءة ملف ───
    إذا (الأمر == "اقرأ" أو الأمر == "cat")
        إذا (أجزاء.الطول() < 2)
            اطبع_سطر("خطأ: اقرأ <مسار>")
            ارجع ""
        نهاية
        متغير محتوى_مقروء = beesh_اقرأ_ملف(أجزاء[1])
        اطبع_سطر_ملون(محتوى_مقروء، اللون_أبيض)
        ارجع ""
    نهاية

    # ─── كتابة ملف ───
    إذا (الأمر == "اكتب" أو الأمر == "write")
        إذا (أجزاء.الطول() < 3)
            اطبع_سطر("خطأ: اكتب <مسار> <محتوى>")
            ارجع ""
        نهاية
        متغير نتيجة_كتابة = beesh_اكتب_ملف(أجزاء[1]، أجزاء[2])
        اطبع_سطر_ملون(نتيجة_كتابة، اللون_أخضر)
        ارجع ""
    نهاية

    # ─── حذف ملف ───
    إذا (الأمر == "احذف" أو الأمر == "rm")
        إذا (أجزاء.الطول() < 2)
            اطبع_سطر("خطأ: احذف <مسار>")
            ارجع ""
        نهاية
        متغير نتيجة_حذف = beesh_احذف_ملف(أجزاء[1])
        اطبع_سطر_ملون(نتيجة_حذف، اللون_أخضر)
        ارجع ""
    نهاية

    # ─── إنشاء مجلد ───
    إذا (الأمر == "أنشئ_مجلد" أو الأمر == "mkdir")
        إذا (أجزاء.الطول() < 2)
            اطبع_سطر("خطأ: أنشئ_مجلد <مسار>")
            ارجع ""
        نهاية
        متغير نتيجة_مجلد = beesh_أنشئ_مجلد(أجزاء[1])
        اطبع_سطر_ملون(نتيجة_مجلد، اللون_أخضر)
        ارجع ""
    نهاية

    # ─── تعيين متغير بيئة ───
    إذا (الأمر == "متغير_بيئة" أو الأمر == "export")
        إذا (أجزاء.الطول() >= 3)
            اطبع_سطر("تعيين: " + أجزاء[1] + " = " + أجزاء[2])
        نهاية
        ارجع ""
    نهاية

    # ─── أمر غير معروف ───
    اطبع_سطر_ملون("خطأ: أمر غير معروف '" + الأمر + "' — اكتب 'مساعدة'", اللون_أحمر)
    ارجع ""
نهاية

