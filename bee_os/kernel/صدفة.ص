##
## مسار_مطلق — يحوّل مساراً نسبياً إلى مطلق
## مثال: إذا مجلد_حالي="/bee" و مسار="etc" → "/bee/etc"
##
دالة مسار_مطلق(مسار_نسبي)
    إذا (مسار_نسبي == "" أو مسار_نسبي == ".")
        ارجع مجلد_حالي
    نهاية
    إذا (مسار_نسبي == "..")
        # الصعود مجلد واحد
        متغير نقطة_آخر = 0
        متغير عداد_حرف = 0
        بينما (عداد_حرف < مجلد_حالي.الطول())
            إذا (مجلد_حالي[عداد_حرف] == "/")
                متغير نقطة_آخر = عداد_حرف
            نهاية
            متغير عداد_حرف = عداد_حرف + 1
        نهاية
        إذا (نقطة_آخر == 0)
            ارجع "/"
        نهاية
        ارجع مجلد_حالي
    نهاية
    # إذا يبدأ بـ/ فهو مطلق بالفعل
    إذا (مسار_نسبي[0] == "/")
        ارجع مسار_نسبي
    نهاية
    # دمج المجلد الحالي مع المسار النسبي
    إذا (مجلد_حالي == "/")
        ارجع "/" + مسار_نسبي
    نهاية
    ارجع مجلد_حالي + "/" + مسار_نسبي
نهاية

##
## beesh_اقرأ_ملف — يقرأ محتوى ملف من BeeFS
## يعيد المحتوى أو رسالة خطأ
##
دالة beesh_اقرأ_ملف(مسار_ملف)
    متغير مسار_كامل = مسار_مطلق(مسار_ملف)
    # بحث في محتوى_ملفات الثابت
    إذا (محتوى_ملفات[مسار_كامل] != صفر)
        ارجع محتوى_ملفات[مسار_كامل]
    نهاية
    # بحث في الملفات المكتوبة ديناميكياً
    لكل سجل_ملف في قائمة_كتابة
        إذا (سجل_ملف["مسار"] == مسار_كامل)
            ارجع سجل_ملف["محتوى"]
        نهاية
    نهاية
    ارجع "خطأ: الملف '" + مسار_كامل + "' غير موجود"
نهاية

##
## beesh_اكتب_ملف — يكتب محتوى في ملف BeeFS
## يُنشئ الملف إذا لم يكن موجوداً (مع CoW)
## على الأجهزة الحقيقية: يخصص خلية سداسية جديدة في BeeFS
##
دالة beesh_اكتب_ملف(مسار_ملف، محتوى_جديد)
    متغير مسار_كامل = مسار_مطلق(مسار_ملف)
    متغير سجل_جديد = {"مسار": مسار_كامل، "محتوى": محتوى_جديد}
    أضف(قائمة_كتابة، سجل_جديد)
    ارجع "✓ كتب " + مسار_كامل + " (" + محتوى_جديد.الطول() + " بايت)"
نهاية

