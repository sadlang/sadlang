##
## beesh_اختبر — يُجري اختبارات صحة على وحدات BeeSh
##
دالة beesh_اختبر()
    رسم_شريط()
    اطبع_سطر_ملون("  🧪 اختبارات BeeSh الذاتية", اللون_أزرق_فاتح)
    رسم_شريط()
    متغير نجح = 0
    متغير فشل = 0

    # اختبار 1: قسّم_أمر
    اطبع("  اختبار 1: قسم_أمر... ")
    متغير نتيجة_قسم = قسّم_أمر("اكتب /مسار محتوى")
    إذا (نتيجة_قسم.الطول() == 3)
        اطبع_سطر("✓")
        متغير نجح = نجح + 1
    وإلا
        اطبع_سطر("✗ (فشل: " + نتيجة_قسم.الطول() + ")")
        متغير فشل = فشل + 1
    نهاية

    # اختبار 2: مسار_مطلق
    اطبع("  اختبار 2: مسار_مطلق... ")
    متغير مسار_ناتج = مسار_مطلق("/bee/قرآن")
    إذا (مسار_ناتج == "/bee/قرآن")
        اطبع_سطر("✓")
        متغير نجح = نجح + 1
    وإلا
        اطبع_سطر("✗")
        متغير فشل = فشل + 1
    نهاية

    # اختبار 3: قراءة ملف موجود
    اطبع("  اختبار 3: قراءة ملف موجود... ")
    متغير محتوى_اختبار = beesh_اقرأ_ملف("/bee/etc/بسم_الله")
    إذا (محتوى_اختبار == "بسم الله الرحمن الرحيم")
        اطبع_سطر("✓")
        متغير نجح = نجح + 1
    وإلا
        اطبع_سطر("✗")
        متغير فشل = فشل + 1
    نهاية

    # اختبار 4: قراءة ملف غير موجود
    اطبع("  اختبار 4: ملف غير موجود... ")
    متغير خطأ_اختبار = beesh_اقرأ_ملف("/غير_موجود")
    إذا (خطأ_اختبار[0] == "خ")
        اطبع_سطر("✓")
        متغير نجح = نجح + 1
    وإلا
        اطبع_سطر("✗")
        متغير فشل = فشل + 1
    نهاية

    # اختبار 5: كتابة وقراءة ملف جديد
    اطبع("  اختبار 5: كتابة/قراءة ملف... ")
    beesh_اكتب_ملف("/اختبار_مؤقت", "test_data_123")
    متغير محتوى_مكتوب = beesh_اقرأ_ملف("/اختبار_مؤقت")
    إذا (محتوى_مكتوب == "test_data_123")
        اطبع_سطر("✓")
        متغير نجح = نجح + 1
    وإلا
        اطبع_سطر("✗")
        متغير فشل = فشل + 1
    نهاية

    # اختبار 6: نفّذ_أمر — مساعدة
    اطبع("  اختبار 6: نفذ_أمر('مساعدة')... ")
    متغير نتيجة_تنفيذ = نفّذ_أمر("مساعدة")
    إذا (نتيجة_تنفيذ == "")
        اطبع_سطر("✓")
        متغير نجح = نجح + 1
    وإلا
        اطبع_سطر("✗")
        متغير فشل = فشل + 1
    نهاية

    # اختبار 7: نفّذ_أمر — خروج
    اطبع("  اختبار 7: نفذ_أمر('خروج')... ")
    متغير نتيجة_خروج = نفّذ_أمر("خروج")
    إذا (نتيجة_خروج == "خروج")
        اطبع_سطر("✓")
        متغير نجح = نجح + 1
    وإلا
        اطبع_سطر("✗")
        متغير فشل = فشل + 1
    نهاية

    # اختبار 8: أمر_قرآن آية 1
    اطبع("  اختبار 8: أمر_قرآن(1)... ")
    أمر_قرآن("1")
    متغير نجح = نجح + 1
    اطبع_سطر("✓")

    رسم_شريط()
    اطبع_سطر("  نجح: " + نجح + " | فشل: " + فشل)
    رسم_شريط()
    ارجع نجح
نهاية

