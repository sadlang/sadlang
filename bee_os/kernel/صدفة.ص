##
## beesh_اقرأ_سطر_ps2 — يقرأ سطر إدخال من PS/2 keyboard
##
## على الأجهزة الحقيقية:
##   1. المقاطعة IRQ1 تُطلق كل ضغطة مفتاح
##   2. INB 0x60 → يُعطي scan code
##   3. جدول AT scancode → Unicode / ASCII
##   4. الحروف تُضاف لـ input_buffer حتى يضغط Enter (scan=0x1C)
##   5. BeeWhisper يُمرر البيانات من IRQ1 handler إلى shell process
##
## على المحاكاة (بلغة ص): نُحاكي بمصفوفة أوامر ثابتة
##
دالة beesh_اقرأ_سطر_ps2(رقم_أمر)
    # على الأجهزة الحقيقية: INB 0x60 → بناء string من scan codes
    # هنا نُحاكي تسلسل الإدخال من المستخدم
    متغير أوامر_تجريبية = [
        "مساعدة",
        "معلومات_نظام",
        "شجرة /",
        "اقرأ /bee/etc/بسم_الله",
        "اكتب /bee/رسالة السلام عليكم",
        "اقرأ /bee/رسالة",
        "قرآن 1",
        "قرآن 5",
        "أذان",
        "تاريخ",
        "احذف /bee/رسالة",
        "أنشئ_مجلد /bee/مستخدمون",
        "شجرة /",
        "خروج"
    ]
    إذا (رقم_أمر < أوامر_تجريبية.الطول())
        ارجع أوامر_تجريبية[رقم_أمر]
    نهاية
    ارجع "خروج"
نهاية

