#  الحلقة الرئيسية للصدفة
# ═══════════════════════════════════════════════

##
## beesh_ابدأ — نقطة الدخول الرئيسية لـ BeeSh
##
## تسلسل الإقلاع على الأجهزة الحقيقية:
##   1. kernel يُهيئ BeeWhisper channel: keyboard → shell
##   2. kernel يُنشئ shell process ويُكلّفه CPU core
##   3. shell يقرأ من channel (ring buffer) بدلاً من inb 0x60
##   4. يعالج الأمر ويكتب النتيجة على VGA
##
دالة beesh_ابدأ()
    اعرض_شعار_بيش()
    متغير رقم_إدخال = 0
    متغير تابع_التشغيل = صحيح

    بينما (تابع_التشغيل)
        # عرض محث الأوامر (Prompt): bee@beeos:/مسار$ 
        متغير محث = "🐝 bee@beeos:" + مجلد_حالي + "$ "
        اطبع(محث)

        # قراءة سطر الإدخال
        متغير سطر_مُدخل = beesh_اقرأ_سطر_ps2(رقم_إدخال)
        اطبع_سطر(سطر_مُدخل)

        # تنفيذ الأمر
        متغير نتيجة_أمر = نفّذ_أمر(سطر_مُدخل)

        # التحقق من طلب الخروج
        إذا (نتيجة_أمر == "خروج")
            متغير تابع_التشغيل = خطأ
        نهاية

        متغير رقم_إدخال = رقم_إدخال + 1

        # حماية من الحلقة اللانهائية في المحاكاة
        إذا (رقم_إدخال > 20)
            متغير تابع_التشغيل = خطأ
        نهاية
    نهاية
    ارجع 0
نهاية

