##
## شبكة.ص — BeeNectar: شبكة النحلة
## BeeNectar Network Stack: TCP/IP + UDP + bee:// protocol
##
## طبقات الشبكة:
##   طبقة 1 — MAC/Ethernet (محاكاة)
##   طبقة 2 — IPv4/IPv6
##   طبقة 3 — TCP + UDP
##   طبقة 4 — بروتوكول bee:// الخاص (إرسال رحيق المعلومات)
##
## بسم الله الرحمن الرحيم
##

# ─── ثوابت شبكة النحلة ───────────────────────────────────────────────────────

متغير BEENET_VERSION       = 1
متغير BEENET_MTU            = 1500      # حجم أكبر حزمة
متغير BEENET_BEE_PORT       = 6714      # 6=و, 7=ز, 1=ا, 4=د = وزاد
متغير BEENET_HTTP_PORT      = 80
متغير BEENET_HTTPS_PORT     = 443
متغير BEENET_DNS_PORT       = 53

# حالات TCP
متغير TCP_CLOSED           = 0
متغير TCP_LISTEN           = 1
متغير TCP_SYN_SENT         = 2
متغير TCP_SYN_RECV         = 3
متغير TCP_ESTABLISHED      = 4
متغير TCP_FIN_WAIT         = 5
متغير TCP_CLOSED_WAIT      = 6
متغير TCP_TIME_WAIT        = 7

# أنواع بروتوكول bee://
متغير BEE_MSG_NECTAR        = 1   # إرسال رحيق (بيانات)
متغير BEE_MSG_PRAYER        = 2   # دعاء (broadcast)
متغير BEE_MSG_QURAN         = 3   # إرسال آية قرآنية
متغير BEE_MSG_ADHAN         = 4   # نداء أذان
متغير BEE_MSG_ACK           = 5   # إيصال

# بروتوكولات
متغير PROTO_TCP             = 6
متغير PROTO_UDP             = 17
متغير PROTO_ICMP            = 1
متغير PROTO_BEE             = 250   # رقم خاص ببروتوكول النحلة

# ─── هياكل البيانات ──────────────────────────────────────────────────────────

متغير BEENET_جاهز           = خطأ
متغير BEENET_عنوان_ip       = "192.168.1.100"
متغير BEENET_subnet         = "255.255.255.0"
متغير BEENET_gateway        = "192.168.1.1"
متغير BEENET_mac            = "BE:EE:05:00:00:01"

متغير BEENET_مقابس          = []     # TCP sockets المفتوحة
متغير BEENET_حزم_منتظرة     = []     # queue
متغير BEENET_جدول_توجيه     = []     # routing table
متغير BEENET_إحصائيات       = {}

# ─── تهيئة شبكة النحلة ───────────────────────────────────────────────────────

