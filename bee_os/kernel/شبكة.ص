# ─── إنشاء مقبس TCP ──────────────────────────────────────────────────────────

دالة شبكة_مقبس_tcp(عنوان_بعيد، منفذ_بعيد)
   متغير مقبس = {}
   متغير id_مقبس = BEENET_مقابس.الطول()

   مقبس["id"]             = id_مقبس
   مقبس["بروتوكول"]       = PROTO_TCP
   مقبس["ip_محلي"]        = BEENET_عنوان_ip
   مقبس["منفذ_محلي"]      = 49152 + id_مقبس
   مقبس["ip_بعيد"]        = عنوان_بعيد
   مقبس["منفذ_بعيد"]      = منفذ_بعيد
   مقبس["حالة"]           = TCP_CLOSED
   مقبس["seq"]            = 1000 + id_مقبس * 100
   مقبس["ack"]            = 0
   مقبس["بيانات_انتظار"]  = ""
   مقبس["عداد_إرسال"]     = 0

   أضف(BEENET_مقابس، مقبس)
   BEENET_إحصائيات["مقابس_نشطة"] = BEENET_إحصائيات["مقابس_نشطة"] + 1

   اطبع_سطر("[TCP] مقبس جديد #" + id_مقبس + " → " + عنوان_بعيد + ":" + منفذ_بعيد)
   ارجع id_مقبس
نهاية

# ─── اتصال TCP (محاكاة Three-Way Handshake) ─────────────────────────────────

دالة شبكة_وصّل(id_مقبس)
   متغير مق = BEENET_مقابس[id_مقبس]
   اطبع_سطر("[TCP] ────────────── Three-Way Handshake ──────────────")

   # SYN
   مق["حالة"] = TCP_SYN_SENT
   BEENET_مقابس[id_مقبس] = مق
   اطبع_سطر("[TCP] → SYN  (seq=" + مق["seq"] + ") من " + مق["ip_محلي"])

   # SYN-ACK (محاكاة استجابة الخادم)
   مق["حالة"] = TCP_SYN_RECV
   BEENET_مقابس[id_مقبس] = مق
   اطبع_سطر("[TCP] ← SYN-ACK (ack=" + (مق["seq"] + 1) + ") من " + مق["ip_بعيد"])

   # ACK
   مق["ack"] = مق["seq"] + 1
   مق["seq"] = مق["seq"] + 1
   مق["حالة"] = TCP_ESTABLISHED
   BEENET_مقابس[id_مقبس] = مق
   اطبع_سطر("[TCP] → ACK  (ack=" + مق["ack"] + ")")
   اطبع_سطر("[TCP] ✓ الاتصال تأسس مع " + مق["ip_بعيد"] + ":" + مق["منفذ_بعيد"])
   اطبع_سطر("[TCP] ─────────────────────────────────────────────────")
   ارجع صحيح
نهاية

# ─── إرسال بيانات TCP ────────────────────────────────────────────────────────

دالة شبكة_أرسل(id_مقبس، رسالة_بيانات)
   متغير مق = BEENET_مقابس[id_مقبس]
   إذا (مق["حالة"] != TCP_ESTABLISHED)
      اطبع_سطر("[TCP] ❌ المقبس غير متصل (id=" + id_مقبس + ")")
      ارجع خطأ
   نهاية

   متغير حجم_رسالة = رسالة_بيانات.الطول()
   مق["عداد_إرسال"] = مق["عداد_إرسال"] + 1
   BEENET_مقابس[id_مقبس] = مق

   BEENET_إحصائيات["حزم_أُرسلت"]  = BEENET_إحصائيات["حزم_أُرسلت"] + 1
   BEENET_إحصائيات["بايت_صادر"]   = BEENET_إحصائيات["بايت_صادر"] + حجم_رسالة

   اطبع_سطر("[TCP] ↑ إرسال " + حجم_رسالة + " بايت (seq=" + مق["seq"] + ")")
   اطبع_سطر("[TCP]   البيانات: " + رسالة_بيانات)
   ارجع صحيح
نهاية

# ─── إغلاق TCP (FIN handshake) ───────────────────────────────────────────────

دالة شبكة_أغلق(id_مقبس)
   متغير مق = BEENET_مقابس[id_مقبس]
   اطبع_سطر("[TCP] → FIN من " + مق["ip_محلي"])
   مق["حالة"] = TCP_FIN_WAIT
   BEENET_مقابس[id_مقبس] = مق
   اطبع_سطر("[TCP] ← FIN-ACK من " + مق["ip_بعيد"])
   مق["حالة"] = TCP_TIME_WAIT
   BEENET_مقابس[id_مقبس] = مق
   اطبع_سطر("[TCP] → ACK نهائي")
   مق["حالة"] = TCP_CLOSED
   BEENET_مقابس[id_مقبس] = مق
   اطبع_سطر("[TCP] ✓ الاتصال أُغلق (id=" + id_مقبس + ")")
   BEENET_إحصائيات["مقابس_نشطة"] = BEENET_إحصائيات["مقابس_نشطة"] - 1
   ارجع صحيح
نهاية

# ─── UDP Send ────────────────────────────────────────────────────────────────

دالة شبكة_udp_أرسل(ip_وجهة، منفذ_وجهة، بيانات_udp)
   متغير حجم_بيانات = بيانات_udp.الطول()
   BEENET_إحصائيات["حزم_أُرسلت"] = BEENET_إحصائيات["حزم_أُرسلت"] + 1
   BEENET_إحصائيات["بايت_صادر"]  = BEENET_إحصائيات["بايت_صادر"] + حجم_بيانات

   اطبع_سطر("[UDP] ↑ " + BEENET_عنوان_ip + " → " + ip_وجهة + ":" + منفذ_وجهة)
   اطبع_سطر("[UDP]   " + حجم_بيانات + " بايت: " + بيانات_udp)
   ارجع صحيح
نهاية

# ─── بروتوكول bee:// ─────────────────────────────────────────────────────────

دالة شبكة_bee_أرسل(نوع_رسالة، ip_وجهة، المحتوى)
   متغير اسم_نوع = "NECTAR"
   إذا (نوع_رسالة == BEE_MSG_PRAYER)
      اسم_نوع = "PRAYER"
   نهاية
   إذا (نوع_رسالة == BEE_MSG_QURAN)
      اسم_نوع = "QURAN"
   نهاية
   إذا (نوع_رسالة == BEE_MSG_ADHAN)
      اسم_نوع = "ADHAN"
   نهاية
   إذا (نوع_رسالة == BEE_MSG_ACK)
      اسم_نوع = "ACK"
   نهاية

   متغير مقبس_bee = شبكة_مقبس_tcp(ip_وجهة، BEENET_BEE_PORT)
   شبكة_وصّل(مقبس_bee)

   متغير حزمة = "BEE/1.0 " + اسم_نوع + " | " + المحتوى
   شبكة_أرسل(مقبس_bee، حزمة)

   # محاكاة استجابة ACK من الطرف الآخر
   BEENET_إحصائيات["حزم_وُصلت"] = BEENET_إحصائيات["حزم_وُصلت"] + 1
   اطبع_سطر("[bee://] ← ACK من " + ip_وجهة)

   شبكة_أغلق(مقبس_bee)
   اطبع_سطر("[bee://] ✓ bee://" + ip_وجهة + "/" + اسم_نوع + " تم الإرسال")
   ارجع صحيح
نهاية

# ─── ICMP Ping ───────────────────────────────────────────────────────────────

دالة شبكة_ping(ip_مستهدف)
   اطبع_سطر("[ICMP] → PING " + ip_مستهدف)
   BEENET_إحصائيات["حزم_أُرسلت"] = BEENET_إحصائيات["حزم_أُرسلت"] + 1

   # محاكاة استجابة (يفترض أن الخادم يرد)
   متغير زمن_رد = 3
   BEENET_إحصائيات["حزم_وُصلت"] = BEENET_إحصائيات["حزم_وُصلت"] + 1
   اطبع_سطر("[ICMP] ← PONG من " + ip_مستهدف + " (time=" + زمن_رد + "ms)")
   ارجع زمن_رد
نهاية

# ─── DNS Resolution ──────────────────────────────────────────────────────────

دالة شبكة_dns_حلّل(اسم_نطاق)
   اطبع_سطر("[DNS] استعلام: " + اسم_نطاق)
   # جدول DNS داخلي بسيط
   متغير ip_محلول = "0.0.0.0"
   إذا (اسم_نطاق == "bee.os")
      ip_محلول = "10.0.0.1"
   نهاية
   إذا (اسم_نطاق == "quran.bee.os")
      ip_محلول = "10.0.0.2"
   نهاية
   إذا (اسم_نطاق == "gateway.bee.os")
      ip_محلول = BEENET_gateway
   نهاية
   إذا (اسم_نطاق == "localhost")
      ip_محلول = "127.0.0.1"
   نهاية
   اطبع_سطر("[DNS] " + اسم_نطاق + " → " + ip_محلول)
   ارجع ip_محلول
نهاية

