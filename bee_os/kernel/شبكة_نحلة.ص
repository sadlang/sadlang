## الحصول على MMIO base من BAR0
دالة e1000_get_mmio_base()
    متغير bar0 = net_pci_read(nic_pci_bus، nic_pci_dev، 0، 16) + 0
    # Memory BAR: bit 0 = 0
    إذا (bar0 % 2 == 0)
        nic_mmio_base = bar0 - (bar0 % 16)   # mask lower 4 bits
    نهاية
    net_serial_اطبع("[E1000] MMIO Base: ")
    net_serial_رقم(nic_mmio_base)
