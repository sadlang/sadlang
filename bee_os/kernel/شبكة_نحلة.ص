    نهاية
    متغير m1 = sad_ll_mem_read8(pkt_addr + 1) + 0
    إذا (m1 != mac_1)
        ارجع 0
    نهاية
    متغير m2 = sad_ll_mem_read8(pkt_addr + 2) + 0
    إذا (m2 != mac_2)
        ارجع 0
    نهاية
    متغير m3 = sad_ll_mem_read8(pkt_addr + 3) + 0
    إذا (m3 != mac_3)
        ارجع 0
    نهاية
    متغير m4 = sad_ll_mem_read8(pkt_addr + 4) + 0
    إذا (m4 != mac_4)
        ارجع 0
    نهاية
    متغير m5 = sad_ll_mem_read8(pkt_addr + 5) + 0
    إذا (m5 != mac_5)
        ارجع 0
