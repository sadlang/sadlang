## إعادة تعيين E1000
دالة e1000_reset()
    # Set RST bit
    متغير ctrl = e1000_read(E1000_CTRL) + 0
    e1000_write(E1000_CTRL، ctrl + E1000_CTRL_RST)
    
    # Wait
    متغير w = 0
    بينما (w < 100000)
        w = w + 1
    نهاية
    
    # Clear interrupts
    e1000_write(E1000_IMC، 4294967295)  # 0xFFFFFFFF — mask all
    e1000_read(E1000_ICR)                # read to clear
    
    net_serial_اطبع("[E1000] Reset complete\n")
    ارجع 1
نهاية

## قراءة EEPROM الخاصة بعنوان MAC
دالة e1000_eeprom_read(eeaddr)
    # Write address with start bit
    e1000_write(E1000_EERD، 1 + (eeaddr * 256))
    
    # Wait for done (bit 4)
    متغير timeout = 0
    بينما (timeout < 100000)
        متغير val = e1000_read(E1000_EERD) + 0
        إذا ((val / 16) % 2 == 1)
            ارجع (val / 65536) % 65536  # bits 31:16 = data
        نهاية
        timeout = timeout + 1
    نهاية
    ارجع 0
نهاية

## قراءة MAC من EEPROM
دالة e1000_read_mac()
    متغير word0 = e1000_eeprom_read(0) + 0
    متغير word1 = e1000_eeprom_read(1) + 0
    متغير word2 = e1000_eeprom_read(2) + 0
    
    mac_0 = word0 % 256
    mac_1 = (word0 / 256) % 256
    mac_2 = word1 % 256
    mac_3 = (word1 / 256) % 256
    mac_4 = word2 % 256
    mac_5 = (word2 / 256) % 256
    
    # Write MAC to RAL0/RAH0
    e1000_write(E1000_RAL0، word0 + (word1 * 65536))
    e1000_write(E1000_RAH0، word2 + 2147483648)  # + AV bit (bit 31)
    
    net_serial_اطبع("[E1000] MAC: ")
    net_serial_mac()
    sad_ll_serial_write_char(COM1، 10)
    ارجع 0
نهاية

## تخصيص descriptors وbuffers
دالة e1000_alloc_descriptors()
    # RX descriptors: 32 × 16 bytes = 512 bytes (aligned)
    rx_desc_addr = sad_ll_kmalloc(NUM_RX_DESC * DESC_SIZE + 128) + 0
    إذا (rx_desc_addr == 0)
        net_serial_اطبع("[E1000] Failed to allocate RX descriptors!\n")
        ارجع 0
    نهاية
    # Align to 128
    rx_desc_addr = rx_desc_addr + (128 - (rx_desc_addr % 128)) % 128
    sad_ll_memset(rx_desc_addr، 0، NUM_RX_DESC * DESC_SIZE)
    
    # TX descriptors: 32 × 16 bytes
    tx_desc_addr = sad_ll_kmalloc(NUM_RX_DESC * DESC_SIZE + 128) + 0
    إذا (tx_desc_addr == 0)
        net_serial_اطبع("[E1000] Failed to allocate TX descriptors!\n")
        ارجع 0
    نهاية
    tx_desc_addr = tx_desc_addr + (128 - (tx_desc_addr % 128)) % 128
    sad_ll_memset(tx_desc_addr، 0، NUM_RX_DESC * DESC_SIZE)
    
    # Allocate RX buffers and fill descriptors
    متغير ت = 0
    بينما (ت < NUM_RX_DESC)
        متغير buf = sad_ll_kmalloc(2048) + 0
        إذا (buf == 0)
            ارجع 0
        نهاية
        sad_ll_memset(buf، 0، 2048)
        
        # Write descriptor: addr_lo(4), addr_hi(4), length(2), checksum(2), status(1), errors(1), special(2)
        متغير desc_addr = rx_desc_addr + (ت * DESC_SIZE)
        sad_ll_mem_write32(desc_addr، buf)        # buffer address low
        sad_ll_mem_write32(desc_addr + 4، 0)       # buffer address high
        
        ت = ت + 1
    نهاية
    
    # Allocate TX buffer pool  
    rx_buffer_addr = sad_ll_kmalloc(2048) + 0  # Reuse for general recv buffer
    
    net_serial_اطبع("[E1000] Descriptors allocated: RX=")
    net_serial_رقم(rx_desc_addr)
    net_serial_اطبع(" TX=")
    net_serial_رقم(tx_desc_addr)
    sad_ll_serial_write_char(COM1، 10)
    ارجع 1
نهاية

## إعداد RX في E1000
دالة e1000_setup_rx()
    # Set RX descriptor base
    e1000_write(E1000_RDBAL، rx_desc_addr)
    e1000_write(E1000_RDBAH، 0)
    
    # Descriptor ring length (bytes)
    e1000_write(E1000_RDLEN، NUM_RX_DESC * DESC_SIZE)
    
    # Head = 0, Tail = NUM_RX_DESC - 1
    e1000_write(E1000_RDH، 0)
    e1000_write(E1000_RDT، NUM_RX_DESC - 1)
    rx_desc_tail = NUM_RX_DESC - 1
    
    # RX Control: EN(1) + SBP(2) + UPE(3) + MPE(4) + BAM(15) + BSIZE=2048(BSEX=0, BSIZE=00) + SECRC(26)
    # EN=2, SBP=4, UPE=8, MPE=16, BAM=32768, SECRC=67108864
    # Total: 2+8+16+32768+67108864 = 67141658
    e1000_write(E1000_RCTL، 67141658)
    
    net_serial_اطبع("[E1000] RX configured\n")
    ارجع 0
نهاية

## إعداد TX في E1000
دالة e1000_setup_tx()
    e1000_write(E1000_TDBAL، tx_desc_addr)
    e1000_write(E1000_TDBAH، 0)
    e1000_write(E1000_TDLEN، NUM_RX_DESC * DESC_SIZE)
    e1000_write(E1000_TDH، 0)
    e1000_write(E1000_TDT، 0)
    tx_desc_tail = 0
    
    # TX Control: EN(1) + PSP(3) + CT=0x0F(bits 11:4) + COLD=0x3F(bits 21:12)
    # EN=2, PSP=8, CT=240, COLD=258048
    e1000_write(E1000_TCTL، 258298)
    
    net_serial_اطبع("[E1000] TX configured\n")
    ارجع 0
نهاية

## تهيئة E1000
دالة e1000_init()
    net_serial_اطبع("[E1000] Initializing E1000...\n")
    
    net_enable_bus_master()
    e1000_get_mmio_base()
    
    إذا (nic_mmio_base == 0)
        net_serial_اطبع("[E1000] Invalid MMIO base!\n")
        ارجع 0
    نهاية
    
    e1000_reset()
    e1000_read_mac()
    
    إذا (e1000_alloc_descriptors() == 0)
        ارجع 0
    نهاية
    
    # Set Link Up
    متغير ctrl = e1000_read(E1000_CTRL) + 0
    ctrl = ctrl + E1000_CTRL_SLU
    e1000_write(E1000_CTRL، ctrl)
    
    e1000_setup_rx()
    e1000_setup_tx()
    
    # Enable interrupts
    e1000_write(E1000_IMS، 253)  # 0xFD — LSC, RXO, RXDMT, RXT
    
    شبكة_جاهزة = 1
    
    # Check link status
    متغير status = e1000_read(E1000_STATUS) + 0
    إذا ((status / 2) % 2 == 1)
        شبكة_رابط_فعال = 1
        net_serial_اطبع("[E1000] Link is UP\n")
    نهاية
    إذا ((status / 2) % 2 == 0)
        شبكة_رابط_فعال = 0
        net_serial_اطبع("[E1000] Link is DOWN\n")
    نهاية
    
    net_serial_اطبع("[E1000] E1000 initialized OK\n")
    ارجع 1
نهاية

## إرسال حزمة عبر E1000
دالة e1000_send(بيانات_عنوان، الحجم)
    إذا (شبكة_جاهزة == 0)
        ارجع 0
    نهاية
    
    # Get TX buffer
    متغير buf = sad_ll_kmalloc(الحجم + 64) + 0
    إذا (buf == 0)
        ارجع 0
    نهاية
    sad_ll_memcpy(buf، بيانات_عنوان، الحجم)
    
    # Fill TX descriptor
    متغير desc = tx_desc_addr + (tx_desc_tail * DESC_SIZE)
    sad_ll_mem_write32(desc، buf)          # buffer addr low
    sad_ll_mem_write32(desc + 4، 0)         # buffer addr high
    
    # Length + CMD: RS(3)+EOP(0)+IFCS(1) = 0x0B = 11
    # cmd(byte8) = 11, length in lower bytes
    sad_ll_mem_write32(desc + 8، الحجم + (11 * 16777216))  # size + cmd<<24
    sad_ll_mem_write32(desc + 12، 0)        # status
    
    tx_desc_tail = (tx_desc_tail + 1) % NUM_RX_DESC
    e1000_write(E1000_TDT، tx_desc_tail)
    
    إجمالي_tx = إجمالي_tx + 1
    بايت_مرسلة = بايت_مرسلة + الحجم
    
    ارجع 1
نهاية

## استقبال حزمة من E1000
دالة e1000_recv(dest_addr، max_size)
    إذا (شبكة_جاهزة == 0)
        ارجع 0
    نهاية
    
    متغير next_tail = (rx_desc_tail + 1) % NUM_RX_DESC
    متغير desc = rx_desc_addr + (next_tail * DESC_SIZE)
    
    # Check DD (Descriptor Done) bit in status byte (offset 12, bit 0)
    متغير status = sad_ll_mem_read32(desc + 12) + 0
    متغير dd = status % 2
    
    إذا (dd == 0)
        ارجع 0  # No packet
    نهاية
    
    # Get length (offset 8, bits 15:0)
    متغير len_cmd = sad_ll_mem_read32(desc + 8) + 0
    متغير pkt_len = len_cmd % 65536
    
    إذا (pkt_len > max_size)
        pkt_len = max_size
    نهاية
    
    # Get buffer address
    متغير buf_addr = sad_ll_mem_read32(desc) + 0
    sad_ll_memcpy(dest_addr، buf_addr، pkt_len)
    
    # Reset descriptor
    sad_ll_mem_write32(desc + 12، 0)  # clear status
    
    rx_desc_tail = next_tail
    e1000_write(E1000_RDT، rx_desc_tail)
    
    إجمالي_rx = إجمالي_rx + 1
    بايت_مستقبلة = بايت_مستقبلة + pkt_len
    
    ارجع pkt_len
نهاية

