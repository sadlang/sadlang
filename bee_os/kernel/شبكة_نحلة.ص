## بناء رأس Ethernet في عنوان معين
صدّر دالة eth_build_header(buf، dst_0، dst_1، dst_2، dst_3، dst_4، dst_5، ether_type)
    # Destination MAC (6 bytes)
    sad_ll_mem_write8(buf، dst_0)
    sad_ll_mem_write8(buf + 1، dst_1)
    sad_ll_mem_write8(buf + 2، dst_2)
    sad_ll_mem_write8(buf + 3، dst_3)
    sad_ll_mem_write8(buf + 4، dst_4)
    sad_ll_mem_write8(buf + 5، dst_5)
    
    # Source MAC (our MAC)
    sad_ll_mem_write8(buf + 6، mac_0)
    sad_ll_mem_write8(buf + 7، mac_1)
    sad_ll_mem_write8(buf + 8، mac_2)
    sad_ll_mem_write8(buf + 9، mac_3)
    sad_ll_mem_write8(buf + 10، mac_4)
    sad_ll_mem_write8(buf + 11، mac_5)
    
    # EtherType (big-endian)
    sad_ll_mem_write8(buf + 12، (ether_type / 256) % 256)
    sad_ll_mem_write8(buf + 13، ether_type % 256)
    
    ارجع ETH_HEADER_SIZE
نهاية

## إرسال إطار Ethernet كامل (broadcast)
صدّر دالة eth_send_broadcast(payload_addr، payload_len، ether_type)
    متغير frame = sad_ll_kmalloc(ETH_MAX_FRAME) + 0
    إذا (frame == 0)
        ارجع 0
    نهاية
    
    # Broadcast MAC: FF:FF:FF:FF:FF:FF
    eth_build_header(frame، 255، 255، 255، 255، 255، 255، ether_type)
    
    # Copy payload
    sad_ll_memcpy(frame + ETH_HEADER_SIZE، payload_addr، payload_len)
    
    متغير total = ETH_HEADER_SIZE + payload_len
    متغير result = net_send(frame، total) + 0
    
    sad_ll_kfree(frame)
    ارجع result
نهاية

