دالة net_serial_رقم(ن)
    إذا (ن < 0)
        sad_ll_serial_write_char(COM1، 45)
        ن = 0 - ن
    نهاية
    إذا (ن == 0)
        sad_ll_serial_write_char(COM1، 48)
        ارجع 0
    نهاية
    # تحويل رقم إلى نص
    متغير أرقام = 0
    متغير مؤقت = ن + 0
    بينما (مؤقت > 0)
        أرقام = أرقام + 1
        مؤقت = مؤقت / 10
    نهاية
    متغير قاسم = 1
    متغير ع = 1
    بينما (ع < أرقام)
        قاسم = قاسم * 10
        ع = ع + 1
    نهاية
    بينما (قاسم > 0)
        متغير رقمي = (ن / قاسم) % 10
        sad_ll_serial_write_char(COM1، 48 + رقمي)
        قاسم = قاسم / 10
    نهاية
    ارجع 0
نهاية

دالة net_serial_hex8(ن)
    متغير عالي = (ن / 16) % 16
    متغير سفلي = ن % 16
    إذا (عالي < 10)
        sad_ll_serial_write_char(COM1، 48 + عالي)
    نهاية
    إذا (عالي >= 10)
        sad_ll_serial_write_char(COM1، 55 + عالي)
    نهاية
    إذا (سفلي < 10)
        sad_ll_serial_write_char(COM1، 48 + سفلي)
    نهاية
    إذا (سفلي >= 10)
        sad_ll_serial_write_char(COM1، 55 + سفلي)
    نهاية
    ارجع 0
نهاية

