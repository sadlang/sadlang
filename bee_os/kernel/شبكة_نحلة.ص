## تهيئة نظام الشبكة
صدّر دالة net_هيئ()
    net_serial_اطبع("[NET] === Network System Init ===\n")
    
    # Scan PCI bus
    إذا (net_pci_scan() == 0)
        net_serial_اطبع("[NET] No NIC found — networking disabled\n")
        ارجع 0
    نهاية
    
    # Initialize NIC
    متغير نتيجة = 0
    إذا (nic_نوع == NIC_RTL8139)
        نتيجة = rtl_init() + 0
    نهاية
    إذا (nic_نوع == NIC_E1000)
        نتيجة = e1000_init() + 0
    نهاية
    
    إذا (نتيجة == 0)
        net_serial_اطبع("[NET] NIC init failed!\n")
        ارجع 0
    نهاية
    
    net_serial_اطبع("[NET] Network ready: ")
    net_serial_mac()
    net_serial_اطبع(" @ ")
    net_serial_ip(ip_0، ip_1، ip_2، ip_3)
    sad_ll_serial_write_char(COM1، 10)
    
    ارجع 1
نهاية

## دورة استقبال الشبكة (يُستدعى دورياً)
صدّر دالة net_دورة()
    إذا (شبكة_جاهزة == 0)
        ارجع 0
    نهاية
    
    # فحص حالة الرابط
    net_فحص_رابط()
    
    # محاولة استقبال حزم
    متغير pkt_buf = sad_ll_kmalloc(ETH_MAX_FRAME) + 0
    إذا (pkt_buf == 0)
        ارجع 0
    نهاية
    
    متغير حزم_معالجة = 0
    متغير len = net_recv(pkt_buf، ETH_MAX_FRAME) + 0
    
    بينما (len > 0)
        # Check if for us
        إذا (eth_is_for_us(pkt_buf) == 1)
            متغير etype = eth_parse_type(pkt_buf) + 0
            
            # Route to protocol handler
            إذا (etype == ETHER_TYPE_ARP)
                # ARP — handled by arp module
                net_serial_اطبع("[NET] ARP packet received\n")
            نهاية
            إذا (etype == ETHER_TYPE_IP)
                # IP — handled by ip module
                net_serial_اطبع("[NET] IP packet received\n")
            نهاية
            
            حزم_معالجة = حزم_معالجة + 1
        نهاية
        إذا (eth_is_for_us(pkt_buf) == 0)
            إطارات_dropped = إطارات_dropped + 1
        نهاية
        
        إذا (حزم_معالجة > 16)
            اخرج  # Process max 16 packets per cycle
        نهاية
        
        len = net_recv(pkt_buf، ETH_MAX_FRAME) + 0
    نهاية
    
    sad_ll_kfree(pkt_buf)
    ارجع حزم_معالجة
نهاية
