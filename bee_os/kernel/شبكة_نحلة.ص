        متغير status = e1000_read(E1000_STATUS) + 0
        إذا ((status / 2) % 2 == 1)
            شبكة_رابط_فعال = 1
        نهاية
        إذا ((status / 2) % 2 == 0)
            شبكة_رابط_فعال = 0
        نهاية
    نهاية
    ارجع شبكة_رابط_فعال + 0
نهاية

