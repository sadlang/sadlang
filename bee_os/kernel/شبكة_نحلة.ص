#                    PCI Bus Scan for NICs
# ═══════════════════════════════════════════════════════════════════════════════

## مسح ناقل PCI للبحث عن بطاقة شبكة
دالة net_pci_scan()
    net_serial_اطبع("[NET] Scanning PCI bus for NIC...\n")
    
    متغير bus = 0
    بينما (bus < 256)
        متغير dev = 0
        بينما (dev < 32)
            متغير vendor_device = net_pci_read(bus، dev، 0، 0) + 0
            متغير vendor = vendor_device % 65536
            متغير device = (vendor_device / 65536) % 65536
            
            # Check for RTL8139
            إذا (vendor == PCI_VENDOR_REALTEK)
                إذا (device == PCI_DEVICE_8139)
                    net_serial_اطبع("[NET] Found RTL8139 at PCI ")
                    net_serial_رقم(bus)
                    sad_ll_serial_write_char(COM1، 58)
                    net_serial_رقم(dev)
                    sad_ll_serial_write_char(COM1، 10)
                    
                    nic_نوع = NIC_RTL8139
                    nic_pci_bus = bus + 0
                    nic_pci_dev = dev + 0
                    nic_pci_fn = 0
                    ارجع 1
                نهاية
            نهاية
            
            # Check for E1000
            إذا (vendor == PCI_VENDOR_INTEL)
                إذا (device == PCI_DEVICE_E1000)
                    net_serial_اطبع("[NET] Found E1000 at PCI ")
                    net_serial_رقم(bus)
                    sad_ll_serial_write_char(COM1، 58)
                    net_serial_رقم(dev)
                    sad_ll_serial_write_char(COM1، 10)
                    
                    nic_نوع = NIC_E1000
                    nic_pci_bus = bus + 0
                    nic_pci_dev = dev + 0
                    nic_pci_fn = 0
                    ارجع 1
                نهاية
            نهاية
            
            dev = dev + 1
        نهاية
        bus = bus + 1
    نهاية
    
    net_serial_اطبع("[NET] No supported NIC found\n")
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
#                        RTL8139 Driver
# ═══════════════════════════════════════════════════════════════════════════════

## قراءة BAR0 للحصول على IO Base
دالة rtl_get_io_base()
    # BAR0 at PCI config offset 0x10
    متغير bar0 = net_pci_read(nic_pci_bus، nic_pci_dev، 0، 16) + 0
    # IO BAR: bit 0 = 1
    إذا (bar0 % 2 == 1)
        nic_io_base = bar0 - 1   # mask out bit 0
    نهاية
    إذا (bar0 % 2 == 0)
        nic_io_base = bar0 + 0
    نهاية
    net_serial_اطبع("[RTL] IO Base: ")
    net_serial_رقم(nic_io_base)
    sad_ll_serial_write_char(COM1، 10)
    ارجع nic_io_base
نهاية

## تمكين Bus Mastering في PCI
دالة net_enable_bus_master()
    متغير cmd = net_pci_read(nic_pci_bus، nic_pci_dev، 0، 4) + 0
    cmd = cmd % 65536   # lower 16 bits = command
    # Set bits: IO(0), Memory(1), Bus Master(2) = 7
    cmd = cmd + 7 - (cmd % 8)
    # Write back just lower 16 bits (command)
    net_pci_write(nic_pci_bus، nic_pci_dev، 0، 4، cmd)
    net_serial_اطبع("[NET] Bus mastering enabled\n")
    ارجع 0
نهاية

## إعادة تعيين RTL8139
دالة rtl_reset()
    # Power on
    sad_ll_port_outb(nic_io_base + RTL_CONFIG1، 0)
    
    # Software reset
    sad_ll_port_outb(nic_io_base + RTL_CMD، RTL_CMD_RESET)
    
    # Wait for reset to complete (bit 4 clears)
    متغير timeout = 0
    بينما (timeout < 10000)
        متغير cmd = sad_ll_port_inb(nic_io_base + RTL_CMD) + 0
        إذا ((cmd / 16) % 2 == 0)
            net_serial_اطبع("[RTL] Reset complete\n")
            ارجع 1
        نهاية
        timeout = timeout + 1
    نهاية
    
    net_serial_اطبع("[RTL] Reset timeout!\n")
    ارجع 0
نهاية

## قراءة عنوان MAC من RTL8139
دالة rtl_read_mac()
    mac_0 = sad_ll_port_inb(nic_io_base + RTL_IDR0) + 0
    mac_1 = sad_ll_port_inb(nic_io_base + RTL_IDR0 + 1) + 0
    mac_2 = sad_ll_port_inb(nic_io_base + RTL_IDR0 + 2) + 0
    mac_3 = sad_ll_port_inb(nic_io_base + RTL_IDR0 + 3) + 0
    mac_4 = sad_ll_port_inb(nic_io_base + RTL_IDR0 + 4) + 0
    mac_5 = sad_ll_port_inb(nic_io_base + RTL_IDR0 + 5) + 0
    
    net_serial_اطبع("[RTL] MAC: ")
    net_serial_mac()
    sad_ll_serial_write_char(COM1، 10)
    ارجع 0
نهاية

## تخصيص مخازن RX/TX لـ RTL8139
دالة rtl_alloc_buffers()
    # RX buffer: 8K + 16 + 1500 (wrap)
    rx_buffer_addr = sad_ll_kmalloc(RX_BUF_SIZE + 1516) + 0
    إذا (rx_buffer_addr == 0)
        net_serial_اطبع("[RTL] Failed to allocate RX buffer!\n")
        ارجع 0
    نهاية
    sad_ll_memset(rx_buffer_addr، 0، RX_BUF_SIZE + 1516)
    
    # TX buffers: 4 × 1536
    tx_buffer_0 = sad_ll_kmalloc(TX_BUF_SIZE) + 0
    tx_buffer_1 = sad_ll_kmalloc(TX_BUF_SIZE) + 0
    tx_buffer_2 = sad_ll_kmalloc(TX_BUF_SIZE) + 0
    tx_buffer_3 = sad_ll_kmalloc(TX_BUF_SIZE) + 0
    
    إذا (tx_buffer_0 == 0)
        net_serial_اطبع("[RTL] Failed to allocate TX buffer!\n")
        ارجع 0
    نهاية
    
    sad_ll_memset(tx_buffer_0، 0، TX_BUF_SIZE)
    sad_ll_memset(tx_buffer_1، 0، TX_BUF_SIZE)
    sad_ll_memset(tx_buffer_2، 0، TX_BUF_SIZE)
    sad_ll_memset(tx_buffer_3، 0، TX_BUF_SIZE)
    
    net_serial_اطبع("[RTL] Buffers allocated: RX=")
    net_serial_رقم(rx_buffer_addr)
    net_serial_اطبع(" TX0=")
    net_serial_رقم(tx_buffer_0)
    sad_ll_serial_write_char(COM1، 10)
    ارجع 1
نهاية

## تهيئة RTL8139
دالة rtl_init()
    net_serial_اطبع("[RTL] Initializing RTL8139...\n")
    
    # Enable bus mastering
    net_enable_bus_master()
    
    # Get IO base
    rtl_get_io_base()
    
    # Reset
    إذا (rtl_reset() == 0)
        ارجع 0
    نهاية
    
    # Read MAC
    rtl_read_mac()
    
    # Allocate buffers
    إذا (rtl_alloc_buffers() == 0)
        ارجع 0
    نهاية
    
    # Set RX buffer address
    sad_ll_port_outl(nic_io_base + RTL_RBSTART، rx_buffer_addr)
    
    # Set TX buffer addresses
    sad_ll_port_outl(nic_io_base + RTL_TSAD0، tx_buffer_0)
    sad_ll_port_outl(nic_io_base + RTL_TSAD0 + 4، tx_buffer_1)
    sad_ll_port_outl(nic_io_base + RTL_TSAD0 + 8، tx_buffer_2)
    sad_ll_port_outl(nic_io_base + RTL_TSAD0 + 12، tx_buffer_3)
    
    # Configure RX: Accept all, wrap, max DMA burst
    # AB(bit3)+AM(bit2)+APM(bit1)+AAP(bit0) + WRAP(bit7) = 0x8F = 143
    sad_ll_port_outl(nic_io_base + RTL_RCR، 143)
    
    # TX Config: default DMA burst
    sad_ll_port_outl(nic_io_base + RTL_TCR، 768)  # 0x0300 — IFG=normal, DMA=1024
    
    # Enable interrupts (ROK=0x01, TOK=0x04)
    sad_ll_port_outw(nic_io_base + RTL_IMR، 5)
    
    # Enable RX + TX
    sad_ll_port_outb(nic_io_base + RTL_CMD، RTL_CMD_RX_ENABLE + RTL_CMD_TX_ENABLE)
    
    tx_current = 0
    شبكة_جاهزة = 1
    شبكة_رابط_فعال = 1
    
    net_serial_اطبع("[RTL] RTL8139 initialized OK\n")
    ارجع 1
نهاية

## إرسال حزمة عبر RTL8139
دالة rtl_send(بيانات_عنوان، الحجم)
    إذا (شبكة_جاهزة == 0)
        ارجع 0
    نهاية
    
    إذا (الحجم > ETH_MTU + ETH_HEADER_SIZE)
        ارجع 0
    نهاية
    
    # Pad to minimum frame size
    متغير حجم_فعلي = الحجم + 0
    إذا (حجم_فعلي < ETH_MIN_FRAME)
        حجم_فعلي = ETH_MIN_FRAME
    نهاية
    
    # Get current TX buffer
    متغير tx_addr = tx_buffer_0
    إذا (tx_current == 1)
        tx_addr = tx_buffer_1
    نهاية
    إذا (tx_current == 2)
        tx_addr = tx_buffer_2
    نهاية
    إذا (tx_current == 3)
        tx_addr = tx_buffer_3
    نهاية
    
    # Copy data to TX buffer
    sad_ll_memcpy(tx_addr، بيانات_عنوان، الحجم)
    
    # Pad if needed
    إذا (حجم_فعلي > الحجم)
        sad_ll_memset(tx_addr + الحجم، 0، حجم_فعلي - الحجم)
    نهاية
    
    # Write TX start address (TSD register — offset 0x10 + desc*4)
    # Status: size in bits 12:0 (writing size starts TX)
    متغير tsd_offset = RTL_TSD0 + (tx_current * 4)
    sad_ll_port_outl(nic_io_base + tsd_offset، حجم_فعلي)
    
    # Wait for TX complete (bit 15 = TOK)
    متغير timeout = 0
    بينما (timeout < 100000)
        متغير status = sad_ll_port_inl(nic_io_base + tsd_offset) + 0
        إذا ((status / 32768) % 2 == 1)
            # TX complete
            إجمالي_tx = إجمالي_tx + 1
            بايت_مرسلة = بايت_مرسلة + حجم_فعلي
            tx_current = (tx_current + 1) % NUM_TX_DESC
            ارجع 1
        نهاية
        # Check for TX error (bit 14 = TUN)
        إذا ((status / 16384) % 2 == 1)
            أخطاء_tx = أخطاء_tx + 1
            tx_current = (tx_current + 1) % NUM_TX_DESC
            ارجع 0
        نهاية
        timeout = timeout + 1
    نهاية
    
    أخطاء_tx = أخطاء_tx + 1
    tx_current = (tx_current + 1) % NUM_TX_DESC
    ارجع 0
نهاية

## قراءة حزمة من RTL8139
دالة rtl_recv(dest_addr، max_size)
    إذا (شبكة_جاهزة == 0)
        ارجع 0
    نهاية
    
    # Check for empty buffer (CMD bit 0 = BUFE)
    متغير cmd = sad_ll_port_inb(nic_io_base + RTL_CMD) + 0
    إذا (cmd % 2 == 1)
        ارجع 0  # Buffer empty
    نهاية
    
    # Read CAPR (current read offset)
    متغير capr = sad_ll_port_inw(nic_io_base + RTL_CAPR) + 0
    متغير offset = (capr + 16) % RX_BUF_SIZE
    
    # Read packet header: status(2) + length(2)
    متغير hdr_lo = sad_ll_mem_read8(rx_buffer_addr + offset) + 0
    متغير hdr_hi = sad_ll_mem_read8(rx_buffer_addr + offset + 1) + 0
    متغير pkt_status = hdr_lo + (hdr_hi * 256)
    
    متغير len_lo = sad_ll_mem_read8(rx_buffer_addr + offset + 2) + 0
    متغير len_hi = sad_ll_mem_read8(rx_buffer_addr + offset + 3) + 0
    متغير pkt_len = len_lo + (len_hi * 256)
    
    # Check ROK (bit 0)
    إذا (pkt_status % 2 == 0)
        أخطاء_rx = أخطاء_rx + 1
        # Skip bad packet
        متغير new_capr = (offset + pkt_len + 4 + 3) - ((offset + pkt_len + 4 + 3) % 4)
        new_capr = (new_capr % RX_BUF_SIZE) - 16
        sad_ll_port_outw(nic_io_base + RTL_CAPR، new_capr)
        ارجع 0
    نهاية
    
    # Actual data size (minus 4 for FCS)
    متغير data_len = pkt_len - 4
    إذا (data_len > max_size)
        data_len = max_size
    نهاية
    إذا (data_len < 0)
        data_len = 0
    نهاية
    
    # Copy packet data
    sad_ll_memcpy(dest_addr، rx_buffer_addr + offset + 4، data_len)
    
    # Update CAPR
    متغير new_capr2 = (offset + pkt_len + 4 + 3) - ((offset + pkt_len + 4 + 3) % 4)
    new_capr2 = (new_capr2 % RX_BUF_SIZE) - 16
    sad_ll_port_outw(nic_io_base + RTL_CAPR، new_capr2)
    
    إجمالي_rx = إجمالي_rx + 1
    بايت_مستقبلة = بايت_مستقبلة + data_len
    
    ارجع data_len
نهاية

