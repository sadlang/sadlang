## ─── أمر ls ──────────────────────────────────────────
دالة أمر_ls()
    # تحليل المسار الحالي
    متغير عقدة = shell_حلل_المسار(DEFAULT_MOUNT، cwd_عنوان، cwd_طول)
    إذا (عقدة < 0)
        vga_ضع_لون(VGA_RED_BLACK)
        # "Error: path not found"
        vga_حرف(69)
        vga_حرف(114)
        vga_حرف(114)
        vga_حرف(10)
        vga_ضع_لون(VGA_WHITE_BLACK)
        ارجع
    نهاية
    
    # قراءة الدليل
    متغير عدد = shell_اقرأ_دليل(DEFAULT_MOUNT، عقدة، work_عنوان، 64)
    
    إذا (عدد <= 0)
        # "(empty)"
        vga_حرف(40)
        vga_حرف(101)
        vga_حرف(109)
        vga_حرف(112)
        vga_حرف(116)
        vga_حرف(121)
        vga_حرف(41)
        vga_حرف(10)
        ارجع
    نهاية
    
    متغير م = 0
    بينما (م < عدد)
        متغير عنوان_مد = work_عنوان + (م * 32)
        متغير عقدة_مد = shell_اقرأ_ذاكرة32(عنوان_مد)
        متغير نوع_مد = shell_اقرأ_ذاكرة16(عنوان_مد + 4)
        متغير طول_مد = shell_اقرأ_ذاكرة16(عنوان_مد + 6)
        
        # لون حسب النوع
        إذا (نوع_مد == 2)
            vga_ضع_لون(VGA_CYAN_BLACK)  # دليل
        وإلا
            vga_ضع_لون(VGA_WHITE_BLACK)  # ملف
        نهاية
        
        # طباعة الاسم
        إذا (طول_مد > 24)
            طول_مد = 24
        نهاية
        vga_نص(عنوان_مد + 8، طول_مد)
        
        # إضافة "/" للأدلة
        إذا (نوع_مد == 2)
            vga_حرف(47)
        نهاية
        
        vga_حرف(32)
        vga_حرف(32)
        
        م = م + 1
    نهاية
    
    vga_حرف(10)
    vga_ضع_لون(VGA_WHITE_BLACK)
نهاية

