                vga_حرف(10)
                نفّذ_أمر()
                مستمر = 0
            نهاية
            إذا (مفتاح == 8)   # Backspace
                cmd_مسح_خلفي()
                أعد_رسم_الأمر(عمود_بداية)
            نهاية
            إذا (مفتاح == -1)  # Up arrow — سجل سابق
                إذا (hist_فهرس > 0)
                    hist_فهرس = hist_فهرس - 1
                    استعد_من_السجل(hist_فهرس)
                    أعد_رسم_الأمر(عمود_بداية)
                نهاية
