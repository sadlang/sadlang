دالة cmd_يساوي(حرف0، حرف1، حرف2، حرف3، طول_المقارنة)
    إذا (cmd_طول < طول_المقارنة)
        ارجع 0
    نهاية
    
    ## قراءة أول 4 أحرف من الأمر
    متغير أول_زوج = shell_اقرأ_ذاكرة16(cmd_عنوان)
    متغير ثاني_زوج = shell_اقرأ_ذاكرة16(cmd_عنوان + 2)
    
    متغير ب0 = أول_زوج % 256
    متغير ب1 = أول_زوج / 256
    متغير ب2 = ثاني_زوج % 256
    متغير ب3 = ثاني_زوج / 256
    
    إذا (طول_المقارنة >= 1)
        إذا (ب0 != حرف0)
            ارجع 0
        نهاية
    نهاية
    إذا (طول_المقارنة >= 2)
        إذا (ب1 != حرف1)
            ارجع 0
        نهاية
    نهاية
    إذا (طول_المقارنة >= 3)
        إذا (ب2 != حرف2)
            ارجع 0
        نهاية
    نهاية
    إذا (طول_المقارنة >= 4)
        إذا (ب3 != حرف3)
            ارجع 0
        نهاية
    نهاية
    
    ارجع 1
نهاية

## يبدأ بـ نص مع إرجاع الإزاحة بعده
دالة cmd_يبدأ_بـ(حرف0، حرف1، حرف2، طول_البادئة)
    إذا (cmd_طول <= طول_البادئة)
        ارجع 0
    نهاية
    
    متغير أول_زوج = shell_اقرأ_ذاكرة16(cmd_عنوان)
    متغير ثاني_زوج = 0
    إذا (طول_البادئة >= 3)
        ثاني_زوج = shell_اقرأ_ذاكرة16(cmd_عنوان + 2)
    نهاية
    
    متغير ب0 = أول_زوج % 256
    متغير ب1 = أول_زوج / 256
    متغير ب2 = ثاني_زوج % 256
    
    إذا (طول_البادئة >= 1)
        إذا (ب0 != حرف0)
            ارجع 0
        نهاية
    نهاية
    إذا (طول_البادئة >= 2)
        إذا (ب1 != حرف1)
            ارجع 0
        نهاية
    نهاية
    إذا (طول_البادئة >= 3)
        إذا (ب2 != حرف2)
            ارجع 0
        نهاية
    نهاية
    
    # فحص مسافة بعد البادئة
    متغير بايت_بعد = 0
    متغير عنوان_بعد = cmd_عنوان + طول_البادئة
    متغير pair_بعد = shell_اقرأ_ذاكرة16(عنوان_بعد - (عنوان_بعد % 2))
    إذا (عنوان_بعد % 2 == 0)
        بايت_بعد = pair_بعد % 256
    وإلا
        بايت_بعد = pair_بعد / 256
    نهاية
    
    إذا (بايت_بعد == 32)
        ارجع طول_البادئة + 1
    نهاية
    
    ارجع 0
نهاية

