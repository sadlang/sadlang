                    نهاية
                    أعد_رسم_الأمر(عمود_بداية)
                نهاية
            نهاية
            إذا (مفتاح == -3)  # Left arrow
                إذا (cmd_مؤشر > 0)
                    cmd_مؤشر = cmd_مؤشر - 1
                    vga_عمود = عمود_بداية + cmd_مؤشر
                    vga_تحديث_مؤشر()
                نهاية
            نهاية
            إذا (مفتاح == -4)  # Right arrow
                إذا (cmd_مؤشر < cmd_طول)
                    cmd_مؤشر = cmd_مؤشر + 1
                    vga_عمود = عمود_بداية + cmd_مؤشر
                    vga_تحديث_مؤشر()
                نهاية
            نهاية
            إذا (مفتاح == -5)  # Home
                cmd_مؤشر = 0
                vga_عمود = عمود_بداية
                vga_تحديث_مؤشر()
            نهاية
            إذا (مفتاح == -6)  # End
                cmd_مؤشر = cmd_طول
                vga_عمود = عمود_بداية + cmd_مؤشر
                vga_تحديث_مؤشر()
            نهاية
            إذا (مفتاح > 31)   # حرف قابل للطباعة
                إذا (مفتاح < 127)
                    cmd_أدخل_حرف(مفتاح)
                    أعد_رسم_الأمر(عمود_بداية)
                نهاية
            نهاية
        نهاية
    نهاية
