## ثوابت
## ─────────────────────────────────────────────────────
ثابت COM1 = 1016
ثابت VGA_BASE = 753664     # 0xB8000
ثابت VGA_COLS = 80
ثابت VGA_ROWS = 25
ثابت VGA_SIZE = 4000       # 80*25*2

## ألوان VGA
ثابت VGA_WHITE_BLUE = 31    # fg=15(white), bg=1(blue) = (1<<4)|15
ثابت VGA_GREEN_BLACK = 10   # fg=10(green), bg=0(black)
ثابت VGA_CYAN_BLACK = 11    # fg=11(cyan), bg=0
ثابت VGA_YELLOW_BLACK = 14  # fg=14(yellow), bg=0
ثابت VGA_RED_BLACK = 12     # fg=12(red), bg=0
ثابت VGA_WHITE_BLACK = 7    # fg=7(white), bg=0

## لوحة مفاتيح PS/2
ثابت KB_DATA = 96           # 0x60
ثابت KB_STATUS = 100        # 0x64

## حجم مخزن الأمر
ثابت MAX_CMD = 256
ثابت MAX_HISTORY = 16

## مخزن نقطة التحميل الافتراضية
ثابت DEFAULT_MOUNT = 0

## ─────────────────────────────────────────────────────
## طباعة تصحيح
## ─────────────────────────────────────────────────────
دالة sh_اطبع_رقم(القيمة)
    إذا (القيمة < 0)
        shell_serial_char(COM1، 45)
        sh_اطبع_رقم(0 - القيمة)
        ارجع
    نهاية
    إذا (القيمة >= 10)
        sh_اطبع_رقم(القيمة / 10)
    نهاية
    shell_serial_char(COM1، 48 + (القيمة % 10))
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ١: VGA Text-Mode Output
## ═══════════════════════════════════════════════════════════════

## موقع المؤشر
متغير vga_صف = 0
متغير vga_عمود = 0
متغير vga_لون = 7   # أبيض على أسود

## تعيين اللون
دالة vga_ضع_لون(لون_جديد)
    vga_لون = لون_جديد
نهاية

## تمرير الشاشة للأعلى
دالة vga_تمرير()
    # نسخ كل سطر من (صف+1) إلى (صف)
    متغير صف = 0
    بينما (صف < VGA_ROWS - 1)
        متغير عنوان_مصدر = VGA_BASE + ((صف + 1) * VGA_COLS * 2)
        متغير عنوان_وجهة = VGA_BASE + (صف * VGA_COLS * 2)
        shell_انسخ_ذاكرة(عنوان_وجهة، عنوان_مصدر، VGA_COLS * 2)
        صف = صف + 1
    نهاية
    # مسح السطر الأخير
    متغير عنوان_آخر = VGA_BASE + ((VGA_ROWS - 1) * VGA_COLS * 2)
    متغير ع = 0
    بينما (ع < VGA_COLS)
        shell_اكتب_ذاكرة16(عنوان_آخر + (ع * 2)، (vga_لون * 256) + 32)
        ع = ع + 1
    نهاية
    vga_صف = VGA_ROWS - 1
نهاية

## مسح الشاشة
دالة vga_مسح()
    متغير ع = 0
    بينما (ع < VGA_COLS * VGA_ROWS)
        shell_اكتب_ذاكرة16(VGA_BASE + (ع * 2)، (vga_لون * 256) + 32)
        ع = ع + 1
    نهاية
    vga_صف = 0
    vga_عمود = 0
نهاية

## طباعة حرف واحد
دالة vga_حرف(ح)
    إذا (ح == 10)  # سطر جديد
        vga_عمود = 0
        vga_صف = vga_صف + 1
        إذا (vga_صف >= VGA_ROWS)
            vga_تمرير()
        نهاية
        ارجع
    نهاية
    إذا (ح == 13)  # عودة
        vga_عمود = 0
        ارجع
    نهاية
    إذا (ح == 8)   # مسح خلفي
        إذا (vga_عمود > 0)
            vga_عمود = vga_عمود - 1
            متغير عنوان_مسح = VGA_BASE + ((vga_صف * VGA_COLS + vga_عمود) * 2)
            shell_اكتب_ذاكرة16(عنوان_مسح، (vga_لون * 256) + 32)
        نهاية
        ارجع
    نهاية
    
    إذا (vga_عمود >= VGA_COLS)
        vga_عمود = 0
        vga_صف = vga_صف + 1
        إذا (vga_صف >= VGA_ROWS)
            vga_تمرير()
        نهاية
    نهاية
    
    متغير عنوان_vga = VGA_BASE + ((vga_صف * VGA_COLS + vga_عمود) * 2)
    shell_اكتب_ذاكرة16(عنوان_vga، (vga_لون * 256) + ح)
    vga_عمود = vga_عمود + 1
نهاية

## طباعة نص (سلسلة بايتات)
دالة vga_نص(عنوان_النص، طول_النص)
    متغير ف = 0
    بينما (ف < طول_النص)
        متغير عنوان_القراءة = عنوان_النص + ف
        # قراءة بايت واحد (أقل بايت من 16-بت)
        متغير زوج = shell_اقرأ_ذاكرة16(عنوان_القراءة - (عنوان_القراءة % 2))
        متغير الحرف = زوج % 256
        إذا (عنوان_القراءة % 2 == 1)
            الحرف = زوج / 256
        نهاية
        vga_حرف(الحرف)
        ف = ف + 1
    نهاية
نهاية

## طباعة رقم على VGA
دالة vga_رقم(القيمة)
    إذا (القيمة < 0)
        vga_حرف(45)
        vga_رقم(0 - القيمة)
        ارجع
    نهاية
    إذا (القيمة >= 10)
        vga_رقم(القيمة / 10)
    نهاية
    vga_حرف(48 + (القيمة % 10))
نهاية

## تحديث مؤشر الكتابة المرئي (cursor)
دالة vga_تحديث_مؤشر()
    متغير موقع = vga_صف * VGA_COLS + vga_عمود
    shell_outb(948، 14)   # 0x3D4 = CRT index
    shell_outb(949، موقع / 256)   # 0x3D5 = CRT data high
    shell_outb(948، 15)
    shell_outb(949، موقع % 256)   # low
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٢: لوحة المفاتيح PS/2
## ═══════════════════════════════════════════════════════════════

## جدول ترجمة Scancode Set 1 → ASCII
## فقط المفاتيح الأساسية
متغير kb_جدول = [0، 27، 49، 50، 51، 52، 53، 54، 55، 56، 57، 48، 45، 61، 8،
                  9، 113، 119، 101، 114، 116، 121، 117، 105، 111، 112، 91، 93، 10،
                  0، 97، 115، 100، 102، 103، 104، 106، 107، 108، 59، 39، 96،
                  0، 92، 122، 120، 99، 118، 98، 110، 109، 44، 46، 47، 0،
                  42، 0، 32]
# Indices: 0x00-0x39 (57 entries)

## جدول Shift
متغير kb_جدول_شفت = [0، 27، 33، 64، 35، 36، 37، 94، 38، 42، 40، 41، 95، 43، 8،
                      9، 81، 87، 69، 82، 84، 89، 85، 73، 79، 80، 123، 125، 10،
                      0، 65، 83، 68، 70، 71، 72، 74، 75، 76، 58، 34، 126،
                      0، 124، 90، 88، 67، 86، 66، 78، 77، 60، 62، 63، 0،
                      42، 0، 32]

متغير kb_شفت_مضغوط = 0
متغير kb_كنترول_مضغوط = 0
متغير kb_آخر_مفتاح = 0

## قراءة مفتاح واحد (يُعيد ASCII أو 0 أو رمز خاص سالب)
## رموز خاصة: -1=UP، -2=DOWN، -3=LEFT، -4=RIGHT، -5=HOME، -6=END، -7=DEL
دالة kb_اقرأ_مفتاح()
    # فحص إذا يوجد بيانات
    متغير حالة_المنفذ = shell_inb(KB_STATUS)
    إذا ((حالة_المنفذ % 2) == 0)
        ارجع 0   # لا يوجد مفتاح
    نهاية
    
    متغير سكان = shell_inb(KB_DATA)
    
    # تحرير مفتاح (بت 7 مضبوط)
    إذا (سكان >= 128)
        متغير كود_تحرير = سكان - 128
        إذا (كود_تحرير == 42)  # Left Shift release
            kb_شفت_مضغوط = 0
        نهاية
        إذا (كود_تحرير == 54)  # Right Shift release
            kb_شفت_مضغوط = 0
        نهاية
        إذا (كود_تحرير == 29)  # Ctrl release
            kb_كنترول_مضغوط = 0
        نهاية
        ارجع 0
    نهاية
    
    # ضغط مفتاح
    إذا (سكان == 42)  # Left Shift
        kb_شفت_مضغوط = 1
        ارجع 0
    نهاية
    إذا (سكان == 54)  # Right Shift
        kb_شفت_مضغوط = 1
        ارجع 0
    نهاية
    إذا (سكان == 29)  # Ctrl
        kb_كنترول_مضغوط = 1
        ارجع 0
    نهاية
    
    # مفاتيح الأسهم (E0 prefix مُدار بواسطة مقاطعات_نحلة)
    إذا (سكان == 72)  # Up arrow (scancode 0x48)
        ارجع -1
    نهاية
    إذا (سكان == 80)  # Down arrow (0x50)
        ارجع -2
    نهاية
    إذا (سكان == 75)  # Left arrow (0x4B)
        ارجع -3
    نهاية
    إذا (سكان == 77)  # Right arrow (0x4D)
        ارجع -4
    نهاية
    إذا (سكان == 71)  # Home (0x47)
        ارجع -5
    نهاية
    إذا (سكان == 79)  # End (0x4F)
        ارجع -6
    نهاية
    إذا (سكان == 83)  # Delete (0x53)
        ارجع -7
    نهاية
    
    # ترجمة إلى ASCII
    إذا (سكان < 58)
        إذا (kb_شفت_مضغوط == 1)
            ارجع kb_جدول_شفت[سكان]
        وإلا
            ارجع kb_جدول[سكان]
        نهاية
    نهاية
    
    ارجع 0
نهاية

## انتظار مفتاح
دالة kb_انتظر_مفتاح()
    متغير مفتاح = 0
    بينما (مفتاح == 0)
        مفتاح = kb_اقرأ_مفتاح()
    نهاية
    ارجع مفتاح
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٣: مخزن الأوامر والتحرير
## ═══════════════════════════════════════════════════════════════

## مخزن الأمر الحالي (256 بايت)
متغير cmd_عنوان = 0
متغير cmd_طول = 0
متغير cmd_مؤشر = 0    # موقع المؤشر في المخزن

## سجل الأوامر (16 مدخلة × 256 بايت)
متغير hist_عنوان = 0
متغير hist_عدد = 0
متغير hist_فهرس = 0    # فهرس التصفح الحالي

## مسار العمل الحالي
متغير cwd_عنوان = 0
متغير cwd_طول = 1      # يبدأ بـ "/"

## مخزن عمل للأوامر
متغير work_عنوان = 0

## ═══════════════════════════════════════════════════════════════
## القسم ٤: تهيئة الصدفة
## ═══════════════════════════════════════════════════════════════

صدّر دالة هيئ_الصدفة()
    # تخصيص مخزن الأوامر
    cmd_عنوان = shell_خصص_صفحة()
    إذا (cmd_عنوان == 0)
        ارجع -1
    نهاية
    shell_املأ_ذاكرة(cmd_عنوان، 0، 4096)
    
    # تخصيص سجل الأوامر (16 * 256 = 4096 بايت)
    hist_عنوان = shell_خصص_صفحة()
    إذا (hist_عنوان == 0)
        ارجع -1
    نهاية
    shell_املأ_ذاكرة(hist_عنوان، 0، 4096)
    
    # تخصيص مسار العمل
    cwd_عنوان = shell_خصص_صفحة()
    إذا (cwd_عنوان == 0)
        ارجع -1
    نهاية
    shell_املأ_ذاكرة(cwd_عنوان، 0، 4096)
    # تعيين "/" كمسار ابتدائي
    shell_اكتب_ذاكرة16(cwd_عنوان، 47)
    cwd_طول = 1
    
    # تخصيص مخزن عمل
    work_عنوان = shell_خصص_صفحة()
    إذا (work_عنوان == 0)
        ارجع -1
    نهاية
    shell_املأ_ذاكرة(work_عنوان، 0، 4096)
    
    cmd_طول = 0
    cmd_مؤشر = 0
    hist_عدد = 0
    hist_فهرس = 0
    
    ارجع 0
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٥: رسم المحث (prompt)
## ═══════════════════════════════════════════════════════════════

دالة ارسم_المحث()
    # [نحلة] المسار>
    vga_ضع_لون(VGA_YELLOW_BLACK)
    vga_حرف(91)
    # "bee" in ASCII
    vga_حرف(98)
    vga_حرف(101)
    vga_حرف(101)
    vga_حرف(93)
    
    vga_ضع_لون(VGA_CYAN_BLACK)
    # طباعة المسار الحالي
    vga_نص(cwd_عنوان، cwd_طول)
    
    vga_ضع_لون(VGA_GREEN_BLACK)
    vga_حرف(62)    # '>'
    vga_حرف(32)    # مسافة
    
    vga_ضع_لون(VGA_WHITE_BLACK)
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٦: تحرير سطر الأمر
## ═══════════════════════════════════════════════════════════════

## إعادة رسم سطر الأمر
دالة أعد_رسم_الأمر(عمود_بداية)
    # مسح من بداية الأمر حتى نهاية السطر
    متغير ع = عمود_بداية + 0
    بينما (ع < VGA_COLS)
        متغير addr = VGA_BASE + ((vga_صف * VGA_COLS + ع) * 2)
        shell_اكتب_ذاكرة16(addr، (VGA_WHITE_BLACK * 256) + 32)
        ع = ع + 1
    نهاية
    
    # إعادة طباعة الأمر
    vga_عمود = عمود_بداية + 0
    متغير ف = 0
    بينما (ف < cmd_طول)
        متغير عنوان_القراءة = cmd_عنوان + ف
        متغير زوج = shell_اقرأ_ذاكرة16(عنوان_القراءة - (عنوان_القراءة % 2))
        متغير الحرف = زوج % 256
        إذا (عنوان_القراءة % 2 == 1)
            الحرف = زوج / 256
        نهاية
        vga_حرف(الحرف)
        ف = ف + 1
    نهاية
    
    # تحريك مؤشر VGA لموقع التحرير
    vga_عمود = (عمود_بداية + 0) + cmd_مؤشر
    vga_تحديث_مؤشر()
نهاية

## إضافة أمر إلى السجل
دالة أضف_للسجل()
    إذا (cmd_طول == 0)
        ارجع
    نهاية
    
    متغير فهرس = hist_عدد % MAX_HISTORY
    متغير عنوان_مدخلة = hist_عنوان + (فهرس * MAX_CMD)
    shell_املأ_ذاكرة(عنوان_مدخلة، 0، MAX_CMD)
    shell_انسخ_ذاكرة(عنوان_مدخلة، cmd_عنوان، cmd_طول)
    # تخزين الطول في آخر بايت
    shell_اكتب_ذاكرة16(عنوان_مدخلة + MAX_CMD - 2، cmd_طول)
    
    hist_عدد = hist_عدد + 1
    hist_فهرس = hist_عدد
نهاية

## استعادة أمر من السجل
دالة استعد_من_السجل(فهرس_السجل)
    إذا (hist_عدد == 0)
        ارجع
    نهاية
    
    متغير فهرس_حقيقي = فهرس_السجل % MAX_HISTORY
    متغير عنوان_مدخلة = hist_عنوان + (فهرس_حقيقي * MAX_CMD)
    متغير طول_مخزن = shell_اقرأ_ذاكرة16(عنوان_مدخلة + MAX_CMD - 2)
    إذا (طول_مخزن > MAX_CMD - 2)
        طول_مخزن = MAX_CMD - 2
    نهاية
    
    shell_انسخ_ذاكرة(cmd_عنوان، عنوان_مدخلة، طول_مخزن)
    cmd_طول = طول_مخزن
    cmd_مؤشر = cmd_طول
نهاية

## كتابة قيمة في مخزن الأمر عند الموقع الحالي
دالة cmd_أدخل_حرف(قيمة_حرف)
    إذا (cmd_طول >= MAX_CMD - 2)
        ارجع
    نهاية
    
    # تحريك البايتات بعد المؤشر للأمام
    إذا (cmd_مؤشر < cmd_طول)
        متغير ف = cmd_طول
        بينما (ف > cmd_مؤشر)
            # قراءة بايت ف-1، كتابته في موقع ف
            متغير عنوان_src = cmd_عنوان + ف - 1
            متغير pair_src = shell_اقرأ_ذاكرة16(عنوان_src - (عنوان_src % 2))
            متغير بايت_src = pair_src % 256
            إذا (عنوان_src % 2 == 1)
                بايت_src = pair_src / 256
            نهاية
            
            # كتابة في موقع ف
            متغير عنوان_dst = cmd_عنوان + ف
            متغير pair_dst = shell_اقرأ_ذاكرة16(عنوان_dst - (عنوان_dst % 2))
            إذا (عنوان_dst % 2 == 0)
                shell_اكتب_ذاكرة16(عنوان_dst، (pair_dst - (pair_dst % 256)) + بايت_src)
            وإلا
                shell_اكتب_ذاكرة16(عنوان_dst - 1، (pair_dst % 256) + (بايت_src * 256))
            نهاية
            
            ف = ف - 1
        نهاية
    نهاية
    
    # كتابة البايت الجديد في موقع المؤشر
    متغير عنوان_كتابة = cmd_عنوان + cmd_مؤشر
    متغير pair = shell_اقرأ_ذاكرة16(عنوان_كتابة - (عنوان_كتابة % 2))
    إذا (عنوان_كتابة % 2 == 0)
        shell_اكتب_ذاكرة16(عنوان_كتابة، (pair - (pair % 256)) + قيمة_حرف)
    وإلا
        shell_اكتب_ذاكرة16(عنوان_كتابة - 1، (pair % 256) + (قيمة_حرف * 256))
    نهاية
    
    cmd_طول = cmd_طول + 1
    cmd_مؤشر = cmd_مؤشر + 1
نهاية

## حذف بايت عند المؤشر-1 (backspace)
دالة cmd_مسح_خلفي()
    إذا (cmd_مؤشر == 0)
        ارجع
    نهاية
    
    # تحريك البايتات بعد المؤشر للخلف
    متغير ف = cmd_مؤشر - 1
    بينما (ف < cmd_طول - 1)
        متغير عنوان_src = cmd_عنوان + ف + 1
        متغير pair_src = shell_اقرأ_ذاكرة16(عنوان_src - (عنوان_src % 2))
        متغير بايت_src = pair_src % 256
        إذا (عنوان_src % 2 == 1)
            بايت_src = pair_src / 256
        نهاية
        
        متغير عنوان_dst = cmd_عنوان + ف
        متغير pair_dst = shell_اقرأ_ذاكرة16(عنوان_dst - (عنوان_dst % 2))
        إذا (عنوان_dst % 2 == 0)
            shell_اكتب_ذاكرة16(عنوان_dst، (pair_dst - (pair_dst % 256)) + بايت_src)
        وإلا
            shell_اكتب_ذاكرة16(عنوان_dst - 1، (pair_dst % 256) + (بايت_src * 256))
        نهاية
        
        ف = ف + 1
    نهاية
    
    cmd_طول = cmd_طول - 1
    cmd_مؤشر = cmd_مؤشر - 1
نهاية

