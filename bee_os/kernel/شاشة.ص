# ===================================================================
# ثوابت الشاشة
# ===================================================================

متغير عرض_vga        = 80
متغير ارتفاع_vga     = 25

# ألوان VGA الأساسية
متغير لون_أسود       = 0
متغير لون_أزرق       = 1
متغير لون_أخضر       = 2
متغير لون_أحمر       = 4
متغير لون_أبيض       = 15
متغير لون_أصفر       = 14

# الحالة الداخلية
متغير صف_حالي        = 0
متغير عمود_حالي      = 0
متغير شاشة_مهيأة     = خطأ

# ===================================================================
# تهيئة الشاشة
# ===================================================================

دالة شاشة_تهيئة()
    صف_حالي    = 0
    عمود_حالي  = 0
    شاشة_مهيأة = صحيح
    اطبع_سطر("[شاشة] ✓ وحدة الشاشة مهيأة — 80×25 VGA")
نهاية

# ===================================================================
# دوال الطباعة
# ===================================================================

دالة شاشة_اطبع(رسالة)
    اطبع(رسالة)
نهاية

دالة شاشة_اطبع_سطر(رسالة)
    اطبع_سطر(رسالة)
    صف_حالي = صف_حالي + 1
    عمود_حالي = 0
    إذا (صف_حالي >= ارتفاع_vga)
        صف_حالي = ارتفاع_vga - 1
    نهاية
نهاية

دالة شاشة_مسح()
    متغير ي = 0
    بينما (ي < 5)
        اطبع_سطر("")
        ي = ي + 1
    نهاية
    صف_حالي   = 0
    عمود_حالي = 0
نهاية

# ===================================================================
# الموضع والتحكم
# ===================================================================

دالة شاشة_تعيين_موضع(رقم_صف، رقم_عمود)
    إذا (رقم_صف >= 0)
        إذا (رقم_صف < ارتفاع_vga)
            صف_حالي = رقم_صف
        نهاية
    نهاية
    إذا (رقم_عمود >= 0)
        إذا (رقم_عمود < عرض_vga)
            عمود_حالي = رقم_عمود
        نهاية
    نهاية
نهاية

دالة شاشة_موضع()
    ارجع "صف:" + صف_حالي + " عمود:" + عمود_حالي
نهاية

دالة شاشة_جاهزة()
    ارجع شاشة_مهيأة
نهاية

# ===================================================================
# شعار BeeOS
# ===================================================================

دالة شاشة_بسم_الله()
    اطبع_سطر("╔══════════════════════════════════════════════════╗")
    اطبع_سطر("║     بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ           ║")
    اطبع_سطر("║                                                  ║")
    اطبع_سطر("║     🐝  نِظَامُ النَّحْلَة  BeeOS v0.1.0  🐝     ║")
    اطبع_سطر("║   نظام تشغيل إسلامي — مكتوب بلغة البرمجة ص     ║")
    اطبع_سطر("║                                                  ║")
    اطبع_سطر("║  وَأَوْحَى رَبُّكَ إِلَى النَّحْلِ  — ١٦:٦٨     ║")
    اطبع_سطر("╚══════════════════════════════════════════════════╝")
    اطبع_سطر("")
نهاية

# ===================================================================
# اختبار الوحدة
# ===================================================================

اطبع_سطر("=== BeeOS — اختبار وحدة الشاشة ===")
شاشة_تهيئة()
شاشة_بسم_الله()
شاشة_اطبع_سطر("وحدة الشاشة تعمل بنجاح ✓")
شاشة_تعيين_موضع(5، 10)
اطبع_سطر("الموضع: " + شاشة_موضع())
اطبع_سطر("مهيأة: " + شاشة_جاهزة())
اطبع_سطر("=== اكتمل اختبار الشاشة ✓ ===")
