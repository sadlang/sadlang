# ============================================================
# بناء المدخلات
# ============================================================

# بناء مدخلة دليل صفحات (PDE)
# المعاملات: عنوان_جدول = العنوان الفيزيائي لجدول الصفحات (محاذاة 4KB)
#            اعلام = أعلام المدخلة
# النتيجة: قيمة المدخلة الجاهزة للكتابة
دالة بناء_مدخلة_دليل(عنوان_جدول، اعلام)
    متغير عنوان_محاذاة = عنوان_جدول & قناع_عنوان
    ارجع عنوان_محاذاة | اعلام
نهاية

# بناء مدخلة جدول صفحات (PTE)
# المعاملات: عنوان_إطار = العنوان الفيزيائي للإطار (محاذاة 4KB)
#            اعلام = أعلام المدخلة
# النتيجة: قيمة المدخلة الجاهزة للكتابة
دالة بناء_مدخلة_جدول(عنوان_إطار، اعلام)
