# مسح بت التعديل (Dirty) لصفحة
دالة مسح_بت_تعديل(عنوان_دليل، عنوان_افتراضي)
    متغير فهرس_دليل = استخراج_فهرس_دليل(عنوان_افتراضي)
    متغير فهرس_جدول = استخراج_فهرس_جدول(عنوان_افتراضي)
    
    متغير مدخلة_دليل = قراءة_مدخلة_دليل(عنوان_دليل، فهرس_دليل)
    متغير فحص = مدخلة_موجودة(مدخلة_دليل)
    إذا (فحص == 0)
        ارجع 0
    نهاية
    
    متغير عنوان_جدول = مدخلة_عنوان_فيزيائي(مدخلة_دليل)
    متغير مدخلة_صفحة = قراءة_مدخلة_جدول(عنوان_جدول، فهرس_جدول)
    
    # مسح بت التعديل (بت 6)
    متغير قناع_مسح = ~علم_تعديل
    متغير مدخلة_جديدة = مدخلة_صفحة & قناع_مسح
    كتابة_مدخلة_جدول(عنوان_جدول، فهرس_جدول، مدخلة_جديدة)
    
    sad_ll_invlpg(عنوان_افتراضي)
    ارجع 1
نهاية

# مسح جميع بتات الوصول في نطاق (لخوارزمية الساعة)
دالة مسح_بتات_وصول_نطاق(عنوان_دليل، عنوان_بداية، عدد_صفحات)
    متغير مسحت = 0
    متغير إ = 0
    بينما (إ < عدد_صفحات)
        متغير عنوان = عنوان_بداية + إ * ثابت_مقاس_صفحة
        متغير نتيجة = مسح_بت_وصول(عنوان_دليل، عنوان)
        إذا (نتيجة == 1)
            مسحت = مسحت + 1
        نهاية
        إ = إ + 1
    نهاية
    ارجع مسحت
نهاية

