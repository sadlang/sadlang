# فحص سلامة الدليل — التأكد من عدم وجود تناقضات
دالة فحص_سلامة_دليل(عنوان_دليل)
    متغير اخطاء = 0
    متغير فهرس = 0
    
    بينما (فهرس < ثابت_مدخلات_جدول)
        متغير مدخلة = قراءة_مدخلة_دليل(عنوان_دليل، فهرس)
        متغير فحص = مدخلة_موجودة(مدخلة)
        
        إذا (فحص == 1)
            # فحص هل العنوان الفيزيائي محاذاة 4KB
            متغير عنوان = مدخلة_عنوان_فيزيائي(مدخلة)
            متغير فحص_محاذاة = عنوان & قناع_إزاحة
            إذا (فحص_محاذاة != 0)
                kernel_print_string("خطأ: مدخلة دليل غير محاذاة عند فهرس:")
                kernel_print_number(فهرس)
                اخطاء = اخطاء + 1
            نهاية
            
            # فحص هل العنوان في نطاق معقول (< 4GB)
            إذا (عنوان == 0)
                kernel_print_string("تحذير: مدخلة موجودة بعنوان 0 عند فهرس:")
                kernel_print_number(فهرس)
            نهاية
        نهاية
        
        فهرس = فهرس + 1
    نهاية
    
    إذا (اخطاء == 0)
        kernel_print_string("فحص سلامة الدليل: لا توجد أخطاء")
    وإلا
        kernel_print_string("فحص سلامة الدليل: وُجدت أخطاء:")
        kernel_print_number(اخطاء)
    نهاية
    
    ارجع اخطاء
نهاية

