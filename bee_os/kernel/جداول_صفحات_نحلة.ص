# ============================================================
# قراءة وكتابة مدخلات دليل الصفحات (PDE)
# ============================================================

# قراءة مدخلة من دليل الصفحات
# المعاملات: عنوان_دليل = العنوان الفيزيائي لدليل الصفحات
#            فهرس = رقم المدخلة (0-1023)
# النتيجة: قيمة المدخلة (32 بت)
دالة قراءة_مدخلة_دليل(عنوان_دليل، فهرس)
    إذا (فهرس < 0)
        ارجع 0
    نهاية
    إذا (فهرس >= ثابت_مدخلات_جدول)
        ارجع 0
    نهاية
    متغير عنوان_مدخلة = عنوان_دليل + فهرس * 4
    ارجع mem_read_dword(عنوان_مدخلة)
نهاية

# كتابة مدخلة في دليل الصفحات
دالة كتابة_مدخلة_دليل(عنوان_دليل، فهرس، قيمة)
    إذا (فهرس < 0)
        ارجع 0
    نهاية
    إذا (فهرس >= ثابت_مدخلات_جدول)
        ارجع 0
    نهاية
    متغير عنوان_مدخلة = عنوان_دليل + فهرس * 4
    mem_write_dword(عنوان_مدخلة، قيمة)
    ارجع 1
نهاية

