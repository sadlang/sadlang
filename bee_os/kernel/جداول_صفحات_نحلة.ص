# ربط صفحة كبيرة (4 ميغابايت)
# لا يحتاج جدول صفحات — المدخلة في الدليل تشير مباشرة للإطار
دالة ربط_صفحة_كبيرة(عنوان_دليل، عنوان_افتراضي، عنوان_فيزيائي، اعلام)
    # العنوان الفيزيائي يجب أن يكون محاذاة 4MB
    متغير قناع_4mb = 4194303
    متغير فحص_محاذاة = عنوان_فيزيائي & قناع_4mb
    إذا (فحص_محاذاة != 0)
        ارجع 0
    نهاية
    
    متغير فهرس_دليل = استخراج_فهرس_دليل(عنوان_افتراضي)
    
    # بناء مدخلة صفحة كبيرة
    # العنوان (بت 22-31) + علم صفحة كبيرة + أعلام
    متغير مدخلة = عنوان_فيزيائي | علم_صفحة_كبيرة | اعلام
    كتابة_مدخلة_دليل(عنوان_دليل، فهرس_دليل، مدخلة)
    
    عداد_ربط = عداد_ربط + 1
    ارجع 1
نهاية

