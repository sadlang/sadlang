# ربط هوية (Identity Mapping) لنطاق محدد
# ============================================================

# ربط هوية: العنوان الافتراضي = العنوان الفيزيائي
دالة ربط_هوية(عنوان_دليل، عنوان_بداية، عدد_صفحات، اعلام)
    ارجع ربط_نطاق(عنوان_دليل، عنوان_بداية، عنوان_بداية، عدد_صفحات، اعلام)
نهاية

