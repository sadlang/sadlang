متغير قناع_عنوان = 4294963200

# قناع الإزاحة داخل الصفحة (بت 0-11)
متغير قناع_إزاحة = 4095

# ============================================================
# أعلام مدخلة دليل الصفحات (PDE Flags)
# ============================================================

# بت 0: موجود
متغير علم_موجود = 1
# بت 1: قابل للكتابة
متغير علم_كتابة = 2
# بت 2: مستخدم
متغير علم_مستخدم_صفحة = 4
# بت 3: كتابة مباشرة
