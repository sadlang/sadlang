    ارجع عنوان_محاذاة | اعلام
نهاية

# ============================================================
# إدارة جداول الصفحات — التخصيص
# ============================================================

# تخصيص جدول صفحات جديد
# يُرجع العنوان الفيزيائي للجدول المخصص، أو 0 عند الفشل
دالة تخصيص_جدول_صفحات()
    # فحص هل وصلنا الحد الأقصى
    إذا (عدد_جداول_مخصصة >= اقصى_جداول)
        kernel_print_string("خطأ: نفدت جداول الصفحات المتاحة")
        ارجع 0
    نهاية
    
    # حساب عنوان الجدول الجديد
    متغير عنوان_جدول = عنوان_بداية_جداول + عدد_جداول_مخصصة * ثابت_مقاس_صفحة
    
    # تصفير الجدول (جميع المدخلات = 0 = غير موجودة)
    sad_ll_memset(عنوان_جدول، 0، ثابت_مقاس_صفحة)
    
    # تحديث العداد
    عدد_جداول_مخصصة = عدد_جداول_مخصصة + 1
    عداد_جداول_منشأة = عداد_جداول_منشأة + 1
    
    ارجع عنوان_جدول
نهاية

# ============================================================
# تهيئة دليل صفحات النواة
# ============================================================

# تهيئة دليل الصفحات الرئيسي للنواة
# تقوم بإنشاء ربط هوية (Identity Mapping) لأول 16 ميغابايت
# حيث يكون العنوان الافتراضي = العنوان الفيزيائي
دالة تهيئة_دليل_نواة()
    kernel_print_string("تهيئة دليل صفحات النواة...")
    
    # تصفير دليل الصفحات بالكامل
    sad_ll_memset(عنوان_دليل_نواة، 0، ثابت_مقاس_صفحة)
    
    # ربط هوية لأول 16 ميغابايت (4 مدخلات في الدليل)
    # كل مدخلة تغطي 4 ميغابايت = 1024 صفحة × 4 كيلوبايت
    متغير عدد_مدخلات_هوية = 4
    
    متغير د = 0
    بينما (د < عدد_مدخلات_هوية)
        # تخصيص جدول صفحات لهذه المدخلة
        متغير عنوان_جدول = تخصيص_جدول_صفحات()
        إذا (عنوان_جدول == 0)
            kernel_print_string("خطأ: فشل تخصيص جدول صفحات للنواة")
            ارجع 0
        نهاية
        
        # ملء جدول الصفحات بربط هوية
        متغير ج = 0
        بينما (ج < ثابت_مدخلات_جدول)
            # حساب العنوان الفيزيائي
            متغير عنوان_فيزيائي = (د * ثابت_مدخلات_جدول + ج) * ثابت_مقاس_صفحة
            
            # بناء المدخلة: موجود + قابل للكتابة (مستوى النواة)
            متغير مدخلة = بناء_مدخلة_جدول(عنوان_فيزيائي، اعلام_نواة_كتابة)
            
            # كتابة المدخلة في الجدول
            كتابة_مدخلة_جدول(عنوان_جدول، ج، مدخلة)
            
            ج = ج + 1
        نهاية
        
        # بناء مدخلة الدليل وكتابتها
        متغير مدخلة_دليل = بناء_مدخلة_دليل(عنوان_جدول، اعلام_نواة_كتابة)
        كتابة_مدخلة_دليل(عنوان_دليل_نواة، د، مدخلة_دليل)
        
        د = د + 1
    نهاية
    
    kernel_print_string("تم إنشاء ربط هوية لأول 16 ميغابايت")
    ارجع 1
نهاية

# ============================================================
# تفعيل الترحيل
# ============================================================

# تفعيل نظام الترحيل
# 1. تحميل عنوان دليل الصفحات في CR3
# 2. تفعيل بت الترحيل في CR0
دالة تفعيل_ترحيل()
    kernel_print_string("تفعيل نظام الترحيل...")
    
    # تحميل عنوان دليل صفحات النواة في CR3
    sad_ll_write_cr3(عنوان_دليل_نواة)
    
    # قراءة CR0 وتفعيل بت الترحيل (بت 31)
    متغير قيمة_cr0 = sad_ll_read_cr0()
    متغير بت_ترحيل = 2147483648
    قيمة_cr0 = قيمة_cr0 | بت_ترحيل
    sad_ll_write_cr0(قيمة_cr0)
    
    kernel_print_string("تم تفعيل الترحيل بنجاح")
    ارجع 1
نهاية

# تعطيل الترحيل
دالة تعطيل_ترحيل()
    متغير قيمة_cr0 = sad_ll_read_cr0()
    متغير بت_ترحيل = 2147483648
    متغير قناع_تعطيل = ~بت_ترحيل
    قيمة_cr0 = قيمة_cr0 & قناع_تعطيل
    sad_ll_write_cr0(قيمة_cr0)
    ارجع 1
نهاية

# فحص هل الترحيل مفعّل
دالة هل_ترحيل_مفعل()
    متغير قيمة_cr0 = sad_ll_read_cr0()
    متغير بت_ترحيل = 2147483648
    متغير فحص = قيمة_cr0 & بت_ترحيل
    إذا (فحص != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ============================================================
# ربط صفحة (Map)
# ============================================================

# ربط عنوان افتراضي بعنوان فيزيائي
# المعاملات:
#   عنوان_دليل: عنوان دليل الصفحات
#   عنوان_افتراضي: العنوان الافتراضي المراد ربطه
#   عنوان_فيزيائي: العنوان الفيزيائي للإطار
#   اعلام: أعلام الحماية (Present, R/W, User, etc.)
# النتيجة: 1=نجاح، 0=فشل
دالة ربط_صفحة(عنوان_دليل، عنوان_افتراضي، عنوان_فيزيائي، اعلام)
    # استخراج الفهارس
    متغير فهرس_دليل = استخراج_فهرس_دليل(عنوان_افتراضي)
    متغير فهرس_جدول = استخراج_فهرس_جدول(عنوان_افتراضي)
    
    # قراءة مدخلة الدليل
    متغير مدخلة_دليل_حالية = قراءة_مدخلة_دليل(عنوان_دليل، فهرس_دليل)
    
    # فحص هل جدول الصفحات موجود
    متغير عنوان_جدول = 0
    متغير تم_إنشاء = 0
    
    متغير فحص_موجود = مدخلة_موجودة(مدخلة_دليل_حالية)
    إذا (فحص_موجود == 1)
        # الجدول موجود — استخراج عنوانه
        عنوان_جدول = مدخلة_عنوان_فيزيائي(مدخلة_دليل_حالية)
    وإلا
        # الجدول غير موجود — تخصيص جدول جديد
        عنوان_جدول = تخصيص_جدول_صفحات()
        إذا (عنوان_جدول == 0)
            ارجع 0
