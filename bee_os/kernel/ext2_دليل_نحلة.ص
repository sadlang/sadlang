    نهاية
    
    متغير فهرس = 0
    متغير رقم_كتلة_م = 0
    
    بينما (رقم_كتلة_م < 12)
        متغير كتلة_ف = ext2_هات_كتلة_عقدة(ق، عقدة_دليل، رقم_كتلة_م)
        
        إذا (كتلة_ف == 0)
            رقم_كتلة_م = 12
        وإلا
            متغير نت_ق = ext2_اقرأ_كتلة(ق، كتلة_ف، مخزن)
            
            إذا (نت_ق == 0)
                متغير إزاحة = 0
                
                بينما (إزاحة < مقاس_ك)
                    متغير ع_مدخل = ext2_دليل_اقرأ_عقدة_مدخل(مخزن، إزاحة)
                    متغير ط_سجل = ext2_دليل_اقرأ_طول_سجل(مخزن، إزاحة)
                    متغير ط_اسم = ext2_دليل_اقرأ_طول_اسم(مخزن، إزاحة)
                    متغير نوع_مدخل = ext2_دليل_اقرأ_نوع(مخزن، إزاحة)
                    
                    إذا (ط_سجل < حد_أدنى_مدخل)
                        إزاحة = مقاس_ك
                    وإلا
                        إذا (ع_مدخل != 0)
                            إذا (فهرس < حد_نتائج)
                                # حساب التجزئة
                                متغير تجزئة_محسوبة = (ع_مدخل * 31) + (ط_اسم * 7) + نوع_مدخل
                                
                                # تخزين في مخزن النتائج
                                اكتب_نتيجة(فهرس، ع_مدخل، نوع_مدخل، تجزئة_محسوبة)
                                فهرس = فهرس + 1
                            نهاية
                        نهاية
                        
                        إزاحة = إزاحة + ط_سجل
                    نهاية
                نهاية
            نهاية
            
            رقم_كتلة_م = رقم_كتلة_م + 1
        نهاية
    نهاية
    
    kernel_free(مخزن)
