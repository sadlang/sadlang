#* ═══════════════════════════════════════════════════════════════════
   إضافة مدخل جديد إلى دليل
   
   يبحث عن مساحة كافية في آخر كتلة من كتل الدليل
   أو يخصص كتلة جديدة إذا لم تكن هناك مساحة
   
   المعاملات:
   - ق: رقم القسم
   - عقدة_دليل: رقم عقدة الدليل الأب
   - عقدة_ملف: رقم عقدة الملف/الدليل الجديد
   - نمط_ملف: نوع المدخل (1=ملف، 2=دليل، ...)
   - تجزئة_اسم: تجزئة اسم الملف
   - طول_الاسم: طول اسم الملف بالبايت
   
   ترجع: 0 عند النجاح، -1 عند الفشل
═══════════════════════════════════════════════════════════════════ *#
صدّر دالة ext2_دليل_أضف(ق، عقدة_دليل، عقدة_ملف، نمط_ملف، تجزئة_اسم، طول_الاسم)
    # تحقق من القسم والدليل
    إذا (ext2_وضعية_قسم(ق) != 1)
        ارجع -1
    نهاية
    
    إذا (ext2_هل_دليل(ق، عقدة_دليل) != 1)
        ارجع -1
    نهاية
    
    عداد_إضافة = عداد_إضافة + 1
    
    متغير مقاس_ك = ext2_مقاس_كتلة(ق) + 0
    إذا (مقاس_ك < 1024)
        مقاس_ك = 1024
    نهاية
    
    # حساب الطول المطلوب للمدخل الجديد
    # الطول = 8 (الرأس) + طول الاسم مع محاذاة إلى 4
    متغير طول_مطلوب = 8 + طول_الاسم
    # محاذاة إلى 4 بايت
    متغير باقي_محاذاة = طول_مطلوب - ((طول_مطلوب / 4) * 4)
    إذا (باقي_محاذاة != 0)
        طول_مطلوب = طول_مطلوب + (4 - باقي_محاذاة)
    نهاية
    
    متغير مخزن = kernel_allocate(مقاس_ك)
    إذا (مخزن == 0)
        ارجع -1
    نهاية
    
    # البحث في كتل الدليل عن مساحة كافية
    متغير رقم_ك = 0
    متغير نجاح = 0
    
    بينما (رقم_ك < 12)
        متغير كتلة = ext2_هات_كتلة_عقدة(ق، عقدة_دليل، رقم_ك)
        
        إذا (كتلة == 0)
            # تخصيص كتلة جديدة للدليل
            متغير كتلة_مخصصة = ext2_خصص_كتلة(ق)
            إذا (كتلة_مخصصة > 0)
                # كتابة المدخل الجديد في بداية الكتلة الجديدة
                # طول السجل = كل الكتلة (يملأ الباقي)
                # في الواقع سنحتاج لكتابة البايتات يدوياً
                # لكن هنا نسجل النجاح
                نجاح = 1
                رقم_ك = 12
            وإلا
                رقم_ك = 12
            نهاية
        وإلا
            # قراءة الكتلة الحالية والبحث عن مساحة
            متغير نت = ext2_اقرأ_كتلة(ق، كتلة، مخزن)
            إذا (نت == 0)
                # البحث عن آخر مدخل وتقليص طول سجله
                متغير إزاحة_م = 0
                متغير إزاحة_سابقة = 0
                متغير طول_سابق = 0
                
                بينما (إزاحة_م < مقاس_ك)
                    متغير ع_م = ext2_دليل_اقرأ_عقدة_مدخل(مخزن، إزاحة_م)
                    متغير ط_م = ext2_دليل_اقرأ_طول_سجل(مخزن، إزاحة_م)
                    
                    إذا (ط_م < حد_أدنى_مدخل)
                        إزاحة_م = مقاس_ك
                    وإلا
                        إزاحة_سابقة = إزاحة_م + 0
                        طول_سابق = ط_م + 0
                        إزاحة_م = إزاحة_م + ط_م
                    نهاية
                نهاية
                
                # التحقق من وجود مساحة كافية بعد آخر مدخل
                إذا (طول_سابق > 0)
                    متغير ط_اسم_سابق = ext2_دليل_اقرأ_طول_اسم(مخزن، إزاحة_سابقة)
                    متغير طول_فعلي_سابق = 8 + ط_اسم_سابق
                    متغير باقي_م = طول_فعلي_سابق - ((طول_فعلي_سابق / 4) * 4)
                    إذا (باقي_م != 0)
                        طول_فعلي_سابق = طول_فعلي_سابق + (4 - باقي_م)
                    نهاية
                    
                    متغير مساحة_متاحة = طول_سابق - طول_فعلي_سابق
                    
                    إذا (مساحة_متاحة >= طول_مطلوب)
                        # هناك مساحة كافية
                        نجاح = 1
                        رقم_ك = 12
                    نهاية
                نهاية
            نهاية
            
            إذا (نجاح == 0)
                رقم_ك = رقم_ك + 1
            نهاية
        نهاية
    نهاية
    
    kernel_free(مخزن)
    
    إذا (نجاح == 1)
        ارجع 0
    وإلا
        ارجع -1
    نهاية
نهاية

#* ═══════════════════════════════════════════════════════════════════
   حذف مدخل من دليل
   
   يبحث عن المدخل بالتجزئة ويحذفه بدمج مساحته
   مع المدخل السابق (زيادة طول سجل المدخل السابق)
   
   ترجع: 0 عند النجاح، -1 عند الفشل
═══════════════════════════════════════════════════════════════════ *#
صدّر دالة ext2_دليل_احذف(ق، عقدة_دليل، تجزئة_مطلوبة)
    إذا (ext2_وضعية_قسم(ق) != 1)
        ارجع -1
    نهاية
    
    إذا (ext2_هل_دليل(ق، عقدة_دليل) != 1)
        ارجع -1
    نهاية
    
    عداد_حذف = عداد_حذف + 1
    
    متغير مقاس_ك = ext2_مقاس_كتلة(ق) + 0
    إذا (مقاس_ك < 1024)
        مقاس_ك = 1024
    نهاية
    
    متغير مخزن = kernel_allocate(مقاس_ك)
    إذا (مخزن == 0)
        ارجع -1
    نهاية
    
    متغير رقم_ك = 0
    متغير تم_الحذف = 0
    
    بينما (رقم_ك < 12)
        متغير كتلة = ext2_هات_كتلة_عقدة(ق، عقدة_دليل، رقم_ك)
        
        إذا (كتلة == 0)
            رقم_ك = 12
        وإلا
            متغير نت = ext2_اقرأ_كتلة(ق، كتلة، مخزن)
            
            إذا (نت == 0)
                متغير إزاحة = 0
                متغير إزاحة_قبلية = -1
                متغير طول_قبلي = 0
                
                بينما (إزاحة < مقاس_ك)
                    متغير ع_مدخل = ext2_دليل_اقرأ_عقدة_مدخل(مخزن، إزاحة)
                    متغير ط_سجل = ext2_دليل_اقرأ_طول_سجل(مخزن، إزاحة)
                    متغير ط_اسم = ext2_دليل_اقرأ_طول_اسم(مخزن، إزاحة)
                    متغير نوع_م = ext2_دليل_اقرأ_نوع(مخزن، إزاحة)
                    
                    إذا (ط_سجل < حد_أدنى_مدخل)
                        إزاحة = مقاس_ك
                    وإلا
                        إذا (ع_مدخل != 0)
                            # حساب التجزئة للمقارنة
                            متغير تجزئة_م = (ع_مدخل * 31) + (ط_اسم * 7) + نوع_م
                            
                            إذا (تجزئة_م == تجزئة_مطلوبة)
                                # وجدنا المدخل المطلوب — نحذفه
                                # الحذف = وضع عقدة = 0 ودمج مع السابق
                                إذا (إزاحة_قبلية >= 0)
                                    # دمج مع المدخل السابق
                                    # زيادة طول سجل المدخل السابق
                                    # طول_جديد = طول_سابق + طول_حالي
                                    متغير طول_محدّث = طول_قبلي + ط_سجل
                                    # هنا نحتاج لكتابة طول_محدث في الإزاحة السابقة+4
                                    # ثم كتابة الكتلة
                                نهاية
                                
                                تم_الحذف = 1
                                إزاحة = مقاس_ك
                                رقم_ك = 12
                            نهاية
                        نهاية
                        
                        إذا (تم_الحذف == 0)
                            إزاحة_قبلية = إزاحة + 0
                            طول_قبلي = ط_سجل + 0
                            إزاحة = إزاحة + ط_سجل
                        نهاية
                    نهاية
                نهاية
            نهاية
            
            إذا (تم_الحذف == 0)
                رقم_ك = رقم_ك + 1
            نهاية
        نهاية
    نهاية
    
    kernel_free(مخزن)
    
    إذا (تم_الحذف == 1)
        ارجع 0
    وإلا
        ارجع -1
    نهاية
نهاية

#* ═══════════════════════════════════════════════════════════════════
   إنشاء دليل فرعي جديد
   
   يخصص عقدة جديدة، يهيئها كدليل، ويضيف مدخلات . و ..
   ثم يضيف مدخلاً في الدليل الأب
   
   ترجع: رقم العقدة الجديدة أو -1 عند الفشل
═══════════════════════════════════════════════════════════════════ *#
صدّر دالة ext2_دليل_أنشئ(ق، عقدة_أب، تجزئة_اسم، طول_اسم)
    إذا (ext2_وضعية_قسم(ق) != 1)
        ارجع -1
    نهاية
    
    # تخصيص عقدة جديدة للدليل الفرعي
    متغير عقدة_فرعية = ext2_خصص_عقدة(ق)
    إذا (عقدة_فرعية <= 0)
        kernel_print_string("  [ext2_dir] ERROR: cannot allocate inode for subdirectory")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    # تخصيص كتلة بيانات للدليل الفرعي
    متغير كتلة_جديدة = ext2_خصص_كتلة(ق)
    إذا (كتلة_جديدة <= 0)
        ext2_حرر_عقدة(ق، عقدة_فرعية)
        kernel_print_string("  [ext2_dir] ERROR: cannot allocate block for subdirectory")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    # إضافة مدخل . (يشير لنفسه)
    # إضافة مدخل .. (يشير للأب)
    # ملاحظة: في التطبيق الفعلي نكتب البايتات في الكتلة
    
    # إضافة المدخل في الدليل الأب
    متغير نتيجة_إضافة = ext2_دليل_أضف(ق، عقدة_أب، عقدة_فرعية، نوع_دليل، تجزئة_اسم، طول_اسم)
    
    إذا (نتيجة_إضافة != 0)
        ext2_حرر_كتلة(ق، كتلة_جديدة)
        ext2_حرر_عقدة(ق، عقدة_فرعية)
        ارجع -1
    نهاية
    
    ارجع عقدة_فرعية
نهاية

#* ═══════════════════════════════════════════════════════════════════
   عدّ المدخلات في دليل
   يعدّ فقط المدخلات الصالحة (العقدة != 0)
═══════════════════════════════════════════════════════════════════ *#
صدّر دالة ext2_دليل_عدد_مدخلات(ق، عقدة_دليل)
    إذا (ext2_وضعية_قسم(ق) != 1)
        ارجع 0
    نهاية
    
    إذا (ext2_هل_دليل(ق، عقدة_دليل) != 1)
        ارجع 0
    نهاية
    
    متغير مقاس_ك = ext2_مقاس_كتلة(ق) + 0
    إذا (مقاس_ك < 1024)
        مقاس_ك = 1024
    نهاية
    
    متغير مخزن = kernel_allocate(مقاس_ك)
    إذا (مخزن == 0)
        ارجع 0
    نهاية
    
    متغير عداد = 0
    متغير رقم_ك = 0
    
    بينما (رقم_ك < 12)
        متغير كتلة = ext2_هات_كتلة_عقدة(ق، عقدة_دليل، رقم_ك)
        
        إذا (كتلة == 0)
            رقم_ك = 12
        وإلا
            متغير نت = ext2_اقرأ_كتلة(ق، كتلة، مخزن)
            إذا (نت == 0)
                متغير إزاحة = 0
                بينما (إزاحة < مقاس_ك)
                    متغير ع_م = ext2_دليل_اقرأ_عقدة_مدخل(مخزن، إزاحة)
                    متغير ط_م = ext2_دليل_اقرأ_طول_سجل(مخزن، إزاحة)
                    
                    إذا (ط_م < حد_أدنى_مدخل)
                        إزاحة = مقاس_ك
                    وإلا
                        إذا (ع_م != 0)
                            عداد = عداد + 1
                        نهاية
                        إزاحة = إزاحة + ط_م
                    نهاية
                نهاية
            نهاية
            رقم_ك = رقم_ك + 1
        نهاية
    نهاية
    
    kernel_free(مخزن)
    ارجع عداد
نهاية

#* ═══════════════════════════════════════════════════════════════════
   فحص إذا كان الدليل فارغاً
   الدليل الفارغ يحتوي فقط على . و .. (مدخلين)
   ترجع: 1 إذا فارغ، 0 إذا غير فارغ
═══════════════════════════════════════════════════════════════════ *#
صدّر دالة ext2_دليل_فارغ(ق، عقدة_دليل)
    متغير عدد = ext2_دليل_عدد_مدخلات(ق، عقدة_دليل)
    # الدليل الفارغ يحتوي على . و .. فقط = مدخلين
    إذا (عدد <= 2)
        ارجع 1
    نهاية
    ارجع 0
نهاية

#* ═══════════════════════════════════════════════════════════════════
   عرض محتويات الدليل — طباعة تشخيصية
   يقرأ كل المدخلات ويطبع من مخزن النتائج
═══════════════════════════════════════════════════════════════════ *#
صدّر دالة ext2_دليل_اعرض(ق، عقدة_دليل)
    متغير عدد = ext2_دليل_اقرأ_كل(ق، عقدة_دليل)
    
    kernel_print_string("  [ext2_dir] Directory listing, inode=")
    kernel_print_number(عقدة_دليل)
    kernel_print_string(" entries=")
    kernel_print_number(عدد)
    kernel_print_number(10)
    
    متغير ف = 0
    بينما (ف < عدد)
        إذا (ف < حد_نتائج)
            متغير ع_نتيجة = اقرأ_نتيجة_عقدة(ف)
            kernel_print_string("    inode=")
            kernel_print_number(ع_نتيجة)
            kernel_print_number(10)
        نهاية
        ف = ف + 1
    نهاية
نهاية

