#* ═══════════════════════════════════════════════════════════════════
   دالة: استخراج حقول مدخل الدليل من مخزن الكتلة
   
   بنية مدخل ext2:
   - بايت 0-3: رقم العقدة (inode) => 4 بايت عدد صحيح صغير الترتيب
   - بايت 4-5: طول السجل (rec_len) => 2 بايت
   - بايت 6: طول الاسم (name_len) => 1 بايت
   - بايت 7: نوع الملف (file_type) => 1 بايت
   - بايت 8+: الاسم بطول name_len

   نستخدم القسمة والمودولو بدلاً من العمليات الثنائية
   لاستخراج البايتات الفردية من القيم المقروءة
═══════════════════════════════════════════════════════════════════ *#

# استخراج رقم العقدة من مدخل (4 بايت little-endian)
# المدخل يبدأ عند إزاحة محددة في مخزن مؤقت
صدّر دالة ext2_دليل_اقرأ_عقدة_مدخل(مخزن، إزاحة)
    # قراءة 4 بايتات من مخزن الكتلة
    # بايت0 + بايت1*256 + بايت2*65536 + بايت3*16777216
    متغير ع0 = مخزن + إزاحة
    متغير ع1 = مخزن + إزاحة + 1
    متغير ع2 = مخزن + إزاحة + 2
    متغير ع3 = مخزن + إزاحة + 3
    
    # في بيئة النواة المخزن هو عنوان ذاكرة
    # نقرأ البايتات مباشرة
    متغير قيمة = ع0 + (ع1 * 256) + (ع2 * 65536) + (ع3 * 16777216)
    ارجع قيمة
نهاية

# استخراج طول السجل (2 بايت في الإزاحة 4-5)
صدّر دالة ext2_دليل_اقرأ_طول_سجل(مخزن، إزاحة)
    متغير ع0 = مخزن + إزاحة + 4
    متغير ع1 = مخزن + إزاحة + 5
    متغير قيمة = ع0 + (ع1 * 256)
    ارجع قيمة
نهاية

# استخراج طول الاسم (بايت واحد في الإزاحة 6)
صدّر دالة ext2_دليل_اقرأ_طول_اسم(مخزن، إزاحة)
    متغير قيمة = مخزن + إزاحة + 6
    ارجع قيمة
نهاية

# استخراج نوع الملف (بايت واحد في الإزاحة 7)
صدّر دالة ext2_دليل_اقرأ_نوع(مخزن، إزاحة)
    متغير قيمة = مخزن + إزاحة + 7
    ارجع قيمة
نهاية

#* ═══════════════════════════════════════════════════════════════════
   بحث عن مدخل في دليل بواسطة تجزئة الاسم
   
   يقرأ كتل بيانات الدليل واحدة تلو الأخرى
   ويفحص كل مدخل حتى يجد مدخلاً بتجزئة مطابقة
   
   المعاملات:
   - ق: رقم القسم (0-3)
   - عقدة_دليل: رقم عقدة الدليل المراد البحث فيه
   - تجزئة_مطلوبة: تجزئة الاسم المراد البحث عنه
   
   ترجع: رقم العقدة إذا وُجد المدخل، أو 0 إذا لم يوجد
═══════════════════════════════════════════════════════════════════ *#
صدّر دالة ext2_دليل_ابحث(ق، عقدة_دليل، تجزئة_مطلوبة)
    # تحقق أولاً أن القسم مركّب
    إذا (ext2_وضعية_قسم(ق) != 1)
        ارجع 0
    نهاية
    
    # تحقق أن العقدة هي فعلاً دليل
    إذا (ext2_هل_دليل(ق، عقدة_دليل) != 1)
        ارجع 0
    نهاية
    
    عداد_بحث = عداد_بحث + 1
    
    # الحصول على حجم الكتلة
    متغير مقاس_ك = ext2_مقاس_كتلة(ق) + 0
    إذا (مقاس_ك < 1024)
        مقاس_ك = 1024
    نهاية
    
    # مخزن للكتلة
    متغير مخزن = kernel_allocate(مقاس_ك)
    إذا (مخزن == 0)
        ارجع 0
    نهاية
    
    # فحص كل كتلة بيانات في الدليل
    # نفترض أقصى 12 كتلة مباشرة
    متغير رقم_كتلة_منطقي = 0
    متغير وُجد = 0
    متغير عقدة_ناتجة = 0
    
    بينما (رقم_كتلة_منطقي < 12)
        # الحصول على رقم الكتلة الفعلي
        متغير كتلة_فعلية = ext2_هات_كتلة_عقدة(ق، عقدة_دليل، رقم_كتلة_منطقي)
        
        # إذا الكتلة صفر فلا مزيد من البيانات
        إذا (كتلة_فعلية == 0)
            رقم_كتلة_منطقي = 12
        وإلا
            # قراءة الكتلة
            متغير نتيجة_قراءة = ext2_اقرأ_كتلة(ق، كتلة_فعلية، مخزن)
            
            إذا (نتيجة_قراءة == 0)
                # فحص المدخلات في هذه الكتلة
                متغير إزاحة_حالية = 0
                
                بينما (إزاحة_حالية < مقاس_ك)
                    # قراءة حقول المدخل
                    متغير عقدة_م = ext2_دليل_اقرأ_عقدة_مدخل(مخزن، إزاحة_حالية)
                    متغير طول_سجل = ext2_دليل_اقرأ_طول_سجل(مخزن، إزاحة_حالية)
                    متغير طول_اسم = ext2_دليل_اقرأ_طول_اسم(مخزن، إزاحة_حالية)
                    متغير نوع_م = ext2_دليل_اقرأ_نوع(مخزن، إزاحة_حالية)
                    
                    # تحقق من صحة طول السجل
                    إذا (طول_سجل < حد_أدنى_مدخل)
                        # مدخل تالف — اخرج
                        إزاحة_حالية = مقاس_ك
                    وإلا
                        # العقدة صفر تعني مدخل محذوف
                        إذا (عقدة_م != 0)
                            # حساب تجزئة هذا المدخل
                            # نستخدم تجزئة بسيطة: عقدة * 31 + طول_اسم * 7 + نوع
                            متغير تجزئة_م = (عقدة_م * 31) + (طول_اسم * 7) + نوع_م
                            
                            إذا (تجزئة_م == تجزئة_مطلوبة)
                                عقدة_ناتجة = عقدة_م + 0
                                وُجد = 1
                                إزاحة_حالية = مقاس_ك
                                رقم_كتلة_منطقي = 12
                            نهاية
                        نهاية
                        
                        إذا (وُجد == 0)
                            إزاحة_حالية = إزاحة_حالية + طول_سجل
                        نهاية
                    نهاية
                نهاية
            نهاية
            
            إذا (وُجد == 0)
                رقم_كتلة_منطقي = رقم_كتلة_منطقي + 1
            نهاية
        نهاية
    نهاية
    
    kernel_free(مخزن)
    ارجع عقدة_ناتجة
نهاية

#* ═══════════════════════════════════════════════════════════════════
   قراءة جميع مدخلات الدليل وتخزينها في مخزن النتائج
   
   يملأ المصفوفات المتوازية (نتيجة_عقدة، نتيجة_نوع، نتيجة_تجزئة)
   بمعلومات كل مدخل صالح في الدليل
   
   ترجع: عدد المدخلات المقروءة
═══════════════════════════════════════════════════════════════════ *#
صدّر دالة ext2_دليل_اقرأ_كل(ق، عقدة_دليل)
    # تحقق من القسم
    إذا (ext2_وضعية_قسم(ق) != 1)
        ارجع 0
    نهاية
    
    إذا (ext2_هل_دليل(ق، عقدة_دليل) != 1)
        ارجع 0
    نهاية
    
    عداد_قراءة = عداد_قراءة + 1
    
    # مسح النتائج السابقة
    امسح_نتائج()
    
    متغير مقاس_ك = ext2_مقاس_كتلة(ق) + 0
    إذا (مقاس_ك < 1024)
