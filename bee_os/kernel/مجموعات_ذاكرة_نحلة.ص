# ─── دوال خارجية (FFI) ───
خارجي دالة kernel_print_string(عنوان)
خارجي دالة kernel_print_number(قيمة)
خارجي دالة serial_put_hex(قيمة)
خارجي دالة kernel_allocate(المقاس)
خارجي دالة kernel_free(عنوان)
خارجي دالة mem_read_byte(عنوان)
خارجي دالة mem_write_byte(عنوان، قيمة)
خارجي دالة mem_read_dword(عنوان)
خارجي دالة mem_write_dword(عنوان، قيمة)
خارجي دالة sad_ll_memset(عنوان، قيمة، طول)
خارجي دالة sad_ll_memcpy(وجهة، مصدر، طول)

# ═══════════════════════════════════════════════════════════════════════════════
# ثوابت عامة للنظام
# ═══════════════════════════════════════════════════════════════════════════════

# ─── أقصى عدد مجموعات ───
ثابت أقصى_مجموعات = 64

# ─── مقاس سجل المجموعة الواحدة (بالبايت) ───
# الحقول: مفعّلة، المعرّف، الأب، الأبناء[8]، عدد_الأبناء،
#          حدّ_صارم، حدّ_مرن، استخدام_rss، استخدام_مخبأ، استخدام_تبديل،
#          عدد_عمليات، عدد_أحداث_oom، عتبة_تنبيه، تنبيه_مفعّل،
#          عدّاد_شحن، عدّاد_تفريغ، أعلام، أب_يحسب، طابع_إنشاء،
#          اسم_طول، اسم[16 كلمة]
# إجمالي ≈ 50 حقل × 4 بايت = 200 بايت → نختار 256 بايت للمحاذاة
ثابت مقاس_سجل_مجموعة = 256

# ─── إزاحات الحقول داخل سجل المجموعة ───
ثابت إزاحة_مفعّلة = 0           # 0 = فارغة، 1 = نشطة
ثابت إزاحة_معرّف = 4            # معرّف فريد للمجموعة
ثابت إزاحة_أب = 8               # معرّف المجموعة الأب (-1 = جذر)
ثابت إزاحة_عدد_أبناء = 12       # عدد الأبناء الحاليين
ثابت إزاحة_أبناء = 16           # مصفوفة أبناء: 8 خانات × 4 بايت = 32 بايت
# الإزاحة 16..47 للأبناء
ثابت إزاحة_حدّ_صارم = 48        # الحدّ الأقصى الصارم للذاكرة
ثابت إزاحة_حدّ_مرن = 52         # الحدّ المرن (يحاول عدم تجاوزه)
ثابت إزاحة_استخدام_rss = 56     # الذاكرة الفعلية المستخدمة
ثابت إزاحة_استخدام_مخبأ = 60    # ذاكرة المخبأ المستخدمة
ثابت إزاحة_استخدام_تبديل = 64   # ذاكرة التبديل المستخدمة
ثابت إزاحة_عدد_عمليات = 68      # عدد العمليات في المجموعة
ثابت إزاحة_أحداث_oom = 72       # عدد مرات حدوث OOM
ثابت إزاحة_عتبة_تنبيه = 76      # عتبة التنبيه (نسبة مئوية 0-100)
ثابت إزاحة_تنبيه_مفعّل = 80     # هل التنبيه مفعّل
ثابت إزاحة_عدّاد_شحن = 84       # إجمالي عمليات الشحن
ثابت إزاحة_عدّاد_تفريغ = 88     # إجمالي عمليات التفريغ
ثابت إزاحة_أعلام = 92           # أعلام متنوعة
ثابت إزاحة_أب_يحسب = 96         # هل الأب يحسب أبناءه (1=نعم)
ثابت إزاحة_طابع_إنشاء = 100     # طابع زمني للإنشاء
ثابت إزاحة_اسم_طول = 104        # طول اسم المجموعة
ثابت إزاحة_اسم = 108            # بداية اسم المجموعة (16 كلمة = 64 بايت)

# ─── أعلام المجموعة ───
ثابت علم_جذر = 1                # المجموعة هي الجذر
ثابت علم_محمية = 2              # محمية من الحذف
ثابت علم_oom_قتل = 4            # تفعيل القتل عند OOM
ثابت علم_مجمّدة = 8             # المجموعة مجمّدة (لا تقبل عمليات جديدة)
ثابت علم_تحتسب_هرمياً = 16      # الحساب الهرمي مفعّل

# ─── حالات التنبيه ───
ثابت تنبيه_منخفض = 1            # استخدام منخفض
ثابت تنبيه_متوسط = 2            # استخدام متوسط
ثابت تنبيه_مرتفع = 3            # استخدام مرتفع
ثابت تنبيه_حرج = 4              # حالة حرجة

# ─── ثوابت إضافية ───
ثابت أقصى_أبناء = 8             # أقصى عدد أبناء لمجموعة واحدة
ثابت لا_حدّ = 4294967295         # 0xFFFFFFFF — بلا حدود
ثابت أقصى_أحداث = 256           # مخزن الأحداث
ثابت مقاس_سجل_حدث = 16         # كل حدث: فئة + مجموعة + قيمة + طابع

# ─── إزاحات سجل الحدث ───
ثابت إزاحة_حدث_فئة = 0          # فئة الحدث
ثابت إزاحة_حدث_مجموعة = 4       # معرّف المجموعة
ثابت إزاحة_حدث_قيمة = 8         # قيمة مرتبطة
ثابت إزاحة_حدث_طابع = 12        # طابع زمني

# ─── أنواع الأحداث ───
ثابت حدث_إنشاء = 1              # إنشاء مجموعة
ثابت حدث_حذف = 2                # حذف مجموعة
ثابت حدث_oom = 3                 # حدوث OOM
ثابت حدث_عتبة = 4               # تجاوز عتبة
ثابت حدث_حدّ_صارم = 5           # وصول للحدّ الصارم
ثابت حدث_حدّ_مرن = 6            # تجاوز الحدّ المرن
ثابت حدث_ترحيل = 7              # ترحيل عملية
ثابت حدث_تجميد = 8              # تجميد مجموعة

# ═══════════════════════════════════════════════════════════════════════════════
# متغيرات عامة
# ═══════════════════════════════════════════════════════════════════════════════

متغير ذاكرة_مجموعات = 0          # عنوان قاعدة مصفوفة المجموعات
متغير عدّاد_مجموعات = 0          # عدد المجموعات النشطة حالياً
متغير معرّف_تالي = 1             # المعرّف التالي للتوزيع
متغير مجموعة_جذر = -1            # فهرس المجموعة الجذر
متغير ذاكرة_أحداث = 0            # عنوان مخزن الأحداث
متغير فهرس_حدث_تالي = 0          # الفهرس التالي في حلقة الأحداث
متغير عدد_أحداث_كلي = 0          # إجمالي الأحداث المسجلة
متغير النظام_مبدأ = 0             # هل تمّ التهيئة
متغير طابع_عام = 0               # عدّاد زمني بسيط
متغير إجمالي_ذاكرة_نظام = 0      # إجمالي الذاكرة المتاحة للنظام

# ═══════════════════════════════════════════════════════════════════════════════
# دوال مساعدة للمصفوفات (نمط الوصول العام)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── كتابة كلمة (4 بايت) في مصفوفة ───
دالة كتابة_ح(قاعدة، فهرس، قيمة)
    mem_write_dword(قاعدة + فهرس * 4، قيمة)
نهاية

# ─── قراءة كلمة (4 بايت) من مصفوفة ───
دالة قراءة_ح(قاعدة، فهرس)
    ارجع mem_read_dword(قاعدة + فهرس * 4)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# دوال الوصول لحقول سجل المجموعة
# ═══════════════════════════════════════════════════════════════════════════════

# ─── حساب عنوان بداية سجل مجموعة بفهرسها ───
دالة عنوان_مجموعة(فهرس)
    ارجع ذاكرة_مجموعات + فهرس * مقاس_سجل_مجموعة
نهاية

# ─── قراءة حقل من سجل مجموعة ───
دالة قراءة_حقل(فهرس، إزاحة)
    متغير عنوان_ق = عنوان_مجموعة(فهرس) + إزاحة
    ارجع mem_read_dword(عنوان_ق)
نهاية

# ─── كتابة حقل في سجل مجموعة ───
دالة كتابة_حقل(فهرس، إزاحة، قيمة)
    متغير عنوان_ق = عنوان_مجموعة(فهرس) + إزاحة
    mem_write_dword(عنوان_ق، قيمة)
نهاية

# ─── هل المجموعة مفعّلة؟ ───
دالة مجموعة_مفعّلة(فهرس)
    إذا (فهرس < 0)
        ارجع 0
    نهاية
    إذا (فهرس >= أقصى_مجموعات)
        ارجع 0
    نهاية
    ارجع قراءة_حقل(فهرس، إزاحة_مفعّلة)
نهاية

# ─── الحصول على معرّف المجموعة ───
دالة معرّف_مجموعة(فهرس)
    ارجع قراءة_حقل(فهرس، إزاحة_معرّف)
نهاية

# ─── الحصول على فهرس الأب ───
دالة أب_مجموعة(فهرس)
    ارجع قراءة_حقل(فهرس، إزاحة_أب)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# دوال طباعة التشخيص
# ═══════════════════════════════════════════════════════════════════════════════

# ─── طباعة رسالة بادئة النظام ───
دالة طباعة_بادئة()
    kernel_print_string("[مجموعات_ذاكرة] ")
نهاية

# ─── طباعة رسالة معلومات ───
دالة طباعة_معلومة(رسالة)
    طباعة_بادئة()
    kernel_print_string(رسالة)
    kernel_print_string("\n")
نهاية

# ─── طباعة رسالة مع رقم ───
دالة طباعة_معلومة_رقم(رسالة، رقم_م)
    طباعة_بادئة()
    kernel_print_string(رسالة)
    kernel_print_number(رقم_م)
    kernel_print_string("\n")
نهاية

# ─── طباعة تحذير ───
دالة طباعة_تحذير(رسالة)
    kernel_print_string("[مجموعات_ذاكرة:تحذير] ")
    kernel_print_string(رسالة)
    kernel_print_string("\n")
نهاية

# ─── طباعة خطأ ───
دالة طباعة_خلل(رسالة)
    kernel_print_string("[مجموعات_ذاكرة:خلل] ")
    kernel_print_string(رسالة)
    kernel_print_string("\n")
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# دوال إدارة الأحداث
# ═══════════════════════════════════════════════════════════════════════════════

# ─── تقديم الطابع الزمني ───
دالة تقديم_طابع()
    طابع_عام = طابع_عام + 1
    ارجع طابع_عام
نهاية

# ─── تسجيل حدث جديد ───
دالة تسجيل_حدث(فئة_حدث، معرّف_مج، قيمة_حدث)
    إذا (ذاكرة_أحداث == 0)
        ارجع 0
    نهاية

    # حساب عنوان سجل الحدث (حلقة دائرية)
    متغير إزاحة_ح = فهرس_حدث_تالي * مقاس_سجل_حدث
    متغير عنوان_سجل = ذاكرة_أحداث + إزاحة_ح

    # كتابة حقول الحدث
    mem_write_dword(عنوان_سجل + إزاحة_حدث_فئة، فئة_حدث)
    mem_write_dword(عنوان_سجل + إزاحة_حدث_مجموعة، معرّف_مج)
    mem_write_dword(عنوان_سجل + إزاحة_حدث_قيمة، قيمة_حدث)
    mem_write_dword(عنوان_سجل + إزاحة_حدث_طابع، تقديم_طابع())

    # تقديم الفهرس الدائري
    فهرس_حدث_تالي = فهرس_حدث_تالي + 1
    إذا (فهرس_حدث_تالي >= أقصى_أحداث)
        فهرس_حدث_تالي = 0
    نهاية
    عدد_أحداث_كلي = عدد_أحداث_كلي + 1

    ارجع 1
نهاية

# ─── قراءة حدث بفهرسه ───
دالة قراءة_حدث_فئة(فهرس_حد)
    متغير إزاحة_ح = فهرس_حد * مقاس_سجل_حدث
    ارجع mem_read_dword(ذاكرة_أحداث + إزاحة_ح + إزاحة_حدث_فئة)
نهاية

دالة قراءة_حدث_مجموعة(فهرس_حد)
    متغير إزاحة_ح = فهرس_حد * مقاس_سجل_حدث
    ارجع mem_read_dword(ذاكرة_أحداث + إزاحة_ح + إزاحة_حدث_مجموعة)
نهاية

دالة قراءة_حدث_قيمة(فهرس_حد)
    متغير إزاحة_ح = فهرس_حد * مقاس_سجل_حدث
    ارجع mem_read_dword(ذاكرة_أحداث + إزاحة_ح + إزاحة_حدث_قيمة)
نهاية

دالة قراءة_حدث_طابع(فهرس_حد)
    متغير إزاحة_ح = فهرس_حد * مقاس_سجل_حدث
    ارجع mem_read_dword(ذاكرة_أحداث + إزاحة_ح + إزاحة_حدث_طابع)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إيجاد خانة فارغة
# ═══════════════════════════════════════════════════════════════════════════════

# ─── البحث عن أول خانة فارغة في مصفوفة المجموعات ───
دالة إيجاد_خانة_فارغة()
    متغير ع = 0
    بينما (ع < أقصى_مجموعات)
        متغير نشطة = قراءة_حقل(ع، إزاحة_مفعّلة)
        إذا (نشطة == 0)
            ارجع ع
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية

# ─── البحث عن مجموعة بمعرّفها ───
دالة إيجاد_بمعرّف(المعرّف)
    متغير ع = 0
    بينما (ع < أقصى_مجموعات)
        إذا (مجموعة_مفعّلة(ع) == 1)
            متغير م = قراءة_حقل(ع، إزاحة_معرّف)
            إذا (م == المعرّف)
                ارجع ع
            نهاية
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إنشاء مجموعة جديدة
# ═══════════════════════════════════════════════════════════════════════════════

# ─── تهيئة سجل مجموعة جديدة ───
دالة تهيئة_سجل_مجموعة(فهرس)
    متغير عنوان_بداية = عنوان_مجموعة(فهرس)
    sad_ll_memset(عنوان_بداية، 0، مقاس_سجل_مجموعة)
نهاية

# ─── إنشاء مجموعة جديدة ───
# فهرس_أب: فهرس الأب (-1 إذا كانت جذر)
# حصة_صارمة: الحدّ الأقصى للذاكرة
# حصة_مرنة: الحدّ المرن
# ارجع: فهرس المجموعة الجديدة أو -1 عند الفشل
صدّر دالة إنشاء_مجموعة(فهرس_أب، حصة_صارمة، حصة_مرنة)
    # التحقق من عدم تجاوز الحدّ الأقصى
    إذا (عدّاد_مجموعات >= أقصى_مجموعات)
        طباعة_خلل("تجاوز الحدّ الأقصى للمجموعات")
        ارجع -1
    نهاية

    # إيجاد خانة فارغة
    متغير خانة = إيجاد_خانة_فارغة()
    إذا (خانة == -1)
        طباعة_خلل("لا توجد خانة فارغة")
        ارجع -1
    نهاية

    # التحقق من صلاحية الأب (إن وُجد)
    إذا (فهرس_أب >= 0)
        إذا (مجموعة_مفعّلة(فهرس_أب) == 0)
            طباعة_خلل("الأب غير موجود")
            ارجع -1
        نهاية

        # التحقق من عدم تجاوز أقصى أبناء
        متغير أبناء_حاليون = قراءة_حقل(فهرس_أب، إزاحة_عدد_أبناء)
        إذا (أبناء_حاليون >= أقصى_أبناء)
            طباعة_خلل("الأب وصل لأقصى عدد أبناء")
            ارجع -1
        نهاية
    نهاية

    # تهيئة السجل
    تهيئة_سجل_مجموعة(خانة)

    # تعيين الحقول الأساسية
    متغير معرّف_جديد = معرّف_تالي
    معرّف_تالي = معرّف_تالي + 1

    كتابة_حقل(خانة، إزاحة_مفعّلة، 1)
    كتابة_حقل(خانة، إزاحة_معرّف، معرّف_جديد)
    كتابة_حقل(خانة، إزاحة_أب، فهرس_أب)
    كتابة_حقل(خانة، إزاحة_حدّ_صارم، حصة_صارمة)
    كتابة_حقل(خانة، إزاحة_حدّ_مرن، حصة_مرنة)
    كتابة_حقل(خانة، إزاحة_طابع_إنشاء، تقديم_طابع())
    كتابة_حقل(خانة، إزاحة_أعلام، علم_oom_قتل)
    كتابة_حقل(خانة، إزاحة_أب_يحسب، 1)

    # ربط بالأب إن وُجد
    إذا (فهرس_أب >= 0)
        متغير أبناء_ع = قراءة_حقل(فهرس_أب، إزاحة_عدد_أبناء)
        # كتابة فهرس الابن في مصفوفة أبناء الأب
        متغير إزاحة_ابن = إزاحة_أبناء + أبناء_ع * 4
        كتابة_حقل(فهرس_أب، إزاحة_ابن، خانة)
        كتابة_حقل(فهرس_أب، إزاحة_عدد_أبناء، أبناء_ع + 1)

        # وراثة الحساب الهرمي من الأب
        متغير أعلام_أب = قراءة_حقل(فهرس_أب، إزاحة_أعلام)
        متغير يحسب_هرمي = أعلام_أب & علم_تحتسب_هرمياً
        إذا (يحسب_هرمي > 0)
            متغير أعلام_ابن = قراءة_حقل(خانة، إزاحة_أعلام)
            أعلام_ابن = أعلام_ابن | علم_تحتسب_هرمياً
            كتابة_حقل(خانة، إزاحة_أعلام، أعلام_ابن)
        نهاية
    وإلا
        # هذه مجموعة جذر
        متغير أعلام_ج = قراءة_حقل(خانة، إزاحة_أعلام)
        أعلام_ج = أعلام_ج | علم_جذر
        أعلام_ج = أعلام_ج | علم_تحتسب_هرمياً
        أعلام_ج = أعلام_ج | علم_محمية
        كتابة_حقل(خانة، إزاحة_أعلام، أعلام_ج)
    نهاية

    عدّاد_مجموعات = عدّاد_مجموعات + 1

    # تسجيل حدث الإنشاء
    تسجيل_حدث(حدث_إنشاء، معرّف_جديد، حصة_صارمة)

    طباعة_معلومة_رقم("تم إنشاء مجموعة جديدة، المعرّف: "، معرّف_جديد)
