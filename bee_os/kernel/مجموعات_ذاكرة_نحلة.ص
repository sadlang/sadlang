        متغير فهرس_ابن = قراءة_حقل(فهرس، إزاحة_ابن2)
        إذا (مجموعة_مفعّلة(فهرس_ابن) == 1)
            متغير نتيجة_oom = معالجة_oom(فهرس_ابن)
            إذا (نتيجة_oom == 0)
                ارجع 0
            نهاية
        نهاية
        ع = ع + 1
    نهاية

    # ثانياً: حاول في المجموعة نفسها
    ارجع معالجة_oom(فهرس)
نهاية

