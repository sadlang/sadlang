        ارجع -1
    نهاية
    ارجع فهرس
نهاية

# ─── معالجة OOM لمجموعة محددة ───
صدّر دالة معالجة_oom(فهرس)
    إذا (مجموعة_مفعّلة(فهرس) == 0)
        ارجع -1
    نهاية

    # فحص عَلم القتل عند OOM
    متغير أعلام_oom = قراءة_حقل(فهرس، إزاحة_أعلام)
    متغير يقتل = أعلام_oom & علم_oom_قتل
    إذا (يقتل == 0)
        طباعة_تحذير("OOM: القتل معطّل لهذه المجموعة")
        ارجع -1
    نهاية

    # هل المجموعة مجمّدة؟
    متغير مجمّدة = أعلام_oom & علم_مجمّدة
    إذا (مجمّدة > 0)
        طباعة_تحذير("OOM: المجموعة مجمّدة")
        ارجع -1
    نهاية

    طباعة_معلومة("=== معالجة OOM ===")
    طباعة_معلومة_رقم("المجموعة: "، قراءة_حقل(فهرس، إزاحة_معرّف))

    # اختيار الضحية
    متغير ضحية = اختيار_ضحية(فهرس)
    إذا (ضحية == -1)
        طباعة_تحذير("لا توجد عمليات لقتلها")
        ارجع -1
    نهاية

    # محاكاة القتل: تقليل عدد العمليات والاستخدام
    متغير عدد_عم2 = قراءة_حقل(فهرس، إزاحة_عدد_عمليات)
    إذا (عدد_عم2 > 0)
        كتابة_حقل(فهرس، إزاحة_عدد_عمليات، عدد_عم2 - 1)
    نهاية

    # تحرير بعض الذاكرة (محاكاة)
    متغير rss_حالي = قراءة_حقل(فهرس، إزاحة_استخدام_rss)
    متغير تحرير = rss_حالي / 4
    إذا (تحرير > 0)
        تفريغ_ذاكرة(فهرس، تحرير، 0)
    نهاية

    # تسجيل حدث OOM
    متغير أحداث_oom = قراءة_حقل(فهرس، إزاحة_أحداث_oom)
    كتابة_حقل(فهرس، إزاحة_أحداث_oom، أحداث_oom + 1)

    متغير المعرّف_oom = قراءة_حقل(فهرس، إزاحة_معرّف)
    تسجيل_حدث(حدث_oom، المعرّف_oom، تحرير)

    طباعة_معلومة_رقم("ذاكرة محررة: "، تحرير)
    ارجع 0
نهاية

# ─── معالجة OOM هرمية (من الأبناء للأب) ───
دالة معالجة_oom_هرمية(فهرس)
    إذا (مجموعة_مفعّلة(فهرس) == 0)
