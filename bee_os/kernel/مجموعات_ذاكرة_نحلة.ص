# ─── تحديث الاستخدام الهرمي (الأب يرى أبناءه) ───
دالة تحديث_هرمي(فهرس، إزاحة_حقل_م، كمية، اتجاه)
    # اتجاه: 1 = إضافة، -1 = طرح
    متغير فهرس_حالي = فهرس
    بينما (فهرس_حالي >= 0)
        إذا (مجموعة_مفعّلة(فهرس_حالي) == 0)
            ارجع 0
        نهاية

        متغير أعلام_ه = قراءة_حقل(فهرس_حالي، إزاحة_أعلام)
        متغير هرمي = أعلام_ه & علم_تحتسب_هرمياً
        إذا (هرمي == 0)
            إذا (فهرس_حالي != فهرس)
                ارجع 0
            نهاية
        نهاية

        متغير قيمة_حالية = قراءة_حقل(فهرس_حالي، إزاحة_حقل_م)
        إذا (اتجاه > 0)
            قيمة_حالية = قيمة_حالية + كمية
        وإلا
            إذا (قيمة_حالية >= كمية)
                قيمة_حالية = قيمة_حالية - كمية
            وإلا
                قيمة_حالية = 0
            نهاية
        نهاية
        كتابة_حقل(فهرس_حالي، إزاحة_حقل_م، قيمة_حالية)

        # الانتقال للأب
        فهرس_حالي = قراءة_حقل(فهرس_حالي، إزاحة_أب)
    نهاية
    ارجع 1
نهاية

# ─── فحص التنبيهات بعد تغيير الاستخدام ───
دالة فحص_تنبيهات(فهرس)
    متغير مفعّل_ت = قراءة_حقل(فهرس، إزاحة_تنبيه_مفعّل)
    إذا (مفعّل_ت == 0)
        ارجع 0
    نهاية

    متغير استخدام_كلي = قراءة_حقل(فهرس، إزاحة_استخدام_rss)
    متغير مخبأ_م = قراءة_حقل(فهرس، إزاحة_استخدام_مخبأ)
    استخدام_كلي = استخدام_كلي + مخبأ_م

    متغير الحدّ_ص = قراءة_حقل(فهرس، إزاحة_حدّ_صارم)
    إذا (الحدّ_ص == 0)
        ارجع 0
    نهاية
    إذا (الحدّ_ص == لا_حدّ)
        ارجع 0
    نهاية

    # حساب النسبة المئوية (تقريبي)
    متغير نسبة = (استخدام_كلي * 100) / الحدّ_ص
    متغير العتبة = قراءة_حقل(فهرس، إزاحة_عتبة_تنبيه)

    إذا (نسبة >= العتبة)
        متغير المعرّف_ت = قراءة_حقل(فهرس، إزاحة_معرّف)
        تسجيل_حدث(حدث_عتبة، المعرّف_ت، نسبة)
        طباعة_معلومة_رقم("تنبيه: تجاوز عتبة الاستخدام، نسبة: "، نسبة)
        ارجع 1
    نهاية

    ارجع 0
نهاية

# ─── شحن ذاكرة (تسجيل تخصيص ذاكرة في مجموعة) ───
# فئة_ذ: 0 = RSS، 1 = مخبأ، 2 = تبديل
صدّر دالة شحن_ذاكرة(فهرس، كمية، فئة_ذ)
    إذا (مجموعة_مفعّلة(فهرس) == 0)
        طباعة_خلل("شحن: المجموعة غير مفعّلة")
        ارجع -1
    نهاية

    # تحديد حقل الاستخدام حسب الفئة
    متغير إزاحة_استخدام = إزاحة_استخدام_rss
    إذا (فئة_ذ == 1)
        إزاحة_استخدام = إزاحة_استخدام_مخبأ
    نهاية
    إذا (فئة_ذ == 2)
        إزاحة_استخدام = إزاحة_استخدام_تبديل
    نهاية

    # فحص الحدّ الصارم (فقط للـ RSS)
    إذا (فئة_ذ == 0)
        متغير الحدّ = قراءة_حقل(فهرس، إزاحة_حدّ_صارم)
        إذا (الحدّ != لا_حدّ)
            متغير حالي_rss = قراءة_حقل(فهرس، إزاحة_استخدام_rss)
            متغير بعد_إضافة = حالي_rss + كمية
            إذا (بعد_إضافة > الحدّ)
                # محاولة معالجة OOM
                متغير المعرّف_ش = قراءة_حقل(فهرس، إزاحة_معرّف)
                تسجيل_حدث(حدث_حدّ_صارم، المعرّف_ش، بعد_إضافة)
                طباعة_تحذير("شحن: تجاوز الحدّ الصارم")
                ارجع -2
            نهاية
        نهاية

        # فحص الحدّ المرن
        متغير الحدّ_مرن_ش = قراءة_حقل(فهرس، إزاحة_حدّ_مرن)
        إذا (الحدّ_مرن_ش != لا_حدّ)
            متغير حالي_مرن = قراءة_حقل(فهرس، إزاحة_استخدام_rss)
            متغير بعد_مرن = حالي_مرن + كمية
            إذا (بعد_مرن > الحدّ_مرن_ش)
                متغير المعرّف_مش = قراءة_حقل(فهرس، إزاحة_معرّف)
                تسجيل_حدث(حدث_حدّ_مرن، المعرّف_مش، بعد_مرن)
            نهاية
        نهاية
    نهاية

    # فحص الحدّ الصارم هرمياً (ينطبق على كل الآباء)
    إذا (فئة_ذ == 0)
        متغير فهرس_فحص = قراءة_حقل(فهرس، إزاحة_أب)
        بينما (فهرس_فحص >= 0)
            إذا (مجموعة_مفعّلة(فهرس_فحص) == 1)
                متغير حدّ_أب_ص = قراءة_حقل(فهرس_فحص، إزاحة_حدّ_صارم)
                إذا (حدّ_أب_ص != لا_حدّ)
                    متغير حالي_أب = قراءة_حقل(فهرس_فحص، إزاحة_استخدام_rss)
                    متغير بعد_أب = حالي_أب + كمية
                    إذا (بعد_أب > حدّ_أب_ص)
                        طباعة_تحذير("شحن: تجاوز حدّ الأب الصارم")
                        ارجع -3
                    نهاية
                نهاية
            نهاية
            فهرس_فحص = قراءة_حقل(فهرس_فحص، إزاحة_أب)
        نهاية
    نهاية

    # تحديث الاستخدام هرمياً
    تحديث_هرمي(فهرس، إزاحة_استخدام، كمية، 1)

    # تحديث عدّاد الشحن
    متغير شحن_ق = قراءة_حقل(فهرس، إزاحة_عدّاد_شحن)
    كتابة_حقل(فهرس، إزاحة_عدّاد_شحن، شحن_ق + 1)

    # فحص التنبيهات
    فحص_تنبيهات(فهرس)

    ارجع 0
نهاية

# ─── تفريغ ذاكرة (تسجيل تحرير ذاكرة من مجموعة) ───
صدّر دالة تفريغ_ذاكرة(فهرس، كمية، فئة_ذ)
    إذا (مجموعة_مفعّلة(فهرس) == 0)
        طباعة_خلل("تفريغ: المجموعة غير مفعّلة")
        ارجع -1
    نهاية

    # تحديد حقل الاستخدام
    متغير إزاحة_استخدام = إزاحة_استخدام_rss
    إذا (فئة_ذ == 1)
        إزاحة_استخدام = إزاحة_استخدام_مخبأ
    نهاية
    إذا (فئة_ذ == 2)
        إزاحة_استخدام = إزاحة_استخدام_تبديل
    نهاية

    # تحديث الاستخدام هرمياً (طرح)
    تحديث_هرمي(فهرس، إزاحة_استخدام، كمية، -1)

    # تحديث عدّاد التفريغ
    متغير تفريغ_ق = قراءة_حقل(فهرس، إزاحة_عدّاد_تفريغ)
    كتابة_حقل(فهرس، إزاحة_عدّاد_تفريغ، تفريغ_ق + 1)

    ارجع 0
