# ─── إزالة ابن من مصفوفة أبناء الأب ───
دالة إزالة_ابن_من_أب(فهرس_أب، فهرس_ابن)
    إذا (فهرس_أب < 0)
        ارجع 0
    نهاية
    إذا (مجموعة_مفعّلة(فهرس_أب) == 0)
        ارجع 0
    نهاية

    متغير عدد_أب = قراءة_حقل(فهرس_أب، إزاحة_عدد_أبناء)
    متغير ع = 0
    متغير وُجد = 0
    بينما (ع < عدد_أب)
        متغير إزاحة_م = إزاحة_أبناء + ع * 4
        متغير ابن_حالي = قراءة_حقل(فهرس_أب، إزاحة_م)
        إذا (ابن_حالي == فهرس_ابن)
            وُجد = 1
            # نقل الأبناء التاليين للخلف
            متغير ي = ع
            بينما (ي < عدد_أب - 1)
                متغير إزاحة_تالي = إزاحة_أبناء + (ي + 1) * 4
                متغير إزاحة_حالي = إزاحة_أبناء + ي * 4
                متغير قيمة_تالي = قراءة_حقل(فهرس_أب، إزاحة_تالي)
                كتابة_حقل(فهرس_أب، إزاحة_حالي، قيمة_تالي)
                ي = ي + 1
            نهاية
            # مسح الخانة الأخيرة
            متغير إزاحة_أخيرة = إزاحة_أبناء + (عدد_أب - 1) * 4
            كتابة_حقل(فهرس_أب، إزاحة_أخيرة، 0)
            كتابة_حقل(فهرس_أب، إزاحة_عدد_أبناء، عدد_أب - 1)
            ارجع 1
        نهاية
        ع = ع + 1
    نهاية
    ارجع وُجد
نهاية

# ─── حذف مجموعة (يجب أن تكون فارغة من الأبناء والعمليات) ───
