# ═══════════════════════════════════════════════════════════════════════════════
# بناء CBW — Command Block Wrapper
# ═══════════════════════════════════════════════════════════════════════════════
# CBW layout (31 bytes):
# Offset 0-3:   dCBWSignature (0x43425355)
# Offset 4-7:   dCBWTag
# Offset 8-11:  dCBWDataTransferLength
# Offset 12:    bmCBWFlags (0x80=IN, 0x00=OUT)
# Offset 13:    bCBWLUN (bits 0-3)
# Offset 14:    bCBWCBLength (command length, 6-16)
# Offset 15-30: CBWCB (the SCSI command, up to 16 bytes)

صدّر دالة msc_build_cbw(cbw_buf، tag، xfer_len، direction، lun، cb_len)
    sad_ll_memset(cbw_buf، 0، CBW_SIZE)

    # Signature: 0x43425355 in little-endian
    sad_ll_mem_write8(cbw_buf + 0، 85)   # 0x55 'U'
    sad_ll_mem_write8(cbw_buf + 1، 83)   # 0x53 'S'
    sad_ll_mem_write8(cbw_buf + 2، 66)   # 0x42 'B'
    sad_ll_mem_write8(cbw_buf + 3، 67)   # 0x43 'C'

    # Tag (little-endian)
    sad_ll_mem_write8(cbw_buf + 4، tag % 256)
    sad_ll_mem_write8(cbw_buf + 5، (tag / 256) % 256)
    sad_ll_mem_write8(cbw_buf + 6، (tag / 65536) % 256)
    sad_ll_mem_write8(cbw_buf + 7، (tag / 16777216) % 256)

    # Data Transfer Length (little-endian)
    sad_ll_mem_write8(cbw_buf + 8، xfer_len % 256)
    sad_ll_mem_write8(cbw_buf + 9، (xfer_len / 256) % 256)
    sad_ll_mem_write8(cbw_buf + 10، (xfer_len / 65536) % 256)
    sad_ll_mem_write8(cbw_buf + 11، (xfer_len / 16777216) % 256)

    # Flags
    sad_ll_mem_write8(cbw_buf + 12، direction + 0)

    # LUN
    sad_ll_mem_write8(cbw_buf + 13، lun + 0)

    # CB Length
    sad_ll_mem_write8(cbw_buf + 14، cb_len + 0)

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحليل CSW — Command Status Wrapper
# ═══════════════════════════════════════════════════════════════════════════════
# CSW layout (13 bytes):
# Offset 0-3:   dCSWSignature (0x53425355)
# Offset 4-7:   dCSWTag (must match CBW tag)
# Offset 8-11:  dCSWDataResidue
# Offset 12:    bCSWStatus (0=pass, 1=fail, 2=phase error)

صدّر دالة msc_parse_csw(csw_buf، expected_tag)
    # التحقق من التوقيع
    متغير sig_0 = sad_ll_mem_read8(csw_buf + 0) + 0
    متغير sig_1 = sad_ll_mem_read8(csw_buf + 1) + 0
    متغير sig_2 = sad_ll_mem_read8(csw_buf + 2) + 0
    متغير sig_3 = sad_ll_mem_read8(csw_buf + 3) + 0

    إذا (sig_0 != 85) ارجع 0 - 1 نهاية   # 'U'
    إذا (sig_1 != 83) ارجع 0 - 1 نهاية   # 'S'
    إذا (sig_2 != 66) ارجع 0 - 1 نهاية   # 'B'
    إذا (sig_3 != 83) ارجع 0 - 1 نهاية   # 'S'

    # التحقق من Tag
    متغير tag = sad_ll_mem_read8(csw_buf + 4) + 0
    tag = tag + (sad_ll_mem_read8(csw_buf + 5) * 256)
    tag = tag + (sad_ll_mem_read8(csw_buf + 6) * 65536)
    tag = tag + (sad_ll_mem_read8(csw_buf + 7) * 16777216)

    إذا (tag != expected_tag)
        msc_serial_اطبع("[MSC] CSW tag mismatch!")
        msc_serial_سطر()
        ارجع 0 - 2
    نهاية

    # الحصول على الحالة
    متغير status = sad_ll_mem_read8(csw_buf + 12) + 0
    ارجع status + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# عملية نقل Bulk-Only (BOT)
# ═══════════════════════════════════════════════════════════════════════════════
# CBW → Data Phase (optional) → CSW

صدّر دالة msc_bot_transfer(dev_idx، scsi_cmd، cmd_len، data_buf، data_len، direction)
    إذا (dev_idx < 0) ارجع 0 - 1 نهاية
    إذا (dev_idx >= MSC_MAX_DEVICES) ارجع 0 - 1 نهاية
    إذا (msc_get_active(dev_idx) == 0) ارجع 0 - 1 نهاية

    متغير hc = msc_get_hc(dev_idx) + 0
    متغير addr = msc_get_addr(dev_idx) + 0

    # 1. بناء CBW
    متغير tag = msc_tag_counter + 0
    msc_tag_counter = msc_tag_counter + 1

    msc_build_cbw(msc_cbw_buf، tag، data_len، direction، 0، cmd_len)

    # نسخ أمر SCSI إلى CBW[15..30]
    متغير ci = 0 + 0
    بينما (ci < cmd_len)
        متغير cmd_byte = sad_ll_mem_read8(scsi_cmd + ci) + 0
        sad_ll_mem_write8(msc_cbw_buf + 15 + ci، cmd_byte)
        ci = ci + 1
    نهاية

    # 2. إرسال CBW عبر Bulk OUT
    متغير send_result = uhci_bulk_transfer(hc، addr، BULK_EP_OUT، msc_cbw_buf، CBW_SIZE) + 0
    إذا (send_result < 0)
        msc_serial_اطبع("[MSC] CBW send failed")
        msc_serial_سطر()
        msc_errors = msc_errors + 1
        ارجع 0 - 3
    نهاية

    # 3. مرحلة البيانات (إن وجدت)
    إذا (data_len > 0)
        إذا (direction == DIR_IN)
            # قراءة بيانات عبر Bulk IN
            متغير read_result = uhci_bulk_transfer(hc، addr، BULK_EP_IN، data_buf، data_len) + 0
            إذا (read_result < 0)
                msc_serial_اطبع("[MSC] Data IN failed")
                msc_serial_سطر()
                msc_errors = msc_errors + 1
                ارجع 0 - 4
            نهاية
        والا
            # كتابة بيانات عبر Bulk OUT
            متغير write_result = uhci_bulk_transfer(hc، addr، BULK_EP_OUT، data_buf، data_len) + 0
            إذا (write_result < 0)
                msc_serial_اطبع("[MSC] Data OUT failed")
                msc_serial_سطر()
                msc_errors = msc_errors + 1
                ارجع 0 - 5
            نهاية
        نهاية
    نهاية

    # 4. استقبال CSW عبر Bulk IN
    sad_ll_memset(msc_csw_buf، 0، CSW_SIZE)
    متغير csw_result = uhci_bulk_transfer(hc، addr، BULK_EP_IN، msc_csw_buf، CSW_SIZE) + 0
    إذا (csw_result < 0)
        msc_serial_اطبع("[MSC] CSW receive failed")
        msc_serial_سطر()
        msc_errors = msc_errors + 1
        ارجع 0 - 6
    نهاية

    # 5. تحليل CSW
    متغير csw_status = msc_parse_csw(msc_csw_buf، tag) + 0
    ارجع csw_status + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# أوامر SCSI
# ═══════════════════════════════════════════════════════════════════════════════

# ─── TEST UNIT READY ───
صدّر دالة msc_test_unit_ready(dev_idx)
    sad_ll_memset(msc_data_buf، 0، 6)
    sad_ll_mem_write8(msc_data_buf، SCSI_TEST_UNIT_READY)  # opcode 0x00
    # bytes 1-5: zeros

    متغير result = msc_bot_transfer(dev_idx، msc_data_buf، 6، 0، 0، DIR_OUT) + 0
    ارجع result + 0
نهاية

# ─── INQUIRY ───
صدّر دالة msc_inquiry(dev_idx، resp_buf)
    sad_ll_memset(msc_data_buf، 0، 16)
    sad_ll_mem_write8(msc_data_buf، SCSI_INQUIRY)     # 0x12
    sad_ll_mem_write8(msc_data_buf + 4، 36)           # allocation length = 36

    متغير result = msc_bot_transfer(dev_idx، msc_data_buf، 6، resp_buf، 36، DIR_IN) + 0
    إذا (result == CSW_STATUS_PASSED)
        # استخراج نوع الجهاز
        متغير dev_type = sad_ll_mem_read8(resp_buf) % 32  # bits 0-4
        msc_set_type(dev_idx، dev_type)
    نهاية
    ارجع result + 0
نهاية

# ─── READ CAPACITY (10) ───
صدّر دالة msc_read_capacity(dev_idx)
    sad_ll_memset(msc_data_buf، 0، 16)
    sad_ll_mem_write8(msc_data_buf، SCSI_READ_CAPACITY)  # 0x25

    متغير resp = sad_ll_kmalloc(8) + 0
    sad_ll_memset(resp، 0، 8)

    متغير result = msc_bot_transfer(dev_idx، msc_data_buf، 10، resp، 8، DIR_IN) + 0
    إذا (result == CSW_STATUS_PASSED)
        # Last LBA (big-endian 32-bit)
        متغير last_lba = sad_ll_mem_read8(resp) * 16777216
        last_lba = last_lba + (sad_ll_mem_read8(resp + 1) * 65536)
        last_lba = last_lba + (sad_ll_mem_read8(resp + 2) * 256)
        last_lba = last_lba + sad_ll_mem_read8(resp + 3)

        # Block Size (big-endian 32-bit)
        متغير block_size = sad_ll_mem_read8(resp + 4) * 16777216
        block_size = block_size + (sad_ll_mem_read8(resp + 5) * 65536)
        block_size = block_size + (sad_ll_mem_read8(resp + 6) * 256)
        block_size = block_size + sad_ll_mem_read8(resp + 7)

        msc_set_sectors(dev_idx، last_lba + 1)
        msc_set_sector_size(dev_idx، block_size)

        msc_serial_اطبع("[MSC] Capacity: LBA=")
        msc_serial_رقم(last_lba + 1)
        msc_serial_اطبع(" Block=")
        msc_serial_رقم(block_size + 0)
        msc_serial_سطر()
    نهاية
    ارجع result + 0
نهاية

# ─── REQUEST SENSE ───
صدّر دالة msc_request_sense(dev_idx، sense_buf)
    sad_ll_memset(msc_data_buf، 0، 16)
    sad_ll_mem_write8(msc_data_buf، SCSI_REQUEST_SENSE)  # 0x03
    sad_ll_mem_write8(msc_data_buf + 4، 18)              # allocation length = 18

    متغير result = msc_bot_transfer(dev_idx، msc_data_buf، 6، sense_buf، 18، DIR_IN) + 0
    ارجع result + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# READ (10) — قراءة قطاعات
# ═══════════════════════════════════════════════════════════════════════════════
# SCSI READ(10) CDB:
# Byte 0: 0x28
# Byte 1: reserved
# Byte 2-5: Logical Block Address (big-endian)
# Byte 6: reserved
# Byte 7-8: Transfer Length (sectors, big-endian)
# Byte 9: control

صدّر دالة msc_read_sectors(dev_idx، lba، count، dest_buf)
    إذا (dev_idx < 0) ارجع 0 - 1 نهاية
    إذا (msc_get_active(dev_idx) == 0) ارجع 0 - 1 نهاية

    متغير sec_size = msc_get_sector_size(dev_idx) + 0
    متغير xfer_len = count * sec_size

    # بناء CDB
    sad_ll_memset(msc_data_buf، 0، 16)
    sad_ll_mem_write8(msc_data_buf، SCSI_READ_10)  # 0x28

    # LBA (big-endian)
    sad_ll_mem_write8(msc_data_buf + 2، (lba / 16777216) % 256)
    sad_ll_mem_write8(msc_data_buf + 3، (lba / 65536) % 256)
    sad_ll_mem_write8(msc_data_buf + 4، (lba / 256) % 256)
    sad_ll_mem_write8(msc_data_buf + 5، lba % 256)

    # Transfer Length (big-endian)
    sad_ll_mem_write8(msc_data_buf + 7، (count / 256) % 256)
    sad_ll_mem_write8(msc_data_buf + 8، count % 256)

    متغير result = msc_bot_transfer(dev_idx، msc_data_buf، 10، dest_buf، xfer_len، DIR_IN) + 0
    إذا (result == CSW_STATUS_PASSED)
        msc_reads = msc_reads + count
    والا
        msc_errors = msc_errors + 1
    نهاية
    ارجع result + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# WRITE (10) — كتابة قطاعات
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة msc_write_sectors(dev_idx، lba، count، src_buf)
    إذا (dev_idx < 0) ارجع 0 - 1 نهاية
    إذا (msc_get_active(dev_idx) == 0) ارجع 0 - 1 نهاية

    متغير sec_size = msc_get_sector_size(dev_idx) + 0
    متغير xfer_len = count * sec_size

    # بناء CDB
    sad_ll_memset(msc_data_buf، 0، 16)
    sad_ll_mem_write8(msc_data_buf، SCSI_WRITE_10)  # 0x2A

    # LBA (big-endian)
    sad_ll_mem_write8(msc_data_buf + 2، (lba / 16777216) % 256)
    sad_ll_mem_write8(msc_data_buf + 3، (lba / 65536) % 256)
    sad_ll_mem_write8(msc_data_buf + 4، (lba / 256) % 256)
    sad_ll_mem_write8(msc_data_buf + 5، lba % 256)

    # Transfer Length (big-endian)
    sad_ll_mem_write8(msc_data_buf + 7، (count / 256) % 256)
    sad_ll_mem_write8(msc_data_buf + 8، count % 256)

    متغير result = msc_bot_transfer(dev_idx، msc_data_buf، 10، src_buf، xfer_len، DIR_OUT) + 0
    إذا (result == CSW_STATUS_PASSED)
        msc_writes = msc_writes + count
    والا
        msc_errors = msc_errors + 1
    نهاية
    ارجع result + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# واجهة القراءة/الكتابة العامة (قطاع واحد)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة msc_read_sector(dev_idx، lba، dest_buf)
    ارجع msc_read_sectors(dev_idx، lba، 1، dest_buf) + 0
نهاية

صدّر دالة msc_write_sector(dev_idx، lba، src_buf)
    ارجع msc_write_sectors(dev_idx، lba، 1، src_buf) + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# قراءة MBR — Master Boot Record
# ═══════════════════════════════════════════════════════════════════════════════
# MBR at LBA 0, partition table at offset 446 (0x1BE)
# Each entry: 16 bytes × 4 entries
# Bytes 0: boot indicator (0x80=bootable)
# Bytes 4: partition type
# Bytes 8-11: start LBA (little-endian)
# Bytes 12-15: size in sectors (little-endian)

# مصفوفة الأقسام: 4 أقسام × 4 حقول (type, start_lba, size_sectors, bootable)
متغير part_type_0 = 0
متغير part_type_1 = 0
متغير part_type_2 = 0
متغير part_type_3 = 0

متغير part_start_0 = 0
متغير part_start_1 = 0
متغير part_start_2 = 0
متغير part_start_3 = 0

متغير part_size_0 = 0
متغير part_size_1 = 0
متغير part_size_2 = 0
متغير part_size_3 = 0

متغير part_boot_0 = 0
متغير part_boot_1 = 0
متغير part_boot_2 = 0
متغير part_boot_3 = 0

متغير part_count = 0

صدّر دالة msc_read_mbr(dev_idx)
    متغير mbr_buf = sad_ll_kmalloc(512) + 0
    sad_ll_memset(mbr_buf، 0، 512)

    متغير result = msc_read_sector(dev_idx، 0، mbr_buf) + 0
    إذا (result != CSW_STATUS_PASSED)
        msc_serial_اطبع("[MSC] Failed to read MBR")
        msc_serial_سطر()
        ارجع 0 - 1
    نهاية

    # التحقق من توقيع MBR (0xAA55 at offset 510)
    متغير sig_lo = sad_ll_mem_read8(mbr_buf + 510) + 0
    متغير sig_hi = sad_ll_mem_read8(mbr_buf + 511) + 0
    إذا (sig_lo != 85)   # 0x55
        msc_serial_اطبع("[MSC] Invalid MBR signature")
        msc_serial_سطر()
        ارجع 0 - 2
    نهاية
    إذا (sig_hi != 170)  # 0xAA
        msc_serial_اطبع("[MSC] Invalid MBR signature")
        msc_serial_سطر()
        ارجع 0 - 2
    نهاية

    msc_serial_اطبع("[MSC] MBR valid, reading partitions...")
    msc_serial_سطر()

    part_count = 0

    # تحليل 4 إدخالات الأقسام
    متغير p = 0 + 0
    بينما (p < 4)
        متغير base = mbr_buf + 446 + (p * 16)

        متغير boot_flag = sad_ll_mem_read8(base) + 0
        متغير ptype = sad_ll_mem_read8(base + 4) + 0

        # Start LBA (little-endian)
        متغير start_lba = sad_ll_mem_read8(base + 8) + 0
        start_lba = start_lba + (sad_ll_mem_read8(base + 9) * 256)
        start_lba = start_lba + (sad_ll_mem_read8(base + 10) * 65536)
        start_lba = start_lba + (sad_ll_mem_read8(base + 11) * 16777216)

        # Size (little-endian)
        متغير psize = sad_ll_mem_read8(base + 12) + 0
        psize = psize + (sad_ll_mem_read8(base + 13) * 256)
        psize = psize + (sad_ll_mem_read8(base + 14) * 65536)
        psize = psize + (sad_ll_mem_read8(base + 15) * 16777216)

        متغير bootable = 0 + 0
        إذا (boot_flag == 128) bootable = 1 نهاية  # 0x80

        # تخزين
        إذا (p == 0)
            part_type_0 = ptype + 0
            part_start_0 = start_lba + 0
            part_size_0 = psize + 0
            part_boot_0 = bootable + 0
        نهاية
        إذا (p == 1)
            part_type_1 = ptype + 0
            part_start_1 = start_lba + 0
            part_size_1 = psize + 0
            part_boot_1 = bootable + 0
        نهاية
        إذا (p == 2)
            part_type_2 = ptype + 0
            part_start_2 = start_lba + 0
            part_size_2 = psize + 0
            part_boot_2 = bootable + 0
        نهاية
        إذا (p == 3)
            part_type_3 = ptype + 0
            part_start_3 = start_lba + 0
            part_size_3 = psize + 0
            part_boot_3 = bootable + 0
        نهاية

        إذا (ptype != 0)
            part_count = part_count + 1
            msc_serial_اطبع("  Part ")
            msc_serial_رقم(p + 0)
            msc_serial_اطبع(": type=0x")
            msc_serial_hex8(ptype + 0)
            msc_serial_اطبع(" start=")
            msc_serial_رقم(start_lba + 0)
            msc_serial_اطبع(" size=")
            msc_serial_رقم(psize + 0)
            إذا (bootable == 1)
                msc_serial_اطبع(" [BOOT]")
            نهاية
            msc_serial_سطر()
        نهاية

        p = p + 1
    نهاية

    msc_serial_اطبع("[MSC] Partitions found: ")
    msc_serial_رقم(part_count + 0)
    msc_serial_سطر()

    ارجع part_count + 0
نهاية

