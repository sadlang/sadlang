دالة msc_serial_اطبع(رسالة)
    متغير i = 0 + 0
    بينما (i < 80)
        متغير ch = sad_ll_mem_read8(رسالة + i) + 0
        إذا (ch == 0) ارجع 0 نهاية
        sad_ll_serial_write_char(COM1، ch)
        i = i + 1
    نهاية
    ارجع 0
نهاية

دالة msc_serial_رقم(ن)
    متغير val = ن + 0
    إذا (val < 0)
        sad_ll_serial_write_char(COM1، 45)
        val = 0 - val
    نهاية
    إذا (val >= 10000)
        متغير d5 = val / 10000
        sad_ll_serial_write_char(COM1، 48 + d5)
        val = val - (d5 * 10000)
    نهاية
    إذا (val >= 1000)
        متغير d4 = val / 1000
        sad_ll_serial_write_char(COM1، 48 + d4)
        val = val - (d4 * 1000)
    والا_اذا (ن >= 10000)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    إذا (val >= 100)
        متغير d3 = val / 100
        sad_ll_serial_write_char(COM1، 48 + d3)
        val = val - (d3 * 100)
    والا_اذا (ن >= 1000)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    إذا (val >= 10)
        متغير d2 = val / 10
        sad_ll_serial_write_char(COM1، 48 + d2)
        val = val - (d2 * 10)
    والا_اذا (ن >= 100)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    sad_ll_serial_write_char(COM1، 48 + val)
    ارجع 0
نهاية

دالة msc_serial_hex8(val)
    متغير hi = val / 16
    متغير lo = val % 16
    إذا (hi < 10) sad_ll_serial_write_char(COM1، 48 + hi)
    والا sad_ll_serial_write_char(COM1، 55 + hi) نهاية
    إذا (lo < 10) sad_ll_serial_write_char(COM1، 48 + lo)
    والا sad_ll_serial_write_char(COM1، 55 + lo) نهاية
    ارجع 0
نهاية

دالة msc_serial_hex32(val)
    msc_serial_hex8(val / 16777216)       # byte 3
    msc_serial_hex8((val / 65536) % 256)  # byte 2
    msc_serial_hex8((val / 256) % 256)    # byte 1
    msc_serial_hex8(val % 256)            # byte 0
    ارجع 0
نهاية

دالة msc_serial_سطر()
    sad_ll_serial_write_char(COM1، 13)
    sad_ll_serial_write_char(COM1، 10)
    ارجع 0
نهاية

