# ═══════════════════════════════════════════════════════════════════════════════
# تسجيل جهاز تخزين
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة msc_register_device(hc_idx، dev_addr)
    إذا (msc_count >= MSC_MAX_DEVICES)
        msc_serial_اطبع("[MSC] Max devices reached")
        msc_serial_سطر()
        ارجع 0 - 1
    نهاية

    متغير idx = msc_count + 0
    msc_set_active(idx، 1)
    msc_set_hc(idx، hc_idx)
    msc_set_addr(idx، dev_addr)

    msc_serial_اطبع("[MSC] Registered storage device #")
    msc_serial_رقم(idx + 0)
    msc_serial_اطبع(" addr=")
    msc_serial_رقم(dev_addr + 0)
    msc_serial_سطر()

    # TEST UNIT READY مع إعادة المحاولة
    متغير tries = 0 + 0
    متغير ready = 0 + 0
    بينما (tries < MAX_RETRIES)
        متغير tur = msc_test_unit_ready(idx) + 0
        إذا (tur == CSW_STATUS_PASSED)
            ready = 1
            اخرج
        نهاية
        tries = tries + 1
    نهاية

    إذا (ready == 0)
        msc_serial_اطبع("[MSC] Device not ready after retries")
        msc_serial_سطر()
    نهاية

    # INQUIRY
    متغير inq_buf = sad_ll_kmalloc(36) + 0
    sad_ll_memset(inq_buf، 0، 36)
    msc_inquiry(idx، inq_buf)

    msc_serial_اطبع("[MSC] Device type: ")
    msc_serial_رقم(msc_get_type(idx) + 0)
    msc_serial_سطر()

    # READ CAPACITY
    msc_read_capacity(idx)

    msc_count = msc_count + 1
    ارجع idx + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تقرير التخزين
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة msc_تقرير()
    msc_serial_اطبع("═══ [MSC] تقرير التخزين ═══")
    msc_serial_سطر()

    msc_serial_اطبع("  أجهزة تخزين: ")
    msc_serial_رقم(msc_count + 0)
    msc_serial_سطر()

    متغير d = 0 + 0
    بينما (d < msc_count)
        إذا (msc_get_active(d) == 1)
            msc_serial_اطبع("  [")
            msc_serial_رقم(d + 0)
            msc_serial_اطبع("] addr=")
            msc_serial_رقم(msc_get_addr(d) + 0)
            msc_serial_اطبع(" type=")
            msc_serial_رقم(msc_get_type(d) + 0)
            msc_serial_اطبع(" sectors=")
            msc_serial_رقم(msc_get_sectors(d) + 0)
            msc_serial_اطبع(" sec_size=")
            msc_serial_رقم(msc_get_sector_size(d) + 0)
            msc_serial_سطر()
        نهاية
        d = d + 1
    نهاية

    msc_serial_اطبع("  قراءات: ")
    msc_serial_رقم(msc_reads + 0)
    msc_serial_اطبع(" كتابات: ")
    msc_serial_رقم(msc_writes + 0)
    msc_serial_اطبع(" أخطاء: ")
    msc_serial_رقم(msc_errors + 0)
    msc_serial_سطر()

    إذا (part_count > 0)
        msc_serial_اطبع("  أقسام: ")
        msc_serial_رقم(part_count + 0)
        msc_serial_سطر()
    نهاية

    msc_serial_اطبع("═══════════════════════════════════")
    msc_serial_سطر()
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تهيئة التخزين
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة msc_هيئ()
    msc_serial_اطبع("[MSC] تهيئة تعريفات التخزين USB...")
    msc_serial_سطر()

    # تخصيص المخازن
    msc_cbw_buf = sad_ll_kmalloc(64) + 0
    msc_csw_buf = sad_ll_kmalloc(16) + 0
    msc_data_buf = sad_ll_kmalloc(1024) + 0

    sad_ll_memset(msc_cbw_buf، 0، 64)
    sad_ll_memset(msc_csw_buf، 0، 16)
    sad_ll_memset(msc_data_buf، 0، 1024)

    msc_count = 0
    msc_tag_counter = 1
    msc_reads = 0
    msc_writes = 0
    msc_errors = 0
    part_count = 0

    # البحث عن أجهزة تخزين USB
    متغير storage_idx = usb_find_storage() + 0
    إذا (storage_idx >= 0)
        msc_serial_اطبع("[MSC] Found storage device at USB idx ")
        msc_serial_رقم(storage_idx + 0)
