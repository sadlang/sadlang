# القسم 2: إنشاء وحل الروابط
# ══════════════════════════════════════════════

صدّر دالة رابط_أنشئ(مصدر، هدف، نظام)
    متغير ع = 0
    بينما (ع < 8)
        متغير فعال = اقرأ_رابط(ع، 3)
        إذا (فعال == 0)
            اكتب_رابط(ع، 0، مصدر)
            اكتب_رابط(ع، 1، هدف)
            اكتب_رابط(ع، 2، نظام)
            اكتب_رابط(ع، 3، 1)
            عدد_روابط = عدد_روابط + 1
            ارجع ع
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية

#* ── حل رابط: أرجع الهدف النهائي ── *#
صدّر دالة رابط_حل(عقدة)
    متغير الحالي = عقدة
    متغير عمق = 0
    
    بينما (عمق < اقصى_عمق_حل)
        متغير وجد = 0
        متغير ع = 0
        بينما (ع < 8)
            متغير فعال = اقرأ_رابط(ع، 3)
            إذا (فعال == 1)
                متغير مصدر = اقرأ_رابط(ع، 0)
                إذا (مصدر == الحالي)
                    الحالي = اقرأ_رابط(ع، 1)
                    وجد = 1
                    عمليات_حل = عمليات_حل + 1
                    اخرج
                نهاية
            نهاية
            ع = ع + 1
        نهاية
        إذا (وجد == 0) اخرج نهاية
        عمق = عمق + 1
    نهاية
    
    ارجع الحالي
نهاية

صدّر دالة رابط_احذف(فهرس)
    إذا (فهرس < 0) ارجع -1 نهاية
    إذا (فهرس >= 8) ارجع -1 نهاية
    اكتب_رابط(فهرس، 3، 0)
    عدد_روابط = عدد_روابط - 1
    ارجع 0
