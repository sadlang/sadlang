        kernel_print_string("[NUMA] عنوان لا ينتمي لأي عقدة: ")
        serial_put_hex(عنوان_صفحة)
        kernel_print_string("\n")
        ارجع -1
    نهاية

    # تحديث الإحصائيات
    متغير حرة = قراءة_حقل(عنوان_عقدة_حرة، عقدة)
    متغير مستخدمة = قراءة_حقل(عنوان_عقدة_مستخدمة، عقدة)

    كتابة_حقل(عنوان_عقدة_حرة، عقدة، حرة + 1)
    إذا (مستخدمة > 0)
        كتابة_حقل(عنوان_عقدة_مستخدمة، عقدة، مستخدمة - 1)
    نهاية

    ارجع 0
