# ═══════════════════════════════════════════════════════════════════════════════
# ترحيل صفحة بين عقدتين
# ═══════════════════════════════════════════════════════════════════════════════

#** ترحيل صفحة من عقدة إلى أخرى
#   مصدر_عقدة: العقدة المصدر
#   وجهة_عقدة: العقدة الوجهة
#   يُستخدم لتحسين الأداء بنقل الذاكرة قرب المعالج
#   تُرجع عنوان الصفحة الجديدة أو 0
**#
صدّر دالة ترحيل_صفحة(مصدر_عقدة، وجهة_عقدة)
    إذا (تم_التهيئة == 0)
        ارجع 0
    نهاية

    إذا (مصدر_عقدة >= عدد_عقد_نشطة)
        ارجع 0
    نهاية
    إذا (وجهة_عقدة >= عدد_عقد_نشطة)
        ارجع 0
    نهاية
    إذا (مصدر_عقدة == وجهة_عقدة)
        ارجع 0
    نهاية

    # فحص: هل العقدة المصدر بها صفحات مستخدمة؟
    متغير مستخدمة_مصدر = قراءة_حقل(عنوان_عقدة_مستخدمة، مصدر_عقدة)
    إذا (مستخدمة_مصدر == 0)
        kernel_print_string("[NUMA] لا صفحات لترحيلها من العقدة ")
        kernel_print_number(مصدر_عقدة)
        kernel_print_string("\n")
        عداد_ترحيل_فاشل = عداد_ترحيل_فاشل + 1
        ارجع 0
    نهاية

    # فحص: هل العقدة الوجهة بها مساحة؟
    متغير حرة_وجهة = قراءة_حقل(عنوان_عقدة_حرة، وجهة_عقدة)
    إذا (حرة_وجهة == 0)
        kernel_print_string("[NUMA] لا مساحة في العقدة ")
        kernel_print_number(وجهة_عقدة)
        kernel_print_string("\n")
        عداد_ترحيل_فاشل = عداد_ترحيل_فاشل + 1
        ارجع 0
    نهاية

    # تنفيذ الترحيل
    # نقص من المصدر
    كتابة_حقل(عنوان_عقدة_مستخدمة، مصدر_عقدة، مستخدمة_مصدر - 1)
    متغير حرة_مصدر = قراءة_حقل(عنوان_عقدة_حرة، مصدر_عقدة)
    كتابة_حقل(عنوان_عقدة_حرة، مصدر_عقدة، حرة_مصدر + 1)

    # زيادة في الوجهة
    كتابة_حقل(عنوان_عقدة_حرة، وجهة_عقدة، حرة_وجهة - 1)
    متغير مستخدمة_وجهة = قراءة_حقل(عنوان_عقدة_مستخدمة، وجهة_عقدة)
    كتابة_حقل(عنوان_عقدة_مستخدمة، وجهة_عقدة، مستخدمة_وجهة + 1)

    # تسجيل الترحيل
    إذا (عدد_ترحيلات < ثابت_اقصى_ترحيلات)
        كتابة_حقل(عنوان_ترحيل_مصدر، عدد_ترحيلات، مصدر_عقدة)
        كتابة_حقل(عنوان_ترحيل_وجهة، عدد_ترحيلات، وجهة_عقدة)
        كتابة_حقل(عنوان_ترحيل_وضعية، عدد_ترحيلات، 2)
