# ═══════════════════════════════════════════════════════════════════════════════
# تهيئة مصفوفة المسافات
# ═══════════════════════════════════════════════════════════════════════════════

#** تهيئة مصفوفة المسافات بطوبولوجيا افتراضية
#   الطوبولوجيا: 4 عقد في شكل مربع
#   العقدة 0 — العقدة 1 (مسافة 20)
#   |                    |
#   العقدة 2 — العقدة 3 (مسافة 20)
#   قطري: مسافة 30
**#
دالة تهيئة_مصفوفة_مسافات()
    kernel_print_string("[NUMA] تهيئة مصفوفة المسافات...\n")

    # تهيئة كل المسافات بقيمة بعيدة
    متغير م = 0
    بينما (م < ثابت_اقصى_عقد)
        متغير ن = 0
        بينما (ن < ثابت_اقصى_عقد)
            إذا (م == ن)
                # مسافة محلية
                كتابة_مسافة(م، ن، ثابت_مسافة_محلية)
            وإلا
                # مسافة بعيدة افتراضياً
                كتابة_مسافة(م، ن، ثابت_مسافة_بعيدة)
            نهاية
            ن = ن + 1
        نهاية
        م = م + 1
    نهاية

    # ضبط المسافات للطوبولوجيا المربعة (4 عقد)
    # عقدة 0 ↔ عقدة 1: قريبة (حافة أفقية علوية)
    كتابة_مسافة(0، 1، ثابت_مسافة_قريبة)
    كتابة_مسافة(1، 0، ثابت_مسافة_قريبة)

    # عقدة 0 ↔ عقدة 2: قريبة (حافة عمودية يسرى)
    كتابة_مسافة(0، 2، ثابت_مسافة_قريبة)
    كتابة_مسافة(2، 0، ثابت_مسافة_قريبة)

    # عقدة 1 ↔ عقدة 3: قريبة (حافة عمودية يمنى)
    كتابة_مسافة(1، 3، ثابت_مسافة_قريبة)
    كتابة_مسافة(3، 1، ثابت_مسافة_قريبة)

    # عقدة 2 ↔ عقدة 3: قريبة (حافة أفقية سفلية)
    كتابة_مسافة(2، 3، ثابت_مسافة_قريبة)
    كتابة_مسافة(3، 2، ثابت_مسافة_قريبة)

    # عقدة 0 ↔ عقدة 3: متوسطة (قطر)
    كتابة_مسافة(0، 3، ثابت_مسافة_متوسطة)
    كتابة_مسافة(3، 0، ثابت_مسافة_متوسطة)

    # عقدة 1 ↔ عقدة 2: متوسطة (قطر آخر)
    كتابة_مسافة(1، 2، ثابت_مسافة_متوسطة)
    كتابة_مسافة(2، 1، ثابت_مسافة_متوسطة)

    kernel_print_string("  طوبولوجيا مربعة (4 عقد):\n")
    kernel_print_string("    [0]--20--[1]\n")
    kernel_print_string("     |  \\30/ |  \n")
    kernel_print_string("    20   X  20  \n")
    kernel_print_string("     | /30\\  |  \n")
    kernel_print_string("    [2]--20--[3]\n")

    ارجع 0
نهاية

