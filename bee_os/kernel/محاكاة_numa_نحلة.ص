# تخصيص محلي — من العقدة المحلية
# ═══════════════════════════════════════════════════════════════════════════════

#** تخصيص صفحة من العقدة المحلية
#   عقدة_محلية: فهرس العقدة المحلية
#   تُرجع عنوان الصفحة المخصصة أو 0
**#
صدّر دالة تخصيص_محلي(عقدة_محلية)
    إذا (تم_التهيئة == 0)
        ارجع 0
    نهاية

    إذا (عقدة_محلية >= عدد_عقد_نشطة)
        ارجع 0
    نهاية

    إجمالي_تخصيصات = إجمالي_تخصيصات + 1

    # فحص: هل العقدة المحلية بها صفحات حرة؟
    متغير حرة = قراءة_حقل(عنوان_عقدة_حرة، عقدة_محلية)

    إذا (حرة > 0)
        # تخصيص محلي ناجح
        كتابة_حقل(عنوان_عقدة_حرة، عقدة_محلية، حرة - 1)
        متغير مستخدمة = قراءة_حقل(عنوان_عقدة_مستخدمة، عقدة_محلية)
        كتابة_حقل(عنوان_عقدة_مستخدمة، عقدة_محلية، مستخدمة + 1)

        # تسجيل وصول محلي
        متغير وصول_م = قراءة_حقل(عنوان_عقدة_وصول_محلي، عقدة_محلية)
        كتابة_حقل(عنوان_عقدة_وصول_محلي، عقدة_محلية، وصول_م + 1)
        عداد_تخصيص_محلي = عداد_تخصيص_محلي + 1

        # حساب عنوان الصفحة (محاكاة)
        متغير بداية = قراءة_حقل(عنوان_عقدة_بداية، عقدة_محلية)
        متغير عنوان_صفحة = بداية + (مستخدمة * ثابت_مقاس_صفحة)

        ارجع عنوان_صفحة
    نهاية

    # لا ذاكرة محلية — البحث في أقرب عقدة
    متغير عقدة_بديلة = أقرب_عقدة_حرة(عقدة_محلية، 1)
    إذا (عقدة_بديلة >= 0)
        # تخصيص بعيد
        عداد_تخصيص_بعيد = عداد_تخصيص_بعيد + 1

        متغير حرة_ب = قراءة_حقل(عنوان_عقدة_حرة، عقدة_بديلة)
        كتابة_حقل(عنوان_عقدة_حرة، عقدة_بديلة، حرة_ب - 1)
        متغير مستخدمة_ب = قراءة_حقل(عنوان_عقدة_مستخدمة، عقدة_بديلة)
        كتابة_حقل(عنوان_عقدة_مستخدمة، عقدة_بديلة، مستخدمة_ب + 1)

        # تسجيل وصول بعيد
        متغير وصول_ب = قراءة_حقل(عنوان_عقدة_وصول_بعيد، عقدة_بديلة)
        كتابة_حقل(عنوان_عقدة_وصول_بعيد، عقدة_بديلة، وصول_ب + 1)

        متغير بداية_ب = قراءة_حقل(عنوان_عقدة_بداية، عقدة_بديلة)
        متغير عنوان_صفحة = بداية_ب + (مستخدمة_ب * ثابت_مقاس_صفحة)

        ارجع عنوان_صفحة
    نهاية

    # لا ذاكرة في أي عقدة
    عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
    ارجع 0
