    كتابة_حقل(عنوان_تقارب_عقدة، عدد_تقارب، عقدة)
    كتابة_حقل(عنوان_تقارب_قناع، عدد_تقارب، قناع)
    كتابة_حقل(عنوان_تقارب_سياسة، عدد_تقارب، سياسة_عملية_جديدة)
    كتابة_حقل(عنوان_تقارب_تشابك، عدد_تقارب، 0)

