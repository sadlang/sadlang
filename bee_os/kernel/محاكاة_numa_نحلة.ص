#** تحرير صفحة وإعادتها لعقدتها
#   عنوان_صفحة: عنوان الصفحة المراد تحريرها
**#
صدّر دالة تحرير_صفحة_numa(عنوان_صفحة)
    إذا (تم_التهيئة == 0)
        ارجع -1
    نهاية

    # تحديد العقدة
    متغير عقدة = عقدة_لعنوان(عنوان_صفحة)
