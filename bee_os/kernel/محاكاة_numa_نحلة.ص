# تخصيص بالتشابك — توزيع دوري على العقد
# ═══════════════════════════════════════════════════════════════════════════════

#** تخصيص صفحة بسياسة التشابك (Interleave)
#   يوزع التخصيصات بالتناوب على العقد المسموحة
#   قناع_عقد_مسموح: قناع بتات العقد المسموحة
#   تُرجع عنوان الصفحة أو 0
**#
صدّر دالة تخصيص_تشابك(قناع_عقد_مسموح)
    إذا (تم_التهيئة == 0)
        ارجع 0
    نهاية

    إجمالي_تخصيصات = إجمالي_تخصيصات + 1
    عداد_تخصيص_تشابك_كلي = عداد_تخصيص_تشابك_كلي + 1

    # البحث عن العقدة التالية في الدورة
    متغير محاولات = 0
    بينما (محاولات < عدد_عقد_نشطة)
        متغير عقدة_حالية = عداد_تشابك_عام

        # تقدم العداد
        عداد_تشابك_عام = عداد_تشابك_عام + 1
        إذا (عداد_تشابك_عام >= عدد_عقد_نشطة)
            عداد_تشابك_عام = 0
        نهاية

        # فحص: هل العقدة مسموحة؟
        متغير بت_عقدة = 1
        متغير تحريك = 0
        بينما (تحريك < عقدة_حالية)
            بت_عقدة = بت_عقدة << 1
            تحريك = تحريك + 1
        نهاية

        متغير فحص_مسموح = قناع_عقد_مسموح & بت_عقدة
        إذا (فحص_مسموح != 0)
            # العقدة مسموحة — محاولة التخصيص
            متغير حرة = قراءة_حقل(عنوان_عقدة_حرة، عقدة_حالية)
            إذا (حرة > 0)
                كتابة_حقل(عنوان_عقدة_حرة، عقدة_حالية، حرة - 1)
                متغير مستخدمة = قراءة_حقل(عنوان_عقدة_مستخدمة، عقدة_حالية)
                كتابة_حقل(عنوان_عقدة_مستخدمة، عقدة_حالية، مستخدمة + 1)

                متغير بداية = قراءة_حقل(عنوان_عقدة_بداية، عقدة_حالية)
                ارجع بداية + (مستخدمة * ثابت_مقاس_صفحة)
            نهاية
        نهاية

        محاولات = محاولات + 1
    نهاية

    عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
    ارجع 0
