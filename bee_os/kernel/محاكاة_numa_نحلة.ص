    إذا (عنوان_مصفوفة_مسافات == 0)
        ارجع -1
    نهاية
    متغير فهرس = (عقدة_أ * ثابت_اقصى_عقد) + عقدة_ب
    كتابة_حقل(عنوان_مصفوفة_مسافات، فهرس، مسافة)
