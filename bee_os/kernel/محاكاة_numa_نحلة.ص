# ═══════════════════════════════════════════════════════════════════════════════
# تهيئة عقدة NUMA
# ═══════════════════════════════════════════════════════════════════════════════

#** تهيئة عقدة NUMA بمعلوماتها الأساسية
#   فهرس_عقده: فهرس العقدة (0-7)
#   بداية_ذاكرة: عنوان بداية ذاكرة العقدة
#   نهاية_ذاكرة: عنوان نهاية ذاكرة العقدة
#   قناع_معالجات_عقدة: قناع بتات المعالجات في هذه العقدة
**#
دالة تهيئة_عقدة(فهرس_عقده، بداية_ذاكرة، نهاية_ذاكرة، قناع_معالجات_عقدة)
    إذا (فهرس_عقده >= ثابت_اقصى_عقد)
        kernel_print_string("[NUMA] فهرس عقدة غير صالح!\n")
        ارجع -1
    نهاية

    متغير مقاس_ذاك = نهاية_ذاكرة - بداية_ذاكرة
    متغير صفحات = مقاس_ذاك / ثابت_مقاس_صفحة

    كتابة_حقل(عنوان_عقدة_معرف، فهرس_عقده، فهرس_عقده)
    كتابة_حقل(عنوان_عقدة_بداية، فهرس_عقده، بداية_ذاكرة)
    كتابة_حقل(عنوان_عقدة_نهاية، فهرس_عقده، نهاية_ذاكرة)
    كتابة_حقل(عنوان_عقدة_إجمالي، فهرس_عقده، صفحات)
    كتابة_حقل(عنوان_عقدة_حرة، فهرس_عقده، صفحات)
    كتابة_حقل(عنوان_عقدة_مستخدمة، فهرس_عقده، 0)
    كتابة_حقل(عنوان_عقدة_قناع_معالج، فهرس_عقده، قناع_معالجات_عقدة)
    كتابة_حقل(عنوان_عقدة_سياسة، فهرس_عقده، سياسة_محلية)
    كتابة_حقل(عنوان_عقدة_وصول_محلي، فهرس_عقده، 0)
    كتابة_حقل(عنوان_عقدة_وصول_بعيد، فهرس_عقده، 0)

    kernel_print_string("  عقدة ")
    kernel_print_number(فهرس_عقده)
    kernel_print_string(": ")
    serial_put_hex(بداية_ذاكرة)
    kernel_print_string(" - ")
    serial_put_hex(نهاية_ذاكرة)
    kernel_print_string(" (")
