# ضبط تقارب عملية
# ═══════════════════════════════════════════════════════════════════════════════

#** ربط عملية بعقدة NUMA مفضلة مع قناع عقد مسموحة
#   معرف_عملية_جديد: معرف العملية
#   عقدة: العقدة المفضلة
#   قناع: قناع العقد المسموحة
#   سياسة_عملية_جديدة: سياسة التخصيص
**#
صدّر دالة ضبط_تقارب(معرف_عملية_جديد، عقدة، قناع، سياسة_عملية_جديدة)
    إذا (تم_التهيئة == 0)
        ارجع -1
    نهاية

    # البحث عن العملية الموجودة
    متغير م = 0
    بينما (م < عدد_تقارب)
        متغير معرف = قراءة_حقل(عنوان_تقارب_عملية، م)
        إذا (معرف == معرف_عملية_جديد)
            # تحديث القيم
            كتابة_حقل(عنوان_تقارب_عقدة، م، عقدة)
            كتابة_حقل(عنوان_تقارب_قناع، م، قناع)
            كتابة_حقل(عنوان_تقارب_سياسة، م، سياسة_عملية_جديدة)

            kernel_print_string("[NUMA] تحديث تقارب: عملية=")
            kernel_print_number(معرف_عملية_جديد)
            kernel_print_string(" عقدة=")
            kernel_print_number(عقدة)
