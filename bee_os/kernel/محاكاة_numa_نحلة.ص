    kernel_print_string("\n─── مصفوفة مسافات NUMA ───\n")
    kernel_print_string("       ")

    # رأس الأعمدة
    متغير ع = 0
    بينما (ع < عدد_عقد_نشطة)
        kernel_print_string("  [")
        kernel_print_number(ع)
        kernel_print_string("] ")
        ع = ع + 1
    نهاية
    kernel_print_string("\n")

    # الصفوف
    متغير م = 0
    بينما (م < عدد_عقد_نشطة)
        kernel_print_string("  [")
        kernel_print_number(م)
        kernel_print_string("]  ")

        متغير ن = 0
        بينما (ن < عدد_عقد_نشطة)
            متغير مسافة = قراءة_مسافة(م، ن)
            kernel_print_string("  ")
            kernel_print_number(مسافة)
            kernel_print_string("  ")
            ن = ن + 1
        نهاية
        kernel_print_string("\n")

        م = م + 1
    نهاية
