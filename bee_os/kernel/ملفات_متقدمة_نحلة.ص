## تسجيل عملية في المعاملة الحالية
صدّر دالة سجّل_عملية(نوع_عملية, رقم_عقدة, كتلة, قبل, بعد)
    إذا (jrn_معاملة_حالية < 0)
        ارجع -1
    نهاية
    
    متغير فهرس_op = jrn_عداد_عمليات % أقصى_عمليات
    
    op_معاملة[فهرس_op] = jrn_معاملة_حالية + 0
    op_نوع[فهرس_op] = نوع_عملية + 0
    op_عقدة[فهرس_op] = رقم_عقدة + 0
    op_كتلة_هدف[فهرس_op] = كتلة + 0
    op_بيانات_قبل[فهرس_op] = قبل + 0
    op_بيانات_بعد[فهرس_op] = بعد + 0
    
    متغير معاملة_idx = jrn_معاملة_حالية + 0
    jrn_عدد_العمليات[معاملة_idx] = jrn_عدد_العمليات[معاملة_idx] + 1
    
    # حساب checksum بسيط
    متغير فحص_حالي = jrn_فحص[معاملة_idx] + 0
    فحص_حالي = فحص_حالي + نوع_عملية + رقم_عقدة + كتلة
    jrn_فحص[معاملة_idx] = فحص_حالي + 0
    
    jrn_عداد_عمليات = jrn_عداد_عمليات + 1
    
    ارجع فهرس_op + 0
نهاية

## إتمام المعاملة (commit)
صدّر دالة أتمم_معاملة()
    إذا (jrn_معاملة_حالية < 0)
        afs_اطبع("[JRN] لا توجد معاملة نشطة\n")
        ارجع -1
    نهاية
    
    متغير فهرس = jrn_معاملة_حالية + 0
    jrn_نوع_حالة[فهرس] = معاملة_مكتملة
    
    afs_اطبع("[JRN] إتمام معاملة #")
    afs_اطبع_رقم(jrn_معرف[فهرس] + 0)
    afs_اطبع(" — ")
    afs_اطبع_رقم(jrn_عدد_العمليات[فهرس] + 0)
    afs_اطبع(" عملية\n")
    
    # كتابة اليومية إلى القرص (WAL flush)
    إذا (jrn_عنوان_مخزن > 0)
        # كتابة رأس المعاملة
        afs_كتابة32(jrn_عنوان_مخزن + 0, JOURNAL_MAGIC)
        afs_كتابة32(jrn_عنوان_مخزن + 4, jrn_معرف[فهرس] + 0)
        afs_كتابة32(jrn_عنوان_مخزن + 8, jrn_عدد_العمليات[فهرس] + 0)
        afs_كتابة32(jrn_عنوان_مخزن + 12, jrn_فحص[فهرس] + 0)
        afs_كتابة32(jrn_عنوان_مخزن + 16, معاملة_مسجلة)
    نهاية
    
    jrn_نوع_حالة[فهرس] = معاملة_مسجلة
    jrn_معاملة_حالية = -1
    
    ارجع 0
نهاية

## إلغاء المعاملة الحالية (rollback)
صدّر دالة ألغِ_معاملة()
    إذا (jrn_معاملة_حالية < 0)
        ارجع -1
    نهاية
    
    متغير فهرس = jrn_معاملة_حالية + 0
    متغير عدد_ops = jrn_عدد_العمليات[فهرس] + 0
    
    afs_اطبع("[JRN] إلغاء معاملة #")
    afs_اطبع_رقم(jrn_معرف[فهرس] + 0)
    afs_اطبع(" — استعادة ")
    afs_اطبع_رقم(عدد_ops + 0)
    afs_اطبع(" عملية\n")
    
    # استعادة البيانات القديمة (undo)
    متغير ط = jrn_عداد_عمليات - 1
    بينما (ط >= 0)
        إذا (op_معاملة[ط] == فهرس)
            # إرجاع القيمة القديمة
            متغير عنوان_هدف = op_كتلة_هدف[ط] + 0
            إذا (عنوان_هدف > 0)
                afs_كتابة32(عنوان_هدف + 0, op_بيانات_قبل[ط] + 0)
            نهاية
            op_معاملة[ط] = -1
        نهاية
        ط = ط - 1
    نهاية
    
    jrn_نوع_حالة[فهرس] = معاملة_ملغاة
    jrn_معاملة_حالية = -1
    
    ارجع 0
نهاية

## إنشاء نقطة فحص (checkpoint)
