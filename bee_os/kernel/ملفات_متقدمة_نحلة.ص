    jrn_وقت[فهرس] = jrn_عداد_معاملات + 0
    jrn_نوع_حالة[فهرس] = معاملة_نشطة
    jrn_عدد_العمليات[فهرس] = 0
    jrn_كتلة_بداية[فهرس] = 0
    jrn_فحص[فهرس] = 0
    
    jrn_معاملة_حالية = فهرس + 0
    
    afs_اطبع("[JRN] بدء معاملة #")
    afs_اطبع_رقم(jrn_عداد_معاملات + 0)
