    afs_اطبع("[JRN] إنشاء نقطة فحص #")
    afs_اطبع_رقم(jrn_عدد_نقاط_فحص + 1)
    afs_اطبع("\n")
    
    # تفريغ كل المعاملات المكتملة
    متغير ط = 0
    متغير مسجلة = 0
    بينما (ط < أقصى_معاملات)
        إذا (jrn_نوع_حالة[ط] == معاملة_مسجلة)
            مسجلة = مسجلة + 1
        نهاية
        ط = ط + 1
    نهاية
    
    # تنظيف المعاملات المسجلة
    متغير ي = 0
    بينما (ي < أقصى_معاملات)
        إذا (jrn_نوع_حالة[ي] == معاملة_مسجلة)
            jrn_نوع_حالة[ي] = 0
            jrn_معرف[ي] = 0
            jrn_عدد_العمليات[ي] = 0
        نهاية
        ي = ي + 1
    نهاية
    
