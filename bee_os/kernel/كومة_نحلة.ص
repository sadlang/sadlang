    نهاية
    
    # خصّص كتلة جديدة
    متغير عنوان_جديد = kmalloc(حجم_جديد)
    إذا (عنوان_جديد == 0)
        ارجع 0  # فشل — أبقِ على الكتلة القديمة
    نهاية
    
    # انسخ البيانات القديمة
    انسخ_ذاكرة(عنوان_جديد، عنوان، الحجم_القديم)
    
    # حرر الكتلة القديمة
    kfree(عنوان)
    
    ارجع عنوان_جديد
