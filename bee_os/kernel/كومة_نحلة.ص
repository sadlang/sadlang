                # انتقل للـ slab التالي
                عنوان_slab = اقرأ_ذاكرة(عنوان_slab + 32)
                تابع
            نهاية
            
            # اقرأ عنوان الكائن التالي في القائمة الحرة
            متغير تالي_حر = اقرأ_ذاكرة(عنوان_حر)
            
            # حدّث رأس Slab
            اكتب_ذاكرة(عنوان_slab + 8، تالي_حر)  # أول حر = التالي
            اكتب_ذاكرة(عنوان_slab + 16، حرة_في_slab - 1)  # عدد الحرة - 1
            
            # تحديث الإحصائيات الإجمالية
            slab_حرة[فهرس_الحجم] = slab_حرة[فهرس_الحجم] - 1
            slab_تخصيصات[فهرس_الحجم] = slab_تخصيصات[فهرس_الحجم] + 1
            
            # صفّر الكائن المُخصص (أمان)
            املأ_ذاكرة(عنوان_حر، 0، slab_أحجام[فهرس_الحجم])
            
            ارجع عنوان_حر
        نهاية
        
        # لم يكن فيه مساحة — جرب الـ slab التالي
        عنوان_slab = اقرأ_ذاكرة(عنوان_slab + 32)
    نهاية
    
    # لم نجد slab فيه مساحة — أنشئ slab جديد
    متغير slab_جديد = أنشئ_slab(فهرس_الحجم)
    إذا (slab_جديد == 0)
        ارجع 0  # فشل التخصيص — لا توجد صفحات متاحة
    نهاية
    
    # أضف الـ slab الجديد لرأس السلسلة
    اكتب_ذاكرة(slab_جديد + 32، slab_أول_صفحة[فهرس_الحجم])
    slab_أول_صفحة[فهرس_الحجم] = slab_جديد
    
