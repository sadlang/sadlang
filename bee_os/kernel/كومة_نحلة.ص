        ارجع
    نهاية
    
    # اقرأ فهرس الحجم
    متغير فهرس = اقرأ_ذاكرة(عنوان_slab + 48)
    
    # اقرأ عنوان أول كائن حر حالياً
    متغير أول_حر_حالي = اقرأ_ذاكرة(عنوان_slab + 8)
    
    # اكتب عنوان أول حر الحالي في الكائن المُحرّر (ربط القائمة)
    اكتب_ذاكرة(عنوان_الكائن، أول_حر_حالي)
    
    # حدّث رأس Slab — الكائن المُحرّر يصبح أول حر
    اكتب_ذاكرة(عنوان_slab + 8، عنوان_الكائن)
    
    # حدّث عدد الحرة
    متغير حرة = اقرأ_ذاكرة(عنوان_slab + 16)
    اكتب_ذاكرة(عنوان_slab + 16، حرة + 1)
    
    # تحديث الإحصائيات الإجمالية
    إذا (فهرس >= 0)
        إذا (فهرس < عدد_أحجام_slab)
