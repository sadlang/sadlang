# القسم ٣: الثوابت والتعريفات
# ═══════════════════════════════════════════════════════════════════════════════

ثابت حجم_الصفحة = 4096
ثابت COM1 = 0x3F8

# ──────────────── أحجام Slab المدعومة ────────────────
# 9 أحجام: 8, 16, 32, 64, 128, 256, 512, 1024, 2048
ثابت عدد_أحجام_slab = 9

# فهارس أحجام Slab في المصفوفات
ثابت فهرس_slab_8    = 0
ثابت فهرس_slab_16   = 1
ثابت فهرس_slab_32   = 2
ثابت فهرس_slab_64   = 3
ثابت فهرس_slab_128  = 4
ثابت فهرس_slab_256  = 5
ثابت فهرس_slab_512  = 6
ثابت فهرس_slab_1024 = 7
ثابت فهرس_slab_2048 = 8

# ──────────────── هيكل رأس الكتلة (Block Header) ────────────────
# كل كتلة مُخصصة من kmalloc تسبقها رأس:
#   [الحجم: 8 بايت][القناع السحري: 8 بايت][البيانات...]
# الحجم = حجم البيانات (بدون الرأس)
# القناع السحري = 0xBEEBEEBEEBEEBEEB — للتحقق من صحة الكتلة
ثابت حجم_رأس_الكتلة = 16  # 8 + 8 بايتات
ثابت القناع_السحري = 0xBEEB  # BEE's magic number 🐝

# ──────────────── ثوابت Bump Allocator ────────────────
ثابت حجم_bump_الافتراضي = 65536  # 64KB = 16 صفحات

# ──────────────── ثوابت Slab ────────────────
# رأس كل Slab = 64 بايت من بداية الصفحة
ثابت حجم_رأس_slab = 64
# هيكل رأس Slab:
#   [0-7]   حجم_الكائن (8 بايت)
#   [8-15]  عنوان_أول_حر (أول كائن حر في القائمة)
#   [16-23] عدد_الحرة (عدد الكائنات الحرة)
#   [24-31] إجمالي_الكائنات
#   [32-39] عنوان_الصفحة_التالية (للربط بين slabs)
#   [40-47] القناع (للتحقق)
#   [48-55] فهرس_الحجم (أي مصفوفة slab ينتمي لها)
#   [56-63] محجوز

# ═══════════════════════════════════════════════════════════════════════════════
# القسم ٤: Bump Allocator — مُخصص بسيط وسريع
# ═══════════════════════════════════════════════════════════════════════════════
#
# Bump Allocator هو أسرع مُخصص ممكن — فقط يُزيح مؤشراً.
# يُستخدم في المرحلة المبكرة من الإقلاع قبل تهيئة Slab.
# لا يدعم التحرير الفردي — يُحرر الكل دفعة واحدة بإعادة المؤشر.

## ─────────── حالة Bump Allocator ───────────
# عنوان بداية منطقة Bump
متغير bump_قاعدة = 0

# المؤشر الحالي (يتحرك للأمام فقط)
متغير bump_حالي = 0

# عنوان نهاية منطقة Bump
متغير bump_نهاية = 0

# عدد التخصيصات منذ آخر إعادة تعيين
متغير bump_تخصيصات = 0

# إجمالي البايتات المُخصصة
متغير bump_بايتات_مخصصة = 0

# هل Bump Allocator مُهيّأ؟
متغير bump_مُهيّأ = 0

## ─────────────────────────────────────────────────────
## تهيئة Bump Allocator
## ─────────────────────────────────────────────────────
## المعامل: عنوان_البداية — عنوان بداية المنطقة
## المعامل: الحجم — حجم المنطقة بالبايتات
صدّر دالة هيئ_bump(عنوان_البداية، الحجم)
    bump_قاعدة = عنوان_البداية
    bump_حالي = عنوان_البداية
    bump_نهاية = عنوان_البداية + الحجم
    bump_تخصيصات = 0
    bump_بايتات_مخصصة = 0
    bump_مُهيّأ = 1
    
    # تصفير المنطقة
    املأ_ذاكرة(عنوان_البداية، 0، الحجم)
نهاية

## ─────────────────────────────────────────────────────
## تخصيص من Bump Allocator
## ─────────────────────────────────────────────────────
## المعامل: الحجم — عدد البايتات المطلوبة
## المعامل: محاذاة — محاذاة العنوان (8, 16, ...) — يجب أن يكون أُسّ 2
## يُعيد: عنوان الكتلة المُخصصة، أو 0 إذا لا توجد ذاكرة
صدّر دالة خصص_bump(الحجم، محاذاة)
    إذا (bump_مُهيّأ == 0)
        ارجع 0
    نهاية
    
    إذا (الحجم == 0)
        ارجع 0
    نهاية
    
    # المحاذاة: اجعل bump_حالي مُحاذياً
    # مُحاذاة = أقرب مضاعف للمحاذاة >= bump_حالي
    متغير باقي = bump_حالي % محاذاة
    إذا (باقي != 0)
        bump_حالي = bump_حالي + (محاذاة - باقي)
    نهاية
    
    # فحص هل يوجد مساحة كافية
    إذا (bump_حالي + الحجم > bump_نهاية)
        ارجع 0  # نفدت مساحة Bump!
    نهاية
    
    # احفظ العنوان الحالي — هذا هو العنوان المُعاد
    متغير عنوان = bump_حالي
    
    # أزح المؤشر للأمام
    bump_حالي = bump_حالي + الحجم
    
    # تحديث الإحصائيات
    bump_تخصيصات = bump_تخصيصات + 1
    bump_بايتات_مخصصة = bump_بايتات_مخصصة + الحجم
    
    ارجع عنوان
نهاية

## ─────────────────────────────────────────────────────
## إعادة تعيين Bump Allocator — تحرير كل شيء
## ─────────────────────────────────────────────────────
## تحذير: كل المؤشرات المُعادة سابقاً تصبح غير صالحة!
صدّر دالة أعد_bump()
    bump_حالي = bump_قاعدة
    bump_تخصيصات = 0
    bump_بايتات_مخصصة = 0
    
    # تصفير المنطقة (اختياري — لأمان أفضل)
    متغير حجم_كلي = bump_نهاية - bump_قاعدة
    املأ_ذاكرة(bump_قاعدة، 0، حجم_كلي)
نهاية

## الذاكرة المتبقية في Bump
صدّر دالة bump_متبقي()
    ارجع bump_نهاية - bump_حالي
نهاية

## نسبة الاستخدام (0-100)
صدّر دالة bump_نسبة_استخدام()
    متغير حجم_كلي = bump_نهاية - bump_قاعدة
    إذا (حجم_كلي == 0)
        ارجع 0
    نهاية
    ارجع (bump_بايتات_مخصصة * 100) / حجم_كلي
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# القسم ٥: Slab Allocator — تخصيص كائنات ثابتة الحجم
# ═══════════════════════════════════════════════════════════════════════════════
#
# الهيكل لكل حجم:
#   - سلسلة من الصفحات (Slabs)، كل صفحة مقسمة لكائنات بنفس الحجم
#   - داخل كل Slab: قائمة حرة مرتبطة (كل كائن حر يُشير للتالي)
#   - نحتفظ بعنوان أول Slab وعدد الكائنات الحرة

## ─────────── حالة كل حجم Slab ───────────
# عنوان أول Slab (رأس سلسلة الصفحات) لكل حجم
متغير slab_أول_صفحة = [0، 0، 0، 0، 0، 0، 0، 0، 0]

# عدد الكائنات الحرة المتاحة لكل حجم
متغير slab_حرة = [0، 0، 0، 0، 0، 0، 0، 0، 0]

# عدد الصفحات المُخصصة لكل حجم
متغير slab_صفحات = [0، 0، 0، 0، 0، 0، 0، 0، 0]

# عدد التخصيصات الناجحة لكل حجم
متغير slab_تخصيصات = [0، 0، 0، 0، 0، 0، 0، 0، 0]

# عدد التحريرات لكل حجم
متغير slab_تحريرات = [0، 0، 0، 0، 0، 0، 0، 0، 0]

# أحجام الكائنات المقابلة لكل فهرس
متغير slab_أحجام = [8، 16، 32، 64، 128، 256، 512، 1024، 2048]

# هل نظام Slab مُهيّأ؟
متغير slab_مُهيّأ = 0

## ─────────────────────────────────────────────────────
## حساب فهرس Slab المناسب لحجم معين
## ─────────────────────────────────────────────────────
## يُعيد فهرس أصغر Slab يمكنه استيعاب الحجم المطلوب
## مثلاً: حجم 12 → فهرس 1 (slab 16 بايت)
## يُعيد: -1 إذا الحجم أكبر من أكبر Slab
دالة فهرس_slab_لحجم(حجم_مطلوب)
    إذا (حجم_مطلوب <= 8)
        ارجع 0
    نهاية
    إذا (حجم_مطلوب <= 16)
        ارجع 1
    نهاية
    إذا (حجم_مطلوب <= 32)
        ارجع 2
    نهاية
    إذا (حجم_مطلوب <= 64)
        ارجع 3
    نهاية
    إذا (حجم_مطلوب <= 128)
        ارجع 4
    نهاية
    إذا (حجم_مطلوب <= 256)
        ارجع 5
    نهاية
    إذا (حجم_مطلوب <= 512)
        ارجع 6
    نهاية
    إذا (حجم_مطلوب <= 1024)
        ارجع 7
    نهاية
    إذا (حجم_مطلوب <= 2048)
        ارجع 8
    نهاية
    ارجع -1  # أكبر من أكبر slab
نهاية

## ─────────────────────────────────────────────────────
## إنشاء Slab جديد لحجم كائن محدد
## ─────────────────────────────────────────────────────
## يُخصص صفحة جديدة، يُقسمها لكائنات، ويُنشئ القائمة الحرة
## المعامل: فهرس_الحجم — فهرس في slab_أحجام
## يُعيد: عنوان الصفحة الجديدة، أو 0 إذا فشل التخصيص
دالة أنشئ_slab(فهرس_الحجم)
    # خصص صفحة فيزيائية
    متغير عنوان_الصفحة = خصص_صفحة_خارجية()
    إذا (عنوان_الصفحة == 0)
        ارجع 0
    نهاية
    
    # تصفير الصفحة
    املأ_ذاكرة(عنوان_الصفحة، 0، حجم_الصفحة)
    
    # حجم الكائن لهذا الفهرس
    متغير حجم_الكائن = slab_أحجام[فهرس_الحجم]
    
    # حساب عدد الكائنات (بعد خصم رأس Slab)
    متغير مساحة_متاحة = حجم_الصفحة - حجم_رأس_slab
    متغير عدد_كائنات = مساحة_متاحة / حجم_الكائن
    
    # ──── كتابة رأس Slab ────
    # [0-7] حجم الكائن
    اكتب_ذاكرة(عنوان_الصفحة، حجم_الكائن)
    
    # [8-15] عنوان أول كائن حر (بعد الرأس مباشرة)
    متغير أول_كائن = عنوان_الصفحة + حجم_رأس_slab
    اكتب_ذاكرة(عنوان_الصفحة + 8، أول_كائن)
    
    # [16-23] عدد الكائنات الحرة
    اكتب_ذاكرة(عنوان_الصفحة + 16، عدد_كائنات)
    
    # [24-31] إجمالي الكائنات
    اكتب_ذاكرة(عنوان_الصفحة + 24، عدد_كائنات)
    
    # [32-39] عنوان الصفحة التالية (0 = لا يوجد)
    اكتب_ذاكرة(عنوان_الصفحة + 32، 0)
    
    # [40-47] القناع السحري
    اكتب_ذاكرة(عنوان_الصفحة + 40، القناع_السحري)
    
    # [48-55] فهرس الحجم
    اكتب_ذاكرة(عنوان_الصفحة + 48، فهرس_الحجم)
    
    # ──── بناء القائمة الحرة ────
    # كل كائن حر يحتوي عنوان الكائن التالي في أول 8 بايتات
    # الكائن الأخير → 0 (نهاية القائمة)
    متغير ك = 0
    بينما (ك < عدد_كائنات - 1)
        متغير عنوان_حالي = أول_كائن + (ك * حجم_الكائن)
        متغير عنوان_تالي = أول_كائن + ((ك + 1) * حجم_الكائن)
        # كتابة عنوان الكائن التالي في أول 8 بايتات من الحالي
        اكتب_ذاكرة(عنوان_حالي، عنوان_تالي)
        ك = ك + 1
    نهاية
    
    # الكائن الأخير → 0
    متغير عنوان_أخير = أول_كائن + ((عدد_كائنات - 1) * حجم_الكائن)
