# ═══════════════════════════════════════════════════════════════════════════════
# القسم ٦: مُخصص الكومة العام — kmalloc / kfree
# ═══════════════════════════════════════════════════════════════════════════════
#
# واجهة عامة مشابهة لـ malloc/free في C:
#   kmalloc(حجم)  → عنوان كتلة ذاكرة بالحجم المطلوب
#   kfree(عنوان)  → تحرير الكتلة
#
# الخوارزمية:
#   1. إذا الحجم <= 2048: استخدم Slab Allocator
#   2. إذا الحجم > 2048: خصص صفحات مباشرة
#
# كل كتلة مسبوقة برأس (Block Header):
#   [الحجم | فهرس_Slab(-1 = صفحات) | القناع السحري]

## ─────────── إحصائيات عامة ───────────
متغير kmalloc_إجمالي = 0
متغير kfree_إجمالي = 0
متغير kmalloc_بايتات = 0
متغير kmalloc_صفحات_مباشرة = 0
متغير kfree_صفحات_مباشرة = 0

## ─────────────────────────────────────────────────────
## kmalloc — تخصيص ذاكرة ديناميكية
## ─────────────────────────────────────────────────────
## المعامل: الحجم — عدد البايتات المطلوبة
## يُعيد: عنوان الذاكرة المُخصصة، أو 0 إذا فشل
صدّر دالة kmalloc(الحجم)
    إذا (الحجم == 0)
        ارجع 0
    نهاية
    
    # أضف حجم الرأس
    متغير الحجم_الكلي = الحجم + حجم_رأس_الكتلة
    
    # هل يمكن استخدام Slab؟
    إذا (الحجم_الكلي <= 2048)
        متغير فهرس = فهرس_slab_لحجم(الحجم_الكلي)
        إذا (فهرس >= 0)
            إذا (slab_مُهيّأ == 1)
                متغير عنوان_كتلة = خصص_slab(فهرس)
                إذا (عنوان_كتلة != 0)
                    # اكتب رأس الكتلة
                    اكتب_ذاكرة(عنوان_كتلة، الحجم)  # الحجم الأصلي (بدون الرأس)
                    اكتب_ذاكرة(عنوان_كتلة + 8، القناع_السحري)
                    
                    # تحديث الإحصائيات
                    kmalloc_إجمالي = kmalloc_إجمالي + 1
                    kmalloc_بايتات = kmalloc_بايتات + الحجم
                    
                    # أعد عنوان البيانات (بعد الرأس)
                    ارجع عنوان_كتلة + حجم_رأس_الكتلة
                نهاية
            نهاية
        نهاية
    نهاية
    
    # الحجم أكبر من أكبر Slab — خصص صفحات مباشرة
    متغير صفحات_مطلوبة = (الحجم_الكلي / حجم_الصفحة) + 1
    متغير عنوان_صفحات = خصص_صفحات_خارجية(صفحات_مطلوبة)
    
    إذا (عنوان_صفحات == 0)
        ارجع 0
    نهاية
    
    # اكتب رأس الكتلة مع معلومات إضافية
    # نخزن الحجم في أول 8 بايتات والقناع في الثانية
    اكتب_ذاكرة(عنوان_صفحات، الحجم)
    اكتب_ذاكرة(عنوان_صفحات + 8، القناع_السحري + صفحات_مطلوبة)  # قناع + عدد الصفحات
    
    kmalloc_إجمالي = kmalloc_إجمالي + 1
    kmalloc_بايتات = kmalloc_بايتات + الحجم
    kmalloc_صفحات_مباشرة = kmalloc_صفحات_مباشرة + 1
    
    ارجع عنوان_صفحات + حجم_رأس_الكتلة
نهاية

## ─────────────────────────────────────────────────────
## kfree — تحرير ذاكرة ديناميكية
## ─────────────────────────────────────────────────────
## المعامل: عنوان — عنوان الذاكرة (المُعاد من kmalloc)
صدّر دالة kfree(عنوان)
    إذا (عنوان == 0)
        ارجع
    نهاية
    
    # ارجع لرأس الكتلة
    متغير عنوان_الرأس = عنوان - حجم_رأس_الكتلة
    
    # اقرأ الحجم والقناع
    متغير حجم_مخزن = اقرأ_ذاكرة(عنوان_الرأس)
    متغير قناع_مخزن = اقرأ_ذاكرة(عنوان_الرأس + 8)
    
    # تحقق من القناع السحري
    إذا (قناع_مخزن == القناع_السحري)
        # كتلة Slab — حرر عبر Slab allocator
        حرر_slab(عنوان_الرأس)
    وإلا
        # كتلة صفحات مباشرة — استخرج عدد الصفحات من القناع
        متغير صفحات = قناع_مخزن - القناع_السحري
        إذا (صفحات > 0)
            إذا (صفحات < 10000)
                حرر_صفحات_خارجية(عنوان_الرأس، صفحات)
                kfree_صفحات_مباشرة = kfree_صفحات_مباشرة + 1
            نهاية
        نهاية
    نهاية
    
    kfree_إجمالي = kfree_إجمالي + 1
نهاية

## ─────────────────────────────────────────────────────
## krealloc — إعادة تخصيص ذاكرة بحجم جديد
## ─────────────────────────────────────────────────────
## مشابه لـ realloc() في C
## 1. خصص كتلة جديدة بالحجم الجديد
## 2. انسخ البيانات القديمة
## 3. حرر الكتلة القديمة
صدّر دالة krealloc(عنوان، حجم_جديد)
    إذا (عنوان == 0)
        ارجع kmalloc(حجم_جديد)
    نهاية
    
    إذا (حجم_جديد == 0)
        kfree(عنوان)
        ارجع 0
    نهاية
    
    # اقرأ الحجم القديم
    متغير عنوان_الرأس = عنوان - حجم_رأس_الكتلة
    متغير الحجم_القديم = اقرأ_ذاكرة(عنوان_الرأس)
    
    # إذا الحجم الجديد <= القديم، لا تفعل شيئاً
    إذا (حجم_جديد <= الحجم_القديم)
