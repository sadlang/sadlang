## ─────────────────────────────────────────────────────
## تخصيص كائن من Slab
## ─────────────────────────────────────────────────────
## O(1) — يسحب من رأس القائمة الحرة
## المعامل: فهرس_الحجم — فهرس حجم Slab
## يُعيد: عنوان الكائن المُخصص، أو 0 إذا فشل
دالة خصص_slab(فهرس_الحجم)
    إذا (فهرس_الحجم < 0)
        ارجع 0
    نهاية
    إذا (فهرس_الحجم >= عدد_أحجام_slab)
        ارجع 0
    نهاية
    
    # ابحث عن Slab فيه كائنات حرة
    متغير عنوان_slab = slab_أول_صفحة[فهرس_الحجم]
    
    بينما (عنوان_slab != 0)
        # اقرأ عدد الكائنات الحرة في هذا Slab
        متغير حرة_في_slab = اقرأ_ذاكرة(عنوان_slab + 16)
        
        إذا (حرة_في_slab > 0)
            # وجدنا slab فيه مساحة!
            # اقرأ عنوان أول كائن حر
            متغير عنوان_حر = اقرأ_ذاكرة(عنوان_slab + 8)
            
            إذا (عنوان_حر == 0)
