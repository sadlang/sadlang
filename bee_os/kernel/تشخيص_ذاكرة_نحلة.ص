# تفريغ ذاكرة (Hex Dump)
# ═══════════════════════════════════════════════════════════════════════════════

#** تفريغ سداسي عشري لمنطقة ذاكرة
#   يطبع المحتوى بتنسيق سداسي عشري مع العنوان
#   عنوان_تفريغ: بداية المنطقة
#   مقاس_تفريغ: عدد الكلمات (dwords) لعرضها (أقصى 64)
**#
صدّر دالة تفريغ_ذاكرة(عنوان_تفريغ، مقاس_تفريغ)
    kernel_print_string("\n─── تفريغ ذاكرة ───\n")
    kernel_print_string("  العنوان: ")
    serial_put_hex(عنوان_تفريغ)
    kernel_print_string("  المقاس: ")
    kernel_print_number(مقاس_تفريغ * 4)
    kernel_print_string(" بايت\n\n")

    # تقييد المقاس
    متغير حد_اقصى = 64
    إذا (مقاس_تفريغ > حد_اقصى)
        مقاس_تفريغ = حد_اقصى
    نهاية

    متغير م = 0
    بينما (م < مقاس_تفريغ)
        # طباعة العنوان في بداية كل سطر (كل 4 كلمات = 16 بايت)
        متغير باقي = م & 3
        إذا (باقي == 0)
            kernel_print_string("  ")
            serial_put_hex(عنوان_تفريغ + (م * 4))
            kernel_print_string(": ")
        نهاية

        # قراءة وعرض الكلمة
        متغير قيمة = mem_read_dword(عنوان_تفريغ + (م * 4))
        serial_put_hex(قيمة)
        kernel_print_string(" ")

        # سطر جديد بعد كل 4 كلمات
        متغير فحص_سطر = (م + 1) & 3
        إذا (فحص_سطر == 0)
            kernel_print_string("\n")
        نهاية

        م = م + 1
    نهاية

    kernel_print_string("\n─── نهاية التفريغ ───\n")

    ارجع 0
نهاية

