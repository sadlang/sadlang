    # كتابة حارس البداية (4 بايتات قبل المنطقة)
    mem_write_dword(عنوان_ذاكرة - 4، ثابت_قيمة_حارسة_بداية)

    # كتابة حارس النهاية (4 بايتات بعد المنطقة)
    mem_write_dword(عنوان_ذاكرة + مقاس_ذاكرة، ثابت_قيمة_حارسة_نهاية)

    ارجع 0
