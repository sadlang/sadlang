# ═══════════════════════════════════════════════════════════════════════════════
# حساب بصمة بسيطة (Checksum) لمنطقة ذاكرة
# ═══════════════════════════════════════════════════════════════════════════════

#** حساب بصمة XOR بسيطة لمنطقة ذاكرة
#   تُستخدم لكشف التغييرات/الفساد في المنطقة
#   عنوان_بداية: بداية المنطقة
#   مقاس_بصمة: مقاس المنطقة بالبايتات (مضاعف 4)
**#
دالة حساب_بصمة(عنوان_بداية، مقاس_بصمة)
    متغير بصمة = 0
    متغير إزاحة = 0
    متغير كلمات = مقاس_بصمة / 4

    بينما (إزاحة < كلمات)
        متغير قيمة = mem_read_dword(عنوان_بداية + (إزاحة * 4))
        # XOR مع تدوير بسيط
        متغير مزاحة = بصمة >> 1
        بصمة = مزاحة ^ قيمة
        إزاحة = إزاحة + 1
    نهاية

    ارجع بصمة
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تسجيل تخصيص جديد
# ═══════════════════════════════════════════════════════════════════════════════

#** تسجيل تخصيص ذاكرة جديد في جدول التتبع
#   يُستدعى بعد كل تخصيص ذاكرة ناجح
#   عنوان_مخصص: عنوان الذاكرة المخصصة
#   مقاس_مخصص: مقاس التخصيص بالبايتات
#   معرف_مالك_جديد: معرف العملية أو الوحدة
**#
صدّر دالة تسجيل_تخصيص(عنوان_مخصص، مقاس_مخصص، معرف_مالك_جديد)
    إذا (تم_التهيئة == 0)
        ارجع -1
    نهاية

    علامة_وقت_حالي = علامة_وقت_حالي + 1

    # تحديث الإحصائيات العامة
    عداد_تخصيصات_الكلي = عداد_تخصيصات_الكلي + 1
    عداد_تخصيصات_دورة = عداد_تخصيصات_دورة + 1
    إجمالي_بايتات_مخصصة = إجمالي_بايتات_مخصصة + مقاس_مخصص

    # تحديث المدرج التكراري
    إذا (عنوان_مدرج != 0)
        متغير فئة = فئة_مدرج(مقاس_مخصص)
        متغير قيمة_حالية = قراءة_حقل(عنوان_مدرج، فئة)
        كتابة_حقل(عنوان_مدرج، فئة، قيمة_حالية + 1)
    نهاية

    # تسجيل في جدول التتبع
    إذا (عنوان_تتبع_عنوان != 0)
        متغير فهرس = فهرس_تتبع_تالي

        كتابة_حقل(عنوان_تتبع_عنوان، فهرس، عنوان_مخصص)
        كتابة_حقل(عنوان_تتبع_مقاس، فهرس، مقاس_مخصص)
        كتابة_حقل(عنوان_تتبع_وقت، فهرس، علامة_وقت_حالي)
        كتابة_حقل(عنوان_تتبع_مالك، فهرس، معرف_مالك_جديد)
