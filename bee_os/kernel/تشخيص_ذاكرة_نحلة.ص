        serial_put_hex(ثابت_قيمة_حارسة_بداية)
        kernel_print_string(" فعلي=")
        serial_put_hex(حارس_بداية)
        kernel_print_string("\n")
        ناتج = ناتج + 1
    نهاية

    # فحص حارس النهاية
    متغير حارس_نهاية = mem_read_dword(عنوان_ذاكرة + مقاس_ذاكرة)
    إذا (حارس_نهاية != ثابت_قيمة_حارسة_نهاية)
        kernel_print_string("  ⚠ حارس النهاية فاسد! عنوان=")
        serial_put_hex(عنوان_ذاكرة + مقاس_ذاكرة)
        kernel_print_string(" متوقع=")
