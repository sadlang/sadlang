# الثوابت
# ──────────────────────────────────────────────
ثابت خوارزمية_rle = 1
ثابت خوارزمية_lz77 = 2
ثابت نافذة_lz77 = 256                # حجم نافذة LZ77 المنزلقة

#* ── إحصائيات الضغط ── *#
متغير ضغط_عمليات = 0
متغير ضغط_بايتات_أصلية = 0
متغير ضغط_بايتات_مضغوطة = 0
متغير فك_عمليات = 0

# ══════════════════════════════════════════════
# القسم 1: ضغط RLE
# ══════════════════════════════════════════════

#* ── ضغط RLE (Run-Length Encoding) ──
   
   الخوارزمية:
   1. اقرأ البايت الحالي
   2. عُدّ التكرارات المتتالية (حتى 127)
   3. إذا التكرار > 1: اكتب [عدد | 0x80, بايت]
   4. إذا التكرار == 1: اكتب البايت كما هو
   
   التنسيق:
   - بايت تحكم >= 128: الـ 7 بت السفلى = عدد التكرار
   - بايت تحكم < 128: تسلسل حرفي بطول = بايت التحكم
   
   المدخلات:
   - مصدر: عنوان البيانات الأصلية
   - مقاس_م: حجم البيانات الأصلية
   - وجهة: عنوان المخزن المؤقت للبيانات المضغوطة
   - مقاس_و: حجم المخزن المؤقت
   
   المخرجات:
   - حجم البيانات المضغوطة، -1 عند الفشل
*#
صدّر دالة ضغط_rle(مصدر، مقاس_م، وجهة، مقاس_و)
    متغير ف_م = 0                    # فهرس المصدر
    متغير ف_و = 0                    # فهرس الوجهة
    
    بينما (ف_م < مقاس_م)
        # اقرأ البايت الحالي
        متغير بايت_ح = mem_read_byte(مصدر + ف_م)
        متغير عدد_تكرار = 1
        
        # عُدّ التكرارات
        متغير ف_بحث = ف_م + 1
        بينما (ف_بحث < مقاس_م)
            إذا (عدد_تكرار >= 127)
                ف_بحث = مقاس_م
            وإلا
                متغير بايت_ت = mem_read_byte(مصدر + ف_بحث)
                إذا (بايت_ت == بايت_ح)
                    عدد_تكرار = عدد_تكرار + 1
                    ف_بحث = ف_بحث + 1
                وإلا
                    ف_بحث = مقاس_م
                نهاية
            نهاية
        نهاية
        
        إذا (عدد_تكرار > 1)
            # تكرار: اكتب [128 + عدد, بايت]
            إذا (ف_و + 2 > مقاس_و)
                ارجع -1
            نهاية
            mem_write_byte(وجهة + ف_و، 128 + عدد_تكرار)
            ف_و = ف_و + 1
            mem_write_byte(وجهة + ف_و، بايت_ح)
            ف_و = ف_و + 1
        وإلا
            # بايت منفرد: اكتب [1, بايت]
            إذا (ف_و + 2 > مقاس_و)
                ارجع -1
            نهاية
            mem_write_byte(وجهة + ف_و، 1)
            ف_و = ف_و + 1
            mem_write_byte(وجهة + ف_و، بايت_ح)
            ف_و = ف_و + 1
        نهاية
        
        ف_م = ف_م + عدد_تكرار
    نهاية
    
    ضغط_عمليات = ضغط_عمليات + 1
    ضغط_بايتات_أصلية = ضغط_بايتات_أصلية + مقاس_م
    ضغط_بايتات_مضغوطة = ضغط_بايتات_مضغوطة + ف_و
    
    ارجع ف_و
نهاية

# ══════════════════════════════════════════════
# القسم 2: فك ضغط RLE
# ══════════════════════════════════════════════

#* ── فك ضغط RLE ──
   المدخلات: مصدر، مقاس_م (المضغوط)، وجهة، مقاس_و
   المخرجات: حجم البيانات المفكوكة
*#
صدّر دالة فك_ضغط_rle(مصدر، مقاس_م، وجهة، مقاس_و)
    متغير ف_م = 0
    متغير ف_و = 0
    
    بينما (ف_م < مقاس_م)
        متغير تحكم = mem_read_byte(مصدر + ف_م)
        ف_م = ف_م + 1
        
        إذا (ف_م >= مقاس_م)
            ارجع ف_و
        نهاية
        
        متغير بايت_ق = mem_read_byte(مصدر + ف_م)
        ف_م = ف_م + 1
        
        متغير عدد_ك = 0
        إذا (تحكم >= 128)
            # تكرار
            عدد_ك = تحكم - 128
        وإلا
            عدد_ك = تحكم
        نهاية
        
        متغير ع = 0
        بينما (ع < عدد_ك)
            إذا (ف_و < مقاس_و)
                mem_write_byte(وجهة + ف_و، بايت_ق)
                ف_و = ف_و + 1
            نهاية
            ع = ع + 1
        نهاية
    نهاية
    
    فك_عمليات = فك_عمليات + 1
    ارجع ف_و
نهاية

# ══════════════════════════════════════════════
# القسم 3: ضغط LZ77 مبسّط
# ══════════════════════════════════════════════

#* ── ضغط LZ77 مبسّط ──
   
   الخوارزمية:
   1. لكل موقع في المصدر:
      a. ابحث عن أطول تطابق في النافذة السابقة
      b. إذا وُجد تطابق >= 3: اكتب [0xFF, مسافة, طول]
      c. إذا لم يُوجد: اكتب البايت كما هو
   
   التنسيق:
   - 0xFF = علامة مرجع خلفي (backreference)
   - لذلك البايت 0xFF يُمثّل كـ [0xFF, 0, 0]
*#
صدّر دالة ضغط_lz77(مصدر، مقاس_م، وجهة، مقاس_و)
    متغير ف_م = 0
    متغير ف_و = 0
    
    بينما (ف_م < مقاس_م)
        متغير أفضل_مسافة = 0
        متغير أفضل_طول = 0
        
        # حدود النافذة
        متغير بداية_نافذة = ف_م - نافذة_lz77
        إذا (بداية_نافذة < 0)
            بداية_نافذة = 0
        نهاية
        
        # البحث عن تطابق في النافذة
        متغير موقع_بحث = بداية_نافذة
        بينما (موقع_بحث < ف_م)
            متغير طول_تطابق = 0
            متغير ع_بحث = 0
            
            # قارن من الموقع الحالي
            متغير موقع_م = موقع_بحث + 0
            متغير موقع_ح = ف_م + 0
            
            بينما (موقع_ح < مقاس_م)
                متغير ب1 = mem_read_byte(مصدر + موقع_م)
                متغير ب2 = mem_read_byte(مصدر + موقع_ح)
                إذا (ب1 == ب2)
                    طول_تطابق = طول_تطابق + 1
                    موقع_م = موقع_م + 1
                    موقع_ح = موقع_ح + 1
                    إذا (طول_تطابق >= 127)
                        موقع_ح = مقاس_م
                    نهاية
                وإلا
                    موقع_ح = مقاس_م
                نهاية
            نهاية
            
            إذا (طول_تطابق > أفضل_طول)
                أفضل_طول = طول_تطابق
                أفضل_مسافة = ف_م - موقع_بحث
            نهاية
            
            موقع_بحث = موقع_بحث + 1
        نهاية
        
        إذا (أفضل_طول >= 3)
            # مرجع خلفي: [0xFF, مسافة، طول]
            إذا (ف_و + 3 > مقاس_و)
                ارجع -1
            نهاية
            mem_write_byte(وجهة + ف_و، 255)
            ف_و = ف_و + 1
            mem_write_byte(وجهة + ف_و، أفضل_مسافة)
            ف_و = ف_و + 1
            mem_write_byte(وجهة + ف_و، أفضل_طول)
            ف_و = ف_و + 1
            ف_م = ف_م + أفضل_طول
        وإلا
            # بايت حرفي
            متغير بايت_ح = mem_read_byte(مصدر + ف_م)
            إذا (بايت_ح == 255)
                # بايت 0xFF يحتاج هروب
                إذا (ف_و + 3 > مقاس_و)
                    ارجع -1
                نهاية
                mem_write_byte(وجهة + ف_و، 255)
                ف_و = ف_و + 1
                mem_write_byte(وجهة + ف_و، 0)
                ف_و = ف_و + 1
                mem_write_byte(وجهة + ف_و، 0)
                ف_و = ف_و + 1
            وإلا
                إذا (ف_و + 1 > مقاس_و)
                    ارجع -1
                نهاية
                mem_write_byte(وجهة + ف_و، بايت_ح)
                ف_و = ف_و + 1
            نهاية
            ف_م = ف_م + 1
        نهاية
    نهاية
    
    ضغط_عمليات = ضغط_عمليات + 1
    ضغط_بايتات_أصلية = ضغط_بايتات_أصلية + مقاس_م
    ضغط_بايتات_مضغوطة = ضغط_بايتات_مضغوطة + ف_و
    
    ارجع ف_و
نهاية

