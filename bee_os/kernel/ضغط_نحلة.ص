# القسم 5: واجهة الضغط الموحدة
# ══════════════════════════════════════════════

#* ── ضغط بيانات بخوارزمية محددة ── *#
صدّر دالة ضغط_بيانات(خوارزمية، مصدر، مقاس_م، وجهة، مقاس_و)
    إذا (خوارزمية == خوارزمية_rle)
        ارجع ضغط_rle(مصدر، مقاس_م، وجهة، مقاس_و)
    نهاية
    إذا (خوارزمية == خوارزمية_lz77)
        ارجع ضغط_lz77(مصدر، مقاس_م، وجهة، مقاس_و)
    نهاية
    kernel_print_string("  [compress] unknown algorithm: ")
    kernel_print_number(خوارزمية)
    kernel_print_number(10)
    ارجع -1
نهاية

#* ── فك ضغط بيانات ── *#
صدّر دالة فك_ضغط_بيانات(خوارزمية، مصدر، مقاس_م، وجهة، مقاس_و)
    إذا (خوارزمية == خوارزمية_rle)
        ارجع فك_ضغط_rle(مصدر، مقاس_م، وجهة، مقاس_و)
    نهاية
    إذا (خوارزمية == خوارزمية_lz77)
        ارجع فك_ضغط_lz77(مصدر، مقاس_م، وجهة، مقاس_و)
    نهاية
    ارجع -1
نهاية

