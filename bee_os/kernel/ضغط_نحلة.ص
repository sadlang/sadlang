# القسم 4: فك ضغط LZ77
# ══════════════════════════════════════════════

#* ── فك ضغط LZ77 ── *#
صدّر دالة فك_ضغط_lz77(مصدر، مقاس_م، وجهة، مقاس_و)
    متغير ف_م = 0
    متغير ف_و = 0
    
    بينما (ف_م < مقاس_م)
        متغير بايت_ح = mem_read_byte(مصدر + ف_م)
        ف_م = ف_م + 1
        
        إذا (بايت_ح == 255)
            # مرجع خلفي أو بايت 0xFF هارب
            إذا (ف_م + 2 > مقاس_م)
                ارجع ف_و
            نهاية
            متغير مسافة = mem_read_byte(مصدر + ف_م)
            ف_م = ف_م + 1
            متغير طول_ن = mem_read_byte(مصدر + ف_م)
            ف_م = ف_م + 1
            
            إذا (مسافة == 0)
                إذا (طول_ن == 0)
                    # بايت 0xFF هارب
                    إذا (ف_و < مقاس_و)
                        mem_write_byte(وجهة + ف_و، 255)
                        ف_و = ف_و + 1
                    نهاية
                نهاية
            وإلا
                # نسخ من الخلف
                متغير موقع_نسخ = ف_و - مسافة
                متغير ع = 0
                بينما (ع < طول_ن)
                    إذا (ف_و < مقاس_و)
                        متغير ب = mem_read_byte(وجهة + موقع_نسخ + ع)
                        mem_write_byte(وجهة + ف_و، ب)
                        ف_و = ف_و + 1
                    نهاية
                    ع = ع + 1
                نهاية
            نهاية
        وإلا
            # بايت حرفي
            إذا (ف_و < مقاس_و)
                mem_write_byte(وجهة + ف_و، بايت_ح)
                ف_و = ف_و + 1
            نهاية
        نهاية
    نهاية
    
    فك_عمليات = فك_عمليات + 1
    ارجع ف_و
نهاية

