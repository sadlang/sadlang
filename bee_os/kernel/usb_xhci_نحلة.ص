# ─── Capability Register Offsets ───
ثابت XHCI_CAP_CAPLENGTH = 0       # 1 byte: Capability Register Length
ثابت XHCI_CAP_HCIVERSION = 2      # 2 bytes: Interface Version
ثابت XHCI_CAP_HCSPARAMS1 = 4      # 4 bytes: Structural Parameters 1
ثابت XHCI_CAP_HCSPARAMS2 = 8      # 4 bytes: Structural Parameters 2
ثابت XHCI_CAP_HCSPARAMS3 = 12     # 0x0C
ثابت XHCI_CAP_HCCPARAMS1 = 16     # 0x10
ثابت XHCI_CAP_DBOFF = 20          # 0x14: Doorbell Offset
ثابت XHCI_CAP_RTSOFF = 24         # 0x18: Runtime Register Space Offset
ثابت XHCI_CAP_HCCPARAMS2 = 28     # 0x1C

# ─── Operational Register Offsets (from cap_length) ───
ثابت XHCI_OP_USBCMD = 0           # USB Command
ثابت XHCI_OP_USBSTS = 4           # USB Status
ثابت XHCI_OP_PAGESIZE = 8         # Page Size
ثابت XHCI_OP_DNCTRL = 20          # 0x14: Device Notification Control
ثابت XHCI_OP_CRCR = 24            # 0x18: Command Ring Control (64-bit)
ثابت XHCI_OP_DCBAAP = 48          # 0x30: Device Context Base Address Array Pointer (64-bit)
ثابت XHCI_OP_CONFIG = 56          # 0x38: Configure

# ─── Port Register Offsets (from op_base + 0x400) ───
ثابت XHCI_PORTSC_OFFSET = 1024    # 0x400: Port Status and Control base
ثابت XHCI_PORTSC_SIZE = 16        # 0x10: Each port register set is 16 bytes

# ─── USBCMD bits ───
ثابت XHCI_CMD_RUN = 1             # Run/Stop
ثابت XHCI_CMD_HCRST = 2           # Host Controller Reset
ثابت XHCI_CMD_INTE = 4            # Interrupter Enable
ثابت XHCI_CMD_HSEE = 8            # Host System Error Enable

# ─── USBSTS bits ───
ثابت XHCI_STS_HCH = 1             # HC Halted
ثابت XHCI_STS_HSE = 4             # Host System Error
ثابت XHCI_STS_EINT = 8            # Event Interrupt
ثابت XHCI_STS_PCD = 16            # Port Change Detect
ثابت XHCI_STS_CNR = 2048          # 0x800: Controller Not Ready

# ─── PORTSC bits ───
