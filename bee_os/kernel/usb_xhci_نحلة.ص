ثابت PORTSC_SPEED_MASK = 15360    # 0x3C00: bits 13:10 for port speed
ثابت PORTSC_CSC = 131072          # 0x20000: Connect Status Change  bit 17
ثابت PORTSC_PRC = 2097152         # 0x200000: Port Reset Change  bit 21
ثابت PORTSC_WRC = 524288          # 0x80000: Warm Port Reset Change  bit 19

# ─── Port Speed values (bits 13:10) ───
