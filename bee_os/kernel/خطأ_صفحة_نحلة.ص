# ============================================================
# وحدة معالج أخطاء الصفحات — نظام نحلة (BeeOS)
# الملف: خطأ_صفحة_نحلة.ص
# الوظيفة: معالجة استثناءات خطأ الصفحة (Page Fault Exception #14)
# ============================================================
#
# خطأ الصفحة (Page Fault) يحدث عندما:
# 1. الصفحة غير موجودة (Not Present)
# 2. انتهاك الحماية (Protection Violation) 
# 3. كتابة على صفحة للقراءة فقط
# 4. وصول المستخدم لصفحة النواة
# 5. تنفيذ كود من صفحة غير قابلة للتنفيذ
#
# سجل CR2 يحتوي على العنوان الذي سبب الخطأ
# كود الخطأ (Error Code) يحتوي على سبب الخطأ:
# بت 0: 0=غير موجودة، 1=انتهاك حماية
# بت 1: 0=قراءة، 1=كتابة
# بت 2: 0=مشرف، 1=مستخدم
# بت 3: 0=عادي، 1=بتات محجوزة معطوبة
# بت 4: 0=ليس جلب تعليمة، 1=جلب تعليمة
#
# ============================================================

# ============================================================
# الثوابت
# ============================================================

# أنواع أخطاء الصفحات
متغير خطأ_غير_موجودة = 0
متغير خطأ_حماية = 1
متغير خطأ_كتابة_محمية = 2
متغير خطأ_مستخدم_نواة = 3
متغير خطأ_تنفيذ_محمي = 4
متغير خطأ_نسخ_كتابة = 5
متغير خطأ_تبديل = 6
متغير خطأ_مكدس_نمو = 7
متغير خطأ_كومة_نمو = 8
متغير خطأ_غير_قابل_معالجة = 9

# بتات كود الخطأ
متغير بت_موجودة = 1
متغير بت_كتابة = 2
متغير بت_مستخدم = 4
متغير بت_محجوز = 8
متغير بت_تنفيذ = 16

# ثوابت المناطق
متغير ثابت_مقاس_صفحة = 4096
متغير ثابت_بداية_كومة = 134217728
متغير ثابت_اقصى_كومة = 1073741823

# حدود المكدس
متغير ثابت_اقصى_مكدس = 1048576

# ============================================================
# إحصائيات أخطاء الصفحات
# ============================================================

# عداد الأخطاء حسب النوع
متغير عداد_أخطاء_إجمالي = 0
متغير عداد_غير_موجودة = 0
متغير عداد_حماية = 0
متغير عداد_كتابة_محمية = 0
متغير عداد_نسخ_كتابة = 0
متغير عداد_تبديل = 0
متغير عداد_مكدس_نمو = 0
متغير عداد_كومة_نمو = 0
متغير عداد_قاتلة = 0
متغير عداد_معالجة_ناجحة = 0

# آخر خطأ
متغير آخر_عنوان_خطأ = 0
متغير آخر_كود_خطأ = 0
متغير آخر_فئة_خطأ = 0

# ============================================================
# جدول معالجات أخطاء الصفحات المُسجّلة
# ============================================================
# يمكن للوحدات الأخرى تسجيل معالجات مخصصة
# كل سجل: [عنوان_بداية، عنوان_نهاية، فئة_خطأ، عنوان_معالج]
متغير ثابت_اقصى_معالجات = 16
متغير ثابت_مقاس_سجل_معالج = 4
متغير عنوان_جدول_معالجات = 27262976
متغير عدد_معالجات_مسجلة = 0

# ============================================================
# تحليل كود الخطأ
# ============================================================

# هل الصفحة كانت موجودة عند الخطأ
دالة خطأ_صفحة_موجودة(كود_خطأ)
    متغير فحص = كود_خطأ & بت_موجودة
    إذا (فحص != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# هل الخطأ بسبب عملية كتابة
دالة خطأ_بسبب_كتابة(كود_خطأ)
    متغير فحص = كود_خطأ & بت_كتابة
    إذا (فحص != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# هل الخطأ في وضع المستخدم
دالة خطأ_وضع_مستخدم(كود_خطأ)
    متغير فحص = كود_خطأ & بت_مستخدم
    إذا (فحص != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# هل الخطأ بسبب بتات محجوزة
دالة خطأ_بتات_محجوزة(كود_خطأ)
    متغير فحص = كود_خطأ & بت_محجوز
    إذا (فحص != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# هل الخطأ أثناء جلب تعليمة
دالة خطأ_جلب_تعليمة(كود_خطأ)
    متغير فحص = كود_خطأ & بت_تنفيذ
    إذا (فحص != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ============================================================
# تصنيف خطأ الصفحة
# ============================================================

# تصنيف خطأ الصفحة لتحديد الإجراء المناسب
# المعاملات: عنوان_خطأ، كود_خطأ
# النتيجة: فئة الخطأ
دالة تصنيف_خطأ(عنوان_خطأ، كود_خطأ)
    # فحص هل البتات المحجوزة معطوبة
    متغير فحص_محجوز = خطأ_بتات_محجوزة(كود_خطأ)
    إذا (فحص_محجوز == 1)
        ارجع خطأ_غير_قابل_معالجة
    نهاية
    
    # فحص الصفحة الصفرية (NULL)
    إذا (عنوان_خطأ < 4096)
        ارجع خطأ_غير_قابل_معالجة
    نهاية
    
    # فحص هل الصفحة غير موجودة
    متغير فحص_موجودة = خطأ_صفحة_موجودة(كود_خطأ)
    إذا (فحص_موجودة == 0)
        # الصفحة غير موجودة — فحص: هل في منطقة الكومة؟
        إذا (عنوان_خطأ >= ثابت_بداية_كومة)
            إذا (عنوان_خطأ < ثابت_اقصى_كومة)
                ارجع خطأ_كومة_نمو
            نهاية
        نهاية
        
        # هل في منطقة المكدس؟
        متغير حد_نواة = 3221225472
        متغير قاع_مكدس = حد_نواة - ثابت_اقصى_مكدس
        إذا (عنوان_خطأ >= قاع_مكدس)
            إذا (عنوان_خطأ < حد_نواة)
                ارجع خطأ_مكدس_نمو
            نهاية
        نهاية
        
        ارجع خطأ_غير_موجودة
    نهاية
    
    # الصفحة موجودة لكن حدث انتهاك حماية
    متغير فحص_كتابة = خطأ_بسبب_كتابة(كود_خطأ)
    إذا (فحص_كتابة == 1)
        # محاولة كتابة على صفحة للقراءة فقط
        # قد يكون نسخ عند الكتابة (Copy-on-Write)
        ارجع خطأ_نسخ_كتابة
    نهاية
    
    # تنفيذ كود من منطقة محمية
    متغير فحص_تنفيذ = خطأ_جلب_تعليمة(كود_خطأ)
    إذا (فحص_تنفيذ == 1)
        ارجع خطأ_تنفيذ_محمي
    نهاية
    
    # وصول المستخدم لمنطقة النواة
    متغير فحص_مستخدم = خطأ_وضع_مستخدم(كود_خطأ)
    إذا (فحص_مستخدم == 1)
        ارجع خطأ_مستخدم_نواة
    نهاية
    
    ارجع خطأ_حماية
نهاية

# ============================================================
# معالجة نمو الكومة
# ============================================================

# معالجة خطأ صفحة في منطقة الكومة
# يخصص صفحة جديدة تلقائياً (Demand Paging)
دالة معالجة_نمو_كومة(عنوان_خطأ)
    # محاذاة العنوان لحدود صفحة
    متغير عنوان_صفحة = عنوان_خطأ & (~4095)
    
    kernel_print_string("نمو الكومة: تخصيص صفحة عند ")
    kernel_print_number(عنوان_صفحة)
    
    # تخصيص إطار فيزيائي
    # نستدعي sad_ll_page_alloc
    متغير إطار = sad_ll_page_alloc()
    إذا (إطار == 0)
        kernel_print_string("خطأ: فشل تخصيص إطار لنمو الكومة")
        ارجع 0
    نهاية
    
    # تصفير الصفحة
    sad_ll_memset(إطار، 0، ثابت_مقاس_صفحة)
    
    عداد_كومة_نمو = عداد_كومة_نمو + 1
    عداد_معالجة_ناجحة = عداد_معالجة_ناجحة + 1
    ارجع 1
نهاية

# ============================================================
# معالجة نمو المكدس
# ============================================================

# معالجة خطأ صفحة في منطقة المكدس
دالة معالجة_نمو_مكدس(عنوان_خطأ)
    # محاذاة العنوان
    متغير عنوان_صفحة = عنوان_خطأ & (~4095)
    
    kernel_print_string("نمو المكدس: تخصيص صفحة عند ")
    kernel_print_number(عنوان_صفحة)
    
    # تخصيص إطار فيزيائي
    متغير إطار = sad_ll_page_alloc()
    إذا (إطار == 0)
        kernel_print_string("خطأ: فشل تخصيص إطار لنمو المكدس")
        ارجع 0
    نهاية
    
    # تصفير الصفحة
    sad_ll_memset(إطار، 0، ثابت_مقاس_صفحة)
    
    عداد_مكدس_نمو = عداد_مكدس_نمو + 1
    عداد_معالجة_ناجحة = عداد_معالجة_ناجحة + 1
    ارجع 1
نهاية

# ============================================================
# معالجة النسخ عند الكتابة (Copy-on-Write)
# ============================================================

# عندما تحاول عملية الكتابة على صفحة COW:
# 1. نخصص إطار فيزيائي جديد
# 2. ننسخ محتوى الصفحة القديمة
# 3. نُحدّث الربط ليشير للإطار الجديد مع أذونات كتابة
دالة معالجة_نسخ_كتابة(عنوان_خطأ)
    متغير عنوان_صفحة = عنوان_خطأ & (~4095)
    
    kernel_print_string("نسخ عند الكتابة: نسخ صفحة عند ")
    kernel_print_number(عنوان_صفحة)
    
    # تخصيص إطار جديد
    متغير إطار_جديد = sad_ll_page_alloc()
    إذا (إطار_جديد == 0)
        kernel_print_string("خطأ: فشل تخصيص إطار للنسخ عند الكتابة")
        ارجع 0
    نهاية
    
    # نسخ المحتوى من الصفحة القديمة
    sad_ll_memcpy(إطار_جديد، عنوان_صفحة، ثابت_مقاس_صفحة)
    
    عداد_نسخ_كتابة = عداد_نسخ_كتابة + 1
    عداد_معالجة_ناجحة = عداد_معالجة_ناجحة + 1
    ارجع 1
نهاية

# ============================================================
# معالجة الصفحات المُبدّلة (Swapped Pages)
# ============================================================

# عندما تكون الصفحة مُبدّلة إلى القرص:
# 1. نقرأ الصفحة من القرص
# 2. نخصص إطار فيزيائي
# 3. نُحدّث الربط
دالة معالجة_صفحة_مبدلة(عنوان_خطأ)
    متغير عنوان_صفحة = عنوان_خطأ & (~4095)
    
    kernel_print_string("استعادة صفحة مُبدّلة عند ")
    kernel_print_number(عنوان_صفحة)
    
    # تخصيص إطار
    متغير إطار = sad_ll_page_alloc()
    إذا (إطار == 0)
        kernel_print_string("خطأ: فشل تخصيص إطار لاستعادة صفحة مُبدّلة")
        ارجع 0
    نهاية
    
    # قراءة البيانات من القرص (مؤقتاً: تصفير)
    sad_ll_memset(إطار، 0، ثابت_مقاس_صفحة)
    
    عداد_تبديل = عداد_تبديل + 1
    عداد_معالجة_ناجحة = عداد_معالجة_ناجحة + 1
    ارجع 1
نهاية

# ============================================================
# معالجة خطأ قاتل
# ============================================================

# خطأ غير قابل للمعالجة — إنهاء العملية
دالة معالجة_خطأ_قاتل(عنوان_خطأ، كود_خطأ)
    kernel_print_string("!!! خطأ صفحة قاتل !!!")
    kernel_print_string("العنوان:")
    kernel_print_number(عنوان_خطأ)
    kernel_print_string("كود الخطأ:")
    kernel_print_number(كود_خطأ)
    
    # فحص التفاصيل
    متغير فحص_كتابة = خطأ_بسبب_كتابة(كود_خطأ)
    إذا (فحص_كتابة == 1)
        kernel_print_string("السبب: محاولة كتابة")
    وإلا
        kernel_print_string("السبب: محاولة قراءة")
    نهاية
    
    متغير فحص_مستخدم = خطأ_وضع_مستخدم(كود_خطأ)
    إذا (فحص_مستخدم == 1)
        kernel_print_string("الوضع: مستخدم")
    وإلا
        kernel_print_string("الوضع: نواة")
    نهاية
    
    عداد_قاتلة = عداد_قاتلة + 1
    ارجع 0
نهاية

# ============================================================
# المعالج الرئيسي لأخطاء الصفحات
# ============================================================

# نقطة الدخول الرئيسية لمعالجة خطأ الصفحة
# يُستدعى من معالج المقاطعة رقم 14
# المعاملات: كود_خطأ (من المعالج)
# النتيجة: 1=تم المعالجة، 0=خطأ قاتل
دالة معالجة_خطأ_صفحة(كود_خطأ)
    # قراءة العنوان المسبب للخطأ من CR2
    متغير عنوان_خطأ = sad_ll_read_cr2()
    
    # تحديث الإحصائيات والسجل
    عداد_أخطاء_إجمالي = عداد_أخطاء_إجمالي + 1
    آخر_عنوان_خطأ = عنوان_خطأ
    آخر_كود_خطأ = كود_خطأ
    
    # تصنيف الخطأ
    متغير فئة = تصنيف_خطأ(عنوان_خطأ، كود_خطأ)
    آخر_فئة_خطأ = فئة
    
    # معالجة حسب الفئة
    إذا (فئة == خطأ_كومة_نمو)
        ارجع معالجة_نمو_كومة(عنوان_خطأ)
    نهاية
    
    إذا (فئة == خطأ_مكدس_نمو)
        ارجع معالجة_نمو_مكدس(عنوان_خطأ)
    نهاية
    
    إذا (فئة == خطأ_نسخ_كتابة)
        ارجع معالجة_نسخ_كتابة(عنوان_خطأ)
    نهاية
    
    إذا (فئة == خطأ_تبديل)
        ارجع معالجة_صفحة_مبدلة(عنوان_خطأ)
    نهاية
    
    إذا (فئة == خطأ_غير_موجودة)
        عداد_غير_موجودة = عداد_غير_موجودة + 1
        ارجع معالجة_خطأ_قاتل(عنوان_خطأ، كود_خطأ)
    نهاية
    
    إذا (فئة == خطأ_حماية)
        عداد_حماية = عداد_حماية + 1
        ارجع معالجة_خطأ_قاتل(عنوان_خطأ، كود_خطأ)
    نهاية
    
    إذا (فئة == خطأ_كتابة_محمية)
        عداد_كتابة_محمية = عداد_كتابة_محمية + 1
        ارجع معالجة_خطأ_قاتل(عنوان_خطأ، كود_خطأ)
    نهاية
    
    # خطأ غير قابل للمعالجة
    ارجع معالجة_خطأ_قاتل(عنوان_خطأ، كود_خطأ)
نهاية

# ============================================================
# تسجيل معالج مخصص
# ============================================================

# تسجيل معالج خطأ صفحة مخصص لنطاق عناوين
دالة تسجيل_معالج_خطأ(عنوان_بداية، عنوان_نهاية، فئة_مطلوبة)
    إذا (عدد_معالجات_مسجلة >= ثابت_اقصى_معالجات)
        ارجع 0
    نهاية
    
    متغير عنوان_سجل = عنوان_جدول_معالجات + عدد_معالجات_مسجلة * ثابت_مقاس_سجل_معالج * 4
    mem_write_dword(عنوان_سجل، عنوان_بداية)
    mem_write_dword(عنوان_سجل + 4، عنوان_نهاية)
    mem_write_dword(عنوان_سجل + 8، فئة_مطلوبة)
    mem_write_dword(عنوان_سجل + 12، 0)
    
    عدد_معالجات_مسجلة = عدد_معالجات_مسجلة + 1
    ارجع 1
نهاية

