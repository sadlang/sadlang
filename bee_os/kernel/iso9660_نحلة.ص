متغير iso_مهيأ_0 = 0
متغير iso_قرص_رقم_0 = 0             # رقم القرص في النظام
متغير iso_مقاس_فضاء_0 = 0           # VolumeSpaceSize (عدد القطاعات)
متغير iso_مقاس_كتلة_0 = 2048        # Logical Block Size
متغير iso_مقاس_جدول_مسار_0 = 0      # Path Table Size
متغير iso_موقع_جدول_مسار_0 = 0      # Location of Path Table (Type L)
متغير iso_موقع_جذر_0 = 0            # موقع مدخل الجذر (LBA)
متغير iso_مقاس_جذر_0 = 0            # مقاس بيانات الجذر
متغير iso_يدعم_joliet_0 = 0         # Joliet support detected

#* ── بيانات القرص 1 ── *#
متغير iso_مهيأ_1 = 0
متغير iso_قرص_رقم_1 = 0
متغير iso_مقاس_فضاء_1 = 0
متغير iso_مقاس_كتلة_1 = 2048
متغير iso_مقاس_جدول_مسار_1 = 0
متغير iso_موقع_جدول_مسار_1 = 0
متغير iso_موقع_جذر_1 = 0
متغير iso_مقاس_جذر_1 = 0
متغير iso_يدعم_joliet_1 = 0

# ── ذاكرة مؤقتة (قطاع واحد) ──
متغير iso_ذاكرة_مؤقتة_0 = 0         # عنوان المخزن
متغير iso_قطاع_مؤقت_0 = -1          # آخر قطاع مقروء
متغير iso_ذاكرة_مؤقتة_1 = 0
متغير iso_قطاع_مؤقت_1 = -1

# إحصائيات
متغير iso_قراءات_قطاعات = 0
متغير iso_إصابات_ذاكرة = 0          # cache hits
متغير iso_ملفات_محللة = 0

# ══════════════════════════════════════════════
# القسم 2: قراءة قطاع مع تخزين مؤقت
# ══════════════════════════════════════════════

#* ── قراءة قطاع ISO مع cache ──
   أقراص CD تستخدم قطاعات 2048 بايت
   نقرأ 4 قطاعات ATA (512*4 = 2048)
*#
صدّر دالة iso_اقرأ_قطاع(فهرس، قرص، قطاع_iso، مخزن_هدف)
    # تحقق من الذاكرة المؤقتة
    إذا (فهرس == 0)
        إذا (iso_قطاع_مؤقت_0 == قطاع_iso)
            إذا (iso_ذاكرة_مؤقتة_0 != 0)
                iso_إصابات_ذاكرة = iso_إصابات_ذاكرة + 1
                # نسخ من الذاكرة المؤقتة
                متغير ع = 0
                بينما (ع < 2048)
                    متغير ب = mem_read_byte(iso_ذاكرة_مؤقتة_0 + ع)
                    mem_write_byte(مخزن_هدف + ع، ب)
                    ع = ع + 1
                نهاية
                ارجع 0
            نهاية
        نهاية
    نهاية
    
    # قراءة من القرص: 4 قطاعات ATA
    متغير قطاع_ata = قطاع_iso * 4
    disk_read_sector(قرص، قطاع_ata، مخزن_هدف)
    disk_read_sector(قرص، قطاع_ata + 1، مخزن_هدف + 512)
    disk_read_sector(قرص، قطاع_ata + 2، مخزن_هدف + 1024)
    disk_read_sector(قرص، قطاع_ata + 3، مخزن_هدف + 1536)
    
    iso_قراءات_قطاعات = iso_قراءات_قطاعات + 1
    
    # تحديث الذاكرة المؤقتة
    إذا (فهرس == 0)
        إذا (iso_ذاكرة_مؤقتة_0 == 0)
            iso_ذاكرة_مؤقتة_0 = kernel_allocate(2048)
        نهاية
        إذا (iso_ذاكرة_مؤقتة_0 != 0)
            متغير ع2 = 0
            بينما (ع2 < 2048)
                متغير ب2 = mem_read_byte(مخزن_هدف + ع2)
                mem_write_byte(iso_ذاكرة_مؤقتة_0 + ع2، ب2)
                ع2 = ع2 + 1
            نهاية
            iso_قطاع_مؤقت_0 = قطاع_iso
        نهاية
    نهاية
    
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# القسم 3: تهيئة — قراءة PVD
# ══════════════════════════════════════════════

#* ── تهيئة قرص ISO ──
   يقرأ الـ PVD ويستخرج معلومات القرص
*#
صدّر دالة iso_هيّئ(فهرس، قرص)
    # تخصيص مخزن 2048 بايت
    متغير مخزن = kernel_allocate(2048)
    إذا (مخزن == 0)
        kernel_print_string("  [iso] ERROR: cannot allocate buffer")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    # قراءة PVD (القطاع 16)
    iso_اقرأ_قطاع(فهرس، قرص، iso_قطاع_pvd، مخزن)
    
    # التحقق من التوقيع "CD001" (الإزاحة 1-5)
    متغير ت1 = mem_read_byte(مخزن + 1)     # C = 67
    متغير ت2 = mem_read_byte(مخزن + 2)     # D = 68
    متغير ت3 = mem_read_byte(مخزن + 3)     # 0 = 48
    متغير ت4 = mem_read_byte(مخزن + 4)     # 0 = 48
    متغير ت5 = mem_read_byte(مخزن + 5)     # 1 = 49
    
    إذا (ت1 != 67)
        kernel_print_string("  [iso] ERROR: invalid CD001 signature")
        kernel_print_number(10)
        kernel_free(مخزن)
        ارجع -1
    نهاية
    إذا (ت2 != 68)
        kernel_print_string("  [iso] ERROR: invalid CD001 (2)")
        kernel_print_number(10)
        kernel_free(مخزن)
        ارجع -1
    نهاية
    
    # التحقق من النوع = 1 (PVD)
    متغير واصف_قسم = mem_read_byte(مخزن)
    إذا (واصف_قسم != 1)
        kernel_print_string("  [iso] WARNING: not PVD type=")
        kernel_print_number(واصف_قسم)
        kernel_print_number(10)
    نهاية
    
    # قراءة الحقول
    # Volume Space Size (الإزاحة 80): little-endian 32-bit
    متغير فضاء_مقاس = mem_read_dword(مخزن + 80)
    
    # Logical Block Size (الإزاحة 128): little-endian 16-bit
    متغير كتلة_مقاس = mem_read_word(مخزن + 128)
    
    # Path Table Size (الإزاحة 132): little-endian 32-bit
    متغير جدول_مقاس = mem_read_dword(مخزن + 132)
    
    # Path Table Location (الإزاحة 140): little-endian 32-bit
    متغير جدول_موقع = mem_read_dword(مخزن + 140)
    
    # Root Directory Record (الإزاحة 156-189)
    # الإزاحة 156+2: Location of Extent (LE 32-bit)
    # الإزاحة 156+10: Data Length (LE 32-bit)
    متغير جذر_موقع = mem_read_dword(مخزن + 158)
    متغير جذر_مقاس = mem_read_dword(مخزن + 166)
    
    # تخزين البيانات
    إذا (فهرس == 0)
        iso_مهيأ_0 = 1
        iso_قرص_رقم_0 = قرص
        iso_مقاس_فضاء_0 = فضاء_مقاس
        iso_مقاس_كتلة_0 = كتلة_مقاس
        iso_مقاس_جدول_مسار_0 = جدول_مقاس
        iso_موقع_جدول_مسار_0 = جدول_موقع
        iso_موقع_جذر_0 = جذر_موقع
        iso_مقاس_جذر_0 = جذر_مقاس
    نهاية
    إذا (فهرس == 1)
        iso_مهيأ_1 = 1
        iso_قرص_رقم_1 = قرص
        iso_مقاس_فضاء_1 = فضاء_مقاس
        iso_مقاس_كتلة_1 = كتلة_مقاس
        iso_مقاس_جدول_مسار_1 = جدول_مقاس
        iso_موقع_جدول_مسار_1 = جدول_موقع
        iso_موقع_جذر_1 = جذر_موقع
        iso_مقاس_جذر_1 = جذر_مقاس
    نهاية
    
    kernel_print_string("    iso9660: space=")
    kernel_print_number(فضاء_مقاس)
    kernel_print_string(" blk=")
    kernel_print_number(كتلة_مقاس)
    kernel_print_string(" root@")
    kernel_print_number(جذر_موقع)
    kernel_print_number(10)
    
    kernel_free(مخزن)
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# القسم 4: قراءة مدخل دليل
# ══════════════════════════════════════════════

#* ── تحليل مدخل دليل ISO ──
   يأخذ عنوان بداية المدخل في الذاكرة
   يوفر: الطول، الموقع، المقاس، الأعلام
*#

متغير iso_آخر_طول_مدخل = 0
متغير iso_آخر_موقع_مدى = 0
متغير iso_آخر_مقاس_بيانات = 0
متغير iso_آخر_أعلام = 0
متغير iso_آخر_طول_اسم = 0

صدّر دالة iso_حلل_مدخل(عنوان_مدخل)
    # الإزاحة 0: Record Length
    iso_آخر_طول_مدخل = mem_read_byte(عنوان_مدخل)
    
    # مدخل فارغ
    إذا (iso_آخر_طول_مدخل == 0)
        ارجع 0
    نهاية
    
    # الإزاحة 2: Location of Extent (LE 32-bit)
    iso_آخر_موقع_مدى = mem_read_dword(عنوان_مدخل + 2)
    
    # الإزاحة 10: Data Length (LE 32-bit)
    iso_آخر_مقاس_بيانات = mem_read_dword(عنوان_مدخل + 10)
    
    # الإزاحة 25: File Flags
    iso_آخر_أعلام = mem_read_byte(عنوان_مدخل + 25)
    
    # الإزاحة 32: File Identifier Length
    iso_آخر_طول_اسم = mem_read_byte(عنوان_مدخل + 32)
    
    iso_ملفات_محللة = iso_ملفات_محللة + 1
    ارجع iso_آخر_طول_مدخل
نهاية

#* ── هل المدخل دليل؟ ── *#
صدّر دالة iso_هل_دليل(أعلام)
    # بت 1 = دليل (القيمة 2)
    # نفحص إذا كان العلم يحتوي على بت الدليل
    متغير باقي = أعلام / 2
    متغير مضروب = باقي * 2
    متغير بت_فردي = أعلام - مضروب
    # لو الرقم فردي بعد القسمة على 2، البت 1 مفعّل
    # لكن نحتاج بت 1 وليس بت 0
    # أعلام: b7 b6 b5 b4 b3 b2 b1 b0
    # بت 1 (دليل) = (أعلام / 2) % 2
    متغير ق2 = أعلام / 2
    متغير ق2_نصف = ق2 / 2
    متغير ق2_مضروب = ق2_نصف * 2
    متغير بت_دليل = ق2 - ق2_مضروب
    ارجع بت_دليل
نهاية

# ══════════════════════════════════════════════
# القسم 5: عرض محتويات الجذر
# ══════════════════════════════════════════════

#* ── عرض مدخلات دليل الجذر ── *#
صدّر دالة iso_اعرض_جذر(فهرس)
    متغير موقع_جذر = 0
    متغير مقاس_جذر = 0
    متغير قرص = 0
    
    إذا (فهرس == 0)
        إذا (iso_مهيأ_0 == 0) ارجع -1 نهاية
        موقع_جذر = iso_موقع_جذر_0
        مقاس_جذر = iso_مقاس_جذر_0
        قرص = iso_قرص_رقم_0
    نهاية
    إذا (فهرس == 1)
        إذا (iso_مهيأ_1 == 0) ارجع -1 نهاية
        موقع_جذر = iso_موقع_جذر_1
        مقاس_جذر = iso_مقاس_جذر_1
        قرص = iso_قرص_رقم_1
    نهاية
    
    متغير مخزن = kernel_allocate(2048)
    إذا (مخزن == 0) ارجع -1 نهاية
    
    iso_اقرأ_قطاع(فهرس، قرص، موقع_جذر، مخزن)
    
    kernel_print_string("  ISO root entries:")
    kernel_print_number(10)
    
    متغير إزاحة = 0
    متغير عدد = 0
    بينما (إزاحة < مقاس_جذر)
        إذا (إزاحة >= 2048) اخرج نهاية
        
        متغير طول = iso_حلل_مدخل(مخزن + إزاحة)
        إذا (طول == 0) اخرج نهاية
        
        # تخطي . و ..
        إذا (عدد >= 2)
            kernel_print_string("    [")
            kernel_print_number(عدد)
            kernel_print_string("] LBA=")
            kernel_print_number(iso_آخر_موقع_مدى)
            kernel_print_string(" size=")
            kernel_print_number(iso_آخر_مقاس_بيانات)
            
            متغير هل_دليل = iso_هل_دليل(iso_آخر_أعلام)
            إذا (هل_دليل == 1)
                kernel_print_string(" [DIR]")
            نهاية
            kernel_print_number(10)
        نهاية
        
        إزاحة = إزاحة + طول
        عدد = عدد + 1
    نهاية
    
    kernel_print_string("  Total entries: ")
    kernel_print_number(عدد)
    kernel_print_number(10)
    
    kernel_free(مخزن)
    ارجع عدد
نهاية

