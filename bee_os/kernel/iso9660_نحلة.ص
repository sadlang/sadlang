        kernel_print_string(" root@")
        kernel_print_number(iso_موقع_جذر_0)
        kernel_print_number(10)
    نهاية
    
    kernel_print_string("  Sectors read: ")
    kernel_print_number(iso_قراءات_قطاعات)
    kernel_print_string("  Cache hits: ")
    kernel_print_number(iso_إصابات_ذاكرة)
    kernel_print_number(10)
    kernel_print_string("  Entries parsed: ")
    kernel_print_number(iso_ملفات_محللة)
    kernel_print_number(10)
    ارجع 0
نهاية

