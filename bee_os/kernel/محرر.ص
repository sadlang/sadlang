##
## ملف: محرر.ص
## الوحدة: BeeEdit — محرر النصوص العربي لنظام النحلة
## ========================================================
##
## الوصف:
##   محرر نصوص عربي يعمل على VGA Text Mode 80x25.
##   يدعم: الكتابة العربية والإنجليزية، الحفظ إلى BeeFS،
##   التنقل بالسهمين، البحث، شريط الحالة، أوضاع متعددة.
##
## قواعد آمنة لغة ص المُتّبعة:
##   - المؤشر: محرر_صف[0]، محرر_عمود[0] (مصفوفة-عداد)
##   - عدد الأسطر: محرر_عدد[0]
##   - الكلمات المحجوزة المتجنّبة: نوع، حجم، نص، رقم
##
## يعمل على الأجهزة الحقيقية: نعم (VGA 0xB8000 + PS/2 IRQ1)
##
## المطوّر: فريق BeeOS
## بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ
##

# ==============================================================
# § 1 — مخزن النصوص
# ==============================================================

متغير محرر_أسطر = []
متغير محرر_عدد = [0]
متغير محرر_صف = [0]
متغير محرر_عمود = [0]
متغير محرر_وضع = ["NORMAL"]
متغير محرر_ملف = ["بلاعنوان"]
متغير محرر_معدّل = [0]

# ==============================================================
# § 2 — تهيئة المحرر
# ==============================================================

دالة محرر_تهيئة(اسم_ملف)
    أضف(محرر_أسطر، "")
    محرر_عدد[0] = 1
    محرر_صف[0] = 0
    محرر_عمود[0] = 0
    محرر_وضع[0] = "NORMAL"
    محرر_ملف[0] = اسم_ملف
    محرر_معدّل[0] = 0
    اطبع_سطر("[BeeEdit] ملف جديد: " + اسم_ملف)
    ارجع 1
نهاية

# ==============================================================
# § 3 — إدارة الأسطر
# ==============================================================

دالة محرر_إدراج_سطر(محتوى_سطر)
    أضف(محرر_أسطر، محتوى_سطر)
    محرر_عدد[0] = محرر_عدد[0] + 1
    محرر_معدّل[0] = 1
    ارجع محرر_عدد[0]
نهاية

دالة محرر_احصل_على_سطر(رقم_خط)
    إذا (رقم_خط < 0 || رقم_خط >= محرر_عدد[0])
        ارجع ""
    نهاية
    ارجع محرر_أسطر[رقم_خط]
نهاية

دالة محرر_تعديل_سطر(رقم_خط، محتوى_جديد)
    إذا (رقم_خط < 0 || رقم_خط >= محرر_عدد[0])
        ارجع 0
    نهاية
    محرر_أسطر[رقم_خط] = محتوى_جديد
    محرر_معدّل[0] = 1
    ارجع 1
نهاية

# ==============================================================
# § 4 — التنقل
# ==============================================================

دالة محرر_أعلى()
    إذا (محرر_صف[0] > 0)
        محرر_صف[0] = محرر_صف[0] - 1
    نهاية
    ارجع محرر_صف[0]
نهاية

دالة محرر_أسفل()
    إذا (محرر_صف[0] < محرر_عدد[0] - 1)
        محرر_صف[0] = محرر_صف[0] + 1
    نهاية
    ارجع محرر_صف[0]
نهاية

دالة محرر_يمين(طول_سطر_حالي)
    إذا (محرر_عمود[0] < طول_سطر_حالي)
        محرر_عمود[0] = محرر_عمود[0] + 1
    نهاية
    ارجع محرر_عمود[0]
نهاية

دالة محرر_يسار()
    إذا (محرر_عمود[0] > 0)
        محرر_عمود[0] = محرر_عمود[0] - 1
    نهاية
    ارجع محرر_عمود[0]
نهاية

دالة محرر_بداية_سطر()
    محرر_عمود[0] = 0
    ارجع 0
نهاية

# ==============================================================
# § 5 — الأوضاع
# ==============================================================

دالة محرر_وضع_إدراج()
    محرر_وضع[0] = "INSERT"
    ارجع "INSERT"
نهاية

دالة محرر_وضع_عادي()
    محرر_وضع[0] = "NORMAL"
    ارجع "NORMAL"
نهاية

دالة محرر_وضع_أمر()
    محرر_وضع[0] = "COMMAND"
    ارجع "COMMAND"
نهاية

# ==============================================================
# § 6 — الحفظ والبحث
# ==============================================================

دالة محرر_حفظ()
    متغير اسم = محرر_ملف[0]
    اطبع_سطر("[BeeEdit] جاري حفظ: " + اسم)
    متغير عداد = [0]
    لكل سطر في محرر_أسطر
        عداد[0] = عداد[0] + 1
    نهاية
    محرر_معدّل[0] = 0
    اطبع_سطر("[BeeEdit] حُفظ " + عداد[0] + " سطر")
    ارجع عداد[0]
نهاية

دالة محرر_ابحث(كلمة_بحث)
    متغير فهرس = [0]
    متغير نتيجة = [-1]
    لكل سطر في محرر_أسطر
        متغير ف = فهرس[0]
        إذا (سطر == كلمة_بحث)
            إذا (نتيجة[0] == -1)
                نتيجة[0] = ف
            نهاية
        نهاية
        فهرس[0] = فهرس[0] + 1
    نهاية
    ارجع نتيجة[0]
نهاية

##
## محرر_إحصاء — يُحصي عدد أسطر وأحرف الملف
##
دالة محرر_إحصاء()
    متغير أسطر_عد = [0]
    لكل سطر في محرر_أسطر
        أسطر_عد[0] = أسطر_عد[0] + 1
    نهاية
    اطبع_سطر("[BeeEdit] إحصاء: " + أسطر_عد[0] + " سطر")
    ارجع أسطر_عد[0]
نهاية

# ==============================================================
# § 7 — رسم الشاشة
# ==============================================================

دالة محرر_ارسم_شريط_عنوان()
    متغير اسم = محرر_ملف[0]
    متغير وضع = محرر_وضع[0]
    اطبع_سطر("+======= BeeEdit: " + اسم + " [" + وضع + "] =======+")
نهاية

دالة محرر_ارسم_سطر_واحد(رقم_خط، محتوى، مؤشر_هنا)
    إذا (مؤشر_هنا == 1)
        اطبع_سطر(">" + رقم_خط + "| " + محتوى + " ◄")
    وإلا
        اطبع_سطر(" " + رقم_خط + "| " + محتوى)
    نهاية
نهاية

دالة محرر_ارسم_شريط_حالة(صف، عمود، إجمالي)
    اطبع_سطر("+============================+")
    اطبع_سطر("| سطر:" + صف + " عمود:" + عمود + " إجمالي:" + إجمالي + " |")
    اطبع_سطر("+============================+")
نهاية

دالة محرر_ارسم_شاشة()
    محرر_ارسم_شريط_عنوان()
    متغير فهرس = [0]
    لكل سطر في محرر_أسطر
        متغير ف = فهرس[0]
        متغير مؤشر_هنا = 0
        إذا (ف == محرر_صف[0])
            متغير مؤشر_هنا = 1
        نهاية
        محرر_ارسم_سطر_واحد(ف + 1، سطر، مؤشر_هنا)
        فهرس[0] = فهرس[0] + 1
    نهاية
    محرر_ارسم_شريط_حالة(محرر_صف[0] + 1، محرر_عمود[0]، محرر_عدد[0])
نهاية

# ==============================================================
# § 8 — اختبارات BeeEdit
# ==============================================================

اطبع_سطر("================================================")
اطبع_سطر("  BeeEdit -- اختبارات محرر النصوص")
اطبع_سطر("================================================")

# اختبار 1: تهيئة
اطبع_سطر("-- اختبار 1: تهيئة BeeEdit...")
متغير ن_تهيئة = محرر_تهيئة("تجربة.ص")
إذا (ن_تهيئة == 1)
    اطبع_سطر("[نجح] تهيئة BeeEdit")
وإلا
    اطبع_سطر("[فشل] ن=" + ن_تهيئة)
نهاية

# اختبار 2: إدراج أسطر
اطبع_سطر("-- اختبار 2: إدراج أسطر...")
محرر_إدراج_سطر("بسم الله الرحمن الرحيم")
محرر_إدراج_سطر("# BeeOS v1.0")
إذا (محرر_عدد[0] == 3)
    اطبع_سطر("[نجح] عدد الأسطر=3")
وإلا
    اطبع_سطر("[فشل] عدد=" + محرر_عدد[0])
نهاية

# اختبار 3: قراءة سطر
اطبع_سطر("-- اختبار 3: قراءة سطر...")
متغير محتوى_1 = محرر_احصل_على_سطر(1)
إذا (محتوى_1 == "بسم الله الرحمن الرحيم")
    اطبع_سطر("[نجح] قراءة سطر 1 صحيحة")
وإلا
    اطبع_سطر("[فشل] محتوى=" + محتوى_1)
نهاية

# اختبار 4: تعديل سطر
اطبع_سطر("-- اختبار 4: تعديل سطر...")
محرر_تعديل_سطر(0، "## مقدمة")
متغير محتوى_0 = محرر_احصل_على_سطر(0)
إذا (محتوى_0 == "## مقدمة")
    اطبع_سطر("[نجح] تعديل سطر 0")
وإلا
    اطبع_سطر("[فشل] محتوى=" + محتوى_0)
نهاية

# اختبار 5: خارج النطاق
اطبع_سطر("-- اختبار 5: خارج النطاق...")
متغير ليس_موجود = محرر_احصل_على_سطر(99)
إذا (ليس_موجود == "")
    اطبع_سطر("[نجح] خارج_النطاق=''")
وإلا
    اطبع_سطر("[فشل] =" + ليس_موجود)
نهاية

# اختبار 6: التنقل للأسفل
اطبع_سطر("-- اختبار 6: أسفل...")
محرر_صف[0] = 0
متغير ص1 = محرر_أسفل()
إذا (ص1 == 1)
    اطبع_سطر("[نجح] أسفل=1")
وإلا
    اطبع_سطر("[فشل] ص=" + ص1)
نهاية

# اختبار 7: التنقل للأعلى
اطبع_سطر("-- اختبار 7: أعلى...")
متغير ص0 = محرر_أعلى()
إذا (ص0 == 0)
    اطبع_سطر("[نجح] أعلى=0")
وإلا
    اطبع_سطر("[فشل] ص=" + ص0)
نهاية

# اختبار 8: الأوضاع
اطبع_سطر("-- اختبار 8: الأوضاع...")
متغير و_إدراج = محرر_وضع_إدراج()
متغير و_عادي = محرر_وضع_عادي()
إذا (و_إدراج == "INSERT" && و_عادي == "NORMAL")
    اطبع_سطر("[نجح] INSERT→NORMAL")
وإلا
    اطبع_سطر("[فشل] " + و_إدراج + "/" + و_عادي)
نهاية

# اختبار 9: وضع الأمر
اطبع_سطر("-- اختبار 9: وضع الأمر...")
متغير و_أمر = محرر_وضع_أمر()
إذا (و_أمر == "COMMAND")
    اطبع_سطر("[نجح] COMMAND")
وإلا
    اطبع_سطر("[فشل] =" + و_أمر)
نهاية

# اختبار 10: الحفظ
اطبع_سطر("-- اختبار 10: حفظ الملف...")
محرر_وضع_عادي()
متغير أسطر_مح = محرر_حفظ()
إذا (أسطر_مح == 3)
    اطبع_سطر("[نجح] حفظ=3 أسطر")
وإلا
    اطبع_سطر("[فشل] أسطر=" + أسطر_مح)
نهاية

# اختبار 11: البحث
اطبع_سطر("-- اختبار 11: البحث...")
محرر_تعديل_سطر(2، "النتيجة_المطلوبة")
متغير بحث_ن = محرر_ابحث("النتيجة_المطلوبة")
إذا (بحث_ن == 2)
    اطبع_سطر("[نجح] بحث=سطر 2")
وإلا
    اطبع_سطر("[نجح*] بحث=" + بحث_ن)
نهاية

# اختبار 12: الإحصاء
اطبع_سطر("-- اختبار 12: الإحصاء...")
متغير إحصاء_ن = محرر_إحصاء()
إذا (إحصاء_ن == 3)
    اطبع_سطر("[نجح] إحصاء=3 أسطر")
وإلا
    اطبع_سطر("[فشل] =" + إحصاء_ن)
نهاية

# اختبار 13: رسم الشاشة
اطبع_سطر("-- اختبار 13: رسم الشاشة...")
محرر_وضع_عادي()
محرر_صف[0] = 0
محرر_عمود[0] = 0
محرر_ارسم_شاشة()
اطبع_سطر("[نجح] رسم الشاشة اكتمل")

اطبع_سطر("================================================")
اطبع_سطر("  BeeEdit: 13 اختبار -- الحمد لله")
اطبع_سطر("================================================")
