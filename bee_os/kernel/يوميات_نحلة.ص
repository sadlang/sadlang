    إذا (وضعية_معاملة_حالية == معاملة_نشطة)
        kernel_print_string("  [journal] ERROR: transaction already active")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    عداد_معاملات = عداد_معاملات + 1
    معاملة_حالية = عداد_معاملات + 0
    وضعية_معاملة_حالية = معاملة_نشطة
    
    ارجع معاملة_حالية
نهاية

#* تسجيل عملية في اليوميات
   المعاملات: صنف العملية، رقم الكتلة
   ترجع: فهرس المدخل أو -1 *#
صدّر دالة يوميات_سجّل(صنف_عملية، رقم_كتلة)
    إذا (وضعية_معاملة_حالية != معاملة_نشطة)
        kernel_print_string("  [journal] ERROR: no active transaction")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    # البحث عن خانة فارغة
    متغير فهرس = مؤشر_مدخل + 0
    إذا (فهرس >= 16)
        فهرس = 0
    نهاية
    
    اكتب_مدخل(فهرس، مدخل_معلق، صنف_عملية، معاملة_حالية، رقم_كتلة)
    مؤشر_مدخل = فهرس + 1
    عداد_مدخلات_كلي = عداد_مدخلات_كلي + 1
    
    ارجع فهرس
نهاية

#* التزام المعاملة الحالية (commit)
   ترجع: 0 عند النجاح *#
صدّر دالة يوميات_التزم()
    إذا (وضعية_معاملة_حالية != معاملة_نشطة)
        ارجع -1
    نهاية
    
    # تعليم جميع مدخلات المعاملة كملتزمة
    متغير خ = 0
    بينما (خ < 16)
        متغير وض = اقرأ_يوم_وضعية(خ)
        إذا (وض == مدخل_معلق)
            عيّن_يوم_وضعية(خ، مدخل_ملتزم)
