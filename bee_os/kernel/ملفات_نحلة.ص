## تخصيص كتلة حرة في مجموعة محددة
## يُعيد: رقم الكتلة المطلقة أو -1
دالة خصص_كتلة_في_مجموعة(رقم_التحميل، رقم_المجموعة)
    # قراءة خريطة بت الكتل
    متغير كتلة_الخريطة = كتلة_خريطة_الكتل(رقم_التحميل، رقم_المجموعة)
    متغير نتيجة = اقرأ_كتلة_FS(رقم_التحميل، كتلة_الخريطة، عنوان_مخزن2)
    إذا (نتيجة != 0)
        ارجع -1
    نهاية
    
    # البحث عن بت حر
    متغير كتل_المجموعة = sb_كتل_لكل_مجموعة[رقم_التحميل]
    متغير بت_حر = ابحث_بت_حر(عنوان_مخزن2، كتل_المجموعة)
    إذا (بت_حر < 0)
        ارجع -1
    نهاية
    
    # تعيين البت
    عيّن_بت(عنوان_مخزن2، بت_حر)
    
    # كتابة خريطة البت المحدثة
    اكتب_كتلة_FS(رقم_التحميل، كتلة_الخريطة، عنوان_مخزن2)
    
    # تحديث عدد الكتل الحرة
    sb_كتل_حرة[رقم_التحميل] = sb_كتل_حرة[رقم_التحميل] - 1
    
    # حساب رقم الكتلة المطلقة
    متغير كتلة_مطلقة = كتلة_بداية_مجموعة(رقم_التحميل، رقم_المجموعة) + بت_حر
    ارجع كتلة_مطلقة
نهاية

## تخصيص كتلة حرة (تلقائي — يبحث في جميع المجموعات)
صدّر دالة خصص_كتلة(رقم_التحميل)
    إذا (sb_كتل_حرة[رقم_التحميل] == 0)
        ارجع -1
    نهاية
    
    متغير مج = 0
    بينما (مج < sb_عدد_مجموعات[رقم_التحميل])
        متغير كتلة = خصص_كتلة_في_مجموعة(رقم_التحميل، مج)
        إذا (كتلة >= 0)
            ارجع كتلة
        نهاية
        مج = مج + 1
    نهاية
    ارجع -1
نهاية

## تحرير كتلة
صدّر دالة حرر_كتلة(رقم_التحميل، رقم_الكتلة)
    # تحديد المجموعة
    متغير رقم_المجموعة = رقم_الكتلة / sb_كتل_لكل_مجموعة[رقم_التحميل]
    متغير البت = رقم_الكتلة % sb_كتل_لكل_مجموعة[رقم_التحميل]
    
    # قراءة خريطة البت
    متغير كتلة_الخريطة = كتلة_خريطة_الكتل(رقم_التحميل، رقم_المجموعة)
    متغير نتيجة = اقرأ_كتلة_FS(رقم_التحميل، كتلة_الخريطة، عنوان_مخزن2)
    إذا (نتيجة != 0)
        ارجع -1
    نهاية
    
    # مسح البت
    امسح_بت(عنوان_مخزن2، البت)
    
    # كتابة خريطة البت
    اكتب_كتلة_FS(رقم_التحميل، كتلة_الخريطة، عنوان_مخزن2)
    
    sb_كتل_حرة[رقم_التحميل] = sb_كتل_حرة[رقم_التحميل] + 1
    
    ارجع 0
نهاية

