## القسم ٣: حالة نظام الملفات المحمّل
## ═══════════════════════════════════════════════════════════════

## نقاط التحميل — كل نقطة تحميل تمثل نظام ملفات محمّل
متغير mount_فهرس_القرص = [0، 0، 0، 0]
متغير mount_رقم_القسم = [0، 0، 0، 0]   # رقم القسم أو -1 للقرص كامل
متغير mount_نشط = [0، 0، 0، 0]
متغير mount_قطاع_البداية = [0، 0، 0، 0]  # أول قطاع من القسم

## بيانات الكتلة الفائقة لكل نقطة تحميل
متغير sb_سحري = [0، 0، 0، 0]
متغير sb_إصدار = [0، 0، 0، 0]
متغير sb_إجمالي_كتل = [0، 0، 0، 0]
متغير sb_إجمالي_عقد = [0، 0، 0، 0]
متغير sb_كتل_حرة = [0، 0، 0، 0]
متغير sb_عقد_حرة = [0، 0، 0، 0]
متغير sb_حجم_كتلة = [0، 0، 0، 0]
متغير sb_حجم_عقدة = [0، 0، 0، 0]
متغير sb_كتل_لكل_مجموعة = [0، 0، 0، 0]
متغير sb_عقد_لكل_مجموعة = [0، 0، 0، 0]
متغير sb_عدد_مجموعات = [0، 0، 0، 0]
متغير sb_حالة_نظام = [0، 0، 0، 0]

## مخزن مؤقت للعمليات (صفحة 4KB)
متغير عنوان_مخزن_مؤقت = 0
## مخزن إضافي
متغير عنوان_مخزن2 = 0

## عدد نقاط التحميل النشطة
متغير عدد_التحميلات = 0

## ═══════════════════════════════════════════════════════════════
## القسم ٤: تهيئة نظام الملفات
## ═══════════════════════════════════════════════════════════════

صدّر دالة هيئ_نظام_الملفات()
    # تخصيص مخزنين مؤقتين
    عنوان_مخزن_مؤقت = fs_خصص_صفحة()
    إذا (عنوان_مخزن_مؤقت == 0)
        ارجع -1
    نهاية
    fs_املأ_ذاكرة(عنوان_مخزن_مؤقت، 0، 4096)
    
    عنوان_مخزن2 = fs_خصص_صفحة()
    إذا (عنوان_مخزن2 == 0)
        ارجع -1
    نهاية
    fs_املأ_ذاكرة(عنوان_مخزن2، 0، 4096)
    
    # إعادة تعيين نقاط التحميل
    متغير م = 0
    بينما (م < أقصى_تحميلات)
        mount_نشط[م] = 0
        م = م + 1
    نهاية
    عدد_التحميلات = 0
    
    fs_اكتب_حرف(COM1، 91)   # '['
    fs_اكتب_حرف(COM1، 70)   # 'F'
    fs_اكتب_حرف(COM1، 83)   # 'S'
    fs_اكتب_حرف(COM1، 93)   # ']'
    fs_اكتب_حرف(COM1، 32)
    fs_اكتب_حرف(COM1، 79)   # 'O'
    fs_اكتب_حرف(COM1، 75)   # 'K'
    fs_اكتب_حرف(COM1، 10)
    
    ارجع 0
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٥: تحويل عناوين الكتل إلى قطاعات
## ═══════════════════════════════════════════════════════════════

## تحويل رقم كتلة إلى رقم قطاع مطلق
دالة كتلة_إلى_قطاع(رقم_التحميل، رقم_الكتلة)
    # كل كتلة = 8 قطاعات
    ارجع mount_قطاع_البداية[رقم_التحميل] + (رقم_الكتلة * قطاعات_لكل_كتلة)
نهاية

## قراءة كتلة كاملة (4KB = 8 قطاعات)
دالة اقرأ_كتلة_FS(رقم_التحميل، رقم_الكتلة، عنوان_الوجهة)
    متغير قرص = mount_فهرس_القرص[رقم_التحميل]
    متغير قطاع = كتلة_إلى_قطاع(رقم_التحميل، رقم_الكتلة)
    
    # قراءة 8 قطاعات
    متغير ق = 0
    بينما (ق < قطاعات_لكل_كتلة)
        متغير نتيجة = القرص_اقرأ(قرص، قطاع + ق، عنوان_الوجهة + (ق * حجم_القطاع_FS))
        إذا (نتيجة != 0)
            ارجع -1
        نهاية
        ق = ق + 1
    نهاية
    ارجع 0
نهاية

## كتابة كتلة كاملة
دالة اكتب_كتلة_FS(رقم_التحميل، رقم_الكتلة، عنوان_المصدر)
    متغير قرص = mount_فهرس_القرص[رقم_التحميل]
    متغير قطاع = كتلة_إلى_قطاع(رقم_التحميل، رقم_الكتلة)
    
    متغير ق = 0
    بينما (ق < قطاعات_لكل_كتلة)
        متغير نتيجة = القرص_اكتب(قرص، قطاع + ق، عنوان_المصدر + (ق * حجم_القطاع_FS))
        إذا (نتيجة != 0)
            ارجع -1
        نهاية
        ق = ق + 1
    نهاية
    ارجع 0
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٦: قراءة/كتابة الكتلة الفائقة
## ═══════════════════════════════════════════════════════════════

## قراءة الكتلة الفائقة من القرص
## تقع في الكتلة 0 (أول 8 قطاعات)
دالة اقرأ_الكتلة_الفائقة(رقم_التحميل)
    # قراءة الكتلة 0
    متغير نتيجة = اقرأ_كتلة_FS(رقم_التحميل، 0، عنوان_مخزن_مؤقت)
    إذا (نتيجة != 0)
        ارجع -1
    نهاية
    
    # استخراج الحقول من البيانات
    sb_سحري[رقم_التحميل] = fs_اقرأ_ذاكرة32(عنوان_مخزن_مؤقت)
    sb_إصدار[رقم_التحميل] = fs_اقرأ_ذاكرة32(عنوان_مخزن_مؤقت + 4)
    sb_إجمالي_كتل[رقم_التحميل] = fs_اقرأ_ذاكرة(عنوان_مخزن_مؤقت + 8)
    sb_إجمالي_عقد[رقم_التحميل] = fs_اقرأ_ذاكرة(عنوان_مخزن_مؤقت + 16)
    sb_كتل_حرة[رقم_التحميل] = fs_اقرأ_ذاكرة(عنوان_مخزن_مؤقت + 24)
    sb_عقد_حرة[رقم_التحميل] = fs_اقرأ_ذاكرة(عنوان_مخزن_مؤقت + 32)
    sb_حجم_كتلة[رقم_التحميل] = fs_اقرأ_ذاكرة32(عنوان_مخزن_مؤقت + 40)
    sb_حجم_عقدة[رقم_التحميل] = fs_اقرأ_ذاكرة32(عنوان_مخزن_مؤقت + 44)
    sb_كتل_لكل_مجموعة[رقم_التحميل] = fs_اقرأ_ذاكرة32(عنوان_مخزن_مؤقت + 48)
    sb_عقد_لكل_مجموعة[رقم_التحميل] = fs_اقرأ_ذاكرة32(عنوان_مخزن_مؤقت + 52)
    sb_عدد_مجموعات[رقم_التحميل] = fs_اقرأ_ذاكرة32(عنوان_مخزن_مؤقت + 56)
    sb_حالة_نظام[رقم_التحميل] = fs_اقرأ_ذاكرة32(عنوان_مخزن_مؤقت + 60)
    
    ارجع 0
نهاية

## كتابة الكتلة الفائقة إلى القرص
دالة اكتب_الكتلة_الفائقة(رقم_التحميل)
    fs_املأ_ذاكرة(عنوان_مخزن_مؤقت، 0، 4096)
    
    fs_اكتب_ذاكرة32(عنوان_مخزن_مؤقت، sb_سحري[رقم_التحميل])
    fs_اكتب_ذاكرة32(عنوان_مخزن_مؤقت + 4، sb_إصدار[رقم_التحميل])
    fs_اكتب_ذاكرة(عنوان_مخزن_مؤقت + 8، sb_إجمالي_كتل[رقم_التحميل])
    fs_اكتب_ذاكرة(عنوان_مخزن_مؤقت + 16، sb_إجمالي_عقد[رقم_التحميل])
    fs_اكتب_ذاكرة(عنوان_مخزن_مؤقت + 24، sb_كتل_حرة[رقم_التحميل])
    fs_اكتب_ذاكرة(عنوان_مخزن_مؤقت + 32، sb_عقد_حرة[رقم_التحميل])
    fs_اكتب_ذاكرة32(عنوان_مخزن_مؤقت + 40، sb_حجم_كتلة[رقم_التحميل])
    fs_اكتب_ذاكرة32(عنوان_مخزن_مؤقت + 44، sb_حجم_عقدة[رقم_التحميل])
    fs_اكتب_ذاكرة32(عنوان_مخزن_مؤقت + 48، sb_كتل_لكل_مجموعة[رقم_التحميل])
    fs_اكتب_ذاكرة32(عنوان_مخزن_مؤقت + 52، sb_عقد_لكل_مجموعة[رقم_التحميل])
    fs_اكتب_ذاكرة32(عنوان_مخزن_مؤقت + 56، sb_عدد_مجموعات[رقم_التحميل])
    fs_اكتب_ذاكرة32(عنوان_مخزن_مؤقت + 60، sb_حالة_نظام[رقم_التحميل])
    
    # وقت الكتابة (نستخدم عداداً بسيطاً حالياً)
    fs_اكتب_ذاكرة32(عنوان_مخزن_مؤقت + 68، 0)
    
    # كتابة الكتلة 0
    ارجع اكتب_كتلة_FS(رقم_التحميل، 0، عنوان_مخزن_مؤقت)
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٧: بنية مجموعة الكتل (Block Group)
## ═══════════════════════════════════════════════════════════════
##
## كل مجموعة كتل تحتوي:
##   كتلة 0: نسخة الكتلة الفائقة (في المجموعة 0 فقط)
##   كتلة 1: واصف مجموعة الكتل (Block Group Descriptor Table)
##   كتلة 2: خريطة بت الكتل
##   كتلة 3: خريطة بت العقد
##   كتلة 4-N: جدول العقد
##   كتلة N+1...: كتل البيانات
##
## واصف المجموعة (32 بايت لكل مجموعة):
##   0-3:   كتلة خريطة بت الكتل
##   4-7:   كتلة خريطة بت العقد
##   8-11:  كتلة بداية جدول العقد
##   12-15: عدد الكتل الحرة في المجموعة
##   16-19: عدد العقد الحرة في المجموعة
##   20-23: عدد الأدلة في المجموعة
##   24-31: محجوز

## ─── إزاحات داخل مجموعة الكتل ───
ثابت BG_SUPERBLOCK  = 0  # كتلة الكتلة الفائقة
ثابت BG_DESCRIPTOR  = 1  # كتلة واصفات المجموعات
ثابت BG_BLOCK_BMP   = 2  # كتلة خريطة بت الكتل
ثابت BG_INODE_BMP   = 3  # كتلة خريطة بت العقد
ثابت BG_INODE_TABLE = 4  # بداية جدول العقد

## حساب كتلة بداية مجموعة
دالة كتلة_بداية_مجموعة(رقم_التحميل، رقم_المجموعة)
    ارجع رقم_المجموعة * sb_كتل_لكل_مجموعة[رقم_التحميل]
نهاية

## حساب كتلة خريطة بت الكتل لمجموعة
دالة كتلة_خريطة_الكتل(رقم_التحميل، رقم_المجموعة)
    ارجع كتلة_بداية_مجموعة(رقم_التحميل، رقم_المجموعة) + BG_BLOCK_BMP
نهاية

## حساب كتلة خريطة بت العقد لمجموعة
دالة كتلة_خريطة_العقد(رقم_التحميل، رقم_المجموعة)
    ارجع كتلة_بداية_مجموعة(رقم_التحميل، رقم_المجموعة) + BG_INODE_BMP
نهاية

## حساب كتلة بداية جدول العقد لمجموعة
