    متغير كتلة_الخريطة = كتلة_خريطة_العقد(رقم_التحميل، رقم_المجموعة)
    متغير نتيجة = اقرأ_كتلة_FS(رقم_التحميل، كتلة_الخريطة، عنوان_مخزن2)
