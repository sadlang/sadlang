        نهاية
        fs_اكتب_ذاكرة16(عنوان_القراءة، قيمة_البايت_lo + (قيمة_البايت_hi * 256))
    نهاية
نهاية

## البحث عن أول بت حر في خريطة
## يُعيد: رقم البت أو -1 إذا لم يُوجد
دالة ابحث_بت_حر(عنوان_الخريطة، عدد_البتات)
    متغير ب = 0
    بينما (ب < عدد_البتات)
        إذا (فحص_بت(عنوان_الخريطة، ب) == 0)
            ارجع ب
        نهاية
        ب = ب + 1
    نهاية
    ارجع -1
