## فحص بت في خريطة مُحمّلة في الذاكرة
## يُعيد: 0 أو 1
دالة فحص_بت(عنوان_الخريطة، رقم_البت)
    متغير بايت_الفهرس = رقم_البت / 8
    متغير بت_الإزاحة = رقم_البت % 8
    
    # قراءة البايت
    # نقرأ 16 بت ونأخذ البايت المطلوب
    متغير pair = fs_اقرأ_ذاكرة16(عنوان_الخريطة + (بايت_الفهرس - (بايت_الفهرس % 2)))
    متغير قيمة_البايت = pair
    إذا (بايت_الفهرس % 2 == 1)
        قيمة_البايت = pair / 256
    وإلا
        قيمة_البايت = pair % 256
    نهاية
    
    # استخراج البت
    متغير قناع = 1
    متغير ب = 0
    بينما (ب < بت_الإزاحة)
        قناع = قناع * 2
        ب = ب + 1
    نهاية
    
    إذا ((قيمة_البايت / قناع) % 2 == 1)
        ارجع 1
    نهاية
    ارجع 0
نهاية

## تعيين بت في خريطة محمّلة في الذاكرة
دالة عيّن_بت(عنوان_الخريطة، رقم_البت)
    متغير بايت_الفهرس = رقم_البت / 8
    متغير بت_الإزاحة = رقم_البت % 8
    
    متغير عنوان_القراءة = عنوان_الخريطة + (بايت_الفهرس - (بايت_الفهرس % 2))
    متغير pair = fs_اقرأ_ذاكرة16(عنوان_القراءة)
    
    متغير قيمة_البايت_lo = pair % 256
    متغير قيمة_البايت_hi = pair / 256
    
    متغير قناع = 1
    متغير ب = 0
    بينما (ب < بت_الإزاحة)
        قناع = قناع * 2
        ب = ب + 1
    نهاية
    
    إذا (بايت_الفهرس % 2 == 0)
        # البايت المنخفض
        إذا ((قيمة_البايت_lo / قناع) % 2 == 0)
            قيمة_البايت_lo = قيمة_البايت_lo + قناع
        نهاية
        fs_اكتب_ذاكرة16(عنوان_القراءة، قيمة_البايت_lo + (قيمة_البايت_hi * 256))
    وإلا
        # البايت العلوي
        إذا ((قيمة_البايت_hi / قناع) % 2 == 0)
            قيمة_البايت_hi = قيمة_البايت_hi + قناع
        نهاية
        fs_اكتب_ذاكرة16(عنوان_القراءة، قيمة_البايت_lo + (قيمة_البايت_hi * 256))
    نهاية
نهاية

## مسح بت في خريطة
دالة امسح_بت(عنوان_الخريطة، رقم_البت)
    متغير بايت_الفهرس = رقم_البت / 8
    متغير بت_الإزاحة = رقم_البت % 8
    
    متغير عنوان_القراءة = عنوان_الخريطة + (بايت_الفهرس - (بايت_الفهرس % 2))
    متغير pair = fs_اقرأ_ذاكرة16(عنوان_القراءة)
    
    متغير قيمة_البايت_lo = pair % 256
    متغير قيمة_البايت_hi = pair / 256
    
    متغير قناع = 1
    متغير ب = 0
    بينما (ب < بت_الإزاحة)
        قناع = قناع * 2
        ب = ب + 1
    نهاية
    
    إذا (بايت_الفهرس % 2 == 0)
        إذا ((قيمة_البايت_lo / قناع) % 2 == 1)
            قيمة_البايت_lo = قيمة_البايت_lo - قناع
        نهاية
        fs_اكتب_ذاكرة16(عنوان_القراءة، قيمة_البايت_lo + (قيمة_البايت_hi * 256))
    وإلا
        إذا ((قيمة_البايت_hi / قناع) % 2 == 1)
