خارجي("sad_ll_pages_free") دالة fs_حرر_صفحات(عنوان_الصفحات، عدد_الصفحات)

## واجهات طبقة الكاش (من قرص_cache_نحلة)
خارجي("blk_اقرأ") دالة القرص_اقرأ(فهرس_القرص، رقم_القطاع، عنوان_الوجهة)
خارجي("blk_اكتب") دالة القرص_اكتب(فهرس_القرص، رقم_القطاع، عنوان_المصدر)
خارجي("blk_اقرأ_متعدد") دالة القرص_اقرأ_متعدد(فهرس_القرص، رقم_القطاع، عدد_القطاعات، عنوان_الوجهة)
خارجي("blk_فرغ") دالة القرص_فرّغ()

