## تحميل نظام ملفات BeeFS
## يُعيد: رقم التحميل (0-3) أو -1
صدّر دالة حمّل_FS(فهرس_القرص، قطاع_البداية)
    # البحث عن نقطة تحميل فارغة
    متغير mt = -1
    متغير ف = 0
    بينما (ف < أقصى_تحميلات)
        إذا (mount_نشط[ف] == 0)
            mt = ف
            ف = أقصى_تحميلات
        نهاية
        ف = ف + 1
    نهاية
    إذا (mt < 0)
        ارجع -1
    نهاية
    
    # إعداد نقطة التحميل
    mount_فهرس_القرص[mt] = فهرس_القرص
    mount_قطاع_البداية[mt] = قطاع_البداية
    mount_نشط[mt] = 1
    
    # قراءة الكتلة الفائقة
    متغير نتيجة = اقرأ_الكتلة_الفائقة(mt)
    إذا (نتيجة != 0)
        mount_نشط[mt] = 0
        ارجع -1
    نهاية
    
    # فحص الرقم السحري
    إذا (sb_سحري[mt] != BEEFS_MAGIC)
        mount_نشط[mt] = 0
        ارجع -1
    نهاية
    
    # فحص الإصدار
    إذا (sb_إصدار[mt] != BEEFS_VERSION)
        mount_نشط[mt] = 0
        ارجع -1
    نهاية
    
    # تعيين الحالة كمعدل
    sb_حالة_نظام[mt] = 1
    اكتب_الكتلة_الفائقة(mt)
    
    عدد_التحميلات = عدد_التحميلات + 1
    
    # طباعة معلومات التحميل
    fs_اكتب_حرف(COM1، 91)
    fs_اكتب_حرف(COM1، 77)   # 'M'
    fs_اكتب_حرف(COM1، 78)   # 'N'
    fs_اكتب_حرف(COM1، 84)   # 'T'
    fs_اكتب_حرف(COM1، 93)
    fs_اكتب_حرف(COM1، 32)
    fs_اطبع_رقم(mt)
    fs_اكتب_حرف(COM1، 58)   # ':'
    fs_اطبع_رقم(sb_إجمالي_كتل[mt])
    fs_اكتب_حرف(COM1، 98)   # 'b'
    fs_اكتب_حرف(COM1، 32)
