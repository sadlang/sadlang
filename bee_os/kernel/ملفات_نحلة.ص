## ثوابت
## ─────────────────────────────────────────────────────
ثابت COM1 = 1016

## ─────────────────────────────────────────────────────
## طباعة تصحيح
## ─────────────────────────────────────────────────────
دالة fs_اطبع_رقم(القيمة)
    إذا (القيمة < 0)
        fs_اكتب_حرف(COM1، 45)
        fs_اطبع_رقم(0 - القيمة)
        ارجع
    نهاية
    إذا (القيمة >= 10)
        fs_اطبع_رقم(القيمة / 10)
    نهاية
    fs_اكتب_حرف(COM1، 48 + (القيمة % 10))
نهاية

