## القسم ١١: قراءة/كتابة العقد (Inodes)
## ═══════════════════════════════════════════════════════════════
##
## بنية العقدة (128 بايت):
##   0-1:   نوع الملف وأذونات (16 بت)
##   2-3:   عدد الروابط الصلبة (16 بت)
##   4-7:   معرف المالك (32 بت)
##   8-11:  معرف المجموعة (32 بت)
##   12-19: حجم الملف (64 بت)
##   20-23: وقت الإنشاء (32 بت)
##   24-27: وقت التعديل (32 بت)
##   28-31: وقت الوصول (32 بت)
##   32-35: مؤشر كتلة مباشر 0 (32 بت)
##   36-39: مؤشر كتلة مباشر 1
##   40-43: مؤشر كتلة مباشر 2
##   44-47: مؤشر كتلة مباشر 3
##   48-51: مؤشر كتلة مباشر 4
##   52-55: مؤشر كتلة مباشر 5
##   56-59: مؤشر كتلة مباشر 6
##   60-63: مؤشر كتلة مباشر 7
##   64-67: مؤشر كتلة مباشر 8
##   68-71: مؤشر كتلة مباشر 9
##   72-75: مؤشر كتلة مباشر 10
##   76-79: مؤشر كتلة مباشر 11
##   80-83: مؤشر غير مباشر أحادي (32 بت)
##   84-87: مؤشر غير مباشر ثنائي (32 بت)
##   88-91: مؤشر غير مباشر ثلاثي (32 بت)
##   92-95: عدد الكتل المحجوزة (32 بت)
##   96-99: أعلام (32 بت)
##  100-127: محجوز

## عدد المؤشرات المباشرة
ثابت عدد_مؤشرات_مباشرة = 12

## عدد المؤشرات في كتلة غير مباشرة (4096 / 4)
ثابت مؤشرات_في_كتلة = 1024

## حساب موقع عقدة على القرص
## يُعيد: (رقم_الكتلة, الإزاحة_داخل_الكتلة) — حالياً نُعيد الكتلة فقط
دالة كتلة_العقدة(رقم_التحميل، رقم_العقدة)
    متغير عقد_المجموعة = sb_عقد_لكل_مجموعة[رقم_التحميل]
    متغير رقم_المجموعة = رقم_العقدة / عقد_المجموعة
    متغير فهرس_محلي = رقم_العقدة % عقد_المجموعة
    
    # حساب الكتلة داخل جدول العقد
    متغير عقد_في_كتلة = حجم_الكتلة / حجم_العقدة  # 32
    متغير كتلة_نسبية = فهرس_محلي / عقد_في_كتلة
    
    ارجع كتلة_جدول_العقد(رقم_التحميل، رقم_المجموعة) + كتلة_نسبية
نهاية

## حساب الإزاحة داخل الكتلة
دالة إزاحة_العقدة(رقم_التحميل، رقم_العقدة)
    متغير عقد_المجموعة = sb_عقد_لكل_مجموعة[رقم_التحميل]
    متغير فهرس_محلي = رقم_العقدة % عقد_المجموعة
    متغير عقد_في_كتلة = حجم_الكتلة / حجم_العقدة
    متغير إزاحة = (فهرس_محلي % عقد_في_كتلة) * حجم_العقدة
    ارجع إزاحة
نهاية

## قراءة عقدة من القرص
## البيانات تُكتب في عنوان_مخزن_مؤقت + إزاحة
## يُعيد: عنوان بداية بيانات العقدة في الذاكرة
صدّر دالة اقرأ_عقدة(رقم_التحميل، رقم_العقدة)
    متغير كتلة = كتلة_العقدة(رقم_التحميل، رقم_العقدة)
    متغير إزاحة = إزاحة_العقدة(رقم_التحميل، رقم_العقدة)
    
    # قراءة الكتلة التي تحتوي العقدة
    متغير نتيجة = اقرأ_كتلة_FS(رقم_التحميل، كتلة، عنوان_مخزن_مؤقت)
    إذا (نتيجة != 0)
        ارجع 0
    نهاية
    
    ارجع عنوان_مخزن_مؤقت + إزاحة
نهاية

## كتابة عقدة إلى القرص
## المعامل: عنوان_العقدة — يشير إلى 128 بايت من بيانات العقدة
صدّر دالة اكتب_عقدة(رقم_التحميل، رقم_العقدة، عنوان_العقدة)
    متغير كتلة = كتلة_العقدة(رقم_التحميل، رقم_العقدة)
    متغير إزاحة = إزاحة_العقدة(رقم_التحميل، رقم_العقدة)
    
    # قراءة الكتلة الحالية أولاً
    متغير نتيجة = اقرأ_كتلة_FS(رقم_التحميل، كتلة، عنوان_مخزن_مؤقت)
    إذا (نتيجة != 0)
        ارجع -1
    نهاية
    
    # نسخ بيانات العقدة فوق الموقع الصحيح
    fs_انسخ_ذاكرة(عنوان_مخزن_مؤقت + إزاحة، عنوان_العقدة، حجم_العقدة)
    
    # كتابة الكتلة
    ارجع اكتب_كتلة_FS(رقم_التحميل، كتلة، عنوان_مخزن_مؤقت)
نهاية

