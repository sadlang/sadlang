# ═══════════════════════════════════════════════════════════════════════════════
# تهيئة PS/2
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ps2_هيئ()
    ps2_serial_اطبع("[PS/2] تهيئة متحكم PS/2...")
    ps2_serial_سطر()

    # تفريغ buffers
    ps2_flush()

    # تعطيل المنفذين
    ps2_send_controller_cmd(PS2_CMD_DISABLE_PORT1)
    ps2_send_controller_cmd(PS2_CMD_DISABLE_PORT2)
    ps2_flush()

    # قراءة إعدادات المتحكم
    ps2_send_controller_cmd(PS2_CMD_READ_CONFIG)
    متغير config = ps2_read_data() + 0
    ps2_serial_اطبع("[PS/2] Config byte: 0x")
    ps2_serial_hex8(config + 0)
    ps2_serial_سطر()

    # تعطيل المقاطعات والترجمة
    config = config - (config % 2)  # clear bit 0 (INT1)
    إذا ((config / 2) % 2 == 1) config = config - 2 نهاية  # clear bit 1 (INT2)
    إذا ((config / 64) % 2 == 1) config = config - 64 نهاية  # clear bit 6 (translation)

    ps2_send_controller_cmd(PS2_CMD_WRITE_CONFIG)
    ps2_send_controller_data(config)

    # فحص ذاتي للمتحكم
    ps2_send_controller_cmd(PS2_CMD_SELF_TEST)
    متغير result = ps2_read_data() + 0
    إذا (result == 85)  # 0x55 = pass
        ps2_serial_اطبع("[PS/2] Self-test passed")
        ps2_serial_سطر()
    والا
        ps2_serial_اطبع("[PS/2] Self-test FAILED: 0x")
        ps2_serial_hex8(result + 0)
        ps2_serial_سطر()
        ps2_errors = ps2_errors + 1
    نهاية

    # إعادة كتابة الإعدادات (قد تتغير بعد Self-Test)
    ps2_send_controller_cmd(PS2_CMD_WRITE_CONFIG)
    ps2_send_controller_data(config)

    # تحقق من dual channel
    ps2_send_controller_cmd(PS2_CMD_ENABLE_PORT2)
    ps2_send_controller_cmd(PS2_CMD_READ_CONFIG)
    متغير config2 = ps2_read_data() + 0
    إذا ((config2 / 32) % 2 == 0)  # bit 5 clear = dual channel
        ps2_dual_channel = 1
        ps2_send_controller_cmd(PS2_CMD_DISABLE_PORT2)
    نهاية

    # فحص المنفذ الأول
    ps2_send_controller_cmd(PS2_CMD_TEST_PORT1)
    متغير port1_result = ps2_read_data() + 0
    إذا (port1_result == 0)
        ps2_port1_exists = 1
        ps2_serial_اطبع("[PS/2] Port 1 test passed")
        ps2_serial_سطر()
    والا
        ps2_serial_اطبع("[PS/2] Port 1 test failed: ")
        ps2_serial_رقم(port1_result + 0)
        ps2_serial_سطر()
    نهاية

    # فحص المنفذ الثاني
    إذا (ps2_dual_channel == 1)
        ps2_send_controller_cmd(PS2_CMD_TEST_PORT2)
        متغير port2_result = ps2_read_data() + 0
        إذا (port2_result == 0)
            ps2_port2_exists = 1
            ps2_serial_اطبع("[PS/2] Port 2 test passed")
            ps2_serial_سطر()
        والا
            ps2_serial_اطبع("[PS/2] Port 2 test failed: ")
            ps2_serial_رقم(port2_result + 0)
            ps2_serial_سطر()
        نهاية
    نهاية

    # تمكين المنافذ
    إذا (ps2_port1_exists == 1)
        ps2_send_controller_cmd(PS2_CMD_ENABLE_PORT1)
        config = config + PS2_CFG_INT1
    نهاية
    إذا (ps2_port2_exists == 1)
        ps2_send_controller_cmd(PS2_CMD_ENABLE_PORT2)
        config = config + PS2_CFG_INT2
    نهاية

    # كتابة الإعدادات النهائية
    ps2_send_controller_cmd(PS2_CMD_WRITE_CONFIG)
    ps2_send_controller_data(config)

    # إعادة تعيين الأجهزة
    إذا (ps2_port1_exists == 1)
        ps2_send_device1_cmd(PS2_DEV_RESET)
        متغير resp1 = ps2_read_data() + 0
        إذا (resp1 == PS2_RESP_SELF_OK)
            ps2_serial_اطبع("[PS/2] Keyboard reset OK")
            ps2_serial_سطر()
        نهاية
        ps2_flush()
        # تمكين المسح
        ps2_send_device1_cmd(PS2_DEV_ENABLE_SCAN)
    نهاية

    إذا (ps2_port2_exists == 1)
        ps2_send_device2_cmd(PS2_DEV_RESET)
        متغير resp2 = ps2_read_data() + 0
        ps2_flush()
        # محاولة تمكين عجلة الفأرة
        ps2_mouse_enable_wheel()
        # تمكين المسح
        ps2_send_device2_cmd(PS2_DEV_ENABLE_SCAN)
        # Set sample rate to 100
        ps2_send_device2_cmd(PS2_DEV_SET_RATE)
        ps2_send_device2_cmd(100)
    نهاية

    ps2_هيئ_تم = 1
    ps2_serial_اطبع("[PS/2] جاهز")
    ps2_serial_سطر()
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# دورة PS/2
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ps2_دورة()
    # استقصاء كل البيانات المتاحة
    متغير processed = 0 + 0
    متغير max_iter = 32 + 0
    بينما (max_iter > 0)
        متغير rc = ps2_poll() + 0
        إذا (rc == 0) اخرج نهاية
        processed = processed + 1
        max_iter = max_iter - 1
    نهاية
    ارجع processed + 0
نهاية
