# ═══════════════════════════════════════════════════════════════════════════════
# معالجة بايت Scan Code Set 2 من لوحة المفاتيح
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ps2_kbd_handle_byte(byte)
    ps2_kbd_irq_count = ps2_kbd_irq_count + 1

    # Extended prefix
    إذا (byte == SC2_EXTENDED)
        kbd_extended = 1
        ارجع 0
    نهاية

    # Release prefix
    إذا (byte == SC2_RELEASE)
        kbd_release = 1
        ارجع 0
    نهاية

    متغير scancode = byte + 0
    متغير is_release = kbd_release + 0
    متغير is_extended = kbd_extended + 0
    kbd_release = 0
    kbd_extended = 0

    # ═══ Modifier keys ═══
    # Left Shift (0x12 = 18)
    إذا (scancode == 18)
        إذا (is_release == 1)
            kbd_shift_left = 0
        والا
            kbd_shift_left = 1
        نهاية
        ارجع 0
    نهاية

    # Right Shift (0x59 = 89)
    إذا (scancode == 89)
        إذا (is_release == 1)
            kbd_shift_right = 0
        والا
            kbd_shift_right = 1
        نهاية
        ارجع 0
    نهاية

    # Left Ctrl (0x14 = 20)
    إذا (scancode == 20)
        إذا (is_extended == 0)
            إذا (is_release == 1)
                kbd_ctrl_left = 0
            والا
                kbd_ctrl_left = 1
            نهاية
        والا
            إذا (is_release == 1)
                kbd_ctrl_right = 0
            والا
                kbd_ctrl_right = 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    # Left Alt (0x11 = 17)
    إذا (scancode == 17)
        إذا (is_extended == 0)
            إذا (is_release == 1)
                kbd_alt_left = 0
            والا
                kbd_alt_left = 1
            نهاية
        والا
            إذا (is_release == 1)
                kbd_alt_right = 0
            والا
                kbd_alt_right = 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    # CapsLock (0x58 = 88)
    إذا (scancode == 88)
        إذا (is_release == 0)
            kbd_capslock = 1 - kbd_capslock
            ps2_update_leds()
        نهاية
        ارجع 0
    نهاية

    # NumLock (0x77 = 119)
    إذا (scancode == 119)
        إذا (is_release == 0)
            kbd_numlock = 1 - kbd_numlock
            ps2_update_leds()
        نهاية
        ارجع 0
    نهاية

    # ScrollLock (0x7E = 126)
    إذا (scancode == 126)
        إذا (is_release == 0)
            kbd_scrolllock = 1 - kbd_scrolllock
            ps2_update_leds()
        نهاية
        ارجع 0
    نهاية

    # ═══ Regular keys (only on press, not release) ═══
    إذا (is_release == 1) ارجع 0 نهاية

    متغير shift = kbd_shift_left + kbd_shift_right
    إذا (shift > 1) shift = 1 نهاية

    # CapsLock toggles for alpha chars
    متغير ascii = 0 + 0
    إذا (shift == 1)
        ascii = ps2_sc2_to_ascii_shift(scancode) + 0
    والا
        ascii = ps2_sc2_to_ascii(scancode) + 0
    نهاية

    # CapsLock: toggle case for a-z / A-Z
    إذا (kbd_capslock == 1)
        إذا (ascii >= 97)
            إذا (ascii <= 122)
                ascii = ascii - 32  # upper
            نهاية
        والا_اذا (ascii >= 65)
            إذا (ascii <= 90)
                ascii = ascii + 32  # lower
            نهاية
        نهاية
    نهاية

    إذا (ascii > 0)
        ps2_kbd_push(scancode، ascii)
    نهاية

    ارجع ascii + 0
نهاية

