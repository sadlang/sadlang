# ═══════════════════════════════════════════════════════════════════════════════
# معالجة بايت الفأرة PS/2
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ps2_mouse_handle_byte(byte)
    ps2_mouse_irq_count = ps2_mouse_irq_count + 1

    إذا (mouse_byte_idx == 0)
        # Byte 0: buttons/sign/overflow
        # bit 3 must be set (always 1)
        إذا ((byte / 8) % 2 == 0)
            # alignment error — skip
            ارجع 0
        نهاية
        mouse_byte0 = byte + 0
        mouse_byte_idx = 1
        ارجع 0
    نهاية

    إذا (mouse_byte_idx == 1)
        mouse_byte1 = byte + 0
        mouse_byte_idx = 2
        ارجع 0
    نهاية

    إذا (mouse_byte_idx == 2)
        mouse_byte2 = byte + 0

        إذا (mouse_has_wheel == 1)
            mouse_byte_idx = 3
            ارجع 0
        نهاية

        # حزمة كاملة (3 بايت) — معالجة
        ps2_mouse_process_packet()
        mouse_byte_idx = 0
        ارجع 0
    نهاية

    إذا (mouse_byte_idx == 3)
        mouse_byte3 = byte + 0
        # حزمة كاملة (4 بايت) — معالجة
        ps2_mouse_process_packet()
        mouse_byte_idx = 0
        ارجع 0
    نهاية

    mouse_byte_idx = 0
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# معالجة حزمة الفأرة
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ps2_mouse_process_packet()
    متغير b0 = mouse_byte0 + 0
    متغير dx = mouse_byte1 + 0
    متغير dy = mouse_byte2 + 0

    # Buttons
    mouse_buttons = b0 % 8  # bits 0-2: left, right, middle

    # X overflow check (bit 6)
    إذا ((b0 / 64) % 2 == 1) ارجع 0 نهاية
    # Y overflow check (bit 7)
    إذا ((b0 / 128) % 2 == 1) ارجع 0 نهاية

    # Sign extend X (bit 4 of byte 0)
    إذا ((b0 / 16) % 2 == 1)
        dx = dx - 256
    نهاية

    # Sign extend Y (bit 5 of byte 0)
    إذا ((b0 / 32) % 2 == 1)
        dy = dy - 256
    نهاية

    # Y is inverted in PS/2
    dy = 0 - dy

    # تحديث الإحداثيات
    mouse_x = mouse_x + dx
    mouse_y = mouse_y + dy

    # Clamp
    إذا (mouse_x < 0) mouse_x = 0 نهاية
    إذا (mouse_y < 0) mouse_y = 0 نهاية
    إذا (mouse_x > mouse_max_x) mouse_x = mouse_max_x + 0 نهاية
    إذا (mouse_y > mouse_max_y) mouse_y = mouse_max_y + 0 نهاية

    # Wheel
    إذا (mouse_has_wheel == 1)
        متغير w = mouse_byte3 + 0
        إذا (w > 127) w = w - 256 نهاية
        mouse_wheel = w + 0
    نهاية

    ارجع 0
نهاية

