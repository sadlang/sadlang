# ═══════════════════════════════════════════════════════════════════════════════
# ps2_نحلة.ص — تعريف متحكم PS/2 (لوحة مفاتيح وفأرة) لنظام نحلة
# بسم الله الرحمن الرحيم
# ═══════════════════════════════════════════════════════════════════════════════
# Intel 8042 PS/2 Controller
# Scan Code Set 2, IRQ1 (keyboard), IRQ12 (mouse)
# دعم لوحة مفاتيح كاملة مع مفاتيح عربية + فأرة PS/2
# ═══════════════════════════════════════════════════════════════════════════════

# ─── دوال خارجية (FFI) ───
خارجي دالة sad_ll_port_inb(port)
خارجي دالة sad_ll_port_outb(port، val)
خارجي دالة sad_ll_mem_read8(addr)
خارجي دالة sad_ll_mem_write8(addr، val)
خارجي دالة sad_ll_serial_write_char(port، ch)
خارجي دالة sad_ll_kmalloc(حجم_طلب)
خارجي دالة sad_ll_memset(عنوان، قيمة، حجم_منطقة)

