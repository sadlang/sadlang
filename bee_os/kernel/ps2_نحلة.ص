صدّر دالة ps2_wait_input()
    # انتظار أن يصبح Input Buffer فارغ (bit 1 clear)
    متغير timeout = 10000 + 0
    بينما (timeout > 0)
        متغير sts = sad_ll_port_inb(PS2_STATUS) + 0
        إذا ((sts / 2) % 2 == 0)
            ارجع 0
        نهاية
        timeout = timeout - 1
    نهاية
    ارجع 0 - 1
نهاية

صدّر دالة ps2_wait_output()
    # انتظار أن يصبح Output Buffer ممتلئ (bit 0 set)
    متغير timeout = 10000 + 0
    بينما (timeout > 0)
        متغير sts = sad_ll_port_inb(PS2_STATUS) + 0
        إذا (sts % 2 == 1)
            ارجع 0
        نهاية
        timeout = timeout - 1
    نهاية
    ارجع 0 - 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إرسال أمر إلى المتحكم
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ps2_send_controller_cmd(cmd)
    ps2_wait_input()
    sad_ll_port_outb(PS2_COMMAND، cmd)
    ارجع 0
نهاية

صدّر دالة ps2_send_controller_data(data)
    ps2_wait_input()
    sad_ll_port_outb(PS2_DATA، data)
    ارجع 0
نهاية

صدّر دالة ps2_read_data()
    متغير rc = ps2_wait_output() + 0
    إذا (rc < 0) ارجع 0 - 1 نهاية
    ارجع sad_ll_port_inb(PS2_DATA) + 0
