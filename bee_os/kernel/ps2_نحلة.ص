# ═══════════════════════════════════════════════════════════════════════════════
# إرسال أمر إلى الجهاز (المنفذ الأول)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ps2_send_device1_cmd(cmd)
    ps2_wait_input()
    sad_ll_port_outb(PS2_DATA، cmd)
    # انتظار ACK
    متغير resp = ps2_read_data() + 0
    إذا (resp == PS2_RESP_ACK)
        ارجع 0
    والا_اذا (resp == PS2_RESP_RESEND)
        ارجع 0 - 2
    نهاية
    ارجع 0 - 1
نهاية

# إرسال أمر إلى الجهاز (المنفذ الثاني)
صدّر دالة ps2_send_device2_cmd(cmd)
    ps2_send_controller_cmd(PS2_CMD_WRITE_PORT2)
    ps2_wait_input()
    sad_ll_port_outb(PS2_DATA، cmd)
    متغير resp = ps2_read_data() + 0
    إذا (resp == PS2_RESP_ACK)
        ارجع 0
    نهاية
    ارجع 0 - 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تفريغ Output Buffer
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ps2_flush()
    متغير count = 0 + 0
    بينما (count < 64)
        متغير sts = sad_ll_port_inb(PS2_STATUS) + 0
        إذا (sts % 2 == 0) اخرج نهاية
        sad_ll_port_inb(PS2_DATA)
        count = count + 1
    نهاية
    ارجع count + 0
