# ═══════════════════════════════════════════════════════════════════════════════
# وحدة إدارة TLB — نظام نحلة (BeeOS)
# الملف: مدير_tlb_نحلة.ص
# الوظيفة: إدارة ذاكرة التخزين المؤقت لترجمة العناوين (Translation Lookaside Buffer)
# الترتيب: __sad_init_84
# ═══════════════════════════════════════════════════════════════════════════════
#
# TLB هو ذاكرة تخزين مؤقت صغيرة وسريعة جداً داخل المعالج تحتفظ
# بآخر ترجمات العناوين الافتراضية إلى فيزيائية. عند تغيير جداول الصفحات
# يجب إبطال (invalidate) مداخل TLB المتأثرة.
#
# المكونات:
# 1. إبطال TLB لصفحة واحدة (INVLPG)
# 2. مسح TLB بالكامل (إعادة تحميل CR3)
# 3. إبطال TLB الجماعي (Shootdown) لأنظمة SMP
# 4. تجميع الإبطالات (Batching) — جمع عدة إبطالات ثم تنفيذها دفعة واحدة
# 5. وضع TLB الكسول (Lazy Mode) لخيوط النواة
# 6. دعم PCID (Process Context Identifiers) عبر CPUID
# 7. إدارة الصفحات العامة (Global Pages)
# 8. إحصائيات TLB
#
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# التصريحات الخارجية (FFI)
# ═══════════════════════════════════════════════════════════════════════════════
خارجي دالة kernel_print_string(عنوان_سلسلة)
خارجي دالة kernel_print_number(قيمة)
خارجي دالة mem_read_dword(عنوان)
خارجي دالة mem_write_dword(عنوان، قيمة)
خارجي دالة sad_ll_memset(عنوان، قيمة، طول)
خارجي دالة sad_ll_invlpg(عنوان)
خارجي دالة sad_ll_flush_tlb()
خارجي دالة sad_ll_read_cr3()
خارجي دالة sad_ll_write_cr3(قيمة)
خارجي دالة sad_ll_read_cr4()
خارجي دالة sad_ll_write_cr4(قيمة)
خارجي دالة sad_ll_cpuid_eax(دالة_cpuid)
خارجي دالة sad_ll_cpuid_edx(دالة_cpuid)
خارجي دالة kernel_allocate(المقاس)

# ═══════════════════════════════════════════════════════════════════════════════
# الثوابت
# ═══════════════════════════════════════════════════════════════════════════════

# مقاس الصفحة
متغير ثابت_مقاس_صفحة = 4096

# بتات CR4 ذات الصلة
متغير بت_cr4_pge = 128           # بت 7: تمكين الصفحات العامة (Page Global Enable)
متغير بت_cr4_pcide = 131072      # بت 17: تمكين PCID (Process Context ID Enable)

# بتات CPUID
# CPUID.01H:ECX بت 17 = PCID support
متغير بت_cpuid_pcid = 131072     # بت 17 في ECX

# ثوابت PCID
متغير ثابت_اقصى_pcid = 4096     # PCID من 0 إلى 4095
متغير ثابت_pcid_نواة = 0         # PCID 0 محجوز للنواة
متغير ثابت_pcid_بلا = 0          # بدون PCID (معطل)

# ثوابت التجميع (Batching)
متغير ثابت_اقصى_تجميع = 64      # أقصى عدد عناوين مجمعة قبل المسح الكامل
متغير ثابت_عتبة_مسح_كامل = 32   # إذا تجاوز العدد هذه القيمة، نمسح كلياً

# ثوابت SMP لعمليات Shootdown
متغير ثابت_اقصى_معالجات = 16    # أقصى عدد معالجات مدعومة
# عنوان منطقة الاتصال بين المعالجات (IPI Mailbox)
متغير ثابت_عنوان_صندوق_بريد = 28311552   # 0x1B00000

# أعلام حالة Shootdown
متغير علم_shootdown_بلا = 0
متغير علم_shootdown_صفحة = 1     # إبطال صفحة واحدة
متغير علم_shootdown_كامل = 2     # مسح كامل
متغير علم_shootdown_نطاق = 3     # إبطال نطاق من الصفحات

# ═══════════════════════════════════════════════════════════════════════════════
# المتغيرات العامة — حالة TLB
# ═══════════════════════════════════════════════════════════════════════════════

# هل تمت التهيئة
متغير تم_التهيئة = 0

# دعم الميزات
متغير pcid_مدعوم = 0             # هل المعالج يدعم PCID
متغير pcid_مفعل = 0              # هل تم تفعيل PCID
متغير صفحات_عامة_مفعلة = 0      # هل الصفحات العامة مفعلة

# PCID الحالي
متغير pcid_حالي = 0

# جدول تعيين PCID — أي عملية تستخدم أي PCID
# مصفوفات متوازية
متغير عنوان_pcid_إلى_عملية = 0   # pcid -> معرف العملية
متغير عنوان_pcid_مستخدم = 0      # pcid -> هل مستخدم (1/0)
متغير عدد_pcid_مستخدمة = 0
متغير آخر_pcid_معين = 0

# ═══════════════════════════════════════════════════════════════════════════════
# إحصائيات TLB
# ═══════════════════════════════════════════════════════════════════════════════
متغير عداد_إبطال_صفحة = 0        # عدد مرات INVLPG
متغير عداد_مسح_كامل = 0          # عدد مرات مسح TLB بالكامل
متغير عداد_shootdown = 0          # عدد عمليات Shootdown
متغير عداد_تجميع_تنفيذ = 0       # عدد مرات تنفيذ دفعة مجمعة
متغير عداد_وضع_كسول_دخول = 0    # عدد مرات الدخول في الوضع الكسول
متغير عداد_وضع_كسول_خروج = 0    # عدد مرات الخروج من الوضع الكسول
متغير عداد_pcid_تعيين = 0        # عدد مرات تعيين PCID
متغير عداد_pcid_تحرير = 0        # عدد مرات تحرير PCID
متغير عداد_تبديل_فضاء = 0        # عدد مرات تبديل فضاء العناوين
متغير عداد_صفحات_عامة = 0        # عدد الصفحات العامة المُبطلة

# ═══════════════════════════════════════════════════════════════════════════════
# وضع TLB الكسول (Lazy TLB Mode)
# ═══════════════════════════════════════════════════════════════════════════════
# في الوضع الكسول، خيوط النواة التي لا تحتاج فضاء عناوين مستخدم
# لا تبطل TLB فوراً — تؤجل الإبطال حتى تعود للمستخدم

متغير وضع_كسول_مفعل = 0          # هل الوضع الكسول نشط الآن
متغير إبطالات_مؤجلة = 0           # عدد الإبطالات المؤجلة
متغير يحتاج_مسح_عند_خروج = 0     # هل نحتاج مسح كامل عند الخروج

# ═══════════════════════════════════════════════════════════════════════════════
# مصفوفة التجميع (Batching)
# ═══════════════════════════════════════════════════════════════════════════════
# نخزن عناوين الصفحات المطلوب إبطالها حتى نستدعي flush_batch
# باستخدام ذاكرة مخصصة (كل عنوان dword)

متغير عنوان_مصفوفة_تجميع = 0     # عنوان المصفوفة المخصصة
متغير عدد_تجميع_حالي = 0          # العناوين المجمعة حالياً
متغير تجميع_نشط = 0               # هل التجميع نشط

# ═══════════════════════════════════════════════════════════════════════════════
# SMP Shootdown — صندوق بريد بين المعالجات
# ═══════════════════════════════════════════════════════════════════════════════
# بنية صندوق البريد (لكل معالج):
# إزاحة 0: العلم (نوع العملية — 0 يعني لا عملية)
# إزاحة 4: عنوان الصفحة (أو بداية النطاق)
# إزاحة 8: نهاية النطاق (لعمليات النطاق فقط)
# إزاحة 12: محجوز

متغير ثابت_مقاس_صندوق = 16       # مقاس صندوق بريد لكل معالج
متغير عدد_معالجات_نشطة = 1        # افتراضياً معالج واحد

# ═══════════════════════════════════════════════════════════════════════════════
# إبطال TLB — العمليات الأساسية
# ═══════════════════════════════════════════════════════════════════════════════

# إبطال صفحة واحدة من TLB باستخدام تعليمة INVLPG
دالة إبطال_صفحة(عنوان_صفحة)
    # محاذاة العنوان لحدود الصفحة
    متغير عنوان_محاذاة = عنوان_صفحة & (~4095)

    # في الوضع الكسول، نؤجل الإبطال
    إذا (وضع_كسول_مفعل == 1)
        إبطالات_مؤجلة = إبطالات_مؤجلة + 1
        ارجع 1
    نهاية

    # تنفيذ INVLPG
    sad_ll_invlpg(عنوان_محاذاة)
    عداد_إبطال_صفحة = عداد_إبطال_صفحة + 1
    ارجع 1
نهاية

# إبطال نطاق من الصفحات
دالة إبطال_نطاق(عنوان_بداية، عنوان_نهاية)
    متغير عنوان_حالي = عنوان_بداية & (~4095)
    متغير النهاية = عنوان_نهاية

    # حساب عدد الصفحات
    متغير عدد_صفحات = (النهاية - عنوان_حالي + ثابت_مقاس_صفحة - 1) / ثابت_مقاس_صفحة

    # إذا كان العدد كبيراً جداً، نمسح بالكامل
    إذا (عدد_صفحات > ثابت_عتبة_مسح_كامل)
        مسح_tlb_كامل()
        ارجع عدد_صفحات
    نهاية

    # إبطال كل صفحة على حدة
    بينما (عنوان_حالي < النهاية)
        إبطال_صفحة(عنوان_حالي)
        عنوان_حالي = عنوان_حالي + ثابت_مقاس_صفحة
    نهاية

    ارجع عدد_صفحات
نهاية

# مسح TLB بالكامل (إعادة تحميل CR3)
دالة مسح_tlb_كامل()
    # في الوضع الكسول، نسجل أننا نحتاج مسح عند الخروج
    إذا (وضع_كسول_مفعل == 1)
        يحتاج_مسح_عند_خروج = 1
        إبطالات_مؤجلة = إبطالات_مؤجلة + 1
        ارجع 1
    نهاية

    # إعادة تحميل CR3 يمسح جميع مداخل TLB غير العامة
    sad_ll_flush_tlb()
    عداد_مسح_كامل = عداد_مسح_كامل + 1
    ارجع 1
نهاية

# مسح TLB بالكامل بما في ذلك الصفحات العامة
دالة مسح_tlb_مع_عامة()
    # نحتاج تعطيل PGE ثم إعادة تفعيله
    إذا (صفحات_عامة_مفعلة == 1)
        متغير cr4_حالي = sad_ll_read_cr4()
        # إزالة بت PGE
        متغير cr4_بلا_pge = cr4_حالي & (~بت_cr4_pge)
        sad_ll_write_cr4(cr4_بلا_pge)
        # إعادة تفعيل PGE — هذا يمسح كل شيء
        sad_ll_write_cr4(cr4_حالي)
        عداد_صفحات_عامة = عداد_صفحات_عامة + 1
    وإلا
        # لا صفحات عامة — مسح عادي يكفي
        sad_ll_flush_tlb()
    نهاية
    عداد_مسح_كامل = عداد_مسح_كامل + 1
    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# نظام التجميع (Batching) — تجميع الإبطالات
# ═══════════════════════════════════════════════════════════════════════════════

# بدء وضع التجميع — تراكم الإبطالات بدلاً من التنفيذ الفوري
دالة بدء_تجميع()
    إذا (تجميع_نشط == 1)
        # التجميع نشط بالفعل — لا حاجة لإعادة بدئه
        ارجع 1
    نهاية

    # تخصيص مصفوفة التجميع إذا لم تُخصص بعد
    إذا (عنوان_مصفوفة_تجميع == 0)
        عنوان_مصفوفة_تجميع = kernel_allocate(ثابت_اقصى_تجميع * 4)
        إذا (عنوان_مصفوفة_تجميع == 0)
            kernel_print_string("  [TLB] فشل تخصيص مصفوفة التجميع")
            kernel_print_number(10)
            ارجع 0
        نهاية
    نهاية

    تجميع_نشط = 1
    عدد_تجميع_حالي = 0
    ارجع 1
نهاية

# إضافة عنوان إلى مصفوفة التجميع
دالة إضافة_للتجميع(عنوان_صفحة)
    إذا (تجميع_نشط == 0)
        # التجميع غير نشط — ننفذ مباشرة
        ارجع إبطال_صفحة(عنوان_صفحة)
    نهاية

    # هل تجاوزنا الحد الأقصى؟
    إذا (عدد_تجميع_حالي >= ثابت_اقصى_تجميع)
        # ننفذ الدفعة الحالية ثم نبدأ من جديد
        تنفيذ_تجميع()
    نهاية

    # محاذاة العنوان
    متغير عنوان_محاذاة = عنوان_صفحة & (~4095)

    # تخزين العنوان في المصفوفة
    متغير إزاحة_تخزين = عنوان_مصفوفة_تجميع + (عدد_تجميع_حالي * 4)
    mem_write_dword(إزاحة_تخزين، عنوان_محاذاة)
    عدد_تجميع_حالي = عدد_تجميع_حالي + 1
    ارجع 1
نهاية

# تنفيذ جميع الإبطالات المجمعة
دالة تنفيذ_تجميع()
    إذا (تجميع_نشط == 0)
        ارجع 0
    نهاية

    إذا (عدد_تجميع_حالي == 0)
        # لا شيء للتنفيذ
        تجميع_نشط = 0
        ارجع 1
    نهاية

    # إذا كان عدد الإبطالات كبيراً — نمسح بالكامل بدلاً من واحدة واحدة
    إذا (عدد_تجميع_حالي > ثابت_عتبة_مسح_كامل)
        مسح_tlb_كامل()
    وإلا
        # إبطال كل صفحة على حدة
        متغير م = 0
        بينما (م < عدد_تجميع_حالي)
            متغير إزاحة_قراءة = عنوان_مصفوفة_تجميع + (م * 4)
            متغير العنوان = mem_read_dword(إزاحة_قراءة)
            sad_ll_invlpg(العنوان)
            عداد_إبطال_صفحة = عداد_إبطال_صفحة + 1
            م = م + 1
        نهاية
    نهاية

    عداد_تجميع_تنفيذ = عداد_تجميع_تنفيذ + 1
    عدد_تجميع_حالي = 0
    تجميع_نشط = 0
    ارجع 1
نهاية

# إلغاء التجميع بدون تنفيذ
دالة إلغاء_تجميع()
    عدد_تجميع_حالي = 0
    تجميع_نشط = 0
    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# وضع TLB الكسول (Lazy TLB Mode)
# ═══════════════════════════════════════════════════════════════════════════════

# الدخول في الوضع الكسول
# يُستخدم عندما ينتقل المعالج لتنفيذ خيط نواة يستخدم فضاء عناوين النواة فقط
# لا حاجة لمسح TLB لأن مداخل النواة مشتركة بين جميع فضاءات العناوين
دالة دخول_وضع_كسول()
    إذا (وضع_كسول_مفعل == 1)
        ارجع 1
    نهاية
    وضع_كسول_مفعل = 1
    إبطالات_مؤجلة = 0
    يحتاج_مسح_عند_خروج = 0
    عداد_وضع_كسول_دخول = عداد_وضع_كسول_دخول + 1
    ارجع 1
نهاية

# الخروج من الوضع الكسول
# يُستخدم عندما نعود لتنفيذ عملية مستخدم
# نحتاج تطبيق جميع الإبطالات المؤجلة
دالة خروج_وضع_كسول()
    إذا (وضع_كسول_مفعل == 0)
        ارجع 1
    نهاية

    وضع_كسول_مفعل = 0
    عداد_وضع_كسول_خروج = عداد_وضع_كسول_خروج + 1

    # هل نحتاج مسح كامل؟
    إذا (يحتاج_مسح_عند_خروج == 1)
        مسح_tlb_كامل()
        يحتاج_مسح_عند_خروج = 0
        إبطالات_مؤجلة = 0
        ارجع 1
    نهاية

    # هل تراكمت إبطالات كثيرة يستحق مسح كامل؟
    إذا (إبطالات_مؤجلة > ثابت_عتبة_مسح_كامل)
        مسح_tlb_كامل()
    نهاية

    إبطالات_مؤجلة = 0
    يحتاج_مسح_عند_خروج = 0
    ارجع 1
نهاية

# الاستعلام عن حالة الوضع الكسول
دالة هل_وضع_كسول()
    ارجع وضع_كسول_مفعل
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# كشف ودعم PCID (Process Context Identifiers)
# ═══════════════════════════════════════════════════════════════════════════════
#
# PCID يسمح بتمييز مداخل TLB حسب العملية، فلا نحتاج مسح TLB
# عند تبديل العمليات إذا كان لكل عملية PCID مختلف.
# يحتاج دعم من المعالج (CPUID.01H:ECX.PCID[bit 17] = 1)

# كشف دعم PCID من خلال CPUID
دالة كشف_دعم_pcid()
    # CPUID دالة 1: معلومات الميزات
    # We need ECX bit 17 for PCID support
    # sad_ll_cpuid_eax returns EAX, we need a way to check ECX
    # For now, check via CPUID leaf 1 — EDX has feature flags
    # PCID is in ECX bit 17, but we only have cpuid_eax and cpuid_edx
    # We'll assume PCID is not available unless we can detect it

    # محاولة كشف عبر CPUID leaf 1
    متغير edx = sad_ll_cpuid_edx(1)

    # بت PSE (4) و PAE (6) في EDX — للتحقق من أن CPUID يعمل
    متغير pse_مدعوم = (edx >> 4) & 1
    متغير pae_مدعوم = (edx >> 6) & 1

    # لغرض التوافقية مع FFI المتاحة، نفترض PCID غير مدعوم
    # ما لم نتمكن من قراءة ECX عبر FFI مستقبلاً
    pcid_مدعوم = 0

    kernel_print_string("  [TLB] كشف CPUID:")
    kernel_print_number(10)
    kernel_print_string("    PSE: ")
    kernel_print_number(pse_مدعوم)
    kernel_print_number(10)
    kernel_print_string("    PAE: ")
    kernel_print_number(pae_مدعوم)
    kernel_print_number(10)
    kernel_print_string("    PCID: ")
    kernel_print_number(pcid_مدعوم)
    kernel_print_number(10)

    ارجع pcid_مدعوم
نهاية

# تفعيل PCID (إذا كان مدعوماً)
دالة تفعيل_pcid()
    إذا (pcid_مدعوم == 0)
        kernel_print_string("  [TLB] PCID غير مدعوم — لا يمكن التفعيل")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # تفعيل PCID عبر بت CR4.PCIDE
    متغير cr4_حالي = sad_ll_read_cr4()
    متغير cr4_جديد = cr4_حالي | بت_cr4_pcide
    sad_ll_write_cr4(cr4_جديد)

    # تخصيص جداول PCID
    عنوان_pcid_إلى_عملية = kernel_allocate(ثابت_اقصى_pcid * 4)
    عنوان_pcid_مستخدم = kernel_allocate(ثابت_اقصى_pcid * 4)

    إذا (عنوان_pcid_إلى_عملية == 0)
        kernel_print_string("  [TLB] فشل تخصيص جدول PCID")
        kernel_print_number(10)
        ارجع 0
    نهاية

    إذا (عنوان_pcid_مستخدم == 0)
        kernel_print_string("  [TLB] فشل تخصيص جدول حالة PCID")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # تصفير الجداول
    sad_ll_memset(عنوان_pcid_إلى_عملية، 0، ثابت_اقصى_pcid * 4)
    sad_ll_memset(عنوان_pcid_مستخدم، 0، ثابت_اقصى_pcid * 4)

    # PCID 0 محجوز للنواة
    mem_write_dword(عنوان_pcid_مستخدم، 1)
    عدد_pcid_مستخدمة = 1
    آخر_pcid_معين = 0

    pcid_مفعل = 1
    pcid_حالي = ثابت_pcid_نواة

    kernel_print_string("  [TLB] تم تفعيل PCID بنجاح")
    kernel_print_number(10)
    ارجع 1
نهاية

# تعيين PCID لعملية جديدة
دالة تعيين_pcid(معرف_عملية)
    إذا (pcid_مفعل == 0)
        ارجع ثابت_pcid_بلا
    نهاية

    # البحث عن PCID حر
    متغير م = 1   # نبدأ من 1 (PCID 0 محجوز للنواة)
    بينما (م < ثابت_اقصى_pcid)
        متغير مستخدم = mem_read_dword(عنوان_pcid_مستخدم + (م * 4))
        إذا (مستخدم == 0)
            # وجدنا PCID حر
            mem_write_dword(عنوان_pcid_مستخدم + (م * 4)، 1)
            mem_write_dword(عنوان_pcid_إلى_عملية + (م * 4)، معرف_عملية)
            عدد_pcid_مستخدمة = عدد_pcid_مستخدمة + 1
            آخر_pcid_معين = م
            عداد_pcid_تعيين = عداد_pcid_تعيين + 1
            ارجع م
        نهاية
        م = م + 1
    نهاية

    # لم نجد PCID حر — نحتاج إعادة تدوير
    # نختار PCID بعد آخر واحد مُعيّن (Round-Robin)
    متغير ضحية = (آخر_pcid_معين + 1) % ثابت_اقصى_pcid
    إذا (ضحية == 0)
        ضحية = 1   # لا نُعيد تدوير PCID 0
    نهاية

    # إبطال TLB الخاص بهذا الـ PCID القديم
    مسح_tlb_كامل()

    mem_write_dword(عنوان_pcid_إلى_عملية + (ضحية * 4)، معرف_عملية)
    آخر_pcid_معين = ضحية
    عداد_pcid_تعيين = عداد_pcid_تعيين + 1
    ارجع ضحية
نهاية

# تحرير PCID عند إنهاء عملية
دالة تحرير_pcid(معرف_pcid)
    إذا (pcid_مفعل == 0)
        ارجع 0
    نهاية

    إذا (معرف_pcid == 0)
        # لا يمكن تحرير PCID النواة
        ارجع 0
    نهاية

    إذا (معرف_pcid >= ثابت_اقصى_pcid)
        ارجع 0
    نهاية

    mem_write_dword(عنوان_pcid_مستخدم + (معرف_pcid * 4)، 0)
    mem_write_dword(عنوان_pcid_إلى_عملية + (معرف_pcid * 4)، 0)
    عدد_pcid_مستخدمة = عدد_pcid_مستخدمة - 1
    عداد_pcid_تحرير = عداد_pcid_تحرير + 1
    ارجع 1
نهاية

# البحث عن PCID لعملية معينة
دالة بحث_pcid_لعملية(معرف_عملية)
    إذا (pcid_مفعل == 0)
        ارجع ثابت_pcid_بلا
    نهاية

    متغير م = 1
    بينما (م < ثابت_اقصى_pcid)
        متغير مستخدم = mem_read_dword(عنوان_pcid_مستخدم + (م * 4))
        إذا (مستخدم == 1)
            متغير عملية = mem_read_dword(عنوان_pcid_إلى_عملية + (م * 4))
            إذا (عملية == معرف_عملية)
                ارجع م
            نهاية
        نهاية
        م = م + 1
    نهاية

    ارجع ثابت_pcid_بلا
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إدارة الصفحات العامة (Global Pages)
# ═══════════════════════════════════════════════════════════════════════════════
#
# الصفحات العامة (Global = بت G في PTE) لا تُمسح من TLB عند إعادة تحميل CR3.
# تُستخدم لصفحات النواة لأنها مشتركة بين جميع العمليات.

# تفعيل دعم الصفحات العامة
دالة تفعيل_صفحات_عامة()
    # فحص دعم PGE من CPUID (EDX بت 13)
    متغير edx = sad_ll_cpuid_edx(1)
    متغير pge_مدعوم = (edx >> 13) & 1

    إذا (pge_مدعوم == 0)
        kernel_print_string("  [TLB] PGE غير مدعوم من المعالج")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # تفعيل PGE في CR4
    متغير cr4_حالي = sad_ll_read_cr4()
    متغير cr4_جديد = cr4_حالي | بت_cr4_pge
    sad_ll_write_cr4(cr4_جديد)

    صفحات_عامة_مفعلة = 1
    kernel_print_string("  [TLB] تم تفعيل الصفحات العامة (PGE)")
    kernel_print_number(10)
    ارجع 1
نهاية

# تعطيل الصفحات العامة
دالة تعطيل_صفحات_عامة()
    إذا (صفحات_عامة_مفعلة == 0)
        ارجع 1
    نهاية

    متغير cr4_حالي = sad_ll_read_cr4()
    متغير cr4_جديد = cr4_حالي & (~بت_cr4_pge)
    sad_ll_write_cr4(cr4_جديد)

    صفحات_عامة_مفعلة = 0
    kernel_print_string("  [TLB] تم تعطيل الصفحات العامة")
    kernel_print_number(10)
    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# SMP TLB Shootdown — إبطال TLB عبر المعالجات
# ═══════════════════════════════════════════════════════════════════════════════
#
# في أنظمة SMP (متعددة المعالجات)، عند تغيير جدول صفحات مشترك
# يجب إخطار جميع المعالجات الأخرى لإبطال TLB المحلي لديها.
# نستخدم IPI (Inter-Processor Interrupt) لإرسال طلب Shootdown.
# كل معالج لديه "صندوق بريد" في ذاكرة مشتركة.

# إرسال طلب Shootdown لصفحة واحدة لجميع المعالجات
دالة إرسال_shootdown_صفحة(عنوان_صفحة)
    إذا (عدد_معالجات_نشطة <= 1)
        # معالج واحد فقط — لا حاجة لـ Shootdown
        ارجع 1
    نهاية

    متغير عنوان_محاذاة = عنوان_صفحة & (~4095)

    # كتابة طلب Shootdown في صناديق البريد
    متغير م = 0
    بينما (م < عدد_معالجات_نشطة)
        متغير عنوان_صندوق = ثابت_عنوان_صندوق_بريد + (م * ثابت_مقاس_صندوق)
        # كتابة العنوان أولاً
        mem_write_dword(عنوان_صندوق + 4، عنوان_محاذاة)
        # ثم كتابة العلم (atomic-like — يجب أن يكون الأخير)
        mem_write_dword(عنوان_صندوق، علم_shootdown_صفحة)
        م = م + 1
    نهاية

    عداد_shootdown = عداد_shootdown + 1
    ارجع 1
نهاية

# إرسال طلب Shootdown كامل لجميع المعالجات
دالة إرسال_shootdown_كامل()
    إذا (عدد_معالجات_نشطة <= 1)
        ارجع 1
    نهاية

    متغير م = 0
    بينما (م < عدد_معالجات_نشطة)
        متغير عنوان_صندوق = ثابت_عنوان_صندوق_بريد + (م * ثابت_مقاس_صندوق)
        mem_write_dword(عنوان_صندوق + 4، 0)
        mem_write_dword(عنوان_صندوق، علم_shootdown_كامل)
        م = م + 1
    نهاية

    عداد_shootdown = عداد_shootdown + 1
    ارجع 1
نهاية

# إرسال طلب Shootdown لنطاق من الصفحات
دالة إرسال_shootdown_نطاق(عنوان_بداية، عنوان_نهاية)
    إذا (عدد_معالجات_نشطة <= 1)
        ارجع 1
    نهاية

    متغير م = 0
    بينما (م < عدد_معالجات_نشطة)
        متغير عنوان_صندوق = ثابت_عنوان_صندوق_بريد + (م * ثابت_مقاس_صندوق)
        mem_write_dword(عنوان_صندوق + 4، عنوان_بداية & (~4095))
        mem_write_dword(عنوان_صندوق + 8، عنوان_نهاية)
        mem_write_dword(عنوان_صندوق، علم_shootdown_نطاق)
        م = م + 1
    نهاية

    عداد_shootdown = عداد_shootdown + 1
    ارجع 1
نهاية

# معالجة طلب Shootdown الوارد (تُستدعى من معالج المقاطعات)
دالة معالجة_shootdown_وارد(ترتيب_المعالج)
    متغير عنوان_صندوق = ثابت_عنوان_صندوق_بريد + (ترتيب_المعالج * ثابت_مقاس_صندوق)
    متغير العلم = mem_read_dword(عنوان_صندوق)

    إذا (العلم == علم_shootdown_بلا)
        # لا طلب — عودة
        ارجع 0
    نهاية

    إذا (العلم == علم_shootdown_صفحة)
        # إبطال صفحة واحدة
        متغير العنوان = mem_read_dword(عنوان_صندوق + 4)
        sad_ll_invlpg(العنوان)
        عداد_إبطال_صفحة = عداد_إبطال_صفحة + 1
    نهاية

    إذا (العلم == علم_shootdown_كامل)
        # مسح كامل
        sad_ll_flush_tlb()
        عداد_مسح_كامل = عداد_مسح_كامل + 1
    نهاية

    إذا (العلم == علم_shootdown_نطاق)
        # إبطال نطاق
        متغير البداية = mem_read_dword(عنوان_صندوق + 4)
        متغير النهاية = mem_read_dword(عنوان_صندوق + 8)
        إبطال_نطاق(البداية، النهاية)
    نهاية

    # مسح العلم
    mem_write_dword(عنوان_صندوق، علم_shootdown_بلا)
    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تبديل فضاء العناوين (مع/بدون PCID)
# ═══════════════════════════════════════════════════════════════════════════════

# تبديل فضاء العناوين — تحميل CR3 جديد
دالة تبديل_فضاء_عناوين(دليل_صفحات_جديد، معرف_عملية)
    إذا (pcid_مفعل == 1)
        # استخدام PCID — لا نمسح TLB
        متغير معرف_pcid = بحث_pcid_لعملية(معرف_عملية)
        إذا (معرف_pcid == ثابت_pcid_بلا)
            # تعيين PCID جديد
            معرف_pcid = تعيين_pcid(معرف_عملية)
        نهاية

        # CR3 مع PCID: بتات 0-11 = PCID، بتات 12+ = عنوان دليل الصفحات
        # نحتاج أيضاً بت 63 (NOFLUSH) لتجنب مسح TLB (في 64بت)
        # في 32بت مع PCID، نستخدم فقط البتات السفلية
        متغير cr3_جديد = (دليل_صفحات_جديد & (~4095)) | (معرف_pcid & 4095)
        sad_ll_write_cr3(cr3_جديد)
        pcid_حالي = معرف_pcid
    وإلا
        # بدون PCID — تحميل CR3 عادي (يمسح TLB تلقائياً)
        sad_ll_write_cr3(دليل_صفحات_جديد)
    نهاية

    عداد_تبديل_فضاء = عداد_تبديل_فضاء + 1
    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إبطال TLB مع Shootdown (واجهة عامة)
# ═══════════════════════════════════════════════════════════════════════════════

# إبطال صفحة مع إخطار معالجات SMP
دالة إبطال_صفحة_عام(عنوان_صفحة)
    # إبطال محلي
    إبطال_صفحة(عنوان_صفحة)

    # إخطار المعالجات الأخرى
    إرسال_shootdown_صفحة(عنوان_صفحة)
    ارجع 1
نهاية

# مسح TLB كامل مع إخطار معالجات SMP
دالة مسح_tlb_عام()
    مسح_tlb_كامل()
    إرسال_shootdown_كامل()
    ارجع 1
نهاية

# إبطال نطاق مع إخطار معالجات SMP
دالة إبطال_نطاق_عام(عنوان_بداية، عنوان_نهاية)
    إبطال_نطاق(عنوان_بداية، عنوان_نهاية)
    إرسال_shootdown_نطاق(عنوان_بداية، عنوان_نهاية)
    ارجع 1
نهاية

