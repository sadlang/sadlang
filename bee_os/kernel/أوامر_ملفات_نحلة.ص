# ══════════════════════════════════════════════
# rm — حذف ملف
# ══════════════════════════════════════════════

صدّر دالة shcmd_rm(معرف_ملف)
    إذا (معرف_ملف == 1) ارجع -1 نهاية    # لا تحذف الجذر
    
    متغير وجد = 0
    إذا (shcmd_صالح_1 == 1)
        إذا (shcmd_معرف_1 == معرف_ملف) shcmd_صالح_1 = 0 نهاية
        إذا (shcmd_معرف_1 == معرف_ملف) وجد = 1 نهاية
    نهاية
    إذا (shcmd_صالح_2 == 1)
        إذا (shcmd_معرف_2 == معرف_ملف) shcmd_صالح_2 = 0 نهاية
        إذا (shcmd_معرف_2 == معرف_ملف) وجد = 1 نهاية
    نهاية
    إذا (shcmd_صالح_3 == 1)
        إذا (shcmd_معرف_3 == معرف_ملف) shcmd_صالح_3 = 0 نهاية
        إذا (shcmd_معرف_3 == معرف_ملف) وجد = 1 نهاية
    نهاية
    إذا (shcmd_صالح_4 == 1)
        إذا (shcmd_معرف_4 == معرف_ملف) shcmd_صالح_4 = 0 نهاية
        إذا (shcmd_معرف_4 == معرف_ملف) وجد = 1 نهاية
    نهاية
    إذا (shcmd_صالح_5 == 1)
        إذا (shcmd_معرف_5 == معرف_ملف) shcmd_صالح_5 = 0 نهاية
        إذا (shcmd_معرف_5 == معرف_ملف) وجد = 1 نهاية
    نهاية
    إذا (shcmd_صالح_6 == 1)
        إذا (shcmd_معرف_6 == معرف_ملف) shcmd_صالح_6 = 0 نهاية
        إذا (shcmd_معرف_6 == معرف_ملف) وجد = 1 نهاية
    نهاية
    إذا (shcmd_صالح_7 == 1)
        إذا (shcmd_معرف_7 == معرف_ملف) shcmd_صالح_7 = 0 نهاية
        إذا (shcmd_معرف_7 == معرف_ملف) وجد = 1 نهاية
    نهاية
    
    إذا (وجد == 1) shcmd_أوامر_rm = shcmd_أوامر_rm + 1 نهاية
    ارجع وجد - 1
نهاية

# ══════════════════════════════════════════════
# ls — عرض محتويات دليل
# ══════════════════════════════════════════════

صدّر دالة shcmd_ls(معرف_دليل)
    kernel_print_string("ls [dir ")
    kernel_print_number(معرف_دليل)
    kernel_print_string("]:")
    kernel_print_number(10)
    
    متغير عدد = 0
    
    إذا (shcmd_صالح_1 == 1)
        إذا (shcmd_أب_1 == معرف_دليل)
            kernel_print_string("  id=")
            kernel_print_number(shcmd_معرف_1)
            إذا (shcmd_صنف_1 == shcmd_صنف_دليل) kernel_print_string(" [D]") نهاية
            إذا (shcmd_صنف_1 == shcmd_صنف_ملف) kernel_print_string(" [F]") نهاية
            kernel_print_string(" sz=")
            kernel_print_number(shcmd_مقاس_1)
            kernel_print_number(10)
            عدد = عدد + 1
        نهاية
    نهاية
    إذا (shcmd_صالح_2 == 1)
        إذا (shcmd_أب_2 == معرف_دليل) عدد = عدد + 1 نهاية
    نهاية
    إذا (shcmd_صالح_3 == 1)
        إذا (shcmd_أب_3 == معرف_دليل) عدد = عدد + 1 نهاية
    نهاية
    إذا (shcmd_صالح_4 == 1)
        إذا (shcmd_أب_4 == معرف_دليل) عدد = عدد + 1 نهاية
    نهاية
    إذا (shcmd_صالح_5 == 1)
        إذا (shcmd_أب_5 == معرف_دليل) عدد = عدد + 1 نهاية
    نهاية
    إذا (shcmd_صالح_6 == 1)
        إذا (shcmd_أب_6 == معرف_دليل) عدد = عدد + 1 نهاية
    نهاية
    إذا (shcmd_صالح_7 == 1)
        إذا (shcmd_أب_7 == معرف_دليل) عدد = عدد + 1 نهاية
    نهاية
    
    kernel_print_string("  total: ")
    kernel_print_number(عدد)
    kernel_print_number(10)
    
    shcmd_أوامر_ls = shcmd_أوامر_ls + 1
    ارجع عدد
نهاية

# ══════════════════════════════════════════════
# du — حجم إجمالي
# ══════════════════════════════════════════════

صدّر دالة shcmd_du()
    متغير إجمالي = 0
    إذا (shcmd_صالح_0 == 1) إجمالي = إجمالي + shcmd_مقاس_0 نهاية
    إذا (shcmd_صالح_1 == 1) إجمالي = إجمالي + shcmd_مقاس_1 نهاية
    إذا (shcmd_صالح_2 == 1) إجمالي = إجمالي + shcmd_مقاس_2 نهاية
    إذا (shcmd_صالح_3 == 1) إجمالي = إجمالي + shcmd_مقاس_3 نهاية
    إذا (shcmd_صالح_4 == 1) إجمالي = إجمالي + shcmd_مقاس_4 نهاية
    إذا (shcmd_صالح_5 == 1) إجمالي = إجمالي + shcmd_مقاس_5 نهاية
    إذا (shcmd_صالح_6 == 1) إجمالي = إجمالي + shcmd_مقاس_6 نهاية
    إذا (shcmd_صالح_7 == 1) إجمالي = إجمالي + shcmd_مقاس_7 نهاية
    ارجع إجمالي
