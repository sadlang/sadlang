# ══════════════════════════════════════════════
# خانة فارغة
# ══════════════════════════════════════════════

دالة shcmd_خانة_فارغة()
    إذا (shcmd_صالح_1 == 0) ارجع 1 نهاية
    إذا (shcmd_صالح_2 == 0) ارجع 2 نهاية
    إذا (shcmd_صالح_3 == 0) ارجع 3 نهاية
    إذا (shcmd_صالح_4 == 0) ارجع 4 نهاية
    إذا (shcmd_صالح_5 == 0) ارجع 5 نهاية
    إذا (shcmd_صالح_6 == 0) ارجع 6 نهاية
    إذا (shcmd_صالح_7 == 0) ارجع 7 نهاية
    ارجع -1
