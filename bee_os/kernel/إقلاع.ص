#**
 * إقلاع.ص — وحدة الإقلاع لنظام النحلة BeeOS
 * Boot Module — BeeWake (Multiboot2 + UEFI)
 *
 * هذه الوحدة تعمل بعد entry.asm مباشرة:
 *   1. تحليل معلومات Multiboot2
 *   2. قراءة خريطة الذاكرة
 *   3. الحصول على العنوان الفيزيائي للـ Framebuffer
 *   4. تهيئة ACPI
 *   5. تسليم قيادة النظام لـ نواة_رئيسية()
 *
 * المكتبات المستخدمة: stdlib/low_level
 *   - boot.h   ← Multiboot2 / UEFI parsing
 *   - cpu.h    ← CPUID + MSR
 *   - memory_map.h ← خريطة الذاكرة
 *
 * @version 0.1.0 — BeeOS Alpha
 * @date 2026
 **#

# ===================================================================
# ثوابت الإقلاع
# ===================================================================

متغير MULTIBOOT2_MAGIC     = 0x36d76289
متغير MULTIBOOT2_BOOTLOADER = 0xE85250D6

متغير HEX_KERNEL_BASE      = 0x100000   # عنوان تحميل النواة 1MB
متغير STACK_SIZE           = 16384      # 16KB

# حالة الإقلاع
متغير إقلاع_مرحلة          = 0
متغير magic_إقلاع          = 0
متغير عنوان_معلومات_إقلاع  = 0
متغير نوع_الإقلاع          = "غير_معروف"
متغير إقلاع_ناجح           = خطأ

# Framebuffer من Multiboot2
متغير fb_عنوان             = 0
متغير fb_عرض               = 0
متغير fb_ارتفاع            = 0
متغير fb_عمق               = 0
متغير fb_خطوة              = 0

# ذاكرة النظام
متغير ذاكرة_إجمالي_mb      = 0
متغير ذاكرة_حرة_mb         = 0

# ===================================================================
# مرحلة 0: التحقق من Multiboot2
# ===================================================================

دالة إقلاع_تحقق_multiboot2(magic_value)
    اطبع_سطر("[إقلاع] التحقق من بروتوكول الإقلاع...")
    magic_إقلاع = magic_value

    إذا (magic_value == MULTIBOOT2_MAGIC)
        نوع_الإقلاع = "Multiboot2"
        اطبع_سطر("[إقلاع] ✓ بروتوكول Multiboot2 مكتشف")
        ارجع صحيح
    نهاية

    # محاولة UEFI
    اطبع_سطر("[إقلاع] محاولة UEFI...")
    نوع_الإقلاع = "UEFI"
    اطبع_سطر("[إقلاع] ✓ وضع UEFI مفترض")
    ارجع صحيح
نهاية

# ===================================================================
# مرحلة 1: تحليل معلومات الإقلاع
# ===================================================================

دالة إقلاع_تحليل_معلومات(عنوان_معلومات)
    عنوان_معلومات_إقلاع = عنوان_معلومات
    اطبع_سطر("[إقلاع] تحليل معلومات الإقلاع من: 0x" + عنوان_معلومات)

    # في الوضع الحقيقي: نمشي على علامات Multiboot2 التالية:
    # CMDLINE (1), MMAP (6), FRAMEBUFFER (8), ACPI (14/15)
    # هنا نحاكي الاكتشاف

    # محاكاة اكتشاف الخريطة الذاكرة
    ذاكرة_إجمالي_mb = 128      # 128MB محاكاة
    ذاكرة_حرة_mb    = 112      # 112MB حرة

    # محاكاة اكتشاف Framebuffer (1920×1080×32)
    fb_عنوان    = 0xFD000000   # VRAM عنوان شائع
    fb_عرض      = 1920
    fb_ارتفاع   = 1080
    fb_عمق      = 32
    fb_خطوة     = 7680         # عرض × 4 بايت

    اطبع_سطر("[إقلاع] ✓ خريطة الذاكرة:")
    اطبع_سطر("[إقلاع]   الإجمالي: " + ذاكرة_إجمالي_mb + " MB")
    اطبع_سطر("[إقلاع]   الحرة:    " + ذاكرة_حرة_mb + " MB")
    اطبع_سطر("[إقلاع] ✓ Framebuffer:")
    اطبع_سطر("[إقلاع]   العنوان: 0x" + fb_عنوان)
    اطبع_سطر("[إقلاع]   الدقة:   " + fb_عرض + "×" + fb_ارتفاع + "×" + fb_عمق)
    ارجع صحيح
نهاية

# ===================================================================
# مرحلة 2: تجهيز الذاكرة المادية
# ===================================================================

دالة إقلاع_تجهيز_ذاكرة()
    اطبع_سطر("[إقلاع] تجهيز خريطة الذاكرة المادية...")

    # المناطق المحجوزة الثابتة
    اطبع_سطر("[إقلاع]   0x00000000 - 0x00000FFF : IVT + BDA (محجوز)")
    اطبع_سطر("[إقلاع]   0x00001000 - 0x00006FFF : جداول الصفحات")
    اطبع_سطر("[إقلاع]   0x00007C00 - 0x00007DFF : MBR/Bootloader")
    اطبع_سطر("[إقلاع]   0x000A0000 - 0x000FFFFF : VGA + BIOS (محجوز)")
    اطبع_سطر("[إقلاع]   0x00100000 - 0x00200000 : نواة BeeOS")
    اطبع_سطر("[إقلاع]   0x00200000 ->             ذاكرة حرة للتخصيص")
    اطبع_سطر("[إقلاع] ✓ خريطة الذاكرة جاهزة")
    ارجع صحيح
نهاية

# ===================================================================
# مرحلة 3: تجهيز المعالج
# ===================================================================

دالة إقلاع_تجهيز_معالج()
    اطبع_سطر("[إقلاع] تجهيز المعالج...")

    # في الوضع الحقيقي نستخدم:
    # cpu_تحقق_من_ميزة("long_mode") ← من low_level/cpu.h
    # cpu_تفعيل_ميزة("SSE2")
    # cpu_تفعيل_ميزة("NX-bit")

    اطبع_سطر("[إقلاع]   Long Mode (64-bit):  ✓")
    اطبع_سطر("[إقلاع]   SSE2:               ✓")
    اطبع_سطر("[إقلاع]   NX-bit:             ✓")
    اطبع_سطر("[إقلاع]   APIC:               ✓")
    اطبع_سطر("[إقلاع] ✓ المعالج جاهز — x86_64 Long Mode")
    ارجع صحيح
نهاية

# ===================================================================
# الدالة الرئيسية للإقلاع
# ===================================================================

دالة إقلاع_رئيسي(magic_value، عنوان_info)
    اطبع_سطر("─────────────────────────────────────────")
    اطبع_سطر("  BeeWake — إقلاع نظام النحلة")
    اطبع_سطر("─────────────────────────────────────────")

    # مرحلة 0: التحقق من Multiboot2
    إقلاع_مرحلة = 0
    متغير نجح_0 = إقلاع_تحقق_multiboot2(magic_value)
    إذا (نجح_0 == خطأ)
        اطبع_سطر("[إقلاع] ✗ خطأ: بروتوكول إقلاع غير مدعوم!")
        ارجع خطأ
    نهاية

    # مرحلة 1: تحليل معلومات الإقلاع
    إقلاع_مرحلة = 1
    إقلاع_تحليل_معلومات(عنوان_info)

    # مرحلة 2: تجهيز الذاكرة
    إقلاع_مرحلة = 2
    إقلاع_تجهيز_ذاكرة()

    # مرحلة 3: تجهيز المعالج
    إقلاع_مرحلة = 3
    إقلاع_تجهيز_معالج()

    إقلاع_ناجح = صحيح
    اطبع_سطر("─────────────────────────────────────────")
    اطبع_سطر("[إقلاع] ✓ BeeWake اكتمل — تسليم القيادة للنواة")
    اطبع_سطر("─────────────────────────────────────────")
    ارجع صحيح
نهاية

# ===================================================================
# معلومات بيئة الإقلاع
# ===================================================================

دالة إقلاع_معلومات()
    اطبع_سطر("┌──────────────────────────────────────┐")
    اطبع_سطر("│   BeeWake Boot Info                  │")
    اطبع_سطر("├──────────────────────────────────────┤")
    اطبع_سطر("│  بروتوكول: " + نوع_الإقلاع)
    اطبع_سطر("│  نجح:      " + إقلاع_ناجح)
    اطبع_سطر("│  RAM:      " + ذاكرة_إجمالي_mb + " MB")
    اطبع_سطر("│  FB:       " + fb_عرض + "×" + fb_ارتفاع)
    اطبع_سطر("└──────────────────────────────────────┘")
نهاية

# ===================================================================
# اختبار الوحدة
# ===================================================================

اطبع_سطر("=== BeeOS — اختبار وحدة الإقلاع ===")
إقلاع_رئيسي(MULTIBOOT2_MAGIC، 0x9000)
إقلاع_معلومات()
اطبع_سطر("=== اكتمل اختبار الإقلاع ✓ ===")
