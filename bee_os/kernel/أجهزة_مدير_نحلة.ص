# ═══════════════════════════════════════════════════════════════════════════════
# ربط الأجهزة بتعريفاتها (Auto-binding)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة dm_auto_bind()
    متغير bound = 0 + 0
    متغير d = 0 + 0
    بينما (d < devmgr_dev_count)
        متغير dtype = dm_get_type(d) + 0
        متغير dstate = dm_get_state(d) + 0
        إذا (dstate == DEV_STATE_DETECTED)
            # ابحث عن تعريف مناسب
            متغير drv = 0 + 0
            بينما (drv < devmgr_drv_count)
                متغير drv_t = dm_get_drv_type(drv) + 0
                إذا (drv_t == dtype)
                    # ربط
                    dm_set_driver(d، drv)
                    dm_set_state(d، DEV_STATE_INIT)
                    dm_inc_drv_devcount(drv)
                    bound = bound + 1

                    dm_serial_اطبع("[DM] Bound dev ")
                    dm_serial_رقم(d + 0)
                    dm_serial_اطبع(" -> drv ")
                    dm_serial_رقم(drv + 0)
                    dm_serial_سطر()
                    اخرج
                نهاية
                drv = drv + 1
            نهاية
        نهاية
        d = d + 1
    نهاية
    devmgr_bindings = devmgr_bindings + bound
    ارجع bound + 0
نهاية

