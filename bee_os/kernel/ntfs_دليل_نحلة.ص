# ══════════════════════════════════════════════
# القسم 3: تحليل $INDEX_ROOT
# ══════════════════════════════════════════════

#* ── بنية $INDEX_ROOT ──
   
   الإزاحة  الحجم  الوصف
   0x00     4      نوع السمة المفهرسة (عادة 0x30 = $FILE_NAME)
   0x04     4      قاعدة الترتيب (Collation Rule)
   0x08     4      حجم كتلة الفهرس (بالبايت)
   0x0C     1      كتل لكل سجل فهرس
   0x0D     3      محاذاة
   
   يليه رأس عقدة الفهرس (Index Node Header):
   0x10     4      إزاحة أول مدخل (من بداية العقدة)
   0x14     4      حجم المدخلات الكلي (من بداية العقدة)   
   0x18     4      حجم المخصص للمدخلات
   0x1C     4      أعلام (0x01 = has large index)
*#

#* ── تحليل سمة $INDEX_ROOT لدليل ──
   
   يقرأ سمة $INDEX_ROOT ويحلل مدخلاتها.
   هذه السمة مقيمة دائماً في سجل MFT.
   
   المدخلات:
   - رقم_قسم: رقم القسم NTFS
   - عنوان_سجل: عنوان سجل MFT للدليل
   
   المخرجات:
   - عدد المدخلات المحللة
   - -1 عند الفشل
*#
صدّر دالة نتفس_حلّل_جذر_فهرس(رقم_قسم، عنوان_سجل)
    # البحث عن سمة $INDEX_ROOT
    متغير عنوان_سمة = نتفس_ابحث_سمة(عنوان_سجل, سمة_جذر_فهرس)
    إذا (عنوان_سمة == 0)
        kernel_print_string("  [NTFS-DIR] No $INDEX_ROOT attribute")
        kernel_print_number(10)
        إحصاء_أخطاء_دليل = إحصاء_أخطاء_دليل + 1
        ارجع -1
    نهاية
    
    # قراءة بيانات السمة المقيمة
    متغير إزاحة_بيانات = نتفس_اقرأ_16بت(عنوان_سمة + 20)
    متغير بيانات = عنوان_سمة + إزاحة_بيانات
    
    # التحقق من نوع السمة المفهرسة
    متغير صنف_مفهرس = نتفس_اقرأ_32بت(بيانات)
    إذا (صنف_مفهرس != سمة_اسم_ملف)
        kernel_print_string("  [NTFS-DIR] Index root not indexing $FILE_NAME")
        kernel_print_number(10)
    نهاية
    
    # قراءة رأس العقدة
    # رأس العقدة يبدأ من إزاحة 16 بايت بعد بداية البيانات
    متغير إزاحة_أول = نتفس_اقرأ_32بت(بيانات + 16)
    متغير مقاس_مدخلات = نتفس_اقرأ_32بت(بيانات + 20)
    متغير أعلام_عقدة = نتفس_اقرأ_32بت(بيانات + 28)
    
    # تحليل المدخلات
    متغير قاعدة = بيانات + 16
    متغير موقع = إزاحة_أول + 0
    متغير عدد = 0
    
    بينما (موقع < مقاس_مدخلات)
        إذا (عدد >= 16)
            ارجع عدد
        نهاية
        
        متغير عنوان_مدخل = قاعدة + موقع
        
        # قراءة رأس المدخل
        متغير مرجع_مفت = نتفس_اقرأ_32بت(عنوان_مدخل)
        متغير مرجع_علوي = نتفس_اقرأ_16بت(عنوان_مدخل + 4)
        متغير رقم_سجل_ملف = مرجع_مفت + مرجع_علوي * 4294967296
        
        متغير طول_مدخل = نتفس_اقرأ_16بت(عنوان_مدخل + 8)
        متغير طول_محتوى = نتفس_اقرأ_16بت(عنوان_مدخل + 10)
        متغير أعلام_مدخل = نتفس_اقرأ_32بت(عنوان_مدخل + 12)
        
        # التحقق من آخر مدخل
        إذا (أعلام_مدخل % 4 >= 2)
            # آخر مدخل — LAST_ENTRY
            ارجع عدد
        نهاية
        
        إذا (طول_مدخل == 0)
            ارجع عدد
        نهاية
        
        # تحليل بيانات $FILE_NAME المضمنة
        إذا (طول_محتوى > 0)
            متغير بيانات_اسم = عنوان_مدخل + 16
            
            # قراءة أعلام الملف
            متغير أعلام_ملف = نتفس_اقرأ_32بت(بيانات_اسم + 56)
            متغير هو_دليل = 0
            # التحقق من بت Directory (bit 28)
            إذا (أعلام_ملف / 268435456 % 2 == 1)
                هو_دليل = 1
            نهاية
            
            # قراءة حجم الملف
            متغير مقاس_ملف = نتفس_اقرأ_64بت(بيانات_اسم + 48)
            
            # طول ومساحة الاسم
            متغير طول_اسم = mem_read_byte(بيانات_اسم + 64)
            متغير مساحة_اسم = mem_read_byte(بيانات_اسم + 65)
            
            # وقت الإنشاء
            متغير وقت_إنشاء = نتفس_اقرأ_64بت(بيانات_اسم + 8)
            
            # تخزين المدخل
            نتفس_أضف_مدخل(رقم_سجل_ملف, أعلام_ملف, مقاس_ملف, هو_دليل, طول_اسم, مساحة_اسم, بيانات_اسم + 66, وقت_إنشاء)
            عدد = عدد + 1
        نهاية
        
        موقع = موقع + طول_مدخل
    نهاية
    
    إحصاء_فهارس_محللة = إحصاء_فهارس_محللة + 1
    ارجع عدد
نهاية

# ══════════════════════════════════════════════
# القسم 4: تحليل $INDEX_ALLOCATION (INDX records)
# ══════════════════════════════════════════════

#* ── تحليل سجل INDX واحد ──
   
   بنية سجل INDX:
   ───────────────
   0x00  4   توقيع "INDX"
   0x04  2   إزاحة مصفوفة التحديث
   0x06  2   حجم مصفوفة التحديث
   0x08  8   رقم $LogFile
   0x10  8   رقم VCN لهذا السجل
   0x18  4   إزاحة أول مدخل (من 0x18)
   0x1C  4   حجم المدخلات
   0x20  4   حجم المخصص
   0x24  1   أعلام عقدة
   
   المدخلات:
   - عنوان_سجل_فهرس: عنوان سجل INDX في الذاكرة
   
   المخرجات:
   - عدد المدخلات المحللة
*#
صدّر دالة نتفس_حلّل_سجل_فهرس(عنوان_سجل_فهرس)
    # التحقق من توقيع INDX
    متغير توقيع = نتفس_اقرأ_32بت(عنوان_سجل_فهرس)
    إذا (توقيع != توقيع_إندكس)
        kernel_print_string("  [NTFS-DIR] Bad INDX signature: 0x")
        serial_put_hex(توقيع)
        kernel_print_number(10)
        إحصاء_أخطاء_دليل = إحصاء_أخطاء_دليل + 1
        ارجع -1
    نهاية
    
    # قراءة رأس العقدة (يبدأ من الإزاحة 0x18)
    متغير قاعدة = عنوان_سجل_فهرس + 24
    متغير إزاحة_أول = نتفس_اقرأ_32بت(قاعدة)
    متغير مقاس_مدخلات = نتفس_اقرأ_32بت(قاعدة + 4)
    
    متغير موقع = إزاحة_أول + 0
    متغير عدد = 0
    
    بينما (موقع < مقاس_مدخلات)
        إذا (عدد_مدخلات_دليل >= 16)
            ارجع عدد
        نهاية
        
        متغير عنوان_مدخل = قاعدة + موقع
        
        متغير مرجع_مفت = نتفس_اقرأ_32بت(عنوان_مدخل)
        متغير مرجع_علوي = نتفس_اقرأ_16بت(عنوان_مدخل + 4)
        متغير رقم_سجل_ملف = مرجع_مفت + مرجع_علوي * 4294967296
        
        متغير طول_مدخل = نتفس_اقرأ_16بت(عنوان_مدخل + 8)
        متغير طول_محتوى = نتفس_اقرأ_16بت(عنوان_مدخل + 10)
        متغير أعلام_مدخل = نتفس_اقرأ_32بت(عنوان_مدخل + 12)
        
        # التحقق من آخر مدخل
        إذا (أعلام_مدخل % 4 >= 2)
            ارجع عدد
        نهاية
        
        إذا (طول_مدخل == 0)
            ارجع عدد
        نهاية
        
        إذا (طول_محتوى > 0)
            متغير بيانات_اسم = عنوان_مدخل + 16
            
            متغير أعلام_ملف = نتفس_اقرأ_32بت(بيانات_اسم + 56)
            متغير هو_دليل = 0
            إذا (أعلام_ملف / 268435456 % 2 == 1)
                هو_دليل = 1
            نهاية
            
            متغير مقاس_ملف = نتفس_اقرأ_64بت(بيانات_اسم + 48)
            متغير طول_اسم = mem_read_byte(بيانات_اسم + 64)
            متغير مساحة_اسم = mem_read_byte(بيانات_اسم + 65)
            متغير وقت_إنشاء = نتفس_اقرأ_64بت(بيانات_اسم + 8)
            
            نتفس_أضف_مدخل(رقم_سجل_ملف, أعلام_ملف, مقاس_ملف, هو_دليل, طول_اسم, مساحة_اسم, بيانات_اسم + 66, وقت_إنشاء)
            عدد = عدد + 1
        نهاية
        
        موقع = موقع + طول_مدخل
    نهاية
    
    إحصاء_فهارس_محللة = إحصاء_فهارس_محللة + 1
    ارجع عدد
نهاية

# ══════════════════════════════════════════════
# القسم 5: قراءة محتويات الدليل الكاملة
# ══════════════════════════════════════════════

#* ── قراءة كل محتويات دليل (readdir) ──
   
   تقرأ كل مدخلات دليل NTFS بما في ذلك:
   1. مدخلات $INDEX_ROOT (المقيمة)
   2. مدخلات $INDEX_ALLOCATION (غير المقيمة) إن وُجدت
   
   المدخلات:
   - رقم_قسم: رقم القسم NTFS
   - رقم_سجل_دليل: رقم سجل MFT للدليل
   
   المخرجات:
   - عدد المدخلات المقروءة
   - -1 عند الفشل
*#
صدّر دالة نتفس_اقرأ_دليل(رقم_قسم، رقم_سجل_دليل)
    # تصفير النتائج السابقة
    نتفس_صفّر_مدخلات()
    
    # تحميل سجل MFT
    متغير عنوان_سجل = نتفس_حمّل_سجل(رقم_قسم, رقم_سجل_دليل)
    إذا (عنوان_سجل == 0)
        kernel_print_string("  [NTFS-DIR] Cannot load MFT record #")
        kernel_print_number(رقم_سجل_دليل)
        kernel_print_number(10)
        إحصاء_أخطاء_دليل = إحصاء_أخطاء_دليل + 1
        ارجع -1
    نهاية
    
    # 1. تحليل $INDEX_ROOT
    متغير عدد_جذر = نتفس_حلّل_جذر_فهرس(رقم_قسم, عنوان_سجل)
    إذا (عدد_جذر < 0)
        ارجع -1
    نهاية
    
    # 2. تحليل $INDEX_ALLOCATION (إن وُجدت)
    متغير سمة_تخصيص = نتفس_ابحث_سمة(عنوان_سجل, سمة_تخصيص_فهرس)
    إذا (سمة_تخصيص > 0)
        # سمة غير مقيمة — نقرأ سجلات INDX
        متغير مقاس_كلي = نتفس_اقرأ_64بت(سمة_تخصيص + 48)
        
        إذا (مقاس_كلي > 0)
            # نقرأ سجل INDX تلو الآخر
            متغير مخزن_فهرس = kernel_allocate(مقاس_سجل_فهرس)
            إذا (مخزن_فهرس > 0)
                متغير إزاحة_فهرس = 0
                بينما (إزاحة_فهرس < مقاس_كلي)
                    إذا (عدد_مدخلات_دليل >= 16)
                        kernel_free(مخزن_فهرس)
                        إحصاء_قراءات_دليل = إحصاء_قراءات_دليل + 1
                        ارجع عدد_مدخلات_دليل
                    نهاية
                    
                    # قراءة سجل INDX
                    متغير مقروء = نتفس_اقرأ_سمة_غير_مقيمة(رقم_قسم, سمة_تخصيص, مخزن_فهرس, إزاحة_فهرس, مقاس_سجل_فهرس)
                    إذا (مقروء > 0)
                        نتفس_حلّل_سجل_فهرس(مخزن_فهرس)
                    نهاية
                    
                    إزاحة_فهرس = إزاحة_فهرس + مقاس_سجل_فهرس
                نهاية
                kernel_free(مخزن_فهرس)
            نهاية
        نهاية
    نهاية
    
    إحصاء_قراءات_دليل = إحصاء_قراءات_دليل + 1
    ارجع عدد_مدخلات_دليل
نهاية

# ══════════════════════════════════════════════
# القسم 6: البحث عن ملف باسم معين
# ══════════════════════════════════════════════

#* ── مقارنة اسم ملف مع نمط بحث ──
   
   تقارن اسم ملف UTF-16LE مع نمط ASCII.
   المقارنة غير حساسة لحالة الأحرف (case-insensitive).
   
   المدخلات:
   - عنوان_اسم: عنوان اسم الملف UTF-16LE
   - طول_اسم: طول الاسم بالمحارف
   - عنوان_نمط: عنوان نمط البحث (في الذاكرة كبايتات ASCII)
   - طول_نمط: طول النمط
   
   المخرجات:
   - 1 = تطابق
   - 0 = لا تطابق
*#
صدّر دالة نتفس_قارن_اسم(عنوان_اسم، طول_اسم، عنوان_نمط، طول_نمط)
    إذا (طول_اسم != طول_نمط)
        ارجع 0
    نهاية
    
    متغير ع = 0
    بينما (ع < طول_اسم)
        # قراءة حرف UTF-16 من الاسم
        متغير حرف_اسم = نتفس_اقرأ_16بت(عنوان_اسم + ع * 2)
        # قراءة حرف ASCII من النمط
        متغير حرف_نمط = mem_read_byte(عنوان_نمط + ع)
        
        # تحويل إلى حروف صغيرة (ASCII only)
        متغير ح1 = حرف_اسم + 0
        متغير ح2 = حرف_نمط + 0
        
        إذا (ح1 >= 65)
            إذا (ح1 <= 90)
                ح1 = ح1 + 32
            نهاية
        نهاية
        إذا (ح2 >= 65)
            إذا (ح2 <= 90)
                ح2 = ح2 + 32
            نهاية
        نهاية
        
        إذا (ح1 != ح2)
            ارجع 0
        نهاية
        
        ع = ع + 1
    نهاية
    
    ارجع 1
نهاية

#* ── البحث عن ملف في $INDEX_ROOT ──
   يبحث في مدخلات $INDEX_ROOT عن ملف باسم معين.
   
   المدخلات:
   - عنوان_سجل: عنوان سجل MFT للدليل
   - عنوان_نمط: عنوان نمط البحث
   - طول_نمط: طول النمط
   
   المخرجات:
   - رقم سجل MFT للملف المطابق
   - 0 = لم يُوجد
*#
صدّر دالة نتفس_ابحث_في_جذر(عنوان_سجل، عنوان_نمط، طول_نمط)
    متغير صفة = نتفس_ابحث_سمة(عنوان_سجل, سمة_جذر_فهرس)
    إذا (صفة == 0)
        ارجع 0
    نهاية
    
    متغير إزاحة_بيانات = نتفس_اقرأ_16بت(صفة + 20)
    متغير بيانات = صفة + إزاحة_بيانات
    
    متغير إزاحة_أول = نتفس_اقرأ_32بت(بيانات + 16)
    متغير مقاس_مدخلات = نتفس_اقرأ_32بت(بيانات + 20)
    
    متغير قاعدة = بيانات + 16
    متغير موقع = إزاحة_أول + 0
    
    بينما (موقع < مقاس_مدخلات)
        متغير عنوان_مدخل = قاعدة + موقع
        
        متغير طول_مدخل = نتفس_اقرأ_16بت(عنوان_مدخل + 8)
        متغير طول_محتوى = نتفس_اقرأ_16بت(عنوان_مدخل + 10)
        متغير أعلام_مدخل = نتفس_اقرأ_32بت(عنوان_مدخل + 12)
        
        إذا (أعلام_مدخل % 4 >= 2)
            ارجع 0
        نهاية
        إذا (طول_مدخل == 0)
            ارجع 0
        نهاية
        
        إذا (طول_محتوى > 0)
            متغير بيانات_اسم = عنوان_مدخل + 16
            متغير طول_اسم = mem_read_byte(بيانات_اسم + 64)
            متغير عنوان_اسم_ملف = بيانات_اسم + 66
            
            متغير تطابق = نتفس_قارن_اسم(عنوان_اسم_ملف, طول_اسم, عنوان_نمط, طول_نمط)
            إذا (تطابق == 1)
                # وجدنا الملف!
                متغير سجل_نتيجة = نتفس_اقرأ_32بت(عنوان_مدخل)
                متغير سجل_علوي = نتفس_اقرأ_16بت(عنوان_مدخل + 4)
                إحصاء_عمليات_بحث = إحصاء_عمليات_بحث + 1
                ارجع سجل_نتيجة + سجل_علوي * 4294967296
            نهاية
        نهاية
        
        موقع = موقع + طول_مدخل
    نهاية
    
    ارجع 0
