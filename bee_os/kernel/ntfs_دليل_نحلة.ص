# القسم 7: البحث الكامل (INDEX_ROOT + INDEX_ALLOCATION)
# ══════════════════════════════════════════════

#* ── البحث الكامل عن ملف في دليل ──
   
   يبحث في كل مدخلات الدليل ($INDEX_ROOT + $INDEX_ALLOCATION).
   
   المدخلات:
   - رقم_قسم: رقم القسم
   - رقم_سجل_دليل: رقم سجل MFT للدليل
   - عنوان_نمط: عنوان اسم الملف المطلوب
   - طول_نمط: طول الاسم
   
   المخرجات:
   - رقم سجل MFT للملف المطابق
   - 0 = لم يُوجد
*#
صدّر دالة نتفس_ابحث_عن_ملف(رقم_قسم، رقم_سجل_دليل، عنوان_نمط، طول_نمط)
    # تحميل سجل الدليل
    متغير عنوان_سجل = نتفس_حمّل_سجل(رقم_قسم, رقم_سجل_دليل)
    إذا (عنوان_سجل == 0)
        ارجع 0
    نهاية
    
    # 1. البحث في $INDEX_ROOT أولاً
    متغير نتيجة = نتفس_ابحث_في_جذر(عنوان_سجل, عنوان_نمط, طول_نمط)
    إذا (نتيجة > 0)
        ارجع نتيجة
    نهاية
    
    # 2. البحث في $INDEX_ALLOCATION
    متغير سمة_تخصيص = نتفس_ابحث_سمة(عنوان_سجل, سمة_تخصيص_فهرس)
    إذا (سمة_تخصيص == 0)
        ارجع 0
    نهاية
    
    متغير مقاس_كلي = نتفس_اقرأ_64بت(سمة_تخصيص + 48)
    إذا (مقاس_كلي == 0)
        ارجع 0
    نهاية
    
    متغير مخزن = kernel_allocate(مقاس_سجل_فهرس)
    إذا (مخزن == 0)
        ارجع 0
    نهاية
    
    متغير إزاحة = 0
    بينما (إزاحة < مقاس_كلي)
        # قراءة سجل INDX
        متغير مقروء = نتفس_اقرأ_سمة_غير_مقيمة(رقم_قسم, سمة_تخصيص, مخزن, إزاحة, مقاس_سجل_فهرس)
        إذا (مقروء > 0)
            # التحقق من توقيع INDX
            متغير توقيع = نتفس_اقرأ_32بت(مخزن)
            إذا (توقيع == توقيع_إندكس)
                # البحث في مدخلات السجل
                متغير قاعدة = مخزن + 24
                متغير أول = نتفس_اقرأ_32بت(قاعدة)
                متغير مقاس_م = نتفس_اقرأ_32بت(قاعدة + 4)
                
                متغير م = أول + 0
                بينما (م < مقاس_م)
                    متغير عم = قاعدة + م
                    
                    متغير طول_م = نتفس_اقرأ_16بت(عم + 8)
                    متغير طول_ع = نتفس_اقرأ_16بت(عم + 10)
                    متغير أعلام_م = نتفس_اقرأ_32بت(عم + 12)
                    
                    إذا (أعلام_م % 4 >= 2)
                        م = مقاس_م
                    وإلا
                        إذا (طول_م == 0)
                            م = مقاس_م
                        وإلا
                            إذا (طول_ع > 0)
                                متغير بن = عم + 16
                                متغير طا = mem_read_byte(بن + 64)
                                متغير عا = بن + 66
                                
                                متغير تط = نتفس_قارن_اسم(عا, طا, عنوان_نمط, طول_نمط)
                                إذا (تط == 1)
                                    متغير سج = نتفس_اقرأ_32بت(عم)
                                    متغير سع = نتفس_اقرأ_16بت(عم + 4)
                                    kernel_free(مخزن)
                                    إحصاء_عمليات_بحث = إحصاء_عمليات_بحث + 1
                                    ارجع سج + سع * 4294967296
                                نهاية
                            نهاية
                            م = م + طول_م
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
        
        إزاحة = إزاحة + مقاس_سجل_فهرس
    نهاية
    
    kernel_free(مخزن)
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# القسم 8: التنقل في المسار
# ══════════════════════════════════════════════

#* ── فتح دليل بالمسار ──
   
   يحل مسار كامل (مثل "\windows\system32")
   إلى رقم سجل MFT النهائي.
   
   المسار يُخزن كسلسلة بايتات ASCII في الذاكرة.
   الفاصل هو '\' (92) أو '/' (47).
   
   المدخلات:
   - رقم_قسم: رقم القسم
   - عنوان_مسار: عنوان المسار في الذاكرة
   - طول_مسار: طول المسار بالبايت
   
   المخرجات:
   - رقم سجل MFT النهائي
   - 0 = لم يُوجد
*#
صدّر دالة نتفس_حل_مسار(رقم_قسم، عنوان_مسار، طول_مسار)
    إذا (طول_مسار == 0)
        ارجع سجل_الجذر
    نهاية
    
    متغير سجل_حالي = سجل_الجذر + 0
    متغير بداية_جزء = 0
    متغير موقع = 0
    
    # تخطي الفاصل الأول إن وُجد
    إذا (طول_مسار > 0)
        متغير أول_حرف = mem_read_byte(عنوان_مسار)
        إذا (أول_حرف == 92)
            بداية_جزء = 1
            موقع = 1
        نهاية
        إذا (أول_حرف == 47)
            بداية_جزء = 1
            موقع = 1
        نهاية
    نهاية
    
    متغير عمق = 0
    
    بينما (موقع <= طول_مسار)
        متغير حرف = 0
        إذا (موقع < طول_مسار)
            حرف = mem_read_byte(عنوان_مسار + موقع)
        نهاية
        
        # هل وصلنا إلى فاصل أو نهاية المسار؟
        متغير فاصل = 0
        إذا (حرف == 92)
            فاصل = 1
        نهاية
        إذا (حرف == 47)
            فاصل = 1
        نهاية
        إذا (موقع == طول_مسار)
            فاصل = 1
        نهاية
        
        إذا (فاصل == 1)
            متغير طول_جزء = موقع - بداية_جزء
            إذا (طول_جزء > 0)
                # البحث عن هذا الجزء في الدليل الحالي
                متغير نتيجة = نتفس_ابحث_عن_ملف(رقم_قسم, سجل_حالي, عنوان_مسار + بداية_جزء, طول_جزء)
                إذا (نتيجة == 0)
                    # لم نجد الملف/الدليل
                    ارجع 0
                نهاية
                سجل_حالي = نتيجة + 0
                
                عمق = عمق + 1
                إذا (عمق >= اقصى_عمق_بحث)
                    kernel_print_string("  [NTFS-DIR] Path too deep")
                    kernel_print_number(10)
                    ارجع 0
                نهاية
            نهاية
            بداية_جزء = موقع + 1
        نهاية
        
        موقع = موقع + 1
    نهاية
    
    ارجع سجل_حالي
نهاية

