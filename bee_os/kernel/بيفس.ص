##
## بيفس.ص — نظام ملفات البيت السداسي (BeeFS)
## BeeFS: Hexagonal-Cell Copy-on-Write Filesystem
##
## كل خلية (ملف) = بُنية سداسية ذات 6 جيران
## كل قرص (مجلد) = خلية نحل تجمع الخلايا
## النسخ الفوري (CoW) — لا شيء يُحذف، كل تعديل ينسخ
##
## بسم الله الرحمن الرحيم
##

# ─── ثوابت BeeFS ─────────────────────────────────────────────────────────────

متغير BEEFS_MAGIC       = 0x42454546    # "BEEF" بالـ hex
متغير BEEFS_VERSION     = 1
متغير BEEFS_BLOCK_SIZE  = 4096          # 4 كيلوبايت لكل كتلة
متغير BEEFS_MAX_CELLS   = 65536         # أقصى عدد خلايا
متغير BEEFS_MAX_NAME    = 255           # أقصى طول اسم
متغير BEEFS_JOURNAL_CAP = 1024          # سجل المعاملات

# أنواع الخلايا
متغير CELL_FILE         = 1   # ملف عادي
متغير CELL_DIR          = 2   # مجلد (قرص عسل)
متغير CELL_SYMLINK      = 3   # رابط رمزي
متغير CELL_DEVICE       = 4   # جهاز
متغير CELL_FREE         = 0   # حرة

# أعلام الخلية
متغير FLAG_COW          = 1   # نسخ عند الكتابة نشط
متغير FLAG_IMMUTABLE    = 2   # غير قابل للتعديل
متغير FLAG_ENCRYPTED    = 4   # مشفّر
متغير FLAG_COMPRESSED   = 8   # مضغوط

# ─── هيكل البيانات ───────────────────────────────────────────────────────────

متغير BEEFS_خلايا        = []    # مصفوفة كل الخلايا
متغير BEEFS_عداد_خلايا   = 0
متغير BEEFS_سجل_معاملات  = []    # journal CoW
متغير BEEFS_جذر          = -1    # رقم خلية الجذر
متغير BEEFS_جاهز_للعمل   = خطأ

# ─── إنشاء خلية جديدة ────────────────────────────────────────────────────────

دالة beefs_خلية_جديدة(رقم_الخلية، النوع، اسم_الخلية، خلية_ام)
   متغير خلية = {}

   # معلومات الهوية
   خلية["id"]           = رقم_الخلية
   خلية["نوع"]         = النوع
   خلية["اسم"]         = اسم_الخلية
   خلية["ام"]           = خلية_ام      # الوالد (خلية قرص العسل)

   # البيانات
   خلية["محتوى"]       = ""
   خلية["حجم"]         = 0

   # التوقيت
   خلية["وقت_إنشاء"]   = 0
   خلية["وقت_تعديل"]   = 0
   خلية["وقت_وصول"]    = 0
   خلية["جيل"]          = 1           # رقم إصدار CoW

   # السداسية: ستة جيران
   خلية["جار_شمال"]    = -1
   خلية["جار_شمشرق"]  = -1
   خلية["جار_جنشرق"]  = -1
   خلية["جار_جنوب"]   = -1
   خلية["جار_جنغرب"]  = -1
   خلية["جار_شمغرب"]  = -1

   # CoW + أعلام
   خلية["أعلام"]        = FLAG_COW
   خلية["نسخة_ام"]      = -1           # من أي خلية نسخت
   خلية["مرجع_عد"]      = 1            # reference count

   # للمجلدات
   خلية["أبناء"]        = []

   ارجع خلية
نهاية

# ─── تهيئة نظام الملفات ──────────────────────────────────────────────────────

دالة beefs_تهيئة()
   اطبع_سطر("╔══════════════════════════════════════════╗")
   اطبع_سطر("║      BeeFS v1.0 — نظام الخلية السداسية   ║")
   اطبع_سطر("╚══════════════════════════════════════════╝")
   اطبع_سطر("")

   BEEFS_خلايا       = []
   BEEFS_عداد_خلايا = 0
   BEEFS_سجل_معاملات = []

   # إنشاء خلية الجذر (/)
   متغير جذر = beefs_خلية_جديدة(0، CELL_DIR، "/", -1)
   جذر["وقت_إنشاء"] = 1000
   جذر["أعلام"] = FLAG_IMMUTABLE  # الجذر غير قابل للحذف
   أضف(BEEFS_خلايا، جذر)
   BEEFS_عداد_خلايا = 1
   BEEFS_جذر = 0

   اطبع_سطر("[BeeFS] ✓ الجذر (/) أُنشئ (id=0)")
   اطبع_سطر("[BeeFS] ✓ حجم الكتلة: " + BEEFS_BLOCK_SIZE + " بايت")
   اطبع_سطر("[BeeFS] ✓ أقصى خلايا: " + BEEFS_MAX_CELLS)
   اطبع_سطر("")

   BEEFS_جاهز_للعمل = صحيح
   ارجع صحيح
نهاية

# ─── إيجاد خلية بالمسار ──────────────────────────────────────────────────────

دالة beefs_ابحث(اسم_مطلوب، داخل_خلية)
   إذا (داخل_خلية < 0)
      ارجع -1
   نهاية

   متغير قرص = BEEFS_خلايا[داخل_خلية]
   متغير أبناء = قرص["أبناء"]
   متغير عد_بحث = 0
   بينما (عد_بحث < أبناء.الطول())
      متغير ابن = BEEFS_خلايا[أبناء[عد_بحث]]
      إذا (ابن["اسم"] == اسم_مطلوب)
         ارجع أبناء[عد_بحث]
      نهاية
      عد_بحث = عد_بحث + 1
   نهاية
   ارجع -1
نهاية

# ─── إنشاء مجلد ──────────────────────────────────────────────────────────────

دالة beefs_مجلد(اسم_جديد، داخل_مجلد)
   إذا (BEEFS_جاهز_للعمل == خطأ)
      اطبع_سطر("[BeeFS] خطأ: النظام غير مهيأ")
      ارجع -1
   نهاية

   إذا (BEEFS_عداد_خلايا >= BEEFS_MAX_CELLS)
      اطبع_سطر("[BeeFS] خطأ: وصلنا الحد الأقصى " + BEEFS_MAX_CELLS)
      ارجع -1
   نهاية

   # تحقق من التكرار
   إذا (beefs_ابحث(اسم_جديد، داخل_مجلد) >= 0)
      اطبع_سطر("[BeeFS] خطأ: المجلد '" + اسم_جديد + "' موجود مسبقاً")
      ارجع -1
   نهاية

   متغير id_جديد = BEEFS_عداد_خلايا
   متغير قرص_جديد = beefs_خلية_جديدة(id_جديد، CELL_DIR، اسم_جديد، داخل_مجلد)
   قرص_جديد["وقت_إنشاء"] = id_جديد * 100

   أضف(BEEFS_خلايا، قرص_جديد)
   BEEFS_عداد_خلايا = BEEFS_عداد_خلايا + 1

   # أضف الابن إلى الوالد
   متغير أبناء_والد = BEEFS_خلايا[داخل_مجلد]["أبناء"]
   أضف(أبناء_والد، id_جديد)
   BEEFS_خلايا[داخل_مجلد]["أبناء"] = أبناء_والد

   اطبع_سطر("[BeeFS] 📁 مجلد جديد: '" + اسم_جديد + "' (id=" + id_جديد + ")")
   ارجع id_جديد
نهاية

# ─── إنشاء ملف ───────────────────────────────────────────────────────────────

دالة beefs_ملف(اسم_ملف، محتوى_ملف، داخل_مجلد)
   إذا (BEEFS_جاهز_للعمل == خطأ)
      ارجع -1
   نهاية

   إذا (beefs_ابحث(اسم_ملف، داخل_مجلد) >= 0)
      اطبع_سطر("[BeeFS] خطأ: الملف '" + اسم_ملف + "' موجود")
      ارجع -1
   نهاية

   متغير id_ملف = BEEFS_عداد_خلايا
   متغير خلية_ملف = beefs_خلية_جديدة(id_ملف، CELL_FILE، اسم_ملف، داخل_مجلد)
   خلية_ملف["محتوى"]     = محتوى_ملف
   خلية_ملف["حجم"]       = محتوى_ملف.الطول()
   خلية_ملف["وقت_إنشاء"] = id_ملف * 50

   أضف(BEEFS_خلايا، خلية_ملف)
   BEEFS_عداد_خلايا = BEEFS_عداد_خلايا + 1

   متغير أبناء_والد = BEEFS_خلايا[داخل_مجلد]["أبناء"]
   أضف(أبناء_والد، id_ملف)
   BEEFS_خلايا[داخل_مجلد]["أبناء"] = أبناء_والد

   اطبع_سطر("[BeeFS] 🍯 ملف جديد: '" + اسم_ملف + "' (" + محتوى_ملف.الطول() + " بايت, id=" + id_ملف + ")")
   ارجع id_ملف
نهاية

# ─── قراءة ملف ───────────────────────────────────────────────────────────────

دالة beefs_قرأ(id_خلية)
   إذا (id_خلية < 0)
      اطبع_سطر("[BeeFS] خطأ: id غير صالح")
      ارجع ""
   نهاية
   متغير خلية = BEEFS_خلايا[id_خلية]
   إذا (خلية["نوع"] != CELL_FILE)
      اطبع_سطر("[BeeFS] خطأ: ليس ملفاً (id=" + id_خلية + ")")
      ارجع ""
   نهاية
   خلية["وقت_وصول"] = id_خلية * 10 + 1
   BEEFS_خلايا[id_خلية] = خلية
   ارجع خلية["محتوى"]
نهاية

# ─── الكتابة (CoW) ────────────────────────────────────────────────────────────

دالة beefs_اكتب(id_خلية، محتوى_جديد)
   إذا (id_خلية < 0)
      اطبع_سطر("[BeeFS] خطأ: id غير صالح")
      ارجع -1
   نهاية

   متغير قديم = BEEFS_خلايا[id_خلية]

   # إذا كان immutable، ارفض
   إذا (قديم["أعلام"] == FLAG_IMMUTABLE)
      اطبع_سطر("[BeeFS] ❌ لا يمكن تعديل خلية محمية (id=" + id_خلية + ")")
      ارجع -1
   نهاية

   # CoW: انسخ الخلية القديمة كـ snapshot
   متغير id_نسخ = BEEFS_عداد_خلايا
   متغير نسخة = beefs_خلية_جديدة(id_نسخ، قديم["نوع"]، قديم["اسم"] + ".cow" + قديم["جيل"]، قديم["ام"])
   نسخة["محتوى"]   = قديم["محتوى"]
   نسخة["حجم"]     = قديم["حجم"]
   نسخة["وقت_إنشاء"] = قديم["وقت_إنشاء"]
   نسخة["جيل"]     = قديم["جيل"]
   نسخة["أعلام"]   = FLAG_IMMUTABLE   # النسخة القديمة تُجمّد
   نسخة["مرجع_عد"] = 0

   أضف(BEEFS_خلايا، نسخة)
   BEEFS_عداد_خلايا = BEEFS_عداد_خلايا + 1

   # تسجيل المعاملة في الـ journal
   متغير معاملة_cow = {}
   معاملة_cow["عملية"]      = "cow_write"
   معاملة_cow["id_اصل"]     = id_خلية
   معاملة_cow["id_snapshot"] = id_نسخ
   أضف(BEEFS_سجل_معاملات، معاملة_cow)

   # تحديث الخلية الأصل
   قديم["محتوى"]     = محتوى_جديد
   قديم["حجم"]       = محتوى_جديد.الطول()
   قديم["جيل"]       = قديم["جيل"] + 1
   قديم["نسخة_ام"]   = id_نسخ
   قديم["وقت_تعديل"] = id_خلية * 55
   BEEFS_خلايا[id_خلية] = قديم

   اطبع_سطر("[BeeFS] ✏️  CoW: '" + قديم["اسم"] + "' → جيل " + قديم["جيل"] + " (snapshot id=" + id_نسخ + ")")
   ارجع id_خلية
نهاية

# ─── ربط الجيران السداسيين ────────────────────────────────────────────────────

دالة beefs_ربط_جيران(id_خ_أ، id_خ_ب، اتجاه)
   إذا (id_خ_أ < 0)
      ارجع خطأ
   نهاية
   إذا (id_خ_ب < 0)
      ارجع خطأ
   نهاية
   متغير خ_أ = BEEFS_خلايا[id_خ_أ]
   متغير خ_ب = BEEFS_خلايا[id_خ_ب]

   إذا (اتجاه == "شمال")
      خ_أ["جار_شمال"] = id_خ_ب
      خ_ب["جار_جنوب"] = id_خ_أ
   نهاية
   إذا (اتجاه == "جنشرق")
      خ_أ["جار_جنشرق"] = id_خ_ب
      خ_ب["جار_شمغرب"] = id_خ_أ
   نهاية
   إذا (اتجاه == "شمشرق")
      خ_أ["جار_شمشرق"] = id_خ_ب
      خ_ب["جار_جنغرب"] = id_خ_أ
   نهاية

   BEEFS_خلايا[id_خ_أ] = خ_أ
   BEEFS_خلايا[id_خ_ب] = خ_ب
   ارجع صحيح
نهاية

# ─── عرض شجرة المجلد ─────────────────────────────────────────────────────────

دالة beefs_شجرة(id_خلية، مسافة)
   إذا (id_خلية < 0)
      ارجع 0
   نهاية
   متغير خلية = BEEFS_خلايا[id_خلية]
   متغير بادئة = ""
   متغير عدد_مسافة = 0
   بينما (عدد_مسافة < مسافة)
      بادئة = بادئة + "  "
      عدد_مسافة = عدد_مسافة + 1
   نهاية

   إذا (خلية["نوع"] == CELL_DIR)
      اطبع_سطر(بادئة + "📁 " + خلية["اسم"] + "/  (id=" + خلية["id"] + ", أبناء=" + خلية["أبناء"].الطول() + ")")
      متغير أبناء = خلية["أبناء"]
      متغير عدد_أبناء = 0
      بينما (عدد_أبناء < أبناء.الطول())
         beefs_شجرة(أبناء[عدد_أبناء]، مسافة + 1)
         عدد_أبناء = عدد_أبناء + 1
      نهاية
   وإلا
      اطبع_سطر(بادئة + "🍯 " + خلية["اسم"] + "  (" + خلية["حجم"] + " بايت, جيل=" + خلية["جيل"] + ")")
   نهاية
نهاية

# ─── إحصائيات BeeFS ──────────────────────────────────────────────────────────

دالة beefs_إحصائيات()
   اطبع_سطر("")
   اطبع_سطر("╔═══════════════════════════════════╗")
   اطبع_سطر("║    BeeFS — إحصائيات الخلية       ║")
   اطبع_سطر("╠═══════════════════════════════════╣")

   متغير عدد_ملفات  = 0
   متغير عدد_مجلدات = 0
   متغير عدد_cow    = 0
   متغير إجمالي_حجم = 0
   متغير عد_خلايا = 0
   بينما (عد_خلايا < BEEFS_عداد_خلايا)
      متغير خلية_مؤقتة = BEEFS_خلايا[عد_خلايا]
      إذا (خلية_مؤقتة["نوع"] == CELL_FILE)
         عدد_ملفات = عدد_ملفات + 1
         إجمالي_حجم = إجمالي_حجم + خلية_مؤقتة["حجم"]
      نهاية
      إذا (خلية_مؤقتة["نوع"] == CELL_DIR)
         عدد_مجلدات = عدد_مجلدات + 1
      نهاية
      إذا (خلية_مؤقتة["أعلام"] == FLAG_IMMUTABLE)
         عدد_cow = عدد_cow + 1
      نهاية
      عد_خلايا = عد_خلايا + 1
   نهاية

   اطبع_سطر("║  إجمالي الخلايا: " + BEEFS_عداد_خلايا)
   اطبع_سطر("║  الملفات:        " + عدد_ملفات)
   اطبع_سطر("║  المجلدات:       " + عدد_مجلدات)
   اطبع_سطر("║  Snapshots CoW:  " + عدد_cow)
   اطبع_سطر("║  إجمالي البيانات:" + إجمالي_حجم + " بايت")
   اطبع_سطر("║  سجل المعاملات:  " + BEEFS_سجل_معاملات.الطول() + " عملية")
   اطبع_سطر("╚═══════════════════════════════════╝")
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
#                            اختبارات BeeFS
# ═══════════════════════════════════════════════════════════════════════════════

اطبع_سطر("══════════════════════════════════════════════")
اطبع_سطر("  اختبارات BeeFS — نظام الخلايا السداسية")
اطبع_سطر("══════════════════════════════════════════════")
اطبع_سطر("")

# ── اختبار 1: التهيئة ────────────────────────────────────────────────────────
اطبع_سطر("── اختبار 1: تهيئة BeeFS ──")
متغير نجح = beefs_تهيئة()
إذا (نجح == صحيح)
   اطبع_سطر("✓ تهيئة BeeFS نجحت")
وإلا
   اطبع_سطر("✗ فشلت التهيئة!")
نهاية
اطبع_سطر("")

# ── اختبار 2: إنشاء هيكل مجلدات ────────────────────────────────────────────
اطبع_سطر("── اختبار 2: إنشاء الهيكل ──")
متغير id_bin   = beefs_مجلد("bin"، BEEFS_جذر)
متغير id_etc   = beefs_مجلد("etc"، BEEFS_جذر)
متغير id_home  = beefs_مجلد("home"، BEEFS_جذر)
متغير id_quran = beefs_مجلد("quran"، BEEFS_جذر)
متغير id_bee   = beefs_مجلد("bee"، id_home)
اطبع_سطر("✓ الهيكل الأساسي جاهز")
اطبع_سطر("")

# ── اختبار 3: إنشاء ملفات ────────────────────────────────────────────────────
اطبع_سطر("── اختبار 3: إنشاء الملفات ──")
متغير id_bismillah = beefs_ملف("بسم_الله.txt"، "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ"، id_quran)
متغير id_fatiha    = beefs_ملف("الفاتحة.txt"، "الحمد لله رب العالمين"، id_quran)
متغير id_beeos_conf = beefs_ملف("beeos.conf"، "kernel=beeos\nfs=beefs\narch=x86_64"، id_etc)
متغير id_shell     = beefs_ملف("beesh"، "#!/beefs/bin/beesh\necho Bismillah!"، id_bin)
اطبع_سطر("✓ الملفات الأساسية جاهزة")
اطبع_سطر("")

# ── اختبار 4: قراءة ملف ─────────────────────────────────────────────────────
اطبع_سطر("── اختبار 4: قراءة ملف ──")
متغير المحتوى = beefs_قرأ(id_bismillah)
اطبع_سطر("محتوى 'بسم_الله.txt': " + المحتوى)
إذا (المحتوى == "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ")
   اطبع_سطر("✓ القراءة صحيحة")
وإلا
   اطبع_سطر("✗ خطأ في القراءة!")
نهاية
اطبع_سطر("")

# ── اختبار 5: الكتابة بـ CoW ─────────────────────────────────────────────────
اطبع_سطر("── اختبار 5: الكتابة CoW ──")
متغير id_بعد_cow = beefs_اكتب(id_beeos_conf، "kernel=beeos\nfs=beefs\narch=x86_64\nversion=0.1")
متغير محتوى_جديد = beefs_قرأ(id_beeos_conf)
اطبع_سطر("المحتوى الجديد: " + محتوى_جديد)
متغير جيل_جديد = BEEFS_خلايا[id_beeos_conf]["جيل"]
اطبع_سطر("✓ الجيل الجديد: " + جيل_جديد)
اطبع_سطر("")

# ── اختبار 6: ربط الجيران السداسيين ──────────────────────────────────────────
اطبع_سطر("── اختبار 6: الجيران السداسيون ──")
متغير تم = beefs_ربط_جيران(id_bismillah، id_fatiha، "شمال")
