#* حجز عقدة جديدة
   المعاملات: صنف العقدة (ملف/دليل)
   ترجع: رقم العقدة أو -1 *#
صدّر دالة tmpfs_حجز_عقدة(ص_عقدة)
    متغير خ = 0
    بينما (خ < 16)
        متغير ص_حالي = اقرأ_صنف_عقدة(خ)
        إذا (ص_حالي == صنف_فارغ)
            عيّن_صنف_عقدة(خ، ص_عقدة)
            عيّن_مقاس_عقدة(خ، 0)
            عداد_عقد_مستخدمة = عداد_عقد_مستخدمة + 1
            إذا (ص_عقدة == صنف_ملف)
                عداد_ملفات = عداد_ملفات + 1
            نهاية
            إذا (ص_عقدة == صنف_دليل)
                عداد_أدلة = عداد_أدلة + 1
            نهاية
            عداد_عمليات = عداد_عمليات + 1
            ارجع خ
        نهاية
        خ = خ + 1
    نهاية
    ارجع -1
نهاية

#* تحرير عقدة
   المعاملات: رقم العقدة
   ترجع: 0 عند النجاح *#
