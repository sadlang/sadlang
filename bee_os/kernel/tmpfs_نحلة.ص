    إذا (رقم_عقدة < 0)
        ارجع -1
    نهاية
    إذا (رقم_عقدة >= 16)
        ارجع -1
    نهاية
    
    متغير ص_حالي = اقرأ_صنف_عقدة(رقم_عقدة)
    إذا (ص_حالي == صنف_فارغ)
        ارجع -1
    نهاية
    
    إذا (ص_حالي == صنف_ملف)
        عداد_ملفات = عداد_ملفات - 1
    نهاية
    إذا (ص_حالي == صنف_دليل)
        عداد_أدلة = عداد_أدلة - 1
    نهاية
    
    عيّن_صنف_عقدة(رقم_عقدة، صنف_فارغ)
    عيّن_مقاس_عقدة(رقم_عقدة، 0)
    عداد_عقد_مستخدمة = عداد_عقد_مستخدمة - 1
    عداد_عمليات = عداد_عمليات + 1
    ارجع 0
