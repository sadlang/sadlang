# ── اختبار 1: التهيئة ────────────────────────────────────────────────────────
اطبع_سطر("── اختبار 1: تهيئة BeeIPC ──")
ipc_تهيئة()
اطبع_سطر("✓ BeeIPC مهيأ بالكامل")
اطبع_سطر("")

# ── اختبار 2: BeeShma — مشاركة مخزن القرآن ──────────────────────────────────
اطبع_سطر("── اختبار 2: BeeShma — الذاكرة المشتركة ──")
متغير id_quran_buf = beeshma_أنشئ("quran_buffer"، 131072، PERM_HALAL)     # 128 KB
متغير id_audio_buf = beeshma_أنشئ("audio_buffer"، 65536، PERM_HALAL)      # 64 KB

# اختبار رفض الحرام
متغير id_haram = beeshma_أنشئ("haram_content"، 1024، PERM_HARAM)

# كتابة وقراءة
beeshma_اكتب(id_quran_buf، "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ"، 1000)
متغير محتوى_quran = beeshma_اقرأ(id_quran_buf)
اطبع_سطر("✓ قرأنا: " + محتوى_quran)
اطبع_سطر("")

# ── اختبار 3: BeeWhisper — قنوات الرسائل ────────────────────────────────────
اطبع_سطر("── اختبار 3: BeeWhisper — Message Passing ──")

# قناة من النواة إلى عملية الأذان
متغير id_ch_adhan = beewhisper_قناة("kernel"، "adhan_process"، 8)

# قناة من عملية المستخدم إلى الشاشة
متغير id_ch_screen = beewhisper_قناة("user_shell"، "screen_driver"، 16)

# إرسال رسائل
beewhisper_أرسل(id_ch_adhan، "ADHAN_TIME: Fajr"، PRIO_ADHAN)
beewhisper_أرسل(id_ch_adhan، "آية الكرسي"، PRIO_QURAN)
beewhisper_أرسل(id_ch_screen، "الله أكبر — صلاة الفجر"، PRIO_USER)

# استقبال
متغير رد1 = beewhisper_استقبل(id_ch_adhan)
متغير رد2 = beewhisper_استقبل(id_ch_adhan)
اطبع_سطر("✓ القناة " + id_ch_adhan + " تعمل: '" + رد1 + "' و '" + رد2 + "'")
اطبع_سطر("")

# ── اختبار 4: BeeHive — سيمافور + صندوق بريد ────────────────────────────────
اطبع_سطر("── اختبار 4: BeeHive — Semaphore + Mailbox ──")

# سيمافور للطابعة (resource=1)
متغير id_printer_sem = beehive_إشارة_جديدة("printer"، 1)
beehive_P(id_printer_sem)                  # احجز الطابعة
اطبع_سطر("[Printer] جاري الطباعة...")
beehive_V(id_printer_sem)                  # أطلق الطابعة
اطبع_سطر("✓ سيمافور الطابعة يعمل")
اطبع_سطر("")

# صندوق بريد نظام الأذان
متغير id_adhan_mailbox = beehive_صندوق_جديد("adhan_system")
beehive_ضع(id_adhan_mailbox، "صلاة الفجر: 05:12")
beehive_ضع(id_adhan_mailbox، "صلاة الظهر: 12:30")
beehive_ضع(id_adhan_mailbox، "صلاة العصر: 15:45")

متغير وقت1 = beehive_اسحب(id_adhan_mailbox)
متغير وقت2 = beehive_اسحب(id_adhan_mailbox)
اطبع_سطر("✓ صندوق الأذان يعمل: '" + وقت1 + "'")
اطبع_سطر("✓ صلاة ثانية: '" + وقت2 + "'")
اطبع_سطر("")

# ── اختبار 5: السيمافور مع blocking ─────────────────────────────────────────
اطبع_سطر("── اختبار 5: Semaphore Blocking ──")
متغير id_mutex = beehive_إشارة_جديدة("mutex_beefs"، 1)
beehive_P(id_mutex)      # اكتسب
beehive_P(id_mutex)      # يجب أن يُحجب (القيمة = 0)
beehive_V(id_mutex)      # أطلق
اطبع_سطر("✓ Semaphore blocking كما متوقع")
اطبع_سطر("")

