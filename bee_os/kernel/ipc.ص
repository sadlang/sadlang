#                            ثوابت BeeIPC
# ═══════════════════════════════════════════════════════════════════════════════

# حدود الموارد
متغير IPC_MAX_SHARED_REGIONS = 64      # أقصى مناطق SharedMem للنظام
متغير IPC_MAX_CHANNELS       = 256     # أقصى قنوات BeeWhisper
متغير IPC_MAX_MSG_SIZE       = 65536   # 64 KB حجم أكبر رسالة
متغير IPC_MAILBOX_CAPACITY   = 32      # سعة كل صندوق بريد
متغير IPC_SPINLOCK_RETRIES   = 1000000 # محاولات قبل timeout

# حالات القناة / Channel States
متغير CHAN_OPEN    = 1    # القناة مفتوحة وجاهزة
متغير CHAN_CLOSED  = 2    # القناة مغلقة
متغير CHAN_BLOCKED = 3    # منتظر (blocked receiver)
متغير CHAN_FULL    = 4    # الطابور ممتلئ

# أولويات الرسائل / Message Priorities
متغير PRIO_ADHAN   = 99   # أذان — أعلى أولوية مطلقة
متغير PRIO_QURAN   = 90   # قرآن كريم
متغير PRIO_KERNEL  = 80   # رسائل النواة
متغير PRIO_USER    = 50   # رسائل المستخدم
متغير PRIO_DEBUG   = 10   # رسائل التصحيح

# أذون الإسلامية / Islamic Permissions
متغير PERM_HALAL   = 1    # مسموح — حلال
متغير PERM_HARAM   = 2    # محظور — حرام (لن يُنفَّذ)
متغير PERM_MAQID   = 3    # مقيد — يحتاج إذن خاص

# نوع IPC
متغير IPC_SHMA     = 1    # Shared Memory
متغير IPC_WHISPER  = 2    # Message Passing
متغير IPC_HIVE     = 3    # Mailbox

# ═══════════════════════════════════════════════════════════════════════════════
#                         متغيرات النظام
# ═══════════════════════════════════════════════════════════════════════════════

متغير IPC_جاهز              = خطأ

# BeeShma — مناطق الذاكرة المشتركة
متغير SHMA_مناطق            = []     # قائمة كل المناطق المشتركة
متغير SHMA_عداد             = 0

# BeeWhisper — قنوات الرسائل
متغير WHISPER_قنوات          = []    # قائمة القنوات
متغير WHISPER_عداد           = 0
متغير WHISPER_إجمالي_رسائل   = 0

# BeeHive — صناديق البريد والإشارات
متغير HIVE_صناديق            = []   # صناديق البريد
متغير HIVE_عداد              = 0
متغير HIVE_إشارات            = []   # جدول السيمافور
متغير HIVE_عداد_إشارات       = 0

# إحصائيات IPC
متغير IPC_إحصائيات           = {}

# ═══════════════════════════════════════════════════════════════════════════════
#    قسم 1: BeeShma — الذاكرة المشتركة (Shared Memory)
# ═══════════════════════════════════════════════════════════════════════════════

##
## beeshma_أنشئ — إنشاء منطقة ذاكرة مشتركة
##
## @param اسم_المنطقة   : معرّف نصي (مثل "quran_buffer")
## @param حجم_بايت     : حجم المنطقة بالبايت
## @param إذن           : PERM_HALAL / PERM_HARAM / PERM_MAQID
##
## على الأجهزة الحقيقية:
##   1. احجز إطار صفحة فيزيائي (Physical Frame Allocator)
##   2. عدّل Page Tables لكلتا العمليتين (Writer + Reader)
##   3. ضع Memory Barrier (MFENCE) لضمان التزامن
##   4. سجّل المنطقة في جدول مناطق الـ IPC
##
دالة beeshma_أنشئ(اسم_المنطقة، حجم_بايت، إذن)

   # التحقق من الإذن الإسلامي
   إذا (إذن == PERM_HARAM)
      اطبع_سطر("[BeeShma] ❌ HARAM: رُفض إنشاء '" + اسم_المنطقة + "' — محتوى محرم")
      ارجع -1
   نهاية

   إذا (SHMA_عداد >= IPC_MAX_SHARED_REGIONS)
      اطبع_سطر("[BeeShma] خطأ: وصلنا الحد الأقصى " + IPC_MAX_SHARED_REGIONS)
      ارجع -1
   نهاية

   متغير عنوان_فيزيائي = 0x600000 + SHMA_عداد * 0x10000  # محاكاة عنوان فيزيائي

   متغير منطقة = {}
   منطقة["id"]             = SHMA_عداد
   منطقة["اسم"]            = اسم_المنطقة
   منطقة["حجم"]            = حجم_بايت
   منطقة["عنوان_فيزيائي"] = عنوان_فيزيائي
   منطقة["إذن"]            = إذن
   منطقة["spinlock"]       = 0       # 0=حر, 1=مقفول
   منطقة["عدد_كاتبين"]     = 0
   منطقة["عدد_قارئين"]     = 0
   منطقة["بيانات"]         = ""      # محاكاة المحتوى
   منطقة["مرات_كتابة"]     = 0
   منطقة["مرات_قراءة"]     = 0
   منطقة["نشطة"]           = صحيح

   # على الأجهزة: نُنشئ إدخال في Page Table هنا
   # x86: pte = phys_addr | PTE_PRESENT | PTE_WRITABLE | PTE_USER
   # نُضيف INVLPG لمسح TLB بعد إعداد الصفحة

   أضف(SHMA_مناطق، منطقة)
   SHMA_عداد = SHMA_عداد + 1

   اطبع_سطر("[BeeShma] ✓ منطقة جديدة: '" + اسم_المنطقة + "'")
   اطبع_سطر("[BeeShma]   حجم: " + حجم_بايت + " بايت | عنوان: 0x" + عنوان_فيزيائي)
   اطبع_سطر("[BeeShma]   إذن: " + إذن + " | Spinlock: حر")
   ارجع SHMA_عداد - 1
نهاية

##
## beeshma_اكتب — كتابة إلى منطقة مشتركة (مع Spinlock)
##
## على الأجهزة الحقيقية:
##   1. نفّذ LOCK XCHG لاكتساب الـ spinlock
##   2. إذا مقفول: spin في حلقة busy-wait
##   3. بعد الكتابة: MFENCE ثم أطلق الـ lock
##
دالة beeshma_اكتب(id_منطقة، بيانات_جديدة، طابع_زمني)
   متغير منطقة = SHMA_مناطق[id_منطقة]

   إذا (منطقة["إذن"] == PERM_HARAM)
      اطبع_سطر("[BeeShma] ❌ محاولة كتابة محرمة رُفضت")
      ارجع خطأ
   نهاية

   # محاكاة اكتساب الـ spinlock
   # على الأجهزة: `LOCK XCHG [spinlock], 1` ثم test
   متغير محاولات = 0
   بينما (منطقة["spinlock"] == 1)
      محاولات = محاولات + 1
      إذا (محاولات > IPC_SPINLOCK_RETRIES)
         اطبع_سطر("[BeeShma] ⚠️ Spinlock timeout! (منطقة=" + id_منطقة + ")")
         ارجع خطأ
      نهاية
   نهاية

   # اكتسب الـ lock
   منطقة["spinlock"] = 1
   SHMA_مناطق[id_منطقة] = منطقة

   # ── الكتابة الفعلية ──────────────────────────────────────────────────────
   # على الأجهزة: memcpy(phys_addr, data, size) ثم MFENCE
   منطقة["بيانات"]       = بيانات_جديدة
   منطقة["مرات_كتابة"]   = منطقة["مرات_كتابة"] + 1
   منطقة["طابع_آخر_كتابة"] = طابع_زمني

   # أطلق الـ lock — على الأجهزة: `MOV [spinlock], 0` (store release)
   منطقة["spinlock"] = 0
   SHMA_مناطق[id_منطقة] = منطقة

   IPC_إحصائيات["shma_كتابات"] = IPC_إحصائيات["shma_كتابات"] + 1
   ارجع صحيح
نهاية

##
## beeshma_اقرأ — قراءة من منطقة مشتركة
##
دالة beeshma_اقرأ(id_منطقة)
   متغير منطقة = SHMA_مناطق[id_منطقة]
   منطقة["مرات_قراءة"]   = منطقة["مرات_قراءة"] + 1
   SHMA_مناطق[id_منطقة]  = منطقة
   IPC_إحصائيات["shma_قراءات"] = IPC_إحصائيات["shma_قراءات"] + 1
   ارجع منطقة["بيانات"]
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
#    قسم 2: BeeWhisper — تمرير الرسائل (Message Passing)
# ═══════════════════════════════════════════════════════════════════════════════

##
## beewhisper_قناة — إنشاء قناة جديدة بين عمليتين
##
## @param اسم_المرسل    : pid/اسم العملية المرسلة
## @param اسم_المستقبل  : pid/اسم العملية المستقبلة
## @param سعة           : عدد الرسائل القصوى في الطابور
##
## على الأجهزة الحقيقية:
##   - تخصيص مخزن دائري (ring buffer) في ذاكرة النواة
##   - إعداد head/tail indices المحمية بـ spinlock
##   - تسجيل القناة في جدول القنوات الخاص بكل عملية
##
دالة beewhisper_قناة(اسم_مرسل، اسم_مستقبل، سعة_قناة)
   متغير id_قناة = WHISPER_عداد
   متغير قناة = {}

   قناة["id"]         = id_قناة
   قناة["مرسل"]       = اسم_مرسل
   قناة["مستقبل"]     = اسم_مستقبل
   قناة["سعة"]        = سعة_قناة
   قناة["حالة"]       = CHAN_OPEN
   قناة["رسائل"]      = []        # ring buffer (محاكاة)
   قناة["head"]       = 0         # رأس الطابور
   قناة["tail"]       = 0         # ذيل الطابور
   قناة["عدد_رسائل"]  = 0
   قناة["مُرسلت"]     = 0
   قناة["مُستقبلت"]   = 0
   قناة["spinlock"]   = 0

   أضف(WHISPER_قنوات، قناة)
   WHISPER_عداد = WHISPER_عداد + 1

   اطبع_سطر("[BeeWhisper] ✓ قناة #" + id_قناة + ": " + اسم_مرسل + " → " + اسم_مستقبل + " (سعة=" + سعة_قناة + ")")
   ارجع id_قناة
نهاية

##
## beewhisper_أرسل — إرسال رسالة عبر القناة
##
## على الأجهزة الحقيقية:
##   1. اكتسب spinlock
##   2. إذا ممتلئ: استخدم futex_wait لإيقاظ لاحق
##   3. اكتب الرسالة في ring_buffer[tail]
##   4. tail = (tail + 1) % capacity
##   5. أرسل IPI لإيقاظ المعالج الذي تعمل عليه العملية المستقبلة
##
دالة beewhisper_أرسل(id_قناة، محتوى_رسالة، أولوية_رسالة)
   متغير قناة = WHISPER_قنوات[id_قناة]

   إذا (قناة["حالة"] != CHAN_OPEN)
      اطبع_سطر("[BeeWhisper] ❌ القناة " + id_قناة + " مغلقة")
      ارجع خطأ
   نهاية

   # تحقق من امتلاء الطابور
   إذا (قناة["عدد_رسائل"] >= قناة["سعة"])
      اطبع_سطر("[BeeWhisper] ⚠️ الطابور ممتلئ — عملية '" + قناة["مرسل"] + "' محجوبة (blocked)")
      قناة["حالة"] = CHAN_FULL
      WHISPER_قنوات[id_قناة] = قناة
      ارجع خطأ
   نهاية

   متغير رسالة = {}
   رسالة["id"]        = قناة["مُرسلت"]
   رسالة["محتوى"]     = محتوى_رسالة
   رسالة["أولوية"]    = أولوية_رسالة
   رسالة["مُرسلت"]    = صحيح

   أضف(قناة["رسائل"]، رسالة)
   قناة["tail"]       = (قناة["tail"] + 1) % قناة["سعة"]
   قناة["عدد_رسائل"]  = قناة["عدد_رسائل"] + 1
   قناة["مُرسلت"]     = قناة["مُرسلت"] + 1

   WHISPER_قنوات[id_قناة] = قناة
   WHISPER_إجمالي_رسائل   = WHISPER_إجمالي_رسائل + 1
   IPC_إحصائيات["whisper_رسائل"] = IPC_إحصائيات["whisper_رسائل"] + 1

   اطبع_سطر("[BeeWhisper] ↑ رسالة #" + رسالة["id"] + " (أولوية=" + أولوية_رسالة + ") عبر قناة #" + id_قناة)
   اطبع_سطر("[BeeWhisper]   '" + محتوى_رسالة + "'")
   ارجع صحيح
نهاية

##
## beewhisper_استقبل — استقبال رسالة من القناة
##
دالة beewhisper_استقبل(id_قناة)
   متغير قناة = WHISPER_قنوات[id_قناة]

   إذا (قناة["عدد_رسائل"] == 0)
      اطبع_سطر("[BeeWhisper] صندوق فارغ للقناة " + id_قناة)
      ارجع ""
   نهاية

   متغير رسالة = قناة["رسائل"][قناة["head"]]
   قناة["head"]       = (قناة["head"] + 1) % قناة["سعة"]
   قناة["عدد_رسائل"]  = قناة["عدد_رسائل"] - 1
   قناة["مُستقبلت"]   = قناة["مُستقبلت"] + 1

   WHISPER_قنوات[id_قناة] = قناة
   IPC_إحصائيات["whisper_استقبالات"] = IPC_إحصائيات["whisper_استقبالات"] + 1

   اطبع_سطر("[BeeWhisper] ↓ استقبل #" + رسالة["id"] + ": '" + رسالة["محتوى"] + "'")
   ارجع رسالة["محتوى"]
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
#    قسم 3: BeeHive — صندوق البريد + السيمافور (Mailbox + Semaphore)
# ═══════════════════════════════════════════════════════════════════════════════

##
## beehive_إشارة_جديدة — إنشاء سيمافور (Semaphore)
##
## @param اسم_إشارة   : اسم للتعريف
## @param قيمة_ابتدائية : القيمة الأولية (عدد الموارد المتاحة)
##
## على الأجهزة الحقيقية:
##   - قيمة السيمافور محمية بـ LOCK XADD (atomic add/subtract)
##   - القيمة السالبة = عدد العمليات المنتظرة
##   - يستخدم futex_wait/futex_wake لإيقاظ العمليات
##
دالة beehive_إشارة_جديدة(اسم_إشارة، قيمة_ابتدائية)
   متغير id_إشارة = HIVE_عداد_إشارات
   متغير إشارة = {}

   إشارة["id"]         = id_إشارة
   إشارة["اسم"]        = اسم_إشارة
   إشارة["قيمة"]       = قيمة_ابتدائية
   إشارة["قيمة_أصل"]   = قيمة_ابتدائية
   إشارة["منتظرون"]    = 0
   إشارة["عمليات_P"]   = 0   # P = wait/acquire
   إشارة["عمليات_V"]   = 0   # V = signal/release

   أضف(HIVE_إشارات، إشارة)
   HIVE_عداد_إشارات = HIVE_عداد_إشارات + 1

   اطبع_سطر("[BeeHive] ✓ سيمافور '" + اسم_إشارة + "' (init=" + قيمة_ابتدائية + ", id=" + id_إشارة + ")")
   ارجع id_إشارة
نهاية

##
## beehive_P — عملية Wait/Acquire على السيمافور
## (تُخفَّض القيمة بمقدار 1؛ إذا صارت 0 → blocking)
##
## على الأجهزة الحقيقية:
##   LOCK DEC [semaphore]; JS blocked_path
##   أي: `LOCK XADD [sem], -1` ثم test
##
دالة beehive_P(id_إشارة)
   متغير إشارة = HIVE_إشارات[id_إشارة]

   إذا (إشارة["قيمة"] <= 0)
      إشارة["منتظرون"] = إشارة["منتظرون"] + 1
      HIVE_إشارات[id_إشارة] = إشارة
      اطبع_سطر("[BeeHive] ⏸️  P('" + إشارة["اسم"] + "') — حجب! (قيمة=" + إشارة["قيمة"] + ", منتظرون=" + إشارة["منتظرون"] + ")")
      ارجع خطأ
   نهاية

   إشارة["قيمة"]     = إشارة["قيمة"] - 1
   إشارة["عمليات_P"] = إشارة["عمليات_P"] + 1
   HIVE_إشارات[id_إشارة] = إشارة

   اطبع_سطر("[BeeHive] ▼ P('" + إشارة["اسم"] + "') → قيمة=" + إشارة["قيمة"])
   IPC_إحصائيات["hive_P_ops"] = IPC_إحصائيات["hive_P_ops"] + 1
   ارجع صحيح
نهاية

##
## beehive_V — عملية Signal/Release على السيمافور
## (تزيد القيمة بمقدار 1؛ تُوقظ عملية منتظرة إن وُجدت)
##
## على الأجهزة الحقيقية:
##   LOCK INC [semaphore]; JLE wakeup_path
##   ثم إرسال IPI لإيقاظ عملية منتظرة
##
دالة beehive_V(id_إشارة)
   متغير إشارة = HIVE_إشارات[id_إشارة]

   إشارة["قيمة"]     = إشارة["قيمة"] + 1
   إشارة["عمليات_V"] = إشارة["عمليات_V"] + 1

   إذا (إشارة["منتظرون"] > 0)
      إشارة["منتظرون"] = إشارة["منتظرون"] - 1
      HIVE_إشارات[id_إشارة] = إشارة
      اطبع_سطر("[BeeHive] ▲ V('" + إشارة["اسم"] + "') → أيقظ عملية منتظرة (قيمة=" + إشارة["قيمة"] + ")")
   وإلا
      HIVE_إشارات[id_إشارة] = إشارة
      اطبع_سطر("[BeeHive] ▲ V('" + إشارة["اسم"] + "') → قيمة=" + إشارة["قيمة"])
   نهاية

   IPC_إحصائيات["hive_V_ops"] = IPC_إحصائيات["hive_V_ops"] + 1
   ارجع صحيح
نهاية

##
## beehive_صندوق_جديد — إنشاء صندوق بريد (Mailbox)
##
دالة beehive_صندوق_جديد(اسم_صندوق)
   متغير id_صندوق = HIVE_عداد
   متغير صندوق = {}

   صندوق["id"]        = id_صندوق
   صندوق["اسم"]       = اسم_صندوق
   صندوق["رسائل"]     = []
   صندوق["إشارة_id"]  = beehive_إشارة_جديدة("sem_" + اسم_صندوق، IPC_MAILBOX_CAPACITY)
   صندوق["مُستلم"]    = 0
   صندوق["مُرسل"]     = 0

   أضف(HIVE_صناديق، صندوق)
   HIVE_عداد = HIVE_عداد + 1

   اطبع_سطر("[BeeHive] 🐝 صندوق بريد '" + اسم_صندوق + "' (id=" + id_صندوق + ", سعة=" + IPC_MAILBOX_CAPACITY + ")")
   ارجع id_صندوق
نهاية

##
## beehive_ضع — وضع رسالة في صندوق البريد
##
دالة beehive_ضع(id_صندوق، رسالة_بريد)
   متغير صندوق = HIVE_صناديق[id_صندوق]
   متغير id_إشارة = صندوق["إشارة_id"]

   # P() على سيمافور المساحة المتاحة
   متغير مساحة_متاحة = beehive_P(id_إشارة)
   إذا (مساحة_متاحة == خطأ)
      اطبع_سطر("[BeeHive] ❌ الصندوق ممتلئ — لم تُضف الرسالة")
      ارجع خطأ
   نهاية

   متغير حزمة = {}
   حزمة["محتوى"] = رسالة_بريد
   حزمة["seq"]   = صندوق["مُرسل"]
   أضف(صندوق["رسائل"]، حزمة)
   صندوق["مُرسل"]  = صندوق["مُرسل"] + 1
   HIVE_صناديق[id_صندوق] = صندوق

   اطبع_سطر("[BeeHive] 📨 وُضع في '" + صندوق["اسم"] + "': '" + رسالة_بريد + "'")
   IPC_إحصائيات["hive_رسائل"] = IPC_إحصائيات["hive_رسائل"] + 1
   ارجع صحيح
نهاية

##
## beehive_اسحب — سحب رسالة من صندوق البريد
##
دالة beehive_اسحب(id_صندوق)
   متغير صندوق = HIVE_صناديق[id_صندوق]

   إذا (صندوق["رسائل"].الطول() == 0)
      اطبع_سطر("[BeeHive] الصندوق '" + صندوق["اسم"] + "' فارغ")
      ارجع ""
   نهاية

   متغير رسالة_أولى = صندوق["رسائل"][0]
   # في الواقع: يجب الإزالة من المصفوفة — هنا نحاكي بإزاحة head
   صندوق["مُستلم"]  = صندوق["مُستلم"] + 1

   # V() على سيمافور المساحة (فُرغت منزلة → زيادة المتاح)
   beehive_V(صندوق["إشارة_id"])

   HIVE_صناديق[id_صندوق] = صندوق
   اطبع_سطر("[BeeHive] 📬 سُحب من '" + صندوق["اسم"] + "': '" + رسالة_أولى["محتوى"] + "'")
   ارجع رسالة_أولى["محتوى"]
نهاية

