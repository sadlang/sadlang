# الفهرس داخل المجموعة = (رقم_العُقدة - 1) % عُقد_لكل_مجموعة
# الإزاحة بالبايت = الفهرس * مقاس_العُقدة
# رقم الكتلة = جدول_العُقد + (الإزاحة / مقاس_الكتلة)
# الإزاحة داخل الكتلة = الإزاحة % مقاس_الكتلة

# حساب رقم مجموعة الكتل التي تنتمي إليها العُقدة
