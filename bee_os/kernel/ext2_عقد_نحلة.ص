    متغير غم_محلي = mem_read_dword(مخزن + 0، إزاحة_في_كتلة + عق_غير_مباشرة)
    # الكتلة غير المباشرة المزدوجة
    متغير غم_مزدوجة_محلي = mem_read_dword(مخزن + 0، إزاحة_في_كتلة + عق_غير_مباشرة_مزدوجة)
    # الكتلة غير المباشرة الثلاثية
    متغير غم_ثلاثية_محلي = mem_read_dword(مخزن + 0، إزاحة_في_كتلة + عق_غير_مباشرة_ثلاثية)

    # --- نسخ الكتل المباشرة الـ 12 (48 بايت) إلى مخزن مخصص ---
    متغير مخزن_كتل_مباشر = kmalloc(48)
    إذا (مخزن_كتل_مباشر == 0)
        kfree(مخزن + 0)
        serial_puts("[EXT2-INODE] خطأ: فشل تخصيص ذاكرة للكتل المباشرة\r\n")
        ارجع -1
    نهاية

    # نسخ 48 بايت (12 كتلة × 4 بايت لكل كتلة)
    # من (مخزن + إزاحة_في_كتلة + عق_كتل_مباشرة) إلى مخزن_كتل_مباشر
    متغير إزاحة_كتل_في_مخزن = إزاحة_في_كتلة + عق_كتل_مباشرة
    متغير ك = 0
    بينما (ك < عدد_كتل_مباشرة)
        متغير قيمة_كتلة = mem_read_dword(مخزن + 0، إزاحة_كتل_في_مخزن + ك * 4)
        mem_write_dword(مخزن_كتل_مباشر + 0، ك * 4، قيمة_كتلة + 0)
        ك = ك + 1
    نهاية

    # تحرير مخزن القراءة الأصلي
    kfree(مخزن + 0)

    # --- تخزين العُقدة في الكاش ---
    # الحصول على فتحة كاش فارغة أو إعادة استخدام الأقدم
    متغير فتحة_جديدة = هات_فتحة_فارغة()

    # إذا كانت الفتحة متسخة (تم تعديلها)، يجب حفظها أولاً
    متغير رقم_ع_قديم = هات_رقم_عقدة_كاش(فتحة_جديدة + 0)
    إذا (رقم_ع_قديم != 0)
        # حفظ العُقدة القديمة إذا كانت متسخة
