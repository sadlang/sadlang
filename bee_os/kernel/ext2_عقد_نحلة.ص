        # تحرير مخزن الكتل القديم
        متغير مخزن_قديم = هات_كتل_مخزن_كاش(فتحة_جديدة + 0)
        إذا (مخزن_قديم != 0)
            kfree(مخزن_قديم + 0)
        نهاية
    نهاية

    # تخزين البيانات في الفتحة
    ضع_عقدة_كاش(فتحة_جديدة + 0، رقم_ع + 0، فهرس_قسم + 0، نمط_محلي + 0، مالك_محلي + 0، مقاس_محلي + 0، روابط_محلي + 0، قطاعات_محلي + 0، رايات_محلي + 0، غم_محلي + 0، غم_مزدوجة_محلي + 0، غم_ثلاثية_محلي + 0، مخزن_كتل_مباشر + 0)

    ارجع فتحة_جديدة + 0
نهاية

# =====================================================================
# كتابة عُقدة من الكاش إلى القرص
# =====================================================================

# تكتب عُقدة مُعدّلة من الكاش إلى موقعها على القرص
# تُرجع 0 عند النجاح أو -1 عند الفشل
صدّر دالة ext2_اكتب_عقدة(فهرس_قسم، رقم_ع)
    # البحث عن العُقدة في الكاش
    متغير فتحة = ابحث_في_كاش(فهرس_قسم + 0، رقم_ع + 0)
    إذا (فتحة < 0)
        serial_puts("[EXT2-INODE] خطأ: العُقدة غير موجودة في الكاش للكتابة\r\n")
        ارجع -1
    نهاية

    # حساب الموقع على القرص
    متغير رقم_مجموعة = ext2_عقدة_إلى_مجموعة(فهرس_قسم + 0، رقم_ع + 0)
    متغير فهرس_محلي = ext2_عقدة_فهرس_محلي(فهرس_قسم + 0، رقم_ع + 0)

    ext2_اقرأ_واصف_مجموعة(فهرس_قسم + 0، رقم_مجموعة + 0)
    متغير جدول_عقد = ext2_هات_جدول_عقد()

    متغير إزاحة_بايت = فهرس_محلي * مقاس_عقدة
    متغير عرض_كتلة = ext2_مقاس_كتلة(فهرس_قسم + 0)
    متغير كتلة_عقدة = جدول_عقد + إزاحة_بايت / عرض_كتلة
    متغير إزاحة_في_كتلة = إزاحة_بايت % عرض_كتلة

    # قراءة الكتلة الحالية (لأننا سنعدّل 128 بايت فقط منها)
    متغير مخزن = kmalloc(عرض_كتلة + 0)
    إذا (مخزن == 0)
        serial_puts("[EXT2-INODE] خطأ: فشل تخصيص ذاكرة للكتابة\r\n")
        ارجع -1
    نهاية

    ext2_اقرأ_كتلة(فهرس_قسم + 0، كتلة_عقدة + 0، مخزن + 0)

    # كتابة حقول العُقدة من الكاش إلى المخزن
    متغير نمط_ك = هات_نمط_كاش(فتحة + 0)
    متغير مقاس_ك = هات_مقاس_كاش(فتحة + 0)
    متغير روابط_ك = هات_روابط_كاش(فتحة + 0)
    متغير غم_ك = هات_غير_مباشرة_كاش(فتحة + 0)

    # كتابة النمط (2 بايت)
    mem_write_word(مخزن + 0، إزاحة_في_كتلة + عق_نمط، نمط_ك + 0)
    # كتابة الحجم (4 بايت)
    mem_write_dword(مخزن + 0، إزاحة_في_كتلة + عق_مقاس_أدنى، مقاس_ك + 0)
    # كتابة عدد الروابط (2 بايت)
    mem_write_word(مخزن + 0، إزاحة_في_كتلة + عق_عدد_روابط، روابط_ك + 0)
    # كتابة الكتلة غير المباشرة (4 بايت)
    mem_write_dword(مخزن + 0، إزاحة_في_كتلة + عق_غير_مباشرة، غم_ك + 0)

    # كتابة الكتل المباشرة الـ 12
    متغير مخزن_كتل = هات_كتل_مخزن_كاش(فتحة + 0)
    إذا (مخزن_كتل != 0)
        متغير ك = 0
        بينما (ك < عدد_كتل_مباشرة)
            متغير قيمة_كتلة = mem_read_dword(مخزن_كتل + 0، ك * 4)
            mem_write_dword(مخزن + 0، إزاحة_في_كتلة + عق_كتل_مباشرة + ك * 4، قيمة_كتلة + 0)
            ك = ك + 1
        نهاية
    نهاية

    # كتابة الكتلة المعدّلة إلى القرص
    ext2_اكتب_كتلة(فهرس_قسم + 0، كتلة_عقدة + 0، مخزن + 0)

