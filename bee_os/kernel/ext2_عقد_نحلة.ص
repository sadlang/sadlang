# ملف: ext2_عقد_نحلة.ص
# الوصف: نظام ملفات ext2 — إدارة العُقد (Inodes)
# المشروع: نظام نحلة (BeeOS)
#
# يحتوي هذا الملف على:
#   - ثوابت بنية العُقدة (Inode) بحسب مواصفة ext2
#   - قراءة وكتابة العُقد من وإلى القرص
#   - تحويل رقم العُقدة إلى موقعها على القرص
#   - قراءة كتل البيانات المباشرة وغير المباشرة
#   - تخصيص وتحرير العُقد
#   - استخراج صلاحيات ونوع العُقدة
#   - ذاكرة مؤقتة (كاش) لـ 16 عُقدة
#   - دوال التهيئة والتقرير والدورة
#
# بنية العُقدة (Inode) — 128 بايت في الإصدار 0:
#   الإزاحة 0x00 (0):   النمط (mode) — 2 بايت — نوع الملف والصلاحيات
#   الإزاحة 0x02 (2):   معرّف المالك (uid) — 2 بايت
#   الإزاحة 0x04 (4):   الحجم الأدنى (size low) — 4 بايت
#   الإزاحة 0x08 (8):   وقت الوصول (atime) — 4 بايت
#   الإزاحة 0x0C (12):  وقت الإنشاء (ctime) — 4 بايت
#   الإزاحة 0x10 (16):  وقت التعديل (mtime) — 4 بايت
#   الإزاحة 0x14 (20):  وقت الحذف (dtime) — 4 بايت
#   الإزاحة 0x18 (24):  معرّف المجموعة (gid) — 2 بايت
#   الإزاحة 0x1A (26):  عدد الروابط (links_count) — 2 بايت
#   الإزاحة 0x1C (28):  عدد القطاعات (blocks) — 4 بايت (بوحدة 512 بايت)
#   الإزاحة 0x20 (32):  الراياتFlags) — 4 بايت)
#   الإزاحة 0x24 (36):  محجوز لنظام التشغيل (osd1) — 4 بايت
#   الإزاحة 0x28 (40):  كتل مباشرة block[0]-block[11] — 48 بايت (12 × 4)
#   الإزاحة 0x58 (88):  كتلة غير مباشرة (indirect) — 4 بايت
#   الإزاحة 0x5C (92):  كتلة غير مباشرة مزدوجة (double indirect) — 4 بايت
#   الإزاحة 0x60 (96):  كتلة غير مباشرة ثلاثية (triple indirect) — 4 بايت
#   الإزاحة 0x64 (100): رقم الجيل (generation) — 4 بايت
#   الإزاحة 0x68 (104): سمة ملف موسعة (file ACL) — 4 بايت
#   الإزاحة 0x6C (108): الحجم الأعلى / dir ACL — 4 بايت
#   الإزاحة 0x70 (112): عنوان الشظية (fragment addr) — 4 بايت
#   الإزاحة 0x74 (116): محجوز لنظام التشغيل 2 (osd2) — 12 بايت
#
# أنواع العُقد (النمط — البتات 12-15):
#   0x1000 = أنبوب مسمى (FIFO)
#   0x2000 = جهاز محرفي (character device)
#   0x4000 = دليل (directory)
#   0x6000 = جهاز كتلي (block device)
#   0x8000 = ملف عادي (regular file)
#   0xA000 = رابط رمزي (symbolic link)
#   0xC000 = مقبس (socket)
#
# صلاحيات العُقدة (البتات 0-11 من النمط):
#   بت 0: تنفيذ للآخرين    (0x001)
#   بت 1: كتابة للآخرين     (0x002)
#   بت 2: قراءة للآخرين     (0x004)
#   بت 3: تنفيذ للمجموعة   (0x008)
#   بت 4: كتابة للمجموعة    (0x010)
#   بت 5: قراءة للمجموعة    (0x020)
#   بت 6: تنفيذ للمالك      (0x040)
#   بت 7: كتابة للمالك       (0x080)
#   بت 8: قراءة للمالك       (0x100)
#   بت 9: بت لاصق (sticky)  (0x200)
#   بت 10: set GID           (0x400)
#   بت 11: set UID           (0x800)
#
# الرايات (flags) المُعرّفة في ext2:
#   0x00000001 = تخصيص آمن (secure deletion)
#   0x00000002 = الاحتفاظ بنسخة عند الحذف (undelete)
#   0x00000004 = ضغط الملف (compressed)
#   0x00000008 = كتابة متزامنة (synchronous updates)
#   0x00000010 = ملف ثابت (immutable)
#   0x00000020 = إلحاق فقط (append only)
#   0x00000040 = لا يُضمّن في dump (no dump)
#   0x00000080 = لا تحديث atime (no atime update)
#
# العُقد المحجوزة:
#   1  = قائمة الكتل المعيبة
#   2  = الدليل الجذر (أهم عُقدة!)
#   3  = ACL للمستخدم
#   4  = ACL للمجموعة
#   5  = محمّل الإقلاع
#   6  = دليل الاسترداد (undelete directory)
#   7  = واصف المجموعة المحجوز
#   8  = واصف المجلد (journal)
#   9  = العُقدة المستبعدة (exclude inode)
#   10 = عُقدة النسخ (replica inode)
#   11 = أول عُقدة غير محجوزة (في الإصدار 0)
#
#«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»

# =====================================================================
# الدوال الخارجية — واجهة الأجهزة والنواة
# =====================================================================

# --- دوال الطباعة التسلسلية للتتبع والتشخيص ---
خارجي دالة serial_puts(رسالة)
خارجي دالة serial_put_int(قيمة)
خارجي دالة serial_put_hex(قيمة)

# --- دوال إدارة الذاكرة ---
خارجي دالة kmalloc(مقدار)
خارجي دالة kfree(عنوان)

# --- دوال الوصول للذاكرة الخام ---
# قراءة بايت واحد من عنوان + إزاحة
خارجي دالة mem_read_byte(عنوان، إزاحة)
# كتابة بايت واحد في عنوان + إزاحة
خارجي دالة mem_write_byte(عنوان، إزاحة، قيمة)
# قراءة كلمة (2 بايت) من عنوان + إزاحة
خارجي دالة mem_read_word(عنوان، إزاحة)
# كتابة كلمة (2 بايت) في عنوان + إزاحة
خارجي دالة mem_write_word(عنوان، إزاحة، قيمة)
# قراءة كلمة مزدوجة (4 بايت) من عنوان + إزاحة
خارجي دالة mem_read_dword(عنوان، إزاحة)
# كتابة كلمة مزدوجة (4 بايت) في عنوان + إزاحة
خارجي دالة mem_write_dword(عنوان، إزاحة، قيمة)
# نسخ مقدار من البايتات من مصدر إلى وجهة
خارجي دالة mem_copy(وجهة، مصدر، مقدار)
# ملء منطقة ذاكرة بقيمة معينة
خارجي دالة mem_set(وجهة، قيمة، مقدار)

# =====================================================================
# الدوال الخارجية — وحدة ext2 الأساسية (ext2_نحلة.ص)
# =====================================================================

# هل القسم مُركّب؟ (0=لا، 1=نعم)
خارجي دالة ext2_وضعية_قسم(فهرس_قسم)
# مقاس الكتلة بالبايت لقسم معين
خارجي دالة ext2_مقاس_كتلة(فهرس_قسم)
# عدد العُقد لكل مجموعة كتل
خارجي دالة ext2_عقد_مجموعة(فهرس_قسم)
# قراءة كتلة كاملة من القرص إلى مخزن
خارجي دالة ext2_اقرأ_كتلة(فهرس_قسم، رقم_كتلة، مخزن)
# كتابة كتلة كاملة من مخزن إلى القرص
خارجي دالة ext2_اكتب_كتلة(فهرس_قسم، رقم_كتلة، مخزن)
# قراءة واصف مجموعة كتل — يُخزّن النتيجة في متغيرات مؤقتة
خارجي دالة ext2_اقرأ_واصف_مجموعة(فهرس_قسم، رقم_مجموعة)
# الحصول على رقم كتلة جدول العُقد من آخر واصف تمت قراءته
خارجي دالة ext2_هات_جدول_عقد()
# تخصيص كتلة حرة في القسم
خارجي دالة ext2_خصص_كتلة(فهرس_قسم)
# تحرير كتلة مستخدمة
خارجي دالة ext2_حرر_كتلة(فهرس_قسم، رقم_كتلة)

