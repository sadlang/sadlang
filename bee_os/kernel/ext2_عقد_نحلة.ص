# =====================================================================
# قراءة عُقدة من القرص
# =====================================================================

# تقرأ عُقدة من القرص وتُخزّنها في الكاش
# تُرجع رقم الفتحة في الكاش أو -1 عند الفشل
#
# الخطوات:
# 1. التحقق من وجود العُقدة في الكاش
# 2. حساب رقم المجموعة والفهرس المحلي
# 3. قراءة واصف المجموعة للحصول على جدول العُقد
# 4. حساب رقم الكتلة والإزاحة داخلها
# 5. قراءة الكتلة وتحليل بيانات العُقدة
# 6. تخزين البيانات في الكاش
صدّر دالة ext2_اقرأ_عقدة(فهرس_قسم، رقم_ع)
    # التحقق من صلاحية المُدخلات
    إذا (رقم_ع == 0)
        serial_puts("[EXT2-INODE] خطأ: رقم عُقدة 0 غير صالح\r\n")
        ارجع -1
    نهاية

    # التحقق من أن القسم مُركّب
    متغير وضع_قسم = ext2_وضعية_قسم(فهرس_قسم + 0)
    إذا (وضع_قسم == 0)
        serial_puts("[EXT2-INODE] خطأ: القسم غير مُركّب\r\n")
        ارجع -1
    نهاية

    # هل العُقدة موجودة بالفعل في الكاش؟
    متغير فتحة_موجودة = ابحث_في_كاش(فهرس_قسم + 0، رقم_ع + 0)
    إذا (فتحة_موجودة >= 0)
        # موجودة! إرجاع الفتحة مباشرة
        ارجع فتحة_موجودة + 0
    نهاية

    # --- حساب الموقع على القرص ---

    # رقم المجموعة التي تحتوي العُقدة
    متغير رقم_مجموعة = ext2_عقدة_إلى_مجموعة(فهرس_قسم + 0، رقم_ع + 0)

    # فهرس العُقدة داخل المجموعة
    متغير فهرس_محلي = ext2_عقدة_فهرس_محلي(فهرس_قسم + 0، رقم_ع + 0)

    # قراءة واصف المجموعة
    ext2_اقرأ_واصف_مجموعة(فهرس_قسم + 0، رقم_مجموعة + 0)
    متغير جدول_عقد = ext2_هات_جدول_عقد()

    # حساب الإزاحة بالبايت من بداية جدول العُقد
    متغير إزاحة_بايت = فهرس_محلي * مقاس_عقدة

    # حساب رقم الكتلة والإزاحة داخل الكتلة
    متغير عرض_كتلة = ext2_مقاس_كتلة(فهرس_قسم + 0)
    متغير كتلة_عقدة = جدول_عقد + إزاحة_بايت / عرض_كتلة
    متغير إزاحة_في_كتلة = إزاحة_بايت % عرض_كتلة

    # --- قراءة الكتلة من القرص ---
    متغير مخزن = kmalloc(عرض_كتلة + 0)
    إذا (مخزن == 0)
        serial_puts("[EXT2-INODE] خطأ: فشل تخصيص ذاكرة لقراءة العُقدة\r\n")
        ارجع -1
    نهاية

    ext2_اقرأ_كتلة(فهرس_قسم + 0، كتلة_عقدة + 0، مخزن + 0)

    # --- قراءة حقول العُقدة من المخزن ---
    متغير نمط_محلي = mem_read_word(مخزن + 0، إزاحة_في_كتلة + عق_نمط)
    متغير مالك_محلي = mem_read_word(مخزن + 0، إزاحة_في_كتلة + عق_مالك)
    متغير مقاس_محلي = mem_read_dword(مخزن + 0، إزاحة_في_كتلة + عق_مقاس_أدنى)
    متغير روابط_محلي = mem_read_word(مخزن + 0، إزاحة_في_كتلة + عق_عدد_روابط)
    متغير قطاعات_محلي = mem_read_dword(مخزن + 0، إزاحة_في_كتلة + عق_عدد_قطاعات)
    متغير رايات_محلي = mem_read_dword(مخزن + 0، إزاحة_في_كتلة + عق_رايات)

