# =====================================================================
# تقرير العُقد المُخزّنة
# =====================================================================

صدّر دالة ext2_تقرير_عقد()
    serial_puts("=== تقرير كاش العُقد ===\r\n")
    serial_puts("  فتحات مستخدمة:\r\n")

    متغير ف = 0
    متغير عدد_مستخدمة = 0

    بينما (ف < أقصى_عقد_كاش)
        متغير رقم_ع = هات_رقم_عقدة_كاش(ف + 0)
        إذا (رقم_ع != 0)
            serial_puts("  [")
            serial_put_int(ف + 0)
            serial_puts("] عُقدة #")
            serial_put_int(رقم_ع + 0)

            # عرض النوع
            متغير نمط_محلي = هات_نمط_كاش(ف + 0)
            متغير نوع_محلي = ext2_نوع_عقدة(نمط_محلي + 0)

            إذا (نوع_محلي == نمط_ملف_عادي)
                serial_puts(" [ملف]")
            نهاية
            إذا (نوع_محلي == نمط_دليل)
                serial_puts(" [دليل]")
            نهاية
            إذا (نوع_محلي == نمط_رابط_رمزي)
                serial_puts(" [رابط]")
            نهاية

            serial_puts(" مقاس=")
            serial_put_int(هات_مقاس_كاش(ف + 0))
            serial_puts(" روابط=")
            serial_put_int(هات_روابط_كاش(ف + 0))
            serial_puts("\r\n")

            عدد_مستخدمة = عدد_مستخدمة + 1
        نهاية
        ف = ف + 1
    نهاية

    serial_puts("  المجموع: ")
    serial_put_int(عدد_مستخدمة + 0)
    serial_puts("/")
    serial_put_int(أقصى_عقد_كاش + 0)
    serial_puts(" فتحة مستخدمة\r\n")
    serial_puts("=== نهاية تقرير العُقد ===\r\n")
    ارجع 0
نهاية

