#* تسجيل عملية جديدة في procfs
   المعاملات: معرف العملية، معرف الأب، الأولوية، تجزئة الاسم
   ترجع: فهرس العملية أو -1 *#
صدّر دالة procfs_سجّل_عملية(معرف، أب، أولوية، تجزئة_اسم)
    متغير خ = 0
    بينما (خ < 16)
        متغير وض = اقرأ_وضعية_عملية(خ)
        إذا (وض == وضعية_عملية_فارغة)
            عيّن_وضعية_عملية(خ، وضعية_عملية_جاهزة)
            عيّن_معرف_عملية(خ، معرف)
            عيّن_ذاكرة_عملية(خ، 0)
            عمليات_نشطة = عمليات_نشطة + 1
            ارجع خ
        نهاية
        خ = خ + 1
    نهاية
    kernel_print_string("  [procfs] ERROR: process table full")
    kernel_print_number(10)
    ارجع -1
