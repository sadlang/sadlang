صدّر دالة جدول_أضف_طلب(قرص، قطاع، عنوان_هدف، كتابة، أولوية)
    متغير ع = 0
    بينما (ع < 8)
        متغير فعال = اقرأ_طلب(ع، 5)
        إذا (فعال == 0)
            اكتب_طلب(ع، 0، قرص)
            اكتب_طلب(ع، 1، قطاع)
            اكتب_طلب(ع، 2، عنوان_هدف)
            اكتب_طلب(ع، 3، كتابة)
            اكتب_طلب(ع، 4، أولوية)
            اكتب_طلب(ع، 5، 1)
            عدد_طلبات_معلقة = عدد_طلبات_معلقة + 1
            مجموع_الطلبات = مجموع_الطلبات + 1
            ارجع ع
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية

