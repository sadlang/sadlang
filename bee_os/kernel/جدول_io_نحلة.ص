# القسم 5: اختيار الطلب التالي (SSTF)
# ══════════════════════════════════════════════

#* ── SSTF: اختيار أقرب قطاع لموقع الرأس الحالي ── *#
دالة جدول_اختر_sstf()
    متغير أفضل = -1
    متغير أقل_فرق = 999999999
    
    # أولاً: أعلى أولوية
    متغير أعلى_أولوية = -1
    متغير ع = 0
    بينما (ع < 8)
        متغير فعال = اقرأ_طلب(ع، 5)
        إذا (فعال == 1)
            متغير أول = اقرأ_طلب(ع، 4)
            إذا (أول > أعلى_أولوية)
                أعلى_أولوية = أول
            نهاية
        نهاية
        ع = ع + 1
    نهاية
    
    # اختر أقرب قطاع بين الطلبات ذات الأعلى أولوية
    متغير ع2 = 0
    بينما (ع2 < 8)
        متغير فعال2 = اقرأ_طلب(ع2، 5)
        إذا (فعال2 == 1)
            متغير أول2 = اقرأ_طلب(ع2، 4)
            إذا (أول2 == أعلى_أولوية)
                متغير قطاع = اقرأ_طلب(ع2، 1)
                متغير فرق = فرق_مطلق(قطاع، الموقع_الحالي)
                إذا (فرق < أقل_فرق)
                    أقل_فرق = فرق
                    أفضل = ع2
                نهاية
            نهاية
        نهاية
        ع2 = ع2 + 1
    نهاية
    
    ارجع أفضل
نهاية

# ══════════════════════════════════════════════
# القسم 6: تنفيذ طلب
# ══════════════════════════════════════════════

صدّر دالة جدول_نفّذ_واحد()
    إذا (عدد_طلبات_معلقة == 0) ارجع -1 نهاية
    
    متغير اختيار = -1
    
    # FIFO: أول طلب نشط
    إذا (الخوارزمية_الحالية == خوارزمية_fifo)
        متغير ع = 0
        بينما (ع < 8)
            متغير فعال = اقرأ_طلب(ع، 5)
            إذا (فعال == 1)
                اختيار = ع
                اخرج
            نهاية
            ع = ع + 1
        نهاية
    نهاية
    
    # SSTF
    إذا (الخوارزمية_الحالية == خوارزمية_sstf)
        اختيار = جدول_اختر_sstf()
    نهاية
    
    # SCAN: يمكن أن نستخدم SSTF مع تفضيل الاتجاه
    إذا (الخوارزمية_الحالية == خوارزمية_scan)
        اختيار = جدول_اختر_sstf()
    نهاية
    
    إذا (اختيار < 0) ارجع -1 نهاية
    
    # تنفيذ
    متغير قرص = اقرأ_طلب(اختيار، 0)
    متغير قطاع = اقرأ_طلب(اختيار، 1)
    متغير عنوان = اقرأ_طلب(اختيار، 2)
    متغير كتابة = اقرأ_طلب(اختيار، 3)
    
    # حساب حركة الرأس
    متغير حركة = فرق_مطلق(قطاع، الموقع_الحالي)
    مجموع_الحركة = مجموع_الحركة + حركة
    الموقع_الحالي = قطاع
    
    # قراءة فقط (لا دعم كتابة في الوقت الحالي)
    إذا (كتابة == 0)
        disk_read_sector(قرص، قطاع، عنوان)
    نهاية
    
    # تحرير الطلب
    اكتب_طلب(اختيار، 5، 0)
    عدد_طلبات_معلقة = عدد_طلبات_معلقة - 1
    مجموع_المنفذة = مجموع_المنفذة + 1
    
    ارجع 0
نهاية

#* ── تنفيذ كل الطلبات المعلقة ── *#
صدّر دالة جدول_نفذ_الكل()
    متغير تم_تنفيذ = 0
