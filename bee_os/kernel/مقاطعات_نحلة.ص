## ═══════════════════════════════════════════════════
##  معالج لوحة المفاتيح (IRQ1 — المقاطعة 33)
## ═══════════════════════════════════════════════════
## لوحة مفاتيح PS/2 تُرسل scancode عند كل ضغطة/رفع.
##
## Scancode Set 1 (الأكثر شيوعاً):
##   - ضغط المفتاح: scancode (مثل: 0x1E = 'A')
##   - رفع المفتاح: scancode | 0x80 (مثل: 0x9E = رفع 'A')
##
## جدول بعض scancodes الشائعة:
##   0x01: Escape     │  0x1C: Enter     │  0x39: Space
##   0x02: '1'        │  0x1E: 'A'       │  0x0E: Backspace
##   0x03: '2'        │  0x1F: 'S'       │  0x0F: Tab
##   ...              │  0x20: 'D'       │  0x2A: Left Shift
##
## في نظام حقيقي، المعالج يُحوّل scancode إلى حرف (ASCII/Unicode)
## ويضعه في مخزن مؤقت (keyboard buffer) ليقرأه البرنامج.
دالة معالج_لوحة_المفاتيح()
    # قراءة scancode من منفذ بيانات لوحة المفاتيح
    متغير scancode = اقرأ_منفذ(منفذ_بيانات_لوحة)
    
    # تجاهل أحداث رفع المفتاح (بت 7 مُفعّل)
    إذا (scancode < 128)
        # ضغط مفتاح جديد
        ضغطات_لوحة_عدد = ضغطات_لوحة_عدد + 1
        مفتاح_اخير_ضغط = scancode
        
        serial_اطبع("[KB] ضغطة #")
        serial_اطبع_رقم(ضغطات_لوحة_عدد)
        serial_اطبع(" → scancode: ")
        serial_اطبع_ست_عشري(scancode)
        
        # تحويل بعض المفاتيح الشائعة للعرض
        متغير حرف = حوّل_scancode(scancode)
        إذا (حرف > 0)
            serial_اطبع(" = '")
            اكتب_حرف_تسلسلي(COM1، حرف)
            serial_اطبع("'")
        نهاية
        
        serial_اطبع("\n")
        
        # فحص مفاتيح خاصة
        إذا (scancode == 1)    # Escape
            serial_اطبع("  [!] مفتاح Escape — سيتم إيقاف النظام\n")
        نهاية
    نهاية
    
    # إرسال EOI
    أرسل_نهاية_مقاطعة(IRQ_لوحة_مفاتيح)
نهاية

