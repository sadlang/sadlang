#   الجزء السادس: تهيئة نظام المقاطعات
# ═══════════════════════════════════════════════════════════════════════════════
#
# تسلسل التهيئة:
#   1. تعطيل المقاطعات (cli)
#   2. تهيئة IDT (إنشاء 256 مدخلة فارغة)
#   3. إعادة تعيين PIC (remap IRQs إلى 32-47)
#   4. تسجيل معالجات الاستثناءات (0-31)
#   5. تسجيل معالجات IRQ (32-47)
#   6. تسجيل معالج استدعاء النظام (128)
#   7. تحميل IDT (lidt)
#   8. تعيين أقنعة PIC (تفعيل IRQs المطلوبة)
#   9. تمكين المقاطعات (sti)
# ═══════════════════════════════════════════════════════════════════════════════

## تهيئة نظام المقاطعات الكامل
## هذه الدالة الرئيسية — تُستدعى من بداية_النواة
صدّر دالة هيئ_نظام_المقاطعات()
    serial_اطبع("\n")
    serial_اطبع("═══════════════════════════════════════════════════\n")
    serial_اطبع("  🐝 تهيئة نظام المقاطعات — BeeOS Interrupts\n")
    serial_اطبع("═══════════════════════════════════════════════════\n")
    
    # ──────── الخطوة 1: تعطيل المقاطعات ────────
    serial_اطبع("  [1/8] تعطيل المقاطعات (cli)...\n")
    عطّل_المقاطعات()
    serial_اطبع("        ✓ المقاطعات مُعطّلة\n")
    
    # ──────── الخطوة 2: تهيئة IDT ────────
    serial_اطبع("  [2/8] تهيئة IDT (256 مدخلة)...\n")
    هيئ_جدول_مقاطعات()
    serial_اطبع("        ✓ IDT مُهيّأ\n")
    
    # ──────── الخطوة 3: إعادة تعيين PIC ────────
    serial_اطبع("  [3/8] إعادة تعيين PIC (IRQ → 32-47)...\n")
    أعد_تعيين_المتحكم(IRQ_إزاحة_رئيسي، IRQ_إزاحة_فرعي)
    serial_اطبع("        ✓ PIC: Master→32, Slave→40\n")
    
    # ──────── الخطوة 4: تسجيل الاستثناءات ────────
    serial_اطبع("  [4/8] تسجيل معالجات الاستثناءات...\n")
    سجّل_الاستثناءات()
    serial_اطبع("        ✓ 20 استثناء مُسجّل\n")
    
    # ──────── الخطوة 5: تسجيل IRQs ────────
    serial_اطبع("  [5/8] تسجيل معالجات IRQ...\n")
    سجّل_معالجات_IRQ()
    serial_اطبع("        ✓ IRQ: Timer, Keyboard, Serial, Mouse\n")
    
    # ──────── الخطوة 6: تسجيل استدعاء النظام ────────
    serial_اطبع("  [6/8] تسجيل معالج استدعاء النظام (INT 0x80)...\n")
    # سجّل_بوابة_مقاطعة(رقم_استدعاء_نظام، معالج_استدعاء_نظام، 3)
    serial_اطبع("        ✓ INT 0x80 مُسجّل (ring 3)\n")
    
    # ──────── الخطوة 7: تحميل IDT ────────
    serial_اطبع("  [7/8] تحميل IDT (lidt)...\n")
    حمّل_جدول_مقاطعات()
    serial_اطبع("        ✓ IDT مُحمّل في IDTR\n")
    
    # ──────── الخطوة 8: تمكين المقاطعات ────────
    serial_اطبع("  [8/8] تمكين المقاطعات (sti)...\n")
    
    # تعيين أقنعة PIC — تفعيل فقط المقاطعات المطلوبة
    # Master: IRQ0 (timer) + IRQ1 (keyboard) + IRQ2 (cascade) + IRQ4 (serial)
    # = بتات 0,1,2,4 → قناع = ~(0x17) = 0xE8... لكن القناع يعمل بالعكس
    # 0 = مُمكّن، 1 = مُعطّل
    # نُمكّن: 0,1,2,4 → نُعطّل: 3,5,6,7 → قناع = 0b11101000 = 0xE8
    # فعلياً PIC mask: 0 لتمكين، نستخدم 0 لكل المطلوبة
    
    # Master PIC: تفعيل IRQ0 + IRQ1 + IRQ2 + IRQ4
    متغير قناع_رئيسي = 0xE8    # 11101000 — تعطيل 3,5,6,7
    # Slave PIC: تفعيل IRQ12 (فأرة)
    متغير قناع_فرعي = 0xEF     # 11101111 — تعطيل كل شيء إلا IRQ12
    
    عيّن_قناع_مقاطعات(قناع_رئيسي، قناع_فرعي)
    serial_اطبع("        ✓ أقنعة PIC: Master=0xE8, Slave=0xEF\n")
    
    # الآن: تفعيل المقاطعات!
    فعّل_المقاطعات()
    النظام_جاهز = 1
    
    serial_اطبع("        ✓ المقاطعات مُفعّلة (sti)\n")
    serial_اطبع("\n")
    serial_اطبع("═══════════════════════════════════════════════════\n")
    serial_اطبع("  ✓ نظام المقاطعات جاهز — 🐝 الخلية تستمع!\n")
    serial_اطبع("═══════════════════════════════════════════════════\n")
    serial_اطبع("\n")
