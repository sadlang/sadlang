##
## تعريفات.ص — BeeDrivers: مشغّلات أجهزة BeeOS
##
## الغرض: مشغّلات x86 حقيقية للأجهزة الأساسية
##        يعمل مع kernel BeeOS على الأجهزة الحقيقية
##
## المحتويات:
##   1. BeeKB  — مشغّل لوحة المفاتيح PS/2 (IRQ1, port 0x60)
##   2. BeeVGA — مشغّل الشاشة المتقدم (cursor, scroll, color)
##   3. BeePCI — مشغّل PCI Bus (enumeration, config space)
##   4. BeeTimer — مشغّل المؤقت PIT (IRQ0, 8253/8254)
##   5. BeeRTC — مشغّل الساعة الفورية RTC (CMOS port 0x70/0x71)
##
## الأجهزة الحقيقية:
##   PS/2 Controller: Intel 8042 (port 0x60 data, 0x64 status/cmd)
##   VGA: port 0x3D4/0x3D5 للـ CRT registers
##   PCI: port 0xCF8 (config address), 0xCFC (config data)
##   PIT: port 0x40/0x41/0x42 (timers), 0x43 (mode/cmd)
##   RTC: port 0x70 (index), 0x71 (data)
##
## المؤلف: BeeOS — بسم الله الرحمن الرحيم
##

# ==================================================
#  ثوابت المنافذ (I/O Ports)
# ==================================================

## PS/2 Keyboard
متغير KB_PORT_DATA    = 0x60   # قراءة scan code / بيانات PS/2
متغير KB_PORT_STATUS  = 0x64   # قراءة حالة 8042 controller
متغير KB_PORT_CMD     = 0x64   # كتابة أوامر 8042

## VGA CRT Controller
متغير VGA_INDEX_PORT  = 0x3D4  # فهرس الـ register
متغير VGA_DATA_PORT   = 0x3D5  # بيانات الـ register
متغير VGA_CURSOR_LOW  = 15     # Cursor Position Low (CRT reg 0x0F)
متغير VGA_CURSOR_HIGH = 14     # Cursor Position High (CRT reg 0x0E)

## PCI Configuration Space
متغير PCI_CONFIG_ADDR = 0xCF8  # عنوان طلب الـ config read/write
متغير PCI_CONFIG_DATA = 0xCFC  # بيانات config space

## PIT (Programmable Interval Timer 8253/8254)
متغير PIT_CH0_PORT    = 0x40   # قناة 0 (IRQ0 system timer)
متغير PIT_CH2_PORT    = 0x42   # قناة 2 (PC speaker)
متغير PIT_MODE_PORT   = 0x43   # register الوضع
متغير PIT_FREQ_BASE   = 1193182  # التردد الأساسي (Hz)

## RTC على CMOS
متغير RTC_INDEX_PORT  = 0x70   # فهرس الـ register + NMI mask
متغير RTC_DATA_PORT   = 0x71   # بيانات CMOS
متغير RTC_REG_SEC     = 0      # الثواني (BCD or binary)
متغير RTC_REG_MIN     = 2      # الدقائق
متغير RTC_REG_HOUR    = 4      # الساعات
متغير RTC_REG_DAY     = 7      # اليوم
متغير RTC_REG_MONTH   = 8      # الشهر
متغير RTC_REG_YEAR    = 9      # السنة

## VGA Memory Base (Text Mode)
متغير VGA_TEXT_MEMORY = 0xB8000  # العنوان الفيزيائي لذاكرة النص

## إصدار المشغّلات
متغير إصدار_مشغل = "1.0"

