نهاية

##
## beeui_تطبيق_رسالة — نافذة رسالة (Dialog Box)
##
دالة beeui_تطبيق_رسالة(عنوان_رسالة، نص_رسالة)
    متغير معرف_رسالة = beeui_نافذة_جديدة(عنوان_رسالة، 20، 8، 46، 5)
    beeui_نافذة_محتوى(عنوان_رسالة، نص_رسالة، 46)
    متغير زر_موافق = beeui_زر_جديد(معرف_رسالة، "موافق"، 38، 13)
    beeui_ارسم_زر(زر_موافق)
    ارجع معرف_رسالة
نهاية

##
## beeui_تطبيق_عن — نافذة "حول BeeOS"
##
دالة beeui_تطبيق_عن()
    متغير معرف_حول = beeui_نافذة_جديدة("حول BeeOS"، 10، 5، 50، 7)
    beeui_نافذة_محتوى("حول BeeOS"، "الاصدار: 1.0 -- وقف خيري للعلم"، 50)
    beeui_نافذة_محتوى("رخصة"، "نظام النحلة -- بسم الله"، 50)
    متغير زر_حول = beeui_زر_جديد(معرف_حول، "إغلاق"، 40، 14)
    beeui_ارسم_زر(زر_حول)
    ارجع معرف_حول
نهاية

# ==================================================
#  حلقة الأحداث الرئيسية
# ==================================================

##
## beeui_حلقة_أحداث — محاكاة حلقة الأحداث
##
## على الأجهزة الحقيقية (x86):
##   1. PIC init: ICW1=0x11, ICW2/3/4, mask bits لـ IRQ1+IRQ12
##   2. IDT vectors 33(KB) 44(Mouse)
##   3. _start: sti + hlt loop
##   4. isr_keyboard: قراءة scan code من port 0x60
##   5. isr_mouse: قراءة 3 بايت من port 0x60، تحديث cursor_x/y
##   6. إذا left_click: فحص Z-order قائمة الأزرار
##
دالة beeui_حلقة_أحداث()
    اطبع_سطر("[BeeUI] بدء حلقة الاحداث (5 احداث محاكاة)...")
    متغير احداث = ["click:5:10", "click:12:10", "click:19:10", "key:Esc", "click:99:99"]
    لكل حدث_واحد في احداث
        اطبع_سطر("[BeeUI] حدث: " + حدث_واحد)
    نهاية
    # استخدم .الطول() على المصفوفة المحلية (يعمل على المتغيرات المحلية)
    متغير عدد_احداث_نهائي = احداث.الطول()
    اطبع_سطر("[BeeUI] انتهت الحلقة (" + عدد_احداث_نهائي + " احداث)")
    ارجع عدد_احداث_نهائي
نهاية

# ==================================================
#  اختبارات BeeUI
# ==================================================

دالة beeui_اختبر()
    اطبع_سطر("================================================")
    اطبع_سطر("  BeeUI v" + إصدار_بيوي + " -- اختبارات الواجهة")
    اطبع_سطر("================================================")
    متغير عدد_نجاح = 0
    متغير عدد_فشل  = 0

    # اختبار 1: رسم سطح المكتب
    اطبع_سطر("-- اختبار 1: سطح المكتب...")
    beeui_رسم_سطح_مكتب()
    متغير عدد_نجاح = عدد_نجاح + 1
    اطبع_سطر("[نجح]")

    # اختبار 2: إنشاء نافذة BeeCalc
    اطبع_سطر("-- اختبار 2: انشاء نافذة BeeCalc...")
    متغير نافذة_حاسبة = beeui_نافذة_جديدة("BeeCalc"، 2، 2، 40، 8)
    إذا (نافذة_حاسبة == 0)
        متغير عدد_نجاح = عدد_نجاح + 1
        اطبع_سطر("[نجح] id=" + نافذة_حاسبة)
    وإلا
        متغير عدد_فشل = عدد_فشل + 1
        اطبع_سطر("[فشل] id=" + نافذة_حاسبة)
    نهاية

    # اختبار 3: قراءة بيانات من المصفوفات المتوازية
    اطبع_سطر("-- اختبار 3: قراءة بيانات المصفوفات...")
    متغير عنوان_مقروء = نوافذ_عناوين[0]
    متغير عرض_مقروء   = نوافذ_أعراض[0]
    اطبع_سطر("  العنوان: " + عنوان_مقروء + " | العرض: " + عرض_مقروء)
    إذا (عنوان_مقروء == "BeeCalc")
        متغير عدد_نجاح = عدد_نجاح + 1
        اطبع_سطر("[نجح]")
    وإلا
        متغير عدد_فشل = عدد_فشل + 1
        اطبع_سطر("[فشل]")
    نهاية

    # اختبار 4: رسم النافذة
    اطبع_سطر("-- اختبار 4: رسم نافذة BeeCalc...")
    beeui_ارسم_نافذة("BeeCalc"، 40، 8)
    متغير عدد_نجاح = عدد_نجاح + 1
    اطبع_سطر("[نجح]")

    # اختبار 5: إضافة أزرار الحاسبة
    اطبع_سطر("-- اختبار 5: اضافة ازرار...")
    متغير زر_plus  = beeui_زر_جديد(نافذة_حاسبة، "+"، 5، 10)
    متغير زر_minus = beeui_زر_جديد(نافذة_حاسبة، "-"، 12، 10)
    متغير زر_eq    = beeui_زر_جديد(نافذة_حاسبة، "="، 19، 10)
    beeui_ارسم_زر(زر_plus)
    beeui_ارسم_زر(زر_minus)
    beeui_ارسم_زر(زر_eq)
    متغير عدد_نجاح = عدد_نجاح + 1
    اطبع_سطر("[نجح]")

    # اختبار 6: نافذة BeeSh
    اطبع_سطر("-- اختبار 6: نافذة BeeSh...")
    متغير نافذة_صدفة = beeui_نافذة_جديدة("BeeSh"، 42، 2، 36، 8)
    beeui_ارسم_نافذة("BeeSh"، 36، 8)
    متغير عدد_نجاح = عدد_نجاح + 1
    اطبع_سطر("[نجح]")

    # اختبار 7: نافذة رسالة ترحيبية
    اطبع_سطر("-- اختبار 7: نافذة رسالة...")
    beeui_تطبيق_رسالة("مرحبا"، "BeeOS جاهز -- الحمد لله")
    متغير عدد_نجاح = عدد_نجاح + 1
    اطبع_سطر("[نجح]")

    # اختبار 8: نافذة "حول BeeOS"
    اطبع_سطر("-- اختبار 8: نافذة حول BeeOS...")
    beeui_تطبيق_عن()
    متغير عدد_نجاح = عدد_نجاح + 1
    اطبع_سطر("[نجح]")

    # اختبار 9: ضغطة ماوس على زر مسجل
    اطبع_سطر("-- اختبار 9: ضغطة ماوس على زر +...")
    متغير عدد_أزرار_حالي = أزرار_نصوص.الطول()
    متغير نتيجة_ضغطة = beeui_تحقق_ضغطة(5، 10، عدد_أزرار_حالي)
    إذا (نتيجة_ضغطة == زر_plus)
        متغير عدد_نجاح = عدد_نجاح + 1
        اطبع_سطر("[نجح] زر #" + نتيجة_ضغطة)
    وإلا
        متغير عدد_فشل = عدد_فشل + 1
        اطبع_سطر("[فشل] نتيجة=" + نتيجة_ضغطة)
    نهاية

    # اختبار 10: ضغطة في منطقة فارغة
    اطبع_سطر("-- اختبار 10: ضغطة في منطقة فارغة...")
    متغير عدد_أزرار_حالي2 = أزرار_نصوص.الطول()
    متغير نتيجة_فارغة = beeui_تحقق_ضغطة(70، 20، عدد_أزرار_حالي2)
    إذا (نتيجة_فارغة == -1)
        متغير عدد_نجاح = عدد_نجاح + 1
        اطبع_سطر("[نجح] لا يوجد زر")
    وإلا
        متغير عدد_فشل = عدد_فشل + 1
        اطبع_سطر("[فشل] وجد زر مفاجئ=" + نتيجة_فارغة)
    نهاية

    # اختبار 11: حلقة الأحداث
    اطبع_سطر("-- اختبار 11: حلقة الاحداث...")
    متغير عدد_احداث = beeui_حلقة_أحداث()
    إذا (عدد_احداث == 5)
        متغير عدد_نجاح = عدد_نجاح + 1
        اطبع_سطر("[نجح] " + عدد_احداث + " احداث")
    وإلا
        متغير عدد_فشل = عدد_فشل + 1
        اطبع_سطر("[فشل] " + عدد_احداث + " احداث")
    نهاية

    اطبع_سطر("================================================")
    اطبع_سطر("  نجح: " + عدد_نجاح + " | فشل: " + عدد_فشل)
    اطبع_سطر("  نوافذ: " + نوافذ_عناوين.الطول() + " | ازرار: " + أزرار_نصوص.الطول())
    اطبع_سطر("================================================")
    ارجع عدد_نجاح
نهاية

# ==================================================
#  نقطة الدخول
# ==================================================

