##
## واجهة.ص — BeeUI: نظام النوافذ الرسومي لـ BeeOS
##
## الغرض: مدير نوافذ بسيط يعمل على VGA Text Mode (80×25)
##        يدعم العربية ويعمل على الأجهزة الحقيقية
##
## التصميم: مصفوفات متوازية لتمثيل البيانات
##   (ص لا تدعم array[i]["key"] — لذا نستخدم مصفوفات منفصلة)
##     نوافذ_عناوين[i]    = عنوان النافذة i
##     نوافذ_أعمدة[i]     = عمود النافذة i
##     نوافذ_صفوف[i]      = صف النافذة i
##     نوافذ_أعراض[i]     = عرض النافذة i
##     نوافذ_ارتفاعات[i]  = ارتفاع النافذة i
##
## الأجهزة الحقيقية:
##   VGA Text Mode 0xB8000 — 80×25 خلية
##   كل خلية: 2 بايت (ASCII + صفة_لون)
##   Port 0x3D4/0x3D5: تحريك مؤشر النص
##   IRQ1  (0x21): PS/2 Keyboard — scan codes من port 0x60
##   IRQ12 (0x2C): PS/2 Mouse — 3 بايت: buttons, dx, dy
##
## المؤلف: BeeOS — بسم الله الرحمن الرحيم
##

# ==================================================
#  ثوابت الشاشة
# ==================================================

متغير شاشة_عرض   = 80
متغير شاشة_ارتفاع = 25

# ألوان VGA (لون_خلفية * 16 + لون_نص)
متغير لون_سطح_مكتب  = 23
متغير لون_عنوان_نافذة = 31
متغير لون_نافذة_عادية = 7
متغير لون_زر_عادي    = 112
متغير لون_زر_مظلل   = 71

# رموز الحد (ASCII box drawing)
متغير رمز_أفقي      = "="
متغير رمز_عمودي     = "|"
متغير رمز_زاوية     = "+"
متغير رمز_زر_إغلاق  = "[X]"

متغير إصدار_بيوي = "1.0"

# ==================================================
#  مصفوفات بيانات النوافذ (Parallel Arrays)
# ==================================================

متغير عدد_نوافذ     = 0
متغير نوافذ_عناوين  = []
متغير نوافذ_أعمدة   = []
متغير نوافذ_صفوف    = []
متغير نوافذ_أعراض   = []
متغير نوافذ_ارتفاعات = []

# مصفوفات بيانات الأزرار
متغير عدد_أزرار   = 0
متغير أزرار_نصوص  = []
متغير أزرار_أعمدة = []
متغير أزرار_صفوف  = []
متغير أزرار_أعراض  = []
متغير أزرار_نوافذ = []
متغير أزرار_فهارس = []

# ==================================================
#  دوال الرسم الأساسية
# ==================================================

##
## beeui_شريط_أفقي — يبني شريطاً أفقياً بطول محدد
##
دالة beeui_شريط_أفقي(طول_شريط)
    متغير ناتج_شريط = ""
    متغير أحرف_شريط = ["=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","=","="]
    متغير عداد_شريط = 0
    لكل حرف_واحد في أحرف_شريط
        إذا (عداد_شريط < طول_شريط)
            متغير ناتج_شريط = ناتج_شريط + حرف_واحد
        نهاية
        متغير عداد_شريط = عداد_شريط + 1
    نهاية
    ارجع ناتج_شريط
نهاية

##
## beeui_حد_علوي — يطبع الحد العلوي للنافذة مع العنوان
##
## مثال: +== عنوان النافذة [X] ==+
##
دالة beeui_حد_علوي(عنوان_حد، عرض_حد)
    اطبع_سطر("+==[ " + عنوان_حد + " " + رمز_زر_إغلاق + " ]==+")
    ارجع 0
نهاية

##
## beeui_حد_سفلي — يطبع الحد السفلي
##
دالة beeui_حد_سفلي(عرض_حد)
    اطبع_سطر("+===================================+")
    ارجع 0
نهاية

##
## beeui_صف_نافذة — يطبع صفاً داخلياً
##
دالة beeui_صف_نافذة(محتوى_صف)
    اطبع_سطر(رمز_عمودي + " " + محتوى_صف)
    ارجع 0
نهاية

# ==================================================
#  مدير النوافذ
# ==================================================

##
## beeui_نافذة_جديدة — يسجل نافذة في المصفوفات المتوازية
##
دالة beeui_نافذة_جديدة(عنوان_نافذة، عمود_نافذة، صف_نافذة، عرض_نافذة، ارتفاع_نافذة)
    متغير معرف_جديد = نوافذ_عناوين.الطول()
    أضف(نوافذ_عناوين،   عنوان_نافذة)
    أضف(نوافذ_أعمدة،    عمود_نافذة)
    أضف(نوافذ_صفوف،     صف_نافذة)
    أضف(نوافذ_أعراض،    عرض_نافذة)
    أضف(نوافذ_ارتفاعات، ارتفاع_نافذة)
    اطبع_سطر("[BeeUI] نافذة #" + معرف_جديد + ": '" + عنوان_نافذة + "' " + عرض_نافذة + "x" + ارتفاع_نافذة)
    ارجع معرف_جديد
نهاية

##
## beeui_ارسم_نافذة — يرسم نافذة مباشرة بمعطياتها (3 صفوف ثابتة)
##
دالة beeui_ارسم_نافذة(عنوان_نف, عرض_نف, ارتفاع_نف)
    # الحد العلوي
    beeui_حد_علوي(عنوان_نف, عرض_نف)
    # صفوف ثابتة داخل النافذة (لكل لتجنب مشكلة بينما)
    متغير صفوف_فارغة = ["", "", "", "", "", "", "", "", "", ""]
    لكل صف_مؤقت في صفوف_فارغة
        beeui_صف_نافذة(صف_مؤقت)
    نهاية
    # الحد السفلي
    beeui_حد_سفلي(عرض_نف)
    اطبع_سطر("[BeeUI] رُسمت نافذة '" + عنوان_نف + "'")
    ارجع 0
نهاية

##
## beeui_نافذة_محتوى — يرسم نافذة مع محتوى
##
دالة beeui_نافذة_محتوى(عنوان_محتوى، سطر_محتوى، عرض_محتوى)
    beeui_حد_علوي(عنوان_محتوى، عرض_محتوى)
    beeui_صف_نافذة(سطر_محتوى)
    beeui_حد_سفلي(عرض_محتوى)
    ارجع 0
نهاية

# ==================================================
#  الأزرار
# ==================================================

##
## beeui_زر_جديد — يسجل زراً في المصفوفات
##
## على الأجهزة الحقيقية:
##   - عند IRQ12: تحقق إن (cursor_x, cursor_y) يقع ضمن [x, x+w) × {y}
##   - إذا left_button=1: نفّذ callback الزر
##
دالة beeui_زر_جديد(معرف_نافذة، نص_زر، عمود_زر، صف_زر)
    متغير معرف_زر = أزرار_نصوص.الطول()
    أضف(أزرار_نصوص،  نص_زر)
    أضف(أزرار_أعمدة, عمود_زر)
    أضف(أزرار_صفوف,  صف_زر)
    أضف(أزرار_أعراض, نص_زر.الطول() + 4)
    أضف(أزرار_نوافذ, معرف_نافذة)
    أضف(أزرار_فهارس, معرف_زر)
    اطبع_سطر("[BeeUI]   زر #" + معرف_زر + ": '" + نص_زر + "' نافذة=" + معرف_نافذة)
    ارجع معرف_زر
نهاية

##
## beeui_ارسم_زر — يطبع مظهر الزر
##
دالة beeui_ارسم_زر(معرف_زر)
    إذا (معرف_زر >= أزرار_نصوص.الطول())
        ارجع 0
    نهاية
    متغير نص_زر_ع = أزرار_نصوص[معرف_زر]
    اطبع_سطر("  [ " + نص_زر_ع + " ]")
    ارجع 0
نهاية

# ==================================================
#  معالج أحداث الماوس
# ==================================================

##
## beeui_تحقق_ضغطة — يتحقق هل click يقع على زر مسجل
## يستخدم لكل مع أزرار_فهارس لتجنب مشكلة بينما counter داخل الدوال
##
دالة beeui_تحقق_ضغطة(عمود_ضغطة, صف_ضغطة, عدد_أزرار_بحث)
    لكل فهرس_زر في أزرار_فهارس
        متغير عمود_زر_مح = أزرار_أعمدة[فهرس_زر]
        متغير صف_زر_مح   = أزرار_صفوف[فهرس_زر]
        متغير عرض_زر_مح  = أزرار_أعراض[فهرس_زر]
        متغير في_أفقي    = عمود_ضغطة >= عمود_زر_مح و عمود_ضغطة < عمود_زر_مح + عرض_زر_مح
        متغير في_عمودي   = صف_ضغطة == صف_زر_مح
        إذا (في_أفقي و في_عمودي)
            اطبع_سطر("[BeeUI] click: زر #" + فهرس_زر + " '" + أزرار_نصوص[فهرس_زر] + "'")
            ارجع فهرس_زر
        نهاية
    نهاية
    اطبع_سطر("[BeeUI] click @ (" + عمود_ضغطة + "," + صف_ضغطة + ") لا يوجد زر")
    ارجع -1
نهاية

