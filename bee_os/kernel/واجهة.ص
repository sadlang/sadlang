#  سطح المكتب الإسلامي
# ==================================================

##
## beeui_رسم_سطح_مكتب — يرسم الشاشة الرئيسية لـ BeeOS
##
دالة beeui_رسم_سطح_مكتب()
    اطبع_سطر("+==============================================================================+")
    اطبع_سطر("|  BeeOS v1.0 -- نظام النحلة                                                  |")
