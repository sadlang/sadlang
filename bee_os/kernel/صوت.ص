    تحميل_مقطع("الحمد_لله.pcm"، 196608، 48000، 16)
    تحميل_مقطع("نقرة.pcm"، 4096، 44100، 16)
    تحميل_مقطع("السلام_عليكم.pcm"، 147456، 48000، 16)
    تحميل_مقطع("أذان_الفجر.pcm"، 4718592، 48000، 24)

    اطبع_سطر("  ✓ " + مقاطع_عدد[0] + " مقطع صوتي إسلامي محمّل")
