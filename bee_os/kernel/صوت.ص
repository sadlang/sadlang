# ══════════════════════════════════════════════════════════════
#  § 3 — اكتشاف بطاقة الصوت PCI
# ══════════════════════════════════════════════════════════════

دالة اكتشاف_بطاقة_صوت()
    اطبع_سطر("[Audio] PCI Scan — Class 0x04 Sub 0x03 (HD Audio)")

    # محاكاة اكتشاف PCI: Intel Tiger Lake HDA
    # Bus 0, Dev 31, Func 3 — PCI ID 8086:A0C8
    متغير مصنع_pci = "Intel"
    متغير جهاز_pci = "Tiger Lake HD Audio"
    متغير ناقل = 0
    متغير جهاز = 31
    متغير وظيفة = 3
    متغير bar0 = 4261609472

    صوت_مصنع[0] = مصنع_pci
    صوت_معرف_جهاز[0] = 41160
    صوت_mmio_base[0] = bar0

    اطبع_سطر("  [PCI " + ناقل + ":" + جهاز + "." + وظيفة + "] " + مصنع_pci + " " + جهاز_pci)
    اطبع_سطر("  [+] BAR0 (MMIO): 0xFE030000")
    اطبع_سطر("  [+] IRQ: 16 (MSI-X)")

    ارجع 1
نهاية

# ══════════════════════════════════════════════════════════════
#  § 4 — تهيئة HDA Controller
# ══════════════════════════════════════════════════════════════

دالة تهيئة_hda()
    إذا (صوت_mmio_base[0] == 0)
        اطبع_سطر("[Audio] ✗ لم يُكتشف جهاز صوت")
        ارجع 0
    نهاية

    اطبع_سطر("[HDA] تهيئة متحكم Intel HD Audio")

    # 1. إعادة تشغيل المتحكم (GCTL)
    اطبع_سطر("  [+] GCTL ← 0x01: إعادة تشغيل (CRST)")

    # 2. انتظار الاستقرار
    اطبع_سطر("  [+] GCTL bit 0 = 1: المتحكم مستقر")

    # 3. قراءة Global Capabilities
    # GCAP: OSS(4) ISS(4) BSS(5) NSDO(2) 64OK(1)
    متغير oss = 4
    متغير iss = 4
    اطبع_سطر("  [+] GCAP: " + oss + " Output + " + iss + " Input streams")

    # 4. تهيئة CORB (Command Outbound Ring Buffer)
    اطبع_سطر("  [+] CORB: 256 entries @ DMA buffer")

    # 5. تهيئة RIRB (Response Inbound Ring Buffer)
    اطبع_سطر("  [+] RIRB: 256 entries @ DMA buffer")

    # 6. تفعيل المقاطعات
    اطبع_سطر("  [+] INTCTL ← GIE + CIE: تفعيل المقاطعات")

    # 7. اكتشاف Codecs (STATESTS)
    أضف(codec_معرفات، "0x10EC0888")
    أضف(codec_أسماء، "Realtek ALC888")
    codec_عدد[0] = codec_عدد[0] + 1

    أضف(codec_معرفات، "0x80862805")
    أضف(codec_أسماء، "Intel HDMI Audio")
    codec_عدد[0] = codec_عدد[0] + 1

    اطبع_سطر("  [+] Codecs اُكتشفت: " + codec_عدد[0])
    متغير ك = [0]
    بينما (ك[0] < codec_عدد[0])
        متغير فهرس = ك[0]
        اطبع_سطر("    [" + فهرس + "] " + codec_أسماء[فهرس] + " (" + codec_معرفات[فهرس] + ")")
        ك[0] = ك[0] + 1
    نهاية

    # 8. تهيئة DMA buffer للصوت
    dma_مقاس[0] = 65536
    dma_قاعدة[0] = 2147483648
    dma_موقع[0] = 0
    اطبع_سطر("  [+] DMA Buffer: 64KB @ 0x80000000")

    # 9. إنشاء قنوات الإخراج
    أضف(قنوات_أسماء، "Master Output")
    أضف(قنوات_حالات، AUDIO_STOPPED)
    أضف(قنوات_أولويات، PRIORITY_MEDIA)
    أضف(قنوات_مستوى، 80)
    أضف(قنوات_تردد، 48000)
    أضف(قنوات_عينات، 16)
    قنوات_عدد[0] = قنوات_عدد[0] + 1

    أضف(قنوات_أسماء، "Notifications")
    أضف(قنوات_حالات، AUDIO_STOPPED)
    أضف(قنوات_أولويات، PRIORITY_NOTIFY)
    أضف(قنوات_مستوى، 60)
    أضف(قنوات_تردد، 44100)
    أضف(قنوات_عينات، 16)
    قنوات_عدد[0] = قنوات_عدد[0] + 1

    أضف(قنوات_أسماء، "Adhan Priority")
    أضف(قنوات_حالات، AUDIO_STOPPED)
    أضف(قنوات_أولويات، PRIORITY_ADHAN)
    أضف(قنوات_مستوى، 100)
    أضف(قنوات_تردد، 48000)
    أضف(قنوات_عينات، 24)
    قنوات_عدد[0] = قنوات_عدد[0] + 1

    صوت_مهيأ[0] = 1
    اطبع_سطر("  ✓ HDA جاهز: " + codec_عدد[0] + " codec، " + قنوات_عدد[0] + " قنوات إخراج")
    ارجع 1
نهاية

# ══════════════════════════════════════════════════════════════
#  § 5 — الخلّاط (Mixer)
# ══════════════════════════════════════════════════════════════

دالة ضبط_مستوى(قناة، مستوى)
    إذا (مستوى < 0)
        مستوى = 0
    نهاية
    إذا (مستوى > 100)
        مستوى = 100
    نهاية

    إذا (قناة == "رئيسي")
        خلاط_رئيسي[0] = مستوى
    نهاية
    إذا (قناة == "إشعارات")
        خلاط_إشعارات[0] = مستوى
    نهاية
    إذا (قناة == "وسائط")
        خلاط_وسائط[0] = مستوى
    نهاية
    إذا (قناة == "أذان")
        خلاط_أذان[0] = مستوى
    نهاية

    ارجع مستوى
نهاية

دالة كتم_الصوت()
    خلاط_كاتم[0] = 1
    اطبع_سطر("[Mixer] 🔇 الصوت مكتوم")
    ارجع 1
نهاية

دالة إلغاء_كتم()
    خلاط_كاتم[0] = 0
    اطبع_سطر("[Mixer] 🔊 الصوت مفتوح")
    ارجع 1
نهاية

دالة عرض_الخلاط()
    اطبع_سطر("[Mixer] ══════════════════════════════")
    متغير حالة_كتم = "🔊 مفتوح"
    إذا (خلاط_كاتم[0] == 1)
        حالة_كتم = "🔇 مكتوم"
    نهاية
    اطبع_سطر("  الحالة: " + حالة_كتم)
    اطبع_سطر("  🔊 رئيسي:   " + خلاط_رئيسي[0] + "%")
    اطبع_سطر("  📢 إشعارات: " + خلاط_إشعارات[0] + "%")
    اطبع_سطر("  🎵 وسائط:   " + خلاط_وسائط[0] + "%")
    اطبع_سطر("  🕌 أذان:    " + خلاط_أذان[0] + "% (أولوية قصوى)")
    ارجع 1
نهاية

# ══════════════════════════════════════════════════════════════
#  § 6 — تحميل وتشغيل مقاطع صوتية
# ══════════════════════════════════════════════════════════════

دالة تحميل_مقطع(اسم_ملف، مقاس_بايت، تردد، بت)
    أضف(مقاطع_أسماء، اسم_ملف)
    أضف(مقاطع_أحجام، مقاس_بايت)
    أضف(مقاطع_ترددات، تردد)
    أضف(مقاطع_أنماط، بت)
    متغير رقم_المقطع = مقاطع_عدد[0]
    مقاطع_عدد[0] = مقاطع_عدد[0] + 1
    اطبع_سطر("[Audio] تحميل: " + اسم_ملف + " (" + مقاس_بايت + "B, " + تردد + "Hz, " + بت + "bit)")
    ارجع رقم_المقطع
نهاية

دالة تشغيل_مقطع(رقم_المقطع، رقم_القناة)
    إذا (رقم_المقطع < 0 || رقم_المقطع >= مقاطع_عدد[0])
        اطبع_سطر("[Audio] ✗ مقطع غير صالح: " + رقم_المقطع)
        ارجع 0
    نهاية
    إذا (رقم_القناة < 0 || رقم_القناة >= قنوات_عدد[0])
        اطبع_سطر("[Audio] ✗ قناة غير صالحة: " + رقم_القناة)
        ارجع 0
    نهاية

    # ضبط Stream Descriptor
    # SD_FMT ← format based on sample rate + bits
    # SD_CBL ← buffer length
    # SD_LVI ← last valid index
    # SD_CTL ← RUN bit (bit 1)

    قنوات_حالات[رقم_القناة] = AUDIO_PLAYING

    اطبع_سطر("[Audio] ▶ تشغيل: " + مقاطع_أسماء[رقم_المقطع] + " على " + قنوات_أسماء[رقم_القناة])
    اطبع_سطر("  [+] SD_FMT: " + مقاطع_ترددات[رقم_المقطع] + "Hz / " + مقاطع_أنماط[رقم_المقطع] + "bit stereo")
    اطبع_سطر("  [+] SD_CBL: " + مقاطع_أحجام[رقم_المقطع] + " bytes")
    اطبع_سطر("  [+] DMA → Stream " + رقم_القناة + " — SD_CTL.RUN=1")
    ارجع 1
نهاية

دالة إيقاف_قناة(رقم_القناة)
    إذا (رقم_القناة < 0 || رقم_القناة >= قنوات_عدد[0])
        ارجع 0
    نهاية
    قنوات_حالات[رقم_القناة] = AUDIO_STOPPED
    اطبع_سطر("[Audio] ⏹ إيقاف: " + قنوات_أسماء[رقم_القناة])
    ارجع 1
نهاية

# ══════════════════════════════════════════════════════════════
#  § 7 — نظام أولوية الأذان
# ══════════════════════════════════════════════════════════════

# عند وقت الأذان:
#   1. Fade out جميع الأصوات (500ms)
#   2. تشغيل الأذان على قناة الأذان (أولوية 100)
#   3. لا يمكن كتم الأذان
#   4. بعد الانتهاء: Fade in الأصوات السابقة

دالة تشغيل_الأذان(ملف_الأذان)
    اطبع_سطر("")
    اطبع_سطر("[🕌 الأذان] ═══════════════════════════════════")
    اطبع_سطر("  الله أكبر الله أكبر")
    اطبع_سطر("  أشهد أن لا إله إلا الله")
    اطبع_سطر("  أشهد أن محمداً رسول الله")
    اطبع_سطر("  حيّ على الصلاة — حيّ على الفلاح")
    اطبع_سطر("  الله أكبر الله أكبر — لا إله إلا الله")

    # إيقاف جميع القنوات الأخرى (Fade Out)
    متغير قنوات_متوقفة = [0]
    متغير ق = [0]
    بينما (ق[0] < قنوات_عدد[0])
        متغير فهرس = ق[0]
        إذا (قنوات_حالات[فهرس] == AUDIO_PLAYING)
            إذا (قنوات_أولويات[فهرس] < PRIORITY_ADHAN)
                قنوات_حالات[فهرس] = AUDIO_PAUSED
                قنوات_متوقفة[0] = قنوات_متوقفة[0] + 1
            نهاية
        نهاية
        ق[0] = ق[0] + 1
    نهاية
    اطبع_سطر("  [+] Fade Out: " + قنوات_متوقفة[0] + " قنوات أُوقفت مؤقتاً")

    # تشغيل الأذان على القناة ذات الأولوية القصوى
    اطبع_سطر("  [+] تشغيل: " + ملف_الأذان + " — أولوية " + PRIORITY_ADHAN)
    اطبع_سطر("  [+] مستوى الصوت: " + خلاط_أذان[0] + "% (لا يُكتم)")

    اطبع_سطر("[🕌 الأذان] ═══════════════════════════════════")
    ارجع 1
نهاية

# ══════════════════════════════════════════════════════════════
