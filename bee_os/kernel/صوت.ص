# MMIO Registers (offsets)
متغير HDA_GCAP    = 0
متغير HDA_GCTL    = 8
متغير HDA_WAKEEN  = 12
متغير HDA_STATESTS = 14
متغير HDA_INTCTL  = 32
متغير HDA_INTSTS  = 36
متغير HDA_WALCLK  = 48
متغير HDA_CORBLBASE = 64
متغير HDA_CORBUBASE = 68
متغير HDA_CORBWP   = 72
متغير HDA_CORBRP   = 74
متغير HDA_CORBCTL  = 76
متغير HDA_RIRBLBASE = 80
متغير HDA_RIRBUBASE = 84
متغير HDA_RIRBWP   = 88
متغير HDA_RIRBCTL  = 92

# Stream Descriptor Registers (offset from stream base)
متغير SD_CTL   = 0
متغير SD_STS   = 3
متغير SD_LPIB  = 4
متغير SD_CBL   = 8
متغير SD_LVI   = 12
متغير SD_FMT   = 18
متغير SD_BDPL  = 24
متغير SD_BDPU  = 28

# Audio formats (SD_FMT bit fields)
# Bits 15:14 = Stream Type (0=PCM)
# Bits 13:11 = Sample Base Rate (0=48kHz, 1=44.1kHz)
# Bits 10:8  = Sample Base Rate Multiple
# Bits 7:4   = Sample Base Rate Divisor
# Bits 3:1   = Bits Per Sample (000=8, 001=16, 010=20, 011=24, 100=32)
# Bit 0      = Number of Channels - 1

متغير FMT_PCM_48K_16BIT_STEREO = 17
متغير FMT_PCM_44K_16BIT_STEREO = 16401
متغير FMT_PCM_48K_24BIT_STEREO = 21

# حالات التشغيل
متغير AUDIO_STOPPED  = 0
متغير AUDIO_PLAYING  = 1
متغير AUDIO_PAUSED   = 2

# أولويات الصوت
متغير PRIORITY_ADHAN    = 100
متغير PRIORITY_ALERT    = 80
متغير PRIORITY_MEDIA    = 50
متغير PRIORITY_NOTIFY   = 30
متغير PRIORITY_AMBIENT  = 10

