نهاية

# ══════════════════════════════════════════════════════════════
#  § 9 — تقرير حالة النظام الصوتي
# ══════════════════════════════════════════════════════════════

دالة تقرير_الصوت()
    اطبع_سطر("[Audio] ══════ تقرير نظام الصوت ══════")
    اطبع_سطر("  الجهاز: " + صوت_مصنع[0] + " (PCI ID: " + صوت_معرف_جهاز[0] + ")")
    اطبع_سطر("  MMIO: 0xFE030000")
    اطبع_سطر("  Codecs: " + codec_عدد[0])

    متغير ك = [0]
    بينما (ك[0] < codec_عدد[0])
        متغير فهرس = ك[0]
        اطبع_سطر("    [" + فهرس + "] " + codec_أسماء[فهرس])
        ك[0] = ك[0] + 1
    نهاية

    اطبع_سطر("  قنوات الإخراج: " + قنوات_عدد[0])
    متغير ق = [0]
    بينما (ق[0] < قنوات_عدد[0])
        متغير فهرس_ق = ق[0]
        متغير حالة_نص = "⏹ متوقف"
        إذا (قنوات_حالات[فهرس_ق] == AUDIO_PLAYING)
            حالة_نص = "▶ يشتغل"
        نهاية
        إذا (قنوات_حالات[فهرس_ق] == AUDIO_PAUSED)
            حالة_نص = "⏸ مُوقَف"
        نهاية
        اطبع_سطر("    [" + فهرس_ق + "] " + قنوات_أسماء[فهرس_ق] + " — " + حالة_نص + " — " + قنوات_تردد[فهرس_ق] + "Hz/" + قنوات_عينات[فهرس_ق] + "bit — Vol:" + قنوات_مستوى[فهرس_ق] + "%")
        ق[0] = ق[0] + 1
