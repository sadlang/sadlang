ثابت ETH_FILTER_ALL_MULTICAST = 2
ثابت ETH_FILTER_DIRECTED = 4
ثابت ETH_FILTER_BROADCAST = 8
ثابت ETH_FILTER_MULTICAST = 16

# ─── Link state ───
ثابت LINK_DOWN = 0
ثابت LINK_UP = 1

# ─── MTU & buffer ───
