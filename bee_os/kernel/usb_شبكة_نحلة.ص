# ═══════════════════════════════════════════════════════════════════════════════
# تسجيل جهاز CDC
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة cdc_register_device(usb_addr، subclass، ctrl_iface، data_iface، ep_in، ep_out، ep_int)
    متغير idx = cdc_device_count + 0
    إذا (idx >= 4) ارجع 0 - 1 نهاية

    cdc_set_present(idx، 1)

    إذا (idx == 0)
        cdc_addr_0 = usb_addr + 0
        cdc_subclass_0 = subclass + 0
        cdc_ctrl_iface_0 = ctrl_iface + 0
        cdc_data_iface_0 = data_iface + 0
        cdc_ep_in_0 = ep_in + 0
        cdc_ep_out_0 = ep_out + 0
        cdc_ep_int_0 = ep_int + 0
    نهاية
    إذا (idx == 1)
        cdc_addr_1 = usb_addr + 0
        cdc_subclass_1 = subclass + 0
        cdc_ctrl_iface_1 = ctrl_iface + 0
        cdc_data_iface_1 = data_iface + 0
        cdc_ep_in_1 = ep_in + 0
        cdc_ep_out_1 = ep_out + 0
        cdc_ep_int_1 = ep_int + 0
    نهاية
    إذا (idx == 2)
        cdc_addr_2 = usb_addr + 0
        cdc_subclass_2 = subclass + 0
        cdc_ctrl_iface_2 = ctrl_iface + 0
        cdc_data_iface_2 = data_iface + 0
        cdc_ep_in_2 = ep_in + 0
        cdc_ep_out_2 = ep_out + 0
        cdc_ep_int_2 = ep_int + 0
    نهاية
    إذا (idx == 3)
        cdc_addr_3 = usb_addr + 0
        cdc_subclass_3 = subclass + 0
        cdc_ctrl_iface_3 = ctrl_iface + 0
        cdc_data_iface_3 = data_iface + 0
        cdc_ep_in_3 = ep_in + 0
        cdc_ep_out_3 = ep_out + 0
        cdc_ep_int_3 = ep_int + 0
    نهاية

    # تخصيص مخازن RX/TX
    إذا (idx == 0)
        cdc_rx_buf_0 = sad_ll_kmalloc(CDC_MAX_SEGMENT) + 0
        cdc_tx_buf_0 = sad_ll_kmalloc(CDC_MAX_SEGMENT) + 0
        sad_ll_memset(cdc_rx_buf_0، 0، CDC_MAX_SEGMENT)
        sad_ll_memset(cdc_tx_buf_0، 0، CDC_MAX_SEGMENT)
    نهاية
    إذا (idx == 1)
        cdc_rx_buf_1 = sad_ll_kmalloc(CDC_MAX_SEGMENT) + 0
        cdc_tx_buf_1 = sad_ll_kmalloc(CDC_MAX_SEGMENT) + 0
        sad_ll_memset(cdc_rx_buf_1، 0، CDC_MAX_SEGMENT)
        sad_ll_memset(cdc_tx_buf_1، 0، CDC_MAX_SEGMENT)
    نهاية
    إذا (idx == 2)
        cdc_rx_buf_2 = sad_ll_kmalloc(CDC_MAX_SEGMENT) + 0
        cdc_tx_buf_2 = sad_ll_kmalloc(CDC_MAX_SEGMENT) + 0
        sad_ll_memset(cdc_rx_buf_2، 0، CDC_MAX_SEGMENT)
        sad_ll_memset(cdc_tx_buf_2، 0، CDC_MAX_SEGMENT)
    نهاية
    إذا (idx == 3)
        cdc_rx_buf_3 = sad_ll_kmalloc(CDC_MAX_SEGMENT) + 0
        cdc_tx_buf_3 = sad_ll_kmalloc(CDC_MAX_SEGMENT) + 0
        sad_ll_memset(cdc_rx_buf_3، 0، CDC_MAX_SEGMENT)
        sad_ll_memset(cdc_tx_buf_3، 0، CDC_MAX_SEGMENT)
    نهاية

    cdc_serial_اطبع("[CDC] Device ")
    cdc_serial_رقم(idx + 0)
    cdc_serial_اطبع(" registered: USB addr=")
    cdc_serial_رقم(usb_addr + 0)
    cdc_serial_اطبع(" subclass=")
    cdc_serial_رقم(subclass + 0)
    cdc_serial_سطر()

    cdc_device_count = cdc_device_count + 1
    ارجع idx + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تفعيل/إيقاف الجهاز
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة cdc_activate(d)
    إذا (cdc_get_present(d) == 0) ارجع 0 - 1 نهاية
    cdc_set_active(d، 1)
    cdc_set_link(d، LINK_UP)
    cdc_set_speed(d، 100)  # Default 100 Mbps

    cdc_serial_اطبع("[CDC] Dev ")
    cdc_serial_رقم(d + 0)
    cdc_serial_اطبع(" activated, MAC=")
    cdc_print_mac(d)
    cdc_serial_سطر()
    ارجع 0
نهاية

صدّر دالة cdc_deactivate(d)
    cdc_set_active(d، 0)
    cdc_set_link(d، LINK_DOWN)
    cdc_serial_اطبع("[CDC] Dev ")
    cdc_serial_رقم(d + 0)
    cdc_serial_اطبع(" deactivated")
    cdc_serial_سطر()
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إرسال حزمة Ethernet (TX)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة cdc_tx_packet(d، buf، length)
    إذا (cdc_get_active(d) == 0) ارجع 0 - 1 نهاية
    إذا (cdc_get_link(d) == 0) ارجع 0 - 2 نهاية
    إذا (length > ETH_MAX_FRAME)
        cdc_errors = cdc_errors + 1
        ارجع 0 - 3
    نهاية
    إذا (length < 14)
        cdc_errors = cdc_errors + 1
        ارجع 0 - 4
    نهاية

    # نسخ البيانات إلى مخزن TX
    متغير tx_buf = 0 + 0
    إذا (d == 0) tx_buf = cdc_tx_buf_0 + 0 نهاية
    إذا (d == 1) tx_buf = cdc_tx_buf_1 + 0 نهاية
    إذا (d == 2) tx_buf = cdc_tx_buf_2 + 0 نهاية
    إذا (d == 3) tx_buf = cdc_tx_buf_3 + 0 نهاية

    متغير i = 0 + 0
    بينما (i < length)
        متغير b = sad_ll_mem_read8(buf + i) + 0
        sad_ll_mem_write8(tx_buf + i، b)
        i = i + 1
    نهاية

    cdc_tx_packets = cdc_tx_packets + 1
    cdc_tx_bytes = cdc_tx_bytes + length
    ارجع length + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# استقبال حزمة Ethernet (RX)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة cdc_rx_packet(d، buf، max_len)
    إذا (cdc_get_active(d) == 0) ارجع 0 - 1 نهاية
    إذا (cdc_get_link(d) == 0) ارجع 0 نهاية

    # (حقيقياً هذا يقرأ من USB bulk endpoint)
    # نرجع 0 يعني لا توجد حزم
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# بناء Ethernet header
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة cdc_build_eth_header(buf، src_dev، dst_mac_buf، ethertype)
    # Destination MAC (6 bytes)
    متغير i = 0 + 0
    بينما (i < 6)
        متغير b = sad_ll_mem_read8(dst_mac_buf + i) + 0
        sad_ll_mem_write8(buf + i، b)
        i = i + 1
    نهاية

    # Source MAC (6 bytes)
    i = 0
    بينما (i < 6)
        متغير b = cdc_get_mac(src_dev، i) + 0
        sad_ll_mem_write8(buf + 6 + i، b)
        i = i + 1
    نهاية

    # EtherType (big-endian)
    sad_ll_mem_write8(buf + 12، ethertype / 256)
    sad_ll_mem_write8(buf + 13، ethertype % 256)

    ارجع 14
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إيجاد جهاز CDC بالنوع الفرعي
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة cdc_find_by_subclass(subclass)
    متغير d = 0 + 0
    بينما (d < cdc_device_count)
        إذا (cdc_get_present(d) == 1)
            متغير sc = 0 + 0
            إذا (d == 0) sc = cdc_subclass_0 + 0 نهاية
            إذا (d == 1) sc = cdc_subclass_1 + 0 نهاية
            إذا (d == 2) sc = cdc_subclass_2 + 0 نهاية
            إذا (d == 3) sc = cdc_subclass_3 + 0 نهاية
            إذا (sc == subclass) ارجع d + 0 نهاية
        نهاية
        d = d + 1
    نهاية
    ارجع 0 - 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تقرير CDC
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة cdc_تقرير()
    cdc_serial_اطبع("═══ [CDC] تقرير شبكة USB ═══")
    cdc_serial_سطر()

    cdc_serial_اطبع("  أجهزة: ")
    cdc_serial_رقم(cdc_device_count + 0)
    cdc_serial_سطر()

    متغير d = 0 + 0
    بينما (d < cdc_device_count)
        إذا (cdc_get_present(d) == 1)
            cdc_serial_اطبع("  Dev ")
            cdc_serial_رقم(d + 0)
            cdc_serial_اطبع(": MAC=")
            cdc_print_mac(d)
            إذا (cdc_get_link(d) == 1)
                cdc_serial_اطبع(" LINK_UP ")
                cdc_serial_رقم(cdc_get_speed(d) + 0)
                cdc_serial_اطبع("Mbps")
            والا
                cdc_serial_اطبع(" LINK_DOWN")
            نهاية
            cdc_serial_سطر()
        نهاية
        d = d + 1
    نهاية

    cdc_serial_اطبع("  TX: ")
    cdc_serial_رقم(cdc_tx_packets + 0)
    cdc_serial_اطبع(" pkts, ")
    cdc_serial_رقم(cdc_tx_bytes + 0)
    cdc_serial_اطبع(" bytes")
    cdc_serial_سطر()

    cdc_serial_اطبع("  RX: ")
    cdc_serial_رقم(cdc_rx_packets + 0)
    cdc_serial_اطبع(" pkts, ")
    cdc_serial_رقم(cdc_rx_bytes + 0)
    cdc_serial_اطبع(" bytes")
    cdc_serial_سطر()

    cdc_serial_اطبع("  أخطاء: ")
    cdc_serial_رقم(cdc_errors + 0)
    cdc_serial_اطبع(" مسقطة: ")
    cdc_serial_رقم(cdc_dropped + 0)
    cdc_serial_سطر()

    cdc_serial_اطبع("═══════════════════════════════════")
    cdc_serial_سطر()
    ارجع 0
نهاية

