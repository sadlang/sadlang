# ─── دوال خارجية ───
خارجي دالة sad_ll_port_inb(port)
خارجي دالة sad_ll_port_outb(port، val)
خارجي دالة sad_ll_mem_read8(addr)
خارجي دالة sad_ll_mem_write8(addr، val)
خارجي دالة sad_ll_mem_read16(addr)
خارجي دالة sad_ll_mem_write16(addr، val)
خارجي دالة sad_ll_mem_read32(addr)
