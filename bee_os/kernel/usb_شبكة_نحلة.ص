# ═══════════════════════════════════════════════════════════════════════════════
ثابت COM1 = 1016

# ─── CDC Class Codes ───
ثابت CDC_CLASS = 2                    # Communications class
ثابت CDC_DATA_CLASS = 10              # 0x0A — Data Interface class
ثابت CDC_SUBCLASS_ACM = 2             # Abstract Control Model
ثابت CDC_SUBCLASS_ECM = 6             # Ethernet Networking
ثابت CDC_SUBCLASS_NCM = 13            # 0x0D — Network Control Model

# ─── CDC Descriptor subtypes ───
ثابت CDC_DESC_HEADER = 0
ثابت CDC_DESC_CALL_MGMT = 1
ثابت CDC_DESC_ACM = 2
ثابت CDC_DESC_UNION = 6
ثابت CDC_DESC_ETHERNET = 15           # 0x0F — Ethernet Networking

# ─── CDC Requests ───
ثابت CDC_SET_LINE_CODING = 32         # 0x20
ثابت CDC_GET_LINE_CODING = 33         # 0x21
ثابت CDC_SET_CONTROL_LINE = 34        # 0x22
ثابت CDC_SEND_BREAK = 35              # 0x23

# ─── CDC Notifications ───
ثابت CDC_NOTIFY_NETWORK_CONNECTION = 0
ثابت CDC_NOTIFY_SPEED_CHANGE = 42     # 0x2A
ثابت CDC_NOTIFY_SERIAL_STATE = 32     # 0x20

# ─── ECM requests ───
ثابت ECM_SET_ETHERNET_FILTER = 67     # 0x43
ثابت ECM_GET_ETHERNET_STAT = 68       # 0x44

# ─── NCM requests ───
ثابت NCM_GET_NTB_PARAMETERS = 128     # 0x80
ثابت NCM_GET_NTB_INPUT_SIZE = 133     # 0x85
ثابت NCM_SET_NTB_INPUT_SIZE = 134     # 0x86

# ─── Ethernet filter bits ───
