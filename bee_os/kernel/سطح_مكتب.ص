# ==============================================================
# § 5 — نقطة الدخول الرئيسية
# ==============================================================

# شاشة البداية
beeos_splash()

# تهيئة المكوّنات
beeos_تهيئة_المكوّنات()

# عرض سطح المكتب
اطبع_سطر("═══════════ سطح مكتب BeeOS ═══════════")
beeos_ارسم_سطح_مكتب()

# جولة تفاعلية
اطبع_سطر("")
اطبع_سطر("═══════════ جولة تفاعلية ═══════════")

متغير ن1 = beeos_فتح_متصفح_ملفات()
متغير ن2 = beeos_فتح_إعدادات()
متغير ن3 = beeos_فتح_محرر()
متغير ن4 = beeos_فتح_صدفة()
متغير ن5 = beeos_عرض_معلومات_النظام()

# ملخص الجولة
اطبع_سطر("")
إذا (ن1 == 1 && ن2 == 1 && ن3 == 1 && ن4 == 1 && ن5 == 1)
    اطبع_سطر("╔════════════════════════════════════════╗")
    اطبع_سطر("║  ✅ جميع مكوّنات BeeOS تعمل بنجاح!  ║")
    اطبع_سطر("║                                        ║")
    اطبع_سطر("║  🐝 الله أكبر — BeeOS في خدمة الإسلام ║")
    اطبع_سطر("╚════════════════════════════════════════╝")
وإلا
    اطبع_سطر("[خطأ] فشل تشغيل أحد المكوّنات")
