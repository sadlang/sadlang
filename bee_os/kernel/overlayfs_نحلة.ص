# القسم 6: Copy-Up
# ══════════════════════════════════════════════

#* ── Copy-Up: نقل ملف من سفلية إلى علوية ──
   يحدث عند محاولة تعديل ملف موجود في طبقة ro
   1. اقرأ من السفلية
   2. أنشئ نسخة في العلوية
   3. حدّث المؤشر
*#
صدّر دالة ovl_copy_up(فهرس_ملف)
    متغير طبقة = -1
    متغير معرف = 0
    
    إذا (فهرس_ملف == 0) طبقة = ovl_ملف_طبقة_0 نهاية
    إذا (فهرس_ملف == 0) معرف = ovl_ملف_معرف_0 نهاية
    إذا (فهرس_ملف == 1) طبقة = ovl_ملف_طبقة_1 نهاية
    إذا (فهرس_ملف == 1) معرف = ovl_ملف_معرف_1 نهاية
    إذا (فهرس_ملف == 2) طبقة = ovl_ملف_طبقة_2 نهاية
    إذا (فهرس_ملف == 2) معرف = ovl_ملف_معرف_2 نهاية
    إذا (فهرس_ملف == 3) طبقة = ovl_ملف_طبقة_3 نهاية
    إذا (فهرس_ملف == 3) معرف = ovl_ملف_معرف_3 نهاية
    
    # إذا بالفعل في العلوية، لا حاجة لـ copy-up
    إذا (طبقة == 0)
        ارجع 0
    نهاية
    
    # محاكاة copy-up: نغير الطبقة إلى 0 (العلوية)
    إذا (فهرس_ملف == 0) ovl_ملف_طبقة_0 = 0 نهاية
    إذا (فهرس_ملف == 1) ovl_ملف_طبقة_1 = 0 نهاية
    إذا (فهرس_ملف == 2) ovl_ملف_طبقة_2 = 0 نهاية
    إذا (فهرس_ملف == 3) ovl_ملف_طبقة_3 = 0 نهاية
    
    ovl_عمليات_copy_up = ovl_عمليات_copy_up + 1
    
    kernel_print_string("    overlayfs: copy-up file ")
    kernel_print_number(معرف)
    kernel_print_string(" from layer ")
    kernel_print_number(طبقة)
    kernel_print_string(" to upper")
    kernel_print_number(10)
    
    ارجع 1
نهاية

