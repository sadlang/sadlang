#* ── تشفير قيصر ──
   إزاحة كل بايت بقيمة الإزاحة
*#
صدّر دالة تشفير_قيصر(مصدر، مقاس_م، وجهة، إزاحة)
    متغير ع = 0
    بينما (ع < مقاس_م)
        متغير بايت_م = mem_read_byte(مصدر + ع)
        متغير بايت_مشفر = بايت_م + إزاحة
        # التفاف حول 256
        إذا (بايت_مشفر >= 256)
            بايت_مشفر = بايت_مشفر - 256
        نهاية
        إذا (بايت_مشفر < 0)
            بايت_مشفر = بايت_مشفر + 256
        نهاية
        mem_write_byte(وجهة + ع، بايت_مشفر)
        ع = ع + 1
    نهاية
    
    تشفير_عمليات = تشفير_عمليات + 1
    تشفير_بايتات = تشفير_بايتات + مقاس_م
    ارجع مقاس_م
نهاية

