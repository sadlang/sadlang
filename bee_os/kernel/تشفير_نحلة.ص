#* ── تشفير XOR مع مفتاح متعدد البايتات ── *#
صدّر دالة تشفير_xor(مصدر، مقاس_م، وجهة)
    إذا (طول_مفتاح == 0)
        kernel_print_string("  [crypto] ERROR: no key loaded")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    متغير ع = 0
    بينما (ع < مقاس_م)
        متغير بايت_م = mem_read_byte(مصدر + ع)
        متغير فهرس_م = ع - ((ع / طول_مفتاح) * طول_مفتاح)
        متغير بايت_مفتاح = تشفير_مفتاح_بايت(فهرس_م)
        متغير بايت_مشفر = تشفير_xor_بايت(بايت_م، بايت_مفتاح)
        mem_write_byte(وجهة + ع، بايت_مشفر)
        ع = ع + 1
    نهاية
    
    تشفير_عمليات = تشفير_عمليات + 1
    تشفير_بايتات = تشفير_بايتات + مقاس_م
    ارجع مقاس_م
