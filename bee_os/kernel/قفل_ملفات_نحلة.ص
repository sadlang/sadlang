# القسم 3: فحص التعارض
# ══════════════════════════════════════════════

#* ── هل يتداخل نطاقان؟ ──
   [b1..n1] متداخل مع [b2..n2] إذا b1 < n2 وَ b2 < n1
*#
دالة نطاقات_متداخلة(ب1، ن1، ب2، ن2)
    إذا (ب1 < ن2)
        إذا (ب2 < ن1)
            ارجع 1
        نهاية
    نهاية
    ارجع 0
نهاية

#* ── فحص تعارض قفل ──
   يرجع 0 إذا لا تعارض، 1 إذا تعارض
*#
صدّر دالة قفل_فحص_تعارض(عقدة، عملية، بداية_طلب، نها_طلب، صنف_طلب)
    متغير ع = 0
    بينما (ع < 8)
        متغير فعال = اقرأ_قفل(ع، 6)
        إذا (فعال == 1)
            متغير عقدة_ق = اقرأ_قفل(ع، 0)
            إذا (عقدة_ق == عقدة)
                متغير عملية_ق = اقرأ_قفل(ع، 1)
                # نفس العملية لا تتعارض مع نفسها
                إذا (عملية_ق != عملية)
                    متغير صنف_ق = اقرأ_قفل(ع، 2)
                    متغير بداية_ق = اقرأ_قفل(ع، 4)
                    متغير نها_ق = اقرأ_قفل(ع، 5)
                    
                    متغير تداخل = نطاقات_متداخلة(بداية_طلب، نها_طلب، بداية_ق، نها_ق)
                    إذا (تداخل == 1)
                        # مشترك + مشترك = لا تعارض
                        إذا (صنف_طلب == قفل_حصري)
                            ارجع 1
                        نهاية
                        إذا (صنف_ق == قفل_حصري)
                            ارجع 1
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
        ع = ع + 1
    نهاية
    ارجع 0
نهاية

