        إذا (فعال == 1)
            متغير عملية_ق = اقرأ_قفل(ع، 1)
            إذا (عملية_ق == عملية)
                قفل_حرر(ع)
                محررة = محررة + 1
            نهاية
        نهاية
        ع = ع + 1
    نهاية
