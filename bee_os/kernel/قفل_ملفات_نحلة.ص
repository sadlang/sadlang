#* ── إنشاء قفل جديد ── *#
صدّر دالة قفل_اقفل(عقدة، عملية، بداية_نطاق، نها_نطاق، صنف_ق، وضع_ق)
    عدد_طلبات_القفل = عدد_طلبات_القفل + 1
    
    # فحص التعارض
    متغير تعارض = قفل_فحص_تعارض(عقدة، عملية، بداية_نطاق، نها_نطاق، صنف_ق)
    إذا (تعارض == 1)
        عدد_الرفض = عدد_الرفض + 1
        ارجع -1
    نهاية
    
    # ابحث عن خانة حرة
    متغير ع = 0
    بينما (ع < 8)
        متغير فعال = اقرأ_قفل(ع، 6)
        إذا (فعال == 0)
            اكتب_قفل(ع، 0، عقدة)
            اكتب_قفل(ع، 1، عملية)
            اكتب_قفل(ع، 2، صنف_ق)
            اكتب_قفل(ع، 3، وضع_ق)
            اكتب_قفل(ع، 4، بداية_نطاق)
            اكتب_قفل(ع، 5، نها_نطاق)
            اكتب_قفل(ع، 6، 1)
            عدد_الأقفال_النشطة = عدد_الأقفال_النشطة + 1
            ارجع ع
        نهاية
        ع = ع + 1
    نهاية
    
    # جدول ممتلئ
    عدد_الرفض = عدد_الرفض + 1
    ارجع -2
نهاية

#* ── تحرير قفل ── *#
صدّر دالة قفل_حرر(فهرس_قفل)
    إذا (فهرس_قفل < 0) ارجع -1 نهاية
    إذا (فهرس_قفل >= 8) ارجع -1 نهاية
    
    متغير فعال = اقرأ_قفل(فهرس_قفل، 6)
    إذا (فعال == 0)
        ارجع -1
    نهاية
    
    اكتب_قفل(فهرس_قفل، 0، 0)
    اكتب_قفل(فهرس_قفل، 1، 0)
    اكتب_قفل(فهرس_قفل، 2، 0)
    اكتب_قفل(فهرس_قفل، 3، 0)
    اكتب_قفل(فهرس_قفل، 4، 0)
    اكتب_قفل(فهرس_قفل، 5، 0)
    اكتب_قفل(فهرس_قفل، 6، 0)
    
    عدد_الأقفال_النشطة = عدد_الأقفال_النشطة - 1
    عدد_التحرير = عدد_التحرير + 1
    ارجع 0
