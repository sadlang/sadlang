# الثوابت
# ──────────────────────────────────────────────
ثابت fat32_نهاية_سلسلة = 268435455    # 0x0FFFFFFF
ثابت fat32_كتلة_حرة = 0               # مدخل FAT = 0 يعني كتلة حرة
ثابت fat32_مدخل_محذوف = 229           # 0xE5
ثابت fat32_مقاس_مدخل = 32             # بايت لكل مدخل دليل
ثابت fat32_صفة_قراءة_فقط = 1          # 0x01
ثابت fat32_صفة_مخفي = 2               # 0x02
ثابت fat32_صفة_نظام = 4               # 0x04
ثابت fat32_صفة_تسمية = 8              # 0x08
ثابت fat32_صفة_دليل = 16              # 0x10
ثابت fat32_صفة_أرشيف = 32             # 0x20

# ══════════════════════════════════════════════
# القسم 1: معلومات القسم المخزنة
# ══════════════════════════════════════════════

#* ── نحتاج بيانات من وحدة FAT32 الأساسية ──
   نخزن نسخة محلية للوصول السريع
*#

# قسم 0
متغير كتب_قرص_0 = 0                  # رقم القرص
متغير كتب_قطاع_أول_0 = 0             # أول قطاع في القسم
متغير كتب_قطاعات_لكل_كتلة_0 = 8     # (4KB clusters default)
متغير كتب_fat_بداية_0 = 0            # أول قطاع FAT
متغير كتب_fat_عدد_0 = 0              # عدد جداول FAT
متغير كتب_بيانات_بداية_0 = 0         # أول قطاع بيانات
متغير كتب_جذر_كتلة_0 = 2            # كتلة الجذر (عادة 2)
متغير كتب_مجموع_كتل_0 = 0           # إجمالي الكتل
متغير كتب_كتل_حرة_0 = 0             # عدد الكتل الحرة
متغير كتب_مهيأ_0 = 0

# قسم 1
متغير كتب_قرص_1 = 0
متغير كتب_قطاع_أول_1 = 0
متغير كتب_قطاعات_لكل_كتلة_1 = 8
متغير كتب_fat_بداية_1 = 0
متغير كتب_fat_عدد_1 = 0
متغير كتب_بيانات_بداية_1 = 0
متغير كتب_جذر_كتلة_1 = 2
متغير كتب_مجموع_كتل_1 = 0
متغير كتب_كتل_حرة_1 = 0
متغير كتب_مهيأ_1 = 0

# إحصائيات الكتابة
متغير كتب_ملفات_أنشئت = 0
متغير كتب_أدلة_أنشئت = 0
متغير كتب_ملفات_حذفت = 0
متغير كتب_كتل_خصصت = 0
متغير كتب_كتل_حررت = 0
متغير كتب_بايتات_كتبت = 0
متغير كتب_عمليات_sync = 0

# ══════════════════════════════════════════════
# القسم 2: تهيئة الكتابة
# ══════════════════════════════════════════════

#* ── تهيئة وحدة الكتابة ──
   يجب تمرير بيانات القسم من وحدة FAT32 الأساسية
*#
صدّر دالة fat32_كتابة_هيئ(فهرس، قرص، قطاع_أول، قطاعات_لكل_كتلة، fat_بداية، بيانات_بداية، جذر_كتلة، مجموع_كتل)
    إذا (فهرس == 0)
        كتب_قرص_0 = قرص
        كتب_قطاع_أول_0 = قطاع_أول
        كتب_قطاعات_لكل_كتلة_0 = قطاعات_لكل_كتلة
        كتب_fat_بداية_0 = fat_بداية
        كتب_بيانات_بداية_0 = بيانات_بداية
        كتب_جذر_كتلة_0 = جذر_كتلة
        كتب_مجموع_كتل_0 = مجموع_كتل
        كتب_مهيأ_0 = 1
    نهاية
    إذا (فهرس == 1)
        كتب_قرص_1 = قرص
        كتب_قطاع_أول_1 = قطاع_أول
        كتب_قطاعات_لكل_كتلة_1 = قطاعات_لكل_كتلة
        كتب_fat_بداية_1 = fat_بداية
        كتب_بيانات_بداية_1 = بيانات_بداية
        كتب_جذر_كتلة_1 = جذر_كتلة
        كتب_مجموع_كتل_1 = مجموع_كتل
        كتب_مهيأ_1 = 1
    نهاية
    
    kernel_print_string("    fat32_write: partition ")
    kernel_print_number(فهرس)
    kernel_print_string(" ready (total clusters=")
    kernel_print_number(مجموع_كتل)
    kernel_print_string(")")
    kernel_print_number(10)
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# القسم 3: تحويل كتلة ← قطاع
# ══════════════════════════════════════════════

دالة كتب_كتلة_إلى_قطاع(فهرس، كتلة)
    متغير بداية = 0
    متغير قطاعات_ك = 8
    متغير قطاع_أول = 0
    
    إذا (فهرس == 0)
        بداية = كتب_بيانات_بداية_0
        قطاعات_ك = كتب_قطاعات_لكل_كتلة_0
        قطاع_أول = كتب_قطاع_أول_0
    نهاية
    إذا (فهرس == 1)
        بداية = كتب_بيانات_بداية_1
        قطاعات_ك = كتب_قطاعات_لكل_كتلة_1
        قطاع_أول = كتب_قطاع_أول_1
    نهاية
    
    متغير قطاع = قطاع_أول + بداية + (كتلة - 2) * قطاعات_ك
    ارجع قطاع
نهاية

# ══════════════════════════════════════════════
# القسم 4: قراءة/كتابة FAT
# ══════════════════════════════════════════════

#* ── قراءة مدخل FAT لكتلة معينة ── *#
صدّر دالة كتب_اقرأ_fat(فهرس، كتلة)
    متغير fat_بداية = 0
    متغير قرص = 0
    متغير قطاع_أول = 0
    
    إذا (فهرس == 0)
        fat_بداية = كتب_fat_بداية_0
        قرص = كتب_قرص_0
        قطاع_أول = كتب_قطاع_أول_0
    نهاية
    إذا (فهرس == 1)
        fat_بداية = كتب_fat_بداية_1
        قرص = كتب_قرص_1
        قطاع_أول = كتب_قطاع_أول_1
    نهاية
    
    # كل قطاع يحتوي 128 مدخل FAT (512/4)
    متغير قطاع_fat = قطاع_أول + fat_بداية + (كتلة / 128)
    متغير إزاحة = (كتلة - ((كتلة / 128) * 128)) * 4
    
    متغير مخزن = kernel_allocate(512)
    إذا (مخزن == 0)
        ارجع -1
    نهاية
    
    disk_read_sector(قرص، قطاع_fat، مخزن)
    متغير قيمة = mem_read_dword(مخزن + إزاحة)
    kernel_free(مخزن)
    
    # تطبيق القناع (28 بت)
    # 0x0FFFFFFF = 268435455
    # لا نملك bitwise AND، لذلك نقسم ونضرب
    # القناع: أعلى 4 بتات تُهمَل
    # value & 0x0FFFFFFF = value - (value / 268435456) * 268435456
    متغير أعلى = قيمة / 268435456
    متغير مقنّع = قيمة - (أعلى * 268435456)
    
    ارجع مقنّع
نهاية

#* ── البحث عن كتلة حرة في FAT ── *#
صدّر دالة كتب_ابحث_كتلة_حرة(فهرس)
    متغير مجموع = 0
    إذا (فهرس == 0) مجموع = كتب_مجموع_كتل_0 نهاية
    إذا (فهرس == 1) مجموع = كتب_مجموع_كتل_1 نهاية
    
    # نبحث من الكتلة 2 (أول كتلة بيانات في FAT32)
    متغير ك = 2
    بينما (ك < مجموع)
        إذا (ك >= 65536) اخرج نهاية  # حد عملي
        
        متغير قيمة = كتب_اقرأ_fat(فهرس، ك)
        إذا (قيمة == 0)
            ارجع ك
        نهاية
        ك = ك + 1
    نهاية
    
    kernel_print_string("  [fat32_w] ERROR: disk full!")
    kernel_print_number(10)
    ارجع -1
نهاية

# ══════════════════════════════════════════════
# القسم 5: البحث عن مدخل فارغ في دليل
# ══════════════════════════════════════════════

#* ── البحث عن مدخل فارغ في كتلة دليل ──
   مدخل فارغ: بايت 0 = 0x00 (غير مستخدم) أو 0xE5 (محذوف)
   يرجع إزاحة المدخل داخل المخزن، أو -1
*#
صدّر دالة كتب_ابحث_مدخل_فارغ(عنوان_مخزن، مقاس_كتلة)
    متغير إزاحة = 0
    بينما (إزاحة < مقاس_كتلة)
        متغير بايت_أول = mem_read_byte(عنوان_مخزن + إزاحة)
        
        # مدخل فارغ 0x00 أو محذوف 0xE5
        إذا (بايت_أول == 0)
            ارجع إزاحة
        نهاية
        إذا (بايت_أول == fat32_مدخل_محذوف)
            ارجع إزاحة
        نهاية
        
        إزاحة = إزاحة + fat32_مقاس_مدخل
    نهاية
    ارجع -1
نهاية

# ══════════════════════════════════════════════
# القسم 6: كتابة مدخل دليل
# ══════════════════════════════════════════════

#* ── كتابة مدخل دليل 8.3 ──
   يكتب 32 بايت في عنوان_هدف
   الاسم: 8 بايت (مبطن بمسافات)
   الامتداد: 3 بايت (مبطن بمسافات)
   هنا نستخدم اسم بسيط (حرف واحد + رقم)
*#
صدّر دالة كتب_اكتب_مدخل(عنوان_هدف، حرف_اسم، رقم_اسم، صفة، كتلة_أولى، مقاس_ملف)
    # الاسم: حرف + رقم + مسافات
    mem_write_byte(عنوان_هدف، حرف_اسم)       # حرف أول
    
    # تحويل الرقم إلى أرقام ASCII
    متغير عشرات = رقم_اسم / 10
    متغير آحاد = رقم_اسم - (عشرات * 10)
    mem_write_byte(عنوان_هدف + 1، 48 + عشرات)
    mem_write_byte(عنوان_هدف + 2، 48 + آحاد)
    
    # باقي الاسم: مسافات (0x20 = 32)
    mem_write_byte(عنوان_هدف + 3، 32)
    mem_write_byte(عنوان_هدف + 4، 32)
    mem_write_byte(عنوان_هدف + 5، 32)
    mem_write_byte(عنوان_هدف + 6، 32)
    mem_write_byte(عنوان_هدف + 7، 32)
    
    # الامتداد: "   " (3 مسافات) أو "TXT" إذا ملف عادي
    إذا (صفة == fat32_صفة_دليل)
        mem_write_byte(عنوان_هدف + 8، 32)
        mem_write_byte(عنوان_هدف + 9، 32)
        mem_write_byte(عنوان_هدف + 10، 32)
    وإلا
        # TXT = 84, 88, 84
        mem_write_byte(عنوان_هدف + 8، 84)
        mem_write_byte(عنوان_هدف + 9، 88)
        mem_write_byte(عنوان_هدف + 10، 84)
    نهاية
    
    # صفات الملف
    mem_write_byte(عنوان_هدف + 11، صفة)
    
    # بايتات 12-19: محجوزة/وقت (نضع أصفار)
    متغير ع = 12
    بينما (ع < 20)
        mem_write_byte(عنوان_هدف + ع، 0)
        ع = ع + 1
    نهاية
    
    # الكتلة العليا (بايت 20-21): أعلى 16 بت من رقم الكتلة
    متغير كتلة_علوية = كتلة_أولى / 65536
    متغير كتلة_سفلية = كتلة_أولى - (كتلة_علوية * 65536)
    
    mem_write_byte(عنوان_هدف + 20، كتلة_علوية - ((كتلة_علوية / 256) * 256))
    mem_write_byte(عنوان_هدف + 21، كتلة_علوية / 256)
    
    # بايتات 22-25: وقت التعديل (أصفار)
    mem_write_byte(عنوان_هدف + 22، 0)
    mem_write_byte(عنوان_هدف + 23، 0)
    mem_write_byte(عنوان_هدف + 24، 0)
    mem_write_byte(عنوان_هدف + 25، 0)
    
    # الكتلة السفلى (بايت 26-27)
    mem_write_byte(عنوان_هدف + 26، كتلة_سفلية - ((كتلة_سفلية / 256) * 256))
    mem_write_byte(عنوان_هدف + 27، كتلة_سفلية / 256)
    
    # حجم الملف (بايت 28-31) — little-endian 32-bit
    متغير ب0 = مقاس_ملف - ((مقاس_ملف / 256) * 256)
    متغير باقي1 = مقاس_ملف / 256
    متغير ب1 = باقي1 - ((باقي1 / 256) * 256)
    متغير باقي2 = باقي1 / 256
    متغير ب2 = باقي2 - ((باقي2 / 256) * 256)
    متغير ب3 = باقي2 / 256
    
    mem_write_byte(عنوان_هدف + 28، ب0)
    mem_write_byte(عنوان_هدف + 29، ب1)
    mem_write_byte(عنوان_هدف + 30، ب2)
    mem_write_byte(عنوان_هدف + 31، ب3)
    
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# القسم 7: كتابة بيانات إلى كتلة
# ══════════════════════════════════════════════

#* ── كتابة بيانات نمطية إلى كتلة ──
   يملأ أول N بايت بقيمة معينة
   (محاكاة كتابة ملف — القرص read-only في QEMU الحالي)
*#
صدّر دالة كتب_املأ_كتلة(فهرس، كتلة، قيمة، عدد_بايتات)
    متغير قطاع = كتب_كتلة_إلى_قطاع(فهرس، كتلة)
    
    # نقرأ القطاع الأول من الكتلة
    متغير قرص = 0
    إذا (فهرس == 0) قرص = كتب_قرص_0 نهاية
    إذا (فهرس == 1) قرص = كتب_قرص_1 نهاية
    
    متغير مخزن = kernel_allocate(512)
    إذا (مخزن == 0) ارجع -1 نهاية
    
    disk_read_sector(قرص، قطاع، مخزن)
    
    # نكتب البيانات
    متغير ع = 0
    متغير حد = عدد_بايتات
    إذا (حد > 512) حد = 512 نهاية
    
    بينما (ع < حد)
        mem_write_byte(مخزن + ع، قيمة)
        ع = ع + 1
    نهاية
    
    كتب_بايتات_كتبت = كتب_بايتات_كتبت + حد
    
    # ملاحظة: في بيئة QEMU الحالية، القرص read-only
    # لكن المخزن في الذاكرة يحتوي البيانات الصحيحة
    # disk_write_sector(قرص، قطاع، مخزن) — عندما يتوفر
    
    kernel_free(مخزن)
    ارجع حد
نهاية

# ══════════════════════════════════════════════
# القسم 8: إنشاء ملف (محاكاة)
# ══════════════════════════════════════════════

#* ── إنشاء ملف جديد في الدليل الجذر ──
   يحاكي عملية الإنشاء الكاملة:
   1. يبحث عن كتلة حرة
   2. يبحث عن مدخل فارغ
   3. يكتب المدخل
   يرجع رقم الكتلة المخصصة أو -1
*#
صدّر دالة كتب_أنشئ_ملف(فهرس، حرف_اسم، رقم_اسم، مقاس_ملف)
    # البحث عن كتلة حرة
    متغير كتلة = كتب_ابحث_كتلة_حرة(فهرس)
    إذا (كتلة < 0)
        kernel_print_string("  [fat32_w] Cannot create: no free clusters")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    kernel_print_string("  [fat32_w] Creating file: allocated cluster ")
    kernel_print_number(كتلة)
    kernel_print_number(10)
    
    كتب_كتل_خصصت = كتب_كتل_خصصت + 1
    كتب_ملفات_أنشئت = كتب_ملفات_أنشئت + 1
    
    ارجع كتلة
نهاية

#* ── إنشاء دليل فرعي ── *#
صدّر دالة كتب_أنشئ_دليل(فهرس، حرف_اسم، رقم_اسم)
    متغير كتلة = كتب_ابحث_كتلة_حرة(فهرس)
    إذا (كتلة < 0) ارجع -1 نهاية
    
    kernel_print_string("  [fat32_w] Creating directory: cluster ")
    kernel_print_number(كتلة)
    kernel_print_number(10)
    
    كتب_كتل_خصصت = كتب_كتل_خصصت + 1
    كتب_أدلة_أنشئت = كتب_أدلة_أنشئت + 1
    
    ارجع كتلة
نهاية

# ══════════════════════════════════════════════
# القسم 9: حذف ملف (محاكاة)
# ══════════════════════════════════════════════

#* ── حذف ملف وتحرير سلسلة FAT ── *#
صدّر دالة كتب_احذف_ملف(فهرس، كتلة_بداية)
    # تتبع السلسلة وعد الكتل
    متغير كتلة = كتلة_بداية
    متغير كتل_محررة = 0
    
    بينما (كتلة > 0)
