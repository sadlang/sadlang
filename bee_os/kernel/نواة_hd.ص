# ═══════════════════════════════════════════════════════════════════
#  § 4 — اكتشاف وتهيئة USB
# ═══════════════════════════════════════════════════════════════════
#
# USB Controllers (PCI Class=0x0C, Sub=0x03):
#   - Prog IF 0x00 = UHCI (USB 1.x, Intel) — Base Address via BAR4
#   - Prog IF 0x10 = OHCI (USB 1.x, Others)
#   - Prog IF 0x20 = EHCI (USB 2.0) — MMIO via BAR0
#   - Prog IF 0x30 = xHCI (USB 3.x) — MMIO via BAR0
#
# xHCI Initialization (USB 3.0):
#   1. قراءة BAR0 → عنوان MMIO الأساسي
#   2. قراءة HCSPARAMS1 → عدد المنافذ + Slots
#   3. تخصيص DCBAA (Device Context Base Address Array)
#   4. تخصيص Command Ring (TRB ring, 256 entries)
#   5. تخصيص Event Ring + ERST (Event Ring Segment Table)
#   6. كتابة DCBAAP + CRCR → xHCI Operational Registers
#   7. Set Run/Stop bit في USBCMD → controller starts
#
# USB Device Enumeration:
#   1. Port Status Change Event → new device
#   2. Address Device Command (TRB)
#   3. GET_DESCRIPTOR(Device) → VendorID, ProductID, Class
#   4. Set Configuration
#   5. لأجهزة HID: GET_REPORT_DESCRIPTOR → تحليل الحقول
#
# USB HID (Human Interface Device):
#   - Class 0x03, Protocol 1 = Keyboard, Protocol 2 = Mouse
#   - Interrupt Endpoint: بيانات دورية كل 10ms
#   - Boot Protocol: Format ثابت (8 bytes for KB, 3 bytes for Mouse)

دالة kernel_تهيئة_usb()
    اطبع_سطر("[Boot] ══════════════ اكتشاف وتهيئة USB ══════════════")
    اطبع_سطر("")

    # --- PCI Scan ---
    اطبع_سطر("[USB] PCI Bus Scan — Class 0x0C Sub 0x03...")
    اطبع_سطر("  [PCI 0:20.0] Intel xHCI (8086:A12F) — USB 3.0")
