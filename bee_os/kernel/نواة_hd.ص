    اطبع_سطر("    [+] BAR0: 0xFE800000 (MMIO, 64KB)")
    اطبع_سطر("    [+] IRQ: MSI-X vector 0")
    اطبع_سطر("")
    اطبع_سطر("  [PCI 0:26.0] Intel EHCI (8086:A12D) — USB 2.0")
    اطبع_سطر("    [+] Prog IF: 0x20 (EHCI)")
    اطبع_سطر("    [+] BAR0: 0xFE810000 (MMIO, 1KB)")
    اطبع_سطر("    [+] IRQ: IRQ23 (PCI)")
    اطبع_سطر("")

    # --- xHCI Init ---
    اطبع_سطر("[xHCI] تهيئة متحكم USB 3.0...")
    اطبع_سطر("  [+] قراءة HCSPARAMS1: MaxSlots=64, MaxPorts=8")
    اطبع_سطر("  [+] تخصيص DCBAA: 64 slots × 8 bytes = 512 bytes")
    اطبع_سطر("  [+] تخصيص Command Ring: 256 TRBs × 16 bytes = 4KB")
    اطبع_سطر("  [+] تخصيص Event Ring: 256 TRBs × 16 bytes = 4KB")
    اطبع_سطر("  [+] ERST: 1 segment → Event Ring base")
    اطبع_سطر("  [+] DCBAAP ← 0x200000 | CRCR ← 0x201000")
