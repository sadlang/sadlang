    # --- USB Devices ---
    اطبع_سطر("[USB] تعداد الأجهزة المتصلة...")
    اطبع_سطر("  [USB:0] BeeOS USB Mouse — HID Protocol 2")
    اطبع_سطر("    [+] GET_DESCRIPTOR: Class=0x03 SubClass=0x01 Protocol=0x02")
    اطبع_سطر("    [+] Endpoint: IN Interrupt, Interval=10ms, MaxPacket=8")
    اطبع_سطر("    [+] Boot Protocol: 3 bytes [Buttons][dX][dY]")
    اطبع_سطر("")
    اطبع_سطر("  [USB:1] BeeOS USB Keyboard — HID Protocol 1")
    اطبع_سطر("    [+] GET_DESCRIPTOR: Class=0x03 SubClass=0x01 Protocol=0x01")
    اطبع_سطر("    [+] Endpoint: IN Interrupt, Interval=10ms, MaxPacket=8")
    اطبع_سطر("    [+] Boot Protocol: 8 bytes [Modifiers][Reserved][Key1..Key6]")
    اطبع_سطر("")
    اطبع_سطر("  [USB:2] SanDisk Ultra 32GB — Mass Storage")
    اطبع_سطر("    [+] GET_DESCRIPTOR: Class=0x08 SubClass=0x06 Protocol=0x50")
    اطبع_سطر("    [+] Bulk-Only Transport (BOT)")
    اطبع_سطر("    [+] SCSI: INQUIRY → SanDisk Ultra 32GB")
    اطبع_سطر("    [+] READ_CAPACITY: 60,062,500 sectors × 512 = 28.6 GB")
