# ═══════════════════════════════════════════════════════════════════════════════
# فحص دعم SMEP عبر CPUID
# ═══════════════════════════════════════════════════════════════════════════════

#** فحص هل المعالج يدعم SMEP
#   CPUID EAX=7, ECX=0 → EBX بت 7
#   نستخدم sad_ll_cpuid_eax مع ورقة 7 كتقريب
#   في الواقع نحتاج EBX لكن نستخدم EDX كمحاكاة
**#
دالة فحص_دعم_smep()
    kernel_print_string("[حماية النواة] فحص دعم SMEP...\n")

    # استخدام CPUID ورقة 7 — في المحاكاة نفحص EDX
    متغير ميزات = sad_ll_cpuid_edx(ورقة_ميزات_موسعة)

    # فحص بت 7 لـ SMEP (في المحاكاة)
    متغير فحص = ميزات & بت_CPUID_SMEP
    إذا (فحص != 0)
        kernel_print_string("  SMEP مدعوم في المعالج\n")
        smep_مدعوم = 1
        ارجع 1
    وإلا
        kernel_print_string("  SMEP غير مدعوم — المعالج لا يدعم هذه الميزة\n")
        smep_مدعوم = 0
        ارجع 0
    نهاية
نهاية

