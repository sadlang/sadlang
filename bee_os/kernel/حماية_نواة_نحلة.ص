# ═══════════════════════════════════════════════════════════════════════════════
# فحص دعم NX/XD عبر CPUID
# ═══════════════════════════════════════════════════════════════════════════════

#** فحص هل المعالج يدعم NX (No-Execute) / XD (Execute Disable)
#   CPUID EAX=0x80000001 → EDX بت 20
#   يتطلب أيضاً تفعيل PAE في CR4
**#
دالة فحص_دعم_nx()
    kernel_print_string("[حماية النواة] فحص دعم NX/XD...\n")

    # CPUID ورقة 0x80000001
    متغير ميزات = sad_ll_cpuid_edx(ورقة_ميزات_ممتدة)

    # فحص بت 20 لـ NX
    متغير فحص = ميزات & بت_CPUID_NX
    إذا (فحص != 0)
        kernel_print_string("  NX/XD مدعوم في المعالج\n")
        nx_مدعوم = 1
    وإلا
        kernel_print_string("  NX/XD غير مدعوم — لا يمكن تحديد صفحات كغير قابلة للتنفيذ\n")
        nx_مدعوم = 0
    نهاية

    # فحص هل PAE مفعل (مطلوب لـ NX في وضع 32-بت)
    متغير cr4 = sad_ll_read_cr4()
    متغير فحص_pae = cr4 & بت_CR4_PAE
    إذا (فحص_pae == 0)
        kernel_print_string("  تحذير: PAE غير مفعل — NX يتطلب PAE\n")
    وإلا
        kernel_print_string("  PAE مفعل — يمكن استخدام NX\n")
    نهاية

    ارجع nx_مدعوم
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تفعيل SMEP في CR4
# ═══════════════════════════════════════════════════════════════════════════════

#** تفعيل SMEP عبر ضبط بت 20 في سجل CR4
#   هذا يمنع النواة من تنفيذ تعليمات في صفحات المستخدم
#   أي محاولة تنفيذ صفحة مستخدم ستسبب #PF (Page Fault)
**#
دالة تفعيل_smep()
    إذا (smep_مدعوم == 0)
        kernel_print_string("[حماية النواة] لا يمكن تفعيل SMEP — غير مدعوم\n")
        ارجع -1
    نهاية

    إذا (smep_مفعل == 1)
        kernel_print_string("[حماية النواة] SMEP مفعل مسبقاً\n")
        ارجع 0
    نهاية

    kernel_print_string("[حماية النواة] تفعيل SMEP في CR4...\n")

    # قراءة CR4 الحالي
    متغير cr4 = sad_ll_read_cr4()
