# إعداد حماية كود النواة (Read-Only)
# ═══════════════════════════════════════════════════════════════════════════════

#** جعل منطقة كود النواة (.text) للقراءة فقط
#   يمنع تعديل كود النواة أثناء التشغيل
#   يحمي من هجمات تعديل الكود
**#
دالة حماية_كود_نواة(عنوان_cr3)
    kernel_print_string("[حماية النواة] حماية كود النواة — قراءة فقط...\n")

    متغير عنوان_حالي = عنوان_بداية_كود_نواة
    متغير صفحات = 0

    بينما (عنوان_حالي < عنوان_نهاية_كود_نواة)
        # حساب مكان PTE
        متغير فهرس_دليل = عنوان_حالي >> 22
        متغير فهرس_جدول = (عنوان_حالي >> 12) & 1023

        متغير pde = mem_read_dword(عنوان_cr3 + (فهرس_دليل * 4))
        متغير فحص_حاضرة = pde & بت_صفحة_حاضرة
        إذا (فحص_حاضرة != 0)
            متغير عنوان_جدول = pde & قناع_عنوان_PTE
            متغير عنوان_pte = عنوان_جدول + (فهرس_جدول * 4)
            متغير pte = mem_read_dword(عنوان_pte)

            # إزالة بت الكتابة
            متغير قناع_لا_كتابة = ~بت_صفحة_كتابة
            متغير pte_محدث = pte & قناع_لا_كتابة
            mem_write_dword(عنوان_pte، pte_محدث)

            sad_ll_invlpg(عنوان_حالي)
            صفحات = صفحات + 1
        نهاية

        عنوان_حالي = عنوان_حالي + ثابت_مقاس_صفحة
    نهاية

    # تسجيل كمنطقة حماية
    تسجيل_منطقة_حماية(عنوان_بداية_كود_نواة، عنوان_نهاية_كود_نواة، 1، 2، 1)

    kernel_print_string("  تم حماية ")
    kernel_print_number(صفحات)
    kernel_print_string(" صفحة من كود النواة\n")

    ارجع صفحات
