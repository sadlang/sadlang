# ═══════════════════════════════════════════════════════════════════════════════
# تطبيق NX على صفحة
# ═══════════════════════════════════════════════════════════════════════════════

#** ضبط بت NX لصفحة معينة في جدول الصفحات
#   عنوان_جدول_صفحات: عنوان PTE
#   فهرس: فهرس الصفحة في الجدول
#   تفعيل_nx_صفحة: 1 = تفعيل NX, 0 = إلغاء NX
**#
دالة ضبط_nx_صفحة(عنوان_جدول_صفحات، فهرس، تفعيل_nx_صفحة)
    إذا (nx_مفعل == 0)
        ارجع -1
    نهاية

    # قراءة PTE الحالي
    متغير عنوان_pte = عنوان_جدول_صفحات + (فهرس * 4)
    متغير pte = mem_read_dword(عنوان_pte)

    # في وضع PAE، PTE هو 8 بايت — الدبل-وورد العلوي يحتوي بت NX
    متغير عنوان_pte_علوي = عنوان_pte + 4
    متغير pte_علوي = mem_read_dword(عنوان_pte_علوي)

    إذا (تفعيل_nx_صفحة == 1)
        # ضبط بت NX (بت 31 من الدبل-وورد العلوي = بت 63)
        متغير pte_علوي_محدث = pte_علوي | بت_صفحة_NX_علوي
        mem_write_dword(عنوان_pte_علوي، pte_علوي_محدث)
    وإلا
        # إلغاء بت NX
        متغير قناع_عكسي = بت_صفحة_NX_علوي
        متغير قناع_سالب = ~قناع_عكسي
        متغير pte_علوي_محدث = pte_علوي & قناع_سالب
        mem_write_dword(عنوان_pte_علوي، pte_علوي_محدث)
    نهاية

    # إبطال TLB لهذا العنوان
    متغير عنوان_افتراضي = فهرس * ثابت_مقاس_صفحة
    sad_ll_invlpg(عنوان_افتراضي)

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تطبيق NX على منطقة كاملة
# ═══════════════════════════════════════════════════════════════════════════════

#** ضبط بت NX لمنطقة كاملة من الذاكرة
#   عنوان_بداية: بداية المنطقة (محاذاة صفحة)
#   عنوان_نهاية: نهاية المنطقة
#   عنوان_cr3: عنوان دليل الصفحات
#   تفعيل: 1 = تفعيل NX, 0 = إلغاء NX
**#
دالة ضبط_nx_منطقة(عنوان_cr3، عنوان_بداية، عنوان_نهاية، تفعيل)
    إذا (nx_مفعل == 0)
        kernel_print_string("[حماية النواة] NX غير مفعل — لا يمكن ضبط المنطقة\n")
        ارجع -1
    نهاية

    متغير عنوان_حالي = عنوان_بداية
    متغير صفحات_معدلة = 0

    بينما (عنوان_حالي < عنوان_نهاية)
        # حساب مكان PTE لهذا العنوان
        متغير فهرس_دليل = عنوان_حالي >> 22
        متغير فهرس_جدول = (عنوان_حالي >> 12) & 1023

        # قراءة PDE
        متغير pde = mem_read_dword(عنوان_cr3 + (فهرس_دليل * 4))
        متغير فحص_حاضر = pde & بت_صفحة_حاضرة
        إذا (فحص_حاضر != 0)
            # الحصول على عنوان جدول الصفحات
            متغير عنوان_جدول = pde & قناع_عنوان_PTE

            # ضبط NX لهذا الـ PTE
            ضبط_nx_صفحة(عنوان_جدول، فهرس_جدول، تفعيل)
            صفحات_معدلة = صفحات_معدلة + 1
        نهاية

        عنوان_حالي = عنوان_حالي + ثابت_مقاس_صفحة
    نهاية

    kernel_print_string("[حماية النواة] NX: عُدلت ")
    kernel_print_number(صفحات_معدلة)
    kernel_print_string(" صفحة")
    إذا (تفعيل == 1)
        kernel_print_string(" (تفعيل NX)")
    وإلا
        kernel_print_string(" (إلغاء NX)")
    نهاية
    kernel_print_string("\n")

    ارجع صفحات_معدلة
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# فحص صفحة لانتهاك W^X
# ═══════════════════════════════════════════════════════════════════════════════

#** فحص هل صفحة تنتهك سياسة W^X
#   الصفحة تنتهك السياسة إذا كانت قابلة للكتابة وقابلة للتنفيذ معاً
#   (في وضع بدون NX — نعتبر الصفحة قابلة للتنفيذ ما لم تكن NX)
#   عنوان_pte: عنوان PTE في جدول الصفحات
#   تُرجع: 1 إذا تنتهك، 0 إذا لا
**#
دالة فحص_wx_صفحة(عنوان_pte)
    متغير pte = mem_read_dword(عنوان_pte)

    # فحص: هل الصفحة حاضرة؟
    متغير فحص_حاضرة = pte & بت_صفحة_حاضرة
    إذا (فحص_حاضرة == 0)
        # الصفحة غير حاضرة — لا انتهاك
        ارجع 0
    نهاية

    # فحص: هل قابلة للكتابة؟
    متغير فحص_كتابة = pte & بت_صفحة_كتابة
    متغير قابلة_للكتابة = 0
    إذا (فحص_كتابة != 0)
        قابلة_للكتابة = 1
    نهاية

    # فحص: هل قابلة للتنفيذ؟
    # إذا NX مفعل — نفحص بت NX في الدبل-وورد العلوي
    # إذا NX غير مفعل — كل الصفحات قابلة للتنفيذ
    متغير قابلة_للتنفيذ = 1

    إذا (nx_مفعل == 1)
        متغير pte_علوي = mem_read_dword(عنوان_pte + 4)
        متغير فحص_nx = pte_علوي & بت_صفحة_NX_علوي
        إذا (فحص_nx != 0)
            # الصفحة غير قابلة للتنفيذ
            قابلة_للتنفيذ = 0
        نهاية
    نهاية

    # سياسة W^X: انتهاك إذا كانت قابلة للكتابة والتنفيذ معاً
    إذا (قابلة_للكتابة == 1)
        إذا (قابلة_للتنفيذ == 1)
            ارجع 1
        نهاية
    نهاية

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إصلاح صفحة W^X
# ═══════════════════════════════════════════════════════════════════════════════

#** إصلاح صفحة تنتهك W^X بإزالة إذن الكتابة (الخيار الآمن)
#   أو إضافة NX (إذا مدعوم)
#   سياسة الإصلاح: قراءة فقط + تنفيذ (كود) أفضل من كتابة + NX (بيانات)
**#
دالة إصلاح_wx_صفحة(عنوان_pte، عنوان_افتراضي)
    متغير pte = mem_read_dword(عنوان_pte)

    # هل هذا في منطقة الكود؟ (قراءة فقط + تنفيذ)
    إذا (عنوان_افتراضي >= عنوان_بداية_كود_نواة)
        إذا (عنوان_افتراضي < عنوان_نهاية_كود_نواة)
            # منطقة كود — إزالة إذن الكتابة
            متغير قناع_لا_كتابة = ~بت_صفحة_كتابة
            متغير pte_محدث = pte & قناع_لا_كتابة
            mem_write_dword(عنوان_pte، pte_محدث)
            sad_ll_invlpg(عنوان_افتراضي)
            عداد_صفحات_مصلحة = عداد_صفحات_مصلحة + 1
            ارجع 1
        نهاية
    نهاية

    # هل هذا في منطقة البيانات؟ (كتابة + NX)
    إذا (عنوان_افتراضي >= عنوان_بداية_بيانات_نواة)
        إذا (عنوان_افتراضي < عنوان_نهاية_بيانات_نواة)
            # منطقة بيانات — إضافة NX
            إذا (nx_مفعل == 1)
                متغير pte_علوي = mem_read_dword(عنوان_pte + 4)
                متغير pte_علوي_محدث = pte_علوي | بت_صفحة_NX_علوي
                mem_write_dword(عنوان_pte + 4، pte_علوي_محدث)
            وإلا
                # NX غير مفعل — نزيل إذن الكتابة كبديل
                متغير قناع_لا_كتابة = ~بت_صفحة_كتابة
                متغير pte_محدث = pte & قناع_لا_كتابة
                mem_write_dword(عنوان_pte، pte_محدث)
            نهاية
            sad_ll_invlpg(عنوان_افتراضي)
            عداد_صفحات_مصلحة = عداد_صفحات_مصلحة + 1
            ارجع 1
        نهاية
    نهاية

    # منطقة أخرى — إزالة الكتابة بشكل افتراضي
    متغير قناع_لا_كتابة = ~بت_صفحة_كتابة
    متغير pte_محدث = pte & قناع_لا_كتابة
    mem_write_dword(عنوان_pte، pte_محدث)
    sad_ll_invlpg(عنوان_افتراضي)
    عداد_صفحات_مصلحة = عداد_صفحات_مصلحة + 1

    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# مسح W^X لدليل صفحات كامل
# ═══════════════════════════════════════════════════════════════════════════════

#** مسح جميع صفحات دليل الصفحات لاكتشاف انتهاكات W^X
#   عنوان_cr3: عنوان دليل الصفحات
#   إصلاح_تلقائي: 1 = إصلاح الانتهاكات تلقائياً، 0 = تقرير فقط
#   تُرجع عدد الانتهاكات المكتشفة
**#
دالة مسح_wx_كامل(عنوان_cr3، إصلاح_تلقائي)
    kernel_print_string("[حماية النواة] بدء مسح W^X...\n")

    عداد_مسح_wx = عداد_مسح_wx + 1
    متغير انتهاكات = 0
    متغير صفحات_فحصت = 0

    # مسح كل مدخلة في دليل الصفحات
    متغير فهرس_دليل = 0
    بينما (فهرس_دليل < ثابت_مداخل_دليل)
        متغير pde = mem_read_dword(عنوان_cr3 + (فهرس_دليل * 4))

        # فحص: هل PDE حاضرة؟
        متغير فحص_حاضرة = pde & بت_صفحة_حاضرة
        إذا (فحص_حاضرة != 0)
            # فحص: هل هي صفحة كبيرة (4MB)؟
            متغير فحص_كبيرة = pde & 128
            إذا (فحص_كبيرة != 0)
                # صفحة كبيرة — فحص W^X على PDE نفسها
                متغير فحص_كتابة = pde & بت_صفحة_كتابة
                إذا (فحص_كتابة != 0)
                    # صفحة كبيرة قابلة للكتابة — في وضع بدون NX تكون قابلة للتنفيذ
                    انتهاكات = انتهاكات + 1
                    عداد_صفحات_wx_مكتشفة = عداد_صفحات_wx_مكتشفة + 1

                    متغير عنوان_خرق = فهرس_دليل * 4194304
                    تسجيل_انتهاك(عنوان_خرق، فئة_انتهاك_WX، 0، عنوان_خرق، pde)
                نهاية
                صفحات_فحصت = صفحات_فحصت + 1
            وإلا
                # جدول صفحات — مسح كل مدخلة
                متغير عنوان_جدول = pde & قناع_عنوان_PTE

                متغير فهرس_جدول = 0
                بينما (فهرس_جدول < ثابت_مداخل_جدول)
                    متغير عنوان_pte = عنوان_جدول + (فهرس_جدول * 4)
                    متغير ناتج = فحص_wx_صفحة(عنوان_pte)

                    إذا (ناتج == 1)
                        # وُجد انتهاك W^X
                        انتهاكات = انتهاكات + 1
                        عداد_صفحات_wx_مكتشفة = عداد_صفحات_wx_مكتشفة + 1

                        متغير عنوان_خرق = (فهرس_دليل * 4194304) + (فهرس_جدول * 4096)

                        # تسجيل الانتهاك
                        متغير pte_قيمة = mem_read_dword(عنوان_pte)
                        تسجيل_انتهاك(عنوان_خرق، فئة_انتهاك_WX، 0، عنوان_خرق، pte_قيمة)

                        # إصلاح تلقائي إذا مطلوب
                        إذا (إصلاح_تلقائي == 1)
                            إصلاح_wx_صفحة(عنوان_pte، عنوان_خرق)
                        نهاية
                    نهاية

                    صفحات_فحصت = صفحات_فحصت + 1
                    فهرس_جدول = فهرس_جدول + 1
                نهاية
            نهاية
        نهاية

        فهرس_دليل = فهرس_دليل + 1
    نهاية

    عداد_صفحات_مفحوصة = عداد_صفحات_مفحوصة + صفحات_فحصت

    kernel_print_string("[حماية النواة] انتهى مسح W^X: ")
    kernel_print_number(صفحات_فحصت)
    kernel_print_string(" صفحة فُحصت، ")
    kernel_print_number(انتهاكات)
    kernel_print_string(" انتهاك")
    إذا (إصلاح_تلقائي == 1)
        kernel_print_string(" (إصلاح تلقائي)")
    نهاية
    kernel_print_string("\n")

    ارجع انتهاكات
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تسجيل انتهاك حماية
# ═══════════════════════════════════════════════════════════════════════════════

#** تسجيل انتهاك حماية في سجل الانتهاكات
#   عنوان: العنوان المسبب للانتهاك
#   فئة: فئة الانتهاك (SMEP, SMAP, NX, WX, ...)
#   عملية_معرف: معرف العملية المسببة
