        مشاكل_تج = مشاكل_تج + 1
    نهاية

    # فحص: أعلى علامة <= كلي
    متغير علامة_فح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_أعلى_علامة)
    إذا (علامة_فح > كتل_كلي_فح)
        طباعة_تحذير_تج("سلامة: أعلى علامة تتجاوز السعة!")
        مشاكل_تج = مشاكل_تج + 1
    نهاية

    إذا (مشاكل_تج == 0)
        طباعة_معلومة_رقم_تج("سلامة: التجمع سليم، الفهرس: "، فهرس_تج)
    وإلا
        طباعة_معلومة_رقم_تج("سلامة: عدد المشاكل: "، مشاكل_تج)
    نهاية

    ارجع مشاكل_تج
