# ─── كتابة كلمة (4 بايت) في مصفوفة ───
دالة كتابة_ح(قاعدة، فهرس، قيمة)
    mem_write_dword(قاعدة + فهرس * 4، قيمة)
نهاية

# ─── قراءة كلمة (4 بايت) من مصفوفة ───
دالة قراءة_ح(قاعدة، فهرس)
    ارجع mem_read_dword(قاعدة + فهرس * 4)
نهاية

# ─── حساب عنوان بداية سجل تجمع ───
دالة عنوان_تجمع(فهرس)
    ارجع ذاكرة_تجمعات + فهرس * مقاس_سجل_تجمع
نهاية

# ─── قراءة حقل من سجل تجمع ───
دالة قراءة_حقل_تج(فهرس، إزاحة)
    متغير عنوان_ق = عنوان_تجمع(فهرس) + إزاحة
    ارجع mem_read_dword(عنوان_ق)
نهاية

# ─── كتابة حقل في سجل تجمع ───
دالة كتابة_حقل_تج(فهرس، إزاحة، قيمة)
    متغير عنوان_ق = عنوان_تجمع(فهرس) + إزاحة
    mem_write_dword(عنوان_ق، قيمة)
نهاية

# ─── هل التجمع نشط؟ ───
دالة تجمع_نشط(فهرس)
    إذا (فهرس < 0)
        ارجع 0
    نهاية
    إذا (فهرس >= أقصى_تجمعات)
        ارجع 0
    نهاية
    ارجع قراءة_حقل_تج(فهرس، إزاحة_تج_مفعّل)
نهاية

# ─── تقديم الطابع الزمني ───
