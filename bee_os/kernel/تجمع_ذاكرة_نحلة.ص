# ─── فحص الكناري قبل التحرير ───
دالة فحص_كناري(فهرس_تج، عنوان_كتلة)
    متغير وضعية_فح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تصحيح)
    إذا (وضعية_فح == تصحيح_كناري)
        متغير مقاس_ك_فح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_كتلة)
        متغير قيمة_متوقعة = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كناري)
        متغير قيمة_فعلية = mem_read_dword(عنوان_كتلة + مقاس_ك_فح - 4)
        إذا (قيمة_فعلية != قيمة_متوقعة)
            طباعة_خلل_تج("!!! تجاوز كناري — تلف ذاكرة !!!")
            طباعة_معلومة_رقم_تج("عنوان الكتلة: "، عنوان_كتلة)
            طباعة_معلومة_رقم_تج("متوقع: "، قيمة_متوقعة)
            طباعة_معلومة_رقم_تج("فعلي: "، قيمة_فعلية)
            # تسجيل الحدث
            متغير تجاوزات_ف = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تجاوزات)
            كتابة_حقل_تج(فهرس_تج، إزاحة_تج_تجاوزات، تجاوزات_ف + 1)
            ارجع 0
        نهاية
    نهاية
    إذا (وضعية_فح == تصحيح_كامل)
        متغير مقاس_ك_فح2 = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_كتلة)
        متغير قيمة_متوقعة2 = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كناري)
        متغير قيمة_فعلية2 = mem_read_dword(عنوان_كتلة + مقاس_ك_فح2 - 4)
        إذا (قيمة_فعلية2 != قيمة_متوقعة2)
            طباعة_خلل_تج("!!! تجاوز كناري (وضع كامل) !!!")
            متغير تجاوزات_ف2 = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تجاوزات)
            كتابة_حقل_تج(فهرس_تج، إزاحة_تج_تجاوزات، تجاوزات_ف2 + 1)
            ارجع 0
        نهاية
    نهاية
    ارجع 1
نهاية

# ─── فحص التحرير المزدوج ───
دالة فحص_تحرير_مزدوج(فهرس_تج، عنوان_كتلة)
    # فحص علامة الكتلة — إذا كانت "حرة" فهذا تحرير مزدوج
    متغير علامة = mem_read_dword(عنوان_كتلة + 4)
    إذا (علامة == علامة_حرة)
        طباعة_خلل_تج("!!! تحرير مزدوج مكتشف !!!")
        طباعة_معلومة_رقم_تج("عنوان الكتلة: "، عنوان_كتلة)
        متغير مزدوج_ع = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تحرير_مزدوج)
        كتابة_حقل_تج(فهرس_تج، إزاحة_تج_تحرير_مزدوج، مزدوج_ع + 1)
        ارجع 0
    نهاية
    ارجع 1
نهاية

# ─── تعبئة الكتلة بنمط التسميم عند التحرير ───
دالة تسميم_تحرير(فهرس_تج، عنوان_كتلة)
    متغير وضعية_تح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تصحيح)
    إذا (وضعية_تح >= تصحيح_تسميم)
        متغير مقاس_تسم_ت = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_كتلة)
        # تسميم بعد أول 8 بايت (المؤشر والعلامة)
        متغير مقاس_تسميم = مقاس_تسم_ت - 8
        إذا (مقاس_تسميم > 0)
