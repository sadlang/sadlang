# ─── فحص سلامة تجمع واحد ───
صدّر دالة فحص_سلامة_تجمع(فهرس_تج)
    إذا (تجمع_نشط(فهرس_تج) == 0)
        ارجع 0
    نهاية

    متغير مشاكل_تج = 0

    # فحص: عدد الكتل الحرة في القائمة يطابق العدّاد
    متغير عدد_فعلي = عدّ_قائمة_حرة(فهرس_تج)
    متغير عدد_مسجل = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كتل_حرة)
    إذا (عدد_فعلي >= 0)
        إذا (عدد_فعلي != عدد_مسجل)
            طباعة_تحذير_تج("سلامة: عدد الكتل الحرة لا يطابق!")
            طباعة_معلومة_رقم_تج("  فعلي: "، عدد_فعلي)
            طباعة_معلومة_رقم_تج("  مسجل: "، عدد_مسجل)
            مشاكل_تج = مشاكل_تج + 1
        نهاية
    وإلا
        طباعة_خلل_تج("سلامة: مشكلة في القائمة الحرة!")
        مشاكل_تج = مشاكل_تج + 1
    نهاية

    # فحص: مستخدم + حرة = كلي
    متغير كتل_كلي_فح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كتل_كلي)
    متغير مستخدم_فح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_حالي_مستخدم)
    متغير حرة_فح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كتل_حرة)
    متغير مجموع_فح = مستخدم_فح + حرة_فح
    إذا (مجموع_فح != كتل_كلي_فح)
        طباعة_تحذير_تج("سلامة: مستخدم + حرة != كلي")
        طباعة_معلومة_رقم_تج("  مستخدم: "، مستخدم_فح)
        طباعة_معلومة_رقم_تج("  حرة: "، حرة_فح)
        طباعة_معلومة_رقم_تج("  كلي: "، كتل_كلي_فح)
        مشاكل_تج = مشاكل_تج + 1
    نهاية

    # فحص: التخصيصات >= التحريرات
    متغير تخصيصات_فح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تخصيصات)
    متغير تحريرات_فح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تحريرات)
    إذا (تحريرات_فح > تخصيصات_فح)
        طباعة_تحذير_تج("سلامة: تحريرات أكثر من تخصيصات!")
        مشاكل_تج = مشاكل_تج + 1
    نهاية

    # فحص: مقاس الكتلة >= 8
    متغير مقاس_فح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_كتلة)
    إذا (مقاس_فح < 8)
