    نهاية
نهاية

# ─── تحرير كتلة وإعادتها للقائمة الحرة ───
صدّر دالة تحرير_كتلة(فهرس_تج، عنوان_كتلة)
    إذا (تجمع_نشط(فهرس_تج) == 0)
        طباعة_خلل_تج("تحرير: التجمع غير نشط")
        ارجع -1
    نهاية

    إذا (عنوان_كتلة == 0)
        طباعة_خلل_تج("تحرير: عنوان فارغ")
        ارجع -1
    نهاية

    # فحص التحرير المزدوج
    متغير وضعية_تصح = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تصحيح)
    إذا (وضعية_تصح > 0)
        متغير سليم_مزدوج = فحص_تحرير_مزدوج(فهرس_تج، عنوان_كتلة)
        إذا (سليم_مزدوج == 0)
            ارجع -2
