# ─── كتابة الكناري في نهاية الكتلة ───
دالة كتابة_كناري(فهرس_تج، عنوان_كتلة)
    متغير وضعية_ت = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تصحيح)
    إذا (وضعية_ت == تصحيح_كناري)
        متغير مقاس_ك_كن = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_كتلة)
        متغير قيمة_كن = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كناري)
        # الكناري في آخر 4 بايت
        mem_write_dword(عنوان_كتلة + مقاس_ك_كن - 4، قيمة_كن)
    نهاية
    إذا (وضعية_ت == تصحيح_كامل)
        متغير مقاس_ك_كن2 = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_كتلة)
        متغير قيمة_كن2 = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كناري)
        mem_write_dword(عنوان_كتلة + مقاس_ك_كن2 - 4، قيمة_كن2)
    نهاية
نهاية

# ─── تعبئة الكتلة بنمط التخصيص (للتصحيح) ───
دالة تسميم_تخصيص(فهرس_تج، عنوان_كتلة)
    متغير وضعية_ت2 = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تصحيح)
    إذا (وضعية_ت2 >= تصحيح_تسميم)
        متغير مقاس_تسم = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_كتلة)
        متغير مقاس_تعبئة = مقاس_تسم - 8
        إذا (وضعية_ت2 == تصحيح_كامل)
            مقاس_تعبئة = مقاس_تسم - 12
        نهاية
        إذا (مقاس_تعبئة > 0)
            # تعبئة بنمط التخصيص بدءاً من البايت 8 (بعد المؤشر والعلامة)
            sad_ll_memset(عنوان_كتلة + 8، 170، مقاس_تعبئة)
        نهاية
    نهاية
نهاية

# ─── تخصيص كتلة من تجمع ─── 
# ارجع: عنوان الكتلة أو 0 عند الفشل
صدّر دالة تخصيص_كتلة(فهرس_تج)
    إذا (تجمع_نشط(فهرس_تج) == 0)
        طباعة_خلل_تج("تخصيص: التجمع غير نشط")
        ارجع 0
    نهاية

    # فحص التجميد
    متغير أعلام_تخ = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_أعلام)
    متغير مجمّد_تخ = أعلام_تخ & علم_تج_مجمّد
    إذا (مجمّد_تخ > 0)
        طباعة_خلل_تج("تخصيص: التجمع مجمّد")
        ارجع 0
    نهاية

    # محاولة سحب كتلة من القائمة الحرة
    متغير كتلة = سحب_من_القائمة_الحرة(فهرس_تج)

    إذا (كتلة == 0)
        # القائمة الحرة فارغة — حاول التوسيع
        متغير قابل_توسيع = أعلام_تخ & علم_تج_قابل_توسيع
        إذا (قابل_توسيع > 0)
            طباعة_معلومة_تج("القائمة الحرة فارغة، توسيع التجمع...")
            متغير صفحة_جديدة = تخصيص_صفحة(فهرس_تج)
            إذا (صفحة_جديدة == 0)
                طباعة_خلل_تج("فشل توسيع التجمع")
                ارجع 0
            نهاية
            # إعادة المحاولة
            كتلة = سحب_من_القائمة_الحرة(فهرس_تج)
            إذا (كتلة == 0)
                طباعة_خلل_تج("فشل التخصيص بعد التوسيع!")
                ارجع 0
            نهاية
        وإلا
            طباعة_خلل_تج("التجمع ممتلئ ولا يمكن توسيعه")
            ارجع 0
        نهاية
    نهاية

    # تحديث الإحصاءات
    متغير حرة_بعد = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كتل_حرة)
    إذا (حرة_بعد > 0)
        كتابة_حقل_تج(فهرس_تج، إزاحة_تج_كتل_حرة، حرة_بعد - 1)
    نهاية

    متغير مستخدم_بعد = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_حالي_مستخدم)
    مستخدم_بعد = مستخدم_بعد + 1
    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_حالي_مستخدم، مستخدم_بعد)

    # تحديث أعلى علامة
    متغير علامة_ع = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_أعلى_علامة)
    إذا (مستخدم_بعد > علامة_ع)
        كتابة_حقل_تج(فهرس_تج، إزاحة_تج_أعلى_علامة، مستخدم_بعد)
    نهاية

    متغير تخصيصات_ب = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_تخصيصات)
    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_تخصيصات، تخصيصات_ب + 1)

    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_آخر_تخصيص، تقديم_طابع_تج())

    # تحديث إجمالي النظام
    إجمالي_تخصيصات_كلي = إجمالي_تخصيصات_كلي + 1
    متغير مقاس_ك_ت = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_كتلة)
    إجمالي_ذاكرة_مستخدمة = إجمالي_ذاكرة_مستخدمة + مقاس_ك_ت

    # كتابة الكناري والتسميم (للتصحيح)
    كتابة_كناري(فهرس_تج، كتلة)
    تسميم_تخصيص(فهرس_تج، كتلة)

    ارجع كتلة
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
