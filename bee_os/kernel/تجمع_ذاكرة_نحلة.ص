# إيجاد خانة فارغة
# ═══════════════════════════════════════════════════════════════════════════════

# ─── البحث عن أول خانة فارغة ───
دالة إيجاد_خانة_تجمع()
    متغير ع = 0
    بينما (ع < أقصى_تجمعات)
        إذا (تجمع_نشط(ع) == 0)
            ارجع ع
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية

# ─── البحث عن تجمع بمقاس كتلة محدد ───
صدّر دالة إيجاد_تجمع_بمقاس(مقاس_مطلوب)
    متغير ع = 0
    بينما (ع < أقصى_تجمعات)
        إذا (تجمع_نشط(ع) == 1)
            متغير مقاس_ك = قراءة_حقل_تج(ع، إزاحة_تج_مقاس_كتلة)
            إذا (مقاس_ك == مقاس_مطلوب)
                ارجع ع
            نهاية
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية

# ─── إيجاد أفضل تجمع لمقاس (أقرب مقاس أكبر أو يساوي) ───
صدّر دالة إيجاد_أفضل_تجمع(مقاس_مطلوب)
    متغير أفضل_فهرس = -1
    متغير أفضل_مقاس = لا_حدّ
    ثابت لا_حدّ = 4294967295

    متغير ع = 0
    بينما (ع < أقصى_تجمعات)
        إذا (تجمع_نشط(ع) == 1)
            متغير مقاس_تج = قراءة_حقل_تج(ع، إزاحة_تج_مقاس_كتلة)
            إذا (مقاس_تج >= مقاس_مطلوب)
                إذا (مقاس_تج < أفضل_مقاس)
                    # تحقق أن لديه كتل حرة
                    متغير حرة_تج = قراءة_حقل_تج(ع، إزاحة_تج_كتل_حرة)
                    إذا (حرة_تج > 0)
                        أفضل_فهرس = ع
                        أفضل_مقاس = مقاس_تج
                    نهاية
                نهاية
            نهاية
        نهاية
        ع = ع + 1
    نهاية

    ارجع أفضل_فهرس
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إدارة القائمة الحرة (Free List)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── تهيئة القائمة الحرة لصفحة جديدة ───
# تبني سلسلة من الكتل الحرة داخل الصفحة
دالة بناء_قائمة_حرة(عنوان_بداية_كتل، مقاس_كتلة_ق، عدد_كتل)
    إذا (عدد_كتل == 0)
        ارجع 0
    نهاية

    متغير ع = 0
    بينما (ع < عدد_كتل - 1)
        متغير عنوان_كتلة = عنوان_بداية_كتل + ع * مقاس_كتلة_ق
        متغير عنوان_تالية = عنوان_بداية_كتل + (ع + 1) * مقاس_كتلة_ق
        # أول 4 بايت: مؤشر للكتلة التالية
        mem_write_dword(عنوان_كتلة، عنوان_تالية)
        # ثاني 4 بايت: علامة حرة
        mem_write_dword(عنوان_كتلة + 4، علامة_حرة)
        ع = ع + 1
    نهاية

    # الكتلة الأخيرة: مؤشر = 0 (نهاية القائمة)
    متغير عنوان_أخيرة = عنوان_بداية_كتل + (عدد_كتل - 1) * مقاس_كتلة_ق
    mem_write_dword(عنوان_أخيرة، 0)
    mem_write_dword(عنوان_أخيرة + 4، علامة_حرة)

    ارجع عنوان_بداية_كتل
نهاية

# ─── إضافة كتلة لبداية القائمة الحرة ───
دالة إضافة_للقائمة_الحرة(فهرس_تج، عنوان_كتلة)
    متغير رأس_حالي = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_رأس_حرة)
    # الكتلة الجديدة تشير للرأس الحالي
    mem_write_dword(عنوان_كتلة، رأس_حالي)
    mem_write_dword(عنوان_كتلة + 4، علامة_حرة)
    # تحديث الرأس
    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_رأس_حرة، عنوان_كتلة)
نهاية

# ─── سحب كتلة من بداية القائمة الحرة ───
دالة سحب_من_القائمة_الحرة(فهرس_تج)
    متغير رأس = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_رأس_حرة)
    إذا (رأس == 0)
        ارجع 0
    نهاية

    # قراءة المؤشر للكتلة التالية
    متغير تالية = mem_read_dword(رأس)
    # تحديث الرأس
    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_رأس_حرة، تالية)

    # مسح مؤشر القائمة وتعليم ككتلة مستخدمة
    mem_write_dword(رأس، 0)
    mem_write_dword(رأس + 4، علامة_مستخدمة)

    ارجع رأس
نهاية

# ─── عدّ عناصر القائمة الحرة (للتشخيص) ───
دالة عدّ_قائمة_حرة(فهرس_تج)
    متغير عدّاد = 0
    متغير حالي = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_رأس_حرة)
    متغير حارس = 0
    بينما (حالي != 0)
        عدّاد = عدّاد + 1
        حالي = mem_read_dword(حالي)
        حارس = حارس + 1
        إذا (حارس > 100000)
            طباعة_خلل_تج("حلقة لا نهائية في القائمة الحرة!")
            ارجع -1
        نهاية
    نهاية
    ارجع عدّاد
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إدارة الصفحات الخلفية (Backing Pages)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── تخصيص صفحة خلفية جديدة ───
دالة تخصيص_صفحة(فهرس_تج)
    متغير مقاس_صفحة = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_صفحة)
    إذا (مقاس_صفحة == 0)
        مقاس_صفحة = مقاس_صفحة_خلفية_افتراضي
    نهاية

    # فحص عدد الصفحات الحالية
    متغير صفحات_حالية = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_عدد_صفحات)
    إذا (صفحات_حالية >= أقصى_صفحات_تجمع)
        طباعة_خلل_تج("وصل لأقصى عدد صفحات")
        ارجع 0
    نهاية

    # تخصيص الصفحة (رأس + بيانات)
    متغير مقاس_إجمالي = مقاس_رأس_صفحة + مقاس_صفحة
    متغير عنوان_صفحة = kernel_allocate(مقاس_إجمالي)
    إذا (عنوان_صفحة == 0)
        طباعة_خلل_تج("فشل تخصيص صفحة خلفية")
        ارجع 0
    نهاية

    # تصفير الصفحة
    sad_ll_memset(عنوان_صفحة، 0، مقاس_إجمالي)

    # كتابة رأس الصفحة
    متغير رأس_صفحات_حالي = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_رأس_صفحات)
    mem_write_dword(عنوان_صفحة + إزاحة_صفحة_تالية، رأس_صفحات_حالي)
    mem_write_dword(عنوان_صفحة + إزاحة_صفحة_مقاس، مقاس_صفحة)

    متغير مقاس_كتلة_ص = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_مقاس_كتلة)
    متغير كتل_ص = مقاس_صفحة / مقاس_كتلة_ص
    mem_write_dword(عنوان_صفحة + إزاحة_صفحة_كتل، كتل_ص)
    mem_write_dword(عنوان_صفحة + إزاحة_صفحة_تجمع، فهرس_تج)

    # تحديث رأس الصفحات
    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_رأس_صفحات، عنوان_صفحة)
    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_عدد_صفحات، صفحات_حالية + 1)

    # بناء القائمة الحرة للصفحة الجديدة
    متغير عنوان_كتل_بداية = عنوان_صفحة + مقاس_رأس_صفحة
    متغير رأس_جديد = بناء_قائمة_حرة(عنوان_كتل_بداية، مقاس_كتلة_ص، كتل_ص)

    إذا (رأس_جديد > 0)
        # ربط القائمة الجديدة بالقائمة الحرة الحالية
        # إيجاد نهاية القائمة الجديدة
        متغير آخر = رأس_جديد
        متغير حارس_ص = 0
        بينما (حارس_ص < كتل_ص)
            متغير تالي_كتلة = mem_read_dword(آخر)
            إذا (تالي_كتلة == 0)
                # ربط بالقائمة الحرة الحالية
                متغير رأس_حرة_حالي = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_رأس_حرة)
                mem_write_dword(آخر، رأس_حرة_حالي)
                كتابة_حقل_تج(فهرس_تج، إزاحة_تج_رأس_حرة، رأس_جديد)
                حارس_ص = كتل_ص
            وإلا
                آخر = تالي_كتلة
            نهاية
            حارس_ص = حارس_ص + 1
        نهاية
    نهاية

    # تحديث الإحصاءات
    متغير كتل_كلي_ق = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كتل_كلي)
    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_كتل_كلي، كتل_كلي_ق + كتل_ص)

    متغير كتل_حرة_ق = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_كتل_حرة)
    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_كتل_حرة، كتل_حرة_ق + كتل_ص)

    # تحديث عدّاد التوسيعات
    متغير توسيعات_ق = قراءة_حقل_تج(فهرس_تج، إزاحة_تج_توسيعات)
    كتابة_حقل_تج(فهرس_تج، إزاحة_تج_توسيعات، توسيعات_ق + 1)

    طباعة_معلومة_رقم_تج("تم توسيع التجمع بصفحة جديدة، الكتل الجديدة: "، كتل_ص)
    ارجع عنوان_صفحة
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إنشاء تجمع جديد
# ═══════════════════════════════════════════════════════════════════════════════

# ─── تهيئة سجل تجمع ───
دالة تهيئة_سجل_تجمع(فهرس)
    متغير عنوان_بداية = عنوان_تجمع(فهرس)
    sad_ll_memset(عنوان_بداية، 0، مقاس_سجل_تجمع)
نهاية

# ─── إنشاء تجمع ذاكرة جديد ───
# مقاس_كتلة: مقاس كل كتلة (يجب >= 8 بسبب مؤشر القائمة الحرة)
# كتل_أولية: عدد الكتل في الصفحة الأولى (0 = حساب تلقائي)
# وضعية_تصحيح: 0-3
صدّر دالة إنشاء_تجمع(مقاس_كتلة_إ، كتل_أولية، وضعية_تصحيح_إ)
    # التحقق من المدخلات
    إذا (مقاس_كتلة_إ < 8)
        طباعة_خلل_تج("مقاس الكتلة أقل من 8 بايت")
        ارجع -1
    نهاية

    إذا (عدد_تجمعات_نشطة >= أقصى_تجمعات)
        طباعة_خلل_تج("تجاوز الحدّ الأقصى للتجمعات")
        ارجع -1
    نهاية

    # مقاس الكتلة الفعلي (مع الكناري إذا مفعّل)
    متغير مقاس_فعلي = مقاس_كتلة_إ
    إذا (وضعية_تصحيح_إ == تصحيح_كناري)
        مقاس_فعلي = مقاس_كتلة_إ + 4
    نهاية
    إذا (وضعية_تصحيح_إ == تصحيح_كامل)
        مقاس_فعلي = مقاس_كتلة_إ + 4
    نهاية

    # محاذاة إلى 4 بايت
    متغير باقي = مقاس_فعلي % 4
    إذا (باقي != 0)
        مقاس_فعلي = مقاس_فعلي + (4 - باقي)
    نهاية

    # إيجاد خانة فارغة
    متغير خانة = إيجاد_خانة_تجمع()
    إذا (خانة == -1)
        طباعة_خلل_تج("لا توجد خانة فارغة")
        ارجع -1
    نهاية

    # تهيئة السجل
    تهيئة_سجل_تجمع(خانة)

    # حساب عدد الكتل لكل صفحة
    متغير مقاس_صفحة_خ = مقاس_صفحة_خلفية_افتراضي
    متغير كتل_لكل_صفحة = مقاس_صفحة_خ / مقاس_فعلي
    إذا (كتل_لكل_صفحة == 0)
        # الكتلة أكبر من الصفحة، استخدم صفحة أكبر
        مقاس_صفحة_خ = مقاس_فعلي * 4
        كتل_لكل_صفحة = 4
    نهاية

    إذا (كتل_أولية > 0)
        كتل_لكل_صفحة = كتل_أولية
        مقاس_صفحة_خ = كتل_أولية * مقاس_فعلي
    نهاية

    # كتابة حقول السجل
    كتابة_حقل_تج(خانة، إزاحة_تج_مفعّل، 1)
    كتابة_حقل_تج(خانة، إزاحة_تج_مقاس_كتلة، مقاس_فعلي)
    كتابة_حقل_تج(خانة، إزاحة_تج_كتل_صفحة، كتل_لكل_صفحة)
    كتابة_حقل_تج(خانة، إزاحة_تج_مقاس_صفحة، مقاس_صفحة_خ)
    كتابة_حقل_تج(خانة، إزاحة_تج_تصحيح، وضعية_تصحيح_إ)
    كتابة_حقل_تج(خانة، إزاحة_تج_كناري، كناري_افتراضي)
    كتابة_حقل_تج(خانة، إزاحة_تج_تسميم، تسميم_محرر)
    كتابة_حقل_تج(خانة، إزاحة_تج_عتبة_تقليص، عتبة_تقليص_افتراضية)
    كتابة_حقل_تج(خانة، إزاحة_تج_طابع_إنشاء، تقديم_طابع_تج())

    # أعلام افتراضية: قابل للتوسيع والتقليص
    متغير أعلام_افتراضية = علم_تج_قابل_توسيع | علم_تج_قابل_تقليص
    كتابة_حقل_تج(خانة، إزاحة_تج_أعلام، أعلام_افتراضية)

    # تخصيص الصفحة الأولى
    متغير صفحة_أولى = تخصيص_صفحة(خانة)
    إذا (صفحة_أولى == 0)
        # إلغاء الإنشاء
        تهيئة_سجل_تجمع(خانة)
        طباعة_خلل_تج("فشل تخصيص الصفحة الأولى")
        ارجع -1
    نهاية

    عدد_تجمعات_نشطة = عدد_تجمعات_نشطة + 1

    طباعة_معلومة_رقم_تج("تم إنشاء تجمع جديد، الفهرس: "، خانة)
    طباعة_معلومة_رقم_تج("  مقاس الكتلة: "، مقاس_فعلي)
    طباعة_معلومة_رقم_تج("  كتل لكل صفحة: "، كتل_لكل_صفحة)
    ارجع خانة
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# التخصيص (Allocation)
