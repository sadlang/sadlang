# RSDP signatures: "RSD PTR " = 0x2052545020445352
# We check byte-by-byte: R=0x52, S=0x53, D=0x44, ' '=0x20, P=0x50, T=0x54, R=0x52, ' '=0x20
ثابت RSDP_SIG_0 = 82     # 'R'
ثابت RSDP_SIG_1 = 83     # 'S'
ثابت RSDP_SIG_2 = 68     # 'D'
