# ═══════════════════════════════════════════════════════════════════════════════
# البحث عن RSDP
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة acpi_find_rsdp()
    acpi_serial_اطبع("[ACPI] Searching for RSDP...")
    acpi_serial_سطر()

    # البحث في منطقة BIOS ROM: 0xE0000 - 0xFFFFF
    متغير addr = RSDP_BIOS_START + 0
    بينما (addr < RSDP_BIOS_END)
        # تحقق من التوقيع "RSD PTR "
        إذا (sad_ll_mem_read8(addr) == RSDP_SIG_0)
            إذا (sad_ll_mem_read8(addr + 1) == RSDP_SIG_1)
                إذا (sad_ll_mem_read8(addr + 2) == RSDP_SIG_2)
                    إذا (sad_ll_mem_read8(addr + 3) == RSDP_SIG_3)
                        إذا (sad_ll_mem_read8(addr + 4) == RSDP_SIG_4)
                            إذا (sad_ll_mem_read8(addr + 5) == RSDP_SIG_5)
                                # تحقق من Checksum
                                متغير cs = acpi_verify_checksum(addr، 20) + 0
                                إذا (cs == 0)
                                    acpi_serial_اطبع("[ACPI] RSDP found at 0x")
                                    acpi_serial_hex32(addr)
                                    acpi_serial_سطر()
                                    ارجع addr + 0
                                نهاية
                            نهاية
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
        addr = addr + 16  # RSDP aligned on 16 bytes
    نهاية

    acpi_serial_اطبع("[ACPI] RSDP not found!")
    acpi_serial_سطر()
    ارجع 0
نهاية

