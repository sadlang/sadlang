# ═══════════════════════════════════════════════════════════════════════════════
# تمكين ACPI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة acpi_enable()
    إذا (acpi_pm1a_ctl == 0) ارجع 0 - 1 نهاية

    # تحقق هل ACPI ممكّن بالفعل
    متغير pm1a = sad_ll_port_inw(acpi_pm1a_ctl) + 0
    إذا (pm1a % 2 == 1)  # SCI_EN bit
        acpi_serial_اطبع("[ACPI] Already enabled")
        acpi_serial_سطر()
        acpi_enabled = 1
        ارجع 0
    نهاية

    # إرسال أمر التمكين عبر SMI
    إذا (acpi_smi_cmd > 0)
        sad_ll_port_outb(acpi_smi_cmd، acpi_enable_val)

        # انتظار التمكين
        متغير timeout = 10000 + 0
        بينما (timeout > 0)
            pm1a = sad_ll_port_inw(acpi_pm1a_ctl) + 0
            إذا (pm1a % 2 == 1)
                acpi_serial_اطبع("[ACPI] Enabled via SMI")
                acpi_serial_سطر()
                acpi_enabled = 1
                ارجع 0
            نهاية
            timeout = timeout - 1
        نهاية
        acpi_serial_اطبع("[ACPI] Enable timeout!")
        acpi_serial_سطر()
        acpi_errors = acpi_errors + 1
        ارجع 0 - 1
    نهاية

    acpi_serial_اطبع("[ACPI] No SMI command port")
    acpi_serial_سطر()
    ارجع 0 - 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إيقاف التشغيل (Shutdown via ACPI S5)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة acpi_shutdown()
    acpi_serial_اطبع("[ACPI] Shutdown...")
    acpi_serial_سطر()

    إذا (acpi_pm1a_ctl == 0)
        acpi_serial_اطبع("[ACPI] No PM1a_CTL, can't shutdown")
        acpi_serial_سطر()
        ارجع 0 - 1
    نهاية

    # SLP_TYPa = 5 (S5 state default for most BIOSes)
    # PM1a_CTL = SLP_TYPa << 10 | SLP_EN
    متغير slp = (acpi_slp_typa * 1024) + PM1_SLP_EN
    sad_ll_port_outw(acpi_pm1a_ctl، slp)

    إذا (acpi_pm1b_ctl > 0)
        متغير slp_b = (acpi_slp_typb * 1024) + PM1_SLP_EN
        sad_ll_port_outw(acpi_pm1b_ctl، slp_b)
    نهاية

    acpi_serial_اطبع("[ACPI] Shutdown command sent")
    acpi_serial_سطر()
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إعادة التشغيل
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة acpi_reboot()
    acpi_serial_اطبع("[ACPI] Rebooting via keyboard controller...")
