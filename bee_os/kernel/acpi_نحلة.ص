# ═══════════════════════════════════════════════════════════════════════════════
# مطابقة توقيع SDT
# ═══════════════════════════════════════════════════════════════════════════════
دالة acpi_match_sig(addr، s0، s1، s2، s3)
    إذا (sad_ll_mem_read8(addr) != s0) ارجع 0 نهاية
    إذا (sad_ll_mem_read8(addr + 1) != s1) ارجع 0 نهاية
    إذا (sad_ll_mem_read8(addr + 2) != s2) ارجع 0 نهاية
    إذا (sad_ll_mem_read8(addr + 3) != s3) ارجع 0 نهاية
    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحليل RSDT
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة acpi_parse_rsdt()
    إذا (acpi_rsdt_addr == 0) ارجع 0 - 1 نهاية

    # Verify RSDT signature
    إذا (acpi_match_sig(acpi_rsdt_addr، SIG_RSDT_0، SIG_RSDT_1، SIG_RSDT_2، SIG_RSDT_3) == 0)
        acpi_serial_اطبع("[ACPI] Invalid RSDT signature!")
        acpi_serial_سطر()
        acpi_errors = acpi_errors + 1
        ارجع 0 - 1
    نهاية

    # Length at offset 4 (4 bytes)
    متغير length = sad_ll_mem_read32(acpi_rsdt_addr + 4) + 0
    acpi_serial_اطبع("[ACPI] RSDT length=")
    acpi_serial_رقم(length + 0)
    acpi_serial_سطر()

    # Entries start at offset 36, each 4 bytes (32-bit addresses)
    متغير entries_start = acpi_rsdt_addr + 36
    متغير entries_end = acpi_rsdt_addr + length
    متغير ptr = entries_start + 0

    بينما (ptr < entries_end)
        إذا (acpi_table_count >= 16) اخرج نهاية

        متغير table_addr = sad_ll_mem_read32(ptr) + 0
        إذا (table_addr > 0)
            # قراءة التوقيع
            متغير sig0 = sad_ll_mem_read8(table_addr) + 0

            acpi_serial_اطبع("[ACPI] Table: ")
            acpi_serial_sig(table_addr)
            acpi_serial_اطبع(" at 0x")
            acpi_serial_hex32(table_addr)
            acpi_serial_سطر()

            acpi_set_table(acpi_table_count، table_addr، sig0)
            acpi_table_count = acpi_table_count + 1

            # تحديد الجداول المهمة
            إذا (acpi_match_sig(table_addr، SIG_FACP_0، SIG_FACP_1، SIG_FACP_2، SIG_FACP_3) == 1)
                acpi_fadt_addr = table_addr + 0
            نهاية

            إذا (acpi_match_sig(table_addr، SIG_APIC_0، SIG_APIC_1، SIG_APIC_2، SIG_APIC_3) == 1)
                acpi_madt_addr = table_addr + 0
            نهاية

            إذا (acpi_match_sig(table_addr، SIG_HPET_0، SIG_HPET_1، SIG_HPET_2، SIG_HPET_3) == 1)
                acpi_hpet_addr = table_addr + 0
            نهاية

            إذا (acpi_match_sig(table_addr، SIG_MCFG_0، SIG_MCFG_1، SIG_MCFG_2، SIG_MCFG_3) == 1)
                acpi_mcfg_addr = table_addr + 0
            نهاية
        نهاية

        ptr = ptr + 4
    نهاية

    acpi_serial_اطبع("[ACPI] Found ")
    acpi_serial_رقم(acpi_table_count + 0)
    acpi_serial_اطبع(" tables")
    acpi_serial_سطر()

    ارجع acpi_table_count + 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحليل FADT
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة acpi_parse_fadt()
    إذا (acpi_fadt_addr == 0)
        acpi_serial_اطبع("[ACPI] No FADT found")
        acpi_serial_سطر()
        ارجع 0 - 1
    نهاية

    acpi_serial_اطبع("[ACPI] Parsing FADT...")
    acpi_serial_سطر()

    # DSDT at offset 40
    acpi_dsdt_addr = sad_ll_mem_read32(acpi_fadt_addr + 40) + 0
    acpi_serial_اطبع("[ACPI] DSDT at 0x")
    acpi_serial_hex32(acpi_dsdt_addr)
    acpi_serial_سطر()

    # SMI Command Port at offset 48
    acpi_smi_cmd = sad_ll_mem_read32(acpi_fadt_addr + 48) + 0

    # ACPI Enable/Disable values at offsets 52, 53
    acpi_enable_val = sad_ll_mem_read8(acpi_fadt_addr + 52) + 0
    acpi_disable_val = sad_ll_mem_read8(acpi_fadt_addr + 53) + 0

    # PM1a Event Block at offset 56
    acpi_pm1a_evt = sad_ll_mem_read32(acpi_fadt_addr + 56) + 0

    # PM1a Control Block at offset 64
    acpi_pm1a_ctl = sad_ll_mem_read32(acpi_fadt_addr + 64) + 0
    # PM1b Control Block at offset 68
    acpi_pm1b_ctl = sad_ll_mem_read32(acpi_fadt_addr + 68) + 0

    acpi_serial_اطبع("[ACPI] PM1a_CTL=0x")
    acpi_serial_hex32(acpi_pm1a_ctl)
    acpi_serial_اطبع(" PM1a_EVT=0x")
    acpi_serial_hex32(acpi_pm1a_evt)
    acpi_serial_سطر()

    acpi_serial_اطبع("[ACPI] SMI_CMD=0x")
    acpi_serial_hex32(acpi_smi_cmd)
    acpi_serial_اطبع(" ACPI_EN=")
    acpi_serial_رقم(acpi_enable_val + 0)
    acpi_serial_سطر()

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحليل MADT (Multiple APIC Description Table)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة acpi_parse_madt()
    إذا (acpi_madt_addr == 0)
        acpi_serial_اطبع("[ACPI] No MADT found")
        acpi_serial_سطر()
        ارجع 0 - 1
    نهاية

    acpi_serial_اطبع("[ACPI] Parsing MADT...")
    acpi_serial_سطر()

    متغير length = sad_ll_mem_read32(acpi_madt_addr + 4) + 0

    # Local APIC Address at offset 36
    acpi_lapic_addr = sad_ll_mem_read32(acpi_madt_addr + 36) + 0
    acpi_serial_اطبع("[ACPI] LAPIC base=0x")
    acpi_serial_hex32(acpi_lapic_addr)
    acpi_serial_سطر()

    # Flags at offset 40
    متغير madt_flags = sad_ll_mem_read32(acpi_madt_addr + 40) + 0

    # Entries start at offset 44
    متغير ptr = acpi_madt_addr + 44
    متغير end_ptr = acpi_madt_addr + length

    بينما (ptr < end_ptr)
        متغير entry_type = sad_ll_mem_read8(ptr) + 0
        متغير entry_len = sad_ll_mem_read8(ptr + 1) + 0
        إذا (entry_len < 2) اخرج نهاية  # invalid

        إذا (entry_type == MADT_LAPIC)
            إذا (lapic_count < ACPI_MAX_LAPICS)
                متغير proc_id = sad_ll_mem_read8(ptr + 2) + 0
                متغير apic_id = sad_ll_mem_read8(ptr + 3) + 0
                متغير flags = sad_ll_mem_read32(ptr + 4) + 0

                acpi_set_lapic_id(lapic_count، apic_id)
                acpi_set_lapic_proc(lapic_count، proc_id)
                acpi_set_lapic_flags(lapic_count، flags)

                acpi_serial_اطبع("[ACPI] LAPIC: proc=")
                acpi_serial_رقم(proc_id + 0)
                acpi_serial_اطبع(" id=")
                acpi_serial_رقم(apic_id + 0)
                acpi_serial_اطبع(" flags=")
                acpi_serial_رقم(flags + 0)
                acpi_serial_سطر()

                lapic_count = lapic_count + 1
            نهاية
        نهاية

        إذا (entry_type == MADT_IOAPIC)
            إذا (ioapic_count < ACPI_MAX_IOAPICS)
                متغير io_id = sad_ll_mem_read8(ptr + 2) + 0
                متغير io_addr = sad_ll_mem_read32(ptr + 4) + 0
                متغير io_gsi = sad_ll_mem_read32(ptr + 8) + 0

                acpi_set_ioapic(ioapic_count، io_id، io_addr، io_gsi)

                acpi_serial_اطبع("[ACPI] IOAPIC: id=")
                acpi_serial_رقم(io_id + 0)
                acpi_serial_اطبع(" addr=0x")
                acpi_serial_hex32(io_addr)
                acpi_serial_اطبع(" GSI=")
                acpi_serial_رقم(io_gsi + 0)
                acpi_serial_سطر()

                ioapic_count = ioapic_count + 1
            نهاية
        نهاية

        إذا (entry_type == MADT_ISO)
            إذا (iso_count < 8)
                متغير bus = sad_ll_mem_read8(ptr + 2) + 0
                متغير source = sad_ll_mem_read8(ptr + 3) + 0
                متغير gsi = sad_ll_mem_read32(ptr + 4) + 0
                متغير flags = sad_ll_mem_read16(ptr + 8) + 0

                acpi_set_iso(iso_count، bus، source، gsi، flags)

                acpi_serial_اطبع("[ACPI] ISO: IRQ")
                acpi_serial_رقم(source + 0)
                acpi_serial_اطبع(" -> GSI")
                acpi_serial_رقم(gsi + 0)
                acpi_serial_سطر()

                iso_count = iso_count + 1
            نهاية
        نهاية

        ptr = ptr + entry_len
    نهاية

    acpi_serial_اطبع("[ACPI] LAPICs=")
    acpi_serial_رقم(lapic_count + 0)
    acpi_serial_اطبع(" IOAPICs=")
    acpi_serial_رقم(ioapic_count + 0)
    acpi_serial_اطبع(" ISOs=")
    acpi_serial_رقم(iso_count + 0)
    acpi_serial_سطر()

    ارجع lapic_count + 0
نهاية

