    متغير irq = pci_get_irq_line(bus + 0، dev + 0، func + 0) + 0

    متغير class_full = cls * 65536 + sub * 256 + pif

    pci_register_device(bus + 0، dev + 0، func + 0، vid + 0، did + 0، class_full + 0، bar0 + 0، bar1 + 0، irq + 0)

