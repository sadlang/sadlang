# ═══════════════════════════════════════════════════════════════════════════════
# حجم BAR
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة pci_get_bar_size(bus، dev، func، bar_num)
    متغير bar_reg = PCI_BAR0 + (bar_num * 4)
    متغير original = pci_read32(bus + 0، dev + 0، func + 0، bar_reg) + 0

    # كتابة 0xFFFFFFFF
    pci_write32(bus + 0، dev + 0، func + 0، bar_reg، 4294967295)
    متغير size_mask = pci_read32(bus + 0، dev + 0، func + 0، bar_reg) + 0

    # استعادة القيمة الأصلية
    pci_write32(bus + 0، dev + 0، func + 0، bar_reg، original)

    إذا (size_mask == 0)
        ارجع 0
    نهاية

    # إزالة بتات النوع
    إذا ((original % 2) == 1)
        # I/O BAR — إزالة آخر 2 بت
        size_mask = (size_mask / 4) * 4
    والا
        # Memory BAR — إزالة آخر 4 بت
        size_mask = (size_mask / 16) * 16
