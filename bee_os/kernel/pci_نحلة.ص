# ═══════════════════════════════════════════════════════════════════════════════
# PCI Configuration Space Access — Mechanism #1
# ═══════════════════════════════════════════════════════════════════════════════
# بناء عنوان التكوين
# Address = 0x80000000 | (bus << 16) | (dev << 11) | (func << 8) | (reg & 0xFC)
صدّر دالة pci_config_address(bus، dev، func، reg)
    # 0x80000000 = 2147483648
    متغير addr = 2147483648 + 0
    addr = addr + (bus * 65536)        # bus << 16
    addr = addr + (dev * 2048)         # dev << 11
    addr = addr + (func * 256)         # func << 8
    # reg & 0xFC — مضاعفات 4 فقط
    متغير reg_aligned = (reg / 4) * 4
    addr = addr + reg_aligned
    ارجع addr + 0
نهاية

# قراءة كلمة مزدوجة (32 بت) من فضاء التكوين
صدّر دالة pci_read32(bus، dev، func، reg)
    متغير addr = pci_config_address(bus + 0، dev + 0، func + 0، reg + 0) + 0
    sad_ll_port_outl(PCI_CONFIG_ADDR، addr)
    متغير val = sad_ll_port_inl(PCI_CONFIG_DATA) + 0
    ارجع val + 0
نهاية

# كتابة كلمة مزدوجة (32 بت) في فضاء التكوين
صدّر دالة pci_write32(bus، dev، func، reg، val)
    متغير addr = pci_config_address(bus + 0، dev + 0، func + 0، reg + 0) + 0
    sad_ll_port_outl(PCI_CONFIG_ADDR، addr)
    sad_ll_port_outl(PCI_CONFIG_DATA، val + 0)
    ارجع 0
نهاية

# قراءة كلمة (16 بت) من فضاء التكوين
صدّر دالة pci_read16(bus، dev، func، reg)
    متغير val32 = pci_read32(bus + 0، dev + 0، func + 0، reg + 0) + 0
    متغير shift = (reg % 4) * 8
    إذا (shift == 0)
        ارجع val32 % 65536
    نهاية
    إذا (shift == 16)
        ارجع val32 / 65536
    نهاية
    ارجع val32 % 65536
نهاية

# قراءة بايت (8 بت) من فضاء التكوين
صدّر دالة pci_read8(bus، dev، func، reg)
    متغير val32 = pci_read32(bus + 0، dev + 0، func + 0، reg + 0) + 0
    متغير shift = (reg % 4) * 8
    إذا (shift == 0)
        ارجع val32 % 256
    نهاية
    إذا (shift == 8)
        ارجع (val32 / 256) % 256
    نهاية
    إذا (shift == 16)
        ارجع (val32 / 65536) % 256
    نهاية
    إذا (shift == 24)
        ارجع (val32 / 16777216) % 256
    نهاية
    ارجع val32 % 256
نهاية

# كتابة كلمة (16 بت) في فضاء التكوين
صدّر دالة pci_write16(bus، dev، func، reg، val)
    متغير val32 = pci_read32(bus + 0، dev + 0، func + 0، reg + 0) + 0
    متغير shift = (reg % 4) * 8
    إذا (shift == 0)
        val32 = (val32 / 65536) * 65536 + (val % 65536)
    نهاية
    إذا (shift == 16)
        val32 = (val32 % 65536) + (val % 65536) * 65536
    نهاية
    pci_write32(bus + 0، dev + 0، func + 0، reg + 0، val32)
    ارجع 0
نهاية

