# تفعيل Bus Master / IO / Memory
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة pci_enable_bus_master(bus، dev، func)
    متغير cmd = pci_read16(bus + 0، dev + 0، func + 0، PCI_COMMAND) + 0
    # تفعيل IO + MEM + Bus Master
    متغير new_cmd = cmd + 0
    # التحقق وإضافة كل بت
    إذا ((new_cmd % 2) == 0)
        new_cmd = new_cmd + PCI_CMD_IO_ENABLE
    نهاية
    إذا (((new_cmd / 2) % 2) == 0)
        new_cmd = new_cmd + PCI_CMD_MEM_ENABLE
    نهاية
    إذا (((new_cmd / 4) % 2) == 0)
        new_cmd = new_cmd + PCI_CMD_BUS_MASTER
    نهاية
    pci_write16(bus + 0، dev + 0، func + 0، PCI_COMMAND، new_cmd)
    ارجع new_cmd + 0
