    pci_serial_hex16(vid + 0)
    pci_serial_اطبع(" DID=0x")
    pci_serial_hex16(did + 0)
    pci_serial_اطبع(" Class=")
    pci_serial_hex8(cls + 0)
    sad_ll_serial_write_char(COM1، 58)
    pci_serial_hex8(sub + 0)
    sad_ll_serial_write_char(COM1، 58)
