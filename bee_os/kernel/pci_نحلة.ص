# pci_نحلة.ص — وحدة ناقل PCI لنظام نحلة
# بسم الله الرحمن الرحيم
# ═══════════════════════════════════════════════════════════════════════════════
# PCI Configuration Space Access (Mechanism #1)
# Port 0xCF8 = CONFIG_ADDRESS, Port 0xCFC = CONFIG_DATA
# Scans Bus 0-7, Device 0-31, Function 0-7
# Supports: Device detection, BAR reading, interrupt routing, class codes
# ═══════════════════════════════════════════════════════════════════════════════

# ─── دوال خارجية (FFI) ───
خارجي دالة sad_ll_port_inb(port)
خارجي دالة sad_ll_port_outb(port، val)
خارجي دالة sad_ll_port_inw(port)
خارجي دالة sad_ll_port_outw(port، val)
خارجي دالة sad_ll_port_inl(port)
خارجي دالة sad_ll_port_outl(port، val)
خارجي دالة sad_ll_mem_read8(addr)
خارجي دالة sad_ll_mem_write8(addr، val)
خارجي دالة sad_ll_mem_read32(addr)
خارجي دالة sad_ll_mem_write32(addr، val)
خارجي دالة sad_ll_serial_write_char(port، ch)
خارجي دالة sad_ll_kmalloc(حجم_طلب)
خارجي دالة sad_ll_kfree(عنوان)
خارجي دالة sad_ll_memset(عنوان، قيمة، حجم_منطقة)
خارجي دالة sad_ll_memcpy(هدف، مصدر، حجم_نقل)

