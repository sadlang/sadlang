# ═══════════════════════════════════════════════════════════════════════════════
# تكوين Capabilities (للأجهزة المتقدمة)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة pci_find_capability(bus، dev، func، cap_id)
    # التحقق من وجود قائمة القدرات
    متغير status = pci_read16(bus + 0، dev + 0، func + 0، PCI_STATUS) + 0
    # Bit 4 = Capabilities List exists
    إذا (((status / 16) % 2) == 0)
        ارجع 0
    نهاية

    # مؤشر أول قدرة في السجل 0x34
    متغير cap_ptr = pci_read8(bus + 0، dev + 0، func + 0، 52) + 0
    # محاذاة على 4 بايت
    cap_ptr = (cap_ptr / 4) * 4

    متغير iterations = 0 + 0
    بينما (cap_ptr > 0)
        إذا (iterations > 48)
            ارجع 0  # حماية من حلقة لا نهائية
        نهاية

        متغير id = pci_read8(bus + 0، dev + 0، func + 0، cap_ptr) + 0
        إذا (id == cap_id)
            ارجع cap_ptr + 0
        نهاية

        # المؤشر التالي
        cap_ptr = pci_read8(bus + 0، dev + 0، func + 0، cap_ptr + 1) + 0
        cap_ptr = (cap_ptr / 4) * 4
        iterations = iterations + 1
    نهاية

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# MSI (Message Signaled Interrupts)
# ═══════════════════════════════════════════════════════════════════════════════
ثابت PCI_CAP_MSI = 5    # 0x05

صدّر دالة pci_enable_msi(bus، dev، func، vector)
    متغير cap_pos = pci_find_capability(bus + 0، dev + 0، func + 0، PCI_CAP_MSI) + 0
    إذا (cap_pos == 0)
        pci_serial_اطبع("[PCI] MSI not supported")
        pci_serial_سطر()
        ارجع 0
    نهاية

    # MSI Control Register (cap_pos + 2)
    متغير msi_ctrl = pci_read16(bus + 0، dev + 0، func + 0، cap_pos + 2) + 0

    # Message Address (cap_pos + 4) = 0xFEE00000 | (CPU = 0)
    # 0xFEE00000 = 4276092928
    pci_write32(bus + 0، dev + 0، func + 0، cap_pos + 4، 4276092928)

    # Message Data (cap_pos + 8 or +12) = vector
    إذا (((msi_ctrl / 128) % 2) == 1)
        # 64-bit
        pci_write32(bus + 0، dev + 0، func + 0، cap_pos + 8، 0)
        pci_write16(bus + 0، dev + 0، func + 0، cap_pos + 12، vector)
    والا
        # 32-bit
        pci_write16(bus + 0، dev + 0، func + 0، cap_pos + 8، vector)
    نهاية

    # Enable MSI (bit 0 of control)
    إذا ((msi_ctrl % 2) == 0)
        msi_ctrl = msi_ctrl + 1
    نهاية
    pci_write16(bus + 0، dev + 0، func + 0، cap_pos + 2، msi_ctrl)

    pci_serial_اطبع("[PCI] MSI enabled, vector=")
    pci_serial_رقم(vector + 0)
    pci_serial_سطر()
    ارجع 1
نهاية

