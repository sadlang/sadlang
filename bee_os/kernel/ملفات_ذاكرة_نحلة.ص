## بدء قراءة استباقية
صدّر دالة ra_ابدأ(ملف, صفحة_بداية)
    # ابحث عن طلب موجود لنفس الملف
    متغير ط = 0
    بينما (ط < RA_أقصى_طلبات)
        إذا (ra_نشط_ra[ط] == 1)
            إذا (ra_ملف[ط] == ملف)
                # تحقق إذا كانت القراءة تسلسلية
                إذا (صفحة_بداية == ra_صفحة_بداية[ط] + ra_حجم_نافذة[ط])
                    ra_تسلسلي[ط] = ra_تسلسلي[ط] + 1
                    # وسّع النافذة
                    إذا (ra_حجم_نافذة[ط] < 16)
                        ra_حجم_نافذة[ط] = ra_حجم_نافذة[ط] * 2
                    نهاية
                    ra_صفحة_بداية[ط] = صفحة_بداية + 0
                    
                    # اقرأ الصفحات مسبقاً
                    متغير ص = 0
                    بينما (ص < ra_حجم_نافذة[ط])
                        متغير موجود = pcache_ابحث(ملف + 0, صفحة_بداية + ص)
                        إذا (موجود == 0)
                            pcache_أضف(ملف + 0, صفحة_بداية + ص)
                        نهاية
                        ص = ص + 1
                    نهاية
                    
                    ارجع ra_حجم_نافذة[ط] + 0
                وإلا
                    # قراءة عشوائية، أعد تعيين
                    ra_صفحة_بداية[ط] = صفحة_بداية + 0
                    ra_حجم_نافذة[ط] = RA_نافذة_افتراضية
                    ra_تسلسلي[ط] = 0
                    ارجع RA_نافذة_افتراضية
                نهاية
            نهاية
        نهاية
        ط = ط + 1
    نهاية
    
    # طلب جديد
    إذا (ra_عداد >= RA_أقصى_طلبات)
        ارجع 0
    نهاية
    
    متغير فهرس = -1
    متغير ي = 0
    بينما (ي < RA_أقصى_طلبات)
        إذا (ra_نشط_ra[ي] == 0)
            فهرس = ي + 0
            ي = RA_أقصى_طلبات
        نهاية
