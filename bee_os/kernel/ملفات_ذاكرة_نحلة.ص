## تعيين ملف في الذاكرة (mmap)
صدّر دالة fmm_mmap(ملف, حجم_المطلوب, أعلام_تعيين, عملية_طالبة)
    إذا (mmap_عداد >= MMAP_أقصى)
        ارجع -1
    نهاية
    
    # احسب عدد الصفحات المطلوبة
    متغير عدد_صفحات = حجم_المطلوب / MMAP_حجم_صفحة
    إذا ((حجم_المطلوب % MMAP_حجم_صفحة) > 0)
        عدد_صفحات = عدد_صفحات + 1
    نهاية
    
    # ابحث عن فتحة فارغة
    متغير فهرس = -1
    متغير ط = 0
    بينما (ط < MMAP_أقصى)
        إذا (mmap_نشط_تعيين[ط] == 0)
            فهرس = ط + 0
            ط = MMAP_أقصى
        نهاية
        ط = ط + 1
    نهاية
    
    إذا (فهرس < 0)
        ارجع -1
    نهاية
    
    # خصص صفحات الذاكرة
    متغير عنوان_أول = fmm_خصص_صفحة()
    إذا (عنوان_أول == 0)
        ارجع -1
    نهاية
    
    # صفر الصفحة الأولى
    fmm_صفر(عنوان_أول + 0, 0, MMAP_حجم_صفحة)
    
    # خصص باقي الصفحات (حتى 4 صفحات)
    متغير ص = 1
    بينما (ص < عدد_صفحات)
        إذا (ص < 4)
            متغير صفحة_إضافية = fmm_خصص_صفحة()
            إذا (صفحة_إضافية > 0)
                fmm_صفر(صفحة_إضافية + 0, 0, MMAP_حجم_صفحة)
            نهاية
        نهاية
        ص = ص + 1
    نهاية
    
    mmap_عنوان_ملف[فهرس] = ملف + 0
    mmap_عنوان_ذاكرة[فهرس] = عنوان_أول + 0
    mmap_حجم_تعيين[فهرس] = حجم_المطلوب + 0
    mmap_أعلام[فهرس] = أعلام_تعيين + 0
    mmap_عملية[فهرس] = عملية_طالبة + 0
    mmap_متسخ[فهرس] = 0
    mmap_نشط_تعيين[فهرس] = 1
    mmap_عداد = mmap_عداد + 1
    
    fmm_اطبع("[MMAP] تعيين ملف=")
    fmm_اطبع_رقم(ملف + 0)
    fmm_اطبع(" حجم=")
    fmm_اطبع_رقم(حجم_المطلوب + 0)
    fmm_اطبع(" عنوان=")
    fmm_اطبع_رقم(عنوان_أول + 0)
    fmm_اطبع("\n")
    
    ارجع عنوان_أول + 0
نهاية

## إلغاء تعيين (munmap)
صدّر دالة fmm_munmap(عنوان)
    متغير ط = 0
    بينما (ط < MMAP_أقصى)
        إذا (mmap_نشط_تعيين[ط] == 1)
            إذا (mmap_عنوان_ذاكرة[ط] == عنوان)
                # إذا متسخ، يجب الكتابة أولاً
                إذا (mmap_متسخ[ط] == 1)
                    fmm_اطبع("[MMAP] كتابة بيانات متسخة لملف ")
                    fmm_اطبع_رقم(mmap_عنوان_ملف[ط] + 0)
                    fmm_اطبع("\n")
                نهاية
                
                mmap_نشط_تعيين[ط] = 0
                mmap_عداد = mmap_عداد - 1
                
                fmm_اطبع("[MMAP] إلغاء تعيين @")
                fmm_اطبع_رقم(عنوان + 0)
                fmm_اطبع("\n")
                ارجع 0
            نهاية
        نهاية
        ط = ط + 1
    نهاية
    ارجع -1
نهاية

## قراءة بايت من تعيين
صدّر دالة fmm_mmap_قراءة(عنوان, إزاحة)
    متغير ط = 0
    بينما (ط < MMAP_أقصى)
        إذا (mmap_نشط_تعيين[ط] == 1)
            إذا (mmap_عنوان_ذاكرة[ط] == عنوان)
                إذا (إزاحة >= mmap_حجم_تعيين[ط])
                    ارجع -1  # خارج الحدود
                نهاية
                # تحقق من إذن القراءة
                متغير أعلام_حالية = mmap_أعلام[ط] + 0
                إذا ((أعلام_حالية % 2) == 0)
                    ارجع -1  # لا إذن قراءة
                نهاية
                ارجع fmm_قراءة8(عنوان + إزاحة) + 0
            نهاية
        نهاية
        ط = ط + 1
    نهاية
    ارجع -1
نهاية

## كتابة بايت في تعيين
صدّر دالة fmm_mmap_كتابة(عنوان, إزاحة, قيمه)
    متغير ط = 0
    بينما (ط < MMAP_أقصى)
        إذا (mmap_نشط_تعيين[ط] == 1)
            إذا (mmap_عنوان_ذاكرة[ط] == عنوان)
                إذا (إزاحة >= mmap_حجم_تعيين[ط])
                    ارجع -1
                نهاية
                متغير أعلام_حالية = mmap_أعلام[ط] + 0
                # تحقق إذن الكتابة (bit 1)
                إذا (((أعلام_حالية / 2) % 2) == 0)
                    ارجع -1  # لا إذن كتابة
                نهاية
                fmm_كتابة8(عنوان + إزاحة, قيمه + 0)
                mmap_متسخ[ط] = 1
                ارجع 0
            نهاية
        نهاية
        ط = ط + 1
    نهاية
    ارجع -1
نهاية

