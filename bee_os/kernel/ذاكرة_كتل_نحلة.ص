#* البحث عن كتلة في الذاكرة المؤقتة
   المعاملات: رقم الكتلة، رقم المحرك
   ترجع: فهرس الخانة أو -1 *#
صدّر دالة ذاكرة_كتل_ابحث(رقم_كتلة، رقم_محرك)
    متغير خ = 0
    بينما (خ < 16)
        متغير وض = اقرأ_خ_وضعية(خ)
        إذا (وض != خانة_فارغة)
            متغير كت = اقرأ_خ_كتلة(خ)
            متغير مح = اقرأ_خ_محرك(خ)
            إذا (كت == رقم_كتلة)
                إذا (مح == رقم_محرك)
                    حدّث_وصول(خ)
                    عداد_إصابة = عداد_إصابة + 1
                    ارجع خ
                نهاية
            نهاية
        نهاية
        خ = خ + 1
    نهاية
    عداد_خطأ = عداد_خطأ + 1
    ارجع -1
نهاية

#* إيجاد أقدم خانة (LRU) للاستبدال *#
صدّر دالة ذاكرة_كتل_أقدم()
    متغير أقدم_فهرس = 0
    متغير أقدم_وصول = 999999999
    
    # أولاً: البحث عن خانة فارغة
    متغير خ = 0
    بينما (خ < 16)
        متغير وض = اقرأ_خ_وضعية(خ)
        إذا (وض == خانة_فارغة)
            ارجع خ
        نهاية
        خ = خ + 1
    نهاية
    
    # لا خانة فارغة: البحث عن الأقل استخداماً (غير مقفلة)
    خ = 0
    بينما (خ < 16)
        متغير وض2 = اقرأ_خ_وضعية(خ)
        إذا (وض2 != خانة_مقفلة)
            متغير وص = اقرأ_خ_وصول(خ)
            إذا (وص < أقدم_وصول)
                أقدم_وصول = وص + 0
                أقدم_فهرس = خ + 0
            نهاية
        نهاية
        خ = خ + 1
    نهاية
    
    ارجع أقدم_فهرس
نهاية

#* إضافة كتلة إلى الذاكرة المؤقتة
   المعاملات: رقم الكتلة، رقم المحرك، عنوان البيانات
   ترجع: فهرس الخانة *#
صدّر دالة ذاكرة_كتل_أضف(رقم_كتلة، رقم_محرك، عنوان_بيانات)
    # التحقق من وجود الكتلة بالفعل
    متغير موجود = ذاكرة_كتل_ابحث(رقم_كتلة، رقم_محرك)
    إذا (موجود >= 0)
        ارجع موجود
    نهاية
    
    # إيجاد خانة للاستبدال
    متغير فهرس = ذاكرة_كتل_أقدم()
    
    # إذا كانت الخانة معدلة، يجب مزامنتها أولاً
    متغير وض = اقرأ_خ_وضعية(فهرس)
    إذا (وض == خانة_معدلة)
        عداد_كتابة_قرص = عداد_كتابة_قرص + 1
    نهاية
    
    # إذا كانت خانة فارغة تم ملؤها
    إذا (وض == خانة_فارغة)
        خانات_مستخدمة = خانات_مستخدمة + 1
    نهاية
    
    عداد_ساعة = عداد_ساعة + 1
    اكتب_خانة(فهرس، خانة_نظيفة، رقم_كتلة، رقم_محرك، عداد_ساعة، عنوان_بيانات)
    عداد_قراءة_قرص = عداد_قراءة_قرص + 1
    
    ارجع فهرس
