#* ── قراءة بيانات سمة غير مقيمة من القرص ──
   
   السمات غير المقيمة تُخزن بياناتها خارج سجل MFT
   في كتل على القرص، موصوفة بـ Data Runs.
   
   هذه الدالة تقرأ حتى أقصى_مقاس بايت من البيانات.
   
   المدخلات:
   - رقم_قسم: رقم القسم NTFS
   - عنوان_سمة: عنوان السمة غير المقيمة
   - مخزن: عنوان مخزن الوجهة
   - إزاحة_ملف: الإزاحة من بداية الملف
   - أقصى_مقاس: الحد الأقصى للبايتات
   
   المخرجات:
   - عدد البايتات المقروءة
*#
صدّر دالة نتفس_اقرأ_سمة_غير_مقيمة(رقم_قسم، عنوان_سمة، مخزن، إزاحة_ملف، أقصى_مقاس)
    # تحليل Data Runs
    متغير عدد_ت = نتفس_حلّل_تشغيلات(عنوان_سمة)
    إذا (عدد_ت == 0)
        ارجع 0
    نهاية
    
    متغير مقاس_كتلة = نتفس_مقاس_كتلة(رقم_قسم)
    إذا (مقاس_كتلة == 0)
        ارجع 0
    نهاية
    
    متغير منسوخ = 0
    متغير موقع_ملف = 0
    متغير ع = 0
    
    بينما (ع < عدد_ت)
        متغير بداية_ت = نتفس_تشغيل_بداية(ع)
        متغير عدد_كتل = نتفس_تشغيل_عدد(ع)
        متغير مقاس_تشغيل = عدد_كتل * مقاس_كتلة
        
        # هل الإزاحة المطلوبة في هذا التشغيل؟
        إذا (إزاحة_ملف < موقع_ملف + مقاس_تشغيل)
            # حساب الإزاحة داخل التشغيل
            متغير إزاحة_نسبية = 0
            إذا (إزاحة_ملف > موقع_ملف)
                إزاحة_نسبية = إزاحة_ملف - موقع_ملف
            نهاية
            
            # حساب الكتلة وبايت البداية
            متغير كتلة_فرعية = إزاحة_نسبية / مقاس_كتلة
            متغير بايت_فرعي = إزاحة_نسبية % مقاس_كتلة
            
            # قراءة كتلة بكتلة
            متغير ك = كتلة_فرعية + 0
            بينما (ك < عدد_كتل)
                إذا (منسوخ >= أقصى_مقاس)
                    ارجع منسوخ
                نهاية
                
                # تخصيص مخزن مؤقت للكتلة
                متغير مخزن_ك = kernel_allocate(مقاس_كتلة)
                إذا (مخزن_ك == 0)
                    ارجع منسوخ
                نهاية
                
                نتفس_اقرأ_كتلة(رقم_قسم, بداية_ت + ك, مخزن_ك)
                
                # نسخ البيانات المطلوبة
                متغير بداية_نسخ = 0
                إذا (ك == كتلة_فرعية)
                    بداية_نسخ = بايت_فرعي + 0
                نهاية
                
                متغير متبقي = أقصى_مقاس - منسوخ
                متغير متاح = مقاس_كتلة - بداية_نسخ
                متغير مقاس_نسخ = متبقي + 0
                إذا (مقاس_نسخ > متاح)
                    مقاس_نسخ = متاح + 0
                نهاية
                
                نتفس_انسخ_ذاكرة(مخزن + منسوخ, مخزن_ك + بداية_نسخ, مقاس_نسخ)
                منسوخ = منسوخ + مقاس_نسخ
                
                kernel_free(مخزن_ك)
                ك = ك + 1
            نهاية
        نهاية
        
        موقع_ملف = موقع_ملف + مقاس_تشغيل
        ع = ع + 1
    نهاية
    
    ارجع منسوخ
نهاية

