#* ── تحليل سلسلة Data Runs ──
   
   Data Runs هي تسلسل من "تشغيلات" تصف مواقع
   الكتل على القرص للسمات غير المقيمة.
   
   كل تشغيل مُرمّز كـ:
   ─────────────────────
   بايت الرأس: LLLL_OOOO
   - LLLL (أول 4 بت): عدد بايتات الطول
   - OOOO (آخر 4 بت): عدد بايتات الإزاحة
   
   يليه:
   - L بايتات لطول التشغيل
   - O بايتات لإزاحة التشغيل (signed, relative)
   
   بايت الرأس = 0 يعني نهاية القائمة.
   
   مثال: 0x31 = 3 بايتات إزاحة، 1 بايت طول
   
   المدخلات:
   - عنوان_سمة: عنوان السمة غير المقيمة
   
   المخرجات:
   - عدد التشغيلات المحللة
*#
صدّر دالة نتفس_حلّل_تشغيلات(عنوان_سمة)
    # تصفير التشغيلات السابقة
    عدد_تشغيلات_حالية = 0
    
    # الحصول على إزاحة Data Runs
    متغير إزاحة_تشغيلات = نتفس_اقرأ_16بت(عنوان_سمة + 32)
    متغير موقع = عنوان_سمة + إزاحة_تشغيلات
    
    متغير كتلة_حالية = 0
    
    بينما (عدد_تشغيلات_حالية < 32)
        # قراءة بايت الرأس
        متغير رأس = mem_read_byte(موقع)
        إذا (رأس == 0)
            ارجع عدد_تشغيلات_حالية
        نهاية
        
        # استخراج عدد بايتات الطول والإزاحة
        متغير بايتات_طول = رأس % 16
        متغير بايتات_إزاحة = رأس / 16
        
        موقع = موقع + 1
        
        # قراءة الطول (عدد الكتل)
        متغير طول = 0
        متغير ع_ط = 0
        متغير مضاعف_ط = 1
        بينما (ع_ط < بايتات_طول)
            متغير ب = mem_read_byte(موقع)
            طول = طول + ب * مضاعف_ط
            مضاعف_ط = مضاعف_ط * 256
            موقع = موقع + 1
            ع_ط = ع_ط + 1
        نهاية
        
        # قراءة الإزاحة (signed, relative)
        متغير إزاحة = 0
        متغير ع_إ = 0
        متغير مضاعف_إ = 1
        بينما (ع_إ < بايتات_إزاحة)
            متغير ب_إ = mem_read_byte(موقع)
            إزاحة = إزاحة + ب_إ * مضاعف_إ
            مضاعف_إ = مضاعف_إ * 256
            موقع = موقع + 1
            ع_إ = ع_إ + 1
        نهاية
        
        # تحويل الإزاحة من signed إلى actual
        # إذا كان البت الأعلى مضاءً، فالقيمة سالبة
        إذا (بايتات_إزاحة > 0)
            متغير حد_سالب = مضاعف_إ / 2
            إذا (إزاحة >= حد_سالب)
                إزاحة = إزاحة - مضاعف_إ
            نهاية
        نهاية
        
        # حساب الكتلة المطلقة (الإزاحة نسبية)
        إذا (بايتات_إزاحة > 0)
            كتلة_حالية = كتلة_حالية + إزاحة
        نهاية
        # إذا كانت الإزاحة = 0 بايتات، هذا "sparse run" (كتل فارغة)
        
        # تخزين التشغيل
        متغير ف = عدد_تشغيلات_حالية + 0
        إذا (ف == 0)
            تشغيل_بداية_0 = كتلة_حالية
            تشغيل_عدد_0 = طول
        نهاية
        إذا (ف == 1)
            تشغيل_بداية_1 = كتلة_حالية
            تشغيل_عدد_1 = طول
        نهاية
        إذا (ف == 2)
            تشغيل_بداية_2 = كتلة_حالية
            تشغيل_عدد_2 = طول
        نهاية
        إذا (ف == 3)
            تشغيل_بداية_3 = كتلة_حالية
            تشغيل_عدد_3 = طول
        نهاية
        إذا (ف == 4)
            تشغيل_بداية_4 = كتلة_حالية
            تشغيل_عدد_4 = طول
        نهاية
        إذا (ف == 5)
            تشغيل_بداية_5 = كتلة_حالية
            تشغيل_عدد_5 = طول
        نهاية
        إذا (ف == 6)
            تشغيل_بداية_6 = كتلة_حالية
            تشغيل_عدد_6 = طول
        نهاية
        إذا (ف == 7)
            تشغيل_بداية_7 = كتلة_حالية
            تشغيل_عدد_7 = طول
