#* ── قراءة عدد صحيح 16-بت من الذاكرة (Little Endian) ──
   القيمة تُقرأ كـ: byte0 + byte1 * 256
   
   المدخلات:
   - عنوان: عنوان البايت الأول في الذاكرة
   
   المخرجات:
   - القيمة كعدد صحيح 16-بت
*#
صدّر دالة نتفس_اقرأ_16بت(عنوان)
    متغير ب0 = mem_read_byte(عنوان)
    متغير ب1 = mem_read_byte(عنوان + 1)
    ارجع ب0 + ب1 * 256
نهاية

#* ── قراءة عدد صحيح 32-بت من الذاكرة (Little Endian) ──
   القيمة تُقرأ كـ: b0 + b1*256 + b2*65536 + b3*16777216
   
   المدخلات:
   - عنوان: عنوان البايت الأول
   
   المخرجات:
   - القيمة كعدد صحيح 32-بت
*#
صدّر دالة نتفس_اقرأ_32بت(عنوان)
    متغير ب0 = mem_read_byte(عنوان)
    متغير ب1 = mem_read_byte(عنوان + 1)
    متغير ب2 = mem_read_byte(عنوان + 2)
    متغير ب3 = mem_read_byte(عنوان + 3)
    ارجع ب0 + ب1 * 256 + ب2 * 65536 + ب3 * 16777216
نهاية

#* ── قراءة عدد صحيح 64-بت من الذاكرة (Little Endian) ──
   نقرأ 8 بايتات ونجمعها.
   ملاحظة: لغة ص تستخدم أعداد 64-بت أصلاً.
   
   المدخلات:
   - عنوان: عنوان البايت الأول
   
   المخرجات:
   - القيمة كعدد صحيح 64-بت
*#
صدّر دالة نتفس_اقرأ_64بت(عنوان)
    متغير منخفض = نتفس_اقرأ_32بت(عنوان)
    متغير مرتفع = نتفس_اقرأ_32بت(عنوان + 4)
    ارجع منخفض + مرتفع * 4294967296
نهاية

#* ── كتابة عدد صحيح 16-بت إلى الذاكرة (Little Endian) ── *#
صدّر دالة نتفس_اكتب_16بت(عنوان، قيمة)
    متغير ق = قيمة + 0
    mem_write_byte(عنوان, ق % 256)
    ق = ق / 256
    mem_write_byte(عنوان + 1, ق % 256)
    ارجع 0
نهاية

#* ── كتابة عدد صحيح 32-بت إلى الذاكرة (Little Endian) ── *#
صدّر دالة نتفس_اكتب_32بت(عنوان، قيمة)
    متغير ق = قيمة + 0
    mem_write_byte(عنوان, ق % 256)
    ق = ق / 256
    mem_write_byte(عنوان + 1, ق % 256)
    ق = ق / 256
    mem_write_byte(عنوان + 2, ق % 256)
    ق = ق / 256
    mem_write_byte(عنوان + 3, ق % 256)
    ارجع 0
نهاية

#* ── نسخ كتلة من الذاكرة ──
   نسخ عدد معين من البايتات من عنوان المصدر
   إلى عنوان الوجهة.
   
   المدخلات:
   - وجهة: عنوان الوجهة
   - مصدر: عنوان المصدر
   - عدد: عدد البايتات المراد نسخها
*#
صدّر دالة نتفس_انسخ_ذاكرة(وجهة، مصدر، عدد)
    متغير ع = 0
    بينما (ع < عدد)
        متغير ب = mem_read_byte(مصدر + ع)
        mem_write_byte(وجهة + ع, ب)
        ع = ع + 1
    نهاية
    ارجع عدد
نهاية

#* ── مسح (تصفير) كتلة من الذاكرة ── *#
صدّر دالة نتفس_صفّر_ذاكرة(عنوان، عدد)
    متغير ع = 0
    بينما (ع < عدد)
        mem_write_byte(عنوان + ع, 0)
        ع = ع + 1
    نهاية
    ارجع 0
نهاية

#* ── مقارنة كتلتي ذاكرة ──
   ترجع 1 إذا كانتا متطابقتين، 0 إذا لم تكونا.
*#
صدّر دالة نتفس_قارن_ذاكرة(عنوان1، عنوان2، عدد)
    متغير ع = 0
    بينما (ع < عدد)
        متغير ب1 = mem_read_byte(عنوان1 + ع)
        متغير ب2 = mem_read_byte(عنوان2 + ع)
        إذا (ب1 != ب2)
            ارجع 0
        نهاية
        ع = ع + 1
    نهاية
    ارجع 1
نهاية

