#* ── البحث عن سمة بنوع معين في سجل MFT ──
   
   يبحث في سجل MFT محمّل عن سمة من نوع معين.
   يتنقل عبر قائمة السمات المتسلسلة.
   
   المدخلات:
   - عنوان_سجل: عنوان سجل MFT في الذاكرة
   - نوع_سمة: نوع السمة المطلوبة (مثل سمة_بيانات = 0x80)
   
   المخرجات:
   - عنوان بداية السمة إذا وُجدت (> 0)
   - 0 إذا لم تُوجد
*#
صدّر دالة نتفس_ابحث_سمة(عنوان_سجل، نوع_سمة)
    # الحصول على إزاحة أول سمة
    متغير إزاحة = نتفس_اقرأ_16بت(عنوان_سجل + 20)
    متغير مقاس_مستخدم = نتفس_اقرأ_32بت(عنوان_سجل + 24)
    
    # ── التنقل عبر السمات ──
    بينما (إزاحة < مقاس_مستخدم)
        متغير عنوان_سمة = عنوان_سجل + إزاحة
        متغير ص_ق_سمة = نتفس_اقرأ_32بت(عنوان_سمة)
        
        # التحقق من نهاية قائمة السمات
        إذا (ص_ق_سمة == 4294967295)
            ارجع 0
        نهاية
        
        # التحقق من صفر (نهاية غير عادية)
        إذا (ص_ق_سمة == 0)
            ارجع 0
        نهاية
        
        # هل وجدنا السمة المطلوبة؟
        إذا (ص_ق_سمة == نوع_سمة)
            ارجع عنوان_سمة
        نهاية
        
        # الانتقال إلى السمة التالية
        متغير طول_سمة = نتفس_اقرأ_32بت(عنوان_سمة + 4)
        إذا (طول_سمة == 0)
            ارجع 0
        نهاية
        إزاحة = إزاحة + طول_سمة
    نهاية
    
    ارجع 0
نهاية

