# القسم 6: دوال قراءة BPB (BIOS Parameter Block)
# ══════════════════════════════════════════════

#* ── قراءة سجل التمهيد (Boot Record) لقسم NTFS ──
   
   يقرأ القطاع الأول من قسم NTFS ويحلل بيانات BPB.
   
   بنية القطاع التمهيدي لـ NTFS:
   ─────────────────────────────────
   الإزاحة  الحجم  الوصف
   0x00     3      تعليمة القفز
   0x03     8      OEM ID ("NTFS    ")
   0x0B     2      بايتات لكل قطاع
   0x0D     1      قطاعات لكل كتلة
   0x0E     2      قطاعات محجوزة (0 دائماً)
   0x10     3      صفر دائماً
   0x13     2      غير مستخدم (0)
   0x15     1      واصف الوسيط (0xF8 عادة)
   0x16     2      صفر دائماً
   0x18     2      قطاعات لكل مسار
   0x1A     2      عدد الرؤوس
   0x1C     4      قطاعات مخفية
   0x20     4      غير مستخدم
   0x24     4      غير مستخدم (0x80008000 عادة)
   0x28     8      إجمالي القطاعات
   0x30     8      رقم كتلة بداية MFT
   0x38     8      رقم كتلة بداية نسخة MFT
   0x40     4      حجم سجل MFT (أو أس 2 إذا سالب)
   0x44     4      حجم كتلة الفهرس (أو أس 2 إذا سالب)
   0x48     8      الرقم التسلسلي للقسم
   
   المدخلات:
   - رقم_قرص: رقم القرص (عادة 0)
   - قطاع_بداية: رقم القطاع الأول للقسم
   
   المخرجات:
   - 0 = نجاح
   - -1 = فشل (ليس قسم NTFS أو خطأ في القراءة)
*#
صدّر دالة نتفس_اقرأ_تمهيد(رقم_قرص، قطاع_بداية)
    # ── التحقق من عدد الأقسام المكتشفة ──
    إذا (عدد_أقسام_نتفس >= اقصى_أقسام_نتفس)
        kernel_print_string("  [NTFS] ERROR: max partitions reached")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    # ── تخصيص ذاكرة لقراءة القطاع ──
    متغير مخزن = kernel_allocate(مقاس_قطاع)
    إذا (مخزن == 0)
        kernel_print_string("  [NTFS] ERROR: cannot allocate boot sector buffer")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    # ── قراءة القطاع التمهيدي من القرص ──
    disk_read_sector(رقم_قرص, قطاع_بداية, مخزن)
    
    # ── التحقق من توقيع NTFS ──
    # في الإزاحة 0x03 يجب أن نجد "NTFS" (4 بايتات على الأقل)
    متغير ت0 = mem_read_byte(مخزن + 3)
    متغير ت1 = mem_read_byte(مخزن + 4)
    متغير ت2 = mem_read_byte(مخزن + 5)
    متغير ت3 = mem_read_byte(مخزن + 6)
    
    # "NTFS" = 0x4E, 0x54, 0x46, 0x53
    إذا (ت0 != 78)
        kernel_print_string("  [NTFS] Not an NTFS partition (bad signature at byte 0)")
        kernel_print_number(10)
        kernel_free(مخزن)
        ارجع -1
    نهاية
    إذا (ت1 != 84)
        kernel_print_string("  [NTFS] Not an NTFS partition (bad signature at byte 1)")
        kernel_print_number(10)
        kernel_free(مخزن)
        ارجع -1
    نهاية
    إذا (ت2 != 70)
        kernel_print_string("  [NTFS] Not an NTFS partition (bad signature at byte 2)")
        kernel_print_number(10)
        kernel_free(مخزن)
        ارجع -1
    نهاية
    إذا (ت3 != 83)
        kernel_print_string("  [NTFS] Not an NTFS partition (bad signature at byte 3)")
        kernel_print_number(10)
        kernel_free(مخزن)
        ارجع -1
    نهاية
    
    # ── قراءة بارامترات BPB ──
    متغير بايتات_قطاع = نتفس_اقرأ_16بت(مخزن + 11)
    متغير قطاعات_كتلة = mem_read_byte(مخزن + 13)
    متغير اجمالي_قطاعات = نتفس_اقرأ_64بت(مخزن + 40)
    متغير كتلة_مفت = نتفس_اقرأ_64بت(مخزن + 48)
    متغير كتلة_نسخة = نتفس_اقرأ_64بت(مخزن + 56)
    
    # ── حساب حجم سجل MFT ──
    # إذا كانت القيمة في الإزاحة 0x40 سالبة (> 127 كبايت)
    # فالحجم الحقيقي = 2^(256 - القيمة)
    متغير مقاس_سجل_خام = mem_read_byte(مخزن + 64)
    متغير مقاس_سجل_فعلي = 0
    إذا (مقاس_سجل_خام > 127)
        # القيمة سالبة — نحسب كأس لـ 2
        متغير أس = 256 - مقاس_سجل_خام
        مقاس_سجل_فعلي = 1
        متغير عد_أس = 0
        بينما (عد_أس < أس)
            مقاس_سجل_فعلي = مقاس_سجل_فعلي * 2
            عد_أس = عد_أس + 1
        نهاية
    وإلا
        مقاس_سجل_فعلي = مقاس_سجل_خام * قطاعات_كتلة * بايتات_قطاع
    نهاية
    
    # ── حساب حجم كتلة الفهرس ──
    متغير مقاس_فهرس_خام = mem_read_byte(مخزن + 68)
    متغير مقاس_فهرس_فعلي = 0
    إذا (مقاس_فهرس_خام > 127)
        متغير أس2 = 256 - مقاس_فهرس_خام
        مقاس_فهرس_فعلي = 1
        متغير عد2 = 0
        بينما (عد2 < أس2)
            مقاس_فهرس_فعلي = مقاس_فهرس_فعلي * 2
            عد2 = عد2 + 1
        نهاية
    وإلا
        مقاس_فهرس_فعلي = مقاس_فهرس_خام * قطاعات_كتلة * بايتات_قطاع
    نهاية
    
    # ── الرقم التسلسلي ──
    متغير رقم_تسلسلي = نتفس_اقرأ_64بت(مخزن + 72)
    
    # ── حجم الكتلة بالبايت ──
    متغير مقاس_كتلة = قطاعات_كتلة * بايتات_قطاع
    
    # ── حفظ البيانات في المتغيرات حسب رقم القسم ──
    متغير ق = عدد_أقسام_نتفس + 0
    
    إذا (ق == 0)
        ن_بايتات_قطاع_0 = بايتات_قطاع
        ن_قطاعات_كتلة_0 = قطاعات_كتلة
        ن_اجمالي_قطاعات_0 = اجمالي_قطاعات
        ن_كتلة_مفت_بداية_0 = كتلة_مفت
        ن_كتلة_نسخة_مفت_0 = كتلة_نسخة
        ن_مقاس_سجل_مفت_0 = مقاس_سجل_فعلي
        ن_مقاس_كتلة_فهرس_0 = مقاس_فهرس_فعلي
        ن_رقم_تسلسلي_0 = رقم_تسلسلي
        ن_قطاع_بداية_0 = قطاع_بداية
        ن_مفعّل_0 = 1
        ن_مقاس_كتلة_0 = مقاس_كتلة
    نهاية
    إذا (ق == 1)
        ن_بايتات_قطاع_1 = بايتات_قطاع
        ن_قطاعات_كتلة_1 = قطاعات_كتلة
        ن_اجمالي_قطاعات_1 = اجمالي_قطاعات
        ن_كتلة_مفت_بداية_1 = كتلة_مفت
        ن_كتلة_نسخة_مفت_1 = كتلة_نسخة
        ن_مقاس_سجل_مفت_1 = مقاس_سجل_فعلي
        ن_مقاس_كتلة_فهرس_1 = مقاس_فهرس_فعلي
        ن_رقم_تسلسلي_1 = رقم_تسلسلي
        ن_قطاع_بداية_1 = قطاع_بداية
        ن_مفعّل_1 = 1
        ن_مقاس_كتلة_1 = مقاس_كتلة
    نهاية
    إذا (ق == 2)
        ن_بايتات_قطاع_2 = بايتات_قطاع
        ن_قطاعات_كتلة_2 = قطاعات_كتلة
        ن_اجمالي_قطاعات_2 = اجمالي_قطاعات
        ن_كتلة_مفت_بداية_2 = كتلة_مفت
        ن_كتلة_نسخة_مفت_2 = كتلة_نسخة
        ن_مقاس_سجل_مفت_2 = مقاس_سجل_فعلي
        ن_مقاس_كتلة_فهرس_2 = مقاس_فهرس_فعلي
        ن_رقم_تسلسلي_2 = رقم_تسلسلي
        ن_قطاع_بداية_2 = قطاع_بداية
        ن_مفعّل_2 = 1
        ن_مقاس_كتلة_2 = مقاس_كتلة
    نهاية
    إذا (ق == 3)
        ن_بايتات_قطاع_3 = بايتات_قطاع
        ن_قطاعات_كتلة_3 = قطاعات_كتلة
        ن_اجمالي_قطاعات_3 = اجمالي_قطاعات
