# القسم 9: تحميل وتحليل سجلات MFT
# ══════════════════════════════════════════════

#* ── تحميل سجل MFT من القرص ──
   
   يقرأ سجل MFT ويتحقق من توقيعه ويحلل رأسه.
   
   بنية رأس سجل MFT:
   ──────────────────
   الإزاحة  الحجم  الوصف
   0x00     4      توقيع "FILE" (0x454C4946)
   0x04     2      إزاحة مصفوفة التحديث (Update Sequence)
   0x06     2      حجم مصفوفة التحديث بالكلمات
   0x08     8      رقم تسلسل السجل ($LogFile)
   0x10     2      رقم التسلسل
   0x12     2      عدد الروابط الصلبة
   0x14     2      إزاحة أول سمة
   0x16     2      أعلام السجل
   0x18     4      الحجم المستخدم
   0x1C     4      الحجم المخصص
   0x20     8      رقم السجل الأساسي (للامتدادات)
   0x28     2      معرف السمة التالية
   0x2A     2      محاذاة
   0x2C     4      رقم سجل MFT (NTFS 3.1+)
   
   المدخلات:
   - رقم_قسم: رقم القسم NTFS
   - رقم_سجل: رقم سجل MFT المراد تحميله
   
   المخرجات:
   - عنوان بداية السجل في الذاكرة (> 0 = نجاح)
   - 0 = فشل
*#
صدّر دالة نتفس_حمّل_سجل(رقم_قسم، رقم_سجل)
    # ── التحقق من الذاكرة المؤقتة أولاً ──
    متغير عنوان_مخزن = نتفس_ابحث_سجل_مخزّن(رقم_قسم, رقم_سجل)
    إذا (عنوان_مخزن > 0)
        ارجع عنوان_مخزن
    نهاية
    
    # ── حساب موقع السجل على القرص ──
    متغير كتلة_مفت = نتفس_كتلة_مفت(رقم_قسم)
    متغير مقاس_سجل = نتفس_مقاس_سجل(رقم_قسم)
    متغير مقاس_كتلة = نتفس_مقاس_كتلة(رقم_قسم)
    
    إذا (مقاس_كتلة == 0)
        kernel_print_string("  [NTFS] ERROR: cluster size is 0")
        kernel_print_number(10)
        ارجع 0
    نهاية
    إذا (مقاس_سجل == 0)
        kernel_print_string("  [NTFS] ERROR: MFT record size is 0")
        kernel_print_number(10)
        ارجع 0
    نهاية
    
    # حساب الكتلة والإزاحة داخل الكتلة
    متغير بايت_مطلق = رقم_سجل * مقاس_سجل
    متغير كتلة_هدف = كتلة_مفت + بايت_مطلق / مقاس_كتلة
    متغير إزاحة_داخلية = بايت_مطلق % مقاس_كتلة
    
    # ── تخصيص ذاكرة للسجل ──
    متغير ذاكرة_سجل = kernel_allocate(مقاس_سجل)
    إذا (ذاكرة_سجل == 0)
        kernel_print_string("  [NTFS] ERROR: cannot allocate MFT record memory")
        kernel_print_number(10)
        ارجع 0
    نهاية
    
    # ── قراءة البيانات من القرص ──
    # نحتاج لقراءة كتلة كاملة ثم نسخ السجل منها
    متغير ذاكرة_كتلة = kernel_allocate(مقاس_كتلة)
    إذا (ذاكرة_كتلة == 0)
        kernel_free(ذاكرة_سجل)
        ارجع 0
    نهاية
    
    نتفس_اقرأ_كتلة(رقم_قسم, كتلة_هدف, ذاكرة_كتلة)
    
    # نسخ السجل من الكتلة
    نتفس_انسخ_ذاكرة(ذاكرة_سجل, ذاكرة_كتلة + إزاحة_داخلية, مقاس_سجل)
    kernel_free(ذاكرة_كتلة)
    
    # ── التحقق من توقيع "FILE" ──
    متغير توقيع = نتفس_اقرأ_32بت(ذاكرة_سجل)
    إذا (توقيع != توقيع_سجل_ملف)
        kernel_print_string("  [NTFS] ERROR: bad MFT record signature for record #")
        kernel_print_number(رقم_سجل)
        kernel_print_number(10)
        kernel_free(ذاكرة_سجل)
        ارجع 0
    نهاية
    
    # ── تطبيق تصحيح مصفوفة التحديث (Fixup Array) ──
    متغير إزاحة_تحديث = نتفس_اقرأ_16بت(ذاكرة_سجل + 4)
    متغير عدد_تحديث = نتفس_اقرأ_16بت(ذاكرة_سجل + 6)
    
    إذا (عدد_تحديث > 1)
        متغير قيمة_أصلية = نتفس_اقرأ_16بت(ذاكرة_سجل + إزاحة_تحديث)
        متغير ت = 1
        بينما (ت < عدد_تحديث)
            متغير موقع_تصحيح = ت * 512 - 2
            إذا (موقع_تصحيح < مقاس_سجل)
                # التحقق من أن آخر بايتين في كل قطاع يطابقان قيمة التحقق
                متغير قيمة_موجودة = نتفس_اقرأ_16بت(ذاكرة_سجل + موقع_تصحيح)
                # استبدال بالقيمة الحقيقية من مصفوفة التحديث
                متغير قيمة_حقيقية = نتفس_اقرأ_16بت(ذاكرة_سجل + إزاحة_تحديث + ت * 2)
                نتفس_اكتب_16بت(ذاكرة_سجل + موقع_تصحيح, قيمة_حقيقية)
            نهاية
            ت = ت + 1
        نهاية
    نهاية
    
    # ── تخزين معلومات السجل في الذاكرة المؤقتة ──
    متغير أعلام = نتفس_اقرأ_16بت(ذاكرة_سجل + 22)
    متغير تسلسل = نتفس_اقرأ_16بت(ذاكرة_سجل + 16)
    متغير إز_سمة = نتفس_اقرأ_16بت(ذاكرة_سجل + 20)
    متغير مستخدم = نتفس_اقرأ_32بت(ذاكرة_سجل + 24)
    متغير مخصص = نتفس_اقرأ_32بت(ذاكرة_سجل + 28)
    متغير أساسي = نتفس_اقرأ_64بت(ذاكرة_سجل + 32)
    
    نتفس_خزّن_سجل(رقم_قسم, رقم_سجل, ذاكرة_سجل, أعلام, تسلسل, إز_سمة, مستخدم, مخصص, أساسي)
    
    # ── تحديث الإحصائيات ──
    إذا (رقم_قسم == 0)
        إحصاء_سجلات_محملة_0 = إحصاء_سجلات_محملة_0 + 1
    نهاية
    إذا (رقم_قسم == 1)
        إحصاء_سجلات_محملة_1 = إحصاء_سجلات_محملة_1 + 1
    نهاية
    إذا (رقم_قسم == 2)
        إحصاء_سجلات_محملة_2 = إحصاء_سجلات_محملة_2 + 1
    نهاية
    إذا (رقم_قسم == 3)
        إحصاء_سجلات_محملة_3 = إحصاء_سجلات_محملة_3 + 1
    نهاية
    
    ارجع ذاكرة_سجل
