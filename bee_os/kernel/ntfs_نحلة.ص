#* ── قراءة بيانات ملف من سجل MFT ──
   
   يقرأ بيانات سمة $DATA (0x80).
   يدعم كلاً من السمات المقيمة وغير المقيمة.
   
   المدخلات:
   - رقم_قسم: رقم القسم NTFS
   - عنوان_سجل: عنوان سجل MFT المحمّل
   - مخزن: عنوان مخزن الوجهة
   - إزاحة: إزاحة البداية في الملف
   - مقاس: عدد البايتات المراد قراءتها
   
   المخرجات:
   - عدد البايتات المقروءة فعلاً
*#
صدّر دالة نتفس_اقرأ_بيانات(رقم_قسم، عنوان_سجل، مخزن، إزاحة، مقاس)
    # البحث عن سمة $DATA
    متغير عنوان_سمة = نتفس_ابحث_سمة(عنوان_سجل, سمة_بيانات)
    إذا (عنوان_سمة == 0)
        kernel_print_string("  [NTFS] No $DATA attribute found")
        kernel_print_number(10)
        ارجع 0
    نهاية
    
    # التحقق: مقيمة أم غير مقيمة
    متغير غير_مقيمة = mem_read_byte(عنوان_سمة + 8)
    
    إذا (غير_مقيمة == 0)
        # ── سمة مقيمة ──
        متغير طول_بيانات = نتفس_اقرأ_32بت(عنوان_سمة + 16)
        متغير إزاحة_بيانات = نتفس_اقرأ_16بت(عنوان_سمة + 20)
        
        إذا (إزاحة >= طول_بيانات)
            ارجع 0
        نهاية
        
        متغير متاح = طول_بيانات - إزاحة
        متغير مقاس_نسخ = مقاس + 0
        إذا (مقاس_نسخ > متاح)
            مقاس_نسخ = متاح + 0
        نهاية
        
        نتفس_انسخ_ذاكرة(مخزن, عنوان_سمة + إزاحة_بيانات + إزاحة, مقاس_نسخ)
        ارجع مقاس_نسخ
