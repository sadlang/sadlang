#* ── التحقق من سلامة سجل MFT ──
   يتحقق من أن سجل MFT صالح.
   هذا يشمل التحقق من:
   1. توقيع "FILE"
   2. أعلام مستخدم
   3. إزاحة أول سمة معقولة
   4. حجم مستخدم <= حجم مخصص
*#
صدّر دالة نتفس_تحقق_سجل(عنوان_سجل)
    # 1. التحقق من التوقيع
    متغير توقيع = نتفس_اقرأ_32بت(عنوان_سجل)
    إذا (توقيع != توقيع_سجل_ملف)
        kernel_print_string("  [NTFS] Integrity: bad signature")
        kernel_print_number(10)
        ارجع 0
    نهاية
    
    # 2. التحقق من الأعلام
    متغير أعلام = نتفس_اقرأ_16بت(عنوان_سجل + 22)
    إذا (أعلام % 2 == 0)
        # السجل غير مستخدم — ليس خطأ بالضرورة
        ارجع 1
    نهاية
    
    # 3. إزاحة أول سمة
    متغير إز_سمة = نتفس_اقرأ_16بت(عنوان_سجل + 20)
    إذا (إز_سمة < 42)
        kernel_print_string("  [NTFS] Integrity: attribute offset too small")
        kernel_print_number(10)
        ارجع 0
    نهاية
    
    # 4. حجم مستخدم <= حجم مخصص
    متغير مستخدم = نتفس_اقرأ_32بت(عنوان_سجل + 24)
    متغير مخصص = نتفس_اقرأ_32بت(عنوان_سجل + 28)
    إذا (مستخدم > مخصص)
        kernel_print_string("  [NTFS] Integrity: used > allocated")
        kernel_print_number(10)
        ارجع 0
    نهاية
    
    ارجع 1
نهاية

