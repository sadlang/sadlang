# ═══════════════════════════════════════════════════════════════════════════════
# وحدة مخصص الشرائح (Slab Allocator) — نظام نحلة (BeeOS)
# الملف: مخصص_شرائح_نحلة.ص
# الوظيفة: تخصيص كائنات النواة ذات الأحجام الثابتة بكفاءة عالية
# الترتيب: __sad_init_87
# ═══════════════════════════════════════════════════════════════════════════════
#
# نظرية مخصص الشرائح (Slab Allocator Theory):
# ═══════════════════════════════════════════════
# صمم Jeff Bonwick مخصص الشرائح لنواة SunOS 5.4 عام 1994، ثم تبنّاه Linux.
# الفكرة الأساسية:
#   - النواة تخصص وتحرر كائنات من أنواع متكررة (مثل: واصفات العمليات،
#     مدخلات الملفات، عقد i-node...) بأحجام ثابتة.
#   - بدلاً من استدعاء مخصص عام (malloc) كل مرة — مما يسبب تجزئة —
#     نُنشئ "ذاكرة مؤقتة" (cache) لكل حجم كائن.
#   - كل ذاكرة مؤقتة تتكون من "شرائح" (slabs)، وكل شريحة هي صفحة أو
#     مجموعة صفحات متتالية تحتوي على عدة كائنات بنفس الحجم.
#   - الكائنات المحررة لا تُعاد للنظام فوراً، بل تبقى في قائمة حرة
#     داخل الشريحة لإعادة استخدامها بسرعة.
#
# هيكل الذاكرة المؤقتة (Cache):
# ┌─────────────────────────────────────────────────────┐
# │ الذاكرة المؤقتة (Cache)                              │
# │  - مقاس الكائن (32, 64, 128, 256, 512)              │
# │  - عدد الصفحات لكل شريحة                            │
# │  - قوائم الشرائح: فارغة، جزئية، ممتلئة              │
# ├──────────────┬──────────────┬─────────────────────────┤
# │  شريحة فارغة │ شريحة جزئية │  شريحة ممتلئة           │
# │  (كل الكائنات│ (بعض الكائنات│ (لا كائنات حرة)         │
# │   حرة)       │  حرة)       │                         │
# ├──────────────┴──────────────┴─────────────────────────┤
# │ بنية الشريحة الواحدة:                                │
# │ ┌───────────────────────────────────────────┐        │
# │ │ رأس الشريحة:                              │        │
# │ │  - عنوان بداية البيانات                   │        │
# │ │  - فهرس الذاكرة المؤقتة                   │        │
# │ │  - عدد الكائنات الحرة                     │        │
# │ │  - عدد الكائنات الكلي                     │        │
# │ │  - عنوان قائمة الكائنات الحرة             │        │
# │ │  - اللون (color) لتحسين أداء المخبأ       │        │
# │ ├───────────────────────────────────────────┤        │
# │ │ [كائن 0] [كائن 1] [كائن 2] ... [كائن N]  │        │
# │ └───────────────────────────────────────────┘        │
# └──────────────────────────────────────────────────────┘
#
# تلوين الشريحة (Slab Coloring):
# ────────────────────────────────
# عندما تكون عدة شرائح محمّلة في المخبأ (CPU cache)، قد تتصادم عناوينها
# على نفس أسطر المخبأ. لتجنب ذلك، نُضيف إزاحة (لون) مختلفة لكل شريحة
# بحيث تتوزع الكائنات على أسطر مخبأ مختلفة.
#
# الأحجام المدعومة: 32, 64, 128, 256, 512 بايت
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# التصريحات الخارجية (FFI)
# ═══════════════════════════════════════════════════════════════════════════════
خارجي دالة kernel_print_string(عنوان_سلسلة)
خارجي دالة kernel_print_number(قيمة)
خارجي دالة mem_read_dword(عنوان)
خارجي دالة mem_write_dword(عنوان، قيمة)
خارجي دالة sad_ll_memset(عنوان، قيمة، طول)
خارجي دالة sad_ll_memcpy(وجهة، مصدر، طول)
خارجي دالة sad_ll_page_alloc()
خارجي دالة sad_ll_page_free(عنوان)

