        kernel_print_string("\n")
        فهرس_شريحة = تنمية_ذاكرة_مؤقتة(فهرس_ذ_م)
        إذا (فهرس_شريحة < 0)
            kernel_print_string("[شرائح] فشل التنمية!\n")
            عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
            ارجع 0
        نهاية
