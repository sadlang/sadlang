# ═══════════════════════════════════════════════════════════════════════════════
# تحرير كائن — إعادته للذاكرة المؤقتة
# ═══════════════════════════════════════════════════════════════════════════════

# تحديد الشريحة والكائن من عنوان معين
# تُرجع فهرس الذاكرة المؤقتة عبر الإسناد، أو -1 عند الفشل
دالة بحث_شريحة_بعنوان(عنوان_الكائن)
    # البحث في جميع الذاكرات المؤقتة والشرائح
    متغير ذم = 0
    بينما (ذم < ثابت_عدد_أحجام)
        متغير نشطة = قراءة_حقل(عنوان_نشاط، ذم)
        إذا (نشطة == 1)
            متغير مقاس_ك = قراءة_حقل(عنوان_مقاسات_ذ_م، ذم)
            متغير صفحات_ش = قراءة_حقل(عنوان_صفحات_ذ_م، ذم)
            متغير مقاس_شريحة = صفحات_ش * ثابت_مقاس_صفحة

            متغير ش = 0
            بينما (ش < ثابت_اقصى_شرائح)
                متغير وصف = قراءة_حقل_شريحة(ذم، ش، 6)
                # فحص الشرائح النشطة فقط
                إذا (وصف == وضعية_شريحة_جزئية)
                    متغير بداية = قراءة_حقل_شريحة(ذم، ش، 0)
                    متغير نهاية_شريحة = بداية + مقاس_شريحة
                    # هل العنوان ضمن هذه الشريحة؟
                    إذا (عنوان_الكائن >= بداية)
                        إذا (عنوان_الكائن < نهاية_شريحة)
                            # وجدنا الشريحة — نُرجع معلومات مُشفرة
                            # نُشفر: فهرس_ذ_م × 1000 + فهرس_شريحة
                            ارجع ذم * 1000 + ش
                        نهاية
                    نهاية
                نهاية
                إذا (وصف == وضعية_شريحة_ممتلئة)
                    متغير بداية2 = قراءة_حقل_شريحة(ذم، ش، 0)
                    متغير نهاية2 = بداية2 + مقاس_شريحة
                    إذا (عنوان_الكائن >= بداية2)
