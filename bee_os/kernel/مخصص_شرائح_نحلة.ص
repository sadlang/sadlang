        kernel_print_string("[شرائح] فشل تخصيص ذاكرة!\n")
        ارجع -1
    نهاية
    sad_ll_memset(عنوان_مقاسات_ذ_م، 0، ثابت_مقاس_صفحة)

    # باقي المصفوفات بعد مصفوفة المقاسات في نفس الصفحة
    عنوان_صفحات_ذ_م = عنوان_مقاسات_ذ_م + مقاس_مصفوفة_ذ_م
    عنوان_كائنات_لكل_شريحة = عنوان_صفحات_ذ_م + مقاس_مصفوفة_ذ_م
    عنوان_عدد_شرائح = عنوان_كائنات_لكل_شريحة + مقاس_مصفوفة_ذ_م
    عنوان_شرائح_حرة = عنوان_عدد_شرائح + مقاس_مصفوفة_ذ_م
    عنوان_شرائح_جزئية_عدد = عنوان_شرائح_حرة + مقاس_مصفوفة_ذ_م
    عنوان_شرائح_ممتلئة_عدد = عنوان_شرائح_جزئية_عدد + مقاس_مصفوفة_ذ_م
    عنوان_لون_تالي = عنوان_شرائح_ممتلئة_عدد + مقاس_مصفوفة_ذ_م
    عنوان_اقصى_لون = عنوان_لون_تالي + مقاس_مصفوفة_ذ_م
    عنوان_نشاط = عنوان_اقصى_لون + مقاس_مصفوفة_ذ_م

    # ─── تخصيص مصفوفة الشرائح ───
    # ثابت_اقصى_ذاكرات_مؤقتة × ثابت_اقصى_شرائح × ثابت_مقاس_رأس_شريحة
    # = 8 × 64 × 32 = 16384 بايت = 4 صفحات
    متغير مقاس_شرائح = ثابت_اقصى_ذاكرات_مؤقتة * ثابت_اقصى_شرائح * ثابت_مقاس_رأس_شريحة
    متغير صفحات_مطلوبة = (مقاس_شرائح + ثابت_مقاس_صفحة - 1) / ثابت_مقاس_صفحة

    عنوان_شرائح = sad_ll_page_alloc()
    إذا (عنوان_شرائح == 0)
        kernel_print_string("[شرائح] فشل تخصيص مصفوفة الشرائح!\n")
        ارجع -1
    نهاية
    # تخصيص صفحات إضافية إذا لزم
    متغير ص = 1
