# ═══════════════════════════════════════════════════════════════════════════════
# تخصيص كائن من الذاكرة المؤقتة
# ═══════════════════════════════════════════════════════════════════════════════

# تخصيص كائن من شريحة محددة
# تُرجع عنوان الكائن المخصص أو 0 عند الفشل
دالة تخصيص_من_شريحة(فهرس_ذ_م، فهرس_شريحة)
    # قراءة معلومات الشريحة
    متغير عنوان_بيانات = قراءة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، 0)
    متغير عدد_حرة = قراءة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، 2)
    متغير عدد_كلي = قراءة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، 3)
    متغير إزاحة_لون = قراءة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، 5)
    متغير مقاس_كائن = قراءة_حقل(عنوان_مقاسات_ذ_م، فهرس_ذ_م)

    إذا (عدد_حرة == 0)
        ارجع 0
    نهاية

    # البحث عن أول كائن حر في الخريطة البتية
    متغير عنوان_خريطة = عنوان_خريطة_شريحة(فهرس_ذ_م، فهرس_شريحة)
    متغير ك = 0
    بينما (ك < عدد_كلي)
        متغير مخصص = فحص_بت_خريطة(عنوان_خريطة، ك)
        إذا (مخصص == 0)
            # وجدنا كائناً حراً — نخصصه
            ضبط_بت_خريطة(عنوان_خريطة، ك)

            # حساب عنوان الكائن
            # عنوان = بداية_بيانات + إزاحة_لون + (فهرس × مقاس)
            متغير عنوان_كائن = عنوان_بيانات + إزاحة_لون + (ك * مقاس_كائن)

            # تحديث عدد الكائنات الحرة
            عدد_حرة = عدد_حرة - 1
            كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، 2، عدد_حرة)

            # تحديث وضعية الشريحة
            إذا (عدد_حرة == 0)
                # أصبحت ممتلئة
                كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، 6، وضعية_شريحة_ممتلئة)
                # تحديث العدادات
                متغير كانت_وضعية = قراءة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، 6)
                متغير ممتلئة_ع = قراءة_حقل(عنوان_شرائح_ممتلئة_عدد، فهرس_ذ_م)
                كتابة_حقل(عنوان_شرائح_ممتلئة_عدد، فهرس_ذ_م، ممتلئة_ع + 1)
                متغير جزئية_ع = قراءة_حقل(عنوان_شرائح_جزئية_عدد، فهرس_ذ_م)
                إذا (جزئية_ع > 0)
                    كتابة_حقل(عنوان_شرائح_جزئية_عدد، فهرس_ذ_م، جزئية_ع - 1)
                نهاية
            وإلا
                # أصبحت جزئية (إذا كانت فارغة)
                متغير وضع_حالي = قراءة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، 6)
                إذا (وضع_حالي == وضعية_شريحة_حرة)
                    كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، 6، وضعية_شريحة_جزئية)
                    متغير حرة_ع = قراءة_حقل(عنوان_شرائح_حرة، فهرس_ذ_م)
                    إذا (حرة_ع > 0)
                        كتابة_حقل(عنوان_شرائح_حرة، فهرس_ذ_م، حرة_ع - 1)
                    نهاية
                    متغير جزئية_ع2 = قراءة_حقل(عنوان_شرائح_جزئية_عدد، فهرس_ذ_م)
                    كتابة_حقل(عنوان_شرائح_جزئية_عدد، فهرس_ذ_م، جزئية_ع2 + 1)
                نهاية
            نهاية

            # تحديث الإحصائيات
            عداد_تخصيص = عداد_تخصيص + 1
            إجمالي_كائنات_نشطة = إجمالي_كائنات_نشطة + 1

            ارجع عنوان_كائن
        نهاية
        ك = ك + 1
    نهاية

    ارجع 0
نهاية

# تخصيص كائن بمقاس محدد
# هذه هي الدالة العامة الرئيسية للتخصيص
# تُرجع عنوان الكائن المخصص أو 0 عند الفشل
دالة تخصيص_كائن(المقاس)
    إذا (تم_التهيئة == 0)
