    # ─── تخصيص مصفوفات الذاكرات المؤقتة ───
    kernel_print_string("[شرائح] تخصيص هياكل البيانات...\n")

    # كل مصفوفة: ثابت_اقصى_ذاكرات_مؤقتة × 4 بايتات = 32 بايت
    متغير مقاس_مصفوفة_ذ_م = ثابت_اقصى_ذاكرات_مؤقتة * 4

    عنوان_مقاسات_ذ_م = sad_ll_page_alloc()
