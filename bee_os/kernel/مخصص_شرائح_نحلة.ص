صدّر دالة __sad_init_87()
    kernel_print_string("\n")
    kernel_print_string("╔═══════════════════════════════════════════════════╗\n")
    kernel_print_string("║  مخصص الشرائح (Slab Allocator) — نظام نحلة      ║\n")
    kernel_print_string("║  الإصدار 1.0 — الوحدة 87                        ║\n")
    kernel_print_string("╚═══════════════════════════════════════════════════╝\n")

    إذا (تم_التهيئة == 1)
        kernel_print_string("[شرائح] المخصص مُهيأ مسبقاً\n")
