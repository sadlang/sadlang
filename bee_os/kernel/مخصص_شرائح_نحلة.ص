# الثوابت
# ═══════════════════════════════════════════════════════════════════════════════

# مقاس الصفحة الواحدة
متغير ثابت_مقاس_صفحة = 4096

# ─── أحجام الكائنات المدعومة ───
# خمس ذاكرات مؤقتة لأحجام مختلفة
متغير ثابت_عدد_أحجام = 5
متغير ثابت_مقاس_0 = 32            # 32 بايت — كائنات صغيرة جداً
متغير ثابت_مقاس_1 = 64            # 64 بايت — كائنات صغيرة
متغير ثابت_مقاس_2 = 128           # 128 بايت — كائنات متوسطة
متغير ثابت_مقاس_3 = 256           # 256 بايت — كائنات كبيرة
متغير ثابت_مقاس_4 = 512           # 512 بايت — كائنات كبيرة جداً

# ─── ثوابت الشرائح ───
# أقصى عدد شرائح لكل ذاكرة مؤقتة
متغير ثابت_اقصى_شرائح = 64
# أقصى عدد ذاكرات مؤقتة (5 أحجام ثابتة + مساحة إضافية)
متغير ثابت_اقصى_ذاكرات_مؤقتة = 8
# عدد الصفحات لكل شريحة (افتراضي)
متغير ثابت_صفحات_لكل_شريحة = 1
# مقاس رأس الشريحة بالبايتات (8 حقول × 4 بايتات)
متغير ثابت_مقاس_رأس_شريحة = 32

# ─── وضعيات الشريحة ───
متغير وضعية_شريحة_حرة = 0          # غير مستخدمة (كل الكائنات حرة)
متغير وضعية_شريحة_جزئية = 1        # بعض الكائنات مخصصة
متغير وضعية_شريحة_ممتلئة = 2       # كل الكائنات مخصصة
متغير وضعية_شريحة_غير_مهيأة = 3    # لم تُنشأ بعد

# ─── ثوابت تلوين الشريحة ───
# مقاس سطر المخبأ (CPU cache line = 64 bytes عادة)
متغير ثابت_مقاس_سطر_مخبأ = 64
# أقصى عدد ألوان (يُحسب ديناميكياً لكل ذ.م.)
متغير ثابت_اقصى_ألوان = 16

# ─── ثوابت ضغط الذاكرة ───
متغير ثابت_عتبة_ضغط_منخفض = 10    # أقل من 10 شرائح حرة = ضغط منخفض
متغير ثابت_عتبة_ضغط_متوسط = 5     # أقل من 5 شرائح حرة = ضغط متوسط
متغير ثابت_عتبة_ضغط_عالي = 2      # أقل من 2 شريحة حرة = ضغط عالي

# ─── أعلام خاصة ───
متغير علم_كائن_حر = 0              # الكائن حر ومتاح
متغير علم_كائن_مخصص = 1            # الكائن مخصص ومستخدم

# ═══════════════════════════════════════════════════════════════════════════════
# المتغيرات العامة — حالة مخصص الشرائح
# ═══════════════════════════════════════════════════════════════════════════════

# هل تم التهيئة
متغير تم_التهيئة = 0

# ─── مصفوفات الذاكرات المؤقتة (Cache) ───
# كل ذاكرة مؤقتة تُمثَّل بفهرس في هذه المصفوفات المتوازية
# عنوان_مقاسات_ذ_م[ف] = مقاس الكائن في الذاكرة المؤقتة ف
متغير عنوان_مقاسات_ذ_م = 0
# عنوان_صفحات_ذ_م[ف] = عدد الصفحات لكل شريحة
متغير عنوان_صفحات_ذ_م = 0
# عنوان_كائنات_لكل_شريحة[ف] = عدد الكائنات في كل شريحة
متغير عنوان_كائنات_لكل_شريحة = 0
# عنوان_عدد_شرائح[ف] = إجمالي الشرائح المُنشأة
متغير عنوان_عدد_شرائح = 0
# عنوان_شرائح_حرة[ف] = عدد الشرائح الفارغة
متغير عنوان_شرائح_حرة = 0
# عنوان_شرائح_جزئية[ف] = عدد الشرائح الجزئية
متغير عنوان_شرائح_جزئية_عدد = 0
# عنوان_شرائح_ممتلئة[ف] = عدد الشرائح الممتلئة
متغير عنوان_شرائح_ممتلئة_عدد = 0
# عنوان_لون_تالي[ف] = اللون التالي للشريحة الجديدة
متغير عنوان_لون_تالي = 0
# عنوان_اقصى_لون[ف] = أقصى لون ممكن
متغير عنوان_اقصى_لون = 0
# عنوان_نشاط[ف] = هل الذاكرة المؤقتة نشطة
متغير عنوان_نشاط = 0

# ─── مصفوفة الشرائح ───
# لكل ذاكرة مؤقتة، مصفوفة من الشرائح
# بنية الشريحة (8 حقول × 4 بايتات = 32 بايت):
# [0] عنوان_بيانات    — عنوان الصفحات المخصصة
# [1] فهرس_ذ_م        — فهرس الذاكرة المؤقتة المالكة
# [2] عدد_حرة         — عدد الكائنات الحرة
# [3] عدد_كلي         — عدد الكائنات الإجمالي
# [4] عنوان_أول_حر    — مؤشر أول كائن حر (قائمة حرة)
# [5] اللون            — إزاحة اللون لهذه الشريحة
# [6] وضعية           — وضعية الشريحة
# [7] محجوز            — للاستخدام المستقبلي
متغير عنوان_شرائح = 0      # مصفوفة جميع الشرائح (ذ.م. * اقصى_شرائح * 32)

# ─── مصفوفة أقنعة الكائنات ───
# خريطة بتية (bitmap) لحالة كل كائن في كل شريحة
# كل بت يُمثل كائناً واحداً: 0=حر، 1=مخصص
# مقاس الخريطة = سقف(كائنات_لكل_شريحة / 32) × 4 بايتات
متغير عنوان_خرائط_بتية = 0

# ═══════════════════════════════════════════════════════════════════════════════
# إحصائيات مخصص الشرائح
# ═══════════════════════════════════════════════════════════════════════════════
متغير عداد_تخصيص = 0               # إجمالي عمليات التخصيص
متغير عداد_تحرير = 0               # إجمالي عمليات التحرير
متغير عداد_تنمية = 0               # عدد مرات تنمية الذاكرة المؤقتة (إنشاء شريحة جديدة)
متغير عداد_تقليص = 0               # عدد مرات تقليص الذاكرة المؤقتة (تحرير شريحة)
متغير عداد_فشل_تخصيص = 0          # عدد مرات فشل التخصيص
متغير عداد_ضغط_ذاكرة = 0          # عدد استدعاءات دالة ضغط الذاكرة
متغير إجمالي_صفحات_مستخدمة = 0    # إجمالي الصفحات المأخوذة من النظام
متغير إجمالي_كائنات_نشطة = 0      # عدد الكائنات المخصصة حالياً

# ═══════════════════════════════════════════════════════════════════════════════
# دوال مساعدة داخلية
# ═══════════════════════════════════════════════════════════════════════════════

# قراءة حقل من مصفوفة بالفهرس (كل عنصر 4 بايتات)
دالة قراءة_حقل(عنوان_مصفوفة، فهرس)
    ارجع mem_read_dword(عنوان_مصفوفة + (فهرس * 4))
نهاية

# كتابة حقل في مصفوفة بالفهرس
دالة كتابة_حقل(عنوان_مصفوفة، فهرس، قيمة)
    mem_write_dword(عنوان_مصفوفة + (فهرس * 4)، قيمة)
نهاية

# حساب عنوان شريحة في مصفوفة الشرائح
# فهرس_ذ_م: فهرس الذاكرة المؤقتة (0-4)
# فهرس_شريحة: فهرس الشريحة ضمن الذاكرة المؤقتة (0-63)
دالة عنوان_شريحة(فهرس_ذ_م، فهرس_شريحة)
    # كل ذاكرة مؤقتة لها ثابت_اقصى_شرائح شريحة
    # كل شريحة = ثابت_مقاس_رأس_شريحة بايت
    متغير إزاحة_ذ_م = فهرس_ذ_م * ثابت_اقصى_شرائح * ثابت_مقاس_رأس_شريحة
    متغير إزاحة_شريحة = فهرس_شريحة * ثابت_مقاس_رأس_شريحة
    ارجع عنوان_شرائح + إزاحة_ذ_م + إزاحة_شريحة
نهاية

# قراءة حقل من رأس شريحة
# فهرس_حقل: 0-7 حسب بنية الشريحة
دالة قراءة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، فهرس_حقل)
    متغير عنوان = عنوان_شريحة(فهرس_ذ_م، فهرس_شريحة)
    ارجع mem_read_dword(عنوان + (فهرس_حقل * 4))
نهاية

# كتابة حقل في رأس شريحة
دالة كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة، فهرس_حقل، قيمة)
    متغير عنوان = عنوان_شريحة(فهرس_ذ_م، فهرس_شريحة)
    mem_write_dword(عنوان + (فهرس_حقل * 4)، قيمة)
نهاية

# الحصول على مقاس الكائن لفهرس ذاكرة مؤقتة
دالة مقاس_كائن_ذ_م(فهرس_ذ_م)
    إذا (فهرس_ذ_م == 0)
        ارجع ثابت_مقاس_0
    نهاية
    إذا (فهرس_ذ_م == 1)
        ارجع ثابت_مقاس_1
    نهاية
    إذا (فهرس_ذ_م == 2)
        ارجع ثابت_مقاس_2
    نهاية
    إذا (فهرس_ذ_م == 3)
        ارجع ثابت_مقاس_3
    نهاية
    إذا (فهرس_ذ_م == 4)
        ارجع ثابت_مقاس_4
    نهاية
    ارجع 0
نهاية

# تحديد فهرس الذاكرة المؤقتة المناسبة لمقاس معين
# يُرجع فهرس أصغر ذ.م. تتسع للمقاس المطلوب، أو -1
دالة اختيار_ذاكرة_مؤقتة(المقاس)
    إذا (المقاس <= ثابت_مقاس_0)
        ارجع 0
    نهاية
    إذا (المقاس <= ثابت_مقاس_1)
        ارجع 1
    نهاية
    إذا (المقاس <= ثابت_مقاس_2)
        ارجع 2
    نهاية
    إذا (المقاس <= ثابت_مقاس_3)
        ارجع 3
    نهاية
    إذا (المقاس <= ثابت_مقاس_4)
        ارجع 4
    نهاية
    # المقاس أكبر من أكبر ذاكرة مؤقتة
    ارجع -1
نهاية

# حساب عدد الكائنات التي تتسع في شريحة واحدة
# مع مراعاة رأس الشريحة واللون
دالة حساب_كائنات_في_شريحة(مقاس_الكائن، عدد_صفحات)
    متغير مقاس_شريحة = عدد_صفحات * ثابت_مقاس_صفحة
    # نطرح مساحة رأس الشريحة (مخزن في مصفوفة خارجية فعلياً)
    # المساحة المتاحة كاملة للكائنات مع هامش للألوان
    متغير مساحة_متاحة = مقاس_شريحة - ثابت_مقاس_سطر_مخبأ
    إذا (مساحة_متاحة <= 0)
        ارجع 0
    نهاية
    ارجع مساحة_متاحة / مقاس_الكائن
نهاية

# حساب أقصى لون ممكن لشريحة
# اللون = المساحة المتبقية بعد وضع الكائنات / مقاس سطر المخبأ
دالة حساب_اقصى_لون(مقاس_الكائن، عدد_كائنات، عدد_صفحات)
    متغير مقاس_شريحة = عدد_صفحات * ثابت_مقاس_صفحة
    متغير مساحة_مستخدمة = عدد_كائنات * مقاس_الكائن
    متغير مساحة_متبقية = مقاس_شريحة - مساحة_مستخدمة
    إذا (مساحة_متبقية < ثابت_مقاس_سطر_مخبأ)
        ارجع 0
    نهاية
    متغير ألوان = مساحة_متبقية / ثابت_مقاس_سطر_مخبأ
    إذا (ألوان > ثابت_اقصى_ألوان)
        ارجع ثابت_اقصى_ألوان
    نهاية
    ارجع ألوان
نهاية

# حساب عنوان الخريطة البتية لشريحة
# كل شريحة تحتاج ceil(كائنات/32) × 4 بايتات
دالة عنوان_خريطة_شريحة(فهرس_ذ_م، فهرس_شريحة)
    # أقصى 128 كائن لكل شريحة → 4 لفظات (16 بايت) كحد أقصى للخريطة
    متغير مقاس_خريطة_واحدة = 16
    متغير إزاحة_ذ_م = فهرس_ذ_م * ثابت_اقصى_شرائح * مقاس_خريطة_واحدة
    متغير إزاحة_شريحة = فهرس_شريحة * مقاس_خريطة_واحدة
    ارجع عنوان_خرائط_بتية + إزاحة_ذ_م + إزاحة_شريحة
نهاية

# فحص بت في خريطة بتية
# يُرجع 1 إذا الكائن مخصص، أو 0 إذا حر
دالة فحص_بت_خريطة(عنوان_خريطة، فهرس_كائن)
    متغير فهرس_لفظة = فهرس_كائن / 32
    متغير فهرس_بت = فهرس_كائن - (فهرس_لفظة * 32)
    متغير لفظة = mem_read_dword(عنوان_خريطة + (فهرس_لفظة * 4))
    متغير قناع = 1 << فهرس_بت
    متغير نتيجة = لفظة & قناع
    إذا (نتيجة != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ضبط بت في خريطة بتية (تحديد كائن كمخصص)
دالة ضبط_بت_خريطة(عنوان_خريطة، فهرس_كائن)
    متغير فهرس_لفظة = فهرس_كائن / 32
    متغير فهرس_بت = فهرس_كائن - (فهرس_لفظة * 32)
    متغير لفظة = mem_read_dword(عنوان_خريطة + (فهرس_لفظة * 4))
    متغير قناع = 1 << فهرس_بت
    متغير نتيجة = لفظة | قناع
    mem_write_dword(عنوان_خريطة + (فهرس_لفظة * 4)، نتيجة)
نهاية

# مسح بت في خريطة بتية (تحديد كائن كحر)
دالة مسح_بت_خريطة(عنوان_خريطة، فهرس_كائن)
    متغير فهرس_لفظة = فهرس_كائن / 32
    متغير فهرس_بت = فهرس_كائن - (فهرس_لفظة * 32)
    متغير لفظة = mem_read_dword(عنوان_خريطة + (فهرس_لفظة * 4))
    متغير قناع = 1 << فهرس_بت
    متغير قناع_عكسي = ~قناع
    متغير نتيجة = لفظة & قناع_عكسي
    mem_write_dword(عنوان_خريطة + (فهرس_لفظة * 4)، نتيجة)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تهيئة الذاكرة المؤقتة
# ═══════════════════════════════════════════════════════════════════════════════

# تهيئة ذاكرة مؤقتة واحدة بمقاس كائن محدد
دالة تهيئة_ذاكرة_مؤقتة(فهرس_ذ_م، مقاس_الكائن، صفحات_لكل_شريحة)
    kernel_print_string("[شرائح] تهيئة ذاكرة مؤقتة - مقاس كائن: ")
    kernel_print_number(مقاس_الكائن)
    kernel_print_string("\n")

    # حفظ مقاس الكائن
    كتابة_حقل(عنوان_مقاسات_ذ_م، فهرس_ذ_م، مقاس_الكائن)
    # حفظ عدد الصفحات لكل شريحة
    كتابة_حقل(عنوان_صفحات_ذ_م، فهرس_ذ_م، صفحات_لكل_شريحة)

    # حساب عدد الكائنات لكل شريحة
    متغير عدد_كائنات = حساب_كائنات_في_شريحة(مقاس_الكائن، صفحات_لكل_شريحة)
    كتابة_حقل(عنوان_كائنات_لكل_شريحة، فهرس_ذ_م، عدد_كائنات)

    kernel_print_string("  كائنات لكل شريحة: ")
    kernel_print_number(عدد_كائنات)
    kernel_print_string("\n")

    # حساب أقصى لون
    متغير أقصى_لون = حساب_اقصى_لون(مقاس_الكائن، عدد_كائنات، صفحات_لكل_شريحة)
    كتابة_حقل(عنوان_اقصى_لون، فهرس_ذ_م، أقصى_لون)
    كتابة_حقل(عنوان_لون_تالي، فهرس_ذ_م، 0)

    kernel_print_string("  أقصى لون (تلوين مخبأ): ")
    kernel_print_number(أقصى_لون)
    kernel_print_string("\n")

    # بدء بدون شرائح
    كتابة_حقل(عنوان_عدد_شرائح، فهرس_ذ_م، 0)
    كتابة_حقل(عنوان_شرائح_حرة، فهرس_ذ_م، 0)
    كتابة_حقل(عنوان_شرائح_جزئية_عدد، فهرس_ذ_م، 0)
    كتابة_حقل(عنوان_شرائح_ممتلئة_عدد، فهرس_ذ_م، 0)

    # تفعيل الذاكرة المؤقتة
    كتابة_حقل(عنوان_نشاط، فهرس_ذ_م، 1)

    # تهيئة رؤوس الشرائح بالوضعية "غير مهيأة"
    متغير ش = 0
    بينما (ش < ثابت_اقصى_شرائح)
        كتابة_حقل_شريحة(فهرس_ذ_م، ش، 6، وضعية_شريحة_غير_مهيأة)
        ش = ش + 1
    نهاية

    # إنشاء شريحة أولية واحدة مسبقاً
    متغير نتيجة_تنمية = تنمية_ذاكرة_مؤقتة(فهرس_ذ_م)
    إذا (نتيجة_تنمية < 0)
        kernel_print_string("  [تحذير] فشل إنشاء الشريحة الأولية!\n")
    وإلا
        kernel_print_string("  تم إنشاء شريحة أولية بنجاح\n")
    نهاية
