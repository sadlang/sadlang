            kernel_print_string("[شرائح] فشل تخصيص صفحات إضافية للشرائح!\n")
            ارجع -1
        نهاية
        ص = ص + 1
    نهاية
    sad_ll_memset(عنوان_شرائح، 0، مقاس_شرائح)

    # ─── تخصيص الخرائط البتية ───
    # 16 بايت لكل شريحة × 64 شريحة × 8 ذ.م. = 8192 بايت = 2 صفحات
    عنوان_خرائط_بتية = sad_ll_page_alloc()
    إذا (عنوان_خرائط_بتية == 0)
        kernel_print_string("[شرائح] فشل تخصيص الخرائط البتية!\n")
        ارجع -1
    نهاية
    sad_ll_page_alloc()
    sad_ll_memset(عنوان_خرائط_بتية، 0، 8192)

    kernel_print_string("[شرائح] تم تخصيص هياكل البيانات بنجاح\n")

    # ─── تهيئة الذاكرات المؤقتة الخمس ───
    kernel_print_string("[شرائح] تهيئة الذاكرات المؤقتة...\n\n")

    تهيئة_ذاكرة_مؤقتة(0، ثابت_مقاس_0، 1)    # 32 بايت, صفحة واحدة
    تهيئة_ذاكرة_مؤقتة(1، ثابت_مقاس_1، 1)    # 64 بايت, صفحة واحدة
    تهيئة_ذاكرة_مؤقتة(2، ثابت_مقاس_2، 1)    # 128 بايت, صفحة واحدة
    تهيئة_ذاكرة_مؤقتة(3، ثابت_مقاس_3، 1)    # 256 بايت, صفحة واحدة
    تهيئة_ذاكرة_مؤقتة(4، ثابت_مقاس_4، 2)    # 512 بايت, صفحتان

    # ─── الانتهاء ───
    تم_التهيئة = 1

    kernel_print_string("\n[شرائح] ─── اكتملت التهيئة بنجاح ───\n")
    kernel_print_string("[شرائح] الأحجام المدعومة: 32, 64, 128, 256, 512 بايت\n")
    kernel_print_string("[شرائح] جاهز لتخصيص كائنات النواة\n\n")

    # طباعة الإحصائيات الأولية
    طباعة_إحصائيات_شاملة()

    ارجع 0
