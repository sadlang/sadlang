# ═══════════════════════════════════════════════════════════════════════════════
# تنمية الذاكرة المؤقتة — إنشاء شريحة جديدة
# ═══════════════════════════════════════════════════════════════════════════════

# تُنشئ شريحة جديدة وتضيفها للذاكرة المؤقتة
# تُرجع فهرس الشريحة الجديدة أو -1 عند الفشل
دالة تنمية_ذاكرة_مؤقتة(فهرس_ذ_م)
    # فحص الحد الأقصى للشرائح
    متغير عدد_حالي = قراءة_حقل(عنوان_عدد_شرائح، فهرس_ذ_م)
    إذا (عدد_حالي >= ثابت_اقصى_شرائح)
        kernel_print_string("[شرائح] تحذير: وصلنا للحد الأقصى من الشرائح\n")
        ارجع -1
    نهاية

    # البحث عن فتحة شريحة فارغة
    متغير فهرس_شريحة_جديد = -1
    متغير ش = 0
    بينما (ش < ثابت_اقصى_شرائح)
        متغير وصف = قراءة_حقل_شريحة(فهرس_ذ_م، ش، 6)
        إذا (وصف == وضعية_شريحة_غير_مهيأة)
            فهرس_شريحة_جديد = ش
            ش = ثابت_اقصى_شرائح
        نهاية
        ش = ش + 1
    نهاية

    إذا (فهرس_شريحة_جديد < 0)
        kernel_print_string("[شرائح] تحذير: لا توجد فتحة شريحة فارغة\n")
        ارجع -1
    نهاية

    # تخصيص الصفحات الفيزيائية للشريحة
    متغير صفحات = قراءة_حقل(عنوان_صفحات_ذ_م، فهرس_ذ_م)
    متغير عنوان_أول_صفحة = 0
    متغير ص = 0
    بينما (ص < صفحات)
        متغير صفحة = sad_ll_page_alloc()
        إذا (صفحة == 0)
            # فشل التخصيص — نحرر ما خصصناه
            kernel_print_string("[شرائح] فشل تخصيص صفحة للشريحة\n")
            عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
            ارجع -1
        نهاية
        إذا (ص == 0)
            عنوان_أول_صفحة = صفحة
        نهاية
        إجمالي_صفحات_مستخدمة = إجمالي_صفحات_مستخدمة + 1
        ص = ص + 1
    نهاية

    # تحديد لون هذه الشريحة (تلوين المخبأ)
    متغير اللون_الحالي = قراءة_حقل(عنوان_لون_تالي، فهرس_ذ_م)
    متغير إزاحة_اللون = اللون_الحالي * ثابت_مقاس_سطر_مخبأ
    # تحديث اللون التالي (دورة)
    متغير أقصى = قراءة_حقل(عنوان_اقصى_لون، فهرس_ذ_م)
    متغير لون_جديد = اللون_الحالي + 1
    إذا (أقصى > 0)
        # حساب الباقي يدوياً
        بينما (لون_جديد >= أقصى)
            لون_جديد = لون_جديد - أقصى
        نهاية
    وإلا
        لون_جديد = 0
    نهاية
    كتابة_حقل(عنوان_لون_تالي، فهرس_ذ_م، لون_جديد)

    # تصفير صفحات الشريحة
    sad_ll_memset(عنوان_أول_صفحة، 0، صفحات * ثابت_مقاس_صفحة)

    # تهيئة رأس الشريحة
    متغير عدد_كائنات = قراءة_حقل(عنوان_كائنات_لكل_شريحة، فهرس_ذ_م)
    # [0] عنوان البيانات
    كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة_جديد، 0، عنوان_أول_صفحة)
    # [1] فهرس الذاكرة المؤقتة
    كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة_جديد، 1، فهرس_ذ_م)
    # [2] عدد الكائنات الحرة = الكل حر
    كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة_جديد، 2، عدد_كائنات)
    # [3] عدد الكائنات الكلي
    كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة_جديد، 3، عدد_كائنات)
    # [4] أول كائن حر = 0 (الأول)
    كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة_جديد، 4، 0)
    # [5] اللون
    كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة_جديد، 5، إزاحة_اللون)
    # [6] وضعية = فارغة (كل الكائنات حرة)
    كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة_جديد، 6، وضعية_شريحة_حرة)
    # [7] محجوز
    كتابة_حقل_شريحة(فهرس_ذ_م، فهرس_شريحة_جديد، 7، 0)

    # تصفير الخريطة البتية لهذه الشريحة (كل الكائنات حرة)
    متغير عنوان_خريطة = عنوان_خريطة_شريحة(فهرس_ذ_م، فهرس_شريحة_جديد)
    sad_ll_memset(عنوان_خريطة، 0، 16)

    # تحديث عدادات الذاكرة المؤقتة
    كتابة_حقل(عنوان_عدد_شرائح، فهرس_ذ_م، عدد_حالي + 1)
    متغير حرة_حالية = قراءة_حقل(عنوان_شرائح_حرة، فهرس_ذ_م)
    كتابة_حقل(عنوان_شرائح_حرة، فهرس_ذ_م، حرة_حالية + 1)

    عداد_تنمية = عداد_تنمية + 1

    kernel_print_string("[شرائح] تم إنشاء شريحة جديدة - ذ.م.: ")
    kernel_print_number(فهرس_ذ_م)
    kernel_print_string(" شريحة: ")
    kernel_print_number(فهرس_شريحة_جديد)
    kernel_print_string(" لون: ")
    kernel_print_number(إزاحة_اللون)
    kernel_print_string("\n")

    ارجع فهرس_شريحة_جديد
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# البحث عن شريحة بها كائنات حرة
# ═══════════════════════════════════════════════════════════════════════════════

# البحث عن شريحة جزئية أو فارغة بها كائنات حرة
# الأولوية: جزئية أولاً (لتقليل عدد الشرائح النشطة)، ثم فارغة
# تُرجع فهرس الشريحة أو -1
دالة بحث_شريحة_بها_كائنات_حرة(فهرس_ذ_م)
    # أولاً: بحث في الشرائح الجزئية
    متغير ش = 0
    بينما (ش < ثابت_اقصى_شرائح)
        متغير وصف = قراءة_حقل_شريحة(فهرس_ذ_م، ش، 6)
        إذا (وصف == وضعية_شريحة_جزئية)
            متغير حرة = قراءة_حقل_شريحة(فهرس_ذ_م، ش، 2)
            إذا (حرة > 0)
                ارجع ش
            نهاية
        نهاية
        ش = ش + 1
    نهاية

    # ثانياً: بحث في الشرائح الفارغة
    ش = 0
    بينما (ش < ثابت_اقصى_شرائح)
        متغير وصف2 = قراءة_حقل_شريحة(فهرس_ذ_م، ش، 6)
        إذا (وصف2 == وضعية_شريحة_حرة)
            متغير حرة2 = قراءة_حقل_شريحة(فهرس_ذ_م، ش، 2)
            إذا (حرة2 > 0)
                ارجع ش
            نهاية
        نهاية
        ش = ش + 1
    نهاية

    # لا توجد شرائح بها كائنات حرة
    ارجع -1
