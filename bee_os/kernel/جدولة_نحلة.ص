# ═══════════════════════════════════════════════════════════════════════════════
#   الجزء الثامن: خوارزمية الجدولة — Round Robin
# ═══════════════════════════════════════════════════════════════════════════════
#
# Round Robin (التناوب الدائري):
#   - كل عملية تحصل على شريحة زمنية متساوية
#   - عند انتهاء الشريحة، ننتقل للعملية التالية
#   - إذا لم نجد عملية جاهزة → نُشغّل عملية الخمول
#
# خوارزمية الاختيار:
#   1. ابدأ من العملية التالية بعد الحالية (Round Robin)
#   2. تفقّد جميع الخانات بالترتيب الدائري
#   3. أول عملية بحالة "جاهزة" تُختار
#   4. إذا لم نجد أياً → اختر عملية الخمول (فهرس 0)
#
# تحسينات مستقبلية:
#   - أولويات: عمليات ذات أولوية أعلى تحصل على شرائح أكثر
#   - MLFQ: قوائم متعددة المستويات مع ترقية/تنزيل
#   - CFS: جدولة عادلة تماماً كـ Linux
# ═══════════════════════════════════════════════════════════════════════════════

## اختيار العملية التالية للتشغيل
## ارجع: فهرس العملية المختارة
دالة اختر_العملية_التالية()
    # البحث الدائري: نبدأ من بعد الحالية
    متغير بداية = العملية_الحالية + 1
    
    # ──────── المرحلة 1: بحث عن عملية جاهزة ────────
    متغير ط = 0
    بينما (ط < أقصى_عدد_عمليات)
        متغير فهرس = (بداية + ط) % أقصى_عدد_عمليات
        
        إذا (عمليات_حالة[فهرس] == حالة_جاهزة)
            ارجع فهرس
        نهاية
        
        ط = ط + 1
    نهاية
    
    # ──────── المرحلة 2: لا توجد عملية جاهزة ────────
    # نختار العملية الحالية إذا كانت لا تزال تعمل
    إذا (عمليات_حالة[العملية_الحالية] == حالة_تعمل)
        ارجع العملية_الحالية
    نهاية
    
    # ──────── المرحلة 3: نرجع لعملية الخمول ────────
    # عملية الخمول دائماً في الفهرس 0
    ارجع 0
نهاية

## نبضة المُجدوِل — تُستدعى من معالج المؤقت
## هذه الدالة الرئيسية التي يُستدعاها المؤقت في كل نبضة.
## تُقرر: هل نبقى على العملية الحالية أم نُبدّل؟
صدّر دالة نبضة_المُجدوِل()
    # تجاهل إذا المُجدوِل غير نشط
    إذا (المُجدوِل_نشط == 0)
        ارجع
    نهاية
    
    # فحص العمليات النائمة التي حان وقت استيقاظها
    فحص_العمليات_النائمة()
    
    # تحديث وقت CPU للعملية الحالية
    إذا (عمليات_حالة[العملية_الحالية] == حالة_تعمل)
        عمليات_وقت_CPU[العملية_الحالية] = عمليات_وقت_CPU[العملية_الحالية] + 1
    نهاية
    
    # إنقاص الشريحة الزمنية
    عمليات_شرائح[العملية_الحالية] = عمليات_شرائح[العملية_الحالية] - 1
    
    # هل انتهت الشريحة الزمنية؟
    إذا (عمليات_شرائح[العملية_الحالية] <= 0)
        # نعم — حان وقت التبديل!
        
        # أعد العملية الحالية إلى "جاهزة" (إذا كانت تعمل)
        إذا (عمليات_حالة[العملية_الحالية] == حالة_تعمل)
            عمليات_حالة[العملية_الحالية] = حالة_جاهزة
            عمليات_شرائح[العملية_الحالية] = الشريحة_الافتراضية
        نهاية
        
        # اختر العملية التالية وبدّل إليها
        جدوِل()
    نهاية
نهاية

## تنفيذ تبديل السياق — الدالة المركزية
## تختار العملية التالية وتُبدّل إليها
دالة جدوِل()
    # اختيار العملية التالية
    متغير التالية = اختر_العملية_التالية()
    
    # إذا هي نفس العملية الحالية — لا تبديل
    إذا (التالية == العملية_الحالية)
        إذا (عمليات_حالة[العملية_الحالية] == حالة_جاهزة)
            عمليات_حالة[العملية_الحالية] = حالة_تعمل
        نهاية
