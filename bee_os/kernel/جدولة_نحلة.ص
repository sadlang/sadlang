    نهاية
    
    # ──────── تبديل السياق ────────
    عدد_تبديلات_السياق = عدد_تبديلات_السياق + 1
    عمليات_تبديلات[التالية] = عمليات_تبديلات[التالية] + 1
    
    # تحديث الحالات
    متغير السابقة = العملية_الحالية
    العملية_الحالية = التالية
    عمليات_حالة[التالية] = حالة_تعمل
    عمليات_شرائح[التالية] = الشريحة_الافتراضية
    
    وقت_آخر_جدولة = اقرأ_النبضات()
    
    # طباعة (عند التنقيح فقط)
    إذا (عدد_تبديلات_السياق % 100 == 0)
        serial_اطبع("[SCHED] تبديل #")
        serial_اطبع_رقم(عدد_تبديلات_السياق)
        serial_اطبع(": PID ")
        serial_اطبع_رقم(عمليات_PID[السابقة])
        serial_اطبع(" → PID ")
        serial_اطبع_رقم(عمليات_PID[التالية])
        serial_اطبع("\n")
    نهاية
    
    # تنفيذ التبديل الفعلي (يحتاج assembly stubs)
    # بدّل_السياق(عمليات_سياق[السابقة]، عمليات_سياق[التالية])
