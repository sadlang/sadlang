# TCP — بناء رأس TCP (20 بايت)
# ═══════════════════════════════════════════════════════════════════════════════
دالة tcp_build_header(buf، src_port، dst_port، seq_num، ack_num، flags، window)
    # منفذ المصدر
    sad_ll_mem_write8(buf، src_port / 256)
    sad_ll_mem_write8(buf + 1، src_port % 256)

    # منفذ الوجهة
    sad_ll_mem_write8(buf + 2، dst_port / 256)
    sad_ll_mem_write8(buf + 3، dst_port % 256)

    # رقم التسلسل (4 بايتات big-endian)
    sad_ll_mem_write8(buf + 4، (seq_num / 16777216) % 256)
    sad_ll_mem_write8(buf + 5، (seq_num / 65536) % 256)
    sad_ll_mem_write8(buf + 6، (seq_num / 256) % 256)
    sad_ll_mem_write8(buf + 7، seq_num % 256)

    # رقم التأكيد (4 بايتات)
    sad_ll_mem_write8(buf + 8، (ack_num / 16777216) % 256)
    sad_ll_mem_write8(buf + 9، (ack_num / 65536) % 256)
    sad_ll_mem_write8(buf + 10، (ack_num / 256) % 256)
    sad_ll_mem_write8(buf + 11، ack_num % 256)

    # Data Offset (5 words = 20 bytes) + Reserved = 0x50 = 80
    sad_ll_mem_write8(buf + 12، 80)

    # الأعلام
    sad_ll_mem_write8(buf + 13، flags)

    # حجم النافذة
    sad_ll_mem_write8(buf + 14، window / 256)
    sad_ll_mem_write8(buf + 15، window % 256)

    # مجموع التحقق (0 مؤقتاً — يحتاج pseudo-header)
    sad_ll_mem_write8(buf + 16، 0)
    sad_ll_mem_write8(buf + 17، 0)

    # مؤشر العاجل
    sad_ll_mem_write8(buf + 18، 0)
    sad_ll_mem_write8(buf + 19، 0)

    ارجع TCP_HEADER_SIZE + 0
نهاية

