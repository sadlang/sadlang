# معالجة قطعة TCP حسب حالة المأخذ
دالة tcp_process_segment(sock، src_ip، src_port، seq، ack_num، flags، data_addr، data_len)
    متغير state = tcp_get_state(sock) + 0

    # حالة LISTEN — استقبال SYN
    إذا (state == TCP_STATE_LISTEN)
        # التحقق من علم SYN
        متغير is_syn = flags - ((flags / (TCP_SYN * 2)) * (TCP_SYN * 2))
        إذا (is_syn >= TCP_SYN)
            tcp_set_rip(sock، src_ip + 0)
            tcp_set_rport(sock، src_port + 0)
            tcp_set_ack(sock، seq + 1)

            متغير isn = sad_ll_timer_get_ticks() + 0
            tcp_set_seq(sock، isn)

            # إرسال SYN+ACK
            متغير tcp_buf = sad_ll_kmalloc(TCP_HEADER_SIZE) + 0
            إذا (tcp_buf > 0)
                sad_ll_memset(tcp_buf، 0، TCP_HEADER_SIZE)
                متغير syn_ack = TCP_SYN + TCP_ACK
                tcp_build_header(tcp_buf، tcp_get_lport(sock)، src_port، isn، seq + 1، syn_ack، TCP_WINDOW_SIZE)
                ip_send(src_ip، IP_PROTO_TCP، tcp_buf، TCP_HEADER_SIZE)
                sad_ll_kfree(tcp_buf)
            نهاية

            tcp_set_seq(sock، isn + 1)
            tcp_set_state(sock، TCP_STATE_SYN_RCVD)
            tcp_serial_اطبع("[TCP] SYN-ACK sent")
            tcp_serial_سطر()
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    # حالة SYN_SENT — استقبال SYN+ACK
    إذا (state == TCP_STATE_SYN_SENT)
        متغير has_syn = flags - ((flags / (TCP_SYN * 2)) * (TCP_SYN * 2))
        متغير has_ack = flags - ((flags / (TCP_ACK * 2)) * (TCP_ACK * 2))

        إذا (has_syn >= TCP_SYN)
            إذا (has_ack >= TCP_ACK)
                tcp_set_ack(sock، seq + 1)

                # إرسال ACK
                متغير tcp_buf = sad_ll_kmalloc(TCP_HEADER_SIZE) + 0
                إذا (tcp_buf > 0)
                    sad_ll_memset(tcp_buf، 0، TCP_HEADER_SIZE)
                    tcp_build_header(tcp_buf، tcp_get_lport(sock)، tcp_get_rport(sock)، tcp_get_seq(sock)، seq + 1، TCP_ACK، TCP_WINDOW_SIZE)
                    ip_send(tcp_get_rip(sock)، IP_PROTO_TCP، tcp_buf، TCP_HEADER_SIZE)
                    sad_ll_kfree(tcp_buf)
                نهاية

                tcp_set_state(sock، TCP_STATE_ESTABLISHED)
                tcp_serial_اطبع("[TCP] اتصال مؤسس! sock=")
                tcp_serial_رقم(sock)
                tcp_serial_سطر()
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية

    # حالة SYN_RCVD — استقبال ACK
    إذا (state == TCP_STATE_SYN_RCVD)
        متغير has_ack = flags - ((flags / (TCP_ACK * 2)) * (TCP_ACK * 2))
        إذا (has_ack >= TCP_ACK)
            tcp_set_state(sock، TCP_STATE_ESTABLISHED)
            tcp_serial_اطبع("[TCP] اتصال مؤسس (خادم)! sock=")
            tcp_serial_رقم(sock)
            tcp_serial_سطر()
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    # حالة ESTABLISHED — بيانات أو FIN
    إذا (state == TCP_STATE_ESTABLISHED)
        # التحقق من FIN
        متغير has_fin = flags % (TCP_FIN * 2)
        إذا (has_fin >= TCP_FIN)
            # إرسال ACK للـ FIN
            tcp_set_ack(sock، seq + 1)

            متغير tcp_buf = sad_ll_kmalloc(TCP_HEADER_SIZE) + 0
            إذا (tcp_buf > 0)
                sad_ll_memset(tcp_buf، 0، TCP_HEADER_SIZE)
                tcp_build_header(tcp_buf، tcp_get_lport(sock)، tcp_get_rport(sock)، tcp_get_seq(sock)، seq + 1، TCP_ACK، TCP_WINDOW_SIZE)
                ip_send(tcp_get_rip(sock)، IP_PROTO_TCP، tcp_buf، TCP_HEADER_SIZE)
                sad_ll_kfree(tcp_buf)
            نهاية

            tcp_set_state(sock، TCP_STATE_CLOSE_WAIT)
            tcp_serial_اطبع("[TCP] FIN received, sock=")
            tcp_serial_رقم(sock)
            tcp_serial_سطر()
            ارجع 1
        نهاية

        # بيانات عادية — ACK تلقائي
        إذا (data_len > 0)
            tcp_set_ack(sock، seq + data_len)

            متغير tcp_buf = sad_ll_kmalloc(TCP_HEADER_SIZE) + 0
            إذا (tcp_buf > 0)
                sad_ll_memset(tcp_buf، 0، TCP_HEADER_SIZE)
                tcp_build_header(tcp_buf، tcp_get_lport(sock)، tcp_get_rport(sock)، tcp_get_seq(sock)، seq + data_len، TCP_ACK، TCP_WINDOW_SIZE)
                ip_send(tcp_get_rip(sock)، IP_PROTO_TCP، tcp_buf، TCP_HEADER_SIZE)
                sad_ll_kfree(tcp_buf)
            نهاية

            tcp_serial_اطبع("[TCP] Data ACKed, len=")
            tcp_serial_رقم(data_len)
            tcp_serial_سطر()
        نهاية
        ارجع 1
    نهاية

    # حالات الإغلاق
    إذا (state == TCP_STATE_FIN_WAIT1)
        متغير has_ack = flags - ((flags / (TCP_ACK * 2)) * (TCP_ACK * 2))
        إذا (has_ack >= TCP_ACK)
            tcp_set_state(sock، TCP_STATE_FIN_WAIT2)
        نهاية
        ارجع 1
    نهاية

    إذا (state == TCP_STATE_FIN_WAIT2)
        متغير has_fin = flags % (TCP_FIN * 2)
        إذا (has_fin >= TCP_FIN)
            tcp_set_ack(sock، seq + 1)
            متغير tcp_buf = sad_ll_kmalloc(TCP_HEADER_SIZE) + 0
            إذا (tcp_buf > 0)
                sad_ll_memset(tcp_buf، 0، TCP_HEADER_SIZE)
                tcp_build_header(tcp_buf، tcp_get_lport(sock)، tcp_get_rport(sock)، tcp_get_seq(sock)، seq + 1، TCP_ACK، TCP_WINDOW_SIZE)
                ip_send(tcp_get_rip(sock)، IP_PROTO_TCP، tcp_buf، TCP_HEADER_SIZE)
                sad_ll_kfree(tcp_buf)
            نهاية
            tcp_set_state(sock، TCP_STATE_CLOSED)
        نهاية
        ارجع 1
    نهاية

    إذا (state == TCP_STATE_CLOSE_WAIT)
        # إرسال FIN
        متغير tcp_buf = sad_ll_kmalloc(TCP_HEADER_SIZE) + 0
        إذا (tcp_buf > 0)
            sad_ll_memset(tcp_buf، 0، TCP_HEADER_SIZE)
            متغير fin_flags = TCP_FIN + TCP_ACK
            tcp_build_header(tcp_buf، tcp_get_lport(sock)، tcp_get_rport(sock)، tcp_get_seq(sock)، tcp_get_ack(sock)، fin_flags، TCP_WINDOW_SIZE)
            ip_send(tcp_get_rip(sock)، IP_PROTO_TCP، tcp_buf، TCP_HEADER_SIZE)
            sad_ll_kfree(tcp_buf)
        نهاية
        tcp_set_state(sock، TCP_STATE_LAST_ACK)
        ارجع 1
    نهاية

    إذا (state == TCP_STATE_LAST_ACK)
        tcp_set_state(sock، TCP_STATE_CLOSED)
        tcp_serial_اطبع("[TCP] اتصال مغلق، sock=")
        tcp_serial_رقم(sock)
        tcp_serial_سطر()
        ارجع 1
    نهاية

    ارجع 0
