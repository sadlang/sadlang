    نهاية
    
    ata_read_sector(محرك + 0، قطاع_مطلق + 0، مخزن + 0)
    
    # تحديث عدد العناقيد الحرة
    متغير عناقيد_حرة = fat32_عناقيد_حرة(فهرس_قسم + 0)
    mem_write_dword(مخزن + 0، إزاحة_fsinfo_عناقيد_حرة + 0، عناقيد_حرة + 0)
    
