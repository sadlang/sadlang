# قراءة مدخل FAT لعنقود معين من القرص
# يُرجع قيمة المدخل (رقم العنقود التالي أو علامة خاصة)
صدّر دالة fat32_اقرأ_مدخل_fat(فهرس_قسم، رقم_عنقود)
    # أولاً: البحث في الذاكرة المؤقتة
    متغير مخزن_مؤقت = fat32_ذاكرة_بحث(فهرس_قسم + 0، رقم_عنقود + 0)
    إذا (مخزن_مؤقت >= 0)
        ارجع مخزن_مؤقت + 0
    نهاية
    
    # حساب موقع المدخل في جدول FAT
    متغير قطاع_fat = fat32_قطاع_fat_لعنقود(فهرس_قسم + 0، رقم_عنقود + 0)
    متغير إزاحة = fat32_إزاحة_fat_لعنقود(فهرس_قسم + 0، رقم_عنقود + 0)
    
    # حساب القطاع المطلق
    متغير قطاع_مطلق = fat32_قطاع_fat_مطلق(فهرس_قسم + 0، قطاع_fat + 0)
    
    # الحصول على رقم المحرك
    متغير محرك = fat32_محرك_قسم(فهرس_قسم + 0)
    
    # تخصيص مخزن مؤقت لقراءة القطاع
    متغير مخزن = kmalloc(512)
    إذا (مخزن == 0)
        serial_puts("[FAT32] خطأ: فشل تخصيص ذاكرة لقراءة FAT\r\n")
        fat32_عدد_أخطاء = fat32_عدد_أخطاء + 1
        ارجع -1
    نهاية
    
    # قراءة القطاع من القرص
    ata_read_sector(محرك + 0، قطاع_مطلق + 0، مخزن + 0)
    
    # قراءة القيمة (4 بايت) من الإزاحة المحسوبة
    متغير قيمة = mem_read_dword(مخزن + 0، إزاحة + 0)
    
    # تطبيق قناع FAT32 (28 بت سفلية)
    # القناع = 0x0FFFFFFF = 268435455
    متغير قيمة_مقنعة = قيمة % 268435456
    
    # تحرير المخزن المؤقت
    kfree(مخزن + 0)
    
    # إضافة القيمة إلى الذاكرة المؤقتة
    fat32_ذاكرة_أضف(فهرس_قسم + 0، رقم_عنقود + 0، قيمة_مقنعة + 0)
    
    # تحديث عداد القراءات
    fat32_عدد_قراءات = fat32_عدد_قراءات + 1
    
    ارجع قيمة_مقنعة + 0
نهاية

# كتابة مدخل FAT لعنقود معين
# يكتب في كلا نسختي جدول FAT للحفاظ على التناسق
