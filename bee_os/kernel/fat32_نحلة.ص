    ata_write_sector(محرك + 0، قطاع_fat2 + 0، مخزن + 0)
    
    # تحرير المخزن المؤقت
    kfree(مخزن + 0)
    
    # تحديث الذاكرة المؤقتة
    fat32_ذاكرة_أضف(فهرس_قسم + 0، رقم_عنقود + 0، قيمة_محدثة % 268435456)
    
