        serial_puts("[FAT32] خطأ: فشل تخصيص ذاكرة لكتابة FAT\r\n")
        fat32_عدد_أخطاء = fat32_عدد_أخطاء + 1
        ارجع -1
    نهاية
    
    # قراءة القطاع الحالي (للحفاظ على البتات العليا)
    ata_read_sector(محرك + 0، قطاع_مطلق + 0، مخزن + 0)
    
    # قراءة القيمة الحالية للحفاظ على البتات العليا الأربع
    متغير قيمة_حالية = mem_read_dword(مخزن + 0، إزاحة + 0)
    
    # الحفاظ على البتات العليا الأربع من القيمة الأصلية
    # البتات العليا = القيمة الحالية - (القيمة الحالية % 268435456)
    متغير بتات_عليا = قيمة_حالية - (قيمة_حالية % 268435456)
    
