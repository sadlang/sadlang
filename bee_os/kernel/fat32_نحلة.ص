# قراءة معلومات FSInfo من القرص
صدّر دالة fat32_اقرأ_fsinfo(فهرس_قسم)
    متغير محرك = fat32_محرك_قسم(فهرس_قسم + 0)
    متغير بداية = fat32_بداية_قسم(فهرس_قسم + 0)
    متغير قطاع_fsinfo = 1
    
    إذا (فهرس_قسم == 0)
        قطاع_fsinfo = قسم_قطاع_fsinfo_0 + 0
    نهاية
    إذا (فهرس_قسم == 1)
        قطاع_fsinfo = قسم_قطاع_fsinfo_1 + 0
    نهاية
    إذا (فهرس_قسم == 2)
        قطاع_fsinfo = قسم_قطاع_fsinfo_2 + 0
    نهاية
    إذا (فهرس_قسم == 3)
        قطاع_fsinfo = قسم_قطاع_fsinfo_3 + 0
    نهاية
    
    # القطاع المطلق لـ FSInfo
    متغير قطاع_مطلق = بداية + قطاع_fsinfo
    
    # تخصيص مخزن
    متغير مخزن = kmalloc(512)
    إذا (مخزن == 0)
        ارجع -1
    نهاية
    
    # قراءة القطاع
    ata_read_sector(محرك + 0، قطاع_مطلق + 0، مخزن + 0)
    
    # التحقق من التوقيع الأول — 0x41615252
    متغير توقيع1 = mem_read_dword(مخزن + 0، إزاحة_fsinfo_توقيع_1 + 0)
    إذا (توقيع1 != توقيع_fsinfo_1)
        serial_puts("[FAT32] تحذير: توقيع FSInfo الأول غير صحيح\r\n")
        kfree(مخزن + 0)
        ارجع -1
    نهاية
    
    # التحقق من التوقيع الثاني — 0x61417272
    متغير توقيع2 = mem_read_dword(مخزن + 0، إزاحة_fsinfo_توقيع_2 + 0)
    إذا (توقيع2 != توقيع_fsinfo_2)
        serial_puts("[FAT32] تحذير: توقيع FSInfo الثاني غير صحيح\r\n")
        kfree(مخزن + 0)
        ارجع -1
    نهاية
    
    # قراءة عدد العناقيد الحرة
    متغير عناقيد_حرة = mem_read_dword(مخزن + 0، إزاحة_fsinfo_عناقيد_حرة + 0)
    
    # قراءة أول عنقود حر معروف
    متغير أول_حر = mem_read_dword(مخزن + 0، إزاحة_fsinfo_أول_حر + 0)
    
    # تخزين المعلومات
    # 0xFFFFFFFF (4294967295) تعني "غير معروف"
    إذا (عناقيد_حرة != 4294967295)
        إذا (فهرس_قسم == 0)
            قسم_عناقيد_حرة_0 = عناقيد_حرة + 0
            قسم_حر_ميجا_0 = (عناقيد_حرة * قسم_حجم_عنقود_0) / 1048576
        نهاية
        إذا (فهرس_قسم == 1)
            قسم_عناقيد_حرة_1 = عناقيد_حرة + 0
            قسم_حر_ميجا_1 = (عناقيد_حرة * قسم_حجم_عنقود_1) / 1048576
        نهاية
        إذا (فهرس_قسم == 2)
            قسم_عناقيد_حرة_2 = عناقيد_حرة + 0
        نهاية
        إذا (فهرس_قسم == 3)
            قسم_عناقيد_حرة_3 = عناقيد_حرة + 0
        نهاية
    نهاية
    
    إذا (أول_حر != 4294967295)
        إذا (أول_حر >= 2)
            إذا (فهرس_قسم == 0)
                قسم_أول_حر_0 = أول_حر + 0
            نهاية
            إذا (فهرس_قسم == 1)
                قسم_أول_حر_1 = أول_حر + 0
            نهاية
            إذا (فهرس_قسم == 2)
                قسم_أول_حر_2 = أول_حر + 0
            نهاية
            إذا (فهرس_قسم == 3)
                قسم_أول_حر_3 = أول_حر + 0
            نهاية
        نهاية
    نهاية
    
    kfree(مخزن + 0)
    
    serial_puts("[FAT32] FSInfo: حرة=")
    serial_put_int(عناقيد_حرة + 0)
    serial_puts(" أول_حر=")
    serial_put_int(أول_حر + 0)
    serial_puts("\r\n")
    
    ارجع 0
