# ملف: fat32_نحلة.ص
# الوصف: نظام ملفات FAT32 — النواة الأساسية
# المشروع: نظام نحلة (BeeOS)
# الإصدار: 1.0.0
#
# يحتوي هذا الملف على التنفيذ الكامل لنظام ملفات FAT32
# بما في ذلك:
#   - تحليل قطاع الإقلاع (BPB - BIOS Parameter Block)
#   - إدارة جدول تخصيص الملفات (FAT)
#   - تتبع سلاسل العناقيد (Cluster Chains)
#   - تخصيص وتحرير العناقيد
#   - حساب مواقع القطاعات والعناقيد
#   - معلومات نظام الملفات (FSInfo)
#   - دعم أحجام قطاعات متعددة (512, 1024, 2048, 4096)
#
# معمارية FAT32:
#   قطاع الإقلاع → جدول FAT الأول → جدول FAT الثاني (نسخة احتياطية)
#   → منطقة البيانات (العناقيد)
#
# كل عنقود يتكون من عدة قطاعات متتالية
# جدول FAT يحتوي على مدخل واحد لكل عنقود
# قيمة المدخل تشير إلى العنقود التالي في السلسلة
#   0x00000000 = عنقود حر
#   0x0FFFFFF8-0x0FFFFFFF = نهاية السلسلة
#   0x0FFFFFF7 = عنقود تالف
#   قيمة أخرى = رقم العنقود التالي
#«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»«»

# =====================================================================
# الدوال الخارجية المستوردة من وحدات النواة الأخرى
# =====================================================================

# دوال الاتصال التسلسلي للتسجيل والتتبع
خارجي دالة serial_puts(رسالة)
خارجي دالة serial_put_int(قيمة)
خارجي دالة serial_put_hex(قيمة)

# دوال إدارة الذاكرة الديناميكية
خارجي دالة kmalloc(حجم)
خارجي دالة kfree(عنوان)

# دوال قراءة وكتابة المنافذ للوصول للأجهزة
خارجي دالة port_byte_in(منفذ)
خارجي دالة port_byte_out(منفذ، قيمة)

# دوال قراءة وكتابة الأقراص (ATA)
خارجي دالة ata_read_sector(محرك، قطاع، مخزن)
خارجي دالة ata_write_sector(محرك، قطاع، مخزن)
خارجي دالة ata_read_sectors(محرك، قطاع_بداية، عدد، مخزن)
خارجي دالة ata_write_sectors(محرك، قطاع_بداية، عدد، مخزن)

# دوال ذاكرة منخفضة المستوى
خارجي دالة mem_read_byte(عنوان، إزاحة)
خارجي دالة mem_write_byte(عنوان، إزاحة، قيمة)
خارجي دالة mem_read_word(عنوان، إزاحة)
خارجي دالة mem_write_word(عنوان، إزاحة، قيمة)
خارجي دالة mem_read_dword(عنوان، إزاحة)
خارجي دالة mem_write_dword(عنوان، إزاحة، قيمة)
خارجي دالة mem_copy(وجهة، مصدر، حجم)
خارجي دالة mem_set(وجهة، قيمة، حجم)

