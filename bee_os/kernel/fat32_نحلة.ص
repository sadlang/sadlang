    mem_write_dword(مخزن + 0، إزاحة + 0، قيمة_نهائية + 0)
    
    # كتابة القطاع في جدول FAT الأول
    ata_write_sector(محرك + 0، قطاع_مطلق + 0، مخزن + 0)
    
    # كتابة القطاع في جدول FAT الثاني (النسخة الاحتياطية)
