        قسم_قطاعات_محجوزة_0 = محجوزة + 0
        قسم_عدد_fat_0 = عدد_fat + 0
        قسم_حجم_fat_0 = حجم_fat + 0
        قسم_عنقود_جذر_0 = عنقود_جذر + 0
        قسم_قطاعات_كلي_0 = قطاعات_كلي + 0
        قسم_بداية_بيانات_0 = بداية_بيانات + 0
        قسم_عدد_عناقيد_0 = عدد_عناقيد + 0
        قسم_نوع_وسائط_0 = وسائط + 0
        قسم_قطاع_fsinfo_0 = قطاع_fsinfo + 0
        قسم_قطاع_احتياطي_0 = قطاع_احتياطي + 0
        قسم_رقم_تسلسلي_0 = رقم_تسلسلي + 0
        قسم_حجم_عنقود_0 = عرض_قطاع * قطاعات_عنقود
        قسم_بداية_fat1_0 = محجوزة + 0
        قسم_بداية_fat2_0 = محجوزة + حجم_fat
        قسم_مدخلات_fat_قطاع_0 = عرض_قطاع / 4
        قسم_قطاعات_مسار_0 = قطاعات_مسار + 0
        قسم_عدد_رؤوس_0 = عدد_رؤوس + 0
        قسم_حجم_ميجا_0 = (قطاعات_كلي * عرض_قطاع) / 1048576
    نهاية
    إذا (فهرس_قسم == 1)
        قسم_حالة_1 = 1
        قسم_محرك_1 = محرك + 0
        قسم_بداية_1 = قطاع_بداية + 0
