    نهاية
    
    متغير قطاع_مطلق = بداية + قطاع_fsinfo
    
    # قراءة القطاع الحالي (للحفاظ على التوقيعات)
    متغير مخزن = kmalloc(512)
    إذا (مخزن == 0)
