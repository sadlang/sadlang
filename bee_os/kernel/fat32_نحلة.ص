# تحليل قطاع الإقلاع لقسم FAT32 وتخزين المعلومات
# يُقرأ القطاع الأول من القسم ويُحلل حقول BPB
صدّر دالة fat32_حلل_bpb(فهرس_قسم، محرك، قطاع_بداية)
    serial_puts("[FAT32] تحليل BPB لقسم ")
    serial_put_int(فهرس_قسم + 0)
    serial_puts("...\r\n")
    
    # تخصيص مخزن لقراءة قطاع الإقلاع
    متغير مخزن = kmalloc(512)
    إذا (مخزن == 0)
        serial_puts("[FAT32] خطأ: فشل تخصيص ذاكرة لقطاع الإقلاع\r\n")
        ارجع -1
    نهاية
    
    # قراءة قطاع الإقلاع
    ata_read_sector(محرك + 0، قطاع_بداية + 0، مخزن + 0)
    
    # التحقق من توقيع الإقلاع (0x55AA في البايتين 510-511)
    متغير توقيع_منخفض = mem_read_byte(مخزن + 0، 510)
    متغير توقيع_مرتفع = mem_read_byte(مخزن + 0، 511)
    متغير توقيع = توقيع_منخفض + توقيع_مرتفع * 256
    
    إذا (توقيع != توقيع_إقلاع)
        serial_puts("[FAT32] خطأ: توقيع إقلاع غير صالح: ")
        serial_put_hex(توقيع + 0)
        serial_puts("\r\n")
        kfree(مخزن + 0)
        ارجع -1
    نهاية
    
    # قراءة حقول BPB الأساسية
    متغير عرض_قطاع = mem_read_word(مخزن + 0، إزاحة_عرض_لكل_قطاع + 0)
    متغير قطاعات_عنقود = mem_read_byte(مخزن + 0، إزاحة_قطاعات_لكل_عنقود + 0)
    متغير محجوزة = mem_read_word(مخزن + 0، إزاحة_قطاعات_محجوزة + 0)
    متغير عدد_fat = mem_read_byte(مخزن + 0، إزاحة_عدد_جداول_fat + 0)
    متغير وسائط = mem_read_byte(مخزن + 0، إزاحة_نوع_وسائط + 0)
    
    # FAT32: حجم FAT من الإزاحة 36 (32 بت)
    متغير حجم_fat = mem_read_dword(مخزن + 0، إزاحة_حجم_fat_32 + 0)
    
    # عنقود الدليل الجذر (عادة 2)
    متغير عنقود_جذر = mem_read_dword(مخزن + 0، إزاحة_عنقود_جذر + 0)
    
    # قطاع FSInfo
    متغير قطاع_fsinfo = mem_read_word(مخزن + 0، إزاحة_قطاع_fsinfo + 0)
    
    # قطاع الإقلاع الاحتياطي
    متغير قطاع_احتياطي = mem_read_word(مخزن + 0، إزاحة_قطاع_إقلاع_احتياطي + 0)
    
    # العدد الكلي للقطاعات (32 بت)
    متغير قطاعات_كلي = mem_read_dword(مخزن + 0، إزاحة_قطاعات_32 + 0)
    
    # الرقم التسلسلي
    متغير رقم_تسلسلي = mem_read_dword(مخزن + 0، إزاحة_رقم_تسلسلي + 0)
    
    # عدد القطاعات لكل مسار وعدد الرؤوس
    متغير قطاعات_مسار = mem_read_word(مخزن + 0، إزاحة_قطاعات_لكل_مسار + 0)
    متغير عدد_رؤوس = mem_read_word(مخزن + 0، إزاحة_عدد_رؤوس + 0)
    
    # التحقق من صحة القيم
    إذا (عرض_قطاع != 512)
        إذا (عرض_قطاع != 1024)
            إذا (عرض_قطاع != 2048)
                إذا (عرض_قطاع != 4096)
                    serial_puts("[FAT32] خطأ: حجم قطاع غير مدعوم: ")
                    serial_put_int(عرض_قطاع + 0)
                    serial_puts("\r\n")
                    kfree(مخزن + 0)
                    ارجع -1
                نهاية
            نهاية
        نهاية
    نهاية
    
    إذا (عدد_fat == 0)
        serial_puts("[FAT32] خطأ: عدد جداول FAT = 0\r\n")
        kfree(مخزن + 0)
        ارجع -1
    نهاية
    
    إذا (حجم_fat == 0)
        serial_puts("[FAT32] خطأ: حجم جدول FAT = 0\r\n")
        kfree(مخزن + 0)
        ارجع -1
    نهاية
    
    # حساب بداية منطقة البيانات
    # بداية_البيانات = القطاعات المحجوزة + (عدد_FAT × حجم_FAT)
    متغير بداية_بيانات = محجوزة + عدد_fat * حجم_fat
    
    # حساب عدد العناقيد الكلي
    # عدد_قطاعات_البيانات = قطاعات_كلي - بداية_البيانات
    # عدد_العناقيد = عدد_قطاعات_البيانات / قطاعات_لكل_عنقود
    متغير قطاعات_بيانات = قطاعات_كلي - بداية_بيانات
    متغير عدد_عناقيد = قطاعات_بيانات / قطاعات_عنقود
    
