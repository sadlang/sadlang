# الثوابت
# ═══════════════════════════════════════════════════════════════════════════════

# مقاس الصفحة
متغير ثابت_مقاس_صفحة = 4096

# ─── ثوابت المقاطع ───
# أقصى عدد مقاطع ذاكرة مشتركة
متغير ثابت_اقصى_مقاطع = 128
# أقصى مقاس لمقطع واحد (16MB)
متغير ثابت_اقصى_مقاس_مقطع = 16777216
# أقصى عدد ربطيات لمقطع واحد (عمليات مرتبطة)
متغير ثابت_اقصى_ربطيات = 64

# ─── وضعيات المقطع ───
متغير وضعية_حر = 0               # المقطع غير مستخدم
متغير وضعية_نشط = 1             # المقطع نشط ومرتبط
متغير وضعية_محجوز = 2            # المقطع محجوز (قيد الإنشاء)
متغير وضعية_محذوف = 3            # المقطع مُعلَّم للحذف (ينتظر فك جميع الربطيات)

# ─── أعلام الأذونات ───
# نموذج مبسط: 3 مستويات × 2 بت (قراءة، كتابة)
