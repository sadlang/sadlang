# بت 1: كتابة المالك
# بت 2: قراءة المجموعة
# بت 3: كتابة المجموعة
# بت 4: قراءة الآخرين
# بت 5: كتابة الآخرين
متغير إذن_قراءة_مالك = 1
متغير إذن_كتابة_مالك = 2
متغير إذن_قراءة_مجموعة = 4
متغير إذن_كتابة_مجموعة = 8
متغير إذن_قراءة_آخرين = 16
متغير إذن_كتابة_آخرين = 32

# أذونات افتراضية: قراءة وكتابة للجميع
متغير إذن_افتراضي = 63           # 0x3F = 111111

# ─── أعلام shmget ───
متغير علم_إنشاء = 512            # IPC_CREAT — إنشاء إذا لم يوجد
متغير علم_حصري = 1024            # IPC_EXCL — فشل إذا موجود بالفعل
متغير علم_خاص = 0                # IPC_PRIVATE — مفتاح خاص (0)

# ─── أعلام shmat ───
متغير علم_قراءة_فقط = 4096       # SHM_RDONLY
متغير علم_إعادة_ربط = 8192       # SHM_REMAP

# ─── ثوابت مفتاح IPC ───
متغير مفتاح_خاص = 0              # IPC_PRIVATE

# ─── ثوابت الربطيات ───
# كل ربطية: [معرف_مقطع، معرف_عملية، عنوان_ربط، أعلام]
متغير ثابت_عدد_حقول_ربط = 4
متغير ثابت_اقصى_ربطيات_كلي = 512   # إجمالي الربطيات في النظام

# ─── منطقة عناوين الذاكرة المشتركة ───
# العناوين المخصصة للذاكرة المشتركة في فضاء العناوين
متغير ثابت_بداية_منطقة_مشتركة = 536870912  # 512MB = 0x20000000
متغير ثابت_نهاية_منطقة_مشتركة = 603979776  # 576MB = 0x24000000

# ═══════════════════════════════════════════════════════════════════════════════
# المتغيرات العامة — حالة النظام
# ═══════════════════════════════════════════════════════════════════════════════

# هل تم التهيئة
متغير تم_التهيئة = 0

# ─── مصفوفات متوازية لمقاطع الذاكرة المشتركة ───
# كل مقطع يُمثَّل بفهرس واحد في هذه المصفوفات
متغير عنوان_مفاتيح = 0            # مفتاح IPC لكل مقطع
متغير عنوان_مقاسات = 0            # مقاس كل مقطع بالبايتات
متغير عنوان_مراجع = 0             # عداد المراجع لكل مقطع
متغير عنوان_ملاك = 0              # معرف المالك لكل مقطع
متغير عنوان_أذونات_مقاطع = 0     # أذونات كل مقطع
متغير عنوان_فيزيائي_مقاطع = 0    # العنوان الفيزيائي لبيانات كل مقطع
متغير عنوان_وضعيات = 0            # وضعية كل مقطع
متغير عنوان_زمن_إنشاء = 0        # زمن إنشاء كل مقطع
متغير عنوان_زمن_ربط = 0           # زمن آخر ربط
متغير عنوان_زمن_فك = 0            # زمن آخر فك ربط
متغير عنوان_صفحات_مقطع = 0       # عدد الصفحات لكل مقطع

# عدد المقاطع النشطة
متغير عدد_مقاطع_نشطة = 0
# المعرف التالي (يزداد باستمرار)
متغير معرف_مقطع_تالي = 1

# ─── جدول الربطيات ───
متغير عنوان_ربطيات_مقطع = 0      # معرف المقطع
متغير عنوان_ربطيات_عملية = 0     # معرف العملية
متغير عنوان_ربطيات_عنوان = 0     # عنوان الربط
متغير عنوان_ربطيات_اعلام = 0     # أعلام الربط
متغير عدد_ربطيات_نشطة = 0

# مؤشر العنوان التالي المتاح للربط
متغير عنوان_ربط_تالي = 0

# ═══════════════════════════════════════════════════════════════════════════════
# إحصائيات الذاكرة المشتركة
# ═══════════════════════════════════════════════════════════════════════════════
متغير عداد_shmget = 0              # عدد عمليات shmget
متغير عداد_shmat = 0               # عدد عمليات shmat
متغير عداد_shmdt = 0               # عدد عمليات shmdt
متغير عداد_إنشاء_مقطع = 0         # عدد المقاطع المُنشأة
متغير عداد_حذف_مقطع = 0           # عدد المقاطع المحذوفة
متغير عداد_رفض_إذن = 0            # عدد مرات رفض الأذونات
متغير عداد_فشل_تخصيص = 0         # عدد مرات فشل التخصيص
متغير إجمالي_ذاكرة_مشتركة = 0    # إجمالي الذاكرة المشتركة المخصصة

# ═══════════════════════════════════════════════════════════════════════════════
# دوال مساعدة داخلية
# ═══════════════════════════════════════════════════════════════════════════════

# حساب عدد الصفحات المطلوبة لمقاس معين
دالة حساب_صفحات(المقاس)
    ارجع (المقاس + ثابت_مقاس_صفحة - 1) / ثابت_مقاس_صفحة
نهاية

# قراءة حقل من مصفوفة مقاطع بالفهرس
دالة قراءة_حقل_مقطع(عنوان_مصفوفة، فهرس)
    ارجع mem_read_dword(عنوان_مصفوفة + (فهرس * 4))
نهاية

# كتابة حقل في مصفوفة مقاطع بالفهرس
دالة كتابة_حقل_مقطع(عنوان_مصفوفة، فهرس، قيمة)
    mem_write_dword(عنوان_مصفوفة + (فهرس * 4)، قيمة)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# البحث عن مقطع
# ═══════════════════════════════════════════════════════════════════════════════

# البحث عن مقطع بمفتاح IPC
# يُرجع فهرس المقطع أو -1 إذا لم يُوجد
دالة بحث_مقطع_بمفتاح(المفتاح)
    # المفتاح الخاص (0) لا يُبحث عنه — دائماً يُنشئ مقطعاً جديداً
    إذا (المفتاح == مفتاح_خاص)
        ارجع -1
    نهاية

    متغير م = 0
    بينما (م < ثابت_اقصى_مقاطع)
        متغير الوضعية = قراءة_حقل_مقطع(عنوان_وضعيات، م)
        # تجاهل المقاطع الحرة والمحذوفة
        إذا (الوضعية == وضعية_نشط)
            متغير مفتاح_مقطع = قراءة_حقل_مقطع(عنوان_مفاتيح، م)
            إذا (مفتاح_مقطع == المفتاح)
                ارجع م
            نهاية
        نهاية
        م = م + 1
    نهاية

    ارجع -1
نهاية

# البحث عن فتحة حرة في مصفوفة المقاطع
دالة بحث_فتحة_حرة()
    متغير م = 0
    بينما (م < ثابت_اقصى_مقاطع)
        متغير الوضعية = قراءة_حقل_مقطع(عنوان_وضعيات، م)
        إذا (الوضعية == وضعية_حر)
            ارجع م
        نهاية
        م = م + 1
    نهاية
    ارجع -1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# فحص الأذونات
# ═══════════════════════════════════════════════════════════════════════════════

# فحص هل لدى العملية إذن القراءة للمقطع
دالة فحص_إذن_قراءة(فهرس_مقطع، معرف_عملية)
    متغير أذونات_مقطع = قراءة_حقل_مقطع(عنوان_أذونات_مقاطع، فهرس_مقطع)
    متغير مالك_مقطع = قراءة_حقل_مقطع(عنوان_ملاك، فهرس_مقطع)

    # هل العملية هي المالكة؟
    إذا (معرف_عملية == مالك_مقطع)
        إذا ((أذونات_مقطع & إذن_قراءة_مالك) != 0)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    # فحص أذونات الآخرين
    إذا ((أذونات_مقطع & إذن_قراءة_آخرين) != 0)
        ارجع 1
    نهاية

    ارجع 0
نهاية

# فحص هل لدى العملية إذن الكتابة للمقطع
دالة فحص_إذن_كتابة(فهرس_مقطع، معرف_عملية)
    متغير أذونات_مقطع = قراءة_حقل_مقطع(عنوان_أذونات_مقاطع، فهرس_مقطع)
    متغير مالك_مقطع = قراءة_حقل_مقطع(عنوان_ملاك، فهرس_مقطع)

    # هل العملية هي المالكة؟
    إذا (معرف_عملية == مالك_مقطع)
        إذا ((أذونات_مقطع & إذن_كتابة_مالك) != 0)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    # فحص أذونات الآخرين
    إذا ((أذونات_مقطع & إذن_كتابة_آخرين) != 0)
        ارجع 1
    نهاية

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# shmget — إنشاء أو الحصول على مقطع ذاكرة مشتركة
# ═══════════════════════════════════════════════════════════════════════════════
#
# shmget(مفتاح، مقاس، أعلام) -> معرف المقطع أو -1 عند الفشل
#
# إذا كان المفتاح = 0 (IPC_PRIVATE): يُنشئ مقطعاً جديداً دائماً
# إذا كان المفتاح != 0:
#   - إذا وُجد مقطع بهذا المفتاح: يُرجع معرفه
#   - إذا لم يُوجد + IPC_CREAT: يُنشئ مقطعاً جديداً
#   - إذا لم يُوجد بدون IPC_CREAT: يُرجع -1

دالة shmget(المفتاح، المقاس، الاعلام)
    عداد_shmget = عداد_shmget + 1

    # فحص صحة المقاس
    إذا (المقاس <= 0)
        kernel_print_string("  [shm] عطل: مقاس المقطع يجب أن يكون > 0")
        kernel_print_number(10)
        ارجع -1
    نهاية

    إذا (المقاس > ثابت_اقصى_مقاس_مقطع)
        kernel_print_string("  [shm] عطل: المقاس يتجاوز الحد الأقصى")
        kernel_print_number(10)
        ارجع -1
    نهاية

    # البحث عن مقطع موجود بهذا المفتاح
    متغير فهرس_موجود = بحث_مقطع_بمفتاح(المفتاح)

    إذا (فهرس_موجود != -1)
        # المقطع موجود
        # هل طُلب الحصرية (IPC_EXCL)؟
        إذا ((الاعلام & علم_حصري) != 0)
            kernel_print_string("  [shm] عطل: المقطع موجود بالفعل (IPC_EXCL)")
            kernel_print_number(10)
            ارجع -1
        نهاية
        # إرجاع معرف المقطع الموجود
        ارجع فهرس_موجود
    نهاية

    # المقطع غير موجود — هل نُنشئ واحداً جديداً؟
    إذا (المفتاح != مفتاح_خاص)
        إذا ((الاعلام & علم_إنشاء) == 0)
            # لا يوجد مقطع ولا طُلب الإنشاء
            ارجع -1
        نهاية
    نهاية

    # إنشاء مقطع جديد
    ارجع إنشاء_مقطع_داخلي(المفتاح، المقاس، الاعلام & 63)
نهاية

# إنشاء مقطع داخلي — تنفيذ فعلي
دالة إنشاء_مقطع_داخلي(المفتاح، المقاس، الأذونات)
    # البحث عن فتحة حرة
    متغير فهرس = بحث_فتحة_حرة()
    إذا (فهرس == -1)
        kernel_print_string("  [shm] عطل: لا فتحات حرة للمقاطع")
        kernel_print_number(10)
        عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
        ارجع -1
    نهاية

    # حساب عدد الصفحات المطلوبة
    متغير عدد_صفح = حساب_صفحات(المقاس)

    # تخصيص الذاكرة الفيزيائية (صفحة صفحة)
    # نخصص صفحات متتالية عبر kernel_allocate
    متغير ذاكرة_فيزيائية = kernel_allocate(عدد_صفح * ثابت_مقاس_صفحة)
    إذا (ذاكرة_فيزيائية == 0)
        kernel_print_string("  [shm] عطل: فشل تخصيص الذاكرة الفيزيائية")
        kernel_print_number(10)
        عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
        ارجع -1
    نهاية

    # تصفير الذاكرة المخصصة
    sad_ll_memset(ذاكرة_فيزيائية، 0، عدد_صفح * ثابت_مقاس_صفحة)

    # حجز الفتحة
    كتابة_حقل_مقطع(عنوان_وضعيات، فهرس، وضعية_محجوز)

    # تعبئة معلومات المقطع
    كتابة_حقل_مقطع(عنوان_مفاتيح، فهرس، المفتاح)
    كتابة_حقل_مقطع(عنوان_مقاسات، فهرس، المقاس)
    كتابة_حقل_مقطع(عنوان_مراجع، فهرس، 0)
    كتابة_حقل_مقطع(عنوان_ملاك، فهرس، 0)

    # الأذونات
    متغير أذونات_فعلية = الأذونات
    إذا (أذونات_فعلية == 0)
        أذونات_فعلية = إذن_افتراضي
    نهاية
    كتابة_حقل_مقطع(عنوان_أذونات_مقاطع، فهرس، أذونات_فعلية)

    # العنوان الفيزيائي
    كتابة_حقل_مقطع(عنوان_فيزيائي_مقاطع، فهرس، ذاكرة_فيزيائية)

    # عدد الصفحات
    كتابة_حقل_مقطع(عنوان_صفحات_مقطع، فهرس، عدد_صفح)

    # الأزمنة (نستخدم عداد بسيط)
    كتابة_حقل_مقطع(عنوان_زمن_إنشاء، فهرس، عداد_إنشاء_مقطع)
    كتابة_حقل_مقطع(عنوان_زمن_ربط، فهرس، 0)
    كتابة_حقل_مقطع(عنوان_زمن_فك، فهرس، 0)

    # تنشيط المقطع
    كتابة_حقل_مقطع(عنوان_وضعيات، فهرس، وضعية_نشط)

    عدد_مقاطع_نشطة = عدد_مقاطع_نشطة + 1
    عداد_إنشاء_مقطع = عداد_إنشاء_مقطع + 1
    إجمالي_ذاكرة_مشتركة = إجمالي_ذاكرة_مشتركة + (عدد_صفح * ثابت_مقاس_صفحة)

    kernel_print_string("  [shm] تم إنشاء مقطع #")
    kernel_print_number(فهرس)
    kernel_print_string(" مفتاح=")
    kernel_print_number(المفتاح)
    kernel_print_string(" مقاس=")
    kernel_print_number(المقاس)
    kernel_print_string(" صفحات=")
    kernel_print_number(عدد_صفح)
    kernel_print_number(10)

    ارجع فهرس
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# shmat — ربط مقطع ذاكرة مشتركة بفضاء عناوين العملية
# ═══════════════════════════════════════════════════════════════════════════════
#
# shmat(معرف_مقطع، عنوان_مطلوب، أعلام، معرف_عملية) -> عنوان الربط أو 0
#
# إذا كان عنوان_مطلوب = 0: النظام يختار عنواناً مناسباً
# إذا كان عنوان_مطلوب != 0: يُحاول الربط عند ذلك العنوان

دالة shmat(معرف_مقطع، عنوان_مطلوب، الاعلام، معرف_عملية)
    عداد_shmat = عداد_shmat + 1

    # فحص صحة معرف المقطع
    إذا (معرف_مقطع < 0)
        kernel_print_string("  [shm] عطل shmat: معرف مقطع سالب")
        kernel_print_number(10)
        ارجع 0
    نهاية
    إذا (معرف_مقطع >= ثابت_اقصى_مقاطع)
        kernel_print_string("  [shm] عطل shmat: معرف مقطع خارج النطاق")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # فحص وضعية المقطع
    متغير الوضعية = قراءة_حقل_مقطع(عنوان_وضعيات، معرف_مقطع)
    إذا (الوضعية != وضعية_نشط)
        kernel_print_string("  [shm] عطل shmat: المقطع غير نشط")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # فحص الأذونات
    متغير له_قراءة = فحص_إذن_قراءة(معرف_مقطع، معرف_عملية)
    إذا (له_قراءة == 0)
        kernel_print_string("  [shm] رفض: لا إذن قراءة")
        kernel_print_number(10)
        عداد_رفض_إذن = عداد_رفض_إذن + 1
        ارجع 0
    نهاية

    # إذا لم يكن للقراءة فقط — فحص إذن الكتابة أيضاً
    إذا ((الاعلام & علم_قراءة_فقط) == 0)
        متغير له_كتابة = فحص_إذن_كتابة(معرف_مقطع، معرف_عملية)
        إذا (له_كتابة == 0)
            kernel_print_string("  [shm] رفض: لا إذن كتابة")
            kernel_print_number(10)
            عداد_رفض_إذن = عداد_رفض_إذن + 1
            ارجع 0
        نهاية
    نهاية

    # فحص هل العملية مرتبطة بالفعل
    متغير ربطية_موجودة = بحث_ربطية(معرف_مقطع، معرف_عملية)
    إذا (ربطية_موجودة != -1)
        إذا ((الاعلام & علم_إعادة_ربط) == 0)
            # مرتبطة بالفعل — نُرجع العنوان الحالي
            متغير عنوان_حالي = قراءة_حقل_مقطع(عنوان_ربطيات_عنوان، ربطية_موجودة)
            ارجع عنوان_حالي
        نهاية
        # إعادة ربط مطلوبة — نفك أولاً
        فك_ربطية_داخلي(ربطية_موجودة)
    نهاية

    # تحديد عنوان الربط
    متغير عنوان_ربط = عنوان_مطلوب
    إذا (عنوان_ربط == 0)
        # اختيار عنوان تلقائي
        متغير مقاس_مقطع = قراءة_حقل_مقطع(عنوان_مقاسات، معرف_مقطع)
        متغير صفحات = حساب_صفحات(مقاس_مقطع)
        عنوان_ربط = عنوان_ربط_تالي
        عنوان_ربط_تالي = عنوان_ربط_تالي + (صفحات * ثابت_مقاس_صفحة)

        # فحص عدم تجاوز حدود المنطقة
        إذا (عنوان_ربط_تالي > ثابت_نهاية_منطقة_مشتركة)
            kernel_print_string("  [shm] عطل: تجاوز حدود منطقة الذاكرة المشتركة")
            kernel_print_number(10)
            ارجع 0
        نهاية
    نهاية

    # البحث عن فتحة حرة في جدول الربطيات
    متغير فتحة_ربط = بحث_فتحة_ربطية_حرة()
    إذا (فتحة_ربط == -1)
        kernel_print_string("  [shm] عطل: لا فتحات حرة في جدول الربطيات")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # تسجيل الربطية
    كتابة_حقل_مقطع(عنوان_ربطيات_مقطع، فتحة_ربط، معرف_مقطع)
    كتابة_حقل_مقطع(عنوان_ربطيات_عملية، فتحة_ربط، معرف_عملية)
    كتابة_حقل_مقطع(عنوان_ربطيات_عنوان، فتحة_ربط، عنوان_ربط)
    كتابة_حقل_مقطع(عنوان_ربطيات_اعلام، فتحة_ربط، الاعلام)

    # زيادة عداد المراجع
    متغير مراجع_حالية = قراءة_حقل_مقطع(عنوان_مراجع، معرف_مقطع)
    كتابة_حقل_مقطع(عنوان_مراجع، معرف_مقطع، مراجع_حالية + 1)

    # تحديث زمن الربط
    كتابة_حقل_مقطع(عنوان_زمن_ربط، معرف_مقطع، عداد_shmat)

    عدد_ربطيات_نشطة = عدد_ربطيات_نشطة + 1

    kernel_print_string("  [shm] ربط مقطع #")
    kernel_print_number(معرف_مقطع)
    kernel_print_string(" للعملية ")
    kernel_print_number(معرف_عملية)
    kernel_print_string(" عند ")
    kernel_print_number(عنوان_ربط)
    kernel_print_number(10)

    ارجع عنوان_ربط
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# shmdt — فك ربط مقطع ذاكرة مشتركة
# ═══════════════════════════════════════════════════════════════════════════════
#
# shmdt(عنوان_ربط، معرف_عملية) -> 0 عند النجاح أو -1 عند الفشل

دالة shmdt(عنوان_ربط، معرف_عملية)
    عداد_shmdt = عداد_shmdt + 1

    # البحث عن الربطية
    متغير فهرس_ربطية = بحث_ربطية_بعنوان(عنوان_ربط، معرف_عملية)
    إذا (فهرس_ربطية == -1)
        kernel_print_string("  [shm] عطل shmdt: لم يُعثر على ربطية")
        kernel_print_number(10)
        ارجع -1
    نهاية

    # فك الربطية
    فك_ربطية_داخلي(فهرس_ربطية)

    kernel_print_string("  [shm] فك ربط عند ")
    kernel_print_number(عنوان_ربط)
    kernel_print_string(" للعملية ")
    kernel_print_number(معرف_عملية)
    kernel_print_number(10)

    ارجع 0
نهاية

# فك ربطية داخلي
دالة فك_ربطية_داخلي(فهرس_ربطية)
    # قراءة معرف المقطع
    متغير معرف_المقطع = قراءة_حقل_مقطع(عنوان_ربطيات_مقطع، فهرس_ربطية)

    # تنقيص عداد المراجع
    متغير مراجع = قراءة_حقل_مقطع(عنوان_مراجع، معرف_المقطع)
    إذا (مراجع > 0)
        كتابة_حقل_مقطع(عنوان_مراجع، معرف_المقطع، مراجع - 1)
    نهاية

    # تحديث زمن الفك
    كتابة_حقل_مقطع(عنوان_زمن_فك، معرف_المقطع، عداد_shmdt)

    # حذف الربطية
    كتابة_حقل_مقطع(عنوان_ربطيات_مقطع، فهرس_ربطية، 0)
    كتابة_حقل_مقطع(عنوان_ربطيات_عملية، فهرس_ربطية، 0)
    كتابة_حقل_مقطع(عنوان_ربطيات_عنوان، فهرس_ربطية، 0)
    كتابة_حقل_مقطع(عنوان_ربطيات_اعلام، فهرس_ربطية، 0)

    عدد_ربطيات_نشطة = عدد_ربطيات_نشطة - 1

    # فحص هل المقطع مُعلَّم للحذف وعداد المراجع = 0
    متغير وضعية_مقطع = قراءة_حقل_مقطع(عنوان_وضعيات، معرف_المقطع)
    متغير مراجع_جديدة = قراءة_حقل_مقطع(عنوان_مراجع، معرف_المقطع)

    إذا (وضعية_مقطع == وضعية_محذوف)
        إذا (مراجع_جديدة == 0)
            # حذف المقطع نهائياً
            حذف_مقطع_نهائي(معرف_المقطع)
        نهاية
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# shmctl — التحكم بمقطع الذاكرة المشتركة
# ═══════════════════════════════════════════════════════════════════════════════

# تعليم مقطع للحذف
# سيُحذف فعلياً عندما يصل عداد المراجع إلى 0
دالة تعليم_مقطع_للحذف(معرف_مقطع)
    إذا (معرف_مقطع < 0)
        ارجع -1
    نهاية
    إذا (معرف_مقطع >= ثابت_اقصى_مقاطع)
        ارجع -1
    نهاية

    متغير الوضعية = قراءة_حقل_مقطع(عنوان_وضعيات، معرف_مقطع)
    إذا (الوضعية != وضعية_نشط)
        ارجع -1
    نهاية

    # فحص عداد المراجع
    متغير مراجع = قراءة_حقل_مقطع(عنوان_مراجع، معرف_مقطع)
    إذا (مراجع == 0)
        # لا عمليات مرتبطة — حذف فوري
        حذف_مقطع_نهائي(معرف_مقطع)
    وإلا
        # عمليات مرتبطة — تعليم للحذف
        كتابة_حقل_مقطع(عنوان_وضعيات، معرف_مقطع، وضعية_محذوف)
        kernel_print_string("  [shm] مقطع #")
        kernel_print_number(معرف_مقطع)
        kernel_print_string(" مُعلَّم للحذف (")
        kernel_print_number(مراجع)
        kernel_print_string(" ربطيات نشطة)")
        kernel_print_number(10)
    نهاية

    ارجع 0
نهاية

# حذف مقطع نهائياً — تحرير الذاكرة
دالة حذف_مقطع_نهائي(فهرس_مقطع)
    # قراءة العنوان الفيزيائي
    متغير عنوان_فيزيائي = قراءة_حقل_مقطع(عنوان_فيزيائي_مقاطع، فهرس_مقطع)
    متغير عدد_صفح = قراءة_حقل_مقطع(عنوان_صفحات_مقطع، فهرس_مقطع)

    # تحديث الإحصائيات
    إجمالي_ذاكرة_مشتركة = إجمالي_ذاكرة_مشتركة - (عدد_صفح * ثابت_مقاس_صفحة)
    عدد_مقاطع_نشطة = عدد_مقاطع_نشطة - 1
    عداد_حذف_مقطع = عداد_حذف_مقطع + 1

    # تصفير جميع حقول المقطع
    كتابة_حقل_مقطع(عنوان_مفاتيح، فهرس_مقطع، 0)
    كتابة_حقل_مقطع(عنوان_مقاسات، فهرس_مقطع، 0)
    كتابة_حقل_مقطع(عنوان_مراجع، فهرس_مقطع، 0)
    كتابة_حقل_مقطع(عنوان_ملاك، فهرس_مقطع، 0)
    كتابة_حقل_مقطع(عنوان_أذونات_مقاطع، فهرس_مقطع، 0)
    كتابة_حقل_مقطع(عنوان_فيزيائي_مقاطع، فهرس_مقطع، 0)
    كتابة_حقل_مقطع(عنوان_صفحات_مقطع، فهرس_مقطع، 0)
    كتابة_حقل_مقطع(عنوان_وضعيات، فهرس_مقطع، وضعية_حر)
    كتابة_حقل_مقطع(عنوان_زمن_إنشاء، فهرس_مقطع، 0)
    كتابة_حقل_مقطع(عنوان_زمن_ربط، فهرس_مقطع، 0)
    كتابة_حقل_مقطع(عنوان_زمن_فك، فهرس_مقطع، 0)

    kernel_print_string("  [shm] حُذف مقطع #")
    kernel_print_number(فهرس_مقطع)
    kernel_print_string(" وتم تحرير ")
    kernel_print_number(عدد_صفح)
    kernel_print_string(" صفحات")
    kernel_print_number(10)
نهاية

# تغيير أذونات مقطع
دالة تغيير_أذونات_مقطع(معرف_مقطع، أذونات_جديدة، معرف_عملية)
    إذا (معرف_مقطع < 0)
        ارجع -1
    نهاية
    إذا (معرف_مقطع >= ثابت_اقصى_مقاطع)
        ارجع -1
    نهاية

    # فقط المالك يمكنه تغيير الأذونات
    متغير المالك = قراءة_حقل_مقطع(عنوان_ملاك، معرف_مقطع)
    إذا (معرف_عملية != المالك)
        عداد_رفض_إذن = عداد_رفض_إذن + 1
        ارجع -1
    نهاية

    كتابة_حقل_مقطع(عنوان_أذونات_مقاطع، معرف_مقطع، أذونات_جديدة & 63)
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# دوال البحث في جدول الربطيات
# ═══════════════════════════════════════════════════════════════════════════════

# البحث عن ربطية بمعرف المقطع ومعرف العملية
دالة بحث_ربطية(معرف_مقطع، معرف_عملية)
    متغير م = 0
    بينما (م < ثابت_اقصى_ربطيات_كلي)
        متغير مقطع = قراءة_حقل_مقطع(عنوان_ربطيات_مقطع، م)
        متغير عملية = قراءة_حقل_مقطع(عنوان_ربطيات_عملية، م)
        إذا (مقطع == معرف_مقطع)
            إذا (عملية == معرف_عملية)
                ارجع م
            نهاية
        نهاية
        م = م + 1
    نهاية
    ارجع -1
نهاية

# البحث عن ربطية بعنوان الربط ومعرف العملية
دالة بحث_ربطية_بعنوان(العنوان، معرف_عملية)
    متغير م = 0
    بينما (م < ثابت_اقصى_ربطيات_كلي)
        متغير عنوان_مخزن = قراءة_حقل_مقطع(عنوان_ربطيات_عنوان، م)
        متغير عملية = قراءة_حقل_مقطع(عنوان_ربطيات_عملية، م)
        إذا (عنوان_مخزن == العنوان)
            إذا (عملية == معرف_عملية)
                ارجع م
            نهاية
        نهاية
        م = م + 1
    نهاية
    ارجع -1
نهاية

# البحث عن فتحة ربطية حرة
دالة بحث_فتحة_ربطية_حرة()
    متغير م = 0
    بينما (م < ثابت_اقصى_ربطيات_كلي)
        متغير مقطع = قراءة_حقل_مقطع(عنوان_ربطيات_مقطع، م)
        متغير عملية = قراءة_حقل_مقطع(عنوان_ربطيات_عملية، م)
        # فتحة حرة إذا كلا الحقلين = 0
        إذا (مقطع == 0)
            إذا (عملية == 0)
                ارجع م
            نهاية
        نهاية
        م = م + 1
    نهاية
    ارجع -1
نهاية

# فك جميع ربطيات عملية (تُستخدم عند إنهاء العملية)
دالة فك_ربطيات_عملية(معرف_عملية)
    متغير عدد_مفكوكة = 0
    متغير م = 0
    بينما (م < ثابت_اقصى_ربطيات_كلي)
        متغير عملية = قراءة_حقل_مقطع(عنوان_ربطيات_عملية، م)
        إذا (عملية == معرف_عملية)
            فك_ربطية_داخلي(م)
            عدد_مفكوكة = عدد_مفكوكة + 1
        نهاية
        م = م + 1
    نهاية

    إذا (عدد_مفكوكة > 0)
        kernel_print_string("  [shm] فُكت ")
        kernel_print_number(عدد_مفكوكة)
        kernel_print_string(" ربطيات للعملية ")
        kernel_print_number(معرف_عملية)
        kernel_print_number(10)
    نهاية

    ارجع عدد_مفكوكة
نهاية

