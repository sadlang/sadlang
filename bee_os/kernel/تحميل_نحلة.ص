# ══════════════════════════════════════════════
# القسم 3: التحميل والفك
# ══════════════════════════════════════════════

صدّر دالة تحميل_حمّل(جهاز، قسم، نوع_نظام، أعلام_تحميل)
    متغير ع = 0
    بينما (ع < 8)
        متغير فعال = اقرأ_تحميل(ع، 4)
        إذا (فعال == 0)
            اكتب_تحميل(ع، 0، جهاز)
            اكتب_تحميل(ع، 1، قسم)
            اكتب_تحميل(ع، 2، نوع_نظام)
            اكتب_تحميل(ع، 3، أعلام_تحميل)
            اكتب_تحميل(ع، 4، 1)
            اكتب_تحميل(ع، 5، 0)
            عدد_التحميلات = عدد_التحميلات + 1
            ارجع ع
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية

صدّر دالة تحميل_فك(فهرس)
    إذا (فهرس < 0) ارجع -1 نهاية
    إذا (فهرس >= 8) ارجع -1 نهاية
    
    متغير فعال = اقرأ_تحميل(فهرس، 4)
    إذا (فعال == 0) ارجع -1 نهاية
    
    متغير استخدام = اقرأ_تحميل(فهرس، 5)
    إذا (استخدام > 0)
        kernel_print_string("  [mount] WARNING: busy, refcount=")
        kernel_print_number(استخدام)
        kernel_print_number(10)
        ارجع -2
    نهاية
    
    اكتب_تحميل(فهرس، 4، 0)
    عدد_الفك = عدد_الفك + 1
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# القسم 4: تقرير + تهيئة
# ══════════════════════════════════════════════

صدّر دالة تحميل_تقرير()
    kernel_print_string("=== Mount Manager Report ===")
    kernel_print_number(10)
    
    متغير ع = 0
    بينما (ع < 8)
        متغير فعال = اقرأ_تحميل(ع، 4)
        إذا (فعال == 1)
            kernel_print_string("  [")
            kernel_print_number(ع)
            kernel_print_string("] dev=")
            kernel_print_number(اقرأ_تحميل(ع، 0))
            kernel_print_string(" part=")
            kernel_print_number(اقرأ_تحميل(ع، 1))
            kernel_print_string(" fs=")
            kernel_print_number(اقرأ_تحميل(ع، 2))
            kernel_print_string(" flags=")
            kernel_print_number(اقرأ_تحميل(ع، 3))
            kernel_print_number(10)
        نهاية
        ع = ع + 1
    نهاية
    
    kernel_print_string("  Mounts: ")
    kernel_print_number(عدد_التحميلات)
    kernel_print_string("  Unmounts: ")
    kernel_print_number(عدد_الفك)
    kernel_print_number(10)
    ارجع 0
نهاية

