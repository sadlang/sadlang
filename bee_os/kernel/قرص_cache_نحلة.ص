## القسم ١١: Pre-fetch — قراءة استباقية
## ═══════════════════════════════════════════════════════════════

## آخر قطاع تم قراءته (لاكتشاف النمط التسلسلي)
متغير prefetch_آخر_قرص = -1
متغير prefetch_آخر_lba = -1
متغير prefetch_عداد_تسلسلي = 0

## عدد القطاعات للقراءة الاستباقية
ثابت PREFETCH_AHEAD = 4

## قراءة مع Pre-fetch (تقرأ القطاعات التالية مسبقاً)
صدّر دالة cache_اقرأ_مع_prefetch(فهرس_القرص، رقم_القطاع، عنوان_الوجهة)
    # القراءة الأساسية
    متغير نتيجة = cache_اقرأ_قطاع(فهرس_القرص، رقم_القطاع، عنوان_الوجهة)
    إذا (نتيجة != 0)
        ارجع نتيجة
    نهاية
    
    # اكتشاف نمط تسلسلي
    إذا (فهرس_القرص == prefetch_آخر_قرص)
        إذا (رقم_القطاع == prefetch_آخر_lba + 1)
            prefetch_عداد_تسلسلي = prefetch_عداد_تسلسلي + 1
        وإلا
            prefetch_عداد_تسلسلي = 0
        نهاية
    وإلا
        prefetch_عداد_تسلسلي = 0
    نهاية
    
    prefetch_آخر_قرص = فهرس_القرص
    prefetch_آخر_lba = رقم_القطاع
    
    # إذا اكتشفنا نمطاً تسلسلياً (3 قراءات متتالية)
    إذا (prefetch_عداد_تسلسلي >= 3)
        # قراءة استباقية للقطاعات التالية
        متغير ق = 1
        بينما (ق <= PREFETCH_AHEAD)
            متغير lba_القادم = رقم_القطاع + ق
            # فحص إذا كان القطاع موجوداً في الكاش بالفعل
            متغير فهرس_موجود = cache_ابحث(فهرس_القرص، lba_القادم)
            إذا (فهرس_موجود < 0)
                # غير موجود — اقرأه في الخلفية
                متغير سطر = cache_سطر_LRU()
                إذا (cache_حالة[سطر] != CACHE_LOCKED)
                    إذا (cache_حالة[سطر] == CACHE_DIRTY)
                        cache_أخلِ_سطر(سطر)
                    وإلا
                        إذا (cache_حالة[سطر] != CACHE_EMPTY)
                            cache_حالة[سطر] = CACHE_EMPTY
                        نهاية
                    نهاية
                    
                    متغير نتيجة_pf = disk_اقرأ_كتلة(فهرس_القرص، lba_القادم، 1، cache_عنوان[سطر])
                    إذا (نتيجة_pf > 0)
                        cache_حالة[سطر] = CACHE_CLEAN
                        cache_قرص[سطر] = فهرس_القرص
                        cache_lba[سطر] = lba_القادم
                        cache_عداد_LRU = cache_عداد_LRU + 1
                        cache_استخدام[سطر] = cache_عداد_LRU
                    نهاية
                نهاية
            نهاية
            ق = ق + 1
        نهاية
    نهاية
    
    ارجع 0
نهاية

