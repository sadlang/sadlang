خارجي("sad_ll_pages_free") دالة cache_حرر_صفحات(عنوان_الصفحات، عدد_الصفحات)

## واجهات القرص (من قرص_نحلة.ص)
خارجي("اقرأ_كتلة") دالة disk_اقرأ_كتلة(فهرس_القرص، رقم_القطاع، عدد_القطاعات، عنوان_المخزن)
خارجي("اكتب_كتلة") دالة disk_اكتب_كتلة(فهرس_القرص، رقم_القطاع، عدد_القطاعات، عنوان_المصدر)

