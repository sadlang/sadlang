## واجهات FFI
## ─────────────────────────────────────────────────────

خارجي("sad_ll_mem_read64") دالة cache_اقرأ_ذاكرة(عنوان_الذاكرة)
خارجي("sad_ll_mem_write64") دالة cache_اكتب_ذاكرة(عنوان_الذاكرة، قيمة)
خارجي("sad_ll_mem_read32") دالة cache_اقرأ_ذاكرة32(عنوان_الذاكرة)
خارجي("sad_ll_mem_write32") دالة cache_اكتب_ذاكرة32(عنوان_الذاكرة، قيمة)
خارجي("sad_ll_memset") دالة cache_املأ_ذاكرة(عنوان_الذاكرة، قيمة، طول)
خارجي("sad_ll_memcpy") دالة cache_انسخ_ذاكرة(وجهة، مصدر، طول)
خارجي("sad_ll_serial_write_char") دالة cache_اكتب_حرف(منفذ، حرف)
خارجي("sad_ll_interrupt_disable") دالة cache_عطّل_مقاطعات()
خارجي("sad_ll_interrupt_enable") دالة cache_فعّل_مقاطعات()
خارجي("sad_ll_page_alloc") دالة cache_خصص_صفحة()
خارجي("sad_ll_page_free") دالة cache_حرر_صفحة(عنوان_الصفحة)
