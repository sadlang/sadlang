## ═══════════════════════════════════════════════════════════════
## القسم ٣: تهيئة الكاش
## ═══════════════════════════════════════════════════════════════

## تهيئة ذاكرة التخزين المؤقت
## تخصيص ذاكرة لكل سطر كاش
صدّر دالة هيئ_الكاش()
    إذا (cache_مهيأ == 1)
        ارجع 0
    نهاية
    
    # تخصيص صفحات ذاكرة لأسطر الكاش
    # كل سطر = 512 بايت، 64 سطر بالمجموع
    # 64 سطر * 512 = 32KB = 8 صفحات
    متغير عنوان_البيانات = cache_خصص_صفحات(8)
    إذا (عنوان_البيانات == 0)
        ارجع -1
    نهاية
    cache_املأ_ذاكرة(عنوان_البيانات، 0، 32768)
    
    # توزيع العناوين على أسطر الكاش
    متغير ك = 0
    بينما (ك < 64)
        cache_حالة[ك] = CACHE_EMPTY
        cache_قرص[ك] = 0
        cache_lba[ك] = 0
        cache_استخدام[ك] = 0
        cache_عنوان[ك] = عنوان_البيانات + (ك * 512)
        ك = ك + 1
    نهاية
    
    # إعادة تعيين الإحصائيات
    cache_إصابات = 0
    cache_إخفاقات = 0
    cache_كتابات_مؤجلة = 0
    cache_تفريغات = 0
    cache_إخلاءات = 0
    cache_عمليات_قراءة = 0
    cache_عمليات_كتابة = 0
    cache_عداد_LRU = 0
    
    cache_مهيأ = 1
    
    cache_اكتب_حرف(COM1، 91)   # '['
    cache_اكتب_حرف(COM1، 67)   # 'C'
    cache_اكتب_حرف(COM1، 65)   # 'A'
    cache_اكتب_حرف(COM1، 67)   # 'C'
    cache_اكتب_حرف(COM1، 72)   # 'H'
    cache_اكتب_حرف(COM1، 69)   # 'E'
    cache_اكتب_حرف(COM1، 93)   # ']'
    cache_اكتب_حرف(COM1، 32)   # ' '
    cache_اكتب_حرف(COM1، 79)   # 'O'
    cache_اكتب_حرف(COM1، 75)   # 'K'
    cache_اكتب_حرف(COM1، 10)   # '\n'
    
    ارجع 0
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٤: البحث في الكاش
## ═══════════════════════════════════════════════════════════════

## البحث عن سطر كاش لقطاع معين
## يُعيد: فهرس السطر أو -1 إذا لم يُوجد
دالة cache_ابحث(فهرس_القرص، رقم_القطاع)
    متغير ك = 0
    بينما (ك < 64)
        إذا (cache_حالة[ك] != CACHE_EMPTY)
            إذا (cache_قرص[ك] == فهرس_القرص)
                إذا (cache_lba[ك] == رقم_القطاع)
                    # وجدناه! تحديث عداد LRU
                    cache_عداد_LRU = cache_عداد_LRU + 1
                    cache_استخدام[ك] = cache_عداد_LRU
                    ارجع ك
                نهاية
            نهاية
        نهاية
        ك = ك + 1
    نهاية
    ارجع -1
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٥: اختيار سطر للإخلاء (LRU Eviction)
## ═══════════════════════════════════════════════════════════════

## البحث عن سطر فارغ
## يُعيد: فهرس سطر فارغ أو -1
دالة cache_سطر_فارغ()
    متغير ك = 0
    بينما (ك < 64)
        إذا (cache_حالة[ك] == CACHE_EMPTY)
            ارجع ك
        نهاية
        ك = ك + 1
    نهاية
    ارجع -1
نهاية

## اختيار سطر LRU (الأقل استخداماً حديثاً) للإخلاء
## يُعيد: فهرس السطر الذي يجب إخلاؤه
دالة cache_سطر_LRU()
    # أولاً: ابحث عن سطر فارغ
    متغير فارغ = cache_سطر_فارغ()
    إذا (فارغ >= 0)
        ارجع فارغ
    نهاية
    
    # لا يوجد سطر فارغ — ابحث عن الأقل استخداماً
    # تجنب الأسطر المقفلة
    متغير أقل_استخدام = cache_عداد_LRU + 1
    متغير أقل_فهرس = 0
    
    متغير ك = 0
    بينما (ك < 64)
        إذا (cache_حالة[ك] != CACHE_LOCKED)
            إذا (cache_استخدام[ك] < أقل_استخدام)
                أقل_استخدام = cache_استخدام[ك]
                أقل_فهرس = ك
            نهاية
        نهاية
        ك = ك + 1
    نهاية
    
    ارجع أقل_فهرس
نهاية

## إخلاء سطر كاش — كتابته للقرص إذا كان معدلاً
## يُعيد: 0=نجاح، -1=خطأ
دالة cache_أخلِ_سطر(فهرس_السطر)
    إذا (فهرس_السطر < 0)
        ارجع -1
    نهاية
    إذا (فهرس_السطر >= 64)
        ارجع -1
    نهاية
    إذا (cache_حالة[فهرس_السطر] == CACHE_EMPTY)
        ارجع 0
    نهاية
    إذا (cache_حالة[فهرس_السطر] == CACHE_LOCKED)
        ارجع -1  # لا يمكن إخلاء سطر مقفل
    نهاية
    
    # إذا كان السطر معدلاً، اكتبه للقرص
    إذا (cache_حالة[فهرس_السطر] == CACHE_DIRTY)
        متغير نتيجة = disk_اكتب_كتلة(
            cache_قرص[فهرس_السطر]،
            cache_lba[فهرس_السطر]،
            1،
            cache_عنوان[فهرس_السطر]
        )
        إذا (نتيجة == 0)
            ارجع -1
        نهاية
        cache_كتابات_مؤجلة = cache_كتابات_مؤجلة + 1
    نهاية
    
    # تفريغ السطر
    cache_حالة[فهرس_السطر] = CACHE_EMPTY
    cache_إخلاءات = cache_إخلاءات + 1
    
    ارجع 0
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٦: قراءة عبر الكاش
## ═══════════════════════════════════════════════════════════════

## قراءة قطاع واحد عبر الكاش
## يُعيد: 0=نجاح، -1=خطأ
صدّر دالة cache_اقرأ_قطاع(فهرس_القرص، رقم_القطاع، عنوان_الوجهة)
    إذا (cache_مهيأ == 0)
        # الكاش غير مهيأ — قراءة مباشرة
        متغير نتيجة = disk_اقرأ_كتلة(فهرس_القرص، رقم_القطاع، 1، عنوان_الوجهة)
        إذا (نتيجة > 0)
            ارجع 0
        نهاية
        ارجع -1
    نهاية
    
    cache_عمليات_قراءة = cache_عمليات_قراءة + 1
    
    # البحث في الكاش
    متغير فهرس = cache_ابحث(فهرس_القرص، رقم_القطاع)
    
    إذا (فهرس >= 0)
        # إصابة! نسخ البيانات من الكاش
        cache_إصابات = cache_إصابات + 1
        cache_انسخ_ذاكرة(عنوان_الوجهة، cache_عنوان[فهرس]، حجم_القطاع_CACHE)
        ارجع 0
    نهاية
    
    # إخفاق — نحتاج قراءة من القرص
    cache_إخفاقات = cache_إخفاقات + 1
    
    # اختر سطراً للاستخدام
    متغير سطر = cache_سطر_LRU()
    
    # إخلاء السطر القديم إذا لزم
    إذا (cache_حالة[سطر] != CACHE_EMPTY)
        متغير نتيجة_إخلاء = cache_أخلِ_سطر(سطر)
        إذا (نتيجة_إخلاء != 0)
            # فشل الإخلاء — قراءة مباشرة دون كاش
            متغير نتيجة_مباشرة = disk_اقرأ_كتلة(فهرس_القرص، رقم_القطاع، 1، عنوان_الوجهة)
            إذا (نتيجة_مباشرة > 0)
                ارجع 0
            نهاية
            ارجع -1
        نهاية
    نهاية
    
    # قراءة من القرص إلى سطر الكاش
    متغير نتيجة_قراءة = disk_اقرأ_كتلة(فهرس_القرص، رقم_القطاع، 1، cache_عنوان[سطر])
    إذا (نتيجة_قراءة == 0)
        ارجع -1
    نهاية
    
    # تحديث معلومات السطر
    cache_حالة[سطر] = CACHE_CLEAN
    cache_قرص[سطر] = فهرس_القرص
    cache_lba[سطر] = رقم_القطاع
    cache_عداد_LRU = cache_عداد_LRU + 1
    cache_استخدام[سطر] = cache_عداد_LRU
    
    # نسخ البيانات إلى الوجهة
    cache_انسخ_ذاكرة(عنوان_الوجهة، cache_عنوان[سطر]، حجم_القطاع_CACHE)
    
    ارجع 0
نهاية

## قراءة عدة قطاعات عبر الكاش
## يُعيد: عدد القطاعات المقروءة بنجاح
صدّر دالة cache_اقرأ_قطاعات(فهرس_القرص، رقم_القطاع، عدد_القطاعات، عنوان_الوجهة)
    متغير مقروء = 0
    متغير ق = 0
    بينما (ق < عدد_القطاعات)
        متغير نتيجة = cache_اقرأ_قطاع(فهرس_القرص، رقم_القطاع + ق، عنوان_الوجهة + (ق * حجم_القطاع_CACHE))
        إذا (نتيجة != 0)
            ارجع مقروء
        نهاية
        مقروء = مقروء + 1
        ق = ق + 1
    نهاية
    ارجع مقروء
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٧: كتابة عبر الكاش
## ═══════════════════════════════════════════════════════════════

## كتابة قطاع واحد عبر الكاش (Write-Back)
## البيانات تُكتب في الكاش فقط وتُعلّم كمعدلة
## يُعيد: 0=نجاح، -1=خطأ
صدّر دالة cache_اكتب_قطاع(فهرس_القرص، رقم_القطاع، عنوان_المصدر)
    إذا (cache_مهيأ == 0)
        # كتابة مباشرة
        متغير نتيجة = disk_اكتب_كتلة(فهرس_القرص، رقم_القطاع، 1، عنوان_المصدر)
        إذا (نتيجة > 0)
            ارجع 0
        نهاية
        ارجع -1
    نهاية
    
    cache_عمليات_كتابة = cache_عمليات_كتابة + 1
    
    # البحث في الكاش
    متغير فهرس = cache_ابحث(فهرس_القرص، رقم_القطاع)
    
    إذا (فهرس >= 0)
        # السطر موجود — تحديث البيانات
        cache_إصابات = cache_إصابات + 1
        cache_انسخ_ذاكرة(cache_عنوان[فهرس]، عنوان_المصدر، حجم_القطاع_CACHE)
        cache_حالة[فهرس] = CACHE_DIRTY
        ارجع 0
    نهاية
    
    # السطر غير موجود — تخصيص سطر جديد
    cache_إخفاقات = cache_إخفاقات + 1
    
    متغير سطر = cache_سطر_LRU()
    
    # إخلاء السطر القديم
    إذا (cache_حالة[سطر] != CACHE_EMPTY)
        cache_أخلِ_سطر(سطر)
    نهاية
    
    # نسخ البيانات الجديدة
    cache_انسخ_ذاكرة(cache_عنوان[سطر]، عنوان_المصدر، حجم_القطاع_CACHE)
    
    # تحديث معلومات السطر
    cache_حالة[سطر] = CACHE_DIRTY
    cache_قرص[سطر] = فهرس_القرص
    cache_lba[سطر] = رقم_القطاع
    cache_عداد_LRU = cache_عداد_LRU + 1
    cache_استخدام[سطر] = cache_عداد_LRU
    
    ارجع 0
نهاية

## كتابة عدة قطاعات
صدّر دالة cache_اكتب_قطاعات(فهرس_القرص، رقم_القطاع، عدد_القطاعات، عنوان_المصدر)
    متغير مكتوب = 0
    متغير ق = 0
    بينما (ق < عدد_القطاعات)
        متغير نتيجة = cache_اكتب_قطاع(فهرس_القرص، رقم_القطاع + ق، عنوان_المصدر + (ق * حجم_القطاع_CACHE))
        إذا (نتيجة != 0)
