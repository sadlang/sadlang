## طباعة تصحيح
## ─────────────────────────────────────────────────────

دالة cache_اطبع_رقم(القيمة)
    إذا (القيمة < 0)
        cache_اكتب_حرف(COM1، 45)
        cache_اطبع_رقم(0 - القيمة)
        ارجع
    نهاية
    إذا (القيمة >= 10)
        cache_اطبع_رقم(القيمة / 10)
    نهاية
    cache_اكتب_حرف(COM1، 48 + (القيمة % 10))
نهاية

