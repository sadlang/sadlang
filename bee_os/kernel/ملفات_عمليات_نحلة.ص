## القسم ١٥: اختبارات
## ═══════════════════════════════════════════════════════════════

صدّر دالة اختبر_عمليات_الملفات()
    fop_اكتب_حرف(COM1، 91)   # '['
    fop_اكتب_حرف(COM1، 84)   # 'T'
    fop_اكتب_حرف(COM1، 69)   # 'E'
    fop_اكتب_حرف(COM1، 83)   # 'S'
    fop_اكتب_حرف(COM1، 84)   # 'T'
    fop_اكتب_حرف(COM1، 93)   # ']'
    fop_اكتب_حرف(COM1، 10)
    
    متغير نتائج = 0
    
    # اختبار 1: تهيئة
    متغير نت1 = هيئ_عمليات_الملفات()
    إذا (نت1 == 0)
        نتائج = نتائج + 1
        fop_اطبع_رقم(1)
    وإلا
        fop_اطبع_رقم(0)
    نهاية
    fop_اكتب_حرف(COM1، 32)
    
    # اختبار 2: تخصيص واصف
    متغير fd = خصص_واصف()
    إذا (fd >= 0)
        نتائج = نتائج + 1
        fop_اطبع_رقم(1)
        fd_نشط[fd] = 0  # تنظيف
    وإلا
        fop_اطبع_رقم(0)
    نهاية
    fop_اكتب_حرف(COM1، 32)
    
    # اختبار 3: تقسيم مسار
    # نجهز مسار بسيط "/a/b" في الذاكرة
    fop_اكتب_ذاكرة16(fop_عنوان_عمل2، 47 + (97 * 256))   # '/' 'a'
    fop_اكتب_ذاكرة16(fop_عنوان_عمل2 + 2، 47 + (98 * 256)) # '/' 'b'
    قسّم_المسار(fop_عنوان_عمل2، 4)
    إذا (مسار_عدد_المكونات == 2)
        نتائج = نتائج + 1
        fop_اطبع_رقم(1)
    وإلا
        fop_اطبع_رقم(0)
    نهاية
    fop_اكتب_حرف(COM1، 32)
    
    # اختبار 4: seek
    fd_نشط[0] = 1
    fd_حجم_الملف[0] = 1024
    fd_موقع[0] = 0
    
    حرّك(0، 100، من_البداية)
    إذا (fd_موقع[0] == 100)
        نتائج = نتائج + 1
        fop_اطبع_رقم(1)
    وإلا
        fop_اطبع_رقم(0)
    نهاية
    fop_اكتب_حرف(COM1، 32)
    
    # اختبار 5: seek من النهاية
    حرّك(0، -50، من_النهاية)
    إذا (fd_موقع[0] == 974)
        نتائج = نتائج + 1
        fop_اطبع_رقم(1)
    وإلا
        fop_اطبع_رقم(0)
    نهاية
    fop_اكتب_حرف(COM1، 10)
    
    fd_نشط[0] = 0  # تنظيف
    
    # الملخص
    fop_اطبع_رقم(نتائج)
    fop_اكتب_حرف(COM1، 47)   # '/'
    fop_اطبع_رقم(5)
    fop_اكتب_حرف(COM1، 10)
نهاية
