## تحميل كتلة في مخزن واصف الملف
دالة fop_حمّل_كتلة(رقم_الواصف، كتلة_منطقية)
    # فحص إذا الكتلة محملة بالفعل
    إذا (fd_كتلة_محملة[رقم_الواصف] == كتلة_منطقية)
        ارجع 0
    نهاية
    
    متغير رقم_التحميل_المحلي = fd_تحميل[رقم_الواصف]
    متغير رقم_العقدة_المحلي = fd_عقدة[رقم_الواصف]
    
    # قراءة العقدة لمعرفة الكتلة الفيزيائية
    متغير عنوان_العقدة = نظام_اقرأ_عقدة(رقم_التحميل_المحلي، رقم_العقدة_المحلي)
    إذا (عنوان_العقدة == 0)
        ارجع -1
    نهاية
    
    متغير كتلة_فيزيائية = نظام_ترجم_كتلة(رقم_التحميل_المحلي، عنوان_العقدة، كتلة_منطقية)
    إذا (كتلة_فيزيائية == 0)
        # لا توجد كتلة مخصصة — أعد أصفار
        fop_املأ_ذاكرة(fd_مخزن[رقم_الواصف]، 0، حجم_الكتلة_FOP)
        fd_كتلة_محملة[رقم_الواصف] = كتلة_منطقية
        ارجع 0
    نهاية
    
    # قراءة الكتلة من القرص عبر الكاش
    # نحتاج حساب القطاع المطلق
    # تستخدم ملفات_نحلة دالة اقرأ_كتلة_FS الداخلية
    # لكن هنا نستخدم الكاش مباشرة
    متغير ق = 0
    بينما (ق < قطاعات_الكتلة)
        # حساب القطاع: قطاع البداية + (كتلة * 8) + ق
        # هذا تقريبي — يجب استخدام نفس حساب ملفات_نحلة
        متغير قطاع = (كتلة_فيزيائية * قطاعات_الكتلة) + ق
        متغير نتيجة = fop_اقرأ_كتلة(fd_تحميل[رقم_الواصف]، قطاع، fd_مخزن[رقم_الواصف] + (ق * حجم_القطاع_FOP))
        إذا (نتيجة != 0)
            ارجع -1
        نهاية
        ق = ق + 1
    نهاية
    
    fd_كتلة_محملة[رقم_الواصف] = كتلة_منطقية
    ارجع 0
نهاية

## قراءة بايتات من ملف مفتوح
## يُعيد: عدد البايتات المقروءة فعلاً
صدّر دالة اقرأ(رقم_الواصف، عنوان_الوجهة، عدد_البايتات)
    إذا (رقم_الواصف < 0)
        ارجع -1
    نهاية
    إذا (رقم_الواصف >= أقصى_واصفات)
        ارجع -1
    نهاية
    إذا (fd_نشط[رقم_الواصف] == 0)
        ارجع -1
    نهاية
    
    # فحص الوضع
    إذا (fd_وضع[رقم_الواصف] % 4 == 2)
        # مفتوح للكتابة فقط
        ارجع -1
    نهاية
    
    # فحص نهاية الملف
    إذا (fd_موقع[رقم_الواصف] >= fd_حجم_الملف[رقم_الواصف])
        ارجع 0
    نهاية
    
    # تقليص عدد البايتات إذا تجاوز نهاية الملف
    متغير بقية = fd_حجم_الملف[رقم_الواصف] - fd_موقع[رقم_الواصف]
    إذا (عدد_البايتات > بقية)
        عدد_البايتات = بقية
    نهاية
    
    متغير مقروء = 0
    
    بينما (مقروء < عدد_البايتات)
        # حساب الكتلة المنطقية والإزاحة
        متغير الموقع_الحالي = fd_موقع[رقم_الواصف]
        متغير كتلة_منطقية = الموقع_الحالي / حجم_الكتلة_FOP
        متغير إزاحة_في_كتلة = الموقع_الحالي % حجم_الكتلة_FOP
        
        # تحميل الكتلة
        متغير نتيجة = fop_حمّل_كتلة(رقم_الواصف، كتلة_منطقية)
        إذا (نتيجة != 0)
            ارجع مقروء
        نهاية
        
        # كم بايت يمكن قراءتها من هذه الكتلة؟
        متغير متاح = حجم_الكتلة_FOP - إزاحة_في_كتلة
        متغير للقراءة = عدد_البايتات - مقروء
        إذا (للقراءة > متاح)
            للقراءة = متاح
        نهاية
        
        # نسخ البيانات
        fop_انسخ_ذاكرة(
            عنوان_الوجهة + مقروء،
            fd_مخزن[رقم_الواصف] + إزاحة_في_كتلة،
            للقراءة
        )
        
        مقروء = مقروء + للقراءة
        fd_موقع[رقم_الواصف] = fd_موقع[رقم_الواصف] + للقراءة
    نهاية
    
    ارجع مقروء
نهاية

