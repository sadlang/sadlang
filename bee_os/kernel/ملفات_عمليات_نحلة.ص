## القسم ١٣: حذف ملفات
## ═══════════════════════════════════════════════════════════════

## حذف ملف (إزالة الرابط)
## يُعيد: 0=نجاح، -1=خطأ
صدّر دالة احذف_ملف(رقم_التحميل، عنوان_المسار، طول_المسار)
    # تحليل المسار
    متغير رقم_العقدة = حلل_المسار(رقم_التحميل، عنوان_المسار، طول_المسار)
    إذا (رقم_العقدة < 0)
        ارجع -1
    نهاية
    
    # لا يمكن حذف عقدة الجذر
    إذا (رقم_العقدة == ROOT_INODE)
        ارجع -1
    نهاية
    
    # قراءة العقدة
    متغير عنوان_العقدة = نظام_اقرأ_عقدة(رقم_التحميل، رقم_العقدة)
    إذا (عنوان_العقدة == 0)
        ارجع -1
    نهاية
    
    # فحص أنها ليست دليلاً (حذف الأدلة يحتاج فحص الفراغ)
    متغير نوع_raw = نظام_عقدة_النوع(عنوان_العقدة)
    إذا (نوع_raw / 4096 == TYPE_DIR)
        ارجع -1  # استخدم احذف_دليل
    نهاية
    
    # تحرير كتل البيانات المباشرة
    متغير م = 0
    بينما (م < 12)
        متغير كتلة = نظام_عقدة_كتلة(عنوان_العقدة، م)
        إذا (كتلة != 0)
            نظام_حرر_كتلة(رقم_التحميل، كتلة)
        نهاية
        م = م + 1
    نهاية
    
    # تحرير العقدة
    نظام_حرر_عقدة(رقم_التحميل، رقم_العقدة)
    
    # ملاحظة: لا نزيل المدخلة من الدليل الأب حالياً
    # (يحتاج قراءة/كتابة كتل الدليل لتصفير رقم العقدة)
    
    ارجع 0
نهاية

