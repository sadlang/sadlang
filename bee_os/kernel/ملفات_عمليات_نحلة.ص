## كتابة بايتات في ملف مفتوح
## يُعيد: عدد البايتات المكتوبة
صدّر دالة اكتب(رقم_الواصف، عنوان_المصدر، عدد_البايتات)
    إذا (رقم_الواصف < 0)
        ارجع -1
    نهاية
    إذا (رقم_الواصف >= أقصى_واصفات)
        ارجع -1
    نهاية
    إذا (fd_نشط[رقم_الواصف] == 0)
        ارجع -1
    نهاية
    
    # فحص الوضع
    إذا (fd_وضع[رقم_الواصف] % 4 == 1)
        # مفتوح للقراءة فقط
        ارجع -1
    نهاية
    
    متغير مكتوب = 0
    
    بينما (مكتوب < عدد_البايتات)
        متغير الموقع_الحالي = fd_موقع[رقم_الواصف]
        متغير كتلة_منطقية = الموقع_الحالي / حجم_الكتلة_FOP
        متغير إزاحة_في_كتلة = الموقع_الحالي % حجم_الكتلة_FOP
        
        # تحميل الكتلة (أو تخصيص واحدة جديدة)
        متغير نتيجة = fop_حمّل_كتلة(رقم_الواصف، كتلة_منطقية)
        إذا (نتيجة != 0)
            # قد نحتاج تخصيص كتلة جديدة
            # حالياً نتوقف عند الخطأ
            ارجع مكتوب
        نهاية
        
        # كم بايت يمكن كتابتها في هذه الكتلة؟
        متغير متاح = حجم_الكتلة_FOP - إزاحة_في_كتلة
        متغير للكتابة = عدد_البايتات - مكتوب
        إذا (للكتابة > متاح)
            للكتابة = متاح
        نهاية
        
        # نسخ البيانات
        fop_انسخ_ذاكرة(
            fd_مخزن[رقم_الواصف] + إزاحة_في_كتلة،
            عنوان_المصدر + مكتوب،
            للكتابة
        )
        
        # كتابة الكتلة المعدلة للقرص
        متغير ق = 0
        بينما (ق < قطاعات_الكتلة)
            متغير كتلة_f = fd_كتلة_محملة[رقم_الواصف]
            متغير قطاع = (كتلة_f * قطاعات_الكتلة) + ق
            fop_اكتب_كتلة(fd_تحميل[رقم_الواصف]، قطاع، fd_مخزن[رقم_الواصف] + (ق * حجم_القطاع_FOP))
            ق = ق + 1
        نهاية
        
        مكتوب = مكتوب + للكتابة
        fd_موقع[رقم_الواصف] = fd_موقع[رقم_الواصف] + للكتابة
        
        # تحديث حجم الملف إذا توسع
        إذا (fd_موقع[رقم_الواصف] > fd_حجم_الملف[رقم_الواصف])
            fd_حجم_الملف[رقم_الواصف] = fd_موقع[رقم_الواصف]
        نهاية
    نهاية
    
    ارجع مكتوب
نهاية

