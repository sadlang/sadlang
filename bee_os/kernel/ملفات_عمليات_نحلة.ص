## طباعة إحصائيات عمليات الملفات
صدّر دالة اطبع_إحصائيات_VFS()
    fop_اكتب_حرف(COM1، 61)   # '='
    fop_اكتب_حرف(COM1، 61)
    fop_اكتب_حرف(COM1، 61)
    fop_اكتب_حرف(COM1، 32)
    fop_اكتب_حرف(COM1، 86)   # 'V'
    fop_اكتب_حرف(COM1، 70)   # 'F'
    fop_اكتب_حرف(COM1، 83)   # 'S'
    fop_اكتب_حرف(COM1، 10)
    
    # عدد الملفات المفتوحة
    fop_اكتب_حرف(COM1، 79)   # 'O'
    fop_اكتب_حرف(COM1، 112)  # 'p'
    fop_اكتب_حرف(COM1، 101)  # 'e'
    fop_اكتب_حرف(COM1، 110)  # 'n'
    fop_اكتب_حرف(COM1، 58)   # ':'
    fop_اطبع_رقم(عدد_الملفات_المفتوحة)
    fop_اكتب_حرف(COM1، 10)
    
    # تفاصيل كل واصف مفتوح
    متغير ف = 0
    بينما (ف < أقصى_واصفات)
        إذا (fd_نشط[ف] == 1)
            fop_اكتب_حرف(COM1، 32)
            fop_اطبع_رقم(ف)
            fop_اكتب_حرف(COM1، 58)   # ':'
            fop_اكتب_حرف(COM1، 32)
            fop_اكتب_حرف(COM1، 105)  # 'i'
            fop_اطبع_رقم(fd_عقدة[ف])
            fop_اكتب_حرف(COM1، 32)
            fop_اكتب_حرف(COM1، 115)  # 's'
            fop_اطبع_رقم(fd_حجم_الملف[ف])
            fop_اكتب_حرف(COM1، 32)
            fop_اكتب_حرف(COM1، 64)   # '@'
            fop_اطبع_رقم(fd_موقع[ف])
            fop_اكتب_حرف(COM1، 10)
        نهاية
        ف = ف + 1
    نهاية
