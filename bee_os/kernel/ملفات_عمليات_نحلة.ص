## تخصيص واصف ملف فارغ
## يُعيد: رقم الواصف (0-31) أو -1
دالة خصص_واصف()
    متغير ف = 0
    بينما (ف < أقصى_واصفات)
        إذا (fd_نشط[ف] == 0)
            ارجع ف
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

## تحرير واصف ملف
دالة حرر_واصف(رقم_الواصف)
    إذا (رقم_الواصف < 0)
        ارجع
    نهاية
    إذا (رقم_الواصف >= أقصى_واصفات)
        ارجع
    نهاية
    
    # تحرير المخزن المؤقت إذا كان مخصصاً
    إذا (fd_مخزن[رقم_الواصف] != 0)
        fop_حرر_صفحة(fd_مخزن[رقم_الواصف])
        fd_مخزن[رقم_الواصف] = 0
    نهاية
    
    fd_نشط[رقم_الواصف] = 0
    fd_كتلة_محملة[رقم_الواصف] = -1
نهاية

