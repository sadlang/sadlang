## إنشاء ملف جديد (داخلي)
دالة أنشئ_ملف_داخلي(رقم_التحميل، عنوان_المسار، طول_المسار، نوع_الملف)
    # تحليل المسار للحصول على الدليل الأب
    متغير عقدة_الأب = حلل_مسار_الأب(رقم_التحميل، عنوان_المسار، طول_المسار)
    إذا (عقدة_الأب < 0)
        ارجع -1
    نهاية
    
    # استخراج اسم الملف (المكون الأخير)
    # يجب إعادة تقسيم المسار (حلل_مسار_الأب غيّر المتغيرات)
    قسّم_المسار(عنوان_المسار، طول_المسار)
    إذا (مسار_عدد_المكونات == 0)
        ارجع -1
    نهاية
    
    متغير فهرس_الاسم = مسار_عدد_المكونات - 1
    متغير عنوان_الاسم = عنوان_المسار + مسار_بداية[فهرس_الاسم]
    متغير طول_الاسم = مسار_طول[فهرس_الاسم]
    
    # فحص إذا الملف موجود بالفعل
    متغير موجود = نظام_ابحث_في_دليل(رقم_التحميل، عقدة_الأب، عنوان_الاسم، طول_الاسم)
    إذا (موجود >= 0)
        ارجع موجود  # موجود بالفعل
    نهاية
    
    # تخصيص عقدة جديدة
    متغير عقدة_جديدة = نظام_خصص_عقدة(رقم_التحميل)
    إذا (عقدة_جديدة < 0)
        ارجع -1
    نهاية
    
    # تهيئة العقدة
    fop_املأ_ذاكرة(fop_عنوان_عمل، 0، حجم_العقدة_FOP)
    
    # نوع + أذونات
    متغير نوع_أذونات = 0
    إذا (نوع_الملف == TYPE_FILE)
        نوع_أذونات = (TYPE_FILE * 4096) + 420  # 0o644
    نهاية
    إذا (نوع_الملف == TYPE_DIR)
        نوع_أذونات = (TYPE_DIR * 4096) + 493   # 0o755
    نهاية
    
    fop_اكتب_ذاكرة16(fop_عنوان_عمل، نوع_أذونات)    # نوع+أذونات
    fop_اكتب_ذاكرة16(fop_عنوان_عمل + 2، 1)           # رابط واحد
    fop_اكتب_ذاكرة(fop_عنوان_عمل + 12، 0)             # حجم = 0
    
    # كتابة العقدة
    نظام_اكتب_عقدة(رقم_التحميل، عقدة_جديدة، fop_عنوان_عمل)
    
    # إضافة مدخلة في الدليل الأب
    نظام_أضف_مدخلة(رقم_التحميل، عقدة_الأب، عقدة_جديدة، نوع_الملف، عنوان_الاسم، طول_الاسم)
    
    ارجع عقدة_جديدة
