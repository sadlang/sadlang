# دوال الطباعة
# ═══════════════════════════════════════════════════════════════════════════════
دالة ata_serial_اطبع(رسالة)
    متغير i = 0 + 0
    بينما (i < 80)
        متغير ch = sad_ll_mem_read8(رسالة + i) + 0
        إذا (ch == 0) ارجع 0 نهاية
        sad_ll_serial_write_char(COM1، ch)
        i = i + 1
    نهاية
    ارجع 0
نهاية

دالة ata_serial_رقم(ن)
    متغير val = ن + 0
    إذا (val < 0)
        sad_ll_serial_write_char(COM1، 45)
        val = 0 - val
    نهاية
    إذا (val >= 1000000)
        متغير d7 = val / 1000000
        sad_ll_serial_write_char(COM1، 48 + d7)
        val = val - (d7 * 1000000)
    نهاية
    إذا (val >= 100000)
        متغير d6 = val / 100000
        sad_ll_serial_write_char(COM1، 48 + d6)
        val = val - (d6 * 100000)
    والا_اذا (ن >= 1000000)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    إذا (val >= 10000)
        متغير d5 = val / 10000
        sad_ll_serial_write_char(COM1، 48 + d5)
        val = val - (d5 * 10000)
    والا_اذا (ن >= 100000)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    إذا (val >= 1000)
        متغير d4 = val / 1000
        sad_ll_serial_write_char(COM1، 48 + d4)
        val = val - (d4 * 1000)
    والا_اذا (ن >= 10000)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    إذا (val >= 100)
        متغير d3 = val / 100
        sad_ll_serial_write_char(COM1، 48 + d3)
        val = val - (d3 * 100)
    والا_اذا (ن >= 1000)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    إذا (val >= 10)
        متغير d2 = val / 10
        sad_ll_serial_write_char(COM1، 48 + d2)
        val = val - (d2 * 10)
    والا_اذا (ن >= 100)
        sad_ll_serial_write_char(COM1، 48)
    نهاية
    sad_ll_serial_write_char(COM1، 48 + val)
    ارجع 0
نهاية

دالة ata_serial_hex8(val)
    متغير hi = val / 16
    متغير lo = val % 16
    إذا (hi < 10) sad_ll_serial_write_char(COM1، 48 + hi)
    والا sad_ll_serial_write_char(COM1، 55 + hi) نهاية
    إذا (lo < 10) sad_ll_serial_write_char(COM1، 48 + lo)
    والا sad_ll_serial_write_char(COM1، 55 + lo) نهاية
    ارجع 0
نهاية

دالة ata_serial_سطر()
    sad_ll_serial_write_char(COM1، 13)
    sad_ll_serial_write_char(COM1، 10)
    ارجع 0
نهاية

