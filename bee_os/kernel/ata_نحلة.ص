دالة ata_extract_model(drv، buf)
    # Model string in words 27-46 (20 words = 40 chars, bytes swapped)
    # We store first 10 words only
    متغير model_base = buf + 54  # word 27 = offset 54
    متغير w0 = sad_ll_mem_read16(model_base) + 0
    متغير w1 = sad_ll_mem_read16(model_base + 2) + 0
    متغير w2 = sad_ll_mem_read16(model_base + 4) + 0
    متغير w3 = sad_ll_mem_read16(model_base + 6) + 0
    متغير w4 = sad_ll_mem_read16(model_base + 8) + 0
    متغير w5 = sad_ll_mem_read16(model_base + 10) + 0
    متغير w6 = sad_ll_mem_read16(model_base + 12) + 0
    متغير w7 = sad_ll_mem_read16(model_base + 14) + 0
    متغير w8 = sad_ll_mem_read16(model_base + 16) + 0
    متغير w9 = sad_ll_mem_read16(model_base + 18) + 0

    إذا (drv == 0)
        ata_model_0_0 = w0 + 0
        ata_model_0_1 = w1 + 0
        ata_model_0_2 = w2 + 0
        ata_model_0_3 = w3 + 0
        ata_model_0_4 = w4 + 0
        ata_model_0_5 = w5 + 0
        ata_model_0_6 = w6 + 0
        ata_model_0_7 = w7 + 0
        ata_model_0_8 = w8 + 0
        ata_model_0_9 = w9 + 0
    نهاية
    إذا (drv == 1)
        ata_model_1_0 = w0 + 0
        ata_model_1_1 = w1 + 0
        ata_model_1_2 = w2 + 0
        ata_model_1_3 = w3 + 0
        ata_model_1_4 = w4 + 0
        ata_model_1_5 = w5 + 0
        ata_model_1_6 = w6 + 0
        ata_model_1_7 = w7 + 0
        ata_model_1_8 = w8 + 0
        ata_model_1_9 = w9 + 0
    نهاية
    إذا (drv == 2)
        ata_model_2_0 = w0 + 0
        ata_model_2_1 = w1 + 0
        ata_model_2_2 = w2 + 0
        ata_model_2_3 = w3 + 0
        ata_model_2_4 = w4 + 0
        ata_model_2_5 = w5 + 0
        ata_model_2_6 = w6 + 0
        ata_model_2_7 = w7 + 0
        ata_model_2_8 = w8 + 0
        ata_model_2_9 = w9 + 0
    نهاية
    إذا (drv == 3)
        ata_model_3_0 = w0 + 0
        ata_model_3_1 = w1 + 0
        ata_model_3_2 = w2 + 0
        ata_model_3_3 = w3 + 0
        ata_model_3_4 = w4 + 0
        ata_model_3_5 = w5 + 0
        ata_model_3_6 = w6 + 0
        ata_model_3_7 = w7 + 0
        ata_model_3_8 = w8 + 0
        ata_model_3_9 = w9 + 0
    نهاية

    # طباعة الموديل (بايتات مبدلة)
    ata_serial_اطبع("[ATA] Model: ")
    متغير j = 0 + 0
    بينما (j < 10)
        متغير w = sad_ll_mem_read16(model_base + (j * 2)) + 0
        # ATA model has swapped bytes: high byte first, low byte second
        متغير hi = w / 256
        متغير lo = w % 256
        إذا (hi > 31)
            إذا (hi < 127) sad_ll_serial_write_char(COM1، hi) نهاية
        نهاية
        إذا (lo > 31)
            إذا (lo < 127) sad_ll_serial_write_char(COM1، lo) نهاية
        نهاية
        j = j + 1
    نهاية
    ata_serial_سطر()
    ارجع 0
