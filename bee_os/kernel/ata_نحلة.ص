# ═══════════════════════════════════════════════════════════════════════════════
# 400ns delay (read alternate status 4 times)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ata_delay(drv)
    متغير ctrl = ata_get_ctrl(drv) + 0
    sad_ll_port_inb(ctrl)
    sad_ll_port_inb(ctrl)
    sad_ll_port_inb(ctrl)
    sad_ll_port_inb(ctrl)
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# انتظار BSY clear
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ata_wait_bsy(drv)
    متغير base = ata_get_base(drv) + 0
    متغير timeout = 100000 + 0
    بينما (timeout > 0)
        متغير sts = sad_ll_port_inb(base + ATA_REG_STATUS) + 0
        إذا ((sts / 128) % 2 == 0)   # BSY bit clear
            ارجع sts + 0
        نهاية
        timeout = timeout - 1
    نهاية
    ارجع 0 - 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# انتظار DRQ set
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ata_wait_drq(drv)
    متغير base = ata_get_base(drv) + 0
    متغير timeout = 100000 + 0
    بينما (timeout > 0)
        متغير sts = sad_ll_port_inb(base + ATA_REG_STATUS) + 0
        إذا (sts % 2 == 1)  # ERR
            ارجع 0 - 1
        نهاية
        إذا ((sts / 32) % 2 == 1)  # DF
            ارجع 0 - 2
        نهاية
        إذا ((sts / 8) % 2 == 1)   # DRQ
            ارجع 0
        نهاية
        timeout = timeout - 1
    نهاية
    ارجع 0 - 3
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# اختيار القرص
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ata_select_drive(drv)
    متغير base = ata_get_base(drv) + 0
    متغير sel = ata_get_select(drv) + 0
    sad_ll_port_outb(base + ATA_REG_DRIVE، sel)
    ata_delay(drv)
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# Software Reset
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ata_soft_reset(drv)
    متغير ctrl = ata_get_ctrl(drv) + 0
    # Set SRST bit (bit 2)
    sad_ll_port_outb(ctrl، 4)
    # Wait
    ata_delay(drv)
    ata_delay(drv)
    # Clear SRST
    sad_ll_port_outb(ctrl، 0)
    # Wait for BSY clear
    ata_wait_bsy(drv)
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# IDENTIFY DEVICE
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ata_identify(drv)
    متغير base = ata_get_base(drv) + 0

    # اختيار القرص
    ata_select_drive(drv)

    # مسح سجلات sector count, LBA
    sad_ll_port_outb(base + ATA_REG_COUNT، 0)
    sad_ll_port_outb(base + ATA_REG_LBALO، 0)
    sad_ll_port_outb(base + ATA_REG_LBAMID، 0)
    sad_ll_port_outb(base + ATA_REG_LBAHI، 0)

    # إرسال IDENTIFY
    sad_ll_port_outb(base + ATA_REG_STATUS، ATA_CMD_IDENTIFY)

    ata_delay(drv)

    # تحقق من وجود القرص
    متغير sts = sad_ll_port_inb(base + ATA_REG_STATUS) + 0
    إذا (sts == 0)
        # لا يوجد قرص
        ارجع 0 - 1
    نهاية

    # انتظار BSY
    متغير wait_result = ata_wait_bsy(drv) + 0
    إذا (wait_result < 0)
        ارجع 0 - 2
    نهاية

    # تحقق من ATAPI — LBA Mid/High != 0 يعني ATAPI
    متغير lba_mid = sad_ll_port_inb(base + ATA_REG_LBAMID) + 0
    متغير lba_hi = sad_ll_port_inb(base + ATA_REG_LBAHI) + 0

    إذا (lba_mid > 0)
        إذا (lba_hi > 0)
            # ممكن ATAPI
            إذا (lba_mid == 20)  # 0x14
                إذا (lba_hi == 235)  # 0xEB
                    ata_set_type(drv، ATA_TYPE_ATAPI)
                    ata_serial_اطبع("[ATA] Drive ")
                    ata_serial_رقم(drv + 0)
                    ata_serial_اطبع(" is ATAPI")
                    ata_serial_سطر()
                    ارجع 0 - 3
                نهاية
            نهاية
        نهاية
    نهاية

    # انتظار DRQ
    متغير drq_result = ata_wait_drq(drv) + 0
    إذا (drq_result < 0)
        ارجع drq_result + 0
    نهاية

    # قراءة 256 كلمة (512 بايت) من بيانات IDENTIFY
    متغير buf = ata_identify_buf + 0
    متغير i = 0 + 0
    بينما (i < 256)
        متغير word = sad_ll_port_inw(base + ATA_REG_DATA) + 0
        sad_ll_mem_write16(buf + (i * 2)، word)
        i = i + 1
    نهاية

    ata_set_type(drv، ATA_TYPE_ATA)
    ata_set_present(drv، 1)

    # استخراج عدد القطاعات الكلي (LBA28: words 60-61, LBA48: words 100-103)
    متغير lba28_sectors = sad_ll_mem_read32(buf + 120) + 0  # word 60 = offset 120
    ata_set_sectors(drv، lba28_sectors)

    # تحقق من LBA48 (word 83, bit 10)
    متغير word83 = sad_ll_mem_read16(buf + 166) + 0  # word 83 = offset 166
    إذا ((word83 / 1024) % 2 == 1)
        ata_set_lba48(drv، 1)
        # LBA48 sector count at words 100-103 (offset 200)
        متغير lba48_lo = sad_ll_mem_read32(buf + 200) + 0
        إذا (lba48_lo > lba28_sectors)
            ata_set_sectors(drv، lba48_lo)
        نهاية
    نهاية

    # حساب الحجم بالميغابايت
    متغير total_sectors = ata_get_sectors(drv) + 0
    متغير size_mb = total_sectors / 2048  # sectors × 512 / 1048576
    ata_set_size(drv، size_mb)

    # استخراج Model (words 27-46, swapped bytes)
    ata_extract_model(drv، buf)

    ata_serial_اطبع("[ATA] Drive ")
    ata_serial_رقم(drv + 0)
    ata_serial_اطبع(" ATA: ")
    ata_serial_رقم(size_mb + 0)
    ata_serial_اطبع(" MB, ")
    ata_serial_رقم(total_sectors + 0)
    ata_serial_اطبع(" sectors")
