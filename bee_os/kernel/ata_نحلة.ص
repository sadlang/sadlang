# ═══════════════════════════════════════════════════════════════════════════════
# قراءة قطاع (LBA28 PIO)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ata_read_sector(drv، lba، buf)
    متغير base = ata_get_base(drv) + 0
    متغير sel = ata_get_select(drv) + 0

    # انتظار BSY
    ata_wait_bsy(drv)

    # Drive/Head register: LBA mode + drive + LBA bits 24-27
    متغير head = sel + 64 + ((lba / 16777216) % 16)  # 0x40 = LBA bit
    sad_ll_port_outb(base + ATA_REG_DRIVE، head)

    # sector count = 1
    sad_ll_port_outb(base + ATA_REG_COUNT، 1)

    # LBA bytes
    sad_ll_port_outb(base + ATA_REG_LBALO، lba % 256)
    sad_ll_port_outb(base + ATA_REG_LBAMID، (lba / 256) % 256)
    sad_ll_port_outb(base + ATA_REG_LBAHI، (lba / 65536) % 256)

    # إرسال أمر READ
    sad_ll_port_outb(base + ATA_REG_STATUS، ATA_CMD_READ_PIO)

    # انتظار DRQ
    متغير drq_rc = ata_wait_drq(drv) + 0
    إذا (drq_rc < 0)
        ata_errors = ata_errors + 1
        ارجع drq_rc + 0
    نهاية

    # قراءة 256 كلمة
    متغير i = 0 + 0
    بينما (i < 256)
        متغير word = sad_ll_port_inw(base + ATA_REG_DATA) + 0
        sad_ll_mem_write16(buf + (i * 2)، word)
        i = i + 1
    نهاية

    ata_reads = ata_reads + 1
    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# كتابة قطاع (LBA28 PIO)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ata_write_sector(drv، lba، buf)
    متغير base = ata_get_base(drv) + 0
    متغير sel = ata_get_select(drv) + 0

    ata_wait_bsy(drv)

    متغير head = sel + 64 + ((lba / 16777216) % 16)
    sad_ll_port_outb(base + ATA_REG_DRIVE، head)

    sad_ll_port_outb(base + ATA_REG_COUNT، 1)
    sad_ll_port_outb(base + ATA_REG_LBALO، lba % 256)
    sad_ll_port_outb(base + ATA_REG_LBAMID، (lba / 256) % 256)
    sad_ll_port_outb(base + ATA_REG_LBAHI، (lba / 65536) % 256)

    # إرسال أمر WRITE
    sad_ll_port_outb(base + ATA_REG_STATUS، ATA_CMD_WRITE_PIO)

    # انتظار DRQ
    متغير drq_rc = ata_wait_drq(drv) + 0
    إذا (drq_rc < 0)
        ata_errors = ata_errors + 1
        ارجع drq_rc + 0
    نهاية

    # كتابة 256 كلمة
    متغير i = 0 + 0
    بينما (i < 256)
        متغير word = sad_ll_mem_read16(buf + (i * 2)) + 0
        sad_ll_port_outw(base + ATA_REG_DATA، word)
        i = i + 1
    نهاية

    # Cache Flush
    sad_ll_port_outb(base + ATA_REG_STATUS، ATA_CMD_CACHE_FLUSH)
    ata_wait_bsy(drv)

    ata_writes = ata_writes + 1
    ارجع 0
نهاية

