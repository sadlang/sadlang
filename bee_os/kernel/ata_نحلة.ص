# قراءة عدة قطاعات
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة ata_read_sectors(drv، lba، count، buf)
    متغير i = 0 + 0
    بينما (i < count)
        متغير rc = ata_read_sector(drv، lba + i، buf + (i * 512)) + 0
        إذا (rc < 0)
            ارجع rc + 0
        نهاية
        i = i + 1
    نهاية
    ارجع 0
