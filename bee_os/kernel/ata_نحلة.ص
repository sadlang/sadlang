# MBR partition table
# ═══════════════════════════════════════════════════════════════════════════════
متغير ata_part_type_0_0 = 0
متغير ata_part_type_0_1 = 0
متغير ata_part_type_0_2 = 0
متغير ata_part_type_0_3 = 0

متغير ata_part_start_0_0 = 0
متغير ata_part_start_0_1 = 0
متغير ata_part_start_0_2 = 0
متغير ata_part_start_0_3 = 0

متغير ata_part_size_0_0 = 0
متغير ata_part_size_0_1 = 0
متغير ata_part_size_0_2 = 0
متغير ata_part_size_0_3 = 0

صدّر دالة ata_read_mbr(drv)
    متغير buf = sad_ll_kmalloc(512) + 0
    sad_ll_memset(buf، 0، 512)

    متغير rc = ata_read_sector(drv، 0، buf) + 0
    إذا (rc < 0)
        ata_serial_اطبع("[ATA] MBR read failed")
        ata_serial_سطر()
        ارجع 0 - 1
    نهاية

    # Check MBR signature (0x55AA at offset 510)
    متغير sig = sad_ll_mem_read16(buf + 510) + 0
    إذا (sig != 43605)  # 0xAA55 little-endian
        ata_serial_اطبع("[ATA] Invalid MBR signature: ")
        ata_serial_رقم(sig + 0)
        ata_serial_سطر()
        ارجع 0 - 2
    نهاية

    ata_serial_اطبع("[ATA] MBR valid, parsing partitions...")
    ata_serial_سطر()

    # Partition entries at offsets 446, 462, 478, 494 (16 bytes each)
    متغير p = 0 + 0
    بينما (p < 4)
        متغير entry = buf + 446 + (p * 16)
        متغير ptype = sad_ll_mem_read8(entry + 4) + 0
        متغير start = sad_ll_mem_read32(entry + 8) + 0
        متغير psize = sad_ll_mem_read32(entry + 12) + 0

        إذا (p == 0)
            ata_part_type_0_0 = ptype + 0
            ata_part_start_0_0 = start + 0
            ata_part_size_0_0 = psize + 0
        نهاية
        إذا (p == 1)
            ata_part_type_0_1 = ptype + 0
            ata_part_start_0_1 = start + 0
            ata_part_size_0_1 = psize + 0
        نهاية
        إذا (p == 2)
            ata_part_type_0_2 = ptype + 0
            ata_part_start_0_2 = start + 0
            ata_part_size_0_2 = psize + 0
        نهاية
        إذا (p == 3)
            ata_part_type_0_3 = ptype + 0
            ata_part_start_0_3 = start + 0
            ata_part_size_0_3 = psize + 0
        نهاية

        إذا (ptype > 0)
            ata_serial_اطبع("[ATA] Part ")
            ata_serial_رقم(p + 0)
            ata_serial_اطبع(": type=0x")
            ata_serial_hex8(ptype + 0)
            ata_serial_اطبع(" start=")
            ata_serial_رقم(start + 0)
            ata_serial_اطبع(" size=")
            ata_serial_رقم(psize + 0)
            ata_serial_سطر()
        نهاية

        p = p + 1
    نهاية

    ارجع 0
نهاية

