# ثوابت
# ═══════════════════════════════════════════════════════════════════════════════
ثابت COM1 = 1016

# ─── ATA Register Ports ───
# Primary channel: base=0x1F0 (496), ctrl=0x3F6 (1014)
# Secondary channel: base=0x170 (368), ctrl=0x376 (886)
ثابت ATA_PRI_BASE = 496        # 0x1F0
ثابت ATA_PRI_CTRL = 1014       # 0x3F6
ثابت ATA_SEC_BASE = 368        # 0x170
ثابت ATA_SEC_CTRL = 886        # 0x376

# Register offsets from base
ثابت ATA_REG_DATA = 0           # Data (R/W)
ثابت ATA_REG_ERROR = 1          # Error (R) / Features (W)
ثابت ATA_REG_COUNT = 2          # Sector Count
ثابت ATA_REG_LBALO = 3          # LBA Low
ثابت ATA_REG_LBAMID = 4         # LBA Mid
ثابت ATA_REG_LBAHI = 5          # LBA High
ثابت ATA_REG_DRIVE = 6          # Drive/Head
ثابت ATA_REG_STATUS = 7         # Status (R) / Command (W)

# Control register offset
ثابت ATA_REG_ALTSTATUS = 0      # Alternate Status (from ctrl base)

# ─── Status bits ───
ثابت ATA_SR_BSY = 128           # 0x80: Busy
ثابت ATA_SR_DRDY = 64           # 0x40: Drive Ready
ثابت ATA_SR_DF = 32             # 0x20: Drive Fault
ثابت ATA_SR_DSC = 16            # 0x10: Drive Seek Complete
ثابت ATA_SR_DRQ = 8             # 0x08: Data Request
ثابت ATA_SR_CORR = 4            # 0x04: Corrected Data
ثابت ATA_SR_IDX = 2             # 0x02: Index
ثابت ATA_SR_ERR = 1             # 0x01: Error

# ─── Error bits ───
ثابت ATA_ER_BBK = 128           # Bad Block
ثابت ATA_ER_UNC = 64            # Uncorrectable
ثابت ATA_ER_MC = 32             # Media Changed
ثابت ATA_ER_IDNF = 16           # ID Not Found
ثابت ATA_ER_MCR = 8             # Media Change Request
ثابت ATA_ER_ABRT = 4            # Aborted Command
ثابت ATA_ER_TK0NF = 2           # Track 0 Not Found
ثابت ATA_ER_AMNF = 1            # Address Mark Not Found

# ─── ATA Commands ───
ثابت ATA_CMD_IDENTIFY = 236          # 0xEC: IDENTIFY DEVICE
ثابت ATA_CMD_READ_PIO = 32           # 0x20: READ SECTORS (PIO)
ثابت ATA_CMD_WRITE_PIO = 48          # 0x30: WRITE SECTORS (PIO)
ثابت ATA_CMD_READ_PIO_EXT = 36       # 0x24: READ SECTORS EXT (48-bit LBA)
ثابت ATA_CMD_WRITE_PIO_EXT = 52      # 0x34: WRITE SECTORS EXT (48-bit LBA)
ثابت ATA_CMD_CACHE_FLUSH = 231       # 0xE7: CACHE FLUSH
ثابت ATA_CMD_CACHE_FLUSH_EXT = 234   # 0xEA: CACHE FLUSH EXT
ثابت ATA_CMD_PACKET = 160            # 0xA0: PACKET (ATAPI)
ثابت ATA_CMD_IDENTIFY_PACKET = 161   # 0xA1: IDENTIFY PACKET DEVICE

# ─── Drive selection ───
ثابت ATA_MASTER = 160   # 0xA0: Master drive select
ثابت ATA_SLAVE = 176     # 0xB0: Slave drive select

# ─── Drive types ───
ثابت ATA_TYPE_NONE = 0
ثابت ATA_TYPE_ATA = 1
ثابت ATA_TYPE_ATAPI = 2

# Max drives: 2 channels × 2 drives = 4
ثابت ATA_MAX_DRIVES = 4

