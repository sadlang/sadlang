# ══════════════════════════════════════════════
# القسم 11: نسخ عند الكتابة (CoW)
# ══════════════════════════════════════════════

#* ── محاكاة عملية CoW ──
   1. قراءة العقدة القديمة
   2. تخصيص عقدة جديدة
   3. نسخ المحتوى
   4. تعديل البيانات في النسخة الجديدة
   5. إعادة رقم القطاع الجديد
*#
صدّر دالة btrfs_cow_عقدة(قطاع_قديم، قطاع_مخصص)
    # الخطوة 1: قراءة العقدة القديمة في خانة 0
    متغير نتيجة = btrfs_اقرأ_عقدة(قطاع_قديم، 0)
    إذا (نتيجة < 0)
        kernel_print_string("    btrfs CoW: read failed")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    # الخطوة 2: "تخصيص" عقدة جديدة (نحملها في خانة 1)
    # في نظام حقيقي: allocator يعطينا قطاع جديد
    # هنا نستخدم القطاع المخصص
    
    # الخطوة 3: نسخ المحتوى
    # في الذاكرة، العقدة 0 → نسخة في عقدة 1
    متغير مخزن_جديد = kernel_allocate(btrfs_مقاس_عقدة)
    إذا (مخزن_جديد == 0) ارجع -1 نهاية
    
    # نسخ بايت بايت (أول 512 بايت فقط لتوفير الوقت)
    متغير ع = 0
    بينما (ع < 512)
        متغير ب = mem_read_byte(عقد_عنوان_0 + ع)
        mem_write_byte(مخزن_جديد + ع، ب)
        ع = ع + 1
    نهاية
    
    # تخزين في خانة 1
    إذا (عقد_عنوان_1 != 0) kernel_free(عقد_عنوان_1) نهاية
    عقد_عنوان_1 = مخزن_جديد
    عقد_قطاع_1 = قطاع_مخصص
    عقد_مستوى_1 = عقد_مستوى_0
    عقد_عناصر_1 = عقد_عناصر_0
    عقد_صالحة_1 = 1
    
    btrfs_عمليات_cow = btrfs_عمليات_cow + 1
    
    kernel_print_string("    btrfs CoW: sector ")
    kernel_print_number(قطاع_قديم)
    kernel_print_string(" -> ")
    kernel_print_number(قطاع_مخصص)
    kernel_print_number(10)
    
    ارجع قطاع_مخصص
نهاية

