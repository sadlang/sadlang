# القسم 5: قراءة Superblock
# ══════════════════════════════════════════════

#* ── قراءة وتحقق من superblock ──
   Superblock يقع عند 64KB (قطاع 128)
   نتحقق من التوقيع "_BHRfS_M" عند الإزاحة 72
*#
صدّر دالة btrfs_اقرأ_superblock(قرص، قطاع_بداية)
    btrfs_قرص = قرص
    btrfs_قطاع_بداية = قطاع_بداية
    btrfs_صالح = 0
    
    متغير مخزن = kernel_allocate(512)
    إذا (مخزن == 0) ارجع -1 نهاية
    
    # قراءة القطاع الذي يحتوي التوقيع
    disk_read_sector(قرص، قطاع_بداية + btrfs_موقع_superblock، مخزن)
    
    # التحقق من التوقيع عند إزاحة 72
    متغير ت0 = mem_read_byte(مخزن + 72)
    متغير ت1 = mem_read_byte(مخزن + 73)
    متغير ت2 = mem_read_byte(مخزن + 74)
    متغير ت3 = mem_read_byte(مخزن + 75)
    متغير ت4 = mem_read_byte(مخزن + 76)
    متغير ت5 = mem_read_byte(مخزن + 77)
    متغير ت6 = mem_read_byte(مخزن + 78)
    متغير ت7 = mem_read_byte(مخزن + 79)
    
    متغير توقيع_صحيح = 1
    إذا (ت0 != btrfs_توقيع_0) توقيع_صحيح = 0 نهاية
    إذا (ت1 != btrfs_توقيع_1) توقيع_صحيح = 0 نهاية
    إذا (ت2 != btrfs_توقيع_2) توقيع_صحيح = 0 نهاية
    إذا (ت3 != btrfs_توقيع_3) توقيع_صحيح = 0 نهاية
    إذا (ت4 != btrfs_توقيع_4) توقيع_صحيح = 0 نهاية
    إذا (ت5 != btrfs_توقيع_5) توقيع_صحيح = 0 نهاية
    إذا (ت6 != btrfs_توقيع_6) توقيع_صحيح = 0 نهاية
    إذا (ت7 != btrfs_توقيع_7) توقيع_صحيح = 0 نهاية
    
    إذا (توقيع_صحيح == 1)
        btrfs_صالح = 1
        
        # قراءة حقول Superblock
        btrfs_جيل = mem_read_dword(مخزن + 100)
        btrfs_جذر_شجرة_قطاع = mem_read_dword(مخزن + 108)
        btrfs_مقاس_كتلة = mem_read_dword(مخزن + 116)
        btrfs_مقاس_قطاع = mem_read_dword(مخزن + 120)
        btrfs_مقاس_عقدة_فعلي = mem_read_dword(مخزن + 124)
        btrfs_إجمالي_بايتات = mem_read_dword(مخزن + 128)
        btrfs_مستخدم_بايتات = mem_read_dword(مخزن + 136)
        
        kernel_print_string("    btrfs: valid superblock found")
        kernel_print_number(10)
        kernel_print_string("      generation=")
        kernel_print_number(btrfs_جيل)
        kernel_print_string(" node_size=")
        kernel_print_number(btrfs_مقاس_عقدة_فعلي)
        kernel_print_number(10)
    وإلا
        kernel_print_string("    btrfs: no valid superblock")
        kernel_print_number(10)
    نهاية
    
    kernel_free(مخزن)
    ارجع btrfs_صالح
نهاية

# ══════════════════════════════════════════════
# القسم 6: قراءة عقدة B-Tree
# ══════════════════════════════════════════════

#* ── قراءة عقدة B-Tree من القرص ──
   كل عقدة بحجم 16KB (32 قطاع)
   ترويسة العقدة (101 بايت):
   إزاحة 0:  المجموع التحققي (32 بايت)
   إزاحة 32: UUID (16 بايت)
   إزاحة 48: العنوان الفيزيائي (8 بايت)
   إزاحة 56: الأعلام (8 بايت)
   إزاحة 64: chunk_tree_uuid (16 بايت)
   إزاحة 80: الجيل (8 بايت)
   إزاحة 88: مالك الشجرة (8 بايت)
   إزاحة 96: عدد العناصر (4 بايت)
   إزاحة 100: المستوى (1 بايت)
*#
صدّر دالة btrfs_اقرأ_عقدة(قطاع_عقدة، فهرس_ذاكرة)
    إذا (فهرس_ذاكرة < 0) ارجع -1 نهاية
    إذا (فهرس_ذاكرة >= btrfs_أقصى_عقد_مخزنة) ارجع -1 نهاية
    
    # خصص ذاكرة للعقدة (16KB)
    متغير مخزن = kernel_allocate(btrfs_مقاس_عقدة)
    إذا (مخزن == 0) ارجع -1 نهاية
    
    # اقرأ 32 قطاع
    متغير ق = 0
    بينما (ق < btrfs_قطاعات_لعقدة)
        disk_read_sector(btrfs_قرص، btrfs_قطاع_بداية + قطاع_عقدة + ق، مخزن + (ق * 512))
        ق = ق + 1
    نهاية
    
    # تحليل الترويسة
    متغير عدد_عناصر = mem_read_dword(مخزن + 96)
    متغير مستوى = mem_read_byte(مخزن + 100)
    
    # تخزين في خانة الذاكرة
    إذا (فهرس_ذاكرة == 0)
        إذا (عقد_عنوان_0 != 0) kernel_free(عقد_عنوان_0) نهاية
        عقد_عنوان_0 = مخزن
        عقد_قطاع_0 = قطاع_عقدة
        عقد_مستوى_0 = مستوى
        عقد_عناصر_0 = عدد_عناصر
        عقد_صالحة_0 = 1
    نهاية
    إذا (فهرس_ذاكرة == 1)
        إذا (عقد_عنوان_1 != 0) kernel_free(عقد_عنوان_1) نهاية
        عقد_عنوان_1 = مخزن
        عقد_قطاع_1 = قطاع_عقدة
        عقد_مستوى_1 = مستوى
        عقد_عناصر_1 = عدد_عناصر
        عقد_صالحة_1 = 1
    نهاية
    إذا (فهرس_ذاكرة == 2)
        إذا (عقد_عنوان_2 != 0) kernel_free(عقد_عنوان_2) نهاية
        عقد_عنوان_2 = مخزن
        عقد_قطاع_2 = قطاع_عقدة
        عقد_مستوى_2 = مستوى
        عقد_عناصر_2 = عدد_عناصر
        عقد_صالحة_2 = 1
    نهاية
    إذا (فهرس_ذاكرة == 3)
        إذا (عقد_عنوان_3 != 0) kernel_free(عقد_عنوان_3) نهاية
        عقد_عنوان_3 = مخزن
        عقد_قطاع_3 = قطاع_عقدة
        عقد_مستوى_3 = مستوى
        عقد_عناصر_3 = عدد_عناصر
        عقد_صالحة_3 = 1
    نهاية
    
    btrfs_عقد_قرئت = btrfs_عقد_قرئت + 1
    ارجع عدد_عناصر
نهاية

# ══════════════════════════════════════════════
# القسم 7: CRC32 (مجموع تحققي مبسط)
# ══════════════════════════════════════════════

#* ── حساب مجموع تحققي مبسط ──
   CRC32 الكامل يحتاج جدول 256 مدخل
   هنا نستخدم checksum بسيط (XOR + rotate)
*#
صدّر دالة btrfs_حساب_مجموع(عنوان_بيانات، طول)
    متغير مج = 0
    متغير ع = 0
    
    بينما (ع < طول)
        متغير ب = mem_read_byte(عنوان_بيانات + ع)
        
        # محاكاة XOR بالحساب
        متغير مج_بت = مج - ((مج / 256) * 256)
        متغير فرق = مج_بت + ب
        إذا (فرق >= 256) فرق = فرق - 256 نهاية
        مج = (مج / 256) * 256 + فرق
        
        # rotate left بـ 5
        متغير أعلى = مج / 134217728   # 2^27
        مج = (مج - أعلى * 134217728) * 32 + أعلى
        
        ع = ع + 1
    نهاية
    
    btrfs_مجاميع_حسبت = btrfs_مجاميع_حسبت + 1
    ارجع مج
نهاية

