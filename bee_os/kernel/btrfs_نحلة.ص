# ══════════════════════════════════════════════

#* ── قراءة مفتاح عنصر من عقدة ──
   عناصر الورقة تبدأ عند إزاحة 101 
   كل عنصر: objectid(8) + type(1) + offset(8) + data_offset(4) + data_size(4) = 25 بايت
   نقرأ objectid (أول 4 بايت --- low 32 bits)
*#
صدّر دالة btrfs_اقرأ_مفتاح_عنصر(فهرس_عقدة، فهرس_عنصر)
    متغير عنوان = 0
    متغير صالح = 0
    
    إذا (فهرس_عقدة == 0) عنوان = عقد_عنوان_0 نهاية
    إذا (فهرس_عقدة == 0) صالح = عقد_صالحة_0 نهاية
    إذا (فهرس_عقدة == 1) عنوان = عقد_عنوان_1 نهاية
    إذا (فهرس_عقدة == 1) صالح = عقد_صالحة_1 نهاية
    إذا (فهرس_عقدة == 2) عنوان = عقد_عنوان_2 نهاية
    إذا (فهرس_عقدة == 2) صالح = عقد_صالحة_2 نهاية
    إذا (فهرس_عقدة == 3) عنوان = عقد_عنوان_3 نهاية
    إذا (فهرس_عقدة == 3) صالح = عقد_صالحة_3 نهاية
    
    إذا (صالح == 0) ارجع -1 نهاية
    إذا (عنوان == 0) ارجع -1 نهاية
    
    # إزاحة العنصر: 101 + فهرس * 25
    متغير إزاحة_عنصر = 101 + (فهرس_عنصر * 25)
    متغير objectid = mem_read_dword(عنوان + إزاحة_عنصر)
    
    btrfs_بحث_شجرة = btrfs_بحث_شجرة + 1
    ارجع objectid
نهاية

#* ── قراءة نوع العنصر ── *#
صدّر دالة btrfs_اقرأ_صنف_عنصر(فهرس_عقدة، فهرس_عنصر)
    متغير عنوان = 0
    إذا (فهرس_عقدة == 0) عنوان = عقد_عنوان_0 نهاية
    إذا (فهرس_عقدة == 1) عنوان = عقد_عنوان_1 نهاية
    إذا (فهرس_عقدة == 2) عنوان = عقد_عنوان_2 نهاية
    إذا (فهرس_عقدة == 3) عنوان = عقد_عنوان_3 نهاية
    
    إذا (عنوان == 0) ارجع -1 نهاية
    
    # النوع عند إزاحة 101 + فهرس * 25 + 8
    متغير إزاحة_نوع = 101 + (فهرس_عنصر * 25) + 8
    متغير ص_ق = mem_read_byte(عنوان + إزاحة_نوع)
    ارجع ص_ق
نهاية

# ══════════════════════════════════════════════
# القسم 9: إدارة اللقطات
# ══════════════════════════════════════════════

#* ── إنشاء لقطة (snapshot) ──
   في btrfs، اللقطة هي نسخة CoW من شجرة FS
   نسجل جذر الشجرة والجيل
*#
صدّر دالة btrfs_اصنع_لقطة(جذر_قطاع، جيل_لقطة)
    # ابحث عن خانة فارغة
    إذا (لقطة_صالحة_0 == 0)
