   معرف_هدف: معرف المستخدم أو المجموعة
   ملف_inode: رقم inode الملف
   أذونات_ق: الأذونات (rwx)
*#

متغير acl_ص_ق_0 = 0
متغير acl_معرف_0 = 0
متغير acl_inode_0 = 0
متغير acl_أذونات_0 = 0

متغير acl_ص_ق_1 = 0
متغير acl_معرف_1 = 0
متغير acl_inode_1 = 0
متغير acl_أذونات_1 = 0

