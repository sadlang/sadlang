# ══════════════════════════════════════════════
# القسم 2: فحص الأذونات الأساسية
# ══════════════════════════════════════════════

#* ── تحليل أذونات POSIX ──
   المدخلات: وضع الملف (مثل 755)
   المخرجات: أذونات المالك (الرقم الأول)
*#
صدّر دالة أذونات_مالك(وضع)
    متغير مئات = وضع / 100
    ارجع مئات
نهاية

صدّر دالة أذونات_مجموعة(وضع)
    متغير باقي = وضع - ((وضع / 100) * 100)
    متغير عشرات = باقي / 10
    ارجع عشرات
نهاية

صدّر دالة أذونات_آخرون(وضع)
    متغير باقي = وضع - ((وضع / 10) * 10)
    ارجع باقي
نهاية

#* ── التحقق من إذن معين ── *#
صدّر دالة أذونات_تحقق_قراءة(أذونات_ج)
    إذا (أذونات_ج >= 4)
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة أذونات_تحقق_كتابة(أذونات_ج)
    متغير باقي = أذونات_ج - ((أذونات_ج / 4) * 4)
    إذا (باقي >= 2)
        ارجع 1
    نهاية
    ارجع 0
نهاية

صدّر دالة أذونات_تحقق_تنفيذ(أذونات_ج)
    متغير باقي = أذونات_ج - ((أذونات_ج / 2) * 2)
    إذا (باقي >= 1)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# القسم 3: فحص الوصول الكامل
# ══════════════════════════════════════════════

#* ── فحص هل المستخدم يملك الإذن المطلوب ──
   المدخلات:
   - وضع_ملف: أذونات POSIX (مثل 755)
   - uid_ملف: معرف مالك الملف
   - gid_ملف: معرف مجموعة الملف
   - uid_مستخدم: معرف المستخدم الحالي
   - gid_مستخدم: معرف مجموعة المستخدم
   - إذن_مطلوب: 4=قراءة، 2=كتابة، 1=تنفيذ
   
   المخرجات: 1=مسموح، 0=مرفوض
*#
صدّر دالة أذونات_فحص(وضع_ملف، uid_ملف، gid_ملف، uid_مستخدم، gid_مستخدم، إذن_مطلوب)
    # root (uid=0) يملك كل الصلاحيات
    إذا (uid_مستخدم == 0)
        ارجع 1
    نهاية
    
    متغير أذونات_فعلية = 0
    
    # هل المستخدم هو المالك؟
    إذا (uid_مستخدم == uid_ملف)
        أذونات_فعلية = أذونات_مالك(وضع_ملف)
    وإلا
        # هل المستخدم في المجموعة؟
        إذا (gid_مستخدم == gid_ملف)
            أذونات_فعلية = أذونات_مجموعة(وضع_ملف)
        وإلا
            أذونات_فعلية = أذونات_آخرون(وضع_ملف)
        نهاية
    نهاية
    
    # تحقق من الإذن المطلوب
    إذا (إذن_مطلوب == إذن_قراءة)
        ارجع أذونات_تحقق_قراءة(أذونات_فعلية)
    نهاية
    إذا (إذن_مطلوب == إذن_كتابة)
        ارجع أذونات_تحقق_كتابة(أذونات_فعلية)
    نهاية
    إذا (إذن_مطلوب == إذن_تنفيذ)
        ارجع أذونات_تحقق_تنفيذ(أذونات_فعلية)
    نهاية
    
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# القسم 4: إدارة قواعد ACL
# ══════════════════════════════════════════════

#* ── إضافة قاعدة ACL ── *#
صدّر دالة acl_أضف(ص_ق_ق، معرف_هدف، inode، أذونات_ج)
    إذا (عدد_قواعد_acl >= 8)
        kernel_print_string("  [acl] ERROR: ACL table full")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    متغير ف = عدد_قواعد_acl + 0
    إذا (ف == 0)
        acl_ص_ق_0 = ص_ق_ق
        acl_معرف_0 = معرف_هدف
        acl_inode_0 = inode
        acl_أذونات_0 = أذونات_ج
    نهاية
    إذا (ف == 1)
        acl_ص_ق_1 = ص_ق_ق
        acl_معرف_1 = معرف_هدف
        acl_inode_1 = inode
        acl_أذونات_1 = أذونات_ج
    نهاية
    إذا (ف == 2)
        acl_ص_ق_2 = ص_ق_ق
        acl_معرف_2 = معرف_هدف
        acl_inode_2 = inode
        acl_أذونات_2 = أذونات_ج
    نهاية
    إذا (ف == 3)
        acl_ص_ق_3 = ص_ق_ق
        acl_معرف_3 = معرف_هدف
        acl_inode_3 = inode
        acl_أذونات_3 = أذونات_ج
    نهاية
    إذا (ف == 4)
        acl_ص_ق_4 = ص_ق_ق
        acl_معرف_4 = معرف_هدف
        acl_inode_4 = inode
        acl_أذونات_4 = أذونات_ج
    نهاية
    إذا (ف == 5)
        acl_ص_ق_5 = ص_ق_ق
        acl_معرف_5 = معرف_هدف
        acl_inode_5 = inode
        acl_أذونات_5 = أذونات_ج
    نهاية
    إذا (ف == 6)
        acl_ص_ق_6 = ص_ق_ق
        acl_معرف_6 = معرف_هدف
        acl_inode_6 = inode
        acl_أذونات_6 = أذونات_ج
    نهاية
    إذا (ف == 7)
        acl_ص_ق_7 = ص_ق_ق
        acl_معرف_7 = معرف_هدف
        acl_inode_7 = inode
        acl_أذونات_7 = أذونات_ج
    نهاية
    
    عدد_قواعد_acl = عدد_قواعد_acl + 1
    ارجع ف
نهاية

