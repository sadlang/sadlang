#* ===================================================================
   نظام ملفات exFAT — Extended FAT
   BeeOS exFAT Module
   ===================================================================
   
   exFAT هو نظام ملفات محسّن للذواكر الفلاش وبطاقات SD.
   مصمم كبديل لـ FAT32 مع دعم ملفات أكبر من 4GB.
   
   ── الفروقات عن FAT32 ──
   - حجم ملف أقصى: 16 EB (عملياً لا حدود)
   - حجم قسم أقصى: 128 PB
   - لا حدود 8.3 لأسماء الملفات
   - Bitmap تخصيص الكتل بدلاً من FAT التقليدي
   - لا دعم لليوميات (journaling)
   
   ── بنية القسم ──
   [Boot Region]       قطاعات 0-11
   [FAT Region]        جدول تخصيص الملفات
   [Data Region]       بيانات الملفات
   [Bitmap]            خريطة تخصيص الكتل
   [Upcase Table]      جدول تحويل الأحرف
   
   ── أنواع مدخلات الدليل ──
   0x85: File Directory Entry
   0xC0: Stream Extension Entry
   0xC1: File Name Extension Entry
   0x81: Allocation Bitmap
   0x82: Upcase Table
   0x83: Volume Label
   
   الترخيص: BeeOS Kernel Module
   الإصدار: 1.0
   ================================================================== *#

# ──────────────────────────────────────────────
# الدوال الخارجية
# ──────────────────────────────────────────────
خارجي دالة kernel_print_string(عنوان)
خارجي دالة kernel_print_number(قيمة)
خارجي دالة serial_put_hex(قيمة)
خارجي دالة disk_read_sector(قرص، قطاع، عنوان)
خارجي دالة kernel_allocate(مقاس_ذاكرة)
خارجي دالة kernel_free(عنوان_ذاكرة)
خارجي دالة mem_read_byte(عنوان)
خارجي دالة mem_write_byte(عنوان، قيمة)
خارجي دالة mem_read_dword(عنوان)

# ──────────────────────────────────────────────
# الثوابت
# ──────────────────────────────────────────────
ثابت exfat_توقيع = 5765742             # "EXFAT" (مبسّط)
ثابت اقصى_أقسام_exfat = 2

#* ── أنواع مدخلات الدليل ── *#
ثابت مدخل_ملف = 133                    # 0x85
ثابت مدخل_تدفق = 192                   # 0xC0
ثابت مدخل_اسم = 193                    # 0xC1
ثابت مدخل_bitmap = 129                  # 0x81
ثابت مدخل_upcase = 130                  # 0x82
ثابت مدخل_تسمية = 131                  # 0x83

# ══════════════════════════════════════════════
# القسم 1: معلومات القسم
# ══════════════════════════════════════════════

#* ── بيانات Boot Sector ── *#

# قسم 0
متغير exfat_قطاع_أول_0 = 0             # أول قطاع في القسم
متغير exfat_عدد_قطاعات_0 = 0           # إجمالي القطاعات
متغير exfat_بداية_fat_0 = 0             # أول قطاع في FAT
متغير exfat_طول_fat_0 = 0               # عدد قطاعات FAT
متغير exfat_بداية_بيانات_0 = 0          # أول قطاع بيانات (cluster heap)
متغير exfat_عدد_كتل_0 = 0              # إجمالي الكتل
متغير exfat_كتلة_جذر_0 = 0             # كتلة الدليل الجذر
متغير exfat_إزاحة_قطاع_0 = 9           # log2(حجم القطاع) — عادة 9 = 512
متغير exfat_إزاحة_كتلة_0 = 0           # log2(قطاعات_لكل_كتلة)
متغير exfat_مهيأ_0 = 0

# قسم 1
متغير exfat_قطاع_أول_1 = 0
متغير exfat_عدد_قطاعات_1 = 0
متغير exfat_بداية_fat_1 = 0
متغير exfat_طول_fat_1 = 0
متغير exfat_بداية_بيانات_1 = 0
متغير exfat_عدد_كتل_1 = 0
متغير exfat_كتلة_جذر_1 = 0
متغير exfat_إزاحة_قطاع_1 = 9
متغير exfat_إزاحة_كتلة_1 = 0
متغير exfat_مهيأ_1 = 0

# ══════════════════════════════════════════════
# القسم 2: قراءة Boot Sector
# ══════════════════════════════════════════════

#* ── power of 2 ── *#
دالة exfat_قوة_2(أس)
    متغير نتيجة = 1
    متغير ع = 0
    بينما (ع < أس)
        نتيجة = نتيجة * 2
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

#* ── تهيئة قسم exFAT ──
   يقرأ الـ Boot Sector ويستخرج المعلومات
*#
صدّر دالة exfat_هيّئ(فهرس_قسم، قرص، قطاع_بداية)
    # تخصيص مخزن للقطاع
    متغير مخزن = kernel_allocate(512)
    إذا (مخزن == 0)
        kernel_print_string("  [exfat] ERROR: cannot allocate buffer")
        kernel_print_number(10)
        ارجع -1
    نهاية
    
    # قراءة Boot Sector
    disk_read_sector(قرص، قطاع_بداية، مخزن)
    
    # التحقق من التوقيع (الإزاحة 3: "EXFAT   ")
    متغير ب0 = mem_read_byte(مخزن + 3)
    متغير ب1 = mem_read_byte(مخزن + 4)
    
    # E=69, X=88
    إذا (ب0 != 69)
        kernel_print_string("  [exfat] ERROR: invalid signature")
        kernel_print_number(10)
        kernel_free(مخزن)
        ارجع -1
    نهاية
    إذا (ب1 != 88)
        kernel_print_string("  [exfat] ERROR: invalid signature (2)")
        kernel_print_number(10)
        kernel_free(مخزن)
        ارجع -1
    نهاية
    
    # قراءة الحقول
    # الإزاحة 64: PartitionOffset (8 بايت)
    # الإزاحة 72: VolumeLength (8 بايت)
    # الإزاحة 80: FatOffset (4 بايت)
    # الإزاحة 84: FatLength (4 بايت)
    # الإزاحة 88: ClusterHeapOffset (4 بايت)
    # الإزاحة 92: ClusterCount (4 بايت)
    # الإزاحة 96: FirstClusterOfRootDirectory (4 بايت)
    # الإزاحة 108: BytesPerSectorShift (1 بايت)
    # الإزاحة 109: SectorsPerClusterShift (1 بايت)
    
    متغير fat_بداية = mem_read_dword(مخزن + 80)
    متغير fat_طول = mem_read_dword(مخزن + 84)
    متغير كومة_بداية = mem_read_dword(مخزن + 88)
    متغير كتل_عدد = mem_read_dword(مخزن + 92)
    متغير جذر_كتلة = mem_read_dword(مخزن + 96)
    متغير إزاحة_قطاع = mem_read_byte(مخزن + 108)
    متغير إزاحة_كتلة = mem_read_byte(مخزن + 109)
    
    إذا (فهرس_قسم == 0)
        exfat_قطاع_أول_0 = قطاع_بداية
        exfat_بداية_fat_0 = fat_بداية
        exfat_طول_fat_0 = fat_طول
        exfat_بداية_بيانات_0 = كومة_بداية
        exfat_عدد_كتل_0 = كتل_عدد
        exfat_كتلة_جذر_0 = جذر_كتلة
        exfat_إزاحة_قطاع_0 = إزاحة_قطاع
        exfat_إزاحة_كتلة_0 = إزاحة_كتلة
        exfat_مهيأ_0 = 1
    نهاية
    إذا (فهرس_قسم == 1)
        exfat_قطاع_أول_1 = قطاع_بداية
        exfat_بداية_fat_1 = fat_بداية
        exfat_طول_fat_1 = fat_طول
        exfat_بداية_بيانات_1 = كومة_بداية
        exfat_عدد_كتل_1 = كتل_عدد
        exfat_كتلة_جذر_1 = جذر_كتلة
        exfat_إزاحة_قطاع_1 = إزاحة_قطاع
        exfat_إزاحة_كتلة_1 = إزاحة_كتلة
        exfat_مهيأ_1 = 1
    نهاية
    
    kernel_print_string("    exfat: partition ")
    kernel_print_number(فهرس_قسم)
    kernel_print_string(" clusters=")
    kernel_print_number(كتل_عدد)
    kernel_print_string(" root=")
    kernel_print_number(جذر_كتلة)
    kernel_print_number(10)
    
    kernel_free(مخزن)
    ارجع 0
نهاية

# ══════════════════════════════════════════════
# القسم 3: تحويل كتلة إلى قطاع
# ══════════════════════════════════════════════

#* ── تحويل رقم الكتلة إلى قطاع فعلي ──
   cluster_sector = heap_offset + (cluster - 2) * sectors_per_cluster
*#
صدّر دالة exfat_كتلة_إلى_قطاع(فهرس_قسم، كتلة)
    متغير بداية = 0
    متغير إزاحة_ك = 0
    متغير قطاع_أول = 0
    
    إذا (فهرس_قسم == 0)
        بداية = exfat_بداية_بيانات_0
        إزاحة_ك = exfat_إزاحة_كتلة_0
        قطاع_أول = exfat_قطاع_أول_0
    نهاية
    إذا (فهرس_قسم == 1)
        بداية = exfat_بداية_بيانات_1
        إزاحة_ك = exfat_إزاحة_كتلة_1
        قطاع_أول = exfat_قطاع_أول_1
    نهاية
    
    متغير قطاعات_لكل_كتلة = exfat_قوة_2(إزاحة_ك)
    متغير قطاع = قطاع_أول + بداية + (كتلة - 2) * قطاعات_لكل_كتلة
    ارجع قطاع
نهاية

# ══════════════════════════════════════════════
# القسم 4: قراءة FAT
# ══════════════════════════════════════════════

#* ── قراءة مدخل FAT ──
   كل مدخل 4 بايت (32 بت)
   0x00000000: حرة
   0xFFFFFFF7: كتلة تالفة
   0xFFFFFFFF: نهاية السلسلة
*#
صدّر دالة exfat_اقرأ_fat(فهرس_قسم، قرص، كتلة)
    متغير fat_بداية = 0
    متغير قطاع_أول = 0
    
    إذا (فهرس_قسم == 0)
        fat_بداية = exfat_بداية_fat_0
        قطاع_أول = exfat_قطاع_أول_0
    نهاية
    إذا (فهرس_قسم == 1)
        fat_بداية = exfat_بداية_fat_1
        قطاع_أول = exfat_قطاع_أول_1
    نهاية
    
    # كل قطاع يحتوي 128 مدخل FAT (512/4)
    متغير قطاع_fat = قطاع_أول + fat_بداية + (كتلة / 128)
    متغير إزاحة_داخلية = (كتلة - ((كتلة / 128) * 128)) * 4
    
    متغير مخزن = kernel_allocate(512)
    إذا (مخزن == 0)
        ارجع -1
    نهاية
    
    disk_read_sector(قرص، قطاع_fat، مخزن)
    متغير قيمة = mem_read_dword(مخزن + إزاحة_داخلية)
    kernel_free(مخزن)
    
    ارجع قيمة
نهاية

# ══════════════════════════════════════════════
# القسم 5: تقرير
# ══════════════════════════════════════════════

صدّر دالة exfat_تقرير()
    kernel_print_string("=== exFAT Report ===")
    kernel_print_number(10)
    
    إذا (exfat_مهيأ_0 == 1)
        kernel_print_string("  Partition 0: clusters=")
        kernel_print_number(exfat_عدد_كتل_0)
        kernel_print_string(" root=")
        kernel_print_number(exfat_كتلة_جذر_0)
        kernel_print_number(10)
    نهاية
    إذا (exfat_مهيأ_1 == 1)
        kernel_print_string("  Partition 1: clusters=")
        kernel_print_number(exfat_عدد_كتل_1)
        kernel_print_string(" root=")
        kernel_print_number(exfat_كتلة_جذر_1)
        kernel_print_number(10)
    نهاية
    
    kernel_print_string("=== End exFAT ===")
    kernel_print_number(10)
    ارجع 0
نهاية

