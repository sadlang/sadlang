## ─────────────────────────────────────────────────────
## تخصيص صفحة فيزيائية واحدة (4KB)
## ─────────────────────────────────────────────────────
## البحث: First Fit — أول صفحة حرة في خريطة البتات
## يُعيد: عنوان الصفحة الفيزيائية، أو 0 إذا لم تتوفر ذاكرة
##
## خوارزمية:
##   1. ابحث عن أول كلمة في خريطة البتات ليست كلها 1
##   2. في تلك الكلمة، ابحث عن أول بت = 0
##   3. عيّن ذلك البت = 1
##   4. أعد عنوان الصفحة المقابلة
صدّر دالة خصص_صفحة()
    # التحقق من وجود صفحات حرة
    إذا (الصفحات_الحرة == 0)
        ارجع 0  # لا توجد ذاكرة متاحة!
    نهاية
    
    # البحث في خريطة البتات
    متغير عدد_الكلمات = إجمالي_الصفحات / 64
    إذا (إجمالي_الصفحات % 64 > 0)
        عدد_الكلمات = عدد_الكلمات + 1
    نهاية
    
    متغير ك = 0
    بينما (ك < عدد_الكلمات)
        # قراءة كلمة من خريطة البتات
        متغير عنوان_الكلمة = عنوان_خريطة_البتات + (ك * 8)
        متغير قيمة_الكلمة = اقرأ_ذاكرة(عنوان_الكلمة)
        
        # تخطي الكلمات الممتلئة (كل البتات = 1)
        # كلمة 64 بت كلها 1 = 0xFFFFFFFFFFFFFFFF = -1 (بالتكملة الثنائية)
        إذا (قيمة_الكلمة != -1)
            # ابحث عن أول بت = 0 في هذه الكلمة
            متغير بت = 0
            بينما (بت < 64)
                متغير قناع = 1
                متغير ي = 0
                بينما (ي < بت)
                    قناع = قناع * 2
                    ي = ي + 1
                نهاية
                
                متغير بت_حالي = (قيمة_الكلمة / قناع) % 2
                إذا (بت_حالي == 0)
                    # وجدنا صفحة حرة!
                    متغير رقم_الصفحة = ك * 64 + بت
                    
                    # تجنب تخصيص صفحات خارج النطاق
                    إذا (رقم_الصفحة < إجمالي_الصفحات)
                        # تعليم الصفحة كمشغولة
                        عيّن_بت(رقم_الصفحة)
                        
                        # تحديث الإحصائيات
                        الصفحات_الحرة = الصفحات_الحرة - 1
                        الصفحات_المشغولة = الصفحات_المشغولة + 1
                        عدد_التخصيصات = عدد_التخصيصات + 1
                        
                        # إعادة عنوان الصفحة الفيزيائية
                        ارجع صفحة_إلى_عنوان(رقم_الصفحة)
                    نهاية
                نهاية
                بت = بت + 1
            نهاية
        نهاية
        ك = ك + 1
    نهاية
    
    ارجع 0  # لم نجد صفحة حرة — كارثة!
نهاية

## ─────────────────────────────────────────────────────
## تحرير صفحة فيزيائية
## ─────────────────────────────────────────────────────
## المعامل: عنوان — العنوان الفيزيائي للصفحة (يجب أن يكون مُحاذياً لـ 4KB)
## تحذير: تحرير صفحة مرتين = خطأ فادح (double free)!
صدّر دالة حرر_صفحة(عنوان)
    # التحقق من صحة العنوان
    إذا (عنوان == 0)
        ارجع  # لا تحرر العنوان الصفري!
    نهاية
    
    # التحقق من المحاذاة
    إذا (عنوان % حجم_الصفحة != 0)
        # عنوان غير مُحاذٍ — خطأ!
        ارجع
    نهاية
    
    متغير رقم_الصفحة = عنوان_إلى_صفحة(عنوان)
    
    # التحقق من النطاق
    إذا (رقم_الصفحة >= إجمالي_الصفحات)
        ارجع  # خارج نطاق الذاكرة!
    نهاية
    
    # فحص double-free
    إذا (افحص_بت(رقم_الصفحة) == 0)
        # الصفحة حرة بالفعل! هذا خطأ double-free
        ارجع
    نهاية
    
    # مسح البت — تحرير الصفحة
    امسح_بت(رقم_الصفحة)
    
    # تحديث الإحصائيات
    الصفحات_الحرة = الصفحات_الحرة + 1
    الصفحات_المشغولة = الصفحات_المشغولة - 1
    عدد_التحريرات = عدد_التحريرات + 1
    
    # ملء الصفحة المُحررة بنمط (اختياري — للكشف عن use-after-free)
    # هذا يُبطئ الأداء لكن يكشف الأخطاء في وقت مبكر
    # في البناء الإنتاجي يمكن تعطيله
    املأ_ذاكرة(عنوان، 222، حجم_الصفحة)  # 0xDE = 222 (DEAD pattern)
نهاية

## ─────────────────────────────────────────────────────
## تخصيص عدة صفحات متجاورة
## ─────────────────────────────────────────────────────
## المعامل: عدد — عدد الصفحات المطلوبة
## يُعيد: عنوان بداية أول صفحة، أو 0 إذا لم تتوفر كتلة كافية
صدّر دالة خصص_صفحات(عدد)
    إذا (عدد == 0)
        ارجع 0
    نهاية
    
    إذا (عدد == 1)
        ارجع خصص_صفحة()
    نهاية
    
    إذا (عدد > الصفحات_الحرة)
        ارجع 0  # لا يوجد ما يكفي من الصفحات
    نهاية
    
    # بحث عن كتلة متجاورة من الصفحات الحرة
    متغير بداية = 0
    متغير متتالية = 0
    
    متغير ص = 0
    بينما (ص < إجمالي_الصفحات)
        إذا (افحص_بت(ص) == 0)
            # صفحة حرة — ابدأ أو تابع العد
            إذا (متتالية == 0)
                بداية = ص
            نهاية
            متتالية = متتالية + 1
            
            # هل وجدنا ما يكفي؟
            إذا (متتالية >= عدد)
                # نعم! خصّص كل الصفحات
                متغير ت = 0
                بينما (ت < عدد)
                    عيّن_بت(بداية + ت)
                    ت = ت + 1
                نهاية
                
                الصفحات_الحرة = الصفحات_الحرة - عدد
                الصفحات_المشغولة = الصفحات_المشغولة + عدد
                عدد_التخصيصات = عدد_التخصيصات + 1
                
                ارجع صفحة_إلى_عنوان(بداية)
            نهاية
        وإلا
            # صفحة مشغولة — أعد العد من الصفر
            متتالية = 0
        نهاية
        ص = ص + 1
    نهاية
    
    ارجع 0  # لم نجد كتلة متجاورة كافية
