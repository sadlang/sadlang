    نهاية
    
    متغير عنوان_pt = عنوان_من_مدخل(مدخل_pd)
    متغير مدخل_pt = اقرأ_مدخل_جدول(عنوان_pt، ف_pt)
    إذا ((مدخل_pt % 2) == 0)
        ارجع 0
    نهاية
    
    متغير عنوان_الصفحة = عنوان_من_مدخل(مدخل_pt)
    ارجع عنوان_الصفحة + إزاحة_الصفحة(عنوان_افتراضي)
