## ─────────────────────────────────────────────────────
## استخراج العنوان الفيزيائي من مدخل جدول
## ─────────────────────────────────────────────────────
## بتات [51:12] تحتوي العنوان الفيزيائي (مُحاذى لـ 4KB)
دالة عنوان_من_مدخل(مدخل)
    # مسح بتات الأعلام (0-11) والبتات العليا (52-63)
    # القناع: 0x000FFFFFFFFFF000
    # بتبسيط: (مدخل / 4096) * 4096 → يمسح الـ 12 بت السفلية
    متغير بلا_أعلام = (مدخل / 4096) * 4096
    # مسح البتات العليا (52-63) — نفترض أنها صفر في العناوين العادية
    ارجع بلا_أعلام % 4503599627370496  # 2^52
نهاية

## ─────────────────────────────────────────────────────
## تعيين صفحة — ربط عنوان افتراضي بصفحة فيزيائية
## ─────────────────────────────────────────────────────
## هذه الدالة هي قلب نظام الذاكرة الافتراضية.
## تُنشئ المسار الكامل في جداول الصفحات الأربعة.
##
## المعاملات:
##   عنوان_افتراضي — العنوان الافتراضي المراد تعيينه
##   عنوان_فيزيائي — الصفحة الفيزيائية الهدف
##   أعلام — أعلام الصفحة (موجودة، كتابة، مستخدم، إلخ)
صدّر دالة عيّن_صفحة(عنوان_افتراضي، عنوان_فيزيائي، أعلام)
    # خطوة 1: الحصول على عنوان PML4
    إذا (عنوان_PML4 == 0)
        عنوان_PML4 = اقرأ_CR3()
    نهاية
    
    # استخراج الفهارس الأربعة
    متغير ف_pml4 = فهرس_PML4(عنوان_افتراضي)
    متغير ف_pdpt = فهرس_PDPT(عنوان_افتراضي)
    متغير ف_pd   = فهرس_PD(عنوان_افتراضي)
    متغير ف_pt   = فهرس_PT(عنوان_افتراضي)
    
    # خطوة 2: التنقل في PML4 → PDPT
    متغير مدخل_pml4 = اقرأ_مدخل_جدول(عنوان_PML4، ف_pml4)
    متغير عنوان_pdpt = 0
    
    إذا ((مدخل_pml4 % 2) == 1)
        # الجدول موجود — استخرج عنوانه
        عنوان_pdpt = عنوان_من_مدخل(مدخل_pml4)
    وإلا
        # الجدول غير موجود — خصص صفحة جديدة له
        عنوان_pdpt = خصص_صفحة()
        إذا (عنوان_pdpt == 0)
            ارجع  # فشل التخصيص!
        نهاية
        # صفّر الجدول الجديد
        املأ_ذاكرة(عنوان_pdpt، 0، حجم_الصفحة)
        # سجّل الجدول في PML4
        اكتب_مدخل_جدول(عنوان_PML4، ف_pml4، عنوان_pdpt + أعلام_نواة_بيانات)
    نهاية
    
    # خطوة 3: التنقل في PDPT → PD
    متغير مدخل_pdpt = اقرأ_مدخل_جدول(عنوان_pdpt، ف_pdpt)
    متغير عنوان_pd = 0
    
    إذا ((مدخل_pdpt % 2) == 1)
        عنوان_pd = عنوان_من_مدخل(مدخل_pdpt)
    وإلا
        عنوان_pd = خصص_صفحة()
        إذا (عنوان_pd == 0)
            ارجع
        نهاية
        املأ_ذاكرة(عنوان_pd، 0، حجم_الصفحة)
        اكتب_مدخل_جدول(عنوان_pdpt، ف_pdpt، عنوان_pd + أعلام_نواة_بيانات)
    نهاية
    
    # خطوة 4: التنقل في PD → PT
    متغير مدخل_pd = اقرأ_مدخل_جدول(عنوان_pd، ف_pd)
    متغير عنوان_pt = 0
    
    إذا ((مدخل_pd % 2) == 1)
        عنوان_pt = عنوان_من_مدخل(مدخل_pd)
    وإلا
        عنوان_pt = خصص_صفحة()
        إذا (عنوان_pt == 0)
            ارجع
        نهاية
        املأ_ذاكرة(عنوان_pt، 0، حجم_الصفحة)
        اكتب_مدخل_جدول(عنوان_pd، ف_pd، عنوان_pt + أعلام_نواة_بيانات)
    نهاية
    
    # خطوة 5: كتابة المدخل النهائي في PT
    # يُشير إلى الصفحة الفيزيائية الهدف + الأعلام
    اكتب_مدخل_جدول(عنوان_pt، ف_pt، عنوان_فيزيائي + أعلام)
    
    # إبطال الصفحة في TLB
    أبطل_صفحة_TLB(عنوان_افتراضي)
نهاية

## ─────────────────────────────────────────────────────
## إلغاء تعيين صفحة — إزالة ربط عنوان افتراضي
