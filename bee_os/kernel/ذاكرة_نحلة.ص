# القسم ٧: جداول الصفحات — الذاكرة الافتراضية
# ═══════════════════════════════════════════════════════════════════════════════
#
# جداول صفحات x86_64 (4 مستويات — Paging):
#
#   PML4 (Page Map Level 4)     — 512 مدخل × 512GB = 256TB
#     └─ PDPT (Page Dir Ptr Table) — 512 مدخل × 1GB
#         └─ PD (Page Directory)    — 512 مدخل × 2MB
#             └─ PT (Page Table)     — 512 مدخل × 4KB = صفحة فيزيائية
#
# كل مدخل = 64 بت (8 بايتات):
#   [63] NX (No Execute)
#   [62:52] متاح للنظام
#   [51:12] عنوان الصفحة الفيزيائية (مُحاذى لـ 4KB)
#   [11:9] متاح للنظام
#   [8] Global
#   [7] Page Size (2MB if set in PD)
#   [6] Dirty
#   [5] Accessed
#   [4] Cache Disable
#   [3] Write-Through
#   [2] User/Supervisor
#   [1] Read/Write
#   [0] Present

## عنوان جدول PML4 الحالي (من CR3)
متغير عنوان_PML4 = 0

## ─────────────────────────────────────────────────────
## استخراج الفهارس من عنوان افتراضي
## ─────────────────────────────────────────────────────
## العنوان الافتراضي 48 بت مقسم كالتالي:
##   بتات 47-39: فهرس PML4 (9 بتات = 0-511)
##   بتات 38-30: فهرس PDPT (9 بتات = 0-511)
##   بتات 29-21: فهرس PD   (9 بتات = 0-511)
##   بتات 20-12: فهرس PT   (9 بتات = 0-511)
##   بتات 11-0:  إزاحة الصفحة (12 بت = 0-4095)

## استخراج فهرس PML4 من عنوان افتراضي
دالة فهرس_PML4(عنوان)
    # (عنوان >> 39) & 0x1FF
    # بما أن ص لا تدعم >> نستخدم القسمة
    متغير مقسوم = 1
    متغير ي = 0
    بينما (ي < 39)
        مقسوم = مقسوم * 2
        ي = ي + 1
    نهاية
    ارجع (عنوان / مقسوم) % 512
نهاية

