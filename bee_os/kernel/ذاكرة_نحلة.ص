# ──────────────── دوال المنافذ (I/O Ports) ────────────────
خارجي("sad_ll_port_inb") دالة اقرأ_منفذ(رقم_المنفذ)
خارجي("sad_ll_port_outb") دالة اكتب_منفذ(رقم_المنفذ، قيمة_البيان)

# ──────────────── دوال الذاكرة المنخفضة ────────────────
## قراءة قيمة من عنوان ذاكرة فيزيائي
## هذه الدالة تقرأ 64 بت (8 بايتات) من العنوان المحدد
خارجي("sad_ll_mem_read64") دالة اقرأ_ذاكرة(عنوان)

## كتابة قيمة إلى عنوان ذاكرة فيزيائي
خارجي("sad_ll_mem_write64") دالة اكتب_ذاكرة(عنوان، قيمة)

## قراءة 32 بت
خارجي("sad_ll_mem_read32") دالة اقرأ_ذاكرة32(عنوان)

## كتابة 32 بت
خارجي("sad_ll_mem_write32") دالة اكتب_ذاكرة32(عنوان، قيمة)

## نسخ كتلة ذاكرة (مثل memcpy)
خارجي("sad_ll_memcpy") دالة انسخ_ذاكرة(الوجهة، المصدر، الحجم)

## ملء كتلة ذاكرة بقيمة (مثل memset)
خارجي("sad_ll_memset") دالة املأ_ذاكرة(الوجهة، القيمة، الحجم)

# ──────────────── دوال سجلات التحكم ────────────────
## قراءة سجل CR3 — يحتوي عنوان جدول الصفحات الجذري (PML4)
خارجي("sad_ll_read_cr3") دالة اقرأ_CR3()

## كتابة سجل CR3 — تبديل جدول الصفحات (يُبطل TLB)
خارجي("sad_ll_write_cr3") دالة اكتب_CR3(قيمة)

## إبطال صفحة في TLB (Translation Lookaside Buffer)
## يُستخدم بعد تعديل جدول صفحات دون تبديل CR3 بالكامل
خارجي("sad_ll_invlpg") دالة أبطل_صفحة_TLB(عنوان_افتراضي)

# ──────────────── دوال Serial (تصحيح الأخطاء) ────────────────
