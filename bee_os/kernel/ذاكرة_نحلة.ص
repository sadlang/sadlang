## تخصيص كتلة من Buddy Allocator
## المعامل: مستوى (0 = صفحة واحدة، 1 = صفحتان، ...)
## يُعيد: عنوان فيزيائي، أو 0 إذا لا توجد ذاكرة
صدّر دالة خصص_buddy(مستوى)
    # حاول سحب كتلة من هذا المستوى
    متغير عنوان = اسحب_كتلة_حرة(مستوى)
    إذا (عنوان != 0)
        ارجع عنوان
    نهاية
    
    # لا توجد كتلة في هذا المستوى — ابحث في المستوى الأعلى
    إذا (مستوى >= 4)
        ارجع 0  # وصلنا لأعلى مستوى مدعوم
    نهاية
    
    # حاول تقسيم كتلة أكبر
    متغير كتلة_كبيرة = خصص_buddy(مستوى + 1)
    إذا (كتلة_كبيرة == 0)
        ارجع 0  # لا توجد كتل أكبر أيضاً
    نهاية
    
    # قسّم الكتلة الكبيرة إلى نصفين
    # النصف الأول: نُعيده للمُستدعي
    # النصف الثاني: نُضيفه لقائمة هذا المستوى
    متغير حجم_النصف = حجم_مستوى(مستوى) * حجم_الصفحة
    متغير النصف_الثاني = كتلة_كبيرة + حجم_النصف
    
    # أضف النصف الثاني للقائمة الحرة
    أضف_كتلة_حرة(مستوى، النصف_الثاني)
    
    # أعد النصف الأول
    ارجع كتلة_كبيرة
نهاية

## تحرير كتلة Buddy — مع محاولة دمج الأصدقاء
صدّر دالة حرر_buddy(عنوان، مستوى)
    إذا (عنوان == 0)
        ارجع
    نهاية
    
    # حاول دمج مع الصديق
    إذا (مستوى < 4)
        متغير عنوان_صديق = عنوان_الصديق(عنوان، مستوى)
        
        # افحص هل الصديق حر (فحص بسيط — هل هو في القائمة الحرة؟)
        # في التطبيق الكامل نفحص خريطة البتات
        متغير رقم_صفحة_الصديق = عنوان_إلى_صفحة(عنوان_صديق)
        إذا (رقم_صفحة_الصديق < إجمالي_الصفحات)
            إذا (افحص_بت(رقم_صفحة_الصديق) == 0)
                # الصديق حر! ادمج الكتلتين
                # الكتلة المُدمجة تبدأ من العنوان الأصغر
                متغير بداية_المُدمجة = عنوان
                إذا (عنوان_صديق < عنوان)
                    بداية_المُدمجة = عنوان_صديق
                نهاية
                
                # حرر بشكل تصاعدي (دمج متكرر)
                حرر_buddy(بداية_المُدمجة، مستوى + 1)
                ارجع
            نهاية
        نهاية
    نهاية
    
    # لا يمكن الدمج — أضف للقائمة الحرة في هذا المستوى
    أضف_كتلة_حرة(مستوى، عنوان)
    
    # حرر الصفحات في خريطة البتات
    متغير عدد_صفحات = حجم_مستوى(مستوى)
    متغير رقم_أول = عنوان_إلى_صفحة(عنوان)
    متغير س = 0
    بينما (س < عدد_صفحات)
        إذا (رقم_أول + س < إجمالي_الصفحات)
            امسح_بت(رقم_أول + س)
        نهاية
        س = س + 1
    نهاية
