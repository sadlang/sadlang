## ─────────────────────────────────────────────────────
## معالجة خريطة الذاكرة — تعليم الصفحات الحرة/المحجوزة
## ─────────────────────────────────────────────────────
## تُنفّذ بعد تهيئة خريطة البتات
دالة عالج_خريطة_الذاكرة()
    # أولاً: علّم كل الصفحات كمشغولة (آمن افتراضياً)
    متغير كلمات = حجم_خريطة / 8
    متغير ث = 0
    بينما (ث < كلمات)
        اكتب_ذاكرة(عنوان_خريطة_البتات + (ث * 8)، -1)  # كل البتات = 1
        ث = ث + 1
    نهاية
    
    الصفحات_الحرة = 0
    الصفحات_المشغولة = إجمالي_الصفحات
    
    # ثم: حرر فقط المناطق المتاحة
    متغير م = 0
    بينما (م < عدد_المناطق)
        إذا (مناطق_نوع[م] == ذاكرة_متاحة)
            # حرر صفحات هذه المنطقة
            متغير بداية_صفحة = مناطق_بداية[م] / حجم_الصفحة
            متغير عدد_صفحات_المنطقة = مناطق_حجم[م] / حجم_الصفحة
            
            متغير ص = 0
            بينما (ص < عدد_صفحات_المنطقة)
                متغير رقم_الصفحة_الحالية = بداية_صفحة + ص
                إذا (رقم_الصفحة_الحالية < إجمالي_الصفحات)
                    امسح_بت(رقم_الصفحة_الحالية)
                    الصفحات_الحرة = الصفحات_الحرة + 1
                    الصفحات_المشغولة = الصفحات_المشغولة - 1
                نهاية
                ص = ص + 1
            نهاية
        نهاية
        م = م + 1
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# القسم ٩: حماية الذاكرة — أذونات الصفحات وحراسة الحدود
# ═══════════════════════════════════════════════════════════════════════════════
#
# نظام النحلة يُطبّق حماية صارمة:
#   1. كود النواة: للقراءة والتنفيذ فقط (لا يمكن تعديله)
#   2. بيانات النواة: للقراءة والكتابة (لا يمكن تنفيذها)
#   3. مساحة المستخدم: يجب أن تكون معزولة تماماً
#   4. صفحات حارسة (Guard Pages): صفحات غير مُعيّنة بين المناطق

## ─────────────────────────────────────────────────────
## تعيين أذونات منطقة ذاكرة
## ─────────────────────────────────────────────────────
## عنوان_بداية: بداية المنطقة (مُحاذى لصفحة)
## عدد_الصفحات: عدد الصفحات في المنطقة
## أعلام_جديدة: الأعلام المطلوبة
صدّر دالة حمِ_منطقة(عنوان_بداية، عدد_الصفحات، أعلام_جديدة)
    متغير ط = 0
    بينما (ط < عدد_الصفحات)
        متغير عنوان = عنوان_بداية + (ط * حجم_الصفحة)
        
        # ابحث عن الصفحة الفيزيائية المُعيّنة حالياً
        متغير فيزيائي = ترجم_عنوان(عنوان)
        
        # أعد تعيين الصفحة بالأعلام الجديدة
        إذا (فيزيائي != 0)
            عيّن_صفحة(عنوان، فيزيائي، أعلام_جديدة)
        نهاية
        
        ط = ط + 1
    نهاية
نهاية

