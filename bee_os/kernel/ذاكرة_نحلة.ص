دالة افحص_بت(رقم_الصفحة)
    متغير رقم_الكلمة = رقم_الصفحة / 64
    متغير رقم_البت = رقم_الصفحة % 64
    
    متغير عنوان_الكلمة = عنوان_خريطة_البتات + (رقم_الكلمة * 8)
    متغير قيمة_حالية = اقرأ_ذاكرة(عنوان_الكلمة)
    
    متغير قناع = 1
    متغير ي = 0
    بينما (ي < رقم_البت)
        قناع = قناع * 2
        ي = ي + 1
    نهاية
    
    ارجع (قيمة_حالية / قناع) % 2
