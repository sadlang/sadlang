## ─────────────────────────────────────────────────────
## تهيئة نظام إدارة الذاكرة الفيزيائية
## ─────────────────────────────────────────────────────
## هذه الدالة تُستدعى مرة واحدة عند إقلاع النواة
## بعد استقبال خريطة الذاكرة من محمّل الإقلاع
صدّر دالة هيئ_الذاكرة(إجمالي_ram)
    # حساب عدد الصفحات الكلي
    إجمالي_الصفحات = إجمالي_ram / حجم_الصفحة
    
    # تحديد حجم خريطة البتات (لا يقل عن 1 صفحة)
    حجم_خريطة = إجمالي_الصفحات / 8
    إذا (إجمالي_الصفحات % 8 > 0)
        حجم_خريطة = حجم_خريطة + 1
    نهاية
    
    # محاذاة لصفحة كاملة
    إذا (حجم_خريطة % حجم_الصفحة != 0)
        حجم_خريطة = ((حجم_خريطة / حجم_الصفحة) + 1) * حجم_الصفحة
    نهاية
    
    # تعيين عنوان خريطة البتات
    عنوان_خريطة_البتات = بداية_خريطة_البتات
    
    # تصفير خريطة البتات (كل الصفحات حرة مبدئياً)
    املأ_ذاكرة(عنوان_خريطة_البتات، 0، حجم_خريطة)
    
    الصفحات_الحرة = إجمالي_الصفحات
    الصفحات_المشغولة = 0
    
    # معالجة خريطة الذاكرة (إذا كانت موجودة)
    إذا (عدد_المناطق > 0)
        عالج_خريطة_الذاكرة()
    نهاية
    
    # حجز صفحات النواة وخريطة البتات نفسها
    # (نتجنب تخصيص صفحات مستخدمة بالفعل)
    متغير صفحات_الخريطة = حجم_خريطة / حجم_الصفحة
    متغير خ = 0
    بينما (خ < صفحات_الخريطة)
        متغير رقم_الصفحة_الحالية = عنوان_إلى_صفحة(عنوان_خريطة_البتات) + خ
        إذا (رقم_الصفحة_الحالية < إجمالي_الصفحات)
            إذا (افحص_بت(رقم_الصفحة_الحالية) == 0)
                عيّن_بت(رقم_الصفحة_الحالية)
                الصفحات_الحرة = الصفحات_الحرة - 1
                الصفحات_المشغولة = الصفحات_المشغولة + 1
            نهاية
        نهاية
        خ = خ + 1
    نهاية
    
    # قراءة PML4 من CR3
    عنوان_PML4 = اقرأ_CR3()
نهاية

## ─────────────────────────────────────────────────────
## طباعة إحصائيات الذاكرة
## ─────────────────────────────────────────────────────
صدّر دالة اطبع_إحصائيات_الذاكرة()
    اكتب_حرف_تسلسلي(COM1، 10)  # سطر جديد
    
    # رأس الجدول
    متغير رأس = "╔══════════════════════════════════════╗"
    متغير عنوان = "║    🐝 إحصائيات ذاكرة النحلة         ║"
    متغير فاصل = "╠══════════════════════════════════════╣"
    متغير ذيل = "╚══════════════════════════════════════╝"
    
    # الصفحات الكلية
    # (لا يمكننا طباعة النصوص مباشرة بدون دعم نصي كامل)
    # نستخدم serial_اطبع_رقم فقط
    
    serial_اطبع_رقم(إجمالي_الصفحات)
    اكتب_حرف_تسلسلي(COM1، 32)  # مسافة
    
    serial_اطبع_رقم(الصفحات_الحرة)
    اكتب_حرف_تسلسلي(COM1، 32)
    
    serial_اطبع_رقم(الصفحات_المشغولة)
    اكتب_حرف_تسلسلي(COM1، 32)
    
    serial_اطبع_رقم(عدد_التخصيصات)
    اكتب_حرف_تسلسلي(COM1، 32)
    
    serial_اطبع_رقم(عدد_التحريرات)
    اكتب_حرف_تسلسلي(COM1، 10)
    
    # ذاكرة متاحة بالميجابايت
    متغير ذاكرة_حرة_MB = (الصفحات_الحرة * حجم_الصفحة) / 1048576
    متغير ذاكرة_مشغولة_MB = (الصفحات_المشغولة * حجم_الصفحة) / 1048576
    
    serial_اطبع_رقم(ذاكرة_حرة_MB)
    اكتب_حرف_تسلسلي(COM1، 32)
    serial_اطبع_رقم(ذاكرة_مشغولة_MB)
    اكتب_حرف_تسلسلي(COM1، 10)
    
    # خريطة المناطق
    متغير م = 0
    بينما (م < عدد_المناطق)
        serial_اطبع_ست_عشري(مناطق_بداية[م])
        اكتب_حرف_تسلسلي(COM1، 32)
        serial_اطبع_رقم(مناطق_حجم[م] / 1048576)
        اكتب_حرف_تسلسلي(COM1، 32)
        serial_اطبع_رقم(مناطق_نوع[م])
        اكتب_حرف_تسلسلي(COM1، 10)
        م = م + 1
    نهاية
