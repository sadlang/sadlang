# ═══════════════════════════════════════════════════════════════════════════════
# وحدة النسخ عند الكتابة (Copy-on-Write) — نظام نحلة (BeeOS)
# الملف: نسخ_عند_كتابة_نحلة.ص
# الوظيفة: إدارة صفحات COW لتحسين أداء fork()
# الترتيب: __sad_init_88
# ═══════════════════════════════════════════════════════════════════════════════
#
# نظرية النسخ عند الكتابة (Copy-on-Write Theory):
# ═══════════════════════════════════════════════════
# عند استدعاء fork()، يُنشئ النظام عملية ابن نسخة من العملية الأب.
# النسخ الكامل لكل صفحات الذاكرة مكلف جداً (عملية fork تأخذ ملايين من
# الدورات إذا كانت العملية تملك مئات الصفحات).
#
# الحل: النسخ عند الكتابة (COW):
# 1. عند fork()، لا ننسخ الصفحات الفيزيائية فعلياً
# 2. بدلاً من ذلك:
#    - نجعل صفحات الأب والابن تشير لنفس الإطار الفيزيائي
#    - نُعلّم كلتا الصفحتين كـ "للقراءة فقط" + علم COW
#    - نزيد عداد المراجع للإطار الفيزيائي
# 3. عندما تحاول أي عملية (الأب أو الابن) الكتابة:
#    - يحدث خطأ صفحة (Page Fault) لأن الصفحة للقراءة فقط
#    - معالج الخطأ يكتشف علم COW
#    - يخصص إطاراً فيزيائياً جديداً
#    - ينسخ محتوى الإطار القديم إلى الجديد
#    - يُعيّن الصفحة للإطار الجديد مع صلاحية الكتابة
#    - يُنقص عداد المراجع للإطار القديم
#    - إذا وصل العداد لـ 1 (عملية واحدة فقط)، يُزيل علم COW من الصفحة المتبقية
#
# المزايا:
# - fork() فوري تقريباً بغض النظر عن حجم العملية
# - الصفحات التي لا تُكتب أبداً لا تُنسخ أبداً (توفير ذاكرة)
# - مثالي لنمط fork()+exec() الشائع
#
# بنية البيانات:
# ┌──────────────────────────────────────────────┐
# │ جدول عدادات المراجع (Reference Counts)        │
# │  - لكل إطار فيزيائي: عداد مراجع              │
# │  - العداد = 1: عملية واحدة تملك الإطار        │
# │  - العداد > 1: إطار مشترك (COW)               │
# │  - العداد = 0: إطار حر                        │
# ├──────────────────────────────────────────────┤
# │ جدول أعلام COW لكل صفحة                      │
# │  - مخزن في بت مخصص بمدخلة جدول الصفحات (PTE)  │
# │  - نستخدم بت AVL (بت 9) كعلم COW              │
# ├──────────────────────────────────────────────┤
# │ جدول تتبع العلاقة أب-ابن                     │
# │  - لكل عملية ابن: معرف الأب                  │
# │  - الصفحات المشتركة بينهما                    │
# └──────────────────────────────────────────────┘
#
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# التصريحات الخارجية (FFI)
# ═══════════════════════════════════════════════════════════════════════════════
خارجي دالة kernel_print_string(عنوان_سلسلة)
خارجي دالة kernel_print_number(قيمة)
خارجي دالة mem_read_dword(عنوان)
خارجي دالة mem_write_dword(عنوان، قيمة)
خارجي دالة sad_ll_memset(عنوان، قيمة، طول)
خارجي دالة sad_ll_memcpy(وجهة، مصدر، طول)
خارجي دالة sad_ll_page_alloc()
خارجي دالة sad_ll_page_free(عنوان)
خارجي دالة sad_ll_invlpg(عنوان)
خارجي دالة sad_ll_read_cr2()
خارجي دالة sad_ll_read_cr3()
خارجي دالة sad_ll_flush_tlb()

# ═══════════════════════════════════════════════════════════════════════════════
# الثوابت
# ═══════════════════════════════════════════════════════════════════════════════

# مقاس الصفحة
متغير ثابت_مقاس_صفحة = 4096

# ─── أعلام مدخلة جدول الصفحات (PTE) ───
متغير بت_حاضر = 1               # بت 0: الصفحة حاضرة في الذاكرة
متغير بت_كتابة = 2              # بت 1: قابلة للكتابة (R/W)
متغير بت_مستخدم = 4             # بت 2: وصول المستخدم
متغير بت_كتابة_مباشرة = 8       # بت 3: Write-Through
متغير بت_تعطيل_مخبأ = 16        # بت 4: Cache Disable
متغير بت_وصول = 32              # بت 5: Accessed
متغير بت_متسخة = 64             # بت 6: Dirty
متغير بت_cow = 512              # بت 9: علم COW (نستخدم بت AVL)
متغير بت_مشترك = 1024           # بت 10: صفحة مشتركة (بت AVL ثاني)

# قناع لاستخراج عنوان الإطار من PTE (محاذاة 4KB)
متغير قناع_إطار = 4294963200     # 0xFFFFF000 — أعلى 20 بت

# ─── ثوابت جدول عدادات المراجع ───
# أقصى عدد إطارات فيزيائية نتتبعها
# نفترض ذاكرة حتى 256MB → 65536 إطار
متغير ثابت_اقصى_إطارات = 65536
# أقصى عداد مراجع لإطار واحد
متغير ثابت_اقصى_مراجع = 255

# ─── ثوابت تتبع العلاقات أب-ابن ───
# أقصى عدد عمليات fork نشطة
متغير ثابت_اقصى_علاقات = 256
# حقول كل علاقة (4 لفظات):
# [0] معرف_أب، [1] معرف_ابن، [2] عدد_صفحات_مشتركة، [3] وضعية_نشطة
متغير ثابت_حقول_علاقة = 4

# ─── ثوابت صفحات COW المُعلّقة ───
# جدول لتتبع صفحات COW النشطة
# أقصى عدد صفحات COW في النظام
متغير ثابت_اقصى_صفحات_cow = 16384
# حقول كل مدخلة COW (4 لفظات):
# [0] عنوان_افتراضي، [1] عنوان_إطار، [2] معرف_عملية، [3] أعلام
متغير ثابت_حقول_cow = 4

# ─── ثوابت أحجام جدول الصفحات ───
# عدد المدخلات في جدول الصفحات المستوى الأول (Page Directory)
متغير ثابت_مدخلات_دليل = 1024
# عدد المدخلات في جدول الصفحات المستوى الثاني
متغير ثابت_مدخلات_جدول = 1024

# ═══════════════════════════════════════════════════════════════════════════════
# المتغيرات العامة — حالة نظام COW
# ═══════════════════════════════════════════════════════════════════════════════

# هل تم التهيئة
متغير تم_التهيئة = 0

# ─── جدول عدادات المراجع ───
# مصفوفة: لكل إطار فيزيائي → عداد مراجع (بايت واحد مُخزن في لفظة)
متغير عنوان_عدادات_مراجع = 0

# ─── جدول تتبع علاقات أب-ابن ───
متغير عنوان_علاقات_أب = 0        # معرف الأب
متغير عنوان_علاقات_ابن = 0       # معرف الابن
متغير عنوان_علاقات_صفحات = 0     # عدد الصفحات المشتركة
متغير عنوان_علاقات_نشاط = 0      # هل العلاقة نشطة
متغير عدد_علاقات_نشطة = 0

# ─── جدول صفحات COW النشطة ───
متغير عنوان_cow_افتراضي = 0      # العنوان الافتراضي
متغير عنوان_cow_إطار = 0         # عنوان الإطار الفيزيائي
متغير عنوان_cow_عملية = 0        # معرف العملية
متغير عنوان_cow_أعلام = 0        # أعلام إضافية
متغير عدد_صفحات_cow_نشطة = 0

# ═══════════════════════════════════════════════════════════════════════════════
# إحصائيات COW
# ═══════════════════════════════════════════════════════════════════════════════
متغير عداد_fork = 0                # عدد عمليات fork
متغير عداد_صفحات_cow_مسجلة = 0    # إجمالي الصفحات المُعلّمة COW
متغير عداد_أخطاء_cow = 0          # عدد أخطاء صفحات COW المعالجة
متغير عداد_نسخ_فعلي = 0           # عدد الصفحات المنسوخة فعلياً
متغير عداد_توفير_نسخ = 0          # عدد الصفحات التي لم تُنسخ (توفير)
متغير عداد_تحرير_إطار = 0         # عدد الإطارات المحررة (عداد → 0)
متغير عداد_إزالة_cow = 0          # عدد مرات إزالة علم COW (عداد → 1)
متغير عداد_فشل_تخصيص = 0         # عدد مرات فشل تخصيص إطار جديد
متغير إجمالي_صفحات_موفرة = 0     # إجمالي الصفحات الموفرة بـ COW

# ═══════════════════════════════════════════════════════════════════════════════
# دوال مساعدة — عدادات المراجع
# ═══════════════════════════════════════════════════════════════════════════════

# تحويل عنوان إطار فيزيائي إلى فهرس في جدول العدادات
# الإطار = العنوان / 4096
دالة إطار_إلى_فهرس(عنوان_إطار)
    ارجع عنوان_إطار / ثابت_مقاس_صفحة
نهاية

# قراءة عداد المراجع لإطار فيزيائي
دالة قراءة_عداد_مراجع(عنوان_إطار)
    متغير فهرس = إطار_إلى_فهرس(عنوان_إطار)
    إذا (فهرس >= ثابت_اقصى_إطارات)
        ارجع 0
    نهاية
    ارجع mem_read_dword(عنوان_عدادات_مراجع + (فهرس * 4))
نهاية

# كتابة عداد المراجع لإطار فيزيائي
دالة كتابة_عداد_مراجع(عنوان_إطار، قيمة)
    متغير فهرس = إطار_إلى_فهرس(عنوان_إطار)
    إذا (فهرس >= ثابت_اقصى_إطارات)
        ارجع 0
    نهاية
    mem_write_dword(عنوان_عدادات_مراجع + (فهرس * 4)، قيمة)
    ارجع 1
نهاية

# زيادة عداد المراجع لإطار فيزيائي
# تُرجع العداد الجديد
دالة زيادة_عداد_مراجع(عنوان_إطار)
    متغير عداد_حالي = قراءة_عداد_مراجع(عنوان_إطار)
    إذا (عداد_حالي >= ثابت_اقصى_مراجع)
        kernel_print_string("[COW] تحذير: عداد مراجع وصل للحد الأقصى!\n")
        ارجع عداد_حالي
    نهاية
    متغير عداد_جديد = عداد_حالي + 1
    كتابة_عداد_مراجع(عنوان_إطار، عداد_جديد)
    ارجع عداد_جديد
نهاية

# إنقاص عداد المراجع لإطار فيزيائي
# تُرجع العداد الجديد
# إذا وصل العداد لـ 0، يمكن تحرير الإطار
دالة إنقاص_عداد_مراجع(عنوان_إطار)
    متغير عداد_حالي = قراءة_عداد_مراجع(عنوان_إطار)
    إذا (عداد_حالي == 0)
        kernel_print_string("[COW] تحذير: محاولة إنقاص عداد صفري!\n")
        ارجع 0
    نهاية
    متغير عداد_جديد = عداد_حالي - 1
    كتابة_عداد_مراجع(عنوان_إطار، عداد_جديد)
    ارجع عداد_جديد
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# دوال مساعدة — مدخلات جدول الصفحات (PTE)
# ═══════════════════════════════════════════════════════════════════════════════

# قراءة حقل من مصفوفة بالفهرس
دالة قراءة_حقل(عنوان_مصفوفة، فهرس)
    ارجع mem_read_dword(عنوان_مصفوفة + (فهرس * 4))
نهاية

# كتابة حقل في مصفوفة بالفهرس
دالة كتابة_حقل(عنوان_مصفوفة، فهرس، قيمة)
    mem_write_dword(عنوان_مصفوفة + (فهرس * 4)، قيمة)
نهاية

# استخراج عنوان الإطار من PTE
دالة استخراج_إطار(قيمة_pte)
    ارجع قيمة_pte & قناع_إطار
نهاية

# فحص علم في PTE
دالة فحص_علم_pte(قيمة_pte، علم)
    متغير نتيجة = قيمة_pte & علم
    إذا (نتيجة != 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ضبط علم في PTE
دالة ضبط_علم_pte(قيمة_pte، علم)
    ارجع قيمة_pte | علم
نهاية

# مسح علم من PTE
دالة مسح_علم_pte(قيمة_pte، علم)
    متغير قناع_عكسي = ~علم
    ارجع قيمة_pte & قناع_عكسي
نهاية

# إنشاء PTE جديد
دالة إنشاء_pte(عنوان_إطار، أعلام)
    ارجع عنوان_إطار | أعلام
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# حساب عنوان PTE من عنوان افتراضي
# ═══════════════════════════════════════════════════════════════════════════════

# حساب فهرس دليل الصفحات (أعلى 10 بتات)
دالة فهرس_دليل(عنوان_افتراضي)
    ارجع عنوان_افتراضي >> 22
نهاية

# حساب فهرس جدول الصفحات (10 بتات وسطى)
دالة فهرس_جدول(عنوان_افتراضي)
    متغير مؤقت = عنوان_افتراضي >> 12
    ارجع مؤقت & 1023
نهاية

# الحصول على عنوان PTE لعنوان افتراضي
# عنوان_cr3: عنوان دليل الصفحات المادي
# تُرجع عنوان مدخلة PTE أو 0 عند الفشل
دالة عنوان_pte(عنوان_cr3، عنوان_افتراضي)
    # خطوة 1: قراءة مدخلة دليل الصفحات
    متغير ف_دليل = فهرس_دليل(عنوان_افتراضي)
    متغير عنوان_مدخلة_دليل = عنوان_cr3 + (ف_دليل * 4)
    متغير مدخلة_دليل = mem_read_dword(عنوان_مدخلة_دليل)

    # فحص: هل جدول الصفحات موجود؟
    متغير حاضر = مدخلة_دليل & بت_حاضر
    إذا (حاضر == 0)
        ارجع 0
    نهاية

    # خطوة 2: الحصول على عنوان جدول الصفحات المستوى الثاني
    متغير عنوان_جدول = استخراج_إطار(مدخلة_دليل)

    # خطوة 3: حساب عنوان PTE
    متغير ف_جدول = فهرس_جدول(عنوان_افتراضي)
    ارجع عنوان_جدول + (ف_جدول * 4)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تعليم صفحة كـ COW
# ═══════════════════════════════════════════════════════════════════════════════

# تعليم صفحة واحدة كـ COW (للقراءة فقط + علم COW)
# عنوان_cr3: دليل صفحات العملية
# عنوان_افتراضي: العنوان الافتراضي للصفحة
# تُرجع 0 عند النجاح أو -1 عند الفشل
دالة تعليم_صفحة_cow(عنوان_cr3، عنوان_افتراضي)
    # الحصول على عنوان PTE
    متغير موقع_pte = عنوان_pte(عنوان_cr3، عنوان_افتراضي)
    إذا (موقع_pte == 0)
        ارجع -1
    نهاية

    # قراءة PTE الحالي
    متغير pte_حالي = mem_read_dword(موقع_pte)

    # فحص: هل الصفحة حاضرة؟
    متغير حاضرة = فحص_علم_pte(pte_حالي، بت_حاضر)
    إذا (حاضرة == 0)
        ارجع -1
    نهاية

    # إزالة صلاحية الكتابة
    متغير pte_جديد = مسح_علم_pte(pte_حالي، بت_كتابة)
    # إضافة علم COW
    pte_جديد = ضبط_علم_pte(pte_جديد، بت_cow)

    # كتابة PTE المعدل
    mem_write_dword(موقع_pte، pte_جديد)

    # إبطال TLB لهذا العنوان
    sad_ll_invlpg(عنوان_افتراضي)

    # زيادة عداد المراجع للإطار الفيزيائي
    متغير إطار = استخراج_إطار(pte_حالي)
    زيادة_عداد_مراجع(إطار)

    عداد_صفحات_cow_مسجلة = عداد_صفحات_cow_مسجلة + 1

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تسجيل صفحة COW في جدول التتبع
# ═══════════════════════════════════════════════════════════════════════════════

# تسجيل صفحة COW مع معرف العملية
# تُرجع فهرس المدخلة أو -1 عند الفشل
دالة تسجيل_صفحة_cow(عنوان_اف، عنوان_إطار، معرف_عملية)
    إذا (عدد_صفحات_cow_نشطة >= ثابت_اقصى_صفحات_cow)
        kernel_print_string("[COW] جدول COW ممتلئ!\n")
        ارجع -1
    نهاية

    # البحث عن فتحة فارغة
    متغير م = 0
    بينما (م < ثابت_اقصى_صفحات_cow)
        متغير أعلام_حالية = قراءة_حقل(عنوان_cow_أعلام، م)
        إذا (أعلام_حالية == 0)
            # فتحة فارغة — نستخدمها
            كتابة_حقل(عنوان_cow_افتراضي، م، عنوان_اف)
            كتابة_حقل(عنوان_cow_إطار، م، عنوان_إطار)
            كتابة_حقل(عنوان_cow_عملية، م، معرف_عملية)
            كتابة_حقل(عنوان_cow_أعلام، م، 1)
            عدد_صفحات_cow_نشطة = عدد_صفحات_cow_نشطة + 1
            ارجع م
        نهاية
        م = م + 1
    نهاية

    ارجع -1
نهاية

# إلغاء تسجيل صفحة COW
دالة إلغاء_تسجيل_cow(عنوان_اف، معرف_عملية)
    متغير م = 0
    بينما (م < ثابت_اقصى_صفحات_cow)
        متغير أعلام_حالية = قراءة_حقل(عنوان_cow_أعلام، م)
        إذا (أعلام_حالية == 1)
            متغير عنوان_مسجل = قراءة_حقل(عنوان_cow_افتراضي، م)
            متغير عملية_مسجلة = قراءة_حقل(عنوان_cow_عملية، م)
            إذا (عنوان_مسجل == عنوان_اف)
                إذا (عملية_مسجلة == معرف_عملية)
                    كتابة_حقل(عنوان_cow_أعلام، م، 0)
                    كتابة_حقل(عنوان_cow_افتراضي، م، 0)
                    كتابة_حقل(عنوان_cow_إطار، م، 0)
                    كتابة_حقل(عنوان_cow_عملية، م، 0)
                    عدد_صفحات_cow_نشطة = عدد_صفحات_cow_نشطة - 1
                    ارجع 0
                نهاية
            نهاية
        نهاية
        م = م + 1
    نهاية
    ارجع -1
