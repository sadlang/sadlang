# البحث عن العمليات الابناء لعملية أب
# عنوان_مخرجات: مصفوفة لتخزين معرفات الأبناء
# تُرجع عدد الأبناء
دالة أبناء_عملية(معرف_أب، عنوان_مخرجات)
    متغير عداد = 0
    متغير م = 0
    بينما (م < ثابت_اقصى_علاقات)
        متغير نشطة = قراءة_حقل(عنوان_علاقات_نشاط، م)
        إذا (نشطة == 1)
            متغير أب = قراءة_حقل(عنوان_علاقات_أب، م)
            إذا (أب == معرف_أب)
                متغير ابن = قراءة_حقل(عنوان_علاقات_ابن، م)
                mem_write_dword(عنوان_مخرجات + (عداد * 4)، ابن)
                عداد = عداد + 1
            نهاية
        نهاية
        م = م + 1
    نهاية
    ارجع عداد
نهاية

# البحث عن الأب لعملية ابن
دالة أب_عملية(معرف_ابن)
    متغير م = 0
    بينما (م < ثابت_اقصى_علاقات)
        متغير نشطة = قراءة_حقل(عنوان_علاقات_نشاط، م)
        إذا (نشطة == 1)
            متغير ابن = قراءة_حقل(عنوان_علاقات_ابن، م)
            إذا (ابن == معرف_ابن)
                ارجع قراءة_حقل(عنوان_علاقات_أب، م)
            نهاية
        نهاية
        م = م + 1
    نهاية
    ارجع -1
نهاية

