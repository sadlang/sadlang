# ═══════════════════════════════════════════════════════════════════════════════
# تعليم صفحات بالجملة لـ fork()
# ═══════════════════════════════════════════════════════════════════════════════

# تعليم جميع صفحات عملية كـ COW عند fork()
# عنوان_cr3_أب: دليل صفحات الأب
# عنوان_cr3_ابن: دليل صفحات الابن (منسوخ من الأب)
# معرف_أب، معرف_ابن: معرفات العمليات
# تُرجع عدد الصفحات المُعلّمة
دالة تعليم_fork_cow(عنوان_cr3_أب، عنوان_cr3_ابن، معرف_أب، معرف_ابن)
    kernel_print_string("[COW] بدء تعليم COW لعملية fork()\n")
    kernel_print_string("  الأب: ")
    kernel_print_number(معرف_أب)
    kernel_print_string(" → الابن: ")
    kernel_print_number(معرف_ابن)
    kernel_print_string("\n")

    عداد_fork = عداد_fork + 1
    متغير صفحات_معلمة = 0

    # المرور على كل مدخلات دليل الصفحات
    متغير ف_د = 0
    بينما (ف_د < ثابت_مدخلات_دليل)
        # قراءة مدخلة الدليل في الأب
        متغير مدخلة_أب = mem_read_dword(عنوان_cr3_أب + (ف_د * 4))
        متغير حاضر_د = مدخلة_أب & بت_حاضر
        إذا (حاضر_د != 0)
            # المدخلة حاضرة — نتفحص جدول الصفحات
            متغير عنوان_جدول = استخراج_إطار(مدخلة_أب)

            # نسخ مدخلة الدليل للابن (نفس جدول الصفحات مبدئياً)
            mem_write_dword(عنوان_cr3_ابن + (ف_د * 4)، مدخلة_أب)

            # المرور على كل مدخلات جدول الصفحات
            متغير ف_ج = 0
            بينما (ف_ج < ثابت_مدخلات_جدول)
                متغير pte_أب = mem_read_dword(عنوان_جدول + (ف_ج * 4))
                متغير حاضر_ص = pte_أب & بت_حاضر
                إذا (حاضر_ص != 0)
                    # صفحة حاضرة — نعلمها COW
                    # فحص: هل هي قابلة للكتابة؟ (فقط الصفحات القابلة للكتابة تحتاج COW)
                    متغير قابلة_كتابة = pte_أب & بت_كتابة
                    إذا (قابلة_كتابة != 0)
                        # إزالة صلاحية الكتابة + إضافة علم COW
                        متغير pte_cow = مسح_علم_pte(pte_أب، بت_كتابة)
                        pte_cow = ضبط_علم_pte(pte_cow، بت_cow)

                        # تحديث PTE في جدول الأب
                        mem_write_dword(عنوان_جدول + (ف_ج * 4)، pte_cow)

                        # نفس PTE في جدول الابن
                        # (الابن يشير لنفس جدول الصفحات حالياً)

                        # زيادة عداد المراجع للإطار
                        متغير إطار = استخراج_إطار(pte_أب)
                        زيادة_عداد_مراجع(إطار)

                        # حساب العنوان الافتراضي
                        متغير عنوان_اف = (ف_د << 22) | (ف_ج << 12)

                        # تسجيل في جدول COW — للأب
                        تسجيل_صفحة_cow(عنوان_اف، إطار، معرف_أب)
                        # تسجيل في جدول COW — للابن
                        تسجيل_صفحة_cow(عنوان_اف، إطار، معرف_ابن)

                        صفحات_معلمة = صفحات_معلمة + 1
                    نهاية
                نهاية
                ف_ج = ف_ج + 1
            نهاية
        نهاية
        ف_د = ف_د + 1
    نهاية

    # تسجيل العلاقة أب-ابن
    تسجيل_علاقة_fork(معرف_أب، معرف_ابن، صفحات_معلمة)

    # إبطال TLB بالكامل
    sad_ll_flush_tlb()

    # تحديث الإحصائيات
    إجمالي_صفحات_موفرة = إجمالي_صفحات_موفرة + صفحات_معلمة

    kernel_print_string("[COW] تم تعليم ")
    kernel_print_number(صفحات_معلمة)
    kernel_print_string(" صفحة كـ COW\n")
    kernel_print_string("[COW] توفير ذاكرة: ")
    kernel_print_number(صفحات_معلمة * ثابت_مقاس_صفحة)
    kernel_print_string(" بايت\n")

    ارجع صفحات_معلمة
نهاية

