# فحص هل صفحة معينة مُعلّمة كـ COW
# تُرجع 1 إذا كانت COW، 0 خلاف ذلك
دالة هل_صفحة_cow(عنوان_cr3، عنوان_افتراضي)
    متغير موقع = عنوان_pte(عنوان_cr3، عنوان_افتراضي)
    إذا (موقع == 0)
        ارجع 0
    نهاية
    متغير pte = mem_read_dword(موقع)
    ارجع فحص_علم_pte(pte، بت_cow)
