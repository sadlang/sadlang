# تسجيل علاقة fork
# ═══════════════════════════════════════════════════════════════════════════════

دالة تسجيل_علاقة_fork(معرف_أب، معرف_ابن، عدد_صفحات)
    إذا (عدد_علاقات_نشطة >= ثابت_اقصى_علاقات)
        kernel_print_string("[COW] جدول العلاقات ممتلئ!\n")
        ارجع -1
    نهاية

    متغير م = 0
    بينما (م < ثابت_اقصى_علاقات)
        متغير نشطة = قراءة_حقل(عنوان_علاقات_نشاط، م)
        إذا (نشطة == 0)
            كتابة_حقل(عنوان_علاقات_أب، م، معرف_أب)
            كتابة_حقل(عنوان_علاقات_ابن، م، معرف_ابن)
            كتابة_حقل(عنوان_علاقات_صفحات، م، عدد_صفحات)
            كتابة_حقل(عنوان_علاقات_نشاط، م، 1)
            عدد_علاقات_نشطة = عدد_علاقات_نشطة + 1
            ارجع 0
        نهاية
        م = م + 1
    نهاية
    ارجع -1
