# ═══════════════════════════════════════════════════════════════════════════════
# معالجة خطأ صفحة COW
# ═══════════════════════════════════════════════════════════════════════════════

# معالج خطأ صفحة COW — يُستدعى من معالج الاستثناءات
# عنوان_cr3: دليل صفحات العملية الحالية
# عنوان_خطأ: العنوان الذي سبب الخطأ (من CR2)
# معرف_عملية: معرف العملية الحالية
# تُرجع:  0 = تم حل خطأ COW بنجاح
#         -1 = ليس خطأ COW (خطأ صفحة حقيقي)
#         -2 = فشل في تخصيص إطار جديد
دالة معالجة_خطأ_cow(عنوان_cr3، عنوان_خطأ، معرف_عملية)
    # محاذاة العنوان لحدود الصفحة
    متغير عنوان_صفحة = عنوان_خطأ & قناع_إطار

    # الحصول على PTE
    متغير موقع_pte = عنوان_pte(عنوان_cr3، عنوان_صفحة)
    إذا (موقع_pte == 0)
        # لا يوجد جدول صفحات — خطأ صفحة حقيقي
        ارجع -1
    نهاية

    # قراءة PTE
    متغير pte_حالي = mem_read_dword(موقع_pte)

    # فحص: هل الصفحة حاضرة؟
    متغير حاضرة = فحص_علم_pte(pte_حالي، بت_حاضر)
    إذا (حاضرة == 0)
        # صفحة غير حاضرة — ليس خطأ COW
        ارجع -1
    نهاية

    # فحص: هل عليها علم COW؟
    متغير هل_cow = فحص_علم_pte(pte_حالي، بت_cow)
    إذا (هل_cow == 0)
        # ليست صفحة COW — خطأ صفحة حقيقي (ربما انتهاك حماية)
        ارجع -1
    نهاية

    # === هذا خطأ COW — نبدأ الحل ===
    عداد_أخطاء_cow = عداد_أخطاء_cow + 1

    # الحصول على عنوان الإطار القديم
    متغير إطار_قديم = استخراج_إطار(pte_حالي)

    # قراءة عداد المراجع للإطار القديم
    متغير عداد = قراءة_عداد_مراجع(إطار_قديم)

    إذا (عداد <= 1)
        # العملية الوحيدة — لا حاجة للنسخ
        # فقط نُعيد صلاحية الكتابة ونُزيل علم COW
        متغير pte_جديد = ضبط_علم_pte(pte_حالي، بت_كتابة)
        pte_جديد = مسح_علم_pte(pte_جديد، بت_cow)
        mem_write_dword(موقع_pte، pte_جديد)

        عداد_إزالة_cow = عداد_إزالة_cow + 1
        عداد_توفير_نسخ = عداد_توفير_نسخ + 1

        # إلغاء التسجيل
        إلغاء_تسجيل_cow(عنوان_صفحة، معرف_عملية)

        # إبطال TLB
        sad_ll_invlpg(عنوان_صفحة)

        ارجع 0
    نهاية

    # عداد > 1 — يجب النسخ الفعلي
    # 1. تخصيص إطار فيزيائي جديد
    متغير إطار_جديد = sad_ll_page_alloc()
    إذا (إطار_جديد == 0)
        kernel_print_string("[COW] فشل تخصيص إطار جديد لعنوان: ")
        kernel_print_number(عنوان_خطأ)
        kernel_print_string("\n")
        عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
        ارجع -2
    نهاية

    # 2. نسخ محتوى الإطار القديم إلى الجديد
    sad_ll_memcpy(إطار_جديد، إطار_قديم، ثابت_مقاس_صفحة)
    عداد_نسخ_فعلي = عداد_نسخ_فعلي + 1

    # 3. تحديث PTE: إطار جديد + كتابة + بدون COW
    متغير أعلام_جديدة = بت_حاضر | بت_كتابة | بت_مستخدم
    متغير pte_جديد2 = إنشاء_pte(إطار_جديد، أعلام_جديدة)
    mem_write_dword(موقع_pte، pte_جديد2)

    # 4. إنقاص عداد المراجع للإطار القديم
    متغير عداد_بعد = إنقاص_عداد_مراجع(إطار_قديم)

    # 5. إذا وصل العداد لـ 1، نُزيل COW من الصفحة المتبقية
    إذا (عداد_بعد == 1)
        # البحث عن العملية الأخرى التي تملك هذا الإطار وإزالة COW منها
        إزالة_cow_لإطار(إطار_قديم)
    نهاية

    # 6. إذا وصل العداد لـ 0، نحرر الإطار القديم
    إذا (عداد_بعد == 0)
        sad_ll_page_free(إطار_قديم)
        عداد_تحرير_إطار = عداد_تحرير_إطار + 1
    نهاية

    # 7. إلغاء التسجيل
    إلغاء_تسجيل_cow(عنوان_صفحة، معرف_عملية)

    # 8. إبطال TLB
    sad_ll_invlpg(عنوان_صفحة)

    # 9. ضبط عداد المراجع للإطار الجديد (عملية واحدة)
    كتابة_عداد_مراجع(إطار_جديد، 1)

    ارجع 0
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إزالة COW من صفحات تشير لإطار محدد
# ═══════════════════════════════════════════════════════════════════════════════

# عندما ينخفض عداد المراجع لـ 1، العملية المتبقية لا تحتاج COW
# نبحث في جدول COW عن الصفحة ونُحدّث PTE لإتاحة الكتابة
