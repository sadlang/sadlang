        إذا (أعلام == 1)
            متغير إطار_مسجل = قراءة_حقل(عنوان_cow_إطار، م)
            إذا (إطار_مسجل == عنوان_إطار)
                # وجدنا — نزيل علم COW ونعيد الكتابة
                # (هذا يتطلب معرفة CR3 العملية — مُبسط هنا)
                kernel_print_string("[COW] إزالة COW لإطار منفرد: ")
                kernel_print_number(عنوان_إطار)
                kernel_print_string("\n")

                # تنظيف المدخلة
                كتابة_حقل(عنوان_cow_أعلام، م، 0)
                عدد_صفحات_cow_نشطة = عدد_صفحات_cow_نشطة - 1
                عداد_إزالة_cow = عداد_إزالة_cow + 1

                ارجع 0
            نهاية
        نهاية
        م = م + 1
    نهاية
    ارجع -1
