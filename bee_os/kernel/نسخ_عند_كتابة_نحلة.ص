# ═══════════════════════════════════════════════════════════════════════════════
# تنظيف COW عند خروج عملية
# ═══════════════════════════════════════════════════════════════════════════════

# تنظيف جميع صفحات COW المرتبطة بعملية عند خروجها
# إنقاص عدادات المراجع وتحرير الإطارات إذا لزم
# تُرجع عدد الصفحات المنظفة
دالة تنظيف_cow_عملية(معرف_عملية)
    kernel_print_string("[COW] تنظيف COW لعملية: ")
    kernel_print_number(معرف_عملية)
    kernel_print_string("\n")

    متغير منظفة = 0
    متغير م = 0
    بينما (م < ثابت_اقصى_صفحات_cow)
        متغير أعلام = قراءة_حقل(عنوان_cow_أعلام، م)
        إذا (أعلام == 1)
            متغير عملية = قراءة_حقل(عنوان_cow_عملية، م)
            إذا (عملية == معرف_عملية)
                # إنقاص عداد المراجع
                متغير إطار = قراءة_حقل(عنوان_cow_إطار، م)
                متغير عداد_بعد = إنقاص_عداد_مراجع(إطار)

                إذا (عداد_بعد == 0)
                    # تحرير الإطار
                    sad_ll_page_free(إطار)
                    عداد_تحرير_إطار = عداد_تحرير_إطار + 1
                نهاية

                إذا (عداد_بعد == 1)
                    # إزالة COW من الصفحة المتبقية
                    إزالة_cow_لإطار(إطار)
                نهاية

                # تنظيف المدخلة
                كتابة_حقل(عنوان_cow_أعلام، م، 0)
                كتابة_حقل(عنوان_cow_افتراضي، م، 0)
                كتابة_حقل(عنوان_cow_إطار، م، 0)
                كتابة_حقل(عنوان_cow_عملية، م، 0)
                عدد_صفحات_cow_نشطة = عدد_صفحات_cow_نشطة - 1
                منظفة = منظفة + 1
            نهاية
        نهاية
        م = م + 1
    نهاية

    # تنظيف علاقة الأب-الابن
    متغير ع = 0
    بينما (ع < ثابت_اقصى_علاقات)
        متغير نشطة = قراءة_حقل(عنوان_علاقات_نشاط، ع)
        إذا (نشطة == 1)
            متغير أب = قراءة_حقل(عنوان_علاقات_أب، ع)
            متغير ابن = قراءة_حقل(عنوان_علاقات_ابن، ع)
            إذا (أب == معرف_عملية)
                كتابة_حقل(عنوان_علاقات_نشاط، ع، 0)
                عدد_علاقات_نشطة = عدد_علاقات_نشطة - 1
            نهاية
            إذا (ابن == معرف_عملية)
                كتابة_حقل(عنوان_علاقات_نشاط، ع، 0)
                عدد_علاقات_نشطة = عدد_علاقات_نشطة - 1
            نهاية
        نهاية
        ع = ع + 1
    نهاية

    kernel_print_string("[COW] تم تنظيف ")
    kernel_print_number(منظفة)
    kernel_print_string(" صفحة COW\n")

    ارجع منظفة
