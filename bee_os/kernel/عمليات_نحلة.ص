## ═══════════════════════════════════════════════════════════════

دالة جد_خانة_فارغة()
    متغير ف = 0
    بينما (ف < MAX_PROCS)
        إذا (p_حالة[ف] == PROC_FREE)
            ارجع ف
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

## البحث عن عملية بـ PID
دالة جد_بـ_pid(المعرف)
    متغير ف = 0
    بينما (ف < MAX_PROCS)
        إذا (p_حالة[ف] != PROC_FREE)
            إذا (p_pid[ف] == المعرف)
                ارجع ف
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٥: إنشاء عملية جديدة (spawn)
## ═══════════════════════════════════════════════════════════════

## إنشاء عملية جديدة
## نقطة_الدخول: عنوان دالة بدء العملية
## أولوية: مستوى MLFQ الابتدائي (0-7)
## نوع_العملية: PROC_TYPE_KERNEL / PROC_TYPE_USER
## يُعيد PID أو -1 عند الفشل
صدّر دالة أنشئ_عملية(نقطة_الدخول، أولوية، نوع_العملية)
    proc_عطل_المقاطعات()
    
    متغير خانة = جد_خانة_فارغة()
    إذا (خانة < 0)
        proc_فعل_المقاطعات()
        ارجع -1  # لا توجد خانة فارغة
    نهاية
    
    # تخصيص مكدس (4 صفحات = 16 KB)
    متغير عنوان_المكدس = proc_خصص_صفحات(STACK_PAGES)
    إذا (عنوان_المكدس == 0)
        proc_فعل_المقاطعات()
        ارجع -2  # فشل تخصيص الذاكرة
    نهاية
    
    # تهيئة المكدس
    proc_املأ_ذاكرة(عنوان_المكدس، 0، STACK_SIZE)
    
    # قمة المكدس
    متغير قمة_المكدس = عنوان_المكدس + STACK_SIZE - 4
    
    # تهيئة إطار المكدس مع نقطة الدخول
    متغير esp_ابتدائي = proc_هيئ_مكدس(قمة_المكدس، نقطة_الدخول)
    
    # تعبئة جدول العمليات
    متغير pid_جديد = next_pid + 0
    next_pid = next_pid + 1
    
    p_pid[خانة] = pid_جديد
    p_حالة[خانة] = PROC_READY
    p_نوع[خانة] = نوع_العملية
    p_مستوى[خانة] = أولوية
    p_شريحة[خانة] = mlfq_quantum[أولوية]
    p_مكدس[خانة] = عنوان_المكدس
    p_سياق[خانة] = esp_ابتدائي
    p_دخول[خانة] = نقطة_الدخول
    p_cpu_time[خانة] = 0
    p_خروج[خانة] = 0
    p_سبب_انتظار[خانة] = WAIT_NONE
    p_إشارة[خانة] = SIG_NONE
    p_وقت_إنشاء[خانة] = proc_اقرأ_النبضات()
    
    # الأب هو العملية الحالية
    إذا (current_proc >= 0)
        p_ppid[خانة] = p_pid[current_proc]
        p_pgid[خانة] = p_pgid[current_proc]
    وإلا
        p_ppid[خانة] = 0
        p_pgid[خانة] = pid_جديد
    نهاية
    
    proc_count = proc_count + 1
    
    proc_فعل_المقاطعات()
    
    ارجع pid_جديد
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٦: fork — نسخ العملية الحالية
## ═══════════════════════════════════════════════════════════════

## fork ينسخ العملية الحالية:
##   • في الأب: يُعيد PID الابن
##   • في الابن: يُعيد 0
## ملاحظة: في نظامنا المبسط، fork ينشئ عملية جديدة
## تبدأ من نفس نقطة الدخول (لا نسخ ذاكرة كامل)

صدّر دالة proc_fork()
    إذا (current_proc < 0)
        ارجع -1
    نهاية
    
    proc_عطل_المقاطعات()
    
    متغير خانة = جد_خانة_فارغة()
    إذا (خانة < 0)
        proc_فعل_المقاطعات()
        ارجع -1
    نهاية
    
    # تخصيص مكدس للابن
    متغير عنوان_المكدس = proc_خصص_صفحات(STACK_PAGES)
    إذا (عنوان_المكدس == 0)
        proc_فعل_المقاطعات()
        ارجع -2
    نهاية
    
    # نسخ مكدس الأب
    proc_انسخ_ذاكرة(عنوان_المكدس، p_مكدس[current_proc]، STACK_SIZE)
    
    # PID جديد
    متغير pid_ابن = next_pid + 0
    next_pid = next_pid + 1
    
    # قمة المكدس للابن
    متغير قمة_المكدس = عنوان_المكدس + STACK_SIZE - 4
    
    # حساب ESP للابن (ترحيل نسبي من مكدس الأب)
    متغير مكدس_أب = p_مكدس[current_proc]
    متغير سياق_أب = p_سياق[current_proc]
    متغير إزاحة = سياق_أب - مكدس_أب
    متغير سياق_ابن = عنوان_المكدس + إزاحة
    
    # تعبئة خانة الابن
    p_pid[خانة] = pid_ابن
    p_حالة[خانة] = PROC_READY
    p_ppid[خانة] = p_pid[current_proc]
    p_نوع[خانة] = p_نوع[current_proc]
    p_مستوى[خانة] = p_مستوى[current_proc]
    p_شريحة[خانة] = mlfq_quantum[p_مستوى[current_proc]]
    p_مكدس[خانة] = عنوان_المكدس
    p_سياق[خانة] = سياق_ابن
    p_دخول[خانة] = p_دخول[current_proc]
    p_cpu_time[خانة] = 0
    p_خروج[خانة] = 0
    p_pgid[خانة] = p_pgid[current_proc]
    p_إشارة[خانة] = SIG_NONE
    p_سبب_انتظار[خانة] = WAIT_NONE
    p_وقت_إنشاء[خانة] = proc_اقرأ_النبضات()
    
    proc_count = proc_count + 1
    
    proc_فعل_المقاطعات()
    
    # الأب يحصل على PID الابن
    ارجع pid_ابن
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٧: exec — تبديل نقطة الدخول
## ═══════════════════════════════════════════════════════════════

## exec يستبدل محتوى العملية الحالية بعملية جديدة
## نقطة_دخول_جديدة: عنوان الدالة الجديدة

صدّر دالة proc_exec(نقطة_دخول_جديدة)
    إذا (current_proc < 0)
        ارجع -1
    نهاية
    
    proc_عطل_المقاطعات()
    
    # إعادة تهيئة المكدس
    متغير عنوان_المكدس = p_مكدس[current_proc]
    proc_املأ_ذاكرة(عنوان_المكدس، 0، STACK_SIZE)
    
    متغير قمة_المكدس = عنوان_المكدس + STACK_SIZE - 4
    متغير esp_جديد = proc_هيئ_مكدس(قمة_المكدس، نقطة_دخول_جديدة)
    
    p_سياق[current_proc] = esp_جديد
    p_دخول[current_proc] = نقطة_دخول_جديدة
    p_مستوى[current_proc] = 3  # إعادة للمستوى العادي
    p_شريحة[current_proc] = mlfq_quantum[3]
    p_cpu_time[current_proc] = 0
    
    proc_فعل_المقاطعات()
    ارجع 0
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٨: exit — إنهاء العملية
## ═══════════════════════════════════════════════════════════════

## إنهاء العملية الحالية
## كود_الخروج: 0 = نجاح، سالب = خطأ

صدّر دالة proc_exit(كود_الخروج)
    إذا (current_proc < 0)
        ارجع
    نهاية
    
    proc_عطل_المقاطعات()
    
    متغير pid_حالي = p_pid[current_proc]
    
    # تعيين حالة zombie
    p_حالة[current_proc] = PROC_ZOMBIE
    p_خروج[current_proc] = كود_الخروج
    
    # إرسال SIGCHLD للأب
    متغير فهرس_أب = جد_بـ_pid(p_ppid[current_proc])
    إذا (فهرس_أب >= 0)
        p_إشارة[فهرس_أب] = SIG_CHLD
        # إيقاظ الأب إذا كان ينتظر ابنه
        إذا (p_حالة[فهرس_أب] == PROC_SLEEPING)
            إذا (p_سبب_انتظار[فهرس_أب] == WAIT_CHILD)
                p_حالة[فهرس_أب] = PROC_READY
                p_سبب_انتظار[فهرس_أب] = WAIT_NONE
            نهاية
        نهاية
    نهاية
    
    # إعادة تبني الأبناء اليتامى (عملية init = PID 1)
    متغير ف = 0
    بينما (ف < MAX_PROCS)
        إذا (p_حالة[ف] != PROC_FREE)
            إذا (p_ppid[ف] == pid_حالي)
                p_ppid[ف] = 1   # تبنّي بواسطة init
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    
    proc_count = proc_count - 1
    
    proc_فعل_المقاطعات()
    
    # تبديل لعملية أخرى (لن نعود)
    proc_جدول()
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ٩: wait / waitpid — انتظار انتهاء ابن
## ═══════════════════════════════════════════════════════════════

## انتظار أي ابن zombie
## يُعيد PID الابن المنتهي، ويخزن حالة الخروج في work_buf
## يُعيد -1 إذا لا يوجد أبناء

صدّر دالة proc_wait()
    إذا (current_proc < 0)
        ارجع -1
    نهاية
    
    متغير pid_أب = p_pid[current_proc]
    
    # بحث عن ابن zombie
    متغير ف = 0
    بينما (ف < MAX_PROCS)
        إذا (p_حالة[ف] == PROC_ZOMBIE)
            إذا (p_ppid[ف] == pid_أب)
                # وجدنا ابن zombie
                متغير pid_ابن = p_pid[ف]
                
                # تحرير موارد الابن
                إذا (p_مكدس[ف] != 0)
                    proc_حرر_صفحات(p_مكدس[ف]، STACK_PAGES)
                نهاية
                
                # مسح الخانة
                p_حالة[ف] = PROC_FREE
                p_pid[ف] = 0
                p_ppid[ف] = 0
                p_مكدس[ف] = 0
                p_سياق[ف] = 0
                
                ارجع pid_ابن
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    
    # لا يوجد ابن zombie — فحص إذا يوجد أبناء أصلاً
    متغير يوجد_أبناء = 0
    ف = 0
    بينما (ف < MAX_PROCS)
        إذا (p_حالة[ف] != PROC_FREE)
            إذا (p_ppid[ف] == pid_أب)
                يوجد_أبناء = 1
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    
    إذا (يوجد_أبناء == 0)
        ارجع -1  # لا يوجد أبناء
    نهاية
    
    # نم حتى ينتهي ابن
    p_حالة[current_proc] = PROC_SLEEPING
    p_سبب_انتظار[current_proc] = WAIT_CHILD
    proc_جدول()
    
    # بعد الاستيقاظ، حاول مرة أخرى
    ارجع proc_wait()
نهاية

## waitpid — انتظار ابن محدد
صدّر دالة proc_waitpid(pid_المطلوب)
    إذا (current_proc < 0)
        ارجع -1
    نهاية
    
    متغير فهرس = جد_بـ_pid(pid_المطلوب)
    إذا (فهرس < 0)
        ارجع -1  # العملية غير موجودة
    نهاية
    
    # هل هو ابني؟
    إذا (p_ppid[فهرس] != p_pid[current_proc])
        ارجع -2  # ليس ابني
    نهاية
    
    # هل هو zombie بالفعل؟
    إذا (p_حالة[فهرس] == PROC_ZOMBIE)
        متغير كود = p_خروج[فهرس]
        # تحرير الموارد
        إذا (p_مكدس[فهرس] != 0)
            proc_حرر_صفحات(p_مكدس[فهرس]، STACK_PAGES)
        نهاية
        p_حالة[فهرس] = PROC_FREE
        p_pid[فهرس] = 0
        ارجع كود
    نهاية
    
    # انتظار
    p_حالة[current_proc] = PROC_SLEEPING
    p_سبب_انتظار[current_proc] = WAIT_CHILD
    proc_جدول()
    
    ارجع proc_waitpid(pid_المطلوب)
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ١٠: الإشارات (Signals)
## ═══════════════════════════════════════════════════════════════

## إرسال إشارة لعملية
صدّر دالة proc_kill(pid_الهدف، رقم_الإشارة)
    متغير فهرس = جد_بـ_pid(pid_الهدف)
    إذا (فهرس < 0)
        ارجع -1
    نهاية
    
    # SIGKILL لا يمكن تجاهله
    إذا (رقم_الإشارة == SIG_KILL)
        # إنهاء فوري
        p_حالة[فهرس] = PROC_ZOMBIE
        p_خروج[فهرس] = -9
        
        # إيقاظ الأب
        متغير فهرس_أب = جد_بـ_pid(p_ppid[فهرس])
        إذا (فهرس_أب >= 0)
            إذا (p_حالة[فهرس_أب] == PROC_SLEEPING)
                إذا (p_سبب_انتظار[فهرس_أب] == WAIT_CHILD)
                    p_حالة[فهرس_أب] = PROC_READY
                    p_سبب_انتظار[فهرس_أب] = WAIT_NONE
                نهاية
            نهاية
        نهاية
        
        ارجع 0
    نهاية
    
    # SIGSTOP — إيقاف مؤقت
    إذا (رقم_الإشارة == SIG_STOP)
        إذا (p_حالة[فهرس] == PROC_RUNNING)
            p_حالة[فهرس] = PROC_STOPPED
        نهاية
        إذا (p_حالة[فهرس] == PROC_READY)
            p_حالة[فهرس] = PROC_STOPPED
        نهاية
        ارجع 0
    نهاية
    
    # SIGCONT — استئناف
    إذا (رقم_الإشارة == SIG_CONT)
        إذا (p_حالة[فهرس] == PROC_STOPPED)
            p_حالة[فهرس] = PROC_READY
        نهاية
        ارجع 0
    نهاية
    
    # SIGTERM وغيرها — تخزين الإشارة
    p_إشارة[فهرس] = رقم_الإشارة
    
    # إيقاظ إذا كانت نائمة
    إذا (p_حالة[فهرس] == PROC_SLEEPING)
        p_حالة[فهرس] = PROC_READY
        p_سبب_انتظار[فهرس] = WAIT_NONE
    نهاية
    
    ارجع 0
نهاية

## إرسال إشارة لمجموعة عمليات
صدّر دالة proc_killpg(pgid_الهدف، رقم_الإشارة)
    متغير عدد = 0
    متغير ف = 0
    بينما (ف < MAX_PROCS)
        إذا (p_حالة[ف] != PROC_FREE)
            إذا (p_pgid[ف] == pgid_الهدف)
                proc_kill(p_pid[ف]، رقم_الإشارة)
                عدد = عدد + 1
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    ارجع عدد
نهاية

## معالجة الإشارات المعلقة للعملية الحالية
دالة عالج_الإشارات()
    إذا (current_proc < 0)
        ارجع
    نهاية
    
    متغير إشارة = p_إشارة[current_proc]
    إذا (إشارة == SIG_NONE)
        ارجع
    نهاية
    
    # مسح الإشارة
    p_إشارة[current_proc] = SIG_NONE
    
    # SIGTERM — إنهاء بلطف
    إذا (إشارة == SIG_TERM)
        proc_exit(-15)
        ارجع
    نهاية
    
    # SIGKILL — لا يصل هنا (يُعالج في proc_kill)
    
    # SIGCHLD — لا شيء (مجرد إيقاظ)
    # SIGUSR1/2, SIGALARM — يمكن إضافة معالجات مستقبلاً
نهاية

## ═══════════════════════════════════════════════════════════════
## القسم ١١: جدولة MLFQ
## ═══════════════════════════════════════════════════════════════

## حساب الشريحة الزمنية حسب المستوى
دالة شريحة_المستوى(المستوى)
    إذا (المستوى < 0)
        ارجع mlfq_quantum[0]
    نهاية
    إذا (المستوى >= MAX_MLFQ_LEVELS)
        ارجع mlfq_quantum[MAX_MLFQ_LEVELS - 1]
    نهاية
    ارجع mlfq_quantum[المستوى]
نهاية

## خفض مستوى عملية (استنفدت شريحتها)
دالة خفّض_مستوى(فهرس)
    إذا (p_نوع[فهرس] == PROC_TYPE_KERNEL)
        ارجع   # عمليات النواة لا تُخفض
    نهاية
    إذا (p_مستوى[فهرس] < MAX_MLFQ_LEVELS - 1)
        p_مستوى[فهرس] = p_مستوى[فهرس] + 1
    نهاية
    p_شريحة[فهرس] = شريحة_المستوى(p_مستوى[فهرس])
نهاية

## رفع أولوية جميع العمليات (anti-starvation boost)
دالة ارفع_جميع_الأولويات()
    متغير ف = 0
    بينما (ف < MAX_PROCS)
        إذا (p_حالة[ف] == PROC_READY)
            إذا (p_نوع[ف] == PROC_TYPE_USER)
                p_مستوى[ف] = 0
                p_شريحة[ف] = شريحة_المستوى(0)
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    last_boost_tick = proc_اقرأ_النبضات()
نهاية

## إيقاظ العمليات النائمة بمؤقت
دالة أيقظ_النائمين()
    متغير الآن = proc_اقرأ_النبضات()
    متغير ف = 0
    بينما (ف < MAX_PROCS)
        إذا (p_حالة[ف] == PROC_SLEEPING)
            إذا (p_سبب_انتظار[ف] == WAIT_TIMER)
                إذا (الآن >= p_استيقاظ[ف])
                    p_حالة[ف] = PROC_READY
                    p_سبب_انتظار[ف] = WAIT_NONE
                نهاية
            نهاية
        نهاية
        ف = ف + 1
    نهاية
نهاية

## اختيار العملية التالية — MLFQ
## يفحص المستويات من الأعلى (0) إلى الأدنى (7)
## في كل مستوى: Round Robin بين العمليات الجاهزة
دالة اختر_التالي()
    متغير مستوى = 0
    بينما (مستوى < MAX_MLFQ_LEVELS)
        # البحث عن عملية جاهزة في هذا المستوى
        # بدءاً من بعد العملية الحالية (Round Robin)
        متغير بداية = 0
        إذا (current_proc >= 0)
            بداية = current_proc + 1
        نهاية
        
        متغير ف = 0
        بينما (ف < MAX_PROCS)
            متغير فهرس = (بداية + ف) % MAX_PROCS
            إذا (p_حالة[فهرس] == PROC_READY)
                إذا (p_مستوى[فهرس] == مستوى)
                    ارجع فهرس
                نهاية
            نهاية
            ف = ف + 1
        نهاية
        
        مستوى = مستوى + 1
    نهاية
    
    ارجع -1  # لا توجد عملية جاهزة
نهاية

## المُجدول الرئيسي
صدّر دالة proc_جدول()
    proc_عطل_المقاطعات()
    
    # إيقاظ العمليات النائمة بمؤقت
    أيقظ_النائمين()
    
    # رفع الأولويات كل BOOST_INTERVAL نبضة
    متغير الآن = proc_اقرأ_النبضات()
    إذا (الآن - last_boost_tick >= BOOST_INTERVAL)
        ارفع_جميع_الأولويات()
    نهاية
    
    # حفظ حالة العملية الحالية
    إذا (current_proc >= 0)
        إذا (p_حالة[current_proc] == PROC_RUNNING)
            p_حالة[current_proc] = PROC_READY
        نهاية
    نهاية
    
    # اختيار العملية التالية
    متغير التالي = اختر_التالي()
    
    إذا (التالي < 0)
        # لا توجد عملية — تشغيل idle
        proc_فعل_المقاطعات()
        ارجع
    نهاية
    
    # تبديل السياق
    متغير السابق = current_proc + 0
    current_proc = التالي
    p_حالة[التالي] = PROC_RUNNING
    p_شريحة[التالي] = شريحة_المستوى(p_مستوى[التالي])
    total_switches = total_switches + 1
    
    # معالجة الإشارات
    عالج_الإشارات()
    
    # تبديل السياق الفعلي
    إذا (السابق >= 0)
        إذا (السابق != التالي)
            proc_فعل_المقاطعات()
            proc_بدل_السياق(p_سياق[السابق]، p_سياق[التالي])
            ارجع
        نهاية
    وإلا
        # أول تبديل — لا يوجد سياق سابق لحفظه
        proc_فعل_المقاطعات()
        proc_بدل_السياق(0، p_سياق[التالي])
        ارجع
    نهاية
    
    proc_فعل_المقاطعات()
نهاية

