# تخصيص مساحة MMIO حرة بمقاس محدد (محاذاة للصفحة)
صدّر دالة mmio_تخصيص_مساحة(مقاس_مطلوب)
    # محاذاة المقاس لحدود الصفحة (4096)
    متغير باقي_م = مقاس_مطلوب - ((مقاس_مطلوب / 4096) * 4096)
    متغير مقاس_محاذى = مقاس_مطلوب
    إذا (باقي_م != 0)
        مقاس_محاذى = مقاس_مطلوب + (4096 - باقي_م)
    نهاية
    
    # التحقق من وجود مساحة كافية
    متغير مساحة_متاحة = mmio_عنوان_نهاية_حرة - mmio_عنوان_بداية_حرة
    إذا (مقاس_محاذى > مساحة_متاحة)
        kernel_print_string("  [MMIO] لا توجد مساحة MMIO كافية!")
        ارجع 0
    نهاية
    
    # تخصيص من بداية المساحة الحرة
    متغير عنوان_مخصص = mmio_عنوان_بداية_حرة
    mmio_عنوان_بداية_حرة = mmio_عنوان_بداية_حرة + مقاس_محاذى
    
    kernel_print_string("  [MMIO] تخصيص مساحة MMIO: ")
    serial_put_hex(عنوان_مخصص)
    kernel_print_string(" مقاس=")
    kernel_print_number(مقاس_محاذى)
    
    ارجع عنوان_مخصص
نهاية

