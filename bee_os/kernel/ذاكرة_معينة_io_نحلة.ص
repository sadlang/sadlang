# تنظيف جميع موارد MMIO
صدّر دالة mmio_تنظيف()
    إذا (mmio_قاعدة_المناطق != 0)
        kernel_free(mmio_قاعدة_المناطق)
        mmio_قاعدة_المناطق = 0
    نهاية
    إذا (mmio_قاعدة_BAR != 0)
        kernel_free(mmio_قاعدة_BAR)
        mmio_قاعدة_BAR = 0
    نهاية
    إذا (mmio_قاعدة_السجل != 0)
        kernel_free(mmio_قاعدة_السجل)
        mmio_قاعدة_السجل = 0
    نهاية
    mmio_مُهيّأ = 0
    kernel_print_string("  [MMIO] تنظيف جميع الموارد")
نهاية

# البحث عن منطقة بمعرف جهاز
صدّر دالة mmio_بحث_بمعرف(معرف_جهاز_م)
    متغير ف = 0
    بينما (ف < MMIO_الحد_الأقصى_مناطق)
        متغير أعلام_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 3)
        متغير فحص_نشط = أعلام_م & MMIO_علم_نشط
        إذا (فحص_نشط != 0)
            متغير معرف_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 4)
            إذا (معرف_م == معرف_جهاز_م)
                ارجع ف
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

