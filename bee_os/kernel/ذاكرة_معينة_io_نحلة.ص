# طباعة أجهزة BAR
صدّر دالة mmio_طباعة_BAR()
    kernel_print_string("  [MMIO] === أجهزة PCI BAR ===")
    
    متغير ف = 0
    بينما (ف < MMIO_الحد_الأقصى_BAR)
        متغير أعلام_ب = mmio_قراءة_حقل_BAR(mmio_قاعدة_BAR، ف، 6)
        متغير فحص_نشط = أعلام_ب & MMIO_BAR_نشط
        إذا (فحص_نشط != 0)
            متغير ناقل_ب = mmio_قراءة_حقل_BAR(mmio_قاعدة_BAR، ف، 0)
            متغير جهاز_ب = mmio_قراءة_حقل_BAR(mmio_قاعدة_BAR، ف، 1)
            متغير وظيفة_ب = mmio_قراءة_حقل_BAR(mmio_قاعدة_BAR، ف، 2)
            متغير ترتيب_ب = mmio_قراءة_حقل_BAR(mmio_قاعدة_BAR، ف، 3)
            متغير عنوان_ب = mmio_قراءة_حقل_BAR(mmio_قاعدة_BAR، ف، 4)
            متغير مقاس_ب = mmio_قراءة_حقل_BAR(mmio_قاعدة_BAR، ف، 5)
            
            kernel_print_string("    BAR")
            kernel_print_number(ترتيب_ب)
            kernel_print_string(" (")
            kernel_print_number(ناقل_ب)
            kernel_print_string(":")
            kernel_print_number(جهاز_ب)
            kernel_print_string(".")
            kernel_print_number(وظيفة_ب)
            kernel_print_string(") عنوان=")
            serial_put_hex(عنوان_ب)
            kernel_print_string(" مقاس=")
            kernel_print_number(مقاس_ب)
        نهاية
        ف = ف + 1
    نهاية
    
    kernel_print_string("  [MMIO] =======================")
نهاية

