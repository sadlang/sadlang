# طباعة تفاصيل منطقة MMIO
صدّر دالة mmio_طباعة_منطقة(فهرس_منطقة)
    إذا (فهرس_منطقة < 0)
        ارجع 0
    نهاية
    إذا (فهرس_منطقة >= MMIO_الحد_الأقصى_مناطق)
        ارجع 0
    نهاية
    
    متغير أعلام_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 3)
    متغير فحص_نشط = أعلام_م & MMIO_علم_نشط
    إذا (فحص_نشط == 0)
        ارجع 0
    نهاية
    
    متغير عنوان_ف = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 0)
    متغير عنوان_اف = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 1)
    متغير مقاس_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 2)
    متغير معرف_ج = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 4)
    متغير فئة_ج = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 5)
    متغير قراءات_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 6)
    متغير كتابات_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 7)
    
    kernel_print_string("    منطقة #")
    kernel_print_number(فهرس_منطقة)
    kernel_print_string(" فيزيائي=")
    serial_put_hex(عنوان_ف)
    kernel_print_string(" مقاس=")
    kernel_print_number(مقاس_م)
    kernel_print_string(" قراءات=")
    kernel_print_number(قراءات_م)
    kernel_print_string(" كتابات=")
    kernel_print_number(كتابات_م)
    
    # طباعة الخصائص
    متغير فحص_تخزين = أعلام_م & MMIO_علم_قابل_تخزين
    إذا (فحص_تخزين != 0)
        kernel_print_string(" [تخزين_مؤقت]")
    نهاية
    
    متغير فحص_كتابة = أعلام_م & MMIO_علم_كتابة_مجمعة
    إذا (فحص_كتابة != 0)
        kernel_print_string(" [كتابة_مجمعة]")
    نهاية
    
    متغير فحص_قر_فقط = أعلام_م & MMIO_علم_قراءة_فقط
    إذا (فحص_قر_فقط != 0)
        kernel_print_string(" [قراءة_فقط]")
    نهاية
    
    ارجع 1
نهاية

# طباعة جميع المناطق المسجلة
صدّر دالة mmio_طباعة_كل_المناطق()
    kernel_print_string("  [MMIO] === مناطق MMIO المسجلة ===")
    
    متغير عداد = 0
    متغير ف = 0
    بينما (ف < MMIO_الحد_الأقصى_مناطق)
        متغير أعلام_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 3)
        متغير فحص_نشط = أعلام_م & MMIO_علم_نشط
        إذا (فحص_نشط != 0)
            mmio_طباعة_منطقة(ف)
            عداد = عداد + 1
        نهاية
        ف = ف + 1
    نهاية
    
    kernel_print_string("  [MMIO] الإجمالي: ")
    kernel_print_number(عداد)
    kernel_print_string(" منطقة")
    kernel_print_string("  [MMIO] ============================")
نهاية

