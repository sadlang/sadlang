#* ===================================================================
   نظام نحلة - ذاكرة الإدخال/الإخراج المعيّنة (MMIO)
   BeeOS - Memory-Mapped I/O Module
   
   الوصف: إدارة مناطق الإدخال/الإخراج المعيّنة في الذاكرة
   - تسجيل مناطق MMIO
   - تخطيط/إلغاء تخطيط ذاكرة الأجهزة
   - قراءة/كتابة 8/16/32 بت
   - تخصيص مساحة MMIO بدون تداخل
   - إدارة BAR لأجهزة PCI
   - دعم التخزين المؤقت وعدمه (cacheable/uncacheable)
   - دعم الكتابة المجمعة (write-combining)
   - تسجيل عمليات MMIO
   
   المؤلف: نظام نحلة
   الإصدار: 1.0.0
   ===================================================================  *#

# ===================================================================
# استيراد الدوال الخارجية من النواة
# ===================================================================
خارجي دالة kernel_print_string(عنوان)
خارجي دالة kernel_print_number(قيمة)
خارجي دالة serial_put_hex(قيمة)
خارجي دالة kernel_allocate(المقاس)
خارجي دالة kernel_free(عنوان)
خارجي دالة mem_read_byte(عنوان)
خارجي دالة mem_write_byte(عنوان، قيمة)
خارجي دالة mem_read_dword(عنوان)
خارجي دالة mem_write_dword(عنوان، قيمة)
خارجي دالة sad_ll_memset(عنوان، قيمة، طول)
خارجي دالة sad_ll_memcpy(وجهة، مصدر، طول)

# ===================================================================
# الثوابت الأساسية لنظام MMIO
# ===================================================================

# الحد الأقصى لعدد المناطق المسجلة
متغير MMIO_الحد_الأقصى_مناطق = 128

# الحد الأقصى لأجهزة PCI BAR
متغير MMIO_الحد_الأقصى_BAR = 64

# مقاس سجل العمليات
متغير MMIO_مقاس_سجل_عمليات = 256

# حقول منطقة MMIO (كل حقل 4 بايت)
# الفهرس 0: العنوان الفيزيائي الأساسي
# الفهرس 1: العنوان الافتراضي المخطط
# الفهرس 2: مقاس المنطقة بالبايت
# الفهرس 3: أعلام (bit0: نشط، bit1: قابل_تخزين، bit2: كتابة_مجمعة، bit3: للقراءة_فقط)
# الفهرس 4: معرف الجهاز
# الفهرس 5: فئة الجهاز
# الفهرس 6: عدد عمليات القراءة
# الفهرس 7: عدد عمليات الكتابة
# الفهرس 8: آخر عنوان وصول
# الفهرس 9: آخر قيمة مكتوبة
# الفهرس 10: وقت التسجيل
# الفهرس 11: معرف BAR المرتبط (أو 0)
متغير MMIO_حقول_منطقة = 12
متغير MMIO_مقاس_منطقة = 48

# حقول BAR لأجهزة PCI
# الفهرس 0: رقم الناقل (bus)
# الفهرس 1: رقم الجهاز (device)
# الفهرس 2: رقم الوظيفة (function)
# الفهرس 3: رقم BAR (0-5)
# الفهرس 4: العنوان الأساسي
# الفهرس 5: مقاس BAR
# الفهرس 6: أعلام (bit0: نشط، bit1: ذاكرة/منفذ، bit2: 64 بت)
# الفهرس 7: فهرس المنطقة المرتبطة
متغير MMIO_حقول_BAR = 8
متغير MMIO_مقاس_BAR = 32

# حقول سجل العمليات
# الفهرس 0: وقت العملية
# الفهرس 1: فئة العملية (1=قراءة، 2=كتابة)
# الفهرس 2: العنوان
# الفهرس 3: القيمة
# الفهرس 4: عرض البيانات (8/16/32)
# الفهرس 5: فهرس المنطقة
متغير MMIO_حقول_سجل = 6
متغير MMIO_مقاس_سجل_حقل = 24

# أعلام المنطقة
متغير MMIO_علم_نشط = 1
متغير MMIO_علم_قابل_تخزين = 2
متغير MMIO_علم_كتابة_مجمعة = 4
متغير MMIO_علم_قراءة_فقط = 8
متغير MMIO_علم_مخطط = 16

# أعلام BAR
متغير MMIO_BAR_نشط = 1
متغير MMIO_BAR_ذاكرة = 0
متغير MMIO_BAR_منفذ = 2
متغير MMIO_BAR_64بت = 4

# فئات الأجهزة
متغير MMIO_فئة_عام = 0
متغير MMIO_فئة_شاشة = 1
متغير MMIO_فئة_شبكة = 2
متغير MMIO_فئة_تخزين = 3
متغير MMIO_فئة_صوت = 4
متغير MMIO_فئة_USB = 5
متغير MMIO_فئة_مؤقت = 6
متغير MMIO_فئة_APIC = 7

# أنواع العمليات في السجل
متغير MMIO_عملية_قراءة = 1
متغير MMIO_عملية_كتابة = 2

# عناوين MMIO الشائعة
متغير MMIO_عنوان_APIC = 4261412864
متغير MMIO_عنوان_IOAPIC = 4261478400
متغير MMIO_عنوان_HPET = 4261412864
متغير MMIO_عنوان_VGA = 2684354560

# ===================================================================
# المتغيرات العامة
# ===================================================================
متغير mmio_قاعدة_المناطق = 0
متغير mmio_قاعدة_BAR = 0
متغير mmio_قاعدة_السجل = 0
متغير mmio_عدد_المناطق = 0
متغير mmio_عدد_BAR = 0
متغير mmio_فهرس_السجل = 0
متغير mmio_تسجيل_مفعل = 0
متغير mmio_إجمالي_قراءات = 0
متغير mmio_إجمالي_كتابات = 0
متغير mmio_مُهيّأ = 0
متغير mmio_عنوان_بداية_حرة = 0
متغير mmio_عنوان_نهاية_حرة = 0

# ===================================================================
# دوال الوصول للحقول
# ===================================================================

# كتابة حقل في منطقة MMIO
دالة mmio_كتابة_حقل_منطقة(قاعدة، فهرس_منطقة، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_منطقة * MMIO_مقاس_منطقة) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من منطقة MMIO
دالة mmio_قراءة_حقل_منطقة(قاعدة، فهرس_منطقة، فهرس_حقل)
    متغير إزاحة = (فهرس_منطقة * MMIO_مقاس_منطقة) + (فهرس_حقل * 4)
    ارجع mem_read_dword(قاعدة + إزاحة)
نهاية

# كتابة حقل في سجل BAR
دالة mmio_كتابة_حقل_BAR(قاعدة، فهرس_bar، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_bar * MMIO_مقاس_BAR) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من سجل BAR
دالة mmio_قراءة_حقل_BAR(قاعدة، فهرس_bar، فهرس_حقل)
    متغير إزاحة = (فهرس_bar * MMIO_مقاس_BAR) + (فهرس_حقل * 4)
    ارجع mem_read_dword(قاعدة + إزاحة)
نهاية

# كتابة حقل في سجل العمليات
دالة mmio_كتابة_حقل_سجل(قاعدة، فهرس_سجل_ح، فهرس_حقل، قيمة_م)
    متغير إزاحة = (فهرس_سجل_ح * MMIO_مقاس_سجل_حقل) + (فهرس_حقل * 4)
    mem_write_dword(قاعدة + إزاحة، قيمة_م)
نهاية

# قراءة حقل من سجل العمليات
دالة mmio_قراءة_حقل_سجل(قاعدة، فهرس_سجل_ح، فهرس_حقل)
    متغير إزاحة = (فهرس_سجل_ح * MMIO_مقاس_سجل_حقل) + (فهرس_حقل * 4)
    ارجع mem_read_dword(قاعدة + إزاحة)
نهاية

# ===================================================================
# دوال التهيئة
# ===================================================================

# تهيئة جدول المناطق
دالة mmio_تهيئة_المناطق()
    متغير المقاس_الكلي = MMIO_الحد_الأقصى_مناطق * MMIO_مقاس_منطقة
    
    mmio_قاعدة_المناطق = kernel_allocate(المقاس_الكلي)
    إذا (mmio_قاعدة_المناطق == 0)
        kernel_print_string("  [خطأ] فشل تخصيص جدول مناطق MMIO")
        ارجع 0
    نهاية
    
    sad_ll_memset(mmio_قاعدة_المناطق، 0، المقاس_الكلي)
    
    # تهيئة كل منطقة كغير نشطة
    متغير ف = 0
    بينما (ف < MMIO_الحد_الأقصى_مناطق)
        mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 3، 0)
        ف = ف + 1
    نهاية
    
    mmio_عدد_المناطق = 0
    kernel_print_string("  [MMIO] تم تهيئة جدول المناطق - السعة: ")
    kernel_print_number(MMIO_الحد_الأقصى_مناطق)
    
    ارجع 1
نهاية

# تهيئة جدول BAR
دالة mmio_تهيئة_BAR()
    متغير المقاس_الكلي = MMIO_الحد_الأقصى_BAR * MMIO_مقاس_BAR
    
    mmio_قاعدة_BAR = kernel_allocate(المقاس_الكلي)
    إذا (mmio_قاعدة_BAR == 0)
        kernel_print_string("  [خطأ] فشل تخصيص جدول BAR")
        ارجع 0
    نهاية
    
    sad_ll_memset(mmio_قاعدة_BAR، 0، المقاس_الكلي)
    
    متغير ف = 0
    بينما (ف < MMIO_الحد_الأقصى_BAR)
        mmio_كتابة_حقل_BAR(mmio_قاعدة_BAR، ف، 6، 0)
        ف = ف + 1
    نهاية
    
    mmio_عدد_BAR = 0
    kernel_print_string("  [MMIO] تم تهيئة جدول BAR - السعة: ")
    kernel_print_number(MMIO_الحد_الأقصى_BAR)
    
    ارجع 1
نهاية

# تهيئة سجل العمليات
دالة mmio_تهيئة_السجل()
    متغير المقاس_الكلي = MMIO_مقاس_سجل_عمليات * MMIO_مقاس_سجل_حقل
    
    mmio_قاعدة_السجل = kernel_allocate(المقاس_الكلي)
    إذا (mmio_قاعدة_السجل == 0)
        kernel_print_string("  [خطأ] فشل تخصيص سجل عمليات MMIO")
        ارجع 0
    نهاية
    
    sad_ll_memset(mmio_قاعدة_السجل، 0، المقاس_الكلي)
    mmio_فهرس_السجل = 0
    mmio_تسجيل_مفعل = 1
    
    kernel_print_string("  [MMIO] تم تهيئة سجل العمليات - السعة: ")
    kernel_print_number(MMIO_مقاس_سجل_عمليات)
    
    ارجع 1
نهاية

# تهيئة مساحة MMIO الحرة
دالة mmio_تهيئة_مساحة_حرة()
    # مساحة MMIO تبدأ عادة عند 0xE000_0000 (3.5 GB)
    mmio_عنوان_بداية_حرة = 3758096384
    # تنتهي عند 0xFFFF_FFFF (4 GB)
    mmio_عنوان_نهاية_حرة = 4294967295
    
    kernel_print_string("  [MMIO] مساحة MMIO الحرة: ")
    serial_put_hex(mmio_عنوان_بداية_حرة)
    kernel_print_string(" - ")
    serial_put_hex(mmio_عنوان_نهاية_حرة)
    
    ارجع 1
نهاية

# ===================================================================
# تسجيل مناطق MMIO
# ===================================================================

# تسجيل منطقة MMIO جديدة
صدّر دالة mmio_تسجيل_منطقة(عنوان_فيزيائي، مقاس_منطقة، فئة_جهاز، معرف_جهاز_م)
    إذا (mmio_مُهيّأ == 0)
        ارجع -1
    نهاية
    
    # فحص التداخل مع المناطق الموجودة
    متغير تداخل = mmio_فحص_تداخل(عنوان_فيزيائي، مقاس_منطقة)
    إذا (تداخل != 0)
        kernel_print_string("  [MMIO] خطأ: تداخل مع منطقة موجودة!")
        serial_put_hex(عنوان_فيزيائي)
        ارجع -1
    نهاية
    
    # البحث عن فتحة فارغة
    متغير فتحة = -1
    متغير ف = 0
    بينما (ف < MMIO_الحد_الأقصى_مناطق)
        متغير أعلام_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 3)
        متغير فحص_نشط = أعلام_م & MMIO_علم_نشط
        إذا (فحص_نشط == 0)
            فتحة = ف
            اخرج
        نهاية
        ف = ف + 1
    نهاية
    
    إذا (فتحة == -1)
        kernel_print_string("  [MMIO] جدول المناطق ممتلئ!")
        ارجع -1
    نهاية
    
    # تعبئة بيانات المنطقة
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 0، عنوان_فيزيائي)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 1، 0)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 2، مقاس_منطقة)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 3، MMIO_علم_نشط)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 4، معرف_جهاز_م)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 5، فئة_جهاز)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 6، 0)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 7، 0)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 8، 0)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 9، 0)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 10، 0)
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فتحة، 11، 0)
    
    mmio_عدد_المناطق = mmio_عدد_المناطق + 1
    
    kernel_print_string("  [MMIO] تسجيل منطقة في الفتحة ")
    kernel_print_number(فتحة)
    kernel_print_string(" عنوان=")
    serial_put_hex(عنوان_فيزيائي)
    kernel_print_string(" مقاس=")
    kernel_print_number(مقاس_منطقة)
    
    ارجع فتحة
نهاية

# فحص التداخل مع المناطق الموجودة
دالة mmio_فحص_تداخل(عنوان_بداية، مقاس_م)
    متغير عنوان_خاتمة = عنوان_بداية + مقاس_م
    
    متغير ف = 0
    بينما (ف < MMIO_الحد_الأقصى_مناطق)
        متغير أعلام_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 3)
        متغير فحص_نشط = أعلام_م & MMIO_علم_نشط
        إذا (فحص_نشط != 0)
            متغير بداية_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 0)
            متغير مقاس_منطقة_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 2)
            متغير خاتمة_م = بداية_م + مقاس_منطقة_م
            
            # فحص التداخل: [بداية, خاتمة) ∩ [بداية_م, خاتمة_م)
            إذا (عنوان_بداية < خاتمة_م)
                إذا (عنوان_خاتمة > بداية_م)
                    kernel_print_string("  [MMIO] تداخل مع المنطقة ")
                    kernel_print_number(ف)
                    ارجع 1
                نهاية
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    
    ارجع 0
نهاية

# إلغاء تسجيل منطقة MMIO
صدّر دالة mmio_إلغاء_تسجيل(فهرس_منطقة)
    إذا (فهرس_منطقة < 0)
        ارجع 0
    نهاية
    إذا (فهرس_منطقة >= MMIO_الحد_الأقصى_مناطق)
        ارجع 0
    نهاية
    
    متغير أعلام_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 3)
    متغير فحص_نشط = أعلام_م & MMIO_علم_نشط
    إذا (فحص_نشط == 0)
        ارجع 0
    نهاية
    
    # تصفير المنطقة
    mmio_كتابة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 3، 0)
    mmio_عدد_المناطق = mmio_عدد_المناطق - 1
    
    kernel_print_string("  [MMIO] إلغاء تسجيل المنطقة ")
    kernel_print_number(فهرس_منطقة)
    
    ارجع 1
نهاية

# البحث عن منطقة تحتوي عنوان فيزيائي معين
دالة mmio_بحث_منطقة(عنوان_فيزيائي)
    متغير ف = 0
    بينما (ف < MMIO_الحد_الأقصى_مناطق)
        متغير أعلام_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 3)
        متغير فحص_نشط = أعلام_م & MMIO_علم_نشط
        إذا (فحص_نشط != 0)
            متغير بداية_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 0)
            متغير مقاس_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، ف، 2)
            متغير خاتمة_م = بداية_م + مقاس_م
            
            إذا (عنوان_فيزيائي >= بداية_م)
                إذا (عنوان_فيزيائي < خاتمة_م)
                    ارجع ف
                نهاية
            نهاية
        نهاية
        ف = ف + 1
    نهاية
    ارجع -1
نهاية

# ===================================================================
# تخطيط وإلغاء تخطيط الذاكرة
# ===================================================================

# تخطيط منطقة MMIO (ربط العنوان الفيزيائي بعنوان افتراضي)
صدّر دالة mmio_تخطيط(فهرس_منطقة)
    إذا (فهرس_منطقة < 0)
        ارجع 0
    نهاية
    إذا (فهرس_منطقة >= MMIO_الحد_الأقصى_مناطق)
        ارجع 0
    نهاية
    
    متغير أعلام_م = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 3)
    متغير فحص_نشط = أعلام_م & MMIO_علم_نشط
    إذا (فحص_نشط == 0)
        kernel_print_string("  [MMIO] المنطقة غير نشطة!")
        ارجع 0
    نهاية
    
    # فحص هل مخططة مسبقاً
    متغير فحص_مخطط = أعلام_م & MMIO_علم_مخطط
    إذا (فحص_مخطط != 0)
        # مخططة مسبقاً - إرجاع العنوان الافتراضي
        ارجع mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 1)
    نهاية
    
    متغير عنوان_فيزيائي = mmio_قراءة_حقل_منطقة(mmio_قاعدة_المناطق، فهرس_منطقة، 0)
