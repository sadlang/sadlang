# تسجيل عملية MMIO في السجل الدائري
دالة mmio_سجل_عملية(فئة_عملية، عنوان_م، قيمة_م، عرض_بيانات، فهرس_م)
    إذا (mmio_تسجيل_مفعل == 0)
        ارجع 0
    نهاية
    
    متغير موقع = mmio_فهرس_السجل
    إذا (موقع >= MMIO_مقاس_سجل_عمليات)
        موقع = 0
    نهاية
    
    mmio_كتابة_حقل_سجل(mmio_قاعدة_السجل، موقع، 0، 0)
    mmio_كتابة_حقل_سجل(mmio_قاعدة_السجل، موقع، 1، فئة_عملية)
    mmio_كتابة_حقل_سجل(mmio_قاعدة_السجل، موقع، 2، عنوان_م)
    mmio_كتابة_حقل_سجل(mmio_قاعدة_السجل، موقع، 3، قيمة_م)
    mmio_كتابة_حقل_سجل(mmio_قاعدة_السجل، موقع، 4، عرض_بيانات)
    mmio_كتابة_حقل_سجل(mmio_قاعدة_السجل، موقع، 5، فهرس_م)
    
    mmio_فهرس_السجل = موقع + 1
    إذا (mmio_فهرس_السجل >= MMIO_مقاس_سجل_عمليات)
        mmio_فهرس_السجل = 0
    نهاية
    
    ارجع 1
نهاية

# تفعيل/تعطيل التسجيل
صدّر دالة mmio_تبديل_تسجيل(مفعل)
    mmio_تسجيل_مفعل = مفعل
    إذا (مفعل == 1)
        kernel_print_string("  [MMIO] تسجيل العمليات: مفعّل")
    وإلا
        kernel_print_string("  [MMIO] تسجيل العمليات: معطّل")
    نهاية
    ارجع 1
نهاية

