# القسم 6: قراءة inode
# ══════════════════════════════════════════════

#* ── قراءة inode من جدول inodes ──
   بنية inode الأساسية (16 بايت):
   إزاحة 0: النوع (2 بايت)
   إزاحة 2: الصلاحيات (2 بايت)
   إزاحة 4: uid_idx (2 بايت)
   إزاحة 6: gid_idx (2 بايت)
   إزاحة 8: وقت التعديل (4 بايت)
   إزاحة 12: رقم inode (4 بايت)
*#
صدّر دالة sqfs_اقرأ_inode_صنف(عنوان_بيانات)
    متغير ص_ق = mem_read_word(عنوان_بيانات)
    sqfs_inodes_قرئت = sqfs_inodes_قرئت + 1
    ارجع ص_ق
نهاية

صدّر دالة sqfs_اقرأ_inode_صلاحيات(عنوان_بيانات)
    ارجع mem_read_word(عنوان_بيانات + 2)
نهاية

صدّر دالة sqfs_اقرأ_inode_وقت(عنوان_بيانات)
    ارجع mem_read_dword(عنوان_بيانات + 8)
نهاية

صدّر دالة sqfs_اقرأ_inode_معرف(عنوان_بيانات)
    ارجع mem_read_dword(عنوان_بيانات + 12)
نهاية

# ══════════════════════════════════════════════
# القسم 7: قراءة مدخل دليل
# ══════════════════════════════════════════════

#* ── بنية مدخل دليل SquashFS ──
   الرأس (12 بايت):
   إزاحة 0: عدد المدخلات - 1 (4 بايت)
   إزاحة 4: بداية كتلة inode (4 بايت)
   إزاحة 8: رقم inode (4 بايت)
   
   كل مدخل (8+ بايت):
   إزاحة 0: إزاحة (2 بايت)
   إزاحة 2: رقم inode النسبي (2 بايت)
   إزاحة 4: النوع (2 بايت)
   إزاحة 6: طول الاسم - 1 (2 بايت)
   إزاحة 8+: الاسم
*#
صدّر دالة sqfs_اقرأ_دليل_عدد(عنوان_رأس)
    متغير عدد_ناقص = mem_read_dword(عنوان_رأس)
    sqfs_أدلة_قرئت = sqfs_أدلة_قرئت + 1
    ارجع عدد_ناقص + 1  # العدد الحقيقي
نهاية

صدّر دالة sqfs_اقرأ_مدخل_صنف(عنوان_مدخل)
    ارجع mem_read_word(عنوان_مدخل + 4)
نهاية

صدّر دالة sqfs_اقرأ_مدخل_طول_اسم(عنوان_مدخل)
    متغير طول_ناقص = mem_read_word(عنوان_مدخل + 6)
    ارجع طول_ناقص + 1
نهاية

# ══════════════════════════════════════════════
# القسم 8: تحرير الذاكرة
# ══════════════════════════════════════════════

صدّر دالة sqfs_حرر_ذاكرة()
    إذا (sqfs_كتلة_عنوان_0 != 0) kernel_free(sqfs_كتلة_عنوان_0) نهاية
    sqfs_كتلة_عنوان_0 = 0
    sqfs_كتلة_صالحة_0 = 0
    
    إذا (sqfs_كتلة_عنوان_1 != 0) kernel_free(sqfs_كتلة_عنوان_1) نهاية
    sqfs_كتلة_عنوان_1 = 0
    sqfs_كتلة_صالحة_1 = 0
    
    إذا (sqfs_كتلة_عنوان_2 != 0) kernel_free(sqfs_كتلة_عنوان_2) نهاية
    sqfs_كتلة_عنوان_2 = 0
    sqfs_كتلة_صالحة_2 = 0
    
    إذا (sqfs_كتلة_عنوان_3 != 0) kernel_free(sqfs_كتلة_عنوان_3) نهاية
    sqfs_كتلة_عنوان_3 = 0
    sqfs_كتلة_صالحة_3 = 0
    
    ارجع 0
نهاية

