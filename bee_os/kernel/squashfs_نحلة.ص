متغير sqfs_كتلة_رقم_3 = 0
متغير sqfs_كتلة_مقاس_3 = 0
متغير sqfs_كتلة_صالحة_3 = 0

# ══════════════════════════════════════════════
# القسم 3: قراءة Superblock
# ══════════════════════════════════════════════

#* ── قراءة وتحقق من superblock ──
   Superblock عند بداية الصورة (قطاع 0)
   نتحقق من التوقيع "hsqs"
*#
صدّر دالة sqfs_اقرأ_superblock(قرص، قطاع_بداية)
    sqfs_قرص = قرص
    sqfs_قطاع_بداية = قطاع_بداية
    sqfs_صالح = 0
    
    متغير مخزن = kernel_allocate(512)
    إذا (مخزن == 0) ارجع -1 نهاية
    
    disk_read_sector(قرص، قطاع_بداية، مخزن)
    
    # التحقق من التوقيع
    متغير ت0 = mem_read_byte(مخزن)
    متغير ت1 = mem_read_byte(مخزن + 1)
    متغير ت2 = mem_read_byte(مخزن + 2)
    متغير ت3 = mem_read_byte(مخزن + 3)
    
    متغير توقيع_صحيح = 1
    إذا (ت0 != sqfs_توقيع_0) توقيع_صحيح = 0 نهاية
    إذا (ت1 != sqfs_توقيع_1) توقيع_صحيح = 0 نهاية
    إذا (ت2 != sqfs_توقيع_2) توقيع_صحيح = 0 نهاية
    إذا (ت3 != sqfs_توقيع_3) توقيع_صحيح = 0 نهاية
    
    إذا (توقيع_صحيح == 1)
        sqfs_صالح = 1
        sqfs_عدد_inodes = mem_read_dword(مخزن + 4)
        sqfs_وقت_إنشاء = mem_read_dword(مخزن + 8)
        sqfs_مقاس_كتلة = mem_read_dword(مخزن + 12)
        sqfs_عدد_أجزاء = mem_read_dword(مخزن + 16)
        sqfs_صنف_ضغط = mem_read_word(مخزن + 20)
        sqfs_أعلام = mem_read_word(مخزن + 24)
        sqfs_عدد_معرفات = mem_read_word(مخزن + 26)
        sqfs_إصدار_رئيسي = mem_read_word(مخزن + 28)
        sqfs_إصدار_فرعي = mem_read_word(مخزن + 30)
        sqfs_جذر_موقع = mem_read_dword(مخزن + 32)
        sqfs_بايتات_مستخدمة = mem_read_dword(مخزن + 40)
        sqfs_جدول_معرفات = mem_read_dword(مخزن + 48)
        sqfs_جدول_inodes = mem_read_dword(مخزن + 64)
        sqfs_جدول_أدلة = mem_read_dword(مخزن + 72)
        sqfs_جدول_أجزاء = mem_read_dword(مخزن + 80)
        
        kernel_print_string("    squashfs: valid superblock")
        kernel_print_number(10)
        kernel_print_string("      inodes=")
        kernel_print_number(sqfs_عدد_inodes)
        kernel_print_string(" block_size=")
        kernel_print_number(sqfs_مقاس_كتلة)
        kernel_print_string(" compression=")
        kernel_print_number(sqfs_صنف_ضغط)
        kernel_print_number(10)
    وإلا
        kernel_print_string("    squashfs: no valid superblock")
        kernel_print_number(10)
    نهاية
    
    kernel_free(مخزن)
    ارجع sqfs_صالح
نهاية

# ══════════════════════════════════════════════
# القسم 4: قراءة كتلة بيانات
# ══════════════════════════════════════════════

#* ── قراءة كتلة بيانات (مضغوطة أو غير مضغوطة) ──
   في SquashFS، بت 24 من مقاس الكتلة المخزن يشير
   هل الكتلة غير مضغوطة (1) أو مضغوطة (0)
   المقاس الفعلي = أقل 24 بت
*#
صدّر دالة sqfs_اقرأ_كتلة(رقم_كتلة)
    # البحث في الذاكرة المؤقتة
    إذا (sqfs_كتلة_صالحة_0 == 1)
        إذا (sqfs_كتلة_رقم_0 == رقم_كتلة)
            ارجع sqfs_كتلة_عنوان_0
        نهاية
    نهاية
    إذا (sqfs_كتلة_صالحة_1 == 1)
        إذا (sqfs_كتلة_رقم_1 == رقم_كتلة)
            ارجع sqfs_كتلة_عنوان_1
        نهاية
    نهاية
    إذا (sqfs_كتلة_صالحة_2 == 1)
        إذا (sqfs_كتلة_رقم_2 == رقم_كتلة)
            ارجع sqfs_كتلة_عنوان_2
        نهاية
    نهاية
    إذا (sqfs_كتلة_صالحة_3 == 1)
        إذا (sqfs_كتلة_رقم_3 == رقم_كتلة)
            ارجع sqfs_كتلة_عنوان_3
        نهاية
    نهاية
    
    # قراءة من القرص
    # نحسب القطاع: رقم_الكتلة * (مقاس_الكتلة / 512)
    متغير قطاعات_لكل_كتلة = sqfs_مقاس_كتلة / 512
    متغير قطاع = sqfs_قطاع_بداية + (رقم_كتلة * قطاعات_لكل_كتلة)
    
    # نقرأ أول قطاع فقط (512 بايت)
    متغير مخزن = kernel_allocate(512)
    إذا (مخزن == 0) ارجع 0 نهاية
    
    disk_read_sector(sqfs_قرص، قطاع، مخزن)
    sqfs_كتل_قرئت = sqfs_كتل_قرئت + 1
    
    # تخزين مؤقت (LRU بسيط — نستبدل الأقدم)
    # ابحث عن خانة فارغة أولاً
    إذا (sqfs_كتلة_صالحة_0 == 0)
        sqfs_كتلة_عنوان_0 = مخزن
        sqfs_كتلة_رقم_0 = رقم_كتلة
        sqfs_كتلة_مقاس_0 = 512
        sqfs_كتلة_صالحة_0 = 1
        ارجع مخزن
    نهاية
    إذا (sqfs_كتلة_صالحة_1 == 0)
        sqfs_كتلة_عنوان_1 = مخزن
        sqfs_كتلة_رقم_1 = رقم_كتلة
        sqfs_كتلة_مقاس_1 = 512
        sqfs_كتلة_صالحة_1 = 1
        ارجع مخزن
    نهاية
    إذا (sqfs_كتلة_صالحة_2 == 0)
        sqfs_كتلة_عنوان_2 = مخزن
        sqfs_كتلة_رقم_2 = رقم_كتلة
        sqfs_كتلة_مقاس_2 = 512
        sqfs_كتلة_صالحة_2 = 1
        ارجع مخزن
    نهاية
    إذا (sqfs_كتلة_صالحة_3 == 0)
        sqfs_كتلة_عنوان_3 = مخزن
        sqfs_كتلة_رقم_3 = رقم_كتلة
        sqfs_كتلة_مقاس_3 = 512
        sqfs_كتلة_صالحة_3 = 1
        ارجع مخزن
    نهاية
    
    # كل الخانات ممتلئة — استبدل 0
    إذا (sqfs_كتلة_عنوان_0 != 0) kernel_free(sqfs_كتلة_عنوان_0) نهاية
    sqfs_كتلة_عنوان_0 = مخزن
    sqfs_كتلة_رقم_0 = رقم_كتلة
    sqfs_كتلة_مقاس_0 = 512
    sqfs_كتلة_صالحة_0 = 1
    ارجع مخزن
نهاية

# ══════════════════════════════════════════════
# القسم 5: فك الضغط المبسط (RLE)
# ══════════════════════════════════════════════

#* ── فك ضغط RLE ──
   لسنا ندعم gzip/lz4 الحقيقيين في kernel
   لكن ندعم RLE البسيط كنموذج
   التنسيق: [عدد][بايت] ← بايت يتكرر عدد مرات
*#
صدّر دالة sqfs_فك_rle(مصدر، هدف، طول_مصدر، سعة_هدف)
    متغير م_ع = 0     # مؤشر المصدر
    متغير هـ_ع = 0     # مؤشر الهدف
    
    بينما (م_ع < طول_مصدر)
        إذا (هـ_ع >= سعة_هدف) اخرج نهاية
        
        متغير عدد = mem_read_byte(مصدر + م_ع)
        م_ع = م_ع + 1
        
        إذا (م_ع >= طول_مصدر) اخرج نهاية
        
        متغير قيمة = mem_read_byte(مصدر + م_ع)
        م_ع = م_ع + 1
        
        متغير ت = 0
        بينما (ت < عدد)
            إذا (هـ_ع >= سعة_هدف) اخرج نهاية
            mem_write_byte(هدف + هـ_ع، قيمة)
            هـ_ع = هـ_ع + 1
            ت = ت + 1
        نهاية
    نهاية
    
    sqfs_كتل_فكت = sqfs_كتل_فكت + 1
    ارجع هـ_ع
نهاية

