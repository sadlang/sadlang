# كتلة 0
متغير sqfs_كتلة_عنوان_0 = 0
متغير sqfs_كتلة_رقم_0 = 0
متغير sqfs_كتلة_مقاس_0 = 0
متغير sqfs_كتلة_صالحة_0 = 0

# كتلة 1
متغير sqfs_كتلة_عنوان_1 = 0
متغير sqfs_كتلة_رقم_1 = 0
متغير sqfs_كتلة_مقاس_1 = 0
متغير sqfs_كتلة_صالحة_1 = 0

