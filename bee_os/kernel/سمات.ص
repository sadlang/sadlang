# ----------------------------
# دالة: رسم الخلفية حسب السمة
# ----------------------------
# تُرسم الخلفية حسب النمط المحدد في السمة:
#   - تدرج: أشرطة أفقية بلون متدرج
#   - لون واحد: fill_rect كامل الشاشة
#   - نجوم: خلفية سوداء + نقاط عشوائية
#   - نقش: نمط هندسي مكرر
#
# لأغراض الاختبار (بدون framebuffer حقيقي)، نطبع وصفاً نصياً
# للعمليات التي ستُنفَّذ على الأجهزة الحقيقية.

دالة رسم_خلفية_بالسمة(عرض، ارتفاع)
    متغير ف = سمة_حالية[0]
    متغير النمط = سمات_خلفية_نمط[ف]
    اطبع_سطر("[Theme:BG] رسم خلفية — نمط: " + النمط)

    إذا (النمط == "تدرج_عمودي" || النمط == "تدرج_قطري")
        متغير أشرطة = سمات_تدرج_أشرطة[ف]
        متغير لون_بداية = سمات_خلفية_بداية[ف]
        متغير لون_نهاية_تدرج = سمات_خلفية_نهاية[ف]
        اطبع_سطر("  [+] تدرج: " + أشرطة + " شريط")
        اطبع_سطر("  [+] من " + لون_بداية + " إلى " + لون_نهاية_تدرج)
        # كل شريط: sad_ll_fb_fill_rect(0, ش*ارتفاع_شريط, عرض, ارتفاع_شريط, لون)
        اطبع_سطر("  [+] sad_ll_fb_fill_rect() × " + أشرطة + " شريط أفقي")
    نهاية

    إذا (النمط == "نجوم")
        متغير عدد_نجوم = سمات_نجوم_عدد[ف]
        اطبع_سطر("  [+] خلفية سوداء + " + عدد_نجوم + " نجمة")
        اطبع_سطر("  [+] sad_ll_fb_clear(0) ثم sad_ll_fb_set_pixel() × " + عدد_نجوم)
    نهاية

    إذا (النمط == "نقش")
        متغير نمط_نقش = سمات_نقش_خلفية[ف]
        اطبع_سطر("  [+] نقش إسلامي: " + نمط_نقش)
        اطبع_سطر("  [+] رسم النقش بتكرار sad_ll_fb_draw_line()")
    نهاية

    إذا (النمط == "لون_واحد")
        اطبع_سطر("  [+] لون واحد: " + سمات_خلفية[ف])
        اطبع_سطر("  [+] sad_ll_fb_clear(" + سمات_خلفية[ف] + ")")
    نهاية

    اطبع_سطر("  ✓ خلفية " + عرض + "×" + ارتفاع + " مرسومة")
    ارجع 1
نهاية

