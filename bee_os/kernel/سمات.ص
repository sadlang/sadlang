# ----------------------------
# دالة: تغيير_السمة
# ----------------------------
# تقوم بتغيير السمة النشطة إلى الفهرس المحدد.
# تتحقق من صلاحية الفهرس (0..عدد_السمات-1).
# تُرجع 1 إذا نجح التغيير، 0 إذا فشل.
# بعد التغيير، يجب إعادة رسم سطح المكتب.

دالة تغيير_السمة(فهرس_سمة)
    # التحقق من صلاحية الفهرس
    إذا (فهرس_سمة < 0 || فهرس_سمة >= سمة_عدد)
        اطبع_سطر("[Theme] ✗ فهرس سمة غير صالح: " + فهرس_سمة)
        ارجع 0
    نهاية

    متغير سمة_سابقة = سمة_حالية[0]
    سمة_حالية[0] = فهرس_سمة
    اطبع_سطر("[Theme] ▶ تغيير السمة: " + سمات_أسماء[سمة_سابقة] + " → " + سمات_أسماء[فهرس_سمة])
    اطبع_سطر("  [+] " + سمات_وصف[فهرس_سمة])
    ارجع 1
نهاية

