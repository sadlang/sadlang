# ═══════════════════════════════════════════════════════════════════════════════
# خوارزمية الساعة — اختيار صفحة للاستبدال
# ═══════════════════════════════════════════════════════════════════════════════
#
# خوارزمية الساعة المُحسّنة:
# 1. فحص بتات التقادم للمدخلة عند موقع العقرب
# 2. إذا كانت بتات التقادم < العتبة:
#    - هذه الصفحة مرشحة — نختارها
# 3. إذا كانت بتات التقادم >= العتبة:
#    - نُزيح بتات التقادم يميناً (تقليل الأولوية)
#    - نتقدم بالعقرب
# 4. نكرر حتى نجد صفحة مرشحة (أو ندور دورة كاملة)

# اختيار صفحة للاستبدال باستخدام خوارزمية الساعة
# تُرجع فهرس المدخلة في قائمة الساعة أو -1
دالة اختيار_صفحة_للاستبدال()
    إذا (عدد_صفحات_محملة == 0)
        ارجع -1
    نهاية

    # نسمح بدورتين كاملتين كحد أقصى
    متغير اقصى_محاولات = عدد_صفحات_محملة * 2
    متغير محاولات = 0

    بينما (محاولات < اقصى_محاولات)
        # قراءة بتات التقادم
        متغير تقادم = قراءة_تقادم_ساعة(عقرب_ساعة)
        عداد_فحص_ساعة = عداد_فحص_ساعة + 1

        # هل هذه الصفحة مرشحة للاستبدال؟
        إذا (تقادم < ثابت_عتبة_تقادم)
            # نعم — نختار هذه الصفحة
            متغير المختارة = عقرب_ساعة
            # تقدم العقرب للمرة القادمة
            عقرب_ساعة = (عقرب_ساعة + 1) % عدد_صفحات_محملة
            ارجع المختارة
        نهاية

        # لا — نُقلل التقادم (خطوة واحدة يمين)
        متغير تقادم_محدث = تقادم >> 1
        كتابة_تقادم_ساعة(عقرب_ساعة، تقادم_محدث)

        # تقدم العقرب
        عقرب_ساعة = (عقرب_ساعة + 1) % عدد_صفحات_محملة
        محاولات = محاولات + 1
    نهاية

    # لم نجد — نأخذ الحالية بالقوة
    متغير إجبارية = عقرب_ساعة
    عقرب_ساعة = (عقرب_ساعة + 1) % عدد_صفحات_محملة
    ارجع إجبارية
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحديث بتات التقادم (Aging) — يُستدعى دورياً
# ═══════════════════════════════════════════════════════════════════════════════
#
# في كل "دقة ساعة":
# 1. لكل صفحة في القائمة:
#    - نقرأ بت الوصول (Accessed bit) من PTE
#    - نُزيح بتات التقادم يميناً بت واحد
#    - إذا كان بت الوصول مضبوطاً: نضع 1 في البت الأعلى
#    - نمسح بت الوصول في PTE

دالة تحديث_تقادم_صفحات()
    متغير م = 0
    بينما (م < عدد_صفحات_محملة)
        # قراءة العنوان الافتراضي للصفحة
        متغير عنوان_اف = قراءة_عنوان_ساعة(م)

        # في نظامنا المحاكي، نفترض أن PTE عند عنوان معين
        # نستخدم بت الوصول المخزن محلياً
        متغير تقادم_حالي = قراءة_تقادم_ساعة(م)

        # إزاحة يمين بت واحد (تقليل عمر المرجع)
        متغير تقادم_محدث = تقادم_حالي >> 1

        # نفترض أن الصفحة تم الوصول إليها إذا كانت في النصف الأعلى من القائمة
        # (في نظام حقيقي، نقرأ بت A من PTE)
        # لتبسيط المحاكاة: نضع بت المرجع بناء على قيمة التقادم السابقة
        إذا (تقادم_حالي > 0)
            تقادم_محدث = تقادم_محدث | 128   # ضبط البت الأعلى
        نهاية

        كتابة_تقادم_ساعة(م، تقادم_محدث)
        م = م + 1
    نهاية

    عداد_تقادم = عداد_تقادم + 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# استبدال صفحة كامل (إخراج + تخصيص)
# ═══════════════════════════════════════════════════════════════════════════════

# استبدال صفحة: اختيار ضحية، إخراجها، إرجاع إطارها
# تُستخدم عندما نحتاج إطار فيزيائي جديد ولا يوجد إطارات حرة
دالة استبدال_صفحة()
    # اختيار صفحة ضحية
    متغير فهرس_ضحية = اختيار_صفحة_للاستبدال()
    إذا (فهرس_ضحية == -1)
        kernel_print_string("  [تبديل] فشل استبدال — قائمة فارغة!")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # قراءة معلومات الضحية
    متغير عنوان_ضحية = قراءة_عنوان_ساعة(فهرس_ضحية)
    متغير إطار_ضحية = قراءة_إطار_ساعة(فهرس_ضحية)

    # إزالة الضحية من قائمة الساعة
    إزالة_من_قائمة_ساعة(فهرس_ضحية)

    عداد_استبدال = عداد_استبدال + 1

    # إرجاع عنوان الإطار المحرر
    ارجع إطار_ضحية
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# البحث في قائمة الساعة
# ═══════════════════════════════════════════════════════════════════════════════

# البحث عن صفحة بالعنوان الافتراضي
دالة بحث_في_قائمة_ساعة(عنوان_مطلوب)
    متغير م = 0
