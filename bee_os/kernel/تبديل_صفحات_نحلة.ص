متغير عداد_إخراج_صفحات = 0             # عدد مرات كتابة صفحة للقرص
متغير عداد_إدخال_صفحات = 0             # عدد مرات قراءة صفحة من القرص
متغير عداد_فحص_ساعة = 0               # عدد مرات دوران عقرب الساعة
متغير عداد_استبدال = 0                 # عدد مرات استبدال صفحة
متغير عداد_تقادم = 0                   # عدد مرات تحديث بتات التقادم
متغير عداد_تخصيص_فتحة = 0             # عدد مرات تخصيص فتحة
متغير عداد_تحرير_فتحة = 0             # عدد مرات تحرير فتحة
متغير عداد_صفحات_متسخة = 0            # عدد الصفحات المتسخة المكتوبة
متغير عداد_صفحات_نظيفة = 0            # عدد الصفحات النظيفة المُسقطة
متغير عداد_فشل_تخصيص = 0              # عدد مرات فشل التخصيص

# ═══════════════════════════════════════════════════════════════════════════════
# جدول تعيين الفتحات — ربط فتحة التبديل بالصفحة الافتراضية
# ═══════════════════════════════════════════════════════════════════════════════
# مصفوفتان متوازيتان:
# [فتحة_إلى_عنوان]: فتحة -> عنوان الصفحة الافتراضية
# [فتحة_إلى_عملية]: فتحة -> معرف العملية المالكة
متغير عنوان_فتحة_إلى_عنوان = 0
متغير عنوان_فتحة_إلى_عملية = 0

# ═══════════════════════════════════════════════════════════════════════════════
# إدارة فتحات التبديل
# ═══════════════════════════════════════════════════════════════════════════════

# تخصيص فتحة تبديل حرة
# تبحث في خريطة التبديل عن أول فتحة حرة
# تُرجع ترتيب الفتحة أو -1 عند الفشل
دالة تخصيص_فتحة()
    إذا (فتحات_حرة == 0)
        # لا توجد فتحات حرة
        عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
        ارجع -1
    نهاية

    # البحث بدءاً من أول فتحة حرة معروفة
    متغير م = أول_فتحة_حرة
    بينما (م < إجمالي_فتحات)
        متغير عنوان_علم = عنوان_خريطة_تبديل + (م * 4)
        متغير وضعية_فتحة = mem_read_dword(عنوان_علم)
        إذا (وضعية_فتحة == فتحة_حرة)
            # وجدنا فتحة حرة — نحجزها
            mem_write_dword(عنوان_علم، فتحة_مستخدمة)
            فتحات_مستخدمة = فتحات_مستخدمة + 1
            فتحات_حرة = فتحات_حرة - 1
            عداد_تخصيص_فتحة = عداد_تخصيص_فتحة + 1

            # تحديث أول فتحة حرة
            أول_فتحة_حرة = م + 1
            ارجع م
        نهاية
        م = م + 1
    نهاية

    # لم نجد — نبحث من البداية
    م = 0
    بينما (م < أول_فتحة_حرة)
        متغير عنوان_علم2 = عنوان_خريطة_تبديل + (م * 4)
        متغير وضعية_فتحة2 = mem_read_dword(عنوان_علم2)
        إذا (وضعية_فتحة2 == فتحة_حرة)
            mem_write_dword(عنوان_علم2، فتحة_مستخدمة)
            فتحات_مستخدمة = فتحات_مستخدمة + 1
            فتحات_حرة = فتحات_حرة - 1
            عداد_تخصيص_فتحة = عداد_تخصيص_فتحة + 1
            أول_فتحة_حرة = م + 1
            ارجع م
        نهاية
        م = م + 1
    نهاية

    # لم نجد فتحة حرة — هذا لا يجب أن يحدث إذا كان فتحات_حرة > 0
    عداد_فشل_تخصيص = عداد_فشل_تخصيص + 1
    ارجع -1
نهاية

# تحرير فتحة تبديل
دالة تحرير_فتحة(ترتيب_فتحة)
    إذا (ترتيب_فتحة < 0)
        ارجع 0
    نهاية
    إذا (ترتيب_فتحة >= إجمالي_فتحات)
        ارجع 0
    نهاية

    متغير عنوان_علم = عنوان_خريطة_تبديل + (ترتيب_فتحة * 4)
    متغير وضعية_حالية = mem_read_dword(عنوان_علم)

    # لا يمكن تحرير فتحة حرة بالفعل
    إذا (وضعية_حالية == فتحة_حرة)
        ارجع 0
    نهاية

    mem_write_dword(عنوان_علم، فتحة_حرة)
    فتحات_مستخدمة = فتحات_مستخدمة - 1
    فتحات_حرة = فتحات_حرة + 1
    عداد_تحرير_فتحة = عداد_تحرير_فتحة + 1

    # تحديث أول فتحة حرة إذا لزم
    إذا (ترتيب_فتحة < أول_فتحة_حرة)
        أول_فتحة_حرة = ترتيب_فتحة
    نهاية

    # مسح معلومات التعيين
    mem_write_dword(عنوان_فتحة_إلى_عنوان + (ترتيب_فتحة * 4)، 0)
    mem_write_dword(عنوان_فتحة_إلى_عملية + (ترتيب_فتحة * 4)، 0)

    ارجع 1
نهاية

# حساب عنوان بيانات الفتحة على "القرص" (الذاكرة المحاكية)
دالة حساب_عنوان_فتحة(ترتيب_فتحة)
    ارجع عنوان_بيانات_فتحات + (ترتيب_فتحة * ثابت_مقاس_صفحة)
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إخراج الصفحة (Page-Out) — كتابة صفحة إلى التبديل
# ═══════════════════════════════════════════════════════════════════════════════
#
# الخطوات:
# 1. تخصيص فتحة تبديل
# 2. نسخ محتوى الصفحة من الإطار الفيزيائي إلى فتحة التبديل
# 3. تحديث مدخلة جدول الصفحات (PTE):
#    - إزالة بت الحضور
#    - تخزين ترتيب فتحة التبديل في البتات المتاحة
# 4. إبطال TLB للصفحة
# 5. تحرير الإطار الفيزيائي

دالة إخراج_صفحة(عنوان_افتراضي، عنوان_إطار، عنوان_pte، معرف_عملية)
    # الخطوة 1: تخصيص فتحة تبديل
    متغير فتحة = تخصيص_فتحة()
    إذا (فتحة == -1)
        kernel_print_string("  [تبديل] فشل إخراج صفحة — لا فتحات حرة!")
        kernel_print_number(10)
        ارجع -1
    نهاية

    # الخطوة 2: قفل الفتحة أثناء الكتابة
    متغير عنوان_علم = عنوان_خريطة_تبديل + (فتحة * 4)
    mem_write_dword(عنوان_علم، فتحة_مقفلة)

    # الخطوة 3: نسخ الصفحة إلى فتحة التبديل
    متغير عنوان_فتحة_قرص = حساب_عنوان_فتحة(فتحة)
    sad_ll_memcpy(عنوان_فتحة_قرص، عنوان_إطار، ثابت_مقاس_صفحة)

    # الخطوة 4: تحديث PTE
    # نخزن ترتيب الفتحة في البتات 12-31 من PTE (بعد إزالة بت الحضور)
    # الصيغة: (ترتيب_الفتحة << 12) | 0 (بدون بت الحضور)
    متغير pte_تبديل = (فتحة << 12)
    mem_write_dword(عنوان_pte، pte_تبديل)

    # الخطوة 5: إبطال TLB لهذه الصفحة
    sad_ll_invlpg(عنوان_افتراضي)

    # الخطوة 6: رفع القفل عن الفتحة
    mem_write_dword(عنوان_علم، فتحة_مستخدمة)

    # الخطوة 7: تسجيل التعيين
    mem_write_dword(عنوان_فتحة_إلى_عنوان + (فتحة * 4)، عنوان_افتراضي)
    mem_write_dword(عنوان_فتحة_إلى_عملية + (فتحة * 4)، معرف_عملية)

    # تحديث الإحصائيات
    عداد_إخراج_صفحات = عداد_إخراج_صفحات + 1
    عداد_صفحات_متسخة = عداد_صفحات_متسخة + 1

    ارجع فتحة
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# إدخال الصفحة (Page-In) — قراءة صفحة من التبديل
# ═══════════════════════════════════════════════════════════════════════════════
#
# الخطوات:
# 1. استخراج ترتيب فتحة التبديل من PTE
# 2. تخصيص إطار فيزيائي جديد
# 3. نسخ البيانات من فتحة التبديل إلى الإطار
# 4. تحديث PTE (إعادة بت الحضور + عنوان الإطار الجديد)
# 5. تحرير فتحة التبديل

دالة إدخال_صفحة(عنوان_افتراضي، عنوان_pte)
    # الخطوة 1: قراءة PTE لاستخراج ترتيب الفتحة
    متغير pte_حالي = mem_read_dword(عنوان_pte)

    # فحص أن الصفحة فعلاً في التبديل (بت الحضور = 0)
    إذا ((pte_حالي & بت_pte_حاضر) != 0)
        # الصفحة حاضرة — لا حاجة لإدخال
        ارجع 0
    نهاية

    # استخراج ترتيب الفتحة من البتات 12-31
    متغير فتحة = (pte_حالي >> 12) & 1048575

    # فحص صحة ترتيب الفتحة
    إذا (فتحة >= إجمالي_فتحات)
        kernel_print_string("  [تبديل] عطل: ترتيب فتحة غير صالح = ")
        kernel_print_number(فتحة)
        kernel_print_number(10)
        ارجع 0
    نهاية

    # الخطوة 2: قفل الفتحة أثناء القراءة
    متغير عنوان_علم = عنوان_خريطة_تبديل + (فتحة * 4)
    mem_write_dword(عنوان_علم، فتحة_مقفلة)

    # الخطوة 3: تخصيص إطار فيزيائي جديد
    متغير إطار_فيزيائي = sad_ll_page_alloc()
    إذا (إطار_فيزيائي == 0)
        # فشل التخصيص — نحتاج استبدال صفحة أخرى أولاً
        mem_write_dword(عنوان_علم، فتحة_مستخدمة)
        kernel_print_string("  [تبديل] فشل إدخال — لا إطارات حرة!")
        kernel_print_number(10)
        ارجع 0
    نهاية

    # الخطوة 4: نسخ البيانات من التبديل إلى الإطار الجديد
    متغير عنوان_فتحة_قرص = حساب_عنوان_فتحة(فتحة)
    sad_ll_memcpy(إطار_فيزيائي، عنوان_فتحة_قرص، ثابت_مقاس_صفحة)

    # الخطوة 5: تحديث PTE — صفحة حاضرة + عنوان الإطار
    # PTE = (عنوان_الإطار & ~0xFFF) | أعلام
    متغير pte_محدث = (إطار_فيزيائي & (~4095)) | بت_pte_حاضر | بت_pte_كتابة | بت_pte_مستخدم
    mem_write_dword(عنوان_pte، pte_محدث)

    # الخطوة 6: تحرير فتحة التبديل
    تحرير_فتحة(فتحة)

    # الخطوة 7: إبطال TLB
    sad_ll_invlpg(عنوان_افتراضي)

    # إضافة الصفحة لقائمة الساعة
    إضافة_لقائمة_ساعة(عنوان_افتراضي، إطار_فيزيائي)

    # تحديث الإحصائيات
    عداد_إدخال_صفحات = عداد_إدخال_صفحات + 1

    ارجع إطار_فيزيائي
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# قائمة الساعة (Clock List) — خوارزمية استبدال الصفحات
# ═══════════════════════════════════════════════════════════════════════════════

# إضافة صفحة لقائمة الساعة
دالة إضافة_لقائمة_ساعة(عنوان_افتراضي، عنوان_إطار)
    إذا (عدد_صفحات_محملة >= ثابت_اقصى_صفحات_محملة)
        # القائمة ممتلئة — لا يمكن الإضافة (قد نحتاج استبدال أولاً)
        ارجع 0
    نهاية

    # حساب عنوان المدخلة الجديدة
    متغير إزاحة = عدد_صفحات_محملة * ثابت_مقاس_مدخلة_ساعة

    # كتابة المدخلة: [عنوان_افتراضي، عنوان_إطار، بتات_تقادم]
    mem_write_dword(عنوان_قائمة_ساعة + إزاحة، عنوان_افتراضي)
    mem_write_dword(عنوان_قائمة_ساعة + إزاحة + 4، عنوان_إطار)
    mem_write_dword(عنوان_قائمة_ساعة + إزاحة + 8، ثابت_بتات_تقادم_ابتدائية)

    عدد_صفحات_محملة = عدد_صفحات_محملة + 1
    ارجع 1
نهاية

# إزالة صفحة من قائمة الساعة بالفهرس
دالة إزالة_من_قائمة_ساعة(فهرس)
    إذا (فهرس >= عدد_صفحات_محملة)
        ارجع 0
    نهاية

    # نقل المدخلة الأخيرة إلى موقع المُزالة (Swap with last)
    إذا (فهرس < عدد_صفحات_محملة - 1)
        متغير إزاحة_هدف = فهرس * ثابت_مقاس_مدخلة_ساعة
        متغير إزاحة_أخير = (عدد_صفحات_محملة - 1) * ثابت_مقاس_مدخلة_ساعة

        # نسخ المدخلة الأخيرة
        متغير ع0 = mem_read_dword(عنوان_قائمة_ساعة + إزاحة_أخير)
        متغير ع1 = mem_read_dword(عنوان_قائمة_ساعة + إزاحة_أخير + 4)
        متغير ع2 = mem_read_dword(عنوان_قائمة_ساعة + إزاحة_أخير + 8)

        mem_write_dword(عنوان_قائمة_ساعة + إزاحة_هدف، ع0)
        mem_write_dword(عنوان_قائمة_ساعة + إزاحة_هدف + 4، ع1)
        mem_write_dword(عنوان_قائمة_ساعة + إزاحة_هدف + 8، ع2)
    نهاية

    عدد_صفحات_محملة = عدد_صفحات_محملة - 1

    # ضبط عقرب الساعة
    إذا (عقرب_ساعة >= عدد_صفحات_محملة)
        عقرب_ساعة = 0
    نهاية

    ارجع 1
نهاية

# قراءة عنوان الصفحة الافتراضي من مدخلة الساعة
دالة قراءة_عنوان_ساعة(فهرس)
