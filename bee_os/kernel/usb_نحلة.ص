# ═══════════════════════════════════════════════════════════════════════════════
# اكتشاف المتحكمات USB من PCI
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة usb_detect_controllers()
    usb_serial_اطبع("[USB] Detecting USB controllers...")
    usb_serial_سطر()

    متغير search = 0 + 0
    بينما (search < USB_MAX_CONTROLLERS)
        متغير pci_idx = pci_find_usb_controller(search + 0) + 0
        إذا (pci_idx < 0)
            search = USB_MAX_CONTROLLERS  # انتهى
        والا
            متغير hc_idx = usb_hc_count + 0
            إذا (hc_idx < USB_MAX_CONTROLLERS)
                متغير usb_type = pci_get_usb_type(pci_idx + 0) + 0
                متغير bar0 = pci_get_bar0(pci_idx + 0) + 0
                متغير irq = pci_get_irq(pci_idx + 0) + 0
                متغير base_addr = pci_bar_address(bar0 + 0) + 0

                usb_set_hc_type(hc_idx، usb_type)
                usb_set_hc_base(hc_idx، base_addr)

                إذا (hc_idx == 0) hc_irq_0 = irq + 0 نهاية
                إذا (hc_idx == 1) hc_irq_1 = irq + 0 نهاية
                إذا (hc_idx == 2) hc_irq_2 = irq + 0 نهاية
                إذا (hc_idx == 3) hc_irq_3 = irq + 0 نهاية

                إذا (hc_idx == 0) hc_pci_idx_0 = pci_idx + 0 نهاية
                إذا (hc_idx == 1) hc_pci_idx_1 = pci_idx + 0 نهاية
                إذا (hc_idx == 2) hc_pci_idx_2 = pci_idx + 0 نهاية
                إذا (hc_idx == 3) hc_pci_idx_3 = pci_idx + 0 نهاية

                # تفعيل Bus Master
                متغير bus = pci_loc_bus(pci_idx + 0) + 0
                متغير dev = pci_loc_dev(pci_idx + 0) + 0
                متغير func = pci_loc_func(pci_idx + 0) + 0
                pci_enable_bus_master(bus + 0، dev + 0، func + 0)

                usb_hc_count = usb_hc_count + 1

                usb_serial_اطبع("[USB] HC #")
                usb_serial_رقم(hc_idx + 0)
                usb_serial_اطبع(" type=")
                إذا (usb_type == USB_HC_UHCI)
                    usb_serial_اطبع("UHCI")
                والا_اذا (usb_type == USB_HC_OHCI)
                    usb_serial_اطبع("OHCI")
                والا_اذا (usb_type == USB_HC_EHCI)
                    usb_serial_اطبع("EHCI")
                والا_اذا (usb_type == USB_HC_XHCI)
                    usb_serial_اطبع("XHCI")
                والا
                    usb_serial_اطبع("Unknown")
                نهاية
                usb_serial_اطبع(" base=0x")
                usb_serial_hex16(base_addr / 65536)
                usb_serial_hex16(base_addr % 65536)
                usb_serial_اطبع(" IRQ=")
                usb_serial_رقم(irq + 0)
                usb_serial_سطر()
            نهاية
            search = search + 1
        نهاية
    نهاية

    usb_serial_اطبع("[USB] Found ")
    usb_serial_رقم(usb_hc_count + 0)
    usb_serial_اطبع(" USB controller(s)")
    usb_serial_سطر()
    ارجع usb_hc_count + 0
نهاية

