# ═══════════════════════════════════════════════════════════════════════════════
# تحليل واصفة الجهاز (18 بايت)
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة usb_parse_device_descriptor(buf، dev_idx)
    # byte 0: bLength
    # byte 1: bDescriptorType (should be 1)
    متغير desc_type = sad_ll_mem_read8(buf + 1) + 0
    إذا (desc_type != USB_DESC_DEVICE)
        ارجع 0
    نهاية

    # byte 4: bDeviceClass
    متغير dev_class = sad_ll_mem_read8(buf + 4) + 0
    # byte 5: bDeviceSubClass
    متغير dev_subclass = sad_ll_mem_read8(buf + 5) + 0
    # byte 6: bDeviceProtocol
    متغير dev_protocol = sad_ll_mem_read8(buf + 6) + 0
    # byte 7: bMaxPacketSize0
    متغير max_pkt = sad_ll_mem_read8(buf + 7) + 0

    # byte 8-9: idVendor (little-endian)
    متغير vid_lo = sad_ll_mem_read8(buf + 8) + 0
    متغير vid_hi = sad_ll_mem_read8(buf + 9) + 0
    متغير vid = vid_hi * 256 + vid_lo

    # byte 10-11: idProduct
    متغير pid_lo = sad_ll_mem_read8(buf + 10) + 0
    متغير pid_hi = sad_ll_mem_read8(buf + 11) + 0
    متغير pid = pid_hi * 256 + pid_lo

    # byte 17: bNumConfigurations
    متغير num_configs = sad_ll_mem_read8(buf + 17) + 0

    # تخزين المعلومات
    usb_set_class(dev_idx، dev_class * 256 + dev_subclass)
    usb_set_proto(dev_idx، dev_protocol)
    usb_set_maxpkt(dev_idx، max_pkt)
    usb_set_vid(dev_idx، vid)

    usb_serial_اطبع("[USB] Device Desc: VID=0x")
    usb_serial_hex16(vid + 0)
    usb_serial_اطبع(" PID=0x")
    usb_serial_hex16(pid + 0)
    usb_serial_اطبع(" Class=")
    usb_serial_hex8(dev_class + 0)
    sad_ll_serial_write_char(COM1، 58)
    usb_serial_hex8(dev_subclass + 0)
    usb_serial_اطبع(" MaxPkt=")
    usb_serial_رقم(max_pkt + 0)
    usb_serial_سطر()

    ارجع 1
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
# تحليل واصفة التكوين
# ═══════════════════════════════════════════════════════════════════════════════
صدّر دالة usb_parse_config_descriptor(buf، total_len، dev_idx)
    متغير pos = 0 + 0
    متغير iface_class = 0 + 0
    متغير iface_sub = 0 + 0
    متغير iface_proto = 0 + 0
    متغير ep_count = 0 + 0

    بينما (pos < total_len)
        متغير bLength = sad_ll_mem_read8(buf + pos) + 0
        إذا (bLength == 0)
            ارجع ep_count + 0
        نهاية

        متغير bDescType = sad_ll_mem_read8(buf + pos + 1) + 0

        # واصفة الواجهة
        إذا (bDescType == USB_DESC_INTERFACE)
            iface_class = sad_ll_mem_read8(buf + pos + 5) + 0
            iface_sub = sad_ll_mem_read8(buf + pos + 6) + 0
            iface_proto = sad_ll_mem_read8(buf + pos + 7) + 0

            # تحديث صنف الجهاز إذا كان 0 في واصفة الجهاز
            متغير cur_class = usb_get_class(dev_idx) + 0
            إذا (cur_class == 0)
                usb_set_class(dev_idx، iface_class * 256 + iface_sub)
                usb_set_proto(dev_idx، iface_proto)
            نهاية

            usb_serial_اطبع("[USB]   Interface: class=")
            usb_serial_hex8(iface_class + 0)
            sad_ll_serial_write_char(COM1، 58)
            usb_serial_hex8(iface_sub + 0)
            sad_ll_serial_write_char(COM1، 58)
            usb_serial_hex8(iface_proto + 0)
            usb_serial_سطر()
        نهاية

        # واصفة نقطة النهاية
        إذا (bDescType == USB_DESC_ENDPOINT)
            متغير ep_addr = sad_ll_mem_read8(buf + pos + 2) + 0
            متغير ep_attr = sad_ll_mem_read8(buf + pos + 3) + 0
            متغير ep_maxpkt_lo = sad_ll_mem_read8(buf + pos + 4) + 0
            متغير ep_maxpkt_hi = sad_ll_mem_read8(buf + pos + 5) + 0
            متغير ep_interval = sad_ll_mem_read8(buf + pos + 6) + 0
            متغير ep_type = ep_attr % 4

            usb_serial_اطبع("[USB]   EP 0x")
            usb_serial_hex8(ep_addr + 0)
            usb_serial_اطبع(" type=")
            إذا (ep_type == USB_EP_CONTROL)
                usb_serial_اطبع("CTRL")
            نهاية
            إذا (ep_type == USB_EP_BULK)
                usb_serial_اطبع("BULK")
            نهاية
            إذا (ep_type == USB_EP_INTERRUPT)
                usb_serial_اطبع("INTR")
            نهاية
            إذا (ep_type == USB_EP_ISOCHRONOUS)
                usb_serial_اطبع("ISOC")
            نهاية
            usb_serial_اطبع(" maxpkt=")
            usb_serial_رقم(ep_maxpkt_hi * 256 + ep_maxpkt_lo)
            usb_serial_سطر()

            ep_count = ep_count + 1
        نهاية

        pos = pos + bLength
    نهاية

    ارجع ep_count + 0
نهاية

