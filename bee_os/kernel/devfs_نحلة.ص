# ══════════════════════════════════════════════

#* ── /dev/zero ──
   القراءة: ترجع أصفار لا نهائية
   الكتابة: تُهمل (كـ /dev/null)
*#
صدّر دالة ديفافس_اقرأ_zero(مخزن، مقاس_ب)
    # نملأ المخزن بأصفار
    متغير ع = 0
    بينما (ع < مقاس_ب)
        mem_write_byte(مخزن + ع، 0)
        ع = ع + 1
    نهاية
    ارجع مقاس_ب
نهاية

