#* ── /dev/kmsg ──
   القراءة: ترجع آخر رسائل النواة
   الكتابة: تضيف رسالة إلى سجل النواة
   
   نحتفظ بمخزن حلقي بسيط (ring buffer)
   سعة 16 رسالة، كل رسالة مؤشر لنص
*#
متغير kmsg_مخزن_0 = 0
متغير kmsg_مخزن_1 = 0
متغير kmsg_مخزن_2 = 0
متغير kmsg_مخزن_3 = 0
متغير kmsg_مخزن_4 = 0
متغير kmsg_مخزن_5 = 0
متغير kmsg_مخزن_6 = 0
متغير kmsg_مخزن_7 = 0
متغير kmsg_رأس = 0
متغير kmsg_عدد = 0

صدّر دالة ديفافس_اكتب_kmsg(رسالة)
    متغير موقع = kmsg_رأس + 0
    إذا (موقع == 0)
        kmsg_مخزن_0 = رسالة
    نهاية
    إذا (موقع == 1)
        kmsg_مخزن_1 = رسالة
    نهاية
    إذا (موقع == 2)
        kmsg_مخزن_2 = رسالة
    نهاية
    إذا (موقع == 3)
        kmsg_مخزن_3 = رسالة
    نهاية
    إذا (موقع == 4)
        kmsg_مخزن_4 = رسالة
    نهاية
    إذا (موقع == 5)
        kmsg_مخزن_5 = رسالة
    نهاية
    إذا (موقع == 6)
        kmsg_مخزن_6 = رسالة
    نهاية
    إذا (موقع == 7)
        kmsg_مخزن_7 = رسالة
    نهاية
    
    kmsg_رأس = kmsg_رأس + 1
    إذا (kmsg_رأس >= 8)
        kmsg_رأس = 0
    نهاية
    إذا (kmsg_عدد < 8)
        kmsg_عدد = kmsg_عدد + 1
    نهاية
    ارجع 0
نهاية

