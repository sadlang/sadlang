#* ── مولد خطي تطابقي (Linear Congruential Generator) ──
   الخوارزمية: seed = (seed * 1103515245 + 12345) mod 2^31
   هذا مولد بسيط مناسب للنواة
*#
متغير عشوائي_بذرة = 12345678

صدّر دالة عشوائي_بذر(بذرة_ج)
    عشوائي_بذرة = بذرة_ج
    ارجع 0
نهاية

صدّر دالة عشوائي_التالي()
    # LCG: seed = (seed * 1103515245 + 12345)
    # نستخدم تبسيط لتجنب الفيضان العددي
    متغير أ = عشوائي_بذرة * 1103
    أ = أ + 515245
    أ = أ + 12345
    إذا (أ < 0)
        أ = 0 - أ
    نهاية
    عشوائي_بذرة = أ
    ارجع أ
نهاية

