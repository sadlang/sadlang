# القسم 6: عمليات /dev/random
# ══════════════════════════════════════════════

#* ── /dev/random ──
   القراءة: ترجع بايتات عشوائية
   تستخدم PRNG الداخلي
*#
صدّر دالة ديفافس_اقرأ_random(مخزن، مقاس_ب)
    متغير ع = 0
    بينما (ع < مقاس_ب)
        متغير قيمة_ع = عشوائي_التالي()
        # نأخذ البايت الأدنى فقط
        متغير بايت_ع = قيمة_ع - ((قيمة_ع / 256) * 256)
        إذا (بايت_ع < 0)
            بايت_ع = 0 - بايت_ع
        نهاية
        mem_write_byte(مخزن + ع، بايت_ع)
        ع = ع + 1
    نهاية
    ارجع مقاس_ب
نهاية

