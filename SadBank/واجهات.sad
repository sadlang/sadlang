# ===================================================================
# دوال مساعدة مركبة (Flutter-like)
# ===================================================================

# بطاقة نص مع عنوان ومحتوى
صدّر دالة بطاقة_نص(title, body)
    متغير c = بطاقة({"حشوة": 12, "حدود": 8})
    متغير col = عمود({"تباعد": 6})
    متغير h = نص({"محتوى": title, "حجم": 22, "لون": "#212121", "محاذاة": "left"})
    متغير p = نص({"محتوى": body, "حجم": 16, "لون": "#646464", "محاذاة": "left"})
    اضف(col, h)
    اضف(col, p)
    اضف(c, col)
    ارجع c
نهاية

# زر ملون مخصص
صدّر دالة زر_ملون(txt, color)
    ارجع زر({"نص": txt, "لون_زر": color, "حدود": 8})
نهاية

# صف من الأزرار
صدّر دالة صف_ازرار(b1, b2, b3, b4)
    متغير row = صف({"تباعد": 4})
    اضف(row, b1)
    اضف(row, b2)
    اضف(row, b3)
    اضف(row, b4)
    ارجع row
نهاية

# حقل إدخال مع تسمية
صدّر دالة حقل_مع_تسمية(lbl, hint)
    متغير col = عمود({"تباعد": 4})
    متغير l = نص({"محتوى": lbl, "حجم": 14, "لون": "#505050", "محاذاة": "left"})
    اضف(col, l)
    متغير f = حقل({"تلميح": hint})
    اضف(col, f)
    ارجع f
نهاية

# رأس تطبيق ملون
صدّر دالة راس_تطبيق(title, color)
    ارجع شريط_تطبيق({"محتوى": title, "خلفية": color, "لون": "#FFFFFF"})
نهاية

# شريط حالة ملون
صدّر دالة شريط_حالة_ملون(txt, color)
    ارجع مكون("شريط_حالة", {"محتوى": txt, "خلفية": color, "لون": "#FFFFFF"})
نهاية

# فاصل مسافة
صدّر دالة مسافة(size)
    ارجع مكون("فاصل", {"ارتفاع": size})
نهاية

# خط فاصل
صدّر دالة خط()
    ارجع مكون("خط_فاصل", {})
نهاية
