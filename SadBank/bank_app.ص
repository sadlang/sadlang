# ===================================================================
# الصفحة 0: تسجيل الدخول
# ===================================================================
دالة بناء_صفحة_تسجيل_دخول()
    متغير الجذر = عمود({"تباعد": 0, "حشوة": 0})

    # شريط علوي
    متغير الشريط = مكون("شريط_تطبيق", {"محتوى": "Sad Bank - مصرف سعد", "خلفية": "#1565C0", "لون": "#FFFFFF"})
    اضف(الجذر, الشريط)

    # مسافة
    متغير م1 = مكون("فاصل", {"ارتفاع": 60})
    اضف(الجذر, م1)

    # مركز تسجيل الدخول
    متغير مركز = توسيط({"حشوة": 20})
    متغير عمود_وسط = عمود({"تباعد": 16, "حشوة": 30})

    # بطاقة تسجيل الدخول
    متغير بطاقة_دخول = بطاقة({"حشوة": 30, "حدود": 16, "خلفية": "#FFFFFF"})
    متغير عمود_بطاقة = عمود({"تباعد": 18})

    # أيقونة البنك
    متغير ايقونة_بنك = مكون("صورة_رمزية", {"محتوى": "B", "خلفية": "#1565C0", "حجم": 28})
    اضف(عمود_بطاقة, ايقونة_بنك)

    # عنوان
    متغير عنوان1 = نص({"محتوى": "Welcome to Sad Bank", "حجم": 28, "لون": "#1565C0", "محاذاة": "center"})
    اضف(عمود_بطاقة, عنوان1)

    متغير عنوان2 = نص({"محتوى": "Sign in to your account", "حجم": 15, "لون": "#78909C", "محاذاة": "center"})
    اضف(عمود_بطاقة, عنوان2)

    متغير م2 = مكون("فاصل", {"ارتفاع": 8})
    اضف(عمود_بطاقة, م2)

    # حقل اسم المستخدم
    متغير تسمية_مستخدم = نص({"محتوى": "Username", "حجم": 13, "لون": "#546E7A", "محاذاة": "left"})
    اضف(عمود_بطاقة, تسمية_مستخدم)
    متغير حقل_مستخدم = حقل({"تلميح": "Enter your username"})
    اضف(عمود_بطاقة, حقل_مستخدم)

    # حقل كلمة المرور
    متغير تسمية_مرور = نص({"محتوى": "Password", "حجم": 13, "لون": "#546E7A", "محاذاة": "left"})
    اضف(عمود_بطاقة, تسمية_مرور)
    متغير حقل_مرور = حقل({"تلميح": "Enter your password"})
    اضف(عمود_بطاقة, حقل_مرور)

    متغير م3 = مكون("فاصل", {"ارتفاع": 6})
    اضف(عمود_بطاقة, م3)

    # زر تسجيل الدخول
    متغير زر_دخول = زر({"نص": "Sign In", "لون_زر": "#1565C0", "حدود": 10})
    اضف(عمود_بطاقة, زر_دخول)

    # رسالة خطأ (مخفية مبدئياً)
    متغير رسالة_خطأ = نص({"محتوى": "", "حجم": 13, "لون": "#E53935", "محاذاة": "center"})
    اضف(عمود_بطاقة, رسالة_خطأ)

    متغير م4 = مكون("خط_فاصل", {})
    اضف(عمود_بطاقة, م4)

    # زر إنشاء حساب جديد
    متغير زر_حساب_جديد = زر({"نص": "Create New Account", "لون_زر": "#43A047", "حدود": 10})
    اضف(عمود_بطاقة, زر_حساب_جديد)

    اضف(بطاقة_دخول, عمود_بطاقة)
    اضف(عمود_وسط, بطاقة_دخول)
    اضف(مركز, عمود_وسط)
    اضف(الجذر, مركز)

    # شريط حالة
    متغير شريط_ح = مكون("شريط_حالة", {"محتوى": "Sad Bank v2.0 - Secure Banking System", "خلفية": "#263238", "لون": "#B0BEC5"})
    اضف(الجذر, شريط_ح)

    عرض(app, الجذر)
    ارجع [زر_دخول, زر_حساب_جديد, حقل_مستخدم, حقل_مرور, رسالة_خطأ]
