دالة بناء_صفحة_انشاء_حساب()
    متغير الجذر = عمود({"تباعد": 0, "حشوة": 0})

    متغير الشريط = مكون("شريط_تطبيق", {"محتوى": "Sad Bank - New Account", "خلفية": "#00897B", "لون": "#FFFFFF"})
    اضف(الجذر, الشريط)

    متغير م1 = مكون("فاصل", {"ارتفاع": 15})
    اضف(الجذر, م1)

    متغير عمود_محتوى = عمود({"تباعد": 14, "حشوة": 25})

    متغير عنوان_صفحة = نص({"محتوى": "Create New Customer Account", "حجم": 24, "لون": "#00897B", "محاذاة": "center"})
    اضف(عمود_محتوى, عنوان_صفحة)

    متغير وصف_صفحة = نص({"محتوى": "Fill in the information below to create a new bank account", "حجم": 13, "لون": "#78909C", "محاذاة": "center"})
