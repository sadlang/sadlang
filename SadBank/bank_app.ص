دالة بناء_القائمة_الرئيسية()
    متغير الجذر = عمود({"تباعد": 0, "حشوة": 0})

    # شريط علوي
    متغير الشريط = مكون("شريط_تطبيق", {"محتوى": "Sad Bank - Main Menu", "خلفية": "#1565C0", "لون": "#FFFFFF"})
    اضف(الجذر, الشريط)

    # معلومات المستخدم
