    # شريط الحالة
    متغير شريط_ح = مكون("شريط_حالة", {"محتوى": "Secure Form | All fields are required", "خلفية": "#263238", "لون": "#B0BEC5"})
    اضف(الجذر, شريط_ح)

    عرض(app, الجذر)
    ارجع [زر_انشاء, زر_رجوع, حقل_اسم, حقل_بريد, حقل_هاتف, حقل_كلمة, حقل_رصيد, رسالة]
