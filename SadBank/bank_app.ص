    متغير نص_ترحيب = نص({"محتوى": "Welcome, " + المستخدم_الحالي, "حجم": 16, "لون": "#1565C0"})
    اضف(شريط_مستخدم, نص_ترحيب)
    اضف(الجذر, شريط_مستخدم)

    # بطاقة الرصيد
    متغير م1 = مكون("فاصل", {"ارتفاع": 15})
    اضف(الجذر, م1)

    متغير عمود_محتوى = عمود({"تباعد": 15, "حشوة": 20})

    متغير بطاقة_رصيد = بطاقة({"حشوة": 20, "حدود": 12, "خلفية": "#1565C0"})
    متغير عمود_رصيد = عمود({"تباعد": 8})
    متغير عنوان_رصيد = نص({"محتوى": "Account Balance", "حجم": 14, "لون": "#B3E5FC"})
    اضف(عمود_رصيد, عنوان_رصيد)
    متغير قيمة_رصيد = نص({"محتوى": "$" + لنص(الرصيد_الحالي) + ".00", "حجم": 36, "لون": "#FFFFFF"})
    اضف(عمود_رصيد, قيمة_رصيد)
    متغير حالة_ح = نص({"محتوى": "Account: Active | Type: Premium", "حجم": 12, "لون": "#81D4FA"})
    اضف(عمود_رصيد, حالة_ح)
    اضف(بطاقة_رصيد, عمود_رصيد)
    اضف(عمود_محتوى, بطاقة_رصيد)

    # شبكة الخدمات
    متغير عنوان_خدمات = نص({"محتوى": "Banking Services", "حجم": 20, "لون": "#37474F", "محاذاة": "left"})
    اضف(عمود_محتوى, عنوان_خدمات)

    # صف أول من الأزرار
    متغير صف1 = صف({"تباعد": 12})

    متغير بطاقة1 = بطاقة({"حشوة": 18, "حدود": 12, "خلفية": "#FFFFFF"})
    متغير عمود_ب1 = عمود({"تباعد": 8})
    متغير ايقونة1 = مكون("صورة_رمزية", {"محتوى": "$", "خلفية": "#43A047", "حجم": 16})
    اضف(عمود_ب1, ايقونة1)
    متغير زر_ادارة = زر({"نص": "Manage Account", "لون_زر": "#43A047", "حدود": 8})
    اضف(عمود_ب1, زر_ادارة)
    متغير وصف1 = نص({"محتوى": "Deposit & Withdraw", "حجم": 11, "لون": "#78909C"})
    اضف(عمود_ب1, وصف1)
    اضف(بطاقة1, عمود_ب1)
    اضف(صف1, بطاقة1)

    متغير بطاقة2 = بطاقة({"حشوة": 18, "حدود": 12, "خلفية": "#FFFFFF"})
    متغير عمود_ب2 = عمود({"تباعد": 8})
    متغير ايقونة2 = مكون("صورة_رمزية", {"محتوى": "T", "خلفية": "#1E88E5", "حجم": 16})
    اضف(عمود_ب2, ايقونة2)
    متغير زر_تحويل = زر({"نص": "Transfer Money", "لون_زر": "#1E88E5", "حدود": 8})
    اضف(عمود_ب2, زر_تحويل)
    متغير وصف2 = نص({"محتوى": "Send to others", "حجم": 11, "لون": "#78909C"})
    اضف(عمود_ب2, وصف2)
    اضف(بطاقة2, عمود_ب2)
    اضف(صف1, بطاقة2)

    اضف(عمود_محتوى, صف1)

    # صف ثاني
    متغير صف2 = صف({"تباعد": 12})

    متغير بطاقة3 = بطاقة({"حشوة": 18, "حدود": 12, "خلفية": "#FFFFFF"})
    متغير عمود_ب3 = عمود({"تباعد": 8})
    متغير ايقونة3 = مكون("صورة_رمزية", {"محتوى": "C", "خلفية": "#F57C00", "حجم": 16})
    اضف(عمود_ب3, ايقونة3)
    متغير زر_زبائن = زر({"نص": "View Customers", "لون_زر": "#F57C00", "حدود": 8})
    اضف(عمود_ب3, زر_زبائن)
    متغير وصف3 = نص({"محتوى": "Customer database", "حجم": 11, "لون": "#78909C"})
    اضف(عمود_ب3, وصف3)
    اضف(بطاقة3, عمود_ب3)
    اضف(صف2, بطاقة3)

    متغير بطاقة4 = بطاقة({"حشوة": 18, "حدود": 12, "خلفية": "#FFFFFF"})
    متغير عمود_ب4 = عمود({"تباعد": 8})
    متغير ايقونة4 = مكون("صورة_رمزية", {"محتوى": "H", "خلفية": "#8E24AA", "حجم": 16})
    اضف(عمود_ب4, ايقونة4)
    متغير زر_سجل = زر({"نص": "Transaction Log", "لون_زر": "#8E24AA", "حدود": 8})
    اضف(عمود_ب4, زر_سجل)
    متغير وصف4 = نص({"محتوى": "View history", "حجم": 11, "لون": "#78909C"})
    اضف(عمود_ب4, وصف4)
    اضف(بطاقة4, عمود_ب4)
    اضف(صف2, بطاقة4)

    اضف(عمود_محتوى, صف2)

    # صف ثالث - حساب جديد وتسجيل خروج
    متغير صف3 = صف({"تباعد": 12})

    متغير بطاقة5 = بطاقة({"حشوة": 18, "حدود": 12, "خلفية": "#FFFFFF"})
    متغير عمود_ب5 = عمود({"تباعد": 8})
    متغير ايقونة5 = مكون("صورة_رمزية", {"محتوى": "+", "خلفية": "#00897B", "حجم": 16})
    اضف(عمود_ب5, ايقونة5)
    متغير زر_حساب_جديد = زر({"نص": "New Customer", "لون_زر": "#00897B", "حدود": 8})
    اضف(عمود_ب5, زر_حساب_جديد)
    متغير وصف5 = نص({"محتوى": "Create account", "حجم": 11, "لون": "#78909C"})
    اضف(عمود_ب5, وصف5)
    اضف(بطاقة5, عمود_ب5)
    اضف(صف3, بطاقة5)

    متغير بطاقة6 = بطاقة({"حشوة": 18, "حدود": 12, "خلفية": "#FFFFFF"})
    متغير عمود_ب6 = عمود({"تباعد": 8})
    متغير ايقونة6 = مكون("صورة_رمزية", {"محتوى": "X", "خلفية": "#E53935", "حجم": 16})
    اضف(عمود_ب6, ايقونة6)
    متغير زر_خروج = زر({"نص": "Sign Out", "لون_زر": "#E53935", "حدود": 8})
    اضف(عمود_ب6, زر_خروج)
    متغير وصف6 = نص({"محتوى": "Logout", "حجم": 11, "لون": "#78909C"})
    اضف(عمود_ب6, وصف6)
    اضف(بطاقة6, عمود_ب6)
    اضف(صف3, بطاقة6)

    اضف(عمود_محتوى, صف3)
    اضف(الجذر, عمود_محتوى)

    # شريط الحالة
    متغير شريط_ح = مكون("شريط_حالة", {"محتوى": "Sad Bank v2.0 | Secure Connection | Session Active", "خلفية": "#263238", "لون": "#B0BEC5"})
    اضف(الجذر, شريط_ح)

    عرض(app, الجذر)
    ارجع [زر_ادارة, زر_تحويل, زر_زبائن, زر_سجل, زر_حساب_جديد, زر_خروج]
