    متغير بطاقة_نموذج = بطاقة({"حشوة": 24, "حدود": 12, "خلفية": "#FFFFFF"})
    متغير عمود_نموذج = عمود({"تباعد": 12})

    # المعلومات الشخصية
    متغير عنوان_شخصي = نص({"محتوى": "Personal Information", "حجم": 18, "لون": "#00897B"})
    اضف(عمود_نموذج, عنوان_شخصي)

    متغير خط1 = مكون("خط_فاصل", {})
    اضف(عمود_نموذج, خط1)

    # الاسم الكامل
    متغير تسمية_اسم = نص({"محتوى": "Full Name", "حجم": 13, "لون": "#546E7A"})
    اضف(عمود_نموذج, تسمية_اسم)
    متغير حقل_اسم = حقل({"تلميح": "Enter full name"})
    اضف(عمود_نموذج, حقل_اسم)

    # البريد الإلكتروني
    متغير تسمية_بريد = نص({"محتوى": "Email Address", "حجم": 13, "لون": "#546E7A"})
    اضف(عمود_نموذج, تسمية_بريد)
    متغير حقل_بريد = حقل({"تلميح": "example@email.com"})
    اضف(عمود_نموذج, حقل_بريد)

    # رقم الهاتف
    متغير تسمية_هاتف = نص({"محتوى": "Phone Number", "حجم": 13, "لون": "#546E7A"})
    اضف(عمود_نموذج, تسمية_هاتف)
    متغير حقل_هاتف = حقل({"تلميح": "+1 (555) 000-0000"})
    اضف(عمود_نموذج, حقل_هاتف)

    # معلومات الحساب
    متغير م2 = مكون("فاصل", {"ارتفاع": 5})
    اضف(عمود_نموذج, م2)
    متغير عنوان_حساب = نص({"محتوى": "Account Details", "حجم": 18, "لون": "#00897B"})
    اضف(عمود_نموذج, عنوان_حساب)
    متغير خط2 = مكون("خط_فاصل", {})
    اضف(عمود_نموذج, خط2)

    # كلمة المرور
    متغير تسمية_كلمة = نص({"محتوى": "Password", "حجم": 13, "لون": "#546E7A"})
    اضف(عمود_نموذج, تسمية_كلمة)
    متغير حقل_كلمة = حقل({"تلميح": "Choose a strong password"})
    اضف(عمود_نموذج, حقل_كلمة)

    # الرصيد الافتتاحي
    متغير تسمية_رصيد = نص({"محتوى": "Initial Deposit ($)", "حجم": 13, "لون": "#546E7A"})
    اضف(عمود_نموذج, تسمية_رصيد)
    متغير حقل_رصيد = حقل({"تلميح": "Minimum: $100"})
    اضف(عمود_نموذج, حقل_رصيد)

    متغير م3 = مكون("فاصل", {"ارتفاع": 8})
    اضف(عمود_نموذج, م3)

    # أزرار
    متغير صف_ازرار = صف({"تباعد": 12})
    متغير زر_انشاء = زر({"نص": "Create Account", "لون_زر": "#00897B", "حدود": 10})
    اضف(صف_ازرار, زر_انشاء)
    متغير زر_رجوع = زر({"نص": "Back to Menu", "لون_زر": "#78909C", "حدود": 10})
    اضف(صف_ازرار, زر_رجوع)
