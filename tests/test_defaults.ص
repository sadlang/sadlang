# اختبار 1 - دالة مع قيم افتراضية
دالة تحية(اسم = "عالم")
    ارجع "مرحبا " + اسم
نهاية

إذا (تحية() == "مرحبا عالم")
    اطبع_سطر("اختبار 1 - قيمة افتراضية: نجح")
