# test chain in return
متغير م = [{"اسم": "سارة"}]
متغير ف = 0

# direct chain with variable index
اطبع_سطر("direct: " + م[ف]["اسم"])

# store intermediate
متغير ت = م[ف]
اطبع_سطر("intermediate: " + ت["اسم"])

# in function
دالة احصل(فهرس)
    متغير ت = م[فهرس]
    ارجع ت["اسم"]
نهاية
اطبع_سطر("func: " + احصل(0))
