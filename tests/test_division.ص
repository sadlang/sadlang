# اختبار القسمة الصحيحة

# اختبار 1 - قسمة بدون باقي
إذا (10 / 2 == 5)
    اطبع_سطر("اختبار 1 - 10/2=5: نجح")
وإلا
    اطبع_سطر("اختبار 1 - 10/2: فشل - " + (10 / 2))
نهاية

# اختبار 2 - قسمة بباقي (يجب أن تعطي عشري)
إذا (7 / 2 == 3.5)
    اطبع_سطر("اختبار 2 - 7/2=3.5: نجح")
وإلا
    اطبع_سطر("اختبار 2 - 7/2: فشل - " + (7 / 2))
نهاية

# اختبار 3 - قسمة سالبة
إذا (-7 / 2 == -3.5)
    اطبع_سطر("اختبار 3 - -7/2=-3.5: نجح")
وإلا
    اطبع_سطر("اختبار 3 - -7/2: فشل - " + (-7 / 2))
نهاية

# اختبار 4 - قسمة عشرية تبقى عشرية
إذا (7.0 / 2.0 == 3.5)
    اطبع_سطر("اختبار 4 - 7.0/2.0=3.5: نجح")
وإلا
    اطبع_سطر("اختبار 4 - 7.0/2.0: فشل - " + (7.0 / 2.0))
نهاية

# اختبار 5 - قسمة بدون باقي تعطي صحيح
إذا (6 / 3 == 2)
    اطبع_سطر("اختبار 5 - 6/3=2: نجح")
وإلا
    اطبع_سطر("اختبار 5 - 6/3: فشل - " + (6 / 3))
نهاية
