# 7. اختبار حالات معقدة
# ============================================
اطبع_سطر("")
اطبع_سطر("6️⃣ اختبار حالات معقدة:")

دالة تحليل_استجابة(استجابة)
    متغير الحالة = استجابة["حالة"]
    
    طابق (الحالة)
        عندما "نجاح":
            ارجع "✅ " + استجابة["رسالة"] + " (بيانات: " + استجابة["بيانات"] + ")"
        عندما "خطأ":
            ارجع "❌ خطأ " + استجابة["رمز_خطأ"] + ": " + استجابة["رسالة"]
        عندما "تحذير":
            ارجع "⚠️ تحذير: " + استجابة["رسالة"]
        عندما "انتظار":
            ارجع "⏳ جاري المعالجة..."
        افتراضي:
            ارجع "❓ حالة غير معروفة"
    نهاية
نهاية

متغير ر1 = {"حالة": "نجاح"، "رسالة": "تم الحفظ"، "بيانات": "ملف.txt"}
متغير ر2 = {"حالة": "خطأ"، "رمز_خطأ": 404، "رسالة": "الملف غير موجود"}
