# ============================================
# 1. تعريف الأصناف للاختبار
# ============================================

صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    
    دالة وصف()
        ارجع "نقطة(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

صنف مستطيل
    باني(عرض، ارتفاع)
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية
    
    دالة مساحة()
        ارجع هذا.عرض * هذا.ارتفاع
    نهاية
    
    دالة وصف()
        ارجع "مستطيل(" + هذا.عرض + " × " + هذا.ارتفاع + ")"
    نهاية
نهاية

صنف دائرة
    باني(نصف_قطر)
        هذا.نصف_قطر = نصف_قطر
    نهاية
    
    دالة مساحة()
        ارجع 3.14159 * هذا.نصف_قطر * هذا.نصف_قطر
    نهاية
    
    دالة وصف()
        ارجع "دائرة(نق=" + هذا.نصف_قطر + ")"
    نهاية
نهاية

صنف شخص
    باني(الاسم، العمر، المدينة)
        هذا.الاسم = الاسم
        هذا.العمر = العمر
        هذا.المدينة = المدينة
    نهاية
    
    دالة وصف()
        ارجع هذا.الاسم + " (" + هذا.العمر + " سنة) من " + هذا.المدينة
    نهاية
نهاية

صنف طالب يرث شخص
    باني(الاسم، العمر، المدينة، الجامعة، المعدل)
        الأساس(الاسم، العمر، المدينة)
        هذا.الجامعة = الجامعة
        هذا.المعدل = المعدل
    نهاية
    
    دالة وصف()
        ارجع "طالب: " + هذا.الاسم + " - " + هذا.الجامعة + " (معدل: " + هذا.المعدل + ")"
    نهاية
نهاية

