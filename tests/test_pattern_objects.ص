# 5. اختبار الطلاب
# ============================================
اطبع_سطر("")
اطبع_سطر("4️⃣ اختبار الطلاب والمعدلات:")

دالة تقدير_طالب(طالب)
    متغير المعدل = طالب.المعدل
    
    إذا (المعدل >= 90)
        ارجع "🏆 ممتاز"
    وإلا
        إذا (المعدل >= 80)
            ارجع "⭐ جيد جداً"
        وإلا
            إذا (المعدل >= 70)
                ارجع "✅ جيد"
            وإلا
                إذا (المعدل >= 60)
                    ارجع "📝 مقبول"
                وإلا
                    ارجع "❌ راسب"
                نهاية
            نهاية
        نهاية
    نهاية
نهاية

متغير طالب1 = جديد طالب("علي"، 20، "جدة"، "جامعة الملك عبدالعزيز"، 95)
متغير طالب2 = جديد طالب("نورة"، 22، "الدمام"، "جامعة الدمام"، 78)
متغير طالب3 = جديد طالب("خالد"، 21، "مكة"، "جامعة أم القرى"، 55)

اطبع_سطر("   " + طالب1.وصف() + " - " + تقدير_طالب(طالب1))
اطبع_سطر("   " + طالب2.وصف() + " - " + تقدير_طالب(طالب2))
اطبع_سطر("   " + طالب3.وصف() + " - " + تقدير_طالب(طالب3))

