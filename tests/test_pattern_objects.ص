# ============================================
# 3. اختبار الخرائط مع match
# ============================================
اطبع_سطر("")
اطبع_سطر("2️⃣ اختبار الخرائط (Maps):")

دالة معالجة_حدث(حدث)
    متغير النوع = حدث["نوع"]
    
    طابق (النوع)
        عندما "نقر":
            ارجع "👆 نقر على (" + حدث["س"] + "، " + حدث["ص"] + ")"
        عندما "سحب":
            ارجع "✋ سحب من (" + حدث["بداية_س"] + "، " + حدث["بداية_ص"] + ")"
        عندما "ضغط_مفتاح":
            ارجع "⌨️ ضغط مفتاح: " + حدث["مفتاح"]
        عندما "تمرير":
            ارجع "📜 تمرير بمقدار " + حدث["مقدار"]
        افتراضي:
            ارجع "❓ حدث غير معروف: " + النوع
    نهاية
نهاية

متغير حدث_نقر = {"نوع": "نقر"، "س": 100، "ص": 200}
متغير حدث_مفتاح = {"نوع": "ضغط_مفتاح"، "مفتاح": "Enter"}
متغير حدث_تمرير = {"نوع": "تمرير"، "مقدار": 50}

اطبع_سطر("   " + معالجة_حدث(حدث_نقر))
اطبع_سطر("   " + معالجة_حدث(حدث_مفتاح))
اطبع_سطر("   " + معالجة_حدث(حدث_تمرير))

# ============================================
# 4. اختبار الأشخاص والوراثة
# ============================================
اطبع_سطر("")
اطبع_سطر("3️⃣ اختبار الأشخاص:")

دالة فئة_عمرية(شخص)
    متغير العمر = شخص.العمر
    
    إذا (العمر < 13)
        ارجع "👶 طفل"
    وإلا
        إذا (العمر < 20)
            ارجع "🧒 مراهق"
        وإلا
            إذا (العمر < 60)
                ارجع "👨 بالغ"
            وإلا
                ارجع "👴 كبير السن"
            نهاية
        نهاية
    نهاية
نهاية

متغير أحمد = جديد شخص("أحمد"، 25، "القاهرة")
متغير سارة = جديد شخص("سارة"، 15، "الرياض")
متغير محمد = جديد شخص("محمد"، 65، "دمشق")

اطبع_سطر("   " + أحمد.وصف() + " - " + فئة_عمرية(أحمد))
اطبع_سطر("   " + سارة.وصف() + " - " + فئة_عمرية(سارة))
اطبع_سطر("   " + محمد.وصف() + " - " + فئة_عمرية(محمد))

