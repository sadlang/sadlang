# اختبار: تمرير الكائنات كمعاملات للدوال
# Test: Passing objects as function parameters

صنف شخص
    نص الاسم
    رقم العمر
    
    باني(نص اسم، رقم عمر)
        الاسم = اسم
        العمر = عمر
    نهاية
    
    دالة عرض()
        اطبع_سطر("الاسم: " + الاسم + "، العمر: " + العمر)
    نهاية
نهاية

# دالة تأخذ كائن كمعامل
دالة عرض_شخص(ش)
    اطبع_سطر("=== معلومات الشخص ===")
    اطبع_سطر("الاسم: " + ش.الاسم)
    اطبع_سطر("العمر: " + ش.العمر)
نهاية

# دالة تعدل كائن (يجب أن يتغير بالمرجع)
دالة زيادة_عمر(ش)
    ش.العمر = ش.العمر + 1
نهاية

دالة رئيسية()
    # إنشاء كائن
    شخص احمد = جديد شخص("أحمد"، 25)
    اطبع_سطر("قبل:")
    احمد.عرض()

    # تمرير لدالة
    عرض_شخص(احمد)

    # تمرير بالمرجع - تعديل
    زيادة_عمر(احمد)
    اطبع_سطر("بعد زيادة العمر:")
    احمد.عرض()
    
    ارجع 0
نهاية
