# ═══ اختبار Framebuffer (Part 32) ═══
متغير اطار = framebuffer_create(320, 240)
عدد_كلي = عدد_كلي + 1
إذا (اطار >= 0)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ framebuffer_create: " + اطار)
وإلا
   اطبع_سطر("✗ framebuffer_create فشل")
نهاية

متغير عرض_اطار = framebuffer_width(اطار)
عدد_كلي = عدد_كلي + 1
إذا (عرض_اطار == 320)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ framebuffer_width: " + عرض_اطار)
وإلا
   اطبع_سطر("✗ framebuffer_width: " + عرض_اطار)
نهاية

framebuffer_clear(اطار, 0, 0, 0)
framebuffer_set_pixel(اطار, 10, 10, 255, 0, 0)
framebuffer_line(اطار, 0, 0, 100, 100, 0, 255, 0)
framebuffer_rect(اطار, 50, 50, 30, 20, 0, 0, 255, صحيح)
framebuffer_circle(اطار, 160, 120, 40, 255, 255, 0, خطأ)

متغير بكسلات = framebuffer_pixel_count(اطار)
عدد_كلي = عدد_كلي + 1
إذا (بكسلات == 76800)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ framebuffer_pixel_count: " + بكسلات)
وإلا
   اطبع_سطر("✗ framebuffer_pixel_count: " + بكسلات)
نهاية

framebuffer_destroy(اطار)

