نهاية

متغير حجم_ج = json_size(ج)
عدد_كلي = عدد_كلي + 1
إذا (حجم_ج == 3)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ json_size: " + حجم_ج)
وإلا
   اطبع_سطر("✗ json_size: " + حجم_ج)
نهاية

متغير يحتوي = json_has_key(ج, "اسم")
عدد_كلي = عدد_كلي + 1
إذا (يحتوي)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ json_has_key")
وإلا
   اطبع_سطر("✗ json_has_key فشل")
نهاية

json_destroy(ج)

