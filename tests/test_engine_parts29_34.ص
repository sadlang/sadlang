# اختبار ربط محرك الرسوميات - أجزاء 29-34
استورد محرك

# ═══ اختبار ECS (Part 29) ═══
متغير عدد_نجاح = 0
متغير عدد_كلي = 0

# 1. ECS World
متغير عالم = ecs_world_create()
عدد_كلي = عدد_كلي + 1
إذا (عالم >= 0)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ ecs_world_create: " + عالم)
وإلا
   اطبع_سطر("✗ ecs_world_create فشل")
نهاية

# 2. ECS Entity
متغير كيان = ecs_entity_create(عالم)
عدد_كلي = عدد_كلي + 1
إذا (كيان >= 0)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ ecs_entity_create: " + كيان)
وإلا
   اطبع_سطر("✗ ecs_entity_create فشل")
نهاية

# 3. Add position
ecs_add_position(عالم, كيان, 10.5, 20.3)
عدد_كلي = عدد_كلي + 1
متغير س = ecs_get_x(عالم, كيان)
إذا (س >= 10.0)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ ecs_add_position/get_x: " + س)
وإلا
   اطبع_سطر("✗ ecs_add_position فشل")
نهاية

# 4. Entity count
متغير عدد = ecs_entity_count(عالم)
عدد_كلي = عدد_كلي + 1
إذا (عدد == 1)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ ecs_entity_count: " + عدد)
وإلا
   اطبع_سطر("✗ ecs_entity_count: " + عدد)
نهاية

# 5. Entity alive
متغير حي = ecs_entity_alive(عالم, كيان)
عدد_كلي = عدد_كلي + 1
إذا (حي)
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ ecs_entity_alive")
وإلا
   اطبع_سطر("✗ ecs_entity_alive فشل")
نهاية

ecs_world_destroy(عالم)

