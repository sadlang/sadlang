json_write_bool(ج, "نشط", صحيح)

متغير اسم_ج = json_read_string(ج, "اسم")
عدد_كلي = عدد_كلي + 1
إذا (اسم_ج == "لغة ص")
   عدد_نجاح = عدد_نجاح + 1
   اطبع_سطر("✓ json_read_string: " + اسم_ج)
وإلا
