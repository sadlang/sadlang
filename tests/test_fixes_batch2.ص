# اختبار دفعة الإصلاحات الثانية

# === اختبار التحويلات ===
متغير ن = إلى_رقم("42")
اطبع_سطر("إلى_رقم('42') = " + ن)

متغير ع = إلى_عشري("3.14")
اطبع_سطر("إلى_عشري('3.14') = " + ع)

# === اختبار يحتوي بالقيمة ===
متغير م = [1، 2، 3، 4، 5]
اطبع_سطر("م.يحتوي(3) = " + م.يحتوي(3))
اطبع_سطر("م.فهرس(4) = " + م.فهرس(4))

# === اختبار فريد ===
متغير م2 = [1، 2، 2، 3، 3، 3]
اطبع_سطر("فريد: " + م2.فريد())

# === اختبار عد ===
اطبع_سطر("عد(3): " + م2.عد(3))

