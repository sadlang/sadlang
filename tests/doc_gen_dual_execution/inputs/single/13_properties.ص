## صنف شخص — يحتوي خاصيات get/set
صنف شخص
    متغير خاص _اسم
    متغير خاص _عمر

    باني(اسم، عمر)
        هذا._اسم = اسم
        هذا._عمر = عمر
    نهاية

    ## خاصية الاسم — للقراءة والكتابة
    خاصية اسم
        احصل()
            ارجع هذا._اسم
        نهاية
        عيّن(قيمة)
            هذا._اسم = قيمة
        نهاية
    نهاية

    ## خاصية العمر — قراءة فقط
    خاصية عمر
        احصل()
            ارجع هذا._عمر
        نهاية
    نهاية
نهاية
