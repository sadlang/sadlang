# === اختبار 1: الوراثة ===
صنف كائن_حي
    نص الاسم
    رقم العمر
    
    باني(نص اسم، رقم عمر)
        الاسم = اسم
        العمر = عمر
    نهاية
    
    دالة وصف()
        اطبع_سطر("كائن حي: " + الاسم + "، العمر: " + العمر)
    نهاية
نهاية

صنف حيوان يرث كائن_حي
    نص الصوت
    
    باني(نص اسم، رقم عمر، نص صوت) : الأساس(اسم، عمر)
        الصوت = صوت
    نهاية
    
    دالة صوّت()
        اطبع_سطر(الاسم + " يقول: " + الصوت)
    نهاية
نهاية

# === اختبار 2: استدعاء الطرق ===
صنف حاسبة
    رقم القيمة
    
    باني()
        القيمة = 0
    نهاية
    
    دالة اضف(رقم ع)
        القيمة = القيمة + ع
    نهاية
    
    دالة اعط_القيمة()
        ارجع القيمة
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== اختبار الوراثة ===")
    حيوان قطة = جديد حيوان("قطة"، 3، "مياو")
    قطة.وصف()
    قطة.صوّت()
    
    اطبع_سطر("=== اختبار الطرق ===")
    حاسبة ح = جديد حاسبة()
    ح.اضف(10)
    ح.اضف(20)
    اطبع_سطر("النتيجة: " + ح.اعط_القيمة())
    
    اطبع_سطر("=== انتهى الاختبار ===")
    ارجع 0
نهاية
