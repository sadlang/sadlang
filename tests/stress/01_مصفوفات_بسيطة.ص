# اختبار 01: المصفوفات البسيطة
# ═══════════════════════════════════

# إنشاء مصفوفة فارغة
متغير فارغة = []
اطبع("طول_فارغة=" + فارغة.الطول())

# إنشاء مصفوفة بقيم
متغير أرقام = [10، 20، 30، 40، 50]
اطبع("طول=" + أرقام.الطول())
اطبع("أول=" + أرقام[0])
اطبع("آخر=" + أرقام[4])

# إضافة عنصر
أرقام.أضف(60)
اطبع("بعد_إضافة=" + أرقام.الطول())

# حذف عنصر
أرقام.احذف(0)
اطبع("بعد_حذف=" + أرقام[0])

# تعديل عنصر
أرقام[0] = 99
اطبع("بعد_تعديل=" + أرقام[0])

# مصفوفة نصوص
متغير أسماء = ["أحمد"، "محمد"، "خالد"]
اطبع("اسم=" + أسماء[1])

# مصفوفة مختلطة
متغير مختلطة = [1، "نص"، صحيح، 3.14]
اطبع("عنصر_نص=" + مختلطة[1])
اطبع("عنصر_رقم=" + مختلطة[0])
