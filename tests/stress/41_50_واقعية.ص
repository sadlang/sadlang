# اختبار 41-50: سيناريوهات واقعية

# 41: نظام تسجيل طلاب
صنف طالب
   باني(الاسم، الرقم)
      هذا.الاسم = الاسم
      هذا.الرقم = الرقم
      هذا.الدرجات = []
   نهاية
   
   دالة أضف_درجة(درجة)
      هذا.الدرجات.أضف(درجة)
   نهاية
   
   دالة المعدل()
      إذا (هذا.الدرجات.الطول() == 0)
         ارجع 0
      نهاية
      متغير مجموع = 0
      لكل د في هذا.الدرجات
         مجموع = مجموع + د
      نهاية
      ارجع مجموع / هذا.الدرجات.الطول()
   نهاية
   
   دالة التقدير()
      متغير م = هذا.المعدل()
      إذا (م >= 90)
         ارجع "ممتاز"
      والا_اذا (م >= 80)
         ارجع "جيد جداً"
      والا_اذا (م >= 70)
         ارجع "جيد"
      والا_اذا (م >= 60)
         ارجع "مقبول"
      وإلا
         ارجع "راسب"
      نهاية
   نهاية
نهاية

متغير ط1 = جديد طالب("أحمد"، 101)
ط1.أضف_درجة(85)
ط1.أضف_درجة(90)
ط1.أضف_درجة(78)
اطبع("معدل_أحمد=" + ط1.المعدل())
اطبع("تقدير_أحمد=" + ط1.التقدير())

# 42: آلة حاسبة عكسية بولندية (تستخدم المكدس)
صنف مكدس_حاسبة
   باني()
      هذا.بيانات = []
   نهاية
   
   دالة ادفع(ق)
      هذا.بيانات.أضف(ق)
   نهاية
   
   دالة اسحب()
      متغير آخر = هذا.بيانات[هذا.بيانات.الطول() - 1]
      هذا.بيانات.احذف(هذا.بيانات.الطول() - 1)
      ارجع آخر
   نهاية
نهاية

