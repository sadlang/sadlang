# 43: تحويل رقم لنظام ثنائي
دالة إلى_ثنائي(ن)
   إذا (ن == 0)
      ارجع "0"
   نهاية
   متغير نتيجة = ""
   متغير العدد = ن
   بينما (العدد > 0)
      نتيجة = (العدد % 2) + نتيجة
      العدد = العدد / 2
      إذا (العدد != 0 && العدد < 1)
         اخرج
      نهاية
   نهاية
   ارجع نتيجة
نهاية
اطبع("10_ثنائي=" + إلى_ثنائي(10))

# 44: دالة map يدوية
دالة خريطة_ف(مصف، ف)
   متغير نتيجة = []
   لكل ع في مصف
      نتيجة.أضف(ف(ع))
   نهاية
   ارجع نتيجة
نهاية

دالة مضاعفة(ن)
   ارجع ن * 2
نهاية

متغير الأصلية = [1، 2، 3، 4، 5]
متغير مضاعف = خريطة_ف(الأصلية، مضاعفة)
اطبع("مضاعف_أول=" + مضاعف[0])
اطبع("مضاعف_آخر=" + مضاعف[4])

# 45: دالة filter يدوية
دالة ترشيح(مصف، شرط_ف)
   متغير نتيجة = []
   لكل ع في مصف
      إذا (شرط_ف(ع))
         نتيجة.أضف(ع)
      نهاية
   نهاية
   ارجع نتيجة
نهاية

دالة أكبر_من_3(ن)
   ارجع ن > 3
نهاية

متغير مرشح = ترشيح(الأصلية، أكبر_من_3)
اطبع("مرشح_طول=" + مرشح.الطول())
اطبع("مرشح_أول=" + مرشح[0])
