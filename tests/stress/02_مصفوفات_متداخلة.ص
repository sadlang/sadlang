# اختبار 02: المصفوفات المتداخلة
# ═══════════════════════════════════

# مصفوفة ثنائية الأبعاد
متغير مصف = [[1، 2، 3]، [4، 5، 6]، [7، 8، 9]]
اطبع("عنصر[0][0]=" + مصف[0][0])
اطبع("عنصر[1][2]=" + مصف[1][2])
اطبع("عنصر[2][1]=" + مصف[2][1])

# تعديل عنصر في مصفوفة متداخلة
مصف[1][1] = 99
اطبع("بعد_تعديل=" + مصف[1][1])

# مصفوفة من خرائط
متغير طلاب = [
   {"الاسم": "أحمد"، "العمر": 20}،
   {"الاسم": "سارة"، "العمر": 22}
]
اطبع("طالب1=" + طلاب[0]["الاسم"])
اطبع("عمر2=" + طلاب[1]["العمر"])

# حلقة على مصفوفة
متغير مجموع = 0
لكل رقم في [1، 2، 3، 4، 5]
   مجموع = مجموع + رقم
نهاية
اطبع("مجموع=" + مجموع)

# حلقة على مصفوفة متداخلة
لكل صف في مصف
   لكل عنصر في صف
      اطبع("عنصر:" + عنصر)
   نهاية
نهاية
