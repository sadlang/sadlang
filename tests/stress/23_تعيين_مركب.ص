# اختبار 23: تعيين مركب (+= -= *= /=)
# ═══════════════════════════════════

# تعيين مركب بسيط
متغير س = 10
س += 5
اطبع("+=:" + س)
س -= 3
اطبع("-=:" + س)
س *= 2
اطبع("*=:" + س)

# تعيين مركب على عناصر مصفوفة
متغير مصف = [10، 20، 30]
مصف[0] += 5
اطبع("مصف[0]+5=" + مصف[0])
مصف[1] -= 10
اطبع("مصف[1]-10=" + مصف[1])

# تعيين مركب على حقول كائن
صنف صندوق
   باني(عرض، ارتفاع)
      هذا.عرض = عرض
      هذا.ارتفاع = ارتفاع
   نهاية
نهاية

متغير ص = جديد صندوق(10، 20)
ص.عرض += 5
اطبع("عرض+5=" + ص.عرض)
ص.ارتفاع *= 2
اطبع("ارتفاع*2=" + ص.ارتفاع)

# تعيين مركب على خريطة
متغير قاموس = {"نقاط": 100، "مستوى": 1}
قاموس["نقاط"] += 50
اطبع("نقاط+50=" + قاموس["نقاط"])

# تعيين مركب في حلقة
متغير مجموع = 0
لكل ر في [1، 2، 3، 4، 5]
   مجموع += ر
نهاية
اطبع("مجموع_مركب=" + مجموع)

# تعيين مركب مع نصوص
متغير جملة = "مرحباً"
جملة += " بالعالم"
اطبع("نص+=" + جملة)
