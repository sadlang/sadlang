# اختبار 07: النصوص وعملياتها
# ═══════════════════════════════════

# عمليات النصوص الأساسية
متغير محتوى = "مرحباً بالعالم"
اطبع("طول=" + محتوى.الطول())

# الدمج
متغير اسم = "أحمد"
متغير رسالة = "مرحباً يا " + اسم + "!"
اطبع("رسالة=" + رسالة)

# التكرار بالضرب
متغير خط = "-" * 10
اطبع("خط=" + خط)

# المقارنة
اطبع("متساوي=" + ("أحمد" == "أحمد"))
اطبع("مختلف=" + ("أحمد" != "محمد"))

# النص كمصفوفة أحرف
متغير حروف = "سلام"
اطبع("حرف0=" + حروف[0])

# تحويل الأنواع مع النصوص
متغير العدد = 42
متغير نص_رقم = "الرقم هو: " + العدد
اطبع(نص_رقم)

# نص فارغ
متغير خالي = ""
اطبع("فارغ_طول=" + خالي.الطول())

# نص متعدد الأسطر (بعلامات هروب)
متغير سطور = "سطر1\nسطر2\nسطر3"
اطبع(سطور)

# نصوص مع أرقام
متغير خليط = "العدد " + 100 + " والعدد " + 200
اطبع("مزيج=" + خليط)
