# اختبار 24: مصفوفة من كائنات مع عمليات
# ═══════════════════════════════════

صنف موظف
   باني(الاسم، الراتب، القسم)
      هذا.الاسم = الاسم
      هذا.الراتب = الراتب
      هذا.القسم = القسم
   نهاية
   
   دالة زيادة_راتب(نسبة)
      هذا.الراتب = هذا.الراتب * (1 + نسبة / 100)
   نهاية
   
   دالة وصف()
      ارجع هذا.الاسم + " - " + هذا.القسم + " - " + هذا.الراتب
   نهاية
نهاية

# إنشاء مصفوفة موظفين
متغير موظفون = []
موظفون.أضف(جديد موظف("أحمد"، 5000، "تقنية"))
موظفون.أضف(جديد موظف("سارة"، 6000، "إدارة"))
موظفون.أضف(جديد موظف("خالد"، 4500، "تقنية"))
موظفون.أضف(جديد موظف("نورة"، 5500، "تسويق"))

# طباعة كل الموظفين
لكل م في موظفون
   اطبع("موظف: " + م.وصف())
نهاية

# حساب مجموع الرواتب
متغير مجموع_رواتب = 0
لكل م في موظفون
   مجموع_رواتب = مجموع_رواتب + م.الراتب
نهاية
اطبع("مجموع_رواتب=" + مجموع_رواتب)

# زيادة رواتب قسم التقنية
لكل م في موظفون
   إذا (م.القسم == "تقنية")
      م.زيادة_راتب(10)
   نهاية
نهاية

# تحقق من الزيادة
اطبع("راتب_أحمد_بعد=" + موظفون[0].الراتب)
اطبع("راتب_خالد_بعد=" + موظفون[2].الراتب)
