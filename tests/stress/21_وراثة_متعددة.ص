# اختبار 21: وراثة متعددة المستويات
# ═══════════════════════════════════

صنف كائن_حي
   باني(الاسم)
      هذا.الاسم = الاسم
      هذا.حي = صحيح
   نهاية
   
   دالة هل_حي()
      ارجع هذا.حي
   نهاية
نهاية

صنف حيوان يرث كائن_حي
   باني(الاسم، النوع)
      أساس.باني(الاسم)
      هذا.النوع = النوع
   نهاية
   
   دالة صوت()
      ارجع "..."
   نهاية
نهاية

صنف قطة يرث حيوان
   باني(الاسم)
      أساس.باني(الاسم، "ثديي")
   نهاية
   
   دالة صوت()
      ارجع "مياو"
   نهاية
نهاية

متغير ق = جديد قطة("ميمي")
اطبع("اسم=" + ق.الاسم)
اطبع("نوع=" + ق.النوع)
اطبع("صوت=" + ق.صوت())
اطبع("حي=" + ق.هل_حي())
