# 51: نمط المفرد (Singleton-like)
متغير _مثيل = عدم
دالة إعدادات()
   إذا (_مثيل == عدم)
      _مثيل = {"سمة": "داكن"، "لغة": "عربي"، "حجم_خط": 14}
   نهاية
   ارجع _مثيل
نهاية

متغير إعد1 = إعدادات()
متغير إعد2 = إعدادات()
اطبع("سمة=" + إعد1["سمة"])
إعد1["سمة"] = "فاتح"
اطبع("سمة_بعد=" + إعد1["سمة"])

# 52: نمط المراقب (Observer-like)
صنف حدث
   باني()
      هذا.مستمعون = []
   نهاية
   
   دالة أضف_مستمع(مستمع)
      هذا.مستمعون.أضف(مستمع)
   نهاية
   
   دالة أطلق(بيانات)
      لكل م في هذا.مستمعون
         م(بيانات)
      نهاية
   نهاية
نهاية

دالة مسجل(رسالة)
   اطبع("سجل: " + رسالة)
نهاية

دالة منبه(رسالة)
   اطبع("تنبيه: " + رسالة)
نهاية

متغير حدث_تسجيل = جديد حدث()
حدث_تسجيل.أضف_مستمع(مسجل)
حدث_تسجيل.أضف_مستمع(منبه)
حدث_تسجيل.أطلق("مستخدم جديد")

# 53: بناء نص تدريجي
دالة بناء_جدول(صفوف، أعمدة)
   متغير نتيجة = ""
   متغير ص = 0
   بينما (ص < صفوف)
      متغير ع = 0
      بينما (ع < أعمدة)
         نتيجة = نتيجة + "[" + ص + "،" + ع + "] "
         ع = ع + 1
      نهاية
      نتيجة = نتيجة + "\n"
      ص = ص + 1
   نهاية
   ارجع نتيجة
نهاية
اطبع(بناء_جدول(2، 3))

# 54: سلسلة فيبوناتشي غير متكررة (بحلقة)
دالة فيبوناتشي_سريع(ن)
   إذا (ن <= 0)
      ارجع 0
   نهاية
   إذا (ن == 1)
      ارجع 1
   نهاية
   متغير أ = 0
   متغير ب = 1
   متغير ع = 2
   بينما (ع <= ن)
      متغير مؤقت = أ + ب
      أ = ب
      ب = مؤقت
      ع = ع + 1
   نهاية
   ارجع ب
نهاية
اطبع("فيب20=" + فيبوناتشي_سريع(20))
اطبع("فيب30=" + فيبوناتشي_سريع(30))

# 55: تسطيح مصفوفة متداخلة (مستوى واحد)
دالة سطّح(مصف)
   متغير نتيجة = []
   لكل عنصر في مصف
      لكل فرعي في عنصر
         نتيجة.أضف(فرعي)
      نهاية
   نهاية
   ارجع نتيجة
نهاية

متغير متداخلة = [[1، 2]، [3، 4]، [5، 6]]
متغير مسطحة = سطّح(متداخلة)
اطبع("مسطحة_طول=" + مسطحة.الطول())
اطبع("مسطحة_أول=" + مسطحة[0])
اطبع("مسطحة_آخر=" + مسطحة[5])
