# اختبار 61-70: كائنات معقدة مع تفاعل

# 61: نظام سلة تسوق
صنف سلعة
   باني(الاسم، السعر، الكمية)
      هذا.الاسم = الاسم
      هذا.السعر = السعر
      هذا.الكمية = الكمية
   نهاية
   
   دالة الإجمالي()
      ارجع هذا.السعر * هذا.الكمية
   نهاية
نهاية

صنف سلة
   باني()
      هذا.عناصر = []
   نهاية
   
   دالة أضف(سلعة)
      هذا.عناصر.أضف(سلعة)
   نهاية
   
   دالة الإجمالي()
      متغير مجموع = 0
      لكل ع في هذا.عناصر
         مجموع = مجموع + ع.الإجمالي()
      نهاية
      ارجع مجموع
   نهاية
   
   دالة عدد_العناصر()
      ارجع هذا.عناصر.الطول()
   نهاية
نهاية

متغير سلتي = جديد سلة()
سلتي.أضف(جديد سلعة("تفاح"، 5، 3))
سلتي.أضف(جديد سلعة("حليب"، 8، 2))
سلتي.أضف(جديد سلعة("خبز"، 3، 1))
اطبع("عدد=" + سلتي.عدد_العناصر())
اطبع("إجمالي=" + سلتي.الإجمالي())

# 62: نظام إدارة مهام
صنف مهمة
   باني(العنوان، الأولوية)
      هذا.العنوان = العنوان
      هذا.الأولوية = الأولوية
      هذا.مكتملة = خطأ
   نهاية
   
   دالة أكمل()
      هذا.مكتملة = صحيح
   نهاية
نهاية

متغير مهام = []
مهام.أضف(جديد مهمة("تصميم الواجهة"، 1))
مهام.أضف(جديد مهمة("كتابة الكود"، 2))
مهام.أضف(جديد مهمة("الاختبار"، 3))

مهام[0].أكمل()

متغير مكتملة = 0
متغير غير_مكتملة = 0
لكل م في مهام
   إذا (م.مكتملة)
      مكتملة = مكتملة + 1
   وإلا
      غير_مكتملة = غير_مكتملة + 1
   نهاية
نهاية
اطبع("مكتملة=" + مكتملة)
اطبع("غير_مكتملة=" + غير_مكتملة)

# 63: نظام نقاط بسيط
صنف لاعب
   باني(الاسم)
      هذا.الاسم = الاسم
      هذا.النقاط = 0
      هذا.المستوى = 1
   نهاية
   
   دالة أضف_نقاط(نقاط)
      هذا.النقاط = هذا.النقاط + نقاط
      بينما (هذا.النقاط >= هذا.المستوى * 100)
         هذا.المستوى = هذا.المستوى + 1
      نهاية
   نهاية
نهاية

متغير لاعب1 = جديد لاعب("بطل")
لاعب1.أضف_نقاط(150)
اطبع("مستوى=" + لاعب1.المستوى)
اطبع("نقاط=" + لاعب1.النقاط)
لاعب1.أضف_نقاط(200)
اطبع("مستوى2=" + لاعب1.المستوى)
