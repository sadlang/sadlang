# اختبار 10: الرياضيات
# ═══════════════════════════════════

# العمليات الأساسية
اطبع("جمع=" + (10 + 20))
اطبع("طرح=" + (50 - 15))
اطبع("ضرب=" + (6 * 7))
اطبع("قسمة=" + (100 / 4))
اطبع("باقي=" + (17 % 5))
اطبع("أس=" + (2 ** 10))

# القسمة الصحيحة مقابل العشرية
اطبع("قسمة_صحيحة=" + (10 / 5))
اطبع("قسمة_عشرية=" + (10 / 3))

# الأعداد السالبة
اطبع("سالب=" + (-5 + 3))
اطبع("ضرب_سالب=" + (-3 * -4))

# الأعداد العشرية
اطبع("عشري=" + (3.14 * 2))
اطبع("عشري_جمع=" + (0.1 + 0.2))

# الأعداد الست عشرية
متغير ست_عشري = 0xFF
اطبع("ست_عشري=" + ست_عشري)

# الأعداد الثنائية
متغير ثنائي = 0b1010
اطبع("ثنائي=" + ثنائي)

# الأعداد الثمانية
متغير ثماني = 0o77
اطبع("ثماني=" + ثماني)

# عمليات مركبة
متغير س = 10
س += 5
اطبع("بعد_+=" + س)
س -= 3
اطبع("بعد_-=" + س)
س *= 2
اطبع("بعد_*=" + س)

# ترتيب العمليات
اطبع("ترتيب=" + (2 + 3 * 4))
اطبع("أقواس=" + ((2 + 3) * 4))
