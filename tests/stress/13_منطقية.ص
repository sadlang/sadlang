# اختبار 13: العمليات المنطقية
# ═══════════════════════════════════

# القيم المنطقية
متغير ص = صحيح
متغير خ = خطأ
اطبع("صحيح=" + ص)
اطبع("خطأ=" + خ)

# العمليات المنطقية
اطبع("و=" + (صحيح && صحيح))
اطبع("و_خطأ=" + (صحيح && خطأ))
اطبع("أو=" + (صحيح || خطأ))
اطبع("أو_خطأ=" + (خطأ || خطأ))
اطبع("ليس=" + (!صحيح))
اطبع("ليس_خطأ=" + (!خطأ))

# مقارنات تنتج قيم منطقية
متغير أ = 10
متغير ب = 20
اطبع("أكبر=" + (أ > ب))
اطبع("أصغر=" + (أ < ب))
اطبع("يساوي=" + (أ == ب))
اطبع("لا_يساوي=" + (أ != ب))
اطبع("أكبر_يساوي=" + (أ >= 10))
اطبع("أصغر_يساوي=" + (ب <= 20))

# شرط مع منطقية
متغير مسجل = صحيح
متغير عمر_كافي = صحيح
إذا (مسجل && عمر_كافي)
   اطبع("مسموح")
