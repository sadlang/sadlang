# دالة عادية
دالة مضروب(ن)
   إذا (ن <= 1)
      ارجع 1
   نهاية
   ارجع ن * مضروب(ن - 1)
نهاية
اطبع("مضروب5=" + مضروب(5))
اطبع("مضروب10=" + مضروب(10))

# دالة فيبوناتشي
دالة فيب(ن)
   إذا (ن <= 0)
      ارجع 0
   نهاية
   إذا (ن == 1)
      ارجع 1
   نهاية
   ارجع فيب(ن - 1) + فيب(ن - 2)
نهاية
اطبع("فيب10=" + فيب(10))

# دالة بمعاملات افتراضية
دالة تحية(الاسم، اللغة = "عربي")
   إذا (اللغة == "عربي")
      ارجع "مرحباً " + الاسم
   وإلا
      ارجع "Hello " + الاسم
   نهاية
نهاية
اطبع(تحية("أحمد"))
اطبع(تحية("Ahmed"، "إنجليزي"))

# دالة تعيد مصفوفة
دالة أنشئ_نطاق(بداية، آخر)
   متغير نتيجة = []
   متغير ع = بداية
   بينما (ع <= آخر)
      نتيجة.أضف(ع)
      ع = ع + 1
   نهاية
   ارجع نتيجة
نهاية
متغير نطاق = أنشئ_نطاق(1، 5)
اطبع("نطاق_طول=" + نطاق.الطول())

# دالة تعيد خريطة
دالة معلومات_شخص(الاسم، العمر)
   ارجع {"الاسم": الاسم، "العمر": العمر، "بالغ": العمر >= 18}
نهاية
متغير شخص = معلومات_شخص("سارة"، 20)
اطبع("شخص_اسم=" + شخص["الاسم"])
