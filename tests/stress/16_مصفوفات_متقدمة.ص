# اختبار 16: عمليات المصفوفات المتقدمة
# ═══════════════════════════════════

# إضافة وحذف
متغير قائمة = [1، 2، 3، 4، 5]
قائمة.أضف(6)
اطبع("بعد_أضف=" + قائمة.الطول())

# حذف بالفهرس
قائمة.احذف(0)
اطبع("بعد_حذف_أول=" + قائمة[0])

# البحث
متغير فهرس = قائمة.فهرس(4)
اطبع("فهرس_4=" + فهرس)

# يحتوي
متغير يحتوي = قائمة.يحتوي(3)
اطبع("يحتوي_3=" + يحتوي)

# التكرار مع الفهرس
متغير حروف = ["أ"، "ب"، "ج"، "د"، "هـ"]
متغير ع = 0
بينما (ع < حروف.الطول())
   اطبع("حرف[" + ع + "]=" + حروف[ع])
   ع = ع + 1
نهاية

# بناء مصفوفة بحلقة
متغير مربعات = []
متغير ي = 1
بينما (ي <= 10)
   مربعات.أضف(ي * ي)
   ي = ي + 1
نهاية
اطبع("مربعات_10=" + مربعات[9])

# مصفوفة من كائنات
صنف نقطة
   باني(س، ص)
      هذا.س = س
      هذا.ص = ص
   نهاية
نهاية

متغير نقاط = []
نقاط.أضف(جديد نقطة(1، 2))
نقاط.أضف(جديد نقطة(3، 4))
نقاط.أضف(جديد نقطة(5، 6))
اطبع("نقطة1_س=" + نقاط[0].س)
اطبع("نقطة2_ص=" + نقاط[1].ص)
اطبع("عدد_نقاط=" + نقاط.الطول())
