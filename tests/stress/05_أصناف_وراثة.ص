# اختبار 05: الأصناف والوراثة
# ═══════════════════════════════════

# صنف بسيط
صنف شكل
   باني(اللون)
      هذا.اللون = اللون
   نهاية
   
   دالة وصف()
      ارجع "شكل بلون " + هذا.اللون
   نهاية
نهاية

متغير ش = جديد شكل("أحمر")
اطبع("وصف=" + ش.وصف())
اطبع("لون=" + ش.اللون)

# وراثة
صنف مستطيل يرث شكل
   باني(اللون، العرض، الارتفاع)
      أساس.باني(اللون)
      هذا.العرض = العرض
      هذا.الارتفاع = الارتفاع
   نهاية
   
   دالة المساحة()
      ارجع هذا.العرض * هذا.الارتفاع
   نهاية
   
   دالة وصف()
      ارجع "مستطيل " + هذا.العرض + "×" + هذا.الارتفاع + " " + هذا.اللون
   نهاية
نهاية

متغير م = جديد مستطيل("أزرق"، 5، 3)
اطبع("مساحة=" + م.المساحة())
اطبع("وصف_م=" + م.وصف())
اطبع("لون_م=" + م.اللون)

# صنف دائرة
صنف دائرة يرث شكل
   باني(اللون، نق)
      أساس.باني(اللون)
      هذا.نصف_القطر = نق
   نهاية
   
   دالة المساحة()
      ارجع 3.14159 * هذا.نصف_القطر * هذا.نصف_القطر
   نهاية
نهاية

متغير د = جديد دائرة("أخضر"، 7)
اطبع("مساحة_دائرة=" + د.المساحة())
