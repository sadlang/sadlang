# عكس مصفوفة
دالة اعكس(مصف)
   متغير نتيجة = []
   متغير ع = مصف.الطول() - 1
   بينما (ع >= 0)
      نتيجة.أضف(مصف[ع])
      ع = ع - 1
   نهاية
   ارجع نتيجة
نهاية

متغير أصلية = [1، 2، 3، 4، 5]
متغير معكوسة = اعكس(أصلية)
اطبع("معكوس_أول=" + معكوسة[0])
اطبع("معكوس_آخر=" + معكوسة[4])

# أقصى وأدنى
دالة أقصى(مصف)
   متغير أكبر = مصف[0]
   لكل ع في مصف
      إذا (ع > أكبر)
         أكبر = ع
      نهاية
   نهاية
   ارجع أكبر
نهاية

دالة أدنى(مصف)
   متغير أصغر = مصف[0]
   لكل ع في مصف
      إذا (ع < أصغر)
         أصغر = ع
      نهاية
   نهاية
   ارجع أصغر
نهاية

متغير بيانات = [34، 7، 23، 32، 5، 62، 14، 98، 2]
اطبع("أقصى=" + أقصى(بيانات))
اطبع("أدنى=" + أدنى(بيانات))

# متوسط
دالة متوسط(مصف)
   متغير مجموع = 0
   لكل ع في مصف
      مجموع = مجموع + ع
   نهاية
   ارجع مجموع / مصف.الطول()
نهاية
اطبع("متوسط=" + متوسط(بيانات))

# عد العناصر التي تحقق شرط
دالة عد_إذا(مصف، حد)
   متغير عدد = 0
   لكل ع في مصف
      إذا (ع > حد)
         عدد = عدد + 1
      نهاية
   نهاية
   ارجع عدد
نهاية
اطبع("أكبر_من_20=" + عد_إذا(بيانات، 20))
