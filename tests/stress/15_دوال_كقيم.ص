# تمرير دالة كمعامل
دالة طبق(دالة_ف، قيمة)
   ارجع دالة_ف(قيمة)
نهاية

دالة ضعف(ن)
   ارجع ن * 2
نهاية

دالة مربع(ن)
   ارجع ن * ن
نهاية

اطبع("ضعف_5=" + طبق(ضعف، 5))
اطبع("مربع_5=" + طبق(مربع، 5))

# دالة تعيد دالة
دالة مضاعف(عامل)
   دالة داخلية(ن)
      ارجع ن * عامل
   نهاية
   ارجع داخلية
نهاية

متغير ضرب3 = مضاعف(3)
متغير ضرب5 = مضاعف(5)
اطبع("ضرب3_4=" + ضرب3(4))
اطبع("ضرب5_4=" + ضرب5(4))

# تطبيق على مصفوفة يدوياً
دالة تطبيق_على_كل(مصف، دالة_ف)
   متغير نتيجة = []
   لكل عنصر في مصف
      نتيجة.أضف(دالة_ف(عنصر))
   نهاية
   ارجع نتيجة
نهاية

متغير أرقام = [1، 2، 3، 4، 5]
متغير مربعات = تطبيق_على_كل(أرقام، مربع)
لكل م في مربعات
   اطبع("مربع:" + م)
نهاية
