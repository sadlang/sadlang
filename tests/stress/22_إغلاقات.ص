# عداد بإغلاق
دالة عداد_جديد()
   متغير عدد = 0
   
   دالة زيادة()
      عدد = عدد + 1
      ارجع عدد
   نهاية
   
   ارجع زيادة
نهاية

متغير ع1 = عداد_جديد()
اطبع("ع1_1=" + ع1())
اطبع("ع1_2=" + ع1())
اطبع("ع1_3=" + ع1())

متغير ع2 = عداد_جديد()
اطبع("ع2_1=" + ع2())

# إغلاق مع معاملات
دالة مُنشئ_مرشح(الحد)
   دالة مرشح(قيمة)
      ارجع قيمة > الحد
   نهاية
   ارجع مرشح
نهاية

متغير أكبر_من_5 = مُنشئ_مرشح(5)
اطبع("3>5=" + أكبر_من_5(3))
اطبع("10>5=" + أكبر_من_5(10))

# إغلاق يلتقط متغيرات متعددة  
دالة حاسبة(عملية، أ، ب)
   إذا (عملية == "جمع")
      ارجع أ + ب
   والا_اذا (عملية == "طرح")
      ارجع أ - ب
   والا_اذا (عملية == "ضرب")
      ارجع أ * ب
   وإلا
      ارجع أ / ب
   نهاية
نهاية

اطبع("جمع=" + حاسبة("جمع"، 10، 5))
اطبع("طرح=" + حاسبة("طرح"، 10، 5))
اطبع("ضرب=" + حاسبة("ضرب"، 10، 5))
