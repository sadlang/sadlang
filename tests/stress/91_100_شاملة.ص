# 91: مترجم عمليات حسابية بسيط
دالة حساب(عملية، أ، ب)
   حالة (عملية)
      عندما "+"
         ارجع أ + ب
      عندما "-"
         ارجع أ - ب
      عندما "*"
         ارجع أ * ب
      عندما "/"
         إذا (ب == 0)
            ارجع "خطأ: قسمة على صفر"
         نهاية
         ارجع أ / ب
      افتراضي
         ارجع "عملية غير معروفة"
   نهاية
نهاية

اطبع("3+4=" + حساب("+"، 3، 4))
اطبع("10-3=" + حساب("-"، 10، 3))
اطبع("6*7=" + حساب("*"، 6، 7))
اطبع("10/3=" + حساب("/"، 10، 3))
اطبع("10/0=" + حساب("/"، 10، 0))

