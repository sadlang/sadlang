# 93: نظام أحداث مع بيانات
صنف ناقل_أحداث
   باني()
      هذا.أحداث = {}
   نهاية
   
   دالة سجل(اسم_حدث، معالج)
      إذا (هذا.أحداث[اسم_حدث] == عدم)
         هذا.أحداث[اسم_حدث] = []
      نهاية
      هذا.أحداث[اسم_حدث].أضف(معالج)
   نهاية
   
   دالة أطلق(اسم_حدث، بيانات)
      إذا (هذا.أحداث[اسم_حدث] != عدم)
         لكل م في هذا.أحداث[اسم_حدث]
            م(بيانات)
         نهاية
      نهاية
   نهاية
نهاية

