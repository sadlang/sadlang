# 100: اختبار شامل نهائي
صنف مشروع
   باني(الاسم)
      هذا.الاسم = الاسم
      هذا.مهام = []
      هذا.انتهى = خطأ
   نهاية
   
   دالة أضف_مهمة(عنوان)
      هذا.مهام.أضف({"عنوان": عنوان، "حالة": "جديد"})
   نهاية
   
   دالة نسبة_الإنجاز()
      إذا (هذا.مهام.الطول() == 0)
         ارجع 0
      نهاية
      متغير مكتملة = 0
      لكل م في هذا.مهام
         إذا (م["حالة"] == "مكتمل")
            مكتملة = مكتملة + 1
         نهاية
      نهاية
      ارجع (مكتملة * 100) / هذا.مهام.الطول()
   نهاية
نهاية

متغير مشروعي = جديد مشروع("لغة ص")
مشروعي.أضف_مهمة("المحلل المعجمي")
مشروعي.أضف_مهمة("المحلل النحوي")
مشروعي.أضف_مهمة("المفسر")
مشروعي.مهام[0]["حالة"] = "مكتمل"
مشروعي.مهام[1]["حالة"] = "مكتمل"
اطبع("مشروع=" + مشروعي.الاسم)
اطبع("إنجاز=" + مشروعي.نسبة_الإنجاز() + "%")
اطبع("========== انتهت جميع الاختبارات ==========")
