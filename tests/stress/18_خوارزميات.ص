# بحث خطي
دالة بحث_خطي(مصف، هدف)
   متغير ع = 0
   بينما (ع < مصف.الطول())
      إذا (مصف[ع] == هدف)
         ارجع ع
      نهاية
      ع = ع + 1
   نهاية
   ارجع -1
نهاية

متغير بيانات = [5، 3، 8، 1، 9، 2، 7]
اطبع("بحث_8=" + بحث_خطي(بيانات، 8))
اطبع("بحث_10=" + بحث_خطي(بيانات، 10))

# فرز فقاعي
دالة فرز_فقاعي(مصف)
   متغير ن = مصف.الطول()
   متغير ع = 0
   بينما (ع < ن - 1)
      متغير ي = 0
      بينما (ي < ن - ع - 1)
         إذا (مصف[ي] > مصف[ي + 1])
            متغير مؤقت = مصف[ي]
            مصف[ي] = مصف[ي + 1]
            مصف[ي + 1] = مؤقت
         نهاية
         ي = ي + 1
      نهاية
      ع = ع + 1
   نهاية
   ارجع مصف
نهاية

متغير غير_مرتبة = [64، 34، 25، 12، 22، 11، 90]
متغير مرتبة = فرز_فقاعي(غير_مرتبة)
اطبع("مرتبة_أول=" + مرتبة[0])
اطبع("مرتبة_آخر=" + مرتبة[6])

# حساب الأعداد الأولية
دالة أولي(ن)
   إذا (ن < 2)
      ارجع خطأ
   نهاية
   متغير ع = 2
   بينما (ع * ع <= ن)
      إذا (ن % ع == 0)
         ارجع خطأ
      نهاية
      ع = ع + 1
   نهاية
   ارجع صحيح
نهاية

متغير أوليات = []
متغير ع2 = 2
بينما (ع2 <= 30)
   إذا (أولي(ع2))
      أوليات.أضف(ع2)
   نهاية
   ع2 = ع2 + 1
نهاية
اطبع("عدد_أوليات=" + أوليات.الطول())

# GCD (القاسم المشترك الأكبر)
دالة قمأ(أ، ب)
   بينما (ب != 0)
      متغير مؤقت = ب
      ب = أ % ب
      أ = مؤقت
   نهاية
   ارجع أ
نهاية
اطبع("قمأ_12_8=" + قمأ(12، 8))
اطبع("قمأ_100_75=" + قمأ(100، 75))
