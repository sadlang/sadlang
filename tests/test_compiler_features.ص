# اختبار الميزات الجديدة في المترجم
# Test new features in compiler

# اختبار 1: القسمة الحقيقية
متغير نتيجة_القسمة = 7 / 2
اطبع("اختبار القسمة: " + نتيجة_القسمة)

# اختبار 2: مصفوفة حرفية
متغير ارقام = [1, 2, 3, 4, 5]
اطبع("المصفوفة: " + ارقام)

# اختبار 3: الوصول بالفهرس
متغير اول = ارقام[0]
اطبع("العنصر الاول: " + اول)

# اختبار 4: NOT بتي
متغير قيمة = ~0
اطبع("~0 = " + قيمة)

# اختبار 5: نطاق
متغير نطاق = 1..5
اطبع("النطاق: " + نطاق)
