# اختبار شامل للميزات الأساسية

# 1. المتغيرات والأنواع
متغير عدد = 42
متغير رسالة = "مرحبا بالعالم"
متغير صح = صحيح
متغير قائمة = [1, 2, 3, 4, 5]
متغير بيانات = {"اسم": "أحمد", "عمر": 25}
اطبع_سطر("1. المتغيرات: " + عدد + " " + رسالة + " " + صح)

# 2. الدوال
دالة مربع(س)
    ارجع س * س
نهاية
اطبع_سطر("2. مربع(7) = " + مربع(7))

# 3. الدوال المتكررة (Recursion)
دالة عاملي(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * عاملي(ن - 1)
نهاية
اطبع_سطر("3. عاملي(5) = " + عاملي(5))

# 4. التكرار على مصفوفة
اطبع("4. المصفوفة: ")
لكل عنصر في قائمة
    اطبع(عنصر + " ")
نهاية
اطبع_سطر("")

# 5. الخرائط (Maps)
اطبع_سطر("5. الاسم: " + بيانات["اسم"] + "، العمر: " + بيانات["عمر"])

# 6. الوراثة (OOP)
صنف حيوان
    باني(أ، ب)
        هذا.الاسم = أ
        هذا.الصوت = ب
    نهاية
    
    دالة تكلم()
        ارجع هذا.الاسم + " يقول: " + هذا.الصوت
    نهاية
نهاية

متغير قطة = جديد حيوان("القطة"، "مياو")
اطبع_سطر("6. " + قطة.تكلم())

# 7. لامدا مع إغلاق
دالة مضاعف(معامل)
    ارجع لامدا س: س * معامل
نهاية

متغير ثلث = مضاعف(3)
اطبع_سطر("7. ثلث(4) = " + ثلث(4))

# 8. المولدات
دالة مولد فيبوناتشي(ن)
    متغير أ = 0
    متغير ب = 1
    متغير ع = 0
    بينما (ع < ن)
        أنتج أ
        متغير ت = أ + ب
        أ = ب
        ب = ت
        ع = ع + 1
    نهاية
نهاية

اطبع_سطر("8. فيبوناتشي: " + فيبوناتشي(8))

# 9. حاول/امسك
حاول
    متغير نتيجة = 10 / 0
امسك (هـ)
    اطبع_سطر("9. تم التقاط خطأ: " + هـ)
نهاية

# 10. التعدادات
تعداد الاتجاه
    شمال = 0
