    شرق = 2
    غرب = 3
نهاية
اطبع_سطر("10. شرق = " + الاتجاه.شرق)

# 11. بنية (Struct)
بنية نقطة
    س = 0
    ص = 0
نهاية
متغير ن1 = جديد نقطة()
ن1.س = 10
ن1.ص = 20
اطبع_سطر("11. نقطة: " + ن1.س + "," + ن1.ص)

# 12. مطابقة الأنماط
دالة وصف_عدد(ع)
    طابق (ع)
        حالة 1:
            ارجع "واحد"
        حالة 2:
            ارجع "اثنان"
        حالة 3:
            ارجع "ثلاثة"
        افتراضي:
            ارجع "عدد آخر"
    نهاية
نهاية
اطبع_سطر("12. مطابقة: " + وصف_عدد(2) + "، " + وصف_عدد(5))

# 13. المزخرفات (Decorators)
دالة مسجل(د)
    ارجع د
نهاية

@مسجل
دالة تحية(اسم)
    ارجع "مرحبا " + اسم
نهاية
اطبع_سطر("13. تحية: " + تحية("خالد"))

# 14. حلقة بينما مع عداد
متغير مجموع = 0
متغير ي = 1
بينما (ي <= 10)
    مجموع = مجموع + ي
    ي = ي + 1
نهاية
اطبع_سطر("14. مجموع 1-10 = " + مجموع)

# 15. الدوال المتداخلة
دالة خارجية(س)
    دالة داخلية(ص)
        ارجع س + ص
    نهاية
    ارجع داخلية(10)
نهاية
اطبع_سطر("15. متداخلة: " + خارجية(5))

