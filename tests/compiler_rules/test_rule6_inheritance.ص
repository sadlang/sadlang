# اختبار القاعدة 6-2: الوراثة وتعدد الأشكال
# يغطي: وراثة، إعادة تعريف طرق، استدعاء الأساس

اطبع_سطر("=== اختبار الوراثة ===")

# === 1. صنف أب ===
صنف شكل
    متغير عام اسم

    باني(اسم)
        هذا.اسم = اسم
    نهاية

    دالة عام وصف()
        ارجع "شكل: " + هذا.اسم
    نهاية

    دالة عام المساحة()
        ارجع 0
    نهاية
نهاية

# === 2. صنف ابن — مربع ===
صنف مربع_شكل يرث شكل
    متغير عام ضلع

    باني(ضلع)
        الأساس("مربع")
        هذا.ضلع = ضلع
    نهاية

    دالة عام المساحة()
        ارجع هذا.ضلع * هذا.ضلع
    نهاية

    دالة عام المحيط()
        ارجع 4 * هذا.ضلع
    نهاية
نهاية

# === 3. صنف ابن — دائرة ===
صنف دائرة_شكل يرث شكل
    متغير عام نصف_قطر

    باني(نصف_قطر)
        الأساس("دائرة")
        هذا.نصف_قطر = نصف_قطر
    نهاية

    دالة عام المساحة()
        ارجع 3 * هذا.نصف_قطر * هذا.نصف_قطر
    نهاية
نهاية

# === إنشاء واختبار ===
متغير ش1 = جديد مربع_شكل(5)
متغير ش2 = جديد دائرة_شكل(7)

اطبع_سطر(ش1.وصف())
اطبع_سطر("مساحة المربع: " + ش1.المساحة())
اطبع_سطر("محيط المربع: " + ش1.المحيط())

اطبع_سطر(ش2.وصف())
اطبع_سطر("مساحة الدائرة: " + ش2.المساحة())

# === 4. وراثة متعددة المستويات ===
صنف حيوان
    متغير عام نوع

    باني(نوع)
        هذا.نوع = نوع
    نهاية

    دالة عام صوت()
        ارجع "..."
    نهاية
نهاية

صنف قطة يرث حيوان
    باني()
        الأساس("قطة")
    نهاية

    دالة عام صوت()
        ارجع "مياو"
    نهاية
نهاية

صنف كلب يرث حيوان
    باني()
        الأساس("كلب")
    نهاية

    دالة عام صوت()
        ارجع "هاو"
    نهاية
نهاية

متغير ق = جديد قطة()
متغير ك = جديد كلب()
اطبع_سطر(ق.نوع + ": " + ق.صوت())
اطبع_سطر(ك.نوع + ": " + ك.صوت())
