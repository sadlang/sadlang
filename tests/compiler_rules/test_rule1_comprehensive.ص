# === 4. خوارزمية GCD (القاسم المشترك الأكبر) ===
دالة قمأ(أ، ب)
    بينما (ب != 0)
        متغير باقي = أ % ب
        أ = ب
        ب = باقي
    نهاية
    ارجع أ
نهاية
اطبع_سطر("قمأ(48,18) = " + قمأ(48, 18))
اطبع_سطر("قمأ(100,75) = " + قمأ(100, 75))

# === 5. برج هانوي (عدد الحركات) ===
دالة هانوي(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع 2 * هانوي(ن - 1) + 1
نهاية
اطبع_سطر("حركات هانوي(5): " + هانوي(5))
اطبع_سطر("حركات هانوي(10): " + هانوي(10))

# === 6. سلسلة كولاتز ===
دالة كولاتز(ن)
    متغير خطوات = 0
    بينما (ن != 1)
        إذا (ن % 2 == 0)
            ن = ن / 2
        وإلا
            ن = ن * 3 + 1
        نهاية
        خطوات = خطوات + 1
    نهاية
    ارجع خطوات
نهاية
اطبع_سطر("كولاتز(27): " + كولاتز(27))
اطبع_سطر("كولاتز(97): " + كولاتز(97))

# === 7. مصفوفة تراكمية ===
دالة تراكمي(مصف)
    متغير نتيجة = []
    متغير مجموع = 0
    لكل عنصر في مصف
        مجموع = مجموع + عنصر
        نتيجة.اضف(مجموع)
    نهاية
    ارجع نتيجة
نهاية

متغير أصلية = [1, 2, 3, 4, 5]
متغير تراكمية = تراكمي(أصلية)
متغير نص_نتيجة = ""
لكل ق في تراكمية
    إذا (نص_نتيجة != "")
        نص_نتيجة = نص_نتيجة + ","
    نهاية
    نص_نتيجة = نص_نتيجة + ق
نهاية
اطبع_سطر("تراكمية: " + نص_نتيجة)

# === 8. متوسط حسابي ===
دالة متوسط(مصف)
    متغير مج = 0
    لكل ع في مصف
        مج = مج + ع
    نهاية
    ارجع مج / طول(مصف)
نهاية
اطبع_سطر("متوسط [10,20,30,40,50]: " + متوسط([10,20,30,40,50]))

