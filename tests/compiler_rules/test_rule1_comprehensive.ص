# === 1. دالة Bubble Sort ===
دالة ترتيب_فقاعي(مصف)
    متغير ن = طول(مصف)
    لكل ع من 0 الى ن
        لكل ي من 0 الى ن - 1
            إذا (ي + 1 < ن)
                إذا (مصف[ي] > مصف[ي + 1])
                    متغير مؤقت = مصف[ي]
                    مصف[ي] = مصف[ي + 1]
                    مصف[ي + 1] = مؤقت
                نهاية
            نهاية
        نهاية
    نهاية
    ارجع مصف
نهاية

متغير بيانات = [64, 34, 25, 12, 22, 11, 90]
بيانات = ترتيب_فقاعي(بيانات)
متغير مرتبة = ""
لكل عنصر في بيانات
    إذا (مرتبة != "")
        مرتبة = مرتبة + ","
    نهاية
    مرتبة = مرتبة + عنصر
نهاية
اطبع_سطر("مرتبة: " + مرتبة)

# === 2. عد الأحرف بالحلقة ===
دالة عد_حرف(نص، حرف)
    متغير عدد = 0
    لكل ح في نص
        إذا (ح == حرف)
            عدد = عدد + 1
        نهاية
    نهاية
    ارجع عدد
نهاية

# === 3. دالة العدد الأولي ===
دالة أولي(ن)
    إذا (ن < 2)
        ارجع خطأ
    نهاية
    متغير ع = 2
    بينما (ع * ع <= ن)
        إذا (ن % ع == 0)
            ارجع خطأ
        نهاية
        ع = ع + 1
    نهاية
    ارجع صحيح
نهاية

# جمع الأعداد الأولية حتى 30
متغير مجموع_أولي = 0
متغير عدد_أولي = 0
لكل ر من 2 الى 31
    إذا (أولي(ر))
        مجموع_أولي = مجموع_أولي + ر
        عدد_أولي = عدد_أولي + 1
    نهاية
نهاية
اطبع_سطر("عدد الأعداد الأولية حتى 30: " + عدد_أولي)
