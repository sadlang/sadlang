# === 3. شروط منطقية معقدة ===
متغير عمر = 25
متغير لديه_رخصة = صحيح
إذا (عمر >= 18 و لديه_رخصة)
    اطبع_سطر("يمكنه القيادة")
نهاية

إذا (عمر < 18 أو ليس لديه_رخصة)
    اطبع_سطر("لا يمكنه القيادة")
وإلا
    اطبع_سطر("مؤهل للقيادة")
نهاية

# === 4. حلقة بينما ===
اطبع_سطر("=== اختبار بينما ===")
متغير عداد = 1
متغير مجموع = 0
بينما (عداد <= 10)
    مجموع = مجموع + عداد
    عداد = عداد + 1
نهاية
اطبع_سطر("مجموع 1-10: " + مجموع)

# === 5. بينما مع توقف ===
متغير ع = 0
بينما (صحيح)
    ع = ع + 1
    إذا (ع == 5)
        توقف
    نهاية
نهاية
اطبع_سطر("توقف عند: " + ع)

# === 6. بينما مع استمر ===
متغير مج = 0
متغير ي = 0
بينما (ي < 10)
    ي = ي + 1
    إذا (ي % 2 == 0)
        استمر
    نهاية
    مج = مج + ي
نهاية
اطبع_سطر("مجموع الفردية: " + مج)

# === 7. لكل على مصفوفة ===
اطبع_سطر("=== اختبار لكل ===")
متغير أعداد = [10, 20, 30, 40, 50]
متغير حاصل = 0
لكل عنصر في أعداد
    حاصل = حاصل + عنصر
نهاية
اطبع_سطر("مجموع المصفوفة: " + حاصل)

# === 8. لكل على نطاق ===
متغير ضرب = 1
لكل ن من 1 الى 6
    ضرب = ضرب * ن
نهاية
اطبع_سطر("مضروب 5: " + ضرب)

# === 9. حلقات متداخلة ===
متغير نتيجة = ""
لكل ص من 1 الى 4
    لكل ض من 1 الى 4
        إذا (ص == ض)
            نتيجة = نتيجة + "*"
        وإلا
            نتيجة = نتيجة + "."
        نهاية
    نهاية
    نتيجة = نتيجة + "|"
نهاية
اطبع_سطر("مصفوفة: " + نتيجة)

# === 10. حلقة بتصفية ===
متغير كبيرة = 0
لكل رقم في [5, 12, 3, 18, 7, 25, 1]
    إذا (رقم > 10)
        كبيرة = كبيرة + 1
    نهاية
نهاية
اطبع_سطر("أعداد > 10: " + كبيرة)
