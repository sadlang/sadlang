# اختبار القاعدة 1-2: الشروط (إذا/وإلا) والحلقات (بينما/لكل)
# يغطي: إذا متداخل، وإلا إذا، بينما، لكل في، لكل من..الى

اطبع_سطر("=== اختبار الشروط ===")

# === 1. إذا بسيط ===
متغير قيمة = 42
إذا (قيمة > 0)
    اطبع_سطر("موجب")
نهاية

# === 2. إذا/وإلا ===
متغير درجة = 75
إذا (درجة >= 90)
    اطبع_سطر("ممتاز")
وإلا
    إذا (درجة >= 70)
        اطبع_سطر("جيد")
    وإلا
        اطبع_سطر("مقبول")
    نهاية
