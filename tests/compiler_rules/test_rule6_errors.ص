# اختبار القاعدة 6-5: معالجة الأخطاء (حاول/امسك/ارمي)
# يغطي: حاول/امسك، ارمي خطأ، أخيراً

اطبع_سطر("=== اختبار الأخطاء ===")

# === 1. حاول/امسك بسيط ===
حاول
    اطبع_سطر("قبل الخطأ")
    ارمي "خطأ تجريبي!"
    اطبع_سطر("لن يُطبع")
امسك خطأ
    اطبع_سطر("تم التقاط: " + خطأ)
نهاية

# === 2. حاول/امسك في دالة ===
دالة قسمة_آمنة(أ، ب)
    إذا (ب == 0)
        ارمي "قسمة على صفر!"
    نهاية
    ارجع أ / ب
نهاية

حاول
    اطبع_سطر("10/2 = " + قسمة_آمنة(10, 2))
    اطبع_سطر("10/0 = " + قسمة_آمنة(10, 0))
امسك خطأ
    اطبع_سطر("خطأ: " + خطأ)
نهاية

# === 3. حاول متداخل ===
حاول
    اطبع_سطر("المستوى الخارجي")
    حاول
        ارمي "خطأ داخلي"
    امسك خطأ
        اطبع_سطر("التقاط داخلي: " + خطأ)
    نهاية
    اطبع_سطر("بعد الالتقاط الداخلي")
امسك خطأ
    اطبع_سطر("التقاط خارجي: " + خطأ)
نهاية

# === 4. تصنيف أخطاء ===
دالة فحص_عمر(عمر)
    إذا (عمر < 0)
        ارمي "عمر سالب"
    نهاية
    إذا (عمر > 150)
        ارمي "عمر غير واقعي"
    نهاية
    ارجع "عمر صالح: " + عمر
نهاية

لكل عمر في [25, -5, 200, 30]
    حاول
        اطبع_سطر(فحص_عمر(عمر))
    امسك خطأ
        اطبع_سطر("فشل: " + خطأ)
    نهاية
نهاية
