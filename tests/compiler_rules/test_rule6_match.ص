# اختبار القاعدة 6-3: مطابقة الأنماط (طابق/عندما)
# يغطي: مطابقة قيم حرفية، افتراضي، ربط متغيرات

اطبع_سطر("=== اختبار المطابقة ===")

# === 1. مطابقة أرقام ===
دالة وصف_رقم(ن)
    طابق (ن)
        عندما 1:
            ارجع "واحد"
        عندما 2:
            ارجع "اثنان"
        عندما 3:
            ارجع "ثلاثة"
        افتراضي:
            ارجع "عدد آخر"
    نهاية
نهاية

اطبع_سطر(وصف_رقم(1))
اطبع_سطر(وصف_رقم(2))
اطبع_سطر(وصف_رقم(3))
اطبع_سطر(وصف_رقم(99))

# === 2. مطابقة في حلقة ===
لكل ع من 1 الى 6
    متغير نتيجة = ""
    طابق (ع % 3)
        عندما 0:
            نتيجة = "قابل للقسمة على 3"
        عندما 1:
            نتيجة = "باقي 1"
        عندما 2:
            نتيجة = "باقي 2"
    نهاية
    اطبع_سطر(ع + ": " + نتيجة)
نهاية

# === 3. مطابقة كتصنيف ===
دالة تصنيف_عمر(عمر)
    إذا (عمر < 13)
        ارجع "طفل"
    وإلا
        إذا (عمر < 20)
            ارجع "مراهق"
        وإلا
            إذا (عمر < 60)
                ارجع "بالغ"
            وإلا
                ارجع "كبير"
            نهاية
        نهاية
    نهاية
نهاية

اطبع_سطر("عمر 5: " + تصنيف_عمر(5))
اطبع_سطر("عمر 15: " + تصنيف_عمر(15))
اطبع_سطر("عمر 30: " + تصنيف_عمر(30))
اطبع_سطر("عمر 70: " + تصنيف_عمر(70))

# === 4. دالة مع طابق لحساب يوم الأسبوع ===
دالة يوم_الأسبوع(رقم_يوم)
    طابق (رقم_يوم)
        عندما 1:
            ارجع "الأحد"
        عندما 2:
            ارجع "الاثنين"
        عندما 3:
            ارجع "الثلاثاء"
        عندما 4:
            ارجع "الأربعاء"
        عندما 5:
            ارجع "الخميس"
        عندما 6:
            ارجع "الجمعة"
        عندما 7:
            ارجع "السبت"
        افتراضي:
            ارجع "غير معروف"
    نهاية
نهاية

لكل ي من 1 الى 8
    اطبع_سطر("يوم " + ي + ": " + يوم_الأسبوع(ي))
نهاية
