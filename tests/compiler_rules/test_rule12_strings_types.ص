# ========================================
# اختبار 3: دالة تُنشئ نصاً
# ========================================
دالة تكرار_نص(نص، عدد)
    متغير ناتج = ""
    متغير ي = 0
    بينما (ي < عدد)
        ناتج = ناتج + نص
        ي = ي + 1
    نهاية
    ارجع ناتج
نهاية

اطبع_سطر("اختبار 3: " + تكرار_نص("ها", 3))
اطبع_سطر("اختبار 3: " + تكرار_نص("*", 5))

