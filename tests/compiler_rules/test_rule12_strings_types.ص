# ========================================
# اختبار 5: سلسلة عمليات شرطية
# ========================================
دالة تصنيف_درجة(درجة)
    إذا (درجة >= 90)
        ارجع "ممتاز"
    وإلا
        إذا (درجة >= 80)
            ارجع "جيد جداً"
        وإلا
            إذا (درجة >= 70)
                ارجع "جيد"
            وإلا
                إذا (درجة >= 60)
                    ارجع "مقبول"
                وإلا
                    ارجع "راسب"
                نهاية
            نهاية
        نهاية
    نهاية
نهاية

اطبع_سطر("اختبار 5: 95 = " + تصنيف_درجة(95))
اطبع_سطر("اختبار 5: 75 = " + تصنيف_درجة(75))
اطبع_سطر("اختبار 5: 55 = " + تصنيف_درجة(55))

