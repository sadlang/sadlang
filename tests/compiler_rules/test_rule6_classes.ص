# اختبار القاعدة 6-1: البرمجة الكائنية — الأصناف والباني والأعضاء
# يغطي: تعريف صنف، باني، أعضاء، إنشاء كائنات، استدعاء طرق

اطبع_سطر("=== اختبار الأصناف ===")

# === 1. صنف بسيط ===
صنف نقطة
    متغير عام س
    متغير عام ص

    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة عام وصف()
        ارجع "(" + هذا.س + "," + هذا.ص + ")"
    نهاية

    دالة عام مسافة_من_الأصل()
        ارجع هذا.س * هذا.س + هذا.ص * هذا.ص
    نهاية
نهاية

متغير ن1 = جديد نقطة(3, 4)
اطبع_سطر("نقطة: " + ن1.وصف())
اطبع_سطر("مسافة²: " + ن1.مسافة_من_الأصل())

# === 2. صنف مع عداد ===
صنف عداد
    متغير عام قيمة

    باني(بداية)
        هذا.قيمة = بداية
    نهاية

    دالة عام زد()
        هذا.قيمة = هذا.قيمة + 1
    نهاية

    دالة عام أنقص()
        هذا.قيمة = هذا.قيمة - 1
    نهاية

    دالة عام احصل()
        ارجع هذا.قيمة
    نهاية
نهاية

متغير ع = جديد عداد(0)
ع.زد()
ع.زد()
ع.زد()
ع.أنقص()
اطبع_سطر("العداد: " + ع.احصل())

# === 3. صنف مستطيل ===
صنف مستطيل
    متغير عام عرض
    متغير عام ارتفاع

    باني(عرض، ارتفاع)
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية

    دالة عام المساحة()
        ارجع هذا.عرض * هذا.ارتفاع
    نهاية

    دالة عام المحيط()
        ارجع 2 * (هذا.عرض + هذا.ارتفاع)
    نهاية

    دالة عام مربع()
        ارجع هذا.عرض == هذا.ارتفاع
    نهاية
نهاية

متغير م = جديد مستطيل(5, 3)
اطبع_سطر("مساحة 5×3: " + م.المساحة())
اطبع_سطر("محيط 5×3: " + م.المحيط())
اطبع_سطر("مربع: " + م.مربع())

متغير م2 = جديد مستطيل(4, 4)
اطبع_سطر("مربع 4×4: " + م2.مربع())

# === 4. تعديل أعضاء مباشرة ===
ن1.س = 10
اطبع_سطر("بعد التعديل: " + ن1.وصف())
