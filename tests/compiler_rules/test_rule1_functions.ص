# اختبار القاعدة 1-3: الدوال (تعريف، استدعاء، تداخل، إعادة تكرار)
# يغطي: دوال بسيطة، دوال بقيم افتراضية، دوال متداخلة، تكرار (recursion)

اطبع_سطر("=== اختبار الدوال ===")

# === 1. دالة بسيطة ===
دالة تحية(اسم)
    ارجع "مرحباً يا " + اسم + "!"
نهاية
اطبع_سطر(تحية("أحمد"))

# === 2. دالة حسابية ===
دالة جمع(أ، ب)
    ارجع أ + ب
نهاية
اطبع_سطر("3+7 = " + جمع(3, 7))

# === 3. دالة بقيمة افتراضية ===
دالة قوة(قاعدة، أس = 2)
    متغير نتيجة = 1
    لكل ع من 1 الى أس + 1
        نتيجة = نتيجة * قاعدة
    نهاية
    ارجع نتيجة
نهاية
اطبع_سطر("3^2 = " + قوة(3))
اطبع_سطر("2^5 = " + قوة(2, 5))

# === 4. دالة تكرارية (فيبوناتشي) ===
دالة فيب(ن)
    إذا (ن <= 1)
        ارجع ن
    نهاية
    ارجع فيب(ن - 1) + فيب(ن - 2)
نهاية
اطبع_سطر("فيب(10) = " + فيب(10))

# === 5. دالة تكرارية (مضروب) ===
دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية
اطبع_سطر("مضروب(7) = " + مضروب(7))

# === 6. دوال متعددة المعاملات ===
دالة أكبر_ثلاثة(أ، ب، ج)
    متغير نتيجة = أ
    إذا (ب > نتيجة)
        نتيجة = ب
    نهاية
    إذا (ج > نتيجة)
        نتيجة = ج
    نهاية
    ارجع نتيجة
نهاية
اطبع_سطر("أكبر(5,9,3) = " + أكبر_ثلاثة(5, 9, 3))

# === 7. دالة تعيد منطقي ===
دالة زوجي(ن)
    ارجع ن % 2 == 0
نهاية
اطبع_سطر("4 زوجي: " + زوجي(4))
اطبع_سطر("7 زوجي: " + زوجي(7))

# === 8. دالة تعالج نصوص ===
دالة كرر_نص(نص، عدد)
    متغير نتيجة = ""
    لكل ع من 1 الى عدد + 1
        نتيجة = نتيجة + نص
    نهاية
    ارجع نتيجة
نهاية
اطبع_سطر(كرر_نص("ص", 5))

# === 9. دالة تعمل على مصفوفة ===
دالة مجموع_مصفوفة(مصف)
    متغير مج = 0
    لكل عنصر في مصف
        مج = مج + عنصر
    نهاية
    ارجع مج
نهاية
اطبع_سطر("مجموع [1,2,3,4,5] = " + مجموع_مصفوفة([1,2,3,4,5]))

# === 10. دوال متسلسلة ===
دالة مربع(ن)
    ارجع ن * ن
نهاية

دالة مكعب(ن)
    ارجع ن * مربع(ن)
