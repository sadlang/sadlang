# اختبار Lambda والاستدعاء غير المباشر
# المفسر يجب أن ينتج المخرجات الصحيحة أولاً

# ===== 1. Lambda بسيطة =====
متغير مضاعف = لامدا(س) ارجع س * 2 نهاية
اطبع_سطر("مضاعف(5) = " + مضاعف(5))

# ===== 2. Lambda مع closure =====
متغير عامل = 10
متغير ضرب = لامدا(س) ارجع س * عامل نهاية
اطبع_سطر("ضرب(3) = " + ضرب(3))

# ===== 3. إرجاع Lambda من دالة =====
دالة صانع_الجامع(ن)
    ارجع لامدا(س) ارجع س + ن نهاية
نهاية

متغير أضف5 = صانع_الجامع(5)
اطبع_سطر("أضف5(10) = " + أضف5(10))

# ===== 4. تمرير دالة كمعامل =====
دالة طبّق(د، قيمة)
    ارجع د(قيمة)
نهاية

اطبع_سطر("طبّق(مضاعف, 9) = " + طبّق(مضاعف، 9))
