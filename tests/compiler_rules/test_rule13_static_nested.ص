# === اختبار القاعدة 13: أعضاء ساكنة + دوال متداخلة + عشريات ===

# === اختبار 1: استدعاء دوال متداخلة ===
دالة مربع(ن)
    ارجع ن * ن
نهاية

دالة مكعب(ن)
    ارجع ن * مربع(ن)
نهاية

دالة مجموع_مكعبات(أ، ب)
    ارجع مكعب(أ) + مكعب(ب)
نهاية

اطبع_سطر("اختبار 1: مجموع_مكعبات(2,3) = " + مجموع_مكعبات(2, 3))

# === اختبار 2: تمرير نتيجة دالة كوسيط ===
دالة جمع(أ، ب)
    ارجع أ + ب
نهاية

دالة ضرب(أ، ب)
    ارجع أ * ب
نهاية

اطبع_سطر("اختبار 2: ضرب(جمع(2,3),4) = " + ضرب(جمع(2, 3), 4))

# === اختبار 3: عمليات عشرية في دوال ===
دالة متوسط(أ، ب)
    ارجع (أ + ب) / 2
نهاية

متغير م = متوسط(10, 20)
اطبع_سطر("اختبار 3: متوسط(10,20) = " + م)

# === اختبار 4: عمليات عشرية مركبة ===
متغير ع1 = 3.14
متغير ع2 = 2.0
متغير ناتج = ع1 * ع2
اطبع_سطر("اختبار 4: 3.14 * 2.0 = " + ناتج)

# === اختبار 5: عشري في شرط ===
متغير حرارة = 37.5
إذا (حرارة > 37.0)
    اطبع_سطر("اختبار 5: حمى")
وإلا
    اطبع_سطر("اختبار 5: طبيعي")
نهاية

# === اختبار 6: سلسلة حسابية ===
دالة حساب(أ، ب، ج)
    ارجع أ * ب + ج
نهاية

اطبع_سطر("اختبار 6: حساب(3,4,5) = " + حساب(3, 4, 5))

# === اختبار 7: تداخل شرطي مع دوال ===
دالة تصنيف(درجة)
    إذا (درجة >= 90)
        ارجع "ممتاز"
    نهاية
    إذا (درجة >= 70)
        ارجع "جيد"
    نهاية
    ارجع "ضعيف"
نهاية

اطبع_سطر("اختبار 7: " + تصنيف(95) + " " + تصنيف(75) + " " + تصنيف(50))
