# اختبار القاعدة 10: OOP متقدم — حقول متعددة، طرق تعمل على الحقول، وراثة مع override
# يختبر: أصناف بحقول متعددة، طرق، وراثة، تعدد الأشكال

# ========================================
# اختبار 1: صنف بحقول متعددة وطريقة
# ========================================
صنف مستطيل
    باني(عرض، ارتفاع)
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية

    دالة المساحة()
        ارجع هذا.عرض * هذا.ارتفاع
    نهاية

    دالة المحيط()
        ارجع 2 * (هذا.عرض + هذا.ارتفاع)
    نهاية
نهاية

متغير م = جديد مستطيل(5، 3)
اطبع_سطر("اختبار 1: مساحة = " + م.المساحة())
اطبع_سطر("اختبار 1: محيط = " + م.المحيط())

# ========================================
# اختبار 2: صنف مع تعديل الحقول
# ========================================
صنف عداد
    باني()
        هذا.قيمة = 0
    نهاية

    دالة زد()
        هذا.قيمة = هذا.قيمة + 1
    نهاية

    دالة انقص()
        هذا.قيمة = هذا.قيمة - 1
    نهاية

    دالة الحالية()
        ارجع هذا.قيمة
    نهاية
نهاية

متغير ع = جديد عداد()
ع.زد()
ع.زد()
ع.زد()
ع.انقص()
اطبع_سطر("اختبار 2: عداد = " + ع.الحالية())

