# ========================================
# اختبار 5: صنف يستخدم دالة خارجية
# ========================================
دالة مربع(ن)
    ارجع ن * ن
نهاية

صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة البعد_عن_الاصل()
        ارجع مربع(هذا.س) + مربع(هذا.ص)
    نهاية
نهاية

