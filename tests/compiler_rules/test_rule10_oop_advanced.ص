# ========================================
# اختبار 6: صنف مع مصفوفة كحقل  
# ========================================
صنف مكدس
    باني()
        هذا.عناصر = []
    نهاية

    دالة ادفع(قيمة)
        هذا.عناصر.اضف(قيمة)
    نهاية

    دالة الحجم()
        ارجع طول(هذا.عناصر)
    نهاية
نهاية

متغير مك = جديد مكدس()
مك.ادفع(10)
مك.ادفع(20)
مك.ادفع(30)
اطبع_سطر("اختبار 6: حجم المكدس = " + مك.الحجم())

# ========================================
# اختبار 7: سلسلة وراثة - الوصول لحقول الأب
# ========================================
صنف شكل
    باني(لون)
        هذا.لون = لون
    نهاية
نهاية

صنف دائرة يرث شكل
    باني(لون، نصف_قطر)
        الأساس(لون)
        هذا.نصف_قطر = نصف_قطر
    نهاية

    دالة المساحة()
        ارجع 3 * هذا.نصف_قطر * هذا.نصف_قطر
    نهاية
نهاية

متغير د = جديد دائرة("أحمر"، 5)
