# ===== اختبار القاعدة 3: معالجة الأخطاء (try/catch/throw) =====

# ----- 1. try/catch بسيط -----
حاول
    ارمي "خطأ بسيط"
امسك خطأ
    اطبع_سطر("اختبار 1: " + خطأ)
نهاية

# ----- 2. try/catch مع عمليات قبل الخطأ -----
حاول
    متغير س = 10
    متغير ص = 20
    اطبع_سطر("اختبار 2: قبل = " + (س + ص))
    ارمي "خطأ بعد العمليات"
امسك خطأ
    اطبع_سطر("اختبار 2: " + خطأ)
نهاية

# ----- 3. try/catch بدون خطأ -----
حاول
    متغير ن = 42
    اطبع_سطر("اختبار 3: لا خطأ = " + ن)
امسك خطأ
    اطبع_سطر("اختبار 3: فشل - لا يجب الوصول هنا")
نهاية

# ----- 4. دالة ترمي خطأ -----
دالة قسمة(أ، ب)
    إذا (ب == 0)
        ارمي "قسمة على صفر"
    نهاية
    ارجع أ / ب
نهاية

حاول
    متغير نتيجة = قسمة(10، 0)
    اطبع_سطر("اختبار 4: فشل")
امسك خطأ
    اطبع_سطر("اختبار 4: " + خطأ)
نهاية

# ----- 5. try/catch مع أخيراً -----
حاول
    اطبع_سطر("اختبار 5: حاول")
    ارمي "خطأ مع أخيراً"
امسك خطأ
    اطبع_سطر("اختبار 5: امسك = " + خطأ)
أخيراً
    اطبع_سطر("اختبار 5: أخيراً")
نهاية
