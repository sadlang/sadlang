# اختبار القاعدة 11: مطابقة أنماط متقدمة + تعدادات + حارسات
# يختبر: match/when مع أنماط مختلفة، تعدادات بقيم، مطابقة نصية

# ========================================
# اختبار 1: مطابقة أرقام بسيطة
# ========================================
دالة اسم_اليوم(رقم)
    طابق (رقم)
        عندما 1:
            ارجع "السبت"
        عندما 2:
            ارجع "الأحد"
        عندما 3:
            ارجع "الاثنين"
        عندما 4:
            ارجع "الثلاثاء"
        عندما 5:
            ارجع "الأربعاء"
        افتراضي:
            ارجع "مجهول"
    نهاية
نهاية

اطبع_سطر("اختبار 1: " + اسم_اليوم(1) + "، " + اسم_اليوم(3) + "، " + اسم_اليوم(7))

# ========================================
# اختبار 2: مطابقة نصوص
# ========================================
دالة رمز_اللون(لون)
    طابق (لون)
        عندما "أحمر":
            ارجع "#FF0000"
        عندما "أخضر":
            ارجع "#00FF00"
        عندما "أزرق":
            ارجع "#0000FF"
        افتراضي:
            ارجع "#000000"
    نهاية
نهاية

اطبع_سطر("اختبار 2: أحمر = " + رمز_اللون("أحمر"))
اطبع_سطر("اختبار 2: أصفر = " + رمز_اللون("أصفر"))

# ========================================
# اختبار 3: مطابقة مع عمليات في الجسم
# ========================================
دالة حساب(عملية، أ، ب)
    طابق (عملية)
        عندما "+":
            ارجع أ + ب
        عندما "-":
            ارجع أ - ب
        عندما "*":
            ارجع أ * ب
        عندما "/":
            ارجع أ / ب
        افتراضي:
            ارجع 0
    نهاية
نهاية

اطبع_سطر("اختبار 3: 10+5 = " + حساب("+", 10, 5))
اطبع_سطر("اختبار 3: 10*3 = " + حساب("*", 10, 3))
اطبع_سطر("اختبار 3: 20-7 = " + حساب("-", 20, 7))

# ========================================
# اختبار 4: تعداد بسيط وقيم
# ========================================
تعداد اتجاه
    شمال
    جنوب
    شرق
    غرب
نهاية

دالة اسم_الاتجاه(ت)
    طابق (ت)
        عندما اتجاه.شمال:
            ارجع "شمال"
        عندما اتجاه.جنوب:
            ارجع "جنوب"
        عندما اتجاه.شرق:
            ارجع "شرق"
        عندما اتجاه.غرب:
            ارجع "غرب"
        افتراضي:
            ارجع "مجهول"
    نهاية
نهاية

متغير ش = اتجاه.شمال
متغير ج = اتجاه.شرق
اطبع_سطر("اختبار 4: " + اسم_الاتجاه(ش) + "، " + اسم_الاتجاه(ج))

# ========================================
# اختبار 5: مطابقة متداخلة مع حلقة
# ========================================
متغير نتائج = ""
متغير ي = 1
بينما (ي <= 5)
    طابق (ي % 2)
        عندما 0:
            نتائج = نتائج + "زوجي "
        عندما 1:
            نتائج = نتائج + "فردي "
        افتراضي:
            نتائج = نتائج + "؟ "
    نهاية
    ي = ي + 1
نهاية
اطبع_سطر("اختبار 5: " + نتائج)

# ========================================
# اختبار 6: مطابقة مع إرجاع منطقي
# ========================================
دالة هل_موجب(ن)
    إذا (ن > 0)
        ارجع صحيح
    نهاية
    ارجع خطأ
نهاية

دالة وصف_رقم(ن)
    إذا (هل_موجب(ن))
        ارجع "موجب"
    وإلا
        ارجع "غير موجب"
    نهاية
نهاية

اطبع_سطر("اختبار 6: " + وصف_رقم(5) + "، " + وصف_رقم(-3) + "، " + وصف_رقم(0))
