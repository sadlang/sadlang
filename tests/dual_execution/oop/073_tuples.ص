# @description اختبار الصفوف (Tuples) — إنشاء، فهرسة، تفكيك، متداخلة
# @expected فارغ:0\nثنائي:أحمد\nثنائي:25\nثلاثي:10\nثلاثي:مرحبا\nثلاثي:صحيح\nواحد:42\nطول:3\nمتداخل:2\nمتداخل:ب\nدالة_أ:2\nدالة_ب:1
# @priority P2
# @skip_compiler الصفوف غير مدعومة في المترجم

# ============================================================
# 1. صف فارغ
# ============================================================
متغير ف = ()
اطبع_سطر("فارغ:" + طول(ف))

# ============================================================
# 2. صف ثنائي — (اسم، عمر)
# ============================================================
متغير شخص = ("أحمد"، 25)
اطبع_سطر("ثنائي:" + شخص[0])
اطبع_سطر("ثنائي:" + شخص[1])

# ============================================================
# 3. صف ثلاثي — أنواع مختلطة
# ============================================================
متغير مختلط = (10، "مرحبا"، صحيح)
اطبع_سطر("ثلاثي:" + مختلط[0])
اطبع_سطر("ثلاثي:" + مختلط[1])
اطبع_سطر("ثلاثي:" + مختلط[2])

# ============================================================
# 4. صف بعنصر واحد (فاصلة أخيرة)
# ============================================================
متغير واحد = (42،)
اطبع_سطر("واحد:" + واحد[0])

# ============================================================
# 5. طول الصف
# ============================================================
متغير ص = (1، 2، 3)
اطبع_سطر("طول:" + طول(ص))

# ============================================================
# 6. صفوف متداخلة
# ============================================================
متغير متداخل = ((1، 2)، ("أ"، "ب"))
اطبع_سطر("متداخل:" + طول(متداخل))
متغير داخلي = متداخل[1]
اطبع_سطر("متداخل:" + داخلي[1])

# ============================================================
# 7. صف كقيمة إرجاع من دالة
# ============================================================
دالة قسمة_باقي(أ، ب)
    ارجع (أ // ب، أ % ب)
نهاية

متغير نتيجة = قسمة_باقي(7، 3)
اطبع_سطر("دالة_أ:" + نتيجة[0])
اطبع_سطر("دالة_ب:" + نتيجة[1])
