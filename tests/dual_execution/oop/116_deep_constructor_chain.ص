# @description اختبار سلسلة بانيات متعددة المستويات مع وراثة
# @expected كائن:قاعدة:1\nكائن:وسط:2:مرحبا\nكائن:فرع:3:عالم:صحيح
# @priority P1

# ============================================================
# 1. سلسلة وراثة ثلاثية مع حقول مختلفة الأنواع
# ============================================================
صنف قاعدة
    متغير عام معرف

    باني(م)
        هذا.معرف = م
    نهاية

    دالة عام وصف()
        ارجع "قاعدة:" + هذا.معرف
    نهاية
نهاية

صنف وسط يرث قاعدة
    متغير عام اسم

    باني(م، ا)
        الأساس(م)
        هذا.اسم = ا
    نهاية

    دالة عام وصف()
        ارجع "وسط:" + هذا.معرف + ":" + هذا.اسم
    نهاية
نهاية

صنف فرع يرث وسط
    متغير عام نشط

    باني(م، ا، ن)
        الأساس(م، ا)
        هذا.نشط = ن
    نهاية

    دالة عام وصف()
        ارجع "فرع:" + هذا.معرف + ":" + هذا.اسم + ":" + هذا.نشط
    نهاية
نهاية

# ============================================================
# 2. إنشاء واستخدام
# ============================================================
متغير ق = قاعدة(1)
متغير و = وسط(2، "مرحبا")
متغير ف = فرع(3، "عالم"، صحيح)

اطبع_سطر("كائن:" + ق.وصف())
اطبع_سطر("كائن:" + و.وصف())
اطبع_سطر("كائن:" + ف.وصف())
