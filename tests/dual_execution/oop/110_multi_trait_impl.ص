# @description اختبار تنفيذ السمات المتعددة على صنف واحد
# @expected قابل_للطباعة:سيارة(تويوتا)\nقابل_للمقارنة:صحيح\nقابل_للمقارنة:خطأ
# @priority P2

# ============================================================
# 1. تعريف سمتين
# ============================================================
سمة قابل_للطباعة
    دالة اطبع_نفسك()
نهاية

سمة قابل_للمقارنة
    دالة يساوي(آخر)
نهاية

# ============================================================
# 2. صنف ينفذ سمتين
# ============================================================
صنف سيارة
    متغير عام الماركة

    باني(ماركة)
        هذا.الماركة = ماركة
    نهاية
نهاية

نفّذ قابل_للطباعة لـ سيارة
    دالة اطبع_نفسك()
        ارجع "سيارة(" + هذا.الماركة + ")"
    نهاية
نهاية

نفّذ قابل_للمقارنة لـ سيارة
    دالة يساوي(آخر)
        ارجع هذا.الماركة == آخر.الماركة
    نهاية
نهاية

# ============================================================
# 3. استخدام
# ============================================================
متغير س1 = سيارة("تويوتا")
متغير س2 = سيارة("تويوتا")
متغير س3 = سيارة("هوندا")

اطبع_سطر("قابل_للطباعة:" + س1.اطبع_نفسك())
اطبع_سطر("قابل_للمقارنة:" + س1.يساوي(س2))
اطبع_سطر("قابل_للمقارنة:" + س1.يساوي(س3))
