# @description اختبار شامل للوراثة — يرث، الأساس، override، حقول موروثة، سلسلة وراثة
# @expected حيوان:بسبوس نوع:قطة\nصوت:مياو\nأكل:بسبوس يأكل سمك\nكلب:ريكس\nصوت:هاو\nأكل:ريكس يأكل عظم\nموظف:خالد قسم:هندسة\nعمل:خالد يعمل في هندسة\nمدير:أحمد قسم:تقنية فريق:5\nعمل:أحمد يدير فريق من 5\nشحن:500 حالة:جديد\nمعالجة:500 حالة:قيد_الشحن\nتوصيل:500 حالة:مُسلّم
# @priority P0

# ============================================================
# 1. وراثة بسيطة — حيوان وأصنافه الفرعية
# ============================================================
صنف حيوان
    متغير عام الاسم
    متغير عام النوع

    باني(اسم، نوع)
        هذا.الاسم = اسم
        هذا.النوع = نوع
    نهاية

    دالة عام صوت()
        ارجع "..."
    نهاية

    دالة عام أكل(طعام)
        ارجع هذا.الاسم + " يأكل " + طعام
    نهاية
نهاية

صنف قطة يرث حيوان
    باني(اسم)
        الأساس(اسم، "قطة")
    نهاية

    دالة عام صوت()
        ارجع "مياو"
    نهاية
نهاية

صنف كلب يرث حيوان
    باني(اسم)
        الأساس(اسم، "كلب")
    نهاية

    دالة عام صوت()
        ارجع "هاو"
    نهاية
نهاية

متغير ق = جديد قطة("بسبوس")
اطبع_سطر("حيوان:" + ق.الاسم + " نوع:" + ق.النوع)
اطبع_سطر("صوت:" + ق.صوت())
اطبع_سطر("أكل:" + ق.أكل("سمك"))

متغير ك = جديد كلب("ريكس")
اطبع_سطر("كلب:" + ك.الاسم)
اطبع_سطر("صوت:" + ك.صوت())
اطبع_سطر("أكل:" + ك.أكل("عظم"))

# ============================================================
# 2. وراثة متعددة المستويات — موظف → مدير
# ============================================================
صنف موظف
    متغير عام الاسم
    متغير عام القسم

    باني(اسم، قسم)
        هذا.الاسم = اسم
        هذا.القسم = قسم
    نهاية

    دالة عام عمل()
        ارجع هذا.الاسم + " يعمل في " + هذا.القسم
    نهاية
نهاية

صنف مدير يرث موظف
    متغير عام حجم_الفريق

    باني(اسم، قسم، فريق)
        الأساس(اسم، قسم)
        هذا.حجم_الفريق = فريق
    نهاية

    دالة عام عمل()
        ارجع هذا.الاسم + " يدير فريق من " + هذا.حجم_الفريق
    نهاية
نهاية

متغير م1 = جديد موظف("خالد"، "هندسة")
اطبع_سطر("موظف:" + م1.الاسم + " قسم:" + م1.القسم)
اطبع_سطر("عمل:" + م1.عمل())

متغير م2 = جديد مدير("أحمد"، "تقنية"، 5)
اطبع_سطر("مدير:" + م2.الاسم + " قسم:" + م2.القسم + " فريق:" + م2.حجم_الفريق)
اطبع_سطر("عمل:" + م2.عمل())

# ============================================================
# 3. وراثة مع تعديل حالة — طلب شحن
# ============================================================
صنف طلب
    متغير عام المبلغ
    متغير عام الحالة

    باني(مبلغ)
        هذا.المبلغ = مبلغ
        هذا.الحالة = "جديد"
    نهاية

    دالة عام وصف()
        ارجع هذا.المبلغ + " حالة:" + هذا.الحالة
    نهاية
نهاية

صنف طلب_شحن يرث طلب
    باني(مبلغ)
        الأساس(مبلغ)
    نهاية

    دالة عام معالجة()
        هذا.الحالة = "قيد_الشحن"
        ارجع هذا.وصف()
    نهاية

    دالة عام توصيل()
        هذا.الحالة = "مُسلّم"
        ارجع هذا.وصف()
    نهاية
نهاية

متغير ط = جديد طلب_شحن(500)
اطبع_سطر("شحن:" + ط.وصف())
اطبع_سطر("معالجة:" + ط.معالجة())
اطبع_سطر("توصيل:" + ط.توصيل())
