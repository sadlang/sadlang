# @description اختبار الخصائص (Properties) — getter/setter، خاصية قراءة فقط، قيمة محسوبة
# @expected الاسم:أحمد\nالعمر:25\nبعد_التعديل:30\nكامل:أحمد (30)\nوصف:مستطيل 5×3\nمساحة:15\nمحيط:16
# @priority P2
# @skip_compiler الخصائص غير مدعومة في المترجم

# ============================================================
# 1. خاصية بسيطة — getter و setter
# ============================================================
صنف شخص
    متغير خاص _الاسم
    متغير خاص _العمر

    باني(اسم، عمر)
        هذا._الاسم = اسم
        هذا._العمر = عمر
    نهاية

    خاصية نص الاسم
        احصل
            ارجع هذا._الاسم
        نهاية
    نهاية

    خاصية رقم العمر
        احصل
            ارجع هذا._العمر
        نهاية
        عيّن(قيمة)
            هذا._العمر = قيمة
        نهاية
    نهاية

    # خاصية محسوبة — قراءة فقط
    خاصية نص الاسم_الكامل
        احصل
            ارجع هذا._الاسم + " (" + هذا._العمر + ")"
        نهاية
    نهاية
نهاية

متغير ش = جديد شخص("أحمد"، 25)
اطبع_سطر("الاسم:" + ش.الاسم)
اطبع_سطر("العمر:" + ش.العمر)

# تعديل العمر عبر setter
ش.العمر = 30
اطبع_سطر("بعد_التعديل:" + ش.العمر)
اطبع_سطر("كامل:" + ش.الاسم_الكامل)

# ============================================================
# 2. خاصية محسوبة — شكل هندسي
# ============================================================
صنف مستطيل
    متغير خاص _الطول
    متغير خاص _العرض

    باني(طول، عرض)
        هذا._الطول = طول
        هذا._العرض = عرض
    نهاية

    خاصية نص الوصف
        احصل
            ارجع "مستطيل " + هذا._الطول + "×" + هذا._العرض
        نهاية
    نهاية

    خاصية رقم المساحة
        احصل
            ارجع هذا._الطول * هذا._العرض
        نهاية
    نهاية

    خاصية رقم المحيط
        احصل
            ارجع 2 * (هذا._الطول + هذا._العرض)
        نهاية
    نهاية
نهاية

متغير م = جديد مستطيل(5، 3)
اطبع_سطر("وصف:" + م.الوصف)
اطبع_سطر("مساحة:" + م.المساحة)
اطبع_سطر("محيط:" + م.المحيط)
