# @description اختبار تحميل العوامل — عامل + و ==
# @expected (4، 6)\nصحيح\nخطأ
# @priority P1

صنف متجه
    متغير عام س
    متغير عام ص
    
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    
    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية
    
    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية
    
    دالة عام نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(3، 4)
متغير ج = أ + ب
اطبع_سطر(ج.نص())

# مقارنة
متغير د = جديد متجه(4، 6)
اطبع_سطر(ج == د)
اطبع_سطر(أ == ب)
