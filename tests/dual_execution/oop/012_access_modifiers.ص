# @description اختبار محددات الوصول — عام/خاص  
# @expected تم الوصول: 100\nالرصيد: 100
# @priority P1

صنف حساب
    متغير خاص _رصيد
    
    باني(رصيد)
        هذا._رصيد = رصيد
    نهاية
    
    دالة عام إيداع(مبلغ)
        هذا._رصيد = هذا._رصيد + مبلغ
    نهاية
    
    دالة عام الرصيد()
        ارجع هذا._رصيد
    نهاية
نهاية

متغير ح = جديد حساب(0)
ح.إيداع(100)
اطبع_سطر("تم الوصول: " + ح.الرصيد())

# التحقق من القيمة
متغير ر = ح.الرصيد()
اطبع_سطر("الرصيد: " + ر)
