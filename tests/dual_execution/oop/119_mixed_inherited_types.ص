# @description اختبار وراثة مع أنواع مختلطة ودوال الأب تستخدم حقولاً موروثة
# @expected شخص:أحمد:25\nموظف:أحمد:25:مبرمج:5000.5\nموظف_عمل:أحمد يعمل مبرمج\nموظف_نشط:صحيح
# @priority P1

# ============================================================
# 1. وراثة مع دوال الأب تصل لحقول الابن
# ============================================================
صنف شخص
    متغير عام الاسم
    متغير عام العمر

    باني(ا، ع)
        هذا.الاسم = ا
        هذا.العمر = ع
    نهاية

    دالة عام وصف()
        ارجع "شخص:" + هذا.الاسم + ":" + هذا.العمر
    نهاية
نهاية

صنف موظف يرث شخص
    متغير عام المهنة
    متغير عام الراتب
    متغير عام نشط

    باني(ا، ع، م، ر، ن)
        الأساس(ا، ع)
        هذا.المهنة = م
        هذا.الراتب = ر
        هذا.نشط = ن
    نهاية

    دالة عام وصف()
        ارجع "موظف:" + هذا.الاسم + ":" + هذا.العمر + ":" + هذا.المهنة + ":" + هذا.الراتب
    نهاية

    دالة عام وصف_عمل()
        ارجع هذا.الاسم + " يعمل " + هذا.المهنة
    نهاية

    دالة عام هل_نشط()
        ارجع هذا.نشط
    نهاية
نهاية

# ============================================================
# 2. إنشاء واستخدام
# ============================================================
متغير ش = شخص("أحمد"، 25)
متغير م = موظف("أحمد"، 25، "مبرمج"، 5000.5، صحيح)

اطبع_سطر(ش.وصف())
اطبع_سطر(م.وصف())
اطبع_سطر("موظف_عمل:" + م.وصف_عمل())
اطبع_سطر("موظف_نشط:" + م.هل_نشط())
