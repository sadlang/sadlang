# @description اختبار دوال الصنف — this بداخل دوال متداخلة، تغيير الحالة
# @expected رصيد:100\nرصيد:150\nرصيد:120\nصحيح\nخطأ
# @priority P2

# ============================================================
# 1. صنف يدير حالة داخلية
# ============================================================
صنف حساب
    متغير خاص _رصيد

    باني(رصيد)
        هذا._رصيد = رصيد
    نهاية

    دالة عام إيداع(مبلغ)
        هذا._رصيد = هذا._رصيد + مبلغ
    نهاية

    دالة عام سحب(مبلغ)
        إذا (مبلغ <= هذا._رصيد)
            هذا._رصيد = هذا._رصيد - مبلغ
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة عام الرصيد()
        ارجع هذا._رصيد
    نهاية
نهاية

# ============================================================
# 2. استخدام
# ============================================================
متغير ح = حساب(100)
اطبع_سطر("رصيد:" + ح.الرصيد())

ح.إيداع(50)
اطبع_سطر("رصيد:" + ح.الرصيد())

متغير نجح = ح.سحب(30)
اطبع_سطر("رصيد:" + ح.الرصيد())
اطبع_سطر(نجح)

# محاولة سحب أكثر من الرصيد
متغير فشل = ح.سحب(500)
اطبع_سطر(فشل)
