# @description اختبار تحميل العوامل المتقدم — عوامل حسابية ومقارنة وأحادية وتحويل نص
# @expected جمع:(5، 7)\nطرح:(-1، -1)\nضرب:(6، 9)\nمتساوي:صحيح\nغير_متساوي:صحيح\nأقل:صحيح\nأكبر:خطأ\nسالب:(-2، -3)\nتسلسل:أ=(2، 3) ب=(3، 4)\nنص:متجه(2، 3)\nمقارنة_ذاتي:صحيح
# @priority P1

# ============================================================
# 1. صنف متجه مع عوامل متعددة
# ============================================================
صنف متجه
    متغير عام س
    متغير عام ص

    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    # عامل الجمع
    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    # عامل الطرح
    عامل -(آخر)
        ارجع جديد متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    # عامل الضرب (بعدد)
    عامل *(آخر)
        ارجع جديد متجه(هذا.س * آخر، هذا.ص * آخر)
    نهاية

    # عامل المساواة
    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    # عامل عدم المساواة
    عامل !=(آخر)
        ارجع هذا.س != آخر.س أو هذا.ص != آخر.ص
    نهاية

    # عامل أقل من (مقارنة بالطول)
    عامل <(آخر)
        متغير طول_ذاتي = هذا.س * هذا.س + هذا.ص * هذا.ص
        متغير طول_آخر = آخر.س * آخر.س + آخر.ص * آخر.ص
        ارجع طول_ذاتي < طول_آخر
    نهاية

    # عامل أكبر من
    عامل >(آخر)
        متغير طول_ذاتي = هذا.س * هذا.س + هذا.ص * هذا.ص
        متغير طول_آخر = آخر.س * آخر.س + آخر.ص * آخر.ص
        ارجع طول_ذاتي > طول_آخر
    نهاية

    # عامل أحادي — سالب
    عامل -()
        ارجع جديد متجه(-هذا.س، -هذا.ص)
    نهاية

    # تحويل لنص
    دالة عام وصف()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية

    دالة عام نص_كامل()
        ارجع "متجه(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

# ============================================================
# 2. اختبار العوامل الحسابية
# ============================================================
متغير أ = جديد متجه(2، 3)
متغير ب = جديد متجه(3، 4)

متغير جمع = أ + ب
اطبع_سطر("جمع:" + جمع.وصف())

متغير طرح = أ - ب
اطبع_سطر("طرح:" + طرح.وصف())

متغير ضرب = أ * 3
اطبع_سطر("ضرب:" + ضرب.وصف())

# ============================================================
# 3. اختبار عوامل المقارنة
# ============================================================
متغير ج = جديد متجه(5، 7)
اطبع_سطر("متساوي:" + (جمع == ج))

اطبع_سطر("غير_متساوي:" + (أ != ب))

اطبع_سطر("أقل:" + (أ < ب))
اطبع_سطر("أكبر:" + (أ > ب))

# ============================================================
# 4. عامل أحادي — سالب
# ============================================================
متغير سالب = -أ
اطبع_سطر("سالب:" + سالب.وصف())

# ============================================================
# 5. تسلسل عمليات
# ============================================================
اطبع_سطر("تسلسل:أ=" + أ.وصف() + " ب=" + ب.وصف())

# ============================================================
# 6. تحويل لنص
# ============================================================
اطبع_سطر("نص:" + أ.نص_كامل())

# ============================================================
# 7. مقارنة ذاتية
# ============================================================
اطبع_سطر("مقارنة_ذاتي:" + (أ == أ))
