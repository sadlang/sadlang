# @description اختبار تعدد الأشكال (Polymorphism) — إعادة تعريف الدوال
# @expected شكل عام\nمستطيل: 20\nدائرة: 28.26
# @priority P2

# ============================================================
# 1. صنف أساسي مع دالة يتم تجاوزها
# ============================================================
صنف شكل
    دالة المساحة()
        ارجع 0
    نهاية

    دالة الوصف()
        ارجع "شكل عام"
    نهاية
نهاية

صنف مستطيل يرث شكل
    متغير عام الطول
    متغير عام العرض

    باني(طول، عرض)
        هذا.الطول = طول
        هذا.العرض = عرض
    نهاية

    دالة المساحة()
        ارجع هذا.الطول * هذا.العرض
    نهاية
نهاية

صنف دائرة يرث شكل
    متغير عام نصف_القطر

    باني(نصف_القطر)
        هذا.نصف_القطر = نصف_القطر
    نهاية

    دالة المساحة()
        ارجع 3.14 * هذا.نصف_القطر * هذا.نصف_القطر
    نهاية
نهاية

# ============================================================
# 2. تعدد الأشكال
# ============================================================
متغير ش1 = شكل()
اطبع_سطر(ش1.الوصف())

متغير ش2 = مستطيل(4، 5)
اطبع_سطر("مستطيل: " + ش2.المساحة())

متغير ش3 = دائرة(3)
اطبع_سطر("دائرة: " + ش3.المساحة())
