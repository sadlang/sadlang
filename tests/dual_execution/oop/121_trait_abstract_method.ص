##
# اختبار P02: دالة مجرد في سمة
# يتحقق من دعم الصيغة: دالة مجرد اسم() داخل سمة
# السلوك الصحيح: مقبولة نحوياً، الصنف المنفذ يوفر التنفيذ
##

# ───────────────────────────────────────────────────────────────
# سمة بدوال مجردة صريحة
# ───────────────────────────────────────────────────────────────
سمة قابل_للرسم
    دالة مجرد ارسم()
    دالة مجرد احصل_على_لون()
نهاية

سمة قابل_للتحريك
    دالة مجرد تحرك(أكس، واي)
نهاية

# ───────────────────────────────────────────────────────────────
# صنف ينفذ السمات
# ───────────────────────────────────────────────────────────────
صنف دائرة
    متغير عام نصف_قطر
    متغير خاص _لون

    باني(نق، لون)
        هذا.نصف_قطر = نق
        هذا._لون = لون
    نهاية

    دالة ارسم()
        اطبع_سطر("دائرة بنصف قطر: " + هذا.نصف_قطر)
    نهاية

    دالة احصل_على_لون()
        ارجع هذا._لون
    نهاية

    دالة تحرك(أكس، واي)
        اطبع_سطر("تحريك إلى: " + أكس + "، " + واي)
    نهاية
نهاية

نفذ دائرة كـ قابل_للرسم نهاية
نفذ دائرة كـ قابل_للتحريك نهاية

# اختبار
متغير د = دائرة(5، "أحمر")
د.ارسم()
اطبع_سطر(د.احصل_على_لون())
د.تحرك(10، 20)
