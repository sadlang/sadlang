# @test اختبار البنيات المتقدمة
# @description بنيات: بنية أساسية، حقول، دوال عبر امتداد، تداخل بنيات، بنية مع مصفوفة
# @expected T01:PASS\nT02:PASS\nT03:PASS\nT04:PASS\nT05:PASS\nT06:PASS\nT07:PASS\nT08:PASS\nT09:PASS\nT10:PASS\nSUMMARY:10/10

# ═══ T01: بنية أساسية — إنشاء وقراءة حقول ═══
بنية نقطة
    متغير س = 0
    متغير ص = 0
نهاية
متغير ن1 = جديد نقطة()
ن1.س = 5
ن1.ص = 10
إذا (ن1.س == 5 و ن1.ص == 10)
    اطبع_سطر("T01:PASS")
وإلا
    اطبع_سطر("T01:FAIL")
نهاية

# ═══ T02: بنية مع باني ═══
صنف مستطيل
    باني(عرض، ارتفاع)
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية
    دالة المساحة()
        ارجع هذا.عرض * هذا.ارتفاع
    نهاية
نهاية
متغير م2 = جديد مستطيل(4، 7)
إذا (م2.المساحة() == 28)
    اطبع_سطر("T02:PASS")
وإلا
    اطبع_سطر("T02:FAIL:" + م2.المساحة())
نهاية

# ═══ T03: بنية مع حقول افتراضية ═══
بنية لون
    متغير أحمر = 0
    متغير أخضر = 0
    متغير أزرق = 0
نهاية
متغير ل3 = جديد لون()
ل3.أحمر = 255
إذا (ل3.أحمر == 255 و ل3.أخضر == 0 و ل3.أزرق == 0)
    اطبع_سطر("T03:PASS")
وإلا
    اطبع_سطر("T03:FAIL")
نهاية

# ═══ T04: صنف يحمل بنية — تركيب (composition) ═══
صنف دائرة
    باني(مركز_س، مركز_ص، نصف_القطر)
        هذا.مركز_س = مركز_س
        هذا.مركز_ص = مركز_ص
        هذا.نصف_القطر = نصف_القطر
    نهاية
    دالة المساحة()
        ارجع 3 * هذا.نصف_القطر * هذا.نصف_القطر
    نهاية
نهاية
متغير د4 = جديد دائرة(0، 0، 5)
إذا (د4.المساحة() == 75 و د4.مركز_س == 0)
    اطبع_سطر("T04:PASS")
وإلا
    اطبع_سطر("T04:FAIL:" + د4.المساحة())
نهاية

# ═══ T05: مصفوفة من أصناف ═══
صنف طالب
    باني(اسم، درجة)
        هذا.اسم = اسم
        هذا.درجة = درجة
    نهاية
نهاية
متغير طلاب = [جديد طالب("أحمد"، 90)، جديد طالب("سارة"، 95)، جديد طالب("محمد"، 85)]
متغير مجموع5 = 0
لكل ط في طلاب
    مجموع5 = مجموع5 + ط.درجة
نهاية
إذا (مجموع5 == 270)
    اطبع_سطر("T05:PASS")
وإلا
    اطبع_سطر("T05:FAIL:" + مجموع5)
نهاية

# ═══ T06: بنية مع تعداد ═══
تعداد الاتجاه
    شمال
    جنوب
    شرق
    غرب
نهاية
متغير اتج = الاتجاه.شمال
إذا (اتج == الاتجاه.شمال)
    اطبع_سطر("T06:PASS")
وإلا
    اطبع_سطر("T06:FAIL")
نهاية

# ═══ T07: صنف بدوال متعددة ═══
صنف حساب
    باني(رصيد)
        هذا.رصيد = رصيد
    نهاية
    دالة إيداع(مبلغ)
        هذا.رصيد = هذا.رصيد + مبلغ
    نهاية
    دالة سحب(مبلغ)
        إذا (مبلغ <= هذا.رصيد)
            هذا.رصيد = هذا.رصيد - مبلغ
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية
نهاية
متغير ح7 = جديد حساب(100)
ح7.إيداع(50)
ح7.سحب(30)
إذا (ح7.رصيد == 120)
    اطبع_سطر("T07:PASS")
وإلا
    اطبع_سطر("T07:FAIL:" + ح7.رصيد)
نهاية

# ═══ T08: وراثة من بنية ═══
صنف شكل
    باني(اسم)
        هذا.اسم = اسم
    نهاية
    دالة وصف()
        ارجع "شكل: " + هذا.اسم
    نهاية
نهاية
صنف مربع يرث شكل
    باني(ضلع)
        الأساس("مربع")
        هذا.ضلع = ضلع
    نهاية
    دالة المساحة()
        ارجع هذا.ضلع * هذا.ضلع
    نهاية
نهاية
متغير مر8 = جديد مربع(6)
إذا (مر8.المساحة() == 36 و مر8.وصف() == "شكل: مربع")
    اطبع_سطر("T08:PASS")
وإلا
    اطبع_سطر("T08:FAIL")
نهاية

# ═══ T09: صنف بحقل مصفوفة ═══
صنف مكدس
    باني()
        هذا.عناصر = []
    نهاية
    دالة ادفع(قيمة)
        هذا.عناصر.اضف(قيمة)
    نهاية
    دالة الحجم()
        ارجع طول(هذا.عناصر)
    نهاية
نهاية
متغير مك = جديد مكدس()
مك.ادفع(1)
مك.ادفع(2)
مك.ادفع(3)
إذا (مك.الحجم() == 3)
    اطبع_سطر("T09:PASS")
وإلا
    اطبع_سطر("T09:FAIL:" + مك.الحجم())
نهاية

# ═══ T10: صنفان مترابطان ═══
صنف عنوان
    باني(مدينة، شارع)
        هذا.مدينة = مدينة
        هذا.شارع = شارع
    نهاية
نهاية
صنف شخص
    باني(اسم، عنوان)
        هذا.اسم = اسم
        هذا.عنوان = عنوان
    نهاية
نهاية
متغير ع10 = جديد عنوان("الرياض"، "الملك فهد")
متغير ش10 = جديد شخص("أحمد"، ع10)
إذا (ش10.عنوان.مدينة == "الرياض" و ش10.اسم == "أحمد")
    اطبع_سطر("T10:PASS")
وإلا
    اطبع_سطر("T10:FAIL")
نهاية

# ═══ الملخص ═══
اطبع_سطر("SUMMARY:10/10")
