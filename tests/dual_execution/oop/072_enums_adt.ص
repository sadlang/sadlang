# @description اختبار التعدادات الجبرية (ADT) — بيانات مرتبطة، مطابقة أنماط، Unit variants
# @expected شكل:دائرة نصف قطرها 5\nشكل:مستطيل 10×4\nشكل:نقطة بدون أبعاد\nمساحة:78.5\nمساحة:40\nمساحة:0\nنتيجة:نجاح — القيمة: 42\nنتيجة:فشل — خطأ غير معروف\nنتيجة:جاري التحميل...
# @priority P2
# @skip_compiler التعدادات الجبرية غير مدعومة في المترجم

# ============================================================
# 1. تعداد جبري (ADT) — أشكال هندسية
# ============================================================
تعداد شكل
    دائرة(نصف_القطر)
    مستطيل(الطول، العرض)
    نقطة
نهاية

# إنشاء قيم التعداد
متغير د = شكل.دائرة(5)
متغير م = شكل.مستطيل(10، 4)
متغير ن = شكل.نقطة

# وصف الشكل عبر مطابقة الأنماط
دالة وصف_شكل(ش)
    طابق (ش)
        عندما شكل.دائرة(نق):
            ارجع "دائرة نصف قطرها " + نق
        عندما شكل.مستطيل(ط، ع):
            ارجع "مستطيل " + ط + "×" + ع
        عندما شكل.نقطة:
            ارجع "نقطة بدون أبعاد"
        افتراضي:
            ارجع "شكل مجهول"
    نهاية
نهاية

اطبع_سطر("شكل:" + وصف_شكل(د))
اطبع_سطر("شكل:" + وصف_شكل(م))
اطبع_سطر("شكل:" + وصف_شكل(ن))

# حساب المساحة
دالة مساحة_شكل(ش)
    طابق (ش)
        عندما شكل.دائرة(نق):
            ارجع 3.14 * نق * نق
        عندما شكل.مستطيل(ط، ع):
            ارجع ط * ع
        عندما شكل.نقطة:
            ارجع 0
        افتراضي:
            ارجع 0
    نهاية
نهاية

اطبع_سطر("مساحة:" + مساحة_شكل(د))
اطبع_سطر("مساحة:" + مساحة_شكل(م))
اطبع_سطر("مساحة:" + مساحة_شكل(ن))

# ============================================================
# 2. تعداد النتيجة (Result type) — نجاح/فشل/جاري
# ============================================================
تعداد نتيجة
    نجاح(القيمة)
    فشل(الخطأ)
    جاري
نهاية

دالة وصف_نتيجة(ن)
    طابق (ن)
        عندما نتيجة.نجاح(ق):
            ارجع "نجاح — القيمة: " + ق
        عندما نتيجة.فشل(خ):
            ارجع "فشل — " + خ
        عندما نتيجة.جاري:
            ارجع "جاري التحميل..."
        افتراضي:
            ارجع "غير معروف"
    نهاية
نهاية

اطبع_سطر("نتيجة:" + وصف_نتيجة(نتيجة.نجاح(42)))
اطبع_سطر("نتيجة:" + وصف_نتيجة(نتيجة.فشل("خطأ غير معروف")))
اطبع_سطر("نتيجة:" + وصف_نتيجة(نتيجة.جاري))
