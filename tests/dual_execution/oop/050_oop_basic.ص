# @description اختبار OOP شامل — صنف، باني، حقول، دوال، هذا، نسخ متعددة، قيم افتراضية
# @expected اسم:أحمد عمر:25\nتحية:مرحبا أحمد!\nاسم:سارة عمر:30\nعمل:سارة تعمل\nحساب:150\nافتراضي:مجهول عمر:0\nتعديل:محمد عمر:28\nسيارة:تويوتا-2024 سرعة:0\nتسارع:20\nتسارع:40\nفرملة:30
# @priority P0

# ============================================================
# 1. صنف أساسي — شخص
# ============================================================
صنف شخص
    متغير عام الاسم
    متغير عام العمر

    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية

    دالة عام تحية()
        ارجع "مرحبا " + هذا.الاسم + "!"
    نهاية

    دالة عام عمل()
        ارجع هذا.الاسم + " تعمل"
    نهاية
نهاية

متغير أ = جديد شخص("أحمد"، 25)
اطبع_سطر("اسم:" + أ.الاسم + " عمر:" + أ.العمر)
اطبع_سطر("تحية:" + أ.تحية())

متغير س = جديد شخص("سارة"، 30)
اطبع_سطر("اسم:" + س.الاسم + " عمر:" + س.العمر)
اطبع_سطر("عمل:" + س.عمل())

# ============================================================
# 2. دالة تستخدم هذا في حسابات
# ============================================================
صنف حساب
    متغير عام الرصيد

    باني(رصيد)
        هذا.الرصيد = رصيد
    نهاية

    دالة عام إيداع(مبلغ)
        هذا.الرصيد = هذا.الرصيد + مبلغ
    نهاية

    دالة عام رصيد()
        ارجع هذا.الرصيد
    نهاية
نهاية

متغير ح = جديد حساب(100)
ح.إيداع(50)
اطبع_سطر("حساب:" + ح.رصيد())

# ============================================================
# 3. صنف بقيم افتراضية (باني بدون وسائط)
# ============================================================
صنف مستخدم
    متغير عام الاسم
    متغير عام العمر

    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية
نهاية

متغير م = جديد مستخدم("مجهول"، 0)
اطبع_سطر("افتراضي:" + م.الاسم + " عمر:" + م.العمر)

# ============================================================
# 4. تعديل حقول بعد الإنشاء
# ============================================================
م.الاسم = "محمد"
م.العمر = 28
اطبع_سطر("تعديل:" + م.الاسم + " عمر:" + م.العمر)

# ============================================================
# 5. صنف أكثر تعقيداً — سيارة مع حالة متغيرة
# ============================================================
صنف سيارة
    متغير عام الماركة
    متغير عام السنة
    متغير عام السرعة

    باني(ماركة، سنة)
        هذا.الماركة = ماركة
        هذا.السنة = سنة
        هذا.السرعة = 0
    نهاية

    دالة عام تسارع(مقدار)
        هذا.السرعة = هذا.السرعة + مقدار
        ارجع هذا.السرعة
    نهاية

    دالة عام فرملة(مقدار)
        هذا.السرعة = هذا.السرعة - مقدار
        إذا (هذا.السرعة < 0)
            هذا.السرعة = 0
        نهاية
        ارجع هذا.السرعة
    نهاية

    دالة عام وصف()
        ارجع هذا.الماركة + "-" + هذا.السنة + " سرعة:" + هذا.السرعة
    نهاية
نهاية

متغير ت = جديد سيارة("تويوتا"، 2024)
اطبع_سطر("سيارة:" + ت.وصف())
اطبع_سطر("تسارع:" + ت.تسارع(20))
اطبع_سطر("تسارع:" + ت.تسارع(20))
اطبع_سطر("فرملة:" + ت.فرملة(10))
