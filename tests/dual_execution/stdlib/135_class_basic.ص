# @description: اختبار أصناف بسيطة مع خصائص ودوال
# @expected: أحمد\n25\nاسمي أحمد وعمري 25\nسارة\n30\nاسمي سارة وعمري 30
# @priority: 1

صنف شخص
    متغير عام الاسم
    متغير عام العمر

    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية

    دالة عام تعريف()
        ارجع "اسمي " + هذا.الاسم + " وعمري " + نص(هذا.العمر)
    نهاية
نهاية

متغير ش1 = شخص("أحمد"، 25)
اطبع_سطر(ش1.الاسم)
اطبع_سطر(ش1.العمر)
اطبع_سطر(ش1.تعريف())

متغير ش2 = شخص("سارة"، 30)
اطبع_سطر(ش2.الاسم)
اطبع_سطر(ش2.العمر)
اطبع_سطر(ش2.تعريف())
