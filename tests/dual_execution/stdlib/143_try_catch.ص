# @description: اختبار حاول/امسك لمعالجة الأخطاء
# @expected: تم القسمة: 5\nخطأ: القسمة على صفر!\nانتهى
# @priority: 1

# دالة قسمة آمنة
دالة قسمة(أ، ب)
    إذا (ب == 0)
        ارمي "القسمة على صفر!"
    نهاية
    ارجع أ / ب
نهاية

# قسمة ناجحة
حاول
    متغير ن = قسمة(10، 2)
    اطبع_سطر("تم القسمة: " + نص(رقم(ن)))
امسك خطأ
    اطبع_سطر("خطأ: " + خطأ)
نهاية

# قسمة على صفر
حاول
    متغير ن = قسمة(10، 0)
    اطبع_سطر("تم القسمة: " + نص(ن))
امسك خطأ
    اطبع_سطر("خطأ: " + خطأ)
نهاية

اطبع_سطر("انتهى")
