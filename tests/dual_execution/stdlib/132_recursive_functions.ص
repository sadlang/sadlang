# @description: اختبار دوال متداخلة واستدعاء دوال من دوال
# @expected: 120\n8\n13\nمرحبا يا عالم
# @priority: 1

# دالة المضروب (العاملي)
دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية
اطبع_سطر(مضروب(5))

# دالة الأس بالتكرار
دالة أس_تكرار(قاعدة، قوة)
    متغير نتيجة = 1
    متغير ع = 0
    بينما (ع < قوة)
        نتيجة = نتيجة * قاعدة
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية
اطبع_سطر(أس_تكرار(2، 3))

# فيبوناتشي
دالة فيبوناتشي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية
اطبع_سطر(فيبوناتشي(7))

# دوال مساعدة تستدعي بعضها
دالة تحية(اسم)
    ارجع "مرحبا يا " + اسم
نهاية
دالة رسالة()
    ارجع تحية("عالم")
نهاية
اطبع_سطر(رسالة())
