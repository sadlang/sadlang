# @description: اختبار دوال متعددة المعاملات والقيم المرجعة
# @expected: 6\n24\n3\n1\nزوجي\nفردي
# @priority: 1

# دالة بمعامل واحد
دالة مضاعف(ن)
    ارجع ن * 2
نهاية
اطبع_سطر(مضاعف(3))

# دالة بثلاثة معاملات
دالة حاصل_ضرب(أ، ب، ج)
    ارجع أ * ب * ج
نهاية
اطبع_سطر(حاصل_ضرب(2، 3، 4))

# دالة ترجع مصفوفة (بالفهرس)
دالة أكبر_وأصغر(أ، ب)
    إذا (أ > ب)
        ارجع [أ، ب]
    وإلا
        ارجع [ب، أ]
    نهاية
نهاية
متغير نتائج = أكبر_وأصغر(1، 3)
اطبع_سطر(نتائج[0])
اطبع_سطر(نتائج[1])

# دالة ترجع نص بناء على شرط
دالة نوع_رقم(ن)
    إذا (ن % 2 == 0)
        ارجع "زوجي"
    وإلا
        ارجع "فردي"
    نهاية
نهاية
اطبع_سطر(نوع_رقم(4))
اطبع_سطر(نوع_رقم(7))
