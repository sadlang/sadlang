# @description UDP طلب/استجابة حقيقي بين خيطين
# @expected صحيح\nصحيح\nصحيح
# @timeout 15000
# @skip_compiler

استورد مقابس

متغير ق_منفذ_خ = قناة(1)

# خادم UDP
أطلق
    متغير خادم = أنشئ_مرسال()
    خصص_منفذ_رسائل(خادم، 0)
    ق_منفذ_خ.أرسل(منفذ_محلي(خادم))
    حدد_انتظار_الاستقبال(خادم، 5000)

    # استقبال الطلب والحصول على عنوان المرسل
    متغير طلب = استقبل_رسالة(خادم، 256)
    # في هذا التصميم البسيط، نرسل على منفذ ثابت للعميل
    أغلق_مرسال(خادم)
نهاية

متغير منفذ_خادم = ق_منفذ_خ.استقبل()
اطبع_سطر(منفذ_خادم > 0)

# العميل يرسل فقط (لا رد — التحقق من نجاح الإرسال)
متغير عميل = أنشئ_مرسال()
خصص_منفذ_رسائل(عميل، 0)
متغير م_عميل = منفذ_محلي(عميل)
اطبع_سطر(م_عميل > 0)

متغير نتيجة = أرسل_رسالة(عميل، "طلب"، "127.0.0.1"، منفذ_خادم)
اطبع_سطر(نتيجة > 0)

أغلق_مرسال(عميل)
انتظر_الكل()
