# @description خادم TCP يقبل 3 عملاء متتاليين عبر goroutines — قياس العدد الصحيح
# @expected صحيح\nصحيح
# @timeout 12000
# @priority P2
# @skip_compiler

##
# اختبار قبول اتصالات متعددة من خادم TCP واحد:
# - خادم يقبل 3 اتصالات متتالية
# - 3 goroutines عملاء كل منها يتصل ويُرسل رقمه
# - الخادم يجمع الأرقام المستقبلة
# - التحقق من أن العدد الصحيح من الاتصالات قُبلت
##

استورد مقابس

متغير ق_منفذ = قناة(1)
متغير ق_مجموع = قناة(1)

# ── الخادم ─────────────────────────────────────────────────────
أطلق
    متغير خادم = أنشئ_وصلة()
    خصص_منفذ(خادم، 0)
    انتظر_اتصالات(خادم)
    ق_منفذ.أرسل(منفذ_محلي(خادم))

    # قبول 3 اتصالات وحساب مجموع البيانات
    متغير مجموع = 0
    متغير عدد = 0
    حدد_انتظار_الاستقبال(خادم، 8000)
    بينما (عدد < 3)
        متغير ع = اقبل_متصل(خادم)
        إذا (ع > 0)
            حدد_انتظار_الاستقبال(ع، 2000)
            متغير بيانات = استقبل_عبر_وصلة(ع، 8)
            حاول
                مجموع = مجموع + رقم(بيانات)
            امسك خطأ
                مجموع = مجموع + 0
            نهاية
            أغلق_وصلة(ع)
            عدد = عدد + 1
        وإلا
            توقف
        نهاية
    نهاية
    أغلق_وصلة(خادم)
    ق_مجموع.أرسل(مجموع)
نهاية

# ── العملاء (goroutines) ────────────────────────────────────────
متغير م = ق_منفذ.استقبل()
اطبع_سطر(م > 0)

# العميل 1
أطلق
    متغير و1 = أنشئ_وصلة()
    إذا (اتصل_بـ(و1، "127.0.0.1"، م))
        أرسل_عبر_وصلة(و1، "10")
    نهاية
    أغلق_وصلة(و1)
نهاية

# العميل 2
أطلق
    متغير و2 = أنشئ_وصلة()
    إذا (اتصل_بـ(و2، "127.0.0.1"، م))
        أرسل_عبر_وصلة(و2، "20")
    نهاية
    أغلق_وصلة(و2)
نهاية

# العميل 3
أطلق
    متغير و3 = أنشئ_وصلة()
    إذا (اتصل_بـ(و3، "127.0.0.1"، م))
        أرسل_عبر_وصلة(و3، "30")
    نهاية
    أغلق_وصلة(و3)
نهاية

انتظر_الكل()

# التحقق: مجموع 10+20+30 = 60
متغير مجموع_كلي = ق_مجموع.استقبل()
اطبع_سطر(مجموع_كلي == 60)
