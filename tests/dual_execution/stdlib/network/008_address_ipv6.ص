# @description إنشاء عنوان IPv6 والتحقق من خصائصه الأساسية
# @expected صحيح\n::1\n9091\nخطأ\nصحيح\nصحيح

استورد شبكة

متغير ع = عنوان_حديث("::1"، 9091)
اطبع_سطر(ع > 0)
اطبع_سطر(رقم_الجهاز(ع))
اطبع_سطر(رقم_المنفذ(ع))
اطبع_سطر(هل_عنوان_قديم(ع))
اطبع_سطر(هل_عنوان_حديث(ع))
اطبع_سطر(طول(العنوان_كنص(ع)) > 0)
حرر_عنوان(ع)
