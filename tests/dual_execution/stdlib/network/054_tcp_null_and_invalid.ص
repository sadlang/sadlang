# @description حالات سلبية: استدعاءات بمعرّفات غير صالحة
# @expected خطأ\nخطأ\nخطأ\nخطأ

استورد مقابس

# استخدام معرّفات غير صالحة يجب أن يُرجع خطأ (منطقي)، لا تعطل
اطبع_سطر(هل_متصلة(-1))
اطبع_سطر(هل_متصلة(0))

# مقبس صالح لكن غير متصل — يجب أن يرجع خطأ
متغير م = أنشئ_وصلة()
اطبع_سطر(هل_متصلة(م))

# إغلاق ثم فحص
أغلق_وصلة(م)
اطبع_سطر(هل_متصلة(م))
