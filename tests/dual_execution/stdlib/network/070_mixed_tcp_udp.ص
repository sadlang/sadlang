# @description TCP و UDP في نفس العملية
# @expected صحيح\nصحيح
# @timeout 15000
# @skip_compiler

استورد مقابس

# TCP
متغير خ_ت = أنشئ_وصلة()
خصص_منفذ(خ_ت، 0)
انتظر_اتصالات(خ_ت)
متغير منفذ_ت = منفذ_محلي(خ_ت)
اطبع_سطر(منفذ_ت > 0)

# UDP
متغير خ_د = أنشئ_مرسال()
خصص_منفذ_رسائل(خ_د، 0)
متغير منفذ_د = منفذ_محلي(خ_د)
اطبع_سطر(منفذ_د > 0 و منفذ_د != منفذ_ت)

أغلق_وصلة(خ_ت)
أغلق_مرسال(خ_د)
