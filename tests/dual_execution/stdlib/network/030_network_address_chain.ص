# @description سلسلة معالجة عناوين الشبكة: IPv4 + IPv6 + تحقق + تحرير
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح

##
# اختبار شامل لعمليات عناوين الشبكة:
# - إنشاء عناوين IPv4 متعددة بمنافذ مختلفة
# - إنشاء عنوان IPv6
# - التحقق من خصائص كل عنوان (IP، منفذ، نوع)
# - مقارنة العناوين
# - تحرير جميع العناوين
##

استورد شبكة

جهز_الشبكة()

# إنشاء ثلاثة عناوين IPv4 مختلفة
متغير ع1 = عنوان("127.0.0.1"، 8080)
متغير ع2 = عنوان("192.168.1.1"، 3000)
متغير ع3 = عنوان("10.0.0.1"، 443)

# التحقق من صحة العناوين
اطبع_سطر(ع1 > 0)
اطبع_سطر(ع2 > 0)
اطبع_سطر(ع3 > 0)

# التحقق من خصائص العناوين
اطبع_سطر(رقم_الجهاز(ع1) == "127.0.0.1")
اطبع_سطر(رقم_المنفذ(ع1) == 8080)
اطبع_سطر(هل_عنوان_قديم(ع1))
اطبع_سطر(ليس هل_عنوان_حديث(ع1))

# التحقق من أن منافذ العناوين مختلفة
اطبع_سطر(رقم_المنفذ(ع1) != رقم_المنفذ(ع2))
اطبع_سطر(رقم_المنفذ(ع2) != رقم_المنفذ(ع3))

# إنشاء عنوان IPv6
متغير ع6 = عنوان_حديث("::1"، 8888)
اطبع_سطر(ع6 > 0)
اطبع_سطر(هل_عنوان_حديث(ع6))

# تحرير جميع العناوين
حرر_عنوان(ع1)
حرر_عنوان(ع2)
حرر_عنوان(ع3)
حرر_عنوان(ع6)

نظف_الشبكة()
