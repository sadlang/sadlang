# @description WebSocket — إنشاء عميل وفحص حالته الأولية
# @expected صحيح\nخطأ\n\nخطأ\nصحيح

استورد شبكات

# (AR) إنشاء عميل WebSocket جديد
متغير ع = عميل_ويبسوكت()

# يجب أن يكون صالحاً فور إنشائه
اطبع_سطر(ع.هل_صالح())

# لكن غير متصل بأي خادم
اطبع_سطر(ع.هل_متصل())

# الرابط يجب أن يكون فارغاً
اطبع_سطر(ع.رابط())

# لا توجد رسائل واردة
اطبع_سطر(ع.يوجد_رسالة())

# عدم وجود اتصال يعني فشل الإرسال
اطبع_سطر(ع.أرسل("اختبار") == خطأ)
