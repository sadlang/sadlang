# @description فشل PUT و DELETE محلياً يجب أن يبقى متسقاً
# @timeout 5000
# @expected خطأ\nخطأ\nصحيح\nخطأ\nصحيح\nصحيح

استورد شبكة

متغير م = أنشئ_متصفح()
حدد_الانتظار(م، 250)
متغير ر1 = استبدل(م، "http://127.0.0.1:9/put"، "b")
متغير ر2 = احذف_مورد(م، "http://127.0.0.1:9/delete")

اطبع_سطر(ر1 == -1)
اطبع_سطر(ر2 == -1)
اطبع_سطر(م > 0)
اطبع_سطر(هل_نجح(م))
اطبع_سطر(طول(سبب_الفشل(م)) > 0)
اطبع_سطر(أغلق_متصفح(م))
