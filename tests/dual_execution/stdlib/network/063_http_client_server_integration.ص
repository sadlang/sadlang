# @description تكامل بسيط — عميل HTTP مع خادم HTTP في نفس العملية (منفذ مغلق)
# @expected صحيح\nصحيح\nصحيح
# @timeout 15000
# @skip_compiler

استورد شبكة

# إنشاء خادم وعميل في نفس الوقت
متغير خ = أنشئ_خادم(0)
اطبع_سطر(خ > 0)

متغير م = أنشئ_متصفح()
حدد_الانتظار(م، 500)
اطبع_سطر(م > 0)

# طلب إلى منفذ لم يستمع بعد — يفشل بنظافة
اجلب(م، "http://127.0.0.1:1/")
اطبع_سطر(ليس هل_الرد_ناجح(م))

أغلق_متصفح(م)
أزل_خادم(خ)
