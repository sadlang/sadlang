# @description خادمان HTTP مستقلان بمنافذ مختلفة — دورة حياة كاملة
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح

##
# اختبار إنشاء خادمين HTTP مستقلين:
# - الخادم الأول على منفذ 0 (مؤقت)
# - الخادم الثاني على منفذ 0 آخر
# - تسجيل مسارات لكل خادم
# - تفعيل CORS مختلف لكل خادم
# - إيقاف وإزالة كلا الخادمين
##

استورد شبكة

دالة معالج_1()
    عين_نص_الرد("خادم-1")
نهاية

دالة معالج_2()
    عين_نص_الرد("خادم-2")
نهاية

# إنشاء خادمين مستقلين
متغير خ1 = أنشئ_خادم(0)
متغير خ2 = أنشئ_خادم(0)
اطبع_سطر(خ1 > 0)
اطبع_سطر(خ2 > 0)
اطبع_سطر(خ1 != خ2)

# تسجيل مسارات مختلفة
اطبع_سطر(عند_طلب_جلب(خ1، "/", "معالج_1"))
اطبع_سطر(عند_طلب_جلب(خ2، "/", "معالج_2"))

# CORS مختلف لكل خادم
اطبع_سطر(اسمح_بالوصول_الخارجي(خ1، "http://app1.local"))
اطبع_سطر(اسمح_بالوصول_الخارجي(خ2، "*"))

# إيقاف وتنظيف كلا الخادمين
أوقف_الخادم(خ1)
أوقف_الخادم(خ2)
اطبع_سطر(أزل_خادم(خ1) و أزل_خادم(خ2))
