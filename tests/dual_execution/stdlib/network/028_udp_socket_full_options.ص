# @description سلسلة كاملة لخيارات مقبس UDP: ربط + مهلة استقبال + منفذ محلي + إغلاق
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح

##
# اختبار شامل لجميع خيارات مقبس UDP المدعومة:
# - إنشاء مقبسين UDP مستقلين
# - ربط الأول بمنفذ مؤقت والحصول على منفذه المحلي
# - ربط الثاني بمنفذ مختلف
# - ضبط مهل الاستقبال
# - التحقق من أن المنافذ المحلية مختلفة
# - إغلاق نظيف للمقبسين
##

استورد مقابس

# إنشاء مقبسين UDP
متغير م1 = أنشئ_مرسال()
متغير م2 = أنشئ_مرسال()
اطبع_سطر(م1 > 0)
اطبع_سطر(م2 > 0)

# ربط الأول بمنفذ مؤقت
خصص_منفذ_رسائل(م1، 0)
متغير منفذ1 = منفذ_محلي(م1)
اطبع_سطر(منفذ1 > 0)

# ربط الثاني بمنفذ مؤقت آخر
خصص_منفذ_رسائل(م2، 0)
متغير منفذ2 = منفذ_محلي(م2)
اطبع_سطر(منفذ2 > 0)

# التحقق أن المنفذين المؤقتين مختلفان (النظام يضمن ذلك)
اطبع_سطر(منفذ1 != منفذ2)

# ضبط مهلة الاستقبال ثم إغلاق
حدد_انتظار_الاستقبال(م1، 200)
حدد_انتظار_الاستقبال(م2، 200)
اطبع_سطر(أغلق_مرسال(م1) و أغلق_مرسال(م2))
