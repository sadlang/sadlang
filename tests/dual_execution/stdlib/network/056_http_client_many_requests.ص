# @description عميل HTTP متعدد الطلبات (إلى منفذ مغلق) — تحقق من عدم تسريب الموارد
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح
# @timeout 60

استورد شبكة

# إنشاء 5 عملاء مع طلبات فاشلة متتالية
متغير عداد = 0
بينما (عداد < 5)
    متغير م = أنشئ_متصفح()
    حدد_الانتظار(م، 100)
    اجلب(م، "http://127.0.0.1:1/")
    # فحص أن العميل قد تم إنشاؤه بنجاح
    اطبع_سطر(م > 0)
    أغلق_متصفح(م)
    عداد = عداد + 1
نهاية
