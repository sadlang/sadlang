# @description نهاية إلى نهاية — OOP echo بسيط عبر UDP
# @expected صحيح\nصحيح\nصحيح
# @timeout 15000

استورد شبكات

متغير ق_منفذ = قناة(1)

# خادم UDP يستلم رسالة واحدة
أطلق
    متغير خادم = مقبس_رسائل()
    خادم.ربط(0)
    ق_منفذ.أرسل(خادم.المنفذ())
    خادم.حدد_مهلة_الاستقبال(5000)
    خادم.استقبل(256)
    خادم.أغلق()
نهاية

متغير منفذ = ق_منفذ.استقبل()
اطبع_سطر(منفذ > 0)

متغير عميل = مقبس_رسائل()
عميل.ربط(0)
اطبع_سطر(عميل.هل_صالح())
عميل.أرسل_لـ("مرحبا"، "127.0.0.1"، منفذ)
عميل.أغلق()

انتظر_الكل()
اطبع_سطر(صحيح)
