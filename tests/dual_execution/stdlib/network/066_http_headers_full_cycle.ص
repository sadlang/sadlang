# @description HTTP عميل — ترويسات ومعلومات الرد
# @expected صحيح\nصحيح\nصحيح

استورد شبكة

متغير م = أنشئ_متصفح()
حدد_الانتظار(م، 200)

# إضافة ترويسات متعددة (الدالة متاحة)
أضف_ترويسة(م، "User-Agent"، "SadTest/1.0")
أضف_ترويسة(م، "Accept"، "application/json")
أضف_ترويسة(م، "X-Custom"، "value1")

# طلب إلى منفذ مغلق
اجلب(م، "http://127.0.0.1:1/")

# العميل لا يزال صالحاً بعد الفشل
اطبع_سطر(م > 0)

# يجب أن يعرف سبب الفشل
متغير سبب = سبب_الفشل(م)
اطبع_سطر(طول(سبب) > 0)

اطبع_سطر(ليس هل_الرد_ناجح(م))

أغلق_متصفح(م)
