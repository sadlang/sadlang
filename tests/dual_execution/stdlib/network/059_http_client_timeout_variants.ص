# @description عميل HTTP مع قيم مهلة متنوعة
# @expected صحيح\nصحيح\nصحيح\nصحيح

استورد شبكة

# مهلة 0 (بعض التنفيذات تعني "لا مهلة")
متغير م1 = أنشئ_متصفح()
حدد_الانتظار(م1، 0)
اطبع_سطر(م1 > 0)
أغلق_متصفح(م1)

# مهلة صغيرة جداً (50ms) — يضمن فشل سريع
متغير م2 = أنشئ_متصفح()
حدد_الانتظار(م2، 50)
اجلب(م2، "http://127.0.0.1:1/")
اطبع_سطر(ليس هل_الرد_ناجح(م2))
أغلق_متصفح(م2)

# مهلة عادية (5 ثواني)
متغير م3 = أنشئ_متصفح()
حدد_الانتظار(م3، 5000)
اطبع_سطر(م3 > 0)
أغلق_متصفح(م3)

# مهلة كبيرة (60 ثانية)
متغير م4 = أنشئ_متصفح()
حدد_الانتظار(م4، 60000)
اطبع_سطر(م4 > 0)
أغلق_متصفح(م4)
