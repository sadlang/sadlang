# @description ثلاثة خوادم TCP تعمل معاً — ربط + استماع + التحقق من المنافذ المختلفة
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح

##
# اختبار إنشاء ثلاثة مقابس TCP منفصلة في نفس الوقت:
# - كل مقبس يُربط بمنفذ مؤقت مستقل
# - كل مقبس يستمع للاتصالات
# - التحقق من أن جميع المنافذ صالحة ومختلفة
# - التحقق من حالة الاتصال قبل أي connect
# - إغلاق جميع المقابس
##

استورد مقابس

# إنشاء ثلاثة مقابس
متغير خ1 = أنشئ_وصلة()
متغير خ2 = أنشئ_وصلة()
متغير خ3 = أنشئ_وصلة()

اطبع_سطر(خ1 > 0)
اطبع_سطر(خ2 > 0)
اطبع_سطر(خ3 > 0)

# ربط واستماع
خصص_منفذ(خ1، 0)
انتظر_اتصالات(خ1)
خصص_منفذ(خ2، 0)
انتظر_اتصالات(خ2)
خصص_منفذ(خ3، 0)
انتظر_اتصالات(خ3)

# الحصول على المنافذ المحلية
متغير م1 = منفذ_محلي(خ1)
متغير م2 = منفذ_محلي(خ2)
متغير م3 = منفذ_محلي(خ3)

# التحقق من صحة المنافذ
اطبع_سطر(م1 > 0)
اطبع_سطر(م2 > 0)
اطبع_سطر(م3 > 0)

# التحقق من تمايز المنافذ
اطبع_سطر(م1 != م2)
اطبع_سطر(م2 != م3)
اطبع_سطر(م1 != م3)

# المقابس ليست متصلة بعد (لم يستدعها أحد)
اطبع_سطر(ليس هل_متصلة(خ1))

# إغلاق جميع المقابس
أغلق_وصلة(خ1)
أغلق_وصلة(خ2)
أغلق_وصلة(خ3)
