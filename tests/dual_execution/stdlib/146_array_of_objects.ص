# @description: اختبار مصفوفة من كائنات صنف
# @expected: أحمد: 90\nسارة: 95\nخالد: 88\nالأعلى: سارة بدرجة 95
# @priority: 1

صنف طالب
    متغير عام الاسم
    متغير عام الدرجة

    باني(اسم، درجة)
        هذا.الاسم = اسم
        هذا.الدرجة = درجة
    نهاية

    دالة عام وصف()
        ارجع هذا.الاسم + ": " + نص(هذا.الدرجة)
    نهاية
نهاية

متغير طلاب = [طالب("أحمد"، 90)، طالب("سارة"، 95)، طالب("خالد"، 88)]

لكل ط في طلاب
    اطبع_سطر(ط.وصف())
نهاية

# إيجاد الأعلى درجة
متغير أعلى = طلاب[0]
متغير ف = 1
بينما (ف < طول(طلاب))
    إذا (طلاب[ف].الدرجة > أعلى.الدرجة)
        أعلى = طلاب[ف]
    نهاية
    ف = ف + 1
نهاية
اطبع_سطر("الأعلى: " + أعلى.الاسم + " بدرجة " + نص(أعلى.الدرجة))
