# @description اختبار دوال رياضيات أساسية — لوغ10، لوغ2، إشارة، حصر، اقتطاع، باقي
# @expected 2\n3\n-1\n1\n0\n10\n0\n5\n3\n-2\n1\n1
# @priority P1

# ============================================================
# دوال وحدة رياضيات — نتائج صحيحة (بدون كسور عشرية)
# ============================================================
استورد رياضيات

# 1. لوغاريتم عشري
اطبع_سطر(لوغ10(100))

# 2. لوغاريتم ثنائي
اطبع_سطر(لوغ2(8))

# 3. دالة الإشارة
اطبع_سطر(إشارة(-5))
اطبع_سطر(إشارة(10))
اطبع_سطر(إشارة(0))

# 4. دالة الحصر (clamp)
اطبع_سطر(حصر(15، 0، 10))
اطبع_سطر(حصر(-5، 0، 10))
اطبع_سطر(حصر(5، 0، 10))

# 5. دالة الاقتطاع (truncate)
اطبع_سطر(اقتطاع(3.7))
اطبع_سطر(اقتطاع(-2.9))

# 6. دالة الباقي (modulo)
اطبع_سطر(باقي(10، 3))
اطبع_سطر(باقي(7، 2))
