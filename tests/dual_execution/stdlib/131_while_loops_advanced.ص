# @description: اختبار حلقات بينما المتداخلة والعدادات
# @expected: 1x1=1\n1x2=2\n2x1=2\n2x2=4\n---\n10\n---\n55
# @priority: 1

# حلقة مضاعفة متداخلة
متغير ص = 1
بينما (ص <= 2)
    متغير س = 1
    بينما (س <= 2)
        اطبع_سطر(نص(ص) + "x" + نص(س) + "=" + نص(ص * س))
        س = س + 1
    نهاية
    ص = ص + 1
نهاية
اطبع_سطر("---")

# عداد تنازلي
متغير مجموع = 0
متغير ع = 4
بينما (ع > 0)
    مجموع = مجموع + ع
    ع = ع - 1
نهاية
اطبع_سطر(مجموع)
اطبع_سطر("---")

# جمع الأرقام من 1 إلى 10
متغير ن = 1
متغير ج = 0
بينما (ن <= 10)
    ج = ج + ن
    ن = ن + 1
نهاية
اطبع_سطر(ج)
