# @description اختبار حلقة بينما (while) — شروط مركبة وحلقات متداخلة
# @expected 10\n9\n8\n7\n6\nمجموع:15\nعداد:2x3=6
# @priority P1

# ============================================================
# 1. حلقة بينما بسيطة — عد تنازلي
# ============================================================
متغير ع = 10
بينما (ع >= 6)
    اطبع_سطر(ع)
    ع = ع - 1
نهاية

# ============================================================
# 2. حلقة بينما مع تراكم
# ============================================================
متغير مجموع = 0
متغير ن = 1
بينما (ن <= 5)
    مجموع = مجموع + ن
    ن = ن + 1
نهاية
اطبع_سطر("مجموع:" + مجموع)

# ============================================================
# 3. حلقات متداخلة
# ============================================================
متغير نتيجة = 0
متغير أ = 0
بينما (أ < 2)
    متغير ب = 0
    بينما (ب < 3)
        نتيجة = نتيجة + 1
        ب = ب + 1
    نهاية
    أ = أ + 1
نهاية
اطبع_سطر("عداد:" + 2 + "x" + 3 + "=" + نتيجة)
