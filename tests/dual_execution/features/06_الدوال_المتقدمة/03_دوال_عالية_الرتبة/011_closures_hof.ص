# @description اختبار الإغلاقات ودوال الدرجة العليا
# @expected 9\n21\n1\n4\n9\n16\n25
# @priority P1

# إغلاق بسيط
دالة مُنشئ_عداد(بداية)
    متغير قيمة = بداية
    ارجع لامدا()
        قيمة = قيمة + 1
        ارجع قيمة
    نهاية
نهاية

متغير عداد = مُنشئ_عداد(8)
اطبع_سطر(عداد())
اطبع_سطر(عداد() + عداد())

# دوال عليا — تطبيق على مصفوفة
دالة تطبيق(مصفوفة، دالة_)
    لكل عنصر في مصفوفة
        اطبع_سطر(دالة_(عنصر))
    نهاية
نهاية

متغير أرقام = [1، 2، 3، 4، 5]
تطبيق(أرقام، لامدا(س) ارجع س * س نهاية)
