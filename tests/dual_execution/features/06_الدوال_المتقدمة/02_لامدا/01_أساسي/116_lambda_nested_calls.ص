# @description اختبار استدعاء لامدا من مصفوفات متداخلة وسلاسل استدعاء
# @expected 20\n30\n15\n25\n9\n16
# @priority P1

# ============================================================
# 1. مصفوفة لامدا مع وسائط متعددة (نبدأ من فهرس 1)
# ============================================================
متغير ضرب = [
    لامدا(س) => س * 2,
    لامدا(س) => س * 4,
    لامدا(س) => س * 6
]

اطبع_سطر(ضرب[1](5))
اطبع_سطر(ضرب[2](5))

# ============================================================
# 2. خريطة لامدا مع عمليات حسابية
# ============================================================
متغير عمليات = {
    "زائد10": لامدا(س) => س + 10,
    "ناقص5": لامدا(س) => س - 5
}

اطبع_سطر(عمليات["زائد10"](5))
اطبع_سطر(عمليات["ناقص5"](30))

# ============================================================
# 3. لامدا تُرجع نتيجة حسابية مركبة
# ============================================================
متغير مربعات = [
    لامدا(س) => س * س,
    لامدا(س) => س * س
]

اطبع_سطر(مربعات[0](3))
اطبع_سطر(مربعات[1](4))
