# @description اختبار لامدا ككائن درجة أولى — تخزين في مصفوفات وخرائط
# @expected 3\n7\n12\nجمع:8\nطرح:2
# @priority P2

# ============================================================
# 1. مصفوفة دوال لامدا
# ============================================================
متغير عمليات = [
    لامدا(س) => س + 1،
    لامدا(س) => س + 5،
    لامدا(س) => س * 3
]

اطبع_سطر(عمليات[0](2))
اطبع_سطر(عمليات[1](2))
اطبع_سطر(عمليات[2](4))

# ============================================================
# 2. خريطة عمليات
# ============================================================
متغير حاسبة = {
    "جمع": لامدا(أ، ب) => أ + ب،
    "طرح": لامدا(أ، ب) => أ - ب
}

اطبع_سطر("جمع:" + حاسبة["جمع"](3، 5))
اطبع_سطر("طرح:" + حاسبة["طرح"](7، 5))
