# @description اختبار شامل للإغلاقات والالتقاط — متغيرات خارجية، تداخل، تمرير كمعامل
# @expected عداد:1\nعداد:2\nعداد:3\nمجموع:15\nتداخل:30\nمعامل:مرحبا_عالم\nمصنع:أ=10\nمصنع:ب=20\nسلسلة:6
# @priority P0

# ============================================================
# 1. التقاط متغير خارجي مع تعديل (عداد)
# ============================================================
دالة منشئ_عداد()
    متغير ع = 0
    ارجع لامدا()
        ع = ع + 1
        ارجع ع
    نهاية
نهاية

متغير عداد = منشئ_عداد()
اطبع_سطر("عداد:" + عداد())
اطبع_سطر("عداد:" + عداد())
اطبع_سطر("عداد:" + عداد())

# ============================================================
# 2. التقاط عدة متغيرات — مُجمّع
# ============================================================
دالة منشئ_مجمع()
    متغير مجموع = 0
    ارجع لامدا(قيمة)
        مجموع = مجموع + قيمة
        ارجع مجموع
    نهاية
نهاية

متغير مجمع = منشئ_مجمع()
مجمع(5)
مجمع(4)
مجمع(3)
مجمع(2)
اطبع_سطر("مجموع:" + مجمع(1))

# ============================================================
# 3. إغلاق متداخل — لامدا تُرجع لامدا
# ============================================================
دالة منشئ_ضارب(أ)
    ارجع لامدا(ب)
        ارجع لامدا(ج)
            ارجع أ * ب * ج
        نهاية
    نهاية
نهاية

متغير ض = منشئ_ضارب(2)
متغير ض2 = ض(3)
اطبع_سطر("تداخل:" + ض2(5))

# ============================================================
# 4. إغلاق كمعامل لدالة أخرى
# ============================================================
دالة طبّق(دالة_، قيمة)
    ارجع دالة_(قيمة)
نهاية

متغير بادئة = "مرحبا"
متغير ربط = لامدا(نهاية_)
    ارجع بادئة + "_" + نهاية_
نهاية

اطبع_سطر("معامل:" + طبّق(ربط، "عالم"))

# ============================================================
# 5. مصنع إغلاقات — كل نسخة مستقلة
# ============================================================
دالة مصنع(اسم، قيمة)
    ارجع لامدا()
        ارجع اسم + "=" + قيمة
    نهاية
نهاية

متغير أ = مصنع("أ"، 10)
متغير ب = مصنع("ب"، 20)
اطبع_سطر("مصنع:" + أ())
اطبع_سطر("مصنع:" + ب())

# ============================================================
# 6. سلسلة إغلاقات — تركيب دوال
# ============================================================
دالة رتبة_عليا(أ)
    ارجع لامدا(ب)
        ارجع أ + ب
    نهاية
نهاية

متغير أضف_واحد = رتبة_عليا(1)
متغير أضف_ثلاثة = رتبة_عليا(3)
اطبع_سطر("سلسلة:" + أضف_ثلاثة(أضف_واحد(2)))
