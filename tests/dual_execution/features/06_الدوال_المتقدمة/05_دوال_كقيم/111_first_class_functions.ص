# @description اختبار دوال من الدرجة الأولى — تمرير واسترجاع دوال كقيم
# @expected 10\n20\n30\n15\n50
# @priority P2

# ============================================================
# 1. تمرير دالة كمعامل
# ============================================================
دالة طبّق(دالة_ف، قيمة)
    ارجع دالة_ف(قيمة)
نهاية

دالة ضعف(س)
    ارجع س * 2
نهاية

دالة ثلاثة_أضعاف(س)
    ارجع س * 3
نهاية

اطبع_سطر(طبّق(ضعف، 5))
اطبع_سطر(طبّق(ضعف، 10))
اطبع_سطر(طبّق(ثلاثة_أضعاف، 10))

# ============================================================
# 2. دالة تُرجع دالة
# ============================================================
دالة مصنع_جامع(ن)
    ارجع لامدا(س) => س + ن
نهاية

متغير جمع_عشرة = مصنع_جامع(10)
اطبع_سطر(جمع_عشرة(5))
اطبع_سطر(جمع_عشرة(40))
