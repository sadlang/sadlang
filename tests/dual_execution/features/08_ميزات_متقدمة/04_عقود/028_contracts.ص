# @description اختبار العقود البرمجية (يتطلب) مع حاول/امسك
# @expected 5\n5\nتم التقاط خطأ القسمة
# @priority P3

دالة قسمة(أ، ب)
    يتطلب ب != 0
    ارجع أ / ب
نهاية

# حالات ناجحة
اطبع_سطر(قسمة(10، 2))
اطبع_سطر(قسمة(15، 3))

# حالة فشل — يجب أن يُطلق خطأ
حاول
    قسمة(10، 0)
امسك خطأ
    اطبع_سطر("تم التقاط خطأ القسمة")
نهاية
