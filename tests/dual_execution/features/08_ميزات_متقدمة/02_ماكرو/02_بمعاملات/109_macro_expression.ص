# @description اختبار الماكرو التعبيري — ماكرو يُرجع قيمة ويُستخدم في تعبيرات
# @expected 25\n5\n15
# @priority P2

# ============================================================
# 1. ماكرو تعبيري بسيط — أكبر قيمة
# ============================================================
ماكرو أكبر(أ، ب)
    إذا (أ > ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

متغير ن = أكبر!(25، 10)
اطبع_سطر(ن)

# ============================================================
# 2. ماكرو تعبيري — أصغر قيمة
# ============================================================
ماكرو أصغر(أ، ب)
    إذا (أ < ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

اطبع_سطر(أصغر!(5، 20))

# ============================================================
# 3. تركيب ماكروات
# ============================================================
متغير النتيجة = أكبر!(أصغر!(15، 30)، 10)
اطبع_سطر(النتيجة)
