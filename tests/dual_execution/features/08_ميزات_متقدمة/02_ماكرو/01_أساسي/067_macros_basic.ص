# @description اختبار الماكروز الأساسية — تعريف، استدعاء، قيمة إرجاع، عزل النطاق
# @expected سجل:مرحبا\nسجل:اختبار\nأكبر:25\nأكبر:100\nمضاعف:20\nمضاعف:6\nعزل:خارجي\nعزل:10\nمتداخل:25
# @priority P2

# ============================================================
# 1. ماكرو بسيط — طباعة مع بادئة
# ============================================================
ماكرو سجّل(رسالة)
    اطبع_سطر("سجل:" + رسالة)
نهاية

سجّل!("مرحبا")
سجّل!("اختبار")

# ============================================================
# 2. ماكرو تعبيري — يُرجع قيمة
# ============================================================
ماكرو أكبر(أ، ب)
    إذا (أ > ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

متغير ن1 = أكبر!(10، 25)
اطبع_سطر("أكبر:" + ن1)
اطبع_سطر("أكبر:" + أكبر!(100، 50))

# ============================================================
# 3. ماكرو مع عمليات حسابية
# ============================================================
ماكرو مضاعف(ن)
    ارجع ن * 2
نهاية

اطبع_سطر("مضاعف:" + مضاعف!(10))
اطبع_سطر("مضاعف:" + مضاعف!(3))

# ============================================================
# 4. عزل النطاق (Macro Hygiene) — متغيرات الماكرو لا تُلوّث الخارج
# ============================================================
متغير قيمة = "خارجي"

ماكرو اختبار_عزل()
    متغير قيمة = "داخلي"
    ارجع 10
نهاية

متغير نتيجة = اختبار_عزل!()
اطبع_سطر("عزل:" + قيمة)
اطبع_سطر("عزل:" + نتيجة)

# ============================================================
# 5. ماكرو متداخل — استدعاء ماكرو من داخل ماكرو
# ============================================================
ماكرو مربع(ن)
    ارجع ن * ن
نهاية

ماكرو مربع_أكبر(أ، ب)
    متغير الأكبر = أكبر!(أ، ب)
    ارجع مربع!(الأكبر)
نهاية

اطبع_سطر("متداخل:" + مربع_أكبر!(3، 5))
