## اختبار التوجيهات الخاصة (@حجم)
## توجيه @حجم يعيد حجم النوع بالبايتات في وقت الترجمة

# قياس حجم نوع الرقم الصحيح (8 بايت على 64 بت)
متغير حجم_رقم = @حجم(رقم)
اطبع_سطر(حجم_رقم)

# قياس حجم نوع العشري (8 بايت IEEE 754)
متغير حجم_عشري = @حجم(عشري)
اطبع_سطر(حجم_عشري)

# تخزين في متغير والطباعة
ثابت الحجم = @حجم(رقم)
اطبع_سطر(الحجم)
