# @description اختبار شامل للتأجيل (defer) — LIFO، كتلة مؤجلة، مع استثناءات، متعدد الدوال
# @expected بداية\nعمل\nتأجيل-3\nتأجيل-2\nتأجيل-1\nتنظيف_ب\nتنظيف_أ\nنتيجة:42\nمحاولة\nأخيراً_تأجيل\nممسوك:خطأ_تجريبي\nبداية_كتلة\nعمل_كتلة\nكتلة_خطوة_2\nكتلة_خطوة_1\nعداد_بعد:3
# @priority P0
# ============================================================
# 1. LIFO الأساسي — ترتيب عكسي
# ============================================================
دالة ترتيب_أساسي()
    اطبع_سطر("بداية")
    أجّل اطبع_سطر("تأجيل-1")
    أجّل اطبع_سطر("تأجيل-2")
    أجّل اطبع_سطر("تأجيل-3")
    اطبع_سطر("عمل")
نهاية

ترتيب_أساسي()

# ============================================================
# 2. تأجيل مع إرجاع قيمة — التأجيل يُنفذ بعد return
# ============================================================
دالة حساب_مع_تنظيف()
    أجّل اطبع_سطر("تنظيف_أ")
    أجّل اطبع_سطر("تنظيف_ب")
    ارجع 42
نهاية

متغير ن = حساب_مع_تنظيف()
اطبع_سطر("نتيجة:" + ن)

# ============================================================
# 3. تأجيل مع try/catch — التأجيل يُنفذ حتى مع استثناء
# ============================================================
دالة مع_خطأ()
    أجّل اطبع_سطر("أخيراً_تأجيل")
    اطبع_سطر("محاولة")
    ارمي "خطأ_تجريبي"
نهاية

حاول
    مع_خطأ()
امسك خ
    اطبع_سطر("ممسوك:" + خ)
نهاية

# ============================================================
# 4. كتلة مؤجلة (defer block)
# ============================================================
دالة كتلة_مؤجلة()
    اطبع_سطر("بداية_كتلة")
    أجّل
        اطبع_سطر("كتلة_خطوة_1")
    نهاية
    أجّل
        اطبع_سطر("كتلة_خطوة_2")
    نهاية
    اطبع_سطر("عمل_كتلة")
نهاية

كتلة_مؤجلة()

# ============================================================
# 5. تأجيل في حلقة — يتراكم
# ============================================================
متغير عداد = 0
دالة تأجيل_حلقة()
    لكل ر في [1، 2، 3]
        أجّل
            عداد = عداد + 1
        نهاية
    نهاية
نهاية

تأجيل_حلقة()
اطبع_سطر("عداد_بعد:" + عداد)
