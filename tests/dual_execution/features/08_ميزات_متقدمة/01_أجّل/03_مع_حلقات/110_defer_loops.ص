# @description اختبار defer مع حلقات — التنظيف يحدث عند خروج الدالة وليس عند كل تكرار
# @expected بدء\nعمل:1\nعمل:2\nعمل:3\nتنظيف_أخير\nبدء2\nانتهاء2\nتأجيل2
# @priority P2

# ============================================================
# 1. defer داخل دالة مع حلقة
# ============================================================
دالة اختبار_حلقة()
    أجّل اطبع_سطر("تنظيف_أخير")
    اطبع_سطر("بدء")
    لكل ع في [1، 2، 3]
        اطبع_سطر("عمل:" + ع)
    نهاية
نهاية
اختبار_حلقة()

# ============================================================
# 2. defer متعدد — ترتيب LIFO مع عمل عادي
# ============================================================
دالة اختبار_ترتيب()
    أجّل اطبع_سطر("تأجيل2")
    اطبع_سطر("بدء2")
    اطبع_سطر("انتهاء2")
نهاية
اختبار_ترتيب()
