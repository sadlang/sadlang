# @description throw داخل شرط — يُلتقط صحيحاً بناءً على الفرع المُنفَّذ
# @priority P1
# @expected E011:BRANCH_TRUE\nE011:CAUGHT:شرط_صحيح\nE011:PASS

# ============================================================
# E011: throw داخل if/else — فقط الفرع المُنفَّذ يرمي
# ============================================================

متغير التقط11 = ""

دالة تحقق_قيمة(قيمة)
    إذا (قيمة > 0)
        اطبع_سطر("E011:BRANCH_TRUE")
        ارمي "شرط_صحيح"
    وإلا
        ارمي "شرط_خاطئ"
    نهاية
نهاية

حاول
    تحقق_قيمة(5)
امسك خ
    التقط11 = خ
نهاية

إذا (التقط11 == "شرط_صحيح")
    اطبع_سطر("E011:CAUGHT:شرط_صحيح")
    اطبع_سطر("E011:PASS")
وإلا
    اطبع_سطر("E011:FAIL:" + التقط11)
نهاية
