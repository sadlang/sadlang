# @description try/catch داخل حلقة — كل تكرار يُعالج خطأه بشكل مستقل
# @priority P1
# @expected E017:0:OK\nE017:1:ERR\nE017:2:OK\nE017:3:ERR\nE017:4:OK\nE017:PASS:3OK_2ERR

# ============================================================
# E017: try/catch داخل حلقة — كل تكرار معزول عن الآخر
# ============================================================

متغير نجح17 = 0
متغير فشل17 = 0

لكل ي في [0، 1، 2، 3، 4]
    حاول
        إذا (ي % 2 == 1)
            ارمي "خطأ_فردي"
        وإلا
            اطبع_سطر("E017:" + ي + ":OK")
            نجح17 = نجح17 + 1
        نهاية
    امسك خ
        اطبع_سطر("E017:" + ي + ":ERR")
        فشل17 = فشل17 + 1
    نهاية
نهاية

إذا (نجح17 == 3 و فشل17 == 2)
    اطبع_سطر("E017:PASS:3OK_2ERR")
وإلا
    اطبع_سطر("E017:FAIL:نجح=" + نجح17 + "_فشل=" + فشل17)
نهاية
