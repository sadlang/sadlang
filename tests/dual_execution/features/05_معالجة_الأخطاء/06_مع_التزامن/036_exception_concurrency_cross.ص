# @description تقاطع الاستثناءات مع التزامن: exception داخل goroutine + cleanup + عدم تعليق
# @priority P2
# @timeout 60
# @expected X01:PASS\nX02:PASS\nX03:PASS\nX04:PASS\nX05:PASS\nX06:PASS\nX07:PASS\nX08:PASS\nX09:PASS\nX10:PASS\nSUMMARY:10/10

متغير نجاح = 0

دالة سجّل(اسم، شرط)
    إذا (شرط)
        اطبع_سطر(اسم + ":PASS")
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر(اسم + ":FAIL")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# X01: حاول/امسك داخل goroutine — الخطأ يُمسك داخلياً
# ─────────────────────────────────────────────────────────────────────────────
متغير ق1 = قناة(1)
أطلق
    حاول
        ارمي "خطأ_داخلي"
    امسك خ
        ق1.أرسل("مسك:" + خ)
    نهاية
نهاية
انتظر_الكل()
متغير ف1 = ق1.استقبل()
سجّل("X01"، ف1 == "مسك:خطأ_داخلي")

# ─────────────────────────────────────────────────────────────────────────────
# X02: أجّل داخل goroutine مع حاول/امسك — يُنفذ عند الخروج
# ─────────────────────────────────────────────────────────────────────────────
متغير ق2 = قناة(2)
أطلق
    دالة عمل2()
        أجّل ق2.أرسل("تنظيف")
        حاول
            ارمي "خطأ2"
        امسك خ2
            ق2.أرسل("مسك")
        نهاية
    نهاية
    عمل2()
نهاية
انتظر_الكل()
متغير ف2أ = ق2.استقبل()
متغير ف2ب = ق2.استقبل()
# (AR) ترتيب: امسك أولاً ثم defer عند الخروج
سجّل("X02"، ف2أ == "مسك" و ف2ب == "تنظيف")

# ─────────────────────────────────────────────────────────────────────────────
# X03: عدة goroutines مع exceptions مستقلة — لا تتداخل
# ─────────────────────────────────────────────────────────────────────────────
متغير ق3 = قناة(3)
لكل i في 1..3
    أطلق
        حاول
            ارمي "خ" + i
        امسك خ3
            ق3.أرسل(خ3)
        نهاية
    نهاية
نهاية
انتظر_الكل()
متغير عدد3 = 0
لكل j في 1..3
    متغير ف3 = ق3.استقبل()
    إذا (ف3 != لاشيء)
        عدد3 = عدد3 + 1
    نهاية
نهاية
سجّل("X03"، عدد3 == 3)

# ─────────────────────────────────────────────────────────────────────────────
# X04: أخيراً داخل goroutine — يُنفذ حتى مع exception
# ─────────────────────────────────────────────────────────────────────────────
متغير ق4 = قناة(2)
أطلق
    حاول
        ارمي "خ4"
    امسك خ4
        ق4.أرسل("امسك")
    أخيراً
        ق4.أرسل("أخيراً")
    نهاية
نهاية
انتظر_الكل()
متغير ف4أ = ق4.استقبل()
متغير ف4ب = ق4.استقبل()
سجّل("X04"، ف4أ == "امسك" و ف4ب == "أخيراً")

# ─────────────────────────────────────────────────────────────────────────────
# X05: مستقبل مع exception في goroutine — set بعد التعافي
# ─────────────────────────────────────────────────────────────────────────────
متغير م5 = مستقبل()
أطلق
    حاول
        ارمي "حسابي"
    امسك خ5
        م5.عيّن("تعافي:" + خ5)
    نهاية
نهاية
انتظر_الكل()
سجّل("X05"، م5.احصل() == "تعافي:حسابي")

# ─────────────────────────────────────────────────────────────────────────────
# X06: قفل مع exception — يجب فتح القفل في أخيراً
# ─────────────────────────────────────────────────────────────────────────────
متغير قف6 = قفل()
متغير نتيجة6 = ""
حاول
    قف6.اقفل()
    ارمي "خطأ_قفل"
امسك خ6
    نتيجة6 = "مسك"
أخيراً
    قف6.افتح()
نهاية
سجّل("X06"، نتيجة6 == "مسك" و قف6.مقفل() == خطأ)

# ─────────────────────────────────────────────────────────────────────────────
# X07: waitgroup مع exception في goroutine — أنهي يُستدعى في أخيراً
# ─────────────────────────────────────────────────────────────────────────────
متغير مج7 = مجموعة_انتظار()
مج7.أضف(1)
أطلق
    حاول
        ارمي "خ7"
    امسك خ7
        # تعافي
    أخيراً
        مج7.أنهي()
    نهاية
نهاية
مج7.انتظر()
سجّل("X07"، مج7.العداد() == 0)

# ─────────────────────────────────────────────────────────────────────────────
# X08: إرسال إلى قناة بعد exception — يجب أن يعمل بعد التعافي
# ─────────────────────────────────────────────────────────────────────────────
متغير ق8 = قناة(1)
حاول
    ارمي "خ8"
امسك خ8
    ق8.أرسل("بعد_التعافي")
نهاية
سجّل("X08"، ق8.استقبل() == "بعد_التعافي")

# ─────────────────────────────────────────────────────────────────────────────
# X09: goroutine متعددة بـ أجّل + exception — كل واحد ينظف مستقلاً
# ─────────────────────────────────────────────────────────────────────────────
متغير ق9 = قناة(10)
لكل k في 1..5
    أطلق
        دالة عمل9()
            أجّل ق9.أرسل("نظف")
            حاول
                ارمي "خطأ9"
            امسك خ9
                # تعافي
            نهاية
        نهاية
        عمل9()
    نهاية
نهاية
انتظر_الكل()
متغير عدد9 = 0
لكل m في 1..5
    متغير ف9 = ق9.حاول_استقبل()
    إذا (ف9 != لاشيء)
        عدد9 = عدد9 + 1
    نهاية
نهاية
سجّل("X09"، عدد9 == 5)

# ─────────────────────────────────────────────────────────────────────────────
# X10: exception متداخلة (حاول داخل حاول) مع goroutine — تنظيف كامل
# ─────────────────────────────────────────────────────────────────────────────
متغير ق10 = قناة(3)
أطلق
    حاول
        حاول
            ارمي "داخلي"
        امسك خ_داخلي
            ق10.أرسل("داخلي:" + خ_داخلي)
            ارمي "خارجي"
        نهاية
    امسك خ_خارجي
        ق10.أرسل("خارجي:" + خ_خارجي)
    أخيراً
        ق10.أرسل("تنظيف_نهائي")
    نهاية
نهاية
انتظر_الكل()
متغير ف10أ = ق10.استقبل()
متغير ف10ب = ق10.استقبل()
متغير ف10ج = ق10.استقبل()
سجّل("X10"، ف10أ == "داخلي:داخلي" و ف10ب == "خارجي:خارجي" و ف10ج == "تنظيف_نهائي")

اطبع_سطر("SUMMARY:" + نجاح + "/10")
