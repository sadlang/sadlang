# @description اختبار معالجة الأخطاء — حاول/امسك/ارمي
# @expected تم التقاط: خطأ مخصص\nتم التنفيذ بنجاح\n42
# @priority P1

حاول
    ارمي "خطأ مخصص"
امسك خطأ
    اطبع_سطر("تم التقاط: " + خطأ)
نهاية

دالة قسمة_آمنة(أ، ب)
    حاول
        إذا (ب == 0)
            ارمي "قسمة على صفر"
        نهاية
        ارجع أ / ب
    امسك خ
        ارجع -1
    نهاية
نهاية

متغير ن1 = قسمة_آمنة(10، 2)
إذا (ن1 != -1)
    اطبع_سطر("تم التنفيذ بنجاح")
نهاية

اطبع_سطر(قسمة_آمنة(84، 2))
