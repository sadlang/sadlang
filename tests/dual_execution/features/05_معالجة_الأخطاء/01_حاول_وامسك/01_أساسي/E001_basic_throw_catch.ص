# ============================================================
# E001: رمي استثناء نصي وإلتقاطه — الحالة الأساسية لنظام الأخطاء
# ============================================================

متغير نتيجة = ""

حاول
    ارمي "رسالة_الخطأ"
امسك خ
    نتيجة = خ
نهاية

إذا (نتيجة == "رسالة_الخطأ")
    اطبع_سطر("E001:PASS")
وإلا
    اطبع_سطر("E001:FAIL:" + نتيجة)
نهاية
