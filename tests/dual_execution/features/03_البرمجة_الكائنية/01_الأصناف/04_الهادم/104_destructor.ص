# @description اختبار الهدم (destructor) في الأصناف — تنظيف الموارد
# @expected إنشاء الكائن\nقراءة: بيانات النظام\nالكائن يعمل
# @priority P2

## هدم هو دالة خاصة تُستدعى عند تدمير الكائن
## تستخدم لتنظيف الموارد مثل إغلاق الملفات والاتصالات

صنف ذاكرة_تخزين
    متغير عام بيانات
    متغير عام نشط

    ## باني الصنف — يهيئ الذاكرة
    باني(بيانات_ابتدائية)
        هذا.بيانات = بيانات_ابتدائية
        هذا.نشط = صحيح
        اطبع_سطر("إنشاء الكائن")
    نهاية

    ## هدم الصنف — يُنظف الموارد عند التدمير
    هدم()
        هذا.نشط = خطأ
        # (AR) تنظيف الموارد — يُستدعى عند انتهاء عمر الكائن
    نهاية

    ## قراءة البيانات المخزنة
    دالة اقرأ_بيانات()
        ارجع "قراءة: " + هذا.بيانات
    نهاية

    ## التحقق من حالة التشغيل
    دالة هل_نشط()
        ارجع هذا.نشط
    نهاية
نهاية

# إنشاء كائن ذاكرة التخزين
متغير ذاكرة = ذاكرة_تخزين("بيانات النظام")
اطبع_سطر(ذاكرة.اقرأ_بيانات())

# التحقق من حالة الكائن
إذا (ذاكرة.هل_نشط())
    اطبع_سطر("الكائن يعمل")
نهاية
