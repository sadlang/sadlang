# @description اختبار تسلسل الباني مع الوراثة — الأساس() واستدعاء باني الأب
# @expected كائن_حي:حي\nحيوان:حي:4\nقطة:حي:4:مواء
# @priority P2

# ============================================================
# 1. وراثة ثلاثية المستويات مع تسلسل الباني
# ============================================================
صنف كائن_حي
    متغير عام الحالة

    باني(حالة)
        هذا.الحالة = حالة
    نهاية

    دالة وصف()
        ارجع هذا.الحالة
    نهاية
نهاية

صنف حيوان يرث كائن_حي
    متغير عام الأرجل

    باني(حالة، أرجل)
        الأساس(حالة)
        هذا.الأرجل = أرجل
    نهاية

    دالة وصف()
        ارجع هذا.الحالة + ":" + هذا.الأرجل
    نهاية
نهاية

صنف قطة يرث حيوان
    متغير عام الصوت

    باني(صوت)
        الأساس("حي"، 4)
        هذا.الصوت = صوت
    نهاية

    دالة وصف()
        ارجع هذا.الحالة + ":" + هذا.الأرجل + ":" + هذا.الصوت
    نهاية
نهاية

# اختبار كل مستوى
متغير ك = كائن_حي("حي")
اطبع_سطر("كائن_حي:" + ك.وصف())

متغير ح = حيوان("حي"، 4)
اطبع_سطر("حيوان:" + ح.وصف())

متغير ق = قطة("مواء")
اطبع_سطر("قطة:" + ق.وصف())
