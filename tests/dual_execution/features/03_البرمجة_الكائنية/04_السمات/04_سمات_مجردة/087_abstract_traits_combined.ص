# @description اختبار OOP متقدم — صنف مجرد + سمة + تنفيذ مشترك
# @expected مساحة_الدائرة:78.5\nمساحة_المثلث:6\nقابل:صحيح\nقابل:صحيح\nوصف:دائرة بنصف قطر 5
# @priority P2

# ============================================================
# 1) صنف مجرد
# ============================================================
صنف شكل_هندسي
    دالة عام مجرد مساحة()

    دالة عام وصف()
        ارجع "شكل هندسي"
    نهاية
نهاية

# ============================================================
# 2) سمة — واجهة قابلة للرسم
# ============================================================
سمة قابل_للرسم
    دالة ارسم()
نهاية

# ============================================================
# 3) صنف يرث مجرد + ينفذ سمة
# ============================================================
صنف دائرة يرث شكل_هندسي
    متغير عام نصف_قطر
    باني(نصف_قطر)
        الأساس()
        هذا.نصف_قطر = نصف_قطر
    نهاية
    دالة عام مساحة()
        ارجع 3.14 * هذا.نصف_قطر * هذا.نصف_قطر
    نهاية
    دالة عام وصف()
        ارجع "دائرة بنصف قطر " + هذا.نصف_قطر
    نهاية
نهاية

نفذ قابل_للرسم لـ دائرة
    دالة ارسم()
        ارجع صحيح
    نهاية
نهاية

صنف مثلث يرث شكل_هندسي
    متغير عام قاعدة
    متغير عام ارتفاع
    باني(قاعدة، ارتفاع)
        الأساس()
        هذا.قاعدة = قاعدة
        هذا.ارتفاع = ارتفاع
    نهاية
    دالة عام مساحة()
        ارجع (هذا.قاعدة * هذا.ارتفاع) / 2
    نهاية
نهاية

نفذ قابل_للرسم لـ مثلث
    دالة ارسم()
        ارجع صحيح
    نهاية
نهاية

متغير د = دائرة(5)
متغير م = مثلث(4، 3)

اطبع_سطر("مساحة_الدائرة:" + د.مساحة())
اطبع_سطر("مساحة_المثلث:" + م.مساحة())
اطبع_سطر("قابل:" + د.ارسم())
اطبع_سطر("قابل:" + م.ارسم())
اطبع_سطر("وصف:" + د.وصف())
