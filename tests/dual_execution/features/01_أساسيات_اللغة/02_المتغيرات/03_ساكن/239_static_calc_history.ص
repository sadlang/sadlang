# @description حاسبة ساكنة: تراكم نتائج عمليات جمع في سجل ساكن
# @expected 7\n15\n10\n32
# @priority P2

# ============================================================
# اختبار: دالة ساكنة تحسب وتسجّل نتائجها في عضو ساكن
# يتحقق من التفاعل بين المتغير الساكن والدوال الساكنة
# ============================================================

# صنف حاسبة تحتفظ بسجل ساكن لمجموع كل العمليات
صنف حاسبة
    متغير ساكن التاريخ = 0

    دالة ساكن اجمع(أ، ب)
        متغير نتيجة = أ + ب
        حاسبة.التاريخ += نتيجة
        ارجع نتيجة
    نهاية

    دالة ساكن احصل_التاريخ()
        ارجع حاسبة.التاريخ
    نهاية
نهاية

# عمليات ثلاث: النتائج 7، 15، 10 — السجل التراكمي = 32
اطبع_سطر(حاسبة.اجمع(3، 4))
اطبع_سطر(حاسبة.اجمع(10، 5))
اطبع_سطر(حاسبة.اجمع(2، 8))
اطبع_سطر(حاسبة.احصل_التاريخ())
