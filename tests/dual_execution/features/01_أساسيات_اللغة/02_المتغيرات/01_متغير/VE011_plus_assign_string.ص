# @description VE-011: += على نص — دمج النصوص بالإسناد المركّب
# @expected أب\nأبجد
# @priority P1

# ============================================================
# اختبار: عامل += على متغير نصي
# يتحقق من أن += يعمل على النصوص مثل + لدمجها
# ============================================================

# نص يُدمج بـ +=
متغير ن = "أ"
ن += "ب"
اطبع_سطر(ن)

# دمج متتالي
متغير م = "أ"
م += "ب"
م += "ج"
م += "د"
اطبع_سطر(م)
