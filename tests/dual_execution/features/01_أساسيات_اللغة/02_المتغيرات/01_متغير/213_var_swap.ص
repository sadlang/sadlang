# @description تبادل قيمتين بين متغيرين باستخدام متغير مؤقت
# @expected 10\n20\n20\n10
# @priority P1

# ============================================================
# اختبار: خوارزمية تبادل القيم (Variable Swap)
# يتحقق من صحة التبادل عبر متغير مؤقت
# ============================================================

# القيم الابتدائية
متغير أ = 10
متغير ب = 20

# طباعة قبل التبادل
اطبع_سطر(أ)
اطبع_سطر(ب)

# خوارزمية التبادل بمتغير مؤقت
متغير مؤقت = أ
أ = ب
ب = مؤقت

# طباعة بعد التبادل — يجب أن تتعكس القيم
اطبع_سطر(أ)
اطبع_سطر(ب)
