# @description VE-004: متغير باسم كلمة سياقية (حالة + غير_متزامن) — سياقي ≠ محجوز
# @expected 42\nنجاح\n10\n15
# @priority P1

# ============================================================
# اختبار: استخدام كلمتين سياقيتين كأسماء متغيرات
# الكلمات السياقية ليست محجوزة — يمكن استخدامها كمتغيرات خارج سياقها
# تم إصلاح فجوة 'حالة' (BF-04 VE-004): الـparser يميز الآن
# بين `حالة س عندما ...` (switch) و `حالة = 5` (تعيين متغير)
# عبر lookahead على الرمز التالي (=, +=, [, ...).
# ============================================================

# 1) كلمة سياقية بسيطة: غير_متزامن
متغير غير_متزامن = 42
اطبع_سطر(غير_متزامن)
غير_متزامن = "نجاح"
اطبع_سطر(غير_متزامن)

# 2) كلمة سياقية تتعارض مع switch: حالة
دالة اختبر_حالة()
    متغير حالة = 10
    اطبع_سطر(حالة)
    حالة = حالة + 5
    اطبع_سطر(حالة)
نهاية

اختبر_حالة()
