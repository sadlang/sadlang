# @description VE-001: متغير يبدأ بشرطة سفلية _ — يجب أن يعمل كأسماء عادية
# @expected 5\n10\n15
# @priority P1

# ============================================================
# اختبار: المتغيرات التي تبدأ بـ _ (شرطة سفلية)
# يتحقق من أن الشرطة السفلية في بداية الاسم مسموح بها
# ============================================================

# متغير يبدأ بـ _
متغير _س = 5
اطبع_سطر(_س)

# متغير بشرطتين سفليتين
متغير __ص = 10
اطبع_سطر(__ص)

# عملية بين متغيرين ذوي شرطة سفلية
متغير _مجموع = _س + __ص
اطبع_سطر(_مجموع)
