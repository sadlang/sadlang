# ============================================================
# اختبار: سلوك المتغيرات داخل الدوال
# يتحقق من التعريف المحلي وإرجاع القيم وتداخل الاستدعاءات
# ============================================================

# دالة تستخدم متغيراً محلياً
دالة مضاعف(قيمة)
    متغير نتيجة = قيمة * 2
    ارجع نتيجة
نهاية

# متغير خارجي — لا يتغير
متغير أ = 5
متغير ب = مضاعف(أ)

# التحقق: أ لم يتغير، ب = ضعف أ
اطبع_سطر(أ)
اطبع_سطر(ب)

# تداخل استدعاءات: مضاعف(مضاعف(3)) = مضاعف(6) = 12
متغير ج = مضاعف(مضاعف(3))
اطبع_سطر(ج)
