# @description عمليات على متغيرات النصوص: ربط، ضم رقم، بنية جملة
# @expected مرحبا_عالم\nالعدد:5\nأبج
# @priority P1

# ============================================================
# اختبار: عمليات ربط النصوص عبر المتغيرات
# يتحقق من صحة الربط والتحويل التلقائي للأنواع
# ============================================================

# ربط متغيرين نصيين
متغير بادئة = "مرحبا_"
متغير لاحقة = "عالم"
متغير كامل = بادئة + لاحقة
اطبع_سطر(كامل)

# ربط نص مع رقم (تحويل تلقائي)
متغير عدد = 5
اطبع_سطر("العدد:" + عدد)

# ربط ثلاثة نصوص حرفية عبر متغير
متغير م = "أ" + "ب" + "ج"
اطبع_سطر(م)
