# ============================================================
# اختبار: ربط النصوص مع متغيرات من أنواع مختلفة
# يتحقق من التحويل التلقائي للرقم عند ربطه بنص
# ============================================================

# ربط متغيري نص لتكوين معلومات نسخة
متغير اسم = "لغة_ص"
متغير نسخة = "1.0"
متغير معلومات = اسم + " v" + نسخة
اطبع_سطر(معلومات)

# ربط نص مع متغير رقمي (تحويل تلقائي)
متغير عدد = 42
متغير جملة = "الجواب هو: " + عدد
اطبع_سطر(جملة)
