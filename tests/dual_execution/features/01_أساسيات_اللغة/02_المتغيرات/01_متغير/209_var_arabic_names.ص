# @description أسماء متغيرات عربية طويلة ذات معنى: مساحة، محيط، متوسط
# @expected المساحة:50\nالمحيط:30\nالمتوسط:7.5
# @priority P1

# ============================================================
# اختبار: استخدام أسماء متغيرات عربية واضحة المعنى
# يتحقق من دعم الأسماء العربية الكاملة في الإعلانات والعمليات
# ============================================================

# أبعاد مستطيل
متغير الطول = 10
متغير العرض = 5

# حسابات هندسية
متغير المساحة = الطول * العرض
متغير المحيط = 2 * (الطول + العرض)
متغير المتوسط = (الطول + العرض) / 2

# طباعة النتائج مع تسميات
اطبع_سطر("المساحة:" + المساحة)
اطبع_سطر("المحيط:" + المحيط)
اطبع_سطر("المتوسط:" + المتوسط)
