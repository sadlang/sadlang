# @description محاكاة عمليتي الزيادة والنقصان بالإسناد المركّب
# @expected 1\n2\n3\n2\n6
# @priority P1

# ============================================================
# اختبار: محاكاة ++ و-- باستخدام += و-=
# يتحقق من تراكم الزيادة والنقصان والضرب المتتالي
# ============================================================

# عداد يبدأ من الصفر
متغير عداد = 0

# زيادة واحدة في كل مرة (محاكاة ++)
عداد += 1
اطبع_سطر(عداد)    # 1

عداد += 1
اطبع_سطر(عداد)    # 2

عداد += 1
اطبع_سطر(عداد)    # 3

# نقصان (محاكاة --)
عداد -= 1
اطبع_سطر(عداد)    # 2

# ضرب
عداد *= 3
اطبع_سطر(عداد)    # 6
