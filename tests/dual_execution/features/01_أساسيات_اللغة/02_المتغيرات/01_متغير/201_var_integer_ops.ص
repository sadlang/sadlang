# @description عمليات حسابية كاملة على متغيرات الأعداد الصحيحة: جمع، طرح، ضرب، باقي، أس
# @expected 130\n70\n3000\n10\n1024
# @priority P1

# ============================================================
# اختبار: العمليات الحسابية على الأعداد الصحيحة
# يتحقق من صحة جميع العمليات الأساسية
# ============================================================

# تعريف متغيرين صحيحين
متغير أ = 100
متغير ب = 30

# جمع: 100 + 30 = 130
اطبع_سطر(أ + ب)

# طرح: 100 - 30 = 70
اطبع_سطر(أ - ب)

# ضرب: 100 * 30 = 3000
اطبع_سطر(أ * ب)

# باقي القسمة: 100 % 30 = 10
اطبع_سطر(أ % ب)

# الأس: 2 ** 10 = 1024
اطبع_سطر(2 ** 10)
