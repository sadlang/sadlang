# @description تعريف متغيرات متعددة في الكود ثم استخدامها في تعابير مختلفة
# @expected 15\n55
# @priority P1

# ============================================================
# اختبار: تعريف وإدارة متغيرات متعددة في نفس النطاق
# يتحقق من صحة الحسابات عند استخدام عدة متغيرات معاً
# ============================================================

# تعريف خمسة متغيرات
متغير أ = 1
متغير ب = 2
متغير ج = 3
متغير د = 4
متغير هـ = 5

# مجموع بسيط: 1+2+3+4+5 = 15
اطبع_سطر(أ + ب + ج + د + هـ)

# مجموع مرجّح: 1+2²+3²+4²+5² = 1+4+9+16+25 = 55
متغير مجموع_موزون = أ + ب * 2 + ج * 3 + د * 4 + هـ * 5
اطبع_سطر(مجموع_موزون)
