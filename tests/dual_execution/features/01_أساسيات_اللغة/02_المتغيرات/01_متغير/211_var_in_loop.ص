# @description متغيرات داخل حلقات: تراكم مجموع وحاصل الضرب
# @expected 15\n24
# @priority P1

# ============================================================
# اختبار: تراكم القيم في متغيرات عبر حلقات لكل
# يتحقق من أن المتغير يتراكم بشكل صحيح عبر التكرارات
# ============================================================

# تراكم المجموع: 1+2+3+4+5 = 15
متغير مجموع = 0
لكل ع في [1، 2، 3، 4، 5]
    مجموع += ع
نهاية
اطبع_سطر(مجموع)

# تراكم الضرب: 1*2*3*4 = 24
متغير حاصل = 1
لكل ع في [1، 2، 3، 4]
    حاصل *= ع
نهاية
اطبع_سطر(حاصل)
