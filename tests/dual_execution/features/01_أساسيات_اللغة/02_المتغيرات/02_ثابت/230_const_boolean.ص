# @description ثوابت منطقية وعملياتها: و، أو، ليس
# @expected صحيح\nخطأ\nخطأ\nصحيح\nصحيح
# @priority P1

# ============================================================
# اختبار: الثوابت المنطقية والعمليات المنطقية عليها
# يتحقق من صحة العمليات المنطقية على الثوابت
# ============================================================

# ثابتان منطقيان
ثابت مفعّل = صحيح
ثابت معطّل = خطأ

# طباعة القيم
اطبع_سطر(مفعّل)
اطبع_سطر(معطّل)

# العمليات المنطقية
اطبع_سطر(مفعّل و معطّل)   # صحيح و خطأ = خطأ
اطبع_سطر(مفعّل أو معطّل)  # صحيح أو خطأ = صحيح
اطبع_سطر(ليس معطّل)        # ليس خطأ = صحيح
