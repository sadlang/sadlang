# @description VE-010: ثابت يُعرَّف بقيمة ثابت آخر — يجب أن يرث القيمة
# @expected 5\n5\n10
# @priority P1

# ============================================================
# اختبار: تعريف ثابت بقيمة ثابت آخر
# يتحقق من أن الثوابت يمكن أن تعتمد على بعضها في التعريف
# ============================================================

# تعريف الثابت الأول
ثابت أ = 5
اطبع_سطر(أ)

# تعريف الثابت الثاني بقيمة الأول
ثابت ب = أ
اطبع_سطر(ب)

# تعريف ثابت ثالث يجمع الأول والثاني
ثابت جـ = أ + ب
اطبع_سطر(جـ)
