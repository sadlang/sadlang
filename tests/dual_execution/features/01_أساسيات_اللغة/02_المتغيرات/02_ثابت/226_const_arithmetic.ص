# ============================================================
# اختبار: استخدام الثوابت في التعابير الحسابية
# يتحقق من أن الثوابت تشارك بشكل صحيح في الحسابات
# ============================================================

# تعريف ثابتين رقميين
ثابت أ = 5
ثابت ب = 3

# جمع: 5 + 3 = 8
اطبع_سطر(أ + ب)

# ضرب: 5 * 3 = 15
اطبع_سطر(أ * ب)

# الأس: 5³ = 125
اطبع_سطر(أ ** ب)

# طرح: 5 - 3 = 2
اطبع_سطر(أ - ب)
