# @description عمليات نصية على ثوابت: ربط ثوابت نصية وإنشاء جمل
# @expected لغة ص | الإصدار: 1.0
# @priority P1

# ============================================================
# اختبار: ربط الثوابت النصية لبناء جمل مركبة
# يتحقق من أن الثوابت النصية تشارك في عمليات الربط
# ============================================================

# ثوابت نصية
ثابت لغة = "ص"
ثابت إصدار = "1.0"
ثابت فاصل = " | "

# بناء جملة معلومات من الثوابت
متغير معلومات = "لغة " + لغة + فاصل + "الإصدار: " + إصدار
اطبع_سطر(معلومات)
