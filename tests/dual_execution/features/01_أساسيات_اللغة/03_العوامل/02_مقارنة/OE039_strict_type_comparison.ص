# ============================================================
# اختبار: المقارنة الصارمة بين أنواع مختلفة
# في لغة ص، المقارنة صارمة: رقم != نص حتى لو لهما نفس القيمة
# ============================================================

# رقم 42 لا يساوي نص "42"
متغير نتيجة1 = 42 == "42"
اطبع_سطر(نتيجة1)

# رقم 0 لا يساوي نص "0"
متغير نتيجة2 = 0 == "0"
اطبع_سطر(نتيجة2)

# رقم 42 يساوي نفسه فقط
متغير نتيجة3 = 42 == 42
اطبع_سطر(نتيجة3)
