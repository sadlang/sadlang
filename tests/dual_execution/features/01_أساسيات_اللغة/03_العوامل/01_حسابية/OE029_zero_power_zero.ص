# @description OE-029: الصفر أسّ الصفر — 0**0 = 1 بالاتفاق الرياضي
# @expected 1\n1\n1
# @priority P1
# (AR) تم إصلاح فجوة المترجم (BF-04): الآن ** يحافظ على نوع المعاملين

# ============================================================
# اختبار: أسّ الصفر في حالات مختلفة
# بالاتفاق الرياضي: 0**0 = 1 (كثير من لغات البرمجة تتفق على ذلك)
# و n**0 = 1 لأي n
# ============================================================

# 0 ** 0 = 1 بالاتفاق
متغير أ = 0 ** 0
اطبع_سطر(أ)

# 5 ** 0 = 1 (أي رقم أسس صفر)
متغير ب = 5 ** 0
اطبع_سطر(ب)

# 100 ** 0 = 1
متغير جـ = 100 ** 0
اطبع_سطر(جـ)
