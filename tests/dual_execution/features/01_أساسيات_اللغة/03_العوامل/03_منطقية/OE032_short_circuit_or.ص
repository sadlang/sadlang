# @description OE-032: التقييم القصير لـ أو — الجانب الثاني لا يُنفَّذ عند صحيح
# @expected لا بأس\nلم تُستدعَ\nاستُدعيت
# @priority P1

# ============================================================
# اختبار: Short-circuit evaluation لعامل أو
# عند كون الجانب الأيسر صحيح، لا يُقيَّم الجانب الأيمن
# هذا يُختبر بتسجيل الاستدعاءات
# ============================================================

# متغير لتتبع الاستدعاءات
متغير عداد = 0

# دالة ذات تأثير جانبي — تزيد العداد عند الاستدعاء
دالة ذات_تأثير()
    عداد = عداد + 1
    ارجع صحيح
نهاية

# الشرط: صحيح أو ذات_تأثير() — الدالة لا تُستدعى (تقييم قصير)
إذا (صحيح أو ذات_تأثير())
    اطبع_سطر("لا بأس")
نهاية

# إذا كان العداد 0 فالتقييم القصير يعمل
إذا (عداد == 0)
    اطبع_سطر("لم تُستدعَ")
نهاية

# إعادة ضبط العداد
عداد = 0

# الشرط: خطأ أو ذات_تأثير() — الدالة يجب أن تُستدعى هنا
إذا (خطأ أو ذات_تأثير())
    اطبع_سطر("استُدعيت")
نهاية
