# @description OE-033/034/035: && مكافئ لـ و ، || مكافئ لـ أو ، ! مكافئ لـ ليس
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح
# @priority P1

# ============================================================
# اختبار: تكافؤ العوامل المنطقية العربية والرمزية
# يتحقق من أن && == و ، || == أو ، ! == ليس
# ============================================================

# && مكافئ لـ و
اطبع_سطر(صحيح && صحيح)      # صحيح
اطبع_سطر(صحيح و صحيح)      # صحيح — يجب أن يتطابق

# || مكافئ لـ أو
اطبع_سطر(خطأ || صحيح)      # صحيح
اطبع_سطر(خطأ أو صحيح)      # صحيح — يجب أن يتطابق

# ! مكافئ لـ ليس
اطبع_سطر(!خطأ)              # صحيح
اطبع_سطر(ليس خطأ)          # صحيح — يجب أن يتطابق
