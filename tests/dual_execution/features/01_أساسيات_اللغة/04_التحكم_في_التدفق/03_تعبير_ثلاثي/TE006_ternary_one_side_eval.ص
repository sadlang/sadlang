# @description TE-006: ثلاثي — الفرع غير المختار لا يُنفَّذ تأثيره الجانبي
# @expected الفرع الأول\n1
# @priority P1

# ============================================================
# اختبار: العامل الثلاثي يُقيِّم الفرع المختار فقط
# يجب أن لا يُنفَّذ تأثير الفرع الآخر الجانبي
# ============================================================

# عداد التأثيرات الجانبية
متغير عداد = 0

دالة فرع_أ()
    عداد = عداد + 1
    ارجع "الفرع الأول"
نهاية

دالة فرع_ب()
    عداد = عداد + 1
    ارجع "الفرع الثاني"
نهاية

# الشرط صحيح — فقط فرع_أ() يُستدعى
متغير نتيجة = صحيح ? فرع_أ() : فرع_ب()
اطبع_سطر(نتيجة)

# يجب أن يكون العداد = 1 (دالة واحدة فقط استُدعيت)
اطبع_سطر(عداد)
