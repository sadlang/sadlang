# @description CE-028: شرط مركّب بسلسلة مقارنات — صحيح إذا 0 < أ < 10
# @expected في النطاق\nخارج النطاق\nخارج النطاق
# @priority P1

# ============================================================
# اختبار: التحقق من أن قيمة بين حدين باستخدام و
# يتحقق من أن سلسلة المقارنات (0 < أ و أ < 10) تعمل
# ============================================================

دالة افحص(أ)
    إذا (0 < أ و أ < 10)
        اطبع_سطر("في النطاق")
    وإلا
        اطبع_سطر("خارج النطاق")
    نهاية
نهاية

# قيم اختبار: داخل، تحت الحد، فوق الحد
افحص(5)
افحص(-3)
افحص(15)
