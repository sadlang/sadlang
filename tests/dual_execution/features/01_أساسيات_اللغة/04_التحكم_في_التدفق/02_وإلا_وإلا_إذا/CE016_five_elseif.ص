# ============================================================
# اختبار: سلسلة شروط من 5 مستويات
# جميع الشروط الأربعة الأولى خاطئة، فقط الأخير صحيح
# ============================================================

متغير ن = 5

إذا (ن == 1)
    اطبع_سطر("الأول")
وإلا إذا (ن == 2)
    اطبع_سطر("الثاني")
وإلا إذا (ن == 3)
    اطبع_سطر("الثالث")
وإلا إذا (ن == 4)
    اطبع_سطر("الرابع")
وإلا إذا (ن == 5)
    اطبع_سطر("الخامس")
نهاية
