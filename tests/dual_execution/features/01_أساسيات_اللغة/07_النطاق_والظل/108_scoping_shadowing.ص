# @description اختبار النطاقات وتظليل المتغيرات (Scoping and Variable Shadowing)
# @expected 10\n20\n20\nداخل:50\nخارج:50\nدالة:100\nرئيسي:10
# @priority P1

# ============================================================
# 1. تظليل في كتلة إذا
# ============================================================
متغير س = 10
اطبع_سطر(س)

إذا (صحيح)
    متغير س = 20
    اطبع_سطر(س)
نهاية

اطبع_سطر(س)

# ============================================================
# 2. تظليل في حلقة
# ============================================================
متغير ص = 10
لكل ع في [50]
    متغير ص = ع
    اطبع_سطر("داخل:" + ص)
نهاية
اطبع_سطر("خارج:" + ص)

# ============================================================
# 3. تظليل في دالة
# ============================================================
متغير ز = 10

دالة غير_الظل()
    متغير ز = 100
    ارجع ز
نهاية

اطبع_سطر("دالة:" + غير_الظل())
اطبع_سطر("رئيسي:" + ز)
