# @description: اختبار صنف مع دوال متعددة وتعديل الحالة
# @expected: 0\n100\n50\n150
# @priority: 1

صنف حساب
    متغير عام الرصيد

    باني()
        هذا.الرصيد = 0
    نهاية

    دالة عام إيداع(مبلغ)
        هذا.الرصيد = هذا.الرصيد + مبلغ
    نهاية

    دالة عام سحب(مبلغ)
        إذا (مبلغ > هذا.الرصيد)
            ارجع خطأ
        نهاية
        هذا.الرصيد = هذا.الرصيد - مبلغ
        ارجع صحيح
    نهاية

    دالة عام الرصيد_الحالي()
        ارجع هذا.الرصيد
    نهاية
نهاية

متغير ح = حساب()
اطبع_سطر(ح.الرصيد_الحالي())

ح.إيداع(100)
اطبع_سطر(ح.الرصيد_الحالي())

ح.سحب(50)
اطبع_سطر(ح.الرصيد_الحالي())

ح.إيداع(100)
