# @description: اختبار توقف واستمر في الحلقات
# @expected: 1\n2\n3\n---\n1\n3\n5
# @priority: 1

# توقف من الحلقة
متغير ع = 1
بينما (ع <= 10)
    إذا (ع > 3)
        توقف
    نهاية
    اطبع_سطر(ع)
    ع = ع + 1
نهاية
اطبع_سطر("---")

# استمر لتخطي الأرقام الزوجية
متغير ي = 0
بينما (ي < 6)
    ي = ي + 1
    إذا (ي % 2 == 0)
        استمر
    نهاية
    اطبع_سطر(ي)
نهاية
