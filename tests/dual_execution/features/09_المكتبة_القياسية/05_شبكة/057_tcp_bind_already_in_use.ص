# @description محاولة إنشاء مقبس ثانٍ — الإنشاء ينجح حتى لو كان المنفذ مستخدماً
# @expected صحيح\nصحيح

استورد مقابس

# ربط أول
متغير م1 = أنشئ_وصلة()
خصص_منفذ(م1، 0)
انتظر_اتصالات(م1)
متغير منفذ = منفذ_محلي(م1)
اطبع_سطر(منفذ > 0)

# مقبس ثانٍ — الإنشاء يجب أن ينجح
متغير م2 = أنشئ_وصلة()
اطبع_سطر(م2 > 0)

أغلق_وصلة(م1)
أغلق_وصلة(م2)
