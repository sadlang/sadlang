# @description إعداد شامل لعميل HTTP: ترويسات + انتظار + رمز + رابط أساسي + فحص الحالة
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح

##
# اختبار تكوين عميل HTTP كامل:
# - إنشاء العميل
# - ضبط الرابط الأساسي
# - إضافة ترويسات متعددة (Content-Type, Accept, X-Custom)
# - ضبط الانتظار القصير
# - تعيين رمز التفويض
# - إرسال طلب GET فاشل (رابط محلي مغلق)
# - التحقق من حالة الخطأ
# - إغلاق العميل
##

استورد شبكة

متغير م = أنشئ_متصفح()
اطبع_سطر(م > 0)

# ضبط الإعدادات
اطبع_سطر(حدد_الموقع(م، "http://127.0.0.1:9"))
اطبع_سطر(أضف_ترويسة(م، "Content-Type"، "application/json"))
اطبع_سطر(أضف_ترويسة(م، "Accept"، "application/json"))
اطبع_سطر(أضف_ترويسة(م، "X-Custom-Header"، "test-value"))
اطبع_سطر(سجل_دخول_برمز(م، "my-secret-token"))

# ضبط مهلة قصيرة ثم إرسال طلب فاشل
حدد_الانتظار(م، 200)
اجلب(م، "/api/test")

# التحقق من حالة الفشل وسبب الخطأ
اطبع_سطر(ليس هل_نجح(م))
اطبع_سطر(طول(سبب_الفشل(م)) > 0)

أغلق_متصفح(م)
