# @description معالجة مهل معقدة: تغيير المهل ديناميكياً + تأثيرها على الاستقبال
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح

##
# اختبار معالجة المهل الديناميكية في المقابس:
# - TCP: ضبط مهلة قصيرة → محاولة استقبال → timeout → تغيير المهلة → محاولة ثانية
# - UDP: نفس التسلسل
# - التحقق من أن المهلة تؤثر فعلياً على الاستقبال (يعود فارغاً عند timeout)
##

استورد مقابس

# ── TCP: مهلة قصيرة → استقبال فارغ (timeout) ─────────────────
متغير و = أنشئ_وصلة()
اطبع_سطر(و > 0)

# مهلة قصيرة جداً (50ms) — الاستقبال يجب أن يُرجع فارغاً
حدد_انتظار_الاستقبال(و، 50)
متغير ر1 = استقبل_عبر_وصلة(و، 32)
اطبع_سطر(طول(ر1) == 0)  # فارغ لأنه لا يوجد بيانات

# تغيير المهلة إلى 100ms
اطبع_سطر(حدد_انتظار_الاستقبال(و، 100))
متغير ر2 = استقبل_عبر_وصلة(و، 32)
اطبع_سطر(طول(ر2) == 0)  # لا يزال فارغاً
أغلق_وصلة(و)

# ── UDP: مهلة قصيرة → استقبال فارغ ───────────────────────────
متغير م = أنشئ_مرسال()
خصص_منفذ_رسائل(م، 0)
اطبع_سطر(منفذ_محلي(م) > 0)

# مهلة قصيرة (50ms)
حدد_انتظار_الاستقبال(م، 50)
متغير ر3 = استقبل_رسالة(م، 32)
اطبع_سطر(طول(ر3) == 0)  # فارغ لأنه لا يوجد بيانات

أغلق_مرسال(م)
