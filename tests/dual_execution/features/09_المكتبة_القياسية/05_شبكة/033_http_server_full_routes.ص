# @description خادم HTTP مع تسجيل 4 مسارات (GET/POST/PUT/DELETE) + CORS + إيقاف وإزالة
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح

##
# اختبار دورة حياة خادم HTTP كاملة:
# - إنشاء الخادم على منفذ مؤقت (0)
# - تسجيل معالجات لجميع أنواع المسارات (GET, POST, PUT, DELETE)
# - تفعيل CORS
# - إيقاف الخادم وإزالته
##

استورد شبكة

دالة معالج_الجلب()
    عين_نص_الرد("{\"msg\":\"مرحبا\"}")
نهاية

دالة معالج_الإرسال()
    عين_حالة_الرد(201)
    عين_رد_جيسون("{\"created\":true}")
نهاية

دالة معالج_الاستبدال()
    عين_حالة_الرد(200)
    عين_نص_الرد("updated")
نهاية

دالة معالج_الحذف()
    عين_حالة_الرد(204)
نهاية

# إنشاء الخادم
متغير خ = أنشئ_خادم(0)
اطبع_سطر(خ > 0)

# تسجيل جميع أنواع المسارات
اطبع_سطر(عند_طلب_جلب(خ، "/api/items"، "معالج_الجلب"))
اطبع_سطر(عند_طلب_إرسال(خ، "/api/items"، "معالج_الإرسال"))
اطبع_سطر(عند_طلب_استبدال(خ، "/api/items"، "معالج_الاستبدال"))
اطبع_سطر(عند_طلب_حذف(خ، "/api/items"، "معالج_الحذف"))

# تفعيل CORS وإيقاف الخادم وإزالته
اطبع_سطر(اسمح_بالوصول_الخارجي(خ، "https://example.com"))
اطبع_سطر(أوقف_الخادم(خ))
اطبع_سطر(أزل_خادم(خ))
