# @description سلسلة أخطاء شبكة متتالية: TCP + UDP + HTTP في تسلسل معقد
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح
# @timeout 30
# @priority P2

##
# اختبار سلسلة أخطاء شبكة متتالية:
# 1. TCP: محاولة اتصال بمنفذ مغلق → فشل → تنظيف
# 2. UDP: إرسال لعنوان غير موجود → فشل → تنظيف
# 3. HTTP: 3 طلبات فاشلة متتالية + التحقق من تراكم الأخطاء
# - التحقق من أن الأخطاء تُكتشف بشكل صحيح في كل مرحلة
##

استورد مقابس
استورد شبكة

# ── المرحلة 1: TCP فاشل ─────────────────────────────────────────
متغير و = أنشئ_وصلة()
حدد_انتظار_الاستقبال(و، 100)
متغير اتصال = اتصل_بـ(و، "127.0.0.1"، 1)  # منفذ 1 مغلق دائماً
اطبع_سطر(ليس اتصال)        # يجب أن يفشل
اطبع_سطر(ليس هل_متصلة(و))  # لم يتصل
أغلق_وصلة(و)

# ── المرحلة 2: UDP فاشل ─────────────────────────────────────────
متغير م = أنشئ_مرسال()
متغير مُرسل = أرسل_رسالة(م، "test"، "invalid.hostname.test"، 9999)
اطبع_سطر(مُرسل == -1)       # يجب أن يفشل
أغلق_مرسال(م)

# ── المرحلة 3: HTTP متعدد الفشل ────────────────────────────────
متغير عميل = أنشئ_متصفح()
حدد_الانتظار(عميل، 150)

# طلب 1 فاشل
اجلب(عميل، "http://127.0.0.1:2/a")
اطبع_سطر(ليس هل_نجح(عميل))
متغير خطأ1 = طول(سبب_الفشل(عميل)) > 0
اطبع_سطر(خطأ1)

# طلب 2 فاشل — يجب تحديث سبب الخطأ
أرسل(عميل، "http://127.0.0.1:3/b"، "data")
اطبع_سطر(ليس هل_نجح(عميل))

أغلق_متصفح(عميل)
