# @description تسلسل كامل على متصفح_ويب — جميع الدوال
# @expected صحيح\nصحيح\nصحيح\nخطأ\nخطأ
# @skip_compiler

استورد شبكات

متغير م = متصفح_ويب()
اطبع_سطر(م.هل_صالح())

# تسلسل الإعدادات
م.اضبط_الرابط("http://127.0.0.1:1")
م.اضبط_المهلة(150)
م.أضف_رأس("X-A"، "1")
م.أضف_رأس("X-B"، "2")
م.أضف_رأس("X-C"، "3")
م.مصادقة("token-xyz")
اطبع_سطر(م.هل_صالح())

# جميع الطرق على منفذ مغلق
م.استرجع("/a")
م.أرسل_طلب("/b"، "{}")
م.أرسل_تحديث("/c"، "{}")
م.أحذف("/d")
م.رقّع("/e"، "{}")
اطبع_سطر(م.هل_صالح())
اطبع_سطر(م.ناجح())

م.أغلق()
اطبع_سطر(م.هل_صالح())
