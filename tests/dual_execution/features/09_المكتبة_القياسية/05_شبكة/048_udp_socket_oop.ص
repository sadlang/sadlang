# @description اختبار صنف مقبس_رسائل (UDP) الكائني من مكتبة شبكات.ص
# @expected صحيح\nصحيح\nصحيح\nخطأ\nصحيح\nصحيح\nخطأ
# @skip_compiler

استورد شبكات

# ── دورة حياة أساسية ──────────────────────────────────────────────
متغير م = مقبس_رسائل()
اطبع_سطر(م.هل_صالح())     # صحيح — تم الإنشاء

# ── ربط بمنفذ عشوائي والتحقق من المنفذ المُخصّص ─────────────────
م.ربط(0)
اطبع_سطر(م.هل_صالح())     # صحيح — بعد الربط
اطبع_سطر(م.المنفذ() > 0)  # صحيح — منفذ عشوائي > 0
م.أغلق()
اطبع_سطر(م.هل_صالح())     # خطأ — بعد الإغلاق

# ── إرسال لمنفذ مغلق لا يُلقي استثناء في UDP ──────────────────
متغير م2 = مقبس_رسائل()
اطبع_سطر(م2.هل_صالح())    # صحيح
م2.حدد_مهلة_الإرسال(200)
م2.حدد_مهلة_الاستقبال(200)
م2.أرسل_لـ("رسالة اختبار"، "127.0.0.1"، 1)   # UDP يُرسل بدون خطأ حتى لو المنفذ مغلق
اطبع_سطر(م2.هل_صالح())    # صحيح — UDP لا ينتظر تأكيداً
م2.أغلق()
اطبع_سطر(م2.هل_صالح())    # خطأ
