# @description اختبار اختبار الخصائص — تحقق تبادلي وتجميعي
# @expected ✓ خاصية الجمع التبادلي (10/10 تكرار نجح)\n✓ خاصية الضرب التبادلي (5/5 تكرار نجح)\nجميع الاختبارات نجحت
# @priority P3

اختبر("خاصية الجمع التبادلي") تكرارات 10 بذرة 42
    متغير أ = _تكرار + 1
    متغير ب = _تكرار * 2
    إذا (أ + ب != ب + أ)
        ارمي "ليس تبادلياً!"
    نهاية
نهاية

اختبر("خاصية الضرب التبادلي") تكرارات 5 بذرة 7
    متغير أ = _تكرار + 1
    متغير ب = _تكرار + 3
    إذا (أ * ب != ب * أ)
        ارمي "الضرب ليس تبادلياً!"
    نهاية
نهاية

اطبع_سطر("جميع الاختبارات نجحت")
