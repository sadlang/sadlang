# @description اختبار كائنات داخل مصفوفات — تكرار وتعدد الأشكال
# @expected مرحبا من أحمد\nمرحبا من سارة\nمرحبا من خالد\nالمجموع:75
# @priority P2

# ============================================================
# 1. مصفوفة كائنات
# ============================================================
صنف شخص
    متغير عام الاسم
    متغير عام العمر

    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية

    دالة تحية()
        ارجع "مرحبا من " + هذا.الاسم
    نهاية
نهاية

متغير أشخاص = [
    شخص("أحمد"، 25)،
    شخص("سارة"، 30)،
    شخص("خالد"، 20)
]

لكل ش في أشخاص
    اطبع_سطر(ش.تحية())
نهاية

# ============================================================
# 2. حساب تجميعي على كائنات
# ============================================================
متغير مجموع = 0
لكل ش في أشخاص
    مجموع = مجموع + ش.العمر
نهاية
اطبع_سطر("المجموع:" + مجموع)
