# @description اختبار أنماط متعددة — وراثة وكائنات ودوال عليا معاً
# @expected سيارة: تويوتا 2020\nمحرك يعمل\nسيارة: هوندا 2023\nمحرك يعمل\nعدد السيارات: 2
# @priority P3

# صنف سيارة مع إنشاء كائنات ودوال عليا
صنف سيارة
    متغير عام ماركة
    متغير عام سنة
    باني(ماركة، سنة)
        هذا.ماركة = ماركة
        هذا.سنة = سنة
    نهاية
    دالة عام وصف()
        ارجع "سيارة: " + هذا.ماركة + " " + هذا.سنة
    نهاية
    دالة عام تشغيل()
        اطبع_سطر("محرك يعمل")
    نهاية
نهاية

# إنشاء كائنات
متغير س1 = سيارة("تويوتا"، 2020)
متغير س2 = سيارة("هوندا"، 2023)

# استخدام الكائنات
متغير سيارات = [س1، س2]
لكل س في سيارات
    اطبع_سطر(س.وصف())
    س.تشغيل()
نهاية

اطبع_سطر("عدد السيارات: " + طول(سيارات))
