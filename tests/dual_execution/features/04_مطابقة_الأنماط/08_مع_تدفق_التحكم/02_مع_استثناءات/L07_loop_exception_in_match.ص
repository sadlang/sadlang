# اختبار L07: لكل داخل match مع رمي استثناء
# هدف: حلقة داخل match arm تُرمي استثناء في منتصفها
# المخرج: ناجح، فاشل بخطأ، غير محدد

دالة معالج(نوع)
    طابق (نوع)
        عندما "آمن":
            لكل عنصر في [1، 2، 3]
                اطبع_سطر("عنصر: " + نص(عنصر))
            نهاية
        عندما "خطير":
            لكل عنصر في [1، 2، 3]
                إذا (عنصر == 2)
                    ارمي "خطأ في العنصر 2"
                نهاية
                اطبع_سطر("عنصر: " + نص(عنصر))
            نهاية
        افتراضي:
            اطبع_سطر("غير محدد")
    نهاية
نهاية

معالج("آمن")
حاول
    معالج("خطير")
امسك خطأ
    اطبع_سطر("خطأ: " + خطأ)
نهاية
معالج("آخر")
