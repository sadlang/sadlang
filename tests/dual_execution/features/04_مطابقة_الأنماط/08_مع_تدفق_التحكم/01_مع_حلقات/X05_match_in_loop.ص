##
# X05: طابق في حلقة مع تراكم النتائج
# سيناريو: تصنيف مجموعة من البيانات
##

متغير بيانات = [1، 5، 12، 0، -3، 7، 100، -50، 42، 0]

متغير موجبة = 0
متغير سالبة = 0
متغير أصفار = 0
متغير كبيرة = 0

لكل ق في بيانات
    طابق (ق)
        عندما 0:
            أصفار = أصفار + 1
        عندما 1..100 إذا ق > 50:
            كبيرة = كبيرة + 1
            موجبة = موجبة + 1
        عندما 1..100:
            موجبة = موجبة + 1
        افتراضي:
            سالبة = سالبة + 1
    نهاية
نهاية

اطبع_سطر("موجبة: " + موجبة)
اطبع_سطر("سالبة: " + سالبة)
اطبع_سطر("أصفار: " + أصفار)
اطبع_سطر("كبيرة(>50): " + كبيرة)

##
# طابق على تعبيرات حسابية معقدة
##
دالة تصنيف_مثلث(أ، ب، ج)
    # التحقق من أن المثلث صحيح
    إذا (أ + ب <= ج || أ + ج <= ب || ب + ج <= أ)
        ارجع "غير مثلث"
    نهاية

    متغير نوع = ""

    # هل هو قائم؟
    طابق (أ*أ + ب*ب == ج*ج || أ*أ + ج*ج == ب*ب || ب*ب + ج*ج == أ*أ)
        عندما صحيح:
            نوع = "قائم"
        افتراضي:
            نوع = ""
    نهاية

    # هل هو متساوي الساقين؟
    طابق (أ == ب || ب == ج || أ == ج)
        عندما صحيح:
            إذا (نوع == "")
                نوع = "متساوي الساقين"
            وإلا
                نوع = نوع + " متساوي الساقين"
            نهاية
        افتراضي:
            إذا (نوع == "")
                نوع = "عشوائي"
            نهاية
    نهاية

    ارجع نوع
نهاية

اطبع_سطر(تصنيف_مثلث(3، 4، 5))
اطبع_سطر(تصنيف_مثلث(5، 5، 5))
اطبع_سطر(تصنيف_مثلث(5، 5، 8))
اطبع_سطر(تصنيف_مثلث(3، 4، 8))
