# @description اختبار أنماط القائمة والبدائل (OR) — تفكيك مصفوفة، بدائل ||، نطاق مع OR
# @expected زوج:1 و 2\nثلاثي:10 و 20 و 30\nفارغة:فارغ\nآخر:عادي\nلون:دافئ\nلون:بارد\nلون:بارد\nلون:محايد\nتقييم:ممتاز\nتقييم:جيد\nتقييم:مقبول\nتقييم:راسب\nيوم:عطلة\nيوم:عمل\nيوم:عطلة
# @priority P1

# ============================================================
# 1. مطابقة أنماط القائمة (تفكيك مصفوفة)
# ============================================================
دالة وصف_قائمة(ق)
    طابق (ق)
        عندما [أ، ب]:
            ارجع "زوج:" + أ + " و " + ب
        عندما [أ، ب، ج]:
            ارجع "ثلاثي:" + أ + " و " + ب + " و " + ج
        عندما []:
            ارجع "فارغ"
        افتراضي:
            ارجع "عادي"
    نهاية
نهاية

اطبع_سطر(وصف_قائمة([1، 2]))
اطبع_سطر(وصف_قائمة([10، 20، 30]))
اطبع_سطر("فارغة:" + وصف_قائمة([]))
اطبع_سطر("آخر:" + وصف_قائمة([1، 2، 3، 4]))

# ============================================================
# 2. بدائل OR (||) في المطابقة
# ============================================================
دالة نوع_لون(لون)
    طابق (لون)
        عندما "أحمر" || "برتقالي" || "أصفر":
            ارجع "دافئ"
        عندما "أزرق" || "أخضر":
            ارجع "بارد"
        افتراضي:
            ارجع "محايد"
    نهاية
نهاية

اطبع_سطر("لون:" + نوع_لون("أحمر"))
اطبع_سطر("لون:" + نوع_لون("أزرق"))
اطبع_سطر("لون:" + نوع_لون("أخضر"))
اطبع_سطر("لون:" + نوع_لون("بنفسجي"))

# ============================================================
# 3. OR مع نطاقات
# ============================================================
دالة تقييم_درجة(درجة)
    طابق (درجة)
        عندما 90..101:
            ارجع "ممتاز"
        عندما 70..90:
            ارجع "جيد"
        عندما 50..70:
            ارجع "مقبول"
        افتراضي:
            ارجع "راسب"
    نهاية
نهاية

اطبع_سطر("تقييم:" + تقييم_درجة(95))
اطبع_سطر("تقييم:" + تقييم_درجة(80))
اطبع_سطر("تقييم:" + تقييم_درجة(60))
اطبع_سطر("تقييم:" + تقييم_درجة(30))

# ============================================================
# 4. OR مع أرقام محددة
# ============================================================
دالة نوع_يوم(رقم_يوم)
    طابق (رقم_يوم)
        عندما 6 || 7:
            ارجع "عطلة"
        افتراضي:
            ارجع "عمل"
    نهاية
نهاية

اطبع_سطر("يوم:" + نوع_يوم(6))
اطبع_سطر("يوم:" + نوع_يوم(3))
اطبع_سطر("يوم:" + نوع_يوم(7))
