# اختبار N07: match يحدد العملية الحسابية
# هدف: match كـ dispatcher للعمليات الأربعة
# المخرج: 6 نتائج حسابية

دالة احسب_عملية(عملية، أ، ب)
    طابق (عملية)
        عندما "جمع":
            ارجع أ + ب
        عندما "طرح":
            ارجع أ - ب
        عندما "ضرب":
            ارجع أ * ب
        عندما "قسمة":
            إذا (ب != 0)
                ارجع رقم(أ / ب)
            وإلا
                ارجع 0
            نهاية
        افتراضي:
            ارجع -1
    نهاية
نهاية

اطبع_سطر(نص(احسب_عملية("جمع"، 10، 5)))
اطبع_سطر(نص(احسب_عملية("طرح"، 10، 5)))
اطبع_سطر(نص(احسب_عملية("ضرب"، 10، 5)))
اطبع_سطر(نص(احسب_عملية("قسمة"، 10، 5)))
اطبع_سطر(نص(احسب_عملية("قسمة"، 10، 0)))
اطبع_سطر(نص(احسب_عملية("آخر"، 10، 5)))
