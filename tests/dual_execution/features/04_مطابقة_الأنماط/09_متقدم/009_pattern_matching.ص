# @description اختبار مطابقة الأنماط — طابق/عندما
# @expected طفل\nبالغ\nثلاثة\nآخر
# @priority P1

دالة فئة_عمر(عمر)
    طابق (عمر)
        عندما 0..13:
            ارجع "طفل"
        عندما 13..20:
            ارجع "مراهق"
        افتراضي:
            ارجع "بالغ"
    نهاية
نهاية

اطبع_سطر(فئة_عمر(8))
اطبع_سطر(فئة_عمر(35))

دالة اسم_رقم(ن)
    طابق (ن)
        عندما 1:
            ارجع "واحد"
        عندما 2:
            ارجع "اثنان"
        عندما 3:
            ارجع "ثلاثة"
        افتراضي:
            ارجع "آخر"
    نهاية
نهاية

اطبع_سطر(اسم_رقم(3))
اطبع_سطر(اسم_رقم(99))
