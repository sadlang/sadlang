# @description اختبار مطابقة أنماط متقدمة — نطاقات + OR + متغيرات ربط
# @expected طفل\nمراهق\nبالغ\nنتيجة:صفر_أو_واحد\nنتيجة:كبير\nنتيجة:وسط\nقيمة:42\nقيمة:99
# @priority P2

# ============================================================
# 1) مطابقة نطاقات (range patterns)
# ============================================================
دالة تصنيف_عمر(عمر)
    طابق (عمر)
        عندما 0..13:
            ارجع "طفل"
        عندما 13..20:
            ارجع "مراهق"
        افتراضي:
            ارجع "بالغ"
    نهاية
نهاية

اطبع_سطر(تصنيف_عمر(5))
اطبع_سطر(تصنيف_عمر(15))
اطبع_سطر(تصنيف_عمر(30))

# ============================================================
# 2) مطابقة OR patterns
# ============================================================
دالة فحص(ن)
    طابق (ن)
        عندما 0 || 1:
            ارجع "صفر_أو_واحد"
        عندما 100 || 200 || 300:
            ارجع "كبير"
        افتراضي:
            ارجع "وسط"
    نهاية
نهاية

اطبع_سطر("نتيجة:" + فحص(0))
اطبع_سطر("نتيجة:" + فحص(200))
اطبع_سطر("نتيجة:" + فحص(50))

# ============================================================
# 3) مطابقة مع ربط متغير
# ============================================================
دالة استخراج(قيمة)
    طابق (قيمة)
        عندما ن:
            ارجع "قيمة:" + ن
    نهاية
نهاية

اطبع_سطر(استخراج(42))
اطبع_سطر(استخراج(99))
