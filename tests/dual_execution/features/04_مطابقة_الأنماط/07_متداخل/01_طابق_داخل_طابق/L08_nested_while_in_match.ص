# اختبار L08: بينما متداخلة داخل match arm
# هدف: while متداخلة في match arm لبناء مصفوفة ضرب
# المخرج: جدول ضرب 2×2

دالة مصفوفة_ضرب(حجم)
    طابق (حجم)
        عندما "صغير":
            متغير أ = 1
            بينما (أ <= 2)
                متغير ب = 1
                بينما (ب <= 2)
                    اطبع_سطر(نص(أ) + "x" + نص(ب) + "=" + نص(أ * ب))
                    ب = ب + 1
                نهاية
                أ = أ + 1
            نهاية
        افتراضي:
            اطبع_سطر("حجم كبير")
    نهاية
نهاية

مصفوفة_ضرب("صغير")
مصفوفة_ضرب("كبير")
