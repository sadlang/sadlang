# اختبار C04: match داخل إذا
# هدف: match statement داخل شرط إذا/وإلا
# المخرج: 5 رسائل تصنيف

دالة تصنيف(قيمة)
    إذا (قيمة > 0)
        متغير نتيجة = ""
        طابق (قيمة)
            عندما 1..10:
                نتيجة = "صغير موجب"
            عندما 11..100:
                نتيجة = "متوسط"
            افتراضي:
                نتيجة = "كبير"
        نهاية
        اطبع_سطر(نتيجة)
    وإلا
        اطبع_سطر("سالب أو صفر")
    نهاية
نهاية

تصنيف(5)
تصنيف(50)
تصنيف(200)
تصنيف(-3)
تصنيف(0)
