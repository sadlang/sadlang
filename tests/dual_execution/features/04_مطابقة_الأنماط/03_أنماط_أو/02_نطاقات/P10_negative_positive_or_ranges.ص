دالة تصنيف_موسعة(قيمة)
    طابق (قيمة)
        عندما -100..-51 || 51..100:
            ارجع "بعيد عن المركز"
        عندما -50..-1 || 1..50:
            ارجع "قريب من المركز"
        عندما 0:
            ارجع "المركز"
        افتراضي:
            ارجع "خارج النطاق"
    نهاية
