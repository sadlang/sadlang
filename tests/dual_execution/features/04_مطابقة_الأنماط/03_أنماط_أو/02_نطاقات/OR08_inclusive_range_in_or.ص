# @description OR pattern مع نطاقات شاملة: ..= في OR
# @priority P1
# @expected OR08:في
# @expected OR08:في
# @expected OR08:خارج
#
# الهدف: التحقق من أن النطاق الشامل ..= يعمل في OR pattern
# 10 في 0..=10 (شامل) يطابق
# 11 خارج 0..=10 → يقع في 11..=20

دالة تصنيف(ن)
    متغير نتيجة = ""
    طابق (ن)
        عندما 0..=10 || 21..=30:
            نتيجة = "في"
        عندما 11..=20:
            نتيجة = "خارج"
        افتراضي:
            نتيجة = "خارج"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("OR08:" + تصنيف(10))
اطبع_سطر("OR08:" + تصنيف(25))
اطبع_سطر("OR08:" + تصنيف(15))
