# @description OR pattern مع نطاقات سالبة: -10..-1 || 1..10
# @priority P1
# @expected OR06:سالب
# @expected OR06:خارج_الصفر
# @expected OR06:موجب
# @expected OR06:خارج
#
# الهدف: OR pattern يشمل نطاقاً سالباً ونطاقاً موجباً — الصفر في الوسط لا يُطابق

دالة تصنيف(ن)
    متغير نتيجة = ""
    طابق (ن)
        عندما -10..-1 || 1..10:
            طابق (ن)
                عندما -10..-1:
                    نتيجة = "سالب"
                عندما 1..10:
                    نتيجة = "موجب"
            نهاية
        عندما 0:
            نتيجة = "خارج_الصفر"
        افتراضي:
            نتيجة = "خارج"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("OR06:" + تصنيف(-5))
اطبع_سطر("OR06:" + تصنيف(0))
اطبع_سطر("OR06:" + تصنيف(7))
اطبع_سطر("OR06:" + تصنيف(15))
