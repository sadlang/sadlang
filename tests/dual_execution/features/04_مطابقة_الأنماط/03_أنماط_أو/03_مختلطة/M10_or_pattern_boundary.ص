# @description OR pattern مع نطاق: قيم حدية + نطاق للوسط
# @priority P1
# @expected M10:حدي
# @expected M10:داخل
# @expected M10:حدي
# @expected M10:خارج
#
# الهدف: اختبار OR pattern مع نطاق — 0 و 100 تُمسك بـ OR
# 1..100 تُمسك الوسط (1 <= x < 100)
# 100 تُمسك بـ OR (ليس بـ 1..100 الحصري)

دالة تصنيف(ن)
    متغير نوع = ""
    طابق (ن)
        عندما 0 || 100:
            نوع = "حدي"
        عندما 1..100:
            نوع = "داخل"
        افتراضي:
            نوع = "خارج"
    نهاية
    ارجع نوع
نهاية

اطبع_سطر("M10:" + تصنيف(0))
اطبع_سطر("M10:" + تصنيف(50))
اطبع_سطر("M10:" + تصنيف(100))
اطبع_سطر("M10:" + تصنيف(150))
