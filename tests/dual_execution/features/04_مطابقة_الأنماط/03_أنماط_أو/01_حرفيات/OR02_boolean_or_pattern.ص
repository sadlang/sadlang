# @description OR pattern بالبوليان: صحيح || خطأ — كلاهما يطابق النمط
# @priority P1
# @expected OR02:في_OR
# @expected OR02:في_OR
#
# الهدف: اختبار OR pattern مع قيم بوليانية
# صحيح يطابق النمط (صحيح || خطأ)
# خطأ يطابق النمط (صحيح || خطأ)

دالة تصنيف_بول(قيمة)
    متغير نتيجة = ""
    طابق (قيمة)
        عندما صحيح || خطأ:
            نتيجة = "في_OR"
        افتراضي:
            نتيجة = "خارج"
    نهاية
    ارجع نتيجة
نهاية

# صحيح يطابق OR (صحيح || خطأ)
اطبع_سطر("OR02:" + تصنيف_بول(صحيح))
# خطأ يطابق OR (صحيح || خطأ)
اطبع_سطر("OR02:" + تصنيف_بول(خطأ))
