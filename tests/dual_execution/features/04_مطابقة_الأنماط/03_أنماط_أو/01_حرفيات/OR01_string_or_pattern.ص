# @description OR pattern بالنصوص: ثلاثة بدائل نصية
# @priority P1
# @expected OR01:نجح
# @expected OR01:فشل
# @expected OR01:مجهول
#
# الهدف: التحقق من أن OR pattern يعمل مع النصوص

دالة تصنيف_نص(حالة)
    متغير نتيجة = ""
    طابق (حالة)
        عندما "نجح" || "موافق" || "صح":
            نتيجة = "نجح"
        عندما "فشل" || "خطأ" || "رفض":
            نتيجة = "فشل"
        افتراضي:
            نتيجة = "مجهول"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("OR01:" + تصنيف_نص("موافق"))
اطبع_سطر("OR01:" + تصنيف_نص("رفض"))
اطبع_سطر("OR01:" + تصنيف_نص("انتظار"))
