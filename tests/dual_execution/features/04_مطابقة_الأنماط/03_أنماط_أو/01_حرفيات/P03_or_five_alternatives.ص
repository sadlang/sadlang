# اختبار P03: OR مع 5 بدائل أو أكثر (أيام الأسبوع)
# هدف: OR pattern مع عدد كبير من البدائل
# المخرج: 6 رسائل يوم عمل/عطلة

دالة فحص_يوم(يوم)
    طابق (يوم)
        عندما "الاثنين" || "الثلاثاء" || "الأربعاء" || "الخميس" || "الجمعة":
            ارجع "يوم عمل"
        عندما "السبت" || "الأحد":
            ارجع "عطلة"
        افتراضي:
            ارجع "غير معروف"
    نهاية
نهاية

لكل يوم في ["الاثنين"، "الأربعاء"، "الجمعة"، "السبت"، "الأحد"، "غلط"]
    اطبع_سطر(يوم + ": " + فحص_يوم(يوم))
نهاية
