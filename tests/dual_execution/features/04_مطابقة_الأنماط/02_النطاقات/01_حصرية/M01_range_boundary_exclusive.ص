# @description اختبار حدود نطاق حصري: القيمة على الحد العلوي (exclusive end) لا يجب أن تطابق
# @priority P1
# @expected M01:خارج_النطاق
# 
# الهدف: التحقق من أن النطاق 0..13 هو [0, 13) حصري من اليمين
# أي أن 13 يقع في النطاق التالي 13..20 وليس في 0..13

متغير نتيجة = "لا_تطابق"

طابق (13)
    عندما 0..13:
        نتيجة = "في_النطاق_الأول"
    عندما 13..20:
        نتيجة = "خارج_النطاق"
    افتراضي:
        نتيجة = "افتراضي"
نهاية

اطبع_سطر("M01:" + نتيجة)
