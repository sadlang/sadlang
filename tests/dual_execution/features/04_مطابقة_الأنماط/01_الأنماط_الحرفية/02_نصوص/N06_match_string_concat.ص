# اختبار N06: match مع نتيجة مركبة (string concatenation)
# هدف: match يبني رسائل مركبة مختلفة
# المخرج: 4 رسائل مع مقدمة مشتركة

دالة رسالة_حالة(رمز، قيمة)
    متغير مقدمة = "قيمة: " + نص(قيمة) + " > "
    طابق (رمز)
        عندما "OK":
            ارجع مقدمة + "ناجح"
        عندما "ERR":
            ارجع مقدمة + "خطأ"
        عندما "WARN":
            ارجع مقدمة + "تحذير"
        افتراضي:
            ارجع مقدمة + "غير معروف"
    نهاية
نهاية

اطبع_سطر(رسالة_حالة("OK"، 200))
اطبع_سطر(رسالة_حالة("ERR"، 404))
اطبع_سطر(رسالة_حالة("WARN"، 301))
اطبع_سطر(رسالة_حالة("INFO"، 100))
