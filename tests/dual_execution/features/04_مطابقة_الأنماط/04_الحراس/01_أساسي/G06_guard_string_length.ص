# @description guard مع طول النص (متطابق نصي + guard)
# @priority P1
# @expected G06:فارغ:
# @expected G06:قصير:أب
# @expected G06:متوسط:مرحبا
# @expected G06:طويل:مرحبا_بالعالم
#
# الهدف: تطبيق guard على النص — فحص طول النص في شرط الـ guard

دالة تصنيف_نص(نص)
    متغير نتيجة = ""
    طابق (نص)
        عندما ق إذا طول(ق) == 0:
            نتيجة = "فارغ"
        عندما ق إذا طول(ق) <= 3:
            نتيجة = "قصير"
        عندما ق إذا طول(ق) <= 6:
            نتيجة = "متوسط"
        عندما ق:
            نتيجة = "طويل"
    نهاية
    ارجع نتيجة + ":" + نص
نهاية

اطبع_سطر("G06:" + تصنيف_نص(""))
اطبع_سطر("G06:" + تصنيف_نص("أب"))
اطبع_سطر("G06:" + تصنيف_نص("مرحبا"))
اطبع_سطر("G06:" + تصنيف_نص("مرحبا_بالعالم"))
