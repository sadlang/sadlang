# @description guard مع حساب داخل الشرط: ن * 2 و ن % 3
# @priority P1
# @expected G05:زوجي_ومضاعف_3:6
# @expected G05:زوجي_فقط:4
# @expected G05:مضاعف_3_فقط:9
# @expected G05:آخر:7
#
# الهدف: guard يستخدم عمليات حسابية على المتغير المربوط

دالة فحص_رياضي(ن)
    متغير نتيجة = ""
    متغير قيمة = 0
    طابق (ن)
        عندما ق إذا ق % 2 == 0 && ق % 3 == 0:
            نتيجة = "زوجي_ومضاعف_3"
            قيمة = ق
        عندما ق إذا ق % 2 == 0:
            نتيجة = "زوجي_فقط"
            قيمة = ق
        عندما ق إذا ق % 3 == 0:
            نتيجة = "مضاعف_3_فقط"
            قيمة = ق
        عندما ق:
            نتيجة = "آخر"
            قيمة = ق
    نهاية
    ارجع نتيجة + ":" + قيمة
نهاية

اطبع_سطر("G05:" + فحص_رياضي(6))   # زوجي ومضاعف 3
اطبع_سطر("G05:" + فحص_رياضي(4))   # زوجي فقط
اطبع_سطر("G05:" + فحص_رياضي(9))   # مضاعف 3 فقط
اطبع_سطر("G05:" + فحص_رياضي(7))   # لا هذا ولا ذاك
