# @description جميع guards تفشل بدون افتراضي — يجب صمت (المتغير لا يتغير)
# @priority P1
# @expected G02:لم_يتغير
#
# الهدف: عندما تفشل كل guards وليس هناك افتراضي
# المتغير يجب أن يبقى بقيمته الأصلية

متغير نتيجة = "لم_يتغير"

طابق (5)
    عندما ن إذا ن > 10:
        نتيجة = "كبير"
    عندما ن إذا ن < 0:
        نتيجة = "سالب"
    عندما ن إذا ن == 42:
        نتيجة = "حرفي_خاص"
نهاية

# 5 لا يطابق أياً من هذه الشروط — يجب أن يظل "لم_يتغير"
اطبع_سطر("G02:" + نتيجة)
