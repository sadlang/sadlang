# @description اختبار خصائص القناة المتقدمة — سعة وإغلاق وإرسال بدون حجب
# @expected 10\n5\nصحيح\n2\nصحيح
# @priority P2

# قناة بسعة 10
متغير ق = قناة(10)
اطبع_سطر(ق.السعة())

# إرسال 5 عناصر
ق.أرسل(1)
ق.أرسل(2)
ق.أرسل(3)
ق.أرسل(4)
ق.أرسل(5)
اطبع_سطر(ق.الحجم())

# حاول_ارسل
متغير نجح = ق.حاول_ارسل(6)
اطبع_سطر(نجح)

# استقبال عنصرين لإفراغ مكان
ق.استقبل()
ق.استقبل()
ق.استقبل()
ق.استقبل()
اطبع_سطر(ق.الحجم())

# إغلاق القناة
ق.أغلق()
اطبع_سطر(ق.مغلقة())
