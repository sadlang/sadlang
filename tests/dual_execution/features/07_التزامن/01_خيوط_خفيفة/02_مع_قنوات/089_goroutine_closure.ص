# @description اختبار goroutine مع closure — التقاط متغيرات خارجية
# @priority P2

# ============================================================
# goroutine يلتقط متغير خارجي عبر closure
# ============================================================
متغير ق = قناة(3)

دالة اصنع_مرسل(قيمة)
    ارجع لامدا()
        ق.أرسل(قيمة * 5)
    نهاية
نهاية

متغير م1 = اصنع_مرسل(3)
متغير م2 = اصنع_مرسل(5)
متغير م3 = اصنع_مرسل(7)

أطلق م1()
أطلق م2()
أطلق م3()

# جمع النتائج
متغير نتائج = []
لكل ع في [1، 2، 3]
    نتائج.اضف(ق.استقبل())
نهاية
نتائج.رتب()

لكل ن في نتائج
    اطبع_سطر("نتيجة:" + ن)
نهاية
