# @description اختبار النصوص المنسقة (F-strings) المتقدمة — تعبيرات، استدعاءات، تداخل
# @expected مرحبا أحمد!\n2 + 3 = 5\nالمساحة = 20\nنتيجة: 120\nالعمر: 25 سنة
# @priority P2

# ============================================================
# 1. f-string أساسي
# ============================================================
متغير اسم = "أحمد"
اطبع_سطر(م"مرحبا {اسم}!")

# ============================================================
# 2. تعبير حسابي في f-string
# ============================================================
اطبع_سطر(م"2 + 3 = {2 + 3}")

# ============================================================
# 3. متغيرات متعددة
# ============================================================
متغير طول = 4
متغير عرض = 5
اطبع_سطر(م"المساحة = {طول * عرض}")

# ============================================================
# 4. استدعاء دالة في f-string
# ============================================================
دالة عاملي(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * عاملي(ن - 1)
نهاية
اطبع_سطر(م"نتيجة: {عاملي(5)}")

# ============================================================
# 5. f-string مع مزج نص وتعبير
# ============================================================
متغير عمر = 25
اطبع_سطر(م"العمر: {عمر} سنة")
