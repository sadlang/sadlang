# @description اختبار الماكروز متغيرة المعاملات (...) والنسخ للخلف
# @expected كل:أ\nكل:ب\nكل:ج\nمستوى:[تحذير] خطأ 1\nمستوى:[تحذير] خطأ 2\nمستوى:[معلومات] بدء\nجمع:6\nجمع:15\nنسخ:20
# @priority P2
# @skip_compiler الماكروز غير مدعومة في المترجم

# ============================================================
# 1. ماكرو بمعاملات متغيرة (...) — طباعة الكل
# ============================================================
ماكرو سجّل_الكل(...رسائل)
    لكل ر في رسائل
        اطبع_سطر("كل:" + ر)
    نهاية
نهاية

سجّل_الكل!("أ"، "ب"، "ج")

# ============================================================
# 2. معاملات مطلوبة + متغيرة
# ============================================================
ماكرو سجّل_بمستوى(مستوى، ...رسائل)
    لكل ر في رسائل
        اطبع_سطر("مستوى:[" + مستوى + "] " + ر)
    نهاية
نهاية

سجّل_بمستوى!("تحذير"، "خطأ 1"، "خطأ 2")
سجّل_بمستوى!("معلومات"، "بدء")

# ============================================================
# 3. ماكرو متغير يُرجع قيمة — جمع الكل
# ============================================================
ماكرو جمع_الكل(...أرقام)
    متغير المجموع = 0
    لكل ن في أرقام
        المجموع = المجموع + ن
    نهاية
    ارجع المجموع
نهاية

اطبع_سطر("جمع:" + جمع_الكل!(1، 2، 3))
اطبع_سطر("جمع:" + جمع_الكل!(1، 2، 3، 4، 5))

# ============================================================
# 4. النسخ للخلف (Copy-Back) — تعديل متغير خارجي
# ============================================================
ماكرو ضاعف(ن)
    ن = ن * 2
نهاية

متغير س = 10
ضاعف!(س)
اطبع_سطر("نسخ:" + س)
