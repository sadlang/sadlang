# @description اختبار المولدات (Generators) — أنتج، مولد دالة، تكرار عبر القيم المنتجة
# @expected عداد:1\nعداد:2\nعداد:3\nزوجي:2\nزوجي:4\nزوجي:6\nفيب:1\nفيب:1\nفيب:2\nفيب:3\nفيب:5\nنطاق:10\nنطاق:15\nنطاق:20\nنطاق:25
# @priority P2
# @skip_compiler المولدات غير مدعومة في المترجم

# ============================================================
# 1. مولد بسيط — عداد
# ============================================================
مولد دالة عداد(حد)
    متغير ن = 1
    بينما (ن <= حد)
        أنتج ن
        ن = ن + 1
    نهاية
نهاية

متغير أرقام = عداد(3)
لكل ر في أرقام
    اطبع_سطر("عداد:" + ر)
نهاية

# ============================================================
# 2. مولد الأعداد الزوجية
# ============================================================
مولد دالة زوجيات(حد)
    متغير ن = 2
    بينما (ن <= حد)
        أنتج ن
        ن = ن + 2
    نهاية
نهاية

لكل ز في زوجيات(6)
    اطبع_سطر("زوجي:" + ز)
نهاية

# ============================================================
# 3. مولد فيبوناتشي
# ============================================================
مولد دالة فيبوناتشي(عدد)
    متغير أ = 0
    متغير ب = 1
    متغير ع = 0
    بينما (ع < عدد)
        أنتج ب
        متغير مؤقت = أ + ب
        أ = ب
        ب = مؤقت
        ع = ع + 1
    نهاية
نهاية

لكل ف في فيبوناتشي(5)
    اطبع_سطر("فيب:" + ف)
نهاية

# ============================================================
# 4. مولد بمعاملات — نطاق مخصص
# ============================================================
مولد دالة نطاق_مخصص(بداية، نهاية_ق، خطوة)
    متغير ن = بداية
    بينما (ن <= نهاية_ق)
        أنتج ن
        ن = ن + خطوة
    نهاية
نهاية

لكل ق في نطاق_مخصص(10، 25، 5)
    اطبع_سطر("نطاق:" + ق)
نهاية
