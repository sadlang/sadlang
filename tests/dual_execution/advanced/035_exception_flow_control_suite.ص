# @description Exception Flow Control Suite (25 tests) — nested defer, stack flow, cleanup verification
# @priority P2
# @timeout 60
# @expected E01:PASS\nE02:PASS\nE03:PASS\nE04:PASS\nE05:PASS\nE06:PASS\nE07:PASS\nE08:PASS\nE09:PASS\nE10:PASS\nE11:PASS\nE12:PASS\nE13:PASS\nE14:PASS\nE15:PASS\nE16:PASS\nE17:PASS\nE18:PASS\nE19:PASS\nE20:PASS\nE21:PASS\nE22:PASS\nE23:PASS\nE24:PASS\nE25:PASS\nSUMMARY:25/25

متغير نجاح = 0
متغير مسار = ""
متغير موارد = 0

دالة أضف_مسار(رمز)
    مسار = مسار + رمز + "|"
نهاية

دالة صفّر_مسار()
    مسار = ""
نهاية

دالة سجّل(اسم، شرط)
    إذا (شرط)
        اطبع_سطر(اسم + ":PASS")
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر(اسم + ":FAIL")
    نهاية
نهاية

دالة احجز()
    موارد = موارد + 1
نهاية

دالة حرر()
    موارد = موارد - 1
نهاية

# E01: defer LIFO في المسار الطبيعي
دالة حالة_1()
    أجّل أضف_مسار("A1")
    أجّل أضف_مسار("A2")
    أضف_مسار("A0")
نهاية

صفّر_مسار()
حالة_1()
سجّل("E01", مسار == "A0|A2|A1|")

# E02: try/catch أساسي
متغير التقط2 = خطأ
حاول
    ارمي "B_ERR"
امسك خ
    التقط2 = صحيح
نهاية
سجّل("E02", التقط2 == صحيح)

# E03: nested try/catch — الداخلي لا يجب أن يسرق الخارجي
صفّر_مسار()
حاول
    أضف_مسار("C0")
    حاول
        أضف_مسار("C1")
        ارمي "C_INNER"
    امسك خ
        أضف_مسار("C2")
    نهاية
    أضف_مسار("C3")
امسك خ
    أضف_مسار("C4")
نهاية
سجّل("E03", مسار == "C0|C1|C2|C3|")

# E04: finally ينفّذ مع وجود استثناء
صفّر_مسار()
حاول
    أضف_مسار("D_TRY")
    ارمي "D_ERR"
امسك خ
    أضف_مسار("D_CATCH")
أخيراً
    أضف_مسار("D_FIN")
نهاية
سجّل("E04", مسار == "D_TRY|D_CATCH|D_FIN|")

# E05: finally ينفّذ بدون استثناء
صفّر_مسار()
حاول
    أضف_مسار("E_TRY")
امسك خ
    أضف_مسار("E_CATCH")
أخيراً
    أضف_مسار("E_FIN")
نهاية
سجّل("E05", مسار == "E_TRY|E_FIN|")

# E06: defer مع return مبكر
دالة حالة_6()
    صفّر_مسار()
    أجّل أضف_مسار("F_DEF")
    أضف_مسار("F_BODY")
    ارجع 6
نهاية

متغير ن6 = حالة_6()
سجّل("E06", (ن6 == 6) و (مسار == "F_BODY|F_DEF|"))

# E07: cleanup طبيعي لمورد واحد
موارد = 0
دالة حالة_7()
    احجز()
    أجّل حرر()
نهاية
حالة_7()
سجّل("E07", موارد == 0)

# E08: cleanup مع استثناء داخل نفس الدالة (مع امسك داخلي)
موارد = 0
دالة حالة_8()
    احجز()
    أجّل حرر()
    حاول
        ارمي "G_ERR"
    امسك خ
    نهاية
نهاية
حالة_8()
سجّل("E08", موارد == 0)

# E09: cleanup متعدد الموارد
موارد = 0
دالة حالة_9()
    احجز()
    أجّل حرر()
    احجز()
    أجّل حرر()
    احجز()
    أجّل حرر()
نهاية
حالة_9()
سجّل("E09", موارد == 0)

# E10: LIFO بثلاثة defer
صفّر_مسار()
دالة حالة_10()
    أجّل أضف_مسار("H1")
    أجّل أضف_مسار("H2")
    أجّل أضف_مسار("H3")
    أضف_مسار("H0")
نهاية
حالة_10()
سجّل("E10", مسار == "H0|H3|H2|H1|")

# E11: try/catch في دالة + قيمة إرجاع fallback
دالة قسمة_آمنة(أ، ب)
    حاول
        إذا (ب == 0)
            ارمي "ZERO"
        نهاية
        ارجع أ / ب
    امسك خ
        ارجع -1
    نهاية
نهاية

متغير ن11a = قسمة_آمنة(10، 2)
متغير ن11b = قسمة_آمنة(10، 0)
سجّل("E11", (ن11a == 5) و (ن11b == -1))

# E12: finally بعد nested catch
صفّر_مسار()
حاول
    حاول
        ارمي "I_ERR"
    امسك خ
        أضف_مسار("I_INNER")
    نهاية
أخيراً
    أضف_مسار("I_FIN")
نهاية
سجّل("E12", مسار == "I_INNER|I_FIN|")

# E13: defer داخل try/catch (بدون عبور خطر)
صفّر_مسار()
دالة حالة_13()
    حاول
        أجّل أضف_مسار("J_DEF")
        أضف_مسار("J_TRY")
    امسك خ
        أضف_مسار("J_CATCH")
    نهاية
نهاية
حالة_13()
سجّل("E13", مسار == "J_TRY|J_DEF|")

# E14: لا تسريب موارد بعد مسارات مختلفة
موارد = 0
دالة حالة_14(يرمي)
    احجز()
    أجّل حرر()
    إذا (يرمي)
        حاول
            ارمي "K_ERR"
        امسك خ
        نهاية
    نهاية
نهاية

حالة_14(خطأ)
حالة_14(صحيح)
سجّل("E14", موارد == 0)

# E15: invariant نهائي
سجّل("E15", نجاح == 14)

# E16: nested finally order (داخلي ثم خارجي)
صفّر_مسار()
حاول
    أضف_مسار("L0")
    حاول
        ارمي "L_ERR"
    امسك خ
        أضف_مسار("L1")
    أخيراً
        أضف_مسار("L2")
    نهاية
أخيراً
    أضف_مسار("L3")
نهاية
سجّل("E16", مسار == "L0|L1|L2|L3|")

# E17: خطأ داخلي يُحوّل لخطأ خارجي
صفّر_مسار()
حاول
    حاول
        ارمي "M1"
    امسك خ
        أضف_مسار("M_INNER")
        ارمي "M2"
    نهاية
امسك خ2
    أضف_مسار("M_OUTER")
نهاية
سجّل("E17", مسار == "M_INNER|M_OUTER|")

# E18: defer مع return فرعي (if/else)
دالة حالة_18(ن)
    صفّر_مسار()
    أجّل أضف_مسار("N_DEF")
    إذا (ن > 0)
        أضف_مسار("N_POS")
        ارجع 1
    وإلا
        أضف_مسار("N_NEG")
        ارجع -1
    نهاية
نهاية

متغير ن18a = حالة_18(1)
سجّل("E18", (ن18a == 1) و (مسار == "N_POS|N_DEF|"))

# E19: cleanup داخل حلقة عبر دالة موارد
موارد = 0
دالة حالة_19()
    احجز()
    أجّل حرر()
نهاية

لكل i في 1..20
    حالة_19()
نهاية
سجّل("E19", موارد == 0)

# E20: التحقق من المرور عبر catch
متغير علم20 = 0
حاول
    ارمي "O_ERR"
امسك خ
    علم20 = 1
نهاية
سجّل("E20", علم20 == 1)

# E21: cleanup هرمي (outer + inner)
موارد = 0
دالة حالة_21_داخلية()
    احجز()
    أجّل حرر()
نهاية

دالة حالة_21_خارجية()
    احجز()
    أجّل حرر()
    حالة_21_داخلية()
نهاية

حالة_21_خارجية()
سجّل("E21", موارد == 0)

# E22: cleanup هرمي مع استثناء من الدالة الداخلية
موارد = 0
دالة حالة_22_داخلية()
    احجز()
    أجّل حرر()
    ارمي "P_ERR"
نهاية

دالة حالة_22_خارجية()
    احجز()
    أجّل حرر()
    حاول
        حالة_22_داخلية()
    امسك خ
    نهاية
نهاية

حالة_22_خارجية()
سجّل("E22", موارد == 0)

# E23: try/catch/finally بدون استثناء
صفّر_مسار()
حاول
    أضف_مسار("Q_TRY")
امسك خ
    أضف_مسار("Q_CATCH")
أخيراً
    أضف_مسار("Q_FIN")
نهاية
سجّل("E23", مسار == "Q_TRY|Q_FIN|")

# E24: try/catch/finally مع استثناء
صفّر_مسار()
حاول
    أضف_مسار("R_TRY")
    ارمي "R_ERR"
امسك خ
    أضف_مسار("R_CATCH")
أخيراً
    أضف_مسار("R_FIN")
نهاية
سجّل("E24", مسار == "R_TRY|R_CATCH|R_FIN|")

# E25: invariant النهائي بعد التوسعة
سجّل("E25", نجاح == 24)

اطبع_سطر("SUMMARY:" + نجاح + "/25")
