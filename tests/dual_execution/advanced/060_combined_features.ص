# @description اختبار تركيبي — OOP + إغلاقات + مطابقة أنماط + وراثة + دوال مرتبة عليا
# @expected مياو\nهاو\n...\n1\nبسبس\nمجموع:15\nعاملة:3\nالأقصى:50\nفيزياء:90\nكيمياء:80\nالمعدل:85
# @priority P1
# @skip_compiler ميزات مركبة غير مدعومة بالكامل في المترجم

# ============================================================
# 1) صنف + مطابقة أنماط + لامدا مع خريطة/رشح
# ============================================================
صنف حيوان
    متغير عام اسم
    متغير عام نوع_حيوان
    باني(اسم، نوع_حيوان)
        هذا.اسم = اسم
        هذا.نوع_حيوان = نوع_حيوان
    نهاية
    دالة عام صوت()
        طابق (هذا.نوع_حيوان)
            عندما "قطة":
                ارجع "مياو"
            عندما "كلب":
                ارجع "هاو"
            افتراضي:
                ارجع "..."
        نهاية
    نهاية
نهاية

متغير حيوانات = [جديد حيوان("بسبس"، "قطة")، جديد حيوان("ريكس"، "كلب")، جديد حيوان("فيفي"، "طائر")]

# خريطة: استدعاء دالة كائن عبر لامدا
متغير أصوات = حيوانات.خريطة(لامدا(ح) ارجع ح.صوت() نهاية)
لكل ص في أصوات
    اطبع_سطر(ص)
نهاية

# رشح: filter كائنات بلامدا
متغير قطط = حيوانات.رشح(لامدا(ح) ارجع ح.نوع_حيوان == "قطة" نهاية)
اطبع_سطر(قطط.الطول())
اطبع_سطر(قطط[0].اسم)

# ============================================================
# 2) إغلاقات + اختزال + دوال مرتبة عليا
# ============================================================
دالة إنشاء_جامع()
    متغير مجموع = 0
    دالة أضف(ن)
        مجموع = مجموع + ن
        ارجع مجموع
    نهاية
    ارجع أضف
نهاية

متغير جامع = إنشاء_جامع()
لكل ن في [1، 2، 3، 4، 5]
    جامع(ن)
نهاية
اطبع_سطر("مجموع:" + جامع(0))

# ============================================================
# 3) دالة مرتبة عليا + مطابقة أنماط
# ============================================================
دالة عدّاد_شرطي(مصفوفة، شرط)
    متغير عدد = 0
    لكل عنصر في مصفوفة
        إذا (شرط(عنصر))
            عدد = عدد + 1
        نهاية
    نهاية
    ارجع عدد
نهاية

متغير أعمار = [15، 22، 8، 30، 45، 12، 50]
متغير عاملة = عدّاد_شرطي(أعمار، لامدا(ع) ارجع ع >= 18 و ع <= 45 نهاية)
اطبع_سطر("عاملة:" + عاملة)

# اختزال: أكبر قيمة
متغير الأقصى = أعمار.اختزل(لامدا(أ، ب)
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية، 0)
اطبع_سطر("الأقصى:" + الأقصى)

# ============================================================
# 4) وراثة + دوال ديناميكية
# ============================================================
صنف مادة
    متغير عام اسم_مادة
    متغير عام درجة
    باني(اسم_مادة، درجة)
        هذا.اسم_مادة = اسم_مادة
        هذا.درجة = درجة
    نهاية
    دالة عام وصف()
        ارجع هذا.اسم_مادة + ":" + هذا.درجة
    نهاية
نهاية

متغير مواد = [جديد مادة("فيزياء"، 90)، جديد مادة("كيمياء"، 80)]
لكل م في مواد
    اطبع_سطر(م.وصف())
نهاية

# حساب المعدل بدمج OOP + اختزال
متغير مجموع_درجات = مواد.اختزل(لامدا(مج، م) ارجع مج + م.درجة نهاية، 0)
متغير معدل = مجموع_درجات / مواد.الطول()
اطبع_سطر("المعدل:" + رقم(معدل))
