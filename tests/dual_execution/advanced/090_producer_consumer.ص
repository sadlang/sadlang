# @description اختبار producer-consumer عبر قناة مع عدة منتجين
# @priority P2

# ============================================================
# عدة goroutines ترسل أرقاماً + مستهلك يجمعها
# ============================================================
متغير ق = قناة(10)

لكل ر في [1، 2، 3، 4، 5]
    أطلق ق.أرسل(ر)
نهاية

انتظر_الكل()

متغير مجموع = 0
بينما (ليس ق.فارغة())
    مجموع = مجموع + ق.استقبل()
نهاية

اطبع_سطر("مجموع:" + مجموع)
