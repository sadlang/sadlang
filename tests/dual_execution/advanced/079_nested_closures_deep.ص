# @description اختبار إغلاقات متداخلة بعمق — 3 مستويات مع التقاط متغيرات وتعديلها
# @expected عداد:1\nعداد:2\nعداد:3\nمضاعف:6\nمضاعف:12\nمجموع:12
# @priority P2

# ============================================================
# 1) إغلاق ثلاثي المستويات — كل مستوى يلتقط من الأعلى
# ============================================================
دالة منشئ_عداد(بداية)
    متغير عداد = بداية
    دالة زد_واحد()
        عداد = عداد + 1
        ارجع عداد
    نهاية
    ارجع زد_واحد
نهاية

متغير ع = منشئ_عداد(0)
اطبع_سطر("عداد:" + ع())
اطبع_سطر("عداد:" + ع())
اطبع_سطر("عداد:" + ع())

# ============================================================
# 2) إغلاق يلتقط إغلاق آخر
# ============================================================
دالة منشئ_مضاعف(معامل)
    دالة ضاعف(ن)
        ارجع ن * معامل
    نهاية
    ارجع ضاعف
نهاية

متغير ضعف = منشئ_مضاعف(3)
اطبع_سطر("مضاعف:" + ضعف(2))
اطبع_سطر("مضاعف:" + ضعف(4))

# ============================================================
# 3) إغلاق مع اختزال — تركيب دوال مرتبة عليا
# ============================================================
متغير أرقام = [1، 2، 3، 4، 5، 6]
متغير مجموع_زوجي = أرقام.رشح(لامدا(ن) ارجع ن % 2 == 0 نهاية).اختزل(لامدا(مج، ن) ارجع مج + ن نهاية، 0)
اطبع_سطر("مجموع:" + مجموع_زوجي)
