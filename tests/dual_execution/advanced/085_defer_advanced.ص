# @description اختبار defer متعدد + defer مع try/catch + ترتيب LIFO
# @expected عمل\n3\n2\n1\nبداية\nخطأ:فشل\nأخيراً\nتنظيف\nتنظيف_خطأ
# @priority P2

# ============================================================
# 1) defer متعدد — ترتيب LIFO
# ============================================================
دالة اختبار_ترتيب()
    أجّل اطبع_سطر("1")
    أجّل اطبع_سطر("2")
    أجّل اطبع_سطر("3")
    اطبع_سطر("عمل")
نهاية
اختبار_ترتيب()

# ============================================================
# 2) defer مع try/catch
# ============================================================
دالة اختبار_استثناء()
    أجّل اطبع_سطر("تنظيف")
    اطبع_سطر("بداية")
    حاول
        ارمي "فشل"
    امسك خطأ
        اطبع_سطر("خطأ:" + خطأ)
    أخيراً
        اطبع_سطر("أخيراً")
    نهاية
نهاية
اختبار_استثناء()

# ============================================================
# 3) defer كتلة
# ============================================================
دالة اختبار_كتلة()
    أجّل اطبع_سطر("تنظيف_خطأ")
نهاية
اختبار_كتلة()
