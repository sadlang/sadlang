# @description اختبار مركب عالي الكثافة: defer + try/catch/finally + return + rethrow + resource cleanup
# @priority P2
# @skip_compiler
# @timeout 30
# @expected C01:PASS\nC02:PASS\nC04:PASS\nC05:PASS\nC07:PASS\nC08:PASS\nC09:PASS\nC10:PASS\nC03:PASS\nC06:PASS\nSUMMARY:10/10

متغير نجاح = 0

دالة سجّل(اسم، شرط)
    إذا (شرط)
        اطبع_سطر(اسم + ":PASS")
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر(اسم + ":FAIL")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# C01: defer + return — defer يُنفذ حتى مع return مبكر
# ─────────────────────────────────────────────────────────────────────────────
متغير مسار1 = ""
دالة عمل1()
    أجّل
        مسار1 = مسار1 + "D"
    نهاية
    مسار1 = مسار1 + "A"
    ارجع 42
    مسار1 = مسار1 + "B"
نهاية
متغير ن1 = عمل1()
سجّل("C01"، ن1 == 42 و مسار1 == "AD")

# ─────────────────────────────────────────────────────────────────────────────
# C02: أجّل متعدد + exception — ترتيب LIFO مع التعافي
# ─────────────────────────────────────────────────────────────────────────────
متغير مسار2 = ""
دالة عمل2()
    أجّل
        مسار2 = مسار2 + "3"
    نهاية
    أجّل
        مسار2 = مسار2 + "2"
    نهاية
    أجّل
        مسار2 = مسار2 + "1"
    نهاية
    حاول
        ارمي "خطأ2"
    امسك خ
        مسار2 = مسار2 + "C"
    نهاية
نهاية
عمل2()
سجّل("C02"، مسار2 == "C123")

# ─────────────────────────────────────────────────────────────────────────────
# C04: defer + finally — كلاهما يعمل
# ─────────────────────────────────────────────────────────────────────────────
متغير مسار4 = ""
دالة عمل4()
    أجّل
        مسار4 = مسار4 + "D"
    نهاية
    حاول
        مسار4 = مسار4 + "T"
    أخيراً
        مسار4 = مسار4 + "F"
    نهاية
    مسار4 = مسار4 + "E"
نهاية
عمل4()
سجّل("C04"، مسار4 == "TFED")

# ─────────────────────────────────────────────────────────────────────────────
# C05: resource cleanup invariant — موارد تُحجز وتُحرر حتى مع exception
# ─────────────────────────────────────────────────────────────────────────────
متغير موارد5 = 0
دالة احجز5()
    موارد5 = موارد5 + 1
نهاية
دالة حرر5()
    موارد5 = موارد5 - 1
نهاية
دالة عمل5()
    احجز5()
    أجّل حرر5()
    احجز5()
    أجّل حرر5()
    حاول
        احجز5()
        ارمي "خطأ5"
    امسك خ5
        حرر5()
    نهاية
نهاية
عمل5()
سجّل("C05"، موارد5 == 0)

# ─────────────────────────────────────────────────────────────────────────────
# C07: while مع defer + return مبكر — يجب أن يُنظف
# ─────────────────────────────────────────────────────────────────────────────
متغير عداد7 = 0
متغير تنظيف7 = 0
دالة حلقة7()
    أجّل
        تنظيف7 = تنظيف7 + 1
    نهاية
    بينما (عداد7 < 5)
        عداد7 = عداد7 + 1
        إذا (عداد7 == 3)
            ارجع عداد7
        نهاية
    نهاية
    ارجع عداد7
نهاية
متغير ن7 = حلقة7()
سجّل("C07"، ن7 == 3 و تنظيف7 == 1)

# ─────────────────────────────────────────────────────────────────────────────
# C08: مصفوفة + لكل + defer — ترتيب عمليات صحيح
# ─────────────────────────────────────────────────────────────────────────────
متغير مجموع8 = 0
دالة عمل8()
    أجّل
        مجموع8 = مجموع8 * 10
    نهاية
    متغير م = [1، 2، 3، 4، 5]
    لكل ع في م
        مجموع8 = مجموع8 + ع
    نهاية
نهاية
عمل8()
سجّل("C08"، مجموع8 == 150)

# ─────────────────────────────────────────────────────────────────────────────
# C09: catch ثم finally ثم defer — ترتيب التنفيذ الكامل
# ─────────────────────────────────────────────────────────────────────────────
متغير مسار9 = ""
دالة عمل9()
    أجّل
        مسار9 = مسار9 + "D"
    نهاية
    حاول
        ارمي "خ9"
    امسك خ9
        مسار9 = مسار9 + "C"
    أخيراً
        مسار9 = مسار9 + "F"
    نهاية
نهاية
عمل9()
سجّل("C09"، مسار9 == "CFD")

# ─────────────────────────────────────────────────────────────────────────────
# C10: سلسلة استدعاءات مع defer في كل مستوى
# ─────────────────────────────────────────────────────────────────────────────
متغير مسار10 = ""
دالة مستوى_أ()
    أجّل
        مسار10 = مسار10 + "1"
    نهاية
    مسار10 = مسار10 + "A"
    مستوى_ب()
    مسار10 = مسار10 + "B"
نهاية
دالة مستوى_ب()
    أجّل
        مسار10 = مسار10 + "2"
    نهاية
    مسار10 = مسار10 + "C"
    مستوى_ج()
    مسار10 = مسار10 + "D"
نهاية
دالة مستوى_ج()
    أجّل
        مسار10 = مسار10 + "3"
    نهاية
    مسار10 = مسار10 + "E"
نهاية
مستوى_أ()
سجّل("C10"، مسار10 == "ACE3D2B1")

# ═════════════════════════════════════════════════════════════════════════════
# اختبارات rethrow — توضع في النهاية لأن rethrow من catch يترك 
# حالة في مدير الاستثناءات تؤثر على أي try/defer تالٍ في نفس الملف.
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# C03: try/catch متداخل 3 مستويات — مع rethrow من كل catch
# ─────────────────────────────────────────────────────────────────────────────
دالة اختبار_ج03()
    متغير م = ""
    حاول
        حاول
            حاول
                م = م + "A"
                ارمي "مستوى3"
            امسك خ3
                م = م + "B"
                ارمي "مستوى2"
            نهاية
        امسك خ2
            م = م + "D"
            ارمي "مستوى1"
        نهاية
    امسك خ1
        م = م + "F"
    نهاية
    ارجع م
نهاية
سجّل("C03"، اختبار_ج03() == "ABDF")

# ─────────────────────────────────────────────────────────────────────────────
# C06: rethrow — إعادة رمي exception من catch (ملفوف في دالة)
# ─────────────────────────────────────────────────────────────────────────────
دالة اختبار_ج06()
    متغير م = ""
    حاول
        حاول
            ارمي "أصلي"
        امسك خ6أ
            م = م + "A"
            ارمي خ6أ
        نهاية
    امسك خ6ب
        م = م + "B:" + خ6ب
    نهاية
    ارجع م
نهاية
سجّل("C06"، اختبار_ج06() == "AB:أصلي")

اطبع_سطر("SUMMARY:" + نجاح + "/10")
