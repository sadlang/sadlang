##
# X01: طابق على نصوص + OR pattern للنصوص
# سيناريو: تصنيف الألوان حسب الاسم
##

دالة تصنيف_لون(لون)
    طابق (لون)
        عندما "أحمر" || "برتقالي" || "أصفر":
            ارجع "دافئ"
        عندما "أخضر" || "أزرق" || "بنفسجي":
            ارجع "بارد"
        عندما "أبيض" || "أسود" || "رمادي":
            ارجع "محايد"
        افتراضي:
            ارجع "غير معروف"
    نهاية
نهاية

اطبع_سطر(تصنيف_لون("أحمر"))
اطبع_سطر(تصنيف_لون("برتقالي"))
اطبع_سطر(تصنيف_لون("أزرق"))
اطبع_سطر(تصنيف_لون("أبيض"))
اطبع_سطر(تصنيف_لون("وردي"))

##
# طابق على نصوص مع guard
##
دالة تحليل_نص(ن)
    طابق (ن)
        عندما "مرحبا" إذا طول(ن) < 10:
            اطبع_سطر("تحية قصيرة")
        عندما "مرحبا":
            اطبع_سطر("تحية طويلة")
        عندما "":
            اطبع_سطر("نص فارغ")
        افتراضي:
            اطبع_سطر("نص: " + ن)
    نهاية
نهاية

تحليل_نص("مرحبا")
تحليل_نص("")
تحليل_نص("أهلاً")
