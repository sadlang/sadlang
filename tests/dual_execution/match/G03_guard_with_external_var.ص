# @description guard يستخدم متغير خارجي + المتغير المربوط معاً
# @priority P1
# @expected G03:في_النطاق
# @expected G03:خارج_النطاق_الديناميكي
#
# الهدف: guard يقارن المتغير المربوط بمتغير خارجي ديناميكي
# متغير "حد" يتغير بين الاستدعاءين

دالة فحص(ق، حد)
    متغير نتيجة = ""
    طابق (ق)
        عندما ن إذا ن < حد:
            نتيجة = "في_النطاق"
        عندما ن:
            نتيجة = "خارج_النطاق_الديناميكي"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("G03:" + فحص(30, 50))   # 30 < 50 → في_النطاق
اطبع_سطر("G03:" + فحص(60, 50))   # 60 >= 50 → خارج_النطاق_الديناميكي
