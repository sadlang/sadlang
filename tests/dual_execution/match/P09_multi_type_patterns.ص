# اختبار P09: match على قيم متعددة الأنواع — كل نوع في دالة منفصلة
# هدف: match يتعامل مع null، bool، integer، string في دوال منفصلة
# المخرج: 7 رسائل تعريف

# فحص قيمة null
دالة فحص_لاشيء(قيمة)
    طابق (قيمة)
        عندما لاشيء:
            ارجع "لا قيمة"
        افتراضي:
            ارجع "قيمة أخرى"
    نهاية
نهاية

# فحص قيم منطقية
دالة فحص_منطقي(قيمة)
    طابق (قيمة)
        عندما صحيح:
            ارجع "قيمة صحيحة"
        عندما خطأ:
            ارجع "قيمة خاطئة"
        افتراضي:
            ارجع "غير معروف"
    نهاية
نهاية

# فحص قيم رقمية
دالة فحص_رقم(قيمة)
    طابق (قيمة)
        عندما 0:
            ارجع "صفر"
        افتراضي:
            ارجع "قيمة أخرى"
    نهاية
نهاية

# فحص قيم نصية
دالة فحص_نص(قيمة)
    طابق (قيمة)
        عندما "":
            ارجع "نص فارغ"
        افتراضي:
            ارجع "قيمة أخرى"
    نهاية
نهاية

اطبع_سطر(فحص_لاشيء(لاشيء))
اطبع_سطر(فحص_منطقي(صحيح))
اطبع_سطر(فحص_منطقي(خطأ))
اطبع_سطر(فحص_رقم(0))
اطبع_سطر(فحص_نص(""))
اطبع_سطر(فحص_رقم(42))
اطبع_سطر(فحص_نص("مرحبا"))
