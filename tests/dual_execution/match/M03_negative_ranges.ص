# @description اختبار نطاقات سالبة: التحقق من أن -5 في النطاق -10..0 و 0 ليس فيه
# @priority P1
# @expected M03:سالب:صفر_موجب
#
# الهدف: التحقق من دعم النطاقات السالبة بشكل صحيح
# -10..0 تعني -10 <= x < 0 — لذا 0 لا يطابق

متغير نتيجة1 = "خطأ"
متغير نتيجة2 = "خطأ"

طابق (-5)
    عندما -10..0:
        نتيجة1 = "سالب"
    عندما 0..10:
        نتيجة1 = "صفر_موجب"
    افتراضي:
        نتيجة1 = "خارج"
نهاية

طابق (0)
    عندما -10..0:
        نتيجة2 = "سالب"
    عندما 0..10:
        نتيجة2 = "صفر_موجب"
    افتراضي:
        نتيجة2 = "خارج"
نهاية

اطبع_سطر("M03:" + نتيجة1 + ":" + نتيجة2)
