# @description النطاقات المتداخلة — الأول يفوز دائماً (first match wins)
# @priority P1
# @expected M07:نطاق_أول
#
# الهدف: التحقق من أن القيمة 5 تطابق النطاق الأول فقط
# حتى لو كانت تنتمي للنطاقين 0..10 و 5..15

متغير نتيجة = ""

طابق (5)
    عندما 0..10:
        نتيجة = "نطاق_أول"
    عندما 5..15:
        نتيجة = "نطاق_ثاني"
    افتراضي:
        نتيجة = "خارج"
نهاية

اطبع_سطر("M07:" + نتيجة)
