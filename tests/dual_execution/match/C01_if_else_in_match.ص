# اختبار C01: إذا/وإلا داخل match arm
# هدف: شرط if/else داخل جسم حالة match
# المخرج: تصنيفات متداخلة

دالة تقييم(نوع، قيمة)
    طابق (نوع)
        عندما "رقم":
            إذا (قيمة > 100)
                اطبع_سطر("كبير جداً")
            وإلا إذا (قيمة > 50)
                اطبع_سطر("كبير")
            وإلا
                اطبع_سطر("صغير")
            نهاية
        عندما "نص":
            إذا (قيمة > 5)
                اطبع_سطر("نص طويل")
            وإلا
                اطبع_سطر("نص قصير")
            نهاية
        افتراضي:
            اطبع_سطر("غير معروف")
    نهاية
نهاية

تقييم("رقم"، 150)
تقييم("رقم"، 75)
تقييم("رقم"، 25)
تقييم("نص"، 10)
تقييم("نص"، 3)
تقييم("آخر"، 0)
