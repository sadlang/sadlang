##
# X06: طابق + متغير مربوط + حسابات معقدة على المتغير المربوط
# سيناريو: تطبيق قواعد ضريبية
##

دالة احسب_ضريبة(دخل)
    طابق (دخل)
        عندما د إذا د < 0:
            ارجع "دخل سالب غير صالح"
        عندما د إذا د == 0:
            ارجع "لا ضريبة"
        عندما د إذا د <= 5000:
            متغير ضريبة = د * 5 / 100
            ارجع "ضريبة 5%: " + ضريبة
        عندما د إذا د <= 20000:
            متغير ضريبة = 250 + (د - 5000) * 10 / 100
            ارجع "ضريبة 10%: " + ضريبة
        عندما د إذا د <= 50000:
            متغير ضريبة = 1750 + (د - 20000) * 15 / 100
            ارجع "ضريبة 15%: " + ضريبة
        افتراضي:
            متغير ضريبة = 6250 + (دخل - 50000) * 20 / 100
            ارجع "ضريبة 20%: " + ضريبة
    نهاية
نهاية

اطبع_سطر(احسب_ضريبة(-100))
اطبع_سطر(احسب_ضريبة(0))
اطبع_سطر(احسب_ضريبة(3000))
اطبع_سطر(احسب_ضريبة(10000))
