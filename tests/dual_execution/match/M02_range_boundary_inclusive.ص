# @description اختبار نطاق شامل: القيمة على الحد العلوي (inclusive end) يجب أن تطابق
# @priority P1
# @expected M02:في_النطاق
#
# الهدف: التحقق من أن النطاق 0..=13 هو [0, 13] شامل من الطرفين
# أي أن 13 يطابق عندما 0..=13

متغير نتيجة = "لا_تطابق"

طابق (13)
    عندما 0..=13:
        نتيجة = "في_النطاق"
    عندما 14..20:
        نتيجة = "نطاق_أعلى"
    افتراضي:
        نتيجة = "افتراضي"
نهاية

اطبع_سطر("M02:" + نتيجة)
