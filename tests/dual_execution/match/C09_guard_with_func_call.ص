# اختبار C09: guard مع استدعاء دالة
# هدف: guard يستدعي دالة مساعدة في شرطه
# المخرج: 4 رسائل طويل/قصير

دالة طويل_كافي(نص_مدخل)
    ارجع طول(نص_مدخل) >= 5
نهاية

دالة فحص_نص(نص_مدخل)
    طابق (نص_مدخل)
        عندما ن إذا (طويل_كافي(ن)):
            اطبع_سطر("'" + نص_مدخل + "': طويل")
        افتراضي:
            اطبع_سطر("'" + نص_مدخل + "': قصير")
    نهاية
نهاية

فحص_نص("مرحبا")
فحص_نص("مرحبا بالعالم")
فحص_نص("هي")
فحص_نص("12345")
