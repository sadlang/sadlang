# اختبار P02: array destructuring في match
# هدف: تفكيك مصفوفة في pattern (عندما [أ، ب])
# المخرج: 4 أوصاف للمصفوفات

دالة وصف_مصفوفة(مص)
    طابق (مص)
        عندما []:
            ارجع "فارغة"
        عندما [أ]:
            ارجع "عنصر واحد: " + نص(أ)
        عندما [أ، ب]:
            ارجع "عنصران: " + نص(أ) + " و " + نص(ب)
        افتراضي:
            ارجع "أكثر من عنصرين"
    نهاية
نهاية

اطبع_سطر(وصف_مصفوفة([]))
اطبع_سطر(وصف_مصفوفة([42]))
اطبع_سطر(وصف_مصفوفة([1، 2]))
اطبع_سطر(وصف_مصفوفة([1، 2، 3]))
