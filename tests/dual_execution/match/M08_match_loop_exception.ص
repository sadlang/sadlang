# @description طابق داخل حلقة مع استثناءات: تخطي عنصر معين
# @priority P1
# @expected M08:مجموع=12
#
# الهدف: التحقق من أن الاستثناءات داخل طابق داخل حلقة تُعالج بشكل صحيح
# القائمة [1, 2, 3, 4, 5] — يُرمى خطأ عند 3 فيتخطاه
# المجموع = 1+2+4+5 = 12

متغير مجموع = 0

لكل ق في [1, 2, 3, 4, 5]
    حاول
        طابق (ق)
            عندما 3:
                ارمي "تخطى_3"
            افتراضي:
                مجموع = مجموع + ق
        نهاية
    امسك خ
        # تجاهل الخطأ وتخطي العنصر
    نهاية
نهاية

اطبع_سطر("M08:مجموع=" + مجموع)
