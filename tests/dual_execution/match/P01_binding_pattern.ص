# اختبار P01: binding pattern (ن @ نطاق)
# هدف: ربط قيمة في pattern مع النطاق معاً
# المخرج: 4 رسائل مع القيمة المربوطة

دالة وصف_بالربط(رقم)
    طابق (رقم)
        عندما ن @ 1..5:
            اطبع_سطر("صغير: " + نص(ن))
        عندما ن @ 6..10:
            اطبع_سطر("متوسط: " + نص(ن))
        عندما ن @ 11..20:
            اطبع_سطر("كبير: " + نص(ن))
        افتراضي:
            اطبع_سطر("ضخم: " + نص(رقم))
    نهاية
نهاية

وصف_بالربط(3)
وصف_بالربط(8)
وصف_بالربط(15)
وصف_بالربط(25)
