دالة تقييم(مرحلة، درجة)
    طابق (مرحلة)
        عندما "ابتدائي":
            طابق (درجة)
                عندما 0..59:
                    ارجع "راسب"
                عندما 60..79:
                    ارجع "مقبول"
                عندما 80..100:
                    ارجع "ممتاز"
                افتراضي:
                    ارجع "خطأ"
            نهاية
        عندما "متوسط":
            طابق (درجة)
                عندما 0..49:
                    ارجع "راسب"
                عندما 50..74:
                    ارجع "جيد"
                عندما 75..100:
                    ارجع "ممتاز"
                افتراضي:
                    ارجع "خطأ"
            نهاية
        عندما "ثانوي":
            طابق (درجة)
                عندما 0..44:
                    ارجع "راسب"
                عندما 45..69:
                    ارجع "مقبول"
                عندما 70..89:
                    ارجع "جيد"
                عندما 90..100:
                    ارجع "ممتاز"
                افتراضي:
                    ارجع "خطأ"
            نهاية
        افتراضي:
            ارجع "مرحلة غير معروفة"
