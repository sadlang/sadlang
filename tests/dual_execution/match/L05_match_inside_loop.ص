# اختبار L05: match داخل لكل
# هدف: match statement داخل حلقة for-each
# المخرج: تصنيف كل رقم

متغير أرقام = [1، 5، 10، 15، 20]
لكل رقم في أرقام
    طابق (رقم)
        عندما 1..9:
            اطبع_سطر(نص(رقم) + ": صغير")
        عندما 10..19:
            اطبع_سطر(نص(رقم) + ": متوسط")
        افتراضي:
            اطبع_سطر(نص(رقم) + ": كبير")
    نهاية
نهاية
