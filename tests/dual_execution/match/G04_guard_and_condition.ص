# @description guard مع AND معقد: نطاق مزدوج
# @priority P1
# @expected G04:عشرات
# @expected G04:مئات
# @expected G04:صغير
# @expected G04:سالب
#
# الهدف: guard يستخدم AND (&&) لتحقق من شرطين معاً

دالة تصنيف(ن)
    متغير نوع = ""
    طابق (ن)
        عندما ق إذا ق > 10 && ق < 100:
            نوع = "عشرات"
        عندما ق إذا ق >= 100 && ق < 1000:
            نوع = "مئات"
        عندما ق إذا ق >= 0:
            نوع = "صغير"
        عندما ق:
            نوع = "سالب"
    نهاية
    ارجع نوع
نهاية

اطبع_سطر("G04:" + تصنيف(42))
اطبع_سطر("G04:" + تصنيف(500))
اطبع_سطر("G04:" + تصنيف(7))
اطبع_سطر("G04:" + تصنيف(-1))
