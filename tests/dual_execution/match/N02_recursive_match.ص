# اختبار N02: match في دالة تكرارية (recursive)
# هدف: match داخل دالة تستدعي نفسها
# المخرج: تسلسل فيبوناتشي مع تصنيف

دالة فيبوناتشي_وصف(قيمة)
    طابق (قيمة)
        عندما 0:
            ارجع "صفر"
        عندما 1:
            ارجع "واحد"
        عندما 2:
            ارجع "اثنان"
        افتراضي:
            ارجع "أكثر"
    نهاية
نهاية

دالة فيبوناتشي(ن)
    طابق (ن)
        عندما 0:
            ارجع 0
        عندما 1:
            ارجع 1
        افتراضي:
            ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
    نهاية
نهاية

لكل ن في [0، 1، 2، 3، 4، 5]
    متغير ق = فيبوناتشي(ن)
    اطبع_سطر("f(" + نص(ن) + ")=" + نص(ق) + " [" + فيبوناتشي_وصف(ق) + "]")
نهاية
