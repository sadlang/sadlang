# @description guard أساسي: عندما ن مع شروط متعددة ومتدرجة
# @priority P1
# @expected G01:سالب:-3
# @expected G01:صفر:0
# @expected G01:صغير:5
# @expected G01:كبير:15
#
# الهدف: التحقق من أن المتغير المربوط ن يُرى في كل guard
# وأن الـ fallthrough يعمل عند فشل guard ويصل للحالة التالية

دالة صنف(ق)
    متغير نوع = ""
    متغير قيمة_ن = 0
    طابق (ق)
        عندما ن إذا ن < 0:
            نوع = "سالب"
            قيمة_ن = ن
        عندما ن إذا ن == 0:
            نوع = "صفر"
            قيمة_ن = ن
        عندما ن إذا ن < 10:
            نوع = "صغير"
            قيمة_ن = ن
        عندما ن:
            نوع = "كبير"
            قيمة_ن = ن
    نهاية
    ارجع نوع + ":" + قيمة_ن
نهاية

اطبع_سطر("G01:" + صنف(-3))
اطبع_سطر("G01:" + صنف(0))
اطبع_سطر("G01:" + صنف(5))
اطبع_سطر("G01:" + صنف(15))
