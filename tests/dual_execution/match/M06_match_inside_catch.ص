# @description طابق داخل catch لتصنيف الأخطاء
# @priority P1
# @expected M06:خطأ_نوع_ب
#
# الهدف: التحقق من أن طابق يعمل صحيحاً داخل كتلة catch

دالة نوع_خطأ(رسالة)
    متغير نوع = "مجهول"
    طابق (رسالة)
        عندما "نوع_أ":
            نوع = "خطأ_نوع_أ"
        عندما "نوع_ب":
            نوع = "خطأ_نوع_ب"
        عندما "نوع_ج":
            نوع = "خطأ_نوع_ج"
        افتراضي:
            نوع = "خطأ_مجهول"
    نهاية
    ارجع نوع
نهاية

متغير نتيجة = ""

حاول
    ارمي "نوع_ب"
امسك خ
    نتيجة = نوع_خطأ(خ)
نهاية

اطبع_سطر("M06:" + نتيجة)
