# اختبار P05: نطاقات بأرقام كبيرة (قرون)
# هدف: range pattern مع حدود كبيرة
# المخرج: 6 تصنيفات قرن

دالة فئة_السنة(سنة)
    طابق (سنة)
        عندما 1900..1949:
            ارجع "النصف الأول من القرن 20"
        عندما 1950..1999:
            ارجع "النصف الثاني من القرن 20"
        عندما 2000..2049:
            ارجع "بداية القرن 21"
        عندما 2050..2099:
            ارجع "منتصف القرن 21"
        افتراضي:
            ارجع "خارج النطاق"
    نهاية
نهاية

لكل سنة في [1920، 1975، 2010، 2060، 1800، 2100]
    اطبع_سطر(نص(سنة) + ": " + فئة_السنة(سنة))
نهاية
