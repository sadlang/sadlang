##
# X09: طابق + OR pattern على نطاقات + guard معقدة
# سيناريو: جدول تحويل درجات الحرارة مع تصنيف
##

دالة وصف_حرارة(درجة)
    طابق (درجة)
        عندما -273 إذا درجة < -273:
            ارجع "أقل من الصفر المطلق (مستحيل)"
        عندما د إذا د < -10:
            ارجع "صقيع شديد: " + درجة
        عندما د إذا د >= -10 && د < 0:
            ارجع "تحت الصفر: " + درجة
        عندما 0:
            ارجع "نقطة التجمد"
        عندما د إذا د > 0 && د < 15:
            ارجع "بارد: " + درجة
        عندما د إذا د >= 15 && د < 25:
            ارجع "معتدل: " + درجة
        عندما د إذا د >= 25 && د < 35:
            ارجع "دافئ: " + درجة
        عندما د إذا د >= 35 && د < 45:
            ارجع "حار: " + درجة
        افتراضي:
            ارجع "حرارة شديدة: " + درجة
    نهاية
نهاية

