# @description OR pattern: literal || range — رقم محدد أو نطاق
# @priority P1
# @expected OR04:محدد
# @expected OR04:نطاق
# @expected OR04:خارج
#
# الهدف: اختبار OR مع literal ثم range كبديل ثانٍ
# القيمة 0 تطابق literal 0
# القيمة 5 تطابق range 1..10
# القيمة 15 لا تطابق أياً منهما

دالة تصنيف(ن)
    متغير نتيجة = ""
    طابق (ن)
        عندما 0 || 1..10:
            طابق (ن)
                عندما 0:
                    نتيجة = "محدد"
                عندما 1..10:
                    نتيجة = "نطاق"
            نهاية
        افتراضي:
            نتيجة = "خارج"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("OR04:" + تصنيف(0))
اطبع_سطر("OR04:" + تصنيف(5))
اطبع_سطر("OR04:" + تصنيف(15))
