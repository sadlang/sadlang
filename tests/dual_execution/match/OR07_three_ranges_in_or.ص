# @description OR pattern: ثلاثة نطاقات — قيم في كل نطاق وبين النطاقات
# @priority P1
# @expected OR07:A
# @expected OR07:gap
# @expected OR07:B
# @expected OR07:gap
# @expected OR07:C
# @expected OR07:out
#
# الهدف: OR pattern بثلاثة نطاقات منفصلة
# 1..10 → A   (القيمة 5)
# 10..20 فجوة → gap (القيمة 15)
# 20..30 → B  (القيمة 25)
# 30..40 فجوة → gap (القيمة 35)
# 40..50 → C  (القيمة 45)
# 60 → out

دالة تصنيف(ن)
    متغير نتيجة = ""
    طابق (ن)
        عندما 1..10 || 20..30 || 40..50:
            طابق (ن)
                عندما 1..10:
                    نتيجة = "A"
                عندما 20..30:
                    نتيجة = "B"
                عندما 40..50:
                    نتيجة = "C"
            نهاية
        عندما 10..20 || 30..40:
            نتيجة = "gap"
        افتراضي:
            نتيجة = "out"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("OR07:" + تصنيف(5))
اطبع_سطر("OR07:" + تصنيف(15))
اطبع_سطر("OR07:" + تصنيف(25))
اطبع_سطر("OR07:" + تصنيف(35))
اطبع_سطر("OR07:" + تصنيف(45))
اطبع_سطر("OR07:" + تصنيف(60))
