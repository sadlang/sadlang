# @description OR pattern مع نطاقات: 1..5 || 10..15 — فجوة 6..9
# @priority P1
# @expected OR03:نطاق_أول
# @expected OR03:فجوة
# @expected OR03:نطاق_ثاني
# @expected OR03:خارج
#
# الهدف: اختبار OR pattern مع RangePattern — يجب أن يعمل في المفسر والمترجم
# القيمة 3 في 1..5 → "نطاق_أول"
# القيمة 7 في الفجوة 5..10 → "فجوة"
# القيمة 12 في 10..15 → "نطاق_ثاني"
# القيمة 20 خارج كليهما → "خارج"

دالة تصنيف_نطاق(ن)
    متغير نتيجة = ""
    طابق (ن)
        عندما 1..5 || 10..15:
            طابق (ن)
                عندما 1..5:
                    نتيجة = "نطاق_أول"
                عندما 10..15:
                    نتيجة = "نطاق_ثاني"
            نهاية
        عندما 5..10:
            نتيجة = "فجوة"
        افتراضي:
            نتيجة = "خارج"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("OR03:" + تصنيف_نطاق(3))
اطبع_سطر("OR03:" + تصنيف_نطاق(7))
اطبع_سطر("OR03:" + تصنيف_نطاق(12))
اطبع_سطر("OR03:" + تصنيف_نطاق(20))
