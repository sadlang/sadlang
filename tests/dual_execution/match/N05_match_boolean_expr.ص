# اختبار N05: match على قيمة منطقية مشتقة
# هدف: match على تعبير منطقي (صحيح/خطأ)
# المخرج: 4 رسائل موجبان/أحدهما سالب

دالة تصنيف_موجب(أ، ب)
    متغير كلاهما_موجب = أ > 0 و ب > 0
    طابق (كلاهما_موجب)
        عندما صحيح:
            متغير مجموع = أ + ب
            إذا (مجموع > 100)
                اطبع_سطر("موجبان كبيران: " + نص(مجموع))
            وإلا
                اطبع_سطر("موجبان صغيران: " + نص(مجموع))
            نهاية
        عندما خطأ:
            اطبع_سطر("أحدهما سالب")
    نهاية
نهاية

تصنيف_موجب(50، 70)
تصنيف_موجب(10، 20)
تصنيف_موجب(-5، 10)
تصنيف_موجب(0، 5)
