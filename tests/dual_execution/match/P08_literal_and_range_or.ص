# اختبار P08: أنماط OR مع literal و range مختلطة
# هدف: OR يجمع literal (0) مع range (1..5) في نفس الحالة
# المخرج: 7 تصنيفات

دالة تصنيف_أدق(قيمة)
    طابق (قيمة)
        عندما 0 || 1..5:
            ارجع "منخفض جداً"
        عندما 6..20 || 80..94:
            ارجع "منخفض أو مرتفع"
        عندما 21..79:
            ارجع "متوسط"
        عندما 95..100:
            ارجع "مرتفع جداً"
        افتراضي:
            ارجع "خارج"
    نهاية
نهاية

لكل ق في [0، 3، 10، 50، 85، 97، 105]
    اطبع_سطر(نص(ق) + ": " + تصنيف_أدق(ق))
نهاية
