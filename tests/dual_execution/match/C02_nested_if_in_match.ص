# اختبار C02: إذا متداخلة 3 مستويات داخل match arm
# هدف: شروط متداخلة عميقة داخل match
# المخرج: 5 رسائل تصنيف

دالة فحص_مزدوج(نوع، أ، ب)
    طابق (نوع)
        عندما "مقارنة":
            إذا (أ > ب)
                إذا (أ > 100)
                    اطبع_سطر("أ كبير جداً")
                وإلا
                    اطبع_سطر("أ أكبر")
                نهاية
            وإلا إذا (أ < ب)
                إذا (ب > 100)
                    اطبع_سطر("ب كبير جداً")
                وإلا
                    اطبع_سطر("ب أكبر")
                نهاية
            وإلا
                اطبع_سطر("متساويان")
            نهاية
        افتراضي:
            اطبع_سطر("نوع خاطئ")
    نهاية
نهاية

فحص_مزدوج("مقارنة"، 150، 50)
فحص_مزدوج("مقارنة"، 50، 150)
فحص_مزدوج("مقارنة"، 50، 200)
فحص_مزدوج("مقارنة"، 50، 50)
فحص_مزدوج("آخر"، 0، 0)
