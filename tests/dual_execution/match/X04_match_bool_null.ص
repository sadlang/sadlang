##
# X04: طابق على قيم منطقية + لاشيء
# سيناريو: نظام التحقق من الحالة
##

دالة وصف_قيمة(ق)
    طابق (ق)
        عندما صحيح:
            ارجع "مفعّل"
        عندما خطأ:
            ارجع "معطّل"
        عندما لاشيء:
            ارجع "غير محدد"
        افتراضي:
            ارجع "قيمة غير متوقعة"
    نهاية
نهاية

اطبع_سطر(وصف_قيمة(صحيح))
اطبع_سطر(وصف_قيمة(خطأ))
اطبع_سطر(وصف_قيمة(لاشيء))

##
# طابق متداخل على منطقي
##
دالة بوابة_منطقية(أ، ب)
    طابق (أ)
        عندما صحيح:
            طابق (ب)
                عندما صحيح: ارجع "1-1"
                عندما خطأ: ارجع "1-0"
                افتراضي: ارجع "1-?"
            نهاية
        عندما خطأ:
            طابق (ب)
                عندما صحيح: ارجع "0-1"
                عندما خطأ: ارجع "0-0"
                افتراضي: ارجع "0-?"
            نهاية
        افتراضي:
            ارجع "?-?"
    نهاية
نهاية

اطبع_سطر(بوابة_منطقية(صحيح، صحيح))
اطبع_سطر(بوابة_منطقية(صحيح، خطأ))
اطبع_سطر(بوابة_منطقية(خطأ، صحيح))
اطبع_سطر(بوابة_منطقية(خطأ، خطأ))
