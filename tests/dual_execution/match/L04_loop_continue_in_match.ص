# اختبار L04: استمر داخل حلقة في match arm
# هدف: continue داخل for-each داخل match arm
# المخرج: 12 (مجموع الزوجي)، 9 (مجموع الفردي)، 0

دالة جمع_نوع(نوع)
    متغير مجموع = 0
    طابق (نوع)
        عندما "زوجي":
            لكل رقم في [1، 2، 3، 4، 5، 6]
                إذا (رقم % 2 != 0)
                    استمر
                نهاية
                مجموع = مجموع + رقم
            نهاية
        عندما "فردي":
            لكل رقم في [1، 2، 3، 4، 5]
                إذا (رقم % 2 == 0)
                    استمر
                نهاية
                مجموع = مجموع + رقم
            نهاية
        افتراضي:
            مجموع = 0
    نهاية
    ارجع مجموع
نهاية

اطبع_سطر(نص(جمع_نوع("زوجي")))
اطبع_سطر(نص(جمع_نوع("فردي")))
اطبع_سطر(نص(جمع_نوع("آخر")))
