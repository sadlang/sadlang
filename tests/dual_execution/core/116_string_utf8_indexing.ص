# @description اختبار فهرسة النصوص العربية بـ UTF-8 — حالات حدّية
# @expected أ\nب\nد\nم\nر\nح\nب\nا\n!\n6\nع
# @priority P1

# ============================================================
# 1. فهرسة حرف عربي (كل حرف = 2 بايت UTF-8)
# ============================================================
متغير نص1 = "أبجد"
اطبع_سطر(نص1[0])
اطبع_سطر(نص1[1])
اطبع_سطر(نص1[3])

# ============================================================
# 2. فهرسة نص مختلط (عربي + إنجليزي + رموز)
# ============================================================
متغير نص2 = "مرحبا!"
اطبع_سطر(نص2[0])
اطبع_سطر(نص2[1])
اطبع_سطر(نص2[2])
اطبع_سطر(نص2[3])
اطبع_سطر(نص2[4])
اطبع_سطر(نص2[5])

# ============================================================
# 3. طول النص العربي (بالأحرف المنطقية)
# ============================================================
اطبع_سطر(طول(نص2))

# ============================================================
# 4. فهرسة سلبية (آخر حرف)
# ============================================================
متغير نص3 = "عالم"
اطبع_سطر(نص3[-4])
