# @description اختبار التكرار الذاتي (Recursion) — فيبوناتشي، عاملي، عمق
# @expected 120\n8\n55\nعمق:10
# @priority P1

# ============================================================
# 1. دالة العاملي (factorial)
# ============================================================
دالة عاملي(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * عاملي(ن - 1)
نهاية

اطبع_سطر(عاملي(5))

# ============================================================
# 2. دالة فيبوناتشي
# ============================================================
دالة فيبوناتشي(ن)
    إذا (ن <= 1)
        ارجع ن
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

اطبع_سطر(فيبوناتشي(6))
اطبع_سطر(فيبوناتشي(10))

# ============================================================
# 3. تكرار ذاتي مع عداد عمق
# ============================================================
دالة عد_تنازلي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    ارجع 1 + عد_تنازلي(ن - 1)
نهاية

اطبع_سطر("عمق:" + عد_تنازلي(10))
