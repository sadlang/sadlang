# @description اختبار شامل لحلقات لكل — مصفوفات، نطاقات، تداخل، مع عمليات
# @expected مصفوفة:1\nمصفوفة:2\nمصفوفة:3\nمجموع:15\nكلمات:3\nزوجي:2\nزوجي:4\nزوجي:6\nتداخل:1*1=1\nتداخل:1*2=2\nتداخل:2*1=2\nتداخل:2*2=4\nمفاتيح:أ=1\nمفاتيح:ب=2\nمفاتيح:ج=3\nتراكم:1-2-3-4-5\nعداد:10
# @priority P0

# ============================================================
# 1. لكل على مصفوفة بسيطة
# ============================================================
لكل عنصر في [1، 2، 3]
    اطبع_سطر("مصفوفة:" + عنصر)
نهاية

# ============================================================
# 2. لكل مع تجميع — حساب المجموع
# ============================================================
متغير مجموع = 0
لكل ن في [1، 2، 3، 4، 5]
    مجموع = مجموع + ن
نهاية
اطبع_سطر("مجموع:" + مجموع)

# ============================================================
# 3. لكل على نتيجة تقسيم نص — عد الكلمات
# ============================================================
متغير كلمات = "مرحبا يا عالم"
متغير أجزاء = كلمات.قسم(" ")
متغير عدد_كلمات = 0
لكل كلمة في أجزاء
    عدد_كلمات = عدد_كلمات + 1
نهاية
اطبع_سطر("كلمات:" + عدد_كلمات)

# ============================================================
# 4. لكل مع شرط — فلترة
# ============================================================
لكل ن في [1، 2، 3، 4، 5، 6، 7]
    إذا (ن % 2 == 0)
        اطبع_سطر("زوجي:" + ن)
    نهاية
نهاية

# ============================================================
# 5. لكل متداخل — جدول ضرب مصغر
# ============================================================
لكل أ في [1، 2]
    لكل ب في [1، 2]
        اطبع_سطر("تداخل:" + أ + "*" + ب + "=" + (أ * ب))
    نهاية
نهاية

# ============================================================
# 6. لكل على خريطة — مفاتيح وقيم
# ============================================================
متغير خ = {"أ": 1، "ب": 2، "ج": 3}
متغير مفاتيح = خ.مفاتيح()
مفاتيح.رتب()
لكل م في مفاتيح
    اطبع_سطر("مفاتيح:" + م + "=" + خ[م])
نهاية

# ============================================================
# 7. لكل مع بناء نص تراكمي
# ============================================================
متغير سلسلة = ""
لكل ن في [1، 2، 3، 4، 5]
    إذا (سلسلة == "")
        سلسلة = "" + ن
    وإلا
        سلسلة = سلسلة + "-" + ن
    نهاية
نهاية
اطبع_سطر("تراكم:" + سلسلة)

# ============================================================
# 8. بينما — حلقة عداد كلاسيكية
# ============================================================
متغير عداد = 0
بينما (عداد < 10)
    عداد = عداد + 1
نهاية
اطبع_سطر("عداد:" + عداد)
