# @test اختبار لامدا الكتلة (Block Lambda)
# @description اختبار الصيغتين: لامدا(م) كتلة نهاية + لامدا(م) => كتلة نهاية — مع متغيرات محلية، حلقات، إذا متعددة
# @expected B01:PASS\nB02:PASS\nB03:PASS\nB04:PASS\nB05:PASS\nB06:PASS\nB07:PASS\nB08:PASS\nSUMMARY:8/8

متغير تمرير = 0
متغير فشل = 0

# ═══ B01: لامدا كتلة بدون سهم — حساب بسيط ═══
متغير حاسب = لامدا(أ، ب)
    متغير مجموع = أ + ب
    متغير حاصل = أ * ب
    ارجع مجموع + حاصل
نهاية
إذا (حاسب(3، 4) == 19)
    اطبع_سطر("B01:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("B01:FAIL")
    فشل = فشل + 1
نهاية

# ═══ B02: لامدا كتلة مع حلقة بينما ═══
متغير مجموع_حتى = لامدا(حد)
    متغير ن = 0
    متغير مج = 0
    بينما (ن < حد)
        مج = مج + ن
        ن = ن + 1
    نهاية
    ارجع مج
نهاية
إذا (مجموع_حتى(5) == 10 و مجموع_حتى(10) == 45)
    اطبع_سطر("B02:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("B02:FAIL")
    فشل = فشل + 1
نهاية

# ═══ B03: لامدا سهم + كتلة إذا/وإلا ═══
متغير صنّف = لامدا(درجة) =>
    إذا (درجة >= 90)
        ارجع "ممتاز"
    وإلا
        إذا (درجة >= 70)
            ارجع "جيد"
        وإلا
            ارجع "ضعيف"
        نهاية
    نهاية
نهاية
إذا (صنّف(95) == "ممتاز" و صنّف(75) == "جيد" و صنّف(50) == "ضعيف")
    اطبع_سطر("B03:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("B03:FAIL")
    فشل = فشل + 1
نهاية

# ═══ B04: لامدا كتلة مع متغيرات محلية + string concat ═══
متغير تنسيق = لامدا(اسم، نقاط)
    متغير مستوى = "مبتدئ"
    إذا (نقاط > 100)
        مستوى = "خبير"
    نهاية
    ارجع اسم + " (" + مستوى + ")"
نهاية
إذا (تنسيق("أحمد"، 150) == "أحمد (خبير)" و تنسيق("سارة"، 50) == "سارة (مبتدئ)")
    اطبع_سطر("B04:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("B04:FAIL")
    فشل = فشل + 1
نهاية

# ═══ B05: لامدا كتلة مع closure ═══
متغير مضاعف = 3
متغير مع_مضاعف = لامدا(ن)
    متغير نت = ن * مضاعف
    ارجع نت
نهاية
إذا (مع_مضاعف(7) == 21 و مع_مضاعف(10) == 30)
    اطبع_سطر("B05:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("B05:FAIL")
    فشل = فشل + 1
نهاية

# ═══ B06: لامدا كتلة تُرجع من دالة (factory pattern) ═══
دالة مصنع_عملية(نوع)
    إذا (نوع == "جمع")
        ارجع لامدا(أ، ب)
            ارجع أ + ب
        نهاية
    وإلا
        ارجع لامدا(أ، ب)
            ارجع أ * ب
        نهاية
    نهاية
نهاية
متغير عملية_جمع = مصنع_عملية("جمع")
متغير عملية_ضرب = مصنع_عملية("ضرب")
إذا (عملية_جمع(3، 4) == 7 و عملية_ضرب(3، 4) == 12)
    اطبع_سطر("B06:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("B06:FAIL")
    فشل = فشل + 1
نهاية

# ═══ B07: لامدا كتلة كوسيط لدالة HOF يدوية ═══
دالة طبّق(ض، قيمة)
    ارجع ض(قيمة)
نهاية
متغير نتيجة = طبّق(لامدا(س)
    إذا (س > 10)
        ارجع س * 3
    وإلا
        ارجع س + 5
    نهاية
نهاية، 20)
إذا (نتيجة == 60)
    اطبع_سطر("B07:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("B07:FAIL")
    فشل = فشل + 1
نهاية

# ═══ B08: لامدا كتلة — تطبيق مرتين (double apply) ═══
دالة مرتين(ض، قيمة)
    ارجع ض(ض(قيمة))
نهاية
متغير نت = مرتين(لامدا(س)
    ارجع س + 10
نهاية، 5)
إذا (نت == 25)
    اطبع_سطر("B08:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("B08:FAIL")
    فشل = فشل + 1
نهاية

# ═══ الملخص ═══
اطبع_سطر("SUMMARY:" + تمرير + "/" + (تمرير + فشل))
