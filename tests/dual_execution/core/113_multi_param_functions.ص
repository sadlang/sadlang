# @description اختبار دوال متعددة المعاملات وقيم الإرجاع المتنوعة
# @expected 6\nمرحبا أحمد!\nصحيح\nخطأ\n3\nأ-ب-ج
# @priority P1

# ============================================================
# 1. دالة بمعاملات متعددة
# ============================================================
دالة جمع_ثلاثة(أ، ب، ج)
    ارجع أ + ب + ج
نهاية
اطبع_سطر(جمع_ثلاثة(1، 2، 3))

# ============================================================
# 2. دالة تُرجع نص
# ============================================================
دالة تحية(اسم)
    ارجع "مرحبا " + اسم + "!"
نهاية
اطبع_سطر(تحية("أحمد"))

# ============================================================
# 3. دالة تُرجع منطقي
# ============================================================
دالة هل_زوجي(ن)
    ارجع ن % 2 == 0
نهاية
اطبع_سطر(هل_زوجي(4))
اطبع_سطر(هل_زوجي(7))

# ============================================================
# 4. دالة تُرجع مصفوفة
# ============================================================
دالة أنشئ_قائمة()
    ارجع [1، 2، 3]
نهاية
اطبع_سطر(طول(أنشئ_قائمة()))

# ============================================================
# 5. دالة تستدعي دالة أخرى
# ============================================================
دالة وصل(قائمة، فاصل)
    متغير نتيجة = ""
    لكل ع في قائمة
        إذا (نتيجة != "")
            نتيجة = نتيجة + فاصل
        نهاية
        نتيجة = نتيجة + ع
    نهاية
    ارجع نتيجة
نهاية
اطبع_سطر(وصل(["أ"، "ب"، "ج"]، "-"))
