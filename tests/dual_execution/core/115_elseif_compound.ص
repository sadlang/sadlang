# @description اختبار وإلا إذا (else if) متعددة المستويات + شروط مركبة
# @expected مراهق\nممتاز\nبالغ\nصحيح\nخطأ\nصحيح
# @priority P1

# ============================================================
# 1. سلسلة وإلا إذا
# ============================================================
دالة فئة_عمر(عمر)
    إذا (عمر < 13)
        ارجع "طفل"
    وإلا إذا (عمر < 20)
        ارجع "مراهق"
    وإلا إذا (عمر < 60)
        ارجع "بالغ"
    وإلا
        ارجع "كبير"
    نهاية
نهاية

اطبع_سطر(فئة_عمر(15))

# ============================================================
# 2. وإلا إذا مع مقارنة أرقام
# ============================================================
دالة تقييم(درجة)
    إذا (درجة >= 90)
        ارجع "ممتاز"
    وإلا إذا (درجة >= 80)
        ارجع "جيد جداً"
    وإلا إذا (درجة >= 70)
        ارجع "جيد"
    وإلا إذا (درجة >= 60)
        ارجع "مقبول"
    وإلا
        ارجع "راسب"
    نهاية
نهاية

اطبع_سطر(تقييم(95))

# ============================================================
# 3. شروط مركبة
# ============================================================
اطبع_سطر(فئة_عمر(35))

متغير س = 15
اطبع_سطر(س > 10 و س < 20)
اطبع_سطر(س > 20 أو س < 5)
اطبع_سطر(ليس (س == 0))
