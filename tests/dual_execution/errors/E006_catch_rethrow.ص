# ============================================================
# E006: catch يُعيد الرمي (rethrow) — الانتشار للمستوى الأعلى
# ============================================================

متغير مسار6 = ""

حاول
    حاول
        ارمي "خطأ_أصلي"
    امسك خ
        مسار6 = مسار6 + "INNER|"
        اطبع_سطر("E006:INNER")
        ارمي خ
    نهاية
امسك خ
    مسار6 = مسار6 + "OUTER|"
    اطبع_سطر("E006:OUTER")
نهاية

إذا (مسار6 == "INNER|OUTER|")
    اطبع_سطر("E006:PASS")
وإلا
    اطبع_سطر("E006:FAIL:" + مسار6)
نهاية
