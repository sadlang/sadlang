# @description سلسلة معالجة الأخطاء — كل طبقة تُعالج نوع خطأها
# @priority P2
# @expected E018:LAYER3\nE018:LAYER2\nE018:LAYER1\nE018:PASS

# ============================================================
# E018: سلسلة معالجة أخطاء — طبقات متعددة لفلترة الأخطاء
# ============================================================

متغير طبقات18 = ""

دالة طبقة3(قيمة)
    إذا (قيمة < 0)
        ارمي "قيمة_سالبة:" + قيمة
    نهاية
    ارجع قيمة * 2
نهاية

دالة طبقة2(قيمة)
    حاول
        ارجع طبقة3(قيمة)
    امسك خ
        طبقات18 = طبقات18 + "L3|"
        اطبع_سطر("E018:LAYER3")
        ارمي "خطأ_طبقة2:" + خ
    نهاية
نهاية

دالة طبقة1(قيمة)
    حاول
        ارجع طبقة2(قيمة)
    امسك خ
        طبقات18 = طبقات18 + "L2|"
        اطبع_سطر("E018:LAYER2")
        ارمي "خطأ_نهائي"
    نهاية
نهاية

حاول
    طبقة1(-5)
امسك خ
    طبقات18 = طبقات18 + "L1"
    اطبع_سطر("E018:LAYER1")
نهاية

إذا (طبقات18 == "L3|L2|L1")
    اطبع_سطر("E018:PASS")
وإلا
    اطبع_سطر("E018:FAIL:" + طبقات18)
نهاية
