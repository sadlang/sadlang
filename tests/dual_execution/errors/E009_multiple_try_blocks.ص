# @description try/catch متعدد في نفس الدالة — كل كتلة مستقلة
# @priority P1
# @expected E009:A_CAUGHT\nE009:B_OK\nE009:C_CAUGHT\nE009:PASS

# ============================================================
# E009: ثلاث كتل try/catch مستقلة في نفس النطاق
# ============================================================

متغير نجح9 = 0

# الكتلة أ: تُلتقط
حاول
    ارمي "خطأ_أ"
امسك خ
    اطبع_سطر("E009:A_CAUGHT")
    نجح9 = نجح9 + 1
نهاية

# الكتلة ب: بدون استثناء
حاول
    متغير س = 10 + 5
    اطبع_سطر("E009:B_OK")
    نجح9 = نجح9 + 1
امسك خ
    اطبع_سطر("E009:B_FAIL")
نهاية

# الكتلة ج: تُلتقط
حاول
    ارمي "خطأ_ج"
امسك خ
    اطبع_سطر("E009:C_CAUGHT")
    نجح9 = نجح9 + 1
نهاية

إذا (نجح9 == 3)
    اطبع_سطر("E009:PASS")
وإلا
    اطبع_سطر("E009:FAIL:نجح=" + نجح9)
نهاية
