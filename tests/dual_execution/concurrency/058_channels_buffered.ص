# @description اختبار القنوات المُخزّنة — تكرار، إغلاق، عمليات بدون حجب، مهلات
# @expected 60\n5\n10\nصحيح\nصحيح\nخطأ\nلاشيء\nمغلقة_نجح
# @priority P0
# @skip_compiler القنوات غير مدعومة في المترجم بعد

# ============================================================
# 1) تكرار عبر قناة مغلقة (لكل ... في قناة)
# ============================================================
متغير ق1 = قناة(5)
ق1.أرسل(10)
ق1.أرسل(20)
ق1.أرسل(30)
ق1.أغلق()

متغير مجموع = 0
لكل عنصر في ق1
    مجموع = مجموع + عنصر
نهاية
اطبع_سطر(مجموع)

# ============================================================
# 2) خصائص القناة — الحجم والسعة
# ============================================================
متغير ق2 = قناة(10)
لكل ن في 1..5
    ق2.أرسل(ن)
نهاية
اطبع_سطر(ق2.الحجم())
اطبع_سطر(ق2.السعة())

# ============================================================
# 3) حاول_ارسل / حاول_استقبل (بدون حجب)
# ============================================================
متغير ق3 = قناة(2)
ق3.أرسل(100)
ق3.أرسل(200)

# القناة ممتلئة — حاول_ارسل يجب أن يرجع خطأ
متغير نجح_ارسال = ق3.حاول_ارسل(300)
اطبع_سطر(ق3.الحجم() == 2)

# حاول_استقبل من قناة فيها عناصر
متغير قيمة = ق3.حاول_استقبل()
اطبع_سطر(قيمة == 100)

# ============================================================
# 4) أرسل_بمهلة / استقبل_بمهلة
# ============================================================
متغير ق4 = قناة(1)
ق4.أرسل(999)

# محاولة إرسال لقناة ممتلئة مع مهلة قصيرة — يجب أن ترجع خطأ
متغير نجح_مهلة = ق4.أرسل_بمهلة(777، 50)
اطبع_سطر(نجح_مهلة)

# استقبال مع مهلة من قناة فارغة
ق4.استقبل()
متغير ق_فارغ = ق4.استقبل_بمهلة(50)
اطبع_سطر(ق_فارغ)

# ============================================================
# 5) سلوك القناة المغلقة
# ============================================================
متغير ق5 = قناة(5)
ق5.أرسل(42)
ق5.أغلق()

# استقبال من قناة مغلقة فيها بيانات — يجب أن يعمل
متغير ق5_قيمة = ق5.استقبل()
إذا (ق5.مغلقة() و ق5_قيمة == 42)
    اطبع_سطر("مغلقة_نجح")
وإلا
    اطبع_سطر("مغلقة_فشل")
نهاية
