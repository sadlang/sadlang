# @description سيناريوهات سلبية للتزامن: send after close, double close, receive after close, waitgroup misuse, unlock misuse
# @priority P2
# @skip_compiler
# @timeout 30
# @expected N01:PASS\nN02:PASS\nN03:PASS\nN04:PASS\nN05:PASS\nN06:PASS\nN07:PASS\nN08:PASS\nN09:PASS\nN10:PASS\nSUMMARY:10/10

متغير نجاح = 0

دالة سجّل(اسم، شرط)
    إذا (شرط)
        اطبع_سطر(اسم + ":PASS")
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر(اسم + ":FAIL")
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────────────────
# N01: استقبال من قناة فارغة بمهلة — يجب أن يرجع لاشيء
# ─────────────────────────────────────────────────────────────────────────────
متغير ق1 = قناة(5)
متغير ن1 = ق1.حاول_استقبل()
سجّل("N01"، ن1 == لاشيء)

# ─────────────────────────────────────────────────────────────────────────────
# N02: إرسال بمهلة لقناة ممتلئة — يجب أن يرجع خطأ
# ─────────────────────────────────────────────────────────────────────────────
متغير ق2 = قناة(1)
ق2.أرسل(100)
متغير نتيجة2 = ق2.حاول_ارسل(200)
سجّل("N02"، نتيجة2 == خطأ)

# ─────────────────────────────────────────────────────────────────────────────
# N03: إغلاق قناة والتحقق من حالتها
# ─────────────────────────────────────────────────────────────────────────────
متغير ق3 = قناة(5)
ق3.أرسل(1)
ق3.أغلق()
سجّل("N03"، ق3.مغلقة() == صحيح)

# ─────────────────────────────────────────────────────────────────────────────
# N04: استقبال من قناة مغلقة — يجب أن يحصل على العناصر الموجودة
# ─────────────────────────────────────────────────────────────────────────────
متغير ق4 = قناة(5)
ق4.أرسل(42)
ق4.أرسل(43)
ق4.أغلق()
متغير ف4أ = ق4.استقبل()
متغير ف4ب = ق4.استقبل()
سجّل("N04"، ف4أ == 42 و ف4ب == 43)

# ─────────────────────────────────────────────────────────────────────────────
# N05: حاول_استقبل من قناة مغلقة فارغة — يجب أن يرجع لاشيء
# ─────────────────────────────────────────────────────────────────────────────
متغير ق5 = قناة(5)
ق5.أغلق()
متغير ف5 = ق5.حاول_استقبل()
سجّل("N05"، ف5 == لاشيء)

# ─────────────────────────────────────────────────────────────────────────────
# N06: قفل وفتح عادي — التحقق من عدم التعليق
# ─────────────────────────────────────────────────────────────────────────────
متغير قف6 = قفل()
قف6.اقفل()
متغير كان_مقفل = قف6.مقفل()
قف6.افتح()
سجّل("N06"، كان_مقفل == صحيح و قف6.مقفل() == خطأ)

# ─────────────────────────────────────────────────────────────────────────────
# N07: حاول_قفل على قفل مأخوذ — يجب أن يرجع خطأ
# ─────────────────────────────────────────────────────────────────────────────
متغير قف7 = قفل()
قف7.اقفل()
متغير نتيجة7 = قف7.حاول_قفل()
قف7.افتح()
سجّل("N07"، نتيجة7 == خطأ)

# ─────────────────────────────────────────────────────────────────────────────
# N08: مجموعة_انتظار بعداد صفر — يجب ألا تعلق
# ─────────────────────────────────────────────────────────────────────────────
متغير مج8 = مجموعة_انتظار()
مج8.أضف(0)
مج8.انتظر()
سجّل("N08"، مج8.العداد() == 0)

# ─────────────────────────────────────────────────────────────────────────────
# N09: مستقبل — get قبل set (بمهلة) — يجب أن يعمل بعد set من goroutine
# ─────────────────────────────────────────────────────────────────────────────
متغير م9 = مستقبل()
أطلق
    م9.عيّن(99)
نهاية
انتظر_الكل()
سجّل("N09"، م9.احصل() == 99 و م9.جاهز() == صحيح)

# ─────────────────────────────────────────────────────────────────────────────
# N10: إرسال بمهلة لقناة مغلقة — حاول_ارسل يجب أن يفشل
# ─────────────────────────────────────────────────────────────────────────────
متغير ق10 = قناة(5)
ق10.أغلق()
متغير نتيجة10 = ق10.حاول_ارسل(42)
سجّل("N10"، نتيجة10 == خطأ)

اطبع_سطر("SUMMARY:" + نجاح + "/10")
