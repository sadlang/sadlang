# @description اختبار أطلق (goroutine) — إطلاق دوال وكتل مع قنوات ومزامنة
# @expected 9\n16\n25\n55\n120\nنجح_التقاط
# @priority P0
# @skip_compiler الخيوط الخفيفة غير مدعومة في المترجم بعد

# ============================================================
# 1) أطلق مع استدعاء دالة (تمرير قناة + معامل)
# ============================================================
دالة حساب_مربع(ق، قيمة)
    ق.أرسل(قيمة * قيمة)
نهاية

متغير ق_مربعات = قناة(5)

أطلق حساب_مربع(ق_مربعات، 3)
أطلق حساب_مربع(ق_مربعات، 4)
أطلق حساب_مربع(ق_مربعات، 5)

انتظر_الكل()

# جمع النتائج وترتيبها (goroutines لا تضمن الترتيب)
متغير نتائج = []
بينما (ق_مربعات.فارغة() == خطأ)
    نتائج.اضف(ق_مربعات.استقبل())
نهاية
نتائج.رتب()

لكل ن في نتائج
    اطبع_سطر(ن)
نهاية

# ============================================================
# 2) أطلق كتلة مع حساب داخلي
# ============================================================
متغير م = مستقبل()

أطلق
    متغير مجموع = 0
    لكل ن في 1..10
        مجموع = مجموع + ن
    نهاية
    م.عيّن(مجموع)
نهاية

اطبع_سطر(م.احصل())

# ============================================================
# 3) أطلق متعدد مع مجموعة انتظار
# ============================================================
متغير مج_ا = مجموعة_انتظار()
متغير ق_عداد = قناة(200)

مج_ا.أضف(120)
لكل _ في 1..120
    أطلق
        ق_عداد.أرسل(1)
        مج_ا.أنهي()
    نهاية
نهاية

مج_ا.انتظر()

متغير مجموع_كلي = 0
بينما (ق_عداد.فارغة() == خطأ)
    مجموع_كلي = مجموع_كلي + ق_عداد.استقبل()
نهاية

اطبع_سطر(مجموع_كلي)

# ============================================================
# 4) أطلق يلتقط متغيرات كـ snapshot
# ============================================================
متغير ق_التقاط = قناة(5)
متغير قيمة_خارجية = 42

أطلق
    ق_التقاط.أرسل(قيمة_خارجية)
نهاية

انتظر_الكل()

متغير ملتقط = ق_التقاط.استقبل()
إذا (ملتقط == 42)
    اطبع_سطر("نجح_التقاط")
وإلا
    اطبع_سطر("فشل_التقاط:" + ملتقط)
نهاية
