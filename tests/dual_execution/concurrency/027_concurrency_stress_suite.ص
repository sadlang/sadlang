متغير ق_نتائج_قفل = قناة(200)

مج2.أضف(120)
لكل z في 1..120
    أطلق
        ق_م.اقفل()
        ق_نتائج_قفل.أرسل(1)
        ق_م.افتح()
        مج2.أنهي()
    نهاية
نهاية

مج2.انتظر()

متغير مجموع_قفل = 0
متغير عدد_قفل = 0
بينما (ق_نتائج_قفل.فارغة() == خطأ)
    مجموع_قفل = مجموع_قفل + ق_نتائج_قفل.استقبل()
    عدد_قفل = عدد_قفل + 1
