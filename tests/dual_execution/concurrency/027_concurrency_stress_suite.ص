نهاية

# ─────────────────────────────────────────────────────────────────────────────
# المجموعة A: 120 goroutines + channel aggregation
# ─────────────────────────────────────────────────────────────────────────────
متغير ق1 = قناة(200)

لكل i في 1..120
    أطلق
        ق1.أرسل(1)
    نهاية
نهاية

انتظر_الكل()

متغير مجموع1 = 0
متغير عدد1 = 0
بينما (ق1.فارغة() == خطأ)
    مجموع1 = مجموع1 + ق1.استقبل()
    عدد1 = عدد1 + 1
نهاية

سجّل("T01", مجموع1 == 120)
سجّل("T02", عدد1 == 120)
سجّل("T03", ق1.السعة() == 200)
سجّل("T04", ق1.الحجم() == 0)

متغير ن_فارغ1 = ق1.حاول_استقبل()
سجّل("T05", ن_فارغ1 == لاشيء)

متغير ن_فارغ2 = ق1.استقبل_بمهلة(30)
سجّل("T06", ن_فارغ2 == لاشيء)

