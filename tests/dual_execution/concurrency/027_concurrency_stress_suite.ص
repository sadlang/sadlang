متغير ق_متداخل = قناة(150)

مج_خارجي.أضف(10)
لكل g في 1..10
    أطلق
        متغير مج_داخلي = مجموعة_انتظار()
        مج_داخلي.أضف(10)
        لكل t في 1..10
            أطلق
                ق_متداخل.أرسل(1)
                مج_داخلي.أنهي()
            نهاية
        نهاية
        مج_داخلي.انتظر()
        مج_خارجي.أنهي()
    نهاية
نهاية

مج_خارجي.انتظر()

متغير عدد_متداخل = 0
متغير مجموع_متداخل = 0
بينما (ق_متداخل.فارغة() == خطأ)
    مجموع_متداخل = مجموع_متداخل + ق_متداخل.استقبل()
    عدد_متداخل = عدد_متداخل + 1
نهاية

سجّل("T35", عدد_متداخل == 100)
