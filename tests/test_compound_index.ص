# اختبار الإسناد المركب لعناصر المصفوفات والخرائط
# Test compound assignment for array/map elements: arr[i] += val

# اختبار 1: مصفوفة += عدد
متغير أ = [10، 20، 30]
أ[0] += 5
أ[1] += 10
أ[2] += 20
إذا (أ[0] == 15 و أ[1] == 30 و أ[2] == 50)
    اطبع_سطر("اختبار 1 نجح: مصفوفة += عدد")
وإلا
    اطبع_سطر("اختبار 1 فشل: " + أ[0] + "، " + أ[1] + "، " + أ[2])
نهاية

# اختبار 2: مصفوفة -= عدد
متغير ب = [100، 200، 300]
ب[0] -= 10
ب[2] -= 50
إذا (ب[0] == 90 و ب[2] == 250)
    اطبع_سطر("اختبار 2 نجح: مصفوفة -= عدد")
وإلا
    اطبع_سطر("اختبار 2 فشل: " + ب[0] + "، " + ب[2])
نهاية

# اختبار 3: مصفوفة *= عدد
متغير ج = [2، 3، 4]
ج[1] *= 10
إذا (ج[1] == 30)
    اطبع_سطر("اختبار 3 نجح: مصفوفة *= عدد")
وإلا
    اطبع_سطر("اختبار 3 فشل: " + ج[1])
نهاية

# اختبار 4: متغير كمؤشر
متغير د = [5، 10، 15]
متغير ي = 2
د[ي] += 100
إذا (د[2] == 115)
    اطبع_سطر("اختبار 4 نجح: متغير كمؤشر")
وإلا
    اطبع_سطر("اختبار 4 فشل: " + د[2])
نهاية

# اختبار 5: نص += نص في مصفوفة
متغير هـ = ["مرحبا"، "عالم"]
هـ[0] += " يا"
إذا (هـ[0] == "مرحبا يا")
    اطبع_سطر("اختبار 5 نجح: نص += في مصفوفة")
وإلا
    اطبع_سطر("اختبار 5 فشل: " + هـ[0])
نهاية
