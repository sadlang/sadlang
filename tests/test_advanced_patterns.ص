# ============================================
# 4. اختبار نمط القائمة (List Pattern)
# ============================================
اطبع_سطر("")
اطبع_سطر("4️⃣ اختبار List Pattern:")

دالة وصف_قائمة(قائمة)
    طابق (قائمة)
        عندما []:
            ارجع "قائمة فارغة []"
        عندما [أول]:
            ارجع "عنصر واحد: " + أول
        عندما [أول، ثاني]:
            ارجع "عنصران: " + أول + " و " + ثاني
        عندما [أول، ثاني، ثالث]:
            ارجع "ثلاثة: " + أول + "، " + ثاني + "، " + ثالث
        افتراضي:
            ارجع "قائمة طويلة"
    نهاية
نهاية

اطبع_سطر("   وصف_قائمة([]) = " + وصف_قائمة([]))
اطبع_سطر("   وصف_قائمة([5]) = " + وصف_قائمة([5]))
اطبع_سطر("   وصف_قائمة([1، 2]) = " + وصف_قائمة([1، 2]))
اطبع_سطر("   وصف_قائمة([\"أ\"، \"ب\"، \"ج\"]) = " + وصف_قائمة(["أ"، "ب"، "ج"]))

