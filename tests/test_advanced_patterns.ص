# 3. اختبار نمط OR مع النطاق
# ============================================
اطبع_سطر("")
اطبع_سطر("3️⃣ اختبار OR Pattern:")

دالة شهر_السنة(شهر)
    طابق (شهر)
        عندما 12 || 1 || 2:
            ارجع "❄️ فصل الشتاء"
        عندما 3 || 4 || 5:
            ارجع "🌸 فصل الربيع"
        عندما 6 || 7 || 8:
            ارجع "☀️ فصل الصيف"
        عندما 9 || 10 || 11:
            ارجع "🍂 فصل الخريف"
        افتراضي:
            ارجع "❓ شهر غير صالح"
    نهاية
نهاية

