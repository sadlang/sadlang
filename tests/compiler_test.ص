# اختبار شامل للمفسر والمترجم
# Comprehensive test for interpreter and compiler parity

دالة جمع(أ، ب)
   ارجع أ + ب
نهاية

دالة مضروب(ن)
   إذا (ن <= 1)
      ارجع 1
   نهاية
   ارجع ن * مضروب(ن - 1)
نهاية

# اختبار الدوال
متغير النتيجة = جمع(10، 20)
اطبع_سطر("المجموع: " + النتيجة)

متغير م = مضروب(5)
اطبع_سطر("مضروب 5: " + م)

# اختبار المتغيرات والحسابات
متغير س = 100
متغير ع = س * 2 + 50
اطبع_سطر("الحساب: " + ع)

# اختبار الشرط
إذا (النتيجة > 25)
   اطبع_سطر("النتيجة أكبر من 25")
وإلا
   اطبع_سطر("النتيجة أصغر أو تساوي 25")
نهاية

# اختبار الحلقة
متغير مجموع = 0
متغير ع2 = 1
بينما (ع2 <= 10)
   مجموع = مجموع + ع2
   ع2 = ع2 + 1
نهاية
اطبع_سطر("مجموع 1 إلى 10: " + مجموع)

اطبع_سطر("انتهى الاختبار بنجاح")
