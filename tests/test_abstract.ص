# اختبار الأصناف المجردة (Abstract Classes)
اطبع_سطر("=== اختبار الأصناف المجردة ===")

# صنف مجرد
مجرد صنف شكل
    نص الاسم

    باني(نص اسم)
        الاسم = اسم
    نهاية

    # دالة مجردة - يجب أن تنفذ في الصنف الفرعي
    مجرد دالة المساحة()

    دالة عرض_الاسم()
        اطبع_سطر(الاسم)
    نهاية
نهاية

# صنف يرث من المجرد
صنف مستطيل يرث شكل
    رقم العرض
    رقم الطول

    باني(رقم عرض، رقم طول)
        الاسم = "مستطيل"
        العرض = عرض
        الطول = طول
    نهاية

    دالة رقم المساحة()
        ارجع العرض * الطول
    نهاية
نهاية

# اختبار - يجب أن ينجح إنشاء مستطيل
متغير م = جديد مستطيل(5، 3)
م.عرض_الاسم()
اطبع("المساحة = ")
اطبع_سطر(م.المساحة())

اطبع_سطر("=== تمت الاختبارات ===")