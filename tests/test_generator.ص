# اختبار دوال المولّد (Generator Functions)

# مولّد بسيط - يُنتج أرقام
دالة مولد عداد()
    أنتج 1
    أنتج 2
    أنتج 3
نهاية

# استدعاء المولّد - يجمع كل القيم في مصفوفة
متغير نتيجة = عداد()
اطبع_سطر("نتيجة المولّد: " + نتيجة)

# مولّد مع حلقة
دالة مولد مضاعفات(ن)
    متغير ع = 1
    بينما (ع <= 5)
        أنتج ع * ن
        ع = ع + 1
    نهاية
نهاية

متغير م = مضاعفات(3)
اطبع_سطر("مضاعفات 3: " + م)

# مولّد مع شرط
دالة مولد زوجيات(حد)
    متغير ع = 0
    بينما (ع <= حد)
        إذا (ع % 2 == 0)
            أنتج ع
        نهاية
        ع = ع + 1
    نهاية
نهاية

متغير ز = زوجيات(10)
اطبع_سطر("الأعداد الزوجية: " + ز)

