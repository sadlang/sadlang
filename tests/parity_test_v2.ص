# اختبار التكافؤ الشامل - بدون عمليات مصفوفات مضمنة
# Comprehensive parity test - no built-in array methods

# === اختبار 1: المتغيرات والعمليات الحسابية ===
متغير س = 10
متغير ع = 20
متغير المجموع = س + ع
اطبع_سطر("المجموع: " + المجموع)

متغير حاصل_الضرب = س * ع
اطبع_سطر("حاصل الضرب: " + حاصل_الضرب)

متغير الباقي = ع % 3
اطبع_سطر("الباقي: " + الباقي)

# === اختبار 2: الشروط ===
إذا (المجموع > 25)
   اطبع_سطر("النتيجة أكبر من 25")
وإلا
   اطبع_سطر("النتيجة 25 أو أقل")
نهاية

إذا (س == 10)
   اطبع_سطر("س تساوي 10")
نهاية

# === اختبار 3: الحلقات ===
متغير مجموع_حلقة = 0
متغير عداد = 1
بينما (عداد <= 5)
   مجموع_حلقة = مجموع_حلقة + عداد
   عداد = عداد + 1
نهاية
اطبع_سطر("مجموع 1 إلى 5: " + مجموع_حلقة)

# === اختبار 4: الدوال والاستدعاء التراجعي ===
دالة مضروب(ن)
   إذا (ن <= 1)
      ارجع 1
   نهاية
   ارجع ن * مضروب(ن - 1)
نهاية

اطبع_سطر("مضروب 5: " + مضروب(5))
اطبع_سطر("مضروب 7: " + مضروب(7))

# === اختبار 5: دوال متعددة المعاملات ===
دالة قوة(ق، ل)
   إذا (ل == 0)
      ارجع 1
   نهاية
   ارجع ق * قوة(ق، ل - 1)
نهاية

اطبع_سطر("2^10: " + قوة(2، 10))
اطبع_سطر("3^4: " + قوة(3، 4))

# === اختبار 6: النصوص ===
متغير اسم = "لغة ص"
متغير تحية = "مرحباً من " + اسم
اطبع_سطر(تحية)

# === اختبار 7: العمليات المركبة ===
متغير نتيجة = (س + ع) * 2 - 5
اطبع_سطر("العملية المركبة: " + نتيجة)

# === اختبار 8: حلقة تضمينية مع شرط ===
متغير عداد_زوجي = 0
متغير ي = 1
بينما (ي <= 10)
   إذا (ي % 2 == 0)
      عداد_زوجي = عداد_زوجي + 1
   نهاية
   ي = ي + 1
نهاية
اطبع_سطر("عدد الأزواج من 1-10: " + عداد_زوجي)

# === اختبار 9: فيبوناتشي ===
دالة فيبوناتشي(ن)
   إذا (ن <= 0)
      ارجع 0
   نهاية
   إذا (ن == 1)
      ارجع 1
   نهاية
   ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

اطبع_سطر("فيبوناتشي 10: " + فيبوناتشي(10))

