# اختبار فهرسة النصوص وعامل "في"

# اختبار 1: فهرسة نص إنجليزي
متغير نص1 = "hello"
اطبع("اختبار 1 - نص[0]:")
اطبع(نص1[0])

# اختبار 2: فهرسة نص عربي
متغير نص2 = "مرحبا"
اطبع("اختبار 2 - نص عربي[0]:")
اطبع(نص2[0])

# اختبار 3: فهرسة سالبة
اطبع("اختبار 3 - نص[-1]:")
اطبع(نص1[-1])

# اختبار 4: آخر حرف عربي
اطبع("اختبار 4 - نص عربي[-1]:")
اطبع(نص2[-1])

# اختبار 5: عامل في مع مصفوفة
متغير أرقام = [1، 2، 3، 4، 5]
اطبع("اختبار 5 - 3 في مصفوفة:")
اطبع(3 في أرقام)

# اختبار 6: عامل في - غير موجود
اطبع("اختبار 6 - 10 في مصفوفة:")
اطبع(10 في أرقام)

# اختبار 7: عامل في مع خريطة
متغير خ = {"اسم": "أحمد"، "عمر": 25}
اطبع("اختبار 7 - مفتاح في خريطة:")
اطبع("اسم" في خ)

# اختبار 8: عامل في مع نص
متغير جملة = "مرحبا بالعالم"
اطبع("اختبار 8 - نص في نص:")
اطبع("بال" في جملة)
