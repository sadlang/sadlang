من شبكة استورد *

متغير نجاح = 0
متغير فشل = 0

دالة تحقق(الاسم، الشرط)
    إذا (الشرط)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم)
    نهاية
نهاية

اطبع_سطر("=== اختبارات وحدة الشبكة (Network Stack) ===")
اطبع_سطر("")

# 1. مسح البطاقات
متغير عدد_مسح = net_scan()
تحقق("مسح البطاقات يعيد عدد > 0", عدد_مسح > 0)

# 2. عدد البطاقات
متغير عدد = net_nic_count()
تحقق("عدد البطاقات == 2", عدد == 2)

# 3. موديل البطاقة 0
متغير موديل = net_nic_model(0)
تحقق("موديل البطاقة 0 ليس فارغ", موديل != "")

# 4. مورد البطاقة
متغير مورد = net_nic_vendor(0)
تحقق("مورد البطاقة ليس فارغ", مورد != "")

# 5. تهيئة البطاقة
متغير تهيئة = net_init(0)
تحقق("تهيئة البطاقة ناجحة", تهيئة == 0)

# 6. تعيين IP
متغير ip_set = net_set_ip(0, "192.168.1.100")
تحقق("تعيين IP ناجح", ip_set == 0)

# 7. قراءة IP
متغير ip = net_get_ip(0)
تحقق("قراءة IP = 192.168.1.100", ip == "192.168.1.100")

# 8. عنوان MAC
متغير mac = net_get_mac(0)
تحقق("عنوان MAC ليس فارغ", mac != "")

# 9. تعيين قناع الشبكة
متغير subnet = net_set_subnet(0, "255.255.255.0")
تحقق("تعيين قناع الشبكة ناجح", subnet == 0)

# 10. قراءة قناع الشبكة
متغير قناع = net_get_subnet(0)
تحقق("قناع الشبكة = 255.255.255.0", قناع == "255.255.255.0")

# 11. تعيين البوابة
متغير gw = net_set_gateway(0, "192.168.1.1")
تحقق("تعيين البوابة ناجح", gw == 0)

# 12. قراءة البوابة
متغير بوابة = net_get_gateway(0)
تحقق("البوابة = 192.168.1.1", بوابة == "192.168.1.1")

# 13. طلب ARP
متغير arp = net_arp_request(0, "192.168.1.1")
تحقق("طلب ARP يعيد MAC", arp != "")

# 14. بحث ARP
متغير arp2 = net_arp_lookup("192.168.1.1")
تحقق("بحث ARP يعمل", arp2 == "" || arp2 != "")

# 15. حجم جدول ARP
متغير arp_size = net_arp_table_size(0)
تحقق("جدول ARP > 0", arp_size > 0)

# 16. مسح جدول ARP
متغير مسح_arp = net_arp_clear(0)
تحقق("مسح جدول ARP ناجح", مسح_arp >= 0)

# 17. بينغ
متغير ping_r = net_ping(0, "192.168.1.1")
تحقق("بينغ يعيد زمن > 0", ping_r >= 0)

# 18. آخر بينغ
متغير آخر = net_last_ping(0)
تحقق("آخر بينغ >= 0", آخر >= 0)

# 19. ربط UDP
متغير ربط = net_udp_bind(0, 8080)
تحقق("ربط UDP ناجح", ربط == 0)

# 20. إرسال UDP
متغير ارسال = net_udp_send(0, "192.168.1.1", 80, 8080, "مرحبا")
تحقق("إرسال UDP ناجح", ارسال > 0)

# 21. استقبال UDP
متغير استقبال = net_udp_receive(0, 8080)
تحقق("استقبال UDP يعمل", استقبال != "خطأ")

# 22. إلغاء ربط UDP
متغير الغاء = net_udp_unbind(0, 8080)
تحقق("إلغاء ربط UDP ناجح", الغاء == 0)

# 23. حالة الاتصال
متغير رابط = net_link_up(0)
تحقق("حالة الاتصال (link up)", رابط == 0 || رابط == 1)

# 24. سرعة الاتصال
متغير سرعة = net_link_speed(0)
تحقق("سرعة الاتصال > 0", سرعة > 0)

# 25. إرسال خام
متغير خام = net_send_raw(0, "AABBCCDD")
تحقق("إرسال خام ناجح", خام >= 0)

# 26. عداد حزم الإرسال
متغير tx = net_tx_packets(0)
تحقق("عداد حزم الإرسال >= 0", tx >= 0)

# 27. عداد حزم الاستقبال
متغير rx = net_rx_packets(0)
تحقق("عداد حزم الاستقبال >= 0", rx >= 0)

# 28. حالة البطاقة
متغير nic_st = net_nic_state(0)
تحقق("حالة البطاقة >= 0", nic_st >= 0)

# 29. تقرير الشبكة
متغير تقرير = net_report()
تحقق("تقرير الشبكة ليس فارغ", تقرير != "")

# 30. إعادة تعيين
net_reset()
متغير بعد = net_nic_count()
تحقق("إعادة التعيين تعمل", بعد == 0)

اطبع_سطر("")
اطبع_سطر("=== النتيجة: " + نجاح + " نجاح، " + فشل + " فشل من 30 ===")
