# ═══════════════════════════════════════════════════════
# اختبار مزخرفات الأصناف (Class Decorators)
# ═══════════════════════════════════════════════════════

متغير نتائج_الاختبار = 0
متغير إجمالي_الاختبارات = 3

# ─── اختبار 1: مزخرف بسيط للصنف ───
# دالة مزخرف تستقبل اسم الصنف وتطبع رسالة
دالة مسجل(اسم_الصنف)
    اطبع_سطر("تم تسجيل الصنف: " + اسم_الصنف)
    ارجع اسم_الصنف
نهاية

@مسجل
صنف حيوان
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية

    دالة صوت()
        ارجع هذا.الاسم + " يصدر صوتاً"
    نهاية
نهاية

متغير ح = جديد حيوان("قطة")
إذا (ح.صوت() == "قطة يصدر صوتاً")
    اطبع_سطر("✅ اختبار 1 نجح: مزخرف بسيط للصنف")
    نتائج_الاختبار = نتائج_الاختبار + 1
وإلا
    اطبع_سطر("❌ اختبار 1 فشل: مزخرف بسيط للصنف - النتيجة: " + ح.صوت())
نهاية

# ─── اختبار 2: مزخرف يضيف سلوكاً ───
متغير أصناف_مسجلة = []

دالة تتبع(اسم_الصنف)
    أصناف_مسجلة = أصناف_مسجلة + [اسم_الصنف]
    ارجع اسم_الصنف
نهاية

@تتبع
صنف سيارة
    باني(الموديل)
        هذا.الموديل = الموديل
    نهاية
نهاية

@تتبع
صنف دراجة
    باني(النوع)
        هذا.النوع = النوع
    نهاية
نهاية

إذا (طول(أصناف_مسجلة) == 2)
    اطبع_سطر("✅ اختبار 2 نجح: تتبع الأصناف المسجلة (" + طول(أصناف_مسجلة) + " أصناف)")
    نتائج_الاختبار = نتائج_الاختبار + 1
وإلا
    اطبع_سطر("❌ اختبار 2 فشل: تتبع الأصناف - العدد: " + طول(أصناف_مسجلة))
نهاية

# ─── اختبار 3: مزخرف مع وسائط ───
دالة إصدار(اسم_الصنف، رقم_الإصدار)
    اطبع_سطر("الصنف " + اسم_الصنف + " الإصدار: " + رقم_الإصدار)
    ارجع اسم_الصنف
نهاية

@إصدار("2.0")
صنف تطبيق
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية
نهاية

متغير ت = جديد تطبيق("تطبيقي")
إذا (ت.الاسم == "تطبيقي")
    اطبع_سطر("✅ اختبار 3 نجح: مزخرف مع وسائط")
    نتائج_الاختبار = نتائج_الاختبار + 1
وإلا
    اطبع_سطر("❌ اختبار 3 فشل")
نهاية

# ═══════════════════════════════════════════════════════
اطبع_سطر("═══════════════════════════════════════")
اطبع_سطر("نتيجة اختبار مزخرفات الأصناف: " + نتائج_الاختبار + "/" + إجمالي_الاختبارات)
اطبع_سطر("═══════════════════════════════════════")
