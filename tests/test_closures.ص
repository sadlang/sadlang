# اختبار الإغلاقات (Closures)

# 1. إغلاق بسيط - التقاط متغير خارجي
متغير قاعدة = 10
متغير أضف_قاعدة = لامدا س: س + قاعدة
اطبع_سطر("أضف_قاعدة(5) = " + أضف_قاعدة(5))

# 2. دالة تُرجع لامدا
دالة صانع_جمع(ن)
    ارجع لامدا س: س + ن
نهاية

متغير أضف3 = صانع_جمع(3)
متغير أضف7 = صانع_جمع(7)
اطبع_سطر("أضف3(10) = " + أضف3(10))
اطبع_سطر("أضف7(10) = " + أضف7(10))
