# =============================================================
# اختبار شامل وكامل للبرمجة الكائنية
# =============================================================
# يختبر: صنف، باني، حقول، دوال، وراثة، أساس()، عامل، طباعة
# =============================================================

# ═══════════════════════════════════════════════════════
# 1. صنف بسيط مع باني ودوال
# ═══════════════════════════════════════════════════════

صنف حيوان
    نص الاسم
    رقم العمر

    باني(نص اسم، رقم عمر)
        الاسم = اسم
        العمر = عمر
    نهاية

    دالة عرض()
        اطبع(الاسم)
        اطبع(" (عمر: ")
        اطبع(العمر)
        اطبع_سطر(")")
    نهاية

    دالة نص النوع()
        ارجع "حيوان"
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# 2. وراثة + استدعاء باني الأب
# ═══════════════════════════════════════════════════════

صنف قط يرث حيوان
    رقم الارجل

    باني(نص اسم، رقم عمر، رقم ارجل)
        أساس(اسم، عمر)
        الارجل = ارجل
    نهاية

    دالة مياو()
        اطبع(الاسم)
        اطبع_سطر(": مياو!")
    نهاية

    دالة نص النوع()
        ارجع "قط"
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# 3. وراثة متعددة المستويات
# ═══════════════════════════════════════════════════════

صنف قط_فارسي يرث قط
    نص اللون

    باني(نص اسم، رقم عمر، نص لون)
        أساس(اسم، عمر، 4)
        اللون = لون
    نهاية

    دالة وصف()
        اطبع("قط فارسي ")
        اطبع(اللون)
        اطبع(" اسمه ")
        اطبع(الاسم)
        اطبع(" عمره ")
        اطبع_سطر(العمر)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# 4. صنف مع عامل محمل زائداً
# ═══════════════════════════════════════════════════════

صنف متجه
    رقم س
    رقم ص

    باني(رقم قس، رقم قص)
        س = قس
        ص = قص
    نهاية

    دالة عرض()
        اطبع("(")
        اطبع(س)
        اطبع("، ")
        اطبع(ص)
        اطبع(")")
    نهاية

    عامل +(اخر)
        متغير نتيجة = جديد متجه(س + اخر.س، ص + اخر.ص)
        ارجع نتيجة
    نهاية

    عامل ==(اخر)
        اذا (س == اخر.س)
            اذا (ص == اخر.ص)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# 5. صنف عداد مع دوال متعددة
# ═══════════════════════════════════════════════════════

صنف عداد
    رقم القيمة

    باني(رقم بداية)
        القيمة = بداية
    نهاية

    دالة زيادة()
        القيمة = القيمة + 1
    نهاية

    دالة نقصان()
        القيمة = القيمة - 1
    نهاية

    دالة رقم الحالي()
        ارجع القيمة
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# 6. صنف حساب بنكي
# ═══════════════════════════════════════════════════════

صنف حساب
    نص المالك
    رقم الرصيد

    باني(نص مالك، رقم رصيد)
        المالك = مالك
        الرصيد = رصيد
    نهاية

    دالة ايداع(رقم مبلغ)
        الرصيد = الرصيد + مبلغ
    نهاية

    دالة سحب(رقم مبلغ)
        اذا (مبلغ <= الرصيد)
            الرصيد = الرصيد - مبلغ
        نهاية
    نهاية

    دالة رقم الحالي()
        ارجع الرصيد
    نهاية
نهاية

