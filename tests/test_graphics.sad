# اختبار مكتبة الرسومات / Graphics Library Test
# نختبر أن الدوال مسجلة ويمكن استدعاؤها

اطبع("=== اختبار مكتبة الرسومات ===")

# اختبار إنشاء نافذة
متغير نافذة = نافذة_جديد("اختبار الرسومات", 800, 600)
اطبع("معرف النافذة: " + نافذة)

# اختبار الحصول على أبعاد النافذة
متغير عرض = نافذة_العرض(نافذة)
متغير ارتفاع = نافذة_الارتفاع(نافذة)
اطبع("العرض: " + عرض)
اطبع("الارتفاع: " + ارتفاع)

# اختبار إنشاء رسام
متغير رسام = رسام_ثنائي_جديد(نافذة)
اطبع("معرف الرسام: " + رسام)

# اختبار الوقت
متغير وقت = الوقت_الحالي()
اطبع("الوقت: " + وقت)

# إغلاق النافذة
نافذة_إغلاق(نافذة)
اطبع("تم إغلاق النافذة بنجاح")

اطبع("=== انتهى الاختبار بنجاح ===")