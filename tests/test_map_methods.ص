# اختبار دوال الخريطة (Map methods)

# اختبار 1: إنشاء خريطة والحصول على الحجم
متغير خ = {"اسم": "أحمد"، "عمر": 25، "مدينة": "الرياض"}
اطبع("اختبار 1 - الحجم:")
اطبع(خ.الحجم())

# اختبار 2: المفاتيح
اطبع("اختبار 2 - المفاتيح:")
متغير م = خ.مفاتيح()
اطبع(م.الطول())

# اختبار 3: القيم
اطبع("اختبار 3 - القيم:")
متغير ق = خ.القيم()
اطبع(ق.الطول())

# اختبار 4: يحتوي على مفتاح
اطبع("اختبار 4 - يحتوي:")
اطبع(خ.يحتوي("اسم"))
اطبع(خ.يحتوي("هاتف"))

# اختبار 5: فارغة
اطبع("اختبار 5 - فارغة:")
اطبع(خ.فارغة())

# اختبار 6: نسخ
متغير خ2 = خ.نسخ()
اطبع("اختبار 6 - نسخ (حجم النسخة):")
اطبع(خ2.الحجم())

# اختبار 7: دمج
متغير إضافي = {"هاتف": "0500000000"، "بريد": "a@b.com"}
خ.دمج(إضافي)
اطبع("اختبار 7 - دمج (الحجم بعد الدمج):")
اطبع(خ.الحجم())

# اختبار 8: حذف مفتاح
خ.احذف("بريد")
اطبع("اختبار 8 - حذف (الحجم بعد الحذف):")
اطبع(خ.الحجم())

# اختبار 9: عناصر (entries)
متغير بيانات = {"أ": 1، "ب": 2}
متغير عناصر = بيانات.عناصر()
اطبع("اختبار 9 - عناصر:")
اطبع(عناصر.الطول())

# اختبار 10: امسح
بيانات.امسح()
اطبع("اختبار 10 - امسح:")
اطبع(بيانات.فارغة())
