// اختبار الـ Generics (القوالب)
// =================================

// صنف قالب: صندوق<ن>
قالب<نوع ن> صنف صندوق
    خاصية ن القيمة
    
    باني(ن قيمة_أولية)
        هذا.القيمة = قيمة_أولية
    نهاية
    
    دالة احصل() ن
        ارجع هذا.القيمة
    نهاية
    
    دالة ضع(ن قيمة_جديدة)
        هذا.القيمة = قيمة_جديدة
    نهاية
نهاية

// دالة قالب: أكبر<ن>
قالب<نوع ن> دالة أكبر(ن أ ن ب) ن
    إذا (أ > ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

// الدالة الرئيسية
دالة رئيسية()
    // اختبار صنف القالب
    متغير صندوق_رقم = جديد صندوق<رقم>(42)
    اطبع("قيمة صندوق الرقم: " + صندوق_رقم.احصل())
    
    متغير صندوق_نص = جديد صندوق<نص>("مرحبا بالقوالب!")
    اطبع("قيمة صندوق النص: " + صندوق_نص.احصل())
    
    // اختبار دالة القالب
    متغير أ = 10
    متغير ب = 25
    اطبع("الأكبر بين " + أ + " و " + ب + " هو: " + أكبر<رقم>(أ ب))
    
    اطبع("نجاح اختبار القوالب!")
نهاية
