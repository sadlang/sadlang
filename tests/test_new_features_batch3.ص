# اختبار ميزات المترجم والمفسر — الدفعة الثالثة
# Test compiler/interpreter features — Batch 3

# ============================================================
# 1. صنف كامل مع باني ودوال (ClassDeclStmt)
# ============================================================
صنف شخص
    باني(اسم, عمر)
        هذا.اسم = اسم
        هذا.عمر = عمر
    نهاية

    دالة تعريف()
        ارجع "أنا " + هذا.اسم + " عمري " + هذا.عمر
    نهاية
نهاية

متغير ش = جديد شخص("خالد", 30)
اطبع_سطر("1. صنف: " + ش.تعريف())

# ============================================================
# 2. مصفوفة وعمليات عليها (Array operations)
# ============================================================
متغير ارقام = [10, 20, 30, 40, 50]
اطبع_سطر("2. مصفوفة: " + ارقام)
اطبع_سطر("2. العنصر الثاني: " + ارقام[1])

# ============================================================
# 3. خريطة / قاموس (MapExpr)
# ============================================================
متغير قاموس = {"مفتاح1": "قيمة1", "مفتاح2": 42}
اطبع_سطر("3. قاموس: " + قاموس)

# ============================================================
# 4. تعبير ثلاثي (TernaryExpr)
# ============================================================
متغير ع = 15
متغير حالة_العدد = (ع > 10) ? "كبير" : "صغير"
اطبع_سطر("4. ثلاثي: " + حالة_العدد)

# ============================================================
# 5. إسناد عضو (MemberAssignExpr)
# ============================================================
ش.عمر = 31
اطبع_سطر("5. تعيين عضو: عمر = " + ش.عمر)

# ============================================================
# 6. حالة/switch (SwitchStmt)
# ============================================================
متغير ر = 2
حالة (ر)
    عندما 1:
        اطبع_سطر("6. واحد")
    عندما 2:
        اطبع_سطر("6. اثنان")
    عندما 3:
        اطبع_سطر("6. ثلاثة")
    افتراضي:
        اطبع_سطر("6. آخر")
نهاية

# ============================================================
# 7. حاول / امسك / أخيراً (TryStmt)
# ============================================================
حاول
    متغير نتيجة = 100 / 2
    اطبع_سطر("7. حاول: " + نتيجة)
امسك (ع)
    اطبع_سطر("7. خطأ: " + ع)
نهاية

# ============================================================
# 8. دالة مع قيم افتراضية (Default params)
# ============================================================
دالة مرحبا(اسم, تحية = "أهلاً")
    ارجع تحية + " يا " + اسم
نهاية
اطبع_سطر("8. افتراضي: " + مرحبا("سارة"))
اطبع_سطر("8. مخصص: " + مرحبا("أحمد", "مرحباً"))

# ============================================================
# 9. لامبدا (LambdaExpr)
# ============================================================
# ملاحظة: دالة مجهولة تقليدية
دالة مضاعف_دالة(ن)
    ارجع ن * 2
نهاية
اطبع_سطر("9. دالة: " + مضاعف_دالة(7))

# ============================================================
# 10. نطاق (RangeExpr) مع حلقة لكل
# ============================================================
متغير مجموع = 0
لكل ي في [1, 2, 3, 4, 5]
    مجموع = مجموع + ي
نهاية
اطبع_سطر("10. مجموع: " + مجموع)

# ============================================================
# 11. فهرس وإسناد فهرس (IndexExpr + IndexAssignExpr)
# ============================================================
متغير قائمة = [10, 20, 30]
قائمة[1] = 99
اطبع_سطر("11. فهرس: " + قائمة)

# ============================================================
# 12. العامل في (InExpr)
# ============================================================
متغير فواكه = ["تفاح", "برتقال", "موز"]
إذا ("برتقال" في فواكه)
    اطبع_سطر("12. موجود: برتقال في القائمة")
نهاية

# ============================================================
# 13. عمليات بتية (Bitwise)
# ============================================================
متغير أ = 12
متغير ب = 10
اطبع_سطر("13. بت NOT: " + (~أ))

# ============================================================
# 14. وراثة صنف (ClassDecl with parent)
# ============================================================
صنف موظف يرث شخص
    باني(اسم, عمر, وظيفة)
        أساس(اسم, عمر)
        هذا.وظيفة = وظيفة
    نهاية

    دالة وصف()
        ارجع هذا.تعريف() + " وأعمل " + هذا.وظيفة
    نهاية
نهاية

متغير م = جديد موظف("فاطمة", 28, "مهندسة")
اطبع_سطر("14. وراثة: " + م.وصف())

# ============================================================
# 15. حلقة بينما (WhileStmt)
# ============================================================
متغير عداد = 0
متغير نتيجة_بينما = ""
بينما (عداد < 5)
    نتيجة_بينما = نتيجة_بينما + عداد + " "
    عداد = عداد + 1
نهاية
اطبع_سطر("15. بينما: " + نتيجة_بينما)

# ============================================================
# ملخص النتائج
# ============================================================
اطبع_سطر("============================")
اطبع_سطر("اكتملت جميع الاختبارات بنجاح!")
اطبع_سطر("============================")
