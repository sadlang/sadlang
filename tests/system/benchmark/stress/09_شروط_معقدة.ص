# اختبار 09: الشروط المعقدة
# ═══════════════════════════════════

# إذا بسيط
متغير س = 15
إذا (س > 10)
   اطبع("أكبر_من_10")
نهاية

# إذا / وإلا
إذا (س > 20)
   اطبع("أكبر_من_20")
وإلا
   اطبع("أصغر_أو_يساوي_20")
نهاية

# والا_اذا
متغير درجة = 85
إذا (درجة >= 90)
   اطبع("ممتاز")
والا_اذا (درجة >= 80)
   اطبع("جيد_جداً")
والا_اذا (درجة >= 70)
   اطبع("جيد")
وإلا
   اطبع("مقبول")
نهاية

# شروط منطقية مركبة
متغير عمر = 25
متغير دخل = 5000
إذا (عمر >= 18 && دخل >= 3000)
   اطبع("مؤهل_للقرض")
نهاية

إذا (عمر < 18 || دخل < 1000)
   اطبع("غير_مؤهل")
وإلا
   اطبع("مؤهل")
نهاية

# شروط متداخلة
متغير الصنف = "طالب"
متغير معدل = 3.5
إذا (الصنف == "طالب")
   إذا (معدل >= 3.0)
      اطبع("طالب_متفوق")
   وإلا
      اطبع("طالب_عادي")
   نهاية
وإلا
   اطبع("ليس_طالب")
نهاية

# العامل الثلاثي
متغير الحالة = س > 10 ؟ "كبير" : "صغير"
اطبع("حالة=" + الحالة)

# النفي
إذا (!(س < 5))
   اطبع("ليس_أصغر_من_5")
نهاية

# المقارنات مع النصوص
متغير لغة = "عربي"
إذا (لغة == "عربي")
   اطبع("مرحباً")
والا_اذا (لغة == "إنجليزي")
   اطبع("Hello")
نهاية
