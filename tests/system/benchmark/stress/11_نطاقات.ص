# اختبار 11: النطاقات والمتغيرات
# ═══════════════════════════════════

# متغير عام
متغير عالمي = "عام"
اطبع("عام=" + عالمي)

# نطاق داخلي
إذا (صحيح)
   متغير داخلي = "داخل_إذا"
   اطبع("داخلي=" + داخلي)
   اطبع("عام_داخل=" + عالمي)
نهاية

# تعديل متغير عام من داخل
متغير عداد = 0
لكل ع في [1، 2، 3]
   عداد = عداد + ع
نهاية
اطبع("عداد=" + عداد)

# المتغيرات في الدوال
دالة اختبار_نطاق()
   متغير محلي = "محلي"
   اطبع("محلي_داخل=" + محلي)
   ارجع محلي
نهاية
اطبع("نتيجة=" + اختبار_نطاق())

# تداخل الدوال مع النطاقات
دالة خارجية()
   متغير خ = 10
   
   دالة داخلية()
      ارجع خ * 2
   نهاية
   
   ارجع داخلية()
نهاية
اطبع("تداخل=" + خارجية())

