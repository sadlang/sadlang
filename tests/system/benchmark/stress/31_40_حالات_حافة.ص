# 36: العامل الثلاثي مع دالة
دالة حالة_رقم(ن)
   ارجع ن > 0 ? "موجب" : (ن < 0 ? "سالب" : "صفر")
نهاية
اطبع("5=" + حالة_رقم(5))
اطبع("-3=" + حالة_رقم(-3))
اطبع("0=" + حالة_رقم(0))

# 37: مصفوفة من دوال (دالة ذات اسم)
دالة جمع(أ، ب)
   ارجع أ + ب
نهاية
دالة ضرب(أ، ب)
   ارجع أ * ب
نهاية

متغير عمليات = [جمع، ضرب]
اطبع("عملية0=" + عمليات[0](3، 4))
اطبع("عملية1=" + عمليات[1](3، 4))

# 38: دالة مع عدة ارجع
دالة تصنيف_عمر(عمر)
   إذا (عمر < 13)
      ارجع "طفل"
   نهاية
   إذا (عمر < 20)
      ارجع "مراهق"
   نهاية
   إذا (عمر < 60)
      ارجع "بالغ"
   نهاية
   ارجع "كبير"
نهاية
اطبع("5=" + تصنيف_عمر(5))
اطبع("15=" + تصنيف_عمر(15))
اطبع("30=" + تصنيف_عمر(30))
اطبع("70=" + تصنيف_عمر(70))

# 39: النص كمفتاح ديناميكي
