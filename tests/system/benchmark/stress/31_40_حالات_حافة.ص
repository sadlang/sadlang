# 40: بينما مع تعبير معقد
متغير نتيجة = 1
متغير عداد = 1
بينما (عداد <= 5 && نتيجة < 100)
   نتيجة = نتيجة * عداد
   عداد = عداد + 1
نهاية
اطبع("مضروب=" + نتيجة)
