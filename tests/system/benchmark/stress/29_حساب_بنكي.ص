# اختبار 29: كائنات مع دوال مساعدة
صنف حساب_بنكي
   باني(صاحب، رصيد)
      هذا.صاحب = صاحب
      هذا.رصيد = رصيد
      هذا.سجل = []
   نهاية
   
   دالة إيداع(مبلغ)
      هذا.رصيد = هذا.رصيد + مبلغ
      هذا.سجل.أضف("إيداع: " + مبلغ)
   نهاية
   
   دالة سحب(مبلغ)
      إذا (مبلغ > هذا.رصيد)
         اطبع("رصيد غير كافي")
         ارجع خطأ
      نهاية
      هذا.رصيد = هذا.رصيد - مبلغ
      هذا.سجل.أضف("سحب: " + مبلغ)
      ارجع صحيح
   نهاية
   
   دالة الرصيد()
      ارجع هذا.رصيد
   نهاية
   
   دالة عدد_العمليات()
      ارجع هذا.سجل.الطول()
   نهاية
نهاية

متغير حسابي = جديد حساب_بنكي("أحمد"، 1000)
حسابي.إيداع(500)
اطبع("رصيد1=" + حسابي.الرصيد())
حسابي.سحب(200)
اطبع("رصيد2=" + حسابي.الرصيد())
حسابي.سحب(2000)
اطبع("عمليات=" + حسابي.عدد_العمليات())
