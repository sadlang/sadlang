# 87: تجميع حسب (group by)
دالة جمّع(مصف)
   متغير مجموعات = {}
   لكل ع في مصف
      متغير مفتاح = ع % 2 == 0 ؟ "زوجي" : "فردي"
      إذا (مجموعات[مفتاح] == لاشيء)
         مجموعات[مفتاح] = []
      نهاية
      مجموعات[مفتاح].أضف(ع)
   نهاية
   ارجع مجموعات
نهاية

متغير أرقام = [1، 2، 3، 4، 5، 6، 7، 8]
متغير مجموعات = جمّع(أرقام)
اطبع("زوجي_عدد=" + مجموعات["زوجي"].الطول())
اطبع("فردي_عدد=" + مجموعات["فردي"].الطول())
