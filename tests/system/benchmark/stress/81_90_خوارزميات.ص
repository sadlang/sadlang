# 81: بحث ثنائي
دالة بحث_ثنائي(مصف، هدف)
   متغير يسار = 0
   متغير يمين = مصف.الطول() - 1
   
   بينما (يسار <= يمين)
      متغير وسط = إلى_رقم((يسار + يمين) / 2)
      # تأكد أن الوسط عدد صحيح
      إذا (مصف[وسط] == هدف)
         ارجع وسط
      والا_اذا (مصف[وسط] < هدف)
         يسار = وسط + 1
      وإلا
         يمين = وسط - 1
      نهاية
   نهاية
   ارجع -1
نهاية

متغير مرتبة = [2، 5، 8، 12، 16، 23، 38، 45، 67، 78]
اطبع("بحث_23=" + بحث_ثنائي(مرتبة، 23))
اطبع("بحث_100=" + بحث_ثنائي(مرتبة، 100))

# 82: عكس نص
دالة اعكس_نص(نصي)
   متغير نتيجة = ""
   متغير ع = نصي.الطول() - 1
   بينما (ع >= 0)
      نتيجة = نتيجة + نصي[ع]
      ع = ع - 1
   نهاية
   ارجع نتيجة
نهاية
اطبع("عكس_hello=" + اعكس_نص("hello"))

# 83: عد التكرارات
دالة عد_تكرار(مصف، قيمة)
   متغير عدد = 0
   لكل ع في مصف
      إذا (ع == قيمة)
         عدد = عدد + 1
      نهاية
   نهاية
   ارجع عدد
نهاية

متغير بيانات = [1، 2، 3، 2، 4، 2، 5، 2]
اطبع("تكرار_2=" + عد_تكرار(بيانات، 2))

# 84: دمج مصفوفتين مرتبتين
دالة ادمج(أ، ب)
   متغير نتيجة = []
   متغير ع_أ = 0
   متغير ع_ب = 0
   
   بينما (ع_أ < أ.الطول() && ع_ب < ب.الطول())
      إذا (أ[ع_أ] <= ب[ع_ب])
         نتيجة.أضف(أ[ع_أ])
         ع_أ = ع_أ + 1
      وإلا
         نتيجة.أضف(ب[ع_ب])
         ع_ب = ع_ب + 1
      نهاية
   نهاية
   
   بينما (ع_أ < أ.الطول())
      نتيجة.أضف(أ[ع_أ])
      ع_أ = ع_أ + 1
   نهاية
   
   بينما (ع_ب < ب.الطول())
      نتيجة.أضف(ب[ع_ب])
      ع_ب = ع_ب + 1
   نهاية
   
   ارجع نتيجة
نهاية

متغير مدموج = ادمج([1، 3، 5، 7]، [2، 4، 6، 8])
اطبع("مدموج_طول=" + مدموج.الطول())
اطبع("مدموج_أول=" + مدموج[0])
اطبع("مدموج_آخر=" + مدموج[7])

# 85: حساب المسافة
دالة مسافة(س1، ص1، س2، ص2)
   متغير فرق_س = س2 - س1
   متغير فرق_ص = ص2 - ص1
   ارجع (فرق_س ** 2 + فرق_ص ** 2) ** 0.5
نهاية
اطبع("مسافة=" + مسافة(0، 0، 3، 4))

