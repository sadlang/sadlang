# خريطة من كائنات
صنف منتج
   باني(الاسم، السعر)
      هذا.الاسم = الاسم
      هذا.السعر = السعر
   نهاية
نهاية

متغير متجر = {}
متجر["تفاح"] = جديد منتج("تفاح أخضر"، 5)
متجر["برتقال"] = جديد منتج("برتقال"، 3)
