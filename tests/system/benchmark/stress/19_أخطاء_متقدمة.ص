# حاول متسلسل
دالة قسمة_آمنة(أ، ب)
   حاول
      إذا (ب == 0)
         ألقِ "لا يمكن القسمة على صفر"
      نهاية
      ارجع أ / ب
   امسك (خ)
      اطبع("خطأ_قسمة: " + خ)
      ارجع 0
   نهاية
نهاية

اطبع("10/2=" + قسمة_آمنة(10، 2))
اطبع("10/0=" + قسمة_آمنة(10، 0))

# تسلسل أخطاء
دالة عملية_خطيرة(مستوى)
   حاول
      إذا (مستوى > 2)
         ألقِ "مستوى خطير: " + مستوى
      نهاية
      اطبع("مستوى_آمن=" + مستوى)
   امسك (خ)
      اطبع("تم_المسك=" + خ)
   أخيراً
      اطبع("تنظيف_مستوى=" + مستوى)
   نهاية
نهاية

