# اختبار 12: الأصناف المعقدة
# ═══════════════════════════════════

# صنف مع عدة دوال
صنف مكدس
   باني()
      هذا.عناصر = []
      هذا.الحجم = 0
   نهاية
   
   دالة ادفع(قيمة)
      هذا.عناصر.أضف(قيمة)
      هذا.الحجم = هذا.الحجم + 1
   نهاية
   
   دالة اسحب()
      إذا (هذا.الحجم == 0)
         ارجع عدم
      نهاية
      هذا.الحجم = هذا.الحجم - 1
      ارجع هذا.عناصر[هذا.الحجم]
   نهاية
   
   دالة القمة()
      إذا (هذا.الحجم == 0)
         ارجع عدم
      نهاية
      ارجع هذا.عناصر[هذا.الحجم - 1]
   نهاية
   
   دالة فارغ()
      ارجع هذا.الحجم == 0
   نهاية
نهاية

متغير م = جديد مكدس()
م.ادفع(10)
م.ادفع(20)
م.ادفع(30)
اطبع("حجم=" + م.الحجم)
اطبع("قمة=" + م.القمة())
اطبع("سحب=" + م.اسحب())
اطبع("حجم_بعد=" + م.الحجم)

# صنف طابور
صنف طابور
   باني()
      هذا.بيانات = []
   نهاية
   
   دالة أضف(قيمة)
      هذا.بيانات.أضف(قيمة)
   نهاية
   
   دالة أزل()
      إذا (هذا.بيانات.الطول() == 0)
         ارجع عدم
      نهاية
      متغير أول = هذا.بيانات[0]
      هذا.بيانات.احذف(0)
      ارجع أول
   نهاية
   
   دالة الطول()
      ارجع هذا.بيانات.الطول()
   نهاية
نهاية

متغير ط = جديد طابور()
ط.أضف("أ")
ط.أضف("ب")
ط.أضف("ج")
اطبع("طابور_طول=" + ط.الطول())
اطبع("أزل=" + ط.أزل())
اطبع("طابور_بعد=" + ط.الطول())
