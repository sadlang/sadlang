# اختبار 14: حالة (switch)
# ═══════════════════════════════════

# حالة بسيطة
متغير يوم = 3
حالة (يوم)
   عندما 1
      اطبع("السبت")
   عندما 2
      اطبع("الأحد")
   عندما 3
      اطبع("الاثنين")
   عندما 4
      اطبع("الثلاثاء")
   افتراضي
      اطبع("يوم_آخر")
نهاية

# حالة مع نصوص
متغير لون = "أحمر"
حالة (لون)
   عندما "أحمر"
      اطبع("توقف")
   عندما "أصفر"
      اطبع("استعد")
   عندما "أخضر"
      اطبع("انطلق")
   افتراضي
      اطبع("لون_مجهول")
نهاية

# حالة بدون افتراضي
متغير العدد = 5
حالة (العدد)
   عندما 1
      اطبع("واحد")
   عندما 5
      اطبع("خمسة")
   عندما 10
      اطبع("عشرة")
نهاية

# حالة مع تعبيرات
متغير درجة_حرارة = 35
حالة (صحيح)
   عندما (درجة_حرارة > 40)
      اطبع("حار_جداً")
   عندما (درجة_حرارة > 30)
      اطبع("حار")
   عندما (درجة_حرارة > 20)
      اطبع("معتدل")
   افتراضي
      اطبع("بارد")
نهاية
