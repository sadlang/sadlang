# تعبيرات حسابية معقدة
اطبع("معقد1=" + ((2 + 3) * (4 - 1) / 3))
اطبع("معقد2=" + (2 ** 3 + 4 * 5 - 10 / 2))

# سلسلة عمليات على المتغيرات
متغير أ = 10
متغير ب = أ * 2 + 5
متغير ج = ب - أ + 3
اطبع("أ=" + أ)
اطبع("ب=" + ب)
اطبع("ج=" + ج)

# تعبيرات مع استدعاءات دوال
دالة مربع(ن)
   ارجع ن * ن
نهاية

دالة مكعب(ن)
   ارجع ن * ن * ن
نهاية

اطبع("مربع_مكعب=" + (مربع(3) + مكعب(2)))

# تعبيرات مع وصول المصفوفات
متغير أرقام = [10، 20، 30]
اطبع("مجموع_عناصر=" + (أرقام[0] + أرقام[1] + أرقام[2]))

# تعبيرات مع وصول الخرائط
متغير بيانات = {"س": 5، "ص": 10}
اطبع("مجموع_خريطة=" + (بيانات["س"] + بيانات["ص"]))

# تعبير ثلاثي متداخل
متغير درجة = 85
متغير تقدير = درجة >= 90 ؟ "ممتاز" : (درجة >= 80 ؟ "جيد جداً" : "جيد")
اطبع("تقدير=" + تقدير)

# تعبير مع دمج نصوص معقد
متغير اسم = "أحمد"
متغير عمر = 25
متغير معلومات = "الاسم: " + اسم + "، العمر: " + عمر + "، البالغ: " + (عمر >= 18)
اطبع(معلومات)
