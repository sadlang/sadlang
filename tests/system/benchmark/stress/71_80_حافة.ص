# اختبار 71-80: حالات حافة وأخطاء

# 71: تعبيرات ثلاثية متسلسلة
متغير درجة = 75
متغير حرف = درجة >= 90 ؟ "أ" : (درجة >= 80 ؟ "ب" : (درجة >= 70 ؟ "ج" : "د"))
اطبع("حرف=" + حرف)

# 72: حلقة بعداد كبير
متغير مج = 0
متغير ع = 1
بينما (ع <= 1000)
   مج = مج + ع
   ع = ع + 1
نهاية
اطبع("مجموع_1000=" + مج)

# 73: دالة تعيد مصفوفة من خرائط
دالة أنشئ_جدول()
   متغير جدول = []
   متغير ع = 1
   بينما (ع <= 3)
      جدول.أضف({"رقم": ع، "مربع": ع * ع، "مكعب": ع * ع * ع})
      ع = ع + 1
   نهاية
   ارجع جدول
نهاية

متغير الجدول = أنشئ_جدول()
لكل صف في الجدول
   اطبع("رقم=" + صف["رقم"] + " مربع=" + صف["مربع"] + " مكعب=" + صف["مكعب"])
نهاية

# 74: عمليات نصية مكثفة
متغير محتوى = ""
متغير ع2 = 0
بينما (ع2 < 10)
   محتوى = محتوى + ع2
   ع2 = ع2 + 1
نهاية
اطبع("نص_أرقام=" + محتوى)
اطبع("نص_طول=" + محتوى.الطول())

# 75: متغيرات boolean في شروط معقدة
متغير أ = صحيح
متغير ب = خطأ
متغير ج = صحيح

إذا ((أ && ج) || ب)
   اطبع("شرط1=صحيح")
نهاية

إذا (!(أ && ب))
   اطبع("شرط2=صحيح")
نهاية

إذا ((أ || ب) && (ج || ب))
   اطبع("شرط3=صحيح")
نهاية

# 76: كائن يحتوي كائن
صنف عنوان
   باني(المدينة، الشارع)
      هذا.المدينة = المدينة
      هذا.الشارع = الشارع
   نهاية
نهاية

صنف شخص
   باني(الاسم، عنوان_ش)
      هذا.الاسم = الاسم
      هذا.العنوان = عنوان_ش
   نهاية
نهاية

متغير ع3 = جديد عنوان("الرياض"، "شارع الملك")
متغير ش = جديد شخص("أحمد"، ع3)
اطبع("مدينة=" + ش.العنوان.المدينة)
اطبع("شارع=" + ش.العنوان.الشارع)

# 77: تمرير كائن لدالة
دالة وصف_شخص(شخص)
   ارجع شخص.الاسم + " من " + شخص.العنوان.المدينة
نهاية
اطبع("وصف=" + وصف_شخص(ش))

# 78: تعديل كائن داخل دالة
دالة انقل(شخص، مدينة_جديدة)
   شخص.العنوان.المدينة = مدينة_جديدة
نهاية
انقل(ش، "جدة")
اطبع("مدينة_جديدة=" + ش.العنوان.المدينة)

# 79: مقارنة عدم
متغير قيمة = عدم
إذا (قيمة == عدم)
   اطبع("عدم_صحيح")
نهاية
قيمة = 42
إذا (قيمة != عدم)
   اطبع("ليس_عدم_صحيح")
نهاية

# 80: حلقة لكل مع فهرس يدوي
متغير عناصر = ["أ"، "ب"، "ج"، "د"، "هـ"]
متغير فهرس = 0
لكل ع في عناصر
   اطبع("فهرس[" + فهرس + "]=" + ع)
   فهرس = فهرس + 1
نهاية
