# اختبار 27: سلسلة دوال
دالة أضف_واحد(ن)
   ارجع ن + 1
نهاية

دالة اضرب_اثنين(ن)
   ارجع ن * 2
نهاية

دالة اطرح_ثلاثة(ن)
   ارجع ن - 3
نهاية

# تسلسل استدعاءات
متغير نتيجة = اطرح_ثلاثة(اضرب_اثنين(أضف_واحد(5)))
اطبع("سلسلة=" + نتيجة)

# دالة تستدعي نفسها بشروط
دالة تقريب(ن، هدف)
   إذا (ن == هدف)
      ارجع ن
   والا_اذا (ن < هدف)
      ارجع تقريب(ن + 1، هدف)
   وإلا
      ارجع تقريب(ن - 1، هدف)
   نهاية
نهاية
اطبع("تقريب=" + تقريب(1، 5))

# دوال متبادلة الاستدعاء
دالة زوجي(ن)
   إذا (ن == 0)
      ارجع صحيح
   نهاية
   ارجع فردي(ن - 1)
نهاية

دالة فردي(ن)
   إذا (ن == 0)
      ارجع خطأ
   نهاية
   ارجع زوجي(ن - 1)
نهاية

اطبع("4_زوجي=" + زوجي(4))
اطبع("7_زوجي=" + زوجي(7))
