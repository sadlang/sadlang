# اختبار 30: قائمة مرتبطة
صنف عقدة
   باني(القيمة)
      هذا.القيمة = القيمة
      هذا.التالي = عدم
   نهاية
نهاية

صنف قائمة_مرتبطة
   باني()
      هذا.الرأس = عدم
      هذا.الحجم = 0
   نهاية
   
   دالة أضف_للبداية(قيمة)
      متغير جديدة = جديد عقدة(قيمة)
      جديدة.التالي = هذا.الرأس
      هذا.الرأس = جديدة
      هذا.الحجم = هذا.الحجم + 1
   نهاية
   
   دالة أول()
      إذا (هذا.الرأس == عدم)
         ارجع عدم
      نهاية
      ارجع هذا.الرأس.القيمة
   نهاية
   
   دالة الطول()
      ارجع هذا.الحجم
   نهاية
نهاية

متغير ق = جديد قائمة_مرتبطة()
ق.أضف_للبداية(30)
ق.أضف_للبداية(20)
ق.أضف_للبداية(10)
اطبع("أول=" + ق.أول())
اطبع("حجم=" + ق.الطول())
