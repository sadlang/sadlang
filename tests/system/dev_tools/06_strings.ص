    نص اسم_اول = "لغة"
    نص اسم_ثاني = " ص"
    نص كامل = اسم_اول + اسم_ثاني
    اطبع("الدمج: ")
    اطبع_سطر(كامل)
    
    اطبع_سطر("✅ اختبار النصوص نجح!")
