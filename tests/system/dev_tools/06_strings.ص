استورد نصوص

دالة رئيسية()
    اطبع_سطر("=== عمليات النصوص ===")
    
    # تعريف نصوص
    نص تحية = "مرحباً بالعالم"
    نص اسم = "أحمد محمد"
    
    # طول النص
    اطبع("طول التحية: ")
    اطبع_سطر(طول_نص(تحية))
    
    # تحويل حالة الأحرف (للنصوص الانجليزية)
    نص انجليزي = "hello world"
    اطبع("كبير: ")
