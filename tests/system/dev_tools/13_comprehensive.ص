# مثال 13: برنامج شامل متقدم
# نظام إدارة مكتبة كتب باستخدام OOP + دوال + مصفوفات

صنف كتاب
    نص العنوان
    نص المؤلف
    رقم السنة
    منطقي متاح
    
    باني(نص عنوان، نص مؤلف، رقم سنة)
        العنوان = عنوان
        المؤلف = مؤلف
        السنة = سنة
        متاح = صح
    نهاية
    
    دالة استعارة()
        إذا (متاح == صح)
            متاح = خطأ
            اطبع("تمت استعارة: ")
            اطبع_سطر(العنوان)
        وإلا
            اطبع("الكتاب غير متاح: ")
            اطبع_سطر(العنوان)
        نهاية
    نهاية
    
    دالة ردّ()
        متاح = صح
        اطبع("تم إرجاع: ")
        اطبع_سطر(العنوان)
    نهاية
    
    دالة عرض()
        اطبع("📚 ")
        اطبع(العنوان)
        اطبع(" - ")
        اطبع(المؤلف)
        اطبع(" (")
        اطبع(السنة)
        اطبع(") ")
        إذا (متاح == صح)
            اطبع_سطر("[متاح ✅]")
        وإلا
            اطبع_سطر("[مستعار ❌]")
        نهاية
    نهاية
نهاية

# دوال مساعدة
دالة رقم مضروب(رقم ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

دالة رقم قوة(رقم قاعدة، رقم أس)
    رقم ناتج = 1
    رقم عداد = 0
    بينما (عداد < أس)
        ناتج = ناتج * قاعدة
        عداد = عداد + 1
    نهاية
    ارجع ناتج
نهاية

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════╗")
    اطبع_سطر("║   نظام إدارة المكتبة        ║")
    اطبع_سطر("╚══════════════════════════════╝")
    اطبع_سطر("")
    
    # إنشاء كتب
    متغير ك1 = جديد كتاب("مقدمة ابن خلدون"، "ابن خلدون"، 1377)
    متغير ك2 = جديد كتاب("ألف ليلة وليلة"، "مجهول"، 800)
    متغير ك3 = جديد كتاب("كليلة ودمنة"، "ابن المقفع"، 750)
    
    # عرض الكتب
    اطبع_سطر("--- قائمة الكتب ---")
    ك1.عرض()
    ك2.عرض()
    ك3.عرض()
    
    # استعارة كتب
    اطبع_سطر("")
    اطبع_سطر("--- عمليات الاستعارة ---")
    ك1.استعارة()
    ك2.استعارة()
    
    # محاولة استعارة كتاب مستعار
    ك1.استعارة()
    
    # عرض الحالة بعد الاستعارة
    اطبع_سطر("")
    اطبع_سطر("--- الحالة بعد الاستعارة ---")
    ك1.عرض()
    ك2.عرض()
    ك3.عرض()
    
    # إرجاع كتاب
    اطبع_سطر("")
    ك1.ردّ()
    ك1.عرض()
    
    # حسابات رياضية
    اطبع_سطر("")
    اطبع_سطر("--- حسابات إضافية ---")
    اطبع("5! = ")
    اطبع_سطر(مضروب(5))
    اطبع("2^10 = ")
    اطبع_سطر(قوة(2، 10))
    
    اطبع_سطر("")
    اطبع_سطر("✅ البرنامج الشامل يعمل بنجاح!")
نهاية
