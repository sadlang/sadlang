# اختبار أنواع البيانات والعمليات

# === الأرقام ===
متغير عدد_صحيح = 42
متغير عدد_سالب = -17
متغير عشري = 3.14159
اطبع_سطر("عدد صحيح: " + عدد_صحيح)
اطبع_سطر("عدد سالب: " + عدد_سالب)
اطبع_سطر("عشري: " + عشري)

# === عمليات حسابية ===
اطبع_سطر("جمع: " + (10 + 5))
اطبع_سطر("طرح: " + (10 - 5))
اطبع_سطر("ضرب: " + (10 * 5))
اطبع_سطر("قسمة: " + (10 / 3))
اطبع_سطر("باقي: " + (10 % 3))
اطبع_سطر("أس: " + (2 ** 10))

# === مقارنة ===
اطبع_سطر("10 == 10: " + (10 == 10))
اطبع_سطر("10 != 5: " + (10 != 5))
اطبع_سطر("10 > 5: " + (10 > 5))
اطبع_سطر("10 < 5: " + (10 < 5))
اطبع_سطر("10 >= 10: " + (10 >= 10))
اطبع_سطر("10 <= 5: " + (10 <= 5))

# === منطقية ===
اطبع_سطر("صحيح و صحيح: " + (صحيح و صحيح))
اطبع_سطر("صحيح أو خطأ: " + (صحيح أو خطأ))
اطبع_سطر("ليس صحيح: " + (ليس صحيح))
اطبع_سطر("&& ||: " + (صحيح && خطأ || صحيح))

# === النصوص ===
متغير نص1 = "مرحباً"
متغير نص2 = " بالعالم"
اطبع_سطر("دمج: " + نص1 + نص2)
اطبع_سطر("طول: " + نص1.طول())

# === المصفوفات ===
متغير أرقام = [10، 20، 30، 40، 50]
اطبع_سطر("مصفوفة: " + أرقام)
اطبع_سطر("عنصر 0: " + أرقام[0])
اطبع_سطر("عنصر 2: " + أرقام[2])
اطبع_سطر("طول: " + أرقام.طول())

# إضافة عنصر
أرقام.أضف(60)
اطبع_سطر("بعد الإضافة: " + أرقام)

# === الخرائط ===
متغير شخص = {"الاسم": "سعد"، "العمر": 25، "المدينة": "القاهرة"}
اطبع_سطر("خريطة: " + شخص)
اطبع_سطر("الاسم: " + شخص["الاسم"])

# === العامل الثلاثي ===
متغير درجة = 85
متغير نتيجة = درجة >= 50 ؟ "ناجح" : "راسب"
اطبع_سطر("النتيجة: " + نتيجة)

# === مصفوفة فارغة وخريطة فارغة ===
متغير فارغة = []
متغير خريطة_فارغة = {}
اطبع_سطر("مصفوفة فارغة: " + فارغة)
اطبع_سطر("خريطة فارغة: " + خريطة_فارغة)

اطبع_سطر("=== انتهى اختبار أنواع البيانات ===")
