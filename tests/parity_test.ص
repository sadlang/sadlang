# اختبار التكافؤ بين المفسر والمترجم
# Test parity between interpreter and compiler

# === اختبار 1: المتغيرات والعمليات الحسابية ===
متغير س = 10
متغير ع = 20
متغير المجموع = س + ع
اطبع_سطر("المجموع: " + المجموع)

# === اختبار 2: الشروط ===
إذا (المجموع > 25)
   اطبع_سطر("النتيجة أكبر من 25")
وإلا
   اطبع_سطر("النتيجة 25 أو أقل")
نهاية

# === اختبار 3: الحلقات ===
متغير مجموع = 0
متغير ت = 1
بينما (ت <= 5)
   مجموع = مجموع + ت
   ت = ت + 1
نهاية
اطبع_سطر("مجموع 1 إلى 5: " + مجموع)

# === اختبار 4: الدوال ===
دالة مضروب(ن)
   إذا (ن <= 1)
      ارجع 1
   نهاية
   ارجع ن * مضروب(ن - 1)
نهاية

اطبع_سطر("مضروب 5: " + مضروب(5))

# === اختبار 5: المصفوفات ===
متغير أرقام = [1، 2، 3، 4، 5]
اطبع_سطر("طول المصفوفة: " + أرقام.طول())

# === اختبار 6: النصوص ===
متغير اسم = "لغة ص"
اطبع_سطر("مرحباً من " + اسم)
