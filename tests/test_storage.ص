# اختبارات وحدة التخزين — NVMe / AHCI / S.M.A.R.T
# Storage Module Tests — NVMe / AHCI / S.M.A.R.T
# 30 اختبار
# ═══════════════════════════════════════════════════════════════

من تخزين استورد *

متغير نجاح = 0
متغير فشل = 0

دالة تحقق(الاسم، الشرط)
    إذا (الشرط)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم)
    نهاية
نهاية

اطبع_سطر("=== اختبارات وحدة التخزين (NVMe/AHCI) ===")
اطبع_سطر("")

# 1. مسح الأقراص
متغير عدد_مسح = storage_scan()
تحقق("مسح الأقراص يعيد عدد > 0", عدد_مسح > 0)

# 2. عدد الأقراص
متغير عدد = storage_drive_count()
تحقق("عدد الأقراص == 2", عدد == 2)

# 3. موديل القرص 0
متغير موديل = storage_drive_model(0)
تحقق("موديل القرص 0 يحتوي Samsung", موديل != "")

# 4. موديل القرص 1
متغير موديل1 = storage_drive_model(1)
تحقق("موديل القرص 1 ليس فارغ", موديل1 != "")

# 5. رقم تسلسلي
متغير تسلسلي = storage_drive_serial(0)
تحقق("رقم تسلسلي ليس فارغ", تسلسلي != "")

# 6. نوع القرص 0 = NVMe (0)
متغير نوع0 = storage_drive_type(0)
تحقق("نوع القرص 0 = NVMe (0)", نوع0 == 0)

# 7. نوع القرص 1 = AHCI (1)
متغير نوع1 = storage_drive_type(1)
تحقق("نوع القرص 1 = AHCI (1)", نوع1 == 1)

# 8. حالة القرص
متغير حالة0 = storage_drive_state(0)
تحقق("حالة القرص 0 >= 0", حالة0 >= 0)

# 9. هل NVMe
متغير nvme0 = storage_is_nvme(0)
تحقق("القرص 0 هو NVMe", nvme0 == 1)

# 10. هل AHCI
متغير ahci1 = storage_is_ahci(1)
تحقق("القرص 1 هو AHCI", ahci1 == 1)

# 11. ليس NVMe
متغير nvme1 = storage_is_nvme(1)
تحقق("القرص 1 ليس NVMe", nvme1 == 0)

# 12. سعة بالميغابايت
متغير سعة = storage_capacity_mb(0)
تحقق("سعة القرص 0 > 0 MB", سعة > 0)

# 13. حجم القطاع
متغير قطاع = storage_sector_size(0)
تحقق("حجم القطاع > 0", قطاع > 0)

# 14. البرنامج الثابت
متغير firmware = storage_firmware(0)
تحقق("البرنامج الثابت ليس فارغ", firmware != "")

# 15. S.M.A.R.T — صحة القرص
متغير صحي = storage_smart_healthy(0)
تحقق("القرص 0 صحي", صحي == 1)

# 16. درجة الحرارة
متغير حرارة = storage_temperature(0)
تحقق("درجة الحرارة بين 20 و 80", حرارة >= 20 && حرارة <= 80)

# 17. ساعات التشغيل
متغير ساعات = storage_smart_hours(0)
تحقق("ساعات التشغيل >= 0", ساعات >= 0)

# 18. نسبة العمر المتبقي
متغير نسبة = storage_smart_percent(0)
تحقق("النسبة المتبقية بين 0 و 100", نسبة >= 0 && نسبة <= 100)

# 19. القطع الاحتياطية الفارغة
متغير قطع = storage_smart_spare(0)
تحقق("القطع الاحتياطية بين 0 و 100", قطع >= 0 && قطع <= 100)

# 20. تقرير S.M.A.R.T
متغير تقرير_ذكي = storage_smart_report(0)
تحقق("تقرير S.M.A.R.T ليس فارغ", تقرير_ذكي != "")

# 21. عدد الأقسام
متغير عدد_أقسام = storage_partition_count(0)
تحقق("عدد أقسام القرص 0 >= 0", عدد_أقسام >= 0)

# 22. تسمية القسم
متغير تسمية = storage_partition_label(0, 0)
تحقق("تسمية القسم تعمل بدون خطأ", تسمية == "" || تسمية != "")

# 23. مخطط التقسيم
متغير مخطط = storage_partition_scheme(0)
تحقق("مخطط التقسيم >= 0", مخطط >= 0)

# 24. قسم إقلاع
متغير اقلاع = storage_partition_bootable(0, 0)
تحقق("فحص قسم الإقلاع يعمل", اقلاع == 0 || اقلاع == 1)

# 25. إنشاء قرص ذاكرة
متغير رام = storage_create_ramdisk(1024)
تحقق("إنشاء قرص ذاكرة", رام >= 0)

# 26. كتابة قطاع
متغير كتب = storage_write_sector(رام, 0, "بيانات اختبارية")
تحقق("كتابة قطاع ناجحة", كتب == 0)

# 27. قراءة قطاع
متغير قراءة = storage_read_sector(رام, 0)
تحقق("قراءة القطاع تعيد بيانات", قراءة != "")

# 28. مسح قطاعات
متغير مسح = storage_zero_sectors(رام, 0, 1)
تحقق("مسح القطاعات يعمل", مسح == 0)

# 29. تقرير التخزين
متغير تقرير = storage_report()
تحقق("تقرير التخزين ليس فارغ", تقرير != "")

# 30. إعادة تعيين
storage_reset()
متغير عدد_بعد = storage_drive_count()
تحقق("إعادة التعيين تعمل", عدد_بعد == 0)

اطبع_سطر("")
اطبع_سطر("=== النتيجة: " + نجاح + " نجاح، " + فشل + " فشل من 30 ===")
