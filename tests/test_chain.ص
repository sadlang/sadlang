اطبع_سطر("=== اختبار تسلسل الاستدعاءات ===")

صنف شخص
    نص الاسم
    رقم العمر
    نص المدينة

    باني(نص اسم)
        الاسم = اسم
        العمر = 0
        المدينة = "غير محدد"
    نهاية

    # دالة بدون ارجاع صريح - يجب ان ترجع الكائن تلقائيا
    دالة ضع_العمر(رقم عمر)
        هذا.العمر = عمر
    نهاية

    دالة ضع_المدينة(نص مدينة)
        هذا.المدينة = مدينة
    نهاية

    دالة اعرض()
        اطبع_سطر(الاسم + " - " + هذا.العمر + " - " + هذا.المدينة)
    نهاية
نهاية

# اختبار 1: تسلسل ضمني (بدون ارجع هذا)
متغير ش = جديد شخص("احمد")
ش.ضع_العمر(25).ضع_المدينة("الرياض").اعرض()

# اختبار 2: تسلسل مباشر بعد الانشاء
متغير ش2 = جديد شخص("سارة")
ش2.ضع_العمر(30).ضع_المدينة("جدة").اعرض()

