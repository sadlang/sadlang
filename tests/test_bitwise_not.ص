# اختبار عامل النفي الثنائي (~)
# Test bitwise NOT operator

# اختبار 1: ~0 يجب أن يكون -1
متغير أ = ~0
إذا (أ == -1)
    اطبع_سطر("اختبار 1 نجح: ~0 == -1")
وإلا
    اطبع_سطر("اختبار 1 فشل: ~0 == " + أ)
نهاية

# اختبار 2: ~(-1) يجب أن يكون 0
متغير ب = ~(-1)
إذا (ب == 0)
    اطبع_سطر("اختبار 2 نجح: ~(-1) == 0")
وإلا
    اطبع_سطر("اختبار 2 فشل: ~(-1) == " + ب)
نهاية

