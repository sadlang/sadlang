# اختبار الوراثة

صنف شكل
    باني(اللون)
        هذا.اللون = اللون
    نهاية
    
    دالة وصف()
        ارجع "شكل بلون " + هذا.اللون
    نهاية
نهاية

صنف مستطيل يرث شكل
    باني(اللون، العرض، الارتفاع)
        أصل(اللون)
        هذا.العرض = العرض
        هذا.الارتفاع = الارتفاع
    نهاية
    
    دالة المساحة()
        ارجع هذا.العرض * هذا.الارتفاع
    نهاية
    
    دالة وصف()
        ارجع "مستطيل " + هذا.العرض + "x" + هذا.الارتفاع + " بلون " + هذا.اللون
    نهاية
نهاية

صنف مربع يرث مستطيل
    باني(اللون، الضلع)
        أصل(اللون، الضلع، الضلع)
    نهاية
    
    دالة وصف()
        ارجع "مربع ضلعه " + هذا.العرض + " بلون " + هذا.اللون
    نهاية
نهاية

متغير ش1 = جديد شكل("أحمر")
متغير م1 = جديد مستطيل("أزرق"، 5، 3)
متغير مر = جديد مربع("أخضر"، 4)

اطبع_سطر("1. " + ش1.وصف())
اطبع_سطر("2. " + م1.وصف())
اطبع_سطر("3. مساحة المستطيل = " + م1.المساحة())
اطبع_سطر("4. " + مر.وصف())
اطبع_سطر("5. مساحة المربع = " + مر.المساحة())
