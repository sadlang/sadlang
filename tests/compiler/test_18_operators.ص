صنف متجه(س، ص)
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل -(آخر)
        ارجع جديد متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل !=(آخر)
        ارجع !(هذا.س == آخر.س و هذا.ص == آخر.ص)
    نهاية

    دالة نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

صنف عداد_متقدم()
    باني()
        هذا.قيمة = 0
    نهاية

    عامل +(آخر)
        متغير ن = جديد عداد_متقدم()
        ن.قيمة = هذا.قيمة + آخر.قيمة
        ارجع ن
    نهاية

    عامل ==(آخر)
        ارجع هذا.قيمة == آخر.قيمة
    نهاية

    دالة زد()
        هذا.قيمة += 1
    نهاية
نهاية

دالة رئيسية()
    # T01: إنشاء متجه
    متغير م1 = جديد متجه(3, 4)
    اطبع_سطر("متجه1: " + م1.نص())

    # T02: متجه ثاني
    متغير م2 = جديد متجه(1, 2)
    اطبع_سطر("متجه2: " + م2.نص())

    # T03: جمع متجهات
    متغير م3 = م1 + م2
    اطبع_سطر("جمع: " + م3.نص())

    # T04: طرح متجهات
    متغير م4 = م1 - م2
    اطبع_سطر("طرح: " + م4.نص())

    # T05: مقارنة متجهات — متساوية
    متغير م5 = جديد متجه(3, 4)
    اطبع_سطر("متساوي: " + (م1 == م5))

    # T06: مقارنة متجهات — مختلفة
    اطبع_سطر("مختلف: " + (م1 != م2))

    # T07: جمع متعدد
    متغير م6 = م1 + م2 + م5
    اطبع_سطر("جمع 3: " + م6.نص())

    # T08: طرح ثم جمع
    متغير م7 = م1 - م2 + م5
    اطبع_سطر("طرح+جمع: " + م7.نص())

    # T09: عمليات حسابية عادية
    اطبع_سطر("جمع: " + (5 + 3))
    اطبع_سطر("طرح: " + (10 - 4))
    اطبع_سطر("ضرب: " + (6 * 7))
    اطبع_سطر("قسمة: " + (20 / 4))

    # T10: باقي القسمة
    اطبع_سطر("باقي: " + (17 % 5))

    # T11: الأس
    اطبع_سطر("أس: " + (2 ** 10))

    # T12: مقارنات عادية
    اطبع_سطر("== " + (5 == 5))
    اطبع_سطر("!= " + (5 != 3))
    اطبع_سطر("> " + (10 > 5))
    اطبع_سطر("< " + (3 < 7))
    اطبع_سطر(">= " + (5 >= 5))
    اطبع_سطر("<= " + (4 <= 4))

    # T13: عوامل منطقية
    اطبع_سطر("و: " + (صحيح و صحيح))
    اطبع_سطر("أو: " + (خطأ أو صحيح))
    اطبع_سطر("ليس: " + (ليس خطأ))

    # T14: عوامل رمزية
    اطبع_سطر("&&: " + (صحيح && صحيح))
    اطبع_سطر("||: " + (خطأ || صحيح))
    اطبع_سطر("!: " + (!خطأ))

    # T15: عداد متقدم
    متغير ع1 = جديد عداد_متقدم()
    ع1.زد()
    ع1.زد()
    ع1.زد()
    اطبع_سطر("عداد1: " + ع1.قيمة)

    # T16: عداد ثاني
    متغير ع2 = جديد عداد_متقدم()
    ع2.زد()
    ع2.زد()
    اطبع_سطر("عداد2: " + ع2.قيمة)

    # T17: جمع عدادات
    متغير ع3 = ع1 + ع2
    اطبع_سطر("مجموع العدادات: " + ع3.قيمة)

    # T18: مقارنة عدادات
    اطبع_سطر("عدادات متساوية: " + (ع1 == ع2))

    # T19: إسناد مركب +=
    متغير ك = 10
    ك += 5
    اطبع_سطر("+= : " + ك)

    # T20: إسناد مركب -=
    ك -= 3
    اطبع_سطر("-= : " + ك)

    # T21: إسناد مركب *=
    ك *= 2
    اطبع_سطر("*= : " + ك)

    # T22: أولوية العمليات
    اطبع_سطر("أولوية: " + (2 + 3 * 4))
    اطبع_سطر("أقواس: " + ((2 + 3) * 4))

    # T23: عمليات سالبة
    اطبع_سطر("سالب+: " + (-5 + 3))
    اطبع_سطر("سالب*: " + (-3 * -2))

    # T24: سلسلة مقارنات
    متغير ن = 50
    اطبع_سطر("بين: " + (ن > 10 و ن < 100))

    # T25: عمليات متنوعة في شرط
    إذا (ن >= 0 و ن <= 100)
        اطبع_سطر("ن في النطاق 0-100")
    نهاية
