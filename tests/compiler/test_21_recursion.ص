دالة قاع_أ_م(أ، ب)
    إذا (ب == 0)
        ارجع أ
    نهاية
    ارجع قاع_أ_م(ب، أ % ب)
نهاية

دالة أس(قاعدة، قوة)
    إذا (قوة == 0)
        ارجع 1
    نهاية
    ارجع قاعدة * أس(قاعدة، قوة - 1)
نهاية

دالة مجموع_أعداد(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    ارجع ن + مجموع_أعداد(ن - 1)
نهاية

دالة عكس_نص(ن)
    إذا (طول(ن) <= 1)
        ارجع ن
    نهاية
    ارجع عكس_نص(ن[1:]) + ن[0]
نهاية

دالة عد_تنازلي(ن)
    إذا (ن <= 0)
        ارجع "انتهى"
    نهاية
    ارجع "" + ن + " " + عد_تنازلي(ن - 1)
نهاية

دالة مجموع_مصفوفة(م، ف)
    إذا (ف >= طول(م))
        ارجع 0
    نهاية
    ارجع م[ف] + مجموع_مصفوفة(م، ف + 1)
نهاية

دالة أقصى_مشترك(أ، ب)
    إذا (أ == ب)
        ارجع أ
    نهاية
    إذا (أ > ب)
        ارجع أقصى_مشترك(أ - ب، ب)
    نهاية
    ارجع أقصى_مشترك(أ، ب - أ)
نهاية

دالة ضرب_تكراري(أ، ب)
    إذا (ب == 0)
        ارجع 0
    نهاية
    إذا (ب == 1)
        ارجع أ
    نهاية
    ارجع أ + ضرب_تكراري(أ، ب - 1)
نهاية

