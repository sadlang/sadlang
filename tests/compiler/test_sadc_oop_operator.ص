# اختبار operators مع OOP
صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(اخر)
        ارجع جديد نقطة(هذا.س + اخر.س، هذا.ص + اخر.ص)
    نهاية
نهاية

متغير أ = جديد نقطة(1، 2)
متغير ب = جديد نقطة(3، 4)
اطبع_سطر("قبل الجمع")
متغير ج = أ + ب
اطبع_سطر("بعد الجمع")
اطبع_سطر(ج.س)
اطبع_سطر(ج.ص)
