# اختبار: إرجاع كائن من دالة
صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

دالة اصنع_نقطة()
    متغير ن = جديد نقطة(5، 6)
    اطبع_سطر("إنشاء داخل الدالة")
    اطبع_سطر(ن.س)
    ارجع ن
نهاية

اطبع_سطر("قبل")
متغير نتيجة = اصنع_نقطة()
اطبع_سطر("بعد الدالة")
# هذا هو السطر الذي يتعطل فيه:
اطبع_سطر(نتيجة.س)
