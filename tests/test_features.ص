# اختبار الميزات المطوّرة
# ═══════════════════════════════════════════

# --- 1: المزخرفات (Decorators) ---
دالة سجّل(اسم_دالة)
    اطبع_سطر("مزخرف: " + اسم_دالة)
    ارجع اسم_دالة
نهاية

@سجّل
دالة تحية()
    اطبع_سطر("مرحبا!")
نهاية

تحية()

# --- 2: التعداد المحسّن (Enhanced Enum) ---
تعداد اللون
    أحمر
    أخضر
    أزرق
نهاية

اطبع_سطر("أحمر = " + أحمر)
اطبع_سطر("أخضر = " + أخضر)
اطبع_سطر("أزرق = " + أزرق)

# الوصول المؤهل
اطبع_سطر("اللون.أحمر = " + اللون.أحمر)

# تعداد بقيم مخصصة
تعداد الحالة
    نشط = 1
    متوقف = 5
    فشل = 10
نهاية

اطبع_سطر("نشط = " + نشط)
اطبع_سطر("متوقف = " + متوقف)
اطبع_سطر("فشل = " + فشل)

# --- 3: الاختبارات السابقة ---
متغير م = [1, 2, 3, 4, 5]
اطبع_سطر("المصفوفة: " + م)

دالة جمع(أ، ب)
    ارجع أ + ب
نهاية

اطبع_سطر("3 + 7 = " + جمع(3, 7))

اطبع_سطر("=== كل الميزات نجحت ===")
