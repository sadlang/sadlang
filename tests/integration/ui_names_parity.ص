# ═══════════════════════════════════════════════════════════════════
# بوّابة م-أسماء — الأسماء المعياريّة للعناصر الخمسة (تباعد صامت سابق)
# ═══════════════════════════════════════════════════════════════════
# يمارس الأسماء المعياريّة في مصدر الحقيقة (ui_widgets.yaml) التي كان
# المترجم يطابق مرادفها التاريخيّ فقط فتسقط إلى VOID (تباعد مفسّر↔مترجم):
#   رصة (مكدس)، مفتاح (مبدل)، خانة_اختيار (مربع_تحقق)،
#   فاصل_خط (خط_فاصل)، زر_أيقونة (زر_ايقونة — فرق همزة).
# الهدف: نوع(الاسم المعياريّ()) == "كائن" في المحرّكين معًا.
# (headless: بلا تشغيل_تطبيق.)
# ═══════════════════════════════════════════════════════════════════

استورد رسومات

متغير نجح = 0
متغير فشل = 0

دالة تحقق(اسم، شرط)
    إذا (شرط)
        نجح = نجح + 1
        اطبع_سطر("✓ " + اسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + اسم)
    نهاية
نهاية

# ─── الأسماء المعياريّة الخمسة ───
تحقق("رصة() كائن"، نوع(رصة()) == "كائن")
تحقق("مفتاح() كائن"، نوع(مفتاح()) == "كائن")
تحقق("خانة_اختيار() كائن"، نوع(خانة_اختيار()) == "كائن")
تحقق("فاصل_خط() كائن"، نوع(فاصل_خط()) == "كائن")
تحقق("زر_أيقونة() كائن"، نوع(زر_أيقونة("نجمة")) == "كائن")

# ─── النتائج ───
اطبع_سطر("")
اطبع_سطر("نجح: " + نجح + " / فشل: " + فشل)
إذا (فشل == 0)
    اطبع_سطر("✅ كل الفحوص نجحت")
وإلا
    اطبع_سطر("❌ فشل بعض الفحوص")
نهاية
