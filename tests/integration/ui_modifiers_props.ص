# @description: بوّابة م-أ3ر/L1–L3 — معدّلات عامّة (نصّ/صحيح/عشريّ/منطقيّ/متعدّد) + أحداث عند_* + سلاسل تحريك تُترجَم أثرًا فعليًّا على IRNode (headless)
# @expected: ✓ معدّل نصّيّ (.لون) كائن\n✓ معدّلات عدديّة (.زوايا/.شفافية) كائن\n✓ سلسلة نصّيّ+عدديّ كائن\n✓ معدّل منطقيّ (.مرئي) كائن\n✓ معدّل صحيح (.ارتفاع) كائن\n✓ متعدّد وسائط (صحيح) كائن\n✓ متعدّد وسائط مختلط كائن\n✓ زرّ + خاصيّة + حدث عند_النقر كائن\n✓ حدث بلا معالِج يتسلسل ككائن\n✓ سلسلة تحريك مفردة كائن\n✓ تحريك مركّب كائن\n✓ تحريك ثمّ خاصيّة ثمّ تحريك كائن\n✓ تكرار بوسيط عشريّ كائن\n\nنجح: 13 / فشل: 0\n✅ كل الفحوص نجحت
# ═══════════════════════════════════════════════════════════════════
# بوّابة م-أ3ر/L1 — خصائص المعدّلات العامّة في المترجم
# ═══════════════════════════════════════════════════════════════════
# يمارس معدّلات انسيابيّة تُترجَم الآن إلى ضبط خاصيّة فعليّ على IRNode
# (نظير setIRProperty في المفسّر): نصّيّة (.لون)، عدديّة (.حجم/.زوايا)،
# منطقيّة (.مرئي بلا وسيط). الهدف: السلسلة تُترجَم وتُشغَّل بلا انهيار،
# والنتيجة كائن، في المحرّكين معًا (الأثر يُسجَّل على شجرة العناصر).
# (headless: بلا تشغيل_تطبيق.)
# ═══════════════════════════════════════════════════════════════════

استورد رسومات

متغير نجح = 0
متغير فشل = 0
دالة تحقق(اسم، شرط)
    إذا (شرط)
        نجح = نجح + 1
        اطبع_سطر("✓ " + اسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + اسم)
    نهاية
نهاية

# ─── خاصيّة نصّيّة ───
متغير ب = زر("احفظ").لون("أخضر")
تحقق("معدّل نصّيّ (.لون) كائن"، نوع(ب) == "كائن")

# ─── خاصيّة عدديّة (عدد عشريّ + صحيح) ───
متغير ح = حاوية().زوايا(8).شفافية(0.5)
تحقق("معدّلات عدديّة (.زوايا/.شفافية) كائن"، نوع(ح) == "كائن")

# ─── سلسلة مختلطة ───
متغير ن = نص_عنصر("عنوان").لون("أزرق").حجم(20)
تحقق("سلسلة نصّيّ+عدديّ كائن"، نوع(ن) == "كائن")

# ─── معدّل منطقيّ بلا وسيط ───
متغير ص = صندوق().مرئي()
تحقق("معدّل منطقيّ (.مرئي) كائن"، نوع(ص) == "كائن")

# ─── معدّل عددٍ صحيح (يُخزَّن int64 كالمفسّر، لا double) ───
متغير ع = حاوية().ارتفاع(40)
تحقق("معدّل صحيح (.ارتفاع) كائن"، نوع(ع) == "كائن")

# ─── متعدّد الوسائط (>1): دمج بفواصل (مُنفَّذ على المحرّكين) ───
# (AR) قيمٌ مفصولة بفواصل ⇒ خاصّيّة نصّيّة، نظير المفسّر (toString لكلّ وسيط).
متغير م = حاوية().حشوة(8، 8، 8، 8)
تحقق("متعدّد وسائط (صحيح) كائن"، نوع(م) == "كائن")

# ─── متعدّد وسائط مختلط الأنواع (صحيح/عشريّ/نصّ/منطقيّ) ───
متغير خ = حاوية().مخصّص(1، 2.5، "س"، صحيح)
تحقق("متعدّد وسائط مختلط كائن"، نوع(خ) == "كائن")

# ─── L2: ربط حدث عند_* (يُسجَّل على العقدة، يتسلسل ككائن) ───
دالة عند_ضغط()
    اطبع_سطر("نُقِر")
نهاية
متغير ز = زر("احفظ").لون("أزرق").عند_النقر(عند_ضغط)
تحقق("زرّ + خاصيّة + حدث عند_النقر كائن"، نوع(ز) == "كائن")

# ─── L2: حدث بلا معالِج لا يُسجَّل (نظير المفسّر) — يبقى كائنًا بلا انهيار ───
متغير ك = زر("بلا").عند_النقر()
تحقق("حدث بلا معالِج يتسلسل ككائن"، نوع(ك) == "كائن")

# ─── L3: سلسلة تحريك مفردة (حرّك + مدة + منحنى + تأخير + تكرار) ───
متغير ت1 = نص_عنصر("مرحبا").حرّك("ظهور").مدة(0.5).منحنى("مرونة").تأخير(0.2).تكرار(3)
تحقق("سلسلة تحريك مفردة كائن"، نوع(ت1) == "كائن")

# ─── L3: تحريك مركّب (فاصلة) + عكس_تلقائي بلا وسيط ───
متغير ت2 = حاوية().حرّك("ظهور,دوران").مدة(0.3).عكس_تلقائي()
تحقق("تحريك مركّب كائن"، نوع(ت2) == "كائن")

# ─── L3: تحريك ثمّ خاصيّة (تُنهي السلسلة) ثمّ تحريك جديد ───
متغير ت3 = زر("س").حرّك("ظهور").مدة(0.4).لون("أحمر").حرّك("دوران").مدة(1)
تحقق("تحريك ثمّ خاصيّة ثمّ تحريك كائن"، نوع(ت3) == "كائن")

# ─── L3: تكرار بوسيط عشريّ (يجب ألّا ينهار المترجم — FPToSI لا IntCast) ───
متغير ت4 = حاوية().حرّك("ظهور").تكرار(2.5)
تحقق("تكرار بوسيط عشريّ كائن"، نوع(ت4) == "كائن")

اطبع_سطر("")
اطبع_سطر("نجح: " + نجح + " / فشل: " + فشل)
إذا (فشل == 0)
    اطبع_سطر("✅ كل الفحوص نجحت")
وإلا
    اطبع_سطر("❌ فشل بعض الفحوص")
نهاية
