# برنامج واجهة أدنى — بوّابة المرحلة أ (إغلاق P0-3 طرفًا لطرف)
# ═══════════════════════════════════════════════════════════════════
# يمارس أدنى مسار حرج: استيراد الرسومات، إنشاء عنصر، وسم الكائن،
# ومكوّن «واجهة» تصريحيّ بحالة @حالة. الهدف: مطابقة سلوك المفسّر↔المترجم.
# (بلا تشغيل_تطبيق ليعمل headless في CI؛ يختبر الربط/الوسم لا فتح النافذة.)
# ═══════════════════════════════════════════════════════════════════

استورد رسومات

متغير نجح = 0
متغير فشل = 0

دالة تحقق(اسم، شرط)
    إذا (شرط)
        نجح = نجح + 1
        اطبع_سطر("✓ " + اسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + اسم)
    نهاية
نهاية

# ─── 1) إنشاء عنصر ووسمه كائنًا (P0-1) ───
متغير ز = زر("احفظ")
تحقق("زر() يُنشئ كائنًا"، نوع(ز) == "كائن")

# ─── 2) سلسلة معدّلات + حدث ───
متغير عداد_نقر = 0
دالة عند_نقر()
    عداد_نقر = عداد_نقر + 1
نهاية
متغير ز2 = زر("زيادة").لون("أخضر").عند_النقر(عند_نقر)
تحقق("سلسلة معدّلات + حدث تُنشئ كائنًا"، نوع(ز2) == "كائن")

# ─── 3) حاوية بأبناء ───
متغير لوح = عمود(
    نص_عنصر("العنوان")،
    زر("موافق")
)
تحقق("عمود بأبناء يُنشئ كائنًا"، نوع(لوح) == "كائن")

# ─── 4) مكوّن «واجهة» تصريحيّ بحالة (P0-2) ───
واجهة عدّاد
    @حالة عدد: رقم = 0

    دالة بناء()
        ارجع عمود(
            نص_عنصر("العداد: " + هذا.عدد)،
            زر("زيادة")
        )
    نهاية

    دالة زِد()
        هذا.عدد = هذا.عدد + 1
    نهاية
نهاية

متغير ع = عدّاد()
تحقق("واجهة عدّاد() تُنشأ"، نوع(ع) == "كائن")
ع.زِد()
ع.زِد()
تحقق("تعديل @حالة بعد حدثين"، ع.عدد == 2)

# ─── النتائج ───
اطبع_سطر("")
اطبع_سطر("نجح: " + نجح + " / فشل: " + فشل)
إذا (فشل == 0)
    اطبع_سطر("✅ كل الفحوص نجحت")
وإلا
    اطبع_سطر("❌ فشل بعض الفحوص")
نهاية
