# بوّابة P2 — معاملات عدديّة صحيحة في مصانع الواجهة (لا انهيار ترجمة)
# ═══════════════════════════════════════════════════════════════════
# قبل الإصلاح: تمرير عدد صحيح (i64) إلى مصنع عدديّ كان يولّد fptrunc
# غير صالح ⇒ «Cannot select» وانهيار المترجم. نتحقّق أنّ الأعداد الصحيحة
# تُقبَل في المحرّكين (المنزلق، المقاس، شريط التقدّم).
# ═══════════════════════════════════════════════════════════════════

استورد رسومات

متغير نجح = 0
متغير فشل = 0
دالة تحقق(اسم، شرط)
    إذا (شرط)
        نجح = نجح + 1
        اطبع_سطر("✓ " + اسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + اسم)
    نهاية
نهاية

تحقق("منزلق(عددان صحيحان)"، نوع(منزلق(0، 100)) == "كائن")
تحقق("مقاس(عددان صحيحان)"، نوع(مقاس(120، 80)) == "كائن")
تحقق("شريط_تقدم(صحيح)"، نوع(شريط_تقدم(1)) == "كائن")

اطبع_سطر("")
اطبع_سطر("نجح: " + نجح + " / فشل: " + فشل)
إذا (فشل == 0)
    اطبع_سطر("✅ كل الفحوص نجحت")
وإلا
    اطبع_سطر("❌ فشل بعض الفحوص")
نهاية
