# بوّابة م-مصانع — تكافؤ المصانع الـ24 (سدّ فجوة المترجم)
# ═══════════════════════════════════════════════════════════════════
# يمارس العناصر الـ24 التي كان المفسّر يدعمها والمترجم لا يلوّنها بالاسم.
# الهدف: نوع(العنصر()) == "كائن" في المحرّكين معًا (المفسّر والمترجم).
# (headless: بلا تشغيل_تطبيق.)
# ═══════════════════════════════════════════════════════════════════

استورد رسومات

متغير نجح = 0
متغير فشل = 0

دالة تحقق(اسم، شرط)
    إذا (شرط)
        نجح = نجح + 1
        اطبع_سطر("✓ " + اسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + اسم)
    نهاية
نهاية

# ─── عناصر بخاصّيّة ───
تحقق("صورة"، نوع(صورة("ش.png")) == "كائن")
تحقق("أيقونة"، نوع(أيقونة("نجمة")) == "كائن")
تحقق("زر_نصي"، نوع(زر_نصي("موافق")) == "كائن")
تحقق("شريط_إشعار"، نوع(شريط_إشعار("تمّ الحفظ")) == "كائن")
تحقق("تلميح"، نوع(تلميح("معلومة")) == "كائن")
تحقق("منطقة_نص"، نوع(منطقة_نص("اكتب هنا")) == "كائن")
تحقق("شريط_تقدم"، نوع(شريط_تقدم(0.5)) == "كائن")
تحقق("مقاس"، نوع(مقاس(100، 50)) == "كائن")

# ─── مغلّفات تخطيط (بلا معاملات) ───
تحقق("شبكة"، نوع(شبكة()) == "كائن")
تحقق("وسط"، نوع(وسط()) == "كائن")
تحقق("حشوة"، نوع(حشوة()) == "كائن")
تحقق("محاذاة"، نوع(محاذاة()) == "كائن")
تحقق("موسع"، نوع(موسع()) == "كائن")
تحقق("مرن"، نوع(مرن()) == "كائن")
تحقق("التفاف"، نوع(التفاف()) == "كائن")
تحقق("صندوق"، نوع(صندوق()) == "كائن")
تحقق("عرض_تمرير"، نوع(عرض_تمرير()) == "كائن")
تحقق("منطقة_آمنة"، نوع(منطقة_آمنة()) == "كائن")
تحقق("سطح"، نوع(سطح()) == "كائن")

# ─── قوائم كسولة + ملاحة + حاويات ───
تحقق("عمود_كسول"، نوع(عمود_كسول()) == "كائن")
تحقق("صف_كسول"، نوع(صف_كسول()) == "كائن")
تحقق("قائمة"، نوع(قائمة()) == "كائن")
تحقق("درج"، نوع(درج()) == "كائن")
تحقق("تنقل_سفلي"، نوع(تنقل_سفلي()) == "كائن")

# ─── النتائج ───
اطبع_سطر("")
اطبع_سطر("نجح: " + نجح + " / فشل: " + فشل + " (المتوقّع 24)")
إذا (فشل == 0)
    اطبع_سطر("✅ كل الفحوص نجحت")
وإلا
    اطبع_سطر("❌ فشل بعض الفحوص")
نهاية
