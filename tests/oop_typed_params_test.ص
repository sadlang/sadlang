# اختبار: تمرير الأصناف كأنواع في معاملات الدوال
# Test: Using class types in function parameters

صنف شخص
    نص الاسم
    رقم العمر
    
    باني(نص اسم، رقم عمر)
        الاسم = اسم
        العمر = عمر
    نهاية
    
    دالة عرض()
        اطبع_سطر("الاسم: " + الاسم + "، العمر: " + العمر)
    نهاية
نهاية

صنف سيارة
    نص الماركة
    
    باني(نص ماركة)
        الماركة = ماركة
    نهاية
نهاية

# دالة تأخذ كائن من نوع محدد (شخص)
دالة عرض_شخص(شخص ش)
    اطبع_سطر("=== معلومات الشخص ===")
    اطبع_سطر("الاسم: " + ش.الاسم)
    اطبع_سطر("العمر: " + ش.العمر)
نهاية

# دالة تعدل كائن بالمرجع
دالة زيادة_عمر(شخص ش)
    ش.العمر = ش.العمر + 1
نهاية

دالة رئيسية()
    شخص احمد = جديد شخص("أحمد"، 25)
    
    اطبع_سطر("=== اختبار 1: تمرير كائن بنوع محدد ===")
    عرض_شخص(احمد)
    
    اطبع_سطر("=== اختبار 2: تعديل بالمرجع ===")
    اطبع_سطر("قبل:")
    احمد.عرض()
    زيادة_عمر(احمد)
    اطبع_سطر("بعد:")
    احمد.عرض()
    
    ارجع 0
نهاية
