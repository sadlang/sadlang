# اختبار مطابقة الأنماط (Pattern Matching)
متغير قيمة = 3

طابق (قيمة)
    حالة 1:
        اطبع_سطر("واحد")
    حالة 2:
        اطبع_سطر("اثنان")
    حالة 3:
        اطبع_سطر("ثلاثة")
نهاية

# حالة/عندما (switch)
متغير لون = "أحمر"
حالة (لون)
    عندما "أحمر":
        اطبع_سطر("اللون أحمر")
    عندما "أزرق":
        اطبع_سطر("اللون أزرق")
    افتراضي:
        اطبع_سطر("لون آخر")
نهاية

اطبع_سطر("=== نجح اختبار المطابقة ===")
