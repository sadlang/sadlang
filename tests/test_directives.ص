#                              2. اختبارات @ذري
# ═══════════════════════════════════════════════════════════════════════════════

اطبع_سطر("")
اطبع_سطر("═══ 2. اختبارات @ذري (atomic) ═══")

# تحميل ذري
متغير عداد = 42
متغير قيمة = @ذري(تحميل, عداد)
تأكد(قيمة == 42, "@ذري(تحميل, عداد) = 42")

# تخزين ذري
@ذري(تخزين, عداد, 100)
قيمة = @ذري(تحميل, عداد)
تأكد(قيمة == 100, "@ذري(تخزين, عداد, 100) ثم تحميل = 100")

# إضافة ذرية
@ذري(إضافة, عداد, 50)
قيمة = @ذري(تحميل, عداد)
تأكد(قيمة == 150, "@ذري(إضافة, عداد, 50) ← 150")

# طرح ذري
@ذري(طرح, عداد, 25)
قيمة = @ذري(تحميل, عداد)
تأكد(قيمة == 125, "@ذري(طرح, عداد, 25) ← 125")

