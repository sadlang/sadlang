# ══════════════════════════════════════════════════════════════════
# اختبار 8: واجهة (interface) مع @حالة وأحداث
# ══════════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══ 5. واجهات مع @حالة ═══")

واجهة نموذج_أحداث
    @حالة عداد: رقم = 0
    @حالة اخر_حدث: نص = "لا شيء"

    دالة بناء()
        ارجع عمود(
            نص_عنصر("العداد: " + هذا.عداد)،
            نص_عنصر("آخر حدث: " + هذا.اخر_حدث)،
            زر("زيادة")
        )
    نهاية

    دالة عند_زيادة()
        هذا.عداد = هذا.عداد + 1
        هذا.اخر_حدث = "زيادة"
    نهاية

    دالة عند_تصفير()
        هذا.عداد = 0
        هذا.اخر_حدث = "تصفير"
    نهاية
نهاية

متغير نموذج = جديد نموذج_أحداث()
تحقق("واجهة مع @حالة — تم الإنشاء"، نوع(نموذج) == "object")

نموذج.عند_زيادة()
نموذج.عند_زيادة()
نموذج.عند_زيادة()
تحقق("واجهة — تحديث الحالة بعد 3 أحداث"، نموذج.عداد == 3)
تحقق("واجهة — تسجيل آخر حدث"، نموذج.اخر_حدث == "زيادة")

نموذج.عند_تصفير()
تحقق("واجهة — تصفير الحالة"، نموذج.عداد == 0)
تحقق("واجهة — تسجيل حدث التصفير"، نموذج.اخر_حدث == "تصفير")

