# اختبار 7: حاوية متداخلة مع أحداث
# ══════════════════════════════════════════════════════════════════
اعرض عمود
    نص_عنصر("الصفحة الرئيسية").حجم(24)
    صف
        زر("حفظ").عند_النقر => اطبع_سطر("حفظ")
