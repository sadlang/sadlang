سجل.سجّل("عند_الإرسال")
سجل.سجّل("عند_التحديد")
سجل.سجّل("عند_انتهاء_التحريك")
سجل.سجّل("عند_التحميل")
سجل.سجّل("عند_الخطأ")

تحقق("سجل الأحداث — 16 حدث بعد الإضافة"، سجل.عدد_الأحداث() == 16)
تحقق("سجل — آخر حدث هو عند_الخطأ"، سجل.آخر_حدث() == "عند_الخطأ")

