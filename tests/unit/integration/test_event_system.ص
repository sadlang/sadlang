# اختبارات تكامل: نظام الأحداث الموحد (IREventType)
# ═══════════════════════════════════════════════════════════════════
# يختبر:
#   1. إنشاء عناصر واجهة مع أحداث متنوعة (33 نوع)
#   2. سلاسل معدّلات مع أحداث
#   3. واجهات مع @حالة وأحداث
#   4. أحداث متعددة على عنصر واحد
#   5. أحداث في حاويات متداخلة
#   6. الأحداث الجديدة (السحب المتقدم، الدوران، القائمة السياقية...)
# ═══════════════════════════════════════════════════════════════════

استورد رسومات

متغير نجح = 0
متغير فشل = 0

دالة تحقق(اسم، شرط)
    إذا (شرط)
        نجح = نجح + 1
        اطبع_سطر("✓ " + اسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + اسم)
    نهاية
نهاية

