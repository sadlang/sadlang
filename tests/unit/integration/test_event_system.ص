# اختبار 1: زر مع عند_النقر (OnTap)
# ══════════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══ 1. أحداث النقر واللمس ═══")

متغير عداد_نقر = 0
دالة معالج_نقر()
    عداد_نقر = عداد_نقر + 1
نهاية

متغير زر1 = زر("انقر").عند_النقر(معالج_نقر)
تحقق("زر مع عند_النقر — تم الإنشاء"، نوع(زر1) == "object")

