# اختبار 9: واجهة بوراثة — أحداث من الأب والابن
# ══════════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══ 6. وراثة الواجهات ═══")

واجهة نموذج_موسّع يرث نموذج_أحداث
    @حالة مضاعفة: رقم = 2

    دالة عند_زيادة_مضاعفة()
        هذا.عداد = هذا.عداد + هذا.مضاعفة
        هذا.اخر_حدث = "مضاعفة"
    نهاية
نهاية

متغير نموذج2 = جديد نموذج_موسّع()
نموذج2.عند_زيادة()
نموذج2.عند_زيادة_مضاعفة()
تحقق("وراثة — حدث الأب ثم الابن"، نموذج2.عداد == 3)
تحقق("وراثة — آخر حدث من الابن"، نموذج2.اخر_حدث == "مضاعفة")

