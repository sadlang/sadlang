# اختبار 11: محاكاة أنواع الأحداث المختلفة عبر دوال
# ══════════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══ 8. محاكاة أنواع الأحداث ═══")

صنف مسجّل_أحداث
    متغير عام أحداث = []

    دالة عام سجّل(نوع_الحدث)
        هذا.أحداث.اضف(نوع_الحدث)
    نهاية

    دالة عام عدد_الأحداث()
        ارجع طول(هذا.أحداث)
    نهاية

    دالة عام آخر_حدث()
        إذا (طول(هذا.أحداث) > 0)
            ارجع هذا.أحداث[طول(هذا.أحداث) - 1]
        نهاية
        ارجع "لا أحداث"
    نهاية

    دالة عام مسح()
        هذا.أحداث = []
    نهاية
نهاية

متغير سجل = جديد مسجّل_أحداث()

# محاكاة سلسلة أحداث
سجل.سجّل("عند_النقر")
سجل.سجّل("عند_التغيير")
سجل.سجّل("عند_التحويم")
سجل.سجّل("عند_التركيز")
سجل.سجّل("عند_الإدخال")

تحقق("سجل الأحداث — 5 أحداث مسجلة"، سجل.عدد_الأحداث() == 5)
تحقق("سجل الأحداث — آخر حدث هو عند_الإدخال"، سجل.آخر_حدث() == "عند_الإدخال")

# أحداث جديدة
سجل.سجّل("عند_بدء_السحب")
سجل.سجّل("عند_انتهاء_السحب")
