// ════════════════════════════════════════════════════════════════════════════════
// نواة نظام النحلة المُصغّرة — اختبار تكاملي شامل
// BeeOS Mini Kernel — Comprehensive Integration Test
//
// الوصف: نواة مُصغّرة بلغة ص تمر بكل مراحل الترجمة وتُقلع على QEMU
// Description: Minimal Sad-language kernel that passes through all compilation 
//              stages and boots on QEMU
//
// المتطلبات / Requirements:
//   - صد بناء --هدف x86_64-bare ← ينتج نواة.elf
//   - qemu-system-x86_64 -kernel نواة.elf ← يطبع "نظام النحلة 🐝"
//   - الملف الناتج < 64KB
//   - تحليل الأمان يمر بدون تحذيرات
// ════════════════════════════════════════════════════════════════════════════════

#[بلا_مكتبة_قياسية]
#[نظام_تشغيل("bare_metal")]
#[هدف("x86_64-bare")]

// ═══════════════════════════════════════
// ثوابت الأجهزة / Hardware Constants
// ═══════════════════════════════════════

// منافذ UART / UART Ports
ثابت COM1: ع16 = 0x3F8

// VGA ذاكرة الشاشة / VGA text mode buffer
ثابت VGA_BUFFER: ع64 = 0xB8000
ثابت VGA_WIDTH: ع32 = 80
ثابت VGA_HEIGHT: ع32 = 25

// ألوان VGA / VGA colors
ثابت لون_أبيض_على_أسود: ع8 = 0x0F
ثابت لون_أخضر_على_أسود: ع8 = 0x0A
ثابت لون_أصفر_على_أسود: ع8 = 0x0E

// ═══════════════════════════════════════
// حالة النواة / Kernel State
// ═══════════════════════════════════════

متغير سطر_حالي: ع32 = 0
متغير عمود_حالي: ع32 = 0

// ═══════════════════════════════════════
// رأس Multiboot / Multiboot Header
// ═══════════════════════════════════════

#[قسم(".multiboot")]
#[محاذاة(4)]
ثابت MULTIBOOT_MAGIC: ع32 = 0x1BADB002
#[قسم(".multiboot")]
ثابت MULTIBOOT_FLAGS: ع32 = 0x00000003
#[قسم(".multiboot")]
ثابت MULTIBOOT_CHECKSUM: ع32 = 0 - (0x1BADB002 + 0x00000003)

// ═══════════════════════════════════════
// وظائف UART / UART Functions
// ═══════════════════════════════════════

دالة uart_تهيئة() {
    منفذ_كتابة(COM1 + 1, 0x00)    // تعطيل المقاطعات / Disable interrupts
    منفذ_كتابة(COM1 + 3, 0x80)    // تمكين DLAB / Enable DLAB
    منفذ_كتابة(COM1 + 0, 0x03)    // 38400 baud
    منفذ_كتابة(COM1 + 1, 0x00)
    منفذ_كتابة(COM1 + 3, 0x03)    // 8N1
    منفذ_كتابة(COM1 + 2, 0xC7)    // FIFO
    منفذ_كتابة(COM1 + 4, 0x0B)    // IRQ
}

دالة uart_كتابة_حرف(ح: ع8) {
    // انتظار المُخرج الفارغ / Wait for empty transmit buffer
    طالما (منفذ_قراءة(COM1 + 5) & 0x20) == 0 {}
    منفذ_كتابة(COM1, ح)
}

دالة uart_كتابة_نص(نص: *ثابت ع8, طول: ع32) {
    لكل ف في 0..طول {
        uart_كتابة_حرف(نص[ف])
    }
}

// ═══════════════════════════════════════
// وظائف VGA / VGA Functions
// ═══════════════════════════════════════

دالة vga_مسح_الشاشة() {
    متغير ذاكرة = VGA_BUFFER ك *متغير ع16
    لكل ف في 0..(VGA_WIDTH * VGA_HEIGHT) {
        ذاكرة[ف] = ((لون_أبيض_على_أسود ك ع16) << 8) | (0x20 ك ع16)
    }
    سطر_حالي = 0
    عمود_حالي = 0
}

دالة vga_كتابة_حرف(ح: ع8, لون: ع8) {
    إذا ح == 0x0A {  // سطر جديد / Newline
        سطر_حالي += 1
        عمود_حالي = 0
        أرجع
    }
    
    إذا سطر_حالي >= VGA_HEIGHT {
        أرجع  // لا مكان / No room
    }
    
    متغير ذاكرة = VGA_BUFFER ك *متغير ع16
    متغير فهرس = سطر_حالي * VGA_WIDTH + عمود_حالي
    ذاكرة[فهرس] = ((لون ك ع16) << 8) | (ح ك ع16)
    
    عمود_حالي += 1
    إذا عمود_حالي >= VGA_WIDTH {
        عمود_حالي = 0
        سطر_حالي += 1
    }
}

دالة vga_كتابة_نص(نص: *ثابت ع8, طول: ع32, لون: ع8) {
    لكل ف في 0..طول {
        vga_كتابة_حرف(نص[ف], لون)
    }
}

// ═══════════════════════════════════════
// تهيئة الذاكرة / Memory Initialization
// ═══════════════════════════════════════

// كومة بسيطة 4KB / Simple 4KB heap
#[قسم(".bss")]
متغير _كومة: [ع8; 4096] = [0; 4096]
متغير _مؤشر_كومة: ع64 = 0

دالة تخصيص_بسيط(حجم: ع64) -> *متغير ع8 {
    متغير محاذاة = (_مؤشر_كومة + 7) & !7  // محاذاة 8-بايت
    إذا محاذاة + حجم > 4096 {
        أرجع 0 ك *متغير ع8
    }
    متغير نتيجة = عنوان(&_كومة[محاذاة])
    _مؤشر_كومة = محاذاة + حجم
    أرجع نتيجة ك *متغير ع8
}

// ═══════════════════════════════════════
// الفحوصات الذاتية / Self-Tests
// ═══════════════════════════════════════

دالة اختبار_المُخصص() -> منطقي {
    متغير م = تخصيص_بسيط(64)
    إذا م == (0 ك *متغير ع8) {
        أرجع خطأ
    }
    *م = 0xAA
    أرجع *م == 0xAA
}

دالة اختبار_المنافذ() -> منطقي {
    // إذا وصلنا هنا فالمنافذ تعمل / If we got here, ports work
    أرجع صحيح
}

// ═══════════════════════════════════════
// نقطة الدخول الرئيسية / Main Entry Point
// ═══════════════════════════════════════

#[نقطة_دخول]
دالة _start() -> ! {
    // === تهيئة الأجهزة / Initialize hardware ===
    uart_تهيئة()
    vga_مسح_الشاشة()
    
    // === طباعة شعار النواة / Print kernel banner ===
    // "نظام النحلة 🐝" — على UART (UTF-8)
    // N a d h a m   A l - N a h l a h   (bee emoji)
    uart_كتابة_حرف(0xD9)  // ن (UTF-8: D9 86)
    uart_كتابة_حرف(0x86)
    uart_كتابة_حرف(0xD8)  // ظ (UTF-8: D8 B8)
    uart_كتابة_حرف(0xB8)
    uart_كتابة_حرف(0xD8)  // ا (UTF-8: D8 A7)
    uart_كتابة_حرف(0xA7)
    uart_كتابة_حرف(0xD9)  // م (UTF-8: D9 85)
    uart_كتابة_حرف(0x85)
    uart_كتابة_حرف(0x20)  // مسافة / space
    uart_كتابة_حرف(0xD8)  // ا (UTF-8: D8 A7)
    uart_كتابة_حرف(0xA7)
    uart_كتابة_حرف(0xD9)  // ل (UTF-8: D9 84)
    uart_كتابة_حرف(0x84)
    uart_كتابة_حرف(0xD9)  // ن (UTF-8: D9 86)
    uart_كتابة_حرف(0x86)
    uart_كتابة_حرف(0xD8)  // ح (UTF-8: D8 AD)
    uart_كتابة_حرف(0xAD)
    uart_كتابة_حرف(0xD9)  // ل (UTF-8: D9 84)
    uart_كتابة_حرف(0x84)
    uart_كتابة_حرف(0xD8)  // ة (UTF-8: D8 A9)
    uart_كتابة_حرف(0xA9)
    uart_كتابة_حرف(0x20)  // مسافة / space
    uart_كتابة_حرف(0xF0)  // 🐝 (UTF-8: F0 9F 90 9D)
    uart_كتابة_حرف(0x9F)
    uart_كتابة_حرف(0x90)
    uart_كتابة_حرف(0x9D)
    uart_كتابة_حرف(0x0A)  // سطر جديد / newline
    
    // === على VGA: "BeeOS" (ASCII للبساطة) ===
    vga_كتابة_حرف(0x42, لون_أصفر_على_أسود)  // B
    vga_كتابة_حرف(0x65, لون_أصفر_على_أسود)  // e
    vga_كتابة_حرف(0x65, لون_أصفر_على_أسود)  // e
    vga_كتابة_حرف(0x4F, لون_أصفر_على_أسود)  // O
    vga_كتابة_حرف(0x53, لون_أصفر_على_أسود)  // S
    vga_كتابة_حرف(0x20, لون_أبيض_على_أسود)  // مسافة
    vga_كتابة_حرف(0x76, لون_أخضر_على_أسود)  // v
    vga_كتابة_حرف(0x30, لون_أخضر_على_أسود)  // 0
    vga_كتابة_حرف(0x2E, لون_أخضر_على_أسود)  // .
    vga_كتابة_حرف(0x31, لون_أخضر_على_أسود)  // 1
    vga_كتابة_حرف(0x0A, لون_أبيض_على_أسود)  // سطر جديد
    
    // === تشغيل الفحوصات الذاتية / Run self-tests ===
    إذا اختبار_المنافذ() && اختبار_المُخصص() {
        // UART: "SELF-TEST: PASS"
        uart_كتابة_حرف(0x53)  // S
        uart_كتابة_حرف(0x45)  // E
        uart_كتابة_حرف(0x4C)  // L
        uart_كتابة_حرف(0x46)  // F
        uart_كتابة_حرف(0x2D)  // -
        uart_كتابة_حرف(0x54)  // T
        uart_كتابة_حرف(0x45)  // E
        uart_كتابة_حرف(0x53)  // S
        uart_كتابة_حرف(0x54)  // T
        uart_كتابة_حرف(0x3A)  // :
        uart_كتابة_حرف(0x20)  // space
        uart_كتابة_حرف(0x50)  // P
        uart_كتابة_حرف(0x41)  // A
        uart_كتابة_حرف(0x53)  // S
        uart_كتابة_حرف(0x53)  // S
    } وإلا {
        uart_كتابة_حرف(0x46)  // F
        uart_كتابة_حرف(0x41)  // A
        uart_كتابة_حرف(0x49)  // I
        uart_كتابة_حرف(0x4C)  // L
    }
    uart_كتابة_حرف(0x0A)  // سطر جديد
    
    // === الخروج من QEMU / Exit QEMU ===
    منفذ_كتابة(0xF4, 0x00)
    
    // === حلقة لا نهائية (احتياطي) / Infinite loop (fallback) ===
    حلقة {
        أسبت_المعالج()
    }
}
