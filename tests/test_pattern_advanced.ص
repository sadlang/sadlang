# ============================================
# 1. اختبار القيم الحرفية
# ============================================
اطبع_سطر("")
اطبع_سطر("1️⃣ اختبار القيم الحرفية:")

دالة اختبار_حرفي(س)
    طابق (س)
        عندما 0:
            ارجع "صفر"
        عندما 1:
            ارجع "واحد"
        عندما 2:
            ارجع "اثنان"
        افتراضي:
            ارجع "آخر"
    نهاية
نهاية

اطبع_سطر("   اختبار_حرفي(0) = " + اختبار_حرفي(0))
اطبع_سطر("   اختبار_حرفي(1) = " + اختبار_حرفي(1))
اطبع_سطر("   اختبار_حرفي(99) = " + اختبار_حرفي(99))

