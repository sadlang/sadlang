# ============================================
# 5. اختبار حالات HTTP
# ============================================
اطبع_سطر("")
اطبع_سطر("5️⃣ اختبار حالات HTTP:")

دالة وصف_http(كود)
    طابق (كود)
        عندما 200:
            ارجع "✅ OK - نجاح"
        عندما 201:
            ارجع "✅ Created - تم الإنشاء"
        عندما 400:
            ارجع "❌ Bad Request - طلب خاطئ"
        عندما 404:
            ارجع "❌ Not Found - غير موجود"
        عندما 500:
            ارجع "💥 Server Error - خطأ خادم"
        افتراضي:
            ارجع "❓ Unknown - غير معروف"
    نهاية
نهاية

اطبع_سطر("   وصف_http(200) = " + وصف_http(200))
اطبع_سطر("   وصف_http(404) = " + وصف_http(404))
اطبع_سطر("   وصف_http(500) = " + وصف_http(500))
اطبع_سطر("   وصف_http(301) = " + وصف_http(301))

