# اختبار المشكلة 2 الفعلية: متغير عداد = عداد + 1 داخل بينما
# هذا يجب أن يسبب تحذير/خطأ لأن "متغير" يُنشئ متغيراً جديداً

دالة عد_خطأ()
    متغير عداد = 0
    متغير تكرار = 0
    بينما (عداد < 5)
        متغير عداد = عداد + 1
        تكرار = تكرار + 1
        إذا (تكرار > 10)
            اطبع_سطر("حلقة لا نهائية!")
            ارجع -1
        نهاية
    نهاية
    ارجع عداد
نهاية

متغير نتيجة = عد_خطأ()
اطبع_سطر("المشكلة 2: نتيجة=" + نتيجة)
