# === فحص Bug #8: توقف في الحلقات ===

# اختبار 1: توقف في بينما
متغير ع = 0
بينما (ع < 100)
    إذا (ع == 5)
        توقف
    نهاية
    ع += 1
نهاية
اطبع_سطر("بينما توقف عند: " + ع)

# اختبار 2: توقف في لكل
متغير مجموع = 0
لكل ر في [1، 2، 3، 4، 5، 6، 7، 8]
    إذا (ر > 4)
        توقف
    نهاية
    مجموع += ر
نهاية
اطبع_سطر("لكل مجموع: " + مجموع)

# اختبار 3: استمر في الحلقة
متغير مجموع2 = 0
لكل ق في [1، 2، 3، 4، 5]
    إذا (ق == 3)
        استمر
    نهاية
    مجموع2 += ق
نهاية
اطبع_سطر("استمر مجموع: " + مجموع2)

اطبع_سطر("=== Bug #8 نجح ===")
