# اختبار الانحدار #11 — أصناف مخصصة كأنواع حقول
# Regression Test #11 — Custom classes as field types
# المشكلة: المحلل لا يقبل أسماء أصناف مخصصة كأنواع لحقول الصنف
# الأولوية: P0

# === اختبار 1: صنف بسيط ===
صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

متغير ن = نقطة(3, 4) جديد
إذا (ن.س == 3)
    اطبع("PASS: صنف بسيط يعمل")
وإلا
    اطبع("FAIL: صنف بسيط فشل")
نهاية

# === اختبار 2: صنف يستخدم صنف آخر (composition) ===
صنف مستطيل
    باني(نقطة1، نقطة2)
        هذا.نقطة1 = نقطة1
        هذا.نقطة2 = نقطة2
    نهاية
نهاية

متغير ن1 = نقطة(0, 0) جديد
متغير ن2 = نقطة(10, 10) جديد
متغير م = مستطيل(ن1, ن2) جديد

إذا (م.نقطة1.س == 0)
    اطبع("PASS: تركيب الأصناف يعمل")
وإلا
    اطبع("FAIL: تركيب الأصناف فشل")
نهاية

إذا (م.نقطة2.ص == 10)
    اطبع("PASS: وصول عمق 2 يعمل")
وإلا
    اطبع("FAIL: وصول عمق 2 فشل")
نهاية

