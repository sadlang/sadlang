# اختبار الانحدار #14 — أخطاء متسلسلة (cascading errors)
# Regression Test #14 — Single error causes cascading errors
# المشكلة: خطأ واحد يسبب 8+ أخطاء وهمية
# الأولوية: P1
# ملاحظة: هذا الاختبار يتحقق أن برنامج صحيح لا ينتج أخطاء

# === اختبار 1: برنامج كامل بدون أخطاء ===
دالة حساب_المساحة(طول، عرض)
    ارجع طول * عرض
نهاية

دالة حساب_المحيط(طول، عرض)
    ارجع 2 * (طول + عرض)
نهاية

متغير م = حساب_المساحة(5, 3)
متغير ح = حساب_المحيط(5, 3)

إذا (م == 15)
    اطبع("PASS: المساحة = 15")
وإلا
    اطبع("FAIL: المساحة = " + م)
نهاية

إذا (ح == 16)
    اطبع("PASS: المحيط = 16")
وإلا
    اطبع("FAIL: المحيط = " + ح)
نهاية

# === اختبار 2: دوال متعددة متتالية ===
دالة أ()
    ارجع 1
نهاية

دالة ب()
    ارجع 2
نهاية

دالة ج()
    ارجع أ() + ب()
نهاية

إذا (ج() == 3)
    اطبع("PASS: دوال متسلسلة تعمل")
وإلا
    اطبع("FAIL: دوال متسلسلة فشلت")
نهاية

