# اختبار المشكلة #12: القسمة تنتج float دائماً
# Bug #12: Division always produces float

اطبع("=== اختبار القسمة ===")

# قسمة صحيحة — يجب أن تنتج 2 وليس 2.0
متغير ن1 = 8 / 4
اطبع("8/4 = " + ن1)

# قسمة غير صحيحة — يجب أن تنتج 2.5
متغير ن2 = 5 / 2
اطبع("5/2 = " + ن2)

# استخدام ناتج القسمة كفهرس
متغير م = [10, 20, 30, 40, 50]
متغير فهرس = 8 / 4
اطبع("م[8/4] = " + م[فهرس])

# قسمة عدد صحيح على 1
متغير ن3 = 10 / 1
اطبع("10/1 = " + ن3)

اطبع("=== اكتمل ===")
