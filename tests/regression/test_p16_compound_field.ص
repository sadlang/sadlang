# اختبار الانحدار #16 — += على حقل كائن داخل مصفوفة
# Regression Test #16 — Compound assignment on object field inside array
# المشكلة: العمليات[فهرس].أبناء += [قيمة] يسبب خطأ نحوي
# الأولوية: P0

# === اختبار 1: إسناد بسيط لحقل كائن ===
صنف عقدة
    باني(الاسم)
        هذا.الاسم = الاسم
        هذا.قيمة = 0
    نهاية
نهاية

متغير ع = عقدة("جذر") جديد
ع.قيمة = 10

إذا (ع.قيمة == 10)
    اطبع("PASS: إسناد لحقل كائن يعمل")
وإلا
    اطبع("FAIL: إسناد لحقل كائن فشل")
نهاية

# === اختبار 2: += على حقل مباشر ===
ع.قيمة += 5
إذا (ع.قيمة == 15)
    اطبع("PASS: += على حقل مباشر يعمل")
وإلا
    اطبع("FAIL: += على حقل مباشر فشل — القيمة = " + ع.قيمة)
نهاية

# === اختبار 3: كائنات في مصفوفة — إسناد = ===
متغير عقد = [عقدة("أ") جديد, عقدة("ب") جديد]
عقد[0].قيمة = 100

إذا (عقد[0].قيمة == 100)
    اطبع("PASS: إسناد لحقل كائن في مصفوفة يعمل")
وإلا
    اطبع("FAIL: إسناد لحقل كائن في مصفوفة فشل")
نهاية

