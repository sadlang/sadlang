# اختبار الانحدار #7 — عامل += للمصفوفات
# Regression Test #7 — += operator for arrays
# الأولوية: P2

# === اختبار 1: إضافة لمصفوفة بدالة أضف ===
متغير قائمة = [1, 2, 3]
أضف(قائمة, 4)
إذا (قائمة.الطول() == 4)
    اطبع("PASS: أضف() تعمل")
وإلا
    اطبع("FAIL: أضف() فشلت — الطول = " + قائمة.الطول())
نهاية

# === اختبار 2: += للأعداد ===
متغير س = 10
س += 5
إذا (س == 15)
    اطبع("PASS: += للأعداد يعمل")
وإلا
    اطبع("FAIL: += للأعداد فشل — س = " + س)
نهاية

# === اختبار 3: += للنصوص ===
متغير جملة = "مرحبا"
جملة += " يا عالم"
إذا (جملة == "مرحبا يا عالم")
    اطبع("PASS: += للنصوص يعمل")
وإلا
    اطبع("FAIL: += للنصوص فشل")
نهاية

اطبع("=== انتهى اختبار #7 ===")
