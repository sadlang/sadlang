# اختبار الانحدار #2 — متغير x = x + 1 داخل بينما لا يُحدَّث
# Regression Test #2 — Variable update inside while creates new local
# المشكلة: متغير x = x + 1 ينشئ متغيراً جديداً بدل تحديث الموجود → حلقة لانهائية
# الأولوية: P0 (عاجل)
# ملاحظة: هذا الاختبار يستخدم حد أقصى للتكرارات لتجنب الحلقة اللانهائية

# === اختبار 1: تحديث بدون "متغير" (الطريقة الصحيحة) ===
متغير عداد = 0
متغير حد_أمان = 0

بينما (عداد < 5)
    عداد = عداد + 1
    حد_أمان = حد_أمان + 1
    إذا (حد_أمان > 100)
        اطبع("FAIL: حلقة لانهائية في اختبار 1")
        توقف
    نهاية
نهاية

إذا (عداد == 5)
    اطبع("PASS: تحديث عداد بدون 'متغير' يعمل")
وإلا
    اطبع("FAIL: العداد = " + عداد + " بدلاً من 5")
نهاية

# === اختبار 2: تحديث داخل دالة ===
دالة عدّ_حتى(ن)
    متغير ع = 0
    متغير أمان = 0
    بينما (ع < ن)
        ع = ع + 1
        أمان = أمان + 1
        إذا (أمان > 100)
            ارجع -1
        نهاية
    نهاية
    ارجع ع
نهاية

متغير نتيجة = عدّ_حتى(10)
إذا (نتيجة == 10)
    اطبع("PASS: تحديث عداد داخل دالة يعمل")
وإلا
    اطبع("FAIL: نتيجة العد = " + نتيجة + " بدلاً من 10")
نهاية

# === اختبار 3: عدادات متعددة ===
متغير أ = 0
متغير ب = 10

بينما (أ < 3)
    أ = أ + 1
    ب = ب - 1
نهاية

إذا (أ == 3)
    اطبع("PASS: عداد أ يعمل")
وإلا
    اطبع("FAIL: أ = " + أ)
نهاية

إذا (ب == 7)
    اطبع("PASS: عداد ب يعمل")
وإلا
    اطبع("FAIL: ب = " + ب)
نهاية

