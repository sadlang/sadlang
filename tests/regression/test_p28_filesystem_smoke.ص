نهاية

متغير نص_فعلي = اقرأ_ملف(مسار)
إذا (نص_فعلي == نص_متوقع)
    اطبع("PASS: اقرأ_ملف يعيد المحتوى الصحيح")
وإلا
    اطبع("FAIL: اقرأ_ملف أعاد محتوى غير متوقع")
نهاية

احذف_ملف(مسار)

إذا (ليس هل_موجود(مسار))
    اطبع("PASS: احذف_ملف حذف الملف فعلياً")
وإلا
    اطبع("FAIL: الملف ما زال موجوداً بعد الحذف")
