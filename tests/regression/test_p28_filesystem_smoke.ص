استورد أساسيات

متغير مسار = "tmp_p28_fs.txt"
متغير نص_متوقع = "hello_fs_p28"

اكتب_ملف(مسار، نص_متوقع)

إذا (هل_موجود(مسار))
    اطبع("PASS: اكتب_ملف + هل_موجود يعملان")
وإلا
