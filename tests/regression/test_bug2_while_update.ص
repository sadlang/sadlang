# الاختبار 1: بينما داخل دالة — السيناريو الأصلي
دالة اختبار_بينما_في_دالة()
    متغير عداد = 0
    بينما (عداد < 5)
        اطبع(عداد)
        متغير عداد = عداد + 1
    نهاية
    ارجع عداد
نهاية

اطبع("=== اختبار 1: بينما داخل دالة ===")
متغير نتيجة1 = اختبار_بينما_في_دالة()
اطبع("النتيجة: " + نتيجة1)

# الاختبار 2: بينما متداخلة
دالة اختبار_بينما_متداخلة()
    متغير مجموع = 0
    متغير ي = 0
    بينما (ي < 3)
        متغير س = 0
        بينما (س < 3)
            متغير مجموع = مجموع + 1
            متغير س = س + 1
        نهاية
        متغير ي = ي + 1
    نهاية
    ارجع مجموع
نهاية

اطبع("=== اختبار 2: بينما متداخلة ===")
متغير نتيجة2 = اختبار_بينما_متداخلة()
اطبع("المجموع: " + نتيجة2)

# الاختبار 3: بينما مع إذا
دالة اختبار_بينما_مع_اذا()
    متغير ع = 0
    متغير زوجي = 0
    بينما (ع < 10)
        إذا (ع % 2 == 0)
            متغير زوجي = زوجي + 1
        نهاية
        متغير ع = ع + 1
    نهاية
    ارجع زوجي
نهاية

اطبع("=== اختبار 3: بينما مع إذا ===")
متغير نتيجة3 = اختبار_بينما_مع_اذا()
اطبع("الأعداد الزوجية: " + نتيجة3)

