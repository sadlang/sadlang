# اختبار الانحدار #9 — كلمات محجوزة غير موثقة (نوع، حجم)
# Regression Test #9 — Undocumented reserved words (نوع, حجم)
# المشكلة: نوع و حجم محجوزتان لكن غير موثقتين — تسبب SYN001
# الأولوية: P0

# === اختبار 1: استخدام بدائل (يجب أن يعمل) ===
دالة احصل_على_نمط(نمط)
    ارجع نمط
نهاية

متغير ن = احصل_على_نمط("نص")
إذا (ن == "نص")
    اطبع("PASS: بديل 'نمط' يعمل")
وإلا
    اطبع("FAIL: بديل 'نمط' فشل")
نهاية

# === اختبار 2: استخدام بديل لحجم ===
دالة احصل_على_مقاس(مقاس)
    ارجع مقاس
نهاية

متغير م = احصل_على_مقاس(42)
إذا (م == 42)
    اطبع("PASS: بديل 'مقاس' يعمل")
وإلا
    اطبع("FAIL: بديل 'مقاس' فشل")
نهاية

# === اختبار 3: تحقق أن الكلمات العادية تعمل كمعاملات ===
دالة اختبار_معاملات(قيمة، اسم، عدد)
    ارجع قيمة + عدد
نهاية

متغير نت = اختبار_معاملات(10, "اختبار", 5)
إذا (نت == 15)
    اطبع("PASS: معاملات عادية تعمل")
وإلا
    اطبع("FAIL: معاملات عادية فشلت")
نهاية

