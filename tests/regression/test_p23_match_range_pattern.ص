# اختبار الانحدار #23 — RangePattern في طابق/عندما
# Regression Test #23 — RangePattern in match/when
# المشكلة السابقة: الأنماط غير المعروفة كانت تُعامل كأنها true (مطابقة شاملة)
# الهدف: 0..13 و 13..20 يجب أن تعملا بدقة مع افتراضي
# الأولوية: P1

دالة صنف_العمر(عمر)
    طابق (عمر)
        عندما 0..13:
            ارجع "طفل"
        عندما 13..20:
            ارجع "مراهق"
        افتراضي:
            ارجع "بالغ"
    نهاية
نهاية

متغير أ = صنف_العمر(2)
متغير ب = صنف_العمر(15)
متغير ج = صنف_العمر(33)

إذا (أ == "طفل")
    اطبع("PASS: نطاق 0..13 يعمل")
وإلا
    اطبع("FAIL: نطاق 0..13 فشل -> " + أ)
نهاية

إذا (ب == "مراهق")
    اطبع("PASS: نطاق 13..20 يعمل")
وإلا
    اطبع("FAIL: نطاق 13..20 فشل -> " + ب)
نهاية

إذا (ج == "بالغ")
    اطبع("PASS: افتراضي بعد النطاق يعمل")
وإلا
    اطبع("FAIL: افتراضي بعد النطاق فشل -> " + ج)
نهاية

اطبع("=== انتهى اختبار #23 ===")
