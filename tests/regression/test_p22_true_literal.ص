# اختبار الانحدار #22 — صحيح وخطأ ليست معرّفات (literals)
# Regression Test #22 — صحيح and خطأ are boolean literals, not identifiers
# المشكلة: لا يمكن استخدامها كأسماء متغيرات (وهذا سلوك صحيح)
# الأولوية: P2
# ملاحظة: هذا الاختبار يتحقق أن القيم المنطقية تعمل بشكل صحيح

# === اختبار 1: القيم المنطقية ===
متغير أ = صحيح
متغير ب = خطأ

إذا (أ == صحيح)
    اطبع("PASS: صحيح يعمل")
وإلا
    اطبع("FAIL: صحيح فشل")
نهاية

إذا (ب == خطأ)
    اطبع("PASS: خطأ يعمل")
وإلا
    اطبع("FAIL: خطأ فشل")
نهاية

# === اختبار 2: عمليات منطقية ===
إذا (صحيح و صحيح)
    اطبع("PASS: صحيح و صحيح = صحيح")
وإلا
    اطبع("FAIL: عملية و فشلت")
نهاية

إذا (صحيح أو خطأ)
    اطبع("PASS: صحيح أو خطأ = صحيح")
وإلا
    اطبع("FAIL: عملية أو فشلت")
نهاية

إذا (ليس خطأ)
    اطبع("PASS: ليس خطأ = صحيح")
وإلا
    اطبع("FAIL: عملية ليس فشلت")
نهاية

# === اختبار 3: مقارنات ===
إذا (5 > 3)
    اطبع("PASS: 5 > 3 = صحيح")
وإلا
    اطبع("FAIL: مقارنة فشلت")
نهاية

إذا (3 != 5)
    اطبع("PASS: 3 != 5 = صحيح")
وإلا
    اطبع("FAIL: != فشلت")
نهاية

# === اختبار 4: لاشيء ===
متغير فارغ = لاشيء
إذا (فارغ == لاشيء)
    اطبع("PASS: لاشيء يعمل")
وإلا
    اطبع("FAIL: لاشيء فشل")
نهاية

