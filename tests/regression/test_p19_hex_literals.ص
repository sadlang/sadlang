# اختبار الانحدار #19 — القيم الست عشرية (hex literals) غير مدعومة
# Regression Test #19 — Hex literals (0xFF) not supported
# المشكلة: كتابة 0xFF تسبب خطأ تحليل
# الأولوية: P0
# ملاحظة: حالياً نستخدم القيم العشرية كبديل

# === اختبار 1: استخدام قيم عشرية (البديل) ===
متغير قناع = 255
إذا (قناع == 255)
    اطبع("PASS: قيمة عشرية 255 تعمل")
وإلا
    اطبع("FAIL: قيمة عشرية فشلت")
نهاية

# === اختبار 2: قيم أكبر ===
متغير لون = 65280
إذا (لون == 65280)
    اطبع("PASS: قيمة 65280 (0x00FF00) تعمل")
وإلا
    اطبع("FAIL: قيمة كبيرة فشلت")
نهاية

# === اختبار 3: عمليات بتية ===
متغير أ = 170
متغير ب = 85
اطبع("أ = " + أ + " (0xAA)")
اطبع("ب = " + ب + " (0x55)")

# === اختبار 4: عمليات حسابية على قيم كبيرة ===
متغير عنوان_PCI = 2147483648
اطبع("عنوان PCI = " + عنوان_PCI)

