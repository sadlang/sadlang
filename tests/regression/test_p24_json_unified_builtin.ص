# اختبار انحدار #24 — واجهات JSON الموحدة داخل المفسر
# Regression Test #24 — Unified JSON interpreter entry points
# الهدف: التحقق أن دوال part31 تعمل بعد استورد محرك
# الأولوية: P1

استورد محرك

متغير كائن = حلل_json("{\"x\":1,\"arr\":[2,3]}")

إذا (كائن["x"] == 1)
    اطبع("PASS: حلل_json يعيد قيمة x صحيحة")
وإلا
    اطبع("FAIL: حلل_json قيمة x غير صحيحة")
نهاية

إذا (كائن["arr"][0] == 2 و كائن["arr"][1] == 3)
    اطبع("PASS: حلل_json يعيد مصفوفة صحيحة")
وإلا
    اطبع("FAIL: حلل_json يعيد مصفوفة خاطئة")
نهاية

متغير نص1 = حول_لـjson(كائن)
إذا (طول(نص1) > 0)
    اطبع("PASS: حول_لـjson يعيد نصاً")
وإلا
    اطبع("FAIL: حول_لـjson أعاد نصاً فارغاً")
نهاية

متغير نص2 = json_منسق(كائن، 2)
إذا (طول(نص2) > 0)
    اطبع("PASS: json_منسق يعمل")
وإلا
    اطبع("FAIL: json_منسق فشل")
نهاية

متغير نص3 = json_مصغر(كائن)
إذا (طول(نص3) > 0)
    اطبع("PASS: json_مصغر يعمل")
وإلا
    اطبع("FAIL: json_مصغر فشل")
نهاية

# اختبار الأسماء الإنجليزية أيضاً
متغير كائن2 = json_parse_value("{\"ok\":true}")
إذا (كائن2["ok"] == صحيح)
    اطبع("PASS: json_parse_value يعمل")
وإلا
    اطبع("FAIL: json_parse_value فشل")
نهاية

اطبع("=== انتهى اختبار #24 ===")
