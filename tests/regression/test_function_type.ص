# اختبار نوع FUNCTION الجديد
# Test new FUNCTION type

# اختبار 1: لامبدا تُرجع FUNCTION بدل STRING
متغير جمع = لامدا أ، ب: أ + ب
متغير نتيجة = جمع(3، 5)
اطبع_سطر("نتيجة اللامبدا: " + نتيجة)

# اختبار 2: نوع اللامبدا يكون "function"
متغير نوع_اللامبدا = النوع(جمع)
اطبع_سطر("نوع اللامبدا: " + نوع_اللامبدا)

# اختبار 3: دالة من الدرجة الأولى
دالة مرحبا(اسم)
    ارجع "مرحبا " + اسم
نهاية

متغير مرجع_دالة = مرحبا
متغير نوع_الدالة = النوع(مرجع_دالة)
اطبع_سطر("نوع مرجع الدالة: " + نوع_الدالة)

# اختبار 4: استدعاء عبر المرجع
متغير نتيجة2 = مرجع_دالة("أحمد")
اطبع_سطر("نتيجة المرجع: " + نتيجة2)

# اختبار 5: تمرير دالة كمعامل
دالة نفذ(دالة_مُمرَّرة، قيمة)
    ارجع دالة_مُمرَّرة(قيمة)
نهاية

متغير نتيجة3 = نفذ(مرحبا، "سعيد")
اطبع_سطر("نتيجة التمرير: " + نتيجة3)

# اختبار 6: لامبدا بدون معاملات
متغير ثابت_خمسة = لامدا: 5
اطبع_سطر("ثابت: " + ثابت_خمسة())

# اختبار 7: لامبدا بمعامل واحد
متغير مربع = لامدا س: س * س
اطبع_سطر("مربع 7: " + مربع(7))

# اختبار 8: مقارنة مراجع الدوال
متغير مرجع1 = مرحبا
متغير مرجع2 = مرحبا
اطبع_سطر("نفس الدالة: " + (مرجع1 == مرجع2))

# اختبار 9: arrow function
متغير مضاعف = (س) => س * 2
اطبع_سطر("مضاعف 6: " + مضاعف(6))
اطبع_سطر("نوع arrow: " + النوع(مضاعف))

اطبع_سطر("=== نجح اختبار FUNCTION type ===")
