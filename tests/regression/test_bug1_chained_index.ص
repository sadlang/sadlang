# السيناريو 1: الوصول المباشر (بدون دالة) — يجب أن يعمل
اطبع("=== سيناريو 1: وصول مباشر ===")
متغير نوافذ = [{"عنوان": "نافذة1", "عرض": 20}, {"عنوان": "نافذة2", "عرض": 30}]
متغير عنوان1 = نوافذ[0]["عنوان"]
اطبع("النتيجة: " + عنوان1)

# السيناريو 2: الوصول داخل دالة (السيناريو الأصلي للمشكلة)
اطبع("=== سيناريو 2: وصول داخل دالة ===")
متغير بيانات = [{"اسم": "أحمد", "عمر": 30}, {"اسم": "سعيد", "عمر": 25}]

دالة احصل_على_اسم(فهرس)
    ارجع بيانات[فهرس]["اسم"]
نهاية

متغير الاسم = احصل_على_اسم(0)
اطبع("الاسم: " + الاسم)

# السيناريو 3: الوصول عبر متغير محلي (مرحلتين)
اطبع("=== سيناريو 3: وصول مرحلتين ===")
دالة احصل_مرحلتين(فهرس)
    متغير عنصر = بيانات[فهرس]
    ارجع عنصر["اسم"]
نهاية

متغير اسم2 = احصل_مرحلتين(1)
اطبع("الاسم: " + اسم2)

# السيناريو 4: الوصول المتسلسل داخل حلقة في دالة
اطبع("=== سيناريو 4: وصول في حلقة ===")
دالة اطبع_اسماء()
    متغير ن = 0
    بينما (ن < 2)
        متغير اسم = بيانات[ن]["اسم"]
        اطبع("اسم " + ن + ": " + اسم)
        متغير ن = ن + 1
    نهاية
نهاية

اطبع_اسماء()

# السيناريو 5: إسناد لمصفوفة خرائط arr[i]["key"] = val
اطبع("=== سيناريو 5: إسناد متسلسل ===")
دالة غير_اسم(فهرس، اسم_جديد)
    بيانات[فهرس]["اسم"] = اسم_جديد
نهاية

غير_اسم(0، "خالد")
اطبع("بعد التغيير: " + بيانات[0]["اسم"])

