# 5. كائن بدون عامل تحويل — يستخدم التمثيل الافتراضي
# ═══════════════════════════════════════
صنف بسيط
    متغير قيمة = 42
نهاية

متغير ب = جديد بسيط()
# لن يستدعي عامل نص لأنه غير موجود — يستخدم toString الافتراضي
متغير نتيجة5 = "الكائن: " + ب
# التمثيل الافتراضي يحتوي على اسم الصنف
إذا (نتيجة5 == "الكائن: ")
    ارمي "فشل10: التمثيل الافتراضي فارغ"
