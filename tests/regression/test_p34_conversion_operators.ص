# اختبار P34: عوامل التحويل الضمني (نص، منطقي، رقم)
# Implicit conversion operators test
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════
# 1. عامل نص() — تحويل ضمني لنص عند الدمج النصي
# ═══════════════════════════════════════
صنف نقطة
    متغير س = 0
    متغير ص = 0
    
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    
    عامل عام نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير ن = جديد نقطة(3، 4)
متغير نتيجة = "النقطة: " + ن
إذا (نتيجة != "النقطة: (3، 4)")
    ارمي "فشل1: عامل نص — " + نتيجة
نهاية

# اختبار: كائن + نص (الكائن على اليسار)
متغير نتيجة2 = ن + " هي نقطة"
إذا (نتيجة2 != "(3، 4) هي نقطة")
    ارمي "فشل2: نص على اليسار — " + نتيجة2
نهاية

# ═══════════════════════════════════════
# 2. عامل منطقي() — تحويل ضمني في إذا
# ═══════════════════════════════════════
صنف مجموعة
    متغير عناصر = []
    
    باني(ع)
        هذا.عناصر = ع
    نهاية
    
    عامل عام منطقي()
        ارجع طول(هذا.عناصر) > 0
    نهاية
نهاية

متغير م1 = جديد مجموعة([1، 2، 3])
متغير م2 = جديد مجموعة([])

# إذا مع كائن يملك عامل منطقي()
إذا (م1)
    # صحيح — مجموعة غير فارغة
وإلا
    ارمي "فشل3: م1 يجب أن تكون صحيحة"
نهاية

إذا (م2)
    ارمي "فشل4: م2 يجب أن تكون خاطئة"
نهاية

# ليس (NOT) مع عامل منطقي()
إذا (ليس م2)
    # صحيح — ليس فارغة = صحيح
وإلا
    ارمي "فشل5: ليس م2 يجب أن تكون صحيحة"
نهاية

# و (AND) مع عامل منطقي()
إذا (م1 و ليس م2)
    # صحيح
وإلا
    ارمي "فشل6: م1 و ليس م2"
نهاية

# أو (OR) مع عامل منطقي()
إذا (م2 أو م1)
    # صحيح — م1 صحيحة
وإلا
    ارمي "فشل7: م2 أو م1"
نهاية

# ═══════════════════════════════════════
# 3. عامل منطقي() — بينما (while)
# ═══════════════════════════════════════
صنف عداد
    متغير قيمة = 0
    
    باني(ق)
        هذا.قيمة = ق
    نهاية
    
    عامل عام منطقي()
        ارجع هذا.قيمة > 0
    نهاية
نهاية

متغير ع = جديد عداد(3)
متغير مجموع = 0
بينما (ع)
    مجموع = مجموع + ع.قيمة
    ع.قيمة = ع.قيمة - 1
نهاية

إذا (مجموع != 6)
    ارمي "فشل8: المجموع يجب أن يكون 6 لكنه " + مجموع
نهاية

# ═══════════════════════════════════════
# 4. عامل نص() مع صنف آخر
# ═══════════════════════════════════════
صنف لون
    متغير اسم = ""
    متغير كود = ""
    
    باني(اسم، كود)
        هذا.اسم = اسم
        هذا.كود = كود
    نهاية
    
    عامل عام نص()
        ارجع هذا.اسم + " (" + هذا.كود + ")"
    نهاية
نهاية

متغير أحمر = جديد لون("أحمر"، "#FF0000")
متغير نتيجة4 = "اللون: " + أحمر
إذا (نتيجة4 != "اللون: أحمر (#FF0000)")
    ارمي "فشل9: لون — " + نتيجة4
نهاية

