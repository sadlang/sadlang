# اختبار انحدار #25 — واجهات XML الموحدة داخل المفسر
# Regression Test #25 — Unified XML interpreter entry points
# الهدف: التحقق أن دوال XML الموحّدة تعمل بعد استورد خرائط
# الأولوية: P1

استورد خرائط

متغير عنصر = تحليل_وسائم("<root><n>5</n></root>")

إذا (عنصر["name"] == "root")
    اطبع("PASS: تحليل_وسائم يعيد الجذر الصحيح")
وإلا
    اطبع("FAIL: تحليل_وسائم فشل في اسم الجذر")
نهاية

إذا (طول(عنصر["children"]) == 1)
    اطبع("PASS: تحليل_وسائم يعيد الأبناء")
وإلا
    اطبع("FAIL: تحليل_وسائم عدد الأبناء غير صحيح")
نهاية

إذا (عنصر["children"][0]["name"] == "n" و عنصر["children"][0]["text"] == "5")
    اطبع("PASS: تحليل_وسائم يعيد نص العنصر الداخلي")
وإلا
    اطبع("FAIL: تحليل_وسائم يعيد محتوى خاطئ")
نهاية

متغير نص1 = تحويل_وسائم(عنصر)
إذا (طول(نص1) > 0)
    اطبع("PASS: تحويل_وسائم يعمل")
وإلا
    اطبع("FAIL: تحويل_وسائم فشل")
نهاية

متغير نص2 = تنسيق_وسائم(عنصر، 2)
إذا (طول(نص2) > 0)
