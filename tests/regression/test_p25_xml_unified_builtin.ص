# اختبار انحدار #25 — واجهات XML الموحدة داخل المفسر
# Regression Test #25 — Unified XML interpreter entry points
# الهدف: التحقق أن دوال XML الموحّدة تعمل بعد استورد محرك
# الأولوية: P1

استورد محرك

متغير عنصر = حلل_xml("<root><n>5</n></root>")

إذا (عنصر["name"] == "root")
    اطبع("PASS: حلل_xml يعيد الجذر الصحيح")
وإلا
    اطبع("FAIL: حلل_xml فشل في اسم الجذر")
نهاية

إذا (طول(عنصر["children"]) == 1)
    اطبع("PASS: حلل_xml يعيد الأبناء")
وإلا
    اطبع("FAIL: حلل_xml عدد الأبناء غير صحيح")
نهاية

إذا (عنصر["children"][0]["name"] == "n" و عنصر["children"][0]["text"] == "5")
    اطبع("PASS: حلل_xml يعيد نص العنصر الداخلي")
وإلا
    اطبع("FAIL: حلل_xml يعيد محتوى خاطئ")
نهاية

متغير نص1 = حول_لـxml(عنصر)
إذا (طول(نص1) > 0)
    اطبع("PASS: حول_لـxml يعمل")
وإلا
    اطبع("FAIL: حول_لـxml فشل")
نهاية

متغير نص2 = xml_منسق(عنصر، 2)
إذا (طول(نص2) > 0)
    اطبع("PASS: xml_منسق يعمل")
وإلا
    اطبع("FAIL: xml_منسق فشل")
نهاية

متغير نص3 = xml_مصغر(عنصر)
إذا (طول(نص3) > 0)
    اطبع("PASS: xml_مصغر يعمل")
وإلا
    اطبع("FAIL: xml_مصغر فشل")
نهاية

