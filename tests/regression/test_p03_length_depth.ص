# اختبار الانحدار #3 — .الطول() عند عمق استدعاء >= 2
# Regression Test #3 — .length() crashes at call depth >= 2
# المشكلة: الطول() تعمل في عمق 1 لكن تنهار في عمق 2+
# الأولوية: P0 (عاجل)

متغير عناصر = [1, 2, 3, 4, 5]

# === اختبار 1: طول مباشر (عمق 0) ===
متغير ط0 = عناصر.الطول()
إذا (ط0 == 5)
    اطبع("PASS: الطول() عمق 0 يعمل")
وإلا
    اطبع("FAIL: الطول() عمق 0 = " + ط0)
نهاية

# === اختبار 2: طول في دالة (عمق 1) ===
دالة احصل_طول()
    ارجع عناصر.الطول()
نهاية

متغير ط1 = احصل_طول()
إذا (ط1 == 5)
    اطبع("PASS: الطول() عمق 1 يعمل")
وإلا
    اطبع("FAIL: الطول() عمق 1 = " + ط1)
نهاية

# === اختبار 3: طول عبر دالة تستدعي دالة (عمق 2) — المشكلة الأصلية ===
دالة دالة_وسيطة()
    متغير ط = احصل_طول()
    ارجع ط
نهاية

متغير ط2 = دالة_وسيطة()
إذا (ط2 == 5)
    اطبع("PASS: الطول() عمق 2 يعمل")
وإلا
    اطبع("FAIL: الطول() عمق 2 = " + ط2)
نهاية

# === اختبار 4: طول في عمق 3 ===
دالة عمق_ثالث()
    ارجع دالة_وسيطة()
نهاية

متغير ط3 = عمق_ثالث()
إذا (ط3 == 5)
    اطبع("PASS: الطول() عمق 3 يعمل")
وإلا
    اطبع("FAIL: الطول() عمق 3 = " + ط3)
نهاية

اطبع("=== انتهى اختبار #3 ===")
