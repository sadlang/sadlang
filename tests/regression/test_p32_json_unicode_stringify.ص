# اختبار انحدار #32 — تصدير Unicode escapes في JSON stringify
# Regression Test #32 — JSON Unicode escape stringify (\uXXXX output)
# الهدف: التحقق أن حول_لـjson يصدّر non-ASCII كـ \uXXXX
# الأولوية: P1

استورد محرك

# اختبار 1: round-trip عربي
متغير أصل = حلل_json("{\"name\":\"\\u0645\\u0631\\u062d\\u0628\\u0627\"}")
متغير ناتج = حول_لـjson(أصل)
متغير نسخة = حلل_json(ناتج)
إذا (نسخة["name"] == "مرحبا")
    اطبع("PASS: round-trip arabic")
وإلا
    اطبع("FAIL: round-trip arabic")
نهاية

# اختبار 2: round-trip إيموجي
متغير إ_أصل = حلل_json("{\"e\":\"\\uD83D\\uDE00\"}")
متغير إ_ناتج = حول_لـjson(إ_أصل)
متغير إ_نسخة = حلل_json(إ_ناتج)
إذا (إ_نسخة["e"] == إ_أصل["e"])
    اطبع("PASS: round-trip emoji")
وإلا
    اطبع("FAIL: round-trip emoji")
نهاية

# اختبار 3: ASCII لا يتحول
متغير أ = حلل_json("{\"x\":\"hello\"}")
متغير ن = حول_لـjson(أ)
إذا (ن == "{\"x\":\"hello\"}")
    اطبع("PASS: ascii unchanged")
وإلا
    اطبع("FAIL: ascii changed")
نهاية

# اختبار 4: round-trip كائن مركب مع unicode و أرقام
متغير مركب = حلل_json("{\"x\":42,\"name\":\"\\u0639\\u0631\\u0628\\u064a\"}")
متغير م_ناتج = حول_لـjson(مركب)
متغير م_نسخة = حلل_json(م_ناتج)
إذا (م_نسخة["x"] == 42 و م_نسخة["name"] == "عربي")
    اطبع("PASS: round-trip complex")
وإلا
    اطبع("FAIL: round-trip complex")
نهاية

