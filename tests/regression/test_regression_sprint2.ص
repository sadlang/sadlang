# ═══════════════════════════════════════════════════════
# اختبار 3: OOP parameter shadowing — كان الحقل يُظلل المعامل
# ═══════════════════════════════════════════════════════
اطبع_سطر("=== اختبار OOP parameter shadowing ===")

صنف حساب
    باني(رصيد)
        هذا.رصيد = رصيد
    نهاية

    دالة إيداع(رصيد)
        هذا.رصيد = هذا.رصيد + رصيد
    نهاية

    دالة سحب(رصيد)
        هذا.رصيد = هذا.رصيد - رصيد
    نهاية

    دالة الرصيد()
        ارجع هذا.رصيد
    نهاية
نهاية

# 3.1 إيداع بنفس اسم الحقل
متغير ح1 = جديد حساب(100)
ح1.إيداع(50)
تأكد("إيداع 50 على 100", ح1.الرصيد(), 150)

# 3.2 سحب بنفس اسم الحقل
ح1.سحب(30)
تأكد("سحب 30 من 150", ح1.الرصيد(), 120)

# 3.3 إيداع وسحب متكرر
متغير ح2 = جديد حساب(0)
ح2.إيداع(100)
ح2.إيداع(200)
ح2.سحب(50)
تأكد("0 + 100 + 200 - 50", ح2.الرصيد(), 250)

# 3.4 معامل مختلف عن الحقل (يجب أن يعمل أيضاً)
صنف صندوق
    باني(عرض، ارتفاع)
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية

    دالة مساحة()
        ارجع هذا.عرض * هذا.ارتفاع
    نهاية

    دالة تكبير(مضاعف)
        هذا.عرض = هذا.عرض * مضاعف
        هذا.ارتفاع = هذا.ارتفاع * مضاعف
    نهاية
نهاية

متغير ص1 = جديد صندوق(5, 3)
تأكد("مساحة 5×3", ص1.مساحة(), 15)
ص1.تكبير(2)
تأكد("مساحة بعد تكبير ×2", ص1.مساحة(), 60)

