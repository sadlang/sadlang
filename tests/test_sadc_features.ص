# 3. اختبار حالة (switch)
دالة اختبار_حالة(يوم)
   حالة (يوم)
      عندما 1:
         ارجع "السبت"
      عندما 2:
         ارجع "الأحد"
      عندما 3:
         ارجع "الاثنين"
      افتراضي:
         ارجع "مجهول"
   نهاية
نهاية

