من مكتبات_خارجية.تعبيرات_منتظمة.src.محلل استورد محلل
من مكتبات_خارجية.تعبيرات_منتظمة.src.مطابق استورد محرك

# دالة حساب المجموعات المحلية
دالة رقم احسب_مجموعات_ل(شجرة)
    إذا (شجرة == لاشيء)
        ارجع 0
    نهاية
    ارجع 0
نهاية

صنف تعبير_ت
    متغير الشجرة
    متغير المحرك_ت
    رقم الأعلام
    رقم عدد_المجموعات

    باني(نص نمط_م)
        هذا.الشجرة = لاشيء
        هذا.المحرك_ت = لاشيء
        هذا.الأعلام = 0
        هذا.عدد_المجموعات = 0
        متغير مح = جديد محلل(نمط_م, 0)
        متغير شج = مح.تحليل()
        متغير عدد = احسب_مجموعات_ل(شج)
        هذا.الشجرة = شج
        هذا.عدد_المجموعات = عدد
        متغير مح_م = جديد محرك(شج, عدد, 0)
        هذا.المحرك_ت = مح_م
    نهاية

    دالة اعرض()
        اطبع_سطر("النوع:")
        اطبع_سطر(هذا.الشجرة.النوع)
        اطبع_سطر("محرك موجود؟")
        إذا (هذا.المحرك_ت != لاشيء)
            اطبع_سطر("نعم")
        وإلا
            اطبع_سطر("لا")
        نهاية
    نهاية

    دالة رقم يحتوي(نص ن)
        متغير م = هذا
        متغير المحرك_م = م.المحرك_ت
        اطبع_سطر("محرك_م نوع في يحتوي:")
        متغير حالة_م = المحرك_م.ابحث_من(ن, 0)
        إذا (حالة_م == لاشيء)
            ارجع 0
        نهاية
        ارجع 1
    نهاية
نهاية

