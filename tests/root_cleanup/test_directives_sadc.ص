# اختبار التوجيهات مع مترجم sadc
# Test directives with sadc compiler

# اختبار @حجم
دالة اختبر_حجم()
    متغير حجم_رقم = @حجم(رقم)
    اطبع_سطر("حجم رقم: " + حجم_رقم)
    
    متغير حجم_عشري = @حجم(عشري)
    اطبع_سطر("حجم عشري: " + حجم_عشري)
    
    متغير حجم_نص = @حجم(نص)
    اطبع_سطر("حجم نص: " + حجم_نص)
    
    ارجع حجم_رقم == 8
نهاية

# اختبار @متطاير
دالة اختبر_متطاير()
    @متطاير متغير عداد = 0
    عداد = عداد + 1
    اطبع_سطر("المتطاير: " + عداد)
    ارجع صحيح
نهاية

# اختبار @غير_آمن
دالة اختبر_غير_آمن()
    متغير س = 10
    @غير_آمن
        س = س * 2
    نهاية
    اطبع_سطر("بعد غير_آمن: " + س)
    ارجع س == 20
نهاية

# اختبار @وقت_الترجمة
دالة اختبر_وقت_الترجمة()
    @وقت_الترجمة
        متغير ثابت_ترجمة = 100 + 200
    نهاية
    اطبع_سطر("وقت الترجمة يعمل")
    ارجع صحيح
نهاية

# الدالة الرئيسية
دالة رئيسية()
    اطبع_سطر("=== اختبار التوجيهات مع sadc ===")
    
    متغير نجاح1 = اختبر_حجم()
    متغير نجاح2 = اختبر_متطاير()
    متغير نجاح3 = اختبر_غير_آمن()
    متغير نجاح4 = اختبر_وقت_الترجمة()
    
    إذا (نجاح1 و نجاح2 و نجاح3 و نجاح4)
        اطبع_سطر("✅ جميع الاختبارات نجحت!")
    وإلا
        اطبع_سطر("❌ بعض الاختبارات فشلت")
    نهاية
    
    ارجع 0
نهاية
