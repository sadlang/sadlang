# اختبار وراثة مع استدعاء باني الأساس
صنف حيوان
    متغير الاسم
    باني(اسم)
        هذا.الاسم = اسم
    نهاية
    دالة صوت()
        اطبع("حيوان: " + هذا.الاسم)
    نهاية
نهاية

صنف قطة يرث حيوان
    متغير اللون
    باني(اسم، لون)
        الأساس(اسم)
        هذا.اللون = لون
    نهاية
    دالة عرض()
        اطبع("قطة: " + هذا.الاسم + " - " + هذا.اللون)
    نهاية
نهاية

متغير ق = جديد قطة("ميمي"، "أبيض")
ق.عرض()
ق.صوت()
