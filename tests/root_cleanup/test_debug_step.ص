من مكتبات_خارجية.تعبيرات_منتظمة.src.محلل استورد محلل
من مكتبات_خارجية.تعبيرات_منتظمة.src.مطابق استورد محرك، حالة_مطابقة
من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد احسب_مجموعات، م_بحث، م_ابحث_من

## نفس منطق بحث() المستقلة، لكن خطوة بخطوة
متغير نمط = "<.+?>"
متغير نص = "<مرحبا><عالم>"
متغير أعلام = 0

اطبع("الخطوة 1: إنشاء محلل...")
متغير مح_ل = جديد محلل(نمط، أعلام)
اطبع_سطر("✓ محلل: " + مح_ل)

اطبع("الخطوة 2: تحليل...")
متغير شج_م = مح_ل.تحليل()
اطبع_سطر("✓ شجرة: (موجودة)")

اطبع("الخطوة 3: احسب مجموعات...")
متغير عدد_م = احسب_مجموعات(شج_م)
اطبع_سطر("✓ عدد_م = " + عدد_م)

اطبع("الخطوة 4: إنشاء محرك...")
متغير مح_م = جديد محرك(شج_م، عدد_م، أعلام)
اطبع_سطر("✓ محرك: " + مح_م)

اطبع("الخطوة 5: م_ابحث_من مباشرة...")
متغير حالة_م = م_ابحث_من(مح_م.الشجرة، عدد_م، أعلام، نص، 0)
اطبع("✓ حالة_م = ")
اطبع_سطر(حالة_م)

إذا (حالة_م != لاشيء)
    اطبع("المجموعة 0 = ")
    اطبع_سطر(حالة_م.المجموعات)
