## اختبار 1: طابق حرف بسيط
متغير مح_ل = جديد محلل("a"، 0)
متغير شجرة = مح_ل.تحليل()
متغير مح = جديد محرك(شجرة، 0، 0)
متغير الحالة = جديد حالة_مطابقة("a"، 0، 0)
متغير نتيجة = مح.طابق_عقدة(شجرة، "a"، 0، الحالة)
إذا (نتيجة == 1)
    اطبع_سطر("اختبار 1 نجح: طابق 'a'")
وإلا
    اطبع_سطر("اختبار 1 فشل: نتيجة=" + نتيجة)
