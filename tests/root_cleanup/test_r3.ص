## Debug with ASCII

صنف معالج
    رقم ن

    باني(رقم ابتداء)
        هذا.ن = ابتداء
    نهاية

    دالة معالج_داخلي()
        متغير م = هذا
        م.ن = م.ن + 1
        ارجع "X"
    نهاية

    دالة تشغيل()
        متغير م = هذا
        متغير نتيجة = ""
        بينما (م.ن < 3)
            متغير طفل = م.معالج_داخلي()
            نتيجة = نتيجة + طفل
        نهاية
        ارجع نتيجة
    نهاية
نهاية

متغير م = جديد معالج(0)
متغير ر = م.تشغيل()
اطبع("نتيجة=[")
اطبع(ر)
اطبع("] طول=")
اطبع_سطر(طول(ر))
