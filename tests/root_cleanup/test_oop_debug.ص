صنف نقطة
    متغير س = 0
    متغير ص = 0

    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة المسافة()
        ارجع (هذا.س * هذا.س) + (هذا.ص * هذا.ص)
    نهاية
نهاية

دالة رئيسية()
    اطبع("بدء إنشاء الكائنات...")
    متغير ن1 = جديد نقطة(3، 4)
    متغير ن2 = جديد نقطة(5، 12)
    
    متغير مسافة1 = ن1.المسافة()
    متغير مسافة2 = ن2.المسافة()
    
    اطبع("المسافة الأولى: " + مسافة1)
    اطبع("المسافة الثانية: " + مسافة2)
نهاية

رئيسية()