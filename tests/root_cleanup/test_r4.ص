## Debug with ASCII AND recursive call

صنف معالج
    رقم ن

    باني(رقم ابتداء)
        هذا.ن = ابتداء
    نهاية

    دالة معالج_داخلي()
        متغير م = هذا
        م.ن = م.ن + 1
        # RECURSIVE CALL: calls تشغيل which exhausts remaining iterations
        متغير نت = م.تشغيل()
        ارجع "X(" + نت + ")"
    نهاية

    دالة تشغيل()
        متغير م = هذا
        متغير نتيجة = ""
        بينما (م.ن < 3)
            متغير طفل = م.معالج_داخلي()
            نتيجة = نتيجة + طفل
        نهاية
        ارجع نتيجة
    نهاية
نهاية

# Expected: ن=0: تشغيل → 1 iter → معالج_داخلي → ن=1 → تشغيل (recursive)
# Recursive: ن=1: تشغيل → 1 iter → معالج_داخلي → ن=2 → تشغيل (recursive)
# Inner-inner: ن=2: تشغيل → 1 iter → معالج_داخلي → ن=3 → تشغيل → loop(3<3=false) → ""
# Returns up: X() → X(X()) → X(X(X()))
# So outer final نتيجة = "X(X(X()))"
متغير م = جديد معالج(0)
متغير ر = م.تشغيل()
اطبع("نتيجة=[")
اطبع(ر)
اطبع("] طول=")
اطبع_سطر(طول(ر))
اطبع("ن=")
اطبع_سطر(م.ن)
