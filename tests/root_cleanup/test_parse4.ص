## Test: trace parsing step-by-step
من مكتبات_خارجية.تعبيرات_منتظمة.src.عقد استورد ن_نوع
من مكتبات_خارجية.تعبيرات_منتظمة.src.محلل استورد محلل

# اختبار بسيط: abc
متغير م1 = جديد محلل("abc"، 0)
متغير ن1 = م1.تحليل()
اطبع("abc → نوع: ")
اطبع_سطر(ن1.النوع)
اطبع("موضع بعد abc: ")
اطبع_سطر(م1.الموضع)

# اختبار مجموعة
متغير م2 = جديد محلل("(abc)"، 0)
اطبع("=== بدء تحليل (abc) ===")
متغير ن2 = م2.تحليل()
اطبع("(abc) → نوع: ")
اطبع_سطر(ن2.النوع)
اطبع("موضع بعد (abc): ")
اطبع_سطر(م2.الموضع)

# هل لها طفل؟
إذا (ن2.النوع == 6)
    اطبع("طفل النوع: ")
    اطبع_سطر(ن2.طفل.النوع)
نهاية

إذا (ن2.النوع == 5)
    اطبع("تناوب! عدد الخيارات: ")
    اطبع_سطر(طول(ن2.الخيارات))
    اطبع("الخيار [0] نوع: ")
    اطبع_سطر(ن2.الخيارات[0].النوع)
