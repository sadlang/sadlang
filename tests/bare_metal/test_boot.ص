# ════════════════════════════════════════════════════════════════════════════════
# اختبار الإقلاع — يبدأ ويكتب "BeeOS" على المنفذ التسلسلي
# Test: Boot — starts and writes "BeeOS" to serial port
# ════════════════════════════════════════════════════════════════════════════════

#[بلا_مكتبة_قياسية]
#[نظام_تشغيل("bare_metal")]

# عنوان UART COM1 / UART COM1 port address
ثابت منفذ_التسلسلي: ع16 = 0x3F8

# تهيئة المنفذ التسلسلي / Initialize serial port
دالة تهيئة_تسلسلي() 
    منفذ_كتابة(منفذ_التسلسلي + 1, 0x00)    # تعطيل المقاطعات / Disable interrupts
    منفذ_كتابة(منفذ_التسلسلي + 3, 0x80)    # تمكين DLAB / Enable DLAB
    منفذ_كتابة(منفذ_التسلسلي + 0, 0x03)    # معدل البود 38400 / Baud rate 38400
    منفذ_كتابة(منفذ_التسلسلي + 1, 0x00)
    منفذ_كتابة(منفذ_التسلسلي + 3, 0x03)    # 8 بت، بلا تماثل / 8 bits, no parity
    منفذ_كتابة(منفذ_التسلسلي + 2, 0xC7)    # تمكين FIFO / Enable FIFO
    منفذ_كتابة(منفذ_التسلسلي + 4, 0x0B)    # IRQ مُمكّن / IRQ enabled
نهاية

# كتابة حرف على المنفذ التسلسلي / Write character to serial port
دالة كتابة_حرف(ح: ع8) 
    # الانتظار حتى يكون المُخرج فارغاً / Wait for transmit buffer empty
    طالما (منفذ_قراءة(منفذ_التسلسلي + 5) & 0x20) == 0 {
        # انتظار / Wait
    }
    منفذ_كتابة(منفذ_التسلسلي, ح)
نهاية

# كتابة سلسلة على المنفذ التسلسلي / Write string to serial port
دالة كتابة_سلسلة(نص: *ثابت ع8, طول: ع32) 
    لكل ف في 0..طول {
        كتابة_حرف(نص[ف])
    }
نهاية

# نقطة الدخول / Entry point
#[نقطة_دخول]
دالة _start() -> ! 
    تهيئة_تسلسلي()
    
    # اكتب "BeeOS" / Write "BeeOS"
    كتابة_حرف(0x42)  # B
    كتابة_حرف(0x65)  # e
    كتابة_حرف(0x65)  # e
    كتابة_حرف(0x4F)  # O
    كتابة_حرف(0x53)  # S
    كتابة_حرف(0x0A)  # \n
    
    # الخروج من QEMU عبر debug exit / Exit QEMU via debug exit
    منفذ_كتابة(0xF4, 0x00)
    
    # حلقة لا نهائية / Infinite loop
    حلقة 
        توقف()
    نهاية
نهاية
