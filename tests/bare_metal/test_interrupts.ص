// ════════════════════════════════════════════════════════════════════════════════
// اختبار المقاطعات — يُسجل معالج timer ويتحقق من استدعائه
// Test: Interrupts — registers timer handler and verifies it was called
// ════════════════════════════════════════════════════════════════════════════════

#[بلا_مكتبة_قياسية]
#[نظام_تشغيل("bare_metal")]

ثابت منفذ_التسلسلي: ع16 = 0x3F8

// عداد المقاطعات / Interrupt counter
متغير عداد_المقاطعات: ع64 = 0

// جدول وصف المقاطعات / IDT entry
بنية مدخلة_idt {
    عنوان_منخفض: ع16,
    محدد: ع16,
    صفر: ع8,
    سمات: ع8,
    عنوان_مرتفع: ع16,
}

// تهيئة المنفذ التسلسلي / Initialize serial port
دالة تهيئة_تسلسلي() {
    منفذ_كتابة(منفذ_التسلسلي + 1, 0x00)
    منفذ_كتابة(منفذ_التسلسلي + 3, 0x80)
    منفذ_كتابة(منفذ_التسلسلي + 0, 0x03)
    منفذ_كتابة(منفذ_التسلسلي + 1, 0x00)
    منفذ_كتابة(منفذ_التسلسلي + 3, 0x03)
    منفذ_كتابة(منفذ_التسلسلي + 2, 0xC7)
    منفذ_كتابة(منفذ_التسلسلي + 4, 0x0B)
}

دالة كتابة_حرف(ح: ع8) {
    طالما (منفذ_قراءة(منفذ_التسلسلي + 5) & 0x20) == 0 {}
    منفذ_كتابة(منفذ_التسلسلي, ح)
}

دالة كتابة_سلسلة_ثابتة(نص: *ثابت ع8, طول: ع32) {
    لكل ف في 0..طول {
        كتابة_حرف(نص[ف])
    }
}

// معالج مقاطعة المؤقت / Timer interrupt handler
#[معالج_مقاطعة(32)]
دالة معالج_المؤقت() {
    عداد_المقاطعات += 1
    
    // إرسال EOI لـ PIC / Send EOI to PIC
    منفذ_كتابة(0x20, 0x20)
}

// تهيئة PIC / Initialize PIC
دالة تهيئة_pic() {
    // ICW1: تهيئة / Initialize
    منفذ_كتابة(0x20, 0x11)
    منفذ_كتابة(0xA0, 0x11)
    
    // ICW2: تعيين base offset / Set base offset
    منفذ_كتابة(0x21, 0x20)   // IRQ 0-7 → INT 32-39
    منفذ_كتابة(0xA1, 0x28)   // IRQ 8-15 → INT 40-47
    
    // ICW3: إعداد التسلسل / Cascading setup
    منفذ_كتابة(0x21, 0x04)
    منفذ_كتابة(0xA1, 0x02)
    
    // ICW4: وضع 8086 / 8086 mode
    منفذ_كتابة(0x21, 0x01)
    منفذ_كتابة(0xA1, 0x01)
    
    // تمكين IRQ0 (المؤقت) فقط / Enable only IRQ0 (timer)
    منفذ_كتابة(0x21, 0xFE)
    منفذ_كتابة(0xA1, 0xFF)
}

// نقطة الدخول / Entry point
#[نقطة_دخول]
دالة _start() -> ! {
    تهيئة_تسلسلي()
    تهيئة_pic()
    
    // تمكين المقاطعات / Enable interrupts
    __asm__("sti")
    
    // الانتظار حتى يتم استدعاء المعالج / Wait for handler to be called
    متغير محاولات: ع32 = 0
    طالما عداد_المقاطعات == 0 && محاولات < 100000 {
        محاولات += 1
    }
    
    إذا عداد_المقاطعات > 0 {
        // نجاح / Success
        كتابة_حرف(0x50)  // P
        كتابة_حرف(0x41)  // A
        كتابة_حرف(0x53)  // S
        كتابة_حرف(0x53)  // S
    } وإلا {
        // فشل / Failure
        كتابة_حرف(0x46)  // F  
        كتابة_حرف(0x41)  // A
        كتابة_حرف(0x49)  // I
        كتابة_حرف(0x4C)  // L
    }
    
    كتابة_حرف(0x0A)  // \n
    
    // الخروج من QEMU / Exit QEMU
    منفذ_كتابة(0xF4, 0x00)
    
    حلقة {
        توقف()
    }
}
