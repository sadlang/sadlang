// ════════════════════════════════════════════════════════════════════════════════
// اختبار ترحيل الصفحات — يُفعّل ترحيل الصفحات ويصل لعنوان افتراضي
// Test: Paging — enables paging and accesses a virtual address
// ════════════════════════════════════════════════════════════════════════════════

#[بلا_مكتبة_قياسية]
#[نظام_تشغيل("bare_metal")]

ثابت منفذ_التسلسلي: ع16 = 0x3F8

// أحجام الصفحات / Page sizes
ثابت حجم_الصفحة: ع64 = 4096

// أعلام جدول الصفحات / Page table flags
ثابت علم_موجود: ع64 = 0x01
ثابت علم_كتابة: ع64 = 0x02
ثابت علم_صفحة_كبيرة: ع64 = 0x80

// تهيئة المنفذ التسلسلي / Initialize serial port
دالة تهيئة_تسلسلي() {
    منفذ_كتابة(منفذ_التسلسلي + 1, 0x00)
    منفذ_كتابة(منفذ_التسلسلي + 3, 0x80)
    منفذ_كتابة(منفذ_التسلسلي + 0, 0x03)
    منفذ_كتابة(منفذ_التسلسلي + 1, 0x00)
    منفذ_كتابة(منفذ_التسلسلي + 3, 0x03)
    منفذ_كتابة(منفذ_التسلسلي + 2, 0xC7)
    منفذ_كتابة(منفذ_التسلسلي + 4, 0x0B)
}

دالة كتابة_حرف(ح: ع8) {
    طالما (منفذ_قراءة(منفذ_التسلسلي + 5) & 0x20) == 0 {}
    منفذ_كتابة(منفذ_التسلسلي, ح)
}

// جداول الصفحات — محاذاة 4KB / Page tables — 4KB aligned
#[قسم(".page_tables")]
#[محاذاة(4096)]
متغير pml4: [ع64; 512] = [0; 512]

#[قسم(".page_tables")]
#[محاذاة(4096)]
متغير pdpt: [ع64; 512] = [0; 512]

#[قسم(".page_tables")]
#[محاذاة(4096)]
متغير pd: [ع64; 512] = [0; 512]

#[قسم(".page_tables")]
#[محاذاة(4096)]
متغير pt: [ع64; 512] = [0; 512]

// تهيئة جداول الصفحات — identity mapping أول 2MB
// Initialize page tables — identity map first 2MB
دالة تهيئة_ترحيل() {
    // PML4[0] → PDPT
    pml4[0] = (عنوان(&pdpt) ك ع64) | علم_موجود | علم_كتابة
    
    // PDPT[0] → PD
    pdpt[0] = (عنوان(&pd) ك ع64) | علم_موجود | علم_كتابة
    
    // PD[0] → PT
    pd[0] = (عنوان(&pt) ك ع64) | علم_موجود | علم_كتابة
    
    // ربط أول 512 صفحة (2MB) / Map first 512 pages (2MB)
    لكل ف في 0..512 {
        pt[ف] = (ف * حجم_الصفحة) | علم_موجود | علم_كتابة
    }
    
    // تحميل CR3 / Load CR3
    __asm__("mov cr3, {0}", دخل = (عنوان(&pml4) ك ع64))
}

// اختبار الوصول لعنوان افتراضي / Test accessing virtual address
دالة اختبار_وصول() -> منطقي {
    // كتابة قيمة في عنوان / Write value at address
    متغير عنوان_اختبار: *متغير ع32 = 0x1000 ك *متغير ع32
    *عنوان_اختبار = 0xDEADBEEF
    
    // قراءة والتحقق / Read back and verify
    متغير قيمة = *عنوان_اختبار
    أرجع قيمة == 0xDEADBEEF
}

// نقطة الدخول / Entry point
#[نقطة_دخول]
دالة _start() -> ! {
    تهيئة_تسلسلي()
    تهيئة_ترحيل()
    
    إذا اختبار_وصول() {
        // نجاح / Success — "PAGE OK"
        كتابة_حرف(0x50)  // P
        كتابة_حرف(0x41)  // A
        كتابة_حرف(0x47)  // G
        كتابة_حرف(0x45)  // E
        كتابة_حرف(0x20)  // (space)
        كتابة_حرف(0x4F)  // O
        كتابة_حرف(0x4B)  // K
    } وإلا {
        كتابة_حرف(0x46)  // F
        كتابة_حرف(0x41)  // A
        كتابة_حرف(0x49)  // I
        كتابة_حرف(0x4C)  // L
    }
    
    كتابة_حرف(0x0A)  // \n
    
    // الخروج من QEMU / Exit QEMU
    منفذ_كتابة(0xF4, 0x00)
    
    حلقة {
        توقف()
    }
}
