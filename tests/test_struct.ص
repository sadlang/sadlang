# اختبار البنية (struct)

بنية نقطة
    رقم س = 0
    رقم ص = 0
نهاية

متغير ن = نقطة(3, 5)
اطبع_سطر("س = " + ن.س)
اطبع_سطر("ص = " + ن.ص)

بنية شخص
    نص الاسم = "مجهول"
    رقم العمر = 0
نهاية

متغير أحمد = شخص("أحمد", 30)
اطبع_سطر("الاسم: " + أحمد.الاسم)
اطبع_سطر("العمر: " + أحمد.العمر)

اطبع_سطر("=== اختبار البنية نجح ===")
