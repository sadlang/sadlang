# اختبار كتابة التغييرات المتداخلة (writeBackChain)

# اختبار 1 - كتابة مباشرة (تأكيد أن الحالة الأساسية تعمل)
متغير مصفوفة1 = [1، 2، 3]
مصفوفة1.اضف(4)
إذا (مصفوفة1.الطول() == 4)
    اطبع_سطر("اختبار 1 - اضف مباشر: نجح")
وإلا
    اطبع_سطر("اختبار 1 - اضف مباشر: فشل - الطول = " + مصفوفة1.الطول())
نهاية

