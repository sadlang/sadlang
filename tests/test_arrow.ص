# اختبار الدوال السهمية (Arrow Functions)

# 1. دالة سهمية بمعامل واحد بدون أقواس
متغير ضعف = x => x * 2
اطبع_سطر("1. ضعف 5: " + ضعف(5))

# 2. دالة سهمية بمعاملين
متغير جمع = (أ, ب) => أ + ب
اطبع_سطر("2. جمع 3+4: " + جمع(3, 4))

# 3. دالة سهمية بدون معاملات
متغير تحية = () => "مرحبا بالعالم!"
اطبع_سطر("3. " + تحية())

# 4. دالة سهمية بمعامل واحد بين أقواس
متغير مربع = (ن) => ن * ن
اطبع_سطر("4. مربع 6: " + مربع(6))

# 5. استخدام مع مصفوفة
متغير أرقام = [1, 2, 3, 4, 5]
متغير النتيجة = 0
لكل ر في أرقام
    النتيجة = النتيجة + (x => x * x)(ر)
نهاية
اطبع_سطر("5. مجموع المربعات: " + النتيجة)

# 6. تمرير دالة سهمية كمعامل
دالة طبق(قيمة, دالة_تحويل)
    ارجع دالة_تحويل(قيمة)
نهاية
اطبع_سطر("6. تطبيق تكعيب: " + طبق(3, ق => ق * ق * ق))
