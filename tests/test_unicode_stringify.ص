# اختبار تصدير Unicode escapes في json_stringify
استورد محرك

# اختبار 1: نص عربي يُصدّر كـ \uXXXX
متغير كائن = حلل_json("{\"name\":\"مرحبا\"}")
متغير نص_json = حول_لـjson(كائن)
اطبع("JSON output: " + نص_json)

# يجب أن يحتوي على \u0645 (م)
إذا (طول(نص_json) > 10)
    اطبع("PASS: تصدير Unicode - الناتج طويل كما متوقع")
وإلا
    اطبع("FAIL: الناتج قصير جداً")
نهاية

# اختبار 2: round-trip — parse → stringify → parse
متغير أصل = "{\"x\":1,\"name\":\"\\u0645\\u0631\\u062d\\u0628\\u0627\"}"
متغير كائن2 = حلل_json(أصل)
متغير ناتج = حول_لـjson(كائن2)
متغير كائن3 = حلل_json(ناتج)

إذا (كائن3["name"] == "مرحبا")
    اطبع("PASS: round-trip عربي")
وإلا
    اطبع("FAIL: round-trip عربي — حصلنا: " + كائن3["name"])
نهاية

إذا (كائن3["x"] == 1)
    اطبع("PASS: round-trip رقم")
وإلا
    اطبع("FAIL: round-trip رقم")
نهاية

# اختبار 3: إيموجي round-trip
متغير كا = حلل_json("{\"e\":\"\\uD83D\\uDE00\"}")
متغير نص_إيموجي = حول_لـjson(كا)
اطبع("Emoji JSON: " + نص_إيموجي)
متغير كا2 = حلل_json(نص_إيموجي)
إذا (كا2["e"] == كا["e"])
    اطبع("PASS: round-trip إيموجي")
وإلا
    اطبع("FAIL: round-trip إيموجي")
نهاية

# اختبار 4: ASCII يبقى كـ ASCII
متغير كا3 = حلل_json("{\"hello\":\"world\"}")
متغير نص4 = حول_لـjson(كا3)
إذا (نص4 == "{\"hello\":\"world\"}")
    اطبع("PASS: ASCII لا يتغير")
وإلا
    اطبع("INFO: ASCII output: " + نص4)
نهاية

اطبع("=== انتهى اختبار stringify Unicode ===")
