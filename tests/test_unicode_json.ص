# اختبار دعم Unicode escapes في JSON parser
استورد محرك

# اختبار 1: ASCII عبر \u
متغير ر1 = تحليل_جيسون("{\"name\":\"\\u0041\\u0042\\u0043\"}")
إذا (ر1["name"] == "ABC")
    اطبع("PASS: \\u لأحرف ASCII")
وإلا
    اطبع("FAIL: \\u لأحرف ASCII — حصلنا: " + ر1["name"])
نهاية

# اختبار 2: عربي عبر \u
متغير ر2 = تحليل_جيسون("{\"text\":\"\\u0645\\u0631\\u062d\\u0628\\u0627\"}")
إذا (ر2["text"] == "مرحبا")
    اطبع("PASS: \\u لنص عربي")
وإلا
    اطبع("FAIL: \\u لنص عربي — حصلنا: " + ر2["text"])
نهاية

# اختبار 3: رموز خاصة (Copyright ©)
متغير ر3 = تحليل_جيسون("{\"sym\":\"\\u00A9\"}")
إذا (طول(ر3["sym"]) > 0)
    اطبع("PASS: \\u لرمز خاص ©")
وإلا
    اطبع("FAIL: \\u لرمز خاص")
نهاية

# اختبار 4: إيموجي عبر surrogate pair (😀 = U+1F600 = \uD83D\uDE00)
متغير ر4 = تحليل_جيسون("{\"emoji\":\"\\uD83D\\uDE00\"}")
إذا (طول(ر4["emoji"]) > 0)
    اطبع("PASS: surrogate pair لإيموجي")
وإلا
    اطبع("FAIL: surrogate pair")
نهاية

# اختبار 5: مزيج عادي و unicode
متغير ر5 = تحليل_جيسون("{\"mix\":\"hello\\u0020world\"}")
إذا (ر5["mix"] == "hello world")
    اطبع("PASS: مزيج نص عادي و \\u")
وإلا
    اطبع("FAIL: مزيج — حصلنا: " + ر5["mix"])
نهاية

اطبع("=== انتهى اختبار Unicode JSON ===")
