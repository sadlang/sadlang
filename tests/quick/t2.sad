صنف حيوان
    نص الاسم
    رقم العمر

    باني(نص ا، رقم ع)
        الاسم = ا
        العمر = ع
    نهاية

    دالة تكلم()
        اطبع_سطر("...")
    نهاية
نهاية

صنف قطة يرث حيوان
    نص اللون

    باني(نص ا، رقم ع، نص ل)
        أساس(ا، ع)
        اللون = ل
    نهاية

    دالة تكلم()
        اطبع(الاسم)
        اطبع_سطر(": مياو!")
    نهاية
نهاية

دالة رئيسية()
    متغير ق = جديد قطة("ميمي"، 3، "أبيض")
    ق.تكلم()
    اطبع_سطر(ق.الاسم)
    اطبع_سطر(ق.اللون)
نهاية
