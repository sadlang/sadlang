# ═══════════════════════════════════════════════════════
# اختبار الاستثناءات المخصصة (Custom Exceptions)
# ═══════════════════════════════════════════════════════

متغير نتائج_الاختبار = 0
متغير إجمالي_الاختبارات = 4

# ─── اختبار 1: استثناء مخصص بسيط ───
صنف خطأ_مخصص
    باني(الرسالة)
        هذا.رسالة = الرسالة
    نهاية
نهاية

حاول
    ارمي جديد خطأ_مخصص("حدث خطأ!")
امسك (خطأ_مخصص خ)
    اطبع_سطر("✅ اختبار 1 نجح: التقاط استثناء مخصص - " + خ)
    نتائج_الاختبار = نتائج_الاختبار + 1
نهاية

# ─── اختبار 2: استثناء عادي (غير مخصص) ───
حاول
    ارمي "خطأ عادي"
امسك (خ)
    إذا (خ == "خطأ عادي")
        اطبع_سطر("✅ اختبار 2 نجح: التقاط استثناء عادي - " + خ)
        نتائج_الاختبار = نتائج_الاختبار + 1
    وإلا
        اطبع_سطر("❌ اختبار 2 فشل - القيمة: " + خ)
    نهاية
نهاية

# ─── اختبار 3: تفريق بين أنواع الاستثناءات ───
صنف خطأ_شبكة
    باني(الرسالة)
        هذا.رسالة = الرسالة
    نهاية
نهاية

صنف خطأ_ملف
    باني(الرسالة)
        هذا.رسالة = الرسالة
    نهاية
نهاية

متغير نوع_الخطأ = "لا شيء"

حاول
    ارمي جديد خطأ_شبكة("انقطع الاتصال")
امسك (خطأ_ملف خ)
    نوع_الخطأ = "ملف"
امسك (خطأ_شبكة خ)
    نوع_الخطأ = "شبكة"
امسك (خ)
    نوع_الخطأ = "عام"
نهاية

إذا (نوع_الخطأ == "شبكة")
    اطبع_سطر("✅ اختبار 3 نجح: تفريق بين أنواع الاستثناءات")
    نتائج_الاختبار = نتائج_الاختبار + 1
وإلا
    اطبع_سطر("❌ اختبار 3 فشل - النوع: " + نوع_الخطأ)
نهاية

# ─── اختبار 4: حاول/امسك/أخيراً مع استثناء مخصص ───
متغير تم_التنظيف = خطأ

حاول
    ارمي جديد خطأ_مخصص("خطأ مع تنظيف")
امسك (خطأ_مخصص خ)
    اطبع_سطر("تم التقاط: " + خ)
أخيراً
    تم_التنظيف = صحيح
نهاية

إذا (تم_التنظيف)
    اطبع_سطر("✅ اختبار 4 نجح: حاول/امسك/أخيراً مع استثناء مخصص")
    نتائج_الاختبار = نتائج_الاختبار + 1
وإلا
    اطبع_سطر("❌ اختبار 4 فشل")
نهاية

# ═══════════════════════════════════════════════════════
اطبع_سطر("═══════════════════════════════════════")
اطبع_سطر("نتيجة اختبار الاستثناءات المخصصة: " + نتائج_الاختبار + "/" + إجمالي_الاختبارات)
اطبع_سطر("═══════════════════════════════════════")
