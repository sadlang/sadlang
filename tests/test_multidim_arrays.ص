# اختبار شامل للمصفوفات متعددة الأبعاد

اطبع_سطر("=== اختبار المصفوفات متعددة الأبعاد ===")

# 2D array
متغير م = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
اطبع_سطر("المصفوفة: " + م)

# Access elements
اطبع_سطر("م[0][0] = " + م[0][0])
اطبع_سطر("م[1][2] = " + م[1][2])
اطبع_سطر("م[2][1] = " + م[2][1])

# Modify nested elements
م[1][1] = 50
اطبع_سطر("بعد م[1][1] = 50: " + م[1][1])

# Dimensions
اطبع_سطر("shape: " + م.أبعاد())
اطبع_سطر("rows: " + م.صفوف())
اطبع_سطر("cols: " + م.أعمدة())
اطبع_سطر("ndim: " + م.البعد())

# Row and column
اطبع_سطر("row 0: " + م.صف(0))
اطبع_سطر("col 1: " + م.عمود(1))

# Element access
اطبع_سطر("element(2,0) = " + م.عنصر(2, 0))

# Transpose
متغير ن1 = م.قلب_محوري()
اطبع_سطر("transpose: " + ن1)

# Matrix multiply 
متغير ا1 = [[1, 2], [3, 4]]
متغير ا2 = [[5, 6], [7, 8]]
متغير ن2 = ا1.ضرب_مصفوفات(ا2)
اطبع_سطر("matmul: " + ن2)

# Reshape
متغير ن3 = [1, 2, 3, 4, 5, 6]
متغير ن4 = ن3.أعد_تشكيل(2, 3)
اطبع_سطر("reshape 2x3: " + ن4)

# 3D array
متغير ث = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
اطبع_سطر("3D: " + ث)
اطبع_سطر("ث[0][1][0] = " + ث[0][1][0])
اطبع_سطر("3D shape: " + ث.أبعاد())
اطبع_سطر("3D ndim: " + ث.البعد())

# Standalone functions
متغير ن5 = مصفوفة_جديدة(3, 3, 0)
اطبع_سطر("new matrix 3x3: " + ن5)

متغير ن6 = نطاق_مصفوفة(1, 10)
اطبع_سطر("range 1-10: " + ن6)

اطبع_سطر("=== انتهت الاختبارات بنجاح ===")
