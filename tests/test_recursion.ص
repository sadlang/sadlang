# 1. دالة الضرب (factorial)
دالة رقم ضرب(رقم ن)
    اذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * ضرب(ن - 1)
نهاية

# 2. دالة فيبوناتشي
دالة رقم فيبوناتشي(رقم ن)
    اذا (ن <= 0)
        ارجع 0
    نهاية
    اذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

