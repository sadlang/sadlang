# ═══════════════════════════════════════════════════════════════
# اختبار القواعد النحوية §3: جمل التحكم
# يغطي: if/else, while, for, return, break, continue, try/catch
# ═══════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

# --- §3.1 جملة الشرط ---

# إذا بسيط
متغير س = 10
متغير نتيجة = ""
إذا (س > 5)
    نتيجة = "كبير"
نهاية

إذا (نتيجة == "كبير")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: إذا بسيط")
نهاية

# إذا + وإلا
متغير ن = -5
إذا (ن > 0)
    نتيجة = "موجب"
وإلا
    نتيجة = "سالب"
نهاية

إذا (نتيجة == "سالب")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: إذا/وإلا")
نهاية

# إذا + وإلا إذا + وإلا
متغير ع = 50
إذا (ع > 100)
    نتيجة = "كبير جداً"
وإلا إذا (ع > 10)
    نتيجة = "متوسط"
وإلا
    نتيجة = "صغير"
نهاية

إذا (نتيجة == "متوسط")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: وإلا إذا")
نهاية

# --- §3.2 حلقة بينما ---
متغير مجموع = 0
متغير عداد = 1
بينما (عداد <= 5)
    مجموع += عداد
    عداد += 1
نهاية

إذا (مجموع == 15)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: بينما — المجموع: " + مجموع)
نهاية

# --- §3.3 حلقة لكل ---

# لكل في مصفوفة
متغير مجموع2 = 0
لكل عنصر في [10، 20، 30]
    مجموع2 += عنصر
نهاية

إذا (مجموع2 == 60)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: لكل في مصفوفة — المجموع: " + مجموع2)
نهاية

# --- §3.4 جملة الإرجاع ---
دالة حساب(ق)
    إذا (ق < 0)
        ارجع -1
    نهاية
    ارجع ق * ق
نهاية

إذا (حساب(-5) == -1)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: إرجاع مبكر")
نهاية

إذا (حساب(4) == 16)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: إرجاع عادي")
نهاية

# --- §3.10 توقف واستمر ---
متغير مجموع3 = 0
متغير ي = 0
بينما (ي < 10)
    ي += 1
    إذا (ي == 3)
        استمر
    نهاية
    إذا (ي == 7)
        توقف
    نهاية
    مجموع3 += ي
نهاية

# مجموع: 1+2+4+5+6 = 18
إذا (مجموع3 == 18)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: توقف/استمر — المجموع: " + مجموع3)
نهاية

# --- §3.8 حاول/امسك/أخيراً ---
متغير رسالة_خطأ = ""
متغير تنظيف = خطأ

حاول
    ارمي "خطأ تجريبي"
امسك (خ)
    رسالة_خطأ = خ
أخيراً
    تنظيف = صحيح
نهاية

إذا (رسالة_خطأ == "خطأ تجريبي")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: حاول/امسك")
نهاية

إذا (تنظيف == صحيح)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: أخيراً")
نهاية

# --- النتيجة ---
اطبع_سطر("═══ نتائج اختبار الجمل ═══")
اطبع_سطر("نجاح: " + نجاح)
اطبع_سطر("فشل: " + فشل)
إذا (فشل == 0)
    اطبع_سطر("✅ جميع اختبارات الجمل نجحت!")
وإلا
    اطبع_سطر("❌ بعض الاختبارات فشلت")
نهاية
