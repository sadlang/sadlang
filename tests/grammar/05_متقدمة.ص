# ═══════════════════════════════════════════════════════════════
# اختبار القواعد النحوية §7+§8+§9: مطابقة أنماط + قوالب + async
# يغطي: طابق/عندما، أنماط رقمية/نصية/نطاق، افتراضي، guard
# ═══════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

# --- §7 مطابقة أنماط بسيطة ---
دالة وصف_عدد(ن)
    طابق (ن)
        عندما 0:
            ارجع "صفر"
        عندما 1:
            ارجع "واحد"
        عندما 2:
            ارجع "اثنان"
        افتراضي:
            ارجع "أخرى"
    نهاية
نهاية

إذا (وصف_عدد(0) == "صفر")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: مطابقة 0")
نهاية

إذا (وصف_عدد(1) == "واحد")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: مطابقة 1")
نهاية

إذا (وصف_عدد(99) == "أخرى")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: مطابقة افتراضي")
نهاية

# --- §7 نمط نطاق ---
دالة فئة_عمر(عمر)
    طابق (عمر)
        عندما 0..13:
            ارجع "طفل"
        عندما 13..20:
            ارجع "مراهق"
        عندما 20..60:
            ارجع "بالغ"
        افتراضي:
            ارجع "كبير"
    نهاية
نهاية

إذا (فئة_عمر(5) == "طفل")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: نطاق طفل — النتيجة: " + فئة_عمر(5))
نهاية

إذا (فئة_عمر(15) == "مراهق")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: نطاق مراهق — النتيجة: " + فئة_عمر(15))
نهاية

إذا (فئة_عمر(30) == "بالغ")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: نطاق بالغ — النتيجة: " + فئة_عمر(30))
نهاية

# --- §7 نمط نصي ---
دالة ترحيب_لغة(لغة)
    طابق (لغة)
        عندما "عربي":
            ارجع "مرحبا"
        عندما "إنجليزي":
            ارجع "Hello"
        افتراضي:
            ارجع "..."
    نهاية
نهاية

إذا (ترحيب_لغة("عربي") == "مرحبا")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: مطابقة نصية")
نهاية

# --- §7 نمط متغير (ربط) ---
دالة مطلق(ن)
    طابق (ن)
        عندما 0:
            ارجع 0
        عندما س:
            إذا (س < 0)
                ارجع -س
            نهاية
            ارجع س
    نهاية
نهاية

إذا (مطلق(-7) == 7)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: نمط متغير — النتيجة: " + مطلق(-7))
نهاية

إذا (مطلق(5) == 5)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: نمط متغير موجب")
نهاية

# --- §7 Wildcard _ ---
دالة حالة_بسيطة(قيمة)
    طابق (قيمة)
        عندما 1:
            ارجع "واحد"
        عندما _:
            ارجع "غير معروف"
    نهاية
نهاية

إذا (حالة_بسيطة(999) == "غير معروف")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: wildcard _")
نهاية

# --- §8 قوالب (template) ---
# اختبار بسيط لصنف قالبي
صنف صندوق
    باني(محتوى)
        هذا.محتوى = محتوى
    نهاية

    دالة المحتوى()
        ارجع هذا.محتوى
    نهاية
نهاية

متغير ص_رقم = جديد صندوق(42)
متغير ص_نص = جديد صندوق("مرحبا")

إذا (ص_رقم.المحتوى() == 42)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: صندوق رقمي")
نهاية

إذا (ص_نص.المحتوى() == "مرحبا")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: صندوق نصي")
نهاية

# --- دوال عليا (Higher-Order) ---
دالة تطبيق(دالة_ف، قيمة)
    ارجع دالة_ف(قيمة)
نهاية

متغير نتيجة = تطبيق(لامدا س: س ** 2، 5)
إذا (نتيجة == 25)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: دالة عليا — النتيجة: " + نتيجة)
نهاية

# --- دالة مع عدة لامدا ---
دالة ترشيح(قائمة، شرط)
    متغير نتيجة = []
    لكل عنصر في قائمة
        إذا (شرط(عنصر))
            نتيجة += [عنصر]
        نهاية
    نهاية
    ارجع نتيجة
نهاية

متغير أرقام = [1, 2, 3, 4, 5, 6, 7, 8]
متغير زوجية = ترشيح(أرقام، لامدا ن: ن % 2 == 0)

إذا (زوجية[0] == 2)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: ترشيح لامدا")
نهاية

