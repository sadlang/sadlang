    اطبع_سطر("فشل: .طول()")
نهاية

# --- النتيجة ---
اطبع_سطر("═══ نتائج اختبار المتقدمة ═══")
اطبع_سطر("نجاح: " + نجاح)
اطبع_سطر("فشل: " + فشل)
إذا (فشل == 0)
    اطبع_سطر("✅ جميع الاختبارات المتقدمة نجحت!")
وإلا
    اطبع_سطر("❌ بعض الاختبارات فشلت")
نهاية
