# --- §2.1 تصريح الدالة ---

# دالة بسيطة
دالة جمع(أ، ب)
    ارجع أ + ب
نهاية

إذا (جمع(2، 3) == 5)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: دالة بسيطة")
نهاية

# دالة مع نوع إرجاع قبل الاسم
دالة رقم مضاعفة(رقم س)
    ارجع س * 2
نهاية

إذا (مضاعفة(5) == 10)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: دالة بنوع إرجاع")
نهاية

# دالة بدون معاملات
دالة تحية()
    ارجع "مرحبا"
نهاية

إذا (تحية() == "مرحبا")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: دالة بدون معاملات")
نهاية

# دالة بمعامل افتراضي
دالة ترحيب(اسم = "عالم")
