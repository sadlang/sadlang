# --- أولوية العمليات ---
# ضرب قبل جمع
إذا (2 + 3 * 4 == 14)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: أولوية ضرب/جمع")
نهاية

# أس قبل ضرب (2 ** 3 = 8، 8 * 2 = 16؟ لا! 2 * 8 = 16)
إذا (2 * 2 ** 3 == 16)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: أولوية أس/ضرب")
نهاية

