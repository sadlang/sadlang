# --- §4 عوامل منطقية ---
إذا (صحيح && صحيح)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: &&")
نهاية

إذا (خطأ || صحيح)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: ||")
نهاية

إذا (!خطأ)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: !")
نهاية

# --- §4 عامل في (عضوية) ---
متغير قائمة = [1, 2, 3, 4, 5]
إذا (3 في قائمة)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: في (عضوية)")
نهاية

# --- §4.3 تعبير ثلاثي ---
متغير قيمة = 10 > 5 ? "نعم" : "لا"
إذا (قيمة == "نعم")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: ثلاثي")
نهاية

# --- §4.8 تجميع فارغ ?? ---
متغير أ = لاشيء
متغير ب = أ ?? "بديل"
إذا (ب == "بديل")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: ??")
نهاية

متغير ج = 42
متغير د = ج ?? 0
إذا (د == 42)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: ?? مع قيمة موجودة")
نهاية

# --- §4.4 مصفوفة حرفية ---
متغير م = [10, 20, 30]
إذا (م[0] == 10)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: فهرسة مصفوفة")
نهاية

إذا (م[2] == 30)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: فهرسة آخر عنصر")
نهاية

# --- §4.5 خريطة حرفية ---
متغير خ = {"اسم": "أحمد"، "عمر": 30}
إذا (خ["اسم"] == "أحمد")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: فهرسة خريطة")
نهاية

# --- §4.13 f-string ---
متغير اسم = "عالم"
متغير رسالة = م"مرحبا {اسم}"
إذا (رسالة == "مرحبا عالم")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: f-string — النتيجة: " + رسالة)
نهاية

# f-string مع تعبير
متغير حساب = م"{2 + 3}"
إذا (حساب == "5")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: f-string تعبير — النتيجة: " + حساب)
نهاية

# --- §4.9 لامدا ---
متغير ضعف = لامدا س: س * 2
إذا (ضعف(5) == 10)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: لامدا بسيطة")
نهاية

# --- §4.10 دالة سهمية ---
متغير مربع = (س) => س * س
إذا (مربع(4) == 16)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: دالة سهمية")
نهاية

# سهمية متعددة المعاملات
متغير جمع_سهم = (أ، ب) => أ + ب
إذا (جمع_سهم(3، 7) == 10)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: سهمية متعددة")
نهاية

# --- §4.6 أنبوب |> ---
دالة زائد_واحد(س)
    ارجع س + 1
نهاية

دالة ضرب_ثلاث(س)
    ارجع س * 3
نهاية

متغير نتيجة_أنبوب = 5 |> زائد_واحد |> ضرب_ثلاث
# 5 → 6 → 18
إذا (نتيجة_أنبوب == 18)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: أنبوب |> — النتيجة: " + نتيجة_أنبوب)
نهاية

