# اختبار القواعد النحوية §4: التعبيرات والعوامل
# يغطي: أولويات العوامل، أنبوب، ثلاثي، ??، منطقية، بتّية، 
#        مقارنة، نطاق، حسابية، أحادية، أس، f-string، lambda
# ═══════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

# --- §4.1 عمليات حسابية ---
إذا (2 + 3 == 5)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: جمع")
نهاية

إذا (10 - 4 == 6)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: طرح")
نهاية

إذا (3 * 7 == 21)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: ضرب")
نهاية

إذا (20 / 4 == 5)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: قسمة")
نهاية

إذا (17 % 5 == 2)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: باقي القسمة")
