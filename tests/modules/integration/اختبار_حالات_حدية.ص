# اختبارات الحالات الحدية — Edge Cases for Import System
# ═══════════════════════════════════════════════════════════════════

متغير عدد_الاختبارات = 0
متغير عدد_النجاح = 0

دالة تأكيد(الشرط، الوصف)
    عدد_الاختبارات = عدد_الاختبارات + 1
    إذا (الشرط)
        عدد_النجاح = عدد_النجاح + 1
        اطبع("  ✅ " + الوصف)
    وإلا
        اطبع("  ❌ " + الوصف)
    نهاية
نهاية

