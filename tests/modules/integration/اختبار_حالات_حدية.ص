اطبع("═══ 1. الاستيراد من الأب ═══")

استورد * من tests.modules.integration.فرعي.وحدة_أب
تأكيد(حساب(5، 3) == 16، "وحدة تستورد من الأب بـ ..")

استورد * من tests.modules.integration.فرعي.وحدة_فرعية
تأكيد(تحية("عالم") == "مرحباً عالم!"، "استيراد من مجلد فرعي")

