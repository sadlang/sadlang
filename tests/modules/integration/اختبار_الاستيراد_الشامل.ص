# ═══════════════════════════════════════════════════════════════════
# اختبارات شاملة لنظام الاستيراد — Comprehensive Import System Tests
# ═══════════════════════════════════════════════════════════════════
# يغطي: الصيغة الجديدة، الصيغة القديمة، النسبي، الأسماء المستعارة،
#        الاستيراد الشامل، الانتقائي، المتعدد

متغير عدد_الاختبارات = 0
متغير عدد_النجاح = 0

دالة تأكيد(الشرط، الوصف)
    عدد_الاختبارات = عدد_الاختبارات + 1
    إذا (الشرط)
        عدد_النجاح = عدد_النجاح + 1
        اطبع("  ✅ " + الوصف)
    وإلا
        اطبع("  ❌ " + الوصف)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════
# 1. الصيغة القديمة: من وحدة استورد عناصر
# ═══════════════════════════════════════════════════════════════════
اطبع("═══ 1. الصيغة القديمة ═══")

من tests.modules.integration.وحدة_أ استورد جمع
تأكيد(جمع(3، 5) == 8، "من X استورد دالة_واحدة")

من tests.modules.integration.وحدة_أ استورد طرح
تأكيد(طرح(10، 3) == 7، "من X استورد دالة_ثانية")

من tests.modules.integration.وحدة_أ استورد *
تأكيد(جمع(1، 1) == 2، "من X استورد * (شامل)")

# ═══════════════════════════════════════════════════════════════════
# 2. الصيغة الجديدة: استورد عناصر من وحدة
# ═══════════════════════════════════════════════════════════════════
اطبع("═══ 2. الصيغة الجديدة ═══")

استورد * من tests.modules.integration.وحدة_أ
تأكيد(جمع(10، 20) == 30، "استورد * من X (شامل جديد)")

استورد جمع من tests.modules.integration.وحدة_أ
تأكيد(جمع(4، 6) == 10، "استورد دالة من X (انتقائي جديد)")

استورد ضرب من tests.modules.integration.وحدة_ب
تأكيد(ضرب(3، 4) == 12، "استورد من وحدة ثانية")

# ═══════════════════════════════════════════════════════════════════
# 3. استيراد متعدد العناصر
# ═══════════════════════════════════════════════════════════════════
اطبع("═══ 3. استيراد متعدد ═══")

استورد جمع، طرح من tests.modules.integration.وحدة_أ
تأكيد(جمع(5، 5) == 10، "استورد متعدد — العنصر الأول")
تأكيد(طرح(10، 5) == 5، "استورد متعدد — العنصر الثاني")

# ═══════════════════════════════════════════════════════════════════
# 4. الاستيراد النسبي (.)
# ═══════════════════════════════════════════════════════════════════
اطبع("═══ 4. الاستيراد النسبي ═══")

# استيراد نسبي يعمل فقط من ملفات داخل مجلد معروف
# هنا نختبره عبر وحدة_ب التي تستخدم ".وحدة_أ" داخلياً
استورد مسافة من tests.modules.integration.وحدة_ب
متغير ن1 = جديد نقطة(0، 0)
متغير ن2 = جديد نقطة(3، 4)
تأكيد(مسافة(ن1، ن2) == 25، "وحدة تستخدم استيراد نسبي داخلياً")

# ═══════════════════════════════════════════════════════════════════
# 5. استيراد الأصناف
# ═══════════════════════════════════════════════════════════════════
اطبع("═══ 5. استيراد الأصناف ═══")

استورد * من tests.modules.integration.وحدة_أ
متغير نقطة_جديدة = جديد نقطة(7، 8)
تأكيد(نقطة_جديدة.س == 7، "استيراد صنف — الحقل الأول")
تأكيد(نقطة_جديدة.ص == 8، "استيراد صنف — الحقل الثاني")

# ═══════════════════════════════════════════════════════════════════
# 6. استيراد المكتبة القياسية (واجهات)
# ═══════════════════════════════════════════════════════════════════
اطبع("═══ 6. المكتبة القياسية ═══")

# الصيغة الجديدة
استورد * من رسومات.أساس.عنصر
تأكيد(صحيح، "استورد * من رسومات.أساس.عنصر")

# الصيغة القديمة 
من رسومات.أساس.أساسيات استورد *
تأكيد(صحيح، "من رسومات.أساس.أساسيات استورد *")

# استيراد واجهات كامل
استورد * من رسومات.واجهات
تأكيد(صحيح، "استورد * من رسومات.واجهات (كامل)")

# ═══════════════════════════════════════════════════════════════════
# النتيجة النهائية
# ═══════════════════════════════════════════════════════════════════
اطبع("")
اطبع("═══════════════════════════════════════════")
اطبع("النتيجة: " + لنص(عدد_النجاح) + "/" + لنص(عدد_الاختبارات) + " اختبار نجح")
إذا (عدد_النجاح == عدد_الاختبارات)
    اطبع("✅ جميع الاختبارات نجحت!")
وإلا
    اطبع("❌ بعض الاختبارات فشلت!")
نهاية
اطبع("═══════════════════════════════════════════")
