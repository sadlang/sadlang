# =============================================================
# اختبار شامل للبرمجة الكائنية
# =============================================================
# يختبر: صنف، باني، حقول، دوال، وراثة، عامل
# =============================================================

# ═══════════════════════════════════════════════════════
# 1. صنف بسيط مع باني وحقول ودوال
# ═══════════════════════════════════════════════════════

صنف نقطة
    رقم س
    رقم ص

    باني(رقم قس، رقم قص)
        س = قس
        ص = قص
    نهاية

    دالة عرض()
        اطبع("(")
        اطبع(س)
        اطبع("، ")
        اطبع(ص)
        اطبع_سطر(")")
    نهاية

    دالة رقم مجموع()
        ارجع س + ص
    نهاية

    # تحميل عامل الجمع
    عامل +(اخر)
        متغير نتيجة = جديد نقطة(س + اخر.س، ص + اخر.ص)
        ارجع نتيجة
    نهاية

    # تحميل عامل المقارنة
    عامل ==(اخر)
        اذا (س == اخر.س)
            اذا (ص == اخر.ص)
                ارجع 1
            نهاية
        نهاية
        ارجع 0
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# 2. وراثة بسيطة
# ═══════════════════════════════════════════════════════

صنف شكل
    نص الاسم
    رقم اللون

    باني(نص اسم، رقم لون)
        الاسم = اسم
        اللون = لون
    نهاية

    دالة عرض_الاسم()
        اطبع("الشكل: ")
        اطبع_سطر(الاسم)
    نهاية

    دالة رقم المساحة()
        ارجع 0
    نهاية
نهاية

صنف مستطيل يرث شكل
    رقم العرض
    رقم الطول

    باني(رقم عرض، رقم طول)
        الاسم = "مستطيل"
        اللون = 1
        العرض = عرض
        الطول = طول
    نهاية

    دالة رقم المساحة()
        ارجع العرض * الطول
    نهاية

    دالة رقم المحيط()
        ارجع 2 * (العرض + الطول)
    نهاية
نهاية

صنف مربع يرث مستطيل
    باني(رقم ضلع)
        الاسم = "مربع"
        اللون = 2
        العرض = ضلع
        الطول = ضلع
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# 3. صنف مع دوال متعددة
# ═══════════════════════════════════════════════════════

صنف عداد
    رقم القيمة

    باني(رقم بداية)
        القيمة = بداية
    نهاية

    دالة زيادة()
        القيمة = القيمة + 1
    نهاية

    دالة نقصان()
        القيمة = القيمة - 1
    نهاية

    دالة اعادة_ضبط()
        القيمة = 0
    نهاية

    دالة رقم الحالي()
        ارجع القيمة
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
# الدالة الرئيسية
# ═══════════════════════════════════════════════════════

دالة رئيسية()
    اطبع_سطر("========================================")
    اطبع_سطر("  اختبار البرمجة الكائنية الشامل")
    اطبع_سطر("========================================")

    # اختبار 1: صنف بسيط
    اطبع_سطر("")
    اطبع_سطر("--- اختبار 1: صنف بسيط ---")
    متغير ن1 = جديد نقطة(3، 4)
    متغير ن2 = جديد نقطة(1، 2)
    اطبع("نقطة 1: ")
    ن1.عرض()
    اطبع("نقطة 2: ")
    ن2.عرض()
    اطبع("مجموع ن1: ")
    اطبع_سطر(ن1.مجموع())

    # اختبار 2: وراثة
    اطبع_سطر("")
    اطبع_سطر("--- اختبار 2: وراثة ---")
    متغير م = جديد مستطيل(5، 3)
    م.عرض_الاسم()
    اطبع("مساحة المستطيل: ")
    اطبع_سطر(م.المساحة())
    اطبع("محيط المستطيل: ")
    اطبع_سطر(م.المحيط())

    # اختبار 3: وراثة متعددة المستويات
    اطبع_سطر("")
    اطبع_سطر("--- اختبار 3: وراثة متعددة المستويات ---")
    متغير مر = جديد مربع(4)
    مر.عرض_الاسم()
    اطبع("مساحة المربع: ")
    اطبع_سطر(مر.المساحة())
    اطبع("محيط المربع: ")
    اطبع_سطر(مر.المحيط())

    # اختبار 4: عداد
    اطبع_سطر("")
    اطبع_سطر("--- اختبار 4: عداد ---")
    متغير ع = جديد عداد(0)
    ع.زيادة()
    ع.زيادة()
    ع.زيادة()
    اطبع("بعد 3 زيادات: ")
    اطبع_سطر(ع.الحالي())
    ع.نقصان()
    اطبع("بعد نقصان: ")
    اطبع_سطر(ع.الحالي())
    ع.اعادة_ضبط()
    اطبع("بعد اعادة الضبط: ")
    اطبع_سطر(ع.الحالي())

    اطبع_سطر("")
    اطبع_سطر("========================================")
    اطبع_سطر("  تم الاختبار بنجاح!")
    اطبع_سطر("========================================")

    ارجع 0
نهاية
