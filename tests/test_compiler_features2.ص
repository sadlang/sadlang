# اختبار ميزات المترجم الجديدة — الدفعة الثانية
# Test new compiler features — Batch 2

# 1. تعبير ثلاثي (Ternary)
متغير س = 10
متغير نتيجة_ثلاثي = (س > 5) ? "كبير" : "صغير"
اطبع_سطر("ثلاثي: " + نتيجة_ثلاثي)

# 2. قاموس / خريطة (MapExpr)
متغير بيانات = {"اسم": "أحمد", "عمر": 25}
اطبع_سطر("خريطة: " + بيانات)

# 3. حالة / switch
متغير يوم = 3
حالة (يوم)
    عندما 1:
        اطبع_سطر("الإثنين")
    عندما 2:
        اطبع_سطر("الثلاثاء")
    عندما 3:
        اطبع_سطر("الأربعاء")
    افتراضي:
        اطبع_سطر("يوم آخر")
نهاية

# 4. حاول / امسك (try-catch)
حاول
    متغير ن = 42
    اطبع_سطر("حاول: " + ن)
امسك (ع)
    اطبع_سطر("امسك: " + ع)
نهاية

# 5. دالة مع قيم افتراضية
دالة تحية(اسم, لقب = "السيد")
    ارجع "مرحبا " + لقب + " " + اسم
نهاية

اطبع_سطر(تحية("أحمد"))
اطبع_سطر(تحية("محمد", "الدكتور"))
