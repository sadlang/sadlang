# اختبار الامتداد
صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    دالة عام وصف()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

امتداد نقطة
    دالة مجموع()
        ارجع هذا.س + هذا.ص
    نهاية
نهاية

متغير ن = جديد نقطة(3، 4)
اطبع_سطر("النقطة: " + ن.وصف())
اطبع_سطر("المجموع: " + ن.مجموع())
