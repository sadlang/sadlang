# اختبار المرحلة 5 — توحيد المنشئ والمدمر وإزالة أقواس حالة

# اختبار 1: المنشئ بـ "باني" فقط
صنف شخص
    متغير الاسم = ""
    متغير العمر = 0

    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية

    دالة عرض()
        اطبع_سطر("الاسم: " + هذا.الاسم + "، العمر: " + هذا.العمر)
    نهاية
نهاية

متغير ش = جديد شخص("أحمد"، 25)
ش.عرض()

# اختبار 2: حالة بدون أقواس
متغير لون = "أحمر"
حالة لون
    عندما "أحمر":
        اطبع_سطر("اللون أحمر")
    عندما "أزرق":
        اطبع_سطر("اللون أزرق")
    افتراضي:
        اطبع_سطر("لون آخر")
نهاية

# اختبار 3: حالة مع رقم
متغير رقمي = 2
حالة رقمي
