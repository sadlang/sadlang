# ═══════════════════════════════════════════════════════════
# اختبار أمان الخيوط (Thread Safety) لنظام الـ goroutines
# ═══════════════════════════════════════════════════════════
# هذا الاختبار يثبت أن كل goroutine لديه سياق تنفيذ مستقل
# (VariableManager, ExpressionEvaluator, ScopeManager خاصين)
# ولا يحدث تداخل بين الخيوط عند الوصول للحالة المشتركة.
# ═══════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

دالة تحقق(رقم_الاختبار، الاسم، المتوقع، الفعلي)
    إذا (المتوقع == الفعلي)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + رقم_الاختبار + ": " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + رقم_الاختبار + ": " + الاسم + " — توقعت: " + المتوقع + " حصلت: " + الفعلي)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════
# اختبار 1: عدة goroutines ترسل لنفس القناة (كان يفشل قبل thread safety)
# ═══════════════════════════════════════════════════════════
دالة ارسل_رقم(ق، رقم)
    ق.أرسل(رقم)
نهاية

متغير ق1 = قناة(10)
أطلق ارسل_رقم(ق1، 100)
أطلق ارسل_رقم(ق1، 200)
أطلق ارسل_رقم(ق1، 300)
انتظر_الكل()

متغير مجموع1 = 0
مجموع1 = مجموع1 + ق1.استقبل()
مجموع1 = مجموع1 + ق1.استقبل()
مجموع1 = مجموع1 + ق1.استقبل()
تحقق(1، "3 goroutines ترسل لنفس القناة"، 600، مجموع1)

# ═══════════════════════════════════════════════════════════
# اختبار 2: goroutines متزامنة مع دالة تحسب قيمة
# ═══════════════════════════════════════════════════════════
دالة حساب(ق، أ، ب)
    متغير نتيجة = أ * ب
    ق.أرسل(نتيجة)
نهاية

متغير ق2 = قناة(5)
أطلق حساب(ق2، 3، 4)
أطلق حساب(ق2، 5، 6)
أطلق حساب(ق2، 7، 8)
انتظر_الكل()

متغير مجموع2 = 0
مجموع2 = مجموع2 + ق2.استقبل()
مجموع2 = مجموع2 + ق2.استقبل()
مجموع2 = مجموع2 + ق2.استقبل()
# 3*4=12, 5*6=30, 7*8=56 → مجموع = 98
تحقق(2، "3 goroutines مع حسابات مختلفة"، 98، مجموع2)

# ═══════════════════════════════════════════════════════════
# اختبار 3: goroutine block form مع متغيرات محلية
# (يثبت أن المتغيرات المحلية معزولة)
# ═══════════════════════════════════════════════════════════
متغير ق3 = قناة(3)
متغير س = 10

أطلق
    # هذا المتغير المحلي يجب ألا يؤثر على 'س' الخارجي
    متغير س = 999
    ق3.أرسل(س)
نهاية

أطلق
    متغير س = 888
    ق3.أرسل(س)
نهاية

انتظر_الكل()
متغير ر1 = ق3.استقبل()
متغير ر2 = ق3.استقبل()

# التحقق أن المتغير الخارجي لم يتأثر
تحقق(3، "عزل المتغيرات المحلية (الخارجي لم يتغير)"، 10، س)

# التحقق أن goroutines أرسلت قيمها الصحيحة
متغير مجموع3 = ر1 + ر2
تحقق(4، "goroutines أرسلت قيمها المحلية"، 1887، مجموع3)

