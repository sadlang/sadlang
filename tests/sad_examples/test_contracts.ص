# ==============================================================
# اختبار العقود البرمجية (Design by Contract)
# ==============================================================
# يتطلب: شرط مسبق — يُفحص قبل تنفيذ الدالة
# يضمن: شرط لاحق — يُفحص بعد تنفيذ الدالة (النتيجة متاحة)
# ==============================================================

متغير نجاح = 0
متغير فشل = 0

دالة تأكد(شرط، رسالة)
    إذا (شرط)
        نجاح = نجاح + 1
        اطبع_سطر("  ✅ " + رسالة)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("  ❌ " + رسالة)
    نهاية
نهاية

# ==============================================================
اطبع_سطر("═══ القسم 1: شروط مسبقة (يتطلب) ═══")
# ==============================================================

# دالة مع شرط مسبق
دالة قسمة(أ، ب)
    يتطلب ب != 0
    ارجع أ / ب
نهاية

تأكد(قسمة(10، 2) == 5، "قسمة بشرط مسبق متحقق: 10/2 = 5")
تأكد(قسمة(100، 4) == 25، "قسمة بشرط مسبق متحقق: 100/4 = 25")

# اختبار فشل الشرط المسبق
متغير فشل_يتطلب = خطأ
حاول
    قسمة(10، 0)
امسك خطأ
    فشل_يتطلب = صحيح
نهاية
تأكد(فشل_يتطلب، "يتطلب: رفض القسمة على صفر")

# ==============================================================
اطبع_سطر("")
اطبع_سطر("═══ القسم 2: شروط لاحقة (يضمن) ═══")
# ==============================================================

# دالة تضمن أن النتيجة موجبة
دالة قيمة_مطلقة(ن)
    يضمن النتيجة >= 0
    إذا (ن < 0)
        ارجع ن * -1
    نهاية
    ارجع ن
نهاية

تأكد(قيمة_مطلقة(-5) == 5، "يضمن: قيمة مطلقة لـ -5")
تأكد(قيمة_مطلقة(3) == 3، "يضمن: قيمة مطلقة لـ 3")
تأكد(قيمة_مطلقة(0) == 0، "يضمن: قيمة مطلقة لـ 0")

# ==============================================================
اطبع_سطر("")
اطبع_سطر("═══ القسم 3: يتطلب + يضمن معاً ═══")
# ==============================================================

# دالة مع شرطين
دالة جذر_تقريبي(ن)
    يتطلب ن >= 0
    يضمن النتيجة >= 0
    إذا (ن == 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    متغير تخمين = ن / 2
    متغير ع = 0
    بينما (ع < 10)
        تخمين = (تخمين + ن / تخمين) / 2
        ع = ع + 1
    نهاية
    ارجع تخمين
نهاية

تأكد(جذر_تقريبي(0) == 0، "يتطلب+يضمن: جذر 0")
تأكد(جذر_تقريبي(1) == 1، "يتطلب+يضمن: جذر 1")
تأكد(جذر_تقريبي(4) == 2، "يتطلب+يضمن: جذر 4")

# فشل الشرط المسبق
متغير فشل_جذر = خطأ
حاول
    جذر_تقريبي(-1)
امسك خطأ
    فشل_جذر = صحيح
نهاية
تأكد(فشل_جذر، "يتطلب: رفض جذر عدد سالب")

# ==============================================================
اطبع_سطر("")
اطبع_سطر("═══ القسم 4: عقود مع أعمار وماكروز ═══")
# ==============================================================

# دالة بعمر + عقد
دالة أطول_آمن<'أ>(س، ص)
    يتطلب طول(س) > 0
    يتطلب طول(ص) > 0
    إذا (طول(س) > طول(ص))
        ارجع س
    وإلا
        ارجع ص
    نهاية
نهاية

تأكد(أطول_آمن("أهلاً"، "مرحبا") == "مرحبا"، "عمر+يتطلب: أطول نص")

# فشل الشرط
متغير فشل_طول = خطأ
حاول
    أطول_آمن(""، "مرحبا")
امسك خطأ
    فشل_طول = صحيح
نهاية
تأكد(فشل_طول، "عمر+يتطلب: رفض نص فارغ")

# ==============================================================
اطبع_سطر("")
اطبع_سطر("═══ القسم 5: عدة شروط مسبقة ═══")
# ==============================================================

دالة مستطيل(عرض، ارتفاع)
    يتطلب عرض > 0
    يتطلب ارتفاع > 0
    يضمن النتيجة > 0
    ارجع عرض * ارتفاع
نهاية

تأكد(مستطيل(5، 3) == 15، "عدة شروط: مساحة مستطيل")

متغير فشل_عرض = خطأ
حاول
    مستطيل(0، 3)
امسك خطأ
    فشل_عرض = صحيح
نهاية
تأكد(فشل_عرض، "عدة شروط: رفض عرض صفري")

متغير فشل_ارتفاع = خطأ
حاول
    مستطيل(5، -1)
امسك خطأ
    فشل_ارتفاع = صحيح
نهاية
تأكد(فشل_ارتفاع، "عدة شروط: رفض ارتفاع سالب")

