اطبع_سطر("═══════════════════════════════════")
اطبع_سطر("📊 نتائج اختبارات العقود:")
اطبع_سطر("  ✅ ناجحة: " + نجاح)
اطبع_سطر("  ❌ فاشلة: " + فشل)
اطبع_سطر("  📋 المجموع: " + (نجاح + فشل))
إذا (فشل == 0)
    اطبع_سطر("🎉 جميع الاختبارات نجحت!")
وإلا
    اطبع_سطر("⚠️ يوجد " + فشل + " اختبار فاشل")
نهاية
