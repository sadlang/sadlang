امسك خطأ
    رفض_رقم = صحيح
نهاية
سجّل("قيد نصي يرفض رقم", رفض_رقم)

# دالة بقيد قابل_للمقارنة
دالة أكبر(أ، ب)
    حيث ت: قابل_للمقارنة
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

# 1.6 — قابل_للمقارنة يقبل أرقام
سجّل("قابل_للمقارنة مع أرقام", أكبر(10, 20) == 20)

# 1.7 — قابل_للمقارنة يقبل نصوص
سجّل("قابل_للمقارنة مع نصوص", أكبر("ب", "أ") == "ب")

# 1.8 — قابل_للمقارنة يرفض مصفوفات
متغير رفض_مصفوفة = خطأ
حاول
    أكبر([1, 2], [3, 4])
امسك خطأ
    رفض_مصفوفة = صحيح
نهاية
سجّل("قابل_للمقارنة يرفض مصفوفة", رفض_مصفوفة)

# 1.9 — سمة غير معروفة (معلوماتية فقط — لا ترفض)
دالة شيء(أ)
    حيث ت: سمة_مجهولة
    ارجع أ
نهاية
سجّل("سمة غير معروفة لا ترفض", شيء(42) == 42)

