# ═══════════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

# ───── مساعد التسجيل ─────
دالة سجّل(الاسم، النتيجة)
    إذا (النتيجة)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ " + الاسم + ": نجح")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("  ✗ " + الاسم + ": فشل")
    نهاية
نهاية

# ═════════════════════════════════════════════════════════
اطبع_سطر("═══ القسم 1: تفعيل قيود الأنواع (حيث) ═══")
# ═════════════════════════════════════════════════════════

# دالة بقيد رقمي
دالة مضاعفة(أ)
    حيث ت: رقمي
    ارجع أ * 2
نهاية

# 1.1 — قيد رقمي يقبل أرقام صحيحة
سجّل("قيد رقمي مع عدد صحيح", مضاعفة(5) == 10)

# 1.2 — قيد رقمي يقبل أرقام عشرية
سجّل("قيد رقمي مع عدد عشري", مضاعفة(2.5) == 5.0)

# 1.3 — قيد رقمي يرفض نصوص
متغير رفض_نص = خطأ
حاول
    مضاعفة("نص")
امسك خطأ
    رفض_نص = صحيح
نهاية
سجّل("قيد رقمي يرفض نص", رفض_نص)

# دالة بقيد نصي
دالة طول_انص(ن)
    حيث ت: نصي
    ارجع طول(ن)
نهاية

# 1.4 — قيد نصي يقبل نصوص
سجّل("قيد نصي مع نص", طول_انص("مرحبا") == 5)

# 1.5 — قيد نصي يرفض أرقام
متغير رفض_رقم = خطأ
حاول
