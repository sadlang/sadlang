متغير نجاح = 0
متغير فشل = 0

# دالة تحقق — تقارن قيمة بقيمة متوقعة
دالة تحقق_رقم(وصف، قيمة، متوقع)
    إذا (قيمة == متوقع)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("فشل: " + وصف)
        فشل = فشل + 1
    نهاية
نهاية

دالة تحقق_منطق(وصف، قيمة، متوقع)
    إذا (قيمة == متوقع)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("فشل: " + وصف)
        فشل = فشل + 1
    نهاية
نهاية

متغير أ = جديد عداد(10)
متغير ب = جديد عداد(20)
متغير ج = جديد عداد(10)

# اختبارات حسابية
متغير مج = أ + ب
تحقق_رقم("جمع", مج.قيمة, 30)

متغير طرح = ب - أ
تحقق_رقم("طرح", طرح.قيمة, 10)

متغير ضرب = أ * ب
تحقق_رقم("ضرب", ضرب.قيمة, 200)

# اختبارات مقارنة
تحقق_منطق("مساواة (صح)", أ == ج, صحيح)
تحقق_منطق("مساواة (خطأ)", أ == ب, خطأ)
تحقق_منطق("عدم مساواة (صح)", أ != ب, صحيح)
تحقق_منطق("عدم مساواة (خطأ)", أ != ج, خطأ)
تحقق_منطق("أصغر (صح)", أ < ب, صحيح)
تحقق_منطق("أصغر (خطأ)", ب < أ, خطأ)
تحقق_منطق("أكبر (صح)", ب > أ, صحيح)
تحقق_منطق("أكبر (خطأ)", أ > ب, خطأ)
تحقق_منطق("أصغر_مساوي (صح 1)", أ <= ج, صحيح)
تحقق_منطق("أصغر_مساوي (صح 2)", أ <= ب, صحيح)
تحقق_منطق("أصغر_مساوي (خطأ)", ب <= أ, خطأ)
تحقق_منطق("أكبر_مساوي (صح 1)", أ >= ج, صحيح)
تحقق_منطق("أكبر_مساوي (صح 2)", ب >= أ, صحيح)
تحقق_منطق("أكبر_مساوي (خطأ)", أ >= ب, خطأ)

# اختبارات أحادية
متغير سالب = -أ
تحقق_رقم("سالب أحادي", سالب.قيمة, -10)

متغير سالب2 = -ب
تحقق_رقم("سالب أحادي 2", سالب2.قيمة, -20)

# اختبارات القسمة والباقي والأس
متغير قسمة = ب / أ
تحقق_رقم("قسمة /", قسمة.قيمة, 2)

متغير قسمة_صحيحة = ب // أ
تحقق_رقم("قسمة //", قسمة_صحيحة.قيمة, 2)

متغير باقي = ب % أ
تحقق_رقم("باقي %", باقي.قيمة, 0)

متغير أس = جديد عداد(2)
متغير أس_قوة = جديد عداد(3)
متغير نتيجة_أس = أس ** أس_قوة
تحقق_رقم("أس **", نتيجة_أس.قيمة, 8)

# تأكد أن الكائنات الأصلية لم تتغير
تحقق_رقم("أ لم تتغير", أ.قيمة, 10)
تحقق_رقم("ب لم تتغير", ب.قيمة, 20)
تحقق_رقم("أس لم تتغير", أس.قيمة, 2)

# النتيجة
اطبع_سطر("نجاح: " + نجاح)
اطبع_سطر("فشل: " + فشل)
