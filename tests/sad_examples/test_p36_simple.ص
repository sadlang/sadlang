# اختبار مبسط من test_p36 - المرحلة 1: أساسيات فقط
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل -(آخر)
        ارجع جديد متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    عامل *(آخر)
        ارجع جديد متجه(هذا.س * آخر.س، هذا.ص * آخر.ص)
    نهاية

    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل !=(آخر)
        ارجع هذا.س != آخر.س أو هذا.ص != آخر.ص
    نهاية

    عامل <(آخر)
        ارجع (هذا.س * هذا.س + هذا.ص * هذا.ص) < (آخر.س * آخر.س + آخر.ص * آخر.ص)
    نهاية

    عامل -()
        ارجع جديد متجه(-هذا.س، -هذا.ص)
    نهاية

    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية

    عامل منطقي()
        ارجع هذا.س != 0 أو هذا.ص != 0
    نهاية
نهاية

# اختبارات أساسية
متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(3، 4)

# 1: الجمع
متغير ج = أ + ب
اطبع_سطر("" + ج)

# 2: الطرح
متغير د = ب - أ
اطبع_سطر("" + د)

# 3: الضرب
متغير هـ = أ * ب
اطبع_سطر("" + هـ)

# 4: المساواة
اطبع_سطر(أ == جديد متجه(1، 2))
اطبع_سطر(أ == ب)

# 5: عدم المساواة
اطبع_سطر(أ != ب)

