# اختبار: تحقق مع مقارنة كائنات
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية
    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير نجاح = 0

دالة تحقق(الوصف، القيمة، المتوقع)
    إذا (القيمة == المتوقع)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("فشل: " + الوصف)
    نهاية
نهاية

متغير أ = جديد متجه(1، 2)
متغير و = جديد متجه(1، 2)
# مقارنة كائنات تُرجع bool
متغير نت = أ == و
تحقق("== متساويان", نت, صحيح)
اطبع_سطر("نجح: " + نجاح)
