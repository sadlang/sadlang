# اختبار أنماط أكثر تعقيداً للمتغيرات العامة

صنف شخص
   نص الاسم
   رقم العمر
   
   باني(ا، ع)
      هذا.الاسم = ا
      هذا.العمر = ع
   نهاية
   
   دالة وصف()
      ارجع هذا.الاسم
   نهاية
نهاية

# متغيرات عامة متعددة
متغير أحمد = جديد شخص("أحمد"، 25)
متغير سارة = جديد شخص("سارة"، 30)

# وصول مباشر لحقل عام خارج دالة (بدون دالة)
اطبع_سطر(أحمد.الاسم)
اطبع_سطر(سارة.العمر)

# استدعاء طريقة على متغير عام
اطبع_سطر(أحمد.وصف())

# تعديل حقل عام
أحمد.العمر = 26
اطبع_سطر(أحمد.العمر)

# تمرير متغير عام كوسيط
دالة اطبع_اسم(ش)
   اطبع_سطر(ش.الاسم)
نهاية

اطبع_اسم(سارة)
