# اختبار تحميل عامل الأُس ** زائداً

صنف مصفوفة_مربعة
    متغير قيم = []

    باني(ق)
        هذا.قيم = ق
    نهاية

    # عامل الأُس: رفع كل عنصر للأس
    عامل عام **(أس)
        متغير نتيجة = []
        لكل ع في هذا.قيم
            متغير ق = 1
            متغير ت = 0
            بينما (ت < أس)
                ق = ق * ع
                ت += 1
            نهاية
            نتيجة += [ق]
        نهاية
        ارجع جديد مصفوفة_مربعة(نتيجة)
    نهاية

    دالة عام طباعة()
        ارجع "" + هذا.قيم
    نهاية
نهاية

متغير م = جديد مصفوفة_مربعة([2، 3، 4])
متغير م2 = م ** 3
اطبع_سطر("[2,3,4] ** 3 = " + م2.طباعة())

# التحقق: 2^3=8, 3^3=27, 4^3=64
إذا (م2.قيم[0] != 8)
    ارمي "فشل: 2^3 يجب أن يكون 8"
نهاية
إذا (م2.قيم[1] != 27)
    ارمي "فشل: 3^3 يجب أن يكون 27"
نهاية
إذا (م2.قيم[2] != 64)
    ارمي "فشل: 4^3 يجب أن يكون 64"
نهاية

# اختبار ** على أرقام عادية أيضاً
متغير ن = 2 ** 10
إذا (ن != 1024)
    ارمي "فشل: 2^10 يجب أن يكون 1024"
نهاية

