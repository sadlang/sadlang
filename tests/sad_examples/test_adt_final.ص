        اطبع_سطر("4:خطأ")
نهاية

# --- اختبار 5: تعداد ثانٍ ---
متغير ن1 = نتيجة.نجاح(100)
طابق (ن1)
    عندما نتيجة.نجاح(ق):
        اطبع_سطر("5:" + ق)
    عندما نتيجة.فشل(ر):
        اطبع_سطر("5:خطأ")
نهاية

# --- اختبار 6: تمرير لدالة ---
دالة وصف_الشكل(ش)
    متغير ناتج = "مجهول"
    طابق (ش)
        عندما شكل.دائرة(نق):
            اطبع_سطر("6:" + نق)
        عندما شكل.مستطيل(ع، ا):
            اطبع_سطر("7:" + ع + "×" + ا)
        عندما شكل.نقطة:
            اطبع_سطر("8:نقطة")
        افتراضي:
            اطبع_سطر("خطأ")
    نهاية
نهاية

وصف_الشكل(ش1)
وصف_الشكل(ش2)
وصف_الشكل(ش3)

# --- اختبار 9: إرجاع ADT من دالة ---
دالة اصنع_شكل(النوع)
    إذا (النوع == 1)
        ارجع شكل.دائرة(99)
    وإلا
        ارجع شكل.نقطة
    نهاية
نهاية

متغير ش5 = اصنع_شكل(1)
طابق (ش5)
    عندما شكل.دائرة(نق):
        اطبع_سطر("9:" + نق)
    افتراضي:
        اطبع_سطر("9:خطأ")
نهاية

