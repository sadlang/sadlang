# اختبار ADT شامل نهائي للمترجم
# يختبر: إنشاء، مطابقة، تمرير، إرجاع، unit variants، تعدادات متعددة

تعداد شكل
    دائرة(نصف_القطر)
    مستطيل(عرض، ارتفاع)
    مثلث(ضلع1، ضلع2، ضلع3)
    نقطة
نهاية

تعداد نتيجة
    نجاح(قيمة)
    فشل(رسالة)
نهاية

# --- اختبار 1: مطابقة data variants ---
متغير ش1 = شكل.دائرة(42)
طابق (ش1)
    عندما شكل.دائرة(نق):
        اطبع_سطر("1:" + نق)
    افتراضي:
        اطبع_سطر("1:خطأ")
نهاية

# --- اختبار 2: مطابقة مع حقول متعددة ---
متغير ش2 = شكل.مستطيل(10، 20)
طابق (ش2)
    عندما شكل.مستطيل(ع، ا):
        اطبع_سطر("2:" + ع + "×" + ا)
    افتراضي:
        اطبع_سطر("2:خطأ")
نهاية

# --- اختبار 3: unit variant ---
متغير ش3 = شكل.نقطة
طابق (ش3)
    عندما شكل.نقطة:
        اطبع_سطر("3:نقطة")
    افتراضي:
        اطبع_سطر("3:خطأ")
نهاية

# --- اختبار 4: مطابقة 3 حقول ---
متغير ش4 = شكل.مثلث(3، 4، 5)
طابق (ش4)
    عندما شكل.مثلث(أ، ب، ج):
        اطبع_سطر("4:" + أ + "+" + ب + "+" + ج)
