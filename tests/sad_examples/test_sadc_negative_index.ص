# اختبار الفهارس السالبة في المترجم sadc
# م[-1] = آخر عنصر، م[-2] = ما قبل الأخير، إلخ

متغير م = [10، 20، 30، 40، 50]

# === اختبار 1: قراءة بفهرس سالب ===
اطبع_سطر("=== اختبار القراءة ===")
اطبع(م[-1])     # المتوقع: 50
اطبع(" ")
اطبع(م[-2])     # المتوقع: 40
اطبع(" ")
اطبع(م[-3])     # المتوقع: 30
اطبع(" ")
اطبع(م[-5])     # المتوقع: 10
اطبع_سطر("")

# === اختبار 2: كتابة بفهرس سالب ===
اطبع_سطر("=== اختبار الكتابة ===")
م[-1] = 99
اطبع(م[4])      # المتوقع: 99
اطبع(" ")
م[-3] = 77
اطبع(م[2])      # المتوقع: 77
اطبع_سطر("")

# === اختبار 3: الشرائح بفهرس سالب ===
اطبع_سطر("=== اختبار الشرائح ===")
متغير م2 = [1، 2، 3، 4، 5، 6، 7، 8]
متغير ش1 = م2[-3:]    # آخر 3 عناصر: [6، 7، 8]
اطبع(طول(ش1))         # المتوقع: 3
اطبع(" ")
اطبع(ش1[0])           # المتوقع: 6
اطبع(" ")
اطبع(ش1[2])           # المتوقع: 8
اطبع_سطر("")

# === اختبار 4: حذف بفهرس سالب ===
اطبع_سطر("=== اختبار الحذف ===")
متغير م3 = [100، 200، 300، 400، 500]
احذف(م3، -1)           # حذف آخر عنصر (500)
اطبع(طول(م3))          # المتوقع: 4
اطبع(" ")
اطبع(م3[3])            # المتوقع: 400
اطبع_سطر("")

احذف(م3، -2)           # حذف العنصر ما قبل الأخير (300)
اطبع(طول(م3))          # المتوقع: 3
اطبع(" ")
اطبع(م3[0])            # المتوقع: 100
اطبع(" ")
اطبع(م3[1])            # المتوقع: 200
اطبع(" ")
اطبع(م3[2])            # المتوقع: 400
اطبع_سطر("")

اطبع_سطر("تم!")
