# اختبار الأسماء المستعارة للأنواع (Type Aliases)
# الصيغة: نوع اسم_مستعار = تعبير_هدف
# ═══════════════════════════════════════════════════════════════════

اطبع_سطر("=== اختبار 1: اسم مستعار لصنف ===")

صنف شخص
    متغير عام الاسم
    متغير عام العمر
    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية
    دالة عام وصف()
        ارجع هذا.الاسم + " (" + هذا.العمر + ")"
    نهاية
نهاية

# نوع مستعار: مستخدم = شخص
نوع مستخدم = شخص

متغير م = جديد مستخدم("أحمد"، 25)
اطبع_سطر("مستخدم: " + م.وصف())

