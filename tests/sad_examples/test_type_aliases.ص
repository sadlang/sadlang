اطبع_سطر("=== اختبار 6: اسم مستعار مع تعداد جبري (ADT) ===")

تعداد شكل
    دائرة(نصف_قطر)
    مستطيل(عرض، ارتفاع)
نهاية

نوع رسم = شكل

متغير د = رسم.دائرة(5)
متغير م2 = رسم.مستطيل(10، 20)

طابق (د)
    عندما شكل.دائرة(نق):
        اطبع_سطر("دائرة بنصف قطر: " + نق)
    عندما شكل.مستطيل(ع، ا):
        اطبع_سطر("مستطيل: " + ع + "×" + ا)
نهاية

اطبع_سطر("=== انتهت اختبارات الأسماء المستعارة بنجاح ===")
