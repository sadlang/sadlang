# === اختبار شامل للصفوف (Tuples) ===
متغير نجاح = 0
متغير فشل = 0

# --- 1. إنشاء صفوف ---
متغير ص1 = (1، 2، 3)
إذا (ص1.0 == 1 و ص1.1 == 2 و ص1.2 == 3)
    نجاح = نجاح + 1
    اطبع_سطر("✓ 1: إنشاء صف بسيط")
وإلا
    فشل = فشل + 1
    اطبع_سطر("✗ 1: إنشاء صف بسيط")
نهاية

# --- 2. أنواع مختلطة ---
متغير ص2 = ("سلام"، 42، صحيح)
إذا (ص2.0 == "سلام" و ص2.1 == 42 و ص2.2 == صحيح)
    نجاح = نجاح + 1
    اطبع_سطر("✓ 2: أنواع مختلطة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("✗ 2: أنواع مختلطة")
نهاية

# --- 3. صف فارغ ---
متغير ص3 = ()
إذا (ص3.حجم == 0)
    نجاح = نجاح + 1
    اطبع_سطر("✓ 3: صف فارغ")
وإلا
