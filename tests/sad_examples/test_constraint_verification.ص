# اختبار التحقق من قيود القوالب في وقت التشغيل

# ======================================================
# الاختبار 1: قالب بدون قيود — يجب أن يعمل
# ======================================================

قالب<نوع ت> دالة هوية(أ)
    ارجع أ
نهاية

متغير ن1 = هوية<رقم>(42)
إذا (ن1 == 42)
    اطبع_سطر("✅ اختبار 1: قالب بدون قيود — نجح")
وإلا
    اطبع_سطر("❌ اختبار 1: فشل")
نهاية

# ======================================================
# الاختبار 2: سمة + صنف ينفذها + قالب مقيد
# ======================================================

سمة قابل_للمقارنة
    دالة قارن(آخر)
نهاية

صنف عدد
    باني(ق)
        هذا.قيمة = ق
    نهاية
نهاية

نفذ قابل_للمقارنة لـ عدد
    دالة قارن(آخر)
        ارجع هذا.قيمة - آخر.قيمة
    نهاية
نهاية

قالب<نوع ت: قابل_للمقارنة> دالة أكبر_مقيد(أ، ب)
    إذا (أ.قارن(ب) > 0)
        ارجع أ
    نهاية
    ارجع ب
نهاية

متغير أ = جديد عدد(10)
متغير ب = جديد عدد(20)
متغير نتيجة = أكبر_مقيد<عدد>(أ، ب)
إذا (نتيجة.قيمة == 20)
    اطبع_سطر("✅ اختبار 2: صنف ينفذ السمة — نجح")
وإلا
    اطبع_سطر("❌ اختبار 2: فشل")
نهاية

# ======================================================
# الاختبار 3: صنف لا ينفذ السمة — يجب أن يرمي خطأ
# ======================================================

صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

حاول
    متغير ن1 = جديد نقطة(1، 2)
    متغير ن2 = جديد نقطة(3، 4)
    متغير خطأ = أكبر_مقيد<نقطة>(ن1، ن2)
    اطبع_سطر("❌ اختبار 3: كان يجب أن يرمي خطأ")
امسك (خ)
    اطبع_سطر("✅ اختبار 3: رفض نوع لا ينفذ السمة — نجح")
نهاية

# ======================================================
# الاختبار 4: نوع مدمج مع قيد — يمر (لا تحقق ممكن)
# ======================================================

متغير ن4 = أكبر_مقيد<رقم>(5، 3)
اطبع_سطر("✅ اختبار 4: نوع مدمج مع قيد — مرّ")

# ======================================================
# الاختبار 5: صنف قالب مع قيود
# ======================================================

سمة قابل_للتخزين
    دالة احفظ()
نهاية

صنف مستند
    باني(م)
        هذا.محتوى = م
    نهاية
نهاية

نفذ قابل_للتخزين لـ مستند
    دالة احفظ()
        ارجع "تم حفظ: " + هذا.محتوى
    نهاية
نهاية

قالب<نوع ت: قابل_للتخزين> صنف مخزن
    باني(ع)
        هذا.عنصر = ع
    نهاية
نهاية

متغير م = جديد مخزن<مستند>(جديد مستند("بيانات"))
اطبع_سطر("✅ اختبار 5: صنف قالب مع قيد — نجح")

# ======================================================
# الاختبار 6: صنف قالب — نوع لا ينفذ السمة
# ======================================================

حاول
    متغير م2 = جديد مخزن<نقطة>(جديد نقطة(1، 2))
    اطبع_سطر("❌ اختبار 6: كان يجب أن يرمي خطأ")
امسك (خ)
    اطبع_سطر("✅ اختبار 6: رفض صنف قالب لنوع غير مطابق — نجح")
نهاية

