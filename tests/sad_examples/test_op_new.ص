# اختبار العوامل الجديدة: بتية + استدعاء + نص

# ======================================
# صنف أعلام — يختبر العوامل البتية
# ======================================
صنف أعلام
    باني(قيمة)
        هذا.قيمة = قيمة
    نهاية

    عامل ^(آخر)
        ارجع جديد أعلام(هذا.قيمة ^ آخر.قيمة)
    نهاية

    عامل &(آخر)
        ارجع جديد أعلام(هذا.قيمة & آخر.قيمة)
    نهاية

    عامل |(آخر)
        ارجع جديد أعلام(هذا.قيمة | آخر.قيمة)
    نهاية

    عامل <<(آخر)
        ارجع جديد أعلام(هذا.قيمة << آخر.قيمة)
    نهاية

    عامل >>(آخر)
        ارجع جديد أعلام(هذا.قيمة >> آخر.قيمة)
    نهاية
نهاية

# ======================================
# صنف مضاعف — يختبر عامل الاستدعاء
# ======================================
صنف مضاعف
    باني(معامل)
        هذا.معامل = معامل
    نهاية

    عامل ()(قيمة)
        ارجع قيمة * هذا.معامل
    نهاية
نهاية

# ======================================
# صنف نقطة — يختبر عامل نص مع اطبع_سطر
# ======================================
صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد نقطة(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل نص()
        ارجع "(" + هذا.س + "," + هذا.ص + ")"
    نهاية
نهاية

# ============================================================================
# الاختبارات
# ============================================================================

# اختبار 1: XOR
متغير ع1 = جديد أعلام(6)
متغير ع2 = جديد أعلام(3)
متغير ع3 = ع1 ^ ع2
اطبع_سطر(ع3.قيمة)

# اختبار 2: AND
متغير ع4 = ع1 & ع2
اطبع_سطر(ع4.قيمة)

# اختبار 3: OR
متغير ع5 = ع1 | ع2
اطبع_سطر(ع5.قيمة)

# اختبار 4: SHIFT LEFT
متغير ع6 = جديد أعلام(1)
متغير ع7 = جديد أعلام(3)
متغير ع8 = ع6 << ع7
اطبع_سطر(ع8.قيمة)

# اختبار 5: SHIFT RIGHT
متغير ع9 = جديد أعلام(16)
متغير ع10 = جديد أعلام(2)
متغير ع11 = ع9 >> ع10
اطبع_سطر(ع11.قيمة)

# اختبار 6: عامل الاستدعاء
متغير ض = جديد مضاعف(5)
اطبع_سطر(ض(7))

# اختبار 7: عامل نص — طباعة كائن مباشرة
متغير ن1 = جديد نقطة(3، 4)
اطبع_سطر(ن1)

# اختبار 8: عامل + ثم نص
متغير ن2 = جديد نقطة(1، 2)
متغير ن3 = ن1 + ن2
اطبع_سطر(ن3)
