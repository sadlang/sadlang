# اختبار قاعدة وراثة العقود الذكية
# القاعدة: العقد لا يرث إلا من عقد آخر — الوراثة من صنف عادي مرفوضة
# ═══════════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

دالة سجّل(الاسم، النتيجة)
    إذا (النتيجة)
        نجاح = نجاح + 1
        اطبع_سطر("  ✓ " + الاسم + ": نجح")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("  ✗ " + الاسم + ": فشل")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════
اطبع_سطر("═══ اختبار وراثة العقود الذكية ═══")
# ═══════════════════════════════════════════════════════

# 1 — عقد أساسي يعمل بشكل طبيعي
عقد عقد_أساسي
    متغير عام اسم

    باني(ا)
        هذا.اسم = ا
    نهاية

    دالة عام وصف()
        ارجع "عقد: " + هذا.اسم
    نهاية
نهاية

متغير ع1 = جديد عقد_أساسي("اختبار")
سجّل("عقد أساسي يعمل", ع1.اسم == "اختبار")
سجّل("دالة العقد تعمل", ع1.وصف() == "عقد: اختبار")

# 2 — عقد يرث من عقد آخر (مسموح)
عقد عقد_فرعي يرث عقد_أساسي
    متغير عام قيمة

    باني(ا، ق)
        الأساس(ا)
        هذا.قيمة = ق
    نهاية

    دالة عام وصف_كامل()
        ارجع هذا.وصف() + " [" + هذا.قيمة + "]"
    نهاية
نهاية

متغير ع2 = جديد عقد_فرعي("فرعي"، 42)
سجّل("عقد يرث عقد: الاسم", ع2.اسم == "فرعي")
سجّل("عقد يرث عقد: القيمة", ع2.قيمة == 42)
سجّل("عقد يرث عقد: دالة الأب", ع2.وصف() == "عقد: فرعي")

# 3 — صنف عادي
صنف صنف_عادي
    متغير عام بيان

    باني(ب)
        هذا.بيان = ب
    نهاية
نهاية

متغير ص1 = جديد صنف_عادي("مرحبا")
سجّل("صنف عادي يعمل", ص1.بيان == "مرحبا")

# 4 — عقد يرث من صنف عادي (مرفوض!)
# هذا هو الاختبار الأهم — يجب أن يرمي خطأ
متغير رُفض = خطأ
متغير رسالة_رفض = ""

حاول
    # نحاول إنشاء عقد يرث من صنف عادي
    # لكن المشكلة أن تعريف الصنف يحدث عند تنفيذه وليس عند الاستدعاء
    # لذلك نحتاج طريقة لاختبار فشل تعريف الصنف
    
    # الحل: نكتب التعريف مباشرة داخل حاول
    عقد عقد_خاطئ يرث صنف_عادي
        باني عام()
            الأساس("خطأ")
            هذا.رقم = 0
        نهاية
    نهاية
امسك خطأ
    رُفض = صحيح
    رسالة_رفض = خطأ
نهاية

سجّل("عقد يرث صنف عادي: رُفض", رُفض)

إذا (رُفض)
    اطبع_سطر("  ℹ رسالة الرفض: " + رسالة_رفض)
نهاية

# 5 — صنف عادي يرث من صنف عادي (مسموح)
صنف صنف_فرعي يرث صنف_عادي
    باني عام(ب، ر)
        الأساس(ب)
        هذا.رقم = ر
    نهاية
نهاية

متغير ص2 = جديد صنف_فرعي("فرعي"، 10)
سجّل("صنف يرث صنف: مسموح", ص2.بيان == "فرعي")

# 6 — صنف عادي يرث من عقد (مسموح — لا قيد عكسي)
صنف صنف_من_عقد يرث عقد_أساسي
    متغير عام إضافة

    باني(ا، إ)
        الأساس(ا)
        هذا.إضافة = إ
    نهاية
نهاية

متغير ص3 = جديد صنف_من_عقد("من_عقد"، صحيح)
سجّل("صنف يرث عقد: مسموح", ص3.اسم == "من_عقد")

# ════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══════════════════════════════════")
اطبع_سطر("📊 نتائج اختبار وراثة العقود:")
اطبع_سطر("  ✓ ناجحة: " + نجاح)
اطبع_سطر("  ✗ فاشلة: " + فشل)
اطبع_سطر("  📋 المجموع: " + (نجاح + فشل))
إذا (فشل == 0)
    اطبع_سطر("🎉 جميع الاختبارات نجحت!")
وإلا
    اطبع_سطر("⚠️ يوجد " + فشل + " اختبارات فاشلة")
نهاية
اطبع_سطر("═══════════════════════════════════")
