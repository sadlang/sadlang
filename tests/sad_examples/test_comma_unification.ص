# اختبار توحيد الفواصل والمنقوطات

# 1. فاصلة عربية في وسائط الدوال
دالة رقم جمع(أ، ب)
    ارجع أ + ب
نهاية

# 2. فاصلة لاتينية أيضاً تعمل
دالة رقم ضرب(أ, ب)
    ارجع أ * ب
نهاية

# 3. مصفوفة بفاصلة عربية
متغير أرقام = [1، 2، 3، 4، 5]

# 4. مصفوفة بفاصلة لاتينية
متغير حروف = ["أ", "ب", "ج"]

# 5. خريطة بفاصلة عربية
متغير بيانات = {"اسم": "أحمد"، "عمر": 25}

# 6. استدعاء بفاصلة عربية ومختلطة
متغير نتيجة1 = جمع(10، 20)
متغير نتيجة2 = ضرب(3, 7)

# 7. صنف مع وسائط
صنف نقطة
    متغير س = 0
    متغير ص = 0
    
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    
    دالة نص وصف()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير ن = جديد نقطة(5، 10)

# 8. لكل مع مصفوفة
متغير مجموع = 0
لكل رقم في أرقام
    مجموع = مجموع + رقم
نهاية

# طباعة النتائج
اطبع_سطر("جمع(10، 20) = " + نتيجة1)
اطبع_سطر("ضرب(3, 7) = " + نتيجة2)
اطبع_سطر("النقطة: " + ن.وصف())
اطبع_سطر("المجموع: " + مجموع)
اطبع_سطر("البيانات: " + بيانات["اسم"] + " - " + بيانات["عمر"])
اطبع_سطر("✅ توحيد الفواصل يعمل بنجاح!")
