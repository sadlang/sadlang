# ─── الاختبار 2: إنشاء القيم ───
متغير ش1 = شكل.دائرة(42)
متغير ش2 = شكل.مستطيل(10، 20)
متغير ش3 = شكل.نقطة
اطبع_سطر("2: إنشاء القيم ✓")

# ─── الاختبار 3: استخراج حقل واحد ───
طابق (ش1)
    عندما شكل.دائرة(نق):
        اطبع("3: نصف القطر = ")
        اطبع_سطر(نق)
    افتراضي:
        اطبع_سطر("3: فشل!")
نهاية

# ─── الاختبار 4: استخراج حقلين ───
طابق (ش2)
    عندما شكل.مستطيل(ع، ا):
        اطبع("4: عرض=")
        اطبع(ع)
        اطبع(" ارتفاع=")
        اطبع_سطر(ا)
    افتراضي:
        اطبع_سطر("4: فشل!")
نهاية

# ─── الاختبار 5: مطابقة Unit variant ───
طابق (ش3)
    عندما شكل.نقطة:
        اطبع_سطر("5: نقطة ✓")
    افتراضي:
        اطبع_سطر("5: فشل!")
نهاية

# ─── الاختبار 6: مطابقة شاملة عدة حالات ───
طابق (ش1)
    عندما شكل.مستطيل(ع، ا):
        اطبع_سطر("6: فشل!")
    عندما شكل.نقطة:
        اطبع_سطر("6: فشل!")
    عندما شكل.دائرة(نق):
        اطبع("6: صحيح - دائرة = ")
        اطبع_سطر(نق)
نهاية

