# ─── الاختبار 8: تعداد مع 3 حقول ───
متغير ل2 = لون.مخصص(128، 64، 255)

طابق (ل2)
    عندما لون.مخصص(ر، خ، ز):
        اطبع("8: مخصص(")
        اطبع(ر)
        اطبع("، ")
        اطبع(خ)
        اطبع("، ")
        اطبع(ز)
        اطبع_سطر(")")
    افتراضي:
        اطبع_سطر("8: فشل!")
نهاية

