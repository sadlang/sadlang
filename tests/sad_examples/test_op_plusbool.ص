# اختبار: + ثم منطقي (بدون ==)

صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل منطقي()
        ارجع هذا.س != 0 أو هذا.ص != 0
    نهاية
نهاية

متغير أ = جديد متجه(1، 2)
إذا (أ)
    اطبع_سطر("غير صفري")
