# ═══════════════════════════════════════
# اختبار 6: وراثة بثلاثة مستويات (جد → أب → ابن)
# ═══════════════════════════════════════
صنف شكل
    باني(اللون)
        هذا.اللون = اللون
    نهاية

    دالة نوع()
        ارجع "شكل"
    نهاية
نهاية

صنف مضلع يرث شكل
    باني(اللون، الأضلاع) : الأساس(اللون)
        هذا.الأضلاع = الأضلاع
    نهاية

    دالة نوع()
        ارجع "مضلع"
    نهاية
نهاية

صنف مثلث يرث مضلع
    باني(اللون، القاعدة، الارتفاع) : الأساس(اللون، 3)
        هذا.القاعدة = القاعدة
        هذا.الارتفاع = الارتفاع
    نهاية

    دالة نوع()
        ارجع "مثلث"
    نهاية

    دالة المساحة()
        ارجع هذا.القاعدة * هذا.الارتفاع / 2
    نهاية
نهاية

متغير ث = جديد مثلث("أحمر"، 10، 6)
اطبع_سطر("اختبار 6 — وراثة متعددة المستويات:")
اطبع_سطر("النوع: " + ث.نوع())
اطبع_سطر("اللون: " + ث.اللون)
اطبع_سطر("الأضلاع: " + ث.الأضلاع)
اطبع_سطر("المساحة: " + ث.المساحة())

# ═══════════════════════════════════════
# اختبار 7: عوامل زائدة (+ و -)
# ═══════════════════════════════════════
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل -(آخر)
        ارجع جديد متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    دالة نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير أ = جديد متجه(3، 4)
متغير ب = جديد متجه(1، 2)
متغير ج = أ + ب
متغير د = أ - ب

اطبع_سطر("اختبار 7 — عوامل زائدة:")
اطبع_سطر("أ = " + أ.نص())
اطبع_سطر("ب = " + ب.نص())
اطبع_سطر("أ + ب = " + ج.نص())
اطبع_سطر("أ - ب = " + د.نص())

# ═══════════════════════════════════════
# اختبار 8: تكوين — صنف يحتوي كائنات أخرى
# ═══════════════════════════════════════
صنف محرك
    باني(القوة)
        هذا.القوة = القوة
    نهاية

    دالة وصف()
        ارجع "محرك " + هذا.القوة + " حصان"
    نهاية
نهاية

صنف سيارة
    باني(الماركة، قوة_المحرك)
        هذا.الماركة = الماركة
        هذا.المحرك = جديد محرك(قوة_المحرك)
    نهاية

    دالة معلومات()
        ارجع هذا.الماركة + " — " + هذا.المحرك.وصف()
    نهاية
نهاية

متغير س = جديد سيارة("تويوتا"، 200)
اطبع_سطر("اختبار 8 — تكوين:")
اطبع_سطر(س.معلومات())
اطبع_سطر("الماركة: " + س.الماركة)
اطبع_سطر("قوة المحرك: " + س.المحرك.القوة)

# ═══════════════════════════════════════
# اختبار 9: طرائق متعددة وحقول محسوبة
# ═══════════════════════════════════════
صنف دائرة
    باني(نصف_القطر)
        هذا.نصف_القطر = نصف_القطر
    نهاية

    دالة القطر()
        ارجع هذا.نصف_القطر * 2
    نهاية

    دالة المحيط()
        # تقريب: π ≈ 3
        ارجع هذا.القطر() * 3
    نهاية
نهاية

متغير دا = جديد دائرة(7)
اطبع_سطر("اختبار 9 — طرائق متعددة:")
اطبع_سطر("نصف القطر: " + دا.نصف_القطر)
اطبع_سطر("القطر: " + دا.القطر())
اطبع_سطر("المحيط: " + دا.المحيط())

# ═══════════════════════════════════════
# اختبار 10: وراثة مع إعادة تعريف وحقول إضافية
# ═══════════════════════════════════════
صنف موظف
    باني(الاسم، الراتب)
        هذا.الاسم = الاسم
        هذا.الراتب = الراتب
    نهاية

    دالة الراتب_الشهري()
        ارجع هذا.الراتب
    نهاية
نهاية

صنف مدير يرث موظف
    باني(الاسم، الراتب، العلاوة) : الأساس(الاسم، الراتب)
        هذا.العلاوة = العلاوة
    نهاية

    # إعادة تعريف — الراتب + العلاوة
    دالة الراتب_الشهري()
        ارجع هذا.الراتب + هذا.العلاوة
    نهاية
نهاية

متغير مو = جديد موظف("سعيد"، 5000)
متغير مد = جديد مدير("خالد"، 8000، 2000)

اطبع_سطر("اختبار 10 — وراثة مع إعادة تعريف:")
اطبع_سطر(مو.الاسم + " راتبه: " + مو.الراتب_الشهري())
اطبع_سطر(مد.الاسم + " راتبه: " + مد.الراتب_الشهري())

اطبع_سطر("=== جميع اختبارات OOP المتقدمة نجحت ===")
