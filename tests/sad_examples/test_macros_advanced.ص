# اختبار شامل لتحسينات نظام الماكروز
# يشمل: ماكروز متداخلة، معاملات متغيرة، قيم إرجاع، أمان النطاق

# ====================================
# اختبار 1: ماكروز متداخلة
# ====================================
ماكرو تنسيق(نص)
    ارجع "[" + نص + "]"
نهاية

ماكرو سجّل(رسالة)
    متغير منسّق = تنسيق!(رسالة)
    اطبع_سطر("📝 " + منسّق)
نهاية

سجّل!("اختبار الماكروز المتداخلة")

# ====================================
# اختبار 2: ماكرو تعبيري (يُرجع قيمة)
# ====================================
ماكرو أكبر(أ، ب)
    إذا (أ > ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

متغير الأكبر = أكبر!(10، 25)
اطبع_سطر("الأكبر بين 10 و 25 هو: " + الأكبر)

إذا (الأكبر == 25)
    اطبع_سطر("✅ اختبار الماكرو التعبيري نجح")
وإلا
    اطبع_سطر("❌ اختبار الماكرو التعبيري فشل")
نهاية

# ====================================
# اختبار 3: ماكرو بمعاملات متغيرة
# ====================================
ماكرو سجّل_الكل(...رسائل)
    لكل ر في رسائل
        اطبع_سطر("  → " + ر)
    نهاية
نهاية

اطبع_سطر("الرسائل:")
سجّل_الكل!("رسالة 1"، "رسالة 2"، "رسالة 3")

# ====================================
# اختبار 4: ماكرو متغير مع معاملات مطلوبة
# ====================================
ماكرو سجّل_بمستوى(مستوى، ...رسائل)
    لكل ر في رسائل
        اطبع_سطر("[" + مستوى + "] " + ر)
    نهاية
نهاية

سجّل_بمستوى!("تحذير"، "الذاكرة منخفضة"، "الأداء بطيء")

# ====================================
# اختبار 5: أمان النطاق (Hygiene)
# ====================================
متغير س = 100
ماكرو اختبار_النطاق()
    متغير س = 999
    اطبع_سطر("داخل الماكرو: س = " + س)
نهاية

اختبار_النطاق!()
اطبع_سطر("خارج الماكرو: س = " + س)

إذا (س == 100)
    اطبع_سطر("✅ اختبار أمان النطاق نجح — المتغير الخارجي لم يتأثر")
وإلا
    اطبع_سطر("❌ اختبار أمان النطاق فشل — س = " + س)
نهاية

# ====================================
# اختبار 6: تعديل متغير مع أمان النطاق
# ====================================
متغير عداد = 0
ماكرو زد(المتغير)
    المتغير = المتغير + 1
نهاية

زد!(عداد)
زد!(عداد)
زد!(عداد)

إذا (عداد == 3)
    اطبع_سطر("✅ اختبار النسخ للخلف نجح — العدّاد = " + عداد)
وإلا
    اطبع_سطر("❌ اختبار النسخ للخلف فشل — العدّاد = " + عداد)
نهاية

# ====================================
# اختبار 7: ماكرو تعبيري مع حسابات
# ====================================
ماكرو مربع(ن)
    ارجع ن * ن
نهاية

متغير نتيجة = مربع!(7) + مربع!(3)
اطبع_سطر("7² + 3² = " + نتيجة)

إذا (نتيجة == 58)
    اطبع_سطر("✅ اختبار الماكرو الحسابي نجح")
وإلا
    اطبع_سطر("❌ اختبار الماكرو الحسابي فشل — النتيجة: " + نتيجة)
نهاية

اطبع_سطر("")
اطبع_سطر("🎉 انتهت جميع اختبارات الماكروز المتقدمة!")
