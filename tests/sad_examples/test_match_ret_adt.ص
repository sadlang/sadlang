# اختبار: return من match مع أنواع جبرية (ADT)
تعداد شكل
    نقطة
    دائرة(نصف_قطر)
    مستطيل(عرض، طول)
نهاية

دالة وصف_شكل(ش)
    طابق (ش)
        عندما شكل.نقطة:
            ارجع "نقطة"
        عندما شكل.دائرة(ق):
            ارجع "دائرة"
        عندما شكل.مستطيل(ع، ط):
            ارجع "مستطيل"
        افتراضي:
            ارجع "مجهول"
    نهاية
نهاية

دالة مساحة(ش)
    طابق (ش)
        عندما شكل.نقطة:
            ارجع 0
        عندما شكل.دائرة(ق):
            ارجع ق * ق
        عندما شكل.مستطيل(ع، ط):
            ارجع ع * ط
        افتراضي:
            ارجع -1
    نهاية
نهاية

متغير ن = شكل.نقطة
متغير د = شكل.دائرة(5)
متغير م = شكل.مستطيل(3، 4)

اطبع_سطر(وصف_شكل(ن))
اطبع_سطر(وصف_شكل(د))
اطبع_سطر(وصف_شكل(م))
اطبع_سطر(مساحة(ن))
اطبع_سطر(مساحة(د))
اطبع_سطر(مساحة(م))
