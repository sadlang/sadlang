# اختبار تعليقات التوثيق

## جمع عددين وإرجاع الناتج
## @معطى أ العدد الأول
## @معطى ب العدد الثاني
## @أرجع مجموع العددين
دالة جمع(أ، ب)
    ارجع أ + ب
نهاية

#** 
تقسيم عددين مع التحقق من القاسم
@معطى أ البسط
@معطى ب المقام (لا يساوي صفر)
@أرجع حاصل القسمة
@استثناء خطأ_قسمة إذا كان ب يساوي صفر
@مثال قسمة(10, 2) ← 5
**#
دالة قسمة(أ، ب)
    إذا (ب == 0)
        ارمي "خطأ: القسمة على صفر"
    نهاية
    ارجع أ / ب
نهاية

## صنف يمثل نقطة في المستوي الديكارتي
صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    
    دالة طباعة()
        اطبع_سطر("(" + هذا.س + "، " + هذا.ص + ")")
    نهاية
نهاية

# اختبار
متغير نتيجة = جمع(3، 5)
اطبع_سطر("3 + 5 = " + نتيجة)

متغير ق = قسمة(10، 2)
اطبع_سطر("10 / 2 = " + ق)

متغير ن = جديد نقطة(3، 4)
