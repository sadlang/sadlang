# اختبار طرق الامتداد (Extension Methods)
# هذا الملف يختبر إضافة دوال جديدة لصنف موجود عبر كتلة "امتداد"

# تعريف صنف بسيط
صنف نقطة
    متغير عام س
    متغير عام ص

    باني(أ، ب)
        هذا.س = أ
        هذا.ص = ب
    نهاية
نهاية

# إضافة دوال جديدة عبر الامتداد
امتداد نقطة
    دالة وصف()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية

    دالة مجموع()
        ارجع هذا.س + هذا.ص
    نهاية
نهاية

# اختبار 1: الدوال الأساسية
متغير ن = جديد نقطة(3، 7)
اطبع_سطر("اختبار 1 - الوصف: " + ن.وصف())
اطبع_سطر("اختبار 1 - المجموع: " + ن.مجموع())

# اختبار 2: امتداد ثاني لنفس الصنف
امتداد نقطة
    دالة مسافة_من_الأصل()
        ارجع (هذا.س * هذا.س + هذا.ص * هذا.ص)
    نهاية
نهاية

متغير ن2 = جديد نقطة(3، 4)
اطبع_سطر("اختبار 2 - المسافة²: " + ن2.مسافة_من_الأصل())

# اختبار 3: صنف آخر مع امتداد
صنف شخص
    متغير عام الاسم
    متغير عام العمر

    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية
نهاية

امتداد شخص
    دالة تحية()
        ارجع "مرحباً، اسمي " + هذا.الاسم + " وعمري " + هذا.العمر
    نهاية

    دالة بالغ()
        ارجع هذا.العمر >= 18
    نهاية
نهاية

متغير أحمد = جديد شخص("أحمد"، 25)
اطبع_سطر("اختبار 3 - التحية: " + أحمد.تحية())
اطبع_سطر("اختبار 3 - بالغ: " + أحمد.بالغ())

متغير سارة = جديد شخص("سارة"، 15)
اطبع_سطر("اختبار 3 - بالغ (سارة): " + سارة.بالغ())

اطبع_سطر("✅ جميع الاختبارات نجحت!")
