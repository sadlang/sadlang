# ═══════ INSERT_TOKEN: قوس إغلاق مفقود في تعريف دالة ═══════
# خطأ: دالة جمع(أ، ب  ← ينقص )
دالة جمع(أ، ب
   ارجع أ + ب
نهاية

# ═══════ كود سليم بعد كل خطأ ═══════
دالة حساب_مربع(ن)
   ارجع ن * ن
نهاية

# ═══════ INSERT_TOKEN: قوس إغلاق مفقود في استدعاء دالة ═══════
# خطأ: حساب_مربع(5  ← ينقص )
# (ملاحظة: هذا يعتمد على مسار التحليل)

# ═══════ تحقق: الدوال تعمل بعد التعافي ═══════
متغير ن1 = جمع(3، 7)
متغير ن2 = حساب_مربع(4)

اطبع("═══ نتائج الاختبارات ═══")
اطبع("جمع(3، 7) = " + ن1)
اطبع("حساب_مربع(4) = " + ن2)

# ═══════ تحقق من جميع أنواع الجمل ═══════

# شرط
إذا (ن1 == 10)
   اطبع("✅ الشرط: ن1 == 10")
وإلا
   اطبع("❌ الشرط: ن1 != 10 (قيمة: " + ن1 + ")")
نهاية

# حلقة  
متغير مج = 0
لكل ع في [1، 2، 3، 4، 5]
   مج = مج + ع
نهاية
اطبع("✅ الحلقة: مجموع [1..5] = " + مج)

# متغير وعمليات
متغير نتيجة = (ن1 + ن2) * 2
اطبع("✅ العمليات: (10+16)*2 = " + نتيجة)

# مطابقة
طابق (ن2)
   عندما 16:
      اطبع("✅ المطابقة: ن2 == 16")
   افتراضي:
      اطبع("❌ المطابقة: ن2 != 16")
نهاية

