# ═══════════════════════════════════════════════════════════
# اختبارات شاملة ومعقدة للأنظمة المدمجة
# يختبر: الماكروز + طرق الامتداد + تكاملهما مع باقي اللغة
# ═══════════════════════════════════════════════════════════

متغير اختبارات_ناجحة = 0
متغير اختبارات_فاشلة = 0

ماكرو تأكد(شرط، وصف)
    إذا (شرط)
        اختبارات_ناجحة = اختبارات_ناجحة + 1
        اطبع_سطر("  ✅ " + وصف)
    وإلا
        اختبارات_فاشلة = اختبارات_فاشلة + 1
        اطبع_سطر("  ❌ " + وصف)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════
# القسم 1: اختبارات الماكروز المتقدمة
# ═══════════════════════════════════════════════════════════
اطبع_سطر("═══ القسم 1: الماكروز المتقدمة ═══")

# --- 1.1: ماكرو تعبيري مع شروط متداخلة ---
ماكرو تصنيف_عمر(عمر)
    إذا (عمر < 13)
        ارجع "طفل"
    وإلا
        إذا (عمر < 20)
            ارجع "مراهق"
        وإلا
            إذا (عمر < 60)
                ارجع "بالغ"
            وإلا
                ارجع "كبير"
            نهاية
        نهاية
    نهاية
نهاية

تأكد!(تصنيف_عمر!(5) == "طفل"، "تصنيف عمر 5 = طفل")
تأكد!(تصنيف_عمر!(15) == "مراهق"، "تصنيف عمر 15 = مراهق")
تأكد!(تصنيف_عمر!(30) == "بالغ"، "تصنيف عمر 30 = بالغ")
تأكد!(تصنيف_عمر!(70) == "كبير"، "تصنيف عمر 70 = كبير")

# --- 1.2: ماكرو تعبيري مع حسابات ---
ماكرو مضروب(ن)
    متغير نتيجة = 1
    متغير ع = ن
    بينما (ع > 1)
        نتيجة = نتيجة * ع
        ع = ع - 1
    نهاية
    ارجع نتيجة
نهاية

تأكد!(مضروب!(5) == 120، "مضروب 5 = 120")
تأكد!(مضروب!(1) == 1، "مضروب 1 = 1")
تأكد!(مضروب!(0) == 1، "مضروب 0 = 1")

# --- 1.3: ماكروز متداخلة (3 مستويات) ---
ماكرو تنسيق_قيمة(قيمة)
    ارجع "[" + قيمة + "]"
نهاية

ماكرو تنسيق_حقل(اسم، قيمة)
    متغير منسّقة = تنسيق_قيمة!(قيمة)
    ارجع اسم + ": " + منسّقة
نهاية

ماكرو تنسيق_سجل(اسم، عمر)
    متغير حقل1 = تنسيق_حقل!("الاسم"، اسم)
    متغير حقل2 = تنسيق_حقل!("العمر"، عمر)
    ارجع "{" + حقل1 + "، " + حقل2 + "}"
نهاية

متغير سجل = تنسيق_سجل!("أحمد"، "25")
تأكد!(سجل == "{الاسم: [أحمد]، العمر: [25]}"، "ماكروز متداخلة 3 مستويات")

# --- 1.4: ماكرو بمعاملات متغيرة - تجميع ---
ماكرو مجموع_الكل(...أرقام)
    متغير المجموع = 0
    لكل ر في أرقام
        المجموع = المجموع + ر
    نهاية
    ارجع المجموع
نهاية

تأكد!(مجموع_الكل!(1، 2، 3، 4، 5) == 15، "مجموع 1..5 = 15")
تأكد!(مجموع_الكل!(100) == 100، "مجموع عنصر واحد = 100")

# --- 1.5: ماكرو متغير مع معاملات مطلوبة ---
ماكرو بناء_رسالة(بادئة، ...أجزاء)
    متغير النتيجة = بادئة
    لكل جزء في أجزاء
        النتيجة = النتيجة + " " + جزء
    نهاية
    ارجع النتيجة
نهاية

متغير رسالة = بناء_رسالة!("مرحبا"، "يا"، "عالم"، "الجميل")
تأكد!(رسالة == "مرحبا يا عالم الجميل"، "بناء رسالة مع معاملات متغيرة")

# --- 1.6: أمان النطاق - عدم تلوث ---
متغير خارجي_1 = "أصلي"
متغير خارجي_2 = 42

ماكرو اختبار_عزل()
    متغير خارجي_1 = "معدّل"
    متغير خارجي_2 = 999
    متغير داخلي_فقط = "محلي"
نهاية

اختبار_عزل!()
تأكد!(خارجي_1 == "أصلي"، "أمان النطاق: نص لم يتغير")
تأكد!(خارجي_2 == 42، "أمان النطاق: رقم لم يتغير")

# --- 1.7: النسخ للخلف مع عدة متغيرات ---
ماكرو تبديل(أ، ب)
    متغير مؤقت = أ
    أ = ب
    ب = مؤقت
نهاية

متغير س = 10
متغير ص = 20
تبديل!(س، ص)
تأكد!(س == 20، "تبديل: س أصبح 20")
تأكد!(ص == 10، "تبديل: ص أصبح 10")

# --- 1.8: ماكرو يستخدم ماكرو التأكد (ذاتي المرجع) ---
ماكرو تحقق_نطاق(قيمة، أدنى، أعلى)
    ارجع (قيمة >= أدنى) و (قيمة <= أعلى)
نهاية

تأكد!(تحقق_نطاق!(5، 1، 10)، "5 في النطاق [1، 10]")
تأكد!(ليس تحقق_نطاق!(15، 1، 10)، "15 ليس في النطاق [1، 10]")

# ═══════════════════════════════════════════════════════════
# القسم 2: اختبارات طرق الامتداد المتقدمة
# ═══════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══ القسم 2: طرق الامتداد المتقدمة ═══")

# --- 2.1: صنف مع عدة كتل امتداد ---
صنف متجه
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

# امتداد أول: عمليات أساسية
امتداد متجه
    دالة وصف()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية

    دالة مجموع()
        ارجع هذا.س + هذا.ص
    نهاية
نهاية

# امتداد ثانٍ: عمليات متقدمة
امتداد متجه
    دالة مسافة_مربعة()
        ارجع هذا.س * هذا.س + هذا.ص * هذا.ص
    نهاية

    دالة ضرب_عددي(عدد)
        ارجع جديد متجه(هذا.س * عدد، هذا.ص * عدد)
    نهاية
نهاية

متغير ف1 = جديد متجه(3، 4)
تأكد!(ف1.وصف() == "(3، 4)"، "امتداد متجه: وصف")
تأكد!(ف1.مجموع() == 7، "امتداد متجه: مجموع")
تأكد!(ف1.مسافة_مربعة() == 25، "امتداد متجه: مسافة²")

متغير ف2 = ف1.ضرب_عددي(3)
تأكد!(ف2.س == 9، "امتداد متجه: ضرب عددي (س)")
تأكد!(ف2.ص == 12، "امتداد متجه: ضرب عددي (ص)")

# --- 2.2: امتداد يستخدم دوال الصنف الأصلية ---
صنف حساب
    متغير عام الرصيد
    باني(رصيد)
        هذا.الرصيد = رصيد
    نهاية

    دالة إيداع(مبلغ)
        هذا.الرصيد = هذا.الرصيد + مبلغ
    نهاية
نهاية

امتداد حساب
    دالة وصف()
        ارجع "رصيد: " + هذا.الرصيد
    نهاية

    دالة هل_كافي(مبلغ)
        ارجع هذا.الرصيد >= مبلغ
    نهاية
نهاية

متغير ح = جديد حساب(1000)
ح.إيداع(500)
تأكد!(ح.وصف() == "رصيد: 1500"، "امتداد حساب: وصف بعد إيداع")
تأكد!(ح.هل_كافي(1000)، "امتداد حساب: رصيد كافي")
تأكد!(ليس ح.هل_كافي(2000)، "امتداد حساب: رصيد غير كافي")

# --- 2.3: امتداد مع وراثة ---
صنف شكل
    متغير عام النوع
    باني(نوع)
        هذا.النوع = نوع
    نهاية
نهاية

صنف مستطيل يرث شكل
    متغير عام العرض
    متغير عام الارتفاع
    باني(عرض، ارتفاع)
        الأساس("مستطيل")
        هذا.العرض = عرض
        هذا.الارتفاع = ارتفاع
    نهاية
نهاية

امتداد مستطيل
    دالة المساحة()
        ارجع هذا.العرض * هذا.الارتفاع
    نهاية

    دالة المحيط()
        ارجع 2 * (هذا.العرض + هذا.الارتفاع)
    نهاية
نهاية

متغير م = جديد مستطيل(5، 3)
تأكد!(م.المساحة() == 15، "امتداد مستطيل: المساحة")
تأكد!(م.المحيط() == 16، "امتداد مستطيل: المحيط")
تأكد!(م.النوع == "مستطيل"، "امتداد مستطيل: وراثة النوع")

# ═══════════════════════════════════════════════════════════
# القسم 3: تكامل الماكروز مع الامتدادات
# ═══════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══ القسم 3: تكامل الماكروز والامتدادات ═══")

# --- 3.1: ماكرو يستخدم كائناً من صنف مُمتد ---
ماكرو وصف_متجه(م)
    ارجع "المتجه " + م.وصف() + " مجموعه " + م.مجموع()
نهاية

متغير ف3 = جديد متجه(5، 7)
متغير وصف = وصف_متجه!(ف3)
تأكد!(وصف == "المتجه (5، 7) مجموعه 12"، "ماكرو يستدعي دوال امتداد")

# --- 3.2: ماكرو يُنشئ كائناً ويستخدم امتداده ---
ماكرو متجه_جديد(س، ص)
    ارجع جديد متجه(س، ص)
نهاية

متغير ف4 = متجه_جديد!(10، 20)
تأكد!(ف4.مجموع() == 30، "ماكرو يُنشئ كائن مُمتد")

# --- 3.3: ماكرو يعدّل كائناً ---
ماكرو إيداع_مضاعف(الحساب، المبلغ)
    الحساب.إيداع(المبلغ)
    الحساب.إيداع(المبلغ)
نهاية

متغير ح2 = جديد حساب(100)
إيداع_مضاعف!(ح2، 50)
تأكد!(ح2.هل_كافي(200)، "ماكرو يعدّل كائن بدوال أصلية + امتداد")

# ═══════════════════════════════════════════════════════════
# القسم 4: حالات حدّية
# ═══════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══ القسم 4: حالات حدّية ═══")

# --- 4.1: ماكرو بدون معاملات ---
ماكرو صفر()
    ارجع 0
نهاية
تأكد!(صفر!() == 0، "ماكرو بدون معاملات يُرجع قيمة")

# --- 4.2: ماكرو مع نصوص فارغة ---
ماكرو فارغ_أم_لا(نص)
    إذا (نص == "")
        ارجع "فارغ"
    وإلا
        ارجع "غير فارغ"
    نهاية
نهاية
تأكد!(فارغ_أم_لا!("") == "فارغ"، "نص فارغ")
تأكد!(فارغ_أم_لا!("مرحبا") == "غير فارغ"، "نص غير فارغ")

# --- 4.3: ماكرو مع أرقام سالبة ---
ماكرو قيمة_مطلقة(ن)
    إذا (ن < 0)
        ارجع 0 - ن
    وإلا
        ارجع ن
    نهاية
نهاية
تأكد!(قيمة_مطلقة!(-5) == 5، "قيمة مطلقة لـ -5")
تأكد!(قيمة_مطلقة!(5) == 5، "قيمة مطلقة لـ 5")
تأكد!(قيمة_مطلقة!(0) == 0، "قيمة مطلقة لـ 0")

# --- 4.4: ماكرو تعبيري في تعبير مركب ---
ماكرو مربع(ن)
    ارجع ن * ن
نهاية

متغير نتيجة_مربع = مربع!(6)
تأكد!(نتيجة_مربع == 36، "مربع 6 = 36")

متغير حساب_معقد = مضروب!(4) + مربع!(3) * 2
# مضروب(4) = 24, مربع(3) = 9, 24 + 9*2 = 42
تأكد!(حساب_معقد == 42، "تعبير مركب مع ماكروز: 42")

# --- 4.5: ماكرو متغير مع 0 وسائط إضافية ---
ماكرو اختياري(مطلوب، ...إضافي)
    متغير عدد = 0
    لكل _ في إضافي
        عدد = عدد + 1
    نهاية
    ارجع عدد
نهاية
تأكد!(اختياري!("أساسي") == 0، "ماكرو متغير: 0 وسائط إضافية")
تأكد!(اختياري!("أساسي"، "1"، "2") == 2، "ماكرو متغير: 2 وسائط إضافية")

# ═══════════════════════════════════════════════════════════
# النتائج النهائية
# ═══════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══════════════════════════════════")
اطبع_سطر("📊 نتائج الاختبارات:")
اطبع_سطر("  ✅ ناجحة: " + اختبارات_ناجحة)
اطبع_سطر("  ❌ فاشلة: " + اختبارات_فاشلة)
اطبع_سطر("  📋 المجموع: " + (اختبارات_ناجحة + اختبارات_فاشلة))
إذا (اختبارات_فاشلة == 0)
    اطبع_سطر("🎉 جميع الاختبارات نجحت!")
وإلا
    اطبع_سطر("⚠️ يوجد اختبارات فاشلة!")
نهاية
