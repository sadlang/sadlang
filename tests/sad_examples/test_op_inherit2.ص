# اختبار شامل: وراثة + كل أنواع التحويل

صنف كائن_قاعدة
    باني(اسم)
        هذا.اسم = اسم
    نهاية

    عامل نص()
        ارجع "كائن: " + هذا.اسم
    نهاية

    عامل منطقي()
        ارجع هذا.اسم != ""
    نهاية
نهاية

صنف موظف يرث كائن_قاعدة
    باني(اسم، راتب)
        الأساس(اسم)
        هذا.راتب = راتب
    نهاية
نهاية

متغير موظ = جديد موظف("أحمد"، 5000)

# 1. طباعة مباشرة (وراثة __op_tostring__)
اطبع_سطر(موظ)

# 2. دمج نص + كائن (وراثة __op_tostring__)
اطبع_سطر("الموظف: " + موظ)

# 3. كائن + نص (وراثة __op_tostring__)
اطبع_سطر(موظ + " - موظف")

# 4. شرط منطقي (وراثة __op_tobool__)
إذا (موظ)
    اطبع_سطر("موجود")
نهاية

# 5. حلقة مع وراثة __op_tobool__
متغير عداد = 0
بينما (موظ)
    عداد = عداد + 1
    إذا (عداد >= 2)
        توقف
    نهاية
نهاية
اطبع_سطر("عداد: " + عداد)
