# دالة بعمر تستدعي نفسها تكرارياً
دالة عد_تنازلي<'أ>(ن)
    إذا (ن <= 0)
        ارجع "انتهى"
    نهاية
    ارجع عد_تنازلي(ن - 1)
نهاية

