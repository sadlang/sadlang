# ==============================================================
# اختبار تعليقات العمر (Lifetime Annotations)
# ==============================================================
# هذا الملف يختبر تحليل وتخزين تعليقات العمر في لغة ص
# الأعمار تُفرض في المترجم (sadc) — المفسر يقبل الصيغة فقط
# ==============================================================

متغير نجاح = 0
متغير فشل = 0

دالة تأكد(شرط، رسالة)
    إذا (شرط)
        نجاح = نجاح + 1
        اطبع_سطر("  ✅ " + رسالة)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("  ❌ " + رسالة)
    نهاية
نهاية

