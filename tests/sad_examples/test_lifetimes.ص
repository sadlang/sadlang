# دالة بعمر + ماكرو
ماكرو مؤكد(شرط، رسالة)
    إذا (شرط)
        اطبع_سطر("  ✅ ماكرو: " + رسالة)
    وإلا
        اطبع_سطر("  ❌ ماكرو: " + رسالة)
    نهاية
نهاية

دالة مضاعف<'أ>(ن)
    ارجع ن * 2
نهاية

مؤكد!(مضاعف(21) == 42، "دالة بعمر من داخل ماكرو")

# أعمار مع صنف وامتداد
صنف صندوق
    باني(قيمة)
        هذا.قيمة = قيمة
    نهاية
نهاية

امتداد صندوق
    دالة محتوى()
        ارجع هذا.قيمة
    نهاية
نهاية

دالة فتح_صندوق<'أ>(ص)
    ارجع ص.محتوى()
نهاية

متغير ص1 = جديد صندوق("كنز")
تأكد(فتح_صندوق(ص1) == "كنز"، "دالة بعمر + صنف + امتداد")

