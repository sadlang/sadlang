# ==============================================================

# دالة تستقبل قيم وتُرجع عملية
دالة حساب<'أ>(أ، ب، عملية)
    إذا (عملية == "جمع")
        ارجع أ + ب
    وإلا إذا (عملية == "ضرب")
        ارجع أ * ب
    وإلا
        ارجع أ - ب
    نهاية
نهاية

تأكد(حساب(3، 5، "جمع") == 8، "دالة بعمر: حساب جمع")
تأكد(حساب(4، 3، "ضرب") == 12، "دالة بعمر: حساب ضرب")
تأكد(حساب(10، 3، "طرح") == 7، "دالة بعمر: حساب طرح")

# دالة تكرارية مع عمر
دالة عكس<'أ>(نص_)
    متغير نتيجة = ""
    متغير ط = طول(نص_) - 1
    بينما (ط >= 0)
        نتيجة = نتيجة + نص_[ط]
        ط = ط - 1
    نهاية
    ارجع نتيجة
نهاية

تأكد(عكس("أبجد") == "دجبأ"، "دالة تكرارية مع عمر: عكس نص")

