# دالة بعمر تحتوي حلقة
دالة مجموع_مصفوفة<'أ>(مصف)
    متغير مج = 0
    لكل عنصر في مصف
        مج = مج + عنصر
    نهاية
    ارجع مج
نهاية

تأكد(مجموع_مصفوفة([1، 2، 3، 4، 5]) == 15، "دالة بعمر + حلقة لكل")

# دالة بعمر تحتوي حلقة بينما
دالة مضروب<'أ>(ن)
    متغير نتيجة = 1
    متغير ع = ن
    بينما (ع > 1)
        نتيجة = نتيجة * ع
        ع = ع - 1
    نهاية
    ارجع نتيجة
نهاية

تأكد(مضروب(5) == 120، "دالة بعمر + حلقة بينما: مضروب")
تأكد(مضروب(0) == 1، "دالة بعمر + حلقة بينما: مضروب صفر")

