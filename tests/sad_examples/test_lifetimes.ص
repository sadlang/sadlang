اطبع_سطر("═══ القسم 1: دالة مع معاملات عمر ═══")
# ==============================================================

# دالة بمعامل عمر واحد
دالة أطول<'أ>(س، ص)
    إذا (طول(س) > طول(ص))
        ارجع س
    وإلا
        ارجع ص
    نهاية
نهاية

متغير نتيجة1 = أطول("مرحبا"، "أهلاً وسهلاً")
تأكد(نتيجة1 == "أهلاً وسهلاً"، "دالة مع عمر <'أ>: أطول نص")

# دالة بعدة معاملات عمر
دالة دمج<'أ، 'ب>(س، ص)
    ارجع س + " و " + ص
نهاية

متغير نتيجة2 = دمج("أحمد"، "سارة")
تأكد(نتيجة2 == "أحمد و سارة"، "دالة مع أعمار <'أ، 'ب>: دمج نصوص")

# دالة بعمر ثابت
دالة ثابتة<'ثابت>()
    ارجع "أنا ثابتة"
نهاية

تأكد(ثابتة() == "أنا ثابتة"، "دالة مع عمر <'ثابت>")

# دالة بعمر مجهول
دالة مجهولة<'_>(س)
    ارجع س * 2
نهاية

تأكد(مجهولة(5) == 10، "دالة مع عمر <'_>: مجهول")

