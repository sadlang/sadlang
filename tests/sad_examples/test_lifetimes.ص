اطبع_سطر("")
اطبع_سطر("═══ القسم 8: صنف مع دوال بأعمار ═══")
# ==============================================================

صنف حاوية
    باني(قيم)
        هذا.قيم = قيم
    نهاية
نهاية

# دالة بعمر تتعامل مع كائنات
دالة حجم_حاوية<'أ>(ح)
    ارجع طول(ح.قيم)
نهاية

دالة أول_عنصر<'أ>(ح)
    إذا (طول(ح.قيم) > 0)
        ارجع ح.قيم[0]
    نهاية
    ارجع لاشيء
نهاية

دالة آخر_عنصر<'أ>(ح)
    متغير ط = طول(ح.قيم)
    إذا (ط > 0)
        ارجع ح.قيم[ط - 1]
    نهاية
    ارجع لاشيء
نهاية

متغير ح1 = جديد حاوية([10، 20، 30])
تأكد(حجم_حاوية(ح1) == 3، "دالة بعمر + كائن: حجم")
تأكد(أول_عنصر(ح1) == 10، "دالة بعمر + كائن: أول عنصر")
تأكد(آخر_عنصر(ح1) == 30، "دالة بعمر + كائن: آخر عنصر")

# امتداد مع دالة بعمر خارج الامتداد
امتداد حاوية
    دالة مجموع()
        متغير مج = 0
        لكل ق في هذا.قيم
            مج = مج + ق
        نهاية
        ارجع مج
    نهاية
نهاية

دالة مجموع_مضاعف<'أ>(ح)
    ارجع ح.مجموع() * 2
نهاية

تأكد(مجموع_مضاعف(ح1) == 120، "دالة بعمر + امتداد + كائن")

