# اختبار تكرار القنوات ودالة مستقبل()
# ═══════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

# ─── اختبار 1: تكرار عبر قناة ─── 
اطبع_سطر("=== اختبار 1: تكرار عبر قناة ===")

متغير ق = قناة(5)
ق.أرسل(10)
ق.أرسل(20)
ق.أرسل(30)
ق.أغلق()

متغير مجموع = 0
لكل عنصر في ق
    مجموع = مجموع + عنصر
نهاية

إذا (مجموع == 60)
    اطبع_سطر("  ✓ تكرار القناة: مجموع = " + مجموع)
    نجاح = نجاح + 1
وإلا
    اطبع_سطر("  ✗ تكرار القناة: توقعنا 60 حصلنا على " + مجموع)
    فشل = فشل + 1
نهاية

# ─── اختبار 2: تكرار قناة فارغة مغلقة ───
اطبع_سطر("=== اختبار 2: تكرار قناة فارغة مغلقة ===")

متغير ق2 = قناة(1)
ق2.أغلق()

متغير عداد = 0
لكل عنصر في ق2
    عداد = عداد + 1
نهاية

إذا (عداد == 0)
    اطبع_سطر("  ✓ قناة فارغة: لم يتم التكرار")
    نجاح = نجاح + 1
وإلا
    اطبع_سطر("  ✗ قناة فارغة: تم التكرار " + عداد + " مرات")
    فشل = فشل + 1
نهاية

# ─── اختبار 3: مستقبل بسيط ───
اطبع_سطر("=== اختبار 3: مستقبل بسيط ===")

متغير م = مستقبل()

أطلق
    م.عيّن(42)
نهاية

انتظر_الكل()
متغير نتيجة = م.احصل()

إذا (نتيجة == 42)
    اطبع_سطر("  ✓ مستقبل: النتيجة = " + نتيجة)
    نجاح = نجاح + 1
وإلا
    اطبع_سطر("  ✗ مستقبل: توقعنا 42 حصلنا على " + نتيجة)
    فشل = فشل + 1
نهاية

# ─── اختبار 4: جاهز (isReady) ───
اطبع_سطر("=== اختبار 4: فحص الجاهزية ===")

متغير م2 = مستقبل()
متغير قبل = م2.جاهز()
م2.عيّن(99)
متغير بعد = م2.جاهز()

إذا (قبل == خطأ و بعد == صحيح)
    اطبع_سطر("  ✓ جاهز: قبل=" + قبل + " بعد=" + بعد)
    نجاح = نجاح + 1
وإلا
    اطبع_سطر("  ✗ جاهز: قبل=" + قبل + " بعد=" + بعد)
    فشل = فشل + 1
نهاية

# ─── اختبار 5: تكرار قناة من goroutine ───
اطبع_سطر("=== اختبار 5: تكرار قناة يُملؤها goroutine ===")

متغير ق3 = قناة(10)

أطلق
    لكل ر في [100، 200، 300]
        ق3.أرسل(ر)
    نهاية
    ق3.أغلق()
نهاية

متغير مجموع3 = 0
لكل عنصر في ق3
    مجموع3 = مجموع3 + عنصر
نهاية

إذا (مجموع3 == 600)
    اطبع_سطر("  ✓ تكرار من goroutine: مجموع = " + مجموع3)
    نجاح = نجاح + 1
وإلا
    اطبع_سطر("  ✗ تكرار من goroutine: توقعنا 600 حصلنا على " + مجموع3)
    فشل = فشل + 1
نهاية

