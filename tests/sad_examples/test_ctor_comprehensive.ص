# اختبارات شاملة لإصلاح تعيين الحقول في الباني والطرائق
# يختبر:
# 1. باني بسيط مع حقول نصية ورقمية
# 2. عدة حقول من نفس النوع
# 3. طريقة تأخذ معامل بنفس اسم حقل
# 4. وراثة مع حقول مشتركة
# 5. حقول مُهيّأة من تعبيرات (ليس فقط معاملات)

# ═══════════════════════════════════════
# اختبار 1: باني بسيط مع حقول متعددة
# ═══════════════════════════════════════
صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة المسافة()
        ارجع هذا.س + هذا.ص
    نهاية
نهاية

متغير ن = جديد نقطة(10، 20)
اطبع_سطر("نقطة: " + ن.س + "، " + ن.ص)
اطبع_سطر("المسافة: " + ن.المسافة())

# ═══════════════════════════════════════
# اختبار 2: باني مع حقول نصية ورقمية مختلطة  
# ═══════════════════════════════════════
صنف طالب
    باني(الاسم، العمر، الدرجة)
        هذا.الاسم = الاسم
        هذا.العمر = العمر
        هذا.الدرجة = الدرجة
    نهاية

    دالة معلومات()
        ارجع هذا.الاسم + " عمره " + هذا.العمر + " ودرجته " + هذا.الدرجة
    نهاية
نهاية

متغير ط = جديد طالب("سعد"، 20، 95)
اطبع_سطر(ط.معلومات())
اطبع_سطر("الاسم: " + ط.الاسم)
اطبع_سطر("العمر: " + ط.العمر)
اطبع_سطر("الدرجة: " + ط.الدرجة)

# ═══════════════════════════════════════
# اختبار 3: طريقة تأخذ معامل بنفس اسم حقل
# ═══════════════════════════════════════
صنف عدّاد
    باني(القيمة)
        هذا.القيمة = القيمة
    نهاية

    دالة أضف(القيمة)
        هذا.القيمة = هذا.القيمة + القيمة
    نهاية

    دالة احصل()
        ارجع هذا.القيمة
    نهاية
نهاية

متغير ع = جديد عدّاد(10)
اطبع_سطر("قبل: " + ع.احصل())
ع.أضف(5)
اطبع_سطر("بعد إضافة 5: " + ع.احصل())
ع.أضف(3)
اطبع_سطر("بعد إضافة 3: " + ع.احصل())

# ═══════════════════════════════════════
# اختبار 4: وراثة مع حقول في الأب والابن
# ═══════════════════════════════════════
صنف كائن_حي
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية

    دالة عرّف()
        ارجع "كائن: " + هذا.الاسم
    نهاية
نهاية

صنف حيوان يرث كائن_حي
    باني(الاسم، النوع) : الأساس(الاسم)
        هذا.النوع = النوع
    نهاية

    دالة وصف()
        ارجع هذا.الاسم + " من نوع " + هذا.النوع
    نهاية
نهاية

متغير ح = جديد حيوان("قطة"، "ثدييات")
اطبع_سطر(ح.وصف())
اطبع_سطر("الاسم: " + ح.الاسم)
اطبع_سطر("النوع: " + ح.النوع)

# ═══════════════════════════════════════
# اختبار 5: باني مع قيم حرفية وتعبيرات
# ═══════════════════════════════════════
صنف مستطيل
    باني(العرض، الطول)
        هذا.العرض = العرض
        هذا.الطول = الطول
        هذا.المساحة = العرض * الطول
    نهاية

    دالة معلومات()
        ارجع "مستطيل " + هذا.العرض + "x" + هذا.الطول + " مساحة=" + هذا.المساحة
    نهاية
نهاية

متغير م = جديد مستطيل(5، 3)
اطبع_سطر(م.معلومات())

اطبع_سطر("=== جميع الاختبارات نجحت ===")
