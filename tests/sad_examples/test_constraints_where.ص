# اختبار where clause وأنواع مرتبطة

# === قالب بقيد واحد ===
قالب<نوع ت: قيد1> دالة مقيد(س)
    ارجع س
نهاية

اطبع("✅ قيد واحد: نجح")

# === قيود متعددة ===
قالب<نوع ت: قيد1 + قيد2 + قيد3> دالة ثلاثي(س)
    ارجع س
نهاية

اطبع("✅ ثلاثة قيود: نجح")

# === معاملان بقيود ===
قالب<نوع ت: قابل_للمقارنة، نوع م: قابل_للطباعة> دالة مزدوج(أ، ب)
    ارجع أ
نهاية

اطبع("✅ معاملان مقيدان: نجح")

# === where clause ===
قالب<نوع ت، نوع م> دالة دمج(أ، ب) حيث ت: قيد1 + قيد2، م: قيد3
    ارجع أ
نهاية

اطبع("✅ where clause: نجح")

# === where clause مع نوع مرتبط ===
قالب<نوع ت> دالة أول(مجموعة) حيث ت.عنصر: قابل_للمقارنة
    ارجع مجموعة
نهاية

اطبع("✅ where مع نوع مرتبط: نجح")

# === صنف قالب مع قيود ===
قالب<نوع ت: قيد1 + قيد2> صنف صندوق
    متغير محتوى = لاشيء

    باني(قيمة)
        هذا.محتوى = قيمة
    نهاية
نهاية

اطبع("✅ صنف قالب مع قيود: نجح")

