# اختبار: دالة تحقق مع عوامل أساسية
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية
    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير نجاح = 0

دالة تحقق(الوصف، القيمة، المتوقع)
    إذا (القيمة == المتوقع)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("فشل: " + الوصف)
    نهاية
نهاية

متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(3، 4)
متغير ج = أ + ب
تحقق("جمع", "" + ج, "(4، 6)")
اطبع_سطر("نجح: " + نجاح)
