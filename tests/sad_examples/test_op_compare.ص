# اختبار عوامل المقارنة في المترجم
صنف عداد
    باني(قيمة)
        هذا.قيمة = قيمة
    نهاية

    عامل ==(آخر)
        ارجع هذا.قيمة == آخر.قيمة
    نهاية

    عامل !=(آخر)
        ارجع هذا.قيمة != آخر.قيمة
    نهاية

    عامل <(آخر)
        ارجع هذا.قيمة < آخر.قيمة
    نهاية

    عامل >(آخر)
        ارجع هذا.قيمة > آخر.قيمة
    نهاية
نهاية

متغير أ = جديد عداد(10)
متغير ب = جديد عداد(20)
متغير ج = جديد عداد(10)

# مقارنة المساواة
إذا (أ == ج)
    اطبع_سطر("متساويان: صحيح")
وإلا
    اطبع_سطر("متساويان: خطأ")
نهاية

# مقارنة عدم المساواة
إذا (أ != ب)
    اطبع_سطر("مختلفان: صحيح")
وإلا
    اطبع_سطر("مختلفان: خطأ")
نهاية

# مقارنة أصغر
إذا (أ < ب)
    اطبع_سطر("أصغر: صحيح")
وإلا
    اطبع_سطر("أصغر: خطأ")
نهاية

# مقارنة أكبر
إذا (ب > أ)
    اطبع_سطر("أكبر: صحيح")
وإلا
    اطبع_سطر("أكبر: خطأ")
نهاية
