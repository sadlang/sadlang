# ملف يحتوي على صنف محكم — يُستورد من ملف آخر
# هذا الملف يعرّف صنف محكم لاختبار منع الوراثة من خارج الملف

صنف محكم قاعدة_محكمة
    متغير عام القيمة = 0

    باني(قيمة)
        هذا.القيمة = قيمة
    نهاية

    دالة عام وصف()
        ارجع "قاعدة: " + هذا.القيمة
    نهاية
نهاية

# صنف يرث في نفس الملف — مسموح
صنف فرع_محلي يرث قاعدة_محكمة
    باني(قيمة)
        الأساس(قيمة)
    نهاية
نهاية

صدّر قاعدة_محكمة
