# اختبار العوامل الحسابية الأساسية في المترجم
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل -(آخر)
        ارجع جديد متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    عامل *(آخر)
        ارجع جديد متجه(هذا.س * آخر.س، هذا.ص * آخر.ص)
    نهاية
نهاية

# اختبار الجمع
متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(3، 4)
متغير ج = أ + ب
اطبع_سطر(ج.س)
اطبع_سطر(ج.ص)

# اختبار الطرح
متغير د = ب - أ
اطبع_سطر(د.س)
اطبع_سطر(د.ص)

# اختبار الضرب
متغير هـ = أ * ب
اطبع_سطر(هـ.س)
اطبع_سطر(هـ.ص)

# اختبار مع قيم أخرى
صنف عداد
    باني(قيمة)
        هذا.قيمة = قيمة
    نهاية

    عامل +(آخر)
        ارجع جديد عداد(هذا.قيمة + آخر.قيمة)
    نهاية
نهاية

متغير ع1 = جديد عداد(10)
متغير ع2 = جديد عداد(20)
متغير ع3 = ع1 + ع2
اطبع_سطر(ع3.قيمة)
