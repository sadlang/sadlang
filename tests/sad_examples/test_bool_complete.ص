# اختبار شامل للقيم المنطقية
متغير أ = صحيح
متغير ب = خطأ

# طباعة مباشرة
اطبع_سطر(أ)
اطبع_سطر(ب)

# طباعة ثوابت
اطبع_سطر(صحيح)
اطبع_سطر(خطأ)

# جمع مع نص
اطبع_سطر("أ=" + أ)
اطبع_سطر("ب=" + ب)

# نتيجة مقارنة
متغير ج = 5 > 3
اطبع_سطر("5>3: " + ج)

متغير د = 2 > 7
اطبع_سطر("2>7: " + د)

# منطقي في شرط
إذا (أ)
    اطبع_سطر("أ صحيح")
نهاية

إذا (ب)
    اطبع_سطر("ب صحيح")
وإلا
    اطبع_سطر("ب خطأ")
نهاية
