# اختبار ADT متوسط للمترجم - مطابقات متعددة

تعداد شكل
    دائرة(نصف_القطر)
    مستطيل(عرض، ارتفاع)
    نقطة
نهاية

متغير ش1 = شكل.دائرة(42)
متغير ش2 = شكل.مستطيل(10، 20)
متغير ش3 = شكل.نقطة

طابق (ش1)
    عندما شكل.دائرة(نق):
        اطبع_سطر("1:دائرة=" + نق)
    افتراضي:
        اطبع_سطر("1:آخر")
نهاية

طابق (ش2)
    عندما شكل.مستطيل(ع، ا):
        اطبع_سطر("2:مستطيل=" + ع + "×" + ا)
    افتراضي:
        اطبع_سطر("2:آخر")
نهاية

طابق (ش3)
    عندما شكل.نقطة:
        اطبع_سطر("3:نقطة")
    افتراضي:
        اطبع_سطر("3:آخر")
نهاية

اطبع_سطر("تم")
