# اختبار: حذف عناصر من المصفوفة مع إزاحة صحيحة

متغير م = [10، 20، 30، 40، 50]
اطبع_سطر("قبل الحذف:")
اطبع_سطر(طول(م))
اطبع_سطر(م[0])
اطبع_سطر(م[1])
اطبع_سطر(م[2])
اطبع_سطر(م[3])
اطبع_سطر(م[4])

# === 1. حذف العنصر الأوسط (الفهرس 2 = القيمة 30) ===
احذف(م، 2)
اطبع_سطر("بعد حذف الفهرس 2:")
اطبع_سطر(طول(م))
اطبع_سطر(م[0])
اطبع_سطر(م[1])
اطبع_سطر(م[2])
اطبع_سطر(م[3])

# === 2. حذف أول عنصر (الفهرس 0) ===
احذف(م، 0)
اطبع_سطر("بعد حذف الفهرس 0:")
اطبع_سطر(طول(م))
اطبع_سطر(م[0])
اطبع_سطر(م[1])
اطبع_سطر(م[2])

# === 3. حذف آخر عنصر ===
احذف(م، 2)
اطبع_سطر("بعد حذف الأخير:")
اطبع_سطر(طول(م))
اطبع_سطر(م[0])
اطبع_سطر(م[1])

اطبع_سطر("===")
اطبع_سطر("نجاح")
