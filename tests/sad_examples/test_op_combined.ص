# اختبار مجتمع: == ثم نص+كائن ثم منطقي

صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل نص()
        ارجع "(" + هذا.س + "," + هذا.ص + ")"
    نهاية

    عامل منطقي()
        ارجع هذا.س != 0 أو هذا.ص != 0
    نهاية
نهاية

# اختبار 1: ==
متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(1، 2)
إذا (أ == ب)
    اطبع_سطر("متساويان")
نهاية

# اختبار 2: نص + كائن
متغير ن = "النتيجة: " + أ
اطبع_سطر(ن)

# اختبار 3: منطقي في شرط
إذا (أ)
    اطبع_سطر("غير صفري")
نهاية

# اختبار 4: صفر منطقي
متغير صفر = جديد متجه(0، 0)
إذا (صفر)
    اطبع_سطر("خطأ")
وإلا
    اطبع_سطر("صفري")
نهاية
