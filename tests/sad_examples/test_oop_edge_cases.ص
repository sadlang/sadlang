# ═══════════════════════════════════════
# اختبار 19: وراثة 4 مستويات
# ═══════════════════════════════════════
صنف كائن
    باني(نوع)
        هذا.نوع = نوع
    نهاية
نهاية

صنف حي يرث كائن
    باني(نوع، حالة) : الأساس(نوع)
        هذا.حالة = حالة
    نهاية
نهاية

صنف فقاري يرث حي
    باني(نوع، حالة، فقرات) : الأساس(نوع، حالة)
        هذا.فقرات = فقرات
    نهاية
نهاية

صنف ثديي يرث فقاري
    باني(الاسم، فقرات) : الأساس("ثديي"، "حي"، فقرات)
        هذا.الاسم = الاسم
    نهاية

    دالة وصف()
        ارجع هذا.الاسم + " (" + هذا.نوع + "، " + هذا.حالة + "، فقرات=" + هذا.فقرات + ")"
    نهاية
نهاية

متغير ثد = جديد ثديي("أسد"، 30)
اطبع_سطر("اختبار 19 — وراثة 4 مستويات:")
اطبع_سطر(ثد.وصف())

# ═══════════════════════════════════════
# اختبار 20: عوامل متعددة على نفس الصنف
# ═══════════════════════════════════════
صنف كسر
    باني(البسط، المقام)
        هذا.البسط = البسط
        هذا.المقام = المقام
    نهاية

    عامل +(آخر)
        # جمع الكسور: (أ/ب) + (ج/د) = (أد + بج) / (بد)
        متغير بسط_جديد = هذا.البسط * آخر.المقام + هذا.المقام * آخر.البسط
        متغير مقام_جديد = هذا.المقام * آخر.المقام
        ارجع جديد كسر(بسط_جديد، مقام_جديد)
    نهاية

    عامل *(آخر)
        ارجع جديد كسر(هذا.البسط * آخر.البسط، هذا.المقام * آخر.المقام)
    نهاية

    دالة نص()
        ارجع هذا.البسط + "/" + هذا.المقام
    نهاية
نهاية

متغير ك1 = جديد كسر(1، 2)
متغير ك2 = جديد كسر(1، 3)
متغير ك3 = ك1 + ك2
متغير ك4 = ك1 * ك2

اطبع_سطر("اختبار 20 — عوامل على كسور:")
اطبع_سطر("1/2 + 1/3 = " + ك3.نص())
اطبع_سطر("1/2 * 1/3 = " + ك4.نص())

# ═══════════════════════════════════════
# اختبار 21: كائن يعيد كائنا من طريقة
# ═══════════════════════════════════════
صنف نقطة2
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة انقل(دس، دص)
        ارجع جديد نقطة2(هذا.س + دس، هذا.ص + دص)
    نهاية

    دالة نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير ن1 = جديد نقطة2(0، 0)
متغير ن2 = ن1.انقل(5، 3)
متغير ن3 = ن2.انقل(2، 7)

اطبع_سطر("اختبار 21 — إرجاع كائن من طريقة:")
اطبع_سطر("ن1 = " + ن1.نص())
اطبع_سطر("ن2 = " + ن2.نص())
اطبع_سطر("ن3 = " + ن3.نص())

