# ═══════════════════════════════════════
# اختبار 16: حقول بقيم حرفية (ثابتة) في الباني
# ═══════════════════════════════════════
صنف إعدادات
    باني(الاسم)
        هذا.الاسم = الاسم
        هذا.النسخة = 1
        هذا.مفعّل = 0
    نهاية

    دالة معلومات()
        ارجع هذا.الاسم + " ن" + هذا.النسخة + " حالة=" + هذا.مفعّل
    نهاية
نهاية

متغير إع = جديد إعدادات("تطبيقي")
اطبع_سطر("اختبار 16 — حقول بقيم حرفية:")
اطبع_سطر(إع.معلومات())

# ═══════════════════════════════════════
# اختبار 17: طريقة تستدعي طريقة أخرى في نفس الصنف
# ═══════════════════════════════════════
صنف حاسبة
    باني(القيمة)
        هذا.القيمة = القيمة
    نهاية

    دالة ضاعف()
        هذا.القيمة = هذا.القيمة * 2
    نهاية

    دالة ضاعف_ثلاثا()
        هذا.ضاعف()
        هذا.القيمة = هذا.القيمة + هذا.القيمة / 2
    نهاية
نهاية

متغير ح = جديد حاسبة(10)
اطبع_سطر("اختبار 17 — طريقة تستدعي طريقة:")
اطبع_سطر("قبل: " + ح.القيمة)
ح.ضاعف()
اطبع_سطر("بعد ضاعف: " + ح.القيمة)

# ═══════════════════════════════════════
# اختبار 18: باني يأخذ عدة معاملات من نفس النوع
# ═══════════════════════════════════════
صنف لون
    باني(أحمر، أخضر، أزرق)
        هذا.أحمر = أحمر
        هذا.أخضر = أخضر
        هذا.أزرق = أزرق
    نهاية

    دالة نص()
        ارجع "rgb(" + هذا.أحمر + "، " + هذا.أخضر + "، " + هذا.أزرق + ")"
    نهاية
نهاية

متغير ل = جديد لون(255، 128، 0)
اطبع_سطر("اختبار 18 — عدة معاملات من نفس النوع:")
اطبع_سطر(ل.نص())
اطبع_سطر("الأحمر: " + ل.أحمر)
اطبع_سطر("الأخضر: " + ل.أخضر)
