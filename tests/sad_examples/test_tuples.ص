# =====================================================
# اختبار الصفوف (Tuples) في لغة ص
# =====================================================

متغير نجاح = 0
متغير فشل = 0

دالة تحقق(الاسم، القيمة، المتوقع)
    إذا (القيمة == المتوقع)
        نجاح = نجاح + 1
        اطبع_سطر("✅ " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("❌ " + الاسم + " — توقعنا: " + المتوقع + " حصلنا: " + القيمة)
    نهاية
نهاية

