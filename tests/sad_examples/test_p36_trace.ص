# تبسيط: صنفين + تحقق + إذا tobool
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية
    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

صنف كائن_قاعدة
    باني(اسم)
        هذا.اسم = اسم
    نهاية
    عامل نص()
        ارجع "كائن: " + هذا.اسم
    نهاية
    عامل منطقي()
        ارجع هذا.اسم != ""
    نهاية
نهاية

صنف موظف يرث كائن_قاعدة
    باني(اسم، راتب)
        الأساس(اسم)
        هذا.راتب = راتب
    نهاية
نهاية

متغير نجاح = 0
دالة تحقق(القيمة، المتوقع)
    اطبع_سطر("T1")
    إذا (القيمة == المتوقع)
        نجاح = نجاح + 1
    نهاية
    اطبع_سطر("T2")
نهاية

متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(3، 4)
متغير ج = أ + ب
اطبع_سطر("A")
تحقق("" + ج، "(4، 6)")
اطبع_سطر("B")

متغير موظ = جديد موظف("أحمد"، 5000)
اطبع_سطر("C")
تحقق("" + موظ، "كائن: أحمد")
اطبع_سطر("D")

إذا (موظ)
    اطبع_سطر("E")
    تحقق(صحيح، صحيح)
    اطبع_سطر("F")
نهاية
اطبع_سطر("G")
اطبع_سطر("نجح: " + نجاح)
