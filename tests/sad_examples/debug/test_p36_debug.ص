# اختبار: تحقق مع صنفين مستخدمين
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية
    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

صنف كائن_قاعدة
    باني(اسم)
        هذا.اسم = اسم
    نهاية
    عامل نص()
        ارجع "كائن: " + هذا.اسم
    نهاية
    عامل منطقي()
        ارجع هذا.اسم != ""
    نهاية
نهاية

صنف موظف يرث كائن_قاعدة
    باني(اسم، راتب)
        الأساس(اسم)
        هذا.راتب = راتب
    نهاية
نهاية

متغير نجاح = 0
دالة تحقق(الوصف، القيمة، المتوقع)
    إذا (القيمة == المتوقع)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("فشل: " + الوصف)
    نهاية
نهاية

