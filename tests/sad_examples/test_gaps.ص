# اختبار فجوات المترجم (نسخة محدّثة — تستخدم أرقام للمقارنة)

متغير _نجاح = 0
متغير _فشل = 0
متغير _رقم = 0

دالة تحقق(الاسم، الفعلي، المتوقع)
    _رقم = _رقم + 1
    إذا (الفعلي == المتوقع)
        _نجاح = _نجاح + 1
        اطبع_سطر("[نجاح] " + _رقم + ". " + الاسم)
    وإلا
        _فشل = _فشل + 1
        اطبع_سطر("[فشل]  " + _رقم + ". " + الاسم + " | متوقع=" + المتوقع + " فعلي=" + الفعلي)
    نهاية
نهاية

# === 1. العامل الثلاثي (أرقام) ===
اطبع_سطر("=== 1. العامل الثلاثي ===")
متغير ث1 = 5 > 3 ? 42 : 0
تحقق("ثلاثي بسيط", ث1, 42)

متغير ث2 = 2 > 8 ? 100 : 7
تحقق("ثلاثي منفي", ث2, 7)

# === 2. /= و %= ===
اطبع_سطر("=== 2. /= و %= ===")
متغير أ = 24
أ /= 4
تحقق("/=", أ, 6)

متغير ب = 10
ب %= 3
تحقق("%=", ب, 1)

# === 3. عامل القوة ** ===
اطبع_سطر("=== 3. عامل القوة ===")
تحقق("2**3", 2 ** 3, 8)
تحقق("3**2", 3 ** 2, 9)

# === 4. طول() ===
اطبع_سطر("=== 4. طول() ===")
متغير نص_ط = "hello"
تحقق("طول نص", طول(نص_ط), 5)

متغير مصف_ط = [10، 20، 30]
تحقق("طول مصفوفة", طول(مصف_ط), 3)

# === 5. لاشيء ===
اطبع_سطر("=== 5. لاشيء ===")
متغير فارغ = لاشيء
تحقق("لاشيء == لاشيء", فارغ == لاشيء, صحيح)

# === 6. القيم الافتراضية ===
اطبع_سطر("=== 6. القيم الافتراضية ===")
دالة جمع_مع_افتراضي(أ، ب = 10)
    ارجع أ + ب
نهاية

تحقق("معامل افتراضي", جمع_مع_افتراضي(5), 15)
تحقق("تجاوز افتراضي", جمع_مع_افتراضي(5، 20), 25)

# === الملخص ===
اطبع_سطر("")
اطبع_سطر("الملخص: " + _نجاح + "/" + (_نجاح + _فشل) + " نجاح")
إذا (_فشل == 0)
    اطبع_سطر("جميع الاختبارات نجحت!")
وإلا
    اطبع_سطر(_فشل + " اختبار فشل")
نهاية
