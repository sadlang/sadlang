# ═══════════════════════════════════════════════════════════════
# اختبار شامل: مقارنة الكائنات مع لاشيء
# يختبر جميع حالات المقارنة بين الكائنات (بما فيها القنوات) و لاشيء
# ═══════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

دالة تحقق(اسم، شرط)
    إذا (شرط)
        اطبع_سطر("✓ " + اسم)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("✗ " + اسم)
        فشل = فشل + 1
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════
# اختبار 1: قناة != لاشيء
# ═══════════════════════════════════════════════════════════════
متغير ق = قناة(5)
تحقق("قناة != لاشيء"، ق != لاشيء)

# ═══════════════════════════════════════════════════════════════
# اختبار 2: قناة == لاشيء
# ═══════════════════════════════════════════════════════════════
تحقق("قناة == لاشيء → خطأ"، (ق == لاشيء) == خطأ)

# ═══════════════════════════════════════════════════════════════
# اختبار 3: لاشيء == قناة
# ═══════════════════════════════════════════════════════════════
تحقق("لاشيء == قناة → خطأ"، (لاشيء == ق) == خطأ)

# ═══════════════════════════════════════════════════════════════
# اختبار 4: لاشيء != قناة
# ═══════════════════════════════════════════════════════════════
تحقق("لاشيء != قناة → صحيح"، لاشيء != ق)

# ═══════════════════════════════════════════════════════════════
# اختبار 5: قناة == قناة (نفس الكائن)
# ═══════════════════════════════════════════════════════════════
متغير ق2 = ق
تحقق("قناة == نفس_القناة"، ق == ق2)

# ═══════════════════════════════════════════════════════════════
# اختبار 6: قناة != قناة_أخرى (كائنان مختلفان)
# ═══════════════════════════════════════════════════════════════
متغير ق3 = قناة(10)
تحقق("قناة != قناة_أخرى"، ق != ق3)

# ═══════════════════════════════════════════════════════════════
# اختبار 7: كائن عادي != لاشيء
# ═══════════════════════════════════════════════════════════════
صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

متغير ن = جديد نقطة(3، 7)
تحقق("كائن != لاشيء"، ن != لاشيء)

# ═══════════════════════════════════════════════════════════════
# اختبار 8: كائن == لاشيء → خطأ
# ═══════════════════════════════════════════════════════════════
تحقق("كائن == لاشيء → خطأ"، (ن == لاشيء) == خطأ)

# ═══════════════════════════════════════════════════════════════
# اختبار 9: لاشيء == لاشيء → صحيح
# ═══════════════════════════════════════════════════════════════
تحقق("لاشيء == لاشيء"، لاشيء == لاشيء)

# ═══════════════════════════════════════════════════════════════
# اختبار 10: كائنان نفسهما
# ═══════════════════════════════════════════════════════════════
متغير ن2 = ن
تحقق("كائن == نفس_الكائن"، ن == ن2)

# ═══════════════════════════════════════════════════════════════
# اختبار 11: كائنان مختلفان
# ═══════════════════════════════════════════════════════════════
متغير ن3 = جديد نقطة(3، 7)
تحقق("كائن != كائن_مختلف"، ن != ن3)

# ═══════════════════════════════════════════════════════════════
# اختبار 12: قناة في شرط if مباشر
# ═══════════════════════════════════════════════════════════════
متغير نتيجة12 = خطأ
إذا (ق != لاشيء)
    نتيجة12 = صحيح
نهاية
تحقق("قناة في شرط if"، نتيجة12)

# ═══════════════════════════════════════════════════════════════
# اختبار 13: إرسال واستقبال عبر قناة بعد المقارنة
# ═══════════════════════════════════════════════════════════════
إذا (ق != لاشيء)
    ق.أرسل(42)
    متغير قيمة = ق.استقبل()
    تحقق("إرسال/استقبال بعد مقارنة"، قيمة == 42)
نهاية

# ═══════════════════════════════════════════════════════════════
# اختبار 14: متغير لاشيء مقارنة مع قناة
# ═══════════════════════════════════════════════════════════════
متغير فارغ = لاشيء
تحقق("متغير_فارغ != قناة"، فارغ != ق)
تحقق("متغير_فارغ == لاشيء"، فارغ == لاشيء)

# ═══════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("═══════════════════════════════════════")
اطبع_سطر("النتيجة: " + نجاح + "/" + (نجاح + فشل) + " اختبار نجح")
إذا (فشل == 0)
    اطبع_سطر("✓ جميع الاختبارات نجحت!")
وإلا
    اطبع_سطر("✗ " + فشل + " اختبار فشل")
نهاية
