# اختبار شامل لتحميل العوامل الزائد

صنف متجه
    متغير س = 0
    متغير ص = 0

    باني(س_ق، ص_ق)
        هذا.س = س_ق
        هذا.ص = ص_ق
    نهاية

    عامل عام +(آخر) متجه
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل عام -(آخر) متجه
        ارجع جديد متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    عامل عام *(آخر) متجه
        ارجع جديد متجه(هذا.س * آخر.س، هذا.ص * آخر.ص)
    نهاية

    عامل عام ==(آخر) منطقي
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل عام !=(آخر) منطقي
        ارجع هذا.س != آخر.س أو هذا.ص != آخر.ص
    نهاية

    عامل عام <(آخر) منطقي
        ارجع (هذا.س * هذا.س + هذا.ص * هذا.ص) < (آخر.س * آخر.س + آخر.ص * آخر.ص)
    نهاية

    # عامل أحادي: سالب (بدون معاملات)
    عامل عام -() متجه
        ارجع جديد متجه(-س، -ص)
    نهاية

    # عامل الفهرسة []
    عامل عام [](فهرس)
        إذا (فهرس == 0)
            ارجع هذا.س
        وإلا
            ارجع هذا.ص
        نهاية
    نهاية

    دالة عام طباعة()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

# ====== اختبار العوامل الثنائية ======
متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(3، 4)

متغير ج = أ + ب
اطبع_سطر("أ + ب = " + ج.طباعة())

متغير د = ب - أ
اطبع_سطر("ب - أ = " + د.طباعة())

متغير هـ = أ * ب
اطبع_سطر("أ * ب = " + هـ.طباعة())

اطبع_سطر("أ == أ: " + (أ == أ))
اطبع_سطر("أ != ب: " + (أ != ب))
اطبع_سطر("أ < ب: " + (أ < ب))

# ====== اختبار += (عبر desugaring) ======
متغير ز = جديد متجه(10، 20)
ز += جديد متجه(5، 5)
اطبع_سطر("نتيجة +=: " + ز.طباعة())

# ====== اختبار العامل الأحادي ======
متغير سالب = -أ
اطبع_سطر("سالب أ = " + سالب.طباعة())

# ====== اختبار عامل الفهرسة [] ======
اطبع_سطر("أ[0] = " + أ[0])
اطبع_سطر("أ[1] = " + أ[1])
اطبع_سطر("ب[0] = " + ب[0])

اطبع_سطر("✅ جميع الاختبارات نجحت!")