# اختبار الوسائط المسماة في المفسر
دالة تعريف(الاسم، العمر، المدينة)
    ارجع الاسم + "، " + العمر + " سنة، من " + المدينة
نهاية

# استدعاء بوسائط مسماة
متغير نتيجة = تعريف(الاسم: "أحمد"، العمر: 30، المدينة: "جدة")
اطبع_سطر("نتيجة 1: " + نتيجة)

# مزج مكاني ومسمى
متغير نتيجة2 = تعريف("سارة"، العمر: 28، المدينة: "الرياض")
