# اختبار: مصفوفتي - كل شيء عدا عامل نص مع مصفوفة
صنف مصفوفتي
    باني()
        هذا.بيانات = [10، 20، 30، 40، 50]
    نهاية

    عامل [](فهرس)
        ارجع هذا.بيانات[فهرس]
    نهاية

    عامل []=(فهرس، قيمة)
        هذا.بيانات[فهرس] = قيمة
    نهاية
نهاية

صنف مضاعف
    باني(عامل_الضرب)
        هذا.عامل_الضرب = عامل_الضرب
    نهاية

    عامل ()(قيمة)
        ارجع قيمة * هذا.عامل_الضرب
    نهاية
نهاية

# وراثة
