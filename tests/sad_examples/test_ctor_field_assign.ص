# اختبار إصلاح تعيين الحقول في الباني
# عند كتابة هذا.الاسم = الاسم يجب أن يقرأ من المعامل وليس الحقل

صنف شخص
    باني(الاسم، العمر)
        هذا.الاسم = الاسم
        هذا.العمر = العمر
    نهاية

    دالة عرّف()
        ارجع "اسمي " + هذا.الاسم + " وعمري " + هذا.العمر
    نهاية
نهاية

متغير ش = جديد شخص("أحمد"، 25)
اطبع_سطر(ش.عرّف())
اطبع_سطر("الاسم: " + ش.الاسم)
اطبع_سطر("العمر: " + ش.العمر)
