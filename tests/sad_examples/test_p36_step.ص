# اختبار: أضيف استخدام الوراثة تدريجياً
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية
    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

صنف كائن_قاعدة
    باني(اسم)
        هذا.اسم = اسم
    نهاية
    عامل نص()
        ارجع "كائن: " + هذا.اسم
    نهاية
    عامل منطقي()
        ارجع هذا.اسم != ""
    نهاية
نهاية

صنف موظف يرث كائن_قاعدة
    باني(اسم، راتب)
        الأساس(اسم)
        هذا.راتب = راتب
    نهاية
نهاية

