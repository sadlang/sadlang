# اختبار: == ثم نص+كائن (بدون منطقي)

صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل نص()
        ارجع "(" + هذا.س + "," + هذا.ص + ")"
    نهاية
نهاية

متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(1، 2)
إذا (أ == ب)
    اطبع_سطر("متساويان")
نهاية

متغير ن = "النتيجة: " + أ
اطبع_سطر(ن)
