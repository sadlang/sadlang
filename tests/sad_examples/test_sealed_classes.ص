# ═══════════════════════════════════════════════════════════════════
# اختبار شامل: الأصناف المحكمة (Sealed Classes)
# ═══════════════════════════════════════════════════════════════════
# الصنف المحكم لا يسمح بالوراثة إلا من نفس الملف المصدري
# Sealed classes only allow inheritance from the same source file
# ═══════════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

# ─── اختبار 1: تعريف صنف محكم بسيط ───
صنف محكم شكل
    متغير عام اللون = "أحمر"

    باني(لون)
        هذا.اللون = لون
    نهاية

    دالة عام وصف()
        ارجع "شكل بلون " + هذا.اللون
    نهاية
نهاية

متغير ش = جديد شكل("أزرق")
إذا (ش.وصف() == "شكل بلون أزرق")
    نجاح = نجاح + 1
    اطبع_سطر("✓ 1: تعريف صنف محكم بسيط")
وإلا
    فشل = فشل + 1
    اطبع_سطر("✗ 1: تعريف صنف محكم بسيط — الناتج: " + ش.وصف())
نهاية

# ─── اختبار 2: وراثة من صنف محكم في نفس الملف (مسموح) ───
صنف دائرة يرث شكل
    متغير عام نصف_القطر = 0

    باني(لون، نق)
        الأساس(لون)
        هذا.نصف_القطر = نق
    نهاية

    دالة عام وصف()
        ارجع "دائرة بنصف قطر " + هذا.نصف_القطر + " ولون " + هذا.اللون
    نهاية
نهاية

متغير د = جديد دائرة("أخضر"، 5)
إذا (د.نصف_القطر == 5 و د.اللون == "أخضر")
    نجاح = نجاح + 1
    اطبع_سطر("✓ 2: وراثة من صنف محكم في نفس الملف")
وإلا
    فشل = فشل + 1
    اطبع_سطر("✗ 2: وراثة من صنف محكم في نفس الملف")
نهاية

