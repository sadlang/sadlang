# ─── اختبار 10: صنف محكم مع حقول خاصة ───
صنف محكم حساب
    متغير خاص الرصيد = 0

    باني(رصيد)
        هذا.الرصيد = رصيد
    نهاية

    دالة عام إيداع(مبلغ)
        هذا.الرصيد = هذا.الرصيد + مبلغ
    نهاية

    دالة عام الرصيد_الحالي()
        ارجع هذا.الرصيد
    نهاية
نهاية

صنف حساب_توفير يرث حساب
    متغير عام نسبة_فائدة = 0

    باني(رصيد، فائدة)
        الأساس(رصيد)
        هذا.نسبة_فائدة = فائدة
    نهاية

    دالة عام احسب_فائدة()
        ارجع هذا.الرصيد_الحالي() * هذا.نسبة_فائدة / 100
    نهاية
نهاية

متغير ح = جديد حساب_توفير(1000، 5)
ح.إيداع(500)
إذا (ح.الرصيد_الحالي() == 1500 و ح.احسب_فائدة() == 75)
    نجاح = نجاح + 1
    اطبع_سطر("✓ 10: صنف محكم مع حقول خاصة ووراثة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("✗ 10: حقول خاصة — الرصيد: " + ح.الرصيد_الحالي() + " الفائدة: " + ح.احسب_فائدة())
نهاية

