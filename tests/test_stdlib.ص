# اختبار دوال النصوص والمصفوفات

# 1. دوال النصوص
متغير جملة = "مرحبا بالعالم العربي"
اطبع_سطر("1. طول النص: " + طول(جملة))

# 2. المصفوفات
متغير قائمة = [10, 20, 30, 40, 50]
اطبع_سطر("2. طول المصفوفة: " + طول(قائمة))

# 3. إضافة عنصر
أضف(قائمة، 60)
اطبع_سطر("3. بعد الإضافة: " + قائمة)

# 4. قص نص
متغير جزء = قص(جملة، 0، 5)
اطبع_سطر("4. قص: " + جزء)

# 5. تحويل الأنواع
متغير نص_رقمي = "42"
متغير ناتج = عدد(نص_رقمي)
اطبع_سطر("5. تحويل نص لرقم: " + (ناتج + 8))

# 6. نوع القيمة
اطبع_سطر("6. نوع 42: " + نوع_القيمة(42))
اطبع_سطر("6. نوع نص: " + نوع_القيمة("مرحبا"))
اطبع_سطر("6. نوع قائمة: " + نوع_القيمة(قائمة))

# 7. التحقق من الفراغ
اطبع_سطر("7. فارغ؟: " + طول([]) + " " + طول(""))
