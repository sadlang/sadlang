# اختبار الدوال العليا مع لامدا
# Test higher-order functions with lambda

# اختبار 1: تخطيط مع دالة عادية
دالة مضاعفة(ن)
   ارجع ن * 2
نهاية
متغير نتيجة1 = تخطيط([1، 2، 3]، "مضاعفة")
اطبع_سطر("1. تخطيط: " + نتيجة1)

# اختبار 2: تخطيط مع لامدا
متغير ل = لامدا ن: ن * 3
متغير نتيجة2 = تخطيط([1، 2، 3]، ل)
اطبع_سطر("2. تخطيط لامدا: " + نتيجة2)

# اختبار 3: تصفية مع دالة عادية
دالة أكبر_من_2(ن)
   ارجع ن > 2
نهاية
متغير نتيجة3 = تصفية([1، 2، 3، 4، 5]، "أكبر_من_2")
اطبع_سطر("3. تصفية: " + نتيجة3)

# اختبار 4: تصفية مع لامدا
متغير ل2 = لامدا ن: ن > 3
متغير نتيجة4 = تصفية([1، 2، 3، 4، 5]، ل2)
اطبع_سطر("4. تصفية لامدا: " + نتيجة4)

# اختبار 5: اختزال
دالة جمع(أ، ب)
   ارجع أ + ب
نهاية
متغير نتيجة5 = اختزال([1، 2، 3، 4]، "جمع"، 0)
اطبع_سطر("5. اختزال: " + نتيجة5)

# اختبار 6: تخطيط مع دالة سهمية
متغير سهمية = ن => ن * 10
متغير نتيجة6 = تخطيط([1، 2، 3]، سهمية)
اطبع_سطر("6. تخطيط سهمية: " + نتيجة6)

# اختبار 7: حفظ دالة عادية في متغير واستخدامها
متغير د = مضاعفة
متغير نتيجة7 = تخطيط([5، 10]، د)
اطبع_سطر("7. تخطيط دالة محفوظة: " + نتيجة7)
