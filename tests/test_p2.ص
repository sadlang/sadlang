# اختبار المشكلة 2: متغير x = x + 1 في بينما لا يُحدَّث
# ملاحظة: المشكلة هي عند كتابة "متغير عداد = عداد + 1" بدلاً من "عداد = عداد + 1"

دالة عد_العناصر()
    متغير عداد = 0
    بينما (عداد < 5)
        اطبع(عداد)
        عداد = عداد + 1
    نهاية
    ارجع عداد
نهاية

متغير نتيجة = عد_العناصر()
اطبع_سطر("")
اطبع_سطر("المشكلة 2: نتيجة=" + نتيجة)
