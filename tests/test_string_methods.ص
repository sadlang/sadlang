# اختبار toLower و toUpper على النصوص

# اختبار 1: تحويل للأصغر
متغير نص1 = "HELLO WORLD"
اطبع("اختبار 1:")
اطبع(نص1.تحويل_صغير())

# اختبار 2: تحويل للأكبر
متغير نص2 = "hello world"
اطبع("اختبار 2:")
اطبع(نص2.تحويل_كبير())

# اختبار 3: بحث في نص
متغير نص3 = "مرحبا بالعالم"
اطبع("اختبار 3 - بحث:")
اطبع(نص3.بحث("بال"))

# اختبار 4: بحث عن نص غير موجود
اطبع("اختبار 4 - بحث غير موجود:")
اطبع(نص3.بحث("xyz"))

# اختبار 5: سلسلة دوال
متغير نص5 = "Hello"
اطبع("اختبار 5 - toLower:")
اطبع(نص5.toLower())
