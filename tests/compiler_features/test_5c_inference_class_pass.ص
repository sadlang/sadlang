نفّذ قابل_للوصف لـ نقطة
   دالة وصف()
      ارجع "(" + هذا.س + "،" + هذا.ص + ")"
   نهاية
نهاية

قالب<نوع T: قابل_للوصف> دالة اطبع_وصف(T كائن)
   ارجع كائن
نهاية

دالة رئيسية()
   متغير ن1 = نقطة(3، 4) جديد
   متغير ن2 = اطبع_وصف(ن1)
