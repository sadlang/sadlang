# اختبار Phase 5e: تطابق نوع الإرجاع في السمات (أصناف مُعرَّفة من المستخدم)
# يجب أن ينجح: السمة تتوقع إرجاع نقطة، التنفيذ يُرجع نقطة

صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

سمة قابل_للاسترداد
    دالة نقطة احصل_النقطة()
نهاية

صنف خازن
    متغير عام قيمة
    باني(ق)
        هذا.قيمة = ق
    نهاية
نهاية

# تنفيذ صحيح: دالة تُرجع نقطة كما تتوقعها السمة
نفذ قابل_للاسترداد لـ خازن
    دالة نقطة احصل_النقطة()
        ارجع نقطة(هذا.قيمة، 0) جديد
    نهاية
نهاية

دالة رئيسية()
    متغير خ = خازن(42) جديد
    اطبع_سطر("تم")
