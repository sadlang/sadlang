# (AR) قالب بمعاملَين — تنفيذ صريح بدون استدلال
# (EN) Two-param template — explicit instantiation without inference

قالب<نوع مفتاح: قابل_للتجزئة، نوع قيمة: قابل_للعرض>
دالة معالج(مفتاح م، قيمة ق)
    اطبع_سطر(ق)
    ارجع م
نهاية

دالة رئيسية()
    # (AR) تنفيذ صريح: مفتاح=نص ← يحقق قابل_للتجزئة
    #                   قيمة=رقم  ← يحقق قابل_للعرض
    # (EN) Explicit: مفتاح=نص satisfies قابل_للتجزئة
    #               قيمة=رقم  satisfies قابل_للعرض
    متغير ن = معالج<نص، رقم>("أحمد"، 42)
    اطبع_سطر(ن)
    ارجع 0
نهاية
