# ============================================================================
# اختبار المرحلة 6 — تعدّي السمات الفائقة (حالة النجاح)
# Phase 6 Test — Super-trait transitivity (pass case)
#
# (AR) تسلسل سمات: قابل_للترتيب ترث من قابل_للمقارنة.
#      نقطة تُنفِّذ قابل_للترتيب فقط — لكن يجب أن تعتبر محقِّقة لـ قابل_للمقارنة
#      أيضاً (بالتعدّي) لأن كل من يُنفِّذ الابنة ينفّذ الأم ضمناً.
#      القالب يطلب قابل_للمقارنة فقط — يجب أن يقبل نقطة (EXIT=0).
#
# (EN) Trait hierarchy: قابل_للترتيب inherits from قابل_للمقارنة.
#      نقطة implements only قابل_للترتيب — but must be considered as satisfying
#      قابل_للمقارنة too (by transitivity), since implementing the child implies
#      implementing the parent.
#      Template requires only قابل_للمقارنة — must accept نقطة (EXIT=0).
# ============================================================================

# (AR) تعريف هرم السمات
# (EN) Define trait hierarchy

سمة قابل_للمقارنة
    دالة مقارنة(آخر)
نهاية

سمة قابل_للترتيب يرث قابل_للمقارنة
    دالة أصغر_من(آخر)
    دالة أكبر_من(آخر)
نهاية

# (AR) صنف نقطة يُنفِّذ قابل_للترتيب فقط
# (EN) نقطة implements only قابل_للترتيب

صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

نفّذ قابل_للترتيب لـ نقطة
    دالة مقارنة(آخر)
        ارجع 0
    نهاية
    دالة أصغر_من(آخر)
        ارجع هذا.س < آخر.س
    نهاية
    دالة أكبر_من(آخر)
        ارجع هذا.س > آخر.س
    نهاية
نهاية

# (AR) قالب يطلب قابل_للمقارنة فقط — يجب أن يقبل نقطة بالتعدّي
# (EN) Template requiring only قابل_للمقارنة — must accept نقطة by transitivity

قالب<نوع T: قابل_للمقارنة>
دالة طابق_العناصر(T أ، T ب)
    ارجع أ.مقارنة(ب)
نهاية

دالة رئيسية()
    متغير ن1 = نقطة(1، 2) جديد
    متغير ن2 = نقطة(3، 4) جديد
    # نقطة تحقق قابل_للمقارنة بالتعدّي (تُنفِّذ قابل_للترتيب)
    متغير نتيجة = طابق_العناصر<نقطة>(ن1، ن2)
    اطبع_سطر("النتيجة: " + نتيجة)
    ارجع 0
نهاية
