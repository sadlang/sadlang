# اختبار المرحلة 7 — صنف قالب بمعاملَي نوع (حالة الانتهاك)
# Phase 7 Test — Template class with two type parameters (fail case)
#
# (AR) صنف قالب بمعاملَين: مفتاح (يتطلب قابل_للتجزئة) و قيمة (بدون قيد).
#      نُنشئه صراحةً بـ <بيانات، رقم> — بيانات لا تُنفِّذ قابل_للتجزئة.
#      يجب أن يفشل الفحص (EXIT=1).
#
# (EN) Template class with two type params: مفتاح (requires قابل_للتجزئة)
#      and قيمة (unconstrained).
#      Explicitly instantiated as <بيانات, رقم> — بيانات does NOT implement
#      قابل_للتجزئة → type check must fail (EXIT=1).
# ============================================================================

# (AR) صنف لا يُنفِّذ أي سمة
# (EN) Class that implements no traits

صنف بيانات
    متغير عام قيمة
    باني(قيمة)
        هذا.قيمة = قيمة
    نهاية
نهاية

# (AR) صنف قالب بمعاملَين مستقلَّين
# (EN) Template class with two independent type parameters

قالب<نوع مفتاح: قابل_للتجزئة، نوع قيمة>
صنف زوج
    متغير عام مف
    متغير عام قم
    باني(مف، قم)
        هذا.مف = مف
        هذا.قم = قم
    نهاية
نهاية

دالة رئيسية()
    # (AR) تنفيذ صريح: مفتاح=بيانات — لا تحقق قابل_للتجزئة → خطأ
    # (EN) Explicit instantiation: مفتاح=بيانات does NOT satisfy قابل_للتجزئة → ERROR
    متغير ز = زوج<بيانات، رقم>(بيانات(1) جديد، 10) جديد
    اطبع_سطر(ز.قم)
    ارجع 0
نهاية
