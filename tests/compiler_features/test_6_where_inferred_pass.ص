#
# (AR) القالب يُعرِّف جملة حيث تتطلب القيدين: قابل_للمقارنة + قابل_للتجزئة.
#      نستدعيه بوسائط أرقام — يُستدلّ T=رقم — ورقم يحقق كلا القيدين.
#      يجب أن ينجح الفحص (EXIT=0).
#
# (EN) Template defines a WHERE clause requiring two constraints:
#      قابل_للمقارنة + قابل_للتجزئة.
#      We call it with integer args — T is inferred as رقم — which satisfies both.
#      Type check must succeed (EXIT=0).
# ============================================================================

قالب<نوع T>
دالة أكبر_عنصر(T أ، T ب)
    حيث T: قابل_للمقارنة + قابل_للتجزئة
    إذا (أ > ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

دالة رئيسية()
    # استدعاء بدون <...> — يُستدلّ T=رقم
    متغير ن = أكبر_عنصر(10، 20)
