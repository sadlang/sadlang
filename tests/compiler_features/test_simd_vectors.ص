دالة رئيسية()
    # بناء متجهين عشريين بـ 4 lanes
    متغير أ = متجه(1.0، 2.0، 3.0، 4.0)
    متغير ب = متجه(5.0، 6.0، 7.0، 8.0)

    # جمع متجهين → <4 x double> add
    متغير ج = متجه_جمع(أ، ب)

    # ضرب-جمع مُدمج (FMA): a*b+c → llvm.fma.v4f64
    متغير د = متجه_ضرب_جمع(أ، ب، ج)

    # جذر تربيعي → llvm.sqrt.v4f64
    متغير هـ = متجه_جذر(أ)

    # حد أقصى → llvm.maxnum.v4f64
    متغير و = متجه_أكبر(أ، ب)

    # جمع عرضي (horizontal sum) → llvm.vector.reduce.fadd.v4f64
    متغير مجموع = متجه_جمع_عرضي(ج)

    # جداء قياسي (dot product) → fmul ثم vector.reduce
    متغير جداء = متجه_جداء_قياسي(أ، ب)

    # بث قيمة سُلَّمية إلى 8 lanes
    متغير ز = متجه_بث(3.14، 8)
    متغير زمج = متجه_جمع_عرضي(ز)

    # استخراج عنصر واحد
    متغير أول = متجه_عنصر(أ، 0)

    اطبع_سطر("اختبار SIMD مكتمل")
    ارجع 0
