# اختبارات متقدمة للقوالب ذات الثوابت

# 1) تعبيرات متعددة العوامل
قالب<ثابت رقم N> دالة مكعب()
    ارجع N * N * N
نهاية

# 2) مزج نوع + ثابت
قالب<نوع T، ثابت رقم N> دالة كرر_قيمة()
    متغير مجموع = 0
    متغير ع = 0
    بينما (ع < N)
        مجموع = مجموع + ع
        ع = ع + 1
    نهاية
    ارجع مجموع
نهاية

# 3) ثوابت متعددة
قالب<ثابت رقم A، ثابت رقم B> دالة مجموع_ثابت()
    ارجع A + B
نهاية

اطبع_سطر(مكعب<4>())            # 64
اطبع_سطر(مكعب<7>())            # 343
اطبع_سطر(كرر_قيمة<رقم، 5>())   # 0+1+2+3+4 = 10
اطبع_سطر(كرر_قيمة<رقم، 10>())  # 45
اطبع_سطر(مجموع_ثابت<100، 23>()) # 123
اطبع_سطر(مجموع_ثابت<1، 2>())    # 3
