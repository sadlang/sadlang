# @rule: gr.pattern.primary
# @gap: ISSUE-081
# @description: كاشف — حمولة تعدادٍ مربوطة في نمط الذراع «عندما شكل.دائرة(ق)» يقرؤها الحارس «إذا ق > 0». المفسّر يطبع 7 (الحمولة متاحة للحارس)، بينما المترجم يؤجّل استخراج «ق» لكتلة الجسم (statement_match) فيبقى غير مربوطٍ عند تقييم الحارس ⇒ خطأ ترجمة «Undefined variable 'ق'». إصلاح ISSUE-075 عالج حرّاس أنماط القوائم المتداخلة فقط، لا حمولة التعداد المفردة في الحارس
# @requires: اطبع_سطر، نص
# @expected: 7
تعداد شكل
    دائرة(نق)
    مربع
نهاية
متغير ش = شكل.دائرة(7)
طابق ش
    عندما شكل.دائرة(ق) إذا ق > 0
        اطبع_سطر(نص(ق))
    عندما شكل.مربع
        اطبع_سطر("مربع")
نهاية
