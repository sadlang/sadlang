# @rule: gr.stmt.while
# @gap: ISSUE-063
# @priority: P1
# @description: كاشف — قسمة ذاتيّة صحيحة بحلقة مع عدّاد تراكم: يجب ألّا تُفقَد دورات ولا يعلّق (64→1 في 6 دورات)
# @requires: اطبع_سطر
# @expected: 1\n6
متغير س = 64
متغير مجموع = 0
بينما (س > 1)
    س = س / 2
    مجموع = مجموع + 1
نهاية
اطبع_سطر(س)
اطبع_سطر(مجموع)
