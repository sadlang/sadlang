# @rule: gr.expr.binary
# @gap: ISSUE-INT64-PRECISION
# @description: كان المفسّر يحسب العمليّات الحسابيّة الصحيحة بدقّة int32 (toInt) بينما المترجم i64 — فكان «9007199254740993 / 1» يطبع 1 بالمفسّر. هذا اختبار مزدوج يثبّت الدقّة الكاملة 64-بت في: الجمع/الطرح/الضرب/القسمة الأرضيّة/الباقي/السالب الأحاديّ/المقارنات، عند 2^40 و2^53±1 وحدود int64 والسوالب الكبيرة وضربٍ يفيض int32 دون i64
# @requires: اطبع_سطر، نص
# @expected: 1099511627777\n9007199254740993\n9007199254740991\n10000000000\n9223372036854775807\n-9223372036854775807\n-9007199254740993\n2199023255552\n-2199023255552\n-191690600\nخطأ\nصحيح\nصحيح
# (AR) 2^40 + 1 — كان يُقتطع إلى 1 بالمفسّر
اطبع_سطر(نص(1099511627776 + 1))
# (AR) 2^53 + 1 عبر الجمع — عبور حدّ دقّة double
اطبع_سطر(نص(9007199254740992 + 1))
# (AR) 2^53 - 1 عبر الطرح
اطبع_سطر(نص(9007199254740992 - 1))
# (AR) ضرب يفيض int32 دون أن يفيض i64
اطبع_سطر(نص(100000 * 100000))
# (AR) INT64_MAX حرفيًّا
اطبع_سطر(نص(9223372036854775807))
# (AR) INT64_MIN + 1 (سالب كبير)
اطبع_سطر(نص(-9223372036854775807))
# (AR) سالب أحاديّ على قيمة فوق 2^53
اطبع_سطر(نص(-(9007199254740993)))
# (AR) قسمة أرضيّة لقيمة كبيرة: 2^53 // 2^12 = 2^41
اطبع_سطر(نص(9007199254740992 // 4096))
# (AR) قسمة أرضيّة بسالب كبير قابل للقسمة (بلا باقٍ — نتيجة صحيحة متطابقة)
اطبع_سطر(نص((0 - 9007199254740992) // 4096))
# (AR) باقي القسمة بسالب كبير — دلالة C المقتطعة (إشارة المقسوم)
اطبع_سطر(نص((0 - 9007199254740993) % 1000000007))
# (AR) مقارنات دقيقة فوق 2^53 — كانت تمرّ عبر double فتتساوى زورًا
اطبع_سطر(نص(9007199254740993 == 9007199254740992))
اطبع_سطر(نص(9007199254740993 > 9007199254740992))
اطبع_سطر(نص(9007199254740993 != 9007199254740992))
