# اختبار انحدار #30 — اكتب_بايتات/اقرأ_بايتات ذهاب-إياب ببايت صفريّ مضمَّن
# Regression Test #30 — write_bytes/read_bytes round-trip with embedded NUL
# الأولوية: P1
# يُثبت: (١) كتابة بايتات خام تشمل 0x00 دون قطع (بخلاف اكتب_ملف النصّيّة)؛
#        (٢) قراءتها لا-موقَّعةً 0..255؛ (٣) تكافؤ المفسّر والمترجم بايتًا ببايت.
#        هذا أوّلُ حاجزٍ أمام كاتب ELF السياديّ (رأس ELF يحوي بايتاتٍ صفريّة).

استورد أساسيات

متغير مسار = "tmp_p30_bytes.bin"
# (AR) البايت الثالث صفريّ (يقطع النصّ)، والأخير > 127 (يمتحن اللا-إشارة)
متغير بايتات = [127، 0، 255، 66]

اكتب_بايتات(مسار، بايتات)

متغير مقروء = اقرأ_بايتات(مسار)

إذا (طول(مقروء) == 4)
    اطبع("PASS: الطول 4 — البايت الصفريّ لم يقطع الكتابة/القراءة")
وإلا
    اطبع("FAIL: طول غير متوقع بعد الذهاب-إياب")
نهاية

إذا (مقروء[1] == 0)
    اطبع("PASS: البايت الصفريّ المضمَّن حُفظ")
وإلا
    اطبع("FAIL: البايت الصفريّ ضاع")
نهاية

إذا (مقروء[2] == 255)
    اطبع("PASS: البايت العالي 255 قُرئ لا-موقَّعًا")
وإلا
    اطبع("FAIL: البايت العالي قُرئ خطأً")
نهاية

احذف_ملف(مسار)

اطبع("=== انتهى اختبار #30 ===")
