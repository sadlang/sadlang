# اختبار المشكلة #11: أصناف مخصصة كأنواع حقول
# Bug #11: Custom classes cannot be used as field types

صنف نقطة
    باني(س، ع)
        هذا.س = س
        هذا.ع = ع
    نهاية

    دالة اطبع_معلومات()
        اطبع("(" + هذا.س + ", " + هذا.ع + ")")
    نهاية
نهاية

# محاولة 1: صنف يحتوي على صنف مخصص كحقل
صنف مستطيل
    باني(نقطة1، نقطة2)
        هذا.بداية = نقطة1
        هذا.آخر = نقطة2
    نهاية

    دالة اطبع_معلومات()
        اطبع("بداية: ")
        هذا.بداية.اطبع_معلومات()
        اطبع("نهاية: ")
        هذا.آخر.اطبع_معلومات()
    نهاية
نهاية

متغير ن1 = جديد نقطة(0، 0)
متغير ن2 = جديد نقطة(10، 20)
متغير م = جديد مستطيل(ن1، ن2)
م.اطبع_معلومات()

# محاولة 2: الوصول لحقل كائن داخل كائن
اطبع("بداية.س = " + م.بداية.س)
اطبع("آخر.ع = " + م.آخر.ع)

اطبع("=== اختبار #11 اكتمل ===")
