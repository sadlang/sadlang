# @description نوعُ إرجاع الدالّة المُنادَاة لا يتسرّب إلى المُستدعي (تحذيرٌ كاذب)
# @priority P1
# @expected صحيح
# @expected ok
# @expected 7
#
# الانحدارُ المحروس: كان `setCurrentSadReturnType` يُضبَط بنوع الدالّة المُنادَاة بلا
# استعادةِ نوع المُستدعي عند الخروج، فأيُّ `ارجع` يلي نداءَ دالّةٍ ذاتِ نوعٍ مختلف
# يُبلَّغ عنه بـ«تتوقّع إرجاع X لكن حصلت على Y» — تحذيرٌ كاذب، ونصُّه مضلِّلٌ مرّتين:
# الاسمُ اسمُ المُستدعي والنوعُ نوعُ المُنادَى. المخرَجُ الصحيح **بلا أيّ تحذير**.

دالة نص باعث_نص(نص المدخل)
    ارجع المدخل
نهاية

دالة رقم باعث_رقم(نص المدخل)
    إذا (المدخل == "")
        ارجع 0 - 1
    نهاية
    ارجع 7
نهاية

# النداءُ في شرط `إذا`: كان يُلوّث فحصَ `ارجع` داخل الكتلة.
دالة منطقي فاحص(نص المدخل)
    إذا (باعث_رقم(المدخل) > 0)
        ارجع صحيح
    نهاية
    ارجع خطأ
نهاية

دالة رئيسية()
    اطبع_سطر(نص(فاحص("س")))
    # النداءُ بعد نداءٍ سابقٍ مختلفِ النوع: يتحقّق من الاستعادة لا من الضبط وحده.
    اطبع_سطر(باعث_نص("ok"))
    اطبع_سطر(نص(باعث_رقم("س")))
نهاية
