# @description ثوابتُ المستوى الأعلى مع «رئيسية» صريحة تُهيَّأ فعلًا في المصرّف
# @priority P0
# @expected نص: أبج
# @expected عبر دالة: أبج
# @expected عدد: 7
# @expected كسر: 2.5
# @expected راية: صحيح
# @expected سالب: -32700
# @expected محسوب: 5
# @expected عنصر: ب
# @expected طول: 2
#
# الانحدارُ المحروس: حين توجد «رئيسية» صريحة، كانت جملُ المستوى الأعلى تُجمَع ثمّ
# **تُهمَل** — لأنّ غلافَ `__sad_main` لا يُنشَأ إلّا عند غيابها. فالثابتُ لا يُهيَّأ
# أبدًا، والنصُّ يُطبَع «void».
#
# أخطرُ الأنواع: لا انهيارَ ولا تحذير — مخرَجٌ خاطئٌ صامت. والمفسّرُ سليمٌ فيه ⇒ كان
# انحرافَ تكافؤ، وهذا الملفُّ يُشغَّل على المحرّكين معًا فيقيسه.
#
# كُشف عند نقلِ حزمة «بروتوكول» في نبراس إلى لغة ص.

ثابت النص = "أبج"
ثابت العدد = 7
ثابت الكسر = 2.5
ثابت الراية = صحيح
# مُهيّئاتٌ غيرُ حرفيّة: السالبُ والمحسوب كانا يُعطيان صفرًا حتّى بعد أن صحّ النصّ —
# لأنّ الثابتَ الحرفيَّ وحده يُخبَز في العامّ، وغيرُه يحتاج تخزينًا في دالّة التهيئة.
ثابت سالب = -32700
ثابت محسوب = 2 + 3
# مصفوفةٌ على مستوى الوحدة: كانت تنهار بـsegfault لا «void» — قراءتُها من دالّةٍ أخرى
# تتحقّق من أنّ العامّ مؤشّرٌ سليمٌ لا خانةٌ صفريّة.
ثابت المصفوفة = ["أ"، "ب"]

دالة نص عنصر_المصفوفة()
    ارجع المصفوفة[1]
نهاية

# القراءةُ من داخل دالّةٍ أخرى تتحقّق من أنّ الرمز **عامٌّ** لا محلّيٌّ في غلافٍ يُهمَل.
دالة نص عبر_دالة()
    ارجع النص
نهاية

دالة رئيسية()
    اطبع_سطر("نص: " + النص)
    اطبع_سطر("عبر دالة: " + عبر_دالة())
    اطبع_سطر("عدد: " + نص(العدد))
    اطبع_سطر("كسر: " + نص(الكسر))
    اطبع_سطر("راية: " + نص(الراية))
    اطبع_سطر("سالب: " + نص(سالب))
    اطبع_سطر("محسوب: " + نص(محسوب))
    اطبع_سطر("عنصر: " + عنصر_المصفوفة())
    اطبع_سطر("طول: " + نص(طول(المصفوفة)))
نهاية
