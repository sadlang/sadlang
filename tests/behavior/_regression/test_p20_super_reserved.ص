# اختبار الانحدار #20 — أساس كلمة محجوزة (KEYWORD_SUPER)
# Regression Test #20 — أساس is reserved as KEYWORD_SUPER
# المشكلة: لا يمكن استخدام أساس كاسم معامل
# الأولوية: P1

# === اختبار 1: بديل لأساس ===
دالة حوّل_إلى_عدد(نص_عدد، قاعدة_عدّ)
    ارجع قاعدة_عدّ
نهاية

متغير ق = حوّل_إلى_عدد("110", 2)
إذا (ق == 2)
    اطبع("PASS: بديل 'قاعدة_عدّ' يعمل")
وإلا
    اطبع("FAIL: بديل فشل")
نهاية

# === اختبار 2: وراثة مع الأساس (الاستخدام الصحيح) ===
صنف كائن_حي
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية
نهاية

صنف حيوان يرث كائن_حي
    باني(الاسم، الصنف)
        الأساس(الاسم)
        هذا.الصنف = الصنف
    نهاية
نهاية

متغير ح = حيوان("قط", "ثدييات") جديد
إذا (ح.الاسم == "قط")
    اطبع("PASS: الوراثة تعمل")
وإلا
    اطبع("FAIL: الوراثة فشلت")
نهاية

إذا (ح.الصنف == "ثدييات")
    اطبع("PASS: حقل الابن يعمل")
وإلا
    اطبع("FAIL: حقل الابن فشل")
نهاية

