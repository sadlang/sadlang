# @description شرطُ «إذا» على قيمةٍ من نوعِ «أي» — المفسّرُ يحكم بصِدقيّةِ الوسمِ والمترجمُ ينهار بتأكيدِ LLVM.
# @expected FT:كاذب\nMISS:كاذب
# @priority P1

# ============================================================
# (AR) 🔑 بذرةٌ حمراءُ معلنة (FAIL_COMPILE) — قِيست ٢٠٢٦-٠٨-٢١:
#      `إذا (س)` حيث س خانةُ «أي» (سجلُّها %SadDyn = {i8 وسم, i64 حمولة})
#      يبلغ emitCondBranch شرطًا **بنيةً لا عددًا**، فيفشل
#      `cast<Ty>() argument of incompatible type` في LLVM (Casting.h:578).
#      والمسارُ نفسُه يقتل أيَّ شرطٍ قيمتُه ديناميّةٌ: نتيجةُ خريطة_احصل
#      عند الغيابِ (فراغ) وعند الحضورِ (نصّ) كلتاهما تُسقِطان المترجم.
#
#      الصوابُ المثبَّتُ هنا (يقيسه المفسّرُ اليومَ) — والفرعان بلفظٍ
#      واحدٍ موحَّد (صادق/كاذب) فلا يلتبس اتجاهُ الدخول:
#      FT: خانةُ «أي» العاريةُ فراغٌ — كاذبةٌ — فتدخل «وإلا».
#      MISS: غيابُ الجلبِ فراغٌ — كاذبٌ — فيدخل «وإلا».
#
#      وسدُّه في المترجمِ يلزمه إنزالُ صدقيّةِ %SadDyn قبل BR_COND
#      (توزيعٌ على الوسم: عدم/فراغ ⇒ خطأ، عدد/منطقي ⇒ حمولة≠0، ...) —
#      لا رقعةَ cast في emitCondBranch وحدَه، فالطبقةُ الخاطئةُ رقعةٌ ميتة.
# ============================================================

استورد خرائط

متغير أي س
إذا (س)
    اطبع_سطر("FT:صادق")
وإلا
    اطبع_سطر("FT:كاذب")
نهاية

متغير سجل = خريطة()
متغير غائب = خريطة_احصل(سجل، "لا_وجود_له")
إذا (غائب)
    اطبع_سطر("MISS:صادق")
وإلا
    اطبع_سطر("MISS:كاذب")
نهاية
