# تشخيص دقيق — استدعاء method على حقل كائن

صنف نقطة
    باني(س، ع)
        هذا.س = س
        هذا.ع = ع
    نهاية

    دالة وصف()
        ارجع "(" + هذا.س + ", " + هذا.ع + ")"
    نهاية
نهاية

صنف صندوق
    باني(أ، ب)
        هذا.أول = أ
        هذا.ثاني = ب
    نهاية
نهاية

متغير ن1 = نقطة(1، 2) جديد
متغير ن2 = نقطة(3، 4) جديد
متغير ص = صندوق(ن1، ن2) جديد

# خطوة 1: الوصول للحقول (يعمل)
اطبع("أول: " + ص.أول)
اطبع("ثاني: " + ص.ثاني)

# خطوة 2: استدعاء method على الحقل الأول
متغير وصف1 = ص.أول.وصف()
اطبع("وصف الأول: " + وصف1)

# خطوة 3: هل الحقول لا تزال موجودة بعد method call؟
اطبع("أول بعد method: " + ص.أول)
اطبع("ثاني بعد method: " + ص.ثاني)

# خطوة 4: استدعاء method على الحقل الثاني
متغير وصف2 = ص.ثاني.وصف()
اطبع("وصف الثاني: " + وصف2)

اطبع("=== نجح ===")
