# @description فراغٌ يعبرُ خانةَ معاملٍ «رقم» ثمّ يُستعمَلُ حسابيًّا ⇒ RUN053 وخروجٌ ١ (عقدُ المفسّر).
# @requires: اطبع_سطر, خرائط
# @priority P1
# @expect_error العملية 'حسابية / arithmetic' تتطلّب قيمة رقمية
# @expect_error_compiled العملية 'حسابية / arithmetic' تتطلّب قيمة رقمية

# ============================================================
# (AR) 🔴 حمراءُ معلنةٌ على المترجَمِ — صفُّها في DECLARED_REDS.tsv،
#      وسُكنى `_regression/` عمدًا: السجلُّ لا يقبل إلّا مجلّدَيه
#      المحروسَين، وبذرةٌ حمراءُ في `sections/` تُحمِّرُ مستوى CI.
#      قياسُ ٢٠٢٦-٠٨-٢٢:
#
#      المفسّرُ: تحذيرُ SEM045 عندَ العبورِ (rc-محايد بعقدِ ns07)، ثمّ
#      **يبقى الفراغُ في الخانةِ** فيرفعُ `س * 2` خطأَ RUN053 المسجَّلَ
#      في التقريرِ ⇒ خروجٌ ١ (مع طباعةِ 0 قيمةَ تراجُعِ العمليّةِ الفاشلة).
#
#      المترجَمُ: يحذّرُ SEM045 عندَ موقعِ النداءِ ثمّ **يفكُّ الفراغَ
#      صفرًا** عندَ حدِّ المعاملِ المصنَّف (معاملُ «رقم» نوعُه i64 لا
#      %SadDyn فلا وسمَ بعدَ الفكّ) ⇒ `س * 2` حسابٌ ساكنٌ لا يمرُّ ببابِ
#      RUN053 الموسوم ⇒ يطبعُ 0 ويخرجُ **0** — قناعُ الصفرِ بعينِه الذي
#      وُجدت الحملةُ لقتلِه، محصورًا هنا خلفَ حدِّ المعامل.
#
# (AR) ⚠️ السدُّ الجذريُّ **تمثيلٌ حاملٌ للوسمِ عبرَ حدِّ المعاملِ المصنَّف**
#      (موجةُ ABI مستقلّةٌ مُعلنةٌ في RFC عقدِ الغياب) — لا رقعةَ موقعِ نداءٍ:
#      موقعُ النداءِ لا يعلمُ أيُستعمَلُ الفراغُ حسابيًّا (⇒ RUN053 وخروج ١)
#      أم عرضًا فقط (⇒ «لاشيء» وخروج ٠ — قِيس في المفسّرِ بالمجسّ المقابل)،
#      فأيُّ حسمٍ عندَه يكذبُ في أحدِ الاتّجاهَين.
#      عندَ اخضرارِ هذه البذرةِ: احذف صفَّها من DECLARED_REDS.tsv.
# ============================================================

استورد خرائط

دالة رقم ضاعف(رقم س)
    ارجع س * 2
نهاية

متغير خ = خريطة()
خ["أ"] = 1
متغير غ = خ["غائب"]
اطبع_سطر(ضاعف(غ))
