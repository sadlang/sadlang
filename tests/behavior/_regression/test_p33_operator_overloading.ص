# عامل الاستدعاء ()
صنف مُضاعِف
    متغير عامل_ضرب = 0
    باني(ع)
        هذا.عامل_ضرب = ع
    نهاية
    عامل عام ()(قيمة)
        ارجع هذا.عامل_ضرب * قيمة
    نهاية
نهاية

