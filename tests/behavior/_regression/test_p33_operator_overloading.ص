# اختبار شامل لتحميل العوامل الزائد — P33

صنف متجه
    متغير س = 0
    متغير ص = 0

    باني(س_ق، ص_ق)
        هذا.س = س_ق
        هذا.ص = ص_ق
    نهاية

    عامل عام +(آخر) متجه
        ارجع متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل عام -(آخر) متجه
        ارجع متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    عامل عام *(آخر) متجه
        ارجع متجه(هذا.س * آخر.س، هذا.ص * آخر.ص)
    نهاية

    عامل عام ==(آخر) منطقي
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل عام !=(آخر) منطقي
        ارجع هذا.س != آخر.س أو هذا.ص != آخر.ص
    نهاية

    عامل عام <(آخر) منطقي
        ارجع (هذا.س * هذا.س + هذا.ص * هذا.ص) < (آخر.س * آخر.س + آخر.ص * آخر.ص)
    نهاية

    # عامل أحادي: سالب
    عامل عام -() متجه
        ارجع متجه(-س، -ص)
    نهاية

    # عامل الفهرسة []
    عامل عام [](فهرس)
        إذا (فهرس == 0)
            ارجع هذا.س
        وإلا
            ارجع هذا.ص
        نهاية
    نهاية
نهاية

متغير أ = متجه(1، 2)
متغير ب = متجه(3، 4)

# عوامل ثنائية
متغير ج = أ + ب
إذا (ج.س != 4 أو ج.ص != 6)
    ارمي "فشل: عامل الجمع"
نهاية

متغير د = ب - أ
إذا (د.س != 2 أو د.ص != 2)
    ارمي "فشل: عامل الطرح"
نهاية

متغير هـ = أ * ب
إذا (هـ.س != 3 أو هـ.ص != 8)
    ارمي "فشل: عامل الضرب"
نهاية

إذا (ليس (أ == أ))
    ارمي "فشل: عامل المساواة"
نهاية

إذا (ليس (أ != ب))
    ارمي "فشل: عامل عدم المساواة"
نهاية

إذا (ليس (أ < ب))
    ارمي "فشل: عامل أصغر من"
نهاية

# عامل += عبر desugaring
متغير ز = متجه(10، 20)
ز += متجه(5، 5)
إذا (ز.س != 15 أو ز.ص != 25)
    ارمي "فشل: عامل +="
نهاية

# عامل أحادي سالب
متغير سالب = -أ
إذا (سالب.س != -1 أو سالب.ص != -2)
    ارمي "فشل: العامل الأحادي -"
نهاية

# عامل الفهرسة []
إذا (أ[0] != 1)
    ارمي "فشل: عامل [] فهرس 0"
نهاية
إذا (أ[1] != 2)
    ارمي "فشل: عامل [] فهرس 1"
نهاية
إذا (ب[0] != 3)
    ارمي "فشل: عامل [] فهرس 0 لمتجه آخر"
نهاية

# عامل الأُس **
صنف عدد_مركب
    متغير ق = 0
    باني(ق_ق)
        هذا.ق = ق_ق
    نهاية
    عامل عام **(أس)
        متغير نتيجة = 1
        متغير ت = 0
        بينما (ت < أس)
            نتيجة = نتيجة * هذا.ق
            ت += 1
        نهاية
        ارجع عدد_مركب(نتيجة)
    نهاية
نهاية

متغير ع = عدد_مركب(3)
متغير ع2 = ع ** 4
إذا (ع2.ق != 81)
    ارمي "فشل: عامل الأُس ** (3^4 يجب أن يكون 81)"
نهاية

# عامل الإسناد بالفهرس []=
صنف حاوية
    متغير بيانات = []
    باني(ب)
        هذا.بيانات = ب
    نهاية
    عامل عام [](فهرس)
        ارجع هذا.بيانات[فهرس]
    نهاية
    عامل عام []=(فهرس، قيمة)
        هذا.بيانات[فهرس] = قيمة
    نهاية
نهاية

متغير ح = حاوية([10، 20، 30])
إذا (ح[0] != 10)
