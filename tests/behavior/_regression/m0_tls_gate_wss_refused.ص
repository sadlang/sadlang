# @description بوابة M0 / S1: اتّصال wss بلا TLS يُرفَض قبل أيّ مصافحة
# @priority P0
# @expected اتّصل: خطأ
# @expected السبب يذكر TLS: نعم
# @skip_compiler
# @timeout 20

# نظيرُ m0_tls_gate_https_refused لشقّ WebSocket من الإصلاح نفسه — كان غيرَ مغطّى.
# الانحدارُ المحروس: كان «wss://» يُنشئ مقبساً خاماً ويُجري مصافحةَ الترقية نصّاً
# صريحاً على المنفذ 443 — بما فيها ترويسات الاستيثاق والكوكيّات.
# 203.0.113.1 من مدى التوثيق (RFC 5737) ولا يُوجَّه إطلاقاً، فلو تجاوز الكودُ
# الحاجزَ لظهر فشلُ اتّصالٍ أو مهلة برسالةٍ لا تذكر TLS ⇒ يفشل الاختبار.

استورد ويبسوكت
استورد نصوص

استورد شبكة

متغير عميل = أنشئ_عميل_ويبسوكت()
متغير نجح = اتصل_بويبسوكت(عميل، "wss://203.0.113.1/بث")

اطبع_سطر(f"اتّصل: {نجح}")

متغير سبب = خطأ_ويبسوكت(عميل)
إذا (يحتوي_على(سبب، "SAD_TLS_NOT_AVAILABLE"))
    اطبع_سطر("السبب يذكر TLS: نعم")
وإلا
    اطبع_سطر(f"السبب يذكر TLS: لا — {سبب}")
نهاية

أزل_عميل_ويبسوكت(عميل)
