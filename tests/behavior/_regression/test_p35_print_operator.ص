# اختبار: اطبع(كائن) يستدعي عامل نص() تلقائياً

صنف شخص
    باني(الاسم، العمر)
        هذا.الاسم = الاسم
        هذا.العمر = العمر
    نهاية

    عامل نص()
        ارجع "شخص(" + هذا.الاسم + "، " + هذا.العمر + ")"
    نهاية
نهاية

صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

# بدون عامل نص — يستخدم التمثيل الافتراضي
صنف فارغ
    باني()
        هذا.قيمة = 42
    نهاية
نهاية

# اختبار 1: اطبع مع عامل نص()
متغير ش = شخص("أحمد"، 25)
اطبع_سطر(ش)

# اختبار 2: اطبع نقطة
متغير ن = نقطة(3، 7)
اطبع_سطر(ن)

# اختبار 3: دمج نص مع كائن
اطبع_سطر("الموقع: " + ن)

# اختبار 4: كائن بدون عامل نص
متغير ف = فارغ()
اطبع_سطر(ف)

# اختبار 5: عامل نص عبر الوراثة
صنف موظف يرث شخص
    باني(الاسم، العمر، الراتب)
        الأساس(الاسم، العمر)
        هذا.الراتب = الراتب
    نهاية
نهاية

متغير م = موظف("سارة"، 30، 5000)
اطبع_سطر(م)

