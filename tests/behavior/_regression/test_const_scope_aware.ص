# اختبار شامل: const يعمل بشكل صحيح مع نطاقات scope-aware
# هذا الاختبار يتأكد من أن:
# 1. ثابت يمنع التعديل في نفس النطاق
# 2. ثابت في دالة لا يؤثر على نطاق خارجي
# 3. ثابت عالمي يُحمى في النطاق العام
# 4. shadowing متغير مع ثابت يعمل

# === 1: const prevents reassignment in same scope ===
ثابت ثابت_عام = 42
اطبع("ثابت_عام: " + ثابت_عام)

# === 2: const inside function doesn't leak ===
دالة دالة_مع_ثابت()
    ثابت محلي = 100
    اطبع("داخل الدالة: " + محلي)
نهاية
دالة_مع_ثابت()

# بعد الدالة — يمكن تعريف متغير بنفس الاسم
متغير محلي = 200
محلي = 300
اطبع("خارج الدالة (متغير): " + محلي)

# === 3: two functions with same const name ===
دالة عَد_أ()
    ثابت الحد = 5
    اطبع("عد_أ: " + الحد)
نهاية

دالة عَد_ب()
    ثابت الحد = 10
    اطبع("عد_ب: " + الحد)
نهاية

عَد_أ()
عَد_ب()

# === 4: const in while loop ===
متغير ع = 0
بينما (ع < 3)
    ثابت ثابت_حلقة = ع * 100
    اطبع("حلقة " + ع + ": " + ثابت_حلقة)
    ع = ع + 1
نهاية

# === 5: shadowing — var in function shadows global const ===
ثابت عالمي = 999
دالة ظل()
    متغير عالمي = 1
    عالمي = 2
    اطبع("ظل: " + عالمي)
نهاية
ظل()
اطبع("أصل: " + عالمي)

# === 6: nested scopes ===
دالة متداخلة()
    ثابت خ = 50
    إذا (خ > 10)
        متغير ن = خ + 1
        اطبع("متداخلة: " + ن)
    نهاية
نهاية
متداخلة()

اطبع("=== جميع اختبارات const scope-aware نجحت ===")
