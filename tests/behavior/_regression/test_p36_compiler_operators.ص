# ============================================================================
# اختبار شامل لتحميل العوامل — مقارنة المفسر والمترجم
# ============================================================================
# هذا الملف يختبر كل أنواع العوامل الـ 21 المدعومة في لغة ص:
# - 7 عوامل حسابية ثنائية: +, -, *, /, //, %, **
# - 6 عوامل مقارنة: ==, !=, <, <=, >, >=
# - 3 عوامل خاصة: [], []=, ()
# - 3 عوامل أحادية: u-, u+, !
# - 3 عوامل تحويل: نص, منطقي, رقم
# ============================================================================

# ======================================
# صنف المتجه — يختبر العوامل الحسابية والمقارنة
# ======================================
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    # --- العوامل الحسابية الثنائية ---
    عامل +(آخر)
        ارجع متجه(هذا.س + آخر.س، هذا.ص + آخر.ص) جديد
    نهاية

    عامل -(آخر)
        ارجع متجه(هذا.س - آخر.س، هذا.ص - آخر.ص) جديد
    نهاية

    عامل *(آخر)
        ارجع متجه(هذا.س * آخر.س، هذا.ص * آخر.ص) جديد
    نهاية

    # --- عوامل المقارنة ---
    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل !=(آخر)
        ارجع هذا.س != آخر.س أو هذا.ص != آخر.ص
    نهاية

    عامل <(آخر)
        ارجع (هذا.س * هذا.س + هذا.ص * هذا.ص) < (آخر.س * آخر.س + آخر.ص * آخر.ص)
    نهاية

    # --- العوامل الأحادية ---
    عامل -()
        ارجع متجه(-هذا.س، -هذا.ص) جديد
    نهاية

    # --- عامل التحويل نص ---
    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية

    # --- عامل التحويل منطقي ---
    عامل منطقي()
        ارجع هذا.س != 0 أو هذا.ص != 0
    نهاية
نهاية

# ======================================
# صنف المصفوفة — يختبر عوامل الفهرسة والاستدعاء
# ======================================
صنف مصفوفتي
    باني()
        هذا.بيانات = [10، 20، 30، 40، 50]
    نهاية

    عامل [](فهرس)
        ارجع هذا.بيانات[فهرس]
    نهاية

    عامل []=(فهرس، قيمة)
        هذا.بيانات[فهرس] = قيمة
    نهاية

    عامل نص()
        ارجع "مصفوفتي:" + هذا.بيانات
    نهاية
نهاية

# ======================================
# صنف الدالة — يختبر عامل الاستدعاء
# ======================================
صنف مضاعف
    باني(عامل_الضرب)
        هذا.عامل_الضرب = عامل_الضرب
    نهاية

    عامل ()(قيمة)
        ارجع قيمة * هذا.عامل_الضرب
    نهاية
نهاية

# ======================================
# صنف الموظف — يختبر الوراثة مع العوامل
# ======================================
صنف كائن_قاعدة
    باني(اسم)
        هذا.اسم = اسم
    نهاية

    عامل نص()
        ارجع "كائن: " + هذا.اسم
    نهاية

    عامل منطقي()
        ارجع هذا.اسم != ""
    نهاية
نهاية

صنف موظف يرث كائن_قاعدة
    باني(اسم، راتب)
        الأساس(اسم)
        هذا.راتب = راتب
    نهاية
    # عامل نص() و منطقي() موروثان من كائن_قاعدة
نهاية

# ============================================================================
# الاختبارات
# ============================================================================
متغير نجاح = 0
متغير فشل = 0

دالة تحقق(الوصف، القيمة، المتوقع)
    إذا (القيمة == المتوقع)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("✗ فشل: " + الوصف + " — توقعنا: " + المتوقع + "، حصلنا: " + القيمة)
        فشل = فشل + 1
    نهاية
نهاية

# --- اختبار الجمع ---
متغير أ = متجه(1، 2) جديد
متغير ب = متجه(3، 4) جديد
متغير ج = أ + ب
تحقق("متجه + متجه", "" + ج, "(4، 6)")

# --- اختبار الطرح ---
متغير د = ب - أ
تحقق("متجه - متجه", "" + د, "(2، 2)")

# --- اختبار الضرب ---
متغير هـ = أ * ب
تحقق("متجه * متجه", "" + هـ, "(3، 8)")

# --- اختبار المساواة ---
متغير و = متجه(1، 2) جديد
تحقق("متجه == متجه (متساويان)", أ == و, صحيح)
تحقق("متجه == متجه (مختلفان)", أ == ب, خطأ)

# --- اختبار عدم المساواة ---
تحقق("متجه != متجه", أ != ب, صحيح)

# --- اختبار أصغر من ---
تحقق("متجه < متجه", أ < ب, صحيح)

# --- اختبار العامل الأحادي (سالب) ---
متغير سالب = -أ
تحقق("سالب متجه", "" + سالب, "(-1، -2)")

# --- اختبار عامل نص (مع اطبع) ---
تحقق("عامل نص", "" + أ, "(1، 2)")

# --- اختبار عامل منطقي ---
متغير صفر = متجه(0، 0) جديد
إذا (أ)
    تحقق("عامل منطقي (غير صفري)", صحيح, صحيح)
نهاية

# --- اختبار الفهرسة [] ---
متغير م = مصفوفتي() جديد
تحقق("عامل []", م[0], 10)
تحقق("عامل [] (آخر)", م[4], 50)

# --- اختبار الإسناد بالفهرس []= ---
م[2] = 99
تحقق("عامل []=", م[2], 99)

# --- اختبار عامل الاستدعاء () ---
متغير ض = مضاعف(3) جديد
تحقق("عامل ()", ض(7), 21)
تحقق("عامل () (آخر)", ض(10), 30)

# --- اختبار الوراثة مع العوامل ---
متغير موظ = موظف("أحمد"، 5000) جديد
تحقق("وراثة عامل نص", "" + موظ, "كائن: أحمد")

إذا (موظ)
    تحقق("وراثة عامل منطقي", صحيح, صحيح)
نهاية

# --- اختبار اطبع مع عامل نص ---
اطبع_سطر(أ)
اطبع_سطر(م)

# --- النتائج ---
اطبع_سطر("=== النتائج ===")
اطبع_سطر("نجح: " + نجاح)
اطبع_سطر("فشل: " + فشل)
إذا (فشل == 0)
    اطبع_سطر("=== جميع الاختبارات نجحت ===")
نهاية
