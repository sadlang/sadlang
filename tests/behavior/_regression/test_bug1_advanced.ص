# اختبار شامل للفهرسة المتسلسلة — سيناريوهات متقدمة
# يغطي: عمق 3+، حلقات، إسناد، مصفوفات داخل خرائط

# سيناريو 1: عمق 3 — مصفوفة خرائط داخل خرائط
متغير بيانات = [
    {"اسم": "أحمد", "عنوان": {"مدينة": "الرياض", "حي": "العليا"}},
    {"اسم": "سعيد", "عنوان": {"مدينة": "جدة", "حي": "الحمراء"}}
]

دالة احصل_مدينة(فهرس)
    متغير شخص = بيانات[فهرس]
    ارجع شخص["عنوان"]["مدينة"]
نهاية

اطبع("مدينة أحمد: " + احصل_مدينة(0))
اطبع("مدينة سعيد: " + احصل_مدينة(1))

# سيناريو 2: مصفوفة داخل خريطة داخل مصفوفة
متغير طلاب = [
    {"اسم": "خالد", "درجات": [90, 85, 95]},
    {"اسم": "فاطمة", "درجات": [100, 92, 88]}
]

دالة احصل_درجة(طالب_فهرس، درجة_فهرس)
    ارجع طلاب[طالب_فهرس]["درجات"][درجة_فهرس]
نهاية

اطبع("درجة خالد الأولى: " + احصل_درجة(0, 0))
اطبع("درجة فاطمة الثالثة: " + احصل_درجة(1, 2))

# سيناريو 3: حلقة مع فهرسة متسلسلة عمق 2
دالة اطبع_كل_الاسماء()
    متغير ي = 0
    بينما (ي < 2)
        اطبع("طالب: " + طلاب[ي]["اسم"])
        متغير ي = ي + 1
    نهاية
نهاية

اطبع_كل_الاسماء()

# سيناريو 4: استدعاء من عمق 3
دالة مستوى3()
    ارجع احصل_درجة(0, 1)
نهاية

دالة مستوى2()
    ارجع مستوى3()
نهاية

اطبع("عمق 3: " + مستوى2())

اطبع("=== نجحت جميع السيناريوهات المتقدمة ===")
