# @description مدمجاتُ الاستعلام المنطقيّة تُقارَن بـ«خطأ»/«صحيح» بلا كسرِ وحدة LLVM
# @priority P0
# @expected ملف == خطأ: صحيح
# @expected مجلد == خطأ: خطأ
# @expected موجود == صحيح: صحيح
# @expected رابط == خطأ: صحيح
#
# الانحدارُ المحروس: جسورُ C لهذه المدمجات تُرجِع `int` (i32) بينما نوعُ النتيجة في
# SIR منطقيّ (i1). فأيُّ مقارنةٍ صريحة — `هل_ملف(س) == خطأ` — تُصدِر
# `icmp eq i32 %r, i1 false` فتسقط الوحدةُ كلُّها في verifyModule بخطأٍ داخليّ.
#
# استعمالُها **شرطًا مباشرًا** (`إذا (هل_ملف(س))`) كان يمرّ، فبقي العيبُ كامنًا:
# لا يظهر إلّا عند المقارنة الصريحة — وهي الصيغةُ الطبيعيّة لفحص النفي في ص، إذ
# لا مُعامِلَ نفيٍ أُحاديًّا شائعًا في هذه الشيفرة.
#
# كُشف عند نقلِ حارس المسار في نبراس (ق6) إلى لغة ص: `هل_ملف(هدف) == خطأ`.

استورد أساسيات

ثابت المجلد = "م1_مقارنة_منطقية"

دالة رئيسية()
    أنشئ_مجلد(المجلد)

    اطبع_سطر("ملف == خطأ: " + نص(هل_ملف(المجلد) == خطأ))
    اطبع_سطر("مجلد == خطأ: " + نص(هل_مجلد(المجلد) == خطأ))
    اطبع_سطر("موجود == صحيح: " + نص(هل_موجود(المجلد) == صحيح))
    اطبع_سطر("رابط == خطأ: " + نص(هل_رابط_رمزي(المجلد) == خطأ))

    احذف_مجلد(المجلد)
نهاية
