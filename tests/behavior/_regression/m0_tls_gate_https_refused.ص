# @description بوابة M0 / S1: طلب https بلا TLS يُرفَض (501) قبل إرسال أيّ بايت
# @priority P0
# @expected رمز الحالة: 501
# @expected السبب يذكر TLS: نعم
# @skip_compiler
# @timeout 20

# لماذا عنوانٌ محجوز؟ 203.0.113.1 من مدى التوثيق (RFC 5737) ولا يُوجَّه إطلاقاً،
# فلو تجاوز الكودُ الحاجزَ لظهر خطأُ اتّصال أو مهلة لا 501 ⇒ يفشل الاختبار.
# الانحدارُ المحروس: كان طلبُ https يُنشئ مقبساً خاماً على المنفذ 443 ويُرسل
# الطلب — وفيه ترويسةُ الاستيثاق — نصّاً صريحاً على السلك.

استورد شبكة
استورد نصوص

متغير متصفح = أنشئ_متصفح()
متغير رد = اجلب(متصفح، "https://203.0.113.1/v1/models")

اطبع_سطر(f"رمز الحالة: {رمز_الحالة(رد)}")

متغير سبب = سبب_الفشل(متصفح)
إذا (يحتوي_على(سبب، "SAD_TLS_NOT_AVAILABLE"))
    اطبع_سطر("السبب يذكر TLS: نعم")
وإلا
    اطبع_سطر(f"السبب يذكر TLS: لا — {سبب}")
نهاية

تجاهل_الرد(رد)
أغلق_متصفح(متصفح)
