# @description F15: المسار_الحقيقي والمسار_المطلق وهل_رابط_رمزي — أساسُ فرضِ احتواء المسارات
# @priority P0
# @expected حقيقيّ للمجلّد الحالي: نص
# @expected حقيقيّ لمسارٍ غائب فارغ: صحيح
# @expected مطلق لمسارٍ غائب: نص
# @expected رابط رمزيّ لملفٍّ عاديّ: خطأ
# @expected رابط رمزيّ لمسارٍ غائب: خطأ
# @expected يطبّع النقطتين: صحيح
#
# لماذا هذه الدوالّ؟ التطبيعُ النصّيّ وحده لا يفرض احتواءَ مسار: رابطٌ رمزيّ داخل
# الجذر يشير خارجه، فتقع الكتابةُ خارج الجذر. المسار_الحقيقي يتبع الروابط فيكشف
# الهروب، وهل_رابط_رمزي يفحص المدخلَ نفسه — إذ هل_ملف يتبع الرابطَ فيصف الهدف.
#
# بلا @skip_compiler عن قصد: يُشغَّل على المحرّكين ويُقارَن مخرَجُهما، لأنّ دوالًّا
# تعمل في المفسّر وحده لا تفيد نبراس (يُصرَّف لا يُفسَّر). والعقدُ موحَّد: نصٌّ فارغ
# عند تعذّر الحلّ لا «عدم» — تمثيلُ العدم يختلف بين المحرّكين فيكسر التكافؤ.

استورد أساسيات

متغير هنا = المسار_الحقيقي(".")
اطبع_سطر("حقيقيّ للمجلّد الحالي: " + نوع(هنا))

# مسارٌ غائب ⇒ نصٌّ فارغ لا خطأ: حالةٌ متوقّعة (ملفٌّ يُنشَأ) يميّزها المستعمل بنفسه.
متغير غائب = المسار_الحقيقي("لا_يوجد_قطعا_12345.ص")
اطبع_سطر("حقيقيّ لمسارٍ غائب فارغ: " + نص(غائب == ""))

# المطلق يعمل على غير الموجود لأنّه تطبيعٌ نصّيّ لا حلٌّ فعليّ.
اطبع_سطر("مطلق لمسارٍ غائب: " + نوع(المسار_المطلق("لا_يوجد_قطعا_12345.ص")))

اطبع_سطر("رابط رمزيّ لملفٍّ عاديّ: " + نص(هل_رابط_رمزي("tests/config.yaml")))
اطبع_سطر("رابط رمزيّ لمسارٍ غائب: " + نص(هل_رابط_رمزي("لا_يوجد_قطعا_12345.ص")))

# التطبيع: مسارٌ يمرُّ بمجلّدٍ ثمّ يصعد يعود إلى موضعِه — وهذا ما يجعل الاحتواء
# قابلاً للفرض.
#
# (AR) 🔑 **المجلّدُ يُنشَأ ولا يُفترَض.** كان الفحصُ يمرُّ بـ"./tests/.." معتمدًا
#      على أنّ التشغيلَ يجري في جذرِ المستودع، والمحرّكانِ كانا يعملان في
#      مجلّدَين مختلفَين (المفسّرُ في مجلّدِ عملٍ خاصٍّ والمُصرَّفُ في الجذر) —
#      فافترقا على لينكس: `المسار_الحقيقي` هناك يلزمُه وجودُ كلِّ مكوّنٍ، فأخفقَ
#      للمفسّرِ ونجحَ للمترجم. وذاك تباعُدٌ صنعَته أداةُ القياسِ لا اللغة.
#      ⚠️ ولا يكفي توحيدُ المجلّد: في مجلّدٍ فارغٍ لا يوجدُ `tests` أصلًا، فيتّفقُ
#      المحرّكانِ على «خطأ» ويُقرأُ الاختبارُ أخضرَ وهو **فارغٌ من معناه** — أي
#      إشارةٌ أُخضِرَّت بإفراغِها. فيُنشَأُ المجلّدُ هنا ليبقى الفحصُ فحصًا.
متغير فرع = "فرع_تطبيع_مؤقت"
أنشئ_مجلد(فرع)
متغير صاعد = المسار_الحقيقي("./" + فرع + "/..")
اطبع_سطر("يطبّع النقطتين: " + نص(صاعد == هنا))
احذف_مجلد(فرع)
