# اختبار الانحدار #17 — جديد وسجل كلمات محجوزة غير موثقة
# Regression Test #17 — جديد and سجل are undocumented reserved words
# المشكلة: لا يمكن استخدامها كأسماء متغيرات/معاملات
# الأولوية: P1

# === اختبار 1: استخدام بدائل (يجب أن يعمل) ===
دالة أضف_عنصر(عنصر_مُضاف)
    ارجع عنصر_مُضاف
نهاية

متغير نتيجة = أضف_عنصر("قيمة")
إذا (نتيجة == "قيمة")
    اطبع("PASS: بديل 'عنصر_مُضاف' يعمل")
وإلا
    اطبع("FAIL: بديل فشل")
نهاية

# === اختبار 2: استخدام جديد لإنشاء كائن (الاستخدام الصحيح) ===
صنف شخص
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية
نهاية

متغير ش = شخص("أحمد") جديد
إذا (ش.الاسم == "أحمد")
    اطبع("PASS: جديد لإنشاء كائن يعمل")
وإلا
    اطبع("FAIL: جديد فشل")
نهاية

# === اختبار 3: بديل لسجل ===
متغير سجلّ_بيانات = "بيانات"
إذا (سجلّ_بيانات == "بيانات")
    اطبع("PASS: بديل 'سجلّ_بيانات' يعمل")
وإلا
    اطبع("FAIL: بديل فشل")
