# اختبار الانحدار #12 — القسمة تنتج أعداداً عشرية دائماً
# Regression Test #12 — Division always produces floats
# المشكلة: 8 / 4 = 2.0 بدلاً من 2، يكسر الفهرسة — أُغلقت بتثبيت دلالة C
# الأولوية: P0

# === اختبار 1: قسمة بسيطة ===
متغير نتيجة = 10 / 2
اطبع("10 / 2 = " + نتيجة)

# === اختبار 2: قسمة مع باقٍ — تقتطع نحو الصفر، والعشريّ يلزمه معاملٌ عشريّ ===
متغير ن2 = 7 / 2
اطبع("7 / 2 = " + ن2)
متغير ناتج_عشري = 7 / 2.0
اطبع("7 / 2.0 = " + ناتج_عشري)

# === اختبار 3: باقي القسمة ===
متغير ب = 10 % 3
إذا (ب == 1)
    اطبع("PASS: باقي القسمة يعمل — 10 % 3 = 1")
وإلا
    اطبع("FAIL: باقي القسمة فشل — 10 % 3 = " + ب)
نهاية

# === اختبار 4: عمليات حسابية مختلطة ===
متغير حساب = (10 + 5) * 2 - 3
إذا (حساب == 27)
    اطبع("PASS: عمليات مختلطة تعمل")
وإلا
    اطبع("FAIL: عمليات مختلطة فشلت — النتيجة = " + حساب)
نهاية

# === اختبار 5: استخدام ناتج القسمة كفهرس ===
متغير مصفوفة = ["أ", "ب", "ج", "د"]
متغير فهرس = 4 / 2
اطبع("فهرس = " + فهرس)

اطبع("=== انتهى اختبار #12 ===")
