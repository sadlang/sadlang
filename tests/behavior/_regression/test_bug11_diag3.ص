# تشخيص دقيق — هذا.حقل.method() داخل method الصنف نفسه

صنف نقطة
    باني(س، ع)
        هذا.س = س
        هذا.ع = ع
    نهاية

    دالة وصف()
        ارجع "(" + هذا.س + ", " + هذا.ع + ")"
    نهاية
نهاية

صنف صندوق
    باني(أ، ب)
        هذا.أول = أ
        هذا.ثاني = ب
    نهاية

    دالة معلومات()
        # هذا هو السيناريو الحرج: هذا.حقل.method() داخل method
        اطبع("الأول: " + هذا.أول.وصف())
        اطبع("الثاني: " + هذا.ثاني.وصف())
    نهاية
نهاية

متغير ن1 = نقطة(1، 2) جديد
متغير ن2 = نقطة(3، 4) جديد
متغير ص = صندوق(ن1، ن2) جديد

ص.معلومات()
اطبع("=== نجح ===")
