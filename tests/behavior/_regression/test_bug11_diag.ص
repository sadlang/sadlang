# تشخيص المشكلة — حقول متعددة في الباني

صنف نقطة
    باني(س، ع)
        هذا.س = س
        هذا.ع = ع
    نهاية
نهاية

صنف صندوق
    باني(أ، ب)
        هذا.أول = أ
        هذا.ثاني = ب
    نهاية
نهاية

متغير ن1 = نقطة(1، 2) جديد
متغير ن2 = نقطة(3، 4) جديد

اطبع("قبل الصندوق:")
اطبع("ن1.س = " + ن1.س)
اطبع("ن2.س = " + ن2.س)

متغير ص = صندوق(ن1، ن2) جديد

# اختبار 1: الوصول للحقل الأول
اطبع("ص.أول = " + ص.أول)
اطبع("ص.أول.س = " + ص.أول.س)

# اختبار 2: الوصول للحقل الثاني
اطبع("ص.ثاني = " + ص.ثاني)
اطبع("ص.ثاني.س = " + ص.ثاني.س)

اطبع("نجح!")
