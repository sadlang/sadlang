# @description اختبار دوال تمرر كمعاملات + لامدا متداخلة + تركيب دوال
# @expected 10\n25\nمرشح:[2, 4]\nتحويل:[1, 4, 9]\nمركب:16
# @priority P2

# ============================================================
# 1) دالة تستقبل دالة كمعامل
# ============================================================
دالة تطبيق(د، قيمة)
    ارجع د(قيمة)
نهاية

دالة مضاعفة(س)
    ارجع س * 2
نهاية

دالة تربيع(س)
    ارجع س * س
نهاية

اطبع_سطر(تطبيق(مضاعفة، 5))
اطبع_سطر(تطبيق(تربيع، 5))

# ============================================================
# 2) لامدا مع خريطة ورشح
# ============================================================
متغير أرقام = [1، 2، 3، 4، 5]
متغير زوجية = أرقام.رشح(لامدا (ن) ارجع ن % 2 == 0 نهاية)
اطبع_سطر("مرشح:" + زوجية)

متغير مربعات = [1، 2، 3].خريطة(لامدا (ن) ارجع ن * ن نهاية)
اطبع_سطر("تحويل:" + مربعات)

# ============================================================
# 3) تركيب دوال (composition)
# ============================================================
دالة ركّب(د1، د2)
    ارجع لامدا (س)
        ارجع د1(د2(س))
    نهاية
نهاية

دالة زائد_ثلاثة(س)
    ارجع س + 3
نهاية

متغير مركبة = ركّب(مضاعفة، زائد_ثلاثة)
اطبع_سطر("مركب:" + مركبة(5))
