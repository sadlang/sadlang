# @description اختبار الإغلاقات (Closures) مع الحلقات — التقاط المتغيرات
# @expected 1\n4\n9\n16\n25\n10\n20\n30
# @priority P2

# ============================================================
# 1. إنشاء إغلاقات داخل حلقة
# ============================================================
متغير دوال = []
لكل ع في [1، 2، 3، 4، 5]
    متغير القيمة = ع
    دوال.أضف(لامدا() => القيمة * القيمة)
نهاية

لكل د في دوال
    اطبع_سطر(د())
نهاية

# ============================================================
# 2. إغلاق يحتفظ بمتغير خارجي
# ============================================================
دالة مصنع_مضاعف(مضاعف)
    ارجع لامدا(س) => س * مضاعف
نهاية

متغير ضعف = مصنع_مضاعف(10)
اطبع_سطر(ضعف(1))
اطبع_سطر(ضعف(2))
اطبع_سطر(ضعف(3))
