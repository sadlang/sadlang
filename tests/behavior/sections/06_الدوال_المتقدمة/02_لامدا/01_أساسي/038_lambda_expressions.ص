# @test اختبار تعبيرات اللامدا الأساسية
# @description اختبار لامدا: دوال مجهولة، إغلاقات، لامدا كوسيط، لامدا مع نصوص، لامدا متداخلة
# @expected L01:PASS\nL02:PASS\nL03:PASS\nL04:PASS\nL05:PASS\nL06:PASS\nL07:PASS\nSUMMARY:7/7

# ═══ L01: لامدا بسيطة — معامل واحد ═══

استورد رياضيات

متغير ضعف = لامدا(س) => س * 2
إذا (ضعف(7) == 14)
    اطبع_سطر("L01:PASS")
وإلا
    اطبع_سطر("L01:FAIL")
نهاية

# ═══ L02: لامدا بمعاملين ═══
متغير جمع = لامدا(أ، ب) => أ + ب
إذا (جمع(3، 5) == 8)
    اطبع_سطر("L02:PASS")
وإلا
    اطبع_سطر("L02:FAIL")
نهاية

# ═══ L03: لامدا بدون معاملات ═══
متغير ثابت_خمسة = لامدا() => 5
إذا (ثابت_خمسة() == 5)
    اطبع_سطر("L03:PASS")
وإلا
    اطبع_سطر("L03:FAIL")
نهاية

# ═══ L04: لامدا مع نص ═══
متغير تحية = لامدا(اسم) => "مرحباً " + اسم
إذا (تحية("عالم") == "مرحباً عالم")
    اطبع_سطر("L04:PASS")
وإلا
    اطبع_سطر("L04:FAIL")
نهاية

# ═══ L05: لامدا كوسيط لدالة ═══
دالة تطبيق(دالة_م، قيمة)
    ارجع دالة_م(قيمة)
نهاية
متغير مربع = لامدا(ن) => ن * ن
إذا (تطبيق(مربع، 6) == 36)
    اطبع_سطر("L05:PASS")
وإلا
    اطبع_سطر("L05:FAIL")
نهاية

# ═══ L06: لامدا تلتقط متغيرات خارجية (إغلاق) ═══
متغير عامل = 10
متغير ضرب_بعامل = لامدا(س) => س * عامل
إذا (ضرب_بعامل(5) == 50)
    اطبع_سطر("L06:PASS")
وإلا
    اطبع_سطر("L06:FAIL")
نهاية

# ═══ L07: لامدا متداخلة (لامدا تُرجع لامدا) ═══
دالة مصنع_جمع(أ)
    ارجع لامدا(ب) => أ + ب
نهاية
متغير جمع_عشرة = مصنع_جمع(10)
إذا (جمع_عشرة(7) == 17 و جمع_عشرة(3) == 13)
    اطبع_سطر("L07:PASS")
وإلا
    اطبع_سطر("L07:FAIL")
نهاية

# ═══ الملخص ═══
اطبع_سطر("SUMMARY:7/7")
