# @test اختبار string concat مع أرقام داخل لامدا
# @description اختبار تحويل الأرقام لنصوص تلقائياً في عمليات concat داخل لامدا — سهم وكتلة
# @expected S01:PASS\nS02:PASS\nS03:PASS\nS04:PASS\nS05:PASS\nS06:PASS\nSUMMARY:6/6

متغير تمرير = 0
متغير فشل = 0

# ═══ S01: لامدا سهم — "نص" + رقم ═══
متغير ض1 = لامدا(س) => "القيمة: " + س
إذا (ض1(42) == "القيمة: 42")
    اطبع_سطر("S01:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("S01:FAIL")
    فشل = فشل + 1
نهاية

# ═══ S02: لامدا سهم — رقم + "نص" + رقم ═══
متغير ض2 = لامدا(أ، ب) => "[" + أ + "," + ب + "]"
إذا (ض2(10، 20) == "[10,20]")
    اطبع_سطر("S02:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("S02:FAIL")
    فشل = فشل + 1
نهاية

# ═══ S03: خريطة HOF — string concat مع أرقام ═══
متغير أرقام = [1، 2، 3]
متغير نصوص = أرقام.خريطة(لامدا(ن)
    ارجع "#" + ن
نهاية)
إذا (نصوص[0] == "#1" و نصوص[1] == "#2" و نصوص[2] == "#3")
    اطبع_سطر("S03:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("S03:FAIL")
    فشل = فشل + 1
نهاية

# ═══ S04: خريطة HOF — string concat + رقم مع إحاطة ═══
متغير قيم = [10، 20، 30]
متغير محاط = قيم.خريطة(لامدا(ق)
    ارجع "=" + ق + "="
نهاية)
إذا (محاط[0] == "=10=" و محاط[1] == "=20=" و محاط[2] == "=30=")
    اطبع_سطر("S04:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("S04:FAIL")
    فشل = فشل + 1
نهاية

# ═══ S05: لامدا كتلة — string concat + إذا + رقم ═══
متغير وصف = لامدا(اسم، عمر)
    متغير وضع = "شاب"
    إذا (عمر >= 30)
        وضع = "كبير"
    نهاية
    ارجع اسم + ":" + عمر + ":" + وضع
نهاية
إذا (وصف("أحمد"، 25) == "أحمد:25:شاب")
    اطبع_سطر("S05:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("S05:FAIL")
    فشل = فشل + 1
نهاية

# ═══ S06: خريطة كتلة — string concat + رقم + إذا ═══
متغير درجات = [45، 75، 95]
متغير تقارير = درجات.خريطة(لامدا(د)
    إذا (د >= 90)
        ارجع "A:" + د
    وإلا
        إذا (د >= 70)
            ارجع "B:" + د
        وإلا
            ارجع "F:" + د
        نهاية
    نهاية
نهاية)
إذا (تقارير[0] == "F:45" و تقارير[1] == "B:75" و تقارير[2] == "A:95")
    اطبع_سطر("S06:PASS")
    تمرير = تمرير + 1
وإلا
    اطبع_سطر("S06:FAIL")
    فشل = فشل + 1
نهاية

# ═══ الملخص ═══
اطبع_سطر("SUMMARY:" + تمرير + "/" + (تمرير + فشل))
