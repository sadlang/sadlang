# @description اختبار العقود البرمجية (Contracts) — يتطلب ويضمن
# @expected 5\nنجح\nخطأ_عقد
# @priority P2

# ============================================================
# 1. عقد بسيط — يتطلب
# ============================================================
دالة قسمة_آمنة(أ، ب)
    يتطلب ب != 0
    ارجع أ / ب
نهاية

اطبع_سطر(قسمة_آمنة(10، 2))

# ============================================================
# 2. عقد مع يضمن
# ============================================================
دالة القيمة_المطلقة(ن)
    يضمن النتيجة >= 0
    إذا (ن < 0)
        ارجع -ن
    نهاية
    ارجع ن
نهاية

# اختبار نجاح
اطبع_سطر("نجح")

# ============================================================
# 3. انتهاك عقد يتطلب
# ============================================================
حاول
    قسمة_آمنة(10، 0)
    اطبع_سطر("لم_يرمي")
امسك خطأ
    اطبع_سطر("خطأ_عقد")
نهاية
