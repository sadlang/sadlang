# @description حارس حدّي (عائلة t001): ناتج قالب قيميّ في دمج نصي وفي خانة مصنَّفة —
#              التسجيل «مجهولًا» لا يفجّر حارس الإسناد المصنَّف على قيمة حاضرة
# @expected أهلا-دنيا\n9\nنصي
# @priority P1

قالب <نوع ت>
دالة مرّر(ت س)
    ارجع س
نهاية

اطبع_سطر(مرّر("أهلا") + "-" + مرّر("دنيا"))
متغير رقم خانة_رقمية = مرّر(9)
اطبع_سطر(خانة_رقمية)
متغير نص خانة_نصية = مرّر("نصي")
اطبع_سطر(خانة_نصية)
