# @description عزلُ خاناتِ الماكرو — الأشكالُ الثلاثةُ المقيسة، ونسخُ المعامِلِ للخلفِ سليمًا
# @expected أ:خارجي_أ\nب:خارجي_ب\nج:خارجي_ج\nد:6
# @priority P1

# ============================================================================
# (AR) 🔑 مرجعُ هذه البذرةِ **عقدٌ مكتوب** لا اجتهاد: `language-truth/
#      grammar_constructs.yaml` ← `grammar.macro` يصفُ الماكرو بأنّه
#      «hygenic» وحالتُه `stable`. فالتباعدُ خرقُ عقدٍ لا اختلافُ ذوق.
#
#      وسببُ الأشكالِ الثلاثة: العلّةُ المقيسةُ ليست في «الماكرو» بل في أنّ
#      اسمَ الخانةِ يُشتَقُّ من الاسمِ المجرَّد، فيقعُ التصريحُ الداخليُّ على
#      ما يملكُه ذلك الاسمُ في المحيط. والمحيطُ ثلاثةٌ لا واحد، ولكلٍّ
#      مسارُ توليدٍ آخرُ — فشكلٌ واحدٌ يترك شكلَين أحمرَين وهو أخضر:
#
#        أ) مستوًى أعلى + `ارجع`  ⇒ مسارُ **الدالّةِ المؤقّتة**؛ قِيس أنّ
#           `__macro_اختبار_عزل_1` يُخزِّن في العامِّ `@قيمة` نفسِه.
#        ب) مستوًى أعلى بلا `ارجع` ⇒ مسارُ **التوسيعِ المباشر**؛ تخزينان
#           متتاليان في `@قيمة`، ولا `alloca` لأحدِهما.
#        ج) داخلَ دالّة            ⇒ مباشرٌ كذلك، لكنّ الخانةَ محلّيّةٌ:
#           `alloca` **واحدةٌ** وتخزينان فيها (مقيس في LLVM IR).
#
#      ⚠️ والفقرةُ (د) ليست زينة: الرقعةُ تعزلُ **التصريحَ** لا الإسناد،
#      ونسخُ المعامِلِ للخلفِ (copy-back) يمرُّ بربطِ اسمِ المعامِلِ بخانةِ
#      المُنادي. فلو عزَلَت الرقعةُ أكثرَ ممّا يجب لَانكسر (د) — وهو أخضرُ
#      في المحرّكَين اليومَ، فهو حارسُ الإفراطِ لا مجرّدُ تغطية.
#
#      🔴 ولا يُخلَط بـISSUE-028: تظليلُ `متغير` داخلَ **كتلةٍ** عاديّةٍ
#      لا يعزل، وذلك قرارُ نطاقٍ مفتوحٌ للمالكِ عمدًا. هذه البذرةُ تحرسُ
#      جسمَ الماكرو وحدَه ولا تدّعي شيئًا عن الكتل.
#
# (EN) The reference is a WRITTEN contract: grammar.macro in the SoT declares
#      macros "hygenic", status stable. Three shapes because the defect is that
#      a slot name is derived from the bare identifier, so the inner declaration
#      lands on whatever that name already owns — and the enclosing context has
#      three forms, each with a different lowering path. Section (د) guards
#      against OVER-isolation: parameter copy-back must survive.
# ============================================================================

# ── أ) مستوًى أعلى، ماكرو فيه `ارجع` ⇒ مسارُ الدالّةِ المؤقّتة ─────────────
متغير عام_أ = "خارجي_أ"

ماكرو مع_ارجع()
    متغير عام_أ = "داخلي"
    ارجع 1
نهاية

متغير نتيجة_أ = مع_ارجع!()
اطبع_سطر("أ:" + عام_أ)

# ── ب) مستوًى أعلى، ماكرو بلا `ارجع` ⇒ مسارُ التوسيعِ المباشر ─────────────
متغير عام_ب = "خارجي_ب"

ماكرو بلا_ارجع()
    متغير عام_ب = "داخلي"
نهاية

بلا_ارجع!()
اطبع_سطر("ب:" + عام_ب)

# ── ج) داخلَ دالّة ⇒ الخانةُ محلّيّةٌ لا عامّة ────────────────────────────
دالة داخل_دالة()
    متغير محلي = "خارجي_ج"

    ماكرو جوّاني()
        متغير محلي = "داخلي"
    نهاية

    جوّاني!()
    اطبع_سطر("ج:" + محلي)
نهاية

داخل_دالة()

# ── د) حارسُ الإفراط: نسخُ المعامِلِ للخلفِ يجب أن يبقى عاملًا ─────────────
متغير عداد = 5

ماكرو زد(س)
    س = س + 1
نهاية

زد!(عداد)
اطبع_سطر("د:" + عداد)
