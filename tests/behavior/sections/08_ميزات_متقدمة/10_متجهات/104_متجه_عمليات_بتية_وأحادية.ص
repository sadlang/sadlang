دالة جرب()
    متغير أ = متجه(10، 20، 30، 40)
    متغير ب = متجه(3، 4، 5، 6)

    اطبع_سطر(متجه_عنصر(متجه_و(أ، ب)، 0))       # 10 و 3 = 2
    اطبع_سطر(متجه_عنصر(متجه_أو(أ، ب)، 0))      # 10 أو 3 = 11
    اطبع_سطر(متجه_عنصر(متجه_حصري(أ، ب)، 0))    # 10 ⊕ 3 = 9

    متغير س = متجه(0 - 7، 8، 0 - 9، 10)
    اطبع_سطر(متجه_عنصر(متجه_مطلق(س)، 0))       # |-7| = 7
    اطبع_سطر(متجه_عنصر(متجه_سالب(س)، 1))       # -8
