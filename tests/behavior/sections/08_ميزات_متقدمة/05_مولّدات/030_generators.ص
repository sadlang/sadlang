# @description اختبار المولّدات (generators) — إنتاج قيم بالتتابع
# @expected 1\n2\n3\n4\n5
# @priority P3

# صيغة المولد: مولد دالة (وليس دالة مولد)
مولد دالة عدّاد(من، إلى)
    متغير ع = من
    بينما (ع <= إلى)
        أنتج ع
        ع = ع + 1
    نهاية
نهاية

متغير م = عدّاد(1، 5)
لكل ق في م
    اطبع_سطر(ق)
نهاية
