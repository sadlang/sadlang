# @description تكافؤُ مسارِ المعدّلاتِ والمصنعِ النصّيِّ مع المفسّر. المفسّرُ يفحصُ بنيةَ القيمةِ زمنَ التشغيل (setIRPropertyFromValue) والمصرّفُ يوزّعُ على النوعِ الساكن، فرقّى ‎#٣٩٦ مسارَ الخاصّيّةِ الأولى ولم يبلغِ الترقيةُ مسارَ المعدّلاتِ ولا المصانعَ المكتوبةَ يدويًّا. أربعةُ تباعُداتٍ صامتةٍ: الأحجامُ المحدَّدةُ في معدّلٍ (بايت/طبيعي) كانت تُخزَّنُ نصًّا فارغًا · والعدمُ في معدّلٍ عدديٍّ كان يُمرَّرُ قيمةَ الحارسِ فيُطبَع ‎-9.22e+18 · والقيمةُ غيرُ المحسومةِ زمنَ الترجمةِ لمفتاحٍ متعدّدِ الأنواعِ («قيمة» = عدد أو منطقيّ) كانت تسقطُ إلى نصٍّ فارغ · و`نص_عنصر` بوسيطٍ غيرِ نصّيٍّ كان يُمرَّرُ إلى `sad_text(const char*)` فيُقرأُ العددُ عنوانًا ⇒ SIGSEGV. العلاجُ توحيدُ الحسمِ على الأوپكودِ الديناميِّ الذي يمرّرُ الوسمَ والحمولةَ فيحسمُ وقتُ التشغيلِ كالمفسّر
# @expected صندوق(نصف_قطر: 3)\nصندوق(نصف_قطر: 4)\nصندوق(نصف_قطر: 6)\nصندوق(نصف_قطر: 2.5)\nصندوق(نصف_قطر: "لاشيء")\nترقيم_صفحات(قيمة: 3)\nترقيم_صفحات(قيمة: صحيح)\nنص_عنصر(محتوى: 42)\nنص_عنصر(محتوى: 2.5)\nنص_عنصر(محتوى: "مرحبا")\nنص_عنصر(محتوى: "[1, 2]")\nنص_عنصر(محتوى: "[أ, ب]")\nصندوق(لون: "[1, 2, 3]")\nصندوق(لون: "[أ]")\nمنزلق(قيمة: "[7, 8]")\nزر(عنوان: 42)\nأيقونة(اسم: 42)\nصورة(مصدر: 42)\nحقل_نص(تلميح: 42)\nتلميح(نص: 2.5)\nشريط_إشعار(رسالة: صحيح)\nمنطقة_نص(تلميح: 7)\nزر(عنوان: "موافق")\nصندوق(حدود: "[1, 2],3")\nصندوق(لون: "{أ: 1}")\nنص_عنصر(محتوى: "{أ: 1}")\nصندوق(حدود: "{أ: 1},3")\nمنزلق(قيمة: "{س: صحيح}")
# @priority P0
استورد رسومات

# ── خطُّ الأساس: صحيحٌ افتراضيُّ الحجمِ في معدّل ──
رقم نصف_قطر_الصندوق = 3
طباعة_شجرة(صندوق().نصف_قطر(نصف_قطر_الصندوق))

# ── أحجامٌ محدَّدة: كانت تسقطُ إلى نصٍّ فارغ ──
طبيعي نصف_قطر_غير_موقع = 4
طباعة_شجرة(صندوق().نصف_قطر(نصف_قطر_غير_موقع))

طبيعي8 نصف_قطر_ثماني_البتات = 6
طباعة_شجرة(صندوق().نصف_قطر(نصف_قطر_ثماني_البتات))

# ── عشريٌّ في معدّل ──
عشري نصف_قطر_عشري = 2.5
طباعة_شجرة(صندوق().نصف_قطر(نصف_قطر_عشري))

# ── العدمُ في معدّلٍ عدديّ: كان يُطبَعُ قيمةَ الحارسِ الرقميّة ──
طباعة_شجرة(صندوق().نصف_قطر(لاشيء))

# ── مفتاحٌ متعدّدُ الأنواعِ بقيمةٍ لا تُحسَمُ زمنَ الترجمة ──
طباعة_شجرة(ترقيم_صفحات().قيمة(6 / 2))
طباعة_شجرة(ترقيم_صفحات().قيمة(صحيح))

# ── المصنعُ النصّيُّ بوسيطٍ غيرِ نصّيّ: كان SIGSEGV ──
طباعة_شجرة(نص_عنصر(42))
طباعة_شجرة(نص_عنصر(2.5))
طباعة_شجرة(نص_عنصر("مرحبا"))

# ── حاويةٌ قيمةَ خاصّيّة: كان مؤشّرُ المصفوفةِ يُقرأُ نصًّا (قراءةٌ خارجَ الحدّ) ──
# المفسّرُ يُصيِّرُها بـtoString، والمصرّفُ يُصيِّرُها بالمساعِدِ نفسِه الذي يستعملُه نص(مصفوفة).
طباعة_شجرة(نص_عنصر([1، 2]))
طباعة_شجرة(نص_عنصر(["أ"، "ب"]))
طباعة_شجرة(صندوق().لون([1، 2، 3]))

# ── والمصفوفةُ في **متغيّر**: نوعُ العنصرِ كان يضيعُ عبرَ المعامل ──
# المصفوفةُ الحرفيّةُ كانت تصحُّ والمتغيّرُ يطبعُ عنوانَ المؤشّرِ رقمًا.
مصفوفة أسماء_الألوان = ["أ"]
طباعة_شجرة(صندوق().لون(أسماء_الألوان))
طباعة_شجرة(منزلق([7، 8]))

# ── مصانعُ خانتُها الأولى نصّيّة بوسيطٍ غيرِ نصّيّ: كانت تُسقِطُ البرنامجَ بـSIGSEGV ──
# التوقيعُ `const char*` وجسرُ الوسائطِ يحوّلُ الصحيحَ بـIntToPtr فيُقرأُ العددُ عنوانًا.
طباعة_شجرة(زر(42))
طباعة_شجرة(أيقونة(42))
طباعة_شجرة(صورة(42))
طباعة_شجرة(حقل_نص(42))
طباعة_شجرة(تلميح(2.5))
طباعة_شجرة(شريط_إشعار(صحيح))
طباعة_شجرة(منطقة_نص(7))

# ── والنصُّ يبقى في خانتِه: النائبُ لا يزحزحُ الوسائطَ الباقية ──
طباعة_شجرة(زر("موافق"))

# ── معدِّلٌ متعدّدُ الوسائط: المصفوفةُ كانت تُدمَجُ فارغةً («,3») ──
طباعة_شجرة(صندوق().حدود([1، 2]، 3))

# ── الخريطةُ قيمةَ خاصّيّة: كان الحقلُ يُترَكُ بلا كتابةٍ (دَينٌ مُعلَنٌ سابقًا) ──
# المفسّرُ يكتبُ صيغةَ toString غيرَ المقتبسةِ لا صيغةَ الطباعةِ المقتبسة.
# ⚠️ مفتاحٌ واحدٌ عمدًا: ترتيبُ مرورِ `std::unordered_map` من تنفيذِ المكتبةِ
#    القياسيّةِ فيختلفُ بين المنصّات، فقفلُ نصِّ خريطةٍ متعدّدةِ المفاتيحِ يقفلُ
#    مصادفةَ تجزئةٍ لا عقدًا. المقصودُ هنا أنّ الحقلَ يُكتَبُ نصًّا لا أن يُترَكَ.
خريطة جدول_الإعدادات = {"أ": 1}
طباعة_شجرة(صندوق().لون(جدول_الإعدادات))
طباعة_شجرة(نص_عنصر(جدول_الإعدادات))
طباعة_شجرة(صندوق().حدود(جدول_الإعدادات، 3))
طباعة_شجرة(منزلق({"س": صحيح}))
