# @description أبوابُ توليدِ كودِ المنصّاتِ الأربع (توليد_ويب/أندرويد/آي_أو_إس/ماك) — مولّداتُ HTML وCompose وSwiftUI وAppKit كانت تُبنى في كلّ ثنائيٍّ ولا يبلغها مستخدمُ لغةِ ص إلّا من C++. يُثبت هذا الاختبارُ ثلاثةَ أمورٍ لكلِّ باب: أنّه يُخرِج بصمةَ منصّتِه، وأنّ وسيطَه الثانيَ يُسمّي المخرَجَ فعلًا (وهو ما يفصل «البابُ موصول» عن «البابُ يُرجع نصًّا ما»)، وأنّ الكودَ خالٍ من بصمةِ البابِ التالي في حلقةٍ تغطّي المنصّاتِ الأربعَ كلَّها سلبًا — فلو تبادلت الأهدافُ في الموزِّع لسقط الفحصُ باسمِ بابِه
# @expected ✓ ويب — بصمة المنصّة\n✓ ويب — الوسيط الثاني يسمّي المخرَج\n✓ ويب — خالٍ من بصمة منصّة أخرى\n✓ أندرويد — بصمة المنصّة\n✓ أندرويد — الوسيط الثاني يسمّي المخرَج\n✓ أندرويد — خالٍ من بصمة منصّة أخرى\n✓ آي_أو_إس — بصمة المنصّة\n✓ آي_أو_إس — الوسيط الثاني يسمّي المخرَج\n✓ آي_أو_إس — خالٍ من بصمة منصّة أخرى\n✓ ماك — بصمة المنصّة\n✓ ماك — الوسيط الثاني يسمّي المخرَج\n✓ ماك — خالٍ من بصمة منصّة أخرى\n\nنجح: 12 / فشل: 0\n✅ كل الأبواب سليمة
# @priority P1
استورد نصوص
استورد رسومات

متغير عدد_الناجحة = 0
متغير عدد_الفاشلة = 0

دالة تحقق(نص وصف_الفحص، منطقي نتيجة_الفحص)
    إذا (نتيجة_الفحص)
        عدد_الناجحة++
        اطبع_سطر("✓ " + وصف_الفحص)
    وإلا
        عدد_الفاشلة++
        اطبع_سطر("✗ " + وصف_الفحص)
    نهاية
نهاية

# شجرةُ الدخلِ نفسُها في الأبوابِ الأربعة ⇒ الفارقُ كلُّه في الهدفِ لا في المدخل.
دالة اصنع_شجرة_الجذر()
    ارجع نص_عنصر("مرحبا")
نهاية

# لكلِّ باب: بصمةُ منصّتِه، وأثرُ اسمِ المخرَجِ في الكود، وغيابُ بصمةِ البابِ التالي
# في الحلقة (ويب ← أندرويد ← آي_أو_إس ← ماك ← ويب) فتُغطّى المنصّاتُ الأربعُ سلبًا.
دالة افحص_باب(نص اسم_المنصّة، نص الكود_المولَّد، نص بصمة_المنصّة، نص بصمة_التسمية، نص بصمة_منصّة_دخيلة)
    تحقق(اسم_المنصّة + " — بصمة المنصّة"، يحتوي_على(الكود_المولَّد، بصمة_المنصّة))
    تحقق(اسم_المنصّة + " — الوسيط الثاني يسمّي المخرَج"، يحتوي_على(الكود_المولَّد، بصمة_التسمية))
    تحقق(اسم_المنصّة + " — خالٍ من بصمة منصّة أخرى"، يحتوي_على(الكود_المولَّد، بصمة_منصّة_دخيلة) == خطأ)
نهاية

# ── الويب: بصمة HTML، والوسيط الثاني عنوان الصفحة ──
ثابت كود_الويب = توليد_ويب(اصنع_شجرة_الجذر()، "صفحة_الويب")
افحص_باب("ويب"، كود_الويب، "<!DOCTYPE html>"، "<title>صفحة_الويب</title>"، "@Composable")

# ── أندرويد: بصمة Kotlin/Compose، والوسيط الثاني اسم الدالّة المولَّدة ──
ثابت كود_أندرويد = توليد_أندرويد(اصنع_شجرة_الجذر()، "شاشة_أندرويد")
افحص_باب("أندرويد"، كود_أندرويد، "@Composable"، "fun شاشة_أندرويد()"، "import SwiftUI")

# ── آي_أو_إس: بصمة SwiftUI، والوسيط الثاني اسم البنية المولَّدة ──
ثابت كود_آي_أو_إس = توليد_آي_أو_إس(اصنع_شجرة_الجذر()، "شاشة_آي_أو_إس")
افحص_باب("آي_أو_إس"، كود_آي_أو_إس، "import SwiftUI"، "struct شاشة_آي_أو_إس: View"، "import AppKit")

# ── ماك: بصمة AppKit، والوسيط الثاني اسم المتحكّم المولَّد ──
ثابت كود_ماك = توليد_ماك(اصنع_شجرة_الجذر()، "شاشة_ماك")
افحص_باب("ماك"، كود_ماك، "import AppKit"، "class شاشة_ماكViewController"، "<!DOCTYPE html>")

# ─── النتائج ───
اطبع_سطر("")
اطبع_سطر("نجح: " + عدد_الناجحة + " / فشل: " + عدد_الفاشلة)
إذا (عدد_الفاشلة == 0)
    اطبع_سطر("✅ كل الأبواب سليمة")
وإلا
    اطبع_سطر("❌ باب أو أكثر معطوب")
نهاية
