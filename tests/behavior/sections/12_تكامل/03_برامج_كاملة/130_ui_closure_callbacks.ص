# @description قفل انحدار — تمرير إغلاقات (لامدا تلتقط متغيّرًا) ودوالّ مسمّاة كردود نداء لعناصر SadUI عبر المسارات الثلاثة: وسيط المصنع زر(عنوان، دالة)، المعدّل الانسيابيّ .عند_النقر(لامدا)، ولامدا محفوظة في متغيّر — تكافؤ طباعة_شجرة بين المفسّر والمترجم (كان جسر الإغلاق في المترجم مقطوعًا تاريخيًّا: data=null إلى sad_button) + استدعاء حيّ لثانك الإغلاق نفسه عبر عين_الحالة(لامدا ملتقطة) بحيث تظهر القيمة الملتقطة في المخرجات (يفشل فعليًّا لو أُسقطت بيئة الالتقاط — أُثبت بكسرٍ صنعيّ)
# @expected زر(عنوان: "أول")\nزر(عنوان: "ثانٍ") [عند_النقر]\nزر(عنوان: "ثالث") [عند_النقر]\nزر(عنوان: "رابع") [عند_النقر]\nملتقط_حي_7
# @priority P1
استورد رسومات

# 1) إغلاق يلتقط معاملًا ويُمرَّر وسيطَ مصنعٍ مباشرًا (خانة onTap)
دالة اصنع_بالمصنع(رسالة)
    ارجع زر("أول"، لامدا() => اطبع_سطر(رسالة))
نهاية

# 2) إغلاق مضمَّن في المعدّل الانسيابيّ عند_النقر
دالة اصنع_بالحدث(رسالة)
    ارجع زر("ثانٍ").عند_النقر(لامدا() => اطبع_سطر(رسالة))
نهاية

# 3) إغلاق محفوظ في متغيّر ثمّ مُمرَّر للمعدّل
دالة اصنع_بمتغير(عداد)
    متغير معالج_م = لامدا() => اطبع_سطر(عداد)
    ارجع زر("ثالث").عند_النقر(معالج_م)
نهاية

# 4) دالّة مسمّاة (تُغلَّف داخليًّا ببيئة فارغة)
دالة معالج_مسمى()
    اطبع_سطر("نُقر")
نهاية

# 5) استدعاء حيّ لجسر الإغلاق (نفس ثانك ردود النداء): عين_الحالة تستدعي اللامدا
#    فورًا ببيئتها الملتقطة عبر void* — القيمة الملتقطة تظهر في المخرجات، فينكشف
#    أيّ إسقاطٍ للبيئة سلوكيًّا (لا يكفي تسجيل [عند_النقر] وحده لكشف ذلك).
دالة استدع_حيا(وسم، رقم)
    عين_الحالة(لامدا() => اطبع_سطر(وسم + "_" + نص(رقم)))
نهاية

طباعة_شجرة(اصنع_بالمصنع("ملتقط_أول"))
طباعة_شجرة(اصنع_بالحدث("ملتقط_ثانٍ"))
طباعة_شجرة(اصنع_بمتغير(42))
طباعة_شجرة(زر("رابع").عند_النقر(معالج_مسمى))
استدع_حيا("ملتقط_حي"، 7)
