# @description جيسون — عددٌ صالحٌ بالمواصفةِ يتجاوز مدى أنواعِ ص يُردّ خطأً موسومًا لا رسالةً داخليّةً عارية
# @expected صحيح\nصحيح\nصحيح\nصحيح\n9223372036854775807\n-9223372036854775808\n0.0015\nصحيح\n=== انتهى ===
# @priority P1

استورد حلل من جيسون

ثابت وسم_الخطا = "جيسون: "
ثابت عبارة_عند_الموضع = " عند الموضع "


# (AR) الفحصُ على **الوسمِ والموضع** لا على «رمى» وحدَها. فقبلَ هذا السدِّ كانت
#      هذه المدخلاتُ ترمي فعلًا — لكن برسالةِ محرّكٍ عاريةٍ
#      «Sad runtime aborted (see ErrorManager for details)» بلا وسمٍ ولا موضعٍ
#      وstderr فارغ. فاختبارٌ يكتفي بـ«رمى» كان سيمرّ على العطبِ نفسِه.
دالة منطقي يرمي_موسوما(نص المدخل)
    حاول
        متغير القيمة_المحللة = حلل(المدخل)
        ارجع نوع(القيمة_المحللة) == وسم_الخطا
    امسك الخطا
        متغير الرسالة = نص(الخطا)
        ارجع الرسالة.يبدأ_بـ(وسم_الخطا) و الرسالة.يحتوي(عبارة_عند_الموضع)
    نهاية
نهاية

# ═══ أعدادٌ صالحةٌ بالمواصفةِ خارجَ مدى أنواعِ ص ═══
اطبع_سطر(نص(يرمي_موسوما("1e309")))
اطبع_سطر(نص(يرمي_موسوما("1e-400")))
اطبع_سطر(نص(يرمي_موسوما("9223372036854775808")))
اطبع_سطر(نص(يرمي_موسوما("-9223372036854775809")))

# ═══ شواهدُ سالبة: حدُّ المدى نفسُه يُقبَل ولا يُردّ ═══
# (AR) لولا هذه لمرّ الاختبارُ ولو كان السدُّ يردّ كلَّ عددٍ كبير.
اطبع_سطر(نص(حلل("9223372036854775807")))
اطبع_سطر(نص(حلل("-9223372036854775808")))
اطبع_سطر(نص(حلل("1.5e-3")))
اطبع_سطر(نص(يرمي_موسوما("9223372036854775807") == خطأ))

اطبع_سطر("=== انتهى ===")
