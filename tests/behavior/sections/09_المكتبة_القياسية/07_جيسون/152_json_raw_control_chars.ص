# @description جيسون — محرفُ تحكّمٍ خامٌّ داخلَ نصٍّ يُردّ خطأً موسومًا (RFC 8259 §7): كان يُقبَل صامتًا على المحرّكَين معًا فتقبل الوحدةُ ما لا تُنتِج
# @expected صحيح\nصحيح\nأ ب\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\n"أ\u0001ب"\n=== انتهى ===
# @priority P0

استورد حلل، ولد من جيسون
استورد حرف_من_رمز من خرائط

# ⚠️ الوسمُ منسوخٌ لا مستورَدٌ: `صدّر ثابت` يعمل في المفسّرِ ويردّه المصرِّفُ
#    بـ«Undefined variable» — فجوةٌ مُعلَنةٌ في ترويسةِ الوحدة. وهو سببُ تكرارِ
#    هذا الثابتِ و`يرمي_موسوما` في ملفّاتِ هذا المجلّدِ كلِّها.
ثابت وسم_الخطا = "جيسون: "
ثابت علامة_اقتباس = "\""
ثابت اول_محرف_قابل_للطباعة = 32
ثابت اخر_محرف_تحكم = 31

دالة منطقي يرمي_موسوما(نص المدخل)
    حاول
        متغير القيمة_المحللة = حلل(المدخل)
        # (AR) بلوغُ هذا السطرِ يعني أنّه لم يَرمِ.
        ارجع خطأ
    امسك الخطا
        ارجع نص(الخطا).يبدأ_بـ(وسم_الخطا)
    نهاية
نهاية

دالة نص نص_محاط(نص المحتوى)
    ارجع علامة_اقتباس + المحتوى + علامة_اقتباس
نهاية

# ═══ طرفا المدى المحروس ═══
# (AR) الحدُّ U+0020: ما دونَه يُردّ وهو نفسُه فما فوقَه يُقبَل. ويُقاس الطرفان
#      المتلاصقان لا «دونَه بكثيرٍ وفوقَه بكثير»، وإلّا انجرفَ الحدُّ بواحدٍ
#      بلا أن يُكشَف — وقد وقع ذلك من قبلُ في سقفِ العمق.
#
# ⚠️ وطرفُ القبولِ يقيس **القيمةَ الناتجة** لا غيابَ الرميِ الموسوم: صيغةُ
#    `يرمي_موسوما(…) == خطأ` تُرجِع «صحيح» أيضًا لو **انهار** المسارُ انهيارًا
#    عاريًا، لأنّ الدالّةَ تسأل «أرُمِيَ خطأٌ موسوم؟» لا «أنجحَ التحليل؟».
#    فيُطبَع النصُّ المحلَّلُ نفسُه، والمسافةُ بين الحرفَين لا تخرج إلّا بنجاحٍ فعليّ.
اطبع_سطر(نص(يرمي_موسوما(نص_محاط("أ" + حرف_من_رمز(1) + "ب"))))
اطبع_سطر(نص(يرمي_موسوما(نص_محاط("أ" + حرف_من_رمز(اخر_محرف_تحكم) + "ب"))))
اطبع_سطر(حلل(نص_محاط("أ" + حرف_من_رمز(اول_محرف_قابل_للطباعة) + "ب")))

# ═══ السطرُ الجديدُ والجدولةُ والإرجاعُ خامّةً — أشيعُ ما يقع عمليًّا ═══
اطبع_سطر(نص(يرمي_موسوما(نص_محاط("أ\nب"))))
اطبع_سطر(نص(يرمي_موسوما(نص_محاط("أ\tب"))))
اطبع_سطر(نص(يرمي_موسوما(نص_محاط("أ\rب"))))

# ═══ الهروبُ الصحيحُ يبقى مقبولًا — الحارسُ يقيس الجهتَين ═══
# (AR) وإلّا سُدَّ الرميُ بتشديدٍ يبتلع الصحيحَ معه: المواصفةُ تردّ البايتَ الخامَّ
#      وتوجب قبولَ هروبِه، فالمردودُ شكلُ الكتابةِ لا المحرفُ نفسُه.
اطبع_سطر(نص(حلل(نص_محاط("أ\\nب")) == "أ\nب"))
اطبع_سطر(نص(حلل(نص_محاط("أ\\u0001ب")) == "أ" + حرف_من_رمز(1) + "ب"))

# ═══ ودورةٌ مغلقةٌ: ما يُولَّد يُقرَأ ═══
# (AR) التوليدُ يهرب محرفَ التحكّمِ، فمخرَجُه مدخلٌ صالحٌ لهذا المحلّلِ نفسِه —
#      وهذا هو الوجهُ الذي كان مكسورًا: الوحدةُ تقبل ما لا تُنتِج.
اطبع_سطر(ولد("أ" + حرف_من_رمز(1) + "ب"))

اطبع_سطر("=== انتهى ===")
