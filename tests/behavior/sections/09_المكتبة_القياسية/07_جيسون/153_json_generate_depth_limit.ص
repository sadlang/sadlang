# @description جيسون — سقفُ عمقِ التوليدِ مطابقٌ لسقفِ التحليل: قيمةٌ عميقةٌ مبنيّةٌ في ص كان المفسّرُ يرمي عليها خطأً عاريًا والمصرَّفُ يولّدها كاملةً — تباعدٌ صار عقدًا واحدًا
# @expected 400\nصحيح\nصحيح\n18\nصحيح\n[[1,2],[3]]\n=== انتهى ===
# @priority P0

استورد ولد، نسق، حلل من جيسون

ثابت وسم_الخطا = "جيسون: "
ثابت اقصى_عمق_مسموح = 200

دالة أي مصفوفة_بعمق(رقم عدد_المستويات)
    # (AR) المعاملُ عددُ **المستويات** لا عددُ اللفّات: المصفوفةُ الفارغةُ مستوًى
    #      بذاتها، فبناءُ ن مستوًى يلفُّها ن−١ مرّة. وسُمّيَ بما هو كي يُقرأ الحدُّ
    #      هنا بالعددِ نفسِه الذي يُقرأ به في ١٤٥ (٢٠٠ مقبولٌ و٢٠١ مردود) —
    #      واسمٌ يقول «العمق» ويحمل اللفّاتِ كان يُظهِر تباعدًا بواحدٍ لا وجودَ له
    #      بين الملفَّين، ويحتاج ثلاثةَ أسطرِ اعتذارٍ بدل كلمةٍ صحيحة.
    #
    # (AR) ومبنيّةٌ في ص لا مقروءةٌ بـ`حلل` — وهذا شرطُ الحالة: ما يمرّ بالتحليلِ
    #      يحرسه سقفُ التحليلِ أصلًا، فلا يبلغ التوليدَ عميقًا أبدًا.
    متغير القيمة = []
    متغير عداد = 1
    بينما (عداد < عدد_المستويات)
        القيمة = [القيمة]
        عداد = عداد + 1
    نهاية
    ارجع القيمة
نهاية

دالة منطقي يرمي_موسوما_عند_التوليد(رقم عدد_المستويات)
    حاول
        متغير الخرج = ولد(مصفوفة_بعمق(عدد_المستويات))
        # (AR) بلوغُ هذا السطرِ يعني أنّه لم يَرمِ.
        ارجع خطأ
    امسك الخطا
        ارجع نص(الخطا).يبدأ_بـ(وسم_الخطا)
    نهاية
نهاية

# ═══ الحدُّ بالضبط — الطرفان المتلاصقان ═══
# ⚠️ (AR) طرفُ القبولِ يقيس **النتيجةَ** لا غيابَ الرميِ الموسوم. والفرقُ ليس
#    تدقيقًا: `يرمي_موسوما_عند_التوليد(200) == خطأ` يُرجِع «صحيح» أيضًا لو
#    **انهار** المسارُ انهيارًا عاريًا، لأنّ الدالّةَ تسأل «أرُمِيَ خطأٌ موسوم؟».
#    وقد قِيس ذلك: على المكتبةِ قبلَ السقفِ — حيث يبلغ عمقُ ٩٠٠ حارسَ المحرّكِ
#    ويسقط — كانت هذه الصيغةُ تطبع «مقبول». فالحارسُ يمرّ والمسارُ منهار.
#    وطولُ ٢٠٠ مستوًى: قوسان لكلِّ مستوًى إلّا الأعمقَ ⇒ ٤٠٠ حرفًا.
اطبع_سطر(نص(طول(ولد(مصفوفة_بعمق(اقصى_عمق_مسموح)))))
اطبع_سطر(نص(يرمي_موسوما_عند_التوليد(اقصى_عمق_مسموح + 1)))

# ═══ العمقُ الذي كان يفترق فيه المحرّكان ═══
# (AR) عند ٩٠٠ كان المفسّرُ يبلغ حارسَ عمقِ النداءِ فيرمي «Sad runtime aborted…»
#      عاريةً بلا وسمٍ، والمصرَّفُ يولّد ١٨٠٢ حرفًا برمزِ خروجٍ ٠. مقيسٌ كلاهما.
اطبع_سطر(نص(يرمي_موسوما_عند_التوليد(900)))

# ═══ والتنسيقُ محروسٌ كالضغطِ — مسارانِ يُنسى أحدُهما ═══
دالة منطقي ينسق_موسوما(رقم عدد_المستويات)
    حاول
        متغير الخرج = نسق(مصفوفة_بعمق(عدد_المستويات))
        ارجع خطأ
    امسك الخطا
        ارجع نص(الخطا).يبدأ_بـ(وسم_الخطا)
    نهاية
نهاية

# (AR) والشاهدُ الموجبُ لـ`نسق` يقيس طولًا محسوبًا لا مجرّدَ عدمِ الرمي. وثلاثةُ
#      مستوياتٍ منسَّقةً تُخرِج خمسةَ أسطرٍ:
#          [ · ␣␣[ · ␣␣␣␣[] · ␣␣] · ]
#      أي ١ + ٣ + ٦ + ٣ + ١ حرفًا ومعها أربعةُ فواصلِ أسطرٍ = ١٨.
اطبع_سطر(نص(طول(نسق(مصفوفة_بعمق(3)))))
اطبع_سطر(نص(ينسق_موسوما(اقصى_عمق_مسموح + 1)))

# ═══ ودورةٌ مغلقةٌ عند عمقٍ معقولٍ — الحارسُ يقيس الجهتَين ═══
اطبع_سطر(ولد(حلل("[[1,2],[3]]")))

اطبع_سطر("=== انتهى ===")
