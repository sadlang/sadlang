# @description جيسون — سقفُ عمقِ التداخل: المدخلُ العميقُ يُردّ خطأً موسومًا يُلتقَط، لا ذعرًا يُسقِط البرنامج
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\n=== انتهى ===
# @priority P1

استورد حلل من جيسون

ثابت وسم_الخطا = "جيسون: "


ثابت نص_فارغ = ""

دالة نص كرر(نص الوحدة، رقم العدد)
    متغير المتراكم = نص_فارغ
    متغير عداد = 0
    بينما (عداد < العدد)
        المتراكم = المتراكم + الوحدة
        عداد = عداد + 1
    نهاية
    ارجع المتراكم
نهاية

دالة نص مصفوفة_متداخلة(رقم العمق)
    ارجع كرر("["، العمق) + كرر("]"، العمق)
نهاية

دالة منطقي يرمي_موسوما(نص المدخل)
    حاول
        متغير القيمة_المحللة = حلل(المدخل)
        ارجع نوع(القيمة_المحللة) == وسم_الخطا
    امسك الخطا
        ارجع نص(الخطا).يبدأ_بـ(وسم_الخطا)
    نهاية
نهاية

# ═══ الحدُّ بالضبط — لا «دونَه بكثيرٍ وفوقَه بكثير» ═══
# (AR) قفزةٌ من ١٥٠ إلى ٣٠٠ لا ترى الحدَّ، فينجرف بمقدارِ واحدٍ بلا أن يُكشَف:
#      وقد وقع ذلك فعلًا — كان `> ٢٠٠` يقبل ٢٠١ مستوًى والرسالةُ تقول ٢٠٠.
#      فيُقاس الطرفان المتلاصقان لا غير.
اطبع_سطر(نص(يرمي_موسوما(مصفوفة_متداخلة(200)) == خطأ))
اطبع_سطر(نص(يرمي_موسوما(مصفوفة_متداخلة(201))))

# ═══ ما دونَ السقفِ يُقبَل ═══
# (AR) شاهدٌ سالبٌ لازم: لولاه لمرّ الاختبارُ ولو كان السقفُ صفرًا فرُدَّ كلُّ مدخل.
اطبع_سطر(نص(يرمي_موسوما(مصفوفة_متداخلة(10)) == خطأ))
اطبع_سطر(نص(يرمي_موسوما(مصفوفة_متداخلة(150)) == خطأ))

# ═══ ما فوقَ السقفِ يُردّ خطأً موسومًا يُلتقَط ═══
# (AR) الحُكمُ هنا مزدوج: أنّه رمى، وأنّ `امسك` أمسكه فعلًا. فالذعرُ غيرُ القابلِ
#      للتعافي (RUN049) لا يُلتقَط أصلًا، فبلوغُ هذا السطرِ هو نفسُه البرهان.
اطبع_سطر(نص(يرمي_موسوما(مصفوفة_متداخلة(300))))
اطبع_سطر(نص(يرمي_موسوما(مصفوفة_متداخلة(5000))))

# ═══ والعمقُ يُحسَب للكائناتِ كما يُحسَب للمصفوفات ═══
اطبع_سطر(نص(يرمي_موسوما(كرر("{\"أ\":"، 300) + "1" + كرر("}"، 300))))

اطبع_سطر("=== انتهى ===")
