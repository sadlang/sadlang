# @description تحليلُ جيسون — المصفوفاتُ والكائناتُ والتداخلُ وتخطّي الفراغ
# @expected مصفوفة\n3\n1\n3\nمصفوفة\n0\nخريطة\nصحيح\n1\nخريطة\nمصفوفة\n2\nخريطة\n3\n=== انتهى ===
# @priority P1

استورد حلل من جيسون

# ── المصفوفة ──
متغير مصفوفة_بسيطة = حلل("[1,2,3]")
اطبع_سطر(نوع(مصفوفة_بسيطة))
اطبع_سطر(نص(طول(مصفوفة_بسيطة)))
اطبع_سطر(نص(مصفوفة_بسيطة[0]))
اطبع_سطر(نص(مصفوفة_بسيطة[2]))

# ── المصفوفةُ الفارغة ──
متغير مصفوفة_فارغة = حلل("[]")
اطبع_سطر(نوع(مصفوفة_فارغة))
اطبع_سطر(نص(طول(مصفوفة_فارغة)))

# ── الكائن ──
متغير كائن = حلل("{\"أ\": 1}")
اطبع_سطر(نوع(كائن))
اطبع_سطر(نص(كائن.يحتوي("أ")))
اطبع_سطر(نص(كائن.احصل("أ")))

# ── الكائنُ الفارغُ وتخطّي الفراغِ حولَ كلِّ رمز ──
اطبع_سطر(نوع(حلل("  {  }  ")))

# ── التداخل: مصفوفةٌ داخلَ كائنٍ داخلَ مصفوفة ──
متغير متداخل = حلل("[{\"ب\": [7, 8]}]")
اطبع_سطر(نوع(متداخل))
اطبع_سطر(نص(طول(متداخل[0].احصل("ب"))))

# ── الفراغُ بأنواعِه الأربعة: مسافةٌ وجدولةٌ وسطرٌ وإرجاع ──
متغير مع_فراغ = حلل("{\n\t\"ج\" : 3\r\n}")
اطبع_سطر(نوع(مع_فراغ))
اطبع_سطر(نص(مع_فراغ.احصل("ج")))

اطبع_سطر("=== انتهى ===")
