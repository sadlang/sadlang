# @description جيسون — التنسيقُ نسق() بإزاحةِ مسافتين، والدورةُ المغلقةُ حلل(ولد(س)) على البنى
# @expected [\n  1,\n  2\n]\n{\n  "أ": 1\n}\n[]\n{}\n[\n  [\n    1\n  ]\n]\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\n=== انتهى ===
# @priority P1

استورد حلل، ولد، نسق من جيسون

# ═══ التنسيق: إزاحةُ مسافتين، وسطرٌ لكلِّ عنصر ═══
اطبع_سطر(نسق([1، 2]))

متغير كائن = {}
كائن.عين("أ"، 1)
اطبع_سطر(نسق(كائن))

# (AR) الحاويةُ الفارغةُ لا تُنسَّق — لا سطرَ داخليًّا لها أصلًا
اطبع_سطر(نسق([]))
متغير كائن_فارغ = {}
اطبع_سطر(نسق(كائن_فارغ))

# (AR) التداخلُ يضاعف الإزاحةَ لا يُسطّحها
اطبع_سطر(نسق([[1]]))

# ═══ الدورةُ المغلقة: حلل(ولد(س)) == س ═══
# (AR) هذه هي الخاصّيّةُ الحاكمة: مولّدٌ ومحلّلٌ يتباعدان يُخفِقان هنا ولو
#      كان كلٌّ منهما «معقولًا» وحدَه.

متغير مصفوفة = [1، 2، 3]
اطبع_سطر(نص(ولد(حلل(ولد(مصفوفة))) == ولد(مصفوفة)))

متغير مختلط = [لاشيء، صحيح، خطأ، "س"، -7]
اطبع_سطر(نص(ولد(حلل(ولد(مختلط))) == ولد(مختلط)))

متغير متداخل = [[1، 2]، []]
اطبع_سطر(نص(ولد(حلل(ولد(متداخل))) == ولد(متداخل)))

# (AR) والدورةُ تصمد عبر المنسَّقِ أيضًا: التنسيقُ زينةٌ لا يغيّر المعنى
اطبع_سطر(نص(ولد(حلل(نسق(مصفوفة))) == ولد(مصفوفة)))
اطبع_سطر(نص(ولد(حلل(نسق(متداخل))) == ولد(متداخل)))

اطبع_سطر("=== انتهى ===")
