# @description جيسون — هروبُ المحارفِ الثمانيةُ القياسيّةُ تحليلًا وتوليدًا، ودورةٌ مغلقةٌ عليها
# @expected a"b\na\b\na/b\n3\n3\n3\n3\n"a\"b"\n"a\\b"\nصحيح\n"a\tb"\n"a\rb"\nصحيح\nصحيح\n=== انتهى ===
# @priority P1

استورد حلل، ولد من جيسون

# (AR) بناءُ المنتظَرِ من محارفِه — لا سلاسلَ حرفيّةً في موضعِ الحكم.
ثابت شرطة_خلفية = "\\"
ثابت اقتباس_مزدوج = "\""

# ═══ التحليل: الهروبُ يُفَكُّ إلى المحرفِ الذي يمثّله ═══

# (AR) المحارفُ المطبوعةُ تُقارَن نصًّا مباشرةً
اطبع_سطر(حلل("\"a\\\"b\""))
اطبع_سطر(حلل("\"a\\\\b\""))
اطبع_سطر(حلل("\"a\\/b\""))

# (AR) المحارفُ غيرُ المطبوعةِ تُقاس بالطولِ لا بالعرض: ثلاثةُ محارفَ يعني
#      أنّ الهروبَ ذا الحرفين صار محرفًا واحدًا فعلًا.
اطبع_سطر(نص(طول(حلل("\"a\\nb\""))))
اطبع_سطر(نص(طول(حلل("\"a\\tb\""))))
اطبع_سطر(نص(طول(حلل("\"a\\rb\""))))
اطبع_سطر(نص(طول(حلل("\"a\\bb\""))))

# ═══ التوليد: المحرفُ يُعاد إلى هروبِه ═══

اطبع_سطر(ولد("a\"b"))
اطبع_سطر(ولد("a\\b"))
# (AR) سطرُ السطرِ الجديدِ لا يُقارَن نصًّا مطبوعًا: ترويسةُ `@expected` تستعمل
#      `\n` فاصلًا لأسطرِها، فلا تستطيع التعبيرَ عن حمولةٍ فيها شرطةٌ خلفيّةٌ
#      يتبعها n — قيدُ أداةِ القياسِ لا قيدُ اللغة. فيُقاس هنا بمقارنةٍ تُطبَع
#      «صحيح»، وهي أقوى لا أضعف: تبني المنتظَرَ حرفًا حرفًا بدل الاتّكالِ على
#      ترويسةٍ لا تحتمله. والأخواتُ الثلاثُ (\\ و\t و\r) تبقى مقارنةً نصّيّةً
#      لأنّ الترويسةَ تحتملها.
اطبع_سطر(نص(ولد("a\nb") == اقتباس_مزدوج + "a" + شرطة_خلفية + "n" + "b" + اقتباس_مزدوج))
اطبع_سطر(ولد("a\tb"))
اطبع_سطر(ولد("a\rb"))

# ═══ الدورةُ المغلقة: حلل(ولد(س)) == س ═══
# (AR) هذه هي الخاصّيّةُ التي تُبطِل جدولَي الهروبِ المتباعدَين لو تباعدا.

متغير نص_فيه_كل_الهروب = "\"\\\n\t\r"
اطبع_سطر(نص(حلل(ولد(نص_فيه_كل_الهروب)) == نص_فيه_كل_الهروب))

متغير نص_عربي_فيه_هروب = "قوسٌ \" وشرطةٌ \\ وسطرٌ \n"
اطبع_سطر(نص(حلل(ولد(نص_عربي_فيه_هروب)) == نص_عربي_فيه_هروب))

اطبع_سطر("=== انتهى ===")
