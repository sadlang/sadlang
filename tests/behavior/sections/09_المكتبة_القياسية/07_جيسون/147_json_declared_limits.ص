# @description جيسون — القيودُ المُعلَنةُ في الترويسةِ مقيسةٌ لا مُدَّعاة: المفتاحُ المكرّرُ والترتيبُ، ومحرفُ التحكّمِ الخامُّ الذي كان قيدًا فصار مردودًا
# @expected 2\nصحيح\n3\nصحيح\nصحيح\nصحيح\n=== انتهى ===
# @priority P1

استورد حلل، ولد من جيسون


# ═══ المفتاحُ المكرّر: الأخيرُ يغلب ═══
# (AR) قرارٌ مُعلَنٌ في ترويسةِ الوحدة، فيُقاس هنا كي لا ينجرفَ صامتًا.
متغير مكرر = حلل("{\"أ\": 1, \"أ\": 2}")
اطبع_سطر(نص(مكرر.احصل("أ")))
اطبع_سطر(نص(طول(مكرر.مفاتيح()) == 1))

# ═══ الترتيبُ غيرُ مضمونٍ لكنّ المحتوى مضمون ═══
# (AR) لا نقارن نصَّ المخرَجِ حرفيًّا — فذلك يُثبّت ترتيبًا لم تَعِد به الوحدة.
#      نقارن ما وعدت به: أنّ كلَّ مفتاحٍ موجودٌ بقيمتِه بعد دورةٍ مغلقة.
متغير متعدد = حلل("{\"ب\": 1, \"ج\": 2, \"د\": 3}")
اطبع_سطر(نص(طول(متعدد.مفاتيح())))
متغير بعد_الدورة = حلل(ولد(متعدد))
اطبع_سطر(نص(بعد_الدورة.احصل("ب") == 1 و بعد_الدورة.احصل("ج") == 2 و بعد_الدورة.احصل("د") == 3))

# ═══ محرفُ التحكّمِ الخامُّ — قيدٌ مُعلَنٌ صار ضمانًا مُعلَنًا ═══
# (AR) هذا القسمُ تحرّك مرّتَين لأنّ ما تحتَه تحرّك مرّتَين:
#      ① كان يقيس أنّ هروبَ \u **مرفوض**، فصار مدعومًا (يقيسُه ١٤٩) فماتَ القياس.
#      ② فحلّ محلَّه قياسُ القيدِ الحيِّ حينَها: قبولُ محرفِ التحكّمِ الخامِّ
#         خلافًا للمواصفة. وقد سُدّ ذلك بدورِه، فصار التأكيدُ يزعم بقاءَ
#         قيدٍ زائل — فَـ**قُلِبَ ولم يُحذَف**، لأنّ ملفَّ «القيودِ المُعلَنة»
#         يوثّق ما تعدُ به الوحدةُ، والوعدُ وعدٌ أقُيِّدًا كان أم ضمانًا.
#
# (AR) والتفصيلُ في `152`: طرفا المدى المتلاصقان، والسطرُ والجدولةُ
#      والإرجاعُ، والهروبُ الصحيحُ شاهدًا سالبًا، والدورةُ المغلقة. فلا
#      يُعاد هنا إلّا **ما يخصُّ هذا الملفّ**: أنّ الوعدَ قائمٌ وأنّ مخرَجَ
#      التوليدِ يُقرَأ بالتحليل — فالوحدةُ تُنتِج ما تقبل وتقبل ما تُنتِج.
#
# ⚠️ والهروبُ يُرَكَّب حرفًا حرفًا ولا يُكتَب حرفيًّا: معجمُ لغةِ ص يفكُّ
#    `\u` **في مصدرِ ص نفسِه**، فالحرفيّةُ تُنتِج محرفَ التحكّمِ خامًّا
#    (طولُها ١ لا ٦) — أي المدخلَ **المرفوضَ** لا الهروبَ المقبول.
#    وهذا بعينِه ما أسقطَ هذا الملفَّ يومَ سُدّتِ الفجوةُ: كان يقرأ
#    خامًّا وهو يحسب أنّه يقرأ هروبًا، فمرّ ما دام الخامُّ مقبولًا.
ثابت علامة_اقتباس = "\""
ثابت وسم_الخطا = "جيسون: "
ثابت شرطة_خلفية = "\\"
ثابت لاحقة_هروب_التحكم = "u0001"
ثابت هروب_تحكم_متوقع = شرطة_خلفية + لاحقة_هروب_التحكم

دالة منطقي يرمي_موسوما(نص المدخل)
    حاول
        متغير القيمة_المحللة = حلل(المدخل)
        # (AR) بلوغُ هذا السطرِ يعني أنّه لم يَرمِ.
        ارجع خطأ
    امسك الخطا
        ارجع نص(الخطا).يبدأ_بـ(وسم_الخطا)
    نهاية
نهاية

متغير مدخل_مهروب = علامة_اقتباس + هروب_تحكم_متوقع + علامة_اقتباس
متغير محرف_التحكم = حلل(مدخل_مهروب)
متغير مدخل_خام = علامة_اقتباس + محرف_التحكم + علامة_اقتباس
اطبع_سطر(نص(يرمي_موسوما(مدخل_خام)))

# (AR) والدورةُ المغلقةُ: التوليدُ يهرب المحرفَ فيُخرِج مدخلًا
#      يقبلُه المحلّلُ نفسُه. ومدخلُ هذه الدورةِ **صالحٌ** لا فاسدٌ
#      — فالخامُّ يُرَدُّ في السطرِ الذي قبلَه — وكان مكتوبًا هنا
#      «وإن كان مدخلُها غيرَ صالح»، فبَطَل بالقلبِ أعلاه.
اطبع_سطر(نص(ولد(محرف_التحكم).يحتوي(هروب_تحكم_متوقع)))

اطبع_سطر("=== انتهى ===")
