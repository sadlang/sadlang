# @description جيسون — فكُّ هروبِ يونيكود وأزواجِ البدائل، وردُّ البديلِ اليتيمِ والخاناتِ غيرِ الست عشريّة
# @expected س\nA\né\nسلام\nصحيح\n😀\nأسب\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\n=== انتهى ===
# @priority P1

استورد حلل من جيسون

ثابت وسم_الخطا = "جيسون: "

ثابت متن_بديل_يتيم = "بديلُ يونيكود يتيمٌ"
ثابت متن_خانات_ناقصة = "هروبُ يونيكود يحتاج"

# (AR) الفحصُ على **المتنِ** لا على الوسمِ وحدَه. فحصُ الوسمِ يُثبِت أنّ الوحدةَ
#      رمت، ولا يفرّق بين «بديلٌ يتيم» و«خاناتٌ ناقصة» — ولو تبادلت الرسالتان
#      موضعَهما لبقي الاختبارُ أخضرَ. وهذا الاختبارُ هو الحارسُ الوحيدُ لهما.
دالة منطقي يرمي_بمتن(نص المدخل، نص المتن_المنتظر)
    حاول
        حلل(المدخل)
        ارجع خطأ
    امسك الخطا
        متغير الرسالة = نص(الخطا)
        ارجع الرسالة.يبدأ_بـ(وسم_الخطا) و الرسالة.يحتوي(المتن_المنتظر)
    نهاية
نهاية

# ═══ نقاطُ ترميزٍ داخلَ المستوى الأساسيّ ═══
# (AR) U+0633 «س» عربيّةٌ في بايتَين، وU+0041 «A» في بايتٍ واحد، وU+00E9 «é» في
#      بايتَين. اختلافُ الأطوالِ مقصودٌ: «حرف_من_رمز» كانت تقتطع نقطةَ الترميزِ
#      إلى بايتٍ واحد، فاختبارٌ يقتصر على ASCII كان يمرّ على العطبِ نفسِه.
اطبع_سطر(حلل("\"\\u0633\""))
اطبع_سطر(حلل("\"\\u0041\""))
اطبع_سطر(حلل("\"\\u00e9\""))
اطبع_سطر(حلل("\"\\u0633\\u0644\\u0627\\u0645\""))

# ═══ الخاناتُ الكبيرةُ والصغيرةُ سواء ═══
اطبع_سطر(نص(حلل("\"\\u00E9\"") == حلل("\"\\u00e9\"")))

# ═══ زوجُ البدائل — فوقَ المستوى الأساسيّ ═══
# (AR) U+D83D ثمّ U+DE00 يُكوِّنان U+1F600. لولا جمعُ الزوجِ لخرج بديلان يتيمان.
اطبع_سطر(حلل("\"\\uD83D\\uDE00\""))

# ═══ المزجُ مع نصٍّ عاديّ ═══
اطبع_سطر(حلل("\"أ\\u0633ب\""))

# ═══ ما يُردّ: بديلٌ يتيمٌ وخاناتٌ ناقصةٌ أو غيرُ ست عشريّة ═══
# (AR) البديلُ المفردُ ليس محرفًا؛ تمريرُه يُنتج UTF-8 فاسدًا يصمت هنا وينفجر
#      عند أوّلِ مستهلِكٍ لاحق. فيُردّ خطأً موسومًا.
اطبع_سطر(نص(يرمي_بمتن("\"\\uD83D\""، متن_بديل_يتيم)))
اطبع_سطر(نص(يرمي_بمتن("\"\\uDE00\""، متن_بديل_يتيم)))
اطبع_سطر(نص(يرمي_بمتن("\"\\uD83Dا\""، متن_بديل_يتيم)))
# (AR) بديلٌ عالٍ يتبعه هروبٌ **صالحٌ** ليس بديلًا منخفضًا — فرعٌ مستقلٌّ عن
#      «لا شرطةَ خلفيّةَ بعده»، ولولا هذا السطرِ لبقي بلا حارس.
اطبع_سطر(نص(يرمي_بمتن("\"\\uD83D\\u0041\""، متن_بديل_يتيم)))
اطبع_سطر(نص(يرمي_بمتن("\"\\u06\""، متن_خانات_ناقصة)))
اطبع_سطر(نص(يرمي_بمتن("\"\\u06ZZ\""، متن_خانات_ناقصة)))

# ═══ شاهدٌ سالبٌ لازم: الصالحُ لا يُردّ ═══
# (AR) لولاه لمرّ الاختبارُ ولو كان الفكُّ يرمي على كلِّ هروبِ يونيكود.
اطبع_سطر(نص(يرمي_بمتن("\"\\u0633\""، متن_بديل_يتيم) == خطأ))

اطبع_سطر("=== انتهى ===")
