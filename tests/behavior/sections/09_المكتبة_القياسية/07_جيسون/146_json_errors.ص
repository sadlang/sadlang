# @description جيسون — مسارُ الخطأ: كلُّ مدخلٍ فاسدٍ يرمي، والرسالةُ موسومةٌ بالوحدةِ وبموضعٍ رقميّ
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nخطأ\nخطأ\nخطأ\n=== انتهى ===
# @priority P1

استورد حلل من جيسون

ثابت وسم_الخطا = "جيسون: "
ثابت عبارة_عند_الموضع = " عند الموضع "

# (AR) الوسمُ جزءٌ من عقدِ الخطأِ المُعلَنِ لا نصُّ عرضٍ عابر، فيُفحَص لا يُتجاهَل:
#      خطأٌ بلا وسمٍ يعني أنّ رسالةً داخليّةً تسرّبت من مدمَجةٍ بدل خطأِ الوحدة.

دالة منطقي يرمي_موسوما(نص المدخل)
    # (AR) يعيد «صحيح» متى رُمي خطأٌ يحمل وسمَ الوحدةِ وكلمةَ الموضع.
    #      الفحصُ مزدوج: «رمى» وحدَها تمرّ على أيِّ خطأٍ ولو كان انهيارَ مدمَجة.
    حاول
        متغير القيمة_المحللة = حلل(المدخل)
        # (AR) لم يُرمَ شيءٌ ⇒ إخفاقُ التوقّع. والقيمةُ تُستهلَك في المقارنةِ كي لا
        #      تُترَك بلا استعمالٍ فيُنبَّه عليها، ولا تُطبَع فتُزاحم المخرَجَ المتوقَّع.
        ارجع نوع(القيمة_المحللة) == وسم_الخطا
    امسك الخطا
        متغير الرسالة = نص(الخطا)
        ارجع الرسالة.يبدأ_بـ(وسم_الخطا) و الرسالة.يحتوي(عبارة_عند_الموضع)
    نهاية
نهاية

# ═══ بنيةٌ مبتورة ═══
اطبع_سطر(نص(يرمي_موسوما("")))
اطبع_سطر(نص(يرمي_موسوما("[1,2")))
اطبع_سطر(نص(يرمي_موسوما("{\"أ\": 1")))
اطبع_سطر(نص(يرمي_موسوما("\"غيرُ مغلق")))

# ═══ فاصلٌ أو مفتاحٌ خاطئ ═══
اطبع_سطر(نص(يرمي_موسوما("[1 2]")))
اطبع_سطر(نص(يرمي_موسوما("{أ: 1}")))
اطبع_سطر(نص(يرمي_موسوما("{\"أ\" 1}")))

# ═══ أعدادٌ مخالفةٌ للمواصفة ═══
اطبع_سطر(نص(يرمي_موسوما("01")))
اطبع_سطر(نص(يرمي_موسوما("-")))
اطبع_سطر(نص(يرمي_موسوما("1.")))
اطبع_سطر(نص(يرمي_موسوما("1e")))

# ═══ زوائدُ بعد نهاية القيمة ═══
اطبع_سطر(نص(يرمي_موسوما("1 2")))

# ═══ هروبٌ غيرُ مدعوم ═══
اطبع_سطر(نص(يرمي_موسوما("\"a\\qb\"")))

# ═══ شواهدُ سالبةٌ — بها يُثبَت أنّ الفحصَ قادرٌ على الإخفاق ═══
# (AR) لولا هذه لكانت «صحيح» ثلاثَ عشرةَ مرّةً تمرّ ولو كان `يرمي_موسوما`
#      يُرجع «صحيح» دائمًا. المدخلُ الصالحُ يجب أن يُجيب «خطأ».
اطبع_سطر(نص(يرمي_موسوما("42")))
اطبع_سطر(نص(يرمي_موسوما("[1, 2]")))
اطبع_سطر(نص(يرمي_موسوما("{\"أ\": 1}")))

اطبع_سطر("=== انتهى ===")
