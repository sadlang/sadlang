# @expected: كبير\nصغير\n10\n0
# @priority: 1

متغير س = 100
متغير نتيجة = س > 50 ؟ "كبير" : "صغير"
اطبع_سطر(نتيجة)

متغير ص = 10
متغير نتيجة2 = ص > 50 ؟ "كبير" : "صغير"
اطبع_سطر(نتيجة2)

# ثلاثي مع أرقام
متغير أ = 10
متغير ب = 20
متغير الأكبر = أ > ب ؟ أ : ب
اطبع_سطر(الأكبر - 10)

# ثلاثي متداخل
متغير ج = 0
متغير حالة = ج > 0 ؟ "موجب" : (ج < 0 ؟ "سالب" : "صفر")
إذا (حالة == "صفر")
    اطبع_سطر(0)
