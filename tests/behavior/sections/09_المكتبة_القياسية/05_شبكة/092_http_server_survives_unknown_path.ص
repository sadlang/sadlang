# @description قنبلة عداد Winsock: المستمع يبقى حيا بعد طلب مسار مجهول ثم يخدم المعروف
# @expected خطأ\nحي_بعد_404\nتم
# @priority P1
# @timeout 120
استورد شبكة
متغير الخادم = أنشئ_خادم(0)
دالة معالج_حي()
    عين_نص_الرد("حي_بعد_404")
نهاية
دالة استمع_حي()
    ابدأ_الاستماع(الخادم، 18762)
نهاية
دالة اجلب_بمحاولات(رقم المتصفح، نص الرابط)
    # حلقة صمود إقلاع الخادم: الطلب المرفوض يعيد -1 فنمهل ونعيد
    متغير الرد = اجلب(المتصفح، الرابط)
    متغير محاولة = 0
    بينما (الرد < 0 و محاولة < 10)
        متغير مهلة_إمهال = قناة(1).استقبل_بمهلة(200)
        الرد = اجلب(المتصفح، الرابط)
        محاولة = محاولة + 1
    نهاية
    ارجع الرد
نهاية
عند_طلب_جلب(الخادم، "/alive"، "معالج_حي")
أطلق استمع_حي()
متغير مهلة_الإقلاع = قناة(1).استقبل_بمهلة(800)
متغير المتصفح_الأول = أنشئ_متصفح()
حدد_الانتظار(المتصفح_الأول، 3000)
متغير رد_المجهول = اجلب_بمحاولات(المتصفح_الأول، "http://127.0.0.1:18762/majhool")
اطبع_سطر(هل_الرد_ناجح(رد_المجهول))
تجاهل_الرد(رد_المجهول)
أغلق_متصفح(المتصفح_الأول)
متغير المتصفح_الثاني = أنشئ_متصفح()
حدد_الانتظار(المتصفح_الثاني، 3000)
متغير رد_الحي = اجلب_بمحاولات(المتصفح_الثاني، "http://127.0.0.1:18762/alive")
اطبع_سطر(نص_الرد(رد_الحي))
تجاهل_الرد(رد_الحي)
أغلق_متصفح(المتصفح_الثاني)
أوقف_الخادم(الخادم)
اطبع_سطر("تم")
