# @description مقبس_اتصال ثنائي الاتجاه — عميل وخادم في goroutines
# @expected صحيح\nصحيح\nصحيح
# @timeout 120
# @skip_compiler

استورد شبكات

متغير ق_منفذ = قناة(1)
متغير ق_رسالة = قناة(1)

أطلق
    متغير خادم = مقبس_اتصال()
    خادم.ربط(0)
    خادم.استمع(5)
    ق_منفذ.أرسل(خادم.المنفذ())
    خادم.حدد_مهلة_الاستقبال(5000)

    # ... الخادم سيستقبل طلب لكن لن يرد (حالة عدم ردّ)
    خادم.أغلق()
نهاية

متغير منفذ = ق_منفذ.استقبل()
اطبع_سطر(منفذ > 0)

# العميل
متغير عميل = مقبس_اتصال()
عميل.حدد_مهلة_الاستقبال(500)
عميل.حدد_مهلة_الإرسال(500)
اطبع_سطر(عميل.هل_صالح())
عميل.اتصل("127.0.0.1"، منفذ)
عميل.أغلق()

انتظر_الكل()
اطبع_سطر(ليس عميل.هل_صالح())
