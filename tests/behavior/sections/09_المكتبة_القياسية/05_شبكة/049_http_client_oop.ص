# @description اختبار صنف متصفح_ويب الكائني من مكتبة شبكات.ص
# @expected صحيح\nصحيح\nخطأ\nصحيح\nخطأ\nصحيح\nصحيح\nخطأ
# @skip_compiler

استورد شبكات

# ── إنشاء وإعداد ──────────────────────────────────────────────────
متغير م = متصفح_ويب()
اطبع_سطر(م.هل_صالح())             # صحيح

# إعداد لا يُلقي أخطاء
م.اضبط_الرابط("http://127.0.0.1:1")
م.اضبط_المهلة(200)
م.أضف_رأس("X-Test"، "قيمة-اختبار")
م.مصادقة("رمز-وهمي")
اطبع_سطر(م.هل_صالح())             # صحيح — الإعداد لا يُغلق العميل

# ── GET لمنفذ مغلق ─────────────────────────────────────────────
م.استرجع("/مسار")
اطبع_سطر(م.ناجح())                # خطأ — الاتصال فشل
اطبع_سطر(طول(م.وصف_الخطأ()) > 0) # صحيح — يوجد وصف للخطأ
م.أغلق()
اطبع_سطر(م.هل_صالح())             # خطأ

# ── اختبار POST/PUT/DELETE/PATCH — كلها تفشل على منفذ مغلق ───
متغير م2 = متصفح_ويب()
م2.اضبط_الرابط("http://127.0.0.1:1")
م2.اضبط_المهلة(200)
اطبع_سطر(م2.هل_صالح())            # صحيح
م2.أرسل_طلب("/بيانات"، "{}")
اطبع_سطر(ليس م2.ناجح())           # صحيح — POST فشل
م2.أرسل_تحديث("/مورد"، "{}")
م2.أحذف("/مورد")
م2.رقّع("/مورد"، "{}")
م2.أغلق()
اطبع_سطر(م2.هل_صالح())            # خطأ
