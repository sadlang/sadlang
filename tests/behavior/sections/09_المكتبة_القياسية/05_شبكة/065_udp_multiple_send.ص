# @description UDP — مرسل يُرسل 5 رسائل لنفس المستقبل
# @expected صحيح\nصحيح
# @timeout 120
# @skip_compiler

استورد مقابس

متغير ق_منفذ = قناة(1)

أطلق
    متغير مستقبل = أنشئ_مرسال()
    خصص_منفذ_رسائل(مستقبل، 0)
    ق_منفذ.أرسل(منفذ_محلي(مستقبل))
    حدد_انتظار_الاستقبال(مستقبل، 5000)

    متغير ع = 0
    بينما (ع < 5)
        استقبل_رسالة(مستقبل، 256)
        ع = ع + 1
    نهاية
    أغلق_مرسال(مستقبل)
نهاية

متغير منفذ = ق_منفذ.استقبل()
اطبع_سطر(منفذ > 0)

متغير مرسل = أنشئ_مرسال()
خصص_منفذ_رسائل(مرسل، 0)
متغير إ = 0
بينما (إ < 5)
    أرسل_رسالة(مرسل، "رسالة_" + نص(إ)، "127.0.0.1"، منفذ)
    إ = إ + 1
نهاية
أغلق_مرسال(مرسل)

انتظر_الكل()
اطبع_سطر(صحيح)
