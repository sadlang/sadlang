# @description قنبلة عداد Winsock (إجهاد): ثلاثة عملاء متتاليون يفتحون ويغلقون والمستمع صامد
# @expected ن1\nن2\nن3\nتم
# @priority P1
# @timeout 120
استورد شبكة
متغير خ = أنشئ_خادم(0)
دالة معالج_عد()
    عين_نص_الرد("ن")
نهاية
دالة استمع_عد()
    ابدأ_الاستماع(خ، 18766)
نهاية
عند_طلب_جلب(خ، "/n"، "معالج_عد")
أطلق استمع_عد()
متغير مهمل = قناة(1).استقبل_بمهلة(800)
لكل دور في [1، 2، 3]
    متغير م = أنشئ_متصفح()
    حدد_الانتظار(م، 3000)
    متغير ر = اجلب(م، "http://127.0.0.1:18766/n")
    اطبع_سطر(نص_الرد(ر) + نص(دور))
    تجاهل_الرد(ر)
    أغلق_متصفح(م)
نهاية
أوقف_الخادم(خ)
اطبع_سطر("تم")
