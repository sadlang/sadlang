# @description قنبلة عداد Winsock (إجهاد): ثلاثة عملاء متتاليون يفتحون ويغلقون والمستمع صامد
# @expected ن1\nن2\nن3\nتم
# @priority P1
# @timeout 120
استورد شبكة
متغير الخادم = أنشئ_خادم(0)
دالة معالج_عد()
    عين_نص_الرد("ن")
نهاية
دالة استمع_عد()
    ابدأ_الاستماع(الخادم، 18766)
نهاية
دالة اجلب_بمحاولات(رقم المتصفح، نص الرابط)
    # حلقة صمود إقلاع الخادم: الطلب المرفوض يعيد -1 فنمهل ونعيد
    متغير الرد = اجلب(المتصفح، الرابط)
    متغير محاولة = 0
    بينما (الرد < 0 و محاولة < 10)
        متغير مهلة_إمهال = قناة(1).استقبل_بمهلة(200)
        الرد = اجلب(المتصفح، الرابط)
        محاولة = محاولة + 1
    نهاية
    ارجع الرد
نهاية
عند_طلب_جلب(الخادم، "/n"، "معالج_عد")
أطلق استمع_عد()
متغير مهلة_الإقلاع = قناة(1).استقبل_بمهلة(800)
لكل دور في [1، 2، 3]
    متغير المتصفح = أنشئ_متصفح()
    حدد_الانتظار(المتصفح، 3000)
    متغير الرد = اجلب_بمحاولات(المتصفح، "http://127.0.0.1:18766/n")
    اطبع_سطر(نص_الرد(الرد) + نص(دور))
    تجاهل_الرد(الرد)
    أغلق_متصفح(المتصفح)
نهاية
أوقف_الخادم(الخادم)
اطبع_سطر("تم")
