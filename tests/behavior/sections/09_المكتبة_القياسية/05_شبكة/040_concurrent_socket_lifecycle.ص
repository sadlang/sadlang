# @expected صحيح
# @timeout 120
# @priority P2
# @skip_compiler

##
# اختبار إنشاء وإغلاق مقابس متوازية:
# - goroutine 1: ينشئ TCP → يربط → يستمع → يُغلق
# - goroutine 2: ينشئ TCP → يربط → يستمع → يُغلق
# - goroutine 3: ينشئ UDP → يربط → يُغلق
# - goroutine 4: ينشئ UDP → يربط → يُغلق
# - جمع النتائج والتحقق من أن جميعها نجحت
##

استورد مقابس

متغير نتائج = قناة(4)

# goroutine 1: TCP
أطلق
    متغير و = أنشئ_وصلة()
    خصص_منفذ(و، 0)
    متغير نجح = انتظر_اتصالات(و)
    نتائج.أرسل(نجح و منفذ_محلي(و) > 0)
    أغلق_وصلة(و)
نهاية

# goroutine 2: TCP آخر
أطلق
    متغير و = أنشئ_وصلة()
