    متغير نجح = انتظر_اتصالات(و)
    نتائج.أرسل(نجح و منفذ_محلي(و) > 0)
    أغلق_وصلة(و)
نهاية

# goroutine 3: UDP
أطلق
    متغير م = أنشئ_مرسال()
    متغير نجح = خصص_منفذ_رسائل(م، 0)
    نتائج.أرسل(نجح و منفذ_محلي(م) > 0)
    أغلق_مرسال(م)
نهاية

# goroutine 4: UDP آخر
أطلق
    متغير م = أنشئ_مرسال()
    متغير نجح = خصص_منفذ_رسائل(م، 0)
    نتائج.أرسل(نجح و منفذ_محلي(م) > 0)
    أغلق_مرسال(م)
نهاية

