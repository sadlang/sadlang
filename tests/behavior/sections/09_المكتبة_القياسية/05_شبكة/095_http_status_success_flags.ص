# @description ع-14: عين_حالة_الرد بالسياق الضمني — 201 ناجحة و404 المجهولة فاشلة
# @expected صحيح\nخطأ\nتم
# @priority P1
# @timeout 120
استورد شبكة
متغير الخادم = أنشئ_خادم(0)
دالة معالج_إنشاء()
    عين_حالة_الرد(201)
    عين_نص_الرد("أنشئ")
نهاية
دالة استمع_حالة()
    ابدأ_الاستماع(الخادم، 18765)
نهاية
دالة اجلب_بمحاولات(رقم المتصفح، نص الرابط)
    # حلقة صمود إقلاع الخادم: الطلب المرفوض يعيد -1 فنمهل ونعيد
    متغير الرد = اجلب(المتصفح، الرابط)
    متغير محاولة = 0
    بينما (الرد < 0 و محاولة < 10)
        متغير مهلة_إمهال = قناة(1).استقبل_بمهلة(200)
        الرد = اجلب(المتصفح، الرابط)
        محاولة = محاولة + 1
    نهاية
    ارجع الرد
نهاية
عند_طلب_جلب(الخادم، "/created"، "معالج_إنشاء")
أطلق استمع_حالة()
متغير مهلة_الإقلاع = قناة(1).استقبل_بمهلة(800)
متغير المتصفح = أنشئ_متصفح()
حدد_الانتظار(المتصفح، 3000)
متغير رد_الإنشاء = اجلب_بمحاولات(المتصفح، "http://127.0.0.1:18765/created")
اطبع_سطر(هل_الرد_ناجح(رد_الإنشاء))
متغير رد_المجهول = اجلب(المتصفح، "http://127.0.0.1:18765/none")
اطبع_سطر(هل_الرد_ناجح(رد_المجهول))
تجاهل_الرد(رد_الإنشاء)
تجاهل_الرد(رد_المجهول)
أغلق_متصفح(المتصفح)
أوقف_الخادم(الخادم)
اطبع_سطر("تم")
