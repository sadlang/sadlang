استورد شبكة
متغير خ = أنشئ_خادم(0)
دالة معالج_صدى_حدي()
    متغير الجسم = بيانات_الطلب()
    عين_نص_الرد("الصدى:" + الجسم)
نهاية
دالة استمع_صدى()
    ابدأ_الاستماع(خ، 18764)
نهاية
عند_طلب_إرسال(خ، "/echo"، "معالج_صدى_حدي")
أطلق استمع_صدى()
متغير مهمل = قناة(1).استقبل_بمهلة(800)
متغير م = أنشئ_متصفح()
حدد_الانتظار(م، 3000)
متغير ر = أرسل(م، "http://127.0.0.1:18764/echo"، "محتوى_حدي")
اطبع_سطر(نص_الرد(ر))
تجاهل_الرد(ر)
أغلق_متصفح(م)
أوقف_الخادم(خ)
اطبع_سطر("تم")
