# @description ع-14: معالج POST يقرأ جسم الطلب بالسياق الضمني ويرد صداه
# @expected الصدى:محتوى_حدي\nتم
# @priority P1
# @timeout 120
استورد شبكة
متغير الخادم = أنشئ_خادم(0)
دالة معالج_صدى_حدي()
    متغير الجسم = بيانات_الطلب()
    عين_نص_الرد("الصدى:" + الجسم)
نهاية
دالة استمع_صدى()
    ابدأ_الاستماع(الخادم، 18764)
نهاية
دالة أرسل_بمحاولات(رقم المتصفح، نص الرابط، نص المحتوى)
    # حلقة صمود إقلاع الخادم: الطلب المرفوض يعيد -1 فنمهل ونعيد
    متغير الرد = أرسل(المتصفح، الرابط، المحتوى)
    متغير محاولة = 0
    بينما (الرد < 0 و محاولة < 10)
        متغير مهلة_إمهال = قناة(1).استقبل_بمهلة(200)
        الرد = أرسل(المتصفح، الرابط، المحتوى)
        محاولة = محاولة + 1
    نهاية
    ارجع الرد
نهاية
عند_طلب_إرسال(الخادم، "/echo"، "معالج_صدى_حدي")
أطلق استمع_صدى()
متغير مهلة_الإقلاع = قناة(1).استقبل_بمهلة(800)
متغير المتصفح = أنشئ_متصفح()
حدد_الانتظار(المتصفح، 3000)
متغير الرد = أرسل_بمحاولات(المتصفح، "http://127.0.0.1:18764/echo"، "محتوى_حدي")
اطبع_سطر(نص_الرد(الرد))
تجاهل_الرد(الرد)
أغلق_متصفح(المتصفح)
أوقف_الخادم(الخادم)
اطبع_سطر("تم")
