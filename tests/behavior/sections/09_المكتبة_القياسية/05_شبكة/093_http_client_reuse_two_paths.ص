استورد شبكة
متغير خ = أنشئ_خادم(0)
دالة معالج_أول()
    عين_نص_الرد("أول_مسار")
نهاية
دالة معالج_ثان()
    عين_نص_الرد("ثاني_مسار")
نهاية
دالة استمع_مسارين()
    ابدأ_الاستماع(خ، 18763)
نهاية
عند_طلب_جلب(خ، "/a"، "معالج_أول")
