# @description ع-11: العميل المعاد استخدامه يعيد رد المسار الثاني لا رد الأول المخبوء
# @expected أول_مسار\nثاني_مسار\nتم
# @priority P1
# @timeout 120
استورد شبكة
متغير الخادم = أنشئ_خادم(0)
دالة معالج_أول()
    عين_نص_الرد("أول_مسار")
نهاية
دالة معالج_ثان()
    عين_نص_الرد("ثاني_مسار")
نهاية
دالة استمع_مسارين()
    ابدأ_الاستماع(الخادم، 18763)
نهاية
دالة اجلب_بمحاولات(رقم المتصفح، نص الرابط)
    # حلقة صمود إقلاع الخادم: الطلب المرفوض يعيد -1 فنمهل ونعيد
    متغير الرد = اجلب(المتصفح، الرابط)
    متغير محاولة = 0
    بينما (الرد < 0 و محاولة < 10)
        متغير مهلة_إمهال = قناة(1).استقبل_بمهلة(200)
        الرد = اجلب(المتصفح، الرابط)
        محاولة = محاولة + 1
    نهاية
    ارجع الرد
نهاية
عند_طلب_جلب(الخادم، "/a"، "معالج_أول")
عند_طلب_جلب(الخادم، "/b"، "معالج_ثان")
أطلق استمع_مسارين()
متغير مهلة_الإقلاع = قناة(1).استقبل_بمهلة(800)
متغير المتصفح = أنشئ_متصفح()
حدد_الانتظار(المتصفح، 3000)
متغير الرد_الأول = اجلب_بمحاولات(المتصفح، "http://127.0.0.1:18763/a")
اطبع_سطر(نص_الرد(الرد_الأول))
متغير الرد_الثاني = اجلب(المتصفح، "http://127.0.0.1:18763/b")
اطبع_سطر(نص_الرد(الرد_الثاني))
تجاهل_الرد(الرد_الأول)
تجاهل_الرد(الرد_الثاني)
أغلق_متصفح(المتصفح)
أوقف_الخادم(الخادم)
اطبع_سطر("تم")
