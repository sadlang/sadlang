# @description خط أنابيب TCP: مُنتج → خادم وسيط → مستهلك عبر goroutines
# @expected صحيح\nصحيح\nصحيح
# @timeout 120
# @priority P2
# @skip_compiler

##
# اختبار خط أنابيب TCP من 3 مراحل:
# المرحلة 1 (المُنتج): يُرسل بيانات إلى خادم TCP
# المرحلة 2 (الخادم الوسيط): يستقبل ويُضيف بادئة ويُرسل للمستهلك
# المرحلة 3 (المستهلك): يستقبل ويُرجع النتيجة النهائية
##

استورد مقابس

متغير ق_منفذ_1 = قناة(1)   # منفذ الخادم الوسيط
متغير ق_منفذ_2 = قناة(1)   # منفذ خادم المستهلك
متغير ق_نتيجة = قناة(1)    # النتيجة النهائية

# ── المستهلك (goroutine 1) ─────────────────────────────────────
أطلق
    متغير خ_م = أنشئ_وصلة()
    خصص_منفذ(خ_م، 0)
    انتظر_اتصالات(خ_م)
    ق_منفذ_2.أرسل(منفذ_محلي(خ_م))

    حدد_انتظار_الاستقبال(خ_م، 10000)
    متغير ع = اقبل_متصل(خ_م)
    متغير نتيجة = ""
    إذا (ع > 0)
        حدد_انتظار_الاستقبال(ع، 5000)
        نتيجة = استقبل_عبر_وصلة(ع، 64)
        أغلق_وصلة(ع)
    نهاية
    أغلق_وصلة(خ_م)
    ق_نتيجة.أرسل(نتيجة)
نهاية

# ── الخادم الوسيط (goroutine 2) ───────────────────────────────
أطلق
    متغير خ_و = أنشئ_وصلة()
    خصص_منفذ(خ_و، 0)
    انتظر_اتصالات(خ_و)
    ق_منفذ_1.أرسل(منفذ_محلي(خ_و))

    # انتظار المنفذ_2 قبل القبول
    متغير م2 = ق_منفذ_2.استقبل()

    حدد_انتظار_الاستقبال(خ_و، 10000)
    متغير ع = اقبل_متصل(خ_و)
    إذا (ع > 0)
        حدد_انتظار_الاستقبال(ع، 5000)
        متغير بيانات = استقبل_عبر_وصلة(ع، 32)

        # تحويل البيانات وإرسالها للمستهلك
        متغير وصلة_خروج = أنشئ_وصلة()
        إذا (اتصل_بـ(وصلة_خروج، "127.0.0.1"، م2))
            أرسل_عبر_وصلة(وصلة_خروج، "وسيط:" + بيانات)
        نهاية
        أغلق_وصلة(وصلة_خروج)
        أغلق_وصلة(ع)
    نهاية
    أغلق_وصلة(خ_و)
نهاية

# ── المُنتج ─────────────────────────────────────────────────────
متغير م1 = ق_منفذ_1.استقبل()
اطبع_سطر(م1 > 0)

متغير و = أنشئ_وصلة()
متغير نجح = اتصل_بـ(و، "127.0.0.1"، م1)
اطبع_سطر(نجح)
إذا (نجح)
    أرسل_عبر_وصلة(و، "مدخل")
نهاية
أغلق_وصلة(و)

انتظر_الكل()

متغير نتيجة = ق_نتيجة.استقبل()
اطبع_سطر(نتيجة == "وسيط:مدخل")
