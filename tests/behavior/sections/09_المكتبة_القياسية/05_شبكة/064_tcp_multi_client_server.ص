# @description خادم TCP يستقبل 3 عملاء متتاليين عبر goroutine
# @expected صحيح\nعميل_1\nعميل_2\nعميل_3
# @timeout 120
# @skip_compiler

استورد مقابس

متغير ق_منفذ = قناة(1)
متغير ق_رسائل = قناة(3)

أطلق
    متغير خادم = أنشئ_وصلة()
    خصص_منفذ(خادم، 0)
    انتظر_اتصالات(خادم)
    ق_منفذ.أرسل(منفذ_محلي(خادم))

    متغير ع = 0
    بينما (ع < 3)
        حدد_انتظار_الاستقبال(خادم، 5000)
        متغير متصل = اقبل_متصل(خادم)
        إذا (متصل > 0)
            حدد_انتظار_الاستقبال(متصل، 3000)
            متغير رسالة = استقبل_عبر_وصلة(متصل، 256)
            ق_رسائل.أرسل(رسالة)
            أغلق_وصلة(متصل)
        نهاية
        ع = ع + 1
    نهاية
    أغلق_وصلة(خادم)
نهاية

متغير منفذ = ق_منفذ.استقبل()
اطبع_سطر(منفذ > 0)

متغير عداد = 1
بينما (عداد <= 3)
    متغير ع = أنشئ_وصلة()
    اتصل_بـ(ع، "127.0.0.1"، منفذ)
    أرسل_عبر_وصلة(ع، "عميل_" + نص(عداد))
    أغلق_وصلة(ع)
    عداد = عداد + 1
نهاية

اطبع_سطر(ق_رسائل.استقبل())
اطبع_سطر(ق_رسائل.استقبل())
اطبع_سطر(ق_رسائل.استقبل())

انتظر_الكل()
