# @description فحص تفصيلي لكائن الاستجابة: حالة + نص + ترويسة + نجاح
# @timeout 120

##
# اختبار فحص استجابة HTTP المفصل:
# - إرسال طلب GET إلى رابط غير قابل للوصول
# - فحص كائن الاستجابة المُرجع
# - التحقق من رمز الحالة (0 أو < 0 عند الفشل)
# - التحقق من سبب الخطأ في العميل
# - استخدام تجاهل_الرد لتحرير الذاكرة
##

استورد شبكة

متغير م = أنشئ_متصفح()
حدد_الانتظار(م، 200)

# الطلب الأول: GET إلى رابط غير موجود
متغير ر1 = اجلب(م، "http://127.0.0.1:9/check")

# يجب أن يُرجع اجلب() رقماً (معرّف الاستجابة أو -1)
اطبع_سطر(ر1 >= -1)

# فحص حالة العميل: يجب أن يفشل
اطبع_سطر(ليس هل_نجح(م))
متغير سبب = سبب_الفشل(م)
اطبع_سطر(طول(سبب) > 0)

# الطلب الثاني: POST فاشل
متغير ر2 = أرسل(م، "http://127.0.0.1:9/save"، "data=test")
اطبع_سطر(ر2 >= -1)

# تنظيف
اطبع_سطر(أغلق_متصفح(م))
