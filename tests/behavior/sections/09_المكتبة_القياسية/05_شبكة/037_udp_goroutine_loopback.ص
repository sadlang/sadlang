# @description UDP loopback: مُستقبل goroutine + مُرسل — ربط + إرسال + استقبال
# @expected صحيح\nصحيح\nصحيح\nخطأ
# @timeout 120
# @priority P2
# @skip_compiler

##
# اختبار UDP loopback عبر goroutines:
# 1. المستقبل: يربط بمنفذ مؤقت → يُشير للمرسل بالمنفذ → يستقبل رسالة
# 2. المرسل: ينتظر المنفذ → يُرسل "رسالة-UDP" → يُغلق
# 3. التحقق: النص المستقبل يطابق المرسل
##

استورد مقابس

متغير ق_منفذ = قناة(1)
متغير ق_رسالة = قناة(1)

# ── المستقبل (goroutine) ────────────────────────────────────────
أطلق
    متغير مستقبل = أنشئ_مرسال()
    خصص_منفذ_رسائل(مستقبل، 0)

    # إشعار المرسل بالمنفذ
    ق_منفذ.أرسل(منفذ_محلي(مستقبل))

    # استقبال الرسالة مع مهلة
    حدد_انتظار_الاستقبال(مستقبل، 5000)
    متغير نص = استقبل_رسالة(مستقبل، 64)
    أغلق_مرسال(مستقبل)
    ق_رسالة.أرسل(نص)
نهاية

# ── المرسل ─────────────────────────────────────────────────────
متغير منفذ_المستقبل = ق_منفذ.استقبل()
اطبع_سطر(منفذ_المستقبل > 0)

متغير مرسل = أنشئ_مرسال()
اطبع_سطر(مرسل > 0)
متغير مُرسل = أرسل_رسالة(مرسل، "رسالة-UDP"، "127.0.0.1"، منفذ_المستقبل)
اطبع_سطر(مُرسل > 0)
أغلق_مرسال(مرسل)

انتظر_الكل()

متغير نص_مستقبل = ق_رسالة.استقبل()
اطبع_سطر(نص_مستقبل == "رسالة-UDP")
