# @description اختبار صنف وصلة_آمنة (HTTPS/TLS) من مكتبة شبكات.ص
# @expected صحيح\n127.0.0.1\nصحيح\nصحيح\nخطأ\nصحيح\napi.example.com\nصحيح\nخطأ
# @skip_compiler

استورد شبكات

# ── إنشاء وصلة HTTPS لمنفذ مغلق (لاختبار الفشل الآمن) ─────────────
متغير وصلة = وصلة_آمنة("127.0.0.1"، 1)
اطبع_سطر(وصلة.هل_صالح())              # صحيح — الكائن مُنشأ
اطبع_سطر(وصلة.مضيف())                 # 127.0.0.1
وصلة.اضبط_المهلة(200)
وصلة.استرجع("/test")
اطبع_سطر(ليس وصلة.ناجح())             # صحيح — فشل (منفذ مغلق)
اطبع_سطر(طول(وصلة.وصف_الخطأ()) > 0)  # صحيح — يوجد وصف للخطأ
وصلة.أغلق()
اطبع_سطر(وصلة.هل_صالح())              # خطأ — بعد الإغلاق

# ── وصلة بمنفذ 443 الافتراضي (الاسم فقط بدون منفذ صريح) ──────────
متغير وصلة2 = وصلة_آمنة("api.example.com")
اطبع_سطر(وصلة2.هل_صالح())             # صحيح
اطبع_سطر(وصلة2.مضيف())                # api.example.com
وصلة2.اضبط_المهلة(100)
وصلة2.استرجع("/")
اطبع_سطر(ليس وصلة2.ناجح())            # صحيح — لا اتصال إنترنت في الاختبار
وصلة2.أغلق()
اطبع_سطر(وصلة2.هل_صالح())             # خطأ
