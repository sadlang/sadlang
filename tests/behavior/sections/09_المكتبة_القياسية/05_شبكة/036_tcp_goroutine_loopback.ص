# @description TCP loopback كامل: خادم goroutine + عميل — اتصال + إرسال + استقبال
# @expected صحيح\nصحيح\nصحيح
# @timeout 120
# @priority P2
# @skip_compiler

##
# اختبار TCP loopback حقيقي عبر goroutines:
# 1. الخادم: يربط بمنفذ مؤقت → يستمع → يُشير للعميل → يقبل الاتصال → يستقبل البيانات
# 2. العميل: ينتظر إشارة الجاهزية → يتصل → يُرسل "مرحبا" → يُغلق
# 3. التحقق: البيانات المستقبلة == البيانات المُرسلة
##

استورد مقابس

متغير ق_منفذ = قناة(1)    # قناة لإرسال المنفذ من الخادم للعميل
متغير ق_بيانات = قناة(1)   # قناة لإرسال البيانات المستقبلة

# ── الخادم (goroutine) ─────────────────────────────────────────
أطلق
    متغير خادم = أنشئ_وصلة()
    خصص_منفذ(خادم، 0)
    انتظر_اتصالات(خادم)

    # إرسال المنفذ للعميل
    متغير م = منفذ_محلي(خادم)
    ق_منفذ.أرسل(م)

    # قبول الاتصال مع مهلة
    حدد_انتظار_الاستقبال(خادم، 5000)
    متغير عميل = اقبل_متصل(خادم)
    متغير مستقبل = ""
    إذا (عميل > 0)
        حدد_انتظار_الاستقبال(عميل، 2000)
        مستقبل = استقبل_عبر_وصلة(عميل، 32)
        أغلق_وصلة(عميل)
    نهاية
    أغلق_وصلة(خادم)
    ق_بيانات.أرسل(مستقبل)
نهاية

# ── العميل ──────────────────────────────────────────────────────
# انتظار المنفذ من الخادم
متغير منفذ_الخادم = ق_منفذ.استقبل()
اطبع_سطر(منفذ_الخادم > 0)

# الاتصال وإرسال البيانات
متغير وصلة = أنشئ_وصلة()
متغير اتصال_نجح = اتصل_بـ(وصلة، "127.0.0.1"، منفذ_الخادم)
اطبع_سطر(اتصال_نجح)
إذا (اتصال_نجح)
    أرسل_عبر_وصلة(وصلة، "مرحبا")
نهاية
أغلق_وصلة(وصلة)

انتظر_الكل()

# التحقق من البيانات المستقبلة
متغير مستقبل = ق_بيانات.استقبل()
اطبع_سطر(مستقبل == "مرحبا")
