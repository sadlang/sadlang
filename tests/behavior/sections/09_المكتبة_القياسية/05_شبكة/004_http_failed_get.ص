# @description فشل GET محلي يجب أن يكون متطابقاً بين المفسر والمترجم
# @timeout 120
# @expected خطأ\nخطأ\nصحيح

استورد شبكة

متغير م = أنشئ_متصفح()
حدد_الانتظار(م، 200)
متغير ر = اجلب(م، "http://127.0.0.1:9/غير_موجود")
اطبع_سطر(هل_نجح(م))
اطبع_سطر(ر == -1)
اطبع_سطر(طول(سبب_الفشل(م)) > 0)
أغلق_متصفح(م)
