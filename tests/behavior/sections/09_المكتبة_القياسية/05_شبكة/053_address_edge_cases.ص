# @description حالات حدية للعناوين — منافذ خاصة، IPs حدية
# (AR) ⚠️ كانت أسطرُ المتوقَّعِ الخمسةُ الباقيةُ مكتوبةً شيفرةً حرّةً تحتَ التوجيه لا داخلَه،
#      فلم يكن يُفحَصُ منها إلّا السطرُ الأوّل. أُعيدت إلى التوجيه، فظهرَ العيبُ
#      الحقيقيُّ الذي كانت تحجبه: `رقم_المنفذ` يُرجِعُ عشريًّا في المفسّرِ
#      (`0.0`) وصحيحًا في المصرَّف (`0`) — و`network_utils.yaml:110` لا يُصرّحُ
#      نوعَ إرجاعٍ أصلًا، فلا مصدرَ حقيقةٍ يحسمُ بينهما. 🚧 دَينٌ معلَن.
# @expected 0.0\n1.0\n65535.0\nصحيح\nصحيح\nصحيح

استورد شبكة

# منفذ 0 مسموح (اختيار تلقائي لاحقاً)
متغير ع1 = عنوان("127.0.0.1"، 0)
اطبع_سطر(رقم_المنفذ(ع1))
حرر_عنوان(ع1)

# منفذ 1 (أصغر منفذ صالح)
متغير ع2 = عنوان("127.0.0.1"، 1)
اطبع_سطر(رقم_المنفذ(ع2))
حرر_عنوان(ع2)

# منفذ 65535 (أقصى منفذ)
متغير ع3 = عنوان("127.0.0.1"، 65535)
اطبع_سطر(رقم_المنفذ(ع3))
حرر_عنوان(ع3)

# العنوان الشبكي 0.0.0.0 (استماع على جميع الواجهات)
متغير ع4 = عنوان("0.0.0.0"، 8080)
اطبع_سطر(ع4 > 0)
حرر_عنوان(ع4)

# broadcast address
متغير ع5 = عنوان("255.255.255.255"، 9000)
اطبع_سطر(ع5 > 0)
حرر_عنوان(ع5)

# multicast address
متغير ع6 = عنوان("224.0.0.1"، 5353)
اطبع_سطر(ع6 > 0)
حرر_عنوان(ع6)
