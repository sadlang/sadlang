# @description سلسلة كاملة لخيارات مقبس TCP: مهلة استقبال + مهلة إرسال + بدون تأخير + منفذ محلي
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح

##
# اختبار شامل لجميع خيارات مقبس TCP المدعومة:
# - إنشاء المقبس وربطه بمنفذ مؤقت (0)
# - الاستماع للاتصالات
# - الحصول على المنفذ المحلي الفعلي
# - ضبط مهلة الاستقبال ومهلة الإرسال
# - تفعيل/تعطيل خيار no-delay
# - تغيير المهل والتحقق من قبولها
# - الإغلاق النظيف
##

استورد مقابس

متغير و = أنشئ_وصلة()
اطبع_سطر(و > 0)

# ربط بمنفذ مؤقت (0 = يختار النظام منفذاً حراً)
اطبع_سطر(خصص_منفذ(و، 0))

# الاستماع للاتصالات
اطبع_سطر(انتظر_اتصالات(و))

# الحصول على المنفذ المحلي الفعلي والتحقق أنه في النطاق الصحيح
متغير م = منفذ_محلي(و)
اطبع_سطر(م > 0)
اطبع_سطر(م < 65536)

# ضبط مهلة الاستقبال (500 مللي ثانية)
اطبع_سطر(حدد_انتظار_الاستقبال(و، 500))

# ضبط مهلة الإرسال (500 مللي ثانية)
اطبع_سطر(حدد_انتظار_الإرسال(و، 500))

# تفعيل خيار TCP no-delay (تعطيل خوارزمية Nagle)
اطبع_سطر(أرسل_فوراً(و، صحيح))

# إغلاق المقبس
اطبع_سطر(أغلق_وصلة(و))
