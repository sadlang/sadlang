# @description صNet — سطحُ التشفيرِ والأمان: بصمةٌ ثابتةُ الطول، وعشوائيٌّ بطولٍ مطلوب
# @expected 64\n16\nصحيح\n0.0\nخطأ\nصحيح
# @skip_compiler
# @priority P1

# (AR) 🔑 `بايتات_عشوائية` كانت تُنادي `random_bytes(n)` والعقدُ الحاليُّ
#      `bool random_bytes(uint8_t*, size_t)` — يملأُ مخزنًا ويُرجعُ نجاحَه.
#      فكانت الذراعُ تكرِّرُ على `bool` كأنّه متّجه. والمقيسُ ههنا **الطولُ**:
#      ثمانيةُ بايتاتٍ ⇐ ستّةَ عشرَ محرفَ hex، لا العشوائيّةُ نفسُها (لا تُقاسُ
#      ببذرةٍ حتميّة).
# (EN) Crypto/security surface: fixed-width digest, requested random width.

استورد شبكة_لامركزية

# (AR) SHA-256 ⇐ ٣٢ بايتًا ⇐ ٦٤ محرفَ hex، مهما طالَ الدخل.
اطبع_سطر(طول(تشفير_sha256("مرحبا")))

اطبع_سطر(طول(بايتات_عشوائية(8)))

متغير عقدة = عقدة_جديدة()
اطبع_سطر(إثبات_عمل(عقدة))

# (AR) سمعةُ قرينٍ لم يُتعامَلْ معه: صفر — لا «لاشيء».
متغير أنا = معرف_العقدة(عقدة)
اطبع_سطر(سمعة_قرين(عقدة، أنا))

# (AR) وليس موثوقًا قبل شهادةٍ.
اطبع_سطر(قرين_موثوق(عقدة، أنا))

اطبع_سطر(حظر_قرين(عقدة، أنا))

تدمير_عقدة(عقدة)
