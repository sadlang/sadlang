# @description ثلاثة عملاء HTTP بإعدادات مختلفة — goroutines متوازية + جمع النتائج
# @timeout 120

##
# اختبار إنشاء عدة عملاء HTTP بإعدادات مختلفة عبر goroutines:
# - كل goroutine ينشئ عميل HTTP مستقل
# - كل عميل يُضبط بانتظار مختلف وترويسات مختلفة
# - كل عميل يُرسل طلب GET فاشل ويسجل الحالة
# - جمع النتائج عبر قناة
# - التحقق من أن جميع العملاء فشلوا (لا يوجد خادم)
##

استورد شبكة

متغير نتائج = قناة(3)

# goroutine 1: عميل مع مهلة 100ms
أطلق
    متغير م1 = أنشئ_متصفح()
    حدد_الانتظار(م1، 100)
    أضف_ترويسة(م1، "X-Client"، "1")
    اجلب(م1، "http://127.0.0.1:9/api")
    نتائج.أرسل(ليس هل_نجح(م1))
    أغلق_متصفح(م1)
نهاية

# goroutine 2: عميل مع مهلة 150ms
أطلق
    متغير م2 = أنشئ_متصفح()
    حدد_الانتظار(م2، 150)
    أضف_ترويسة(م2، "X-Client"، "2")
    أرسل(م2، "http://127.0.0.1:9/data"، "{\"key\":\"value\"}")
    نتائج.أرسل(ليس هل_نجح(م2))
    أغلق_متصفح(م2)
نهاية

# goroutine 3: عميل مع رمز تفويض
أطلق
    متغير م3 = أنشئ_متصفح()
    حدد_الانتظار(م3، 200)
    سجل_دخول_برمز(م3، "bearer-xyz")
    اجلب(م3، "http://127.0.0.1:9/secure")
    نتائج.أرسل(ليس هل_نجح(م3))
    أغلق_متصفح(م3)
نهاية

انتظر_الكل()

# جمع النتائج والتحقق: جميع الطلبات يجب أن تفشل (لا يوجد خادم)
متغير فشل1 = نتائج.استقبل()
متغير فشل2 = نتائج.استقبل()
متغير فشل3 = نتائج.استقبل()

اطبع_سطر(فشل1)
اطبع_سطر(فشل2)
اطبع_سطر(فشل3)
اطبع_سطر(فشل1 و فشل2 و فشل3)
