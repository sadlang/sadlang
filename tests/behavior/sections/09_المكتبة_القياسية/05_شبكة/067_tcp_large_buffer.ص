# @description TCP — معالجة بيانات كبيرة نسبياً (1KB)
# @expected صحيح\nصحيح\nصحيح
# @timeout 120
# @skip_compiler

استورد مقابس

متغير ق_منفذ = قناة(1)
متغير ق_طول = قناة(1)

أطلق
    متغير خادم = أنشئ_وصلة()
    خصص_منفذ(خادم، 0)
    انتظر_اتصالات(خادم)
    ق_منفذ.أرسل(منفذ_محلي(خادم))
    حدد_انتظار_الاستقبال(خادم، 5000)

    متغير عميل = اقبل_متصل(خادم)
    إذا (عميل > 0)
        حدد_انتظار_الاستقبال(عميل، 3000)
        متغير بيانات = استقبل_عبر_وصلة(عميل، 2048)
        ق_طول.أرسل(طول(بيانات))
        أغلق_وصلة(عميل)
    نهاية
    أغلق_وصلة(خادم)
نهاية

متغير منفذ = ق_منفذ.استقبل()
اطبع_سطر(منفذ > 0)

# بناء نص بطول 512 حرفاً (أصغر لسرعة الاختبار)
متغير كبير = ""
متغير ع = 0
بينما (ع < 512)
    كبير = كبير + "X"
    ع = ع + 1
نهاية

متغير وصلة = أنشئ_وصلة()
اتصل_بـ(وصلة، "127.0.0.1"، منفذ)
أرسل_عبر_وصلة(وصلة، كبير)
أغلق_وصلة(وصلة)

متغير طول_مستلم = ق_طول.استقبل()
اطبع_سطر(طول_مستلم > 0)
اطبع_سطر(طول_مستلم == 512)

انتظر_الكل()
