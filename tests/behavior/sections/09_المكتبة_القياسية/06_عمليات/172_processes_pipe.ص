# @description انبوب — ربط مخرج عمليّة بمدخل أخرى ببرنامج ص (ب٣+ب٤): «echo | tr»، والقارئ يرى نهاية الملفّ فلا يتعلّق
# @expected: 0\n0\nمرحبا-يا-عالم\nتم
# @priority P1
# @posix_only

# ============================================================
# ما يقيسه: **الأنبوب من فعل ص**. وهو الفرق الجوهريّ عن نفذ_امر: هناك
# كانت «|» محرفًا في سلسلةٍ تؤوّله /bin/sh؛ هنا تُنشئ ص الأنبوب وتوجّه
# طرفيه إلى ابنَين مختلفَين.
#
# وهذا الاختبار يقيس ضمنًا التزامًا لا يظهر إلّا بفشله: **CLOEXEC**. لو
# تسرّب طرفُ الكتابة إلى الابن الثاني (tr) لبقي مفتوحًا بعد خروج الأوّل،
# فلا يرى tr نهايةَ ملفّ ويتعلّق إلى الأبد — والاختبار ينتهي بمهلةٍ لا
# بفشلٍ مقروء. ولذلك يُنشآن بـpipe2(O_CLOEXEC) ذرّيًّا.
#
# ولذلك أيضًا يُغلق الأب طرفيه **قبل** الانتظار: الأب نفسه حائزٌ لطرف
# الكتابة، وإبقاؤه مفتوحًا يُنتج نفس التعلّق بلا أيّ تسريبٍ إلى ابن.
#
# ويُوجَّه مخرج القارئ إلى ملفّ لا إلى مخرج الاختبار: لو تشاركا المجرى
# لصار ترتيبُ السطور رهنَ لحظة إفراغ المخزن — اختبارٌ يمرّ ويسقط بالتناوب.
# ============================================================
استورد عمليات
استورد أساسيات

متغير ناتج = "/tmp/ص_انبوب_اختبار.txt"
متغير و = افتح_وصفا(ناتج, "كتابة")

متغير أ = انبوب()

# الكاتب: مخرجه (1) إلى طرف الكتابة
متغير كاتب = شغل_برنامجا("/bin/sh", ["-c", "echo مرحبا يا عالم"], { "1": أ["كتابة"] })
# القارئ: مدخله (0) من طرف القراءة، ومخرجه (1) إلى الملفّ
متغير قارئ = شغل_برنامجا("/bin/sh", ["-c", "tr ' ' '-'"], { "0": أ["قراءة"], "1": و })

# إغلاق الطرفين في الأب — شرط رؤية القارئ نهايةَ الملفّ
اغلق(أ["كتابة"])
اغلق(أ["قراءة"])

اطبع_سطر(انتظر_عملية(كاتب))
اطبع_سطر(انتظر_عملية(قارئ))

اغلق(و)
اطبع(اقرأ_ملف(ناتج))

اطبع_سطر("تم")
