# @description ويندوز: شغل_برنامجا + انتظر_عملية — نظيرُ ١٧٠ بـcmd.exe: رمزُ خروجٍ حقيقيٌّ منفصلٌ بلا صدَفةٍ وسيطًا
# @expected: 0\n3\n42\nتم
# @priority P1
# @windows_only

# ============================================================
# نظيرُ 170_processes_spawn_wait.ص على ويندوز. المقيسُ واحد: أنّ رمزَ الخروجِ
# **حقيقيٌّ ومنفصل** — وهو ما تعجزُ عنه نفذ_امر لأنّها تُرجعُ رمزَ الصدَفةِ
# الوسيطةِ لا رمزَ البرنامج.
#
# ولماذا ملفٌّ منفصلٌ لا وسمُ منصّةٍ في ١٧٠: ما يفترقُ **البرنامجُ المُشغَّل**
# لا المفهوم. و`cmd` هنا هدفٌ مُشغَّلٌ لا وسيطٌ مفروض — تمامًا كما أنّ `sh`
# في ١٧٠ هدفٌ لا وسيط. الفرقُ كلُّ الفرق: `شغل_برنامجا` أنشأته بـCreateProcess
# مباشرةً، والتوجيهُ لو وُجد لكان من فعلِ ص لا من فعلِ cmd.
#
# ويقيسُ ضمنًا اقتباسَ الوسائط: `exit 3` وسيطٌ **واحد** فيه فراغ. لو بُني سطرُ
# الأوامرِ بلا اقتباسٍ لانقسم وسيطين، فتلقّى cmd الأمرَ `exit` وحدَه وخرج بصفر
# — «نجاحٌ» ورقمٌ خاطئٌ في اليد، لا فشلٌ يُرى.
# ============================================================
استورد عمليات

# 1. خروج ناجح — الرمز 0
متغير م١ = شغل_برنامجا("cmd", ["/c", "exit 0"])
اطبع_سطر(انتظر_عملية(م١))

# 2. رمز خروج غير صفريّ يصل كما هو (لا يُبتلَع ولا يُحوَّل إلى 1)
متغير م٢ = شغل_برنامجا("cmd", ["/c", "exit 3"])
اطبع_سطر(انتظر_عملية(م٢))

# 3. رمز خروج كبير — يُقرأ من GetExitCodeProcess لا يُخترع
متغير م٣ = شغل_برنامجا("cmd", ["/c", "exit 42"])
اطبع_سطر(انتظر_عملية(م٣))

اطبع_سطر("تم")
