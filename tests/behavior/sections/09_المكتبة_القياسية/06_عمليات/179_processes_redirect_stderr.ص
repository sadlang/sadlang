# @description تطابق: توجيهُ مجرى الخطأ (2) ثمّ خلطُ المخرج والخطأ في وصفٍ واحد — نظير «2>ملفّ» و«>ملفّ 2>&1»
# @expected: 0\nخطا\n0\nمخرج\nخطا\nتم
# @priority P1
# @posix_only

# ============================================================
# ما يقيسه: أنّ خريطةَ التوجيهِ تُطبَّقُ على المجاري الثلاثةِ لا على
# المخرجِ وحدَه، وأنّ **وصفًا واحدًا في مفتاحين** يعملُ في المحرّكين معًا.
#
# ولماذا يهمُّ في المصرِّفِ خاصّةً: خريطةُ ص غيرُ مرتّبة، وحلقةُ `dup2`
# في الابنِ تُنفَّذُ بترتيبِ الخاناتِ ٠ ثمّ ١ ثمّ ٢ لا بترتيبِ ورودِ
# المفاتيح. فلو بنى المصرِّفُ الحلقةَ على ترتيبِ الخريطةِ لاختلفَ الناتجُ
# بين المحرّكين — وهو خلافٌ لا يظهرُ إلّا حين يُمرَّرُ الوصفُ مرّتين.
#
# وهو أيضًا حدُّ الوحدةِ المعلَن: «‏2>&1» المجرّدةُ (الخطأُ يتبعُ مخرجَ
# الأبِ) غيرُ قابلةٍ للتعبير — المعبَّرُ عنه هنا «>و 2>&1» وحدَها.
# ============================================================
استورد عمليات
استورد أساسيات

متغير مسار = "/tmp/ص_خطا_اختبار.txt"

# 1. مجرى الخطأ وحدَه — نظير «2>ملفّ»: المخرجُ لا يُلمَس
متغير و١ = افتح_وصفا(مسار, "كتابة")
متغير م١ = شغل_برنامجا("/bin/sh", ["-c", "echo خطا 1>&2"], { "2": و١ })
اطبع_سطر(انتظر_عملية(م١))
اغلق(و١)
اطبع(اقرأ_ملف(مسار))

# 2. المخرجُ والخطأُ إلى وصفٍ واحد — نظير «>ملفّ 2>&1»
متغير و٢ = افتح_وصفا(مسار, "كتابة")
متغير م٢ = شغل_برنامجا("/bin/sh", ["-c", "echo مخرج; echo خطا 1>&2"], { "1": و٢, "2": و٢ })
اطبع_سطر(انتظر_عملية(م٢))
اغلق(و٢)
اطبع(اقرأ_ملف(مسار))

اطبع_سطر("تم")
