# @description افتح_وصفا + توجيه المخرج إلى ملفّ ثمّ الإلحاق — نظير «>» و«>>» منفَّذًا بـص لا بـsh (ب٥ + خريطة التوجيه)
# @expected: 0\nاول\n0\nاول\nثان\nتم
# @priority P1
# @posix_only

# ============================================================
# ما يقيسه: أنّ إعادة التوجيه صارت **من فعل ص** لا من فعل الصدَفة. في
# نفذ_امر كانت «>» سلسلةً تُمرَّر إلى /bin/sh فتنفّذها sh — صدَفةٌ فوق
# صدَفة. هنا يُفتح الوصف بـافتح_وصفا ويُمرَّر خريطةً {1: وصف}، فيتولّى
# الرنتايم dup2 في الابن بين fork وexec.
#
# ولماذا لا يُكشف dup2 نفسه: كشفُه يُحمّل المستخدم إغلاقَ الوصف في الابن،
# وهو أشيع خطأ وصفاتٍ على الإطلاق (درس Tcl/Perl العكسيّ في المقترح).
#
# ويقيس أنّ «كتابة» تقتطع و«إلحاق» لا تقتطع — الفرق بين > و>>؛ لو تساويا
# لضاع أوّل سطرٍ صامتًا وهو أسوأ من فشلٍ صريح.
# ============================================================
استورد عمليات
استورد أساسيات

متغير مسار = "/tmp/ص_توجيه_اختبار.txt"

# 1. «كتابة» — نظير >: تُنشئ الملفّ أو تقتطعه
متغير و١ = افتح_وصفا(مسار, "كتابة")
متغير م١ = شغل_برنامجا("/bin/sh", ["-c", "echo اول"], { "1": و١ })
اطبع_سطر(انتظر_عملية(م١))
اغلق(و١)
اطبع(اقرأ_ملف(مسار))

# 2. «إلحاق» — نظير >>: تكتب في الآخر ولا تقتطع
متغير و٢ = افتح_وصفا(مسار, "إلحاق")
متغير م٢ = شغل_برنامجا("/bin/sh", ["-c", "echo ثان"], { "1": و٢ })
اطبع_سطر(انتظر_عملية(م٢))
اغلق(و٢)
اطبع(اقرأ_ملف(مسار))

اطبع_سطر("تم")
