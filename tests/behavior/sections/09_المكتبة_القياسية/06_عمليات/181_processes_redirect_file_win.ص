# @description ويندوز: افتح_وصفا + توجيه المخرج إلى ملفّ ثمّ الإلحاق — نظيرُ ١٧١ بـSTARTUPINFO لا بـdup2
# @expected: 0\nawal\n0\nawal\nthani\nتم
# @priority P1
# @windows_only

# ============================================================
# نظيرُ 171_processes_redirect_file.ص. المقيسُ واحد: أنّ إعادةَ التوجيهِ صارت
# **من فعلِ ص** لا من فعلِ الصدَفة. وطريقُه هنا مختلفٌ تمامًا: لا لحظةَ وسطى
# بين شوكةٍ وتنفيذ، بل مقبضٌ يُنسَخُ نسخةً موروثةً ويُمرَّرُ في `STARTUPINFO`
# قبل الإنشاء.
#
# وهذا بعينه ما كان يُحتجُّ به لرفضِ ويندوز: «لا لحظةَ وسطى فلا توجيه». والحجّةُ
# كانت صحيحةً عن `_spawnvp` وحدَها. فالاختبارُ هنا **إثباتُ أنّ الحجّةَ سقطت**.
#
# ويقيسُ أنّ «كتابة» تقتطعُ و«إلحاق» لا تقتطع — الفرقُ بين > و>>؛ لو تساويا
# لضاع أوّلُ سطرٍ صامتًا وهو أسوأ من فشلٍ صريح.
#
# ولماذا المكتوبُ لاتينيٌّ لا عربيّ: `echo` في cmd يكتبُ بترميزِ صفحةِ وحدةِ
# التحكّمِ لا بـUTF-8، فالعربيُّ يصلُ الملفَّ مشوَّهًا. والتشويهُ عيبٌ في cmd
# لا في التوجيه، فإقحامُه هنا كان سيجعلَ الاختبارَ يقيسُ صفحةَ ترميزٍ ويُسمّي
# ذلك «توجيهًا». والمقيسُ **أنّ البايتاتِ بلغت الملفَّ**، لا أيُّ بايتاتٍ هي.
# ============================================================
استورد عمليات
استورد أساسيات

متغير مسار = "redirect_win.txt"

# 1. «كتابة» — نظير >: تُنشئ الملفّ أو تقتطعه
متغير و١ = افتح_وصفا(مسار, "كتابة")
متغير م١ = شغل_برنامجا("cmd", ["/c", "echo awal"], { "1": و١ })
اطبع_سطر(انتظر_عملية(م١))
اغلق(و١)
اطبع(اقرأ_ملف(مسار))

# 2. «إلحاق» — نظير >>: تكتب في الآخر ولا تقتطع
متغير و٢ = افتح_وصفا(مسار, "إلحاق")
متغير م٢ = شغل_برنامجا("cmd", ["/c", "echo thani"], { "1": و٢ })
اطبع_سطر(انتظر_عملية(م٢))
اغلق(و٢)
اطبع(اقرأ_ملف(مسار))

اطبع_سطر("تم")
