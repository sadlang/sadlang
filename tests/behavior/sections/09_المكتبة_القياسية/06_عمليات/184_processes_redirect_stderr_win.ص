# @description ويندوز: توجيهُ مجرى الخطأ (2) ثمّ خلطُ المخرجِ والخطأِ في وصفٍ واحد — نظيرُ «2>ملفّ» و«>ملفّ 2>&1»
# @expected: 0\nkhata\n0\nmakhraj\nkhata\nتم
# @priority P1
# @windows_only

# ============================================================
# نظيرُ 179_processes_redirect_stderr.ص. المقيسُ واحد: أنّ خريطةَ التوجيهِ
# تُطبَّقُ على المجاري الثلاثةِ لا على المخرجِ وحدَه، وأنّ **وصفًا واحدًا في
# مفتاحين** يعملُ في المحرّكين معًا.
#
# ولماذا يهمُّ على ويندوز خاصّةً: الوصفُ الواحدُ في مفتاحين يعني **نسختين
# موروثتين** من نفسِ المقبض، كلتاهما مِلكُنا وكلتاهما يجبُ أن تُغلَقَ بعد
# الإنشاء. ولو أُغلقت إحداهما وحدَها لتسرّبت الأخرى وصفةً كلَّ تشغيل — وفي
# حلقةِ صدَفةٍ استنزافٌ مؤكَّد لا يظهرُ إلّا بالعدّ.
#
# وهو أيضًا حدُّ الوحدةِ المعلَن: «‏2>&1» المجرّدةُ (الخطأُ يتبعُ مخرجَ الأبِ)
# غيرُ قابلةٍ للتعبير — المعبَّرُ عنه هنا «>و 2>&1» وحدَها.
# ============================================================
استورد عمليات
استورد أساسيات

متغير مسار = "stderr_win.txt"

# 1. مجرى الخطأ وحدَه — نظير «2>ملفّ»: المخرجُ لا يُلمَس
متغير و١ = افتح_وصفا(مسار, "كتابة")
متغير م١ = شغل_برنامجا("cmd", ["/c", "echo khata 1>&2"], { "2": و١ })
اطبع_سطر(انتظر_عملية(م١))
اغلق(و١)
اطبع(اقرأ_ملف(مسار))

# 2. المخرجُ والخطأُ إلى وصفٍ واحد — نظير «>ملفّ 2>&1»
متغير و٢ = افتح_وصفا(مسار, "كتابة")
متغير م٢ = شغل_برنامجا("cmd", ["/c", "echo makhraj & echo khata 1>&2"], { "1": و٢, "2": و٢ })
اطبع_سطر(انتظر_عملية(م٢))
اغلق(و٢)
اطبع(اقرأ_ملف(مسار))


# (AR) تنظيفٌ صريح: مشغّلُ الاختباراتِ يعزلُ مجلّدَ عملٍ لكلِّ تشغيلةٍ ويمسحُه،
#      فلا يُلوَّثُ الجذرُ من CI. أمّا التشغيلُ اليدويُّ من جذرِ المستودعِ —
#      وهو كيف يُطوَّرُ هذا الملفُّ أصلًا — فلا عزلَ فيه، وقد ترك ستّةَ آثارٍ
#      في الجذرِ من ١٥ آب بلا صاحب. والاسمُ المجرّدُ هنا مقصودٌ: نظيرُه
#      البوسيكسيُّ يكتبُ في `/tmp` ولا نظيرَ لها هنا — `متغير_بيئة` مُعلَنةٌ
#      `stable` **ولا يُصرِّفُها المترجمُ** (قيس ١٩ آب)، فالحذفُ هو السدّ.
# (EN) Explicit cleanup: the runner isolates a per-run work dir, so CI never
#      pollutes. A manual run from the repo root does — it left six orphans.
# ⚠️ (AR) التنظيفُ مشروطٌ بالوجود، ولسببٍ مقيسٍ لا احتياطًا: `احذف_ملف` في
#      المفسّرِ تنادي `std::filesystem::remove` **الرامية**، وترمي كذلك حين
#      يغيبُ الملفّ (وبرمزٍ مضلِّلٍ: «وسائط ناقصة»). أمّا المترجمُ فيُخفِّضها
#      إلى `remove()` سِيِّ ونتيجتُه مُهمَلة — **فلا يُخفِقُ أبدًا**. فمسارُ
#      الإخفاقِ غيرُ متناظرٍ بين المحرّكَين: رِجْلُ المفسّرِ تموت ورِجْلُ المترجمِ
#      تمرّ ⇒ `FAIL_PARITY` **من صنعِ سطرِ التنظيفِ نفسِه** لا من المقيس.
# ⚠️ (EN) Guarded on purpose: the interpreter's delete calls the throwing
#      filesystem::remove (and throws on a missing file too), while the
#      compiler lowers it to C remove() with the result discarded and never
#      fails — an asymmetry that would manufacture a parity failure.
إذا (هل_موجود(مسار))
    احذف_ملف(مسار)
نهاية

اطبع_سطر("تم")
