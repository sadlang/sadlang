# @description ويندوز: انبوب — ربطُ مخرجِ عمليّةٍ بمدخلِ أخرى ببرنامجِ ص، والقارئُ يرى نهايةَ الملفّ فلا يتعلّق
# @expected: 0\n0\nsalam\nتم
# @priority P1
# @windows_only
# @timeout 30

# ============================================================
# نظيرُ 172_processes_pipe.ص. المقيسُ واحد: **الأنبوبُ من فعلِ ص** لا محرفٌ
# في سلسلةٍ تؤوّله صدَفة.
#
# وهو يقيسُ ضمنًا التزامًا لا يظهرُ إلّا بفشله: **عدمُ التوريث**. لو ورث الابنُ
# الثاني طرفَ الكتابةِ لبقي مفتوحًا بعد خروجِ الأوّل، فلا يرى القارئُ نهايةَ
# ملفٍّ ويتعلّقُ إلى الأبد — والاختبارُ ينتهي بمهلةٍ لا بفشلٍ مقروء.
#
# ونظيرُ CLOEXEC هنا `_O_NOINHERIT` على طرفَي الأنبوب، والتوريثُ **انتقائيٌّ**
# بنسخةٍ موروثةٍ تُصنَعُ للمُوجَّهِ وحدَه وتُغلَقُ فورَ الإنشاء. فالالتزامُ واحدٌ
# والوسيلةُ مختلفة، والاختبارُ يقيسُ الالتزامَ لا الوسيلة.
#
# ولذلك أيضًا يُغلقُ الأبُ طرفيه **قبل** الانتظار: الأبُ نفسُه حائزٌ لطرفِ
# الكتابة، وإبقاؤه مفتوحًا يُنتجُ نفسَ التعلّقِ بلا أيِّ تسريبٍ إلى ابن.
# ============================================================
استورد عمليات
استورد أساسيات

متغير ناتج = "pipe_win.txt"
متغير و = افتح_وصفا(ناتج, "كتابة")

متغير أ = انبوب()

# الكاتب: مخرجه (1) إلى طرف الكتابة
متغير كاتب = شغل_برنامجا("cmd", ["/c", "echo salam"], { "1": أ["كتابة"] })
# القارئ: مدخله (0) من طرف القراءة، ومخرجه (1) إلى الملفّ
متغير قارئ = شغل_برنامجا("sort", [], { "0": أ["قراءة"], "1": و })

# إغلاق الطرفين في الأب — شرط رؤية القارئ نهايةَ الملفّ
اغلق(أ["كتابة"])
اغلق(أ["قراءة"])

اطبع_سطر(انتظر_عملية(كاتب))
اطبع_سطر(انتظر_عملية(قارئ))

اغلق(و)
اطبع(اقرأ_ملف(ناتج))


# (AR) تنظيفٌ صريح: مشغّلُ الاختباراتِ يعزلُ مجلّدَ عملٍ لكلِّ تشغيلةٍ ويمسحُه،
#      فلا يُلوَّثُ الجذرُ من CI. أمّا التشغيلُ اليدويُّ من جذرِ المستودعِ —
#      وهو كيف يُطوَّرُ هذا الملفُّ أصلًا — فلا عزلَ فيه، وقد ترك ستّةَ آثارٍ
#      في الجذرِ من ١٥ آب بلا صاحب. والاسمُ المجرّدُ هنا مقصودٌ: نظيرُه
#      البوسيكسيُّ يكتبُ في `/tmp` ولا نظيرَ لها هنا — `متغير_بيئة` مُعلَنةٌ
#      `stable` **ولا يُصرِّفُها المترجمُ** (قيس ١٩ آب)، فالحذفُ هو السدّ.
# (EN) Explicit cleanup: the runner isolates a per-run work dir, so CI never
#      pollutes. A manual run from the repo root does — it left six orphans.
# ⚠️ (AR) التنظيفُ مشروطٌ بالوجود، ولسببٍ مقيسٍ لا احتياطًا: `احذف_ملف` في
#      المفسّرِ تنادي `std::filesystem::remove` **الرامية**، وترمي كذلك حين
#      يغيبُ الملفّ (وبرمزٍ مضلِّلٍ: «وسائط ناقصة»). أمّا المترجمُ فيُخفِّضها
#      إلى `remove()` سِيِّ ونتيجتُه مُهمَلة — **فلا يُخفِقُ أبدًا**. فمسارُ
#      الإخفاقِ غيرُ متناظرٍ بين المحرّكَين: رِجْلُ المفسّرِ تموت ورِجْلُ المترجمِ
#      تمرّ ⇒ `FAIL_PARITY` **من صنعِ سطرِ التنظيفِ نفسِه** لا من المقيس.
# ⚠️ (EN) Guarded on purpose: the interpreter's delete calls the throwing
#      filesystem::remove (and throws on a missing file too), while the
#      compiler lowers it to C remove() with the result discarded and never
#      fails — an asymmetry that would manufacture a parity failure.
إذا (هل_موجود(ناتج))
    احذف_ملف(ناتج)
نهاية

اطبع_سطر("تم")
