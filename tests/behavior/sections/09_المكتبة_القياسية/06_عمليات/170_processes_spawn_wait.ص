# @description شغل_برنامجا + انتظر_عملية — تشغيل برنامج خارجيّ بلا /bin/sh وسيطًا، ورمز خروجٍ حقيقيّ منفصل (ب١+ب٢ من RFC بدائيّات العمليّات)
# @expected: 0\n3\n42\nتم
# @priority P1
# @posix_only

# ============================================================
# ما يقيسه هذا الاختبار: أنّ رمز الخروج **حقيقيّ ومنفصل** — وهو ما تعجز
# عنه نفذ_امر (‏system()) لأنّها تُرجع رمز /bin/sh لا رمز البرنامج، ولا
# تعطي مقبضًا أصلًا. بلا رمزِ خروجٍ صحيح لا توجد «&&» ولا «||» في صدَفة.
#
# لماذا /bin/sh -c "exit N" وليس برنامجًا أبسط: نحتاج رموز خروجٍ مختارة
# بدقّة، وهي أثبت وسيلةٍ محمولة لتوليدها. لاحظ أنّ sh هنا **هدفٌ مُشغَّل**
# لا وسيطٌ مفروض — الفرق كلّ الفرق: شغل_برنامجا نفّذته بـexecvp مباشرةً.
# ============================================================
استورد عمليات

# 1. خروج ناجح — الرمز 0
متغير م١ = شغل_برنامجا("/bin/sh", ["-c", "exit 0"])
اطبع_سطر(انتظر_عملية(م١))

# 2. رمز خروج غير صفريّ يصل كما هو (لا يُبتلَع ولا يُحوَّل إلى 1)
متغير م٢ = شغل_برنامجا("/bin/sh", ["-c", "exit 3"])
اطبع_سطر(انتظر_عملية(م٢))

# 3. رمز خروج كبير — يُفكّ بـWEXITSTATUS لا يُقرأ خامًّا من status
متغير م٣ = شغل_برنامجا("/bin/sh", ["-c", "exit 42"])
اطبع_سطر(انتظر_عملية(م٣))

اطبع_سطر("تم")
