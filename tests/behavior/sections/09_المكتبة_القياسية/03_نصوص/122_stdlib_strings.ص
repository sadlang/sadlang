# @description اختبار دوال معالجة النصوص — استبدل، تحويل_كبير، تحويل_صغير، طول_نص، قص_أطراف
# @expected مرحبا ص\nHELLO WORLD\nhello world\n5\nمرحبا
# @priority P1

# ============================================================
# دوال معالجة النصوص من وحدة نصوص
# ============================================================
استورد نصوص

# 1. استبدال نص
اطبع_سطر(استبدل("مرحبا عالم"، "عالم"، "ص"))

# 2. تحويل لأحرف كبيرة
اطبع_سطر(تحويل_كبير("hello world"))

# 3. تحويل لأحرف صغيرة
اطبع_سطر(تحويل_صغير("HELLO WORLD"))

# 4. طول النص
اطبع_سطر(طول_نص("مرحبا"))

# 5. قص الأطراف (إزالة المسافات)
اطبع_سطر(قص_أطراف("  مرحبا  "))
