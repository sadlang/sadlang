# @description: اختبار بحث واستخراج نصوص UTF-8 عربية
# @expected: 6\nمرحبا\n-1\n0\nهوز\nح\n6\nworld
# @priority: P1

استورد نصوص

# بحث في نص عربي — يجب إرجاع فهرس الحرف وليس البايت
اطبع_سطر(بحث("مرحبا عالم"، "عالم"))

# استخراج 5 حروف عربية من البداية
اطبع_سطر(استخراج("مرحبا عالم"، 0، 5))

# بحث عن نص غير موجود
اطبع_سطر(بحث("مرحبا"، "xyz"))

# بحث في البداية
اطبع_سطر(بحث("مرحبا عالم"، "مرحبا"))

# استخراج من المنتصف
اطبع_سطر(استخراج("أبجد هوز"، 5، 3))

# استخراج حرف واحد
اطبع_سطر(استخراج("مرحبا"، 2، 1))

# بحث واستخراج ASCII
اطبع_سطر(بحث("hello world"، "world"))
اطبع_سطر(استخراج("hello world"، 6، 5))
