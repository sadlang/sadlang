# @description: تقسيم بفاصل UTF-8 عربيّ + فراغات محفوظة + maxSplits + فاصل فارغ
# @expected: 3\nواحد\nاثنان\nثلاثة\n3\n3\nc,d,e\n3\nأ\nج\n3\nس\nع
# @priority: P1
#
# حارس انحدار لإصلاح «تقسيم»: كان يستعمل strtok البايتيّ فيُهشّم الفاصل العربيّ
# «،» (0xD8 0x8C) بايتيًّا ويطوي الأجزاء الفارغة. الآن دلالة سلسلة فرعيّة مطابِقة
# للمفسّر (تنفيذ مزدوج: مترجم == مفسّر).

استورد نصوص

# 1) فاصل عربيّ متعدّد البايتات «،»
متغير أ = تقسيم("واحد،اثنان،ثلاثة"، "،")
اطبع_سطر(طول(أ))
اطبع_سطر(أ[0])
اطبع_سطر(أ[1])
اطبع_سطر(أ[2])

# 2) فواصل متتالية — الأجزاء الفارغة محفوظة
متغير ب = تقسيم("م،،ن"، "،")
اطبع_سطر(طول(ب))

# 3) الوسيط الثالث maxSplits
متغير ج = تقسيم("a,b,c,d,e"، ","، 2)
اطبع_سطر(طول(ج))
اطبع_سطر(ج[2])

# 4) فاصل فارغ ⇒ تقسيم بأحرف UTF-8
متغير د = تقسيم("أبج"، "")
اطبع_سطر(طول(د))
اطبع_سطر(د[0])
اطبع_سطر(د[2])

# 5) صيغة الأسلوب «قسم» (اسم الأسلوب) بفاصل عربيّ — تعبر نفس مسار split
متغير هـ = "س،ص،ع"
متغير ز = هـ.قسم("،")
اطبع_سطر(طول(ز))
اطبع_سطر(ز[0])
اطبع_سطر(ز[2])
