# @description `حرف_من_رمز` بعشريٍّ خارجَ مدى الصحيح: كان التحويلُ `fptosi` عاريًا فنتيجتُه poison، فلا يشتعلُ فحصُ المدى ويعودُ نصٌّ فارغٌ بخروجٍ ٠ — الرميُ الذي أُضيفَ لسدِّ الجوابِ الخاطئِ الصامتِ كان يُتخطّى من ذراعِ العشريّ وحدَها
# @expected A\nذ\nرمى كبيرًا\nرمى سالبًا\n=== انتهى ===
# @priority P0

استورد حرف_من_رمز من خرائط

# ═══ العشريُّ الصالحُ يبقى صالحًا: الاقتطاعُ نحوَ الصفرِ دلالةُ المفسّر ═══
# (AR) الحارسُ يقيسُ الجهتَين كي لا يُسَدَّ الطفحُ بتشديدٍ يبتلعُ الصحيح.
اطبع_سطر(حرف_من_رمز(65.9))
اطبع_سطر(حرف_من_رمز(1584.4))

# ═══ ما لا يسعُه الصحيحُ أصلًا: 1e300 أكبرُ من أيِّ i64 ═══
# (AR) بالإشباعِ يصيرُ INT64_MAX فيقعُ في فحصِ «أكبرُ من 0x10FFFF» ويرمي.
#      وبـ`fptosi` العاري كانت القيمةُ poison فيتفرّعُ الفحصُ عليها تفرّعًا
#      غيرَ معرَّف، فمرَّ الباطلُ وخرجَ الطولُ صفرًا بخروجٍ ٠.
حاول
    اطبع_سطر(حرف_من_رمز(1e300))
    اطبع_سطر("لم يرمِ كبيرًا")
امسك خطأ خطا_الكبير
    اطبع_سطر("رمى كبيرًا")
نهاية

# ═══ والطرفُ الآخرُ: إشباعٌ نحوَ INT64_MIN ⇒ سالبٌ ⇒ رمي ═══
حاول
    اطبع_سطر(حرف_من_رمز(0.0 - 1e300))
    اطبع_سطر("لم يرمِ سالبًا")
امسك خطأ خطا_السالب
    اطبع_سطر("رمى سالبًا")
نهاية

اطبع_سطر("=== انتهى ===")
