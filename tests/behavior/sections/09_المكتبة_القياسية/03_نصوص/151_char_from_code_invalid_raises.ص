# @description `حرف_من_رمز` على نقطةِ ترميزٍ باطلةٍ يرمي لا يُرجع نصًّا فارغًا: كان المصرِّفُ يُعطي `[]` برمزِ خروجٍ ٠ بينما يرمي المفسّر — جوابٌ خاطئٌ صامتٌ يجتاز أيَّ فحصِ رمزِ خروج
# @expected A\nذ\n𝄞\nرمى كبيرًا\nرمى سالبًا\nرمى بديلًا\n=== انتهى ===
# @priority P0

استورد حرف_من_رمز من خرائط

# ═══ الصالحُ يبقى صالحًا — الحارسُ يقيس الجهتَين ═══
# (AR) واحدُ بايتٍ ثمّ اثنان ثمّ أربعة: الأطوالُ الثلاثةُ التي يختارها
#      حسابُ الطولِ اللافرعيّ، كي لا يُسَدَّ الرميُ بتشديدٍ يبتلع الصحيح.
اطبع_سطر(حرف_من_رمز(65))
اطبع_سطر(حرف_من_رمز(1584))
اطبع_سطر(حرف_من_رمز(119070))

# ═══ خارجُ المدى الأعلى: أكبرُ من 0x10FFFF ═══
حاول
    اطبع_سطر(حرف_من_رمز(1114112))
    اطبع_سطر("لم يرمِ")
امسك خطأ خطا_الكبير
    اطبع_سطر("رمى كبيرًا")
نهاية

# ═══ سالبٌ: لا نقطةَ ترميزٍ دونَ الصفر ═══
حاول
    اطبع_سطر(حرف_من_رمز(0 - 1))
    اطبع_سطر("لم يرمِ")
امسك خطأ خطا_السالب
    اطبع_سطر("رمى سالبًا")
نهاية

# (AR) ونطاقُ البدائلِ [0xD800, 0xDFFF] لا يُرمَّز مفردًا في UTF-8 — والمفسّرُ
#      يرمي عليه، وكان المصرِّفُ يُصفّر الطولَ صامتًا فيُخرِج نصًّا فارغًا.
حاول
    اطبع_سطر(حرف_من_رمز(55296))
    اطبع_سطر("لم يرمِ")
امسك خطأ خطا_البديل
    اطبع_سطر("رمى بديلًا")
نهاية

اطبع_سطر("=== انتهى ===")
