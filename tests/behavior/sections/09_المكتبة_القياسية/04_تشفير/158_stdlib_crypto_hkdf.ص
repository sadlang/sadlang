# ============================================================
# اشتق_مفتاح — اشتقاق مفاتيح فرعيّة مستقلّة من سرّ مشترك واحد عبر
# HKDF-SHA256 (استخلاص ثم توسيع)، بمعامل «سياق_الاستخدام» يفصل مفاتيح
# مختلفة الغرض مشتقّة من نفس السرّ/الملح (مقاومة إعادة استعمال المفتاح
# عبر السياقات).
# ============================================================
استورد تشفير

# 1. شعاع مُتحقَّق: سرّ + ملح + سياق + طول ناتج 32 بايت
اطبع_سطر(اشتق_مفتاح("shared-secret-value", "context-salt", "usage-context", 32))

# 2. نفس المدخلات بطول ناتج 16 بايت — يجب أن يطابق أوّل 32 حرفًا (16 بايت)
#    من الشعاع أعلاه (خاصّيّة HKDF: الناتج الأقصر بادئة للناتج الأطول)
اطبع_سطر(اشتق_مفتاح("shared-secret-value", "context-salt", "usage-context", 16))

# 3. نفس المدخلات بطول ناتج 64 بايت (يتجاوز كتلة HMAC الواحدة 32 بايت،
#    يتحقّق من مسار HKDF-Expand متعدّد الكتل T(1)||T(2))
اطبع_سطر(اشتق_مفتاح("shared-secret-value", "context-salt", "usage-context", 64))

# 4. سياق استخدام مختلف ⇒ ناتج مختلف تمامًا (نفس السرّ والملح والطول)
اطبع_سطر(اشتق_مفتاح("shared-secret-value", "context-salt", "other-context", 32))

# 5. حتميّة: نفس المدخلات تُعطي نفس الناتج دومًا
اطبع_سطر(اشتق_مفتاح("سرّ", "ملح", "سياق", 32) == اشتق_مفتاح("سرّ", "ملح", "سياق", 32))
