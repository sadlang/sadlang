# ============================================================
# X25519 — تبادل مفاتيح ديفي-هيلمان على منحنى Curve25519 (RFC 7748).
# تنفيذ ذاتيّ بالكامل (بلا OpenSSL): سلّم مونتغومري بزمن ثابت فوق حساب
# مجال gf[16] بجذر 2^16 (بلا __int128). مطابق حرفيًّا بين المفسّر والمترجم.
# ============================================================
استورد تشفير

# 1. RFC 7748 §6.1: اشتقاق مفتاح Alice العامّ من مفتاحها الخاصّ
اطبع_سطر(اشتق_مفتاح_عام_x25519("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"))

# 2. RFC 7748 §6.1: اشتقاق مفتاح Bob العامّ
اطبع_سطر(اشتق_مفتاح_عام_x25519("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"))

# 3. RFC 7748 §6.1: السرّ المشترك (خاصّ Alice × عامّ Bob)
اطبع_سطر(تبادل_مفتاح("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a", "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"))

# 4. RFC 7748 §5.2 (شعاع الضرب السلميّ العامّ): scalar × u-coordinate
اطبع_سطر(تبادل_مفتاح("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4", "e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c"))

# 5. تناظر ديفي-هيلمان: خاصّ Bob × عامّ Alice == السرّ نفسه (§6.1)
اطبع_سطر(تبادل_مفتاح("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb", "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a") == "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")

# 6. اتّفاق طرفين مولّدين عشوائيًّا: سرّ الطرف الأوّل == سرّ الطرف الثاني
متغير أ_خاص = ولّد_مفتاح_خاص_x25519()
متغير ب_خاص = ولّد_مفتاح_خاص_x25519()
متغير أ_عام = اشتق_مفتاح_عام_x25519(أ_خاص)
متغير ب_عام = اشتق_مفتاح_عام_x25519(ب_خاص)
اطبع_سطر(تبادل_مفتاح(أ_خاص, ب_عام) == تبادل_مفتاح(ب_خاص, أ_عام))

# 7. المفتاح الخاصّ المولّد طوله 64 حرفًا ست عشريًّا (32 بايت)
اطبع_سطر(طول(ولّد_مفتاح_خاص_x25519()) == 64)

# 8. حتميّة الاشتقاق: نفس الخاصّ ⇒ نفس العامّ دومًا
اطبع_سطر(اشتق_مفتاح_عام_x25519(أ_خاص) == أ_عام)
