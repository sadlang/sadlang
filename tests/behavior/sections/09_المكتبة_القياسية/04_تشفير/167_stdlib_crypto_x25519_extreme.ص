# @description تبادل_مفتاح/اشتق_مفتاح_عام_x25519 — حالات حدّية عنيفة: تبادل مع مفتاح عامّ صفريّ بالكامل u=0 (نقطة رتبة منخفضة تُنتج سرًّا مشتركًا كلّه أصفار رياضيًّا — الفحص الأمنيّ الإلزاميّ من RFC 7748 §6.1 الموثَّق في crypto.yaml)، ومدخلات hex مشوَّهة (طول فرديّ، حروف غير ست عشريّة، طول قصير/طويل). الفشل قابل للالتقاط بـحاول/امسك على كلا المحرِّكين (__sad_raise عبر النمط الموحَّد لدوال تشفير RUNTIME_CALL). المرحلة ٤ من RFC توسيع مكتبة التشفير
# @expected: صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح
# @priority P1

# ============================================================
# u=0 نقطة رتبة منخفضة معروفة على Curve25519: أيّ ضرب سلميّ لها يبقى صفرًا
# (ثابت رياضيًّا مهما كان المفتاح الخاصّ)، فمهاجم قد يمرّرها كمفتاح عامّ
# خبيث لإجبار سرّ مشترك متوقَّع (صفر) على الطرف الآخر. الفحص الإلزاميّ في
# RFC 7748 §6.1 يرفضها بخطأ صريح بدل إرجاع السرّ الصفريّ صامتًا.
# ============================================================
استورد تشفير

# تكرار نصّ مرارًا — تعريف محلّيّ بدل تكرار_نص لأنّها غير مدعومة في المترجم بعد.
دالة كرّر(نصّ_أساس, عدد)
	متغير نتيجة = ""
	متغير ع = 0
	بينما (ع < عدد)
		نتيجة = نتيجة + نصّ_أساس
		ع = ع + 1
	نهاية
	ارجع نتيجة
نهاية

متغير خاصّي = ولّد_مفتاح_خاص_x25519()

# 1. مفتاح عامّ صفريّ بالكامل (u=0، 64 صفرًا ست عشريًّا) ⇒ سرّ مشترك كلّه أصفار ⇒ رفض
حاول
	متغير ن1 = تبادل_مفتاح(خاصّي, كرّر("0", 64))
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 2. مفتاح خاصّ hex بطول فرديّ (63 حرفًا بدل 64) ⇒ خطأ صريح
حاول
	متغير ن2 = اشتق_مفتاح_عام_x25519(كرّر("a", 63))
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 3. مفتاح خاصّ يحوي حرفًا غير ست عشريّ (z) رغم الطول الصحيح (64)
حاول
	متغير ن3 = اشتق_مفتاح_عام_x25519(كرّر("a", 63) + "z")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 4. مفتاح عامّ للطرف الآخر أقصر بكثير من 64 حرفًا (طول قصير جدًّا) في تبادل_مفتاح
حاول
	متغير ن4 = تبادل_مفتاح(خاصّي, "ab")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 5. مفتاح عامّ للطرف الآخر أطول من 64 حرفًا (طول زائد)
حاول
	متغير ن5 = تبادل_مفتاح(خاصّي, كرّر("a", 66))
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 6. سلسلة hex فارغة تمامًا كمفتاح خاصّ
حاول
	متغير ن6 = اشتق_مفتاح_عام_x25519("")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية
