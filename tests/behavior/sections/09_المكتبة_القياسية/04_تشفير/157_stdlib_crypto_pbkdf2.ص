# @description اشتق_مفتاح_مرور — PBKDF2-HMAC-SHA256 (RFC 8018)؛ شعاعان مُتحقَّقان مقابل hashlib.pbkdf2_hmac ومقابل بناء HMAC يدويّ مستقلّ (بايثون) + حتميّة + حسّاسيّة للملح وعدد التكرارات؛ المرحلة ٢ من RFC توسيع مكتبة التشفير
# @expected: 9ddb6e033b885ff31129f41984de252765c0009fc07d34a34503ad61c650cf5b\n865699bf1f9f41407b9ec39772d829bf22788b132654e7527cd6d2fba9c7df09\nصحيح\nصحيح\nصحيح
# @priority P1

# ============================================================
# اشتق_مفتاح_مرور — اشتقاق مفتاح بطيء الحساب عمدًا من كلمة مرور عبر
# PBKDF2-HMAC-SHA256، مصمَّم لمقاومة هجمات التخمين بالقوّة الغاشمة (عدد
# التكرارات معامل تحكّم صريح). النتيجة مفتاح 32 بايت (256 بت) كسلسلة ست
# عشريّة 64 حرفًا.
# ============================================================
استورد تشفير

# 1. شعاع مُتحقَّق: كلمة مرور + ملح + 1000 تكرار → 32 بايت
اطبع_سطر(اشتق_مفتاح_مرور("weak-password-123", "unique-salt-abc", 1000))

# 2. شعاع مُتحقَّق: كلمة مرور فارغة + ملح قصير + تكرار واحد
اطبع_سطر(اشتق_مفتاح_مرور("", "s", 1))

# 3. حتميّة: نفس المدخلات تُعطي نفس الناتج دومًا
اطبع_سطر(اشتق_مفتاح_مرور("سرّي", "ملح_ثابت", 500) == اشتق_مفتاح_مرور("سرّي", "ملح_ثابت", 500))

# 4. حسّاسيّة للملح: ملح مختلف ⇒ ناتج مختلف تمامًا
اطبع_سطر(اشتق_مفتاح_مرور("سرّي", "ملح_أ", 500) != اشتق_مفتاح_مرور("سرّي", "ملح_ب", 500))

# 5. حسّاسيّة لعدد التكرارات: عدد تكرارات مختلف ⇒ ناتج مختلف تمامًا
اطبع_سطر(اشتق_مفتاح_مرور("سرّي", "ملح_ثابت", 500) != اشتق_مفتاح_مرور("سرّي", "ملح_ثابت", 501))
