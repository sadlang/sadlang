# @description بلايك3/هاش_مفتاح — حالات حدّية عنيفة: حدود قطع BLAKE3 الداخليّة (1024 بايت)، مدخلات ضخمة متعدّدة القطع، ومصفوفة أطوال مفاتيح هاش_مفتاح (صفر/1/31/32/33/طويل جدًّا) حول حدّ الاشتقاق الداخليّ عند 32 بايت. اختبارات ذاتيّة المرجعيّة (تمايز/حتميّة/طول ثابت) بلا شعاعات مُبيَّتة، إذ لا تُغطّى هذه الأطوال بشعاعات BLAKE3 الرسميّة المُختارة سلفًا في 155/156.
# @expected: صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\n64\n64
# @priority P1

# ============================================================
# حالات حدّية عنيفة لبلايك3/هاش_مفتاح: حدود قطع BLAKE3 الداخليّة (كل قطعة
# 1024 بايت، وتُبنى شجرة Merkle داخليّة عند تجاوز قطعة واحدة) + مصفوفة
# أطوال مفاتيح هاش_مفتاح حول حدّ 32 بايت (الحدّ الذي يفصل "استعمال مباشر"
# عن "اشتقاق عبر بلايك3(مفتاح)").
# ============================================================
استورد تشفير

# تكرار حرف مرارًا لبناء مدخلات ضخمة — تعريف محلّيّ بدل تكرار_نص لأنّها
# غير مدعومة في المترجم بعد (مسار مفسّر فقط)، فيبقى هذا الملفّ ثنائيّ المحرّك.
دالة كرّر(حرف, عدد)
	متغير نتيجة = ""
	متغير ع = 0
	بينما (ع < عدد)
		نتيجة = نتيجة + حرف
		ع = ع + 1
	نهاية
	ارجع نتيجة
نهاية

متغير أ1023 = كرّر("a", 1023)          # قطعة واحدة ناقصة بايت واحد
متغير أ1024 = كرّر("a", 1024)          # قطعة واحدة كاملة بالضبط (حدّ BLAKE3)
متغير أ1025 = كرّر("a", 1025)          # قطعة واحدة + بايت واحد (يفتح شجرة Merkle)
متغير أ2048 = كرّر("a", 2048)          # قطعتان بالضبط
متغير أ5000 = كرّر("a", 5000)          # عدّة قطع (5 تقريبًا) — يغطّي مسار الدمج الداخليّ متعدّد المستويات

# 1. حتميّة عبر حدّ القطعة: نفس المدخل 1024 بايت ⇒ نفس الهاش دومًا
اطبع_سطر(بلايك3(أ1024) == بلايك3(أ1024))

# 2. تمايز حول حدّ القطعة: 1023 و1024 و1025 بايت تُنتج ثلاثة هاشات مختلفة تمامًا
اطبع_سطر(بلايك3(أ1023) != بلايك3(أ1024))
اطبع_سطر(بلايك3(أ1024) != بلايك3(أ1025))
اطبع_سطر(بلايك3(أ1023) != بلايك3(أ1025))

# 3. تمايز عبر عدّة قطع: قطعتان (2048) تختلف عن قطعة+بايت (1025) وعن 5 قطع (5000)
اطبع_سطر(بلايك3(أ2048) != بلايك3(أ1025))
اطبع_سطر(بلايك3(أ2048) != بلايك3(أ5000))

# 4. هاش_مفتاح: مصفوفة أطوال مفاتيح حول حدّ الاشتقاق 32 بايت — كل طول مفتاح
#    مختلف يُنتج مصادقة مختلفة تمامًا لنفس الرسالة (0/1/31/32/33/طويل جدًّا)
متغير رسالة = "رسالة اختبار المصادقة"
متغير م0 = هاش_مفتاح(رسالة, "")
متغير م1 = هاش_مفتاح(رسالة, "س")
متغير م31 = هاش_مفتاح(رسالة, كرّر("k", 31))
متغير م32 = هاش_مفتاح(رسالة, كرّر("k", 32))     # طول المفتاح المباشر بالضبط
متغير م33 = هاش_مفتاح(رسالة, كرّر("k", 33))     # بايت واحد فوق حدّ الاستعمال المباشر ⇒ يُشتقّ
متغير مطويل = هاش_مفتاح(رسالة, كرّر("k", 1000))  # مفتاح ضخم جدًّا

اطبع_سطر(م0 != م1)
اطبع_سطر(م31 != م32)
اطبع_سطر(م32 != م33)
اطبع_سطر(م33 != مطويل)

# 5. الطول ثابت دومًا (64 حرفًا) بصرف النظر عن طول المدخل/المفتاح
اطبع_سطر(طول(بلايك3(أ5000)))
اطبع_سطر(طول(مطويل))
