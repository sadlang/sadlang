# @description اشتق_مفتاح_مرور/اشتق_مفتاح/أرجون2 — حالات حدّية عنيفة لرفض البارامترات خارج الحدود الآمنة الموثَّقة في crypto.yaml: عدد_التكرارات=0 (PBKDF2 وأرجون2)، الطول=0 والطول=8161 (يتجاوز حدّ HKDF-Expand 255×32 من RFC 5869 §2.3)، تكلفة_الذاكرة=7 (أرجون2، تحت الحدّ الأدنى 8)، ملح 7 بايت (أرجون2، تحت الحدّ الأدنى RFC 9106 §3.1). الفشل قابل للالتقاط بـحاول/امسك على كلا المحرِّكين (وقت تشغيل المترجم يُرجع NULL فيرفع مولّد LLVM استثناءً عبر __sad_raise، بدل exit(1) سابقًا). المرحلة ٢ من RFC توسيع مكتبة التشفير
# @expected: صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح
# @priority P1

# ============================================================
# رفض صريح للبارامترات خارج الحدود الآمنة الموصى بها في المعيار — لكل KDF
# ثلاث في هذه المكتبة حدّ أدنى/أقصى صريح موثَّق، ويجب أن يفشل الاستدعاء
# فشلًا قابلًا للالتقاط عند تجاوزه، لا أن ينفّذ بصمت بقيمة ضعيفة.
# ============================================================
استورد تشفير

# 1. اشتق_مفتاح_مرور: عدد_التكرارات = 0 (يجب أن يكون > 0)
حاول
	متغير ن1 = اشتق_مفتاح_مرور("كلمة_سرّ", "ملح", 0)
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 2. اشتق_مفتاح: الطول = 0 (المدى المسموح 1-8160 بايت)
حاول
	متغير ن2 = اشتق_مفتاح("سرّ", "ملح", "سياق", 0)
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 3. اشتق_مفتاح: الطول = 8161 (بايت واحد فوق الحدّ الأقصى 255×32 بايت لـHKDF-Expand)
حاول
	متغير ن3 = اشتق_مفتاح("سرّ", "ملح", "سياق", 8161)
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 4. أرجون2: عدد_التكرارات = 0 (يجب أن يكون ≥ 1)
حاول
	متغير ن4 = أرجون2("كلمة_سرّ", "ملح_ثماني1", 1024, 0)
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 5. أرجون2: تكلفة_الذاكرة = 7 كيلوبايت (بايت واحد تحت الحدّ الأدنى 8)
حاول
	متغير ن5 = أرجون2("كلمة_سرّ", "ملح_ثماني1", 7, 1)
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 6. أرجون2: ملح 7 بايت (بايت واحد تحت الحدّ الأدنى الموصى به RFC 9106 §3.1)
حاول
	متغير ن6 = أرجون2("كلمة_سرّ", "1234567", 1024, 1)
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية
