# @description فك_تشفير_موثق — كشف العبث وفشل المصادقة (ChaCha20-Poly1305، RFC 8439). غرض AEAD الأساسيّ كشف التلاعب، لذا يفشل فك_تشفير_موثق فشلًا صريحًا (لا يُرجع نصًّا مُحرَّفًا) عند: عبث بالمغلّف (قلب نبلة)، مفتاح خاطئ، مغلّف أقصر من 28 بايت، أو hex غير صالح. @skip_compiler: آليّة الإبلاغ متباعدة — المفسّر يرمي خطأً قابلًا للالتقاط بـحاول/امسك (المُختبَر هنا)، والمترجم يفشل مُغلَقًا بـexit(1) (لا يمكن التقاطه في .ص، موثَّق في crypto.yaml وCOVERAGE). المرحلة ٣ من RFC توسيع مكتبة التشفير
# @skip_compiler
# @expected: صحيح\nصحيح\nصحيح\nصحيح
# @priority P1

# ============================================================
# فك_تشفير_موثق يكشف العبث عبر وسم Poly1305: أيّ تغيير في المغلّف أو مفتاح
# خاطئ ⇒ عدم تطابق الوسم ⇒ خطأ قابل للالتقاط بـحاول/امسك في المفسّر.
# (في المترجم يفشل مُغلَقًا بـexit(1) — لذا @skip_compiler، انظر 159 للمسار
# الإيجابيّ المشترك بين المحرِّكين.)
# ============================================================
استورد تشفير

# يقلب أوّل نبلة ست عشريّة من المغلّف (بايت من الـnonce) ⇒ يضمن اختلافًا
دالة اقلب_أول(مغلّف)
	متغير أول = مغلّف.جزء(0، 1)
	متغير بقية = مغلّف.جزء(1، مغلّف.طول())
	إذا (أول == "0")
		ارجع "1" + بقية
	وإلا
		ارجع "0" + بقية
	نهاية
نهاية

متغير مغلّف = شفر_موثق("بيانات حسّاسة", "المفتاح")

# 1. عبث: قلب نبلة واحدة ⇒ فشل مصادقة قابل للالتقاط
حاول
	متغير ن1 = فك_تشفير_موثق(اقلب_أول(مغلّف), "المفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 2. مفتاح خاطئ ⇒ اشتقاق مفتاح مختلف ⇒ فشل مصادقة
حاول
	متغير ن2 = فك_تشفير_موثق(مغلّف, "مفتاح_خاطئ")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 3. مغلّف أقصر من الحدّ الأدنى (28 بايت = nonce 12 + tag 16)
حاول
	متغير ن3 = فك_تشفير_موثق("00112233", "المفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 4. سلسلة بطول كافٍ لكنها ليست ست عشريّة صالحة
حاول
	متغير ن4 = فك_تشفير_موثق("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", "المفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية
