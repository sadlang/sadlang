# @description فك_تشفير_موثق — كشف العبث وفشل المصادقة (ChaCha20-Poly1305، RFC 8439). غرض AEAD الأساسيّ كشف التلاعب، لذا يفشل فك_تشفير_موثق فشلًا صريحًا (لا يُرجع نصًّا مُحرَّفًا) عند: عبث بالمغلّف (قلب نبلة)، مفتاح خاطئ، مغلّف أقصر من 28 بايت، أو hex غير صالح. الفشل قابل للالتقاط بـحاول/امسك على كلا المحرِّكين (المترجم يرفع استثناءً عبر __sad_raise بعد أن يُرجع وقت التشغيل NULL — نفس آليّة عقود «يتطلب»؛ لم يعد يفشل مُغلَقًا بـexit(1)). المرحلة ٣ من RFC توسيع مكتبة التشفير
# @expected: صحيح\nصحيح\nصحيح\nصحيح
# @priority P1

# ============================================================
# فك_تشفير_موثق يكشف العبث عبر وسم Poly1305: أيّ تغيير في المغلّف أو مفتاح
# خاطئ ⇒ عدم تطابق الوسم ⇒ خطأ قابل للالتقاط بـحاول/امسك على المحرّكين معًا.
# (انظر 159 للمسار الإيجابيّ.)
# ============================================================
استورد تشفير

متغير مغلّف = شفر_موثق("بيانات حسّاسة", "المفتاح")

# 1. عبث: قلب أوّل نبلة ست عشريّة من المغلّف (بايت من الـnonce) ⇒ فشل مصادقة
#    قابل للالتقاط. (منطق القلب مضمَّن مباشرة على متغيّر محلّيّ، لا داخل دالّة
#    تأخذ نصًّا معاملًا — فجوة مستقلّة معروفة في مولّد LLVM لبعض دوال جزء()
#    عند استدعائها على معامل دالّة، خارج نطاق هذا الاختبار.)
متغير أوّل_نبلة = مغلّف.جزء(0، 1)
متغير بقيّة_المغلّف = مغلّف.جزء(1، مغلّف.طول() - 1)
متغير مغلّف_معبوث = ""
إذا (أوّل_نبلة == "0")
	مغلّف_معبوث = "1" + بقيّة_المغلّف
وإلا
	مغلّف_معبوث = "0" + بقيّة_المغلّف
نهاية
حاول
	متغير ن1 = فك_تشفير_موثق(مغلّف_معبوث, "المفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 2. مفتاح خاطئ ⇒ اشتقاق مفتاح مختلف ⇒ فشل مصادقة
حاول
	متغير ن2 = فك_تشفير_موثق(مغلّف, "مفتاح_خاطئ")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 3. مغلّف أقصر من الحدّ الأدنى (28 بايت = nonce 12 + tag 16)
حاول
	متغير ن3 = فك_تشفير_موثق("00112233", "المفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 4. سلسلة بطول كافٍ لكنها ليست ست عشريّة صالحة
حاول
	متغير ن4 = فك_تشفير_موثق("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", "المفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية
