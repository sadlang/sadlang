# @description شفر_موثق/فك_تشفير_موثق — ChaCha20-Poly1305 AEAD (RFC 8439)؛ تشفير موثَّق ذاتيّ التنفيذ مطابق حرفيًّا بين المفسّر والمترجم. اختبار المسار الإيجابيّ (يعمل على المحرِّكين): جولة كاملة لأطوال مختلفة (فارغ/قصير/أطول من 64 بايت لكتلة ChaCha20 مع كتلة أخيرة جزئيّة)، حتميّة فكّ المغلّف نفسه، لاحتميّة التشفير (nonce عشوائيّ ⇒ مغلّفان مختلفان لنفس المدخل — خاصّيّة أمان)، ومفتاح 32 بايت يُستعمَل مباشرةً؛ المرحلة ٣ من RFC توسيع مكتبة التشفير. مسارات الفشل (عبث/مفتاح خاطئ/مغلّف مشوَّه) في 160 (متباعدة بين المحرِّكين ⇒ @skip_compiler)
# @expected: صحيح\nصحيح\nصحيح\nصحيح\nخطأ\nصحيح\nصحيح\nصحيح
# @priority P1

# ============================================================
# شفر_موثق — تشفير موثَّق (AEAD) عبر ChaCha20-Poly1305 حسب RFC 8439:
# تشفير ChaCha20 + مصادقة Poly1305 في مغلّف واحد. بخلاف شفّر (بلا مصادقة)
# يكشف فك_تشفير_موثق أيّ عبث. المغلّف الست عشريّ: [nonce 12][ct][tag 16].
# ============================================================
استورد تشفير

# 1. جولة كاملة: فك(شفّر(نص)) == النصّ الأصليّ
متغير رسالة = "رسالة سرّيّة تحتاج مصادقة"
اطبع_سطر(فك_تشفير_موثق(شفر_موثق(رسالة, "مفتاح_كلمة_مرور"), "مفتاح_كلمة_مرور") == رسالة)

# 2. نصّ فارغ (المغلّف = nonce + tag فقط، بلا نصّ مشفَّر)
اطبع_سطر(فك_تشفير_موثق(شفر_موثق("", "ك"), "ك") == "")

# 3. نصّ أطول من كتلة ChaCha20 الواحدة (64 بايت) بكتلة أخيرة جزئيّة —
#    يتحقّق من مسار تعدّد الكتل + آخر كتلة غير مكتملة في تيار المفاتيح
متغير طويل = "ChaCha20-Poly1305 authenticated encryption over a plaintext that exceeds sixty-four bytes."
اطبع_سطر(فك_تشفير_موثق(شفر_موثق(طويل, "ك"), "ك") == طويل)

# 4. حتميّة فكّ التشفير: نفس المغلّف يفكّ إلى نفس النصّ في كلّ مرّة
متغير مغلّف = شفر_موثق(رسالة, "مفتاحي")
اطبع_سطر(فك_تشفير_موثق(مغلّف, "مفتاحي") == فك_تشفير_موثق(مغلّف, "مفتاحي"))

# 5. لاحتميّة التشفير: nonce عشوائيّ جديد لكلّ استدعاء ⇒ مغلّفان مختلفان
#    لنفس النصّ والمفتاح (خاصّيّة أمان مقصودة لا خلل) ⇒ المقارنة «خطأ»
اطبع_سطر(شفر_موثق(رسالة, "مفتاحي") == شفر_موثق(رسالة, "مفتاحي"))

# 6. مفتاح طوله 32 بايت بالضبط يُستعمَل مباشرةً (بلا اشتقاق SHA-256) — جولة كاملة
متغير مفتاح32 = "0123456789abcdef0123456789abcdef"
اطبع_سطر(فك_تشفير_موثق(شفر_موثق(رسالة, مفتاح32), مفتاح32) == رسالة)

# 7. نصّ بايت واحد (أصغر كتلة أخيرة جزئيّة ممكنة في تيار المفاتيح)
اطبع_سطر(فك_تشفير_موثق(شفر_موثق("A", "ك"), "ك") == "A")

# 8. نصّ طوله 64 بايت بالضبط (كتلة ChaCha20 كاملة بلا باقٍ جزئيّ — الحدّ الفاصل)
متغير ك64 = "0123456789012345678901234567890123456789012345678901234567890123"
اطبع_سطر(فك_تشفير_موثق(شفر_موثق(ك64, "ك"), "ك") == ك64)
