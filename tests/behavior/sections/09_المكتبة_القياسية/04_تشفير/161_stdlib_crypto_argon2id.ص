# ============================================================================
# أرجون2 — اشتقاق مفتاح صعب الحساب ذاكرةً وزمنًا معًا (Argon2id، الفائز
# بمسابقة Password Hashing Competition)، مبنيّ فوق BLAKE2b ذاتيّ التنفيذ
# (مستقلّ عن SHA-256 المستعمَل في اشتق_مفتاح_مرور/اشتق_مفتاح). التوازي
# ثابت على 1 عمدًا في هذا التنفيذ.
# ============================================================================
استورد تشفير

# 1. شعاع مُتحقَّق: كلمة مرور + ملح 16 بايت + تكلفة ذاكرة 2048 كيلوبايت + تكراران
اطبع_سطر(أرجون2("password123", "somesalt12345678", 2048, 2))

# 2. شعاع مُتحقَّق: كلمة مرور فارغة + الحدّ الأدنى (تكلفة ذاكرة 8 كيلوبايت، تكرار واحد)
اطبع_سطر(أرجون2("", "saltsalt", 8, 1))

# 3. شعاع مُتحقَّق: كلمة مرور 22 حرفًا + تكلفة ذاكرة 4096 كيلوبايت + 3 تكرارات
اطبع_سطر(أرجون2("a-longer-password-here", "0123456789abcdef", 4096, 3))

# 4. شعاع مُتحقَّق: تكلفة ذاكرة غير مضاعِف لـ4 (10 كيلوبايت) — يتحقّق من أنّ
#    التجزئة الأوّليّة H0 تستعمل القيمة الخام لا القيمة المقرَّبة داخليًّا
#    (علّة حقيقيّة رُصدت واُصلحت أثناء التطوير: كل شعاعات التحقّق الأولى
#    استعملت أطوالًا مضاعِفة لـ4 صدفة، فأخفت هذه العلّة تمامًا)
اطبع_سطر(أرجون2("pw", "salt_8byte", 10, 1))

# 5. حتميّة: نفس المدخلات تُعطي نفس الناتج دومًا
اطبع_سطر(أرجون2("سرّي", "ملح_ثماني_بايت", 1024, 1) == أرجون2("سرّي", "ملح_ثماني_بايت", 1024, 1))

# 6. حسّاسيّة للملح: ملح مختلف ⇒ ناتج مختلف تمامًا
اطبع_سطر(أرجون2("سرّي", "ملح_ثماني1", 1024, 1) != أرجون2("سرّي", "ملح_ثماني2", 1024, 1))

# 7. حسّاسيّة لتكلفة الذاكرة: تكلفة ذاكرة مختلفة ⇒ ناتج مختلف تمامًا
اطبع_سطر(أرجون2("سرّي", "ملح_ثماني_بايت", 1024, 1) != أرجون2("سرّي", "ملح_ثماني_بايت", 2048, 1))

# 8. حسّاسيّة لعدد التكرارات: عدد تكرارات مختلف ⇒ ناتج مختلف تمامًا
اطبع_سطر(أرجون2("سرّي", "ملح_ثماني_بايت", 1024, 1) != أرجون2("سرّي", "ملح_ثماني_بايت", 1024, 2))
