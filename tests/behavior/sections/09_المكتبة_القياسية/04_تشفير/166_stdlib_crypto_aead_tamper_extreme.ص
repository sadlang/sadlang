# @description فك_تشفير_موثق — حالات حدّية عنيفة لكشف العبث تتجاوز 160: عبث دقيق بموضع الوسم (آخر 16 بايت) تحديدًا لا nonce فقط، عبث بمنتصف النصّ المشفَّر في نصّ متعدّد الكتل، مغلَّف أقصر من الحدّ ببايت واحد بالضبط (27 بايت)، مغلَّف بطول صالح (28 بايت) لكنه عشوائيّ (لا وسم صحيح)، وسلسلة hex فارغة تمامًا. الفشل قابل للالتقاط بـحاول/امسك على كلا المحرِّكين (نفس آلية __sad_raise الموثَّقة في 160). المرحلة ٣ من RFC توسيع مكتبة التشفير
# @expected: صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح
# @priority P1

# ============================================================
# عبث دقيق بمواضع محدَّدة داخل المغلَّف (لا قلب نبلة أولى فقط كما في 160):
# الوسم (آخر 16 بايت)، ومنتصف النصّ المشفَّر في نصّ متعدّد الكتل — يتحقّق من
# أنّ Poly1305 يكشف العبث في أيّ موضع، لا في الطرف الأوّل فقط.
# ============================================================
استورد تشفير

# تكرار نصّ مرارًا — تعريف محلّيّ بدل تكرار_نص لأنّها غير مدعومة في المترجم بعد.
دالة كرّر(نصّ_أساس, عدد)
	متغير نتيجة = ""
	متغير ع = 0
	بينما (ع < عدد)
		نتيجة = نتيجة + نصّ_أساس
		ع = ع + 1
	نهاية
	ارجع نتيجة
نهاية

# ملاحظة: منطق «قلب نبلة عند موضع» مضمَّن محلّيًّا عند كل استدعاء (لا داخل
# دالّة تأخذ نصًّا معاملًا) — فجوة مستقلّة معروفة في مولّد LLVM لجزء() عند
# استدعائها على معامل دالّة (لا محارف/طول/دمج نصّ)، خارج نطاق هذا الاختبار.

# 1. عبث بآخر نبلة من المغلَّف (داخل الوسم Poly1305، آخر 16 بايت = آخر 32 حرفًا)
متغير مغلّف1 = شفر_موثق("رسالة قصيرة", "مفتاح")
متغير م1_موضع = مغلّف1.طول() - 1
متغير م1_قبل = مغلّف1.جزء(0، م1_موضع)
متغير م1_نبلة = مغلّف1.جزء(م1_موضع، 1)
متغير م1_معبوث = ""
إذا (م1_نبلة == "0")
	م1_معبوث = م1_قبل + "1"
وإلا
	م1_معبوث = م1_قبل + "0"
نهاية
حاول
	متغير ن1 = فك_تشفير_موثق(م1_معبوث, "مفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 2. عبث بأوّل نبلة من الوسم بالضبط (بداية آخر 32 حرفًا)
متغير مغلّف2 = شفر_موثق("رسالة قصيرة أخرى", "مفتاح")
متغير م2_موضع = مغلّف2.طول() - 32
متغير م2_قبل = مغلّف2.جزء(0، م2_موضع)
متغير م2_نبلة = مغلّف2.جزء(م2_موضع، 1)
متغير م2_بعد = مغلّف2.جزء(م2_موضع + 1، مغلّف2.طول() - م2_موضع - 1)
متغير م2_معبوث = ""
إذا (م2_نبلة == "0")
	م2_معبوث = م2_قبل + "1" + م2_بعد
وإلا
	م2_معبوث = م2_قبل + "0" + م2_بعد
نهاية
حاول
	متغير ن2 = فك_تشفير_موثق(م2_معبوث, "مفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 3. عبث بمنتصف النصّ المشفَّر تمامًا لنصّ طويل متعدّد الكتل (200 بايت)
# إزاحة 200 تقع داخل منطقة النصّ المشفَّر (بعد nonce الأوّل 24 حرفًا وقبل الوسم الأخير 32 حرفًا)
متغير طويل = كرّر("x", 200)
متغير مغلّف3 = شفر_موثق(طويل, "مفتاح_طويل")
متغير م3_قبل = مغلّف3.جزء(0، 200)
متغير م3_نبلة = مغلّف3.جزء(200، 1)
متغير م3_بعد = مغلّف3.جزء(201، مغلّف3.طول() - 201)
متغير م3_معبوث = ""
إذا (م3_نبلة == "0")
	م3_معبوث = م3_قبل + "1" + م3_بعد
وإلا
	م3_معبوث = م3_قبل + "0" + م3_بعد
نهاية
حاول
	متغير ن3 = فك_تشفير_موثق(م3_معبوث, "مفتاح_طويل")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 4. مغلَّف أقصر من الحدّ الأدنى ببايت واحد بالضبط (27 بايت = 54 حرفًا ست عشريًّا)
حاول
	متغير ن4 = فك_تشفير_موثق(كرّر("00", 27), "مفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 5. مغلَّف بطول صالح بالضبط (28 بايت = 56 حرفًا) لكنّه عشوائيّ — hex صالح، طول صالح، وسم خاطئ حتمًا
حاول
	متغير ن5 = فك_تشفير_موثق(كرّر("ab", 28), "مفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية

# 6. سلسلة hex فارغة تمامًا (طول صفر، أقصر بكثير من الحدّ الأدنى)
حاول
	متغير ن6 = فك_تشفير_موثق("", "مفتاح")
	اطبع_سطر("خطأ")
امسك خ
	اطبع_سطر("صحيح")
نهاية
