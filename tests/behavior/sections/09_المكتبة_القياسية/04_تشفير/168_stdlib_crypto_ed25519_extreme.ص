# @description تحقق_توقيع — حالات حدّية عنيفة تستغلّ كونها دالّة استعلام لا تُلقي أبدًا (موثَّق في crypto.yaml): توقيع غير قانونيّ S≥L (المكوّن الثاني يتجاوز رتبة المجموعة L، فحص RFC 8032 §5.1.7 الإلزاميّ)، أطوال توقيع/مفتاح مشوَّهة عدّة، ورسالة ضخمة متعدّدة الكتل (SHA-512 كتلته 128 بايت) مع عبث دقيق ببايت واحد وسطها. دالّة استعلام آمنة على المحرِّكين معًا فلا حاجة لـ@skip_compiler. المرحلة ٤ من RFC توسيع مكتبة التشفير
# @expected: صحيح\nخطأ\nخطأ\nخطأ\nخطأ\nصحيح\nخطأ\nصحيح
# @priority P1

# ============================================================
# تحقق_توقيع لا ترمي أبدًا مهما كان المدخل مشوَّهًا — تُرجع خطأ منطقيًّا
# فقط. هذا يسمح باختبار حالات حدّية عنيفة جدًّا (توقيع غير قانونيّ رياضيًّا،
# أطوال عشوائيّة) دون حاجة لـحاول/امسك، ودون تباعُد بين المحرِّكين.
# ============================================================
استورد تشفير

# تكرار نصّ مرارًا لبناء مدخلات ضخمة — تعريف محلّيّ بدل تكرار_نص لأنّها
# غير مدعومة في المترجم بعد (مسار مفسّر فقط)، فيبقى هذا الملفّ ثنائيّ المحرّك.
دالة كرّر(نصّ_أساس, عدد)
	متغير نتيجة = ""
	متغير ع = 0
	بينما (ع < عدد)
		نتيجة = نتيجة + نصّ_أساس
		ع = ع + 1
	نهاية
	ارجع نتيجة
نهاية

متغير خاص = ولّد_مفتاح_خاص_توقيع()
متغير عام = اشتق_مفتاح_عام_توقيع(خاص)
متغير رسالة = "رسالة عاديّة للتوقيع"
متغير توقيع_صالح = وقّع(رسالة, خاص)

# 1. مرجعيّة: التوقيع الصالح يُتحقَّق بنجاح (خط أساس قبل التشويه)
اطبع_سطر(تحقق_توقيع(رسالة, توقيع_صالح, عام))

# 2. توقيع غير قانونيّ S≥L: نستبدل مكوّن S (آخر 64 حرفًا = 32 بايت) بأكبر
#    قيمة ممكنة (0xFF مكرَّرة، أي 2^256-1) — أكبر بكثير من رتبة المجموعة L
#    (≈2^252)، فيجب أن يُرفَض بصرف النظر عن صحّة مكوّن R أو الرسالة
متغير جزء_R = توقيع_صالح.جزء(0، 64)
متغير توقيع_S_غير_قانونيّ = جزء_R + كرّر("f", 64)
اطبع_سطر(تحقق_توقيع(رسالة, توقيع_S_غير_قانونيّ, عام))

# 3. توقيع قصير جدًّا (طول عشوائيّ لا يطابق 128 حرفًا)
اطبع_سطر(تحقق_توقيع(رسالة, "1234", عام))

# 4. توقيع بطول صحيح (128) لكنه يحوي حرفًا غير ست عشريّ
اطبع_سطر(تحقق_توقيع(رسالة, توقيع_صالح.جزء(0، 127) + "g", عام))

# 5. مفتاح عامّ فارغ تمامًا
اطبع_سطر(تحقق_توقيع(رسالة, توقيع_صالح, ""))

# 6. رسالة ضخمة متعدّدة كتل SHA-512 (كتلة 128 بايت؛ 2000 بايت ⇒ ~16 كتلة)
#    توقيع وتحقّق ناجحان
متغير رسالة_ضخمة = كرّر("m", 2000)
متغير توقيع_ضخم = وقّع(رسالة_ضخمة, خاص)
اطبع_سطر(تحقق_توقيع(رسالة_ضخمة, توقيع_ضخم, عام))

# 7. نفس الرسالة الضخمة لكن ببايت واحد مُغيَّر تمامًا في المنتصف ⇒ رفض
متغير قبل = رسالة_ضخمة.جزء(0، 1000)
متغير بعد = رسالة_ضخمة.جزء(1001، رسالة_ضخمة.طول() - 1001)
متغير رسالة_معبوثة = قبل + "X" + بعد
اطبع_سطر(تحقق_توقيع(رسالة_معبوثة, توقيع_ضخم, عام))

# 8. حتميّة على نطاق ضخم: توقيع الرسالة الضخمة نفسها مرّتين يُنتج نفس التوقيع بالضبط
اطبع_سطر(وقّع(رسالة_ضخمة, خاص) == توقيع_ضخم)
