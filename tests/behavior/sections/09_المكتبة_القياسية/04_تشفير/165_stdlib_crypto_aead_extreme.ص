# @description شفر_موثق/فك_تشفير_موثق — حالات حدّية عنيفة للمسار الإيجابيّ (بلا فشل مصادقة): حدود كتلة ChaCha20 الداخليّة (64 بايت)، نصّ فارغ (يتحقّق من طول المغلَّف الأدنى 28 بايت بالضبط)، نصّ ضخم متعدّد الكتل (5000+ بايت)، ومفتاح 32 بايت مباشر مقابل مفتاح طويل يُشتقّ عبر SHA-256. تبادليّة فقط (لا مقارنة ناتج خام — nonce عشوائيّ لكل استدعاء). المرحلة ٣ من RFC توسيع مكتبة التشفير
# @expected: صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\n56\nصحيح\nصحيح\nصحيح
# @priority P1

# ============================================================
# حالات حدّية عنيفة لمسار AEAD الإيجابيّ: حدود كتلة ChaCha20 (64 بايت لكلّ
# كتلة كيان-تيّار)، نصوص طويلة متعدّدة الكتل، ونصّ فارغ (أصغر مغلَّف ممكن).
# ============================================================
استورد تشفير

# تكرار نصّ مرارًا لبناء مدخلات ضخمة — تعريف محلّيّ بدل تكرار_نص لأنّها
# غير مدعومة في المترجم بعد (مسار مفسّر فقط)، فيبقى هذا الملفّ ثنائيّ المحرّك.
دالة كرّر(نصّ_أساس, عدد)
	متغير نتيجة = ""
	متغير ع = 0
	بينما (ع < عدد)
		نتيجة = نتيجة + نصّ_أساس
		ع = ع + 1
	نهاية
	ارجع نتيجة
نهاية

# 1. حدود كتلة ChaCha20 (64 بايت): نصوص 63/64/65 بايت — تبادليّة سليمة لكلٍّ
اطبع_سطر(فك_تشفير_موثق(شفر_موثق(كرّر("a", 63), "مفتاح"), "مفتاح") == كرّر("a", 63))
اطبع_سطر(فك_تشفير_موثق(شفر_موثق(كرّر("a", 64), "مفتاح"), "مفتاح") == كرّر("a", 64))
اطبع_سطر(فك_تشفير_موثق(شفر_موثق(كرّر("a", 65), "مفتاح"), "مفتاح") == كرّر("a", 65))

# 2. نصّ ضخم متعدّد الكتل (5000 بايت، ~78 كتلة ChaCha20) — تبادليّة سليمة
متغير نصّ_ضخم = كرّر("s", 5000)
اطبع_سطر(فك_تشفير_موثق(شفر_موثق(نصّ_ضخم, "مفتاح_طويل"), "مفتاح_طويل") == نصّ_ضخم)

# 3. نصّان ضخمان متطابقان بمفتاحين مختلفين ⇒ مغلَّفان مختلفان تمامًا (لا تسريب نمط)
اطبع_سطر(شفر_موثق(نصّ_ضخم, "مفتاح_أ") != شفر_موثق(نصّ_ضخم, "مفتاح_ب"))

# 4. مفتاح 32 بايت بالضبط (استعمال مباشر بلا اشتقاق SHA-256) — تبادليّة سليمة
متغير مفتاح32 = كرّر("k", 32)
اطبع_سطر(فك_تشفير_موثق(شفر_موثق("رسالة حسّاسة", مفتاح32), مفتاح32) == "رسالة حسّاسة")

# 5. مفتاح أطول من 256 بايت — يتحقّق من عدم اقتطاع صامت للمفتاح الطويل قبل اشتقاق SHA-256
متغير مفتاح_ضخم = كرّر("k", 500)
اطبع_سطر(فك_تشفير_موثق(شفر_موثق("رسالة", مفتاح_ضخم), مفتاح_ضخم) == "رسالة")

# 6. نصّ فارغ: أصغر مغلَّف ممكن — يجب أن يفكّ إلى نصّ فارغ بلا خطأ
اطبع_سطر(فك_تشفير_موثق(شفر_موثق("", "مفتاح"), "مفتاح") == "")

# 7. طول مغلَّف النصّ الفارغ = 28 بايت بالضبط (nonce 12 + tag 16 + نصّ مشفَّر 0) = 56 حرفًا ست عشريًّا
اطبع_سطر(طول(شفر_موثق("", "مفتاح")))

# 8. عشوائيّة nonce: تشفير نفس النصّ الفارغ مرّتين ⇒ مغلَّفان مختلفان (nonce فقط يفرّق بينهما)
اطبع_سطر(شفر_موثق("", "مفتاح") != شفر_موثق("", "مفتاح"))

# 9. تشفير نصّ يحوي محارف عربيّة متعدّدة البايت + مسافات + رموزًا مختلطة، طويلًا
متغير نصّ_مختلط = كرّر("عربي-Mixed_123!؟ ", 100)
اطبع_سطر(فك_تشفير_موثق(شفر_موثق(نصّ_مختلط, "م"), "م") == نصّ_مختلط)

# 10. سلسلة تشفير/فكّ متتابعة (10 مرّات) على نصوص متتالية الطول — لا تراكم خطأ
متغير س = "بداية"
متغير ي = 0
بينما (ي < 10)
	س = فك_تشفير_موثق(شفر_موثق(س, "مفتاح_متكرّر"), "مفتاح_متكرّر")
	ي = ي + 1
نهاية
اطبع_سطر(س == "بداية")
