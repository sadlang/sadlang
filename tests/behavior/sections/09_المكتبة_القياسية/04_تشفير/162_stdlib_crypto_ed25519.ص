# ============================================================
# Ed25519 — توقيع رقميّ حتميّ على منحنى Edwards25519 (RFC 8032).
# تنفيذ ذاتيّ بالكامل (بلا OpenSSL): نقاط بإحداثيّات ممدَّدة + SHA-512
# مكتوب طازجًا (FIPS 180-4) + اختزال سلميّ mod L. مطابق حرفيًّا بين
# المفسّر والمترجم. تحقق_توقيع دالّة استعلام: تُرجع منطقيًّا ولا ترمي أبدًا.
# ============================================================
استورد تشفير

# 1. RFC 8032 §7.1 TEST 1: اشتقاق المفتاح العامّ من البذرة الخاصّة
اطبع_سطر(اشتق_مفتاح_عام_توقيع("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"))

# 2. TEST 1: توقيع الرسالة الفارغة (توقيع حتميّ 128 حرفًا)
اطبع_سطر(وقّع("", "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"))

# 3. RFC 8032 §7.1 TEST 2: المفتاح العامّ لبذرة أخرى
اطبع_سطر(اشتق_مفتاح_عام_توقيع("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"))

# 4. TEST 2: توقيع الرسالة "r" (البايت 0x72 المنصوص عليه في الشعاع)
اطبع_سطر(وقّع("r", "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"))

# 5. تحقّق ناجح من شعاع TEST 2
اطبع_سطر(تحقق_توقيع("r", "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00", "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"))

# 6. رفض رسالة مُعبَث بها ("s" بدل "r") — التوقيع لم يعد صالحًا
اطبع_سطر(تحقق_توقيع("s", "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00", "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"))

# 7. رفض توقيع مُعبَث به (أوّل بايت 0x92⇒0x93) على نفس الرسالة والمفتاح
اطبع_سطر(تحقق_توقيع("r", "93a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00", "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"))

# 8. رفض مفتاح عامّ خاطئ (مفتاح TEST 1 على توقيع TEST 2)
اطبع_سطر(تحقق_توقيع("r", "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00", "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"))

# 9. دورة كاملة مولّدة عشوائيًّا: وقّع ثمّ تحقّق ⇒ صحيح
متغير خاص = ولّد_مفتاح_خاص_توقيع()
متغير عام = اشتق_مفتاح_عام_توقيع(خاص)
متغير توقيع = وقّع("رسالة عربيّة مهمّة للاختبار", خاص)
اطبع_سطر(تحقق_توقيع("رسالة عربيّة مهمّة للاختبار", توقيع, عام))

# 10. حتميّة التوقيع: نفس (الرسالة، المفتاح) ⇒ نفس التوقيع دومًا
اطبع_سطر(وقّع("x", خاص) == وقّع("x", خاص))

# 11. مدخل توقيع مشوَّه (طول خاطئ) لا يرمي — يُرجع خطأ (دالّة استعلام)
اطبع_سطر(تحقق_توقيع("r", "abcd", عام))
