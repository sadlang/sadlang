# @description تعداد جبريّ: مطابقة متداخلة على حمولةٍ ديناميّة مستخرَجة (نوعُها Any/%SadDyn) بمعاملٍ غير مصرَّح. الحمولة المُستخرَجة تصل مغلّفةً في %SadDyn، فيجب فكّ مؤشّرها قبل فحص الوسم (ENUM_IS_VARIANT) لا IntToPtr على البنية.
# @expected 0\n9
# @priority P1

# ============================================================
# «غلاف» يحمل قيمةً بلا نوعٍ مصرَّح ⇒ حمولتها ديناميّة (%SadDyn).
# نستخرجها في «م» ثمّ نُطابقها كتعداد «لون» — «عندما أحمر:» وحدويٌّ عارٍ
# على حمولةٍ مغلّفةٍ في %SadDyn: لا يجوز IntToPtr على البنية.
# ============================================================
تعداد صندوق
    غلاف(محتوى)
نهاية

تعداد لون
    أحمر
    أزرق(درجة)
نهاية

دالة افحص(ص)
    طابق (ص)
        عندما غلاف(م):
            طابق (م)
                عندما أحمر:
                    ارجع 0
                عندما أزرق(د):
                    ارجع د
            نهاية
    نهاية
نهاية

اطبع_سطر(نص(افحص(غلاف(أحمر))))
اطبع_سطر(نص(افحص(غلاف(أزرق(9)))))
