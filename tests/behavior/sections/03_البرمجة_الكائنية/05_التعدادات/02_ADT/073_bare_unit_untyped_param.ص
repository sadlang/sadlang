# @description تعداد جبريّ: مطابقة معاملٍ وحدويٍّ عارٍ (غير مؤهَّل) على معاملٍ مجهول النوع — نمط مقيّم AST للاستضافة الذاتيّة. يُستنتَج تعداد المطابقة من ذراع البانِي الشقيق فلا يبتلع «عندما ورقة:» بقيّة الحالات.
# @expected 3\n0\n7\n30
# @priority P1

# ============================================================
# مقيّم شجرة تعبير — معامل الدالّة «ع» بلا نوع مصرَّح (كحال عقد AST).
# «عندما ورقة:» معاملٌ وحدويٌّ عارٍ يجب أن يكون فحصَ وسمٍ لا رباطًا شاملًا.
# ============================================================
تعداد تعبير
    ورقة
    عقدة(يسار، يمين)
نهاية

دالة عدّ_الأوراق(ع)
    طابق (ع)
        عندما ورقة:
            ارجع 1
        عندما عقدة(يس، يم):
            ارجع عدّ_الأوراق(يس) + عدّ_الأوراق(يم)
    نهاية
نهاية

اطبع_سطر(نص(عدّ_الأوراق(عقدة(ورقة، عقدة(ورقة، ورقة)))))

# ============================================================
# وحدويّ عارٍ + معاملٌ متعدّد الحقول، معاملُ الدالّة بلا نوع مصرَّح.
# ============================================================
تعداد حالة
    فارغ
    ممتلئ(أول، ثاني)
نهاية

دالة افحص(ح)
    طابق (ح)
        عندما فارغ:
            ارجع 0
        عندما ممتلئ(أ، ب):
            ارجع أ + ب
    نهاية
نهاية

اطبع_سطر(نص(افحص(فارغ)))
اطبع_سطر(نص(افحص(ممتلئ(3، 4))))
اطبع_سطر(نص(افحص(ممتلئ(10، 20))))
