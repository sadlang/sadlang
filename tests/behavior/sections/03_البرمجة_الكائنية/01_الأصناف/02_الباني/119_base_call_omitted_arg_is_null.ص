# @description «الأساس(...)» بوسيطٍ مُغفَل — الخانةُ الناقصةُ عدمٌ في سلسلةِ بانيَ الوراثة
# @expected أب:1\nأب-عدم:صحيح\nابن:5\nابن-عدم:صحيح\nحفيد:9\nحفيد-عدم:صحيح\nمكتمل:3\nمكتمل-عدم:خطأ

# ============================================================
# (AR) نداءُ `الأساس(...)` كان يُغفِلُ تبطينَ الوسيطِ الناقص، ويسلكُ مسارًا
#      **غيرَ** مسارِ الباني المباشر: فهو يمرُّ بمُضمِّنِ الواجهةِ الأماميّة.
#      وحلقةُ خريطةِ المعاملاتِ هناك كانت تقفُ عند أقصرِ الطرفَين، فمعاملٌ لم
#      يبلغْه وسيطٌ يخرجُ من الخريطةِ ويصيرُ سجلًّا لا يُعرَّفُ قطّ.
#
#      المقيسُ قبلَ الإصلاح:
#        المفسّر  ⇒ لا يربطُ شيئًا («الكلُّ أو لا شيء») ⇒ «ابن-عدم:خطأ»
#        المصرِّف ⇒ LLVM CodeGen Error: Undefined register:%_inl0_وسم
#                   ثمّ **يخرجُ برمزِ صفرٍ رغمَها** — فتجتازُ كلَّ بوّابةٍ
#                   تحتكمُ إلى رمزِ الخروجِ وحدَه.
#
# ⚠️ ولا يُستعمَلُ هنا مُعينٌ نصّيٌّ (طريقةٌ تأخذُ «بادئة») عمدًا: عيبٌ منفصلٌ
#      قائمٌ يجعلُ المعاملَ النصّيَّ في الطريقةِ يُطبَعُ عنوانًا خامًّا، فيُفسِدُ
#      خرجَ هذه البذرةِ لسببٍ لا صلةَ له بموضوعِها.
# ============================================================

صنف أساسيّ
    متغير عام مِعرّف
    متغير عام وسم

    باني(مِعرّف، وسم)
        هذا.مِعرّف = مِعرّف
        هذا.وسم = وسم
    نهاية
نهاية

# (AR) الابنُ يُغفِلُ «وسم» عمدًا ⇒ يجب أن يصلَ الأبَ عدمًا لا صفرًا
صنف مشتقّ يرث أساسيّ
    باني(مِعرّف)
        الأساس(مِعرّف)
    نهاية
نهاية

# (AR) والحفيدُ يُمرّرُ الاثنَين ⇒ لا تبطينَ أصلًا (ضابطُ عدمِ الإفراط)
صنف مشتقّ_كامل يرث أساسيّ
    باني(مِعرّف، وسم)
        الأساس(مِعرّف، وسم)
    نهاية
نهاية

متغير مباشر = أساسيّ(1)
اطبع_سطر("أب:" + نص(مباشر.مِعرّف))
اطبع_سطر("أب-عدم:" + نص(مباشر.وسم == لاشيء))

متغير ناقص = مشتقّ(5)
اطبع_سطر("ابن:" + نص(ناقص.مِعرّف))
اطبع_سطر("ابن-عدم:" + نص(ناقص.وسم == لاشيء))

متغير كامل = مشتقّ_كامل(9، لاشيء)
اطبع_سطر("حفيد:" + نص(كامل.مِعرّف))
اطبع_سطر("حفيد-عدم:" + نص(كامل.وسم == لاشيء))

# (AR) ضابطٌ: وسمٌ حقيقيٌّ عبرَ «الأساس» ⇒ ليس عدمًا — كي لا يمرَّ الاختبارُ
#      لو صارَ كلُّ شيءٍ عدمًا بالخطأ.
متغير مكتمل = مشتقّ_كامل(3، 77)
اطبع_سطر("مكتمل:" + نص(مكتمل.مِعرّف))
اطبع_سطر("مكتمل-عدم:" + نص(مكتمل.وسم == لاشيء))
