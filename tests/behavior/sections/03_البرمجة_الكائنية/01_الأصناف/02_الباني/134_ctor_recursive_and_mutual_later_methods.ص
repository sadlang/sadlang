# @description حارس حدّي (عائلة t054): الباني ينادي طريقة لاحقة عودية (مضروب) وطريقتين لاحقتين
#              متنادّتين تبادليًّا (زوجي/فردي) — الاستنتاج المسبق لا يدخل حلقة ويعطي النوع الصحيح
# @expected 120\nصحيح\nخطأ
# @priority P1

صنف عوديات
    متغير عام مضروب_خمسة = 0
    متغير عام زوجية_عشرة = خطأ
    متغير عام زوجية_سبعة = صحيح

    باني()
        هذا.مضروب_خمسة = هذا.مضروب(5)
        هذا.زوجية_عشرة = هذا.أزوجي(10)
        هذا.زوجية_سبعة = هذا.أزوجي(7)
    نهاية

    دالة عام مضروب(ن)
        إذا (ن <= 1)
            ارجع 1
        نهاية
        ارجع ن * هذا.مضروب(ن - 1)
    نهاية

    دالة عام أزوجي(ن)
        إذا (ن == 0)
            ارجع صحيح
        نهاية
        ارجع هذا.أفردي(ن - 1)
    نهاية

    دالة عام أفردي(ن)
        إذا (ن == 0)
            ارجع خطأ
        نهاية
        ارجع هذا.أزوجي(ن - 1)
    نهاية
نهاية

متغير ع = عوديات()
اطبع_سطر(ع.مضروب_خمسة)
اطبع_سطر(ع.زوجية_عشرة)
اطبع_سطر(ع.زوجية_سبعة)
