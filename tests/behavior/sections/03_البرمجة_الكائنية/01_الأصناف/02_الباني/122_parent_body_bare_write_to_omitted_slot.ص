# @description الإسنادُ العاري في جسمِ الأبِ يبلغُ المعامِلَ الحاجبَ لا الحقل
# @expected أب-عارٍ:1\nمباشر:42\nمحفوظ:7

# ============================================================
# (AR) `وسم` **معامِلٌ** في `باني(مِعرّف، وسم)`، فالإسنادُ العاري في جسمِ الأبِ
#      يبلغُ المعامِلَ لا الحقل — والمعامِلُ يحجبُ الحقلَ ذا الاسمِ نفسِه. فالحقلُ
#      يبقى على تهيئتِه `١`، وهو ما يقولُه المحرّكانِ معًا.
#
#      وضابطُ «مباشر» يقابلُه: `وسم` هناك **ليس** معامِلًا، فالإسنادُ العاري
#      يكتبُ الحقلَ `٤٢`. فالفارقُ بينَ السطرَينِ هو المادّةُ بعينِها: الحجبُ
#      بالمعامِلِ لا بالوراثة.
#
#      والضابطُ الثالث «محفوظ»: أبٌ لا يمسُّ الخانةَ ⇒ الحقلُ يبقى على تهيئتِه.
# ============================================================

صنف أساسيّ
    متغير عام وسم = 1
    متغير عام مِعرّف

    باني(مِعرّف، وسم)
        هذا.مِعرّف = مِعرّف
        وسم = 42
    نهاية
نهاية

صنف مشتقّ يرث أساسيّ
    باني(مِعرّف)
        الأساس(مِعرّف)
    نهاية
نهاية

اطبع_سطر("أب-عارٍ:" + نص(مشتقّ(9).وسم))

# (AR) ضابطُ الدلالة: الإسنادُ نفسُه بلا وراثة
صنف مفرد
    متغير عام وسم = 1

    باني()
        وسم = 42
    نهاية
نهاية

اطبع_سطر("مباشر:" + نص(مفرد().وسم))

# (AR) ضابطٌ مقابل: خانةٌ مُغفَلةٌ لم يمسَّها الجسم ⇒ التهيئةُ تصمد
صنف أساسيّ2
    متغير عام لقب = 7
    متغير عام رقم

    باني(رقم، لقب)
        هذا.رقم = رقم
    نهاية
نهاية

صنف مشتقّ2 يرث أساسيّ2
    باني(رقم)
        الأساس(رقم)
    نهاية
نهاية

اطبع_سطر("محفوظ:" + نص(مشتقّ2(4).لقب))
