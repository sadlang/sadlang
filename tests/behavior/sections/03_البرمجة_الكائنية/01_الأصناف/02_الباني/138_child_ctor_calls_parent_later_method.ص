# @description حارس حدّي (تقاطع t054 مع الوراثة): باني الابن ينادي طريقة الأب المعرَّفة بعد بانيه،
#              وطريقة موروثة تنادي طريقة لاحقة في الأب — القفز الأمامي عبر حدود الوراثة
# @expected 20\n30
# @priority P1

صنف قاعدة_حساب
    متغير عام أساس = 0

    باني(ن)
        هذا.أساس = هذا.ضاعف(ن)
    نهاية

    دالة عام عبر_موروثة(ن)
        ارجع هذا.ثلاثي(ن)
    نهاية

    دالة عام ضاعف(ن)
        ارجع ن * 2
    نهاية

    دالة عام ثلاثي(ن)
        ارجع ن * 3
    نهاية
نهاية

صنف مشتق_حساب يرث قاعدة_حساب
    باني(ن)
        الأساس(ن)
    نهاية
نهاية

متغير م = مشتق_حساب(10)
اطبع_سطر(م.أساس)
اطبع_سطر(م.عبر_موروثة(10))
