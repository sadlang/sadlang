# @description حارس حدّي (عائلة t054): سلسلة قفزتين أماميتين — الباني ينادي طريقة لاحقة تنادي
#              طريقة أحدث منها؛ وطريقة أولى تنادي الأخيرة مباشرة
# @expected 24\n34
# @priority P1

صنف سلسلة
    متغير عام ناتج = 0

    باني(ن)
        هذا.ناتج = هذا.أولى(ن)
    نهاية

    دالة عام أولى(ن)
        ارجع هذا.ثانية(ن) * 2
    نهاية

    دالة عام ثانية(ن)
        ارجع هذا.ثالثة(ن) + 2
    نهاية

    دالة عام ثالثة(ن)
        ارجع ن * 2
    نهاية
نهاية

متغير س = سلسلة(5)
اطبع_سطر(س.ناتج)
اطبع_سطر(س.أولى(6) + س.ثالثة(3))
