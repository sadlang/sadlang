# @description حارس انحدار SEM045: نداء طريقة معرَّفة لاحقًا في جسم الصنف — من الباني ومن طريقة أسبق —
#              يجب أن تصل قيمته (لا «لاشيء») حقلًا ومحليًّا؛ ونداء دالة قالب بلا نوع إرجاع مصرَّح
#              طرفًا حسابيًّا يجب ألّا يرفضه فحص الأنواع كذبًا بـ«وُجد 'فراغ'».
#              (الجانيان المقيسان: تسجيل المرحلة 1.3 المسبق كان يدوّن Void لغياب التصريح فتُسقط
#              أذرع ConstantVoid السجل، وفاحص الأنواع كان يختم نداء القالب بنوع خانته الخام.)
# @expected 8\n8\n8\n12\n7
# @priority P1

صنف حاسبة
    متغير عام قيمة = 0
    متغير عام من_محلي = 0

    باني(ن)
        # نداء طريقة تُعرَّف لاحقًا — خزن مباشر في حقل
        هذا.قيمة = هذا.ضعف(ن)
        # الخزن عبر محلي وسيط (ذراع STORE المحلي)
        متغير وسيط = هذا.ضعف(ن)
        هذا.من_محلي = وسيط
    نهاية

    دالة عام حدّد_ثلاثي(ن)
        # طريقة أسبق تنادي طريقة لاحقة
        ارجع هذا.ثلاثي(ن)
    نهاية

    دالة عام ضعف(ن)
        ارجع ن * 2
    نهاية

    دالة عام ثلاثي(ن)
        ارجع ن * 3
    نهاية
نهاية

قالب <نوع ت>
دالة هوية(ت س) ارجع س نهاية

متغير ح = حاسبة(4)
اطبع_سطر(ح.قيمة)
اطبع_سطر(ح.من_محلي)
اطبع_سطر(ح.ضعف(4))
اطبع_سطر(ح.حدّد_ثلاثي(4))
اطبع_سطر(هوية(5) + هوية(2))
