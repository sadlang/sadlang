# @description سلسلةٌ ثلاثيّةُ المستويات: ما يكتبُه الجدُّ يراهُ الوسيطُ بعدَ «الأساس»
# @expected وسيط-يرى:9\nمعامِل:77\nحقل:9

# ============================================================
# (AR) الحجبُ في المادّةِ (١) حكمُ **مستوًى** لا حكمُ سلسلة. فـ`سمة` معامِلٌ في
#      `طرف` وحدَه؛ أمّا جسمُ `جدّ` فالاسمُ العاري فيه يدلُّ على الحقل، فكتابتُه
#      `٩` تبلغُ الكائن. وجسمُ `وسيط` كذلك لا يملكُ `سمة` معامِلًا، فقراءتُه بعدَ
#      `الأساس(...)` يجبُ أن تُعطيَ ما في الكائنِ لا نسخةً بائتة.
#
#      وهذه البذرةُ ثلاثيّةُ المستوياتِ عمدًا: البذورُ ذاتُ المستويَينِ تمرُّ ولو
#      كانَ الخروجُ من مستوًى يستعيدُ قيمةً مأخوذةً عندَ الدخول — إذ لا مستوى
#      وسيطَ يقرأُ بعدَها. فبمستويَينِ يبقى العيبُ غيرَ مرئيّ.
#
#      وضابطُ «معامِل» يُثبِّتُ الطرفَ المقابل: `طرف` بعدَ عودةِ السلسلةِ يقرأُ
#      **معامِلَه** `٧٧` لا ما كتبَه الجدّ — وإلّا سقطَت المادّةُ (١) نفسُها.
# ============================================================

صنف جدّ
    متغير عام سمة = 1

    باني(قيمة)
        سمة = 9
    نهاية
نهاية

صنف وسيط يرث جدّ
    باني(قيمة)
        الأساس(قيمة)
        اطبع_سطر("وسيط-يرى:" + نص(سمة))
    نهاية
نهاية

صنف طرف يرث وسيط
    باني(سمة، قيمة)
        الأساس(قيمة)
        اطبع_سطر("معامِل:" + نص(سمة))
    نهاية
نهاية

متغير كائن = طرف(77, 3)
اطبع_سطر("حقل:" + نص(كائن.سمة))
