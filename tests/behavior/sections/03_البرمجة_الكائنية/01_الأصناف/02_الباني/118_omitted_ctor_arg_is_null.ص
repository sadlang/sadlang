# @description الوسيطُ المُغفَلُ في الباني عدمٌ لا فراغ — حارسُ «!= لاشيء» يقصرُ دائرةَ «و»
# @expected 80\n443\nصحيح\nخطأ\nعدم\nرقم\nم:صحيح\nم:7
# @priority P1

# ============================================================
# (AR) العطبُ المقيس: الوسيطُ الذي لا يُمرَّر ولا افتراضيَّ له كان يُربَط
#      بـ`Value()` أي **فراغًا (Void)**، وvalue.h:244 ينصُّ أنّ العدمَ نوعٌ
#      متمايزٌ عن الفراغِ تمامًا (S-TS-P1). فكان:
#
#          منفذ == لاشيء   ⇒  خطأ      ← والمعاملُ لم يُمرَّرْ أصلًا
#          منفذ != لاشيء   ⇒  صحيح     ← فيمرُّ الحارس
#          منفذ > 0        ⇒  SEM010   ← «لا تُدعَم إلّا == و!=» على فراغ
#
#      وهو النمطُ الذي تقومُ عليه المكتبةُ القياسيّة (شبكات.ص:90 · 678 · 809)،
#      فكان `وصلة_آمنة("مضيف")` بلا منفذٍ يُسقِطُ ستّةَ اختباراتِ شبكة.
# ============================================================

صنف وصلة
    متغير خاص _منفذ
    متغير خاص _مهلة

    باني(مضيف، منفذ، مهلة)
        # (AR) الحارسُ المعياريّ: يجب أن يقصرَ «و» دائرتَه فلا يُقيَّم «> 0»
        إذا (منفذ != لاشيء و منفذ > 0)
            هذا._منفذ = منفذ
        وإلا
            هذا._منفذ = 443
        نهاية
        هذا._مهلة = مهلة
    نهاية

    دالة المنفذ()
        ارجع هذا._منفذ
    نهاية

    دالة هل_المهلة_عدم()
        ارجع هذا._مهلة == لاشيء
    نهاية

    دالة نوعُ_المهلة()
        ارجع نوع(هذا._مهلة)
    نهاية
نهاية

# (AR) وسيطٌ صريحٌ ⇒ يُستعمَل
متغير صريحة = وصلة("س"، 80، 30)
اطبع_سطر(صريحة.المنفذ())

# (AR) وسيطانِ مُغفَلان ⇒ عدمٌ، فيسقطُ الحارسُ إلى الافتراضيّ بلا خطأ
متغير مُغفَلة = وصلة("ص")
اطبع_سطر(مُغفَلة.المنفذ())
اطبع_سطر(مُغفَلة.هل_المهلة_عدم())
اطبع_سطر(صريحة.هل_المهلة_عدم())
اطبع_سطر(مُغفَلة.نوعُ_المهلة())
اطبع_سطر(صريحة.نوعُ_المهلة())

# (AR) تمريرٌ جزئيّ: المُمرَّرُ يُستعمَلُ والمُغفَلُ يبقى عدمًا
متغير جزئيّة = وصلة("ع"، 7)
اطبع_سطر("م:" + نص(جزئيّة.هل_المهلة_عدم()))
اطبع_سطر("م:" + نص(جزئيّة.المنفذ()))
