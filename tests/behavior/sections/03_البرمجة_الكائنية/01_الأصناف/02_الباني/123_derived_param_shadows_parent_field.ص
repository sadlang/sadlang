# @description معامِلُ المشتقِّ يحجبُ حقلَ الأبِ الذي يوافقُه اسمًا عبرَ السلسلة
# @expected حجب:1\nقراءة:7\nحقل-الأب:42\nمستقلّ:5

# ============================================================
# (AR) المادّةُ (١) حكمُ النطاقِ المسطَّحِ لا حكمُ مستوًى واحد. فـ`وسم` معامِلٌ
#      **للمشتقّ**، وليسَ معامِلًا للأب. فحينَ ينتهي مستوى الأبِ ويكتبُ نطاقَه
#      راجعًا إلى الحقول، لا يجوزُ أن يحملَ `وسم` إلى الحقلِ — فالنطاقُ يحملُ
#      عندَه قيمةَ **معامِلِ المشتقّ** لا قيمةَ حقلٍ. والحقلُ يبقى على تهيئتِه `١`.
#
#      وضابطُ «قراءة»: جسمُ المشتقِّ بعدَ `الأساس(...)` يقرأُ معامِلَه هو، لا ما
#      كتبَه جسمُ الأبِ عاريًا في الاسمِ نفسِه.
#
#      وضابطُ «حقل-الأب» هو الوجهُ المقابل، وهو ما لا يكفي فحصُ القراءةِ وحدَه:
#      جسمُ الأبِ يكتبُ `علامة = 42` عاريًا، و`علامة` ليس معامِلًا **له**، فالمادّةُ
#      (٢) تُلزِمُ بلوغَ الحقل. وحارسٌ يمنعُ الكتابةَ لأنّ الاسمَ معامِلٌ عندَ
#      **المشتقّ** يبتلعُ كتابةً مشروعةً — فعلٌ عن بُعدٍ صامت: تسميةُ معامِلٍ في
#      صنفٍ مشتقٍّ تُغيّرُ حقلًا في صنفٍ أساسيّ.
#
#      وضابطُ «مستقلّ»: اسمٌ لا يتقاطعُ ⇒ الإسنادُ العاري في الأبِ يبلغُ الحقل.
# ============================================================

صنف أساسيّ
    متغير عام وسم = 1
    باني(معطى)
    نهاية
نهاية

صنف مشتقّ يرث أساسيّ
    باني(وسم، معطى)
        الأساس(معطى)
    نهاية
نهاية

متغير كائن = مشتقّ(7, 3)
اطبع_سطر("حجب:" + نص(كائن.وسم))

صنف أساسيّ2
    متغير عام علامة = 1
    باني(معطى)
        علامة = 42
    نهاية
نهاية

صنف مشتقّ2 يرث أساسيّ2
    باني(علامة، معطى)
        الأساس(معطى)
        اطبع_سطر("قراءة:" + نص(علامة))
    نهاية
نهاية

متغير كائن2 = مشتقّ2(7, 3)
اطبع_سطر("حقل-الأب:" + نص(كائن2.علامة))

صنف أساسيّ3
    متغير عام رقم = 1
    باني(معطى)
        رقم = 5
    نهاية
نهاية

صنف مشتقّ3 يرث أساسيّ3
    باني(معطى)
        الأساس(معطى)
    نهاية
نهاية

اطبع_سطر("مستقلّ:" + نص(مشتقّ3(3).رقم))
