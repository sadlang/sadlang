# @description حارس حدّي (تقاطع t054 مع المرجع الأمامي للصنف): باني صنف أسبق ينشئ صنفًا لاحقًا
#              وينادي طريقته اللاحقة أيضًا — القفزتان الأماميتان معًا (صنف ثم طريقة)
# @expected 21\nمرافق:عمل
# @priority P1

صنف قائد
    متغير عام محصلة = 0
    متغير عام رسالة = ""

    باني(ن)
        متغير م = مرافق(ن)
        هذا.محصلة = م.ثلاثي()
        هذا.رسالة = م.وصف("عمل")
    نهاية
نهاية

صنف مرافق
    متغير عام قيمة = 0

    باني(ن)
        هذا.قيمة = ن
    نهاية

    دالة عام ثلاثي()
        ارجع هذا.قيمة * 3
    نهاية

    دالة عام وصف(س)
        ارجع "مرافق:" + س
    نهاية
نهاية

متغير ق = قائد(7)
اطبع_سطر(ق.محصلة)
اطبع_سطر(ق.رسالة)
