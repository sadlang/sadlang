# @description كتابةُ جسمِ المشتقِّ بعدَ «الأساس(...)» تصمدُ ولو كان الاسمُ خانةً مُغفَلة
# @expected مستويان:42\nثلاثة:99\nبلا-وراثة:42

# ============================================================
# (AR) الاسمُ الذي بُطّن بعدمٍ عندَ مستوى الأبِ يُستردُّ إلى قيمةِ الحقلِ في
#      الكائن، لا يُستثنى من الكتابةِ الراجعة. فاستثناءٌ أبديٌّ كان يبتلعُ
#      `وسم = 42` في جسمِ المشتقِّ **صامتًا** — والدلالةُ المعتمَدةُ أنّ إسنادَ
#      اسمِ حقلٍ داخلَ بانٍ يكتبُ الحقل، كما يُثبتُه ضابطُ «بلا-وراثة» أدناه.
#
# (AR) والمحرّكانِ يتطابقانِ الآن: كان المصرِّفُ يُخفِقُ في الثلاثةِ (`١ · ٥ · ١`)
#      لأنّ مُدمِجَ الدوالِّ السطريَّ كان يدمِجُ البُناةَ فيُصدّرُ سجلّاتِها ببادئةِ
#      `_inlN_`، فينقطعُ تطابقُ اسمِ خانةِ الحقلِ باسمِ الحقل، فتسقطُ إلى مكدَّسٍ
#      محلّيٍّ في المستدعي يُهمَل. ومُنِعَ الآن دمجُ البانِي سطريًّا برايةٍ صريحة.
# ============================================================

صنف أساسيّ
    متغير عام وسم = 1
    متغير عام مِعرّف

    باني(مِعرّف، وسم)
        هذا.مِعرّف = مِعرّف
    نهاية
نهاية

صنف مشتقّ يرث أساسيّ
    باني(مِعرّف)
        الأساس(مِعرّف)
        وسم = 42
    نهاية
نهاية

متغير ك = مشتقّ(1)
اطبع_سطر("مستويان:" + نص(ك.وسم))

# (AR) وثلاثةُ مستوياتٍ: الكتابةُ في أدنى المستوياتِ تصمدُ كذلك
صنف جدّ
    متغير عام لقب = 5
    متغير عام رمز

    باني(رمز، لقب)
        هذا.رمز = رمز
    نهاية
نهاية

صنف وسيط يرث جدّ
    باني(رمز)
        الأساس(رمز)
    نهاية
نهاية

صنف حفيد يرث وسيط
    باني(رمز)
        الأساس(رمز)
        لقب = 99
    نهاية
نهاية

متغير ح = حفيد(2)
اطبع_سطر("ثلاثة:" + نص(ح.لقب))

# (AR) ضابطُ الدلالة: الإسنادُ نفسُه بلا وراثةٍ يكتبُ الحقلَ في المحرّكَين
صنف مفرد
    متغير عام وسم = 1

    باني()
        وسم = 42
    نهاية
نهاية

متغير م = مفرد()
اطبع_سطر("بلا-وراثة:" + نص(م.وسم))
