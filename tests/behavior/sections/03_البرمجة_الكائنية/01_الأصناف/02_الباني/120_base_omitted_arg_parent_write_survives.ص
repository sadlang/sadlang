# @description «الأساس(...)» بوسيطٍ مُغفَل — كتابةُ جسمِ الأبِ تصمدُ ولا تُدهَسُ باستردادِ التبطين
# @expected قيمة:1.0\nنوع:عشري\nسليم:9\nمحفوظ:7

# ============================================================
# (AR) حقلٌ مُهيَّأٌ بقيمةٍ، ووسيطٌ مُغفَلٌ يحملُ اسمَه، وجسمُ الأبِ يُسنِدُ إليه
#      قيمةً **مساويةً رقميًّا ومختلفةَ النوع**. وهذه بالضبطِ الحالةُ التي
#      كسرَها استدلالٌ سابقٌ بمقارنةِ الحقلِ قبلَ/بعد: `Value::operator==`
#      يقارنُ عبرَ الأنواعِ فـ`1 == 1.0` صحيح، فيُقرَأُ «لم يكتبِ الأبُ» فتُستردُّ
#      `1` فوقَ كتابتِه — انحدارٌ في المفسّرِ وتباعُدٌ عن المصرِّفِ الذي يُبقي `عشري`.
# ============================================================

صنف أساسيّ
    متغير عام وسم = 1
    متغير عام مِعرّف

    باني(مِعرّف، وسم)
        هذا.مِعرّف = مِعرّف
        هذا.وسم = 1.5 - 0.5
    نهاية
نهاية

صنف مشتقّ يرث أساسيّ
    باني(مِعرّف)
        الأساس(مِعرّف)
    نهاية
نهاية

متغير ك = مشتقّ(9)
اطبع_سطر("قيمة:" + نص(ك.وسم))
اطبع_سطر("نوع:" + نوع(ك.وسم))
اطبع_سطر("سليم:" + نص(ك.مِعرّف))

# (AR) وضابطٌ مقابل: أبٌ **لا** يمسُّ الخانةَ المُغفَلة ⇒ الحقلُ يبقى على تهيئتِه
#      ولا يمحوه تبطينُ العدم — وهو الوجهُ الآخرُ للاستثناءِ نفسِه.
صنف أساسيّ2
    متغير عام لقب = 7
    متغير عام رقم

    باني(رقم، لقب)
        هذا.رقم = رقم
    نهاية
نهاية

صنف مشتقّ2 يرث أساسيّ2
    باني(رقم)
        الأساس(رقم)
    نهاية
نهاية

متغير م = مشتقّ2(4)
اطبع_سطر("محفوظ:" + نص(م.لقب))
