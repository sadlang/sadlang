صنف أول
    دالة عام اصنع_ثانيًا(ن)
        متغير ث = ثانٍ()
        ارجع "من_الثاني:" + ث.ضعفه(ن) + ""
    نهاية

    دالة عام قيمته(ن)
        ارجع ن * 2
    نهاية
