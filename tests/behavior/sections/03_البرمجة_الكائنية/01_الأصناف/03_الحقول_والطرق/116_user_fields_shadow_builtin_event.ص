# @description حقول مستخدم بأسماء تطابق حقول صنف «حدث» المضمَّن (س/ص/قيمة) — تسجيل «حدث» غير المشروط في كلّ وحدة ترجمة (#251) جعل احتياطيّ «تخمين الصنف من اسم الحقل» في الخلفيّة يُرجِع «حدث» فيُبنى GEP بتخطيطه (س = double) فوق كائن المستخدم ⇒ حقل صحيح يُقرأ بتّات double ويُطبع 0.0، والوصول بعمق-2 يفشل، وعوامل الأصناف المحمَّلة تقرأ معاملها صفرًا (انحدار dev الثلاثيّ: p36/p11/bug11). صارت الأصناف المضمَّنة مستثناة من التخمين في المواقع السبعة.
# @expected 7\n10\n15\n4\n6\n11\n12
# @priority P0

صنف نقطة
    متغير عام س
    متغير عام ص

    باني(أ، ب)
        هذا.س = أ
        هذا.ص = ب
    نهاية

    دالة زائد(آخر)
        ارجع نقطة(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية
نهاية

صنف حاوية
    متغير عام داخل
    متغير عام قيمة

    باني(ن، ق)
        هذا.داخل = ن
        هذا.قيمة = ق
    نهاية
نهاية

# ── عمق-2: ح.داخل.س (عرَض p11/bug11 — كان يُطبع 0.0) ──
متغير ن = نقطة(7، 10)
متغير ح = حاوية(ن، 15)
اطبع_سطر(ح.داخل.س)
اطبع_سطر(ح.داخل.ص)
اطبع_سطر(ح.قيمة)

# ── معامل غير منمَّط يقرأ حقل «س» (عرَض p36 — كان التخمين يُرجع «حدث») ──
دالة اجلب_س(كائن)
    ارجع كائن.س
نهاية
متغير ن2 = نقطة(4، 6)
اطبع_سطر(اجلب_س(ن2))
اطبع_سطر(ن2.ص)

# ── عامل محمَّل يقرأ حقول معامله غير المنمَّط (عرَض p36) ──
متغير مجموع = ن2.زائد(ن)
اطبع_سطر(مجموع.س)
# كتابة حقل عبر التخمين (مسار mem_store) ثمّ قراءته
مجموع.ص = 12
اطبع_سطر(مجموع.ص)

# ── معالِج حدث مصرَّح بجوار صنف مستخدم بحقول مطابقة: حقول «ح» يجب أن تُحلّ
#    بتخطيط «حدث» المبذور من التصريح لا بتخمين «نقطة» (الاختطاف العكسيّ)؛
#    المعالِج يُعرَّف ولا يُستدعى (لا مواقعَ استدعاء ص لمعالِجات الأحداث) —
#    البوّابة هنا سلامةُ توليده مُترجَمًا لا مخرجاته ──
دالة معالج_حركة(حدث ح)
    ارجع ح.س + ح.دلتا_س
نهاية

# ── طريقة صنف بمعامل «حدث» مصرَّح: المحلّل كان يُسقط typeName لمعاملات
#    الطرق فلا يصل البذر إليها إطلاقًا (بينما يصل للدوالّ الحرّة) —
#    كالسابق تُعرَّف ولا تُستدعى، والبوّابة سلامة التوليد ──
صنف لوحة
    دالة سجل(حدث ح)
        ارجع ح.س + ح.دلتا_س
    نهاية
نهاية
