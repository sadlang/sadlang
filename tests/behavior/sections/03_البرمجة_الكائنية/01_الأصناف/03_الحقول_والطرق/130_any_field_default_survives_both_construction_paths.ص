# @description حقلٌ خانتُه «أي» بقيمةٍ افتراضيّة — يحملها في مساري الإنشاءِ كليهما، لا «لاشيء»
# @rule: gr.oop.field
# @expected بلا_بانٍ:5\nبلا_بانٍ_ضابط:7\nببانٍ:5\nببانٍ_ضابط:7\nمنطقي:صحيح\nعشري:2.5

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 المقيسُ قبل السدّ (٢٠٢٦-٠٨-١٧):
#
#          صنف س … أي ح = 5 … رقم ن = 7 … نهاية  ⇒  المفسّر «5» و«7»
#                                            المُترجَم «لاشيء» و«7»   · rc=0
#
#      والضابطُ `ن` في **الصنفِ نفسِه** يُثبِت أنّ العلّةَ في `أي` وحدَها لا
#      في القيمِ الافتراضيّة. بناءٌ ناجحٌ ومخرَجٌ كاذبٌ بلا تشخيص.
#
# (AR) 🔑 والعلّةُ من صنفِ علّةِ الثابتِ في VE011: جدولُ القيمِ الافتراضيّةِ كان
#      يسجّل نوعَ **الخانةِ** لا نوعَ **القيمة**، فيصل `Any` إلى المُطبِّقِ ولا
#      ذراعَ له، فيسقط في `default:` ويبقى الحقلُ صفرَ `memset` — ووسمُ %SadDyn
#      الصفريُّ هو وسمُ العدم، فتُقرأ «لاشيء».
#
# ═══════════════════════════════════════════════════════════════════
# (AR) ⚠️ ⚠️ ولماذا صنفانِ لا صنفٌ واحد: **مُطبِّقانِ توأمان**
# ═══════════════════════════════════════════════════════════════════
#
#      القيمُ الافتراضيّةُ تُكتَب في موضعَين يفترقان بوجودِ بانٍ وحدَه:
#      `mem_alloca.cpp` لصنفٍ بلا بانٍ، و`objects_arrays_ops.cpp` لصنفٍ ببانٍ.
#      والأوّلُ كان **يُعلِّب** القيمةَ في خانةِ %SadDyn، والثاني يكتب بتّاتِها
#      خامًّا فوق حقلَي {وسم، حمولة}.
#
#      وما دامت `أي` تسقط في `default:` لم يكن للفارقِ أثرٌ يُرى. فلمّا صار
#      لها ذراعٌ صار الفارقُ عطبًا — ولو أُصلِح توأمٌ واحدٌ لصار السلوكُ
#      **متقطّعًا بحسبِ وجودِ بانٍ**: أخضرَ في نصفِ المِجَسّاتِ وأحمرَ في
#      نصفِها، وهو أخفى ممّا لو كان مطّردًا لأنّه يُقرأ صدفةً.
#
#      ⇒ فيُقاس المساران معًا، كما قيس منفذا القراءةِ والكتابةِ في ٠٨٤/٠٨٦.
#
# (AR) ⚠️ والمنطقيُّ والعشريُّ في الصنفِ الثالثِ ليسا زيادة: تعليبُ `منطقي`
#      يمرّ بخانةِ `i1` وتعليبُ `عشري` بخانةِ `double`، وهما الطريقان اللذان
#      يفسد فيهما التمثيلُ إن كُتِبت البتّاتُ خامًّا. والعددُ وحدَه لا يكشفهما
#      لأنّ عرضَه عرضُ الحمولةِ نفسِه.
# ═══════════════════════════════════════════════════════════════════

صنف بلا_بانٍ
    أي مرن = 5
    رقم ثابتة = 7
نهاية

صنف ببانٍ
    أي مرن = 5
    رقم ثابتة = 7

    باني()
        # (AR) بانٍ لا يمسّ الحقلَين — القيمُ الافتراضيّةُ وحدَها هي المقيسة
    نهاية
نهاية

صنف عرائض
    أي علم = صحيح
    أي كسر = 2.5
نهاية

متغير أ = بلا_بانٍ()
اطبع_سطر("بلا_بانٍ:" + نص(أ.مرن))
اطبع_سطر("بلا_بانٍ_ضابط:" + نص(أ.ثابتة))

متغير ب = ببانٍ()
اطبع_سطر("ببانٍ:" + نص(ب.مرن))
اطبع_سطر("ببانٍ_ضابط:" + نص(ب.ثابتة))

متغير ج = عرائض()
اطبع_سطر("منطقي:" + نص(ج.علم))
اطبع_سطر("عشري:" + نص(ج.كسر))
