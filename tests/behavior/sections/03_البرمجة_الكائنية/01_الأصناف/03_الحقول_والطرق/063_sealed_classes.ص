# @description اختبار الأصناف المحكمة (Sealed Classes) — صنف محكم، وراثة من نفس الملف، دوال وحقول، تعدد أشكال، صنف مجرد محكم
# @expected شكل:دائرة\nمساحة_دائرة:78.5\nلون_دائرة:أحمر\nشكل:مربع\nمساحة_مربع:25\nلون_مربع:أزرق\nمساحة_مثلث:6\nمجموع:109.5\nحيوان:بسبوس\nصوت:مياو\nحيوان:ريكس\nصوت:هاو\nنوع:أليف\nنوع:أليف\nعدد_الأشكال:3\nنمط_حفظ:JSON\nنمط_حفظ:XML
# @priority P2

# ============================================================
# 1. صنف محكم أساسي — شكل هندسي
#    الأصناف المحكمة لا تسمح بالوراثة إلا من نفس الملف
# ============================================================
صنف محكم شكل
    متغير عام الاسم
    متغير عام اللون

    باني(اسم، لون)
        هذا.الاسم = اسم
        هذا.اللون = لون
    نهاية

    دالة عام وصف()
        ارجع "شكل:" + هذا.الاسم
    نهاية

    دالة عام مساحة()
        ارجع 0
    نهاية
نهاية

# ============================================================
# 2. أصناف ترث من الصنف المحكم (نفس الملف — مسموح)
# ============================================================
صنف دائرة يرث شكل
    متغير عام نصف_القطر

    باني(نصف_قطر، لون)
        الأساس("دائرة"، لون)
        هذا.نصف_القطر = نصف_قطر
    نهاية

    دالة عام مساحة()
        ارجع 3.14 * هذا.نصف_القطر * هذا.نصف_القطر
    نهاية
نهاية

صنف مربع يرث شكل
    متغير عام الضلع

    باني(ضلع، لون)
        الأساس("مربع"، لون)
        هذا.الضلع = ضلع
    نهاية

    دالة عام مساحة()
        ارجع هذا.الضلع * هذا.الضلع
    نهاية
نهاية

صنف مثلث يرث شكل
    متغير عام القاعدة
    متغير عام الارتفاع

    باني(قاعدة، ارتفاع، لون)
        الأساس("مثلث"، لون)
        هذا.القاعدة = قاعدة
        هذا.الارتفاع = ارتفاع
    نهاية

    دالة عام مساحة()
        ارجع (هذا.القاعدة * هذا.الارتفاع) / 2
    نهاية
نهاية

# ============================================================
# 3. استخدام الأصناف المحكمة — إنشاء وطباعة
# ============================================================
متغير د = دائرة(5، "أحمر")
اطبع_سطر(د.وصف())
اطبع_سطر("مساحة_دائرة:" + د.مساحة())
اطبع_سطر("لون_دائرة:" + د.اللون)

متغير م = مربع(5، "أزرق")
اطبع_سطر(م.وصف())
اطبع_سطر("مساحة_مربع:" + م.مساحة())
اطبع_سطر("لون_مربع:" + م.اللون)

متغير ث = مثلث(4، 3، "أخضر")
اطبع_سطر("مساحة_مثلث:" + ث.مساحة())

# ============================================================
# 4. تعدد الأشكال — حساب مجموع المساحات عبر مصفوفة (foreach)
# ============================================================
متغير أشكال = [د، م، ث]
متغير مجموع = عشري(0)
لكل ش في أشكال
    مجموع = مجموع + عشري(ش.مساحة())
نهاية
اطبع_سطر("مجموع:" + مجموع)

# ============================================================
# 5. صنف محكم مجرد — حيوان أليف
#    يجمع بين محكم ومجرد: لا يمكن إنشاؤه مباشرة
#    ولا يمكن وراثته من ملف خارجي
# ============================================================
صنف مجرد محكم حيوان_أليف
    متغير عام الاسم

    باني(اسم)
        هذا.الاسم = اسم
    نهاية

    دالة عام مجرد صوت()

    دالة عام نوع()
        ارجع "أليف"
    نهاية
نهاية

صنف قطة يرث حيوان_أليف
    باني(اسم)
        الأساس(اسم)
    نهاية

    دالة عام صوت()
        ارجع "مياو"
    نهاية
نهاية

صنف كلب يرث حيوان_أليف
    باني(اسم)
        الأساس(اسم)
    نهاية

    دالة عام صوت()
        ارجع "هاو"
    نهاية
نهاية

متغير ق = قطة("بسبوس")
متغير ك = كلب("ريكس")
اطبع_سطر("حيوان:" + ق.الاسم)
اطبع_سطر("صوت:" + ق.صوت())
اطبع_سطر("حيوان:" + ك.الاسم)
اطبع_سطر("صوت:" + ك.صوت())
اطبع_سطر("نوع:" + ق.نوع())
اطبع_سطر("نوع:" + ك.نوع())

# ============================================================
# 6. حساب عدد الأشكال
# ============================================================
اطبع_سطر("عدد_الأشكال:" + طول(أشكال))

# ============================================================
# 7. صنف محكم مع وراثة ودوال مختلفة
# ============================================================
صنف محكم محفوظ
    متغير عام البيانات

    باني(بيانات)
        هذا.البيانات = بيانات
    نهاية

    دالة عام نمط()
        ارجع "عام"
    نهاية
نهاية

صنف محفوظ_json يرث محفوظ
    باني(بيانات)
        الأساس(بيانات)
    نهاية

    دالة عام نمط()
        ارجع "JSON"
    نهاية
نهاية

صنف محفوظ_xml يرث محفوظ
    باني(بيانات)
        الأساس(بيانات)
    نهاية

    دالة عام نمط()
        ارجع "XML"
    نهاية
نهاية

متغير ج = محفوظ_json("بيانات1")
متغير س = محفوظ_xml("بيانات2")
اطبع_سطر("نمط_حفظ:" + ج.نمط())
اطبع_سطر("نمط_حفظ:" + س.نمط())
