# @description مُستقبِلٌ خانتُه «أي» (%SadDyn) — تُحمَّل الخانةُ ولا يُؤخَذ عنوانُها مؤشّرَ كائن
# @rule: gr.oop.member
# @expected حقل_عام:5\nطريقة_عام:5\nحقل_محلي:7\nطريقة_محلي:7\nكتابة_ثم_قراءة:9\nضابط_مكتوب:5\nضابط_مصفوفة:1

# ============================================================
# (AR) ما تحرسه هذه البذرة
#
#      خانةُ متغيّرٍ مُصرَّحٍ «أي» نوعُها المُخصَّصُ %SadDyn = {i8 وسم، i64 حمولة}.
#      و`namedValues` تُعيد **الخانةَ** لا القيمة. فكان مُصدِرُ الوصولِ إلى حقلٍ
#      يفحص «أهذه قيمةٌ موسومة؟» فيرى `ptr` (عنوانَ الخانة) فيحكم «لا»، فتنزلق
#      الخانةُ إلى مسارِ «مؤشّرٌ جاهز» — ويُستعمَل **عنوانُ الخانةِ** مؤشّرَ كائن.
#
#      فتُقرَأ بايتاتُ الوسمِ والحمولةِ حقولًا: `كائن_عام.قيمة` كان يُخرِج حمولةَ
#      المؤشّرِ عددًا (عدد فلكيّ) بينما يُخرِج المرجعُ 5 — **ورمزُ الخروجِ صفر**.
#      لا انهيارَ ولا تشخيص: جوابٌ خاطئٌ صامتٌ يقرؤه المستعمِلُ رقمًا.
#
#      🔑 والخانةُ نفسُها كانت **تُحمَّل مرّتَين في الـIR ثمّ تُهمَل الحِملتان**:
#      الحِملُ يُنتِج هيكلًا (%SadDyn) فلا هو صحيحٌ ولا مؤشّر، فتسقط نتيجتُه من
#      الفرعَين معًا ويبقى عنوانُ الخانة. فالعطبُ لم يكن «نسيانَ الحِمل» بل
#      **حِملًا يُطرَح ولا يُستعمَل** — وذلك ما لا يراه قارئُ الشيفرةِ بالعين.
#
# (AR) والضابطُ يفصل الخانةَ عن الصنف: المُستقبِلُ غيرُ الموسومِ (`متغير` — نوعُه مُستنتَجٌ ساكنًا) وخانةُ
#      المصفوفةِ الموسومةُ (`أي م = [...]`) كانا **أخضرَين** طوالَ الوقت — فليست
#      العلّةُ في الأصنافِ ولا في %SadDyn، بل في **مَن يقرأ خانتَها**.
# ============================================================

صنف عدّاد
    رقم قيمة

    باني()
        هذا.قيمة = 5
    نهاية

    دالة اقرأ()
        ارجع هذا.قيمة
    نهاية
نهاية

# ① خانةٌ عامّةٌ مُصرَّحةٌ «أي» — قراءةُ حقلٍ ونداءُ طريقة
أي كائن_عام = عدّاد()
اطبع_سطر("حقل_عام:" + نص(كائن_عام.قيمة))
اطبع_سطر("طريقة_عام:" + نص(كائن_عام.اقرأ()))

# ② خانةٌ محلّيّةٌ داخل دالّة — المسارُ الثاني (alloca بدل global)
دالة جرب_محلي()
    أي كائن_محلي = عدّاد()
    كائن_محلي.قيمة = 7
    اطبع_سطر("حقل_محلي:" + نص(كائن_محلي.قيمة))
    اطبع_سطر("طريقة_محلي:" + نص(كائن_محلي.اقرأ()))
نهاية
جرب_محلي()

# ③ الكتابةُ إلى حقلٍ عبر خانةٍ موسومة — التوأمُ الآخَر (object_set)
كائن_عام.قيمة = 9
اطبع_سطر("كتابة_ثم_قراءة:" + نص(كائن_عام.قيمة))

# ④ ضابطٌ: مُستقبِلٌ مكتوبٌ لا تمرّ خانتُه بـ%SadDyn أصلًا
متغير كائن_مكتوب = عدّاد()
اطبع_سطر("ضابط_مكتوب:" + نص(كائن_مكتوب.قيمة))

# ⑤ ضابطٌ: خانةُ %SadDyn نفسُها تعمل حين يُنادى بابُ التحميل (المصفوفات)
أي مصفوفة_موسومة = [1، 2، 3]
اطبع_سطر("ضابط_مصفوفة:" + نص(مصفوفة_موسومة[0]))
