# @description إرسالٌ افتراضيٌّ لطريقةٍ تُرجِعُ قيمةً موسومة — بترتيبَين لأنّ الموضعَ الأوّلَ يخفي العطب
# @expected أخيرا:20.5\nأولا:18.0
# @priority P1

# ============================================================================
# (AR) 🔑 ما تحرسُه هذه البذرةُ ليس «تعدّدَ الأشكال» بل **ذراعًا في PHI بلا قيمة**.
#      طريقةٌ افتراضيّةٌ فيها قسمةٌ (`(أ*ب)/2`) تُرجِعُ `%SadDyn` — قيمةً موسومةً
#      لأنّ ناتجَ القسمةِ قد يكون صحيحًا أو عشريًّا. وتطبيعُ نتائجِ الأذرعِ في
#      `objects_arrays_ops.cpp` كان سلسلةً مكتوبةً بيدٍ تعرفُ `i64` و`double`
#      و`ptr` ولا تعرفُ الموسوم، فيسقطُ ذراعُ ذلك الصنفِ إلى `poison`.
#
#      و`poison` في PHI **لا يُخفِق**: يقرأُ ما بقيَ في السجلّ. فالمقيسُ أنّ
#      `مجموع_الموسوم_أخيرا = مجموع_الموسوم_أخيرا + عشري(ع.قيمة())` أعطى مؤقَّتَ الدورةِ السابقةِ بدل نتيجةِ
#      الطريقة — بلا تحذيرٍ ولا خطأِ تحقّقٍ ولا انهيار.
#
#      ⚠️ **والترتيبان ليسا تكرارًا**: في الموضعِ الأخيرِ يقرأُ `poison` مؤقَّتًا
#      محمَّلًا فينحرفُ الرقمُ بوضوح (قِيس ٢٩٫٠ بدل ٢٠٫٥)، أمّا في الموضعِ الأوّلِ
#      فيقرأُ صفرًا (قِيس ١٢٫٠ بدل ١٨٫٠) — ولو كان المتوقَّعُ صفرًا لَمرَّت البذرةُ
#      وهي حمراء. فحارسٌ بترتيبٍ واحدٍ حارسٌ نصفُه أعمى.
#
#      🔑 والأصنافُ الثلاثةُ مقصودةٌ بأنواعِ إرجاعٍ ثلاثة: صحيحٌ (`sitofp`) ·
#      عشريٌّ (مباشر) · موسومٌ (الثقب). فلو بقي التطبيعُ سلسلةً ناقصةً لَظلّ
#      الصنفانِ الأوّلانِ أخضرَين ويكذبُ الثالثُ وحدَه — وهو ما حدث فعلًا.
#
# (EN) This guards a PHI arm with NO value, not polymorphism as such. A virtual
#      method containing a division returns %SadDyn (tagged), which the hand-written
#      cast chain in the vtable dispatch did not recognise, so that arm fell to
#      `poison`. A poison PHI does not fail — it reads whatever is left in the
#      register. Both orderings are required: in last position poison reads a loaded
#      temp (29.0 vs 20.5), in first position it reads zero (12.0 vs 18.0); a seed
#      with one ordering is half blind. The three classes deliberately return three
#      different types — int, float, tagged — so the two working arms cannot mask
#      the broken one.
# ============================================================================

صنف قاعدة
    دالة عام قيمة()
        ارجع 0
    نهاية
نهاية

صنف صحيحة يرث قاعدة
    دالة عام قيمة()
        ارجع 5
    نهاية
نهاية

صنف عشرية يرث قاعدة
    دالة عام قيمة()
        ارجع 2.5
    نهاية
نهاية

صنف مقسومة يرث قاعدة
    متغير عام أ
    متغير عام ب

    باني(س، ص)
        هذا.أ = س
        هذا.ب = ص
    نهاية

    دالة عام قيمة()
        ارجع (هذا.أ * هذا.ب) / 2
    نهاية
نهاية

# ── الموسومُ أخيرًا: poison يقرأ مؤقَّتًا محمَّلًا ─────────────────────────
متغير عناصر = [صحيحة()، عشرية()، مقسومة(4، 3)]
متغير مجموع_الموسوم_أخيرا = عشري(7)
لكل ع في عناصر
    مجموع_الموسوم_أخيرا = مجموع_الموسوم_أخيرا + عشري(ع.قيمة())
نهاية
اطبع_سطر("أخيرا:" + مجموع_الموسوم_أخيرا)

# ── الموسومُ أوّلًا: poison يقرأ صفرًا ────────────────────────────────────
متغير عناصر_الموسوم_أولا = [مقسومة(4، 3)، صحيحة()]
متغير مجموع_الموسوم_أولا = عشري(7)
لكل ع في عناصر_الموسوم_أولا
    مجموع_الموسوم_أولا = مجموع_الموسوم_أولا + عشري(ع.قيمة())
نهاية
اطبع_سطر("أولا:" + مجموع_الموسوم_أولا)
