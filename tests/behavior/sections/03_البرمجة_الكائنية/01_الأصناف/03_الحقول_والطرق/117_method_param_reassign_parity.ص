# @description إعادةُ إسنادِ معاملٍ داخلَ طريقةٍ وبانٍ — نسخةٌ محلّيّةٌ لا ثابت (تكافؤُ محرّكَين)
# @expected 1000\n7\nس\nمُغلَق\nمنفذ:1\nمنفذ:80\nعدّ:0\nعدّ:3
# @priority P1

# ============================================================
# (AR) العطبُ المقيس: معاملُ الطريقةِ والباني كان يُسجَّل `isMutable = false`
#      في الواجهةِ الأماميّةِ للمصرِّف، بينما معاملُ الدالّةِ الحرّةِ يُسجَّل
#      `true`. فكان `رمز = 1000` داخلَ طريقةٍ يُرفَض بـ«Cannot assign to
#      const variable» ويمرُّ في دالّةٍ حرّة — والمفسّرُ يقبلُهما معًا.
#      الأثر: عشرةُ اختباراتِ شبكةٍ كانت تسقط، لأنّ `شبكات.ص:971` تستعمل
#      النمطَ نفسَه (`دالة أغلق(رمز، سبب)` ثمّ `رمز = 1000`).
# ============================================================

صنف عميل_ويبسوكت
    متغير خاص _معرف
    متغير خاص _منفذ

    # (AR) معاملُ بانٍ يُعاد إسنادُه حين يأتي عدمًا
    باني(منفذ)
        إذا (منفذ == لاشيء)
            منفذ = 1
        نهاية
        هذا._منفذ = منفذ
        هذا._معرف = 0
    نهاية

    # (AR) معاملا طريقةٍ يُعادُ إسنادُهما — النمطُ الحرفيُّ في شبكات.ص
    دالة أغلق(رمز، سبب)
        إذا (رمز == لاشيء)
            رمز = 1000
        نهاية
        إذا (سبب == لاشيء)
            سبب = "مُغلَق"
        نهاية
        اطبع_سطر(رمز)
        ارجع سبب
    نهاية

    دالة المنفذ()
        ارجع هذا._منفذ
    نهاية

    # (AR) معاملٌ يُنقَص داخلَ حلقة — بدون قابليّةِ التعديل يصمتُ الإسنادُ
    #      فتصيرُ الحلقةُ لا نهائيّة، وهو أسوأُ من رفضِ الترجمة.
    دالة عُدَّ_تنازليًّا(عدد)
        بينما (عدد > 0)
            عدد = عدد - 1
        نهاية
        ارجع عدد
    نهاية
نهاية

متغير مُعطًى = عميل_ويبسوكت(لاشيء)
متغير سبب_افتراضيّ = مُعطًى.أغلق(لاشيء، لاشيء)
اطبع_سطر(مُعطًى.أغلق(7، "س"))
اطبع_سطر(سبب_افتراضيّ)
اطبع_سطر("منفذ:" + نص(مُعطًى.المنفذ()))

متغير صريح = عميل_ويبسوكت(80)
اطبع_سطر("منفذ:" + نص(صريح.المنفذ()))
اطبع_سطر("عدّ:" + نص(صريح.عُدَّ_تنازليًّا(5)))
اطبع_سطر("عدّ:" + نص(صريح.عُدَّ_تنازليًّا(0) + 3))
