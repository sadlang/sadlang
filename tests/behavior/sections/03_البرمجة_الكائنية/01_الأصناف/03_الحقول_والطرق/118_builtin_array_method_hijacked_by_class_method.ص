# @description طريقةُ صنفٍ باسمِ طريقةٍ مدمجةٍ لا تختطفُ نداءَ المصفوفة
# @expected 3

# ============================================================
# (AR) كانَ يكفي أن يُعرِّفَ **أيُّ** صنفٍ في البرنامجِ طريقةً اسمُها `أضف` لِيُصرَفَ
#      `مصفوفة.أضف(...)` إليها: يُطبَعُ «مخزن:3» ولا يُضافُ العنصر، ثمّ تُقرَأُ
#      `قائمة[1]` خارجَ الحدّ. والمفسّرُ يُصيبُ.
#
#      والجذرُ تخمين: حينَ يفرُغُ اسمُ الصنفِ (والمُستقبِلُ مصفوفةٌ لا كائن) كانَ
#      التوزيعُ يمرُّ على **كلِّ** الأصنافِ باسمِ الطريقةِ وحدَه ويأخذُ أوّلَ ما يجد.
#      ونوعُ المُستقبِلِ معلومٌ ساكنًا في البنيةِ نفسِها التي يُقرَأُ منها اسمُ الصنف —
#      فكانَ يُقرَأُ أحدُ الحقلَينِ ويُهمَلُ الآخر.
#
#      والمعامِلُ هنا **مُصرَّحُ النوع** عمدًا: العلّةُ في صرفِ النداءِ لا في استنتاجِ
#      الأنواع. ولا يشترطُ العيبُ وراثةً ولا كائنًا: الصنفُ هنا لا يُنشَأُ أصلًا.
# ============================================================

صنف مخزن
    باني()
    نهاية

    دالة أضف(صحيح س)
        اطبع_سطر("مخزن:" + نص(س))
    نهاية
نهاية

متغير قائمة = [1]
قائمة.أضف(3)
اطبع_سطر(نص(قائمة[1]))
