# @description اختبار طرق الامتداد (Extension Methods) — إضافة دوال لأصناف موجودة
# @expected مربع:أحمر:25\nتكرار:مرحبا!مرحبا!مرحبا!\nمعكوس:دمحأ
# @priority P2

# ============================================================
# 1. صنف أساسي
# ============================================================

استورد رياضيات

صنف مربع
    متغير عام الضلع
    متغير عام اللون

    باني(ضلع، لون)
        هذا.الضلع = ضلع
        هذا.اللون = لون
    نهاية

    دالة المساحة()
        ارجع هذا.الضلع * هذا.الضلع
    نهاية
نهاية

# ============================================================
# 2. إضافة طريقة امتداد
# ============================================================
امتداد مربع
    دالة الوصف()
        ارجع هذا.اللون + ":" + هذا.المساحة()
    نهاية
نهاية

متغير م = مربع(5، "أحمر")
اطبع_سطر("مربع:" + م.الوصف())

# ============================================================
# 3. دالة مساعدة — تكرار نص
# ============================================================
دالة كرر(نص، مرات)
    متغير نتيجة = ""
    متغير ع = 0
    بينما (ع < مرات)
        نتيجة = نتيجة + نص
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية
اطبع_سطر("تكرار:" + كرر("مرحبا!"، 3))

# ============================================================
# 4. دالة عكس النص يدوياً
# ============================================================
دالة اعكس(نص_أصلي)
    متغير نتيجة = ""
    متغير ط = طول(نص_أصلي) - 1
    بينما (ط >= 0)
        نتيجة = نتيجة + نص_أصلي[ط]
        ط = ط - 1
    نهاية
    ارجع نتيجة
نهاية
اطبع_سطر("معكوس:" + اعكس("أحمد"))
