# @description اختبار حقول عشرية موروثة عبر سلسلة وراثة
# @expected سعر:3.14\nمنتج:3.14:خبز\nمنتج_مخفض:3.14:خبز:2.5
# @priority P1

# ============================================================
# 1. وراثة مع حقول عشرية
# ============================================================
صنف سعر_أساسي
    متغير عام السعر

    باني(س)
        هذا.السعر = س
    نهاية

    دالة عام وصف()
        ارجع "سعر:" + هذا.السعر
    نهاية
نهاية

صنف منتج يرث سعر_أساسي
    متغير عام الاسم

    باني(س، ا)
        الأساس(س)
        هذا.الاسم = ا
    نهاية

    دالة عام وصف()
        ارجع "منتج:" + هذا.السعر + ":" + هذا.الاسم
    نهاية
نهاية

صنف منتج_مخفض يرث منتج
    متغير عام الخصم

    باني(س، ا، خ)
        الأساس(س، ا)
        هذا.الخصم = خ
    نهاية

    دالة عام وصف()
        ارجع "منتج_مخفض:" + هذا.السعر + ":" + هذا.الاسم + ":" + هذا.الخصم
    نهاية
نهاية

# ============================================================
# 2. إنشاء واستخدام
# ============================================================
متغير أ = سعر_أساسي(3.14)
متغير ب = منتج(3.14، "خبز")
متغير ج = منتج_مخفض(3.14، "خبز"، 2.5)

اطبع_سطر(أ.وصف())
اطبع_سطر(ب.وصف())
اطبع_سطر(ج.وصف())
