# @description الشريحةُ بالقوسِ على نصٍّ عربيٍّ تَقُصُّ **بالمحارفِ لا بالبايتات** — والفرقُ ثمانيةُ بايتاتٍ في «مرحبا» وحدَها. تُقاسُ ههنا لأنّ سدَّ التوجيهِ لا يكفي: لو مرَّ الاستخراجُ من بابٍ بايتيٍّ لَبُتِر حرفٌ في منتصفِه فخرج نصٌّ مكسورٌ لا يُرى في ASCII.
# @expected مرحبا\nبالعالم\nعالم
# @priority P0

# ============================================================
# (AR) الشريحةُ تمرُّ من **البابِ الواحدِ** الذي تمرُّ منه `.جزء()`:
#      تحويلُ فهرسِ المحرفِ إلى إزاحةِ بايتٍ بـUTF-8 ثمّ النسخ. فقاعدةُ
#      الاستخراجِ نسخةٌ واحدةٌ لا نسختان — ولو نُسخت لَتباعدت في العربيّةِ
#      أوّلًا، وهي أوّلُ ما يُكتَبُ بهذه اللغة.
# ============================================================

متغير ع = "مرحبا بالعالم"
اطبع_سطر(ع[0:5])    # خمسةُ محارفَ = عشرةُ بايتات
اطبع_سطر(ع[6:])     # إلى الآخر
اطبع_سطر(ع[-4:])    # أربعةُ محارفَ من الآخر
