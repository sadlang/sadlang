# @description الشريحةُ بالقوسِ على نصٍّ `ن[أ:ب]` تُعطي نصًّا فرعيًّا موافقًا للمفسّرِ في صيغِها كلِّها. وكانت في المترجّمِ تنهارُ segfault — أو تطبعُ `[]` جوابًا مختلَقًا — لأنّها كانت تُوجَّهُ إلى ذراعِ المصفوفةِ فيُطبَّعُ `char*` بوصفِه `SadArray*`.
# @expected bcd\ncdefgh\nabc\nfgh\n\nabcdefgh
# @priority P0

# ============================================================
# (AR) 🔑 التوجيهُ يُسأَلُ عن **نوعِ المستقبِل** قبل أن يُطبَّعَ مؤشّرًا.
#      كان `buildExprSlice` يسِمُ كلَّ شريحةٍ `Array` مهما كان المستقبِل،
#      فتصلُ شريحةُ النصِّ إلى `emitBuiltinArraySlice` وتُقرأُ ترويسةُ
#      مصفوفةٍ من بايتاتِ نصّ. ووجهاها لعلّةٍ واحدة:
#        • قمامةٌ تُقرأ طولًا ضخمًا ⇒ انهيارٌ segfault (يُرى)؛
#        • قمامةٌ تُقرأ صفرًا      ⇒ يُطبَعُ `[]` (لا يُرى — وهو الأسوأ).
#      و`.جزء()` كانت سليمةً طوالَ الوقت، فالذراعُ الصحيحةُ موجودةٌ ولا
#      يُوجَّهُ إليها — سطرٌ واحدٌ من التوجيهِ لا حملةٌ من التنفيذ.
#
# (AR) والحدودُ مقيسةٌ لا مفترَضة: `ن[4:1]` نصٌّ فارغٌ لا حجزٌ سالبٌ ضخم،
#      و`ن[0:1000]` يُقصُّ إلى الطولِ لا يقرأُ خارجَ الحدود.
# ============================================================

متغير ن = "abcdefgh"
اطبع_سطر(ن[1:4])       # bcd
اطبع_سطر(ن[2:])        # cdefgh — الحارس «إلى الآخر»، لا -1
اطبع_سطر(ن[:3])        # abc
اطبع_سطر(ن[-3:])       # fgh — بدايةٌ سالبةٌ تُعَدُّ من الآخر
اطبع_سطر(ن[4:1])       # نصٌّ فارغ: الطولُ فرقٌ لا يسلُب
اطبع_سطر(ن[0:1000])    # abcdefgh: النهايةُ محصورةٌ في الطول
