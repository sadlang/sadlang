# @description إرجاعُ خريطةٍ ومصفوفةٍ مختلطةٍ من دالّة — القراءةُ اللاحقةُ موسومةٌ لا عدديّة
# @expected 5\nنص\n7
# @priority P1

# ============================================================
# (AR) انحدارٌ مرصود: إرجاعُ خريطةٍ من دالّة كان ينهار (SIGSEGV)،
#      وعنصرُ المصفوفة المختلطة النصّيُّ كان يُقرأ مؤشّرًا فيُطبع عددًا.
# ============================================================

دالة اصنع_خريطة()
    متغير خ = {}
    خ.عين("مفتاح"، 5)
    ارجع خ
نهاية

دالة اصنع_زوجا()
    ارجع ["نص"، 7]
نهاية

متغير الخريطة = اصنع_خريطة()
اطبع_سطر(نص(الخريطة.احصل("مفتاح")))

متغير الزوج = اصنع_زوجا()
اطبع_سطر(الزوج[0])
اطبع_سطر(نص(الزوج[1]))
