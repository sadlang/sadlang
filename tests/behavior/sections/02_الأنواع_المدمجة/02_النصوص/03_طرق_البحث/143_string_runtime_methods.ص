# @description طرقُ نصٍّ كانت مُعلَنةً بلا تنفيذٍ في زمن التشغيل المُضمَّن — تحويلُ حالةٍ وبحثٌ وعكسٌ وتكرار
# @expected HELLO WORLD\nhello world\n6\n-1\nابحرم\nمرحبامرحبامرحبا\nجبا
# @priority P1

# ============================================================
# (AR) كانت هذه الدوالّ مكتوبةً في llvm_runtime.cpp بتمثيلٍ آخر للنصّ
#      (بنية SadString) — وهو زمنُ تشغيلٍ لا يُربَط ببرامج المستخدم — فكان
#      الرابطُ يشكو رمزًا مفقودًا ويُبلّغه «مكتبةُ CRT مفقودة».
#      الدلالاتُ هنا مطابقةٌ للمفسّر: طيُّ ASCII فقط، وبحثٌ بالبايتات و-1
#      عند الغياب، وعكسٌ بمحارف UTF-8 لا بالبايتات.
# ============================================================

متغير لاتيني = "Hello World"
اطبع_سطر(لاتيني.تحويل_كبير())
اطبع_سطر(لاتيني.تحويل_صغير())
اطبع_سطر(نص(لاتيني.بحث("World")))
اطبع_سطر(نص(لاتيني.بحث("غير_موجود")))

متغير عربي = "مرحبا"
اطبع_سطر(عربي.عكس())
اطبع_سطر(عربي.كرر(3))
اطبع_سطر("ابج".عكس())
