# @description اختبار مصفوفات متداخلة وعمليات سلسلة (chaining) معقدة
# @expected 3\n6\n[6,12]\nمجموع:21\nأول:1\nآخر:5\nفارغ:صحيح\nطول:3
# @priority P2

# ============================================================
# 1) مصفوفات متداخلة — الوصول والتعديل
# ============================================================
متغير مصفوفة = [[1، 2، 3]، [4، 5، 6]، [7، 8، 9]]
اطبع_سطر(مصفوفة[0].الطول())
اطبع_سطر(مصفوفة[1][2])

# ============================================================
# 2) سلسلة عمليات — خريطة ثم رشح
# ============================================================
متغير أرقام = [1، 2، 3، 4، 5]
متغير نتيجة = أرقام.رشح(لامدا(ن) ارجع ن % 2 == 0 نهاية).خريطة(لامدا(ن) ارجع ن * 3 نهاية)
اطبع_سطر("[" + نتيجة[0] + "," + نتيجة[1] + "]")

# ============================================================
# 3) اختزال مع قيمة أولية
# ============================================================
متغير مج = [1، 2، 3، 4، 5، 6].اختزل(لامدا(مج، ن) ارجع مج + ن نهاية، 0)
اطبع_سطر("مجموع:" + مج)

# ============================================================
# 4) أول/آخر/فارغة
# ============================================================
متغير ق = [1، 2، 3، 4، 5]
اطبع_سطر("أول:" + ق.أول())
اطبع_سطر("آخر:" + ق.آخر())

متغير فارغة = []
اطبع_سطر("فارغ:" + فارغة.فارغة())

# ============================================================
# 5) شريحة
# ============================================================
متغير شر = [10، 20، 30، 40، 50].شريحة(1، 4)
اطبع_سطر("طول:" + شر.الطول())
