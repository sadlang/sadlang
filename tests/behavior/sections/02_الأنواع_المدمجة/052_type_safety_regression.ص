# @description (S-TS-P5) suite انحدار الأمان النوعي: تأكيدات نوع() حقيقية لكل البدائيات + عدم/اختياري + حفظ النوع.
# @expected T1:رقم\nT2:عشري\nT3:نص\nT4:منطقي\nT5:مصفوفة\nT6:خريطة\nT7:عدم\nT8:صحيح\nT9:صحيح\nT10:رقم\nT11:عشري
# @priority P0

# ============================================================
# مصفوفة البدائيات (AC2): نوع() لكل نوع أساسي
# ============================================================
اطبع_سطر("T1:" + نوع(42))          # رقم
اطبع_سطر("T2:" + نوع(3.14))        # عشري
اطبع_سطر("T3:" + نوع("نص"))        # نص
اطبع_سطر("T4:" + نوع(صحيح))        # منطقي
اطبع_سطر("T5:" + نوع([1، 2، 3]))   # مصفوفة

متغير خ = {"مفتاح": 1}
اطبع_سطر("T6:" + نوع(خ))            # خريطة

# ============================================================
# عدم (Null) متمايز عن فراغ (S-TS-P1)
# ============================================================
اطبع_سطر("T7:" + نوع(لاشيء))       # عدم

# ============================================================
# حفظ النوع عبر المتغيرات والعمليات (type preservation)
# ============================================================
متغير ع = 10
متغير ن = ع + 5
اطبع_سطر("T8:" + (نوع(ن) == "رقم"))   # صحيح

# عدم == عدم (S-TS-P1)
اطبع_سطر("T9:" + (لاشيء == لاشيء))    # صحيح

# ترقية رقمي → عشري في القسمة
اطبع_سطر("T10:" + نوع(10 / 4))         # رقم — القسمة على صحيحين تقتطع نحو الصفر
اطبع_سطر("T11:" + نوع(10 / 4.0))       # عشري — معامل عشريّ واحد يرقّي النتيجة
