# @description `رقم`/`عشري` على نصٍّ لا يمثّل عددًا يرميان لا يُرجعان صفرًا: كان المصرِّفُ يُرجع 0 برمزِ خروجٍ ٠ بينما يرمي المفسّر — جوابٌ خاطئٌ صامتٌ يجتاز أيَّ فحصِ رمزِ خروج
# @expected 42\n12\n3.5\nرمى رقم\nرمى عشري\nرمى فارغ\n=== انتهى ===
# @priority P0

# ═══ الناجحُ يبقى ناجحًا — الحارسُ يقيس الجهتَين ═══
اطبع_سطر(رقم("42"))

# (AR) و«١٢abc» ليست من حالاتِ الرمي: `stoll` تُرجع ١٢ وكذلك `strtoll`،
#      فالطرفان متّفقان أصلًا. إدراجُها هنا يمنع أن يُسدَّ العطبُ بتشديدٍ زائدٍ
#      يرمي على كلِّ نصٍّ لا يُستهلَك كلُّه — وهو انحدارٌ في الاتّجاهِ المضادّ.
اطبع_سطر(رقم("12abc"))
اطبع_سطر(عشري("3.5"))

# ═══ ولا محرفَ يُستهلَك ⇒ ليس عددًا ⇒ رميٌ يلتقطه `امسك` ═══
حاول
    اطبع_سطر(رقم("abc"))
    اطبع_سطر("لم يرمِ")
امسك خطأ خطا_الرقم
    اطبع_سطر("رمى رقم")
نهاية

حاول
    اطبع_سطر(عشري("abc"))
    اطبع_سطر("لم يرمِ")
امسك خطأ خطا_العشري
    اطبع_سطر("رمى عشري")
نهاية

# (AR) والنصُّ الفارغُ من البابِ نفسِه: `errno` لا يُوضَع فيه، فالحارسُ المدَويُّ
#      لا يشتعل — الشاهدُ الوحيدُ هو «لم يُستهلَك محرفٌ واحد».
حاول
    اطبع_سطر(رقم(""))
    اطبع_سطر("لم يرمِ")
امسك خطأ خطا_الفارغ
    اطبع_سطر("رمى فارغ")
نهاية

اطبع_سطر("=== انتهى ===")
