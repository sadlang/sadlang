# @description اختبار خرائط متقدمة — عمليات CRUD + تكرار + يحتوي
# @expected حجم:3\nأحمد:90\nيحتوي:صحيح\nلا_يحتوي:صحيح\nحجم_بعد:2\nمفاتيح:2
# @priority P2

# ============================================================
# 1) إنشاء خريطة وعمليات أساسية
# ============================================================
متغير درجات = {"أحمد": 90، "سارة": 85، "خالد": 78}
اطبع_سطر("حجم:" + درجات.حجم())
اطبع_سطر("أحمد:" + درجات.احصل("أحمد"))

# ============================================================
# 2) فحص وجود مفتاح
# ============================================================
اطبع_سطر("يحتوي:" + درجات.يحتوي("سارة"))
اطبع_سطر("لا_يحتوي:" + (ليس درجات.يحتوي("ليلى")))

# ============================================================
# 3) حذف عنصر
# ============================================================
درجات.احذف("خالد")
اطبع_سطر("حجم_بعد:" + درجات.حجم())

# ============================================================
# 4) مفاتيح
# ============================================================
متغير م = درجات.مفاتيح()
اطبع_سطر("مفاتيح:" + م.الطول())
