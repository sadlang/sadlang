# @description اختبار تكرار الخرائط (Maps) — مفاتيح، قيم، أزواج
# @expected 3\nصحيح\nخطأ\nأحمد\nخالد\nسارة
# @priority P1

# ============================================================
# 1. خريطة وعملياتها
# ============================================================
متغير بيانات = {"أحمد": 25، "سارة": 30، "خالد": 22}
اطبع_سطر(بيانات.حجم())

# ============================================================
# 2. التحقق من وجود مفتاح
# ============================================================
اطبع_سطر(بيانات.يحتوي("أحمد"))
اطبع_سطر(بيانات.يحتوي("ليلى"))

# ============================================================
# 3. مفاتيح الخريطة
# ============================================================
متغير المفاتيح = بيانات.مفاتيح()
متغير م_مرتبة = المفاتيح.رتب()
لكل م في م_مرتبة
    اطبع_سطر(م)
