# @description تكافؤُ تصييرِ الخريطةِ نصًّا بين المحرّكَين. للمفسّرِ صيغتانِ مقيستان لا واحدة: الطباعةُ تقتبسُ المفاتيحَ «{"أ": 1}» و`نص(خريطة)`/الوصلُ النصّيُّ لا يقتبسانِها «{أ: 1}». وكان المصرّفُ يُصيبُ الطباعةَ ويُخطئُ الاثنتَينِ الأخريَينِ: يُلوَّنُ `I64_TO_STRING` على **مؤشّرِ الخريطة** فيُنسَّقُ `%lld` ⇒ يُطبَعُ عنوانٌ خامّ («1825978152560») بينما المفسّرُ يعطي «{أ: 1}». عائلةُ ISSUE-080 نفسُها التي أُغلِقت للمصفوفاتِ بـARRAY_TO_STRING ولم تبلغِ الخرائط. العلاجُ رايةٌ في مولِّدِ المساعِدِ نفسِه تُنتِجُ نسخةً غيرَ مقتبسة، فالخوارزميّةُ واحدةٌ ولا تتباعدُ النسختان
# @expected {"أ": 1}\n{أ: 1}\nس{أ: 1}\n{أ: 1}!\n{}\n{س: صحيح}\n{ص: 2.5}\nلاشيء\nسلاشيء\n{أ: {ب: 2}}\n{م: [1, 2, 3]}\n{ن: قيمة}\n{ع: لاشيء}\n{مفتاح فيه، فاصلة: 9}\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح
# @priority P0

# ⚠️ حدٌّ مقصودٌ في تصميمِ هذا الاختبار: **لا يُقفَلُ ترتيبُ المفاتيح**.
#    المفسّرُ يخزّنُ الخريطةَ في `std::unordered_map` فترتيبُ المرورِ من تنفيذِ
#    المكتبةِ القياسيّة، ويختلفُ بين MSVC وlibc++؛ فكلُّ توقُّعٍ نصّيٍّ لخريطةٍ
#    متعدّدةِ المفاتيحِ يقفلُ **مصادفةَ تجزئةٍ** لا عقدًا — وقد أخفقَ هذا الاختبارُ
#    فعلًا على macOS حين كان يفعل. لذلك: النصُّ الحرفيُّ يُتحقَّقُ منه بخرائطَ
#    أحاديّةِ المفتاح، والتعدُّدُ يُتحقَّقُ منه بالاحتواءِ لا بالترتيب.

استورد نصوص

خريطة جدول_القيم = {"أ": 1}

# ── صيغةُ الطباعةِ المقتبسة ──
اطبع_سطر(جدول_القيم)

# ── صيغةُ التحويلِ غيرِ المقتبسة: كانت تطبعُ عنوانَ المؤشّر ──
اطبع_سطر(نص(جدول_القيم))

# ── الوصلُ النصّيُّ يمينًا ويسارًا: كان يُلحِقُ العنوانَ رقمًا ──
اطبع_سطر("س" + جدول_القيم)
اطبع_سطر(جدول_القيم + "!")

# ── خريطةٌ فارغة ──
خريطة جدول_فارغ = {}
اطبع_سطر(نص(جدول_فارغ))

# ── وسمُ القيمةِ المنطقيّةِ ووسمُ العشريّ: كلٌّ في خريطتِه فلا يتدخّلَ الترتيب ──
خريطة جدول_منطقي = {"س": صحيح}
اطبع_سطر(نص(جدول_منطقي))

خريطة جدول_عشري = {"ص": 2.5}
اطبع_سطر(نص(جدول_عشري))

# ── خريطةٌ غيرُ مُهيّأة: كان المصرّفُ يفكُّ مؤشّرًا عدمًا ⇒ SIGSEGV ──
# المفسّرُ يطبعُ نصَّ العدم؛ والحارسُ الآن في المساعِدِ نفسِه أوّلَ تعليمة.
خريطة جدول_غير_مهيأ
اطبع_سطر(نص(جدول_غير_مهيأ))
اطبع_سطر("س" + جدول_غير_مهيأ)

# ── قيمٌ مركّبةٌ ومفاتيحُ ذاتُ فواصلَ ومسافات ──
خريطة جدول_متداخل = {"أ": {"ب": 2}}
اطبع_سطر(نص(جدول_متداخل))

خريطة جدول_بمصفوفة = {"م": [1، 2، 3]}
اطبع_سطر(نص(جدول_بمصفوفة))

خريطة جدول_بنص = {"ن": "قيمة"}
اطبع_سطر(نص(جدول_بنص))

خريطة جدول_بعدم = {"ع": لاشيء}
اطبع_سطر(نص(جدول_بعدم))

خريطة جدول_بمفتاح_مركب = {"مفتاح فيه، فاصلة": 9}
اطبع_سطر(نص(جدول_بمفتاح_مركب))

# ── تعدُّدُ المداخل: يُتحقَّقُ منه بالاحتواءِ والفاصلِ لا بالترتيب ──
خريطة جدول_رباعي = {"أ": 1، "ب": 2، "ج": 3، "د": 4}
نص نص_الرباعي = نص(جدول_رباعي)
اطبع_سطر(يحتوي_على(نص_الرباعي، "أ: 1"))
اطبع_سطر(يحتوي_على(نص_الرباعي، "ب: 2"))
اطبع_سطر(يحتوي_على(نص_الرباعي، "ج: 3"))
اطبع_سطر(يحتوي_على(نص_الرباعي، "د: 4"))
اطبع_سطر(يحتوي_على(نص_الرباعي، ", "))
