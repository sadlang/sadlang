# @description الصفةُ «عدمي» لا تعبرُ حدَّ السطر — تصريحٌ بلا مُهيّئٍ لا يبتلعُ اسمَ السطرِ التالي.
# @priority P0

# ============================================================
# (AR) 🔑 المُشكِّلُ لا يُصدرُ رمزَ نهايةِ سطر، والتصريحُ بلا مُهيّئٍ مقبولٌ في اللغة.
#      فشرطُ «يليها اسمٌ» وحدَه لا يكفي: «متغير رقم عدمي» ثمّ «س = 5» في السطرِ
#      التالي كان يُقرأ تصريحًا واحدًا اسمُه «س»، فيختفي المتغيّرُ «عدمي» صامتًا
#      ويتحوّلُ إسنادٌ إلى مُهيّئ. برنامجٌ صحيحٌ يُقبَل بمعنًى آخرَ — نمطُ
#      ISSUE-030/031/032 بعينِه. العلاجُ: يليها اسمٌ **في السطرِ نفسِه**.
# (EN) The lexer emits no EOL token and initializer-less declarations are legal,
#      so «followed by an identifier» must mean «on the same line».
# ============================================================

متغير رقم عدمي
متغير رقم س = 5
عدمي = 7

اطبع_سطر(عدمي)
اطبع_سطر(س)

# (AR) والصفةُ لا تزال تعملُ حين يليها الاسمُ في السطرِ نفسِه.
متغير رقم عدمي مقياس = 9
اطبع_سطر(مقياس)
