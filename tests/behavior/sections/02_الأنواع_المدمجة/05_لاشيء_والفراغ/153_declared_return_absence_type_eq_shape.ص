# @description غيابُ البحثِ عبرَ عائدٍ مصرَّحٍ «رقم» يحفظُ **شكلَه**: `نوع()` ⇒ «فراغ» (لا «عدم») و`== لاشيء` ⇒ «خطأ» — كما يفرّقُ المفسّرُ الفراغَ من العدم. كانا شقيقَي بذرةِ [٨]: بذرةُ العدمِ الواحدةُ كانت تُسوّيهما («عدم»/«صحيح»).
# @requires: اطبع_سطر, خرائط
# @expected لاشيء\nفراغ\nخطأ
# @priority P1

استورد خرائط
متغير خ = خريطة()
خ["أ"] = 1

دالة رقم اقرأ()
    ارجع خ["غائب"]
نهاية

اطبع_سطر(اقرأ())
اطبع_سطر(نوع(اقرأ()))
اطبع_سطر(اقرأ() == لاشيء)
