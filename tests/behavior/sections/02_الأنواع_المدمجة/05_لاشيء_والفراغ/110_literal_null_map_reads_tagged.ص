# @description الخريطةُ الحرفيّةُ العدميّةُ القيمِ تُقرأُ موسومةً: الحاضرُ «عدم» و==لاشيء صحيح، والغائبُ «فراغ» — سدُّ المنتِجِ الثاني.
# @requires: اطبع_سطر, خرائط
# @priority P0
# @expected LT:عدم\nLEQ:صحيح\nABS:فراغ\nHEAL:رقم

# ============================================================
# (AR) 🔑 المقيسُ قبل السدّ (٢٠٢٦-٠٨-٢٢، كشفُ المراجعةِ العدائيّة): سدُّ
#      `خ["أ"] = لاشيء` (مسارُ الإسناد) وحدَه تركَ **الخريطةَ الحرفيّةَ**
#      `{"أ": لاشيء}` مكسورةً — باني الحرفيّةِ يستنتجُ نوعَ العنصرِ Null من
#      أوّلِ قيمةٍ، وقائمةُ القناةِ الموسومةِ في القراءةِ لم تكن تضمُّ Null،
#      فسقطت القراءةُ إلى الفرعِ الخامِّ النصّيّ: `نوع(خ["أ"])` مترجَمًا
#      «نص» (المفسّرُ «عدم»)، و`== لاشيء` «خطأ»، وحتّى الغائبُ `نوع(خ["غائب"])`
#      «نص» بدل «فراغ» — كذبٌ صامتٌ بخروجِ ٠، والوسمُ مخزَّنٌ صحيحًا أصلًا.
#
#      السدُّ في **المستهلكِ** لا المنتِج: Null ضُمَّت إلى قائمةِ القناةِ
#      الموسومةِ في expression_index — فتغطّي كلَّ المنتِجين (الحرفيّة،
#      الإسناد، الاستيعابات، وما يُستحدَث). «الرقعةُ تُسَدُّ في ملفٍ واحدٍ
#      تتركُ أشقّاءَها» — هذه البذرةُ تحرسُ الشقيقَ الذي تُرك.
#
# (AR) وضابطُ HEAL ليس زينة: إعادةُ إسنادِ قيمةٍ رقميّةٍ فوق العدمِ تشفي
#      القراءةَ إلى «رقم» — فسدٌّ يجمّدُ الخريطةَ على العدمِ انحدارٌ آخر.
# ============================================================

استورد خرائط

متغير خ = {"أ": لاشيء، "ب": لاشيء}

اطبع_سطر("LT:" + نوع(خ["أ"]))
اطبع_سطر("LEQ:" + (خ["أ"] == لاشيء))
اطبع_سطر("ABS:" + نوع(خ["غائب"]))

خ["ب"] = 7
اطبع_سطر("HEAL:" + نوع(خ["ب"]))
