# @description عدمٌ صريحٌ وسطًا يرفعُ SEM011 باسمِ 'NULL' في المحرّكَين — توأمُ الضدِّ لبذرةِ ١٠٥.
# @requires: اطبع_سطر, خرائط
# @priority P1
# @expect_error النوع 'NULL' لا يدعم الفهرسة []
# @expect_error_compiled النوع 'NULL' لا يدعم الفهرسة []

# (AR) 🔑 توأمُ الضدّ: بذرةُ ١٠٥ تُثبِّتُ الغيابَ (فراغ ⇒ 'VOID')، وهذه
#      تُثبِّتُ أنّ العدمَ الصريحَ المخزَّنَ (`خ["أ"] = لاشيء`) يُفرَّقُ عنه
#      بالاسمِ 'NULL' — فلا يُقرأُ السدُّ ذريعةً لطيِّ العدمِ في الفراغ.
#      الاسمانِ يُملآنِ في المحرّكَين من `Value::getTypeName()` عينِها:
#      المفسّرُ في `visitIndexExpr` والمترجمُ في فرعِ فشلِ `normalizeMapPtr`.

استورد خرائط

متغير خ = خريطة()
خ["أ"] = لاشيء
اطبع_سطر(خ["أ"]["عميق"])
