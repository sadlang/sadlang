# @description مقارنةُ «عدم»: حصريّةُ الشرطِ + عدمٌ حقيقيٌّ في خانةٍ نوعُها الساكنُ نصّ
# @expected صحيح\nخطأ\nصحيح\nخطأ\nصحيح\nصحيح\nخطأ

# ============================================================
# (AR) لا تكفي حالةُ «طرفٌ عدمٌ والآخرُ حرفيّةٌ نصّيّة». الخطرُ الحقيقيُّ خانةٌ
#      **نوعُها الساكنُ نصٌّ** تحملُ الحارسَ **وقتَ التشغيل**: جوابٌ ثابتٌ («عدمٌ
#      لا يساوي نصًّا ⇒ خطأ») يكسِرُها، بينما المقارنةُ العدديّةُ بالحارسِ تُصيب.
#
#      وقد كسَرَ جوابٌ ثابتٌ عشرينَ اختبارًا في مسارِ العدمِ ودامجِه قبلَ أن تُمسِكَه
#      هذه الحالة — فأُضيفتْ لأنّ البذرةَ الأولى كانتْ ناقصةً لا كاذبة: `ع` فيها
#      يُستنتَجُ عدمًا **ساكنًا**، فلم تمرَّ بالحالةِ الخطرةِ أصلًا.
#
#      والشرطُ حصريٌّ كذلك: لو صارَ شاملًا (أيُّ طرفٍ عدم) لانقلبَ «عدم == عدم».
# ============================================================

متغير ع = لاشيء

اطبع_سطر(ع == لاشيء)
اطبع_سطر(ع != لاشيء)
اطبع_سطر(لاشيء == لاشيء)
اطبع_سطر("نص" == لاشيء)
اطبع_سطر("نص" != لاشيء)

# (AR) خانةٌ نوعُها الساكنُ نصٌّ تحملُ عدمًا حقيقيًّا
دالة افحص(نص س)
    اطبع_سطر(س == لاشيء)
    اطبع_سطر(س != لاشيء)
نهاية

افحص(لاشيء)
