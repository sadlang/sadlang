# @description البابُ يعرض «لاشيء» ولا يجعلها هُويّة: نصٌّ عدميٌّ لا يساوي النصَّ الحرفيَّ «لاشيء».
# @priority P0

# ============================================================
# (AR) 🔑 هذا الاختبارُ يحرسُ حدَّ العلاج، لا العلاجَ نفسَه.
#      البابُ `emitSafeStringPtr` يُبدِل حارسَ العدمِ بلفظِ «لاشيء» **عند القراءةِ
#      نصًّا**. ولو مرّت به المقارنةُ أيضًا لصار «س == "لاشيء"» صحيحًا — أي
#      لتحوّل عيبُ انهيارٍ إلى عيبِ دلالةٍ أخبثَ منه: لا ينهار فلا يُرى.
#      فالمقارنةُ هُويّةٌ لا عرض، وتبقى خارجَ الباب.
# (EN) Guards the fix's boundary: display substitution must not leak into identity.
# ============================================================

متغير نص س = لاشيء
متغير نص ت = "لاشيء"

# (AR) ① العرضُ واحدٌ — وهذا مقصود.
اطبع_سطر(س)
اطبع_سطر(ت)

# (AR) ② والهُويّةُ مختلفة: عدمٌ ليس نصًّا مكتوبًا فيه «لاشيء».
إذا (س == ت)
    اطبع_سطر("خطأ: العرض تسرّب إلى الهُويّة")
وإلا
    اطبع_سطر("سليم: العرض غير الهُويّة")
نهاية

# (AR) ③ والعدمُ يُعرَف عدمًا بمقارنته بـ«لاشيء» نفسِها.
إذا (س == لاشيء)
    اطبع_سطر("سليم: العدم يُعرَف عدمًا")
وإلا
    اطبع_سطر("خطأ: العدم لم يُعرَف")
نهاية
