# @description صنفُ الإرجاعِ المُصرَّحُ يعبرُ حدَّ الدالّة — حقلٌ نصّيٌّ لا مؤشّرٌ خام.
# @priority P0
# @expected علي\nكائن\nعلي\n30\nعلي

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 المقيسُ قبل السدّ (٢٠٢٦-٠٨-١٧):
#
#          دالة شخص حر() ... ارجع شخص() ... نهاية
#          اطبع_سطر(نص(حر().اسم))     ⇒ المُترجَم `140696668676234` بـrc=0
#
#      والمرجعُ «علي». ⚠️ **والضابطُ يحصر العلّة**: الحقلُ **العدديُّ** عبرَ
#      المسارِ نفسِه (`نص(حر().عمر)`) سليمٌ ⇒ فالإزاحةُ صحيحةٌ والكائنُ سليم،
#      والمفقودُ **نوعُ الحقلِ** وحدَه: يُقرأ `رقم` فيُنسّقُ `نص()` المؤشّرَ عددًا.
#
#      وضابطٌ ثانٍ: `اطبع_سطر(حر().اسم)` بلا `نص()` كان **يعمل** — فالقيمةُ
#      مؤشّرُ نصٍّ صالحٌ، والعطبُ في التنسيقِ لا في القراءة.
#
# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 والعلّةُ **طمسُ إدخالِ الجدول**، لا غيابُ المعلومة
# ═══════════════════════════════════════════════════════════════════
#
#      نوعُ الحقلِ يُستنبَط من `objResult.className`، ويُملأ ذلك من
#      `functionTable_[الدالّة].returnClassName`. وذلك الحقلُ يُكتَب في موضعَين
#      لا يملكهما `funcInfo` المحلّيّ، ثمّ يأتي إسنادٌ في نهايةِ بناءِ الدالّة
#      يستبدل **الإدخالَ كلَّه** فيمحوهما معًا.
#
#      🔑 **وقد كان بجانبِ ذلك الإسنادِ تعليقٌ يصف هذا الفخَّ بعينِه لحقلٍ آخَرَ
#      (`returnElementType`) ويحفظُه — ولم يمتدّ إلى أخيه.** فإصلاحُ حقلٍ واحدٍ
#      من حقولٍ يطمِسُها إسنادٌ واحدٌ يترك العطبَ حيًّا في أخواتِه، ويبدو —
#      لأنّ الباني لا يمرّ بذلك الإسنادِ أصلًا — أنّ «مصدرَ اسمِ الصنفِ هو
#      المُميِّز»، والمُميِّزُ الحقيقيُّ هو المرورُ بالطمس.
#
# (AR) ⚠️ ويبقى مفتوحًا: دالّةٌ **بلا نوعِ إرجاعٍ مُصرَّح** (`دالة حر()`). وقِيس
#      بمِجَسَّين متتابعَين أنّ `ارجع شخص()` يُبنى **قبلَ** موضعِ النداءِ (فلا
#      مشكلةَ ترتيب) وأنّ اسمَ الصنفِ **فارغٌ أصلًا** عندَه — أي أنّ الاستنتاجَ
#      لم ينجح فيُمحى، بل لم ينجح قطّ. وهو قيدٌ مستقلٌّ لا يُخلَط بهذا.
# ═══════════════════════════════════════════════════════════════════

صنف شخص
    نص اسم = "علي"
    رقم عمر = 30
نهاية

دالة شخص هات()
    ارجع شخص()
نهاية

# (AR) ① الشكلُ الذي كان يطبع مؤشّرًا خامًا
اطبع_سطر(نص(هات().اسم))

# (AR) ② والنوعُ عبرَ الحدِّ نفسِه — كان «رقم»
اطبع_سطر(نوع(هات()))

# (AR) ③ وعبرَ متغيّرٍ وسيطٍ — مسارٌ ثالثٌ كان يُخفِق معهما
متغير ك = هات()
اطبع_سطر(نص(ك.اسم))

# (AR) ④ ضابطٌ: الحقلُ العدديُّ عبرَ المسارِ نفسِه — كان سليمًا ويجب أن يبقى
اطبع_سطر(نص(هات().عمر))

# (AR) ⑤ ضابطٌ: الحقلُ النصّيُّ بلا `نص()` — كان سليمًا ويجب أن يبقى
اطبع_سطر(هات().اسم)
