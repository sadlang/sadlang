# @description طريقةٌ نصّيّةٌ على عدمٍ: المفسّرُ يُشخِّصُ والمصرِّفُ ينهار
# @skip_compiler
# @expect_error RUN033

# ============================================================
# (AR) @skip_compiler — ثغرةٌ **مُعلَنة**: المقارنةُ النصّيّةُ أُمِّنَتْ من العدمِ فلا
#      تُستدعى `strcmp` على حارسِ العدمِ أبدًا (البذرة ٠٦٤). أمّا **الطرائقُ**
#      النصّيّةُ — `يحتوي`, `جزء`, وأخواتُها — فلم تُؤمَّنْ بعد: تُستقبِلُ الحارسَ
#      مؤشّرًا وتقرأُ منه ⇒ SIGSEGV (خروج ١٣٩) بلا تشخيصٍ واحد، بينما يُشخِّصُ
#      المفسّرُ `RUN033`.
#
#      والبذرةُ سالبةٌ بـ@expect_error: المفسّرُ **يجبُ** أن يُشخِّص. ولو صمَتَ
#      يومًا لَأخفقَتْ — فهي تحرُسُ التشخيصَ لا غيابَ الانهيارِ وحدَه.
#
#      فالحدُّ سُدَّ في المقارنةِ وحدَها. ونصُّ `type.null` في SoT **مقيَّدٌ بالمقارنةِ
#      صراحةً** فلم يَعِدْ بما لا يفي — لكنّ بقاءَ الثغرةِ بلا بذرةٍ يجعلُها تُنسى.
#
#      وسدُّها بالمكانِ الذي تُقرَأُ فيه القيمةُ فعلًا — مدخلُ الطريقةِ النصّيّة —
#      لا بحارسٍ ساكنٍ يسألُ عن الوسم: النوعُ الساكنُ لا يُقرِّرُ قيمةً جارية، وهو
#      الدرسُ الذي كلَّفَ عشرينَ انحدارًا في هذه الحملة.
# ============================================================

دالة افحص(نص أ)
    اطبع_سطر(نص(أ == لاشيء))
    اطبع_سطر(نص(أ.يحتوي("س")))
نهاية

افحص(لاشيء)
