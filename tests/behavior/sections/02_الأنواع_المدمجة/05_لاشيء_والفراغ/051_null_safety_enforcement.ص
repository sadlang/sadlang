متغير مس = لاشيء
اطبع_سطر("INF:" + نوع(مس))

# ============================================================
# الوصول الآمن عبر اندماج فارغ ?? على متغير اختياري فارغ
# ============================================================
رقم عدمي ق = لاشيء
اطبع_سطر("COAL:" + (ق ؟؟ 42))

# قيمة فعلية في اختياري تبقى
رقم عدمي ك = 9
اطبع_سطر("KEEP:" + (ك ؟؟ 0))

