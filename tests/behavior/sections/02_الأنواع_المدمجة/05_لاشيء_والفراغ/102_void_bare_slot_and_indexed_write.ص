# ============================================================
# (AR) 102 — الخانةُ المجرَّدةُ والكتابةُ المفهرسةُ من نداءٍ فراغيّ:
#   الفراغُ يسكن الخانةَ الديناميّةَ (تصريحًا وإعادةَ إسنادٍ وعنصرَ
#   خريطة) فيُطبَع «لاشيء» و«نوع()» فراغًا و`== لاشيء` خطأً — في
#   المحرّكَين بتطابقٍ حرفيّ. كان المسارُ المترجَم يُفجّر LLVM
#   («null constant») في المستوى الأعلى ويطبع «0» كاذبًا محلّيًّا.
# ============================================================

استورد خرائط

دالة فراغية()
	اطبع("جانب")
نهاية

# ① تصريحُ المستوى الأعلى
متغير س = فراغية()
اطبع(س)
اطبع(نوع(س))
اطبع(س == لاشيء)

# ② إعادةُ الإسناد فوق خانةٍ رقميّة
متغير ع = 1
ع = فراغية()
اطبع(ع)
اطبع(نوع(ع))

# ③ الخانةُ المحلّيّة داخل دالّة
دالة عمل()
	متغير م = فراغية()
	اطبع(م)
	اطبع(نوع(م))
نهاية
عمل()

# ④ عنصرُ خريطةٍ يحمل الفراغَ ويُقرأ موسومًا
متغير سجل = {"أ": 1}
سجل["أ"] = فراغية()
اطبع(سجل["أ"])
اطبع(نوع(سجل["أ"]))

# ⑤ شاهدٌ سلبيّ: القيمةُ الحقيقيّةُ بعد الفراغِ تعود بنوعها
ع = 9
اطبع(ع)
اطبع(نوع(ع))
