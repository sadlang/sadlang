# @description نوعُ مُخرَجِ المدمجةِ يعبرُ حدَّ الدالّةِ باستنتاجٍ — من مصدرِ الحقيقةِ لا بترقيعٍ في المُصرِّف.
# @priority P0
# @expected رقم\nرقم\nنص\nرقم\n5\n5\nرقم!

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 حقلٌ فارغٌ في مصدرِ الحقيقةِ يُخرِج قيمةً من كلِّ استنتاج (ISSUE-147، ٢٠٢٦-٠٨-١٧):
#
#      `دالة خذ(رقم ق) ارجع نوع(ق)` بلا نوعِ إرجاعٍ مُصرَّح كان يطبع
#      `140701799620791` بـrc=0 — مؤشّرًا خامًا لا نصًّا.
#
#      والعلّةُ سطرٌ **غائبٌ** لا سطرٌ خطأ: `returns:` في تعريفِ `نوع` بـ
#      language-truth/builtins/core.yaml. فمستنتِجُ الإرجاعِ يقرأ الحقلَ من
#      السجلّ المولَّد، والفارغُ عندَه «لا أعرف» ⇒ يسقط إلى العدديّ.
#
# (AR) ⚠️ ⚠️ ودرسُه: **الحقلُ الفارغُ ليس محايدًا — هو جوابٌ خاطئٌ بصمت.**
#      وضابطُ ④ يُثبِتُه: `نص()` مجاورةٌ لها في الجدولِ نفسِه وتحمل
#      `returns: نص`، فتعمل. فالفارقُ بيانٌ في مصدرِ الحقيقة، لا آليّةٌ في
#      المُصرِّف — والسدُّ سطرٌ واحدٌ هناك، لا فرعٌ يستثني `نوع` بالاسم.
#
# ═══════════════════════════════════════════════════════════════════
# (AR) ⚠️ ولماذا يقيس هذا الملفُّ المُخرَجَ لا الجدول
# ═══════════════════════════════════════════════════════════════════
#
#      حارسٌ يقرأ `returns:` من الـyaml كان سيخضرّ بمجرّدِ كتابةِ السطر —
#      ولو لم يصل الجدولُ إلى المستنتِج. فالمقياسُ هنا **قيمةٌ مطبوعة**،
#      والضابطُ ⑦ يزيدُها إحكامًا: الضمُّ إلى نصٍّ لا ينجح إلّا إن كانت
#      القيمةُ نصًّا فعلًا — فمؤشّرٌ خامٌّ يظهر رقمًا لا «رقم!».
#
# (AR) ⚠️ وليست عيبَ `أي`: ضابطُ ② يُمرّرُ `أي` معامِلًا فيعمل، وضابطُ ③
#      يُثبِت أنّ الاستنتاجَ يفرّق النصَّ من العددِ زمنَ التشغيل. فالعطبُ كان
#      في **نوعِ الإرجاعِ** وحدَه، ويصيب `رقم` و`نص` كما يصيب `أي`.
# ═══════════════════════════════════════════════════════════════════

# (AR) ① الشكلُ المُنهار: مُخرَجُ `نوع` عبرَ حدِّ دالّةٍ بإرجاعٍ مُستنتَج
دالة خذ(رقم ق)
    ارجع نوع(ق)
نهاية

اطبع_سطر(خذ(5))

# (AR) ② والمعامِلُ `أي` — الشكلُ الثاني، ويُخفِق الإخفاقَ عينَه قبلَ السدّ
دالة خذ_أي(أي ق)
    ارجع نوع(ق)
نهاية

اطبع_سطر(خذ_أي(5))
اطبع_سطر(خذ_أي("مرحبا"))

# (AR) ③ وضابطُ التصريحِ: كان يُصلِحُه وحدَه، فلا ينكسر
دالة نص خذ_مصرح(رقم ق)
    ارجع نوع(ق)
نهاية

اطبع_سطر(خذ_مصرح(5))

# (AR) ④ ⚠️ الضابطُ الحاصر: `نص()` جارتُها في الجدولِ وتحمل `returns`
دالة خذ_نص(رقم ق)
    ارجع نص(ق)
نهاية

اطبع_سطر(خذ_نص(5))

# (AR) ⑤ وضابطُ المدمجةِ العدديّة — لا يُترقّى شيءٌ بالخطأ
دالة خذ_طول(نص س)
    ارجع طول(س)
نهاية

اطبع_سطر(خذ_طول("مرحبا"))

# (AR) ⑥ ⚠️ الضابطُ الحاسم: الضمُّ يُثبِت أنّها نصٌّ لا عددٌ يُطبَع نصًّا
اطبع_سطر(خذ(5) + "!")
