# @description `نوع()` على خانةٍ مكتوبةِ الصنفِ تُجيب «كائن» لا «رقم» — نوعٌ دلاليٌّ لا خانة.
# @priority P0
# @expected كائن\nكائن\nكائن\nكائن\nكائن\nرقم\nنص\nعشري\nمنطقي\nمصفوفة\nخريطة

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 المقيسُ قبل السدّ (٢٠٢٦-٠٨-١٧) — **ثلاثةُ أجوبةٍ بحسبِ صيغةِ التصريح**:
#
#          شخص ك = شخص()      ثمّ نوع(ك)  ⇒ المُترجَم «رقم»
#          شخص ك داخلَ دالّة  ثمّ نوع(ك)  ⇒ المُترجَم «رقم»
#          متغير ك = شخص()    ثمّ نوع(ك)  ⇒ «كائن» ✅
#          نوع(شخص()) مباشرةً             ⇒ «كائن» ✅
#
#      والمرجعُ «كائن» في الأربعة. والصيغتان الناجحتان تُثبِتان أنّ العلّةَ ليست
#      في `نوع()` ولا في الكائنِ، بل في **ما يصلُ إلى `نوع()` عن الخانةِ المكتوبة**.
#
# (AR) 🔑 والسببُ مقيسٌ بالأرقام: نوعُ المتغيّرِ في SIR يخرج `1` (Integer) للمكتوبةِ
#      و`22` (Struct) للمُستنتَجة. و`astTypeToSIRType` تُخفِضُ `صنف`/`بنية` إلى
#      **مقبضٍ معتِمٍ** (i64) لأنّ لا بنيةَ لهما في SIR — وذاك قرارُ **تمثيلٍ**
#      صحيحٌ في موضعِه. والخطأُ أنّ `نوع()` يقرأ ذلك المقبضَ **جوابًا دلاليًّا**.
#
#      ⇒ ودرسُه أعمُّ: **حقلٌ واحدٌ يحمل «كيف يُخزَّن» و«ما هو»، فمن قرأه للسؤالِ
#      الثاني وجد جوابَ الأوّل.** ولا يُصلَح برفعِ التمثيل — ذاك تغييرُ ABI —
#      بل بحملِ النوعِ الدلاليِّ إلى موضعِ السؤالِ وحدَه.
#
# (AR) ⚠️ والضوابطُ الستّةُ الأخيرةُ ليست زينة: حملٌ ينزلق فيَسِمُ كلَّ خانةٍ لها
#      `className` كائنًا يجعل النصَّ والعددَ «كائنًا». ولذلك تُقاس هنا كلُّ
#      عائلةٍ بدائيّةٍ ومركّبةٍ إلى جانبِ الأصناف.
#
# (AR) ⚠️ والتعدادُ الجبريُّ مستثنًى عمدًا ولا يُقاس هنا: `className` يحمل اسمَ
#      التعدادِ أيضًا (لتعملَ `طابق`)، والمرجعُ يُجيب عنه «خريطة» لا «كائن» —
#      فإدخالُه يُبدِل كذبًا بكذب. وهو قيدٌ مفتوحٌ مستقلّ.
# ═══════════════════════════════════════════════════════════════════

صنف شخص
    نص اسم = "علي"
نهاية

# (AR) ① خانةٌ مكتوبةُ الصنفِ في المستوى الأعلى — الشكلُ الذي كان يكذب
شخص ك = شخص()
اطبع_سطر(نوع(ك))

# (AR) ② وداخلَ دالّة — الموضعُ لا يُغيّر المعنى
دالة افحص()
    شخص ج = شخص()
    اطبع_سطر(نوع(ج))
نهاية

افحص()

# (AR) ③ المُستنتَجةُ بـ«متغير» — كانت صحيحةً، فهي ضابطُ عدمِ انحدار
متغير م = شخص()
اطبع_سطر(نوع(م))

# (AR) ④ ومباشرةً بلا خانة
اطبع_سطر(نوع(شخص()))

# (AR) ⑤ وعبرَ خانةِ «أي» — مسارُ الوسمِ زمنَ التشغيل (بذرة ٠٩١)
أي ن = شخص()
اطبع_سطر(نوع(ن))

# (AR) ⑥ ضوابطُ العائلاتِ الأخرى — لا ينزلق إليها الحمل
رقم ع = 5
اطبع_سطر(نوع(ع))

نص س = "مرحبا"
اطبع_سطر(نوع(س))

عشري ش = 3.5
اطبع_سطر(نوع(ش))

منطقي ب = صحيح
اطبع_سطر(نوع(ب))

مصفوفة ف = [1, 2]
اطبع_سطر(نوع(ف))

خريطة خ = {"أ": 1}
اطبع_سطر(نوع(خ))
