# @description كلُّ منفذِ قراءةِ نصٍّ يمرُّ بالبابِ الواحد: خانةٌ نصّيّةٌ تحمل العدمَ تُقرأ «لاشيء» ولا تنهار — طباعةً وضمًّا وطولًا وجزءًا وبحثًا.
# @priority P0

# ============================================================
# (AR) 🔑 العلاجُ في الطبقةِ لا في المنفذ.
#      كان في الخلفيّةِ ~١١٠ موضعِ `inttoptr` في سياقٍ نصّيّ، كلُّ واحدٍ منفذُ
#      انهيارٍ مستقلٌّ حين تحمل الخانةُ حارسَ العدم. وحُصِّنت الطباعةُ أوّلًا وحدَها،
#      فبقي الضمُّ ينهار (مقيس). فصار الحارسُ بابًا واحدًا: `emitSafeStringPtr`.
#
# (AR) والحكمُ هنا **تكافؤُ محرّكَين** لا مجرّدَ عدمِ انهيار: ما يطبعه المفسّرُ
#      يطبعه المترجّم. وأيُّ منفذٍ لم يُحصَ يهبط إلى «لاشيء» لا إلى انهيارِ تجزئة.
#
# (AR) ⚠️ والبابُ لقارئي النصِّ لا لمقارِنيه: المقارنةُ هُويّةٌ لا عرض، فلو مرّت
#      به لصار «س == "لاشيء"» صحيحًا وهو كذب. المقارنةُ تفحص الحارسَ على حدة.
# (EN) One door for text-reading ports; identity comparison deliberately stays out.
# ============================================================

متغير نص س = لاشيء

# (AR) ① الطباعةُ المباشرة — المنفذُ الذي حُصِّن أوّلًا.
اطبع_سطر(س)

# (AR) ② الضمُّ — المنفذُ الذي بقي مفتوحًا بعد رقعةِ الطباعة (مقيس: كان ينهار).
اطبع_سطر("قيمة: " + س)

# (AR) ③ الضمُّ من اليسار كذلك.
اطبع_سطر(س + " :ذيل")

# (AR) ④ النصُّ الحقيقيُّ لا يتأثّر بالبابِ البتّة.
متغير نص ت = "نصّ"
اطبع_سطر("قيمة: " + ت)

# (AR) ⑤ والصفةُ «عدمي» هي التصريحُ المقصودُ لهذه الحالة — ونفسُ المنافذ.
متغير نص عدمي ث = لاشيء
اطبع_سطر(ث)
اطبع_سطر("مع: " + ث)
