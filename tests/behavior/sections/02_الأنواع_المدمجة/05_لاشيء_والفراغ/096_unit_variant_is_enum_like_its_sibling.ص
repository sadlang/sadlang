# @description المتغيِّرةُ الوحدويّةُ تعدادٌ كأختِها ذاتِ الحمولة — في الصيغتَين وعبرَ حدِّ الدالّة.
# @priority P0
# @expected خريطة\nخريطة\nخريطة\nرقم\nلا_شيء\nبعض\nلا_شيء

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 عيبٌ لم تكشفه بذرةُ أختِه (ISSUE-154، ٢٠٢٦-٠٨-١٧):
#
#      سُدَّت ISSUE-153 فصارت `خيار.بعض(5)` تصلُ `Enum` وتُجيب «خريطة».
#      وبقيت `خيار.لا_شيء` تصلُ `Integer` — لأنّها **لا تمرُّ بمسارِ الباني
#      أصلًا**: المتغيِّرةُ الوحدويّةُ تُبنى في بانٍ مولَّدٍ آخرَ في ملفٍّ آخر.
#
# (AR) ⚠️ ⚠️ ودرسُه: **مسارانِ يُنتِجان القيمةَ نفسَها، فسدُّ أحدِهما نصفُ سدّ.**
#      وبذرةُ ٠٩٥ كانت تقيس ذاتَ الحمولةِ وحدَها فأخضرّت على نصفِ العطب.
#      🔑 والسؤالُ الذي يكشفه: «ما المسارُ الآخرُ الذي يُنتِج هذه القيمة؟»
#      لا «هل أصلحتُ ما قِستُ؟».
#
# ═══════════════════════════════════════════════════════════════════
# (AR) ⚠️ وثمنُ الفوتِ لم يكن لفظًا واحدًا بل ثلاثةَ أحكامٍ معًا
# ═══════════════════════════════════════════════════════════════════
#
#      ١) `نوع()` تُجيب «رقم» والمرجعُ «خريطة» — وسمٌ كاذبٌ صامت.
#      ٢) وفي خانةِ `أي` تُوسَم `Int` لا `Adt` — فتُخفِقُ `طابق` في **كلِّ**
#         الأذرعِ وتسقطُ إلى `?` بـrc=0: جوابٌ كاذبٌ لا انهيار.
#      ٣) والصيغتانِ معًا مصابتان: المؤهَّلةُ `خيار.لا_شيء` والعاريةُ `لا_شيء`
#         تُبنَيانِ في ملفَّينِ مختلفَين، فسدُّ إحداهما يترك الأخرى.
#
# (AR) ⚠️ والضابطُ الحاسمُ ⑤: التعدادُ **البسيطُ** `لون.أحمر` يجب أن يبقى «رقم».
#      فهو يسلك مسارًا ثالثًا (ثابتٌ عامٌّ بـLOAD لا نداءَ بانٍ)، ولو انزلق
#      التطبيعُ إليه لصار كلُّ تعدادٍ «خريطة» — وهو تباعُدٌ أوسعُ ممّا سُدَّ.
# ═══════════════════════════════════════════════════════════════════

تعداد خيار
    بعض(رقم)
    لا_شيء
نهاية

تعداد لون
    أحمر
    أخضر
نهاية

# (AR) ① الصيغةُ المؤهَّلةُ في خانةِ «أي» — المسارُ الموسوم
أي أ = خيار.لا_شيء
اطبع_سطر(نوع(أ))

# (AR) ② والصيغةُ المؤهَّلةُ في خانةٍ ساكنة — يجب أن يتّفقا
متغير ب = خيار.لا_شيء
اطبع_سطر(نوع(ب))

# (AR) ③ ⚠️ والصيغةُ العارية: مسارٌ ثانٍ في ملفٍّ آخر، لا تكرارٌ للأوّل
متغير ج = لا_شيء
اطبع_سطر(نوع(ج))

# (AR) ④ ⚠️ الضابطُ الحاسم: التعدادُ البسيطُ يبقى «رقم» — مسارُ الثابتِ العامّ
متغير د = لون.أحمر
اطبع_سطر(نوع(د))

# (AR) ⑤ ⚠️ والحكمُ الثاني: «طابق» عبرَ حدِّ دالّةٍ بمُعامِلِ «أي»
دالة نص افحص(أي ق)
    طابق(ق)
        عندما خيار.بعض(ن)
            ارجع "بعض"
        عندما خيار.لا_شيء
            ارجع "لا_شيء"
    نهاية
    ارجع "?"
نهاية

اطبع_سطر(افحص(خيار.لا_شيء))
اطبع_سطر(افحص(خيار.بعض(5)))

# (AR) ⑥ وضابطُ «طابق» المباشرةِ — كانت سليمةً قبلَ السدِّ ويجب أن تبقى
متغير هـ = خيار.لا_شيء
طابق(هـ)
    عندما خيار.بعض(ن)
        اطبع_سطر("بعض")
    عندما خيار.لا_شيء
        اطبع_سطر("لا_شيء")
نهاية
