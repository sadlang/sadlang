# @description فهرسةُ مفتاحٍ غائبٍ بالقوسِ فراغٌ صادقٌ في الخرائطِ المتجانسةِ كلِّها — لا قمامةَ مؤشّريّةً مترجَمًا.
# @expected لاشيء\nفراغ\n1\n3\nلاشيء\nفراغ\nأهلا\nلاشيء\n3.0\nلاشيء\nمنطقي\nلاشيء\nفراغ\n7\nلاشيء\n20\nكائن
# @priority P0

# ============================================================
# (AR) 🔑 المقيسُ قبل السدّ (٢٠٢٦-٠٨-٢٢): `م = {"أ": 1}` ثمّ `م["غائب"]`
#      مترجَمًا يُرجِع **قمامةً مؤشّريّةً** بوسمِ «رقم» (نحو
#      15762813447569460) بينما يصدُقُ المفسّرُ «لاشيء»/«فراغ» — كذبٌ
#      صامتٌ بـrc=0. العلّةُ: القناتان الخامّان (`__sad_map_get`/`_i64`)
#      لا تحرسان حضورَ المفتاح — مصفوفتا القيمِ والوسومِ غيرُ مصفَّرتَين.
#
#      السدُّ: توحيدُ القراءةِ بالقوسِ على القناةِ الموسومةِ
#      (`__sad_map_get_dyn`) المحروسةِ غيابًا — للمتجانسِ رقمًا ونصًّا
#      وعشريًّا ومنطقيًّا وللخريطةِ والمصفوفةِ المتداخلتَين معًا.
#
#      وضابطُ عدمِ الانحدار الكائنيّ: كان فضاءُ وسومِ الخريطةِ يخلطُ
#      الكائنَ بالخريطةِ (كلاهما وسمُ ٦) فبقيَ الكائنُ يومَها على القناةِ
#      الخامِّ حدًّا معلَنًا — ثمّ سُدَّ جذريًّا (٢٠٢٦-٠٨-٢٢) بوسمٍ مستقلٍّ
#      للكائنِ (٨ ⇄ DynKind::Obj) فصار يمرُّ بالقناةِ الموسومةِ نفسِها:
#      «نوع()» تقولُ «كائن» من الوسمِ، والغيابُ محروسٌ (بذرة ١٠٩).
# ============================================================

# (AR) ① متجانسة رقمية
متغير ر = {"أ": 1، "ب": 2}
اطبع_سطر(ر["غائب"])
اطبع_سطر(نوع(ر["غائب"]))
اطبع_سطر(ر["أ"])
اطبع_سطر(ر["أ"] + ر["ب"])

# (AR) ② متجانسة نصية
متغير ن = {"س": "أهلا"}
اطبع_سطر(ن["غائب"])
اطبع_سطر(نوع(ن["غائب"]))
اطبع_سطر(ن["س"])

# (AR) ③ متجانسة عشرية
متغير ع = {"ط": 2.5، "ظ": 0.5}
اطبع_سطر(ع["غائب"])
اطبع_سطر(ع["ط"] + ع["ظ"])

# (AR) ④ متجانسة منطقية
متغير م = {"صح": صحيح}
اطبع_سطر(م["غائب"])
إذا (م["صح"])
    اطبع_سطر("منطقي")
نهاية

# (AR) ⑤ قيم متداخلة: الغياب فراغ، والحاضر يبقى قابلا للفهرسة
متغير خ = {"داخل": {"عميق": 7}}
اطبع_سطر(خ["غائب"])
اطبع_سطر(نوع(خ["غائب"]))
اطبع_سطر(خ["داخل"]["عميق"])

متغير ق = {"قائمة": [10، 20، 30]}
اطبع_سطر(ق["غائب"])
اطبع_سطر(ق["قائمة"][1])

# (AR) ⑥ ضابط الكائن: لا ينزلق وسمه إلى «خريطة»
صنف كيان
    نص اسم = "شيء"
نهاية
خريطة كائنات = {"ك": كيان()}
