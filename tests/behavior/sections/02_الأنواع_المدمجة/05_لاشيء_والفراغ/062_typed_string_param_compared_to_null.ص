# @description معامِلٌ نصّيٌّ مُصرَّحٌ يُقارَنُ بـ«لاشيء» — مساواةً ولامساواة
# @expected قيمة:مرحبا\nمختلف

# ============================================================
# (AR) كانَ هذا يُسقِطُ البرنامجَ المُصرَّفَ بـSIGSEGV بينما المفسّرُ يُصيب.
#
#      والسببُ حدٌّ لا حارس: «لاشيء» يحملُ وسمَ «عدم» وتمثيلَ حارسٍ i64، فكانَ
#      يسقطُ عندَ بناءِ معامِلِ SIR إلى ثابتٍ صحيحٍ **بوسمِ «صحيح»** — فيضيعُ
#      وسمُ العدمِ عندَ الحدّ. وتفقدُ الخلفيّةُ حينَها كلَّ سبيلٍ لتمييزِ العدمِ من
#      عددٍ عاديّ، فتُحوِّلُ الحارسَ مؤشرًا وتُمرِّرُه إلى strcmp:
#          strcmp(ptr، inttoptr(-9223372036854775807))
#
#      وكانَ في الخلفيّةِ حارسٌ مكتوبٌ لهذا الغرضِ بعينِه — لكنّه **كودٌ ميّت**:
#      شرطُه «وسمُ المعامِلِ عدم» لا يتحقّقُ أبدًا لأنّ الوسمَ ضاعَ قبلَه. ومع
#      ذلكَ كانَ موضعُه خاطئًا أيضًا (تحتَ تفرّعِ شكلِ التمثيلِ لا فوقَه)، ومفقودًا
#      بالكلّيّةِ من مسارِ «!=».
#
#      ولا تكفي حالةٌ واحدة: «عدم == عدم» يجبُ أن يبقى صحيحًا، فالحارسُ حصريٌّ
#      لا شامل.
# ============================================================

دالة جرب(نص س)
    إذا (س == لاشيء)
        اطبع_سطر("عدم")
    وإلا
        اطبع_سطر("قيمة:" + س)
    نهاية

    إذا (س != لاشيء)
        اطبع_سطر("مختلف")
    نهاية
نهاية

جرب("مرحبا")
