# @description عدمٌ يمرُّ عبرَ معامِلٍ مُصرَّحٍ نصًّا — المقارنةُ آمنةٌ من العدم
# @expected صحيح\nخطأ

# ============================================================
# (AR) حكمُ المقارنةِ على العدمِ لا يقومُ على الوسمِ الساكنِ وحدَه، ولا يمكنُ أن يقوم:
#      خانةٌ نوعُها المُصرَّحُ «نصّ» تقبلُ نصًّا في موقعِ نداءٍ وعدمًا في آخر — كما هنا
#      حرفيًّا — فلا وسمَ ساكنًا واحدًا يصدُقُ على الاثنَين. والسؤالُ نفسُه سؤالُ زمنِ
#      تشغيل، فلا يُجابُ بوسمٍ مهما حُمِلَ عبرَ الحدود.
#
#      وكانَ هذا يُسقِطُ البرنامجَ المُصرَّفَ بـSIGSEGV بلا تشخيصٍ ولا رمزِ خطأ، إذ
#      يُمرَّرُ حارسُ العدمِ إلى مقارنةِ النصوص:
#          strcmp(ptr، inttoptr(-9223372036854775807))
#      بينما المفسّرُ يُصيبُ ويُنذِرُ «المعامل 'ب' يتوقع 'نص' لكن حصل على 'فراغ'».
#
#      والفرقُ بينَ هذه و٠٦٢: هناكَ عدمٌ **ساكنٌ** في المقارنةِ نفسِها، وهنا عدمٌ يمرُّ
#      عبرَ الخانةِ فيبلغُ المقارنةَ بوسمِ «نصّ». وسدُّ الأولى لا يسدُّ الثانية.
# ============================================================

دالة قارن_نصين(نص أ، نص ب)
    اطبع_سطر(أ == ب)
نهاية

قارن_نصين("س"، "س")
قارن_نصين("س"، لاشيء)
