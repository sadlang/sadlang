# @description أنواعُ مُخرَجِ المدمجاتِ الثلاثةُ تعبرُ حدَّ الدالّةِ باستنتاجٍ — نصًّا وعشريًّا ومنطقيًّا.
# @priority P0
# @expected ABC\nب\n3.0\n3.141593\nصحيح\nصحيح\n5\n1\nABC!\n2.0

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 حارسُ كنسِ `returns:` (عائلةُ ISSUE-147، ٢٠٢٦-٠٨-١٧):
#
#      ISSUE-147 سُدَّ بسطرٍ واحدٍ لـ`نوع` وحدَها، وبذرةُ 098 تحرسُ ذلك الشكل.
#      وهذه تحرسُ **العائلة**: ٥٣ سطرَ `returns:` كُتِبت في مصدرِ الحقيقةِ
#      بعدَ قياسِ ١١٥ مدمجةً في المحرّكَين — لا بالتخمين.
#
# (AR) ⚠️ ⚠️ ولمَ القياسُ لا التخمين: التخمينُ كان سيكتبُ **سطرًا خطأً**.
#      `باقي` و`تقريب` و`أرضية` و`سقف` تُجيب «رقم» لا «عشري» رغمَ أسمائها،
#      و`حصر` و`اقتطاع` تُجيبان «عشري» رغمَ وسائطَ صحيحة. والسطرُ الخطأُ
#      أسوأُ من الغائب: الغائبُ يسقط إلى العدديِّ فيُصيبُ أحيانًا، والخطأُ
#      يُخطئُ دائمًا وبثقة. ولذلك ضابطُ ⑩ يقيس `اقتطاع` بعينِها.
#
# ═══════════════════════════════════════════════════════════════════
# (AR) ⚠️ وثلاثةُ أصنافٍ لا صنفٌ واحد
# ═══════════════════════════════════════════════════════════════════
#
#      آليّةُ العطبِ واحدةٌ للأصنافِ الثلاثة (`returnType` فارغٌ ⇒ `Unknown`
#      ⇒ سقوطٌ إلى العدديّ)، لكنّ «واحدةٌ» حجّةٌ لا قياس: النصُّ كان يُطبَع
#      مؤشّرًا خامًّا، والعشريُّ يُقرَأ بتّاتِه عددًا، والمنطقيُّ يفقد لفظَه.
#      فيُقاس كلُّ صنفٍ على حدةٍ بمُخرَجٍ مطبوع.
#
# (AR) ⚠️ وضابطُ ⑨ يُحكِمُها: الضمُّ إلى نصٍّ لا ينجح إلّا إن كانت القيمةُ
#      نصًّا فعلًا — فمؤشّرٌ خامٌّ يُظهِر رقمًا لا «ABC!».
# ═══════════════════════════════════════════════════════════════════

استورد نصوص
استورد رياضيات
استورد أساسيات

# (AR) ① صنفُ النصّ: مدمجةٌ تُرجِع نصًّا عبرَ إرجاعٍ مُستنتَج
دالة خذ_كبير()
    ارجع تحويل_كبير("abc")
نهاية

اطبع_سطر(خذ_كبير())

# (AR) ② والشكلُ نفسُه بحروفٍ عربيّةٍ — لا يُفترَض أنّ اللاتينيّةَ تكفي
دالة خذ_مقصوص()
    ارجع قص_أطراف("  ب  ")
نهاية

اطبع_سطر(خذ_مقصوص())

# (AR) ③ صنفُ العشريّ: بتّاتُه كانت تُقرَأ عددًا
دالة خذ_جذر()
    ارجع جذر(9)
نهاية

اطبع_سطر(نص(خذ_جذر()))

# (AR) ④ وثابتٌ عشريٌّ بلا وسائط — شكلٌ ثانٍ من الصنفِ نفسِه
دالة خذ_ط()
    ارجع ط()
نهاية

اطبع_سطر(نص(خذ_ط()))

# (AR) ⑤ صنفُ المنطقيّ: يفقد لفظَه فيُطبَع عددًا
دالة خذ_يبدأ()
    ارجع يبدأ_ب("مرحبا", "م")
نهاية

اطبع_سطر(نص(خذ_يبدأ()))

# (AR) ⑥ ومنطقيٌّ من وحدةٍ أخرى — الحقلُ في SoT لا في وحدةٍ بعينها
دالة خذ_مجلد()
    ارجع هل_مجلد(".")
نهاية

اطبع_سطر(نص(خذ_مجلد()))

# (AR) ⑦ ضابطُ العدديِّ: كان سليمًا بالمصادفةِ فيجب ألّا ينكسر بالسدّ
دالة خذ_طول()
    ارجع طول("مرحبا")
نهاية

اطبع_سطر(نص(خذ_طول()))

# (AR) ⑧ وعدديٌّ ثانٍ من وحدةِ النصوص
دالة خذ_بحث()
    ارجع بحث("مرحبا", "ر")
نهاية

اطبع_سطر(نص(خذ_بحث()))

# (AR) ⑨ ⚠️ الضابطُ الحاسم: الضمُّ يُثبِت أنّها نصٌّ لا عددٌ يُطبَع نصًّا
اطبع_سطر(خذ_كبير() + "!")

# (AR) ⑩ ⚠️ وضابطُ «لا تُخمِّن»: `اقتطاع` بوسيطٍ عشريٍّ تُرجِع عشريًّا
دالة خذ_اقتطاع()
    ارجع اقتطاع(2.9)
نهاية

اطبع_سطر(نص(خذ_اقتطاع()))
