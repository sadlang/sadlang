# @description كائنٌ في خانةِ «أي» يُوسَم كائنًا — لا نصًّا. ووسمُه شرطُ حراسةِ المُستقبِل.
# @priority P0
# @expected كائن\nكائن\nكائن\nكائن\nنص\nرقم\nمصفوفة\nخريطة\nعشري\nمنطقي

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 المقيسُ قبل السدّ (٢٠٢٦-٠٨-١٧): `أي ك = شخص()` ثمّ `نوع(ك)`
#      يُجيبُ **«نص»** والمرجعُ «كائن» — بـrc=0 في الطرفَين، أي كذبٌ صامت.
#
#      والعلّةُ أنّ `صنف`/`بنية` لم تكن لهما ذراعٌ في `toDyn`، فيسقطان إلى
#      `default` فيُستدَلُّ على الوسمِ من **نوع LLVM**: الكائنُ مؤشّرٌ ⇒ `Str`.
#      أي أنّ الاستدلالَ من التمثيلِ محا تمييزًا يحمله النوعُ الساكنُ وحدَه —
#      والتمثيلُ لا يُميّز مؤشّرَ كائنٍ من مؤشّرِ نصّ.
#
# ═══════════════════════════════════════════════════════════════════
# (AR) ⚠️ ⚠️ وأثرُه أوسعُ من `نوع()` بكثير — وهذا سببُ وجودِ هذه البذرة
# ═══════════════════════════════════════════════════════════════════
#
#      حارسُ المُستقبِلِ في `oop_ops.cpp` كان **مَمنوعًا بالنصِّ** من فحصِ
#      الوسمِ على غرارِ `array_ops.cpp`، وسببُ المنعِ مكتوبٌ في التعليقِ هناك:
#      «وسمُ المؤشّرِ في هذه الشجرةِ يكذب، فالكائنُ في خانةِ أي موسومٌ نصًّا،
#      وحارسٌ يُبنى على وسمٍ كاذبٍ يُخفِق على المُستقبِلِ السليم».
#
#      ⇒ فالكذبُ لم يكن يُخطئ جوابًا واحدًا، بل كان **يمنعُ وجودَ حارسٍ
#      بأكملِه**. وبذرةُ ٠٩٢ هي ذلك الحارسُ، وهذه البذرةُ شرطُه.
#
# (AR) ⚠️ والضوابطُ الستّةُ الأخيرةُ ليست زينة: سدٌّ ينزلق فيَسِمُ كلَّ مؤشّرٍ
#      كائنًا يجعل النصَّ «كائنًا» — وهو انحدارٌ أوسعُ من العطبِ الأصليّ.
#      ولذلك تُقاس هنا كلُّ عائلةٍ تمرّ بخانةِ «أي»: نصٌّ ورقمٌ ومصفوفةٌ
#      وخريطةٌ وعشريٌّ ومنطقيّ — كلٌّ منها **وسمٌ مستقلّ**.
# ═══════════════════════════════════════════════════════════════════

صنف شخص
    نص اسم = "علي"
نهاية

دالة أي هات_شخصًا()
    ارجع شخص()
نهاية

# (AR) ① خانةُ «أي» المصرَّحة صراحةً — الشكلُ الذي كان يكذب
أي ك = شخص()
اطبع_سطر(نوع(ك))

# (AR) ② والمستنتَجةُ بـ«متغير» — كانت صحيحةً قبلَ السدّ، فهي ضابطُ عدمِ انحدار
متغير م = شخص()
اطبع_سطر(نوع(م))

# (AR) ③ وعبرَ حدِّ الدالّة — النوعُ المُعلَنُ «أي»، فالوسمُ وحدَه يحمل الجواب
أي ج = هات_شخصًا()
اطبع_سطر(نوع(ج))

# (AR) ④ وعنصرًا في خريطة — مسارُ وسمٍ ثالثٌ مستقلّ
خريطة خ = {"أ": شخص()}
اطبع_سطر(نوع(خ["أ"]))

# (AR) ⑤ ضوابطُ العائلاتِ الأخرى في خانةِ «أي» — لا ينزلق إليها الوسم
أي س = "مرحبا"
اطبع_سطر(نوع(س))

أي ع = 5
اطبع_سطر(نوع(ع))

أي ف = [1, 2]
اطبع_سطر(نوع(ف))

أي ط = {"ب": 1}
اطبع_سطر(نوع(ط))

أي ش = 3.5
اطبع_سطر(نوع(ش))

أي ق = صحيح
اطبع_سطر(نوع(ق))
