# @description خريطةٌ كائنيّةُ القيم: المفتاحُ الغائبُ «فراغ» محروسٌ، والحاضرُ «كائن» بحقولِه — سدُّ آخرِ ذراعٍ خامّ.
# @requires: اطبع_سطر, خرائط
# @priority P0
# @expected MT:فراغ\nMEQ:خطأ\nHT:كائن\nFLD:علي\nSTORE:فراغ

# ============================================================
# (AR) 🔑 المقيسُ قبل السدّ (٢٠٢٦-٠٨-٢٢): كانت الخريطةُ كائنيّةُ القيمِ آخرَ
#      ذراعٍ على القناةِ الخامِّ غيرِ المحروسة، لأنّ فضاءَ وسومِ الخريطةِ كان
#      يخلطُ الكائنَ بالخريطةِ (كلاهما وسمُ ٦) — فلو مرّت بالقناةِ الموسومةِ
#      لكذبت `نوع()` «خريطة». والثمنُ المقيس: `نوع(خ["غائب"])` مترجَمًا
#      «كائن» على قمامةِ خانةٍ (مصفوفتا القيمِ والوسومِ غيرُ مصفَّرتَين)
#      بينما يصدُقُ المفسّرُ «فراغ»؛ و`نص(خ)` **ينهارُ SIGSEGV** إذ يمشي
#      المصيِّرُ على بنيةِ الكائنِ ترويسةَ خريطة.
#
#      السدُّ جذريٌّ لا رقعة: وسمٌ مستقلٌّ للكائنِ (٨ ⇄ DynKind::Obj) في
#      فضاءِ وسومِ قيمةِ الخريطة، فصارَ الكائنُ يمرُّ بالقناةِ الموسومةِ
#      نفسِها: الغيابُ محروسٌ (فراغ) و«نوع()» تصدُقُ «كائن» من الوسم.
#
# (AR) والضابطانِ الأخيرانِ ليسا زينة:
#      HT/FLD: الحاضرُ يبقى كائنًا يُقرأُ حقلُه — فسدٌّ يحرسُ الغيابَ
#      ويقتلُ الوصولَ الساكنَ للأعضاءِ (`خ["أ"].اسم`) انحدارٌ أوسعُ من
#      العطب؛ اسمُ الصنفِ يُنشَرُ من عنصرِ الحاويةِ إلى نتيجةِ القراءة.
#      STORE: قمامةُ الغيابِ لا تعودُ من بابِ التخزين — `ج["س"] = خ["غائب"]`
#      تحفظُ الفراغَ بوسمِه (٥) لا صفرًا بوسمِ كائن.
#
# (AR) ⚠️ حدٌّ معلَنٌ مرافقٌ (خارجَ هذه البذرةِ عمدًا): عرضُ الكائنِ داخلَ
#      حاويةٍ يتباعدُ — المفسّرُ يعرضُ الأغنى «<شخص#1: اسم=علي>» والمترجَمُ
#      عرضًا مُعتِمًا «<كائن>» من مصدرِ الحقيقةِ (الكائنُ المترجَمُ بنيةٌ بلا
#      ترويسةِ أنواعٍ فلا سبيلَ لاسمِ صنفِه زمنَ التشغيل). انظر
#      value_repr.yaml: kObjectOpaqueDisplay.
# ============================================================

استورد خرائط

صنف شخص
    نص اسم = "علي"
نهاية

خريطة خ = {"أ": شخص()}

متغير غائب = خ["غائب"]
اطبع_سطر("MT:" + نوع(غائب))
اطبع_سطر("MEQ:" + (غائب == لاشيء))

اطبع_سطر("HT:" + نوع(خ["أ"]))
اطبع_سطر("FLD:" + خ["أ"].اسم)

متغير ج = خريطة()
ج["س"] = غائب
اطبع_سطر("STORE:" + نوع(ج["س"]))
