# @description TE-001: ثلاثي على لاشيء — يختار الفرع الثاني
# @expected ب\nب
# @priority P1
# (AR) تم إصلاح فجوة المترجم (BF-04 + BF-10): emitCondBranch الآن يفحص
#      `cond != 0 && cond != kSadNullSentinel` للأعداد الصحيحة 64-بت،
#      مما يوحّد دلالة truthy/falsy مع المفسر للقيم لاشيء.
#      راجع: compiler/src/backend/llvm/llvm_codegen_branch_call.cpp

# ============================================================
# اختبار: العامل الثلاثي مع قيمة لاشيء كشرط
# لاشيء يُعامل كقيمة falsy، فيُختار الفرع الثاني
# ============================================================

# لاشيء كشرط مباشر
متغير أ = لاشيء ؟ "أ" : "ب"
اطبع_سطر(أ)

# متغير قيمته لاشيء
متغير قيمة = لاشيء
متغير ب = قيمة ؟ "أ" : "ب"
اطبع_سطر(ب)
