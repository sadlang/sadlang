# إذا/وإلا
متغير س = 10
إذا (س > 0)
    اطبع_سطر("موجب")
وإلا
    اطبع_سطر("سالب")
نهاية

# بينما
متغير ع = 1
بينما (ع <= 3)
    اطبع_سطر(ع)
    ع = ع + 1
نهاية

# لكل
لكل حرف في ["أ"، "ب"، "ج"]
    اطبع_سطر(حرف)
نهاية
