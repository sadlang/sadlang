# @description ز.١٣: ترتيبُ النصوصِ ترتيبيّ — بايتاتُ UTF-8 غيرُ الموقَّعة (= ترتيبُ نقاطِ الترميز)
# @priority P1
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nخطأ

# ============================================================
# (AR) كان المصرِّفُ يبعث ICmpSLT على المؤشّرَين ⇒ **مقارنةُ عناوين** لا محتوًى،
#      فينحرف عن المفسّر: «"5" > "0"» صحيحٌ مفسَّرًا خطأٌ مصرَّفًا.
#      الحالاتُ الأربعُ الأولى تثبّت الدلالة، والخامسةُ والسادسةُ تمسكان الفخّ:
#      المقارنةُ **داخلَ دالّة** (معامِلاتٌ) — مسندُ الضمِّ يستثني المعامِلاتِ عمدًا،
#      فلو أُعيد استعمالُه لبقيت «هو_رقم» مكسورةً بعد «الإصلاح».
#      و«Z» < «ا» تمسك انحرافَ البايتِ الموقَّع (لو قُورن موقَّعًا لصار العربيُّ سالبًا).
# ============================================================

دالة منطقي هو_رقم(نص الحرف)
    ارجع الحرف >= "0" و الحرف <= "9"
نهاية

اطبع_سطر("5" > "0")
اطبع_سطر("ا" < "ب")
اطبع_سطر("سلام" < "سلامي")
اطبع_سطر("Z" < "ا")
اطبع_سطر(هو_رقم("7"))
اطبع_سطر(هو_رقم("س"))
