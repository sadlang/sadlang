# @description OE-031: التقييم القصير لـ و — الجانب الثاني لا يُنفَّذ عند خطأ
# @expected استُدعيت\nلم تُستدعَ
# @priority P1

# ============================================================
# اختبار: Short-circuit evaluation لعامل و
# عند كون الجانب الأيسر خطأ، لا يُقيَّم الجانب الأيمن
# هذا يُختبر بتسجيل الاستدعاءات
# ============================================================

# متغير لتتبع الاستدعاءات
متغير عداد = 0

# دالة ذات تأثير جانبي — تزيد العداد عند الاستدعاء
دالة ذات_تأثير()
    عداد = عداد + 1
    ارجع صحيح
نهاية

# الشرط: صحيح و ذات_تأثير() — يجب أن تُستدعى الدالة
إذا (صحيح و ذات_تأثير())
    اطبع_سطر("استُدعيت")
نهاية

# إعادة ضبط العداد
عداد = 0

# الشرط: خطأ و ذات_تأثير() — يجب أن لا تُستدعى الدالة (تقييم قصير)
إذا (خطأ و ذات_تأثير())
    اطبع_سطر("لا ينبغي هذا")
نهاية

# إذا كان العداد 0 فالتقييم القصير يعمل
إذا (عداد == 0)
    اطبع_سطر("لم تُستدعَ")
نهاية
