# @description ISSUE-063: سَلسلة نصّ + قيمة ديناميكيّة (%SadDyn) وعشري() على وسيط ديناميكيّ — كانت تُلحق فراغًا في المترجم
# @expected مجموع:12.5\nقيمة:3.5\nقيمة:6\nمجموع:9.5\nعشري:2.5
# @priority P1

# ============================================================
# 1. نصّ + عشريّ عبر عشري() — أساس
# ============================================================
متغير ك = عشري(12.5)
اطبع_سطر("مجموع:" + ك)

# ============================================================
# 2. نصّ + نتيجة قسمة ديناميكيّة (%SadDyn) — عشريّة وصحيحة
# ============================================================
دالة أعط(س)
    ارجع س
نهاية
متغير د = أعط(7) / أعط(2)
اطبع_سطر("قيمة:" + د)
متغير هـ = أعط(12) / أعط(2)
اطبع_سطر("قيمة:" + هـ)

# ============================================================
# 3. تراكم عبر عشري(ديناميكيّ) ثمّ سَلسلة — نمط اختبار 063
# ============================================================
متغير مجموع = عشري(0)
مجموع = مجموع + عشري(أعط(4.5))
مجموع = مجموع + عشري(أعط(5))
اطبع_سطر("مجموع:" + مجموع)

# ============================================================
# 4. عشري(وسيط ديناميكيّ) مباشرة في السَلسلة
# ============================================================
اطبع_سطر("عشري:" + عشري(أعط(2.5)))
