# @description إزاحة يمنى حسابيّة `>>` على السالب — تطابق المفسّر (المرجع، ‏int64_t >>): -8>>1=-4 عبر طيّ الحرفيّات ومسار زمن التشغيل (كان المترجم يُصدر إزاحةً منطقيّة LShr ⇒ موجب ضخم)
# @expected -4\n-1\n256\n3\n-4\n-1
# @priority P1

# ── طيّ الثوابت (حرفيّات): يُطوى زمن الترجمة ──
اطبع_سطر(-8 >> 1)
اطبع_سطر(-1 >> 3)
اطبع_سطر(1024 >> 2)
اطبع_سطر(7 >> 1)

# ── متغيّرات: تُنفَّذ في الخلفيّة (AShr) زمن التشغيل ──
متغير س = 0 - 8
اطبع_سطر(س >> 1)
متغير م = 0 - 1
اطبع_سطر(م >> 3)
