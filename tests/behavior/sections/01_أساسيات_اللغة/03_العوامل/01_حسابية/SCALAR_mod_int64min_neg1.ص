# @description الباقي `%` عند INT64_MIN % -1 — النتيجة الرياضيّة صفر والمفسّر (المرجع) يُرجعها صراحةً؛ كان srem الساكن المنمَّط («رقم») ينهار عتاديًّا 0xC0000095 بلا تشخيص (دَين مراجعة أميليا لـ#258) بينما الديناميّ محروس سلفًا بترقية safeRI. ومعه سلامة حالات الباقي العاديّة (إشارة الباقي تتبع المقسوم كالمفسّر).
# @expected 0\n0\n1\n-1\n1
# @priority P0

دالة باقي(رقم أ، رقم ب)
    ارجع أ % ب
نهاية

متغير الأدنى = -9223372036854775807 - 1
متغير سالب1 = 0 - 1

# ── المسار الساكن المنمَّط (كان ينهار #DE) ──
اطبع_سطر(باقي(الأدنى، سالب1))

# ── المسار الديناميّ (محروس سلفًا — تثبيت تكافؤ) ──
اطبع_سطر(الأدنى % سالب1)

# ── حالات عاديّة تبقى سليمة بعد الحارس ──
اطبع_سطر(باقي(7، 3))
متغير ن = 0 - 7
اطبع_سطر(باقي(ن، 3))
متغير م = 0 - 3
اطبع_سطر(باقي(7، م))
