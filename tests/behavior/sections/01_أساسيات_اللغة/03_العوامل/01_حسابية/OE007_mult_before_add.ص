# @description OE-007: أولوية الضرب قبل الجمع — 2 + 3*4 = 14 وليس 20
# @expected 14\n7\n11
# @priority P1

# ============================================================
# اختبار: الضرب * له أولوية أعلى من الجمع + والطرح -
# الضرب يُحسب أولاً قبل الجمع في كل الحالات
# ============================================================

# 2 + (3*4) = 2 + 12 = 14 — وليس (2+3)*4 = 20
متغير أ = 2 + 3 * 4
اطبع_سطر(أ)

# 1 + (3*2) = 1 + 6 = 7
متغير ب = 1 + 3 * 2
اطبع_سطر(ب)

# 2 + (3*3) = 2 + 9 = 11
متغير جـ = 2 + 3 * 3
اطبع_سطر(جـ)
