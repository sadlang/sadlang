#      (int**int → int، float involved → float). راجع
#      compiler/src/frontend/sir_builder_operators.cpp + llvm_codegen_builtins_math_async.cpp

# ============================================================
# اختبار: الأسّ ** له أولوية أعلى من الضرب *
# الأسّ يُحسب أولاً ثم الضرب
# ============================================================

# 2 * (3**2) = 2 * 9 = 18 — وليس (2*3)**2 = 36
متغير أ = 2 * 3 ** 2
اطبع_سطر(أ)

# 2 * (5**2) = 2 * 25 = 50
متغير ب = 2 * 5 ** 2
اطبع_سطر(ب)

# (2**3) = 8 ثم بدون ضرب خارجي
متغير جـ = 2 ** 3
اطبع_سطر(جـ)
