# @description ISSUE-063 (مُحدَّث بعد تثبيت دلالة C): `/` على صحيحين تقتطع نحو الصفر (7/2=3 و-7/2=-3)، ومعاملٌ عشريٌّ واحدٌ يرقّي النتيجة. النوعُ يتقرّر من نوعَي المعاملَين لا من وجود الباقي — عبر طيّ الثوابت والمتغيّرات والمسار الديناميكيّ.
# @expected 3\n2\n-3\n3\n3\n2\n-3\n6\n3\n1.5\n-4\n-3
# @priority P1

# ============================================================
# 1. طيّ الثوابت (حرفيّات) — يطوى في المترجم زمن الترجمة
# ============================================================
اطبع_سطر(7/2)
اطبع_سطر(6/3)
اطبع_سطر(-7/2)
اطبع_سطر(6/2)

# ============================================================
# 2. متغيّرات — النوعُ من نوعَي المعاملَين، لا من فحص الباقي زمن التشغيل
# ============================================================
متغير أ = 7
متغير ب = 2
اطبع_سطر(أ/ب)
متغير ج = 6
متغير د = 3
اطبع_سطر(ج/د)
متغير س = 0 - 7
اطبع_سطر(س/ب)

# ============================================================
# 3. المسار الديناميكيّ (%SadDyn) — معامل مُستنتَج متعدّد الأنواع
# ============================================================
دالة نصف(ق)
    ارجع ق / 2
نهاية
اطبع_سطر(نصف(12))
اطبع_سطر(نصف(7))
اطبع_سطر(نصف(3.0))

# ============================================================
# 4. الفصلُ عن `//` الأرضيّة — عند السالب يفترق الاتّجاهان:
#    `//` تقرّب نحو سالب اللانهاية، و`/` تقتطع نحو الصفر
# ============================================================
اطبع_سطر(-7 // 2)
اطبع_سطر(-7 / 2)
