# @description وسيطٌ عشريّ لمعاملٍ مصرَّح «رقم» — الأنواع العدديّة المصرَّحة إرشاديّةٌ كالمفسّر (المرجع يُنذر على stderr ويمرّر القيمة كما هي): كان المترجَم يقتطع fptosi عند حدود الاستدعاء (0.5⇒0) فيرمي «قسمة 7 على صفر» كاذبة المضمون (دَين مراجعة أميليا لـ#258)؛ صارت ترقية المرحلة 1.7 العدديّة (عشريّ فقط⇒Float، مختلط⇒Any) تسري على المصرَّح «رقم» أيضًا.
# @expected 14.0\n3.5\n4.0\n6\n5.0
# @priority P0

دالة اقسم(رقم أ، رقم ب)
    ارجع أ / ب
نهاية
اطبع_سطر(اقسم(7.0، 0.5))
اطبع_سطر(اقسم(7.0، 2.0))

دالة اجمع(رقم أ، رقم ب)
    ارجع أ + ب
نهاية
اطبع_سطر(اجمع(2.5، 1.5))

# ── مواقع مختلطة (صحيح وعشريّ) ⇒ ديناميّ يحفظ صنف القيمة كالمفسّر ──
دالة ضعف(رقم س)
    ارجع س + س
نهاية
اطبع_سطر(ضعف(3))
اطبع_سطر(ضعف(2.5))
