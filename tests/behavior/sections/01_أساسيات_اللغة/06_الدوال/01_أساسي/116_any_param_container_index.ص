# @description معامِلٌ مُصرَّحٌ «أي» يحمل حاويةً: الفهرسةُ والطولُ ومفتاحُ الخريطةِ تعمل مصرَّفةً كما مفسَّرةً. كانت الفهرسةُ تُعامِل **عنوانَ خانةِ %SadDyn** مؤشّرَ مصفوفةٍ فتقرأ بايتَ الوسمِ طولًا: SIGSEGV، أو — أخطر — مخرَجٌ سليمُ الشكلِ فاسدُ القيَمِ برمزِ خروجٍ ٠ لأنّ وسمَ النتيجةِ كان يُصلَّبُ «عددًا صحيحًا» في الدمج
# @expected 20\nأ\nصحيح\n1\nب\nصحيح\n4\n7\n1|ب|صحيح|\nخطأ\n=== انتهى ===
# @priority P0

# (AR) الفاصلُ يظهر في `@expected` نفسِه (`1|ب|صحيح|`) فهو عقدُ الاختبارِ لا زينة.
ثابت فاصل_العناصر = "|"
ثابت نص_فارغ = ""

دالة نص عنصر(أي الحاوية، رقم الفهرس)
    ارجع نص(الحاوية[الفهرس])
نهاية

دالة رقم طول_الحاوية(أي الحاوية)
    ارجع طول(الحاوية)
نهاية

دالة نص قيمة_المفتاح(أي الحاوية، نص المفتاح)
    ارجع نص(الحاوية[المفتاح])
نهاية

# ═══ عددٌ صحيح — كان يعمل مصادفةً لأنّ الوسمَ المُصلَّبَ يوافقه ═══
اطبع_سطر(عنصر([10، 20، 30]، 1))

# ═══ نصٌّ ومنطقيّ — هنا يظهر الفسادُ الصامت ═══
# (AR) بالوسمِ المُصلَّبِ «عدد صحيح» كان النصُّ يُطبَع **عنوانَ مؤشّرِه** والمنطقيُّ
#      «1» بدل «صحيح» — برمزِ خروجٍ ٠ يجتاز أيَّ فحصِ رمزِ خروج. فالمطابقةُ
#      النصّيّةُ هي الحارسُ الوحيدُ الذي يكشف هذا الصنف.
اطبع_سطر(عنصر(["أ"، "ب"]، 0))
اطبع_سطر(عنصر([صحيح، خطأ]، 0))

# ═══ حاويةٌ مختلطة: الوسمُ يأتي من مخزنِ الوسومِ لكلِّ عنصرٍ على حدة ═══
اطبع_سطر(عنصر([1، "ب"، صحيح]، 0))
اطبع_سطر(عنصر([1، "ب"، صحيح]، 1))
اطبع_سطر(عنصر([1، "ب"، صحيح]، 2))

# ═══ الطولُ ومفتاحُ الخريطةِ على المعامِلِ «أي» نفسِه ═══
# (AR) المفتاحُ يقيس فرعَ الخريطةِ في الإرسالِ الزمنيِّ (خريطة/مصفوفة)، وكان
#      لا يُفعَّل أصلًا لأنّ فحصَ «أهي موسومة؟» يقع على **خانةٍ** لا قيمة.
اطبع_سطر(نص(طول_الحاوية([1، 2، 3، 4])))
اطبع_سطر(قيمة_المفتاح({"س": 7}، "س"))

# ═══ فهرسةٌ داخلَ حلقةٍ — تُثبِت أنّ الإصلاحَ ليس خاصًّا بموضعٍ واحد ═══
دالة نص اجمع_موسوما(أي الحاوية)
    متغير الناتج = نص_فارغ
    متغير عداد = 0
    بينما (عداد < طول(الحاوية))
        الناتج = الناتج + نص(الحاوية[عداد]) + فاصل_العناصر
        عداد = عداد + 1
    نهاية
    ارجع الناتج
نهاية

اطبع_سطر(اجمع_موسوما([1، "ب"، صحيح]))

# ═══ شاهدٌ سالبٌ لازم ═══
# (AR) لولاه لمرّ الاختبارُ ولو كانت الفهرسةُ تعيد العنصرَ نفسَه لكلِّ فهرس.
اطبع_سطر(نص(عنصر([10، 20، 30]، 1) == عنصر([10، 20، 30]، 2)))

اطبع_سطر("=== انتهى ===")
