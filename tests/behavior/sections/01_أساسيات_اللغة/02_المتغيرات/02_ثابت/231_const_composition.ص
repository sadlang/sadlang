# @description ثوابت مركّبة: ثابت مشتق من ثوابت أخرى
# @expected 25\n30
# @priority P1

# ============================================================
# اختبار: تركيب ثوابت — ثابت يعتمد على ثوابت أخرى في قيمته
# يتحقق من أن التعابير الحسابية بين الثوابت تعمل بشكل صحيح
# ============================================================

# ثوابت أبعاد
ثابت قاعدة = 10
ثابت ارتفاع = 5

# ثابت مشتق: مساحة المثلث = (القاعدة × الارتفاع) / 2 = 25.0
ثابت المساحة = قاعدة * ارتفاع / 2

# ثابت مشتق: محيط المستطيل = 2 × (القاعدة + الارتفاع) = 30
ثابت المحيط = 2 * (قاعدة + ارتفاع)

اطبع_سطر(المساحة)
اطبع_سطر(المحيط)
