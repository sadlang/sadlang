# @description ثوابت في الشروط: استخدام ثابت كعتبة مقارنة
# @expected بالغ\nقاصر\nبالغ
# @priority P1

# ============================================================
# اختبار: استخدام الثوابت كعتبات في الشروط
# يتحقق من أن الثوابت تعمل بشكل صحيح كحدود في if/else
# ============================================================

# ثابت يمثل عمر الرشد
ثابت عمر_الرشد = 18

# دالة تستخدم الثابت للمقارنة
دالة تحقق_عمر(عمر)
    إذا (عمر >= عمر_الرشد)
        ارجع "بالغ"
    وإلا
        ارجع "قاصر"
    نهاية
نهاية

# ثلاثة سيناريوهات مختلفة
اطبع_سطر(تحقق_عمر(20))    # أكبر من 18 → بالغ
اطبع_سطر(تحقق_عمر(15))    # أصغر من 18 → قاصر
اطبع_سطر(تحقق_عمر(18))    # يساوي 18 → بالغ
