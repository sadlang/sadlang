# @description ثوابت في مطابقة الأنماط: ثوابت كرموز أخطاء في match
# @expected خطأ شبكة\nخطأ ملف\nخطأ إذن\nخطأ غير معروف
# @priority P2

# ============================================================
# اختبار: استخدام الثوابت كرموز في مطابقة الأنماط
# يتحقق من أن الثوابت الرقمية قابلة للاستخدام في طابق/عندما
# ============================================================

# رموز الأخطاء كثوابت
ثابت خطأ_شبكة = 1
ثابت خطأ_ملف = 2
ثابت خطأ_إذن = 3

# دالة تُترجم رمز الخطأ إلى رسالة
دالة وصف_خطأ(رمز)
    طابق (رمز)
        عندما 1:
            ارجع "خطأ شبكة"
        عندما 2:
            ارجع "خطأ ملف"
        عندما 3:
            ارجع "خطأ إذن"
        افتراضي:
            ارجع "خطأ غير معروف"
    نهاية
نهاية

# اختبار الثوابت في استدعاء الدالة
اطبع_سطر(وصف_خطأ(خطأ_شبكة))
اطبع_سطر(وصف_خطأ(خطأ_ملف))
اطبع_سطر(وصف_خطأ(خطأ_إذن))
اطبع_سطر(وصف_خطأ(99))
