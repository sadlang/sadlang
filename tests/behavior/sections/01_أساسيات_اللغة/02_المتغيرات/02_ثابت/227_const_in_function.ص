# @description ثوابت داخل دوال: الثابت الخارجي مرئي من الدالة
# @expected 10\n30\n200
# @priority P1

# ============================================================
# اختبار: رؤية الثوابت من داخل الدوال
# يتحقق من أن الثوابت المعرّفة في النطاق العام مرئية للدوال
# ============================================================

# ثابت في النطاق العام
ثابت المعامل = 2

# دالة تستخدم الثابت
دالة تضاعف(قيمة)
    ارجع قيمة * المعامل
نهاية

# استدعاءات متعددة تثبت أن الثابت لا يتغير
اطبع_سطر(تضاعف(5))
اطبع_سطر(تضاعف(15))
اطبع_سطر(تضاعف(100))
