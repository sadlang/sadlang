# @rule: gr.decl.parameters
# @description: «بايت» u8 يقتطع عند معابر الدالة الحرة الأربعة — تصريحا وإعادة إسناد ومعاملا وعائدا (المعابر داخل الأصناف ثقب موثق)
# @requires: اطبع_سطر
# @priority P0
# @expected 44\n144\n44\n44\n255\n0\n255\n44
#
# ============================================================
# (AR) 🔑 «عقدٌ مصونٌ في نصفِ معابرِه عقدٌ غيرُ مصون»: مصدرُ الحقيقةِ يُعلن
#      «بايت» u8 مدىً 0–255، وكان الاقتطاعُ مسدودًا عند التصريحِ وإعادةِ
#      الإسنادِ وحدَهما. فكان النوعُ الواحدُ يعني شيئًا عند التصريحِ وشيئًا
#      آخرَ عند المعامل — والمحرّكانِ **متّفقانِ على الخطأ**، فلا تكشفُه
#      بوّابةُ التكافؤِ بينهما. العقدُ يُقاس على إعلانِه لا على توافقِ
#      المحرّكَين عليه.
#
# (AR) والمعابرُ الأربعةُ في بذرةٍ واحدةٍ عمدًا: سدُّ أحدِها وترْكُ إخوتِه
#      هو النمطُ الذي تكرّر ههنا فعلًا، فتحرسُها بذرةٌ واحدةٌ معًا.
# ============================================================

دالة تجربة(بايت ب)
    اطبع_سطر(ب)
نهاية

دالة بايت مصنع(رقم س)
    ارجع س
نهاية

# (AR) ١) التصريح: باقي 300 على 256 = 44
متغير بايت أ = 300
اطبع_سطر(أ)

# (AR) ٢) إعادة الإسناد: باقي 400 على 256 = 144
أ = 400
اطبع_سطر(أ)

# (AR) ٣) ربط المعامل: كان يطبع 300
تجربة(300)

# (AR) ٤) العائد: كان يطبع 300
اطبع_سطر(مصنع(300))

# (AR) وحدّا المدى: 255 يمرّ كما هو، و256 يلتفّ إلى 0
اطبع_سطر(مصنع(255))
اطبع_سطر(مصنع(256))

# (AR) والدلالةُ لا-موقَّعةٌ: -1 يصيرُ 255 لا سالبًا
اطبع_سطر(مصنع(-1))

# (AR) والذراعُ الموسومةُ (TRUNCATE_U8): حمولةُ القسمةِ تُحسَمُ زمنَ التشغيل
دالة بايت قسمة(رقم أ، رقم ب)
    ارجع أ / ب
نهاية
اطبع_سطر(قسمة(600، 2))
