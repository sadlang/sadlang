# @description VE-034: حقول الصنف تأخذ القيمة الافتراضيّة لأنواعها — بالإنشاء الصريح
# @expected 0\n[]\nخطأ\n0.0\n0\n[]\nخطأ\n0.0
# @priority P1

# ============================================================
# اختبار: «الصنف مركّب من متغيّرات» — قرار مالك 2026-08-15
# (20_declarations.yaml · gr.decl.variable)
#
# حقلُ الصنف خانةٌ كالخانة المحلّيّة، فيتبع الجدول نفسه:
#   رقم ⇒ 0 · نص ⇒ "" · منطقي ⇒ خطأ · عشري ⇒ 0.0
#
# ⚠️ لا يُقرأ الكائنُ بـ«نص(ك)» بل يُقرأ **كلُّ حقلٍ على حدة**: الطابع
# يعرض الفراغَ بلفظِ «لاشيء»، فقراءةُ الكائنِ مجملاً تُخفي العطبَ تماماً
# (وهو ما أخفاه فعلاً في المِجَسّ L12 من مصفوفة تعريف المتغيّر).
#
# القياسُ قبل الإصلاح (2026-08-15):
#   المفسّر : [لاشيء|لاشيء|لاشيء|لاشيء]  ← صفرٌ من أربعة
#   المترجم: [0|لاشيء|0|0]              ← واحدٌ من أربعة
# والمتغيّرُ المحلّيُّ بالأنواع نفسِها يعطي [0||خطأ|0.0] في المحرّكين معاً،
# فمسارُ الحقلِ مسارٌ متمايزٌ لا يرث إصلاحَ buildLocalVariable.
#
# النصُّ الفارغ يُغلَّف بمعقوفين كي لا يلتبس بسطرٍ خالٍ عند المقارنة.
# ============================================================

صنف شخص
    رقم سن
    نص اسم
    منطقي فعّال
    عشري وزن
نهاية

# ── الإنشاء الصريح على مستوى الوحدة ──
متغير كائن = شخص()

اطبع_سطر(كائن.سن)
اطبع_سطر("[" + كائن.اسم + "]")
اطبع_سطر(كائن.فعّال)
اطبع_سطر(كائن.وزن)

# ── الإنشاء الصريح داخل دالّة ──
دالة افحص_داخل_دالة()
    متغير كائن_محلّي = شخص()

    اطبع_سطر(كائن_محلّي.سن)
    اطبع_سطر("[" + كائن_محلّي.اسم + "]")
    اطبع_سطر(كائن_محلّي.فعّال)
    اطبع_سطر(كائن_محلّي.وزن)
نهاية

افحص_داخل_دالة()
