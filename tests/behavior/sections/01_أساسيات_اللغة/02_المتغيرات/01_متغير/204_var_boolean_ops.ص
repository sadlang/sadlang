# @description متغيرات منطقية وعمليات: و، أو، ليس
# @expected صحيح\nخطأ\nصحيح\nخطأ\nصحيح\nصحيح
# @priority P1

# ============================================================
# اختبار: المتغيرات المنطقية والعمليات المنطقية
# يتحقق من صحة العمليات المنطقية الأساسية
# ============================================================

# تعريف متغيرين منطقيين
متغير صح = صحيح
متغير خط = خطأ

# طباعة القيم الأصلية
اطبع_سطر(صح)
اطبع_سطر(خط)

# العمليات المنطقية
اطبع_سطر(صح و صح)    # صحيح و صحيح = صحيح
اطبع_سطر(صح و خط)    # صحيح و خطأ = خطأ
اطبع_سطر(صح أو خط)   # صحيح أو خطأ = صحيح
اطبع_سطر(ليس خط)     # ليس خطأ = صحيح
