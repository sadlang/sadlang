# @rule: gr.decl.variable
# @description حقلٌ نوعُه صنفٌ يُنشَأ تعاوديًّا لا يُترَك عدمًا — ولا مشاركةَ بين النُّسَخ
# @requires: اطبع_سطر
# @priority P0
# @expected 1\n9|1|4

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 اطّرادُ قرارِ المالك: «يأخذ كلُّ متغيّرٍ القيمةَ الافتراضيّةَ لنوعِه»
# ═══════════════════════════════════════════════════════════════════
#
# (AR) والقيمةُ الافتراضيّةُ لنوعٍ **صنفيٍّ** كائنٌ مُنشَأٌ لا مؤشّرٌ صفريّ،
#      فينزل التصريحُ حتّى القاع: `شخص ك` ⇒ يُنشَأ `ك`، وحقلُه `د` يُنشَأ
#      معه، وحقلُ `د` يأخذ افتراضيَّه.
#
#      قِيس قبلَ هذه البذرة (2026-08-16): المفسّرُ يطبع `1` والمترجّمُ
#      **يبني برمزِ خروجٍ صفرٍ ثمّ ينهار `rc=139`**.
#
# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 والعطبُ كان في **ثلاثةِ** أبوابٍ لا بابٍ واحد
# ═══════════════════════════════════════════════════════════════════
#
#   ١ · بابُ التسجيل: المُهيّئُ المُحلَّى `NewExpr` كان يسقط صامتًا لأنّ
#       جدولَ القيمِ الافتراضيّةِ لا يقبل إلّا الحرفيّات.
#   ٢ · بابُ الإنشاء: وُصِل في `emitConstructorCall` — **فلم يتغيّر شيء**.
#       والسببُ أنّ التصريحَ المجرَّدَ لا يمرُّ بالباني أصلًا بل بمسارِ
#       تخصيصٍ توأمٍ يكرّر التصفيرَ والقيمَ الافتراضيّة. (قرأتُ المُخرَجَ:
#       `malloc(16)` واحدٌ ثمّ `movq 8(%rax)` على خانةٍ صفريّة.)
#   ٣ · بابُ القراءة: `ك.د` كانت تخرج بصنفِ **الحاوي** لا بصنفِ الحقل،
#       فيُبحَث عن `.ق` في الصنفِ الخطأِ ويُحمَّل بإزاحةٍ لا تخصُّه.
#
#      🔑 والدرسُ: **الكتابةُ والقراءةُ بابان، وسدُّ أحدِهما يترك العطبَ حيًّا
#      كما هو** — وقد قِيس ذلك مرّتَين في هذا العيبِ وحدَه.
#
# ═══════════════════════════════════════════════════════════════════
# (AR) والسطرُ الثاني هو نصفُ البذرةِ الآخَر: لا مشاركةَ بين النُّسَخ
# ═══════════════════════════════════════════════════════════════════
#
# (AR) لو أُنشئ الكائنُ الداخليُّ **مرّةً** وشاركته النُّسَخُ لصار تعديلُ
#      حقلِ واحدةٍ يمسّ الأخرى — وهو عطبٌ صامتٌ لا ينهار، فلا يكشفه إلّا
#      قياسُ نسختَين. ولذلك تُقاس `ب` بعدَ تعديلِ `أ`، ويُقاس معهما حقلٌ
#      عاديٌّ (`ن`) ليَثبُتَ أنّ التعشيشَ لم يُزحزِح إزاحاتِ الحقولِ الأخرى.
# ═══════════════════════════════════════════════════════════════════

صنف داخلي
    رقم ق = 1
نهاية

صنف شخص
    داخلي د
    رقم ن = 4
نهاية

شخص ك
اطبع_سطر(نص(ك.د.ق))

شخص أ
شخص ب
أ.د.ق = 9
اطبع_سطر(نص(أ.د.ق) + "|" + نص(ب.د.ق) + "|" + نص(أ.ن))
