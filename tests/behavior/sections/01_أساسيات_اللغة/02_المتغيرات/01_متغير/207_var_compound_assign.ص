# @description الإسناد المركّب الكامل: +=، -=، *=، %=
# @expected 15\n12\n24\n3
# @priority P1

# ============================================================
# اختبار: عوامل الإسناد المركّب على المتغيرات
# يتحقق من صحة كل عامل مركّب بالتسلسل
# ============================================================

# نقطة البداية
متغير س = 10

# إسناد جمع مركّب: 10 + 5 = 15
س += 5
اطبع_سطر(س)

# إسناد طرح مركّب: 15 - 3 = 12
س -= 3
اطبع_سطر(س)

# إسناد ضرب مركّب: 12 * 2 = 24
س *= 2
اطبع_سطر(س)

# إسناد باقي مركّب: 24 % 7 = 3
س %= 7
اطبع_سطر(س)
