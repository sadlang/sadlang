# @description عامل الاندماج الفارغ ?? مع متغيرات: سلسلة، قيمة موجودة، لاشيء متعدد
# @expected قيمة_افتراضية\nموجود\nآخر
# @priority P1

# ============================================================
# اختبار: عامل ?? (Null Coalescing) مع سيناريوهات متعددة
# يتحقق من التعامل الصحيح مع لاشيء في الاندماج
# ============================================================

# لاشيء ?? قيمة → القيمة
متغير أ = لاشيء
متغير ب = أ ?? "قيمة_افتراضية"
اطبع_سطر(ب)

# قيمة_موجودة ?? أخرى → الموجودة
متغير ج = "موجود"
متغير د = ج ?? "افتراضي"
اطبع_سطر(د)

# سلسلة: لاشيء ?? لاشيء ?? قيمة → القيمة
متغير هـ = لاشيء ?? لاشيء ?? "آخر"
اطبع_سطر(هـ)
