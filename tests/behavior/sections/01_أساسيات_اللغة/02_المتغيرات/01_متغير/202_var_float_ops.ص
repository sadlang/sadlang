# @description عمليات حسابية على متغيرات الأعداد العشرية: جمع، طرح، ضرب، قسمة
# @expected 6.5\n1.5\n10.0\n1.6
# @priority P1

# ============================================================
# اختبار: العمليات الحسابية على الأعداد العشرية
# يتحقق من دقة الحسابات العشرية
# ============================================================

# تعريف متغيرين عشريين
متغير س = 2.5
متغير ص = 4.0

# جمع: 2.5 + 4.0 = 6.5
اطبع_سطر(س + ص)

# طرح: 4.0 - 2.5 = 1.5
اطبع_سطر(ص - س)

# ضرب: 2.5 * 4.0 = 10.0
اطبع_سطر(س * ص)

# قسمة: 4.0 / 2.5 = 1.6
اطبع_سطر(ص / س)
