# @rule: gr.decl.variable
# @description «طابق» يرى عدمَ «عشري»/«منطقي» في المحرّكَين — بعد وسمِهما خارجَ النطاق
# @requires: اطبع_سطر
# @priority P0
# @expected عدم\nقيمة\nعدم\nقيمة

# ═══════════════════════════════════════════════════════════════════
# (AR) ✅ اخضرّت عند م‑ب (منطقي) وم‑ج (عشري) — كما تنبّأ سطرُ @known_red
# ═══════════════════════════════════════════════════════════════════
#
# (AR) كانت حمراءَ مُعلَنةً لأنّ المترجّمَ يجيب «قيمة» عن «لاشيء» في النوعَين.
#      وموضعُ العطبِ لم يكن في «طابق» بل في **تخفيضِ الخانة**:
#        • `منطقي؟` معامِلًا كان `i1` ⇒ وسيطُ `لاشيء` ووسيطُ `صحيح` بتّاتٌ
#          متطابقةٌ حرفيًّا، فلا مستهلِكَ يفرّق بينهما.
#        • `عشري؟` خانتُه `double` والحارسُ i64 ⇒ `sitofp` يُحوّله عددًا
#          عشريًّا هائلًا، أي **تحويلُ دلالةٍ لا بترُ عرض**.
#      فلمّا صار النوعانِ يُخزَّنان `%SadDyn` (وسمٌ خارجَ نطاقِ القيمة) زال
#      التصادمُ من أصلِه، ولم يُضَف حارسٌ واحدٌ في «طابق».
#
# (AR) 🔑 ولذلك حُذِف سطرُ @known_red ولم يُترَك: النجاحُ غيرَ المتوقَّعِ يُقلَب
#      إخفاقًا في المُشغّل عمدًا — فبذرةٌ تُركت حمراءَ مُعلَنةً بعد أن صحّت
#      تُخفِق وتُخفي أنّها صحّت.
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 العائلتانِ المكسورتانِ نفسُهما — في بابٍ ثالث
# ═══════════════════════════════════════════════════════════════════
#
# (AR) قِيس أنّ «عشري» و«منطقي» يفترقان عن المفسّرِ في **ثلاثةِ أبوابٍ**، لا
#      في بابِ الطباعةِ وحدَه كما كان يُظنّ:
#        ① «نص(س)» ⇒ ‎-9223372036854775808.0‎ و«صحيح» بدل «لاشيء».
#        ② «س ؟؟ بديل» ⇒ إجهاضُ PHI للعشريّ، و«صحيح» للمنطقيّ.
#        ③ **«طابق (س) / عندما لاشيء»** ⇒ «قيمة» — أي أنّ ذراعَ العدمِ لا
#          تُطابَق أصلًا، وهذه البذرة.
#      والأنواعُ الأربعةُ الأخرى (رقم · نص · بايت · طبيعي) تُجيب «عدم»
#      صحيحًا في البابِ ③ اليوم — تحرسها VE056.
#
#      🔑 والدلالةُ: العلّةُ **ليست في الطابع**. لو كانت لأجابت «طابق» صحيحًا.
#      هي في أنّ الحارسَ لا يبقى محفوظًا في خانةِ هذين النوعَين أصلًا: خانةُ
#      «عشري» ‎alloca double‎ فيُحوَّل الحارسُ عددًا عشريًّا حقيقيًّا (لا بتّاتٍ
#      محفوظة)، ومنطقيُّ العدمِ يُقصَر إلى بتٍّ واحد. فأيُّ رقعةٍ في الطابعِ
#      رقعةٌ في **الطبقةِ الخطأ**.
#
# (AR) ⚠️ تخضرّ عند م‑ب (منطقي) وم‑ج (عشري). فإن خضرّت **قبلَهما** فليست
#      إصلاحًا: الاحتمالُ الأرجحُ توسيعُ «ما يُعَدُّ عدمًا» حتّى ابتلع قيمًا
#      صحيحة — وتلك تُمسَك ببوّابتَي §٥-ب العكسيّتَين لا بهذه البذرة.
# ═══════════════════════════════════════════════════════════════════

دالة افحص_عشري(عشري عدمي س)
    طابق (س)
        عندما لاشيء:
            اطبع_سطر("عدم")
        عندما غير_ذلك:
            اطبع_سطر("قيمة")
    نهاية
نهاية

دالة افحص_منطقي(منطقي عدمي س)
    طابق (س)
        عندما لاشيء:
            اطبع_سطر("عدم")
        عندما غير_ذلك:
            اطبع_سطر("قيمة")
    نهاية
نهاية

افحص_عشري(لاشيء)
افحص_عشري(1.5)
افحص_منطقي(لاشيء)
افحص_منطقي(صحيح)
