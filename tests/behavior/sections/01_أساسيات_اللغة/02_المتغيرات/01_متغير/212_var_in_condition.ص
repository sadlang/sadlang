# دالة تقييم تستخدم متغير درجة
دالة تقييم(درجة)
    إذا (درجة >= 90)
        ارجع "ممتاز"
    وإلا إذا (درجة >= 80)
        ارجع "جيد جداً"
    وإلا إذا (درجة >= 70)
        ارجع "جيد"
    وإلا
        ارجع "مقبول"
    نهاية
نهاية

