# @description VE-033: تصريح بلا تهيئة = إسناد القيمة الافتراضيّة للنوع — في النطاقين
# @expected 0\n0.0\nخطأ\n[]\nلاشيء\n0\n0.0\nخطأ\n[]\nلاشيء
# @priority P1

# ============================================================
# اختبار: التصريح بلا تهيئة اختصارٌ لإسناد القيمة الافتراضيّة
# (قرار مالك 2026-08-14، 20_declarations.yaml)
#
# القيمة الافتراضيّة تتبع قابليّة النوع للعدم:
#   نوع يقبل العدم («رقم عدمي») ⇒ لاشيء
#   نوع لا يقبله ⇒ قيمته الصفريّة: 0 · 0.0 · خطأ · نصّ فارغ
#
# يُقاس النطاقان معاً لأنّ المترجّم كان يتباعد فيهما تباعداً مختلفاً:
# مستوى الوحدة يهبط عامّاً مصفَّراً، وداخل الدالّة alloca غير مكتوب
# فيُقرأ مكدَّس غير مهيّأ بقيمةٍ تختلف في كلّ تشغيل.
#
# النصّ الفارغ يُغلَّف بقوسين معقوفين كي لا يلتبس بسطرٍ خالٍ عند المقارنة.
# ============================================================

# ── مستوى الوحدة ──
رقم عدد
عشري كسر
منطقي راية
نص كلمة
رقم عدمي نتيجة

اطبع_سطر(عدد)
اطبع_سطر(كسر)
اطبع_سطر(راية)
اطبع_سطر("[" + كلمة + "]")
اطبع_سطر(نتيجة)

# ── داخل دالّة: خانة على المكدّس لا في القسم العامّ ──
دالة افحص_داخل_دالة()
    رقم عدد_محلّي
    عشري كسر_محلّي
    منطقي راية_محلّية
    نص كلمة_محلّية
    رقم عدمي نتيجة_محلّية

    اطبع_سطر(عدد_محلّي)
    اطبع_سطر(كسر_محلّي)
    اطبع_سطر(راية_محلّية)
    اطبع_سطر("[" + كلمة_محلّية + "]")
    اطبع_سطر(نتيجة_محلّية)
نهاية

افحص_داخل_دالة()
