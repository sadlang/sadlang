# @rule: gr.decl.variable
# @description العدميّةُ لم تسقط مع حذفِ صيغةِ النقطتين — الصفةُ العربيّةُ تحملها
# @requires: اطبع_سطر
# @priority P0
# @expected 5\nعدم\nلاشيء\n9\nا

# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 نصفُ الحذفِ الآخَر: ما الذي **بقي** بعدَه
# ═══════════════════════════════════════════════════════════════════
#
# @صيغة-مرفوضة
# (AR) بذرةُ VE053 تُثبِّت أنّ «متغير س: رقم» تُرفَض. وهذه تُثبِّت أنّ الرفضَ
#      **لم يأخذ معه القدرة**: كانت لاحقةُ «؟» تعمل في الصيغةِ المحذوفةِ وحدَها،
#      فلو اكتُفِي ببذرةِ الرفضِ لقُرِئ الحذفُ إسقاطًا لأمانِ العدمِ من التصريح.
#
#      🔑 والقاعدةُ: **حذفُ صيغةٍ يلزمه بذرتان لا واحدة** — واحدةٌ تُثبِّت أنّ
#      المحذوفَ لا يمرّ، وأخرى تُثبِّت أنّ ما كان يُعبَّر به لا يزال يُعبَّر عنه.
#      وبلا الثانيةِ لا يفرّق أحدٌ بين «حُذِفت صيغةٌ» و«فُقِدت قدرة».
#
# (AR) والأسطرُ أدناه هي بعينِها ما كانت تقيسه بذورُ عائلةِ أمانِ العدمِ بالصيغةِ
#      المحذوفة (050 · 051 · 052 · 057 · 058)، مكتوبةً بالصفةِ العربيّة — وقد
#      هُوجِرت تلك البذورُ إليها يومَ الحذفِ بعدَ قياسِ التطابق.
# ═══════════════════════════════════════════════════════════════════

رقم عدمي س = 5
اطبع_سطر(نص(س))

نص عدمي ع = لاشيء
اطبع_سطر(نوع(ع))
اطبع_سطر(نص(ع))

رقم عدمي ك = لاشيء
اطبع_سطر(نص(ك ؟؟ 9))

نص عدمي ن = "ا"
اطبع_سطر(نص(ن ؟؟ "بديل"))
