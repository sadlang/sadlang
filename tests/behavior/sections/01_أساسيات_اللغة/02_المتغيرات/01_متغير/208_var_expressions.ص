# @description تعابير معقدة كقيم ابتدائية للمتغيرات: مربعات، حاصل ضرب، فرق
# @expected 25\n49\n-24
# @priority P1

# ============================================================
# اختبار: متغيرات تحمل نتيجة تعابير حسابية معقدة
# يتحقق من صحة ترتيب العمليات وحساب التعابير المركبة
# ============================================================

# متغيران أساسيان
متغير أ = 3
متغير ب = 4

# مجموع مربعي أ و ب: 3² + 4² = 9 + 16 = 25
متغير ج = أ * أ + ب * ب
اطبع_سطر(ج)

# مربع مجموع أ + ب: (3+4)² = 7² = 49
متغير د = (أ + ب) * (أ + ب)
اطبع_سطر(د)

# الفرق: 25 - 49 = -24
متغير هـ = ج - د
اطبع_سطر(هـ)
