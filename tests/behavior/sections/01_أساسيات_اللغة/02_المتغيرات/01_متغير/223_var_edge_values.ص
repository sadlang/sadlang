# @description قيم حدية: صفر، سالب، عدد كبير، عدد سالب كبير، عمليات عليها
# @expected 0\n-100\n1000000\n-1000000\n-100\n0
# @priority P1

# ============================================================
# اختبار: قيم حدية للمتغيرات الرقمية
# يتحقق من صحة تخزين القيم الحدية والعمليات عليها
# ============================================================

# أربع قيم حدية
متغير صفر = 0
متغير سالب = -100
متغير كبير = 1000000
متغير صغير = -1000000

# طباعة القيم
اطبع_سطر(صفر)
اطبع_سطر(سالب)
اطبع_سطر(كبير)
اطبع_سطر(صغير)

# عمليات على القيم الحدية
اطبع_سطر(صفر + سالب)     # 0 + (-100) = -100
اطبع_سطر(كبير + صغير)    # 1000000 + (-1000000) = 0
