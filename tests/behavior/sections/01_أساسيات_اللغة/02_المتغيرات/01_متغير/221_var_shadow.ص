# @description تظليل المتغيرات: إعادة تعريف اسم موجود في نطاق داخلي
# @expected 10\n20\n20\n30\n20
# @priority P1

# ============================================================
# اختبار: تظليل المتغيرات (Variable Shadowing)
# يتحقق من أن تعريف متغير بنفس الاسم في نطاق داخلي
# لا يؤثر على المتغير في النطاق الخارجي
# ============================================================

# متغير في النطاق العام
متغير س = 10
اطبع_سطر(س)    # 10 — القيمة الأصلية

# تظليل داخل كتلة إذا
إذا (صحيح)
    متغير س = 20
    اطبع_سطر(س)    # 20 — المتغير المُظلَّل
نهاية

# بعد الكتلة: عودة للمتغير الأصلي
اطبع_سطر(س)    # 10 — لم يتغير

# تظليل داخل دالة
دالة اختبار_ظل()
    متغير س = 30
    اطبع_سطر(س)    # 30 — متغير الدالة المحلي
نهاية

اختبار_ظل()

# المتغير الأصلي لا يزال سليماً
اطبع_سطر(س)    # 10 — لم يتأثر
