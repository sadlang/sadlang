# @rule: gr.decl.variable
# @description: التصريحُ العاري يُصفِّر الحقولَ ثمّ يُنفِّذ البانِي — النصفان معًا
# @requires: اطبع_سطر
# @priority P0
# @expected 7\n7\n0\n3
#
# ═══════════════════════════════════════════════════════════════════
# (AR) 🔑 حكمُ المالكِ نصفان — وبذرةٌ تقيس أحدَهما تُجيز نصفَ التنفيذ
# ═══════════════════════════════════════════════════════════════════
#
# (AR) الحكمُ: «الصنفُ مؤلَّفٌ من متغيّرات، فالتصريحُ المجرَّدُ يُنشِئه،
#      **وتُصفَّرُ الحقولُ أوّلًا ثمّ يُنفَّذُ البانِي**». ومصدرُ الحقيقةِ
#      ينصّ عليه: «البانِي… تُستدعى مرّةً عندَ إنشاءِ الكائن، **بعدَ تطبيقِ
#      تهيئاتِ الحقولِ**» (oop_constructs.yaml).
#
#      وبذورُ الحملةِ قاست النصفَ الأوّلَ (التصفير) في صنفٍ **بلا بانٍ**.
#      فبقي النصفُ الثاني بلا حارس: لو صُرِّح `شخص ك` فصُفِّرت الحقولُ ولم
#      يُنفَّذِ البانِي، لأعطت كلُّ تلك البذورِ أخضرَ وهي تصف نصفَ الحكم.
#
#      🔑 والصفُّ الذي يُنفَّذ نصفُه هو أخطرُ من الصفِّ الذي لا يُنفَّذ:
#      الثاني ينهار فيُرى، والأوّلُ يُعطي رقمًا معقولًا (`0`) فيُصدَّق.
#
# ═══════════════════════════════════════════════════════════════════
# (AR) ⚠️ وفخُّ المِجَسِّ الذي أوقعني — يُكتَب لئلّا يتكرّر
# ═══════════════════════════════════════════════════════════════════
#
# (AR) قِيس هذا الصفُّ أوّلَ مرّةٍ بـ`دالة شخص()` ظنًّا أنّها بانٍ، فأعطى
#      `0` في المحرّكَين فسُجِّل «متطابقٌ وخاطئ: البانِي لا يُستدعى».
#      والحقيقةُ أنّ `دالة شخص()` طريقةٌ عاديّةٌ اسمُها «شخص» لا بانٍ —
#      لفظُ البانِي `باني`. فالمِجَسُّ كان يقيس شيئًا آخرَ ويُقرَأ حكمًا
#      على اللغة.
#
#      🔑 ومِجَسٌّ يستعمل لفظًا ليس من المعجمِ لا يُخفِق ظاهرًا: يُصرَّف
#      ويعمل ويُعطي رقمًا. فالخطرُ ليس في المِجَسِّ الذي ينهار بل في الذي
#      **يمرّ وهو يقيس غيرَ ما ظُنَّ به**.
#
#      والسطرُ الثالثُ (`0`) يحرس هذا بعينِه: حقلٌ لا يمسُّه البانِي يبقى
#      على قيمةِ نوعِه الافتراضيّة — فيُثبَت أنّ التصفيرَ سبقَ ولم يُلغَ.
#      والرابعُ يُثبِت أنّ الصيغةَ ② والباني يجتمعان لا يتنافيان.
# ═══════════════════════════════════════════════════════════════════

صنف عدّاد
    رقم قيمة
    رقم غيرُ_ممسوس
    باني()
        هذا.قيمة = 7
    نهاية
نهاية

متغير صريح = عدّاد()
اطبع_سطر(نص(صريح.قيمة))

عدّاد ضمني
اطبع_سطر(نص(ضمني.قيمة))
اطبع_سطر(نص(ضمني.غيرُ_ممسوس))

صنف موسوم
    رقم وسم
    باني(رقم بذرة)
        هذا.وسم = بذرة
    نهاية
نهاية

متغير مبذور = موسوم(3)
اطبع_سطر(نص(مبذور.وسم))
