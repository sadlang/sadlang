# @description تحويل الأنواع: نص→رقم، رقم→منطقي، رقم→نص، نص→عشري
# @expected 556\nصحيح\n99!\n3.0
# @priority P1

# ============================================================
# اختبار: دوال تحويل الأنواع على المتغيرات
# يتحقق من صحة التحويل بين الأنواع المختلفة
# ============================================================

# تحويل نص إلى رقم ثم إضافة رقم: "456" → 456 + 100 = 556
متغير ن = "456"
متغير ر = رقم(ن)
اطبع_سطر(ر + 100)

# تحويل رقم إلى منطقي: 1 → صحيح
متغير م = منطقي(1)
اطبع_سطر(م)

# تحويل رقم إلى نص ثم ربط: 99 → "99" + "!" = "99!"
متغير ت = نص(99)
اطبع_سطر(ت + "!")

# تحويل نص إلى عشري ثم ضرب: "1.5" → 1.5 * 2 = 3.0
متغير ع = عشري("1.5")
اطبع_سطر(ع * 2)
