# @description تدفق معقد: متغيرات متراكمة عبر دالة وعمليات متعددة
# @expected 150\n300\n2
# @priority P1

# ============================================================
# اختبار: سيناريو معقد يجمع متغيرات ودوال وعمليات متعددة
# يتحقق من أن المتغيرات تتراكم وتتحول بشكل صحيح في التدفق الكامل
# ============================================================

# دالة تجمع عناصر مصفوفة باستخدام متغير تراكمي
دالة تراكم(قائمة)
    متغير مجموع = 0
    لكل عنصر في قائمة
        مجموع += عنصر
    نهاية
    ارجع مجموع
نهاية

# تطبيق على مصفوفة: 10+20+30+40+50 = 150
متغير بيانات = [10، 20، 30، 40، 50]
متغير إجمالي = تراكم(بيانات)
اطبع_سطر(إجمالي)

# مضاعفة النتيجة: 150 * 2 = 300
متغير مضاعف = إجمالي * 2
اطبع_سطر(مضاعف)

# نسبة: 300 / 150 = 2.0
متغير نسبة = مضاعف / إجمالي
اطبع_سطر(نسبة)
