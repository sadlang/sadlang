# @description مصفوفة كمتغير: إنشاء، قراءة، إضافة، قياس الطول
# @expected 5\n1\n5\n6
# @priority P1

# ============================================================
# اختبار: المصفوفة كمتغير قابل للتعديل
# يتحقق من إنشاء المصفوفة وقراءة العناصر وإضافتها
# ============================================================

# إنشاء مصفوفة وتخزينها في متغير
متغير أرقام = [1، 2، 3، 4، 5]

# طول المصفوفة الأولي
اطبع_سطر(طول(أرقام))

# قراءة أول عنصر (فهرس 0)
اطبع_سطر(أرقام[0])

# قراءة آخر عنصر (فهرس 4)
اطبع_سطر(أرقام[4])

# إضافة عنصر جديد وقياس الطول مجدداً
أرقام.اضف(6)
اطبع_سطر(طول(أرقام))
