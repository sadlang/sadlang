# @expected 3\nلغة_ص
# @priority P2

# ============================================================
# اختبار: الأعضاء الساكنة النصية
# يتحقق من أن العضو الساكن النصي يُحدَّث بشكل صحيح
# ============================================================

# صنف يتتبع الرسائل ساكنياً
صنف رسائل
    متغير ساكن العدد = 0
    متغير ساكن الأخيرة = ""

    دالة ساكن أرسل(رسالة)
        رسائل.العدد += 1
        رسائل.الأخيرة = رسالة
    نهاية

    دالة ساكن احصل_عدد()
        ارجع رسائل.العدد
    نهاية

    دالة ساكن احصل_آخر()
        ارجع رسائل.الأخيرة
    نهاية
نهاية

# إرسال ثلاث رسائل
رسائل.أرسل("مرحبا")
رسائل.أرسل("عالم")
رسائل.أرسل("لغة_ص")

# التحقق: العدد = 3، الأخيرة = "لغة_ص"
اطبع_سطر(رسائل.احصل_عدد())
اطبع_سطر(رسائل.احصل_آخر())
