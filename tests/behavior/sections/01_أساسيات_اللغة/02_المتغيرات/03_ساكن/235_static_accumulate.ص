# @description عداد ساكن متقدم: تراكم بمقادير، ثم صفّر، ثم تراكم من جديد
# @expected 60\n0
# @priority P2

# ============================================================
# اختبار: العضو الساكن مع إعادة التهيئة
# يتحقق من إمكانية تعديل العضو الساكن وإعادة الضبط
# ============================================================

# صنف عداد ساكن بمقادير مختلفة وإمكانية الصفر
صنف عداد
    متغير ساكن القيمة = 0

    دالة ساكن زد(مقدار)
        عداد.القيمة += مقدار
    نهاية

    دالة ساكن احصل()
        ارجع عداد.القيمة
    نهاية

    دالة ساكن صفّر()
        عداد.القيمة = 0
    نهاية
نهاية

# تراكم: 10 + 20 + 30 = 60
عداد.زد(10)
عداد.زد(20)
عداد.زد(30)
اطبع_سطر(عداد.احصل())

# إعادة الضبط
عداد.صفّر()
اطبع_سطر(عداد.احصل())
