# @description عضو ساكن منطقي: تبديل الحالة تفعيل/إلغاء
# @expected خطأ\nصحيح\nخطأ
# @priority P2

# ============================================================
# اختبار: العضو الساكن المنطقي (boolean)
# يتحقق من إمكانية تغيير العضو الساكن المنطقي ذهاباً وإياباً
# ============================================================

# صنف يتحكم في حالة منطقية ساكنة
صنف تحكم_تفعيل
    متغير ساكن مفعّل = خطأ

    دالة ساكن تفعيل()
        تحكم_تفعيل.مفعّل = صحيح
    نهاية

    دالة ساكن إلغاء()
        تحكم_تفعيل.مفعّل = خطأ
    نهاية

    دالة ساكن هل_مفعّل()
        ارجع تحكم_تفعيل.مفعّل
    نهاية
نهاية

# ابتداءً: خطأ
اطبع_سطر(تحكم_تفعيل.هل_مفعّل())

# بعد التفعيل: صحيح
تحكم_تفعيل.تفعيل()
اطبع_سطر(تحكم_تفعيل.هل_مفعّل())

# بعد الإلغاء: خطأ
تحكم_تفعيل.إلغاء()
اطبع_سطر(تحكم_تفعيل.هل_مفعّل())
