# اختبار C06: guard مع و (AND)
# هدف: نمط guard يستخدم عامل و للتحقق من نطاق
# المخرج: 5 رسائل داخل/خارج النطاق

دالة تحقق_نطاق(ن، حد_أدنى، حد_أقصى)
    طابق (ن)
        عندما ق إذا (ق >= حد_أدنى و ق <= حد_أقصى):
            اطبع_سطر(نص(ن) + " داخل النطاق")
        افتراضي:
            اطبع_سطر(نص(ن) + " خارج النطاق")
    نهاية
نهاية

تحقق_نطاق(5، 1، 10)
تحقق_نطاق(15، 1، 10)
تحقق_نطاق(1، 1، 10)
تحقق_نطاق(10، 1، 10)
تحقق_نطاق(0، 1، 10)
