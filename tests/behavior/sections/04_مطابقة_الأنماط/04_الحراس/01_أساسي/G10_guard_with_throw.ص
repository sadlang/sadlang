# @description guard مع ارمي داخل حالة + حاول/امسك خارج الطابق
# @priority P1
# @expected G10:تم_مسك:قيمة_سالبة
# @expected G10:نتيجة_سليمة:100
#
# الهدف: استخدام ارمي داخل guard يُصيّد بحاول/امسك خارج الطابق
# الاختبار يتحقق من أن ارمي داخل طابق مع guard يتصاعد بشكل صحيح

دالة حساب_آمن(ن)
    متغير نتيجة = ""
    حاول
        طابق (ن)
            عندما ق إذا ق < 0:
                ارمي "قيمة_سالبة"
            عندما ق إذا ق > 1000:
                ارمي "قيمة_كبيرة_جداً"
            عندما ق:
                نتيجة = "نتيجة_سليمة:" + ق * ق
        نهاية
    امسك خطأ
        نتيجة = "تم_مسك:" + خطأ
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("G10:" + حساب_آمن(-5))   # ق=-5 < 0 → ارمي → تم_مسك:قيمة_سالبة
اطبع_سطر("G10:" + حساب_آمن(10))   # ق=10 → نتيجة_سليمة:100
