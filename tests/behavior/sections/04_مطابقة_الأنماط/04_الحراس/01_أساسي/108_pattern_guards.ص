# @description اختبار مطابقة الأنماط — حالات متقدمة مع حراسة وربط
# @expected صغير\nمتوسط\nكبير\nصفر\nسالب:موجب\nحرف:أ
# @priority P2

# ============================================================
# 1. مطابقة مع نطاقات
# ============================================================
دالة تصنيف(ن)
    طابق (ن)
        عندما 1..10:
            ارجع "صغير"
        عندما 10..100:
            ارجع "متوسط"
        عندما 100..1000:
            ارجع "كبير"
        افتراضي:
            ارجع "خارج النطاق"
    نهاية
نهاية

اطبع_سطر(تصنيف(5))
اطبع_سطر(تصنيف(50))
اطبع_سطر(تصنيف(500))

# ============================================================
# 2. مطابقة قيمة حرفية
# ============================================================
دالة وصف_رقم(ن)
    طابق (ن)
        عندما 0:
            ارجع "صفر"
        افتراضي:
            ارجع "آخر"
    نهاية
نهاية

اطبع_سطر(وصف_رقم(0))

# ============================================================
# 3. مطابقة نصوص
# ============================================================
دالة نوع_إشارة(إشارة)
    طابق (إشارة)
        عندما "-":
            ارجع "سالب"
        عندما "+":
            ارجع "موجب"
        افتراضي:
            ارجع "مجهول"
    نهاية
نهاية

اطبع_سطر(نوع_إشارة("-") + ":" + نوع_إشارة("+"))

# ============================================================
# 4. مطابقة حرف واحد
# ============================================================
متغير حرف = "أ"
طابق (حرف)
    عندما "أ":
        اطبع_سطر("حرف:أ")
    عندما "ب":
        اطبع_سطر("حرف:ب")
    افتراضي:
        اطبع_سطر("حرف:آخر")
نهاية
