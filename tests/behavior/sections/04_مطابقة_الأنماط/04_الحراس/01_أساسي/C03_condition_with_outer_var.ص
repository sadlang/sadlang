# اختبار C03: شرط يستخدم متغير خارجي في match arm
# هدف: match arm يقرأ متغير من النطاق الخارجي في شرط إذا
# المخرج: 10، 12، 7

متغير معامل = 2

دالة احسب(عملية، قيمة)
    طابق (عملية)
        عندما "ضرب":
            إذا (معامل > 1)
                ارجع قيمة * معامل
            وإلا
                ارجع قيمة
            نهاية
        عندما "جمع":
            إذا (معامل > 0)
                ارجع قيمة + معامل
            وإلا
                ارجع قيمة
            نهاية
        افتراضي:
            ارجع قيمة
    نهاية
نهاية

اطبع_سطر(نص(احسب("ضرب"، 5)))
اطبع_سطر(نص(احسب("جمع"، 10)))
اطبع_سطر(نص(احسب("آخر"، 7)))
