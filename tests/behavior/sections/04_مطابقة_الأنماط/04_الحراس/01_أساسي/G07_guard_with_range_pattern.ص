# @description guard مع RangePattern — فحص النطاق + شرط إضافي
# @priority P1
# @expected G07:في_النطاق_وزوجي:8
# @expected G07:في_النطاق_وفردي:7
# @expected G07:خارج_النطاق
#
# الهدف: RangePattern يُطابق النطاق، ثم guard يصفي أكثر
# عندما 1..20 إذا ن % 2 == 0 → في_النطاق_وزوجي

دالة تحقق(ن)
    متغير نتيجة = ""
    متغير قيمة = -1
    طابق (ن)
        عندما 1..20 إذا ن % 2 == 0:
            نتيجة = "في_النطاق_وزوجي"
            قيمة = ن
        عندما 1..20:
            نتيجة = "في_النطاق_وفردي"
            قيمة = ن
        افتراضي:
            نتيجة = "خارج_النطاق"
    نهاية
    إذا (قيمة == -1)
        ارجع نتيجة
    وإلا
        ارجع نتيجة + ":" + قيمة
    نهاية
نهاية

اطبع_سطر("G07:" + تحقق(8))    # في النطاق وزوجي
اطبع_سطر("G07:" + تحقق(7))    # في النطاق وفردي
اطبع_سطر("G07:" + تحقق(25))   # خارج النطاق
