# @description اختبار شامل لمطابقة الأنماط — حرفي، شامل، نطاق، OR، متداخل
# @expected فئة:طفل\nفئة:مراهق\nفئة:بالغ\nفئة:كبير\nيوم:عطلة\nيوم:عمل\nيوم:عمل\nنوع:موجب\nنوع:صفر\nنوع:سالب\nحجم:صغير\nحجم:وسط\nحجم:كبير\nحجم:ضخم\nمجموع:6\nلون:أحمر\nلون:آخر\nلون:أزرق
# @priority P0

# ============================================================
# 1. مطابقة نطاق — فئات عمرية
# ============================================================
دالة فئة_عمر(عمر)
    طابق (عمر)
        عندما 0..13:
            ارجع "طفل"
        عندما 13..20:
            ارجع "مراهق"
        عندما 20..60:
            ارجع "بالغ"
        افتراضي:
            ارجع "كبير"
    نهاية
نهاية

اطبع_سطر("فئة:" + فئة_عمر(5))
اطبع_سطر("فئة:" + فئة_عمر(15))
اطبع_سطر("فئة:" + فئة_عمر(35))
اطبع_سطر("فئة:" + فئة_عمر(70))

# ============================================================
# 2. مطابقة حرفية — أيام الأسبوع
# ============================================================
دالة نوع_يوم(يوم)
    طابق (يوم)
        عندما "الجمعة":
            ارجع "عطلة"
        عندما "السبت":
            ارجع "عطلة"
        افتراضي:
            ارجع "عمل"
    نهاية
نهاية

اطبع_سطر("يوم:" + نوع_يوم("الجمعة"))
اطبع_سطر("يوم:" + نوع_يوم("الأحد"))
اطبع_سطر("يوم:" + نوع_يوم("الاثنين"))

# ============================================================
# 3. مطابقة مع إرجاع مباشر — نوع الرقم
# ============================================================
دالة نوع_رقم(ن)
    طابق (ن)
        عندما 1..999999:
            ارجع "موجب"
        عندما 0:
            ارجع "صفر"
        افتراضي:
            ارجع "سالب"
    نهاية
نهاية

اطبع_سطر("نوع:" + نوع_رقم(42))
اطبع_سطر("نوع:" + نوع_رقم(0))
اطبع_سطر("نوع:" + نوع_رقم(-5))

# ============================================================
# 4. مطابقة نطاق متعدد — حجم الملف
# ============================================================
دالة حجم_ملف(بايت)
    طابق (بايت)
        عندما 0..1024:
            ارجع "صغير"
        عندما 1024..1048576:
            ارجع "وسط"
        عندما 1048576..1073741824:
            ارجع "كبير"
        افتراضي:
            ارجع "ضخم"
    نهاية
نهاية

اطبع_سطر("حجم:" + حجم_ملف(500))
اطبع_سطر("حجم:" + حجم_ملف(50000))
اطبع_سطر("حجم:" + حجم_ملف(5000000))
اطبع_سطر("حجم:" + حجم_ملف(2000000000))

# ============================================================
# 5. مطابقة داخل حلقة
# ============================================================
متغير مجموع = 0
لكل ن في [1، 2، 3، 4، 5، 6]
    طابق (ن)
        عندما 1..4:
            مجموع = مجموع + ن
        افتراضي:
            # لا شيء
    نهاية
نهاية
اطبع_سطر("مجموع:" + مجموع)

# ============================================================
# 6. مطابقة نصوص متعددة
# ============================================================
دالة لون(اسم)
    طابق (اسم)
        عندما "أحمر":
            ارجع "أحمر"
        عندما "أزرق":
            ارجع "أزرق"
        عندما "أخضر":
            ارجع "أخضر"
        افتراضي:
            ارجع "آخر"
    نهاية
نهاية

اطبع_سطر("لون:" + لون("أحمر"))
اطبع_سطر("لون:" + لون("بنفسجي"))
اطبع_سطر("لون:" + لون("أزرق"))
