# اختبار N04: match على نتيجة تعبير معقد (a + b)
# هدف: التحقق من أن match يعمل على نتيجة عملية حسابية
# المخرج: 4 رسائل تصنيف المجموع

دالة فحص_مجموع(أ، ب)
    طابق (أ + ب)
        عندما 0:
            اطبع_سطر("المجموع صفر")
        عندما 1..10:
            اطبع_سطر("المجموع صغير: " + نص(أ + ب))
        عندما 11..100:
            اطبع_سطر("المجموع متوسط: " + نص(أ + ب))
        افتراضي:
            اطبع_سطر("المجموع كبير: " + نص(أ + ب))
    نهاية
نهاية

فحص_مجموع(0، 0)
فحص_مجموع(3، 4)
فحص_مجموع(30، 40)
فحص_مجموع(100، 50)
