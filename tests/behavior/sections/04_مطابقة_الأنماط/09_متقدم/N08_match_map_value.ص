# اختبار N08: match على قيمة مستردة من مصدر بيانات
# هدف: match يعالج قيمة مُسترجعة من دالة بحث
# المخرج: 3 أوصاف

# دالة بحث تعمل كمصدر بيانات (بديل الخريطة)
دالة احصل_كود(مفتاح)
    إذا (مفتاح == "نجاح")
        ارجع 1
    وإلا إذا (مفتاح == "فشل")
        ارجع 0
    وإلا إذا (مفتاح == "تحذير")
        ارجع 2
    نهاية
    ارجع -1
نهاية

دالة وصف_كود(كود)
    طابق (كود)
        عندما 0:
            ارجع "فشل"
        عندما 1:
            ارجع "نجاح"
        عندما 2:
            ارجع "تحذير"
        افتراضي:
            ارجع "غير معروف"
    نهاية
نهاية

لكل مفتاح في ["نجاح"، "فشل"، "تحذير"]
    متغير كود = احصل_كود(مفتاح)
    اطبع_سطر(مفتاح + " > " + وصف_كود(كود))
نهاية
