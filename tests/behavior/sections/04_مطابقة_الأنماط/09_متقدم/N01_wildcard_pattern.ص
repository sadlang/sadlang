# اختبار N01: wildcard _ في match
# هدف: التحقق من أن النمط الشامل _ يعمل صحيحاً
# المخرج: واحد، اثنان، أخرى × 3

متغير قيم = [1، 2، 3، 4، 5]
لكل قيمة في قيم
    طابق (قيمة)
        عندما 1:
            اطبع_سطر("واحد")
        عندما 2:
            اطبع_سطر("اثنان")
        عندما _:
            اطبع_سطر("أخرى: " + نص(قيمة))
    نهاية
نهاية
