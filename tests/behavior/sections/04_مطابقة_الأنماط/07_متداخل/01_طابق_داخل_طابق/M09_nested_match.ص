# @description طابق متداخل: نطاق خارجي + نطاق داخلي
# @priority P1
# @expected M09:وسط_نطاق
#
# الهدف: التحقق من أن طابق متداخل يعمل بشكل صحيح
# القيمة 7 تقع في 0..10 ثم داخلياً في 5..8

متغير نتيجة = ""

طابق (7)
    عندما 0..10:
        طابق (7)
            عندما 0..5:
                نتيجة = "منخفض_الخارجي"
            عندما 5..8:
                نتيجة = "وسط_نطاق"
            عندما 8..10:
                نتيجة = "عالي_الخارجي"
            افتراضي:
                نتيجة = "داخلي_افتراضي"
        نهاية
    عندما 10..20:
        نتيجة = "نطاق_ثانٍ"
    افتراضي:
        نتيجة = "خارج"
نهاية

اطبع_سطر("M09:" + نتيجة)
