# @description OR pattern مع أرقام صحيحة كثيرة + نطاق شامل معاً
# @priority P1
# @expected OR10:خاص
# @expected OR10:خاص
# @expected OR10:عادي
# @expected OR10:خارج
#
# الهدف: OR pattern بأرقام خاصة + نطاق للعادي
# 1 أو 100 → خاص (literal في OR)
# 2..50 → عادي (نطاق في OR)
# 51+ → خارج

دالة تصنيف(ن)
    متغير نتيجة = ""
    طابق (ن)
        عندما 1 || 100:
            نتيجة = "خاص"
        عندما 2..50:
            نتيجة = "عادي"
        افتراضي:
            نتيجة = "خارج"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("OR10:" + تصنيف(1))
اطبع_سطر("OR10:" + تصنيف(100))
اطبع_سطر("OR10:" + تصنيف(25))
اطبع_سطر("OR10:" + تصنيف(75))
