# @description OR pattern مع نصوص متعددة وعدد كبير من البدائل
# @priority P1
# @expected OR09:يوم_عمل
# @expected OR09:عطلة
# @expected OR09:مجهول
#
# الهدف: OR pattern بعدد كبير من البدائل النصية (5 بدائل في OR)

دالة نوع_يوم(يوم)
    متغير نتيجة = ""
    طابق (يوم)
        عندما "الأحد" || "الاثنين" || "الثلاثاء" || "الأربعاء" || "الخميس":
            نتيجة = "يوم_عمل"
        عندما "الجمعة" || "السبت":
            نتيجة = "عطلة"
        افتراضي:
            نتيجة = "مجهول"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("OR09:" + نوع_يوم("الثلاثاء"))
اطبع_سطر("OR09:" + نوع_يوم("السبت"))
اطبع_سطر("OR09:" + نوع_يوم("اليوم_الثامن"))
