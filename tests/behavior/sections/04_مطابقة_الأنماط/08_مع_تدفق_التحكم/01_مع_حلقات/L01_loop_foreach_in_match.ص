# اختبار L01: لكل داخل match arm
# هدف: حلقة for-each تعمل داخل جسم حالة match
# المخرج المتوقع: عناصر كل فئة ثم "لا شيء"

دالة قائمة_الفئة(فئة)
    طابق (فئة)
        عندما "أ":
            لكل عنصر في ["أحمر"، "برتقالي"]
                اطبع_سطر(عنصر)
            نهاية
        عندما "ب":
            لكل عنصر في ["أزرق"، "أخضر"، "أصفر"]
                اطبع_سطر(عنصر)
            نهاية
        افتراضي:
            اطبع_سطر("لا شيء")
    نهاية
نهاية

قائمة_الفئة("أ")
قائمة_الفئة("ب")
قائمة_الفئة("ج")
