# @description ارمي داخل طابق + التقاطه خارج الطابق
# @priority P1
# @expected M05:صُيِّد:خطأ_داخل_طابق
#
# الهدف: التحقق من أن الاستثناء يتمرر بشكل صحيح خارج الطابق

متغير نتيجة = ""

حاول
    طابق (42)
        عندما 0..100:
            ارمي "خطأ_داخل_طابق"
        افتراضي:
            نتيجة = "لم_يُرمَ"
    نهاية
    نتيجة = "لم_يُصَد"
امسك خ
    نتيجة = "صُيِّد:" + خ
نهاية

اطبع_سطر("M05:" + نتيجة)
