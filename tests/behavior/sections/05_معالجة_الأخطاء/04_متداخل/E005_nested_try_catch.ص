# @description try متداخل — catch الداخلي يُعالج خطأه، الخارجي يُعالج خطأه
# @priority P1
# @expected E005:INNER_CATCH\nE005:OUTER_CATCH\nE005:PASS

# ============================================================
# E005: try/catch متداخل — الخارجي يُعالج خطأ الداخلي المُعاد رميه
# ============================================================

متغير مرحلة5 = ""

حاول
    حاول
        ارمي "خطأ_داخلي"
    امسك خ
        مرحلة5 = مرحلة5 + "INNER_CATCH,"
        اطبع_سطر("E005:INNER_CATCH")
        ارمي "خطأ_خارجي"
    نهاية
امسك خ
    مرحلة5 = مرحلة5 + "OUTER_CATCH"
    اطبع_سطر("E005:OUTER_CATCH")
نهاية

إذا (مرحلة5 == "INNER_CATCH,OUTER_CATCH")
    اطبع_سطر("E005:PASS")
وإلا
    اطبع_سطر("E005:FAIL:" + مرحلة5)
نهاية
