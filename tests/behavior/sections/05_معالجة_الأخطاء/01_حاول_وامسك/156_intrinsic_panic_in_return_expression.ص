# @description هلعٌ جوهريٌّ داخلَ تعبيرِ `ارجع` يُلتقَط: كان `__sad_try_exit` يُبعَث قبلَ بناءِ التعبير، فيقرأ حارسُ الهلعِ عدّادًا مصفَّرًا ويحكمُ بأن لا التقاطَ ممكن — فيموتُ المصرَّفُ بـRUN001 وخروجٍ ١ حيث يلتقطُ المفسّرُ ويعود
# @expected امسك القسمة\n0\nامسك الطرح\n-1\nامسك الوسيط\n0\nخارج=7\n=== انتهى ===
# @priority P0

# (AR) الشاهدُ الضابطُ الذي كان يميّز العطب: نقلُ العمليّةِ إلى متغيّرٍ ثمّ
#      إرجاعُه كان يلتقط، وإبقاؤها في تعبيرِ `ارجع` كان يموت. أي أنّ مكدّسَ
#      المعالِجاتِ سليمٌ والعلّةُ في عدّادِ `__sad_try_active` وحدَه.

دالة رقم اقسم(رقم المقسوم، رقم المقسوم_عليه)
    حاول
        ارجع المقسوم / المقسوم_عليه
    امسك خطأ خطا_القسمة
        اطبع_سطر("امسك القسمة")
        ارجع 0
    نهاية
نهاية

# ═══ الهلعُ في تعبيرٍ مركَّبٍ لا في نداءٍ مباشر ═══
دالة رقم اطرح_ثم_اقسم(رقم القيمة)
    حاول
        ارجع (القيمة / 0) - 1
    امسك خطأ خطا_الطرح
        اطبع_سطر("امسك الطرح")
        ارجع 0 - 1
    نهاية
نهاية

# ═══ والهلعُ وسيطًا داخلَ نداءٍ في تعبيرِ الإرجاع ═══
دالة رقم هوية(رقم القيمة)
    ارجع القيمة
نهاية

دالة رقم مرر_وسيطا(رقم القيمة)
    حاول
        ارجع هوية(القيمة / 0)
    امسك خطأ خطا_الوسيط
        اطبع_سطر("امسك الوسيط")
        ارجع 0
    نهاية
نهاية

اطبع_سطر(نص(اقسم(10، 0)))
اطبع_سطر(نص(اطرح_ثم_اقسم(10)))
اطبع_سطر(نص(مرر_وسيطا(10)))

# ═══ والسليمُ يبقى سليمًا: لا يُنبَذُ معالِجٌ لم يُدخَل ═══
دالة رقم اقسم_سليما(رقم المقسوم، رقم المقسوم_عليه)
    حاول
        ارجع المقسوم / المقسوم_عليه
    امسك خطأ خطا_غير_واقع
        اطبع_سطر("مسكٌ لا يقع")
        ارجع 0 - 99
    نهاية
نهاية

اطبع_سطر("خارج=" + نص(اقسم_سليما(14، 2)))
اطبع_سطر("=== انتهى ===")
