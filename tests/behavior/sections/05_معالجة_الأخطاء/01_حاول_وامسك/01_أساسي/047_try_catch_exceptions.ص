##
## الاختبار 047: try/catch/finally/ارمي — نظام معالجة الاستثناءات
##
## هذا الاختبار يغطي سيناريوهات معالجة الاستثناءات الكاملة في لغة ص:
## - الرمي والإلتقاط الأساسي
## - try بدون استثناء (catch لا يُدخل)
## - try + أخيراً بدون استثناء
## - try + ارمي + أخيراً (finally مضمون)
## - try متداخل
## - الرمي من مكدس استدعاء عميق
## - ارجع من catch مع أخيراً (finally يجب أن يعمل)
## - try في حلقة
## - إعادة الرمي من catch الداخلي للخارجي
## - ارمي نص مع تسلسل
##

# ============================================================
# E01: رمي وإلتقاط أساسي
# ============================================================
دالة e01()
    حاول
        ارمي "خطأ بسيط"
    امسك خ
        اطبع_سطر("E01:PASS:" + خ)
    نهاية
نهاية

# ============================================================
# E02: try بدون استثناء — catch لا يُدخل
# ============================================================
دالة e02()
    متغير رصيد = 0
    حاول
        رصيد = 42
    امسك خ
        رصيد = -1
    نهاية
    اطبع_سطر("E02:PASS:" + رصيد)
نهاية

# ============================================================
# E03: try + أخيراً (بدون استثناء) — finally يُنفَّذ دائماً
# ============================================================
دالة e03()
    حاول
        اطبع_سطر("E03:TRY")
    أخيراً
        اطبع_سطر("E03:FINALLY")
    نهاية
    اطبع_سطر("E03:PASS")
نهاية

# ============================================================
# E04: try + ارمي + أخيراً — finally مضمون حتى مع استثناء
# ============================================================
دالة e04()
    حاول
        ارمي "خطأ في try"
    امسك خ
        اطبع_سطر("E04:CATCH:" + خ)
    أخيراً
        اطبع_سطر("E04:FINALLY")
    نهاية
    اطبع_سطر("E04:PASS")
نهاية

# ============================================================
# E05: try متداخل — الداخلي يلتقط أولاً
# ============================================================
دالة e05()
    حاول
        حاول
            ارمي "داخلي"
        امسك خ_د
            اطبع_سطر("E05:INNER:" + خ_د)
        نهاية
        اطبع_سطر("E05:AFTER_INNER")
    امسك خ_خ
        اطبع_سطر("E05:OUTER:" + خ_خ)
    نهاية
    اطبع_سطر("E05:PASS")
نهاية

# ============================================================
# E06: ارمي من مكدس استدعاء عميق
# ============================================================
دالة e06_عميق3()
    ارمي "من_العمق"
نهاية

دالة e06_عميق2()
    e06_عميق3()
نهاية

دالة e06_عميق1()
    e06_عميق2()
نهاية

دالة e06()
    حاول
        e06_عميق1()
    امسك خ
        اطبع_سطر("E06:PASS:" + خ)
    نهاية
نهاية

# ============================================================
# E07: ارجع من catch مع أخيراً — finally يُنفَّذ قبل الإرجاع
# ============================================================
دالة e07_دالة_مع_أخيراً()
    حاول
        ارمي "خطأ"
    امسك خ
        اطبع_سطر("E07:CATCH:" + خ)
        ارجع "من_catch"
    أخيراً
        اطبع_سطر("E07:FINALLY")
    نهاية
    ارجع "بعد_try"
نهاية

دالة e07()
    متغير ن = e07_دالة_مع_أخيراً()
    اطبع_سطر("E07:PASS:" + ن)
نهاية

# ============================================================
# E08: try في حلقة — يجب أن يستمر بعد كل استثناء
# ============================================================
دالة e08()
    متغير مجموع = 0
    لكل ق في [1، 2، 3]
        حاول
            إذا (ق == 2)
                ارمي "تخطي"
            نهاية
            مجموع = مجموع + ق
        امسك خ
            مجموع = مجموع + 100
        نهاية
    نهاية
    اطبع_سطر("E08:PASS:" + مجموع)
نهاية

# ============================================================
# E09: إعادة الرمي — catch الداخلي يعيد الرمي للخارجي
# ============================================================
دالة e09()
    حاول
        حاول
            ارمي "أصلي"
        امسك خ_د
            اطبع_سطر("E09:INNER:" + خ_د)
            ارمي خ_د
        نهاية
    امسك خ_خ
        اطبع_سطر("E09:PASS:OUTER:" + خ_خ)
    نهاية
نهاية

# ============================================================
# E10: ارمي نص مع تسلسل
# ============================================================
دالة e10()
    متغير رمز = 404
    حاول
        ارمي "خطأ " + رمز + ": غير موجود"
    امسك خ
        اطبع_سطر("E10:PASS:" + خ)
    نهاية
نهاية

# ============================================================
# E11: ارجع من try body مع أخيراً — finally يجب أن يعمل
# ============================================================
دالة e11_دالة_ارجع_من_try()
    حاول
        ارجع "من_try"
    امسك خ
        ارجع "من_catch"
    أخيراً
        اطبع_سطر("E11:FINALLY")
    نهاية
نهاية

دالة e11()
    متغير ن = e11_دالة_ارجع_من_try()
    اطبع_سطر("E11:PASS:" + ن)
نهاية

