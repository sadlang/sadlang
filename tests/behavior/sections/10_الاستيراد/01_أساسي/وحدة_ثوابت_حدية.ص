# وحدة مساعدة لاختبارات التقاط ثوابت الوحدة في طرق الأصناف (ع-1)
ثابت سابقة_عليا = "س:"
متغير عداد_الوحدة = 40

صدّر دالة اقرأ_حر()
    ارجع سابقة_عليا + نص(عداد_الوحدة)
نهاية

صدّر صنف قارئ_حدي
    دالة عام اقرأ_ثابتا()
        ارجع سابقة_عليا + "ثابت"
    نهاية
    دالة عام اقرأ_متغيرا()
        ارجع عداد_الوحدة + 2
    نهاية
    دالة عام اقرأ_بمعامل(نص سابقة_عليا)
        ارجع سابقة_عليا + "معامل"
    نهاية
نهاية

صدّر صنف حامل_حدي
    متغير عام قيمة_البدء

    باني()
        هذا.قيمة_البدء = عداد_الوحدة
    نهاية

    دالة عام اجلب_البدء()
        ارجع هذا.قيمة_البدء
    نهاية
نهاية

صدّر صنف مشتق_حدي يرث قارئ_حدي
    دالة عام اقرأ_مشتقا()
        ارجع سابقة_عليا + "مشتق"
    نهاية
نهاية
