ثابت بادئة = ">> "
ثابت لاحقة = " <<"
ثابت معامل_المضاعفة = 3

# (AR) مساعِدٌ خاصّ — بلا «صدّر». المُصدَّرُ أدناه يعتمد عليه.
دالة زخرف_داخلي(النص)
    ارجع بادئة + النص + لاحقة
نهاية

دالة ضاعف_داخلي(العدد)
    ارجع العدد * معامل_المضاعفة
نهاية

صدّر دالة زخرف(النص)
    ارجع زخرف_داخلي(النص)
نهاية

صدّر دالة ضاعف(العدد)
    ارجع ضاعف_داخلي(العدد)
نهاية

