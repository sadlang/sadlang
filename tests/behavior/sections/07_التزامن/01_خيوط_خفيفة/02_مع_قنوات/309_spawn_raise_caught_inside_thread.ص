# @description ع-16: ارمي/امسك داخل الخيط المطلق معزولان عن الخيط الرئيسي
# @expected خيط:عطب_داخلي\nرئيسي:عطب_خارجي\nتم
# @priority P1
متغير قناة_النتائج = قناة(2)
دالة عامل_يرمي()
    حاول
        ارمي "عطب_داخلي"
    امسك العطب_الداخلي
        قناة_النتائج.أرسل("خيط:" + العطب_الداخلي)
    نهاية
نهاية
أطلق عامل_يرمي()
اطبع_سطر(قناة_النتائج.استقبل())
انتظر_الكل()
حاول
    ارمي "عطب_خارجي"
امسك العطب_الخارجي
    اطبع_سطر("رئيسي:" + العطب_الخارجي)
نهاية
اطبع_سطر("تم")
