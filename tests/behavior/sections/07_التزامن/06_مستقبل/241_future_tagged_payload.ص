# @description بذرة — حمولة المستقبل موسومة: «احصل» كان يُصرَّح «رقم» دائمًا، فالنصّ يُطبَع مؤشّرًا خامًا، وقصر النوع الصارم يطوي «رقم == نصّ» إلى «خطأ» ثابتًا بلا تعليمة. والوسم يحفظ النوع للطباعة والمقارنة معًا
# @expected قيمة\nنص\nصحيح\n42\nرقم\nصحيح
# @priority P1

# ١) حمولة نصّيّة — تُطبَع نصًّا وتُقارَن نصًّا
متغير م = مستقبل()
م.عيّن("قيمة")
اطبع_سطر(م.احصل())
اطبع_سطر(نوع(م.احصل()))
اطبع_سطر(م.احصل() == "قيمة")

# ٢) حمولة عدديّة — لا انحدار في المسار الذي كان يعمل
متغير م2 = مستقبل()
م2.عيّن(42)
اطبع_سطر(م2.احصل())
اطبع_سطر(نوع(م2.احصل()))
اطبع_سطر(م2.احصل() == 42)
