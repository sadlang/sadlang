# @description اختبار انحدار: قناة نصية عبر حدود الدوال ثم تجميع وفرز وطباعة
# @expected مرحبا_أحمد\nمرحبا_سارة
# @priority P1

# ============================================================
# 1) الإرسال يتم داخل دالة مستقلة والقناة تُمرر كوسيط
#    هذا يختبر نشر channelTypeMap_ عبر حدود الدوال.
# ============================================================
دالة أرسل_تحية(ق، اسم)
    ق.أرسل("مرحبا_" + اسم)
نهاية

متغير ق_تحيات = قناة(3)

أطلق أرسل_تحية(ق_تحيات، "أحمد")
أطلق أرسل_تحية(ق_تحيات، "سارة")

انتظر_الكل()

# ============================================================
# 2) الاستقبال ثم الإدخال في مصفوفة ثم الفرز
#    هذا هو المسار الذي كان يفقد النوع النصي سابقاً.
# ============================================================
متغير نتائج = []
بينما (ق_تحيات.فارغة() == خطأ)
    نتائج.اضف(ق_تحيات.استقبل())
نهاية

نتائج.رتب()

# ============================================================
# 3) المرور على النتائج بعد الفرز يجب أن يبقى نصياً
# ============================================================
لكل ن في نتائج
    اطبع_سطر(ن)
نهاية