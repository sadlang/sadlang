# @rule: gr.stmt.if
# @description: «وإلا» الداخليّةُ تنتمي للـ«إذا» الداخليّةِ لا الخارجيّة
# @priority: P1
# @requires: اطبع_سطر
# @expected: داخلية_وإلا

إذا (1 > 5)
    اطبع_سطر("خارجية_ثمّ")
وإلا
    إذا (2 > 9)
        اطبع_سطر("داخلية_ثمّ")
    وإلا
        اطبع_سطر("داخلية_وإلا")
    نهاية
نهاية
