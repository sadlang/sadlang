# @rule: gr.stmt.if
# @description: سلسلةُ خمسةِ شروطٍ و«وإلا» يطابقُ أوّلُها
# @priority: P1
# @requires: اطبع_سطر
# @expected: 1

متغير س=1
إذا (س==1)
    اطبع_سطر("1")
وإلا إذا (س==2)
    اطبع_سطر("2")
وإلا إذا (س==3)
    اطبع_سطر("3")
وإلا إذا (س==4)
    اطبع_سطر("4")
وإلا إذا (س==5)
    اطبع_سطر("5")
وإلا
    اطبع_سطر("غير")
نهاية
