# @rule: gr.stmt.if
# @description: سلسلةُ ستّةِ شروطٍ يطابقُ آخرُها
# @priority: P1
# @requires: اطبع_سطر
# @expected: 6

متغير س=6
إذا (س==1)
    اطبع_سطر("1")
وإلا إذا (س==2)
    اطبع_سطر("2")
وإلا إذا (س==3)
    اطبع_سطر("3")
وإلا إذا (س==4)
    اطبع_سطر("4")
وإلا إذا (س==5)
    اطبع_سطر("5")
وإلا إذا (س==6)
    اطبع_سطر("6")
نهاية
