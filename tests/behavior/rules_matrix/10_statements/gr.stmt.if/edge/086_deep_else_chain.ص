# @rule: gr.stmt.if
# @description: تعشيش وإلا خمس طبقات
# @priority: P1
# @requires: اطبع_سطر
# @expected: قاع

إذا (خطأ)
    اطبع_سطر("1")
وإلا
    إذا (خطأ)
        اطبع_سطر("2")
    وإلا
        إذا (خطأ)
            اطبع_سطر("3")
        وإلا
            إذا (خطأ)
                اطبع_سطر("4")
            وإلا
                اطبع_سطر("قاع")
            نهاية
        نهاية
    نهاية
نهاية
