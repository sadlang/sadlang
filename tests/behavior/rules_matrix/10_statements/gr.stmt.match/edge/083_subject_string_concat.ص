# @rule: gr.stmt.match
# @description: المُطابَقُ نتيجةُ وصلِ نصَّين
# @priority: P2
# @requires: اطبع_سطر
# @expected: مطابق

دالة رئيسية()
    متغير أ = "م"
    متغير ب = "ن"
    طابق أ + ب
        عندما "من":
            اطبع_سطر("مطابق")
        افتراضي:
            اطبع_سطر("غيره")
    نهاية
نهاية
