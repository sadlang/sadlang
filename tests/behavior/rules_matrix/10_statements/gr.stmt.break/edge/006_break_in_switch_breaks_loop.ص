# @rule: gr.stmt.break
# @description: توقف داخل «حالة» تكسر الحلقة لا الحالة
# @priority: P1
# @requires: اطبع_سطر
# @expected: 1
# @expected: بعد

# (AR) «حالة» ليست حلقة، و«توقف» تكسر **أقربَ حلقةٍ محيطة** لا أقربَ كتلة —
#      فلا حاجة إلى «توقف» في نهاية كلّ «عندما» كما في سي.

لكل ن في [1، 2، 3]
    حالة ن
        عندما 2:
            توقف
        افتراضي
            اطبع_سطر(ن)
    نهاية
نهاية
اطبع_سطر("بعد")
