# @rule: gr.stmt.break
# @description: توقف من داخل «حاول» تُنفّذ «أخيراً» قبل الخروج (المفسّر صحيح؛ المصرّف يتخطّاها — ISSUE-104)
# @priority: P1
# @skip_compiler
# @requires: اطبع_سطر
# @expected: 1
# @expected: ختام
# @expected: ختام
# @expected: بعد

# (AR) «أخيراً» عقدٌ لا مفرَّ منه: أيّ خروجٍ من الكتلة — طبيعيًّا أو بـ«ارجع» أو
#      بـ«توقف» — يمرّ بها. المفسّر يفي بالعقد فيطبع «ختام» في التكرارِ الكاسرِ أيضًا،
#      والمصرّف يقفز إلى مخرجِ الحلقة مباشرةً فيُسقِطها ⇒ ISSUE-104.

لكل ن في [1، 2، 3]
    حاول
        إذا (ن == 2) توقف نهاية
        اطبع_سطر(ن)
    أخيراً
        اطبع_سطر("ختام")
    نهاية
نهاية
اطبع_سطر("بعد")
