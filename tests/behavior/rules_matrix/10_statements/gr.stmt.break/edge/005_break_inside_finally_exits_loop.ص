# @rule: gr.stmt.break
# @description: توقف مكتوبة داخل «أخيراً» تكسر الحلقة المحيطة
# @priority: P1
# @requires: اطبع_سطر
# @expected: 1
# @expected: 2
# @expected: بعد

# (AR) تدفّقُ «أخيراً» له الأولويّة على ما قبله: «توقف» في جسمها تكسر أقربَ حلقةٍ
#      محيطة كأيّ موضعٍ آخر. كان المفسّر يبتلعها بلا أثرٍ ولا تشخيص.

لكل ن في [1، 2، 3]
    حاول
        اطبع_سطر(ن)
    أخيراً
        إذا (ن == 2) توقف نهاية
    نهاية
نهاية
اطبع_سطر("بعد")
