# @rule: gr.stmt.for
# @description: التصريحُ في جسمِ «لكل … في» باسمٍ يوافقُ موقعَ العنصرِ الداخليَّ. حارسٌ ضدَّ ISSUE-110: صيغةُ «في» كانت مصابةً بالتصادمِ نفسِه **قبلَ** دفعةِ الإصلاح — المترجِمُ يطبعُ `100 100 100` والمفسّرُ `1 2 3`، تباعُدٌ صامتٌ لم يُرصَدْ قطّ. تُجرَّبُ لواحقُ متعدّدةٌ كي لا يكونَ الحارسُ رهينةَ ترقيمِ الأوسمة.
# @priority: P0
# @requires: اطبع_سطر
# @expected: 1\n2\n3\nتم

دالة رئيسية()
    لكل ي في [1، 2، 3]
        متغير ي_0 = 100
        متغير ي_1 = 100
        متغير ي_3 = 100
        متغير ي_5 = 100
        متغير ي_7 = 100
        متغير ي_9 = 100
        اطبع_سطر(ي)
    نهاية
    اطبع_سطر("تم")
نهاية
