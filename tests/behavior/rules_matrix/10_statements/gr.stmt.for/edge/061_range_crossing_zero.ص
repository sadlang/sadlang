# @rule: gr.stmt.for
# @description: مدى يعبر الصفر ‎‑2..2 — خمسُ دوراتٍ ومجموعُها صفر
# @priority: P2
# @requires: اطبع_سطر
# @expected: 0\n5

دالة رئيسية()
    متغير مجموع = 0
    متغير عدد = 0
    لكل ي من -2 الى 2
        مجموع = مجموع + ي
        عدد = عدد + 1
    نهاية
    اطبع_سطر(مجموع)
    اطبع_سطر(عدد)
نهاية
