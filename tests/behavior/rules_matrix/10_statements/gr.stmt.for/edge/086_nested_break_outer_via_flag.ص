# @rule: gr.stmt.for
# @description: الخروجُ من المتداخلتَين معًا برايةٍ لا بـ«توقف» واحدة
# @priority: P2
# @requires: اطبع_سطر
# @expected: 1\n1

دالة رئيسية()
    متغير راية = خطأ
    متغير أ_عدد = 0
    متغير ب_عدد = 0
    لكل أ من 1 الى 5
        إذا (راية)
            توقف
        نهاية
        أ_عدد = أ_عدد + 1
        لكل ب من 1 الى 5
            ب_عدد = ب_عدد + 1
            راية = صحيح
            توقف
        نهاية
    نهاية
    اطبع_سطر(أ_عدد)
    اطبع_سطر(ب_عدد)
نهاية
