# @rule: gr.stmt.for
# @description: حلقةٌ داخل دالّةٍ و«ارجع» من داخلِها يُنهي الدالّةَ لا الحلقةَ فقط
# @priority: P2
# @requires: اطبع_سطر
# @expected: 3

دالة أوّل_أكبر_من(حدّ)
    لكل ي من 1 الى 100
        إذا (ي > حدّ)
            ارجع ي
        نهاية
    نهاية
    ارجع -1
نهاية

دالة رئيسية()
    اطبع_سطر(أوّل_أكبر_من(2))
نهاية
