# @rule: gr.stmt.continue
# @description: استمر مكتوبة داخل «أخيراً» تتخطّى بقيّة جسم التكرار
# @priority: P1
# @requires: اطبع_سطر
# @expected: 1
# @expected: ذيل
# @expected: 2
# @expected: 3
# @expected: ذيل

لكل ن في [1، 2، 3]
    حاول
        اطبع_سطر(ن)
    أخيراً
        إذا (ن == 2) استمر نهاية
    نهاية
    اطبع_سطر("ذيل")
نهاية
