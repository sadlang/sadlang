# @rule: gr.stmt.while
# @description: حلقة داخل دالّة بإرجاع
# @priority: P1
# @requires: اطبع_سطر
# @expected: 2

دالة موقع(م، هدف)
    متغير ع=0
    بينما (ع < طول(م))
        إذا (م[ع] == هدف)
            ارجع ع
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية
اطبع_سطر(موقع([5، 6، 7]، 7))
