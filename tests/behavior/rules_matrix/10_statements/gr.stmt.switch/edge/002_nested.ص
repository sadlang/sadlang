# @rule: gr.stmt.switch
# @description: جملة حالة — تعشيش حالة داخل حالة
# @priority: P2
# @requires: اطبع_سطر
# @expected: واحد-اثنان

متغير أ = 1
متغير ب = 2
حالة أ
    عندما 1:
        حالة ب
            عندما 2: اطبع_سطر("واحد-اثنان")
            افتراضي: اطبع_سطر("واحد-غيره")
        نهاية
    افتراضي: اطبع_سطر("غيره")
نهاية
