# @rule: gr.stmt.return, gr.stmt.switch
# @description: «ارجع» الفارغة آخرَ ذراعٍ تتوقّف عند «عندما»/«افتراضي» — وكلتاهما محجوزة (KW-RES-020/021) فالرمز وحده فاصل
# @priority: P1
# @requires: اطبع_سطر
# @expected: واحد\nاثنان\nغيره

دالة افحص(ن)
    طابق ن
        عندما 1:
            اطبع_سطر("واحد")
            ارجع
        عندما 2:
            اطبع_سطر("اثنان")
            ارجع
        افتراضي:
            اطبع_سطر("غيره")
    نهاية
نهاية

دالة رئيسية()
    افحص(1)
    افحص(2)
    افحص(9)
نهاية
