# @rule: gr.stmt.return, gr.stmt.match
# @description: «ارجع» الفارغةُ آخرَ ذراعِ «عندما» لا تبتلعُ الذراعَ التالية (م-٦)
# @priority: P1
# @requires: اطبع_سطر
# @expected: --\nاثنان\nبعد

دالة افحص_قيمة(ن)
    طابق ن
        عندما 1:
            ارجع
        عندما 2:
            اطبع_سطر("اثنان")
    نهاية
    اطبع_سطر("بعد")
نهاية
افحص_قيمة(1)
اطبع_سطر("--")
افحص_قيمة(2)
