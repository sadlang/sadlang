# @rule: gr.expr.array_literal
# @description: دمجُ مصفوفةٍ مختلطة (Any) بمصفوفةٍ محدَّدة النوع يبقى واصفًا لنفسه ⇒ النصّ يُقرأ نصًّا لا مؤشّرًا
# @priority: P1
# @requires: اطبع_سطر
# @expected: [500, نصّ, 3.5]\nنصّ\nنص
متغير أ = [500، "نصّ"]
متغير ب = [3.5]
متغير ج = أ + ب
اطبع_سطر(ج)
اطبع_سطر(ج[1])
اطبع_سطر(نوع(ج[1]))
