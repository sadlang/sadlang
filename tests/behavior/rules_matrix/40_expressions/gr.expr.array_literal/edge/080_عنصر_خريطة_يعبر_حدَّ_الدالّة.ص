# @rule: gr.expr.array_literal
# @description: عنصرُ المصفوفةِ خريطةٌ — نوعُه يعبر إلى داخلِ الدالّة فتصحّ `م[ف]["ك"]`
# @priority: P0
# @requires: اطبع_سطر
# @expected: نافذة2
# @expected: 30
# (AR) بذرةٌ تُخفِق قبل الرقعة: أجسامُ الدوالِّ تُبنى قبلَ جملِ المستوى الأعلى،
#      فكان مسحُ الوحدةِ يستنتج نوعَ العنصرِ من LiteralExpr وحدَه ⇒ الخريطةُ Void
#      ⇒ `نوافذ[ف]` «رقمٌ» داخلَ الدالّة ⇒ SEM011 «النوع 'رقم' لا يدعم الفهرسة».
متغير نوافذ = [{"عنوان": "نافذة1"، "عرض": 20}، {"عنوان": "نافذة2"، "عرض": 30}]

دالة عنوان_عند(فهرس)
    ارجع نوافذ[فهرس]["عنوان"]
نهاية

دالة عرض_عند(فهرس)
    ارجع نوافذ[فهرس]["عرض"]
نهاية

اطبع_سطر(عنوان_عند(1))
اطبع_سطر(عرض_عند(1))
