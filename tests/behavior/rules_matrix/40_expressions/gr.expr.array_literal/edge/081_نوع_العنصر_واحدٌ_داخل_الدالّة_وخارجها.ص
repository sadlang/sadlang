# @rule: gr.expr.array_literal
# @description: نوعُ عنصرِ مصفوفةٍ عامّةٍ واحدٌ داخلَ الدالّةِ وخارجها — لا يتبدّل بموضعِ السؤال
# @priority: P0
# @requires: اطبع_سطر، نوع
# @expected: داخل: مصفوفة خريطة نص
# @expected: خارج: مصفوفة خريطة نص
# (AR) حارسُ الاقتران: كان `نوع(متداخلة[ف])` يقول «مصفوفة» خارجَ الدالّةِ و«رقم»
#      داخلَها — جوابان لسؤالٍ واحدٍ يفترقان بموضعِ السؤال، بلا رمزِ خطأ. والسطران
#      يجب أن يتطابقا في لاحقتِهما، فأيُّ انجرافٍ في أحدِهما يُحمِّر الاختبار.
متغير متداخلة = [[1، 2]، [3، 4]]
متغير خرائط = [{"ك": 1}، {"ك": 2}]
متغير نصوص = ["ألف"، "باء"]

دالة داخل()
    اطبع_سطر("داخل: " + نوع(متداخلة[1]) + " " + نوع(خرائط[1]) + " " + نوع(نصوص[1]))
نهاية

داخل()
اطبع_سطر("خارج: " + نوع(متداخلة[1]) + " " + نوع(خرائط[1]) + " " + نوع(نصوص[1]))
