# @rule: gr.expr.postfix
# @description: حقلٌ مشترك «س» عبر ثلاث حالات بفهارس مختلفة (أ فهرس0، ب فهرس1، ج فهرس2) — الوصول المباشر «ك.س» على قيمة ج يوزّع حسب الوسم فيقرأ الفهرس 2 الصحيح (99) لا الأوّل (ISSUE-080، توزيع متعدّد الحالات)
# @priority: P1
# @requires: اطبع_سطر، نص
# @expected: 99
تعداد ن
    أ(س)
    ب(ص، س)
    ج(ع، ف، س)
نهاية
متغير ك = ن.ج(1، 2، 99)
اطبع_سطر(نص(ك.س))
