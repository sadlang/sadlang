# @rule: gr.expr.postfix
# @description: الحقل المتصادم نق يُقرأ صحيحًا على كلتا الحالتين — دائرة (نق في فهرس0 = 5) ومربع (نق في فهرس1 = 7) — عبر توزيعٍ زمن-تشغيليّ حسب وسم كلّ قيمة؛ مجموعهما 12 يثبت أنّ كلّ وصولٍ يختار خانته الصحيحة لا فهرسًا ثابتًا (ISSUE-080)
# @priority: P1
# @requires: اطبع_سطر، نص
# @expected: 12
تعداد ش
    دائرة(نق)
    مربع(عرض، نق)
نهاية
متغير أ = ش.دائرة(5)
متغير ب = ش.مربع(3، 7)
اطبع_سطر(نص(أ.نق + ب.نق))
