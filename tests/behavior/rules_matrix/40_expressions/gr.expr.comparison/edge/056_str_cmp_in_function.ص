# @rule: gr.expr.comparison
# @description: ترتيبُ نصّين **معامِلَين داخلَ دالّة** — الحالةُ التي يستثنيها مسندُ الضمّ
#               عمدًا؛ لولا مسندٍ مستقلٍّ لبقيت «هو_رقم(الحرف)» مكسورةً بعد الإصلاح
# @priority: P1
# @requires: اطبع_سطر
# @expected: صحيح
دالة منطقي هو_رقم(نص الحرف)
    ارجع الحرف >= "0" و الحرف <= "9"
نهاية

اطبع_سطر(هو_رقم("7"))
