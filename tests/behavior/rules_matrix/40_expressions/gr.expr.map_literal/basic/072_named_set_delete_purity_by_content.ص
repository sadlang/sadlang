# @rule: gr.expr.map_literal
# @description: [م-٠٠١] نقاء خريطة_عين وخريطة_احذف بالمحتوى لا بالحجم وحده
# @priority: P1
# @requires: اطبع_سطر, اطبع, خرائط
# @expected: خطأصحيحصحيحخطأ
استورد خرائط

متغير خ = خريطة()
خ["أ"] = 7
خ["ب"] = 9
متغير بعد_التعيين = خريطة_عين(خ، "ت"، 5)
اطبع(خريطة_تحتوي(خ، "ت"))
اطبع(خريطة_تحتوي(بعد_التعيين، "ت"))
متغير بعد_الحذف = خريطة_احذف(خ، "أ")
اطبع(خريطة_تحتوي(خ، "أ"))
اطبع_سطر(خريطة_تحتوي(بعد_الحذف، "أ"))
