# @rule: gr.expr.map_literal
# @description: [م-٠٠١ ق٣] نوع() لقيمة خريطة عبر حدّ النداء — ومفتاح غائب «فراغ» لا «عدم»
# @priority: P0
# @requires: اطبع_سطر, اطبع, نوع, خرائط
# @expected: رقمنصعشريمنطقيفراغ
استورد خرائط

دالة نص نوع_قيمة(خريطة الخريطة، نص مفتاح)
    ارجع نوع(الخريطة[مفتاح])
نهاية

متغير خ = خريطة()
خ["عدد"] = 7
خ["نص"] = "سلام"
خ["عشري"] = 2.5
خ["منطقي"] = صحيح
اطبع(نوع_قيمة(خ، "عدد"))
اطبع(نوع_قيمة(خ، "نص"))
اطبع(نوع_قيمة(خ، "عشري"))
اطبع(نوع_قيمة(خ، "منطقي"))
اطبع_سطر(نوع_قيمة(خ، "غائب"))
