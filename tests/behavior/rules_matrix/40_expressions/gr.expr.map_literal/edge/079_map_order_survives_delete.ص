# @rule: gr.expr.map_literal
# @description: [م-٠٠١] ترتيبُ الإدخالِ ينجو من الحذف: الخانةُ المحذوفةُ تُطبَق ولا تبتلعُ الإدراجَ التالي
# @priority: P0
# @requires: اطبع_سطر, خرائط
# @expected: [ب, ج, د]
استورد خرائط

# (AR) 🔑 الحذفُ كان يُصفّرُ خانةً فيترُكُ ثقبًا، والإدراجُ يبحثُ عن **أوّلِ خانةٍ
#      فارغة** — فـ«د» كان يسقطُ في ثقبِ «أ» متقدّمًا على «ب» و«ج» اللتَين
#      أُدخِلَتا قبلَه: `[د, ب, ج]`. والمفسّرُ كان يقولُ `[ب, ج, د]`.
#      تباعُدٌ بنيويٌّ لا فرقُ منصّة — قِيس على ويندوز حيثُ تجتازُ المصفوفةُ كلُّها.
متغير خ = خريطة()
خ["أ"] = 1
خ["ب"] = 2
خ["ج"] = 3
متغير بعد_الحذف = خريطة_احذف(خ، "أ")
بعد_الحذف["د"] = 4
اطبع_سطر(بعد_الحذف.مفاتيح())
