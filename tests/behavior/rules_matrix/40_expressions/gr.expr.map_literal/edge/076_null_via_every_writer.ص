# @rule: gr.expr.map_literal
# @description: [م-٠٠١] «لاشيء» تحفظ وسمها عبر كل كاتب — .عين() وخريطة_عين كالأقواس
# @priority: P0
# @requires: اطبع_سطر, اطبع, نوع, خرائط
# @expected: لاشيءعدمعدم
استورد خرائط

متغير خ = خريطة()
خ.عين("ك"، لاشيء)
اطبع(خ["ك"])
اطبع(نوع(خ["ك"]))
متغير الناتج = خريطة_عين(خ، "م"، لاشيء)
اطبع_سطر(نوع(الناتج["م"]))
