# @rule: gr.expr.term
# @description: نتيجة العمليّة الأحاديّة (~ -) على طبيعي64 تُطبع موقَّعة (المفسّر لا يعالج UnaryExpr ⇒ Integer)، لكن إسنادها لمتغيّر طبيعي64 يطبعها لا-موقَّعة — تكافؤ المسارين
# @priority: P1
# @requires: اطبع_سطر
# @expected: -1\n-5\n18446744073709551615
متغير طبيعي64 ك = 0
اطبع_سطر(~ك)
متغير طبيعي64 م = 5
اطبع_سطر(-م)
متغير طبيعي64 ج = ~ك
اطبع_سطر(ج)
