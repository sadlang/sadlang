# @rule: gr.expr.term
# @description: هويّة جبريّة بمعامل متغيّر (x+0/0+x/x-0/x*1/x|0/x<<0) — كانت تُطوى خطأً إلى 0 في المترجم (تكافؤ)
# @priority: P1
# @requires: اطبع_سطر
# @expected: 5\n5\n5\n5\n5\n5
متغير رقم أ = 5
اطبع_سطر(أ + 0)
اطبع_سطر(0 + أ)
اطبع_سطر(أ - 0)
اطبع_سطر(أ * 1)
اطبع_سطر(أ | 0)
اطبع_سطر(أ << 0)
