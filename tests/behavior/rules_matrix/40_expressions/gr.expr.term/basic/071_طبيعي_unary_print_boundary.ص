# @rule: gr.expr.term
# @description: نتيجة العمليّة الأحاديّة (~ -) على طبيعي تُطبع موقَّعة (المفسّر لا يعالج UnaryExpr ⇒ Integer)، لكن إسنادها لمتغيّر طبيعي يطبعها لا-موقَّعة — تكافؤ المسارين
# @priority: P1
# @requires: اطبع_سطر
# @expected: -1\n-5\n18446744073709551615
متغير طبيعي ك = 0
اطبع_سطر(~ك)
متغير طبيعي م = 5
اطبع_سطر(-م)
متغير طبيعي ج = ~ك
اطبع_سطر(ج)
