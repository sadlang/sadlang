# @rule: gr.decl.parameters
# @description: حدّي — `==`/`!=` بين معاملَين بلا نوع مُستنتَجَين نصًّا تقارن المحتوى لا العنوان (STRING_CMP لا EQ). النصّ يُبنى بـ«كرر» زمن التشغيل كي لا يطويه المترجم فيتّحد العنوانان وتنجح مقارنة العنوان زورًا
# @priority: P1
# @requires: اطبع_سطر
# @expected: صحيح
# @expected: خطأ
# @expected: خطأ

دالة قارن(أ، ب)
    ارجع أ == ب
نهاية

دالة اختلف(أ، ب)
    ارجع أ != ب
نهاية

متغير س = "سلام".كرر(1)
اطبع_سطر(قارن(س, "سلام"))
اطبع_سطر(قارن(س, "سلا"))
اطبع_سطر(اختلف(س, "سلام"))
