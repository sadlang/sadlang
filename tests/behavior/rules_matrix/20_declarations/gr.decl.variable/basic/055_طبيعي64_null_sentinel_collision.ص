# @rule: gr.decl.variable
# @description: طبيعي64 ببتّات حارس العدم (2^63+1) لا يُعامَل «عدمًا» في الطباعة/الشرط/نص()/نوع() — تكافؤ المسارين
# @priority: P1
# @requires: اطبع_سطر، نص، نوع
# @expected: 9223372036854775809\nصادق\n9223372036854775809\nرقم
متغير طبيعي64 ك = 9223372036854775809
اطبع_سطر(ك)
إذا (ك)
    اطبع_سطر("صادق")
وإلا
    اطبع_سطر("كاذب")
نهاية
اطبع_سطر(نص(ك))
اطبع_سطر(نوع(ك))
