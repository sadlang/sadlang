# @rule: gr.decl.function
# @description: دالّةٌ بإرجاعين محدَّدَي النوع لكن مختلفَيه (أعداد + نصوص) — يتوسّع نوعُ الإرجاع إلى Any فيُقرأ كلا الفرعين بنوعه (لا «آخِرُ إرجاعٍ يفوز» الذي كان يُقرئ العددَ نصًّا ⇒ انهيار)
# @priority: P1
# @requires: اطبع_سطر
# @expected: 10\nأ
دالة اختر(رقم ب)
    إذا (ب > 0)
        ارجع [10، 20، 30]
    وإلا
        ارجع ["أ"، "ب"]
    نهاية
نهاية
اطبع_سطر(اختر(1)[0])
اطبع_سطر(اختر(0)[0])
