# @expected: متساويان
# @expected: مختلفان
صنف متجه
    متغير السين = 0
    باني(قيمة_السين)
        هذا.السين = قيمة_السين
    نهاية
    عامل عام ==(الآخر) منطقي
        ارجع هذا.السين == الآخر.السين
    نهاية
نهاية
دالة قارِن(متجه اليسار، متجه اليمين)
    إذا (اليسار == اليمين)
        ارجع "متساويان"
    نهاية
    ارجع "مختلفان"
نهاية
اطبع_سطر(قارِن(متجه(1)، متجه(1)))
اطبع_سطر(قارِن(متجه(1)، متجه(2)))
