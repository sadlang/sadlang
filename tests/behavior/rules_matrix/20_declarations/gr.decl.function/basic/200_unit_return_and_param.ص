# @rule: gr.decl.function
# @description: «خالي» يعبرُ حدَّ الدالّةِ في الطرفَين: نوعَ إرجاعٍ ومعاملًا (مجال ٣)
# @priority: P0
# @requires: اطبع_سطر
# @expected: خالي\nخالي\nجانبيّ

# (AR) 🔑 والطرفانِ يُقاسانِ صراحةً ولا يُستنتَجُ أحدُهما من الآخر: **المعاملُ
#      يبلغُ المحلّلَ من سبعةِ مواضعَ متمايزة**، فبوّابةٌ على مسارٍ واحدٍ تُخفي
#      أنّ الستّةَ الباقيةَ مفتوحة.
#      ⚠️ ومقيسٌ (2026-09-07) أنّ نوعَ الإرجاعِ المُصرَّحَ «خالي» **لم يكن
#      يُسجَّلُ أصلًا**: كان يُجمَعُ مع «غيرِ المُصرَّح» فيسقطُ في استدلالٍ من
#      الجسد، فيُجيبُ «نوع(و())» **«صف»** (لأنّ الاستدلالَ يقرأُ «ارجع ()» صفًّا)
#      ويقولُ فاحصُ الأنواعِ **«رقم»** — ثلاثةُ أجوبةٍ لشيءٍ واحد. وكان الجمعُ
#      صوابًا يومَ كان «فراغ» يعني «لا نوعَ إرجاع»؛ فلمّا صارَ «خالي» نوعًا
#      مُصرَّحًا صارَ يُسقِطُ التصريحَ في استدلالٍ لا يخصُّه.
# (EN) Both ends are measured explicitly: parameters reach the parser through
#      SEVEN distinct sites, so a gate on one hides the other six. Measured: the
#      DECLARED unit return type was not recorded at all — it was lumped with
#      "undeclared" and fell into body inference, so نوع() said «صف» and the type
#      checker said «رقم». Three answers for one thing.

دالة خالي يرجع_وحدة()
    ارجع ()
نهاية

دالة خالي يمرر(خالي ق)
    ارجع ق
نهاية

دالة بلا_ارجاع()
    اطبع_سطر("جانبيّ")
نهاية

اطبع_سطر(نوع(يرجع_وحدة()))
اطبع_سطر(نوع(يمرر(())))
بلا_ارجاع()
