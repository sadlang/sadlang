# @rule: gr.oop.field
# @description: مصفوفةُ حقلِ صنفٍ افتراضيّةٌ (تُملأ بالإلحاق) تُقرأ عبر مسار Any (إرجاعٌ متنافر) — الحقلُ ٣ (tags) مُهيّأٌ null فلا تتفرّع القراءةُ على مؤشّرِ وسومٍ قمامةً (لا انهيار)
# @priority: P1
# @requires: اطبع_سطر
# @expected: ألف
صنف حاوية
    متغير عام عناصر = []
    دالة اجلب()
        هذا.عناصر.أضف("ألف")
        هذا.عناصر.أضف("باء")
        ارجع هذا.عناصر
    نهاية
نهاية
دالة اختر(رقم ب)
    متغير ح = حاوية()
    إذا (ب > 0)
        ارجع [500، "نصّ"، 3.5]
    وإلا
        ارجع ح.اجلب()
    نهاية
نهاية
اطبع_سطر(اختر(0)[0])
