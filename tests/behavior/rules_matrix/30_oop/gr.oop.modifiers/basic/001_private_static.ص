# @rule: gr.oop.modifiers
# @description: معدّلات — «خاص» و«ساكن» بعد «متغير» (الصفة بعد الموصوف)
# @priority: P1
# @requires: اطبع_سطر
# @expected: 7\n100
صنف ح
    متغير خاص _ع = 0
    متغير ساكن عدّاد = 100
    باني(ع) هذا._ع = ع نهاية
    دالة عام اقرأ() ارجع هذا._ع نهاية
نهاية
اطبع_سطر(ح(7).اقرأ())
اطبع_سطر(ح.عدّاد)
