# @rule: gr.oop.operator
# @description: 🔑 اسمٌ مربوطٌ بصنفٍ ثمّ أُسنِد إليه `لاشيء` يبقى مربوطًا — الخريطةُ مسطّحةٌ بلا نطاق. فإرسالُ `منطقي()` عليه يحوّل عددَ العدمِ مؤشِّرًا ويقرأ منه جدولَ الدوالِّ ⇒ انهيار. والعدمُ كاذبٌ بلا نداءٍ كما في المفسّر
# @priority: P0
# @requires: اطبع_سطر
# @expected: شرط-كاذب
# @expected: نفي-صادق
صنف مجموعة
    متغير عناصر = []
    باني(القيم)
        هذا.عناصر = القيم
    نهاية
    عامل عام منطقي()
        ارجع طول(هذا.عناصر) > 0
    نهاية
نهاية
متغير ص = مجموعة([1])
ص = لاشيء
إذا (ص)
    اطبع_سطر("شرط-صادق")
وإلا
    اطبع_سطر("شرط-كاذب")
نهاية
إذا (ليس ص)
    اطبع_سطر("نفي-صادق")
نهاية
