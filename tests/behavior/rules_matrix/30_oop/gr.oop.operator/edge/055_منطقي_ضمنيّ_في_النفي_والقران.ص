# @rule: gr.oop.operator
# @description: 🔑 التحويلُ الضمنيُّ بـ`عامل منطقي()` يلزم كلَّ موضعِ شرطٍ لا الشرطَ وحدَه: `إذا` و`بينما` كانا يحوّلان و`ليس` وطرفا `و`/`أو` لا — فينزل النفيُ على **مؤشِّرِ الكائن**، وهو غيرُ صفريٍّ دائمًا، فيجيب `ليس` بالخطأ أبدًا بلا رسالةٍ ولا رمزِ خطأ
# @priority: P1
# @requires: اطبع_سطر
# @expected: ملأى
# @expected: فارغة-منفيّة
# @expected: قران-صحيح
# @expected: فصل-صحيح
صنف مجموعة
    متغير عناصر = []
    باني(القيم)
        هذا.عناصر = القيم
    نهاية
    عامل عام منطقي()
        ارجع طول(هذا.عناصر) > 0
    نهاية
نهاية
متغير ملأى = مجموعة([1، 2])
متغير فارغة = مجموعة([])
إذا (ملأى)
    اطبع_سطر("ملأى")
نهاية
إذا (ليس فارغة)
    اطبع_سطر("فارغة-منفيّة")
نهاية
إذا (ملأى و ليس فارغة)
    اطبع_سطر("قران-صحيح")
نهاية
إذا (فارغة أو ملأى)
    اطبع_سطر("فصل-صحيح")
نهاية
