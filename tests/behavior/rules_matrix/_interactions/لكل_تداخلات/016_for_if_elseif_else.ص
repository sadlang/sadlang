# @rule: gr.stmt.for, gr.stmt.if
# @description: لكل × سلسلةِ إذا/وإلا إذا/وإلا الثلاثيّة
# @priority: P2
# @requires: اطبع_سطر
# @expected: 1\n1\n1

دالة رئيسية()
    متغير صغير = 0
    متغير وسط = 0
    متغير كبير = 0
    لكل ن في [1، 5، 9]
        إذا (ن < 3)
            صغير = صغير + 1
        وإلا إذا (ن < 7)
            وسط = وسط + 1
        وإلا
            كبير = كبير + 1
        نهاية
    نهاية
    اطبع_سطر(صغير)
    اطبع_سطر(وسط)
    اطبع_سطر(كبير)
نهاية
