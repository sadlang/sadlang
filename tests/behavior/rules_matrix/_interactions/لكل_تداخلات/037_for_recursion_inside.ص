# @rule: gr.stmt.for, gr.stmt.return
# @description: لكل × دالّةٍ تعاوديّةٍ تُنادى في كلِّ دورة
# @priority: P2
# @requires: اطبع_سطر
# @expected: 10

دالة مجموع_حتى(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    ارجع ن + مجموع_حتى(ن - 1)
نهاية

دالة رئيسية()
    متغير كلّيّ = 0
    لكل ن من 1 الى 3
        كلّيّ = كلّيّ + مجموع_حتى(ن)
    نهاية
    اطبع_سطر(كلّيّ)
نهاية
