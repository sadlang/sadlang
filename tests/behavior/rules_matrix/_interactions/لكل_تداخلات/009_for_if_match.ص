# @rule: gr.stmt.for, gr.stmt.if, gr.stmt.match
# @description: لكل + إذا + طابق
# @priority: P1
# @requires: اطبع_سطر
# @expected: و\nا

لكل ن في [1،2]
    إذا (ن>0)
        طابق (ن)
            عندما 1:
                اطبع_سطر("و")
            عندما 2:
                اطبع_سطر("ا")
        نهاية
    نهاية
نهاية
