# @rule: gr.stmt.for, gr.stmt.match
# @description: لكل × طابق — تصنيفُ كلِّ عنصر
# @priority: P2
# @requires: اطبع_سطر
# @expected: زوجيّ\nفرديّ\nزوجيّ

دالة رئيسية()
    لكل ن في [2، 3، 4]
        طابق ن % 2
            عندما 0:
                اطبع_سطر("زوجيّ")
            عندما 1:
                اطبع_سطر("فرديّ")
        نهاية
    نهاية
نهاية
