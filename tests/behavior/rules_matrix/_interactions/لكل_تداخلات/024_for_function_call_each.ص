# @rule: gr.stmt.for, gr.decl.function
# @description: لكل × تصريحِ دالّة — نداءٌ في كلِّ دورة
# @priority: P2
# @requires: اطبع_سطر
# @expected: 12

دالة ضاعف(ن)
    ارجع ن * 2
نهاية

دالة رئيسية()
    متغير مجموع = 0
    لكل ن في [1، 2، 3]
        مجموع = مجموع + ضاعف(ن)
    نهاية
    اطبع_سطر(مجموع)
نهاية
