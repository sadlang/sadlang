دالة صنّفها(ن)
    طابق ن % 2
        عندما 0:
            ارجع 1
        افتراضي:
            ارجع 2
    نهاية
نهاية

دالة رئيسية()
    متغير مجموع = 0
    حاول
        لكل ن في [1، 2، 3، 9]
            إذا (ن == 9)
                توقف
            نهاية
            مجموع = مجموع + صنّفها(ن)
        نهاية
        اطبع_سطر("أ")
    امسك خ
        اطبع_سطر("ب")
    نهاية
    اطبع_سطر(مجموع + 2)
نهاية
