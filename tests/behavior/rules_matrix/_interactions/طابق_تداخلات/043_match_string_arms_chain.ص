# @rule: gr.stmt.match, gr.expr.equality
# @description: أذرعٌ نصّيّةٌ متعدّدة
# @priority: P2
# @requires: اطبع_سطر
# @expected: ثانٍ

دالة رئيسية()
    متغير ك = "ب"
    طابق ك
        عندما "أ":
            اطبع_سطر("أوّل")
        عندما "ب":
            اطبع_سطر("ثانٍ")
        عندما "ج":
            اطبع_سطر("ثالث")
    نهاية
نهاية
