# @rule: gr.stmt.match, gr.stmt.for
# @description: طابق داخلَ حلقةٍ — تُصاب كلُّ ذراعٍ مرّة
# @priority: P2
# @requires: اطبع_سطر
# @expected: أ\nب\nج

دالة رئيسية()
    لكل ن في [1، 2، 9]
        طابق ن
            عندما 1:
                اطبع_سطر("أ")
            عندما 2:
                اطبع_سطر("ب")
            افتراضي:
                اطبع_سطر("ج")
        نهاية
    نهاية
نهاية
