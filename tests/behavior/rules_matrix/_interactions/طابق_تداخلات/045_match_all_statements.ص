# @description: طابق مع ستِّ قواعدَ في برنامجٍ واحد
# @priority: P2
# @requires: اطبع_سطر
# @expected: 3\nتمّ

دالة صنّفها(ن)
    طابق ن
        عندما 1:
            ارجع 1
        عندما 2:
            ارجع 2
        افتراضي:
            ارجع 0
    نهاية
نهاية

دالة رئيسية()
    متغير مجموع = 0
    حاول
        لكل ن في [1، 2، 9]
            إذا (ن < 9)
                مجموع = مجموع + صنّفها(ن)
            نهاية
        نهاية
    امسك خ
        مجموع = -1
    أخيراً
        اطبع_سطر(مجموع)
        اطبع_سطر("تمّ")
    نهاية
نهاية
