# @rule: gr.stmt.match, gr.stmt.return
# @description: «ارجع» من كلِّ ذراعٍ بقيمةٍ مختلفة
# @priority: P2
# @requires: اطبع_سطر
# @expected: 10\n20\n30

دالة صنّفها(ن)
    طابق ن
        عندما 1:
            ارجع 10
        عندما 2:
            ارجع 20
        افتراضي:
            ارجع 30
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر(صنّفها(1))
    اطبع_سطر(صنّفها(2))
    اطبع_سطر(صنّفها(9))
نهاية
