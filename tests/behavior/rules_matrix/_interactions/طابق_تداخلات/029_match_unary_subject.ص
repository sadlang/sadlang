# @rule: gr.stmt.match, gr.expr.unary
# @description: المُطابَقُ تعبيرٌ أحاديُّ السالب
# @priority: P2
# @requires: اطبع_سطر
# @expected: سالب_ثلاثة

دالة رئيسية()
    متغير ن = 3
    طابق -ن
        عندما -3:
            اطبع_سطر("سالب_ثلاثة")
        افتراضي:
            اطبع_سطر("غيره")
    نهاية
نهاية
