# @rule: gr.stmt.match, gr.expr.logical_and
# @description: المُطابَقُ نتيجةُ «و» المنطقيّة
# @priority: P2
# @requires: اطبع_سطر
# @expected: كلاهما

دالة رئيسية()
    متغير أ = صحيح
    متغير ب = صحيح
    طابق أ و ب
        عندما صحيح:
            اطبع_سطر("كلاهما")
        عندما خطأ:
            اطبع_سطر("ليس كلاهما")
    نهاية
نهاية
