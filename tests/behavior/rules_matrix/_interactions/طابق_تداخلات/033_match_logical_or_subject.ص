# @rule: gr.stmt.match, gr.expr.logical_or
# @description: المُطابَقُ نتيجةُ «أو» المنطقيّة
# @priority: P2
# @requires: اطبع_سطر
# @expected: أحدهما

دالة رئيسية()
    متغير أ = خطأ
    متغير ب = صحيح
    طابق أ أو ب
        عندما صحيح:
            اطبع_سطر("أحدهما")
        عندما خطأ:
            اطبع_سطر("لا أحد")
    نهاية
نهاية
