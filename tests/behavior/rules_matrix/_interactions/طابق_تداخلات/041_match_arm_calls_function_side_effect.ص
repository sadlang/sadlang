# @rule: gr.stmt.match, gr.decl.function
# @description: الذراعُ تنادي دالّةً ذاتَ أثرٍ جانبيّ
# @priority: P2
# @requires: اطبع_سطر
# @expected: أثر\n5

متغير عالميّ = 0
دالة أثّر()
    اطبع_سطر("أثر")
    ارجع 5
نهاية

دالة رئيسية()
    متغير ن = 1
    متغير ق = 0
    طابق ن
        عندما 1:
            ق = أثّر()
    نهاية
    اطبع_سطر(ق)
نهاية
