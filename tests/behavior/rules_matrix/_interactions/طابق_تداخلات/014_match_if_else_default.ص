# @rule: gr.stmt.match, gr.stmt.if
# @description: طابق + إذا/وإلا في افتراضي
# @priority: P1
# @requires: اطبع_سطر
# @expected: كبير

طابق (9)
    عندما 1:
        اطبع_سطر("و")
    افتراضي:
        إذا (9>5)
            اطبع_سطر("كبير")
        وإلا
            اطبع_سطر("صغير")
        نهاية
نهاية
