دالة فيبو(ن)
    طابق ن
        عندما 0:
            ارجع 0
        عندما 1:
            ارجع 1
        افتراضي:
            ارجع فيبو(ن - 1) + فيبو(ن - 2)
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر(فيبو(6))
نهاية
