متغير ع = 0
متغير ن = 0
بينما (ع < 6)
    إذا (ع > 0)
        طابق (ع % 3)
            عندما 0:
                ن = ن + 100
            افتراضي:
                ن = ن + 1
        نهاية
    نهاية
    ع = ع + 1
نهاية
اطبع_سطر(ن)
