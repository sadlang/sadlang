# @rule: gr.decl.function, gr.expr.logical_and, gr.expr.logical_or, gr.stmt.if
# @description: قصر الدائرة مع آثار جانبية في الدوال (&& يقف عند لا، || يقف عند نعم)
# @priority: P2
# @requires: اطبع_سطر
# @expected: لن.

متغير سجل = ""
دالة نعم()
    سجل = سجل + "ن"
    ارجع صحيح
نهاية
دالة لا()
    سجل = سجل + "ل"
    ارجع خطأ
نهاية
إذا (لا() && نعم())
    سجل = سجل + "!"
نهاية
إذا (نعم() || لا())
    سجل = سجل + "."
نهاية
اطبع_سطر(سجل)
