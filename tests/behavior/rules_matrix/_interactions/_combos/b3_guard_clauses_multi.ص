# @description: حُرّاس متعدّدون بإرجاع مبكر
# @priority: P2
# @requires: اطبع_سطر
# @expected: سالبصفرأحادكبير

دالة صنّف(ع)
    إذا (ع < 0)
        ارجع "سالب"
    نهاية
    إذا (ع == 0)
        ارجع "صفر"
    نهاية
    إذا (ع < 10)
        ارجع "أحاد"
    نهاية
    ارجع "كبير"
نهاية
متغير ر = ""
لكل ق في [-3، 0، 5، 50]
    ر = ر + صنّف(ق)
نهاية
اطبع_سطر(ر)
