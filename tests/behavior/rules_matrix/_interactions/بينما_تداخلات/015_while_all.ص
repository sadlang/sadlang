دالة عُد_موجب(مصفوفة)
    متغير ك=0
    متغير ع=0
    بينما (ع<طول(مصفوفة))
        إذا (مصفوفة[ع]>0)
            ك=ك+1
        نهاية
        ع=ع+1
    نهاية
    ارجع ك
نهاية
اطبع_سطر(عُد_موجب([1،-1،2،-2،3]))
