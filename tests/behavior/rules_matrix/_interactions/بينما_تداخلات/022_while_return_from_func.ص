# @rule: gr.stmt.while, gr.stmt.return, gr.decl.function
# @description: بينما + إرجاع من داخل الحلقة
# @priority: P1
# @requires: اطبع_سطر
# @expected: 4

دالة أول_زوجي(م)
    متغير ع=0
    بينما (ع < طول(م))
        إذا (م[ع] % 2 == 0)
            ارجع م[ع]
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية
اطبع_سطر(أول_زوجي([1، 3، 4، 6]))
