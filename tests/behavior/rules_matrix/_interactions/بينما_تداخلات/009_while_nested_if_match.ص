# @rule: gr.stmt.while, gr.stmt.if, gr.stmt.match
# @description: بينما + إذا + طابق
# @priority: P1
# @requires: اطبع_سطر
# @expected: ص\nو

متغير ع=0
بينما (ع<2)
    إذا (ع>=0)
        طابق (ع)
            عندما 0:
                اطبع_سطر("ص")
            عندما 1:
                اطبع_سطر("و")
        نهاية
    نهاية
    ع=ع+1
نهاية
