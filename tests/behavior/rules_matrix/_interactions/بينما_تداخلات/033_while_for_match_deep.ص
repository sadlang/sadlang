# @rule: gr.stmt.while, gr.stmt.for, gr.stmt.match
# @description: بينما + لكل + طابق ثلاثيّة
# @priority: P1
# @requires: اطبع_سطر
# @expected: ز\nف\nز\nف

متغير ع=0
بينما (ع < 2)
    لكل ن في [1، 2]
        طابق (ن % 2)
            عندما 1:
                اطبع_سطر("ز")
            افتراضي:
                اطبع_سطر("ف")
        نهاية
    نهاية
    ع = ع + 1
نهاية
