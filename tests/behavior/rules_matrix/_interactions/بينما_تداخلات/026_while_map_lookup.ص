# @rule: gr.stmt.while, gr.expr.map_literal
# @description: بينما + بحثٌ متكرِّرٌ في خريطةٍ بمفاتيحَ متغيّرة
# @priority: P1
# @requires: اطبع_سطر
# @expected: 5\n10\n20

متغير خريطة = {"أ": 5، "ب": 10، "ج": 20}
متغير مفاتيح = ["أ"، "ب"، "ج"]
متغير عداد = 0
بينما (عداد < طول(مفاتيح))
    اطبع_سطر(خريطة[مفاتيح[عداد]])
    عداد = عداد + 1
نهاية
