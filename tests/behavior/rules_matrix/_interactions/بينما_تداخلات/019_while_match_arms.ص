# @rule: gr.stmt.while, gr.stmt.match
# @description: بينما + أذرع طابق
# @priority: P1
# @requires: اطبع_سطر
# @expected: أ\nب\nج

متغير ع=0
بينما (ع < 3)
    طابق (ع)
        عندما 0:
            اطبع_سطر("أ")
        عندما 1:
            اطبع_سطر("ب")
        افتراضي:
            اطبع_سطر("ج")
    نهاية
    ع = ع + 1
نهاية
