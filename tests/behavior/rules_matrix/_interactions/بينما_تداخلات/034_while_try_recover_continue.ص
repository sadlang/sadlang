# @rule: gr.stmt.while, gr.stmt.try, gr.stmt.throw, gr.stmt.if
# @description: بينما + تعافٍ من الخطأ ومتابعة
# @priority: P1
# @requires: اطبع_سطر
# @expected: 1\nعطل\n3

متغير ع=0
بينما (ع < 3)
    ع = ع + 1
    حاول
        إذا (ع == 2)
            ارمي "خ"
        نهاية
        اطبع_سطر(ع)
    امسك خطأ
        اطبع_سطر("عطل")
    نهاية
نهاية
