# @rule: gr.stmt.while, gr.expr.assignment
# @description: بينما + إسناداتٌ متعاقبةٌ يعتمدُ بعضُها على بعض
# @priority: P1
# @requires: اطبع_سطر
# @expected: 8

متغير أول=1
متغير ثاني=1
متغير عداد=0
بينما (عداد < 3)
    أول = أول + ثاني
    ثاني = أول - ثاني
    عداد = عداد + 1
نهاية
اطبع_سطر(أول + ثاني)
