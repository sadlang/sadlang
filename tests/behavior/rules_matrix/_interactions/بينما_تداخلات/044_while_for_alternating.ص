# @rule: gr.stmt.while, gr.stmt.for, gr.stmt.if
# @description: بينما + لكل بتناوب الفرزين
# @priority: P1
# @requires: اطبع_سطر
# @expected: 2\n4\n4

متغير ع=0
بينما (ع < 2)
    لكل ن في [1، 2، 3، 4]
        إذا (ن % 2 == 0 و ن > ع * 2)
            اطبع_سطر(ن)
        نهاية
    نهاية
    ع = ع + 1
نهاية
