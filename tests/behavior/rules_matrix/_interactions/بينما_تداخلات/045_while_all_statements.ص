# @description: بينما مع أكبر خليط من القواعد
# @priority: P1
# @requires: اطبع_سطر
# @expected: 18

دالة عالج(م)
    متغير ع=0
    متغير ك=0
    بينما (ع < طول(م))
        حاول
            إذا (م[ع] < 0)
                ارمي "س"
            نهاية
            طابق (م[ع] % 2)
                عندما 0:
                    ك = ك + م[ع]
                افتراضي:
                    ك = ك + 1
            نهاية
        امسك خطأ
            توقف
        نهاية
        ع = ع + 1
    نهاية
    ارجع ك
نهاية
اطبع_سطر(عالج([2، 3، 4، 5، 10، -1، 100]))
