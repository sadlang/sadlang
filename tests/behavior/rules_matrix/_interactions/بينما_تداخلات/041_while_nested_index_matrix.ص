# @rule: gr.stmt.while, gr.expr.array_literal, gr.expr.postfix
# @description: بينما + مسح مصفوفة مصفوفات
# @priority: P1
# @requires: اطبع_سطر
# @expected: 10

متغير م=[[1، 2]، [3، 4]]
متغير أ=0
متغير ك=0
بينما (أ < طول(م))
    متغير ب=0
    بينما (ب < طول(م[أ]))
        ك = ك + م[أ][ب]
        ب = ب + 1
    نهاية
    أ = أ + 1
نهاية
اطبع_سطر(ك)
