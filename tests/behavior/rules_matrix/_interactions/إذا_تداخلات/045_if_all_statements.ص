دالة صنّف(م)
    متغير ع=0
    بينما (ع < طول(م))
        حاول
            إذا (م[ع] < 0)
                ارمي "س"
            نهاية
            طابق (م[ع])
                عندما 0:
                    ارجع "ص"
                افتراضي:
                    ع = ع + 1
            نهاية
        امسك خطأ
            ارجع "خ"
        نهاية
    نهاية
    ارجع "ن"
نهاية
اطبع_سطر(صنّف([1، 2، 3]))
