# @rule: gr.stmt.if, gr.stmt.match
# @description: إذا + طابق: الذراعُ المطابِقةُ تمنعُ «افتراضي»
# @priority: P1
# @requires: اطبع_سطر
# @expected: ذراع2

متغير س=2
إذا (س > 0)
    طابق (س)
        عندما 1:
            اطبع_سطر("ذراع1")
        عندما 2:
            اطبع_سطر("ذراع2")
        افتراضي:
            اطبع_سطر("افتراضي")
    نهاية
نهاية
