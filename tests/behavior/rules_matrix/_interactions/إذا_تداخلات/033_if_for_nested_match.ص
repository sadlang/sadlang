# @rule: gr.stmt.if, gr.stmt.for, gr.stmt.match
# @description: إذا + لكل + طابق متداخلة
# @priority: P1
# @requires: اطبع_سطر
# @expected: ز\nف

لكل ن في [1، 2]
    إذا (ن > 0)
        طابق (ن % 2)
            عندما 1:
                اطبع_سطر("ز")
            افتراضي:
                اطبع_سطر("ف")
        نهاية
    نهاية
نهاية
