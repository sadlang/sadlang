# @rule: gr.pattern.list, gr.pattern.struct
# @description: نمط قائمة + نمط بنية
# @priority: P2
# @requires: اطبع_سطر
# @expected: 10

بنية نقطة
    رقم س = 0
    رقم ص = 0
نهاية
متغير ن = نقطة()
ن.س = 7
ن.ص = 3
طابق (ن)
    عندما {س: أ، ص: ب}:
        اطبع_سطر(أ + ب)
    عندما [ج، د]:
        اطبع_سطر(ج)
    افتراضي:
        اطبع_سطر("لا")
نهاية
