# @rule: gr.stmt.switch, gr.stmt.if, gr.expr.comparison
# @description: تداخل: حالة مع إذا ومقارنة
# @priority: P2
# @requires: اطبع_سطر
# @expected: كبير

متغير ن = 3
حالة ن
    عندما 3:
        إذا (ن > 2)
            اطبع_سطر("كبير")
        وإلا
            اطبع_سطر("صغير")
        نهاية
    افتراضي: اطبع_سطر("غيره")
نهاية
