# @description: برنامج يجمع كل أنواع الجمل
# @priority: P1
# @requires: اطبع_سطر
# @expected: سالب\nغير سالب\n1\n3\nنهاية

دالة صنّف(ن)
    إذا (ن < 0)
        ارجع "سالب"
    وإلا
        ارجع "غير سالب"
    نهاية
نهاية
لكل ن في [-1، 2]
    اطبع_سطر(صنّف(ن))
نهاية
متغير ع = 0
بينما (صحيح)
    ع = ع + 1
    إذا (ع == 2) استمر نهاية
    إذا (ع >= 4) توقف نهاية
    اطبع_سطر(ع)
نهاية
حاول
    ارمي "ع"
امسك خطأ
    طابق (1)
        عندما 1:
            اطبع_سطر("نهاية")
    نهاية
نهاية
