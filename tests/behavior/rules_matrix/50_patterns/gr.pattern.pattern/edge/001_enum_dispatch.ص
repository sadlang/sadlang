# @rule: gr.pattern.pattern
# @description: الموزّع يوجّه «تعداد.قيمة» إلى نمط عضو التعداد
# @priority: P2
# @requires: اطبع_سطر
# @expected: متوقف
تعداد حالة
    نشط
    متوقف
نهاية
متغير ح = حالة.متوقف
طابق (ح)
    عندما حالة.نشط: اطبع_سطر("نشط")
    عندما حالة.متوقف: اطبع_سطر("متوقف")
    افتراضي: اطبع_سطر("؟")
نهاية
