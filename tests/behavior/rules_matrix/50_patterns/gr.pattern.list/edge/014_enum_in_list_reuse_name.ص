# @rule: gr.pattern.list
# @description: نمط تعداد داخل قائمة يعيد استعمال اسم الحمولة «ق» عبر ذراعين — كلّ جسمٍ يقرأ سجلّ ذراعه المُهيمِن لا سجلّ ذراعٍ سابق (ISSUE-078؛ منع خرق هيمنة SSA عبر الأذرع: إعادة ربط لكلّ ذراع)
# @priority: P1
# @requires: اطبع_سطر
# @expected: فشل 99
تعداد نتيجة
    نجاح(عدد)
    فشل(عدد)
نهاية
متغير م = [نتيجة.فشل(99)]
طابق (م)
    عندما [نتيجة.نجاح(ق)]: اطبع_سطر("نجاح " + نص(ق))
    عندما [نتيجة.فشل(ق)]: اطبع_سطر("فشل " + نص(ق))
    افتراضي: اطبع_سطر("لا")
نهاية
