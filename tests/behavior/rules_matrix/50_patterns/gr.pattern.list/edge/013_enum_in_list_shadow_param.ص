# @rule: gr.pattern.list
# @description: نمط تعداد داخل قائمة يُظلِّل معاملًا خارجيًّا بنفس الاسم «ق» — يجب ربط الحمولة لا قراءة المعامل (ISSUE-078؛ منع تباعد التظليل الصامت: لا تخطٍّ بـlookupVariable)
# @priority: P1
# @requires: اطبع_سطر
# @expected: ق=42
تعداد نتيجة
    نجاح(عدد)
    فشل
نهاية
دالة اعرض(ق)
    متغير م = [نتيجة.نجاح(42)]
    طابق (م)
        عندما [نتيجة.نجاح(ق)]: اطبع_سطر("ق=" + نص(ق))
        افتراضي: اطبع_سطر("لا")
    نهاية
نهاية
اعرض(7)
