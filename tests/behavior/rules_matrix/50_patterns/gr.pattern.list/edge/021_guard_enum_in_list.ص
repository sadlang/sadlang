# @rule: gr.pattern.list
# @description: حارس على نمط تعدادٍ داخل قائمة «[نتيجة.نجاح(ق)] إذا ق > 10» — يتحقّق من تآزر إصلاح ISSUE-075 (توجيه guard+مركّب لقصر الدائرة يربط الحمولة في كتلة النجاح المُهيمِنة) مع رؤية الحارس للحمولة المتداخلة (اختبار انحدار متمّم: نمطٌ مركّب لا يمرّ عبر emitDeferredExtractions)
# @priority: P1
# @requires: اطبع_سطر، نص
# @expected: 42
تعداد نتيجة
    نجاح(القيمة)
    فشل
نهاية
متغير م = [نتيجة.نجاح(42)]
طابق م
    عندما [نتيجة.نجاح(ق)] إذا ق > 10: اطبع_سطر(نص(ق))
    افتراضي: اطبع_سطر("لا")
نهاية
