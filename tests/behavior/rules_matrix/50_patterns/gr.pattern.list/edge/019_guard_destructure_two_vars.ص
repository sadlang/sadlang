# @rule: gr.pattern.list
# @description: حارس تفكيكيّ يقرأ متغيّرين مربوطين معًا «[أ، ب] إذا أ - ب == 10» — الشرط على فرق العنصرين يشترط ربطهما معًا (لو انكسر ربط الثاني ⇒ ب=0 ⇒ 30≠10) فيكشف انحدار ربط العنصر الثاني، ويميّزه عن 018 (الجمع) لا يكرّره (ISSUE-069)
# @priority: P1
# @requires: اطبع_سطر
# @expected: أكبر
متغير ز = [30، 20]
طابق ز
    عندما [أ، ب] إذا أ - ب == 10: اطبع_سطر("أكبر")
    افتراضي: اطبع_سطر("لا")
نهاية
