# @rule: gr.pattern.list
# @description: مقارنة منطقيّة على عنصر قائمةٍ مُستخرَجٍ بنمط «[ن]» في حارس — يثبّت أنّ عنصر المصفوفة المنطقيّ المتجانس يُعاد إلى i1 القانونيّ (مقارنة بصفر بعد التحميل، عكس مدّ الإشارة عند التخزين) فتصحّ المقارنة (ISSUE-082 عنصر القائمة، الجانب المنطقيّ)
# @priority: P1
# @requires: اطبع_سطر
# @expected: مطابق
متغير ز = [صحيح]
طابق ز
    عندما [ن] إذا ن == صحيح: اطبع_سطر("مطابق")
    افتراضي: اطبع_سطر("افتراضي")
نهاية
