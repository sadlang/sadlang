# @rule: gr.pattern.list
# @description: نمط متداخل مع حارس على قيمةٍ قياديّة «طابق(5) عندما [[أ،ب]] إذا أ>5» — الذراع ميتٌ ساكنًا؛ يجب أن تنجح الترجمة (ربط صوريّ للحارس الميت) ويسقط للافتراضيّ لا خطأ ترجمة (ISSUE-075)
# @priority: P1
# @requires: اطبع_سطر
# @expected: قياديّ
متغير ز = 5
طابق (ز)
    عندما [[أ، ب]] إذا أ > 5: اطبع_سطر(أ)
    افتراضي: اطبع_سطر("قياديّ")
نهاية
