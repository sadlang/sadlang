# @rule: gr.pattern.list
# @description: حارس «إذا» على نمط قائمة تفكيكيّ أحاديّ المستوى «[أ، ب]» يقرأ العناصر المربوطة — يتحقّق من استخراج عناصر القائمة المؤجّلة في نطاق الحارس قبل تقييمه (ISSUE-069، مُصلَح: emitDeferredExtractions في كتلة الحارس)
# @priority: P1
# @requires: اطبع_سطر
# @expected: كبير
متغير ز = [10، 20]
طابق ز
    عندما [أ، ب] إذا أ + ب > 25: اطبع_سطر("كبير")
    افتراضي: اطبع_سطر("صغير")
نهاية
