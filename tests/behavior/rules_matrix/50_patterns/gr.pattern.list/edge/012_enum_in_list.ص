# @rule: gr.pattern.list
# @description: نمط تعداد جبريّ داخل قائمة «[نتيجة.نجاح(ق)]» يفكّك حمولة العنصر التعداديّ ويربطها (ISSUE-078؛ نقل ربط الحمولة المؤجّل للابن التعداديّ عبر قصر الدائرة في handleChild)
# @priority: P1
# @requires: اطبع_سطر
# @expected: ق=42
تعداد نتيجة
    نجاح(عدد)
    فشل
نهاية
متغير م = [نتيجة.نجاح(42)]
طابق (م)
    عندما [نتيجة.نجاح(ق)]: اطبع_سطر("ق=" + نص(ق))
    افتراضي: اطبع_سطر("لا")
