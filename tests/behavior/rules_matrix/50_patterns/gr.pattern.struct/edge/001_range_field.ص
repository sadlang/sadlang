# @rule: gr.pattern.struct
# @description: نمط بنية بحقلٍ نمطُه نطاق «{س: 1..10، ص: ب}»
# @priority: P2
# @requires: اطبع_سطر
# @expected: 9
بنية نقطة
    رقم س = 0
    رقم ص = 0
نهاية
متغير ن = نقطة()
ن.س = 4
ن.ص = 9
طابق (ن)
    عندما {س: 1..10، ص: ب}: اطبع_سطر(ب)
    افتراضي: اطبع_سطر("لا")
نهاية
