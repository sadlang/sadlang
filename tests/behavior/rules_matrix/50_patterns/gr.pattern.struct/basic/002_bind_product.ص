بنية نقطة
    رقم س = 0
    رقم ص = 0
نهاية
متغير ن = نقطة()
ن.س = 5
ن.ص = 9
طابق (ن)
    عندما {س: أ، ص: ب}:
        اطبع_سطر(أ * ب)
    افتراضي:
        اطبع_سطر("لا")
نهاية
