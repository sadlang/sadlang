# @rule: gr.pattern.struct
# @description: نمط بنية — مطابقة حقل بقيمة حرفية
# @priority: P1
# @requires: اطبع_سطر
# @expected: مطابق
بنية نقطة
    رقم س = 0
    رقم ص = 0
نهاية
متغير ن = نقطة()
ن.س = 1
ن.ص = 2
طابق (ن)
    عندما {س: 1، ص: 2}:
        اطبع_سطر("مطابق")
    افتراضي:
        اطبع_سطر("لا")
نهاية
