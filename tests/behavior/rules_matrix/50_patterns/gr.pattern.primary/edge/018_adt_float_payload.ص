# @rule: gr.pattern.primary
# @description: نمط عضو تعداد جبريّ (ADT) بحمولة عشريّة — بناء «نتيجة.نجاح(3.5)» ثمّ استخراج الحمولة العشريّة في المطابقة (يقفل ISSUE-076: نوع الحمولة مُستنتَج من موقع الإنشاء فيراها المستهلك double لا Integer)
# @priority: P1
# @requires: اطبع_سطر، نص
# @expected: ق=3.5
تعداد نتيجة
    نجاح(القيمة)
نهاية
متغير ج = نتيجة.نجاح(3.5)
طابق (ج)
    عندما نتيجة.نجاح(ق): اطبع_سطر("ق=" + نص(ق))
    افتراضي: اطبع_سطر("لا")
نهاية
