# @rule: gr.pattern.primary
# @description: حارس «إذا» يقرأ حمولة تعدادٍ جبريّ مربوطة في نمط الذراع «عندما شكل.دائرة(ق) إذا ق > 0» — يتحقّق من استخراج حمولة التعداد المؤجّلة في نطاق الحارس قبل تقييمه (ISSUE-081، مُصلَح: emitDeferredExtractions في كتلة الحارس)
# @priority: P1
# @requires: اطبع_سطر، نص
# @expected: 7
تعداد شكل
    دائرة(نق)
    مربع
نهاية
متغير ش = شكل.دائرة(7)
طابق ش
    عندما شكل.دائرة(ق) إذا ق > 0
        اطبع_سطر(نص(ق))
    عندما شكل.مربع
        اطبع_سطر("مربع")
نهاية
