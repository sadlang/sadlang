# @rule: gr.pattern.primary
# @description: نمط ADT بحمولة عشريّة — عمليّة حسابيّة على الحمولة المُستخرَجة «ق + 1.5» تعمل مزدوجًا (تأكيد أنّ النوع المُستنتَج double يجري حسابًا عشريًّا لا صحيحًا) — ISSUE-076
# @priority: P1
# @requires: اطبع_سطر، نص
# @expected: 5.0
تعداد نتيجة
    نجاح(القيمة)
نهاية
متغير ج = نتيجة.نجاح(3.5)
طابق (ج)
    عندما نتيجة.نجاح(ق): اطبع_سطر(نص(ق + 1.5))
    افتراضي: اطبع_سطر("لا")
نهاية
