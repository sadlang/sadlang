# @rule: gr.pattern.primary
# @description: نمط ADT بحمولة عشريّة داخل حارس — «إذا ق > 3.0» يقرأ الحمولة العشريّة المُستخرَجة قبل الجسم (يقفل تقاطع ISSUE-076 مع رؤية الحارس ISSUE-081)
# @priority: P1
# @requires: اطبع_سطر
# @expected: كبير
تعداد نتيجة
    نجاح(القيمة)
نهاية
متغير ج = نتيجة.نجاح(3.5)
طابق (ج)
    عندما نتيجة.نجاح(ق) إذا ق > 3.0: اطبع_سطر("كبير")
    عندما نتيجة.نجاح(ق): اطبع_سطر("صغير")
    افتراضي: اطبع_سطر("لا")
نهاية
