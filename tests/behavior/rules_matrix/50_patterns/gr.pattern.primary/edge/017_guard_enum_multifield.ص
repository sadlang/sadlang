# @rule: gr.pattern.primary
# @description: حارس يقرأ حقلَي حمولةٍ متعدّدة على قيمة ADT «شكل.مستطيل(ع، ط) إذا ع - ط == 5» — الشرط على فرق الحقلين يشترط ربطهما معًا بقيمتيهما الصحيحتين (لو انكسر ربط الثاني ⇒ ط=0 ⇒ 8≠5؛ لو الأوّل ⇒ ع=0 ⇒ -3≠5) فيكشف انحدار ربط الحقل الثاني (ISSUE-081)
# @priority: P1
# @requires: اطبع_سطر
# @expected: عريض
تعداد شكل
    مستطيل(عرض، طول)
    نقطة
نهاية
متغير ش = شكل.مستطيل(8، 3)
طابق ش
    عندما شكل.مستطيل(ع، ط) إذا ع - ط == 5: اطبع_سطر("عريض")
    افتراضي: اطبع_سطر("لا")
نهاية
