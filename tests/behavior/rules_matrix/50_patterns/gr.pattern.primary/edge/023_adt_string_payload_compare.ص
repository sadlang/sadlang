# @rule: gr.pattern.primary
# @description: مقارنة حمولة تعدادٍ نصّيّة «ن == «مرحبا»» داخل المطابقة — النوع المُستنتَج نصّ فتُجرى مقارنة نصّيّة صحيحة لا مقارنة بتات مؤشّر (يقفل مسار حمولة التعداد من ISSUE-082 عبر استنتاج نوع الحقل A′)
# @priority: P1
# @requires: اطبع_سطر، نص
# @expected: صحيح
تعداد رسالة
    نص_م(المحتوى)
    فارغ
نهاية
متغير ر = رسالة.نص_م("مرحبا")
طابق ر
    عندما رسالة.نص_م(ن): اطبع_سطر(نص(ن == "مرحبا"))
    افتراضي: اطبع_سطر("افتراضي")
