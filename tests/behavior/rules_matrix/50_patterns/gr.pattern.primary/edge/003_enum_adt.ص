# @rule: gr.pattern.primary
# @description: نمط عضو تعداد جبريّ (ADT) مع ربط بيانات — «شكل.دائرة(نق)»
# @priority: P1
# @requires: اطبع_سطر
# @expected: نق=5
تعداد شكل
    دائرة(عدد)
    مربع(عدد)
نهاية
متغير ش = شكل.دائرة(5)
طابق (ش)
    عندما شكل.دائرة(نق): اطبع_سطر("نق=" + نص(نق))
    عندما شكل.مربع(ض): اطبع_سطر("ض=" + نص(ض))
    افتراضي: اطبع_سطر("؟")
نهاية
