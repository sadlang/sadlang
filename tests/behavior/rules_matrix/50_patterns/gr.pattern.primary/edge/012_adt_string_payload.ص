# @rule: gr.pattern.primary
# @description: نمط عضو تعداد جبريّ (ADT) بحمولة نصّيّة — بناء «رسالة.نص_(«مرحبا»)» ثمّ مطابقتها (يقفل إصلاح بانِي ADT، حمولة نصّيّة)
# @priority: P1
# @requires: اطبع_سطر
# @expected: مرحبا
تعداد رسالة
    نص_(محتوى)
نهاية
متغير ر = رسالة.نص_("مرحبا")
طابق (ر)
    عندما رسالة.نص_(م): اطبع_سطر(م)
    افتراضي: اطبع_سطر("لا")
نهاية
