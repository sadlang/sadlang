# @rule: gr.pattern.or
# @description: حدّي — نمط بدائل داخل حلقة لكل
# @priority: P2
# @requires: اطبع_سطر
# @expected: فردي\nزوجي\nفردي\nطابق_خارج
لكل ر في [1، 2، 3، 9]
    طابق (ر)
        عندما 1 | 3:
            اطبع_سطر("فردي")
        عندما 2 | 4:
            اطبع_سطر("زوجي")
        افتراضي:
            اطبع_سطر("طابق_خارج")
    نهاية
نهاية
