# @rule: gr.adv.asm_dialect
# @description: x86_64 — سجلّ من سجلّات الوضع الطويل (المركم_٣٢ ⇒ eax) لا وجود له في معجم i686 ولا AArch64 — فحص ترجمة
# @requires: اطبع_سطر
# @skip_interpreter
# @arch: x86_64    # «المركم_٣٢» نصفُ المركم ٣٢-بت: لا يوجد إلّا حيث المركم ٦٤-بت
# @expected: ok

# (AR) 🔑 هذا الاختبار **يفرز الجدولين**: «المركم_٣٢» موجود في معجم x86_64 وحدَه — على i686 المركمُ نفسُه ٣٢-بت
#      فلا لاحقةَ له، وفي AArch64 لا «مركم» أصلًا. (و«سجل_٨» لا يفرز: AArch64 يرقّم
#      سجلّاته من سجل_٠ إلى سجل_٣٠ فيتضمّنه.)
#      فلو بقي المترجّم يُخفض بمعجم i686 على هدف ٦٤-بت — وهو ما كان يفعله قبل هذه
#      الحملة — لخرج SEM033 «سجلّ غير معجميّ» لا نجاح. أي أنّ خضرته دليلٌ على أنّ
#      **جدول الهدف** هو المُنتقى، لا مجرّد أنّ الكتلة تُترجَم.
دالة استعمل_سجلًّا_ممتدًّا()
    تجميع
        انقل المركم_٣٢، 0
        يلوّث(المركم_٣٢)
    نهاية
نهاية
اطبع_سطر("ok")
