# @rule: gr.adv.asm_dialect
# @description: AArch64/RISC-V — الذيل النصّيّ الثابت من المعجم (operand_tail): «اقرأ_عدّاد_الدورات» ⇒ mrs وجهة, cntvct_el0 · rdcycle وجهة — فحص ترجمة
# @requires: اطبع_سطر
# @skip_interpreter
# @arch: aarch64 riscv64    # عدّاد الدورات يُقرأ إلى وجهة صريحة في المعماريّتين — وعلى x86 «rdtsc» بلا معامل، فشكلها يفترق
# @expected: ok

# (AR) 🔑 يقيس المسار الذي لا يقيسه غيرُه: منمنمة معاملُها الثاني **نصّ ثابت** من
#      المعجم لا معامل ص. ولو أُسقط الذيل صامتًا لخرج «mrs x0» وحدَها — وهي تعليمة
#      ناقصة يرفضها المُجمِّع، فالإسقاط الصامت يُكشَف هنا لا يمرّ.
دالة اقرأ_الدورات()
    متغير دورات = 0
    تجميع
        اقرأ_عدّاد_الدورات {دورات}
    نهاية
نهاية
اطبع_سطر("ok")
