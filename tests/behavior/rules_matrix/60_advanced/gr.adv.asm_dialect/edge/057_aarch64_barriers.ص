# @rule: gr.adv.asm_dialect
# @description: AArch64 — حواجز الترتيب «زامِن_الذاكرة/البيانات/التعليمات» (dmb sy · dsb sy · isb): منمنمات بلا معامل ص، اثنتان بذيل ثابت وواحدة بلا
# @requires: اطبع_سطر
# @skip_interpreter
# @arch: aarch64    # لا نظير لها على x86 حيث نموذج الذاكرة أقوى ترتيبًا
# @expected: 7

# (AR) 🔑 الحاجز شكلٌ لم يكن مقيسًا: منمنمة **بلا معامل ص البتّةَ** ومعها ذيلٌ
#      نصّيّ («dmb sy»). فهي تفرّق بين «لا معاملات» و«لا نصّ بعد المنمنمة» —
#      ولو أُسقط الذيل لخرجت «dmb» عاريةً ويرفضها المُجمِّع.
#      و«زامِن_التعليمات» بلا ذيلٍ أصلًا، فالثلاثةُ معًا تقيس الفرعين.
#
# ⚠️ ولماذا لا يُقاس أثرُ الحاجز نفسِه؟ لأنّه ترتيبٌ لا قيمة: أثرُه لا يظهر إلّا
#    على عتادٍ متعدّد النوى تحت حمل. فالمقيس هنا **أنّها تُخفَض وتُجمَّع وتُنفَّذ
#    في رتبة المستخدم** — وذلك ما كان يُخفق قبل وجودها في المعجم.
دالة اجمع_بحواجز(عدد أ، عدد ب)
    متغير ناتج = أ
    تجميع
        زامِن_الذاكرة
        اجمع {ناتج}، {ب}
        زامِن_البيانات
        زامِن_التعليمات
        يلوّث(الأعلام)
    نهاية
    ارجع ناتج
نهاية

اطبع_سطر(اجمع_بحواجز(3، 4))
