# @rule: gr.adv.asm_dialect
# @description: حمّل_سجل_المهمة/خزّن_سجل_المهمة (ltr/str) — معامل منتقٍ 16-بت (operand_width) — فحص ترجمة
# @requires: اطبع_سطر
# @skip_interpreter
# @arch: x86    # سجلّ المهمة (ltr/str) بنية x86 محضة — لا TSS في AArch64
# @expected: ok

# (AR) ltr/str معاملهما r/m16: المُجمِّع يرفض الصيغة 32-بت، فالمعجم يعلن
#      operand_width:16 ⇒ يُصدر الخفض ${N:w} فيختار السجلّ الفرعيّ 16-بت.
#      تحميل TR أساس انتقال الحلقة 3 (نطاق المستخدم). فحص ترجمة لا تنفيذ.
دالة حمّل_المهمة()
    متغير منتقي = 40      # 0x28 — منتقي واصف TSS المتوقَّع
    متغير مقروء = 0
    تجميع
        حمّل_سجل_المهمة {منتقي}
        خزّن_سجل_المهمة {مقروء}
    نهاية
نهاية
اطبع_سطر("ok")
