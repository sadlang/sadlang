# @rule: gr.adv.asm_dialect
# @description: AArch64 — منمنمات بتّيّة أُضيفت مع توسيع المعجم: «امسح_بتّات» (bic) و«عُدّ_الأصفار_البادئة» (clz) — الأولى تقرأ وجهتها فتُكرَّر، والثانية لا
# @requires: اطبع_سطر
# @skip_interpreter
# @arch: aarch64
# @expected: 8

# (AR) 🔑 يقيس شيئين معًا لا يقيسهما غيرُه في هذه المجموعة:
#   ① «امسح_بتّات» تقرأ وجهتها (reads_dest) فتُكرَّر الوجهةُ معاملًا مستقلًّا:
#      «bic x0, x0, x1» لا «bic x0, x1». ولو سقط التكرار قبله المُجمِّع بدلالة
#      أخرى صامتًا — عطبٌ لا يظهر إلّا في القيمة الناتجة.
#   ② «عُدّ_الأصفار_البادئة» **لا** تقرأ وجهتها، فلا تُكرَّر: «clz x0, x1».
#      فالحقلان يفترقان في الشكل المُصدَر، والاختبار يقيس الفرق لا وجودَ الاسم.
#
# ٠xFF ثمّ مسح البتّات الأربع الدنيا (٠xF) ⇒ ٠xF0 = ٢٤٠.
# وعدّ الأصفار البادئة في ٢٤٠ على سجلّ ٦٤-بت = ٦٤ − ٨ = ٥٦.
# والمطبوع ٦٤ − ٥٦ = ٨، أي عدد البتّات المعنويّة — قيمة تتغيّر إن اختلّ أيٌّ منهما.
# ⚠️ وكتلتان لا كتلة: م١ تدعم متغيّر خرج واحدًا لكلّ كتلة (SEM028)، وهاتان
#    تكتبان متغيّرين. فالفصل شرط اللغة لا تفضيلًا في الصياغة — وقد قِيس بأن
#    أخفقت الكتلة الواحدة على ماك arm64 بـSEM028 قبل الفصل.
دالة احسب_البتّات_المعنويّة()
    متغير قيمة = 255
    متغير قناع = 15
    متغير أصفار = 0
    تجميع
        امسح_بتّات {قيمة}، {قناع}
    نهاية
    تجميع
        عُدّ_الأصفار_البادئة {أصفار}، {قيمة}
    نهاية
    ارجع 64 - أصفار
نهاية

اطبع_سطر(احسب_البتّات_المعنويّة())
