# @rule: gr.adv.set_comprehension
# @description: استيعاب مجموعة — «{لكل س في مصدر أنتج تعبير}» يزيل التكرار (ترتيب عربيّ، RFC 25 م1ب)
# @priority: P1
# @requires: اطبع_سطر، طول
# @expected: 3

# (AR) تكافؤ مزدوج: الخلفيّة تبني المجموعة كمصفوفة فريدة عبر أوكواد ARRAY_* + مسح إزالة تكرار.
متغير م = {لكل س في [1، 2، 2، 3] أنتج س}
اطبع_سطر(طول(م))
