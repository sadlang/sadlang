متغير نجاح = 0
متغير فشل = 0

# === دالة مساعدة للاختبار ===
دالة تأكد_مساوي(الاسم، الفعلي، المتوقع)
    إذا (لنص(الفعلي) == لنص(المتوقع))
        اطبع_سطر("✅ " + الاسم)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("❌ " + الاسم + " — المتوقع: " + لنص(المتوقع) + "، الفعلي: " + لنص(الفعلي))
        فشل = فشل + 1
    نهاية
نهاية

