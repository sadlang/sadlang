# === اختبار 5: دالة مع نطاقات متداخلة ===
دالة فيبوناتشي(ن)
   إذا (ن <= 0)
      ارجع 0
   نهاية
   إذا (ن == 1)
      ارجع 1
   نهاية
   ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

اطبع_سطر("فيبوناتشي(10): " + فيبوناتشي(10))

