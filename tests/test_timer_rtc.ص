# ═══ PIT — المؤقت القابل للبرمجة ═══

# 1. تهيئة PIT
متغير pit = timer_pit_init(1000)
تحقق("تهيئة PIT بتردد 1000Hz", pit == 0)

# 2. قراءة تردد PIT
متغير تردد = timer_pit_freq()
تحقق("تردد PIT = 1000", تردد == 1000)

# 3. عداد PIT
متغير عداد = timer_pit_count()
تحقق("عداد PIT >= 0", عداد >= 0)

# 4. تغيير تردد PIT
متغير تغيير = timer_pit_set_freq(500)
تحقق("تغيير تردد PIT إلى 500Hz", تغيير == 0)

# 5. PIT مفعل
متغير مفعل = timer_pit_enabled()
تحقق("PIT مفعل", مفعل == 1)

# ═══ RTC — ساعة الوقت الحقيقي ═══

# 6. قراءة الثواني
متغير ثواني = timer_rtc_seconds()
تحقق("ثواني RTC بين 0 و 59", ثواني >= 0 && ثواني <= 59)

# 7. قراءة الدقائق
متغير دقائق = timer_rtc_minutes()
تحقق("دقائق RTC بين 0 و 59", دقائق >= 0 && دقائق <= 59)

# 8. قراءة الساعات
متغير ساعات = timer_rtc_hours()
تحقق("ساعات RTC بين 0 و 23", ساعات >= 0 && ساعات <= 23)

# 9. قراءة اليوم
متغير يوم = timer_rtc_day()
تحقق("يوم RTC بين 1 و 31", يوم >= 1 && يوم <= 31)

# 10. قراءة الشهر
متغير شهر = timer_rtc_month()
تحقق("شهر RTC بين 1 و 12", شهر >= 1 && شهر <= 12)

# 11. قراءة السنة
متغير سنة = timer_rtc_year()
تحقق("سنة RTC >= 2020", سنة >= 2020)

# 12. نص الوقت
متغير وقت = timer_rtc_time()
تحقق("نص الوقت ليس فارغ", وقت != "")

# 13. نص التاريخ
متغير تاريخ = timer_rtc_date()
تحقق("نص التاريخ ليس فارغ", تاريخ != "")

# 14. قراءة RTC كاملة
متغير rtc_full = timer_rtc_read()
تحقق("قراءة RTC كاملة ليست فارغة", rtc_full != "")

# 15. تعيين المنبه
متغير منبه = timer_rtc_alarm(7, 30, 0)
تحقق("تعيين المنبه 07:30:00", منبه == 0)

# ═══ مؤقت النظام ═══

# 16. نبضات النظام
متغير نبضات = timer_ticks()
تحقق("نبضات النظام >= 0", نبضات >= 0)

# 17. وقت التشغيل بالملي
متغير تشغيل = timer_uptime_ms()
تحقق("وقت التشغيل بالملي >= 0", تشغيل >= 0)

# 18. وقت التشغيل بالثواني
متغير تشغيل_ث = timer_uptime_sec()
تحقق("وقت التشغيل بالثواني >= 0", تشغيل_ث >= 0)

# 19. معدل النبضات
متغير معدل = timer_tick_rate()
تحقق("معدل النبضات > 0", معدل > 0)

# 20. تغيير معدل النبضات
متغير تغيير_معدل = timer_set_tick_rate(500)
تحقق("تغيير معدل النبضات إلى 500", تغيير_معدل == 0)

# 21. نقرة مؤقت
timer_tick()
متغير نبض_بعد = timer_ticks()
تحقق("نقرة مؤقت تزيد العداد", نبض_بعد > 0)

# 22. سكون قصير
متغير سكون = timer_sleep(1)
تحقق("سكون 1ms ناجح", سكون == 0)

# ═══ ساعة الإيقاف ═══

# 23. إنشاء ساعة إيقاف
متغير sw_id = timer_sw_create()
تحقق("إنشاء ساعة إيقاف", sw_id >= 0)

# 24. بدء ساعة الإيقاف
متغير بدء = timer_sw_start(sw_id)
تحقق("بدء ساعة الإيقاف", بدء == 0)

# 25. هل تعمل
متغير تعمل = timer_sw_running(sw_id)
تحقق("ساعة الإيقاف تعمل", تعمل == 1)

# 26. إيقاف ساعة الإيقاف
متغير إيقاف = timer_sw_stop(sw_id)
تحقق("إيقاف ساعة الإيقاف", إيقاف == 0)

# 27. لم تعد تعمل
متغير لا_تعمل = timer_sw_running(sw_id)
تحقق("ساعة الإيقاف لم تعد تعمل", لا_تعمل == 0)

# 28. قراءة الوقت المنقضي
متغير ملي = timer_sw_ms(sw_id)
تحقق("الوقت المنقضي >= 0", ملي >= 0)

# 29. إعادة تعيين ساعة الإيقاف
متغير صفر = timer_sw_reset(sw_id)
تحقق("إعادة تعيين ساعة الإيقاف", صفر == 0)

# 30. تقرير المؤقتات
متغير تقرير = timer_report()
تحقق("تقرير المؤقتات ليس فارغ", تقرير != "")

اطبع_سطر("")
اطبع_سطر("=== النتيجة: " + نجاح + " نجاح، " + فشل + " فشل من 30 ===")
