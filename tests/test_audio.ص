متغير نجاح = 0
متغير فشل = 0

دالة تحقق(الاسم، الشرط)
    إذا (الشرط)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم)
    نهاية
نهاية

اطبع_سطر("=== اختبارات وحدة الصوت (Audio) ===")
اطبع_سطر("")

# 1. مسح الأجهزة
متغير عدد_مسح = audio_scan()
تحقق("مسح الأجهزة يعيد عدد > 0", عدد_مسح > 0)

# 2. عدد الأجهزة
متغير عدد = audio_device_count()
تحقق("عدد الأجهزة == 3", عدد == 3)

# 3. موديل الجهاز 0
متغير موديل = audio_device_model(0)
تحقق("موديل الجهاز 0 ليس فارغ", موديل != "")

# 4. نوع الجهاز 0 = HDA (2)
متغير نوع_جهاز = audio_device_type(0)
تحقق("نوع الجهاز 0 = HDA", نوع_جهاز == 2)

# 5. تهيئة الجهاز
متغير تهيئة = audio_init(0)
تحقق("تهيئة الجهاز ناجحة", تهيئة == 0)

# 6. تقرير الصوت
متغير تقرير = audio_report()
تحقق("تقرير الصوت ليس فارغ", تقرير != "")

# 7. تشغيل نغمة
متغير نغمة = audio_play_tone(0, 440, 100)
تحقق("تشغيل نغمة 440Hz ناجح", نغمة == 0)

# 8. هل يعمل
متغير يعمل = audio_is_playing(0)
تحقق("الجهاز يعمل بعد التشغيل", يعمل == 1)

# 9. إيقاف مؤقت
متغير توقف_م = audio_pause(0)
تحقق("إيقاف مؤقت ناجح", توقف_م == 0)

# 10. استئناف
متغير نتيجة_استئناف = audio_resume(0)
تحقق("استئناف التشغيل ناجح", نتيجة_استئناف == 0)

# 11. صمت
متغير صمت = audio_silence(0, 50)
تحقق("تشغيل صمت ناجح", صمت == 0)

# 12. إيقاف
متغير ر_ايقاف = audio_stop(0)
تحقق("إيقاف التشغيل ناجح", ر_ايقاف == 0)

# 13. تأكيد التوقف
متغير ر_توقف = audio_is_playing(0)
تحقق("الجهاز متوقف بعد الإيقاف", ر_توقف == 0)

# 14. تعيين مستوى الصوت
متغير ر_مستوى = audio_set_volume(0, 75)
تحقق("تعيين مستوى الصوت 75 ناجح", ر_مستوى == 0)

# 15. قراءة مستوى الصوت
متغير ر_حجم = audio_get_volume(0)
تحقق("مستوى الصوت = 75", ر_حجم == 75)

# 16. كتم الصوت
متغير ر_كتم = audio_mute(0, 1)
تحقق("كتم الصوت ناجح", ر_كتم == 0)

# 17. هل مكتوم
متغير ر_مكتوم = audio_is_muted(0)
تحقق("الصوت مكتوم", ر_مكتوم == 1)

# 18. إلغاء الكتم
متغير ر_الغاء = audio_mute(0, 0)
تحقق("إلغاء الكتم ناجح", ر_الغاء == 0)

# 19. تعيين الميزان
متغير ر_ميزان = audio_set_balance(0, -25)
تحقق("تعيين الميزان -25 ناجح", ر_ميزان == 0)

# 20. بدء تسجيل
متغير ر_بدء_تسجيل = audio_start_record(0)
تحقق("بدء تسجيل ناجح", ر_بدء_تسجيل == 0)

# 21. هل يسجل
متغير ر_يسجل = audio_is_recording(0)
تحقق("الجهاز يسجل", ر_يسجل == 1)

# 22. إنهاء تسجيل
متغير ر_انهاء = audio_stop_record(0)
تحقق("إنهاء التسجيل ناجح", ر_انهاء == 0)

# 23. عينات مسجلة
متغير ر_عينات = audio_recorded_samples(0)
تحقق("عدد العينات المسجلة > 0", ر_عينات > 0)

# 24. صافرة PC Speaker
متغير ر_صفارة = audio_beep(1000, 200)
تحقق("صافرة PC Speaker ناجحة", ر_صفارة == 0)

# 25. إيقاف صافرة
متغير ر_ايقاف_ص = audio_beep_off()
تحقق("إيقاف الصافرة ناجح", ر_ايقاف_ص == 0)

# 26. تعيين معدل العينات
متغير ر_معدل = audio_set_sample_rate(0, 48000)
تحقق("تعيين معدل العينات 48000 ناجح", ر_معدل == 0)

# 27. قراءة معدل العينات
متغير ر_معدل_ق = audio_get_sample_rate(0)
تحقق("معدل العينات = 48000", ر_معدل_ق == 48000)

# 28. تعيين القنوات
متغير ر_قنوات = audio_set_channels(0, 2)
تحقق("تعيين القنوات 2 ناجح", ر_قنوات == 0)

# 29. قراءة البتات
متغير ر_بتات = audio_get_bits(0)
تحقق("بتات العينة = 16", ر_بتات == 16)

# 30. إعادة تعيين
audio_reset()
متغير ر_بعد = audio_device_count()
تحقق("إعادة التعيين تعمل", ر_بعد == 0)

اطبع_سطر("")
اطبع_سطر("=== النتيجة: " + نجاح + " نجاح، " + فشل + " فشل من 30 ===")
