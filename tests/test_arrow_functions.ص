# اختبار الدوال السهمية (Arrow Functions)
# Test arrow functions

# اختبار 1: دالة سهمية بمعامل واحد بدون أقواس
متغير مضاعفة = س => س * 2
اطبع_سطر("1. مضاعفة(5) = " + مضاعفة(5))

# اختبار 2: دالة سهمية بدون معاملات
متغير الثابتة = () => 42
اطبع_سطر("2. الثابتة() = " + الثابتة())

# اختبار 3: دالة سهمية بمعاملين
متغير جمع = (أ، ب) => أ + ب
اطبع_سطر("3. جمع(3, 7) = " + جمع(3، 7))

# اختبار 4: دالة سهمية بمعامل واحد بين أقواس
متغير تربيع = (ن) => ن * ن
اطبع_سطر("4. تربيع(6) = " + تربيع(6))

# اختبار 5: تمرير دالة سهمية كمتغير
دالة طبق(د، قيمة)
   ارجع د(قيمة)
نهاية
متغير نتيجة = طبق(س => س + 10، 5)
اطبع_سطر("5. طبق(س => س + 10، 5) = " + نتيجة)
