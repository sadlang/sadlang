# ═══════════════════════════════════════════════════════════════════════
# ملف اختبار شامل لنظام الأنواع المعممة (القوالب / Generics) في لغة ص
# ═══════════════════════════════════════════════════════════════════════
# يغطي هذا الملف:
#   1. دوال القوالب (Template Functions)
#   2. أصناف القوالب مع خاصية واحدة (Template Classes)
#   3. أصناف القوالب مع خصائص ومعاملات متعددة
#   4. أصناف القوالب بأكثر من معامل نوع (Multi-Type)
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# 1. دوال القوالب
# ─────────────────────────────────────────
قالب<نوع ت> دالة هوية(قيمة)
    ارجع قيمة
نهاية

قالب<نوع ت> دالة مضاعفة(قيمة)
    ارجع قيمة + قيمة
نهاية

اطبع("=== 1. دوال القوالب ===")
اطبع(هوية<رقم>(42))
اطبع(هوية<نص>("مرحبا"))
اطبع(مضاعفة<رقم>(21))
اطبع(مضاعفة<نص>("ها"))

# ─────────────────────────────────────────
# 2. صنف قالب بسيط - صندوق (Box)
# ─────────────────────────────────────────
قالب<نوع ت> صنف صندوق
    خاصية ت محتوى
    باني(قيمة)
        محتوى = قيمة
    نهاية
    دالة جلب()
        ارجع محتوى
    نهاية
    دالة وضع(قيمة_جديدة)
        محتوى = قيمة_جديدة
    نهاية
نهاية

اطبع("=== 2. صندوق (Box) ===")
متغير ص_رقم = جديد صندوق<رقم>(100)
اطبع("صندوق رقم: " + ص_رقم.جلب())
ص_رقم.وضع(200)
اطبع("بعد التغيير: " + ص_رقم.جلب())

متغير ص_نص = جديد صندوق<نص>("أهلاً بالعربية")
اطبع("صندوق نص: " + ص_نص.جلب())

# ─────────────────────────────────────────
# 3. صنف قالب - حاوية بخاصيتين
# ─────────────────────────────────────────
قالب<نوع ت> صنف حاوية
    خاصية ت قيمة_اولى
    خاصية ت قيمة_ثانية
    باني(أ، ب)
        قيمة_اولى = أ
        قيمة_ثانية = ب
    نهاية
    دالة المجموع()
        ارجع قيمة_اولى + قيمة_ثانية
    نهاية
    دالة تبديل()
        متغير مؤقت = قيمة_اولى
        قيمة_اولى = قيمة_ثانية
        قيمة_ثانية = مؤقت
    نهاية
    دالة عرض()
        اطبع("(" + قيمة_اولى + "، " + قيمة_ثانية + ")")
    نهاية
نهاية

اطبع("=== 3. حاوية (Container) ===")
متغير ح = جديد حاوية<رقم>(10، 20)
ح.عرض()
اطبع("المجموع: " + ح.المجموع())
ح.تبديل()
ح.عرض()

# ─────────────────────────────────────────
# 4. صنف قالب بمعاملَي نوع - زوج (Pair)
# ─────────────────────────────────────────
قالب<نوع م، نوع ق> صنف زوج
    خاصية م مفتاح
    خاصية ق قيمة
    باني(م_جديد، ق_جديد)
        مفتاح = م_جديد
        قيمة = ق_جديد
    نهاية
    دالة جلب_المفتاح()
        ارجع مفتاح
    نهاية
    دالة جلب_القيمة()
        ارجع قيمة
    نهاية
    دالة عرض()
        اطبع(مفتاح + ": " + قيمة)
    نهاية
نهاية

اطبع("=== 4. زوج (Pair) ===")
متغير ز1 = جديد زوج<نص، رقم>("العمر"، 25)
ز1.عرض()
متغير ز2 = جديد زوج<نص، نص>("الاسم"، "أحمد")
ز2.عرض()

اطبع("=== الاختبار اكتمل بنجاح ===")
