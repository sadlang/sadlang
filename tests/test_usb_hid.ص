# استيراد وحدة USB/HID
من usb استورد *

متغير نجاح = 0
متغير فشل = 0
متغير إجمالي = 0

دالة اختبار(رقم_الاختبار، وصف، شرط)
    إجمالي = إجمالي + 1
    إذا (شرط)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + رقم_الاختبار + " " + وصف)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + رقم_الاختبار + " " + وصف)
    نهاية
نهاية

اطبع_سطر("╔═══════════════════════════════════════════════════════════════╗")
اطبع_سطر("║   اختبارات USB/HID — لوحة مفاتيح وفأرة                     ║")
