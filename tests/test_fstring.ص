# اختبار النصوص المنسقة (F-String) الكاملة

# 1. متغير بسيط
متغير الاسم = "أحمد"
اطبع_سطر(م"مرحبا {الاسم}!")

# 2. تعبير حسابي
متغير س = 10
متغير ع = 5
اطبع_سطر(م"المجموع: {س + ع}")

# 3. استدعاء دالة
دالة مربع(ق)
    ارجع ق * ق
نهاية
اطبع_سطر(م"مربع 7: {مربع(7)}")

# 4. عدة تعبيرات في نص واحد
متغير أ = 3
متغير ب = 4
اطبع_سطر(م"{أ} + {ب} = {أ + ب}")

# 5. تعبير مقارنة
اطبع_سطر(م"10 > 5: {10 > 5}")

# 6. نص بدون تعبيرات
اطبع_سطر(م"نص عادي بدون تعبيرات")

# 7. أقواس مُتجاوزة
اطبع_سطر(م"قوس: {{مُتجاوز}}")
