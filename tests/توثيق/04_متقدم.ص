# === للحلقة مع تكرار  ===
متغير مجموع = 0
لكل ر في [1، 2، 3، 4، 5]
   مجموع += ر
نهاية
اطبع_سطر("مجموع 1-5: " + مجموع)

# === تحقق من ثابت ===
ثابت حد_أقصى = 100
اطبع_سطر("الحد الأقصى: " + حد_أقصى)

# === تداخل الشروط ===
دالة تصنيف(س)
   إذا (س > 0)
      إذا (س > 100)
         ارجع "كبير جداً"
      وإلا
         ارجع "موجب"
      نهاية
   وإلا إذا (س == 0)
      ارجع "صفر"
   وإلا
      ارجع "سالب"
   نهاية
نهاية

اطبع_سطر(تصنيف(50))
اطبع_سطر(تصنيف(200))
اطبع_سطر(تصنيف(0))
اطبع_سطر(تصنيف(-5))

# === try/catch مع أخيراً ===
حاول
   ارمي "خطأ مخصص!"
امسك (خ)
   اطبع_سطر("تم مسك: " + خ)
أخيراً
   اطبع_سطر("أخيراً تم تنفيذه")
نهاية

