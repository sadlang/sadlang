# اختبار الميزات المتقدمة

# === لامدا ===
متغير مضاعف = لامدا س: س * 2
اطبع_سطر("لامدا: " + مضاعف(21))

# === لامدا بمعاملين ===
متغير حاسبة = لامدا أ، ب: أ + ب
اطبع_سطر("لامدا بمعاملين: " + حاسبة(10، 20))

# === تمرير دالة كمعامل ===
دالة طبق(دالة_م، قيمة)
   ارجع دالة_م(قيمة)
نهاية

متغير ثلاثة_أضعاف = لامدا س: س * 3
اطبع_سطر("دالة عليا: " + طبق(ثلاثة_أضعاف، 15))

# === مطابقة الأنماط ===
دالة وصف_عدد(ن)
   طابق (ن)
      عندما 0:
         ارجع "صفر"
      عندما 1:
         ارجع "واحد"
      عندما 2:
         ارجع "اثنان"
      افتراضي:
         ارجع "عدد آخر: " + ن
   نهاية
نهاية

اطبع_سطر(وصف_عدد(0))
اطبع_سطر(وصف_عدد(1))
اطبع_سطر(وصف_عدد(2))
اطبع_سطر(وصف_عدد(99))

