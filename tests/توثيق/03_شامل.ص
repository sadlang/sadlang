# اختبار شامل: الشروط والحلقات والدوال والأصناف

# === الشروط ===
متغير عمر = 20
إذا (عمر >= 18)
   اطبع_سطر("بالغ")
وإلا
   اطبع_سطر("قاصر")
نهاية

# شروط متداخلة
متغير درجة = 85
إذا (درجة >= 90)
   اطبع_سطر("ممتاز")
وإلا إذا (درجة >= 80)
   اطبع_سطر("جيد جداً")
وإلا إذا (درجة >= 70)
   اطبع_سطر("جيد")
وإلا
   اطبع_سطر("مقبول")
نهاية

# === حلقة بينما ===
متغير عداد = 1
بينما (عداد <= 5)
   اطبع("بينما:" + عداد + " ")
   عداد += 1
نهاية
اطبع_سطر("")

# === حلقة لكل ===
لكل عنصر في [10، 20، 30]
   اطبع("لكل:" + عنصر + " ")
نهاية
اطبع_سطر("")

# === لكل مع نص ===
لكل حرف في "مرحبا"
   اطبع(حرف + "-")
نهاية
اطبع_سطر("")

# === توقف واستمر ===
لكل ر في [1، 2، 3، 4، 5، 6، 7، 8]
   إذا (ر == 3)
      استمر
   نهاية
   إذا (ر == 7)
      توقف
   نهاية
   اطبع(ر)
نهاية
اطبع_سطر("")

# === الدوال ===
دالة مرحبا(اسم)
   ارجع "مرحباً يا " + اسم
نهاية

اطبع_سطر(مرحبا("أحمد"))

# دالة مع قيم افتراضية
دالة تحية(اسم، لغة = "عربية")
   ارجع "مرحباً " + اسم + " بـ" + لغة
نهاية
اطبع_سطر(تحية("سعد"))
اطبع_سطر(تحية("سعد"، "إنجليزية"))

# دالة عودية (فاكتوريال)
دالة ضرب_متتالي(ن)
   إذا (ن <= 1)
      ارجع 1
   نهاية
   ارجع ن * ضرب_متتالي(ن - 1)
نهاية
اطبع_سطر("5! = " + ضرب_متتالي(5))

# === الأصناف ===
صنف حيوان
   باني(اسم، نوع)
      هذا.اسم = اسم
      هذا.نوع = نوع
   نهاية

   دالة صوت()
      ارجع هذا.اسم + " يصدر صوتاً"
   نهاية

   دالة وصف()
      ارجع "حيوان: " + هذا.اسم + " - " + هذا.نوع
   نهاية
نهاية

متغير قطة = جديد حيوان("ميمي"، "قطة")
اطبع_سطر(قطة.صوت())
اطبع_سطر(قطة.وصف())

# === الوراثة ===
صنف كلب يرث حيوان
   باني(اسم)
      الأساس(اسم، "كلب")
   نهاية

   دالة صوت()
      ارجع هذا.اسم + " ينبح: هاو!"
   نهاية
نهاية

متغير كلبي = جديد كلب("ريكس")
اطبع_سطر(كلبي.صوت())
اطبع_سطر(كلبي.وصف())

# === معالجة الأخطاء ===
حاول
   متغير نتيجة = 10 / 0
   اطبع_سطر("النتيجة: " + نتيجة)
امسك (خ)
   اطبع_سطر("خطأ: " + خ)
نهاية

