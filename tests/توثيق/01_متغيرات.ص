# اختبار المتغيرات والثوابت

# === متغير عادي ===
متغير س = 42
اطبع_سطر("متغير عادي: " + س)

# === متغير بتحديد نوع ===
متغير ص: رقم = 100
اطبع_سطر("متغير منوع: " + ص)

# === ثابت ===
ثابت ط = 3.14
اطبع_سطر("ثابت: " + ط)

# === متغير نصي ===
متغير اسم = "لغة ص"
اطبع_سطر("نص: " + اسم)

# === متغير منطقي ===
متغير نشط = صحيح
اطبع_سطر("منطقي: " + نشط)

# === لاشيء ===
متغير فارغ = لاشيء
اطبع_سطر("لاشيء: " + فارغ)

# === عمليات إسناد مركبة ===
متغير عدد = 10
عدد += 5
اطبع_سطر("بعد +=: " + عدد)
عدد -= 3
اطبع_سطر("بعد -=: " + عدد)
عدد *= 2
اطبع_سطر("بعد *=: " + عدد)
عدد /= 4
اطبع_سطر("بعد /=: " + عدد)
# عدد %= 5  -- غير مدعوم حالياً
# اطبع_سطر("بعد %=: " + عدد)

# === مصفوفة ===
متغير قائمة = [1، 2، 3، 4، 5]
اطبع_سطر("مصفوفة: " + قائمة)

# === خريطة ===
متغير بيانات = {"اسم": "أحمد"، "عمر": 30}
اطبع_سطر("خريطة: " + بيانات)

اطبع_سطر("=== انتهى اختبار المتغيرات ===")
