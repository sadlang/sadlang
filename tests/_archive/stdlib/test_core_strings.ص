# اختبارات وحدة النواة — دوال النصوص
# Core Module Tests — String Functions
# كتبته: ريم — Sprint 1

استورد نصوص

اطبع_سطر("╔═══════════════════════════════════════════╗")
اطبع_سطر("║  اختبارات دوال النصوص — لغة ص             ║")
اطبع_سطر("╚═══════════════════════════════════════════╝")

متغير نجاح = 0
متغير فشل = 0

دالة تأكد_مساوي(الاسم، الفعلي، المتوقع)
    إذا (نص(الفعلي) == نص(المتوقع))
        اطبع_سطر("✅ " + الاسم)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("❌ " + الاسم + " — المتوقع: " + نص(المتوقع) + "، الفعلي: " + نص(الفعلي))
        فشل = فشل + 1
    نهاية
نهاية

# ═══════════════════════════════════════════════
# 1. اختبارات طول النص
# ═══════════════════════════════════════════════
اطبع_سطر("\n--- طول النص ---")

تأكد_مساوي("طول نص إنجليزي"، الطول("Hello")، 5)
تأكد_مساوي("طول نص فارغ"، الطول("")، 0)
تأكد_مساوي("طول حرف واحد"، الطول("أ")، 1)
تأكد_مساوي("طول نص أرقام"، الطول("12345")، 5)

# ═══════════════════════════════════════════════
# 2. اختبارات تحويل الحالة
# ═══════════════════════════════════════════════
اطبع_سطر("\n--- تحويل الحالة ---")

تأكد_مساوي("كبير hello"، أحرف_كبيرة("hello")، "HELLO")
تأكد_مساوي("كبير HELLO"، أحرف_كبيرة("HELLO")، "HELLO")
تأكد_مساوي("كبير مختلط"، أحرف_كبيرة("Hello World")، "HELLO WORLD")
تأكد_مساوي("كبير فارغ"، أحرف_كبيرة("")، "")

تأكد_مساوي("صغير HELLO"، أحرف_صغيرة("HELLO")، "hello")
تأكد_مساوي("صغير hello"، أحرف_صغيرة("hello")، "hello")
تأكد_مساوي("صغير مختلط"، أحرف_صغيرة("Hello World")، "hello world")
تأكد_مساوي("صغير فارغ"، أحرف_صغيرة("")، "")

# ═══════════════════════════════════════════════
# 3. اختبارات التقسيم
# ═══════════════════════════════════════════════
اطبع_سطر("\n--- التقسيم ---")

متغير أجزاء1 = قسم("أ,ب,ج"، ",")
تأكد_مساوي("تقسيم بفاصلة — عدد"، الطول(أجزاء1)، 3)
تأكد_مساوي("تقسيم بفاصلة — أول"، أجزاء1[0]، "أ")
تأكد_مساوي("تقسيم بفاصلة — ثاني"، أجزاء1[1]، "ب")
تأكد_مساوي("تقسيم بفاصلة — ثالث"، أجزاء1[2]، "ج")

متغير أجزاء2 = قسم("مرحبا بالعالم"، " ")
تأكد_مساوي("تقسيم بمسافة — عدد"، الطول(أجزاء2)، 2)
تأكد_مساوي("تقسيم بمسافة — أول"، أجزاء2[0]، "مرحبا")
تأكد_مساوي("تقسيم بمسافة — ثاني"، أجزاء2[1]، "بالعالم")

# ═══════════════════════════════════════════════
# 4. اختبارات الدمج
# ═══════════════════════════════════════════════
اطبع_سطر("\n--- الدمج ---")

تأكد_مساوي("دمج بشرطة"، دمج(["أ"، "ب"، "ج"]، "-")، "أ-ب-ج")
تأكد_مساوي("دمج بفاصلة"، دمج(["1"، "2"، "3"]، ",")، "1,2,3")
تأكد_مساوي("دمج بمسافة"، دمج(["مرحبا"، "بالعالم"]، " ")، "مرحبا بالعالم")

# ═══════════════════════════════════════════════
# 5. اختبارات ضم النصوص (concatenation)
# ═══════════════════════════════════════════════
اطبع_سطر("\n--- ضم النصوص ---")

تأكد_مساوي("ضم نصين"، "مرحبا" + " " + "العالم"، "مرحبا العالم")
تأكد_مساوي("ضم نص ورقم"، "العدد: " + نص(42)، "العدد: 42")
تأكد_مساوي("ضم فارغ"، "" + "مرحبا"، "مرحبا")
تأكد_مساوي("ضم فارغين"، "" + ""، "")

# ═══════════════════════════════════════════════
# 6. اختبارات المقارنة النصية
# ═══════════════════════════════════════════════
اطبع_سطر("\n--- المقارنة النصية ---")

تأكد_مساوي("نصان متساويان"، "مرحبا" == "مرحبا"، صحيح)
تأكد_مساوي("نصان مختلفان"، "مرحبا" == "أهلا"، خطأ)
تأكد_مساوي("نص وفارغ"، "مرحبا" == ""، خطأ)
تأكد_مساوي("فارغ وفارغ"، "" == ""، صحيح)
تأكد_مساوي("عدم تساوي"، "أ" != "ب"، صحيح)

# ═══════════════════════════════════════════════
# 7. اختبارات تحويل الأنواع
# ═══════════════════════════════════════════════
اطبع_سطر("\n--- تحويل الأنواع ---")

تأكد_مساوي("لنص من رقم"، نص(42)، "42")
تأكد_مساوي("لنص من صفر"، نص(0)، "0")
تأكد_مساوي("لنص من سالب"، نص(-5)، "-5")
تأكد_مساوي("لرقم من نص"، رقم("123")، 123)
تأكد_مساوي("لرقم من نص سالب"، رقم("-42")، -42)

