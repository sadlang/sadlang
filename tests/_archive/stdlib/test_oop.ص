# اختبارات البرمجة الكائنية (OOP)
# Object-Oriented Programming Tests
# كتبته: ريم — Sprint 1

اطبع_سطر("═══ اختبارات البرمجة الكائنية ═══")

متغير نجاح = 0
متغير فشل = 0
متغير إجمالي = 0

دالة تأكد(الاسم، الفعلي، المتوقع)
    إجمالي = إجمالي + 1
    إذا (نص(الفعلي) == نص(المتوقع))
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("  ❌ " + الاسم + " | متوقع: " + نص(المتوقع) + " | فعلي: " + نص(الفعلي))
        فشل = فشل + 1
    نهاية
نهاية

# ═══ 1: صنف بسيط ═══
اطبع_سطر("\n🏗️ صنف بسيط")

صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة المسافة()
        ارجع جذر(هذا.س ** 2 + هذا.ص ** 2)
    نهاية

    دالة تمثيل()
        ارجع "(" + نص(هذا.س) + "، " + نص(هذا.ص) + ")"
    نهاية
نهاية

متغير ن1 = جديد نقطة(3، 4)
تأكد("نقطة.س"، ن1.س، 3)
تأكد("نقطة.ص"، ن1.ص، 4)
تأكد("نقطة.المسافة()"، ن1.المسافة()، 5)
تأكد("نقطة.تمثيل()"، ن1.تمثيل()، "(3، 4)")

# ═══ 2: صنف مع حالة ═══
اطبع_سطر("🔢 صنف عدّاد")

صنف عدّاد
    باني()
        هذا.قيمة = 0
    نهاية

    دالة زد()
        هذا.قيمة = هذا.قيمة + 1
    نهاية

    دالة أنقص()
        هذا.قيمة = هذا.قيمة - 1
    نهاية

    دالة القيمة()
        ارجع هذا.قيمة
    نهاية
نهاية

متغير ع = جديد عدّاد()
تأكد("عدّاد ابتدائي"، ع.القيمة()، 0)
ع.زد()
ع.زد()
ع.زد()
تأكد("عدّاد بعد 3 زيادات"، ع.القيمة()، 3)
ع.أنقص()
تأكد("عدّاد بعد إنقاص"، ع.القيمة()، 2)

# ═══ 3: صنف مع عداد مركب ═══
اطبع_سطر("📦 صنف رصيد")

صنف رصيد
    باني(مبلغ_ابتدائي)
        هذا.مبلغ = مبلغ_ابتدائي
    نهاية

    دالة إيداع(قيمة_إيداع)
        هذا.مبلغ = هذا.مبلغ + قيمة_إيداع
    نهاية

    دالة سحب(قيمة_سحب)
        هذا.مبلغ = هذا.مبلغ - قيمة_سحب
    نهاية

    دالة الرصيد()
        ارجع هذا.مبلغ
    نهاية
نهاية

متغير ح = جديد رصيد(100)
تأكد("رصيد ابتدائي"، ح.الرصيد()، 100)
ح.إيداع(50)
تأكد("رصيد بعد إيداع"، ح.الرصيد()، 150)
ح.سحب(30)
تأكد("رصيد بعد سحب"، ح.الرصيد()، 120)

# ═══ 4: وراثة ═══
اطبع_سطر("🔗 الوراثة")

صنف شكل
    باني(اسم)
        هذا.اسم = اسم
    نهاية

    دالة وصف()
        ارجع "شكل: " + هذا.اسم
    نهاية
نهاية

صنف مستطيل يرث شكل
    باني(عرض، ارتفاع)
        الأساس("مستطيل")
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية

    دالة المساحة()
        ارجع هذا.عرض * هذا.ارتفاع
    نهاية

    دالة المحيط()
        ارجع 2 * (هذا.عرض + هذا.ارتفاع)
    نهاية
نهاية

متغير مس = جديد مستطيل(5، 3)
تأكد("مستطيل.اسم (وراثة)"، مس.اسم، "مستطيل")
تأكد("مستطيل.عرض"، مس.عرض، 5)
تأكد("مستطيل.ارتفاع"، مس.ارتفاع، 3)
تأكد("مستطيل.المساحة()"، مس.المساحة()، 15)
تأكد("مستطيل.المحيط()"، مس.المحيط()، 16)
تأكد("مستطيل.وصف()"، مس.وصف()، "شكل: مستطيل")

