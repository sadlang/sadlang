# اختبارات التحقق من الأنواع والتحويل
# Type Checking and Conversion Tests
# كتبته: ريم — Sprint 1

استورد رياضيات

اطبع_سطر("═══ اختبارات الأنواع والتحويل ═══")

متغير نجاح = 0
متغير فشل = 0
متغير إجمالي = 0

دالة تأكد(الاسم، الفعلي، المتوقع)
    إجمالي = إجمالي + 1
    إذا (نص(الفعلي) == نص(المتوقع))
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("  ❌ " + الاسم + " | متوقع: " + نص(المتوقع) + " | فعلي: " + نص(الفعلي))
        فشل = فشل + 1
    نهاية
نهاية

# ═══ 1: نوع القيمة ═══
اطبع_سطر("\n🔍 التحقق من نوع القيمة")

تأكد("نوع_القيمة(42)"، نوع_القيمة(42)، "رقم")
تأكد("نوع_القيمة(\"مرحبا\")"، نوع_القيمة("مرحبا")، "نص")
تأكد("نوع_القيمة(صحيح)"، نوع_القيمة(صحيح)، "منطقي")
تأكد("نوع_القيمة(خطأ)"، نوع_القيمة(خطأ)، "منطقي")

متغير م = [1، 2، 3]
تأكد("نوع_القيمة(مصفوفة)"، نوع_القيمة(م)، "مصفوفة")

تأكد("نوع_القيمة(لاشيء)"، نوع_القيمة(لاشيء)، "فراغ")

# ═══ 2: تحويل الأنواع ═══
اطبع_سطر("🔄 تحويل الأنواع")

تأكد("رقم(\"42\")"، رقم("42")، 42)
تأكد("رقم(\"0\")"، رقم("0")، 0)
تأكد("رقم(\"-5\")"، رقم("-5")، -5)

تأكد("نص(100)"، نص(100)، "100")
تأكد("نص(صحيح)"، نص(صحيح)، "true")
تأكد("نص(خطأ)"، نص(خطأ)، "false")

# ═══ 3: العمليات الحسابية المتقدمة ═══
اطبع_سطر("📊 العمليات الحسابية المتقدمة")

تأكد("أرضية(3.7)"، أرضية(3.7)، 3)
تأكد("سقف(3.1)"، سقف(3.1)، 4)
تأكد("قوة(2، 8)"، أس(2، 8)، 256)

# ═══ النتيجة ═══
اطبع_سطر("\n═══ النتيجة ═══")
اطبع_سطر("إجمالي: " + نص(إجمالي) + " | نجح: " + نص(نجاح) + " | فشل: " + نص(فشل))

إذا (فشل == 0)
    اطبع_سطر("✅ جميع الاختبارات نجحت!")
وإلا
    اطبع_سطر("⚠️ بعض الاختبارات فشلت")
نهاية
