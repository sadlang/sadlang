# ===================================================================
# اختبار إجهاد: وراثة + سمات + عوامل + تعددية شكلية
# ===================================================================
# يختبر:
# 1. عدة أصناف بنفس أسماء العوامل (multi-class operators)
# 2. وراثة مع عوامل موروثة
# 3. سمات مع تحقيق العوامل
# 4. تمرير كائنات لدوال عامة (polymorphism)
# 5. كائنات من أصناف مختلفة في نفس السياق
# 6. سلاسل عمليات متعددة على كائنات
# ===================================================================

متغير نجاح = 0
متغير فشل = 0

دالة تحقق(الوصف، القيمة، المتوقع)
    إذا (القيمة == المتوقع)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("✗ فشل: " + الوصف + " — توقعنا: " + المتوقع + "، حصلنا: " + القيمة)
        فشل = فشل + 1
    نهاية
نهاية

# ===================================================================
# الصنف 1: نقطة (عوامل أساسية)
# ===================================================================
صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد نقطة(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل -(آخر)
        ارجع جديد نقطة(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل !=(آخر)
        ارجع هذا.س != آخر.س أو هذا.ص != آخر.ص
    نهاية

    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية

    عامل منطقي()
        ارجع هذا.س != 0 أو هذا.ص != 0
    نهاية
نهاية

# ===================================================================
# الصنف 2: نقطة_ثلاثية يرث نقطة (وراثة + عوامل إضافية)
# ===================================================================
صنف نقطة_ثلاثية يرث نقطة
    باني(س، ص، ع)
        الأساس(س، ص)
        هذا.ع = ع
    نهاية

    عامل +(آخر)
        ارجع جديد نقطة_ثلاثية(هذا.س + آخر.س، هذا.ص + آخر.ص، هذا.ع + آخر.ع)
    نهاية

    عامل -(آخر)
        ارجع جديد نقطة_ثلاثية(هذا.س - آخر.س، هذا.ص - آخر.ص، هذا.ع - آخر.ع)
    نهاية

    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص و هذا.ع == آخر.ع
    نهاية

    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + "، " + هذا.ع + ")"
    نهاية
نهاية

# ===================================================================
# الصنف 3: كسر (عوامل حسابية مختلفة)
# ===================================================================
صنف كسر
    باني(بسط، مقام)
        هذا.بسط = بسط
        هذا.مقام = مقام
    نهاية

    عامل +(آخر)
        ارجع جديد كسر(هذا.بسط * آخر.مقام + آخر.بسط * هذا.مقام، هذا.مقام * آخر.مقام)
    نهاية

    عامل -(آخر)
        ارجع جديد كسر(هذا.بسط * آخر.مقام - آخر.بسط * هذا.مقام، هذا.مقام * آخر.مقام)
    نهاية

    عامل *(آخر)
        ارجع جديد كسر(هذا.بسط * آخر.بسط، هذا.مقام * آخر.مقام)
    نهاية

    عامل ==(آخر)
        ارجع هذا.بسط * آخر.مقام == آخر.بسط * هذا.مقام
    نهاية

    عامل نص()
        ارجع هذا.بسط + "/" + هذا.مقام
    نهاية

    عامل منطقي()
        ارجع هذا.بسط != 0
    نهاية
نهاية

# ===================================================================
# الصنف 4: عداد (بسيط — نفس اسم العوامل كالآخرين)
# ===================================================================
صنف عداد
    باني(قيمة)
        هذا.قيمة = قيمة
    نهاية

    عامل +(آخر)
        ارجع جديد عداد(هذا.قيمة + آخر.قيمة)
    نهاية

    عامل -(آخر)
        ارجع جديد عداد(هذا.قيمة - آخر.قيمة)
    نهاية

    عامل ==(آخر)
        ارجع هذا.قيمة == آخر.قيمة
    نهاية

    عامل نص()
        ارجع "عداد(" + هذا.قيمة + ")"
    نهاية
نهاية

# ===================================================================
# الصنف 5: نطاق (مع عامل فهرسة)
# ===================================================================
صنف نطاق
    باني(بداية، نهاية_)
        هذا.بداية = بداية
        هذا.نهاية_ = نهاية_
    نهاية

    عامل [](فهرس)
        ارجع هذا.بداية + فهرس
    نهاية

    عامل نص()
        ارجع "[" + هذا.بداية + ".." + هذا.نهاية_ + "]"
    نهاية
نهاية

# ===================================================================
# اختبارات المجموعة 1: عوامل أساسية لكل صنف
# ===================================================================
اطبع_سطر("--- مجموعة 1: عوامل أساسية ---")

متغير ن1 = جديد نقطة(1، 2)
متغير ن2 = جديد نقطة(3، 4)
متغير ن3 = ن1 + ن2
تحقق("نقطة+", "" + ن3, "(4، 6)")

متغير ن4 = ن2 - ن1
تحقق("نقطة-", "" + ن4, "(2، 2)")

تحقق("نقطة==صحيح", ن1 == جديد نقطة(1، 2), صحيح)
تحقق("نقطة!=صحيح", ن1 != ن2, صحيح)

# ===================================================================
# اختبارات المجموعة 2: وراثة — نقطة_ثلاثية يرث نقطة
# ===================================================================
اطبع_سطر("--- مجموعة 2: وراثة ---")

متغير ث1 = جديد نقطة_ثلاثية(1، 2، 3)
متغير ث2 = جديد نقطة_ثلاثية(4، 5، 6)
متغير ث3 = ث1 + ث2
تحقق("ثلاثية+", "" + ث3, "(5، 7، 9)")

متغير ث4 = ث2 - ث1
تحقق("ثلاثية-", "" + ث4, "(3، 3، 3)")

تحقق("ثلاثية==صحيح", ث1 == جديد نقطة_ثلاثية(1، 2، 3), صحيح)

# ===================================================================
# اختبارات المجموعة 3: كسور — عمليات حسابية معقدة
# ===================================================================
اطبع_سطر("--- مجموعة 3: كسور ---")

متغير ك1 = جديد كسر(1، 2)
متغير ك2 = جديد كسر(1، 3)
متغير ك3 = ك1 + ك2
تحقق("كسر+", "" + ك3, "5/6")

متغير ك4 = ك1 - ك2
تحقق("كسر-", "" + ك4, "1/6")

متغير ك5 = ك1 * ك2
تحقق("كسر*", "" + ك5, "1/6")

تحقق("كسر==", ك1 == جديد كسر(2، 4), صحيح)

# ===================================================================
# اختبارات المجموعة 4: عدادات — تحويل نص مع أصناف متعددة
# ===================================================================
اطبع_سطر("--- مجموعة 4: عدادات ---")

متغير ع1 = جديد عداد(10)
متغير ع2 = جديد عداد(5)
متغير ع3 = ع1 + ع2
تحقق("عداد+", "" + ع3, "عداد(15)")

متغير ع4 = ع1 - ع2
تحقق("عداد-", "" + ع4, "عداد(5)")

تحقق("عداد==", ع1 == جديد عداد(10), صحيح)

# ===================================================================
# اختبارات المجموعة 5: فهرسة
# ===================================================================
اطبع_سطر("--- مجموعة 5: فهرسة ---")

متغير نط = جديد نطاق(10، 20)
تحقق("نطاق[0]", نط[0], 10)
تحقق("نطاق[5]", نط[5], 15)
تحقق("نطاق_نص", "" + نط, "[10..20]")

# ===================================================================
# اختبارات المجموعة 6: خلط أصناف في نفس السياق
# ===================================================================
اطبع_سطر("--- مجموعة 6: خلط أصناف ---")

# إنشاء كائنات من أصناف مختلفة وتحويلها لنصوص في نفس السياق
متغير نقطة_نص = "" + جديد نقطة(7، 8)
تحقق("خلط_نقطة", نقطة_نص, "(7، 8)")

متغير ثلاثية_نص = "" + جديد نقطة_ثلاثية(1، 2، 3)
تحقق("خلط_ثلاثية", ثلاثية_نص, "(1، 2، 3)")

متغير كسر_نص = "" + جديد كسر(3، 4)
تحقق("خلط_كسر", كسر_نص, "3/4")

متغير عداد_نص = "" + جديد عداد(42)
تحقق("خلط_عداد", عداد_نص, "عداد(42)")

متغير نطاق_نص = "" + جديد نطاق(0، 100)
تحقق("خلط_نطاق", نطاق_نص, "[0..100]")

# ===================================================================
# اختبارات المجموعة 7: سلاسل عمليات
# ===================================================================
اطبع_سطر("--- مجموعة 7: سلاسل عمليات ---")

# نقطة: a + b + c
متغير سلسلة_نقط = جديد نقطة(1، 1) + جديد نقطة(2، 2) + جديد نقطة(3، 3)
تحقق("سلسلة_نقط", "" + سلسلة_نقط, "(6، 6)")

# كسر: a + b + c
متغير سلسلة_كسور = جديد كسر(1، 4) + جديد كسر(1، 4) + جديد كسر(1، 4)
# 1/4 + 1/4 = 8/16، ثم 8/16 + 1/4 = 48/64
تحقق("سلسلة_كسور", "" + سلسلة_كسور, "48/64")

# عداد: a + b + c
متغير سلسلة_عدادات = جديد عداد(1) + جديد عداد(2) + جديد عداد(3)
تحقق("سلسلة_عدادات", "" + سلسلة_عدادات, "عداد(6)")

# ===================================================================
# اختبارات المجموعة 8: طباعة مباشرة لكائنات مختلفة
# ===================================================================
اطبع_سطر("--- مجموعة 8: طباعة مباشرة ---")

اطبع_سطر("نقطة: " + ن1)
اطبع_سطر("ثلاثية: " + ث1)
اطبع_سطر("كسر: " + ك1)
اطبع_سطر("عداد: " + ع1)
