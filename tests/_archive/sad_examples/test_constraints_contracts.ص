# دالة تجمع كل الميزات الجديدة
دالة معالجة_آمنة<'أ>(بيانات)
    يتطلب طول(بيانات) > 0
    يضمن طول(النتيجة) > 0
    حيث ت: قابل_للمعالجة
    ارجع بيانات + "_معالج"
نهاية

تأكد(معالجة_آمنة("تجربة") == "تجربة_معالج"، "كل الميزات: معالجة آمنة")

# فشل الشرط المسبق
متغير فشل_معالجة = خطأ
حاول
    معالجة_آمنة("")
امسك خطأ
    فشل_معالجة = صحيح
نهاية
تأكد(فشل_معالجة، "كل الميزات: رفض بيانات فارغة")

