اطبع_سطر("═══ القسم 4: عقد ذكي مع وراثة ═══")
# ==============================================================

عقد عقد_أساسي
    متغير عام اسم

    باني(اسم_عقد)
        هذا.اسم = اسم_عقد
    نهاية

    دالة عام الاسم()
        ارجع هذا.اسم
    نهاية
نهاية

عقد عقد_تصويت يرث عقد_أساسي
    متغير عام أصوات

    باني(اسم_التصويت)
        الأساس(اسم_التصويت)
        هذا.أصوات = 0
    نهاية

    دالة عام صوّت()
        هذا.أصوات = هذا.أصوات + 1
    نهاية

    دالة عام عدد_الأصوات()
        ارجع هذا.أصوات
    نهاية
نهاية

متغير تصويت = جديد عقد_تصويت("استفتاء")
تأكد(تصويت.الاسم() == "استفتاء"، "وراثة عقد: الاسم موروث")
تأكد(تصويت.عدد_الأصوات() == 0، "وراثة عقد: أصوات ابتدائية 0")

تصويت.صوّت()
تصويت.صوّت()
تصويت.صوّت()
تأكد(تصويت.عدد_الأصوات() == 3، "وراثة عقد: 3 أصوات")

