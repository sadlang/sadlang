اطبع_سطر("")
اطبع_سطر("═══ القسم 6: عدة عقود ذكية ═══")
# ==============================================================

عقد رمز_مميز
    متغير عام اسم_الرمز
    متغير عام الإجمالي
    متغير عام أرصدة

    باني(اسم، إجمالي_ابتدائي)
        هذا.اسم_الرمز = اسم
        هذا.الإجمالي = إجمالي_ابتدائي
        هذا.أرصدة = []
    نهاية

    دالة عام الاسم()
        ارجع هذا.اسم_الرمز
    نهاية

    دالة عام المجموع()
        ارجع هذا.الإجمالي
    نهاية
نهاية

متغير رمز = جديد رمز_مميز("عملة_ص"، 1000)
تأكد(رمز.الاسم() == "عملة_ص"، "عقد رمز: الاسم صحيح")
تأكد(رمز.المجموع() == 1000، "عقد رمز: الإجمالي 1000")

