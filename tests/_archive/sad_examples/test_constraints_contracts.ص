# ==============================================================
# اختبار قيود الأنواع (Where Constraints) والعقود الذكية (Smart Contracts)
# ==============================================================
# قيود الأنواع: حيث ت: سمة1 + سمة2
# العقود الذكية: عقد اسم ... نهاية (مثل صنف مع isContract)
# ==============================================================

متغير نجاح = 0
متغير فشل = 0

دالة تأكد(شرط، رسالة)
    إذا (شرط)
        نجاح = نجاح + 1
        اطبع_سطر("  ✅ " + رسالة)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("  ❌ " + رسالة)
    نهاية
نهاية

# ==============================================================
اطبع_سطر("═══ القسم 1: قيود الأنواع (حيث) ═══")
# ==============================================================

# دالة مع قيد نوع واحد (معلوماتي — لا يُنفَّذ في وقت التشغيل)
دالة أكبر(أ، ب)
    حيث ت: قابل_للمقارنة
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

تأكد(أكبر(10، 5) == 10، "حيث قيد واحد: أكبر(10, 5)")
تأكد(أكبر(3، 7) == 7، "حيث قيد واحد: أكبر(3, 7)")
تأكد(أكبر(5، 5) == 5، "حيث قيد واحد: أكبر(5, 5)")

# دالة مع قيد نوع متعدد السمات
دالة اطبع_وأرجع(قيمة)
    حيث ت: قابل_للطباعة + قابل_للنسخ
    ارجع قيمة
نهاية

تأكد(اطبع_وأرجع(42) == 42، "حيث قيود متعددة: رقم")
تأكد(اطبع_وأرجع("مرحبا") == "مرحبا"، "حيث قيود متعددة: نص")

# ==============================================================
اطبع_سطر("")
اطبع_سطر("═══ القسم 2: قيود + عقود برمجية ═══")
# ==============================================================

# دالة تجمع بين قيود الأنواع والعقود البرمجية
دالة قسمة_آمنة(أ، ب)
    يتطلب ب != 0
    يضمن النتيجة != 0
    حيث ت: رقمي
    ارجع أ / ب
نهاية

تأكد(قسمة_آمنة(10، 2) == 5، "قيود+عقود: 10/2=5")
تأكد(قسمة_آمنة(100، 10) == 10، "قيود+عقود: 100/10=10")

# فشل الشرط المسبق
متغير فشل_قسمة = خطأ
حاول
    قسمة_آمنة(10، 0)
امسك خطأ
    فشل_قسمة = صحيح
نهاية
تأكد(فشل_قسمة، "قيود+عقود: رفض القسمة على صفر")

