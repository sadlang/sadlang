# تعريف عقد ذكي بسيط — يعمل كصنف مع علامة عقد
عقد محفظة
    متغير عام رصيد
    متغير عام مالك

    باني(مالك_جديد، رصيد_ابتدائي)
        هذا.مالك = مالك_جديد
        هذا.رصيد = رصيد_ابتدائي
    نهاية

    دالة عام إيداع(مبلغ)
        إذا (مبلغ > 0)
            هذا.رصيد = هذا.رصيد + مبلغ
        نهاية
    نهاية

    دالة عام سحب(مبلغ)
        إذا (مبلغ > 0 و مبلغ <= هذا.رصيد)
            هذا.رصيد = هذا.رصيد - مبلغ
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة عام الرصيد()
        ارجع هذا.رصيد
    نهاية
نهاية

متغير م = جديد محفظة("أحمد"، 100)
تأكد(م.الرصيد() == 100، "عقد ذكي: رصيد ابتدائي 100")

م.إيداع(50)
تأكد(م.الرصيد() == 150، "عقد ذكي: إيداع 50 → رصيد 150")

متغير نتيجة_سحب = م.سحب(30)
تأكد(نتيجة_سحب == صحيح، "عقد ذكي: سحب 30 ناجح")
تأكد(م.الرصيد() == 120، "عقد ذكي: رصيد بعد السحب 120")

متغير فشل_سحب = م.سحب(200)
تأكد(فشل_سحب == خطأ، "عقد ذكي: رفض سحب أكبر من الرصيد")
تأكد(م.الرصيد() == 120، "عقد ذكي: رصيد لم يتغير بعد سحب فاشل")

