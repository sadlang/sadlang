# اختبار تدريجي للمقارنة
متغير ق = قناة(5)
اطبع_سطر("1: قناة أنشئت")
اطبع_سطر("2: النوع = " + نوع(ق))

# اختبار المقارنة مع لاشيء
متغير ن = لاشيء
اطبع_سطر("3: ن = " + نوع(ن))

# مقارنة 1: لاشيء == لاشيء (آمنة)
إذا (ن == لاشيء)
    اطبع_سطر("4: ن == لاشيء ✓")
نهاية

# مقارنة 2: قناة != لاشيء (هنا الانهيار)
اطبع_سطر("5: قبل المقارنة...")
إذا (ق != لاشيء)
    اطبع_سطر("6: ق != لاشيء ✓")
