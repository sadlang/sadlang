# ═══════════════════════════════════════════════════════════════
# اختبارات متقدمة لتكرار القنوات
# تغطي: توقف (break)، استمر (continue)، تكرار مع مهلة،
#        قنوات unbuffered مع goroutine، أنماط مختلفة
# ═══════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

# ─── اختبار 1: توقف (break) أثناء تكرار القناة ───
اطبع_سطر("=== اختبار 1: توقف أثناء التكرار ===")

متغير ق1 = قناة(10)
لكل ر في [1، 2، 3، 4، 5]
    ق1.أرسل(ر)
نهاية
ق1.أغلق()

متغير مجموع1 = 0
لكل عنصر في ق1
    إذا (عنصر > 3)
        توقف
    نهاية
    مجموع1 = مجموع1 + عنصر
نهاية

إذا (مجموع1 == 6)
    اطبع_سطر("  ✓ توقف: مجموع أول 3 عناصر = " + مجموع1)
    نجاح = نجاح + 1
وإلا
    اطبع_سطر("  ✗ توقف: توقعنا 6 حصلنا على " + مجموع1)
    فشل = فشل + 1
نهاية

# ─── اختبار 2: استمر (continue) أثناء تكرار القناة ───
اطبع_سطر("=== اختبار 2: تخطي العناصر الزوجية ===")

متغير ق2 = قناة(10)
لكل ر في [1، 2، 3، 4، 5، 6]
    ق2.أرسل(ر)
نهاية
ق2.أغلق()

متغير مجموع_فردي = 0
لكل عنصر في ق2
    إذا (عنصر % 2 == 0)
        استمر
    نهاية
    مجموع_فردي = مجموع_فردي + عنصر
نهاية

إذا (مجموع_فردي == 9)
    اطبع_سطر("  ✓ استمر: مجموع الأعداد الفردية = " + مجموع_فردي)
    نجاح = نجاح + 1
وإلا
    اطبع_سطر("  ✗ استمر: توقعنا 9 حصلنا على " + مجموع_فردي)
    فشل = فشل + 1
نهاية

