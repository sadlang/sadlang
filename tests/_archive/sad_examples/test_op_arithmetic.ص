# اختبار شامل: /، //، %، ** معاً في صنف واحد
صنف عداد
    باني(ق)
        هذا.قيمة = ق
    نهاية

    عامل /(آخر)
        ارجع جديد عداد(هذا.قيمة / آخر.قيمة)
    نهاية

    عامل //(آخر)
        ارجع جديد عداد(هذا.قيمة // آخر.قيمة)
    نهاية

    عامل %(آخر)
        ارجع جديد عداد(هذا.قيمة % آخر.قيمة)
    نهاية

    عامل **(آخر)
        ارجع جديد عداد(هذا.قيمة ** آخر.قيمة)
    نهاية
نهاية

متغير نجاح = 0
متغير فشل = 0

دالة تحقق(عنوان، فعلي، متوقع)
    إذا (فعلي == متوقع)
        نجاح = نجاح + 1
    وإلا
        فشل = فشل + 1
        اطبع_سطر("فشل: " + عنوان + " - متوقع " + متوقع + " حصلت " + فعلي)
    نهاية
نهاية

متغير أ = جديد عداد(20)
متغير ب = جديد عداد(4)

# القسمة: 20 / 4 = 5
متغير ج1 = أ / ب
تحقق("قسمة /", ج1.قيمة, 5)

# تأكد أن أ لم تتغير
تحقق("أ بعد /", أ.قيمة, 20)

# القسمة الصحيحة: 20 // 4 = 5
متغير ج2 = أ // ب
تحقق("قسمة //", ج2.قيمة, 5)

# تأكد أن أ لم تتغير
تحقق("أ بعد //", أ.قيمة, 20)

# الباقي: 20 % 4 = 0
متغير ج3 = أ % ب
تحقق("باقي %", ج3.قيمة, 0)

# تأكد أن أ لم تتغير
تحقق("أ بعد %", أ.قيمة, 20)

# الأس: 2 ** 3 = 8
متغير أ2 = جديد عداد(2)
متغير ب2 = جديد عداد(3)
متغير ج4 = أ2 ** ب2
تحقق("أس **", ج4.قيمة, 8)

# تأكد أن أ2 لم تتغير
تحقق("أ2 بعد **", أ2.قيمة, 2)

# عمليات متتالية لاختبار عدم التلوث
متغير ج5 = أ / ب
متغير ج6 = أ // ب
متغير ج7 = أ % ب
تحقق("/ بعد سلسلة", ج5.قيمة, 5)
تحقق("// بعد سلسلة", ج6.قيمة, 5)
تحقق("% بعد سلسلة", ج7.قيمة, 0)
تحقق("أ بعد كل السلسلة", أ.قيمة, 20)

اطبع_سطر("نجاح: " + نجاح)
اطبع_سطر("فشل: " + فشل)
