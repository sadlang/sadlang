# ═══════════════════════════════════════════════════════════════════
# اختبارات صيغة النقطة للقنوات في المترجم (sadc)
# ═══════════════════════════════════════════════════════════════════
# هنا نختبر استدعاء طرق القنوات باستخدام صيغة النقطة:
#   ق.أرسل(قيمة)  بدلاً من  channel_send(ق، قيمة)
#   ق.أغلق()      بدلاً من  channel_close(ق)
#   ق.استقبل()    بدلاً من  channel_recv(ق)
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# اختبار 1: أرسل + أغلق + تكرار بصيغة النقطة
# ─────────────────────────────────────────────
متغير ق1 = قناة(10)
ق1.أرسل(55)
ق1.أغلق()

اطبع_سطر("اختبار 1: صيغة النقطة أساسية")
لكل ع في ق1
    اطبع_سطر(ع)
نهاية
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 2: استقبل بصيغة النقطة (بدون لكل)
# ─────────────────────────────────────────────
متغير ق2 = قناة(10)
ق2.أرسل(77)

اطبع_سطر("اختبار 2: استقبل بالنقطة")
متغير قيمة = ق2.استقبل()
اطبع_سطر(قيمة)
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 3: إرسال بالنقطة + إغلاق بالنقطة
# ─────────────────────────────────────────────
متغير ق3 = قناة(10)
ق3.أرسل(100)
ق3.أغلق()

اطبع_سطر("اختبار 3: إرسال وإغلاق بالنقطة")
لكل ع في ق3
    اطبع_سطر(ع)
نهاية
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 4: عمليات حسابية على قيمة مستقبلة بالنقطة
# ─────────────────────────────────────────────
متغير ق4 = قناة(10)
ق4.أرسل(15)
ق4.أغلق()

اطبع_سطر("اختبار 4: حسابات بعد استقبل")
لكل ع في ق4
    متغير ن = ع * 3
    اطبع_سطر(ن)
نهاية
اطبع_سطر("نجاح")

