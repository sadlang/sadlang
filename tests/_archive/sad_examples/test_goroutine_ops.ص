# اختبار — عمليات القناة المتقدمة
اطبع_سطر("1: بداية")

# إنشاء قناة
متغير ق = قناة(5)

# إرسال واستقبال
ق.أرسل(42)
متغير قيمة = ق.استقبل()
اطبع_سطر("2: قيمة = " + قيمة)

# عدة قيم
ق.أرسل(10)
ق.أرسل(20)
اطبع_سطر("3: الحجم = " + ق.الحجم())
اطبع_سطر("4: فارغة = " + ق.فارغة())
اطبع_سطر("5: السعة = " + ق.السعة())

# استقبال
ق.استقبل()
ق.استقبل()
اطبع_سطر("6: فارغة بعد الاستقبال = " + ق.فارغة())

# حاول_ارسل
متغير ن = ق.حاول_ارسل(99)
اطبع_سطر("7: حاول_ارسل = " + ن)

# حاول_استقبل
ق.استقبل()  # تنظيف
متغير م = ق.حاول_استقبل()
اطبع_سطر("8: حاول_استقبل = " + م)

# إغلاق
ق.أغلق()
اطبع_سطر("9: مغلقة = " + ق.مغلقة())

اطبع_سطر("10: انتهى")
