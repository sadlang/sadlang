# اختبار عامل الاستدعاء ()

صنف دالة_خطية
    متغير ميل = 0
    متغير تقاطع = 0

    باني(م، ت)
        هذا.ميل = م
        هذا.تقاطع = ت
    نهاية

    # عامل الاستدعاء: يجعل الكائن قابلاً للاستدعاء كدالة
    عامل عام ()(س)
        ارجع هذا.ميل * س + هذا.تقاطع
    نهاية
نهاية

متغير د = جديد دالة_خطية(2، 3)
# استدعاء الكائن كدالة: يجب أن ينفذ عامل ()
متغير نتيجة = د(5)
اطبع_سطر("د(5) = " + نتيجة)

إذا (نتيجة != 13)
    ارمي "فشل: 2*5+3 يجب أن يكون 13"
نهاية

متغير ن2 = د(0)
إذا (ن2 != 3)
    ارمي "فشل: 2*0+3 يجب أن يكون 3"
نهاية

اطبع_سطر("✅ اختبار عامل الاستدعاء () — نجح!")