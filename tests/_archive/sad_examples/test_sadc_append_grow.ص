# اختبار: إضافة عناصر تتجاوز السعة الابتدائية (8)
# يجب أن يعيد التخصيص تلقائياً بدون انهيار

استورد نصوص

متغير م = [1، 2، 3، 4، 5]
اطبع_سطر("الطول الأولي:")
اطبع_سطر(طول(م))

# إضافة عناصر حتى نتجاوز السعة 8
أضف(م، 6)
أضف(م، 7)
أضف(م، 8)
اطبع_سطر("بعد 3 إضافات (الطول 8 = السعة):")
اطبع_سطر(طول(م))

# هذه الإضافة تتجاوز السعة — يجب أن تعيد التخصيص!
أضف(م، 9)
اطبع_سطر("بعد تجاوز السعة (الطول 9):")
اطبع_سطر(طول(م))

# إضافات أخرى
أضف(م، 10)
أضف(م، 11)
أضف(م، 12)
اطبع_سطر("الطول 12:")
اطبع_سطر(طول(م))

# التحقق من القيم
اطبع_سطر("أول عنصر:")
اطبع_سطر(م[0])
اطبع_سطر("عنصر 8 (القيمة 9):")
اطبع_سطر(م[8])
اطبع_سطر("آخر عنصر (القيمة 12):")
اطبع_سطر(م[11])

# إضافة المزيد حتى نتجاوز 16 (الضعف الثاني)
أضف(م، 13)
أضف(م، 14)
أضف(م، 15)
أضف(م، 16)
أضف(م، 17)
اطبع_سطر("الطول 17 (تجاوز 16):")
اطبع_سطر(طول(م))
اطبع_سطر("آخر عنصر (17):")
اطبع_سطر(م[16])

