# اختبار معزول: كائن يعيد كائن من طريقة
صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة انقل(دس، دص)
        ارجع جديد نقطة(هذا.س + دس، هذا.ص + دص)
    نهاية

    دالة نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير ن1 = جديد نقطة(0، 0)
متغير ن2 = ن1.انقل(5، 3)
متغير ن3 = ن2.انقل(2، 7)

اطبع_سطر("ن1 = " + ن1.نص())
اطبع_سطر("ن2 = " + ن2.نص())
اطبع_سطر("ن3 = " + ن3.نص())
