# القسم 2: تعريف نوع اختياري (Option)
# ═══════════════════════════════════════════════════════════════

تعداد اختياري
    بعض(قيمة)
    عدم
نهاية

# ═══════════════════════════════════════════════════════════════
# القسم 3: دوال مساعدة تُرجع نتيجة
# ═══════════════════════════════════════════════════════════════

دالة قسمة_آمنة(أ، ب)
    إذا (ب == 0)
        ارجع نتيجة.خطأ("لا يمكن القسمة على صفر")
    نهاية
    ارجع نتيجة.نجاح(أ / ب)
نهاية

دالة بحث_في_قائمة(قائمة، عنصر)
    لكل ع في قائمة
        إذا (ع == عنصر)
            ارجع اختياري.بعض(ع)
        نهاية
    نهاية
    ارجع اختياري.عدم
نهاية

# ═══════════════════════════════════════════════════════════════
# القسم 4: اختبار أساسي — نتيجة.نجاح
# ═══════════════════════════════════════════════════════════════

اطبع_سطر("=== اختبار نتيجة (Result) ===")

متغير ن1 = قسمة_آمنة(10، 2)
اطبع_سطر("10 / 2 = " + ن1["قيمة"])

متغير ن2 = قسمة_آمنة(10، 0)
اطبع_سطر("10 / 0 = " + ن2["__عضو__"])

# ═══════════════════════════════════════════════════════════════
# القسم 5: اختبار عامل انشر — حالة النجاح
# ═══════════════════════════════════════════════════════════════

اطبع_سطر("=== اختبار انشر (نجاح) ===")

دالة حساب_معقد()
    متغير أ = انشر قسمة_آمنة(100، 5)
    متغير ب = انشر قسمة_آمنة(أ، 4)
    ارجع نتيجة.نجاح(ب)
نهاية

متغير نتيجة_حساب = حساب_معقد()
اطبع_سطر("100 / 5 / 4 = " + نتيجة_حساب["قيمة"])

# ═══════════════════════════════════════════════════════════════
# القسم 6: اختبار عامل انشر — حالة الخطأ (إرجاع مبكر)
# ═══════════════════════════════════════════════════════════════

اطبع_سطر("=== اختبار انشر (خطأ - إرجاع مبكر) ===")

دالة حساب_مع_خطأ()
    متغير أ = انشر قسمة_آمنة(100، 0)
    # هذا السطر يجب ألا يُنفَّذ
    اطبع_سطر("لن تطبع هذه الرسالة!")
    ارجع نتيجة.نجاح(أ)
نهاية

متغير نتيجة_خطأ = حساب_مع_خطأ()
اطبع_سطر("النتيجة عضو: " + نتيجة_خطأ["__عضو__"])
اطبع_سطر("النتيجة سبب: " + نتيجة_خطأ["سبب"])

# ═══════════════════════════════════════════════════════════════
# القسم 7: اختبار اختياري مع انشر
# ═══════════════════════════════════════════════════════════════

اطبع_سطر("=== اختبار اختياري (Option) + انشر ===")

دالة أول_موجود(قائمة، عنصر)
    متغير ق = انشر بحث_في_قائمة(قائمة، عنصر)
    ارجع اختياري.بعض("وجدت: " + ق)
نهاية

متغير بحث1 = أول_موجود([1، 2، 3، 4، 5]، 3)
اطبع_سطر("بحث عن 3: " + بحث1["قيمة"])

متغير بحث2 = أول_موجود([1، 2، 3]، 99)
اطبع_سطر("بحث عن 99: " + بحث2["__عضو__"])

# ═══════════════════════════════════════════════════════════════
# القسم 8: سلسلة انشر متعددة
# ═══════════════════════════════════════════════════════════════

اطبع_سطر("=== اختبار سلسلة انشر ===")

دالة عملية_معقدة(س)
    متغير أ = انشر قسمة_آمنة(س، 2)
    متغير ب = انشر قسمة_آمنة(أ، 3)
    متغير ج = انشر قسمة_آمنة(ب، 2)
    ارجع نتيجة.نجاح(ج)
نهاية

متغير سلسلة_نجاح = عملية_معقدة(120)
اطبع_سطر("120/2/3/2 = " + سلسلة_نجاح["قيمة"])

اطبع_سطر("=== انتهت الاختبارات بنجاح ===")
