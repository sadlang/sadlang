# اختبار عوامل التحويل الضمني

# ═══════════════════════════════════════
# اختبار 1: عامل نص() — التحويل الضمني إلى نص
# ═══════════════════════════════════════
صنف نقطة
    متغير س = 0
    متغير ص = 0
    
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    
    عامل عام نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير ن = جديد نقطة(3، 4)
# اختبار: دمج نصي مع كائن يملك عامل نص()
متغير نتيجة1 = "النقطة: " + ن
اطبع_سطر(نتيجة1)

إذا (نتيجة1 != "النقطة: (3، 4)")
    ارمي "فشل اختبار نص: توقعنا 'النقطة: (3، 4)' لكن حصلنا على '" + نتيجة1 + "'"
نهاية

# ═══════════════════════════════════════
# اختبار 2: عامل منطقي() — التحويل الضمني إلى منطقي
# ═══════════════════════════════════════
صنف مجموعة
    متغير عناصر = []
    
    باني(ع)
        هذا.عناصر = ع
    نهاية
    
    عامل عام منطقي()
        ارجع طول(هذا.عناصر) > 0
    نهاية
نهاية

متغير م1 = جديد مجموعة([1، 2، 3])
متغير م2 = جديد مجموعة([])

# اختبار: إذا مع كائن يملك عامل منطقي()
إذا (م1)
    اطبع_سطر("م1 غير فارغة — صحيح")
وإلا
    ارمي "فشل: م1 يجب أن تكون صحيحة"
نهاية

إذا (م2)
    ارمي "فشل: م2 يجب أن تكون خطأ (فارغة)"
وإلا
    اطبع_سطر("م2 فارغة — صحيح")
نهاية

# اختبار: العمليات المنطقية و/أو
إذا (م1 و ليس م2)
    اطبع_سطر("م1 و ليس م2 — صحيح")
وإلا
    ارمي "فشل: م1 و ليس م2"
نهاية

# ═══════════════════════════════════════
# اختبار 3: عامل نص() مع درجة حرارة
# ═══════════════════════════════════════
صنف درجة_حرارة
    متغير قيمة = 0
    
    باني(ق)
        هذا.قيمة = ق
    نهاية
    
    عامل عام نص()
        ارجع هذا.قيمة + "°م"
    نهاية
نهاية

متغير د = جديد درجة_حرارة(37)
متغير نتيجة3 = "الحرارة: " + د
اطبع_سطر(نتيجة3)

إذا (نتيجة3 != "الحرارة: 37°م")
    ارمي "فشل اختبار نص الحرارة"
نهاية

# ═══════════════════════════════════════
# اختبار 4: بينما مع عامل منطقي()
# ═══════════════════════════════════════
صنف عداد
    متغير قيمة = 0
    
    باني(ق)
        هذا.قيمة = ق
    نهاية
    
    عامل عام منطقي()
        ارجع هذا.قيمة > 0
    نهاية
نهاية

متغير ع = جديد عداد(3)
متغير مجموع = 0
بينما (ع)
    مجموع = مجموع + ع.قيمة
    ع.قيمة = ع.قيمة - 1
نهاية

إذا (مجموع != 6)
    ارمي "فشل: المجموع يجب أن يكون 6 لكنه " + مجموع
نهاية
اطبع_سطر("مجموع العداد: " + مجموع + " — صحيح")

اطبع_سطر("✅ جميع اختبارات التحويل الضمني نجحت!")
