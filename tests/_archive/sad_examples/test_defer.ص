# ============================================================================
# اختبار شامل لميزة أجّل (defer) — تنظيف مضمون عند خروج الدالة
# ============================================================================
# الميزة: أجّل (defer) — تأجيل تنفيذ جملة/كتلة حتى خروج الدالة
# الصيغ:
#   أجّل جملة               # جملة واحدة مؤجلة
#   أجّل                     # كتلة مؤجلة
#       جملة1
#       جملة2
#   نهاية
# السلوك: تُنفَّذ بترتيب LIFO (الأخير أولاً) عند خروج الدالة
# ============================================================================

متغير نجاح = 0
متغير فشل = 0
متغير رقم_الاختبار = 0

دالة اختبر(وصف، متوقع، فعلي)
    رقم_الاختبار = رقم_الاختبار + 1
    إذا (متوقع == فعلي)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + رقم_الاختبار + ": " + وصف)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + رقم_الاختبار + ": " + وصف + " — توقعت: " + متوقع + " حصلت: " + فعلي)
    نهاية
نهاية

# ──────────────────────────────────────────
# اختبار 1: أجّل بسيط — جملة واحدة
# ──────────────────────────────────────────
متغير نتيجة1 = ""

دالة اختبار_اجل_بسيط()
    أجّل نتيجة1 = نتيجة1 + "مؤجل"
    نتيجة1 = نتيجة1 + "أولاً_"
نهاية

اختبار_اجل_بسيط()
اختبر("أجّل بسيط — جملة واحدة", "أولاً_مؤجل", نتيجة1)

# ──────────────────────────────────────────
