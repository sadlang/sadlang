    أجّل نتيجة2 = نتيجة2 + "2"
    أجّل نتيجة2 = نتيجة2 + "3"
نهاية

اختبار_ليفو()
اختبر("ترتيب LIFO — الأخير أولاً", "321", نتيجة2)

