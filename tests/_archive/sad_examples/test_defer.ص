# ──────────────────────────────────────────
متغير نتيجة8 = ""

دالة اختبار_حلقة()
    أجّل نتيجة8 = نتيجة8 + "_نهاية"
    متغير ع = 0
    بينما (ع < 3)
        نتيجة8 = نتيجة8 + "" + ع
        ع = ع + 1
    نهاية
نهاية

