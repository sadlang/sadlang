    أجّل نتيجة6 = نتيجة6 + "_داخلي"
    نتيجة6 = نتيجة6 + "داخل"
نهاية

دالة خارجية6()
    أجّل نتيجة6 = نتيجة6 + "_خارجي"
    نتيجة6 = نتيجة6 + "خارج_"
    داخلية6()
نهاية

