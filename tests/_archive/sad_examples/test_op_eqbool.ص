# اختبار: == + منطقي (بدون نص+كائن)

صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل منطقي()
        ارجع هذا.س != 0 أو هذا.ص != 0
    نهاية
نهاية

متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(1، 2)
إذا (أ == ب)
    اطبع_سطر("متساويان")
نهاية

إذا (أ)
    اطبع_سطر("غير صفري")
نهاية
