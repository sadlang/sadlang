# اختبار نظام الماكروز (Macros)
# هذا الملف يختبر تعريف واستدعاء الماكروز

# ====================================
# اختبار 1: ماكرو بسيط بمعامل واحد
# ====================================

استورد أساسيات

ماكرو سجّل(رسالة)
    اطبع_سطر("[سجل] " + رسالة)
نهاية

سجّل!("بدء الاختبار")

# ====================================
# اختبار 2: ماكرو بدون معاملات
# ====================================
ماكرو مرحبا()
    اطبع_سطر("مرحباً بالعالم!")
نهاية

مرحبا!()

# ====================================
# اختبار 3: ماكرو بمعاملين
# ====================================
ماكرو تأكد(شرط، رسالة)
    إذا (ليس شرط)
        اطبع_سطر("❌ فشل: " + رسالة)
    وإلا
        اطبع_سطر("✅ نجح: " + رسالة)
    نهاية
نهاية

تأكد!(5 > 3، "5 أكبر من 3")
تأكد!(10 == 10، "10 يساوي 10")

# ====================================
# اختبار 4: ماكرو يعدّل متغيرات النطاق
# ====================================
ماكرو زد_بواحد(المتغير)
    المتغير = المتغير + 1
نهاية

متغير عداد = 0
زد_بواحد!(عداد)
زد_بواحد!(عداد)
زد_بواحد!(عداد)
اطبع_سطر("العدّاد بعد 3 زيادات: " + عداد)

# ====================================
# اختبار 5: ماكرو مع حسابات
# ====================================
ماكرو حاصل_ضرب(أ، ب)
    اطبع_سطر(أ + " × " + ب + " = " + (أ * ب))
نهاية

حاصل_ضرب!(7، 8)

اطبع_سطر("✅ جميع اختبارات الماكرو نجحت!")
