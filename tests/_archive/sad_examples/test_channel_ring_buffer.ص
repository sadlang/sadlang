# ═══════════════════════════════════════════════════════════════════
# اختبارات القنوات متعددة المخزن (Ring Buffer) في المترجم (sadc)
# ═══════════════════════════════════════════════════════════════════
# هذه الاختبارات تتحقق من أن القنوات تحفظ عدة قيم وتستقبلها
# بالترتيب الصحيح (FIFO — الأول دخولاً الأول خروجاً)
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# اختبار 1: إرسال 3 قيم واستقبالها بالترتيب (FIFO)
# ─────────────────────────────────────────────
متغير ق1 = قناة(10)
ق1.أرسل(10)
ق1.أرسل(20)
ق1.أرسل(30)
ق1.أغلق()

اطبع_سطر("اختبار 1: ثلاث قيم FIFO")
لكل ع في ق1
    اطبع_سطر(ع)
نهاية
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 2: إرسال 5 قيم وجمعها
# ─────────────────────────────────────────────
متغير ق2 = قناة(10)
ق2.أرسل(1)
ق2.أرسل(2)
ق2.أرسل(3)
ق2.أرسل(4)
ق2.أرسل(5)
ق2.أغلق()

اطبع_سطر("اختبار 2: جمع 5 قيم")
متغير مجموع = 0
لكل ع في ق2
    مجموع = مجموع + ع
نهاية
اطبع_سطر(مجموع)
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 3: قيم سالبة وموجبة مختلطة
# ─────────────────────────────────────────────
متغير ق3 = قناة(10)
ق3.أرسل(0 - 10)
ق3.أرسل(0)
ق3.أرسل(10)
ق3.أغلق()

اطبع_سطر("اختبار 3: مختلطة")
لكل ع في ق3
    اطبع_سطر(ع)
نهاية
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 4: عد العناصر المستقبلة
# ─────────────────────────────────────────────
متغير ق4 = قناة(20)
ق4.أرسل(100)
ق4.أرسل(200)
ق4.أرسل(300)
ق4.أرسل(400)
ق4.أغلق()

اطبع_سطر("اختبار 4: عد العناصر")
متغير عدّاد = 0
لكل ع في ق4
    عدّاد = عدّاد + 1
نهاية
اطبع_سطر(عدّاد)
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 5: ضرب كل قيمة في 10
# ─────────────────────────────────────────────
متغير ق5 = قناة(10)
ق5.أرسل(3)
ق5.أرسل(7)
ق5.أرسل(11)
ق5.أغلق()

اطبع_سطر("اختبار 5: ضرب في 10")
لكل ع في ق5
    اطبع_سطر(ع * 10)
نهاية
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 6: قناتان — نقل قيم بين قناتين
# ─────────────────────────────────────────────
متغير مصدر = قناة(10)
متغير وجهة = قناة(10)
مصدر.أرسل(11)
مصدر.أرسل(22)
مصدر.أرسل(33)
مصدر.أغلق()

# نقل من المصدر إلى الوجهة مع مضاعفة القيمة
لكل ع في مصدر
    وجهة.أرسل(ع * 2)
نهاية
وجهة.أغلق()

اطبع_سطر("اختبار 6: نقل بين قناتين")
لكل ع في وجهة
    اطبع_سطر(ع)
نهاية
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 7: استقبال يدوي (بدون لكل)
# ─────────────────────────────────────────────
متغير ق7 = قناة(10)
ق7.أرسل(100)
ق7.أرسل(200)

اطبع_سطر("اختبار 7: استقبال يدوي")
متغير أ = ق7.استقبل()
متغير ب = ق7.استقبل()
اطبع_سطر(أ)
اطبع_سطر(ب)
اطبع_سطر(أ + ب)
اطبع_سطر("نجاح")

# ─────────────────────────────────────────────
# اختبار 8: سعة صغيرة (3 فقط) — إرسال يملأ القناة
# ─────────────────────────────────────────────
متغير ق8 = قناة(3)
ق8.أرسل(1)
ق8.أرسل(2)
ق8.أرسل(3)
# الرابع يُسقط لأن القناة ممتلئة
ق8.أرسل(999)
ق8.أغلق()

اطبع_سطر("اختبار 8: سعة محدودة")
لكل ع في ق8
    اطبع_سطر(ع)
نهاية
اطبع_سطر("نجاح")
