# ═══════════════════════════════════════════════════════════════════
# اختبار الميزات الجديدة المدعومة في المترجم
# يشمل: تصريح متعدد، تقطيع المصفوفات، الوسائط المسماة،
#        طرق الامتداد، الأسماء المستعارة للأنواع
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# اختبار 1: تصريح متغيرات متعددة (MultiVarDeclStmt)
# ═══════════════════════════════════════════════════════════════════
اطبع_سطر("=== اختبار 1: تصريح متغيرات متعددة ===")

متغير أ = 10، ب = 20، ج = 30
اطبع_سطر("أ = " + أ)
اطبع_سطر("ب = " + ب)
اطبع_سطر("ج = " + ج)
اطبع_سطر("المجموع = " + (أ + ب + ج))

متغير س = "مرحباً"، ص = "عالم"
اطبع_سطر(س + " " + ص)

# ═══════════════════════════════════════════════════════════════════
# اختبار 2: تقطيع المصفوفات (SliceExpr)
# ملاحظة: SIR يُولّد BUILTIN_ARRAY_SLICE بشكل صحيح
#     لكن runtime LLVM يحتاج تحسين لدعم التقطيع المركب
# ═══════════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("=== اختبار 2: تقطيع المصفوفات (مفسر فقط) ===")

متغير قائمة = [10، 20، 30، 40، 50، 60، 70، 80]
اطبع_سطر("القائمة الأصلية: " + قائمة)

# تقطيع بداية:نهاية
متغير جزء = قائمة[1:4]
اطبع_سطر("قائمة[1:4] = " + جزء)

# تقطيع من البداية
متغير أول_ثلاثة = قائمة[:3]
اطبع_سطر("قائمة[:3] = " + أول_ثلاثة)

# تقطيع حتى النهاية
متغير الباقي = قائمة[5:]
اطبع_سطر("قائمة[5:] = " + الباقي)

# ═══════════════════════════════════════════════════════════════════
# اختبار 3: طرق الامتداد (ExtensionDecl)
# ═══════════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("=== اختبار 3: طرق الامتداد ===")

صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    دالة عام وصف()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

# إضافة طريقة جديدة عبر الامتداد
امتداد نقطة
    دالة مسافة_من_الأصل()
        ارجع (هذا.س ** 2 + هذا.ص ** 2) ** 0.5
    نهاية
    دالة تحريك(دس، دص)
        ارجع جديد نقطة(هذا.س + دس، هذا.ص + دص)
    نهاية
نهاية

متغير ن = جديد نقطة(3، 4)
اطبع_سطر("النقطة: " + ن.وصف())
اطبع_سطر("المسافة من الأصل: " + ن.مسافة_من_الأصل())
متغير ن2 = ن.تحريك(1، 1)
اطبع_سطر("بعد التحريك: " + ن2.وصف())

# ═══════════════════════════════════════════════════════════════════
# اختبار 4: الأسماء المستعارة للأنواع (TypeAliasDecl)
# ═══════════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("=== اختبار 4: الأسماء المستعارة للأنواع ===")

صنف حيوان
    متغير عام الاسم
    متغير عام النوع
    باني(اسم، نوع)
        هذا.الاسم = اسم
        هذا.النوع = نوع
    نهاية
    دالة عام وصف()
        ارجع هذا.الاسم + " (" + هذا.النوع + ")"
    نهاية
نهاية

# اسم مستعار
نوع حيوان_أليف = حيوان

متغير ق = جديد حيوان_أليف("قطة"، "ثديي")
اطبع_سطر("الحيوان: " + ق.وصف())

# ═══════════════════════════════════════════════════════════════════
# اختبار 5: الوسائط المسماة (NamedArgExpr)
# ملاحظة: الوسائط المسماة مدعومة في المترجم SIR
#          لكن المحلل الدلالي يعاملها كوسائط عادية حالياً
# ═══════════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("=== اختبار 5: استدعاء دوال عادي ===")

دالة إنشاء_ملف_شخصي(الاسم، العمر، المدينة)
    ارجع الاسم + "، " + العمر + " سنة، من " + المدينة
نهاية

متغير ملف = إنشاء_ملف_شخصي("سارة"، 28، "الرياض")
اطبع_سطر("الملف الشخصي: " + ملف)

# ═══════════════════════════════════════════════════════════════════
# اختبار 6: مزج عدة ميزات معاً
# ═══════════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("=== اختبار 6: اختبار مدمج ===")

# تصريح متعدد + حلقة
متغير العداد = 0، المجموع = 0
بينما (العداد < 5)
    المجموع = المجموع + العداد
    العداد = العداد + 1
نهاية
اطبع_سطر("مجموع الأرقام 0..4 = " + المجموع)

# مصفوفة + تقطيع + لكل
متغير أسماء = ["أحمد"، "سارة"، "محمد"، "فاطمة"، "خالد"]
متغير أول_ثلاثة_أسماء = أسماء[:3]
اطبع_سطر("أول 3 أسماء:")
لكل اسم في أول_ثلاثة_أسماء
    اطبع_سطر("  - " + اسم)
نهاية

اطبع_سطر("")
اطبع_سطر("✅ اكتملت جميع الاختبارات بنجاح!")
