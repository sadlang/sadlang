# اختبار وراثة عوامل التحويل

صنف شكل
    متغير اسم = ""
    
    باني(اسم)
        هذا.اسم = اسم
    نهاية
    
    عامل عام نص()
        ارجع "شكل: " + هذا.اسم
    نهاية
    
    عامل عام منطقي()
        ارجع هذا.اسم != ""
    نهاية
نهاية

صنف دائرة يرث شكل
    متغير نصف_قطر = 0
    
    باني(نصف_قطر)
        الأساس("دائرة")
        هذا.نصف_قطر = نصف_قطر
    نهاية
نهاية

# دائرة لا تملك عامل نص() — يجب أن ترث من شكل
متغير د = جديد دائرة(5)
متغير نتيجة = "الشكل هو: " + د
اطبع_سطر(نتيجة)

إذا (نتيجة != "الشكل هو: شكل: دائرة")
    ارمي "فشل وراثة نص: " + نتيجة
نهاية

# اختبار عامل منطقي() الموروث
إذا (د)
    اطبع_سطر("الدائرة صالحة — صحيح")
وإلا
    ارمي "فشل وراثة منطقي"
نهاية

# صنف يُعيد تعريف عامل نص()
صنف مربع يرث شكل
    متغير ضلع = 0
    
    باني(ضلع)
        الأساس("مربع")
        هذا.ضلع = ضلع
    نهاية
    
    عامل عام نص()
        ارجع "مربع[" + هذا.ضلع + "]"
    نهاية
نهاية

متغير م = جديد مربع(4)
متغير نتيجة2 = "الشكل: " + م
اطبع_سطر(نتيجة2)

إذا (نتيجة2 != "الشكل: مربع[4]")
    ارمي "فشل override نص: " + نتيجة2
نهاية

اطبع_سطر("✅ وراثة عوامل التحويل — نجحت!")
