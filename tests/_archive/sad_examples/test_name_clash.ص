# اختبار: تعارض أسماء الطرائق عند إرجاع كائن
صنف لون
    باني(ر، خ، ز)
        هذا.ر = ر
        هذا.خ = خ
        هذا.ز = ز
    نهاية

    دالة نص()
        ارجع "rgb(" + هذا.ر + "، " + هذا.خ + "، " + هذا.ز + ")"
    نهاية
نهاية

صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة انقل(دس، دص)
        ارجع جديد نقطة(هذا.س + دس، هذا.ص + دص)
    نهاية

    دالة نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير ل = جديد لون(255، 0، 0)
اطبع_سطر("لون: " + ل.نص())

متغير ن1 = جديد نقطة(1، 2)
متغير ن2 = ن1.انقل(3، 4)
اطبع_سطر("ن1: " + ن1.نص())
اطبع_سطر("ن2: " + ن2.نص())
