# المجموعة 12: تحميل العوامل الزائد
# ═══════════════════════════════════════════════════════════════════
اطبع_سطر("=== 12. تحميل العوامل الزائد ===")

صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل -(آخر)
        ارجع جديد متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل !=(آخر)
        ارجع ليس (هذا.س == آخر.س و هذا.ص == آخر.ص)
    نهاية

    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية

    عامل منطقي()
        ارجع هذا.س != 0 أو هذا.ص != 0
    نهاية
نهاية

