# اختبار ADT شامل للمترجم - تعدادان + دوال

تعداد شكل
    دائرة(نصف_القطر)
    مستطيل(عرض، ارتفاع)
    نقطة
نهاية

تعداد نتيجة
    نجاح(قيمة)
    فشل(رسالة)
نهاية

متغير ش1 = شكل.دائرة(42)
متغير ش2 = شكل.مستطيل(10، 20)
متغير ش3 = شكل.نقطة

# اختبار 1-3: مطابقة كل حالة
طابق (ش1)
    عندما شكل.دائرة(نق):
        اطبع_سطر("1:دائرة=" + نق)
    افتراضي:
        اطبع_سطر("1:آخر")
نهاية

طابق (ش2)
    عندما شكل.مستطيل(ع، ا):
        اطبع_سطر("2:مستطيل=" + ع + "×" + ا)
    افتراضي:
        اطبع_سطر("2:آخر")
نهاية

طابق (ش3)
    عندما شكل.نقطة:
        اطبع_سطر("3:نقطة")
    افتراضي:
        اطبع_سطر("3:آخر")
نهاية

# اختبار 4: تعداد ثاني
متغير ن = نتيجة.نجاح(100)
طابق (ن)
    عندما نتيجة.نجاح(ق):
        اطبع_سطر("4:نجاح=" + ق)
    عندما نتيجة.فشل(ر):
        اطبع_سطر("4:فشل")
نهاية

# اختبار 5: تمرير ADT لدالة
دالة وصف(ش)
    طابق (ش)
        عندما شكل.دائرة(نق):
            اطبع_سطر("ف:دائرة=" + نق)
        عندما شكل.مستطيل(ع، ا):
            اطبع_سطر("ف:مستطيل=" + ع + "×" + ا)
        عندما شكل.نقطة:
            اطبع_سطر("ف:نقطة")
    نهاية
نهاية

وصف(ش1)
وصف(ش2)
وصف(ش3)

# اختبار 6: إرجاع ADT من دالة
دالة اصنع(النوع)
    إذا (النوع == 1)
        ارجع شكل.دائرة(99)
    وإلا
        ارجع شكل.مستطيل(30، 40)
    نهاية
نهاية

متغير ش4 = اصنع(1)
متغير ش5 = اصنع(2)

طابق (ش4)
    عندما شكل.دائرة(نق):
        اطبع_سطر("6:دائرة=" + نق)
    افتراضي:
        اطبع_سطر("6:آخر")
نهاية

طابق (ش5)
    عندما شكل.مستطيل(ع، ا):
        اطبع_سطر("7:مستطيل=" + ع + "×" + ا)
    افتراضي:
        اطبع_سطر("7:آخر")
