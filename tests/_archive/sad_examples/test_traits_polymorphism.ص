# ═══════════════════════════════════════
# اختبار 11: سمة بسيطة مع تنفيذ
# ═══════════════════════════════════════
سمة قابل_للوصف
    دالة صِف()
نهاية

صنف كتاب
    باني(العنوان، المؤلف)
        هذا.العنوان = العنوان
        هذا.المؤلف = المؤلف
    نهاية
نهاية

نفّذ قابل_للوصف لـ كتاب
    دالة صِف()
        ارجع هذا.العنوان + " بقلم " + هذا.المؤلف
    نهاية
نهاية

متغير ك = جديد كتاب("البؤساء"، "هوغو")
اطبع_سطر("اختبار 11 — سمة بسيطة:")
اطبع_سطر(ك.صِف())

# ═══════════════════════════════════════
# اختبار 12: سمة مُنفّذة على عدة أصناف
# ═══════════════════════════════════════
سمة له_اسم
    دالة الاسم_الكامل()
نهاية

صنف شخص
    باني(الاول، الاخير)
        هذا.الاول = الاول
        هذا.الاخير = الاخير
    نهاية
نهاية

نفّذ له_اسم لـ شخص
    دالة الاسم_الكامل()
        ارجع هذا.الاول + " " + هذا.الاخير
    نهاية
نهاية

صنف شركة
    باني(نوع، اسم)
        هذا.نوع = نوع
        هذا.اسم = اسم
    نهاية
نهاية

نفّذ له_اسم لـ شركة
    دالة الاسم_الكامل()
        ارجع هذا.نوع + " " + هذا.اسم
    نهاية
نهاية

متغير ش1 = جديد شخص("أحمد"، "محمد")
متغير ش2 = جديد شركة("مؤسسة"، "الفجر")

اطبع_سطر("اختبار 12 — سمة على عدة أصناف:")
اطبع_سطر("شخص: " + ش1.الاسم_الكامل())
اطبع_سطر("شركة: " + ش2.الاسم_الكامل())

# ═══════════════════════════════════════
# اختبار 13: وراثة + تعدد الأشكال (override)
# ═══════════════════════════════════════
صنف آلة
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية

    دالة صوت()
        ارجع "..."
    نهاية

    دالة عرض()
        ارجع هذا.الاسم + " يصدر: " + هذا.صوت()
    نهاية
نهاية

صنف سيارة2 يرث آلة
    باني(الاسم، السرعة) : الأساس(الاسم)
        هذا.السرعة = السرعة
    نهاية

    دالة صوت()
        ارجع "فروم فروم"
    نهاية
نهاية

صنف قطار يرث آلة
    باني(الاسم، العربات) : الأساس(الاسم)
        هذا.العربات = العربات
    نهاية

    دالة صوت()
        ارجع "تشوك تشوك"
    نهاية
نهاية

متغير س2 = جديد سيارة2("BMW"، 240)
متغير ق = جديد قطار("الحرمين"، 12)

اطبع_سطر("اختبار 13 — تعدد الأشكال:")
اطبع_سطر(س2.عرض())
اطبع_سطر(ق.عرض())
اطبع_سطر("سرعة السيارة: " + س2.السرعة)
اطبع_سطر("عربات القطار: " + ق.العربات)

# ═══════════════════════════════════════
# اختبار 14: عوامل زائدة مع وراثة
# ═══════════════════════════════════════
صنف عدد
    باني(القيمة)
        هذا.القيمة = القيمة
    نهاية

    عامل +(آخر)
        ارجع جديد عدد(هذا.القيمة + آخر.القيمة)
    نهاية

    عامل *(آخر)
        ارجع جديد عدد(هذا.القيمة * آخر.القيمة)
    نهاية
نهاية

متغير ع1 = جديد عدد(5)
متغير ع2 = جديد عدد(3)
متغير ع3 = ع1 + ع2
متغير ع4 = ع1 * ع2

اطبع_سطر("اختبار 14 — عوامل زائدة (+ و *):")
اطبع_سطر("5 + 3 = " + ع3.القيمة)
اطبع_سطر("5 * 3 = " + ع4.القيمة)

# ═══════════════════════════════════════
# اختبار 15: طرائق تعدّل حالة الكائن
# ═══════════════════════════════════════
صنف مخزن
    باني(الصنف، الكمية)
        هذا.الصنف = الصنف
        هذا.الكمية = الكمية
    نهاية

    دالة أضف_كمية(ك)
        هذا.الكمية = هذا.الكمية + ك
    نهاية

    دالة اسحب(ك)
        هذا.الكمية = هذا.الكمية - ك
    نهاية

    دالة حالة()
        ارجع هذا.الصنف + ": " + هذا.الكمية + " وحدة"
    نهاية
نهاية

متغير مخ = جديد مخزن("قلم"، 100)
اطبع_سطر("اختبار 15 — تعديل حالة الكائن:")
اطبع_سطر(مخ.حالة())
مخ.أضف_كمية(50)
اطبع_سطر(مخ.حالة())
مخ.اسحب(30)
اطبع_سطر(مخ.حالة())

اطبع_سطر("=== جميع اختبارات السمات وتعدد الأشكال نجحت ===")
