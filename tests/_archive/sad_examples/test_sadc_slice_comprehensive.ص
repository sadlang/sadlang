# اختبار شامل: قطع المصفوفات + عمليات المصفوفات الأخرى مع المتغيرات العامة

# === 1. اختبار القطع الأساسي ===

استورد نصوص

متغير م = [10، 20، 30، 40، 50]
متغير ج1 = م[1:3]
اطبع_سطر("قطع [1:3]:")
اطبع_سطر(ج1[0])
اطبع_سطر(ج1[1])

# === 2. قطع من البداية ===
متغير ج2 = م[0:2]
اطبع_سطر("قطع [0:2]:")
اطبع_سطر(ج2[0])
اطبع_سطر(ج2[1])

# === 3. قطع حتى النهاية ===
متغير ج3 = م[3:5]
اطبع_سطر("قطع [3:5]:")
اطبع_سطر(ج3[0])
اطبع_سطر(ج3[1])

# === 4. طول المصفوفة ===
اطبع_سطر("طول م:")
اطبع_سطر(طول(م))

# === 5. إضافة عنصر ===
أضف(م، 60)
اطبع_سطر("بعد الإضافة:")
اطبع_سطر(طول(م))
اطبع_سطر(م[5])

# === 6. أول وآخر عنصر ===
اطبع_سطر("أول:")
اطبع_سطر(م[0])
اطبع_سطر("آخر:")
اطبع_سطر(م[5])

# === 7. عنصر واحد ===
متغير ج4 = م[2:3]
اطبع_سطر("قطع عنصر واحد [2:3]:")
اطبع_سطر(ج4[0])

اطبع_سطر("===")
اطبع_سطر("نجاح")
