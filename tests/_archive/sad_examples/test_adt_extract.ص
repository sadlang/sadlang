# اختبار استخراج حقول ADT في المترجم
تعداد شكل
    دائرة(نصف_القطر)
    مستطيل(عرض، ارتفاع)
    نقطة
نهاية

متغير ش1 = شكل.دائرة(42)
متغير ش2 = شكل.مستطيل(10، 20)

# اختبار 1: استخراج حقل واحد
طابق (ش1)
    عندما شكل.دائرة(نق):
        اطبع("نصف القطر = ")
        اطبع_سطر(نق)
    افتراضي:
        اطبع_سطر("خطأ!")
