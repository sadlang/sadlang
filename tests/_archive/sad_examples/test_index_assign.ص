# اختبار عامل الإسناد بالفهرس []=

صنف قائمة_مخصصة
    متغير بيانات = []

    باني(ب)
        هذا.بيانات = ب
    نهاية

    # عامل القراءة بالفهرس
    عامل عام [](فهرس)
        ارجع هذا.بيانات[فهرس]
    نهاية

    # عامل الإسناد بالفهرس
    عامل عام []=(فهرس، قيمة)
        هذا.بيانات[فهرس] = قيمة
    نهاية

    دالة عام طباعة()
        ارجع "" + هذا.بيانات
    نهاية
نهاية

متغير ق = جديد قائمة_مخصصة([10، 20، 30])
اطبع_سطر("قبل: " + ق.طباعة())

# قراءة
اطبع_سطر("ق[0] = " + ق[0])
اطبع_سطر("ق[1] = " + ق[1])

# إسناد
ق[0] = 100
ق[2] = 300
اطبع_سطر("بعد: " + ق.طباعة())

# تحقق
إذا (ق[0] != 100)
    ارمي "فشل: ق[0] يجب أن يكون 100"
نهاية
إذا (ق[2] != 300)
    ارمي "فشل: ق[2] يجب أن يكون 300"
نهاية
إذا (ق[1] != 20)
    ارمي "فشل: ق[1] يجب أن يبقى 20"
نهاية

اطبع_سطر("✅ اختبار عامل []= — نجح بالكامل!")