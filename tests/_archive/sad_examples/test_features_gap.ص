# اختبار شامل للفجوات بين المفسر والمترجم

# === 1. أساسيات ===
اطبع_سطر("=== 1: أساسيات ===")
متغير س = 42
متغير ن = "مرحبا"
اطبع_سطر(س)
اطبع_سطر(ن)

# === 2. F-Strings ===
اطبع_سطر("=== 2: F-Strings ===")
متغير اسم = "أحمد"
متغير عمر = 25
اطبع_سطر("مرحبا ${اسم} عمرك ${عمر}")

# === 3. لامدا بسيطة (سهم) ===
اطبع_سطر("=== 3: لامدا ===")
متغير مضاعف = لامدا(س) => س * 2
اطبع_سطر(مضاعف(5))

# === 4. لامدا + التقاط ===
اطبع_سطر("=== 4: لامدا + التقاط ===")
متغير قاعدة = 10
متغير جامع = لامدا(س) => س + قاعدة
اطبع_سطر(جامع(5))

# === 5. خريطة بسيطة ===
اطبع_سطر("=== 5: خريطة ===")
متغير خ = {"اسم": "سعد"، "عمر": 30}
اطبع_سطر(خ["اسم"])

# === 6. تعداد ===
اطبع_سطر("=== 6: تعداد ===")
تعداد اللون
    أحمر
    أخضر
    أزرق
نهاية
اطبع_سطر(اللون.أحمر)

# === 7. null coalesce ?? ===
اطبع_سطر("=== 7: null coalesce ===")
متغير ق = لاشيء ?? "افتراضي"
اطبع_سطر(ق)

# === 8. حاول/امسك ===
اطبع_سطر("=== 8: حاول/امسك ===")
حاول
    ارمي "خطأ تجريبي"
امسك خطأ
    اطبع_سطر("امسك: " + خطأ)
نهاية

# === 9. دالة ===
اطبع_سطر("=== 9: دالة ===")
دالة جمع(أ، ب)
    ارجع أ + ب
نهاية
اطبع_سطر(جمع(3، 7))

# === 10. صنف بسيط ===
اطبع_سطر("=== 10: صنف ===")
صنف شخص
    باني(اسم، عمر)
        هذا.اسم = اسم
        هذا.عمر = عمر
    نهاية
    دالة عام تعريف()
        ارجع هذا.اسم + " - " + هذا.عمر
    نهاية
نهاية
متغير ش = جديد شخص("علي"، 30)
اطبع_سطر(ش.تعريف())

# === 11. مصفوفة + خريطة ===
اطبع_سطر("=== 11: مصفوفة + خريطة ===")
متغير م = [1، 2، 3، 4، 5]
اطبع_سطر(م[0])
اطبع_سطر(طول(م))
م.اضف(6)
اطبع_سطر(طول(م))

# === 12. لكل ===
اطبع_سطر("=== 12: لكل ===")
لكل عنصر في [10، 20، 30]
    اطبع(عنصر)
    اطبع(" ")
نهاية
اطبع_سطر("")

# === 13. بينما ===
اطبع_سطر("=== 13: بينما ===")
متغير عداد = 0
بينما (عداد < 5)
    عداد = عداد + 1
نهاية
اطبع_سطر(عداد)

# === 14. إذا/وإلا ===
اطبع_سطر("=== 14: إذا/وإلا ===")
متغير رقم = 15
إذا (رقم > 10)
    اطبع_سطر("أكبر من 10")
وإلا
    اطبع_سطر("أصغر أو يساوي 10")
نهاية

# === 15. عمليات نصية ===
اطبع_سطر("=== 15: عمليات نصية ===")
متغير نص1 = "مرحبا بالعالم"
اطبع_سطر(طول(نص1))
اطبع_سطر(نص1)

اطبع_سطر("=== انتهت جميع الاختبارات ===")
