# اختبار نظام السمات في المترجم

# === 1. سمة بسيطة ===
سمة قابل_للطباعة
   دالة نص اعرض()
نهاية

# === 2. صنف مع تنفيذ سمة ===
صنف منتج
   نص الاسم
   عشري السعر
   
   باني(اسم: نص، سعر: عشري)
      هذا.الاسم = اسم
      هذا.السعر = سعر
   نهاية
نهاية

نفّذ قابل_للطباعة لـ منتج
   دالة نص اعرض()
      ارجع هذا.الاسم + ": " + هذا.السعر
   نهاية
نهاية

# === 3. اختبار ===
متغير م = جديد منتج("تفاح"، 5.5)
اطبع_سطر(م.اعرض())

اطبع_سطر("✅ جميع اختبارات السمات نجحت!")

# === 4. سمة ترث سمة أخرى ===
سمة قابل_للمقارنة
   دالة رقم قارن(آخر: أي)
نهاية

سمة قابل_للترتيب يرث قابل_للمقارنة
   دالة منطقي اكبر_من(آخر: أي)
نهاية

صنف رقم_مغلف
   رقم القيمة
   
   باني(ق: رقم)
      هذا.القيمة = ق
   نهاية
نهاية

نفّذ قابل_للترتيب لـ رقم_مغلف
   دالة رقم قارن(آخر: أي)
      ارجع هذا.القيمة - آخر
   نهاية
   دالة منطقي اكبر_من(آخر: أي)
      ارجع هذا.القيمة > آخر
   نهاية
نهاية

متغير ر = جديد رقم_مغلف(42)
اطبع_سطر("المقارنة: " + ر.قارن(10))
اطبع_سطر("أكبر من 10: " + ر.اكبر_من(10))

# === 5. تنفيذ ذاتي (نفّذ صنف) بدون سمة ===
نفّذ رقم_مغلف
   دالة نص وصف()
      ارجع "الرقم: " + هذا.القيمة
   نهاية
نهاية

اطبع_سطر(ر.وصف())

اطبع_سطر("✅ جميع اختبارات السمات المتقدمة نجحت!")
