# اختبار: تحقق + وراثة + منطقي
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية
    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

صنف كائن_قاعدة
    باني(اسم)
        هذا.اسم = اسم
    نهاية
    عامل نص()
        ارجع "كائن: " + هذا.اسم
    نهاية
    عامل منطقي()
        ارجع هذا.اسم != ""
    نهاية
نهاية

صنف موظف يرث كائن_قاعدة
    باني(اسم، راتب)
        الأساس(اسم)
        هذا.راتب = راتب
    نهاية
نهاية

متغير نجاح = 0
دالة تحقق(الوصف، القيمة، المتوقع)
    إذا (القيمة == المتوقع)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("فشل: " + الوصف)
    نهاية
نهاية

متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(3، 4)
متغير ج = أ + ب
تحقق("جمع", "" + ج, "(4، 6)")

متغير موظ = جديد موظف("أحمد"، 5000)
تحقق("وراثة نص", "" + موظ, "كائن: أحمد")

اطبع_سطر("قبل منطقي")
