# ===================================================================
# اختبار شامل لجميع عوامل التحميل الزائد في لغة ص
# يختبر: حساب (+,-,*,/,%)، مقارنة (==,!=,<,>,<=,>=)
#         أحادي (سالب -)، نص، منطقي، فهرسة ([], []=)
#         استدعاء ()، وراثة العوامل، حالات حافة
# ===================================================================

# === عداد النتائج ===
متغير نجاح = 0
متغير فشل = 0
متغير رقم_الاختبار = 0

دالة تحقق(الوصف، القيمة، المتوقع)
    رقم_الاختبار = رقم_الاختبار + 1
    إذا (القيمة == المتوقع)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("✗ #" + رقم_الاختبار + " فشل: " + الوصف + " — توقعنا: " + المتوقع + "، حصلنا: " + القيمة)
        فشل = فشل + 1
    نهاية
نهاية

# ===================================================================
# القسم 1: صنف متجه — عوامل حسابية ومقارنة
# ===================================================================
صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    # عوامل حسابية ثنائية
    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل -(آخر)
        ارجع جديد متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    عامل *(آخر)
        ارجع جديد متجه(هذا.س * آخر.س، هذا.ص * آخر.ص)
    نهاية

    # عوامل مقارنة
    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل !=(آخر)
        ارجع هذا.س != آخر.س أو هذا.ص != آخر.ص
    نهاية

    عامل <(آخر)
        ارجع (هذا.س * هذا.س + هذا.ص * هذا.ص) < (آخر.س * آخر.س + آخر.ص * آخر.ص)
    نهاية

    # عامل أحادي (سالب)
    عامل -()
        ارجع جديد متجه(-هذا.س، -هذا.ص)
    نهاية

    # عامل التحويل إلى نص
    عامل نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية

    # عامل التحويل إلى منطقي
    عامل منطقي()
        ارجع هذا.س != 0 أو هذا.ص != 0
    نهاية
نهاية

# ===================================================================
# القسم 2: صنف مصفوفتي — عوامل فهرسة [] و []=
# ===================================================================
صنف مصفوفتي
    باني()
        هذا.بيانات = [10، 20، 30، 40، 50]
    نهاية

    عامل [](فهرس)
        ارجع هذا.بيانات[فهرس]
    نهاية

    عامل []=(فهرس، قيمة)
        هذا.بيانات[فهرس] = قيمة
    نهاية

    عامل نص()
        ارجع "مصفوفة:" + هذا.بيانات
    نهاية
نهاية

# ===================================================================
# القسم 3: صنف مضاعف — عامل الاستدعاء ()
# ===================================================================
صنف مضاعف
    باني(عامل_الضرب)
        هذا.عامل_الضرب = عامل_الضرب
    نهاية

    عامل ()(قيمة)
        ارجع قيمة * هذا.عامل_الضرب
    نهاية
نهاية

# ===================================================================
# القسم 4: وراثة العوامل — صنف أساسي + فرعي
# ===================================================================
صنف كائن_قاعدة
    باني(اسم)
        هذا.اسم = اسم
    نهاية

    عامل نص()
        ارجع "كائن: " + هذا.اسم
    نهاية

    عامل منطقي()
        ارجع هذا.اسم != ""
    نهاية
نهاية

صنف موظف يرث كائن_قاعدة
    باني(اسم، راتب)
        الأساس(اسم)
        هذا.راتب = راتب
    نهاية
نهاية

# ===================================================================
# القسم 5: صنف عداد — عوامل حسابية مع أعداد
# ===================================================================
صنف عداد
    باني(قيمة)
        هذا.قيمة = قيمة
    نهاية

    عامل +(آخر)
        ارجع جديد عداد(هذا.قيمة + آخر.قيمة)
    نهاية

    عامل -(آخر)
        ارجع جديد عداد(هذا.قيمة - آخر.قيمة)
    نهاية

    عامل *(آخر)
        ارجع جديد عداد(هذا.قيمة * آخر.قيمة)
    نهاية

    عامل ==(آخر)
        ارجع هذا.قيمة == آخر.قيمة
    نهاية

    عامل !=(آخر)
        ارجع هذا.قيمة != آخر.قيمة
    نهاية

    عامل <(آخر)
        ارجع هذا.قيمة < آخر.قيمة
    نهاية

    عامل نص()
        ارجع "عداد(" + هذا.قيمة + ")"
    نهاية

    عامل منطقي()
        ارجع هذا.قيمة != 0
    نهاية

    عامل -()
        ارجع جديد عداد(-هذا.قيمة)
    نهاية
نهاية

# ===================================================================
# بدء الاختبارات
# ===================================================================
اطبع_سطر("=== اختبار شامل لعوامل التحميل الزائد ===")

# -------------------------------------------------------------------
# 1. عوامل حسابية — متجه
# -------------------------------------------------------------------
اطبع_سطر("--- عوامل حسابية (متجه) ---")

متغير أ = جديد متجه(1، 2)
متغير ب = جديد متجه(3، 4)

متغير ج = أ + ب
تحقق("متجه + متجه", "" + ج, "(4، 6)")

متغير د = ب - أ
تحقق("متجه - متجه", "" + د, "(2، 2)")

متغير هـ = أ * ب
تحقق("متجه * متجه", "" + هـ, "(3، 8)")

# سلسلة عمليات
متغير سلسلة = أ + ب + أ
تحقق("متجه + متجه + متجه", "" + سلسلة, "(5، 8)")

# -------------------------------------------------------------------
# 2. عوامل مقارنة — متجه
# -------------------------------------------------------------------
اطبع_سطر("--- عوامل مقارنة (متجه) ---")

متغير و = جديد متجه(1، 2)
تحقق("متجه == (متساويان)", أ == و, صحيح)
تحقق("متجه == (مختلفان)", أ == ب, خطأ)
تحقق("متجه != (مختلفان)", أ != ب, صحيح)
تحقق("متجه != (متساويان)", أ != و, خطأ)
تحقق("متجه < متجه", أ < ب, صحيح)

# -------------------------------------------------------------------
# 3. عامل أحادي (سالب) — متجه
# -------------------------------------------------------------------
اطبع_سطر("--- عامل أحادي (متجه) ---")

متغير سالب = -أ
تحقق("سالب متجه", "" + سالب, "(-1، -2)")

متغير سالب_ب = -ب
تحقق("سالب متجه ب", "" + سالب_ب, "(-3، -4)")

# -------------------------------------------------------------------
# 4. عامل نص — متجه
# -------------------------------------------------------------------
اطبع_سطر("--- عامل نص (متجه) ---")

تحقق("عامل نص أ", "" + أ, "(1، 2)")
تحقق("عامل نص ب", "" + ب, "(3، 4)")

# -------------------------------------------------------------------
# 5. عامل منطقي — متجه
# -------------------------------------------------------------------
اطبع_سطر("--- عامل منطقي (متجه) ---")

إذا (أ)
    تحقق("عامل منطقي (غير صفري)", صحيح, صحيح)
نهاية

متغير صفر = جديد متجه(0، 0)
إذا (صفر)
    تحقق("عامل منطقي (صفري)", صحيح, خطأ)
وإلا
    تحقق("عامل منطقي (صفري)", خطأ, خطأ)
نهاية

# -------------------------------------------------------------------
# 6. عوامل فهرسة [] و []= — مصفوفتي
# -------------------------------------------------------------------
اطبع_سطر("--- عوامل فهرسة ---")

متغير م = جديد مصفوفتي()
تحقق("عامل [] أول", م[0], 10)
تحقق("عامل [] أخير", م[4], 50)
تحقق("عامل [] وسط", م[2], 30)

م[0] = 100
تحقق("عامل []= أول", م[0], 100)

م[4] = 500
تحقق("عامل []= أخير", م[4], 500)

م[2] = 99
تحقق("عامل []= وسط", م[2], 99)

# فهرسة + طباعة (حالة سابقة كانت تسبب segfault)
اطبع_سطر("--- فهرسة + طباعة ---")
تحقق("فهرسة ثم نص", "" + م, "مصفوفة:[100, 20, 99, 40, 500]")

# -------------------------------------------------------------------
# 7. عامل الاستدعاء ()
# -------------------------------------------------------------------
اطبع_سطر("--- عامل الاستدعاء ---")

متغير ض = جديد مضاعف(3)
تحقق("عامل () ضرب 3×7", ض(7), 21)
تحقق("عامل () ضرب 3×10", ض(10), 30)
تحقق("عامل () ضرب 3×0", ض(0), 0)

متغير خمسة = جديد مضاعف(5)
تحقق("عامل () ضرب 5×4", خمسة(4), 20)

# -------------------------------------------------------------------
# 8. وراثة العوامل
# -------------------------------------------------------------------
اطبع_سطر("--- وراثة العوامل ---")

متغير موظ = جديد موظف("أحمد"، 5000)
تحقق("وراثة عامل نص", "" + موظ, "كائن: أحمد")

إذا (موظ)
    تحقق("وراثة عامل منطقي", صحيح, صحيح)
نهاية

# -------------------------------------------------------------------
# 9. عوامل حسابية — عداد (صنف ثاني)
# -------------------------------------------------------------------
اطبع_سطر("--- عوامل حسابية (عداد) ---")

متغير ع1 = جديد عداد(10)
متغير ع2 = جديد عداد(3)

متغير مج = ع1 + ع2
تحقق("عداد + عداد", "" + مج, "عداد(13)")

متغير فرق = ع1 - ع2
تحقق("عداد - عداد", "" + فرق, "عداد(7)")

متغير حاصل = ع1 * ع2
تحقق("عداد * عداد", "" + حاصل, "عداد(30)")

# مقارنة عدادات
تحقق("عداد == (مختلفان)", ع1 == ع2, خطأ)

متغير ع3 = جديد عداد(10)
تحقق("عداد == (متساويان)", ع1 == ع3, صحيح)
تحقق("عداد != (مختلفان)", ع1 != ع2, صحيح)
تحقق("عداد < عداد", ع2 < ع1, صحيح)

# سالب عداد
متغير سالب_ع = -ع1
تحقق("سالب عداد", "" + سالب_ع, "عداد(-10)")

# منطقي عداد
إذا (ع1)
    تحقق("عداد منطقي (غير صفري)", صحيح, صحيح)
نهاية

متغير ع_صفر = جديد عداد(0)
إذا (ع_صفر)
    تحقق("عداد منطقي (صفري)", صحيح, خطأ)
وإلا
    تحقق("عداد منطقي (صفري)", خطأ, خطأ)
نهاية

