اطبع_سطر("")
اطبع_سطر("═══ القسم 5: اختبار خاصية رياضية ═══")
# ==============================================================

دالة الضرب_توزيعي(أ، ب، ج)
    ارجع أ * (ب + ج) == أ * ب + أ * ج
نهاية

اختبر("خاصية الضرب التوزيعي") تكرارات 20
    متغير أ = _تكرار + 1
    متغير ب = _تكرار * 2
    متغير ج = _تكرار + 3
    إذا (ليس الضرب_توزيعي(أ، ب، ج))
        ارمي "الضرب ليس توزيعياً للقيم: " + أ + "،" + ب + "،" + ج
    نهاية
نهاية

