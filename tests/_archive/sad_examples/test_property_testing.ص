اطبع_سطر("")
اطبع_سطر("═══ القسم 4: متغيرات الاختبار الخاصة ═══")
# ==============================================================

اختبر("التحقق من متغيرات التكرار") تكرارات 3
    # _تكرار: الفهرس (يبدأ من 0)
    # _التكرار_الحالي: الرقم (يبدأ من 1)
    # _إجمالي_التكرارات: المجموع
    # _بذرة: البذرة العشوائية
    
    إذا (_تكرار < 0)
        ارمي "_تكرار سالب"
    نهاية
    
    إذا (_التكرار_الحالي != _تكرار + 1)
        ارمي "_التكرار_الحالي غير متسق"
    نهاية
    
    إذا (_إجمالي_التكرارات != 3)
        ارمي "الإجمالي خاطئ"
    نهاية
نهاية

