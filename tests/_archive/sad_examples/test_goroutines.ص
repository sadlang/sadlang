# اختبار 11: أطلق مع استدعاء دالة
# ==========================================================
متغير نتيجة_متزامنة = 0
متغير ق2 = قناة(1)

دالة عمل_متزامن()
    ق2.أرسل(42)
نهاية

أطلق عمل_متزامن()
انتظر_الكل()
نتيجة_متزامنة = ق2.استقبل()
