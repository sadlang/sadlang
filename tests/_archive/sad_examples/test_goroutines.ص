# ==========================================================
# اختبار 12: أطلق مع قناة — تواصل بين goroutines
# ==========================================================
متغير ق3 = قناة(10)

دالة منتج()
    لكل ر في [1، 2، 3، 4، 5]
        ق3.أرسل(ر)
    نهاية
نهاية

أطلق منتج()
انتظر_الكل()

متغير المجموع = 0
لكل _ في [1، 2، 3، 4، 5]
    المجموع = المجموع + ق3.استقبل()
نهاية
اختبر("أطلق مع قناة — منتج ومستهلك"، المجموع، 15)

