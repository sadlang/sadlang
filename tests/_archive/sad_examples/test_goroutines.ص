# ==========================================================
# اختبار شامل لميزة Goroutines والقنوات
# (AR) يختبر: أطلق، قناة()، أرسل/استقبل، اختر، انتظر_الكل
# ==========================================================

متغير نجاح = 0
متغير فشل = 0
متغير رقم_الاختبار = 0

دالة اختبر(الاسم، القيمة، المتوقع)
    رقم_الاختبار = رقم_الاختبار + 1
    إذا (القيمة == المتوقع)
        اطبع_سطر("✓ " + رقم_الاختبار + ": " + الاسم)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("✗ " + رقم_الاختبار + ": " + الاسم + " — توقعت: " + المتوقع + " حصلت: " + القيمة)
        فشل = فشل + 1
    نهاية
نهاية

# ==========================================================
# اختبار 1: إنشاء قناة مخزّنة (buffered)
# ==========================================================
متغير ق = قناة(5)
اختبر("إنشاء قناة مخزّنة"، نوع(ق) == "object"، صحيح)

# ==========================================================
# اختبار 2: الإرسال والاستقبال عبر قناة مخزّنة
# ==========================================================
ق.أرسل(42)
متغير قيمة = ق.استقبل()
اختبر("إرسال واستقبال قيمة رقم"، قيمة، 42)

# ==========================================================
# اختبار 3: إرسال واستقبال نص
