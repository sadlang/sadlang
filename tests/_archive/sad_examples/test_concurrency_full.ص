# الجزء 5: اختبار القفل مع خيوط متعددة
# ═══════════════════════════════════════════════════════════════
اطبع_سطر("")
اطبع_سطر("=== اختبار القفل مع خيوط ===")

متغير قف2 = قفل()
متغير ق_نتائج = قناة(10)
متغير عداد_آمن = 0

مج = مجموعة_انتظار()
مج.أضف(5)

لكل ت في [1، 2، 3، 4، 5]
    أطلق
        قف2.اقفل()
        # (AR) القسم الحرج — محمي بالقفل
        ق_نتائج.أرسل(ت)
        قف2.افتح()
        مج.أنهي()
    نهاية
نهاية

مج.انتظر()
متغير عد = 0
بينما (ق_نتائج.فارغة() == خطأ)
    ق_نتائج.استقبل()
    عد = عد + 1
نهاية
تحقق("5 خيوط مع قفل أرسلوا 5 نتائج", عد == 5)

