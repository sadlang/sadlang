# ═══════════════════════════════════════════════════════════════

استورد تزامن_متقدم

متغير نجاح = 0
متغير فشل = 0

دالة تحقق(الاسم، الشرط)
    إذا (الشرط)
        اطبع_سطر("✓ " + الاسم)
        نجاح = نجاح + 1
    وإلا
        اطبع_سطر("✗ " + الاسم)
        فشل = فشل + 1
    نهاية
نهاية

