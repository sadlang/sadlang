# اختبار ميزات متنوعة في المترجم
# الهدف: اكتشاف المشاكل العملية

# === 1. الخرائط (Maps) ===

استورد رياضيات

متغير خ = {"اسم": "أحمد"، "عمر": 25}
اطبع_سطر(خ["اسم"])
اطبع_سطر(خ["عمر"])

# === 2. Lambda بسيطة ===
متغير جمع = لامدا(أ، ب) أ + ب نهاية
اطبع_سطر(جمع(3، 5))

# === 3. لكل مع مصفوفة ===
متغير أرقام = [1، 2، 3، 4، 5]
متغير مجموع = 0
لكل ر في أرقام
    مجموع = مجموع + ر
نهاية
اطبع_سطر(مجموع)

# === 4. دوال متداخلة ===
دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية
اطبع_سطر(مضروب(5))

# === 5. صنف بسيط ===
صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    دالة عام وصف()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير ن = جديد نقطة(3، 7)
اطبع_سطر(ن.وصف())

# === 6. مطابقة أنماط ===
دالة صنّف(عمر)
    طابق (عمر)
        عندما 0..13:
            ارجع "طفل"
        عندما 13..20:
            ارجع "مراهق"
        افتراضي:
            ارجع "بالغ"
    نهاية
نهاية
اطبع_سطر(صنّف(5))
اطبع_سطر(صنّف(15))
اطبع_سطر(صنّف(30))

# === 7. try/catch ===
حاول
    ارمي "خطأ تجريبي"
امسك خطأ
    اطبع_سطر("تم التقاط: " + خطأ)
نهاية

# === 8. F-strings ===
متغير اسم = "عالم"
اطبع_سطر("مرحبا يا ${اسم}!")

اطبع_سطر("نجاح")
