# ==========================================================
# اختبار جملة اختر (select)
# ==========================================================

# --- اختبار 1: اختر مع قناة جاهزة ---
متغير ق1 = قناة(5)
ق1.أرسل(42)

متغير نتيجة1 = 0
اختر
    عندما ق1.حاول_استقبل():
        نتيجة1 = 1
    افتراضي:
        نتيجة1 = 2
نهاية
اطبع_سطر("اختبار 1 — قناة جاهزة: " + نتيجة1)

# --- اختبار 2: اختر مع الحالة الافتراضية ---
متغير ق2 = قناة(5)
# ق2 فارغة — حاول_استقبل يُرجع VOID

متغير نتيجة2 = 0
اختر
    عندما ق2.حاول_استقبل():
        نتيجة2 = 1
    افتراضي:
        نتيجة2 = 2
نهاية
اطبع_سطر("اختبار 2 — افتراضي: " + نتيجة2)

# --- اختبار 3: اختر مع عدة قنوات ---
متغير قأ = قناة(5)
متغير قب = قناة(5)
قب.أرسل(99)

متغير نتيجة3 = 0
اختر
    عندما قأ.حاول_استقبل():
        نتيجة3 = 1
    عندما قب.حاول_استقبل():
        نتيجة3 = 2
    افتراضي:
        نتيجة3 = 3
نهاية
اطبع_سطر("اختبار 3 — القناة الثانية جاهزة: " + نتيجة3)

اطبع_سطر("اكتملت اختبارات اختر")
