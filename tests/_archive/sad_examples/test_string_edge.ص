# اختبار حالات حدية لجمع النصوص

# 1. نص فارغ + نص فارغ
متغير أ = "" + ""
اطبع_سطر("فارغ:[" + أ + "]")

# 2. جمع نص في حلقة
متغير نتيجة = ""
لكل ي في [1، 2، 3]
    نتيجة = نتيجة + ي + " "
نهاية
اطبع_سطر("حلقة:" + نتيجة)

# 3. جمع نص طويل
متغير طويل = "أبجد هوز حطي كلمن سعفص قرشت ثخذ ضظغ"
متغير مكرر = طويل + " " + طويل
اطبع_سطر("طول:" + مكرر)

# 4. جمع نص محلي داخل دالة
دالة اختبار_محلي()
    متغير س = "محلي"
    متغير ع = س + " ثم " + س
    ارجع ع
نهاية
اطبع_سطر(اختبار_محلي())

# 5. جمع عدة أنواع
متغير رقم = 42
متغير منطق = صحيح
اطبع_سطر("رقم=" + رقم + " منطق=" + منطق)
