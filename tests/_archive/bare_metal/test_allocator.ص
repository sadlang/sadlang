// اختبار المُخصص — bump allocator يخصص ويُحرر
// Test: Allocator — bump allocator allocates and frees
// ════════════════════════════════════════════════════════════════════════════════

#[بلا_مكتبة_قياسية]
#[نظام_تشغيل("bare_metal")]

ثابت منفذ_التسلسلي: ع16 = 0x3F8

// حجم الكومة / Heap size
ثابت حجم_الكومة: ع64 = 65536  // 64KB

// منطقة الكومة / Heap region
#[قسم(".bss")]
متغير كومة: [ع8; 65536] = [0; 65536]
متغير مؤشر_الكومة: ع64 = 0

// تهيئة المنفذ التسلسلي / Initialize serial port
دالة تهيئة_تسلسلي() {
    منفذ_كتابة(منفذ_التسلسلي + 1, 0x00)
    منفذ_كتابة(منفذ_التسلسلي + 3, 0x80)
    منفذ_كتابة(منفذ_التسلسلي + 0, 0x03)
    منفذ_كتابة(منفذ_التسلسلي + 1, 0x00)
    منفذ_كتابة(منفذ_التسلسلي + 3, 0x03)
    منفذ_كتابة(منفذ_التسلسلي + 2, 0xC7)
    منفذ_كتابة(منفذ_التسلسلي + 4, 0x0B)
}

دالة كتابة_حرف(ح: ع8) {
    طالما (منفذ_قراءة(منفذ_التسلسلي + 5) & 0x20) == 0 {}
    منفذ_كتابة(منفذ_التسلسلي, ح)
}

// مُخصص bump / Bump allocator
دالة خصص(حجم: ع64, محاذاة: ع64) -> *متغير ع8 {
    // محاذاة المؤشر / Align pointer
    متغير محاذاة_حالية = (مؤشر_الكومة + محاذاة - 1) & !(محاذاة - 1)
    
    إذا محاذاة_حالية + حجم > حجم_الكومة {
        أرجع 0 ك *متغير ع8  // فشل التخصيص / Allocation failure
    }
    
    متغير نتيجة = عنوان(&كومة[محاذاة_حالية])
    مؤشر_الكومة = محاذاة_حالية + حجم
    أرجع نتيجة ك *متغير ع8
}

// إعادة تعيين المُخصص / Reset allocator
دالة إعادة_تعيين() {
    مؤشر_الكومة = 0
}

// اختبار التخصيص الأساسي / Test basic allocation
دالة اختبار_تخصيص_أساسي() -> منطقي {
    إعادة_تعيين()
    
    // تخصيص 256 بايت / Allocate 256 bytes
    متغير ذاكرة1 = خصص(256, 8)
    إذا ذاكرة1 == (0 ك *متغير ع8) {
        أرجع خطأ
    }
    
    // تخصيص 512 بايت آخر / Allocate another 512 bytes
    متغير ذاكرة2 = خصص(512, 8)
    إذا ذاكرة2 == (0 ك *متغير ع8) {
        أرجع خطأ
    }
    
    // التحقق أنهما مختلفان / Verify they're different
    إذا ذاكرة1 == ذاكرة2 {
        أرجع خطأ
    }
    
    // كتابة والقراءة / Write and read back
    *ذاكرة1 = 0x42
    *(ذاكرة2 ك *متغير ع8) = 0x55
    
    أرجع *ذاكرة1 == 0x42 && *(ذاكرة2 ك *متغير ع8) == 0x55
}

// اختبار المحاذاة / Test alignment
دالة اختبار_محاذاة() -> منطقي {
    إعادة_تعيين()
    
    // تخصيص بمحاذاة 1 / Allocate with alignment 1
    متغير م1 = خصص(1, 1)
    
    // تخصيص بمحاذاة 16 / Allocate with alignment 16
    متغير م2 = خصص(32, 16)
    
    // التحقق أن م2 محاذاة لـ 16 / Verify m2 is 16-aligned
    أرجع ((م2 ك ع64) % 16) == 0
}

// اختبار امتلاء الكومة / Test heap exhaustion
دالة اختبار_امتلاء() -> منطقي {
    إعادة_تعيين()
    
    // محاولة تخصيص أكثر من الكومة / Try to allocate more than heap
    متغير كبير = خصص(حجم_الكومة + 1, 8)
    
    // يجب أن يُرجع null / Should return null
    أرجع كبير == (0 ك *متغير ع8)
}

// نقطة الدخول / Entry point
#[نقطة_دخول]
دالة _start() -> ! {
    تهيئة_تسلسلي()
    
    متغير كل_نجح = صحيح
    
    إذا !اختبار_تخصيص_أساسي() {
        كتابة_حرف(0x31)  // 1 — فشل أساسي / basic fail
        كل_نجح = خطأ
    }
    
    إذا !اختبار_محاذاة() {
        كتابة_حرف(0x32)  // 2 — فشل محاذاة / align fail
        كل_نجح = خطأ
    }
    
    إذا !اختبار_امتلاء() {
        كتابة_حرف(0x33)  // 3 — فشل امتلاء / exhaustion fail
        كل_نجح = خطأ
    }
    
    إذا كل_نجح {
        // "ALLOC OK"
        كتابة_حرف(0x41)  // A
        كتابة_حرف(0x4C)  // L
        كتابة_حرف(0x4C)  // L
        كتابة_حرف(0x4F)  // O
        كتابة_حرف(0x43)  // C
        كتابة_حرف(0x20)  // (space)
        كتابة_حرف(0x4F)  // O
        كتابة_حرف(0x4B)  // K
    } وإلا {
        كتابة_حرف(0x46)  // F
        كتابة_حرف(0x41)  // A
        كتابة_حرف(0x49)  // I
        كتابة_حرف(0x4C)  // L
    }
    
    كتابة_حرف(0x0A)  // \n
    
    // الخروج من QEMU / Exit QEMU
    منفذ_كتابة(0xF4, 0x00)
    
    حلقة {
        توقف()
    }
}
