# اختبار P04: OR مع strings مشتركة المعنى
# هدف: pattern OR لأسماء مترادفة تؤدي لنفس الفرع
# المخرج: 8 رسائل تعيين رقمي

دالة تعرف_رقم(نص_رقم)
    طابق (نص_رقم)
        عندما "صفر" || "لاشيء" || "0":
            ارجع 0
        عندما "واحد" || "1":
            ارجع 1
        عندما "اثنان" || "2":
            ارجع 2
        افتراضي:
            ارجع -1
    نهاية
نهاية

لكل إدخال في ["صفر"، "لاشيء"، "0"، "واحد"، "1"، "اثنان"، "2"، "ثلاثة"]
    اطبع_سطر(إدخال + " > " + نص(تعرف_رقم(إدخال)))
نهاية
