# اختبار L09: لكل مع match يصنف العناصر
# هدف: حلقة تطبع قوائم مصنّفة حسب النوع
# المخرج: قائمة أولية وقائمة مركبة

دالة طباعة_نطاق(نوع)
    طابق (نوع)
        عندما "أولي":
            لكل رقم في [2، 3، 5، 7]
                اطبع_سطر("أولي: " + نص(رقم))
            نهاية
        عندما "مركب":
            لكل رقم في [4، 6، 8، 9]
                اطبع_سطر("مركب: " + نص(رقم))
            نهاية
        افتراضي:
            اطبع_سطر("لا شيء")
    نهاية
نهاية

طباعة_نطاق("أولي")
طباعة_نطاق("مركب")
