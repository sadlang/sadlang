##
# X10: طابق على نتيجة دالة مباشرة + binding مزدوج
# سيناريو: نظام تحقق متعدد المستويات
##

دالة احسب_مجموع(قائمة)
    متغير مجموع = 0
    لكل عنصر في قائمة
        مجموع = مجموع + عنصر
    نهاية
    ارجع مجموع
نهاية

دالة تحقق_مجموع(قائمة)
    طابق (احسب_مجموع(قائمة))
        عندما 0:
            ارجع "مجموع صفر"
        عندما م إذا م < 0:
            ارجع "مجموع سالب: " + م
        عندما م إذا م > 0 && م <= 100:
            ارجع "صغير: " + م
        عندما م إذا م > 100 && م <= 1000:
            ارجع "متوسط: " + م
        افتراضي:
            ارجع "كبير: " + احسب_مجموع(قائمة)
    نهاية
نهاية

اطبع_سطر(تحقق_مجموع([0، 0، 0]))
اطبع_سطر(تحقق_مجموع([-5، 3، -2]))
اطبع_سطر(تحقق_مجموع([10، 20، 30]))
اطبع_سطر(تحقق_مجموع([100، 200، 300]))
اطبع_سطر(تحقق_مجموع([500، 600، 700]))

##
# طابق متسلسل — كل طابق يستخدم نتيجة السابق
##
دالة تحليل_متسلسل(ق)
    متغير مرحلة1 = "أ"
    متغير مرحلة2 = "أ"
    متغير مرحلة3 = "أ"

    طابق (ق % 2)
        عندما 0: مرحلة1 = "زوجي"
        افتراضي: مرحلة1 = "فردي"
    نهاية

    طابق (ق % 3)
        عندما 0: مرحلة2 = "مضاعف3"
        افتراضي: مرحلة2 = "ليس_مضاعف3"
    نهاية

    طابق (ق % 5)
        عندما 0: مرحلة3 = "مضاعف5"
        افتراضي: مرحلة3 = "ليس_مضاعف5"
    نهاية

    ارجع مرحلة1 + "-" + مرحلة2 + "-" + مرحلة3
نهاية

اطبع_سطر(تحليل_متسلسل(30))
اطبع_سطر(تحليل_متسلسل(15))
اطبع_سطر(تحليل_متسلسل(7))
اطبع_سطر(تحليل_متسلسل(4))
