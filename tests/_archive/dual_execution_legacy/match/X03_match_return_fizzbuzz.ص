##
# X03: طابق + ارجع من دالة (استخدام طابق كتعبير يُحدد القيمة المرجوعة)
# سيناريو: حساب معامل نمو يعتمد على متعددات شروط
##

دالة احسب_معامل(رقم)
    # الحالة 1: مضاعف 15 (مضاعف 3 و5) — مرتبة عالية
    طابق (رقم % 15)
        عندما 0:
            ارجع "فيزباز"
    نهاية

    # الحالة 2: مضاعف 5
    طابق (رقم % 5)
        عندما 0:
            ارجع "باز"
    نهاية

    # الحالة 3: مضاعف 3
    طابق (رقم % 3)
        عندما 0:
            ارجع "فيز"
    نهاية

    # الحالة 4: الرقم نفسه
    ارجع نص(رقم)
نهاية

# اختبار من 1 إلى 20
متغير ع = 1
بينما (ع <= 20)
    اطبع_سطر(احسب_معامل(ع))
    ع = ع + 1
نهاية
