# اختبار L10: match يتحكم في قيمة عداد حلقة
# هدف: حلقة تجمع قيماً حسب match لكل عنصر
# المخرج: 100 (10+20+30+40+0)

متغير إجمالي = 0
متغير قائمة = ["x1"، "x2"، "x3"، "x4"، "x5"]

لكل عنصر في قائمة
    متغير قيمة = 0
    طابق (عنصر)
        عندما "x1":
            قيمة = 10
        عندما "x2":
            قيمة = 20
        عندما "x3":
            قيمة = 30
        عندما "x4":
            قيمة = 40
        افتراضي:
            قيمة = 0
    نهاية
    إجمالي = إجمالي + قيمة
نهاية

اطبع_سطر(نص(إجمالي))
