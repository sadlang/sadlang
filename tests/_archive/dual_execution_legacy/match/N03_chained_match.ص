# اختبار N03: match متسلسل (chained) — نتيجة match تدخل match آخر
# هدف: تصنيف ثنائي المرحلة
# المخرج: 3 رسائل تصنيف مزدوج

دالة تصنيف_أولي(رقم)
    طابق (رقم)
        عندما 1..33:
            ارجع "منخفض"
        عندما 34..66:
            ارجع "متوسط"
        افتراضي:
            ارجع "مرتفع"
    نهاية
نهاية

دالة تصنيف_ثانوي(تصنيف)
    طابق (تصنيف)
        عندما "منخفض":
            ارجع "D"
        عندما "متوسط":
            ارجع "B"
        عندما "مرتفع":
            ارجع "A"
        افتراضي:
            ارجع "X"
    نهاية
نهاية

لكل رقم في [15، 50، 85]
    متغير ت1 = تصنيف_أولي(رقم)
    متغير ت2 = تصنيف_ثانوي(ت1)
    اطبع_سطر(نص(رقم) + ": " + ت1 + " > " + ت2)
نهاية
