# اختبار N09: match متداخل داخل match arm
# هدف: match ثانوي داخل حالة match رئيسي
# المخرج: 6 تصنيفات مزدوجة

دالة تصنيف_مزدوج(فئة، تفصيل)
    طابق (فئة)
        عندما "أ":
            طابق (تفصيل)
                عندما 1:
                    ارجع "أ1"
                عندما 2:
                    ارجع "أ2"
                افتراضي:
                    ارجع "أ-آخر"
            نهاية
        عندما "ب":
            طابق (تفصيل)
                عندما 1:
                    ارجع "ب1"
                افتراضي:
                    ارجع "ب-آخر"
            نهاية
        افتراضي:
            ارجع "غير معروف"
    نهاية
نهاية

اطبع_سطر(تصنيف_مزدوج("أ"، 1))
اطبع_سطر(تصنيف_مزدوج("أ"، 2))
اطبع_سطر(تصنيف_مزدوج("أ"، 5))
اطبع_سطر(تصنيف_مزدوج("ب"، 1))
اطبع_سطر(تصنيف_مزدوج("ب"، 3))
اطبع_سطر(تصنيف_مزدوج("ج"، 1))
