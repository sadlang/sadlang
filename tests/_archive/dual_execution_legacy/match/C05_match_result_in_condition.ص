# اختبار C05: نتيجة match في شرط إذا
# هدف: متغير يُملأ من match ثم يُفحص في إذا
# المخرج: 4 رسائل ناجح/راسب

دالة حدد_تصنيف(قيمة)
    متغير تصنيف = ""
    طابق (قيمة)
        عندما 1..33:
            تصنيف = "منخفض"
        عندما 34..66:
            تصنيف = "متوسط"
        عندما 67..100:
            تصنيف = "مرتفع"
        افتراضي:
            تصنيف = "خارج النطاق"
    نهاية
    إذا (تصنيف == "مرتفع" أو تصنيف == "متوسط")
        اطبع_سطر(نص(قيمة) + ": ناجح (" + تصنيف + ")")
    وإلا
        اطبع_سطر(نص(قيمة) + ": راسب (" + تصنيف + ")")
    نهاية
نهاية

حدد_تصنيف(20)
حدد_تصنيف(50)
حدد_تصنيف(85)
حدد_تصنيف(105)
