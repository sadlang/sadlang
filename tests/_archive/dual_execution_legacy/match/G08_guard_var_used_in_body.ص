# @description المتغير المربوط في guard يُستخدم في جسم الحالة مباشرة
# @priority P1
# @expected G08:مربع_هو:49
# @expected G08:ضعف_هو:20
# @expected G08:غير_مؤهل
#
# الهدف: التأكد أن المتغير المربوط ن يُرى في جسم الحالة
# ويمكن استخدامه في حسابات منفصلة (مربع / ضعف / إلخ)

دالة حسب_القيمة(ق)
    متغير نتيجة = ""
    طابق (ق)
        عندما ن إذا ن > 5:
            # استخدام ن في حساب معقد داخل الجسم
            متغير مربع = ن * ن
            نتيجة = "مربع_هو:" + مربع
        عندما ن إذا ن > 0:
            # استخدام ن في حساب مختلف
            متغير ضعف = ن * 2
            نتيجة = "ضعف_هو:" + ضعف
        افتراضي:
            نتيجة = "غير_مؤهل"
    نهاية
    ارجع نتيجة
نهاية

# 7 > 5 → مربع_هو:49
اطبع_سطر("G08:" + حسب_القيمة(7))

# 10 لا يُطابق ن > 20، لكن يُطابق ن > 0 → ضعف_هو:20
دالة حسب_القيمة2(ق)
    متغير نتيجة = ""
    طابق (ق)
        عندما ن إذا ن > 20:
            نتيجة = "مستحيل"
        عندما ن إذا ن > 0:
            متغير ضعف = ن * 2
            نتيجة = "ضعف_هو:" + ضعف
        افتراضي:
            نتيجة = "غير_مؤهل"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("G08:" + حسب_القيمة2(10))

# -5 كل guards تفشل → غير_مؤهل
اطبع_سطر("G08:" + حسب_القيمة(-5))
