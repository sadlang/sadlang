# X08: طابق مع try/catch — معالجة الأخطاء داخل الأنماط
# سيناريو: تحويل نصوص إلى أرقام مع معالجة الأخطاء
##

دالة تحليل_أمر(أمر)
    طابق (أمر)
        عندما "توقف":
            ارمي "أمر إيقاف"
        عندما "تحذير":
            ارمي "تحذير مهم"
        عندما "متابعة":
            ارجع "استمرار التشغيل"
        عندما "إعادة":
            ارجع "إعادة التشغيل"
        افتراضي:
            ارجع "أمر: " + أمر
    نهاية
نهاية

متغير أوامر = ["متابعة"، "توقف"، "إعادة"، "تحذير"، "اختبار"]

لكل أ في أوامر
    حاول
        متغير نتيجة = تحليل_أمر(أ)
        اطبع_سطر("نجح: " + نتيجة)
    امسك خطأ
        اطبع_سطر("خطأ: " + خطأ)
    نهاية
نهاية
