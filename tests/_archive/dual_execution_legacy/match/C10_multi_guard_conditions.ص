# اختبار C10: شروط guards متعددة مع معاملات
# هدف: match مع guards تستخدم معاملات متعددة من الدالة
# المخرج: 5 رسائل تصنيف

دالة تصنيف_متعدد(قيمة، نوع)
    طابق (قيمة)
        عندما ق إذا (ق > 0 و ق < 10 و نوع == "أ"):
            اطبع_سطر("فئة أ صغيرة")
        عندما ق إذا (ق >= 10 و نوع == "أ"):
            اطبع_سطر("فئة أ كبيرة")
        عندما ق إذا (ق > 0 و نوع == "ب"):
            اطبع_سطر("فئة ب موجبة")
        افتراضي:
            اطبع_سطر("أخرى")
    نهاية
نهاية

تصنيف_متعدد(5، "أ")
تصنيف_متعدد(15، "أ")
تصنيف_متعدد(7، "ب")
تصنيف_متعدد(-1، "أ")
تصنيف_متعدد(5، "ج")
