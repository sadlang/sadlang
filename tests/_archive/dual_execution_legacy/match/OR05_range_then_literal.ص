# @description OR pattern: range ثم literal — النطاق أولاً ثم رقم خاص
# @priority P1
# @expected OR05:في_النطاق
# @expected OR05:خاص
# @expected OR05:خارج
#
# الهدف: اختبار OR مع range كبديل أول ثم literal كبديل ثانٍ
# القيمة 5 تطابق range 1..10
# القيمة 100 تطابق literal 100
# القيمة 50 لا تطابق أياً منهما (نطاق 1..10 فقط)

دالة تصنيف(ن)
    متغير نتيجة = ""
    طابق (ن)
        عندما 1..10 || 100:
            طابق (ن)
                عندما 1..10:
                    نتيجة = "في_النطاق"
                عندما 100:
                    نتيجة = "خاص"
            نهاية
        افتراضي:
            نتيجة = "خارج"
    نهاية
    ارجع نتيجة
نهاية

اطبع_سطر("OR05:" + تصنيف(5))
اطبع_سطر("OR05:" + تصنيف(100))
اطبع_سطر("OR05:" + تصنيف(50))
