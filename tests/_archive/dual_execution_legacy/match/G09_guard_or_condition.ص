# @description guard مع OR (||) في الشرط
# @priority P1
# @expected G09:حرف_خاص:0
# @expected G09:حرف_خاص:1
# @expected G09:حرف_خاص:9
# @expected G09:آخر:5
#
# الهدف: guard يستخدم OR (||) لتحقق من حالات متعددة في شرط واحد
# الأرقام 0, 1, 9 حروف خاصة — البقية عادية

دالة هل_خاص(ن)
    متغير نتيجة = ""
    متغير قيمة = 0
    طابق (ن)
        عندما ق إذا ق == 0 || ق == 1 || ق == 9:
            نتيجة = "حرف_خاص"
            قيمة = ق
        عندما ق:
            نتيجة = "آخر"
            قيمة = ق
    نهاية
    ارجع نتيجة + ":" + قيمة
نهاية

اطبع_سطر("G09:" + هل_خاص(0))
اطبع_سطر("G09:" + هل_خاص(1))
اطبع_سطر("G09:" + هل_خاص(9))
اطبع_سطر("G09:" + هل_خاص(5))
