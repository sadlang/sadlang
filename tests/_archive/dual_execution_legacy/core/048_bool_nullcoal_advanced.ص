# @description اختبار متقدم للتحويل المنطقي + الاندماج الفارغ + ارجع من try مع finally
# @expected B1:صحيح\nB2:خطأ\nN1:7\nN2:99\nT24:FINALLY\nT24:من_try
# @priority P1

# ============================================================
# B: تحقق تحويل منطقي -> طباعة نصية صحيحة
# ============================================================
اطبع_سطر("B1:" + منطقي(1))
اطبع_سطر("B2:" + منطقي(0))

# ============================================================
# N: تحقق ?? مع قيمة Register (وليس ثابتاً فقط)
# ============================================================
دالة قيمة_او_لاشيء(س)
	إذا (س > 0)
		ارجع س
	نهاية
	ارجع لاشيء
نهاية

متغير أ = قيمة_او_لاشيء(7)
متغير ب = أ ?? 99
اطبع_سطر("N1:" + ب)

متغير ج = قيمة_او_لاشيء(-1) ?? 99
اطبع_سطر("N2:" + ج)

# ============================================================
# T24: ارجع من try body + finally مضمون
# ============================================================
دالة t24_ارجع_من_try()
	حاول
		ارجع "من_try"
	امسك خ
		ارجع "من_catch"
	أخيراً
		اطبع_سطر("T24:FINALLY")
	نهاية
نهاية

اطبع_سطر("T24:" + t24_ارجع_من_try())
