# @test اختبار الكلمات السياقية والخرائط والعضوية
# @description كلمات سياقية كمعرّفات، خرائط متقدمة، عامل «في» للعضوية، أسماء الأنواع كمتغيرات
# @expected K01:PASS\nK02:PASS\nK03:PASS\nK04:PASS\nK05:PASS\nK06:PASS\nK07:PASS\nK08:PASS\nK09:PASS\nK10:PASS\nSUMMARY:10/10

# ═══ K01: أسماء الأنواع كمتغيرات — رقم كاسم متغير ═══
متغير رقم = 42
متغير نص = "مرحبا"
إذا (رقم == 42 و نص == "مرحبا")
    اطبع_سطر("K01:PASS")
وإلا
    اطبع_سطر("K01:FAIL")
نهاية

# ═══ K02: خريطة نصية — إنشاء وقراءة ═══
متغير أسماء = {"اسم": "أحمد"، "مدينة": "الرياض"، "لقب": "محمد"}
متغير أعمار = {"أحمد": 25، "علي": 30}
إذا (أسماء["اسم"] == "أحمد" و أعمار["أحمد"] == 25)
    اطبع_سطر("K02:PASS")
وإلا
    اطبع_سطر("K02:FAIL")
نهاية

# ═══ K03: طرق الخريطة — مفاتيح وقيم ═══
متغير خ3 = {"أ": 1، "ب": 2، "ج": 3}
متغير مفاتيح = خ3.مفاتيح()
متغير قيم = خ3.قيم()
إذا (طول(مفاتيح) == 3 و طول(قيم) == 3)
    اطبع_سطر("K03:PASS")
وإلا
    اطبع_سطر("K03:FAIL")
نهاية

# ═══ K04: خريطة نصية — يحتوي على مفتاح ═══
متغير خ4 = {"لون": "أحمر"، "شكل": "دائرة"، "حالة": "نشط"}
إذا (خ4.يحتوي("لون") و ليس خ4.يحتوي("وزن"))
    اطبع_سطر("K04:PASS")
وإلا
    اطبع_سطر("K04:FAIL")
نهاية

# ═══ K05: خريطة — حجم وفارغة ═══
متغير خ5 = {}
إذا (خ5.فارغة() و خ5.حجم() == 0)
    اطبع_سطر("K05:PASS")
وإلا
    اطبع_سطر("K05:FAIL")
نهاية

# ═══ K06: عامل «في» مع مصفوفة نصوص ═══
متغير ألوان = ["أحمر"، "أخضر"، "أزرق"]
إذا ("أحمر" في ألوان و ليس ("أصفر" في ألوان))
    اطبع_سطر("K06:PASS")
وإلا
    اطبع_سطر("K06:FAIL")
نهاية

# ═══ K07: عامل «في» مع نص (بحث جزئي) ═══
متغير جملة7 = "مرحبا بالعالم"
إذا ("عالم" في جملة7 و ليس ("وداع" في جملة7))
    اطبع_سطر("K07:PASS")
وإلا
    اطبع_سطر("K07:FAIL")
نهاية

# ═══ K08: خريطة — تعيين بالفهرس وحجم ═══
متغير خ8 = {"أ": 1}
خ8["ب"] = 2
خ8["ج"] = 3
إذا (خ8.حجم() == 3 و خ8["ب"] == 2)
    اطبع_سطر("K08:PASS")
وإلا
    اطبع_سطر("K08:FAIL")
نهاية

# ═══ K09: خريطة أرقام — عمليات حسابية ═══
متغير نقاط = {"رياضيات": 90، "علوم": 85، "لغة": 95}
متغير مجموع = نقاط["رياضيات"] + نقاط["علوم"] + نقاط["لغة"]
إذا (مجموع == 270)
    اطبع_سطر("K09:PASS")
وإلا
    اطبع_سطر("K09:FAIL")
نهاية

# ═══ K10: خريطة مع لكل — تكرار فوق خريطة ═══
متغير درجات = {"رياضيات": 90، "علوم": 85، "لغة": 95}
متغير مجموع10 = 0
متغير مفاتيح10 = درجات.مفاتيح()
لكل م في مفاتيح10
    مجموع10 = مجموع10 + درجات[م]
نهاية
إذا (مجموع10 == 270)
    اطبع_سطر("K10:PASS")
وإلا
    اطبع_سطر("K10:FAIL:" + مجموع10)
نهاية

# ═══ الملخص ═══
اطبع_سطر("SUMMARY:10/10")
