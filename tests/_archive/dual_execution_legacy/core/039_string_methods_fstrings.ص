# @test اختبار النصوص المتقدمة
# @description نصوص متقدمة: f-strings، طرق النصوص (تقسيم، استبدل، يحتوي، قص_أطراف، تحويل)
# @expected S01:PASS\nS02:PASS\nS03:PASS\nS04:PASS\nS05:PASS\nS06:PASS\nS07:PASS\nS08:PASS\nS09:PASS\nS10:PASS\nSUMMARY:10/10

# ═══ S01: نصوص منسقة (F-strings) — تعبيرات بسيطة ═══
متغير اسم = "أحمد"
متغير تحية = م"مرحباً {اسم}!"
إذا (تحية == "مرحباً أحمد!")
    اطبع_سطر("S01:PASS")
وإلا
    اطبع_سطر("S01:FAIL:" + تحية)
نهاية

# ═══ S02: F-strings — تعبيرات حسابية ═══
متغير س = 5
متغير ص = 3
متغير نتيجة = م"{س} + {ص} = {س + ص}"
إذا (نتيجة == "5 + 3 = 8")
    اطبع_سطر("S02:PASS")
وإلا
    اطبع_سطر("S02:FAIL:" + نتيجة)
نهاية

# ═══ S03: طريقة يحتوي — فحص وجود نص فرعي ═══
متغير جملة = "لغة ص رائعة"
إذا (جملة.يحتوي("ص") و ليس جملة.يحتوي("xyz"))
    اطبع_سطر("S03:PASS")
وإلا
    اطبع_سطر("S03:FAIL")
نهاية

# ═══ S04: طريقة قسم — فصل نص بفاصل ═══
متغير نص = "أحمر,أخضر,أزرق"
متغير أجزاء = نص.قسم(",")
إذا (طول(أجزاء) == 3 و أجزاء[0] == "أحمر" و أجزاء[2] == "أزرق")
    اطبع_سطر("S04:PASS")
وإلا
    اطبع_سطر("S04:FAIL")
نهاية

# ═══ S05: طريقة استبدل — استبدال نص فرعي ═══
متغير أصلي = "مرحبا يا عالم"
متغير جديد = أصلي.استبدل("عالم", "ص")
إذا (جديد == "مرحبا يا ص")
    اطبع_سطر("S05:PASS")
وإلا
    اطبع_سطر("S05:FAIL:" + جديد)
نهاية

# ═══ S06: طريقة طول النص ═══
متغير كلمة = "سلام"
إذا (كلمة.طول() == 4)
    اطبع_سطر("S06:PASS")
وإلا
    اطبع_سطر("S06:FAIL:" + كلمة.طول())
نهاية

# ═══ S07: طريقة يبدأ_بـ و ينتهي_بـ ═══
متغير مسار = "ملفات/صور/لوحة.png"
إذا (مسار.يبدأ_بـ("ملفات") و مسار.ينتهي_بـ(".png"))
    اطبع_سطر("S07:PASS")
وإلا
    اطبع_سطر("S07:FAIL")
نهاية

# ═══ S08: طريقة قص (trim) ═══
متغير مبطن = "  مرحبا  "
متغير مقصوص = مبطن.قص()
إذا (مقصوص == "مرحبا")
    اطبع_سطر("S08:PASS")
وإلا
    اطبع_سطر("S08:FAIL:" + مقصوص)
نهاية

# ═══ S09: طريقة جزء — استخراج جزء من النص ═══
متغير عبارة = "Hello World"
متغير جزء9 = عبارة.جزء(0، 5)
إذا (جزء9 == "Hello")
    اطبع_سطر("S09:PASS")
وإلا
    اطبع_سطر("S09:FAIL:" + جزء9)
نهاية

# ═══ S10: F-strings مع استدعاء دالة ═══
دالة مضاعف(ق)
    ارجع ق * 2
نهاية
متغير ن10 = م"النتيجة: {مضاعف(21)}"
إذا (ن10 == "النتيجة: 42")
    اطبع_سطر("S10:PASS")
وإلا
    اطبع_سطر("S10:FAIL:" + ن10)
نهاية

# ═══ الملخص ═══
اطبع_سطر("SUMMARY:10/10")
