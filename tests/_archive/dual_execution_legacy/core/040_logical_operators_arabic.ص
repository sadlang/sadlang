# @test اختبار العوامل المنطقية العربية
# @description العوامل المنطقية: و/أو/ليس مع &&/||/! — تكافؤ وأولويات وتعبيرات مركبة
# @expected G01:PASS\nG02:PASS\nG03:PASS\nG04:PASS\nG05:PASS\nG06:PASS\nG07:PASS\nG08:PASS\nG09:PASS\nG10:PASS\nSUMMARY:10/10

# ═══ G01: عامل «و» — AND أساسي ═══
إذا (صحيح و صحيح)
    اطبع_سطر("G01:PASS")
وإلا
    اطبع_سطر("G01:FAIL")
نهاية

# ═══ G02: عامل «أو» — OR أساسي ═══
إذا (خطأ أو صحيح)
    اطبع_سطر("G02:PASS")
وإلا
    اطبع_سطر("G02:FAIL")
نهاية

# ═══ G03: عامل «ليس» — NOT أساسي ═══
إذا (ليس خطأ)
    اطبع_سطر("G03:PASS")
وإلا
    اطبع_سطر("G03:FAIL")
نهاية

# ═══ G04: تكافؤ «و» مع && ═══
متغير أ = 5
متغير ب = 10
إذا ((أ > 0 و ب > 0) == (أ > 0 && ب > 0))
    اطبع_سطر("G04:PASS")
وإلا
    اطبع_سطر("G04:FAIL")
نهاية

# ═══ G05: تكافؤ «أو» مع || ═══
إذا ((أ > 100 أو ب > 5) == (أ > 100 || ب > 5))
    اطبع_سطر("G05:PASS")
وإلا
    اطبع_سطر("G05:FAIL")
نهاية

# ═══ G06: تكافؤ «ليس» مع ! ═══
متغير شرط = خطأ
إذا ((ليس شرط) == (!شرط))
    اطبع_سطر("G06:PASS")
وإلا
    اطبع_سطر("G06:FAIL")
نهاية

# ═══ G07: عوامل مركبة — و + أو + ليس ═══
متغير س = 15
إذا ((س > 10 و س < 20) أو (ليس (س == 0)))
    اطبع_سطر("G07:PASS")
وإلا
    اطبع_سطر("G07:FAIL")
نهاية

# ═══ G08: تقييم كسول (Short-circuit) — و ═══
متغير تم = خطأ
دالة تأثير_جانبي()
    تم = صحيح
    ارجع صحيح
نهاية
# خطأ و ... → لا يُنفذ الطرف الأيمن
إذا (خطأ و تأثير_جانبي())
    # لا يُنفذ
نهاية
إذا (ليس تم)
    اطبع_سطر("G08:PASS")
وإلا
    اطبع_سطر("G08:FAIL")
نهاية

# ═══ G09: تقييم كسول — أو ═══
متغير تم2 = خطأ
دالة تأثير2()
    تم2 = صحيح
    ارجع صحيح
نهاية
# صحيح أو ... → لا يُنفذ الطرف الأيمن
إذا (صحيح أو تأثير2())
    # نُفذ
نهاية
إذا (ليس تم2)
    اطبع_سطر("G09:PASS")
وإلا
    اطبع_سطر("G09:FAIL")
نهاية

# ═══ G10: أولويات — «ليس» أقوى من «و» أقوى من «أو» ═══
# ليس خطأ و صحيح → (ليس خطأ) و صحيح → صحيح و صحيح → صحيح
# خطأ أو صحيح و خطأ → خطأ أو (صحيح و خطأ) → خطأ أو خطأ → خطأ
متغير ن1 = ليس خطأ و صحيح
متغير ن2 = خطأ أو صحيح و خطأ
إذا (ن1 == صحيح و ن2 == خطأ)
    اطبع_سطر("G10:PASS")
وإلا
    اطبع_سطر("G10:FAIL")
نهاية

# ═══ الملخص ═══
اطبع_سطر("SUMMARY:10/10")
