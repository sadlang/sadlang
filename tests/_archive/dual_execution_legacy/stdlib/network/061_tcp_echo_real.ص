# @description TCP Echo حقيقي — خادم وعميل عبر goroutine
# @expected صحيح\nصحيح\nصحيح
# @timeout 15000
# @skip_compiler

استورد مقابس

متغير ق_منفذ = قناة(1)

أطلق
    متغير خادم = أنشئ_وصلة()
    خصص_منفذ(خادم، 0)
    انتظر_اتصالات(خادم)
    ق_منفذ.أرسل(منفذ_محلي(خادم))

    حدد_انتظار_الاستقبال(خادم، 5000)
    متغير عميل = اقبل_متصل(خادم)
    إذا (عميل > 0)
        حدد_انتظار_الاستقبال(عميل، 3000)
        متغير رسالة = استقبل_عبر_وصلة(عميل، 256)
        أرسل_عبر_وصلة(عميل، رسالة)
        أغلق_وصلة(عميل)
    نهاية
    أغلق_وصلة(خادم)
نهاية

متغير منفذ = ق_منفذ.استقبل()
اطبع_سطر(منفذ > 0)

متغير وصلة = أنشئ_وصلة()
متغير متصل = اتصل_بـ(وصلة، "127.0.0.1"، منفذ)
اطبع_سطر(متصل)

أرسل_عبر_وصلة(وصلة، "مرحبا من العميل")
حدد_انتظار_الاستقبال(وصلة، 3000)
متغير صدى = استقبل_عبر_وصلة(وصلة، 256)
أغلق_وصلة(وصلة)

انتظر_الكل()
اطبع_سطر(صدى == "مرحبا من العميل")
