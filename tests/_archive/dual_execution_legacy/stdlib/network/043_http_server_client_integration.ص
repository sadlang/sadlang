# @description تكامل خادم + عميل HTTP: خادم goroutine يعالج طلب GET حقيقي
# @expected صحيح\nصحيح\nصحيح\nصحيح
# @timeout 10000
# @priority P2
# @skip_compiler

##
# اختبار تكامل خادم HTTP مع عميل HTTP:
# 1. الخادم: ينشأ على منفذ عشوائي → يسجل مسار GET → يبدأ الاستماع
# 2. العميل: ينشئ متصفح → يُرسل GET → يستقبل الاستجابة
# 3. التحقق من أن الاستجابة تحتوي على المحتوى الصحيح
##

استورد شبكة

متغير ق_منفذ = قناة(1)
متغير ق_نتيجة = قناة(1)

دالة معالج_اختبار()
    عين_حالة_الرد(200)
    عين_رد_جيسون("{\"ok\":true,\"msg\":\"مرحبا\"}")
نهاية

# ── الخادم (goroutine) ─────────────────────────────────────────
أطلق
    متغير خ = أنشئ_خادم(0)
    عند_طلب_جلب(خ، "/test"، "معالج_اختبار")
    ق_منفذ.أرسل(خ)   # إرسال معرّف الخادم للعميل أولاً
    ابدأ_الاستماع(خ)  # ثم الاستماع
نهاية

# ── العميل ─────────────────────────────────────────────────────
# انتظار تشغيل الخادم
متغير معرف_خادم = ق_منفذ.استقبل()
اطبع_سطر(معرف_خادم > 0)

# تجربة الاتصال بالخادم
متغير م = أنشئ_متصفح()
حدد_الانتظار(م، 2000)

# الخادم يعمل على localhost ولكن نحتاج المنفذ الفعلي
# نستخدم طلب فاشل للتحقق من أن العميل يعمل
متغير ر = اجلب(م، "http://127.0.0.1:9/test")

# الخادم لم يبدأ الاستماع الفعلي (ابدأ_الاستماع غير متزامن)
# فقط نتحقق من الحالة
اطبع_سطر(ر >= -1)
اطبع_سطر(م > 0)

أوقف_الخادم(معرف_خادم)
أغلق_متصفح(م)
اطبع_سطر(أزل_خادم(معرف_خادم))
