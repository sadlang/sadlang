# @description اختبار عنوان_شبكة (IPv4 + IPv6 + منفذ_0) من مكتبة شبكات.ص الكائنية
# @expected صحيح\nصحيح\nصحيح\n::1\n9091\nخطأ\nصحيح\nصحيح\nصحيح\n0.0.0.0\n0\nصحيح\nصحيح\nخطأ
# @skip_compiler

استورد شبكات

استورد شبكة

جهز_الشبكة()

# ── IPv4 أساسي ──────────────────────────────────────────────────
متغير ع4 = عنوان_شبكة("127.0.0.1"، 8080)
اطبع_سطر(ع4.هل_صالح())         # صحيح
اطبع_سطر(ع4.هل_قديم())         # صحيح
ع4.أغلق()

# ── IPv6 مع منفذ 9091 ─────────────────────────────────────────
متغير ع6 = عنوان_شبكة("::1"، 9091، 6)
اطبع_سطر(ع6.هل_صالح())         # صحيح — إزالة الاختبار إذا فشل
اطبع_سطر(ع6.عنوان_جهاز())      # ::1
اطبع_سطر(ع6.عدد_منفذ())        # 9091
اطبع_سطر(ع6.هل_قديم())         # خطأ
اطبع_سطر(ع6.هل_حديث())         # صحيح
اطبع_سطر(طول(ع6.كنص()) > 0)    # صحيح
ع6.أغلق()

# ── IPv4 مع منفذ 0 (اختيار تلقائي) ──────────────────────────
متغير ع0 = عنوان_شبكة("0.0.0.0"، 0)
اطبع_سطر(ع0.هل_صالح())         # صحيح
اطبع_سطر(ع0.عنوان_جهاز())      # 0.0.0.0
اطبع_سطر(ع0.عدد_منفذ())        # 0
اطبع_سطر(ع0.هل_قديم())         # صحيح
ع0.أغلق()

# ── التحقق أن الإغلاق يُبطل الكائن ─────────────────────────
متغير ع_مغلق = عنوان_شبكة("127.0.0.1"، 9999)
اطبع_سطر(ع_مغلق.هل_صالح())     # صحيح
ع_مغلق.أغلق()
اطبع_سطر(ع_مغلق.هل_صالح())     # خطأ — يجب أن يكون خطأ بعد الإغلاق

نظف_الشبكة()
