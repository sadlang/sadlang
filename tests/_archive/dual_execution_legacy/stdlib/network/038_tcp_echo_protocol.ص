# @description بروتوكول TCP Echo كامل: خادم يُعيد ما يستقبله للعميل
# @expected صحيح\nصحيح\nصحيح
# @timeout 10000
# @priority P2
# @skip_compiler

##
# اختبار بروتوكول Echo TCP الكامل:
# 1. خادم Echo: يقبل اتصالاً → يستقبل البيانات → يُعيدها للعميل
# 2. العميل: يتصل → يُرسل نص → يستقبل نفس النص → يُغلق
# التحقق: ما أُرسل = ما استُقبل (صدى حقيقي)
##

استورد مقابس

متغير ق_منفذ = قناة(1)
متغير ق_صدى = قناة(1)

# ── خادم Echo (goroutine) ───────────────────────────────────────
أطلق
    متغير خادم = أنشئ_وصلة()
    خصص_منفذ(خادم، 0)
    انتظر_اتصالات(خادم)
    ق_منفذ.أرسل(منفذ_محلي(خادم))

    # قبول الاتصال
    حدد_انتظار_الاستقبال(خادم، 5000)
    متغير عميل = اقبل_متصل(خادم)
    إذا (عميل > 0)
        حدد_انتظار_الاستقبال(عميل، 3000)
        # استقبال الرسالة وإعادتها (Echo)
        متغير رسالة = استقبل_عبر_وصلة(عميل، 128)
        أرسل_عبر_وصلة(عميل، رسالة)
        أغلق_وصلة(عميل)
    نهاية
    أغلق_وصلة(خادم)
نهاية

# ── العميل ─────────────────────────────────────────────────────
متغير م = ق_منفذ.استقبل()
اطبع_سطر(م > 0)

متغير وصلة = أنشئ_وصلة()
متغير متصل = اتصل_بـ(وصلة، "127.0.0.1"، م)
اطبع_سطر(متصل)

متغير نص_أصلي = "مرحبا-صدى-123"
أرسل_عبر_وصلة(وصلة، نص_أصلي)

# استقبال الصدى
حدد_انتظار_الاستقبال(وصلة، 3000)
متغير صدى = استقبل_عبر_وصلة(وصلة، 128)
أغلق_وصلة(وصلة)

انتظر_الكل()

# التحقق من صحة الصدى
اطبع_سطر(صدى == نص_أصلي)
