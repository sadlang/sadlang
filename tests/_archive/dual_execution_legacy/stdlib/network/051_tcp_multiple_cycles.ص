استورد مقابس

# دورة كاملة × 10 — إنشاء، ربط، إغلاق، مع تحقق بعد كل دورة
متغير عداد = 0
بينما (عداد < 10)
    متغير م = أنشئ_وصلة()
    خصص_منفذ(م، 0)
    انتظر_اتصالات(م)
    متغير منفذ = منفذ_محلي(م)
    اطبع_سطر(منفذ > 0)
    أغلق_وصلة(م)
    عداد = عداد + 1
نهاية
