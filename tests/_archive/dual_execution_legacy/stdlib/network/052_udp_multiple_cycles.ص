# @description دورة حياة UDP متكررة — تحقق من تحرير الموارد
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح

استورد مقابس

متغير عداد = 0
بينما (عداد < 8)
    متغير م = أنشئ_مرسال()
    خصص_منفذ_رسائل(م، 0)
    متغير منفذ = منفذ_محلي(م)
    اطبع_سطر(منفذ > 0)
    أغلق_مرسال(م)
    عداد = عداد + 1
نهاية
