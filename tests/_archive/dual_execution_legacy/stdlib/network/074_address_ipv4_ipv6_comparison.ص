# @description عنوان_شبكة — مقارنة IPv4 و IPv6
# @expected صحيح\nصحيح\nصحيح\nصحيح\nصحيح\nصحيح
# @skip_compiler

استورد شبكات

# IPv4
متغير ع1 = عنوان_شبكة("192.168.1.1"، 8080)
اطبع_سطر(ع1.هل_صالح())
اطبع_سطر(ع1.عدد_منفذ() == 8080)
اطبع_سطر(ع1.هل_قديم())

# IPv6
متغير ع2 = عنوان_شبكة("::1"، 9090، 6)
اطبع_سطر(ع2.هل_صالح())
اطبع_سطر(ع2.عدد_منفذ() == 9090)
اطبع_سطر(ع2.هل_حديث())

ع1.أغلق()
ع2.أغلق()
