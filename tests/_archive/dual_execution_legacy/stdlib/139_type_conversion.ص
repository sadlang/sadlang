# @description: اختبار التحويل بين الأنواع المختلفة
# @expected: 42\n3\n42\nصحيح\nخطأ\nصحيح
# @priority: 1

# تحويل نص إلى رقم
متغير ن = رقم("42")
اطبع_سطر(ن)

# تحويل عشري إلى رقم (اقتطاع)
متغير ع = رقم(3.7)
اطبع_سطر(ع)

# تحويل رقم إلى نص
متغير ص = نص(42)
اطبع_سطر(ص)

# تحويل إلى منطقي
إذا (منطقي(1))
    اطبع_سطر("صحيح")
وإلا
    اطبع_سطر("خطأ")
نهاية

إذا (منطقي(0))
    اطبع_سطر("صحيح")
وإلا
    اطبع_سطر("خطأ")
نهاية

إذا (منطقي("نص"))
    اطبع_سطر("صحيح")
وإلا
    اطبع_سطر("خطأ")
