# @description finally يُنفَّذ دائماً حتى بدون استثناء — مضمون التنفيذ
# @priority P1
# @expected E003:TRY\nE003:FINALLY\nE003:PASS

# ============================================================
# E003: finally يعمل حتى في غياب الاستثناء
# ============================================================

متغير نُفِّذ_finally = خطأ

حاول
    اطبع_سطر("E003:TRY")
أخيراً
    نُفِّذ_finally = صحيح
    اطبع_سطر("E003:FINALLY")
نهاية

إذا (نُفِّذ_finally)
    اطبع_سطر("E003:PASS")
وإلا
    اطبع_سطر("E003:FAIL")
نهاية
