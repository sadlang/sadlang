# @description throw من دالة مُستدعاة — الخطأ ينتشر عبر مكدس الاستدعاء
# @priority P1
# @expected E010:LEVEL1\nE010:LEVEL2\nE010:LEVEL3\nE010:CAUGHT:عمق_3\nE010:PASS

# ============================================================
# E010: throw من مكدس عميق — الانتشار الكامل عبر مستويات الاستدعاء
# ============================================================

متغير مسار10 = ""

دالة مستوى3()
    مسار10 = مسار10 + "L3|"
    اطبع_سطر("E010:LEVEL3")
    ارمي "عمق_3"
نهاية

دالة مستوى2()
    مسار10 = مسار10 + "L2|"
    اطبع_سطر("E010:LEVEL2")
    مستوى3()
نهاية

دالة مستوى1()
    مسار10 = مسار10 + "L1|"
    اطبع_سطر("E010:LEVEL1")
    مستوى2()
نهاية

حاول
    مستوى1()
امسك خ
    اطبع_سطر("E010:CAUGHT:" + خ)
نهاية

إذا (مسار10 == "L1|L2|L3|")
    اطبع_سطر("E010:PASS")
وإلا
    اطبع_سطر("E010:FAIL:" + مسار10)
نهاية
