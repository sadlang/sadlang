# @description throw داخل حلقة — catch خارج الحلقة يوقف التكرار
# @priority P1
# @expected E007:LOOP:0\nE007:LOOP:1\nE007:LOOP:2\nE007:CAUGHT:توقف\nE007:PASS

# ============================================================
# E007: throw داخل for — catch خارج الحلقة يُعالج ويوقف التكرار
# ============================================================

متغير عداد7 = 0

حاول
    لكل ي في [0، 1، 2، 3، 4]
        اطبع_سطر("E007:LOOP:" + ي)
        إذا (ي == 2)
            ارمي "توقف"
        نهاية
        عداد7 = عداد7 + 1
    نهاية
امسك خ
    اطبع_سطر("E007:CAUGHT:" + خ)
نهاية

إذا (عداد7 == 2)
    اطبع_سطر("E007:PASS")
وإلا
    اطبع_سطر("E007:FAIL:عداد=" + عداد7)
نهاية
