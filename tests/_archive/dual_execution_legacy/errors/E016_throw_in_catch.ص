# @description throw داخل catch — الخطأ الجديد ينتشر للمستوى الأعلى
# @priority P1
# @expected E016:INNER_CATCH\nE016:OUTER_CAUGHT:خطأ_ثانوي\nE016:PASS

# ============================================================
# E016: throw داخل catch — ينتشر للـ try الخارجي
# ============================================================

متغير مسار16 = ""

حاول
    حاول
        ارمي "خطأ_أولي"
    امسك خ
        مسار16 = "INNER|"
        اطبع_سطر("E016:INNER_CATCH")
        ارمي "خطأ_ثانوي"
    نهاية
امسك خ
    مسار16 = مسار16 + "OUTER|" + خ
    اطبع_سطر("E016:OUTER_CAUGHT:" + خ)
نهاية

إذا (مسار16 == "INNER|OUTER|خطأ_ثانوي")
    اطبع_سطر("E016:PASS")
وإلا
    اطبع_سطر("E016:FAIL:" + مسار16)
نهاية
