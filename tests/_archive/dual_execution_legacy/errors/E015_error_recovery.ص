# @description الاستثناء لا يمنع تنفيذ catch ثم المتابعة — التعافي الكامل
# @priority P1
# @expected E015:BEFORE\nE015:CAUGHT\nE015:RECOVERED:15\nE015:PASS

# ============================================================
# E015: التعافي من الخطأ — الكود يستمر بعد catch بشكل طبيعي
# ============================================================

متغير قيمة15 = 5

اطبع_سطر("E015:BEFORE")

حاول
    ارمي "خطأ_مؤقت"
امسك خ
    اطبع_سطر("E015:CAUGHT")
    قيمة15 = قيمة15 * 3
نهاية

اطبع_سطر("E015:RECOVERED:" + قيمة15)

إذا (قيمة15 == 15)
    اطبع_سطر("E015:PASS")
وإلا
    اطبع_سطر("E015:FAIL:" + قيمة15)
نهاية
