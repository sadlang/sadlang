# @description catch يحفظ قيمة الخطأ المُرمى — التحقق من محتوى رسالة الخطأ
# @priority P1
# @expected E002:PASS

# ============================================================
# E002: التحقق أن catch يستقبل قيمة الخطأ المرمى بدقة
# ============================================================

متغير التقط = ""

دالة ارمي_رسالة(رسالة)
    ارمي رسالة
نهاية

حاول
    ارمي_رسالة("خطأ_محدد_123")
امسك خ
    التقط = خ
نهاية

إذا (التقط == "خطأ_محدد_123")
    اطبع_سطر("E002:PASS")
وإلا
    اطبع_سطر("E002:FAIL:التقط=" + التقط)
نهاية
