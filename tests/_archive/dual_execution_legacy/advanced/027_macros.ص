# @description اختبار الماكروز — ماكرو بسيط وماكرو تعبيري
# @expected [سجل] مرحبا\n[سجل] اختبار\n25
# @priority P3

# ماكرو بسيط — يطبع رسالة مع بادئة

استورد رياضيات

ماكرو سجّل(رسالة)
    اطبع_سطر("[سجل] " + رسالة)
نهاية

سجّل!("مرحبا")
سجّل!("اختبار")

# ماكرو تعبيري — يُرجع الأكبر
ماكرو أكبر(أ، ب)
    إذا (أ > ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

متغير ن = أكبر!(10، 25)
اطبع_سطر(ن)
