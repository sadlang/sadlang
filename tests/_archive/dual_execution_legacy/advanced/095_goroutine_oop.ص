# @priority P2

# ============================================================
# صنف عامل يعالج مهام عبر قناة
# ============================================================
صنف عامل
    متغير عام الاسم
    باني(اسم)
        هذا.الاسم = اسم
    نهاية
    دالة عام عالج(مهمة)
        ارجع "عامل:" + هذا.الاسم + ":" + مهمة
    نهاية
نهاية

متغير ق_نتائج = قناة(2)
متغير ع1 = عامل("أحمد")
متغير ع2 = عامل("سارة")

# إرسال النتائج عبر القناة
ق_نتائج.أرسل(ع1.عالج("مهمة_1"))
ق_نتائج.أرسل(ع2.عالج("مهمة_2"))

# استقبال وطباعة مباشرة
اطبع_سطر(ق_نتائج.استقبل())
