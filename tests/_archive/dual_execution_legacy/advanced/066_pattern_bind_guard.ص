# @description اختبار أنماط الربط (@) والحراسة (إذا) والنمط الشامل (_) ومتغير النمط
# @expected ربط:عدد=7 في نطاق 1-10\nربط:عدد=15 خارج النطاق\nربط:عدد=3 في نطاق 1-10\nشامل:مجهول\nشامل:مجهول\nحارس:صغير 3\nحارس:كبير 8\nحارس:آخر 50\nمتغير:قيمة=مرحبا\nمتغير:قيمة=42\nمتغير:قيمة=صحيح\nنطاق_ربط:صغير 2\nنطاق_ربط:متوسط 50\nنطاق_ربط:كبير 500\nربط_حارس:قريب 55\nربط_حارس:بعيد 200\nربط_حارس:خارج -5\nسقوط:ب\nسقوط:ج\nسقوط:افتراضي\nمعقد:طويل_زوجي\nمعقد:قصير\nمعقد:آخر
# @priority P2

# ============================================================
# 1. نمط الربط (@ — Binding Pattern)
# ============================================================
دالة وصف_عدد(ن)
    طابق (ن)
        عندما ع @ 1..11:
            اطبع_سطر("ربط:عدد=" + ع + " في نطاق 1-10")
        افتراضي:
            اطبع_سطر("ربط:عدد=" + ن + " خارج النطاق")
    نهاية
نهاية

وصف_عدد(7)
وصف_عدد(15)
وصف_عدد(3)

# ============================================================
# 2. النمط الشامل (_)
# ============================================================
دالة تصنيف_شيء(ق)
    طابق (ق)
        عندما _:
            اطبع_سطر("شامل:مجهول")
    نهاية
نهاية

تصنيف_شيء("أي شيء")
تصنيف_شيء(99)

# ============================================================
# 3. الحارس (إذا)
# ============================================================
دالة تصنيف_بحارس(ن)
    طابق (ن)
        عندما ن إذا ن < 5:
            اطبع_سطر("حارس:صغير " + ن)
        عندما ن إذا ن < 10:
            اطبع_سطر("حارس:كبير " + ن)
        افتراضي:
            اطبع_سطر("حارس:آخر " + ن)
    نهاية
نهاية

تصنيف_بحارس(3)
تصنيف_بحارس(8)
تصنيف_بحارس(50)

# ============================================================
# 4. نمط المتغير (ربط القيمة)
# ============================================================
دالة اعرض_متغير(ق)
    طابق (ق)
        عندما س:
            اطبع_سطر("متغير:قيمة=" + س)
    نهاية
نهاية

اعرض_متغير("مرحبا")
اعرض_متغير(42)
اعرض_متغير(صحيح)

# ============================================================
# 5. ربط مع نطاق
# ============================================================
دالة نطاق_مع_ربط(ن)
    طابق (ن)
        عندما ع @ 1..10:
            اطبع_سطر("نطاق_ربط:صغير " + ع)
        عندما ع @ 10..100:
            اطبع_سطر("نطاق_ربط:متوسط " + ع)
        افتراضي:
            اطبع_سطر("نطاق_ربط:كبير " + ن)
    نهاية
نهاية

نطاق_مع_ربط(2)
نطاق_مع_ربط(50)
نطاق_مع_ربط(500)

# ============================================================
# 6. ربط مع حارس
# ============================================================
دالة ربط_وحارس(ن)
    طابق (ن)
        عندما ع إذا ع > 0 و ع < 100:
            اطبع_سطر("ربط_حارس:قريب " + ع)
        عندما ع إذا ع >= 100:
            اطبع_سطر("ربط_حارس:بعيد " + ع)
        افتراضي:
            اطبع_سطر("ربط_حارس:خارج " + ن)
    نهاية
نهاية

ربط_وحارس(55)
ربط_وحارس(200)
ربط_وحارس(-5)

# ============================================================
# 7. سلسلة عندما (سقوط)
# ============================================================
دالة سقوط_نمط(ح)
    طابق (ح)
        عندما "أ":
            اطبع_سطر("سقوط:أ")
        عندما "ب":
            اطبع_سطر("سقوط:ب")
        عندما "ج":
            اطبع_سطر("سقوط:ج")
        افتراضي:
            اطبع_سطر("سقوط:افتراضي")
    نهاية
نهاية

سقوط_نمط("ب")
سقوط_نمط("ج")
سقوط_نمط("د")

# ============================================================
# 8. نمط معقد — ربط + حارس + نطاق
# ============================================================
دالة نمط_معقد(ن)
    طابق (ن)
        عندما ع @ 0..50 إذا ع % 2 == 0:
            اطبع_سطر("معقد:طويل_زوجي")
        عندما ع @ 0..10:
            اطبع_سطر("معقد:قصير")
        افتراضي:
            اطبع_سطر("معقد:آخر")
    نهاية
نهاية

نمط_معقد(40)
نمط_معقد(5)
نمط_معقد(100)
