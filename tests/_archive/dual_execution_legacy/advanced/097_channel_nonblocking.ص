# ============================================================
# عمليات بدون حجب على القنوات
# ============================================================
متغير ق = قناة(1)

# إرسال بدون حجب
متغير نجح = ق.حاول_ارسل(42)
اطبع_سطر("أرسل:" + نجح)

# استقبال بدون حجب
متغير قيمة = ق.حاول_استقبل()
اطبع_سطر("استقبل:" + قيمة)

# استقبال من قناة فارغة
متغير فارغ = ق.حاول_استقبل()
اطبع_سطر("فارغ_استقبل:" + فارغ)
