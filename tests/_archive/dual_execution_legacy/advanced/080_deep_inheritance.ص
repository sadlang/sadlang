# @description اختبار وراثة متعددة المستويات مع override وsuper
# @expected شكل:0\nمستطيل:50\nمربع:25\nمكعب:150\nالمساحة:25\nنوع:مكعب\nأب:مربع
# @priority P2

# ============================================================
# سلسلة وراثة: شكل → مستطيل → مربع → مكعب (4 مستويات)
# ============================================================

استورد رياضيات

صنف شكل
    متغير عام اسم_النوع
    باني(اسم_النوع)
        هذا.اسم_النوع = اسم_النوع
    نهاية
    دالة عام مساحة()
        ارجع 0
    نهاية
نهاية

صنف مستطيل يرث شكل
    متغير عام عرض
    متغير عام ارتفاع
    باني(عرض، ارتفاع)
        الأساس("مستطيل")
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية
    دالة عام مساحة()
        ارجع هذا.عرض * هذا.ارتفاع
    نهاية
نهاية

صنف مربع يرث مستطيل
    باني(ضلع)
        الأساس(ضلع، ضلع)
        هذا.اسم_النوع = "مربع"
    نهاية
نهاية

صنف مكعب يرث مربع
    باني(ضلع)
        الأساس(ضلع)
        هذا.اسم_النوع = "مكعب"
    نهاية
    دالة عام مساحة_سطح()
        ارجع 6 * هذا.مساحة()
    نهاية
نهاية

متغير ش = شكل("شكل")
متغير م = مستطيل(5، 10)
متغير مر = مربع(5)
متغير مك = مكعب(5)

اطبع_سطر("شكل:" + ش.مساحة())
اطبع_سطر("مستطيل:" + م.مساحة())
اطبع_سطر("مربع:" + مر.مساحة())
اطبع_سطر("مكعب:" + مك.مساحة_سطح())
اطبع_سطر("المساحة:" + مك.مساحة())
اطبع_سطر("نوع:" + مك.اسم_النوع)
اطبع_سطر("أب:" + مر.اسم_النوع)
