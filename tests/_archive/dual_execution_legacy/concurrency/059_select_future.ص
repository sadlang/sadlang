# @description اختبار اختر (select) ومستقبل (future) — اختيار من قنوات ومستقبل مع goroutine
# @expected افتراضي\nق2_جاهزة\nأج\nمستقبل:55\nجاهز:صحيح
# @priority P0

# ============================================================
# 1) اختر مع افتراضي — لا قنوات جاهزة
# ============================================================
متغير ق1 = قناة(5)
متغير ق2 = قناة(5)

اختر
    عندما ق1.حاول_استقبل():
        اطبع_سطر("ق1")
    عندما ق2.حاول_استقبل():
        اطبع_سطر("ق2")
    افتراضي:
        اطبع_سطر("افتراضي")
نهاية

# ============================================================
# 2) اختر مع قناة جاهزة — goroutine يُرسل لقناة محددة
# ============================================================
متغير ق_عمل = قناة(5)
متغير ق_نتيجة = قناة(5)

أطلق
    ق_نتيجة.أرسل(200)
نهاية

انتظر_الكل()

اختر
    عندما ق_عمل.حاول_استقبل():
        اطبع_سطر("ق_عمل_جاهزة")
    عندما ق_نتيجة.حاول_استقبل():
        اطبع_سطر("ق2_جاهزة")
نهاية

# ============================================================
# 3) اختر متتابع — استنفاد القنوات
# ============================================================
متغير ق_أ = قناة(5)
متغير ق_ب = قناة(5)
متغير ق_ج = قناة(5)

ق_أ.أرسل(10)
ق_ج.أرسل(30)

متغير اختيارات = ""

# اختر أول — ق_أ جاهزة
اختر
    عندما ق_أ.حاول_استقبل():
        اختيارات = اختيارات + "أ"
    عندما ق_ب.حاول_استقبل():
        اختيارات = اختيارات + "ب"
    عندما ق_ج.حاول_استقبل():
        اختيارات = اختيارات + "ج"
نهاية

# اختر ثاني — ق_أ فارغة الآن، ق_ج لا تزال جاهزة
اختر
    عندما ق_أ.حاول_استقبل():
        اختيارات = اختيارات + "أ"
    عندما ق_ب.حاول_استقبل():
        اختيارات = اختيارات + "ب"
    عندما ق_ج.حاول_استقبل():
        اختيارات = اختيارات + "ج"
    افتراضي:
        اختيارات = اختيارات + "لا"
نهاية

اطبع_سطر(اختيارات)

# ============================================================
# 4) مستقبل (Future) مع goroutine — حساب غير متزامن
# ============================================================
متغير م = مستقبل()

أطلق
    متغير نتيجة = 0
    لكل ن في 1..10
        نتيجة = نتيجة + ن
    نهاية
    م.عيّن(نتيجة)
نهاية

متغير قيمة_م = م.احصل()
اطبع_سطر("مستقبل:" + قيمة_م)

# ============================================================
# 5) مستقبل — التحقق من جاهزية بعد التعيين
# ============================================================
متغير م2 = مستقبل()
م2.عيّن(99)
اطبع_سطر("جاهز:" + م2.جاهز())
