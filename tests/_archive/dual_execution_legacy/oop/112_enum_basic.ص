# @description اختبار تعداد بسيط والوصول إلى قيمه
# @expected 0\n1\n2\nصحيح\nخطأ
# @priority P2

# ============================================================
# 1. تعداد بسيط
# ============================================================
تعداد اللون
    أحمر
    أخضر
    أزرق
نهاية

متغير لوني = اللون.أحمر
اطبع_سطر(لوني)

اطبع_سطر(اللون.أخضر)
اطبع_سطر(اللون.أزرق)

# ============================================================
# 2. مقارنة قيم التعداد
# ============================================================
اطبع_سطر(لوني == اللون.أحمر)
اطبع_سطر(لوني == اللون.أزرق)
