##
# اختبار P01: setter بمعامل مُسمى
# يتحقق من أن اسم معامل عيّن(ق) يكون مرئياً داخل جسم setter
# السلوك الصحيح: المعامل المُسمى يُعرَّف في نطاق setter
##

# ───────────────────────────────────────────────────────────────
# صنف درجة حرارة: setter يرفض القيم السالبة
# ───────────────────────────────────────────────────────────────
صنف درجة_حرارة
    متغير خاص _قيمة = 0

    باني(ق)
        هذا._قيمة = ق
    نهاية

    خاصية قيمة
        احصل
            ارجع هذا._قيمة
        نهاية
        عيّن(درجة)
            إذا (درجة >= -273)
                هذا._قيمة = درجة
            نهاية
        نهاية
    نهاية
نهاية

# اختبار 1: setter بمعامل مُسمى يعمل
متغير ح = درجة_حرارة(20)
اطبع_سطر(ح.قيمة)
ح.قيمة = 37
اطبع_سطر(ح.قيمة)

# setter يرفض ما دون -273 (صفر مطلق)
ح.قيمة = -300
اطبع_سطر(ح.قيمة)

ح.قيمة = -273
اطبع_سطر(ح.قيمة)

# ───────────────────────────────────────────────────────────────
# صنف مصفوفة محدودة: setter يتحقق من النطاق
# ───────────────────────────────────────────────────────────────
صنف حاوية
    متغير خاص _سعة = 10
    متغير خاص _محتوى = 0

    خاصية محتوى
        احصل
            ارجع هذا._محتوى
        نهاية
        عيّن(كمية)
            إذا (كمية >= 0 && كمية <= هذا._سعة)
                هذا._محتوى = كمية
            نهاية
        نهاية
    نهاية
نهاية

متغير ح2 = حاوية()
ح2.محتوى = 5
اطبع_سطر(ح2.محتوى)
ح2.محتوى = 15
اطبع_سطر(ح2.محتوى)
ح2.محتوى = 0
اطبع_سطر(ح2.محتوى)
