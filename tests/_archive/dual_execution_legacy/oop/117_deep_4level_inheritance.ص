# @description اختبار وراثة 4 مستويات — سلسلة عميقة جداً مع حقول كل مستوى
# @expected جذر:10\nفرع1:10:مرحبا\nفرع2:10:مرحبا:صحيح\nفرع3:10:مرحبا:صحيح:99
# @priority P1

# ============================================================
# 1. سلسلة وراثة من 4 مستويات
# ============================================================

استورد رياضيات

صنف جذر
    متغير عام رقم_م

    باني(ر)
        هذا.رقم_م = ر
    نهاية

    دالة عام وصف()
        ارجع "جذر:" + هذا.رقم_م
    نهاية
نهاية

صنف فرع1 يرث جذر
    متغير عام نص_م

    باني(ر، ن)
        الأساس(ر)
        هذا.نص_م = ن
    نهاية

    دالة عام وصف()
        ارجع "فرع1:" + هذا.رقم_م + ":" + هذا.نص_م
    نهاية
نهاية

صنف فرع2 يرث فرع1
    متغير عام منطقي_م

    باني(ر، ن، م)
        الأساس(ر، ن)
        هذا.منطقي_م = م
    نهاية

    دالة عام وصف()
        ارجع "فرع2:" + هذا.رقم_م + ":" + هذا.نص_م + ":" + هذا.منطقي_م
    نهاية
نهاية

صنف فرع3 يرث فرع2
    متغير عام قيمة

    باني(ر، ن، م، ق)
        الأساس(ر، ن، م)
        هذا.قيمة = ق
    نهاية

    دالة عام وصف()
        ارجع "فرع3:" + هذا.رقم_م + ":" + هذا.نص_م + ":" + هذا.منطقي_م + ":" + هذا.قيمة
    نهاية
نهاية

# ============================================================
# 2. إنشاء كائنات من كل مستوى
# ============================================================
متغير أ = جذر(10)
متغير ب = فرع1(10، "مرحبا")
متغير ج = فرع2(10، "مرحبا"، صحيح)
متغير د = فرع3(10، "مرحبا"، صحيح، 99)

اطبع_سطر(أ.وصف())
اطبع_سطر(ب.وصف())
اطبع_سطر(ج.وصف())
اطبع_سطر(د.وصف())
