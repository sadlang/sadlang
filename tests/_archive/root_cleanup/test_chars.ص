## Check character codes in parsing
من مكتبات_خارجية.تعبيرات_منتظمة.src.محلل استورد محلل

متغير نمط1 = "(abc)"
اطبع("طول النمط: ")
اطبع_سطر(طول(نمط1))
اطبع("أول حرف: [")
اطبع(استخراج(نمط1، 0، 1))
اطبع_سطر("]")
اطبع("رمز أول حرف: ")
اطبع_سطر(رمز_حرف(نمط1، 0))

# الحرف ( ASCII
متغير فاصل_افتراضي = "("
اطبع("رمز ( المباشر: ")
اطبع_سطر(رمز_حرف(فاصل_افتراضي، 0))

# مقارنة
أول = استخراج(نمط1، 0، 1)
إذا (أول == "(")
    اطبع_سطر("التطابق: صحيح")
وإلا
    اطبع_سطر("التطابق: خطأ")
    اطبع("رمز أول: ")
    اطبع_سطر(رمز_حرف(أول، 0))
    اطبع("رمز (: ")
    اطبع_سطر(رمز_حرف("("، 0))
