صنف كائن_ت
    رقم القيمة

    باني(رقم ق)
        هذا.القيمة = ق
    نهاية
نهاية

دالة رقم عملية(كا، رقم ن)
    متغير قيمة_ك = كا.القيمة
    ارجع قيمة_ك + ن
نهاية

متغير ك = جديد كائن_ت(10)
اطبع_سطر("قبل:")
اطبع_سطر(ك.القيمة)

متغير ر = عملية(ك, 5)
اطبع_سطر("بعد عملية، ر=")
اطبع_سطر(ر)
اطبع_سطر("ك.القيمة بعد:")
اطبع_سطر(ك.القيمة)
