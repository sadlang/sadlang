## Minimal reproduction of the group parsing issue

استورد نصوص

صنف محاكي
    نص نمط
    رقم موضع
    رقم طول

    باني(نص ن)
        هذا.نمط = ن
        هذا.موضع = 0
        هذا.طول = طول(ن)
    نهاية

    دالة نص اقرأ_حالي()
        متغير م = هذا
        إذا (م.موضع >= م.طول)
            ارجع ""
        نهاية
        ارجع استخراج(م.نمط، م.موضع، 1)
    نهاية

    دالة تقدم(رقم ن)
        متغير م = هذا
        م.موضع = م.موضع + ن
    نهاية

    دالة نص استهلك()
        متغير م = هذا
        متغير ح = م.اقرأ_حالي()
        م.تقدم(1)
        ارجع ح
    نهاية

    دالة معالج_مجموعة()
        متغير م = هذا
        # استهلك (
        م.تقدم(1)
        # عالج المحتوى
        متغير محتوى = م.معالج_تسلسل()
        # استهلك )
        م.تقدم(1)
        ارجع "مجموعة(" + محتوى + ")"
    نهاية

    دالة معالج_تسلسل()
        متغير م = هذا
        متغير نتيجة = ""
        بينما (م.موضع < م.طول و م.اقرأ_حالي() != ")")
            اطبع("[O] موضع=" + م.موضع + " نتيجة=[" + نتيجة + "]")
            متغير طفل = م.معالج_ذرة()
            اطبع("[O] طفل=[" + طفل + "] بعد=[" + نتيجة + "]")
            نتيجة = نتيجة + طفل
            اطبع("[O] نتيجة_جديدة=[" + نتيجة + "]")
        نهاية
        ارجع نتيجة
    نهاية

    دالة معالج_ذرة()
        متغير م = هذا
        متغير ح = م.اقرأ_حالي()
        إذا (ح == "(")
            ارجع م.معالج_مجموعة()
        نهاية
        ارجع م.استهلك()
    نهاية
نهاية

# اختبار
متغير ج1 = جديد محاكي("abc")
اطبع("abc: ")
اطبع_سطر(ج1.معالج_تسلسل())

متغير ج2 = جديد محاكي("(abc)")
اطبع("(abc): ")
اطبع_سطر(ج2.معالج_تسلسل())

متغير ج3 = جديد محاكي("(abc)")
اطبع("ذرة (abc): ")
اطبع_سطر(ج3.معالج_ذرة())
اطبع("موضع: ")
اطبع_سطر(ج3.موضع)
