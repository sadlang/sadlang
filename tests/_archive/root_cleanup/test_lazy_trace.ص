من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد تعبير، م_بحث، م_ابحث_من

متغير نمط = "<.+?>"
متغير نص_م = "<مرحبا><عالم>"
متغير أعلام = 0

متغير تع = جديد تعبير(نمط، أعلام)
متغير مح = تع.المحرك
متغير شج = مح.الشجرة
متغير عدد = تع.عدد_المجموعات

اطبع("م_ابحث_من:")
متغير ح = م_ابحث_من(شج، عدد، أعلام، نص_م، 0)
اطبع("حالة != لاشيء: ")
اطبع_سطر(ح != لاشيء)

إذا (ح != لاشيء)
    اطبع("مجموعات[0] = ")
    اطبع_سطر(ح.المجموعات[0])
نهاية

اطبع("م_بحث:")
متغير جواب = م_بحث(مح، عدد، أعلام، نص_م)
اطبع("جواب == لاشيء؟ ")
اطبع_سطر(جواب == لاشيء)
إذا (جواب != لاشيء)
    ## هل هو نتيجة_مطابقة؟
    متغير بداية = جواب.البداية
    اطبع("جواب.البداية = ")
    اطبع_سطر(بداية)
نهاية

اطبع("تع.بحث():")
متغير ن = تع.بحث(نص_م)
اطبع("ن == لاشيء؟ ")
اطبع_سطر(ن == لاشيء)
إذا (ن != لاشيء)
    متغير بداية_ن = ن.البداية
    اطبع("ن.البداية = ")
    اطبع_سطر(بداية_ن)
نهاية
