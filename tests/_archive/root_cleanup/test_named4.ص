## دالة طباعة شجرة بسيطة
دالة اطبع_شجرة(شجرة، نص مسافة)
    إذا (شجرة == لاشيء)
        اطبع_سطر(مسافة + "NULL")
        ارجع لاشيء
    نهاية
    متغير النوع = شجرة.النوع
    اطبع_سطر(مسافة + "نوع=" + النوع)
    إذا (النوع == 4)
        متغير أبناء = شجرة.الأبناء
        اطبع_سطر(مسافة + "  أبناء=" + طول(أبناء))
        متغير ي = 0
        بينما (ي < طول(أبناء))
            اطبع_شجرة(أبناء[ي]، مسافة + "  ")
            ي = ي + 1
        نهاية
    نهاية
    إذا (النوع == 6)
        اطبع_سطر(مسافة + "  رقم=" + شجرة.رقم_م + " اسم=" + شجرة.اسم_م + " التزام=" + شجرة.التزام)
        اطبع_شجرة(شجرة.طفل، مسافة + "  ")
    نهاية
    إذا (النوع == 1)
        اطبع_سطر(مسافة + "  حرف=" + شجرة.الحرف)
    نهاية
نهاية

اطبع_سطر("--- تحليل (abc) ---")
متغير مح = جديد محلل("(abc)", 0)
متغير الشجرة = مح.تحليل()
اطبع_سطر("نوع الجذر: " + الشجرة.النوع)
اطبع_شجرة(الشجرة, "")

اطبع_سطر("--- مطابقة يدوية ---")
متغير الحالة = جديد حالة_مطابقة("abc123", 1, 0)

## دالة مطابقة مبسطة داخلياً
دالة رقم طابق_حرفي(شجرة، نص نص_م، رقم موضع، أعلام)
    إذا (موضع >= طول(نص_م)) ارجع -1 نهاية
    متغير ح1 = استخراج(نص_م، موضع، 1)
    إذا (ح1 == شجرة.الحرف)
        ارجع موضع + 1
    نهاية
    ارجع -1
نهاية

اطبع_سطر("طابق 'a' في 'abc123' عند 0: " + طابق_حرفي(الشجرة.طفل.الأبناء[0], "abc123", 0, 0))
اطبع_سطر("طابق 'a' في 'abc123' عند 1: " + طابق_حرفي(الشجرة.طفل.الأبناء[0], "abc123", 1, 0))
اطبع_سطر("انتهى التشخيص")
