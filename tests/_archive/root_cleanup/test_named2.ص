
من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد بحث

استورد نصوص

اطبع_سطر("اختبار 1: مجموعة عادية")
متغير ن1 = بحث("(\\d{4})", "2024-03-15", 0)
إذا (ن1 != لاشيء)
   اطبع_سطر("وجد: " + ن1.النص_المطابق)
وإلا
   اطبع_سطر("لا يوجد")
نهاية

اطبع_سطر("اختبار 2: مجموعة مسماة بالإنجليزية")
متغير ن2 = بحث("(year:\\d{4})", "2024-03-15", 0)
إذا (ن2 != لاشيء)
   اطبع_سطر("وجد: " + ن2.النص_المطابق)
   اطبع_سطر("اسم year: " + ن2.مجموعة_مسماة("year"))
وإلا
   اطبع_سطر("لا يوجد")
