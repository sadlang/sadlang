من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد تطابق، بحث

استورد نصوص

# النمط \d يجب أن يطابق رقم
اطبع_سطر("اختبار 1: \\d")
متغير ن = تطابق("\\d", "5", 0)
اطبع(ن)
اطبع_سطر(" توقع 1")

# نفس الاختبار مع d مباشرة (لا escape)
اطبع_سطر("اختبار 2: d")
ن = تطابق("d", "d", 0)
اطبع(ن)
اطبع_سطر(" توقع 1")

# اختبار بحث \\d
اطبع_سطر("اختبار 3: بحث \\d في a5b")
متغير ر = بحث("\\d", "a5b", 0)
إذا (ر != لاشيء)
    اطبع(ر.النص_المطابق)
    اطبع_سطر(" - وجد")
وإلا
    اطبع_سطر("لاشيء")
نهاية

# اختبار [0-9]
اطبع_سطر("اختبار 4: [0-9] في 5")
ن = بحث("[0-9]", "5", 0)
إذا (ن != لاشيء)
    اطبع_سطر("وجد: " + ن.النص_المطابق)
وإلا
    اطبع_سطر("لاشيء")
