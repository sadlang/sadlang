# اختبار وراثة متعددة المستويات
# شكل → مستطيل → مربع

صنف شكل
    متغير النوع
    باني(نوع)
        هذا.النوع = نوع
    نهاية
    دالة وصف()
        اطبع("شكل: " + هذا.النوع)
    نهاية
نهاية

صنف مستطيل يرث شكل
    متغير العرض
    متغير الارتفاع
    باني(عرض، ارتفاع)
        الأساس("مستطيل")
        هذا.العرض = عرض
        هذا.الارتفاع = ارتفاع
    نهاية
    دالة عرض_الابعاد()
        اطبع("العرض: " + هذا.العرض)
        اطبع("الارتفاع: " + هذا.الارتفاع)
    نهاية
نهاية

صنف مربع يرث مستطيل
    باني(ضلع)
        الأساس(ضلع، ضلع)
    نهاية
    دالة معلومات()
        اطبع("مربع بضلع: " + هذا.العرض)
    نهاية
نهاية

متغير م = جديد مربع(5)
م.وصف()
م.عرض_الابعاد()
م.معلومات()
