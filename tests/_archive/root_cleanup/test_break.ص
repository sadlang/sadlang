    ج = ج + 1
نهاية
اطبع_سطر("عداد=" + عداد + " ج=" + ج)

## اختبار ثانٍ: توقف عند حرف معين
متغير نص = "abc)"
متغير موضع = 0
متغير اسم = ""
بينما (موضع < طول(نص))
    متغير ح = استخراج(نص، موضع، 1)
    متغير رمز = رمز_حرف(ح، 0)
    متغير هو_حرف = 0
    إذا (رمز >= 97 و رمز <= 122)
        هو_حرف = 1
    نهاية
    إذا (هو_حرف == 1)
        اسم = اسم + ح
        موضع = موضع + 1
    وإلا إذا (ح == ":")
        موضع = موضع + 1
        توقف
    وإلا
        توقف
    نهاية
نهاية
اطبع_سطر("اسم=" + اسم + " موضع=" + موضع)
