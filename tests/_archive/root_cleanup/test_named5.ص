
## اختبار تحليل بسيط جداً
من مكتبات_خارجية.تعبيرات_منتظمة.src.محلل استورد محلل

اطبع_سطر("نبدأ")
متغير مح1 = جديد محلل("abc", 0)
اطبع_سطر("محلل ABC")
متغير شجرة1 = مح1.تحليل()
اطبع_سطر("نوع ABC: " + شجرة1.النوع)

اطبع_سطر("نحلل ab")
متغير مح2 = جديد محلل("ab", 0)
متغير شجرة2 = مح2.تحليل()
اطبع_سطر("نوع AB: " + شجرة2.النوع)

اطبع_سطر("نحلل (ab)")
متغير مح3 = جديد محلل("(ab)", 0)
اطبع_سطر("قبل تحليل (ab)")
متغير شجرة3 = مح3.تحليل()
اطبع_سطر("نوع (AB): " + شجرة3.النوع)

اطبع_سطر("انتهى")
