من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد يحتوي، بحث

استورد نصوص

# اختبار 1: \w+ على عربي
متغير ن1 = بحث("\\w+", "هذا هذا", 0)
إذا (ن1 != لاشيء)
    اطبع("\\w+ تطابق: '")
    اطبع(ن1.النص_المطابق)
    اطبع_سطر("'")
وإلا
    اطبع_سطر("\\w+: فشل")
نهاية

# اختبار 2: \b
متغير ن2 = يحتوي("\\bهذا\\b", "هذا هذا", 0)
اطبع("\\b: ")
اطبع_سطر(ن2)

# اختبار 3: مرجع خلفي
متغير ن3 = بحث("(\\w+)\\s+\\1", "هذا هذا", 0)
إذا (ن3 != لاشيء)
    اطبع("مرجع خلفي: '")
    اطبع(ن3.النص_المطابق)
    اطبع_سطر("'")
وإلا
    اطبع_سطر("مرجع خلفي: فشل")
نهاية

# اختبار 4: النمط الكامل
متغير ن4 = يحتوي("\\b(\\w+)\\s+\\1\\b", "هذا هذا خطأ", 0)
اطبع("النمط الكامل: ")
اطبع_سطر(ن4)
