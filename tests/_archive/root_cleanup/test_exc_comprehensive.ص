# === اختبار 5: دالة بداخلها try/catch ===
اطبع("اختبار5:")
دالة آمنة(س)
    حاول
        إذا (س < 0)
            ارمي "سالب"
        نهاية
        ارجع س * 2
    امسك (خ)
        اطبع("معالج: " + خ)
        ارجع -1
    نهاية
نهاية

اطبع("آمنة(5)=" + آمنة(5))
اطبع("آمنة(-3)=" + آمنة(-3))

# === اختبار 6: سلسلة دوال ===
اطبع("اختبار6:")
دالة دالة_أ(ن)
    إذا (ن > 100)
        ارمي "كبير جداً"
    نهاية
    ارجع ن + 1
نهاية

دالة دالة_ب(ن)
    ارجع دالة_أ(ن) * 2
نهاية

حاول
    اطبع("ب(5)=" + دالة_ب(5))
    اطبع("ب(200)=" + دالة_ب(200))
امسك (خ)
    اطبع("سلسلة: " + خ)
نهاية

