## Test ) comparison in strings

استورد نصوص

متغير نمط = "(abc)"
متغير ص = 4  # موضع آخر حرف )

متغير ح = استخراج(نمط، ص، 1)
اطبع("الحرف عند موضع 4: [")
اطبع(ح)
اطبع_سطر("]")
اطبع("رمزه: ")
اطبع_سطر(رمز_حرف(ح، 0))

اطبع("مقارنة مع ): ")
