#**
 * اختبار العقد: توافق الأعلام المهجورة --dev و--hybrid
 *
 * التحقق من:
 * 1. --dev  يُعيد نفس نتيجة --gc  (gcDefaults)
 * 2. --hybrid يُعيد نفس نتيجة --gc (gcDefaults)
 * 3. النظام يعمل بدون أعطال عند تمرير الأعلام القديمة
 *
 * هذا الاختبار مكتوب بلغة ص — يُشغَّل بـ sad.exe مباشرة
 * الاختبار يفحص السلوك المرئي (لا يوقف التنفيذ)
 **#

# ===== اختبار 1: تنفيذ بدون أخطاء ملكية =====
# في --gc و--dev و--hybrid: جميع أخطاء الملكية تُتجاهل

متغير س = "قيمة أولى"
متغير ص = س  # نقل (move) — في --gc يجب تجاهله بدون خطأ

اطبع_سطر("✓ اختبار 1: النقل بدون خطأ في وضع --gc")

# ===== اختبار 2: إعادة الإسناد بعد النقل =====
# في --gc: لا خطأ

س = "قيمة جديدة"  # إعادة إسناد
اطبع_سطر("✓ اختبار 2: إعادة الإسناد بعد النقل — لا خطأ في --gc")

# ===== اختبار 3: الدوال تعمل بشكل طبيعي =====

دالة اختبار_نقل_المعاملات(قيمة)
    ارجع "استقبلت: " + نص(قيمة)
نهاية

متغير نتيجة = اختبار_نقل_المعاملات(42)
اطبع_سطر("✓ اختبار 3: " + نتيجة)

# ===== اختبار 4: الحلقات والنطاقات =====

متغير مجموع = 0
لكل رقم في [1, 2, 3, 4, 5]
    مجموع = مجموع + رقم
نهاية

إذا (مجموع == 15)
    اطبع_سطر("✓ اختبار 4: الحلقات تعمل بشكل صحيح — المجموع = " + نص(مجموع))
وإلا
    اطبع_سطر("✗ اختبار 4: خطأ في الحلقات — المجموع = " + نص(مجموع))
نهاية

# ===== اختبار 5: الأصناف والكائنات =====

صنف نقطة
    متغير عام س
    متغير عام ص

    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة عام وصف()
        ارجع "(" + نص(هذا.س) + "، " + نص(هذا.ص) + ")"
    نهاية
نهاية

متغير نقطة_أ = نقطة(3، 7)
متغير نقطة_ب = نقطة(10، 20)

إذا (نقطة_أ.وصف() == "(3، 7)")
    اطبع_سطر("✓ اختبار 5: الأصناف تعمل — " + نقطة_أ.وصف())
وإلا
    اطبع_سطر("✗ اختبار 5: خطأ في الأصناف")
نهاية

# ===== اختبار 6: معالجة الأخطاء =====

حاول
    ارمي "خطأ اختباري"
امسك خطأ
    اطبع_سطر("✓ اختبار 6: معالجة الاستثناءات تعمل")
نهاية

