# اختبار: حالات حدية لإعادة تعيين المعاملات (freestanding)
# Test: Edge cases for parameter reassignment (freestanding mode)
# ═══════════════════════════════════════════════════════════════════════

دالة خارجية("debug_puts") _اطبع(عنوان: رقم)
دالة خارجية("debug_putchar") _حرف(ح: رقم)
دالة خارجية("__sad_serial_putint") _اطبع_رقم(رقم: رقم)

# ─── حالة 1: معامل = 0 في حلقة while (لا يدخل الحلقة) ───
دالة اختبار_صفر(ع)
    بينما (ع > 0)
        ع = ع - 1
    نهاية
    ارجع ع
نهاية

# ─── حالة 2: معامل سالب ───
دالة اختبار_سالب(ع)
    بينما (ع < 0)
        ع = ع + 1
    نهاية
    ارجع ع
نهاية

# ─── حالة 3: معامل يُعاد تعيينه لنفس القيمة ───
دالة اختبار_نفس_القيمة(ع)
    ع = ع
    ارجع ع
نهاية

# ─── حالة 4: حلقة واحدة (iteration واحد) ───
دالة اختبار_تكرار_واحد(ع)
    بينما (ع > 0)
        ع = 0
    نهاية
    ارجع ع
نهاية

# ─── حالة 5: حلقات متداخلة مع معاملات ───
دالة اختبار_حلقات_متداخلة(صفوف، أعمدة)
    متغير مجموع = 0
    بينما (صفوف > 0)
        متغير ع = أعمدة
        بينما (ع > 0)
            مجموع = مجموع + 1
            ع = ع - 1
        نهاية
        صفوف = صفوف - 1
    نهاية
    ارجع مجموع
نهاية

# ─── حالة 6: معامل يُعيّن من نتيجة دالة أخرى ───
دالة مساعد(س)
    ارجع س * 2
نهاية

دالة اختبار_تعيين_من_دالة(ع)
    ع = مساعد(ع)
    ارجع ع
نهاية

# ─── حالة 7: عد تنازلي بخطوة أكبر من 1 ───
دالة اختبار_خطوة_كبيرة(ع، خطوة)
    بينما (ع > 0)
        ع = ع - خطوة
    نهاية
    ارجع ع
نهاية

# ─── حالة 8: معامل يُستخدم في حلقة مع متغير محلي ───
دالة اختبار_تفاعل_محلي(حد)
    متغير عداد = 0
    متغير مجموع = 0
    بينما (عداد < حد)
        مجموع = مجموع + عداد
        عداد = عداد + 1
    نهاية
    حد = مجموع
    ارجع حد
نهاية

# ─── نقطة الدخول ───
دالة رئيسية()
    # حالة 1: 0 → 0 (لا يدخل الحلقة)
    _اطبع_رقم(اختبار_صفر(0))
    _حرف(10)

    # حالة 2: -3 → 0
    _اطبع_رقم(اختبار_سالب(-3))
    _حرف(10)

    # حالة 3: 42 → 42
    _اطبع_رقم(اختبار_نفس_القيمة(42))
    _حرف(10)

    # حالة 4: 1 → 0
    _اطبع_رقم(اختبار_تكرار_واحد(1))
    _حرف(10)

    # حالة 5: 3*4 = 12
    _اطبع_رقم(اختبار_حلقات_متداخلة(3، 4))
    _حرف(10)

    # حالة 6: 5*2 = 10
    _اطبع_رقم(اختبار_تعيين_من_دالة(5))
    _حرف(10)

    # حالة 7: 10 بخطوة 3 → سالب (10-3-3-3-3 = -2)
    _اطبع_رقم(اختبار_خطوة_كبيرة(10، 3))
    _حرف(10)

    # حالة 8: sum(0..4) = 0+1+2+3 = 6
    _اطبع_رقم(اختبار_تفاعل_محلي(4))
    _حرف(10)
نهاية
