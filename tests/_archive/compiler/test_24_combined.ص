دالة رتب_فقاعي(م)
    متغير ن = طول(م)
    متغير ي = 0
    بينما (ي < ن - 1)
        متغير ج = 0
        بينما (ج < ن - ي - 1)
            إذا (م[ج] > م[ج + 1])
                متغير ت = م[ج]
                م[ج] = م[ج + 1]
                م[ج + 1] = ت
            نهاية
            ج += 1
        نهاية
        ي += 1
    نهاية
    ارجع م
نهاية

دالة بحث_خطي(م، هدف)
    متغير ي = 0
    بينما (ي < طول(م))
        إذا (م[ي] == هدف)
            ارجع ي
        نهاية
        ي += 1
    نهاية
    ارجع -1
