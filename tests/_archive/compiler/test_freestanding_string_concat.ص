# ═══════════════════════════════════════════════════════════════════════
# اختبار: ربط النصوص بالأرقام في وضع freestanding
# Test: String concatenation with numbers in freestanding mode
# 
# هذا الاختبار يتحقق من أن عملية `+` تُنتج STRING_CONCAT
# بدلاً من ADD_I64 في جميع الحالات التالية:
#   1. نص حرفي + رقم                  → STRING_CONCAT
#   2. متغير نصي + رقم               → STRING_CONCAT  (كان معطلاً!)
#   3. سلسلة دمج: متغير + نص + رقم  → STRING_CONCAT  (كان معطلاً!)
#   4. نتيجة دالة نصية + رقم        → STRING_CONCAT  (كان معطلاً!)
#
# الترجمة:
#   sadc test_freestanding_string_concat.ص --freestanding --emit-llvm \
#        -T x86_64-unknown-none-elf -O1 -o output.ll
#
# التحقق: يجب أن يحتوي IR على calls إلى __sad_itoa لتحويل الأرقام
# ═══════════════════════════════════════════════════════════════════════

خارجي("debug_puts") دالة _اطبع(عنوان: نص)
خارجي("debug_putchar") دالة _حرف(ح: رقم)

# ─── الحالة 1: نص حرفي + رقم حرفي ─── (كان يعمل)
دالة اختبار_حرفي_مع_رقم()
    متغير نتيجة = "العدد: " + 42
    _اطبع(نتيجة)
    _حرف(10)
نهاية

# ─── الحالة 2: متغير نصي + رقم حرفي ─── (كان معطلاً)
دالة اختبار_متغير_نصي_مع_رقم()
    متغير بادئة = "المرحلة "
    متغير نتيجة = بادئة + 5
    _اطبع(نتيجة)
    _حرف(10)
نهاية

# ─── الحالة 3: متغير نصي + متغير رقمي ─── (كان معطلاً)
دالة اختبار_متغيرين()
    متغير وصف = "القيمة: "
    متغير رقم = 100
    متغير نتيجة = وصف + رقم
    _اطبع(نتيجة)
    _حرف(10)
نهاية

# ─── الحالة 4: سلسلة دمج: متغير + حرفي + رقم ─── (كان معطلاً)
دالة اختبار_سلسلة_دمج()
    متغير اسم = "المعالج"
    متغير نتيجة = اسم + " حرارة=" + 75
    _اطبع(نتيجة)
    _حرف(10)
نهاية

# ─── الحالة 5: نتيجة دالة نصية + رقم ─── (كان معطلاً)
دالة نص حيازة_بادئة()
    ارجع "الخطأ رقم "
نهاية

دالة اختبار_نتيجة_دالة_مع_رقم()
    متغير نتيجة = حيازة_بادئة() + 404
    _اطبع(نتيجة)
    _حرف(10)
نهاية

# ─── الحالة 6: رقم + نص حرفي (الترتيب المعكوس) ───
دالة اختبار_رقم_ثم_نص()
    متغير نتيجة = 200 + " ميجابايت"
    _اطبع(نتيجة)
    _حرف(10)
نهاية

# ─── نقطة الدخول ───
دالة رئيسية()
    اختبار_حرفي_مع_رقم()
    اختبار_متغير_نصي_مع_رقم()
    اختبار_متغيرين()
    اختبار_سلسلة_دمج()
    اختبار_نتيجة_دالة_مع_رقم()
    اختبار_رقم_ثم_نص()
نهاية
