# ─── حالة 1: نص فارغ + رقم ───
دالة اختبار_نص_فارغ_مع_رقم()
    متغير فارغ = ""
    متغير نتيجة = فارغ + 42
    _اطبع(نتيجة)
    _حرف(10)
نهاية

