# ═══════════════════════════════════════════════════════════════════════
# اختبار: إعادة تعيين معاملات الدالة في الحلقات (freestanding)
# Test: Function parameter reassignment in loops (freestanding mode)
# 
# هذا الاختبار يتحقق من أن إعادة تعيين معاملات الدالة تعمل بشكل صحيح،
# خاصة داخل الحلقات حيث كان يسبب حلقة لانهائية.
#
# السبب الجذري (مُصلح): المعاملات كانت مسجلة بـ isMutable=false
# مما جعل buildAssignment يتجاهل تعليمة STORE بصمت.
#
# الترجمة:
#   sadc test_freestanding_param_reassign.ص --freestanding --emit-llvm \
#        -T x86_64-unknown-none-elf -O1 -o output.ll
#
# التحقق: يجب أن يحتوي IR على:
#   - store بعد sub في while_body (عد تنازلي)
#   - load/store في entry block لتعديل المعامل
# ═══════════════════════════════════════════════════════════════════════

دالة خارجية("debug_puts") _اطبع(عنوان: رقم)
دالة خارجية("debug_putchar") _حرف(ح: رقم)
دالة خارجية("__sad_serial_putint") _اطبع_رقم(رقم: رقم)

# ─── الحالة 1: عد تنازلي بمعامل في حلقة بينما ─── (كان حلقة لانهائية!)
دالة عد_تنازلي(ع)
    بينما (ع > 0)
        ع = ع - 1
    نهاية
    ارجع ع
نهاية

# ─── الحالة 2: تعديل معامل بدون حلقة ─── (كان يُهمل التعيين)
دالة مضاعفة(قيمة)
    قيمة = قيمة * 2
    ارجع قيمة
نهاية

# ─── الحالة 3: عد تصاعدي بمعامل ───
دالة عد_تصاعدي(بداية، نهايه)
    بينما (بداية < نهايه)
        بداية = بداية + 1
    نهاية
    ارجع بداية
نهاية

# ─── الحالة 4: تعديل معامل مع عمليات مركبة ───
دالة حساب_قوة(أساس، أس)
    متغير نتيجة = 1
    بينما (أس > 0)
        نتيجة = نتيجة * أساس
        أس = أس - 1
    نهاية
    ارجع نتيجة
نهاية

# ─── الحالة 5: معامل يُعدّل مع شرط خروج مبكر ───
دالة بحث_أول_قاسم(عدد)
    متغير مقسوم = 2
    بينما (مقسوم < عدد)
        إذا (عدد % مقسوم == 0)
            ارجع مقسوم
        نهاية
        مقسوم = مقسوم + 1
    نهاية
    ارجع عدد
نهاية

# ─── الحالة 6: multiple parameters modified in same loop ───
دالة تبادل_بحلقة(أ، ب، عدد)
    بينما (عدد > 0)
        متغير مؤقت = أ
        أ = ب
        ب = مؤقت
        عدد = عدد - 1
    نهاية
    ارجع أ
نهاية

# ─── نقطة الدخول ───
دالة رئيسية()
    # اختبار 1: عد تنازلي من 5 → يجب أن يرجع 0
    متغير ن1 = عد_تنازلي(5)
    _اطبع_رقم(ن1)
    _حرف(10)
    
    # اختبار 2: مضاعفة 10 → يجب أن يرجع 20
    متغير ن2 = مضاعفة(10)
    _اطبع_رقم(ن2)
    _حرف(10)
    
    # اختبار 3: عد من 0 إلى 10 → يجب أن يرجع 10
    متغير ن3 = عد_تصاعدي(0، 10)
    _اطبع_رقم(ن3)
    _حرف(10)
    
    # اختبار 4: 2^8 = 256
    متغير ن4 = حساب_قوة(2، 8)
    _اطبع_رقم(ن4)
    _حرف(10)
    
    # اختبار 5: أول قاسم لـ 15 → 3
    متغير ن5 = بحث_أول_قاسم(15)
    _اطبع_رقم(ن5)
    _حرف(10)
    
    # اختبار 6: تبادل A=1,B=2 مرة واحدة → يرجع 2
    متغير ن6 = تبادل_بحلقة(1، 2، 1)
    _اطبع_رقم(ن6)
    _حرف(10)
نهاية
