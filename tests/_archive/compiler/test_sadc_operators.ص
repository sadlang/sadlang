# ============================================================================
# اختبار مبسط لتحميل العوامل — للمترجم sadc
# ============================================================================
# يختبر العوامل المدعومة في المترجم بدون مصفوفات أو خرائط
# (المصفوفات تعتمد على runtime غير متاح في الوضع الأصلي)
# ============================================================================

صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    عامل +(آخر)
        ارجع جديد نقطة(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية

    عامل -(آخر)
        ارجع جديد نقطة(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية

    عامل *(آخر)
        ارجع جديد نقطة(هذا.س * آخر.س، هذا.ص * آخر.ص)
    نهاية

    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية

    عامل !=(آخر)
        ارجع هذا.س != آخر.س أو هذا.ص != آخر.ص
    نهاية

    عامل <(آخر)
        ارجع هذا.س < آخر.س
    نهاية

    عامل نص()
        ارجع "نقطة"
    نهاية
نهاية

متغير أ = جديد نقطة(1، 2)
متغير ب = جديد نقطة(3، 4)

# اختبار الجمع
متغير ج = أ + ب
اطبع_سطر(ج.س)
اطبع_سطر(ج.ص)

# اختبار الطرح
متغير د = ب - أ
اطبع_سطر(د.س)
اطبع_سطر(د.ص)

# اختبار المقارنة
إذا (أ == أ)
    اطبع_سطر("متساويان")
نهاية

إذا (أ != ب)
    اطبع_سطر("مختلفان")
نهاية

إذا (أ < ب)
    اطبع_سطر("اصغر")
نهاية

اطبع_سطر("تم")
