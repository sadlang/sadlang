# ============================================================================
# اختبار المرحلة 6 — تعدّي السمات الفائقة (حالة الفشل)
# Phase 6 Test — Super-trait transitivity (fail case)
#
# (AR) تسلسل سمات: قابل_للترتيب ترث من قابل_للمقارنة.
#      نقطة تُنفِّذ قابل_للمقارنة فقط (الأم) — وليس قابل_للترتيب (الابنة).
#      القالب يطلب قابل_للترتيب — يجب أن يرفض نقطة (EXIT=1)
#      لأن تنفيذ الأم لا يعني تنفيذ الابنة.
#
# (EN) Trait hierarchy: قابل_للترتيب inherits from قابل_للمقارنة.
#      نقطة implements only قابل_للمقارنة (parent) — NOT قابل_للترتيب (child).
#      Template requires قابل_للترتيب — must reject نقطة (EXIT=1)
#      because implementing the parent does NOT imply implementing the child.
# ============================================================================

سمة قابل_للمقارنة
    دالة مقارنة(آخر)
نهاية

سمة قابل_للترتيب يرث قابل_للمقارنة
    دالة أصغر_من(آخر)
    دالة أكبر_من(آخر)
نهاية

صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

# (AR) نُنفِّذ الأم فقط — لا نُنفِّذ قابل_للترتيب
# (EN) Implement only the parent — NOT قابل_للترتيب

نفّذ قابل_للمقارنة لـ نقطة
    دالة مقارنة(آخر)
        ارجع هذا.س - آخر.س
    نهاية
نهاية

# (AR) قالب يطلب قابل_للترتيب — نقطة لا تُنفِّذها → خطأ
# (EN) Template requiring قابل_للترتيب — نقطة doesn't impl it → error

قالب<نوع T: قابل_للترتيب>
دالة رتّب_عنصرين(T أ، T ب)
    ارجع أ.أصغر_من(ب)
نهاية

دالة رئيسية()
    متغير ن1 = نقطة(5، 3) جديد
    متغير ن2 = نقطة(2، 8) جديد
    # نقطة لا تحقق قابل_للترتيب — يجب أن يفشل الفحص
    متغير نتيجة = رتّب_عنصرين<نقطة>(ن1، ن2)
    اطبع_سطر("النتيجة: " + نتيجة)
    ارجع 0
نهاية
