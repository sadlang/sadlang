# اختبار المرحلة 6 — جملة حيث (WHERE) مع استدلال الأنواع (حالة الانتهاك)
# Phase 6 Test — WHERE clause with type inference (violation case)
#
# (AR) القالب يُعرِّف جملة حيث تتطلب القيدين: قابل_للمقارنة + قابل_للتجزئة.
#      نستدعيه بكائنات نقطة بدون <...> — يُستدلّ T=نقطة — لكن نقطة لا
#      تُنفِّذ أيًا من هذين القيدين.
#      يجب أن يفشل الفحص (EXIT=1).
#
# (EN) Template defines a WHERE clause requiring two constraints.
#      We call it with نقطة objects without explicit <...> — T is inferred
#      as نقطة — but نقطة implements neither constraint.
#      Type check must fail (EXIT=1).
# ============================================================================

صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

قالب<نوع T>
دالة أكبر_عنصر(T أ، T ب)
    حيث T: قابل_للمقارنة + قابل_للتجزئة
    إذا (أ > ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

دالة رئيسية()
    متغير ن1 = نقطة(3، 4) جديد
    متغير ن2 = نقطة(1، 2) جديد
    # استدعاء بدون <...> — يُستدلّ T=نقطة — انتهاك للقيدين
    متغير ن3 = أكبر_عنصر(ن1، ن2)
    اطبع_سطر(ن3.س)
    ارجع 0
