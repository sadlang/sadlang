# اختبار سمات الدالة [[سمة]] — Phase 2
# يتحقق من: مضمن_دائماً، لا_تضمن، بارد، ساخن، محاذاة(N)، نقي

[[مضمن_دائماً]]
دالة جمع_سريع(أ، ب)
    ارجع أ + ب
نهاية

[[لا_تضمن]]
دالة جمع_بطيء(أ، ب)
    ارجع أ + ب
نهاية

[[بارد]]
دالة معالج_خطأ_نادر(رمز)
    اطبع_سطر("خطأ:")
    اطبع_سطر(رمز)
    ارجع -1
نهاية

[[ساخن]]
دالة حلقة_حرجة(ن)
    متغير المجموع = 0
    متغير ع = 0
    بينما (ع < ن)
        المجموع = المجموع + ع
        ع = ع + 1
    نهاية
    ارجع المجموع
نهاية

[[محاذاة(64)]]
دالة موجّه_للذاكرة_المخبئية(س)
    ارجع س * 2
نهاية

[[نقي]]
دالة لا_تأثيرات_جانبية(أ، ب)
    ارجع أ * ب + 7
نهاية

# سمات متعددة على نفس الدالة
[[مضمن_دائماً، ساخن]]
دالة سريعة_جداً(س)
    ارجع س + 1
نهاية

دالة رئيسية()
    اطبع_سطر(جمع_سريع(3، 4))
    اطبع_سطر(جمع_بطيء(10، 20))
    اطبع_سطر(حلقة_حرجة(5))
    اطبع_سطر(موجّه_للذاكرة_المخبئية(21))
    اطبع_سطر(لا_تأثيرات_جانبية(6، 7))
    اطبع_سطر(سريعة_جداً(99))
    ارجع 0
نهاية
