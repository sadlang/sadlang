# =============================================================================
# اختبار قيود القوالب — سمة مستخدم منفّذة
# Template Constraints Test — User trait impl
# =============================================================================
# تعريف `سمة قابل_للطباعة`، تنفيذها على `نقطة`، ثم استخدامها في قيد قالب.
# Define trait, impl on نقطة, then constrain template by it.

سمة قابل_للطباعة
    دالة اطبع_ذاتي()
نهاية

صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

نفّذ قابل_للطباعة لـ نقطة
    دالة اطبع_ذاتي()
        اطبع_سطر("(" + هذا.س + "، " + هذا.ص + ")")
    نهاية
نهاية

قالب<نوع T: قابل_للطباعة>
دالة اطبع_عنصر(T ع)
    ع.اطبع_ذاتي()
نهاية

دالة رئيسية()
    متغير ن = نقطة(7، 9)
    اطبع_عنصر<نقطة>(ن)
نهاية
