# اختبار توجيهات الفرع: متوقع / غير_متوقع
# Branch hints test: expected / unexpected

دالة فحص(س)
    إذا (متوقع(س > 0))
        ارجع "موجب"
    وإلا
        ارجع "غير موجب"
    نهاية
نهاية

دالة فحص_خطأ(ك)
    إذا (غير_متوقع(ك < 0))
        ارجع "خطأ نادر"
    نهاية
    ارجع "عادي"
نهاية

اطبع_سطر(فحص(5))
اطبع_سطر(فحص(-1))
اطبع_سطر(فحص_خطأ(10))
اطبع_سطر(فحص_خطأ(-5))
