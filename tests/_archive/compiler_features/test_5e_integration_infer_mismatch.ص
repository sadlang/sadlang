# اختبار تكاملي: قيد سمة + استدلال قالب + نوع إرجاع صنفي (فشل)
# يجب أن يفشل لأن تنفيذ السمة يُرجع سيارة بدل نقطة.

صنف نقطة
    متغير عام س
    متغير عام ص
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

صنف سيارة
    متغير عام اللون
    باني(لون)
        هذا.اللون = لون
    نهاية
نهاية

سمة قابل_للاسترداد
    دالة نقطة احصل_النقطة()
نهاية

صنف خازن
    متغير عام قيمة
    باني(ق)
        هذا.قيمة = ق
    نهاية
نهاية

نفذ قابل_للاسترداد لـ خازن
    دالة سيارة احصل_النقطة()
        ارجع سيارة("أحمر") جديد
    نهاية
نهاية

قالب<نوع T: قابل_للاسترداد> دالة استرجع(T كائن)
    ارجع كائن.احصل_النقطة()
