# اختبار ميزة إعادة التصدير (صدّر * من وحدة)

استورد رياضيات

متغير نجاح = 0
متغير فشل = 0

# ═══════════════════════════════════════════════════════════
# اختبار 1: إعادة تصدير شاملة (صدّر * من وحدة)
# ═══════════════════════════════════════════════════════════
استورد * من .واجهة_شاملة

# اختبار دوال الرياضيات المُعاد تصديرها
إذا (جمع(3، 5) == 8)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: جمع من إعادة تصدير شاملة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 1: فشل جمع")
نهاية

إذا (ضرب(4، 3) == 12)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 2: ضرب من إعادة تصدير شاملة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 2: فشل ضرب")
نهاية

# اختبار الثوابت المُعاد تصديرها
إذا (باي > 3.14)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 3: ثابت باي من إعادة تصدير شاملة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 3: فشل ثابت باي")
نهاية

# اختبار دوال النص المُعاد تصديرها
إذا (تحية("أحمد") == "مرحباً أحمد!")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 4: تحية من إعادة تصدير شاملة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 4: فشل تحية")
نهاية

# ═══════════════════════════════════════════════════════════
# اختبار 5: إعادة تصدير انتقائية (صدّر عنصر من وحدة)
# ═══════════════════════════════════════════════════════════
استورد * من .واجهة_انتقائية

إذا (جمع(10، 20) == 30)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 5: جمع من إعادة تصدير انتقائية")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 5: فشل جمع انتقائي")
نهاية

إذا (تحية("سارة") == "مرحباً سارة!")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 6: تحية من إعادة تصدير انتقائية")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 6: فشل تحية انتقائية")
نهاية

# ═══════════════════════════════════════════════════════════
# النتيجة
# ═══════════════════════════════════════════════════════════
اطبع_سطر("═══════════════════════════════════════")
اطبع_سطر("النتيجة: " + نجاح + "/" + (نجاح + فشل) + " اختبار نجح")
إذا (فشل == 0)
    اطبع_سطر("✅ جميع الاختبارات نجحت!")
وإلا
    اطبع_سطر("❌ بعض الاختبارات فشلت")
نهاية
