# اختبار القواعد النحوية §5: البرمجة الكائنية
# يغطي: صنف، حقول، طرق، باني، وراثة، هذا، الأساس، جديد
# ═══════════════════════════════════════════════════════════════

متغير نجاح = 0
متغير فشل = 0

# --- §5.1 صنف بسيط مع حقول وطرق ---
صنف حيوان
    نص الاسم
    رقم العمر

    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية

    دالة نص وصف()
        ارجع هذا.الاسم + " عمره " + هذا.العمر
    نهاية

    دالة رقم سنوات_بشرية()
        ارجع هذا.العمر * 7
    نهاية
نهاية

متغير قط = جديد حيوان("قط"، 3)

إذا (قط.الاسم == "قط")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: حقل الاسم")
نهاية

إذا (قط.العمر == 3)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: حقل العمر")
نهاية

إذا (قط.سنوات_بشرية() == 21)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: طريقة — النتيجة: " + قط.سنوات_بشرية())
نهاية

# --- §5.2 الوراثة ---
صنف شكل
    نص اللون

    باني(لون)
        هذا.اللون = لون
    نهاية

    دالة نص نوع()
        ارجع "شكل"
    نهاية
نهاية

صنف دائرة يرث شكل
    رقم نصف_القطر

    باني(لون، نق)
        الأساس(لون)
        هذا.نصف_القطر = نق
    نهاية

    دالة المساحة()
        ارجع 3.14 * هذا.نصف_القطر ** 2
    نهاية
نهاية

متغير د = جديد دائرة("أحمر"، 5)

إذا (د.اللون == "أحمر")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: وراثة حقل")
نهاية

إذا (د.نصف_القطر == 5)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: حقل الصنف الابن")
نهاية

إذا (د.المساحة() == 78.5)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: طريقة الابن — المساحة: " + د.المساحة())
نهاية

# --- §5 معدلات الرؤية ---
صنف حساب
    خاص رقم الرصيد

    باني(رصيد)
        هذا.الرصيد = رصيد
    نهاية

    عام دالة رقم اقرأ_الرصيد()
        ارجع هذا.الرصيد
    نهاية

    عام دالة إيداع(مبلغ)
        هذا.الرصيد += مبلغ
    نهاية
نهاية

متغير ح = جديد حساب(1000)
ح.إيداع(500)

إذا (ح.اقرأ_الرصيد() == 1500)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: طرق عامة/خاصة")
نهاية

# --- §5 ثابت داخل صنف ---
صنف إعدادات
    ثابت الإصدار = "1.0"
    ثابت الاسم = "تطبيق"
نهاية

إذا (إعدادات.الإصدار == "1.0")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: ثابت صنف")
نهاية

# --- §5 متغير داخل صنف ---
صنف عداد
    متغير قيمة = 0

    باني()
        هذا.قيمة = 0
    نهاية

    دالة زيادة()
        هذا.قيمة += 1
    نهاية

    دالة القيمة()
        ارجع هذا.قيمة
    نهاية
نهاية

متغير ع = جديد عداد()
ع.زيادة()
ع.زيادة()
ع.زيادة()

إذا (ع.القيمة() == 3)
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: متغير صنف — القيمة: " + ع.القيمة())
نهاية

# --- §5 سلسلة استدعاءات ---
صنف بنّاء
    متغير نتيجة = ""

    باني()
        هذا.نتيجة = ""
    نهاية

    دالة أضف(نص)
        هذا.نتيجة += نص
        ارجع هذا
    نهاية

    دالة ابنِ()
        ارجع هذا.نتيجة
    نهاية
نهاية

متغير ب = جديد بنّاء()
متغير جملة = ب.أضف("مرحبا ").أضف("يا ").أضف("عالم").ابنِ()

إذا (جملة == "مرحبا يا عالم")
    نجاح += 1
وإلا
    فشل += 1
    اطبع_سطر("فشل: سلسلة استدعاءات — النتيجة: " + جملة)
نهاية

# --- النتيجة ---
اطبع_سطر("═══ نتائج اختبار OOP ═══")
اطبع_سطر("نجاح: " + نجاح)
اطبع_سطر("فشل: " + فشل)
إذا (فشل == 0)
    اطبع_سطر("✅ جميع اختبارات OOP نجحت!")
وإلا
    اطبع_سطر("❌ بعض الاختبارات فشلت")
نهاية
