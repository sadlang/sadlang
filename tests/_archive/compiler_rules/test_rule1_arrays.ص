# === 9. مصفوفة متداخلة العمليات ===
دالة فلتر_أكبر_من(مصف، حد)
    متغير نتيجة = []
    لكل عنصر في مصف
        إذا (عنصر > حد)
            نتيجة.اضف(عنصر)
        نهاية
    نهاية
    ارجع نتيجة
نهاية

متغير أرقام2 = [3, 7, 1, 9, 4, 6, 2, 8, 5]
