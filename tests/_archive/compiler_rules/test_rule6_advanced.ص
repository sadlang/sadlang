# اختبار القاعدة 6-4: الأعضاء الساكنة والدوال المتقدمة
# يغطي: أعضاء ساكنة، كائنات متعددة، تفاعل الكائنات

اطبع_سطر("=== اختبار متقدم ===")

# === 1. حساب بنكي ===
صنف حساب
    متغير عام صاحب
    متغير عام رصيد

    باني(صاحب، رصيد)
        هذا.صاحب = صاحب
        هذا.رصيد = رصيد
    نهاية

    دالة عام إيداع(مبلغ)
        هذا.رصيد = هذا.رصيد + مبلغ
    نهاية

    دالة عام سحب(مبلغ)
        إذا (مبلغ <= هذا.رصيد)
            هذا.رصيد = هذا.رصيد - مبلغ
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة عام عرض()
        ارجع هذا.صاحب + ": " + هذا.رصيد
    نهاية
نهاية

متغير ح1 = جديد حساب("أحمد", 1000)
متغير ح2 = جديد حساب("سارة", 500)

ح1.إيداع(500)
ح2.إيداع(200)
ح1.سحب(300)

اطبع_سطر(ح1.عرض())
اطبع_سطر(ح2.عرض())

# === 2. قائمة مرتبطة بسيطة ===
صنف عقدة
    متغير عام قيمة
    متغير عام التالي

    باني(قيمة)
        هذا.قيمة = قيمة
        هذا.التالي = 0
    نهاية
نهاية

# إنشاء 3 عقد
متغير ع1 = جديد عقدة(10)
متغير ع2 = جديد عقدة(20)
متغير ع3 = جديد عقدة(30)

اطبع_سطر("عقدة 1: " + ع1.قيمة)
اطبع_سطر("عقدة 2: " + ع2.قيمة)
اطبع_سطر("عقدة 3: " + ع3.قيمة)

# === 3. مصفوفة كائنات ===
صنف طالب
    متغير عام اسم
    متغير عام درجة

    باني(اسم، درجة)
        هذا.اسم = اسم
        هذا.درجة = درجة
    نهاية

    دالة عام ناجح()
        ارجع هذا.درجة >= 50
    نهاية
نهاية

متغير ط1 = جديد طالب("علي", 85)
متغير ط2 = جديد طالب("سارة", 92)
متغير ط3 = جديد طالب("محمد", 45)

اطبع_سطر(ط1.اسم + " ناجح: " + ط1.ناجح())
اطبع_سطر(ط2.اسم + " ناجح: " + ط2.ناجح())
اطبع_سطر(ط3.اسم + " ناجح: " + ط3.ناجح())

# === 4. تفاعل كائنات ===
دالة أعلى_درجة(ط_أ، ط_ب)
    إذا (ط_أ.درجة > ط_ب.درجة)
        ارجع ط_أ.اسم
    نهاية
    ارجع ط_ب.اسم
نهاية

اطبع_سطر("أعلى درجة: " + أعلى_درجة(ط1, ط2))
