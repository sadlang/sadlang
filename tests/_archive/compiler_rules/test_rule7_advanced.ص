# ===== اختبار القاعدة 7: دوال تكرارية ونصوص ومطابقة =====

# ----- 1. دالة تكرارية (factorial) -----

استورد رياضيات

دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

اطبع_سطر("اختبار 1: مضروب(5) = " + مضروب(5))
اطبع_سطر("اختبار 1: مضروب(10) = " + مضروب(10))

# ----- 2. فيبوناتشي -----
دالة فيب(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيب(ن - 1) + فيب(ن - 2)
نهاية

اطبع_سطر("اختبار 2: فيب(10) = " + فيب(10))

# ----- 3. مطابقة أنماط متقدمة -----
دالة وصف_رقم(ن)
    طابق (ن)
        عندما 0:
            ارجع "صفر"
        عندما 1:
            ارجع "واحد"
        عندما 2:
            ارجع "اثنان"
        افتراضي:
            ارجع "كبير"
    نهاية
نهاية

اطبع_سطر("اختبار 3: " + وصف_رقم(0))
اطبع_سطر("اختبار 3: " + وصف_رقم(2))
اطبع_سطر("اختبار 3: " + وصف_رقم(99))

# ----- 4. عمليات نصية -----
متغير نص1 = "مرحبا"
متغير نص2 = " بالعالم"
متغير نص3 = نص1 + نص2
اطبع_سطر("اختبار 4: " + نص3)
اطبع_سطر("اختبار 4: طول = " + طول(نص3))

# ----- 5. دوال متعددة المعاملات -----
دالة أكبر3(أ، ب، ج)
    إذا (أ >= ب و أ >= ج)
        ارجع أ
    نهاية
    إذا (ب >= أ و ب >= ج)
        ارجع ب
    نهاية
    ارجع ج
نهاية

اطبع_سطر("اختبار 5: أكبر(3,7,5) = " + أكبر3(3، 7، 5))
اطبع_سطر("اختبار 5: أكبر(9,2,6) = " + أكبر3(9، 2، 6))

# ----- 6. إسناد مركب -----
متغير ع6 = 10
ع6 += 5
اطبع_سطر("اختبار 6: += " + ع6)
ع6 -= 3
اطبع_سطر("اختبار 6: -= " + ع6)
ع6 *= 2
اطبع_سطر("اختبار 6: *= " + ع6)
