# ===== اختبار القاعدة 4: التعدادات والبنى =====

# ----- 1. تعداد بسيط -----
تعداد اللون
    أحمر
    أخضر
    أزرق
نهاية

متغير ل = اللون.أحمر
اطبع_سطر("اختبار 1: لون = " + ل)

# ----- 2. مطابقة تعداد -----
دالة اسم_اللون(ل)
    طابق (ل)
        عندما 0:
            ارجع "أحمر"
        عندما 1:
            ارجع "أخضر"
        عندما 2:
            ارجع "أزرق"
        افتراضي:
            ارجع "مجهول"
    نهاية
نهاية

اطبع_سطر("اختبار 2: " + اسم_اللون(اللون.أحمر))
اطبع_سطر("اختبار 2: " + اسم_اللون(اللون.أزرق))

# ----- 3. بنية بسيطة -----
بنية نقطة
    س = 0
    ص = 0
نهاية

متغير ن = جديد نقطة()
ن.س = 10
ن.ص = 20
اطبع_سطر("اختبار 3: (" + ن.س + "، " + ن.ص + ")")

# ----- 4. صنف مع باني -----
صنف مستطيل
    متغير عام عرض
    متغير عام ارتفاع
    
    باني(ع، ر)
        هذا.عرض = ع
        هذا.ارتفاع = ر
    نهاية
    
    دالة عام مساحة()
        ارجع هذا.عرض * هذا.ارتفاع
    نهاية
نهاية

متغير م = جديد مستطيل(5، 3)
اطبع_سطر("اختبار 4: مساحة = " + م.مساحة())

# ----- 5. صنف مع وراثة -----
صنف شكل
    متغير عام اسم
    
    باني(ا)
        هذا.اسم = ا
    نهاية
    
    دالة عام وصف()
        ارجع "شكل: " + هذا.اسم
    نهاية
نهاية

صنف دائرة يرث شكل
    متغير عام نصف_قطر
    
    باني(نق)
        الأساس("دائرة")
        هذا.نصف_قطر = نق
    نهاية
    
    دالة عام وصف()
        ارجع "دائرة بنصف قطر " + هذا.نصف_قطر
    نهاية
نهاية

متغير د = جديد دائرة(7)
اطبع_سطر("اختبار 5: " + د.وصف())
اطبع_سطر("اختبار 5: اسم = " + د.اسم)
