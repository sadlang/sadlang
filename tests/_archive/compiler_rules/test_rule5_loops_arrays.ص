# ===== اختبار القاعدة 5: الحلقات المتقدمة والمصفوفات =====

# ----- 1. بينما بسيطة -----
متغير ع = 0
متغير مجموع = 0
بينما (ع < 5)
    مجموع = مجموع + ع
    ع = ع + 1
نهاية
اطبع_سطر("اختبار 1: مجموع = " + مجموع)

# ----- 2. لكل على مصفوفة -----
متغير أرقام = [10، 20، 30]
متغير مج = 0
لكل ر في أرقام
    مج = مج + ر
نهاية
اطبع_سطر("اختبار 2: مجموع = " + مج)

# ----- 3. توقف واستمر -----
متغير نتيجة = 0
متغير ي = 0
بينما (ي < 10)
    ي = ي + 1
    إذا (ي == 3)
        استمر
    نهاية
    إذا (ي == 7)
        توقف
    نهاية
    نتيجة = نتيجة + ي
نهاية
اطبع_سطر("اختبار 3: نتيجة = " + نتيجة)

# ----- 4. حلقة متداخلة -----
متغير ن4 = ""
لكل ص2 في [1، 2، 3]
    لكل س2 في [1، 2، 3]
        إذا (ص2 == س2)
            ن4 = ن4 + "*"
        وإلا
            ن4 = ن4 + "."
        نهاية
    نهاية
نهاية
اطبع_سطر("اختبار 4: " + ن4)

# ----- 5. دوال على مصفوفة -----
متغير م5 = [3، 1، 4، 1، 5]
اطبع_سطر("اختبار 5: طول = " + طول(م5))

# ----- 6. العامل الثلاثي -----
متغير س6 = 10
متغير ت6 = س6 > 5 ؟ "كبير" : "صغير"
اطبع_سطر("اختبار 6: " + ت6)

