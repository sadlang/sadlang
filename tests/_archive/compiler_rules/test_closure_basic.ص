# === اختبار Closure: لامدا تلتقط متغير خارجي ===

# 1. التقاط متغير خارجي
متغير قاعدة = 100
متغير أضف_للقاعدة = لامدا(س) => س + قاعدة
اطبع_سطر("أضف_للقاعدة(5) = " + أضف_للقاعدة(5))

# 2. Closure مباشر في نفس المستوى
دالة مصنع(ع)
    متغير داخلي = ع * 10
    ارجع داخلي
نهاية
اطبع_سطر("مصنع(3) = " + مصنع(3))
