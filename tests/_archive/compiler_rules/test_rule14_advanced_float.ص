# === اختبار القاعدة 14: عمليات عشرية متقدمة وحالات حافة ===

# === اختبار 1: متغير عشري يتغير ===
متغير مبلغ = 100.50
مبلغ = مبلغ + 50.25
اطبع_سطر("اختبار 1: مبلغ = " + مبلغ)

# === اختبار 2: عشري من دالة ===
دالة حساب_ضريبة(سعر)
    ارجع سعر * 0.15
نهاية

اطبع_سطر("اختبار 2: ضريبة 200 = " + حساب_ضريبة(200))

# === اختبار 3: عشري في حلقة ===
متغير مجموع = 0.0
لكل ع من 1 الى 5
    مجموع = مجموع + ع * 1.5
نهاية
اطبع_سطر("اختبار 3: مجموع = " + مجموع)

# === اختبار 4: قسمة تنتج عشري ===
متغير ن = 7 / 2
اطبع_سطر("اختبار 4: 7/2 = " + ن)

# === اختبار 5: عشري سالب ===
متغير حرارة = -5.5
إذا (حرارة < 0)
    اطبع_سطر("اختبار 5: تحت الصفر")
وإلا
    اطبع_سطر("اختبار 5: فوق الصفر")
نهاية

# === اختبار 6: عمليات متسلسلة ===
متغير أ = 10
متغير ب = 3
متغير حاصل = أ / ب
اطبع_سطر("اختبار 6: 10/3 = " + حاصل)

# === اختبار 7: صنف مع حقل عشري ===
صنف دائرة
    متغير عام نصف_قطر
    باني(نق)
        هذا.نصف_قطر = نق
    نهاية
    دالة عام المحيط()
        ارجع 2 * 3.14 * هذا.نصف_قطر
    نهاية
نهاية

متغير د = جديد دائرة(5)
