# === اختبار Lambda بسيط: ما يعمل في المترجم ===

# 1. لامدا مباشرة في متغير واستدعاؤها
متغير مضاعف = لامدا(س) => س * 2
اطبع_سطر("مضاعف(7) = " + مضاعف(7))

# 2. لامدا مع عدة معاملات
متغير جامع = لامدا(أ، ب) => أ + ب
اطبع_سطر("جامع(3,8) = " + جامع(3, 8))

# 3. لامدا ككتلة
متغير حاسب = لامدا(أ، ب)
    متغير نت = أ * ب
    ارجع نت + 1
نهاية
اطبع_سطر("حاسب(3,4) = " + حاسب(3, 4))
