# اختبار القاعدة 1: تصريح المتغيرات والثوابت
# يغطي: متغير، ثابت، أنواع صريحة، إسناد، إسناد مركب

# === 1. تصريحات أساسية ===
متغير أ = 10
متغير ب = 20
ثابت ج = 100

اطبع_سطر("=== اختبار المتغيرات ===")
اطبع_سطر("أ = " + أ)
اطبع_سطر("ب = " + ب)
اطبع_سطر("ج = " + ج)

# === 2. إسناد وتعديل ===
أ = 50
ب = أ + ج
اطبع_سطر("بعد التعديل: أ = " + أ)
اطبع_سطر("بعد التعديل: ب = " + ب)

# === 3. إسناد مركب ===
متغير س = 100
س += 50
اطبع_سطر("س += 50: " + س)
س -= 30
اطبع_سطر("س -= 30: " + س)
س *= 2
اطبع_سطر("س *= 2: " + س)
س /= 4
اطبع_سطر("س /= 4: " + س)
س %= 7
اطبع_سطر("س %= 7: " + س)

# === 4. عمليات حسابية معقدة ===
متغير نتيجة1 = (10 + 20) * 3 - 5
متغير نتيجة2 = 100 / 4 + 50 % 7
متغير نتيجة3 = 2 ** 10
اطبع_سطر("(10+20)*3-5 = " + نتيجة1)
اطبع_سطر("100/4+50%7 = " + نتيجة2)
اطبع_سطر("2**10 = " + نتيجة3)

# === 5. عمليات المقارنة ===
اطبع_سطر("10 > 5: " + (10 > 5))
اطبع_سطر("10 < 5: " + (10 < 5))
اطبع_سطر("10 == 10: " + (10 == 10))
اطبع_سطر("10 != 5: " + (10 != 5))
اطبع_سطر("10 >= 10: " + (10 >= 10))
اطبع_سطر("10 <= 5: " + (10 <= 5))

# === 6. عمليات منطقية ===
متغير ص = صحيح
متغير ع = خطأ
اطبع_سطر("صحيح و خطأ: " + (ص و ع))
اطبع_سطر("صحيح أو خطأ: " + (ص أو ع))
اطبع_سطر("ليس صحيح: " + (ليس ص))
اطبع_سطر("ليس خطأ: " + (ليس ع))

# === 7. متغيرات نصية ===
متغير اسم = "لغة ص"
متغير وصف = "لغة برمجة عربية"
متغير معلومات = اسم + " - " + وصف
اطبع_سطر(معلومات)

# === 8. تعبير ثلاثي ===
متغير عمر = 25
متغير حالة = عمر >= 18 ؟ "بالغ" : "قاصر"
اطبع_سطر("الحالة: " + حالة)

متغير رقم1 = 15
متغير وتر = رقم1 > 10 ؟ "كبير" : "صغير"
اطبع_سطر("الوتر: " + وتر)

# === 9. سلسلة عمليات ===
متغير خ = 1
خ = خ + 2
خ = خ * 3
خ = خ - 1
اطبع_سطر("سلسلة: " + خ)

# === 10. قيم خاصة ===
متغير فارغ = لاشيء
اطبع_سطر("فارغ: " + فارغ)
متغير صح = صحيح
متغير خطا = خطأ
اطبع_سطر("صح: " + صح)
اطبع_سطر("خطا: " + خطا)
