اطبع_سطر("قبل: " + بيانات["عمر"])
بيانات["عمر"] = 30
اطبع_سطر("بعد: " + بيانات["عمر"])

اطبع_سطر("=== اختبار 5: أنواع قيم مختلفة ===")
متغير مختلط = {"نص_ق": "مرحبا", "رقم_ق": 42, "عشري_ق": 3, "منطقي_ق": صحيح}
