# ===== اختبار القاعدة 8: ثوابت وعمليات متقدمة =====

# ----- 1. ثوابت -----
ثابت باي = 3
ثابت ماكس = 100
اطبع_سطر("اختبار 1: باي = " + باي)
اطبع_سطر("اختبار 1: ماكس = " + ماكس)

# ----- 2. مصفوفة وعمليات -----
متغير م = [5، 3، 8، 1، 9، 2]
اطبع_سطر("اختبار 2: طول = " + طول(م))

# ----- 3. نطاق مع لكل -----
متغير مج3 = 0
لكل ي في [1، 2، 3، 4، 5]
    مج3 = مج3 + ي
نهاية
اطبع_سطر("اختبار 3: مجموع = " + مج3)

# ----- 4. شروط متسلسلة -----
دالة تصنيف(درجة)
    إذا (درجة >= 90)
        ارجع "ممتاز"
    وإلا
        إذا (درجة >= 80)
            ارجع "جيد جداً"
        وإلا
            إذا (درجة >= 70)
                ارجع "جيد"
            وإلا
                ارجع "مقبول"
            نهاية
        نهاية
    نهاية
نهاية

اطبع_سطر("اختبار 4: " + تصنيف(95))
اطبع_سطر("اختبار 4: " + تصنيف(85))
اطبع_سطر("اختبار 4: " + تصنيف(75))
اطبع_سطر("اختبار 4: " + تصنيف(60))

# ----- 5. عامل المُعامل (modulo) -----
اطبع_سطر("اختبار 5: 10 % 3 = " + (10 % 3))
اطبع_سطر("اختبار 5: 15 % 4 = " + (15 % 4))

# ----- 6. عامل الأس -----
اطبع_سطر("اختبار 6: 2 ** 10 = " + (2 ** 10))
اطبع_سطر("اختبار 6: 3 ** 4 = " + (3 ** 4))

# ----- 7. سلسلة دوال -----
دالة مزدوج(ن)
    ارجع ن * 2
نهاية

دالة زائد_واحد(ن)
    ارجع ن + 1
نهاية

اطبع_سطر("اختبار 7: مزدوج(زائد_واحد(4)) = " + مزدوج(زائد_واحد(4)))
