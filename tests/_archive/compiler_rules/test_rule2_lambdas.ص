# --- 9. حلقة لكل مع Range ---
متغير مج = 0
لكل ع من 1 الى 10
    مج = مج + ع
نهاية
اطبع_سطر("مجموع 1-10: " + مج)

# --- 10. تعبير ثلاثي ---
متغير س = 15
متغير وصف = س > 10 ؟ "كبير" : "صغير"
اطبع_سطر("الوصف: " + وصف)

# --- 11. مطابقة أنماط متقدمة ---
دالة وصف_رقم(ن)
    طابق (ن)
        عندما 0:
            ارجع "صفر"
        عندما 1:
            ارجع "واحد"
        افتراضي:
            ارجع "عدد: " + ن
    نهاية
نهاية

اطبع_سطر(وصف_رقم(0))
اطبع_سطر(وصف_رقم(1))
اطبع_سطر(وصف_رقم(42))

# --- 12. دوال متعددة الإرجاع مع شروط ---
دالة أكبر3(أ، ب، ج)
    إذا (أ >= ب و أ >= ج)
        ارجع أ
    وإلا
        إذا (ب >= ج)
            ارجع ب
        وإلا
            ارجع ج
        نهاية
    نهاية
نهاية
اطبع_سطر("أكبر(5,9,3) = " + أكبر3(5, 9, 3))

# --- 13. عمليات المصفوفات ---
متغير أرقام = [10, 20, 30, 40, 50]
أرقام.اضف(60)
اطبع_سطر("أول: " + أرقام[0])
اطبع_سطر("آخر: " + أرقام[5])
اطبع_سطر("طول: " + طول(أرقام))

# --- 14. حلقة لكل على مصفوفة ---
متغير مجموع_م = 0
لكل ع في أرقام
    مجموع_م = مجموع_م + ع
نهاية
اطبع_سطر("مجموع المصفوفة: " + مجموع_م)

# --- 15. دوال تكرارية معقدة ---
دالة فيبوناتشي(ن)
    إذا (ن <= 1)
        ارجع ن
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية
اطبع_سطر("فيب(12) = " + فيبوناتشي(12))

# --- 16. عوامل منطقية ---
متغير أ = صحيح
متغير ب = خطأ
اطبع_سطر("أ و ب = " + (أ و ب))
اطبع_سطر("أ أو ب = " + (أ أو ب))
اطبع_سطر("ليس أ = " + (ليس أ))

# --- 17. دالة مضروب تكرارية ---
دالة مضروب_ت(ن)
    متغير نتيجة = 1
    لكل ع من 1 الى ن
        نتيجة = نتيجة * ع
    نهاية
    ارجع نتيجة
نهاية
اطبع_سطر("8! = " + مضروب_ت(8))

# --- 18. OOP بسيط مع وراثة ---
صنف كائن_أساس
    متغير عام قيمة
    باني(ق)
        هذا.قيمة = ق
    نهاية
    دالة عام احصل()
        ارجع هذا.قيمة
    نهاية
نهاية

صنف كائن_مضاعف يرث كائن_أساس
    باني(ق)
        الأساس(ق)
    نهاية
    دالة عام مضاعف()
        ارجع هذا.قيمة * 2
    نهاية
نهاية

متغير ك = جديد كائن_مضاعف(21)
اطبع_سطر("قيمة: " + ك.احصل())
اطبع_سطر("مضاعف: " + ك.مضاعف())

# --- 19. تعبيرات مركبة ---
متغير ن = 100
ن += 50
ن -= 20
اطبع_سطر("100+50-20 = " + ن)

# --- 20. حلقة بينما مع توقف ---
متغير عد = 0
متغير مج2 = 0
بينما (عد < 100)
    عد = عد + 1
    إذا (عد % 2 != 0)
        استمر
    نهاية
    مج2 = مج2 + عد
    إذا (عد >= 20)
        توقف
    نهاية
نهاية
اطبع_سطر("مجموع الأزواج حتى 20: " + مج2)
