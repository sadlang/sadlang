# === اختبار القاعدة 2: اللامدا والمغلفات والبنى والتعدادات ===

# --- 1. لامدا بسيطة ---
متغير مضاعف = لامدا(س) => س * 2
اطبع_سطر("مضاعف(7) = " + مضاعف(7))

# --- 2. لامدا مع عدة معاملات ---
متغير جامع = لامدا(أ، ب) => أ + ب
اطبع_سطر("جامع(3,8) = " + جامع(3, 8))

# --- 3. لامدا متداخلة ---
دالة صانع_جامع(س)
    متغير مضيف = لامدا(ع) => ع + س
    ارجع مضيف
نهاية

متغير أضف5 = صانع_جامع(5)
اطبع_سطر("أضف5(10) = " + أضف5(10))

# --- 4. لامدا ككتلة ---
متغير حاسب = لامدا(أ، ب)
    متغير نت = أ * ب
    ارجع نت + 1
نهاية
اطبع_سطر("حاسب(3,4) = " + حاسب(3, 4))

# --- 5. تمرير لامدا لدالة ---
دالة طبّق(دالة_م، قيمة)
    ارجع دالة_م(قيمة)
نهاية

اطبع_سطر("طبّق(مضاعف,9) = " + طبّق(مضاعف, 9))

# --- 6. Closure: إغلاق على متغير خارجي ---
دالة عداد_مغلف()
    متغير ع = 0
    متغير زد = لامدا()
        ع = ع + 1
        ارجع ع
    نهاية
    ارجع زد
نهاية

متغير ز = عداد_مغلف()
اطبع_سطر("عداد1: " + ز())
اطبع_سطر("عداد2: " + ز())
اطبع_سطر("عداد3: " + ز())

