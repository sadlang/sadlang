# اختبار القاعدة 1-4: المصفوفات والخرائط والسلاسل النصية
# يغطي: مصفوفات، خرائط، طرق مدمجة، f-strings، سلاسل نصية

اطبع_سطر("=== اختبار المصفوفات ===")

# === 1. مصفوفة أساسية ===
متغير أرقام = [10, 20, 30, 40, 50]
اطبع_سطر("الطول: " + طول(أرقام))
اطبع_سطر("أول: " + أرقام[0])
اطبع_سطر("آخر: " + أرقام[4])

# === 2. تعديل عناصر ===
أرقام[2] = 99
اطبع_سطر("بعد التعديل [2]: " + أرقام[2])

# === 3. إضافة عناصر ===
متغير قائمة = [1, 2, 3]
قائمة.اضف(4)
قائمة.اضف(5)
اطبع_سطر("بعد الإضافة: " + طول(قائمة))

# === 4. مصفوفة فارغة ===
متغير فارغة = []
فارغة.اضف(100)
فارغة.اضف(200)
اطبع_سطر("من فارغة: " + فارغة[0] + "," + فارغة[1])

# === 5. بحث في مصفوفة ===
متغير أسماء = ["أحمد", "سارة", "محمد", "فاطمة"]
متغير وجد = خطأ
لكل اسم في أسماء
    إذا (اسم == "محمد")
        وجد = صحيح
    نهاية
نهاية
اطبع_سطر("وجد محمد: " + وجد)

اطبع_سطر("=== اختبار الخرائط ===")

# === 6. خريطة أساسية ===
متغير طالب = {"اسم": "علي", "عمر": 20, "درجة": 85}
اطبع_سطر("الاسم: " + طالب["اسم"])
اطبع_سطر("العمر: " + طالب["عمر"])

# === 7. تعديل خريطة ===
طالب["درجة"] = 95
اطبع_سطر("الدرجة الجديدة: " + طالب["درجة"])

اطبع_سطر("=== اختبار النصوص ===")

# === 8. عمليات نصية ===
متغير نص1 = "مرحباً"
متغير نص2 = "بالعالم"
متغير جملة = نص1 + " " + نص2
اطبع_سطر(جملة)
اطبع_سطر("طول الجملة: " + طول(جملة))

# === 9. دمج أنواع مختلفة ===
متغير رقم = 42
متغير منطقي_ق = صحيح
اطبع_سطر("الرقم: " + رقم)
اطبع_سطر("المنطقي: " + منطقي_ق)

# === 10. مصفوفة من ناتج حلقة ===
