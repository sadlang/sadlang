لكل ع من 1 الى 6
    مربعات.اضف(ع * ع)
نهاية
متغير ناتج = ""
لكل م في مربعات
    إذا (ناتج != "")
        ناتج = ناتج + ","
    نهاية
    ناتج = ناتج + م
نهاية
