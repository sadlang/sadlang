// بنية نتيجة الاختبار
// ════════════════════════════════════════════════════════════════════════════

هيكل نتيجة_اختبار {
    ع32  عدد_النجاح;
    ع32  عدد_الفشل;
    ح8   آخر_فشل[128];
};

متغير نتيجة_اختبار النتائج = {0, 0, ""};

// ── دوال المساعدة للاختبار ───────────────────────────────────────────────

// إرسال نتيجة اختبار لـ UART
دالة طباعة_نص_اختبار(ثابت ح8* نص) → فراغ {
    // في بيئة اختبار QEMU نكتب على UART0
    ح8 متطاير* uart = (ح8 متطاير*)0x09000000;
    طالما (*نص != 0) {
        *uart = *نص;
        نص = نص + 1;
    }
}

// ماكرو اختبار يجمع النتائج
// استخدام: افحص(شرط, "اسم الاختبار")
دالةافحص(ع32 شرط, ثابت ح8* الاسم) → فراغ {
    إذا (شرط) {
        النتائج.عدد_النجاح = النتائج.عدد_النجاح + 1;
        طباعة_نص_اختبار("  ✓ ");
        طباعة_نص_اختبار(الاسم);
        طباعة_نص_اختبار("\n");
    } وإلا {
        النتائج.عدد_الفشل = النتائج.عدد_الفشل + 1;
        sad_strncpy(النتائج.آخر_فشل, الاسم, 127);
        طباعة_نص_اختبار("  ✗ FAIL: ");
        طباعة_نص_اختبار(الاسم);
        طباعة_نص_اختبار("\n");
    }
}

// ════════════════════════════════════════════════════════════════════════════
// الاختبار 1: التحقق من الأنواع الأساسية (sad_types.h)
// ════════════════════════════════════════════════════════════════════════════
// التحقق من أن أحجام الأنواع العربية صحيحة كما هو متوقع
// هذا مهم جداً في freestanding لأن الأنواع تُستخدم للتعامل مع العتاد مباشرة
دالة اختبار_الأنواع() → فراغ {
    طباعة_نص_اختبار("\n[1] اختبار الأنواع الأساسية\n");

    // (AR) ع8 = unsigned 8-bit = 0..255
    ع8  ع8_صفر     = 0;
    ع8  ع8_أقصى    = 255;
    افحص(ع8_صفر == 0,   "ع8: القيمة الصفرية");
    افحص(ع8_أقصى == 255, "ع8: القيمة القصوى");

    // (AR) ع16 = unsigned 16-bit = 0..65535
    ع16 ع16_أقصى   = 65535;
    افحص(ع16_أقصى == 65535, "ع16: القيمة القصوى");

    // (AR) ع32 = unsigned 32-bit
    ع32 ع32_قيمة   = 0xDEADBEEF;
    افحص(ع32_قيمة == 0xDEADBEEF, "ع32: قيمة 0xDEADBEEF");

    // (AR) ع64 = unsigned 64-bit
    ع64 ع64_قيمة   = 0xCAFEBABEDEAD0000;
    افحص(ع64_قيمة == 0xCAFEBABEDEAD0000, "ع64: قيمة 64-bit");

    // (AR) ح8/ح16/ح32/ح64 = signed variants
    ح32 ح32_سالب   = -1;
    افحص(ح32_سالب == -1, "ح32: قيمة سالبة (−1)");

    ح64 ح64_سالب   = -9223372036854775807 - 1;  // INT64_MIN
    افحص(ح64_سالب < 0, "ح64: أصغر قيمة سالبة");

    // (AR) عنوان = uintptr_t = حجم المؤشر على المنصة
    عنوان مؤشر_اختبار = 0x1000;
    افحص(مؤشر_اختبار == 0x1000, "عنوان: قيمة صحيحة");

    // (AR) التحقق من أن sizeof صحيح للأنواع
    افحص(sizeof(ع8)  == 1, "sizeof(ع8) == 1");
    افحص(sizeof(ع16) == 2, "sizeof(ع16) == 2");
    افحص(sizeof(ع32) == 4, "sizeof(ع32) == 4");
    افحص(sizeof(ع64) == 8, "sizeof(ع64) == 8");
}

// ════════════════════════════════════════════════════════════════════════════
// الاختبار 2: ماكروهات التحكم (sad_control_flow.h)
// ════════════════════════════════════════════════════════════════════════════
// تأكيد أن الماكروهات العربية تعمل بشكل صحيح ومعادل لأقسامها الإنجليزية
دالة اختبار_هياكل_التحكم() → فراغ {
    طباعة_نص_اختبار("\n[2] اختبار هياكل التحكم\n");

    // ── اختبار إذا / وإلا_إذا / وإلا ──────────────────────────────────────
    {
        ع32 ن = 50;
        ع32 نتيجة = 0;
        إذا (ن < 10)         { نتيجة = 1; }
        وإلا_إذا (ن < 100)   { نتيجة = 2; }   // ← يجب أن يُنفَّذ هذا
        وإلا                  { نتيجة = 3; }
        افحص(نتيجة == 2, "إذا/وإلا_إذا/وإلا: التفرّع الصحيح");
    }

    // ── اختبار طالما ────────────────────────────────────────────────────────
    {
        ع32 عداد = 0;
        طالما (عداد < 10) {
            عداد = عداد + 1;
        }
        افحص(عداد == 10, "طالما: عدّ حتى 10");
    }

    // ── اختبار لكل ──────────────────────────────────────────────────────────
    {
        ع32 مجموع = 0;
        لكل (ع32 ع = 1; ع <= 5; ع = ع + 1) {
            مجموع = مجموع + ع;
        }
        افحص(مجموع == 15, "لكل: مجموع 1+2+3+4+5 == 15");
    }

    // ── اختبار حلقة مع أوقف ─────────────────────────────────────────────────
    {
        ع32 عداد = 0;
        حلقة {
            عداد = عداد + 1;
            إذا (عداد == 7) {
                أوقف;
            }
        }
        افحص(عداد == 7, "حلقة + أوقف: توقف عند 7");
    }

    // ── اختبار لكل مع أكمل ──────────────────────────────────────────────────
    {
        ع32 عدد_الفردي = 0;
        لكل (ع32 ع = 0; ع < 10; ع = ع + 1) {
            إذا (ع % 2 == 0) {
                أكمل;  // تخطّي الأعداد الزوجية
            }
            عدد_الفردي = عدد_الفردي + 1;
        }
        افحص(عدد_الفردي == 5, "لكل + أكمل: 5 أعداد فردية في [0..9]");
    }

    // ── اختبار تطابق (switch/case) ──────────────────────────────────────────
    {
        ع32 لون = 2;
        ع32 نتيجة = 0;
        تطابق (لون) {
            حالة 1: نتيجة = 10; أوقف;
            حالة 2: نتيجة = 20; أوقف;   // ← يجب أن يُنفَّذ
            حالة 3: نتيجة = 30; أوقف;
            افتراضي: نتيجة = 99;
        }
        افحص(نتيجة == 20, "تطابق/حالة: الحالة الصحيحة");
    }

    // ── اختبار تطابق مع حالة افتراضي ────────────────────────────────────────
    {
        ع32 قيمة = 99;
        ع32 نتيجة = 0;
        تطابق (قيمة) {
            حالة 1: نتيجة = 1; أوقف;
            حالة 2: نتيجة = 2; أوقف;
            افتراضي: نتيجة = 42;
        }
        افحص(نتيجة == 42, "تطابق/افتراضي: الحالة الافتراضية");
    }

    // ── اختبار لكل_ع32 ──────────────────────────────────────────────────────
    {
        ع32 مجموع = 0;
        لكل_ع32(ع, 5) {
            مجموع = مجموع + ع;  // 0+1+2+3+4 = 10
        }
        افحص(مجموع == 10, "لكل_ع32: مجموع [0..4] == 10");
    }
}

// ════════════════════════════════════════════════════════════════════════════
// الاختبار 3: دوال الذاكرة (sad_core.h)
// ════════════════════════════════════════════════════════════════════════════
// التحقق من صحة دوال الذاكرة الأساسية المتوفرة في freestanding runtime
دالة اختبار_الذاكرة() → فراغ {
    طباعة_نص_اختبار("\n[3] اختبار دوال الذاكرة\n");

    // ── اختبار sad_memset ────────────────────────────────────────────────────
    {
        ح8 مخزن[16];
        sad_memset(مخزن, 0xCC, 16);
        افحص(مخزن[0]  == (ح8)0xCC, "sad_memset: البايت الأول");
        افحص(مخزن[15] == (ح8)0xCC, "sad_memset: البايت الأخير");
        افحص(مخزن[7]  == (ح8)0xCC, "sad_memset: البايت الأوسط");
    }

    // ── اختبار sad_memzero ───────────────────────────────────────────────────
    {
        ح8 مخزن[8] = {1, 2, 3, 4, 5, 6, 7, 8};
        sad_memzero(مخزن, 8);
        ع32 كل_صفر = صحيح;
        لكل_ع32(ع, 8) {
            إذا (مخزن[ع] != 0) { كل_صفر = خطأ; }
        }
        افحص(كل_صفر, "sad_memzero: كل البايتات = 0");
    }

    // ── اختبار sad_memcpy ────────────────────────────────────────────────────
    {
        ح8 مصدر[8] = {0x1, 0x2, 0x3, 0x4, 0x5, 0x6, 0x7, 0x8};
        ح8 هدف[8]  = {0};
        sad_memcpy(هدف, مصدر, 8);
        ع32 نسخ_صحيح = صحيح;
        لكل_ع32(ع, 8) {
            إذا (هدف[ع] != مصدر[ع]) { نسخ_صحيح = خطأ; }
        }
        افحص(نسخ_صحيح, "sad_memcpy: نسخ 8 بايتات بشكل صحيح");
    }

    // ── اختبار sad_memcmp ────────────────────────────────────────────────────
    {
        ح8 أ[4] = {1, 2, 3, 4};
        ح8 ب[4] = {1, 2, 3, 4};
        ح8 ج[4] = {1, 2, 3, 5};
        افحص(sad_memcmp(أ, ب, 4) == 0, "sad_memcmp: أ == ب");
        افحص(sad_memcmp(أ, ج, 4) != 0, "sad_memcmp: أ != ج");
    }

    // ── اختبار sad_strlen ────────────────────────────────────────────────────
    {
        ثابت ح8* نص = "مرحبا";
        حجم طول = sad_strlen(نص);
        // "مرحبا" = 5 حروف عربية × 2 بايت في بعض الترميزات
        // أو 10 بايت في UTF-8 (2 بايت لكل حرف عربي U+0645..U+0627)
        افحص(طول > 0, "sad_strlen: طول غير صفري");
    }

    // ── اختبار sad_strncpy ───────────────────────────────────────────────────
    {
        ح8 هدف[16] = {0};
        ثابت ح8* مصدر = "hello";
        sad_strncpy(هدف, مصدر, 10);
        افحص(هدف[0] == 'h', "sad_strncpy: الحرف الأول صحيح");
        افحص(هدف[4] == 'o', "sad_strncpy: الحرف الأخير صحيح");
        افحص(هدف[5] == 0,   "sad_strncpy: null terminator موجود");
    }

    // ── اختبار sad_memmove (نسخ متداخل) ─────────────────────────────────────
    {
        ح8 مخزن[16] = {1,2,3,4,5,6,7,8,0,0,0,0,0,0,0,0};
        // نقل من [0..4) إلى [2..6) — تداخل
        sad_memmove(&مخزن[2], &مخزن[0], 4);
        افحص(مخزن[2] == 1, "sad_memmove: البايت الأول في الوجهة");
        افحص(مخزن[5] == 4, "sad_memmove: البايت الأخير في الوجهة");
    }
}

// ════════════════════════════════════════════════════════════════════════════
// الاختبار 4: ماكروهات المزامنة والأمان
// ════════════════════════════════════════════════════════════════════════════
دالة اختبار_الماكروهات_المتقدمة() → فراغ {
    طباعة_نص_اختبار("\n[4] اختبار الماكروهات المتقدمة\n");

    // ── اختبار مرجَّح/نادر (branch prediction hints) ────────────────────────
    {
        ع32 قيمة = 1;
        ع32 نتيجة = 0;
        إذا (مرجَّح(قيمة == 1)) {
            نتيجة = 42;
        }
        افحص(نتيجة == 42, "مرجَّح(): تلميح التفرع الشائع يعمل");
    }

    {
        ع32 قيمة = 999;
        ع32 نتيجة = 0;
        إذا (نادر(قيمة == 999)) {
            نتيجة = 7;
        }
        افحص(نتيجة == 7, "نادر(): تلميح التفرع النادر يعمل");
    }

    // ── اختبار انتظر_بينما ──────────────────────────────────────────────────
    {
        // انتظر_بينما(خطأ) = حلقة تدور مرة واحدة فقط ثم تخرج
        ع32 عداد = 0;
        انتظر_بينما(خطأ) {
            عداد = عداد + 1;
            // هذا لن يُنفَّذ لأن الشرط خطأ
        }
        // ملاحظة: انتظر_بينما(خطأ) لا تدخل الحلقة
        افحص(عداد == 0, "انتظر_بينما(خطأ): لا تدخل الحلقة");
    }

    // ── اختبار تأكد (assert) ────────────────────────────────────────────────
    {
        // تأكد(صحيح) يجب ألا يُوقف البرنامج
        تأكد(صحيح);  // ← هذا السطر يجب أن يمر بسلام
        افحص(صحيح, "تأكد(صحيح): لا يُوقف البرنامج");
        
        // ملاحظة: لا نختبر تأكد(خطأ) لأنه يُوقف البرنامج
        // راجع معالج_الذعر للتحقق من سلوك الفشل
    }

    // ── اختبار قسم_حرج (critical section) ──────────────────────────────────
    {
        ع32 متغير_مشترك = 0;
        
        // تعطيل المقاطعات لمنع السباق على البيانات
        قسم_حرج_بدء;
        متغير_مشترك = متغير_مشترك + 1;
        قسم_حرج_نهاية;
        
        افحص(متغير_مشترك == 1, "قسم_حرج: التعديل الذري يعمل");
    }
}

// ════════════════════════════════════════════════════════════════════════════
// الاختبار 5: عمليات البت (Bitwise Operations)
// ════════════════════════════════════════════════════════════════════════════
// عمليات البت أساسية في برمجة العتاد والأنوية
دالة اختبار_عمليات_البت() → فراغ {
    طباعة_نص_اختبار("\n[5] اختبار عمليات البت\n");

    ع32 أ = 0b10101010;  // 0xAA = 170
    ع32 ب = 0b11001100;  // 0xCC = 204

    // AND
    افحص((أ & ب) == 0b10001000, "& (AND): 0xAA & 0xCC == 0x88");

    // OR
    افحص((أ | ب) == 0b11101110, "| (OR): 0xAA | 0xCC == 0xEE");

    // XOR
    افحص((أ ^ ب) == 0b01100110, "^ (XOR): 0xAA ^ 0xCC == 0x66");

    // NOT
    ع8 ن = (ع8)~(ع8)0xF0;
    افحص(ن == 0x0F, "~ (NOT): ~0xF0 == 0x0F");

    // إزاحة يساراً
    ع32 إزاحة_يسار = 1 << 8;
    افحص(إزاحة_يسار == 256, "<< (إزاحة يسار): 1 << 8 == 256");

    // إزاحة يميناً
    ع32 إزاحة_يمين = 256 >> 4;
    افحص(إزاحة_يمين == 16, ">> (إزاحة يمين): 256 >> 4 == 16");

    // ضبط بت
    ع32 سجل = 0;
    سجل = سجل | (1 << 3);   // ضبط البت 3
    افحص((سجل & (1 << 3)) != 0, "ضبط البت 3");

    // مسح بت
    سجل = سجل & ~(1 << 3);  // مسح البت 3
    افحص((سجل & (1 << 3)) == 0, "مسح البت 3");

    // تبديل بت
    سجل = سجل ^ (1 << 5);
    افحص((سجل & (1 << 5)) != 0, "تبديل البت 5");

    // اختبار بت
    ع32 مسجل_الحالة = 0b00101001;
    افحص((مسجل_الحالة >> 0) & 1, "BJP البت 0 مضبوط");
    افحص((مسجل_الحالة >> 3) & 1, "البت 3 مضبوط");
    افحص(!((مسجل_الحالة >> 1) & 1), "البت 1 غير مضبوط");
}

// ════════════════════════════════════════════════════════════════════════════
// الاختبار 6: الحساب على مستوى البايت (Byte-level Arithmetic)
// ════════════════════════════════════════════════════════════════════════════
دالة اختبار_الحساب() → فراغ {
    طباعة_نص_اختبار("\n[6] اختبار الحساب\n");

    // (AR) الفائض في unsigned (Overflow is defined for unsigned types)
    ع8  ع8_فائض = 255 + 1;     // يجب أن يفيض → 0
    افحص(ع8_فائض == 0, "ع8: فائض 255+1 == 0");

    ع16 ع16_فائض = 65535 + 1; // يجب أن يفيض → 0
    افحص(ع16_فائض == 0, "ع16: فائض 65535+1 == 0");

    // (AR) القسمة الصحيحة
    ع32 حاصل = 17 / 5;
    ع32 باقي  = 17 % 5;
    افحص(حاصل == 3, "قسمة صحيحة: 17/5 == 3");
    افحص(باقي  == 2, "باقي القسمة: 17%5 == 2");

    // (AR) الضرب الكبير في 64-bit
    ع64 كبير = (ع64)0x100000000 * (ع64)0x100000000;  // 2^64 == 0
    افحص(كبير == 0, "ع64: فائض 2^64 == 0");

    // (AR) القيم السالبة في ح32
    ح32 سالب = -42;
    ح32 ناتج  = سالب * -1;
    افحص(ناتج == 42, "ح32: -42 × -1 == 42");
}

