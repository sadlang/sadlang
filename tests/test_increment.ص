# اختبار عمليات الزيادة والنقصان

# اختبار 1: ++
متغير أ = 5
++أ
اطبع("اختبار 1 - ++أ: " + أ)

# اختبار 2: --
متغير ب = 10
--ب
اطبع("اختبار 2 - --ب: " + ب)

# اختبار 3: ++ في تعبير
متغير ج = 3
متغير نتيجة = ++ج
اطبع("اختبار 3 - ++ج: ج=" + ج + " نتيجة=" + نتيجة)

# اختبار 4: -- في حلقة
متغير عداد = 5
بينما (عداد > 0)
    --عداد
نهاية
اطبع("اختبار 4 - عداد بعد حلقة: " + عداد)

# اختبار 5: ++ مع عشري
متغير د = 3.5
++د
اطبع("اختبار 5 - ++عشري: " + د)
