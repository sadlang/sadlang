# 3. دالة غير متزامنة مع منطق معقد
غير_متزامن دالة عاملي_غير_متزامن(ن)
   إذا (ن <= 1)
      ارجع 1
   نهاية
   متغير سابق = انتظر عاملي_غير_متزامن(ن - 1)
   ارجع ن * سابق
نهاية

متغير ع = انتظر عاملي_غير_متزامن(5)
اطبع_سطر("3. عاملي(5) async: " + ع)

