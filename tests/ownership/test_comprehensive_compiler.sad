# اختبار شامل لنظام الملكية في المترجم
# Comprehensive ownership system test for compiler

دالة رئيسية()
    # === اختبار 1: متغيرات بسيطة (لا أخطاء) ===
    نص رسالة = "مرحبا"
    رقم عدد = 100
    منطقي نتيجة = صح
    اطبع_سطر(رسالة)
    اطبع_سطر(عدد)

    # === اختبار 2: نقل ملكية نص ===
    نص اسم = "سعد"
    نص اسم2 = اسم

    # خطأ! استخدام اسم بعد نقل الملكية
    اطبع_سطر(اسم)

    # === اختبار 3: نسخ أرقام (لا خطأ) ===
    رقم أ = 5
    رقم ب = أ
    اطبع_سطر(أ)
    اطبع_سطر(ب)
نهاية
