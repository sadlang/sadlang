# اختبار 4: نقل الملكية (Move Semantics)
# Test 4: Move Semantics
# ═══════════════════════════════════════════════

دالة رئيسية()
    # إنشاء متغير نص (غير قابل للنسخ)
    نص رسالة = "مرحبا بالعالم!"
    اطبع("الرسالة الأصلية: ")
    اطبع_سطر(رسالة)
    
    # نقل الملكية: رسالة → رسالة_جديدة
    # بعد هذا السطر، 'رسالة' تصبح غير صالحة
    متغير رسالة_جديدة = رسالة
    
    # استخدام المتغير الجديد (يجب أن ينجح)
    اطبع("الرسالة المنقولة: ")
    اطبع_سطر(رسالة_جديدة)
    
    # محاولة استخدام المتغير القديم (يجب أن يُظهر خطأ!)
    اطبع("محاولة استخدام بعد النقل: ")
    اطبع_سطر(رسالة)
نهاية
