# اختبار 6: النطاقات والتنظيف التلقائي
# Test 6: Scopes and Automatic Cleanup
# ═══════════════════════════════════════════════

دالة رئيسية()
    # متغير في النطاق الخارجي
    نص رسالة_خارجية = "أهلاً من الخارج"
    
    اطبع_سطر("=== اختبار النطاقات ===")
    اطبع_سطر(رسالة_خارجية)
    
    # كتلة داخلية
    اذا (صحيح)
        نص رسالة_داخلية = "أهلاً من الداخل"
        اطبع_سطر(رسالة_داخلية)
        
        # المتغير الخارجي لا يزال متاحاً
        اطبع_سطر(رسالة_خارجية)
    نهاية
    
    # المتغير الخارجي لا يزال متاحاً بعد انتهاء الكتلة
    اطبع_سطر("بعد الكتلة:")
    اطبع_سطر(رسالة_خارجية)
    
    اطبع_سطر("=== نجح اختبار النطاقات ===")
نهاية
