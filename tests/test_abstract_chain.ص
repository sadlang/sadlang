    باني(لون)
        هذا.لون = لون
    نهاية
نهاية

صنف دائرة_ملونة يرث شكل_ملون
    باني(نصف_قطر، لون)
        هذا.نصف_قطر = نصف_قطر
        هذا.لون = لون
    نهاية
    
    دالة مساحة()
        ارجع 3 * هذا.نصف_قطر * هذا.نصف_قطر
    نهاية
نهاية

