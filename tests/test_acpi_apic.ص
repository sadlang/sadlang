# ===================================================================

# استيراد وحدة النظام المنخفض (ACPI/APIC)
من نظام_منخفض استورد *

متغير نجاح = 0
متغير فشل = 0
متغير إجمالي = 0

دالة اختبار(الاسم، النتيجة، المتوقع)
    إجمالي = إجمالي + 1
    إذا (النتيجة == المتوقع)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم + " (متوقع: " + المتوقع + "، حصلنا: " + النتيجة + ")")
    نهاية
نهاية

دالة اختبار_نطاق(الاسم، النتيجة، حد_أدنى، حد_أعلى)
    إجمالي = إجمالي + 1
    إذا (النتيجة >= حد_أدنى && النتيجة <= حد_أعلى)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم + " = " + النتيجة)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم + " (القيمة: " + النتيجة + " خارج النطاق " + حد_أدنى + "-" + حد_أعلى + ")")
    نهاية
نهاية

دالة اختبار_ليس_فارغ(الاسم، النتيجة)
    إجمالي = إجمالي + 1
    إذا (النتيجة != "" && النتيجة != 0)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم + " (القيمة فارغة)")
    نهاية
نهاية

دالة اختبار_منطقي(الاسم، النتيجة)
    إجمالي = إجمالي + 1
    إذا (النتيجة == 0 || النتيجة == 1)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم + " = " + النتيجة)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم + " (متوقع 0 أو 1، حصلنا: " + النتيجة + ")")
    نهاية
نهاية

