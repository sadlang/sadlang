# اختبارات وحدة الاتصال التسلسلي — UART / COM1-COM4
# Serial/UART Module Tests
# 30 اختبار
# ═══════════════════════════════════════════════════════════════

من تسلسلي استورد *

متغير نجاح = 0
متغير فشل = 0

دالة تحقق(الاسم، الشرط)
    إذا (الشرط)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم)
    نهاية
نهاية

اطبع_سطر("=== اختبارات وحدة الاتصال التسلسلي (Serial/UART) ===")
اطبع_سطر("")

# ═══ اكتشاف وتهيئة ═══

# 1. مسح المنافذ
متغير عدد_مسح = serial_scan()
تحقق("مسح المنافذ يعيد عدد > 0", عدد_مسح > 0)

# 2. عدد المنافذ
متغير عدد = serial_port_count()
تحقق("عدد المنافذ = 2", عدد == 2)

# 3. المنفذ 0 موجود (COM1)
متغير موجود = serial_port_exists(0)
تحقق("COM1 موجود", موجود == 1)

# 4. المنفذ 2 غير موجود (COM3)
متغير غير_موجود = serial_port_exists(2)
تحقق("COM3 غير موجود", غير_موجود == 0)

# 5. عنوان COM1
متغير عنوان = serial_port_addr(0)
تحقق("عنوان COM1 = 0x3F8 (1016)", عنوان == 1016)

# 6. تهيئة COM1
متغير تهيئة = serial_init(0, 9600)
تحقق("تهيئة COM1 بمعدل 9600 ناجحة", تهيئة == 0)

# 7. هل المنفذ مفتوح
متغير مفتوح = serial_is_open(0)
تحقق("COM1 مفتوح بعد التهيئة", مفتوح == 1)

# 8. تقرير المنافذ
متغير تقرير = serial_report()
تحقق("تقرير المنافذ ليس فارغ", تقرير != "")

# ═══ إرسال ═══

# 9. إرسال بايت
متغير ارسال_ب = serial_send_byte(0, 65)
تحقق("إرسال بايت (A=65) ناجح", ارسال_ب == 0)

# 10. إرسال نص
متغير ارسال_ن = serial_send_string(0, "Hello")
تحقق("إرسال نص Hello ناجح", ارسال_ن == 0)

# 11. إرسال ست عشري
متغير ارسال_ه = serial_send_hex(0, "4142")
تحقق("إرسال ست عشري 4142 ناجح", ارسال_ه == 0)

# 12. جاهز للإرسال
متغير جاهز_ارسال = serial_tx_ready(0)
تحقق("COM1 جاهز للإرسال", جاهز_ارسال == 1)

# ═══ استقبال ═══

# 13. بيانات متاحة (بعد الإرسال مع loopback)
متغير متاح = serial_available(0)
تحقق("بيانات متاحة بعد الإرسال >= 0", متاح >= 0)

# 14. جاهز للاستقبال
متغير جاهز_استقبال = serial_rx_ready(0)
تحقق("فحص جاهزية الاستقبال يعمل", جاهز_استقبال == 0 || جاهز_استقبال == 1)

# 15. استقبال بايت
متغير استقبال_ب = serial_receive_byte(0)
تحقق("استقبال بايت يعمل", استقبال_ب >= -1)

# 16. استقبال نص
متغير استقبال_ن = serial_receive_string(0, 10)
تحقق("استقبال نص يعمل (قد يكون فارغ)", استقبال_ن != "خطأ" || استقبال_ن == "خطأ")

# ═══ تهيئة ═══

# 17. تعيين معدل البود
متغير بود = serial_set_baud(0, 115200)
تحقق("تعيين معدل البود 115200 ناجح", بود == 0)

# 18. قراءة معدل البود
متغير قراءة_بود = serial_get_baud(0)
تحقق("معدل البود = 115200", قراءة_بود == 115200)

# 19. تعيين بتات البيانات
متغير بتات = serial_set_data_bits(0, 8)
تحقق("تعيين بتات البيانات 8 ناجح", بتات == 0)

# 20. تعيين بتات التوقف
متغير ر_توقف = serial_set_stop_bits(0, 1)
تحقق("تعيين بتات التوقف 1 ناجح", ر_توقف == 0)

# 21. تعيين التكافؤ
متغير تكافؤ = serial_set_parity(0, 0)
تحقق("تعيين التكافؤ (بلا) ناجح", تكافؤ == 0)

# 22. التحكم بالتدفق
متغير تدفق = serial_set_flow(0, 0)
تحقق("تعطيل التحكم بالتدفق ناجح", تدفق == 0)

# ═══ حالة ═══

# 23. حالة الخط
متغير خط = serial_line_status(0)
تحقق("حالة الخط >= 0", خط >= 0)

# 24. حالة المودم
متغير مودم = serial_modem_status(0)
تحقق("حالة المودم >= 0", مودم >= 0)

# 25. عداد الإرسال
متغير عداد_tx = serial_tx_count(0)
تحقق("عداد الإرسال >= 0", عداد_tx >= 0)

# 26. عداد الاستقبال
متغير عداد_rx = serial_rx_count(0)
تحقق("عداد الاستقبال >= 0", عداد_rx >= 0)

# 27. حالة المنفذ
متغير حالة_م = serial_port_state(0)
تحقق("حالة المنفذ = مفتوح (1)", حالة_م == 1)

# ═══ وظائف خاصة ═══

# 28. اختبار حلقي
متغير حلقي = serial_loopback(0)
تحقق("اختبار حلقي ناجح", حلقي == 0)

# 29. مسح المخزن المؤقت
متغير مسح_م = serial_clear(0)
تحقق("مسح المخزن المؤقت ناجح", مسح_م == 0)

# 30. إغلاق المنفذ
متغير اغلاق = serial_close(0)
تحقق("إغلاق COM1 ناجح", اغلاق == 0)

اطبع_سطر("")
اطبع_سطر("=== النتيجة: " + نجاح + " نجاح، " + فشل + " فشل من 30 ===")
