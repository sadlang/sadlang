# ===================================================================
# اختبار التسجيل الكسول — Lazy Loading Verification Test
# ===================================================================
# يتحقق ان دوال النواة متاحة دائما وان الوحدات الكسولة تعمل بعد الاستيراد
# ===================================================================

متغير نجاح = 0
متغير فشل = 0
متغير إجمالي = 0

دالة اختبار(الاسم، النتيجة، المتوقع)
    إجمالي = إجمالي + 1
    إذا (النتيجة == المتوقع)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم + " | توقعنا: " + المتوقع + " | حصلنا: " + النتيجة)
    نهاية
نهاية

دالة اختبار_شرط(الاسم، الشرط)
    إجمالي = إجمالي + 1
    إذا (الشرط)
        نجاح = نجاح + 1
        اطبع_سطر("✓ " + الاسم)
    وإلا
        فشل = فشل + 1
        اطبع_سطر("✗ " + الاسم)
    نهاية
نهاية

# ===================================================================
# القسم 1: دوال النواة متاحة بدون استيراد
# ===================================================================
اطبع_سطر("=== القسم 1: دوال النواة (متاحة دائما) ===")

اختبار("1.1 اطبع_سطر متاحة", 1, 1)

متغير س = نص(42)
اختبار("1.2 نص() متاحة", س, "42")

متغير ج = جذر(16)
اختبار("1.3 جذر() متاحة", ج, 4)

متغير م = [1, 2, 3]
اختبار("1.4 طول() متاحة", طول(م), 3)

متغير ع = مطلق(-5)
اختبار("1.5 مطلق() متاحة", ع, 5)

اطبع_سطر("")

# ===================================================================
# القسم 2: استيراد وحدة نظام_منخفض ثم اختبار ACPI + GPU
# ===================================================================
اطبع_سطر("=== القسم 2: بعد استيراد نظام_منخفض ===")

