## يمثل نقطة في الفضاء ثنائي الأبعاد
##
## يدعم العمليات الأساسية على النقاط مثل المسافة والمساواة.
## كل نقطة لها إحداثيان: س (أفقي) و ص (رأسي).
##
## ```ص
## متغير ن = نقطة(3، 4)
## اطبع_سطر(ن.المسافة_من_الأصل())
## ```
##
## @منذ 1.0.0
صنف نقطة
    متغير عام س
    متغير عام ص

    باني(س_جديدة، ص_جديدة)
        هذا.س = س_جديدة
        هذا.ص = ص_جديدة
    نهاية

    ## تحسب المسافة الإقليدية من نقطة الأصل (0، 0)
    ##
    ## @أرجع المسافة كرقم عشري غير سالب
    دالة المسافة_من_الأصل()
        ارجع (هذا.س * هذا.س + هذا.ص * هذا.ص)
    نهاية
نهاية

