      اطبع_سطر("غير معروف")
نهاية

# === الصنف ===
صنف حيوان
   نص الاسم
   باني(نص اسم)
      الاسم = اسم
   نهاية
   
   دالة تحدث()
      ارجع الاسم + " يتحدث"
   نهاية
نهاية

متغير ق = جديد حيوان("قط")
اطبع_سطر(ق.تحدث())

