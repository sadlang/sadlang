# 1.1 هل الشاشة مهيأ — يجب أن تكون 0 (غير مهيأة)
متغير مهيا = fb_is_initialized()
اختبار("1.1"، "هل الشاشة مهيأة (متوقع: 0/لا)"، مهيا == 0)

# 1.2 تهيئة يدوية — قد تنجح أو تفشل
متغير نتيجة_يدوي = شاشة_تهيئة_يدوي(0، 1024، 768، 4096، 32)
