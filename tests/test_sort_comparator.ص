# اختبار الترتيب مع دالة مقارنة مخصصة

# اختبار 1: ترتيب تصاعدي (افتراضي)
متغير أرقام = [5، 3، 8، 1، 9، 2]
متغير نتيجة = ترتيب(أرقام)
اطبع("اختبار 1 - تصاعدي: " + نتيجة)

# اختبار 2: ترتيب تنازلي
متغير نتيجة2 = ترتيب(أرقام، "تنازلي")
اطبع("اختبار 2 - تنازلي: " + نتيجة2)

# اختبار 3: ترتيب بدالة مقارنة مخصصة (تنازلي عبر الدالة)
دالة مقارنة_تنازلي(أ، ب)
    إذا (أ > ب)
        ارجع -1
    نهاية
    إذا (أ < ب)
        ارجع 1
    نهاية
    ارجع 0
نهاية

متغير نتيجة3 = ترتيب(أرقام، "مقارنة_تنازلي")
اطبع("اختبار 3 - مقارنة مخصصة: " + نتيجة3)

# اختبار 4: ترتيب نصوص
متغير أسماء = ["خالد"، "أحمد"، "زيد"، "باسم"]
متغير نتيجة4 = ترتيب(أسماء)
اطبع("اختبار 4 - نصوص: " + نتيجة4)

# اختبار 5: ترتيب بدالة مقارنة لامدا (حسب القيمة المطلقة)
دالة مقارنة_مطلقة(أ، ب)
    متغير قأ = أ
    متغير قب = ب
    إذا (قأ < 0)
        قأ = قأ * -1
    نهاية
    إذا (قب < 0)
        قب = قب * -1
    نهاية
    إذا (قأ < قب)
        ارجع -1
    نهاية
    إذا (قأ > قب)
        ارجع 1
    نهاية
    ارجع 0
نهاية

متغير أرقام2 = [3، -1، 4، -5، 2]
متغير نتيجة5 = ترتيب(أرقام2، "مقارنة_مطلقة")
اطبع("اختبار 5 - ترتيب بالقيمة المطلقة: " + نتيجة5)
