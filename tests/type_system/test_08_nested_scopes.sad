# اختبار 08: متغيرات ثابتة ونطاقات متداخلة
# يختبر النطاقات المتداخلة وإعادة استخدام الأسماء

دالة رئيسية()
    رقم س = 10
    
    إذا (س > 5)
        # نطاق داخلي - يمكنه رؤية المتغيرات الخارجية
        رقم ص = س + 5
        اطبع_سطر("ص = ")
    نهاية
    
    # س ما زال مرئياً هنا
    رقم ز = س * 2
    
    بينما (ز > 0)
        ز = ز - 5
    نهاية
    
    اطبع_سطر("تم اختبار النطاقات المتداخلة بنجاح ✓")
نهاية
