# اختبار 06: أنواع القيم المرجعة
# يختبر فحص أنواع القيم المرجعة من الدوال

دالة جمع(رقم أ, رقم ب) -> رقم
    ارجع أ + ب
نهاية

دالة تحية(نص اسم) -> نص
    ارجع "مرحباً " + اسم
نهاية

دالة رئيسية()
    رقم نتيجة = جمع(5, 3)
    نص رسالة = تحية("عالم")
    
    اطبع_سطر("النتيجة: ")
    اطبع_سطر(رسالة)
    اطبع_سطر("تم اختبار أنواع القيم المرجعة بنجاح ✓")
نهاية
