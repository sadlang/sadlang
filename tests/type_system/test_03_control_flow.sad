# اختبار الشروط والحلقات
# Conditions and loops type test

دالة رئيسية()
    رقم عدد = 10
    رقم مجموع = 0
    
    # حلقة بينما
    رقم ع = 0
    بينما (ع < عدد)
        مجموع = مجموع + ع
        ع = ع + 1
    نهاية
    
    # شرط
    إذا (مجموع > 40)
        اطبع_سطر("المجموع أكبر من 40")
    وإلا
        اطبع_سطر("المجموع أصغر أو يساوي 40")
    نهاية
    
    اطبع_سطر("تم اختبار الشروط والحلقات بنجاح ✓")
نهاية
