# اختبار 05: الوضع الصارم
# يختبر أن الشروط يجب أن تكون منطقية في الوضع الصارم

دالة رئيسية()
    رقم س = 10
    
    # في الوضع الصارم، الشرط يجب أن يكون منطقي
    إذا (س > 5)
        اطبع_سطر("س أكبر من 5")
    نهاية
    
    # هذا يجب أن ينتج تحذير/خطأ في الوضع الصارم
    # لأن الشرط رقم وليس منطقي
    بينما (س > 0)
        س = س - 1
    نهاية
    
    اطبع_سطر("تم اختبار الوضع الصارم بنجاح ✓")
