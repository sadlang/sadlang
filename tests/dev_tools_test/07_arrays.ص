# مثال 7: المصفوفات
# تجربة عمليات المصفوفات في لغة ص

دالة رئيسية()
    اطبع_سطر("=== عمليات المصفوفات ===")
    
    # إنشاء مصفوفة
    متغير أعداد = [5، 2، 8، 1، 9، 3، 7، 4، 6]
    
    # حجم المصفوفة
    اطبع("الحجم: ")
    اطبع_سطر(حجم_مصفوفة(أعداد))
    
    # أول وآخر عنصر
    اطبع("أول عنصر: ")
    اطبع_سطر(أول(أعداد))
    اطبع("آخر عنصر: ")
    اطبع_سطر(آخر(أعداد))
    
    # الفرز
    متغير مرتبة = فرز(أعداد)
    اطبع("بعد الفرز: ")
    اطبع_سطر(مرتبة)
    
    # العكس
    متغير معكوسة = قلب([1، 2، 3، 4، 5])
    اطبع("معكوسة: ")
    اطبع_سطر(معكوسة)
    
    # البحث
    متغير درجات = [90، 85، 70، 95، 60]
    اطبع("فهرس 95: ")
    اطبع_سطر(فهرس(درجات، 95))
    
    اطبع("هل يحتوي على 85: ")
    اطبع_سطر(يحتوي_عنصر(درجات، 85))
    
    اطبع_سطر("✅ اختبار المصفوفات نجح!")
نهاية
