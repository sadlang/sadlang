دالة مرحبا(الاسم)
    اطبع_سطر("مرحباً يا " + الاسم + "! 👋")
نهاية

دالة جمع(أ، ب)
    ارجع أ + ب
نهاية

دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

دالة فيبوناتشي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

دالة رئيسية()
    # استدعاء الدوال
    مرحبا("أحمد")
    مرحبا("سارة")
    
    # الجمع
    متغير نتيجة = جمع(15، 25)
    اطبع_سطر("15 + 25 = " + نتيجة)
    
    # المضروب
    اطبع_سطر("!5 = " + مضروب(5))
    اطبع_سطر("!10 = " + مضروب(10))
    
    # فيبوناتشي
    اطبع_سطر("فيبوناتشي(10) = " + فيبوناتشي(10))
    
    اطبع_سطر("✅ اختبار الدوال نجح!")
نهاية
