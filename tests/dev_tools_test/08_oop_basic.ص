# مثال 8: البرمجة كائنية التوجه - الأساسيات
# صنف حساب بنكي بسيط

صنف حساب_بنكي
    نص صاحب_الحساب
    رقم الرصيد
    
    باني(نص اسم، رقم رصيد_ابتدائي)
        صاحب_الحساب = اسم
        الرصيد = رصيد_ابتدائي
    نهاية
    
    دالة ايداع(رقم مبلغ)
        الرصيد = الرصيد + مبلغ
        اطبع("تم إيداع ")
        اطبع(مبلغ)
        اطبع_سطر(" ريال")
    نهاية
    
    دالة سحب(رقم مبلغ)
        إذا (مبلغ <= الرصيد)
            الرصيد = الرصيد - مبلغ
            اطبع("تم سحب ")
            اطبع(مبلغ)
            اطبع_سطر(" ريال")
        وإلا
            اطبع_سطر("رصيد غير كافي!")
        نهاية
    نهاية
    
    دالة رقم الرصيد_الحالي()
        ارجع الرصيد
    نهاية
    
    دالة عرض()
        اطبع("الحساب: ")
        اطبع(صاحب_الحساب)
        اطبع(" | الرصيد: ")
        اطبع(الرصيد)
        اطبع_سطر(" ريال")
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== الحساب البنكي ===")
    
    # إنشاء حساب
    متغير حسابي = جديد حساب_بنكي("أحمد"، 5000)
    حسابي.عرض()
    
    # إيداع
    حسابي.ايداع(2000)
    حسابي.عرض()
    
    # سحب
    حسابي.سحب(1500)
    حسابي.عرض()
    
    # محاولة سحب أكثر من الرصيد
    حسابي.سحب(10000)
    
    # التحقق من الرصيد
    متغير ر = حسابي.الرصيد_الحالي()
    اطبع("الرصيد النهائي: ")
    اطبع(ر)
    اطبع_سطر(" ريال")
    
    اطبع_سطر("✅ اختبار OOP نجح!")
نهاية
