# اختبار خصائص الصنف (Properties)

صنف شخص
    عام نص _اسم = "مجهول"
    عام رقم _عمر = 0

    باني(اسم، عمر)
        هذا._اسم = اسم
        هذا._عمر = عمر
    نهاية

    عام خاصية نص الاسم
        احصل
            ارجع هذا._اسم
        نهاية
        عيّن(قيمة)
            هذا._اسم = قيمة
        نهاية
    نهاية

    عام خاصية رقم العمر
        احصل
            ارجع هذا._عمر
        نهاية
        عيّن(قيمة)
            إذا (قيمة < 0)
                هذا._عمر = 0
            وإلا
                هذا._عمر = قيمة
            نهاية
        نهاية
    نهاية
نهاية

متغير أحمد = جديد شخص("أحمد"، 25)
اطبع_سطر("الاسم: " + أحمد.الاسم)
اطبع_سطر("العمر: " + أحمد.العمر)

# تعيين عبر setter
أحمد.الاسم = "محمد"
أحمد.العمر = 30
اطبع_سطر("الاسم بعد التعيين: " + أحمد.الاسم)
اطبع_سطر("العمر بعد التعيين: " + أحمد.العمر)

# اختبار القيم السالبة
أحمد.العمر = -5
اطبع_سطر("العمر بعد -5: " + أحمد.العمر)

اطبع_سطر("=== اختبار الخصائص نجح ===")
