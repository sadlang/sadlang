## اختبار: constructor يستدعي جديد مرتين، ثم thin wrapper

صنف داخلي
    رقم ق

    باني(رقم قيمة)
        هذا.ق = قيمة
    نهاية
نهاية

صنف محرك_م
    متغير شجرة_م

    باني(شجرة_ع)
        هذا.شجرة_م = شجرة_ع
    نهاية
نهاية

دالة وظيفة_مستقلة(شجرة، نص ن)
    ارجع "نتيجة_" + شجرة.ق + "_" + ن
نهاية

صنف تعبير_م
    نص النمط_م
    متغير المحرك_أ
    رقم العدد_م

    باني(نص نمط، رقم أعلام)
        هذا.النمط_م = نمط
        هذا.العدد_م = أعلام
        ## يستدعي جديد مرتين
        متغير أ = جديد داخلي(10)
        متغير ب = جديد محرك_م(أ)
        هذا.المحرك_أ = ب
    نهاية

    ## thin wrapper
    دالة ابحث(نص ن)
        ارجع وظيفة_مستقلة(هذا.المحرك_أ.شجرة_م، ن)
    نهاية
نهاية

## الدالة المستقلة على مستوى الوحدة
دالة بحث_م(نص نمط، نص النص)
    متغير تع = جديد تعبير_م(نمط، 0)
    ارجع تع.ابحث(النص)
نهاية

متغير ن = بحث_م("نمط", "نص")
اطبع("ن = ")
اطبع_سطر(ن)
