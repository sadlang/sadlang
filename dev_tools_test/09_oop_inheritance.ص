# مثال 9: الوراثة وتعدد الأشكال
# نظام أشكال هندسية مع الوراثة

صنف شكل
    نص الاسم
    
    باني(نص اسم)
        الاسم = اسم
    نهاية
    
    دالة عرض()
        اطبع("الشكل: ")
        اطبع_سطر(الاسم)
    نهاية
نهاية

صنف مستطيل يرث شكل
    رقم الطول
    رقم العرض
    
    باني(رقم طول، رقم عرض)
        أساس("مستطيل")
        الطول = طول
        العرض = عرض
    نهاية
    
    دالة رقم المساحة()
        ارجع الطول * العرض
    نهاية
    
    دالة رقم المحيط()
        ارجع 2 * (الطول + العرض)
    نهاية
    
    دالة عرض()
        اطبع("مستطيل: ")
        اطبع(الطول)
        اطبع(" × ")
        اطبع(العرض)
        اطبع(" | المساحة = ")
        اطبع(الطول * العرض)
        اطبع(" | المحيط = ")
        اطبع_سطر(2 * (الطول + العرض))
    نهاية
نهاية

صنف دائرة يرث شكل
    رقم نصف_القطر
    
    باني(رقم نق)
        أساس("دائرة")
        نصف_القطر = نق
    نهاية
    
    دالة رقم المساحة()
        ارجع 3 * نصف_القطر * نصف_القطر
    نهاية
    
    دالة عرض()
        اطبع("دائرة: نصف القطر = ")
        اطبع(نصف_القطر)
        اطبع(" | المساحة ≈ ")
        اطبع_سطر(3 * نصف_القطر * نصف_القطر)
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== الأشكال الهندسية ===")
    
    # إنشاء أشكال
    متغير م = جديد مستطيل(10، 5)
    متغير د = جديد دائرة(7)
    
    # عرض كل شكل
    م.عرض()
    د.عرض()
    
    # حساب المساحات
    متغير مساحة_م = م.المساحة()
    متغير مساحة_د = د.المساحة()
    
    اطبع_سطر("---")
    اطبع("مساحة المستطيل: ")
    اطبع_سطر(مساحة_م)
    اطبع("مساحة الدائرة: ")
    اطبع_سطر(مساحة_د)
    
    اطبع_سطر("✅ اختبار الوراثة نجح!")
نهاية
