# مثال 10: OOP متقدم - الأعضاء الساكنة وتعدد الأشكال
# نظام إدارة الموظفين

صنف موظف
    نص الاسم
    رقم الراتب
    ساكن رقم عدد_الموظفين
    
    باني(نص اسم، رقم راتب)
        الاسم = اسم
        الراتب = راتب
        عدد_الموظفين = عدد_الموظفين + 1
    نهاية
    
    دالة عرض()
        اطبع("موظف: ")
        اطبع(الاسم)
        اطبع(" | الراتب: ")
        اطبع(الراتب)
        اطبع_سطر(" ريال")
    نهاية
    
    دالة رقم الراتب_الشهري()
        ارجع الراتب
    نهاية
    
    ساكن دالة رقم كم_موظف()
        ارجع عدد_الموظفين
    نهاية
نهاية

صنف مدير يرث موظف
    رقم البدل
    
    باني(نص اسم، رقم راتب، رقم بدل)
        أساس(اسم، راتب)
        البدل = بدل
    نهاية
    
    دالة عرض()
        اطبع("مدير: ")
        اطبع(الاسم)
        اطبع(" | الراتب: ")
        اطبع(الراتب)
        اطبع(" | البدل: ")
        اطبع(البدل)
        اطبع_سطر(" ريال")
    نهاية
    
    دالة رقم الراتب_الشهري()
        ارجع الراتب + البدل
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== نظام الموظفين ===")
    
    # إنشاء موظفين
    متغير م1 = جديد موظف("أحمد"، 8000)
    متغير م2 = جديد موظف("سارة"، 9000)
    متغير م3 = جديد مدير("خالد"، 12000، 5000)
    
    # عرض المعلومات
    م1.عرض()
    م2.عرض()
    م3.عرض()
    
    اطبع_سطر("---")
    
    # الراتب الشهري (تعدد الأشكال)
    اطبع("راتب أحمد: ")
    اطبع_سطر(م1.الراتب_الشهري())
    
    اطبع("راتب خالد (مع البدل): ")
    اطبع_سطر(م3.الراتب_الشهري())
    
    # العضو الساكن
    اطبع("عدد الموظفين: ")
    اطبع_سطر(موظف.كم_موظف())
    
    اطبع_سطر("✅ اختبار OOP المتقدم نجح!")
نهاية
