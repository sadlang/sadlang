# مثال 12: نظام الملكية (مثل Rust)
# يتطلب تشغيل بعلم --ownership

دالة رئيسية()
    اطبع_سطر("=== نظام الملكية ===")
    
    # 1. النسخ التلقائي للأرقام (أنواع النسخ)
    رقم أصلي = 42
    رقم نسخة = أصلي
    اطبع("الأصلي: ")
    اطبع_سطر(أصلي)
    اطبع("النسخة: ")
    اطبع_سطر(نسخة)
    اطبع_سطر("الأرقام تُنسخ تلقائياً ✅")
    
    اطبع_سطر("---")
    
    # 2. نقل الملكية للنصوص (أنواع النقل)
    نص رسالة = "مرحباً"
    اطبع("الرسالة الأصلية: ")
    اطبع_سطر(رسالة)
    
    متغير منقولة = رسالة
    اطبع("بعد النقل: ")
    اطبع_سطر(منقولة)
    اطبع_سطر("تم نقل ملكية النص ✅")
    
    اطبع_سطر("---")
    
    # 3. الاستعارة المشتركة (القراءة فقط)
    نص مستند = "دستور لغة ص"
    متغير قارئ1 = &مستند
    متغير قارئ2 = &مستند
    اطبع("القارئ 1: ")
    اطبع_سطر(قارئ1)
    اطبع("القارئ 2: ")
    اطبع_سطر(قارئ2)
    اطبع("المستند الأصلي: ")
    اطبع_سطر(مستند)
    اطبع_سطر("الاستعارة المشتركة تعمل ✅")
    
    اطبع_سطر("✅ اختبار الملكية نجح!")
نهاية
