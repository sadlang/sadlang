# ===========================================
# المثال 03 - الشروط
# Example 03 - Conditionals
# ===========================================

دالة رئيسية()
    متغير درجة = 85
    
    إذا (درجة >= 90)
        اطبع_سطر("ممتاز! 🌟")
    وإلا
        اطبع_سطر("جيد جداً! 👍")
    نهاية
    
    # اختبار المقارنات
    متغير س = 10
    متغير ص = 20
    
    إذا (س < ص)
        اطبع_سطر("✅ " + س + " أصغر من " + ص)
    نهاية
    
    إذا (ص > س)
        اطبع_سطر("✅ " + ص + " أكبر من " + س)
    نهاية
    
    إذا (س == 10)
        اطبع_سطر("✅ المساواة تعمل!")
    نهاية
    
    إذا (س != ص)
        اطبع_سطر("✅ عدم المساواة تعمل!")
    نهاية
    
    اطبع_سطر("✅ اختبار الشروط نجح!")
نهاية
