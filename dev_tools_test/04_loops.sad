# ===========================================
# المثال 04 - الحلقات
# Example 04 - Loops
# ===========================================

دالة رئيسية()
    # حلقة بينما - العد من 1 إلى 5
    اطبع_سطر("العد من 1 إلى 5:")
    متغير ع = 1
    بينما (ع <= 5)
        اطبع("  " + ع)
        ع = ع + 1
    نهاية
    اطبع_سطر("")
    
    # حساب مجموع الأرقام من 1 إلى 100
    متغير مجموع = 0
    متغير ن = 1
    بينما (ن <= 100)
        مجموع = مجموع + ن
        ن = ن + 1
    نهاية
    اطبع_سطر("مجموع 1 إلى 100 = " + مجموع)
    
    # جدول الضرب لـ 7
    اطبع_سطر("جدول ضرب 7:")
    متغير ت = 1
    بينما (ت <= 10)
        اطبع_سطر("  7 × " + ت + " = " + (7 * ت))
        ت = ت + 1
    نهاية
    
    اطبع_سطر("✅ اختبار الحلقات نجح!")
نهاية
