# ═══ الوقت الحالي ═══

صدّر دالة الآن()
    # (AR) يجلب الوقت الحالي كطابع زمني
    ارجع timestamp()
نهاية

صدّر دالة التاريخ()
    # (AR) يجلب التاريخ الحالي كنص
    ارجع date_string()
نهاية

صدّر دالة الوقت()
    # (AR) يجلب الوقت الحالي كنص
    ارجع time_string()
نهاية

# ═══ أجزاء التاريخ ═══

صدّر دالة السنة()
    # (AR) يجلب السنة الحالية
    ارجع year()
نهاية

صدّر دالة الشهر()
    # (AR) يجلب الشهر الحالي (1-12)
    ارجع month()
نهاية

صدّر دالة اليوم()
    # (AR) يجلب يوم الشهر (1-31)
    ارجع day()
نهاية

صدّر دالة يوم_الأسبوع()
    # (AR) يجلب يوم الأسبوع (0-6)
    ارجع weekday()
نهاية

صدّر دالة الساعة()
    # (AR) يجلب الساعة الحالية (0-23)
    ارجع hour()
نهاية

صدّر دالة الدقيقة()
    # (AR) يجلب الدقيقة الحالية (0-59)
    ارجع minute()
نهاية

صدّر دالة الثانية()
    # (AR) يجلب الثانية الحالية (0-59)
    ارجع second()
نهاية

صدّر دالة المللي_ثانية()
    # (AR) يجلب المللي ثانية الحالية (0-999)
    ارجع millisecond()
نهاية

# ═══ التحويل ═══

صدّر دالة من_طابع_زمني(طابع)
    # (AR) يحول طابع زمني إلى كائن تاريخ
    ارجع from_timestamp(طابع)
نهاية

صدّر دالة لطابع_زمني(تاريخ)
    # (AR) يحول تاريخ إلى طابع زمني
    ارجع to_timestamp(تاريخ)
نهاية

صدّر دالة تنسيق_تاريخ(طابع، تنسيق)
    # (AR) ينسق التاريخ حسب قالب
    ارجع format_date(طابع، تنسيق)
نهاية

صدّر دالة تحليل_تاريخ(نص، تنسيق)
    # (AR) يحلل نص تاريخ حسب قالب
    ارجع parse_date(نص، تنسيق)
نهاية

# ═══ الحسابات ═══

صدّر دالة أضف_أيام(تاريخ، أيام)
    # (AR) يضيف أياماً للتاريخ
    ارجع add_days(تاريخ، أيام)
نهاية

صدّر دالة أضف_ساعات(تاريخ، ساعات)
    # (AR) يضيف ساعات للتاريخ
    ارجع add_hours(تاريخ، ساعات)
نهاية

صدّر دالة فرق_الوقت(تاريخ1، تاريخ2)
    # (AR) يحسب الفرق بين تاريخين بالثواني
    ارجع time_diff(تاريخ1، تاريخ2)
نهاية

# ═══ التأخير ═══

صدّر دالة انتظر(مللي_ثانية)
    # (AR) يوقف التنفيذ لفترة
    ارجع sleep(مللي_ثانية)
نهاية

# ═══ القياس ═══

صدّر دالة قياس_وقت()
    # (AR) يبدأ قياس الوقت
    ارجع performance_now()
نهاية
