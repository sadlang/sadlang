/**
 * (AR) عناوين UART على STM32F4
 */
#[cfg(target_arch = "arm")]
وحدة عناوين_stm32f4 {
    ثابت عام USART1: ص_مؤشر = 0x4001_1000؛
    ثابت عام USART2: ص_مؤشر = 0x4000_4400؛
    ثابت عام USART3: ص_مؤشر = 0x4000_4800؛
    ثابت عام UART4: ص_مؤشر = 0x4000_4C00؛
    ثابت عام UART5: ص_مؤشر = 0x4000_5000؛
    ثابت عام USART6: ص_مؤشر = 0x4001_1400؛
    
    // (AR) إزاحات سجلات STM32
    ثابت عام إزاحة_SR: ص_مؤشر = 0x00؛    // (AR) Status register
    ثابت عام إزاحة_DR: ص_مؤشر = 0x04؛    // (AR) Data register
    ثابت عام إزاحة_BRR: ص_مؤشر = 0x08؛   // (AR) Baud rate register
    ثابت عام إزاحة_CR1: ص_مؤشر = 0x0C؛   // (AR) Control register 1
    ثابت عام إزاحة_CR2: ص_مؤشر = 0x10؛   // (AR) Control register 2
    ثابت عام إزاحة_CR3: ص_مؤشر = 0x14؛   // (AR) Control register 3
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) إعدادات الاتصال
//                    (EN) Communication Settings
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) معدل الباود
 */
تعداد معدل_باود {
    باود_1200 = 1200،
    باود_2400 = 2400،
    باود_4800 = 4800،
    باود_9600 = 9600،
    باود_19200 = 19200،
    باود_38400 = 38400،
    باود_57600 = 57600،
    باود_115200 = 115200،
    باود_230400 = 230400،
    باود_460800 = 460800،
    باود_921600 = 921600،
}

/**
 * (AR) عدد بتات البيانات
 */
تعداد بتات_بيانات {
    خمسة = 5،
    ستة = 6،
    سبعة = 7،
    ثمانية = 8،
}

/**
 * (AR) نوع التكافؤ (Parity)
 */
تعداد تكافؤ {
    لا_شيء،     // (AR) بدون تكافؤ
    زوجي،       // (AR) تكافؤ زوجي (Even)
    فردي،       // (AR) تكافؤ فردي (Odd)
    علامة،      // (AR) دائماً 1 (Mark)
    فراغ،       // (AR) دائماً 0 (Space)
}

/**
 * (AR) بتات التوقف
 */
تعداد بتات_توقف {
    واحد = 1،
    واحد_ونصف = 15،  // (AR) 1.5 * 10
    اثنان = 2،
}

/**
 * (AR) تحكم التدفق
 */
تعداد تحكم_تدفق {
    لا_شيء،         // (AR) بدون تحكم
    برمجي،         // (AR) XON/XOFF
    عتادي،         // (AR) RTS/CTS
}

/**
 * (AR) إعدادات المنفذ التسلسلي الكاملة
 */
هيكل إعدادات_تسلسلي {
    باود: معدل_باود،
    بيانات: بتات_بيانات،
    تكافؤ: تكافؤ،
    توقف: بتات_توقف،
    تدفق: تحكم_تدفق،
}

تطبيق إعدادات_تسلسلي {
    /**
     * (AR) إعدادات افتراضية: 115200 8N1
     */
    دالة عامة افتراضي() -> ذاتي {
        إعدادات_تسلسلي {
            باود: معدل_باود::باود_115200،
            بيانات: بتات_بيانات::ثمانية،
            تكافؤ: تكافؤ::لا_شيء،
            توقف: بتات_توقف::واحد،
            تدفق: تحكم_تدفق::لا_شيء،
        }
    }
    
    /**
     * (AR) إعدادات بطيئة: 9600 8N1
     */
    دالة عامة بطيء() -> ذاتي {
        إعدادات_تسلسلي {
            باود: معدل_باود::باود_9600،
            ..ذاتي::افتراضي()
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) المنفذ التسلسلي x86
//                    (EN) x86 Serial Port
// ═══════════════════════════════════════════════════════════════════════════════

#[cfg(target_arch = "x86_64")]
هيكل منفذ_تسلسلي_x86 {
    عنوان_قاعدة: ص16،
    مُهيّأ: منطقي،
}

#[cfg(target_arch = "x86_64")]
تطبيق منفذ_تسلسلي_x86 {
    /**
     * (AR) إنشاء منفذ جديد
     */
    دالة عامة جديد(عنوان: ص16) -> ذاتي {
        منفذ_تسلسلي_x86 {
            عنوان_قاعدة: عنوان،
            مُهيّأ: خطأ،
        }
    }
    
    /**
     * (AR) تهيئة المنفذ
     */
    دالة عامة هيّئ(&متغير ذاتي، إعدادات: إعدادات_تسلسلي) -> نتيجة<()، خطأ_تسلسلي> {
        غير_آمن {
            // (AR) تعطيل المقاطعات
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_مقاطعة، 0x00)؛
            
            // (AR) تفعيل DLAB لتعيين معدل الباود
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_تحكم_خط، 0x80)؛
            
            // (AR) تعيين مقسم الباود
            دع مقسم = ذاتي.احسب_مقسم(إعدادات.باود)؛
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_بيانات، (مقسم & 0xFF) كـ ص8)؛
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_مقاطعة، ((مقسم >> 8) & 0xFF) كـ ص8)؛
            
            // (AR) تعيين إعدادات الخط (8N1 افتراضياً)
            دع lcr = ذاتي.احسب_lcr(&إعدادات)؛
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_تحكم_خط، lcr)؛
            
            // (AR) تفعيل FIFO
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_fifo، 0xC7)؛
            
            // (AR) تفعيل المودم (RTS/DTR)
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_تحكم_مودم، 0x0B)؛
            
            // (AR) اختبار الاتصال (Loopback)
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_تحكم_مودم، 0x1E)؛
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_بيانات، 0xAE)؛
            
            إذا ذاتي.اقرأ_سجل(عناوين_x86::إزاحة_بيانات) != 0xAE {
                إرجاع خطأ(خطأ_تسلسلي::فشل_التهيئة)؛
            }
            
            // (AR) إعادة للوضع العادي
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_تحكم_مودم، 0x0F)؛
            
            ذاتي.مُهيّأ = صحيح؛
            موافق(())
        }
    }
    
    /**
     * (AR) إرسال بايت واحد
     */
    دالة عامة أرسل(&ذاتي، بايت: ص8) -> نتيجة<()، خطأ_تسلسلي> {
        إذا !ذاتي.مُهيّأ {
            إرجاع خطأ(خطأ_تسلسلي::غير_مهيأ)؛
        }
        
        غير_آمن {
            // (AR) انتظار جاهزية الإرسال
            بينما (ذاتي.اقرأ_سجل(عناوين_x86::إزاحة_حالة_خط) & 0x20) == 0 {
                // (AR) انتظار
            }
            
            ذاتي.اكتب_سجل(عناوين_x86::إزاحة_بيانات، بايت)؛
            موافق(())
        }
    }
    
    /**
     * (AR) استقبال بايت واحد
     */
    دالة عامة استقبل(&ذاتي) -> نتيجة<ص8، خطأ_تسلسلي> {
        إذا !ذاتي.مُهيّأ {
            إرجاع خطأ(خطأ_تسلسلي::غير_مهيأ)؛
        }
        
        غير_آمن {
            // (AR) انتظار وجود بيانات
            بينما (ذاتي.اقرأ_سجل(عناوين_x86::إزاحة_حالة_خط) & 0x01) == 0 {
                // (AR) انتظار
            }
            
            موافق(ذاتي.اقرأ_سجل(عناوين_x86::إزاحة_بيانات))
        }
    }
    
    /**
     * (AR) استقبال بدون حجب (non-blocking)
     */
    دالة عامة حاول_استقبل(&ذاتي) -> اختيار<ص8> {
        إذا !ذاتي.مُهيّأ {
            إرجاع لا_شيء؛
        }
        
        غير_آمن {
            إذا (ذاتي.اقرأ_سجل(عناوين_x86::إزاحة_حالة_خط) & 0x01) != 0 {
                بعض(ذاتي.اقرأ_سجل(عناوين_x86::إزاحة_بيانات))
            } وإلا {
                لا_شيء
            }
        }
    }
    
    /**
     * (AR) إرسال سلسلة نصية
     */
    دالة عامة اكتب(&ذاتي، نص: &نص) -> نتيجة<()، خطأ_تسلسلي> {
        لكل بايت في نص.كـ_بايتات() {
            ذاتي.أرسل(بايت)؟؛
        }
        موافق(())
    }
    
    /**
     * (AR) إرسال سلسلة نصية مع سطر جديد
     */
    دالة عامة اكتب_سطر(&ذاتي، نص: &نص) -> نتيجة<()، خطأ_تسلسلي> {
        ذاتي.اكتب(نص)؟؛
        ذاتي.أرسل(b'\r')؟؛
        ذاتي.أرسل(b'\n')؟؛
        موافق(())
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // (AR) دوال مساعدة خاصة
    // ─────────────────────────────────────────────────────────────────────────
    
    #[مضمنة(دائماً)]
    دالة خاصة غير_آمنة اكتب_سجل(&ذاتي، إزاحة: ص16، قيمة: ص8) {
        دع منفذ = ذاتي.عنوان_قاعدة + إزاحة؛
        تجميع!(
            "out dx, al"
            :
            : "{dx}"(منفذ)، "{al}"(قيمة)
            :
            : "volatile"
        )؛
    }
    
    #[مضمنة(دائماً)]
    دالة خاصة غير_آمنة اقرأ_سجل(&ذاتي، إزاحة: ص16) -> ص8 {
        دع منفذ = ذاتي.عنوان_قاعدة + إزاحة؛
        دع قيمة: ص8؛
        تجميع!(
            "in al, dx"
            : "={al}"(قيمة)
            : "{dx}"(منفذ)
            :
            : "volatile"
        )؛
        قيمة
    }
    
    دالة خاصة احسب_مقسم(&ذاتي، باود: معدل_باود) -> ص16 {
        // (AR) التردد الأساسي لـ UART هو 115200 * 16 = 1843200 Hz
        ثابت تردد_أساسي: ص32 = 115200؛
        (تردد_أساسي / (باود كـ ص32)) كـ ص16
    }
    
    دالة خاصة احسب_lcr(&ذاتي، إعدادات: &إعدادات_تسلسلي) -> ص8 {
        دع متغير lcr: ص8 = 0؛
        
        // (AR) بتات البيانات
        lcr |= طابق إعدادات.بيانات {
            بتات_بيانات::خمسة => 0x00،
            بتات_بيانات::ستة => 0x01،
            بتات_بيانات::سبعة => 0x02،
            بتات_بيانات::ثمانية => 0x03،
        }؛
        
        // (AR) بتات التوقف
        إذا_دع بتات_توقف::اثنان = إعدادات.توقف {
            lcr |= 0x04؛
        }
        
        // (AR) التكافؤ
        طابق إعدادات.تكافؤ {
            تكافؤ::لا_شيء => {}،
            تكافؤ::فردي => lcr |= 0x08،
            تكافؤ::زوجي => lcr |= 0x18،
            تكافؤ::علامة => lcr |= 0x28،
            تكافؤ::فراغ => lcr |= 0x38،
        }
        
        lcr
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) المنفذ التسلسلي ARM
//                    (EN) ARM Serial Port
// ═══════════════════════════════════════════════════════════════════════════════

#[cfg(target_arch = "arm")]
هيكل منفذ_تسلسلي_arm {
    عنوان_قاعدة: ص_مؤشر،
    مُهيّأ: منطقي،
}

#[cfg(target_arch = "arm")]
تطبيق منفذ_تسلسلي_arm {
    /**
     * (AR) إنشاء منفذ جديد
     */
    دالة عامة جديد(عنوان: ص_مؤشر) -> ذاتي {
        منفذ_تسلسلي_arm {
            عنوان_قاعدة: عنوان،
            مُهيّأ: خطأ،
        }
    }
    
    /**
     * (AR) تهيئة المنفذ (STM32)
     */
    دالة عامة هيّئ(&متغير ذاتي، إعدادات: إعدادات_تسلسلي، تردد_ساعة: ص32) -> نتيجة<()، خطأ_تسلسلي> {
        // (AR) حساب BRR (معدل الباود)
        دع brr = تردد_ساعة / (إعدادات.باود كـ ص32)؛
        
        غير_آمن {
            // (AR) تعيين معدل الباود
            دع سجل_brr = سجل_متطاير::<ص32>::جديد(
                ذاتي.عنوان_قاعدة + عناوين_stm32f4::إزاحة_BRR
            )؛
            سجل_brr.اكتب(brr)؛
            
            // (AR) تكوين CR1 (تفعيل TX, RX)
            دع سجل_cr1 = سجل_متطاير::<ص32>::جديد(
                ذاتي.عنوان_قاعدة + عناوين_stm32f4::إزاحة_CR1
            )؛
            
            دع متغير cr1: ص32 = 0؛
            cr1 |= (1 << 13)؛  // UE - تفعيل USART
            cr1 |= (1 << 3)؛   // TE - تفعيل الإرسال
            cr1 |= (1 << 2)؛   // RE - تفعيل الاستقبال
            
            // (AR) طول الكلمة
            إذا_دع بتات_بيانات::تسعة = إعدادات.بيانات {
                cr1 |= (1 << 12)؛  // M - 9 بت
            }
            
            // (AR) التكافؤ
            طابق إعدادات.تكافؤ {
                تكافؤ::زوجي => {
                    cr1 |= (1 << 10)؛  // PCE - تفعيل التكافؤ
                    // PS = 0 للتكافؤ الزوجي
                }،
                تكافؤ::فردي => {
                    cr1 |= (1 << 10)؛  // PCE
                    cr1 |= (1 << 9)؛   // PS - فردي
                }،
                _ => {}،
            }
            
            سجل_cr1.اكتب(cr1)؛
            
            // (AR) تكوين CR2 (بتات التوقف)
            دع سجل_cr2 = سجل_متطاير::<ص32>::جديد(
                ذاتي.عنوان_قاعدة + عناوين_stm32f4::إزاحة_CR2
            )؛
            
            دع متغير cr2: ص32 = 0؛
            طابق إعدادات.توقف {
                بتات_توقف::واحد => {}،  // 00
                بتات_توقف::واحد_ونصف => cr2 |= (3 << 12)،
                بتات_توقف::اثنان => cr2 |= (2 << 12)،
            }
            
            سجل_cr2.اكتب(cr2)؛
            
            ذاتي.مُهيّأ = صحيح؛
            موافق(())
        }
    }
    
    /**
     * (AR) إرسال بايت
     */
    دالة عامة أرسل(&ذاتي، بايت: ص8) -> نتيجة<()، خطأ_تسلسلي> {
        إذا !ذاتي.مُهيّأ {
            إرجاع خطأ(خطأ_تسلسلي::غير_مهيأ)؛
        }
        
        غير_آمن {
            دع سجل_sr = سجل_متطاير::<ص32>::جديد(
                ذاتي.عنوان_قاعدة + عناوين_stm32f4::إزاحة_SR
            )؛
            دع سجل_dr = سجل_متطاير::<ص32>::جديد(
                ذاتي.عنوان_قاعدة + عناوين_stm32f4::إزاحة_DR
            )؛
            
            // (AR) انتظار TXE (transmit data register empty)
            بينما (سجل_sr.اقرأ() & (1 << 7)) == 0 {
                // انتظار
            }
            
            سجل_dr.اكتب(بايت كـ ص32)؛
            موافق(())
        }
    }
    
    /**
     * (AR) استقبال بايت
     */
    دالة عامة استقبل(&ذاتي) -> نتيجة<ص8، خطأ_تسلسلي> {
        إذا !ذاتي.مُهيّأ {
            إرجاع خطأ(خطأ_تسلسلي::غير_مهيأ)؛
        }
        
        غير_آمن {
            دع سجل_sr = سجل_متطاير::<ص32>::جديد(
                ذاتي.عنوان_قاعدة + عناوين_stm32f4::إزاحة_SR
            )؛
            دع سجل_dr = سجل_متطاير::<ص32>::جديد(
                ذاتي.عنوان_قاعدة + عناوين_stm32f4::إزاحة_DR
            )؛
            
            // (AR) انتظار RXNE (receive data register not empty)
            بينما (سجل_sr.اقرأ() & (1 << 5)) == 0 {
                // انتظار
            }
            
            موافق((سجل_dr.اقرأ() & 0xFF) كـ ص8)
        }
    }
}

