/**
 * (AR) منفذ تصحيح الأخطاء العام (للطباعة)
 */
#[cfg(target_arch = "x86_64")]
ثابت متغير منفذ_تصحيح: اختيار<منفذ_تسلسلي_x86> = لا_شيء؛

/**
 * (AR) تهيئة منفذ التصحيح
 */
#[cfg(target_arch = "x86_64")]
دالة عامة تهيئة_تصحيح() -> نتيجة<()، خطأ_تسلسلي> {
    غير_آمن {
        دع متغير منفذ = منفذ_تسلسلي_x86::جديد(عناوين_x86::COM1)؛
        منفذ.هيّئ(إعدادات_تسلسلي::افتراضي())؟؛
        منفذ_تصحيح = بعض(منفذ)؛
        موافق(())
    }
}

/**
 * (AR) طباعة رسالة تصحيح
 */
#[cfg(target_arch = "x86_64")]
دالة عامة اطبع_تصحيح(نص: &نص) {
    غير_آمن {
        إذا_دع بعض(مرجع منفذ) = &منفذ_تصحيح {
            دع _ = منفذ.اكتب(نص)؛
        }
    }
}

/**
 * (AR) طباعة سطر تصحيح
 */
#[cfg(target_arch = "x86_64")]
دالة عامة اطبع_سطر_تصحيح(نص: &نص) {
    غير_آمن {
        إذا_دع بعض(مرجع منفذ) = &منفذ_تصحيح {
            دع _ = منفذ.اكتب_سطر(نص)؛
        }
    }
}

