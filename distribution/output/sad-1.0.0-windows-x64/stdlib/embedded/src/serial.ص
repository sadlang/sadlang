    غير_مهيأ،          // (AR) المنفذ غير مهيأ
    فشل_التهيئة،       // (AR) فشل في تهيئة المنفذ
    خطأ_إطار،          // (AR) خطأ في إطار البيانات
    خطأ_تكافؤ،         // (AR) خطأ في التكافؤ
    طفحان،             // (AR) طفحان المخزن
