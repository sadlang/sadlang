/**
 * (AR) عناوين منافذ COM القياسية على x86
 */
#[cfg(target_arch = "x86_64")]
وحدة عناوين_x86 {
    // (AR) المنافذ الأساسية
    ثابت عام COM1: ص16 = 0x3F8؛
    ثابت عام COM2: ص16 = 0x2F8؛
    ثابت عام COM3: ص16 = 0x3E8؛
    ثابت عام COM4: ص16 = 0x2E8؛
    
    // (AR) إزاحات السجلات
    ثابت عام إزاحة_بيانات: ص16 = 0؛           // (AR) سجل البيانات / مقسم الباود (LSB)
    ثابت عام إزاحة_مقاطعة: ص16 = 1؛          // (AR) تفعيل المقاطعات / مقسم الباود (MSB)
    ثابت عام إزاحة_fifo: ص16 = 2؛            // (AR) FIFO control
    ثابت عام إزاحة_تحكم_خط: ص16 = 3؛        // (AR) Line control
    ثابت عام إزاحة_تحكم_مودم: ص16 = 4؛      // (AR) Modem control
    ثابت عام إزاحة_حالة_خط: ص16 = 5؛        // (AR) Line status
    ثابت عام إزاحة_حالة_مودم: ص16 = 6؛      // (AR) Modem status
    ثابت عام إزاحة_خدش: ص16 = 7؛            // (AR) Scratch register
}

