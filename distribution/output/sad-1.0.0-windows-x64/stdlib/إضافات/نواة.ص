# ===================================================================
# نظام الإضافات — النواة الرئيسية
# Sad Plugin System — Core Module
# ===================================================================
# نظام إضافات قابل للتوسيع للغة ص
# يسمح بإنشاء وتحميل وإدارة الإضافات الخارجية
#
# الميزات الرئيسية:
#   ✓ تحميل الإضافات ديناميكياً
#   ✓ نظام أحداث للتواصل بين الإضافات
#   ✓ خدمات قابلة للمشاركة
#   ✓ إدارة الاعتمادات والتوافق
#   ✓ دورة حياة كاملة (تحميل → تهيئة → تشغيل → إيقاف)
#
# الاستخدام الأساسي:
#   استورد * من إضافات.نواة
#   متغير مدير = جديد مدير_الإضافات()
#   مدير.حمّل("اسم_الإضافة")
#
# الاستخدام المتقدم:
#   الإضافات.عند("إضافة_محملة", لامدا(بيانات) {
#       اطبع_سطر("تم تحميل: " + بيانات.معرف)
#   })
#   الإضافات.حمّل("إضافة-مخصصة")
#
# @إصدار 1.0.0
# @مؤلف فريق لغة ص
# ===================================================================

# ─── واجهة_إضافة (Plugin Interface) ───
## الواجهة الأساسية التي يجب أن تنفذها جميع الإضافات
صدّر سمة واجهة_إضافة
    ## معرف الإضافة الفريد
    دالة معرف()
    
    ## اسم الإضافة للعرض
    دالة اسم()
    
    ## وصف الإضافة
    دالة وصف()
    
    ## إصدار الإضافة
    دالة إصدار()
    
    ## المؤلف
    دالة مؤلف()
    
    ## تهيئة الإضافة (تُستدعى عند التحميل)
    دالة هيئ(سياق)
    
    ## إيقاف الإضافة (تُستدعى عند الإزالة)
    دالة أوقف()
    
    ## التحقق من التوافق
    دالة متوافق_مع(إصدار_لغة)
نهاية

# ─── سياق_إضافة (PluginContext) ───
## السياق الذي يُمرر للإضافة عند التهيئة
صدّر صنف سياق_إضافة
    باني(مدير)
        هذا._مدير = مدير
        هذا._خدمات = {}
        هذا._أحداث = {}
        هذا._إعدادات = {}
    نهاية

    ## تسجيل خدمة جديدة
    دالة سجل_خدمة(اسم, خدمة)
        هذا._خدمات[اسم] = خدمة
    نهاية

    ## الحصول على خدمة
    دالة احصل_خدمة(اسم)
        ارجع هذا._خدمات[اسم]
    نهاية

    ## الاشتراك في حدث
    دالة اشترك(حدث, معالج)
        إذا (هذا._أحداث[حدث] == لاشيء)
            هذا._أحداث[حدث] = []
        نهاية
        هذا._أحداث[حدث].أضف(معالج)
    نهاية

    ## إطلاق حدث
    دالة أطلق(حدث, بيانات = لاشيء)
        إذا (هذا._أحداث[حدث] != لاشيء)
            لكل معالج في هذا._أحداث[حدث]
                معالج(بيانات)
            نهاية
        نهاية
    نهاية

    ## تعيين إعداد
    دالة عيّن_إعداد(مفتاح, قيمة)
        هذا._إعدادات[مفتاح] = قيمة
    نهاية

    ## الحصول على إعداد
    دالة احصل_إعداد(مفتاح, قيمة_افتراضية = لاشيء)
        إذا (هذا._إعدادات[مفتاح] != لاشيء)
            ارجع هذا._إعدادات[مفتاح]
        نهاية
        ارجع افتراضي
    نهاية

    ## الوصول للمدير الأصلي
    دالة مدير()
        ارجع هذا._مدير
    نهاية
نهاية

# ─── معلومات_إضافة (PluginInfo) ───
## معلومات وصفية عن الإضافة
صدّر صنف معلومات_إضافة
    باني(معرف, اسم, إصدار)
        هذا.معرف = معرف
        هذا.اسم = اسم
        هذا.إصدار = إصدار
        هذا.وصف = ""
        هذا.مؤلف = ""
        هذا.رابط = ""
        هذا.رخصة = "MIT"
        هذا.اعتمادات = []
        هذا.كلمات_مفتاحية = []
        هذا.حد_أدنى_إصدار = "1.0.0"
    نهاية

    دالة مع_وصف(نص)
        هذا.وصف = نص
        ارجع هذا
    نهاية

    دالة مع_مؤلف(اسم)
        هذا.مؤلف = اسم
        ارجع هذا
    نهاية

    دالة مع_رابط(رابط)
        هذا.رابط = رابط
        ارجع هذا
    نهاية

    دالة مع_اعتمادات(قائمة)
        هذا.اعتمادات = قائمة
        ارجع هذا
    نهاية

    دالة يتطلب(إصدار)
        هذا.حد_أدنى_إصدار = إصدار
        ارجع هذا
    نهاية
نهاية

# ─── حالة_إضافة (PluginState) ───
## حالة الإضافة الحالية
صدّر تعداد حالة_إضافة
    غير_محملة
    محملة
    مهيأة
    نشطة
    موقفة
    خاطئة
نهاية

# ─── مدير_الإضافات (PluginManager) ───
## المدير الرئيسي لجميع الإضافات
صدّر صنف مدير_الإضافات
    باني()
        هذا._إضافات = {}
        هذا._حالات = {}
        هذا._سياق = جديد سياق_إضافة(هذا)
        هذا._مسارات_بحث = ["إضافات/", "~/.sad/إضافات/"]
        هذا._مستمعون = {}
        هذا._إصدار_لغة = "1.0.0"
    نهاية

    ## تحميل إضافة من المعرف
    دالة حمّل(معرف)
        إذا (هذا._إضافات[معرف] != لاشيء)
            ارجع {"نجاح": خطأ, "خطأ": "الإضافة محملة مسبقاً"}
        نهاية

        # البحث عن الإضافة
        متغير مسار = هذا._ابحث_عن_إضافة(معرف)
        إذا (مسار == لاشيء)
            ارجع {"نجاح": خطأ, "خطأ": "لم يتم العثور على الإضافة"}
        نهاية

        # تحميل وتهيئة
        حاول
            متغير إضافة = هذا._حمّل_من_مسار(مسار)
            
            # التحقق من التوافق
            إذا (ليس إضافة.متوافق_مع(هذا._إصدار_لغة))
                ارجع {"نجاح": خطأ, "خطأ": "الإضافة غير متوافقة مع هذا الإصدار"}
            نهاية

            # تهيئة الإضافة
            إضافة.هيئ(هذا._سياق)
            
            هذا._إضافات[معرف] = إضافة
            هذا._حالات[معرف] = حالة_إضافة.نشطة
            
            هذا._أطلق_حدث("إضافة_محملة", {"معرف": معرف})
            
            ارجع {"نجاح": صحيح, "إضافة": إضافة}
        امسك (خ)
            هذا._حالات[معرف] = حالة_إضافة.خاطئة
            ارجع {"نجاح": خطأ, "خطأ": خ}
        نهاية
    نهاية

    ## إزالة إضافة
    دالة أزل(معرف)
        إذا (هذا._إضافات[معرف] == لاشيء)
            ارجع {"نجاح": خطأ, "خطأ": "الإضافة غير موجودة"}
        نهاية

        حاول
            هذا._إضافات[معرف].أوقف()
            هذا._إضافات.احذف(معرف)
            هذا._حالات.احذف(معرف)
            
            هذا._أطلق_حدث("إضافة_مزالة", {"معرف": معرف})
            
            ارجع {"نجاح": صحيح}
        امسك (خ)
            ارجع {"نجاح": خطأ, "خطأ": خ}
        نهاية
    نهاية

    ## إعادة تحميل إضافة
    دالة أعد_تحميل(معرف)
        هذا.أزل(معرف)
        ارجع هذا.حمّل(معرف)
    نهاية

    ## الحصول على إضافة
    دالة احصل(معرف)
        ارجع هذا._إضافات[معرف]
    نهاية

    ## قائمة جميع الإضافات المحملة
    دالة قائمة()
        متغير قائمة = []
        لكل معرف في هذا._إضافات.مفاتيح()
            متغير إ = هذا._إضافات[معرف]
            قائمة.أضف({
                "معرف": معرف,
                "اسم": إ.اسم(),
                "إصدار": إ.إصدار(),
                "حالة": هذا._حالات[معرف]
            })
        نهاية
        ارجع قائمة
    نهاية

    ## البحث عن إضافات متاحة
    دالة ابحث(استعلام = "")
        # يبحث في المسارات المسجلة
        متغير نتائج = []
        لكل مسار في هذا._مسارات_بحث
            # TODO: تنفيذ البحث الفعلي في الملفات
            نتائج.أضف_كل(هذا._ابحث_في_مسار(مسار, استعلام))
        نهاية
        ارجع نتائج
    نهاية

    ## إضافة مسار بحث
    دالة أضف_مسار_بحث(مسار)
        هذا._مسارات_بحث.أضف(مسار)
    نهاية

    ## تسجيل مستمع لأحداث المدير
    دالة عند(حدث, معالج)
        إذا (هذا._مستمعون[حدث] == لاشيء)
            هذا._مستمعون[حدث] = []
        نهاية
        هذا._مستمعون[حدث].أضف(معالج)
    نهاية

    # ─── دوال داخلية ───

    دالة _ابحث_عن_إضافة(معرف)
        لكل مسار في هذا._مسارات_بحث
            متغير مسار_كامل = مسار + معرف + "/إضافة.ص"
            # TODO: التحقق من وجود الملف
            ارجع مسار_كامل
        نهاية
        ارجع لاشيء
    نهاية

    دالة _حمّل_من_مسار(مسار)
        # TODO: تحميل الملف وإنشاء كائن الإضافة
        ارجع لاشيء
    نهاية

    دالة _ابحث_في_مسار(مسار, استعلام)
        # TODO: البحث في المسار
        ارجع []
    نهاية

    دالة _أطلق_حدث(حدث, بيانات)
        إذا (هذا._مستمعون[حدث] != لاشيء)
            لكل معالج في هذا._مستمعون[حدث]
                معالج(بيانات)
            نهاية
        نهاية
    نهاية
نهاية

# ─── مدير عام افتراضي ───
صدّر متغير الإضافات = جديد مدير_الإضافات()
