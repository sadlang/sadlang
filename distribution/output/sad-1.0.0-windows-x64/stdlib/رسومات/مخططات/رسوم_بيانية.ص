        هذا._قيمة = إعدادات.قيمة أو 0
        هذا._حد_أدنى = إعدادات.حد_أدنى أو 0
        هذا._حد_أقصى = إعدادات.حد_أقصى أو 100
        هذا._عنوان = إعدادات.عنوان أو ""
        هذا._نطاقات = إعدادات.نطاقات أو [
            {من: 0، إلى: 33، لون: "#F44336"}،
            {من: 33، إلى: 66، لون: "#FFC107"}،
            {من: 66، إلى: 100، لون: "#4CAF50"}
        ]
        هذا._زاوية_البداية = إعدادات.زاوية_البداية أو 180
        هذا._زاوية_النهاية = إعدادات.زاوية_النهاية أو 0
    نهاية

    دالة عيّن_قيمة(قيمة)
        هذا._قيمة = قيمة.ثبّت(هذا._حد_أدنى، هذا._حد_أقصى)
    نهاية

    دالة بناء()
        ارجع {
            نوع: "مخطط_مقياس"،
            قيمة: هذا._قيمة،
            حد_أدنى: هذا._حد_أدنى،
            حد_أقصى: هذا._حد_أقصى،
            عنوان: هذا._عنوان،
            نطاقات: هذا._نطاقات
