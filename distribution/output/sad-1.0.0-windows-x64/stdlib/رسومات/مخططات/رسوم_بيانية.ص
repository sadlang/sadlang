# العيب #151: LineChart - مخطط خطي
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف نقطة_بيانات
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

صدّر صنف سلسلة_بيانات
    باني(إعدادات)
        هذا._اسم = إعدادات.اسم أو ""
        هذا._لون = إعدادات.لون أو "#2196F3"
        هذا._نقاط = إعدادات.نقاط أو []
        هذا._عرض_خط = إعدادات.عرض_خط أو 2
        هذا._نوع_خط = إعدادات.نوع_خط أو "صلب"  # صلب، متقطع، منقط
        هذا._أظهر_نقاط = إعدادات.أظهر_نقاط أو صحيح
        هذا._نصف_قطر_نقطة = إعدادات.نصف_قطر_نقطة أو 4
        هذا._ملء_تحت = إعدادات.ملء_تحت أو خطأ
        هذا._لون_ملء = إعدادات.لون_ملء أو لاشيء
    نهاية

    دالة أضف_نقطة(س، ص)
        هذا._نقاط.أضف(جديد نقطة_بيانات(س، ص))
    نهاية

    دالة أقصى_ص()
        متغير أقصى = هذا._نقاط[0].ص
        لكل نقطة في هذا._نقاط
            إذا (نقطة.ص > أقصى)
                أقصى = نقطة.ص
            نهاية
        نهاية
        ارجع أقصى
    نهاية

    دالة أدنى_ص()
        متغير أدنى = هذا._نقاط[0].ص
        لكل نقطة في هذا._نقاط
            إذا (نقطة.ص < أدنى)
                أدنى = نقطة.ص
            نهاية
        نهاية
        ارجع أدنى
    نهاية
نهاية

صدّر صنف مخطط_خطي
    باني(إعدادات)
        هذا._سلاسل = إعدادات.سلاسل أو []
        هذا._عنوان = إعدادات.عنوان أو ""
        هذا._عنوان_س = إعدادات.عنوان_س أو ""
        هذا._عنوان_ص = إعدادات.عنوان_ص أو ""
        هذا._أظهر_شبكة = إعدادات.أظهر_شبكة أو صحيح
        هذا._أظهر_دليل = إعدادات.أظهر_دليل أو صحيح
        هذا._متحرك = إعدادات.متحرك أو صحيح
        هذا._هوامش = إعدادات.هوامش أو {أعلى: 20، أسفل: 40، يمين: 20، يسار: 40}
        هذا._لون_خلفية = إعدادات.لون_خلفية أو "#FFFFFF"
        هذا._لون_شبكة = إعدادات.لون_شبكة أو "#E0E0E0"
    نهاية

    دالة أضف_سلسلة(سلسلة)
        هذا._سلاسل.أضف(سلسلة)
    نهاية

    دالة بناء()
        ارجع {
            نوع: "مخطط_خطي"،
            سلاسل: هذا._سلاسل،
            عنوان: هذا._عنوان،
            عنوان_س: هذا._عنوان_س،
            عنوان_ص: هذا._عنوان_ص،
            أظهر_شبكة: هذا._أظهر_شبكة،
            أظهر_دليل: هذا._أظهر_دليل،
            متحرك: هذا._متحرك،
            هوامش: هذا._هوامش
        }
    نهاية
نهاية

