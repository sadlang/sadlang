استورد * من رسومات.أساس.عنصر

# ─── نطاق الرجوع (WillPopScope) ───
صدّر صنف نطاق_رجوع يرث عنصر
    باني(ابن، عند_رجوع)
        هذا._نوع = "نطاق_رجوع"
        هذا._ابن = ابن
        هذا._عند_رجوع = عند_رجوع
    نهاية

    دالة الابن()
        ارجع هذا._ابن
    نهاية

    غير_متزامن دالة _معالجة_رجوع()
        # إذا أرجعت الدالة true، يتم السماح بالرجوع
        # إذا أرجعت false، يتم إلغاء الرجوع
        متغير يسمح = انتظر هذا._عند_رجوع()
        ارجع يسمح
    نهاية
نهاية

# ─── مُستمع الرجوع (PopScope - الجديد) ───
صدّر صنف مستمع_رجوع يرث عنصر
    باني(ابن، يمكن_رجوع = صحيح، عند_محاولة_رجوع = لاشيء)
        هذا._نوع = "مستمع_رجوع"
        هذا._ابن = ابن
        هذا._يمكن_رجوع = يمكن_رجوع
        هذا._عند_محاولة_رجوع = عند_محاولة_رجوع
    نهاية

    دالة يمكن_رجوع؟()
        ارجع هذا._يمكن_رجوع
    نهاية
نهاية

# ─── زر الرجوع (BackButton) ───
صدّر صنف زر_رجوع يرث عنصر
    باني(عند_ضغط = لاشيء، لون = لاشيء)
        هذا._نوع = "زر_رجوع"
        هذا._عند_ضغط = عند_ضغط
        هذا._لون = لون
    نهاية
نهاية

# ─── زر رجوع المنصة ───
صدّر صنف زر_رجوع_منصة يرث عنصر
    باني(عند_ضغط = لاشيء)
        هذا._نوع = "زر_رجوع_منصة"
        هذا._عند_ضغط = عند_ضغط
    نهاية
نهاية

# ─── مستمع زر الرجوع (BackButtonListener) ───
صدّر صنف مستمع_زر_رجوع يرث عنصر
    باني(ابن، عند_رجوع)
        هذا._نوع = "مستمع_زر_رجوع"
        هذا._ابن = ابن
        هذا._عند_رجوع = عند_رجوع
    نهاية

    # تسجيل مستمع على نظام Android/iOS
    دالة سجّل()
        _سجّل_مستمع_رجوع(هذا._معالج.bind(هذا))
    نهاية

    دالة ألغِ_تسجيل()
        _ألغِ_مستمع_رجوع(هذا)
    نهاية

    غير_متزامن دالة _معالج()
        متغير نتيجة = انتظر هذا._عند_رجوع()
        ارجع نتيجة
    نهاية
نهاية

# ─── مُرسل الرجوع (BackButtonDispatcher) ───
صدّر صنف مرسل_رجوع
    باني()
        هذا._استدعاءات = []
    نهاية

    دالة أضف_استدعاء(استدعاء، أولوية = 0)
        هذا._استدعاءات.أضف({
            دالة: استدعاء،
            أولوية: أولوية
        })
        هذا._رتّب()
    نهاية

    دالة أزل_استدعاء(استدعاء)
        هذا._استدعاءات = هذا._استدعاءات.رشّح(لامدا(س) => س.دالة != استدعاء)
    نهاية

    دالة _رتّب()
        هذا._استدعاءات.رتّب(لامدا(أ، ب) => ب.أولوية - أ.أولوية)
    نهاية

    غير_متزامن دالة استدعِ()
        لكل عنصر في هذا._استدعاءات
            متغير نتيجة = انتظر عنصر.دالة()
            إذا (نتيجة == صحيح)
                # تم معالجة الرجوع
                ارجع صحيح
            نهاية
        نهاية
        # لم تتم معالجة الرجوع
        ارجع خطأ
    نهاية

    دالة أنشئ_ابن()
        ارجع جديد مرسل_رجوع_فرعي(هذا)
    نهاية
نهاية

# ─── مرسل رجوع فرعي ───
صنف مرسل_رجوع_فرعي يرث مرسل_رجوع
    باني(أب)
        الأساس.باني()
        هذا._أب = أب
    نهاية

    غير_متزامن دالة استدعِ()
        متغير تم_المعالجة = انتظر الأساس.استدعِ()
        إذا (تم_المعالجة)
            ارجع صحيح
        نهاية
        # فوّض للأب
        ارجع انتظر هذا._أب.استدعِ()
    نهاية
نهاية

# ─── مرسل جذر الرجوع (RootBackButtonDispatcher) ───
صدّر صنف مرسل_جذر_رجوع يرث مرسل_رجوع
    ساكن متغير _نسخة = لاشيء

    ساكن دالة النسخة()
        إذا (_نسخة == لاشيء)
            _نسخة = جديد مرسل_جذر_رجوع()
        نهاية
        ارجع _نسخة
    نهاية

    باني()
        الأساس.باني()
        # ربط مع زر الرجوع الأصلي للمنصة
        _اربط_زر_رجوع_منصة(هذا._معالج_منصة.bind(هذا))
    نهاية

    غير_متزامن دالة _معالج_منصة()
        متغير تم = انتظر هذا.استدعِ()
        إذا (ليس تم)
            # إذا لم تتم المعالجة، السماح بالسلوك الافتراضي
            _سماح_رجوع_افتراضي()
        نهاية
    نهاية
نهاية

# ─── حوار تأكيد الخروج ───
صدّر صنف حوار_تأكيد_خروج
    ساكن غير_متزامن دالة أظهر(سياق، عنوان = "تأكيد الخروج"، رسالة = "هل تريد الخروج؟")
        ارجع انتظر _أظهر_حوار(سياق، {
            عنوان: عنوان،
            محتوى: رسالة،
            أزرار: [
                {نص: "إلغاء"، قيمة: خطأ}،
                {نص: "خروج"، قيمة: صحيح}
            ]
        })
    نهاية
نهاية

# ─── مساعد الرجوع ───
صدّر صنف مساعد_رجوع
    # إنشاء نطاق رجوع مع حوار تأكيد
    ساكن دالة مع_تأكيد(ابن، عنوان = لاشيء، رسالة = لاشيء)
        ارجع جديد نطاق_رجوع(
            ابن،
            غير_متزامن لامدا(سياق) =>
                انتظر حوار_تأكيد_خروج.أظهر(
                    سياق،
                    عنوان أو "تأكيد الخروج"،
                    رسالة أو "هل أنت متأكد من رغبتك في الخروج؟"
                )
        )
    نهاية

    # منع الرجوع نهائياً
    ساكن دالة امنع_رجوع(ابن)
        ارجع جديد نطاق_رجوع(
            ابن،
            غير_متزامن لامدا() => خطأ
        )
    نهاية

    # السماح بالرجوع بشرط
    ساكن دالة اسمح_بشرط(ابن، شرط)
        ارجع جديد نطاق_رجوع(
            ابن،
            غير_متزامن لامدا() => شرط()
        )
    نهاية
نهاية

# ─── معالج إيماءة الرجوع ───
صدّر صنف معالج_إيماءة_رجوع يرث عنصر
    باني(ابن، عند_بدء_إيماءة = لاشيء، عند_تقدم_إيماءة = لاشيء، عند_انتهاء_إيماءة = لاشيء)
        هذا._نوع = "معالج_إيماءة_رجوع"
        هذا._ابن = ابن
        هذا._عند_بدء = عند_بدء_إيماءة
        هذا._عند_تقدم = عند_تقدم_إيماءة
        هذا._عند_انتهاء = عند_انتهاء_إيماءة
    نهاية
نهاية
