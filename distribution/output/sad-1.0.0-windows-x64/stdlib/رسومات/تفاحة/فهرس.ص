# ===================================================================
# Cupertino (iOS) — الفهرس الرئيسي
# ===================================================================
# ملف التصدير الرئيسي لجميع عناصر Cupertino/Apple
# استخدم هذا الملف لاستيراد كل مكتبة Cupertino بسطر واحد
#
# الاستخدام:
#   استورد * من رسومات.تفاحة
#   أو
#   استورد * من رسومات.تفاحة.فهرس
# ===================================================================

# ─── تصدير جميع الوحدات ───

# عناصر الواجهة الأساسية (أزرار، مفاتيح، منزلقات)
صدّر * من رسومات.تفاحة.عناصر

# الكوبرتينو الأساسي (ألوان، سمات، أشرطة تنقل)
صدّر * من رسومات.تفاحة.كوبرتينو

# الحوارات والورقات والتطبيق
صدّر * من رسومات.تفاحة.حوارات

# عناصر الإدخال (حقول نص، منتقيات، تحكم مقسم)
صدّر * من رسومات.تفاحة.إدخال

# مؤشرات التقدم والنشاط
صدّر * من رسومات.تفاحة.تقدم

# القوائم والعناصر السياقية
صدّر * من رسومات.تفاحة.قوائم

# التنقل والملاحة
صدّر * من رسومات.تفاحة.تنقل

# الأيقونات
صدّر * من رسومات.تفاحة.أيقونات

# السمات والألوان
صدّر * من رسومات.تفاحة.سمة

# الرسوم المتحركة والتحريك
صدّر * من رسومات.تفاحة.تحريك

# الهياكل والصفحات المتقدمة
صدّر * من رسومات.تفاحة.هياكل

# التفاعلات واللمس
صدّر * من رسومات.تفاحة.تفاعلات

