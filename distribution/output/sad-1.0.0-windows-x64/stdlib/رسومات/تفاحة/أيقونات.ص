# ─── أيقونة_تفاحة (CupertinoIcon) ───
## عنصر أيقونة بنمط iOS
صدّر صنف أيقونة_تفاحة يرث عنصر
    باني(بيانات, حجم = 24, لون = لاشيء)
        هذا._نوع = "أيقونة_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["بيانات"] = بيانات
        هذا._خصائص["حجم"] = حجم
        هذا._خصائص["لون"] = لون
        هذا._خصائص["دلالات"] = لاشيء
    نهاية

    دالة لون(قيمة)
        هذا._خصائص["لون"] = قيمة
        ارجع هذا
    نهاية

    دالة حجم(قيمة)
        هذا._خصائص["حجم"] = قيمة
        ارجع هذا
    نهاية
نهاية

# ─── دوال مساعدة ───

## إنشاء أيقونة من الاسم
