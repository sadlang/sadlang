# ─── قائمة_سياق_تفاحة (CupertinoContextMenu) ───
## القائمة السياقية التي تظهر عند الضغط المطول
صدّر صنف قائمة_سياق_تفاحة يرث عنصر
    باني(ابن, إجراءات = [])
        هذا._نوع = "قائمة_سياق_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = [ابن]
        هذا._خصائص["إجراءات"] = إجراءات
        هذا._خصائص["تفعيل_لمس"] = صحيح
        هذا._خصائص["معاينة_بناء"] = لاشيء
    نهاية

    دالة معاينة(دالة_بناء)
        هذا._خصائص["معاينة_بناء"] = دالة_بناء
        ارجع هذا
    نهاية
نهاية

# ─── إجراء_سياق_تفاحة (CupertinoContextMenuAction) ───
## إجراء واحد في القائمة السياقية
صدّر صنف إجراء_سياق_تفاحة يرث عنصر
    باني(ابن = لاشيء, عند_الضغط = لاشيء, مدمر = خطأ)
        هذا._نوع = "إجراء_سياق_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["مدمر"] = مدمر  # يجعله أحمر
        هذا._خصائص["افتراضي"] = خطأ
        هذا._خصائص["أيقونة_زائدة"] = لاشيء
    نهاية

    دالة افتراضي()
        هذا._خصائص["افتراضي"] = صحيح
        ارجع هذا
    نهاية

    دالة أيقونة_زائدة(أيقونة)
        هذا._خصائص["أيقونة_زائدة"] = أيقونة
        ارجع هذا
    نهاية
نهاية

# ─── عنصر_قائمة_تفاحة (CupertinoListTile) ───
## عنصر قائمة بنمط iOS Settings
صدّر صنف عنصر_قائمة_تفاحة يرث عنصر
    باني(عنوان, عنوان_فرعي = لاشيء, بادئة = لاشيء, لاحقة = لاشيء, عند_الضغط = لاشيء)
        هذا._نوع = "عنصر_قائمة_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["عنوان_فرعي"] = عنوان_فرعي
        هذا._خصائص["بادئة"] = بادئة
        هذا._خصائص["لاحقة"] = لاحقة
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["لون_خلفية"] = "#FFFFFF"
        هذا._خصائص["حشوة"] = {"أفقي": 16, "عمودي": 12}
        هذا._خصائص["سهم_تنقل"] = خطأ
    نهاية

    دالة مع_سهم()
        هذا._خصائص["سهم_تنقل"] = صحيح
        ارجع هذا
    نهاية

    # عنصر مع إشعار (badge)
    ساكن دالة مع_إشعار(عنوان, إشعار, عند_الضغط = لاشيء)
        متغير ع = جديد عنصر_قائمة_تفاحة(عنوان, لاشيء, لاشيء, لاشيء, عند_الضغط)
        ع._خصائص["إشعار"] = إشعار
        ارجع ع
    نهاية
نهاية

# ─── قسم_قائمة_تفاحة (CupertinoListSection) ───
## قسم قائمة بنمط iOS مع رأس وتذييل
صدّر صنف قسم_قائمة_تفاحة يرث عنصر
    باني(أبناء = [], رأس = لاشيء, تذييل = لاشيء)
        هذا._نوع = "قسم_قائمة_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = أبناء
        هذا._خصائص["رأس"] = رأس
        هذا._خصائص["تذييل"] = تذييل
        هذا._خصائص["لون_خلفية"] = "#FFFFFF"
        هذا._خصائص["هوامش"] = {"أعلى": 20, "أسفل": 20}
        هذا._خصائص["مضمن"] = خطأ
        هذا._خصائص["فاصل"] = صحيح
    نهاية

    ساكن دالة مضمن(أبناء, رأس = لاشيء, تذييل = لاشيء)
        متغير ق = جديد قسم_قائمة_تفاحة(أبناء, رأس, تذييل)
        ق._خصائص["مضمن"] = صحيح
        ارجع ق
    نهاية
نهاية

