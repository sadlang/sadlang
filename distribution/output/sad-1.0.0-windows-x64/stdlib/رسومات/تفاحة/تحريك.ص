# ─── عنصر_متحرك_ضمني_تفاحة ───
## عنصر يتحرك تلقائياً عند تغيير خصائصه
صدّر صنف حاوية_متحركة_تفاحة يرث عنصر
    باني(ابن = لاشيء, مدة = 300, منحنى = "تفاحة_قياسي")
        هذا._نوع = "حاوية_متحركة_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
        هذا._خصائص["مدة"] = مدة
        هذا._خصائص["منحنى"] = منحنى
        هذا._خصائص["عرض"] = لاشيء
        هذا._خصائص["ارتفاع"] = لاشيء
        هذا._خصائص["لون"] = لاشيء
        هذا._خصائص["حشوة"] = لاشيء
        هذا._خصائص["هامش"] = لاشيء
        هذا._خصائص["تزيين"] = لاشيء
        هذا._خصائص["تحويل"] = لاشيء
    نهاية

    دالة بأبعاد(عرض, ارتفاع)
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        ارجع هذا
    نهاية

    دالة بلون(لون)
        هذا._خصائص["لون"] = لون
        ارجع هذا
    نهاية
نهاية

