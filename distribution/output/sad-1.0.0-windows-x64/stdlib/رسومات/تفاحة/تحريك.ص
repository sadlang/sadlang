# ─── تحريك_تفاحة (CupertinoAnimation) ───
## بناء تحريك بنمط iOS
صدّر صنف تحريك_تفاحة
    باني(مدة, منحنى = "تفاحة_قياسي")
        هذا._مدة = مدة
        هذا._منحنى = منحنى
        هذا._قيمة_بداية = 0
        هذا._قيمة_نهاية = 1
        هذا._تأخير = 0
        هذا._تكرار = 1
        هذا._عكس = خطأ
    نهاية

    دالة من_إلى(بداية, نهاية)
        هذا._قيمة_بداية = بداية
        هذا._قيمة_نهاية = نهاية
        ارجع هذا
    نهاية

    دالة تأخير(مللي_ثانية)
        هذا._تأخير = مللي_ثانية
        ارجع هذا
    نهاية

    دالة تكرار(عدد)
        هذا._تكرار = عدد
        ارجع هذا
    نهاية

    دالة لا_نهائي()
        هذا._تكرار = -1
        ارجع هذا
    نهاية

    دالة مع_عكس()
        هذا._عكس = صحيح
        ارجع هذا
    نهاية

    دالة بناء()
        ارجع {
            "مدة": هذا._مدة,
            "منحنى": منحنيات_تفاحة[هذا._منحنى],
            "بداية": هذا._قيمة_بداية,
            "نهاية": هذا._قيمة_نهاية,
            "تأخير": هذا._تأخير,
            "تكرار": هذا._تكرار,
            "عكس": هذا._عكس
        }
    نهاية
نهاية

