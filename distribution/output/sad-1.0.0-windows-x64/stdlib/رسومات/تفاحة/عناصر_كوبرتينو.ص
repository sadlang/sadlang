صدّر صنف منزلق_تفاحي
    باني(إعدادات)
        هذا._قيمة = إعدادات.قيمة أو 0
        هذا._حد_أدنى = إعدادات.حد_أدنى أو 0
        هذا._حد_أقصى = إعدادات.حد_أقصى أو 1
        هذا._لون_نشط = إعدادات.لون_نشط أو "#007AFF"
        هذا._لون_إبهام = إعدادات.لون_إبهام أو "#FFFFFF"
        هذا._عند_التغيير = إعدادات.عند_التغيير أو لاشيء
    نهاية

    دالة عيّن_قيمة(قيمة)
        هذا._قيمة = ماكس(هذا._حد_أدنى، مين(هذا._حد_أقصى، قيمة))
        إذا (هذا._عند_التغيير)
            هذا._عند_التغيير(هذا._قيمة)
        نهاية
    نهاية

    دالة بناء()
        ارجع {
            نوع: "منزلق_تفاحي"،
            قيمة: هذا._قيمة،
            حد_أدنى: هذا._حد_أدنى،
            حد_أقصى: هذا._حد_أقصى،
            لون_نشط: هذا._لون_نشط،
            لون_إبهام: هذا._لون_إبهام
        }
    نهاية
نهاية

