# العيب #61: CupertinoButton - زر iOS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف زر_تفاحي
    باني(إعدادات)
        هذا._ابن = إعدادات.ابن أو لاشيء
        هذا._نص = إعدادات.نص أو ""
        هذا._لون = إعدادات.لون أو "#007AFF"
        هذا._معبأ = إعدادات.معبأ أو خطأ
        هذا._حشوة = إعدادات.حشوة أو {فوق: 16، تحت: 16، يمين: 24، يسار: 24}
        هذا._عند_الضغط = إعدادات.عند_الضغط أو لاشيء
        هذا._معطل = إعدادات.معطل أو خطأ
        هذا._نصف_قطر = إعدادات.نصف_قطر أو 8
    نهاية

    دالة بناء()
        ارجع {
            نوع: "زر_تفاحي"،
            ابن: هذا._ابن أو {نوع: "نص"، نص: هذا._نص}،
            لون: هذا._معبأ ? "#FFFFFF" : هذا._لون،
            لون_خلفية: هذا._معبأ ? هذا._لون : "شفاف"،
            حشوة: هذا._حشوة،
            معطل: هذا._معطل،
            نصف_قطر: هذا._نصف_قطر،
            تأثير_ضغط: 0.4  # شفافية عند الضغط
        }
    نهاية
نهاية

