# ─── امتداد نصي (TextSpan) ───
صدّر صنف امتداد_نصي
    باني(
        نص = لاشيء،
        أطفال = لاشيء،
        نمط = لاشيء،
        معرّف = لاشيء،
        عند_دخول_مؤشر = لاشيء،
        عند_خروج_مؤشر = لاشيء،
        عند_نقر = لاشيء،
        عند_نقر_طويل = لاشيء،
        دلالات = لاشيء،
        محلي = لاشيء
    )
        هذا.نص = نص
        هذا.أطفال = أطفال أو []
        هذا.نمط = نمط
        هذا.معرّف = معرّف
        هذا._عند_دخول = عند_دخول_مؤشر
        هذا._عند_خروج = عند_خروج_مؤشر
        هذا._عند_نقر = عند_نقر
        هذا._عند_نقر_طويل = عند_نقر_طويل
        هذا.دلالات = دلالات
        هذا.محلي = محلي
    نهاية

    دالة أضف_طفل(طفل)
        هذا.أطفال.أضف(طفل)
        ارجع هذا
    نهاية

    دالة إلى_نص_عادي()
        متغير نتيجة = هذا.نص أو ""
        لكل طفل في هذا.أطفال
            نتيجة = نتيجة + طفل.إلى_نص_عادي()
        نهاية
        ارجع نتيجة
    نهاية

    # زيارة كل الامتدادات
    دالة زُر(زائر)
        متغير استمر = زائر(هذا)
        إذا (استمر != خطأ)
            لكل طفل في هذا.أطفال
                طفل.زُر(زائر)
            نهاية
        نهاية
    نهاية

    # الحصول على النمط المدموج
    دالة نمط_فعّال(نمط_أب = لاشيء)
        إذا (نمط_أب == لاشيء)
            ارجع هذا.نمط
        نهاية
        إذا (هذا.نمط == لاشيء)
            ارجع نمط_أب
        نهاية
        ارجع نمط_أب.دمج(هذا.نمط)
    نهاية
نهاية

# ─── امتداد عنصر (WidgetSpan) ───
صدّر صنف امتداد_عنصر يرث امتداد_نصي
    باني(ابن، محاذاة = لاشيء، خط_أساس = لاشيء، نمط = لاشيء)
        الأساس.باني(نمط: نمط)
        هذا._ابن = ابن
        هذا._محاذاة = محاذاة أو محاذاة_امتداد.خط_أساس
        هذا._خط_أساس = خط_أساس
    نهاية
نهاية

