# ─── باني نص منسق مساعد ───
صدّر صنف باني_نص_منسق
    باني(نمط_افتراضي = لاشيء)
        هذا._امتدادات = []
        هذا._نمط_افتراضي = نمط_افتراضي
    نهاية

    دالة أضف(نص، نمط = لاشيء)
        هذا._امتدادات.أضف(جديد امتداد_نصي(
            نص: نص،
            نمط: نمط
        ))
        ارجع هذا
    نهاية

    دالة عريض(نص)
        ارجع هذا.أضف(نص، جديد نمط_نص(وزن_خط: وزن_خط.عريض))
    نهاية

    دالة مائل(نص)
        ارجع هذا.أضف(نص، جديد نمط_نص(نمط_خط: نمط_خط.مائل))
    نهاية

    دالة تحته_خط(نص)
        ارجع هذا.أضف(نص، جديد نمط_نص(زخرفة: زخرفة_نص.خط_سفلي))
    نهاية

    دالة ملون(نص، لون)
        ارجع هذا.أضف(نص، جديد نمط_نص(لون: لون))
    نهاية

    دالة بحجم(نص، حجم)
        ارجع هذا.أضف(نص، جديد نمط_نص(حجم_خط: حجم))
    نهاية

    دالة رابط(نص، رابط، عند_نقر)
        هذا._امتدادات.أضف(جديد امتداد_نصي(
            نص: نص،
            نمط: جديد نمط_نص(
                لون: ألوان.أزرق،
                زخرفة: زخرفة_نص.خط_سفلي
            )،
            عند_نقر: عند_نقر
        ))
        ارجع هذا
    نهاية

    دالة عنصر(عنصر)
        هذا._امتدادات.أضف(جديد امتداد_عنصر(عنصر))
        ارجع هذا
    نهاية

    دالة ابنِ()
        ارجع جديد امتداد_نصي(
            نمط: هذا._نمط_افتراضي،
            أطفال: هذا._امتدادات
        )
    نهاية

    دالة ابنِ_عنصر()
        ارجع جديد نص_منسق(نص: هذا.ابنِ())
    نهاية
نهاية
