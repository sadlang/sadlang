        هذا._نمط = نمط
        هذا._محاذاة = محاذاة
        هذا._اتجاه = اتجاه
        هذا._مقياس = مقياس
        هذا._أقصى_سطور = أقصى_سطور
        هذا._لون_مؤشر = لون_مؤشر
        هذا._عند_نقر = عند_نقر
        هذا._عند_تغيير = عند_تغيير_اختيار
        هذا._أظهر_مؤشر = أظهر_مؤشر
        هذا._تحكمات = تحكمات_سياق
        هذا._نقطة_تركيز = نقطة_تركيز
        هذا._عند_اختيار = عند_اختيار
        هذا._مُمكَّن = مُمكَّن
