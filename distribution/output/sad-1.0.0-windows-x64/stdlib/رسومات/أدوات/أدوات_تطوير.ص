# ─── مفتش_العناصر (Widget Inspector) ───
صدّر صنف مفتش_العناصر
    باني()
        هذا._فعال = خطأ
        هذا._عنصر_محدد = لاشيء
        هذا._شجرة_العناصر = لاشيء
        هذا._إظهار_حدود = خطأ
        هذا._إظهار_أبعاد = خطأ
    نهاية

    # ─── تفعيل/إيقاف المفتش ───
    دالة فعّل()
        هذا._فعال = صحيح
        اطبع_سطر("🔍 مفتش العناصر مفعّل - اضغط F12 لفتح اللوحة")
        ارجع هذا
    نهاية

    دالة أوقف()
        هذا._فعال = خطأ
        ارجع هذا
    نهاية

    دالة مفعّل()
        ارجع هذا._فعال
    نهاية

    # ─── تحديد عنصر ───
    دالة حدد(عنصر)
        هذا._عنصر_محدد = عنصر
        هذا._أظهر_معلومات(عنصر)
        ارجع هذا
    نهاية

    # ─── إظهار حدود العناصر ───
    دالة أظهر_الحدود(قيمة = صحيح)
        هذا._إظهار_حدود = قيمة
        ارجع هذا
    نهاية

    # ─── إظهار الأبعاد ───
    دالة أظهر_الأبعاد(قيمة = صحيح)
        هذا._إظهار_أبعاد = قيمة
        ارجع هذا
    نهاية

    # ─── الحصول على شجرة العناصر ───
    دالة شجرة_العناصر()
        ارجع هذا._شجرة_العناصر
    نهاية

    # ─── تحديث الشجرة ───
    دالة حدّث_الشجرة(جذر)
        هذا._شجرة_العناصر = هذا._بناء_شجرة(جذر, 0)
        ارجع هذا
    نهاية

    # ─── بناء تمثيل الشجرة ───
    دالة _بناء_شجرة(عنصر, مستوى)
        متغير عقدة = {
            "نوع": عنصر.النوع(),
            "معرف": عنصر.المعرف(),
            "خصائص": عنصر.الخصائص(),
            "أبعاد": هذا._احصل_أبعاد(عنصر),
            "مستوى": مستوى,
            "أبناء": []
        }
        
        لكل ابن في عنصر.الأبناء()
            عقدة["أبناء"] = عقدة["أبناء"] + [هذا._بناء_شجرة(ابن, مستوى + 1)]
        نهاية
        
        ارجع عقدة
    نهاية

    # ─── الحصول على الأبعاد ───
    دالة _احصل_أبعاد(عنصر)
        ارجع {
            "س": عنصر.احصل("س"),
            "ص": عنصر.احصل("ص"),
            "عرض": عنصر.احصل("عرض"),
            "ارتفاع": عنصر.احصل("ارتفاع")
        }
    نهاية

    # ─── إظهار معلومات العنصر ───
    دالة _أظهر_معلومات(عنصر)
        اطبع_سطر("═══════════════════════════════════")
        اطبع_سطر("📦 العنصر: " + عنصر.النوع())
        اطبع_سطر("───────────────────────────────────")
        
        لكل مفتاح, قيمة في عنصر.الخصائص()
            اطبع_سطر("  " + مفتاح + ": " + نص(قيمة))
        نهاية
        
        اطبع_سطر("═══════════════════════════════════")
    نهاية
نهاية

# ─── مراقب_الأداء (Performance Monitor) ───
صدّر صنف مراقب_الأداء
    باني()
        هذا._قياسات = []
        هذا._إطارات = []
        هذا._فعال = خطأ
        هذا._حد_إطارات = 120
    نهاية

    دالة ابدأ()
        هذا._فعال = صحيح
        ارجع هذا
    نهاية

    دالة أوقف()
        هذا._فعال = خطأ
        ارجع هذا
    نهاية

    # ─── تسجيل إطار ───
    دالة سجّل_إطار(وقت_البداية, وقت_النهاية)
        إذا (ليس هذا._فعال)
            ارجع
        نهاية
        
        متغير مدة = وقت_النهاية - وقت_البداية
        هذا._إطارات = هذا._إطارات + [{
            "بداية": وقت_البداية,
            "مدة": مدة,
            "fps": 1000 / مدة
        }]
        
        # الاحتفاظ بآخر N إطار فقط
        إذا (طول(هذا._إطارات) > هذا._حد_إطارات)
            هذا._إطارات = هذا._إطارات[1..]
        نهاية
    نهاية

    # ─── بدء قياس ───
    دالة ابدأ_قياس(اسم)
        هذا._قياسات = هذا._قياسات + [{
            "اسم": اسم,
            "بداية": وقت_الآن(),
            "نهاية": 0
        }]
        ارجع طول(هذا._قياسات) - 1
    نهاية

    # ─── إنهاء قياس ───
    دالة أنهِ_قياس(معرف)
        إذا (معرف < طول(هذا._قياسات))
            هذا._قياسات[معرف]["نهاية"] = وقت_الآن()
        نهاية
    نهاية

    # ─── متوسط FPS ───
    دالة متوسط_الإطارات()
        إذا (طول(هذا._إطارات) == 0)
            ارجع 0
        نهاية
        
        متغير مجموع = 0
        لكل إطار في هذا._إطارات
            مجموع = مجموع + إطار["fps"]
        نهاية
        
        ارجع مجموع / طول(هذا._إطارات)
    نهاية

    # ─── تقرير الأداء ───
    دالة تقرير()
        اطبع_سطر("═══════════════════════════════════")
        اطبع_سطر("📊 تقرير الأداء")
        اطبع_سطر("───────────────────────────────────")
        اطبع_سطر("  متوسط FPS: " + نص(هذا.متوسط_الإطارات()))
        اطبع_سطر("  عدد الإطارات المسجلة: " + نص(طول(هذا._إطارات)))
        
        لكل قياس في هذا._قياسات
            إذا (قياس["نهاية"] > 0)
                متغير مدة = قياس["نهاية"] - قياس["بداية"]
                اطبع_سطر("  ⏱ " + قياس["اسم"] + ": " + نص(مدة) + " مللي ثانية")
            نهاية
        نهاية
        
        اطبع_سطر("═══════════════════════════════════")
    نهاية
نهاية

# ─── مسجّل_الأحداث (Event Logger) ───
صدّر صنف مسجّل_الأحداث
    باني()
        هذا._سجل = []
        هذا._حد_السجل = 1000
        هذا._مستويات = ["تصحيح", "معلومات", "تحذير", "خطأ"]
        هذا._مستوى_أدنى = 0  # تسجيل كل شيء
    نهاية

    دالة عيّن_مستوى(مستوى)
        هذا._مستوى_أدنى = مستوى
        ارجع هذا
    نهاية

    دالة تصحيح(رسالة, بيانات = لاشيء)
        هذا._سجّل(0, رسالة, بيانات)
    نهاية

    دالة معلومات(رسالة, بيانات = لاشيء)
        هذا._سجّل(1, رسالة, بيانات)
    نهاية

    دالة تحذير(رسالة, بيانات = لاشيء)
        هذا._سجّل(2, رسالة, بيانات)
    نهاية

    دالة خطأ(رسالة, بيانات = لاشيء)
        هذا._سجّل(3, رسالة, بيانات)
    نهاية

    دالة _سجّل(مستوى, رسالة, بيانات)
        إذا (مستوى < هذا._مستوى_أدنى)
            ارجع
        نهاية
        
        متغير إدخال = {
            "وقت": وقت_الآن(),
            "مستوى": هذا._مستويات[مستوى],
            "رسالة": رسالة,
            "بيانات": بيانات
        }
        
        هذا._سجل = هذا._سجل + [إدخال]
        
        # طباعة مباشرة
        متغير رمز = ["🔧", "ℹ️", "⚠️", "❌"][مستوى]
        اطبع_سطر(رمز + " [" + هذا._مستويات[مستوى] + "] " + رسالة)
        
        # حذف القديم
        إذا (طول(هذا._سجل) > هذا._حد_السجل)
            هذا._سجل = هذا._سجل[1..]
        نهاية
    نهاية

    دالة السجل()
        ارجع هذا._سجل
    نهاية

    دالة امسح()
        هذا._سجل = []
        ارجع هذا
    نهاية
نهاية

