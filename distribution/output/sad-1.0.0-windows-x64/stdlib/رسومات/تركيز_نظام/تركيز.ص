# ===================================================================
# Focus Management — إدارة التركيز
# ===================================================================
# مطابق لـ Flutter FocusNode, FocusScope, FocusManager
# دعم كامل للتنقل بالتركيز والمفاتيح
#
# الاستخدام:
#   استورد * من رسومات.تركيز_نظام.تركيز
#
#   متغير عقدة = عقدة_تركيز()
#   تركيز(
#       عقدة: عقدة,
#       عند_التركيز: دالة(له_تركيز)
#           اطبع_سطر("التركيز: " + له_تركيز)
#       نهاية,
#       ابن: حقل_نص()
#   )
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    عقدة_تركيز (FocusNode)
# ===================================================================
صدّر صنف عقدة_تركيز
    باني(علامة_تصحيح = لاشيء, قابل_للتركيز = صحيح,
         تخطي_السير = خطأ, دلالات_هروب = خطأ)
        هذا._علامة_تصحيح = علامة_تصحيح
        هذا._قابل_للتركيز = قابل_للتركيز
        هذا._تخطي_السير = تخطي_السير
        هذا._دلالات_هروب = دلالات_هروب
        هذا._له_تركيز = خطأ
        هذا._له_تركيز_أولي = خطأ
        هذا._أب = لاشيء
        هذا._أبناء = []
        هذا._مستمعون = []
        هذا._عند_المفتاح = لاشيء
    نهاية

    # ─── خصائص التركيز ───
    دالة له_تركيز()
        ارجع هذا._له_تركيز
    نهاية

    دالة له_تركيز_أولي()
        ارجع هذا._له_تركيز_أولي
    نهاية

    دالة قابل_للتركيز()
        ارجع هذا._قابل_للتركيز
    نهاية

    # ─── طلب التركيز ───
    دالة اطلب_التركيز()
        إذا (ليس هذا._قابل_للتركيز)
            ارجع
        نهاية
        
        # إزالة التركيز من العقدة الحالية
        إذا (مدير_التركيز._عقدة_الحالية != لاشيء)
            مدير_التركيز._عقدة_الحالية._فقد_التركيز()
        نهاية
        
        هذا._له_تركيز = صحيح
        هذا._له_تركيز_أولي = صحيح
        مدير_التركيز._عقدة_الحالية = هذا
        هذا._أخطر()
    نهاية

    # ─── إلغاء التركيز ───
    دالة ألغِ_التركيز(التالية = لاشيء)
        إذا (هذا._له_تركيز)
            هذا._فقد_التركيز()
            إذا (التالية != لاشيء)
                التالية.اطلب_التركيز()
            نهاية
        نهاية
    نهاية

    دالة _فقد_التركيز()
        هذا._له_تركيز = خطأ
        هذا._له_تركيز_أولي = خطأ
        هذا._أخطر()
    نهاية

    # ─── التنقل ───
    دالة التالي()
        إذا (هذا._أب != لاشيء)
            متغير فهرس = هذا._أب._ابحث_عن_ابن(هذا)
            إذا (فهرس >= 0 و فهرس < هذا._أب._أبناء.حجم() - 1)
                هذا._أب._أبناء[فهرس + 1].اطلب_التركيز()
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    دالة السابق()
        إذا (هذا._أب != لاشيء)
            متغير فهرس = هذا._أب._ابحث_عن_ابن(هذا)
            إذا (فهرس > 0)
                هذا._أب._أبناء[فهرس - 1].اطلب_التركيز()
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    # ─── الشجرة ───
    دالة عيّن_الأب(أب)
        هذا._أب = أب
    نهاية

    دالة الأب()
        ارجع هذا._أب
    نهاية

    دالة أضف_ابن(عقدة)
        هذا._أبناء.أضف(عقدة)
        عقدة.عيّن_الأب(هذا)
    نهاية

    دالة أزل_ابن(عقدة)
        متغير جديدة = []
        لكل ع في هذا._أبناء
            إذا (ع != عقدة)
                جديدة.أضف(ع)
            نهاية
        نهاية
        هذا._أبناء = جديدة
        عقدة.عيّن_الأب(لاشيء)
    نهاية

    دالة _ابحث_عن_ابن(عقدة)
        متغير ف = 0
        لكل ع في هذا._أبناء
            إذا (ع == عقدة)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    # ─── المستمعون ───
    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة أزل_مستمع(مستمع)
        متغير جديدة = []
        لكل م في هذا._مستمعون
            إذا (م != مستمع)
                جديدة.أضف(م)
            نهاية
        نهاية
        هذا._مستمعون = جديدة
    نهاية

    دالة _أخطر()
        لكل مستمع في هذا._مستمعون
            مستمع()
        نهاية
    نهاية

    # ─── معالجة المفاتيح ───
    دالة عيّن_معالج_مفاتيح(معالج)
        هذا._عند_المفتاح = معالج
    نهاية

    دالة عالج_مفتاح(حدث)
        إذا (هذا._عند_المفتاح != لاشيء)
            ارجع هذا._عند_المفتاح(حدث)
        نهاية
        ارجع خطأ
    نهاية

    # ─── التخلص ───
    دالة تخلص()
        إذا (هذا._أب != لاشيء)
            هذا._أب.أزل_ابن(هذا)
        نهاية
        إذا (هذا._له_تركيز)
            مدير_التركيز._عقدة_الحالية = لاشيء
        نهاية
        هذا._مستمعون = []
    نهاية
نهاية

# ===================================================================
#                    عقدة_نطاق_تركيز (FocusScopeNode)
# ===================================================================
صدّر صنف عقدة_نطاق_تركيز يرث عقدة_تركيز
    باني(علامة_تصحيح = لاشيء)
        الأساس.باني(علامة_تصحيح, صحيح, خطأ, خطأ)
        هذا._العقدة_المركزة = لاشيء
    نهاية

    دالة العقدة_المركزة()
        ارجع هذا._العقدة_المركزة
    نهاية

    دالة عيّن_العقدة_المركزة(عقدة)
        هذا._العقدة_المركزة = عقدة
    نهاية

    دالة ركز_أول_ابن()
        إذا (هذا._أبناء.حجم() > 0)
            هذا._أبناء[0].اطلب_التركيز()
        نهاية
    نهاية

    دالة ركز_آخر_ابن()
        إذا (هذا._أبناء.حجم() > 0)
            هذا._أبناء[هذا._أبناء.حجم() - 1].اطلب_التركيز()
        نهاية
    نهاية
نهاية

# ===================================================================
#                    مدير_التركيز (FocusManager) - Singleton
# ===================================================================
صدّر صنف مدير_التركيز
    ساكن متغير _مثيل = لاشيء
    ساكن متغير _عقدة_الحالية = لاشيء

    باني()
        هذا._جذر = عقدة_نطاق_تركيز(علامة_تصحيح: "الجذر")
    نهاية

    ساكن دالة المثيل()
        إذا (مدير_التركيز._مثيل == لاشيء)
            مدير_التركيز._مثيل = مدير_التركيز()
        نهاية
        ارجع مدير_التركيز._مثيل
    نهاية

    ساكن دالة العقدة_الحالية()
        ارجع مدير_التركيز._عقدة_الحالية
    نهاية

    دالة الجذر()
        ارجع هذا._جذر
    نهاية

    # نقل التركيز للاتجاه المحدد
    ساكن دالة انقل_التركيز_باتجاه(اتجاه)
        إذا (مدير_التركيز._عقدة_الحالية == لاشيء)
            ارجع خطأ
        نهاية
        
        طابق (اتجاه)
            عندما "التالي":
                ارجع مدير_التركيز._عقدة_الحالية.التالي()
            عندما "السابق":
                ارجع مدير_التركيز._عقدة_الحالية.السابق()
            افتراضي:
                ارجع خطأ
        نهاية
    نهاية
نهاية

# ===================================================================
#                    تركيز (Focus Widget)
# ===================================================================
صدّر صنف تركيز يرث عنصر
    باني(عقدة = لاشيء, عند_التركيز = لاشيء, عند_المفتاح = لاشيء,
         تركيز_تلقائي = خطأ, تخطي_السير = خطأ, ابن = لاشيء,
         قابل_للتركيز = صحيح, شامل_دلالات = صحيح)
        هذا._نوع = "تركيز"
        هذا._ابن = ابن
        هذا._خصائص = {}
        
        إذا (عقدة == لاشيء)
            عقدة = عقدة_تركيز(قابل_للتركيز: قابل_للتركيز, تخطي_السير: تخطي_السير)
        نهاية
        
        هذا._خصائص["عقدة"] = عقدة
        هذا._خصائص["عند_التركيز"] = عند_التركيز
        هذا._خصائص["عند_المفتاح"] = عند_المفتاح
        هذا._خصائص["تركيز_تلقائي"] = تركيز_تلقائي
        هذا._خصائص["شامل_دلالات"] = شامل_دلالات
        
        # ربط المستمعين
        إذا (عند_التركيز != لاشيء)
            عقدة.أضف_مستمع(دالة()
                عند_التركيز(عقدة.له_تركيز())
            نهاية)
        نهاية
        
        إذا (عند_المفتاح != لاشيء)
            عقدة.عيّن_معالج_مفاتيح(عند_المفتاح)
        نهاية
    نهاية

    دالة العقدة()
        ارجع هذا._خصائص["عقدة"]
    نهاية
نهاية

# ===================================================================
#                    نطاق_تركيز (FocusScope Widget)
# ===================================================================
صدّر صنف نطاق_تركيز يرث عنصر
    باني(عقدة = لاشيء, تركيز_تلقائي = خطأ, ابن = لاشيء)
        هذا._نوع = "نطاق_تركيز"
        هذا._ابن = ابن
        هذا._خصائص = {}
        
        إذا (عقدة == لاشيء)
            عقدة = عقدة_نطاق_تركيز()
        نهاية
        
        هذا._خصائص["عقدة"] = عقدة
        هذا._خصائص["تركيز_تلقائي"] = تركيز_تلقائي
    نهاية

    دالة العقدة()
        ارجع هذا._خصائص["عقدة"]
    نهاية

    ساكن دالة من(سياق)
        # البحث عن أقرب نطاق تركيز
        ارجع لاشيء
    نهاية
نهاية

# ===================================================================
#                    سير_تركيز (FocusTraversalGroup)
# ===================================================================
صدّر صنف سير_تركيز يرث عنصر
    باني(سياسة = لاشيء, تنازلي = صحيح, ابن = لاشيء)
        هذا._نوع = "سير_تركيز"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["سياسة"] = سياسة
        هذا._خصائص["تنازلي"] = تنازلي
    نهاية
نهاية

# ===================================================================
#                    سياسات السير (Traversal Policies)
# ===================================================================
صدّر صنف سياسة_سير_ترتيب
    باني()
        # السير بترتيب التعريف
    نهاية

    دالة التالي(عقدة_حالية, عقد)
        متغير فهرس = هذا._ابحث(عقدة_حالية, عقد)
        إذا (فهرس >= 0 و فهرس < عقد.حجم() - 1)
            ارجع عقد[فهرس + 1]
        نهاية
        ارجع لاشيء
    نهاية

    دالة السابق(عقدة_حالية, عقد)
        متغير فهرس = هذا._ابحث(عقدة_حالية, عقد)
        إذا (فهرس > 0)
            ارجع عقد[فهرس - 1]
        نهاية
        ارجع لاشيء
    نهاية

    دالة _ابحث(عقدة, عقد)
        متغير ف = 0
        لكل ع في عقد
            إذا (ع == عقدة)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية
نهاية

صدّر صنف سياسة_سير_قراءة
    باني()
        # السير بترتيب القراءة (يسار لليمين، أعلى لأسفل)
    نهاية

    # نفس واجهة سياسة_سير_ترتيب
نهاية

صدّر صنف سياسة_سير_اتجاهية
    باني()
        # السير بالاتجاهات (أعلى، أسفل، يسار، يمين)
    نهاية

    دالة أعلى(عقدة_حالية, عقد)
        # ابحث عن أقرب عقدة للأعلى
        ارجع لاشيء
    نهاية

    دالة أسفل(عقدة_حالية, عقد)
        # ابحث عن أقرب عقدة للأسفل
        ارجع لاشيء
    نهاية

    دالة يسار(عقدة_حالية, عقد)
        # ابحث عن أقرب عقدة لليسار
        ارجع لاشيء
    نهاية

    دالة يمين(عقدة_حالية, عقد)
        # ابحث عن أقرب عقدة لليمين
        ارجع لاشيء
    نهاية
نهاية

# ===================================================================
#                    اختصارات (Shortcuts)
# ===================================================================
صدّر صنف اختصار
    باني(مفتاح, تحكم = خطأ, بديل = خطأ, إزاحة = خطأ, ميتا = خطأ)
        هذا._مفتاح = مفتاح
        هذا._تحكم = تحكم
        هذا._بديل = بديل
        هذا._إزاحة = إزاحة
        هذا._ميتا = ميتا
    نهاية

    دالة يطابق(حدث)
        ارجع حدث["مفتاح"] == هذا._مفتاح و
               حدث["تحكم"] == هذا._تحكم و
               حدث["بديل"] == هذا._بديل و
               حدث["إزاحة"] == هذا._إزاحة و
               حدث["ميتا"] == هذا._ميتا
    نهاية
نهاية

صدّر صنف اختصارات يرث عنصر
    باني(اختصارات = {}, ابن = لاشيء)
        هذا._نوع = "اختصارات"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["اختصارات"] = اختصارات
    نهاية
نهاية

صدّر صنف إجراءات يرث عنصر
    باني(إجراءات = {}, ابن = لاشيء)
        هذا._نوع = "إجراءات"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["إجراءات"] = إجراءات
    نهاية
نهاية

# ===================================================================
#                    دوال مساعدة
# ===================================================================

# طلب التركيز للعنصر
صدّر دالة ركّز(عقدة)
    عقدة.اطلب_التركيز()
نهاية

# إلغاء كل التركيز
صدّر دالة ألغِ_التركيز()
    إذا (مدير_التركيز._عقدة_الحالية != لاشيء)
        مدير_التركيز._عقدة_الحالية._فقد_التركيز()
        مدير_التركيز._عقدة_الحالية = لاشيء
    نهاية
نهاية

# التحقق من التركيز
صدّر دالة له_تركيز(عقدة)
    ارجع عقدة.له_تركيز()
نهاية
