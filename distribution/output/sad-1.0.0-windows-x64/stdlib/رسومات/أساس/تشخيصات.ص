# ─── شجرة_تشخيص (DiagnosticsNode) ───
صدّر صنف عقدة_تشخيص
    باني(اسم = "", قيمة = لاشيء)
        هذا._اسم = اسم
        هذا._قيمة = قيمة
        هذا._أبناء = []
        هذا._مستوى = "معلومات"
    نهاية

    دالة الاسم()
        ارجع هذا._اسم
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة أضف_ابن(عقدة)
        هذا._أبناء = هذا._أبناء + [عقدة]
        ارجع هذا
    نهاية

    دالة إلى_نص(بادئة = "")
        متغير نتيجة = بادئة + هذا._اسم
        إذا (هذا._قيمة != لاشيء)
            نتيجة = نتيجة + ": " + هذا._قيمة
        نهاية
        لكل ابن في هذا._أبناء
            نتيجة = نتيجة + "\n" + ابن.إلى_نص(بادئة + "  ")
        نهاية
        ارجع نتيجة
    نهاية
نهاية

# ─── قابل_للتشخيص (Diagnosticable) ───
صدّر صنف قابل_للتشخيص
    باني()
    نهاية

    دالة بناء_تشخيص()
        ارجع جديد عقدة_تشخيص("كائن")
    نهاية

    دالة إلى_نص_تشخيصي()
        ارجع هذا.بناء_تشخيص().إلى_نص()
    نهاية
نهاية

