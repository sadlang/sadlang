# ─── قابل_للاستماع (Listenable) ───
صدّر صنف قابل_للاستماع
    باني()
        هذا._مستمعون = []
    نهاية

    دالة أضف_مستمع(رد_نداء)
        هذا._مستمعون = هذا._مستمعون + [رد_نداء]
    نهاية

    دالة أزل_مستمع(رد_نداء)
        متغير جديدة = []
        لكل م في هذا._مستمعون
            إذا (م != رد_نداء)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مستمعون = جديدة
    نهاية
نهاية

# ─── مستمع_تغيير (ChangeNotifier) ───
صدّر صنف مستمع_تغيير يرث قابل_للاستماع
    باني()
        هذا._مستمعون = []
        هذا._عدد_المستمعين = 0
        هذا._تم_التنظيف = خطأ
    نهاية

    دالة لديه_مستمعون()
        ارجع هذا._عدد_المستمعين > 0
    نهاية

    دالة أضف_مستمع(رد_نداء)
        هذا._مستمعون = هذا._مستمعون + [رد_نداء]
        هذا._عدد_المستمعين = هذا._عدد_المستمعين + 1
    نهاية

    دالة أزل_مستمع(رد_نداء)
        متغير جديدة = []
        لكل م في هذا._مستمعون
            إذا (م != رد_نداء)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مستمعون = جديدة
        هذا._عدد_المستمعين = هذا._عدد_المستمعين - 1
    نهاية

    دالة أشعر_المستمعين()
        إذا (هذا._تم_التنظيف)
            ارجع لاشيء
        نهاية
        لكل مستمع في هذا._مستمعون
            مستمع()
        نهاية
    نهاية

    دالة تنظيف()
        هذا._تم_التنظيف = صحيح
        هذا._مستمعون = []
        هذا._عدد_المستمعين = 0
    نهاية
نهاية

# ─── قيمة_مراقبة (ValueNotifier) ───
صدّر صنف قيمة_مراقبة يرث مستمع_تغيير
    باني(قيمة)
        هذا._مستمعون = []
        هذا._عدد_المستمعين = 0
        هذا._تم_التنظيف = خطأ
        هذا._قيمة = قيمة
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة عيّن_القيمة(قيمة_جديدة)
        إذا (هذا._قيمة != قيمة_جديدة)
            هذا._قيمة = قيمة_جديدة
            هذا.أشعر_المستمعين()
        نهاية
    نهاية
نهاية

# ─── مستمع_تغيير_مركب (ValueListenableBuilder equivalent) ───
صدّر صنف باني_قيمة_مراقبة
    باني(قيمة_مراقبة_مصدر, باني_دالة)
        هذا._مصدر = قيمة_مراقبة_مصدر
        هذا._باني = باني_دالة
    نهاية

    دالة بناء()
        ارجع هذا._باني(هذا._مصدر.القيمة())
    نهاية
نهاية
