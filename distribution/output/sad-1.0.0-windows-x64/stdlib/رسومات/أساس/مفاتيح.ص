# ─── المفتاح الأساسي ───
صدّر صنف مفتاح
    باني(قيمة)
        هذا._قيمة = قيمة
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة يساوي(آخر)
        إذا (آخر == لاشيء)
            ارجع خطأ
        نهاية
        ارجع هذا._قيمة == آخر._قيمة
    نهاية

    دالة الهاش()
        ارجع هاش(هذا._قيمة)
    نهاية

    دالة الى_نص()
        ارجع "[مفتاح: " + نص(هذا._قيمة) + "]"
    نهاية
نهاية

# ─── مفتاح القيمة (ValueKey) ───
صدّر صنف مفتاح_قيمة يرث مفتاح
    باني(قيمة)
        الأساس(قيمة)
        هذا._نوع_مفتاح = "قيمة"
    نهاية

    دالة يساوي(آخر)
        إذا (آخر == لاشيء أو آخر._نوع_مفتاح != "قيمة")
            ارجع خطأ
        نهاية
        ارجع هذا._قيمة == آخر._قيمة
    نهاية

    دالة الى_نص()
        ارجع "[مفتاح_قيمة: " + نص(هذا._قيمة) + "]"
    نهاية
نهاية

# ─── مفتاح الكائن (ObjectKey) ───
صدّر صنف مفتاح_كائن يرث مفتاح
    باني(كائن)
        الأساس(معرف_الكائن(كائن))
        هذا._كائن = كائن
        هذا._نوع_مفتاح = "كائن"
    نهاية

    دالة يساوي(آخر)
        إذا (آخر == لاشيء أو آخر._نوع_مفتاح != "كائن")
            ارجع خطأ
        نهاية
        # مقارنة هوية الكائن، ليس المحتوى
        ارجع معرف_الكائن(هذا._كائن) == معرف_الكائن(آخر._كائن)
    نهاية

    دالة الى_نص()
        ارجع "[مفتاح_كائن: " + نص(هذا._كائن) + "]"
    نهاية
نهاية

# ─── المفتاح الفريد (UniqueKey) ───
صدّر صنف مفتاح_فريد يرث مفتاح
    ساكن متغير _عداد = 0

    باني()
        مفتاح_فريد._عداد += 1
        الأساس(مفتاح_فريد._عداد)
        هذا._نوع_مفتاح = "فريد"
    نهاية

    دالة يساوي(آخر)
        # المفتاح الفريد يساوي نفسه فقط
        ارجع هذا == آخر
    نهاية

    دالة الى_نص()
        ارجع "[مفتاح_فريد: #" + نص(هذا._قيمة) + "]"
    نهاية
نهاية

# ─── المفتاح العام (GlobalKey) ───
صدّر صنف مفتاح_عام يرث مفتاح
    ساكن متغير _سجل = {}

    باني(تسمية_تصحيح = لاشيء)
        الأساس(لاشيء)
        هذا._تسمية = تسمية_تصحيح
        هذا._نوع_مفتاح = "عام"
        هذا._عنصر_حالي = لاشيء
        هذا._حالة_حالية = لاشيء
    نهاية

    دالة سجّل_عنصر(عنصر)
        هذا._عنصر_حالي = عنصر
        مفتاح_عام._سجل[هذا] = عنصر
    نهاية

    دالة ألغِ_تسجيل()
        مفتاح_عام._سجل.أزل(هذا)
        هذا._عنصر_حالي = لاشيء
    نهاية

    دالة العنصر_الحالي()
        ارجع هذا._عنصر_حالي
    نهاية

    دالة الحالة_الحالية()
        إذا (هذا._عنصر_حالي != لاشيء)
            ارجع هذا._عنصر_حالي.الحالة()
        نهاية
        ارجع لاشيء
    نهاية

    دالة السياق()
        إذا (هذا._عنصر_حالي != لاشيء)
            ارجع هذا._عنصر_حالي.السياق()
        نهاية
        ارجع لاشيء
    نهاية

    دالة الى_نص()
        متغير تسمية = هذا._تسمية أو "بدون_تسمية"
        ارجع "[مفتاح_عام: " + تسمية + "]"
    نهاية
نهاية

# ─── مفتاح عام مع حالة (GlobalKey<State>) ───
صدّر صنف مفتاح_عام_حالة يرث مفتاح_عام
    باني(تسمية_تصحيح = لاشيء)
        الأساس(تسمية_تصحيح)
    نهاية

    # الوصول المباشر للحالة
    دالة الحالة()
        ارجع هذا.الحالة_الحالية()
    نهاية
نهاية

# ─── مفتاح الصفحة (PageStorageKey) ───
صدّر صنف مفتاح_تخزين_صفحة يرث مفتاح_قيمة
    باني(قيمة)
        الأساس(قيمة)
        هذا._نوع_مفتاح = "تخزين_صفحة"
    نهاية
نهاية

# ─── تخزين الصفحة (PageStorage) ───
صدّر صنف تخزين_صفحة
    باني()
        هذا._بيانات = {}
    نهاية

    دالة اكتب(سياق، مفتاح، بيانات)
        متغير مسار = هذا._بناء_مسار(سياق)
        هذا._بيانات[مسار + ":" + نص(مفتاح)] = بيانات
    نهاية

    دالة اقرأ(سياق، مفتاح)
        متغير مسار = هذا._بناء_مسار(سياق)
        ارجع هذا._بيانات[مسار + ":" + نص(مفتاح)]
    نهاية

    دالة _بناء_مسار(سياق)
        متغير مسار = ""
        متغير حالي = سياق
        بينما (حالي != لاشيء)
            متغير مفتاح = حالي.المفتاح()
            إذا (مفتاح != لاشيء و مفتاح._نوع_مفتاح == "تخزين_صفحة")
                مسار = نص(مفتاح.القيمة()) + "/" + مسار
            نهاية
            حالي = حالي.الأب()
        نهاية
        ارجع مسار
    نهاية

    ساكن دالة من(سياق)
        # البحث عن أقرب تخزين صفحة
        متغير حالي = سياق
        بينما (حالي != لاشيء)
            إذا (حالي.النوع() == "دلو_تخزين")
                ارجع حالي.التخزين()
            نهاية
            حالي = حالي.الأب()
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ─── دلو التخزين (PageStorageBucket Widget) ───
صدّر صنف دلو_تخزين
    باني(ابن)
        هذا._نوع = "دلو_تخزين"
        هذا._ابن = ابن
        هذا._تخزين = جديد تخزين_صفحة()
    نهاية

    دالة التخزين()
        ارجع هذا._تخزين
    نهاية
نهاية

# ─── مُولِّد المفاتيح ───
صدّر صنف مُولِّد_مفاتيح
    ساكن دالة من_قائمة(قائمة، استخرج_معرف)
        متغير مفاتيح = []
        لكل عنصر في قائمة
            مفاتيح.أضف(جديد مفتاح_قيمة(استخرج_معرف(عنصر)))
        نهاية
        ارجع مفاتيح
    نهاية

    ساكن دالة فريدة(عدد)
        متغير مفاتيح = []
        لكل ف من 0 الى عدد
            مفاتيح.أضف(جديد مفتاح_فريد())
        نهاية
        ارجع مفاتيح
    نهاية
نهاية

# ─── مساعدات ───
دالة معرف_الكائن(كائن)
    # الحصول على ID فريد للكائن في الذاكرة
    ارجع _هوية_كائن(كائن)
نهاية

دالة هاش(قيمة)
    # حساب هاش للقيمة
    إذا (قيمة == لاشيء)
        ارجع 0
    نهاية
    ارجع _هاش_قيمة(قيمة)
نهاية
