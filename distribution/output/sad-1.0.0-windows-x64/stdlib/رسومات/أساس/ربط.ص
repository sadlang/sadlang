# ─── ربط_عناصر (WidgetsBinding) ───
صدّر صنف ربط_عناصر
    باني()
        هذا._مهيأ = خطأ
        هذا._مراقبون = []
        هذا._لغة = "ar"
        هذا._اتجاه_النص = "يمين_لذيسار"
    نهاية

    دالة هيّئ()
        هذا._مهيأ = صحيح
        ارجع هذا
    نهاية

    دالة تأكد_التهيئة()
        إذا (ليس هذا._مهيأ)
            هذا.هيّئ()
        نهاية
        ارجع هذا
    نهاية

    دالة أضف_مراقب(مراقب)
        هذا._مراقبون = هذا._مراقبون + [مراقب]
    نهاية

    دالة أزل_مراقب(مراقب)
        متغير جديدة = []
        لكل م في هذا._مراقبون
            إذا (م != مراقب)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مراقبون = جديدة
    نهاية
نهاية

