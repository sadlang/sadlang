# العيب #101: FormField - حقل النموذج
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف حقل_نموذج
    باني(إعدادات)
        هذا._باني = إعدادات.باني أو لاشيء
        هذا._محقق = إعدادات.محقق أو لاشيء
        هذا._عند_الحفظ = إعدادات.عند_الحفظ أو لاشيء
        هذا._قيمة_ابتدائية = إعدادات.قيمة_ابتدائية أو لاشيء
        هذا._مفتاح = إعدادات.مفتاح أو لاشيء
        هذا._تلقائي_تحقق = إعدادات.تلقائي_تحقق أو خطأ
        
        هذا._قيمة = هذا._قيمة_ابتدائية
        هذا._خطأ = لاشيء
        هذا._لُمس = خطأ
    نهاية

    دالة تحقق()
        إذا (هذا._محقق)
            هذا._خطأ = هذا._محقق(هذا._قيمة)
            ارجع هذا._خطأ == لاشيء
        نهاية
        ارجع صحيح
    نهاية

    دالة عيّن_قيمة(قيمة)
        هذا._قيمة = قيمة
        هذا._لُمس = صحيح
        
        إذا (هذا._تلقائي_تحقق)
            هذا.تحقق()
        نهاية
    نهاية

    دالة احصل_قيمة()
        ارجع هذا._قيمة
    نهاية

    دالة احصل_خطأ()
        ارجع هذا._خطأ
    نهاية

    دالة صالح؟()
        ارجع هذا._خطأ == لاشيء
    نهاية

    دالة إعادة_تعيين()
        هذا._قيمة = هذا._قيمة_ابتدائية
        هذا._خطأ = لاشيء
        هذا._لُمس = خطأ
    نهاية

    دالة احفظ()
        إذا (هذا._عند_الحفظ و هذا.تحقق())
            هذا._عند_الحفظ(هذا._قيمة)
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية
نهاية

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# العيب #102: Form - نموذج
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف نموذج
    باني(إعدادات)
        هذا._مفتاح = إعدادات.مفتاح أو لاشيء
        هذا._ابن = إعدادات.ابن أو لاشيء
        هذا._عند_التغيير = إعدادات.عند_التغيير أو لاشيء
        هذا._تلقائي_تحقق = إعدادات.تلقائي_تحقق أو خطأ
        
        هذا._حقول = []
    نهاية

    دالة سجّل_حقل(حقل)
        هذا._حقول.أضف(حقل)
    نهاية

    دالة ألغِ_تسجيل_حقل(حقل)
        هذا._حقول = هذا._حقول.فلتر(لامدا(ح) => ح != حقل نهاية)
    نهاية

    دالة تحقق()
        متغير صالح = صحيح
        لكل حقل في هذا._حقول
            إذا (ليس حقل.تحقق())
                صالح = خطأ
            نهاية
        نهاية
        ارجع صالح
    نهاية

    دالة احفظ()
        إذا (هذا.تحقق())
            لكل حقل في هذا._حقول
                حقل.احفظ()
            نهاية
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة إعادة_تعيين()
        لكل حقل في هذا._حقول
            حقل.إعادة_تعيين()
        نهاية
    نهاية

    دالة احصل_قيم()
        متغير قيم = {}
        لكل حقل في هذا._حقول
            إذا (حقل._مفتاح)
                قيم[حقل._مفتاح] = حقل.احصل_قيمة()
            نهاية
        نهاية
        ارجع قيم
    نهاية
نهاية

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# العيب #103: Validator - محقق
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف محققات
    # حقل مطلوب
    ساكن دالة مطلوب(رسالة)
        ارجع لامدا(قيمة) =>
            إذا (قيمة == لاشيء أو قيمة == "")
                ارجع رسالة أو "هذا الحقل مطلوب"
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # الحد الأدنى للطول
    ساكن دالة حد_أدنى(طول، رسالة)
        ارجع لامدا(قيمة) =>
            إذا (قيمة و قيمة.الطول() < طول)
                ارجع رسالة أو "يجب أن لا يقل عن " + طول + " حرف"
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # الحد الأقصى للطول
    ساكن دالة حد_أقصى(طول، رسالة)
        ارجع لامدا(قيمة) =>
            إذا (قيمة و قيمة.الطول() > طول)
                ارجع رسالة أو "يجب أن لا يزيد عن " + طول + " حرف"
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # بريد إلكتروني
    ساكن دالة بريد_إلكتروني(رسالة)
        ارجع لامدا(قيمة) =>
            إذا (قيمة و ليس قيمة.يطابق(/^[^\s@]+@[^\s@]+\.[^\s@]+$/))
                ارجع رسالة أو "بريد إلكتروني غير صحيح"
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # رقم هاتف
    ساكن دالة هاتف(رسالة)
        ارجع لامدا(قيمة) =>
            إذا (قيمة و ليس قيمة.يطابق(/^[\d\s\+\-\(\)]+$/))
                ارجع رسالة أو "رقم هاتف غير صحيح"
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # نمط مخصص
    ساكن دالة نمط(تعبير، رسالة)
        ارجع لامدا(قيمة) =>
            إذا (قيمة و ليس قيمة.يطابق(تعبير))
                ارجع رسالة أو "قيمة غير صحيحة"
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # نطاق أرقام
    ساكن دالة نطاق(حد_أدنى، حد_أقصى، رسالة)
        ارجع لامدا(قيمة) =>
            متغير رقم = عدد(قيمة)
            إذا (رقم < حد_أدنى أو رقم > حد_أقصى)
                ارجع رسالة أو "يجب أن تكون القيمة بين " + حد_أدنى + " و " + حد_أقصى
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # تطابق
    ساكن دالة يطابق(حقل_آخر، رسالة)
        ارجع لامدا(قيمة) =>
            إذا (قيمة != حقل_آخر.احصل_قيمة())
                ارجع رسالة أو "القيمتان غير متطابقتان"
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # دمج محققات
    ساكن دالة ادمج(محققات)
        ارجع لامدا(قيمة) =>
            لكل محقق في محققات
                متغير نتيجة = محقق(قيمة)
                إذا (نتيجة != لاشيء)
                    ارجع نتيجة
                نهاية
            نهاية
            ارجع لاشيء
        نهاية
    نهاية
نهاية

