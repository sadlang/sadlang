# #110: AutocompleteFormField
صدّر صنف حقل_إكمال_نموذج يرث حقل_نموذج
    باني(إعدادات)
        الأساس(إعدادات)
        هذا._اقتراحات = إعدادات.اقتراحات أو []
        هذا._باني_اقتراحات = إعدادات.باني_اقتراحات أو لاشيء
        هذا._أقصى_اقتراحات = إعدادات.أقصى أو 5
    نهاية

    دالة احصل_اقتراحات(نص)
        إذا (هذا._باني_اقتراحات)
            ارجع هذا._باني_اقتراحات(نص)
        نهاية
        
        # فلترة الاقتراحات
        ارجع هذا._اقتراحات
            .فلتر(لامدا(أ) => أ.يحتوي_على(نص) نهاية)
            .قطع(0، هذا._أقصى_اقتراحات)
    نهاية

    دالة بناء()
        ارجع {
            نوع: "حقل_إكمال_نموذج"،
            قيمة: هذا._قيمة،
            اقتراحات: هذا.احصل_اقتراحات(هذا._قيمة أو "")،
            خطأ: هذا._خطأ
        }
    نهاية
نهاية
