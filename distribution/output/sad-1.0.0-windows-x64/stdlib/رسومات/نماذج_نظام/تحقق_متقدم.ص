# #108: FileFormField
صدّر صنف حقل_ملف_نموذج يرث حقل_نموذج
    باني(إعدادات)
        الأساس(إعدادات)
        هذا._أنواع_مسموحة = إعدادات.أنواع أو []
        هذا._أقصى_حجم = إعدادات.أقصى_حجم أو لاشيء
        هذا._متعدد = إعدادات.متعدد أو خطأ
    نهاية

    دالة تحقق()
        إذا (هذا._قيمة == لاشيء)
            ارجع الأساس.تحقق()
        نهاية
        
        # تحقق من النوع
        إذا (هذا._أنواع_مسموحة.الطول() > 0)
            متغير نوع = هذا._قيمة.نوع
            إذا (ليس هذا._أنواع_مسموحة.يحتوي(نوع))
                هذا._خطأ = "نوع الملف غير مسموح"
                ارجع خطأ
            نهاية
        نهاية
        
        # تحقق من الحجم
        إذا (هذا._أقصى_حجم و هذا._قيمة.حجم > هذا._أقصى_حجم)
            هذا._خطأ = "حجم الملف كبير جداً"
            ارجع خطأ
        نهاية
        
        ارجع الأساس.تحقق()
    نهاية
نهاية

