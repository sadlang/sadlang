# ===================================================================
# Form Validation — نظام التحقق من النماذج
# ===================================================================
# مطابق لـ Flutter Form, TextFormField, FormState
# دعم كامل للتحقق والرسائل والحالات
#
# الاستخدام:
#   استورد * من رسومات.نماذج_نظام.تحقق
#
#   نموذج(
#       مفتاح: _مفتاح_نموذج,
#       ابن: حقل_نموذج_نص(
#           متحقق: دالة(قيمة)
#               إذا (قيمة.فارغ())
#                   ارجع "هذا الحقل مطلوب"
#               نهاية
#               ارجع لاشيء
#           نهاية
#       )
#   )
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    حالة_نموذج (FormState)
# ===================================================================
صدّر صنف حالة_نموذج
    باني()
        هذا._حقول = []
        هذا._صالح = صحيح
        هذا._أخطاء = {}
    نهاية

    # تحقق من جميع الحقول
    دالة تحقق()
        هذا._صالح = صحيح
        هذا._أخطاء = {}
        
        لكل حقل في هذا._حقول
            متغير نتيجة = حقل.تحقق()
            إذا (نتيجة != لاشيء)
                هذا._صالح = خطأ
                هذا._أخطاء[حقل.الاسم()] = نتيجة
            نهاية
        نهاية
        
        ارجع هذا._صالح
    نهاية

    # حفظ جميع الحقول
    دالة احفظ()
        لكل حقل في هذا._حقول
            حقل.احفظ()
        نهاية
    نهاية

    # إعادة تعيين جميع الحقول
    دالة أعد_تعيين()
        لكل حقل في هذا._حقول
            حقل.أعد_تعيين()
        نهاية
        هذا._أخطاء = {}
        هذا._صالح = صحيح
    نهاية

    # تسجيل حقل
    دالة سجّل(حقل)
        هذا._حقول.أضف(حقل)
    نهاية

    # إلغاء تسجيل حقل
    دالة ألغِ_تسجيل(حقل)
        # إزالة الحقل
        متغير جديدة = []
        لكل ح في هذا._حقول
            إذا (ح != حقل)
                جديدة.أضف(ح)
            نهاية
        نهاية
        هذا._حقول = جديدة
    نهاية

    # الحصول على الأخطاء
    دالة الأخطاء()
        ارجع هذا._أخطاء
    نهاية

    دالة صالح()
        ارجع هذا._صالح
    نهاية
نهاية

# ===================================================================
#                    نموذج (Form)
# ===================================================================
صدّر صنف نموذج يرث عنصر
    باني(ابن = لاشيء, مفتاح = لاشيء, تحقق_تلقائي = "معطل",
         عند_التغيير = لاشيء)
        هذا._نوع = "نموذج"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["مفتاح"] = مفتاح
        هذا._خصائص["تحقق_تلقائي"] = تحقق_تلقائي
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._حالة = حالة_نموذج()
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية
نهاية

# ===================================================================
#                    حقل_نموذج_نص (TextFormField)
# ===================================================================
صدّر صنف حقل_نموذج_نص يرث عنصر
    باني(اسم = "", قيمة_أولية = "", متحقق = لاشيء,
         عند_الحفظ = لاشيء, عند_التغيير = لاشيء,
         تسمية = لاشيء, تلميح = لاشيء, بادئة = لاشيء, لاحقة = لاشيء,
         معطل = خطأ, للقراءة_فقط = خطأ, مخفي = خطأ,
         نوع_لوحة = "نص", حد_أقصى = لاشيء, حد_أدنى = لاشيء,
         نمط_نص = لاشيء, نمط_خطأ = لاشيء)
        هذا._نوع = "حقل_نموذج_نص"
        هذا._خصائص = {}
        هذا._اسم = اسم
        هذا._قيمة = قيمة_أولية
        هذا._قيمة_أولية = قيمة_أولية
        هذا._متحقق = متحقق
        هذا._خصائص["عند_الحفظ"] = عند_الحفظ
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["تلميح"] = تلميح
        هذا._خصائص["بادئة"] = بادئة
        هذا._خصائص["لاحقة"] = لاحقة
        هذا._خصائص["معطل"] = معطل
        هذا._خصائص["للقراءة_فقط"] = للقراءة_فقط
        هذا._خصائص["مخفي"] = مخفي
        هذا._خصائص["نوع_لوحة"] = نوع_لوحة
        هذا._خصائص["حد_أقصى"] = حد_أقصى
        هذا._خصائص["حد_أدنى"] = حد_أدنى
        هذا._خصائص["نمط_نص"] = نمط_نص
        هذا._خصائص["نمط_خطأ"] = نمط_خطأ
        هذا._خطأ = لاشيء
    نهاية

    دالة الاسم()
        ارجع هذا._اسم
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة عيّن_القيمة(قيمة)
        هذا._قيمة = قيمة
        ارجع هذا
    نهاية

    دالة تحقق()
        إذا (هذا._متحقق != لاشيء)
            هذا._خطأ = هذا._متحقق(هذا._قيمة)
            ارجع هذا._خطأ
        نهاية
        ارجع لاشيء
    نهاية

    دالة احفظ()
        إذا (هذا._خصائص["عند_الحفظ"] != لاشيء)
            هذا._خصائص["عند_الحفظ"](هذا._قيمة)
        نهاية
    نهاية

    دالة أعد_تعيين()
        هذا._قيمة = هذا._قيمة_أولية
        هذا._خطأ = لاشيء
    نهاية

    دالة الخطأ()
        ارجع هذا._خطأ
    نهاية
نهاية

# ===================================================================
#                    متحققات مدمجة (Built-in Validators)
# ===================================================================

# متحقق المطلوب
صدّر دالة مطلوب(رسالة = "هذا الحقل مطلوب")
    ارجع دالة(قيمة)
        إذا (قيمة == لاشيء || قيمة == "")
            ارجع رسالة
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# متحقق الطول الأدنى
صدّر دالة حد_أدنى_طول(طول, رسالة = لاشيء)
    ارجع دالة(قيمة)
        إذا (قيمة == لاشيء)
            ارجع لاشيء
        نهاية
        إذا (قيمة.حجم() < طول)
            إذا (رسالة != لاشيء)
                ارجع رسالة
            نهاية
            ارجع "يجب أن يكون على الأقل " + طول + " أحرف"
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# متحقق الطول الأقصى
صدّر دالة حد_أقصى_طول(طول, رسالة = لاشيء)
    ارجع دالة(قيمة)
        إذا (قيمة == لاشيء)
            ارجع لاشيء
        نهاية
        إذا (قيمة.حجم() > طول)
            إذا (رسالة != لاشيء)
                ارجع رسالة
            نهاية
            ارجع "يجب ألا يتجاوز " + طول + " أحرف"
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# متحقق البريد الإلكتروني
صدّر دالة بريد_إلكتروني(رسالة = "بريد إلكتروني غير صالح")
    ارجع دالة(قيمة)
        إذا (قيمة == لاشيء || قيمة == "")
            ارجع لاشيء
        نهاية
        # فحص بسيط لوجود @ و .
        إذا (ليس قيمة.يحتوي("@") || ليس قيمة.يحتوي("."))
            ارجع رسالة
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# متحقق الرقم
صدّر دالة رقم_فقط(رسالة = "يجب إدخال رقم")
    ارجع دالة(قيمة)
        إذا (قيمة == لاشيء || قيمة == "")
            ارجع لاشيء
        نهاية
        لكل حرف في قيمة
            إذا (ليس (حرف >= "0" و حرف <= "9"))
                ارجع رسالة
            نهاية
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# متحقق النطاق الرقمي
صدّر دالة نطاق(أدنى, أقصى, رسالة = لاشيء)
    ارجع دالة(قيمة)
        إذا (قيمة == لاشيء || قيمة == "")
            ارجع لاشيء
        نهاية
        متغير رقم = قيمة.إلى_رقم()
        إذا (رقم < أدنى || رقم > أقصى)
            إذا (رسالة != لاشيء)
                ارجع رسالة
            نهاية
            ارجع "يجب أن يكون بين " + أدنى + " و " + أقصى
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# متحقق المطابقة (لتأكيد كلمة المرور)
صدّر دالة يطابق(حقل_آخر, رسالة = "القيمتان غير متطابقتين")
    ارجع دالة(قيمة)
        إذا (قيمة != حقل_آخر.القيمة())
            ارجع رسالة
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# متحقق النمط (Regex)
صدّر دالة نمط(تعبير, رسالة = "القيمة لا تطابق النمط المطلوب")
    ارجع دالة(قيمة)
        إذا (قيمة == لاشيء || قيمة == "")
            ارجع لاشيء
        نهاية
        # افترض وجود دالة مطابقة تعبير نمطي
        # إذا (ليس قيمة.يطابق(تعبير))
        #     ارجع رسالة
        # نهاية
        ارجع لاشيء
    نهاية
نهاية

# متحقق رقم الهاتف
صدّر دالة رقم_هاتف(رسالة = "رقم هاتف غير صالح")
    ارجع دالة(قيمة)
        إذا (قيمة == لاشيء || قيمة == "")
            ارجع لاشيء
        نهاية
        # فحص أن الطول مناسب
        إذا (قيمة.حجم() < 10 || قيمة.حجم() > 15)
            ارجع رسالة
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# متحقق URL
صدّر دالة رابط(رسالة = "رابط غير صالح")
    ارجع دالة(قيمة)
        إذا (قيمة == لاشيء || قيمة == "")
            ارجع لاشيء
        نهاية
        إذا (ليس (قيمة.يبدأ_بـ("http://") || قيمة.يبدأ_بـ("https://")))
            ارجع رسالة
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ===================================================================
#                    دمج المتحققات
