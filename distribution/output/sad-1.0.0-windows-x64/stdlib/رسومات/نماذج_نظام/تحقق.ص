# ===================================================================
#                    رسالة_خطأ (Error Message Widget)
# ===================================================================
صدّر صنف رسالة_خطأ يرث عنصر
    باني(نص = "", لون = "#FF0000", حجم = 12, مرئية = صحيح)
        هذا._نوع = "رسالة_خطأ"
        هذا._خصائص = {}
        هذا._خصائص["نص"] = نص
        هذا._خصائص["لون"] = لون
        هذا._خصائص["حجم"] = حجم
        هذا._خصائص["مرئية"] = مرئية
    نهاية

    دالة عيّن_الخطأ(نص)
        هذا._خصائص["نص"] = نص
        هذا._خصائص["مرئية"] = نص != لاشيء و نص != ""
        ارجع هذا
    نهاية

    دالة أخفِ()
        هذا._خصائص["مرئية"] = خطأ
        ارجع هذا
    نهاية
نهاية
