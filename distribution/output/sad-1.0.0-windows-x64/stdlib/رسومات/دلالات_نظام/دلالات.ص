# ─── دلالات (Semantics) ───
صدّر صنف دلالات يرث عنصر
    باني(ابن = لاشيء)
        هذا._نوع = "دلالات"
        هذا._خصائص = {}
        هذا._خصائص["تسمية"] = لاشيء
        هذا._خصائص["قيمة"] = لاشيء
        هذا._خصائص["تلميح"] = لاشيء
        هذا._خصائص["نص_زيادة"] = لاشيء
        هذا._خصائص["نص_نقصان"] = لاشيء
        هذا._خصائص["زر"] = خطأ
        هذا._خصائص["ممكن"] = صحيح
        هذا._خصائص["مخفي"] = خطأ
        هذا._خصائص["محدد"] = لاشيء
        هذا._خصائص["مربع_اختيار"] = لاشيء
        هذا._خصائص["رأسية"] = خطأ
        هذا._خصائص["حاوية"] = خطأ
        هذا._خصائص["حقل_نص"] = خطأ
        هذا._خصائص["صورة"] = خطأ
        هذا._خصائص["عند_النقر"] = لاشيء
        هذا._خصائص["عند_الضغط_المطول"] = لاشيء
        هذا._خصائص["عند_التمرير_لأعلى"] = لاشيء
        هذا._خصائص["عند_التمرير_لأسفل"] = لاشيء
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية

    دالة تسمية(محتوى)
        هذا._خصائص["تسمية"] = محتوى
        ارجع هذا
    نهاية

    دالة تلميح(محتوى)
        هذا._خصائص["تلميح"] = محتوى
        ارجع هذا
    نهاية

    دالة كزر()
        هذا._خصائص["زر"] = صحيح
        ارجع هذا
    نهاية

    دالة كصورة()
        هذا._خصائص["صورة"] = صحيح
        ارجع هذا
    نهاية

    دالة كحقل_نص()
        هذا._خصائص["حقل_نص"] = صحيح
        ارجع هذا
    نهاية

    دالة كرأسية()
        هذا._خصائص["رأسية"] = صحيح
        ارجع هذا
    نهاية

    دالة مخفي(قيمة)
        هذا._خصائص["مخفي"] = قيمة
        ارجع هذا
    نهاية
نهاية

