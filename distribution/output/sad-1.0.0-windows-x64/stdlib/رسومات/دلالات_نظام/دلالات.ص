# ─── عقدة_دلالات (SemanticsNode) ───
صدّر صنف عقدة_دلالات
    باني()
        هذا._معرف = 0
        هذا._تسمية = ""
        هذا._قيمة = ""
        هذا._إجراءات = []
        هذا._أعلام = []
        هذا._مستطيل = لاشيء
        هذا._أبناء = []
    نهاية

    دالة أضف_إجراء(إجراء)
        هذا._إجراءات = هذا._إجراءات + [إجراء]
    نهاية

    دالة أضف_علم(علم)
        هذا._أعلام = هذا._أعلام + [علم]
    نهاية
نهاية

# ─── إعلان_حي (LiveRegion — لتحديثات قارئ الشاشة) ───
صدّر صنف إعلان_حي يرث عنصر
    باني(رسالة = "", ابن = لاشيء)
        هذا._نوع = "إعلان_حي"
        هذا._خصائص = {}
        هذا._خصائص["رسالة"] = رسالة
        هذا._خصائص["أولوية"] = "مهذب"
        هذا._أبناء = []
        إذا (ابن != لاشيء)
