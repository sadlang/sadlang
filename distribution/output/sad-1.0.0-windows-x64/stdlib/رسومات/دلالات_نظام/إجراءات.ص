# بسم الله الرحمن الرحيم
# ===================================================================
# إجراءات الدلالات — Semantic Actions
# ===================================================================
#
# (AR) هذا الملف يوفر نظام الإجراءات الدلالية (Semantic Actions)
#      المسؤول عن التواصل مع تقنيات إمكانية الوصول (قارئات الشاشة،
#      مفاتيح الوصول، التنقل بالتبويب... إلخ).
#
#      الإجراءات الدلالية هي العمليات التي يمكن لقارئ الشاشة
#      أو نظام التشغيل تنفيذها على عنصر واجهة، مثل:
#      - النقر (tap) — مكافئ لضغط الزر
#      - الضغط المطول (longPress)
#      - التمرير (scroll) لأعلى/أسفل/يمين/يسار
#      - زيادة/نقصان القيمة (increment/decrement)
#      - النسخ/اللصق/القص
#
#      مطابق لـ flutter/semantics/semantics.dart (SemanticsAction)
#      و flutter/rendering/custom_paint.dart (SemanticsBuilderCallback)
#
# (EN) Semantic Actions system — responsible for communicating with
#      assistive technologies (screen readers, switch access, etc.)
#
# الأصناف المُصدّرة:
#   - إجراء_دلالي (SemanticsAction)    — تعداد الإجراءات
#   - علم_دلالي (SemanticsFlag)         — أعلام الدلالات
#   - بيانات_دلالية (SemanticsData)     — بيانات العقدة
#   - تكوين_دلالي (SemanticsConfiguration) — تكوين قابل للتخصيص
#   - خصائص_دلالية (SemanticsProperties) — خصائص العنصر
#   - مُعدّل_دلالي (SemanticsModifier)  — معدل لتغيير الدلالات
#
# الاستخدام:
#   استورد * من رسومات.دلالات_نظام.إجراءات
# ===================================================================

# ─── ثوابت الإجراءات الدلالية ───
# (AR) كل إجراء يمثَّل بعدد صحيح (bitmask) للأداء
#      يمكن دمجها بعملية OR لتعيين عدة إجراءات

ثابت إجراء_نقر = 1              # Tap
ثابت إجراء_ضغط_مطول = 2        # Long Press
ثابت إجراء_تمرير_يسار = 4      # Scroll Left
ثابت إجراء_تمرير_يمين = 8      # Scroll Right
ثابت إجراء_تمرير_أعلى = 16     # Scroll Up
ثابت إجراء_تمرير_أسفل = 32     # Scroll Down
ثابت إجراء_زيادة = 64           # Increment
ثابت إجراء_نقصان = 128          # Decrement
ثابت إجراء_نسخ = 256            # Copy
ثابت إجراء_قص = 512             # Cut
ثابت إجراء_لصق = 1024           # Paste
ثابت إجراء_تركيز = 2048         # Focus (set accessibility focus)
ثابت إجراء_إلغاء_تركيز = 4096   # Unfocus
ثابت إجراء_نص_مخصص = 8192      # Custom Action
ثابت إجراء_رفض = 16384          # Dismiss
ثابت إجراء_تحريك_مؤشر = 32768  # Move Cursor

# ─── ثوابت أعلام الدلالات ───
# (AR) أعلام تصف طبيعة العنصر (زر، حقل نص، مخفي... إلخ)

ثابت علم_مخفي = 1              # Hidden from accessibility
ثابت علم_محدد = 2              # Checked (checkbox/radio)
ثابت علم_ممكن = 4              # Enabled
ثابت علم_زر = 8                # Is a button
ثابت علم_حقل_نص = 16           # Is a text field
ثابت علم_مركز = 32             # Has accessibility focus
ثابت علم_صورة = 64             # Is an image
ثابت علم_يعيش = 128            # Is a live region
ثابت علم_رأسية = 256           # Is a header
ثابت علم_شريط_تمرير = 512      # Is a slider
ثابت علم_رابط = 1024           # Is a link
ثابت علم_قابل_تبديل = 2048    # Is toggled
ثابت علم_للقراءة_فقط = 4096   # Read-only

# ─── إجراء_دلالي (SemanticsAction) ───
صدّر صنف إجراء_دلالي
    # (AR) يمثل إجراءً دلاليًا واحدًا يمكن تنفيذه على عنصر
    #      يحمل نوع الإجراء (من الثوابت أعلاه) ورد النداء
    # (EN) Single semantic action with type and callback
    باني(نوع = 0, رد_نداء = لاشيء, تسمية = "")
        هذا._نوع = نوع
        هذا._رد_نداء = رد_نداء
        هذا._تسمية = تسمية
    نهاية

    دالة النوع()
        ارجع هذا._نوع
    نهاية

    دالة التسمية()
        ارجع هذا._تسمية
    نهاية

    دالة نفّذ(وسائط = لاشيء)
        # (AR) تنفيذ الإجراء إذا كان له رد نداء
        إذا (هذا._رد_نداء != لاشيء)
            هذا._رد_نداء(وسائط)
        نهاية
    نهاية
نهاية

# ─── بيانات_دلالية (SemanticsData) ───
صدّر صنف بيانات_دلالية
    # (AR) بيانات الدلالات الكاملة لعقدة واحدة في شجرة الدلالات
    #      تجمع بين الأعلام والإجراءات والنصوص والخصائص
    # (EN) Complete semantics data for a single node in the semantics tree
    باني()
        هذا._أعلام = 0
        هذا._إجراءات = 0
        هذا._تسمية = ""
        هذا._قيمة = ""
        هذا._قيمة_متزايدة = ""
        هذا._قيمة_متناقصة = ""
        هذا._تلميح = ""
        هذا._اتجاه_نص = لاشيء
        هذا._مستطيل = لاشيء
        هذا._ترتيب = لاشيء
        هذا._إجراءات_مخصصة = []
    نهاية

    دالة عيّن_تسمية(محتوى)
        هذا._تسمية = محتوى
        ارجع هذا
    نهاية

    دالة عيّن_قيمة(محتوى)
        هذا._قيمة = محتوى
        ارجع هذا
    نهاية

    دالة عيّن_تلميح(محتوى)
        هذا._تلميح = محتوى
        ارجع هذا
    نهاية

    دالة أضف_علم(علم)
        # (AR) إضافة علم باستخدام عملية OR ثنائية
        هذا._أعلام = هذا._أعلام + علم
        ارجع هذا
    نهاية

    دالة يملك_علم(علم)
        # (AR) التحقق من وجود علم معين
        ارجع هذا._أعلام % (علم * 2) >= علم
    نهاية

    دالة أضف_إجراء(إجراء)
        هذا._إجراءات = هذا._إجراءات + إجراء
        ارجع هذا
    نهاية

    دالة يملك_إجراء(إجراء)
        ارجع هذا._إجراءات % (إجراء * 2) >= إجراء
    نهاية

    دالة أضف_إجراء_مخصص(إجراء)
        هذا._إجراءات_مخصصة = هذا._إجراءات_مخصصة + [إجراء]
        ارجع هذا
    نهاية

    دالة عيّن_مستطيل(س, ص, عرض, ارتفاع)
        هذا._مستطيل = {"س": س, "ص": ص, "عرض": عرض, "ارتفاع": ارتفاع}
        ارجع هذا
    نهاية

    دالة عيّن_ترتيب(قيمة)
        هذا._ترتيب = قيمة
        ارجع هذا
    نهاية
نهاية

# ─── تكوين_دلالي (SemanticsConfiguration) ───
صدّر صنف تكوين_دلالي
    # (AR) تكوين قابل للتخصيص يُبنى من خصائص ثم يُطبق على عقدة
    #      يُستخدم من قبل كائنات التصيير لوصف دلالاتها
    # (EN) Customizable configuration built from properties,
    #      then applied to a semantics node by render objects
    باني()
        هذا._هو_دلالائي = صحيح
        هذا._هو_حاجز = خطأ
        هذا._هو_علامة_مرجعية = خطأ
        هذا._يمنع_تسمية_أبناء = خطأ
        هذا._سمات = {}
        هذا._إجراءات = []
    نهاية

    دالة كحاجز()
        # (AR) جعل هذا العنصر حاجزًا — يمنع الدلالات من الانتشار
        هذا._هو_حاجز = صحيح
        ارجع هذا
    نهاية

    دالة كعلامة_مرجعية()
        # (AR) تعيين العنصر كعلامة مرجعية (semantic landmark)
        هذا._هو_علامة_مرجعية = صحيح
        ارجع هذا
    نهاية

    دالة امنع_تسمية_أبناء()
        هذا._يمنع_تسمية_أبناء = صحيح
        ارجع هذا
    نهاية

    دالة عيّن_سمة(مفتاح, قيمة)
        هذا._سمات[مفتاح] = قيمة
        ارجع هذا
    نهاية

    دالة أضف_إجراء(إجراء)
        هذا._إجراءات = هذا._إجراءات + [إجراء]
        ارجع هذا
    نهاية

    دالة هو_حاجز()
        ارجع هذا._هو_حاجز
    نهاية

    دالة هو_علامة_مرجعية()
        ارجع هذا._هو_علامة_مرجعية
    نهاية
نهاية

# ─── خصائص_دلالية (SemanticsProperties) ───
صدّر صنف خصائص_دلالية
    # (AR) خصائص دلالية تُمرَّر لعنصر Semantics widget
    #      تمثل الخصائص المقروءة من صنف الدلالات (الأساسي)
    # (EN) Semantic properties passed to the Semantics widget
    باني()
        هذا._ممكن = صحيح
        هذا._محدد = لاشيء
        هذا._قابل_تبديل = لاشيء
        هذا._مخفي = خطأ
        هذا._تسمية = لاشيء
        هذا._قيمة = لاشيء
        هذا._تلميح = لاشيء
        هذا._عند_النقر = لاشيء
        هذا._عند_الضغط_المطول = لاشيء
        هذا._عند_تمرير_لأعلى = لاشيء
        هذا._عند_تمرير_لأسفل = لاشيء
        هذا._عند_نسخ = لاشيء
        هذا._عند_قص = لاشيء
        هذا._عند_لصق = لاشيء
        هذا._عند_زيادة = لاشيء
        هذا._عند_نقصان = لاشيء
    نهاية

    دالة تسمية(محتوى)
        هذا._تسمية = محتوى
        ارجع هذا
    نهاية

    دالة قيمة(محتوى)
        هذا._قيمة = محتوى
        ارجع هذا
    نهاية

    دالة تلميح(محتوى)
        هذا._تلميح = محتوى
        ارجع هذا
    نهاية

    دالة ممكن(قيمة)
        هذا._ممكن = قيمة
        ارجع هذا
    نهاية

    دالة مخفي(قيمة)
        هذا._مخفي = قيمة
        ارجع هذا
    نهاية

    دالة عند_النقر(رد_نداء)
        هذا._عند_النقر = رد_نداء
        ارجع هذا
    نهاية

    دالة عند_الضغط_المطول(رد_نداء)
        هذا._عند_الضغط_المطول = رد_نداء
        ارجع هذا
    نهاية

    دالة إلى_بيانات()
        # (AR) تحويل الخصائص إلى بيانات دلالية
        متغير بيانات = جديد بيانات_دلالية()
        إذا (هذا._تسمية != لاشيء)
            بيانات.عيّن_تسمية(هذا._تسمية)
        نهاية
        إذا (هذا._قيمة != لاشيء)
            بيانات.عيّن_قيمة(هذا._قيمة)
        نهاية
        إذا (هذا._تلميح != لاشيء)
            بيانات.عيّن_تلميح(هذا._تلميح)
        نهاية
        إذا (هذا._ممكن)
            بيانات.أضف_علم(علم_ممكن)
        نهاية
        إذا (هذا._مخفي)
            بيانات.أضف_علم(علم_مخفي)
        نهاية
        إذا (هذا._عند_النقر != لاشيء)
            بيانات.أضف_إجراء(إجراء_نقر)
        نهاية
        إذا (هذا._عند_الضغط_المطول != لاشيء)
            بيانات.أضف_إجراء(إجراء_ضغط_مطول)
        نهاية
        ارجع بيانات
    نهاية
نهاية

# ─── مُعدّل_دلالي (SemanticsModifier) ───
صدّر صنف مُعدّل_دلالي
    # (AR) معدّل يُضاف لعنصر لتغيير دلالاته — مثل إضافة
    #      تسمية أو إجراء أو إخفاء من القارئ
    # (EN) Modifier that alters an element's semantics
    باني(نوع = "إضافة", مفتاح = "", قيمة = لاشيء)
        هذا._نوع = نوع
        هذا._مفتاح = مفتاح
        هذا._قيمة = قيمة
    نهاية

    دالة طبّق(بيانات)
        # (AR) تطبيق التعديل على بيانات دلالية
        إذا (هذا._نوع == "تسمية")
            بيانات.عيّن_تسمية(هذا._قيمة)
        وإلا
            إذا (هذا._نوع == "تلميح")
                بيانات.عيّن_تلميح(هذا._قيمة)
            وإلا
                إذا (هذا._نوع == "إخفاء")
                    بيانات.أضف_علم(علم_مخفي)
                نهاية
            نهاية
        نهاية
        ارجع بيانات
    نهاية
نهاية
