# ===================================================================
# تحويلات الرسم — Transformations & Matrix
# ===================================================================
# مستوحى من Flutter Matrix4 + Transform widget
#
# الاستخدام:
#   استورد * من رسومات.رسم.تحويلات
# ===================================================================

استورد * من رسومات.أساس.عنصر
استورد * من رسومات.رسم.لوحة

# ─── مصفوفة_تحويل (Matrix — 3x3 for 2D) ───
صدّر صنف مصفوفة_تحويل
    باني()
        # مصفوفة وحدة 3x3 مسطحة
        هذا._م = [1, 0, 0, 0, 1, 0, 0, 0, 1]
    نهاية

    ساكن دالة وحدة()
        ارجع جديد مصفوفة_تحويل()
    نهاية

    ساكن دالة إزاحة(أفقي, عمودي)
        متغير م = جديد مصفوفة_تحويل()
        م._م[2] = أفقي
        م._م[5] = عمودي
        ارجع م
    نهاية

    ساكن دالة تكبير(أفقي, عمودي = لاشيء)
        إذا (عمودي == لاشيء)
            عمودي = أفقي
        نهاية
        متغير م = جديد مصفوفة_تحويل()
        م._م[0] = أفقي
        م._م[4] = عمودي
        ارجع م
    نهاية

    ساكن دالة دوران(زاوية)
        متغير م = جديد مصفوفة_تحويل()
        متغير جا = _حساب_جا(زاوية)
        متغير جتا = _حساب_جتا(زاوية)
        م._م[0] = جتا
        م._م[1] = -جا
        م._م[3] = جا
        م._م[4] = جتا
        ارجع م
    نهاية

    دالة اضرب(أخرى)
        متغير نتيجة = جديد مصفوفة_تحويل()
        متغير أ = هذا._م
        متغير ب = أخرى._م
        نتيجة._م[0] = أ[0] * ب[0] + أ[1] * ب[3] + أ[2] * ب[6]
        نتيجة._م[1] = أ[0] * ب[1] + أ[1] * ب[4] + أ[2] * ب[7]
        نتيجة._م[2] = أ[0] * ب[2] + أ[1] * ب[5] + أ[2] * ب[8]
        نتيجة._م[3] = أ[3] * ب[0] + أ[4] * ب[3] + أ[5] * ب[6]
        نتيجة._م[4] = أ[3] * ب[1] + أ[4] * ب[4] + أ[5] * ب[7]
        نتيجة._م[5] = أ[3] * ب[2] + أ[4] * ب[5] + أ[5] * ب[8]
        نتيجة._م[6] = أ[6] * ب[0] + أ[7] * ب[3] + أ[8] * ب[6]
        نتيجة._م[7] = أ[6] * ب[1] + أ[7] * ب[4] + أ[8] * ب[7]
        نتيجة._م[8] = أ[6] * ب[2] + أ[7] * ب[5] + أ[8] * ب[8]
        ارجع نتيجة
    نهاية

    دالة حوّل_نقطة(نقطة)
        متغير س = هذا._م[0] * نقطة.س + هذا._م[1] * نقطة.ص + هذا._م[2]
        متغير ص = هذا._م[3] * نقطة.س + هذا._م[4] * نقطة.ص + هذا._م[5]
        ارجع جديد نقطة(س, ص)
    نهاية
نهاية

# ─── عنصر_تحويل (Transform widget) ───
صدّر صنف عنصر_تحويل يرث عنصر
    باني(طفل = لاشيء, مصفوفة = لاشيء, نقطة_أصل = لاشيء, محاذاة = لاشيء)
        هذا._نوع = "عنصر_تحويل"
        هذا._خصائص = {}
        هذا._خصائص["مصفوفة"] = مصفوفة
        هذا._خصائص["نقطة_أصل"] = نقطة_أصل
        هذا._خصائص["محاذاة"] = محاذاة
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

# ─── تحويل_دوران (Transform.rotate) ───
صدّر صنف تحويل_دوران يرث عنصر
    باني(طفل = لاشيء, زاوية = 0, نقطة_أصل = لاشيء)
        هذا._نوع = "عنصر_تحويل"
        هذا._خصائص = {}
        هذا._خصائص["مصفوفة"] = مصفوفة_تحويل.دوران(زاوية)
        هذا._خصائص["نقطة_أصل"] = نقطة_أصل
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

# ─── تحويل_تكبير (Transform.scale) ───
صدّر صنف تحويل_تكبير يرث عنصر
    باني(طفل = لاشيء, مقياس = 1, نقطة_أصل = لاشيء)
        هذا._نوع = "عنصر_تحويل"
