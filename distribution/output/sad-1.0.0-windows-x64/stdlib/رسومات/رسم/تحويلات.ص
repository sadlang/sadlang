        هذا._خصائص["مصفوفة"] = مصفوفة_تحويل.تكبير(مقياس)
        هذا._خصائص["نقطة_أصل"] = نقطة_أصل
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

# ─── تحويل_إزاحة (Transform.translate) ───
صدّر صنف تحويل_إزاحة يرث عنصر
    باني(طفل = لاشيء, أفقي = 0, عمودي = 0)
        هذا._نوع = "عنصر_تحويل"
        هذا._خصائص = {}
        هذا._خصائص["مصفوفة"] = مصفوفة_تحويل.إزاحة(أفقي, عمودي)
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

# ─── دوال مساعدة رياضية ───
ثابت _باي = 3.14159265358979

دالة _حساب_جا(زاوية)
    متغير ز = زاوية % (2 * _باي)
    متغير نتيجة = ز
    متغير حد = ز
    لكل ن في [1, 2, 3, 4, 5, 6, 7, 8, 9]
        حد = -حد * ز * ز / ((2 * ن) * (2 * ن + 1))
        نتيجة = نتيجة + حد
    نهاية
    ارجع نتيجة
نهاية

دالة _حساب_جتا(زاوية)
    ارجع _حساب_جا(زاوية + _باي / 2)
نهاية
