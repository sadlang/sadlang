# ===================================================================
# نظام الرسم المتقدم — Canvas API
# ===================================================================
# مستوحى من Flutter Canvas + CustomPainter
#
# الاستخدام:
#   استورد * من رسومات.رسم.لوحة
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── نقطة (Offset) ───
صدّر صنف نقطة
    باني(س = 0, ص = 0)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة مسافة_إلى(أخرى)
        متغير فس = هذا.س - أخرى.س
        متغير فص = هذا.ص - أخرى.ص
        ارجع (فس * فس + فص * فص) ** 0.5
    نهاية

    دالة جمع(أخرى)
        ارجع جديد نقطة(هذا.س + أخرى.س, هذا.ص + أخرى.ص)
    نهاية

    دالة طرح(أخرى)
        ارجع جديد نقطة(هذا.س - أخرى.س, هذا.ص - أخرى.ص)
    نهاية

    دالة ضرب(عامل)
        ارجع جديد نقطة(هذا.س * عامل, هذا.ص * عامل)
    نهاية
نهاية

# ─── حجم_ر (Size — canvas layer) ───
# ملاحظة: أُعيد تسميته من حجم لتجنب التعارض مع تصيير_نظام/تصيير.ص
صدّر صنف حجم_ر
    باني(عرض = 0, ارتفاع = 0)
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية

    دالة مساحة()
        ارجع هذا.عرض * هذا.ارتفاع
    نهاية
نهاية

# ─── مستطيل (Rect) ───
صدّر صنف مستطيل_ر
    باني(يسار = 0, أعلى = 0, عرض = 0, ارتفاع = 0)
        هذا.يسار = يسار
        هذا.أعلى = أعلى
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية

    ساكن دالة من_نقطتين(ن1, ن2)
        ارجع جديد مستطيل_ر(ن1.س, ن1.ص, ن2.س - ن1.س, ن2.ص - ن1.ص)
    نهاية

    ساكن دالة من_مركز(مركز, عرض, ارتفاع)
        ارجع جديد مستطيل_ر(مركز.س - عرض / 2, مركز.ص - ارتفاع / 2, عرض, ارتفاع)
    نهاية

    دالة يحتوي(نقطة)
        ارجع نقطة.س >= هذا.يسار و نقطة.س <= هذا.يسار + هذا.عرض و نقطة.ص >= هذا.أعلى و نقطة.ص <= هذا.أعلى + هذا.ارتفاع
    نهاية

    دالة مركز()
        ارجع جديد نقطة(هذا.يسار + هذا.عرض / 2, هذا.أعلى + هذا.ارتفاع / 2)
    نهاية
نهاية

# ─── لون (Color) ───
صدّر صنف لون_ر
    باني(أحمر = 0, أخضر = 0, أزرق = 0, شفافية = 255)
        هذا.أحمر = أحمر
        هذا.أخضر = أخضر
        هذا.أزرق = أزرق
        هذا.شفافية = شفافية
    نهاية

    ساكن دالة من_ست_عشري(قيمة)
        متغير لون = جديد لون_ر()
        لون.شفافية = (قيمة / 16777216) % 256
        لون.أحمر = (قيمة / 65536) % 256
        لون.أخضر = (قيمة / 256) % 256
        لون.أزرق = قيمة % 256
        ارجع لون
    نهاية

    دالة مع_شفافية(ش)
        ارجع جديد لون_ر(هذا.أحمر, هذا.أخضر, هذا.أزرق, ش)
    نهاية
نهاية

# ─── فرشاة (Paint) ───
صدّر صنف فرشاة
    باني()
        هذا.لون = جديد لون_ر(0, 0, 0, 255)
        هذا.نمط = "ملء"
        هذا.سمك_خط = 1.0
        هذا.نهاية_خط = "مستديرة"
        هذا.وصلة_خط = "مستديرة"
        هذا.مرشح_ضبابية = لاشيء
        هذا.تدرج = لاشيء
        هذا.مزج = "عادي"
    نهاية

    دالة عيّن_لون(ل)
        هذا.لون = ل
        ارجع هذا
    نهاية

    دالة عيّن_نمط(ن)
        هذا.نمط = ن
        ارجع هذا
    نهاية

    دالة عيّن_سمك(س)
        هذا.سمك_خط = س
        ارجع هذا
    نهاية

    دالة عيّن_حد()
        هذا.نمط = "حد"
        ارجع هذا
    نهاية

    دالة عيّن_ملء()
        هذا.نمط = "ملء"
        ارجع هذا
    نهاية
نهاية

# ─── مسار (Path) ───
صدّر صنف مسار
    باني()
        هذا._أوامر = []
    نهاية

    دالة انتقل_إلى(س, ص)
        هذا._أوامر.أضف({"نوع": "انتقال", "س": س, "ص": ص})
        ارجع هذا
    نهاية

    دالة خط_إلى(س, ص)
        هذا._أوامر.أضف({"نوع": "خط", "س": س, "ص": ص})
        ارجع هذا
    نهاية

    دالة منحنى_تربيعي(تحكم_س, تحكم_ص, نهاية_س, نهاية_ص)
        هذا._أوامر.أضف({
            "نوع": "منحنى_تربيعي",
            "تحكم_س": تحكم_س, "تحكم_ص": تحكم_ص,
            "نهاية_س": نهاية_س, "نهاية_ص": نهاية_ص
        })
        ارجع هذا
    نهاية

    دالة منحنى_مكعب(ت1س, ت1ص, ت2س, ت2ص, نس, نص)
        هذا._أوامر.أضف({
            "نوع": "منحنى_مكعب",
            "ت1س": ت1س, "ت1ص": ت1ص,
            "ت2س": ت2س, "ت2ص": ت2ص,
            "نس": نس, "نص": نص
        })
        ارجع هذا
    نهاية

    دالة قوس(مستطيل, بداية_زاوية, مدى_زاوية)
        هذا._أوامر.أضف({
            "نوع": "قوس",
            "يسار": مستطيل.يسار, "أعلى": مستطيل.أعلى,
            "عرض": مستطيل.عرض, "ارتفاع": مستطيل.ارتفاع,
            "بداية": بداية_زاوية, "مدى": مدى_زاوية
        })
        ارجع هذا
    نهاية

    دالة أغلق()
        هذا._أوامر.أضف({"نوع": "إغلاق"})
        ارجع هذا
    نهاية

    دالة مستطيل(م)
        هذا.انتقل_إلى(م.يسار, م.أعلى)
        هذا.خط_إلى(م.يسار + م.عرض, م.أعلى)
        هذا.خط_إلى(م.يسار + م.عرض, م.أعلى + م.ارتفاع)
        هذا.خط_إلى(م.يسار, م.أعلى + م.ارتفاع)
        هذا.أغلق()
        ارجع هذا
    نهاية

    دالة دائرة(مركز, نصف_قطر)
        متغير م = جديد مستطيل_ر(مركز.س - نصف_قطر, مركز.ص - نصف_قطر, نصف_قطر * 2, نصف_قطر * 2)
        هذا.قوس(م, 0, 6.283185)
        ارجع هذا
    نهاية

    دالة أوامر()
        ارجع هذا._أوامر
    نهاية

    دالة إعادة_تعيين()
        هذا._أوامر = []
        ارجع هذا
    نهاية
نهاية

# ─── تدرج_خطي (LinearGradient) ───
صدّر صنف تدرج_خطي
    باني(بداية, نهاية_ن, ألوان, مواقع = لاشيء)
        هذا.نوع = "خطي"
        هذا.بداية = بداية
        هذا.نهاية_ن = نهاية_ن
        هذا.ألوان = ألوان
        هذا.مواقع = مواقع
    نهاية
نهاية

# ─── تدرج_شعاعي (RadialGradient) ───
صدّر صنف تدرج_شعاعي
    باني(مركز, نصف_قطر, ألوان, مواقع = لاشيء)
        هذا.نوع = "شعاعي"
        هذا.مركز = مركز
        هذا.نصف_قطر = نصف_قطر
        هذا.ألوان = ألوان
        هذا.مواقع = مواقع
    نهاية
نهاية

# ─── تدرج_مخروطي (SweepGradient) ───
صدّر صنف تدرج_مخروطي
    باني(مركز, ألوان, بداية_زاوية = 0, نهاية_زاوية = 6.283185)
        هذا.نوع = "مخروطي"
        هذا.مركز = مركز
        هذا.ألوان = ألوان
        هذا.بداية_زاوية = بداية_زاوية
        هذا.نهاية_زاوية = نهاية_زاوية
    نهاية
نهاية

# ─── لوحة_رسم (Canvas) ───
صدّر صنف لوحة_رسم
    باني(عرض = 800, ارتفاع = 600)
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
        هذا._عمليات = []
        هذا._حالات = []
    نهاية

    # رسم خط
    دالة ارسم_خط(ن1, ن2, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "خط",
            "س1": ن1.س, "ص1": ن1.ص,
            "س2": ن2.س, "ص2": ن2.ص,
            "فرشاة": فرشاة
        })
    نهاية

    # رسم مستطيل
    دالة ارسم_مستطيل(م, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "مستطيل",
            "يسار": م.يسار, "أعلى": م.أعلى,
            "عرض": م.عرض, "ارتفاع": م.ارتفاع,
            "فرشاة": فرشاة
        })
    نهاية

    # رسم مستطيل بزوايا مستديرة
    دالة ارسم_مستطيل_مستدير(م, نصف_قطر, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "مستطيل_مستدير",
            "يسار": م.يسار, "أعلى": م.أعلى,
            "عرض": م.عرض, "ارتفاع": م.ارتفاع,
            "نصف_قطر": نصف_قطر,
            "فرشاة": فرشاة
        })
    نهاية

    # رسم دائرة
    دالة ارسم_دائرة(مركز, نصف_قطر, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "دائرة",
            "س": مركز.س, "ص": مركز.ص,
            "نصف_قطر": نصف_قطر,
            "فرشاة": فرشاة
        })
    نهاية

    # رسم قوس
    دالة ارسم_قوس(م, بداية, مدى, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "قوس",
            "يسار": م.يسار, "أعلى": م.أعلى,
            "عرض": م.عرض, "ارتفاع": م.ارتفاع,
            "بداية": بداية, "مدى": مدى,
            "فرشاة": فرشاة
        })
    نهاية

    # رسم بيضوية
    دالة ارسم_بيضوية(م, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "بيضوية",
            "يسار": م.يسار, "أعلى": م.أعلى,
            "عرض": م.عرض, "ارتفاع": م.ارتفاع,
            "فرشاة": فرشاة
        })
    نهاية

    # رسم مسار
    دالة ارسم_مسار(مسار, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "مسار",
            "أوامر": مسار.أوامر(),
            "فرشاة": فرشاة
        })
    نهاية

    # رسم نص
    دالة ارسم_نص(نص, نقطة, فرشاة, حجم_خط = 16)
        هذا._عمليات.أضف({
            "نوع": "نص",
            "نص": نص,
            "س": نقطة.س, "ص": نقطة.ص,
            "حجم_خط": حجم_خط,
            "فرشاة": فرشاة
        })
    نهاية

    # رسم صورة
    دالة ارسم_صورة(صورة, مستطيل_مصدر, مستطيل_هدف, فرشاة = لاشيء)
        هذا._عمليات.أضف({
            "نوع": "صورة",
            "صورة": صورة,
            "مصدر": مستطيل_مصدر,
            "هدف": مستطيل_هدف,
            "فرشاة": فرشاة
        })
    نهاية

    # رسم نقاط
    دالة ارسم_نقاط(نقاط, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "نقاط",
            "نقاط": نقاط,
            "فرشاة": فرشاة
        })
    نهاية

    # رسم ظل
    دالة ارسم_ظل(مسار, لون, ارتفاع)
        هذا._عمليات.أضف({
            "نوع": "ظل",
            "أوامر": مسار.أوامر(),
            "لون": لون,
            "ارتفاع": ارتفاع
        })
    نهاية

    # حفظ حالة اللوحة
    دالة احفظ()
        هذا._عمليات.أضف({"نوع": "حفظ"})
    نهاية

    # استعادة حالة اللوحة
    دالة استعد()
        هذا._عمليات.أضف({"نوع": "استعادة"})
    نهاية

    # تحويل — إزاحة
    دالة أزح(أفقي, عمودي)
        هذا._عمليات.أضف({"نوع": "إزاحة", "أفقي": أفقي, "عمودي": عمودي})
    نهاية

    # تحويل — دوران
    دالة دوّر(زاوية)
        هذا._عمليات.أضف({"نوع": "دوران", "زاوية": زاوية})
    نهاية

    # تحويل — تكبير
    دالة كبّر(أفقي, عمودي)
        هذا._عمليات.أضف({"نوع": "تكبير", "أفقي": أفقي, "عمودي": عمودي})
    نهاية

    # قص
    دالة اقطع_مستطيل(م)
        هذا._عمليات.أضف({
            "نوع": "قص_مستطيل",
            "يسار": م.يسار, "أعلى": م.أعلى,
            "عرض": م.عرض, "ارتفاع": م.ارتفاع
        })
    نهاية

    دالة اقطع_مسار(مسار)
        هذا._عمليات.أضف({
            "نوع": "قص_مسار",
            "أوامر": مسار.أوامر()
        })
    نهاية

    # مسح اللوحة
    دالة امسح(لون = لاشيء)
        هذا._عمليات.أضف({"نوع": "مسح", "لون": لون})
    نهاية

    # الحصول على جميع العمليات
    دالة عمليات()
        ارجع هذا._عمليات
    نهاية

    # إعادة تعيين
    دالة إعادة_تعيين()
        هذا._عمليات = []
    نهاية
نهاية

# ─── رسام_مخصص (CustomPainter widget) ───
صدّر صنف رسام_مخصص يرث عنصر
    باني(عرض = 800, ارتفاع = 600, عند_رسم = لاشيء, لون_خلفية = لاشيء)
        هذا._نوع = "رسام_مخصص"
        هذا._خصائص = {}
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["عند_رسم"] = عند_رسم
        هذا._خصائص["لون_خلفية"] = لون_خلفية
        هذا._أبناء = []
    نهاية
نهاية
