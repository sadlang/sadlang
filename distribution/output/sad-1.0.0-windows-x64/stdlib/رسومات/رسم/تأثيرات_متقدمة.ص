# العيب #85: Path - مسار رسم
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف مسار
    باني()
        هذا._أوامر = []
        هذا._موضع = {س: 0، ص: 0}
    نهاية

    دالة انتقل_إلى(س، ص)
        هذا._أوامر.أضف({نوع: "انتقال"، س: س، ص: ص})
        هذا._موضع = {س: س، ص: ص}
        ارجع هذا
    نهاية

    دالة خط_إلى(س، ص)
        هذا._أوامر.أضف({نوع: "خط"، س: س، ص: ص})
        هذا._موضع = {س: س، ص: ص}
        ارجع هذا
    نهاية

    دالة منحنى_تربيعي(تحكم_س، تحكم_ص، نهاية_س، نهاية_ص)
        هذا._أوامر.أضف({
            نوع: "تربيعي"،
            تحكم: {س: تحكم_س، ص: تحكم_ص}،
            نهاية: {س: نهاية_س، ص: نهاية_ص}
        })
        هذا._موضع = {س: نهاية_س، ص: نهاية_ص}
        ارجع هذا
    نهاية

    دالة منحنى_بيزيه(ت1_س، ت1_ص، ت2_س، ت2_ص، نهاية_س، نهاية_ص)
        هذا._أوامر.أضف({
            نوع: "بيزيه"،
            تحكم1: {س: ت1_س، ص: ت1_ص}،
            تحكم2: {س: ت2_س، ص: ت2_ص}،
            نهاية: {س: نهاية_س، ص: نهاية_ص}
        })
        هذا._موضع = {س: نهاية_س، ص: نهاية_ص}
        ارجع هذا
    نهاية

    دالة قوس(مستطيل، زاوية_بداية، زاوية_مسح، عكس_الساعة)
        هذا._أوامر.أضف({
            نوع: "قوس"،
            مستطيل: مستطيل،
            زاوية_بداية: زاوية_بداية،
            زاوية_مسح: زاوية_مسح،
            عكس_الساعة: عكس_الساعة أو خطأ
        })
        ارجع هذا
    نهاية

    دالة أضف_مستطيل(س، ص، عرض، ارتفاع)
        ارجع هذا.انتقل_إلى(س، ص)
            .خط_إلى(س + عرض، ص)
            .خط_إلى(س + عرض، ص + ارتفاع)
            .خط_إلى(س، ص + ارتفاع)
            .أغلق()
    نهاية

    دالة أضف_دائرة(مركز_س، مركز_ص، نصف_قطر)
        ارجع هذا.أضف_قطع_ناقص(
            مركز_س - نصف_قطر،
            مركز_ص - نصف_قطر،
            نصف_قطر * 2،
            نصف_قطر * 2
        )
    نهاية

    دالة أضف_قطع_ناقص(س، ص، عرض، ارتفاع)
        هذا._أوامر.أضف({
            نوع: "قطع_ناقص"،
            مستطيل: {س: س، ص: ص، عرض: عرض، ارتفاع: ارتفاع}
        })
        ارجع هذا
    نهاية

    دالة أغلق()
        هذا._أوامر.أضف({نوع: "إغلاق"})
        ارجع هذا
    نهاية

    دالة احصل_حدود()
        # حساب الحدود
        متغير أدنى = {س: لانهائي، ص: لانهائي}
        متغير أقصى = {س: -لانهائي، ص: -لانهائي}
        
        لكل أمر في هذا._أوامر
            طابق (أمر.نوع)
                عندما "انتقال":
                    أدنى.س = مين(أدنى.س، أمر.س)
                    أدنى.ص = مين(أدنى.ص، أمر.ص)
                    أقصى.س = ماكس(أقصى.س، أمر.س)
                    أقصى.ص = ماكس(أقصى.ص، أمر.ص)
                عندما "خط":
                    أدنى.س = مين(أدنى.س، أمر.س)
                    أدنى.ص = مين(أدنى.ص، أمر.ص)
                    أقصى.س = ماكس(أقصى.س، أمر.س)
                    أقصى.ص = ماكس(أقصى.ص، أمر.ص)
            نهاية
        نهاية
        
        ارجع {س: أدنى.س، ص: أدنى.ص، عرض: أقصى.س - أدنى.س، ارتفاع: أقصى.ص - أدنى.ص}
    نهاية

    دالة تصدير()
        ارجع هذا._أوامر
    نهاية
نهاية

