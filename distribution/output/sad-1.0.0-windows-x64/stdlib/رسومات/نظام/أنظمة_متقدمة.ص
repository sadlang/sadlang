# العيب #91: Router - موجه التنقل
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف مسار
    باني(نمط، باني، اسم)
        هذا.نمط = نمط
        هذا.باني = باني
        هذا.اسم = اسم أو لاشيء
        هذا._معاملات = هذا._استخرج_معاملات(نمط)
    نهاية

    دالة _استخرج_معاملات(نمط)
        متغير معاملات = []
        متغير أجزاء = نمط.اقسم("/")
        لكل جزء في أجزاء
            إذا (جزء.يبدأ_بـ(":"))
                معاملات.أضف(جزء.قطع(1))
            نهاية
        نهاية
        ارجع معاملات
    نهاية

    دالة يطابق(مسار_حالي)
        متغير أجزاء_نمط = هذا.نمط.اقسم("/")
        متغير أجزاء_مسار = مسار_حالي.اقسم("/")
        
        إذا (أجزاء_نمط.الطول() != أجزاء_مسار.الطول())
            ارجع لاشيء
        نهاية
        
        متغير معاملات = {}
        لكل ي في نطاق(0، أجزاء_نمط.الطول())
            إذا (أجزاء_نمط[ي].يبدأ_بـ(":"))
                متغير اسم = أجزاء_نمط[ي].قطع(1)
                معاملات[اسم] = أجزاء_مسار[ي]
            وإلا إذا (أجزاء_نمط[ي] != أجزاء_مسار[ي])
                ارجع لاشيء
            نهاية
        نهاية
        
        ارجع معاملات
    نهاية
نهاية

صدّر صنف موجه
    باني(إعدادات)
        هذا._مسارات = إعدادات.مسارات أو []
        هذا._مسار_حالي = إعدادات.مسار_ابتدائي أو "/"
        هذا._تاريخ = [هذا._مسار_حالي]
        هذا._فهرس = 0
        هذا._عند_التغيير = إعدادات.عند_التغيير أو لاشيء
        هذا._404 = إعدادات.صفحة_404 أو لاشيء
    نهاية

    دالة انتقل_إلى(مسار، معاملات)
        هذا._مسار_حالي = هذا._بنِ_مسار(مسار، معاملات)
        هذا._تاريخ = هذا._تاريخ[0:هذا._فهرس + 1]
        هذا._تاريخ.أضف(هذا._مسار_حالي)
        هذا._فهرس = هذا._تاريخ.الطول() - 1
        هذا._أخبر()
    نهاية

    دالة _بنِ_مسار(مسار، معاملات)
        إذا (معاملات == لاشيء)
            ارجع مسار
        نهاية
        
        متغير نتيجة = مسار
        لكل مفتاح في معاملات
            نتيجة = نتيجة.استبدل(":" + مفتاح، معاملات[مفتاح])
        نهاية
        ارجع نتيجة
    نهاية

    دالة عودة()
        إذا (هذا._فهرس > 0)
            هذا._فهرس -= 1
            هذا._مسار_حالي = هذا._تاريخ[هذا._فهرس]
            هذا._أخبر()
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة تقدم()
        إذا (هذا._فهرس < هذا._تاريخ.الطول() - 1)
            هذا._فهرس += 1
            هذا._مسار_حالي = هذا._تاريخ[هذا._فهرس]
            هذا._أخبر()
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة يمكن_العودة()
        ارجع هذا._فهرس > 0
    نهاية

    دالة _أخبر()
        إذا (هذا._عند_التغيير)
            هذا._عند_التغيير(هذا._مسار_حالي)
        نهاية
    نهاية

    دالة ابنِ()
        لكل مسار في هذا._مسارات
            متغير معاملات = مسار.يطابق(هذا._مسار_حالي)
            إذا (معاملات != لاشيء)
                ارجع مسار.باني(معاملات)
            نهاية
        نهاية
        
        إذا (هذا._404)
            ارجع هذا._404()
        نهاية
        
        ارجع لاشيء
    نهاية
نهاية

