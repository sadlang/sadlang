# العيب #99: FutureBuilder / StreamBuilder
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر تعداد حالة_اتصال
    لا_شيء،
    انتظار،
    نشط،
    مكتمل
نهاية

صدّر صنف باني_مستقبل
    باني(إعدادات)
        هذا._مستقبل = إعدادات.مستقبل أو لاشيء
        هذا._باني = إعدادات.باني أو لاشيء
        هذا._قيمة_ابتدائية = إعدادات.قيمة_ابتدائية أو لاشيء
    نهاية

    دالة بناء(سياق)
        متغير حالة = {
            حالة_اتصال: حالة_اتصال.لا_شيء،
            بيانات: هذا._قيمة_ابتدائية،
            خطأ: لاشيء
        }
        
        إذا (هذا._مستقبل)
            حالة.حالة_اتصال = حالة_اتصال.انتظار
            
            هذا._مستقبل
                .ثم(لامدا(نتيجة) =>
                    حالة.حالة_اتصال = حالة_اتصال.مكتمل
                    حالة.بيانات = نتيجة
                    سياق._حدث()
                نهاية)
                .امسك(لامدا(خطأ) =>
                    حالة.حالة_اتصال = حالة_اتصال.مكتمل
                    حالة.خطأ = خطأ
                    سياق._حدث()
                نهاية)
        نهاية
        
        ارجع هذا._باني(سياق، حالة)
    نهاية
