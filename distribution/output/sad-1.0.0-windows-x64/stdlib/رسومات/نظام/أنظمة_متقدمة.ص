    نهاية

    ساكن دالة توجيه_من_سياق(سياق)
        ارجع استعلام_وسائط.من_سياق(سياق).توجيه
    نهاية

    ساكن دالة هاتف؟(سياق)
        متغير عرض = استعلام_وسائط.حجم_من_سياق(سياق).عرض
        ارجع عرض < 600
    نهاية

    ساكن دالة جهاز_لوحي؟(سياق)
        متغير عرض = استعلام_وسائط.حجم_من_سياق(سياق).عرض
        ارجع عرض >= 600 و عرض < 1200
    نهاية

    ساكن دالة سطح_مكتب؟(سياق)
        متغير عرض = استعلام_وسائط.حجم_من_سياق(سياق).عرض
        ارجع عرض >= 1200
    نهاية
نهاية

