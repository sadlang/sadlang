# العيب #92: Localization - التوطين
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف مدير_لغات
    ساكن متغير _مثيل = لاشيء

    ساكن دالة احصل_مثيل()
        إذا (مدير_لغات._مثيل == لاشيء)
            مدير_لغات._مثيل = جديد مدير_لغات()
        نهاية
        ارجع مدير_لغات._مثيل
    نهاية

    باني()
        هذا._لغة_حالية = "ar"
        هذا._ترجمات = {}
        هذا._احتياطي = "en"
        هذا._مشتركون = []
    نهاية

    دالة أضف_ترجمات(لغة، ترجمات)
        هذا._ترجمات[لغة] = ترجمات
    نهاية

    دالة عيّن_لغة(لغة)
        إذا (هذا._ترجمات[لغة])
            هذا._لغة_حالية = لغة
            هذا._أخبر()
        نهاية
    نهاية

    دالة احصل(مفتاح، معاملات)
        متغير نص = هذا._ترجمات[هذا._لغة_حالية]?[مفتاح]
        
        إذا (نص == لاشيء و هذا._احتياطي != هذا._لغة_حالية)
            نص = هذا._ترجمات[هذا._احتياطي]?[مفتاح]
        نهاية
        
        إذا (نص == لاشيء)
            ارجع مفتاح
        نهاية
        
        # استبدال المعاملات
        إذا (معاملات)
            لكل م في معاملات
                نص = نص.استبدل("{" + م + "}"، معاملات[م])
            نهاية
        نهاية
        
        ارجع نص
    نهاية

    دالة اتجاه()
        # العربية والعبرية من اليمين لليسار
        إذا (هذا._لغة_حالية == "ar" أو هذا._لغة_حالية == "he")
            ارجع "rtl"
        نهاية
        ارجع "ltr"
    نهاية

    دالة اشترك(مستمع)
        هذا._مشتركون.أضف(مستمع)
    نهاية

    دالة _أخبر()
        لكل مستمع في هذا._مشتركون
            مستمع(هذا._لغة_حالية)
        نهاية
    نهاية
نهاية

