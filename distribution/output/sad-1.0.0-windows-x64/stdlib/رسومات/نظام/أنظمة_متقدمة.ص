صدّر صنف بيانات_استعلام
    باني(حجم، توجيه، كثافة، هوامش)
        هذا.حجم = حجم أو {عرض: 0، ارتفاع: 0}
        هذا.توجيه = توجيه أو "عمودي"
        هذا.كثافة = كثافة أو 1
        هذا.هوامش = هوامش أو {فوق: 0، تحت: 0، يمين: 0، يسار: 0}
        هذا.وضع_سطوع = "فاتح"
        هذا.تباين_عالي = خطأ
        هذا.حركات_مخفضة = خطأ
    نهاية

    دالة نقاط_منطقية(بكسل)
        ارجع بكسل / هذا.كثافة
    نهاية

    دالة بكسل(نقاط)
        ارجع نقاط * هذا.كثافة
    نهاية
نهاية

صدّر صنف استعلام_وسائط
    ساكن دالة من_سياق(سياق)
        ارجع سياق._استعلام_وسائط
    نهاية

    ساكن دالة حجم_من_سياق(سياق)
