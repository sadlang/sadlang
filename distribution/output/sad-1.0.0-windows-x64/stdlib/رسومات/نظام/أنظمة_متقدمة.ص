# العيب #98: StreamController - متحكم التدفق
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف متحكم_تدفق
    باني(إعدادات)
        هذا._مشتركون = []
        هذا._مغلق = خطأ
        هذا._بث = إعدادات.بث أو خطأ
        هذا._عند_استماع = إعدادات.عند_استماع أو لاشيء
        هذا._عند_إلغاء = إعدادات.عند_إلغاء أو لاشيء
    نهاية

    دالة أضف(قيمة)
        إذا (هذا._مغلق)
            ارمي "لا يمكن الإضافة لتدفق مغلق"
        نهاية
        
        إذا (هذا._بث)
            لكل مشترك في هذا._مشتركون
                مشترك(قيمة)
            نهاية
        وإلا إذا (هذا._مشتركون.الطول() > 0)
            هذا._مشتركون[0](قيمة)
        نهاية
    نهاية

    دالة أضف_خطأ(خطأ)
        إذا (هذا._مغلق)
            ارمي "لا يمكن الإضافة لتدفق مغلق"
        نهاية
        
        لكل مشترك في هذا._مشتركون_أخطاء
            مشترك(خطأ)
        نهاية
    نهاية

    دالة استمع(عند_بيانات، عند_خطأ، عند_اكتمال)
        إذا (ليس هذا._بث و هذا._مشتركون.الطول() > 0)
            ارمي "تدفق أحادي لديه مشترك بالفعل"
        نهاية
        
        هذا._مشتركون.أضف(عند_بيانات)
        
        إذا (هذا._عند_استماع)
            هذا._عند_استماع()
        نهاية
        
        # أرجع اشتراك
        ارجع {
            ألغِ: لامدا() =>
                هذا._مشتركون = هذا._مشتركون.فلتر(لامدا(م) => م != عند_بيانات نهاية)
                إذا (هذا._عند_إلغاء)
                    هذا._عند_إلغاء()
                نهاية
            نهاية
        }
    نهاية

    دالة أغلق()
        هذا._مغلق = صحيح
        هذا._مشتركون = []
    نهاية

    دالة مغلق؟()
        ارجع هذا._مغلق
    نهاية
نهاية

