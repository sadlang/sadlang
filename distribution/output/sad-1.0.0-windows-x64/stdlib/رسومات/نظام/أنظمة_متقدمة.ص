                    حالة.بيانات = بيانات
                    سياق._حدث()
                نهاية،
                لامدا(خطأ) =>
                    حالة.خطأ = خطأ
                    سياق._حدث()
                نهاية
            )
        نهاية
        
        ارجع هذا._باني(سياق، حالة)
    نهاية

    دالة أهمل()
        إذا (هذا._اشتراك)
            هذا._اشتراك.ألغِ()
        نهاية
    نهاية
