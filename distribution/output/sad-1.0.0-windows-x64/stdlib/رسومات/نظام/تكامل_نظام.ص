نهاية

صدّر صنف إشعار
    باني(إعدادات)
        هذا._معرف = إعدادات.معرف أو مولّد_معرف()
        هذا._عنوان = إعدادات.عنوان أو ""
        هذا._محتوى = إعدادات.محتوى أو ""
        هذا._أيقونة = إعدادات.أيقونة أو لاشيء
        هذا._أهمية = إعدادات.أهمية أو أهمية_إشعار.عادية
        هذا._تلقائي_إخفاء = إعدادات.تلقائي_إخفاء أو صحيح
        هذا._مدة = إعدادات.مدة أو 5000
        هذا._عند_الضغط = إعدادات.عند_الضغط أو لاشيء
        هذا._أزرار = إعدادات.أزرار أو []
    نهاية
نهاية

صدّر صنف مدير_إشعارات
    ساكن متغير _مثيل = لاشيء
    
    ساكن دالة احصل_مثيل()
        إذا (مدير_إشعارات._مثيل == لاشيء)
            مدير_إشعارات._مثيل = جديد مدير_إشعارات()
        نهاية
        ارجع مدير_إشعارات._مثيل
    نهاية

    باني()
        هذا._إشعارات = []
        هذا._قناة_افتراضية = "default"
    نهاية

    غير_متزامن دالة اطلب_إذن()
        # طلب إذن الإشعارات
        ارجع صحيح
    نهاية

    دالة أظهر(إشعار)
        هذا._إشعارات.أضف(إشعار)
        # عرض الإشعار محلياً
    نهاية

    دالة ألغِ(معرف)
        هذا._إشعارات = هذا._إشعارات.فلتر(لامدا(إ) => إ._معرف != معرف نهاية)
    نهاية

    دالة ألغِ_الكل()
        هذا._إشعارات = []
    نهاية

    دالة جدول(إشعار، وقت)
        # جدولة إشعار مستقبلي
    نهاية
