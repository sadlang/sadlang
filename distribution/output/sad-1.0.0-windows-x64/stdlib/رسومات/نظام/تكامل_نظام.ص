# #137: DeepLinks
صدّر صنف روابط_عميقة
    ساكن متغير _معالجات = {}
    
    ساكن دالة سجّل_مخطط(مخطط، معالج)
        روابط_عميقة._معالجات[مخطط] = معالج
    نهاية

    ساكن دالة عالج(رابط)
        # تحليل الرابط ومعالجته
        متغير أجزاء = رابط.قسّم("://")
        إذا (أجزاء.الطول() >= 2)
            متغير مخطط = أجزاء[0]
            إذا (روابط_عميقة._معالجات[مخطط])
                روابط_عميقة._معالجات[مخطط](رابط)
            نهاية
        نهاية
    نهاية

    ساكن غير_متزامن دالة احصل_رابط_ابتدائي()
        # الرابط الذي فتح التطبيق
        ارجع لاشيء
    نهاية
