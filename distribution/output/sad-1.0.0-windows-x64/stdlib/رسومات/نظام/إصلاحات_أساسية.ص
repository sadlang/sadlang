# العيب #14: Focus Management - إدارة التركيز
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف مدير_تركيز
    ساكن متغير _مثيل = لاشيء

    ساكن دالة احصل_مثيل()
        إذا (مدير_تركيز._مثيل == لاشيء)
            مدير_تركيز._مثيل = جديد مدير_تركيز()
        نهاية
        ارجع مدير_تركيز._مثيل
    نهاية

    باني()
        هذا._حالي = لاشيء
        هذا._تاريخ = []
        هذا._نطاقات = []
        هذا._فخاخ = []
    نهاية

    دالة ركّز(عنصر)
        إذا (عنصر == هذا._حالي)
            ارجع
        نهاية

        # تحقق من الفخاخ
        إذا (هذا._فخاخ.الطول() > 0)
            متغير فخ = هذا._فخاخ[-1]
            إذا (ليس هذا._داخل_فخ(عنصر، فخ))
                ارجع  # لا يمكن التركيز خارج الفخ
            نهاية
        نهاية

        متغير سابق = هذا._حالي
        
        إذا (سابق != لاشيء)
            سابق._عند_فقدان_تركيز؟()
            هذا._تاريخ.أضف(سابق)
        نهاية

        هذا._حالي = عنصر
        
        إذا (عنصر != لاشيء)
            عنصر._عند_كسب_تركيز؟()
        نهاية
    نهاية

    دالة ألغِ_تركيز()
        إذا (هذا._حالي != لاشيء)
            هذا._حالي._عند_فقدان_تركيز؟()
            هذا._حالي = لاشيء
        نهاية
    نهاية

    دالة التالي()
        متغير قائمة = هذا._احصل_قابلة_للتركيز()
        إذا (قائمة.الطول() == 0)
            ارجع
        نهاية

        متغير فهرس = -1
        إذا (هذا._حالي != لاشيء)
            فهرس = قائمة.فهرس(هذا._حالي)
        نهاية

        متغير تالي = (فهرس + 1) % قائمة.الطول()
        هذا.ركّز(قائمة[تالي])
    نهاية

    دالة السابق()
        متغير قائمة = هذا._احصل_قابلة_للتركيز()
        إذا (قائمة.الطول() == 0)
            ارجع
        نهاية

        متغير فهرس = 0
        إذا (هذا._حالي != لاشيء)
            فهرس = قائمة.فهرس(هذا._حالي)
        نهاية

        متغير سابق = (فهرس - 1 + قائمة.الطول()) % قائمة.الطول()
        هذا.ركّز(قائمة[سابق])
    نهاية

    دالة _احصل_قابلة_للتركيز()
        # TODO: جمع من الشجرة
        ارجع []
    نهاية

    # فخاخ التركيز (للحوارات)
    دالة أضف_فخ(عنصر)
        هذا._فخاخ.أضف(عنصر)
    نهاية

    دالة أزل_فخ(عنصر)
        هذا._فخاخ = هذا._فخاخ.فلتر(لامدا(ف) => ف != عنصر)
        
        # أرجع التركيز للسابق
        إذا (هذا._تاريخ.الطول() > 0)
            هذا.ركّز(هذا._تاريخ.انزع())
        نهاية
    نهاية

    دالة _داخل_فخ(عنصر، فخ)
        متغير حالي = عنصر
        بينما (حالي != لاشيء)
            إذا (حالي == فخ)
                ارجع صحيح
            نهاية
            حالي = حالي._أب
        نهاية
        ارجع خطأ
    نهاية

    دالة الحالي()
        ارجع هذا._حالي
    نهاية
نهاية

