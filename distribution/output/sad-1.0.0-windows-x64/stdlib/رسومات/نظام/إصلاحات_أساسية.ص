# العيب #15: Platform Channels - قنوات المنصة
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف قناة_منصة
    باني(اسم)
        هذا._اسم = اسم
        هذا._معالجات = {}
    نهاية

    غير_متزامن دالة أرسل(طريقة، وسائط)
        # أرسل للمنصة الأصلية
        متغير نتيجة = انتظر _قناة_أرسل(هذا._اسم، طريقة، وسائط)
        ارجع نتيجة
    نهاية

    دالة عيّن_معالج(طريقة، دالة_معالج)
        هذا._معالجات[طريقة] = دالة_معالج
    نهاية

    دالة _عالج(طريقة، وسائط)
        متغير معالج = هذا._معالجات[طريقة]
        إذا (معالج != لاشيء)
            ارجع معالج(وسائط)
        نهاية
        ارجع لاشيء
    نهاية
نهاية

صدّر صنف قناة_طريقة يرث قناة_منصة
    باني(اسم، مشفّر)
        الأساس(اسم)
        هذا._مشفّر = مشفّر أو جديد مشفّر_JSON()
    نهاية

    غير_متزامن دالة استدعِ(طريقة، وسائط)
        متغير رسالة = هذا._مشفّر.شفّر({طريقة: طريقة، وسائط: وسائط})
        متغير استجابة = انتظر هذا.أرسل("call", رسالة)
        ارجع هذا._مشفّر.فك(استجابة)
    نهاية
نهاية

صدّر صنف قناة_أحداث يرث قناة_منصة
    باني(اسم)
        الأساس(اسم)
        هذا._مشتركون = []
    نهاية

    دالة استمع(دالة_callback)
        هذا._مشتركون.أضف(دالة_callback)
        
        # ابدأ الاستماع إذا أول مشترك
        إذا (هذا._مشتركون.الطول() == 1)
            هذا.أرسل("listen"، {})
        نهاية
        
        # دالة إلغاء
        ارجع لامدا() =>
            هذا._مشتركون = هذا._مشتركون.فلتر(لامدا(م) => م != دالة_callback)
            إذا (هذا._مشتركون.الطول() == 0)
                هذا.أرسل("cancel"، {})
            نهاية
        نهاية
    نهاية

    دالة _عند_حدث(بيانات)
        لكل مشترك في هذا._مشتركون
            مشترك(بيانات)
        نهاية
    نهاية
نهاية

صدّر صنف مشفّر_JSON
    دالة شفّر(كائن)
        ارجع JSON.نص(كائن)
    نهاية

    دالة فك(نص)
        ارجع JSON.حلل(نص)
    نهاية
نهاية
