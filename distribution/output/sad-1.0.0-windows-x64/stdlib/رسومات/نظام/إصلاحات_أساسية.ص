# العيب #11: Hit Testing - اختبار الإصابة
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف مختبر_إصابة
    باني()
        هذا._شجرة = لاشيء
        هذا._ذاكرة = {}
    نهاية

    دالة عيّن_شجرة(جذر)
        هذا._شجرة = جذر
        هذا._ذاكرة = {}
    نهاية

    دالة اختبر(س، ص)
        إذا (هذا._شجرة == لاشيء)
            ارجع لاشيء
        نهاية
        
        # ابحث من الأعلى للأسفل
        ارجع هذا._اختبر_عقدة(هذا._شجرة، س، ص)
    نهاية

    دالة _اختبر_عقدة(عقدة، س، ص)
        # تحقق من الحدود
        إذا (ليس هذا._داخل_حدود(عقدة، س، ص))
            ارجع لاشيء
        نهاية
        
        # اختبر الأبناء بترتيب عكسي (الأعلى أولاً)
        لكل ي في نطاق(عقدة._أبناء.الطول() - 1، -1، -1)
            متغير نتيجة = هذا._اختبر_عقدة(عقدة._أبناء[ي]، س، ص)
            إذا (نتيجة != لاشيء)
                ارجع نتيجة
            نهاية
        نهاية
        
        # إذا العقدة تستقبل الأحداث
        إذا (عقدة._تستقبل_أحداث != خطأ)
            ارجع عقدة
        نهاية
        
        ارجع لاشيء
    نهاية

    دالة _داخل_حدود(عقدة، س، ص)
        متغير حدود = عقدة._حدود أو {س: 0، ص: 0، عرض: 0، ارتفاع: 0}
        ارجع س >= حدود.س و 
               س <= حدود.س + حدود.عرض و
               ص >= حدود.ص و 
               ص <= حدود.ص + حدود.ارتفاع
    نهاية

    دالة اختبر_مسار(س، ص)
        # أرجع جميع العقد من الجذر للهدف
        متغير مسار = []
        هذا._ابن_مسار(هذا._شجرة، س، ص، مسار)
        ارجع مسار
    نهاية

    دالة _ابن_مسار(عقدة، س، ص، مسار)
        إذا (عقدة == لاشيء)
            ارجع خطأ
        نهاية
        
        إذا (ليس هذا._داخل_حدود(عقدة، س، ص))
            ارجع خطأ
        نهاية
        
        مسار.أضف(عقدة)
        
        لكل ابن في عقدة._أبناء
            إذا (هذا._ابن_مسار(ابن، س، ص، مسار))
                ارجع صحيح
            نهاية
        نهاية
        
        ارجع صحيح
    نهاية
نهاية

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# العيب #12: Layer Caching - تخزين الطبقات
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف ذاكرة_طبقات
    باني(حد_ذاكرة_ميجا)
        هذا._حد = (حد_ذاكرة_ميجا أو 128) * 1024 * 1024
        هذا._طبقات = {}
        هذا._حجم_حالي = 0
        هذا._ترتيب_استخدام = []
    نهاية

    دالة احصل(معرف)
        إذا (هذا._طبقات[معرف] != لاشيء)
            # انقل للنهاية (LRU)
            هذا._ترتيب_استخدام = هذا._ترتيب_استخدام.فلتر(لامدا(م) => م != معرف)
            هذا._ترتيب_استخدام.أضف(معرف)
            ارجع هذا._طبقات[معرف].بيانات
        نهاية
        ارجع لاشيء
    نهاية

    دالة خزّن(معرف، بيانات، حجم)
        # تأكد من وجود مساحة
        بينما (هذا._حجم_حالي + حجم > هذا._حد و هذا._ترتيب_استخدام.الطول() > 0)
            متغير أقدم = هذا._ترتيب_استخدام[0]
            هذا.احذف(أقدم)
        نهاية
        
        # خزّن
        هذا._طبقات[معرف] = {بيانات: بيانات، حجم: حجم}
        هذا._حجم_حالي += حجم
        هذا._ترتيب_استخدام.أضف(معرف)
    نهاية

    دالة احذف(معرف)
        إذا (هذا._طبقات[معرف] != لاشيء)
            هذا._حجم_حالي -= هذا._طبقات[معرف].حجم
            احذف هذا._طبقات[معرف]
            هذا._ترتيب_استخدام = هذا._ترتيب_استخدام.فلتر(لامدا(م) => م != معرف)
        نهاية
    نهاية

    دالة أبطل(معرف)
        هذا.احذف(معرف)
    نهاية

    دالة نظّف()
        هذا._طبقات = {}
        هذا._حجم_حالي = 0
        هذا._ترتيب_استخدام = []
    نهاية

    دالة إحصائيات()
        ارجع {
            عدد_الطبقات: مفاتيح(هذا._طبقات).الطول()،
            حجم_مستخدم: هذا._حجم_حالي،
            حجم_أقصى: هذا._حد،
            نسبة_استخدام: (هذا._حجم_حالي / هذا._حد) * 100
        }
    نهاية
نهاية

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# العيب #13: Image Caching - تخزين الصور
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف ذاكرة_صور
    ساكن متغير _مثيل = لاشيء

    ساكن دالة احصل_مثيل()
        إذا (ذاكرة_صور._مثيل == لاشيء)
            ذاكرة_صور._مثيل = جديد ذاكرة_صور()
        نهاية
        ارجع ذاكرة_صور._مثيل
    نهاية

    باني()
        هذا._ذاكرة = جديد ذاكرة_طبقات(64)  # 64 ميجا للصور
        هذا._جاري_التحميل = {}
        هذا._مستمعون = {}
    نهاية

    غير_متزامن دالة حمّل(مسار)
        # من الذاكرة؟
        متغير محفوظ = هذا._ذاكرة.احصل(مسار)
        إذا (محفوظ != لاشيء)
            ارجع محفوظ
        نهاية

        # جاري التحميل؟
        إذا (هذا._جاري_التحميل[مسار])
            # انتظر
            ارجع انتظر هذا._انتظر_تحميل(مسار)
        نهاية

        # حمّل
        هذا._جاري_التحميل[مسار] = صحيح
        
        حاول
            متغير صورة = انتظر _حمّل_صورة(مسار)
            متغير حجم = صورة.عرض * صورة.ارتفاع * 4  # RGBA
            
            هذا._ذاكرة.خزّن(مسار، صورة، حجم)
            هذا._أخبر_منتظرين(مسار، صورة)
            
            ارجع صورة
        امسك (خطأ)
            هذا._أخبر_منتظرين(مسار، لاشيء، خطأ)
            ارمي خطأ
        أخيراً
            احذف هذا._جاري_التحميل[مسار]
        نهاية
    نهاية

    دالة _انتظر_تحميل(مسار)
        ارجع جديد وعد(لامدا(نجاح، فشل) =>
            إذا (هذا._مستمعون[مسار] == لاشيء)
                هذا._مستمعون[مسار] = []
            نهاية
            هذا._مستمعون[مسار].أضف({نجاح: نجاح، فشل: فشل})
        نهاية)
    نهاية

    دالة _أخبر_منتظرين(مسار، صورة، خطأ)
        متغير منتظرون = هذا._مستمعون[مسار] أو []
        احذف هذا._مستمعون[مسار]
        
        لكل منتظر في منتظرون
            إذا (خطأ)
                منتظر.فشل(خطأ)
            وإلا
                منتظر.نجاح(صورة)
            نهاية
        نهاية
    نهاية

    دالة أبطل(مسار)
        هذا._ذاكرة.أبطل(مسار)
    نهاية

    دالة نظّف()
        هذا._ذاكرة.نظّف()
    نهاية
نهاية

