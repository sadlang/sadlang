# ===================================================================
# عناصر واجهة إضافية — فريدة (بعد إزالة التكرارات)
# ===================================================================
# عناصر غير موجودة في ملفات أخرى
# الأصناف المحذوفة (توجد في حاويات/ أو تحكم.ص أو أزرار.ص):
#   خطوات → عناصر/تحكم.ص
#   خطوة → عناصر/تحكم.ص  
#   درج → حاويات/تنقل.ص
#   زر_عائم → عناصر/أزرار.ص
#   شريط_سفلي → حاويات/تنقل.ص
#   شريط_بحث → عناصر/إدخال.ص (كحقل_بحث)
#   لافتة → حاويات/حركة.ص (كتنبيه)
#   شريط_أدوات → حاويات/تنقل_متقدم.ص
#   قائمة_منبثقة → حاويات/حوارات.ص
#   عنصر_منبثق → حاويات/حوارات.ص
#   مسار_تنقل → حاويات/بيانات.ص
#
# الاستخدام:
#   استورد * من رسومات.عناصر.متقدمة
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── لوح_سفلي (BottomSheet) ───
صدّر صنف لوح_سفلي يرث عنصر
    باني(طفل = لاشيء, ارتفاع = لاشيء, زوايا = لاشيء, قابل_سحب = لاشيء, عند_إغلاق = لاشيء, لون = لاشيء)
        هذا._نوع = "لوح_سفلي"
        هذا._خصائص = {}
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["زوايا"] = زوايا
        هذا._خصائص["قابل_سحب"] = قابل_سحب
        هذا._خصائص["عند_إغلاق"] = عند_إغلاق
        هذا._خصائص["لون"] = لون
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

