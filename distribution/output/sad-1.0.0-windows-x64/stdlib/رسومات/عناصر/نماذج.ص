# ─── تحقق (Validators — دوال تحقق جاهزة) ───
صدّر صنف تحقق
    دالة مطلوب(قيمة, رسالة = "هذا الحقل مطلوب")
        إذا (قيمة == لاشيء أو قيمة == "")
            ارجع رسالة
        نهاية
        ارجع لاشيء
    نهاية

    دالة حد_أدنى_طول(قيمة, طول, رسالة = "قصير جداً")
        إذا (قيمة != لاشيء و قيمة.الطول() < طول)
            ارجع رسالة
        نهاية
        ارجع لاشيء
    نهاية

    دالة بريد_إلكتروني(قيمة, رسالة = "بريد إلكتروني غير صحيح")
        إذا (قيمة != لاشيء و ليس قيمة.يحتوي("@"))
            ارجع رسالة
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ─── متحكم_نص (TextEditingController) ───
صدّر صنف متحكم_نص
    باني(نص = "")
        هذا._نص = نص
        هذا._تحديد = {"بدء": 0, "انتهاء": 0}
        هذا._مستمعون = []
    نهاية

    دالة النص()
        ارجع هذا._نص
    نهاية

    دالة عيّن_نص(قيمة)
        هذا._نص = قيمة
    نهاية

    دالة مسح()
        هذا._نص = ""
    نهاية

    دالة أضف_مستمع(رد_نداء)
        هذا._مستمعون = هذا._مستمعون + [رد_نداء]
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
    نهاية
نهاية
