# ===================================================================
# عناصر متقدمة — نماذج ومدخلات
# ===================================================================
# نماذج وتحقق من المدخلات
#
# الاستخدام:
#   استورد * من رسومات.عناصر.نماذج
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── نموذج (Form) ───
صدّر صنف نموذج يرث عنصر
    باني(مفتاح = لاشيء, ابن = لاشيء, عند_التغيير = لاشيء)
        هذا._نوع = "نموذج"
        هذا._خصائص = {}
        هذا._خصائص["مفتاح"] = مفتاح
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["حفظ_تلقائي"] = خطأ
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

# ─── حقل_نموذج (FormField) ───
صدّر صنف حقل_نموذج يرث عنصر
    باني(تسمية = "", مطلوب = خطأ, تحقق = لاشيء)
        هذا._نوع = "حقل_نموذج"
        هذا._خصائص = {}
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["مطلوب"] = مطلوب
        هذا._خصائص["تحقق"] = تحقق
        هذا._خصائص["قيمة_ابتدائية"] = لاشيء
        هذا._خصائص["رسالة_خطأ"] = لاشيء
        هذا._خصائص["ممكن"] = صحيح
        هذا._أبناء = []
    نهاية
نهاية

