        هذا._يملأ_تلقائياً = يملأ_تلقائياً
        هذا._يتقلص = يتقلص_عند_التمرير
    نهاية
نهاية

# ─── شريحة_حشو (SliverPadding) ───
صدّر صنف شريحة_حشو يرث شريحة
    باني(حشو, شريحة_فرعية)
        الأساس()
        هذا._نوع = "شريحة_حشو"
        هذا._حشو = حشو
        هذا._شريحة = شريحة_فرعية
    نهاية
نهاية

# ─── عرض_تمرير_مخصص (CustomScrollView) ───
صدّر صنف عرض_تمرير_مخصص يرث عنصر
    باني(شرائح = [], متحكم = لاشيء, اتجاه = "عمودي", معكوس = خطأ)
        هذا._نوع = "عرض_تمرير_مخصص"
        هذا._شرائح = شرائح
        هذا._متحكم = متحكم
        هذا._اتجاه = اتجاه
        هذا._معكوس = معكوس
        هذا._موقع_التمرير = 0
    نهاية

    دالة الشرائح()
        ارجع هذا._شرائح
    نهاية

    دالة أضف_شريحة(شريحة)
        هذا._شرائح = هذا._شرائح + [شريحة]
        ارجع هذا
    نهاية

    دالة مرّر_إلى(موقع, متحرك = صحيح)
        هذا._موقع_التمرير = موقع
        ارجع هذا
    نهاية
نهاية

# ─── عرض_متداخل_التمرير (NestedScrollView) ───
صدّر صنف عرض_متداخل_التمرير يرث عنصر
    باني(رأس_شرائح = [], جسم)
        هذا._نوع = "عرض_متداخل_التمرير"
        هذا._رأس_شرائح = رأس_شرائح
        هذا._جسم = جسم
    نهاية
نهاية

# ─── دوال مساعدة ───
صدّر دالة قائمة_افتراضية(بانٍ, عدد = لاشيء)
    ارجع جديد شريحة_قائمة(بانٍ)
نهاية

صدّر دالة شبكة_افتراضية(بانٍ, أعمدة = 2)
    ارجع جديد شريحة_شبكة(بانٍ, أعمدة)
نهاية

صدّر دالة شريط_تطبيق_قابل_للتمدد(عنوان, خلفية_مرنة = لاشيء, ارتفاع_موسع = 200)
    ارجع جديد شريحة_شريط_تطبيق(
        عنوان = عنوان,
        خلفية_مرنة = خلفية_مرنة,
        ارتفاع_موسع = ارتفاع_موسع
    )
نهاية
