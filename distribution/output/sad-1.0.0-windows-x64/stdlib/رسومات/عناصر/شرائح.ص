# ─── قيود_شريحة (SliverConstraints) ───
صدّر صنف قيود_شريحة
    باني()
        هذا.اتجاه_المحور = "عمودي"
        هذا.اتجاه_النمو = "للأمام"
        هذا.تراجع_التمرير = 0
        هذا.تداخل_سابق = 0
        هذا.مساحة_متبقية = 0
        هذا.عرض_المقطع = 0
        هذا.محاذاة = 0.0
    نهاية
نهاية

# ─── هندسة_شريحة (SliverGeometry) ───
صدّر صنف هندسة_شريحة
    باني()
        هذا.مساحة_تمرير = 0
        هذا.مساحة_رسم = 0
        هذا.مساحة_رسم_قصوى = 0
        هذا.ارتفاع_عنصر = 0
        هذا.يحتاج_قص = خطأ
        هذا.وصل_النهاية = خطأ
        هذا.تراجع_تمرير_محسوب = 0
    نهاية
نهاية

# ─── شريحة_أساسية (SliverBase) ───
صدّر صنف شريحة يرث عنصر
    باني()
        هذا._نوع = "شريحة"
        هذا._قيود = جديد قيود_شريحة()
        هذا._هندسة = جديد هندسة_شريحة()
    نهاية

    دالة احسب_التخطيط(قيود)
        هذا._قيود = قيود
        # يجب تجاوزها في الأصناف الفرعية
        ارجع هذا._هندسة
    نهاية

    دالة الهندسة()
        ارجع هذا._هندسة
    نهاية
نهاية

# ─── شريحة_قائمة (SliverList) — قائمة افتراضية ───
صدّر صنف شريحة_قائمة يرث شريحة
    باني(مفوض_بناء)
        الأساس()
        هذا._نوع = "شريحة_قائمة"
        هذا._مفوض = مفوض_بناء
        هذا._عناصر_مؤقتة = {}
        هذا._فهرس_أول = 0
        هذا._فهرس_آخر = 0
    نهاية

    # ─── بناء عنصر عند فهرس ───
    دالة _ابنِ_عنصر(فهرس)
        إذا (هذا._عناصر_مؤقتة[فهرس] == لاشيء)
            هذا._عناصر_مؤقتة[فهرس] = هذا._مفوض(فهرس)
        نهاية
        ارجع هذا._عناصر_مؤقتة[فهرس]
    نهاية

    # ─── تنظيف عناصر خارج النطاق ───
    دالة _نظّف_خارج_النطاق(فهرس_أول, فهرس_آخر)
        متغير للحذف = []
        لكل فهرس, _ في هذا._عناصر_مؤقتة
            إذا (فهرس < فهرس_أول أو فهرس > فهرس_آخر)
                للحذف = للحذف + [فهرس]
            نهاية
        نهاية
        لكل فهرس في للحذف
            هذا._عناصر_مؤقتة[فهرس] = لاشيء
        نهاية
    نهاية

    دالة احسب_التخطيط(قيود)
        هذا._قيود = قيود
        
        # حساب العناصر المرئية
        متغير موقع_البدء = قيود.تراجع_التمرير
        متغير مساحة_متبقية = قيود.مساحة_متبقية
        
        هذا._فهرس_أول = (موقع_البدء / 50).صحيح()  # افتراض ارتفاع 50
        هذا._فهرس_آخر = هذا._فهرس_أول + (مساحة_متبقية / 50).صحيح() + 2
        
        # تنظيف العناصر غير المرئية
        هذا._نظّف_خارج_النطاق(هذا._فهرس_أول - 2, هذا._فهرس_آخر + 2)
        
        هذا._هندسة.مساحة_تمرير = مساحة_متبقية
        هذا._هندسة.مساحة_رسم = مساحة_متبقية
        
        ارجع هذا._هندسة
    نهاية

    دالة العناصر_المرئية()
        متغير عناصر = []
        متغير ف = هذا._فهرس_أول
        بينما (ف <= هذا._فهرس_آخر)
            عناصر = عناصر + [هذا._ابنِ_عنصر(ف)]
            ف = ف + 1
        نهاية
        ارجع عناصر
    نهاية
نهاية

# ─── شريحة_شبكة (SliverGrid) — شبكة افتراضية ───
صدّر صنف شريحة_شبكة يرث شريحة
    باني(مفوض_بناء, أعمدة = 2)
        الأساس()
        هذا._نوع = "شريحة_شبكة"
        هذا._مفوض = مفوض_بناء
        هذا._أعمدة = أعمدة
        هذا._عناصر_مؤقتة = {}
    نهاية

    دالة _ابنِ_عنصر(فهرس)
        إذا (هذا._عناصر_مؤقتة[فهرس] == لاشيء)
            هذا._عناصر_مؤقتة[فهرس] = هذا._مفوض(فهرس)
        نهاية
        ارجع هذا._عناصر_مؤقتة[فهرس]
    نهاية
نهاية

# ─── شريحة_رأس_ثابت (SliverPersistentHeader) ───
صدّر صنف شريحة_رأس_ثابت يرث شريحة
    باني(بانٍ, ارتفاع_أدنى = 56, ارتفاع_أقصى = 200, ملتصق = صحيح)
        الأساس()
        هذا._نوع = "شريحة_رأس_ثابت"
        هذا._بانٍ = بانٍ
        هذا._ارتفاع_أدنى = ارتفاع_أدنى
        هذا._ارتفاع_أقصى = ارتفاع_أقصى
        هذا._ملتصق = ملتصق
    نهاية

    دالة ملتصق()
        ارجع هذا._ملتصق
    نهاية

    دالة احسب_الارتفاع(تراجع_التمرير, تداخل)
        متغير نسبة = 1.0 - (تراجع_التمرير / هذا._ارتفاع_أقصى)
        إذا (نسبة < 0) نسبة = 0 نهاية
        إذا (نسبة > 1) نسبة = 1 نهاية
        
        ارجع هذا._ارتفاع_أدنى + (هذا._ارتفاع_أقصى - هذا._ارتفاع_أدنى) * نسبة
    نهاية

    دالة ابنِ(سياق, تراجع_التمرير, تداخل)
        ارجع هذا._بانٍ(سياق, تراجع_التمرير, تداخل)
    نهاية
نهاية

# ─── شريحة_شريط_تطبيق (SliverAppBar) ───
صدّر صنف شريحة_شريط_تطبيق يرث شريحة_رأس_ثابت
    باني(
        عنوان = لاشيء,
        خلفية = لاشيء,
        خلفية_مرنة = لاشيء,
        ارتفاع_موسع = 200,
        ملتصق = صحيح,
        عائم = خطأ,
        ينطبق_فوراً = خطأ
    )
        الأساس(لاشيء, 56, ارتفاع_موسع, ملتصق)
        هذا._نوع = "شريحة_شريط_تطبيق"
        هذا._عنوان = عنوان
        هذا._خلفية = خلفية
        هذا._خلفية_مرنة = خلفية_مرنة
        هذا._عائم = عائم
        هذا._ينطبق_فوراً = ينطبق_فوراً
    نهاية

    دالة عائم()
        ارجع هذا._عائم
    نهاية
نهاية

# ─── شريحة_لملء_المتبقي (SliverFillRemaining) ───
صدّر صنف شريحة_لملء_المتبقي يرث شريحة
    باني(ابن, يملأ_تلقائياً = صحيح, يتقلص_عند_التمرير = صحيح)
