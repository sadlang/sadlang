# ===================================================================
# عناصر متقدمة — واجهة المستخدم التكيفية
# ===================================================================
# عناصر تتكيف مع حجم الشاشة والمنصة
#
# الاستخدام:
#   استورد * من رسومات.عناصر.تكيفية
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── بناء_تكيفي (LayoutBuilder) ───
صدّر صنف بناء_تكيفي يرث عنصر
    باني(صانع = لاشيء)
        هذا._نوع = "بناء_تكيفي"
        هذا._خصائص = {}
        هذا._خصائص["صانع"] = صانع
        هذا._أبناء = []
    نهاية
نهاية

# ─── استعلام_وسائط (MediaQuery) ───
صدّر صنف استعلام_وسائط يرث عنصر
    باني(ابن = لاشيء)
        هذا._نوع = "استعلام_وسائط"
        هذا._خصائص = {}
        هذا._خصائص["عرض"] = 0
        هذا._خصائص["ارتفاع"] = 0
        هذا._خصائص["اتجاه"] = "عمودي"
        هذا._خصائص["كثافة_بكسل"] = 1.0
        هذا._خصائص["حواف_آمنة"] = {"أعلى": 0, "أسفل": 0, "يسار": 0, "يمين": 0}
        هذا._خصائص["وضع_داكن"] = خطأ
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

# ─── نقاط_توقف (Breakpoints) ───
صدّر صنف نقاط_توقف
    ساكن ثابت جوال = 600
    ساكن ثابت لوحي = 900
    ساكن ثابت حاسوب = 1200
    ساكن ثابت شاشة_كبيرة = 1800
نهاية

