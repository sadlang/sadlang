# ===================================================================
#                    نص أساسي
# ===================================================================

صدّر صنف نص يرث عنصر
    باني(محتوى, حجم = لاشيء, لون = لاشيء, خلفية = لاشيء, نوع_الخط = لاشيء, وزن = لاشيء, محاذاة = لاشيء, ارتفاع_السطر = لاشيء, تزيين = لاشيء, حد_الأسطر = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "نص"
        هذا._خصائص = {}
        هذا._خصائص["محتوى"] = محتوى
        هذا._خصائص["حجم"] = حجم
        هذا._خصائص["لون"] = لون
        هذا._خصائص["خلفية"] = خلفية
        هذا._خصائص["نوع_الخط"] = نوع_الخط
        هذا._خصائص["وزن"] = وزن
        هذا._خصائص["محاذاة"] = محاذاة
        هذا._خصائص["ارتفاع_السطر"] = ارتفاع_السطر
        هذا._خصائص["تزيين"] = تزيين
        هذا._خصائص["حد_الأسطر"] = حد_الأسطر
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    دالة احصل_المحتوى()
        ارجع هذا._خصائص["محتوى"]
    نهاية

    دالة احصل_الحجم()
        ارجع هذا._خصائص["حجم"]
    نهاية

    دالة احصل_اللون()
        ارجع هذا._خصائص["لون"]
    نهاية

    دالة احصل_الوزن()
        ارجع هذا._خصائص["وزن"]
    نهاية

    دالة عيّن_المحتوى(قيمة)
        هذا._خصائص["محتوى"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_الحجم(قيمة)
        هذا._خصائص["حجم"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_اللون(لون)
        هذا._خصائص["لون"] = لون
        ارجع هذا
    نهاية

    دالة عيّن_الوزن(وزن)
        هذا._خصائص["وزن"] = وزن
        ارجع هذا
    نهاية

    دالة عيّن_المحاذاة(محاذاة)
        هذا._خصائص["محاذاة"] = محاذاة
        ارجع هذا
    نهاية
نهاية

