# #44: SliverAppBar
صدّر صنف شريط_تطبيق_منزلق
    باني(إعدادات)
        هذا._عنوان = إعدادات.عنوان
        هذا._خلفية_مرنة = إعدادات.خلفية_مرنة
        هذا._ارتفاع_موسع = إعدادات.ارتفاع_موسع أو 200
        هذا._مثبت = إعدادات.مثبت أو خطأ
        هذا._عائم = إعدادات.عائم أو خطأ
        هذا._تقدم_انهيار = 0
    نهاية

    دالة حدّث_تقدم(موضع_تمرير)
        هذا._تقدم_انهيار = محصور(موضع_تمرير / (هذا._ارتفاع_موسع - 56)، 0، 1)
    نهاية

    دالة الارتفاع_الحالي()
        متغير فرق = هذا._ارتفاع_موسع - 56
        ارجع هذا._ارتفاع_موسع - (فرق * هذا._تقدم_انهيار)
    نهاية
نهاية

