    نهاية
نهاية

# #46: NestedScrollView
صدّر صنف عرض_تمرير_متداخل
    باني(رأس، جسم)
        هذا._رأس = رأس
        هذا._جسم = جسم
        هذا._متحكم_خارجي = جديد متحكم_تمرير()
        هذا._متحكم_داخلي = جديد متحكم_تمرير()
    نهاية

    دالة عند_تمرير_خارجي(موضع)
        # مرر الرأس أولاً
        إذا (موضع < هذا._ارتفاع_رأس)
            هذا._رأس.مرر(موضع)
        وإلا
            # مرر الجسم
            هذا._جسم.مرر(موضع - هذا._ارتفاع_رأس)
        نهاية
    نهاية
نهاية

# #47: Orientation Handler
صدّر صنف معالج_اتجاه
    ساكن متغير _مستمعون = []
    ساكن متغير _اتجاه_حالي = "عمودي"

    ساكن دالة استمع(دالة_callback)
        معالج_اتجاه._مستمعون.أضف(دالة_callback)
        ارجع لامدا() =>
            معالج_اتجاه._مستمعون = معالج_اتجاه._مستمعون.فلتر(لامدا(م) => م != دالة_callback)
        نهاية
    نهاية

    ساكن دالة _أبلغ(اتجاه)
