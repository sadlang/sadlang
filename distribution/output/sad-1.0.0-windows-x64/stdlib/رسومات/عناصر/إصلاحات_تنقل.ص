# العيب #40: Stepper - خطّاط
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف خطّاط
    باني(خطوات، إعدادات)
        هذا._خطوات = خطوات
        هذا._فهرس_حالي = 0
        هذا._نوع = إعدادات.نوع أو "عمودي"  # عمودي أو أفقي
        هذا._عند_استمرار = إعدادات.عند_استمرار
        هذا._عند_إلغاء = إعدادات.عند_إلغاء
    نهاية

    دالة التالي()
        إذا (هذا._فهرس_حالي < هذا._خطوات.الطول() - 1)
            هذا._خطوات[هذا._فهرس_حالي].حالة = "مكتمل"
            هذا._فهرس_حالي += 1
            هذا._خطوات[هذا._فهرس_حالي].حالة = "حالي"
            
            إذا (هذا._عند_استمرار)
                هذا._عند_استمرار(هذا._فهرس_حالي)
            نهاية
        نهاية
    نهاية

    دالة السابق()
        إذا (هذا._فهرس_حالي > 0)
            هذا._خطوات[هذا._فهرس_حالي].حالة = "معلق"
            هذا._فهرس_حالي -= 1
            هذا._خطوات[هذا._فهرس_حالي].حالة = "حالي"
            
            إذا (هذا._عند_إلغاء)
                هذا._عند_إلغاء(هذا._فهرس_حالي)
            نهاية
        نهاية
    نهاية

    دالة اذهب_إلى(فهرس)
        إذا (فهرس >= 0 و فهرس < هذا._خطوات.الطول())
            هذا._خطوات[هذا._فهرس_حالي].حالة = "معلق"
            هذا._فهرس_حالي = فهرس
            هذا._خطوات[هذا._فهرس_حالي].حالة = "حالي"
        نهاية
    نهاية
نهاية

