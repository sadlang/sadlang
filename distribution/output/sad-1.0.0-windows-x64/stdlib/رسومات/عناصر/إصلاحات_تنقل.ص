# العيب #43: RefreshIndicator - مؤشر التحديث
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف مؤشر_تحديث
    باني(ابن، عند_تحديث)
        هذا._ابن = ابن
        هذا._عند_تحديث = عند_تحديث
        هذا._جاري_تحديث = خطأ
        هذا._موضع_سحب = 0
        هذا._عتبة = 100
    نهاية

    دالة عند_سحب(موضع)
        إذا (موضع.ص > 0)
            هذا._موضع_سحب = مين(موضع.ص، هذا._عتبة * 1.5)
        نهاية
    نهاية

    غير_متزامن دالة عند_نهاية_سحب()
        إذا (هذا._موضع_سحب >= هذا._عتبة و ليس هذا._جاري_تحديث)
            هذا._جاري_تحديث = صحيح
            
            حاول
                انتظر هذا._عند_تحديث()
            أخيراً
                هذا._جاري_تحديث = خطأ
                هذا._موضع_سحب = 0
            نهاية
        وإلا
            هذا._موضع_سحب = 0
        نهاية
    نهاية
نهاية

