# #49: GlobalKey
صدّر صنف مفتاح_عام
    ساكن متغير _سجل = {}

    باني()
        هذا._معرف = _أنشئ_معرف()
        هذا._حالة = لاشيء
        هذا._عنصر = لاشيء
    نهاية

    دالة سجّل(حالة، عنصر)
        هذا._حالة = حالة
        هذا._عنصر = عنصر
        مفتاح_عام._سجل[هذا._معرف] = هذا
    نهاية

    دالة ألغِ_تسجيل()
        احذف مفتاح_عام._سجل[هذا._معرف]
        هذا._حالة = لاشيء
