# العيب #42: DataTable - جدول بيانات
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف جدول_بيانات
    باني(أعمدة، صفوف، إعدادات)
        هذا._أعمدة = أعمدة
        هذا._صفوف = صفوف
        هذا._فرز_بـ = إعدادات.فرز_بـ
        هذا._فرز_تصاعدي = إعدادات.فرز_تصاعدي != خطأ
        هذا._صفوف_مختارة = []
        هذا._صفحة = 0
        هذا._صفوف_لكل_صفحة = إعدادات.صفوف_لكل_صفحة أو 10
    نهاية

    دالة فرز(عمود)
        إذا (هذا._فرز_بـ == عمود)
            هذا._فرز_تصاعدي = ليس هذا._فرز_تصاعدي
        وإلا
            هذا._فرز_بـ = عمود
            هذا._فرز_تصاعدي = صحيح
        نهاية
        
        هذا._صفوف.رتّب(لامدا(أ، ب) =>
            متغير قيمة_أ = أ[عمود]
            متغير قيمة_ب = ب[عمود]
            متغير نتيجة = قيمة_أ < قيمة_ب ? -1 : (قيمة_أ > قيمة_ب ? 1 : 0)
            ارجع هذا._فرز_تصاعدي ? نتيجة : -نتيجة
        نهاية)
    نهاية

    دالة اختر_صف(فهرس)
        إذا (فهرس في هذا._صفوف_مختارة)
            هذا._صفوف_مختارة = هذا._صفوف_مختارة.فلتر(لامدا(ي) => ي != فهرس)
        وإلا
            هذا._صفوف_مختارة.أضف(فهرس)
        نهاية
    نهاية

    دالة الصفحة_التالية()
        متغير أقصى = اقسم_صحيح(هذا._صفوف.الطول()، هذا._صفوف_لكل_صفحة)
        إذا (هذا._صفحة < أقصى)
            هذا._صفحة += 1
        نهاية
    نهاية

    دالة الصفحة_السابقة()
        إذا (هذا._صفحة > 0)
            هذا._صفحة -= 1
        نهاية
    نهاية

    دالة صفوف_الصفحة_الحالية()
        متغير بداية = هذا._صفحة * هذا._صفوف_لكل_صفحة
        متغير نهاية = بداية + هذا._صفوف_لكل_صفحة
        ارجع هذا._صفوف[بداية:نهاية]
    نهاية
نهاية

