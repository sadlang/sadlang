# العيب #36: TabBar - شريط التبويبات
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف شريط_تبويبات
    باني(تبويبات، إعدادات)
        هذا._تبويبات = تبويبات أو []
        هذا._فهرس_حالي = 0
        هذا._متحكم = إعدادات.متحكم أو لاشيء
        هذا._قابل_للتمرير = إعدادات.قابل_للتمرير أو خطأ
        هذا._لون_مؤشر = إعدادات.لون_مؤشر أو "#FFFFFF"
        هذا._عند_تغيير = إعدادات.عند_تغيير
    نهاية

    دالة اختر(فهرس)
        إذا (فهرس >= 0 و فهرس < هذا._تبويبات.الطول())
            هذا._فهرس_حالي = فهرس
            
            إذا (هذا._عند_تغيير)
                هذا._عند_تغيير(فهرس)
            نهاية
            
            إذا (هذا._متحكم)
                هذا._متحكم.حرك_إلى(فهرس)
            نهاية
        نهاية
    نهاية

    دالة التالي()
        هذا.اختر((هذا._فهرس_حالي + 1) % هذا._تبويبات.الطول())
    نهاية

    دالة السابق()
        متغير جديد = هذا._فهرس_حالي - 1
        إذا (جديد < 0)
            جديد = هذا._تبويبات.الطول() - 1
        نهاية
        هذا.اختر(جديد)
    نهاية
نهاية

صدّر صنف متحكم_تبويبات
    باني(طول)
        هذا._طول = طول
        هذا._فهرس = 0
        هذا._حركة = لاشيء
    نهاية

    دالة حرك_إلى(فهرس، مدة)
        هذا._فهرس = فهرس
        # TODO: تنفيذ الحركة
    نهاية

    دالة الفهرس()
        ارجع هذا._فهرس
    نهاية
نهاية

