# العيب #38: Dismissible - قابل للإقالة
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف قابل_للإقالة
    باني(ابن، إعدادات)
        هذا._ابن = ابن
        هذا._اتجاه = إعدادات.اتجاه أو "أفقي"
        هذا._عتبة = إعدادات.عتبة أو 0.4
        هذا._خلفية = إعدادات.خلفية
        هذا._خلفية_ثانوية = إعدادات.خلفية_ثانوية
        هذا._عند_إقالة = إعدادات.عند_إقالة
        هذا._موضع_س = 0
    نهاية

    دالة عند_سحب(دلتا)
        إذا (هذا._اتجاه == "أفقي")
            هذا._موضع_س += دلتا.س
        نهاية
    نهاية

    دالة عند_نهاية_سحب()
        متغير نسبة = مطلق(هذا._موضع_س) / هذا._عرض
        
        إذا (نسبة > هذا._عتبة)
            # أقِل
            متغير اتجاه = هذا._موضع_س > 0 ? "يمين" : "يسار"
            إذا (هذا._عند_إقالة)
                هذا._عند_إقالة(اتجاه)
            نهاية
        وإلا
            # أرجع للموضع الأصلي
            هذا._موضع_س = 0
        نهاية
    نهاية
نهاية

