# العيب #41: ExpansionPanel - لوحة توسيع
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف لوحة_توسيع
    باني(عنوان، محتوى، إعدادات)
        هذا._عنوان = عنوان
        هذا._محتوى = محتوى
        هذا._موسعة = إعدادات.موسعة أو خطأ
        هذا._يمكن_توسيع = إعدادات.يمكن_توسيع != خطأ
        هذا._عند_توسيع = إعدادات.عند_توسيع
    نهاية

    دالة بدّل()
        إذا (هذا._يمكن_توسيع)
            هذا._موسعة = ليس هذا._موسعة
            
            إذا (هذا._عند_توسيع)
                هذا._عند_توسيع(هذا._موسعة)
            نهاية
        نهاية
    نهاية

    دالة وسّع()
        إذا (ليس هذا._موسعة)
            هذا.بدّل()
        نهاية
    نهاية

    دالة اطوِ()
        إذا (هذا._موسعة)
            هذا.بدّل()
        نهاية
    نهاية
نهاية

