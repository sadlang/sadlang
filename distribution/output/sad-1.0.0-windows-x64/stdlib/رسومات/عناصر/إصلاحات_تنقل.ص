# العيب #39: ReorderableList - قائمة قابلة لإعادة الترتيب
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف قائمة_قابلة_للترتيب
    باني(عناصر، إعدادات)
        هذا._عناصر = عناصر
        هذا._باني_عنصر = إعدادات.باني
        هذا._عند_إعادة_ترتيب = إعدادات.عند_إعادة_ترتيب
        هذا._عنصر_محمول = لاشيء
        هذا._فهرس_أصلي = -1
    نهاية

    دالة ابدأ_سحب(فهرس)
        هذا._عنصر_محمول = هذا._عناصر[فهرس]
        هذا._فهرس_أصلي = فهرس
    نهاية

    دالة أثناء_سحب(موضع)
        متغير فهرس_جديد = هذا._احسب_فهرس_من_موضع(موضع)
        
        إذا (فهرس_جديد != هذا._فهرس_أصلي)
            # حرك العنصر مؤقتاً
            هذا._عناصر = هذا._عناصر.فلتر(لامدا(ع، ي) => ي != هذا._فهرس_أصلي)
            هذا._عناصر.أدخل(فهرس_جديد، هذا._عنصر_محمول)
            هذا._فهرس_أصلي = فهرس_جديد
        نهاية
    نهاية

    دالة أنهِ_سحب()
        إذا (هذا._عند_إعادة_ترتيب)
            هذا._عند_إعادة_ترتيب(هذا._عناصر)
        نهاية
        
        هذا._عنصر_محمول = لاشيء
        هذا._فهرس_أصلي = -1
    نهاية

    دالة _احسب_فهرس_من_موضع(موضع)
        # TODO: تنفيذ حساب الفهرس
        ارجع 0
    نهاية
نهاية

