# العيب #37: NavigationRail - سكة التنقل
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف سكة_تنقل
    باني(وجهات، إعدادات)
        هذا._وجهات = وجهات
        هذا._فهرس_حالي = 0
        هذا._موسعة = إعدادات.موسعة أو خطأ
        هذا._عرض_أدنى = 72
        هذا._عرض_موسع = 256
        هذا._عند_تغيير = إعدادات.عند_تغيير
    نهاية

    دالة اختر(فهرس)
        هذا._فهرس_حالي = فهرس
        إذا (هذا._عند_تغيير)
            هذا._عند_تغيير(فهرس)
        نهاية
    نهاية

    دالة وسّع()
        هذا._موسعة = صحيح
    نهاية

    دالة اطوِ()
        هذا._موسعة = خطأ
    نهاية

    دالة العرض()
        ارجع هذا._موسعة ? هذا._عرض_موسع : هذا._عرض_أدنى
    نهاية
نهاية

