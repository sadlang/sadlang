استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    منتقي_تاريخ: DatePicker
# ===================================================================

صدّر صنف منتقي_تاريخ يرث عنصر
    باني(قيمة = لاشيء, عند_التغيير = لاشيء, تسمية = لاشيء, حد_ادنى = لاشيء, حد_اقصى = لاشيء, تنسيق = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "منتقي_تاريخ"
        هذا._خصائص = {}
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["حد_ادنى"] = حد_ادنى
        هذا._خصائص["حد_اقصى"] = حد_اقصى
        هذا._خصائص["تنسيق"] = تنسيق
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    دالة احصل_القيمة()
        ارجع هذا._خصائص["قيمة"]
    نهاية

    دالة عيّن_القيمة(قيمة)
        هذا._خصائص["قيمة"] = قيمة
        ارجع هذا
    نهاية
نهاية

