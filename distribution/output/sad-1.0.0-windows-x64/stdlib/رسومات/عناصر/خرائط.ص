# ===================================================================
# عناصر متقدمة — الخرائط والموقع
# ===================================================================
# عناصر عرض الخرائط والمواقع الجغرافية
#
# الاستخدام:
#   استورد * من رسومات.عناصر.خرائط
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── عرض_خريطة (MapView) ───
صدّر صنف عرض_خريطة يرث عنصر
    باني(خط_عرض = 24.7136, خط_طول = 46.6753, تكبير = 10)
        هذا._نوع = "عرض_خريطة"
        هذا._خصائص = {}
        هذا._خصائص["خط_عرض"] = خط_عرض
        هذا._خصائص["خط_طول"] = خط_طول
        هذا._خصائص["تكبير"] = تكبير
        هذا._خصائص["علامات"] = []
        هذا._خصائص["خطوط"] = []
        هذا._خصائص["نوع_خريطة"] = "عادية"
        هذا._خصائص["تحكم_تكبير"] = صحيح
        هذا._خصائص["بوصلة"] = صحيح
        هذا._أبناء = []
    نهاية

    دالة أضف_علامة(علامة)
        هذا._خصائص["علامات"] = هذا._خصائص["علامات"] + [علامة]
        ارجع هذا
    نهاية

    دالة أضف_خط(خط)
        هذا._خصائص["خطوط"] = هذا._خصائص["خطوط"] + [خط]
        ارجع هذا
    نهاية
نهاية

# ─── علامة_خريطة (MapMarker) ───
صدّر صنف علامة_خريطة يرث عنصر
    باني(خط_عرض = 0, خط_طول = 0, عنوان = "", لون = "#F44336")
        هذا._نوع = "علامة_خريطة"
        هذا._خصائص = {}
        هذا._خصائص["خط_عرض"] = خط_عرض
        هذا._خصائص["خط_طول"] = خط_طول
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["لون"] = لون
        هذا._خصائص["أيقونة"] = لاشيء
        هذا._خصائص["عند_النقر"] = لاشيء
        هذا._أبناء = []
    نهاية
نهاية

# ─── إحداثيات (LatLng) ───
صدّر صنف إحداثيات
    باني(خط_عرض = 0, خط_طول = 0)
        هذا._خط_عرض = خط_عرض
        هذا._خط_طول = خط_طول
    نهاية

    دالة العرض()
        ارجع هذا._خط_عرض
    نهاية

    دالة الطول()
        ارجع هذا._خط_طول
    نهاية
نهاية
