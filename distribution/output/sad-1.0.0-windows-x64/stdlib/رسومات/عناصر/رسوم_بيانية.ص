# ===================================================================
# عناصر متقدمة — رسوم بيانية (Charts)
# ===================================================================
# عناصر الرسوم البيانية والمخططات
#
# الاستخدام:
#   استورد * من رسومات.عناصر.رسوم_بيانية
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── رسم_خطي (LineChart) ───
صدّر صنف رسم_خطي يرث عنصر
    باني(بيانات = [], لون = "#1976D2", عرض_خط = 2, تعبئة = خطأ)
        هذا._نوع = "رسم_خطي"
        هذا._خصائص = {}
        هذا._خصائص["بيانات"] = بيانات
        هذا._خصائص["لون"] = لون
        هذا._خصائص["عرض_خط"] = عرض_خط
        هذا._خصائص["تعبئة"] = تعبئة
        هذا._خصائص["نقاط_مرئية"] = صحيح
        هذا._خصائص["شبكة"] = صحيح
        هذا._خصائص["تسميات_محور_س"] = لاشيء
        هذا._خصائص["تسميات_محور_ص"] = لاشيء
        هذا._أبناء = []
    نهاية
نهاية

