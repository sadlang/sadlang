        هذا._نوع = "رسم_دائري"
        هذا._خصائص = {}
        هذا._خصائص["بيانات"] = بيانات
        هذا._خصائص["ألوان"] = ألوان
        هذا._خصائص["تسميات"] = تسميات
        هذا._خصائص["فتحة"] = 0
        هذا._خصائص["نسب_مرئية"] = صحيح
        هذا._أبناء = []
    نهاية

    دالة كعكة(نسبة_فتحة)
        هذا._خصائص["فتحة"] = نسبة_فتحة
        ارجع هذا
    نهاية
نهاية

