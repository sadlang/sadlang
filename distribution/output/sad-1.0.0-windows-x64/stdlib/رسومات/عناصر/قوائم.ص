# ===================================================================
# عناصر القوائم — List Widgets
# ===================================================================
# عناصر لعرض وإدارة القوائم بأنماط مختلفة
#
# الاستخدام:
#   استورد * من رسومات.عناصر.قوائم
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── عنصر_قائمة (ListTile) ───
صدّر صنف عنصر_قائمة يرث عنصر
    باني(عنوان, عنوان_فرعي = لاشيء, أيقونة_بداية = لاشيء, أيقونة_نهاية = لاشيء, عند_الضغط = لاشيء, لون = لاشيء, كثيف = لاشيء)
        هذا._نوع = "عنصر_قائمة"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["عنوان_فرعي"] = عنوان_فرعي
        هذا._خصائص["أيقونة_بداية"] = أيقونة_بداية
        هذا._خصائص["أيقونة_نهاية"] = أيقونة_نهاية
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["لون"] = لون
        هذا._خصائص["كثيف"] = كثيف
    نهاية
نهاية

# ─── قائمة_تمرير (ListView) ───
صدّر صنف قائمة_تمرير يرث عنصر
    باني(أطفال = لاشيء, اتجاه = لاشيء, فيزياء = لاشيء, حشو = لاشيء)
        هذا._نوع = "قائمة_تمرير"
        هذا._خصائص = {}
        هذا._خصائص["اتجاه"] = اتجاه
        هذا._خصائص["فيزياء"] = فيزياء
        هذا._خصائص["حشو"] = حشو
        إذا (أطفال != لاشيء)
            هذا._أبناء = أطفال
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

# ─── قائمة_باني (ListView.builder equivalent) ───
صدّر صنف قائمة_باني يرث عنصر
    باني(عدد, باني, اتجاه = لاشيء, حشو = لاشيء)
        هذا._نوع = "قائمة_باني"
        هذا._خصائص = {}
        هذا._خصائص["عدد"] = عدد
        هذا._خصائص["باني"] = باني
        هذا._خصائص["اتجاه"] = اتجاه
        هذا._خصائص["حشو"] = حشو
        # بناء الأطفال
        هذا._أبناء = []
        لكل ف في [0..عدد - 1]
            هذا._أبناء.أضف(باني(ف))
        نهاية
    نهاية
نهاية

# ─── شبكة_بناء (GridView.builder) ───
صدّر صنف شبكة_بناء يرث عنصر
    باني(عدد, أعمدة, باني, مسافة = لاشيء)
        هذا._نوع = "شبكة_بناء"
        هذا._خصائص = {}
        هذا._خصائص["عدد"] = عدد
        هذا._خصائص["أعمدة"] = أعمدة
        هذا._خصائص["باني"] = باني
        هذا._خصائص["مسافة"] = مسافة
        هذا._أبناء = []
        لكل ف في [0..عدد - 1]
            هذا._أبناء.أضف(باني(ف))
        نهاية
    نهاية
نهاية

# ─── قائمة_قابلة_إعادة_ترتيب (ReorderableListView) ───
صدّر صنف قائمة_قابلة_ترتيب يرث عنصر
    باني(أطفال = لاشيء, عند_إعادة_ترتيب = لاشيء)
        هذا._نوع = "قائمة_قابلة_ترتيب"
        هذا._خصائص = {}
        هذا._خصائص["عند_إعادة_ترتيب"] = عند_إعادة_ترتيب
        إذا (أطفال != لاشيء)
            هذا._أبناء = أطفال
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

# ─── قائمة_فصل (SliverList) ───
صدّر صنف قائمة_فصل يرث عنصر
    باني(أطفال = لاشيء, رأس = لاشيء, رأس_ثابت = لاشيء)
        هذا._نوع = "قائمة_فصل"
        هذا._خصائص = {}
        هذا._خصائص["رأس"] = رأس
        هذا._خصائص["رأس_ثابت"] = رأس_ثابت
        إذا (أطفال != لاشيء)
            هذا._أبناء = أطفال
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية
