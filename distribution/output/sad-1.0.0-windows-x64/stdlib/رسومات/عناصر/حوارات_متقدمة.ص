# ===================================================================
# عناصر حوارات إضافية — فريدة (بعد إزالة التكرارات)
# ===================================================================
# عناصر غير موجودة في ملفات أخرى
# الأصناف المحذوفة (توجد في حاويات/ أو ملفات أخرى):
#   درج → حاويات/تنقل.ص
#   خطوات → عناصر/تحكم.ص
#   خطوة → عناصر/تحكم.ص
#   زر_عائم → عناصر/أزرار.ص
#   شريط_سفلي → حاويات/تنقل.ص
#   قائمة_منبثقة → حاويات/حوارات.ص
#   عنصر_منبثق → حاويات/حوارات.ص
#   لافتة → حاويات/حركة.ص (كتنبيه)
#   شريط_بحث → عناصر/إدخال.ص (كحقل_بحث)
#   لوحة_تطبيق → حاويات/تنقل.ص (كهيكل)
#
# الاستخدام:
#   استورد * من رسومات.عناصر.حوارات_متقدمة
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── ورقة_سفلية (BottomSheet) ───
صدّر صنف ورقة_سفلية يرث عنصر
    باني(طفل = لاشيء, ارتفاع = لاشيء, قابل_سحب = لاشيء, زوايا = لاشيء, لون = لاشيء, عند_إغلاق = لاشيء)
        هذا._نوع = "ورقة_سفلية"
        هذا._خصائص = {}
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["قابل_سحب"] = قابل_سحب
        هذا._خصائص["زوايا"] = زوايا
        هذا._خصائص["لون"] = لون
        هذا._خصائص["عند_إغلاق"] = عند_إغلاق
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

