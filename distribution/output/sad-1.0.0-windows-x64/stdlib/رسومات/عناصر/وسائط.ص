استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    مشغل_فيديو: VideoPlayer
# ===================================================================

صدّر صنف مشغل_فيديو يرث عنصر
    باني(مصدر = لاشيء, عرض = لاشيء, ارتفاع = لاشيء, تشغيل_تلقائي = لاشيء, تكرار = لاشيء, كتم = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "مشغل_فيديو"
        هذا._خصائص = {}
        هذا._خصائص["مصدر"] = مصدر
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["تشغيل_تلقائي"] = تشغيل_تلقائي
        هذا._خصائص["تكرار"] = تكرار
        هذا._خصائص["كتم"] = كتم
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    دالة احصل_المصدر()
        ارجع هذا._خصائص["مصدر"]
    نهاية

    دالة عيّن_المصدر(قيمة)
        هذا._خصائص["مصدر"] = قيمة
        ارجع هذا
    نهاية
نهاية

