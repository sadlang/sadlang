# ===================================================================
# عناصر متقدمة — تمرير وعرض
# ===================================================================
# عناصر تمرير متقدمة وعروض قابلة للطي
#
# الاستخدام:
#   استورد * من رسومات.عناصر.تمرير
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── عرض_تمرير_مخصص (CustomScrollView) ───
صدّر صنف عرض_تمرير_مخصص يرث عنصر
    باني(شرائح = [])
        هذا._نوع = "عرض_تمرير_مخصص"
        هذا._خصائص = {}
        هذا._خصائص["شرائح"] = شرائح
        هذا._خصائص["فيزياء"] = "ارتداد"
        هذا._خصائص["اتجاه"] = "عمودي"
        هذا._خصائص["عكس"] = خطأ
        هذا._أبناء = []
    نهاية
نهاية

# ─── شريحة_قائمة (SliverList) ───
صدّر صنف شريحة_قائمة يرث عنصر
    باني(صانع = لاشيء, عدد = لاشيء)
        هذا._نوع = "شريحة_قائمة"
        هذا._خصائص = {}
        هذا._خصائص["صانع"] = صانع
        هذا._خصائص["عدد"] = عدد
        هذا._أبناء = []
    نهاية
نهاية

# ─── شريحة_شبكة (SliverGrid) ───
صدّر صنف شريحة_شبكة يرث عنصر
    باني(صانع = لاشيء, عدد = لاشيء, أعمدة = 2)
        هذا._نوع = "شريحة_شبكة"
        هذا._خصائص = {}
        هذا._خصائص["صانع"] = صانع
        هذا._خصائص["عدد"] = عدد
        هذا._خصائص["أعمدة"] = أعمدة
        هذا._خصائص["نسبة"] = 1.0
        هذا._أبناء = []
    نهاية
نهاية

# ─── شريحة_شريط_تطبيق (SliverAppBar) ───
صدّر صنف شريحة_شريط_تطبيق يرث عنصر
    باني(عنوان = لاشيء, قابل_للتوسع = صحيح, ارتفاع_موسع = 200)
        هذا._نوع = "شريحة_شريط_تطبيق"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["قابل_للتوسع"] = قابل_للتوسع
        هذا._خصائص["ارتفاع_موسع"] = ارتفاع_موسع
        هذا._خصائص["مثبت"] = خطأ
        هذا._خصائص["عائم"] = خطأ
        هذا._خصائص["مرن"] = لاشيء
        هذا._خصائص["لون_خلفية"] = لاشيء
        هذا._أبناء = []
    نهاية
نهاية

# ─── شريحة_حشو (SliverPadding) ───
صدّر صنف شريحة_حشو يرث عنصر
    باني(حاشية = 0, شريحة = لاشيء)
        هذا._نوع = "شريحة_حشو"
        هذا._خصائص = {}
        هذا._خصائص["حاشية"] = حاشية
        هذا._خصائص["شريحة"] = شريحة
        هذا._أبناء = []
    نهاية
نهاية

# ─── شريحة_ملء_متبقية (SliverFillRemaining) ───
صدّر صنف شريحة_ملء_متبقية يرث عنصر
    باني(ابن = لاشيء, حشو_تمرير = صحيح)
        هذا._نوع = "شريحة_ملء_متبقية"
        هذا._خصائص = {}
        هذا._خصائص["حشو_تمرير"] = حشو_تمرير
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

# ─── عنصر_قابل_للتحديث_بالسحب (RefreshIndicator) ───
صدّر صنف مؤشر_تحديث يرث عنصر
    باني(ابن = لاشيء, عند_التحديث = لاشيء)
        هذا._نوع = "مؤشر_تحديث"
        هذا._خصائص = {}
        هذا._خصائص["عند_التحديث"] = عند_التحديث
        هذا._خصائص["لون"] = لاشيء
        هذا._خصائص["لون_خلفية"] = لاشيء
        هذا._خصائص["مسافة_إزاحة"] = 40
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

# ─── تحكم_تمرير (ScrollController) ───
صدّر صنف تحكم_تمرير
    باني(موقع_ابتدائي = 0)
        هذا._موقع = موقع_ابتدائي
        هذا._مستمعون = []
    نهاية

    دالة الموقع()
        ارجع هذا._موقع
    نهاية

    دالة انتقل_إلى(موقع, مدة = 300)
        هذا._موقع = موقع
        ارجع هذا
    نهاية

    دالة أعلى(مدة = 300)
        هذا._موقع = 0
        ارجع هذا
    نهاية

    دالة أضف_مستمع(رد_نداء)
        هذا._مستمعون = هذا._مستمعون + [رد_نداء]
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
    نهاية
نهاية

# ─── تحكم_صفحات (PageController) ───
صدّر صنف تحكم_صفحات
    باني(صفحة_ابتدائية = 0, نسبة_عرض = 1.0)
        هذا._صفحة = صفحة_ابتدائية
        هذا._نسبة = نسبة_عرض
    نهاية

    دالة الصفحة()
        ارجع هذا._صفحة
    نهاية

    دالة انتقل_لصفحة(صفحة, مدة = 300)
        هذا._صفحة = صفحة
        ارجع هذا
    نهاية

    دالة التالي(مدة = 300)
        هذا._صفحة = هذا._صفحة + 1
        ارجع هذا
    نهاية

    دالة السابق(مدة = 300)
        إذا (هذا._صفحة > 0)
            هذا._صفحة = هذا._صفحة - 1
        نهاية
        ارجع هذا
    نهاية
نهاية

# ─── عرض_صفحات (PageView) ───
صدّر صنف عرض_صفحات يرث عنصر
    باني(صفحات = [], متحكم = لاشيء, عند_التغيير = لاشيء)
        هذا._نوع = "عرض_صفحات"
        هذا._خصائص = {}
        هذا._خصائص["صفحات"] = صفحات
        هذا._خصائص["متحكم"] = متحكم
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["اتجاه_تمرير"] = "أفقي"
        هذا._خصائص["فيزياء"] = "ارتداد"
        هذا._أبناء = صفحات
    نهاية
نهاية
