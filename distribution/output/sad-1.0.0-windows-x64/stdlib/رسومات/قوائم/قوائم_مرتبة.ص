    نهاية_إلى_بداية،
    بداية_إلى_نهاية،
    أعلى،
    أسفل،
    يسار،
    يمين
نهاية

# ─── مقبض إعادة الترتيب ───
صدّر صنف مقبض_ترتيب يرث عنصر
    باني(ابن = لاشيء، لون = لاشيء، حجم = لاشيء)
        هذا._نوع = "مقبض_ترتيب"
        إذا (ابن == لاشيء)
            هذا._ابن = جديد أيقونة(أيقونات.قائمة_سحب، حجم: حجم، لون: لون)
        وإلا
            هذا._ابن = ابن
        نهاية
    نهاية
نهاية

# ─── مقبض سحب مخصص ───
صدّر صنف مقبض_سحب يرث عنصر
    باني(ابن، عند_سحب = لاشيء، ردود_فعل = صحيح)
        هذا._نوع = "مقبض_سحب"
        هذا._ابن = ابن
        هذا._عند_سحب = عند_سحب
        هذا._ردود_فعل = ردود_فعل
    نهاية
نهاية

# ─── تأثير السحب ───
صدّر صنف تأثير_سحب
    ساكن ثابت ظل = "ظل"
    ساكن ثابت شفافية = "شفافية"
    ساكن ثابت تكبير = "تكبير"
    ساكن ثابت رفع = "رفع"
نهاية

# ─── بيانات إعادة الترتيب ───
صدّر صنف بيانات_ترتيب
    باني(فهرس_قديم، فهرس_جديد، عنصر)
        هذا.فهرس_قديم = فهرس_قديم
        هذا.فهرس_جديد = فهرس_جديد
        هذا.عنصر = عنصر
    نهاية

    دالة تم_تحريك؟()
        ارجع هذا.فهرس_قديم != هذا.فهرس_جديد
    نهاية
نهاية

# ─── متحكم قائمة مرتبة ───
صدّر صنف متحكم_قائمة_مرتبة
    باني(عناصر = لاشيء)
        هذا._عناصر = عناصر أو []
        هذا._مستمعون = []
    نهاية

    دالة العناصر()
        ارجع هذا._عناصر
    نهاية

    دالة أضف(عنصر)
        هذا._عناصر.أضف(عنصر)
        هذا._أبلغ()
    نهاية

    دالة أزل(فهرس)
        متغير عنصر = هذا._عناصر.أزل_عند(فهرس)
        هذا._أبلغ()
        ارجع عنصر
    نهاية

    دالة أعد_ترتيب(فهرس_قديم، فهرس_جديد)
        إذا (فهرس_قديم < فهرس_جديد)
            فهرس_جديد = فهرس_جديد - 1
        نهاية
        متغير عنصر = هذا._عناصر.أزل_عند(فهرس_قديم)
        هذا._عناصر.أدخل(فهرس_جديد، عنصر)
        هذا._أبلغ()
    نهاية

    دالة استمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة _أبلغ()
        لكل مستمع في هذا._مستمعون
            مستمع()
        نهاية
    نهاية
نهاية

# ─── مساعد قوائم مرتبة ───
صدّر صنف مساعد_ترتيب
    # دالة مساعدة لحساب الفهرس الجديد بعد الحذف
    ساكن دالة احسب_فهرس_جديد(فهرس_قديم، فهرس_جديد)
        إذا (فهرس_قديم < فهرس_جديد)
            ارجع فهرس_جديد - 1
        نهاية
        ارجع فهرس_جديد
    نهاية

    # تبديل عنصرين
    ساكن دالة بدّل(قائمة، فهرس1، فهرس2)
        متغير مؤقت = قائمة[فهرس1]
        قائمة[فهرس1] = قائمة[فهرس2]
        قائمة[فهرس2] = مؤقت
    نهاية

    # نقل عنصر في قائمة
    ساكن دالة انقل(قائمة، من، إلى)
        متغير عنصر = قائمة.أزل_عند(من)
        قائمة.أدخل(إلى، عنصر)
    نهاية
نهاية

