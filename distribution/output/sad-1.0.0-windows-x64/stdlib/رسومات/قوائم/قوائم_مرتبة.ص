# ─── قائمة قابلة لإعادة الترتيب ───
صدّر صنف قائمة_مرتبة يرث عنصر
    باني(
        أطفال = لاشيء،
        عند_إعادة_ترتيب،
        رأس = لاشيء،
        تذييل = لاشيء،
        اتجاه_تمرير = لاشيء،
        حشوة = لاشيء،
        عكسي = خطأ،
        متحكم_تمرير = لاشيء،
        أساسي = لاشيء،
        فيزياء = لاشيء،
        تقلص_غلاف = خطأ،
        مثبت_حدود = لاشيء،
        باني_عنصر_افتراضي = لاشيء،
        باني_مفصول = لاشيء،
        نقطة_مرساة = لاشيء،
        لون_مؤثرات_أحداث = لاشيء،
        وضع_مسح = لاشيء،
        أظهر_شريط_تمرير = خطأ
    )
        هذا._نوع = "قائمة_مرتبة"
        هذا._أطفال = أطفال أو []
        هذا._عند_إعادة_ترتيب = عند_إعادة_ترتيب
        هذا._رأس = رأس
        هذا._تذييل = تذييل
        هذا._اتجاه = اتجاه_تمرير أو محور.عمودي
        هذا._حشوة = حشوة
        هذا._عكسي = عكسي
        هذا._متحكم = متحكم_تمرير
        هذا._أساسي = أساسي
        هذا._فيزياء = فيزياء
        هذا._تقلص = تقلص_غلاف
        هذا._مثبت = مثبت_حدود
        هذا._باني_افتراضي = باني_عنصر_افتراضي
        هذا._باني_مفصول = باني_مفصول
        هذا._مرساة = نقطة_مرساة
        هذا._لون_أحداث = لون_مؤثرات_أحداث
        هذا._وضع_مسح = وضع_مسح
        هذا._أظهر_شريط = أظهر_شريط_تمرير
    نهاية

    # إضافة طفل
    دالة أضف(طفل)
        هذا._أطفال.أضف(طفل)
    نهاية

    # إزالة طفل
    دالة أزل(فهرس)
        ارجع هذا._أطفال.أزل_عند(فهرس)
    نهاية

    # تحريك عنصر
    دالة حرّك(من_فهرس، إلى_فهرس)
        متغير عنصر = هذا._أطفال[من_فهرس]
        هذا._أطفال.أزل_عند(من_فهرس)
        هذا._أطفال.أدخل(إلى_فهرس، عنصر)
        هذا._عند_إعادة_ترتيب(من_فهرس، إلى_فهرس)
    نهاية
نهاية

