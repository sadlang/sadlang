# ===================================================================
# نظام السمات المتقدم — Theme System
# ===================================================================
# مستوحى من Flutter (ThemeData, TextTheme, ColorScheme)
#
# الاستخدام:
#   استورد * من رسومات.حالة.سمة
# ===================================================================

# ─── مخطط_ألوان (ColorScheme) ───
صدّر صنف مخطط_ألوان
    باني()
        هذا.أساسي = "#2196F3"
        هذا.أساسي_متغير = "#1976D2"
        هذا.ثانوي = "#FF9800"
        هذا.ثانوي_متغير = "#F57C00"
        هذا.خلفية = "#FFFFFF"
        هذا.سطح = "#F5F5F5"
        هذا.خطأ = "#F44336"
        هذا.على_أساسي = "#FFFFFF"
        هذا.على_ثانوي = "#000000"
        هذا.على_خلفية = "#000000"
        هذا.على_سطح = "#000000"
        هذا.على_خطأ = "#FFFFFF"
        هذا.حد = "#E0E0E0"
        هذا.ظل = "#00000029"
    نهاية

    دالة داكن()
        متغير م = جديد مخطط_ألوان()
        م.أساسي = "#90CAF9"
        م.أساسي_متغير = "#42A5F5"
        م.ثانوي = "#FFB74D"
        م.ثانوي_متغير = "#FFA726"
        م.خلفية = "#121212"
        م.سطح = "#1E1E1E"
        م.خطأ = "#EF5350"
        م.على_أساسي = "#000000"
        م.على_ثانوي = "#000000"
        م.على_خلفية = "#FFFFFF"
        م.على_سطح = "#FFFFFF"
        م.على_خطأ = "#000000"
        م.حد = "#333333"
        م.ظل = "#00000066"
        ارجع م
    نهاية
نهاية

# ─── نمط_نص (TextStyle) ───
صدّر صنف نمط_نص
    باني(حجم, وزن, لون)
        هذا.الحجم = حجم
        هذا.الوزن = وزن
        هذا.اللون = لون
        هذا.الخط = "Cairo"
        هذا.ارتفاع_سطر = 1.5
    نهاية

    دالة مع_حجم(حجم_جديد)
        ارجع جديد نمط_نص(حجم_جديد, هذا.الوزن, هذا.اللون)
    نهاية

    دالة مع_لون(لون_جديد)
        ارجع جديد نمط_نص(هذا.الحجم, هذا.الوزن, لون_جديد)
    نهاية

    دالة مع_وزن(وزن_جديد)
        ارجع جديد نمط_نص(هذا.الحجم, وزن_جديد, هذا.اللون)
    نهاية
نهاية

# ─── سمة_نص (TextTheme) ───
صدّر صنف سمة_نص
    باني()
        هذا.عنوان_كبير = جديد نمط_نص(32, "عريض", "#000000")
        هذا.عنوان_متوسط = جديد نمط_نص(24, "عريض", "#000000")
        هذا.عنوان_صغير = جديد نمط_نص(20, "متوسط", "#000000")
        هذا.جسم_كبير = جديد نمط_نص(16, "عادي", "#000000")
        هذا.جسم_متوسط = جديد نمط_نص(14, "عادي", "#000000")
        هذا.جسم_صغير = جديد نمط_نص(12, "عادي", "#666666")
        هذا.تسمية_كبيرة = جديد نمط_نص(14, "متوسط", "#333333")
        هذا.تسمية_متوسطة = جديد نمط_نص(12, "متوسط", "#333333")
        هذا.تسمية_صغيرة = جديد نمط_نص(10, "عادي", "#999999")
    نهاية
نهاية

# ─── بيانات_سمة (ThemeData) ───
صدّر صنف بيانات_سمة
    باني()
        هذا.ألوان = جديد مخطط_ألوان()
        هذا.نصوص = جديد سمة_نص()
        هذا.نصف_قطر = 8
        هذا.مسافة = 16
        هذا.مسافة_صغيرة = 8
        هذا.مسافة_كبيرة = 24
        هذا.ارتفاع_شريط = 56
        هذا.حجم_أيقونة = 24
        هذا.اتجاه = "يمين"
    نهاية

    دالة سمة_داكنة()
        متغير س = جديد بيانات_سمة()
        س.ألوان = جديد مخطط_ألوان().داكن()
        # تحديث ألوان النصوص للوضع الداكن
        س.نصوص.عنوان_كبير = س.نصوص.عنوان_كبير.مع_لون("#FFFFFF")
        س.نصوص.عنوان_متوسط = س.نصوص.عنوان_متوسط.مع_لون("#FFFFFF")
        س.نصوص.عنوان_صغير = س.نصوص.عنوان_صغير.مع_لون("#FFFFFF")
        س.نصوص.جسم_كبير = س.نصوص.جسم_كبير.مع_لون("#FFFFFF")
        س.نصوص.جسم_متوسط = س.نصوص.جسم_متوسط.مع_لون("#E0E0E0")
        س.نصوص.جسم_صغير = س.نصوص.جسم_صغير.مع_لون("#BDBDBD")
        ارجع س
    نهاية
نهاية

# ─── مدير السمة (Singleton) ───
متغير _سمة_حالية = لاشيء
متغير _هل_داكن = خطأ

صدّر دالة السمة()
    إذا (_سمة_حالية == لاشيء)
        _سمة_حالية = جديد بيانات_سمة()
    نهاية
    ارجع _سمة_حالية
نهاية

صدّر دالة سمة_داكنة()
    _سمة_حالية = جديد بيانات_سمة().سمة_داكنة()
    _هل_داكن = صحيح
    ارجع _سمة_حالية
نهاية

صدّر دالة سمة_فاتحة()
    _سمة_حالية = جديد بيانات_سمة()
    _هل_داكن = خطأ
    ارجع _سمة_حالية
نهاية

صدّر دالة بدّل_سمة()
    إذا (_هل_داكن)
        ارجع سمة_فاتحة()
    وإلا
        ارجع سمة_داكنة()
    نهاية
نهاية
