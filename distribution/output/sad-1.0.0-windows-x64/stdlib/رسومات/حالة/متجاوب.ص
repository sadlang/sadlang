# ─── نقاط التوقف (Breakpoints) ───
صدّر صنف نقاط_توقف
    ساكن ثابت هاتف = 600
    ساكن ثابت لوحي = 900
    ساكن ثابت حاسوب = 1200
    ساكن ثابت تلفاز = 1800
نهاية

# ─── بيانات_وسائط (MediaQueryData) ───
# ملاحظة: أُعيد تسميته من استعلام_وسائط لتجنب التعارض مع عناصر/تكيفية.ص
صدّر صنف بيانات_وسائط
    باني()
        هذا._عرض = 0
        هذا._ارتفاع = 0
        هذا._كثافة = 1.0
        هذا._نوع = "غير_محدد"
    نهاية

    دالة العرض()
        ارجع هذا._عرض
    نهاية

    دالة الارتفاع()
        ارجع هذا._ارتفاع
    نهاية

    دالة الكثافة()
        ارجع هذا._كثافة
    نهاية

    دالة النوع()
        ارجع هذا._نوع
    نهاية

    دالة هل_هاتف()
        ارجع هذا._عرض < نقاط_توقف.هاتف
    نهاية

    دالة هل_لوحي()
        ارجع هذا._عرض >= نقاط_توقف.هاتف و هذا._عرض < نقاط_توقف.حاسوب
    نهاية

    دالة هل_حاسوب()
        ارجع هذا._عرض >= نقاط_توقف.حاسوب
    نهاية

    دالة هل_أفقي()
        ارجع هذا._عرض > هذا._ارتفاع
    نهاية

    دالة هل_عمودي()
        ارجع هذا._عرض <= هذا._ارتفاع
    نهاية

    دالة نسبة_العرض()
        ارجع هذا._عرض / هذا._ارتفاع
    نهاية
نهاية

# ─── باني_متجاوب (ResponsiveBuilder) ───
صدّر صنف باني_متجاوب
    باني()
        هذا._هاتف = لاشيء
        هذا._لوحي = لاشيء
        هذا._حاسوب = لاشيء
    نهاية

    دالة هاتف(منشئ)
        هذا._هاتف = منشئ
        ارجع هذا
    نهاية

    دالة لوحي(منشئ)
        هذا._لوحي = منشئ
        ارجع هذا
    نهاية

    دالة حاسوب(منشئ)
        هذا._حاسوب = منشئ
        ارجع هذا
    نهاية

    دالة بناء()
        متغير وسائط = جديد استعلام_وسائط()

        إذا (وسائط.هل_حاسوب() و هذا._حاسوب != لاشيء)
            ارجع هذا._حاسوب(وسائط)
        وإلا
            إذا (وسائط.هل_لوحي() و هذا._لوحي != لاشيء)
                ارجع هذا._لوحي(وسائط)
            وإلا
                إذا (هذا._هاتف != لاشيء)
                    ارجع هذا._هاتف(وسائط)
                نهاية
            نهاية
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ─── حجم_متجاوب (ResponsiveSize) ───
صدّر دالة حجم_متجاوب(هاتف, لوحي, حاسوب)
    متغير وسائط = جديد استعلام_وسائط()
    إذا (وسائط.هل_حاسوب() و حاسوب != لاشيء)
        ارجع حاسوب
    وإلا
        إذا (وسائط.هل_لوحي() و لوحي != لاشيء)
            ارجع لوحي
        نهاية
    نهاية
    ارجع هاتف
نهاية

# ─── نسبة من العرض/الارتفاع ───
صدّر دالة نسبة_عرض(نسبة)
    ارجع عرض() * نسبة / 100
نهاية

صدّر دالة نسبة_ارتفاع(نسبة)
    ارجع ارتفاع() * نسبة / 100
نهاية

# ─── بانٍ_شبكة_متجاوبة (ResponsiveGrid) ───
صدّر صنف شبكة_متجاوبة
    باني(أعمدة_هاتف, أعمدة_لوحي, أعمدة_حاسوب)
        هذا._أعمدة_هاتف = أعمدة_هاتف
        هذا._أعمدة_لوحي = أعمدة_لوحي
        هذا._أعمدة_حاسوب = أعمدة_حاسوب
    نهاية

    دالة الأعمدة()
        متغير وسائط = جديد استعلام_وسائط()
        إذا (وسائط.هل_حاسوب())
            ارجع هذا._أعمدة_حاسوب
        وإلا
            إذا (وسائط.هل_لوحي())
                ارجع هذا._أعمدة_لوحي
            نهاية
        نهاية
        ارجع هذا._أعمدة_هاتف
    نهاية

    دالة عرض_عمود()
        ارجع عرض() / هذا.الأعمدة()
    نهاية
نهاية
