# ===================================================================
# إصلاح العيب #10: StateStore Architecture - بنية متجر الحالة
# ===================================================================

# ─── إجراء ───
صدّر صنف إجراء
    باني(نوع، حمولة)
        هذا.نوع = نوع
        هذا.حمولة = حمولة أو {}
        هذا.طابع_زمني = الآن()
        هذا.معرف = _أنشئ_معرف()
    نهاية
نهاية

# ─── مختزل ───
صدّر صنف مختزل
    باني(حالة_ابتدائية)
        هذا._حالة_ابتدائية = حالة_ابتدائية
        هذا._معالجات = {}
    نهاية

    دالة عندما(نوع_إجراء، معالج)
        هذا._معالجات[نوع_إجراء] = معالج
        ارجع هذا
    نهاية

    دالة اختزل(حالة، إجراء)
        إذا (حالة == لاشيء)
            حالة = هذا._حالة_ابتدائية
        نهاية
        
        متغير معالج = هذا._معالجات[إجراء.نوع]
        إذا (معالج != لاشيء)
            ارجع معالج(حالة، إجراء.حمولة)
        نهاية
        
        ارجع حالة
    نهاية
نهاية

# ─── متجر الحالة ───
صدّر صنف متجر_حالة
    باني(مختزل)
        هذا._مختزل = مختزل
        هذا._حالة = مختزل._حالة_ابتدائية
        هذا._مشتركون = []
        هذا._برمجيات_وسيطة = []
        هذا._تاريخ = []
        هذا._فهرس_تاريخ = -1
        هذا._حد_تاريخ = 100
        هذا._قفل = خطأ
    نهاية

    دالة أضف_وسيط(برنامج)
        هذا._برمجيات_وسيطة.أضف(برنامج)
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة أرسل(إجراء)
        إذا (هذا._قفل)
            ارمي "لا يمكن الإرسال أثناء معالجة إجراء آخر"
        نهاية

        هذا._قفل = صحيح
        
        حاول
            # مرر عبر البرمجيات الوسيطة
            متغير إجراء_معدل = إجراء
            لكل وسيط في هذا._برمجيات_وسيطة
                إجراء_معدل = وسيط(هذا، إجراء_معدل)
                إذا (إجراء_معدل == لاشيء)
                    ارجع  # تم إلغاء الإجراء
                نهاية
            نهاية
            
            # احفظ الحالة السابقة للتاريخ
            هذا._احفظ_للتاريخ()
            
            # اختزل
            متغير حالة_سابقة = هذا._حالة
            هذا._حالة = هذا._مختزل.اختزل(هذا._حالة، إجراء_معدل)
            
            # أخبر المشتركين
            إذا (هذا._حالة != حالة_سابقة)
                هذا._أخبر_المشتركين()
            نهاية
        أخيراً
            هذا._قفل = خطأ
        نهاية
    نهاية

    دالة اشترك(دالة_callback)
        هذا._مشتركون.أضف(دالة_callback)
        
        # أرجع دالة لإلغاء الاشتراك
        ارجع لامدا() =>
            هذا._مشتركون = هذا._مشتركون.فلتر(لامدا(م) => م != دالة_callback)
        نهاية
    نهاية

    دالة _أخبر_المشتركين()
        لكل مشترك في هذا._مشتركون
            حاول
                مشترك(هذا._حالة)
            امسك (خطأ)
                اطبع_سطر("خطأ في مشترك: " + خطأ)
            نهاية
        نهاية
    نهاية

    # إدارة التاريخ
    دالة _احفظ_للتاريخ()
        # احذف أي تاريخ بعد الموضع الحالي
        هذا._تاريخ = هذا._تاريخ[0:هذا._فهرس_تاريخ + 1]
        
        هذا._تاريخ.أضف(انسخ_عميق(هذا._حالة))
        هذا._فهرس_تاريخ = هذا._تاريخ.الطول() - 1
        
        # حد التاريخ
        إذا (هذا._تاريخ.الطول() > هذا._حد_تاريخ)
            هذا._تاريخ = هذا._تاريخ[1:]
            هذا._فهرس_تاريخ -= 1
        نهاية
    نهاية

    دالة تراجع()
        إذا (هذا._فهرس_تاريخ > 0)
            هذا._فهرس_تاريخ -= 1
            هذا._حالة = انسخ_عميق(هذا._تاريخ[هذا._فهرس_تاريخ])
            هذا._أخبر_المشتركين()
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة أعد()
        إذا (هذا._فهرس_تاريخ < هذا._تاريخ.الطول() - 1)
            هذا._فهرس_تاريخ += 1
            هذا._حالة = انسخ_عميق(هذا._تاريخ[هذا._فهرس_تاريخ])
            هذا._أخبر_المشتركين()
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة يمكن_التراجع()
        ارجع هذا._فهرس_تاريخ > 0
    نهاية

    دالة يمكن_الإعادة()
        ارجع هذا._فهرس_تاريخ < هذا._تاريخ.الطول() - 1
    نهاية
نهاية

# ─── برمجيات وسيطة جاهزة ───
صدّر صنف وسيطات_جاهزة
    # تسجيل الإجراءات
    ساكن دالة مسجّل(متجر، إجراء)
        اطبع_سطر("[إجراء] " + إجراء.نوع + " - " + نص(إجراء.حمولة))
        ارجع إجراء
    نهاية

    # إجراءات غير متزامنة (Thunk)
    ساكن دالة thunk(متجر، إجراء)
        إذا (نوع(إجراء) == "دالة")
            # إجراء غير متزامن
            إجراء(متجر.أرسل، متجر.الحالة)
            ارجع لاشيء  # لا ترسل أي شيء للمختزل
        نهاية
        ارجع إجراء
    نهاية

    # منع التكرار السريع
    ساكن دالة مانع_تكرار(فترة_مللي)
        متغير آخر_إجراء = {}
        
        ارجع لامدا(متجر، إجراء) =>
            متغير آخر = آخر_إجراء[إجراء.نوع] أو 0
            متغير الآن = الآن()
            
            إذا (الآن - آخر < فترة_مللي)
                ارجع لاشيء  # تجاهل
            نهاية
            
            آخر_إجراء[إجراء.نوع] = الآن
            ارجع إجراء
        نهاية
    نهاية
نهاية

# ─── محدد ───
صدّر صنف محدد
    باني(مسار)
        هذا._مسار = مسار
        هذا._ذاكرة_مؤقتة = لاشيء
        هذا._حالة_سابقة = لاشيء
    نهاية

    دالة حدد(حالة)
        # تحقق من الذاكرة المؤقتة
        إذا (حالة == هذا._حالة_سابقة)
            ارجع هذا._ذاكرة_مؤقتة
        نهاية
        
        # احسب القيمة
        متغير قيمة = حالة
        لكل مفتاح في هذا._مسار.قسّم(".")
            إذا (قيمة == لاشيء)
                توقف
            نهاية
            قيمة = قيمة[مفتاح]
        نهاية
        
        هذا._حالة_سابقة = حالة
        هذا._ذاكرة_مؤقتة = قيمة
        
        ارجع قيمة
    نهاية
نهاية

# ─── محدد مركب ───
صدّر دالة أنشئ_محدد(محددات، دالة_حساب)
    متغير قيم_سابقة = []
    متغير نتيجة_سابقة = لاشيء
    
    ارجع لامدا(حالة) =>
        # احسب قيم كل محدد
        متغير قيم = محددات.خريطة(لامدا(م) =>
            إذا (نوع(م) == "دالة")
                ارجع م(حالة)
            وإلا
                ارجع جديد محدد(م).حدد(حالة)
            نهاية
        نهاية)
        
        # تحقق إذا تغيرت أي قيمة
        متغير تغيرت = قيم_سابقة.الطول() != قيم.الطول()
        إذا (ليس تغيرت)
            لكل ي في نطاق(0، قيم.الطول())
                إذا (قيم[ي] != قيم_سابقة[ي])
                    تغيرت = صحيح
                    توقف
                نهاية
            نهاية
        نهاية
        
        إذا (تغيرت)
            قيم_سابقة = قيم
            نتيجة_سابقة = دالة_حساب(...قيم)
        نهاية
        
        ارجع نتيجة_سابقة
    نهاية
نهاية

# ─── ربط مع العناصر ───
صدّر صنف رابط_متجر
    باني(متجر)
        هذا._متجر = متجر
        هذا._ارتباطات = []
    نهاية

    دالة اربط(عنصر، محدد، خاصية)
        متغير إلغاء = هذا._متجر.اشترك(لامدا(حالة) =>
            متغير قيمة = محدد(حالة)
            عنصر[خاصية] = قيمة
        نهاية)
        
        هذا._ارتباطات.أضف({عنصر: عنصر، إلغاء: إلغاء})
        
        # تحديث فوري
        متغير قيمة = محدد(هذا._متجر.الحالة())
        عنصر[خاصية] = قيمة
    نهاية

    دالة فك_ربط(عنصر)
        هذا._ارتباطات = هذا._ارتباطات.فلتر(لامدا(ر) =>
            إذا (ر.عنصر == عنصر)
                ر.إلغاء()
                ارجع خطأ
            نهاية
            ارجع صحيح
        نهاية)
    نهاية

    دالة فك_الكل()
        لكل ارتباط في هذا._ارتباطات
            ارتباط.إلغاء()
        نهاية
        هذا._ارتباطات = []
    نهاية
نهاية
