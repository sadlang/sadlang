# ===================================================================
# حقن التبعيات — Dependency Injection
# ===================================================================
# نظام DI بسيط لإدارة الخدمات والتبعيات
#
# الاستخدام:
#   استورد * من رسومات.حالة.حقن
# ===================================================================

# ─── حاقن (ServiceLocator / GetIt equivalent) ───
صدّر صنف حاقن
    باني()
        هذا._مصانع = {}
        هذا._نسخ = {}
        هذا._مفرد = {}
    نهاية

    # تسجيل كمفرد (singleton)
    دالة مفرد(اسم, مصنع)
        هذا._مصانع[اسم] = مصنع
        هذا._مفرد[اسم] = صحيح
    نهاية

    # تسجيل كمصنع (factory — نسخة جديدة كل مرة)
    دالة مصنع(اسم, مصنع)
        هذا._مصانع[اسم] = مصنع
        هذا._مفرد[اسم] = خطأ
    نهاية

    # الحصول على خدمة
    دالة احصل(اسم)
        إذا (هذا._مفرد[اسم] == صحيح)
            # singleton: أنشئ مرة واحدة فقط
            إذا (هذا._نسخ[اسم] == لاشيء)
                هذا._نسخ[اسم] = هذا._مصانع[اسم]()
            نهاية
            ارجع هذا._نسخ[اسم]
        وإلا
            # factory: أنشئ نسخة جديدة
            ارجع هذا._مصانع[اسم]()
        نهاية
    نهاية

    # إعادة ضبط مفرد
    دالة أعد_ضبط(اسم)
        هذا._نسخ[اسم] = لاشيء
    نهاية

    # هل الخدمة مسجلة
    دالة مسجل(اسم)
        ارجع هذا._مصانع[اسم] != لاشيء
    نهاية

    # إلغاء التسجيل
    دالة ألغِ(اسم)
        هذا._مصانع[اسم] = لاشيء
        هذا._نسخ[اسم] = لاشيء
        هذا._مفرد[اسم] = لاشيء
    نهاية
نهاية

# ─── حاقن عام (singleton) ───
متغير _الحاقن = لاشيء

صدّر دالة الحاقن()
    إذا (_الحاقن == لاشيء)
        _الحاقن = جديد حاقن()
    نهاية
    ارجع _الحاقن
نهاية

صدّر دالة سجّل_خدمة(اسم, مصنع)
    الحاقن().مفرد(اسم, مصنع)
نهاية

صدّر دالة خدمة(اسم)
    ارجع الحاقن().احصل(اسم)
نهاية
