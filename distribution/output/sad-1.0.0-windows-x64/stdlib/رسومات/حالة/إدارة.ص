# ===================================================================
# نظام إدارة الحالة — State Management
# ===================================================================
# مستوحى من Flutter (Provider, ChangeNotifier, ValueNotifier)
#
# الاستخدام:
#   استورد * من رسومات.حالة.إدارة
#
# الأصناف:
#   - مستمع_تغيير: صنف أساسي للإشعار عند التغيير
#   - موفر: يوفر حالة مشتركة لشجرة العناصر
#   - قيمة_قابلة: قيمة واحدة مع إشعار تلقائي
#   - حالة_تطبيق: حالة عامة مشتركة (Singleton)
# ===================================================================

# ─── مستمع_تغيير (ChangeNotifier) ───
صدّر صنف مستمع_تغيير
    باني()
        هذا._مستمعون = []
    نهاية

    دالة أضف_مستمع(دالة_رد)
        هذا._مستمعون = هذا._مستمعون + [دالة_رد]
    نهاية

    دالة أزل_مستمع(دالة_رد)
        متغير جديدة = []
        لكل م في هذا._مستمعون
            إذا (م != دالة_رد)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مستمعون = جديدة
    نهاية

    دالة أشعر()
        لكل مستمع في هذا._مستمعون
            مستمع()
        نهاية
    نهاية

    دالة تنظيف()
        هذا._مستمعون = []
    نهاية
نهاية

# ─── قيمة_قابلة (ValueNotifier) ───
صدّر صنف قيمة_قابلة يرث مستمع_تغيير
    باني(قيمة_أولية)
        الأساس()
        هذا._قيمة = قيمة_أولية
    نهاية

    خاصية القيمة
        احصل
            ارجع هذا._قيمة
        نهاية
        عيّن(قيمة_جديدة)
            إذا (هذا._قيمة != قيمة_جديدة)
                هذا._قيمة = قيمة_جديدة
                هذا.أشعر()
            نهاية
        نهاية
    نهاية
نهاية

# ─── موفر (Provider) — يوفر حالة مشتركة ───
صدّر صنف موفر
    باني()
        هذا._قيم = {}
        هذا._مستمعون = {}
    نهاية

    دالة وفّر(اسم, قيمة)
        هذا._قيم[اسم] = قيمة
        إذا (هذا._مستمعون[اسم] != لاشيء)
            لكل مستمع في هذا._مستمعون[اسم]
                مستمع(قيمة)
            نهاية
        نهاية
    نهاية

    دالة احصل(اسم)
        ارجع هذا._قيم[اسم]
    نهاية

    دالة استمع(اسم, دالة_رد)
        إذا (هذا._مستمعون[اسم] == لاشيء)
            هذا._مستمعون[اسم] = []
        نهاية
        هذا._مستمعون[اسم] = هذا._مستمعون[اسم] + [دالة_رد]
    نهاية

    دالة أزل(اسم)
        هذا._قيم[اسم] = لاشيء
        هذا._مستمعون[اسم] = لاشيء
    نهاية
نهاية

# ─── حالة_تطبيق (Singleton App State) ───
متغير _حالة_تطبيق_مفرد = لاشيء

صدّر صنف حالة_تطبيق يرث موفر
    باني()
        الأساس()
    نهاية
نهاية

صدّر دالة حالة()
    إذا (_حالة_تطبيق_مفرد == لاشيء)
        _حالة_تطبيق_مفرد = جديد حالة_تطبيق()
    نهاية
    ارجع _حالة_تطبيق_مفرد
نهاية

# ─── دالة مساعدة: بناء مع حالة (Builder Pattern) ───
صدّر دالة بانٍ_حالة(اسم_حالة, دالة_بناء)
    متغير ح = حالة()
    متغير القيمة = ح.احصل(اسم_حالة)
    دالة _مستمع(قيمة_جديدة)
        تحديث_حالة()
    نهاية
    ح.استمع(اسم_حالة, _مستمع)
    ارجع دالة_بناء(القيمة)
نهاية

# ===================================================================
#                    قيمة_قائمة: ValueNotifier للقوائم
# ===================================================================
صدّر صنف قيمة_قائمة يرث مستمع_تغيير
    باني(قائمة_أولية = لاشيء)
        الأساس()
        إذا (قائمة_أولية == لاشيء)
            هذا._قيمة = []
        وإلا
            هذا._قيمة = قائمة_أولية
        نهاية
    نهاية

    خاصية القيمة
        احصل
            ارجع هذا._قيمة
        نهاية
        عيّن(قيمة_جديدة)
            هذا._قيمة = قيمة_جديدة
            هذا.أشعر()
        نهاية
    نهاية

    دالة أضف(عنصر)
        هذا._قيمة = هذا._قيمة + [عنصر]
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة أزل(فهرس)
        متغير جديدة = []
        متغير ع = 0
        لكل عنصر في هذا._قيمة
            إذا (ع != فهرس)
                جديدة = جديدة + [عنصر]
            نهاية
            ع = ع + 1
        نهاية
        هذا._قيمة = جديدة
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة أزل_حيث(شرط)
        متغير جديدة = []
        لكل عنصر في هذا._قيمة
            إذا (ليس شرط(عنصر))
                جديدة = جديدة + [عنصر]
            نهاية
        نهاية
        هذا._قيمة = جديدة
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة امسح()
        هذا._قيمة = []
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة الطول()
        ارجع طول(هذا._قيمة)
    نهاية

    دالة احصل_عند(فهرس)
        ارجع هذا._قيمة[فهرس]
    نهاية

    دالة عيّن_عند(فهرس, قيمة)
        هذا._قيمة[فهرس] = قيمة
        هذا.أشعر()
        ارجع هذا
    نهاية
نهاية

# ===================================================================
#                    قيمة_خريطة: ValueNotifier للخرائط
# ===================================================================
صدّر صنف قيمة_خريطة يرث مستمع_تغيير
    باني(خريطة_أولية = لاشيء)
        الأساس()
        إذا (خريطة_أولية == لاشيء)
            هذا._قيمة = {}
        وإلا
            هذا._قيمة = خريطة_أولية
        نهاية
    نهاية

    خاصية القيمة
        احصل
            ارجع هذا._قيمة
        نهاية
        عيّن(قيمة_جديدة)
            هذا._قيمة = قيمة_جديدة
            هذا.أشعر()
        نهاية
    نهاية

    دالة عيّن(مفتاح, قيمة)
        هذا._قيمة[مفتاح] = قيمة
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة احصل(مفتاح)
        ارجع هذا._قيمة[مفتاح]
    نهاية

    دالة أزل(مفتاح)
        هذا._قيمة[مفتاح] = لاشيء
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة امسح()
        هذا._قيمة = {}
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة يحتوي(مفتاح)
        ارجع هذا._قيمة[مفتاح] != لاشيء
    نهاية
نهاية

# ===================================================================
#                    مخفض: Reducer Pattern (Redux-like)
# ===================================================================
صدّر صنف مخفض يرث مستمع_تغيير
    باني(حالة_أولية, دالة_اختزال)
        الأساس()
        هذا._حالة = حالة_أولية
        هذا._اختزال = دالة_اختزال
        هذا._تاريخ = [حالة_أولية]
        هذا._فهرس_تاريخ = 0
    نهاية

    دالة أرسل(إجراء)
        متغير حالة_جديدة = هذا._اختزال(هذا._حالة, إجراء)
        إذا (حالة_جديدة != هذا._حالة)
            هذا._حالة = حالة_جديدة
            هذا._تاريخ = هذا._تاريخ + [حالة_جديدة]
            هذا._فهرس_تاريخ = طول(هذا._تاريخ) - 1
            هذا.أشعر()
        نهاية
        ارجع هذا
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة تراجع()
        إذا (هذا._فهرس_تاريخ > 0)
            هذا._فهرس_تاريخ = هذا._فهرس_تاريخ - 1
            هذا._حالة = هذا._تاريخ[هذا._فهرس_تاريخ]
            هذا.أشعر()
        نهاية
        ارجع هذا
    نهاية

    دالة تقدم()
        إذا (هذا._فهرس_تاريخ < طول(هذا._تاريخ) - 1)
            هذا._فهرس_تاريخ = هذا._فهرس_تاريخ + 1
            هذا._حالة = هذا._تاريخ[هذا._فهرس_تاريخ]
            هذا.أشعر()
        نهاية
        ارجع هذا
    نهاية

    دالة يمكن_التراجع()
        ارجع هذا._فهرس_تاريخ > 0
    نهاية

    دالة يمكن_التقدم()
        ارجع هذا._فهرس_تاريخ < طول(هذا._تاريخ) - 1
    نهاية
نهاية

# ===================================================================
#                    موفر_متعدد: MultiProvider
# ===================================================================
صدّر صنف موفر_متعدد
    باني(موفرون = لاشيء)
        هذا._موفرون = موفرون
        إذا (موفرون == لاشيء)
            هذا._موفرون = []
        نهاية
    نهاية

    دالة أضف(اسم, موفر)
        هذا._موفرون = هذا._موفرون + [{"اسم": اسم, "موفر": موفر}]
        ارجع هذا
    نهاية

    دالة احصل(اسم)
        لكل م في هذا._موفرون
            إذا (م["اسم"] == اسم)
                ارجع م["موفر"]
            نهاية
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ===================================================================
#                    مستهلك: Consumer Widget
# ===================================================================
صدّر صنف مستهلك
    باني(موفر, دالة_بناء)
        هذا._موفر = موفر
        هذا._بناء = دالة_بناء
        هذا._قيمة = لاشيء
        
        # الاستماع للتغييرات
        إذا (موفر.أضف_مستمع != لاشيء)
            موفر.أضف_مستمع(لامدا()
                هذا._قيمة = موفر.القيمة
            نهاية)
        نهاية
    نهاية

    دالة بناء()
        ارجع هذا._بناء(هذا._موفر)
    نهاية
نهاية

# ===================================================================
#                    محدد: Selector للأداء
# ===================================================================
صدّر صنف محدد
    باني(موفر, دالة_اختيار, دالة_بناء)
        هذا._موفر = موفر
        هذا._اختيار = دالة_اختيار
        هذا._بناء = دالة_بناء
        هذا._قيمة_أخيرة = لاشيء
    نهاية

    دالة بناء()
        متغير قيمة_جديدة = هذا._اختيار(هذا._موفر)
        إذا (قيمة_جديدة != هذا._قيمة_أخيرة)
            هذا._قيمة_أخيرة = قيمة_جديدة
            ارجع هذا._بناء(قيمة_جديدة)
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ===================================================================
#                    حالة_مستقبلية: AsyncValue
# ===================================================================
صدّر تعداد حالة_بيانات
    تحميل
    بيانات
    خطأ
نهاية

صدّر صنف قيمة_مستقبلية يرث مستمع_تغيير
    باني()
        الأساس()
        هذا._حالة = حالة_بيانات.تحميل
        هذا._قيمة = لاشيء
        هذا._خطأ = لاشيء
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة الخطأ()
        ارجع هذا._خطأ
    نهاية

    دالة يحمّل()
        ارجع هذا._حالة == حالة_بيانات.تحميل
    نهاية

    دالة له_بيانات()
        ارجع هذا._حالة == حالة_بيانات.بيانات
    نهاية

    دالة له_خطأ()
        ارجع هذا._حالة == حالة_بيانات.خطأ
    نهاية

    دالة عيّن_تحميل()
        هذا._حالة = حالة_بيانات.تحميل
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة عيّن_بيانات(قيمة)
        هذا._حالة = حالة_بيانات.بيانات
        هذا._قيمة = قيمة
        هذا._خطأ = لاشيء
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة عيّن_خطأ(خطأ)
        هذا._حالة = حالة_بيانات.خطأ
        هذا._خطأ = خطأ
        هذا.أشعر()
        ارجع هذا
    نهاية

    دالة عندما(تحميل = لاشيء, بيانات = لاشيء, خطأ = لاشيء)
        إذا (هذا._حالة == حالة_بيانات.تحميل و تحميل != لاشيء)
            ارجع تحميل()
        نهاية
        إذا (هذا._حالة == حالة_بيانات.بيانات و بيانات != لاشيء)
            ارجع بيانات(هذا._قيمة)
        نهاية
        إذا (هذا._حالة == حالة_بيانات.خطأ و خطأ != لاشيء)
            ارجع خطأ(هذا._خطأ)
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ===================================================================
#                    ناقل_أحداث: EventBus
# ===================================================================
متغير _ناقل_مفرد = لاشيء

صدّر صنف ناقل_أحداث
    باني()
        هذا._مستمعون = {}
    نهاية

    دالة انشر(اسم_حدث, بيانات = لاشيء)
        إذا (هذا._مستمعون[اسم_حدث] != لاشيء)
            لكل مستمع في هذا._مستمعون[اسم_حدث]
                مستمع(بيانات)
            نهاية
        نهاية
    نهاية

    دالة استمع(اسم_حدث, دالة_رد)
        إذا (هذا._مستمعون[اسم_حدث] == لاشيء)
            هذا._مستمعون[اسم_حدث] = []
        نهاية
        هذا._مستمعون[اسم_حدث] = هذا._مستمعون[اسم_حدث] + [دالة_رد]
    نهاية

    دالة ألغِ(اسم_حدث, دالة_رد = لاشيء)
        إذا (دالة_رد == لاشيء)
            هذا._مستمعون[اسم_حدث] = []
        وإلا
            متغير جديدة = []
            لكل م في هذا._مستمعون[اسم_حدث]
                إذا (م != دالة_رد)
                    جديدة = جديدة + [م]
                نهاية
            نهاية
            هذا._مستمعون[اسم_حدث] = جديدة
        نهاية
    نهاية
نهاية

صدّر دالة ناقل()
    إذا (_ناقل_مفرد == لاشيء)
        _ناقل_مفرد = جديد ناقل_أحداث()
    نهاية
    ارجع _ناقل_مفرد
نهاية
