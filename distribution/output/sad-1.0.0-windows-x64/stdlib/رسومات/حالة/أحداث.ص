# ===================================================================
# نظام الأحداث — EventBus
# ===================================================================
# ناقل أحداث مركزي للتواصل بين المكونات
#
# الاستخدام:
#   استورد * من رسومات.حالة.أحداث
# ===================================================================

# ─── ناقل_أحداث (EventBus) ───
صدّر صنف ناقل_أحداث
    باني()
        هذا._مستمعون = {}
    نهاية

    دالة على(حدث, مستمع)
        إذا (هذا._مستمعون[حدث] == لاشيء)
            هذا._مستمعون[حدث] = []
        نهاية
        هذا._مستمعون[حدث].أضف(مستمع)
        ارجع هذا
    نهاية

    دالة أطلق(حدث, بيانات)
        متغير مستمعون = هذا._مستمعون[حدث]
        إذا (مستمعون != لاشيء)
            لكل م في مستمعون
                م(بيانات)
            نهاية
        نهاية
    نهاية

    دالة أزل(حدث, مستمع)
        متغير مستمعون = هذا._مستمعون[حدث]
        إذا (مستمعون != لاشيء)
            متغير جديدة = []
            لكل م في مستمعون
                إذا (م != مستمع)
                    جديدة.أضف(م)
                نهاية
            نهاية
            هذا._مستمعون[حدث] = جديدة
        نهاية
    نهاية

    دالة أزل_كل(حدث)
        هذا._مستمعون[حدث] = لاشيء
    نهاية

    دالة مرة(حدث, مستمع)
        متغير ذات = هذا
        دالة _ملفوف(بيانات)
            مستمع(بيانات)
            ذات.أزل(حدث, _ملفوف)
        نهاية
        هذا.على(حدث, _ملفوف)
        ارجع هذا
    نهاية

    دالة تنظيف()
        هذا._مستمعون = {}
    نهاية
نهاية

# ─── ناقل عام (Singleton) ───
متغير _ناقل_عام = لاشيء

صدّر دالة الأحداث()
    إذا (_ناقل_عام == لاشيء)
        _ناقل_عام = جديد ناقل_أحداث()
    نهاية
    ارجع _ناقل_عام
نهاية
