# ===================================================================
# نظام التنقل المتقدم — Advanced Navigation
# ===================================================================
# تنقل متداخل، تبويبات، درج جانبي
#
# الاستخدام:
#   استورد * من رسومات.حالة.تنقل_متقدم
# ===================================================================

# ─── تنقل_متداخل (NestedNavigation) ───
صدّر صنف تنقل_متداخل
    باني(اسم)
        هذا._اسم = اسم
        هذا._سجل = []
        هذا._فهرس = -1
        هذا._مستمعون = []
    نهاية

    دالة ادفع(مسار, بيانات)
        # حذف الصفحات بعد الحالية
        بينما (طول(هذا._سجل) > هذا._فهرس + 1)
            هذا._سجل.احذف(هذا._فهرس + 1)
        نهاية
        هذا._سجل.أضف({"مسار": مسار, "بيانات": بيانات})
        هذا._فهرس = هذا._فهرس + 1
        هذا._أشعر()
    نهاية

    دالة ارجع()
        إذا (هذا._فهرس > 0)
            هذا._فهرس = هذا._فهرس - 1
            هذا._أشعر()
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة تقدم()
        إذا (هذا._فهرس < طول(هذا._سجل) - 1)
            هذا._فهرس = هذا._فهرس + 1
            هذا._أشعر()
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة الحالي()
        إذا (هذا._فهرس >= 0 و هذا._فهرس < طول(هذا._سجل))
            ارجع هذا._سجل[هذا._فهرس]
        نهاية
        ارجع لاشيء
    نهاية

    دالة يمكن_الرجوع()
        ارجع هذا._فهرس > 0
    نهاية

    دالة يمكن_التقدم()
        ارجع هذا._فهرس < طول(هذا._سجل) - 1
    نهاية

    دالة عند_تغيير(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة _أشعر()
        متغير حالي = هذا.الحالي()
        لكل م في هذا._مستمعون
            م(حالي)
        نهاية
    نهاية
نهاية

# ─── متحكم_تبويبات (TabController) ───
صدّر صنف متحكم_تبويبات
    باني(عدد)
        هذا._عدد = عدد
        هذا._الحالي = 0
        هذا._مستمعون = []
    نهاية

    دالة الحالي()
        ارجع هذا._الحالي
    نهاية

    دالة انتقل(فهرس)
        إذا (فهرس >= 0 و فهرس < هذا._عدد)
            هذا._الحالي = فهرس
            لكل م في هذا._مستمعون
                م(فهرس)
            نهاية
        نهاية
    نهاية

    دالة التالي()
        إذا (هذا._الحالي < هذا._عدد - 1)
            هذا.انتقل(هذا._الحالي + 1)
        نهاية
    نهاية

    دالة السابق()
        إذا (هذا._الحالي > 0)
            هذا.انتقل(هذا._الحالي - 1)
        نهاية
    نهاية

    دالة عند_تغيير(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية
نهاية

# ─── متحكم_صفحات (PageController) ───
صدّر صنف متحكم_صفحات
    باني(عدد_صفحات, ابتدائي)
        إذا (ابتدائي == لاشيء)
            ابتدائي = 0
        نهاية
        هذا._عدد = عدد_صفحات
        هذا._الحالي = ابتدائي
        هذا._مستمعون = []
    نهاية

    دالة الحالي()
        ارجع هذا._الحالي
    نهاية

    دالة اذهب(صفحة)
        إذا (صفحة >= 0 و صفحة < هذا._عدد)
            هذا._الحالي = صفحة
            لكل م في هذا._مستمعون
                م(صفحة)
            نهاية
        نهاية
    نهاية

    دالة التالي()
        هذا.اذهب(هذا._الحالي + 1)
    نهاية

    دالة السابق()
        هذا.اذهب(هذا._الحالي - 1)
    نهاية

    دالة عند_تغيير(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية
نهاية

# ─── متحكم_تمرير (ScrollController) ───
صدّر صنف متحكم_تمرير
    باني()
        هذا._موضع = 0
        هذا._مستمعون = []
    نهاية

    دالة الموضع()
        ارجع هذا._موضع
    نهاية

    دالة انتقل(موضع)
        هذا._موضع = موضع
        لكل م في هذا._مستمعون
            م(موضع)
        نهاية
    نهاية

    دالة إلى_الأعلى()
        هذا.انتقل(0)
    نهاية

    دالة عند_تمرير(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية
نهاية
