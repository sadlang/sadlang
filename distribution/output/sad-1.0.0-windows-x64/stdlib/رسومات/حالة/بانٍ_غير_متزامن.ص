استورد * من رسومات.أساس.عنصر

# ─── حالة الاتصال ───
صدّر تعداد حالة_اتصال
    لاشيء_،      # لم يتصل بعد
    ينتظر،       # متصل ولكن لا بيانات
    نشط،         # بيانات متاحة (للتيارات)
    مكتمل        # اكتمل
نهاية

# ─── لقطة غير متزامنة (AsyncSnapshot) ───
صدّر صنف لقطة_غير_متزامنة
    باني(حالة_اتصال، بيانات = لاشيء، خطأ = لاشيء)
        هذا._حالة = حالة_اتصال
        هذا._بيانات = بيانات
        هذا._خطأ = خطأ
    نهاية

    دالة حالة_الاتصال()
        ارجع هذا._حالة
    نهاية

    دالة البيانات()
        ارجع هذا._بيانات
    نهاية

    دالة الخطأ()
        ارجع هذا._خطأ
    نهاية

    دالة لديه_بيانات()
        ارجع هذا._بيانات != لاشيء
    نهاية

    دالة لديه_خطأ()
        ارجع هذا._خطأ != لاشيء
    نهاية

    # ─── منشئات سريعة ───
    ساكن دالة لاشيء_()
        ارجع جديد لقطة_غير_متزامنة(حالة_اتصال.لاشيء_)
    نهاية

    ساكن دالة انتظار()
        ارجع جديد لقطة_غير_متزامنة(حالة_اتصال.ينتظر)
    نهاية

    ساكن دالة بيانات(بيانات)
        ارجع جديد لقطة_غير_متزامنة(حالة_اتصال.نشط، بيانات)
    نهاية

    ساكن دالة خطأ(خ)
        ارجع جديد لقطة_غير_متزامنة(حالة_اتصال.نشط، لاشيء، خ)
    نهاية

    ساكن دالة مكتمل(بيانات)
        ارجع جديد لقطة_غير_متزامنة(حالة_اتصال.مكتمل، بيانات)
    نهاية

    # ─── نسخ مع تعديلات ───
    دالة في_حالة(حالة)
        ارجع جديد لقطة_غير_متزامنة(حالة، هذا._بيانات، هذا._خطأ)
    نهاية
نهاية

# ─── بانٍ المستقبل (FutureBuilder) ───
صدّر صنف بانٍ_مستقبل يرث عنصر
    باني(
        مستقبل = لاشيء،
        بانٍ،
        بيانات_ابتدائية = لاشيء
    )
        هذا._نوع = "بانٍ_مستقبل"
        هذا._مستقبل = مستقبل
        هذا._بانٍ = بانٍ
        هذا._بيانات_ابتدائية = بيانات_ابتدائية
        هذا._لقطة = لقطة_غير_متزامنة.لاشيء_()
        
        إذا (بيانات_ابتدائية != لاشيء)
            هذا._لقطة = جديد لقطة_غير_متزامنة(
                حالة_اتصال.لاشيء_،
                بيانات_ابتدائية
            )
        نهاية
    نهاية

    دالة ابنِ(سياق)
        ارجع هذا._بانٍ(سياق، هذا._لقطة)
    نهاية

    دالة المستقبل()
        ارجع هذا._مستقبل
    نهاية
نهاية

# ─── بانٍ التيار (StreamBuilder) ───
صدّر صنف بانٍ_تيار يرث عنصر
    باني(
        تيار = لاشيء،
        بانٍ،
        بيانات_ابتدائية = لاشيء
    )
        هذا._نوع = "بانٍ_تيار"
        هذا._تيار = تيار
        هذا._بانٍ = بانٍ
        هذا._بيانات_ابتدائية = بيانات_ابتدائية
        هذا._لقطة = لقطة_غير_متزامنة.لاشيء_()
        هذا._اشتراك = لاشيء
        
        إذا (بيانات_ابتدائية != لاشيء)
            هذا._لقطة = جديد لقطة_غير_متزامنة(
                حالة_اتصال.لاشيء_،
                بيانات_ابتدائية
            )
        نهاية
    نهاية

    دالة ابنِ(سياق)
        ارجع هذا._بانٍ(سياق، هذا._لقطة)
    نهاية

    دالة التيار()
        ارجع هذا._تيار
    نهاية
نهاية

# ─── التيار (Stream) ───
صدّر صنف تيار
    باني()
        هذا._مشتركون = []
        هذا._مغلق = خطأ
        هذا._قيم = []
    نهاية

    دالة استمع(عند_بيانات، عند_خطأ = لاشيء، عند_اكتمال = لاشيء)
        متغير اشتراك = جديد اشتراك_تيار(هذا، عند_بيانات، عند_خطأ، عند_اكتمال)
        هذا._مشتركون.أضف(اشتراك)
        ارجع اشتراك
    نهاية

    دالة أضف(قيمة)
        إذا (هذا._مغلق)
            ارمي خطأ("التيار مغلق")
        نهاية
        
        هذا._قيم.أضف(قيمة)
        لكل م في هذا._مشتركون
            م._عند_بيانات(قيمة)
        نهاية
    نهاية

    دالة أضف_خطأ(خطأ)
        لكل م في هذا._مشتركون
            إذا (م._عند_خطأ != لاشيء)
                م._عند_خطأ(خطأ)
            نهاية
        نهاية
    نهاية

    دالة أغلق()
        هذا._مغلق = صحيح
        لكل م في هذا._مشتركون
            إذا (م._عند_اكتمال != لاشيء)
                م._عند_اكتمال()
            نهاية
        نهاية
    نهاية

    دالة مغلق()
        ارجع هذا._مغلق
    نهاية
نهاية

# ─── اشتراك التيار ───
صدّر صنف اشتراك_تيار
    باني(تيار، عند_بيانات، عند_خطأ، عند_اكتمال)
        هذا._تيار = تيار
        هذا._عند_بيانات = عند_بيانات
        هذا._عند_خطأ = عند_خطأ
        هذا._عند_اكتمال = عند_اكتمال
        هذا._موقوف = خطأ
        هذا._ملغى = خطأ
    نهاية

    دالة أوقف()
        هذا._موقوف = صحيح
    نهاية

    دالة استأنف()
        هذا._موقوف = خطأ
    نهاية

    دالة ألغِ()
        هذا._ملغى = صحيح
        هذا._تيار._مشتركون.أزل(هذا)
    نهاية

    دالة موقوف()
        ارجع هذا._موقوف
    نهاية

    دالة ملغى()
        ارجع هذا._ملغى
    نهاية
نهاية

# ─── متحكم التيار (StreamController) ───
صدّر صنف متحكم_تيار
    باني(بث = خطأ، عند_استماع = لاشيء، عند_إلغاء = لاشيء)
        هذا._تيار = جديد تيار()
        هذا._بث = بث
        هذا._عند_استماع = عند_استماع
        هذا._عند_إلغاء = عند_إلغاء
    نهاية

    دالة التيار()
        ارجع هذا._تيار
    نهاية

    دالة الحوض()
        ارجع هذا
    نهاية

    دالة أضف(قيمة)
        هذا._تيار.أضف(قيمة)
    نهاية

    دالة أضف_خطأ(خطأ)
        هذا._تيار.أضف_خطأ(خطأ)
    نهاية

    غير_متزامن دالة أغلق()
        هذا._تيار.أغلق()
    نهاية

    دالة مغلق()
        ارجع هذا._تيار.مغلق()
    نهاية
نهاية

# ─── مُكمّل (Completer) ───
صدّر صنف مُكمّل
    باني()
        هذا._مكتمل = خطأ
        هذا._قيمة = لاشيء
        هذا._خطأ = لاشيء
        هذا._ثم = []
        هذا._امسك = []
    نهاية

    دالة المستقبل()
        ارجع هذا
    نهاية

    دالة أكمل(قيمة = لاشيء)
        إذا (هذا._مكتمل)
            ارمي خطأ("المُكمّل مكتمل بالفعل")
        نهاية
        
        هذا._مكتمل = صحيح
        هذا._قيمة = قيمة
        
        لكل دالة_رد في هذا._ثم
            دالة_رد(قيمة)
        نهاية
    نهاية

    دالة أكمل_بخطأ(خطأ)
        إذا (هذا._مكتمل)
            ارمي خطأ("المُكمّل مكتمل بالفعل")
        نهاية
        
        هذا._مكتمل = صحيح
        هذا._خطأ = خطأ
        
        لكل دالة_رد في هذا._امسك
            دالة_رد(خطأ)
        نهاية
    نهاية

    دالة مكتمل()
        ارجع هذا._مكتمل
    نهاية

    دالة ثم(دالة_رد)
        إذا (هذا._مكتمل و هذا._خطأ == لاشيء)
            دالة_رد(هذا._قيمة)
        وإلا
            هذا._ثم.أضف(دالة_رد)
        نهاية
        ارجع هذا
    نهاية

    دالة امسك(دالة_رد)
        إذا (هذا._مكتمل و هذا._خطأ != لاشيء)
            دالة_رد(هذا._خطأ)
        وإلا
            هذا._امسك.أضف(دالة_رد)
        نهاية
        ارجع هذا
    نهاية
نهاية

# ─── بانٍ القيمة القابلة للاستماع (ValueListenableBuilder) ───
صدّر صنف بانٍ_قيمة_مستمعة يرث عنصر
    باني(قيمة_مستمعة، بانٍ، ابن = لاشيء)
        هذا._نوع = "بانٍ_قيمة_مستمعة"
        هذا._قيمة = قيمة_مستمعة
        هذا._بانٍ = بانٍ
        هذا._ابن = ابن
    نهاية

    دالة ابنِ(سياق)
        ارجع هذا._بانٍ(سياق، هذا._قيمة.قيمة، هذا._ابن)
    نهاية
نهاية

# ─── قيمة قابلة للاستماع (ValueListenable) ───
صدّر صنف قيمة_مستمعة
    باني(قيمة)
        هذا._قيمة = قيمة
        هذا._مستمعون = []
    نهاية

    خاصية قيمة
        احصل()
            ارجع هذا._قيمة
        نهاية
        
        عيّن(ق)
            إذا (هذا._قيمة != ق)
                هذا._قيمة = ق
                هذا._أبلغ()
            نهاية
        نهاية
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة أزل_مستمع(مستمع)
        هذا._مستمعون.أزل(مستمع)
    نهاية

    دالة _أبلغ()
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
    نهاية
نهاية
