# ===================================================================
# نظام التوجيه — Routing System
# ===================================================================
# مستوحى من Flutter (Navigator 2.0, GoRouter)
#
# الاستخدام:
#   استورد * من رسومات.حالة.توجيه
#
# الأصناف:
#   - مسار: تعريف مسار واحد
#   - موجّه: مدير التوجيه الرئيسي
#   - حارس: حارس مسار (للتحقق من الصلاحيات)
# ===================================================================

# ─── مسار (Route Definition) ───
صدّر صنف مسار
    باني(الاسم, المسار, البانٍ)
        هذا.الاسم = الاسم
        هذا.المسار = المسار
        هذا.البانٍ = البانٍ
        هذا._حراس = []
        هذا._معاملات = {}
    نهاية

    دالة حارس(دالة_تحقق)
        هذا._حراس = هذا._حراس + [دالة_تحقق]
        ارجع هذا
    نهاية

    دالة مع_معامل(اسم, قيمة)
        هذا._معاملات[اسم] = قيمة
        ارجع هذا
    نهاية
نهاية

# ─── حارس (Route Guard) ───
صدّر صنف حارس
    باني(دالة_تحقق, مسار_فشل)
        هذا._تحقق = دالة_تحقق
        هذا._فشل = مسار_فشل
    نهاية

    دالة سمح(سياق)
        ارجع هذا._تحقق(سياق)
    نهاية

    دالة مسار_التحويل()
        ارجع هذا._فشل
    نهاية
نهاية

# ─── موجّه (Router) ───
صدّر صنف موجّه
    باني()
        هذا._مسارات = {}
        هذا._سجل = []
        هذا._حالي = لاشيء
        هذا._حراس_عامون = []
        هذا._مستمعون = []
    نهاية

    دالة سجّل(مسار_جديد)
        هذا._مسارات[مسار_جديد.المسار] = مسار_جديد
        ارجع هذا
    نهاية

    دالة حارس_عام(حارس_جديد)
        هذا._حراس_عامون = هذا._حراس_عامون + [حارس_جديد]
        ارجع هذا
    نهاية

    دالة اذهب(مسار_هدف)
        متغير تم = هذا._انتقل(مسار_هدف)
        ارجع تم
    نهاية

    دالة اذهب_مع(مسار_هدف, معاملات)
        متغير م = هذا._مسارات[مسار_هدف]
        إذا (م != لاشيء)
            لكل مفتاح, قيمة في معاملات
                م._معاملات[مفتاح] = قيمة
            نهاية
        نهاية
        ارجع هذا._انتقل(مسار_هدف)
    نهاية

    دالة _انتقل(مسار_هدف)
        # تحقق من الحراس العامين
        لكل ح في هذا._حراس_عامون
            إذا (ليس ح.سمح(مسار_هدف))
                ارجع خطأ
            نهاية
        نهاية

        متغير م = هذا._مسارات[مسار_هدف]
        إذا (م == لاشيء)
            ارجع خطأ
        نهاية

        # تحقق من حراس المسار
        لكل ح في م._حراس
            إذا (ليس ح(مسار_هدف))
                ارجع خطأ
            نهاية
        نهاية

        # أضف للسجل وانتقل
        إذا (هذا._حالي != لاشيء)
            هذا._سجل = هذا._سجل + [هذا._حالي]
        نهاية
        هذا._حالي = مسار_هدف

        # أشعر المستمعين
        لكل مستمع في هذا._مستمعون
            مستمع(مسار_هدف)
        نهاية

        # بناء الصفحة وانتقال
        متغير مكوّن = م.البانٍ(م._معاملات)
        انتقل(مكوّن)
        ارجع صحيح
    نهاية

    دالة رجوع()
        إذا (هذا._سجل == [])
            ارجع خطأ
        نهاية
        متغير آخر = هذا._سجل[طول(هذا._سجل) - 1]
        هذا._سجل = هذا._سجل[0..طول(هذا._سجل) - 1]
        هذا._حالي = آخر
        عودة()
        ارجع صحيح
    نهاية

    دالة الحالي()
        ارجع هذا._حالي
    نهاية

    دالة يمكن_الرجوع()
        ارجع طول(هذا._سجل) > 0
    نهاية

    دالة عند_تغيير(دالة_رد)
        هذا._مستمعون = هذا._مستمعون + [دالة_رد]
    نهاية

    دالة استبدل_بـ(مسار_هدف)
        متغير م = هذا._مسارات[مسار_هدف]
        إذا (م == لاشيء)
            ارجع خطأ
        نهاية
        هذا._حالي = مسار_هدف
        متغير مكوّن = م.البانٍ(م._معاملات)
        استبدل(مكوّن)
        ارجع صحيح
    نهاية
نهاية

# ─── موجّه مفرد (Singleton) ───
متغير _موجه_مفرد = لاشيء

صدّر دالة الموجّه()
    إذا (_موجه_مفرد == لاشيء)
        _موجه_مفرد = جديد موجّه()
    نهاية
    ارجع _موجه_مفرد
نهاية
