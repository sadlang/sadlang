# ===================================================================
# نمط MVVM — Model-View-ViewModel
# ===================================================================
# معمارية MVVM لفصل المنطق عن العرض
#
# الاستخدام:
#   استورد * من رسومات.حالة.mvvm
# ===================================================================

# ─── نموذج_عرض (ViewModel) ───
صدّر صنف نموذج_عرض
    باني()
        هذا._خصائص = {}
        هذا._مستمعون = []
        هذا._مشغول = خطأ
        هذا._خطأ = لاشيء
    نهاية

    دالة خاصية(اسم, قيمة_ابتدائية)
        هذا._خصائص[اسم] = قيمة_ابتدائية
        ارجع هذا
    نهاية

    دالة احصل(اسم)
        ارجع هذا._خصائص[اسم]
    نهاية

    دالة عيّن(اسم, قيمة)
        هذا._خصائص[اسم] = قيمة
        هذا._أشعر()
    نهاية

    دالة مشغول()
        ارجع هذا._مشغول
    نهاية

    دالة عيّن_مشغول(قيمة)
        هذا._مشغول = قيمة
        هذا._أشعر()
    نهاية

    دالة الخطأ()
        ارجع هذا._خطأ
    نهاية

    دالة عيّن_خطأ(قيمة_خطأ)
        هذا._خطأ = قيمة_خطأ
        هذا._أشعر()
    نهاية

    دالة استمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
        ارجع هذا
    نهاية

    دالة _أشعر()
        لكل م في هذا._مستمعون
            م(هذا)
        نهاية
    نهاية

    دالة تنظيف()
        هذا._مستمعون = []
    نهاية
نهاية

# ─── أمر (Command — encapsulates action) ───
صدّر صنف أمر
    باني(تنفيذ, يمكن_تنفيذ)
        هذا._تنفيذ = تنفيذ
        هذا._يمكن = يمكن_تنفيذ
    نهاية

    دالة نفذ(بيانات)
        إذا (هذا.يمكن())
            هذا._تنفيذ(بيانات)
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة يمكن()
        إذا (هذا._يمكن == لاشيء)
            ارجع صحيح
        نهاية
        ارجع هذا._يمكن()
    نهاية
نهاية

# ─── باني_نموذج_عرض (ViewModelBuilder helper) ───
صدّر دالة باني_نموذج(نموذج, باني)
    دالة _مستمع(نم)
        باني(نم)
    نهاية
    نموذج.استمع(_مستمع)
    # بناء أولي
    باني(نموذج)
نهاية
