# ===================================================================
# نظام الحركة — Animation System
# ===================================================================
# نظام حركات كامل مطابق لـ Flutter Animation
# يشمل: متحكم الحركة، منحنيات، تحويلات، Tweens
#
# الاستخدام:
#   استورد * من رسومات.حركة_نظام.حركة
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── متحكم_حركة (AnimationController) ───
صدّر صنف متحكم_حركة
    باني(مدة = 300, حد_أدنى = 0.0, حد_أقصى = 1.0, معكوس = خطأ)
        هذا._مدة = مدة
        هذا._حد_أدنى = حد_أدنى
        هذا._حد_أقصى = حد_أقصى
        هذا._قيمة = حد_أدنى
        هذا._حالة = "متوقف"
        هذا._معكوس = معكوس
        هذا._مستمعون = []
        هذا._مستمعو_حالة = []
    نهاية

    دالة تقدم()
        هذا._حالة = "يتقدم"
        ارجع هذا
    نهاية

    دالة عكس()
        هذا._حالة = "يعكس"
        ارجع هذا
    نهاية

    دالة أوقف()
        هذا._حالة = "متوقف"
        ارجع هذا
    نهاية

    دالة إعادة()
        هذا._قيمة = هذا._حد_أدنى
        ارجع هذا
    نهاية

    دالة تكرار(عدد = -1)
        هذا._خصائص_تكرار = عدد
        ارجع هذا
    نهاية

    دالة أضف_مستمع(دالة_رد)
        هذا._مستمعون = هذا._مستمعون + [دالة_رد]
    نهاية

    دالة أضف_مستمع_حالة(دالة_رد)
        هذا._مستمعو_حالة = هذا._مستمعو_حالة + [دالة_رد]
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة تخلص()
        هذا._حالة = "منتهي"
        هذا._مستمعون = []
        هذا._مستمعو_حالة = []
    نهاية
نهاية

# ─── تحويل (Tween) ───
صدّر صنف تحويل
    باني(بداية = 0.0, نهاية_قيمة = 1.0)
        هذا._بداية = بداية
        هذا._نهاية = نهاية_قيمة
    نهاية

    دالة تقييم(حركة)
        متغير ت = حركة.القيمة()
        ارجع هذا._بداية + (هذا._نهاية - هذا._بداية) * ت
    نهاية

    دالة حرّك(متحكم)
        ارجع حركة_مقيمة(هذا, متحكم)
    نهاية
نهاية

# ─── تحويل_لون (ColorTween) ───
صدّر صنف تحويل_لون
    باني(بداية = "#000000", نهاية_لون = "#FFFFFF")
        هذا._بداية = بداية
        هذا._نهاية = نهاية_لون
    نهاية

    دالة تقييم(حركة)
        ارجع هذا._بداية
    نهاية
نهاية

# ─── تحويل_حجم (SizeTween) ───
صدّر صنف تحويل_حجم
    باني(بداية_عرض = 0, بداية_ارتفاع = 0, نهاية_عرض = 100, نهاية_ارتفاع = 100)
        هذا._بداية_عرض = بداية_عرض
        هذا._بداية_ارتفاع = بداية_ارتفاع
        هذا._نهاية_عرض = نهاية_عرض
        هذا._نهاية_ارتفاع = نهاية_ارتفاع
    نهاية

    دالة تقييم(حركة)
        متغير ت = حركة.القيمة()
        ارجع {
            "عرض": هذا._بداية_عرض + (هذا._نهاية_عرض - هذا._بداية_عرض) * ت,
            "ارتفاع": هذا._بداية_ارتفاع + (هذا._نهاية_ارتفاع - هذا._بداية_ارتفاع) * ت
        }
    نهاية
نهاية

# ─── حركة_مقيمة (Animation driven by Tween) ───
صدّر صنف حركة_مقيمة
    باني(تحويل, متحكم)
        هذا._تحويل = تحويل
        هذا._متحكم = متحكم
    نهاية

    دالة القيمة()
        ارجع هذا._تحويل.تقييم(هذا._متحكم)
    نهاية
نهاية

# ─── منحنيات (Curves) — ثوابت ───
صدّر صنف منحنيات
    ساكن ثابت خطي = "خطي"
    ساكن ثابت تسهيل = "تسهيل"
    ساكن ثابت تسهيل_دخول = "تسهيل_دخول"
    ساكن ثابت تسهيل_خروج = "تسهيل_خروج"
    ساكن ثابت تسهيل_دخول_خروج = "تسهيل_دخول_خروج"
    ساكن ثابت ارتداد_دخول = "ارتداد_دخول"
    ساكن ثابت ارتداد_خروج = "ارتداد_خروج"
    ساكن ثابت مرن_دخول = "مرن_دخول"
    ساكن ثابت مرن_خروج = "مرن_خروج"
    ساكن ثابت سريع_ثم_بطيء = "سريع_ثم_بطيء"
    ساكن ثابت بطيء_وسط = "بطيء_وسط"
نهاية
