# ===================================================================
# Hero Animation — انتقال بطولي بين الصفحات
# ===================================================================
# مطابق لـ Flutter Hero widget
# يوفر انتقال سلس للعناصر بين الصفحات
#
# الاستخدام:
#   استورد بطل من رسومات.حركة_نظام.بطل
#
#   بطل(
#       وسم: "صورة_ملف",
#       ابن: صورة(مصدر: "avatar.png")
#   )
# ===================================================================

استورد * من رسومات.أساس.عنصر
استورد * من رسومات.حالة.حركات

# ─── أنواع انتقال البطل ───
صدّر تعداد نوع_انتقال_بطل
    قياسي          # الانتقال العادي
    تلاشي          # تلاشي أثناء الانتقال  
    مقياس          # تكبير/تصغير أثناء الانتقال
    انزلاق         # انزلاق أفقي
نهاية

# ─── إعدادات رحلة البطل ───
صدّر صنف إعدادات_رحلة
    باني()
        هذا.مدة = 300
        هذا.منحنى = "تسهيل"
        هذا.نوع = نوع_انتقال_بطل.قياسي
        هذا.إنشاء_عنصر_بديل = لاشيء
        هذا.قابل_للطيران = صحيح
    نهاية

    دالة مع_مدة(مدة)
        هذا.مدة = مدة
        ارجع هذا
    نهاية

    دالة مع_منحنى(منحنى)
        هذا.منحنى = منحنى
        ارجع هذا
    نهاية

    دالة مع_نوع(نوع)
        هذا.نوع = نوع
        ارجع هذا
    نهاية
نهاية

# ─── صنف البطل (Hero) ───
صدّر صنف بطل يرث عنصر
    باني(وسم, ابن = لاشيء, إنشاء_عنصر_بديل = لاشيء, قابل_للطيران = صحيح, إعدادات = لاشيء)
        هذا._نوع = "بطل"
        هذا._خصائص = {}
        هذا._ابن = ابن
        هذا._خصائص["وسم"] = وسم
        هذا._خصائص["إنشاء_عنصر_بديل"] = إنشاء_عنصر_بديل
        هذا._خصائص["قابل_للطيران"] = قابل_للطيران
        
        إذا (إعدادات == لاشيء)
            إعدادات = جديد إعدادات_رحلة()
        نهاية
        هذا._خصائص["إعدادات"] = إعدادات
    نهاية

    # ─── دوال الوصول ───
    دالة احصل_الوسم()
        ارجع هذا._خصائص["وسم"]
    نهاية

    دالة احصل_قابل_للطيران()
        ارجع هذا._خصائص["قابل_للطيران"]
    نهاية

    # ─── دوال التعديل ───
    دالة عيّن_الوسم(وسم)
        هذا._خصائص["وسم"] = وسم
        ارجع هذا
    نهاية

    دالة عيّن_قابل_للطيران(قيمة)
        هذا._خصائص["قابل_للطيران"] = قيمة
        ارجع هذا
    نهاية
نهاية

# ─── متحكم رحلة البطل ───
صدّر صنف متحكم_رحلة_بطل
    باني()
        هذا._أبطال_نشطين = {}
        هذا._رحلات_جارية = []
    نهاية

    ## تسجيل بطل جديد
    دالة سجّل(وسم, بطل_عنصر)
        هذا._أبطال_نشطين[وسم] = بطل_عنصر
    نهاية

    ## إلغاء تسجيل بطل
    دالة ألغِ_تسجيل(وسم)
        هذا._أبطال_نشطين[وسم] = لاشيء
    نهاية

    ## بدء رحلة بطل
    دالة ابدأ_رحلة(وسم_من, وسم_إلى, مدة = 300)
        متغير من = هذا._أبطال_نشطين[وسم_من]
        متغير إلى = هذا._أبطال_نشطين[وسم_إلى]
        
        إذا (من == لاشيء أو إلى == لاشيء)
            ارجع خطأ
        نهاية

        متغير رحلة = {
            "من": من,
            "إلى": إلى,
            "تقدم": 0.0,
            "مدة": مدة,
            "بدأت": صحيح
        }
        
        هذا._رحلات_جارية.أضف(رحلة)
        ارجع صحيح
    نهاية

    ## إلغاء جميع الرحلات
    دالة ألغِ_الكل()
        هذا._رحلات_جارية = []
    نهاية

    ## الحصول على عدد الرحلات الجارية
    دالة عدد_الرحلات()
        ارجع هذا._رحلات_جارية.الطول()
    نهاية
نهاية

# ─── متحكم رحلة عام (Singleton) ───
متغير _متحكم_رحلة_مفرد = لاشيء

صدّر دالة متحكم_الرحلة()
    إذا (_متحكم_رحلة_مفرد == لاشيء)
        _متحكم_رحلة_مفرد = جديد متحكم_رحلة_بطل()
    نهاية
    ارجع _متحكم_رحلة_مفرد
نهاية

# ─── دوال مساعدة ───

## إنشاء بطل بسيط
صدّر دالة بطل_بسيط(وسم, ابن)
    ارجع جديد بطل(وسم, ابن)
نهاية

## إنشاء بطل مع تلاشي
صدّر دالة بطل_تلاشي(وسم, ابن)
    متغير إعدادات = جديد إعدادات_رحلة()
    إعدادات.نوع = نوع_انتقال_بطل.تلاشي
    ارجع جديد بطل(وسم, ابن, لاشيء, صحيح, إعدادات)
نهاية

## إنشاء بطل مع تكبير
صدّر دالة بطل_مقياس(وسم, ابن)
    متغير إعدادات = جديد إعدادات_رحلة()
    إعدادات.نوع = نوع_انتقال_بطل.مقياس
    ارجع جديد بطل(وسم, ابن, لاشيء, صحيح, إعدادات)
نهاية
