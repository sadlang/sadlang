# ===================================================================
# Implicit Animations — حركات ضمنية تلقائية
# ===================================================================
# مطابق لـ Flutter AnimatedContainer, AnimatedOpacity, AnimatedScale, etc.
# الحركات تحدث تلقائياً عند تغيير القيم
#
# الاستخدام:
#   استورد * من رسومات.حركة_نظام.ضمنية
#
#   حاوية_متحركة(
#       عرض: 100,
#       ارتفاع: 100,
#       مدة: 300,
#       لون: "#FF0000"
#   )
# ===================================================================

استورد * من رسومات.أساس.عنصر
استورد * من رسومات.حالة.حركات

# ===================================================================
#                    حاوية_متحركة (AnimatedContainer)
# ===================================================================
صدّر صنف حاوية_متحركة يرث عنصر
    باني(ابن = لاشيء, عرض = لاشيء, ارتفاع = لاشيء, لون = لاشيء, 
         حشو = لاشيء, هامش = لاشيء, زوايا = لاشيء, ظل = لاشيء,
         حد_لون = لاشيء, حد_سماكة = لاشيء, تحويل = لاشيء,
         مدة = 300, منحنى = "تسهيل", عند_الانتهاء = لاشيء)
        هذا._نوع = "حاوية_متحركة"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["لون"] = لون
        هذا._خصائص["حشو"] = حشو
        هذا._خصائص["هامش"] = هامش
        هذا._خصائص["زوايا"] = زوايا
        هذا._خصائص["ظل"] = ظل
        هذا._خصائص["حد_لون"] = حد_لون
        هذا._خصائص["حد_سماكة"] = حد_سماكة
        هذا._خصائص["تحويل"] = تحويل
        هذا._خصائص["مدة"] = مدة
        هذا._خصائص["منحنى"] = منحنى
        هذا._خصائص["عند_الانتهاء"] = عند_الانتهاء
        # القيم السابقة للمقارنة
        هذا._قيم_سابقة = {}
    نهاية

    # ─── دوال التعديل مع حركة ───
    دالة حرّك_إلى_عرض(عرض_جديد)
        هذا._قيم_سابقة["عرض"] = هذا._خصائص["عرض"]
        هذا._خصائص["عرض"] = عرض_جديد
        ارجع هذا
    نهاية

    دالة حرّك_إلى_ارتفاع(ارتفاع_جديد)
        هذا._قيم_سابقة["ارتفاع"] = هذا._خصائص["ارتفاع"]
        هذا._خصائص["ارتفاع"] = ارتفاع_جديد
        ارجع هذا
    نهاية

    دالة حرّك_إلى_لون(لون_جديد)
        هذا._قيم_سابقة["لون"] = هذا._خصائص["لون"]
        هذا._خصائص["لون"] = لون_جديد
        ارجع هذا
    نهاية

    دالة عيّن_المدة(مدة)
        هذا._خصائص["مدة"] = مدة
        ارجع هذا
    نهاية

    دالة عيّن_المنحنى(منحنى)
        هذا._خصائص["منحنى"] = منحنى
        ارجع هذا
    نهاية
نهاية

