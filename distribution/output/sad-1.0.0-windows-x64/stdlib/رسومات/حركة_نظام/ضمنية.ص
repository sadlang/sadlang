        هذا._خصائص["أظهر_الأول"] = أظهر_الأول
        هذا._خصائص["مدة"] = مدة
        هذا._خصائص["منحنى_أول"] = منحنى_أول
        هذا._خصائص["منحنى_ثاني"] = منحنى_ثاني
    نهاية

    دالة أظهر_الأول()
        هذا._خصائص["أظهر_الأول"] = صحيح
        ارجع هذا
    نهاية

    دالة أظهر_الثاني()
        هذا._خصائص["أظهر_الأول"] = خطأ
        ارجع هذا
    نهاية

    دالة بدّل()
        هذا._خصائص["أظهر_الأول"] = ليس هذا._خصائص["أظهر_الأول"]
        ارجع هذا
