# ===================================================================
#                    قائمة_متحركة (AnimatedList)
# ===================================================================
صدّر صنف قائمة_متحركة يرث عنصر
    باني(عناصر = [], باني = لاشيء, مدة_إدراج = 300, مدة_إزالة = 300)
        هذا._نوع = "قائمة_متحركة"
        هذا._خصائص = {}
        هذا._خصائص["عناصر"] = عناصر
        هذا._خصائص["باني"] = باني
        هذا._خصائص["مدة_إدراج"] = مدة_إدراج
        هذا._خصائص["مدة_إزالة"] = مدة_إزالة
    نهاية

    دالة أدرج(فهرس, عنصر)
        متغير عناصر = هذا._خصائص["عناصر"]
        # إدراج في الموضع المحدد
        متغير جديدة = []
        متغير ف = 0
        لكل ع في عناصر
            إذا (ف == فهرس)
                جديدة.أضف(عنصر)
            نهاية
            جديدة.أضف(ع)
            ف = ف + 1
        نهاية
        إذا (فهرس >= ف)
            جديدة.أضف(عنصر)
        نهاية
        هذا._خصائص["عناصر"] = جديدة
        ارجع هذا
    نهاية

    دالة أزل(فهرس)
        متغير عناصر = هذا._خصائص["عناصر"]
        متغير جديدة = []
        متغير ف = 0
        لكل ع في عناصر
            إذا (ف != فهرس)
                جديدة.أضف(ع)
            نهاية
            ف = ف + 1
        نهاية
        هذا._خصائص["عناصر"] = جديدة
        ارجع هذا
    نهاية
نهاية
