# ===================================================================
# Overlay — الطبقات العائمة
# ===================================================================
# مطابق لـ Flutter Overlay, OverlayEntry, OverlayState
# دعم الطبقات العائمة والقوائم المنسدلة والتلميحات
#
# الاستخدام:
#   استورد * من رسومات.طبقة_نظام.طبقة
#
#   متغير مدخل = مدخل_طبقة(
#       باني: دالة(سياق)
#           ارجع حاوية(لون: "#FF0000", عرض: 100, ارتفاع: 100)
#       نهاية
#   )
#   طبقة.من(سياق).أدرج(مدخل)
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    مدخل_طبقة (OverlayEntry)
# ===================================================================
صدّر صنف مدخل_طبقة
    باني(باني = لاشيء, مبهم = خطأ, قابل_للصيانة = صحيح)
        هذا._باني = باني
        هذا._مبهم = مبهم
        هذا._قابل_للصيانة = قابل_للصيانة
        هذا._مرئي = صحيح
        هذا._ملحق = خطأ
        هذا._طبقة = لاشيء
    نهاية

    # بناء العنصر
    دالة ابنِ(سياق)
        إذا (هذا._باني != لاشيء)
            ارجع هذا._باني(سياق)
        نهاية
        ارجع لاشيء
    نهاية

    # إزالة المدخل
    دالة أزل()
        إذا (هذا._طبقة != لاشيء و هذا._ملحق)
            هذا._طبقة.أزل_مدخل(هذا)
            هذا._ملحق = خطأ
        نهاية
    نهاية

    # تحديث المدخل
    دالة علّم_بحاجة_للبناء()
        إذا (هذا._طبقة != لاشيء)
            هذا._طبقة.أعد_بناء_مدخل(هذا)
        نهاية
    نهاية

    # تعيين الرؤية
    دالة عيّن_مرئي(مرئي)
        هذا._مرئي = مرئي
        هذا.علّم_بحاجة_للبناء()
    نهاية

    دالة مرئي()
        ارجع هذا._مرئي
    نهاية

    دالة ملحق()
        ارجع هذا._ملحق
    نهاية

    دالة عيّن_الطبقة(طبقة)
        هذا._طبقة = طبقة
        هذا._ملحق = صحيح
    نهاية
نهاية

# ===================================================================
#                    حالة_طبقة (OverlayState)
# ===================================================================
صدّر صنف حالة_طبقة
    باني()
        هذا._مداخل = []
    نهاية

    # إدراج مدخل
    دالة أدرج(مدخل, فوق = لاشيء, تحت = لاشيء)
        مدخل.عيّن_الطبقة(هذا)
        
        إذا (تحت != لاشيء)
            متغير فهرس = هذا._ابحث_عن_فهرس(تحت)
            إذا (فهرس >= 0)
                هذا._أدرج_في_موضع(مدخل, فهرس)
                ارجع
            نهاية
        نهاية
        
        إذا (فوق != لاشيء)
            متغير فهرس = هذا._ابحث_عن_فهرس(فوق)
            إذا (فهرس >= 0)
                هذا._أدرج_في_موضع(مدخل, فهرس + 1)
                ارجع
            نهاية
        نهاية
        
        هذا._مداخل.أضف(مدخل)
    نهاية

    # إدراج مداخل متعددة
    دالة أدرج_الكل(مداخل, فوق = لاشيء, تحت = لاشيء)
        لكل مدخل في مداخل
            هذا.أدرج(مدخل, فوق, تحت)
        نهاية
    نهاية

    # إعادة ترتيب مدخل
    دالة أعد_ترتيب(مدخل, فوق = لاشيء, تحت = لاشيء)
        هذا.أزل_مدخل(مدخل)
        هذا.أدرج(مدخل, فوق, تحت)
    نهاية

    # إزالة مدخل
    دالة أزل_مدخل(مدخل)
        متغير جديدة = []
        لكل م في هذا._مداخل
            إذا (م != مدخل)
                جديدة.أضف(م)
            نهاية
        نهاية
        هذا._مداخل = جديدة
    نهاية

    # الحصول على المداخل
    دالة المداخل()
        ارجع هذا._مداخل
    نهاية

    # إعادة بناء مدخل
    دالة أعد_بناء_مدخل(مدخل)
        # أعد البناء
    نهاية

    # ─── دوال مساعدة داخلية ───
    دالة _ابحث_عن_فهرس(مدخل)
        متغير ف = 0
        لكل م في هذا._مداخل
            إذا (م == مدخل)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    دالة _أدرج_في_موضع(مدخل, موضع)
        متغير جديدة = []
        متغير ف = 0
        لكل م في هذا._مداخل
            إذا (ف == موضع)
                جديدة.أضف(مدخل)
            نهاية
            جديدة.أضف(م)
            ف = ف + 1
        نهاية
        إذا (موضع >= ف)
            جديدة.أضف(مدخل)
        نهاية
        هذا._مداخل = جديدة
    نهاية
نهاية

# ===================================================================
#                    طبقة (Overlay Widget)
# ===================================================================
صدّر صنف طبقة يرث عنصر
    ساكن متغير _مثيل = لاشيء

    باني(ابن = لاشيء, مداخل_أولية = [])
        هذا._نوع = "طبقة"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._حالة = حالة_طبقة()
        
        لكل مدخل في مداخل_أولية
            هذا._حالة.أدرج(مدخل)
        نهاية
        
        طبقة._مثيل = هذا
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    # الوصول للطبقة من السياق
    ساكن دالة من(سياق)
        إذا (طبقة._مثيل != لاشيء)
            ارجع طبقة._مثيل._حالة
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ===================================================================
#                    موضع_طبقة (Positioned Overlay)
# ===================================================================
صدّر صنف موضع_طبقة يرث عنصر
    باني(ابن = لاشيء, يسار = لاشيء, أعلى = لاشيء,
         يمين = لاشيء, أسفل = لاشيء, عرض = لاشيء, ارتفاع = لاشيء)
        هذا._نوع = "موضع_طبقة"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["يسار"] = يسار
        هذا._خصائص["أعلى"] = أعلى
        هذا._خصائص["يمين"] = يمين
        هذا._خصائص["أسفل"] = أسفل
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
    نهاية
نهاية

# ===================================================================
#                    باب_طبقة (OverlayPortal) - Flutter 3.7+
# ===================================================================
صدّر صنف باب_طبقة يرث عنصر
    باني(متحكم = لاشيء, باني_طبقة = لاشيء, ابن = لاشيء)
        هذا._نوع = "باب_طبقة"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["متحكم"] = متحكم
        هذا._خصائص["باني_طبقة"] = باني_طبقة
    نهاية
نهاية

# ===================================================================
#                    متحكم_باب_طبقة (OverlayPortalController)
# ===================================================================
صدّر صنف متحكم_باب_طبقة
    باني()
        هذا._مظهر = خطأ
        هذا._مستمعون = []
    نهاية

    دالة أظهر()
        هذا._مظهر = صحيح
        هذا._أخطر()
    نهاية

    دالة أخفِ()
        هذا._مظهر = خطأ
        هذا._أخطر()
    نهاية

    دالة بدّل()
        هذا._مظهر = ليس هذا._مظهر
        هذا._أخطر()
    نهاية

    دالة مظهر()
        ارجع هذا._مظهر
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة أزل_مستمع(مستمع)
        متغير جديدة = []
        لكل م في هذا._مستمعون
            إذا (م != مستمع)
                جديدة.أضف(م)
            نهاية
        نهاية
        هذا._مستمعون = جديدة
    نهاية

    دالة _أخطر()
        لكل مستمع في هذا._مستمعون
            مستمع()
        نهاية
    نهاية
نهاية

# ===================================================================
#                    كائن_مركب (CompositedTransformTarget/Follower)
# ===================================================================
صدّر صنف رابط_طبقة
    باني()
        هذا._هدف = لاشيء
        هذا._رابط = لاشيء
    نهاية

    دالة ارتباط()
        ارجع هذا._رابط
    نهاية
نهاية

صدّر صنف هدف_تحويل_مركب يرث عنصر
    باني(رابط = لاشيء, ابن = لاشيء)
        هذا._نوع = "هدف_تحويل_مركب"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["رابط"] = رابط
    نهاية
نهاية

صدّر صنف تابع_تحويل_مركب يرث عنصر
    باني(رابط = لاشيء, إزاحة_هدف = لاشيء, إزاحة_تابع = لاشيء,
         ابن = لاشيء, أظهر_عندما_غير_مرتبط = خطأ)
        هذا._نوع = "تابع_تحويل_مركب"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["رابط"] = رابط
        هذا._خصائص["إزاحة_هدف"] = إزاحة_هدف
        هذا._خصائص["إزاحة_تابع"] = إزاحة_تابع
        هذا._خصائص["أظهر_عندما_غير_مرتبط"] = أظهر_عندما_غير_مرتبط
    نهاية
نهاية

# ===================================================================
#                    حاجز (Barrier)
# ===================================================================
صدّر صنف حاجز_طراز يرث عنصر
    باني(لون = "#80000000", مبهم = صحيح, قابل_للإغلاق = صحيح,
         عند_الإغلاق = لاشيء, ابن = لاشيء)
        هذا._نوع = "حاجز_طراز"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["لون"] = لون
        هذا._خصائص["مبهم"] = مبهم
        هذا._خصائص["قابل_للإغلاق"] = قابل_للإغلاق
        هذا._خصائص["عند_الإغلاق"] = عند_الإغلاق
    نهاية
نهاية

# ===================================================================
#                    دوال مساعدة
# ===================================================================

# إظهار طبقة بسيطة
صدّر دالة أظهر_طبقة(سياق, باني, موضع = لاشيء)
    متغير مدخل = مدخل_طبقة(
        باني: دالة(س)
            متغير عنصر = باني(س)
            إذا (موضع != لاشيء)
                ارجع موضع_طبقة(
                    ابن: عنصر,
                    يسار: موضع["يسار"],
                    أعلى: موضع["أعلى"]
                )
            نهاية
            ارجع عنصر
        نهاية
    )
    طبقة.من(سياق).أدرج(مدخل)
    ارجع مدخل
نهاية

# إظهار قائمة منسدلة
صدّر دالة أظهر_قائمة_منسدلة(سياق, عناصر, موضع, عند_الاختيار)
    متغير مدخل = مدخل_طبقة(
        باني: دالة(س)
            ارجع موضع_طبقة(
                يسار: موضع["يسار"],
                أعلى: موضع["أعلى"],
                ابن: حاوية(
                    لون: "#FFFFFF",
                    ظل: 4,
                    زوايا: 8,
                    # قائمة العناصر...
                )
            )
        نهاية
    )
    طبقة.من(سياق).أدرج(مدخل)
    ارجع مدخل
نهاية

# إظهار تلميح
صدّر دالة أظهر_تلميح(سياق, نص, موضع, مدة = 2000)
    متغير مدخل = مدخل_طبقة(
        باني: دالة(س)
            ارجع موضع_طبقة(
                يسار: موضع["يسار"],
                أعلى: موضع["أعلى"],
                ابن: حاوية(
                    لون: "#333333",
                    حشو: 8,
                    زوايا: 4,
                    # نص التلميح...
                )
            )
        نهاية
    )
    طبقة.من(سياق).أدرج(مدخل)
    # إزالة بعد المدة
    # انتظر(مدة).ثم(مدخل.أزل)
    ارجع مدخل
نهاية
