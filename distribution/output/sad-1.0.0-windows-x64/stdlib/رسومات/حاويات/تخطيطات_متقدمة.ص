# ===================================================================
#                   شبكة_متجاوبة (Responsive Grid)
# ===================================================================
صدّر صنف شبكة_متجاوبة يرث عنصر
    باني(أبناء = [], أعمدة = 12, تباعد = 16, تباعد_عمودي = لاشيء,
         نقاط_توقف = لاشيء)
        هذا._نوع = "شبكة_متجاوبة"
        هذا._أبناء = أبناء
        هذا._خصائص = {}
        هذا._خصائص["أعمدة"] = أعمدة
        هذا._خصائص["تباعد"] = تباعد
        هذا._خصائص["تباعد_عمودي"] = تباعد_عمودي
        
        # نقاط التوقف الافتراضية
        إذا (نقاط_توقف == لاشيء)
            نقاط_توقف = {
                "صغير_جداً": 576,
                "صغير": 768,
                "متوسط": 992,
                "كبير": 1200,
                "كبير_جداً": 1400
            }
        نهاية
        هذا._خصائص["نقاط_توقف"] = نقاط_توقف
    نهاية
نهاية

