        هذا._خصائص["عند_الإضافة"] = عند_الإضافة
    نهاية

    دالة أضف_تبويب(تبويب)
        هذا._خصائص["تبويبات"].أضف(تبويب)
        ارجع هذا
    نهاية

    دالة أزل_تبويب(فهرس)
        متغير جديدة = []
        متغير ف = 0
        لكل ت في هذا._خصائص["تبويبات"]
            إذا (ف != فهرس)
                جديدة.أضف(ت)
            نهاية
            ف = ف + 1
        نهاية
        هذا._خصائص["تبويبات"] = جديدة
        ارجع هذا
    نهاية
نهاية

