استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    حوار: Dialog
# ===================================================================

صدّر صنف حوار يرث عنصر
    باني(عنوان = لاشيء, محتوى = لاشيء, إجراءات = لاشيء, خلفية = لاشيء, زوايا = لاشيء, عرض = لاشيء)
        هذا._نوع = "حوار"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["محتوى"] = محتوى
        هذا._خصائص["إجراءات"] = إجراءات
        هذا._خصائص["خلفية"] = خلفية
        هذا._خصائص["زوايا"] = زوايا
        هذا._خصائص["عرض"] = عرض
    نهاية

    دالة احصل_العنوان()
        ارجع هذا._خصائص["عنوان"]
    نهاية

    دالة عيّن_العنوان(قيمة)
        هذا._خصائص["عنوان"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_المحتوى(محتوى)
        هذا._خصائص["محتوى"] = محتوى
        ارجع هذا
    نهاية
نهاية

