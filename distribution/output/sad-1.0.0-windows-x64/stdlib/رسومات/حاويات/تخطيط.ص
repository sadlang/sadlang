# ===================================================================
#                    عمود: ترتيب عمودي
# ===================================================================

صدّر صنف عمود يرث عنصر
    باني(أبناء = لاشيء, تباعد = لاشيء, محاذاة = لاشيء, خلفية = لاشيء, حشو = لاشيء, هامش = لاشيء, محاذاة_أفقية = لاشيء)
        هذا._نوع = "عمود"
        هذا._أبناء = أبناء
        هذا._خصائص = {}
        هذا._خصائص["تباعد"] = تباعد
        هذا._خصائص["محاذاة"] = محاذاة
        هذا._خصائص["خلفية"] = خلفية
        هذا._خصائص["حشو"] = حشو
        هذا._خصائص["هامش"] = هامش
        هذا._خصائص["محاذاة_أفقية"] = محاذاة_أفقية
    نهاية

    دالة احصل_التباعد()
        ارجع هذا._خصائص["تباعد"]
    نهاية

    دالة عيّن_التباعد(قيمة)
        هذا._خصائص["تباعد"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_المحاذاة(قيمة)
        هذا._خصائص["محاذاة"] = قيمة
        ارجع هذا
    نهاية
نهاية

