# ===================================================================
# محرك تصيير الويب — Widget-to-HTML Renderer
# ===================================================================
#
# يحوّل شجرة عناصر ص إلى HTML للعرض في المتصفح (WASM)
# يدعم جميع عناصر الواجهة الرسومية لمكتبة رسومات ص
#
# الميزات:
#   - تحويل كامل لشجرة العناصر إلى HTML
#   - دعم CSS مدمج وأنماط مخصصة
#   - ربط الأحداث (onclick, onchange, etc.)
#   - المظاهر (فاتح/داكن) والسمات
#   - دعم RTL الكامل للعربية
#   - توليد صفحات HTML كاملة
#   - تحسينات SEO والأداء
#
# الاستخدام:
#   استورد محرك_تصيير_ويب من رسومات.ويب.تصيير
#   
#   متغير محرك = جديد محرك_تصيير_ويب("تطبيقي")
#   متغير html = محرك.صفحة_كاملة(عنصر_الجذر)
#
# ===================================================================

استورد * من رسومات.ويب.دوم

# ─────────────────────────────────────────────────────────────────
#  تعداد: وضع_المظهر — Light/Dark mode
# ─────────────────────────────────────────────────────────────────
صدّر تعداد وضع_المظهر
    فاتح
    داكن
    تلقائي
نهاية

# ─────────────────────────────────────────────────────────────────
#  تعداد: حجم_الشاشة — للاستعلامات المتجاوبة
# ─────────────────────────────────────────────────────────────────
صدّر تعداد حجم_الشاشة
    صغير_جداً    # < 576px (هواتف)
    صغير         # 576px - 768px
    متوسط        # 768px - 992px
    كبير         # 992px - 1200px
    كبير_جداً    # > 1200px
نهاية

# ─────────────────────────────────────────────────────────────────
#  صنف: سمة_مظهر — Theme definition
# ─────────────────────────────────────────────────────────────────
صدّر صنف سمة_مظهر
    باني(اسم = "افتراضي")
        هذا.اسم = اسم
        # الألوان الأساسية
        هذا.لون_أساسي = "#2196F3"
        هذا.لون_ثانوي = "#FF4081"
        هذا.لون_نجاح = "#4CAF50"
        هذا.لون_تحذير = "#FF9800"
        هذا.لون_خطأ = "#F44336"
        هذا.لون_معلومات = "#00BCD4"
        # ألوان الخلفية والنص
        هذا.لون_خلفية = "#FFFFFF"
        هذا.لون_سطح = "#F5F5F5"
        هذا.لون_نص = "#212121"
        هذا.لون_نص_ثانوي = "#757575"
        هذا.لون_حد = "#E0E0E0"
        # الخطوط
        هذا.خط_أساسي = "'Segoe UI', 'Cairo', Tahoma, sans-serif"
        هذا.حجم_خط_أساسي = "16px"
        # الظلال
        هذا.ظل_صغير = "0 1px 3px rgba(0,0,0,0.12)"
        هذا.ظل_متوسط = "0 4px 6px rgba(0,0,0,0.15)"
        هذا.ظل_كبير = "0 10px 20px rgba(0,0,0,0.19)"
        # نصف القطر
        هذا.نصف_قطر_صغير = "4px"
        هذا.نصف_قطر_متوسط = "8px"
        هذا.نصف_قطر_كبير = "16px"
    نهاية

    ## إنشاء سمة داكنة
    دالة ساكن داكنة()
        متغير سمة = جديد سمة_مظهر("داكن")
        سمة.لون_خلفية = "#121212"
        سمة.لون_سطح = "#1E1E1E"
        سمة.لون_نص = "#FFFFFF"
        سمة.لون_نص_ثانوي = "#B0B0B0"
        سمة.لون_حد = "#333333"
        ارجع سمة
    نهاية

    ## تحويل السمة إلى CSS variables
    دالة إلى_متغيرات_css()
        متغير css = ":root {\n"
        css = css + "  --color-primary: " + هذا.لون_أساسي + ";\n"
        css = css + "  --color-secondary: " + هذا.لون_ثانوي + ";\n"
        css = css + "  --color-success: " + هذا.لون_نجاح + ";\n"
        css = css + "  --color-warning: " + هذا.لون_تحذير + ";\n"
        css = css + "  --color-error: " + هذا.لون_خطأ + ";\n"
        css = css + "  --color-info: " + هذا.لون_معلومات + ";\n"
        css = css + "  --color-background: " + هذا.لون_خلفية + ";\n"
        css = css + "  --color-surface: " + هذا.لون_سطح + ";\n"
        css = css + "  --color-text: " + هذا.لون_نص + ";\n"
        css = css + "  --color-text-secondary: " + هذا.لون_نص_ثانوي + ";\n"
        css = css + "  --color-border: " + هذا.لون_حد + ";\n"
        css = css + "  --font-family: " + هذا.خط_أساسي + ";\n"
        css = css + "  --font-size-base: " + هذا.حجم_خط_أساسي + ";\n"
        css = css + "  --shadow-sm: " + هذا.ظل_صغير + ";\n"
        css = css + "  --shadow-md: " + هذا.ظل_متوسط + ";\n"
        css = css + "  --shadow-lg: " + هذا.ظل_كبير + ";\n"
        css = css + "  --radius-sm: " + هذا.نصف_قطر_صغير + ";\n"
        css = css + "  --radius-md: " + هذا.نصف_قطر_متوسط + ";\n"
        css = css + "  --radius-lg: " + هذا.نصف_قطر_كبير + ";\n"
        css = css + "}\n"
        ارجع css
    نهاية
نهاية

# ─────────────────────────────────────────────────────────────────
#  صنف: محرك_تصيير_ويب — Main Web Renderer
# ─────────────────────────────────────────────────────────────────
صدّر صنف محرك_تصيير_ويب
    باني(عنوان = "تطبيق ص", اتجاه = "rtl", لغة = "ar")
        هذا.عنوان = عنوان
        هذا.اتجاه = اتجاه
        هذا.لغة = لغة
        هذا._أنماط_عامة = ""
        هذا._سكريبتات = ""
        هذا._سمة = جديد سمة_مظهر()
        هذا._معرف_عداد = 0
        هذا._أحداث = []
        هذا._meta_tags = []
        هذا._روابط_خارجية = []
    نهاية

    ## تعيين السمة
    دالة عيّن_سمة(سمة)
        هذا._سمة = سمة
    نهاية

    ## إضافة meta tag
    دالة أضف_meta(اسم, محتوى)
        هذا._meta_tags.أضف({"اسم": اسم, "محتوى": محتوى})
    نهاية

    ## إضافة رابط خارجي (CSS أو خط)
    دالة أضف_رابط(href, rel = "stylesheet")
        هذا._روابط_خارجية.أضف({"href": href, "rel": rel})
    نهاية

    ## توليد معرف فريد
    دالة _معرف_جديد()
        هذا._معرف_عداد = هذا._معرف_عداد + 1
        ارجع "sad-el-" + هذا._معرف_عداد
    نهاية

    # ═══════════════════════════════════════════════════════════════
    #  تحويل عنصر ص إلى HTML — Main render function
    # ═══════════════════════════════════════════════════════════════
    دالة صيّر(عنصر)
        إذا (عنصر == لاشيء)
            ارجع جديد عنصر_ويب("div").عيّن_نص("فارغ")
        نهاية

        متغير نوع = عنصر["_نوع"]

        إذا (نوع == لاشيء)
            ارجع جديد عنصر_ويب("div")
        نهاية

        # ─── تصيير حسب النوع ───
        # النصوص والعناوين
        إذا (نوع == "نص")
            ارجع هذا._صيّر_نص(عنصر)
        نهاية
        إذا (نوع == "عنوان")
            ارجع هذا._صيّر_عنوان(عنصر)
        نهاية
        إذا (نوع == "فقرة")
            ارجع هذا._صيّر_فقرة(عنصر)
        نهاية

        # الأزرار والروابط
        إذا (نوع == "زر")
            ارجع هذا._صيّر_زر(عنصر)
        نهاية
        إذا (نوع == "رابط")
            ارجع هذا._صيّر_رابط(عنصر)
        نهاية
        إذا (نوع == "زر_أيقونة")
            ارجع هذا._صيّر_زر_أيقونة(عنصر)
        نهاية

        # التخطيط
        إذا (نوع == "عمود")
            ارجع هذا._صيّر_حاوية(عنصر, "column")
        نهاية
        إذا (نوع == "صف")
            ارجع هذا._صيّر_حاوية(عنصر, "row")
        نهاية
        إذا (نوع == "حاوية")
            ارجع هذا._صيّر_حاوية_عامة(عنصر)
        نهاية
        إذا (نوع == "شبكة")
            ارجع هذا._صيّر_شبكة(عنصر)
        نهاية
        إذا (نوع == "مرن")
            ارجع هذا._صيّر_مرن(عنصر)
        نهاية
        إذا (نوع == "مركز")
            ارجع هذا._صيّر_مركز(عنصر)
        نهاية
        إذا (نوع == "حشوة")
            ارجع هذا._صيّر_حشوة(عنصر)
        نهاية
        إذا (نوع == "فراغ")
            ارجع هذا._صيّر_فراغ(عنصر)
        نهاية

        # البطاقات والأسطح
        إذا (نوع == "بطاقة")
            ارجع هذا._صيّر_بطاقة(عنصر)
        نهاية
        إذا (نوع == "سطح")
            ارجع هذا._صيّر_سطح(عنصر)
        نهاية

        # حقول الإدخال
        إذا (نوع == "إدخال")
            ارجع هذا._صيّر_إدخال(عنصر)
        نهاية
        إذا (نوع == "منطقة_نص")
            ارجع هذا._صيّر_منطقة_نص(عنصر)
        نهاية
        إذا (نوع == "اختيار")
            ارجع هذا._صيّر_اختيار(عنصر)
        نهاية
        إذا (نوع == "خانة_اختيار")
            ارجع هذا._صيّر_خانة_اختيار(عنصر)
        نهاية
        إذا (نوع == "زر_راديو")
            ارجع هذا._صيّر_زر_راديو(عنصر)
        نهاية
        إذا (نوع == "منزلقة")
            ارجع هذا._صيّر_منزلقة(عنصر)
        نهاية
        إذا (نوع == "مبدّل")
            ارجع هذا._صيّر_مبدّل(عنصر)
        نهاية

        # الوسائط
        إذا (نوع == "صورة")
            ارجع هذا._صيّر_صورة(عنصر)
        نهاية
        إذا (نوع == "أيقونة")
            ارجع هذا._صيّر_أيقونة(عنصر)
        نهاية
        إذا (نوع == "فيديو")
            ارجع هذا._صيّر_فيديو(عنصر)
        نهاية
        إذا (نوع == "صوت")
            ارجع هذا._صيّر_صوت(عنصر)
        نهاية

        # القوائم والجداول
        إذا (نوع == "قائمة")
            ارجع هذا._صيّر_قائمة(عنصر)
        نهاية
        إذا (نوع == "جدول")
            ارجع هذا._صيّر_جدول(عنصر)
        نهاية
        إذا (نوع == "عنصر_قائمة")
            ارجع هذا._صيّر_عنصر_قائمة(عنصر)
        نهاية

        # التنقل
        إذا (نوع == "شريط_تنقل")
            ارجع هذا._صيّر_شريط_تنقل(عنصر)
        نهاية
        إذا (نوع == "قائمة_جانبية")
            ارجع هذا._صيّر_قائمة_جانبية(عنصر)
        نهاية
        إذا (نوع == "تبويبات")
            ارجع هذا._صيّر_تبويبات(عنصر)
        نهاية
        إذا (نوع == "تذييل")
            ارجع هذا._صيّر_تذييل(عنصر)
        نهاية
        إذا (نوع == "فتات_خبز")
            ارجع هذا._صيّر_فتات_خبز(عنصر)
        نهاية

        # التنبيهات والإشعارات
        إذا (نوع == "تنبيه")
            ارجع هذا._صيّر_تنبيه(عنصر)
        نهاية
        إذا (نوع == "شارة")
            ارجع هذا._صيّر_شارة(عنصر)
        نهاية
        إذا (نوع == "تلميح")
            ارجع هذا._صيّر_تلميح(عنصر)
        نهاية
        إذا (نوع == "إشعار_منبثق")
            ارجع هذا._صيّر_إشعار_منبثق(عنصر)
        نهاية

        # العناصر التفاعلية
        إذا (نوع == "مودال")
            ارجع هذا._صيّر_مودال(عنصر)
        نهاية
        إذا (نوع == "حوار")
            ارجع هذا._صيّر_حوار(عنصر)
        نهاية
        إذا (نوع == "منسدلة")
            ارجع هذا._صيّر_منسدلة(عنصر)
        نهاية
        إذا (نوع == "أكورديون")
            ارجع هذا._صيّر_أكورديون(عنصر)
        نهاية

        # مؤشرات التقدم والتحميل
        إذا (نوع == "شريط_تقدم")
            ارجع هذا._صيّر_شريط_تقدم(عنصر)
        نهاية
        إذا (نوع == "دائرة_تقدم")
            ارجع هذا._صيّر_دائرة_تقدم(عنصر)
        نهاية
        إذا (نوع == "محمّل")
            ارجع هذا._صيّر_محمّل(عنصر)
        نهاية
        إذا (نوع == "هيكل_تحميل")
            ارجع هذا._صيّر_هيكل_تحميل(عنصر)
        نهاية

        # النماذج
        إذا (نوع == "نموذج")
            ارجع هذا._صيّر_نموذج(عنصر)
        نهاية
        إذا (نوع == "حقل_نموذج")
            ارجع هذا._صيّر_حقل_نموذج(عنصر)
        نهاية

        # الصور الرمزية والملفات الشخصية
        إذا (نوع == "صورة_رمزية")
            ارجع هذا._صيّر_صورة_رمزية(عنصر)
        نهاية
        إذا (نوع == "رقاقة")
            ارجع هذا._صيّر_رقاقة(عنصر)
        نهاية

        # الفواصل
        إذا (نوع == "فاصل")
            ارجع هذا._صيّر_فاصل(عنصر)
        نهاية

        # عنصر غير معروف — عرض كحاوية
        ارجع هذا._صيّر_عام(عنصر)
    نهاية

    # ═══════════════════════════════════════════════════════════════
    #  دوال تصيير الأنواع — Element renderers
    # ═══════════════════════════════════════════════════════════════

    # ─── النصوص والعناوين ───

    دالة _صيّر_نص(عنصر)
        متغير ع = جديد عنصر_ويب("span")
        متغير خ = عنصر["_خصائص"]
        إذا (خ != لاشيء)
            إذا (خ["قيمة"] != لاشيء)
                ع.عيّن_نص(خ["قيمة"])
            نهاية
            إذا (خ["حجم"] != لاشيء)
                ع.عيّن_نمط("font-size", خ["حجم"] + "px")
            نهاية
            إذا (خ["لون"] != لاشيء)
                ع.عيّن_نمط("color", خ["لون"])
            نهاية
            إذا (خ["سُمك"] != لاشيء)
                ع.عيّن_نمط("font-weight", خ["سُمك"])
            نهاية
            إذا (خ["خط"] != لاشيء)
                ع.عيّن_نمط("font-family", خ["خط"])
            نهاية
            إذا (خ["تسطير"] == صحيح)
                ع.عيّن_نمط("text-decoration", "underline")
            نهاية
            إذا (خ["مائل"] == صحيح)
                ع.عيّن_نمط("font-style", "italic")
            نهاية
        نهاية
        ارجع ع
    نهاية

    دالة _صيّر_عنوان(عنصر)
        متغير خ = عنصر["_خصائص"]
        متغير مستوى = 1
        إذا (خ != لاشيء و خ["مستوى"] != لاشيء)
            مستوى = خ["مستوى"]
        نهاية
        متغير وسم = "h" + مستوى
        متغير ع = جديد عنصر_ويب(وسم)
        إذا (خ != لاشيء)
            إذا (خ["نص"] != لاشيء)
                ع.عيّن_نص(خ["نص"])
            نهاية
            إذا (خ["لون"] != لاشيء)
                ع.عيّن_نمط("color", خ["لون"])
            نهاية
        نهاية
        ع.عيّن_نمط("margin", "0.5em 0")
        ارجع ع
    نهاية

    دالة _صيّر_فقرة(عنصر)
        متغير ع = جديد عنصر_ويب("p")
        متغير خ = عنصر["_خصائص"]
        إذا (خ != لاشيء)
            إذا (خ["نص"] != لاشيء)
                ع.عيّن_نص(خ["نص"])
            نهاية
            إذا (خ["محاذاة"] != لاشيء)
                ع.عيّن_نمط("text-align", خ["محاذاة"])
            نهاية
        نهاية
        ع.عيّن_نمط("line-height", "1.6")
        ع.عيّن_نمط("margin", "0.5em 0")
        ارجع ع
    نهاية

    # ─── الأزرار والروابط ───

    دالة _صيّر_زر(عنصر)
        متغير ع = جديد عنصر_ويب("button")
        ع.عيّن_خاصية("id", هذا._معرف_جديد())
        ع.عيّن_نمط("padding", "10px 20px")
        ع.عيّن_نمط("border-radius", "var(--radius-sm)")
        ع.عيّن_نمط("cursor", "pointer")
        ع.عيّن_نمط("border", "none")
        ع.عيّن_نمط("font-size", "inherit")
        ع.عيّن_نمط("transition", "all 0.2s ease")
        ع.عيّن_نمط("background-color", "var(--color-primary)")
        ع.عيّن_نمط("color", "white")
        
        متغير خ = عنصر["_خصائص"]
        إذا (خ != لاشيء)
            إذا (خ["نص"] != لاشيء)
                ع.عيّن_نص(خ["نص"])
            نهاية
            إذا (خ["لون"] != لاشيء)
                ع.عيّن_نمط("background-color", خ["لون"])
            نهاية
            إذا (خ["نوع"] == "مخطط")
                ع.عيّن_نمط("background", "transparent")
                ع.عيّن_نمط("border", "2px solid var(--color-primary)")
                ع.عيّن_نمط("color", "var(--color-primary)")
            نهاية
            إذا (خ["نوع"] == "نصي")
                ع.عيّن_نمط("background", "transparent")
                ع.عيّن_نمط("color", "var(--color-primary)")
            نهاية
            إذا (خ["معطّل"] == صحيح)
                ع.عيّن_خاصية("disabled", "disabled")
                ع.عيّن_نمط("opacity", "0.5")
                ع.عيّن_نمط("cursor", "not-allowed")
            نهاية
            إذا (خ["كامل_العرض"] == صحيح)
                ع.عيّن_نمط("width", "100%")
            نهاية
        نهاية
        هذا._ربط_أحداث(عنصر, ع)
        ارجع ع
    نهاية

    دالة _صيّر_رابط(عنصر)
        متغير ع = جديد عنصر_ويب("a")
        متغير خ = عنصر["_خصائص"]
        إذا (خ != لاشيء)
            إذا (خ["نص"] != لاشيء)
                ع.عيّن_نص(خ["نص"])
            نهاية
            إذا (خ["رابط"] != لاشيء)
                ع.عيّن_خاصية("href", خ["رابط"])
            نهاية
            إذا (خ["هدف"] != لاشيء)
                ع.عيّن_خاصية("target", خ["هدف"])
