# ─── قواص مُعدّة مسبقاً ───
صدّر صنف قاص_دائري يرث قاص_مخصص
    باني()
        الأساس()
    نهاية

    دالة احصل_على_القص(حجم)
        متغير مسار_جديد = جديد مسار()
        متغير نصف_قطر = (حجم["عرض"] < حجم["ارتفاع"]) ? حجم["عرض"] / 2 : حجم["ارتفاع"] / 2
        مسار_جديد.أضف_دائرة(حجم["عرض"] / 2، حجم["ارتفاع"] / 2، نصف_قطر)
        ارجع مسار_جديد
    نهاية
نهاية

صدّر صنف قاص_موجة يرث قاص_مخصص
    باني(عدد_الموجات = 4، ارتفاع_الموجة = 20)
        الأساس()
        هذا._عدد = عدد_الموجات
        هذا._ارتفاع = ارتفاع_الموجة
    نهاية

    دالة احصل_على_القص(حجم)
        متغير مسار_جديد = جديد مسار()
        متغير عرض_موجة = حجم["عرض"] / هذا._عدد
        
        مسار_جديد.انتقل_إلى(0، 0)
        
        لكل ف من 0 الى هذا._عدد
            متغير س1 = ف * عرض_موجة + عرض_موجة / 4
            متغير س2 = ف * عرض_موجة + عرض_موجة * 3 / 4
            متغير س3 = (ف + 1) * عرض_موجة
            
            مسار_جديد.قوس_بيزير_تكعيبي(
                س1، هذا._ارتفاع،
                س2، -هذا._ارتفاع،
                س3، 0
            )
        نهاية
        
        مسار_جديد.خط_إلى(حجم["عرض"]، حجم["ارتفاع"])
        مسار_جديد.خط_إلى(0، حجم["ارتفاع"])
        مسار_جديد.أغلق()
        
        ارجع مسار_جديد
    نهاية
نهاية

صدّر صنف قاص_مثلث يرث قاص_مخصص
    باني()
        الأساس()
    نهاية

    دالة احصل_على_القص(حجم)
        متغير مسار_جديد = جديد مسار()
        مسار_جديد.انتقل_إلى(حجم["عرض"] / 2، 0)
        مسار_جديد.خط_إلى(حجم["عرض"]، حجم["ارتفاع"])
        مسار_جديد.خط_إلى(0، حجم["ارتفاع"])
        مسار_جديد.أغلق()
        ارجع مسار_جديد
    نهاية
نهاية

