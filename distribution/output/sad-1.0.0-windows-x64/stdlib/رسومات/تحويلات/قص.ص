# ─── أنصاف أقطار الحدود ───
صدّر صنف نصف_قطر_حدود
    باني(أعلى_يسار = 0، أعلى_يمين = 0، أسفل_يمين = 0، أسفل_يسار = 0)
        هذا.أعلى_يسار = أعلى_يسار
        هذا.أعلى_يمين = أعلى_يمين
        هذا.أسفل_يمين = أسفل_يمين
        هذا.أسفل_يسار = أسفل_يسار
    نهاية

    ساكن دالة كل(نصف_قطر)
        ارجع جديد نصف_قطر_حدود(نصف_قطر، نصف_قطر، نصف_قطر، نصف_قطر)
    نهاية

    ساكن دالة أفقي(أعلى = 0، أسفل = 0)
        ارجع جديد نصف_قطر_حدود(أعلى، أعلى، أسفل، أسفل)
    نهاية

    ساكن دالة عمودي(يسار = 0، يمين = 0)
        ارجع جديد نصف_قطر_حدود(يسار، يمين، يمين، يسار)
    نهاية

    ساكن دالة فقط(أعلى_يسار = 0، أعلى_يمين = 0، أسفل_يمين = 0، أسفل_يسار = 0)
        ارجع جديد نصف_قطر_حدود(أعلى_يسار، أعلى_يمين، أسفل_يمين، أسفل_يسار)
    نهاية

    ساكن دالة صفر()
        ارجع جديد نصف_قطر_حدود(0، 0، 0، 0)
    نهاية
نهاية

# ─── المسار (Path) ───
صدّر صنف مسار
    باني()
        هذا._أوامر = []
        هذا._موضع_س = 0
        هذا._موضع_ص = 0
    نهاية

    # ─── تحريك القلم ───
    دالة انتقل_إلى(س، ص)
        هذا._أوامر.أضف({"نوع": "انتقال"، "س": س، "ص": ص})
        هذا._موضع_س = س
        هذا._موضع_ص = ص
        ارجع هذا
    نهاية

    دالة خط_إلى(س، ص)
        هذا._أوامر.أضف({"نوع": "خط"، "س": س، "ص": ص})
        هذا._موضع_س = س
        هذا._موضع_ص = ص
        ارجع هذا
    نهاية

    # ─── الأقواس ───
    دالة قوس_إلى(س1، ص1، س2، ص2، نصف_قطر)
        هذا._أوامر.أضف({
            "نوع": "قوس"،
            "س1": س1، "ص1": ص1،
            "س2": س2، "ص2": ص2،
            "نصف_قطر": نصف_قطر
        })
        هذا._موضع_س = س2
        هذا._موضع_ص = ص2
        ارجع هذا
    نهاية

    دالة قوس_بيزير_تربيعي(س1، ص1، س2، ص2)
        هذا._أوامر.أضف({
            "نوع": "بيزير_تربيعي"،
            "تحكم_س": س1، "تحكم_ص": ص1،
            "س": س2، "ص": ص2
        })
        هذا._موضع_س = س2
        هذا._موضع_ص = ص2
        ارجع هذا
    نهاية

    دالة قوس_بيزير_تكعيبي(س1، ص1، س2، ص2، س3، ص3)
        هذا._أوامر.أضف({
            "نوع": "بيزير_تكعيبي"،
            "تحكم1_س": س1، "تحكم1_ص": ص1،
            "تحكم2_س": س2، "تحكم2_ص": ص2،
            "س": س3، "ص": ص3
        })
        هذا._موضع_س = س3
        هذا._موضع_ص = ص3
        ارجع هذا
    نهاية

    # ─── الأشكال ───
    دالة أضف_مستطيل(س، ص، عرض، ارتفاع)
        هذا.انتقل_إلى(س، ص)
        هذا.خط_إلى(س + عرض، ص)
        هذا.خط_إلى(س + عرض، ص + ارتفاع)
        هذا.خط_إلى(س، ص + ارتفاع)
        هذا.أغلق()
        ارجع هذا
    نهاية

    دالة أضف_مستطيل_مدور(س، ص، عرض، ارتفاع، نصف_قطر)
        هذا._أوامر.أضف({
            "نوع": "مستطيل_مدور"،
            "س": س، "ص": ص،
            "عرض": عرض، "ارتفاع": ارتفاع،
            "نصف_قطر": نصف_قطر
        })
        ارجع هذا
    نهاية

    دالة أضف_بيضاوي(س، ص، عرض، ارتفاع)
        هذا._أوامر.أضف({
            "نوع": "بيضاوي"،
            "س": س، "ص": ص،
            "عرض": عرض، "ارتفاع": ارتفاع
        })
        ارجع هذا
    نهاية

    دالة أضف_دائرة(مركز_س، مركز_ص، نصف_قطر)
        هذا.أضف_بيضاوي(
            مركز_س - نصف_قطر،
            مركز_ص - نصف_قطر،
            نصف_قطر * 2،
            نصف_قطر * 2
        )
        ارجع هذا
    نهاية

    دالة أضف_مضلع(نقاط)
        إذا (نقاط.الطول() < 3)
            ارجع هذا
        نهاية
        
        هذا.انتقل_إلى(نقاط[0]["س"]، نقاط[0]["ص"])
        لكل ف من 1 الى نقاط.الطول()
            هذا.خط_إلى(نقاط[ف]["س"]، نقاط[ف]["ص"])
        نهاية
        هذا.أغلق()
        ارجع هذا
    نهاية

    # ─── إغلاق وعمليات أخرى ───
    دالة أغلق()
        هذا._أوامر.أضف({"نوع": "إغلاق"})
        ارجع هذا
    نهاية

    دالة أعد_التعيين()
        هذا._أوامر = []
        هذا._موضع_س = 0
        هذا._موضع_ص = 0
        ارجع هذا
    نهاية

    # ─── عمليات البوليان ───
    دالة ادمج(مسار_آخر، عملية)
        هذا._أوامر.أضف({
            "نوع": "دمج"،
            "مسار": مسار_آخر،
            "عملية": عملية
        })
        ارجع هذا
    نهاية

    # ─── الاستعلامات ───
    دالة يحتوي(س، ص)
        # تحقق ما إذا كانت النقطة داخل المسار
        ارجع _يحتوي_مسار(هذا._أوامر، س، ص)
    نهاية

    دالة الحدود()
        # حساب المستطيل المحيط
        ارجع _حدود_مسار(هذا._أوامر)
    نهاية

    دالة الأوامر()
        ارجع هذا._أوامر
    نهاية
نهاية

