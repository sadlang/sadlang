# ─── حوار_مادة (Dialog — M3) ───
صدّر صنف حوار_مادة يرث عنصر
    باني(ابن = لاشيء)
        هذا._نوع = "حوار_مادة"
        هذا._خصائص = {}
        هذا._ابن = ابن
        هذا._خصائص["قابل_إغلاق"] = صحيح
        هذا._خصائص["ملء_الشاشة"] = خطأ
    نهاية

    دالة ملء_الشاشة()
        هذا._خصائص["ملء_الشاشة"] = صحيح
        ارجع هذا
    نهاية
نهاية

