# ─── شريط_تطبيق (AppBar) ─── [عنصر جديد 7]
صدّر صنف شريط_تطبيق يرث عنصر
    باني(عنوان = لاشيء, أفعال = [], بادئة = لاشيء, لون_خلفية = لاشيء, ارتفاع = لاشيء, توسيط_العنوان = خطأ, ظل = لاشيء, شكل = لاشيء, نمط_تمرير = لاشيء)
        هذا._نوع = "شريط_تطبيق"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["أفعال"] = أفعال
        هذا._خصائص["بادئة"] = بادئة
        هذا._خصائص["لون_خلفية"] = لون_خلفية
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["توسيط_العنوان"] = توسيط_العنوان
        هذا._خصائص["ظل"] = ظل
        هذا._خصائص["شكل"] = شكل
        هذا._خصائص["نمط_تمرير"] = نمط_تمرير
    نهاية

    دالة عيّن_العنوان(عنوان)
        هذا._خصائص["عنوان"] = عنوان
        ارجع هذا
    نهاية

    دالة عيّن_الأفعال(أفعال)
        هذا._خصائص["أفعال"] = أفعال
        ارجع هذا
    نهاية

    دالة عيّن_البادئة(بادئة)
        هذا._خصائص["بادئة"] = بادئة
        ارجع هذا
    نهاية
نهاية

