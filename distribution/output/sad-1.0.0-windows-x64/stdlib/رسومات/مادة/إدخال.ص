# ===================================================================
# Material Design — حقول الإدخال
# ===================================================================
# TextField, SearchBar, Autocomplete — Material Design 3
# مطابق لـ flutter/material/text_field.dart + search_anchor.dart
#
# الاستخدام:
#   استورد * من رسومات.مادة.إدخال
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── حقل_نص_مادة (TextField — M3) ───
صدّر صنف حقل_نص_مادة يرث عنصر
    باني(تسمية = لاشيء, تلميح = لاشيء, عند_التغيير = لاشيء)
        هذا._نوع = "حقل_نص_مادة"
        هذا._خصائص = {}
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["تلميح"] = تلميح
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["نوع"] = "معبأ"
        هذا._خصائص["بادئة"] = لاشيء
        هذا._خصائص["لاحقة"] = لاشيء
        هذا._خصائص["نص_مساعد"] = لاشيء
        هذا._خصائص["نص_خطأ"] = لاشيء
        هذا._خصائص["عداد"] = لاشيء
        هذا._خصائص["أقصى_طول"] = لاشيء
        هذا._خصائص["غامض"] = خطأ
        هذا._خصائص["قراءة_فقط"] = خطأ
        هذا._خصائص["أسطر_قصوى"] = 1
    نهاية

    دالة محدد()
        هذا._خصائص["نوع"] = "محدد"
        ارجع هذا
    نهاية

    دالة غامض()
        هذا._خصائص["غامض"] = صحيح
        ارجع هذا
    نهاية

    دالة مع_بادئة(عنصر)
        هذا._خصائص["بادئة"] = عنصر
        ارجع هذا
    نهاية

    دالة مع_لاحقة(عنصر)
        هذا._خصائص["لاحقة"] = عنصر
        ارجع هذا
    نهاية

    دالة مع_خطأ(نص)
        هذا._خصائص["نص_خطأ"] = نص
        ارجع هذا
    نهاية

    دالة متعدد_الأسطر(عدد)
        هذا._خصائص["أسطر_قصوى"] = عدد
        ارجع هذا
    نهاية
نهاية

