# ─── الإدخال المزخرف (InputDecoration) ───
صدّر صنف زخرفة_إدخال
    باني()
        هذا.تسمية = لاشيء
        هذا.تلميح = لاشيء
        هذا.نص_مساعد = لاشيء
        هذا.نص_خطأ = لاشيء
        هذا.بادئة = لاشيء
        هذا.لاحقة = لاشيء
        هذا.عداد = لاشيء
        هذا.حد = لاشيء
        هذا.معبأ = صحيح
    نهاية

    دالة مع_تسمية(نص)
        هذا.تسمية = نص
        ارجع هذا
    نهاية

    دالة مع_تلميح(نص)
        هذا.تلميح = نص
        ارجع هذا
    نهاية

    دالة مع_خطأ(نص)
        هذا.نص_خطأ = نص
        ارجع هذا
    نهاية

    دالة محدد()
        هذا.معبأ = خطأ
        ارجع هذا
    نهاية
نهاية
