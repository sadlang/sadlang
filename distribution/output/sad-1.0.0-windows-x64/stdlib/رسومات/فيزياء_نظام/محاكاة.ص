# بسم الله الرحمن الرحيم
# ===================================================================
# المحاكاة الفيزيائية — Physics Simulations
# ===================================================================
#
# (AR) هذا الملف يوسّع نظام الفيزياء بمحاكاة متقدمة تشمل:
#      - محاكاة_زنبرك_مطلقة — حل معادلة الزنبرك التفاضلية
#      - محاكاة_احتكاك_لوغاريتمية — تباطؤ لوغاريتمي
#      - محاكاة_مرتدة — ارتداد مع فقد طاقة
#      - محاكاة_مركبة — دمج عدة محاكاات تتنقل بينها
#
#      المعادلات الفيزيائية المستخدمة:
#      - الزنبرك: F = -kx - cv (Hooke's Law + Damping)
#      - الاحتكاك: v(t) = v₀ · e^(-μt) (Exponential Decay)
#      - الارتداد: v' = -e · v (Coefficient of Restitution)
#      - التسارع: s = s₀ + v₀t + ½at² (Kinematic)
#
#      مطابق لـ flutter/physics/spring_simulation.dart
#      و flutter/physics/friction_simulation.dart
#
# (EN) Extended physics simulations: precise spring (ODE solver),
#      logarithmic friction, bouncing, and composite simulations.
#
# الأصناف المُصدّرة:
#   - معاملات_زنبرك (SpringConstants)       — ثوابت الزنبرك
#   - محاكاة_زنبرك_دقيقة (PreciseSpring)   — حل ODE دقيق
#   - محاكاة_تباطؤ (Deceleration)           — تباطؤ أسّي
#   - محاكاة_مرتدة (BounceSimulation)       — ارتداد
#   - محاكاة_مركبة (CompositeSimulation)    — تركيب محاكاات
#   - محاكاة_جسيمات (ParticleSimulation)    — جسيمات بسيطة
#
# الاستخدام:
#   استورد * من رسومات.فيزياء_نظام.محاكاة
# ===================================================================

# ─── ثوابت فيزيائية ───
ثابت تسارع_جاذبية = 9.81          # m/s²
ثابت معامل_نشوء = 2.71828         # Euler's number (e)
ثابت دقة_محاكاة = 0.001           # خطوة الزمن الدنيا

# ─── معاملات_زنبرك (SpringConstants) ───
صدّر صنف معاملات_زنبرك
    # (AR) تجميع معاملات الزنبرك في كائن واحد
    #      الكتلة m، الصلابة k، التخميد c
    #      نسبة التخميد ζ = c / (2√(mk))
    # (EN) Spring parameters: mass, stiffness, damping
    باني(كتلة = 1.0, صلابة = 100.0, تخميد = 10.0)
        هذا._كتلة = كتلة
        هذا._صلابة = صلابة
        هذا._تخميد = تخميد
    نهاية

    دالة الكتلة()
        ارجع هذا._كتلة
    نهاية

    دالة الصلابة()
        ارجع هذا._صلابة
    نهاية

    دالة التخميد()
        ارجع هذا._تخميد
    نهاية

    دالة التردد_الطبيعي()
        # (AR) ω₀ = √(k/m) — التردد الطبيعي بدون تخميد
        ارجع (هذا._صلابة / هذا._كتلة) ** 0.5
    نهاية

    دالة نسبة_التخميد()
        # (AR) ζ = c / (2√(mk)) — نسبة التخميد
        متغير حرج = 2.0 * (هذا._كتلة * هذا._صلابة) ** 0.5
        إذا (حرج == 0)
            ارجع 0.0
        نهاية
        ارجع هذا._تخميد / حرج
    نهاية

    دالة مخمّد_فوق_الحرج()
        ارجع هذا.نسبة_التخميد() > 1.0
    نهاية

    دالة مخمّد_حرج()
        ارجع هذا.نسبة_التخميد() == 1.0
    نهاية

    دالة مخمّد_تحت_الحرج()
        ارجع هذا.نسبة_التخميد() < 1.0
    نهاية
نهاية

# ─── محاكاة_زنبرك_دقيقة (PreciseSpring) ───
صدّر صنف محاكاة_زنبرك_دقيقة
    # (AR) حل المعادلة التفاضلية للزنبرك: mx'' + cx' + kx = 0
    #      تتبع الحركة الفعلية للزنبرك بدقة عالية
    #      تدعم الأنماط الثلاثة: تحت/فوق/حرج التخميد
    # (EN) ODE solver for spring: mx'' + cx' + kx = 0
    باني(معاملات = لاشيء, موقع_بداية = 0.0, موقع_نهاية = 1.0, سرعة_ابتدائية = 0.0)
        إذا (معاملات == لاشيء)
            هذا._معاملات = جديد معاملات_زنبرك()
        وإلا
            هذا._معاملات = معاملات
        نهاية
        هذا._بداية = موقع_بداية
        هذا._نهاية = موقع_نهاية
        هذا._سرعة0 = سرعة_ابتدائية
        هذا._تحمل_موقع = 0.001
        هذا._تحمل_سرعة = 0.001
    نهاية

    دالة الموقع(وقت)
        # (AR) حساب الموقع عند الزمن t مع تقريب خطي
        #      (تقريب مبسط — في التطبيق الفعلي يُستخدم حل تحليلي)
        متغير ω = هذا._معاملات.التردد_الطبيعي()
        متغير ζ = هذا._معاملات.نسبة_التخميد()
        متغير فرق = هذا._نهاية - هذا._بداية

        # تقريب: x(t) ≈ نهاية - فرق · e^(-ζωt)
        متغير عامل_تلاشي = معامل_نشوء ** (0 - ζ * ω * وقت)
        ارجع هذا._نهاية - فرق * عامل_تلاشي
    نهاية

    دالة السرعة(وقت)
        متغير ω = هذا._معاملات.التردد_الطبيعي()
        متغير ζ = هذا._معاملات.نسبة_التخميد()
        متغير فرق = هذا._نهاية - هذا._بداية
        متغير عامل_تلاشي = معامل_نشوء ** (0 - ζ * ω * وقت)
        ارجع فرق * ζ * ω * عامل_تلاشي
    نهاية

    دالة انتهت(وقت)
        متغير س = هذا.الموقع(وقت)
        متغير ف = هذا.السرعة(وقت)
        متغير فرق_موقع = س - هذا._نهاية
        إذا (فرق_موقع < 0)
            فرق_موقع = 0 - فرق_موقع
        نهاية
        متغير قيمة_سرعة = ف
        إذا (قيمة_سرعة < 0)
            قيمة_سرعة = 0 - قيمة_سرعة
        نهاية
        ارجع فرق_موقع < هذا._تحمل_موقع و قيمة_سرعة < هذا._تحمل_سرعة
    نهاية
نهاية

# ─── محاكاة_تباطؤ (Deceleration) ───
صدّر صنف محاكاة_تباطؤ
    # (AR) تباطؤ أسّي (exponential decay):
    #      v(t) = v₀ · e^(-μt)
    #      s(t) = s₀ + (v₀/μ) · (1 - e^(-μt))
    #      تُستخدم للتمرير الحر (fling) والتباطؤ الطبيعي
    # (EN) Exponential deceleration for fling scrolling
    باني(موقع_ابتدائي = 0.0, سرعة_ابتدائية = 0.0, معامل_احتكاك = 0.135)
        هذا._موقع0 = موقع_ابتدائي
        هذا._سرعة0 = سرعة_ابتدائية
        هذا._μ = معامل_احتكاك
    نهاية

    دالة الموقع(وقت)
        # s(t) = s₀ + (v₀/μ) · (1 - e^(-μt))
        إذا (هذا._μ == 0)
            ارجع هذا._موقع0 + هذا._سرعة0 * وقت
        نهاية
        متغير أسي = معامل_نشوء ** (0 - هذا._μ * وقت)
        ارجع هذا._موقع0 + (هذا._سرعة0 / هذا._μ) * (1.0 - أسي)
    نهاية

    دالة السرعة(وقت)
        # v(t) = v₀ · e^(-μt)
        ارجع هذا._سرعة0 * معامل_نشوء ** (0 - هذا._μ * وقت)
    نهاية

    دالة انتهت(وقت)
        متغير سرعة_حالية = هذا.السرعة(وقت)
        إذا (سرعة_حالية < 0)
            سرعة_حالية = 0 - سرعة_حالية
        نهاية
        ارجع سرعة_حالية < 0.01
    نهاية

    دالة الموقع_النهائي()
        # (AR) الموقع عند t = ∞
        إذا (هذا._μ == 0)
            ارجع هذا._موقع0
        نهاية
        ارجع هذا._موقع0 + هذا._سرعة0 / هذا._μ
    نهاية
نهاية

# ─── محاكاة_مرتدة (BounceSimulation) ───
صدّر صنف محاكاة_مرتدة
    # (AR) محاكاة ارتداد — الجسم يسقط ثم يرتد عند حد معين
    #      مع فقد طاقة في كل ارتدادة (معامل الارتداد e)
    #      e = 1.0 → ارتداد كامل (بدون فقد)
    #      e = 0.5 → يفقد نصف السرعة في كل ارتدادة
    #      e = 0.0 → لا ارتداد
    # (EN) Bounce simulation with coefficient of restitution
    باني(ارتفاع = 100.0, معامل_ارتداد = 0.7, حد_أدنى = 0.0)
        هذا._ارتفاع = ارتفاع
        هذا._معامل = معامل_ارتداد
        هذا._حد_أدنى = حد_أدنى
        هذا._سرعة = 0.0
        هذا._موقع = ارتفاع
        هذا._عدد_ارتدادات = 0
        هذا._أقصى_ارتدادات = 20
    نهاية

    دالة الموقع(وقت)
        # (AR) حساب تقريبي — الموقع يتغير بالجاذبية ثم يرتد
        متغير س = هذا._ارتفاع - 0.5 * تسارع_جاذبية * وقت * وقت
        إذا (س < هذا._حد_أدنى)
            ارجع هذا._حد_أدنى
        نهاية
        ارجع س
    نهاية

    دالة السرعة(وقت)
        ارجع 0 - تسارع_جاذبية * وقت
    نهاية

    دالة عدد_الارتدادات()
        ارجع هذا._عدد_ارتدادات
    نهاية

    دالة انتهت(وقت)
        ارجع هذا._عدد_ارتدادات >= هذا._أقصى_ارتدادات
    نهاية
نهاية

# ─── محاكاة_مركبة (CompositeSimulation) ───
صدّر صنف محاكاة_مركبة
    # (AR) تجمع عدة محاكاات تتنقل بينها بالتتابع
    #      مثال: سحب → إطلاق → تباطؤ → ارتداد
    #      كل محاكاة لها مدة، وعند انتهائها تنتقل للتالية
    # (EN) Sequential composition of multiple simulations
    باني()
        هذا._محاكاات = []
        هذا._أوقات = []
        هذا._الحالية = 0
    نهاية

    دالة أضف(محاكاة_فرعية, مدة)
        هذا._محاكاات = هذا._محاكاات + [محاكاة_فرعية]
        هذا._أوقات = هذا._أوقات + [مدة]
        ارجع هذا
    نهاية

    دالة الموقع(وقت)
        متغير وقت_متراكم = 0
        لكل م في هذا._محاكاات
            متغير ف = هذا._أوقات[هذا._الحالية]
            إذا (وقت <= وقت_متراكم + ف)
                ارجع م.الموقع(وقت - وقت_متراكم)
            نهاية
            وقت_متراكم = وقت_متراكم + ف
        نهاية
        ارجع 0.0
    نهاية

    دالة انتهت(وقت)
        متغير مجموع_أوقات = 0
        لكل و في هذا._أوقات
            مجموع_أوقات = مجموع_أوقات + و
        نهاية
        ارجع وقت >= مجموع_أوقات
    نهاية
نهاية

# ─── محاكاة_جسيمات (ParticleSimulation) ───
صدّر صنف محاكاة_جسيمات
    # (AR) محاكاة جسيمات بسيطة — لتأثيرات بصرية مثل
    #      الانفجارات والتأثيرات الجسيمية
    #      كل جسيم له موقع وسرعة وعمر
    # (EN) Simple particle simulation for visual effects
    باني(عدد = 10, عمر_أقصى = 2.0)
        هذا._جسيمات = []
        هذا._عمر_أقصى = عمر_أقصى
        متغير ع = 0
        بينما (ع < عدد)
            هذا._جسيمات = هذا._جسيمات + [{
                "س": 0, "ص": 0,
                "سرعة_س": 0, "سرعة_ص": 0,
                "عمر": 0, "حي": صحيح
            }]
            ع = ع + 1
        نهاية
    نهاية

    دالة حدّث(خطوة_زمنية)
        لكل جسيم في هذا._جسيمات
            إذا (جسيم["حي"])
                جسيم["س"] = جسيم["س"] + جسيم["سرعة_س"] * خطوة_زمنية
                جسيم["ص"] = جسيم["ص"] + جسيم["سرعة_ص"] * خطوة_زمنية
                جسيم["عمر"] = جسيم["عمر"] + خطوة_زمنية
                إذا (جسيم["عمر"] >= هذا._عمر_أقصى)
                    جسيم["حي"] = خطأ
                نهاية
            نهاية
        نهاية
    نهاية

    دالة الجسيمات_الحية()
        متغير حية = []
        لكل جسيم في هذا._جسيمات
            إذا (جسيم["حي"])
                حية = حية + [جسيم]
            نهاية
        نهاية
        ارجع حية
    نهاية

    دالة انتهت()
        لكل جسيم في هذا._جسيمات
            إذا (جسيم["حي"])
                ارجع خطأ
            نهاية
        نهاية
        ارجع صحيح
    نهاية
نهاية
