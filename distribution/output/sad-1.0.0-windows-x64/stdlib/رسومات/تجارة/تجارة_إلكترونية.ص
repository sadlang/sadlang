صدّر صنف منتج
    باني(إعدادات)
        هذا.معرف = إعدادات.معرف أو ""
        هذا.اسم = إعدادات.اسم أو ""
        هذا.وصف = إعدادات.وصف أو ""
        هذا.سعر = إعدادات.سعر أو 0
        هذا.سعر_قديم = إعدادات.سعر_قديم أو لاشيء
        هذا.صور = إعدادات.صور أو []
        هذا.فئة = إعدادات.فئة أو ""
        هذا.تقييم = إعدادات.تقييم أو 0
        هذا.عدد_تقييمات = إعدادات.عدد_تقييمات أو 0
        هذا.متوفر = إعدادات.متوفر أو صحيح
        هذا.خيارات = إعدادات.خيارات أو {}  # {لون: [], حجم: []}
    نهاية

    دالة نسبة_خصم()
        إذا (هذا.سعر_قديم و هذا.سعر_قديم > هذا.سعر)
            ارجع ((هذا.سعر_قديم - هذا.سعر) / هذا.سعر_قديم) * 100
        نهاية
        ارجع 0
    نهاية
نهاية

