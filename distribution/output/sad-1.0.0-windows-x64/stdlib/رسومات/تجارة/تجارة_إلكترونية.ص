صدّر صنف طلب
    باني(إعدادات)
        هذا.معرف = إعدادات.معرف أو مولّد_معرف()
        هذا.عناصر = إعدادات.عناصر أو []
        هذا.عنوان = إعدادات.عنوان أو لاشيء
        هذا.طريقة_دفع = إعدادات.طريقة_دفع أو لاشيء
        هذا.رسوم_شحن = إعدادات.رسوم_شحن أو 0
        هذا.ضريبة = إعدادات.ضريبة أو 0
        هذا.خصم = إعدادات.خصم أو 0
        هذا.حالة = إعدادات.حالة أو "جديد"
        هذا.تاريخ = إعدادات.تاريخ أو وقت_الآن()
    نهاية

    دالة إجمالي_منتجات()
        متغير إجمالي = 0
        لكل عنصر في هذا.عناصر
            إجمالي += عنصر.احصل_إجمالي()
        نهاية
        ارجع إجمالي
    نهاية

    دالة الإجمالي_النهائي()
        ارجع هذا.إجمالي_منتجات() + هذا.رسوم_شحن + هذا.ضريبة - هذا.خصم
    نهاية
نهاية

صدّر صنف شاشة_دفع
    باني(إعدادات)
        هذا._خطوات = إعدادات.خطوات أو ["العنوان"، "الشحن"، "الدفع"، "المراجعة"]
        هذا._خطوة_حالية = 0
        هذا._عنوان = لاشيء
        هذا._طريقة_شحن = لاشيء
        هذا._طريقة_دفع = لاشيء
        هذا._عند_اكتمال = إعدادات.عند_اكتمال أو لاشيء
    نهاية

    دالة التالي(بيانات)
        طابق (هذا._خطوة_حالية)
            عندما 0:
                هذا._عنوان = بيانات
            عندما 1:
                هذا._طريقة_شحن = بيانات
            عندما 2:
                هذا._طريقة_دفع = بيانات
            عندما 3:
                هذا._أكمل_طلب()
                ارجع
        نهاية
        
        هذا._خطوة_حالية += 1
    نهاية

    دالة السابق()
        إذا (هذا._خطوة_حالية > 0)
            هذا._خطوة_حالية -= 1
        نهاية
    نهاية

    دالة _أكمل_طلب()
        متغير طلب = جديد طلب({
            عناصر: سلة_تسوق.احصل_مثيل().احصل_عناصر()،
            عنوان: هذا._عنوان،
            طريقة_دفع: هذا._طريقة_دفع
        })
        
        إذا (هذا._عند_اكتمال)
            هذا._عند_اكتمال(طلب)
        نهاية
    نهاية
نهاية

