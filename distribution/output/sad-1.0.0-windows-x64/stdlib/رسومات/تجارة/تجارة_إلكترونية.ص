# العيب #181: ShoppingCart - سلة التسوق
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف عنصر_سلة
    باني(إعدادات)
        هذا._معرف = إعدادات.معرف أو مولّد_معرف()
        هذا._منتج = إعدادات.منتج
        هذا._كمية = إعدادات.كمية أو 1
        هذا._خيارات = إعدادات.خيارات أو {}  # مثل اللون، الحجم
    نهاية

    دالة احصل_إجمالي()
        ارجع هذا._منتج.سعر * هذا._كمية
    نهاية
نهاية

صدّر صنف سلة_تسوق
    ساكن متغير _مثيل = لاشيء
    
    ساكن دالة احصل_مثيل()
        إذا (سلة_تسوق._مثيل == لاشيء)
            سلة_تسوق._مثيل = جديد سلة_تسوق()
        نهاية
        ارجع سلة_تسوق._مثيل
    نهاية

    باني()
        هذا._عناصر = []
        هذا._مستمعون = []
    نهاية

    دالة أضف(منتج، كمية، خيارات)
        # تحقق إذا كان المنتج موجوداً
        متغير موجود = هذا._عناصر.ابحث(لامدا(ع) => ع._منتج.معرف == منتج.معرف نهاية)
        
        إذا (موجود)
            موجود._كمية += كمية أو 1
        وإلا
            هذا._عناصر.أضف(جديد عنصر_سلة({
                منتج: منتج،
                كمية: كمية أو 1،
                خيارات: خيارات
            }))
        نهاية
        
        هذا._أخطر()
    نهاية

    دالة أزل(معرف_عنصر)
        هذا._عناصر = هذا._عناصر.فلتر(لامدا(ع) => ع._معرف != معرف_عنصر نهاية)
        هذا._أخطر()
    نهاية

    دالة حدّث_كمية(معرف_عنصر، كمية)
        متغير عنصر = هذا._عناصر.ابحث(لامدا(ع) => ع._معرف == معرف_عنصر نهاية)
        إذا (عنصر)
            إذا (كمية <= 0)
                هذا.أزل(معرف_عنصر)
            وإلا
                عنصر._كمية = كمية
                هذا._أخطر()
            نهاية
        نهاية
    نهاية

    دالة أفرغ()
        هذا._عناصر = []
        هذا._أخطر()
    نهاية

    دالة احصل_عناصر()
        ارجع هذا._عناصر
    نهاية

    دالة احصل_عدد()
        متغير إجمالي = 0
        لكل عنصر في هذا._عناصر
            إجمالي += عنصر._كمية
        نهاية
        ارجع إجمالي
    نهاية

    دالة احصل_إجمالي()
        متغير إجمالي = 0
        لكل عنصر في هذا._عناصر
            إجمالي += عنصر.احصل_إجمالي()
        نهاية
        ارجع إجمالي
    نهاية

    دالة راقب(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة _أخطر()
        لكل مستمع في هذا._مستمعون
            مستمع(هذا._عناصر)
        نهاية
    نهاية
نهاية

