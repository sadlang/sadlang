# ===================================================================
#                    صنف الحدث الأساسي
# ===================================================================

صدّر صنف حدث
    باني(نوع = 0)
        هذا.نوع = نوع
        هذا.وقت = 0
    نهاية
نهاية

# ===================================================================
#                    حدث لوحة المفاتيح
# ===================================================================

صدّر صنف حدث_مفتاح يرث حدث
    باني(نوع, كود, حرف = "", شيفت = خطأ, كنترول = خطأ, ألت = خطأ)
        هذا.نوع = نوع
        هذا.وقت = 0
        هذا.كود = كود
        هذا.حرف = حرف
        هذا.شيفت = شيفت
        هذا.كنترول = كنترول
        هذا.ألت = ألت
    نهاية
نهاية

# ===================================================================
#                    حدث الفأرة
# ===================================================================

صدّر صنف حدث_فأرة يرث حدث
    باني(نوع, س = 0, ص = 0, زر = 0, تمرير_دلتا = 0)
        هذا.نوع = نوع
        هذا.وقت = 0
        هذا.س = س
        هذا.ص = ص
        هذا.زر = زر
        هذا.تمرير_دلتا = تمرير_دلتا
    نهاية
نهاية

# ===================================================================
#                    طابور الأحداث
# ===================================================================

صدّر صنف طابور_أحداث
    باني()
        هذا._أحداث = []
        هذا._رأس = 0  # فهرس أول عنصر (تحسين الأداء)
    نهاية

    دالة أضف(حدث)
        هذا._أحداث = هذا._أحداث + [حدث]
    نهاية

    دالة التالي()
        إذا (هذا.فارغ())
            ارجع لاشيء
        نهاية
        متغير أول = هذا._أحداث[هذا._رأس]
        هذا._رأس = هذا._رأس + 1
        # إعادة ضبط عند استهلاك كل الأحداث (منع تسرب الذاكرة)
        إذا (هذا._رأس >= هذا._أحداث.طول())
            هذا._أحداث = []
            هذا._رأس = 0
        نهاية
        ارجع أول
    نهاية

    دالة فارغ()
        ارجع هذا._رأس >= هذا._أحداث.طول()
    نهاية

    دالة مسح()
        هذا._أحداث = []
        هذا._رأس = 0
    نهاية

    دالة الحجم()
        ارجع هذا._أحداث.طول() - هذا._رأس
    نهاية

    ## تصفية الأحداث حسب النوع (من الفهرس الحالي فقط)
    دالة تصفية(نوع_مطلوب)
        متغير نتيجة = []
        لكل ف في هذا._رأس..هذا._أحداث.طول() - 1
            إذا (هذا._أحداث[ف].نوع == نوع_مطلوب)
                نتيجة = نتيجة + [هذا._أحداث[ف]]
            نهاية
        نهاية
        ارجع نتيجة
    نهاية

    ## إلقاء نظرة على الحدث التالي بدون إزالته
    دالة الأول()
        إذا (هذا.فارغ())
            ارجع لاشيء
        نهاية
        ارجع هذا._أحداث[هذا._رأس]
    نهاية
نهاية
