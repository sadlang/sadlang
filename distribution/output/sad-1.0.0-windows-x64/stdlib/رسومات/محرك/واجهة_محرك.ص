# بسم الله الرحمن الرحيم
# ===================================================================
# واجهة المحرك — Abstract Rendering Engine
# ===================================================================
#
# (AR) الصنف الأساسي لجميع محركات الرسم. يحتوي على:
#      ١. دوال مجردة (يجب تنفيذها في كل backend)
#      ٢. محرك تنقيط برمجي (software rasterizer) مبني على ارسم_بكسل
#      ٣. منفّذ عمليات لوحة الرسم (Canvas executor)
#
#      لإنشاء backend جديد: ارث من محرك_رسم ونفّذ الدوال المجردة.
#      كل شيء آخر (خطوط، أشكال، Canvas) يعمل تلقائياً.
#
# (EN) Abstract base class for all rendering backends.
#      Contains software rasterizer + Canvas executor.
#      Subclass and override abstract methods to create a new backend.
#
# الأصناف المُصدّرة:
#   - محرك_رسم (RenderEngine) — الصنف الأساسي
#
# الاستخدام:
#   استورد * من رسومات.محرك.واجهة_محرك
# ===================================================================

استورد * من رسومات.محرك.خطوط

# ===================================================================
#          دوال مساعدة
# ===================================================================

دالة _مطلق(قيمة)
    إذا (قيمة < 0)
        ارجع -قيمة
    نهاية
    ارجع قيمة
نهاية

دالة _إشارة(قيمة)
    إذا (قيمة < 0)
        ارجع -1
    نهاية
    إذا (قيمة > 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

دالة _أدنى(أ, ب)
    إذا (أ < ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة _أقصى(أ, ب)
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

# قسمة صحيحة (لأن / في لغة ص تُرجع عشري)
دالة _قسمة(أ, ب)
    ارجع (أ - أ % ب) / ب
نهاية

# ===================================================================
#          تحويل الألوان
# ===================================================================

## تحويل مكونات لون (RGBA) إلى عدد صحيح 32-بت
صدّر دالة لون_من_مكونات(أحمر, أخضر, أزرق, شفافية = 255)
    ارجع شفافية * 16777216 + أحمر * 65536 + أخضر * 256 + أزرق
نهاية

## تحويل كائن لون_ر إلى عدد صحيح
صدّر دالة لون_كائن_إلى_عدد(ل)
    ارجع ل.شفافية * 16777216 + ل.أحمر * 65536 + ل.أخضر * 256 + ل.أزرق
نهاية

## استخراج المكون الأحمر من عدد لون
صدّر دالة لون_أحمر(لون)
    ارجع _قسمة(لون, 65536) % 256
نهاية

## استخراج المكون الأخضر
صدّر دالة لون_أخضر(لون)
    ارجع _قسمة(لون, 256) % 256
نهاية

## استخراج المكون الأزرق
صدّر دالة لون_أزرق(لون)
    ارجع لون % 256
نهاية

# ===================================================================
#          صنف محرك_رسم — الصنف الأساسي
# ===================================================================

صدّر صنف محرك_رسم

    باني()
        هذا._عرض = 0
        هذا._ارتفاع = 0
        هذا._مهيأ = خطأ
        هذا._قص_مفعل = خطأ
        هذا._قص_س = 0
        هذا._قص_ص = 0
        هذا._قص_ع = 0
        هذا._قص_ا = 0
    نهاية

    # ===============================================================
    #  ⬇ دوال مجردة — يجب تنفيذها في كل backend ⬇
    # ===============================================================

    ## تهيئة المحرك
    ## عرض/ارتفاع: أبعاد الشاشة بالبكسل
    دالة تهيئة(عرض, ارتفاع)
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
        هذا._مهيأ = صحيح
    نهاية

    ## رسم بكسل واحد — العملية الذرية الأساسية
    ## س, ص: الإحداثيات
    ## لون: عدد صحيح 32-بت (0xAARRGGBB)
    دالة ارسم_بكسل(س, ص, لون)
        ارمي "يجب تنفيذ دالة ارسم_بكسل في الصنف الفرعي"
    نهاية

    ## مسح الشاشة بلون
    دالة مسح(لون = 0)
        لكل ص_ح في 0..هذا._ارتفاع - 1
            لكل س_ح في 0..هذا._عرض - 1
                هذا.ارسم_بكسل(س_ح, ص_ح, لون)
            نهاية
        نهاية
    نهاية

    ## تبديل المخزن المؤقت (flip/present)
    دالة تبديل()
        # افتراضي: لا شيء (بعض الخلفيات لا تحتاج تبديل)
    نهاية

    ## عرض الشاشة بالبكسل
    دالة عرض_الشاشة()
        ارجع هذا._عرض
    نهاية

    ## ارتفاع الشاشة بالبكسل
    دالة ارتفاع_الشاشة()
        ارجع هذا._ارتفاع
    نهاية

    ## هل المحرك مهيأ
    دالة مهيأ()
        ارجع هذا._مهيأ
    نهاية

    # ===============================================================
    #  القص (Clipping)
    # ===============================================================

    دالة تعيين_قص(س, ص, عرض, ارتفاع)
        هذا._قص_مفعل = صحيح
        هذا._قص_س = س
        هذا._قص_ص = ص
        هذا._قص_ع = عرض
        هذا._قص_ا = ارتفاع
    نهاية

    دالة إلغاء_قص()
        هذا._قص_مفعل = خطأ
    نهاية

    # بكسل مع فحص القص والحدود
    دالة _بكسل_آمن(س, ص, لون)
        إذا (س < 0)
            ارجع لاشيء
        نهاية
        إذا (ص < 0)
            ارجع لاشيء
        نهاية
        إذا (س >= هذا._عرض)
            ارجع لاشيء
        نهاية
        إذا (ص >= هذا._ارتفاع)
            ارجع لاشيء
        نهاية
        إذا (هذا._قص_مفعل)
            إذا (س < هذا._قص_س)
                ارجع لاشيء
            نهاية
            إذا (ص < هذا._قص_ص)
                ارجع لاشيء
            نهاية
            إذا (س >= هذا._قص_س + هذا._قص_ع)
                ارجع لاشيء
            نهاية
            إذا (ص >= هذا._قص_ص + هذا._قص_ا)
                ارجع لاشيء
            نهاية
        نهاية
        هذا.ارسم_بكسل(س, ص, لون)
    نهاية

    # ===============================================================
    #  ⬇ محرك التنقيط البرمجي (Software Rasterizer) ⬇
    #  مبني بالكامل على _بكسل_آمن
    # ===============================================================

    # ─── خط (Bresenham's Line Algorithm) ───
    دالة ارسم_خط(س1, ص1, س2, ص2, لون)
        متغير فس = _مطلق(س2 - س1)
        متغير فص = _مطلق(ص2 - ص1)
        متغير اس = _إشارة(س2 - س1)
        متغير اص = _إشارة(ص2 - ص1)
        متغير خطأ_ب = فس - فص
        متغير س = س1
        متغير ص = ص1

        بينما (صحيح)
            هذا._بكسل_آمن(س, ص, لون)
            إذا (س == س2)
                إذا (ص == ص2)
                    ارجع لاشيء
                نهاية
            نهاية
            متغير خ2 = 2 * خطأ_ب
            إذا (خ2 > -فص)
                خطأ_ب = خطأ_ب - فص
                س = س + اس
            نهاية
            إذا (خ2 < فس)
                خطأ_ب = خطأ_ب + فس
                ص = ص + اص
            نهاية
        نهاية
    نهاية

    # ─── خط أفقي (مُحسّن) ───
    دالة _خط_أفقي(س1, س2, ص, لون)
        متغير بداية = _أدنى(س1, س2)
        متغير نهاية_خ = _أقصى(س1, س2)
        لكل س في بداية..نهاية_خ
            هذا._بكسل_آمن(س, ص, لون)
        نهاية
    نهاية

    # ─── مستطيل (حدود) ───
    دالة ارسم_مستطيل(س, ص, عرض, ارتفاع, لون)
        هذا._خط_أفقي(س, س + عرض - 1, ص, لون)
        هذا._خط_أفقي(س, س + عرض - 1, ص + ارتفاع - 1, لون)
        لكل ص_ح في ص..ص + ارتفاع - 1
            هذا._بكسل_آمن(س, ص_ح, لون)
            هذا._بكسل_آمن(س + عرض - 1, ص_ح, لون)
        نهاية
    نهاية

    # ─── مستطيل ممتلئ ───
    دالة ارسم_مستطيل_ممتلئ(س, ص, عرض, ارتفاع, لون)
        لكل ص_ح في ص..ص + ارتفاع - 1
            هذا._خط_أفقي(س, س + عرض - 1, ص_ح, لون)
        نهاية
    نهاية

    # ─── دائرة (Midpoint Circle Algorithm) ───
    دالة ارسم_دائرة(مركز_س, مركز_ص, نصف_قطر, لون)
        متغير س = نصف_قطر
        متغير ص = 0
        متغير قرار = 1 - نصف_قطر

        بينما (س >= ص)
            هذا._بكسل_آمن(مركز_س + س, مركز_ص + ص, لون)
            هذا._بكسل_آمن(مركز_س - س, مركز_ص + ص, لون)
            هذا._بكسل_آمن(مركز_س + س, مركز_ص - ص, لون)
            هذا._بكسل_آمن(مركز_س - س, مركز_ص - ص, لون)
            هذا._بكسل_آمن(مركز_س + ص, مركز_ص + س, لون)
            هذا._بكسل_آمن(مركز_س - ص, مركز_ص + س, لون)
            هذا._بكسل_آمن(مركز_س + ص, مركز_ص - س, لون)
            هذا._بكسل_آمن(مركز_س - ص, مركز_ص - س, لون)
            ص = ص + 1
            إذا (قرار <= 0)
                قرار = قرار + 2 * ص + 1
            وإلا
                س = س - 1
                قرار = قرار + 2 * (ص - س) + 1
            نهاية
        نهاية
    نهاية

    # ─── دائرة ممتلئة ───
    دالة ارسم_دائرة_ممتلئة(مركز_س, مركز_ص, نصف_قطر, لون)
        متغير س = نصف_قطر
        متغير ص = 0
        متغير قرار = 1 - نصف_قطر

        بينما (س >= ص)
            هذا._خط_أفقي(مركز_س - س, مركز_س + س, مركز_ص + ص, لون)
            هذا._خط_أفقي(مركز_س - س, مركز_س + س, مركز_ص - ص, لون)
            هذا._خط_أفقي(مركز_س - ص, مركز_س + ص, مركز_ص + س, لون)
            هذا._خط_أفقي(مركز_س - ص, مركز_س + ص, مركز_ص - س, لون)
            ص = ص + 1
            إذا (قرار <= 0)
                قرار = قرار + 2 * ص + 1
            وإلا
                س = س - 1
                قرار = قرار + 2 * (ص - س) + 1
            نهاية
        نهاية
    نهاية

    # ─── مثلث (حدود) ───
    دالة ارسم_مثلث(س1, ص1, س2, ص2, س3, ص3, لون)
        هذا.ارسم_خط(س1, ص1, س2, ص2, لون)
        هذا.ارسم_خط(س2, ص2, س3, ص3, لون)
        هذا.ارسم_خط(س3, ص3, س1, ص1, لون)
    نهاية

    # ─── مستطيل بزوايا مستديرة (حدود) ───
    دالة ارسم_مستطيل_مستدير(س, ص, عرض, ارتفاع, نق, لون)
        # الأضلاع الأفقية
        هذا._خط_أفقي(س + نق, س + عرض - نق - 1, ص, لون)
        هذا._خط_أفقي(س + نق, س + عرض - نق - 1, ص + ارتفاع - 1, لون)
        # الأضلاع العمودية
        لكل ص_ح في ص + نق..ص + ارتفاع - نق - 1
            هذا._بكسل_آمن(س, ص_ح, لون)
            هذا._بكسل_آمن(س + عرض - 1, ص_ح, لون)
        نهاية
        # الزوايا (أرباع دائرة)
        هذا._ربع_دائرة(س + نق, ص + نق, نق, لون, 2)
        هذا._ربع_دائرة(س + عرض - نق - 1, ص + نق, نق, لون, 1)
        هذا._ربع_دائرة(س + نق, ص + ارتفاع - نق - 1, نق, لون, 3)
        هذا._ربع_دائرة(س + عرض - نق - 1, ص + ارتفاع - نق - 1, نق, لون, 4)
    نهاية

    # ربع دائرة: ربع=1 أعلى-يمين، 2 أعلى-يسار، 3 أسفل-يسار، 4 أسفل-يمين
    دالة _ربع_دائرة(مس, مص, نق, لون, ربع)
        متغير س = نق
        متغير ص = 0
        متغير قرار = 1 - نق
        بينما (س >= ص)
            إذا (ربع == 1)
                هذا._بكسل_آمن(مس + س, مص - ص, لون)
                هذا._بكسل_آمن(مس + ص, مص - س, لون)
            نهاية
            إذا (ربع == 2)
                هذا._بكسل_آمن(مس - س, مص - ص, لون)
                هذا._بكسل_آمن(مس - ص, مص - س, لون)
            نهاية
            إذا (ربع == 3)
                هذا._بكسل_آمن(مس - س, مص + ص, لون)
                هذا._بكسل_آمن(مس - ص, مص + س, لون)
            نهاية
            إذا (ربع == 4)
                هذا._بكسل_آمن(مس + س, مص + ص, لون)
                هذا._بكسل_آمن(مس + ص, مص + س, لون)
            نهاية
            ص = ص + 1
            إذا (قرار <= 0)
                قرار = قرار + 2 * ص + 1
            وإلا
                س = س - 1
                قرار = قرار + 2 * (ص - س) + 1
            نهاية
        نهاية
    نهاية

    # ===============================================================
    #  ⬇ رسم النصوص (Bitmap Font Rendering) ⬇
    # ===============================================================

    ## رسم حرف واحد بخط 8×8
    دالة ارسم_حرف(س, ص, حرف, لون, مقياس = 1)
        متغير صفوف = خط_صفوف(حرف)
        لكل صف_رقم في 0..7
            لكل عمود في 0..7
                إذا (خط_بت(صفوف[صف_رقم], عمود))
                    إذا (مقياس == 1)
                        هذا._بكسل_آمن(س + عمود, ص + صف_رقم, لون)
                    وإلا
                        هذا.ارسم_مستطيل_ممتلئ(
                            س + عمود * مقياس,
                            ص + صف_رقم * مقياس,
                            مقياس, مقياس, لون
                        )
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية

    ## رسم سلسلة نصية
    دالة ارسم_نص(س, ص, محتوى, لون, مقياس = 1)
        متغير إزاحة_س = 0
        لكل ف في 0..محتوى.طول() - 1
            متغير حرف = محتوى[ف]
            هذا.ارسم_حرف(س + إزاحة_س, ص, حرف, لون, مقياس)
            إزاحة_س = إزاحة_س + عرض_حرف * مقياس
        نهاية
    نهاية

    # ===============================================================
    #  ⬇ منفّذ لوحة الرسم (Canvas Executor) ⬇
    #  يأخذ كائن لوحة_رسم وينفّذ عملياته
    # ===============================================================

    ## تنفيذ جميع عمليات لوحة الرسم
    ## لوحة: كائن لوحة_رسم من رسومات.رسم.لوحة
    دالة نفّذ_لوحة(لوحة)
        لكل عملية في لوحة.عمليات()
            هذا._نفّذ_عملية(عملية)
        نهاية
    نهاية

    ## تحويل فرشاة Canvas إلى عدد لون
    دالة _لون_فرشاة(فرشاة)
        إذا (فرشاة == لاشيء)
            ارجع 16777215
        نهاية
        ارجع لون_كائن_إلى_عدد(فرشاة.لون)
    نهاية

    ## تنفيذ عملية واحدة من عمليات Canvas
    دالة _نفّذ_عملية(عملية)
        متغير نوع = عملية["نوع"]
        متغير لون = 16777215

        # ─── مسح ───
        إذا (نوع == "مسح")
            إذا (عملية["لون"] != لاشيء)
                لون = لون_كائن_إلى_عدد(عملية["لون"])
            وإلا
                لون = 0
            نهاية
            هذا.مسح(لون)
            ارجع لاشيء
        نهاية

        # ─── خط ───
        إذا (نوع == "خط")
            لون = هذا._لون_فرشاة(عملية["فرشاة"])
            هذا.ارسم_خط(
                عملية["س1"], عملية["ص1"],
                عملية["س2"], عملية["ص2"], لون
            )
            ارجع لاشيء
        نهاية

        # ─── مستطيل ───
        إذا (نوع == "مستطيل")
            لون = هذا._لون_فرشاة(عملية["فرشاة"])
            إذا (عملية["فرشاة"] != لاشيء)
                إذا (عملية["فرشاة"].نمط == "ملء")
                    هذا.ارسم_مستطيل_ممتلئ(
                        عملية["يسار"], عملية["أعلى"],
                        عملية["عرض"], عملية["ارتفاع"], لون
                    )
                    ارجع لاشيء
                نهاية
            نهاية
            هذا.ارسم_مستطيل(
                عملية["يسار"], عملية["أعلى"],
                عملية["عرض"], عملية["ارتفاع"], لون
            )
            ارجع لاشيء
        نهاية

        # ─── مستطيل مستدير ───
        إذا (نوع == "مستطيل_مستدير")
            لون = هذا._لون_فرشاة(عملية["فرشاة"])
            هذا.ارسم_مستطيل_مستدير(
                عملية["يسار"], عملية["أعلى"],
                عملية["عرض"], عملية["ارتفاع"],
                عملية["نصف_قطر"], لون
            )
            ارجع لاشيء
        نهاية

        # ─── دائرة ───
        إذا (نوع == "دائرة")
            لون = هذا._لون_فرشاة(عملية["فرشاة"])
            إذا (عملية["فرشاة"] != لاشيء)
                إذا (عملية["فرشاة"].نمط == "ملء")
                    هذا.ارسم_دائرة_ممتلئة(
                        عملية["س"], عملية["ص"],
                        عملية["نصف_قطر"], لون
                    )
                    ارجع لاشيء
                نهاية
            نهاية
            هذا.ارسم_دائرة(
                عملية["س"], عملية["ص"],
                عملية["نصف_قطر"], لون
            )
            ارجع لاشيء
        نهاية

        # ─── نص ───
        إذا (نوع == "نص")
            لون = هذا._لون_فرشاة(عملية["فرشاة"])
            متغير مقياس = 1
            إذا (عملية["حجم_خط"] != لاشيء)
                مقياس = _قسمة(عملية["حجم_خط"], 8)
                إذا (مقياس < 1)
                    مقياس = 1
                نهاية
            نهاية
            هذا.ارسم_نص(
                عملية["س"], عملية["ص"],
                عملية["نص"], لون, مقياس
            )
            ارجع لاشيء
        نهاية

        # ─── نقاط ───
        إذا (نوع == "نقاط")
            لون = هذا._لون_فرشاة(عملية["فرشاة"])
            لكل نقطة في عملية["نقاط"]
                هذا._بكسل_آمن(نقطة.س, نقطة.ص, لون)
            نهاية
            ارجع لاشيء
        نهاية

        # ─── قص مستطيل ───
        إذا (نوع == "قص_مستطيل")
            هذا.تعيين_قص(
                عملية["يسار"], عملية["أعلى"],
                عملية["عرض"], عملية["ارتفاع"]
            )
            ارجع لاشيء
        نهاية

        # ─── حفظ/استعادة ───
        إذا (نوع == "حفظ")
            ارجع لاشيء
        نهاية
        إذا (نوع == "استعادة")
            هذا.إلغاء_قص()
            ارجع لاشيء
        نهاية
    نهاية

    # ===============================================================
    #  ⬇ تنفيذ شجرة عناصر UI ⬇
    #  يأخذ عنصر_جذر ويرسمه (نسخة مبسطة)
    # ===============================================================

    ## رسم عنصر UI وأبناؤه بشكل متكرر
    دالة نفّذ_عنصر(عنصر_جذر, س = 0, ص = 0)
        إذا (عنصر_جذر == لاشيء)
            ارجع لاشيء
        نهاية
        # استدعاء بناء() للحصول على الشجرة الفعلية
        متغير فعلي = عنصر_جذر
        إذا (عنصر_جذر.بناء != لاشيء)
            فعلي = عنصر_جذر.بناء()
        نهاية
        # رسم الأبناء
        إذا (فعلي._أبناء != لاشيء)
            لكل ابن في فعلي._أبناء
                هذا.نفّذ_عنصر(ابن, س, ص)
            نهاية
        نهاية
    نهاية
نهاية
