# بسم الله الرحمن الرحيم
# ===================================================================
# محرك النواة — Freestanding Rendering Backend
# ===================================================================
#
# (AR) تنفيذ محرك الرسم لوضع freestanding (أنظمة التشغيل).
#      يستخدم دوال FFI من sad_lowlevel_rt عبر framebuffer مباشر.
#
#      هذا المحرك يُستخدم عند تجميع الكود بمترجم sadc
#      لإنتاج ملف تنفيذي يعمل على bare-metal.
#
#      يُعيد تنفيذ بعض الدوال (مستطيل، خط) لاستغلال
#      دوال C++ المُحسّنة بدلاً من الرسم بكسل-بكسل.
#
# (EN) Freestanding rendering backend using FFI framebuffer functions.
#      Overrides some methods to use optimized C++ implementations.
#
# الاستخدام:
#   استورد * من رسومات.محرك.محرك_نواة
#   متغير شاشة = جديد محرك_نواة()
#   شاشة.تهيئة(1024, 768)
#   شاشة.ارسم_مستطيل_ممتلئ(10, 10, 200, 100, 0xFF0000)
# ===================================================================

استورد * من رسومات.محرك.واجهة_محرك
# ملاحظة: استورد أحداث يتم في ملفات الاستخدام مباشرة لتجنب مشاكل التحميل

# ─── دوال FFI من النواة (مُعرّفة في sad_lowlevel_rt.c) ───
خارجي دالة sad_ll_fb_init(عرض: رقم, ارتفاع: رقم, عمق: رقم)
خارجي دالة sad_ll_fb_set_pixel(س: رقم, ص: رقم, لون: رقم)
خارجي دالة sad_ll_fb_draw_rect(س: رقم, ص: رقم, عرض: رقم, ارتفاع: رقم, لون: رقم)
خارجي دالة sad_ll_fb_fill_rect(س: رقم, ص: رقم, عرض: رقم, ارتفاع: رقم, لون: رقم)
خارجي دالة sad_ll_fb_draw_line(س1: رقم, ص1: رقم, س2: رقم, ص2: رقم, لون: رقم)
خارجي دالة sad_ll_fb_clear(لون: رقم)
خارجي دالة sad_ll_fb_clear_default()

# ─── دوال FFI للأحداث (مُعرّفة في معالجات المقاطعات) ───
خارجي دالة sad_ll_kb_has_event()
خارجي دالة sad_ll_kb_get_scancode()
خارجي دالة sad_ll_kb_get_key_state()
خارجي دالة sad_ll_kb_get_modifiers()
خارجي دالة sad_ll_mouse_has_event()
خارجي دالة sad_ll_mouse_get_x()
خارجي دالة sad_ll_mouse_get_y()
خارجي دالة sad_ll_mouse_get_buttons()
خارجي دالة sad_ll_mouse_get_event_type()

# ===================================================================
#          صنف محرك النواة
# ===================================================================

صدّر صنف محرك_نواة يرث محرك_رسم

    باني()
        هذا._عرض = 0
        هذا._ارتفاع = 0
        هذا._مهيأ = خطأ
        هذا._قص_مفعل = خطأ
        هذا._قص_س = 0
        هذا._قص_ص = 0
        هذا._قص_ع = 0
        هذا._قص_ا = 0
        هذا._عمق = 32
        هذا._يعمل = صحيح
    نهاية

    # ─── تجاوز: تهيئة ───
    دالة تهيئة(عرض, ارتفاع, عمق = 32)
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
        هذا._عمق = عمق
        sad_ll_fb_init(عرض, ارتفاع, عمق)
        هذا._مهيأ = صحيح
    نهاية

    # ─── تجاوز: رسم بكسل (العملية الذرية) ───
    دالة ارسم_بكسل(س, ص, لون)
        sad_ll_fb_set_pixel(س, ص, لون)
    نهاية

    # ─── تجاوز: مسح (مُحسّن — دالة C++ واحدة) ───
    دالة مسح(لون = 0)
        إذا (لون == 0)
            sad_ll_fb_clear_default()
        وإلا
            sad_ll_fb_clear(لون)
        نهاية
    نهاية

    # ─── تجاوز: خط (مُحسّن — Bresenham في C++) ───
    دالة ارسم_خط(س1, ص1, س2, ص2, لون)
        sad_ll_fb_draw_line(س1, ص1, س2, ص2, لون)
    نهاية

    # ─── تجاوز: مستطيل حدود (مُحسّن) ───
    دالة ارسم_مستطيل(س, ص, عرض, ارتفاع, لون)
        sad_ll_fb_draw_rect(س, ص, عرض, ارتفاع, لون)
    نهاية

    # ─── تجاوز: مستطيل ممتلئ (مُحسّن — memset في C++) ───
    دالة ارسم_مستطيل_ممتلئ(س, ص, عرض, ارتفاع, لون)
        sad_ll_fb_fill_rect(س, ص, عرض, ارتفاع, لون)
    نهاية

    # الدوال الأخرى (دائرة, مثلث, نص, Canvas) تعمل تلقائياً
    # عبر الوراثة من محرك_رسم (software rasterizer)

    # ===============================================================
    # ⬇ حالة التشغيل ⬇
    # ===============================================================

    ## هل المحرك يعمل (لحلقة الأحداث الرئيسية)
    دالة يعمل()
        ارجع هذا._يعمل
    نهاية

    ## إيقاف المحرك (خروج من حلقة الأحداث)
    دالة أوقف()
        هذا._يعمل = خطأ
    نهاية
نهاية

# ===================================================================
# دوال FFI للأحداث (للاستخدام في مدخلات_نواة.ص)
# ===================================================================
صدّر دالة _نواة_لوحة_مفاتيح_حدث()
    ارجع sad_ll_kb_has_event()
نهاية

صدّر دالة _نواة_لوحة_مفاتيح_مفتاح()
    ارجع sad_ll_kb_get_scancode()
نهاية

صدّر دالة _نواة_لوحة_مفاتيح_حالة()
    ارجع sad_ll_kb_get_key_state()
نهاية

صدّر دالة _نواة_لوحة_مفاتيح_معدلات()
    ارجع sad_ll_kb_get_modifiers()
نهاية

صدّر دالة _نواة_فأرة_حدث()
    ارجع sad_ll_mouse_has_event()
نهاية

صدّر دالة _نواة_فأرة_س()
    ارجع sad_ll_mouse_get_x()
نهاية

صدّر دالة _نواة_فأرة_ص()
    ارجع sad_ll_mouse_get_y()
نهاية

صدّر دالة _نواة_فأرة_أزرار()
    ارجع sad_ll_mouse_get_buttons()
نهاية

صدّر دالة _نواة_فأرة_نوع()
    ارجع sad_ll_mouse_get_event_type()
نهاية
