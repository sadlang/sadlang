# بسم الله الرحمن الرحيم
# ===================================================================
# مدخلات النواة — Kernel Input Handler
# ===================================================================
#
# (AR) هذا الملف يربط بين محرك النواة ونظام الأحداث.
#      يستورد كلاً من محرك_نواة وأحداث ويوفر دوال
#      لجلب أحداث الإدخال من الأجهزة.
#
# (EN) Bridges kernel engine with event system.
#      Imports both محرك_نواة and أحداث modules.
#
# الاستخدام:
#   استورد * من رسومات.محرك.مدخلات_نواة
#   متغير طابور = جديد طابور_أحداث()
#   جلب_أحداث_نواة(طابور)
# ===================================================================

استورد * من رسومات.محرك.محرك_نواة
استورد * من رسومات.محرك.أحداث

# ===================================================================
# دوال جلب الأحداث
# ===================================================================

## جلب أحداث لوحة المفاتيح والفأرة من الأجهزة وإضافتها للطابور
صدّر دالة جلب_أحداث_نواة(طابور)
    # جلب أحداث لوحة المفاتيح من IRQ1
    بينما (_نواة_لوحة_مفاتيح_حدث())
        متغير مفتاح = _نواة_لوحة_مفاتيح_مفتاح()
        متغير حالة = _نواة_لوحة_مفاتيح_حالة()
        متغير معدّلات = _نواة_لوحة_مفاتيح_معدلات()
        متغير نوع_ح = حدث_ضغط_مفتاح
        إذا (حالة == 0)
            نوع_ح = حدث_رفع_مفتاح
        نهاية
        متغير شيفت_مفعل = (معدّلات % 2) == 1
        متغير كنترول_مفعل = ((معدّلات - معدّلات % 2) / 2) % 2 == 1
        متغير ألت_مفعل = ((معدّلات - معدّلات % 4) / 4) % 2 == 1
        متغير ح = جديد حدث_مفتاح(نوع_ح, مفتاح, "", شيفت_مفعل, كنترول_مفعل, ألت_مفعل)
        طابور.أضف(ح)
    نهاية
    # جلب أحداث الفأرة من IRQ12
    بينما (_نواة_فأرة_حدث())
        متغير س_ف = _نواة_فأرة_س()
        متغير ص_ف = _نواة_فأرة_ص()
        متغير أزرار = _نواة_فأرة_أزرار()
        متغير نوع_ف = _نواة_فأرة_نوع()
        متغير ح_ف = جديد حدث_فأرة(نوع_ف, س_ف, ص_ف, أزرار)
        طابور.أضف(ح_ف)
    نهاية
نهاية

## معالجة جميع الأحداث باستخدام دالة رد نداء
صدّر دالة عالج_أحداث_نواة(طابور, معالج, محرك = لاشيء)
    جلب_أحداث_نواة(طابور)
    بينما (ليس طابور.فارغ())
        متغير ح = طابور.التالي()
        إذا (ح != لاشيء)
            معالج(ح)
            إذا (ح.نوع == حدث_إغلاق)
                إذا (محرك != لاشيء)
                    محرك.أوقف()
                نهاية
            نهاية
        نهاية
    نهاية
نهاية
