# بسم الله الرحمن الرحيم
# ===================================================================
# مدير النوافذ — Window Manager for Kernel Mode
# ===================================================================
#
# (AR) مدير نوافذ بسيط لأنظمة التشغيل المبنية بلغة ص.
#      يوفر: نوافذ متحركة، شريط عنوان، أزرار إغلاق/تكبير/تصغير،
#      تراكب النوافذ، خلفية سطح المكتب.
#
#      يعمل مع أي محرك_رسم (نواة أو مدمج).
#
# (EN) Simple compositing window manager for Sad-based operating systems.
#      Works with any محرك_رسم backend.
#
# الاستخدام:
#   استورد * من رسومات.محرك.مدير_نوافذ
#   متغير شاشة = جديد محرك_نواة()
#   شاشة.تهيئة(1024, 768)
#   متغير مدير = جديد مدير_نوافذ(شاشة)
#   مدير.أنشئ_نافذة("ترحيب", 100, 100, 400, 300)
#   مدير.ارسم()
# ===================================================================

استورد * من رسومات.محرك.واجهة_محرك

# ─── ثوابت مدير النوافذ ───
ثابت ارتفاع_شريط_عنوان = 28
ثابت حجم_زر_نافذة = 20
ثابت هامش_نافذة = 2

# ألوان افتراضية
ثابت لون_شريط_عنوان_نشط    = 1793023     # 0x001B5FFF — أزرق
ثابت لون_شريط_عنوان_غير_نشط = 8421504     # 0x00808080 — رمادي
ثابت لون_جسم_نافذة          = 15790320    # 0x00F0F0F0 — رمادي فاتح
ثابت لون_إطار_نافذة         = 6710886     # 0x00666666 — رمادي غامق
ثابت لون_زر_إغلاق           = 16728128    # 0x00FF4040 — أحمر
ثابت لون_زر_تكبير           = 3394611     # 0x0033CC33 — أخضر
ثابت لون_زر_تصغير           = 16761924    # 0x00FFE444 — أصفر
ثابت لون_نص_عنوان            = 16777215    # 0x00FFFFFF — أبيض
ثابت لون_سطح_المكتب         = 1280068     # 0x00138A44 — أخضر غامق

# ===================================================================
#          صنف نافذة
# ===================================================================

صدّر صنف نافذة_نواة
    باني(عنوان, س, ص, عرض, ارتفاع)
        هذا.عنوان = عنوان
        هذا.س = س
        هذا.ص = ص
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
        هذا.مرئية = صحيح
        هذا.نشطة = خطأ
        هذا.مكبرة = خطأ
        هذا.محتوى = لاشيء
        هذا.عند_رسم = لاشيء
        # للسحب
        هذا._يُسحب = خطأ
        هذا._إزاحة_سحب_س = 0
        هذا._إزاحة_سحب_ص = 0
    نهاية

    ## هل النقطة (نس, نص) داخل شريط العنوان
    دالة في_شريط_العنوان(نس, نص)
        ارجع نس >= هذا.س و نس < هذا.س + هذا.عرض و نص >= هذا.ص و نص < هذا.ص + ارتفاع_شريط_عنوان
    نهاية

    ## هل النقطة في زر الإغلاق
    دالة في_زر_إغلاق(نس, نص)
        متغير زس = هذا.س + هذا.عرض - حجم_زر_نافذة - 4
        متغير زص = هذا.ص + 4
        ارجع نس >= زس و نس < زس + حجم_زر_نافذة و نص >= زص و نص < زص + حجم_زر_نافذة
    نهاية

    ## هل النقطة داخل النافذة
    دالة يحتوي(نس, نص)
        ارجع نس >= هذا.س و نس < هذا.س + هذا.عرض و نص >= هذا.ص و نص < هذا.ص + هذا.ارتفاع
    نهاية
نهاية

# ===================================================================
#          صنف مدير النوافذ
# ===================================================================

صدّر صنف مدير_نوافذ
    باني(محرك)
        هذا._محرك = محرك
        هذا._نوافذ = []
        هذا._لون_خلفية = لون_سطح_المكتب
    نهاية

    ## إنشاء نافذة جديدة
    دالة أنشئ_نافذة(عنوان, س, ص, عرض, ارتفاع)
        متغير ن = جديد نافذة_نواة(عنوان, س, ص, عرض, ارتفاع)
        هذا._نوافذ = هذا._نوافذ + [ن]
        ارجع ن
    نهاية

    ## تعيين لون الخلفية
    دالة لون_خلفية(لون)
        هذا._لون_خلفية = لون
    نهاية

    ## رسم سطح المكتب والنوافذ
    دالة ارسم()
        # ١. رسم الخلفية
        هذا._محرك.مسح(هذا._لون_خلفية)

        # ٢. رسم النوافذ (من الخلف إلى الأمام)
        لكل ن في هذا._نوافذ
            إذا (ن.مرئية)
                هذا._ارسم_نافذة(ن)
            نهاية
        نهاية

        # ٣. تبديل المخزن
        هذا._محرك.تبديل()
    نهاية

    ## رسم نافذة واحدة
    دالة _ارسم_نافذة(ن)
        متغير م = هذا._محرك

        # الظل
        م.ارسم_مستطيل_ممتلئ(ن.س + 3, ن.ص + 3, ن.عرض, ن.ارتفاع, 2105376)

        # إطار خارجي
        م.ارسم_مستطيل(ن.س - 1, ن.ص - 1, ن.عرض + 2, ن.ارتفاع + 2, لون_إطار_نافذة)

        # شريط العنوان
        متغير لون_شريط = لون_شريط_عنوان_غير_نشط
        إذا (ن.نشطة)
            لون_شريط = لون_شريط_عنوان_نشط
        نهاية
        م.ارسم_مستطيل_ممتلئ(ن.س, ن.ص, ن.عرض, ارتفاع_شريط_عنوان, لون_شريط)

        # عنوان النافذة
        م.ارسم_نص(ن.س + 8, ن.ص + 6, ن.عنوان, لون_نص_عنوان, 2)

        # أزرار النافذة (إغلاق، تكبير، تصغير)
        متغير زس = ن.س + ن.عرض - حجم_زر_نافذة - 4
        متغير زص = ن.ص + 4
        م.ارسم_مستطيل_ممتلئ(زس, زص, حجم_زر_نافذة, حجم_زر_نافذة, لون_زر_إغلاق)
        م.ارسم_مستطيل_ممتلئ(زس - حجم_زر_نافذة - 4, زص, حجم_زر_نافذة, حجم_زر_نافذة, لون_زر_تكبير)
        م.ارسم_مستطيل_ممتلئ(زس - 2 * (حجم_زر_نافذة + 4), زص, حجم_زر_نافذة, حجم_زر_نافذة, لون_زر_تصغير)

        # جسم النافذة
        م.ارسم_مستطيل_ممتلئ(
            ن.س, ن.ص + ارتفاع_شريط_عنوان,
            ن.عرض, ن.ارتفاع - ارتفاع_شريط_عنوان,
            لون_جسم_نافذة
        )

        # رسم المحتوى إذا وُجد
        إذا (ن.عند_رسم != لاشيء)
            ن.عند_رسم(م, ن.س, ن.ص + ارتفاع_شريط_عنوان, ن.عرض, ن.ارتفاع - ارتفاع_شريط_عنوان)
        نهاية
    نهاية

    ## معالجة نقرة فأرة
    دالة نقرة(نس, نص)
        # البحث من الأمام (آخر نافذة = أعلى)
        متغير ف = هذا._نوافذ.طول() - 1
        بينما (ف >= 0)
            متغير ن = هذا._نوافذ[ف]
            إذا (ن.مرئية)
                إذا (ن.يحتوي(نس, نص))
                    # تفعيل النافذة
                    هذا._فعّل(ف)
                    # فحص زر الإغلاق
                    إذا (ن.في_زر_إغلاق(نس, نص))
                        ن.مرئية = خطأ
                    نهاية
                    ارجع ن
                نهاية
            نهاية
            ف = ف - 1
        نهاية
        ارجع لاشيء
    نهاية

    ## تفعيل نافذة (نقلها للأمام)
    دالة _فعّل(فهرس)
        لكل ف في 0..هذا._نوافذ.طول() - 1
            هذا._نوافذ[ف].نشطة = خطأ
        نهاية
        # نقل النافذة لآخر المصفوفة (أمام)
        متغير نافذة = هذا._نوافذ[فهرس]
        نافذة.نشطة = صحيح
        متغير جديدة = []
        لكل ف في 0..هذا._نوافذ.طول() - 1
            إذا (ف != فهرس)
                جديدة = جديدة + [هذا._نوافذ[ف]]
            نهاية
        نهاية
        جديدة = جديدة + [نافذة]
        هذا._نوافذ = جديدة
    نهاية

    ## عدد النوافذ
    دالة عدد_النوافذ()
        ارجع هذا._نوافذ.طول()
    نهاية

    ## إغلاق جميع النوافذ
    دالة إغلاق_الكل()
        هذا._نوافذ = []
    نهاية
نهاية
