# ===================================================================
# نظام التدويل — Internationalization (i18n)
# ===================================================================
# دعم لغات متعددة واتجاه النص (RTL/LTR)
# مطابق لـ flutter/localizations/ و flutter/widgets/localizations.dart
#
# الاستخدام:
#   استورد * من رسومات.تدويل_نظام.تدويل
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── لغة (Locale) ───
صدّر صنف لغة
    باني(رمز_لغة = "ar", رمز_بلد = لاشيء)
        هذا._رمز_لغة = رمز_لغة
        هذا._رمز_بلد = رمز_بلد
        هذا._رمز_كتابة = لاشيء
    نهاية

    دالة رمز_اللغة()
        ارجع هذا._رمز_لغة
    نهاية

    دالة رمز_البلد()
        ارجع هذا._رمز_بلد
    نهاية

    دالة إلى_نص()
        إذا (هذا._رمز_بلد != لاشيء)
            ارجع هذا._رمز_لغة + "_" + هذا._رمز_بلد
        نهاية
        ارجع هذا._رمز_لغة
    نهاية

    دالة من_يمين_لذيسار()
        ارجع هذا._رمز_لغة == "ar" أو هذا._رمز_لغة == "he" أو هذا._رمز_لغة == "fa" أو هذا._رمز_لغة == "ur"
    نهاية
نهاية

# ─── ترجمات (Translations) ───
صدّر صنف ترجمات
    باني()
        هذا._ترجمات = {}
        هذا._اللغة_الحالية = "ar"
        هذا._اللغة_الاحتياطية = "ar"
    نهاية

    دالة أضف_لغة(رمز, قاموس)
        هذا._ترجمات[رمز] = قاموس
        ارجع هذا
    نهاية

    دالة عيّن_اللغة(رمز)
        هذا._اللغة_الحالية = رمز
        ارجع هذا
    نهاية

    دالة عيّن_الاحتياطية(رمز)
        هذا._اللغة_الاحتياطية = رمز
        ارجع هذا
    نهاية

    دالة ترجم(مفتاح)
        إذا (هذا._ترجمات[هذا._اللغة_الحالية] != لاشيء)
            متغير قاموس = هذا._ترجمات[هذا._اللغة_الحالية]
            إذا (قاموس[مفتاح] != لاشيء)
                ارجع قاموس[مفتاح]
            نهاية
        نهاية

        إذا (هذا._ترجمات[هذا._اللغة_الاحتياطية] != لاشيء)
            متغير قاموس_احتياطي = هذا._ترجمات[هذا._اللغة_الاحتياطية]
            إذا (قاموس_احتياطي[مفتاح] != لاشيء)
                ارجع قاموس_احتياطي[مفتاح]
            نهاية
        نهاية

        ارجع مفتاح
    نهاية

    دالة اللغة_الحالية()
        ارجع هذا._اللغة_الحالية
    نهاية

    دالة اللغات_المتاحة()
        متغير نتيجة = []
        لكل مفتاح، _ في هذا._ترجمات
            نتيجة = نتيجة + [مفتاح]
        نهاية
        ارجع نتيجة
    نهاية
نهاية

# ─── مزود_تدويل (LocalizationsDelegate) ───
صدّر صنف مزود_تدويل
    باني(اسم = "", ترجمات = لاشيء)
        هذا._اسم = اسم
        هذا._ترجمات = ترجمات
        هذا._لغات_مدعومة = []
    نهاية

    دالة يدعم(لغة)
        لكل ل في هذا._لغات_مدعومة
            إذا (ل == لغة)
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    دالة حمّل(لغة)
        إذا (هذا._ترجمات != لاشيء)
            هذا._ترجمات.عيّن_اللغة(لغة)
        نهاية
        ارجع هذا._ترجمات
    نهاية
نهاية

# ─── عنصر_اتجاهية (Directionality) ───
صدّر صنف اتجاهية يرث عنصر
    باني(اتجاه = "يمين_لذيسار", ابن = لاشيء)
        هذا._نوع = "اتجاهية"
        هذا._خصائص = {}
        هذا._خصائص["اتجاه"] = اتجاه
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

# ─── عنصر_تدويل (Localizations Widget) ───
صدّر صنف عنصر_تدويل يرث عنصر
    باني(لغة = لاشيء, مزودون = [], ابن = لاشيء)
        هذا._نوع = "تدويل"
        هذا._خصائص = {}
        هذا._خصائص["لغة"] = لغة
        هذا._خصائص["مزودون"] = مزودون
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

# ─── تنسيق_تاريخ (DateFormat — مبسط) ───
صدّر صنف تنسيق_تاريخ
    باني(نمط = "يوم/شهر/سنة")
        هذا._نمط = نمط
    نهاية

    دالة نسّق(تاريخ)
        ارجع تاريخ
    نهاية
نهاية

# ─── تنسيق_رقم (NumberFormat — مبسط) ───
صدّر صنف تنسيق_رقم
    باني(لغة = "ar")
        هذا._لغة = لغة
        هذا._أرقام_عربية = ["٠","١","٢","٣","٤","٥","٦","٧","٨","٩"]
    نهاية

    دالة نسّق(رقم)
        ارجع رقم
    نهاية

    دالة إلى_عربي(رقم)
        متغير نص_رقم = "" + رقم
        متغير نتيجة = ""
        لكل حرف في نص_رقم
            إذا (حرف >= "0" و حرف <= "9")
                نتيجة = نتيجة + هذا._أرقام_عربية[حرف - "0"]
            وإلا
                نتيجة = نتيجة + حرف
            نهاية
        نهاية
        ارجع نتيجة
    نهاية
نهاية

# ─── لغات_شائعة — ثوابت مفيدة ───
صدّر صنف لغات_شائعة
    ساكن ثابت العربية = "ar"
    ساكن ثابت الإنجليزية = "en"
    ساكن ثابت الفرنسية = "fr"
    ساكن ثابت الألمانية = "de"
    ساكن ثابت الإسبانية = "es"
    ساكن ثابت التركية = "tr"
    ساكن ثابت الفارسية = "fa"
    ساكن ثابت الأردية = "ur"
    ساكن ثابت العبرية = "he"
    ساكن ثابت الصينية = "zh"
    ساكن ثابت اليابانية = "ja"
    ساكن ثابت الكورية = "ko"
نهاية
