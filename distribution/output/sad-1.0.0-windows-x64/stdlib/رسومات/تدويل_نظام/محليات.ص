# بسم الله الرحمن الرحيم
# ===================================================================
# المحليات واللغات — Locales & Language Support
# ===================================================================
#
# (AR) هذا الملف يوفر نظام المحليات (Locales) الشامل الذي يدير:
#      - تعريف اللغات والبلدان والخطوط
#      - تسجيل اللغات المدعومة في التطبيق
#      - اكتشاف لغة النظام تلقائيًا
#      - التبديل بين اللغات في وقت التشغيل
#      - دعم الاتجاه (RTL/LTR) تلقائيًا
#
#      اللغات المدعومة افتراضيًا:
#      ar (عربي) — اللغة الأساسية للغة ص
#      en (إنجليزي)، fr (فرنسي)، de (ألماني)، es (إسباني)
#      fa (فارسي/RTL)، he (عبري/RTL)، ur (أردو/RTL)
#      zh (صيني)، ja (ياباني)، ko (كوري)، tr (تركي)
#
#      مطابق لـ flutter/widgets/localizations.dart
#      و dart:ui/Locale
#
# (EN) Comprehensive Locale system managing language, country,
#      script, text direction, and runtime language switching.
#
# الأصناف المُصدّرة:
#   - محلية (Locale)                      — لغة + بلد + خط
#   - سجل_محليات (LocaleRegistry)          — سجل اللغات المدعومة
#   - محلل_محلية (LocaleResolver)          — حل النزاعات
#   - مراقب_محلية (LocaleObserver)         — مراقبة التغييرات
#
# الاستخدام:
#   استورد * من رسومات.تدويل_نظام.محليات
# ===================================================================

# ─── ثوابت الاتجاه ───
ثابت يمين_لذيسار = "rtl"   # Right-to-Left
ثابت يسار_ليمين = "ltr"    # Left-to-Right

# ─── اللغات من يمين لذيسار ───
ثابت لغات_يمين_لذيسار = ["ar", "he", "fa", "ur", "ps", "ku", "sd", "ug", "yi"]

# ─── محلية (Locale) ───
صدّر صنف محلية
    # (AR) تمثيل كامل لمحلية — تشمل رمز اللغة (مطلوب)،
    #      رمز البلد (اختياري)، واسم الخط (اختياري)
    #      مثال: محلية("ar", "SA") — عربي/سعودية
    #      مثال: محلية("en", "US") — إنجليزي/أمريكا
    # (EN) Full locale representation: language + country + script
    باني(رمز_لغة = "ar", رمز_بلد = لاشيء, خط = لاشيء)
        هذا._رمز_لغة = رمز_لغة
        هذا._رمز_بلد = رمز_بلد
        هذا._خط = خط
    نهاية

    دالة رمز_اللغة()
        ارجع هذا._رمز_لغة
    نهاية

    دالة رمز_البلد()
        ارجع هذا._رمز_بلد
    نهاية

    دالة الخط()
        ارجع هذا._خط
    نهاية

    دالة الاتجاه()
        # (AR) تحديد اتجاه النص تلقائيًا بناءً على اللغة
        لكل لغة في لغات_يمين_لذيسار
            إذا (هذا._رمز_لغة == لغة)
                ارجع يمين_لذيسار
            نهاية
        نهاية
        ارجع يسار_ليمين
    نهاية

    دالة من_يمين_لذيسار()
        ارجع هذا.الاتجاه() == يمين_لذيسار
    نهاية

    دالة إلى_نص()
        # (AR) مثل Locale.toString في Dart
        متغير ناتج = هذا._رمز_لغة
        إذا (هذا._خط != لاشيء)
            ناتج = ناتج + "_" + هذا._خط
        نهاية
        إذا (هذا._رمز_بلد != لاشيء)
            ناتج = ناتج + "_" + هذا._رمز_بلد
        نهاية
        ارجع ناتج
    نهاية

    دالة رمز_اللغة_فقط()
        # (AR) مطابقة بالغة فقط (بدون بلد أو خط)
        ارجع جديد محلية(هذا._رمز_لغة)
    نهاية

    دالة يساوي(أخرى)
        إذا (أخرى == لاشيء)
            ارجع خطأ
        نهاية
        ارجع هذا._رمز_لغة == أخرى._رمز_لغة و هذا._رمز_بلد == أخرى._رمز_بلد
    نهاية
نهاية

# ─── سجل_محليات (LocaleRegistry) ───
صدّر صنف سجل_محليات
    # (AR) سجل مركزي لجميع اللغات المدعومة في التطبيق
    #      يُستخدم لتسجيل اللغات + المزودين + الاحتياطيات
    # (EN) Central registry of all supported locales in the app
    باني()
        هذا._لغات_مدعومة = []
        هذا._اللغة_الافتراضية = جديد محلية("ar")
        هذا._اللغة_الحالية = لاشيء
        هذا._مزودون = {}
        هذا._مراقبون = []
    نهاية

    دالة أضف_لغة(محلية_جديدة)
        هذا._لغات_مدعومة = هذا._لغات_مدعومة + [محلية_جديدة]
        ارجع هذا
    نهاية

    دالة اللغات_المدعومة()
        ارجع هذا._لغات_مدعومة
    نهاية

    دالة عيّن_الافتراضية(محلية_جديدة)
        هذا._اللغة_الافتراضية = محلية_جديدة
        ارجع هذا
    نهاية

    دالة الافتراضية()
        ارجع هذا._اللغة_الافتراضية
    نهاية

    دالة عيّن_الحالية(محلية_جديدة)
        # (AR) تغيير اللغة الحالية مع إخطار المراقبين
        متغير السابقة = هذا._اللغة_الحالية
        هذا._اللغة_الحالية = محلية_جديدة
        # إخطار المراقبين بتغيير اللغة
        لكل مراقب في هذا._مراقبون
            مراقب.عند_تغيير_لغة(السابقة, محلية_جديدة)
        نهاية
        ارجع هذا
    نهاية

    دالة الحالية()
        إذا (هذا._اللغة_الحالية != لاشيء)
            ارجع هذا._اللغة_الحالية
        نهاية
        ارجع هذا._اللغة_الافتراضية
    نهاية

    دالة سجّل_مزود(رمز, مزود)
        # (AR) تسجيل مزود ترجمات للغة معينة
        هذا._مزودون[رمز] = مزود
        ارجع هذا
    نهاية

    دالة المزود(رمز)
        إذا (هذا._مزودون[رمز] != لاشيء)
            ارجع هذا._مزودون[رمز]
        نهاية
        ارجع لاشيء
    نهاية

    دالة مدعومة(محلية_مطلوبة)
        # (AR) هل اللغة مدعومة
        لكل م في هذا._لغات_مدعومة
            إذا (م.رمز_اللغة() == محلية_مطلوبة.رمز_اللغة())
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    دالة أضف_مراقب(مراقب)
        هذا._مراقبون = هذا._مراقبون + [مراقب]
        ارجع هذا
    نهاية
نهاية

# ─── محلل_محلية (LocaleResolver) ───
صدّر صنف محلل_محلية
    # (AR) حل النزاعات عند طلب لغة غير مدعومة
    #      يبحث عن أقرب لغة مطابقة:
    #      ١. مطابقة كاملة (لغة + بلد)
    #      ٢. مطابقة جزئية (لغة فقط)
    #      ٣. اللغة الافتراضية
    # (EN) Locale conflict resolution — finds closest matching locale
    باني(سجل = لاشيء)
        هذا._سجل = سجل
    نهاية

    دالة حل(محلية_مطلوبة)
        إذا (هذا._سجل == لاشيء)
            ارجع محلية_مطلوبة
        نهاية

        متغير اللغات = هذا._سجل.اللغات_المدعومة()

        # (1) مطابقة كاملة (لغة + بلد)
        لكل م في اللغات
            إذا (م.يساوي(محلية_مطلوبة))
                ارجع م
            نهاية
        نهاية

        # (2) مطابقة جزئية (لغة فقط)
        لكل م في اللغات
            إذا (م.رمز_اللغة() == محلية_مطلوبة.رمز_اللغة())
                ارجع م
            نهاية
        نهاية

        # (3) اللغة الافتراضية
        ارجع هذا._سجل.الافتراضية()
    نهاية
نهاية

# ─── مراقب_محلية (LocaleObserver) ───
صدّر صنف مراقب_محلية
    # (AR) مراقب يُنفَّذ عند تغيير اللغة
    #      يمكن الوراثة منه وتجاوز دالة عند_تغيير_لغة
    # (EN) Observer notified when locale changes
    باني(رد_نداء = لاشيء)
        هذا._رد_نداء = رد_نداء
    نهاية

    دالة عند_تغيير_لغة(سابقة, جديدة)
        إذا (هذا._رد_نداء != لاشيء)
            هذا._رد_نداء(سابقة, جديدة)
        نهاية
    نهاية
نهاية
