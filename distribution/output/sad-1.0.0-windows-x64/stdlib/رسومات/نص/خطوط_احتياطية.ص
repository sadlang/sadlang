# بسم الله الرحمن الرحيم
# ===================================================================
# إصلاح العيب #6: Font Fallback Chain - سلسلة الخطوط الاحتياطية
# ===================================================================

# ─── مزود الخطوط ───
صدّر صنف مزود_خطوط
    باني()
        هذا._خطوط = {}
        هذا._خطوط_احتياطية = []
        هذا._خط_افتراضي = لاشيء
        
        # سجّل الخطوط الأساسية
        هذا._سجّل_خطوط_نظام()
    نهاية

    دالة _سجّل_خطوط_نظام()
        # خطوط عربية
        هذا._خطوط_احتياطية.أضف({
            اسم: "Noto Sans Arabic"،
            عائلة: "Noto Sans Arabic, Arial"،
            نطاقات: [[0x0600، 0x06FF]، [0x0750، 0x077F]]
        })
        
        هذا._خطوط_احتياطية.أضف({
            اسم: "Arial"،
            عائلة: "Arial, sans-serif"،
            نطاقات: [[0x0000، 0x007F]، [0x0080، 0x00FF]]  # Latin
        })
        
        هذا._خطوط_احتياطية.أضف({
            اسم: "Segoe UI Emoji"،
            عائلة: "Segoe UI Emoji, Apple Color Emoji"،
            نطاقات: [[0x1F600، 0x1F64F]، [0x1F300، 0x1F5FF]]  # Emoji
        })
    نهاية

    دالة سجّل_خط(اسم، خط)
        هذا._خطوط[اسم] = خط
    نهاية

    دالة عيّن_افتراضي(اسم)
        هذا._خط_افتراضي = اسم
    نهاية

    دالة جد_خط_لحرف(حرف)
        متغير كود = حرف.كود_يونيكود()
        
        لكل خط في هذا._خطوط_احتياطية
            لكل نطاق في خط.نطاقات
                إذا (كود >= نطاق[0] و كود <= نطاق[1])
                    ارجع خط
                نهاية
            نهاية
        نهاية
        
        # ارجع الخط الافتراضي
        إذا (هذا._خط_افتراضي != لاشيء)
            ارجع هذا._خطوط[هذا._خط_افتراضي]
        نهاية
        
        ارجع هذا._خطوط_احتياطية[0]
    نهاية

    دالة قسّم_نص_حسب_الخط(نص)
        متغير أجزاء = []
        متغير جزء_حالي = {نص: ""، خط: لاشيء}
        
        لكل حرف في نص
            متغير خط = هذا.جد_خط_لحرف(حرف)
            
            إذا (جزء_حالي.خط == لاشيء)
                جزء_حالي.خط = خط
            نهاية
            
            إذا (خط.اسم == جزء_حالي.خط.اسم)
                جزء_حالي.نص += حرف
            وإلا
                إذا (جزء_حالي.نص != "")
                    أجزاء.أضف(جزء_حالي)
                نهاية
                جزء_حالي = {نص: حرف، خط: خط}
            نهاية
        نهاية
        
        إذا (جزء_حالي.نص != "")
            أجزاء.أضف(جزء_حالي)
        نهاية
        
        ارجع أجزاء
    نهاية
نهاية

# ─── ذاكرة الخطوط ───
صدّر صنف ذاكرة_خطوط
    باني(حد)
        هذا._حد = حد أو 100
        هذا._ذاكرة = {}
        هذا._ترتيب = []
    نهاية

    دالة احصل(مفتاح)
        إذا (هذا._ذاكرة[مفتاح] != لاشيء)
            # انقل للنهاية (LRU)
            هذا._ترتيب = هذا._ترتيب.فلتر(لامدا(م) => م != مفتاح)
            هذا._ترتيب.أضف(مفتاح)
            ارجع هذا._ذاكرة[مفتاح]
        نهاية
        ارجع لاشيء
    نهاية

    دالة عيّن(مفتاح، قيمة)
        إذا (هذا._ذاكرة[مفتاح] == لاشيء)
            # جديد
            إذا (هذا._ترتيب.الطول() >= هذا._حد)
                # احذف الأقدم
                متغير أقدم = هذا._ترتيب[0]
                هذا._ترتيب = هذا._ترتيب[1:]
                احذف هذا._ذاكرة[أقدم]
            نهاية
            هذا._ترتيب.أضف(مفتاح)
        وإلا
            # موجود - انقل للنهاية
            هذا._ترتيب = هذا._ترتيب.فلتر(لامدا(م) => م != مفتاح)
            هذا._ترتيب.أضف(مفتاح)
        نهاية
        
        هذا._ذاكرة[مفتاح] = قيمة
    نهاية

    دالة امسح()
        هذا._ذاكرة = {}
        هذا._ترتيب = []
    نهاية
نهاية

# ─── قياس النص ───
صدّر صنف قياس_نص
    باني()
        هذا._مزود = جديد مزود_خطوط()
        هذا._ذاكرة = جديد ذاكرة_خطوط(500)
    نهاية

    دالة قِس(نص، خط، حجم)
        متغير مفتاح = نص + "|" + خط + "|" + حجم
        
        متغير محفوظ = هذا._ذاكرة.احصل(مفتاح)
        إذا (محفوظ != لاشيء)
            ارجع محفوظ
        نهاية
        
        # قس كل جزء
        متغير أجزاء = هذا._مزود.قسّم_نص_حسب_الخط(نص)
        متغير عرض_إجمالي = 0
        متغير ارتفاع_أقصى = 0
        
        لكل جزء في أجزاء
            متغير قياس = هذا._قس_جزء(جزء.نص، جزء.خط، حجم)
            عرض_إجمالي += قياس.عرض
            ارتفاع_أقصى = ماكس(ارتفاع_أقصى، قياس.ارتفاع)
        نهاية
        
        متغير نتيجة = {
            عرض: عرض_إجمالي،
            ارتفاع: ارتفاع_أقصى،
            أجزاء: أجزاء
        }
        
        هذا._ذاكرة.عيّن(مفتاح، نتيجة)
        ارجع نتيجة
    نهاية

    دالة _قس_جزء(نص، خط، حجم)
        # تقدير بسيط - سيتم استبداله بقياس حقيقي
        متغير عرض_حرف_وسطي = حجم * 0.5
        متغير عرض = نص.الطول() * عرض_حرف_وسطي
        
        # العربية أعرض قليلاً
        إذا (هذا._يحتوي_عربي(نص))
            عرض *= 1.1
        نهاية
        
        ارجع {
            عرض: عرض،
            ارتفاع: حجم * 1.2
        }
    نهاية

    دالة _يحتوي_عربي(نص)
        لكل حرف في نص
            متغير كود = حرف.كود_يونيكود()
            إذا (كود >= 0x0600 و كود <= 0x06FF)
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية
نهاية

# ─── رسم النص ───
صدّر صنف راسم_نص
    باني(سياق)
        هذا._سياق = سياق
        هذا._مزود = جديد مزود_خطوط()
        هذا._قياس = جديد قياس_نص()
    نهاية

    دالة ارسم(نص، س، ص، خط، حجم، لون)
        متغير أجزاء = هذا._مزود.قسّم_نص_حسب_الخط(نص)
        متغير موضع_س = س
        
        لكل جزء في أجزاء
            هذا._سياق.عيّن_خط(جزء.خط.عائلة، حجم)
            هذا._سياق.عيّن_لون(لون)
            هذا._سياق.ارسم_نص(جزء.نص، موضع_س، ص)
            
            متغير قياس = هذا._قياس._قس_جزء(جزء.نص، جزء.خط، حجم)
            موضع_س += قياس.عرض
        نهاية
    نهاية

    دالة ارسم_معلّف(نص، س، ص، عرض، خط، حجم، لون)
        متغير كلمات = نص.قسّم(" ")
        متغير سطر_حالي = ""
        متغير موضع_ص = ص
        متغير ارتفاع_سطر = حجم * 1.5
        
        لكل كلمة في كلمات
            متغير اختبار = سطر_حالي == "" ? كلمة : سطر_حالي + " " + كلمة
            متغير قياس = هذا._قياس.قِس(اختبار، خط، حجم)
            
            إذا (قياس.عرض > عرض و سطر_حالي != "")
                # ارسم السطر الحالي
                هذا.ارسم(سطر_حالي، س، موضع_ص، خط، حجم، لون)
                موضع_ص += ارتفاع_سطر
                سطر_حالي = كلمة
            وإلا
                سطر_حالي = اختبار
            نهاية
        نهاية
        
        # ارسم السطر الأخير
        إذا (سطر_حالي != "")
            هذا.ارسم(سطر_حالي، س، موضع_ص، خط، حجم، لون)
        نهاية
    نهاية
نهاية
