صدّر صنف حلقة_لعبة
    باني(إعدادات)
        هذا._FPS_مستهدف = إعدادات.FPS أو 60
        هذا._يعمل = خطأ
        هذا._وقت_آخر_إطار = 0
        هذا._دلتا = 0
        هذا._عند_تحديث = إعدادات.عند_تحديث أو لاشيء
        هذا._عند_رسم = إعدادات.عند_رسم أو لاشيء
        هذا._معالج_إدخال = إعدادات.معالج_إدخال أو لاشيء
    نهاية

    دالة ابدأ()
        هذا._يعمل = صحيح
        هذا._حلقة()
    نهاية

    دالة أوقف()
        هذا._يعمل = خطأ
    نهاية

    دالة _حلقة()
        إذا (!هذا._يعمل)
            ارجع
        نهاية

        متغير الآن = وقت_حالي()
        هذا._دلتا = (الآن - هذا._وقت_آخر_إطار) / 1000
        هذا._وقت_آخر_إطار = الآن

        # معالجة الإدخال
        إذا (هذا._معالج_إدخال)
            هذا._معالج_إدخال()
        نهاية

        # تحديث المنطق
        إذا (هذا._عند_تحديث)
            هذا._عند_تحديث(هذا._دلتا)
        نهاية

        # الرسم
        إذا (هذا._عند_رسم)
            هذا._عند_رسم()
        نهاية

        # جدولة الإطار التالي
        متغير تأخير = (1000 / هذا._FPS_مستهدف) - (وقت_حالي() - الآن)
        إذا (تأخير > 0)
            بعد(تأخير، لامدا() => هذا._حلقة() نهاية)
        وإلا
            هذا._حلقة()
        نهاية
    نهاية

    دالة احصل_دلتا()
        ارجع هذا._دلتا
    نهاية

    دالة احصل_FPS()
        إذا (هذا._دلتا > 0)
            ارجع 1 / هذا._دلتا
        نهاية
        ارجع 0
    نهاية
