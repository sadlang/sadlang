    ساكن دالة احصل_مثيل()
        إذا (مدير_مشاهد._مثيل == لاشيء)
            مدير_مشاهد._مثيل = جديد مدير_مشاهد()
        نهاية
        ارجع مدير_مشاهد._مثيل
    نهاية

    باني()
        هذا._مشاهد = {}
        هذا._مشهد_حالي = لاشيء
        هذا._تاريخ = []
    نهاية

    دالة سجّل_مشهد(اسم، مشهد)
        هذا._مشاهد[اسم] = مشهد
    نهاية

    دالة انتقل_إلى(اسم، احفظ_تاريخ)
        إذا (هذا._مشهد_حالي)
            هذا._مشهد_حالي.عند_خروج()
            إذا (احفظ_تاريخ أو صحيح)
                هذا._تاريخ.أضف(هذا._مشهد_حالي.اسم)
            نهاية
        نهاية

        هذا._مشهد_حالي = هذا._مشاهد[اسم]
        إذا (هذا._مشهد_حالي)
            هذا._مشهد_حالي.عند_دخول()
        نهاية
    نهاية

    دالة رجوع()
        إذا (هذا._تاريخ.الطول() > 0)
            متغير اسم = هذا._تاريخ.احذف_آخر()
            هذا.انتقل_إلى(اسم، خطأ)
        نهاية
    نهاية

    دالة تحديث(دلتا)
        إذا (هذا._مشهد_حالي)
            هذا._مشهد_حالي.تحديث(دلتا)
        نهاية
    نهاية

    دالة ارسم(سياق)
        إذا (هذا._مشهد_حالي)
            هذا._مشهد_حالي.ارسم(سياق)
        نهاية
    نهاية
نهاية

