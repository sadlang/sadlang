# ─── مُعرِّف الإيماءات المخصصة ───
صدّر صنف مُعرِّف_إيماءات
    باني()
        هذا._إيماءات = []
    نهاية

    دالة أضف_إيماءة(إيماءة)
        هذا._إيماءات.أضف(إيماءة)
        ارجع هذا
    نهاية

    دالة عالج_حدث(حدث)
        لكل إ في هذا._إيماءات
            إ.عالج(حدث)
        نهاية
    نهاية
نهاية

# ─── إيماءة مخصصة (Base Class) ───
صدّر صنف إيماءة_مخصصة
    باني(اسم)
        هذا._اسم = اسم
        هذا._حالة = "جاهز"
        هذا._عند_التعرف = لاشيء
    نهاية

    دالة عالج(حدث)
        # يُنفذ في الأصناف الفرعية
    نهاية

    دالة عند_التعرف(دالة_رد)
        هذا._عند_التعرف = دالة_رد
        ارجع هذا
    نهاية
نهاية

# ─── إيماءة الضغطتين (Two Finger Tap) ───
صدّر صنف إيماءة_ضغطتين يرث إيماءة_مخصصة
    باني()
        الأساس("ضغطتين")
        هذا._عدد_الأصابع = 0
    نهاية

    دالة عالج(حدث)
        إذا (حدث.نوع == "أصبع_لأسفل")
            هذا._عدد_الأصابع += 1
        وإلا إذا (حدث.نوع == "أصبع_لأعلى")
            إذا (هذا._عدد_الأصابع == 2)
                إذا (هذا._عند_التعرف != لاشيء)
                    هذا._عند_التعرف()
                نهاية
            نهاية
            هذا._عدد_الأصابع = 0
        نهاية
    نهاية
نهاية

# ─── إيماءة التدوير (Rotation) ───
صدّر صنف إيماءة_تدوير يرث إيماءة_مخصصة
    باني()
        الأساس("تدوير")
        هذا._زاوية = 0.0
    نهاية

    دالة الزاوية()
        ارجع هذا._زاوية
    نهاية

    دالة عالج(حدث)
        إذا (حدث.نوع == "تدوير")
            هذا._زاوية = حدث.زاوية
            إذا (هذا._عند_التعرف != لاشيء)
                هذا._عند_التعرف(هذا._زاوية)
            نهاية
        نهاية
    نهاية
نهاية

# ─── إيماءة السحب السريع (Swipe/Fling) ───
صدّر صنف إيماءة_سحب_سريع يرث إيماءة_مخصصة
    باني(اتجاه = "أفقي"، عتبة_سرعة = 100)
        الأساس("سحب_سريع")
        هذا._اتجاه = اتجاه
        هذا._عتبة_سرعة = عتبة_سرعة
    نهاية

    دالة عالج(حدث)
        إذا (حدث.نوع == "نهاية_سحب")
            متغير سرعة = حدث.سرعة
            متغير س = سرعة["س"]
            متغير ص = سرعة["ص"]
            
            إذا (هذا._اتجاه == "أفقي")
                إذا (|س| > هذا._عتبة_سرعة)
                    متغير يمين = س > 0
                    إذا (هذا._عند_التعرف != لاشيء)
                        هذا._عند_التعرف(يمين ? "يمين" : "يسار")
                    نهاية
                نهاية
            وإلا
                إذا (|ص| > هذا._عتبة_سرعة)
                    متغير أسفل = ص > 0
                    إذا (هذا._عند_التعرف != لاشيء)
                        هذا._عند_التعرف(أسفل ? "أسفل" : "أعلى")
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية
نهاية

