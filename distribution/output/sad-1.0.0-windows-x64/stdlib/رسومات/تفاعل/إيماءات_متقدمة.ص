# نظام الإيماءات المتقدم - Sad UI Gesture System
# ===================================================================
# الإصدار: 3.0.0
# تاريخ الإنشاء: 18 مارس 2026
# 
# الوصف:
#   نظام شامل للتعامل مع إيماءات اللمس والفأرة يدعم:
#   - النقر (tap) المفرد والمزدوج والطويل
#   - السحب (drag) الأفقي والعمودي والحر
#   - التحجيم (pinch/scale) والتدوير (rotation)
#   - السحب والإفلات (drag & drop)
#   - إيماءات مخصصة (custom gestures)
#
# الاستخدام:
#   ```ص
#   استورد * من رسومات.تفاعل.إيماءات_متقدمة
#   
#   متغير كاشف = جديد كاشف_إيماءات(
#       النص("انقر هنا")،
#       عند_النقر: لامدا() => اطبع("تم النقر!")
#   )
#   ```
#
# التصدير:
#   - تفاصيل_نقر، تفاصيل_سحب، تفاصيل_تحجيم، تفاصيل_سرعة
#   - كاشف_إيماءات
#   - قابل_للسحب، هدف_سحب، قابل_للسحب_بنقرة_طويلة
#   - مُعرِّف_إيماءات، إيماءة_مخصصة
#   - إيماءة_ضغطتين، إيماءة_تدوير، إيماءة_سحب_سريع
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── تفاصيل النقر ───
صدّر صنف تفاصيل_نقر
    باني(موضع_محلي، موضع_عام)
        هذا.موضع_محلي = موضع_محلي
        هذا.موضع_عام = موضع_عام
        هذا.نوع = "نقر"
    نهاية
نهاية

# ─── تفاصيل السحب ───
صدّر صنف تفاصيل_سحب
    باني()
        هذا.إزاحة = {"س": 0، "ص": 0}
        هذا.سرعة = {"س": 0، "ص": 0}
        هذا.دلتا = {"س": 0، "ص": 0}
        هذا.موضع_محلي = {"س": 0، "ص": 0}
        هذا.موضع_عام = {"س": 0، "ص": 0}
    نهاية

    دالة الإزاحة_س()
        ارجع هذا.إزاحة["س"]
    نهاية

    دالة الإزاحة_ص()
        ارجع هذا.إزاحة["ص"]
    نهاية
نهاية

# ─── تفاصيل التحجيم ───
صدّر صنف تفاصيل_تحجيم
    باني()
        هذا.مقياس = 1.0
        هذا.مقياس_أفقي = 1.0
        هذا.مقياس_عمودي = 1.0
        هذا.نقطة_بؤرية = {"س": 0، "ص": 0}
        هذا.نقطة_بؤرية_محلية = {"س": 0، "ص": 0}
        هذا.دوران = 0.0
        هذا.عدد_المؤشرات = 0
    نهاية
نهاية

# ─── تفاصيل السرعة ───
صدّر صنف تفاصيل_سرعة
    باني(سرعة)
        هذا.بكسل_في_الثانية = سرعة
    نهاية

    دالة السرعة_س()
        ارجع هذا.بكسل_في_الثانية["س"]
    نهاية

    دالة السرعة_ص()
        ارجع هذا.بكسل_في_الثانية["ص"]
    نهاية
نهاية

