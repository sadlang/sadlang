استورد * من رسومات.أساس.عنصر

# ─── عقدة التركيز (FocusNode) ───
صدّر صنف عقدة_تركيز
    باني(
        اسم_تصحيح = لاشيء،
        عند_تغير_التركيز = لاشيء،
        عند_حدث_مفتاح = لاشيء،
        يتخطى_تنقل = خطأ،
        قابل_للتركيز = صحيح،
        يمكن_طلب_التركيز = صحيح
    )
        هذا._اسم = اسم_تصحيح
        هذا._عند_تغير_التركيز = عند_تغير_التركيز
        هذا._عند_حدث_مفتاح = عند_حدث_مفتاح
        هذا._يتخطى_تنقل = يتخطى_تنقل
        هذا._قابل_للتركيز = قابل_للتركيز
        هذا._يمكن_طلب_التركيز = يمكن_طلب_التركيز
        
        هذا._مركّز = خطأ
        هذا._أب = لاشيء
        هذا._أبناء = []
        هذا._سياق = لاشيء
        هذا._مستمعون = []
    نهاية

    # ─── الخصائص ───
    دالة مركّز()
        ارجع هذا._مركّز
    نهاية

    دالة لديه_تركيز()
        ارجع هذا._مركّز
    نهاية

    دالة لديه_تركيز_فرعي()
        لكل ابن في هذا._أبناء
            إذا (ابن.لديه_تركيز() أو ابن.لديه_تركيز_فرعي())
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    دالة قابل_للتركيز()
        ارجع هذا._قابل_للتركيز
    نهاية

    # ─── طلب/إزالة التركيز ───
    دالة اطلب_التركيز()
        إذا (ليس هذا._يمكن_طلب_التركيز أو ليس هذا._قابل_للتركيز)
            ارجع
        نهاية
        مدير_التركيز.النسخة().عيّن_التركيز(هذا)
    نهاية

    دالة أزل_التركيز(تجاهل_الأبناء = خطأ)
        إذا (ليس هذا._مركّز)
            ارجع
        نهاية
        
        إذا (تجاهل_الأبناء)
            لكل ابن في هذا._أبناء
                ابن.أزل_التركيز(صحيح)
            نهاية
        نهاية
        
        مدير_التركيز.النسخة().أزل_التركيز(هذا)
    نهاية

    دالة التالي_في_الترتيب()
        ارجع مدير_التركيز.النسخة().التالي(هذا)
    نهاية

    دالة السابق_في_الترتيب()
        ارجع مدير_التركيز.النسخة().السابق(هذا)
    نهاية

    # ─── الشجرة ───
    دالة أضف_ابن(عقدة)
        عقدة._أب = هذا
        هذا._أبناء.أضف(عقدة)
    نهاية

    دالة أزل_ابن(عقدة)
        عقدة._أب = لاشيء
        هذا._أبناء.أزل(عقدة)
    نهاية

    # ─── المستمعون ───
    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة أزل_مستمع(مستمع)
        هذا._مستمعون.أزل(مستمع)
    نهاية

    دالة _أبلغ_المستمعين()
        لكل م في هذا._مستمعون
            م()
        نهاية
        
        إذا (هذا._عند_تغير_التركيز != لاشيء)
            هذا._عند_تغير_التركيز(هذا._مركّز)
        نهاية
    نهاية

    # ─── معالجة الأحداث ───
    دالة عالج_حدث_مفتاح(حدث)
        إذا (هذا._عند_حدث_مفتاح != لاشيء)
            ارجع هذا._عند_حدث_مفتاح(هذا، حدث)
        نهاية
        ارجع "لم_يُعالج"
    نهاية

    دالة تخلص()
        هذا.أزل_التركيز()
        إذا (هذا._أب != لاشيء)
            هذا._أب.أزل_ابن(هذا)
        نهاية
        هذا._مستمعون = []
    نهاية
نهاية

# ─── نطاق التركيز (FocusScope) ───
صدّر صنف نطاق_تركيز يرث عقدة_تركيز
    باني(اسم_تصحيح = لاشيء)
        الأساس(اسم_تصحيح)
        هذا._ابن_مركّز = لاشيء
    نهاية

    دالة عيّن_أول_تركيز()
        إذا (هذا._أبناء.الطول() > 0)
            هذا._أبناء[0].اطلب_التركيز()
        نهاية
    نهاية

    دالة الابن_المركّز()
        ارجع هذا._ابن_مركّز
    نهاية
نهاية

# ─── مدير التركيز (Singleton) ───
صدّر صنف مدير_تركيز
    ساكن متغير _نسخة = لاشيء

    ساكن دالة النسخة()
        إذا (_نسخة == لاشيء)
            _نسخة = جديد مدير_تركيز()
        نهاية
        ارجع _نسخة
    نهاية

    باني()
        هذا._جذر = جديد نطاق_تركيز("الجذر")
        هذا._مركّز_حالياً = لاشيء
        هذا._تاريخ = []
    نهاية

    # ─── التركيز الحالي ───
    دالة المركّز_الحالي()
        ارجع هذا._مركّز_حالياً
    نهاية

    دالة عيّن_التركيز(عقدة)
        إذا (هذا._مركّز_حالياً == عقدة)
            ارجع
        نهاية

        # إزالة التركيز من السابق
        إذا (هذا._مركّز_حالياً != لاشيء)
            هذا._مركّز_حالياً._مركّز = خطأ
            هذا._مركّز_حالياً._أبلغ_المستمعين()
            هذا._تاريخ.أضف(هذا._مركّز_حالياً)
        نهاية

        # تعيين التركيز الجديد
        هذا._مركّز_حالياً = عقدة
        إذا (عقدة != لاشيء)
            عقدة._مركّز = صحيح
            عقدة._أبلغ_المستمعين()
        نهاية
    نهاية

    دالة أزل_التركيز(عقدة)
        إذا (هذا._مركّز_حالياً == عقدة)
            هذا._مركّز_حالياً._مركّز = خطأ
            هذا._مركّز_حالياً._أبلغ_المستمعين()
            هذا._مركّز_حالياً = لاشيء
        نهاية
    نهاية

    # ─── التنقل بالتبويب ───
    دالة التالي(من = لاشيء)
        متغير قائمة = هذا._اجمع_القابلين_للتركيز()
        إذا (قائمة.الطول() == 0)
            ارجع لاشيء
        نهاية
        
        متغير فهرس = 0
        إذا (من != لاشيء)
            فهرس = قائمة.فهرس(من)
            إذا (فهرس == -1)
                فهرس = 0
            وإلا
                فهرس = (فهرس + 1) % قائمة.الطول()
            نهاية
        نهاية
        
        ارجع قائمة[فهرس]
    نهاية

    دالة السابق(من = لاشيء)
        متغير قائمة = هذا._اجمع_القابلين_للتركيز()
        إذا (قائمة.الطول() == 0)
            ارجع لاشيء
        نهاية
        
        متغير فهرس = قائمة.الطول() - 1
        إذا (من != لاشيء)
            فهرس = قائمة.فهرس(من)
            إذا (فهرس == -1)
                فهرس = قائمة.الطول() - 1
            وإلا
                فهرس = (فهرس - 1 + قائمة.الطول()) % قائمة.الطول()
            نهاية
        نهاية
        
        ارجع قائمة[فهرس]
    نهاية

    دالة انتقل_للتالي()
        متغير التالي = هذا.التالي(هذا._مركّز_حالياً)
        إذا (التالي != لاشيء)
            التالي.اطلب_التركيز()
        نهاية
    نهاية

    دالة انتقل_للسابق()
        متغير السابق = هذا.السابق(هذا._مركّز_حالياً)
        إذا (السابق != لاشيء)
            السابق.اطلب_التركيز()
        نهاية
    نهاية

    دالة _اجمع_القابلين_للتركيز()
        متغير قائمة = []
        هذا._اجمع_من_عقدة(هذا._جذر، قائمة)
        ارجع قائمة
    نهاية

    دالة _اجمع_من_عقدة(عقدة، قائمة)
        إذا (عقدة._قابل_للتركيز و ليس عقدة._يتخطى_تنقل)
            قائمة.أضف(عقدة)
        نهاية
        لكل ابن في عقدة._أبناء
            هذا._اجمع_من_عقدة(ابن، قائمة)
        نهاية
    نهاية

    # ─── معالجة أحداث لوحة المفاتيح ───
    دالة عالج_حدث_مفتاح(حدث)
        # Tab للتنقل
        إذا (حدث.مفتاح == "Tab")
            إذا (حدث.مع_Shift)
                هذا.انتقل_للسابق()
            وإلا
                هذا.انتقل_للتالي()
            نهاية
            ارجع "عولج"
        نهاية

        # مرر للعقدة المركزّة
        إذا (هذا._مركّز_حالياً != لاشيء)
            ارجع هذا._مركّز_حالياً.عالج_حدث_مفتاح(حدث)
        نهاية

        ارجع "لم_يُعالج"
    نهاية

    دالة الجذر()
        ارجع هذا._جذر
    نهاية
نهاية

# ─── عنصر التركيز (Focus Widget) ───
صدّر صنف تركيز يرث عنصر
    باني(
        ابن،
        عقدة_تركيز = لاشيء،
        تركيز_تلقائي = خطأ،
        عند_تغير_التركيز = لاشيء،
        عند_حدث_مفتاح = لاشيء،
        يتخطى_تنقل = خطأ،
        قابل_للتركيز = صحيح
    )
        هذا._نوع = "تركيز"
        هذا._ابن = ابن
        هذا._عقدة = عقدة_تركيز أو جديد عقدة_تركيز(
            عند_تغير_التركيز = عند_تغير_التركيز،
            عند_حدث_مفتاح = عند_حدث_مفتاح،
            يتخطى_تنقل = يتخطى_تنقل،
            قابل_للتركيز = قابل_للتركيز
        )
        هذا._تركيز_تلقائي = تركيز_تلقائي
    نهاية

    دالة العقدة()
        ارجع هذا._عقدة
    نهاية
نهاية

# ─── نطاق التركيز (FocusScope Widget) ───
صدّر صنف عنصر_نطاق_تركيز يرث عنصر
    باني(
        ابن،
        عقدة = لاشيء،
        تركيز_تلقائي = خطأ
    )
        هذا._نوع = "نطاق_تركيز"
        هذا._ابن = ابن
        هذا._عقدة = عقدة أو جديد نطاق_تركيز()
        هذا._تركيز_تلقائي = تركيز_تلقائي
    نهاية

    دالة العقدة()
        ارجع هذا._عقدة
    نهاية

    ساكن دالة من(سياق)
        # البحث عن أقرب نطاق تركيز
        متغير حالي = سياق
        بينما (حالي != لاشيء)
            إذا (حالي.النوع() == "نطاق_تركيز")
                ارجع حالي.العقدة()
            نهاية
            حالي = حالي.الأب()
        نهاية
        ارجع مدير_التركيز.النسخة().الجذر()
    نهاية
نهاية

# ─── اختصارات لوحة المفاتيح ───
صدّر صنف اختصارات يرث عنصر
    باني(ابن، اختصارات)
        هذا._نوع = "اختصارات"
        هذا._ابن = ابن
        هذا._اختصارات = اختصارات
    نهاية
نهاية

صدّر صنف اختصار
    باني(مفتاح، معدّلات = [])
        هذا.مفتاح = مفتاح
        هذا.معدّلات = معدّلات
    نهاية

    دالة يطابق(حدث)
        إذا (حدث.مفتاح != هذا.مفتاح)
            ارجع خطأ
        نهاية
        
        لكل م في هذا.معدّلات
            إذا (م == "ctrl" و ليس حدث.مع_Ctrl)
                ارجع خطأ
            نهاية
            إذا (م == "shift" و ليس حدث.مع_Shift)
                ارجع خطأ
            نهاية
            إذا (م == "alt" و ليس حدث.مع_Alt)
                ارجع خطأ
            نهاية
        نهاية
        
        ارجع صحيح
    نهاية
نهاية
