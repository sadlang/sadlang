# ===================================================================
# نظام التصيير — Rendering System
# ===================================================================
# طبقة التصيير المنخفض المستوى (RenderObjects)
# مطابق لـ flutter/rendering/
#
# الاستخدام:
#   استورد * من رسومات.تصيير_نظام.تصيير
# ===================================================================

# ─── صندوق_تصيير (RenderBox) ───
صدّر صنف صندوق_تصيير
    باني()
        هذا._قيود = لاشيء
        هذا._حجم = لاشيء
        هذا._موقع = {"س": 0, "ص": 0}
        هذا._أبناء = []
        هذا._يحتاج_رسم = صحيح
        هذا._يحتاج_تخطيط = صحيح
    نهاية

    دالة تنفيذ_تخطيط()
        هذا._يحتاج_تخطيط = خطأ
    نهاية

    دالة رسم(سياق)
        هذا._يحتاج_رسم = خطأ
    نهاية

    دالة اختبار_نقر(موقع)
        ارجع صحيح
    نهاية

    دالة حصل_حجم()
        ارجع هذا._حجم
    نهاية

    دالة عيّن_حجم(حجم)
        هذا._حجم = حجم
    نهاية

    دالة علم_يحتاج_رسم()
        هذا._يحتاج_رسم = صحيح
    نهاية

    دالة علم_يحتاج_تخطيط()
        هذا._يحتاج_تخطيط = صحيح
    نهاية
نهاية

# ─── قيود_صندوق (BoxConstraints) ───
صدّر صنف قيود_صندوق
    باني(حد_أدنى_عرض = 0, حد_أقصى_عرض = 99999, حد_أدنى_ارتفاع = 0, حد_أقصى_ارتفاع = 99999)
        هذا._حد_أدنى_عرض = حد_أدنى_عرض
        هذا._حد_أقصى_عرض = حد_أقصى_عرض
        هذا._حد_أدنى_ارتفاع = حد_أدنى_ارتفاع
        هذا._حد_أقصى_ارتفاع = حد_أقصى_ارتفاع
    نهاية

    دالة ضيّق(حجم)
        ارجع جديد قيود_صندوق(
            هذا._حد_أدنى_عرض,
            حجم["عرض"],
            هذا._حد_أدنى_ارتفاع,
            حجم["ارتفاع"]
        )
    نهاية

    دالة غير_محدود()
        ارجع هذا._حد_أقصى_عرض == 99999 و هذا._حد_أقصى_ارتفاع == 99999
    نهاية

    دالة محدد()
        ارجع هذا._حد_أقصى_عرض < 99999 و هذا._حد_أقصى_ارتفاع < 99999
    نهاية
نهاية

# ─── حجم (Size) ───
صدّر صنف حجم
    باني(عرض = 0, ارتفاع = 0)
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
    نهاية

    دالة العرض()
        ارجع هذا._عرض
    نهاية

    دالة الارتفاع()
        ارجع هذا._ارتفاع
    نهاية
نهاية

# ─── إزاحة (Offset) ───
صدّر صنف إزاحة
    باني(دس = 0, دص = 0)
        هذا._دس = دس
        هذا._دص = دص
    نهاية

    دالة السينية()
        ارجع هذا._دس
    نهاية

    دالة الصادية()
        ارجع هذا._دص
    نهاية
نهاية

# ─── مستطيل (Rect) ───
صدّر صنف مستطيل
    باني(يسار = 0, أعلى = 0, عرض = 0, ارتفاع = 0)
        هذا._يسار = يسار
        هذا._أعلى = أعلى
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
    نهاية

    دالة يحتوي(نقطة)
        ارجع نقطة["س"] >= هذا._يسار و نقطة["س"] <= هذا._يسار + هذا._عرض و نقطة["ص"] >= هذا._أعلى و نقطة["ص"] <= هذا._أعلى + هذا._ارتفاع
    نهاية

    دالة اليمين()
        ارجع هذا._يسار + هذا._عرض
    نهاية

    دالة الأسفل()
        ارجع هذا._أعلى + هذا._ارتفاع
    نهاية

    دالة المركز()
        ارجع {"س": هذا._يسار + هذا._عرض / 2, "ص": هذا._أعلى + هذا._ارتفاع / 2}
    نهاية
نهاية

# ─── خط_أنابيب_التصيير (RenderPipeline) ───
صدّر صنف خط_أنابيب
    باني()
        هذا._عقدة_جذر = لاشيء
        هذا._يحتاج_تركيب = خطأ
    نهاية

    دالة عيّن_الجذر(عقدة)
        هذا._عقدة_جذر = عقدة
    نهاية

    دالة تخطيط()
        إذا (هذا._عقدة_جذر != لاشيء)
            هذا._عقدة_جذر.تنفيذ_تخطيط()
        نهاية
    نهاية

    دالة رسم()
        إذا (هذا._عقدة_جذر != لاشيء)
            هذا._عقدة_جذر.رسم(لاشيء)
        نهاية
    نهاية

    دالة إطار()
        هذا.تخطيط()
        هذا.رسم()
    نهاية
نهاية

# ─── طبقة (Layer) ───
صدّر صنف طبقة
    باني(نوع = "تحويل")
        هذا._نوع = نوع
        هذا._أبناء = []
        هذا._تحويل = لاشيء
        هذا._مقطع = لاشيء
        هذا._شفافية = 1.0
    نهاية

    دالة أضف_ابن(ابن)
        هذا._أبناء = هذا._أبناء + [ابن]
    نهاية
نهاية

# ─── سياق_رسم (PaintingContext) ───
صدّر صنف سياق_رسم
    باني(لوحة_رسم = لاشيء)
        هذا._لوحة = لوحة_رسم
        هذا._طبقة_حالية = لاشيء
    نهاية

    دالة ارسم_ابن(ابن, إزاحة)
        ابن.رسم(هذا)
    نهاية

    دالة ادفع_طبقة(طبقة)
        هذا._طبقة_حالية = طبقة
    نهاية

    دالة اسحب_طبقة()
        هذا._طبقة_حالية = لاشيء
    نهاية
نهاية
