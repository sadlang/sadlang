# بسم الله الرحمن الرحيم
# ===================================================================
# إصلاح العيب #1: Tree Diffing Algorithm
# ===================================================================
# نظام مقارنة الشجرة الذكي - يحدث فقط العناصر المتغيرة
# الإصدار: 2.0.0 (محسّن في الحلقة 2)
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── ثوابت ───
ثابت أقصى_عمق = 100
ثابت أقصى_عمليات = 10000

# ─── خوارزمية المقارنة ───
صدّر صنف خوارزمية_مقارنة
    باني(إعدادات)
        هذا._عمليات = []
        هذا._إعدادات = إعدادات أو {}
        هذا._أقصى_عمق = هذا._إعدادات.أقصى_عمق أو أقصى_عمق
        هذا._أقصى_عمليات = هذا._إعدادات.أقصى_عمليات أو أقصى_عمليات
        هذا._إحصائيات = {
            عقد_مقارنة: 0،
            خصائص_مقارنة: 0،
            وقت_البدء: 0،
            وقت_الانتهاء: 0
        }
    نهاية

    دالة احصل_إحصائيات()
        ارجع هذا._إحصائيات
    نهاية

    # مقارنة شجرتين وإنتاج قائمة التغييرات
    دالة قارن(قديم، جديد)
        هذا._عمليات = []
        هذا._إحصائيات.عقد_مقارنة = 0
        هذا._إحصائيات.خصائص_مقارنة = 0
        هذا._إحصائيات.وقت_البدء = الآن()
        
        حاول
            هذا._قارن_عقدة(قديم، جديد، []، 0)
        امسك (خطأ)
            اطبع_سطر("خطأ في المقارنة: " + خطأ)
        أخيراً
            هذا._إحصائيات.وقت_الانتهاء = الآن()
        نهاية
        
        ارجع هذا._عمليات
    نهاية

    # حساب وقت المقارنة بالمللي ثانية
    دالة وقت_المقارنة()
        ارجع هذا._إحصائيات.وقت_الانتهاء - هذا._إحصائيات.وقت_البدء
    نهاية

    دالة _قارن_عقدة(قديم، جديد، مسار، عمق)
        # تحقق من حدود الأمان
        إذا (عمق > هذا._أقصى_عمق)
            ارمي "تجاوز الحد الأقصى للعمق: " + هذا._أقصى_عمق
        نهاية
        
        إذا (هذا._عمليات.الطول() > هذا._أقصى_عمليات)
            ارمي "تجاوز الحد الأقصى للعمليات: " + هذا._أقصى_عمليات
        نهاية
        
        هذا._إحصائيات.عقد_مقارنة += 1
        
        # حالة: كلاهما لاشيء
        إذا (قديم == لاشيء و جديد == لاشيء)
            ارجع
        نهاية

        # حالة: إضافة جديد
        إذا (قديم == لاشيء)
            هذا._عمليات.أضف({
                نوع: "إضافة"،
                مسار: مسار،
                قيمة: جديد
            })
            ارجع
        نهاية

        # حالة: حذف قديم
        إذا (جديد == لاشيء)
            هذا._عمليات.أضف({
                نوع: "حذف"،
                مسار: مسار
            })
            ارجع
        نهاية

        # حالة: نوع مختلف - استبدال كامل
        إذا (قديم._نوع != جديد._نوع)
            هذا._عمليات.أضف({
                نوع: "استبدال"،
                مسار: مسار،
                قيمة: جديد
            })
            ارجع
        نهاية

        # حالة: نفس النوع - قارن الخصائص
        هذا._قارن_خصائص(قديم، جديد، مسار)

        # قارن الأبناء
        هذا._قارن_أبناء(قديم، جديد، مسار)
    نهاية

    دالة _قارن_خصائص(قديم، جديد، مسار)
        متغير خصائص_قديم = قديم._خصائص أو {}
        متغير خصائص_جديد = جديد._خصائص أو {}

        # خصائص متغيرة أو جديدة
        لكل مفتاح في خصائص_جديد
            إذا (خصائص_قديم[مفتاح] != خصائص_جديد[مفتاح])
                هذا._عمليات.أضف({
                    نوع: "تحديث_خاصية"،
                    مسار: مسار،
                    خاصية: مفتاح،
                    قيمة: خصائص_جديد[مفتاح]
                })
            نهاية
        نهاية

        # خصائص محذوفة
        لكل مفتاح في خصائص_قديم
            إذا (خصائص_جديد[مفتاح] == لاشيء)
                هذا._عمليات.أضف({
                    نوع: "حذف_خاصية"،
                    مسار: مسار،
                    خاصية: مفتاح
                })
            نهاية
        نهاية
    نهاية

    دالة _قارن_أبناء(قديم، جديد، مسار)
        متغير أبناء_قديم = قديم._أبناء أو []
        متغير أبناء_جديد = جديد._أبناء أو []

        متغير أقصى = ماكس(أبناء_قديم.الطول()، أبناء_جديد.الطول())

        لكل ي في نطاق(0، أقصى)
            متغير ابن_قديم = ي < أبناء_قديم.الطول() ? أبناء_قديم[ي] : لاشيء
            متغير ابن_جديد = ي < أبناء_جديد.الطول() ? أبناء_جديد[ي] : لاشيء
            
            هذا._قارن_عقدة(ابن_قديم، ابن_جديد، مسار + [ي])
        نهاية
    نهاية
نهاية

# ─── مطبّق التغييرات ───
صدّر صنف مطبق_تغييرات
    باني(جذر)
        هذا._جذر = جذر
    نهاية

    دالة طبّق(عمليات)
        لكل عملية في عمليات
            طابق (عملية.نوع)
                عندما "إضافة":
                    هذا._أضف(عملية.مسار، عملية.قيمة)
                عندما "حذف":
                    هذا._احذف(عملية.مسار)
                عندما "استبدال":
                    هذا._استبدل(عملية.مسار، عملية.قيمة)
                عندما "تحديث_خاصية":
                    هذا._حدث_خاصية(عملية.مسار، عملية.خاصية، عملية.قيمة)
                عندما "حذف_خاصية":
                    هذا._احذف_خاصية(عملية.مسار، عملية.خاصية)
            نهاية
        نهاية
    نهاية

    دالة _جد_عقدة(مسار)
        متغير عقدة = هذا._جذر
        لكل فهرس في مسار
            عقدة = عقدة._أبناء[فهرس]
        نهاية
        ارجع عقدة
    نهاية

    دالة _أضف(مسار، قيمة)
        متغير أب = هذا._جد_عقدة(مسار[:-1])
        متغير فهرس = مسار[-1]
        أب._أبناء.أدخل(فهرس، قيمة)
    نهاية

    دالة _احذف(مسار)
        متغير أب = هذا._جد_عقدة(مسار[:-1])
        متغير فهرس = مسار[-1]
        أب._أبناء.أزل_عند(فهرس)
    نهاية

    دالة _استبدل(مسار، قيمة)
        متغير أب = هذا._جد_عقدة(مسار[:-1])
        متغير فهرس = مسار[-1]
        أب._أبناء[فهرس] = قيمة
    نهاية

    دالة _حدث_خاصية(مسار، خاصية، قيمة)
        متغير عقدة = هذا._جد_عقدة(مسار)
        عقدة._خصائص[خاصية] = قيمة
    نهاية

    دالة _احذف_خاصية(مسار، خاصية)
        متغير عقدة = هذا._جد_عقدة(مسار)
        احذف عقدة._خصائص[خاصية]
    نهاية
نهاية

# ─── مدير التحديثات الذكي ───
صدّر صنف مدير_تحديثات_ذكي
    باني()
        هذا._شجرة_حالية = لاشيء
        هذا._خوارزمية = جديد خوارزمية_مقارنة()
    نهاية

    دالة حدّث(شجرة_جديدة)
        إذا (هذا._شجرة_حالية == لاشيء)
            هذا._شجرة_حالية = شجرة_جديدة
            ارجع {نوع: "بناء_كامل"، شجرة: شجرة_جديدة}
        نهاية

        متغير تغييرات = هذا._خوارزمية.قارن(هذا._شجرة_حالية، شجرة_جديدة)
        
        إذا (تغييرات.الطول() == 0)
            ارجع {نوع: "لا_تغييرات"}
        نهاية

        هذا._شجرة_حالية = شجرة_جديدة
        
        ارجع {
            نوع: "تحديث_جزئي"،
            تغييرات: تغييرات،
            عدد_التغييرات: تغييرات.الطول()
        }
    نهاية
نهاية

# ─── إحصائيات الأداء ───
صدّر صنف إحصائيات_مقارنة
    ساكن متغير إجمالي_مقارنات = 0
    ساكن متغير إجمالي_تغييرات = 0
    ساكن متغير مقارنات_محفوظة = 0

    ساكن دالة سجّل_مقارنة(عدد_تغييرات، حجم_شجرة)
        إحصائيات_مقارنة.إجمالي_مقارنات += 1
        إحصائيات_مقارنة.إجمالي_تغييرات += عدد_تغييرات
        إحصائيات_مقارنة.مقارنات_محفوظة += (حجم_شجرة - عدد_تغييرات)
    نهاية

    ساكن دالة احصل_نسبة_توفير()
        إذا (إحصائيات_مقارنة.إجمالي_مقارنات == 0)
            ارجع 0
        نهاية
        متغير إجمالي = إحصائيات_مقارنة.مقارنات_محفوظة + إحصائيات_مقارنة.إجمالي_تغييرات
        ارجع (إحصائيات_مقارنة.مقارنات_محفوظة / إجمالي) * 100
    نهاية
نهاية
