# إصلاح العيب #2: Virtual Scrolling - التمرير الافتراضي
# ===================================================================
# تمرير ذكي يعرض فقط العناصر المرئية
# ===================================================================

# ─── منطقة العرض ───
صدّر صنف منطقة_عرض
    باني(بداية، نهاية، ارتفاع_عنصر)
        هذا.بداية = بداية
        هذا.نهاية = نهاية
        هذا.ارتفاع_عنصر = ارتفاع_عنصر
    نهاية

    دالة احسب_فهرس_أول()
        ارجع اقسم_صحيح(هذا.بداية، هذا.ارتفاع_عنصر)
    نهاية

    دالة احسب_فهرس_آخر(إجمالي)
        متغير آخر = اقسم_صحيح(هذا.نهاية، هذا.ارتفاع_عنصر) + 1
        ارجع مين(آخر، إجمالي)
    نهاية
نهاية

# ─── التمرير الافتراضي ───
صدّر صنف تمرير_افتراضي
    باني(إعدادات)
        هذا._ارتفاع_عنصر = إعدادات.ارتفاع_عنصر أو 50
        هذا._ارتفاع_حاوية = إعدادات.ارتفاع_حاوية أو 400
        هذا._هامش_تحميل = إعدادات.هامش أو 5
        هذا._موضع_تمرير = 0
        هذا._عناصر = []
        هذا._عناصر_مرئية = []
        هذا._باني_عنصر = إعدادات.باني_عنصر أو لاشيء
        
        # مخزن العناصر المعاد تدويرها
        هذا._مخزن = []
        هذا._أقصى_مخزن = 20
    نهاية

    دالة عيّن_بيانات(عناصر)
        هذا._عناصر = عناصر
        هذا._حدث_المرئية()
    نهاية

    دالة مرر_إلى(موضع)
        هذا._موضع_تمرير = ماكس(0، موضع)
        هذا._حدث_المرئية()
    نهاية

    دالة مرر_بمقدار(دلتا)
        هذا.مرر_إلى(هذا._موضع_تمرير + دلتا)
    نهاية

    دالة _حدث_المرئية()
        متغير منطقة = جديد منطقة_عرض(
            هذا._موضع_تمرير - (هذا._هامش_تحميل * هذا._ارتفاع_عنصر)،
            هذا._موضع_تمرير + هذا._ارتفاع_حاوية + (هذا._هامش_تحميل * هذا._ارتفاع_عنصر)،
            هذا._ارتفاع_عنصر
        )

        متغير فهرس_أول = ماكس(0، منطقة.احسب_فهرس_أول())
        متغير فهرس_آخر = منطقة.احسب_فهرس_آخر(هذا._عناصر.الطول())

        # أعد تدوير العناصر غير المرئية
        لكل عنصر في هذا._عناصر_مرئية
            إذا (عنصر.فهرس < فهرس_أول أو عنصر.فهرس >= فهرس_آخر)
                هذا._أعد_للمخزن(عنصر)
            نهاية
        نهاية

        # أنشئ/أعد استخدام العناصر المرئية
        هذا._عناصر_مرئية = []
        لكل ي في نطاق(فهرس_أول، فهرس_آخر)
            متغير عنصر = هذا._احصل_عنصر(ي)
            هذا._عناصر_مرئية.أضف(عنصر)
        نهاية
    نهاية

    دالة _احصل_عنصر(فهرس)
        متغير عنصر_معاد = هذا._من_المخزن()
        
        إذا (عنصر_معاد != لاشيء)
            عنصر_معاد.فهرس = فهرس
            عنصر_معاد.بيانات = هذا._عناصر[فهرس]
            عنصر_معاد.موضع_ص = فهرس * هذا._ارتفاع_عنصر
            إذا (هذا._باني_عنصر != لاشيء)
                عنصر_معاد.واجهة = هذا._باني_عنصر(هذا._عناصر[فهرس]، فهرس)
            نهاية
            ارجع عنصر_معاد
        نهاية

        ارجع {
            فهرس: فهرس،
            بيانات: هذا._عناصر[فهرس]،
            موضع_ص: فهرس * هذا._ارتفاع_عنصر،
            واجهة: هذا._باني_عنصر ? هذا._باني_عنصر(هذا._عناصر[فهرس]، فهرس) : لاشيء
        }
    نهاية

    دالة _أعد_للمخزن(عنصر)
        إذا (هذا._مخزن.الطول() < هذا._أقصى_مخزن)
            هذا._مخزن.أضف(عنصر)
        نهاية
    نهاية

    دالة _من_المخزن()
        إذا (هذا._مخزن.الطول() > 0)
            ارجع هذا._مخزن.انزع()
        نهاية
        ارجع لاشيء
    نهاية

    دالة احصل_مرئية()
        ارجع هذا._عناصر_مرئية
    نهاية

    دالة احصل_ارتفاع_كلي()
        ارجع هذا._عناصر.الطول() * هذا._ارتفاع_عنصر
    نهاية

    دالة احصل_إحصائيات()
        ارجع {
            إجمالي_العناصر: هذا._عناصر.الطول()،
            عناصر_مرئية: هذا._عناصر_مرئية.الطول()،
            عناصر_مخزنة: هذا._مخزن.الطول()،
            موضع_التمرير: هذا._موضع_تمرير
        }
    نهاية
نهاية

# ─── تمرير افتراضي متغير الارتفاع ───
صدّر صنف تمرير_متغير_الارتفاع
    باني(إعدادات)
        هذا._ارتفاع_تقديري = إعدادات.ارتفاع_تقديري أو 50
        هذا._ارتفاعات = []
        هذا._مواضع = []
        هذا._ارتفاع_حاوية = إعدادات.ارتفاع_حاوية أو 400
        هذا._موضع_تمرير = 0
        هذا._عناصر = []
    نهاية

    دالة عيّن_بيانات(عناصر)
        هذا._عناصر = عناصر
        هذا._ارتفاعات = []
        هذا._مواضع = []
        
        # احسب المواضع التقديرية
        متغير موضع = 0
        لكل ي في نطاق(0، عناصر.الطول())
            هذا._مواضع.أضف(موضع)
            هذا._ارتفاعات.أضف(هذا._ارتفاع_تقديري)
            موضع += هذا._ارتفاع_تقديري
        نهاية
    نهاية

    دالة عيّن_ارتفاع_فعلي(فهرس، ارتفاع)
        متغير فرق = ارتفاع - هذا._ارتفاعات[فهرس]
        هذا._ارتفاعات[فهرس] = ارتفاع
        
        # حدث مواضع العناصر التالية
        لكل ي في نطاق(فهرس + 1، هذا._مواضع.الطول())
            هذا._مواضع[ي] += فرق
        نهاية
    نهاية

    دالة جد_فهرس_عند(موضع)
        # بحث ثنائي
        متغير يسار = 0
        متغير يمين = هذا._مواضع.الطول() - 1
        
        بينما (يسار <= يمين)
            متغير وسط = اقسم_صحيح(يسار + يمين، 2)
            إذا (هذا._مواضع[وسط] <= موضع)
                يسار = وسط + 1
            وإلا
                يمين = وسط - 1
            نهاية
        نهاية
        
        ارجع ماكس(0، يسار - 1)
    نهاية

    دالة احصل_مرئية()
        متغير فهرس_أول = هذا.جد_فهرس_عند(هذا._موضع_تمرير)
        متغير فهرس_آخر = هذا.جد_فهرس_عند(هذا._موضع_تمرير + هذا._ارتفاع_حاوية)
        
        متغير نتيجة = []
        لكل ي في نطاق(فهرس_أول، مين(فهرس_آخر + 2، هذا._عناصر.الطول()))
            نتيجة.أضف({
                فهرس: ي،
                بيانات: هذا._عناصر[ي]،
                موضع: هذا._مواضع[ي]،
                ارتفاع: هذا._ارتفاعات[ي]
            })
        نهاية
        
        ارجع نتيجة
    نهاية
نهاية

# ─── قائمة افتراضية لانهائية ───
صدّر صنف قائمة_لانهائية
    باني(إعدادات)
        هذا._تمرير = جديد تمرير_افتراضي(إعدادات)
        هذا._محمّل = إعدادات.محمّل
        هذا._حجم_صفحة = إعدادات.حجم_صفحة أو 20
        هذا._جاري_التحميل = خطأ
        هذا._انتهت_البيانات = خطأ
        هذا._صفحة_حالية = 0
    نهاية

    غير_متزامن دالة حمّل_المزيد()
        إذا (هذا._جاري_التحميل أو هذا._انتهت_البيانات)
            ارجع
        نهاية

        هذا._جاري_التحميل = صحيح
        
        حاول
            متغير بيانات = انتظر هذا._محمّل(هذا._صفحة_حالية، هذا._حجم_صفحة)
            
            إذا (بيانات.الطول() < هذا._حجم_صفحة)
                هذا._انتهت_البيانات = صحيح
            نهاية
            
            هذا._صفحة_حالية += 1
            # دمج البيانات الجديدة
            متغير حالية = هذا._تمرير._عناصر
            هذا._تمرير.عيّن_بيانات(حالية + بيانات)
        أخيراً
            هذا._جاري_التحميل = خطأ
        نهاية
    نهاية

    دالة عند_التمرير(موضع)
        هذا._تمرير.مرر_إلى(موضع)
        
        # تحقق إذا اقتربنا من النهاية
        متغير إحصائيات = هذا._تمرير.احصل_إحصائيات()
        متغير مرئية = إحصائيات.عناصر_مرئية
        متغير إجمالي = إحصائيات.إجمالي_العناصر
        
        إذا (مرئية > 0 و (إجمالي - موضع / 50) < 10)
            هذا.حمّل_المزيد()
        نهاية
    نهاية
نهاية
