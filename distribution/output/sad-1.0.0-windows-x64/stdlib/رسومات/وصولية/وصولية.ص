# ─── خصائص الدلالات ───
صدّر صنف خصائص_دلالات
    باني()
        # التسمية والوصف
        هذا.تسمية = ""
        هذا.وصف = ""
        هذا.تلميح = ""
        هذا.قيمة = ""
        
        # الحالة
        هذا.مفعّل = صحيح
        هذا.محدد = خطأ
        هذا.موسّع = خطأ
        هذا.مخفي = خطأ
        هذا.فقط_للقراءة = خطأ
        هذا.مطلوب = خطأ
        هذا.قابل_للتعديل = خطأ
        
        # التركيز
        هذا.قابل_للتركيز = خطأ
        هذا.مركّز = خطأ
        هذا.في_شجرة_التركيز = خطأ
        
        # الرأس
        هذا.رأس = خطأ
        هذا.مستوى_رأس = 0
        
        # المنزلق
        هذا.قيمة_منزلق = 0.0
        هذا.أدنى_قيمة = 0.0
        هذا.أقصى_قيمة = 1.0
        
        # النص
        هذا.حقل_نص = خطأ
        هذا.نص_غامض = خطأ
        هذا.العد = 0
        هذا.الفهرس = 0
        
        # الإجراءات
        هذا.إجراءات = []
        
        # إجراءات مخصصة
        هذا.إجراءات_مخصصة = []
    نهاية

    دالة انسخ()
        متغير ج = جديد خصائص_دلالات()
        ج.تسمية = هذا.تسمية
        ج.وصف = هذا.وصف
        ج.تلميح = هذا.تلميح
        ج.قيمة = هذا.قيمة
        ج.مفعّل = هذا.مفعّل
        ج.محدد = هذا.محدد
        ج.موسّع = هذا.موسّع
        ج.مخفي = هذا.مخفي
        ج.قابل_للتركيز = هذا.قابل_للتركيز
        ج.مركّز = هذا.مركّز
        ج.رأس = هذا.رأس
        ج.مستوى_رأس = هذا.مستوى_رأس
        ج.إجراءات = هذا.إجراءات.انسخ()
        ارجع ج
    نهاية

    دالة دمج(أخرى)
        إذا (أخرى.تسمية != "")
            هذا.تسمية = أخرى.تسمية
        نهاية
        إذا (أخرى.وصف != "")
            هذا.وصف = أخرى.وصف
        نهاية
        إذا (أخرى.تلميح != "")
            هذا.تلميح = أخرى.تلميح
        نهاية
        هذا.مفعّل = هذا.مفعّل و أخرى.مفعّل
        هذا.إجراءات = هذا.إجراءات + أخرى.إجراءات
        ارجع هذا
    نهاية
نهاية

# ─── عقدة الدلالات (Semantics Node) ───
صدّر صنف عقدة_دلالات يرث عنصر
    باني(ابن = لاشيء, خصائص = لاشيء)
        هذا._نوع = "دلالات"
        هذا._ابن = ابن
        هذا._خصائص = خصائص أو جديد خصائص_دلالات()
    نهاية

    دالة الخصائص()
        ارجع هذا._خصائص
    نهاية

    # ─── منشئات سريعة ───
    ساكن دالة زر(ابن, تسمية, عند_النقر = لاشيء)
        متغير خ = جديد خصائص_دلالات()
        خ.تسمية = تسمية
        خ.قابل_للتركيز = صحيح
        إذا (عند_النقر != لاشيء)
            خ.إجراءات.أضف(إجراء_دلالات.نقر)
        نهاية
        ارجع جديد عقدة_دلالات(ابن, خ)
    نهاية

    ساكن دالة صورة(ابن, وصف)
        متغير خ = جديد خصائص_دلالات()
        خ.تسمية = وصف
        ارجع جديد عقدة_دلالات(ابن, خ)
    نهاية

    ساكن دالة رأس(ابن, مستوى = 1)
        متغير خ = جديد خصائص_دلالات()
        خ.رأس = صحيح
        خ.مستوى_رأس = مستوى
        ارجع جديد عقدة_دلالات(ابن, خ)
    نهاية

    ساكن دالة رابط(ابن, تسمية)
        متغير خ = جديد خصائص_دلالات()
        خ.تسمية = تسمية
        خ.قابل_للتركيز = صحيح
        خ.إجراءات.أضف(إجراء_دلالات.نقر)
        ارجع جديد عقدة_دلالات(ابن, خ)
    نهاية
نهاية

