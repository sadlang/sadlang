# ─── خدمة الوصولية ───
صدّر صنف خدمة_وصولية
    ساكن متغير _نسخة = لاشيء

    ساكن دالة النسخة()
        إذا (_نسخة == لاشيء)
            _نسخة = جديد خدمة_وصولية()
        نهاية
        ارجع _نسخة
    نهاية

    باني()
        هذا._قارئ_شاشة_مفعّل = خطأ
        هذا._تباين_عالي = خطأ
        هذا._تقليل_حركة = خطأ
        هذا._نص_كبير = خطأ
        هذا._جرأة_نص = خطأ
        هذا._عكس_ألوان = خطأ
        هذا._مستمعون = []
    نهاية

    # ─── الحالة ───
    دالة قارئ_شاشة_مفعّل()
        ارجع هذا._قارئ_شاشة_مفعّل
    نهاية

    دالة تباين_عالي()
        ارجع هذا._تباين_عالي
    نهاية

    دالة تقليل_حركة()
        ارجع هذا._تقليل_حركة
    نهاية

    دالة نص_كبير()
        ارجع هذا._نص_كبير
    نهاية

    # ─── الإعلانات ───
    دالة أعلن(رسالة)
        # إرسال إعلان لقارئ الشاشة
        _أعلن_للقارئ(رسالة)
    نهاية

    دالة أعلن_تنبيه(رسالة)
        # إعلان عاجل (يقاطع ما يقرأه القارئ)
        _أعلن_للقارئ_عاجل(رسالة)
    نهاية

    # ─── الاستماع للتغيرات ───
    دالة أضف_مستمع(دالة_رد)
        هذا._مستمعون.أضف(دالة_رد)
    نهاية

    دالة أزل_مستمع(دالة_رد)
        هذا._مستمعون.أزل(دالة_رد)
    نهاية

    دالة _أبلغ_المستمعين()
        لكل م في هذا._مستمعون
            م(هذا)
        نهاية
    نهاية
نهاية

# ─── مساعدات WCAG ───
صدّر صنف معايير_وصولية
    # مستويات التوافق WCAG
    ساكن ثابت AA = "AA"
    ساكن ثابت AAA = "AAA"

    # نسبة التباين الدنيا للنص
    ساكن ثابت تباين_نص_عادي_AA = 4.5
    ساكن ثابت تباين_نص_كبير_AA = 3.0
    ساكن ثابت تباين_نص_عادي_AAA = 7.0
    ساكن ثابت تباين_نص_كبير_AAA = 4.5

    # حجم الهدف القابل للنقر الأدنى
    ساكن ثابت حجم_هدف_أدنى = 44

    ساكن دالة احسب_تباين(لون1, لون2)
        # حساب نسبة التباين بين لونين
        متغير ل1 = _إضاءة_نسبية(لون1)
        متغير ل2 = _إضاءة_نسبية(لون2)
        متغير أفتح = ل1 > ل2 ? ل1 : ل2
        متغير أغمق = ل1 > ل2 ? ل2 : ل1
        ارجع (أفتح + 0.05) / (أغمق + 0.05)
    نهاية

    ساكن دالة تباين_كافي(لون1, لون2, نص_كبير = خطأ, مستوى = "AA")
        متغير نسبة = معايير_وصولية.احسب_تباين(لون1, لون2)
        
        إذا (مستوى == "AA")
            ارجع نص_كبير ? نسبة >= 3.0 : نسبة >= 4.5
        وإلا
            ارجع نص_كبير ? نسبة >= 4.5 : نسبة >= 7.0
        نهاية
    نهاية
نهاية

# ─── دوال مساعدة داخلية ───
دالة _إضاءة_نسبية(لون)
    متغير ر = (لون >> 16) & 0xFF
    متغير خ = (لون >> 8) & 0xFF
    متغير ز = لون & 0xFF
    
    ر = ر / 255.0
    خ = خ / 255.0
    ز = ز / 255.0
    
    ر = ر <= 0.03928 ? ر / 12.92 : ((ر + 0.055) / 1.055) ** 2.4
    خ = خ <= 0.03928 ? خ / 12.92 : ((خ + 0.055) / 1.055) ** 2.4
    ز = ز <= 0.03928 ? ز / 12.92 : ((ز + 0.055) / 1.055) ** 2.4
    
    ارجع 0.2126 * ر + 0.7152 * خ + 0.0722 * ز
نهاية
