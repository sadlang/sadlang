# ─── نسبة الأبعاد (AspectRatio) ───
صدّر صنف نسبة_أبعاد يرث عنصر
    باني(نسبة، ابن = لاشيء)
        هذا._نوع = "نسبة_أبعاد"
        هذا._نسبة = نسبة
        هذا._ابن = ابن
    نهاية

    دالة النسبة()
        ارجع هذا._نسبة
    نهاية

    # نسب شائعة
    ساكن ثابت مربع = 1.0
    ساكن ثابت شاشة_16_9 = 16.0 / 9.0
    ساكن ثابت شاشة_4_3 = 4.0 / 3.0
    ساكن ثابت شاشة_3_2 = 3.0 / 2.0
    ساكن ثابت ذهبية = 1.618
نهاية

