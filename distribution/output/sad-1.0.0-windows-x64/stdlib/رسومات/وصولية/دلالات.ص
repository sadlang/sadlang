# ─── ترتيب التنقل (OrdinalSortKey) ───
صدّر صنف مفتاح_ترتيب
    باني(ترتيب، اسم = لاشيء)
        هذا.ترتيب = ترتيب
        هذا.اسم = اسم
    نهاية

    دالة قارن(آخر)
        إذا (آخر == لاشيء)
            ارجع 1
        نهاية
        ارجع هذا.ترتيب - آخر.ترتيب
    نهاية
نهاية

# ─── خدمة الدلالات ───
صدّر صنف خدمة_دلالات
    ساكن متغير _نسخة = لاشيء

    ساكن دالة النسخة()
        إذا (_نسخة == لاشيء)
            _نسخة = جديد خدمة_دلالات()
        نهاية
        ارجع _نسخة
    نهاية

    باني()
        هذا._ملزمة = لاشيء
    نهاية

    دالة أعلن(رسالة)
        # إرسال إعلان لقارئ الشاشة
        _أرسل_إلى_قارئ_شاشة(رسالة)
    نهاية

    دالة أعلن_عاجل(رسالة)
        # إعلان يقاطع القراءة الحالية
        _أرسل_إلى_قارئ_شاشة_عاجل(رسالة)
    نهاية

    دالة أعلن_تغيير_طريق(مسار)
        # إعلان عن تغيير الشاشة
        _أرسل_إلى_قارئ_شاشة("انتقال إلى: " + مسار)
    نهاية
نهاية

