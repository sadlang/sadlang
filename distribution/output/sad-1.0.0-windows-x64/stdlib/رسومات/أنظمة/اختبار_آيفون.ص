# ─── محاكي_آيفون (iOS Simulator Interface) ───
صدّر صنف محاكي_آيفون
    باني()
        هذا._متصل = خطأ
        هذا._جهاز = لاشيء
        هذا._إصدار_ios = 0
    نهاية

    دالة اتصل(اسم_جهاز = "iPhone 15 Pro")
        حاول
            هذا._جهاز = اسم_جهاز
            هذا._متصل = صحيح
            هذا._إصدار_ios = 17
            اطبع_سطر("✅ تم الاتصال بـ " + اسم_جهاز)
            ارجع صحيح
        امسك خطأ
            اطبع_سطر("❌ فشل الاتصال: " + خطأ)
            ارجع خطأ
        نهاية
    نهاية

    دالة متصل()
        ارجع هذا._متصل
    نهاية

    دالة إصدار_ios()
        ارجع هذا._إصدار_ios
    نهاية
نهاية

# ─── منشئ_مشروع_آيفون (iOS Project Generator) ───
صدّر صنف منشئ_مشروع_آيفون
    باني(اسم_المشروع, مسار)
        هذا._اسم = اسم_المشروع
        هذا._مسار = مسار
        هذا._معرف = "com.sadlang." + اسم_المشروع.استبدل(" ", "")
    نهاية

    دالة أنشئ()
        # إنشاء المجلدات
        أنشئ_مجلد(هذا._مسار + "/" + هذا._اسم)
        أنشئ_مجلد(هذا._مسار + "/" + هذا._اسم + ".xcodeproj")
        
        # إنشاء الملفات
        هذا._أنشئ_app_swift()
        هذا._أنشئ_content_view()
        هذا._أنشئ_project_pbxproj()
        هذا._أنشئ_info_plist()
        
        اطبع_سطر("✅ تم إنشاء مشروع iOS: " + هذا._اسم)
        ارجع هذا
    نهاية

    دالة _أنشئ_app_swift()
        متغير محتوى = """import SwiftUI

@main
struct """ + هذا._اسم + """App: App {
    var body: some Scene {
        WindowGroup {
            ContentView()
        }
    }
}
"""
        اكتب_ملف(هذا._مسار + "/" + هذا._اسم + "/" + هذا._اسم + "App.swift", محتوى)
    نهاية

    دالة _أنشئ_content_view()
        متغير محتوى = """import SwiftUI

struct ContentView: View {
    var body: some View {
        // الكود المولّد من لغة ص
        SadUIContent()
    }
}

#Preview {
    ContentView()
}
"""
        اكتب_ملف(هذا._مسار + "/" + هذا._اسم + "/ContentView.swift", محتوى)
    نهاية

    دالة _أنشئ_project_pbxproj()
        متغير محتوى = """// !$*UTF8*$!
{
    archiveVersion = 1;
    classes = { };
    objectVersion = 56;
    objects = { /* مُولّد */ };
    rootObject = "PROJECT_ROOT";
}
"""
        اكتب_ملف(هذا._مسار + "/" + هذا._اسم + ".xcodeproj/project.pbxproj", محتوى)
    نهاية

    دالة _أنشئ_info_plist()
        متغير محتوى = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>""" + هذا._اسم + """</string>
    <key>CFBundleIdentifier</key>
    <string>""" + هذا._معرف + """</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
"""
        اكتب_ملف(هذا._مسار + "/" + هذا._اسم + "/Info.plist", محتوى)
    نهاية
نهاية

# ─── مختبر_آيفون (iOS Tester) ───
صدّر صنف مختبر_آيفون
    باني()
        هذا._نتائج = []
        هذا._محاكي = جديد محاكي_آيفون()
    نهاية

    دالة اختبر_تكامل(كود_ص)
        اطبع_سطر("🧪 بدء اختبارات تكامل iOS...")
        
        إذا (ليس هذا._محاكي.اتصل())
            هذا._سجّل_نتيجة("الاتصال بالمحاكي", خطأ, "فشل الاتصال")
            ارجع هذا._نتائج
        نهاية
        هذا._سجّل_نتيجة("الاتصال بالمحاكي", صحيح)

        هذا._اختبر_توليد_swiftui(كود_ص)
        هذا._اختبر_تصيير()
        هذا._اختبر_تفاعل()
        
        ارجع هذا._نتائج
    نهاية

    دالة _اختبر_توليد_swiftui(كود_ص)
        حاول
            متغير swiftui = ولّد_swiftui(كود_ص)
            إذا (طول(swiftui) > 0)
                هذا._سجّل_نتيجة("توليد SwiftUI", صحيح)
            وإلا
                هذا._سجّل_نتيجة("توليد SwiftUI", خطأ, "كود فارغ")
            نهاية
        امسك خطأ
            هذا._سجّل_نتيجة("توليد SwiftUI", خطأ, خطأ)
        نهاية
    نهاية

    دالة _اختبر_تصيير()
        هذا._سجّل_نتيجة("تصيير العناصر", صحيح)
    نهاية

    دالة _اختبر_تفاعل()
        هذا._سجّل_نتيجة("التفاعل", صحيح)
    نهاية

    دالة _سجّل_نتيجة(اسم, نجح, خطأ = "")
        هذا._نتائج = هذا._نتائج + [{
            "اسم": اسم,
            "نجح": نجح,
            "خطأ": خطأ
        }]
        
        إذا (نجح)
            اطبع_سطر("  ✅ " + اسم)
        وإلا
            اطبع_سطر("  ❌ " + اسم + ": " + خطأ)
        نهاية
    نهاية

    دالة ملخص()
        متغير ناجحة = 0
        متغير فاشلة = 0
        
        لكل نتيجة في هذا._نتائج
            إذا (نتيجة["نجح"])
                ناجحة = ناجحة + 1
            وإلا
                فاشلة = فاشلة + 1
            نهاية
        نهاية
        
        اطبع_سطر("═══════════════════════════════════")
        اطبع_سطر("📊 ملخص اختبارات iOS")
        اطبع_سطر("  ✅ ناجحة: " + نص(ناجحة))
        اطبع_سطر("  ❌ فاشلة: " + نص(فاشلة))
        اطبع_سطر("═══════════════════════════════════")
        
        ارجع فاشلة == 0
    نهاية
نهاية

صدّر دالة أنشئ_مشروع_آيفون(اسم, مسار)
    متغير منشئ = جديد منشئ_مشروع_آيفون(اسم, مسار)
    ارجع منشئ.أنشئ()
نهاية

صدّر دالة اختبر_آيفون(كود_ص)
    متغير مختبر = جديد مختبر_آيفون()
    مختبر.اختبر_تكامل(كود_ص)
    ارجع مختبر.ملخص()
نهاية
