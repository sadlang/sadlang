استورد * من رسومات.أساس.عنصر

# ─── بيانات_وسائط (MediaQueryData) ─── [نظام 19]
صدّر صنف بيانات_وسائط
    باني(حجم = لاشيء, حشو = لاشيء, حشو_عرض = لاشيء, كثافة_بكسل = 1.0, مقياس_نص = 1.0, سطوع_منصة = "فاتح", تباين_عالي = خطأ, تعطيل_حركة = خطأ, جرأة_نص = خطأ, اتجاه_التنقل = "تقليدي", عكس_ألوان = خطأ)
        إذا (حجم == لاشيء)
            هذا._عرض = 0.0
            هذا._ارتفاع = 0.0
        وإلا
            هذا._عرض = حجم["عرض"]
            هذا._ارتفاع = حجم["ارتفاع"]
        نهاية
        هذا._حشو = حشو
        هذا._حشو_عرض = حشو_عرض
        هذا._كثافة_بكسل = كثافة_بكسل
        هذا._مقياس_نص = مقياس_نص
        هذا._سطوع = سطوع_منصة
        هذا._تباين_عالي = تباين_عالي
        هذا._تعطيل_حركة = تعطيل_حركة
        هذا._جرأة_نص = جرأة_نص
        هذا._اتجاه_التنقل = اتجاه_التنقل
        هذا._عكس_ألوان = عكس_ألوان
    نهاية

    دالة الحجم()
        ارجع {"عرض": هذا._عرض, "ارتفاع": هذا._ارتفاع}
    نهاية

    دالة الحشو()
        ارجع هذا._حشو
    نهاية

    دالة كثافة_البكسل()
        ارجع هذا._كثافة_بكسل
    نهاية

    دالة مقياس_النص()
        ارجع هذا._مقياس_نص
    نهاية

    دالة السطوع()
        ارجع هذا._سطوع
    نهاية

    دالة التباين_العالي()
        ارجع هذا._تباين_عالي
    نهاية

    دالة تعطيل_الحركة()
        ارجع هذا._تعطيل_حركة
    نهاية

    دالة الاتجاه()
        إذا (هذا._عرض > هذا._ارتفاع)
            ارجع "أفقي"
        نهاية
        ارجع "عمودي"
    نهاية

    دالة نسخ_مع(حجم = لاشيء, حشو = لاشيء, كثافة_بكسل = لاشيء, مقياس_نص = لاشيء, سطوع_منصة = لاشيء)
        متغير _حجم = حجم != لاشيء ? حجم : هذا.الحجم()
        متغير _حشو = حشو != لاشيء ? حشو : هذا._حشو
        متغير _كثافة = كثافة_بكسل != لاشيء ? كثافة_بكسل : هذا._كثافة_بكسل
        متغير _مقياس = مقياس_نص != لاشيء ? مقياس_نص : هذا._مقياس_نص
        متغير _سطوع = سطوع_منصة != لاشيء ? سطوع_منصة : هذا._سطوع
        ارجع جديد بيانات_وسائط(_حجم, _حشو, لاشيء, _كثافة, _مقياس, _سطوع)
    نهاية
نهاية

# ─── استعلام_وسائط (MediaQuery) ─── [نظام 20]
صدّر صنف استعلام_وسائط يرث عنصر
    باني(بيانات, ابن = لاشيء)
        هذا._نوع = "استعلام_وسائط"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["بيانات"] = بيانات
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية

    ساكن دالة حجم_من(سياق)
        ارجع سياق._بيانات_وسائط.الحجم()
    نهاية

    ساكن دالة اتجاه_من(سياق)
        ارجع سياق._بيانات_وسائط.الاتجاه()
    نهاية

    ساكن دالة مقياس_نص_من(سياق)
        ارجع سياق._بيانات_وسائط.مقياس_النص()
    نهاية

    ساكن دالة حشو_من(سياق)
        ارجع سياق._بيانات_وسائط.الحشو()
    نهاية

    ساكن دالة سطوع_من(سياق)
        ارجع سياق._بيانات_وسائط.السطوع()
    نهاية
نهاية

