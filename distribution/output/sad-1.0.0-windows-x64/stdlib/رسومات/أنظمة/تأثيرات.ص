# ─── تحويل (Transform) ───
صدّر صنف تحويل يرث عنصر
    باني(ابن = لاشيء, تحويل = لاشيء, أصل = لاشيء, محاذاة = لاشيء, تحويل_اختبار_ضربة = صحيح, سلوك_فلترة = لاشيء)
        هذا._نوع = "تحويل"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["تحويل"] = تحويل
        هذا._خصائص["أصل"] = أصل
        هذا._خصائص["محاذاة"] = محاذاة
        هذا._خصائص["تحويل_اختبار_ضربة"] = تحويل_اختبار_ضربة
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية

    ساكن دالة دوران(زاوية, ابن = لاشيء, أصل = لاشيء, محاذاة = لاشيء)
        متغير ت = جديد تحويل(ابن)
        ت._خصائص["زاوية"] = زاوية
        ت._خصائص["أصل"] = أصل
        ت._خصائص["محاذاة"] = محاذاة
        ارجع ت
    نهاية

    ساكن دالة مقياس(مقياس_س = 1.0, مقياس_ص = لاشيء, ابن = لاشيء, أصل = لاشيء, محاذاة = لاشيء)
        متغير ت = جديد تحويل(ابن)
        ت._خصائص["مقياس_س"] = مقياس_س
        متغير قيمة_مقياس_ص = (مقياس_ص != لاشيء) ? مقياس_ص : مقياس_س
        ت._خصائص["مقياس_ص"] = قيمة_مقياس_ص
        ت._خصائص["أصل"] = أصل
        ت._خصائص["محاذاة"] = محاذاة
        ارجع ت
    نهاية

    ساكن دالة إزاحة(إزاحة_س = 0, إزاحة_ص = 0, ابن = لاشيء)
        متغير ت = جديد تحويل(ابن)
        ت._خصائص["إزاحة_س"] = إزاحة_س
        ت._خصائص["إزاحة_ص"] = إزاحة_ص
        ارجع ت
    نهاية

    ساكن دالة قلب(ابن = لاشيء, محاذاة = لاشيء)
        ارجع تحويل.مقياس(مقياس_س: -1.0, ابن: ابن, محاذاة: محاذاة)
    نهاية
نهاية

