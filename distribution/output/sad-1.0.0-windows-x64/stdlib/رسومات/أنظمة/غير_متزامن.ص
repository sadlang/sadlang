نهاية

# ─── لقطة_غير_متزامنة (AsyncSnapshot) ───
صدّر صنف لقطة_غير_متزامنة
    باني(حالة_اتصال = "لا_شيء", بيانات = لاشيء, خطأ = لاشيء)
        هذا._حالة = حالة_اتصال
        هذا._بيانات = بيانات
        هذا._خطأ = خطأ
    نهاية

    دالة حالة_الاتصال()
        ارجع هذا._حالة
    نهاية

    دالة لديه_بيانات()
        ارجع هذا._بيانات != لاشيء
    نهاية

    دالة لديه_خطأ()
        ارجع هذا._خطأ != لاشيء
    نهاية

    دالة البيانات()
        ارجع هذا._بيانات
    نهاية

    دالة الخطأ()
        ارجع هذا._خطأ
    نهاية

    ساكن دالة انتظار()
        ارجع جديد لقطة_غير_متزامنة("انتظار")
    نهاية

    ساكن دالة مع_بيانات(بيانات)
        ارجع جديد لقطة_غير_متزامنة("نشط", بيانات)
    نهاية

    ساكن دالة مع_خطأ(رسالة_خطأ)
        ارجع جديد لقطة_غير_متزامنة("نشط", لاشيء, رسالة_خطأ)
    نهاية

    ساكن دالة مكتمل(بيانات)
        ارجع جديد لقطة_غير_متزامنة("مكتمل", بيانات)
    نهاية
نهاية

# ─── حالة_اتصال (ConnectionState) ───
صدّر صنف حالة_اتصال
    ساكن ثابت لا_شيء = "لا_شيء"
    ساكن ثابت انتظار = "انتظار"
    ساكن ثابت نشط = "نشط"
    ساكن ثابت مكتمل = "مكتمل"
نهاية

# ─── باني_قيمة_مستمعة (ValueListenableBuilder) ───
صدّر صنف باني_قيمة_مستمعة يرث عنصر
    باني(قيمة_مراقبة, باني, ابن = لاشيء)
        هذا._نوع = "باني_قيمة_مستمعة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["قيمة_مراقبة"] = قيمة_مراقبة
        هذا._خصائص["باني"] = باني
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

