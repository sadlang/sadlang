# ─── باني_مستقبل (FutureBuilder) ───
صدّر صنف باني_مستقبل يرث عنصر
    باني(مستقبل, باني, بيانات_أولية = لاشيء)
        هذا._نوع = "باني_مستقبل"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["مستقبل"] = مستقبل
        هذا._خصائص["باني"] = باني
        هذا._خصائص["بيانات_أولية"] = بيانات_أولية
    نهاية
نهاية

