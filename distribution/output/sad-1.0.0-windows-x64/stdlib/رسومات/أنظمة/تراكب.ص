# ─── نظام_مسارات (Navigator/Route) ─── [نظام 10]
صدّر صنف متنقل يرث عنصر
    باني(مسار_أولي = "/", باني_مسار = لاشيء, مسارات = {}, عند_توليد_مسار = لاشيء, صفحة_غير_معروفة = لاشيء)
        هذا._نوع = "متنقل"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["مسار_أولي"] = مسار_أولي
        هذا._خصائص["باني_مسار"] = باني_مسار
        هذا._خصائص["مسارات"] = مسارات
        هذا._خصائص["عند_توليد_مسار"] = عند_توليد_مسار
        هذا._خصائص["صفحة_غير_معروفة"] = صفحة_غير_معروفة
        هذا._مكدس = []
    نهاية

    دالة ادفع(مسار)
        هذا._مكدس = هذا._مكدس + [مسار]
    نهاية

    دالة ادفع_مسمى(اسم, وسائط = لاشيء)
        هذا._مكدس = هذا._مكدس + [{"اسم": اسم, "وسائط": وسائط}]
    نهاية

    دالة أخرج(نتيجة = لاشيء)
        إذا (هذا._مكدس != [])
            # إزالة آخر عنصر
        نهاية
        ارجع نتيجة
    نهاية

    دالة ادفع_بديل(مسار)
        هذا.أخرج()
        هذا.ادفع(مسار)
    نهاية

    دالة ادفع_مسمى_بديل(اسم, وسائط = لاشيء)
        هذا.أخرج()
        هذا.ادفع_مسمى(اسم, وسائط)
    نهاية

    دالة أخرج_حتى(شرط)
        # إزالة حتى الشرط
    نهاية

    دالة يمكن_الإخراج()
        ارجع هذا._مكدس != []
    نهاية
نهاية

