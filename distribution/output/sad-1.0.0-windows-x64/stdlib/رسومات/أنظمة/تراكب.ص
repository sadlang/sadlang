# ─── تراكب (Overlay) ─── [نظام 6]
صدّر صنف تراكب يرث عنصر
    باني(مدخلات_أولية = [], قص = خطأ)
        هذا._نوع = "تراكب"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["مدخلات_أولية"] = مدخلات_أولية
        هذا._خصائص["قص"] = قص
        هذا._مدخلات = []
    نهاية

    دالة أدخل(مدخلة)
        هذا._مدخلات = هذا._مدخلات + [مدخلة]
    نهاية

    دالة أدخل_الكل(مدخلات)
        لكل م في مدخلات
            هذا._مدخلات = هذا._مدخلات + [م]
        نهاية
    نهاية

    ساكن دالة من(سياق)
        ارجع لاشيء
    نهاية
نهاية

