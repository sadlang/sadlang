# #173: JWT Handler
صدّر صنف معالج_JWT
    ساكن دالة فك_ترميز(رمز)
        # فك ترميز JWT (بدون التحقق)
        متغير أجزاء = رمز.قسّم(".")
        إذا (أجزاء.الطول() != 3)
            ارجع لاشيء
        نهاية
        
        # فك base64 للجزء الثاني (الحمولة)
        ارجع {}
    نهاية

    ساكن دالة منتهي؟(رمز)
        متغير حمولة = معالج_JWT.فك_ترميز(رمز)
        إذا (حمولة و حمولة.انتهاء)
            ارجع وقت_الآن() > حمولة.انتهاء * 1000
        نهاية
        ارجع صحيح
    نهاية
نهاية

