نهاية

صدّر صنف مستخدم
    باني(إعدادات)
        هذا._معرف = إعدادات.معرف أو ""
        هذا._بريد = إعدادات.بريد أو ""
        هذا._اسم = إعدادات.اسم أو ""
        هذا._صورة = إعدادات.صورة أو لاشيء
        هذا._مسجل_عند = إعدادات.مسجل_عند أو لاشيء
        هذا._آخر_دخول = إعدادات.آخر_دخول أو لاشيء
        هذا._بيانات_إضافية = إعدادات.بيانات أو {}
    نهاية
نهاية

صدّر صنف مدير_مصادقة
    ساكن متغير _مثيل = لاشيء
    
    ساكن دالة احصل_مثيل()
        إذا (مدير_مصادقة._مثيل == لاشيء)
            مدير_مصادقة._مثيل = جديد مدير_مصادقة()
        نهاية
        ارجع مدير_مصادقة._مثيل
    نهاية

    باني()
        هذا._مستخدم_حالي = لاشيء
        هذا._حالة = حالة_مصادقة.غير_مصادق
        هذا._مستمعون = []
        هذا._مزودون = {}
    نهاية

    دالة احصل_مستخدم()
        ارجع هذا._مستخدم_حالي
    نهاية

    دالة احصل_حالة()
        ارجع هذا._حالة
    نهاية

    دالة مصادق؟()
        ارجع هذا._مستخدم_حالي != لاشيء
    نهاية

    غير_متزامن دالة سجّل_بالبريد(بريد، كلمة_سر، اسم)
        هذا._حالة = حالة_مصادقة.جاري_المصادقة
        هذا._أخطر()
        
        حاول
            # تنفيذ API - سيتم في C++
            متغير مستخدم = جديد مستخدم({
                بريد: بريد،
                اسم: اسم
            })
            
            هذا._مستخدم_حالي = مستخدم
            هذا._حالة = حالة_مصادقة.مصادق
            هذا._أخطر()
            
            ارجع {نجاح: صحيح، مستخدم: مستخدم}
        امسك (خطأ)
            هذا._حالة = حالة_مصادقة.خطأ
            هذا._أخطر()
            ارجع {نجاح: خطأ، خطأ: خطأ}
        نهاية
    نهاية

    غير_متزامن دالة سجّل_دخول_بالبريد(بريد، كلمة_سر)
        هذا._حالة = حالة_مصادقة.جاري_المصادقة
        هذا._أخطر()
        
        حاول
            # تنفيذ API
            متغير مستخدم = جديد مستخدم({بريد: بريد})
            
            هذا._مستخدم_حالي = مستخدم
            هذا._حالة = حالة_مصادقة.مصادق
            هذا._أخطر()
            
            ارجع {نجاح: صحيح، مستخدم: مستخدم}
        امسك (خطأ)
            هذا._حالة = حالة_مصادقة.خطأ
            هذا._أخطر()
            ارجع {نجاح: خطأ، خطأ: خطأ}
        نهاية
    نهاية

    غير_متزامن دالة سجّل_خروج()
        هذا._مستخدم_حالي = لاشيء
        هذا._حالة = حالة_مصادقة.غير_مصادق
        هذا._أخطر()
    نهاية

    غير_متزامن دالة أرسل_رابط_إعادة_تعيين(بريد)
        # إرسال بريد إعادة تعيين كلمة المرور
        ارجع {نجاح: صحيح}
    نهاية

    دالة راقب(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة ألغِ_مراقبة(مستمع)
        هذا._مستمعون = هذا._مستمعون.فلتر(لامدا(م) => م != مستمع نهاية)
    نهاية

    دالة _أخطر()
        لكل مستمع في هذا._مستمعون
            مستمع({
                حالة: هذا._حالة،
                مستخدم: هذا._مستخدم_حالي
            })
        نهاية
    نهاية
نهاية

