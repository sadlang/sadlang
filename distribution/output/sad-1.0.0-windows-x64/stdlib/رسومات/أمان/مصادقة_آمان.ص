# #177: Permission Guard
صدّر صنف حارس_صلاحيات
    باني(إعدادات)
        هذا._صلاحيات_مطلوبة = إعدادات.صلاحيات أو []
        هذا._ابن = إعدادات.ابن
        هذا._بديل = إعدادات.بديل أو لاشيء
        هذا._دالة_تحقق = إعدادات.دالة_تحقق أو لاشيء
    نهاية

    دالة لديه_صلاحية(مستخدم، صلاحية)
        إذا (هذا._دالة_تحقق)
            ارجع هذا._دالة_تحقق(مستخدم، صلاحية)
        نهاية
        
        إذا (مستخدم و مستخدم.صلاحيات)
            ارجع مستخدم.صلاحيات.يحتوي(صلاحية)
        نهاية
        ارجع خطأ
    نهاية

    دالة بناء()
        متغير مستخدم = مدير_مصادقة.احصل_مثيل().احصل_مستخدم()
        
        لكل صلاحية في هذا._صلاحيات_مطلوبة
            إذا (ليس هذا.لديه_صلاحية(مستخدم، صلاحية))
                ارجع هذا._بديل
            نهاية
        نهاية
        
        ارجع هذا._ابن
    نهاية
نهاية

