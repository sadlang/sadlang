# #175: Session Manager
صدّر صنف مدير_جلسات
    ساكن متغير _مثيل = لاشيء
    
    ساكن دالة احصل_مثيل()
        إذا (مدير_جلسات._مثيل == لاشيء)
            مدير_جلسات._مثيل = جديد مدير_جلسات()
        نهاية
        ارجع مدير_جلسات._مثيل
    نهاية

    باني()
        هذا._جلسة_حالية = لاشيء
        هذا._مهلة = 30 * 60 * 1000  # 30 دقيقة
        هذا._آخر_نشاط = 0
    نهاية

    دالة ابدأ_جلسة(بيانات)
        هذا._جلسة_حالية = {
            معرف: مولّد_معرف()،
            بيانات: بيانات،
            بدأت: وقت_الآن()
        }
        هذا._آخر_نشاط = وقت_الآن()
    نهاية

    دالة أنهِ_جلسة()
        هذا._جلسة_حالية = لاشيء
    نهاية

    دالة سجّل_نشاط()
        هذا._آخر_نشاط = وقت_الآن()
    نهاية

    دالة منتهية؟()
        ارجع (وقت_الآن() - هذا._آخر_نشاط) > هذا._مهلة
    نهاية

    دالة احصل_جلسة()
        إذا (هذا.منتهية؟())
            هذا.أنهِ_جلسة()
            ارجع لاشيء
        نهاية
        ارجع هذا._جلسة_حالية
    نهاية
نهاية

