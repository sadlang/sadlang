# ===================================================================
# Global Key — المفتاح العام
# ===================================================================
# مطابق لـ Flutter GlobalKey, BuildContext
# دعم الوصول للعناصر والحالات عبر المفاتيح
#
# الاستخدام:
#   استورد * من رسومات.مفاتيح_نظام.عام
#
#   متغير مفتاح = مفتاح_عام<حالة_نموذج>()
#   نموذج(مفتاح: مفتاح, ...)
#   مفتاح.الحالة_الحالية().تحقق()
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    مفتاح (Key base class)
# ===================================================================
صدّر صنف مفتاح
    باني(قيمة = لاشيء)
        هذا._قيمة = قيمة
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة يساوي(آخر)
        إذا (آخر == لاشيء)
            ارجع خطأ
        نهاية
        ارجع هذا._قيمة == آخر.القيمة()
    نهاية
نهاية

# ===================================================================
#                    مفتاح_محلي (LocalKey)
# ===================================================================
صدّر صنف مفتاح_محلي يرث مفتاح
    باني(قيمة = لاشيء)
        الأساس.باني(قيمة)
    نهاية
نهاية

# ===================================================================
#                    مفتاح_قيمة (ValueKey)
# ===================================================================
صدّر صنف مفتاح_قيمة يرث مفتاح_محلي
    باني(قيمة)
        الأساس.باني(قيمة)
    نهاية

    دالة التشفير()
        ارجع "قيمة:" + هذا._قيمة
    نهاية
نهاية

# ===================================================================
#                    مفتاح_كائن (ObjectKey)
# ===================================================================
صدّر صنف مفتاح_كائن يرث مفتاح_محلي
    باني(كائن)
        الأساس.باني(كائن)
    نهاية

    دالة التشفير()
        ارجع "كائن:" + هذا._قيمة
    نهاية
نهاية

# ===================================================================
#                    مفتاح_فريد (UniqueKey)
# ===================================================================
صدّر صنف مفتاح_فريد يرث مفتاح_محلي
    ساكن متغير _عداد = 0

    باني()
        مفتاح_فريد._عداد = مفتاح_فريد._عداد + 1
        الأساس.باني("فريد_" + مفتاح_فريد._عداد)
    نهاية
نهاية

# ===================================================================
#                    مفتاح_عام (GlobalKey)
# ===================================================================
صدّر صنف مفتاح_عام يرث مفتاح
    ساكن متغير _مفاتيح = {}
    ساكن متغير _عداد = 0

    باني(معرف_تصحيح = لاشيء)
        مفتاح_عام._عداد = مفتاح_عام._عداد + 1
        متغير معرف = "عام_" + مفتاح_عام._عداد
        الأساس.باني(معرف)
        هذا._معرف_تصحيح = معرف_تصحيح
        هذا._عنصر = لاشيء
        هذا._حالة = لاشيء
        هذا._سياق = لاشيء
        # تسجيل المفتاح
        مفتاح_عام._مفاتيح[معرف] = هذا
    نهاية

    # الوصول للعنصر المرتبط
    دالة العنصر_الحالي()
        ارجع هذا._عنصر
    نهاية

    # الوصول للحالة المرتبطة
    دالة الحالة_الحالية()
        ارجع هذا._حالة
    نهاية

    # الوصول للسياق المرتبط
    دالة السياق_الحالي()
        ارجع هذا._سياق
    نهاية

    # ربط عنصر بالمفتاح
    دالة اربط_عنصر(عنصر)
        هذا._عنصر = عنصر
    نهاية

    # ربط حالة بالمفتاح
    دالة اربط_حالة(حالة)
        هذا._حالة = حالة
    نهاية

    # ربط سياق بالمفتاح
    دالة اربط_سياق(سياق)
        هذا._سياق = سياق
    نهاية

    # إلغاء الربط
    دالة ألغِ_الربط()
        هذا._عنصر = لاشيء
        هذا._حالة = لاشيء
        هذا._سياق = لاشيء
        مفتاح_عام._مفاتيح.احذف(هذا._قيمة)
    نهاية

    # البحث عن مفتاح
    ساكن دالة ابحث(معرف)
        إذا (معرف في مفتاح_عام._مفاتيح)
            ارجع مفتاح_عام._مفاتيح[معرف]
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ===================================================================
#                    مفتاح_عام_كائن (GlobalObjectKey)
# ===================================================================
صدّر صنف مفتاح_عام_كائن يرث مفتاح_عام
    باني(كائن)
        الأساس.باني("كائن_" + كائن)
        هذا._كائن = كائن
    نهاية

    دالة الكائن()
        ارجع هذا._كائن
    نهاية
نهاية

# ===================================================================
#                    سياق_بناء (BuildContext)
# ===================================================================
صدّر صنف سياق_بناء
    باني(عنصر = لاشيء)
        هذا._عنصر = عنصر
        هذا._أب = لاشيء
        هذا._أبناء = []
    نهاية

    # الوصول للعنصر
    دالة العنصر()
        ارجع هذا._عنصر
    نهاية

    # الوصول للأب
    دالة الأب()
        ارجع هذا._أب
    نهاية

    # تعيين الأب
    دالة عيّن_الأب(أب)
        هذا._أب = أب
    نهاية

    # إضافة ابن
    دالة أضف_ابن(سياق)
        هذا._أبناء.أضف(سياق)
        سياق.عيّن_الأب(هذا)
    نهاية

    # الحصول على الحجم
    دالة الحجم()
        إذا (هذا._عنصر != لاشيء)
            ارجع هذا._عنصر.الحجم()
        نهاية
        ارجع لاشيء
    نهاية

    # البحث عن عنصر موروث
    دالة ابحث_عن_سلف(نوع)
        متغير حالي = هذا._أب
        بينما (حالي != لاشيء)
            إذا (حالي.العنصر() != لاشيء)
                إذا (حالي.العنصر().النوع() == نوع)
                    ارجع حالي.العنصر()
                نهاية
            نهاية
            حالي = حالي.الأب()
        نهاية
        ارجع لاشيء
    نهاية

    # حقن تبعية (Dependency Injection)
    دالة تبعية(نوع)
        ارجع هذا.ابحث_عن_سلف(نوع)
    نهاية

    # رسم من جديد
    دالة أعد_البناء()
        إذا (هذا._عنصر != لاشيء)
            هذا._عنصر.أعد_البناء()
        نهاية
    نهاية
نهاية

# ===================================================================
#                    عنصر_موروث (InheritedWidget)
# ===================================================================
صدّر صنف عنصر_موروث يرث عنصر
    باني(ابن = لاشيء, مفتاح = لاشيء)
        هذا._نوع = "عنصر_موروث"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["مفتاح"] = مفتاح
        هذا._مستمعون = []
    نهاية

    # هل يجب تحديث التابعين؟
    دالة يجب_تحديث_التابعين(قديم)
        ارجع صحيح
    نهاية

    # الوصول للبيانات
    ساكن دالة من(سياق)
        # يجب تنفيذها في الصنف الموروث
        ارجع لاشيء
    نهاية

    # تسجيل مستمع
    دالة سجّل_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    # إخطار المستمعين
    دالة أخطر()
        لكل مستمع في هذا._مستمعون
            مستمع()
        نهاية
    نهاية
نهاية

# ===================================================================
#                    إشعارات (Notification)
# ===================================================================
صدّر صنف إشعار
    باني()
        هذا._معالج = خطأ
    نهاية

    دالة أرسل(سياق)
        متغير حالي = سياق
        بينما (حالي != لاشيء و ليس هذا._معالج)
            إذا (حالي.العنصر() != لاشيء)
                إذا (حالي.العنصر().يدعم_إشعار(هذا.النوع()))
                    هذا._معالج = حالي.العنصر().عالج_إشعار(هذا)
                نهاية
            نهاية
            حالي = حالي.الأب()
        نهاية
        ارجع هذا._معالج
    نهاية

    دالة النوع()
        ارجع "إشعار"
    نهاية
نهاية

# ===================================================================
#                    مستمع_إشعارات (NotificationListener)
# ===================================================================
صدّر صنف مستمع_إشعارات يرث عنصر
    باني(ابن = لاشيء, عند_الإشعار = لاشيء, أنواع = [])
        هذا._نوع = "مستمع_إشعارات"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["عند_الإشعار"] = عند_الإشعار
        هذا._خصائص["أنواع"] = أنواع
    نهاية

    دالة يدعم_إشعار(نوع)
        إذا (هذا._خصائص["أنواع"].حجم() == 0)
            ارجع صحيح
        نهاية
        ارجع نوع في هذا._خصائص["أنواع"]
    نهاية

    دالة عالج_إشعار(إشعار)
        إذا (هذا._خصائص["عند_الإشعار"] != لاشيء)
            ارجع هذا._خصائص["عند_الإشعار"](إشعار)
        نهاية
        ارجع خطأ
    نهاية
نهاية

# ===================================================================
#                    دوال مساعدة
# ===================================================================

# إنشاء مفتاح قيمة سريع
صدّر دالة مفتاح(قيمة)
    ارجع مفتاح_قيمة(قيمة)
نهاية

# إنشاء مفتاح عام سريع
صدّر دالة عام()
    ارجع مفتاح_عام()
نهاية

# إنشاء مفتاح فريد
صدّر دالة فريد()
    ارجع مفتاح_فريد()
نهاية
