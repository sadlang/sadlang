استورد * من رسومات.أساس.عنصر

# ─── قناة الرسائل البسيطة ───
صدّر صنف قناة_بسيطة
    باني(اسم)
        هذا.اسم = اسم
        هذا._مُعالِج = لاشيء
    نهاية

    دالة عيّن_معالج(معالج)
        هذا._مُعالِج = معالج
    نهاية

    غير_متزامن دالة أرسل(رسالة)
        ارجع انتظر _أرسل_قناة_بسيطة(هذا.اسم، رسالة)
    نهاية
نهاية

# ─── قناة الطرق (MethodChannel) ───
صدّر صنف قناة_طرق
    باني(اسم، مرمّز = لاشيء)
        هذا.اسم = اسم
        هذا._مرمّز = مرمّز
        إذا (مرمّز == لاشيء)
            هذا._مرمّز = جديد مرمّز_طريقة_قياسي()
        نهاية
        هذا._معالجات = {}
    نهاية

    # استدعاء طريقة على المنصة
    غير_متزامن دالة استدعِ(طريقة، وسائط = لاشيء)
        متغير رسالة_مرمّزة = هذا._مرمّز.رمّز(طريقة، وسائط)
        متغير نتيجة = انتظر _استدعِ_منصة(هذا.اسم، رسالة_مرمّزة)
        ارجع هذا._مرمّز.فكّ(نتيجة)
    نهاية

    # تسجيل معالج للاستدعاءات القادمة من المنصة
    دالة عيّن_معالج_طرق(معالج)
        هذا._معالجات["*"] = معالج
    نهاية

    دالة عيّن_معالج(طريقة، معالج)
        هذا._معالجات[طريقة] = معالج
    نهاية
نهاية

# ─── قناة الأحداث (EventChannel) ───
صدّر صنف قناة_أحداث
    باني(اسم، مرمّز = لاشيء)
        هذا.اسم = اسم
        هذا._مرمّز = مرمّز
        إذا (مرمّز == لاشيء)
            هذا._مرمّز = جديد مرمّز_طريقة_قياسي()
        نهاية
    نهاية

    دالة استلم_بث(وسائط = لاشيء)
        ارجع جديد تيار_قناة_أحداث(هذا، وسائط)
    نهاية
نهاية

# ─── تيار قناة الأحداث ───
صنف تيار_قناة_أحداث
    باني(قناة، وسائط)
        هذا._قناة = قناة
        هذا._وسائط = وسائط
        هذا._مشتركون = []
        هذا._نشط = خطأ
    نهاية

    دالة استمع(على_بيانات، على_خطأ = لاشيء، عند_انتهاء = لاشيء)
        هذا._مشتركون.أضف({
            بيانات: على_بيانات،
            خطأ: على_خطأ،
            انتهاء: عند_انتهاء
        })

        إذا (ليس هذا._نشط)
            هذا._ابدأ()
        نهاية

        ارجع جديد اشتراك_تيار(هذا)
    نهاية

    دالة _ابدأ()
        هذا._نشط = صحيح
        _اشترك_قناة_أحداث(
            هذا._قناة.اسم،
            هذا._وسائط،
            هذا._على_حدث.bind(هذا)،
            هذا._على_خطأ.bind(هذا)
        )
    نهاية

    دالة _على_حدث(حدث)
        لكل مشترك في هذا._مشتركون
            إذا (مشترك.بيانات != لاشيء)
                مشترك.بيانات(حدث)
            نهاية
        نهاية
    نهاية

    دالة _على_خطأ(خطأ)
        لكل مشترك في هذا._مشتركون
            إذا (مشترك.خطأ != لاشيء)
                مشترك.خطأ(خطأ)
            نهاية
        نهاية
    نهاية

    دالة ألغِ(اشتراك)
        # إزالة مشترك
    نهاية
نهاية

# ─── اشتراك تيار ───
صنف اشتراك_تيار
    باني(تيار)
        هذا._تيار = تيار
        هذا._ملغى = خطأ
    نهاية

    دالة ألغِ()
        إذا (ليس هذا._ملغى)
            هذا._ملغى = صحيح
            هذا._تيار.ألغِ(هذا)
        نهاية
    نهاية

    دالة ملغى؟()
        ارجع هذا._ملغى
    نهاية
نهاية

# ─── المرمّزات ───

# المرمّز القياسي للطرق
صدّر صنف مرمّز_طريقة_قياسي
    دالة رمّز(طريقة، وسائط)
        ارجع {
            طريقة: طريقة،
            وسائط: وسائط
        }
    نهاية

    دالة فكّ(رسالة)
        إذا (رسالة == لاشيء)
            ارجع لاشيء
        نهاية
        إذا (رسالة.خطأ != لاشيء)
            ارمي جديد خطأ_منصة(
                رسالة.خطأ.كود،
                رسالة.خطأ.رسالة،
                رسالة.خطأ.تفاصيل
            )
        نهاية
        ارجع رسالة.نتيجة
    نهاية
نهاية

# مرمّز JSON
صدّر صنف مرمّز_طريقة_json
    دالة رمّز(طريقة، وسائط)
        ارجع _إلى_json({
            طريقة: طريقة،
            وسائط: وسائط
        })
    نهاية

    دالة فكّ(رسالة)
        إذا (رسالة == لاشيء)
            ارجع لاشيء
        نهاية
        متغير كائن = _من_json(رسالة)
        إذا (كائن.خطأ != لاشيء)
            ارمي جديد خطأ_منصة(
                كائن.خطأ.كود،
                كائن.خطأ.رسالة،
                كائن.خطأ.تفاصيل
            )
        نهاية
        ارجع كائن.نتيجة
    نهاية
نهاية

# ─── أخطاء المنصة ───
صدّر صنف خطأ_منصة
    باني(كود، رسالة، تفاصيل = لاشيء)
        هذا.كود = كود
        هذا.رسالة = رسالة
        هذا.تفاصيل = تفاصيل
    نهاية

    دالة إلى_نص()
        متغير نص = "خطأ منصة [" + هذا.كود + "]: " + هذا.رسالة
        إذا (هذا.تفاصيل != لاشيء)
            نص = نص + "\nتفاصيل: " + هذا.تفاصيل
        نهاية
        ارجع نص
    نهاية
نهاية

صدّر صنف خطأ_طريقة_غير_موجودة يرث خطأ_منصة
    باني(طريقة)
        الأساس.باني(
            "طريقة_غير_موجودة"،
            "الطريقة '" + طريقة + "' غير موجودة"
        )
        هذا.طريقة = طريقة
    نهاية
نهاية

# ─── نتيجة الطريقة ───
صدّر صنف نتيجة_طريقة
    ساكن دالة نجاح(قيمة = لاشيء)
        ارجع { نتيجة: قيمة }
    نهاية

    ساكن دالة خطأ(كود، رسالة، تفاصيل = لاشيء)
        ارجع {
            خطأ: {
                كود: كود،
                رسالة: رسالة،
                تفاصيل: تفاصيل
            }
        }
    نهاية

    ساكن دالة غير_منفذة()
        ارجع لاشيء
    نهاية
نهاية

# ─── قنوات مدمجة شائعة ───
صدّر صنف قنوات_نظام
    # معلومات الجهاز
    ساكن ثابت معلومات_جهاز = جديد قناة_طرق("sad.system/device_info")

    # الحافظة
    ساكن ثابت حافظة = جديد قناة_طرق("sad.system/clipboard")

    # المسارات
    ساكن ثابت مسارات = جديد قناة_طرق("sad.system/paths")

    # الإشعارات
    ساكن ثابت إشعارات = جديد قناة_طرق("sad.system/notifications")

    # الاهتزاز واللمسيات
    ساكن ثابت لمسيات = جديد قناة_طرق("sad.system/haptics")

    # الكاميرا
    ساكن ثابت كاميرا = جديد قناة_طرق("sad.system/camera")

    # الموقع
    ساكن ثابت موقع = جديد قناة_أحداث("sad.system/location")

    # المستشعرات
    ساكن ثابت مستشعرات = جديد قناة_أحداث("sad.system/sensors")

    # البطارية
    ساكن ثابت بطارية = جديد قناة_أحداث("sad.system/battery")

    # الاتصال
    ساكن ثابت اتصال = جديد قناة_أحداث("sad.system/connectivity")
نهاية

# ─── مساعد قنوات ن المنصة ───
صدّر صنف مساعد_منصة
    ساكن غير_متزامن دالة احصل_معلومات_جهاز()
        ارجع انتظر قنوات_نظام.معلومات_جهاز.استدعِ("getDeviceInfo")
    نهاية

    ساكن غير_متزامن دالة انسخ_للحافظة(نص)
        ارجع انتظر قنوات_نظام.حافظة.استدعِ("setData"، {نص: نص})
    نهاية

    ساكن غير_متزامن دالة الصق_من_حافظة()
        ارجع انتظر قنوات_نظام.حافظة.استدعِ("getData")
    نهاية

    ساكن غير_متزامن دالة احصل_مسار_مستندات()
        ارجع انتظر قنوات_نظام.مسارات.استدعِ("getDocumentsPath")
    نهاية

    ساكن غير_متزامن دالة احصل_مسار_مؤقت()
        ارجع انتظر قنوات_نظام.مسارات.استدعِ("getTempPath")
    نهاية

    ساكن غير_متزامن دالة أظهر_إشعار(عنوان، محتوى)
        ارجع انتظر قنوات_نظام.إشعارات.استدعِ("show"، {
            عنوان: عنوان،
            محتوى: محتوى
        })
    نهاية

    ساكن غير_متزامن دالة اهتز(مدة = 100)
        ارجع انتظر قنوات_نظام.لمسيات.استدعِ("vibrate"، {مدة: مدة})
    نهاية
نهاية
