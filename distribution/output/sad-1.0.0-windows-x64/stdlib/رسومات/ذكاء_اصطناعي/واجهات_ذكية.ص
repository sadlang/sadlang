# العيب #231: ChatInterface - واجهة محادثة ذكية
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر تعداد نوع_رسالة_ذكاء
    مستخدم = 0
    مساعد = 1
    نظام = 2
نهاية

صدّر صنف رسالة_ذكاء
    باني(إعدادات)
        هذا.معرف = إعدادات.معرف أو مولّد_معرف()
        هذا.نوع = إعدادات.نوع أو نوع_رسالة_ذكاء.مستخدم
        هذا.محتوى = إعدادات.محتوى أو ""
        هذا.وقت = إعدادات.وقت أو وقت_حالي()
        هذا.مرفقات = إعدادات.مرفقات أو []
        هذا._حالة = "مكتمل"  # يكتب، مكتمل، خطأ
    نهاية
نهاية

صدّر صنف واجهة_محادثة_ذكية
    باني(إعدادات)
        هذا._رسائل = إعدادات.رسائل أو []
        هذا._عند_إرسال = إعدادات.عند_إرسال أو لاشيء
        هذا._مزود = إعدادات.مزود أو لاشيء
        هذا._أظهر_كتابة = إعدادات.أظهر_كتابة أو صحيح
        هذا._تلميح = إعدادات.تلميح أو "اكتب رسالتك..."
        هذا._صلاحيات_صوت = إعدادات.صلاحيات_صوت أو خطأ
        هذا._صلاحيات_صور = إعدادات.صلاحيات_صور أو خطأ
    نهاية

    غير_متزامن دالة أرسل(نص)
        متغير رسالة_مستخدم = جديد رسالة_ذكاء({
            نوع: نوع_رسالة_ذكاء.مستخدم،
            محتوى: نص
        })
        هذا._رسائل.أضف(رسالة_مستخدم)

        إذا (هذا._عند_إرسال)
            انتظر هذا._عند_إرسال(رسالة_مستخدم)
        نهاية
    نهاية

    دالة أضف_رد(محتوى)
        متغير رسالة = جديد رسالة_ذكاء({
            نوع: نوع_رسالة_ذكاء.مساعد،
            محتوى: محتوى
        })
        هذا._رسائل.أضف(رسالة)
    نهاية

    دالة امسح()
        هذا._رسائل = []
    نهاية

    دالة بناء()
        ارجع {
            نوع: "واجهة_محادثة_ذكية"،
            رسائل: هذا._رسائل،
            تلميح: هذا._تلميح
        }
    نهاية
نهاية

