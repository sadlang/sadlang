استورد * من رسومات.اختبار.فحص

# ═══════════════════════════════════════════
# اختبارات الحركات الأساسية
# ═══════════════════════════════════════════
مجموعة("الحركات الأساسية", لامدا()
    اختبر("استيفاء خطي", لامدا()
        دالة استيفاء(بداية, نهاية_ق, ن)
            ارجع بداية + (نهاية_ق - بداية) * ن
        نهاية

        توقع(استيفاء(0, 100, 0), 0, "بداية الاستيفاء")
        توقع(استيفاء(0, 100, 1), 100, "نهاية الاستيفاء")
        توقع(استيفاء(0, 100, 0.5), 50, "منتصف الاستيفاء")
    نهاية)

    اختبر("منحنى تسارع", لامدا()
        # تسارع بسيط: ن^2
        دالة تسارع(ن)
            ارجع ن * ن
        نهاية

        توقع(تسارع(0), 0, "بداية التسارع")
        توقع(تسارع(1), 1, "نهاية التسارع")
    نهاية)

    اختبر("منحنى تباطؤ", لامدا()
        # تباطؤ: 1 - (1-ن)^2
        دالة تباطؤ(ن)
            ارجع 1 - (1 - ن) * (1 - ن)
        نهاية

        توقع(تباطؤ(0), 0, "بداية التباطؤ")
        توقع(تباطؤ(1), 1, "نهاية التباطؤ")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات الألوان
# ═══════════════════════════════════════════
مجموعة("الألوان", لامدا()
    اختبر("إنشاء لون", لامدا()
        متغير لون = {"أحمر": 255, "أخضر": 128, "أزرق": 0, "شفافية": 255}
        توقع(لون["أحمر"], 255, "قيمة الأحمر")
        توقع(لون["أخضر"], 128, "قيمة الأخضر")
        توقع(لون["أزرق"], 0, "قيمة الأزرق")
    نهاية)

    اختبر("مزج ألوان", لامدا()
        دالة امزج(لون1, لون2, نسبة)
            متغير ر = {}
            ر["أحمر"] = لون1["أحمر"] + (لون2["أحمر"] - لون1["أحمر"]) * نسبة
            ر["أخضر"] = لون1["أخضر"] + (لون2["أخضر"] - لون1["أخضر"]) * نسبة
            ر["أزرق"] = لون1["أزرق"] + (لون2["أزرق"] - لون1["أزرق"]) * نسبة
            ارجع ر
        نهاية

        متغير أبيض = {"أحمر": 255, "أخضر": 255, "أزرق": 255}
        متغير أسود = {"أحمر": 0, "أخضر": 0, "أزرق": 0}
        متغير رمادي = امزج(أسود, أبيض, 0.5)
        # 0 + (255-0)*0.5 = 127.5
        توقع_ليس_لاشيء(رمادي, "الناتج ليس فارغ")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات إطار الحركة
# ═══════════════════════════════════════════
مجموعة("إطار الحركة", لامدا()
    اختبر("إنشاء حركة", لامدا()
        متغير حركة = {
            "بداية": 0,
            "نهاية_ق": 100,
            "مدة": 1000,
            "حالة": "متوقف",
            "إطار_حالي": 0
        }
        توقع(حركة["حالة"], "متوقف", "حالة أولية")
        توقع(حركة["إطار_حالي"], 0, "إطار أول")
    نهاية)

    اختبر("تشغيل وإيقاف حركة", لامدا()
        متغير حركة = {"حالة": "متوقف"}
        حركة["حالة"] = "يعمل"
        توقع(حركة["حالة"], "يعمل", "الحركة تعمل")
        حركة["حالة"] = "متوقف"
        توقع(حركة["حالة"], "متوقف", "الحركة متوقفة")
    نهاية)

    اختبر("تسلسل حركات", لامدا()
        متغير تسلسل = [
            {"اسم": "ظهور", "مدة": 300},
            {"اسم": "انتظار", "مدة": 500},
            {"اسم": "اختفاء", "مدة": 300}
        ]
        متغير المدة_الكلية = 0
        لكل حركة في تسلسل
            المدة_الكلية = المدة_الكلية + حركة["مدة"]
        نهاية
        توقع(المدة_الكلية, 1100, "المدة الكلية للتسلسل")
    نهاية)
نهاية)

# ─── تشغيل ───
شغّل_اختبارات()
