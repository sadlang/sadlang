# ===================================================================
# اختبارات شاملة — الحركات والرسوم المتحركة
# ===================================================================
# يختبر: حركات.ص, canvas API, أشكال
#
# الاستخدام:
#   sad.exe stdlib/ui/اختبار/اختبار_حركات.ص
