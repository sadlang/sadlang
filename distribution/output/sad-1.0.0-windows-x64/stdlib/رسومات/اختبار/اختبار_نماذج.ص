# ═══════════════════════════════════════════
# اختبارات التحقق من المدخلات
# ═══════════════════════════════════════════
مجموعة("التحقق من المدخلات", لامدا()
    اختبر("التحقق من حقل مطلوب", لامدا()
        دالة مطلوب(قيمة)
            إذا (قيمة == لاشيء أو قيمة == "")
                ارجع "هذا الحقل مطلوب"
            نهاية
            ارجع لاشيء
        نهاية

        توقع(مطلوب(""), "هذا الحقل مطلوب", "حقل فارغ")
        توقع(مطلوب(لاشيء), "هذا الحقل مطلوب", "حقل لاشيء")
        توقع_لاشيء(مطلوب("نص"), "حقل صحيح")
    نهاية)

    اختبر("التحقق من البريد الإلكتروني", لامدا()
        دالة بريد_صحيح(قيمة)
            إذا (قيمة == لاشيء أو قيمة == "")
                ارجع "البريد مطلوب"
            نهاية
            # تحقق بسيط من وجود @
            متغير يحتوي = خطأ
            لكل حرف في قيمة
                إذا (حرف == "@")
                    يحتوي = صحيح
                نهاية
            نهاية
            إذا (ليس يحتوي)
                ارجع "بريد إلكتروني غير صالح"
            نهاية
            ارجع لاشيء
        نهاية

        توقع(بريد_صحيح(""), "البريد مطلوب", "بريد فارغ")
        توقع(بريد_صحيح("بدون_آت"), "بريد إلكتروني غير صالح", "بريد بدون @")
        توقع_لاشيء(بريد_صحيح("test@example.com"), "بريد صحيح")
    نهاية)

    اختبر("التحقق من طول النص", لامدا()
        دالة حد_أدنى(قيمة, أدنى)
            إذا (قيمة == لاشيء)
                ارجع "القيمة مطلوبة"
            نهاية
            إذا (قيمة.طول() < أدنى)
                ارجع "الحد الأدنى " + أدنى + " حرف"
            نهاية
            ارجع لاشيء
        نهاية

        توقع(حد_أدنى("أب", 3), "الحد الأدنى 3 حرف", "نص قصير")
        توقع_لاشيء(حد_أدنى("أحمد", 3), "نص بطول كافٍ")
    نهاية)

    اختبر("التحقق من نطاق رقمي", لامدا()
        دالة في_نطاق(قيمة, أدنى, أقصى)
            إذا (قيمة < أدنى أو قيمة > أقصى)
                ارجع "القيمة يجب أن تكون بين " + أدنى + " و " + أقصى
            نهاية
            ارجع لاشيء
        نهاية

        توقع_لاشيء(في_نطاق(5, 1, 10), "قيمة في النطاق")
        توقع_ليس_لاشيء(في_نطاق(15, 1, 10), "قيمة خارج النطاق")
        توقع_ليس_لاشيء(في_نطاق(0, 1, 10), "قيمة أقل من الأدنى")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات النماذج
# ═══════════════════════════════════════════
مجموعة("النماذج", لامدا()
    اختبر("إنشاء نموذج", لامدا()
        متغير نموذج = {
            "حقول": {
                "اسم": {"قيمة": "", "خطأ": لاشيء},
                "بريد": {"قيمة": "", "خطأ": لاشيء},
                "كلمة_سر": {"قيمة": "", "خطأ": لاشيء}
            },
            "صالح": خطأ
        }
        توقع_ليس_لاشيء(نموذج, "إنشاء النموذج")
        توقع_خطأ(نموذج["صالح"], "النموذج غير صالح مبدئياً")
    نهاية)

    اختبر("تعيين قيم الحقول", لامدا()
        متغير حقول = {
            "اسم": {"قيمة": "", "خطأ": لاشيء}
        }

        حقول["اسم"]["قيمة"] = "أحمد"
        توقع(حقول["اسم"]["قيمة"], "أحمد", "تعيين قيمة الحقل")
    نهاية)

    اختبر("التحقق من كل الحقول", لامدا()
        متغير حقول = {
            "اسم": {"قيمة": "أحمد", "تحقق": لامدا(ق) إذا (ق == "") ارجع "مطلوب" نهاية ارجع لاشيء نهاية},
            "عمر": {"قيمة": 25, "تحقق": لامدا(ق) إذا (ق < 0) ارجع "غير صالح" نهاية ارجع لاشيء نهاية}
        }

        متغير كل_صالح = صحيح
        لكل اسم في ["اسم", "عمر"]
            متغير حقل = حقول[اسم]
            متغير خطأ_ح = حقل["تحقق"](حقل["قيمة"])
            إذا (خطأ_ح != لاشيء)
                كل_صالح = خطأ
            نهاية
        نهاية

        توقع_صحيح(كل_صالح, "كل الحقول صالحة")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات متحكم الإدخال
# ═══════════════════════════════════════════
مجموعة("متحكم الإدخال", لامدا()
    اختبر("متحكم نصي", لامدا()
        متغير متحكم = {"نص": "", "مستمعون": []}

        # تعيين نص
        متحكم["نص"] = "مرحبا بالعالم"
        توقع(متحكم["نص"], "مرحبا بالعالم", "تعيين نص المتحكم")

        # مسح النص
        متحكم["نص"] = ""
        توقع(متحكم["نص"], "", "مسح نص المتحكم")
    نهاية)
نهاية)

# ─── تشغيل ───
شغّل_اختبارات()
