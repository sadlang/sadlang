# اختبارات التدفق الأساسي
# ═══════════════════════════════════════════
مجموعة("التدفق الأساسي", لامدا()
    اختبر("إنشاء تدفق", لامدا()
        متغير تدفق = {
            "قيم": [],
            "مستمعون": [],
            "مغلق": خطأ
        }
        توقع_ليس_لاشيء(تدفق, "إنشاء التدفق")
        توقع_خطأ(تدفق["مغلق"], "التدفق مفتوح")
    نهاية)

    اختبر("إضافة قيمة للتدفق", لامدا()
        متغير قيم_مستقبلة = []
        متغير تدفق = {
            "مستمعون": [لامدا(قيمة) قيم_مستقبلة.أضف(قيمة) نهاية]
        }

        # إرسال قيم
        لكل مستمع في تدفق["مستمعون"]
            مستمع(42)
        نهاية

        توقع(قيم_مستقبلة.طول(), 1, "عدد القيم المستقبلة")
        توقع(قيم_مستقبلة[0], 42, "القيمة المستقبلة")
    نهاية)

    اختبر("عدة قيم في التدفق", لامدا()
        متغير قيم = []
        متغير مستمع = لامدا(ق) قيم.أضف(ق) نهاية

        مستمع(1)
        مستمع(2)
        مستمع(3)

        توقع(قيم.طول(), 3, "ثلاث قيم")
        توقع(قيم[0], 1, "القيمة الأولى")
        توقع(قيم[2], 3, "القيمة الثالثة")
    نهاية)

    اختبر("إغلاق التدفق", لامدا()
        متغير تدفق = {"مغلق": خطأ}
        تدفق["مغلق"] = صحيح
        توقع_صحيح(تدفق["مغلق"], "التدفق مغلق")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات BLoC
# ═══════════════════════════════════════════
مجموعة("نمط BLoC", لامدا()
    اختبر("BLoC عداد", لامدا()
        # تعريف BLoC بسيط
        متغير حالة = 0
        متغير مستمعون = []

        دالة أرسل(حدث)
            إذا (حدث == "زيادة")
                حالة = حالة + 1
            وإلا
                إذا (حدث == "نقصان")
                    حالة = حالة - 1
                نهاية
            نهاية
            # إخطار المستمعين
            لكل م في مستمعون
                م(حالة)
            نهاية
        نهاية

        متغير آخر_حالة = لاشيء
        مستمعون.أضف(لامدا(ح) آخر_حالة = ح نهاية)

        أرسل("زيادة")
        توقع(آخر_حالة, 1, "بعد الزيادة")
        أرسل("زيادة")
        توقع(آخر_حالة, 2, "بعد زيادة ثانية")
        أرسل("نقصان")
        توقع(آخر_حالة, 1, "بعد النقصان")
    نهاية)

    اختبر("تحويل التدفق (map)", لامدا()
        متغير قيم = [1, 2, 3, 4, 5]
        متغير مضاعفة = []
        لكل ق في قيم
            مضاعفة.أضف(ق * 2)
        نهاية

        توقع(مضاعفة[0], 2, "أول قيمة مضاعفة")
        توقع(مضاعفة[4], 10, "آخر قيمة مضاعفة")
    نهاية)

    اختبر("ترشيح التدفق (where)", لامدا()
        متغير قيم = [1, 2, 3, 4, 5, 6, 7, 8]
        متغير زوجية = []
        لكل ق في قيم
            إذا (ق % 2 == 0)
                زوجية.أضف(ق)
            نهاية
        نهاية

        توقع(زوجية.طول(), 4, "عدد الأرقام الزوجية")
        توقع(زوجية[0], 2, "أول رقم زوجي")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات تقليل (reduce/fold)
# ═══════════════════════════════════════════
مجموعة("تقليل التدفق", لامدا()
    اختبر("مجموع عبر الطي", لامدا()
        متغير قيم = [1, 2, 3, 4, 5]
        متغير مجموع = 0
        لكل ق في قيم
            مجموع = مجموع + ق
        نهاية
        توقع(مجموع, 15, "مجموع 1-5")
    نهاية)

    اختبر("الحد الأقصى عبر الطي", لامدا()
        متغير قيم = [3, 7, 2, 9, 1]
        متغير أقصى = قيم[0]
        لكل ق في قيم
            إذا (ق > أقصى)
                أقصى = ق
            نهاية
        نهاية
        توقع(أقصى, 9, "الحد الأقصى")
    نهاية)
نهاية)

# ─── تشغيل ───
شغّل_اختبارات()
