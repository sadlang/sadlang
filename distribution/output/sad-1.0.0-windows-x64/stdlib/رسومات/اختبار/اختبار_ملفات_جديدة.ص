# ─── اختبار باني التخطيط ───
اختبر دالة اختبار_بانٍ_تخطيط()
    اطبع("اختبار: بانٍ التخطيط...")
    
    # محاكاة قيود الصندوق
    متغير قيود = {
        أقصى_عرض: 400،
        أقصى_ارتفاع: 800،
        أدنى_عرض: 0،
        أدنى_ارتفاع: 0
    }
    
    # اختبار التحقق من القيود
    متغير عرض_مطلوب = 300
    متغير عرض_فعلي = عرض_مطلوب
    
    إذا (عرض_مطلوب > قيود.أقصى_عرض)
        عرض_فعلي = قيود.أقصى_عرض
    نهاية
    
    تأكد(عرض_فعلي == 300، "تطبيق القيود")
    
    اطبع("✅ بانٍ التخطيط: نجح")
