# ─── اختبار عنصر موروث ───
اختبر دالة اختبار_عنصر_موروث()
    اطبع("اختبار: عنصر موروث...")
    
    # محاكاة InheritedWidget
    متغير بيانات = {قيمة: 42}
    متغير تابعين = []
    
    # تسجيل تابع
    تابعين.أضف({إعادة_بناء: لامدا() => اطبع("إعادة بناء")})
    
    تأكد(تابعين.الطول() == 1، "تسجيل التابع")
    
    اطبع("✅ عنصر موروث: نجح")
نهاية

# ─── اختبار استعلام الوسائط ───
اختبر دالة اختبار_استعلام_وسائط()
    اطبع("اختبار: استعلام الوسائط...")
    
    متغير عرض = 1920
    متغير ارتفاع = 1080
    متغير كثافة = 1.5
    
    # تحديد نوع الجهاز
    متغير نوع_جهاز = "سطح_مكتب"
    إذا (عرض < 600)
        نوع_جهاز = "هاتف"
    وإلا إذا (عرض < 1200)
        نوع_جهاز = "لوحي"
    نهاية
    
    تأكد(نوع_جهاز == "سطح_مكتب"، "تحديد نوع الجهاز")
    
    اطبع("✅ استعلام الوسائط: نجح")
نهاية

# ─── اختبار البانٍ غير المتزامن ───
اختبر دالة اختبار_بانٍ_غير_متزامن()
    اطبع("اختبار: بانٍ غير متزامن...")
    
    # محاكاة لقطة غير متزامنة
    متغير لقطة = {
        حالة: "انتظار"،
        بيانات: لاشيء،
        خطأ: لاشيء
    }
    
    تأكد(لقطة.حالة == "انتظار"، "الحالة الابتدائية")
    
    # محاكاة اكتمال
    لقطة.حالة = "مكتمل"
    لقطة.بيانات = "نتيجة"
    
    تأكد(لقطة.حالة == "مكتمل"، "الحالة بعد الاكتمال")
    تأكد(لقطة.بيانات == "نتيجة"، "البيانات")
    
    اطبع("✅ بانٍ غير متزامن: نجح")
نهاية

