استورد * من رسومات.تفاعل.إيماءات_متقدمة
استورد * من رسومات.اختبار.إطار_اختبار

# ─── اختبار تفاصيل النقر ───
اختبر دالة اختبار_تفاصيل_نقر()
    متغير موضع_محلي = {س: 100، ص: 200}
    متغير موضع_عام = {س: 150، ص: 250}
    متغير تفاصيل = جديد تفاصيل_نقر(موضع_محلي، موضع_عام)
    
    تأكد(تفاصيل.موضع_محلي.س == 100، "موضع محلي س")
    تأكد(تفاصيل.موضع_محلي.ص == 200، "موضع محلي ص")
    تأكد(تفاصيل.موضع_عام.س == 150، "موضع عام س")
    تأكد(تفاصيل.موضع_عام.ص == 250، "موضع عام ص")
    تأكد(تفاصيل.نوع == "نقر"، "نوع التفاصيل")
    
    اطبع("✅ اختبار تفاصيل النقر: نجح")
نهاية

# ─── اختبار تفاصيل السحب ───
اختبر دالة اختبار_تفاصيل_سحب()
    متغير تفاصيل = جديد تفاصيل_سحب()
    
    تأكد(تفاصيل.الإزاحة_س() == 0، "إزاحة س الابتدائية")
    تأكد(تفاصيل.الإزاحة_ص() == 0، "إزاحة ص الابتدائية")
    
    تفاصيل.إزاحة["س"] = 50
    تفاصيل.إزاحة["ص"] = 75
    
    تأكد(تفاصيل.الإزاحة_س() == 50، "إزاحة س بعد التحديث")
    تأكد(تفاصيل.الإزاحة_ص() == 75، "إزاحة ص بعد التحديث")
    
    اطبع("✅ اختبار تفاصيل السحب: نجح")
نهاية

# ─── اختبار تفاصيل التحجيم ───
اختبر دالة اختبار_تفاصيل_تحجيم()
    متغير تفاصيل = جديد تفاصيل_تحجيم()
    
    تأكد(تفاصيل.مقياس == 1.0، "المقياس الافتراضي")
    تأكد(تفاصيل.دوران == 0.0، "الدوران الافتراضي")
    تأكد(تفاصيل.عدد_المؤشرات == 0، "عدد المؤشرات الافتراضي")
    
    اطبع("✅ اختبار تفاصيل التحجيم: نجح")
نهاية

# ─── اختبار كاشف الإيماءات ───
اختبر دالة اختبار_كاشف_إيماءات()
    متغير نقرات = 0
    
    متغير كاشف = جديد كاشف_إيماءات(
        لاشيء،
        عند_النقر: لامدا() => نقرات += 1
    )
    
    تأكد(كاشف._نوع == "كاشف_إيماءات"، "نوع الكاشف")
    تأكد(كاشف._عند_النقر != لاشيء، "تسجيل دالة النقر")
    
    اطبع("✅ اختبار كاشف الإيماءات: نجح")
نهاية

# ─── اختبار قابل للسحب ───
اختبر دالة اختبار_قابل_للسحب()
    متغير بيانات = {معرف: 123، اسم: "عنصر"}
    
    متغير عنصر = جديد قابل_للسحب(
        لاشيء،
        بيانات،
        محور: "أفقي"
    )
    
    تأكد(عنصر._نوع == "قابل_للسحب"، "نوع العنصر")
    تأكد(عنصر._محور == "أفقي"، "المحور")
    تأكد(عنصر._بيانات.معرف == 123، "البيانات")
    
    اطبع("✅ اختبار قابل للسحب: نجح")
نهاية

# ─── اختبار إيماءة مخصصة ───
اختبر دالة اختبار_إيماءات_مخصصة()
    متغير إيماءة = جديد إيماءة_ضغطتين()
    
    تأكد(إيماءة._اسم == "ضغطتين"، "اسم الإيماءة")
    تأكد(إيماءة._حالة == "جاهز"، "الحالة الابتدائية")
    
    متغير تم_التعرف = خطأ
    إيماءة.عند_التعرف(لامدا() => تم_التعرف = صحيح)
    
    تأكد(إيماءة._عند_التعرف != لاشيء، "تسجيل دالة التعرف")
    
    اطبع("✅ اختبار إيماءات مخصصة: نجح")
