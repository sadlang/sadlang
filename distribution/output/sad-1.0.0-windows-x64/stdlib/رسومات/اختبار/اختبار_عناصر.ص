استورد * من رسومات.اختبار.فحص

# ═══════════════════════════════════════════
# اختبارات العناصر الأساسية
# ═══════════════════════════════════════════
مجموعة("العناصر الأساسية", لامدا()
    اختبر("إنشاء عنصر نصي", لامدا()
        متغير عنصر = {
            "_نوع": "نص",
            "_خصائص": {"قيمة": "مرحبا", "حجم": 16},
            "_أبناء": []
        }
        توقع(عنصر["_نوع"], "نص", "نوع العنصر")
        توقع(عنصر["_خصائص"]["قيمة"], "مرحبا", "قيمة النص")
    نهاية)

    اختبر("إنشاء عنصر زر", لامدا()
        متغير ضُغط = خطأ
        متغير زر = {
            "_نوع": "زر",
            "_خصائص": {
                "نص": "اضغط هنا",
                "عند_الضغط": لامدا() ضُغط = صحيح نهاية
            }
        }
        توقع(زر["_نوع"], "زر", "نوع الزر")
        توقع(زر["_خصائص"]["نص"], "اضغط هنا", "نص الزر")
    نهاية)

    اختبر("عنصر بأطفال", لامدا()
        متغير حاوية = {
            "_نوع": "عمود",
            "_أبناء": [
                {"_نوع": "نص", "_خصائص": {"قيمة": "أول"}},
                {"_نوع": "نص", "_خصائص": {"قيمة": "ثاني"}},
                {"_نوع": "نص", "_خصائص": {"قيمة": "ثالث"}}
            ]
        }
        توقع(حاوية["_أبناء"].طول(), 3, "عدد الأطفال")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات العناصر المتقدمة
# ═══════════════════════════════════════════
مجموعة("عناصر متقدمة", لامدا()
    اختبر("لوح سفلي", لامدا()
        متغير لوح = {
            "_نوع": "لوح_سفلي",
            "_خصائص": {"ارتفاع": 300, "قابل_سحب": صحيح}
        }
        توقع(لوح["_نوع"], "لوح_سفلي", "نوع اللوح")
        توقع(لوح["_خصائص"]["ارتفاع"], 300, "ارتفاع اللوح")
        توقع_صحيح(لوح["_خصائص"]["قابل_سحب"], "اللوح قابل للسحب")
    نهاية)

    اختبر("شريط رسالة", لامدا()
        متغير شريط = {
            "_نوع": "شريط_رسالة",
            "_خصائص": {"رسالة": "تم الحفظ بنجاح", "مدة": 3000}
        }
        توقع(شريط["_خصائص"]["رسالة"], "تم الحفظ بنجاح", "نص الرسالة")
        توقع(شريط["_خصائص"]["مدة"], 3000, "مدة العرض")
    نهاية)

    اختبر("خطوات", لامدا()
        متغير خطوات = {
            "_نوع": "خطوات",
            "_خصائص": {
                "الحالي": 0,
                "خطوات_قائمة": [
                    {"عنوان": "البيانات الشخصية", "مكتمل": خطأ},
                    {"عنوان": "العنوان", "مكتمل": خطأ},
                    {"عنوان": "التأكيد", "مكتمل": خطأ}
                ]
            }
        }
        توقع(خطوات["_خصائص"]["الحالي"], 0, "الخطوة الحالية")
    نهاية)

    اختبر("درج جانبي", لامدا()
        متغير درج = {
            "_نوع": "درج",
            "_خصائص": {"عرض": 280, "اتجاه": "يسار"}
        }
        توقع(درج["_نوع"], "درج", "نوع الدرج")
        توقع(درج["_خصائص"]["عرض"], 280, "عرض الدرج")
    نهاية)

    اختبر("زر عائم", لامدا()
        متغير زر = {
            "_نوع": "زر_عائم",
            "_خصائص": {"أيقونة": "إضافة", "لون": "أزرق"}
        }
        توقع(زر["_نوع"], "زر_عائم", "نوع الزر العائم")
    نهاية)

    اختبر("شريط بحث", لامدا()
        متغير بحث = {
            "_نوع": "شريط_بحث",
            "_خصائص": {"تلميح": "ابحث هنا..."}
        }
        توقع(بحث["_خصائص"]["تلميح"], "ابحث هنا...", "تلميح البحث")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات الرسم
# ═══════════════════════════════════════════
مجموعة("نظام الرسم", لامدا()
    اختبر("إنشاء نقطة", لامدا()
        متغير ن = {"س": 10, "ص": 20}
        توقع(ن["س"], 10, "إحداثي س")
        توقع(ن["ص"], 20, "إحداثي ص")
    نهاية)

    اختبر("إنشاء مستطيل", لامدا()
        متغير م = {"يسار": 0, "أعلى": 0, "عرض": 100, "ارتفاع": 50}
        توقع(م["عرض"], 100, "عرض المستطيل")
        توقع(م["ارتفاع"], 50, "ارتفاع المستطيل")
    نهاية)

    اختبر("إنشاء فرشاة", لامدا()
        متغير ف = {
            "لون": {"أحمر": 255, "أخضر": 0, "أزرق": 0},
            "نمط": "ملء",
            "سمك": 2.0
        }
        توقع(ف["نمط"], "ملء", "نمط الفرشاة")
        توقع(ف["سمك"], 2.0, "سمك الخط")
    نهاية)

    اختبر("إنشاء مسار", لامدا()
        متغير أوامر = []
        أوامر.أضف({"نوع": "انتقال", "س": 0, "ص": 0})
        أوامر.أضف({"نوع": "خط", "س": 100, "ص": 0})
        أوامر.أضف({"نوع": "خط", "س": 50, "ص": 86})
        أوامر.أضف({"نوع": "إغلاق"})

        توقع(أوامر.طول(), 4, "عدد أوامر المسار")
        توقع(أوامر[0]["نوع"], "انتقال", "أول أمر")
        توقع(أوامر[3]["نوع"], "إغلاق", "آخر أمر")
    نهاية)

    اختبر("عمليات اللوحة", لامدا()
        متغير عمليات = []
        عمليات.أضف({"نوع": "مسح"})
        عمليات.أضف({"نوع": "دائرة", "س": 200, "ص": 200, "نصف_قطر": 50})
        عمليات.أضف({"نوع": "مستطيل", "يسار": 10, "أعلى": 10, "عرض": 80, "ارتفاع": 40})

        توقع(عمليات.طول(), 3, "عدد عمليات الرسم")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات شريط التنقل
# ═══════════════════════════════════════════
مجموعة("شريط التنقل السفلي", لامدا()
    اختبر("إنشاء شريط تنقل", لامدا()
        متغير شريط = {
            "_نوع": "شريط_تنقل_سفلي",
            "_خصائص": {
                "الحالي": 0,
                "عناصر": [
                    {"أيقونة": "رئيسية", "تسمية": "الرئيسية"},
                    {"أيقونة": "بحث", "تسمية": "بحث"},
                    {"أيقونة": "ملف", "تسمية": "حسابي"}
                ]
            }
        }
        توقع(شريط["_خصائص"]["الحالي"], 0, "العنصر الحالي")
    نهاية)

    اختبر("التنقل بين التبويبات", لامدا()
        متغير حالي = 0
        دالة انتقل(فهرس)
            حالي = فهرس
        نهاية
        انتقل(2)
        توقع(حالي, 2, "الانتقال للتبويب الثالث")
        انتقل(0)
        توقع(حالي, 0, "العودة للتبويب الأول")
    نهاية)
نهاية)

# ─── تشغيل ───
شغّل_اختبارات()
