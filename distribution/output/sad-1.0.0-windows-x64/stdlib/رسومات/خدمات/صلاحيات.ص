# ===================================================================
#       مدير_صلاحيات — Permissions Manager
# ===================================================================

صدّر صنف مدير_صلاحيات
    باني()
        هذا._ذاكرة = {}
    نهاية

    ## طلب صلاحية
    دالة اطلب(صلاحية)
        حاول
            متغير نتيجة = اطلب_اذن(صلاحية)
            هذا._ذاكرة[صلاحية] = نتيجة
            ارجع نتيجة
        امسك خ
            ارجع حالة_صلاحية.مرفوضة
        نهاية
    نهاية

    ## التحقق من صلاحية (بدون طلب)
    دالة تحقق(صلاحية)
        حاول
            متغير نتيجة = تحقق_اذن(صلاحية)
            هذا._ذاكرة[صلاحية] = نتيجة
            ارجع نتيجة
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## هل الصلاحية ممنوحة؟
    دالة ممنوحة(صلاحية)
        ارجع هذا.تحقق(صلاحية) == صحيح
    نهاية

    ## طلب عدة صلاحيات
    دالة اطلب_متعدد(صلاحيات)
        متغير نتائج = {}
        لكل ص في صلاحيات
            نتائج[ص] = هذا.اطلب(ص)
        نهاية
        ارجع نتائج
    نهاية

    ## هل كل الصلاحيات ممنوحة؟
    دالة الكل_ممنوح(صلاحيات)
        لكل ص في صلاحيات
            إذا (ليس هذا.ممنوحة(ص))
                ارجع خطأ
            نهاية
        نهاية
        ارجع صحيح
    نهاية

    ## فتح إعدادات التطبيق (لتعديل الصلاحيات يدوياً)
    دالة افتح_الإعدادات()
        حاول
            افتح_إعدادات_تطبيق()
        امسك خ
            # تجاهل — غير مدعوم
        نهاية
    نهاية
نهاية

