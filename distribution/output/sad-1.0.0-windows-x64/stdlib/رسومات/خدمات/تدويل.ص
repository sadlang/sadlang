# ===================================================================
# خدمة التدويل — i18n Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/تدويل.ص
# ===================================================================
# مكتبة تدويل شاملة تدعم:
#   - ترجمة النصوص بالمفاتيح
#   - تحميل ملفات ترجمة
#   - الجمع والتثنية (Pluralization)
#   - استبدال المتغيرات في النصوص
#   - كشف لغة الجهاز
#   - اتجاه النص (RTL/LTR)
#
# المنصات المدعومة:
#   ✅ جميع المنصات (مبني بالكامل بلغة ص)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    تعدادات
# ===================================================================

صدّر تعداد اتجاه_نص
    من_اليمين    # RTL — العربية، العبرية
    من_اليسار    # LTR — الإنجليزية
نهاية

# ===================================================================
#       مترجم — i18n Manager
# ===================================================================

صدّر صنف مترجم
    باني(لغة_افتراضية = "ar")
        هذا._اللغة = لغة_افتراضية
        هذا._ترجمات = {}
        هذا._لغة_احتياطية = "ar"
    نهاية

    ## تعيين اللغة الحالية
    دالة اللغة(رمز = لاشيء)
        إذا (رمز != لاشيء)
            هذا._اللغة = رمز
            حاول
                عين_لغة(رمز)
            امسك خ
                # تجاهل
            نهاية
            ارجع هذا
        نهاية
        ارجع هذا._اللغة
    نهاية

    ## إضافة ترجمات لغة كاملة
    دالة أضف_لغة(رمز, ترجمات)
        هذا._ترجمات[رمز] = ترجمات
        ارجع هذا
    نهاية

    ## إضافة ترجمة مفردة
    دالة أضف(مفتاح, قيمة, لغة = لاشيء)
        إذا (لغة == لاشيء)
            لغة = هذا._اللغة
        نهاية
        إذا (هذا._ترجمات[لغة] == لاشيء)
            هذا._ترجمات[لغة] = {}
        نهاية
        هذا._ترجمات[لغة][مفتاح] = قيمة
        ارجع هذا
    نهاية

    ## ترجمة مفتاح
    دالة ت(مفتاح, متغيرات = لاشيء)
        # محاولة اللغة الحالية
        متغير نص = هذا._احصل_ترجمة(هذا._اللغة, مفتاح)
        إذا (نص == لاشيء)
            # محاولة اللغة الاحتياطية
            نص = هذا._احصل_ترجمة(هذا._لغة_احتياطية, مفتاح)
        نهاية
        إذا (نص == لاشيء)
            # محاولة الترجمة من المحرك
            حاول
                نص = ترجم(مفتاح)
            امسك خ
                نص = مفتاح
            نهاية
        نهاية
        إذا (متغيرات != لاشيء)
            نص = هذا._استبدل(نص, متغيرات)
        نهاية
        ارجع نص
    نهاية

    ## اتجاه النص للغة الحالية
    دالة الاتجاه()
        إذا (هذا._اللغة == "ar" أو هذا._اللغة == "he" أو هذا._اللغة == "fa" أو هذا._اللغة == "ur")
            ارجع اتجاه_نص.من_اليمين
        نهاية
        ارجع اتجاه_نص.من_اليسار
    نهاية

    ## هل اللغة RTL؟
    دالة يمين_لليسار()
        ارجع هذا.الاتجاه() == اتجاه_نص.من_اليمين
    نهاية

    ## اللغات المتاحة
    دالة اللغات()
        متغير قائمة = []
        لكل ل في هذا._ترجمات
            قائمة = قائمة + [ل]
        نهاية
        ارجع قائمة
    نهاية

    ## اللغة الاحتياطية
    دالة لغة_احتياطية(رمز)
        هذا._لغة_احتياطية = رمز
        ارجع هذا
    نهاية

    # ─── داخلي ───

    دالة _احصل_ترجمة(لغة, مفتاح)
        إذا (هذا._ترجمات[لغة] != لاشيء)
            إذا (هذا._ترجمات[لغة][مفتاح] != لاشيء)
                ارجع هذا._ترجمات[لغة][مفتاح]
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    دالة _استبدل(نص, متغيرات)
        # استبدال {:مفتاح} بالقيمة
        لكل م في متغيرات
            حاول
                نص = استبدل_نص(نص, "{:" + م + "}", متغيرات[م])
            امسك خ
                # تجاهل
            نهاية
        نهاية
        ارجع نص
    نهاية
نهاية

