# ===================================================================
# خدمة المؤقتات — Timer Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/مؤقتات.ص
# ===================================================================
# مكتبة مؤقتات شاملة تدعم:
#   - مؤقت مرة واحدة (setTimeout)
#   - مؤقت تكراري (setInterval)
#   - ساعة إيقاف (Stopwatch)
#   - عدّاد تنازلي (Countdown)
#   - جدولة مهام
#   - تأخير وتقييد سرعة (debounce/throttle)
#
# الاستخدام:
#   استورد * من رسومات.خدمات.مؤقتات
#   بعد(1000, لامدا() اطبع("مرحباً") نهاية)
#   متغير س = جديد ساعة_إيقاف()
#
# المنصات المدعومة:
#   ✅ سطح المكتب (std::chrono + threading)
#   ✅ النواة (PIT/APIC timer interrupts)
#   ✅ الويب (setTimeout/setInterval/requestAnimationFrame)
#   ✅ أندرويد (Handler + Looper)
#   ✅ iOS (NSTimer + DispatchQueue)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#       ساعة_إيقاف — Stopwatch
# ===================================================================

صدّر صنف ساعة_إيقاف
    باني()
        هذا._بداية = 0
        هذا._متراكم = 0
        هذا._يعمل = خطأ
    نهاية

    ## بدء القياس
    دالة ابدأ()
        إذا (ليس هذا._يعمل)
            هذا._بداية = _الوقت_الحالي_مؤقت()
            هذا._يعمل = صحيح
        نهاية
        ارجع هذا
    نهاية

    ## إيقاف القياس
    دالة أوقف()
        إذا (هذا._يعمل)
            هذا._متراكم = هذا._متراكم + (_الوقت_الحالي_مؤقت() - هذا._بداية)
            هذا._يعمل = خطأ
        نهاية
        ارجع هذا
    نهاية

    ## إعادة ضبط
    دالة أعد_ضبط()
        هذا._بداية = 0
        هذا._متراكم = 0
        هذا._يعمل = خطأ
        ارجع هذا
    نهاية

    ## إعادة ضبط وبدء
    دالة أعد_بدء()
        هذا.أعد_ضبط()
        هذا.ابدأ()
        ارجع هذا
    نهاية

    ## الوقت المنقضي بالمللي ثانية
    دالة المنقضي()
        إذا (هذا._يعمل)
            ارجع هذا._متراكم + (_الوقت_الحالي_مؤقت() - هذا._بداية)
        نهاية
        ارجع هذا._متراكم
    نهاية

    ## الوقت بالثواني
    دالة المنقضي_ثواني()
        ارجع هذا.المنقضي() / 1000
    نهاية

    ## هل يعمل؟
    دالة يعمل()
        ارجع هذا._يعمل
    نهاية

    ## نص مقروء (دقائق:ثواني)
    دالة نص()
        متغير ملي = هذا.المنقضي()
        متغير ثواني = (ملي / 1000) % 60
        متغير دقائق = (ملي / 60000) % 60
        متغير ساعات = ملي / 3600000
        إذا (ساعات > 0)
            ارجع ساعات + ":" + دقائق + ":" + ثواني
        نهاية
        ارجع دقائق + ":" + ثواني
    نهاية
نهاية

# ===================================================================
#       عدّاد_تنازلي — Countdown Timer
# ===================================================================

صدّر صنف عدّاد_تنازلي
    باني(مللي_ثانية, رد_انتهاء = لاشيء)
        هذا._المدة = مللي_ثانية
        هذا._المتبقي = مللي_ثانية
        هذا._معرف = لاشيء
        هذا._رد_انتهاء = رد_انتهاء
        هذا._رد_تحديث = لاشيء
        هذا._يعمل = خطأ
        هذا._فترة_تحديث = 100
    نهاية

    ## بدء العد التنازلي
    دالة ابدأ()
        إذا (هذا._يعمل)
            ارجع هذا
        نهاية
        هذا._يعمل = صحيح
        متغير ذاتي = هذا
        هذا._معرف = مؤقت_تكراري(
            لامدا()
                ذاتي._المتبقي = ذاتي._المتبقي - ذاتي._فترة_تحديث
                إذا (ذاتي._رد_تحديث != لاشيء)
                    ذاتي._رد_تحديث(ذاتي._المتبقي)
                نهاية
                إذا (ذاتي._المتبقي <= 0)
                    ذاتي._المتبقي = 0
                    ذاتي.أوقف()
                    إذا (ذاتي._رد_انتهاء != لاشيء)
                        ذاتي._رد_انتهاء()
                    نهاية
                نهاية
            نهاية,
            هذا._فترة_تحديث
        )
        ارجع هذا
    نهاية

    ## إيقاف العد
    دالة أوقف()
        إذا (هذا._معرف != لاشيء)
            ألغ_تكرار(هذا._معرف)
            هذا._معرف = لاشيء
        نهاية
        هذا._يعمل = خطأ
        ارجع هذا
    نهاية

    ## إعادة ضبط العدّاد
    دالة أعد_ضبط()
        هذا.أوقف()
        هذا._المتبقي = هذا._المدة
        ارجع هذا
    نهاية

    ## عند كل تحديث
    دالة عند_تحديث(رد_نداء)
        هذا._رد_تحديث = رد_نداء
        ارجع هذا
    نهاية

    ## عند الانتهاء
    دالة عند_انتهاء(رد_نداء)
        هذا._رد_انتهاء = رد_نداء
        ارجع هذا
    نهاية

    ## الوقت المتبقي بالمللي ثانية
    دالة المتبقي()
        ارجع هذا._المتبقي
    نهاية

    ## الوقت المتبقي بالثواني
    دالة المتبقي_ثواني()
        ارجع هذا._المتبقي / 1000
    نهاية

    ## النسبة المئوية المنقضية (0.0 - 1.0)
    دالة التقدم()
        ارجع 1.0 - (هذا._المتبقي / هذا._المدة)
    نهاية

    ## هل يعمل؟
    دالة يعمل()
        ارجع هذا._يعمل
    نهاية

    ## هل انتهى؟
    دالة انتهى()
        ارجع هذا._المتبقي <= 0
    نهاية

    ## تعيين فترة التحديث (مللي ثانية)
    دالة فترة_التحديث(فترة)
        هذا._فترة_تحديث = فترة
        ارجع هذا
    نهاية
نهاية

# ===================================================================
#   مقيّد — Debounce (تنفيذ بعد توقف الاستدعاءات)
# ===================================================================

صدّر صنف مقيّد
    باني(دالة_تنفيذ, تأخير = 300)
        هذا._دالة = دالة_تنفيذ
        هذا._تأخير = تأخير
        هذا._معرف = لاشيء
    نهاية

    ## نداء مقيّد (يلغي النداء السابق)
    دالة نادِ()
        إذا (هذا._معرف != لاشيء)
            ألغ_تكرار(هذا._معرف)
        نهاية
        متغير ذاتي = هذا
        هذا._معرف = مؤقت_مرة(
            لامدا()
                ذاتي._دالة()
                ذاتي._معرف = لاشيء
            نهاية,
            هذا._تأخير
        )
    نهاية

    ## إلغاء أي نداء معلق
    دالة ألغِ()
        إذا (هذا._معرف != لاشيء)
            ألغ_تكرار(هذا._معرف)
            هذا._معرف = لاشيء
        نهاية
    نهاية
نهاية

# ===================================================================
#   مخنوق — Throttle (تنفيذ مرة واحدة كل فترة)
# ===================================================================

صدّر صنف مخنوق
    باني(دالة_تنفيذ, فترة = 300)
        هذا._دالة = دالة_تنفيذ
        هذا._فترة = فترة
        هذا._آخر_تنفيذ = 0
        هذا._معلق = خطأ
    نهاية

    ## نداء مخنوق
    دالة نادِ()
        متغير الآن = _الوقت_الحالي_مؤقت()
        إذا (الآن - هذا._آخر_تنفيذ >= هذا._فترة)
            هذا._آخر_تنفيذ = الآن
            هذا._دالة()
        نهاية
    نهاية
نهاية

