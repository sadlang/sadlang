# ===================================================================
# خدمة الوقت — Time & Date Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/وقت.ص
# ===================================================================
# مكتبة وقت وتاريخ شاملة تدعم:
#   - الطابع الزمني الحالي
#   - التاريخ والوقت بأجزائه
#   - حساب الفروقات الزمنية
#   - تنسيق التاريخ
#   - التقويمات (ميلادي / هجري)
#
# المنصات المدعومة:
#   ✅ سطح المكتب (std::chrono / time.h)
#   ✅ النواة (RTC / PIT / TSC)
#   ✅ الويب (Date / Intl.DateTimeFormat)
#   ✅ أندرويد (java.time)
#   ✅ iOS (Foundation.Date)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#       تاريخ_وقت — DateTime class
# ===================================================================

صدّر صنف تاريخ_وقت
    باني(سنة = 0, شهر = 0, يوم = 0, ساعة = 0, دقيقة = 0, ثانية = 0)
        هذا.سنة = سنة
        هذا.شهر = شهر
        هذا.يوم = يوم
        هذا.ساعة = ساعة
        هذا.دقيقة = دقيقة
        هذا.ثانية = ثانية
        هذا._طابع = 0
    نهاية

    ## تنسيق كنص
    دالة نص(تنسيق = "YYYY-MM-DD HH:mm:ss")
        ارجع هذا.سنة + "-" + هذا._بصفرين(هذا.شهر) + "-" + هذا._بصفرين(هذا.يوم) + " " + هذا._بصفرين(هذا.ساعة) + ":" + هذا._بصفرين(هذا.دقيقة) + ":" + هذا._بصفرين(هذا.ثانية)
    نهاية

    ## التاريخ فقط
    دالة تاريخ_فقط()
        ارجع هذا.سنة + "-" + هذا._بصفرين(هذا.شهر) + "-" + هذا._بصفرين(هذا.يوم)
    نهاية

    ## الوقت فقط
    دالة وقت_فقط()
        ارجع هذا._بصفرين(هذا.ساعة) + ":" + هذا._بصفرين(هذا.دقيقة) + ":" + هذا._بصفرين(هذا.ثانية)
    نهاية

    ## هل نفس اليوم؟
    دالة نفس_اليوم(آخر)
        ارجع هذا.سنة == آخر.سنة و هذا.شهر == آخر.شهر و هذا.يوم == آخر.يوم
    نهاية

    ## الفرق بالثواني
    دالة الفرق_ثواني(آخر)
        ارجع هذا._طابع - آخر._طابع
    نهاية

    ## إضافة ثواني
    دالة أضف_ثواني(ق)
        هذا.ثانية = هذا.ثانية + ق
        بينما (هذا.ثانية >= 60)
            هذا.ثانية = هذا.ثانية - 60
            هذا.دقيقة = هذا.دقيقة + 1
        نهاية
        بينما (هذا.دقيقة >= 60)
            هذا.دقيقة = هذا.دقيقة - 60
            هذا.ساعة = هذا.ساعة + 1
        نهاية
        بينما (هذا.ساعة >= 24)
            هذا.ساعة = هذا.ساعة - 24
            هذا.يوم = هذا.يوم + 1
        نهاية
        ارجع هذا
    نهاية

    ## إضافة أيام
    دالة أضف_أيام(ع)
        هذا.يوم = هذا.يوم + ع
        ارجع هذا
    نهاية

    ## تحويل إلى كائن
    دالة إلى_كائن()
        ارجع {
            سنة: هذا.سنة,
            شهر: هذا.شهر,
            يوم: هذا.يوم,
            ساعة: هذا.ساعة,
            دقيقة: هذا.دقيقة,
            ثانية: هذا.ثانية
        }
    نهاية

    # ─── داخلي ───
    دالة _بصفرين(ق)
        إذا (ق < 10)
            ارجع "0" + ق
        نهاية
        ارجع "" + ق
    نهاية
نهاية

