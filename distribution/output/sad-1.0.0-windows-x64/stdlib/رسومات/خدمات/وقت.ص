## الوقت الحالي كطابع زمني (مللي ثانية)
صدّر دالة الآن()
    حاول
        ارجع وقت_النظام()
    امسك خ
        ارجع 0
    نهاية
نهاية

## التاريخ والوقت الحالي كنص
صدّر دالة التاريخ()
    حاول
        ارجع تاريخ_النظام()
    امسك خ
        ارجع "غير_متاح"
    نهاية
نهاية

## إنشاء تاريخ_وقت من الآن
صدّر دالة الآن_مفصل()
    حاول
        متغير نص_تاريخ = تاريخ_النظام()
        # تحليل "YYYY-MM-DD HH:mm:ss"
        متغير ت = جديد تاريخ_وقت()
        ت._طابع = وقت_النظام()
        ارجع ت
    امسك خ
        ارجع جديد تاريخ_وقت()
    نهاية
نهاية
