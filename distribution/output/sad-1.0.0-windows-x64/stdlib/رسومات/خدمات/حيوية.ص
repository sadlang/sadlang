# ===================================================================
# خدمة المقاييس الحيوية — Biometric Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/حيوية.ص
# ===================================================================
# مكتبة مصادقة حيوية شاملة:
#   - بصمة الإصبع
#   - التعرف على الوجه
#   - التحقق من الدعم
#   - سقوط إلى PIN/كلمة مرور
#
# المنصات المدعومة:
#   ✅ سطح المكتب (Windows Hello / Touch ID)
#   ✅ النواة (غير مدعوم)
#   ✅ الويب (Web Authentication API)
#   ✅ أندرويد (BiometricPrompt)
#   ✅ iOS (LocalAuthentication / Face ID / Touch ID)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    تعدادات
# ===================================================================

صدّر تعداد نوع_حيوي
    بصمة
    وجه
    قزحية
    أي_متاح
نهاية

صدّر تعداد نتيجة_مصادقة
    نجاح
    فشل
    إلغاء
    خطأ_أجهزة
    غير_مدعوم
    غير_مسجل    # لا توجد بصمات مسجلة
نهاية

# ===================================================================
#       مصادقة_حيوية — Biometric Auth
# ===================================================================

صدّر صنف مصادقة_حيوية
    باني()
        هذا._المدعوم = لاشيء
    نهاية

    ## المصادقة الحيوية
    دالة صادق(سبب = "التحقق من هويتك", نوع = نوع_حيوي.أي_متاح)
        حاول
            متغير نتيجة = مصادقة_حيوية(سبب)
            إذا (نتيجة)
                ارجع نتيجة_مصادقة.نجاح
            نهاية
            ارجع نتيجة_مصادقة.فشل
        امسك خ
            ارجع نتيجة_مصادقة.غير_مدعوم
        نهاية
    نهاية

    ## هل المصادقة الحيوية مدعومة؟
    دالة مدعوم()
        إذا (هذا._المدعوم != لاشيء)
            ارجع هذا._المدعوم
        نهاية
        حاول
            هذا._المدعوم = دعم_حيوي()
            ارجع هذا._المدعوم
        امسك خ
            هذا._المدعوم = خطأ
            ارجع خطأ
        نهاية
    نهاية

    ## هل البصمة متاحة؟
    دالة بصمة_متاحة()
        حاول
            ارجع دعم_بصمة()
        امسك خ
            ارجع هذا.مدعوم()
        نهاية
    نهاية

    ## هل التعرف على الوجه متاح؟
    دالة وجه_متاح()
        حاول
            ارجع دعم_وجه()
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## الأنواع المدعومة
    دالة الأنواع_المدعومة()
        متغير قائمة = []
        إذا (هذا.بصمة_متاحة())
            قائمة = قائمة + [نوع_حيوي.بصمة]
        نهاية
        إذا (هذا.وجه_متاح())
            قائمة = قائمة + [نوع_حيوي.وجه]
        نهاية
        ارجع قائمة
    نهاية
نهاية

# ===================================================================
#       دوال مساعدة (للتوافق مع API القديم)
# ===================================================================

## المصادقة الحيوية
صدّر دالة مصادقة(سبب = "")
    حاول
        ارجع مصادقة_حيوية(سبب)
    امسك خ
        ارجع خطأ
    نهاية
نهاية

## هل مدعوم
صدّر دالة مدعوم()
    حاول
        ارجع دعم_حيوي()
    امسك خ
        ارجع خطأ
    نهاية
نهاية
