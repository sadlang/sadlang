# ===================================================================
#       محرك_اهتزاز — Haptic Engine
# ===================================================================

صدّر صنف محرك_اهتزاز
    باني()
        هذا._مدعوم = لاشيء
    نهاية

    ## اهتزاز بسيط
    دالة اهتز(مدة = 100)
        حاول
            اهتزاز(مدة)
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## نمط اهتزاز مخصص [مدة، توقف، مدة، توقف...]
    دالة نمط(أنماط)
        لكل مدة في أنماط
            حاول
                اهتزاز(مدة)
            امسك خ
                # تجاهل
            نهاية
        نهاية
        ارجع هذا
    نهاية

    ## رد فعل لمسي حسب النوع
    دالة لمسة(نوع = نوع_لمس.خفيف)
        حاول
            لمسة_هابتك(نوع)
        امسك خ
            هذا.اهتز(30)
        نهاية
        ارجع هذا
    نهاية

    ## هل الاهتزاز مدعوم؟
    دالة مدعوم()
        إذا (هذا._مدعوم != لاشيء)
            ارجع هذا._مدعوم
        نهاية
        حاول
            هذا._مدعوم = دعم_اهتزاز()
            ارجع هذا._مدعوم
        امسك خ
            هذا._مدعوم = خطأ
            ارجع خطأ
        نهاية
    نهاية

    ## إيقاف الاهتزاز
    دالة أوقف()
        حاول
            أوقف_اهتزاز()
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية
نهاية

