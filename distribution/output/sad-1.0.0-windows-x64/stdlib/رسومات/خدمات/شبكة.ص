صدّر صنف رافع_ملفات
    باني(عنوان)
        هذا._عنوان = عنوان
        هذا._ترويسات = {}
        هذا._عند_تقدم = لاشيء
        هذا._عند_اكتمال = لاشيء
        هذا._عند_خطأ = لاشيء
    نهاية

    دالة عيّن_ترويسة(اسم, قيمة)
        هذا._ترويسات[اسم] = قيمة
        ارجع هذا
    نهاية

    دالة عند_تقدم(معالج)
        هذا._عند_تقدم = معالج
        ارجع هذا
    نهاية

    دالة عند_اكتمال(معالج)
        هذا._عند_اكتمال = معالج
        ارجع هذا
    نهاية

    دالة عند_خطأ(معالج)
        هذا._عند_خطأ = معالج
        ارجع هذا
    نهاية

    دالة ارفع(مسار_ملف)
        حاول
            # TODO: تنفيذ الرفع الفعلي
            إذا (هذا._عند_اكتمال != لاشيء)
                هذا._عند_اكتمال({"نجاح": صحيح})
            نهاية
        امسك (خطأ)
            إذا (هذا._عند_خطأ != لاشيء)
                هذا._عند_خطأ(خطأ)
            نهاية
        نهاية
        ارجع هذا
    نهاية
نهاية

صدّر صنف محمّل_ملفات
    باني(عنوان, مسار_حفظ)
        هذا._عنوان = عنوان
        هذا._مسار_حفظ = مسار_حفظ
        هذا._عند_تقدم = لاشيء
        هذا._عند_اكتمال = لاشيء
        هذا._عند_خطأ = لاشيء
    نهاية

    دالة عند_تقدم(معالج)
        هذا._عند_تقدم = معالج
        ارجع هذا
    نهاية

    دالة عند_اكتمال(معالج)
        هذا._عند_اكتمال = معالج
        ارجع هذا
    نهاية

    دالة عند_خطأ(معالج)
        هذا._عند_خطأ = معالج
        ارجع هذا
    نهاية

    دالة حمّل()
        حاول
            # TODO: تنفيذ التحميل الفعلي
            إذا (هذا._عند_اكتمال != لاشيء)
                هذا._عند_اكتمال({"نجاح": صحيح, "مسار": هذا._مسار_حفظ})
            نهاية
        امسك (خطأ)
            إذا (هذا._عند_خطأ != لاشيء)
                هذا._عند_خطأ(خطأ)
            نهاية
        نهاية
        ارجع هذا
    نهاية
نهاية

