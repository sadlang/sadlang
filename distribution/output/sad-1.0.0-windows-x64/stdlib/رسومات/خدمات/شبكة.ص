# ===================================================================
# خدمة الشبكة — Network Service (مكتبة شاملة)
# stdlib/رسومات/خدمات/شبكة.ص
# ===================================================================
#
# مكتبة شاملة للتعامل مع الشبكة تتضمن:
#   - عميل HTTP كامل (GET, POST, PUT, DELETE, PATCH)
#   - WebSocket للاتصال ثنائي الاتجاه
#   - ذاكرة تخزين مؤقت (Cache)
#   - إعادة المحاولة التلقائية
#   - مراقبة الاتصال
#   - تحميل/رفع الملفات
#
# الاستخدام الأساسي:
#   استورد * من رسومات.خدمات.شبكة
#   متغير استجابة = احصل_من("https://api.example.com/data")
#
# الاستخدام المتقدم:
#   متغير عميل = جديد عميل_HTTP()
#   عميل.عيّن_ترويسة("Authorization", "Bearer token")
#   متغير استجابة = عميل.احصل("/users")
#
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    الثوابت والتعدادات
# ===================================================================

صدّر تعداد طريقة_HTTP
    GET
    POST
    PUT
    DELETE
    PATCH
    HEAD
    OPTIONS
نهاية

صدّر تعداد حالة_اتصال_شبكة
    متصل
    غير_متصل
    متصل_بطيء
    غير_معروف
نهاية

صدّر ثابت أكواد_حالة = {
    "200": "موافق",
    "201": "تم_الإنشاء",
    "204": "بلا_محتوى",
    "400": "طلب_خاطئ",
    "401": "غير_مصرح",
    "403": "ممنوع",
    "404": "غير_موجود",
    "500": "خطأ_خادم",
    "502": "بوابة_خاطئة",
    "503": "خدمة_غير_متاحة"
}

# ===================================================================
#                    استجابة HTTP
# ===================================================================

صدّر صنف استجابة_HTTP
    باني()
        هذا.كود_الحالة = 0
        هذا.نص_الحالة = ""
        هذا.الجسم = ""
        هذا.الترويسات = {}
        هذا.وقت_الاستجابة = 0
        هذا.نجح = خطأ
    نهاية

    دالة ناجحة()
        ارجع هذا.كود_الحالة >= 200 و هذا.كود_الحالة < 300
    نهاية

    دالة كـ_جيسون()
        # تحويل JSON إلى كائن
        ارجع حلل_جيسون(هذا.الجسم)
    نهاية

    دالة كـ_نص()
        ارجع هذا.الجسم
    نهاية
نهاية

# ===================================================================
#                    عميل HTTP
# ===================================================================

صدّر صنف عميل_HTTP
    باني(عنوان_أساسي = "")
        هذا._عنوان_أساسي = عنوان_أساسي
        هذا._ترويسات_افتراضية = {}
        هذا._مهلة = 30000  # 30 ثانية
        هذا._إعادة_محاولة = 3
        هذا._ذاكرة_مؤقتة = {}
        هذا._استخدام_ذاكرة = خطأ
        هذا._مدة_ذاكرة = 300000  # 5 دقائق
    نهاية

    # ─── إعدادات العميل ───

    دالة عيّن_عنوان_أساسي(عنوان)
        هذا._عنوان_أساسي = عنوان
        ارجع هذا
    نهاية

    دالة عيّن_ترويسة(اسم, قيمة)
        هذا._ترويسات_افتراضية[اسم] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_مهلة(ملي_ثانية)
        هذا._مهلة = ملي_ثانية
        ارجع هذا
    نهاية

    دالة عيّن_إعادة_محاولة(عدد)
        هذا._إعادة_محاولة = عدد
        ارجع هذا
    نهاية

    دالة فعّل_ذاكرة_مؤقتة(مدة = 300000)
        هذا._استخدام_ذاكرة = صحيح
        هذا._مدة_ذاكرة = مدة
        ارجع هذا
    نهاية

    دالة عيّن_رمز_وصول(رمز)
        هذا._ترويسات_افتراضية["Authorization"] = "Bearer " + رمز
        ارجع هذا
    نهاية

    # ─── طرق HTTP ───

    دالة احصل(مسار, ترويسات = {})
        ارجع هذا._طلب("GET", مسار, "", ترويسات)
    نهاية

    دالة أرسل(مسار, بيانات, ترويسات = {})
        ارجع هذا._طلب("POST", مسار, بيانات, ترويسات)
    نهاية

    دالة حدّث(مسار, بيانات, ترويسات = {})
        ارجع هذا._طلب("PUT", مسار, بيانات, ترويسات)
    نهاية

    دالة احذف(مسار, ترويسات = {})
        ارجع هذا._طلب("DELETE", مسار, "", ترويسات)
    نهاية

    دالة رقّع(مسار, بيانات, ترويسات = {})
        ارجع هذا._طلب("PATCH", مسار, بيانات, ترويسات)
    نهاية

    # ─── التنفيذ الداخلي ───

    دالة _طلب(طريقة, مسار, جسم, ترويسات)
        متغير عنوان_كامل = هذا._عنوان_أساسي + مسار
        
        # دمج الترويسات
        متغير ترويسات_نهائية = {}
        لكل مفتاح في هذا._ترويسات_افتراضية.مفاتيح()
            ترويسات_نهائية[مفتاح] = هذا._ترويسات_افتراضية[مفتاح]
        نهاية
        لكل مفتاح في ترويسات.مفاتيح()
            ترويسات_نهائية[مفتاح] = ترويسات[مفتاح]
        نهاية

        # تحقق من الذاكرة المؤقتة
        إذا (طريقة == "GET" و هذا._استخدام_ذاكرة)
            متغير مخزن = هذا._ذاكرة_مؤقتة[عنوان_كامل]
            إذا (مخزن != لاشيء)
                إذا (الآن() - مخزن["وقت"] < هذا._مدة_ذاكرة)
                    ارجع مخزن["استجابة"]
                نهاية
            نهاية
        نهاية

        # تنفيذ الطلب مع إعادة المحاولة
        متغير محاولة = 0
        متغير استجابة = جديد استجابة_HTTP()
        
        بينما (محاولة < هذا._إعادة_محاولة)
            حاول
                متغير نتيجة = طلب_شبكة(طريقة, عنوان_كامل, جسم, هذا._حوّل_ترويسات(ترويسات_نهائية))
                استجابة.الجسم = نتيجة
                استجابة.كود_الحالة = 200
                استجابة.نجح = صحيح
                
                # حفظ في الذاكرة المؤقتة
                إذا (طريقة == "GET" و هذا._استخدام_ذاكرة)
                    هذا._ذاكرة_مؤقتة[عنوان_كامل] = {
                        "استجابة": استجابة,
                        "وقت": الآن()
                    }
                نهاية
                
                ارجع استجابة
            امسك (خطأ)
                محاولة = محاولة + 1
                إذا (محاولة >= هذا._إعادة_محاولة)
                    استجابة.كود_الحالة = 0
                    استجابة.نص_الحالة = "فشل الاتصال"
                    استجابة.نجح = خطأ
                نهاية
            نهاية
        نهاية
        
        ارجع استجابة
    نهاية

    دالة _حوّل_ترويسات(ترويسات)
        متغير نتيجة = ""
        لكل مفتاح في ترويسات.مفاتيح()
            نتيجة = نتيجة + مفتاح + ": " + ترويسات[مفتاح] + "\n"
        نهاية
        ارجع نتيجة
    نهاية

    دالة امسح_ذاكرة_مؤقتة()
        هذا._ذاكرة_مؤقتة = {}
    نهاية
نهاية

# ===================================================================
#                    WebSocket
# ===================================================================

صدّر صنف عميل_ويب_سوكت
    باني(عنوان)
        هذا._عنوان = عنوان
        هذا._متصل = خطأ
        هذا._معالجات = {}
        هذا._إعادة_اتصال_تلقائي = صحيح
        هذا._فترة_إعادة_اتصال = 5000
    نهاية

    دالة اتصل()
        حاول
            # TODO: تنفيذ الاتصال الفعلي
            هذا._متصل = صحيح
            هذا._أطلق_حدث("اتصال")
        امسك (خطأ)
            هذا._أطلق_حدث("خطأ", خطأ)
            إذا (هذا._إعادة_اتصال_تلقائي)
                هذا._أعد_الاتصال()
            نهاية
        نهاية
        ارجع هذا
    نهاية

    دالة أرسل(بيانات)
        إذا (ليس هذا._متصل)
            ارمي "غير متصل"
        نهاية
        # TODO: إرسال فعلي
        ارجع هذا
    نهاية

    دالة اغلق()
        هذا._متصل = خطأ
        هذا._أطلق_حدث("إغلاق")
        ارجع هذا
    نهاية

    دالة عند(حدث, معالج)
        هذا._معالجات[حدث] = معالج
        ارجع هذا
    نهاية

    دالة عند_رسالة(معالج)
        ارجع هذا.عند("رسالة", معالج)
    نهاية

    دالة عند_اتصال(معالج)
        ارجع هذا.عند("اتصال", معالج)
    نهاية

    دالة عند_إغلاق(معالج)
        ارجع هذا.عند("إغلاق", معالج)
    نهاية

    دالة عند_خطأ(معالج)
        ارجع هذا.عند("خطأ", معالج)
    نهاية

    دالة متصل()
        ارجع هذا._متصل
    نهاية

    دالة عيّن_إعادة_اتصال(مفعل, فترة = 5000)
        هذا._إعادة_اتصال_تلقائي = مفعل
        هذا._فترة_إعادة_اتصال = فترة
        ارجع هذا
    نهاية

    دالة _أطلق_حدث(حدث, بيانات = لاشيء)
        إذا (هذا._معالجات[حدث] != لاشيء)
            هذا._معالجات[حدث](بيانات)
        نهاية
    نهاية

    دالة _أعد_الاتصال()
        # إعادة الاتصال بعد فترة
        بعد(هذا._فترة_إعادة_اتصال, لامدا() {
            هذا.اتصل()
        })
    نهاية
نهاية

# ===================================================================
#                    مراقب الاتصال
# ===================================================================

صدّر صنف مراقب_اتصال
    باني()
        هذا._حالة = حالة_اتصال_شبكة.غير_معروف
        هذا._معالجات = []
        هذا._فترة_فحص = 10000  # 10 ثوان
        هذا._يعمل = خطأ
    نهاية

    دالة ابدأ()
        هذا._يعمل = صحيح
        هذا._فحص_دوري()
        ارجع هذا
    نهاية

    دالة أوقف()
        هذا._يعمل = خطأ
        ارجع هذا
    نهاية

    دالة عند_تغيير(معالج)
        هذا._معالجات.أضف(معالج)
        ارجع هذا
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة متصل()
        ارجع هذا._حالة == حالة_اتصال_شبكة.متصل
    نهاية

    دالة _فحص_دوري()
        إذا (ليس هذا._يعمل)
            ارجع لاشيء
        نهاية
        
        متغير حالة_جديدة = حالة_اتصال_شبكة.غير_معروف
        
        حاول
            إذا (هل_متصل())
                حالة_جديدة = حالة_اتصال_شبكة.متصل
            وإلا
                حالة_جديدة = حالة_اتصال_شبكة.غير_متصل
            نهاية
        امسك (خطأ)
            حالة_جديدة = حالة_اتصال_شبكة.غير_متصل
        نهاية
        
        إذا (حالة_جديدة != هذا._حالة)
            هذا._حالة = حالة_جديدة
            لكل معالج في هذا._معالجات
                معالج(حالة_جديدة)
            نهاية
        نهاية
        
        بعد(هذا._فترة_فحص, لامدا() {
            هذا._فحص_دوري()
        })
    نهاية
نهاية

