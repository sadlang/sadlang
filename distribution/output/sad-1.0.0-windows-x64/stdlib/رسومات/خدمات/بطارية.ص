# ===================================================================
# خدمة البطارية — Battery Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/بطارية.ص
# ===================================================================
# مكتبة بطارية شاملة تدعم:
#   - مستوى البطارية
#   - حالة الشحن
#   - مراقبة تغييرات البطارية
#   - معلومات صحة البطارية
#   - وضع توفير الطاقة
#
# المنصات المدعومة:
#   ✅ سطح المكتب (WinAPI / upower / IOKit)
#   ✅ النواة (ACPI Battery Interface)
#   ✅ الويب (Battery Status API)
#   ✅ أندرويد (BatteryManager)
#   ✅ iOS (UIDevice.batteryLevel)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    تعدادات
# ===================================================================

صدّر تعداد حالة_شحن
    يشحن
    لا_يشحن
    ممتلئ
    غير_معروف
نهاية

صدّر تعداد صحة_بطارية
    جيدة
    عادية
    ضعيفة
    حرجة
    غير_معروفة
نهاية

# ===================================================================
#       مراقب_بطارية — Battery Monitor
# ===================================================================

صدّر صنف مراقب_بطارية
    باني()
        هذا._مراقبون = []
        هذا._معرف_مراقبة = لاشيء
        هذا._آخر_مستوى = -1
    نهاية

    ## مستوى البطارية (0-100)، -1 إذا غير متاح
    دالة المستوى()
        حاول
            ارجع مستوى_البطارية()
        امسك خ
            ارجع -1
        نهاية
    نهاية

    ## هل الجهاز يشحن؟
    دالة يشحن()
        حاول
            ارجع هل_يشحن()
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## حالة الشحن
    دالة الحالة()
        حاول
            إذا (هل_يشحن())
                متغير م = هذا.المستوى()
                إذا (م >= 100)
                    ارجع حالة_شحن.ممتلئ
                نهاية
                ارجع حالة_شحن.يشحن
            نهاية
            ارجع حالة_شحن.لا_يشحن
        امسك خ
            ارجع حالة_شحن.غير_معروف
        نهاية
    نهاية

    ## صحة البطارية (تقدير)
    دالة الصحة()
        متغير م = هذا.المستوى()
        إذا (م < 0)
            ارجع صحة_بطارية.غير_معروفة
        نهاية
        إذا (م <= 5)
            ارجع صحة_بطارية.حرجة
        نهاية
        إذا (م <= 20)
            ارجع صحة_بطارية.ضعيفة
        نهاية
        إذا (م <= 50)
            ارجع صحة_بطارية.عادية
        نهاية
        ارجع صحة_بطارية.جيدة
    نهاية

    ## هل البطارية منخفضة؟ (أقل من 20%)
    دالة منخفضة()
        ارجع هذا.المستوى() <= 20 و هذا.المستوى() >= 0
    نهاية

    ## هل البطارية حرجة؟ (أقل من 5%)
    دالة حرجة()
        ارجع هذا.المستوى() <= 5 و هذا.المستوى() >= 0
    نهاية

    ## بدء مراقبة تغييرات البطارية
    دالة ابدأ_مراقبة(فترة = 30000)
        إذا (هذا._معرف_مراقبة != لاشيء)
            ارجع هذا
        نهاية
        متغير ذاتي = هذا
        حاول
            هذا._معرف_مراقبة = مؤقت_تكراري(
                لامدا()
                    متغير مستوى_حالي = ذاتي.المستوى()
                    إذا (مستوى_حالي != ذاتي._آخر_مستوى)
                        ذاتي._آخر_مستوى = مستوى_حالي
                        لكل مراقب في ذاتي._مراقبون
                            مراقب({
                                مستوى: مستوى_حالي,
                                يشحن: ذاتي.يشحن(),
                                حالة: ذاتي.الحالة()
                            })
                        نهاية
                    نهاية
                نهاية,
                فترة
            )
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## إيقاف المراقبة
    دالة أوقف_مراقبة()
        إذا (هذا._معرف_مراقبة != لاشيء)
            حاول
                ألغ_تكرار(هذا._معرف_مراقبة)
            امسك خ
                # تجاهل
            نهاية
            هذا._معرف_مراقبة = لاشيء
        نهاية
        ارجع هذا
    نهاية

    ## مراقبة تغييرات البطارية
    دالة راقب(رد_نداء)
        هذا._مراقبون = هذا._مراقبون + [رد_نداء]
        ارجع هذا
    نهاية

    ## ملخص البطارية
    دالة ملخص()
        ارجع {
            مستوى: هذا.المستوى(),
            يشحن: هذا.يشحن(),
            حالة: هذا.الحالة(),
            صحة: هذا.الصحة(),
            منخفضة: هذا.منخفضة()
        }
    نهاية

    ## تحرير الموارد
    دالة تخلص()
        هذا.أوقف_مراقبة()
        هذا._مراقبون = []
    نهاية
نهاية

# ===================================================================
#       دوال مساعدة (للتوافق مع API القديم)
