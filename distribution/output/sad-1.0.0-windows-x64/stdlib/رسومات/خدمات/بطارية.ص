## مستوى البطارية
صدّر دالة المستوى()
    حاول
        ارجع مستوى_البطارية()
    امسك خ
        ارجع -1
    نهاية
نهاية

## هل يشحن
صدّر دالة يشحن()
    حاول
        ارجع هل_يشحن()
    امسك خ
        ارجع خطأ
    نهاية
نهاية
