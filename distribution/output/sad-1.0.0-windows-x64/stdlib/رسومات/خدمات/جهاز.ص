        نهاية
    نهاية

    ## اتجاه الشاشة
    دالة الاتجاه()
        متغير ع = هذا.عرض_الشاشة()
        متغير ر = هذا.ارتفاع_الشاشة()
        إذا (ع > ر)
            ارجع اتجاه_شاشة.أفقي
        نهاية
        ارجع اتجاه_شاشة.عمودي
    نهاية

    # ─── معلومات البطارية ───

    ## مستوى البطارية (0-100) أو -1 إذا غير متاح
    دالة مستوى_البطارية()
        حاول
            ارجع مستوى_البطارية()
        امسك خ
            ارجع -1
        نهاية
    نهاية

    ## حالة البطارية
    دالة حالة_البطارية()
        حاول
            إذا (هل_يشحن())
                ارجع حالة_بطارية.يشحن
            نهاية
            ارجع حالة_بطارية.لا_يشحن
        امسك خ
            ارجع حالة_بطارية.غير_متاح
        نهاية
    نهاية

    ## هل الجهاز يشحن؟
    دالة يشحن()
        حاول
            ارجع هل_يشحن()
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    # ─── معلومات بيئية ───

    ## لغة النظام
    دالة اللغة()
        حاول
            ارجع لغة_الجهاز()
        امسك خ
            ارجع "ar"
        نهاية
    نهاية

    ## نوع فئة الجهاز
    دالة الفئة()
        حاول
            متغير ن = نوع_الجهاز()
            إذا (ن == "هاتف")
                ارجع نوع_جهاز_فئة.هاتف
            نهاية
            إذا (ن == "جهاز_لوحي")
                ارجع نوع_جهاز_فئة.جهاز_لوحي
            نهاية
            ارجع نوع_جهاز_فئة.حاسوب
        امسك خ
            ارجع نوع_جهاز_فئة.حاسوب
        نهاية
    نهاية

    ## هل الجهاز فيزيائي (ليس محاكياً)؟
    دالة فيزيائي()
        حاول
            ارجع هل_جهاز_فيزيائي()
        امسك خ
            ارجع صحيح
        نهاية
    نهاية

    ## اسم الجهاز/الطراز
    دالة الطراز()
        حاول
            ارجع طراز_الجهاز()
        امسك خ
            ارجع "غير_معروف"
        نهاية
    نهاية

    ## اسم المُصَنِّع
    دالة المصنع()
        حاول
            ارجع مصنع_الجهاز()
        امسك خ
            ارجع "غير_معروف"
        نهاية
    نهاية

    # ─── ملخص شامل ───

    ## الحصول على جميع المعلومات ككائن
    دالة الكل()
        ارجع {
            نظام: هذا.النظام(),
            إصدار: هذا.إصدار_النظام(),
            معمارية: هذا.المعمارية(),
            معالجات: هذا.المعالجات(),
            ذاكرة_كلية: هذا.الذاكرة_الكلية(),
            ذاكرة_متاحة: هذا.الذاكرة_المتاحة(),
            عرض_شاشة: هذا.عرض_الشاشة(),
            ارتفاع_شاشة: هذا.ارتفاع_الشاشة(),
            كثافة: هذا.كثافة_الشاشة(),
            بطارية: هذا.مستوى_البطارية(),
            لغة: هذا.اللغة(),
            فئة: هذا.الفئة(),
            طراز: هذا.الطراز()
        }
    نهاية
نهاية

