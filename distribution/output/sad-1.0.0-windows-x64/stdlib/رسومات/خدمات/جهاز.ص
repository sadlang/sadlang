# ===================================================================
# خدمة معلومات الجهاز — Device Info Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/جهاز.ص
# ===================================================================
# مكتبة شاملة لمعلومات الجهاز:
#   - معلومات النظام (اسم، إصدار، معمارية)
#   - معلومات العتاد (معالج، ذاكرة، تخزين)
#   - معلومات الشاشة (أبعاد، كثافة، اتجاه)
#   - معلومات البطارية (مستوى، شحن، صحة)
#   - معلومات الشبكة (متصل، نوع الاتصال)
#   - معلومات التطبيق (إصدار، مسارات)
#
# الاستخدام:
#   استورد * من رسومات.خدمات.جهاز
#   متغير جـ = جديد معلومات_جهاز()
#   اطبع(جـ.النظام())
#
# المنصات المدعومة:
#   ✅ سطح المكتب (WinAPI / sysctl / /proc)
#   ✅ النواة (CPUID / ACPI / PCI)
#   ✅ الويب (Navigator API / Screen API)
#   ✅ أندرويد (Build / BatteryManager / DisplayMetrics)
#   ✅ iOS (UIDevice / ProcessInfo / UIScreen)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت وتعدادات
# ===================================================================

