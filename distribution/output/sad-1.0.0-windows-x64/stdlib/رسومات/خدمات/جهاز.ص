    ويندوز
    ماك
    لينكس
    أندرويد
    آي_أو_إس
    ويب
    نواة
    غير_معروف
نهاية

صدّر تعداد نوع_جهاز_فئة
    هاتف
    جهاز_لوحي
    حاسوب
    تلفاز
    ساعة
    غير_معروف
نهاية

صدّر تعداد اتجاه_شاشة
    عمودي
    أفقي
    عمودي_معكوس
    أفقي_معكوس
نهاية

صدّر تعداد حالة_بطارية
    يشحن
    لا_يشحن
    ممتلئ
    غير_متاح
نهاية

# ===================================================================
#       معلومات_جهاز — الصنف الشامل
# ===================================================================

صدّر صنف معلومات_جهاز
    باني()
        هذا._ذاكرة_مخبأة = لاشيء
    نهاية

    # ─── معلومات النظام ───

    ## اسم نظام التشغيل
    دالة النظام()
        حاول
            ارجع اسم_النظام()
        امسك خ
            ارجع "غير_معروف"
        نهاية
    نهاية

    ## إصدار نظام التشغيل
    دالة إصدار_النظام()
        حاول
            ارجع إصدار_النظام_الكامل()
        امسك خ
            ارجع "0.0"
        نهاية
    نهاية

    ## نوع المنصة
    دالة المنصة()
        متغير نظام = هذا.النظام()
        إذا (نظام == "Windows")
            ارجع نوع_منصة.ويندوز
        نهاية
        إذا (نظام == "macOS" أو نظام == "Darwin")
            ارجع نوع_منصة.ماك
        نهاية
        إذا (نظام == "Linux")
            ارجع نوع_منصة.لينكس
        نهاية
        إذا (نظام == "Android")
            ارجع نوع_منصة.أندرويد
        نهاية
        إذا (نظام == "iOS")
            ارجع نوع_منصة.آي_أو_إس
        نهاية
        ارجع نوع_منصة.غير_معروف
    نهاية

    ## معمارية المعالج (x86, x64, ARM, ARM64)
    دالة المعمارية()
        حاول
            ارجع معمارية_المعالج()
        امسك خ
            ارجع "غير_معروف"
        نهاية
    نهاية

    ## هل النظام 64 بت؟
    دالة هل_64بت()
        متغير م = هذا.المعمارية()
        ارجع م == "x64" أو م == "ARM64" أو م == "aarch64"
    نهاية

    # ─── معلومات العتاد ───

    ## عدد أنوية المعالج
    دالة المعالجات()
        حاول
            ارجع عدد_المعالجات()
        امسك خ
            ارجع 1
        نهاية
    نهاية

    ## حجم الذاكرة الكلية بالميغابايت
    دالة الذاكرة_الكلية()
        حاول
            ارجع حجم_الذاكرة()
        امسك خ
            ارجع 0
        نهاية
    نهاية

    ## الذاكرة المتاحة بالميغابايت
    دالة الذاكرة_المتاحة()
        حاول
            ارجع الذاكرة_الحرة()
        امسك خ
            ارجع 0
        نهاية
    نهاية

    ## مساحة التخزين الكلية بالغيغابايت
    دالة التخزين_الكلي()
        حاول
