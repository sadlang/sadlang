# ===================================================================
# خدمة الكاميرا — Camera Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/كاميرا.ص
# ===================================================================
# مكتبة كاميرا شاملة تدعم:
#   - فتح/إغلاق الكاميرا
#   - التقاط صور
#   - تبديل الكاميرا (أمامية/خلفية)
#   - التحكم بالفلاش
#   - معاينة مباشرة (Live Preview)
#   - تسجيل فيديو
#
# المنصات المدعومة:
#   ✅ سطح المكتب (V4L2 / DirectShow / AVFoundation)
#   ✅ النواة (USB Camera driver)
#   ✅ الويب (getUserMedia API)
#   ✅ أندرويد (CameraX / Camera2)
#   ✅ iOS (AVCaptureSession)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت وتعدادات
# ===================================================================

صدّر تعداد اتجاه_كاميرا
    خلفية
    أمامية
نهاية

صدّر تعداد وضع_فلاش
    تلقائي
    مفعل
    معطل
    شعلة
نهاية

صدّر تعداد حالة_كاميرا
    مغلقة
    مفتوحة
    تسجل
    خطأ
نهاية

صدّر تعداد دقة_صورة
    منخفضة      # 480p
    متوسطة      # 720p
    عالية        # 1080p
    فائقة        # 4K
نهاية

# ===================================================================
#       كاميرا — الصنف الشامل
# ===================================================================

صدّر صنف كاميرا
    باني(اتجاه = اتجاه_كاميرا.خلفية)
        هذا._اتجاه = اتجاه
        هذا._حالة = حالة_كاميرا.مغلقة
        هذا._فلاش = وضع_فلاش.تلقائي
        هذا._دقة = دقة_صورة.عالية
        هذا._تكبير = 1.0
        هذا._مراقبون = []
    نهاية

    ## فتح الكاميرا
    دالة افتح()
        حاول
            افتح_كاميرا()
            هذا._حالة = حالة_كاميرا.مفتوحة
            هذا._أشعر("فتح", {})
        امسك خ
            هذا._حالة = حالة_كاميرا.خطأ
            هذا._أشعر("خطأ", {رسالة: "فشل فتح الكاميرا"})
        نهاية
        ارجع هذا
    نهاية

    ## إغلاق الكاميرا
    دالة أغلق()
        حاول
            أغلق_كاميرا()
        امسك خ
            # تجاهل
        نهاية
        هذا._حالة = حالة_كاميرا.مغلقة
        هذا._أشعر("إغلاق", {})
        ارجع هذا
    نهاية

    ## التقاط صورة
    دالة التقط(مسار = "")
        حاول
            متغير نتيجة = التقط_صورة(مسار)
            هذا._أشعر("التقاط", {مسار: نتيجة})
            ارجع نتيجة
        امسك خ
            هذا._أشعر("خطأ", {رسالة: "فشل الالتقاط"})
            ارجع لاشيء
        نهاية
    نهاية

    ## تبديل الكاميرا (أمامية/خلفية)
    دالة بدّل()
        إذا (هذا._اتجاه == اتجاه_كاميرا.خلفية)
            هذا._اتجاه = اتجاه_كاميرا.أمامية
        وإلا
            هذا._اتجاه = اتجاه_كاميرا.خلفية
        نهاية
        حاول
            بدّل_كاميرا(هذا._اتجاه)
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## ضبط وضع الفلاش
    دالة الفلاش(وضع)
        هذا._فلاش = وضع
        حاول
            عين_فلاش(وضع)
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## ضبط التكبير (1.0 - 10.0)
    دالة تكبير(قيمة)
        هذا._تكبير = قيمة
        حاول
            عين_تكبير_كاميرا(قيمة)
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## ضبط الدقة
    دالة الدقة(دقة)
        هذا._دقة = دقة
        حاول
            عين_دقة_كاميرا(دقة)
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## بدء تسجيل فيديو
    دالة ابدأ_تسجيل(مسار = "")
        حاول
            ابدأ_تسجيل_فيديو(مسار)
            هذا._حالة = حالة_كاميرا.تسجل
            هذا._أشعر("بدء_تسجيل", {})
        امسك خ
            هذا._أشعر("خطأ", {رسالة: "فشل التسجيل"})
        نهاية
        ارجع هذا
    نهاية

    ## إيقاف تسجيل الفيديو
    دالة أوقف_تسجيل()
        حاول
            متغير مسار = أوقف_تسجيل_فيديو()
            هذا._حالة = حالة_كاميرا.مفتوحة
            هذا._أشعر("إيقاف_تسجيل", {مسار: مسار})
            ارجع مسار
        امسك خ
            ارجع لاشيء
        نهاية
    نهاية

    ## الحالة الحالية
    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    ## هل الكاميرا مفتوحة؟
    دالة مفتوحة()
        ارجع هذا._حالة == حالة_كاميرا.مفتوحة أو هذا._حالة == حالة_كاميرا.تسجل
    نهاية

    ## مراقبة أحداث الكاميرا
    دالة راقب(رد_نداء)
        هذا._مراقبون = هذا._مراقبون + [رد_نداء]
        ارجع هذا
    نهاية

    ## تحرير الموارد
    دالة تخلص()
        هذا.أغلق()
        هذا._مراقبون = []
    نهاية

    # ─── داخلي ───
    دالة _أشعر(نوع_حدث, بيانات)
        لكل مراقب في هذا._مراقبون
            مراقب({نوع: نوع_حدث, بيانات: بيانات})
        نهاية
    نهاية
نهاية

