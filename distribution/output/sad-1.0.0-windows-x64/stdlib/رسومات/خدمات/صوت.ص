# ===================================================================
# خدمة الصوت — Audio Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/صوت.ص
# ===================================================================
# مكتبة صوت شاملة تدعم:
#   - تشغيل ملفات صوتية (WAV, OGG, MP3)
#   - قائمة تشغيل (playlist)
#   - التحكم بالمستوى والتوازن
#   - أحداث الصوت (بدء، إيقاف، انتهاء)
#   - تسجيل صوتي
#   - مؤثرات صوتية قصيرة (SFX)
#
# الاستخدام:
#   استورد * من رسومات.خدمات.صوت
#   متغير مشغل = جديد مشغل_صوت()
#   مشغل.حمّل("موسيقى.wav")
#   مشغل.شغّل()
#
# المنصات المدعومة:
#   ✅ سطح المكتب (SDL2_mixer / miniaudio)
#   ✅ النواة (PC Speaker / AC97 / HDA عبر FFI)
#   ✅ الويب (Web Audio API)
#   ✅ أندرويد (MediaPlayer / SoundPool)
#   ✅ iOS (AVAudioPlayer / AVAudioEngine)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت وتعدادات
# ===================================================================

صدّر تعداد حالة_صوت
    متوقف
    يشغل
    مؤقت
    محمّل
    خطأ
نهاية

صدّر تعداد وضع_تكرار
    بدون         # تشغيل مرة واحدة
    الكل         # تكرار القائمة كلها
    واحد         # تكرار المقطع الحالي
نهاية

# ===================================================================
#       مشغل_صوت — المشغل الأساسي
# ===================================================================

صدّر صنف مشغل_صوت
    باني()
        هذا._معرف = لاشيء
        هذا._مسار = ""
        هذا._حالة = حالة_صوت.متوقف
        هذا._مستوى = 1.0
        هذا._توازن = 0.0
        هذا._تكرار = خطأ
        هذا._سرعة = 1.0
        هذا._مراقبون = []
    نهاية

    # ─── التحميل والتشغيل ───

    ## تحميل ملف صوتي
    دالة حمّل(مسار)
        هذا._مسار = مسار
        هذا._حالة = حالة_صوت.محمّل
        هذا._أشعر("تحميل", {مسار: مسار})
        ارجع هذا
    نهاية

    ## تشغيل الصوت
    دالة شغّل(مسار = لاشيء)
        إذا (مسار != لاشيء)
            هذا._مسار = مسار
        نهاية
        حاول
            هذا._معرف = شغّل_صوت(هذا._مسار, هذا._تكرار)
            هذا._حالة = حالة_صوت.يشغل
            هذا._أشعر("تشغيل", {مسار: هذا._مسار})
        امسك خ
            هذا._حالة = حالة_صوت.خطأ
            هذا._أشعر("خطأ", {رسالة: "فشل التشغيل"})
        نهاية
        ارجع هذا
    نهاية

    ## إيقاف مؤقت
    دالة ألبث()
        إذا (هذا._معرف != لاشيء)
            حاول
                ألبث_صوت(هذا._معرف)
                هذا._حالة = حالة_صوت.مؤقت
                هذا._أشعر("إلباث", {})
            امسك خ
                # تجاهل
            نهاية
        نهاية
        ارجع هذا
    نهاية

    ## استئناف بعد الإلباث
    دالة استأنف()
        إذا (هذا._معرف != لاشيء)
            حاول
                استأنف_صوت(هذا._معرف)
                هذا._حالة = حالة_صوت.يشغل
                هذا._أشعر("استئناف", {})
            امسك خ
                # تجاهل
            نهاية
        نهاية
        ارجع هذا
    نهاية

    ## إيقاف كامل
    دالة أوقف()
        إذا (هذا._معرف != لاشيء)
            حاول
                أوقف_صوت(هذا._معرف)
            امسك خ
                # تجاهل
            نهاية
        نهاية
        هذا._حالة = حالة_صوت.متوقف
        هذا._معرف = لاشيء
        هذا._أشعر("إيقاف", {})
        ارجع هذا
    نهاية

    # ─── التحكم بالخصائص ───

    ## ضبط مستوى الصوت (0.0 - 1.0)
    دالة المستوى(قيمة = لاشيء)
        إذا (قيمة != لاشيء)
            هذا._مستوى = قيمة
            حاول
                عين_مستوى_صوت(قيمة)
            امسك خ
                # تجاهل
            نهاية
            ارجع هذا
        نهاية
        ارجع هذا._مستوى
    نهاية

    ## ضبط التوازن يمين/يسار (-1.0 يسار --- 1.0 يمين)
    دالة التوازن(قيمة = لاشيء)
        إذا (قيمة != لاشيء)
            هذا._توازن = قيمة
            حاول
                عين_توازن_صوت(هذا._معرف, قيمة)
            امسك خ
                # تجاهل
            نهاية
            ارجع هذا
        نهاية
        ارجع هذا._توازن
    نهاية

    ## ضبط سرعة التشغيل (0.5 - 2.0)
    دالة السرعة(قيمة = لاشيء)
        إذا (قيمة != لاشيء)
            هذا._سرعة = قيمة
            حاول
                عين_سرعة_صوت(هذا._معرف, قيمة)
            امسك خ
                # تجاهل
            نهاية
            ارجع هذا
        نهاية
        ارجع هذا._سرعة
    نهاية

    ## تفعيل/تعطيل التكرار
    دالة كرّر(قيمة = صحيح)
        هذا._تكرار = قيمة
        ارجع هذا
    نهاية

    ## الحالة الحالية
    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    ## هل يعمل الآن؟
    دالة يعمل()
        ارجع هذا._حالة == حالة_صوت.يشغل
    نهاية

    # ─── الأحداث ───

    ## مراقبة أحداث المشغل
    دالة راقب(رد_نداء)
        هذا._مراقبون = هذا._مراقبون + [رد_نداء]
        ارجع هذا
    نهاية

    ## إلغاء مراقبة
    دالة ألغِ_مراقبة(رد_نداء)
        متغير جديدة = []
        لكل م في هذا._مراقبون
            إذا (م != رد_نداء)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مراقبون = جديدة
        ارجع هذا
    نهاية

    ## تحرير الموارد
    دالة تخلص()
        هذا.أوقف()
        هذا._مراقبون = []
    نهاية

    # ─── داخلي ───

    دالة _أشعر(نوع_حدث, بيانات)
        لكل مراقب في هذا._مراقبون
            مراقب({نوع: نوع_حدث, بيانات: بيانات})
        نهاية
    نهاية
نهاية

# ===================================================================
#       قائمة_تشغيل — Playlist
# ===================================================================

صدّر صنف قائمة_تشغيل
    باني(مقاطع = [])
        هذا._مقاطع = مقاطع
        هذا._الحالي = 0
        هذا._مشغل = جديد مشغل_صوت()
        هذا._وضع = وضع_تكرار.بدون
        هذا._عشوائي = خطأ
    نهاية

    ## إضافة مقطع
    دالة أضف(مسار)
        هذا._مقاطع = هذا._مقاطع + [مسار]
        ارجع هذا
    نهاية

    ## تشغيل القائمة
    دالة شغّل(فهرس = 0)
        إذا (طول(هذا._مقاطع) == 0)
            ارجع هذا
        نهاية
        هذا._الحالي = فهرس
        هذا._مشغل.شغّل(هذا._مقاطع[هذا._الحالي])
        ارجع هذا
    نهاية

    ## المقطع التالي
    دالة التالي()
        إذا (طول(هذا._مقاطع) == 0)
            ارجع هذا
        نهاية
        هذا._الحالي = (هذا._الحالي + 1) % طول(هذا._مقاطع)
        هذا._مشغل.شغّل(هذا._مقاطع[هذا._الحالي])
        ارجع هذا
    نهاية

    ## المقطع السابق
    دالة السابق()
        إذا (طول(هذا._مقاطع) == 0)
            ارجع هذا
        نهاية
        هذا._الحالي = هذا._الحالي - 1
        إذا (هذا._الحالي < 0)
            هذا._الحالي = طول(هذا._مقاطع) - 1
        نهاية
        هذا._مشغل.شغّل(هذا._مقاطع[هذا._الحالي])
        ارجع هذا
    نهاية

    ## إيقاف القائمة
    دالة أوقف()
        هذا._مشغل.أوقف()
        ارجع هذا
    نهاية

    ## إلباث
    دالة ألبث()
        هذا._مشغل.ألبث()
        ارجع هذا
    نهاية

    ## استئناف
    دالة استأنف()
        هذا._مشغل.استأنف()
        ارجع هذا
    نهاية

    ## ضبط وضع التكرار
    دالة وضع_التكرار(وضع)
        هذا._وضع = وضع
        ارجع هذا
    نهاية

    ## تفعيل/تعطيل الترتيب العشوائي
    دالة عشوائي(قيمة = صحيح)
        هذا._عشوائي = قيمة
        ارجع هذا
    نهاية

    ## عدد المقاطع
    دالة العدد()
        ارجع طول(هذا._مقاطع)
    نهاية

    ## المقطع الحالي
    دالة الحالي()
        إذا (طول(هذا._مقاطع) == 0)
            ارجع لاشيء
        نهاية
        ارجع هذا._مقاطع[هذا._الحالي]
    نهاية

    ## مسح القائمة
    دالة امسح()
        هذا._مشغل.أوقف()
        هذا._مقاطع = []
        هذا._الحالي = 0
        ارجع هذا
    نهاية
نهاية

