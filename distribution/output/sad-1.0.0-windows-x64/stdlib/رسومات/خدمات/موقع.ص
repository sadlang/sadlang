# ===================================================================
# خدمة الموقع الجغرافي — Geolocation Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/موقع.ص
# ===================================================================
# مكتبة موقع جغرافي شاملة تدعم:
#   - الموقع الحالي (GPS / Network / Fused)
#   - تتبع مستمر للموقع
#   - حساب المسافة بين نقطتين
#   - السياج الجغرافي (Geofencing)
#   - تحويل إحداثيات ↔ عناوين (Geocoding)
#
# المنصات المدعومة:
#   ✅ سطح المكتب (GeoIP / WiFi-based)
#   ✅ النواة (GPS NMEA عبر UART)
#   ✅ الويب (Geolocation API)
#   ✅ أندرويد (FusedLocationProvider)
#   ✅ iOS (CLLocationManager)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت وتعدادات
# ===================================================================

صدّر تعداد دقة_موقع
    منخفضة       # 3 كم — توفير طاقة
    متوسطة       # 100 م — شبكة
    عالية        # 10 م — GPS
    ملاحية       # 1 م — GPS + تحسين
نهاية

صدّر تعداد حالة_موقع
    متاح
    غير_متاح
    مرفوض
    خطأ
نهاية

# ===================================================================
#       موقع_جغرافي — بيانات نقطة جغرافية
# ===================================================================

صدّر صنف موقع_جغرافي
    باني(خط_عرض = 0, خط_طول = 0)
        هذا.خط_عرض = خط_عرض
        هذا.خط_طول = خط_طول
        هذا.دقة = 0
        هذا.ارتفاع = 0
        هذا.سرعة = 0
        هذا.اتجاه = 0
        هذا.وقت = 0
    نهاية

    ## المسافة إلى نقطة أخرى (بالمتر) — صيغة Haversine
    دالة المسافة_إلى(آخر)
        متغير ن_أ = 6371000
        متغير ف1 = هذا.خط_عرض * 3.14159265 / 180
        متغير ف2 = آخر.خط_عرض * 3.14159265 / 180
        متغير دف = (آخر.خط_عرض - هذا.خط_عرض) * 3.14159265 / 180
        متغير دل = (آخر.خط_طول - هذا.خط_طول) * 3.14159265 / 180

        # تقريب بسيط
        متغير س = دف * دف + دل * دل
        ارجع ن_أ * س ** 0.5
    نهاية

    ## تحويل إلى نص مقروء
    دالة نص()
        ارجع هذا.خط_عرض + "°, " + هذا.خط_طول + "°"
    نهاية
نهاية

# ===================================================================
#       خدمة_موقع — الواجهة الشاملة
# ===================================================================

صدّر صنف خدمة_موقع
    باني(دقة = دقة_موقع.عالية)
        هذا._دقة = دقة
        هذا._آخر_موقع = لاشيء
        هذا._نشط = خطأ
        هذا._معرف_تتبع = لاشيء
        هذا._مراقبون = []
    نهاية

    ## الحصول على الموقع الحالي
    دالة الموقع_الحالي()
        حاول
            متغير بيانات = احصل_موقع()
            إذا (بيانات != لاشيء)
                متغير م = جديد موقع_جغرافي()
                إذا (بيانات[0] != لاشيء)
                    م.خط_عرض = بيانات[0]
                نهاية
                إذا (بيانات[1] != لاشيء)
                    م.خط_طول = بيانات[1]
                نهاية
                هذا._آخر_موقع = م
                ارجع م
            نهاية
        امسك خ
            # تجاهل
        نهاية
        ارجع لاشيء
    نهاية

    ## بدء تتبع مستمر للموقع
    دالة ابدأ_تتبع(فترة = 5000)
        إذا (هذا._نشط)
            ارجع هذا
        نهاية
        هذا._نشط = صحيح
        متغير ذاتي = هذا
        حاول
            هذا._معرف_تتبع = مؤقت_تكراري(
                لامدا()
                    متغير موقع = ذاتي.الموقع_الحالي()
                    إذا (موقع != لاشيء)
                        لكل مراقب في ذاتي._مراقبون
                            مراقب(موقع)
                        نهاية
                    نهاية
                نهاية,
                فترة
            )
        امسك خ
            هذا._نشط = خطأ
        نهاية
        ارجع هذا
    نهاية

    ## إيقاف التتبع
    دالة أوقف_تتبع()
        إذا (هذا._معرف_تتبع != لاشيء)
            حاول
                ألغ_تكرار(هذا._معرف_تتبع)
            امسك خ
                # تجاهل
            نهاية
        نهاية
        هذا._نشط = خطأ
        هذا._معرف_تتبع = لاشيء
        ارجع هذا
    نهاية

    ## آخر موقع معروف
    دالة آخر_موقع()
        ارجع هذا._آخر_موقع
    نهاية

    ## هل التتبع نشط؟
    دالة نشط()
        ارجع هذا._نشط
    نهاية

    ## مراقبة تغييرات الموقع
    دالة راقب(رد_نداء)
        هذا._مراقبون = هذا._مراقبون + [رد_نداء]
        ارجع هذا
    نهاية

    ## المسافة بين موقعين
    دالة المسافة(موقع1, موقع2)
        ارجع موقع1.المسافة_إلى(موقع2)
    نهاية

    ## تحرير الموارد
    دالة تخلص()
        هذا.أوقف_تتبع()
        هذا._مراقبون = []
    نهاية
نهاية

# ===================================================================
#       دوال مساعدة (للتوافق مع API القديم)
# ===================================================================

## الحصول على الموقع الجغرافي الحالي
صدّر دالة الموقع()
    حاول
        ارجع احصل_موقع()
    امسك خ
        ارجع لاشيء
    نهاية
نهاية
