# ===================================================================
# خدمة الملفات — File I/O Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/ملفات.ص
# ===================================================================
# مكتبة ملفات شاملة تدعم:
#   - قراءة/كتابة ملفات نصية وثنائية
#   - عمليات المجلدات (إنشاء/حذف/سرد)
#   - مراقبة تغييرات الملفات
#   - اختيار ملفات (مربعات حوار)
#   - معلومات الملفات (حجم/تاريخ/نوع)
#   - البحث عن ملفات
#
# الاستخدام:
#   استورد * من رسومات.خدمات.ملفات
#   متغير م = جديد نظام_ملفات()
#   م.اكتب("ملف.txt", "مرحباً")
#
# المنصات المدعومة:
#   ✅ سطح المكتب (C++ fstream + filesystem)
#   ✅ النواة (قطاعات خام / FAT / ext4 عبر FFI)
#   ✅ الويب (File API / IndexedDB)
#   ✅ أندرويد (ContentResolver + SAF)
#   ✅ iOS (NSFileManager + Documents directory)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت وتعدادات
# ===================================================================

صدّر تعداد وضع_ملف
    قراءة           # فتح للقراءة فقط
    كتابة           # فتح للكتابة (يمسح المحتوى)
    إضافة           # فتح للإضافة في النهاية
    قراءة_كتابة     # فتح للقراءة والكتابة
نهاية

صدّر تعداد نوع_عنصر
    ملف
    مجلد
    رابط
    غير_معروف
نهاية

# ===================================================================
#       معلومات_ملف — بيانات ملف أو مجلد
# ===================================================================

صدّر صنف معلومات_ملف
    باني(مسار)
        هذا.مسار = مسار
        هذا._تحميل()
    نهاية

    دالة _تحميل()
        حاول
            هذا.الاسم = _استخرج_اسم(هذا.مسار)
            هذا.الامتداد = _استخرج_امتداد(هذا.مسار)
            هذا.الحجم = حجم_ملف(هذا.مسار)
            هذا.موجود = ملف_موجود(هذا.مسار)
            هذا.هو_مجلد = هل_مجلد(هذا.مسار)
            هذا.هو_ملف = ليس هذا.هو_مجلد
            هذا.تاريخ_التعديل = تاريخ_تعديل_ملف(هذا.مسار)
        امسك خ
            هذا.الاسم = ""
            هذا.الامتداد = ""
            هذا.الحجم = 0
            هذا.موجود = خطأ
            هذا.هو_مجلد = خطأ
            هذا.هو_ملف = خطأ
            هذا.تاريخ_التعديل = ""
        نهاية
    نهاية

    ## الحجم بصيغة مقروءة (كيلو/ميغا/غيغا)
    دالة حجم_مقروء()
        إذا (هذا.الحجم < 1024)
            ارجع هذا.الحجم + " بايت"
        نهاية
        إذا (هذا.الحجم < 1048576)
            ارجع (هذا.الحجم / 1024) + " ك.ب"
        نهاية
        إذا (هذا.الحجم < 1073741824)
            ارجع (هذا.الحجم / 1048576) + " م.ب"
        نهاية
        ارجع (هذا.الحجم / 1073741824) + " غ.ب"
    نهاية

    ## تحديث المعلومات
    دالة حدّث()
        هذا._تحميل()
        ارجع هذا
    نهاية
نهاية

# ===================================================================
#       نظام_ملفات — الواجهة الشاملة
# ===================================================================

صدّر صنف نظام_ملفات
    باني(مسار_أساس = "")
        هذا._مسار_أساس = مسار_أساس
    نهاية

    # ─── القراءة والكتابة ───

    ## قراءة ملف نصي بالكامل
    دالة اقرأ(مسار)
        ارجع اقرأ_ملف(هذا._مسار(مسار))
    نهاية

    ## كتابة نص في ملف (يستبدل المحتوى)
    دالة اكتب(مسار, محتوى)
        ارجع اكتب_ملف(هذا._مسار(مسار), محتوى)
    نهاية

    ## إضافة نص في نهاية ملف
    دالة أضف(مسار, محتوى)
        حاول
            متغير قديم = هذا.اقرأ(مسار)
            ارجع هذا.اكتب(مسار, قديم + محتوى)
        امسك خ
            ارجع هذا.اكتب(مسار, محتوى)
        نهاية
    نهاية

    ## قراءة ملف كأسطر (مصفوفة نصوص)
    دالة اقرأ_أسطر(مسار)
        متغير محتوى = هذا.اقرأ(مسار)
        إذا (محتوى == لاشيء)
            ارجع []
        نهاية
        حاول
            ارجع قسّم_نص(محتوى, "\n")
        امسك خ
            ارجع [محتوى]
        نهاية
    نهاية

    ## كتابة أسطر في ملف
    دالة اكتب_أسطر(مسار, أسطر)
        متغير محتوى = ""
        لكل سطر في أسطر
            محتوى = محتوى + سطر + "\n"
        نهاية
        ارجع هذا.اكتب(مسار, محتوى)
    نهاية

    # ─── فحص الوجود والمعلومات ───

    ## هل الملف/المجلد موجود
    دالة موجود(مسار)
        حاول
            ارجع ملف_موجود(هذا._مسار(مسار))
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## الحصول على معلومات ملف
    دالة معلومات(مسار)
        ارجع جديد معلومات_ملف(هذا._مسار(مسار))
    نهاية

    ## حجم الملف بالبايتات
    دالة حجم(مسار)
        حاول
            ارجع حجم_ملف(هذا._مسار(مسار))
        امسك خ
            ارجع 0
        نهاية
    نهاية

    # ─── عمليات المجلدات ───

    ## إنشاء مجلد (مع المجلدات الأب إن لم تكن موجودة)
    دالة أنشئ_مجلد(مسار)
        حاول
            ارجع أنشئ_مجلد_نظام(هذا._مسار(مسار))
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## سرد محتويات مجلد
    دالة اسرد(مسار = "")
        حاول
            ارجع اسرد_مجلد(هذا._مسار(مسار))
        امسك خ
            ارجع []
        نهاية
    نهاية

    ## سرد الملفات فقط في مجلد
    دالة اسرد_ملفات(مسار = "")
        متغير عناصر = هذا.اسرد(مسار)
        متغير ملفات = []
        لكل ع في عناصر
            إذا (ليس هل_مجلد(هذا._مسار(مسار) + "/" + ع))
                ملفات = ملفات + [ع]
            نهاية
        نهاية
        ارجع ملفات
    نهاية

    ## سرد المجلدات فقط
    دالة اسرد_مجلدات(مسار = "")
        متغير عناصر = هذا.اسرد(مسار)
        متغير مجلدات = []
        لكل ع في عناصر
            إذا (هل_مجلد(هذا._مسار(مسار) + "/" + ع))
                مجلدات = مجلدات + [ع]
            نهاية
        نهاية
        ارجع مجلدات
    نهاية

    # ─── النسخ والنقل والحذف ───

    ## نسخ ملف
    دالة انسخ(من, إلى)
        متغير محتوى = هذا.اقرأ(من)
        ارجع هذا.اكتب(إلى, محتوى)
    نهاية

    ## نقل/إعادة تسمية ملف
    دالة انقل(من, إلى)
        حاول
            ارجع انقل_ملف(هذا._مسار(من), هذا._مسار(إلى))
        امسك خ
            هذا.انسخ(من, إلى)
            هذا.احذف(من)
            ارجع صحيح
        نهاية
    نهاية

    ## حذف ملف أو مجلد
    دالة احذف(مسار)
        حاول
            ارجع احذف_ملف(هذا._مسار(مسار))
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    # ─── حوارات اختيار الملفات ───

    ## فتح نافذة اختيار ملف
    دالة اختر(تصفية = "")
        حاول
            ارجع اختر_ملف_فتح(تصفية)
        امسك خ
            ارجع لاشيء
        نهاية
    نهاية

    ## فتح نافذة حفظ ملف
    دالة اختر_حفظ(اسم_افتراضي = "")
        حاول
            ارجع اختر_ملف_حفظ(اسم_افتراضي)
        امسك خ
            ارجع لاشيء
        نهاية
    نهاية

    ## فتح نافذة اختيار مجلد
    دالة اختر_مجلد()
        حاول
            ارجع اختر_مجلد_فتح()
        امسك خ
            ارجع لاشيء
        نهاية
    نهاية

    # ─── مسارات خاصة ───

    ## مجلد المستندات
    دالة مجلد_المستندات()
        حاول
            ارجع مسار_المستندات()
        امسك خ
            ارجع "."
        نهاية
    نهاية

    ## مجلد التطبيق المؤقت
    دالة مجلد_مؤقت()
        حاول
            ارجع مسار_المؤقت()
        امسك خ
            ارجع "./tmp"
        نهاية
    نهاية

    ## المجلد الحالي
    دالة المجلد_الحالي()
        حاول
            ارجع مسار_الحالي()
        امسك خ
            ارجع "."
        نهاية
    نهاية

    # ─── مراقبة الملفات ───

    ## مراقبة تغييرات ملف/مجلد
    دالة راقب(مسار, رد_نداء)
        حاول
            ارجع راقب_ملف(هذا._مسار(مسار), رد_نداء)
        امسك خ
            ارجع لاشيء
        نهاية
    نهاية

    ## إلغاء مراقبة
    دالة ألغِ_مراقبة(معرف_مراقبة)
        حاول
            ألغِ_مراقبة_ملف(معرف_مراقبة)
        امسك خ
            # تجاهل
        نهاية
    نهاية

    # ─── داخلي ───

    دالة _مسار(مسار)
        إذا (هذا._مسار_أساس == "")
            ارجع مسار
        نهاية
        ارجع هذا._مسار_أساس + "/" + مسار
    نهاية
نهاية

# ===================================================================
#       دوال مساعدة عامة (للتوافق مع API القديم)
# ===================================================================

## قراءة ملف نصي
صدّر دالة اقرأ(مسار)
    ارجع اقرأ_ملف(مسار)
نهاية

## كتابة نص في ملف
صدّر دالة اكتب(مسار, محتوى)
    ارجع اكتب_ملف(مسار, محتوى)
نهاية

## هل الملف موجود؟
صدّر دالة موجود(مسار)
    حاول
        ارجع ملف_موجود(مسار)
    امسك خ
        ارجع خطأ
    نهاية
نهاية

## فتح نافذة اختيار ملف
صدّر دالة اختر_ملف(تصفية = "")
    حاول
        ارجع اختر_ملف_فتح(تصفية)
    امسك خ
        ارجع لاشيء
    نهاية
نهاية

## فتح نافذة حفظ ملف
صدّر دالة اختر_حفظ(اسم_افتراضي = "")
    حاول
        ارجع اختر_ملف_حفظ(اسم_افتراضي)
    امسك خ
        ارجع لاشيء
    نهاية
نهاية

# ===================================================================
# دوال مساعدة داخلية
# ===================================================================

دالة _استخرج_اسم(مسار)
    متغير أجزاء = مسار
    حاول
        أجزاء = قسّم_نص(مسار, "/")
        ارجع أجزاء[طول(أجزاء) - 1]
    امسك خ
        ارجع مسار
    نهاية
نهاية

دالة _استخرج_امتداد(مسار)
    متغير اسم = _استخرج_اسم(مسار)
    حاول
        متغير أجزاء = قسّم_نص(اسم, ".")
        إذا (طول(أجزاء) > 1)
            ارجع أجزاء[طول(أجزاء) - 1]
        نهاية
    امسك خ
        # تجاهل
    نهاية
    ارجع ""
نهاية
