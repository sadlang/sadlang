# ===================================================================
#       بيانات_إيماءة — بيانات حدث الإيماءة
# ===================================================================

صدّر صنف بيانات_إيماءة
    باني()
        هذا.نوع = لاشيء
        هذا.حالة = حالة_إيماءة.بداية
        هذا.س = 0
        هذا.ص = 0
        هذا.دلتا_س = 0
        هذا.دلتا_ص = 0
        هذا.مقياس = 1.0
        هذا.زاوية = 0.0
        هذا.سرعة_س = 0
        هذا.سرعة_ص = 0
    نهاية
نهاية

