# ===================================================================
# خدمة قاعدة البيانات — Database Service (مكتبة شاملة)
# stdlib/رسومات/خدمات/قاعدة_بيانات.ص
# ===================================================================
#
# مكتبة شاملة للتعامل مع قواعد البيانات تتضمن:
#   - Key-Value Store بسيط
#   - ORM Builder للاستعلامات
#   - نظام الترحيلات (Migrations)
#   - التخزين المحلي
#   - المعاملات (Transactions)
#   - ذاكرة التخزين المؤقت
#
# الاستخدام الأساسي:
#   استورد * من رسومات.خدمات.قاعدة_بيانات
#   افتح("تطبيقي")
#   نفذ("SET user=أحمد")
#   متغير قيمة = نفذ("GET user")
#
# الاستخدام المتقدم:
#   متغير قب = جديد قاعدة_بيانات("تطبيقي")
#   قب.جدول("مستخدمين").أدخل({"اسم": "أحمد", "عمر": 25})
#   متغير نتائج = قب.جدول("مستخدمين").حيث("عمر", ">", 18).احصل()
#
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    الثوابت والتعدادات
# ===================================================================

صدّر تعداد نوع_قاعدة
    ذاكرة          # في الذاكرة فقط
    محلية          # ملف محلي
    SQLite
    PostgreSQL
    MySQL
نهاية

صدّر تعداد نوع_عمود
    نص
    رقم
    عشري
    منطقي
    تاريخ
    وقت
    كائن
    مصفوفة
نهاية

# ===================================================================
#                    نتيجة الاستعلام
# ===================================================================

صدّر صنف نتيجة_استعلام
    باني()
        هذا.نجح = خطأ
        هذا.صفوف = []
        هذا.عدد_متأثر = 0
        هذا.آخر_معرف = لاشيء
        هذا.خطأ = لاشيء
    نهاية

    دالة أول()
        إذا (هذا.صفوف.الطول() > 0)
            ارجع هذا.صفوف[0]
        نهاية
        ارجع لاشيء
    نهاية

    دالة الكل()
        ارجع هذا.صفوف
    نهاية

    دالة عدد()
        ارجع هذا.صفوف.الطول()
    نهاية

    دالة فارغة()
        ارجع هذا.صفوف.الطول() == 0
    نهاية
نهاية

# ===================================================================
#                    باني الاستعلامات (Query Builder)
# ===================================================================

صدّر صنف باني_استعلام
    باني(قاعدة, جدول)
        هذا._قاعدة = قاعدة
        هذا._جدول = جدول
        هذا._أعمدة = ["*"]
        هذا._شروط = []
        هذا._ترتيب = []
        هذا._حد = لاشيء
        هذا._تخطي = 0
        هذا._ربط = []
    نهاية

    # ─── اختيار الأعمدة ───

    دالة اختر(أعمدة)
        إذا (أعمدة.نوع() == "مصفوفة")
            هذا._أعمدة = أعمدة
        وإلا
            هذا._أعمدة = [أعمدة]
        نهاية
        ارجع هذا
    نهاية

    # ─── الشروط ───

    دالة حيث(عمود, عامل, قيمة = لاشيء)
        إذا (قيمة == لاشيء)
            # حيث(عمود, قيمة) → حيث(عمود, "=", قيمة)
            قيمة = عامل
            عامل = "="
        نهاية
        هذا._شروط.أضف({
            "عمود": عمود,
            "عامل": عامل,
            "قيمة": قيمة,
            "رابط": "AND"
        })
        ارجع هذا
    نهاية

    دالة أو_حيث(عمود, عامل, قيمة = لاشيء)
        إذا (قيمة == لاشيء)
            قيمة = عامل
            عامل = "="
        نهاية
        هذا._شروط.أضف({
            "عمود": عمود,
            "عامل": عامل,
            "قيمة": قيمة,
            "رابط": "OR"
        })
        ارجع هذا
    نهاية

    دالة حيث_باطل(عمود)
        هذا._شروط.أضف({
            "عمود": عمود,
            "عامل": "IS",
            "قيمة": "NULL",
            "رابط": "AND"
        })
        ارجع هذا
    نهاية

    دالة حيث_ليس_باطل(عمود)
        هذا._شروط.أضف({
            "عمود": عمود,
            "عامل": "IS NOT",
            "قيمة": "NULL",
            "رابط": "AND"
        })
        ارجع هذا
    نهاية

    دالة حيث_في(عمود, قيم)
        هذا._شروط.أضف({
            "عمود": عمود,
            "عامل": "IN",
            "قيمة": قيم,
            "رابط": "AND"
        })
        ارجع هذا
    نهاية

    دالة حيث_بين(عمود, من, إلى)
        هذا._شروط.أضف({
            "عمود": عمود,
            "عامل": "BETWEEN",
            "قيمة": [من, إلى],
            "رابط": "AND"
        })
        ارجع هذا
    نهاية

    دالة حيث_يشبه(عمود, نمط)
        هذا._شروط.أضف({
            "عمود": عمود,
            "عامل": "LIKE",
            "قيمة": نمط,
            "رابط": "AND"
        })
        ارجع هذا
    نهاية

    # ─── الترتيب ───

    دالة رتّب(عمود, اتجاه = "ASC")
        هذا._ترتيب.أضف({
            "عمود": عمود,
            "اتجاه": اتجاه
        })
        ارجع هذا
    نهاية

    دالة رتّب_تنازلي(عمود)
        ارجع هذا.رتّب(عمود, "DESC")
    نهاية

    # ─── التحديد ───

    دالة حد(عدد)
        هذا._حد = عدد
        ارجع هذا
    نهاية

    دالة تخطى(عدد)
        هذا._تخطي = عدد
        ارجع هذا
    نهاية

    دالة صفحة(رقم, حجم = 10)
        هذا._حد = حجم
        هذا._تخطي = (رقم - 1) * حجم
        ارجع هذا
    نهاية

    # ─── الربط ───

    دالة اربط(جدول, عمود1, عامل, عمود2)
        هذا._ربط.أضف({
            "نوع": "INNER",
            "جدول": جدول,
            "عمود1": عمود1,
            "عامل": عامل,
            "عمود2": عمود2
        })
        ارجع هذا
    نهاية

    دالة اربط_يسار(جدول, عمود1, عامل, عمود2)
        هذا._ربط.أضف({
            "نوع": "LEFT",
            "جدول": جدول,
            "عمود1": عمود1,
            "عامل": عامل,
            "عمود2": عمود2
        })
        ارجع هذا
    نهاية

    # ─── التنفيذ ───

    دالة احصل()
        ارجع هذا._قاعدة._نفذ_استعلام(هذا, "SELECT")
    نهاية

    دالة أول()
        هذا._حد = 1
        متغير نتيجة = هذا.احصل()
        ارجع نتيجة.أول()
    نهاية

    دالة عدد()
        هذا._أعمدة = ["COUNT(*) as عدد"]
        متغير نتيجة = هذا.احصل()
        إذا (نتيجة.أول() != لاشيء)
            ارجع نتيجة.أول()["عدد"]
        نهاية
        ارجع 0
    نهاية

    دالة موجود()
        ارجع هذا.عدد() > 0
    نهاية

    دالة أدخل(بيانات)
        ارجع هذا._قاعدة._نفذ_إدخال(هذا._جدول, بيانات)
    نهاية

    دالة أدخل_متعدد(مصفوفة_بيانات)
        متغير نتائج = []
        لكل بيانات في مصفوفة_بيانات
            نتائج.أضف(هذا.أدخل(بيانات))
        نهاية
        ارجع نتائج
    نهاية

    دالة حدّث(بيانات)
        ارجع هذا._قاعدة._نفذ_تحديث(هذا._جدول, بيانات, هذا._شروط)
    نهاية

    دالة احذف()
        ارجع هذا._قاعدة._نفذ_حذف(هذا._جدول, هذا._شروط)
    نهاية

    دالة أو_أنشئ(بيانات)
        متغير موجود = هذا.أول()
        إذا (موجود != لاشيء)
            ارجع موجود
        نهاية
        ارجع هذا.أدخل(بيانات)
    نهاية

    دالة حدّث_أو_أنشئ(شروط, بيانات)
        لكل مفتاح في شروط.مفاتيح()
            هذا.حيث(مفتاح, شروط[مفتاح])
        نهاية
        متغير موجود = هذا.أول()
        إذا (موجود != لاشيء)
            ارجع هذا.حدّث(بيانات)
        نهاية
        # دمج الشروط مع البيانات
        لكل مفتاح في شروط.مفاتيح()
            بيانات[مفتاح] = شروط[مفتاح]
        نهاية
        ارجع هذا.أدخل(بيانات)
    نهاية
نهاية

# ===================================================================
#                    تعريف الجدول (Schema)
# ===================================================================

صدّر صنف باني_جدول
    باني(اسم)
        هذا._اسم = اسم
        هذا._أعمدة = []
        هذا._مفاتيح_أساسية = []
        هذا._فهارس = []
    نهاية

    دالة معرف(اسم = "معرف")
        هذا._أعمدة.أضف({
            "اسم": اسم,
            "نوع": "INTEGER",
            "مفتاح_أساسي": صحيح,
            "تلقائي": صحيح
        })
        ارجع هذا
    نهاية

    دالة نص(اسم, طول = 255)
        هذا._أعمدة.أضف({
            "اسم": اسم,
            "نوع": "VARCHAR(" + طول + ")",
            "قابل_للصفر": صحيح
        })
        ارجع هذا
    نهاية

    دالة نص_طويل(اسم)
        هذا._أعمدة.أضف({
            "اسم": اسم,
            "نوع": "TEXT",
            "قابل_للصفر": صحيح
        })
        ارجع هذا
    نهاية

    دالة رقم(اسم)
        هذا._أعمدة.أضف({
            "اسم": اسم,
            "نوع": "INTEGER",
            "قابل_للصفر": صحيح
        })
        ارجع هذا
    نهاية

    دالة عشري(اسم, دقة = 8, كسور = 2)
        هذا._أعمدة.أضف({
            "اسم": اسم,
            "نوع": "DECIMAL(" + دقة + "," + كسور + ")",
            "قابل_للصفر": صحيح
        })
        ارجع هذا
    نهاية

    دالة منطقي(اسم)
        هذا._أعمدة.أضف({
            "اسم": اسم,
            "نوع": "BOOLEAN",
            "قابل_للصفر": صحيح,
            "افتراضي": خطأ
        })
        ارجع هذا
    نهاية

    دالة تاريخ(اسم)
        هذا._أعمدة.أضف({
            "اسم": اسم,
            "نوع": "DATE",
            "قابل_للصفر": صحيح
        })
        ارجع هذا
    نهاية

    دالة وقت(اسم)
        هذا._أعمدة.أضف({
            "اسم": اسم,
            "نوع": "DATETIME",
            "قابل_للصفر": صحيح
        })
        ارجع هذا
    نهاية

    دالة أوقات()
        هذا.وقت("أنشئ_في")
        هذا.وقت("حدّث_في")
        ارجع هذا
    نهاية

    دالة مفتاح_خارجي(اسم, جدول_مرجعي, عمود_مرجعي = "معرف")
        هذا._أعمدة.أضف({
            "اسم": اسم,
            "نوع": "INTEGER",
            "مفتاح_خارجي": {
                "جدول": جدول_مرجعي,
                "عمود": عمود_مرجعي
            }
        })
        ارجع هذا
    نهاية

    دالة فريد(عمود)
        هذا._فهارس.أضف({
            "نوع": "UNIQUE",
            "أعمدة": [عمود]
        })
        ارجع هذا
    نهاية

    دالة فهرس(أعمدة)
        هذا._فهارس.أضف({
            "نوع": "INDEX",
            "أعمدة": أعمدة
        })
        ارجع هذا
    نهاية

    # معدّلات للعمود الأخير
    دالة مطلوب()
        إذا (هذا._أعمدة.الطول() > 0)
            هذا._أعمدة[هذا._أعمدة.الطول() - 1]["قابل_للصفر"] = خطأ
        نهاية
        ارجع هذا
    نهاية

    دالة افتراضي(قيمة)
        إذا (هذا._أعمدة.الطول() > 0)
            هذا._أعمدة[هذا._أعمدة.الطول() - 1]["افتراضي"] = قيمة
        نهاية
        ارجع هذا
    نهاية

    دالة تعليق(نص)
        إذا (هذا._أعمدة.الطول() > 0)
            هذا._أعمدة[هذا._أعمدة.الطول() - 1]["تعليق"] = نص
        نهاية
        ارجع هذا
    نهاية
نهاية

# ===================================================================
#                    الترحيلات (Migrations)
# ===================================================================

صدّر صنف ترحيل
    باني(اسم)
        هذا.اسم = اسم
        هذا._صعود = لاشيء
        هذا._هبوط = لاشيء
    نهاية

    دالة صعود(دالة_صعود)
        هذا._صعود = دالة_صعود
        ارجع هذا
    نهاية

    دالة هبوط(دالة_هبوط)
        هذا._هبوط = دالة_هبوط
        ارجع هذا
    نهاية

    دالة نفذ_صعود(قاعدة)
        إذا (هذا._صعود != لاشيء)
            هذا._صعود(قاعدة)
        نهاية
    نهاية

    دالة نفذ_هبوط(قاعدة)
        إذا (هذا._هبوط != لاشيء)
            هذا._هبوط(قاعدة)
        نهاية
    نهاية
نهاية

صدّر صنف مدير_ترحيلات
    باني(قاعدة)
        هذا._قاعدة = قاعدة
        هذا._ترحيلات = []
        هذا._منفذة = []
    نهاية

    دالة سجل(ترحيل)
        هذا._ترحيلات.أضف(ترحيل)
        ارجع هذا
    نهاية

    دالة رحّل()
        لكل ترحيل في هذا._ترحيلات
            إذا (ليس هذا._منفذة.يحتوي(ترحيل.اسم))
                ترحيل.نفذ_صعود(هذا._قاعدة)
                هذا._منفذة.أضف(ترحيل.اسم)
            نهاية
        نهاية
        ارجع هذا
    نهاية

    دالة تراجع(عدد = 1)
        متغير عداد = 0
        بينما (عداد < عدد و هذا._منفذة.الطول() > 0)
            متغير اسم = هذا._منفذة.آخر()
            لكل ترحيل في هذا._ترحيلات
                إذا (ترحيل.اسم == اسم)
                    ترحيل.نفذ_هبوط(هذا._قاعدة)
                    توقف
                نهاية
            نهاية
            هذا._منفذة.احذف_آخر()
            عداد = عداد + 1
        نهاية
        ارجع هذا
    نهاية

    دالة أعد_ضبط()
        بينما (هذا._منفذة.الطول() > 0)
            هذا.تراجع(1)
        نهاية
        ارجع هذا
    نهاية

    دالة حالة()
        ارجع {
            "منفذة": هذا._منفذة,
            "معلقة": هذا._ترحيلات_المعلقة()
        }
    نهاية

    دالة _ترحيلات_المعلقة()
        متغير معلقة = []
        لكل ترحيل في هذا._ترحيلات
            إذا (ليس هذا._منفذة.يحتوي(ترحيل.اسم))
                معلقة.أضف(ترحيل.اسم)
            نهاية
        نهاية
        ارجع معلقة
    نهاية
نهاية

# ===================================================================
#                    قاعدة البيانات الرئيسية
# ===================================================================

صدّر صنف قاعدة_بيانات
    باني(اسم, نوع = نوع_قاعدة.محلية)
        هذا._اسم = اسم
        هذا._نوع = نوع
        هذا._مفتوحة = خطأ
        هذا._بيانات = {}  # للذاكرة والمحلية
        هذا._ذاكرة_مؤقتة = {}
        هذا._استخدام_ذاكرة = خطأ
        هذا._في_معاملة = خطأ
        هذا._نسخة_معاملة = {}
    نهاية

    # ─── الفتح والإغلاق ───

    دالة افتح()
        إذا (هذا._نوع == نوع_قاعدة.ذاكرة)
            هذا._بيانات = {}
        وإلا
            # تحميل من الملف
            حاول
                افتح_قاعدة(هذا._اسم)
            امسك (خ)
                # قاعدة جديدة
            نهاية
        نهاية
        هذا._مفتوحة = صحيح
        ارجع هذا
    نهاية

    دالة أغلق()
        إذا (هذا._نوع != نوع_قاعدة.ذاكرة)
            أغلق_قاعدة()
        نهاية
        هذا._مفتوحة = خطأ
        ارجع هذا
    نهاية

    دالة مفتوحة()
        ارجع هذا._مفتوحة
    نهاية

    # ─── الجداول ───

    دالة جدول(اسم)
        ارجع جديد باني_استعلام(هذا, اسم)
    نهاية

    دالة أنشئ_جدول(اسم, دالة_بناء)
        متغير باني = جديد باني_جدول(اسم)
        دالة_بناء(باني)
        # TODO: تنفيذ إنشاء الجدول الفعلي
        ارجع هذا
    نهاية

    دالة احذف_جدول(اسم)
        # TODO: تنفيذ حذف الجدول
        ارجع هذا
    نهاية

    دالة جدول_موجود(اسم)
        # TODO: فحص وجود الجدول
        ارجع خطأ
    نهاية

    # ─── المعاملات ───

    دالة ابدأ_معاملة()
        هذا._في_معاملة = صحيح
        هذا._نسخة_معاملة = هذا._نسخ_عميق(هذا._بيانات)
        ارجع هذا
    نهاية

    دالة أكد_معاملة()
        هذا._في_معاملة = خطأ
        هذا._نسخة_معاملة = {}
        ارجع هذا
    نهاية

    دالة تراجع_معاملة()
        هذا._بيانات = هذا._نسخة_معاملة
        هذا._في_معاملة = خطأ
        هذا._نسخة_معاملة = {}
        ارجع هذا
    نهاية

    دالة معاملة(دالة_عمل)
        هذا.ابدأ_معاملة()
        حاول
            دالة_عمل(هذا)
            هذا.أكد_معاملة()
        امسك (خطأ)
            هذا.تراجع_معاملة()
            ارمي خطأ
        نهاية
        ارجع هذا
    نهاية

    # ─── الذاكرة المؤقتة ───

    دالة فعّل_ذاكرة_مؤقتة()
        هذا._استخدام_ذاكرة = صحيح
        ارجع هذا
    نهاية

    دالة امسح_ذاكرة_مؤقتة()
        هذا._ذاكرة_مؤقتة = {}
        ارجع هذا
    نهاية

    # ─── Key-Value بسيط ───

    دالة عيّن(مفتاح, قيمة)
        هذا._بيانات[مفتاح] = قيمة
        ارجع هذا
    نهاية

    دالة احصل(مفتاح, افتراضي = لاشيء)
        إذا (هذا._بيانات[مفتاح] != لاشيء)
            ارجع هذا._بيانات[مفتاح]
        نهاية
        ارجع افتراضي
