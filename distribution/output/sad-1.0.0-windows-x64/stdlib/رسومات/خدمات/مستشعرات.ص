# ===================================================================
# خدمة المستشعرات — Sensors Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/مستشعرات.ص
# ===================================================================
# مكتبة مستشعرات شاملة تدعم:
#   - مقياس التسارع (Accelerometer)
#   - الجيروسكوب (Gyroscope)
#   - البوصلة (Magnetometer)
#   - مستشعر الضغط (Barometer)
#   - مستشعر القرب (Proximity)
#   - مستشعر الإضاءة (Light)
#   - مستشعر الرطوبة والحرارة
#   - عداد الخطوات (Pedometer)
#
# المنصات المدعومة:
#   ✅ سطح المكتب (محاكاة / أجهزة USB)
#   ✅ النواة (I2C / SPI / MMIO)
#   ✅ الويب (Generic Sensor API)
#   ✅ أندرويد (SensorManager)
#   ✅ iOS (Core Motion)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت وتعدادات
# ===================================================================

صدّر تعداد نوع_مستشعر
    تسارع           # Accelerometer
    دوران           # Gyroscope
    مغناطيسي        # Magnetometer
    ضغط             # Barometer
    قرب             # Proximity
    إضاءة           # Light
    حرارة           # Temperature
    رطوبة           # Humidity
    خطوات           # Pedometer
    جاذبية          # Gravity
نهاية

صدّر تعداد دقة_مستشعر
    منخفضة       # تحديث بطيء — توفير طاقة
    عادية        # تحديث معتدل
    عالية        # تحديث سريع
    أقصى         # أعلى معدل ممكن
نهاية

# ===================================================================
#       قراءة_مستشعر — بيانات قراءة واحدة
# ===================================================================

صدّر صنف قراءة_مستشعر
    باني(نوع = لاشيء, س = 0, ص = 0, ع = 0, قيمة = 0, دقة = 0)
        هذا.نوع = نوع
        هذا.س = س         # المحور X
        هذا.ص = ص         # المحور Y
        هذا.ع = ع         # المحور Z
        هذا.قيمة = قيمة   # قيمة أحادية (للمستشعرات أحادية البعد)
        هذا.دقة = دقة     # دقة القراءة
        هذا.وقت = 0
    نهاية
نهاية

# ===================================================================
#       مستشعر — الصنف الشامل
# ===================================================================

صدّر صنف مستشعر
    باني(نوع)
        هذا._نوع = نوع
        هذا._مراقبون = []
        هذا._معرف = لاشيء
        هذا._نشط = خطأ
        هذا._آخر_قراءة = لاشيء
        هذا._دقة = دقة_مستشعر.عادية
    نهاية

    ## بدء الاستماع للمستشعر
    دالة ابدأ(دقة = لاشيء)
        إذا (دقة != لاشيء)
            هذا._دقة = دقة
        نهاية
        حاول
            هذا._معرف = ابدأ_مستشعر(هذا._نوع, هذا._دقة)
            هذا._نشط = صحيح
        امسك خ
            هذا._نشط = خطأ
        نهاية
        ارجع هذا
    نهاية

    ## إيقاف الاستماع
    دالة أوقف()
        إذا (هذا._معرف != لاشيء)
            حاول
                أوقف_مستشعر(هذا._معرف)
            امسك خ
                # تجاهل
            نهاية
        نهاية
        هذا._نشط = خطأ
        هذا._معرف = لاشيء
        ارجع هذا
    نهاية

    ## قراءة القيمة الحالية
    دالة اقرأ()
        حاول
            متغير بيانات = قراءة_مستشعر(هذا._نوع)
            هذا._آخر_قراءة = بيانات
            ارجع بيانات
        امسك خ
            ارجع لاشيء
        نهاية
    نهاية

    ## هل المستشعر متاح؟
    دالة متاح()
        حاول
            متغير قائمة = المستشعرات_المتاحة()
            ارجع قائمة != لاشيء
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## هل نشط؟
    دالة نشط()
        ارجع هذا._نشط
    نهاية

    ## آخر قراءة
    دالة آخر_قراءة()
        ارجع هذا._آخر_قراءة
    نهاية

    ## مراقبة القراءات
    دالة راقب(رد_نداء)
        هذا._مراقبون = هذا._مراقبون + [رد_نداء]
        ارجع هذا
    نهاية

    ## تحرير الموارد
    دالة تخلص()
        هذا.أوقف()
        هذا._مراقبون = []
    نهاية
نهاية

