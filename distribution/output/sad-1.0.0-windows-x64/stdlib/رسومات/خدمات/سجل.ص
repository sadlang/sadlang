# ===================================================================
# خدمة السجل — Logging Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/سجل.ص
# ===================================================================
# مكتبة تسجيل شاملة تدعم:
#   - مستويات تسجيل (تتبع، معلومات، تحذير، خطأ، حرج)
#   - تنسيق مخصص للرسائل
#   - مخرجات متعددة (وحدة التحكم، ملف، شبكة)
#   - تصفية حسب المستوى
#   - سياق وعلامات (Tags)
#
# المنصات المدعومة:
#   ✅ سطح المكتب (stderr / ملفات سجل)
#   ✅ النواة (serial port / ring buffer)
#   ✅ الويب (console.log / console.error)
#   ✅ أندرويد (android.util.Log / Logcat)
#   ✅ iOS (os_log / NSLog)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت
# ===================================================================

صدّر تعداد مستوى_سجل
    تتبع       # Trace — تفاصيل دقيقة
    تصحيح      # Debug — معلومات تصحيح
    معلومات     # Info — رسائل عامة
    تحذير      # Warning — تحذيرات
    خطأ        # Error — أخطاء
    حرج        # Fatal — أخطاء حرجة
نهاية

# ===================================================================
#       مسجّل — Logger
# ===================================================================

صدّر صنف مسجّل
    باني(اسم = "تطبيق", مستوى_أدنى = مستوى_سجل.معلومات)
        هذا._اسم = اسم
        هذا._مستوى_أدنى = مستوى_أدنى
        هذا._مخرجات = []
        هذا._سجلات = []
        هذا._حجم_أقصى = 1000
        هذا._عين_مخرج_افتراضي()
    نهاية

    # ─── التسجيل بالمستويات ───

    ## رسالة تتبع
    دالة تتبع(رسالة, بيانات = لاشيء)
        هذا._سجِّل(مستوى_سجل.تتبع, رسالة, بيانات)
    نهاية

    ## رسالة تصحيح
    دالة تصحيح(رسالة, بيانات = لاشيء)
        هذا._سجِّل(مستوى_سجل.تصحيح, رسالة, بيانات)
    نهاية

    ## رسالة معلومات
    دالة معلومة(رسالة, بيانات = لاشيء)
        هذا._سجِّل(مستوى_سجل.معلومات, رسالة, بيانات)
    نهاية

    ## رسالة تحذير
    دالة تحذير(رسالة, بيانات = لاشيء)
        هذا._سجِّل(مستوى_سجل.تحذير, رسالة, بيانات)
    نهاية

    ## رسالة خطأ
    دالة خطأ(رسالة, بيانات = لاشيء)
        هذا._سجِّل(مستوى_سجل.خطأ, رسالة, بيانات)
    نهاية

    ## رسالة حرجة
    دالة حرج(رسالة, بيانات = لاشيء)
        هذا._سجِّل(مستوى_سجل.حرج, رسالة, بيانات)
    نهاية

    # ─── الإعدادات ───

    ## تعيين المستوى الأدنى
    دالة المستوى(مستوى)
        هذا._مستوى_أدنى = مستوى
        ارجع هذا
    نهاية

    ## إضافة مخرج مخصص
    دالة أضف_مخرج(دالة_مخرج)
        هذا._مخرجات = هذا._مخرجات + [دالة_مخرج]
        ارجع هذا
    نهاية

    ## الحصول على آخر N سجل
    دالة آخر(عدد = 50)
        إذا (عدد >= طول(هذا._سجلات))
            ارجع هذا._سجلات
        نهاية
        متغير نتيجة = []
        متغير بداية = طول(هذا._سجلات) - عدد
        لكل ف في هذا._سجلات
            نتيجة = نتيجة + [ف]
        نهاية
        ارجع نتيجة
    نهاية

    ## مسح السجلات
    دالة امسح()
        هذا._سجلات = []
        ارجع هذا
    نهاية

    # ─── داخلي ───

    دالة _سجِّل(مستوى, رسالة, بيانات)
        إذا (مستوى < هذا._مستوى_أدنى)
            ارجع
        نهاية

        متغير سجل = {
            مستوى: مستوى,
            رسالة: رسالة,
            مصدر: هذا._اسم,
            بيانات: بيانات
        }

        هذا._سجلات = هذا._سجلات + [سجل]

        متغير نص_منسق = "[" + هذا._اسم_مستوى(مستوى) + "] " + هذا._اسم + ": " + رسالة

        لكل مخرج في هذا._مخرجات
            مخرج(نص_منسق, سجل)
        نهاية
    نهاية

    دالة _اسم_مستوى(مستوى)
        إذا (مستوى == مستوى_سجل.تتبع)
            ارجع "تتبع"
        نهاية
        إذا (مستوى == مستوى_سجل.تصحيح)
            ارجع "تصحيح"
        نهاية
        إذا (مستوى == مستوى_سجل.معلومات)
            ارجع "معلومات"
        نهاية
        إذا (مستوى == مستوى_سجل.تحذير)
            ارجع "تحذير"
        نهاية
        إذا (مستوى == مستوى_سجل.خطأ)
            ارجع "خطأ"
        نهاية
        ارجع "حرج"
    نهاية

    دالة _عين_مخرج_افتراضي()
        هذا._مخرجات = [
            لامدا(نص, سجل)
                حاول
                    سجل(سجل.مستوى, نص)
                امسك خ
                    اطبع(نص)
                نهاية
            نهاية
        ]
    نهاية
نهاية

# ===================================================================
#       دوال مساعدة (للتوافق مع API القديم)
# ===================================================================

متغير _المسجل_الافتراضي = لاشيء
دالة _المسجل()
    إذا (_المسجل_الافتراضي == لاشيء)
        _المسجل_الافتراضي = جديد مسجّل()
    نهاية
    ارجع _المسجل_الافتراضي
نهاية

## تسجيل رسالة معلومات
صدّر دالة معلومة(رسالة)
    _المسجل().معلومة(رسالة)
نهاية

## تسجيل تحذير
صدّر دالة تحذير(رسالة)
    _المسجل().تحذير(رسالة)
نهاية

## تسجيل خطأ
صدّر دالة خطأ_سجل(رسالة)
    _المسجل().خطأ(رسالة)
نهاية

## تسجيل رسالة بمستوى مخصص
صدّر دالة سجل_رسالة(مستوى, رسالة)
    حاول
        سجل(مستوى, رسالة)
    امسك خ
        اطبع("[" + مستوى + "] " + رسالة)
    نهاية
نهاية
