# ─── صورة مُلاشاة (FadeInImage) ───
صدّر صنف صورة_متلاشية يرث عنصر
    باني(
        مزود_نائب،
        مزود_صورة،
        مدة_تلاشي = 300،
        عرض = لاشيء،
        ارتفاع = لاشيء،
        ملاءمة = "احتواء"
    )
        هذا._نوع = "صورة_متلاشية"
        هذا._مزود_نائب = مزود_نائب
        هذا._مزود_صورة = مزود_صورة
        هذا._مدة = مدة_تلاشي
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
        هذا._ملاءمة = ملاءمة
    نهاية

    ساكن دالة من_شبكة(
        رابط،
        نائب،
        عرض = لاشيء،
        ارتفاع = لاشيء
    )
        ارجع جديد صورة_متلاشية(
            جديد صورة_أصول(نائب)،
            جديد صورة_شبكة(رابط)،
            300،
            عرض،
            ارتفاع
        )
    نهاية
نهاية
