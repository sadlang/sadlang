    نهاية
نهاية

# ─── ذاكرة الصور المؤقتة (Singleton) ───
صدّر صنف ذاكرة_صور
    ساكن متغير _نسخة = لاشيء

    ساكن دالة النسخة()
        إذا (_نسخة == لاشيء)
            _نسخة = جديد ذاكرة_صور()
        نهاية
        ارجع _نسخة
    نهاية

    باني()
        هذا._ذاكرة = {}
        هذا._ترتيب_استخدام = []
        هذا._حد_أقصى = 100  # عدد الصور
        هذا._حجم_حالي = 0
        هذا._حد_حجم = 100 * 1024 * 1024  # 100 ميجابايت
    نهاية

    غير_متزامن دالة احصل(مفتاح)
        إذا (هذا._ذاكرة[مفتاح])
            # تحديث ترتيب الاستخدام (LRU)
            هذا._ترتيب_استخدام.أزل(مفتاح)
            هذا._ترتيب_استخدام.أضف(مفتاح)
            ارجع هذا._ذاكرة[مفتاح]
        نهاية
        ارجع لاشيء
    نهاية

    غير_متزامن دالة خزّن(مفتاح، بيانات)
        # التحقق من الحجم
        متغير حجم_جديد = بيانات.الطول()
        
        # إزالة العناصر القديمة إذا لزم الأمر
        بينما (هذا._حجم_حالي + حجم_جديد > هذا._حد_حجم و هذا._ترتيب_استخدام.الطول() > 0)
            متغير أقدم = هذا._ترتيب_استخدام[0]
            هذا._ترتيب_استخدام.أزل_عند(0)
            متغير حجم_قديم = هذا._ذاكرة[أقدم].الطول()
            هذا._ذاكرة.أزل(أقدم)
            هذا._حجم_حالي -= حجم_قديم
        نهاية
        
        هذا._ذاكرة[مفتاح] = بيانات
        هذا._ترتيب_استخدام.أضف(مفتاح)
        هذا._حجم_حالي += حجم_جديد
    نهاية

    دالة امسح()
        هذا._ذاكرة = {}
        هذا._ترتيب_استخدام = []
        هذا._حجم_حالي = 0
    نهاية

    دالة أزل(مفتاح)
        إذا (هذا._ذاكرة[مفتاح])
            هذا._حجم_حالي -= هذا._ذاكرة[مفتاح].الطول()
            هذا._ذاكرة.أزل(مفتاح)
            هذا._ترتيب_استخدام.أزل(مفتاح)
        نهاية
    نهاية

    دالة الحجم_الحالي()
        ارجع هذا._حجم_حالي
    نهاية

    دالة العدد()
        ارجع هذا._ترتيب_استخدام.الطول()
    نهاية
نهاية

# ─── عنصر صورة الشبكة (Image.network) ───
صدّر صنف صورة يرث عنصر
    باني(
        مزود،
        عرض = لاشيء،
        ارتفاع = لاشيء،
        ملاءمة = "احتواء"،
        محاذاة = "وسط"،
        تكرار = "بدون"،
        عنصر_تحميل = لاشيء،
        عنصر_خطأ = لاشيء،
        لون = لاشيء،
        وضع_دمج_لون = لاشيء،
        دلالات = لاشيء
    )
        هذا._نوع = "صورة"
        هذا._مزود = مزود
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
        هذا._ملاءمة = ملاءمة
        هذا._محاذاة = محاذاة
        هذا._تكرار = تكرار
        هذا._عنصر_تحميل = عنصر_تحميل
        هذا._عنصر_خطأ = عنصر_خطأ
        هذا._لون = لون
        هذا._وضع_دمج = وضع_دمج_لون
        هذا._دلالات = دلالات
    نهاية

    # ─── منشئات سريعة ───
    ساكن دالة شبكة(
        رابط،
        عرض = لاشيء،
        ارتفاع = لاشيء،
        ملاءمة = "احتواء"،
        عنصر_تحميل = لاشيء،
        عنصر_خطأ = لاشيء،
        ترويسات = لاشيء
    )
        ارجع جديد صورة(
            جديد صورة_شبكة(رابط، 1.0، ترويسات)،
            عرض،
            ارتفاع،
            ملاءمة،
            "وسط"،
            "بدون"،
            عنصر_تحميل،
            عنصر_خطأ
        )
    نهاية

    ساكن دالة أصل(
        اسم،
        عرض = لاشيء،
        ارتفاع = لاشيء،
        ملاءمة = "احتواء"،
        حزمة = لاشيء
    )
        ارجع جديد صورة(
            جديد صورة_أصول(اسم، حزمة)،
            عرض،
            ارتفاع،
            ملاءمة
        )
    نهاية

    ساكن دالة ملف(
        مسار،
        عرض = لاشيء،
        ارتفاع = لاشيء،
        ملاءمة = "احتواء"
    )
        ارجع جديد صورة(
            جديد صورة_ملف(مسار)،
            عرض،
            ارتفاع،
            ملاءمة
        )
    نهاية

    ساكن دالة ذاكرة(
        بايتات،
        عرض = لاشيء،
        ارتفاع = لاشيء،
        ملاءمة = "احتواء"
    )
        ارجع جديد صورة(
            جديد صورة_ذاكرة(بايتات)،
            عرض،
            ارتفاع،
            ملاءمة
        )
    نهاية
نهاية

