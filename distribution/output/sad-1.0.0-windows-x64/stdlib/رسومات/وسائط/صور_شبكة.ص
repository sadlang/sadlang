استورد * من رسومات.أساس.عنصر

# ─── مزود الصورة (ImageProvider) ───
صدّر صنف مزود_صورة
    باني()
        هذا._مقياس = 1.0
    نهاية

    دالة حمّل()
        # يُنفذ في الأصناف الفرعية
        ارجع لاشيء
    نهاية

    دالة المقياس()
        ارجع هذا._مقياس
    نهاية
نهاية

# ─── صورة الشبكة (NetworkImage) ───
صدّر صنف صورة_شبكة يرث مزود_صورة
    باني(رابط، مقياس = 1.0، ترويسات = لاشيء)
        الأساس()
        هذا._رابط = رابط
        هذا._مقياس = مقياس
        هذا._ترويسات = ترويسات أو {}
        هذا._حالة = "لم_يبدأ"
        هذا._بيانات = لاشيء
        هذا._خطأ = لاشيء
    نهاية

    دالة الرابط()
        ارجع هذا._رابط
    نهاية

    غير_متزامن دالة حمّل()
        إذا (هذا._حالة == "مكتمل")
            ارجع هذا._بيانات
        نهاية
        
        هذا._حالة = "جارٍ_التحميل"
        
        حاول
            # تحقق من الذاكرة المؤقتة أولاً
            متغير مُخَزَّن = انتظر ذاكرة_صور.النسخة().احصل(هذا._رابط)
            إذا (مُخَزَّن != لاشيء)
                هذا._بيانات = مُخَزَّن
                هذا._حالة = "مكتمل"
                ارجع هذا._بيانات
            نهاية
            
            # تحميل من الشبكة
            متغير استجابة = انتظر طلب_شبكة(هذا._رابط، هذا._ترويسات)
            هذا._بيانات = استجابة.البيانات()
            
            # تخزين في الذاكرة المؤقتة
            انتظر ذاكرة_صور.النسخة().خزّن(هذا._رابط، هذا._بيانات)
            
            هذا._حالة = "مكتمل"
            ارجع هذا._بيانات
        امسك خ
            هذا._خطأ = خ
            هذا._حالة = "فشل"
            ارمي خ
        نهاية
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة الخطأ()
        ارجع هذا._خطأ
    نهاية
نهاية

# ─── صورة الأصول (AssetImage) ───
صدّر صنف صورة_أصول يرث مزود_صورة
    باني(اسم_الأصل، حزمة = لاشيء، مقياس = 1.0)
        الأساس()
        هذا._اسم = اسم_الأصل
        هذا._حزمة = حزمة
        هذا._مقياس = مقياس
    نهاية

    دالة الاسم()
        ارجع هذا._اسم
    نهاية

    غير_متزامن دالة حمّل()
        متغير مسار = هذا._حزمة ? "حزم/" + هذا._حزمة + "/" + هذا._اسم : هذا._اسم
        ارجع انتظر حمّل_أصل(مسار)
    نهاية
نهاية

