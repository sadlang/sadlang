# أدوات مساعدة للتخطيط
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف قيود_صندوق
    باني(أدنى_عرض، أقصى_عرض، أدنى_ارتفاع، أقصى_ارتفاع)
        هذا.أدنى_عرض = أدنى_عرض أو 0
        هذا.أقصى_عرض = أقصى_عرض أو لانهائي
        هذا.أدنى_ارتفاع = أدنى_ارتفاع أو 0
        هذا.أقصى_ارتفاع = أقصى_ارتفاع أو لانهائي
    نهاية

    دالة قيّد(حجم)
        ارجع {
            عرض: ماكس(هذا.أدنى_عرض، مين(هذا.أقصى_عرض، حجم.عرض))،
            ارتفاع: ماكس(هذا.أدنى_ارتفاع، مين(هذا.أقصى_ارتفاع، حجم.ارتفاع))
        }
    نهاية

    دالة فضفاض()
        ارجع جديد قيود_صندوق(0، هذا.أقصى_عرض، 0، هذا.أقصى_ارتفاع)
    نهاية

    دالة مشدود()
        ارجع جديد قيود_صندوق(هذا.أقصى_عرض، هذا.أقصى_عرض، هذا.أقصى_ارتفاع، هذا.أقصى_ارتفاع)
    نهاية

    ساكن دالة ضيقة(حجم)
        ارجع جديد قيود_صندوق(حجم.عرض، حجم.عرض، حجم.ارتفاع، حجم.ارتفاع)
    نهاية

    ساكن دالة فضفاضة_كلياً()
        ارجع جديد قيود_صندوق(0، لانهائي، 0، لانهائي)
    نهاية
نهاية
