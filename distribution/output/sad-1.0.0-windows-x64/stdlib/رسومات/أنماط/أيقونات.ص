# ===================================================================
# نظام الأيقونات — Icon System (Material Icons equivalent)
# ===================================================================
# أيقونات مسماة ومنظمة حسب الفئات
#
# الاستخدام:
#   استورد * من رسومات.أنماط.أيقونات
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── أيقونة (Icon widget) ───
صدّر صنف أيقونة يرث عنصر
    باني(اسم, حجم = لاشيء, لون = لاشيء)
        هذا._نوع = "أيقونة"
        هذا._خصائص = {}
        هذا._خصائص["اسم"] = اسم
        هذا._خصائص["حجم"] = حجم
        هذا._خصائص["لون"] = لون
    نهاية
نهاية

# ─── زر_أيقونة (IconButton) ───
صدّر صنف زر_أيقونة يرث عنصر
    باني(أيقونة, عند_الضغط = لاشيء, حجم = لاشيء, لون = لاشيء, تلميح = لاشيء)
        هذا._نوع = "زر_أيقونة"
        هذا._خصائص = {}
        هذا._خصائص["أيقونة"] = أيقونة
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["حجم"] = حجم
        هذا._خصائص["لون"] = لون
        هذا._خصائص["تلميح"] = تلميح
    نهاية
نهاية

