# ─── حواف (EdgeInsets) ───
صدّر صنف حواف
    باني(أعلى, يمين, أسفل, يسار)
        هذا.أعلى = أعلى
        هذا.يمين = يمين
        هذا.أسفل = أسفل
        هذا.يسار = يسار
    نهاية

    ساكن دالة الكل(قيمة)
        ارجع جديد حواف(قيمة, قيمة, قيمة, قيمة)
    نهاية

    ساكن دالة متماثل(أفقي, عمودي)
        ارجع جديد حواف(عمودي, أفقي, عمودي, أفقي)
    نهاية

    ساكن دالة فقط(أعلى, يمين, أسفل, يسار)
        إذا (أعلى == لاشيء)
            أعلى = 0
        نهاية
        إذا (يمين == لاشيء)
            يمين = 0
        نهاية
        إذا (أسفل == لاشيء)
            أسفل = 0
        نهاية
        إذا (يسار == لاشيء)
            يسار = 0
        نهاية
        ارجع جديد حواف(أعلى, يمين, أسفل, يسار)
    نهاية
نهاية

# ─── زوايا_مستديرة (BorderRadius) ───
صدّر صنف زوايا_مستديرة
    باني(أعلى_يمين, أعلى_يسار, أسفل_يمين, أسفل_يسار)
        هذا.أعلى_يمين = أعلى_يمين
        هذا.أعلى_يسار = أعلى_يسار
        هذا.أسفل_يمين = أسفل_يمين
        هذا.أسفل_يسار = أسفل_يسار
    نهاية

    ساكن دالة الكل(نصف_قطر)
        ارجع جديد زوايا_مستديرة(نصف_قطر, نصف_قطر, نصف_قطر, نصف_قطر)
    نهاية

    ساكن دالة دائري()
        ارجع جديد زوايا_مستديرة(9999, 9999, 9999, 9999)
    نهاية

    ساكن دالة أعلى(نصف_قطر)
        ارجع جديد زوايا_مستديرة(نصف_قطر, نصف_قطر, 0, 0)
    نهاية

    ساكن دالة أسفل(نصف_قطر)
        ارجع جديد زوايا_مستديرة(0, 0, نصف_قطر, نصف_قطر)
    نهاية
نهاية

# ─── حد (Border) ───
صدّر صنف حد
    باني(عرض, لون, نمط)
        هذا.عرض = عرض
        هذا.لون = لون
        هذا.نمط = نمط
    نهاية

    ساكن دالة الكل(عرض, لون)
        ارجع جديد حد(عرض, لون, "صلب")
    نهاية

    ساكن دالة متقطع(عرض, لون)
        ارجع جديد حد(عرض, لون, "متقطع")
    نهاية

    ساكن دالة منقط(عرض, لون)
        ارجع جديد حد(عرض, لون, "منقط")
    نهاية

    ساكن دالة لاشيء()
        ارجع جديد حد(0, "شفاف", "لا")
    نهاية
نهاية

# ─── ظل_صندوق (BoxShadow) ───
صدّر صنف ظل_صندوق
    باني(لون, إزاحة_أفقي, إزاحة_عمودي, ضبابية, انتشار)
        هذا.لون = لون
        هذا.إزاحة_أفقي = إزاحة_أفقي
        هذا.إزاحة_عمودي = إزاحة_عمودي
        هذا.ضبابية = ضبابية
        هذا.انتشار = انتشار
    نهاية

    ساكن دالة خفيف()
        ارجع جديد ظل_صندوق("#00000020", 0, 2, 4, 0)
    نهاية

    ساكن دالة متوسط()
        ارجع جديد ظل_صندوق("#00000040", 0, 4, 8, 2)
    نهاية

    ساكن دالة ثقيل()
        ارجع جديد ظل_صندوق("#00000060", 0, 8, 16, 4)
    نهاية
نهاية

# ─── تزيين_صندوق (BoxDecoration) ───
صدّر صنف تزيين_صندوق
    باني()
        هذا.لون = لاشيء
        هذا.حد = لاشيء
        هذا.زوايا = لاشيء
        هذا.ظلال = []
        هذا.صورة = لاشيء
        هذا.تدرج = لاشيء
    نهاية

    دالة مع_لون(لون)
        هذا.لون = لون
        ارجع هذا
    نهاية

    دالة مع_حد(حد)
        هذا.حد = حد
        ارجع هذا
    نهاية

    دالة مع_زوايا(زوايا)
        هذا.زوايا = زوايا
        ارجع هذا
    نهاية

    دالة مع_ظل(ظل)
        هذا.ظلال.أضف(ظل)
        ارجع هذا
    نهاية

    دالة مع_تدرج(تدرج)
        هذا.تدرج = تدرج
        ارجع هذا
    نهاية
نهاية

# ─── تدرج_خطي_تزيين (LinearGradient — decoration layer) ───
# ملاحظة: أُعيد تسميته لتجنب التعارض مع رسم/لوحة.ص
صدّر صنف تدرج_خطي_تزيين
    باني(ألوان, بداية, نهاية_ق)
        هذا.ألوان = ألوان
        هذا.بداية = بداية
        هذا.نهاية_ق = نهاية_ق
    نهاية

    ساكن دالة أفقي(ألوان)
        ارجع جديد تدرج_خطي_تزيين(ألوان, "يسار", "يمين")
    نهاية

    ساكن دالة عمودي(ألوان)
        ارجع جديد تدرج_خطي_تزيين(ألوان, "أعلى", "أسفل")
    نهاية

    ساكن دالة قطري(ألوان)
        ارجع جديد تدرج_خطي_تزيين(ألوان, "أعلى_يسار", "أسفل_يمين")
    نهاية
نهاية

# ─── تدرج_دائري_تزيين (RadialGradient — decoration layer) ───
# ملاحظة: أُعيد تسميته لتجنب التعارض مع عناصر/تأثيرات.ص
صدّر صنف تدرج_دائري_تزيين
    باني(ألوان, نصف_قطر)
        هذا.ألوان = ألوان
        هذا.نصف_قطر = نصف_قطر
    نهاية
نهاية
