# ===================================================================
# نظام الأنماط والتزيين — Decorations System
# ===================================================================
# مستوحى من Flutter (BoxDecoration, BorderRadius, EdgeInsets, etc.)
#
# الاستخدام:
#   استورد * من رسومات.أنماط.تزيين
