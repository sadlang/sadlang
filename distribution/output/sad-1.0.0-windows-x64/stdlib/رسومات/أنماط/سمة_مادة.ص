# ─── سمة_مادة (ThemeData) — الواجهة الرئيسية ───
صدّر صنف سمة_مادة
    باني(
        ألوان = لاشيء,
        نصوص = لاشيء,
        أزرار = لاشيء,
        بطاقات = لاشيء,
        إدخال = لاشيء,
        سطوع = "فاتح"
    )
        إذا (سطوع == "داكن")
            هذا.ألوان = ألوان أو ألوان_مخطط.داكن()
        وإلا
            هذا.ألوان = ألوان أو ألوان_مخطط.فاتح()
        نهاية
        
        هذا.نصوص = نصوص أو جديد نمط_نص()
        هذا.أزرار = أزرار أو جديد نمط_زر()
        هذا.بطاقات = بطاقات أو جديد نمط_بطاقة()
        هذا.إدخال = إدخال أو جديد نمط_إدخال()
        هذا.سطوع = سطوع
    نهاية

    # ─── سمة فاتحة جاهزة ───
    ساكن دالة فاتحة()
        ارجع جديد سمة_مادة(سطوع = "فاتح")
    نهاية

    # ─── سمة داكنة جاهزة ───
    ساكن دالة داكنة()
        ارجع جديد سمة_مادة(سطوع = "داكن")
    نهاية

    # ─── نسخ مع تعديلات ───
    دالة انسخ(
        ألوان = لاشيء,
        نصوص = لاشيء,
        أزرار = لاشيء,
        بطاقات = لاشيء,
        إدخال = لاشيء,
        سطوع = لاشيء
    )
        ارجع جديد سمة_مادة(
            ألوان = ألوان أو هذا.ألوان,
            نصوص = نصوص أو هذا.نصوص,
            أزرار = أزرار أو هذا.أزرار,
            بطاقات = بطاقات أو هذا.بطاقات,
            إدخال = إدخال أو هذا.إدخال,
            سطوع = سطوع أو هذا.سطوع
        )
    نهاية
نهاية

# ─── موفر_سمة (Theme Provider) للتوارث ───
صدّر صنف موفر_سمة
    باني(سمة, ابن)
        هذا._سمة = سمة
        هذا._ابن = ابن
    نهاية

    دالة السمة()
        ارجع هذا._سمة
    نهاية

    دالة الابن()
        ارجع هذا._ابن
    نهاية
نهاية

# ─── السمة الحالية (Singleton) ───
متغير _سمة_حالية = لاشيء

صدّر دالة السمة()
    إذا (_سمة_حالية == لاشيء)
        _سمة_حالية = سمة_مادة.فاتحة()
    نهاية
    ارجع _سمة_حالية
نهاية

صدّر دالة عيّن_السمة(سمة)
    _سمة_حالية = سمة
نهاية

صدّر دالة بدّل_السمة()
    إذا (_سمة_حالية.سطوع == "فاتح")
        _سمة_حالية = سمة_مادة.داكنة()
    وإلا
        _سمة_حالية = سمة_مادة.فاتحة()
    نهاية
    ارجع _سمة_حالية
نهاية

# ─── دالة مساعدة لإنشاء سمة من لون ───
صدّر دالة سمة_من_لون(لون, داكن = خطأ)
    متغير ألوان = ألوان_مخطط.من_لون(لون, داكن)
    ارجع جديد سمة_مادة(ألوان = ألوان, سطوع = داكن ? "داكن" : "فاتح")
نهاية
