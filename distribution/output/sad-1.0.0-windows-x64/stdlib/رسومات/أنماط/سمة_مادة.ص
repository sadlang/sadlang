# ─── ألوان_المخطط (ColorScheme) ───
صدّر صنف ألوان_مخطط
    باني(
        رئيسي = "#6750A4",
        على_رئيسي = "#FFFFFF",
        حاوية_رئيسية = "#EADDFF",
        على_حاوية_رئيسية = "#21005D",
        ثانوي = "#625B71",
        على_ثانوي = "#FFFFFF",
        حاوية_ثانوية = "#E8DEF8",
        على_حاوية_ثانوية = "#1D192B",
        ثالثي = "#7D5260",
        على_ثالثي = "#FFFFFF",
        خطأ = "#B3261E",
        على_خطأ = "#FFFFFF",
        حاوية_خطأ = "#F9DEDC",
        على_حاوية_خطأ = "#410E0B",
        خلفية = "#FFFBFE",
        على_خلفية = "#1C1B1F",
        سطح = "#FFFBFE",
        على_سطح = "#1C1B1F",
        محيط = "#79747E",
        ظل = "#000000",
        سطح_فاتح = "#E7E0EC",
        سطح_فاتح_جداً = "#F7F2F9"
    )
        هذا.رئيسي = رئيسي
        هذا.على_رئيسي = على_رئيسي
        هذا.حاوية_رئيسية = حاوية_رئيسية
        هذا.على_حاوية_رئيسية = على_حاوية_رئيسية
        هذا.ثانوي = ثانوي
        هذا.على_ثانوي = على_ثانوي
        هذا.حاوية_ثانوية = حاوية_ثانوية
        هذا.على_حاوية_ثانوية = على_حاوية_ثانوية
        هذا.ثالثي = ثالثي
        هذا.على_ثالثي = على_ثالثي
        هذا.خطأ = خطأ
        هذا.على_خطأ = على_خطأ
        هذا.حاوية_خطأ = حاوية_خطأ
        هذا.على_حاوية_خطأ = على_حاوية_خطأ
        هذا.خلفية = خلفية
        هذا.على_خلفية = على_خلفية
        هذا.سطح = سطح
        هذا.على_سطح = على_سطح
        هذا.محيط = محيط
        هذا.ظل = ظل
        هذا.سطح_فاتح = سطح_فاتح
        هذا.سطح_فاتح_جداً = سطح_فاتح_جداً
    نهاية

    # ─── ألوان فاتحة جاهزة ───
    ساكن دالة فاتح()
        ارجع جديد ألوان_مخطط()
    نهاية

    # ─── ألوان داكنة جاهزة ───
    ساكن دالة داكن()
        ارجع جديد ألوان_مخطط(
            رئيسي = "#D0BCFF",
            على_رئيسي = "#381E72",
            حاوية_رئيسية = "#4F378B",
            على_حاوية_رئيسية = "#EADDFF",
            ثانوي = "#CCC2DC",
            على_ثانوي = "#332D41",
            حاوية_ثانوية = "#4A4458",
            على_حاوية_ثانوية = "#E8DEF8",
            ثالثي = "#EFB8C8",
            على_ثالثي = "#492532",
            خطأ = "#F2B8B5",
            على_خطأ = "#601410",
            حاوية_خطأ = "#8C1D18",
            على_حاوية_خطأ = "#F9DEDC",
            خلفية = "#1C1B1F",
            على_خلفية = "#E6E1E5",
            سطح = "#1C1B1F",
            على_سطح = "#E6E1E5",
            محيط = "#938F99",
            ظل = "#000000",
            سطح_فاتح = "#49454F",
            سطح_فاتح_جداً = "#2B2930"
        )
    نهاية

    # ─── إنشاء من لون أساسي ───
    ساكن دالة من_لون(لون_أساسي, داكن = خطأ)
        # توليد الألوان من اللون الأساسي
        متغير ألوان = جديد ألوان_مخطط()
        ألوان.رئيسي = لون_أساسي
        # TODO: توليد باقي الألوان تلقائياً
        ارجع ألوان
    نهاية
نهاية

