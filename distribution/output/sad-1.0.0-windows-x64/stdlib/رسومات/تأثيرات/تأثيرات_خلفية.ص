استورد * من رسومات.أساس.عنصر

# ─── مرشّح الصورة (ImageFilter) ───
صدّر صنف مرشّح_صورة
    باني()
        هذا._نوع = "مرشّح"
    نهاية
نهاية

# ─── تمويه (Blur Filter) ───
صدّر صنف تمويه يرث مرشّح_صورة
    باني(س = 0، ص= 0، وضع_الحدود = "مثبت")
        الأساس()
        هذا._نوع = "تمويه"
        هذا._س = س
        هذا._ص = ص
        هذا._وضع_الحدود = وضع_الحدود
    نهاية

    دالة سيغما_س()
        ارجع هذا._س
    نهاية

    دالة سيغما_ص()
        ارجع هذا._ص
    نهاية

    # تأثيرات مُعدّة مسبقاً
    ساكن دالة خفيف()
        ارجع جديد تمويه(2، 2)
    نهاية

    ساكن دالة متوسط()
        ارجع جديد تمويه(5، 5)
    نهاية

    ساكن دالة قوي()
        ارجع جديد تمويه(10، 10)
    نهاية

    ساكن دالة زجاجي()
        ارجع جديد تمويه(15، 15)
    نهاية
نهاية

# ─── أوضاع الحدود للتمويه ───
صدّر تعداد وضع_حدود_تمويه
    مثبت،    # الحدود تأخذ لون أقرب بكسل
    مكرر،    # تتكرر الصورة
    مرآة،    # انعكاس مرآة
    فارغ     # شفاف خارج الحدود
نهاية

# ─── مرشّح المصفوفة (Matrix Filter) ───
صدّر صنف مرشّح_مصفوفة يرث مرشّح_صورة
    باني(مصفوفة)
        الأساس()
        هذا._نوع = "مصفوفة"
        هذا._مصفوفة = مصفوفة
    نهاية

    # مصفوفات شائعة
    ساكن دالة تدرج_رمادي()
        ارجع جديد مرشّح_مصفوفة([
            0.2126، 0.7152، 0.0722، 0، 0،
            0.2126، 0.7152، 0.0722، 0، 0،
            0.2126، 0.7152، 0.0722، 0، 0،
            0،      0،      0،      1، 0
        ])
    نهاية

    ساكن دالة بني_داكن()
        ارجع جديد مرشّح_مصفوفة([
            0.393، 0.769، 0.189، 0، 0،
            0.349، 0.686، 0.168، 0، 0،
            0.272، 0.534، 0.131، 0، 0،
            0،     0،     0،     1، 0
        ])
    نهاية

    ساكن دالة عكس_الألوان()
        ارجع جديد مرشّح_مصفوفة([
            -1، 0،  0،  0، 255،
            0،  -1، 0،  0، 255،
            0،  0،  -1، 0، 255،
            0،  0،  0،  1، 0
        ])
    نهاية

    ساكن دالة تشبع(قيمة)
        متغير ف = (1 - قيمة) / 3
        متغير ت = ف + قيمة
        ارجع جديد مرشّح_مصفوفة([
            ت، ف، ف، 0، 0،
            ف، ت، ف، 0، 0،
            ف، ف، ت، 0، 0،
            0، 0، 0، 1، 0
        ])
    نهاية

    ساكن دالة سطوع(قيمة)
        ارجع جديد مرشّح_مصفوفة([
            1، 0، 0، 0، قيمة،
            0، 1، 0، 0، قيمة،
            0، 0، 1، 0، قيمة،
            0، 0، 0، 1، 0
        ])
    نهاية

    ساكن دالة تباين(قيمة)
        متغير ت = 0.5 * (1 - قيمة)
        ارجع جديد مرشّح_مصفوفة([
            قيمة، 0،     0،     0، ت،
            0،    قيمة،  0،     0، ت،
            0،    0،     قيمة، 0، ت،
            0،    0،     0،     1، 0
        ])
    نهاية
نهاية

# ─── مرشّح مركّب (Composed Filter) ───
صدّر صنف مرشّح_مركّب يرث مرشّح_صورة
    باني(خارجي، داخلي)
        الأساس()
        هذا._نوع = "مركّب"
        هذا._خارجي = خارجي
        هذا._داخلي = داخلي
    نهاية

    دالة الخارجي()
        ارجع هذا._خارجي
    نهاية

    دالة الداخلي()
        ارجع هذا._داخلي
    نهاية
نهاية

# ─── مرشّح الخلفية (BackdropFilter Widget) ───
صدّر صنف مرشّح_خلفية يرث عنصر
    باني(مرشّح، ابن = لاشيء، وضع_الدمج = "مصدر_فوق")
        هذا._نوع = "مرشّح_خلفية"
        هذا._مرشّح = مرشّح
        هذا._ابن = ابن
        هذا._وضع_الدمج = وضع_الدمج
    نهاية

    دالة المرشّح()
        ارجع هذا._مرشّح
    نهاية
نهاية

# ─── مرشّح الصورة (ImageFiltered Widget) ───
صدّر صنف صورة_مُرشَّحة يرث عنصر
    باني(مرشّح، ابن)
        هذا._نوع = "صورة_مُرشَّحة"
        هذا._مرشّح = مرشّح
        هذا._ابن = ابن
    نهاية
نهاية

# ─── تمويه الخلفية الزجاجي (Glassmorphism) ───
صدّر صنف زجاج يرث عنصر
    باني(
        ابن،
        تمويه = 10،
        شفافية = 0.1،
        لون = 0xFFFFFF،
        نصف_قطر_حدود = 16،
        عرض_حدود = 1،
        لون_حدود = 0x40FFFFFF
    )
        هذا._نوع = "زجاج"
        هذا._ابن = ابن
        هذا._تمويه = تمويه
        هذا._شفافية = شفافية
        هذا._لون = لون
        هذا._نصف_قطر = نصف_قطر_حدود
        هذا._عرض_حدود = عرض_حدود
        هذا._لون_حدود = لون_حدود
    نهاية
نهاية

# ─── تمويه مع شكل (Blur with Shape) ───
صدّر صنف قناع_تمويه يرث عنصر
    باني(
        ابن،
        مرشّح_تمويه،
        شكل_قص = "مستطيل"،
        نصف_قطر = 0
    )
        هذا._نوع = "قناع_تمويه"
        هذا._ابن = ابن
        هذا._مرشّح = مرشّح_تمويه
        هذا._شكل = شكل_قص
        هذا._نصف_قطر = نصف_قطر
    نهاية
نهاية

# ─── تأثير الظل (Shadow Effect) ───
صدّر صنف تأثير_ظل
    باني(لون = 0x40000000، تمويه = 4، إزاحة_س = 0، إزاحة_ص = 2، انتشار = 0)
        هذا.لون = لون
        هذا.تمويه = تمويه
        هذا.إزاحة_س = إزاحة_س
        هذا.إزاحة_ص = إزاحة_ص
        هذا.انتشار = انتشار
    نهاية

    # تأثيرات Material Design
    ساكن دالة ارتفاع(مستوى)
        طابق (مستوى)
            عندما 1:
                ارجع جديد تأثير_ظل(0x33000000، 2، 0، 1)
            عندما 2:
                ارجع جديد تأثير_ظل(0x33000000، 4، 0، 2)
            عندما 4:
                ارجع جديد تأثير_ظل(0x33000000، 8، 0، 4)
            عندما 8:
                ارجع جديد تأثير_ظل(0x33000000، 16، 0، 8)
            عندما 16:
                ارجع جديد تأثير_ظل(0x33000000، 24، 0، 12)
            افتراضي:
                ارجع جديد تأثير_ظل()
        نهاية
    نهاية
نهاية

