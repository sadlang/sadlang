    دالة تنقيح(ذاتي) -> نص {
        أرجع ف"ع32({ذاتي})"
    }
}

نفذ قابل_للتنقيح لـ نص {
    دالة تنقيح(ذاتي) -> نص {
        أرجع ف"\"{ذاتي}\""
    }
}

نفذ قابل_للتنقيح لـ منطقي {
    دالة تنقيح(ذاتي) -> نص {
