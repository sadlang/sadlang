// ═══════════════════════════════════════════════════════════════════════════
//                    سمة قابل_للنسخ (Copy Trait)
// ═══════════════════════════════════════════════════════════════════════════
//
// الأنواع التي تنفذ هذه السمة يمكن نسخها بت-بت (bitwise copy).
// هذه السمة ضمنية للأنواع البدائية (الأرقام، المنطقيات).
//
// الاستخدام:
//   دع س: رقم = 5
//   دع ص = س    // نسخ لأن رقم ينفذ قابل_للنسخ
//
// ═══════════════════════════════════════════════════════════════════════════

سمة قابل_للنسخ {
    // هذه سمة علامة (marker trait)
    // لا تحتوي على دوال
    // يكفي أن يعلن النوع تنفيذها
}

// تنفيذ ضمني للأنواع البدائية
نفذ قابل_للنسخ لـ ع8 {}
نفذ قابل_للنسخ لـ ع16 {}
نفذ قابل_للنسخ لـ ع32 {}
نفذ قابل_للنسخ لـ ع64 {}
نفذ قابل_للنسخ لـ ح8 {}
نفذ قابل_للنسخ لـ ح16 {}
نفذ قابل_للنسخ لـ ح32 {}
نفذ قابل_للنسخ لـ ح64 {}
نفذ قابل_للنسخ لـ عش32 {}
نفذ قابل_للنسخ لـ عش64 {}
نفذ قابل_للنسخ لـ منطقي {}
نفذ قابل_للنسخ لـ حرف {}

// ═══════════════════════════════════════════════════════════════════════════
//                    سمة قابل_للاستنساخ (Clone Trait)
// ═══════════════════════════════════════════════════════════════════════════
//
// الأنواع التي تنفذ هذه السمة يمكن إنشاء نسخة عميقة منها.
// تختلف عن النسخ لأنها قد تتطلب تخصيص ذاكرة جديدة.
//
// الاستخدام:
//   دع قائمة1 = قائمة[1، 2، 3]
//   دع قائمة2 = قائمة1.استنسخ()  // نسخة عميقة
//
// ═══════════════════════════════════════════════════════════════════════════

سمة قابل_للاستنساخ {
    // دالة الاستنساخ - تنشئ نسخة عميقة
    دالة استنسخ(ذاتي) -> ذاتي
}

// تنفيذ للنص
نفذ قابل_للاستنساخ لـ نص {
    دالة استنسخ(ذاتي) -> نص {
        أرجع ذاتي  // النصوص غير قابلة للتغيير، فالنسخة هي نفسها
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//                    سمة قابل_للمقارنة (Eq Trait)
// ═══════════════════════════════════════════════════════════════════════════
//
// الأنواع التي تنفذ هذه السمة يمكن مقارنتها للمساواة.
// تُستخدم مع عامل == و !=
//
// الاستخدام:
//   إذا س == ص { ... }
//
// ═══════════════════════════════════════════════════════════════════════════

سمة قابل_للمقارنة {
    // دالة المساواة
    دالة يساوي(ذاتي، آخر: &ذاتي) -> منطقي
    
    // دالة عدم المساواة (افتراضية)
    دالة لا_يساوي(ذاتي، آخر: &ذاتي) -> منطقي {
        أرجع !ذاتي.يساوي(آخر)
    }
}

// تنفيذ للأنواع البدائية
نفذ قابل_للمقارنة لـ ع32 {
    دالة يساوي(ذاتي، آخر: &ع32) -> منطقي {
        أرجع ذاتي == *آخر
    }
}

نفذ قابل_للمقارنة لـ نص {
    دالة يساوي(ذاتي، آخر: &نص) -> منطقي {
        أرجع ذاتي == *آخر
    }
}

نفذ قابل_للمقارنة لـ منطقي {
    دالة يساوي(ذاتي، آخر: &منطقي) -> منطقي {
        أرجع ذاتي == *آخر
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//                    سمة قابل_للترتيب (Ord Trait)
// ═══════════════════════════════════════════════════════════════════════════
//
// الأنواع التي تنفذ هذه السمة يمكن ترتيبها (أصغر، أكبر).
// تُستخدم مع عوامل <، >، <=، >=
// تتطلب هذه السمة تنفيذ قابل_للمقارنة أولاً.
//
// الاستخدام:
//   إذا س < ص { ... }
//   دع الأصغر = قائمة.أصغر()
//
// ═══════════════════════════════════════════════════════════════════════════

// نتيجة المقارنة
تعداد نتيجة_مقارنة {
    أصغر،    // -1
    يساوي،   // 0
    أكبر     // 1
}

سمة قابل_للترتيب: قابل_للمقارنة {
    // دالة المقارنة الأساسية
    دالة قارن(ذاتي، آخر: &ذاتي) -> نتيجة_مقارنة
    
    // دوال مشتقة (افتراضية)
    دالة أصغر_من(ذاتي، آخر: &ذاتي) -> منطقي {
        أرجع ذاتي.قارن(آخر) == نتيجة_مقارنة::أصغر
    }
    
    دالة أكبر_من(ذاتي، آخر: &ذاتي) -> منطقي {
        أرجع ذاتي.قارن(آخر) == نتيجة_مقارنة::أكبر
    }
    
    دالة أصغر_أو_يساوي(ذاتي، آخر: &ذاتي) -> منطقي {
        أرجع ذاتي.قارن(آخر) != نتيجة_مقارنة::أكبر
    }
    
    دالة أكبر_أو_يساوي(ذاتي، آخر: &ذاتي) -> منطقي {
        أرجع ذاتي.قارن(آخر) != نتيجة_مقارنة::أصغر
    }
    
    // دوال مساعدة
    دالة الأصغر(ذاتي، آخر: ذاتي) -> ذاتي {
        إذا ذاتي.أصغر_أو_يساوي(&آخر) {
            أرجع ذاتي
        }
        أرجع آخر
    }
    
    دالة الأكبر(ذاتي، آخر: ذاتي) -> ذاتي {
        إذا ذاتي.أكبر_أو_يساوي(&آخر) {
            أرجع ذاتي
        }
        أرجع آخر
    }
}

// تنفيذ للأرقام
نفذ قابل_للترتيب لـ ع32 {
    دالة قارن(ذاتي، آخر: &ع32) -> نتيجة_مقارنة {
        إذا ذاتي < *آخر {
            أرجع نتيجة_مقارنة::أصغر
        } وإلا إذا ذاتي > *آخر {
            أرجع نتيجة_مقارنة::أكبر
        }
        أرجع نتيجة_مقارنة::يساوي
    }
}

نفذ قابل_للترتيب لـ نص {
    دالة قارن(ذاتي، آخر: &نص) -> نتيجة_مقارنة {
        إذا ذاتي < *آخر {
            أرجع نتيجة_مقارنة::أصغر
        } وإلا إذا ذاتي > *آخر {
            أرجع نتيجة_مقارنة::أكبر
        }
        أرجع نتيجة_مقارنة::يساوي
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//                    سمة قابل_للتجزئة (Hash Trait)
// ═══════════════════════════════════════════════════════════════════════════
//
// الأنواع التي تنفذ هذه السمة يمكن حساب قيمة تجزئة لها.
// ضرورية لاستخدام النوع كمفتاح في الخرائط والمجموعات.
//
// القاعدة المهمة:
//   إذا س == ص، فيجب أن س.تجزئة() == ص.تجزئة()
//
// الاستخدام:
//   دع خريطة = خريطة<مفتاحي، قيمة>{}
//
// ═══════════════════════════════════════════════════════════════════════════

سمة قابل_للتجزئة {
    // حساب قيمة التجزئة
    دالة تجزئة(ذاتي) -> ع64
}

// تنفيذ للأنواع البدائية
نفذ قابل_للتجزئة لـ ع32 {
    دالة تجزئة(ذاتي) -> ع64 {
        أرجع ذاتي بصفته ع64
    }
}

نفذ قابل_للتجزئة لـ ع64 {
    دالة تجزئة(ذاتي) -> ع64 {
        أرجع ذاتي
    }
}

نفذ قابل_للتجزئة لـ نص {
    دالة تجزئة(ذاتي) -> ع64 {
        // خوارزمية FNV-1a
        دع تجزئة: ع64 = 14695981039346656037
        لكل حرف في ذاتي {
            تجزئة = تجزئة ^ (حرف بصفته ع64)
            تجزئة = تجزئة * 1099511628211
        }
        أرجع تجزئة
    }
}

نفذ قابل_للتجزئة لـ منطقي {
    دالة تجزئة(ذاتي) -> ع64 {
        إذا ذاتي {
            أرجع 1
        }
        أرجع 0
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//                    سمة قابل_للعرض (Display Trait)
// ═══════════════════════════════════════════════════════════════════════════
//
// الأنواع التي تنفذ هذه السمة يمكن تحويلها لنص للعرض للمستخدم.
// تُستخدم مع دالة اطبع() وتنسيق النصوص.
//
// الاستخدام:
//   اطبع(قيمة)  // يستدعي قيمة.عرض()
//   دع نص = ف"القيمة: {قيمة}"
//
// ═══════════════════════════════════════════════════════════════════════════

سمة قابل_للعرض {
    // تحويل القيمة لنص للعرض
    دالة عرض(ذاتي) -> نص
}

// تنفيذ للأنواع البدائية
نفذ قابل_للعرض لـ ع32 {
    دالة عرض(ذاتي) -> نص {
        أرجع ذاتي.إلى_نص()
    }
}

نفذ قابل_للعرض لـ عش64 {
    دالة عرض(ذاتي) -> نص {
        أرجع ذاتي.إلى_نص()
    }
}

نفذ قابل_للعرض لـ منطقي {
    دالة عرض(ذاتي) -> نص {
        إذا ذاتي {
            أرجع "صحيح"
        }
        أرجع "خطأ"
    }
}

نفذ قابل_للعرض لـ نص {
    دالة عرض(ذاتي) -> نص {
        أرجع ذاتي
    }
}

// ═══════════════════════════════════════════════════════════════════════════
