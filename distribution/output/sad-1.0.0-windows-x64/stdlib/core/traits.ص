// ═══════════════════════════════════════════════════════════════════════════
//                    سمة افتراضي (Default Trait)
// ═══════════════════════════════════════════════════════════════════════════
//
// الأنواع التي تنفذ هذه السمة لها قيمة افتراضية.
// مفيدة لتهيئة المتغيرات والحقول.
//
// الاستخدام:
//   دع س: رقم = افتراضي()
//   بنية نقطة { س: رقم = افتراضي()، ص: رقم = افتراضي() }
//
// ═══════════════════════════════════════════════════════════════════════════

سمة افتراضي {
    // إرجاع القيمة الافتراضية
    دالة افتراضي() -> ذاتي
}

// تنفيذ للأنواع البدائية
نفذ افتراضي لـ ع8 { دالة افتراضي() -> ع8 { أرجع 0 } }
نفذ افتراضي لـ ع16 { دالة افتراضي() -> ع16 { أرجع 0 } }
نفذ افتراضي لـ ع32 { دالة افتراضي() -> ع32 { أرجع 0 } }
نفذ افتراضي لـ ع64 { دالة افتراضي() -> ع64 { أرجع 0 } }
نفذ افتراضي لـ ح8 { دالة افتراضي() -> ح8 { أرجع 0 } }
نفذ افتراضي لـ ح16 { دالة افتراضي() -> ح16 { أرجع 0 } }
نفذ افتراضي لـ ح32 { دالة افتراضي() -> ح32 { أرجع 0 } }
نفذ افتراضي لـ ح64 { دالة افتراضي() -> ح64 { أرجع 0 } }
نفذ افتراضي لـ عش32 { دالة افتراضي() -> عش32 { أرجع 0.0 } }
نفذ افتراضي لـ عش64 { دالة افتراضي() -> عش64 { أرجع 0.0 } }
نفذ افتراضي لـ منطقي { دالة افتراضي() -> منطقي { أرجع خطأ } }
نفذ افتراضي لـ نص { دالة افتراضي() -> نص { أرجع "" } }

// ═══════════════════════════════════════════════════════════════════════════
//                    سمة قابل_للتكرار (Iterator Trait)
// ═══════════════════════════════════════════════════════════════════════════
//
// الأنواع التي تنفذ هذه السمة يمكن التكرار عليها.
// تُستخدم مع حلقة لكل.
//
// الاستخدام:
//   لكل عنصر في قائمة { ... }
//
// ═══════════════════════════════════════════════════════════════════════════

سمة قابل_للتكرار<عنصر> {
    // الحصول على العنصر التالي
    دالة التالي(ذاتي &متغير) -> اختياري<عنصر>
}

سمة قابل_للتكرار_عليه<عنصر> {
    // نوع المكرر
    نوع مكرر: قابل_للتكرار<عنصر>
    
    // الحصول على مكرر
    دالة مكرر(ذاتي) -> مكرر
}

// ═══════════════════════════════════════════════════════════════════════════
//                    سمة قابل_للتحويل (From/Into Traits)
// ═══════════════════════════════════════════════════════════════════════════
//
// سمات للتحويل بين الأنواع.
//
// الاستخدام:
//   دع س: ع64 = ع32::من(5)
//   دع ص: ع64 = 5_ع32.إلى()
//
// ═══════════════════════════════════════════════════════════════════════════

سمة من<ت> {
    // إنشاء من نوع آخر
    دالة من(قيمة: ت) -> ذاتي
}

سمة إلى<ت> {
    // تحويل لنوع آخر
    دالة إلى(ذاتي) -> ت
}

// تنفيذ تلقائي: إذا من<أ> لـ ب، فـ إلى<ب> لـ أ
// يُنفذ تلقائياً بواسطة المترجم

// تحويلات الأرقام
نفذ من<ع8> لـ ع16 { دالة من(ق: ع8) -> ع16 { أرجع ق بصفته ع16 } }
نفذ من<ع8> لـ ع32 { دالة من(ق: ع8) -> ع32 { أرجع ق بصفته ع32 } }
نفذ من<ع8> لـ ع64 { دالة من(ق: ع8) -> ع64 { أرجع ق بصفته ع64 } }
نفذ من<ع16> لـ ع32 { دالة من(ق: ع16) -> ع32 { أرجع ق بصفته ع32 } }
نفذ من<ع16> لـ ع64 { دالة من(ق: ع16) -> ع64 { أرجع ق بصفته ع64 } }
نفذ من<ع32> لـ ع64 { دالة من(ق: ع32) -> ع64 { أرجع ق بصفته ع64 } }

// ═══════════════════════════════════════════════════════════════════════════
//                    سمة عامل_جمع (Add Operator Trait)
// ═══════════════════════════════════════════════════════════════════════════
//
// تسمح بتحميل عامل الجمع (+) للأنواع المخصصة.
//
// الاستخدام:
//   دع نتيجة = أ + ب  // يستدعي أ.اجمع(ب)
//
// ═══════════════════════════════════════════════════════════════════════════

سمة عامل_جمع<يمين = ذاتي> {
    نوع الناتج
    دالة اجمع(ذاتي، آخر: يمين) -> الناتج
}

// تنفيذ للأرقام
نفذ عامل_جمع لـ ع32 {
    نوع الناتج = ع32
    دالة اجمع(ذاتي، آخر: ع32) -> ع32 {
        أرجع ذاتي + آخر
    }
}

// جمع النصوص (دمج)
نفذ عامل_جمع لـ نص {
    نوع الناتج = نص
    دالة اجمع(ذاتي، آخر: نص) -> نص {
        أرجع ذاتي + آخر  // دمج النصوص
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//                    دوال مساعدة عامة
// ═══════════════════════════════════════════════════════════════════════════

// طباعة قيمة قابلة للعرض
دالة اطبع<ت: قابل_للعرض>(قيمة: ت) {
    اطبع_سطر(قيمة.عرض())
}

// طباعة قيمة للتنقيح
دالة نقح<ت: قابل_للتنقيح>(قيمة: ت) {
    اطبع_سطر(قيمة.تنقيح())
}

// الحصول على القيمة الافتراضية
دالة افتراضي<ت: افتراضي>() -> ت {
    أرجع ت::افتراضي()
}

// استنساخ قيمة
دالة استنسخ<ت: قابل_للاستنساخ>(قيمة: &ت) -> ت {
    أرجع قيمة.استنسخ()
}

// ═══════════════════════════════════════════════════════════════════════════
//                    نهاية الملف
// ═══════════════════════════════════════════════════════════════════════════
