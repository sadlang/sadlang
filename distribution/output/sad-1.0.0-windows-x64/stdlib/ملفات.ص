# ═══ القراءة والكتابة ═══

صدّر دالة اقرأ_ملف(مسار)
    # (AR) يقرأ محتوى ملف كنص
    ارجع read_file(مسار)
نهاية

صدّر دالة اكتب_ملف(مسار، محتوى)
    # (AR) يكتب نصاً إلى ملف
    ارجع write_file(مسار، محتوى)
نهاية

صدّر دالة أضف_لملف(مسار، محتوى)
    # (AR) يضيف نصاً إلى نهاية ملف
    ارجع append_to_file(مسار، محتوى)
نهاية

صدّر دالة اقرأ_أسطر(مسار)
    # (AR) يقرأ ملف كمصفوفة أسطر
    ارجع read_lines(مسار)
نهاية

صدّر دالة اقرأ_ثنائي(مسار)
    # (AR) يقرأ ملف كبيانات ثنائية
    ارجع read_binary(مسار)
نهاية

صدّر دالة اكتب_ثنائي(مسار، بيانات)
    # (AR) يكتب بيانات ثنائية إلى ملف
    ارجع write_binary(مسار، بيانات)
نهاية

# ═══ التحقق والمعلومات ═══

صدّر دالة موجود(مسار)
    # (AR) يتحقق إذا كان الملف/المجلد موجوداً
