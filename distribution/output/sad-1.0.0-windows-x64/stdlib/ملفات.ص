نهاية

صدّر دالة هو_ملف(مسار)
    # (AR) يتحقق إذا كان المسار ملفاً
    ارجع is_file(مسار)
نهاية

صدّر دالة هو_مجلد(مسار)
    # (AR) يتحقق إذا كان المسار مجلداً
    ارجع is_directory(مسار)
نهاية

صدّر دالة حجم_ملف(مسار)
    # (AR) يجلب حجم الملف بالبايتات
    ارجع file_size(مسار)
نهاية

صدّر دالة تاريخ_تعديل(مسار)
    # (AR) يجلب تاريخ آخر تعديل
    ارجع modification_time(مسار)
نهاية

# ═══ العمليات على الملفات ═══

صدّر دالة انسخ(مصدر، هدف)
    # (AR) ينسخ ملفاً
    ارجع copy_file(مصدر، هدف)
نهاية

صدّر دالة انقل(مصدر، هدف)
    # (AR) ينقل أو يعيد تسمية ملف
    ارجع move_file(مصدر، هدف)
نهاية

صدّر دالة احذف(مسار)
    # (AR) يحذف ملفاً
    ارجع delete_file(مسار)
نهاية

