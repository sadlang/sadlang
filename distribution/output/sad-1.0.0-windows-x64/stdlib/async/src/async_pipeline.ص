//                    أنواع التدفق المساعدة | Helper Stream Types
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * تدفق محوّل غير متزامن | Async Map Stream
 */
بنية تدفق_محوّل_غير_متزامن<مصدر، ناتج، مستقبل_ناتج> {
    مصدر_: مصدر،
    تحويل_: دالة(مصدر::عنصر) -> مستقبل_ناتج،
    _ناتج: std::marker::PhantomData<ناتج>
}

تنفيذ<مصدر، ناتج، مستقبل_ناتج> تدفق_محوّل_غير_متزامن<مصدر، ناتج، مستقبل_ناتج>
    حيث 
        مصدر: تدفق_غير_متزامن،
        مستقبل_ناتج: مستقبل<ناتج = ناتج>
{
    ثابت دالة جديد(مصدر: مصدر، تحويل: دالة(مصدر::عنصر) -> مستقبل_ناتج) -> ذاتي {
        أرجع تدفق_محوّل_غير_متزامن {
            مصدر_: مصدر،
            تحويل_: تحويل،
            _ناتج: std::marker::PhantomData
        }
    }
}

تنفيذ<مصدر، ناتج، مستقبل_ناتج> تدفق_غير_متزامن<ناتج> لـ تدفق_محوّل_غير_متزامن<مصدر، ناتج، مستقبل_ناتج>
    حيث 
        مصدر: تدفق_غير_متزامن،
        مستقبل_ناتج: مستقبل<ناتج = ناتج>
{
    غير_متزامن دالة التالي(&ذاتي) -> اختياري<ناتج> {
        طابق انتظر ذاتي.مصدر_.التالي() {
            بعض(عنصر) => بعض(انتظر (ذاتي.تحويل_)(عنصر))،
            فارغ => فارغ
        }
    }
}

/**
 * تدفق مصفي غير متزامن | Async Filter Stream
 */
بنية تدفق_مصفي_غير_متزامن<مصدر، مستقبل_منطقي> {
    مصدر_: مصدر،
    شرط_: دالة(&مصدر::عنصر) -> مستقبل_منطقي
}

تنفيذ<مصدر، مستقبل_منطقي> تدفق_مصفي_غير_متزامن<مصدر، مستقبل_منطقي>
    حيث 
        مصدر: تدفق_غير_متزامن،
        مستقبل_منطقي: مستقبل<ناتج = منطقي>
{
    ثابت دالة جديد(مصدر: مصدر، شرط: دالة(&مصدر::عنصر) -> مستقبل_منطقي) -> ذاتي {
        أرجع تدفق_مصفي_غير_متزامن {
            مصدر_: مصدر،
            شرط_: شرط
        }
    }
}

تنفيذ<مصدر، مستقبل_منطقي> تدفق_غير_متزامن<مصدر::عنصر> لـ تدفق_مصفي_غير_متزامن<مصدر، مستقبل_منطقي>
    حيث 
        مصدر: تدفق_غير_متزامن،
        مستقبل_منطقي: مستقبل<ناتج = منطقي>
{
    غير_متزامن دالة التالي(&ذاتي) -> اختياري<مصدر::عنصر> {
        حلقة {
            طابق انتظر ذاتي.مصدر_.التالي() {
                بعض(عنصر) => {
                    إذا انتظر (ذاتي.شرط_)(&عنصر) {
                        أرجع بعض(عنصر)
                    }
                }،
                فارغ => أرجع فارغ
            }
        }
    }
}

/**
 * تدفق آخذ غير متزامن | Async Take Stream
 */
بنية تدفق_آخذ_غير_متزامن<مصدر> {
    مصدر_: مصدر،
    متبقي_: عدد_طبيعي
}

تنفيذ<مصدر> تدفق_آخذ_غير_متزامن<مصدر>
    حيث مصدر: تدفق_غير_متزامن
{
    ثابت دالة جديد(مصدر: مصدر، عدد: عدد_طبيعي) -> ذاتي {
        أرجع تدفق_آخذ_غير_متزامن {
            مصدر_: مصدر،
            متبقي_: عدد
        }
    }
}

تنفيذ<مصدر> تدفق_غير_متزامن<مصدر::عنصر> لـ تدفق_آخذ_غير_متزامن<مصدر>
    حيث مصدر: تدفق_غير_متزامن
{
    غير_متزامن دالة التالي(&ذاتي) -> اختياري<مصدر::عنصر> {
        إذا ذاتي.متبقي_ == 0 {
            أرجع فارغ
        }
        ذاتي.متبقي_ -= 1
        أرجع انتظر ذاتي.مصدر_.التالي()
    }
}

