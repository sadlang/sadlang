//                    تحويل من/إلى تدفقات | Stream Conversion
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * تحويل مكرر إلى تدفق غير متزامن
 * Convert iterator to async stream
 */
دالة إلى_تدفق_غير_متزامن<مكرر، عنصر>(مكرر_: مكرر) -> تدفق_من_مكرر<مكرر>
    حيث مكرر: مكرر<عنصر>
{
    أرجع تدفق_من_مكرر::جديد(مكرر_)
}

/**
 * تدفق من مكرر | Stream from Iterator
 */
بنية تدفق_من_مكرر<مكرر> {
    مكرر_: مكرر
}

تنفيذ<مكرر> تدفق_من_مكرر<مكرر> {
    ثابت دالة جديد(مكرر_: مكرر) -> ذاتي {
        أرجع تدفق_من_مكرر { مكرر_: مكرر_ }
    }
}

تنفيذ<مكرر، عنصر> تدفق_غير_متزامن<عنصر> لـ تدفق_من_مكرر<مكرر>
    حيث مكرر: مكرر<عنصر>
{
    غير_متزامن دالة التالي(&ذاتي) -> اختياري<عنصر> {
        أرجع ذاتي.مكرر_.التالي()
    }
}

