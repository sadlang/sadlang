//                    المعالجة المتوازية | Parallel Processing
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * 🚀 حوّل_متوازي | Parallel Map
 * 
 * تحويل كل العناصر بالتوازي
 * Transform all elements in parallel
 */
غير_متزامن دالة حوّل_متوازي<عنصر، ناتج، مستقبل_ناتج>(
    عناصر: قائمة<عنصر>،
    تحويل: دالة(عنصر) -> مستقبل_ناتج
) -> قائمة<ناتج>
    حيث مستقبل_ناتج: مستقبل<ناتج = ناتج>
{
    // إنشاء كل المستقبلات
    دع مستقبلات: قائمة<مستقبل_ناتج> = عناصر
        .حوّل(|ع| تحويل(ع))
        .اجمع_قائمة()
    
    // انتظار كل المستقبلات بالتوازي
    أرجع انتظر اجمع_الكل(مستقبلات)
}

/**
 * 🚀 صفّي_متوازي | Parallel Filter
 * 
 * ترشيح بالتوازي
 * Filter in parallel
 */
غير_متزامن دالة صفّي_متوازي<عنصر، مستقبل_منطقي>(
    عناصر: قائمة<عنصر>،
    شرط: دالة(&عنصر) -> مستقبل_منطقي
) -> قائمة<عنصر>
    حيث 
        عنصر: نسخ،
        مستقبل_منطقي: مستقبل<ناتج = منطقي>
{
    // اختبار كل العناصر بالتوازي
    دع نتائج = انتظر حوّل_متوازي(
        عناصر.عدّد().اجمع_قائمة()،
        |(فهرس، عنصر)| غير_متزامن نقل {
            (فهرس، عنصر، انتظر شرط(&عنصر))
        }
    )
    
    // جمع العناصر التي نجحت
    أرجع نتائج
        .صفّي(|(_, _, نجح)| *نجح)
        .حوّل(|(_, عنصر، _)| عنصر)
        .اجمع_قائمة()
}

/**
 * 🚀 اجمع_الكل | Join All
 * 
 * انتظار كل المستقبلات وجمع النتائج
 * Await all futures and collect results
 */
غير_متزامن دالة اجمع_الكل<ناتج، مستقبل_ناتج>(
    مستقبلات: قائمة<مستقبل_ناتج>
) -> قائمة<ناتج>
    حيث مستقبل_ناتج: مستقبل<ناتج = ناتج>
{
    // تنفيذ مبسط - في الواقع نحتاج لتنفيذ حقيقي متوازي
    دع نتيجة: قائمة<ناتج> = []
    لكل مستقبل في مستقبلات {
        نتيجة.أضف(انتظر مستقبل)
    }
    أرجع نتيجة
}

/**
 * 🚀 أول_مكتمل | Race / Select First
 * 
 * انتظار أول مستقبل يكتمل
 * Await first future to complete
 */
غير_متزامن دالة أول_مكتمل<ناتج، مستقبل_ناتج>(
    مستقبلات: قائمة<مستقبل_ناتج>
) -> ناتج
    حيث مستقبل_ناتج: مستقبل<ناتج = ناتج>
{
    // يتطلب تنفيذ حقيقي مع منفذ async
    // هذا تنفيذ مبسط يأخذ الأول فقط
    إذا دع بعض(أول) = مستقبلات.أول() {
        أرجع انتظر أول
    }
    ذعر!("قائمة المستقبلات فارغة")
}

