# بسم الله الرحمن الرحيم
# ===================================================================
# مثال: نظام تشغيل يستخدم محرك الرسم الجديد
# ===================================================================
#
# هذا المثال يوضح كيفية استخدام مكتبة الرسومات في وضع freestanding
# لبناء واجهة نظام تشغيل كاملة بمحرك الرسم القابل للتبديل.
#
# الاستخدام:
#   - مع المفسر (للاختبار): sad.exe examples/مثال_نواة_رسومات.ص
#   - مع المترجم (لنظام حقيقي): sadc examples/مثال_نواة_رسومات.ص -o kernel.elf
# ===================================================================

# ─── استيراد محرك الرسم ───
استورد * من رسومات.محرك.واجهة_محرك
استورد * من رسومات.محرك.محرك_نواة
استورد * من رسومات.محرك.مدير_نوافذ
استورد * من رسومات.محرك.أحداث

# ─── استيراد Canvas API (نفس API لجميع المنصات!) ───
استورد * من رسومات.رسم.لوحة

# ===================================================================
# ثوابت النظام
# ===================================================================

ثابت عرض_شاشة = 1024
ثابت ارتفاع_شاشة = 768
ثابت اسم_النظام = "SadOS"

# ألوان
ثابت أزرق_داكن    = 1318946    # 0x001420A2
ثابت أبيض         = 16777215
ثابت أسود         = 0
ثابت أحمر         = 16711680
ثابت أخضر         = 65280
ثابت رمادي_فاتح   = 14474460

# ===================================================================
# تهيئة النظام
# ===================================================================

دالة رئيسية()

    # ١. إنشاء المحرك (للنواة: محرك_نواة، للاختبار: محرك_مدمج)
    متغير شاشة = جديد محرك_نواة()
    شاشة.تهيئة(عرض_شاشة, ارتفاع_شاشة)

    # ٢. مسح الشاشة
    شاشة.مسح(أزرق_داكن)

    # ===================================================================
    # ٣. رسم مباشر بالمحرك (منخفض المستوى)
    # ===================================================================

    # رسم إطار حول الشاشة
    شاشة.ارسم_مستطيل(5, 5, عرض_شاشة - 10, ارتفاع_شاشة - 10, أبيض)

    # رسم عنوان
    شاشة.ارسم_نص(20, 20, "SadOS - Freestanding Graphics Engine", أبيض, 3)

    # رسم أشكال هندسية
    شاشة.ارسم_مستطيل_ممتلئ(20, 80, 200, 100, أحمر)
    شاشة.ارسم_دائرة(350, 130, 50, أخضر)
    شاشة.ارسم_دائرة_ممتلئة(500, 130, 50, أبيض)
    شاشة.ارسم_مثلث(600, 180, 650, 80, 700, 180, أبيض)

    # رسم خطوط
    شاشة.ارسم_خط(20, 200, 700, 200, أبيض)

    # ===================================================================
    # ٤. استخدام Canvas API (نفس الكود يعمل على الكل!)
    # ===================================================================

    متغير لوحة = جديد لوحة_رسم(عرض_شاشة, ارتفاع_شاشة)

    # رسم على اللوحة
    متغير ف_أحمر = جديد فرشاة()
    ف_أحمر.لون = جديد لون_ر(255, 100, 100, 255)
    ف_أحمر.نمط = "ملء"

    متغير ف_حد = جديد فرشاة()
    ف_حد.لون = جديد لون_ر(255, 255, 255, 255)
    ف_حد.نمط = "حد"

    # مستطيل ممتلئ عبر Canvas
    لوحة.ارسم_مستطيل(جديد مستطيل_ر(20, 220, 300, 150), ف_أحمر)

    # دائرة حدود عبر Canvas
    لوحة.ارسم_دائرة(جديد نقطة(500, 300), 60, ف_حد)

    # نص عبر Canvas
    متغير ف_نص = جديد فرشاة()
    ف_نص.لون = جديد لون_ر(255, 255, 0, 255)
    لوحة.ارسم_نص("Canvas API works in kernel!", جديد نقطة(20, 400), ف_نص, 16)

    # تنفيذ كل عمليات اللوحة على الشاشة
    شاشة.نفّذ_لوحة(لوحة)

    # ===================================================================
    # ٥. مدير النوافذ
    # ===================================================================

    متغير مدير = جديد مدير_نوافذ(شاشة)

    # إنشاء نوافذ
    متغير ن1 = مدير.أنشئ_نافذة("Terminal", 50, 450, 350, 250)
    ن1.نشطة = صحيح

    متغير ن2 = مدير.أنشئ_نافذة("Settings", 450, 450, 300, 200)

    # رسم محتوى مخصص في النوافذ
    ن1.عند_رسم = دالة(محرك, س, ص, عرض, ارتفاع)
        محرك.ارسم_مستطيل_ممتلئ(س, ص, عرض, ارتفاع, أسود)
        محرك.ارسم_نص(س + 8, ص + 8, "> SadOS Terminal v1.0", أخضر, 1)
        محرك.ارسم_نص(س + 8, ص + 24, "> kernel loaded OK", أخضر, 1)
        محرك.ارسم_نص(س + 8, ص + 40, "> graphics engine: active", أخضر, 1)
        محرك.ارسم_نص(س + 8, ص + 56, "> _", أخضر, 1)
    نهاية

    # رسم مدير النوافذ (يرسم الخلفية + كل النوافذ)
    # ملاحظة: يمسح الشاشة — استخدمه بعد الانتهاء من الرسم المباشر
    # مدير.ارسم()

    # تبديل المخزن لإظهار كل شيء
    شاشة.تبديل()

    اطبع_سطر("✅ SadOS: محرك الرسم يعمل بنجاح!")
    اطبع_سطر("   - رسم مباشر: ✓")
    اطبع_سطر("   - Canvas API: ✓")
    اطبع_سطر("   - مدير النوافذ: ✓")
نهاية
