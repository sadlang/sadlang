# مكتبة الرياضيات للغة ص
# sad-math — Arabic Math Library

صدّر دالة جذر(عدد)
    ارجع عدد ** 0.5
نهاية

صدّر دالة قوة(أساس، أس)
    ارجع أساس ** أس
نهاية

صدّر دالة مطلق(عدد)
    إذا (عدد < 0)
        ارجع -عدد
    نهاية
    ارجع عدد
نهاية

صدّر دالة متوسط(أرقام)
    متغير مجموع = 0
    لكل رقم في أرقام
        مجموع += رقم
    نهاية
    ارجع مجموع / أرقام.طول()
نهاية

صدّر دالة مساحة_دائرة(نصف_القطر)
    ارجع 3.14159265358979 * نصف_القطر ** 2
نهاية

صدّر دالة محيط_دائرة(نصف_القطر)
    ارجع 2 * 3.14159265358979 * نصف_القطر
نهاية

صدّر دالة مساحة_مثلث(قاعدة، ارتفاع)
    ارجع 0.5 * قاعدة * ارتفاع
نهاية

