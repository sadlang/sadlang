# === الخطوة 1: مرحباً بالعالم ===
اطبع_سطر("مرحباً بالعالم! 🌍")
اطبع_سطر("هذا أول برنامج لي بلغة ص")

# === الخطوة 2: المتغيرات ===
# متغير = قيمة قابلة للتغيير
# ثابت = قيمة لا تتغير
متغير اسمي = "المبرمج العربي"
متغير عمري = 20
ثابت لغتي = "ص"

اطبع_سطر("")
اطبع_سطر("اسمي: " + اسمي)
اطبع_سطر("عمري: " + عمري)
اطبع_سطر("لغتي المفضلة: " + لغتي)

# === الخطوة 3: العمليات الحسابية ===
اطبع_سطر("")
اطبع_سطر("=== العمليات الحسابية ===")

متغير أ = 15
متغير ب = 4

اطبع_سطر("أ = " + أ + ", ب = " + ب)
اطبع_سطر("الجمع: " + (أ + ب))
اطبع_سطر("الطرح: " + (أ - ب))
اطبع_سطر("الضرب: " + (أ * ب))
اطبع_سطر("القسمة: " + (أ / ب))
اطبع_سطر("الباقي: " + (أ % ب))

# === الخطوة 4: الشروط ===
اطبع_سطر("")
اطبع_سطر("=== الشروط ===")

متغير درجة = 85

إذا (درجة >= 90)
    اطبع_سطر("ممتاز! 🌟")
وإلا
    إذا (درجة >= 80)
        اطبع_سطر("جيد جداً! 👏")
    وإلا
        إذا (درجة >= 70)
            اطبع_سطر("جيد 👍")
        وإلا
            اطبع_سطر("يحتاج تحسين 📚")
        نهاية
    نهاية
نهاية

# === الخطوة 5: الحلقات ===
اطبع_سطر("")
اطبع_سطر("=== الحلقات ===")

# حلقة لكل
اطبع_سطر("الأيام:")
متغير أيام = ["السبت"، "الأحد"، "الاثنين"، "الثلاثاء"، "الأربعاء"]
لكل يوم في أيام
    اطبع_سطر("  📅 " + يوم)
نهاية

# حلقة بينما
اطبع_سطر("")
اطبع_سطر("العد التنازلي:")
متغير عداد = 5
بينما (عداد > 0)
    اطبع_سطر("  " + عداد + "...")
    عداد = عداد - 1
نهاية
اطبع_سطر("  🚀 انطلاق!")

# === الخطوة 6: الدوال ===
اطبع_سطر("")
اطبع_سطر("=== الدوال ===")

# دالة بسيطة
دالة رحّب(اسم)
    اطبع_سطر("مرحباً يا " + اسم + "! 👋")
نهاية

# دالة تُرجع قيمة
دالة مساحة_المستطيل(طول، عرض)
    ارجع طول * عرض
نهاية

# دالة تتحقق من شيء
دالة هل_زوجي(رقم)
    ارجع رقم % 2 == 0
نهاية

رحّب("سارة")
رحّب("أحمد")

متغير م = مساحة_المستطيل(5، 3)
اطبع_سطر("مساحة مستطيل 5×3 = " + م)

اطبع_سطر("هل 4 زوجي؟ " + هل_زوجي(4))
اطبع_سطر("هل 7 زوجي؟ " + هل_زوجي(7))

# === الخطوة 7: المصفوفات (القوائم) ===
اطبع_سطر("")
اطبع_سطر("=== المصفوفات ===")

متغير فواكه = ["تفاح"، "موز"، "برتقال"، "عنب"، "مانجو"]

اطبع_سطر("عدد الفواكه: " + فواكه.طول())
اطبع_سطر("أول فاكهة: " + فواكه[0])
