# === الجزء 2: الدوال الرياضية ===

## القيمة المطلقة
دالة مطلقة(س)
    إذا (س < 0)
        ارجع -س
    نهاية
    ارجع س
نهاية

## الأس (قوة)
دالة قوة(قاعدة، أس)
    إذا (أس == 0)
        ارجع 1
    نهاية
    متغير نتيجة = 1
    متغير ع = مطلقة(أس)
    متغير ت = 0
    بينما (ت < ع)
        نتيجة = نتيجة * قاعدة
        ت = ت + 1
    نهاية
    إذا (أس < 0)
        ارجع 1 / نتيجة
    نهاية
    ارجع نتيجة
نهاية

## العاملي (Factorial)
دالة عاملي(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    متغير نتيجة = 1
    متغير ت = 2
    بينما (ت <= ن)
        نتيجة = نتيجة * ت
        ت = ت + 1
    نهاية
    ارجع نتيجة
نهاية

## القاسم المشترك الأكبر (GCD)
دالة قمأ(أ، ب)
    متغير س = مطلقة(أ)
    متغير ص = مطلقة(ب)
    بينما (ص != 0)
        متغير باقي = س % ص
        س = ص
        ص = باقي
    نهاية
    ارجع س
نهاية

## المضاعف المشترك الأصغر (LCM)
دالة ممأ(أ، ب)
    ارجع مطلقة(أ * ب) / قمأ(أ، ب)
نهاية

## محيط الدائرة
دالة محيط_دائرة(نصف_القطر)
    ارجع 2 * باي * نصف_القطر
نهاية

## مساحة الدائرة
دالة مساحة_دائرة(نصف_القطر)
    ارجع باي * نصف_القطر * نصف_القطر
نهاية

# === الجزء 3: عمليات القوائم الإحصائية ===

## المجموع
دالة مجموع(قائمة)
    متغير م = 0
    لكل عنصر في قائمة
        م = م + عنصر
    نهاية
    ارجع م
نهاية

## الطول
دالة عدد_العناصر(قائمة)
    متغير ع = 0
    لكل عنصر في قائمة
        ع = ع + 1
    نهاية
    ارجع ع
نهاية

## المتوسط الحسابي
دالة متوسط(قائمة)
    ارجع مجموع(قائمة) / عدد_العناصر(قائمة)
نهاية

## أكبر قيمة
دالة أقصى(قائمة)
    متغير الأقصى = قائمة[0]
    لكل عنصر في قائمة
        إذا (عنصر > الأقصى)
            الأقصى = عنصر
        نهاية
    نهاية
    ارجع الأقصى
نهاية

## أصغر قيمة
دالة أدنى(قائمة)
    متغير الأدنى = قائمة[0]
    لكل عنصر في قائمة
        إذا (عنصر < الأدنى)
            الأدنى = عنصر
        نهاية
    نهاية
    ارجع الأدنى
نهاية

## المدى
دالة المدى(قائمة)
    ارجع أقصى(قائمة) - أدنى(قائمة)
نهاية

# === الجزء 4: أدوات التحويل ===

## سيلسيوس إلى فهرنهايت
دالة حوّل_سف(سيلسيوس)
    ارجع (سيلسيوس * 9 / 5) + 32
نهاية

## فهرنهايت إلى سيلسيوس
دالة حوّل_فس(فهرنهايت)
    ارجع (فهرنهايت - 32) * 5 / 9
نهاية

## كيلومتر إلى ميل
دالة كم_إلى_ميل(كم)
    ارجع كم * 0.621371
نهاية

## راديان إلى درجات
دالة راديان_إلى_درجة(راديان)
    ارجع راديان * 180 / باي
نهاية

# === الجزء 5: كتابة الاختبارات ===

متغير نجحت = 0
متغير فشلت = 0

دالة تأكد(اسم_الاختبار، فعلي، متوقع)
    إذا (فعلي == متوقع)
        اطبع_سطر("  ✅ " + اسم_الاختبار)
        نجحت = نجحت + 1
    وإلا
        اطبع_سطر("  ❌ " + اسم_الاختبار + " — متوقع: " + متوقع + " فعلي: " + فعلي)
        فشلت = فشلت + 1
    نهاية
نهاية

