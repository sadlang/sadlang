# ── إذا / وإلا ──
اطبع_سطر("── الشروط الأساسية ──")

متغير الدرجة = 85

إذا (الدرجة >= 90)
    اطبع_سطر("ممتاز! 🌟")
وإلا
    إذا (الدرجة >= 80)
        اطبع_سطر("جيد جداً 👍")
    وإلا
        إذا (الدرجة >= 70)
            اطبع_سطر("جيد")
        وإلا
            اطبع_سطر("يحتاج تحسين")
        نهاية
    نهاية
نهاية

# ── شروط متعددة ──
اطبع_سطر("── شروط متعددة ──")

متغير العمر = 20
متغير لديه_رخصة = صحيح

إذا (العمر >= 18 و لديه_رخصة)
    اطبع_سطر("يمكنه القيادة ✅")
وإلا
    اطبع_سطر("لا يمكنه القيادة ❌")
نهاية

# ── مثال عملي: تصنيف الأعداد ──
اطبع_سطر("── تصنيف الأعداد ──")

متغير رقم = -5

إذا (رقم > 0)
    اطبع_سطر(لنص(رقم) + " عدد موجب")
وإلا
    إذا (رقم < 0)
        اطبع_سطر(لنص(رقم) + " عدد سالب")
    وإلا
        اطبع_سطر("العدد صفر")
    نهاية
نهاية

# ── مثال: زوجي أم فردي ──
متغير ع = 7
إذا (ع % 2 == 0)
    اطبع_سطر(لنص(ع) + " زوجي")
وإلا
    اطبع_سطر(لنص(ع) + " فردي")
نهاية

