# الدرس 9: البرمجة الكائنية (الأصناف)
# Tutorial 9: Object-Oriented Programming
# المستوى: متقدم
# ═══════════════════════════════════════════════════════════════════
# في هذا الدرس ستتعلم:
#   - تعريف الأصناف (صنف)
#   - الباني (constructor)
#   - الخصائص والدوال
#   - الوراثة (يرث)
# ═══════════════════════════════════════════════════════════════════

# ── صنف بسيط ──
اطبع_سطر("── صنف نقطة ──")

صنف نقطة
    باني(س_جديد، ص_جديد)
        هذا.س = س_جديد
        هذا.ص = ص_جديد
    نهاية

    دالة وصف()
        ارجع "(" + لنص(هذا.س) + "، " + لنص(هذا.ص) + ")"
    نهاية

    دالة مسافة_من_الأصل()
        ارجع جذر(هذا.س * هذا.س + هذا.ص * هذا.ص)
    نهاية
نهاية

متغير ن1 = جديد نقطة(3، 4)
اطبع_سطر("النقطة: " + ن1.وصف())
اطبع_سطر("المسافة من الأصل: " + لنص(ن1.مسافة_من_الأصل()))

# ── صنف حساب بنكي ──
اطبع_سطر("── صنف حساب بنكي ──")

صنف حساب
    باني(صاحب_الحساب، رصيد_ابتدائي)
        هذا.الصاحب = صاحب_الحساب
        هذا.الرصيد = رصيد_ابتدائي
    نهاية

    دالة إيداع(مبلغ_إيداع)
        هذا.الرصيد = هذا.الرصيد + مبلغ_إيداع
        اطبع_سطر("  ✅ إيداع " + لنص(مبلغ_إيداع) + " ريال")
    نهاية

    دالة سحب(مبلغ_سحب)
        إذا (مبلغ_سحب > هذا.الرصيد)
            اطبع_سطر("  ❌ الرصيد غير كافي!")
            ارجع خطأ
        نهاية
        هذا.الرصيد = هذا.الرصيد - مبلغ_سحب
        اطبع_سطر("  ✅ سحب " + لنص(مبلغ_سحب) + " ريال")
        ارجع صحيح
    نهاية

    دالة عرض_الرصيد()
        اطبع_سطر("  💰 رصيد " + هذا.الصاحب + ": " + لنص(هذا.الرصيد) + " ريال")
    نهاية
نهاية

متغير حسابي = جديد حساب("أحمد"، 1000)
حسابي.عرض_الرصيد()
حسابي.إيداع(500)
حسابي.سحب(200)
حسابي.سحب(2000)
حسابي.عرض_الرصيد()

# ── الوراثة ──
اطبع_سطر("── الوراثة ──")

صنف شكل
    باني(اسم_الشكل)
        هذا.الاسم = اسم_الشكل
    نهاية

    دالة وصف()
        ارجع "شكل: " + هذا.الاسم
    نهاية
نهاية

صنف مستطيل يرث شكل
    باني(قيمة_طول، قيمة_عرض)
        الأساس.باني("مستطيل")
        هذا.الطول = قيمة_طول
        هذا.العرض = قيمة_عرض
    نهاية

    دالة المساحة()
        ارجع هذا.الطول * هذا.العرض
    نهاية

    دالة المحيط()
        ارجع 2 * (هذا.الطول + هذا.العرض)
    نهاية
نهاية

متغير م = جديد مستطيل(8، 5)
اطبع_سطر(م.وصف())
اطبع_سطر("المساحة: " + لنص(م.المساحة()))
اطبع_سطر("المحيط: " + لنص(م.المحيط()))

# ═══════════════════════════════════════════════════════════════════
# 📌 ملخص:
#   - صنف اسم ... نهاية → تعريف صنف
#   - باني(وسائط) ... نهاية → المُنشئ
#   - هذا.خاصية → الوصول لخصائص الكائن
#   - جديد صنف(وسائط) → إنشاء كائن جديد
#   - صنف ابن يرث أب → الوراثة
#   - الأساس.باني() → استدعاء باني الأب
# ═══════════════════════════════════════════════════════════════════
