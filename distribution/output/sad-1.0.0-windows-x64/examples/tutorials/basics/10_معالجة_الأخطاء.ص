# ═══════════════════════════════════════════════════════════════════
# الدرس 10: معالجة الأخطاء
# Tutorial 10: Error Handling
# المستوى: متقدم
# ═══════════════════════════════════════════════════════════════════
# في هذا الدرس ستتعلم:
#   - حاول / امسك (try / catch)
#   - رمي الأخطاء (ارمي)
#   - كتلة أخيراً (finally)
#   - أنماط معالجة الأخطاء
# ═══════════════════════════════════════════════════════════════════

# ── حاول / امسك أساسي ──
اطبع_سطر("── معالجة الأخطاء الأساسية ──")

حاول
    اطبع_سطر("محاولة تنفيذ كود...")
    ارمي "حدث خطأ ما!"
    اطبع_سطر("هذا السطر لن يُنفذ")
امسك (الخطأ)
    اطبع_سطر("⚠️ تم مسك الخطأ: " + الخطأ)
نهاية
اطبع_سطر("البرنامج يستمر بشكل طبيعي ✅")

# ── كود بدون خطأ ──
اطبع_سطر("── كود بدون خطأ ──")

حاول
    متغير نتيجة = 10 + 20
    اطبع_سطر("النتيجة: " + لنص(نتيجة))
امسك (الخطأ)
    اطبع_سطر("هذا لن يُنفذ")
نهاية

# ── دالة تحمي من الأخطاء ──
اطبع_سطر("── دالة آمنة ──")

دالة قسمة(أ، ب)
    إذا (ب == 0)
        ارمي "خطأ: القسمة على صفر!"
    نهاية
    ارجع أ / ب
نهاية

# استخدام عادي
اطبع_سطر("10 ÷ 3 = " + لنص(قسمة(10، 3)))

# استخدام مع خطأ
حاول
    متغير ن = قسمة(10، 0)
امسك (الخطأ)
    اطبع_سطر("⚠️ " + الخطأ)
نهاية

# ── كتلة أخيراً ──
اطبع_سطر("── كتلة أخيراً ──")

حاول
    اطبع_سطر("فتح مورد...")
    ارمي "خطأ في المعالجة"
امسك (الخطأ)
    اطبع_سطر("⚠️ " + الخطأ)
أخيراً
    اطبع_سطر("🔒 إغلاق المورد (يُنفذ دائماً)")
نهاية

# ── مثال عملي: التحقق من المدخلات ──
اطبع_سطر("── التحقق من المدخلات ──")

دالة تحقق_العمر(قيمة_العمر)
    إذا (قيمة_العمر < 0)
        ارمي "العمر لا يمكن أن يكون سالباً"
    نهاية
    إذا (قيمة_العمر > 150)
        ارمي "العمر غير واقعي"
    نهاية
    ارجع "العمر " + لنص(قيمة_العمر) + " صحيح ✅"
نهاية

# اختبار حالات مختلفة
متغير أعمار = [25، -5، 200، 80]
لكل ع في أعمار
    حاول
        اطبع_سطر(تحقق_العمر(ع))
    امسك (الخطأ)
        اطبع_سطر("❌ العمر " + لنص(ع) + ": " + الخطأ)
    نهاية
نهاية

اطبع_سطر("── انتهى الدرس ──")

# ═══════════════════════════════════════════════════════════════════
# 📌 ملخص:
#   - حاول ... امسك (الخطأ) ... نهاية → معالجة الأخطاء
#   - ارمي "رسالة" → رمي خطأ
#   - أخيراً → كود يُنفذ دائماً (مع أو بدون خطأ)
#   - استخدم حاول/امسك حول الكود الذي قد يخطئ
#   - استخدم ارمي للتحقق من صحة المدخلات
# ═══════════════════════════════════════════════════════════════════
