# مصنع دوال التصنيف (Closure)
دالة صانع_مصنف(رقم حد)
    ارجع لامدا طالب: طالب.المعدل() >= حد
نهاية

# مصنع دوال (اغلاق)
دالة صانع_جمع(ن)
    ارجع لامدا س: س + ن
نهاية

# تحليل درجات طالب
دالة حلل_درجات(طالب)
    متغير م = طالب.الدرجات
    إذا (م.الحجم() == 0)
        ارجع {"الحالة": "لا توجد درجات"}
    نهاية

    متغير القيم = م.القيم()
    متغير أعلى = القيم[0]
    متغير أدنى = القيم[0]

    لكل د في القيم
        إذا (د > أعلى)
            أعلى = د
        نهاية
        إذا (د < أدنى)
            أدنى = د
        نهاية
    نهاية

    متغير حالة_ط = "راسب"
    إذا (طالب.هل_ناجح())
        حالة_ط = "ناجح"
    نهاية

    ارجع {
        "الحالة": حالة_ط،
        "المعدل": طالب.المعدل()،
        "التقدير": طالب.التقدير()،
        "أعلى_درجة": أعلى،
        "أدنى_درجة": أدنى،
        "المدى": أعلى - أدنى،
        "عدد_المواد": م.الحجم()
    }
نهاية

