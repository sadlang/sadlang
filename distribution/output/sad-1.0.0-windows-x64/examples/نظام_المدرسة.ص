# ---- استثناءات مخصصة ----

صنف خطأ_التسجيل
    باني(الرسالة)
        هذا.رسالة = الرسالة
    نهاية
نهاية

صنف خطأ_الدرجات
    باني(الرسالة، الدرجة)
        هذا.رسالة = الرسالة
        هذا.الدرجة = الدرجة
    نهاية
نهاية

# ---- الصنف الأساسي: شخص ----

صنف شخص
    باني(نص اسم، رقم عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية

    دالة تعريف()
        ارجع "الاسم: " + هذا.الاسم + " - العمر: " + هذا.العمر
    نهاية

    دالة هل_بالغ()
        ارجع هذا.العمر >= 18
    نهاية
نهاية

# ---- صنف طالب يرث شخص ----

صنف طالب يرث شخص
    باني(نص اسم، رقم عمر، رقم معرف، نص مرحلة)
        الأساس(اسم، عمر)
        هذا.المعرف = معرف
        هذا.المرحلة = مرحلة
        هذا.الدرجات = {}
        هذا.الملاحظات = []
    نهاية

    # تعدد الأشكال - إعادة تعريف الدالة
    دالة تعريف()
        ارجع "طالب [" + هذا.المعرف + "] " + هذا.الاسم + " - " + هذا.المرحلة
    نهاية

    دالة أضف_درجة(نص المادة، رقم الدرجة)
        إذا (الدرجة < 0 أو الدرجة > 100)
            ارمي جديد خطأ_الدرجات("درجة غير صالحة"، الدرجة)
        نهاية
        هذا.الدرجات[المادة] = الدرجة
    نهاية

    دالة المعدل()
        متغير القيم = هذا.الدرجات.القيم()
        إذا (القيم.الطول() == 0)
            ارجع 0
        نهاية
        متغير مجموع = 0
        لكل درجة في القيم
            مجموع = مجموع + درجة
        نهاية
        ارجع مجموع / القيم.الطول()
    نهاية

    دالة التقدير()
        متغير م = هذا.المعدل()
        إذا (م >= 90)
            ارجع "ممتاز"
        وإلا
            إذا (م >= 80)
                ارجع "جيد جدا"
            وإلا
                إذا (م >= 70)
                    ارجع "جيد"
                وإلا
                    إذا (م >= 60)
                        ارجع "مقبول"
                    وإلا
                        إذا (م >= 50)
                            ارجع "ضعيف"
                        وإلا
                            ارجع "راسب"
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية

    دالة هل_ناجح()
        ارجع هذا.المعدل() >= درجة_النجاح
    نهاية

    دالة أضف_ملاحظة(نص ملاحظة)
        أضف(هذا.الملاحظات، ملاحظة)
    نهاية
نهاية

# ---- صنف معلم يرث شخص ----

صنف معلم يرث شخص
    باني(نص اسم، رقم عمر، نص تخصص، رقم خبرة)
        الأساس(اسم، عمر)
        هذا.التخصص = تخصص
        هذا.سنوات_الخبرة = خبرة
        هذا.الطلاب_المسجلون = []
    نهاية

    دالة تعريف()
        ارجع "أ. " + هذا.الاسم + " - " + هذا.التخصص + " (" + هذا.سنوات_الخبرة + " سنة)"
    نهاية

    دالة سجل_طالب(طالب)
        أضف(هذا.الطلاب_المسجلون، طالب)
    نهاية

    دالة عدد_طلابه()
        ارجع طول(هذا.الطلاب_المسجلون)
    نهاية

    دالة الرتبة()
        إذا (هذا.سنوات_الخبرة >= 20)
            ارجع "خبير"
        وإلا
            إذا (هذا.سنوات_الخبرة >= 10)
                ارجع "متقدم"
            وإلا
                إذا (هذا.سنوات_الخبرة >= 5)
                    ارجع "متوسط"
                وإلا
                    ارجع "مبتدئ"
                نهاية
            نهاية
        نهاية
    نهاية
نهاية

# ---- صنف متجه_درجات: تحميل العوامل الزائد ----

صنف متجه_درجات
    باني(الدرجات)
        هذا.الدرجات = الدرجات
    نهاية

    عامل +(آخر)
        متغير نتيجة = []
        متغير ع = 0
        بينما (ع < طول(هذا.الدرجات))
            أضف(نتيجة، هذا.الدرجات[ع] + آخر.الدرجات[ع])
            ع = ع + 1
        نهاية
        ارجع جديد متجه_درجات(نتيجة)
    نهاية

    عامل ==(آخر)
        إذا (طول(هذا.الدرجات) != طول(آخر.الدرجات))
            ارجع خطأ
        نهاية
        متغير ع = 0
        بينما (ع < طول(هذا.الدرجات))
            إذا (هذا.الدرجات[ع] != آخر.الدرجات[ع])
                ارجع خطأ
            نهاية
            ع = ع + 1
        نهاية
        ارجع صحيح
    نهاية

    دالة اعرض()
        ارجع لنص(هذا.الدرجات)
    نهاية
نهاية

# ---- صنف المدرسة ----

صنف مدرسة
    باني(نص الاسم)
        هذا.الاسم = الاسم
        هذا.الطلاب = []
        هذا.المعلمون = []
        هذا.السجل = []
    نهاية

    دالة سجل_طالب(طالب)
        إذا (طول(هذا.الطلاب) >= الحد_الأقصى_للطلاب)
            ارمي جديد خطأ_التسجيل("تجاوز الحد الاقصى للطلاب!")
        نهاية

        لكل ط في هذا.الطلاب
            إذا (ط.المعرف == طالب.المعرف)
                ارمي جديد خطأ_التسجيل("المعرف " + طالب.المعرف + " مسجل مسبقا")
            نهاية
        نهاية

        أضف(هذا.الطلاب، طالب)
        أضف(هذا.السجل، "تسجيل: " + طالب.الاسم)
    نهاية

    دالة أضف_معلم(معلم)
        أضف(هذا.المعلمون، معلم)
        أضف(هذا.السجل، "معلم: " + معلم.الاسم)
    نهاية

    دالة ابحث_طالب(رقم المعرف)
        لكل ط في هذا.الطلاب
            إذا (ط.المعرف == المعرف)
                ارجع ط
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    دالة الطلاب_الناجحون()
        متغير نتيجة = []
        لكل ط في هذا.الطلاب
            إذا (ط.هل_ناجح())
                أضف(نتيجة، ط)
            نهاية
        نهاية
        ارجع نتيجة
    نهاية

    دالة الطلاب_الراسبون()
        متغير نتيجة = []
        لكل ط في هذا.الطلاب
            إذا (ليس ط.هل_ناجح())
                أضف(نتيجة، ط)
            نهاية
        نهاية
        ارجع نتيجة
    نهاية

    دالة أسماء_الطلاب()
        متغير نتيجة = []
        لكل ط في هذا.الطلاب
            أضف(نتيجة، ط.الاسم)
        نهاية
        ارجع نتيجة
    نهاية

    دالة المعدل_العام()
        إذا (طول(هذا.الطلاب) == 0)
            ارجع 0
        نهاية
        متغير مجموع = 0
        لكل ط في هذا.الطلاب
            مجموع = مجموع + ط.المعدل()
        نهاية
        ارجع مجموع / طول(هذا.الطلاب)
    نهاية

    دالة اطبع_تقرير()
        اطبع_سطر("================================")
        اطبع_سطر("  تقرير: " + هذا.الاسم)
        اطبع_سطر("================================")

        متغير ناجحون = طول(هذا.الطلاب_الناجحون())
        متغير راسبون = طول(هذا.الطلاب_الراسبون())
        متغير الكل = طول(هذا.الطلاب)
        متغير نسبة = 0
        إذا (الكل > 0)
            نسبة = ناجحون * 100 / الكل
        نهاية

        اطبع_سطر("  اجمالي الطلاب: " + الكل)
        اطبع_سطر("  الناجحون: " + ناجحون)
        اطبع_سطر("  الراسبون: " + راسبون)
        اطبع_سطر("  نسبة النجاح: " + نسبة + "%")
        اطبع_سطر("  المعدل العام: " + هذا.المعدل_العام())
        اطبع_سطر("  المعلمون: " + طول(هذا.المعلمون))
        اطبع_سطر("================================")
    نهاية
نهاية

