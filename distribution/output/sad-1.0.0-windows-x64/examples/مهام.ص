# ===================================================================
# مثال تطبيقي شامل — يعرض كل أنظمة واجهة ص
# ===================================================================
# تطبيق مهام مع سمات وتنقل وحالة وتحقق
# ===================================================================

من واجهات استورد *

# ─── إعداد السمة ───
متغير سمة = السمة()

# ─── إعداد الحالة ───
حالة().وفّر("المهام", [])
حالة().وفّر("العداد", 0)

# ─── إعداد التوجيه ───
متغير موجه = الموجّه()
موجه.سجّل(جديد مسار("الرئيسية", "/", لامدا() => صفحة_المهام()))
موجه.سجّل(جديد مسار("إضافة", "/إضافة", لامدا() => صفحة_إضافة()))
موجه.سجّل(جديد مسار("الإعدادات", "/إعدادات", لامدا() => صفحة_إعدادات()))

# ─── نموذج إضافة مهمة ───
دالة نموذج_مهمة()
    متغير م = جديد نموذج()
    م.أضف_حقل(جديد حقل_نموذج("العنوان").أضف_محقق(مطلوب(لاشيء)).أضف_محقق(حد_أدنى_طول(3, لاشيء)))
    م.أضف_حقل(جديد حقل_نموذج("الوصف"))
    ارجع م
نهاية

# ─── صفحة المهام ───
دالة صفحة_المهام()
    متغير مهام = حالة().احصل("المهام")

    ارجع جديد صفحة(
        جديد عمود([
            جديد شريط_تطبيق("مهامي", أيقونة_يمين: "⚙️", عند_يمين: لامدا()
                موجه.اذهب("/إعدادات")
            نهاية),
            جديد نص("عدد المهام: " + طول(مهام), حجم_الخط: 18, لون: سمة.ألوان.أساسي),
            جديد فاصل(),
            جديد زر("➕ إضافة مهمة", لون_خلفية: سمة.ألوان.أساسي, لون_نص: سمة.ألوان.على_أساسي, عند_الضغط: لامدا()
                موجه.اذهب("/إضافة")
            نهاية)
        ])
    )
نهاية

# ─── صفحة الإضافة ───
دالة صفحة_إضافة()
    متغير م = نموذج_مهمة()

    ارجع جديد صفحة(
        جديد عمود([
            جديد شريط_تطبيق("إضافة مهمة"),
            جديد حقل_إدخال(تلميح: "عنوان المهمة", عند_تغيير: لامدا(ق)
                م.حقل("العنوان").عيّن_قيمة(ق)
            نهاية),
            جديد حقل_إدخال(تلميح: "وصف المهمة", عند_تغيير: لامدا(ق)
                م.حقل("الوصف").عيّن_قيمة(ق)
            نهاية),
            جديد زر("حفظ", لون_خلفية: "#4CAF50", عند_الضغط: لامدا()
                إذا (م.تحقق())
                    متغير مهام = حالة().احصل("المهام")
                    مهام.أضف({"عنوان": م.حقل("العنوان").القيمة, "وصف": م.حقل("الوصف").القيمة})
                    حالة().وفّر("المهام", مهام)
                    موجه.رجوع()
                نهاية
            نهاية),
            جديد زر("إلغاء", عند_الضغط: لامدا()
                موجه.رجوع()
            نهاية)
        ])
    )
نهاية

# ─── صفحة الإعدادات ───
دالة صفحة_إعدادات()
    ارجع جديد صفحة(
        جديد عمود([
            جديد شريط_تطبيق("الإعدادات"),
            جديد عنصر_قائمة("تبديل السمة", عنوان_فرعي: "داكن/فاتح", عند_الضغط: لامدا()
                بدّل_سمة()
            نهاية),
            جديد زر("رجوع", عند_الضغط: لامدا()
                موجه.رجوع()
            نهاية)
        ])
    )
نهاية

# ─── نقطة الدخول ───
شغّل(صفحة_المهام())
