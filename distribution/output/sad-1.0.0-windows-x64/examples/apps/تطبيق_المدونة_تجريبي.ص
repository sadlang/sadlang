دالة إحصائيات()
    متغير مجموع_تعليقات = 0
    متغير مجموع_إعجابات = 0
    لكل مقال في مقالات
        مجموع_إعجابات = مجموع_إعجابات + مقال["إعجابات"]
        # عد التعليقات يدوياً
        لكل ت في مقال["تعليقات"]
            مجموع_تعليقات = مجموع_تعليقات + 1
        نهاية
    نهاية
    
    اطبع_سطر("")
    اطبع_سطر("=== إحصائيات المدونة ===")
    اطبع_سطر("عدد المقالات: " + عداد_مقالات)
    اطبع_سطر("مجموع الإعجابات: " + مجموع_إعجابات)
    اطبع_سطر("مجموع التعليقات: " + مجموع_تعليقات)
