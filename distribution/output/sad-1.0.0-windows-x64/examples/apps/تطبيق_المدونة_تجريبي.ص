# قاعدة بيانات المدونة
متغير مقالات = []
متغير عداد_مقالات = 0

# إنشاء مقال جديد
دالة أنشئ_مقال(عنوان، محتوى، كاتب، وسوم)
    عداد_مقالات = عداد_مقالات + 1
    متغير مقال = {
        "رقم": عداد_مقالات,
        "عنوان": عنوان,
        "محتوى": محتوى,
        "كاتب": كاتب,
        "وسوم": وسوم,
        "تعليقات": [],
        "إعجابات": 0
    }
    مقالات = مقالات + [مقال]
    اطبع_سطر("✓ نُشر مقال: " + عنوان)
    ارجع مقال
نهاية

# إضافة تعليق
دالة أضف_تعليق(رقم_مقال، اسم_المعلق، نص_التعليق)
    لكل مقال في مقالات
        إذا (مقال["رقم"] == رقم_مقال)
            متغير تعليق = {"اسم": اسم_المعلق، "نص": نص_التعليق}
            مقال["تعليقات"] = مقال["تعليقات"] + [تعليق]
            اطبع_سطر("  💬 تعليق من " + اسم_المعلق + " على: " + مقال["عنوان"])
            ارجع صحيح
        نهاية
    نهاية
    ارجع خطأ
نهاية

# إعجاب بمقال
دالة أعجبني(رقم_مقال)
    لكل مقال في مقالات
        إذا (مقال["رقم"] == رقم_مقال)
            مقال["إعجابات"] = مقال["إعجابات"] + 1
            ارجع مقال["إعجابات"]
        نهاية
    نهاية
    ارجع 0
نهاية

# عرض مقال كامل
دالة اعرض_مقال(مقال)
    اطبع_سطر("")
    اطبع_سطر("╔════════════════════════════════╗")
    اطبع_سطر("  📝 " + مقال["عنوان"])
    اطبع_سطر("  ✍️ بقلم: " + مقال["كاتب"])
    اطبع_سطر("╚════════════════════════════════╝")
    اطبع_سطر(مقال["محتوى"])
    اطبع_سطر("")
    اطبع_سطر("  🏷️ الوسوم: " + مقال["وسوم"])
    اطبع_سطر("  ❤️ إعجابات: " + مقال["إعجابات"])
    
    إذا (مقال["تعليقات"] != [])
        اطبع_سطر("  💬 التعليقات:")
        لكل تعليق في مقال["تعليقات"]
            اطبع_سطر("    • " + تعليق["اسم"] + ": " + تعليق["نص"])
        نهاية
    نهاية
نهاية

# عرض قائمة المقالات
دالة اعرض_القائمة()
    اطبع_سطر("")
    اطبع_سطر("=== آخر المقالات ===")
    لكل مقال في مقالات
        اطبع_سطر("  #" + مقال["رقم"] + " " + مقال["عنوان"] + " — " + مقال["كاتب"] + " (❤️ " + مقال["إعجابات"] + ")")
    نهاية
