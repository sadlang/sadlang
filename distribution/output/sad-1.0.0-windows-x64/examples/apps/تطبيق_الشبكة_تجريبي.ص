# Networking Demo Application
# ====================================

# محاكاة طلبات HTTP
# في بيئة حقيقية ستستخدم مكتبة الشبكة المدمجة

# تمثيل رؤوس HTTP
دالة أنشئ_رؤوس(نوع_المحتوى، ترميز)
    ارجع {
        "نوع_المحتوى": نوع_المحتوى,
        "الترميز": ترميز
    }
نهاية

# تمثيل استجابة HTTP
دالة أنشئ_استجابة(رمز_الحالة، رسالة، جسم)
    ارجع {
        "رمز_الحالة": رمز_الحالة,
        "رسالة": رسالة,
        "جسم": جسم
    }
نهاية

# محاكاة إرسال طلب GET
دالة طلب_GET(مسار)
    اطبع_سطر("→ GET " + مسار)
    
    إذا (مسار == "/مستخدمين")
        ارجع أنشئ_استجابة(200، "نجاح"، [
            {"اسم": "أحمد"، "عمر": 25},
            {"اسم": "سارة"، "عمر": 30}
        ])
    نهاية
    
    إذا (مسار == "/حالة")
        ارجع أنشئ_استجابة(200، "نجاح"، {"الحالة": "يعمل"، "الإصدار": "1.0"})
    نهاية
    
    ارجع أنشئ_استجابة(404، "غير موجود"، لاشيء)
نهاية

# محاكاة إرسال طلب POST
دالة طلب_POST(مسار، بيانات)
    اطبع_سطر("→ POST " + مسار)
    ارجع أنشئ_استجابة(201، "تم الإنشاء"، بيانات)
نهاية

# عرض استجابة
دالة اعرض_استجابة(استجابة)
    اطبع_سطر("  ← الحالة: " + استجابة["رمز_الحالة"] + " " + استجابة["رسالة"])
    إذا (استجابة["جسم"] != لاشيء)
        اطبع_سطر("  ← الجسم: " + استجابة["جسم"])
    نهاية
    اطبع_سطر("")
نهاية

# تحقق من نجاح الاستجابة
دالة ناجحة(استجابة)
    ارجع استجابة["رمز_الحالة"] >= 200 و استجابة["رمز_الحالة"] < 300
نهاية

# === تشغيل التطبيق ===
اطبع_سطر("=== تطبيق الشبكة التجريبي بلغة ص ===")
اطبع_سطر("")

# طلب GET للحالة
اطبع_سطر("--- فحص حالة الخادم ---")
متغير حالة = طلب_GET("/حالة")
اعرض_استجابة(حالة)

# طلب GET للمستخدمين
اطبع_سطر("--- جلب المستخدمين ---")
متغير مستخدمون = طلب_GET("/مستخدمين")
اعرض_استجابة(مستخدمون)

# طلب POST لإضافة مستخدم
اطبع_سطر("--- إضافة مستخدم جديد ---")
متغير مستخدم_جديد = {"اسم": "خالد"، "عمر": 28}
متغير نتيجة = طلب_POST("/مستخدمين"، مستخدم_جديد)
اعرض_استجابة(نتيجة)

# طلب لمسار غير موجود
اطبع_سطر("--- طلب مسار غير موجود ---")
متغير نتيجة_خطأ = طلب_GET("/غير_موجود")
اعرض_استجابة(نتيجة_خطأ)

# ملخص
اطبع_سطر("=== ملخص العمليات ===")
اطبع_سطر("حالة الخادم: " + (ناجحة(حالة) ? "متصل ✓" : "غير متصل ✗"))
اطبع_سطر("جلب البيانات: " + (ناجحة(مستخدمون) ? "نجح ✓" : "فشل ✗"))
اطبع_سطر("الإضافة: " + (ناجحة(نتيجة) ? "نجحت ✓" : "فشلت ✗"))
