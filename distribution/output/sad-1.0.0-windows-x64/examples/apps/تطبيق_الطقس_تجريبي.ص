# بيانات طقس المدن (محاكاة)
دالة أنشئ_بيانات_مدينة(اسم، درجة، رطوبة، حالة، رياح)
    ارجع {
        "اسم": اسم,
        "درجة_الحرارة": درجة,
        "الرطوبة": رطوبة,
        "الحالة": حالة,
        "سرعة_الرياح": رياح
    }
نهاية

# تصنيف درجة الحرارة
دالة صنف_الحرارة(درجة)
    إذا (درجة < 0)
        ارجع "متجمد 🥶"
    نهاية
    إذا (درجة < 15)
        ارجع "بارد 🌬️"
    نهاية
    إذا (درجة < 25)
        ارجع "معتدل 🌤️"
    نهاية
    إذا (درجة < 35)
        ارجع "حار ☀️"
    نهاية
    ارجع "شديد الحرارة 🔥"
نهاية

# تحديد مستوى الرطوبة
دالة مستوى_الرطوبة(نسبة)
    إذا (نسبة < 30)
        ارجع "جاف"
    نهاية
    إذا (نسبة < 60)
        ارجع "معتدل"
    نهاية
    ارجع "رطب"
نهاية

# تحويل سيلسيوس إلى فهرنهايت
دالة إلى_فهرنهايت(سيلسيوس)
    ارجع (سيلسيوس * 9 / 5) + 32
نهاية

# عرض طقس مدينة
دالة اعرض_طقس(مدينة)
    اطبع_سطر("")
    اطبع_سطر("📍 " + مدينة["اسم"])
    اطبع_سطر("  الحرارة: " + مدينة["درجة_الحرارة"] + "°م (" + إلى_فهرنهايت(مدينة["درجة_الحرارة"]) + "°ف)")
    اطبع_سطر("  الحالة: " + مدينة["الحالة"])
    اطبع_سطر("  التصنيف: " + صنف_الحرارة(مدينة["درجة_الحرارة"]))
    اطبع_سطر("  الرطوبة: " + مدينة["الرطوبة"] + "% (" + مستوى_الرطوبة(مدينة["الرطوبة"]) + ")")
    اطبع_سطر("  الرياح: " + مدينة["سرعة_الرياح"] + " كم/س")
نهاية

# حساب المتوسط
دالة متوسط_الحرارة(مدن)
    متغير مجموع = 0
    متغير عدد = 0
    لكل مدينة في مدن
        مجموع = مجموع + مدينة["درجة_الحرارة"]
        عدد = عدد + 1
    نهاية
    إذا (عدد == 0)
        ارجع 0
    نهاية
    ارجع مجموع / عدد
نهاية

# === تشغيل التطبيق ===
اطبع_سطر("=== تطبيق الطقس بلغة ص ===")
اطبع_سطر("تاريخ: بيانات محاكاة")

متغير مدن = [
    أنشئ_بيانات_مدينة("الرياض"، 42، 15، "مشمس ☀️"، 20),
    أنشئ_بيانات_مدينة("جدة"، 36، 75، "غائم جزئياً ⛅"، 15),
    أنشئ_بيانات_مدينة("الدمام"، 38، 65، "مشمس ☀️"، 25),
    أنشئ_بيانات_مدينة("أبها"، 22، 45، "معتدل 🌤️"، 10),
    أنشئ_بيانات_مدينة("تبوك"، 18، 30، "صافي 🌙"، 12)
]

لكل مدينة في مدن
    اعرض_طقس(مدينة)
نهاية

اطبع_سطر("")
اطبع_سطر("=== ملخص ===")
اطبع_سطر("متوسط الحرارة: " + متوسط_الحرارة(مدن) + "°م")
اطبع_سطر("عدد المدن: " + 5)
