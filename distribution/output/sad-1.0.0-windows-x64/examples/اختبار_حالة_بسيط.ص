# اختبار بسيط لنظام الحالة بدون مكتبة ثقيلة

متغير حالة_مهيأة = خطأ

دالة زيادة()
    متغير ع = اقرأ_حالة("العداد")
    عيّن_حالة("العداد"، ع + 1)
نهاية

دالة بناء_الواجهة()
    إذا (حالة_مهيأة == خطأ)
        عرّف_حالة("العداد"، 0)
        حالة_مهيأة = صحيح
    نهاية

    متغير عداد = اقرأ_حالة("العداد")

    ارجع حاوية(
        عمود([
            نص("العداد: " + عداد),
            زر("زيادة", عند_الضغط: زيادة)
        ])
    )
نهاية

شغّل(بناء_الواجهة)
