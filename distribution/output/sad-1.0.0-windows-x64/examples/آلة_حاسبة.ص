دالة اعرض_الشاشة(ح)
    اطبع_سطر("")
    اطبع_سطر("┌──────────────────────────────┐")
    متغير عملية_نص = ""
    إذا (ح.العملية_الحالية() != لاشيء)
        عملية_نص = " [" + ح.العملية_الحالية() + "]"
    نهاية
    متغير محتوى = "  " + ح.الشاشة() + عملية_نص
    اطبع_سطر("│" + محتوى + "                              │")
    اطبع_سطر("├──────────────────────────────┤")
    اطبع_سطر("│  م:مسح  ⌫:حذف  %:نسبة  ±:إشارة │")
    اطبع_سطر("│  7  8  9  ÷                  │")
    اطبع_سطر("│  4  5  6  ×                  │")
    اطبع_سطر("│  1  2  3  -                  │")
    اطبع_سطر("│  0  .     +          =       │")
    اطبع_سطر("│  ت:تاريخ              خ:خروج │")
    اطبع_سطر("└──────────────────────────────┘")
نهاية

