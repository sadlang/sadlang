# ─── المحرك الحسابي ───

صنف محرك_حسابي
    باني()
        هذا._شاشة = "0"
        هذا._العملية = لاشيء
        هذا._الأول = 0
        هذا._انتظار_ثاني = خطأ
        هذا._التاريخ = []
    نهاية

    دالة اضغط_رقم(رقم)
        إذا (هذا._انتظار_ثاني)
            هذا._شاشة = "" + رقم
            هذا._انتظار_ثاني = خطأ
        وإلا
            إذا (هذا._شاشة == "0")
                هذا._شاشة = "" + رقم
            وإلا
                هذا._شاشة = هذا._شاشة + رقم
            نهاية
        نهاية
    نهاية

    دالة اضغط_نقطة()
        إذا (هذا._انتظار_ثاني)
            هذا._شاشة = "0."
            هذا._انتظار_ثاني = خطأ
            ارجع لاشيء
        نهاية
        # تحقق أن النقطة غير موجودة مسبقاً
        متغير ع = 0
        متغير موجودة = خطأ
        بينما (ع < طول(هذا._شاشة))
            إذا (هذا._شاشة[ع] == ".")
                موجودة = صحيح
            نهاية
            ع = ع + 1
        نهاية
        إذا (ليس موجودة)
            هذا._شاشة = هذا._شاشة + "."
        نهاية
    نهاية

    دالة اضغط_عملية(عملية)
        متغير القيمة = إلى_عشري(هذا._شاشة)

        إذا (هذا._العملية != لاشيء و ليس هذا._انتظار_ثاني)
            متغير نتيجة = هذا._احسب(هذا._الأول, القيمة, هذا._العملية)
            هذا._سجّل_تاريخ(هذا._الأول, هذا._العملية, القيمة, نتيجة)
            هذا._شاشة = "" + نتيجة
            هذا._الأول = نتيجة
        وإلا
            هذا._الأول = القيمة
        نهاية

        هذا._العملية = عملية
        هذا._انتظار_ثاني = صحيح
    نهاية

    دالة اضغط_يساوي()
        إذا (هذا._العملية == لاشيء)
            ارجع لاشيء
        نهاية

        متغير الثاني = إلى_عشري(هذا._شاشة)
        متغير نتيجة = هذا._احسب(هذا._الأول, الثاني, هذا._العملية)
        هذا._سجّل_تاريخ(هذا._الأول, هذا._العملية, الثاني, نتيجة)
        هذا._شاشة = "" + نتيجة
        هذا._العملية = لاشيء
        هذا._انتظار_ثاني = صحيح
    نهاية

    دالة امسح()
        هذا._شاشة = "0"
        هذا._العملية = لاشيء
        هذا._الأول = 0
        هذا._انتظار_ثاني = خطأ
    نهاية

    دالة امسح_آخر()
        إذا (طول(هذا._شاشة) > 1)
            هذا._شاشة = قطع(هذا._شاشة, 0, طول(هذا._شاشة) - 1)
        وإلا
            هذا._شاشة = "0"
        نهاية
    نهاية

    دالة نسبة_مئوية()
        متغير قيمة = إلى_عشري(هذا._شاشة)
        قيمة = قيمة / 100
        هذا._شاشة = "" + قيمة
    نهاية

    دالة عكس_إشارة()
        متغير قيمة = إلى_عشري(هذا._شاشة)
        قيمة = قيمة * -1
        هذا._شاشة = "" + قيمة
    نهاية

    دالة الشاشة()
        ارجع هذا._شاشة
    نهاية

    دالة العملية_الحالية()
        ارجع هذا._العملية
    نهاية

    دالة التاريخ()
        ارجع هذا._التاريخ
    نهاية

    دالة _احسب(أ, ب, عملية)
        إذا (عملية == "+")
            ارجع أ + ب
        نهاية
        إذا (عملية == "-")
            ارجع أ - ب
        نهاية
        إذا (عملية == "×")
            ارجع أ * ب
        نهاية
        إذا (عملية == "÷")
            إذا (ب == 0)
                ارجع "خطأ: قسمة على صفر"
            نهاية
            ارجع أ / ب
        نهاية
        ارجع 0
    نهاية

    دالة _سجّل_تاريخ(أ, عملية, ب, نتيجة)
        متغير سجل = "" + أ + " " + عملية + " " + ب + " = " + نتيجة
        هذا._التاريخ = هذا._التاريخ + [سجل]
    نهاية
نهاية

