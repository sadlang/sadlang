نهاية

دالة اطبع_سطر_وسط(نص)
    متغير مسافات = 28 - طول(نص)
    إذا (مسافات < 0)
        مسافات = 0
    نهاية
    متغير يسار = مسافات / 2
    متغير يمين = مسافات - يسار
    متغير سطر = "║ "
    متغير ع = 0
    بينما (ع < يسار)
        سطر = سطر + " "
        ع = ع + 1
    نهاية
    سطر = سطر + نص
    ع = 0
    بينما (ع < يمين)
        سطر = سطر + " "
        ع = ع + 1
    نهاية
    اطبع_سطر(سطر + " ║")
نهاية

