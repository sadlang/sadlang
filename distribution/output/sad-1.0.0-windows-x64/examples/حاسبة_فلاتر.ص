# ─── زر رقمي (FilledTonalButton — M3) ───
دالة _زر_رقم(رمز, عند_ضغط)
    ارجع زر(لنص(رمز),
        لون_خلفية: لون_رقم_خلف,
        لون_نص: لون_رقم_نص,
        عند_الضغط: عند_ضغط,
        عرض: 72,
        ارتفاع: 64,
        حجم_الخط: 24,
        زوايا: 16
    )
نهاية

# ─── زر عملية (FilledButton — M3) ───
دالة _زر_عملية(رمز, عند_ضغط)
    ارجع زر(رمز,
        لون_خلفية: لون_عملية_خلف,
        لون_نص: لون_أساسي,
        عند_الضغط: عند_ضغط,
        عرض: 72,
        ارتفاع: 64,
        حجم_الخط: 24,
        زوايا: 16
    )
نهاية

# ─── زر وظيفي (C, ±, %) ───
دالة _زر_وظيفي(رمز, عند_ضغط)
    ارجع زر(رمز,
        لون_خلفية: لون_سطح,
        لون_نص: لون_ثانوي,
        عند_الضغط: عند_ضغط,
        عرض: 72,
        ارتفاع: 64,
        حجم_الخط: 20,
        زوايا: 16
    )
نهاية

# ===================================================================
#  بناء شجرة الواجهة — Flutter Declarative Widget Tree
#  (دالة بنّاء تُنتج شجرة جديدة عند كل إعادة بناء)
# ===================================================================

دالة بناء_الواجهة()
    # ─── الشريط العلوي (AppBar) ───
    متغير الشريط = شريط_تطبيق("آلة حاسبة ص 🔢",
        خلفية: لون_سطح,
        لون_النص: لون_أساسي
    )

    # ─── جسم الصفحة (Body) ───
    متغير الجسم = حاوية(
        عمود([
            # ─── شاشة العرض (Display Card) ───
            حاوية(
                عمود([
                    نص(الشاشة,
                        حجم: 48,
                        لون: لون_شاشة,
                        محاذاة: "يمين",
                        وزن: "عريض"
                    )
                ], محاذاة: "نهاية"),
                خلفية: لون_سطح,
                حشو: 24,
                هامش: 16,
                زوايا: 28
            ),

            # ─── Row 1: C ± % ÷ ───
            صف([
                _زر_وظيفي("C", ض_مسح),
                _زر_وظيفي("±", ض_سالب),
                _زر_وظيفي("%", ض_نسبة),
                _زر_عملية("÷", ض_قسمة)
            ], تباعد: 8),

            # ─── Row 2: 7 8 9 × ───
            صف([
                _زر_رقم(7, ض7),
                _زر_رقم(8, ض8),
                _زر_رقم(9, ض9),
                _زر_عملية("×", ض_ضرب)
            ], تباعد: 8),

            # ─── Row 3: 4 5 6 − ───
            صف([
                _زر_رقم(4, ض4),
                _زر_رقم(5, ض5),
                _زر_رقم(6, ض6),
                _زر_عملية("−", ض_طرح)
            ], تباعد: 8),

            # ─── Row 4: 1 2 3 + ───
            صف([
                _زر_رقم(1, ض1),
                _زر_رقم(2, ض2),
                _زر_رقم(3, ض3),
                _زر_عملية("+", ض_جمع)
            ], تباعد: 8),

            # ─── Row 5: 0 . = ───
            صف([
                _زر_رقم(0, ض0),
                _زر_رقم(".", ض_نقطة),
                زر("=",
                    لون_خلفية: لون_أساسي,
                    لون_نص: لون_على_أساسي,
                    عند_الضغط: ض_يساوي,
                    عرض: 152,
                    ارتفاع: 64,
                    حجم_الخط: 28,
                    زوايا: 16
                )
            ], تباعد: 8)

        ], تباعد: 8, محاذاة: "وسط"),
        خلفية: لون_خلف,
        حشو: 16
    )

    # ─── Scaffold ───
    متغير الهيكل = هيكل_مادة(
        جسم: الجسم,
        شريط_تطبيق: الشريط
    )

    # ─── MaterialApp ───
    ارجع تطبيق_مادة(
        عنوان: "آلة حاسبة ص",
        الصفحة_الرئيسية: الهيكل
    )
نهاية

