ثابت لون_شاشة2 = "#938F99"

# ===================================================================
#  حالة الحاسبة — Calculator State
# ===================================================================

متغير الشاشة = "0"
متغير العملية = ""
متغير الرقم_الأول = 0
متغير بدأ_رقم = صحيح

# ===================================================================
#  المنطق الحسابي — Calculator Logic
# ===================================================================

دالة ضغط_رقم(رقم)
    إذا (بدأ_رقم)
        الشاشة = لنص(رقم)
        بدأ_رقم = خطأ
    وإلا
        إذا (الشاشة == "0")
            الشاشة = لنص(رقم)
        وإلا
            الشاشة = الشاشة + لنص(رقم)
        نهاية
    نهاية
نهاية

دالة ضغط_عملية(عم)
    الرقم_الأول = إلى_عشري(الشاشة)
    العملية = عم
    بدأ_رقم = صحيح
نهاية

دالة ضغط_يساوي()
    إذا (العملية == "")
        ارجع لاشيء
    نهاية
    متغير الثاني = إلى_عشري(الشاشة)
    متغير نتيجة = 0

    إذا (العملية == "+")
        نتيجة = الرقم_الأول + الثاني
    وإلا
        إذا (العملية == "-")
            نتيجة = الرقم_الأول - الثاني
        وإلا
            إذا (العملية == "*")
                نتيجة = الرقم_الأول * الثاني
            وإلا
                إذا (العملية == "/")
                    إذا (الثاني != 0)
                        نتيجة = الرقم_الأول / الثاني
                    وإلا
                        الشاشة = "خطأ"
                        بدأ_رقم = صحيح
                        ارجع لاشيء
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية

    الشاشة = لنص(نتيجة)
    العملية = ""
    بدأ_رقم = صحيح
نهاية

دالة ضغط_مسح()
    الشاشة = "0"
    العملية = ""
    الرقم_الأول = 0
    بدأ_رقم = صحيح
نهاية

دالة ضغط_نقطة()
    إذا (بدأ_رقم)
        الشاشة = "0."
        بدأ_رقم = خطأ
    وإلا
        متغير ي = 0
        متغير فيها = خطأ
        بينما (ي < طول(الشاشة))
            إذا (الشاشة[ي] == ".")
                فيها = صحيح
            نهاية
            ي = ي + 1
        نهاية
        إذا (ليس فيها)
            الشاشة = الشاشة + "."
        نهاية
    نهاية
نهاية

دالة ضغط_نسبة()
    متغير ق = إلى_عشري(الشاشة)
    الشاشة = لنص(ق / 100)
    بدأ_رقم = صحيح
نهاية

دالة ضغط_سالب()
    إذا (الشاشة != "0")
        متغير ق = إلى_عشري(الشاشة)
        الشاشة = لنص(ق * -1)
    نهاية
نهاية

