# بسم الله الرحمن الرحيم
# ===================================================================
# آلة حاسبة تفاعلية رسومية بلغة ص
# Interactive Graphical Calculator — SDL2 Backend
# ===================================================================

من رسومات.واجهات استورد *

# ─── حالة الآلة الحاسبة ───
متغير الشاشة = "0"
متغير العملية = ""
متغير الرقم_الأول = 0
متغير بدأ_رقم_جديد = صحيح
متغير السجل = ""

# ─── دوال المنطق ───

دالة ضغط_رقم(رقم)
    إذا (بدأ_رقم_جديد)
        الشاشة = لنص(رقم)
        بدأ_رقم_جديد = خطأ
    وإلا
        إذا (الشاشة == "0")
            الشاشة = لنص(رقم)
        وإلا
            الشاشة = الشاشة + لنص(رقم)
        نهاية
    نهاية
نهاية

دالة ضغط_عملية(عم)
    الرقم_الأول = لعشري(الشاشة)
    العملية = عم
    بدأ_رقم_جديد = صحيح
نهاية

دالة ضغط_يساوي()
    متغير الرقم_الثاني = لعشري(الشاشة)
    متغير نتيجة = 0

    إذا (العملية == "+")
        نتيجة = الرقم_الأول + الرقم_الثاني
    وإلا
        إذا (العملية == "-")
            نتيجة = الرقم_الأول - الرقم_الثاني
        وإلا
            إذا (العملية == "*")
                نتيجة = الرقم_الأول * الرقم_الثاني
            وإلا
                إذا (العملية == "/")
                    إذا (الرقم_الثاني != 0)
                        نتيجة = الرقم_الأول / الرقم_الثاني
                    وإلا
                        الشاشة = "خطأ"
                        بدأ_رقم_جديد = صحيح
                        ارجع لاشيء
                    نهاية
                نهاية
            نهاية
        نهاية
    نهاية

    الشاشة = لنص(نتيجة)
    بدأ_رقم_جديد = صحيح
نهاية

دالة ضغط_مسح()
    الشاشة = "0"
    العملية = ""
    الرقم_الأول = 0
    بدأ_رقم_جديد = صحيح
نهاية

دالة ضغط_نقطة()
    إذا (بدأ_رقم_جديد)
        الشاشة = "0."
        بدأ_رقم_جديد = خطأ
    وإلا
        # لا تضف نقطة إذا كانت موجودة
        متغير ي = 0
        متغير يوجد_نقطة = خطأ
        بينما (ي < طول(الشاشة))
            إذا (الشاشة[ي] == ".")
                يوجد_نقطة = صحيح
            نهاية
            ي = ي + 1
        نهاية
        إذا (ليس يوجد_نقطة)
            الشاشة = الشاشة + "."
        نهاية
    نهاية
نهاية

دالة ضغط_نسبة()
    متغير قيمة = لعشري(الشاشة)
    الشاشة = لنص(قيمة / 100)
    بدأ_رقم_جديد = صحيح
نهاية

دالة ضغط_سالب()
    إذا (الشاشة != "0")
        متغير قيمة = لعشري(الشاشة)
        الشاشة = لنص(قيمة * -1)
    نهاية
نهاية

# ─── دوال الأزرار ───
دالة ض0() ضغط_رقم(0) نهاية
دالة ض1() ضغط_رقم(1) نهاية
دالة ض2() ضغط_رقم(2) نهاية
دالة ض3() ضغط_رقم(3) نهاية
دالة ض4() ضغط_رقم(4) نهاية
دالة ض5() ضغط_رقم(5) نهاية
دالة ض6() ضغط_رقم(6) نهاية
دالة ض7() ضغط_رقم(7) نهاية
دالة ض8() ضغط_رقم(8) نهاية
دالة ض9() ضغط_رقم(9) نهاية
دالة ض_جمع() ضغط_عملية("+") نهاية
دالة ض_طرح() ضغط_عملية("-") نهاية
دالة ض_ضرب() ضغط_عملية("*") نهاية
دالة ض_قسمة() ضغط_عملية("/") نهاية
دالة ض_مسح() ضغط_مسح() نهاية
دالة ض_يساوي() ضغط_يساوي() نهاية
دالة ض_نقطة() ضغط_نقطة() نهاية
دالة ض_نسبة() ضغط_نسبة() نهاية
دالة ض_سالب() ضغط_سالب() نهاية

# ─── تعريف الأزرار ───

دالة زر_رقم(رقم, دالة_ضغط)
    ارجع زر(لنص(رقم),
        لون_خلفية: "#424242",
        لون_نص: "#FFFFFF",
        عند_الضغط: دالة_ضغط,
        عرض: 70,
        ارتفاع: 60,
        حجم_الخط: 22,
        زوايا: 8
    )
نهاية

دالة زر_عملية(رمز, دالة_ضغط)
    ارجع زر(رمز,
        لون_خلفية: "#FF9800",
        لون_نص: "#FFFFFF",
        عند_الضغط: دالة_ضغط,
        عرض: 70,
        ارتفاع: 60,
        حجم_الخط: 22,
        زوايا: 8
    )
نهاية

# ─── بناء الواجهة ───

متغير التطبيق = عمود([
    # العنوان
    حاوية(
        نص("آلة حاسبة ص", حجم: 16, لون: "#89B4FA", محاذاة: "وسط"),
        خلفية: "#181825",
        حشو: 8,
        هامش: 5
    ),

    # الشاشة
    حاوية(
        عمود([
            نص(الشاشة, حجم: 42, لون: "#FFFFFF", محاذاة: "يمين")
        ]),
        خلفية: "#1E1E1E",
        حشو: 20,
        هامش: 10
    ),

    # الصف الأول: C ± % ÷
    صف([
        زر("C", لون_خلفية: "#F44336", لون_نص: "#FFFFFF", عند_الضغط: ض_مسح, عرض: 70, ارتفاع: 60, زوايا: 8),
        زر("±", لون_خلفية: "#616161", لون_نص: "#FFFFFF", عند_الضغط: ض_سالب, عرض: 70, ارتفاع: 60, زوايا: 8),
        زر("%", لون_خلفية: "#616161", لون_نص: "#FFFFFF", عند_الضغط: ض_نسبة, عرض: 70, ارتفاع: 60, زوايا: 8),
        زر_عملية("÷", ض_قسمة)
    ]),

    # الصف الثاني: 7 8 9 ×
    صف([
        زر_رقم(7, ض7),
        زر_رقم(8, ض8),
        زر_رقم(9, ض9),
        زر_عملية("×", ض_ضرب)
    ]),

    # الصف الثالث: 4 5 6 -
    صف([
        زر_رقم(4, ض4),
        زر_رقم(5, ض5),
        زر_رقم(6, ض6),
        زر_عملية("-", ض_طرح)
    ]),

    # الصف الرابع: 1 2 3 +
    صف([
        زر_رقم(1, ض1),
        زر_رقم(2, ض2),
        زر_رقم(3, ض3),
        زر_عملية("+", ض_جمع)
    ]),

    # الصف الخامس: 0 . =
    صف([
        زر_رقم(0, ض0),
        زر(".", لون_خلفية: "#424242", لون_نص: "#FFFFFF", عند_الضغط: ض_نقطة, عرض: 70, ارتفاع: 60, حجم_الخط: 22, زوايا: 8),
        زر("=", لون_خلفية: "#4CAF50", لون_نص: "#FFFFFF", عند_الضغط: ض_يساوي, عرض: 148, ارتفاع: 60, حجم_الخط: 22, زوايا: 8)
    ])
], تباعد: 5, خلفية: "#2D2D2D")

# ─── تشغيل التطبيق ───
اطبع_سطر("جارٍ تشغيل الآلة الحاسبة...")
شغّل(التطبيق)
