# ═══════════════════════════════════════════════════════════════
#  المساعد الشخصي — تطبيق رسومي متعدد الصفحات بلغة ص
#  6 صفحات: الرئيسية، المهام، الملاحظات، الحاسبة، المؤقت، الإعدادات، حول
# ═══════════════════════════════════════════════════════════════

من رسومات.واجهات استورد *

# ═══ استيراد الصفحات ═══
من صفحات.الرئيسية استورد *
من صفحات.المهام استورد *
من صفحات.الملاحظات استورد *
من صفحات.الحاسبة استورد *
من صفحات.الإعدادات استورد *
من صفحات.المؤقت استورد *
من صفحات.حول استورد *

# ═══ ألوان التطبيق (Material Design 3 - وضع داكن) ═══
ثابت ألوان = {
    "خلفية": "#1C1B1F",
    "سطح": "#2B2930",
    "أساسي": "#D0BCFF",
    "عملية": "#4A4458",
    "نص": "#E6E1E5",
    "نص_ثانوي": "#CAC4D0",
    "خطأ": "#F2B8B5",
    "نجاح": "#4CAF50"
}

# ═══ حالة التنقل ═══
متغير الصفحة_الحالية = "رئيسية"

# ═══ دوال التنقل ═══
دالة نقل_رئيسية()   الصفحة_الحالية = "رئيسية" نهاية
دالة نقل_مهام()      الصفحة_الحالية = "مهام" نهاية
دالة نقل_ملاحظات()   الصفحة_الحالية = "ملاحظات" نهاية
دالة نقل_حاسبة()     الصفحة_الحالية = "حاسبة" نهاية
دالة نقل_إعدادات()    الصفحة_الحالية = "إعدادات" نهاية
دالة نقل_مؤقت()      الصفحة_الحالية = "مؤقت" نهاية
دالة نقل_حول()       الصفحة_الحالية = "حول" نهاية

# خريطة التنقل للصفحة الرئيسية
ثابت خريطة_التنقل = {
    "مهام": نقل_مهام,
    "ملاحظات": نقل_ملاحظات,
    "حاسبة": نقل_حاسبة,
    "إعدادات": نقل_إعدادات,
    "مؤقت": نقل_مؤقت,
    "حول": نقل_حول
}

# ═══ الشريط الجانبي للتنقل ═══
دالة _بناء_شريط_جانبي()
    ارجع حاوية(
        عمود([
            # عنوان التطبيق
            حاوية(
                نص("المساعد", حجم: 16, لون: ألوان["أساسي"], وزن: "عريض"),
                حشو: 12
            ),

            # أزرار التنقل
            زر("🏠 الرئيسية",
                لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                عند_الضغط: نقل_رئيسية,
                عرض: 130, ارتفاع: 36, حجم_الخط: 12, زوايا: 8),
            زر("📋 المهام",
                لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                عند_الضغط: نقل_مهام,
                عرض: 130, ارتفاع: 36, حجم_الخط: 12, زوايا: 8),
            زر("📝 الملاحظات",
                لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                عند_الضغط: نقل_ملاحظات,
                عرض: 130, ارتفاع: 36, حجم_الخط: 12, زوايا: 8),
            زر("🧮 الحاسبة",
                لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                عند_الضغط: نقل_حاسبة,
                عرض: 130, ارتفاع: 36, حجم_الخط: 12, زوايا: 8),
            زر("⏱️ المؤقت",
                لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                عند_الضغط: نقل_مؤقت,
                عرض: 130, ارتفاع: 36, حجم_الخط: 12, زوايا: 8),
            زر("⚙️ الإعدادات",
                لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                عند_الضغط: نقل_إعدادات,
                عرض: 130, ارتفاع: 36, حجم_الخط: 12, زوايا: 8),
            زر("ℹ️ حول",
                لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                عند_الضغط: نقل_حول,
                عرض: 130, ارتفاع: 36, حجم_الخط: 12, زوايا: 8)
        ], تباعد: 4),
        خلفية: "#252329",
        حشو: 8, عرض: 150
    )
نهاية

# ═══ البناء الرئيسي ═══
دالة بناء_التطبيق()
    # بناء محتوى الصفحة حسب الصفحة الحالية
    متغير محتوى = لاشيء

    إذا (الصفحة_الحالية == "رئيسية")
        محتوى = بناء_الرئيسية(ألوان, خريطة_التنقل)
    نهاية
    إذا (الصفحة_الحالية == "مهام")
        محتوى = بناء_المهام(ألوان, نقل_رئيسية)
    نهاية
    إذا (الصفحة_الحالية == "ملاحظات")
        محتوى = بناء_الملاحظات(ألوان, نقل_رئيسية)
    نهاية
    إذا (الصفحة_الحالية == "حاسبة")
        محتوى = بناء_الحاسبة(ألوان, نقل_رئيسية)
    نهاية
    إذا (الصفحة_الحالية == "إعدادات")
        محتوى = بناء_الإعدادات(ألوان, نقل_رئيسية)
    نهاية
    إذا (الصفحة_الحالية == "مؤقت")
        محتوى = بناء_المؤقت(ألوان, نقل_رئيسية)
    نهاية
    إذا (الصفحة_الحالية == "حول")
        محتوى = بناء_حول(ألوان, نقل_رئيسية)
    نهاية

    # تخطيط: شريط جانبي + محتوى الصفحة
    ارجع حاوية(
        صف([
            _بناء_شريط_جانبي(),
            محتوى
        ]),
        خلفية: ألوان["خلفية"]
    )
نهاية

# ═══ تشغيل التطبيق ═══
شغّل(بناء_التطبيق)
