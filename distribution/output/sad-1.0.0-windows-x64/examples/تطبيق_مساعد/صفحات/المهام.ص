# ═══════════════════════════════════════════════════════════
#  صفحة المهام — قائمة مهام تفاعلية
# ═══════════════════════════════════════════════════════════

من رسومات.واجهات استورد *

# حالة المهام
متغير المهام = ["تعلم لغة ص", "بناء تطبيق رسومي", "كتابة التوثيق", "اختبار الأداء", "نشر النسخة"]
متغير حالات = [خطأ, خطأ, خطأ, خطأ, خطأ]
متغير عدد_المنجز = 0

دالة _تحديث_عداد()
    عدد_المنجز = 0
    متغير ي = 0
    بينما (ي < طول(حالات))
        إذا (حالات[ي])
            عدد_المنجز = عدد_المنجز + 1
        نهاية
        ي = ي + 1
    نهاية
نهاية

دالة تبديل0() حالات[0] = ليس حالات[0] _تحديث_عداد() نهاية
دالة تبديل1() حالات[1] = ليس حالات[1] _تحديث_عداد() نهاية
دالة تبديل2() حالات[2] = ليس حالات[2] _تحديث_عداد() نهاية
دالة تبديل3() حالات[3] = ليس حالات[3] _تحديث_عداد() نهاية
دالة تبديل4() حالات[4] = ليس حالات[4] _تحديث_عداد() نهاية

صدّر دالة بناء_المهام(ألوان, رجوع)
    _تحديث_عداد()

    متغير عناصر = []
    متغير ي = 0
    بينما (ي < طول(المهام))
        متغير رمز = "⬜"
        متغير لون_م = ألوان["نص"]
        إذا (حالات[ي])
            رمز = "✅"
            لون_م = ألوان["نص_ثانوي"]
        نهاية

        متغير دالة_تبديل = لاشيء
        إذا (ي == 0) دالة_تبديل = تبديل0 نهاية
        إذا (ي == 1) دالة_تبديل = تبديل1 نهاية
        إذا (ي == 2) دالة_تبديل = تبديل2 نهاية
        إذا (ي == 3) دالة_تبديل = تبديل3 نهاية
        إذا (ي == 4) دالة_تبديل = تبديل4 نهاية

        عناصر = عناصر + [حاوية(
            صف([
                زر(رمز + " " + المهام[ي],
                    لون_خلفية: ألوان["سطح"],
                    لون_نص: لون_م,
                    عند_الضغط: دالة_تبديل,
                    عرض: 400, ارتفاع: 48,
                    حجم_الخط: 16, زوايا: 10
                )
            ]),
            هامش: 4
        )]
        ي = ي + 1
    نهاية

    ارجع حاوية(
        عمود([
            # الشريط العلوي
            صف([
                زر("→ رجوع", لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                    عند_الضغط: رجوع, عرض: 100, ارتفاع: 40, زوايا: 8),
                حاوية(
                    نص("📋 المهام", حجم: 24, لون: ألوان["أساسي"], وزن: "عريض"),
                    حشو: 8
                )
            ], تباعد: 12),

            # شريط التقدم
            حاوية(
                نص(لنص(عدد_المنجز) + " / " + لنص(طول(المهام)) + " مُنجزة",
                    حجم: 16, لون: ألوان["أساسي"]),
                خلفية: ألوان["سطح"],
                حشو: 12, هامش: 10, زوايا: 12
            ),

            # قائمة المهام
            عمود(عناصر, تباعد: 2)

        ], تباعد: 12),
        خلفية: ألوان["خلفية"],
        حشو: 16
    )
نهاية
