#  صفحة الحاسبة — حاسبة رقمية تفاعلية
# ═══════════════════════════════════════════════════════════

من رسومات.واجهات استورد *

# حالة الحاسبة
متغير الشاشة = "0"
متغير الرقم_الأول = 0
متغير العملية = ""
متغير بدأ_رقم = صحيح

دالة إضافة_رقم(ر)
    إذا (بدأ_رقم)
        الشاشة = لنص(ر)
        بدأ_رقم = خطأ
    وإلا
        الشاشة = الشاشة + لنص(ر)
    نهاية
نهاية

دالة تعيين_عملية(ع)
    الرقم_الأول = لرقم(الشاشة)
    العملية = ع
    بدأ_رقم = صحيح
نهاية

دالة حساب_النتيجة()
    متغير الثاني = لرقم(الشاشة)
    متغير نتيجة = 0
    إذا (العملية == "+") نتيجة = الرقم_الأول + الثاني نهاية
    إذا (العملية == "-") نتيجة = الرقم_الأول - الثاني نهاية
    إذا (العملية == "×") نتيجة = الرقم_الأول * الثاني نهاية
    إذا (العملية == "÷")
        إذا (الثاني != 0)
            نتيجة = الرقم_الأول / الثاني
        وإلا
            الشاشة = "خطأ"
            بدأ_رقم = صحيح
            ارجع لاشيء
        نهاية
    نهاية
    الشاشة = لنص(نتيجة)
    بدأ_رقم = صحيح
نهاية

دالة مسح()
    الشاشة = "0"
    الرقم_الأول = 0
    العملية = ""
    بدأ_رقم = صحيح
نهاية

# أزرار الأرقام
دالة ض0() إضافة_رقم(0) نهاية
دالة ض1() إضافة_رقم(1) نهاية
دالة ض2() إضافة_رقم(2) نهاية
دالة ض3() إضافة_رقم(3) نهاية
دالة ض4() إضافة_رقم(4) نهاية
دالة ض5() إضافة_رقم(5) نهاية
دالة ض6() إضافة_رقم(6) نهاية
دالة ض7() إضافة_رقم(7) نهاية
دالة ض8() إضافة_رقم(8) نهاية
دالة ض9() إضافة_رقم(9) نهاية

# أزرار العمليات
دالة ض_جمع() تعيين_عملية("+") نهاية
دالة ض_طرح() تعيين_عملية("-") نهاية
دالة ض_ضرب() تعيين_عملية("×") نهاية
دالة ض_قسمة() تعيين_عملية("÷") نهاية
دالة ض_يساوي() حساب_النتيجة() نهاية
دالة ض_مسح() مسح() نهاية

صدّر دالة بناء_الحاسبة(ألوان, رجوع)
    متغير لون_رقم = ألوان["سطح"]
    متغير لون_عملية = ألوان["عملية"]
    متغير لون_نص = ألوان["نص"]

    ارجع حاوية(
        عمود([
            # الشريط العلوي
            صف([
                زر("→ رجوع", لون_خلفية: لون_عملية, لون_نص: لون_نص,
                    عند_الضغط: رجوع, عرض: 100, ارتفاع: 40, زوايا: 8),
                حاوية(
                    نص("🧮 الحاسبة", حجم: 24, لون: ألوان["أساسي"], وزن: "عريض"),
                    حشو: 8
                )
            ], تباعد: 12),

            # شاشة العرض
            حاوية(
                نص(الشاشة, حجم: 36, لون: ألوان["أساسي"], وزن: "عريض"),
                خلفية: ألوان["سطح"],
                حشو: 20, هامش: 10, زوايا: 16, عرض: 300
            ),

            # صف 1: مسح و القسمة والضرب
            صف([
                زر("C", لون_خلفية: "#F44336", لون_نص: "#FFFFFF",
                    عند_الضغط: ض_مسح, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("÷", لون_خلفية: لون_عملية, لون_نص: لون_نص,
                    عند_الضغط: ض_قسمة, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("×", لون_خلفية: لون_عملية, لون_نص: لون_نص,
                    عند_الضغط: ض_ضرب, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("-", لون_خلفية: لون_عملية, لون_نص: لون_نص,
                    عند_الضغط: ض_طرح, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12)
            ], تباعد: 8),

            # صف 2: 7 8 9
            صف([
                زر("7", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض7, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("8", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض8, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("9", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض9, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("+", لون_خلفية: لون_عملية, لون_نص: لون_نص,
                    عند_الضغط: ض_جمع, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12)
            ], تباعد: 8),

            # صف 3: 4 5 6
            صف([
                زر("4", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض4, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("5", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض5, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("6", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض6, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("=", لون_خلفية: ألوان["أساسي"], لون_نص: "#000000",
                    عند_الضغط: ض_يساوي, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12)
            ], تباعد: 8),

            # صف 4: 1 2 3 0
            صف([
                زر("1", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض1, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("2", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض2, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("3", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض3, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12),
                زر("0", لون_خلفية: لون_رقم, لون_نص: لون_نص,
                    عند_الضغط: ض0, عرض: 70, ارتفاع: 55, حجم_الخط: 20, زوايا: 12)
            ], تباعد: 8)
        ], تباعد: 8),
        خلفية: ألوان["خلفية"],
        حشو: 16
    )
نهاية
