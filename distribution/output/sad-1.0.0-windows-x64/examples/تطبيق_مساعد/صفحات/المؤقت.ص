# ═══════════════════════════════════════════════════════════
#  صفحة المؤقت — عداد تنازلي / تصاعدي تفاعلي
# ═══════════════════════════════════════════════════════════

من رسومات.واجهات استورد *

# حالة المؤقت
متغير العداد = 0
متغير الحد_الأقصى = 60
متغير تشغيل = خطأ

دالة زيادة()
    إذا (العداد < 999)
        العداد = العداد + 1
    نهاية
نهاية

دالة نقصان()
    إذا (العداد > 0)
        العداد = العداد - 1
    نهاية
نهاية

دالة إعادة_تعيين()
    العداد = 0
نهاية

دالة زيادة5()
    العداد = العداد + 5
    إذا (العداد > 999) العداد = 999 نهاية
نهاية

دالة نقصان5()
    العداد = العداد - 5
    إذا (العداد < 0) العداد = 0 نهاية
نهاية

دالة تعيين_حد_30() الحد_الأقصى = 30 نهاية
دالة تعيين_حد_60() الحد_الأقصى = 60 نهاية
دالة تعيين_حد_120() الحد_الأقصى = 120 نهاية

دالة _تنسيق_وقت(ثواني)
    متغير دقائق = 0
    متغير بقية = ثواني
    بينما (بقية >= 60)
        دقائق = دقائق + 1
        بقية = بقية - 60
    نهاية
    متغير نص_د = لنص(دقائق)
    متغير نص_ث = لنص(بقية)
    إذا (دقائق < 10) نص_د = "0" + نص_د نهاية
    إذا (بقية < 10) نص_ث = "0" + نص_ث نهاية
    ارجع نص_د + ":" + نص_ث
نهاية

صدّر دالة بناء_المؤقت(ألوان, رجوع)
    # حساب النسبة المئوية
    متغير نسبة = 0
    إذا (الحد_الأقصى > 0)
        نسبة = (العداد * 100) / الحد_الأقصى
    نهاية
    إذا (نسبة > 100) نسبة = 100 نهاية

    # لون الشريط حسب النسبة
    متغير لون_شريط = "#4CAF50"
    إذا (نسبة > 75) لون_شريط = "#F44336" نهاية
    إذا (نسبة > 50 و نسبة <= 75) لون_شريط = "#FF9800" نهاية

    ارجع حاوية(
        عمود([
            # الشريط العلوي
            صف([
                زر("→ رجوع", لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                    عند_الضغط: رجوع, عرض: 100, ارتفاع: 40, زوايا: 8),
                حاوية(
                    نص("⏱️ المؤقت", حجم: 24, لون: ألوان["أساسي"], وزن: "عريض"),
                    حشو: 8
                )
            ], تباعد: 12),

            # العداد الكبير
            حاوية(
                عمود([
                    نص(_تنسيق_وقت(العداد), حجم: 48, لون: ألوان["أساسي"], وزن: "عريض"),
                    نص(لنص(العداد) + " / " + لنص(الحد_الأقصى) + " ثانية",
                        حجم: 14, لون: ألوان["نص_ثانوي"])
                ]),
                خلفية: ألوان["سطح"],
                حشو: 30, هامش: 10, زوايا: 20
            ),

            # شريط التقدم
            حاوية(
                حاوية(
                    نص(لنص(نسبة) + "%", حجم: 12, لون: "#FFFFFF"),
                    خلفية: لون_شريط,
                    عرض: نسبة * 4, ارتفاع: 24, زوايا: 12
                ),
                خلفية: "#333333",
                عرض: 400, ارتفاع: 24, زوايا: 12, هامش: 8
            ),

            # أزرار التحكم الرئيسية
            صف([
                زر("-5", لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                    عند_الضغط: نقصان5, عرض: 65, ارتفاع: 50, حجم_الخط: 18, زوايا: 12),
                زر("-1", لون_خلفية: ألوان["سطح"], لون_نص: ألوان["نص"],
                    عند_الضغط: نقصان, عرض: 65, ارتفاع: 50, حجم_الخط: 18, زوايا: 12),
                زر("صفر", لون_خلفية: "#F44336", لون_نص: "#FFFFFF",
                    عند_الضغط: إعادة_تعيين, عرض: 75, ارتفاع: 50, حجم_الخط: 14, زوايا: 12),
                زر("+1", لون_خلفية: ألوان["سطح"], لون_نص: ألوان["نص"],
                    عند_الضغط: زيادة, عرض: 65, ارتفاع: 50, حجم_الخط: 18, زوايا: 12),
                زر("+5", لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                    عند_الضغط: زيادة5, عرض: 65, ارتفاع: 50, حجم_الخط: 18, زوايا: 12)
            ], تباعد: 8),

            # أزرار تعيين الحد الأقصى
            حاوية(
                نص("الحد الأقصى:", حجم: 14, لون: ألوان["نص_ثانوي"]),
                حشو: 8
            ),
            صف([
                زر("30 ث", لون_خلفية: ألوان["سطح"], لون_نص: ألوان["نص"],
                    عند_الضغط: تعيين_حد_30, عرض: 80, ارتفاع: 40, حجم_الخط: 14, زوايا: 8),
                زر("60 ث", لون_خلفية: ألوان["سطح"], لون_نص: ألوان["نص"],
                    عند_الضغط: تعيين_حد_60, عرض: 80, ارتفاع: 40, حجم_الخط: 14, زوايا: 8),
                زر("120 ث", لون_خلفية: ألوان["سطح"], لون_نص: ألوان["نص"],
                    عند_الضغط: تعيين_حد_120, عرض: 80, ارتفاع: 40, حجم_الخط: 14, زوايا: 8)
            ], تباعد: 8)
        ], تباعد: 8),
        خلفية: ألوان["خلفية"],
        حشو: 16
    )
نهاية
