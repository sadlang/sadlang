# ═══════════════════════════════════════════════════════════
#  صفحة الملاحظات — محرر ملاحظات بسيط
# ═══════════════════════════════════════════════════════════

من رسومات.واجهات استورد *

# حالة الملاحظات
متغير الملاحظات = [
    "مرحباً بك في تطبيق المساعد الشخصي!",
    "لغة ص تدعم الواجهات الرسومية بالكامل.",
    "جرّب النقر على الأزرار للتفاعل مع التطبيق."
]
متغير الملاحظة_المختارة = 0

دالة اختيار0() الملاحظة_المختارة = 0 نهاية
دالة اختيار1() الملاحظة_المختارة = 1 نهاية
دالة اختيار2() الملاحظة_المختارة = 2 نهاية

صدّر دالة بناء_الملاحظات(ألوان, رجوع)
    متغير عناصر = []
    متغير ي = 0
    بينما (ي < طول(الملاحظات))
        متغير نشط = (ي == الملاحظة_المختارة)
        متغير لون_خ = ألوان["سطح"]
        متغير لون_ن = ألوان["نص"]
        إذا (نشط)
            لون_خ = ألوان["عملية"]
            لون_ن = ألوان["أساسي"]
        نهاية

        متغير دالة_اختيار = لاشيء
        إذا (ي == 0) دالة_اختيار = اختيار0 نهاية
        إذا (ي == 1) دالة_اختيار = اختيار1 نهاية
        إذا (ي == 2) دالة_اختيار = اختيار2 نهاية

        عناصر = عناصر + [زر(
            لنص(ي + 1) + ". " + الملاحظات[ي],
            لون_خلفية: لون_خ, لون_نص: لون_ن,
            عند_الضغط: دالة_اختيار,
            عرض: 450, ارتفاع: 50,
            حجم_الخط: 14, زوايا: 8
        )]
        ي = ي + 1
    نهاية

    ارجع حاوية(
        عمود([
            # الشريط العلوي
            صف([
                زر("→ رجوع", لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                    عند_الضغط: رجوع, عرض: 100, ارتفاع: 40, زوايا: 8),
                حاوية(
                    نص("📝 الملاحظات", حجم: 24, لون: ألوان["أساسي"], وزن: "عريض"),
                    حشو: 8
                )
            ], تباعد: 12),

            # عدد الملاحظات
            حاوية(
                نص(لنص(طول(الملاحظات)) + " ملاحظات",
                    حجم: 14, لون: ألوان["نص_ثانوي"]),
                حشو: 8
            ),

            # قائمة الملاحظات
            عمود(عناصر, تباعد: 6),

            # عرض الملاحظة المختارة
            حاوية(
                عمود([
                    نص("الملاحظة " + لنص(الملاحظة_المختارة + 1),
                        حجم: 18, لون: ألوان["أساسي"], وزن: "عريض"),
                    حاوية(نص(""), حشو: 4),
                    نص(الملاحظات[الملاحظة_المختارة],
                        حجم: 16, لون: ألوان["نص"])
                ]),
                خلفية: ألوان["سطح"],
                حشو: 20, هامش: 10, زوايا: 16
            )
        ], تباعد: 10),
        خلفية: ألوان["خلفية"],
        حشو: 16
    )
نهاية
