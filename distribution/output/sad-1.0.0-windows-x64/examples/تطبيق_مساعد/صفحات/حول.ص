                    نص("⚙️ إعدادات قابلة للتخصيص", حجم: 14, لون: ألوان["نص"])
                ]),
                خلفية: ألوان["سطح"],
                حشو: 20, هامش: 6, زوايا: 16
            ),

            # التقنيات
            حاوية(
                عمود([
                    نص("التقنيات المستخدمة", حجم: 18, لون: ألوان["أساسي"], وزن: "عريض"),
