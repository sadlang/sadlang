                        حجم: 14, لون: ألوان["نص"]),
                    نص("مبني بالكامل بلغة ص البرمجية العربية",
                        حجم: 14, لون: ألوان["نص"]),
                    نص("باستخدام محرك الواجهات الرسومية SDL2",
                        حجم: 14, لون: ألوان["نص"])
                ]),
                خلفية: ألوان["سطح"],
                حشو: 20, هامش: 6, زوايا: 16
            ),

            # الميزات
            حاوية(
                عمود([
                    نص("الميزات", حجم: 18, لون: ألوان["أساسي"], وزن: "عريض"),
