            حاوية(
                نص("صنع بـ ❤️ بلغة ص", حجم: 14, لون: ألوان["نص_ثانوي"]),
                حشو: 12
            )
        ], تباعد: 6),
        خلفية: ألوان["خلفية"],
        حشو: 16
