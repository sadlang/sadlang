        عمود([
            # الشريط العلوي
            صف([
                زر("→ رجوع", لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                    عند_الضغط: رجوع, عرض: 100, ارتفاع: 40, زوايا: 8),
                حاوية(
                    نص("ℹ️ حول التطبيق", حجم: 24, لون: ألوان["أساسي"], وزن: "عريض"),
                    حشو: 8
                )
            ], تباعد: 12),

            # اسم التطبيق
            حاوية(
                عمود([
                    نص("المساعد الشخصي", حجم: 32, لون: ألوان["أساسي"], وزن: "عريض"),
                    حاوية(نص(""), حشو: 4),
                    نص("الإصدار 1.0.0", حجم: 16, لون: ألوان["نص_ثانوي"])
                ]),
                خلفية: ألوان["سطح"],
                حشو: 24, هامش: 10, زوايا: 20
            ),

            # الوصف
            حاوية(
                عمود([
                    نص("عن التطبيق", حجم: 18, لون: ألوان["أساسي"], وزن: "عريض"),
