# ═══════════════════════════════════════════════════════════
#  صفحة الإعدادات — خيارات التطبيق
# ═══════════════════════════════════════════════════════════

من رسومات.واجهات استورد *

# حالة الإعدادات
متغير الوضع_الداكن = صحيح
متغير الإشعارات = صحيح
متغير الصوت = خطأ
متغير اللغة = "عربي"
متغير حجم_الخط = "متوسط"

دالة تبديل_وضع() الوضع_الداكن = ليس الوضع_الداكن نهاية
دالة تبديل_إشعارات() الإشعارات = ليس الإشعارات نهاية
دالة تبديل_صوت() الصوت = ليس الصوت نهاية

دالة تغيير_لغة()
    إذا (اللغة == "عربي")
        اللغة = "English"
    وإلا
        اللغة = "عربي"
    نهاية
نهاية

دالة تغيير_حجم()
    إذا (حجم_الخط == "صغير")
        حجم_الخط = "متوسط"
    وإلا
        إذا (حجم_الخط == "متوسط")
            حجم_الخط = "كبير"
        وإلا
            حجم_الخط = "صغير"
        نهاية
    نهاية
نهاية

دالة _بناء_خيار(عنوان, قيمة, دالة_تبديل, ألوان)
    متغير نص_القيمة = ""
    إذا (قيمة == صحيح) نص_القيمة = "✅ مفعّل" نهاية
    إذا (قيمة == خطأ) نص_القيمة = "❌ معطّل" نهاية

    ارجع حاوية(
        صف([
            نص(عنوان, حجم: 16, لون: ألوان["نص"]),
            زر(نص_القيمة,
                لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                عند_الضغط: دالة_تبديل,
                عرض: 120, ارتفاع: 36, حجم_الخط: 13, زوايا: 8)
        ], تباعد: 12),
        خلفية: ألوان["سطح"],
        حشو: 14, هامش: 4, زوايا: 12
    )
نهاية

صدّر دالة بناء_الإعدادات(ألوان, رجوع)
    ارجع حاوية(
        عمود([
            # الشريط العلوي
            صف([
                زر("→ رجوع", لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                    عند_الضغط: رجوع, عرض: 100, ارتفاع: 40, زوايا: 8),
                حاوية(
                    نص("⚙️ الإعدادات", حجم: 24, لون: ألوان["أساسي"], وزن: "عريض"),
                    حشو: 8
                )
            ], تباعد: 12),

            # المظهر
            حاوية(
                نص("— المظهر —", حجم: 16, لون: ألوان["نص_ثانوي"]),
                حشو: 8
            ),
            _بناء_خيار("الوضع الداكن", الوضع_الداكن, تبديل_وضع, ألوان),

            # الخط
            حاوية(
                صف([
                    نص("حجم الخط", حجم: 16, لون: ألوان["نص"]),
                    زر(حجم_الخط,
                        لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                        عند_الضغط: تغيير_حجم,
                        عرض: 120, ارتفاع: 36, حجم_الخط: 13, زوايا: 8)
                ], تباعد: 12),
                خلفية: ألوان["سطح"],
                حشو: 14, هامش: 4, زوايا: 12
            ),

            # اللغة
            حاوية(
                صف([
                    نص("اللغة", حجم: 16, لون: ألوان["نص"]),
                    زر(اللغة,
                        لون_خلفية: ألوان["عملية"], لون_نص: ألوان["نص"],
                        عند_الضغط: تغيير_لغة,
                        عرض: 120, ارتفاع: 36, حجم_الخط: 13, زوايا: 8)
                ], تباعد: 12),
                خلفية: ألوان["سطح"],
                حشو: 14, هامش: 4, زوايا: 12
            ),

            # الإشعارات
            حاوية(
                نص("— الإشعارات والصوت —", حجم: 16, لون: ألوان["نص_ثانوي"]),
                حشو: 8
            ),
            _بناء_خيار("الإشعارات", الإشعارات, تبديل_إشعارات, ألوان),
            _بناء_خيار("الصوت", الصوت, تبديل_صوت, ألوان),

            # معلومات
            حاوية(
                نص("الإصدار 1.0.0 — لغة ص", حجم: 12, لون: ألوان["نص_ثانوي"]),
                حشو: 16
            )
        ], تباعد: 6),
        خلفية: ألوان["خلفية"],
        حشو: 16
    )
نهاية
