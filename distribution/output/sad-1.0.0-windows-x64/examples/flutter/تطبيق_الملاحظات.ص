            )
        نهاية
        
        دالة اظهر_قائمة_سفلية(سياق، ملاحظة)
            اظهر_صفحة_سفلية_موداال(
                سياق: سياق،
                باني: دالة(سياق)
                    ارجع حاوية(
                        حشوة: حواف.كل(16)،
                        ابن: عمود(
                            حجم_رئيسي: حجم_محور.ادنى،
                            ابناء: [
                                عنصر_قائمة(
                                    قيادة: ايقونة(إذا ملاحظة.مثبتة ثم ايقونة.الغاء_تثبيت وإلا ايقونة.تثبيت)،
                                    عنوان: نص(إذا ملاحظة.مثبتة ثم "إلغاء التثبيت" وإلا "تثبيت")،
                                    عند_الضغط: دالة()
                                        خدمة_الملاحظات.ثبّت(ملاحظة.المعرف)
