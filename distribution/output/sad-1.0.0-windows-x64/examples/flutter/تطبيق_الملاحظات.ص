صنف ملاحظة
    متغير المعرف: رقم
    متغير العنوان: نص
    متغير المحتوى: نص
    متغير اللون: لون
    متغير تاريخ_الانشاء: نص
    متغير تاريخ_التعديل: نص
    متغير مثبتة: منطقي
    متغير محذوفة: منطقي
    
    باني(معرف، عنوان، محتوى)
        هذا.المعرف = معرف
        هذا.العنوان = عنوان
        هذا.المحتوى = محتوى
        هذا.اللون = الالوان.اصفر[100]
        هذا.تاريخ_الانشاء = الان()
        هذا.تاريخ_التعديل = الان()
        هذا.مثبتة = خطأ
        هذا.محذوفة = خطأ
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════════
#  خدمة الملاحظات
# ═══════════════════════════════════════════════════════════════════════════════

صنف خدمة_الملاحظات
    ساكن متغير الملاحظات: مصفوفة[ملاحظة] = []
    ساكن متغير العداد = 0
    
    ساكن دالة احصل_الكل()
        ارجع الملاحظات.فلتر(دالة(م) ارجع ليس م.محذوفة نهاية)
    نهاية
    
    ساكن دالة احصل_المثبتة()
        ارجع احصل_الكل().فلتر(دالة(م) ارجع م.مثبتة نهاية)
    نهاية
    
    ساكن دالة احصل_غير_المثبتة()
        ارجع احصل_الكل().فلتر(دالة(م) ارجع ليس م.مثبتة نهاية)
    نهاية
    
    ساكن دالة احصل_المحذوفة()
        ارجع الملاحظات.فلتر(دالة(م) ارجع م.محذوفة نهاية)
    نهاية
    
    ساكن دالة اضف(عنوان، محتوى)
        العداد = العداد + 1
        متغير ملاحظة_جديدة = جديد ملاحظة(العداد، عنوان، محتوى)
        الملاحظات.اضف(ملاحظة_جديدة)
        ارجع ملاحظة_جديدة
    نهاية
    
    ساكن دالة حدّث(معرف، عنوان، محتوى)
        لكل ملاحظة في الملاحظات
            إذا (ملاحظة.المعرف == معرف)
                ملاحظة.العنوان = عنوان
                ملاحظة.المحتوى = محتوى
                ملاحظة.تاريخ_التعديل = الان()
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية
    
    ساكن دالة احذف(معرف)
        لكل ملاحظة في الملاحظات
            إذا (ملاحظة.المعرف == معرف)
                ملاحظة.محذوفة = صحيح
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية
    
    ساكن دالة استعد(معرف)
        لكل ملاحظة في الملاحظات
            إذا (ملاحظة.المعرف == معرف)
                ملاحظة.محذوفة = خطأ
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية
    
    ساكن دالة ثبّت(معرف)
        لكل ملاحظة في الملاحظات
            إذا (ملاحظة.المعرف == معرف)
                ملاحظة.مثبتة = ليس ملاحظة.مثبتة
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية
    
    ساكن دالة غيّر_لون(معرف، لون_جديد)
        لكل ملاحظة في الملاحظات
            إذا (ملاحظة.المعرف == معرف)
                ملاحظة.اللون = لون_جديد
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية
    
    ساكن دالة بحث(كلمة)
        ارجع احصل_الكل().فلتر(دالة(م) 
            ارجع م.العنوان.يحتوي(كلمة) أو م.المحتوى.يحتوي(كلمة)
        نهاية)
    نهاية
نهاية

