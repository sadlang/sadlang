                    ]
                )
            )
        نهاية
        
        دالة بناء_شريط_التنقل(سياق)
            ارجع شريط_تنقل(
                الفهرس_الحالي: الفهرس_الحالي،
                على_تغيير: دالة(فهرس)
                    عيّن_حالة(دالة()
                        الفهرس_الحالي = فهرس
                    نهاية)
                نهاية،
                عناصر: [
