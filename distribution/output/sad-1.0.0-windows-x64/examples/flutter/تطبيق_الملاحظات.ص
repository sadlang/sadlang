                                عيّن_حالة(دالة() الفهرس_الحالي = 1 نهاية)
                                اغلق_درج(سياق)
                            نهاية
                        )،
                        فاصل()،
                        عنصر_قائمة(
                            قيادة: ايقونة(ايقونة.حذف)،
                            عنوان: نص("سلة المحذوفات")،
                            مختار: الفهرس_الحالي == 2،
                            عند_الضغط: دالة()
                                عيّن_حالة(دالة() الفهرس_الحالي = 2 نهاية)
                                اغلق_درج(سياق)
                            نهاية
                        )،
                        فاصل()،
                        عنصر_قائمة(
