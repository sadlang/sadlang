                                        )
                                    ]
                                )
                            )
                        )
                    )
                )
            )
        نهاية
        
        دالة بناء_خلفية_سحب(لون، ايقونة_نوع، محاذاة_)
            ارجع حاوية(
                لون: لون،
                محاذاة: محاذاة_،
