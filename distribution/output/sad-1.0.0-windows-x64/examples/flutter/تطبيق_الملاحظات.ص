                                عيّن_حالة(دالة() الفهرس_الحالي = 0 نهاية)
                                اغلق_درج(سياق)
                            نهاية
                        )،
                        عنصر_قائمة(
                            قيادة: ايقونة(ايقونة.تثبيت)،
                            عنوان: نص("المثبتة")،
                            مختار: الفهرس_الحالي == 1،
