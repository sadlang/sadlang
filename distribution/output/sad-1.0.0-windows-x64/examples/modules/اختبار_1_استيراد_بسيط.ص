# اختبار 1: استيراد بسيط
# يستورد وحدة رياضيات أساسية ويستخدم دوالها

من "رياضيات_أساسية" استورد جمع، طرح، ضرب، قسمة، باي

اطبع_سطر("=== اختبار الاستيراد البسيط ===")
اطبع_سطر("3 + 5 = " + جمع(3، 5))
اطبع_سطر("10 - 3 = " + طرح(10، 3))
اطبع_سطر("4 * 7 = " + ضرب(4، 7))
اطبع_سطر("20 / 4 = " + قسمة(20، 4))
اطبع_سطر("باي = " + باي)
اطبع_سطر("الاختبار نجح ✓")
