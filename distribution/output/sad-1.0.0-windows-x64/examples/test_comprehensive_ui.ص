# === معالجات الأحداث ===

دالة زيادة_العداد()
    عداد = عداد + 1
    اطبع_سطر("العداد: " + عداد)
نهاية

دالة نقصان_العداد()
    عداد = عداد - 1
    اطبع_سطر("العداد: " + عداد)
نهاية

دالة تبديل_المفتاح()
    إذا (حالة_المفتاح == "خطأ")
        حالة_المفتاح = "صحيح"
        اطبع_سطر("المفتاح: مُفعّل ✅")
    وإلا
        حالة_المفتاح = "خطأ"
        اطبع_سطر("المفتاح: مُعطّل ❌")
    نهاية
نهاية

دالة تبديل_الخانة()
    إذا (حالة_الخانة == "خطأ")
        حالة_الخانة = "صحيح"
        اطبع_سطر("الخانة: محددة ☑️")
    وإلا
        حالة_الخانة = "خطأ"
        اطبع_سطر("الخانة: غير محددة ☐")
    نهاية
نهاية

دالة تغيير_المنزلق(قيمة)
