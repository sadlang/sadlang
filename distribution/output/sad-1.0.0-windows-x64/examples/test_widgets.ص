من رسومات.واجهات استورد *

# === حالة المفتاح ===
متغير حالة_المفتاح = "خطأ"
متغير قيمة_المنزلق = 50
متغير حالة_الخانة = "خطأ"

# === معالجات الأحداث ===
دالة عند_تغيير_مفتاح()
    إذا (حالة_المفتاح == "خطأ")
        حالة_المفتاح = "صحيح"
        اطبع_سطر("المفتاح: مُفعّل ✅")
    وإلا
        حالة_المفتاح = "خطأ"
        اطبع_سطر("المفتاح: مُعطّل ❌")
    نهاية
    # تحديث الواجهة
    المفتاح._خصائص["مفعل"] = حالة_المفتاح
    حالة_نص._خصائص["محتوى"] = "المفتاح: " + حالة_المفتاح
نهاية

دالة عند_تغيير_منزلق(قيمة)
    قيمة_المنزلق = قيمة
    اطبع_سطر("المنزلق: " + قيمة)
    نص_القيمة._خصائص["محتوى"] = "القيمة: " + قيمة
نهاية

دالة عند_تغيير_خانة()
    إذا (حالة_الخانة == "خطأ")
        حالة_الخانة = "صحيح"
        اطبع_سطر("الخانة: محددة ☑️")
    وإلا
        حالة_الخانة = "خطأ"
        اطبع_سطر("الخانة: غير محددة ☐")
    نهاية
    الخانة._خصائص["مفعل"] = حالة_الخانة
    نص_الخانة._خصائص["محتوى"] = "الخانة: " + حالة_الخانة
نهاية

# === بناء الواجهة ===

# عنوان
متغير العنوان = نص("🎛️ اختبار Toggle/Slider/Checkbox")
العنوان._خصائص["حجم_الخط"] = "24"
العنوان._خصائص["لون"] = "#1565C0"
العنوان._خصائص["محاذاة"] = "وسط"

# === Toggle (مفتاح) ===
متغير المفتاح = جديد عنصر()
المفتاح._نوع = "تبديل"
المفتاح._خصائص["مفعل"] = "خطأ"
المفتاح._خصائص["عند_التغيير"] = "عند_تغيير_مفتاح"
المفتاح._خصائص["لون_نشط"] = "#4CAF50"
المفتاح._خصائص["عرض"] = "60"
المفتاح._خصائص["ارتفاع"] = "30"

متغير حالة_نص = نص("المفتاح: خطأ")
حالة_نص._خصائص["حجم_الخط"] = "16"

# === Slider (منزلق) ===
متغير المنزلق = جديد عنصر()
المنزلق._نوع = "منزلق"
المنزلق._خصائص["قيمة"] = "50"
المنزلق._خصائص["عند_التغيير"] = "عند_تغيير_منزلق"
المنزلق._خصائص["لون"] = "#2196F3"
المنزلق._خصائص["عرض"] = "300"
المنزلق._خصائص["ارتفاع"] = "30"

متغير نص_القيمة = نص("القيمة: 50")
نص_القيمة._خصائص["حجم_الخط"] = "16"

# === Checkbox (خانة اختيار) ===
متغير الخانة = جديد عنصر()
الخانة._نوع = "خانة_اختيار"
الخانة._خصائص["مفعل"] = "خطأ"
الخانة._خصائص["عند_التغيير"] = "عند_تغيير_خانة"
الخانة._خصائص["لون"] = "#FF5722"
الخانة._خصائص["عرض"] = "30"
الخانة._خصائص["ارتفاع"] = "30"

متغير نص_الخانة = نص("الخانة: خطأ")
نص_الخانة._خصائص["حجم_الخط"] = "16"

# === تجميع الواجهة ===
متغير الجذر = عمود()
الجذر._أبناء = [العنوان، المفتاح، حالة_نص، المنزلق، نص_القيمة، الخانة، نص_الخانة]
الجذر._خصائص["محاذاة"] = "وسط"
الجذر._خصائص["تباعد"] = "15"
الجذر._خصائص["حشوة"] = "40"

_محرك_واجهات(الجذر)
