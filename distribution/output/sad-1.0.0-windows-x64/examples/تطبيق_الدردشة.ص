# تطبيق الدردشة البسيط بلغة ص
# نسخة مبسطة للاختبار

اطبع_سطر("")
اطبع_سطر("╔════════════════════════════════════════╗")
اطبع_سطر("║   تطبيق الدردشة - لغة ص               ║")
اطبع_سطر("╚════════════════════════════════════════╝")
اطبع_سطر("")

# =================== صنف الرسالة ===================
صنف رسالة
    متغير المرسل
    متغير النص
    
    باني(مرسل، نص)
        هذا.المرسل = مرسل
        هذا.النص = نص
    نهاية
    
    دالة اعرض()
        اطبع_سطر("💬 " + هذا.المرسل + ": " + هذا.النص)
    نهاية
نهاية

# =================== صنف المحادثة ===================
صنف محادثة
    متغير العنوان
    متغير العدد
    
    باني(عنوان)
        هذا.العنوان = عنوان
        هذا.العدد = 0
    نهاية
    
    دالة أرسل(مرسل، نص)
        هذا.العدد = هذا.العدد + 1
        متغير ر = جديد رسالة(مرسل، نص)
        اطبع("[" + هذا.العنوان + "] ")
        ر.اعرض()
    نهاية
    
    دالة الإحصائيات()
        اطبع_سطر("📊 " + هذا.العنوان + ": " + هذا.العدد + " رسائل")
    نهاية
نهاية

# =================== التطبيق الرئيسي ===================
صنف تطبيق_دردشة
    متغير المستخدم
    
    باني(اسم)
        هذا.المستخدم = اسم
        اطبع_سطر("🚀 مرحباً " + اسم + "!")
        اطبع_سطر("")
    نهاية
    
    دالة أنشئ_محادثة(عنوان)
        اطبع_سطر("✅ إنشاء محادثة: " + عنوان)
        ارجع جديد محادثة(عنوان)
    نهاية
    
    دالة أرسل(م، نص)
        م.أرسل(هذا.المستخدم، نص)
    نهاية
نهاية

# =================== التشغيل ===================
متغير تطبيق = جديد تطبيق_دردشة("أحمد")

# إنشاء المحادثات
متغير عائلة = تطبيق.أنشئ_محادثة("العائلة")
متغير عمل = تطبيق.أنشئ_محادثة("العمل")
متغير صديق = تطبيق.أنشئ_محادثة("محمد")

اطبع_سطر("")

# محادثة العائلة
تطبيق.أرسل(عائلة، "السلام عليكم!")
عائلة.أرسل("الأم"، "وعليكم السلام يا بني")
تطبيق.أرسل(عائلة، "كيف حالكم؟")
عائلة.أرسل("الأب"، "بخير والحمد لله")

اطبع_سطر("")

# محادثة العمل
تطبيق.أرسل(عمل، "صباح الخير")
عمل.أرسل("المدير"، "صباح النور")
تطبيق.أرسل(عمل، "أنهيت المشروع")
عمل.أرسل("المدير"، "ممتاز! أحسنت")

اطبع_سطر("")

# محادثة الصديق
تطبيق.أرسل(صديق، "أهلاً!")
صديق.أرسل("محمد"، "أهلاً صديقي")
تطبيق.أرسل(صديق، "هل نلتقي اليوم؟")
صديق.أرسل("محمد"، "بالتأكيد!")

# الإحصائيات
اطبع_سطر("")
اطبع_سطر("═══════════════════════════════════════")
عائلة.الإحصائيات()
عمل.الإحصائيات()
صديق.الإحصائيات()
اطبع_سطر("═══════════════════════════════════════")

