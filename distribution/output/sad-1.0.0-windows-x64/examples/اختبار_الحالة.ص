# اختبار نظام الحالة التفاعلية

# استيراد المكتبة الكاملة
من رسومات.واجهات استورد *

# ─── متغيرات عامة (fallback قبل تهيئة الحالة) ───
متغير حالة_مهيأة = خطأ

# ─── دوال التحكم ───
دالة زيادة()
    متغير ع = اقرأ_حالة("العداد")
    عيّن_حالة("العداد", ع + 1)
    # تغيير اللون حسب القيمة
    إذا (ع + 1 > 5)
        عيّن_حالة("اللون", "#F44336")
    وإلا
        إذا (ع + 1 < 0)
            عيّن_حالة("اللون", "#2196F3")
        وإلا
            عيّن_حالة("اللون", "#4CAF50")
        نهاية
    نهاية
نهاية

دالة نقصان()
    متغير ع = اقرأ_حالة("العداد")
    عيّن_حالة("العداد", ع - 1)
    إذا (ع - 1 > 5)
        عيّن_حالة("اللون", "#F44336")
    وإلا
        إذا (ع - 1 < 0)
            عيّن_حالة("اللون", "#2196F3")
        وإلا
            عيّن_حالة("اللون", "#4CAF50")
        نهاية
    نهاية
نهاية

دالة إعادة_تعيين()
    ابدأ_تجميع()
    عيّن_حالة("العداد", 0)
    عيّن_حالة("الاسم", "لغة ص")
    عيّن_حالة("اللون", "#4CAF50")
    أنهِ_تجميع()
نهاية

# ─── دالة البناء ───
دالة بناء_الواجهة()
    # تهيئة الحالة في أول استدعاء
    إذا (حالة_مهيأة == خطأ)
        عرّف_حالة("العداد", 0)
        عرّف_حالة("الاسم", "لغة ص")
        عرّف_حالة("اللون", "#4CAF50")
        حالة_مهيأة = صحيح
    نهاية

    # قراءة الحالة
    متغير عداد = اقرأ_حالة("العداد")
    متغير اسم = اقرأ_حالة("الاسم")
    متغير لون = اقرأ_حالة("اللون")

    ارجع حاوية(
        عمود([
            # العنوان
            حاوية(
                نص("نظام الحالة التفاعلية", حجم: 28, لون: "#e94560", وزن: "عريض"),
                حشو: 20
            ),

            # عرض العداد
            حاوية(
                عمود([
                    نص("العداد", حجم: 18, لون: "#a0a0a0"),
                    نص("" + عداد, حجم: 64, لون: لون, وزن: "عريض"),
                    نص("الاسم: " + اسم, حجم: 16, لون: "#808080")
                ]),
                خلفية: "#16213e",
                حشو: 20, زوايا: 15,
                عرض: 400
            ),

            # أزرار التحكم
            صف([
                زر("زيادة",
                    لون_خلفية: "#4CAF50", لون_نص: "#ffffff",
                    عند_الضغط: زيادة,
                    حشو: 15, زوايا: 10),
                زر("نقصان",
                    لون_خلفية: "#F44336", لون_نص: "#ffffff",
                    عند_الضغط: نقصان,
                    حشو: 15, زوايا: 10),
                زر("تصفير",
                    لون_خلفية: "#FF9800", لون_نص: "#ffffff",
                    عند_الضغط: إعادة_تعيين,
                    حشو: 15, زوايا: 10)
            ], تباعد: 15, هامش: 25),

            # معلومات
            حاوية(
                نص("الحالة + التجميع الذكي + Tree Diffing", حجم: 14, لون: "#4CAF50"),
                حشو: 10
            )
        ]),
        خلفية: "#1a1a2e"
    )
نهاية

# ─── تشغيل ───
شغّل(بناء_الواجهة)
