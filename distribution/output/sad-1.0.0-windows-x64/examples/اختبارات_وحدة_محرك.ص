اطبع_سطر("── ٨. اختبارات محرك_نواة ──")

متغير محرك = جديد محرك_نواة()
محرك.تهيئة(800, 600)
تأكد(محرك.عرض_الشاشة() == 800, "عرض = 800")
تأكد(محرك.ارتفاع_الشاشة() == 600, "ارتفاع = 600")
تأكد(محرك.مهيأ() == صحيح, "مهيأ = صحيح")
