# ===================================================================
# اختبارات وحدة محرك الرسم — Unit Tests for Rendering Engine
# ===================================================================
# تغطي: أحداث، خطوط، واجهة_محرك، مدير_نوافذ، طابور_أحداث
# ===================================================================

استورد * من رسومات.محرك.واجهة_محرك
استورد * من رسومات.محرك.محرك_نواة
استورد * من رسومات.محرك.مدير_نوافذ
استورد * من رسومات.محرك.أحداث
استورد * من رسومات.رسم.لوحة

متغير _نجاح = 0
متغير _فشل = 0

دالة تأكد(شرط, رسالة)
    إذا (شرط)
        _نجاح = _نجاح + 1
    وإلا
        _فشل = _فشل + 1
        اطبع_سطر("  ✗ فشل: " + رسالة)
    نهاية
نهاية

# ===================================================================
# ١. اختبارات الثوابت
# ===================================================================
اطبع_سطر("── ١. اختبارات الثوابت ──")

تأكد(حدث_لا_شيء == 0, "حدث_لا_شيء = 0")
تأكد(حدث_ضغط_مفتاح == 1, "حدث_ضغط_مفتاح = 1")
تأكد(حدث_رفع_مفتاح == 2, "حدث_رفع_مفتاح = 2")
تأكد(حدث_حركة_فأرة == 3, "حدث_حركة_فأرة = 3")
تأكد(حدث_ضغط_فأرة == 4, "حدث_ضغط_فأرة = 4")
تأكد(حدث_رفع_فأرة == 5, "حدث_رفع_فأرة = 5")
تأكد(حدث_تمرير_فأرة == 6, "حدث_تمرير_فأرة = 6")
تأكد(حدث_إغلاق == 7, "حدث_إغلاق = 7")
تأكد(حدث_تغيير_حجم == 8, "حدث_تغيير_حجم = 8")
تأكد(زر_يسار == 1, "زر_يسار = 1")
تأكد(زر_يمين == 2, "زر_يمين = 2")
تأكد(زر_وسط == 4, "زر_وسط = 4")
تأكد(مفتاح_هروب == 27, "مفتاح_هروب = 27")
تأكد(مفتاح_إدخال == 13, "مفتاح_إدخال = 13")
تأكد(مفتاح_مسافة == 32, "مفتاح_مسافة = 32")
تأكد(مفتاح_ف1 == 282, "مفتاح_ف1 = 282")
تأكد(مفتاح_ف12 == 293, "مفتاح_ف12 = 293")
اطبع_سطر("  ✓ ثوابت الأحداث")

# ===================================================================
# ٢. اختبارات صنف حدث
# ===================================================================
اطبع_سطر("── ٢. اختبارات صنف حدث ──")

متغير ح1 = جديد حدث(5)
تأكد(ح1.نوع == 5, "حدث.نوع = 5")
تأكد(ح1.وقت == 0, "حدث.وقت = 0")

متغير ح2 = جديد حدث()
تأكد(ح2.نوع == 0, "حدث() افتراضي نوع = 0")
اطبع_سطر("  ✓ صنف حدث")

# ===================================================================
# ٣. اختبارات حدث_مفتاح
# ===================================================================
اطبع_سطر("── ٣. اختبارات حدث_مفتاح ──")

متغير مف1 = جديد حدث_مفتاح(حدث_ضغط_مفتاح, مفتاح_إدخال)
تأكد(مف1.نوع == حدث_ضغط_مفتاح, "مفتاح.نوع = ضغط")
تأكد(مف1.كود == 13, "مفتاح.كود = 13")
تأكد(مف1.حرف == "", "مفتاح.حرف افتراضي")
تأكد(مف1.شيفت == خطأ, "مفتاح.شيفت افتراضي")
تأكد(مف1.كنترول == خطأ, "مفتاح.كنترول افتراضي")
تأكد(مف1.ألت == خطأ, "مفتاح.ألت افتراضي")

متغير مف2 = جديد حدث_مفتاح(حدث_ضغط_مفتاح, 65, "A", صحيح, صحيح, خطأ)
تأكد(مف2.شيفت == صحيح, "مفتاح مع شيفت")
تأكد(مف2.كنترول == صحيح, "مفتاح مع كنترول")
تأكد(مف2.ألت == خطأ, "مفتاح بدون ألت")
تأكد(مف2.حرف == "A", "مفتاح.حرف = A")
اطبع_سطر("  ✓ صنف حدث_مفتاح")

# ===================================================================
# ٤. اختبارات حدث_فأرة
# ===================================================================
اطبع_سطر("── ٤. اختبارات حدث_فأرة ──")

متغير فأ1 = جديد حدث_فأرة(حدث_حركة_فأرة, 320, 240)
تأكد(فأ1.نوع == حدث_حركة_فأرة, "فأرة.نوع = حركة")
تأكد(فأ1.س == 320, "فأرة.س = 320")
تأكد(فأ1.ص == 240, "فأرة.ص = 240")
تأكد(فأ1.زر == 0, "فأرة.زر افتراضي = 0")
تأكد(فأ1.تمرير_دلتا == 0, "فأرة.تمرير افتراضي = 0")

متغير فأ2 = جديد حدث_فأرة(حدث_ضغط_فأرة, 100, 50, زر_يسار)
تأكد(فأ2.نوع == حدث_ضغط_فأرة, "فأرة.نوع = ضغط")
تأكد(فأ2.زر == زر_يسار, "فأرة.زر = يسار")

متغير فأ3 = جديد حدث_فأرة(حدث_تمرير_فأرة, 0, 0, 0, 3)
تأكد(فأ3.تمرير_دلتا == 3, "فأرة.تمرير = 3")
اطبع_سطر("  ✓ صنف حدث_فأرة")

# ===================================================================
# ٥. اختبارات طابور_أحداث — عمليات أساسية
# ===================================================================
اطبع_سطر("── ٥. اختبارات طابور_أحداث ──")

متغير ط = جديد طابور_أحداث()
تأكد(ط.فارغ() == صحيح, "طابور جديد فارغ")
تأكد(ط.الحجم() == 0, "طابور جديد حجم = 0")
تأكد(ط.التالي() == لاشيء, "طابور فارغ التالي = لاشيء")

# إضافة عناصر
ط.أضف(جديد حدث(1))
ط.أضف(جديد حدث(2))
ط.أضف(جديد حدث(3))
تأكد(ط.فارغ() == خطأ, "طابور غير فارغ بعد الإضافة")
تأكد(ط.الحجم() == 3, "طابور حجم = 3")
اطبع_سطر("  ✓ إضافة عناصر")

# إلقاء نظرة (peek)
متغير أول = ط.الأول()
تأكد(أول.نوع == 1, "الأول يُرجع أول عنصر")
تأكد(ط.الحجم() == 3, "الأول لا يزيل العنصر")
اطبع_سطر("  ✓ إلقاء نظرة")

# استهلاك بالترتيب (FIFO)
متغير أ1 = ط.التالي()
متغير أ2 = ط.التالي()
متغير أ3 = ط.التالي()
تأكد(أ1.نوع == 1, "FIFO: أول = 1")
تأكد(أ2.نوع == 2, "FIFO: ثاني = 2")
تأكد(أ3.نوع == 3, "FIFO: ثالث = 3")
تأكد(ط.فارغ() == صحيح, "فارغ بعد استهلاك الكل")
اطبع_سطر("  ✓ FIFO ترتيب")

# ===================================================================
# ٦. اختبارات طابور_أحداث — تصفية
# ===================================================================
اطبع_سطر("── ٦. تصفية الأحداث ──")

متغير ط2 = جديد طابور_أحداث()
ط2.أضف(جديد حدث_مفتاح(حدث_ضغط_مفتاح, 65))
ط2.أضف(جديد حدث_فأرة(حدث_حركة_فأرة, 10, 20))
ط2.أضف(جديد حدث_مفتاح(حدث_ضغط_مفتاح, 66))
ط2.أضف(جديد حدث_فأرة(حدث_ضغط_فأرة, 30, 40, زر_يسار))
ط2.أضف(جديد حدث_مفتاح(حدث_رفع_مفتاح, 65))

متغير ضغطات = ط2.تصفية(حدث_ضغط_مفتاح)
تأكد(ضغطات.طول() == 2, "تصفية: 2 ضغطات مفتاح")

متغير حركات = ط2.تصفية(حدث_حركة_فأرة)
تأكد(حركات.طول() == 1, "تصفية: 1 حركة فأرة")

متغير رفع = ط2.تصفية(حدث_رفع_مفتاح)
تأكد(رفع.طول() == 1, "تصفية: 1 رفع مفتاح")

متغير إغلاق = ط2.تصفية(حدث_إغلاق)
تأكد(إغلاق.طول() == 0, "تصفية: 0 أحداث إغلاق")
اطبع_سطر("  ✓ تصفية الأحداث")

# ===================================================================
# ٧. اختبارات طابور_أحداث — مسح
# ===================================================================
اطبع_سطر("── ٧. مسح الطابور ──")

متغير ط3 = جديد طابور_أحداث()
ط3.أضف(جديد حدث(1))
ط3.أضف(جديد حدث(2))
تأكد(ط3.الحجم() == 2, "قبل المسح: حجم = 2")
ط3.مسح()
تأكد(ط3.فارغ() == صحيح, "بعد المسح: فارغ")
تأكد(ط3.الحجم() == 0, "بعد المسح: حجم = 0")
اطبع_سطر("  ✓ مسح الطابور")

