# ===================================================================
# ١٣. اختبارات مدير النوافذ
# ===================================================================
اطبع_سطر("── ١٣. اختبارات مدير_نوافذ ──")

متغير محرك3 = جديد محرك_نواة()
محرك3.تهيئة(1024, 768)
متغير مدير = جديد مدير_نوافذ(محرك3)
تأكد(مدير != لاشيء, "إنشاء مدير_نوافذ")

متغير ن1 = مدير.أنشئ_نافذة("نافذة ١", 10, 10, 300, 200)
تأكد(ن1.عنوان == "نافذة ١", "نافذة.عنوان")
تأكد(ن1.س == 10, "نافذة.س = 10")
تأكد(ن1.ص == 10, "نافذة.ص = 10")
تأكد(ن1.عرض == 300, "نافذة.عرض = 300")
تأكد(ن1.ارتفاع == 200, "نافذة.ارتفاع = 200")

متغير ن2 = مدير.أنشئ_نافذة("نافذة ٢", 50, 50, 400, 300)
تأكد(ن2.عنوان == "نافذة ٢", "نافذة ثانية")
اطبع_سطر("  ✓ مدير النوافذ")

