# ===================================================================
اطبع_سطر("── ١٢. اختبارات Canvas ──")

متغير لوحة = جديد لوحة_رسم(640, 480)
تأكد(لوحة != لاشيء, "إنشاء لوحة_رسم")

متغير فرشاة = جديد فرشاة()
