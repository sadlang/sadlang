اطبع_سطر("── ١١. تحويل الألوان ──")

متغير أحمر = لون_من_مكونات(255, 0, 0)
# ARGB: Alpha=255(0xFF000000) + Red=255(0xFF0000) = 4294901760
تأكد(أحمر == 4294901760, "لون أحمر ARGB")

متغير أبيض = لون_من_مكونات(255, 255, 255)
تأكد(لون_أحمر(أبيض) == 255, "استخراج أحمر = 255")
تأكد(لون_أخضر(أبيض) == 255, "استخراج أخضر = 255")
تأكد(لون_أزرق(أبيض) == 255, "استخراج أزرق = 255")

متغير لون_اختبار = لون_من_مكونات(128, 64, 32)
تأكد(لون_أحمر(لون_اختبار) == 128, "استخراج أحمر = 128")
تأكد(لون_أخضر(لون_اختبار) == 64, "استخراج أخضر = 64")
تأكد(لون_أزرق(لون_اختبار) == 32, "استخراج أزرق = 32")
