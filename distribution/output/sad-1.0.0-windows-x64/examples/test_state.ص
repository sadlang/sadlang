# بسم الله الرحمن الرحيم
# ===================================================================
# اختبار: نظام إدارة الحالة التفاعلي
# ===================================================================
# يختبر أن تغيير خصائص العنصر عبر handler يُحدّث الواجهة

من رسومات.واجهات استورد *

# ─── متغيرات عامة ───
متغير العداد = 0

# ─── العنصر الجذري (مبدئياً) ───
متغير عنوان_العداد = نص(محتوى: "العداد: 0", حجم: 32, لون: "#333333")

# ─── دوال الأحداث (يجب تعريفها قبل استخدامها) ───

دالة حدد_لون_العداد()
    إذا (العداد > 0)
        ارجع "#4CAF50"
    وإلا
        إذا (العداد < 0)
            ارجع "#F44336"
        وإلا
            ارجع "#333333"
        نهاية
    نهاية
نهاية

دالة عند_زيادة()
    العداد = العداد + 1
    اطبع_سطر("✓ العداد = " + العداد)
    عنوان_العداد.عيّن("محتوى", "العداد: " + العداد)
    عنوان_العداد.عيّن("لون", حدد_لون_العداد())
نهاية

دالة عند_نقص()
    العداد = العداد - 1
    اطبع_سطر("✓ العداد = " + العداد)
    عنوان_العداد.عيّن("محتوى", "العداد: " + العداد)
    عنوان_العداد.عيّن("لون", حدد_لون_العداد())
نهاية

دالة عند_تصفير()
    العداد = 0
    اطبع_سطر("✓ تم التصفير")
    عنوان_العداد.عيّن("محتوى", "العداد: 0")
    عنوان_العداد.عيّن("لون", "#333333")
نهاية

# ─── بناء الواجهة ───
متغير الجذر = عمود(
    نص(محتوى: "🧪 اختبار إدارة الحالة", حجم: 28, لون: "#1565C0"),
    نص(محتوى: "اضغط الأزرار لتغيير العداد", حجم: 14, لون: "#666666"),
    عنوان_العداد,
    صف(
        زر("زد +1", لون_خلفية: "#4CAF50", لون_نص: "#FFFFFF", عند_الضغط: عند_زيادة),
        زر("أنقص -1", لون_خلفية: "#F44336", لون_نص: "#FFFFFF", عند_الضغط: عند_نقص),
        زر("صفّر", لون_خلفية: "#FF9800", لون_نص: "#FFFFFF", عند_الضغط: عند_تصفير)
    ),
    نص(محتوى: "إذا تغيّر الرقم فالحالة التفاعلية تعمل ✓", حجم: 12, لون: "#999999")
)

# ─── تشغيل الواجهة ───
اطبع_سطر("=== بدء اختبار إدارة الحالة ===")
_محرك_واجهات(الجذر)
اطبع_سطر("=== انتهى ===")
