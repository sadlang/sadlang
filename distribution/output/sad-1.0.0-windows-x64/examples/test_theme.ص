من رسومات.واجهات استورد *

# === اختبار نظام الثيم (الوضع الداكن / الفاتح) ===

# === معالجات الأحداث ===
دالة عند_تبديل_الثيم()
    تبديل_الثيم()
    إذا (هل_داكن())
        اطبع_سطر("🌙 تم التبديل للوضع الداكن")
    وإلا
        اطبع_سطر("☀️ تم التبديل للوضع الفاتح")
    نهاية
نهاية

دالة عند_الضغط()
    اطبع_سطر("تم الضغط على الزر ✅")
نهاية

# === بناء الواجهة ===

# عنوان
متغير العنوان = نص("🎨 اختبار نظام الثيم")
العنوان._خصائص["حجم_الخط"] = "28"
العنوان._خصائص["لون"] = "أساسي"
العنوان._خصائص["محاذاة"] = "وسط"

# وصف
متغير الوصف = نص("اضغط الزر لتبديل الوضع الداكن/الفاتح")
الوصف._خصائص["حجم_الخط"] = "16"
الوصف._خصائص["محاذاة"] = "وسط"

# زر تبديل الثيم
متغير زر_الثيم = جديد عنصر()
زر_الثيم._نوع = "زر"
زر_الثيم._خصائص["نص"] = "🌓 تبديل الثيم"
زر_الثيم._خصائص["عند_الضغط"] = "عند_تبديل_الثيم"
زر_الثيم._خصائص["لون_خلفية"] = "#6200EA"
زر_الثيم._خصائص["لون_نص"] = "#FFFFFF"
زر_الثيم._خصائص["عرض"] = "250"
زر_الثيم._خصائص["ارتفاع"] = "50"
زر_الثيم._خصائص["حجم_الخط"] = "18"

# زر عادي للاختبار
متغير زر_عادي = جديد عنصر()
زر_عادي._نوع = "زر"
زر_عادي._خصائص["نص"] = "زر عادي"
زر_عادي._خصائص["عند_الضغط"] = "عند_الضغط"
زر_عادي._خصائص["عرض"] = "200"
زر_عادي._خصائص["ارتفاع"] = "45"
زر_عادي._خصائص["حجم_الخط"] = "16"

# نص إضافي
متغير نص_معلومات = نص("هذا النص يتغير لونه مع الثيم")
نص_معلومات._خصائص["حجم_الخط"] = "14"
نص_معلومات._خصائص["محاذاة"] = "وسط"

# Toggle
متغير مفتاح = جديد عنصر()
مفتاح._نوع = "تبديل"
مفتاح._خصائص["مفعل"] = "خطأ"
مفتاح._خصائص["لون_نشط"] = "#4CAF50"
مفتاح._خصائص["عرض"] = "60"
مفتاح._خصائص["ارتفاع"] = "30"

# حقل إدخال
متغير حقل = جديد عنصر()
حقل._نوع = "حقل_نص"
حقل._خصائص["تلميح"] = "اكتب هنا..."
حقل._خصائص["عرض"] = "300"
حقل._خصائص["ارتفاع"] = "45"

# === تجميع الواجهة ===
متغير الجذر = عمود()
الجذر._أبناء = [العنوان، الوصف، زر_الثيم، زر_عادي، نص_معلومات، مفتاح، حقل]
الجذر._خصائص["محاذاة"] = "وسط"
الجذر._خصائص["تباعد"] = "20"
الجذر._خصائص["حشوة"] = "40"

_محرك_واجهات(الجذر)
