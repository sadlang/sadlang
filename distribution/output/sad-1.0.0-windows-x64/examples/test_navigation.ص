# === صفحة التفاصيل ===
دالة صفحة_التفاصيل()
    متغير زر_عودة = زر("🔙 العودة")
    زر_عودة._خصائص["عند_الضغط"] = "عند_عودة"
    زر_عودة._خصائص["لون_الخلفية"] = "#FF5722"
    زر_عودة._خصائص["لون_النص"] = "#FFFFFF"
    زر_عودة._خصائص["عرض"] = "200"
    زر_عودة._خصائص["ارتفاع"] = "50"
    زر_عودة._خصائص["حجم_الخط"] = "18"

    متغير عنوان = نص("📄 صفحة التفاصيل")
    عنوان._خصائص["حجم_الخط"] = "28"
    عنوان._خصائص["لون"] = "#1565C0"
    عنوان._خصائص["محاذاة"] = "وسط"

    متغير وصف = نص("هذه صفحة التفاصيل — تم الانتقال بنجاح!")
    وصف._خصائص["حجم_الخط"] = "16"
    وصف._خصائص["لون"] = "#555555"

    متغير عمود_محتوى = عمود()
    عمود_محتوى._أبناء = [عنوان، وصف، زر_عودة]
    عمود_محتوى._خصائص["محاذاة"] = "وسط"
    عمود_محتوى._خصائص["تباعد"] = "20"
    عمود_محتوى._خصائص["حشوة"] = "40"

    ارجع عمود_محتوى
نهاية

