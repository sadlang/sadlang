# ═══ صنف الشكل الهندسي ═══
صنف شكل_هندسي
    باني(الاسم، اللون)
        هذا.الاسم = الاسم
        هذا.اللون = اللون
    نهاية
    
    دالة وصف()
        ارجع هذا.الاسم + " بلون " + هذا.اللون
    نهاية
    
    دالة المساحة()
        ارجع 0
    نهاية
    
    دالة اطبع_معلومات()
        اطبع_سطر("  📐 " + هذا.وصف() + " — المساحة: " + هذا.المساحة())
    نهاية
نهاية

# ═══ أصناف فرعية ═══
صنف مستطيل يرث شكل_هندسي
    باني(العرض، الارتفاع، اللون)
        الأساس.باني("مستطيل"، اللون)
        هذا.العرض = العرض
        هذا.الارتفاع = الارتفاع
    نهاية
    
    دالة المساحة()
        ارجع هذا.العرض * هذا.الارتفاع
    نهاية
    
    دالة المحيط()
        ارجع 2 * (هذا.العرض + هذا.الارتفاع)
    نهاية
نهاية

صنف دائرة يرث شكل_هندسي
    باني(نصف_القطر، اللون)
        الأساس.باني("دائرة"، اللون)
        هذا.نصف_القطر = نصف_القطر
    نهاية
    
    دالة المساحة()
        ارجع 3.14159 * هذا.نصف_القطر * هذا.نصف_القطر
    نهاية
    
    دالة المحيط()
        ارجع 2 * 3.14159 * هذا.نصف_القطر
    نهاية
نهاية

صنف مثلث يرث شكل_هندسي
    باني(القاعدة، الارتفاع، اللون)
        الأساس.باني("مثلث"، اللون)
        هذا.القاعدة = القاعدة
        هذا.الارتفاع = الارتفاع
    نهاية
    
    دالة المساحة()
        ارجع هذا.القاعدة * هذا.الارتفاع / 2
    نهاية
نهاية

