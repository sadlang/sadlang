# ═══ صنف الحساب البنكي ═══
اطبع_سطر("")
اطبع_سطر("🏦 الحساب البنكي:")
اطبع_سطر("─────────────────────────────")

صنف حساب_بنكي
    باني(صاحب_الحساب، الرصيد_الأولي)
        هذا.الصاحب = صاحب_الحساب
        هذا.الرصيد = الرصيد_الأولي
        هذا.السجل = []
    نهاية
    
    دالة إيداع(المبلغ)
        إذا (المبلغ > 0)
            هذا.الرصيد = هذا.الرصيد + المبلغ
            أضف(هذا.السجل، "إيداع +" + المبلغ)
            اطبع_سطر("  💰 إيداع " + المبلغ + " — الرصيد: " + هذا.الرصيد)
        نهاية
    نهاية
    
    دالة سحب(المبلغ)
        إذا (المبلغ > هذا.الرصيد)
            اطبع_سطر("  ⚠️ رصيد غير كافٍ!")
            ارجع خطأ
        نهاية
        هذا.الرصيد = هذا.الرصيد - المبلغ
        أضف(هذا.السجل، "سحب -" + المبلغ)
        اطبع_سطر("  💸 سحب " + المبلغ + " — الرصيد: " + هذا.الرصيد)
        ارجع صحيح
    نهاية
    
    دالة كشف_حساب()
        اطبع_سطر("")
        اطبع_سطر("  ╔══════════════════════════╗")
        اطبع_سطر("  ║     كشف حساب             ║")
        اطبع_سطر("  ╚══════════════════════════╝")
        اطبع_سطر("  الاسم:   " + هذا.الصاحب)
        اطبع_سطر("  الرصيد:  " + هذا.الرصيد)
        اطبع_سطر("  العمليات: " + طول(هذا.السجل))
        لكل عملية في هذا.السجل
            اطبع_سطر("    → " + عملية)
        نهاية
    نهاية
نهاية

متغير حسابي = جديد حساب_بنكي("أحمد محمد"، 1000)
حسابي.إيداع(500)
حسابي.إيداع(250)
حسابي.سحب(300)
حسابي.سحب(2000)
حسابي.سحب(100)
حسابي.كشف_حساب()

# ═══ صنف الطالب ═══
اطبع_سطر("")
اطبع_سطر("🎓 نظام الطلاب:")
اطبع_سطر("─────────────────────────────")

صنف طالب
    باني(الاسم)
        هذا.الاسم = الاسم
        هذا.الدرجات = []
    نهاية
    
    دالة أضف_درجة(المادة، الدرجة)
        أضف(هذا.الدرجات، الدرجة)
        اطبع_سطر("  📝 " + هذا.الاسم + " — " + المادة + ": " + الدرجة)
    نهاية
    
    دالة المعدل()
        إذا (طول(هذا.الدرجات) == 0)
            ارجع 0
        نهاية
        متغير المجموع = 0
        لكل درجة في هذا.الدرجات
            المجموع = المجموع + درجة
        نهاية
        ارجع المجموع / طول(هذا.الدرجات)
    نهاية
    
    دالة التقدير()
        متغير م = هذا.المعدل()
        إذا (م >= 90)
            ارجع "ممتاز 🌟"
        وإلا
            إذا (م >= 80)
                ارجع "جيد جداً ✅"
            وإلا
                إذا (م >= 70)
                    ارجع "جيد 📗"
                وإلا
                    ارجع "مقبول 📙"
                نهاية
            نهاية
        نهاية
    نهاية
نهاية

