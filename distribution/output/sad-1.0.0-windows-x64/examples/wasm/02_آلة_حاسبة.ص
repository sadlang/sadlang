# المتوسط الحسابي
دالة متوسط_حسابي(الأعداد)
    متغير المجموع = 0
    لكل ع في الأعداد
        المجموع = المجموع + ع
    نهاية
    ارجع المجموع / طول(الأعداد)
نهاية

متغير الأرقام = [15، 23، 42، 8، 31، 56، 19]
اطبع_سطر("  متوسط " + الأرقام + " = " + متوسط_حسابي(الأرقام))

