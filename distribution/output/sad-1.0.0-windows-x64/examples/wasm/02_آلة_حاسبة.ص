# العمليات الحسابية
دالة جمع(أ، ب)
    ارجع أ + ب
نهاية

دالة طرح(أ، ب)
    ارجع أ - ب
نهاية

دالة ضرب(أ، ب)
    ارجع أ * ب
نهاية

دالة قسمة(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("⚠️ خطأ: لا يمكن القسمة على صفر!")
        ارجع 0
    نهاية
    ارجع أ / ب
نهاية

دالة باقي(أ، ب)
    إذا (ب == 0)
        ارجع 0
    نهاية
    ارجع أ % ب
نهاية

دالة رفع_أس(أ، ب)
    متغير النتيجة = 1
    متغير ع = 0
    بينما (ع < ب)
        النتيجة = النتيجة * أ
        ع = ع + 1
    نهاية
    ارجع النتيجة
نهاية

