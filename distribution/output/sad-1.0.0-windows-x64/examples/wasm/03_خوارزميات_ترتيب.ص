دالة بحث_ثنائي(المصفوفة، الهدف)
    متغير بداية = 0
    متغير نهاية_بحث = طول(المصفوفة) - 1
    
    بينما (بداية <= نهاية_بحث)
        متغير _مج = بداية + نهاية_بحث
        متغير المنتصف = (_مج - _مج % 2) / 2
        
        إذا (المصفوفة[المنتصف] == الهدف)
            ارجع المنتصف
        وإلا
            إذا (المصفوفة[المنتصف] < الهدف)
                بداية = المنتصف + 1
            وإلا
                نهاية_بحث = المنتصف - 1
            نهاية
        نهاية
    نهاية
    
    ارجع -1
نهاية

