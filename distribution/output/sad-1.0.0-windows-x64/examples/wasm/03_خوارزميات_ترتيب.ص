# دالة طباعة مصفوفة
دالة اطبع_مصفوفة(الاسم، المصفوفة)
    اطبع("  " + الاسم + ": [")
    متغير ع = 0
    بينما (ع < طول(المصفوفة))
        إذا (ع > 0)
            اطبع("، ")
        نهاية
        اطبع(المصفوفة[ع])
        ع = ع + 1
    نهاية
    اطبع_سطر("]")
نهاية

# نسخ مصفوفة
دالة انسخ(المصفوفة)
    متغير النسخة = []
    لكل عنصر في المصفوفة
        أضف(النسخة، عنصر)
    نهاية
    ارجع النسخة
نهاية

# ═══ ترتيب الفقاعات ═══
دالة ترتيب_فقاعات(المصفوفة)
    متغير ن = طول(المصفوفة)
    متغير ت = 0
    بينما (ت < ن - 1)
        متغير ج = 0
        بينما (ج < ن - ت - 1)
            إذا (المصفوفة[ج] > المصفوفة[ج + 1])
                # تبديل
                متغير مؤقت = المصفوفة[ج]
                المصفوفة[ج] = المصفوفة[ج + 1]
                المصفوفة[ج + 1] = مؤقت
            نهاية
            ج = ج + 1
        نهاية
        ت = ت + 1
    نهاية
    ارجع المصفوفة
نهاية

# ═══ ترتيب الاختيار ═══
دالة ترتيب_اختيار(المصفوفة)
    متغير ن = طول(المصفوفة)
    متغير ت = 0
    بينما (ت < ن - 1)
        متغير أصغر_فهرس = ت
        متغير ج = ت + 1
        بينما (ج < ن)
            إذا (المصفوفة[ج] < المصفوفة[أصغر_فهرس])
                أصغر_فهرس = ج
            نهاية
            ج = ج + 1
        نهاية
        إذا (أصغر_فهرس != ت)
            متغير مؤقت = المصفوفة[ت]
            المصفوفة[ت] = المصفوفة[أصغر_فهرس]
            المصفوفة[أصغر_فهرس] = مؤقت
        نهاية
        ت = ت + 1
    نهاية
    ارجع المصفوفة
نهاية

# ═══ ترتيب الإدراج ═══
دالة ترتيب_إدراج(المصفوفة)
    متغير ن = طول(المصفوفة)
    متغير ت = 1
    بينما (ت < ن)
        متغير المفتاح = المصفوفة[ت]
        متغير ج = ت - 1
        بينما (ج >= 0 و المصفوفة[ج] > المفتاح)
            المصفوفة[ج + 1] = المصفوفة[ج]
            ج = ج - 1
        نهاية
        المصفوفة[ج + 1] = المفتاح
        ت = ت + 1
    نهاية
    ارجع المصفوفة
نهاية

