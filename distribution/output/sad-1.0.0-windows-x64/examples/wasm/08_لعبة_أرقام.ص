# ═══ محرك الأرقام العشوائية البسيط ═══
متغير البذرة = 42

دالة عشوائي_بسيط(الحد)
    البذرة = (البذرة * 1103515245 + 12345) % 2147483648
    إذا (البذرة < 0)
        البذرة = البذرة * -1
    نهاية
    ارجع البذرة % الحد
نهاية

# ═══ لعبة 1: تخمين الرقم ═══
اطبع_سطر("")
اطبع_سطر("🎯 اللعبة 1: تخمين الرقم (محاكاة)")
اطبع_سطر("─────────────────────────────")

دالة العب_تخمين()
    متغير الرقم_السري = عشوائي_بسيط(100) + 1
    متغير المحاولات = 0
    متغير التخمينات = []
    
    # محاكاة تخمينات ذكية (بحث ثنائي)
    متغير أدنى = 1
    متغير أعلى = 100
    متغير وجد = خطأ
    
    بينما (ليس وجد و المحاولات < 10)
        متغير التخمين = (أدنى + أعلى) / 2
        المحاولات = المحاولات + 1
        أضف(التخمينات، التخمين)
        
        إذا (التخمين == الرقم_السري)
            وجد = صحيح
            اطبع_سطر("  🎉 تم التخمين! الرقم هو " + الرقم_السري + " في " + المحاولات + " محاولات")
        وإلا
            إذا (التخمين < الرقم_السري)
                اطبع_سطر("  محاولة " + المحاولات + ": " + التخمين + " ← أكبر ⬆️")
                أدنى = التخمين + 1
            وإلا
                اطبع_سطر("  محاولة " + المحاولات + ": " + التخمين + " ← أصغر ⬇️")
                أعلى = التخمين - 1
            نهاية
        نهاية
    نهاية
    
    اطبع_سطر("  📋 التخمينات: " + التخمينات)
نهاية

العب_تخمين()

# ═══ لعبة 2: فك الشفرة ═══
اطبع_سطر("")
