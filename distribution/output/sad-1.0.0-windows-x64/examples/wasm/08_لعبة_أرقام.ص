دالة سلسلة_عددية(البداية، الفارق، العدد)
    متغير السلسلة = []
    متغير القيمة = البداية
    متغير ع = 0
    بينما (ع < العدد)
        أضف(السلسلة، القيمة)
        القيمة = القيمة + الفارق
        ع = ع + 1
    نهاية
    ارجع السلسلة
نهاية

دالة سلسلة_هندسية(البداية، النسبة، العدد)
    متغير السلسلة = []
    متغير القيمة = البداية
    متغير ع = 0
    بينما (ع < العدد)
        أضف(السلسلة، القيمة)
        القيمة = القيمة * النسبة
        ع = ع + 1
    نهاية
    ارجع السلسلة
نهاية

