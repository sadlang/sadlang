دالة هل_أولي(ن)
    إذا (ن < 2)
        ارجع خطأ
    نهاية
    متغير ق = 2
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            ارجع خطأ
        نهاية
        ق = ق + 1
    نهاية
    ارجع صحيح
نهاية

دالة هل_كامل(ن)
    متغير المجموع = 0
    متغير ق = 1
    بينما (ق < ن)
        إذا (ن % ق == 0)
            المجموع = المجموع + ق
        نهاية
        ق = ق + 1
    نهاية
    ارجع المجموع == ن
نهاية

