دالة فك_شفرة()
    # كلمات مشفرة
    متغير الكلمات = ["برمجة"، "حاسوب"، "خوارزم"، "بيانات"، "شبكة"]
    متغير التلميحات = [
        "كتابة تعليمات للحاسوب"،
        "جهاز إلكتروني للحساب"،
        "خطوات منظمة لحل مشكلة"،
        "معلومات مخزنة رقمياً"،
        "ربط أجهزة ببعضها"
    ]
    
    متغير النقاط = 0
    متغير ع = 0
    
    بينما (ع < طول(الكلمات))
        متغير الكلمة = الكلمات[ع]
        متغير التلميح = التلميحات[ع]
        
        # إخفاء الكلمة
        متغير مخفية = ""
        متغير ح = 0
        بينما (ح < طول(الكلمة))
            إذا (ح == 0 أو ح == طول(الكلمة) - 1)
                مخفية = مخفية + الكلمة[ح]
            وإلا
                مخفية = مخفية + "▒"
            نهاية
            ح = ح + 1
        نهاية
        
        اطبع_سطر("  ❓ " + مخفية + " — " + التلميح)
        اطبع_سطر("     الجواب: " + الكلمة + " ✅")
        النقاط = النقاط + 10
        ع = ع + 1
    نهاية
    
    اطبع_سطر("  🏆 النقاط: " + النقاط + "/" + (طول(الكلمات) * 10))
نهاية

فك_شفرة()

