# ═══ القسم 1: مصفوفة الضرب ═══
اطبع_سطر("")
اطبع_سطر("🧮 مصفوفة ضرب 5×5:")
اطبع_سطر("─────────────────────────────")

متغير ع = 1
بينما (ع <= 5)
    متغير سطر = "  "
    متغير ع2 = 1
    بينما (ع2 <= 5)
        متغير ناتج = ع * ع2
        إذا (ناتج < 10)
            سطر = سطر + " " + ناتج + " "
        وإلا
            سطر = سطر + ناتج + " "
        نهاية
        ع2 = ع2 + 1
    نهاية
    اطبع_سطر(سطر)
    ع = ع + 1
نهاية

# ═══ القسم 2: متتالية فيبوناتشي المتقدمة ═══
اطبع_سطر("")
اطبع_سطر("🌀 متتالية فيبوناتشي (أول 20):")
اطبع_سطر("─────────────────────────────")

دالة فيبوناتشي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    متغير أ = 0
    متغير ب = 1
    متغير ت = 2
    بينما (ت <= ن)
        متغير مؤقت = أ + ب
        أ = ب
        ب = مؤقت
        ت = ت + 1
    نهاية
    ارجع ب
نهاية

متغير نتائج_فيب = ""
متغير ص = 0
بينما (ص < 20)
    إذا (ص > 0)
        نتائج_فيب = نتائج_فيب + "، "
    نهاية
    نتائج_فيب = نتائج_فيب + فيبوناتشي(ص)
    ص = ص + 1
نهاية
اطبع_سطر("  " + نتائج_فيب)

# النسبة الذهبية
متغير ف19 = فيبوناتشي(19)
متغير ف18 = فيبوناتشي(18)
اطبع_سطر("  📐 النسبة الذهبية (تقريبية): " + (ف19 / ف18))

# ═══ القسم 3: الأعداد الأولية ═══
اطبع_سطر("")
اطبع_سطر("🔢 الأعداد الأولية إلى 100:")
اطبع_سطر("─────────────────────────────")

دالة هل_أولي(ن)
    إذا (ن < 2)
        ارجع خطأ
    نهاية
    إذا (ن == 2)
        ارجع صحيح
    نهاية
    إذا (ن % 2 == 0)
        ارجع خطأ
    نهاية
    متغير ق = 3
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            ارجع خطأ
        نهاية
        ق = ق + 2
    نهاية
    ارجع صحيح
نهاية

متغير أولية = ""
متغير عدد_الأولية = 0
متغير فحص = 2
بينما (فحص <= 100)
    إذا (هل_أولي(فحص))
        إذا (عدد_الأولية > 0)
            أولية = أولية + "، "
        نهاية
        أولية = أولية + فحص
        عدد_الأولية = عدد_الأولية + 1
    نهاية
    فحص = فحص + 1
نهاية
اطبع_سطر("  " + أولية)
اطبع_سطر("  المجموع: " + عدد_الأولية + " عدد أولي")

# ═══ القسم 4: القاسم المشترك الأكبر ═══
اطبع_سطر("")
اطبع_سطر("📏 القاسم المشترك الأكبر (خوارزمية إقليدس):")
اطبع_سطر("─────────────────────────────")

دالة قمأ(أ، ب)
    بينما (ب != 0)
        متغير باقي = أ % ب
        أ = ب
        ب = باقي
    نهاية
    ارجع أ
نهاية

دالة ممأ(أ، ب)
    ارجع (أ * ب) / قمأ(أ، ب)
نهاية

متغير أزواج = [[12، 8]، [54، 24]، [100، 75]، [17، 13]، [144، 89]]
لكل زوج في أزواج
