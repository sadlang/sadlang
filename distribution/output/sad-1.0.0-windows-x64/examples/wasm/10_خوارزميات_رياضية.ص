# ═══ القسم 7: المتتاليات العددية ═══
اطبع_سطر("")
اطبع_سطر("📊 المتتاليات العددية:")
اطبع_سطر("─────────────────────────────")

# مجموع الأعداد من 1 إلى ن
دالة مجموع_حسابي(ن)
    ارجع ن * (ن + 1) / 2
نهاية

# مجموع المربعات
دالة مجموع_مربعات(ن)
    ارجع ن * (ن + 1) * (2 * ن + 1) / 6
نهاية

# مجموع المكعبات
دالة مجموع_مكعبات(ن)
    متغير م = مجموع_حسابي(ن)
    ارجع م * م
نهاية

متغير نطاقات = [10، 50، 100]
لكل ن في نطاقات
    اطبع_سطر("  ن = " + ن + ":")
    اطبع_سطر("    مجموع (1→" + ن + "):    " + مجموع_حسابي(ن))
    اطبع_سطر("    مجموع المربعات: " + مجموع_مربعات(ن))
    اطبع_سطر("    مجموع المكعبات: " + مجموع_مكعبات(ن))
نهاية

# ═══ القسم 8: مثلث باسكال ═══
اطبع_سطر("")
اطبع_سطر("🔺 مثلث باسكال (6 صفوف):")
اطبع_سطر("─────────────────────────────")

متغير الصفوف = 6
متغير صف_حالي = [1]

متغير صف_رقم = 0
بينما (صف_رقم < الصفوف)
    # طباعة المسافات للمحاذاة
    متغير مسافات = ""
    متغير م = 0
    بينما (م < الصفوف - صف_رقم - 1)
        مسافات = مسافات + "  "
        م = م + 1
    نهاية
    
    # طباعة القيم
    متغير نص_الصف = مسافات
    لكل قيمة في صف_حالي
        إذا (قيمة < 10)
            نص_الصف = نص_الصف + " " + قيمة + "  "
        وإلا
            نص_الصف = نص_الصف + قيمة + "  "
        نهاية
    نهاية
    اطبع_سطر(نص_الصف)
    
    # حساب الصف التالي
    متغير صف_جديد = [1]
    متغير ك = 1
    بينما (ك < طول(صف_حالي))
        أضف(صف_جديد، صف_حالي[ك - 1] + صف_حالي[ك])
        ك = ك + 1
    نهاية
    أضف(صف_جديد، 1)
    صف_حالي = صف_جديد
    صف_رقم = صف_رقم + 1
نهاية

# ═══ القسم 9: الأعداد التامة ═══
اطبع_سطر("")
اطبع_سطر("💎 الأعداد التامة (حتى 500):")
اطبع_سطر("─────────────────────────────")

دالة هل_تام(ن)
    متغير مجموع = 0
    متغير ق = 1
    بينما (ق <= ن / 2)
        إذا (ن % ق == 0)
            مجموع = مجموع + ق
        نهاية
        ق = ق + 1
    نهاية
    ارجع مجموع == ن
نهاية

متغير ع_تام = 2
بينما (ع_تام <= 500)
    إذا (هل_تام(ع_تام))
        # إيجاد قواسم العدد التام
        متغير قواسم = ""
        متغير ق = 1
        بينما (ق <= ع_تام / 2)
            إذا (ع_تام % ق == 0)
                إذا (قواسم != "")
                    قواسم = قواسم + " + "
                نهاية
                قواسم = قواسم + ق
            نهاية
            ق = ق + 1
        نهاية
        اطبع_سطر("  ✨ " + ع_تام + " = " + قواسم)
    نهاية
    ع_تام = ع_تام + 1
نهاية

