# ═══ القسم 5: التحويلات العددية ═══
اطبع_سطر("")
اطبع_سطر("🔄 التحويلات العددية:")
اطبع_سطر("─────────────────────────────")

دالة إلى_ثنائي(ن)
    إذا (ن == 0)
        ارجع "0"
    نهاية
    متغير نتيجة = ""
    متغير قيمة = ن
    بينما (قيمة > 0)
        نتيجة = (قيمة % 2) + نتيجة
        قيمة = (قيمة - (قيمة % 2)) / 2
    نهاية
    ارجع نتيجة
نهاية

متغير أرقام_تحويل = [0، 1، 5، 10، 15، 42، 100، 255]
لكل ن في أرقام_تحويل
    اطبع_سطر("  " + ن + " ← ثنائي: " + إلى_ثنائي(ن))
نهاية

# ═══ القسم 6: حساب الأُسُس ═══
اطبع_سطر("")
اطبع_سطر("⚡ جدول الأُسُس:")
اطبع_سطر("─────────────────────────────")

دالة أُس(القاعدة، القوة)
    متغير نتيجة = 1
    متغير ع = 0
    بينما (ع < القوة)
        نتيجة = نتيجة * القاعدة
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

