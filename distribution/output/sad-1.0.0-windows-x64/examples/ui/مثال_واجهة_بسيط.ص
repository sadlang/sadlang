# مثال: واجهة مستخدم بسيطة بنظام بنيان الموحّد
# يعرض نافذة بسيطة تحتوي على عنوان وزر ونص
# ═══════════════════════════════════════════════════════════════

استورد بنيان

# إنشاء تطبيق جديد
تطبيق_جديد("تطبيقي الأول"، 800، 600)

# بناء شجرة العناصر
متغير الهيكل = عنصر_هيكل()

# شريط التطبيق
متغير الشريط = عنصر_شريط_تطبيق()
حدد_خاصية(الشريط، "نص"، "مرحباً بالعربية!")
حدد_خاصية(الشريط، "لون_خلفية"، "#2196F3")
أضف_ابن(الهيكل، الشريط)

# المحتوى الرئيسي: عمود في الوسط
متغير الوسط = عنصر_وسط()
متغير العمود = عنصر_عمود()

# نص ترحيبي
متغير نص_ترحيب = عنصر_نص("مرحباً بك في لغة ص! 🎉")
حدد_خاصية(نص_ترحيب، "حجم_خط"، 24)
أضف_ابن(العمود، نص_ترحيب)

# فاصل
متغير فاصل = عنصر_فاصل()
أضف_ابن(العمود، فاصل)

# وصف
متغير وصف = عنصر_نص("هذه واجهة مبنية بنظام بنيان الموحّد")
حدد_خاصية(وصف، "حجم_خط"، 16)
أضف_ابن(العمود، وصف)

# زر
متغير زر_ترحيب = عنصر_زر("اضغطني!")
أضف_ابن(العمود، زر_ترحيب)

# تجميع الشجرة
أضف_ابن(الوسط، العمود)
أضف_ابن(الهيكل، الوسط)

# تعيين الجذر وتشغيل التطبيق
حدد_جذر(الهيكل)

اطبع_سطر("المحرك النشط: " + اسم_المحرك())
اطبع_سطر("جارٍ تشغيل الواجهة...")

شغل_تطبيق()

اطبع_سطر("تم إغلاق التطبيق.")
