# مثال: اختبار نظام بنيان (بدون نافذة — بالمحرك الفارغ)
# يتحقق من صحة إنشاء العناصر وإدارة الشجرة
# يعمل على جميع المنصات بدون SDL2
# ═══════════════════════════════════════════════════════════════

استورد بنيان

اطبع_سطر("═══ اختبار نظام بنيان الموحّد ═══")
اطبع_سطر("")

# (1) اسم المحرك
متغير محرك = اسم_المحرك()
اطبع_سطر("المحرك: " + محرك)

# (2) إنشاء عناصر
متغير عمود = عنصر_عمود()
اطبع_سطر("عنصر عمود: " + عمود)

متغير نص1 = عنصر_نص("مرحباً")
اطبع_سطر("عنصر نص: " + نص1)

متغير زر1 = عنصر_زر("اضغط")
اطبع_سطر("عنصر زر: " + زر1)

# (3) بناء الشجرة
أضف_ابن(عمود، نص1)
أضف_ابن(عمود، زر1)
اطبع_سطر("تم بناء الشجرة ✓")

# (4) تعيين خاصية وقراءتها
حدد_خاصية(نص1، "لون"، "#FF0000")
متغير لون = اقرأ_خاصية(نص1، "لون")
اطبع_سطر("لون النص: " + لون)

حدد_خاصية(زر1، "حجم_خط"، 18)

# (5) إنشاء عنصر بالاسم العربي
متغير بطاقة = عنصر_جديد("بطاقة")
اطبع_سطر("عنصر بطاقة: " + بطاقة)

متغير صف = عنصر_صف()
اطبع_سطر("عنصر صف: " + صف)

# (6) تعيين الجذر
حدد_جذر(عمود)
اطبع_سطر("تم تعيين الجذر ✓")

# (7) حذف عنصر
احذف_عنصر(بطاقة)
اطبع_سطر("تم حذف البطاقة ✓")

اطبع_سطر("")
اطبع_سطر("═══ انتهى الاختبار بنجاح ═══")
