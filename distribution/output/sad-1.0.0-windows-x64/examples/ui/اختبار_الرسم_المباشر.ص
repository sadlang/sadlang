# ═══════════════════════════════════════════════════════════════
# اختبار الرسم المباشر (Direct Rendering Test)
# ═══════════════════════════════════════════════════════════════
# هذا الملف يختبر نظام الرسم المباشر الجديد الذي يرسم
# العناصر مباشرة عبر PlatformRenderer بدلاً من توليد كود
#
# يشمل: نصوص، أزرار، حقول إدخال، شريط تقدم،
#        بطاقات، فاصل، وتخطيط عمود/صف
#
# ملاحظة: نستخدم الأصناف كدوال (بدون جديد) لتجنب تعارض
#         اسم النوع المدمج "نص" مع صنف "نص"
# ═══════════════════════════════════════════════════════════════

من واجهات استورد *

# ═══════════════════════════════════════════════════════════════
#                    بناء الواجهة
# ═══════════════════════════════════════════════════════════════

# ─── شريط التطبيق العلوي ───
# ملاحظة: معامل "عنوان" يتعارض مع صنف "عنوان" المستورد
# لذا نعيّن العنوان يدوياً بعد الإنشاء
متغير الشريط = جديد شريط_تطبيق("x")
الشريط._خصائص["عنوان"] = "اختبار الرسم المباشر"
الشريط._خصائص["خلفية"] = "#1565C0"
الشريط._خصائص["لون_النص"] = "#FFFFFF"

# ─── المحتوى الرئيسي ───
# عمود(أبناء، تباعد، محاذاة، خلفية، حشو)
متغير المحتوى = عمود([]، 12، لاشيء، لاشيء، 20)

# (1) عنوان ترحيبي
# نص(محتوى، حجم، لون، خلفية، نوع_الخط، وزن)
متغير العنوان = نص("مرحباً بك في نظام الرسم المباشر!"، 22، "#1565C0"، لاشيء، لاشيء، "عريض")
المحتوى._أبناء = المحتوى._أبناء + [العنوان]

# (2) وصف
متغير الوصف = نص("هذه الواجهة تُرسم مباشرة عبر PlatformRenderer"، 14، "#666666")
المحتوى._أبناء = المحتوى._أبناء + [الوصف]

# (3) فاصل
متغير فاصل1 = جديد عنصر()
فاصل1._نوع = "فاصل"
المحتوى._أبناء = المحتوى._أبناء + [فاصل1]

# (4) بطاقة تحتوي على عناصر متنوعة
# بطاقة(ابن، رفع، حشو، لون، عند_الضغط، زوايا)
متغير محتوى_البطاقة = عمود([]، 10)

# نص داخل البطاقة
متغير نص_العنوان = نص("عناصر التحكم"، 18، "#333333"، لاشيء، لاشيء، "عريض")
محتوى_البطاقة._أبناء = محتوى_البطاقة._أبناء + [نص_العنوان]

# صف أزرار
# صف(أبناء، تباعد)
متغير صف_الأزرار = صف([]، 10)

# زر(محتوى، لون_خلفية، لون_نص، عند_الضغط، عرض، ارتفاع، معطل، حشو، هامش، حجم_الخط، زوايا)
متغير زر1 = زر("زر أساسي"، "#2196F3"، "#FFFFFF"، لاشيء، لاشيء، لاشيء، لاشيء، 12، لاشيء، لاشيء، 8)
متغير زر2 = زر("زر ثانوي"، "#4CAF50"، "#FFFFFF"، لاشيء، لاشيء، لاشيء، لاشيء، 12، لاشيء، لاشيء، 8)
متغير زر3 = زر("حذف"، "#F44336"، "#FFFFFF"، لاشيء، لاشيء، لاشيء، لاشيء، 12، لاشيء، لاشيء، 8)

صف_الأزرار._أبناء = [زر1، زر2، زر3]
محتوى_البطاقة._أبناء = محتوى_البطاقة._أبناء + [صف_الأزرار]

# حقل إدخال
# حقل(تلميح، قيمة، نوع، عند_التغيير، ايقونة، تسمية)
متغير حقل_الاسم = حقل("أدخل اسمك..."، ""، لاشيء، لاشيء، لاشيء، "الاسم")
محتوى_البطاقة._أبناء = محتوى_البطاقة._أبناء + [حقل_الاسم]

متغير البطاقة1 = بطاقة(محتوى_البطاقة، 4، 16، لاشيء، لاشيء، 12)
المحتوى._أبناء = المحتوى._أبناء + [البطاقة1]

# (5) فاصل ثانٍ
متغير فاصل2 = جديد عنصر()
فاصل2._نوع = "فاصل"
المحتوى._أبناء = المحتوى._أبناء + [فاصل2]

# (6) شريط تقدم
متغير نص_التقدم = نص("شريط التقدم (65%):"، 14، "#333333")
المحتوى._أبناء = المحتوى._أبناء + [نص_التقدم]

# شريط_تقدم(قيمة، لون)
متغير التقدم = شريط_تقدم(65، "#2196F3")
المحتوى._أبناء = المحتوى._أبناء + [التقدم]

# (7) بطاقة ثانية — معلومات النظام
متغير محتوى_البطاقة2 = عمود([]، 8)

متغير عنوان_المعلومات = نص("معلومات النظام"، 16، "#1565C0"، لاشيء، لاشيء، "عريض")
محتوى_البطاقة2._أبناء = محتوى_البطاقة2._أبناء + [عنوان_المعلومات]

متغير معلومة1 = نص("• المحرك: رسم مباشر (Direct Render)"، 13، "#555555")
متغير معلومة2 = نص("• المنصة: سطح المكتب (SDL2 + OpenGL)"، 13، "#555555")
متغير معلومة3 = نص("• الإصدار: 3.0"، 13، "#555555")
محتوى_البطاقة2._أبناء = محتوى_البطاقة2._أبناء + [معلومة1، معلومة2، معلومة3]

متغير البطاقة2 = بطاقة(محتوى_البطاقة2، 2، 16، لاشيء، لاشيء، 8)
المحتوى._أبناء = المحتوى._أبناء + [البطاقة2]

# ═══════════════════════════════════════════════════════════════
#                    تجميع الهيكل وتشغيله
# ═══════════════════════════════════════════════════════════════

# هيكل(شريط، محتوى)
متغير الهيكل = هيكل(الشريط، المحتوى)

اطبع_سطر("═══ اختبار الرسم المباشر ═══")
اطبع_سطر("جارٍ تشغيل الواجهة...")

شغّل(الهيكل)

اطبع_سطر("تم إغلاق النافذة.")
اطبع_سطر("═══ انتهى الاختبار ═══")
