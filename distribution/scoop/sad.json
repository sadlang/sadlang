{
    "version": "1.0.0-beta.1",
    "description": "لغة ص — لغة برمجة عربية حديثة / Sad Arabic Programming Language",
    "homepage": "https://github.com/sad-lang/sad-language",
    "license": "MIT",
    "notes": [
        "لغة ص — Sad Programming Language",
        "",
        "المفسر: sad script.ص",
        "المترجم: sadc script.ص (يتطلب LLVM 18)",
        "مدير الحزم: sad-pkg init",
        "",
        "التوثيق: https://sad-lang.org/docs"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/sad-lang/sad-language/releases/download/v1.0.0-beta.1/sad-full-v1.0.0-beta.1-windows-x86_64.zip",
            "hash": "",
            "extract_dir": "sad-full-v1.0.0-beta.1-windows-x86_64"
        }
    },
    "bin": [
        "bin\\sad.exe",
        "bin\\sadc.exe",
        "bin\\sad-pkg.exe",
        "bin\\sad-lsp.exe",
        "bin\\sad-fmt.exe",
        "bin\\sad-repl.exe"
    ],
    "env_add_path": "bin",
    "checkver": {
        "github": "https://github.com/sad-lang/sad-language"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sad-lang/sad-language/releases/download/v$version/sad-full-v$version-windows-x86_64.zip",
                "extract_dir": "sad-full-v$version-windows-x86_64"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "([a-f0-9]{64})\\s+sad-full-v$version-windows-x86_64.zip"
        }
    },
    "suggest": {
        "LLVM (للمترجم)": "llvm"
    }
}
