# ===================================================================
# نظام الإضافات — إنشاء الإضافات
# ===================================================================
# أدوات لإنشاء وبناء الإضافات الجديدة
#
# الاستخدام:
#   استورد * من إضافات.إنشاء
#   متغير إضافتي = إضافة("معرف")
#       .اسم("اسم الإضافة")
#       .وصف("وصف مختصر")
#       .عند_تهيئة(لامدا(سياق) { ... })
#       .بناء()
# ===================================================================

استورد * من إضافات.نواة

# ─── إضافة_أساسية (BasePlugin) ───
## صنف أساسي للإضافات — يوفر تنفيذاً افتراضياً
صدّر صنف إضافة_أساسية نفّذ واجهة_إضافة
    باني(معلومات)
        هذا._معلومات = معلومات
        هذا._سياق = لاشيء
        هذا._مهيأة = خطأ
        هذا._عند_تهيئة = لاشيء
        هذا._عند_إيقاف = لاشيء
        هذا._أوامر = {}
        هذا._خدمات = {}
    نهاية

    دالة معرف()
        ارجع هذا._معلومات.معرف
    نهاية

    دالة اسم()
        ارجع هذا._معلومات.اسم
    نهاية

    دالة وصف()
        ارجع هذا._معلومات.وصف
    نهاية

    دالة إصدار()
        ارجع هذا._معلومات.إصدار
    نهاية

    دالة مؤلف()
        ارجع هذا._معلومات.مؤلف
    نهاية

    دالة هيئ(سياق)
        هذا._سياق = سياق
        
        # تسجيل الأوامر
        لكل اسم في هذا._أوامر.مفاتيح()
            سياق.سجل_خدمة("أمر:" + اسم, هذا._أوامر[اسم])
        نهاية

        # تسجيل الخدمات
        لكل اسم في هذا._خدمات.مفاتيح()
            سياق.سجل_خدمة(اسم, هذا._خدمات[اسم])
        نهاية

        # استدعاء دالة التهيئة المخصصة
        إذا (هذا._عند_تهيئة != لاشيء)
            هذا._عند_تهيئة(سياق)
        نهاية

        هذا._مهيأة = صحيح
    نهاية

    دالة أوقف()
        إذا (هذا._عند_إيقاف != لاشيء)
            هذا._عند_إيقاف(هذا._سياق)
        نهاية
        هذا._مهيأة = خطأ
    نهاية

    دالة متوافق_مع(إصدار_لغة)
        # مقارنة الإصدارات (مبسطة)
        ارجع صحيح
    نهاية

    # ─── دوال إضافية ───

    دالة سياق()
        ارجع هذا._سياق
    نهاية

    دالة مهيأة()
        ارجع هذا._مهيأة
    نهاية
نهاية

# ─── باني_إضافة (PluginBuilder) ───
## باني سلسلي لإنشاء الإضافات بسهولة
صدّر صنف باني_إضافة
    باني(معرف)
        هذا._معلومات = جديد معلومات_إضافة(معرف, معرف, "1.0.0")
        هذا._عند_تهيئة = لاشيء
        هذا._عند_إيقاف = لاشيء
        هذا._أوامر = {}
        هذا._خدمات = {}
        هذا._أحداث = {}
    نهاية

    ## تعيين اسم الإضافة
    دالة اسم(قيمة)
        هذا._معلومات.اسم = قيمة
        ارجع هذا
    نهاية

    ## تعيين وصف الإضافة
    دالة وصف(قيمة)
        هذا._معلومات.وصف = قيمة
        ارجع هذا
    نهاية

    ## تعيين إصدار الإضافة
    دالة إصدار(قيمة)
        هذا._معلومات.إصدار = قيمة
        ارجع هذا
    نهاية

    ## تعيين المؤلف
    دالة مؤلف(قيمة)
        هذا._معلومات.مؤلف = قيمة
        ارجع هذا
    نهاية

    ## تعيين الرابط
    دالة رابط(قيمة)
        هذا._معلومات.رابط = قيمة
        ارجع هذا
    نهاية

    ## إضافة اعتمادية
    دالة يعتمد_على(معرف_إضافة, إصدار = "*")
        هذا._معلومات.اعتمادات.أضف({
            "معرف": معرف_إضافة,
            "إصدار": إصدار
        })
        ارجع هذا
    نهاية

    ## تحديد الإصدار الأدنى المطلوب
    دالة يتطلب_إصدار(إصدار)
        هذا._معلومات.حد_أدنى_إصدار = إصدار
        ارجع هذا
    نهاية

    ## دالة التهيئة
    دالة عند_تهيئة(دالة_معالجة)
        هذا._عند_تهيئة = دالة_معالجة
        ارجع هذا
    نهاية

    ## دالة الإيقاف
    دالة عند_إيقاف(دالة_معالجة)
        هذا._عند_إيقاف = دالة_معالجة
        ارجع هذا
    نهاية

    ## تسجيل أمر
    دالة أمر(اسم, دالة_تنفيذ, وصف = "")
        هذا._أوامر[اسم] = {
            "تنفيذ": دالة_تنفيذ,
            "وصف": وصف
        }
        ارجع هذا
    نهاية

    ## تسجيل خدمة
    دالة خدمة(اسم, كائن)
        هذا._خدمات[اسم] = كائن
        ارجع هذا
    نهاية

    ## الاشتراك في حدث
    دالة عند(حدث, معالج)
        إذا (هذا._أحداث[حدث] == لاشيء)
            هذا._أحداث[حدث] = []
        نهاية
        هذا._أحداث[حدث].أضف(معالج)
        ارجع هذا
    نهاية

    ## بناء الإضافة النهائية
    دالة بناء()
        متغير إضافة = جديد إضافة_أساسية(هذا._معلومات)
        إضافة._عند_تهيئة = هذا._عند_تهيئة
        إضافة._عند_إيقاف = هذا._عند_إيقاف
        إضافة._أوامر = هذا._أوامر
        إضافة._خدمات = هذا._خدمات
        
        # ربط الأحداث
        متغير أحداثي = هذا._أحداث
        متغير عند_تهيئة_أصلي = إضافة._عند_تهيئة
        
        إضافة._عند_تهيئة = لامدا(سياق) {
            # تسجيل الأحداث
            لكل حدث في أحداثي.مفاتيح()
                لكل معالج في أحداثي[حدث]
                    سياق.اشترك(حدث, معالج)
                نهاية
            نهاية
            
            # استدعاء التهيئة الأصلية
            إذا (عند_تهيئة_أصلي != لاشيء)
                عند_تهيئة_أصلي(سياق)
            نهاية
        }
        
        ارجع إضافة
    نهاية
نهاية

# ─── دالة مختصرة لإنشاء إضافة ───
صدّر دالة إضافة(معرف)
    ارجع جديد باني_إضافة(معرف)
نهاية

# ─── قالب إضافة بسيط ───
صدّر دالة إضافة_بسيطة(معرف, اسم, عند_تهيئة)
    ارجع إضافة(معرف)
        .اسم(اسم)
        .عند_تهيئة(عند_تهيئة)
        .بناء()
نهاية
