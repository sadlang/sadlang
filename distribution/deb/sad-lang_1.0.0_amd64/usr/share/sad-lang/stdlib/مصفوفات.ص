#**
 * @module مصفوفات
 * @brief (AR) دوال المصفوفات المتقدمة
 * @brief (EN) Advanced array functions
 * 
 * الاستخدام:
 *   استورد مصفوفات
 *   استورد أضف، أزل من مصفوفات
 **#

صدّر دالة أضف(مصفوفة، عنصر)
    # (AR) يضيف عنصراً إلى نهاية المصفوفة
    ارجع append(مصفوفة، عنصر)
نهاية

صدّر دالة أزل(مصفوفة، فهرس)
    # (AR) يزيل عنصراً من المصفوفة بالفهرس
    ارجع remove(مصفوفة، فهرس)
نهاية

صدّر دالة عكس(مصفوفة)
    # (AR) يعكس ترتيب عناصر المصفوفة
    ارجع reverse(مصفوفة)
نهاية

صدّر دالة ترتيب(مصفوفة)
    # (AR) يرتب عناصر المصفوفة تصاعدياً
    ارجع sort(مصفوفة)
نهاية

صدّر دالة شريحة(مصفوفة، بداية، نهاية_)
    # (AR) يستخرج جزءاً من المصفوفة
    ارجع slice(مصفوفة، بداية، نهاية_)
نهاية

صدّر دالة يحتوي(مصفوفة، عنصر)
    # (AR) يتحقق إذا كان العنصر موجوداً في المصفوفة
    ارجع contains(مصفوفة، عنصر)
نهاية

صدّر دالة فهرس(مصفوفة، عنصر)
    # (AR) يجد فهرس العنصر في المصفوفة (-1 إذا غير موجود)
    ارجع indexOf(مصفوفة، عنصر)
نهاية

صدّر دالة دمج(مصفوفة1، مصفوفة2)
    # (AR) يدمج مصفوفتين
    ارجع concat(مصفوفة1، مصفوفة2)
نهاية

صدّر دالة فريدة(مصفوفة)
    # (AR) يزيل العناصر المكررة
    ارجع unique(مصفوفة)
نهاية

صدّر دالة مسطحة(مصفوفة)
    # (AR) يسطح مصفوفة متداخلة
    ارجع flatten(مصفوفة)
نهاية

صدّر دالة تصفية(مصفوفة، دالة_شرط)
    # (AR) يصفي المصفوفة حسب شرط
    ارجع filter(مصفوفة، دالة_شرط)
نهاية

صدّر دالة تحويل(مصفوفة، دالة_تحويل)
    # (AR) يحول كل عنصر في المصفوفة
    ارجع map(مصفوفة، دالة_تحويل)
نهاية

صدّر دالة تجميع(مصفوفة، دالة_تجميع، قيمة_أولية)
    # (AR) يجمع عناصر المصفوفة في قيمة واحدة
    ارجع reduce(مصفوفة، دالة_تجميع، قيمة_أولية)
نهاية

صدّر دالة أكبر_عنصر(مصفوفة)
    # (AR) يجد أكبر عنصر
    ارجع max(مصفوفة)
نهاية

صدّر دالة أصغر_عنصر(مصفوفة)
    # (AR) يجد أصغر عنصر
    ارجع min(مصفوفة)
نهاية

صدّر دالة مجموع(مصفوفة)
    # (AR) يحسب مجموع العناصر
    ارجع sum(مصفوفة)
نهاية

صدّر دالة متوسط(مصفوفة)
    # (AR) يحسب متوسط العناصر
    ارجع avg(مصفوفة)
نهاية
