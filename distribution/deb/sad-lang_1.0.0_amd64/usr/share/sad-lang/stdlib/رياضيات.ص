صدّر دالة عشوائي()
    # (AR) رقم عشوائي بين 0 و 1
    ارجع random()
نهاية

صدّر دالة عشوائي_نطاق(من، إلى)
    # (AR) رقم عشوائي في نطاق محدد
    ارجع randRange(من، إلى)
نهاية

صدّر دالة باقي(أ، ب)
    # (AR) باقي القسمة
    ارجع أ % ب
نهاية

صدّر دالة حصر(قيمة، حد_أدنى، حد_أقصى)
    # (AR) يحصر القيمة بين حدين
    ارجع clamp(قيمة، حد_أدنى، حد_أقصى)
نهاية

صدّر دالة درجات_لراديان(درجات)
    # (AR) تحويل من درجات إلى راديان
    ارجع درجات * (باي / 180)
نهاية

صدّر دالة راديان_لدرجات(راديان)
    # (AR) تحويل من راديان إلى درجات
    ارجع راديان * (180 / باي)
نهاية
