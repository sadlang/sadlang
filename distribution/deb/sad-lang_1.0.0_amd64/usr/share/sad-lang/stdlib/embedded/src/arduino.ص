/**
 * (AR) تحديد القيمة ضمن نطاق
 * 
 * @param قيمة - القيمة المراد تحديدها
 * @param أدنى - الحد الأدنى
 * @param أعلى - الحد الأعلى
 * @returns القيمة المحدودة
 */
#[مضمنة(دائماً)]
دالة عامة حدد<ن: مرتب>(قيمة: ن، أدنى: ن، أعلى: ن) -> ن {
    إذا قيمة < أدنى {
        أدنى
    } وإلا إذا قيمة > أعلى {
        أعلى
    } وإلا {
        قيمة
    }
}

#[مضمنة(دائماً)]
دالة عامة constrain<T: مرتب>(value: T، low: T، high: T) -> T {
    حدد(value، low، high)
}

/**
 * (AR) إعادة تعيين نطاق القيمة
 *      تحول القيمة من نطاق إلى آخر
 * 
 * @param قيمة - القيمة الأصلية
 * @param من_أدنى - الحد الأدنى الأصلي
 * @param من_أعلى - الحد الأعلى الأصلي
 * @param إلى_أدنى - الحد الأدنى الجديد
 * @param إلى_أعلى - الحد الأعلى الجديد
 */
#[مضمنة(دائماً)]
دالة عامة أعد_تعيين(قيمة: ص32، من_أدنى: ص32، من_أعلى: ص32، إلى_أدنى: ص32، إلى_أعلى: ص32) -> ص32 {
    (قيمة - من_أدنى) * (إلى_أعلى - إلى_أدنى) / (من_أعلى - من_أدنى) + إلى_أدنى
}

#[مضمنة(دائماً)]
دالة عامة map(value: ص32، fromLow: ص32، fromHigh: ص32، toLow: ص32، toHigh: ص32) -> ص32 {
    أعد_تعيين(value، fromLow، fromHigh، toLow، toHigh)
}

/**
 * (AR) الحد الأدنى
 */
#[مضمنة(دائماً)]
دالة عامة أدنى<ن: مرتب>(أ: ن، ب: ن) -> ن {
    إذا أ < ب { أ } وإلا { ب }
}

#[مضمنة(دائماً)]
دالة عامة min<T: مرتب>(a: T، b: T) -> T {
    أدنى(a، b)
}

/**
 * (AR) الحد الأعلى
 */
#[مضمنة(دائماً)]
دالة عامة أعلى<ن: مرتب>(أ: ن، ب: ن) -> ن {
    إذا أ > ب { أ } وإلا { ب }
}

#[مضمنة(دائماً)]
دالة عامة max<T: مرتب>(a: T، b: T) -> T {
    أعلى(a، b)
}

/**
 * (AR) القيمة المطلقة
 */
#[مضمنة(دائماً)]
دالة عامة مطلق<ن: موقع>(قيمة: ن) -> ن {
    إذا قيمة < 0 { -قيمة } وإلا { قيمة }
}

#[مضمنة(دائماً)]
دالة عامة abs<T: موقع>(value: T) -> T {
    مطلق(value)
}

