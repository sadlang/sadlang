    دالة عامة خارجية اطبع_قاعدة(رقم: ص32، قاعدة: ص8)؛
    
    /**
     * (AR) عدد البايتات المتاحة للقراءة
     */
    #[خارجي(C، "Serial_available")]
    دالة عامة خارجية متاح() -> ص32؛
    
    /**
     * (AR) قراءة بايت واحد
     */
    #[خارجي(C، "Serial_read")]
    دالة عامة خارجية اقرأ() -> ص32؛
    
    /**
     * (AR) كتابة بايت واحد
     */
    #[خارجي(C، "Serial_write")]
    دالة عامة خارجية اكتب(بايت: ص8)؛
}

