#[cfg(example)]
وحدة أمثلة {
    استخدم super::*؛
    
    /**
     * (AR) مثال: وميض LED
     */
    #[إعداد]
    دالة إعداد_وميض() {
        حدد_وضع(منفذ_ليد، خرج)؛
    }
    
    #[حلقة]
    دالة حلقة_وميض() {
        اكتب_رقمي(منفذ_ليد، عالٍ)؛
        انتظر(1000)؛
        اكتب_رقمي(منفذ_ليد، منخفض)؛
        انتظر(1000)؛
    }
    
    /**
     * (AR) مثال: قراءة مستشعر تماثلي
     */
    #[إعداد]
    دالة إعداد_مستشعر() {
        تسلسلي::ابدأ(9600)؛
    }
    
    #[حلقة]
    دالة حلقة_مستشعر() {
        دع قيمة = اقرأ_تماثلي(ت0)؛
        تسلسلي::اطبع("القيمة: ")؛
        تسلسلي::اطبع_رقم(قيمة كـ ص32)؛
        تسلسلي::اطبع_سطر("")؛
        انتظر(100)؛
    }
    
    /**
     * (AR) مثال: تحكم PWM
     */
    #[إعداد]
    دالة إعداد_pwm() {
        حدد_وضع(د9، خرج)؛
    }
    
    #[حلقة]
    دالة حلقة_pwm() {
        // (AR) زيادة السطوع تدريجياً
        لكل سطوع في 0..256 {
            اكتب_تماثلي(د9، سطوع كـ ص8)؛
            انتظر(10)؛
        }
        
        // (AR) تقليل السطوع تدريجياً
        لكل سطوع في (0..256).عكس() {
            اكتب_تماثلي(د9، سطوع كـ ص8)؛
            انتظر(10)؛
        }
    }
}
