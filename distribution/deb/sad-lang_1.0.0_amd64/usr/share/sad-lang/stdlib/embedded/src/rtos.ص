/**
 * (AR) حالات المهمة المختلفة
 */
تعداد حالة_مهمة {
    جاهزة،          // (AR) جاهزة للتنفيذ
    قيد_التنفيذ،     // (AR) تُنفَّذ حالياً
    محجوبة،          // (AR) تنتظر حدثاً
    معلّقة،          // (AR) معلّقة مؤقتاً
    محذوفة،          // (AR) تم حذفها
}

