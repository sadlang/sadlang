/**
 * (AR) وحدة المجدول
 */
وحدة مجدول {
    /**
     * (AR) بدء المجدول
     *      ملاحظة: هذه الدالة لا ترجع!
     */
    #[خارجي(C، "vTaskStartScheduler")]
    دالة عامة خارجية ابدأ() -> !؛
    
    /**
     * (AR) إيقاف المجدول
     */
    #[خارجي(C، "vTaskEndScheduler")]
    دالة عامة خارجية أوقف()؛
    
    /**
     * (AR) تعليق المجدول
     */
    #[خارجي(C، "vTaskSuspendAll")]
    دالة عامة خارجية علّق()؛
    
    /**
     * (AR) استئناف المجدول
     */
    #[خارجي(C، "xTaskResumeAll")]
    دالة عامة خارجية استأنف() -> ص32؛
}

