/**
 * (AR) مستويات الأولوية للمهام
 */
تعداد أولوية {
    خاملة = 0،          // (AR) أدنى أولوية
    منخفضة = 1،
    تحت_عادية = 2،
    عادية = 3،
    فوق_عادية = 4،
    عالية = 5،
    فورية = 6،          // (AR) أعلى أولوية
}

