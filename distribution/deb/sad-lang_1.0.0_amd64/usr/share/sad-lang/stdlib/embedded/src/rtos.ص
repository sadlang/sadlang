/**
 * (AR) ثوابت المهلة
 */
ثابت عام انتظار_للأبد: ص32 = 0xFFFFFFFF؛
ثابت عام بدون_انتظار: ص32 = 0؛

/**
 * (AR) الحجم الافتراضي للمكدس
 */
ثابت عام حجم_مكدس_افتراضي: ص32 = 2048؛
ثابت عام حجم_مكدس_صغير: ص32 = 1024؛
ثابت عام حجم_مكدس_كبير: ص32 = 4096؛

