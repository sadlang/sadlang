        مهمة::أنشئ("مستشعر"، مهمة_مستشعر، 1024، أولوية::عادية)؛
        
        // بدء المجدول
        مجدول::ابدأ()؛
    }
    
    /**
     * (AR) مثال: منتج-مستهلك مع طابور
     */
    دالة مثال_طابور() {
        ثابت طابور: طابور_آمن<ص32> = طابور_آمن::جديد(10).فك_غلاف()؛
        
        دالة منتج(_: *فراغ) {
            دع متغير قيمة: ص32 = 0؛
            حلقة {
                طابور.أرسل(&قيمة)؛
                قيمة += 1؛
                انتظر_مللي(100)؛
            }
        }
        
        دالة مستهلك(_: *فراغ) {
            حلقة {
                إذا_دع بعض(قيمة) = طابور.استقبل() {
                    // معالجة القيمة
                }
            }
        }
        
        مهمة::أنشئ("منتج"، منتج، 1024، أولوية::عادية)؛
        مهمة::أنشئ("مستهلك"، مستهلك، 1024، أولوية::عادية)؛
        مجدول::ابدأ()؛
    }
