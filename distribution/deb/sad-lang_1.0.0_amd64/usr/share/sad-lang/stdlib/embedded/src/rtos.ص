//                    (AR) المؤقتات البرمجية
//                    (EN) Software Timers
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) مقبض المؤقت
 */
#[repr(transparent)]
هيكل مقبض_مؤقت {
    داخلي: *فراغ،
}

/**
 * (AR) نوع دالة المؤقت
 */
نوع دالة_مؤقت = دالة(مقبض_مؤقت)؛

/**
 * (AR) وحدة المؤقتات
 */
وحدة مؤقت {
    /**
     * (AR) إنشاء مؤقت
     * 
     * @param اسم - اسم المؤقت
     * @param فترة - الفترة بالتكات
     * @param تلقائي_إعادة - هل يُعاد تشغيله تلقائياً؟
     * @param معرف - معرف للمستخدم
     * @param دالة - دالة الاستدعاء
     */
    #[خارجي(C، "xTimerCreate")]
    دالة عامة خارجية أنشئ(
        اسم: *حرف،
        فترة: ص32،
        تلقائي_إعادة: ص32،
        معرف: *فراغ،
        دالة: دالة_مؤقت
    ) -> مقبض_مؤقت؛
    
    /**
     * (AR) بدء المؤقت
     */
    #[خارجي(C، "xTimerStart")]
    دالة عامة خارجية ابدأ(مقبض: مقبض_مؤقت، مهلة: ص32) -> ص32؛
    
    /**
     * (AR) إيقاف المؤقت
     */
    #[خارجي(C، "xTimerStop")]
    دالة عامة خارجية أوقف(مقبض: مقبض_مؤقت، مهلة: ص32) -> ص32؛
    
    /**
     * (AR) إعادة تعيين المؤقت
     */
    #[خارجي(C، "xTimerReset")]
    دالة عامة خارجية أعد_تعيين(مقبض: مقبض_مؤقت، مهلة: ص32) -> ص32؛
    
    /**
     * (AR) تغيير الفترة
     */
    #[خارجي(C، "xTimerChangePeriod")]
    دالة عامة خارجية غيّر_فترة(مقبض: مقبض_مؤقت، فترة_جديدة: ص32، مهلة: ص32) -> ص32؛
    
    /**
     * (AR) حذف المؤقت
     */
    #[خارجي(C، "xTimerDelete")]
    دالة عامة خارجية احذف(مقبض: مقبض_مؤقت، مهلة: ص32) -> ص32؛
}

