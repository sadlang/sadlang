//                    (AR) مقبض المهمة
//                    (EN) Task Handle
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) مقبض للمهمة
 *      يُستخدم للتحكم بالمهمة بعد إنشائها
 */
#[repr(transparent)]
هيكل مقبض_مهمة {
    داخلي: *فراغ،
}

تطبيق مقبض_مهمة {
    /**
     * (AR) مقبض فارغ
     */
    #[مضمنة(دائماً)]
    دالة عامة فارغ() -> ذاتي {
        مقبض_مهمة { داخلي: فارغ_مؤشر() }
    }
    
    /**
     * (AR) هل المقبض صالح؟
     */
    #[مضمنة(دائماً)]
    دالة عامة صالح(&ذاتي) -> منطقي {
        ذاتي.داخلي != فارغ_مؤشر()
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) إدارة المهام
//                    (EN) Task Management
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) وحدة إدارة المهام
 */
وحدة مهمة {
    /**
     * (AR) نوع دالة المهمة
     */
    نوع دالة_مهمة = دالة(*فراغ)؛
    
    /**
     * (AR) إنشاء مهمة جديدة
     * 
     * @param اسم - اسم المهمة (للتصحيح)
     * @param دالة - دالة المهمة
     * @param حجم_مكدس - حجم مكدس المهمة بالبايت
     * @param معاملات - معاملات تُمرر للمهمة
     * @param أولوية - أولوية المهمة
     * @returns مقبض المهمة أو خطأ
     * 
     * مثال:
     * @code
     * دع مقبض = مهمة::أنشئ(
     *     "مهمتي"،
     *     دالة_المهمة،
     *     2048،
     *     فارغ_مؤشر()،
     *     أولوية::عادية
     * )؛
     * @endcode
     */
    #[خارجي(C، "xTaskCreate")]
    دالة خارجية أنشئ_خام(
        دالة: دالة_مهمة،
        اسم: *حرف،
        حجم_مكدس: ص32،
        معاملات: *فراغ،
        أولوية: ص32،
        مقبض: *متغير مقبض_مهمة
    ) -> ص32؛
    
    /**
     * (AR) إنشاء مهمة (واجهة مبسطة)
     */
    دالة عامة أنشئ(
        اسم: &نص،
        دالة: دالة_مهمة،
        حجم_مكدس: ص32،
        أولوية: أولوية
    ) -> نتيجة<مقبض_مهمة، خطأ_rtos> {
        دع متغير مقبض = مقبض_مهمة::فارغ()؛
        
        دع نتيجة = غير_آمن {
            أنشئ_خام(
                دالة،
                اسم.كـ_مؤشر()،
                حجم_مكدس،
                فارغ_مؤشر()،
                أولوية كـ ص32،
                &متغير مقبض
            )
        }؛
        
        إذا نتيجة == 1 {  // pdPASS
            موافق(مقبض)
        } وإلا {
            خطأ(خطأ_rtos::فشل_إنشاء_مهمة)
        }
    }
    
    /**
     * (AR) حذف مهمة
     * 
     * @param مقبض - مقبض المهمة (فارغ للمهمة الحالية)
     */
    #[خارجي(C، "vTaskDelete")]
    دالة عامة خارجية احذف(مقبض: مقبض_مهمة)؛
    
    /**
     * (AR) تعليق مهمة
     */
    #[خارجي(C، "vTaskSuspend")]
    دالة عامة خارجية علّق(مقبض: مقبض_مهمة)؛
    
    /**
     * (AR) استئناف مهمة معلّقة
     */
    #[خارجي(C، "vTaskResume")]
    دالة عامة خارجية استأنف(مقبض: مقبض_مهمة)؛
    
    /**
     * (AR) الحصول على أولوية المهمة
     */
    #[خارجي(C، "uxTaskPriorityGet")]
    دالة عامة خارجية أولوية(مقبض: مقبض_مهمة) -> ص32؛
    
    /**
     * (AR) تعيين أولوية المهمة
     */
    #[خارجي(C، "vTaskPrioritySet")]
    دالة عامة خارجية عيّن_أولوية(مقبض: مقبض_مهمة، أولوية: ص32)؛
    
    /**
     * (AR) الحصول على حالة المهمة
     */
    #[خارجي(C، "eTaskGetState")]
    دالة عامة خارجية حالة(مقبض: مقبض_مهمة) -> حالة_مهمة؛
    
    /**
     * (AR) تنازل عن التنفيذ للمهام الأخرى
     */
    #[خارجي(C، "taskYIELD")]
    دالة عامة خارجية تنازل()؛
    
    /**
     * (AR) الحصول على مقبض المهمة الحالية
     */
    #[خارجي(C، "xTaskGetCurrentTaskHandle")]
    دالة عامة خارجية الحالية() -> مقبض_مهمة؛
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) التأخير والوقت
//                    (EN) Delay and Time
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) التأخير بوحدات التكات
 */
#[خارجي(C، "vTaskDelay")]
دالة عامة خارجية انتظر_تكات(تكات: ص32)؛

/**
 * (AR) التأخير بالمللي ثانية
 */
#[مضمنة(دائماً)]
دالة عامة انتظر_مللي(مللي: ص32) {
    // (AR) تحويل من مللي ثانية إلى تكات (يعتمد على configTICK_RATE_HZ)
    دع تكات = مللي * تردد_التكات() / 1000؛
    انتظر_تكات(تكات)؛
}

/**
 * (AR) التأخير حتى وقت معين
 */
#[خارجي(C، "vTaskDelayUntil")]
دالة عامة خارجية انتظر_حتى(آخر_استيقاظ: *متغير ص32، فترة: ص32)؛

/**
 * (AR) الحصول على عدد التكات الحالي
 */
#[خارجي(C، "xTaskGetTickCount")]
دالة عامة خارجية تكات_حالية() -> ص32؛

/**
 * (AR) تردد التكات في الثانية
 */
#[خارجي(C، "configTICK_RATE_HZ")]
دالة خارجية تردد_التكات() -> ص32؛

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) الإشارات (Semaphores)
//                    (EN) Semaphores
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) مقبض الإشارة
 */
#[repr(transparent)]
هيكل مقبض_إشارة {
    داخلي: *فراغ،
}

/**
 * (AR) وحدة الإشارات
 */
وحدة إشارة {
    /**
     * (AR) إنشاء إشارة ثنائية
     *      قيمة أولية = 0
     */
    #[خارجي(C، "xSemaphoreCreateBinary")]
    دالة عامة خارجية أنشئ_ثنائية() -> مقبض_إشارة؛
    
    /**
     * (AR) إنشاء إشارة عدّاد
     * 
     * @param أقصى - القيمة القصوى
     * @param ابتدائي - القيمة الابتدائية
     */
    #[خارجي(C، "xSemaphoreCreateCounting")]
    دالة عامة خارجية أنشئ_عداد(أقصى: ص32، ابتدائي: ص32) -> مقبض_إشارة؛
    
    /**
     * (AR) إنشاء قفل متبادل (Mutex)
     */
    #[خارجي(C، "xSemaphoreCreateMutex")]
    دالة عامة خارجية أنشئ_قفل() -> مقبض_إشارة؛
    
    /**
     * (AR) أخذ الإشارة (انتظار)
     * 
     * @param مقبض - مقبض الإشارة
     * @param مهلة - المهلة بالتكات
     * @returns صحيح إذا تم الأخذ بنجاح
     */
    #[خارجي(C، "xSemaphoreTake")]
    دالة عامة خارجية خذ(مقبض: مقبض_إشارة، مهلة: ص32) -> ص32؛
    
    /**
     * (AR) إعطاء الإشارة (تحرير)
     */
    #[خارجي(C، "xSemaphoreGive")]
    دالة عامة خارجية أعطِ(مقبض: مقبض_إشارة) -> ص32؛
    
    /**
     * (AR) حذف الإشارة
     */
    #[خارجي(C، "vSemaphoreDelete")]
    دالة عامة خارجية احذف(مقبض: مقبض_إشارة)؛
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) القفل المتبادل (Mutex)
//                    (EN) Mutex
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) قفل متبادل آمن
 *      يُستخدم لحماية الموارد المشتركة
 */
هيكل قفل {
    مقبض: مقبض_إشارة،
}

تطبيق قفل {
    /**
     * (AR) إنشاء قفل جديد
     */
    دالة عامة جديد() -> نتيجة<ذاتي، خطأ_rtos> {
        دع مقبض = إشارة::أنشئ_قفل()؛
        إذا مقبض.داخلي != فارغ_مؤشر() {
            موافق(قفل { مقبض })
        } وإلا {
            خطأ(خطأ_rtos::نفاد_الذاكرة)
        }
    }
    
    /**
     * (AR) قفل (انتظار حتى التوفر)
     */
    دالة عامة اقفل(&ذاتي) -> منطقي {
        إشارة::خذ(ذاتي.مقبض، انتظار_للأبد) == 1
    }
    
    /**
     * (AR) محاولة القفل (بدون انتظار)
     */
    دالة عامة حاول_قفل(&ذاتي) -> منطقي {
        إشارة::خذ(ذاتي.مقبض، بدون_انتظار) == 1
    }
    
    /**
     * (AR) محاولة القفل مع مهلة
     */
    دالة عامة اقفل_مع_مهلة(&ذاتي، مهلة_مللي: ص32) -> منطقي {
        دع تكات = مهلة_مللي * تردد_التكات() / 1000؛
        إشارة::خذ(ذاتي.مقبض، تكات) == 1
    }
    
    /**
     * (AR) فتح القفل
     */
    دالة عامة افتح(&ذاتي) {
        إشارة::أعطِ(ذاتي.مقبض)؛
    }
}

تطبيق إسقاط لـ قفل {
    دالة أسقط(&متغير ذاتي) {
        إشارة::احذف(ذاتي.مقبض)؛
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) الطوابير (Queues)
//                    (EN) Queues
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) مقبض الطابور
 */
#[repr(transparent)]
هيكل مقبض_طابور {
    داخلي: *فراغ،
}

/**
 * (AR) وحدة الطوابير
 */
وحدة طابور {
    /**
     * (AR) إنشاء طابور
     * 
     * @param طول - عدد العناصر
     * @param حجم_عنصر - حجم كل عنصر بالبايت
     */
    #[خارجي(C، "xQueueCreate")]
    دالة عامة خارجية أنشئ(طول: ص32، حجم_عنصر: ص32) -> مقبض_طابور؛
    
    /**
     * (AR) إرسال إلى الطابور (في النهاية)
     */
    #[خارجي(C، "xQueueSend")]
    دالة عامة خارجية أرسل(مقبض: مقبض_طابور، عنصر: *فراغ، مهلة: ص32) -> ص32؛
    
    /**
     * (AR) إرسال إلى مقدمة الطابور
     */
    #[خارجي(C، "xQueueSendToFront")]
    دالة عامة خارجية أرسل_للأمام(مقبض: مقبض_طابور، عنصر: *فراغ، مهلة: ص32) -> ص32؛
    
    /**
     * (AR) استقبال من الطابور
     */
    #[خارجي(C، "xQueueReceive")]
    دالة عامة خارجية استقبل(مقبض: مقبض_طابور، مخزن: *متغير فراغ، مهلة: ص32) -> ص32؛
    
    /**
     * (AR) قراءة من الطابور بدون إزالة
     */
    #[خارجي(C، "xQueuePeek")]
    دالة عامة خارجية اقرأ(مقبض: مقبض_طابور، مخزن: *متغير فراغ، مهلة: ص32) -> ص32؛
    
    /**
     * (AR) عدد العناصر في الطابور
     */
    #[خارجي(C، "uxQueueMessagesWaiting")]
    دالة عامة خارجية عدد_العناصر(مقبض: مقبض_طابور) -> ص32؛
    
    /**
     * (AR) المساحة المتاحة
     */
    #[خارجي(C، "uxQueueSpacesAvailable")]
    دالة عامة خارجية مساحة_متاحة(مقبض: مقبض_طابور) -> ص32؛
    
    /**
     * (AR) تفريغ الطابور
     */
    #[خارجي(C، "xQueueReset")]
    دالة عامة خارجية فرّغ(مقبض: مقبض_طابور) -> ص32؛
    
    /**
     * (AR) حذف الطابور
     */
    #[خارجي(C، "vQueueDelete")]
    دالة عامة خارجية احذف(مقبض: مقبض_طابور)؛
}

/**
 * (AR) طابور آمن عام
 */
هيكل طابور_آمن<ن: نوع> {
    مقبض: مقبض_طابور،
    _نوع: علامة_نوع<ن>،
}

تطبيق<ن: نوع> طابور_آمن<ن> {
    /**
     * (AR) إنشاء طابور جديد
     */
    دالة عامة جديد(سعة: ص32) -> نتيجة<ذاتي، خطأ_rtos> {
        دع مقبض = طابور::أنشئ(سعة، حجم::<ن>() كـ ص32)؛
        إذا مقبض.داخلي != فارغ_مؤشر() {
            موافق(طابور_آمن { مقبض، _نوع: علامة_نوع })
        } وإلا {
            خطأ(خطأ_rtos::نفاد_الذاكرة)
        }
    }
    
    /**
     * (AR) إرسال عنصر
     */
    دالة عامة أرسل(&ذاتي، عنصر: &ن) -> منطقي {
        طابور::أرسل(ذاتي.مقبض، عنصر كـ *فراغ، انتظار_للأبد) == 1
    }
    
    /**
     * (AR) إرسال مع مهلة
     */
    دالة عامة أرسل_مع_مهلة(&ذاتي، عنصر: &ن، مهلة_مللي: ص32) -> منطقي {
        دع تكات = مهلة_مللي * تردد_التكات() / 1000؛
        طابور::أرسل(ذاتي.مقبض، عنصر كـ *فراغ، تكات) == 1
    }
    
    /**
     * (AR) استقبال عنصر
     */
    دالة عامة استقبل(&ذاتي) -> اختيار<ن> {
        دع متغير عنصر: ن = غير_مهيأ()؛
        إذا طابور::استقبل(ذاتي.مقبض، &متغير عنصر كـ *متغير فراغ، انتظار_للأبد) == 1 {
            بعض(عنصر)
        } وإلا {
            لا_شيء
        }
    }
    
    /**
     * (AR) محاولة الاستقبال (بدون انتظار)
     */
    دالة عامة حاول_استقبل(&ذاتي) -> اختيار<ن> {
        دع متغير عنصر: ن = غير_مهيأ()؛
        إذا طابور::استقبل(ذاتي.مقبض، &متغير عنصر كـ *متغير فراغ، بدون_انتظار) == 1 {
            بعض(عنصر)
        } وإلا {
            لا_شيء
        }
    }
    
    /**
     * (AR) هل الطابور فارغ؟
     */
    دالة عامة فارغ(&ذاتي) -> منطقي {
        طابور::عدد_العناصر(ذاتي.مقبض) == 0
    }
    
    /**
     * (AR) هل الطابور ممتلئ؟
     */
    دالة عامة ممتلئ(&ذاتي) -> منطقي {
        طابور::مساحة_متاحة(ذاتي.مقبض) == 0
    }
}

