# ===================================================================
# نظام التدفقات و BLoC — Streams & BLoC Pattern
# ===================================================================
# مستوحى من Flutter (Stream, StreamController, BLoC, Cubit)
#
# الاستخدام:
#   استورد * من رسومات.حالة.تدفق
# ===================================================================

# ─── متحكم_تدفق (StreamController) ───
صدّر صنف متحكم_تدفق
    باني()
        هذا._مستمعون = []
        هذا._قيمة_أخيرة = لاشيء
        هذا._مغلق = خطأ
    نهاية

    دالة أضف(قيمة)
        إذا (هذا._مغلق)
            ارجع لاشيء
        نهاية
        هذا._قيمة_أخيرة = قيمة
        لكل م في هذا._مستمعون
            م(قيمة)
        نهاية
    نهاية

    دالة استمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
        # إرسال القيمة الأخيرة فوراً
        إذا (هذا._قيمة_أخيرة != لاشيء)
            مستمع(هذا._قيمة_أخيرة)
        نهاية
        ارجع هذا
    نهاية

    دالة أزل_مستمع(مستمع)
        متغير جديدة = []
        لكل م في هذا._مستمعون
            إذا (م != مستمع)
                جديدة.أضف(م)
            نهاية
        نهاية
        هذا._مستمعون = جديدة
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة_أخيرة
    نهاية

    دالة أغلق()
        هذا._مغلق = صحيح
        هذا._مستمعون = []
    نهاية

    دالة هل_مغلق()
        ارجع هذا._مغلق
    نهاية
نهاية

# ─── تدفق_سلوكي (BehaviorSubject) ───
صدّر صنف تدفق_سلوكي يرث متحكم_تدفق
    باني(قيمة_ابتدائية)
        الأساس()
        هذا._قيمة_أخيرة = قيمة_ابتدائية
    نهاية
نهاية

# ─── كيوبت (Cubit) ───
صدّر صنف كيوبت
    باني(حالة_ابتدائية)
        هذا._حالة = حالة_ابتدائية
        هذا._تدفق = جديد متحكم_تدفق()
        هذا._تدفق.أضف(حالة_ابتدائية)
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة صدّر(حالة_جديدة)
        هذا._حالة = حالة_جديدة
        هذا._تدفق.أضف(حالة_جديدة)
    نهاية

    دالة استمع(مستمع)
        هذا._تدفق.استمع(مستمع)
        ارجع هذا
    نهاية

    دالة أغلق()
        هذا._تدفق.أغلق()
    نهاية
نهاية

# ─── بلوك (BLoC) ───
صدّر صنف بلوك يرث كيوبت
    باني(حالة_ابتدائية)
        الأساس(حالة_ابتدائية)
        هذا._معالجات = {}
    نهاية

    دالة عند(نوع_حدث, معالج)
        هذا._معالجات[نوع_حدث] = معالج
        ارجع هذا
    نهاية

    دالة أضف_حدث(نوع, بيانات)
        إذا (بيانات == لاشيء)
            بيانات = {}
        نهاية
        متغير معالج = هذا._معالجات[نوع]
        إذا (معالج != لاشيء)
            معالج(بيانات, هذا)
        نهاية
    نهاية
نهاية

# ─── باني_بلوك (BlocBuilder helper) ───
صدّر دالة باني_بلوك(بلوك, باني)
    دالة _مستمع(حالة)
        باني(حالة)
    نهاية
    بلوك.استمع(_مستمع)
نهاية

# ─── مزود_بلوك (BlocProvider — singleton registry) ───
متغير _مزودات_بلوك = {}

صدّر دالة وفر_بلوك(اسم, بلوك)
    _مزودات_بلوك[اسم] = بلوك
نهاية

صدّر دالة احصل_بلوك(اسم)
    ارجع _مزودات_بلوك[اسم]
نهاية

صدّر دالة أزل_بلوك(اسم)
    متغير ب = _مزودات_بلوك[اسم]
    إذا (ب != لاشيء)
        ب.أغلق()
    نهاية
    _مزودات_بلوك[اسم] = لاشيء
نهاية
