# بسم الله الرحمن الرحيم
# ===================================================================
# نظام السرعة والزخم — Velocity & Momentum System
# ===================================================================
# 
# (AR) هذا الملف يوفر أصناف حساب السرعة والزخم للإيماءات اللمسية.
#      يُستخدم لحساب سرعة السحب عند رفع الإصبع، وتطبيق حركة القصور
#      الذاتي (inertia) على العناصر المتحركة بعد رفع اللمس.
#
#      مطابق لـ flutter/gestures/velocity_tracker.dart
#      و flutter/gestures/drag_details.dart
#
# (EN) This file provides velocity and momentum calculation classes
#      for touch gestures. Used to compute drag velocity on finger lift
#      and apply inertia momentum to moving elements after touch release.
#
# الأصناف المُصدّرة:
#   - سرعة (Velocity)          — تمثيل سرعة ثنائية الأبعاد
#   - تتبع_سرعة (VelocityTracker) — تتبع سرعة اللمسات عبر الزمن
#   - تقدير_سرعة (VelocityEstimate) — تقدير السرعة من عينات اللمس
#   - تفاصيل_سحب (DragDetails)    — تفاصيل حدث السحب
#   - تفاصيل_بداية_سحب (DragStartDetails) — تفاصيل بداية السحب
#   - تفاصيل_تحديث_سحب (DragUpdateDetails) — تفاصيل تحديث السحب
#   - تفاصيل_نهاية_سحب (DragEndDetails)   — تفاصيل نهاية السحب مع السرعة
#
# الاستخدام:
#   استورد * من رسومات.إيماءات_نظام.سرعة
# ===================================================================

# ─── ثوابت السرعة ───
ثابت أقصى_سرعة_بكسل = 8000.0
ثابت أدنى_سرعة_بكسل = 0.01
ثابت عدد_عينات_سرعة = 20
ثابت أقصى_عمر_عينة_مللي = 100

# ─── إزاحة (Offset) — نقطة في مستوى ثنائي الأبعاد ───
صدّر صنف إزاحة
    باني(س = 0, ص = 0)
        هذا._س = س
        هذا._ص = ص
    نهاية

    دالة س()
        ارجع هذا._س
    نهاية

    دالة ص()
        ارجع هذا._ص
    نهاية

    دالة المسافة()
        ارجع (هذا._س ** 2 + هذا._ص ** 2) ** 0.5
    نهاية

    دالة المسافة_المربعة()
        ارجع هذا._س ** 2 + هذا._ص ** 2
    نهاية

    دالة جمع(أخرى)
        ارجع جديد إزاحة(هذا._س + أخرى._س, هذا._ص + أخرى._ص)
    نهاية

    دالة طرح(أخرى)
        ارجع جديد إزاحة(هذا._س - أخرى._س, هذا._ص - أخرى._ص)
    نهاية

    دالة ضرب(مضاعف)
        ارجع جديد إزاحة(هذا._س * مضاعف, هذا._ص * مضاعف)
    نهاية

    دالة نص_إزاحة()
        ارجع "إزاحة(" + هذا._س + ", " + هذا._ص + ")"
    نهاية
نهاية

# ─── صفر الإزاحة ───
ثابت إزاحة_صفر = جديد إزاحة(0, 0)

# ─── سرعة (Velocity) — سرعة بكسل/ثانية ───
صدّر صنف سرعة
    # (AR) تمثيل السرعة بالبكسل/ثانية في البُعدين س وص
    # (EN) Velocity representation in pixels/second for X and Y axes
    باني(بكسل_في_الثانية = لاشيء)
        إذا (بكسل_في_الثانية == لاشيء)
            هذا._بكسل_في_الثانية = جديد إزاحة(0, 0)
        وإلا
            هذا._بكسل_في_الثانية = بكسل_في_الثانية
        نهاية
    نهاية

    دالة بكسل_في_الثانية()
        ارجع هذا._بكسل_في_الثانية
    نهاية

    دالة محصور(حد_أدنى, حد_أقصى)
        # (AR) حصر السرعة ضمن نطاق معين
        متغير س = هذا._بكسل_في_الثانية.س()
        متغير ص = هذا._بكسل_في_الثانية.ص()

        إذا (س > حد_أقصى)
            س = حد_أقصى
        نهاية
        إذا (س < حد_أدنى * -1)
            س = حد_أدنى * -1
        نهاية
        إذا (ص > حد_أقصى)
            ص = حد_أقصى
        نهاية
        إذا (ص < حد_أدنى * -1)
            ص = حد_أدنى * -1
        نهاية

        ارجع جديد سرعة(جديد إزاحة(س, ص))
    نهاية

    دالة إلى_نص()
        ارجع "سرعة(" + هذا._بكسل_في_الثانية.إلى_نص() + ")"
    نهاية
نهاية

# ─── صفر السرعة ───
ثابت سرعة_صفر = جديد سرعة()

# ─── عينة_لمس (PointSample) — نقطة لمس مع طابع زمني ───
صدّر صنف عينة_لمس
    # (AR) تسجيل موقع لمس مع الطابع الزمني لحساب السرعة
    باني(زمن = 0, موقع = لاشيء)
        هذا._زمن = زمن
        إذا (موقع == لاشيء)
            هذا._موقع = جديد إزاحة(0, 0)
        وإلا
            هذا._موقع = موقع
        نهاية
    نهاية

    دالة الزمن()
        ارجع هذا._زمن
    نهاية

    دالة الموقع()
        ارجع هذا._موقع
    نهاية
نهاية

# ─── تقدير_سرعة (VelocityEstimate) ───
صدّر صنف تقدير_سرعة
    # (AR) تقدير السرعة من مجموعة عينات لمس — يحتوي على السرعة المقدّرة
    #      ومعامل الثقة ومدة التقدير والإزاحة الكلية
    # (EN) Velocity estimate from a set of touch samples
    باني(بكسل_في_الثانية = لاشيء, ثقة = 1.0, مدة = 0, إزاحة_كلية = لاشيء)
        إذا (بكسل_في_الثانية == لاشيء)
            هذا._بكسل_في_الثانية = جديد إزاحة(0, 0)
        وإلا
            هذا._بكسل_في_الثانية = بكسل_في_الثانية
        نهاية
        هذا._ثقة = ثقة
        هذا._مدة = مدة
        إذا (إزاحة_كلية == لاشيء)
            هذا._إزاحة_كلية = جديد إزاحة(0, 0)
        وإلا
            هذا._إزاحة_كلية = إزاحة_كلية
        نهاية
    نهاية

    دالة بكسل_في_الثانية()
        ارجع هذا._بكسل_في_الثانية
    نهاية

    دالة الثقة()
        ارجع هذا._ثقة
    نهاية

    دالة المدة()
        ارجع هذا._مدة
    نهاية

    دالة الإزاحة_الكلية()
        ارجع هذا._إزاحة_كلية
    نهاية
نهاية

# ─── تتبع_سرعة (VelocityTracker) ───
صدّر صنف تتبع_سرعة
    # (AR) يتتبع مواقع اللمس عبر الزمن لحساب السرعة عند رفع الإصبع
    #      يحتفظ بآخر N عينة ويستخدم الانحدار الخطي لتقدير السرعة
    # (EN) Tracks touch positions over time to compute velocity on release
    باني()
        هذا._عينات = []
        هذا._الفهرس = 0
    نهاية

    دالة أضف_موقع(زمن, موقع)
        # (AR) إضافة نقطة لمس جديدة مع طابعها الزمني
        متغير عينة = جديد عينة_لمس(زمن, موقع)
        إذا (هذا._عينات.طول() >= عدد_عينات_سرعة)
            هذا._عينات[هذا._الفهرس % عدد_عينات_سرعة] = عينة
        وإلا
            هذا._عينات = هذا._عينات + [عينة]
        نهاية
        هذا._الفهرس = هذا._الفهرس + 1
    نهاية

    دالة احصل_سرعة()
        # (AR) حساب السرعة من العينات المسجلة
        إذا (هذا._عينات.طول() < 2)
            ارجع جديد تقدير_سرعة()
        نهاية

        # حساب بسيط: آخر عينتين
        متغير الأخيرة = هذا._عينات[هذا._عينات.طول() - 1]
        متغير ما_قبل = هذا._عينات[هذا._عينات.طول() - 2]

        متغير فرق_زمن = الأخيرة.الزمن() - ما_قبل.الزمن()
        إذا (فرق_زمن <= 0)
            ارجع جديد تقدير_سرعة()
        نهاية

        متغير فرق_س = الأخيرة.الموقع().س() - ما_قبل.الموقع().س()
        متغير فرق_ص = الأخيرة.الموقع().ص() - ما_قبل.الموقع().ص()

        # تحويل للبكسل/ثانية
        متغير سرعة_س = (فرق_س / فرق_زمن) * 1000
        متغير سرعة_ص = (فرق_ص / فرق_زمن) * 1000

        متغير إزاحة = الأخيرة.الموقع().طرح(هذا._عينات[0].الموقع())

        ارجع جديد تقدير_سرعة(
            جديد إزاحة(سرعة_س, سرعة_ص),
            1.0,
            فرق_زمن,
            إزاحة
        )
    نهاية

    دالة احصل_كائن_سرعة()
        # (AR) تحويل التقدير إلى كائن سرعة
        متغير تقدير = هذا.احصل_سرعة()
        ارجع جديد سرعة(تقدير.بكسل_في_الثانية())
    نهاية

    دالة مسح()
        # (AR) مسح جميع العينات
        هذا._عينات = []
        هذا._الفهرس = 0
    نهاية
نهاية

# ─── تفاصيل_بداية_سحب (DragStartDetails) ───
صدّر صنف تفاصيل_بداية_سحب
    # (AR) تفاصيل حدث بداية السحب — موقع النقر الأولي
    # (EN) Drag start event details — initial touch position
    باني(موقع_عام = لاشيء, موقع_محلي = لاشيء, زمن = 0)
        إذا (موقع_عام == لاشيء)
            هذا._موقع_عام = جديد إزاحة(0, 0)
        وإلا
            هذا._موقع_عام = موقع_عام
        نهاية
        إذا (موقع_محلي == لاشيء)
            هذا._موقع_محلي = جديد إزاحة(0, 0)
        وإلا
            هذا._موقع_محلي = موقع_محلي
        نهاية
        هذا._زمن = زمن
    نهاية

    دالة الموقع_العام()
        ارجع هذا._موقع_عام
    نهاية

    دالة الموقع_المحلي()
        ارجع هذا._موقع_محلي
    نهاية

    دالة الزمن()
        ارجع هذا._زمن
    نهاية
نهاية

# ─── تفاصيل_تحديث_سحب (DragUpdateDetails) ───
صدّر صنف تفاصيل_تحديث_سحب
    # (AR) تفاصيل تحديث السحب — الإزاحة التراكمية والإزاحة اللحظية
    # (EN) Drag update event details — cumulative and delta offsets
    باني(موقع_عام = لاشيء, موقع_محلي = لاشيء, دلتا = لاشيء, دلتا_أولية = لاشيء)
        إذا (موقع_عام == لاشيء)
            هذا._موقع_عام = جديد إزاحة(0, 0)
        وإلا
            هذا._موقع_عام = موقع_عام
        نهاية
        إذا (موقع_محلي == لاشيء)
            هذا._موقع_محلي = جديد إزاحة(0, 0)
        وإلا
            هذا._موقع_محلي = موقع_محلي
        نهاية
        إذا (دلتا == لاشيء)
            هذا._دلتا = جديد إزاحة(0, 0)
        وإلا
            هذا._دلتا = دلتا
        نهاية
        إذا (دلتا_أولية == لاشيء)
            هذا._دلتا_أولية = جديد إزاحة(0, 0)
        وإلا
            هذا._دلتا_أولية = دلتا_أولية
        نهاية
    نهاية

    دالة الموقع_العام()
        ارجع هذا._موقع_عام
    نهاية

    دالة الموقع_المحلي()
        ارجع هذا._موقع_محلي
    نهاية

    دالة الدلتا()
        ارجع هذا._دلتا
    نهاية

    دالة الدلتا_الأولية()
        ارجع هذا._دلتا_أولية
    نهاية
نهاية

# ─── تفاصيل_نهاية_سحب (DragEndDetails) ───
صدّر صنف تفاصيل_نهاية_سحب
    # (AR) تفاصيل نهاية السحب — السرعة عند رفع الإصبع
    #      تُستخدم لتطبيق حركة القصور الذاتي
    # (EN) Drag end event details — velocity at finger lift
    باني(سرعة_نهائية = لاشيء, إزاحة_أولية = لاشيء)
        إذا (سرعة_نهائية == لاشيء)
            هذا._سرعة = جديد سرعة()
        وإلا
            هذا._سرعة = سرعة_نهائية
        نهاية
        إذا (إزاحة_أولية == لاشيء)
            هذا._إزاحة_أولية = جديد إزاحة(0, 0)
        وإلا
            هذا._إزاحة_أولية = إزاحة_أولية
        نهاية
    نهاية

    دالة السرعة()
        ارجع هذا._سرعة
    نهاية

    دالة الإزاحة_الأولية()
        ارجع هذا._إزاحة_أولية
    نهاية
نهاية

# ─── تفاصيل_قرص (ScaleDetails) ───
صدّر صنف تفاصيل_بداية_قرص
    # (AR) تفاصيل بداية إيماءة القرص (التكبير/التصغير بإصبعين)
    باني(نقطة_بؤرية = لاشيء, نقطة_بؤرية_محلية = لاشيء)
        إذا (نقطة_بؤرية == لاشيء)
            هذا._نقطة_بؤرية = جديد إزاحة(0, 0)
        وإلا
            هذا._نقطة_بؤرية = نقطة_بؤرية
        نهاية
        إذا (نقطة_بؤرية_محلية == لاشيء)
            هذا._نقطة_بؤرية_محلية = جديد إزاحة(0, 0)
        وإلا
            هذا._نقطة_بؤرية_محلية = نقطة_بؤرية_محلية
        نهاية
    نهاية

    دالة النقطة_البؤرية()
        ارجع هذا._نقطة_بؤرية
    نهاية

    دالة النقطة_البؤرية_المحلية()
        ارجع هذا._نقطة_بؤرية_محلية
    نهاية
نهاية

صدّر صنف تفاصيل_تحديث_قرص
    # (AR) تفاصيل تحديث إيماءة القرص — المقياس والدوران
    باني(نقطة_بؤرية = لاشيء, نقطة_بؤرية_محلية = لاشيء, مقياس = 1.0, دوران = 0.0)
        إذا (نقطة_بؤرية == لاشيء)
            هذا._نقطة_بؤرية = جديد إزاحة(0, 0)
        وإلا
            هذا._نقطة_بؤرية = نقطة_بؤرية
        نهاية
        إذا (نقطة_بؤرية_محلية == لاشيء)
            هذا._نقطة_بؤرية_محلية = جديد إزاحة(0, 0)
        وإلا
            هذا._نقطة_بؤرية_محلية = نقطة_بؤرية_محلية
        نهاية
        هذا._مقياس = مقياس
        هذا._دوران = دوران
    نهاية

    دالة النقطة_البؤرية()
        ارجع هذا._نقطة_بؤرية
    نهاية

    دالة المقياس()
        ارجع هذا._مقياس
    نهاية

    دالة الدوران()
        ارجع هذا._دوران
    نهاية
نهاية

صدّر صنف تفاصيل_نهاية_قرص
    # (AR) تفاصيل نهاية إيماءة القرص — سرعة القرص النهائية
    باني(سرعة_نهائية = لاشيء, عدد_المؤشرات = 0)
        إذا (سرعة_نهائية == لاشيء)
            هذا._سرعة = جديد سرعة()
        وإلا
            هذا._سرعة = سرعة_نهائية
        نهاية
        هذا._عدد_المؤشرات = عدد_المؤشرات
    نهاية

    دالة السرعة()
        ارجع هذا._سرعة
    نهاية

    دالة عدد_المؤشرات()
        ارجع هذا._عدد_المؤشرات
    نهاية
نهاية
