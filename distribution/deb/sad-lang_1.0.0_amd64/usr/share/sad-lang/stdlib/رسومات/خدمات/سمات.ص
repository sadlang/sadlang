# ===================================================================
# خدمة السمات — Theme Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/سمات.ص
# ===================================================================
# مكتبة سمات شاملة تدعم:
#   - سمات فاتحة وداكنة
#   - سمات مخصصة
#   - الألوان الأساسية والثانوية
#   - متابعة سمة النظام
#   - مراقبة تغييرات السمة
#
# المنصات المدعومة:
#   ✅ جميع المنصات
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    تعدادات
# ===================================================================

صدّر تعداد وضع_سمة
    فاتح
    داكن
    نظام       # تتبع سمة النظام تلقائياً
نهاية

# ===================================================================
#       بيانات_سمة — Theme Data
# ===================================================================

صدّر صنف بيانات_سمة
    باني(اسم = "افتراضي")
        هذا.اسم = اسم
        هذا.لون_أساسي = 0x2196F3
        هذا.لون_ثانوي = 0x03DAC6
        هذا.لون_خلفية = 0xFFFFFF
        هذا.لون_سطح = 0xF5F5F5
        هذا.لون_نص = 0x000000
        هذا.لون_نص_ثانوي = 0x757575
        هذا.لون_خطأ = 0xF44336
        هذا.لون_نجاح = 0x4CAF50
        هذا.لون_تحذير = 0xFFC107
        هذا.حجم_خط = 14
        هذا.نصف_قطر_حافة = 8
        هذا.داكن = خطأ
    نهاية
نهاية

# ===================================================================
#       مدير_سمات — Theme Manager
# ===================================================================

صدّر صنف مدير_سمات
    باني()
        هذا._السمة_الحالية = "فاتح"
        هذا._سمات = {}
        هذا._مراقبون = []
        هذا._وضع = وضع_سمة.فاتح

        # تهيئة السمات الافتراضية
        متغير فاتح = جديد بيانات_سمة("فاتح")
        متغير داكن = جديد بيانات_سمة("داكن")
        داكن.لون_خلفية = 0x121212
        داكن.لون_سطح = 0x1E1E1E
        داكن.لون_نص = 0xFFFFFF
        داكن.لون_نص_ثانوي = 0xB0B0B0
        داكن.داكن = صحيح
        هذا._سمات["فاتح"] = فاتح
        هذا._سمات["داكن"] = داكن
    نهاية

    ## تعيين السمة
    دالة عيّن(اسم)
        هذا._السمة_الحالية = اسم
        حاول
            عين_سمة(اسم)
        امسك خ
            # تجاهل
        نهاية
        هذا._أشعر()
        ارجع هذا
    نهاية

    ## السمة الحالية
    دالة الحالية()
        ارجع هذا._السمة_الحالية
    نهاية

    ## بيانات السمة الحالية
    دالة البيانات()
        إذا (هذا._سمات[هذا._السمة_الحالية] != لاشيء)
            ارجع هذا._سمات[هذا._السمة_الحالية]
        نهاية
        ارجع جديد بيانات_سمة()
    نهاية

    ## تسجيل سمة مخصصة
    دالة سجّل(اسم, بيانات)
        هذا._سمات[اسم] = بيانات
        ارجع هذا
    نهاية

    ## تبديل بين فاتح وداكن
    دالة بدّل()
        إذا (هذا._السمة_الحالية == "فاتح")
            هذا.عيّن("داكن")
        وإلا
            هذا.عيّن("فاتح")
        نهاية
        ارجع هذا
    نهاية

    ## هل السمة داكنة؟
    دالة داكنة()
        ارجع هذا._السمة_الحالية == "داكن"
    نهاية

    ## سمة النظام
    دالة سمة_النظام()
        حاول
            ارجع سمة_النظام()
        امسك خ
            ارجع "فاتح"
        نهاية
    نهاية

    ## مراقبة تغييرات السمة
    دالة راقب(رد_نداء)
        هذا._مراقبون = هذا._مراقبون + [رد_نداء]
        ارجع هذا
    نهاية

    # ─── داخلي ───
    دالة _أشعر()
        لكل مراقب في هذا._مراقبون
            مراقب(هذا._السمة_الحالية, هذا.البيانات())
        نهاية
    نهاية
نهاية

# ===================================================================
#       دوال مساعدة (للتوافق مع API القديم)
# ===================================================================

## تعيين سمة التطبيق
صدّر دالة عيّن(اسم)
    حاول
        عين_سمة(اسم)
    امسك خ
        # تجاهل
    نهاية
نهاية

## السمة الحالية
صدّر دالة الحالية()
    حاول
        ارجع احصل_سمة()
    امسك خ
        ارجع "فاتح"
    نهاية
نهاية

## سمة النظام
صدّر دالة نظام()
    حاول
        ارجع سمة_النظام()
    امسك خ
        ارجع "فاتح"
    نهاية
نهاية
