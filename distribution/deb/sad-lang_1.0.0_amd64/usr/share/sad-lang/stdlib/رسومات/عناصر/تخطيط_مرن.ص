# ─── لف (Wrap) ───
صدّر صنف لف يرث عنصر
    باني(أطفال = لاشيء, اتجاه = لاشيء, محاذاة = لاشيء, مسافة = لاشيء, مسافة_تشغيل = لاشيء)
        هذا._نوع = "لف"
        هذا._خصائص = {}
        هذا._خصائص["اتجاه"] = اتجاه
        هذا._خصائص["محاذاة"] = محاذاة
        هذا._خصائص["مسافة"] = مسافة
        هذا._خصائص["مسافة_تشغيل"] = مسافة_تشغيل
        إذا (أطفال != لاشيء)
            هذا._أبناء = أطفال
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

