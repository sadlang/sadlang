# ===================================================================
# عناصر التخطيط المرن — Flex Layout Widgets
# ===================================================================
# ملاحظة: الأصناف التالية محذوفة (موجودة في ملفات أخرى):
#   مرن → حاويات/تخطيط.ص
#   تحويل → عناصر/تأثيرات.ص (تحويل_عنصر)
#   شفافية → عناصر/تأثيرات.ص
#
# الاستخدام:
#   استورد * من رسومات.عناصر.تخطيط_مرن
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── فراغ (Spacer) ───
صدّر صنف فراغ_عنصر يرث عنصر
    باني(نسبة = لاشيء)
        هذا._نوع = "فراغ"
        هذا._خصائص = {}
        هذا._خصائص["نسبة"] = نسبة
    نهاية
نهاية

# ─── محاذاة (Align) ───
صدّر صنف محاذاة يرث عنصر
    باني(طفل, أفقي = لاشيء, عمودي = لاشيء)
        هذا._نوع = "محاذاة"
        هذا._خصائص = {}
        هذا._خصائص["أفقي"] = أفقي
        هذا._خصائص["عمودي"] = عمودي
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

# ─── تحديد_حجم (SizedBox) ───
صدّر صنف تحديد_حجم يرث عنصر
    باني(طفل = لاشيء, عرض = لاشيء, ارتفاع = لاشيء)
        هذا._نوع = "تحديد_حجم"
        هذا._خصائص = {}
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

# ─── قيود (ConstrainedBox) ───
صدّر صنف قيود يرث عنصر
    باني(طفل = لاشيء, أدنى_عرض = لاشيء, أقصى_عرض = لاشيء, أدنى_ارتفاع = لاشيء, أقصى_ارتفاع = لاشيء)
        هذا._نوع = "قيود"
        هذا._خصائص = {}
        هذا._خصائص["أدنى_عرض"] = أدنى_عرض
        هذا._خصائص["أقصى_عرض"] = أقصى_عرض
        هذا._خصائص["أدنى_ارتفاع"] = أدنى_ارتفاع
        هذا._خصائص["أقصى_ارتفاع"] = أقصى_ارتفاع
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

