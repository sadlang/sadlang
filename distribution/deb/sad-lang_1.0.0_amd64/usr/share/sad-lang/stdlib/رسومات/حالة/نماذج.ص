# ===================================================================
# نظام التحقق من النماذج — Form Validation System
# ===================================================================
# مستوحى من Flutter (Form, FormField, TextFormField, validators)
#
# الاستخدام:
#   استورد * من رسومات.حالة.نماذج
# ===================================================================

# ─── محقق (Validator) ───
صدّر صنف محقق
    باني(دالة_تحقق, رسالة_خطأ)
        هذا._تحقق = دالة_تحقق
        هذا._رسالة = رسالة_خطأ
    نهاية

    دالة تحقق(قيمة)
        إذا (هذا._تحقق(قيمة))
            ارجع لاشيء
        وإلا
            ارجع هذا._رسالة
        نهاية
    نهاية
نهاية

# ─── محققات جاهزة ───
صدّر دالة مطلوب(رسالة)
    إذا (رسالة == لاشيء)
        رسالة = "هذا الحقل مطلوب"
    نهاية
    دالة _تحقق(ق)
        ارجع ق != لاشيء و ق != ""
    نهاية
    ارجع جديد محقق(_تحقق, رسالة)
نهاية

صدّر دالة حد_أدنى_طول(طول, رسالة)
    إذا (رسالة == لاشيء)
        رسالة = "الحد الأدنى " + طول + " حرف"
    نهاية
    دالة _تحقق(ق)
        ارجع ق != لاشيء و طول_نص(ق) >= طول
    نهاية
    ارجع جديد محقق(_تحقق, رسالة)
نهاية

صدّر دالة حد_أقصى_طول(طول, رسالة)
    إذا (رسالة == لاشيء)
        رسالة = "الحد الأقصى " + طول + " حرف"
    نهاية
    دالة _تحقق(ق)
        ارجع ق == لاشيء أو طول_نص(ق) <= طول
    نهاية
    ارجع جديد محقق(_تحقق, رسالة)
نهاية

صدّر دالة بريد_إلكتروني(رسالة)
    إذا (رسالة == لاشيء)
        رسالة = "بريد إلكتروني غير صالح"
    نهاية
    دالة _تحقق(ق)
        ارجع ق != لاشيء و يحتوي(ق, "@") و يحتوي(ق, ".")
    نهاية
    ارجع جديد محقق(_تحقق, رسالة)
نهاية

صدّر دالة رقم_فقط(رسالة)
    إذا (رسالة == لاشيء)
        رسالة = "أرقام فقط"
    نهاية
    دالة _تحقق(ق)
        ارجع هل_رقم(ق)
    نهاية
    ارجع جديد محقق(_تحقق, رسالة)
نهاية

صدّر دالة نطاق_رقمي(أدنى, أقصى, رسالة)
    إذا (رسالة == لاشيء)
        رسالة = "يجب أن يكون بين " + أدنى + " و " + أقصى
    نهاية
    دالة _تحقق(ق)
        ارجع هل_رقم(ق) و إلى_رقم(ق) >= أدنى و إلى_رقم(ق) <= أقصى
    نهاية
    ارجع جديد محقق(_تحقق, رسالة)
نهاية

# ─── حقل_تحقق (ValidatedField — form validation logic) ───
# ملاحظة: أُعيد تسميته من حقل_نموذج لتجنب التعارض مع عناصر/نماذج.ص
صدّر صنف حقل_تحقق
    باني(الاسم)
        هذا.الاسم = الاسم
        هذا.القيمة = ""
        هذا._محققات = []
        هذا._خطأ = لاشيء
        هذا._ملموس = خطأ
    نهاية

    دالة أضف_محقق(محقق)
        هذا._محققات.أضف(محقق)
        ارجع هذا
    نهاية

    دالة عيّن_قيمة(قيمة)
        هذا.القيمة = قيمة
        هذا._ملموس = صحيح
        هذا.تحقق()
    نهاية

    دالة تحقق()
        لكل م في هذا._محققات
            متغير نتيجة = م.تحقق(هذا.القيمة)
            إذا (نتيجة != لاشيء)
                هذا._خطأ = نتيجة
                ارجع خطأ
            نهاية
        نهاية
        هذا._خطأ = لاشيء
        ارجع صحيح
    نهاية

    دالة الخطأ()
        ارجع هذا._خطأ
    نهاية

    دالة صالح()
        ارجع هذا._خطأ == لاشيء و هذا._ملموس
    نهاية

    دالة إعادة_ضبط()
        هذا.القيمة = ""
        هذا._خطأ = لاشيء
        هذا._ملموس = خطأ
    نهاية
نهاية

# ─── نموذج (Form) ───
صدّر صنف نموذج
    باني()
        هذا._حقول = []
        هذا._عند_إرسال = لاشيء
    نهاية

    دالة أضف_حقل(حقل)
        هذا._حقول.أضف(حقل)
        ارجع هذا
    نهاية

    دالة حقل(اسم)
        لكل ح في هذا._حقول
            إذا (ح.الاسم == اسم)
                ارجع ح
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    دالة تحقق()
        متغير صالح = صحيح
        لكل ح في هذا._حقول
            إذا (ح.تحقق() == خطأ)
                صالح = خطأ
            نهاية
        نهاية
        ارجع صالح
    نهاية

    دالة عند_إرسال(دالة_معالجة)
        هذا._عند_إرسال = دالة_معالجة
        ارجع هذا
    نهاية

    دالة أرسل()
        إذا (هذا.تحقق() و هذا._عند_إرسال != لاشيء)
            متغير بيانات = {}
            لكل ح في هذا._حقول
                بيانات[ح.الاسم] = ح.القيمة
            نهاية
            هذا._عند_إرسال(بيانات)
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة إعادة_ضبط()
        لكل ح في هذا._حقول
            ح.إعادة_ضبط()
        نهاية
    نهاية

    دالة أخطاء()
        متغير أخطاء_الحقول = {}
        لكل ح في هذا._حقول
            إذا (ح.الخطأ() != لاشيء)
                أخطاء_الحقول[ح.الاسم] = ح.الخطأ()
            نهاية
        نهاية
        ارجع أخطاء_الحقول
    نهاية
نهاية

# ─── مساعدات بناء النماذج ───
صدّر دالة نموذج_سريع(حقول)
    متغير م = جديد نموذج()
    لكل اسم في حقول
        م.أضف_حقل(جديد حقل_نموذج(اسم))
    نهاية
    ارجع م
نهاية
