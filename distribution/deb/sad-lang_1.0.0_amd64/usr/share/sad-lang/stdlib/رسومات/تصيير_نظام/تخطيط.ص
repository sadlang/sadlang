# بروتوكول التخطيط — Layout Protocol
# ===================================================================
#
# (AR) هذا الملف يوفر نظام التخطيط المنخفض المستوى الذي يحسب
#      أحجام ومواقع عناصر الواجهة. يعمل كطبقة وسيطة بين شجرة
#      العناصر (Widget Tree) وعملية الرسم الفعلية.
#
#      بروتوكول التخطيط يعتمد على نظام القيود (Constraints):
#      - الأب يُرسل قيوداً للابن (أقصى/أدنى عرض وارتفاع)
#      - الابن يحسب حجمه ضمن هذه القيود
#      - الأب يحدد موقع الابن بناءً على الحجم الناتج
#
#      مطابق لـ flutter/rendering/box.dart
#      و flutter/rendering/sliver.dart
#      و flutter/rendering/flex.dart
#
# (EN) Low-level layout system that computes sizes and positions
#      of UI elements using a constraint-based protocol.
#
# الأصناف المُصدّرة:
#   - قيود (BoxConstraints)            — قيود الحجم
#   - حجم (Size)                       — حجم ثنائي الأبعاد
#   - كائن_تخطيط (RenderObject)        — كائن التصيير الأساسي
#   - تخطيط_صندوق (RenderBox)          — تخطيط صندوقي
#   - تخطيط_مرن (RenderFlex)           — تخطيط مرن (Flexbox)
#   - تخطيط_مكدس (RenderStack)         — تخطيط مكدس (Stack)
#   - تخطيط_شبكة (RenderGrid)          — تخطيط شبكي (Grid)
#   - قيود_شريحة (SliverConstraints)   — قيود الشرائح الكسولة
#   - هندسة_شريحة (SliverGeometry)     — هندسة الشريحة
#
# الاستخدام:
#   استورد * من رسومات.تصيير_نظام.تخطيط
# ===================================================================

# ─── ثوابت التخطيط ───
ثابت لانهاية = 999999999
ثابت محاذاة_بداية = "بداية"
ثابت محاذاة_وسط = "وسط"
ثابت محاذاة_نهاية = "نهاية"
ثابت محاذاة_تمدد = "تمدد"
ثابت محاذاة_بين = "توزيع_بين"
ثابت محاذاة_حول = "توزيع_حول"
ثابت محاذاة_متساوي = "توزيع_متساوي"

# ─── حجم (Size) ───
صدّر صنف حجم_ت
    # (AR) حجم ثنائي الأبعاد — عرض وارتفاع
    # (EN) Two-dimensional size — width and height
    باني(عرض = 0, ارتفاع = 0)
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
    نهاية

    دالة العرض()
        ارجع هذا._عرض
    نهاية

    دالة الارتفاع()
        ارجع هذا._ارتفاع
    نهاية

    دالة فارغ()
        ارجع هذا._عرض <= 0 و هذا._ارتفاع <= 0
    نهاية

    دالة لانهائي()
        ارجع هذا._عرض >= لانهاية أو هذا._ارتفاع >= لانهاية
    نهاية

    دالة يحتوي(إزاحة)
        ارجع إزاحة._س >= 0 و إزاحة._س < هذا._عرض و إزاحة._ص >= 0 و إزاحة._ص < هذا._ارتفاع
    نهاية

    دالة إلى_نص()
        ارجع "حجم(" + هذا._عرض + " × " + هذا._ارتفاع + ")"
    نهاية
نهاية

# ─── قيود (BoxConstraints) ───
صدّر صنف قيود
    # (AR) قيود الحجم — تحدد الحد الأدنى والأقصى للعرض والارتفاع
    #      الأب يُمرر القيود للابن، والابن يحسب حجمه ضمنها
    # (EN) Size constraints — define min/max width and height
    باني(أدنى_عرض = 0, أقصى_عرض = لانهاية, أدنى_ارتفاع = 0, أقصى_ارتفاع = لانهاية)
        هذا._أدنى_عرض = أدنى_عرض
        هذا._أقصى_عرض = أقصى_عرض
        هذا._أدنى_ارتفاع = أدنى_ارتفاع
        هذا._أقصى_ارتفاع = أقصى_ارتفاع
    نهاية

    دالة أدنى_عرض()
        ارجع هذا._أدنى_عرض
    نهاية

    دالة أقصى_عرض()
        ارجع هذا._أقصى_عرض
    نهاية

    دالة أدنى_ارتفاع()
        ارجع هذا._أدنى_ارتفاع
    نهاية

    دالة أقصى_ارتفاع()
        ارجع هذا._أقصى_ارتفاع
    نهاية

    دالة ضبط(حجم)
        # (AR) حصر الحجم ضمن القيود
        متغير ع = حجم.العرض()
        متغير ر = حجم.الارتفاع()
        إذا (ع < هذا._أدنى_عرض)
            ع = هذا._أدنى_عرض
        نهاية
        إذا (ع > هذا._أقصى_عرض)
            ع = هذا._أقصى_عرض
        نهاية
        إذا (ر < هذا._أدنى_ارتفاع)
            ر = هذا._أدنى_ارتفاع
        نهاية
        إذا (ر > هذا._أقصى_ارتفاع)
            ر = هذا._أقصى_ارتفاع
        نهاية
        ارجع جديد حجم_ت(ع, ر)
    نهاية

    دالة محكمة()
        # (AR) هل القيود محكمة (أدنى = أقصى)؟
        ارجع هذا._أدنى_عرض == هذا._أقصى_عرض و هذا._أدنى_ارتفاع == هذا._أقصى_ارتفاع
    نهاية

    دالة غير_محدودة()
        # (AR) هل القيود غير محدودة؟
        ارجع هذا._أقصى_عرض >= لانهاية و هذا._أقصى_ارتفاع >= لانهاية
    نهاية

    دالة إلى_نص()
        ارجع "قيود(عرض: " + هذا._أدنى_عرض + ".." + هذا._أقصى_عرض + ", ارتفاع: " + هذا._أدنى_ارتفاع + ".." + هذا._أقصى_ارتفاع + ")"
    نهاية
نهاية

# ─── دوال مساعدة لإنشاء قيود شائعة ───
صدّر دالة قيود_محكمة(عرض, ارتفاع)
    # (AR) إنشاء قيود ذات حجم ثابت — لا مجال للتغيير
    ارجع جديد قيود(عرض, عرض, ارتفاع, ارتفاع)
نهاية

صدّر دالة قيود_فضفاضة(أقصى_عرض, أقصى_ارتفاع)
    # (AR) إنشاء قيود فضفاضة — أدنى = 0
    ارجع جديد قيود(0, أقصى_عرض, 0, أقصى_ارتفاع)
نهاية

# ─── كائن_تصيير (RenderObject) — القاعدة ───
صدّر صنف كائن_تصيير
    # (AR) الصنف الأساسي لجميع كائنات التصيير
    #      يمثل عقدة واحدة في شجرة التصيير (Render Tree)
    #      يدير: التخطيط (layout)، الرسم (paint)، اختبار النقر (hit test)
    # (EN) Base class for all render objects in the render tree
    باني()
        هذا._أب = لاشيء
        هذا._أبناء = []
        هذا._يحتاج_تخطيط = صحيح
        هذا._يحتاج_رسم = صحيح
        هذا._عمق = 0
    نهاية

    دالة أضف_ابن(ابن)
        هذا._أبناء = هذا._أبناء + [ابن]
        ابن._أب = هذا
        ابن._عمق = هذا._عمق + 1
        هذا.علم_يحتاج_تخطيط()
    نهاية

    دالة أزل_ابن(ابن)
        متغير جديدة = []
        لكل ا في هذا._أبناء
            إذا (ا != ابن)
                جديدة = جديدة + [ا]
            نهاية
        نهاية
        هذا._أبناء = جديدة
        ابن._أب = لاشيء
        هذا.علم_يحتاج_تخطيط()
    نهاية

    دالة علم_يحتاج_تخطيط()
        # (AR) تعليم أن هذا الكائن وأسلافه يحتاجون إعادة تخطيط
        هذا._يحتاج_تخطيط = صحيح
        إذا (هذا._أب != لاشيء)
            هذا._أب.علم_يحتاج_تخطيط()
        نهاية
    نهاية

    دالة علم_يحتاج_رسم()
        # (AR) تعليم أن هذا الكائن يحتاج إعادة رسم
        هذا._يحتاج_رسم = صحيح
    نهاية

    دالة تخطيط(قيود)
        # (AR) حساب حجم وموقع هذا الكائن — يُستبدل في الأصناف الفرعية
        هذا._يحتاج_تخطيط = خطأ
    نهاية

    دالة رسم(سياق)
        # (AR) رسم هذا الكائن على الشاشة — يُستبدل في الأصناف الفرعية
        هذا._يحتاج_رسم = خطأ
    نهاية

    دالة اختبار_نقر(موقع)
        # (AR) هل النقطة المحددة داخل حدود هذا الكائن؟
        ارجع خطأ
    نهاية

    دالة الأبناء()
        ارجع هذا._أبناء
    نهاية

    دالة العمق()
        ارجع هذا._عمق
    نهاية
نهاية

# ─── تخطيط_صندوق (RenderBox) — تخطيط صندوقي ───
صدّر صنف تخطيط_صندوق يرث كائن_تصيير
    # (AR) كائن تصيير بنظام صندوقي — له حجم وموقع محددين
    #      يستخدم قيود صندوقية (BoxConstraints)
    # (EN) Box-model render object with definite size and position
    باني()
        هذا._أب = لاشيء
        هذا._أبناء = []
        هذا._يحتاج_تخطيط = صحيح
        هذا._يحتاج_رسم = صحيح
        هذا._عمق = 0
        هذا._حجم = جديد حجم_ت(0, 0)
        هذا._موقع = {"س": 0, "ص": 0}
    نهاية

    دالة الحجم()
        ارجع هذا._حجم
    نهاية

    دالة عيّن_حجم(حجم)
        هذا._حجم = حجم
        هذا.علم_يحتاج_رسم()
    نهاية

    دالة الموقع()
        ارجع هذا._موقع
    نهاية

    دالة عيّن_موقع(س, ص)
        هذا._موقع = {"س": س, "ص": ص}
    نهاية

    دالة تخطيط(قيود)
        # (AR) التخطيط الافتراضي: أخذ الحد الأدنى
        هذا._حجم = قيود.ضبط(هذا._حجم)
        هذا._يحتاج_تخطيط = خطأ
    نهاية

    دالة اختبار_نقر(موقع)
        ارجع هذا._حجم.يحتوي(موقع)
    نهاية
نهاية

# ─── تخطيط_مرن (RenderFlex) — Flexbox ───
صدّر صنف تخطيط_مرن يرث تخطيط_صندوق
    # (AR) تخطيط مرن (Flexbox) — يوزع الأبناء على المحور الرئيسي
    #      يدعم: اتجاه (أفقي/عمودي)، محاذاة رئيسية، محاذاة فرعية
    # (EN) Flex layout (Flexbox) — distributes children along main axis
    باني(اتجاه = "عمودي")
        هذا._أب = لاشيء
        هذا._أبناء = []
        هذا._يحتاج_تخطيط = صحيح
        هذا._يحتاج_رسم = صحيح
        هذا._عمق = 0
        هذا._حجم = جديد حجم_ت(0, 0)
        هذا._موقع = {"س": 0, "ص": 0}
        هذا._اتجاه = اتجاه
        هذا._محاذاة_رئيسية = محاذاة_بداية
        هذا._محاذاة_فرعية = محاذاة_بداية
        هذا._تباعد = 0
    نهاية

    دالة الاتجاه()
        ارجع هذا._اتجاه
    نهاية

    دالة عيّن_اتجاه(اتجاه)
        هذا._اتجاه = اتجاه
        هذا.علم_يحتاج_تخطيط()
    نهاية

    دالة عيّن_محاذاة_رئيسية(محاذاة)
        هذا._محاذاة_رئيسية = محاذاة
        هذا.علم_يحتاج_تخطيط()
    نهاية

    دالة عيّن_محاذاة_فرعية(محاذاة)
        هذا._محاذاة_فرعية = محاذاة
        هذا.علم_يحتاج_تخطيط()
    نهاية

    دالة عيّن_تباعد(تباعد)
        هذا._تباعد = تباعد
        هذا.علم_يحتاج_تخطيط()
    نهاية

    دالة تخطيط(قيود)
        # (AR) توزيع الأبناء على المحور — حساب مبسط
        متغير إزاحة_حالية = 0
        لكل ابن في هذا._أبناء
            إذا (هذا._اتجاه == "عمودي")
                ابن.عيّن_موقع(0, إزاحة_حالية)
                ابن.تخطيط(قيود)
                إزاحة_حالية = إزاحة_حالية + ابن.الحجم().الارتفاع() + هذا._تباعد
            وإلا
                ابن.عيّن_موقع(إزاحة_حالية, 0)
                ابن.تخطيط(قيود)
                إزاحة_حالية = إزاحة_حالية + ابن.الحجم().العرض() + هذا._تباعد
            نهاية
        نهاية
        هذا._يحتاج_تخطيط = خطأ
    نهاية
نهاية

# ─── تخطيط_مكدس (RenderStack) ───
صدّر صنف تخطيط_مكدس يرث تخطيط_صندوق
    # (AR) تخطيط مكدس — يرسم الأبناء فوق بعضهم
    # (EN) Stack layout — renders children on top of each other
    باني()
        هذا._أب = لاشيء
        هذا._أبناء = []
        هذا._يحتاج_تخطيط = صحيح
        هذا._يحتاج_رسم = صحيح
        هذا._عمق = 0
        هذا._حجم = جديد حجم_ت(0, 0)
        هذا._موقع = {"س": 0, "ص": 0}
        هذا._محاذاة = "أعلى_يمين"
        هذا._تلائم = "فضفاض"
    نهاية

    دالة تخطيط(قيود)
        # (AR) كل الأبناء يبدأون من الموقع (0,0) ويُكدّسون
        لكل ابن في هذا._أبناء
            ابن.عيّن_موقع(0, 0)
            ابن.تخطيط(قيود)
        نهاية
        هذا._يحتاج_تخطيط = خطأ
    نهاية
نهاية

# ─── قيود_شريحة (SliverConstraints) — للقوائم الكسولة ───
صدّر صنف قيود_شريحة
    # (AR) قيود خاصة بالشرائح الكسولة (مثل عمود_كسول)
    #      تصف المساحة المتاحة للتمرير
    # (EN) Constraints for sliver (lazy) lists
    باني(مدى_تمرير = 0, مدى_مرئي = 0, إزاحة_تمرير = 0, اتجاه = "عمودي")
        هذا._مدى_تمرير = مدى_تمرير
        هذا._مدى_مرئي = مدى_مرئي
        هذا._إزاحة_تمرير = إزاحة_تمرير
        هذا._اتجاه = اتجاه
    نهاية

    دالة المدى_المرئي()
        ارجع هذا._مدى_مرئي
    نهاية

    دالة إزاحة_التمرير()
        ارجع هذا._إزاحة_تمرير
    نهاية
نهاية

# ─── هندسة_شريحة (SliverGeometry) — نتيجة تخطيط الشريحة ───
صدّر صنف هندسة_شريحة
    # (AR) نتيجة تخطيط شريحة — المدى المرسوم والمتبقي
    # (EN) Sliver layout result — painted and remaining extents
    باني(مدى_تمرير = 0, مدى_رسم = 0, مدى_أقصى_رسم = 0)
        هذا._مدى_تمرير = مدى_تمرير
        هذا._مدى_رسم = مدى_رسم
        هذا._مدى_أقصى_رسم = مدى_أقصى_رسم
    نهاية

    دالة مدى_التمرير()
        ارجع هذا._مدى_تمرير
    نهاية

    دالة مدى_الرسم()
        ارجع هذا._مدى_رسم
    نهاية
نهاية
