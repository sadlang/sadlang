# ===================================================================
# Custom Painter — الرسام المخصص
# ===================================================================
# مطابق لـ Flutter CustomPainter, Canvas, Paint
# دعم كامل للرسم المخصص والأشكال والمسارات
#
# الاستخدام:
#   استورد * من رسومات.رسم.مخصص
#
#   رسم_مخصص(
#       رسام: صنف_رسام_خاص يرث رسام
#           دالة ارسم(لوحة, حجم)
#               لوحة.ارسم_دائرة(50, 50, 30, فرشاة(لون: "#FF0000"))
#           نهاية
#       نهاية
#   )
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    فرشاة (Paint)
# ===================================================================
صدّر صنف فرشاة
    باني(لون = "#000000", نمط = "ملء", سماكة = 1.0,
         نهاية_خط = "دائري", وصلة_خط = "دائرية",
         مضاد_التعرج = صحيح, شفافية = 1.0,
         وضع_مزج = "عادي", مرشح_لون = لاشيء,
         ظل = لاشيء)
        هذا._لون = لون
        هذا._نمط = نمط  # ملء | حد | ملء_وحد
        هذا._سماكة = سماكة
        هذا._نهاية_خط = نهاية_خط  # مربع | دائري | مسطح
        هذا._وصلة_خط = وصلة_خط  # حاد | دائرية | مشطوفة
        هذا._مضاد_التعرج = مضاد_التعرج
        هذا._شفافية = شفافية
        هذا._وضع_مزج = وضع_مزج
        هذا._مرشح_لون = مرشح_لون
        هذا._ظل = ظل
    نهاية

    دالة عيّن_لون(لون)
        هذا._لون = لون
        ارجع هذا
    نهاية

    دالة عيّن_نمط(نمط)
        هذا._نمط = نمط
        ارجع هذا
    نهاية

    دالة عيّن_سماكة(سماكة)
        هذا._سماكة = سماكة
        ارجع هذا
    نهاية

    دالة نسخ()
        ارجع فرشاة(
            لون: هذا._لون,
            نمط: هذا._نمط,
            سماكة: هذا._سماكة,
            نهاية_خط: هذا._نهاية_خط,
            وصلة_خط: هذا._وصلة_خط,
            مضاد_التعرج: هذا._مضاد_التعرج,
            شفافية: هذا._شفافية
        )
    نهاية
نهاية

# ===================================================================
#                    حجم (Size)
# ===================================================================
صدّر صنف حجم
    باني(عرض = 0, ارتفاع = 0)
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
    نهاية

    دالة العرض()
        ارجع هذا._عرض
    نهاية

    دالة الارتفاع()
        ارجع هذا._ارتفاع
    نهاية

    دالة المساحة()
        ارجع هذا._عرض * هذا._ارتفاع
    نهاية

    دالة المركز()
        ارجع نقطة(هذا._عرض / 2, هذا._ارتفاع / 2)
    نهاية
نهاية

# ===================================================================
#                    نقطة (Offset)
# ===================================================================
صدّر صنف نقطة
    باني(س = 0, ص = 0)
        هذا._س = س
        هذا._ص = ص
    نهاية

    دالة س()
        ارجع هذا._س
    نهاية

    دالة ص()
        ارجع هذا._ص
    نهاية

    دالة المسافة_إلى(نقطة_أخرى)
        متغير فرق_س = هذا._س - نقطة_أخرى.س()
        متغير فرق_ص = هذا._ص - نقطة_أخرى.ص()
        ارجع (فرق_س * فرق_س + فرق_ص * فرق_ص) ** 0.5
    نهاية

    دالة زائد(نقطة_أخرى)
        ارجع نقطة(هذا._س + نقطة_أخرى.س(), هذا._ص + نقطة_أخرى.ص())
    نهاية

    دالة ناقص(نقطة_أخرى)
        ارجع نقطة(هذا._س - نقطة_أخرى.س(), هذا._ص - نقطة_أخرى.ص())
    نهاية
نهاية

# ===================================================================
#                    مستطيل (Rect)
# ===================================================================
صدّر صنف مستطيل
    باني(يسار = 0, أعلى = 0, يمين = 0, أسفل = 0)
        هذا._يسار = يسار
        هذا._أعلى = أعلى
        هذا._يمين = يمين
        هذا._أسفل = أسفل
    نهاية

    ساكن دالة من_حجم(عرض, ارتفاع)
        ارجع مستطيل(0, 0, عرض, ارتفاع)
    نهاية

    ساكن دالة من_مركز(مركز, عرض, ارتفاع)
        متغير نصف_عرض = عرض / 2
        متغير نصف_ارتفاع = ارتفاع / 2
        ارجع مستطيل(
            مركز.س() - نصف_عرض,
            مركز.ص() - نصف_ارتفاع,
            مركز.س() + نصف_عرض,
            مركز.ص() + نصف_ارتفاع
        )
    نهاية

    ساكن دالة من_دائرة(مركز, نصف_قطر)
        ارجع مستطيل(
            مركز.س() - نصف_قطر,
            مركز.ص() - نصف_قطر,
            مركز.س() + نصف_قطر,
            مركز.ص() + نصف_قطر
        )
    نهاية

    دالة العرض()
        ارجع هذا._يمين - هذا._يسار
    نهاية

    دالة الارتفاع()
        ارجع هذا._أسفل - هذا._أعلى
    نهاية

    دالة الحجم()
        ارجع حجم(هذا.العرض(), هذا.الارتفاع())
    نهاية

    دالة المركز()
        ارجع نقطة(
            (هذا._يسار + هذا._يمين) / 2,
            (هذا._أعلى + هذا._أسفل) / 2
        )
    نهاية

    دالة يحتوي(نقطة)
        ارجع نقطة.س() >= هذا._يسار و نقطة.س() <= هذا._يمين و
               نقطة.ص() >= هذا._أعلى و نقطة.ص() <= هذا._أسفل
    نهاية
نهاية

# ===================================================================
#                    مسار (Path)
# ===================================================================
صدّر صنف مسار
    باني()
        هذا._أوامر = []
    نهاية

    دالة انقل_إلى(س, ص)
        هذا._أوامر.أضف({"نوع": "انقل", "س": س, "ص": ص})
        ارجع هذا
    نهاية

    دالة خط_إلى(س, ص)
        هذا._أوامر.أضف({"نوع": "خط", "س": س, "ص": ص})
        ارجع هذا
    نهاية

    دالة منحنى_تربيعي_إلى(تحكم_س, تحكم_ص, س, ص)
        هذا._أوامر.أضف({
            "نوع": "منحنى_تربيعي",
            "تحكم_س": تحكم_س, "تحكم_ص": تحكم_ص,
            "س": س, "ص": ص
        })
        ارجع هذا
    نهاية

    دالة منحنى_مكعب_إلى(تحكم1_س, تحكم1_ص, تحكم2_س, تحكم2_ص, س, ص)
        هذا._أوامر.أضف({
            "نوع": "منحنى_مكعب",
            "تحكم1_س": تحكم1_س, "تحكم1_ص": تحكم1_ص,
            "تحكم2_س": تحكم2_س, "تحكم2_ص": تحكم2_ص,
            "س": س, "ص": ص
        })
        ارجع هذا
    نهاية

    دالة قوس_إلى(مستطيل, زاوية_بدء, زاوية_نهاية, عكس_الساعة = خطأ)
        هذا._أوامر.أضف({
            "نوع": "قوس",
            "مستطيل": مستطيل,
            "زاوية_بدء": زاوية_بدء,
            "زاوية_نهاية": زاوية_نهاية,
            "عكس_الساعة": عكس_الساعة
        })
        ارجع هذا
    نهاية

    دالة أضف_مستطيل(مستطيل)
        هذا._أوامر.أضف({"نوع": "مستطيل", "م": مستطيل})
        ارجع هذا
    نهاية

    دالة أضف_مستطيل_دائري(مستطيل, نصف_قطر)
        هذا._أوامر.أضف({"نوع": "مستطيل_دائري", "م": مستطيل, "نق": نصف_قطر})
        ارجع هذا
    نهاية

    دالة أضف_بيضاوي(مستطيل)
        هذا._أوامر.أضف({"نوع": "بيضاوي", "م": مستطيل})
        ارجع هذا
    نهاية

    دالة أضف_مضلع(نقاط)
        هذا._أوامر.أضف({"نوع": "مضلع", "نقاط": نقاط})
        ارجع هذا
    نهاية

    دالة أغلق()
        هذا._أوامر.أضف({"نوع": "أغلق"})
        ارجع هذا
    نهاية

    دالة أعد_تعيين()
        هذا._أوامر = []
        ارجع هذا
    نهاية

    دالة الأوامر()
        ارجع هذا._أوامر
    نهاية
نهاية

# ===================================================================
#                    لوحة (Canvas)
# ===================================================================
صدّر صنف لوحة
    باني()
        هذا._عمليات = []
        هذا._حالة = []
    نهاية

    # ─── رسم الأشكال الأساسية ───
    دالة ارسم_خط(بداية, نهاية, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "خط",
            "بداية": بداية,
            "نهاية": نهاية,
            "فرشاة": فرشاة
        })
    نهاية

    دالة ارسم_مستطيل(مستطيل, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "مستطيل",
            "م": مستطيل,
            "فرشاة": فرشاة
        })
    نهاية

    دالة ارسم_مستطيل_دائري(مستطيل, نصف_قطر, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "مستطيل_دائري",
            "م": مستطيل,
            "نق": نصف_قطر,
            "فرشاة": فرشاة
        })
    نهاية

    دالة ارسم_دائرة(مركز, نصف_قطر, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "دائرة",
            "مركز": مركز,
            "نق": نصف_قطر,
            "فرشاة": فرشاة
        })
    نهاية

    دالة ارسم_بيضاوي(مستطيل, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "بيضاوي",
            "م": مستطيل,
            "فرشاة": فرشاة
        })
    نهاية

    دالة ارسم_قوس(مستطيل, زاوية_بدء, زاوية_نهاية, استخدم_مركز, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "قوس",
            "م": مستطيل,
            "بدء": زاوية_بدء,
            "نهاية": زاوية_نهاية,
            "مركز": استخدم_مركز,
            "فرشاة": فرشاة
        })
    نهاية

    دالة ارسم_مسار(مسار, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "مسار",
            "مسار": مسار,
            "فرشاة": فرشاة
        })
    نهاية

    دالة ارسم_نقطة(نقطة, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "نقطة",
            "نقطة": نقطة,
            "فرشاة": فرشاة
        })
    نهاية

    دالة ارسم_نقاط(نقاط, وضع, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "نقاط",
            "نقاط": نقاط,
            "وضع": وضع,
            "فرشاة": فرشاة
        })
    نهاية

    # ─── رسم الصور والنصوص ───
    دالة ارسم_صورة(صورة, نقطة)
        هذا._عمليات.أضف({
            "نوع": "صورة",
            "صورة": صورة,
            "نقطة": نقطة
        })
    نهاية

    دالة ارسم_صورة_مستطيل(صورة, مصدر, هدف, فرشاة)
        هذا._عمليات.أضف({
            "نوع": "صورة_مستطيل",
            "صورة": صورة,
            "مصدر": مصدر,
            "هدف": هدف,
            "فرشاة": فرشاة
        })
    نهاية

    دالة ارسم_نص(نص, نقطة, نمط_نص)
        هذا._عمليات.أضف({
            "نوع": "نص",
            "نص": نص,
            "نقطة": نقطة,
            "نمط": نمط_نص
        })
    نهاية

    دالة ارسم_فقرة(فقرة, نقطة)
        هذا._عمليات.أضف({
            "نوع": "فقرة",
            "فقرة": فقرة,
            "نقطة": نقطة
        })
    نهاية

    # ─── التحويلات ───
    دالة احفظ()
        هذا._حالة.أضف(هذا._عمليات.حجم())
    نهاية

    دالة استعد()
        إذا (هذا._حالة.حجم() > 0)
            متغير موضع = هذا._حالة.أزل_الأخير()
            بينما (هذا._عمليات.حجم() > موضع)
                هذا._عمليات.أزل_الأخير()
            نهاية
        نهاية
    نهاية

    دالة انقل(نقطة)
        هذا._عمليات.أضف({
            "نوع": "انقل",
            "س": نقطة.س(),
            "ص": نقطة.ص()
        })
    نهاية

    دالة دوّر(زاوية)
        هذا._عمليات.أضف({
            "نوع": "دوّر",
            "زاوية": زاوية
        })
    نهاية

    دالة مقياس(س, ص)
        هذا._عمليات.أضف({
            "نوع": "مقياس",
            "س": س,
            "ص": ص
        })
    نهاية

    دالة حوّل(مصفوفة)
        هذا._عمليات.أضف({
            "نوع": "حوّل",
            "مصفوفة": مصفوفة
        })
    نهاية

    # ─── القص ───
    دالة اقصص_مستطيل(مستطيل)
        هذا._عمليات.أضف({
            "نوع": "قص_مستطيل",
            "م": مستطيل
        })
    نهاية

    دالة اقصص_مسار(مسار)
        هذا._عمليات.أضف({
            "نوع": "قص_مسار",
            "مسار": مسار
        })
    نهاية

    # ─── الظلال ───
    دالة ارسم_ظل(مسار, لون, ارتفاع)
        هذا._عمليات.أضف({
            "نوع": "ظل",
            "مسار": مسار,
            "لون": لون,
            "ارتفاع": ارتفاع
        })
    نهاية

    دالة العمليات()
        ارجع هذا._عمليات
    نهاية
نهاية

# ===================================================================
#                    رسام (CustomPainter base class)
# ===================================================================
صدّر صنف رسام
    باني()
        # لا شيء
    نهاية

    # يجب أن يُنفذ في الصنف الموروث
    دالة ارسم(لوحة, حجم)
        # ارسم هنا
    نهاية

    # هل يجب إعادة الرسم؟
    دالة يجب_إعادة_الرسم(رسام_قديم)
        ارجع صحيح
    نهاية
نهاية

# ===================================================================
#                    رسم_مخصص (CustomPaint Widget)
# ===================================================================
صدّر صنف رسم_مخصص يرث عنصر
    باني(رسام = لاشيء, رسام_مقدمة = لاشيء, حجم = لاشيء,
         ابن = لاشيء, سيقص = خطأ)
        هذا._نوع = "رسم_مخصص"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["رسام"] = رسام
        هذا._خصائص["رسام_مقدمة"] = رسام_مقدمة
        هذا._خصائص["حجم"] = حجم
        هذا._خصائص["سيقص"] = سيقص
    نهاية
نهاية

# ===================================================================
#                    تدرج (Gradient)
# ===================================================================
صدّر صنف تدرج_خطي
    باني(بداية = لاشيء, نهاية = لاشيء, ألوان = [], توقفات = [])
        هذا._بداية = بداية
        هذا._نهاية = نهاية
        هذا._ألوان = ألوان
        هذا._توقفات = توقفات
    نهاية

    دالة إنشاء_فرشاة(مستطيل)
        متغير ف = فرشاة()
        # تطبيق التدرج
        ارجع ف
    نهاية
نهاية

صدّر صنف تدرج_شعاعي
    باني(مركز = لاشيء, نصف_قطر = 0, ألوان = [], توقفات = [],
         مركز_بؤري = لاشيء, نصف_قطر_بؤري = 0)
        هذا._مركز = مركز
        هذا._نصف_قطر = نصف_قطر
        هذا._ألوان = ألوان
        هذا._توقفات = توقفات
        هذا._مركز_بؤري = مركز_بؤري
        هذا._نصف_قطر_بؤري = نصف_قطر_بؤري
    نهاية
نهاية

صدّر صنف تدرج_مسح
    باني(مركز = لاشيء, زاوية_بدء = 0, زاوية_نهاية = 6.28,
         ألوان = [], توقفات = [])
        هذا._مركز = مركز
        هذا._زاوية_بدء = زاوية_بدء
        هذا._زاوية_نهاية = زاوية_نهاية
        هذا._ألوان = ألوان
        هذا._توقفات = توقفات
    نهاية
نهاية

# ===================================================================
#                    دوال مساعدة
# ===================================================================

# رسام دائرة بسيط
صدّر دالة رسام_دائرة(لون, نصف_قطر)
    صنف _رسام_دائرة يرث رسام
        باني()
            الأساس.باني()
        نهاية

        دالة ارسم(لوحة, حجم)
            متغير مركز = حجم().المركز()
            لوحة.ارسم_دائرة(مركز, نصف_قطر, فرشاة(لون: لون))
        نهاية
    نهاية
    
    ارجع _رسام_دائرة()
نهاية

# رسام مستطيل بسيط
صدّر دالة رسام_مستطيل(لون)
    صنف _رسام_مستطيل يرث رسام
        باني()
            الأساس.باني()
        نهاية

        دالة ارسم(لوحة, حجم)
            لوحة.ارسم_مستطيل(
                مستطيل.من_حجم(حجم().العرض(), حجم().الارتفاع()),
                فرشاة(لون: لون)
            )
        نهاية
    نهاية
    
    ارجع _رسام_مستطيل()
نهاية
