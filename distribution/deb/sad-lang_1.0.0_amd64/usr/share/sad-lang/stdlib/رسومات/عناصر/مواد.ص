# ===================================================================
# عناصر Material Design — أسطح وعناصر تحكم
# ===================================================================
# ملاحظة: الأصناف التالية محذوفة (موجودة في ملفات أخرى):
#   بطاقة → حاويات/قوائم.ص
#   شارة → عناصر/صور.ص
#   فاصل → حاويات/تخطيط.ص
#   تلميح → حاويات/حوارات.ص
#
# الاستخدام:
#   استورد * من رسومات.عناصر.مواد
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── شريحة (Chip) ───
صدّر صنف شريحة يرث عنصر
    باني(تسمية, أيقونة = لاشيء, لون = لاشيء, عند_الضغط = لاشيء, حذف = لاشيء, محدد = لاشيء)
        هذا._نوع = "شريحة"
        هذا._خصائص = {}
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["أيقونة"] = أيقونة
        هذا._خصائص["لون"] = لون
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["حذف"] = حذف
        هذا._خصائص["محدد"] = محدد
    نهاية
نهاية

