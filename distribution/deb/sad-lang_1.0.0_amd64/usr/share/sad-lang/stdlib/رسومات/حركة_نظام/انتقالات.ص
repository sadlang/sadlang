# ===================================================================
# انتقالات الحركة — Transitions
# ===================================================================
# انتقالات صريحة (Explicit Transitions)
# مطابق لـ flutter/widgets/transitions.dart
#
# الاستخدام:
#   استورد * من رسومات.حركة_نظام.انتقالات
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── انتقال_تلاشي (FadeTransition) ───
صدّر صنف انتقال_تلاشي يرث عنصر
    باني(شفافية = لاشيء, ابن = لاشيء)
        هذا._نوع = "انتقال_تلاشي"
        هذا._خصائص = {}
        هذا._خصائص["شفافية"] = شفافية
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

