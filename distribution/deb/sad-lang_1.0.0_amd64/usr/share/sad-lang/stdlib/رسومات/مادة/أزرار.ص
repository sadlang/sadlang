# ─── زر_مرتفع (ElevatedButton) ───
صدّر صنف زر_مرتفع يرث عنصر
    باني(نص = لاشيء, عند_الضغط = لاشيء, أيقونة = لاشيء, نمط = لاشيء)
        هذا._نوع = "زر_مرتفع"
        هذا._خصائص = {}
        هذا._خصائص["نص"] = نص
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["أيقونة"] = أيقونة
        هذا._خصائص["نمط"] = نمط
        هذا._خصائص["معطل"] = خطأ
        هذا._خصائص["تحميل"] = خطأ
    نهاية

    دالة مع_أيقونة(أيقونة)
        هذا._خصائص["أيقونة"] = أيقونة
        ارجع هذا
    نهاية

    دالة مع_نمط(نمط)
        هذا._خصائص["نمط"] = نمط
        ارجع هذا
    نهاية

    دالة تحميل(قيمة)
        هذا._خصائص["تحميل"] = قيمة
        ارجع هذا
    نهاية
نهاية

