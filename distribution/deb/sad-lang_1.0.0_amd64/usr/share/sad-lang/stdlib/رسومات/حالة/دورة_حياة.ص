# ===================================================================
# دورة حياة العنصر — Widget Lifecycle
# ===================================================================
# مستوحى من Flutter (StatefulWidget, State)
#
# الاستخدام:
#   استورد * من رسومات.حالة.دورة_حياة
#
# الأصناف:
#   - عنصر_حالة: عنصر يحفظ حالة داخلية (مثل StatefulWidget)
#   - حالة_عنصر: حالة مرتبطة بعنصر (مثل State<T>)
# ===================================================================

# ─── حالة_عنصر (State) ───
صدّر صنف حالة_عنصر
    باني()
        هذا._مُهيَّأ = خطأ
        هذا._مُركَّب = خطأ
        هذا._مُعاملات = {}
    نهاية

    # تُستدعى مرة واحدة عند الإنشاء (مثل initState)
    دالة تهيئة()
        # يُعاد تعريفها في الأصناف الفرعية
    نهاية

    # تُستدعى عند تغيير المعاملات (مثل didUpdateWidget)
    دالة عند_تحديث(معاملات_قديمة)
        # يُعاد تعريفها في الأصناف الفرعية
    نهاية

    # تُستدعى عند التنظيف (مثل dispose)
    دالة تنظيف()
        # يُعاد تعريفها في الأصناف الفرعية
    نهاية

    # تبني العنصر (مثل build)
    دالة بناء()
        # يُعاد تعريفها — يجب إرجاع عنصر واجهة
        ارجع لاشيء
    نهاية

    # تحديث الحالة مع إعادة البناء (مثل setState)
    دالة حدّث(دالة_تحديث)
        دالة_تحديث()
        تحديث_حالة()
    نهاية

    # هل الحالة مُهيَّأة؟
    دالة مُهيَّأ()
        ارجع هذا._مُهيَّأ
    نهاية

    دالة _تهيئة_داخلية()
        إذا (ليس هذا._مُهيَّأ)
            هذا._مُهيَّأ = صحيح
            هذا.تهيئة()
        نهاية
    نهاية

    دالة _تنظيف_داخلي()
        إذا (هذا._مُهيَّأ)
            هذا.تنظيف()
            هذا._مُهيَّأ = خطأ
        نهاية
    نهاية
نهاية

# ─── عنصر_حالة (StatefulWidget) ───
صدّر صنف عنصر_حالة
    باني(دالة_إنشاء_حالة)
        هذا._إنشاء_حالة = دالة_إنشاء_حالة
        هذا._حالة = لاشيء
    نهاية

    دالة احصل_حالة()
        إذا (هذا._حالة == لاشيء)
            هذا._حالة = هذا._إنشاء_حالة()
            هذا._حالة._تهيئة_داخلية()
        نهاية
        ارجع هذا._حالة
    نهاية

    دالة بناء()
        متغير ح = هذا.احصل_حالة()
        ارجع ح.بناء()
    نهاية

    دالة تنظيف()
        إذا (هذا._حالة != لاشيء)
            هذا._حالة._تنظيف_داخلي()
        نهاية
    نهاية
نهاية

# ─── مفتاح فريد (Key) — لتعريف العناصر بشكل فريد ───
صدّر صنف مفتاح_فريد
    باني(قيمة)
        هذا.القيمة = قيمة
    نهاية
نهاية

# ─── دالة مساعدة لإنشاء عنصر حالة ───
صدّر دالة حالة_من(دالة_إنشاء)
    ارجع جديد عنصر_حالة(دالة_إنشاء)
نهاية
