# ===================================================================
# نظام مراقبة الاتصال — Connectivity & App Lifecycle
# ===================================================================
# مراقبة حالة الشبكة ودورة حياة التطبيق
#
# الاستخدام:
#   استورد * من رسومات.حالة.اتصال
# ===================================================================

# ─── مراقب_اتصال (ConnectivityMonitor) ───
صدّر صنف مراقب_اتصال
    باني()
        هذا._حالة = "غير_معروف"
        هذا._مستمعون = []
        هذا._مؤقت = لاشيء
    نهاية

    دالة ابدأ(فترة)
        إذا (فترة == لاشيء)
            فترة = 5000
        نهاية
        متغير ذات = هذا
        دالة _فحص()
            متغير حالة_حالية = "متصل"
            إذا (هل_متصل() == خطأ)
                حالة_حالية = "غير_متصل"
            نهاية
            إذا (حالة_حالية != ذات._حالة)
                ذات._حالة = حالة_حالية
                لكل م في ذات._مستمعون
                    م(حالة_حالية)
                نهاية
            نهاية
        نهاية
        هذا._مؤقت = كل_مدة(فترة, _فحص)
    نهاية

    دالة أوقف()
        إذا (هذا._مؤقت != لاشيء)
            أوقف_مؤقت(هذا._مؤقت)
            هذا._مؤقت = لاشيء
        نهاية
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة متصل()
        ارجع هذا._حالة == "متصل"
    نهاية

    دالة عند_تغيير(مستمع)
        هذا._مستمعون.أضف(مستمع)
        ارجع هذا
    نهاية
نهاية

# ─── مراقب_دورة_حياة (AppLifecycleObserver) ───
صدّر صنف مراقب_دورة_حياة
    باني()
        هذا._مستمعون = {}
    نهاية

    دالة عند_استئناف(مستمع)
        إذا (هذا._مستمعون["استئناف"] == لاشيء)
            هذا._مستمعون["استئناف"] = []
        نهاية
        هذا._مستمعون["استئناف"].أضف(مستمع)
        ارجع هذا
    نهاية

    دالة عند_إيقاف(مستمع)
        إذا (هذا._مستمعون["إيقاف"] == لاشيء)
            هذا._مستمعون["إيقاف"] = []
        نهاية
        هذا._مستمعون["إيقاف"].أضف(مستمع)
        ارجع هذا
    نهاية

    دالة عند_خلفية(مستمع)
        إذا (هذا._مستمعون["خلفية"] == لاشيء)
            هذا._مستمعون["خلفية"] = []
        نهاية
        هذا._مستمعون["خلفية"].أضف(مستمع)
        ارجع هذا
    نهاية

    دالة أشعر(حدث)
        متغير م = هذا._مستمعون[حدث]
        إذا (م != لاشيء)
            لكل مستمع في م
                مستمع()
            نهاية
        نهاية
    نهاية
نهاية

# ─── مدير_أخطاء (ErrorHandler) ───
صدّر صنف مدير_أخطاء
    باني()
        هذا._معالجات = []
    نهاية

    دالة أضف(معالج)
        هذا._معالجات.أضف(معالج)
    نهاية

    دالة عالج(رسالة_خطأ)
        لكل م في هذا._معالجات
            م(رسالة_خطأ)
        نهاية
    نهاية
نهاية

# ─── singleton ───
متغير _اتصال = لاشيء

صدّر دالة الاتصال()
    إذا (_اتصال == لاشيء)
        _اتصال = جديد مراقب_اتصال()
    نهاية
    ارجع _اتصال
نهاية
