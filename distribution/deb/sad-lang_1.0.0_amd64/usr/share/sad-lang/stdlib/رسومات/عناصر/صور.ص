استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    صورة أساسية
# ===================================================================

صدّر صنف صورة يرث عنصر
    باني(مصدر, عرض = لاشيء, ارتفاع = لاشيء, ملائمة = لاشيء, زوايا = لاشيء, ظل = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "صورة"
        هذا._خصائص = {}
        هذا._خصائص["مصدر"] = مصدر
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["ملائمة"] = ملائمة
        هذا._خصائص["زوايا"] = زوايا
        هذا._خصائص["ظل"] = ظل
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    دالة احصل_المصدر()
        ارجع هذا._خصائص["مصدر"]
    نهاية

    دالة عيّن_المصدر(قيمة)
        هذا._خصائص["مصدر"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_الأبعاد(عرض, ارتفاع)
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        ارجع هذا
    نهاية
نهاية

