استورد * من رسومات.أساس.عنصر

# ─── بيانات_استعلام (MediaQueryData) ───
صدّر صنف بيانات_استعلام
    باني()
        هذا.حجم = {"عرض": 0, "ارتفاع": 0}
        هذا.نسبة_بكسل = 1.0
        هذا.حشو = {"أعلى": 0, "يمين": 0, "أسفل": 0, "يسار": 0}
        هذا.حشو_عرض = {"أعلى": 0, "يمين": 0, "أسفل": 0, "يسار": 0}
        هذا.مقياس_نص = 1.0
        هذا.سطوع_منصة = "فاتح"
        هذا.تباين_عالي = خطأ
        هذا.تعطيل_حركات = خطأ
        هذا.جرأة_نص = خطأ
        هذا.عكس_ألوان = خطأ
        هذا.وضع_التنقل = "إيماءات"
        هذا.اتجاه = "عمودي"
        هذا.نوع_الجهاز = "هاتف"
    نهاية

    # ─── نسخ مع تعديلات ───
    دالة انسخ(
        حجم = لاشيء,
        نسبة_بكسل = لاشيء,
        حشو = لاشيء,
        مقياس_نص = لاشيء,
        سطوع_منصة = لاشيء
    )
        متغير جديد = جديد بيانات_استعلام()
        جديد.حجم = حجم أو هذا.حجم
        جديد.نسبة_بكسل = نسبة_بكسل أو هذا.نسبة_بكسل
        جديد.حشو = حشو أو هذا.حشو
        جديد.مقياس_نص = مقياس_نص أو هذا.مقياس_نص
        جديد.سطوع_منصة = سطوع_منصة أو هذا.سطوع_منصة
        ارجع جديد
    نهاية

    # ─── خصائص محسوبة ───
    دالة العرض()
        ارجع هذا.حجم["عرض"]
    نهاية

    دالة الارتفاع()
        ارجع هذا.حجم["ارتفاع"]
    نهاية

    دالة عرض_منطقي()
        ارجع هذا.حجم["عرض"] / هذا.نسبة_بكسل
    نهاية

    دالة ارتفاع_منطقي()
        ارجع هذا.حجم["ارتفاع"] / هذا.نسبة_بكسل
    نهاية

    دالة من_الهاتف()
        ارجع هذا.نوع_الجهاز == "هاتف"
    نهاية

    دالة من_الجهاز_اللوحي()
        ارجع هذا.نوع_الجهاز == "لوحي"
    نهاية

    دالة من_سطح_المكتب()
        ارجع هذا.نوع_الجهاز == "سطح_مكتب"
    نهاية

    دالة في_الوضع_الأفقي()
        ارجع هذا.اتجاه == "أفقي"
    نهاية

    دالة في_الوضع_العمودي()
        ارجع هذا.اتجاه == "عمودي"
    نهاية

    دالة داكن()
        ارجع هذا.سطوع_منصة == "داكن"
    نهاية
نهاية

# ─── استعلام_وسائط (MediaQuery Widget) ───
صدّر صنف استعلام_وسائط يرث عنصر
    باني(بيانات، ابن)
        هذا._نوع = "استعلام_وسائط"
        هذا._بيانات = بيانات
        هذا._ابن = ابن
    نهاية

    دالة البيانات()
        ارجع هذا._بيانات
    نهاية

    # ─── الحصول على البيانات من السياق ───
    ساكن دالة من(سياق)
        # البحث في شجرة العناصر عن أقرب MediaQuery
        متغير عنصر = سياق
        بينما (عنصر != لاشيء)
            إذا (عنصر.النوع() == "استعلام_وسائط")
                ارجع عنصر.البيانات()
            نهاية
            عنصر = عنصر.الأب()
        نهاية
        # إرجاع بيانات افتراضية
        ارجع بيانات_استعلام_الجذر()
    نهاية

    # ─── الحجم فقط ───
    ساكن دالة حجم_من(سياق)
        ارجع استعلام_وسائط.من(سياق).حجم
    نهاية

    # ─── الاتجاه فقط ───
    ساكن دالة اتجاه_من(سياق)
        ارجع استعلام_وسائط.من(سياق).اتجاه
    نهاية

    # ─── الحشو فقط ───
    ساكن دالة حشو_من(سياق)
        ارجع استعلام_وسائط.من(سياق).حشو
    نهاية

    # ─── إزالة الحشو ───
    ساكن دالة أزل_حشو(سياق, ابن, أعلى = خطأ, أسفل = خطأ, يمين = خطأ, يسار = خطأ)
        متغير بيانات_أصلية = استعلام_وسائط.من(سياق)
        متغير حشو_جديد = {
            "أعلى": أعلى ? 0 : بيانات_أصلية.حشو["أعلى"],
            "أسفل": أسفل ? 0 : بيانات_أصلية.حشو["أسفل"],
            "يمين": يمين ? 0 : بيانات_أصلية.حشو["يمين"],
            "يسار": يسار ? 0 : بيانات_أصلية.حشو["يسار"]
        }
        متغير بيانات_جديدة = بيانات_أصلية.انسخ(حشو = حشو_جديد)
        ارجع جديد استعلام_وسائط(بيانات_جديدة, ابن)
    نهاية
نهاية

# ─── أداة_بناء_تخطيط (LayoutBuilder) ───
صدّر صنف أداة_بناء_تخطيط يرث عنصر
    باني(بانٍ)
        هذا._نوع = "أداة_بناء_تخطيط"
        هذا._بانٍ = بانٍ
    نهاية

    دالة ابنِ(سياق, قيود)
        ارجع هذا._بانٍ(سياق, قيود)
    نهاية
نهاية

# ─── منطقة_آمنة (SafeArea) ───
صدّر صنف منطقة_آمنة يرث عنصر
    باني(ابن, أعلى = صحيح, أسفل = صحيح, يمين = صحيح, يسار = صحيح, أدنى_حشو = لاشيء)
        هذا._نوع = "منطقة_آمنة"
        هذا._ابن = ابن
        هذا._أعلى = أعلى
        هذا._أسفل = أسفل
        هذا._يمين = يمين
        هذا._يسار = يسار
        هذا._أدنى_حشو = أدنى_حشو
    نهاية
نهاية

# ─── بيانات استعلام الجذر (Singleton) ───
متغير _بيانات_جذر = لاشيء

صدّر دالة بيانات_استعلام_الجذر()
    إذا (_بيانات_جذر == لاشيء)
        _بيانات_جذر = جديد بيانات_استعلام()
        هذا._حدّث_من_النظام()
    نهاية
    ارجع _بيانات_جذر
نهاية

دالة _حدّث_من_النظام()
    # الحصول على معلومات الشاشة من النظام
    _بيانات_جذر.حجم = {"عرض": عرض_النافذة(), "ارتفاع": ارتفاع_النافذة()}
    _بيانات_جذر.نسبة_بكسل = نسبة_بكسل_الشاشة()
    _بيانات_جذر.نوع_الجهاز = _حدد_نوع_الجهاز(_بيانات_جذر.حجم["عرض"])
    _بيانات_جذر.اتجاه = _بيانات_جذر.حجم["عرض"] > _بيانات_جذر.حجم["ارتفاع"] ? "أفقي" : "عمودي"
نهاية

دالة _حدد_نوع_الجهاز(عرض)
    إذا (عرض < 600)
        ارجع "هاتف"
    وإلا إذا (عرض < 1200)
        ارجع "لوحي"
    وإلا
        ارجع "سطح_مكتب"
    نهاية
نهاية

# ─── مستمع تغير الحجم ───
صدّر دالة عند_تغير_الحجم(دالة_رد)
    ارجع سجّل_مستمع_تغير_حجم(لامدا: 
        _حدّث_من_النظام()
        دالة_رد(بيانات_استعلام_الجذر())
    )
نهاية

# ─── نقاط التوقف (Breakpoints) ───
صدّر صنف نقاط_توقف
    ساكن ثابت هاتف_صغير = 320
    ساكن ثابت هاتف = 480
    ساكن ثابت لوحي_صغير = 600
    ساكن ثابت لوحي = 768
    ساكن ثابت لوحي_كبير = 1024
    ساكن ثابت سطح_مكتب = 1200
    ساكن ثابت سطح_مكتب_كبير = 1440
نهاية

# ─── أداة بناء متجاوب ───
صدّر صنف أداة_بناء_متجاوب يرث عنصر
    باني(هاتف = لاشيء, لوحي = لاشيء, سطح_مكتب = لاشيء)
        هذا._نوع = "أداة_بناء_متجاوب"
        هذا._هاتف = هاتف
        هذا._لوحي = لوحي
        هذا._سطح_مكتب = سطح_مكتب
    نهاية

    دالة ابنِ(سياق)
        متغير بيانات = استعلام_وسائط.من(سياق)
        متغير عرض = بيانات.العرض()
        
        إذا (عرض < نقاط_توقف.لوحي_صغير و هذا._هاتف != لاشيء)
            ارجع هذا._هاتف(سياق)
        وإلا إذا (عرض < نقاط_توقف.سطح_مكتب و هذا._لوحي != لاشيء)
            ارجع هذا._لوحي(سياق)
        وإلا إذا (هذا._سطح_مكتب != لاشيء)
            ارجع هذا._سطح_مكتب(سياق)
        نهاية
        
        # احتياطي
        إذا (هذا._هاتف != لاشيء)
            ارجع هذا._هاتف(سياق)
        نهاية
        ارجع لاشيء
    نهاية
نهاية
