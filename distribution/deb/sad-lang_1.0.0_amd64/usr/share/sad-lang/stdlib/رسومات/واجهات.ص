# دالة مساعدة لطباعة الشجرة
دالة _اطبع_شجرة(جزء, مستوى)
    متغير مسافة = ""
    لكل _ في [1..مستوى]
        مسافة = مسافة + "  "
    نهاية
    
    متغير نص_العنصر = جزء._نوع + "("
    متغير أولى = صحيح
    
    لكل مفتاح، قيمة في جزء._خصائص
        إذا (قيمة != لاشيء)
            إذا (ليس أولى)
                نص_العنصر = نص_العنصر + ", "
            نهاية
            نص_العنصر = نص_العنصر + مفتاح + ": "
            
            إذا (نوع(قيمة) == "نص")
                نص_العنصر = نص_العنصر + "\"" + قيمة + "\""
            وإلا
                نص_العنصر = نص_العنصر + نص(قيمة)
            نهاية
            
            أولى = خطأ
        نهاية
    نهاية
    
    نص_العنصر = نص_العنصر + ")"
    اطبع_سطر(مسافة + نص_العنصر)
    
    # طباعة الأبناء
    إذا (جزء._أبناء != لاشيء)
        لكل ابن في جزء._أبناء
            إذا (ابن != لاشيء)
                _اطبع_شجرة(ابن, مستوى + 1)
            نهاية
        نهاية
    نهاية
    
    # طباعة الابن الواحد
    إذا (جزء._ابن != لاشيء)
        _اطبع_شجرة(جزء._ابن, مستوى + 1)
    نهاية
    
    # طباعة الخصائص المركبة (مثل شريط، محتوى)
    إذا (جزء._نوع == "هيكل")
        إذا (جزء._خصائص["شريط"] != لاشيء)
            اطبع_سطر(مسافة + "  [شريط]:")
            _اطبع_شجرة(جزء._خصائص["شريط"], مستوى + 1)
        نهاية
        إذا (جزء._خصائص["محتوى"] != لاشيء)
            اطبع_سطر(مسافة + "  [محتوى]:")
            _اطبع_شجرة(جزء._خصائص["محتوى"], مستوى + 1)
        نهاية
    نهاية
نهاية
