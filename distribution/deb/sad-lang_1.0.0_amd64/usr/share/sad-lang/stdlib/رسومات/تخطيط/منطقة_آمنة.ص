# ملف: منطقة_آمنة.ص
# المسار: stdlib/رسومات/تخطيط/منطقة_آمنة.ص
# ===================================================================
# SafeArea والتعامل مع مناطق الشاشة الآمنة
# ===================================================================
# إصلاح العيب #23: غياب SafeArea
# تاريخ الإصلاح: 18 مارس 2026
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── المنطقة الآمنة (SafeArea) ───
صدّر صنف منطقة_آمنة يرث عنصر
    باني(
        ابن،
        يسار = صحيح،
        أعلى = صحيح،
        يمين = صحيح،
        أسفل = صحيح،
        أدنى_حشو = لاشيء
    )
        هذا._نوع = "منطقة_آمنة"
        هذا._ابن = ابن
        هذا._يسار = يسار
        هذا._أعلى = أعلى
        هذا._يمين = يمين
        هذا._أسفل = أسفل
        هذا._أدنى_حشو = أدنى_حشو
    نهاية

    # ─── تطبيق الحشو ───
    دالة حشو_من(سياق)
        متغير بيانات_وسائط = استعلام_وسائط.من(سياق)
        متغير حشو = بيانات_وسائط.حشو
        
        ارجع {
            "يسار": هذا._يسار ? حشو["يسار"] : 0،
            "أعلى": هذا._أعلى ? حشو["أعلى"] : 0،
            "يمين": هذا._يمين ? حشو["يمين"] : 0،
            "أسفل": هذا._أسفل ? حشو["أسفل"] : 0
        }
    نهاية
نهاية

# ─── شريحة المنطقة الآمنة (SliverSafeArea) ───
صدّر صنف شريحة_منطقة_آمنة يرث عنصر
    باني(
        شريحة،
        يسار = صحيح،
        أعلى = صحيح،
        يمين = صحيح،
        أسفل = صحيح
    )
        هذا._نوع = "شريحة_منطقة_آمنة"
        هذا._شريحة = شريحة
        هذا._يسار = يسار
        هذا._أعلى = أعلى
        هذا._يمين = يمين
        هذا._أسفل = أسفل
    نهاية
نهاية

# ─── شريط الحالة (AnnotatedRegion) ───
صدّر صنف منطقة_موسومة يرث عنصر
    باني(ابن، قيمة)
        هذا._نوع = "منطقة_موسومة"
        هذا._ابن = ابن
        هذا._قيمة = قيمة
    نهاية
نهاية

# ─── نمط تراكب واجهة النظام ───
صدّر صنف نمط_تراكب_واجهة_نظام
    باني(
        لون_شريط_الحالة = لاشيء،
        سطوع_شريط_الحالة = لاشيء،
        سطوع_أيقونات_شريط_الحالة = لاشيء،
        لون_شريط_التنقل = لاشيء،
        سطوع_أيقونات_شريط_التنقل = لاشيء،
        خط_فاصل_شريط_التنقل = لاشيء
    )
        هذا.لون_شريط_الحالة = لون_شريط_الحالة
        هذا.سطوع_شريط_الحالة = سطوع_شريط_الحالة
        هذا.سطوع_أيقونات = سطوع_أيقونات_شريط_الحالة
        هذا.لون_شريط_التنقل = لون_شريط_التنقل
        هذا.سطوع_أيقونات_تنقل = سطوع_أيقونات_شريط_التنقل
        هذا.خط_فاصل = خط_فاصل_شريط_التنقل
    نهاية

    # ─── أنماط مُعدّة مسبقاً ───
    ساكن دالة فاتح()
        ارجع جديد نمط_تراكب_واجهة_نظام(
            لون_شريط_الحالة = 0x00000000،
            سطوع_أيقونات_شريط_الحالة = "داكن"،
            لون_شريط_التنقل = 0xFFFFFFFF،
            سطوع_أيقونات_شريط_التنقل = "داكن"
        )
    نهاية

    ساكن دالة داكن()
        ارجع جديد نمط_تراكب_واجهة_نظام(
            لون_شريط_الحالة = 0x00000000،
            سطوع_أيقونات_شريط_الحالة = "فاتح"،
            لون_شريط_التنقل = 0xFF000000،
            سطوع_أيقونات_شريط_التنقل = "فاتح"
        )
    نهاية

    ساكن دالة شفاف()
        ارجع جديد نمط_تراكب_واجهة_نظام(
            لون_شريط_الحالة = 0x00000000،
            لون_شريط_التنقل = 0x00000000
        )
    نهاية
نهاية

# ─── قنوات واجهة النظام ───
صدّر صنف قناة_واجهة_النظام
    ساكن غير_متزامن دالة عيّن_نمط_التراكب(نمط)
        انتظر _عيّن_نمط_تراكب_نظام(نمط)
    نهاية

    ساكن غير_متزامن دالة عيّن_اتجاهات_مفضلة(اتجاهات)
        انتظر _عيّن_اتجاهات_شاشة(اتجاهات)
    نهاية

    ساكن غير_متزامن دالة عيّن_وضع_واجهة_النظام(أوضاع)
        انتظر _عيّن_وضع_واجهة_نظام(أوضاع)
    نهاية

    ساكن غير_متزامن دالة استعد_أوضاع_واجهة_النظام()
        انتظر _استعد_أوضاع_واجهة_نظام()
    نهاية
نهاية

# ─── اتجاهات الشاشة ───
صدّر تعداد اتجاه_جهاز
    عمودي،
    عمودي_مقلوب،
    أفقي_يسار،
    أفقي_يمين
نهاية

# ─── أوضاع واجهة النظام ───
صدّر تعداد وضع_واجهة_نظام
    حافة_إلى_حافة،            # الشاشة بالكامل
    غامر،                      # إخفاء كل شيء
    غامر_لاصق،                # إخفاء مع ظهور مؤقت
    عادي،                      # الوضع العادي
    تراكب_شريط_الحالة،        # شريط الحالة فوق المحتوى
    تراكب_شريط_التنقل         # شريط التنقل فوق المحتوى
نهاية

# ─── حشو حافة الوسائط (MediaQueryEdgePadding) ───
صدّر صنف حشو_حافة
    باني(يسار = 0، أعلى = 0، يمين = 0، أسفل = 0)
        هذا.يسار = يسار
        هذا.أعلى = أعلى
        هذا.يمين = يمين
        هذا.أسفل = أسفل
    نهاية

    ساكن دالة صفر()
        ارجع جديد حشو_حافة(0، 0، 0، 0)
    نهاية

    دالة انسخ_مع(يسار = لاشيء، أعلى = لاشيء، يمين = لاشيء، أسفل = لاشيء)
        ارجع جديد حشو_حافة(
            يسار أو هذا.يسار،
            أعلى أو هذا.أعلى،
            يمين أو هذا.يمين،
            أسفل أو هذا.أسفل
        )
    نهاية

    دالة الإجمالي_الأفقي()
        ارجع هذا.يسار + هذا.يمين
    نهاية

    دالة الإجمالي_العمودي()
        ارجع هذا.أعلى + هذا.أسفل
    نهاية
نهاية

# ─── حشو العرض (ViewPadding) ───
صدّر صنف حشو_عرض يرث حشو_حافة
    باني(يسار = 0، أعلى = 0، يمين = 0، أسفل = 0)
        الأساس(يسار، أعلى، يمين، أسفل)
    نهاية
نهاية

# ─── حشو الإدخال (ViewInsets) ───
صدّر صنف حشو_إدخال يرث حشو_حافة
    باني(يسار = 0، أعلى = 0، يمين = 0، أسفل = 0)
        الأساس(يسار، أعلى، يمين، أسفل)
    نهاية
نهاية

# ─── منطقة آمنة مع معالجة لوحة المفاتيح ───
صدّر صنف منطقة_آمنة_لوحة_مفاتيح يرث عنصر
    باني(ابن)
        هذا._نوع = "منطقة_آمنة_لوحة_مفاتيح"
        هذا._ابن = ابن
    نهاية

    دالة حشو_لوحة_المفاتيح(سياق)
        متغير بيانات = استعلام_وسائط.من(سياق)
        ارجع بيانات.حشو_عرض["أسفل"]
    نهاية
نهاية

# ─── عنصر تجنب لوحة المفاتيح ───
صدّر صنف تجنب_لوحة_مفاتيح يرث عنصر
    باني(ابن، ممكّن = صحيح)
        هذا._نوع = "تجنب_لوحة_مفاتيح"
        هذا._ابن = ابن
        هذا._ممكّن = ممكّن
    نهاية
نهاية
