# بسم الله الرحمن الرحيم
# ===================================================================
# نظام المهام — Task Queue System
# ===================================================================
#
# (AR) هذا الملف يوفر نظام المهام (Task Queue) لإدارة
#      العمليات المكلفة حسابيًا التي لا يجب تنفيذها
#      في خيط الواجهة الرئيسي.
#
#      أنواع المهام:
#      ─ مهمة_فورية — تُنفَّذ فورًا في الإطار الحالي
#      ─ مهمة_خاملة — تُنفَّذ عندما يكون التطبيق خاملًا
#      ─ مهمة_مجزأة — تُنفَّذ على عدة إطارات (chunked)
#      ─ مهمة_دورية — تتكرر بفاصل زمني منتظم
#
#      نظام الميزانية الزمنية (Time Budget):
#      كل إطار يحصل على ميزانية زمنية (~8ms من أصل 16ms)
#      المهام الخاملة تُنفَّذ فقط إذا بقي وقت في الميزانية
#
#      مطابق لـ flutter/scheduler/scheduler.dart (scheduleTask)
#      و requestIdleCallback في المتصفحات
#
# (EN) Task queue system for managing expensive operations
#      with time budgeting and chunked execution.
#
# الأصناف المُصدّرة:
#   - مهمة (Task)                   — المهمة الأساسية
#   - مهمة_مجزأة (ChunkedTask)       — مهمة تُنفَّذ على أجزاء
#   - مهمة_دورية (PeriodicTask)      — مهمة متكررة
#   - مدير_مهام (TaskManager)         — إدارة المهام
#   - ميزانية_زمنية (TimeBudget)     — ميزانية الوقت
#
# الاستخدام:
#   استورد * من رسومات.جدولة_نظام.مهام
# ===================================================================

# ─── حالات المهمة ───
ثابت حالة_معلقة = "معلقة"          # Pending
ثابت حالة_جارية = "جارية"          # Running
ثابت حالة_مكتملة = "مكتملة"         # Completed
ثابت حالة_ملغية = "ملغية"          # Cancelled
ثابت حالة_فاشلة = "فاشلة"          # Failed

# ─── مهمة (Task) ───
صدّر صنف مهمة
    # (AR) مهمة واحدة في نظام المهام
    #      تحمل رد نداء + أولوية + حالة + تسمية
    # (EN) Single task in the task system
    باني(رد_نداء = لاشيء, أولوية = 500, تسمية = "مهمة")
        هذا._رد_نداء = رد_نداء
        هذا._أولوية = أولوية
        هذا._تسمية = تسمية
        هذا._حالة = حالة_معلقة
        هذا._نتيجة = لاشيء
        هذا._عند_اكتمال = لاشيء
        هذا._عند_خطأ = لاشيء
    نهاية

    دالة الأولوية()
        ارجع هذا._أولوية
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة التسمية()
        ارجع هذا._تسمية
    نهاية

    دالة عند_اكتمال(رد_نداء)
        هذا._عند_اكتمال = رد_نداء
        ارجع هذا
    نهاية

    دالة عند_خطأ(رد_نداء)
        هذا._عند_خطأ = رد_نداء
        ارجع هذا
    نهاية

    دالة نفّذ()
        هذا._حالة = حالة_جارية
        إذا (هذا._رد_نداء != لاشيء)
            هذا._نتيجة = هذا._رد_نداء()
        نهاية
        هذا._حالة = حالة_مكتملة
        إذا (هذا._عند_اكتمال != لاشيء)
            هذا._عند_اكتمال(هذا._نتيجة)
        نهاية
    نهاية

    دالة ألغِ()
        هذا._حالة = حالة_ملغية
    نهاية

    دالة النتيجة()
        ارجع هذا._نتيجة
    نهاية

    دالة مكتملة()
        ارجع هذا._حالة == حالة_مكتملة
    نهاية

    دالة ملغية()
        ارجع هذا._حالة == حالة_ملغية
    نهاية
نهاية

# ─── مهمة_مجزأة (ChunkedTask) ───
صدّر صنف مهمة_مجزأة
    # (AR) مهمة تُنفَّذ على عدة إطارات — مناسبة للعمليات الطويلة
    #      مثل: بناء قائمة طويلة، معالجة صور، حسابات ثقيلة
    #
    #      الاستخدام:
    #      متغير م = جديد مهمة_مجزأة(عناصر, معالجة_عنصر, 10)
    #      م.نفّذ_جزء()  # يعالج 10 عناصر كل إطار
    # (EN) Chunked task — executes portion per frame
    باني(عناصر = [], معالج = لاشيء, حجم_جزء = 10)
        هذا._عناصر = عناصر
        هذا._معالج = معالج
        هذا._حجم_جزء = حجم_جزء
        هذا._فهرس = 0
        هذا._حالة = حالة_معلقة
        هذا._إجمالي = 0
        # حساب الإجمالي
        لكل _ في عناصر
            هذا._إجمالي = هذا._إجمالي + 1
        نهاية
    نهاية

    دالة نفّذ_جزء()
        # (AR) تنفيذ جزء واحد (chunk) — يعالج حجم_جزء عنصر
        هذا._حالة = حالة_جارية
        متغير عداد = 0
        بينما (هذا._فهرس < هذا._إجمالي و عداد < هذا._حجم_جزء)
            إذا (هذا._معالج != لاشيء)
                هذا._معالج(هذا._عناصر[هذا._فهرس])
            نهاية
            هذا._فهرس = هذا._فهرس + 1
            عداد = عداد + 1
        نهاية

        إذا (هذا._فهرس >= هذا._إجمالي)
            هذا._حالة = حالة_مكتملة
        نهاية
    نهاية

    دالة نسبة_الإنجاز()
        إذا (هذا._إجمالي == 0)
            ارجع 100
        نهاية
        ارجع هذا._فهرس * 100 / هذا._إجمالي
    نهاية

    دالة مكتملة()
        ارجع هذا._حالة == حالة_مكتملة
    نهاية

    دالة ألغِ()
        هذا._حالة = حالة_ملغية
    نهاية
نهاية

# ─── مهمة_دورية (PeriodicTask) ───
صدّر صنف مهمة_دورية
    # (AR) مهمة تتكرر بفاصل زمني منتظم
    #      مثال: تحديث الساعة كل ثانية، فحص الاتصال كل 5 ثوانٍ
    # (EN) Task that repeats at a regular interval
    باني(رد_نداء = لاشيء, فاصل_مللي = 1000, تسمية = "دورية")
        هذا._رد_نداء = رد_نداء
        هذا._فاصل = فاصل_مللي
        هذا._تسمية = تسمية
        هذا._نشطة = خطأ
        هذا._آخر_تنفيذ = 0
        هذا._عدد_تنفيذات = 0
    نهاية

    دالة بدء()
        هذا._نشطة = صحيح
        ارجع هذا
    نهاية

    دالة أوقف()
        هذا._نشطة = خطأ
        ارجع هذا
    نهاية

    دالة يجب_تنفيذ(وقت_حالي)
        # (AR) تحقق هل حان وقت التنفيذ
        إذا (ليس هذا._نشطة)
            ارجع خطأ
        نهاية
        ارجع (وقت_حالي - هذا._آخر_تنفيذ) >= هذا._فاصل
    نهاية

    دالة نفّذ(وقت_حالي)
        إذا (هذا._رد_نداء != لاشيء)
            هذا._رد_نداء()
        نهاية
        هذا._آخر_تنفيذ = وقت_حالي
        هذا._عدد_تنفيذات = هذا._عدد_تنفيذات + 1
    نهاية

    دالة نشطة()
        ارجع هذا._نشطة
    نهاية

    دالة عدد_التنفيذات()
        ارجع هذا._عدد_تنفيذات
    نهاية
نهاية

# ─── ميزانية_زمنية (TimeBudget) ───
صدّر صنف ميزانية_زمنية
    # (AR) ميزانية زمنية لإطار واحد — تمنع تجاوز الوقت المسموح
    #      الميزانية = 8ms افتراضيًا (نصف الإطار عند 60fps)
    # (EN) Frame time budget — prevents exceeding allowed frame time
    باني(ميزانية_مللي = 8)
        هذا._ميزانية = ميزانية_مللي
        هذا._مستهلك = 0
    نهاية

    دالة سجّل(مدة)
        هذا._مستهلك = هذا._مستهلك + مدة
    نهاية

    دالة متبقي()
        متغير باقي = هذا._ميزانية - هذا._مستهلك
        إذا (باقي < 0)
            ارجع 0
        نهاية
        ارجع باقي
    نهاية

    دالة يوجد_وقت()
        ارجع هذا._مستهلك < هذا._ميزانية
    نهاية

    دالة إعادة_ضبط()
        هذا._مستهلك = 0
    نهاية

    دالة نسبة_الاستهلاك()
        إذا (هذا._ميزانية == 0)
            ارجع 100
        نهاية
        ارجع هذا._مستهلك * 100 / هذا._ميزانية
    نهاية
نهاية

# ─── مدير_مهام (TaskManager) ───
صدّر صنف مدير_مهام
    # (AR) المدير المركزي لجميع المهام — يدير الطابور والجدولة
    #      ينفذ المهام حسب الأولوية مع مراعاة الميزانية الزمنية
    # (EN) Central task manager — manages queue, scheduling, time budget
    باني()
        هذا._مهام_فورية = []
        هذا._مهام_خاملة = []
        هذا._مهام_دورية = []
        هذا._مهام_مجزأة = []
        هذا._ميزانية = جديد ميزانية_زمنية()
    نهاية

    دالة أضف_فورية(رد_نداء, تسمية = "فورية")
        متغير م = جديد مهمة(رد_نداء, 0, تسمية)
        هذا._مهام_فورية = هذا._مهام_فورية + [م]
        ارجع م
    نهاية

    دالة أضف_خاملة(رد_نداء, تسمية = "خاملة")
        متغير م = جديد مهمة(رد_نداء, 1000, تسمية)
        هذا._مهام_خاملة = هذا._مهام_خاملة + [م]
        ارجع م
    نهاية

    دالة أضف_دورية(رد_نداء, فاصل, تسمية = "دورية")
        متغير م = جديد مهمة_دورية(رد_نداء, فاصل, تسمية)
        هذا._مهام_دورية = هذا._مهام_دورية + [م]
        ارجع م.بدء()
    نهاية

    دالة أضف_مجزأة(عناصر, معالج, حجم_جزء, تسمية = "مجزأة")
        متغير م = جديد مهمة_مجزأة(عناصر, معالج, حجم_جزء)
        هذا._مهام_مجزأة = هذا._مهام_مجزأة + [م]
        ارجع م
    نهاية

    دالة نفّذ_دورة(وقت_حالي)
        # (AR) دورة تنفيذ واحدة — تعالج المهام حسب الأولوية
        هذا._ميزانية.إعادة_ضبط()

        # 1. المهام الفورية (دائمًا)
        متغير فورية = هذا._مهام_فورية
        هذا._مهام_فورية = []
        لكل م في فورية
            م.نفّذ()
        نهاية

        # 2. المهام الدورية (إذا حان وقتها)
        لكل م في هذا._مهام_دورية
            إذا (م.يجب_تنفيذ(وقت_حالي))
                م.نفّذ(وقت_حالي)
            نهاية
        نهاية

        # 3. المهام المجزأة (جزء واحد لكل دورة)
        متغير مجزأة_جديدة = []
        لكل م في هذا._مهام_مجزأة
            إذا (ليس م.مكتملة())
                م.نفّذ_جزء()
                إذا (ليس م.مكتملة())
                    مجزأة_جديدة = مجزأة_جديدة + [م]
                نهاية
            نهاية
        نهاية
        هذا._مهام_مجزأة = مجزأة_جديدة

        # 4. المهام الخاملة (إذا بقي وقت)
        إذا (هذا._ميزانية.يوجد_وقت())
            متغير خاملة = هذا._مهام_خاملة
            هذا._مهام_خاملة = []
            لكل م في خاملة
                إذا (هذا._ميزانية.يوجد_وقت())
                    م.نفّذ()
                وإلا
                    # إعادة المهام التي لم تُنفَّذ
                    هذا._مهام_خاملة = هذا._مهام_خاملة + [م]
                نهاية
            نهاية
        نهاية
    نهاية

    دالة عدد_المهام_المعلقة()
        متغير عدد = 0
        لكل _ في هذا._مهام_فورية
            عدد = عدد + 1
        نهاية
        لكل _ في هذا._مهام_خاملة
            عدد = عدد + 1
        نهاية
        لكل _ في هذا._مهام_مجزأة
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية
نهاية
