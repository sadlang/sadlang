# إصلاح العيب #8: Animation Memory Leaks - تسرب ذاكرة الحركات
# ===================================================================

# ─── مرجع ضعيف ───
صدّر صنف مرجع_ضعيف
    باني(كائن)
        هذا._معرف = كائن._معرف_فريد أو _أنشئ_معرف()
        هذا._نوع = نوع(كائن)
        # لا نحتفظ بمرجع قوي
        _سجّل_مرجع_ضعيف(هذا._معرف، كائن)
    نهاية

    دالة احصل()
        ارجع _احصل_مرجع_ضعيف(هذا._معرف)
    نهاية

    دالة حي()
        ارجع هذا.احصل() != لاشيء
    نهاية
نهاية

# ─── مجمع الموارد ───
صدّر صنف مجمع_موارد
    باني(باني، حد)
        هذا._باني = باني
        هذا._حد = حد أو 50
        هذا._متاحة = []
        هذا._مستخدمة = []
    نهاية

    دالة احصل()
        متغير كائن
        
        إذا (هذا._متاحة.الطول() > 0)
            كائن = هذا._متاحة.انزع()
        وإلا
            كائن = هذا._باني()
        نهاية
        
        هذا._مستخدمة.أضف(كائن)
        ارجع كائن
    نهاية

    دالة أرجع(كائن)
        هذا._مستخدمة = هذا._مستخدمة.فلتر(لامدا(ك) => ك != كائن)
        
        إذا (هذا._متاحة.الطول() < هذا._حد)
            # أعد تعيين الكائن
            إذا (كائن.أعد_تعيين != لاشيء)
                كائن.أعد_تعيين()
            نهاية
            هذا._متاحة.أضف(كائن)
        نهاية
        # إذا تجاوزنا الحد، اتركه للـ GC
    نهاية

    دالة نظّف()
        هذا._متاحة = []
        هذا._مستخدمة = []
    نهاية

    دالة إحصائيات()
        ارجع {
            متاحة: هذا._متاحة.الطول()،
            مستخدمة: هذا._مستخدمة.الطول()،
            إجمالي: هذا._متاحة.الطول() + هذا._مستخدمة.الطول()
        }
    نهاية
نهاية

# ─── حركة آمنة ───
صدّر صنف حركة_آمنة
    باني(هدف)
        هذا._هدف = جديد مرجع_ضعيف(هدف)
        هذا._معرف = _أنشئ_معرف()
        هذا._تشغيل = خطأ
        هذا._مكتملة = خطأ
        هذا._مدة = 0
        هذا._وقت_منقضي = 0
        هذا._عند_اكتمال = لاشيء
        هذا._عند_تحديث = لاشيء
    نهاية

    دالة شغّل()
        إذا (ليس هذا._هدف.حي())
            # الهدف لم يعد موجوداً
            هذا._مكتملة = صحيح
            ارجع
        نهاية
        
        هذا._تشغيل = صحيح
        هذا._وقت_منقضي = 0
        مدير_حركات_آمن.سجّل(هذا)
    نهاية

    دالة أوقف()
        هذا._تشغيل = خطأ
        مدير_حركات_آمن.ألغِ(هذا._معرف)
    نهاية

    دالة حدّث(دلتا)
        # تحقق من الهدف
        إذا (ليس هذا._هدف.حي())
            هذا._مكتملة = صحيح
            هذا._تشغيل = خطأ
            ارجع
        نهاية
        
        هذا._وقت_منقضي += دلتا
        
        متغير تقدم = مين(1، هذا._وقت_منقضي / هذا._مدة)
        
        # حدّث الهدف
        إذا (هذا._عند_تحديث != لاشيء)
            متغير هدف = هذا._هدف.احصل()
            إذا (هدف != لاشيء)
                هذا._عند_تحديث(هدف، تقدم)
            نهاية
        نهاية
        
        # تحقق من الاكتمال
        إذا (تقدم >= 1)
            هذا._مكتملة = صحيح
            هذا._تشغيل = خطأ
            
            إذا (هذا._عند_اكتمال != لاشيء)
                هذا._عند_اكتمال()
            نهاية
        نهاية
    نهاية

    دالة مكتملة()
        ارجع هذا._مكتملة
    نهاية

    دالة المعرف()
        ارجع هذا._معرف
    نهاية
نهاية

# ─── مدير الحركات الآمن ───
صدّر صنف مدير_حركات_آمن
    ساكن متغير _حركات = {}
    ساكن متغير _يعمل = خطأ
    ساكن متغير _وقت_آخر = 0

    ساكن دالة سجّل(حركة)
        مدير_حركات_آمن._حركات[حركة.المعرف()] = حركة
        
        إذا (ليس مدير_حركات_آمن._يعمل)
            مدير_حركات_آمن._ابدأ_حلقة()
        نهاية
    نهاية

    ساكن دالة ألغِ(معرف)
        احذف مدير_حركات_آمن._حركات[معرف]
    نهاية

    ساكن دالة ألغِ_كل_حركات_الهدف(هدف)
        متغير معرف_هدف = هدف._معرف_فريد
        متغير للحذف = []
        
        لكل معرف في مدير_حركات_آمن._حركات
            متغير حركة = مدير_حركات_آمن._حركات[معرف]
            إذا (حركة._هدف._معرف == معرف_هدف)
                للحذف.أضف(معرف)
            نهاية
        نهاية
        
        لكل معرف في للحذف
            احذف مدير_حركات_آمن._حركات[معرف]
        نهاية
    نهاية

    ساكن دالة _ابدأ_حلقة()
        مدير_حركات_آمن._يعمل = صحيح
        مدير_حركات_آمن._وقت_آخر = الآن()
        مدير_حركات_آمن._حلقة()
    نهاية

    ساكن دالة _حلقة()
        متغير الآن = الآن()
        متغير دلتا = الآن - مدير_حركات_آمن._وقت_آخر
        مدير_حركات_آمن._وقت_آخر = الآن
        
        # نظّف الحركات المكتملة
        متغير للحذف = []
        
        لكل معرف في مدير_حركات_آمن._حركات
            متغير حركة = مدير_حركات_آمن._حركات[معرف]
            
            حركة.حدّث(دلتا)
            
            إذا (حركة.مكتملة())
                للحذف.أضف(معرف)
            نهاية
        نهاية
        
        # احذف المكتملة
        لكل معرف في للحذف
            احذف مدير_حركات_آمن._حركات[معرف]
        نهاية
        
        # استمر إذا هناك حركات
        إذا (مفاتيح(مدير_حركات_آمن._حركات).الطول() > 0)
            طلب_إطار(لامدا() => مدير_حركات_آمن._حلقة())
        وإلا
            مدير_حركات_آمن._يعمل = خطأ
        نهاية
    نهاية

    ساكن دالة إحصائيات()
        ارجع {
            عدد_الحركات: مفاتيح(مدير_حركات_آمن._حركات).الطول()،
            يعمل: مدير_حركات_آمن._يعمل
        }
    نهاية

    ساكن دالة أوقف_الكل()
        مدير_حركات_آمن._حركات = {}
        مدير_حركات_آمن._يعمل = خطأ
    نهاية
نهاية

# ─── حركة Tween آمنة ───
صدّر صنف Tween_آمن
    ساكن دالة حرّك(هدف، خاصية، من، إلى، مدة، تسهيل)
        متغير حركة = جديد حركة_آمنة(هدف)
        حركة._مدة = مدة
        
        حركة._عند_تحديث = لامدا(ه، تقدم) =>
            متغير قيمة_تسهيل = تسهيل ? تسهيل(تقدم) : تقدم
            ه[خاصية] = من + (إلى - من) * قيمة_تسهيل
        نهاية
        
        ارجع حركة
    نهاية

    ساكن دالة حرّك_متعدد(هدف، خصائص، مدة، تسهيل)
        متغير حركة = جديد حركة_آمنة(هدف)
        حركة._مدة = مدة
        
        حركة._عند_تحديث = لامدا(ه، تقدم) =>
            متغير قيمة_تسهيل = تسهيل ? تسهيل(تقدم) : تقدم
            
            لكل خاصية في خصائص
                متغير من = خصائص[خاصية].من
                متغير إلى = خصائص[خاصية].إلى
                ه[خاصية] = من + (إلى - من) * قيمة_تسهيل
            نهاية
        نهاية
        
        ارجع حركة
    نهاية
نهاية

# ─── دوال تسهيل ───
صدّر صنف تسهيل
    ساكن دالة خطي(ت)
        ارجع ت
    نهاية

    ساكن دالة تسارع(ت)
        ارجع ت * ت
    نهاية

    ساكن دالة تباطؤ(ت)
        ارجع ت * (2 - ت)
    نهاية

    ساكن دالة تسارع_تباطؤ(ت)
        ارجع ت < 0.5 ? 2 * ت * ت : -1 + (4 - 2 * ت) * ت
    نهاية

    ساكن دالة ارتداد(ت)
        متغير ن = 7.5625
        متغير د = 2.75
        
        إذا (ت < 1 / د)
            ارجع ن * ت * ت
        وإلا إذا (ت < 2 / د)
            ت -= 1.5 / د
            ارجع ن * ت * ت + 0.75
        وإلا إذا (ت < 2.5 / د)
            ت -= 2.25 / د
            ارجع ن * ت * ت + 0.9375
        وإلا
            ت -= 2.625 / د
            ارجع ن * ت * ت + 0.984375
        نهاية
    نهاية

    ساكن دالة مرن(ت)
        إذا (ت == 0 أو ت == 1)
            ارجع ت
        نهاية
        ارجع جتا(20 * 3.14159 * ت / 3) * ** (10 * (ت - 1))
    نهاية
نهاية
