# بسم الله الرحمن الرحيم
# ===================================================================
# مُعرّفات الإيماءات — Gesture Recognizers
# ===================================================================
#
# (AR) هذا الملف يوفر مُعرّفات الإيماءات المتقدمة التي تفسّر أحداث
#      اللمس الخام وتحوّلها إلى إيماءات ذات معنى (نقر، سحب، قرص...).
#      كل مُعرّف يتنافس مع الآخرين في ساحة الإيماءات (GestureArena)
#      لتحديد أي إيماءة فازت بالتفاعل.
#
#      مطابق لـ flutter/gestures/recognizer.dart
#      و flutter/gestures/tap.dart
#      و flutter/gestures/multidrag.dart
#      و flutter/gestures/scale.dart
#
# (EN) Gesture recognizers that interpret raw touch events into
#      meaningful gestures. Each recognizer competes in the
#      GestureArena to determine which gesture wins the interaction.
#
# الأصناف المُصدّرة:
#   - معرّف_إيماءة (GestureRecognizer) — الصنف الأساسي
#   - معرّف_نقر (TapGestureRecognizer) — كشف النقر
#   - معرّف_نقر_مزدوج (DoubleTapRecognizer) — كشف النقر المزدوج
#   - معرّف_ضغط_مطول (LongPressRecognizer) — كشف الضغط المطول
#   - معرّف_سحب_أفقي (HorizontalDragRecognizer) — السحب الأفقي
#   - معرّف_سحب_عمودي (VerticalDragRecognizer) — السحب العمودي
#   - معرّف_سحب_حر (PanGestureRecognizer) — السحب بأي اتجاه
#   - معرّف_قرص (ScaleGestureRecognizer) — التكبير/التصغير بإصبعين
#   - معرّف_تمرير_قسري (ForcePressRecognizer) — كشف الضغط القوي
#
# الاستخدام:
#   استورد * من رسومات.إيماءات_نظام.معرّفات
# ===================================================================

# ─── ثوابت الإيماءات ───
ثابت مسافة_نقر_قصوى = 18.0
ثابت مهلة_نقر_مزدوج = 300
ثابت مهلة_ضغط_مطول = 500
ثابت مسافة_سحب_دنيا = 8.0
ثابت عتبة_ضغط_قوي = 0.4

# ─── حالة_معرّف (RecognizerState) ───
ثابت حالة_جاهز = "جاهز"
ثابت حالة_ممكن = "ممكن"
ثابت حالة_مقبول = "مقبول"
ثابت حالة_مكتمل = "مكتمل"
ثابت حالة_ملغي = "ملغي"

# ─── معرّف_إيماءة (GestureRecognizer) — الصنف الأساسي ───
صدّر صنف معرّف_إيماءة
    # (AR) الصنف الأساسي لجميع مُعرّفات الإيماءات
    #      يعالج أحداث المؤشر الخام (pointer events) ويقرر
    #      ما إذا كانت تُشكّل إيماءة معروفة
    # (EN) Base class for all gesture recognizers
    باني()
        هذا._حالة = حالة_جاهز
        هذا._مؤشرات = {}
    نهاية

    دالة أضف_مؤشر(حدث)
        هذا._حالة = حالة_ممكن
    نهاية

    دالة عالج_حدث(حدث)
        # يُستبدل في الأصناف الفرعية
    نهاية

    دالة اقبل()
        هذا._حالة = حالة_مقبول
    نهاية

    دالة ارفض()
        هذا._حالة = حالة_ملغي
    نهاية

    دالة تنظيف()
        هذا._حالة = حالة_جاهز
        هذا._مؤشرات = {}
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية
نهاية

# ─── معرّف_نقر (TapGestureRecognizer) ───
صدّر صنف معرّف_نقر يرث معرّف_إيماءة
    # (AR) يكشف إيماءة النقر — ضغط ورفع سريع بدون حركة كبيرة
    # (EN) Detects tap gesture — quick press and release without significant movement
    باني()
        هذا._حالة = حالة_جاهز
        هذا._مؤشرات = {}
        هذا._عند_النقر = لاشيء
        هذا._عند_النقر_للأسفل = لاشيء
        هذا._عند_النقر_للأعلى = لاشيء
        هذا._عند_الإلغاء = لاشيء
        هذا._موقع_ابتدائي = لاشيء
    نهاية

    دالة عند_النقر(دالة_رد)
        هذا._عند_النقر = دالة_رد
        ارجع هذا
    نهاية

    دالة عند_النقر_للأسفل(دالة_رد)
        هذا._عند_النقر_للأسفل = دالة_رد
        ارجع هذا
    نهاية

    دالة عند_النقر_للأعلى(دالة_رد)
        هذا._عند_النقر_للأعلى = دالة_رد
        ارجع هذا
    نهاية

    دالة عند_الإلغاء(دالة_رد)
        هذا._عند_الإلغاء = دالة_رد
        ارجع هذا
    نهاية
نهاية

# ─── معرّف_نقر_مزدوج (DoubleTapRecognizer) ───
صدّر صنف معرّف_نقر_مزدوج يرث معرّف_إيماءة
    # (AR) يكشف النقر المزدوج — نقرتان سريعتان متتاليتان
    # (EN) Detects double tap — two quick consecutive taps
    باني()
        هذا._حالة = حالة_جاهز
        هذا._مؤشرات = {}
        هذا._عند_النقر_المزدوج = لاشيء
        هذا._عند_الإلغاء = لاشيء
        هذا._مهلة = مهلة_نقر_مزدوج
        هذا._آخر_نقرة_زمن = 0
    نهاية

    دالة عند_النقر_المزدوج(دالة_رد)
        هذا._عند_النقر_المزدوج = دالة_رد
        ارجع هذا
    نهاية
نهاية

