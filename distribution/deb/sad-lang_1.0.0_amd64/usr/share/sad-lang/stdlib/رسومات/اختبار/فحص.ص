# ===================================================================
# إطار اختبارات الواجهة — UI Testing Framework
# ===================================================================
# مستوحى من Flutter (WidgetTester, testWidgets, find, expect)
#
# الاستخدام:
#   استورد * من رسومات.اختبار.فحص
# ===================================================================

متغير _اختبارات = []
متغير _نجح = 0
متغير _فشل = 0

# ─── توقع (Assertion) ───
صدّر دالة توقع(فعلي, متوقع, رسالة)
    إذا (رسالة == لاشيء)
        رسالة = "توقع: " + متوقع + " حصلنا: " + فعلي
    نهاية
    إذا (فعلي == متوقع)
        _نجح = _نجح + 1
        ارجع صحيح
    وإلا
        _فشل = _فشل + 1
        اطبع_سطر("✗ فشل: " + رسالة)
        ارجع خطأ
    نهاية
نهاية

صدّر دالة توقع_صحيح(فعلي, رسالة)
    ارجع توقع(فعلي, صحيح, رسالة)
نهاية

صدّر دالة توقع_خطأ(فعلي, رسالة)
    ارجع توقع(فعلي, خطأ, رسالة)
نهاية

صدّر دالة توقع_لاشيء(فعلي, رسالة)
    ارجع توقع(فعلي, لاشيء, رسالة)
نهاية

صدّر دالة توقع_ليس_لاشيء(فعلي, رسالة)
    إذا (رسالة == لاشيء)
        رسالة = "توقع ليس لاشيء"
    نهاية
    إذا (فعلي != لاشيء)
        _نجح = _نجح + 1
        ارجع صحيح
    وإلا
        _فشل = _فشل + 1
        اطبع_سطر("✗ فشل: " + رسالة)
        ارجع خطأ
    نهاية
نهاية

# ─── اختبار (Test Registration) ───
صدّر دالة اختبر(اسم, دالة_اختبار)
    _اختبارات.أضف({"اسم": اسم, "دالة": دالة_اختبار})
نهاية

# ─── مجموعة اختبارات (Test Group) ───
صدّر دالة مجموعة(اسم, دالة_مجموعة)
    اطبع_سطر("━━━ " + اسم + " ━━━")
    دالة_مجموعة()
نهاية

# ─── تشغيل الاختبارات ───
صدّر دالة شغّل_اختبارات()
    _نجح = 0
    _فشل = 0
    متغير إجمالي = 0

    لكل ا في _اختبارات
        إجمالي = إجمالي + 1
        متغير نجح_قبل = _نجح
        متغير فشل_قبل = _فشل

        ا["دالة"]()

        إذا (_فشل == فشل_قبل)
            اطبع_سطر("  ✓ " + ا["اسم"])
        وإلا
            اطبع_سطر("  ✗ " + ا["اسم"])
        نهاية
    نهاية

    اطبع_سطر("")
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━")
    اطبع_سطر("المجموع: " + إجمالي + " اختبار")
    اطبع_سطر("نجح: " + _نجح)
    اطبع_سطر("فشل: " + _فشل)
    اطبع_سطر("━━━━━━━━━━━━━━━━━━━━━━━")

    ارجع _فشل == 0
نهاية

# ─── إعادة ضبط ───
صدّر دالة أعد_ضبط_اختبارات()
    _اختبارات = []
    _نجح = 0
    _فشل = 0
نهاية

# ─── باحث العناصر (Widget Finder) ───
صدّر صنف باحث
    ساكن دالة بالنوع(عنصر, نوع)
        متغير نتائج = []
        باحث._بحث_عميق(عنصر, نوع, نتائج)
        ارجع نتائج
    نهاية

    ساكن دالة _بحث_عميق(عنصر, نوع, نتائج)
        إذا (عنصر == لاشيء)
            ارجع لاشيء
        نهاية

        إذا (عنصر._نوع == نوع)
            نتائج.أضف(عنصر)
        نهاية

        إذا (عنصر._أبناء != لاشيء)
            لكل طفل في عنصر._أبناء
                باحث._بحث_عميق(طفل, نوع, نتائج)
            نهاية
        نهاية
    نهاية

    ساكن دالة بالخاصية(عنصر, مفتاح, قيمة)
        متغير نتائج = []
        باحث._بحث_خاصية(عنصر, مفتاح, قيمة, نتائج)
        ارجع نتائج
    نهاية

    ساكن دالة _بحث_خاصية(عنصر, مفتاح, قيمة, نتائج)
        إذا (عنصر == لاشيء)
            ارجع لاشيء
        نهاية

        إذا (عنصر._خصائص != لاشيء)
            إذا (عنصر._خصائص[مفتاح] == قيمة)
                نتائج.أضف(عنصر)
            نهاية
        نهاية

        إذا (عنصر._أبناء != لاشيء)
            لكل طفل في عنصر._أبناء
                باحث._بحث_خاصية(طفل, مفتاح, قيمة, نتائج)
            نهاية
        نهاية
    نهاية

    ساكن دالة عدد(عنصر, نوع)
        ارجع طول(باحث.بالنوع(عنصر, نوع))
    نهاية
نهاية
