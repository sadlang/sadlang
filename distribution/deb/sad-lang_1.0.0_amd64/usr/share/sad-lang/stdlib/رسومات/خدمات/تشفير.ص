# ===================================================================
#       مشفّر — واجهة التشفير
# ===================================================================

صدّر صنف مشفّر
    باني(خوارزمية = خوارزمية_تشفير.AES_256)
        هذا._خوارزمية = خوارزمية
    نهاية

    ## تشفير نص بمفتاح
    دالة شفّر(نص, مفتاح)
        حاول
            ارجع شفر_نص(نص, مفتاح)
        امسك خ
            ارجع لاشيء
        نهاية
    نهاية

    ## فك تشفير نص
    دالة فكّ(نص_مشفر, مفتاح)
        حاول
            ارجع فك_تشفير(نص_مشفر, مفتاح)
        امسك خ
            ارجع لاشيء
        نهاية
    نهاية
نهاية

# ===================================================================
#       هاشر — واجهة التجزئة
# ===================================================================

صدّر صنف هاشر
    باني(خوارزمية = خوارزمية_هاش.SHA256)
        هذا._خوارزمية = خوارزمية
    نهاية

    ## حساب هاش لنص
    دالة حسب(نص)
        حاول
            ارجع هاش(نص, هذا._خوارزمية)
        امسك خ
            ارجع لاشيء
        نهاية
    نهاية

    ## تحقق من تطابق هاش
    دالة تحقق(نص, هاش_متوقع)
        متغير ن = هذا.حسب(نص)
        ارجع ن == هاش_متوقع
    نهاية
نهاية

