# إصلاح العيب #7: OpenGL Error Handling - معالجة أخطاء OpenGL
# ===================================================================

# ─── رموز أخطاء OpenGL ───
صدّر تعداد خطأ_GL
    لا_خطأ = 0
    تعداد_غير_صالح = 1280
    قيمة_غير_صالحة = 1281
    عملية_غير_صالحة = 1282
    فائض_المكدس = 1283
    نفاد_المكدس = 1284
    نفاد_الذاكرة = 1285
    كائن_framebuffer_غير_مكتمل = 1286
نهاية

# ─── مصحح OpenGL ───
صدّر صنف مصحح_GL
    ساكن متغير _مفعّل = صحيح
    ساكن متغير _سجل = []
    ساكن متغير _حد_سجل = 1000

    ساكن دالة فعّل()
        مصحح_GL._مفعّل = صحيح
    نهاية

    ساكن دالة عطّل()
        مصحح_GL._مفعّل = خطأ
    نهاية

    ساكن دالة تحقق(عملية)
        إذا (ليس مصحح_GL._مفعّل)
            ارجع صحيح
        نهاية

        # استدعي glGetError (يتم ربطها من C++)
        متغير كود_خطأ = _gl_get_error()
        
        إذا (كود_خطأ != خطأ_GL.لا_خطأ)
            متغير رسالة = مصحح_GL._ترجم_خطأ(كود_خطأ)
            متغير سجل = {
                وقت: الآن()،
                عملية: عملية،
                كود: كود_خطأ،
                رسالة: رسالة
            }
            
            مصحح_GL._سجّل(سجل)
            ارجع خطأ
        نهاية
        
        ارجع صحيح
    نهاية

    ساكن دالة _ترجم_خطأ(كود)
        طابق (كود)
            عندما خطأ_GL.تعداد_غير_صالح:
                ارجع "GL_INVALID_ENUM: تم تمرير تعداد غير صالح"
            عندما خطأ_GL.قيمة_غير_صالحة:
                ارجع "GL_INVALID_VALUE: قيمة رقمية خارج النطاق"
            عندما خطأ_GL.عملية_غير_صالحة:
                ارجع "GL_INVALID_OPERATION: العملية غير مسموحة في الحالة الحالية"
            عندما خطأ_GL.فائض_المكدس:
                ارجع "GL_STACK_OVERFLOW: فائض مكدس"
            عندما خطأ_GL.نفاد_المكدس:
                ارجع "GL_STACK_UNDERFLOW: نفاد مكدس"
            عندما خطأ_GL.نفاد_الذاكرة:
                ارجع "GL_OUT_OF_MEMORY: لا توجد ذاكرة كافية"
            افتراضي:
                ارجع "خطأ غير معروف: " + كود
        نهاية
    نهاية

    ساكن دالة _سجّل(سجل)
        مصحح_GL._سجل.أضف(سجل)
        
        إذا (مصحح_GL._سجل.الطول() > مصحح_GL._حد_سجل)
            مصحح_GL._سجل = مصحح_GL._سجل[-500:]
        نهاية
        
        # اطبع في وضع التطوير
        اطبع_سطر("⚠️ خطأ GL [" + سجل.عملية + "]: " + سجل.رسالة)
    نهاية

    ساكن دالة احصل_سجل()
        ارجع مصحح_GL._سجل
    نهاية

    ساكن دالة امسح_سجل()
        مصحح_GL._سجل = []
    نهاية
نهاية

# ─── سياق GL آمن ───
صدّر صنف سياق_GL_آمن
    باني()
        هذا._سياق_صالح = خطأ
        هذا._إصدار = {رئيسي: 0، فرعي: 0}
        هذا._مميزات = {}
    نهاية

    دالة هيّئ()
        حاول
            # تحقق من السياق
            هذا._سياق_صالح = _gl_make_current()
            
            إذا (ليس هذا._سياق_صالح)
                ارمي "فشل في تهيئة سياق OpenGL"
            نهاية
            
            # احصل على الإصدار
            هذا._إصدار = {
                رئيسي: _gl_get_integer(0x821B)،  # GL_MAJOR_VERSION
                فرعي: _gl_get_integer(0x821C)   # GL_MINOR_VERSION
            }
            
            # تحقق من المميزات
            هذا._اكتشف_مميزات()
            
            ارجع صحيح
        امسك (خطأ)
            اطبع_سطر("خطأ في تهيئة GL: " + خطأ)
            ارجع خطأ
        نهاية
    نهاية

    دالة _اكتشف_مميزات()
        هذا._مميزات = {
            VAO: هذا._إصدار.رئيسي >= 3،
            instancing: هذا._إصدار.رئيسي >= 3 أو هذا._يدعم_امتداد("GL_ARB_instanced_arrays")،
            compute_shaders: هذا._إصدار.رئيسي >= 4 و هذا._إصدار.فرعي >= 3،
            tessellation: هذا._إصدار.رئيسي >= 4،
            texture_arrays: هذا._إصدار.رئيسي >= 3،
            framebuffer: هذا._إصدار.رئيسي >= 3 أو هذا._يدعم_امتداد("GL_ARB_framebuffer_object")
        }
    نهاية

    دالة _يدعم_امتداد(اسم)
        # يتم ربطها من C++
        ارجع _gl_has_extension(اسم)
    نهاية

    دالة يدعم(ميزة)
        ارجع هذا._مميزات[ميزة] == صحيح
    نهاية

    دالة صالح()
        ارجع هذا._سياق_صالح
    نهاية
نهاية

# ─── مدير الموارد GL ───
صدّر صنف مدير_موارد_GL
    باني()
        هذا._مخازن = []
        هذا._نسيج = []
        هذا._برامج = []
        هذا._VAOs = []
    نهاية

    دالة أنشئ_مخزن()
        متغير معرف = _gl_gen_buffer()
        مصحح_GL.تحقق("glGenBuffers")
        
        إذا (معرف > 0)
            هذا._مخازن.أضف(معرف)
        نهاية
        
        ارجع معرف
    نهاية

    دالة احذف_مخزن(معرف)
        _gl_delete_buffer(معرف)
        مصحح_GL.تحقق("glDeleteBuffers")
        
        هذا._مخازن = هذا._مخازن.فلتر(لامدا(م) => م != معرف)
    نهاية

    دالة أنشئ_نسيج()
        متغير معرف = _gl_gen_texture()
        مصحح_GL.تحقق("glGenTextures")
        
        إذا (معرف > 0)
            هذا._نسيج.أضف(معرف)
        نهاية
        
        ارجع معرف
    نهاية

    دالة احذف_نسيج(معرف)
        _gl_delete_texture(معرف)
        مصحح_GL.تحقق("glDeleteTextures")
        
        هذا._نسيج = هذا._نسيج.فلتر(لامدا(ن) => ن != معرف)
    نهاية

    دالة نظّف_الكل()
        # احذف جميع الموارد
        لكل معرف في هذا._مخازن
            _gl_delete_buffer(معرف)
        نهاية
        
        لكل معرف في هذا._نسيج
            _gl_delete_texture(معرف)
        نهاية
        
        لكل معرف في هذا._برامج
            _gl_delete_program(معرف)
        نهاية
        
        لكل معرف في هذا._VAOs
            _gl_delete_vertex_array(معرف)
        نهاية
        
        هذا._مخازن = []
        هذا._نسيج = []
        هذا._برامج = []
        هذا._VAOs = []
        
        اطبع_سطر("✓ تم تنظيف جميع موارد GL")
    نهاية

    دالة إحصائيات()
        ارجع {
            مخازن: هذا._مخازن.الطول()،
            نسيج: هذا._نسيج.الطول()،
            برامج: هذا._برامج.الطول()،
            VAOs: هذا._VAOs.الطول()
        }
    نهاية
نهاية

# ─── Framebuffer آمن ───
صدّر صنف إطار_عرض_آمن
    باني(عرض، ارتفاع)
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
        هذا._معرف = 0
        هذا._نسيج_لون = 0
        هذا._مخزن_عمق = 0
    نهاية

    دالة أنشئ()
        # أنشئ Framebuffer
        هذا._معرف = _gl_gen_framebuffer()
        إذا (ليس مصحح_GL.تحقق("glGenFramebuffers"))
            ارجع خطأ
        نهاية
        
        _gl_bind_framebuffer(0x8D40، هذا._معرف)  # GL_FRAMEBUFFER
        
        # أنشئ نسيج اللون
        هذا._نسيج_لون = _gl_gen_texture()
        _gl_bind_texture(0x0DE1، هذا._نسيج_لون)  # GL_TEXTURE_2D
        _gl_tex_image_2d(0x0DE1، 0، 0x8058، هذا._عرض، هذا._ارتفاع، 0، 0x1908، 0x1401، لاشيء)
        _gl_framebuffer_texture_2d(0x8D40، 0x8CE0، 0x0DE1، هذا._نسيج_لون، 0)
        
        # أنشئ مخزن العمق
        هذا._مخزن_عمق = _gl_gen_renderbuffer()
        _gl_bind_renderbuffer(0x8D41، هذا._مخزن_عمق)
        _gl_renderbuffer_storage(0x8D41، 0x81A5، هذا._عرض، هذا._ارتفاع)  # GL_DEPTH_COMPONENT
        _gl_framebuffer_renderbuffer(0x8D40، 0x8D00، 0x8D41، هذا._مخزن_عمق)
        
        # تحقق من الاكتمال
        متغير حالة = _gl_check_framebuffer_status(0x8D40)
        إذا (حالة != 0x8CD5)  # GL_FRAMEBUFFER_COMPLETE
            اطبع_سطر("خطأ: Framebuffer غير مكتمل - " + هذا._ترجم_حالة(حالة))
            ارجع خطأ
        نهاية
        
        # فك الربط
        _gl_bind_framebuffer(0x8D40، 0)
        
        ارجع صحيح
    نهاية

    دالة _ترجم_حالة(حالة)
        طابق (حالة)
            عندما 0x8CD6:
                ارجع "GL_FRAMEBUFFER_INCOMPLETE_ATTACHMENT"
            عندما 0x8CD7:
                ارجع "GL_FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT"
            عندما 0x8CDD:
                ارجع "GL_FRAMEBUFFER_UNSUPPORTED"
            افتراضي:
                ارجع "خطأ غير معروف: " + حالة
        نهاية
    نهاية

    دالة اربط()
        _gl_bind_framebuffer(0x8D40، هذا._معرف)
        _gl_viewport(0، 0، هذا._عرض، هذا._ارتفاع)
    نهاية

    دالة فك_ربط()
        _gl_bind_framebuffer(0x8D40، 0)
    نهاية

    دالة احذف()
        إذا (هذا._نسيج_لون > 0)
            _gl_delete_texture(هذا._نسيج_لون)
        نهاية
        إذا (هذا._مخزن_عمق > 0)
            _gl_delete_renderbuffer(هذا._مخزن_عمق)
        نهاية
        إذا (هذا._معرف > 0)
            _gl_delete_framebuffer(هذا._معرف)
        نهاية
    نهاية
نهاية
