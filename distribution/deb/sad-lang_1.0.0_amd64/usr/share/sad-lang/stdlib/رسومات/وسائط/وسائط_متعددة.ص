# العيب #121: VideoPlayer - مشغل فيديو
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

تعداد حالة_فيديو
    لم_يبدأ،
    جاري_التحميل،
    جاهز،
    يعمل،
    متوقف،
    انتهى،
    خطأ
نهاية

صدّر صنف متحكم_فيديو
    باني(رابط)
        هذا._رابط = رابط
        هذا._حالة = حالة_فيديو.لم_يبدأ
        هذا._موضع = 0
        هذا._مدة = 0
        هذا._حجم_صوت = 1.0
        هذا._صامت = خطأ
        هذا._سرعة = 1.0
        هذا._تكرار = خطأ
        
        هذا._مستمعون = []
    نهاية

    غير_متزامن دالة هيّئ()
        هذا._حالة = حالة_فيديو.جاري_التحميل
        # سيتم تنفيذها في C++
        هذا._حالة = حالة_فيديو.جاهز
        هذا._أخطر()
    نهاية

    دالة شغّل()
        إذا (هذا._حالة == حالة_فيديو.جاهز أو هذا._حالة == حالة_فيديو.متوقف)
            هذا._حالة = حالة_فيديو.يعمل
            هذا._أخطر()
        نهاية
    نهاية

    دالة أوقف()
        إذا (هذا._حالة == حالة_فيديو.يعمل)
            هذا._حالة = حالة_فيديو.متوقف
            هذا._أخطر()
        نهاية
    نهاية

    دالة اذهب_لموضع(ثوان)
        هذا._موضع = ثوان
        هذا._أخطر()
    نهاية

    دالة عيّن_حجم_صوت(حجم)
        هذا._حجم_صوت = حجم.ثبّت(0، 1)
    نهاية

    دالة عيّن_صامت(صامت)
        هذا._صامت = صامت
    نهاية

    دالة عيّن_سرعة(سرعة)
        هذا._سرعة = سرعة.ثبّت(0.25، 4)
    نهاية

    دالة عيّن_تكرار(تكرار)
        هذا._تكرار = تكرار
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة _أخطر()
        لكل مستمع في هذا._مستمعون
            مستمع({
                حالة: هذا._حالة،
                موضع: هذا._موضع،
                مدة: هذا._مدة
            })
        نهاية
    نهاية

    دالة تخلص()
        # تحرير الموارد
        هذا._حالة = حالة_فيديو.لم_يبدأ
    نهاية
نهاية

صدّر صنف مشغل_فيديو
    باني(إعدادات)
        هذا._متحكم = إعدادات.متحكم
        هذا._تلقائي = إعدادات.تلقائي أو خطأ
        هذا._تكرار = إعدادات.تكرار أو خطأ
        هذا._أدوات_تحكم = إعدادات.أدوات_تحكم أو صحيح
        هذا._نسبة_عرض = إعدادات.نسبة أو 16/9
    نهاية

    دالة بناء()
        ارجع {
            نوع: "مشغل_فيديو"،
            متحكم: هذا._متحكم،
            تلقائي: هذا._تلقائي،
            تكرار: هذا._تكرار،
            أدوات_تحكم: هذا._أدوات_تحكم،
            نسبة_عرض: هذا._نسبة_عرض
        }
    نهاية
نهاية

