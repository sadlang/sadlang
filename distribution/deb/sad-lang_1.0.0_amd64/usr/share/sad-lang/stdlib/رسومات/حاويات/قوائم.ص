# ===================================================================
#                    أكورديون: Expandable Panel
# ===================================================================

صدّر صنف أكورديون يرث عنصر
    باني(عنوان = لاشيء, محتوى = لاشيء, موسع = لاشيء, عند_التغيير = لاشيء, خلفية = لاشيء, لون_الرأس = لاشيء)
        هذا._نوع = "أكورديون"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["محتوى"] = محتوى
        هذا._خصائص["موسع"] = موسع
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["خلفية"] = خلفية
        هذا._خصائص["لون_الرأس"] = لون_الرأس
    نهاية

    دالة موسع()
        ارجع هذا._خصائص["موسع"] == صحيح
    نهاية

    دالة وسّع()
        هذا._خصائص["موسع"] = صحيح
        ارجع هذا
    نهاية

    دالة أغلق()
        هذا._خصائص["موسع"] = خطأ
        ارجع هذا
    نهاية

    دالة بدّل()
        إذا (هذا._خصائص["موسع"] == صحيح)
            هذا._خصائص["موسع"] = خطأ
        وإلا
            هذا._خصائص["موسع"] = صحيح
        نهاية
        ارجع هذا
    نهاية
نهاية
