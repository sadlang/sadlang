# بسم الله الرحمن الرحيم
# ===================================================================
# ملف: قوائم.ص
# المسار: stdlib/ui/حاويات/قوائم.ص
# ===================================================================
# عناصر القوائم والبطاقات مع دوال وصول وتعديل شاملة
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    قائمة: List View
# ===================================================================

صدّر صنف قائمة يرث عنصر
    باني(أبناء = لاشيء, تباعد = لاشيء, حشو = لاشيء, خلفية = لاشيء)
        هذا._نوع = "قائمة"
        هذا._أبناء = أبناء
        هذا._خصائص = {}
        هذا._خصائص["تباعد"] = تباعد
        هذا._خصائص["حشو"] = حشو
        هذا._خصائص["خلفية"] = خلفية
    نهاية

    دالة عدد_العناصر()
        إذا (هذا._أبناء != لاشيء)
            ارجع هذا._أبناء.طول
        نهاية
        ارجع 0
    نهاية
نهاية

# ===================================================================
#                    عنصر_قائمة_بيانات: List Item (renamed to avoid conflict)
# ===================================================================

صدّر صنف عنصر_قائمة_بيانات يرث عنصر
    باني(عنوان = لاشيء, عنوان_فرعي = لاشيء, أيقونة_بداية = لاشيء, أيقونة_نهاية = لاشيء, عند_الضغط = لاشيء, خلفية = لاشيء, حشو = لاشيء)
        هذا._نوع = "عنصر_قائمة"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["عنوان_فرعي"] = عنوان_فرعي
        هذا._خصائص["أيقونة_بداية"] = أيقونة_بداية
        هذا._خصائص["أيقونة_نهاية"] = أيقونة_نهاية
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["خلفية"] = خلفية
        هذا._خصائص["حشو"] = حشو
    نهاية

    دالة احصل_العنوان()
        ارجع هذا._خصائص["عنوان"]
    نهاية

    دالة عيّن_العنوان(قيمة)
        هذا._خصائص["عنوان"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_العنوان_الفرعي(قيمة)
        هذا._خصائص["عنوان_فرعي"] = قيمة
        ارجع هذا
    نهاية
نهاية

# ===================================================================
#                    بطاقة: Card
# ===================================================================

صدّر صنف بطاقة يرث عنصر
    باني(ابن = لاشيء, رفع = لاشيء, حشو = لاشيء, لون = لاشيء, عند_الضغط = لاشيء, زوايا = لاشيء, هامش = لاشيء, حد_لون = لاشيء, حد_سماكة = لاشيء)
        هذا._نوع = "بطاقة"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["رفع"] = رفع
        هذا._خصائص["حشو"] = حشو
        هذا._خصائص["لون"] = لون
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["زوايا"] = زوايا
        هذا._خصائص["هامش"] = هامش
        هذا._خصائص["حد_لون"] = حد_لون
        هذا._خصائص["حد_سماكة"] = حد_سماكة
    نهاية

    دالة احصل_اللون()
        ارجع هذا._خصائص["لون"]
    نهاية

    دالة عيّن_اللون(لون)
        هذا._خصائص["لون"] = لون
        ارجع هذا
    نهاية

    دالة عيّن_الرفع(قيمة)
        هذا._خصائص["رفع"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_الحشو(قيمة)
        هذا._خصائص["حشو"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_المحتوى(ابن)
        هذا._ابن = ابن
        ارجع هذا
    نهاية
نهاية

