# ===================================================================
#                    قابل_للطي: Collapsible
# ===================================================================

صدّر صنف قابل_للطي يرث عنصر
    باني(عنوان = لاشيء, محتوى = لاشيء, مطوي = لاشيء, عند_التغيير = لاشيء, أيقونة = لاشيء, خلفية = لاشيء)
        هذا._نوع = "قابل_للطي"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["محتوى"] = محتوى
        هذا._خصائص["مطوي"] = مطوي
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["أيقونة"] = أيقونة
        هذا._خصائص["خلفية"] = خلفية
    نهاية

    دالة مطوي()
        ارجع هذا._خصائص["مطوي"] == صحيح
    نهاية

    دالة اطوِ()
        هذا._خصائص["مطوي"] = صحيح
        ارجع هذا
    نهاية

    دالة وسّع()
        هذا._خصائص["مطوي"] = خطأ
        ارجع هذا
    نهاية

    دالة بدّل()
        إذا (هذا._خصائص["مطوي"] == صحيح)
            هذا._خصائص["مطوي"] = خطأ
        وإلا
            هذا._خصائص["مطوي"] = صحيح
        نهاية
        ارجع هذا
    نهاية
نهاية

