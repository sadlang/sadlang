# ===================================================================
#                   متحكم_حركة_متقدم (Advanced Animation Controller)
# ===================================================================
صدّر صنف متحكم_حركة_متقدم
    باني(مدة = 1000, عكسي = خطأ, تكرار = 1)
        هذا._مدة = مدة
        هذا._عكسي = عكسي
        هذا._تكرار = تكرار
        هذا._قيمة = 0.0
        هذا._حالة = "متوقف"
        هذا._مستمعون = []
        هذا._مستمعون_حالة = []
    نهاية

    دالة قدماً()
        هذا._حالة = "يعمل"
        هذا._أخطر_حالة()
        # بدء الحركة للأمام
        ارجع هذا
    نهاية

    دالة للخلف()
        هذا._حالة = "يعمل"
        هذا._عكسي = صحيح
        هذا._أخطر_حالة()
        # بدء الحركة للخلف
        ارجع هذا
    نهاية

    دالة أوقف()
        هذا._حالة = "متوقف"
        هذا._أخطر_حالة()
        ارجع هذا
    نهاية

    دالة أعد_تعيين()
        هذا._قيمة = 0.0
        هذا._حالة = "متوقف"
        هذا._أخطر()
        هذا._أخطر_حالة()
        ارجع هذا
    نهاية

    دالة كرر()
        هذا._تكرار = -1  # لانهائي
        ارجع هذا
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة يعمل()
        ارجع هذا._حالة == "يعمل"
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة أضف_مستمع_حالة(مستمع)
        هذا._مستمعون_حالة.أضف(مستمع)
    نهاية

    دالة _أخطر()
        لكل م في هذا._مستمعون
            م(هذا._قيمة)
        نهاية
    نهاية

    دالة _أخطر_حالة()
        لكل م في هذا._مستمعون_حالة
            م(هذا._حالة)
        نهاية
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
        هذا._مستمعون_حالة = []
    نهاية
نهاية

# ===================================================================
#                   تسلسل_حركات (Animation Sequence)
# ===================================================================
صدّر صنف تسلسل_حركات
    باني()
        هذا._حركات = []
        هذا._فهرس_حالي = 0
        هذا._يعمل = خطأ
    نهاية

    دالة أضف(حركة, مدة)
        هذا._حركات.أضف({"حركة": حركة, "مدة": مدة})
        ارجع هذا
    نهاية

    دالة انتظر(مدة)
        هذا._حركات.أضف({"حركة": لاشيء, "مدة": مدة})
        ارجع هذا
    نهاية

    دالة ابدأ()
        هذا._فهرس_حالي = 0
        هذا._يعمل = صحيح
        ارجع هذا
    نهاية

    دالة أوقف()
        هذا._يعمل = خطأ
        ارجع هذا
    نهاية
نهاية

# ===================================================================
#                   حركات_متوازية (Parallel Animations)
# ===================================================================
صدّر صنف حركات_متوازية
    باني(حركات = [])
        هذا._حركات = حركات
        هذا._يعمل = خطأ
    نهاية

    دالة أضف(حركة)
        هذا._حركات.أضف(حركة)
        ارجع هذا
    نهاية

    دالة ابدأ_الكل()
        هذا._يعمل = صحيح
        لكل ح في هذا._حركات
            ح.ابدأ()
        نهاية
        ارجع هذا
    نهاية

    دالة أوقف_الكل()
        هذا._يعمل = خطأ
        لكل ح في هذا._حركات
            ح.أوقف()
        نهاية
        ارجع هذا
    نهاية
نهاية

