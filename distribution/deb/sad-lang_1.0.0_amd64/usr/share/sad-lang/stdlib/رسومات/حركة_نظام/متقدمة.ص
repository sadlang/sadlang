# ===================================================================
#                   تأثير_نبض (Pulse Effect)
# ===================================================================
صدّر صنف نبض يرث عنصر
    باني(ابن = لاشيء, مدة = 1000, مقياس_أدنى = 0.95,
         مقياس_أقصى = 1.05, تكرار = صحيح, تلقائي = صحيح)
        هذا._نوع = "نبض"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["مدة"] = مدة
        هذا._خصائص["مقياس_أدنى"] = مقياس_أدنى
        هذا._خصائص["مقياس_أقصى"] = مقياس_أقصى
        هذا._خصائص["تكرار"] = تكرار
        هذا._خصائص["تلقائي"] = تلقائي
        هذا._خصائص["يعمل"] = تلقائي
    نهاية

    دالة ابدأ()
        هذا._خصائص["يعمل"] = صحيح
        ارجع هذا
    نهاية

    دالة أوقف()
        هذا._خصائص["يعمل"] = خطأ
        ارجع هذا
    نهاية
نهاية

