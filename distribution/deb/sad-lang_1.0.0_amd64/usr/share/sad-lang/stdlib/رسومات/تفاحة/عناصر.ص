        هذا._خصائص = {}
        هذا._خصائص["نص"] = نص
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["لون"] = لون
        هذا._خصائص["ضغط_شفافية"] = ضغط_شفافية
        هذا._خصائص["معطل"] = خطأ
        هذا._خصائص["محاذاة"] = "توسيط"
