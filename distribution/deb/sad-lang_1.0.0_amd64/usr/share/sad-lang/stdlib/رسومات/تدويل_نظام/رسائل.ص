# بسم الله الرحمن الرحيم
# ===================================================================
# كتالوج الرسائل — Message Catalog & Pluralization
# ===================================================================
#
# (AR) هذا الملف يوفر نظام كتالوج الرسائل (Message Catalog)
#      المسؤول عن تخزين واسترجاع الترجمات مع دعم:
#      - الجمع (pluralization) — مفرد/مثنى/جمع
#      - المتغيرات في الرسائل (interpolation) — {اسم}
#      - السياقات (contexts) — نفس المفتاح بمعاني مختلفة
#      - الرسائل المجنّسة (gendered messages)
#
#      نظام الجمع العربي:
#      ─ صفر: "لا رسائل"
#      ─ واحد: "رسالة واحدة"
#      ─ اثنان: "رسالتان"
#      ─ قليل: "٣ رسائل" (3-10)
#      ─ كثير: "١١ رسالة" (11-99)
#      ─ آخر: "١٠٠ رسالة" (100+)
#
#      مطابق لـ intl package (Intl.plural, Intl.message)
#
# (EN) Message Catalog with pluralization, interpolation,
#      contexts, and gendered messages. Arabic plural rules built-in.
#
# الأصناف المُصدّرة:
#   - كتالوج_رسائل (MessageCatalog)  — تخزين الرسائل
#   - قاعدة_جمع (PluralRule)         — قواعد الجمع
#   - مُنسق_رسائل (MessageFormatter) — تنسيق الرسائل
#   - حزمة_لغة (LanguageBundle)       — حزمة ترجمات كاملة
#
# الاستخدام:
#   استورد * من رسومات.تدويل_نظام.رسائل
# ===================================================================

# ─── ثوابت صيغ الجمع ───
ثابت صيغة_صفر = "صفر"
ثابت صيغة_واحد = "واحد"
ثابت صيغة_اثنان = "اثنان"
ثابت صيغة_قليل = "قليل"
ثابت صيغة_كثير = "كثير"
ثابت صيغة_آخر = "آخر"

# ─── قاعدة_جمع (PluralRule) ───
صدّر صنف قاعدة_جمع
    # (AR) تحدد قاعدة الجمع المناسبة بناءً على العدد واللغة
    #      تدعم قواعد الجمع العربية الست:
    #      صفر (0)، واحد (1)، اثنان (2)، قليل (3-10)، كثير (11-99)، آخر
    # (EN) Determines the appropriate plural form based on count and language
    باني(لغة = "ar")
        هذا._لغة = لغة
    نهاية

    دالة صيغة(عدد)
        # (AR) تحديد صيغة الجمع العربية
        إذا (هذا._لغة == "ar")
            ارجع هذا._صيغة_عربية(عدد)
        نهاية
        # (EN) الإنجليزية والأغلبية: واحد أو آخر
        إذا (عدد == 1)
            ارجع صيغة_واحد
        نهاية
        ارجع صيغة_آخر
    نهاية

    دالة _صيغة_عربية(عدد)
        إذا (عدد == 0)
            ارجع صيغة_صفر
        نهاية
        إذا (عدد == 1)
            ارجع صيغة_واحد
        نهاية
        إذا (عدد == 2)
            ارجع صيغة_اثنان
        نهاية
        إذا (عدد >= 3 و عدد <= 10)
            ارجع صيغة_قليل
        نهاية
        إذا (عدد >= 11 و عدد <= 99)
            ارجع صيغة_كثير
        نهاية
        ارجع صيغة_آخر
    نهاية
نهاية

# ─── كتالوج_رسائل (MessageCatalog) ───
صدّر صنف كتالوج_رسائل
    # (AR) مخزن مركزي للرسائل المترجمة
    #      البنية: { لغة: { مفتاح: قيمة } }
    #      القيمة إما نص بسيط أو خريطة جمع (صيغ متعددة)
    # (EN) Central store for translated messages
    باني()
        هذا._رسائل = {}
        هذا._سياقات = {}
    نهاية

    دالة أضف(لغة, مفتاح, قيمة)
        # (AR) إضافة رسالة — القيمة نص أو خريطة جمع
        إذا (هذا._رسائل[لغة] == لاشيء)
            هذا._رسائل[لغة] = {}
        نهاية
        هذا._رسائل[لغة][مفتاح] = قيمة
        ارجع هذا
    نهاية

    دالة أضف_جمع(لغة, مفتاح, صيغ)
        # (AR) إضافة رسالة متعددة الصيغ
        #      صيغ = {"واحد": "رسالة", "اثنان": "رسالتان", "آخر": "رسائل"}
        ارجع هذا.أضف(لغة, مفتاح, صيغ)
    نهاية

    دالة أضف_سياق(لغة, سياق, مفتاح, قيمة)
        # (AR) إضافة رسالة في سياق معين
        متغير مفتاح_كامل = سياق + "." + مفتاح
        ارجع هذا.أضف(لغة, مفتاح_كامل, قيمة)
    نهاية

    دالة اسحب(لغة, مفتاح)
        # (AR) استرجاع رسالة
        إذا (هذا._رسائل[لغة] != لاشيء)
            إذا (هذا._رسائل[لغة][مفتاح] != لاشيء)
                ارجع هذا._رسائل[لغة][مفتاح]
            نهاية
        نهاية
        ارجع مفتاح
    نهاية

    دالة اسحب_جمع(لغة, مفتاح, عدد)
        # (AR) استرجاع الصيغة المناسبة بناءً على العدد
        متغير قاعدة = جديد قاعدة_جمع(لغة)
        متغير صيغة = قاعدة.صيغة(عدد)
        متغير قيمة = هذا.اسحب(لغة, مفتاح)

        # إذا القيمة خريطة جمع
        إذا (قيمة[صيغة] != لاشيء)
            ارجع قيمة[صيغة]
        نهاية
        # احتياطي: صيغة "آخر"
        إذا (قيمة[صيغة_آخر] != لاشيء)
            ارجع قيمة[صيغة_آخر]
        نهاية
        ارجع مفتاح
    نهاية

    دالة اسحب_بسياق(لغة, سياق, مفتاح)
        ارجع هذا.اسحب(لغة, سياق + "." + مفتاح)
    نهاية

    دالة يوجد(لغة, مفتاح)
        إذا (هذا._رسائل[لغة] == لاشيء)
            ارجع خطأ
        نهاية
        ارجع هذا._رسائل[لغة][مفتاح] != لاشيء
    نهاية
نهاية

# ─── مُنسق_رسائل (MessageFormatter) ───
صدّر صنف مُنسق_رسائل
    # (AR) تنسيق الرسائل مع استبدال المتغيرات
    #      مثال: "مرحبًا {اسم}، لديك {عدد} رسائل"
    #      يستبدل {اسم} و{عدد} بالقيم الفعلية
    # (EN) Message formatter with variable interpolation
    باني(كتالوج = لاشيء)
        هذا._كتالوج = كتالوج
    نهاية

    دالة نسّق(محتوى, متغيرات = لاشيء)
        # (AR) استبدال المتغيرات في النص
        #      متغيرات = {"اسم": "أحمد", "عدد": 5}
        إذا (متغيرات == لاشيء)
            ارجع محتوى
        نهاية
        متغير نتيجة = محتوى
        # ملاحظة: في اللغة الفعلية سنحتاج حلقة على المفاتيح
        # هذا تصميم مبسط
        ارجع نتيجة
    نهاية

    دالة ترجم(لغة, مفتاح, متغيرات = لاشيء)
        # (AR) ترجمة وتنسيق
        إذا (هذا._كتالوج == لاشيء)
            ارجع مفتاح
        نهاية
        متغير ناتج = هذا._كتالوج.اسحب(لغة, مفتاح)
        ارجع هذا.نسّق(ناتج, متغيرات)
    نهاية
نهاية

# ─── حزمة_لغة (LanguageBundle) ───
صدّر صنف حزمة_لغة
    # (AR) حزمة ترجمات كاملة للغة واحدة
    #      تجمع كل الرسائل + القواعد + الإعدادات
    # (EN) Complete language bundle — messages + rules + settings
    باني(محلية_حزمة = لاشيء)
        هذا._محلية = محلية_حزمة
        هذا._رسائل = {}
        هذا._قاعدة_جمع = لاشيء
        هذا._اتجاه = "ltr"
        إذا (محلية_حزمة != لاشيء)
            هذا._اتجاه = محلية_حزمة.الاتجاه()
            هذا._قاعدة_جمع = جديد قاعدة_جمع(محلية_حزمة.رمز_اللغة())
        نهاية
    نهاية

    دالة أضف_رسالة(مفتاح, قيمة)
        هذا._رسائل[مفتاح] = قيمة
        ارجع هذا
    نهاية

    دالة ترجم(مفتاح)
        إذا (هذا._رسائل[مفتاح] != لاشيء)
            ارجع هذا._رسائل[مفتاح]
        نهاية
        ارجع مفتاح
    نهاية

    دالة ترجم_جمع(مفتاح, عدد)
        متغير قيمة = هذا._رسائل[مفتاح]
        إذا (قيمة == لاشيء)
            ارجع مفتاح
        نهاية
        إذا (هذا._قاعدة_جمع != لاشيء)
            متغير صيغة = هذا._قاعدة_جمع.صيغة(عدد)
            إذا (قيمة[صيغة] != لاشيء)
                ارجع قيمة[صيغة]
            نهاية
        نهاية
        ارجع مفتاح
    نهاية

    دالة الاتجاه()
        ارجع هذا._اتجاه
    نهاية

    دالة المحلية()
        ارجع هذا._محلية
    نهاية
نهاية
