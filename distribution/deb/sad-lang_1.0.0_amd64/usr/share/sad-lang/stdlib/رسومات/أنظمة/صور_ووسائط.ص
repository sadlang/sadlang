# ─── فلتر_خلفية (BackdropFilter) ───
صدّر صنف فلتر_خلفية يرث عنصر
    باني(فلتر, ابن = لاشيء, وضع_مزج = لاشيء)
        هذا._نوع = "فلتر_خلفية"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["فلتر"] = فلتر
        هذا._خصائص["وضع_مزج"] = وضع_مزج
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

# ─── فلتر_صورة (ImageFilter) ───
صدّر صنف فلتر_صورة
    ساكن دالة ضبابية(سيجما_س = 0.0, سيجما_ص = 0.0, وضع_بلاطة = "تقليد")
        ارجع {"نوع": "ضبابية", "سيجما_س": سيجما_س, "سيجما_ص": سيجما_ص, "وضع_بلاطة": وضع_بلاطة}
    نهاية

    ساكن دالة تركيب(فلتر_خارجي, فلتر_داخلي)
        ارجع {"نوع": "تركيب", "خارجي": فلتر_خارجي, "داخلي": فلتر_داخلي}
    نهاية

    ساكن دالة مصفوفة(مصفوفة)
        ارجع {"نوع": "مصفوفة", "مصفوفة": مصفوفة}
    نهاية
نهاية
