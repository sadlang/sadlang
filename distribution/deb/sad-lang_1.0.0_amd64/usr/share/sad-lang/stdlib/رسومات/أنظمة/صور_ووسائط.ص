استورد * من رسومات.أساس.عنصر

# ─── صورة (Image) ───
صدّر صنف صورة يرث عنصر
    باني(مزود, عرض = لاشيء, ارتفاع = لاشيء, ملاءمة = "احتواء", محاذاة = لاشيء, تكرار = "لا_تكرار", لون = لاشيء, وضع_مزج_لون = لاشيء, إطار_دلالي = لاشيء, استبعاد_من_دلالات = خطأ, تحميل_مؤطر = لاشيء, خطأ_مؤطر = لاشيء)
        هذا._نوع = "صورة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["مزود"] = مزود
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["ملاءمة"] = ملاءمة
        هذا._خصائص["محاذاة"] = محاذاة
        هذا._خصائص["تكرار"] = تكرار
        هذا._خصائص["لون"] = لون
        هذا._خصائص["تحميل_مؤطر"] = تحميل_مؤطر
        هذا._خصائص["خطأ_مؤطر"] = خطأ_مؤطر
    نهاية

    ساكن دالة شبكة(رابط, عرض = لاشيء, ارتفاع = لاشيء, ملاءمة = "احتواء", رؤوس = لاشيء, مقياس = 1.0, تحميل_مؤطر = لاشيء, خطأ_مؤطر = لاشيء)
        متغير ص = جديد صورة(لاشيء, عرض, ارتفاع, ملاءمة)
        ص._خصائص["رابط"] = رابط
        ص._خصائص["رؤوس"] = رؤوس
        ص._خصائص["مقياس"] = مقياس
        ص._خصائص["تحميل_مؤطر"] = تحميل_مؤطر
        ص._خصائص["خطأ_مؤطر"] = خطأ_مؤطر
        ارجع ص
    نهاية

    ساكن دالة أصل(اسم, عرض = لاشيء, ارتفاع = لاشيء, ملاءمة = "احتواء", حزمة = لاشيء)
        متغير ص = جديد صورة(لاشيء, عرض, ارتفاع, ملاءمة)
        ص._خصائص["اسم_أصل"] = اسم
        ص._خصائص["حزمة"] = حزمة
        ارجع ص
    نهاية

    ساكن دالة ملف(مسار, عرض = لاشيء, ارتفاع = لاشيء, ملاءمة = "احتواء")
        متغير ص = جديد صورة(لاشيء, عرض, ارتفاع, ملاءمة)
        ص._خصائص["مسار_ملف"] = مسار
        ارجع ص
    نهاية

    ساكن دالة ذاكرة(بايتات, عرض = لاشيء, ارتفاع = لاشيء, ملاءمة = "احتواء")
        متغير ص = جديد صورة(لاشيء, عرض, ارتفاع, ملاءمة)
        ص._خصائص["بايتات"] = بايتات
        ارجع ص
    نهاية
نهاية

