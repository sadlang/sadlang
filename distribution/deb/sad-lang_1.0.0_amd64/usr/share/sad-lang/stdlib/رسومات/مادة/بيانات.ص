# ===================================================================
# Material Design — عرض البيانات
# ===================================================================
# Card, ListTile, Chip, Badge, DataTable, Divider, Tooltip
# مطابق لـ flutter/material/card.dart + list_tile.dart + chip.dart
#
# الاستخدام:
#   استورد * من رسومات.مادة.بيانات
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── بطاقة_مادة (Card — M3) ───
صدّر صنف بطاقة_مادة يرث عنصر
    باني(ابن = لاشيء, نوع = "مرتفع")
        هذا._نوع = "بطاقة_مادة"
        هذا._خصائص = {}
        هذا._ابن = ابن
        هذا._خصائص["نوع"] = نوع
        هذا._خصائص["لون"] = لاشيء
        هذا._خصائص["ارتفاع_ظل"] = لاشيء
        هذا._خصائص["هامش"] = لاشيء
    نهاية

    دالة معبأ()
        هذا._خصائص["نوع"] = "معبأ"
        ارجع هذا
    نهاية

    دالة محدد()
        هذا._خصائص["نوع"] = "محدد"
        ارجع هذا
    نهاية
نهاية

# ─── عنصر_قائمة_مادة (ListTile — M3) ───
صدّر صنف عنصر_قائمة_مادة يرث عنصر
    باني(عنوان = لاشيء, عنوان_فرعي = لاشيء, رائد = لاشيء, لاحق = لاشيء)
        هذا._نوع = "عنصر_قائمة_مادة"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["عنوان_فرعي"] = عنوان_فرعي
        هذا._خصائص["رائد"] = رائد
        هذا._خصائص["لاحق"] = لاحق
        هذا._خصائص["عند_الضغط"] = لاشيء
        هذا._خصائص["كثيف"] = خطأ
        هذا._خصائص["محدد"] = خطأ
    نهاية

    دالة كثيف()
        هذا._خصائص["كثيف"] = صحيح
        ارجع هذا
    نهاية

    دالة محدد(قيمة)
        هذا._خصائص["محدد"] = قيمة
        ارجع هذا
    نهاية
نهاية

