# ===================================================================
# العناصر المتحركة — Animated Widgets
# ===================================================================
# عناصر تتحرك ضمنياً (Implicit Animations)
# مطابق لـ flutter/widgets/implicit_animations.dart
#
# الاستخدام:
#   استورد * من رسومات.حركة_نظام.عناصر_متحركة
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── حاوية_متحركة (AnimatedContainer) ───
صدّر صنف حاوية_متحركة يرث عنصر
    باني(مدة = 300, منحنى = "تسهيل", ابن = لاشيء)
        هذا._نوع = "حاوية_متحركة"
        هذا._خصائص = {}
        هذا._خصائص["مدة"] = مدة
        هذا._خصائص["منحنى"] = منحنى
        هذا._خصائص["عرض"] = لاشيء
        هذا._خصائص["ارتفاع"] = لاشيء
        هذا._خصائص["لون"] = لاشيء
        هذا._خصائص["حاشية"] = لاشيء
        هذا._خصائص["هامش"] = لاشيء
        هذا._خصائص["تزيين"] = لاشيء
        هذا._خصائص["محاذاة"] = لاشيء
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية

    دالة مع_أبعاد(عرض, ارتفاع)
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        ارجع هذا
    نهاية
نهاية

