استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    هيكل: الهيكل الرئيسي للتطبيق
# ===================================================================

صدّر صنف هيكل يرث عنصر
    باني(شريط = لاشيء, محتوى = لاشيء, درج = لاشيء, شريط_سفلي = لاشيء, زر_عائم = لاشيء, خلفية = لاشيء)
        هذا._نوع = "هيكل"
        هذا._خصائص = {}
        هذا._خصائص["شريط"] = شريط
        هذا._خصائص["محتوى"] = محتوى
        هذا._خصائص["درج"] = درج
        هذا._خصائص["شريط_سفلي"] = شريط_سفلي
        هذا._خصائص["زر_عائم"] = زر_عائم
        هذا._خصائص["خلفية"] = خلفية
    نهاية

    دالة احصل_الشريط()
        ارجع هذا._خصائص["شريط"]
    نهاية

    دالة عيّن_الشريط(شريط)
        هذا._خصائص["شريط"] = شريط
        ارجع هذا
    نهاية

    دالة احصل_المحتوى()
        ارجع هذا._خصائص["محتوى"]
    نهاية

    دالة عيّن_المحتوى(محتوى)
        هذا._خصائص["محتوى"] = محتوى
        ارجع هذا
    نهاية
نهاية

