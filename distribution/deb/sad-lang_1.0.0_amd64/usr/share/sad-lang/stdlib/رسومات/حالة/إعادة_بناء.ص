# ─── مفتاح_عنصر (Widget Key) ───
صدّر صنف مفتاح
    باني(قيمة)
        هذا._قيمة = قيمة
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة يساوي(آخر)
        إذا (آخر == لاشيء)
            ارجع خطأ
        نهاية
        ارجع هذا._قيمة == آخر.القيمة()
    نهاية
نهاية

صدّر دالة مفتاح_فريد()
    ارجع جديد مفتاح(_ولّد_معرف_فريد())
نهاية

صدّر دالة مفتاح_قيمة(قيمة)
    ارجع جديد مفتاح(قيمة)
نهاية

# ─── عداد المعرفات الفريدة ───
متغير _عداد_معرف = 0
دالة _ولّد_معرف_فريد()
    _عداد_معرف = _عداد_معرف + 1
    ارجع "key_" + نص(_عداد_معرف)
نهاية

# ─── نتيجة_المقارنة (Diff Result) ───
صدّر تعداد نوع_التغيير
    لا_تغيير,
    إضافة,
    حذف,
    تحديث,
    نقل
نهاية

صدّر صنف تغيير
    باني(نوع, عنصر_قديم = لاشيء, عنصر_جديد = لاشيء, مسار = لاشيء)
        هذا.نوع = نوع
        هذا.عنصر_قديم = عنصر_قديم
        هذا.عنصر_جديد = عنصر_جديد
        هذا.مسار = مسار
    نهاية
نهاية

# ─── محرك_المقارنة (Diff Engine) ───
صدّر صنف محرك_المقارنة
    باني()
        هذا._تغييرات = []
    نهاية

    # ─── مقارنة شجرتين ───
    دالة قارن(قديم, جديد)
        هذا._تغييرات = []
        هذا._قارن_عقدة(قديم, جديد, [])
        ارجع هذا._تغييرات
    نهاية

    # ─── مقارنة عقدة واحدة ───
    دالة _قارن_عقدة(قديم, جديد, مسار)
        # كلاهما لاشيء
        إذا (قديم == لاشيء و جديد == لاشيء)
            ارجع
        نهاية

        # القديم لاشيء = إضافة
        إذا (قديم == لاشيء)
            هذا._تغييرات = هذا._تغييرات + [
                جديد تغيير(نوع_التغيير.إضافة, لاشيء, جديد, مسار)
            ]
            ارجع
        نهاية

        # الجديد لاشيء = حذف
        إذا (جديد == لاشيء)
            هذا._تغييرات = هذا._تغييرات + [
                جديد تغيير(نوع_التغيير.حذف, قديم, لاشيء, مسار)
            ]
            ارجع
        نهاية

        # أنواع مختلفة = استبدال
        إذا (قديم.النوع() != جديد.النوع())
            هذا._تغييرات = هذا._تغييرات + [
                جديد تغيير(نوع_التغيير.حذف, قديم, لاشيء, مسار),
                جديد تغيير(نوع_التغيير.إضافة, لاشيء, جديد, مسار)
            ]
            ارجع
        نهاية

        # نفس النوع - مقارنة الخصائص
        إذا (هذا._خصائص_متغيرة(قديم, جديد))
            هذا._تغييرات = هذا._تغييرات + [
                جديد تغيير(نوع_التغيير.تحديث, قديم, جديد, مسار)
            ]
        نهاية

        # مقارنة الأبناء
        هذا._قارن_أبناء(قديم.الأبناء(), جديد.الأبناء(), مسار)
    نهاية

    # ─── مقارنة الخصائص ───
    دالة _خصائص_متغيرة(قديم, جديد)
        متغير خصائص_قديمة = قديم.الخصائص()
        متغير خصائص_جديدة = جديد.الخصائص()

        # مقارنة كل خاصية
        لكل مفتاح, قيمة في خصائص_جديدة
            إذا (خصائص_قديمة[مفتاح] != قيمة)
                ارجع صحيح
            نهاية
        نهاية

        # تحقق من خصائص محذوفة
        لكل مفتاح, قيمة في خصائص_قديمة
            إذا (خصائص_جديدة[مفتاح] == لاشيء)
                ارجع صحيح
            نهاية
        نهاية

        ارجع خطأ
    نهاية

    # ─── مقارنة الأبناء (خوارزمية LCS محسنة) ───
    دالة _قارن_أبناء(أبناء_قديمة, أبناء_جديدة, مسار)
        متغير طول_قديم = طول(أبناء_قديمة)
        متغير طول_جديد = طول(أبناء_جديدة)
        متغير الحد_الأقصى = طول_قديم
        
        إذا (طول_جديد > الحد_الأقصى)
            الحد_الأقصى = طول_جديد
        نهاية

        متغير ف = 0
        بينما (ف < الحد_الأقصى)
            متغير قديم = لاشيء
            متغير جديد_عنصر = لاشيء
            
            إذا (ف < طول_قديم)
                قديم = أبناء_قديمة[ف]
            نهاية
            
            إذا (ف < طول_جديد)
                جديد_عنصر = أبناء_جديدة[ف]
            نهاية
            
            هذا._قارن_عقدة(قديم, جديد_عنصر, مسار + [ف])
            ف = ف + 1
        نهاية
    نهاية
نهاية

# ─── مدير_إعادة_البناء (Rebuild Manager) ───
صدّر صنف مدير_إعادة_البناء
    باني()
        هذا._شجرة_حالية = لاشيء
        هذا._محرك = جديد محرك_المقارنة()
        هذا._مستمعون = []
        هذا._إحصائيات = {
            "إعادات_بناء": 0,
            "تغييرات_مطبقة": 0,
            "آخر_مدة": 0
        }
    نهاية

    # ─── تحديث الشجرة بذكاء ───
    دالة حدّث(شجرة_جديدة)
        متغير وقت_البدء = وقت_الآن()
        
        إذا (هذا._شجرة_حالية == لاشيء)
            # أول مرة - بناء كامل
            هذا._شجرة_حالية = شجرة_جديدة
            هذا._إحصائيات["إعادات_بناء"] = هذا._إحصائيات["إعادات_بناء"] + 1
            ارجع هذا
        نهاية

        # مقارنة الشجرتين
        متغير تغييرات = هذا._محرك.قارن(هذا._شجرة_حالية, شجرة_جديدة)
        
        # تطبيق التغييرات فقط
        لكل تغيير في تغييرات
            هذا._طبّق_تغيير(تغيير)
        نهاية

        # تحديث الشجرة الحالية
        هذا._شجرة_حالية = شجرة_جديدة
        
        # تحديث الإحصائيات
        هذا._إحصائيات["إعادات_بناء"] = هذا._إحصائيات["إعادات_بناء"] + 1
        هذا._إحصائيات["تغييرات_مطبقة"] = هذا._إحصائيات["تغييرات_مطبقة"] + طول(تغييرات)
        هذا._إحصائيات["آخر_مدة"] = وقت_الآن() - وقت_البدء

        # إشعار المستمعين
        لكل مستمع في هذا._مستمعون
            مستمع(تغييرات)
        نهاية

        ارجع هذا
    نهاية

    # ─── تطبيق تغيير واحد ───
    دالة _طبّق_تغيير(تغيير)
        طابق (تغيير.نوع)
            عندما نوع_التغيير.إضافة:
                # إضافة عنصر جديد للـ DOM/Tree
                أضف_عنصر_للشجرة(تغيير.عنصر_جديد, تغيير.مسار)
            عندما نوع_التغيير.حذف:
                # حذف عنصر من الـ DOM/Tree
                احذف_عنصر_من_الشجرة(تغيير.مسار)
            عندما نوع_التغيير.تحديث:
                # تحديث خصائص العنصر فقط
                حدّث_خصائص_عنصر(تغيير.عنصر_جديد, تغيير.مسار)
            افتراضي:
                # لا شيء
        نهاية
    نهاية

    # ─── إضافة مستمع ───
    دالة عند_تغيير(دالة_رد)
        هذا._مستمعون = هذا._مستمعون + [دالة_رد]
        ارجع هذا
    نهاية

    # ─── الإحصائيات ───
    دالة الإحصائيات()
        ارجع هذا._إحصائيات
    نهاية

    # ─── الشجرة الحالية ───
    دالة الشجرة()
        ارجع هذا._شجرة_حالية
    نهاية
نهاية

# ─── حالة_ذكية (Smart State) مع rebuild تلقائي ───
صدّر صنف حالة_ذكية
    باني(قيمة_أولية)
        هذا._قيمة = قيمة_أولية
        هذا._مستمعون = []
        هذا._عنصر_مرتبط = لاشيء
    نهاية

    خاصية القيمة
        احصل
            ارجع هذا._قيمة
        نهاية
        عيّن(قيمة_جديدة)
            إذا (هذا._قيمة != قيمة_جديدة)
                هذا._قيمة = قيمة_جديدة
                هذا._أشعر()
                هذا._أعد_البناء()
            نهاية
        نهاية
    نهاية

    دالة _أشعر()
        لكل مستمع في هذا._مستمعون
            مستمع(هذا._قيمة)
        نهاية
    نهاية

    دالة _أعد_البناء()
        إذا (هذا._عنصر_مرتبط != لاشيء)
            أعد_بناء_عنصر(هذا._عنصر_مرتبط)
        نهاية
    نهاية

    دالة اربط(عنصر)
        هذا._عنصر_مرتبط = عنصر
        ارجع هذا
    نهاية

    دالة عند_تغيير(دالة_رد)
        هذا._مستمعون = هذا._مستمعون + [دالة_رد]
        ارجع هذا
    نهاية
نهاية

# ─── Singleton ───
متغير _مدير_إعادة_بناء = لاشيء

صدّر دالة مدير_البناء()
    إذا (_مدير_إعادة_بناء == لاشيء)
        _مدير_إعادة_بناء = جديد مدير_إعادة_البناء()
    نهاية
    ارجع _مدير_إعادة_بناء
نهاية

