# ===================================================================
# شريط التنقل السفلي (BottomNavigationBar)
# ===================================================================
# مستوحى من Flutter BottomNavigationBar + NavigationBar
#
# ملاحظة: الأصناف التالية محذوفة (موجودة في ملفات أخرى):
#   عنصر_تنقل → حاويات/تنقل.ص
#   تنقل_جانبي → حاويات/تنقل_متقدم.ص
#   شريط_تبويب → حاويات/تنقل.ص
#   تبويب → حاويات/تنقل.ص
#
# الاستخدام:
#   استورد * من رسومات.عناصر.شريط_تنقل
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── شريط_تنقل_سفلي (BottomNavigationBar) ───
صدّر صنف شريط_تنقل_سفلي يرث عنصر
    باني(عناصر = لاشيء, الحالي = لاشيء, عند_ضغط = لاشيء, نوع = لاشيء, لون = لاشيء, لون_اختيار = لاشيء, لون_غير_مختار = لاشيء, ارتفاع = لاشيء)
        هذا._نوع = "شريط_تنقل_سفلي"
        هذا._خصائص = {}
        هذا._خصائص["عناصر"] = عناصر
        هذا._خصائص["الحالي"] = الحالي
        هذا._خصائص["عند_ضغط"] = عند_ضغط
        هذا._خصائص["نوع"] = نوع
        هذا._خصائص["لون"] = لون
        هذا._خصائص["لون_اختيار"] = لون_اختيار
        هذا._خصائص["لون_غير_مختار"] = لون_غير_مختار
        هذا._خصائص["ارتفاع"] = ارتفاع
    نهاية
نهاية

# ─── عنصر_جانبي (NavigationRailItem) ───
صدّر صنف عنصر_جانبي
    باني(أيقونة, تسمية, أيقونة_مختارة = لاشيء)
        هذا.أيقونة = أيقونة
        هذا.تسمية = تسمية
        هذا.أيقونة_مختارة = أيقونة_مختارة
    نهاية
نهاية

# ─── عرض_تبويب (TabBarView) ───
صدّر صنف عرض_تبويب يرث عنصر
    باني(أطفال = لاشيء, الحالي = لاشيء)
        هذا._نوع = "عرض_تبويب"
        هذا._خصائص = {}
        هذا._خصائص["الحالي"] = الحالي
        إذا (أطفال != لاشيء)
            هذا._أبناء = أطفال
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية
نهاية

# ─── شريط_تطبيق (AppBar متقدم) ───
صدّر صنف شريط_تطبيق_مرن يرث عنصر
    باني(عنوان = لاشيء, إجراءات = لاشيء, رائد = لاشيء, لون = لاشيء, ارتفاع = لاشيء, مرن = لاشيء, صورة_خلفية = لاشيء, عنوان_مرن = لاشيء)
        هذا._نوع = "شريط_تطبيق_مرن"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["إجراءات"] = إجراءات
        هذا._خصائص["رائد"] = رائد
        هذا._خصائص["لون"] = لون
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["مرن"] = مرن
        هذا._خصائص["صورة_خلفية"] = صورة_خلفية
        هذا._خصائص["عنوان_مرن"] = عنوان_مرن
    نهاية
نهاية
