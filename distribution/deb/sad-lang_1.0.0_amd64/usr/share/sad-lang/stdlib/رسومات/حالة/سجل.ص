# ===================================================================
# نظام التسجيل — Logging System
# ===================================================================
# تسجيل أحداث متعدد المستويات
#
# الاستخدام:
#   استورد * من رسومات.حالة.سجل
# ===================================================================

صدّر صنف مسجل
    باني(اسم)
        هذا._اسم = اسم
        هذا._مستوى = 0
        هذا._سجلات = []
        هذا._أقصى = 1000
    نهاية

    دالة _سجّل(مستوى, رسالة)
        متغير سجل = {
            "وقت": وقت_الآن(),
            "مستوى": مستوى,
            "مصدر": هذا._اسم,
            "رسالة": رسالة
        }
        هذا._سجلات.أضف(سجل)
        إذا (طول(هذا._سجلات) > هذا._أقصى)
            هذا._سجلات.احذف(0)
        نهاية

        إذا (مستوى >= هذا._مستوى)
            متغير بادئة = "[معلومات]"
            إذا (مستوى == 1)
                بادئة = "[تحذير]"
            وإلا
                إذا (مستوى == 2)
                    بادئة = "[خطأ]"
                وإلا
                    إذا (مستوى == 3)
                        بادئة = "[حرج]"
                    وإلا
                        إذا (مستوى == -1)
                            بادئة = "[تصحيح]"
                        نهاية
                    نهاية
                نهاية
            نهاية
            اطبع_سطر(بادئة + " " + هذا._اسم + ": " + رسالة)
        نهاية
    نهاية

    دالة تصحيح(رسالة)
        هذا._سجّل(-1, رسالة)
    نهاية

    دالة معلومات(رسالة)
        هذا._سجّل(0, رسالة)
    نهاية

    دالة تحذير(رسالة)
        هذا._سجّل(1, رسالة)
    نهاية

    دالة خطأ(رسالة)
        هذا._سجّل(2, رسالة)
    نهاية

    دالة حرج(رسالة)
        هذا._سجّل(3, رسالة)
    نهاية

    دالة مستوى(م)
        هذا._مستوى = م
        ارجع هذا
    نهاية

    دالة السجلات()
        ارجع هذا._سجلات
    نهاية

    دالة امسح()
        هذا._سجلات = []
    نهاية
نهاية

# ─── مسجل عام ───
متغير _المسجل = لاشيء

صدّر دالة المسجل()
    إذا (_المسجل == لاشيء)
        _المسجل = جديد مسجل("تطبيق")
    نهاية
    ارجع _المسجل
نهاية

صدّر دالة سجل_تصحيح(رسالة)
    المسجل().تصحيح(رسالة)
نهاية

صدّر دالة سجل_معلومات(رسالة)
    المسجل().معلومات(رسالة)
نهاية

صدّر دالة سجل_تحذير(رسالة)
    المسجل().تحذير(رسالة)
نهاية

صدّر دالة سجل_خطأ(رسالة)
    المسجل().خطأ(رسالة)
نهاية
