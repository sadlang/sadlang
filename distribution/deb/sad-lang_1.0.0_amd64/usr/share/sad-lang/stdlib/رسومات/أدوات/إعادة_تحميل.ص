# ─── مراقب_ملفات (FileWatcher) ───
صدّر صنف مراقب_ملفات
    باني(مسار_المشروع)
        هذا._مسار = مسار_المشروع
        هذا._ملفات_مراقبة = {}
        هذا._مستمعون = []
        هذا._فعال = خطأ
        هذا._فترة_فحص = 500  # مللي ثانية
    نهاية

    # ─── بدء المراقبة ───
    دالة ابدأ()
        هذا._فعال = صحيح
        هذا._فحص_أولي()
        هذا._بدء_حلقة_مراقبة()
        ارجع هذا
    نهاية

    # ─── إيقاف المراقبة ───
    دالة أوقف()
        هذا._فعال = خطأ
        ارجع هذا
    نهاية

    # ─── إضافة مستمع للتغييرات ───
    دالة عند_تغيير(دالة_رد)
        هذا._مستمعون = هذا._مستمعون + [دالة_رد]
        ارجع هذا
    نهاية

    # ─── الفحص الأولي للملفات ───
    دالة _فحص_أولي()
        متغير ملفات = اقرأ_مجلد(هذا._مسار, صحيح)  # recursive
        لكل ملف في ملفات
            إذا (ملف.ينتهي_بـ(".ص"))
                هذا._ملفات_مراقبة[ملف] = {
                    "آخر_تعديل": تاريخ_تعديل_ملف(ملف),
                    "حجم": حجم_ملف(ملف)
                }
            نهاية
        نهاية
    نهاية

    # ─── حلقة المراقبة ───
    دالة _بدء_حلقة_مراقبة()
        بينما (هذا._فعال)
            هذا._فحص_تغييرات()
            انتظر(هذا._فترة_فحص)
        نهاية
    نهاية

    # ─── فحص التغييرات ───
    دالة _فحص_تغييرات()
        متغير ملفات_متغيرة = []
        
        لكل مسار, معلومات في هذا._ملفات_مراقبة
            متغير تاريخ_جديد = تاريخ_تعديل_ملف(مسار)
            متغير حجم_جديد = حجم_ملف(مسار)
            
            إذا (تاريخ_جديد != معلومات["آخر_تعديل"] أو حجم_جديد != معلومات["حجم"])
                ملفات_متغيرة = ملفات_متغيرة + [مسار]
                هذا._ملفات_مراقبة[مسار] = {
                    "آخر_تعديل": تاريخ_جديد,
                    "حجم": حجم_جديد
                }
            نهاية
        نهاية
        
        # إشعار المستمعين
        إذا (طول(ملفات_متغيرة) > 0)
            لكل مستمع في هذا._مستمعون
                مستمع(ملفات_متغيرة)
            نهاية
        نهاية
    نهاية
نهاية

# ─── مدير_إعادة_التحميل (HotReloadManager) ───
صدّر صنف مدير_إعادة_التحميل
    باني()
        هذا._مراقب = لاشيء
        هذا._حالة_محفوظة = {}
        هذا._وحدات_محملة = {}
        هذا._فعال = خطأ
        هذا._عند_إعادة_تحميل = []
        هذا._عند_خطأ = []
    نهاية

    # ─── تفعيل Hot Reload ───
    دالة فعّل(مسار_المشروع)
        هذا._مراقب = جديد مراقب_ملفات(مسار_المشروع)
        هذا._مراقب.عند_تغيير(لامدا ملفات: هذا._معالجة_تغييرات(ملفات))
        هذا._مراقب.ابدأ()
        هذا._فعال = صحيح
        اطبع_سطر("🔥 Hot Reload مفعّل - المسار: " + مسار_المشروع)
        ارجع هذا
    نهاية

    # ─── إيقاف Hot Reload ───
    دالة أوقف()
        إذا (هذا._مراقب != لاشيء)
            هذا._مراقب.أوقف()
        نهاية
        هذا._فعال = خطأ
        ارجع هذا
    نهاية

    # ─── حفظ الحالة قبل إعادة التحميل ───
    دالة احفظ_حالة(اسم, قيمة)
        هذا._حالة_محفوظة[اسم] = قيمة
        ارجع هذا
    نهاية

    # ─── استرجاع الحالة بعد إعادة التحميل ───
    دالة استرجع_حالة(اسم, قيمة_افتراضية = لاشيء)
        إذا (هذا._حالة_محفوظة[اسم] != لاشيء)
            ارجع هذا._حالة_محفوظة[اسم]
        نهاية
        ارجع قيمة_افتراضية
    نهاية

    # ─── مستمع إعادة التحميل ───
    دالة عند_إعادة_تحميل(دالة_رد)
        هذا._عند_إعادة_تحميل = هذا._عند_إعادة_تحميل + [دالة_رد]
        ارجع هذا
    نهاية

    # ─── مستمع الأخطاء ───
    دالة عند_خطأ(دالة_رد)
        هذا._عند_خطأ = هذا._عند_خطأ + [دالة_رد]
        ارجع هذا
    نهاية

    # ─── معالجة التغييرات ───
    دالة _معالجة_تغييرات(ملفات_متغيرة)
        اطبع_سطر("🔄 تم اكتشاف تغييرات في " + نص(طول(ملفات_متغيرة)) + " ملف")
        
        لكل مسار في ملفات_متغيرة
            اطبع_سطر("  📝 " + مسار)
        نهاية
        
        حاول
            # إعادة تحميل الوحدات المتغيرة
            لكل مسار في ملفات_متغيرة
                هذا._أعد_تحميل_وحدة(مسار)
            نهاية
            
            # إشعار المستمعين بنجاح إعادة التحميل
            لكل مستمع في هذا._عند_إعادة_تحميل
                مستمع(ملفات_متغيرة)
            نهاية
            
            اطبع_سطر("✅ تم إعادة التحميل بنجاح!")
            
        امسك خطأ
            اطبع_سطر("❌ خطأ في إعادة التحميل: " + خطأ)
            لكل مستمع في هذا._عند_خطأ
                مستمع(خطأ, ملفات_متغيرة)
            نهاية
        نهاية
    نهاية

    # ─── إعادة تحميل وحدة واحدة ───
    دالة _أعد_تحميل_وحدة(مسار)
        # قراءة الملف الجديد
        متغير محتوى = اقرأ_ملف(مسار)
        
        # تحليل وتنفيذ
        أعد_تحميل_وحدة(مسار, محتوى)
        
        # تحديث الشجرة
        إذا (دالة_إعادة_بناء_متاحة())
            أعد_بناء_الشجرة()
        نهاية
    نهاية
نهاية

# ─── Singleton للوصول العام ───
متغير _مدير_إعادة_تحميل = لاشيء

صدّر دالة إعادة_التحميل()
    إذا (_مدير_إعادة_تحميل == لاشيء)
        _مدير_إعادة_تحميل = جديد مدير_إعادة_التحميل()
    نهاية
    ارجع _مدير_إعادة_تحميل
نهاية

# ─── دالة مساعدة لتفعيل Hot Reload بسرعة ───
صدّر دالة فعّل_إعادة_التحميل(مسار = ".")
    ارجع إعادة_التحميل().فعّل(مسار)
نهاية

# ─── معلومات إعادة التحميل ───
صدّر صنف معلومات_إعادة_تحميل
    باني(ملفات, وقت_البدء, وقت_الانتهاء)
        هذا.ملفات = ملفات
        هذا.وقت_البدء = وقت_البدء
        هذا.وقت_الانتهاء = وقت_الانتهاء
        هذا.المدة = وقت_الانتهاء - وقت_البدء
    نهاية

    دالة ملخص()
        ارجع "أُعيد تحميل " + نص(طول(هذا.ملفات)) + " ملف في " + نص(هذا.المدة) + " مللي ثانية"
    نهاية
نهاية
