استورد * من رسومات.أساس.عنصر

# ─── حزمة الأصول الأساسية ───
صدّر صنف حزمة_أصول
    باني()
    نهاية

    غير_متزامن دالة حمّل_نص(مفتاح)
        # يُنفذ في الأصناف الفرعية
        ارمي خطأ("لم يتم تنفيذه")
    نهاية

    غير_متزامن دالة حمّل_بيانات(مفتاح)
        # يُنفذ في الأصناف الفرعية
        ارمي خطأ("لم يتم تنفيذه")
    نهاية

    غير_متزامن دالة حمّل_صورة(مفتاح)
        متغير بيانات = انتظر هذا.حمّل_بيانات(مفتاح)
        ارجع فك_ترميز_صورة(بيانات)
    نهاية

    غير_متزامن دالة حمّل_json(مفتاح)
        متغير نص = انتظر هذا.حمّل_نص(مفتاح)
        ارجع حلل_json(نص)
    نهاية

    دالة أخلِ_ذاكرة()
        # تنظيف الذاكرة المؤقتة
    نهاية
نهاية

# ─── حزمة الأصول الافتراضية (DefaultAssetBundle) ───
صدّر صنف حزمة_أصول_افتراضية يرث حزمة_أصول
    ساكن متغير _نسخة = لاشيء

    ساكن دالة النسخة()
        إذا (_نسخة == لاشيء)
            _نسخة = جديد حزمة_أصول_افتراضية()
        نهاية
        ارجع _نسخة
    نهاية

    باني()
        الأساس()
        هذا._ذاكرة_نص = {}
        هذا._ذاكرة_بيانات = {}
        هذا._جذر = "أصول/"
    نهاية

    غير_متزامن دالة حمّل_نص(مفتاح)
        # تحقق من الذاكرة المؤقتة
        إذا (هذا._ذاكرة_نص[مفتاح])
            ارجع هذا._ذاكرة_نص[مفتاح]
        نهاية
        
        متغير مسار = هذا._جذر + مفتاح
        متغير نص = انتظر اقرأ_ملف_نص_أصل(مسار)
        هذا._ذاكرة_نص[مفتاح] = نص
        ارجع نص
    نهاية

    غير_متزامن دالة حمّل_بيانات(مفتاح)
        # تحقق من الذاكرة المؤقتة
        إذا (هذا._ذاكرة_بيانات[مفتاح])
            ارجع هذا._ذاكرة_بيانات[مفتاح]
        نهاية
        
        متغير مسار = هذا._جذر + مفتاح
        متغير بيانات = انتظر اقرأ_ملف_ثنائي_أصل(مسار)
        هذا._ذاكرة_بيانات[مفتاح] = بيانات
        ارجع بيانات
    نهاية

    دالة أخلِ_ذاكرة()
        هذا._ذاكرة_نص = {}
        هذا._ذاكرة_بيانات = {}
    نهاية

    ساكن دالة من(سياق)
        # البحث عن أقرب حزمة أصول في الشجرة
        متغير حالي = سياق
        بينما (حالي != لاشيء)
            إذا (حالي.النوع() == "حزمة_أصول_افتراضية_عنصر")
                ارجع حالي.الحزمة()
            نهاية
            حالي = حالي.الأب()
        نهاية
        ارجع حزمة_أصول_افتراضية.النسخة()
    نهاية
نهاية

# ─── حزمة أصول مخصصة ───
صدّر صنف حزمة_أصول_شبكة يرث حزمة_أصول
    باني(رابط_أساس، ترويسات = لاشيء)
        الأساس()
        هذا._رابط = رابط_أساس
        هذا._ترويسات = ترويسات أو {}
        هذا._ذاكرة = {}
    نهاية

    غير_متزامن دالة حمّل_نص(مفتاح)
        إذا (هذا._ذاكرة[مفتاح])
            ارجع هذا._ذاكرة[مفتاح]
        نهاية
        
        متغير رابط = هذا._رابط + "/" + مفتاح
        متغير استجابة = انتظر طلب_شبكة(رابط، هذا._ترويسات)
        متغير نص = استجابة.النص()
        هذا._ذاكرة[مفتاح] = نص
        ارجع نص
    نهاية

    غير_متزامن دالة حمّل_بيانات(مفتاح)
        متغير رابط = هذا._رابط + "/" + مفتاح
        متغير استجابة = انتظر طلب_شبكة(رابط، هذا._ترويسات)
        ارجع استجابة.البيانات()
    نهاية

    دالة أخلِ_ذاكرة()
        هذا._ذاكرة = {}
    نهاية
نهاية

# ─── حزمة أصول مضغوطة ───
صدّر صنف حزمة_أصول_مضغوطة يرث حزمة_أصول
    باني(مسار_الأرشيف)
        الأساس()
        هذا._مسار = مسار_الأرشيف
        هذا._فهرس = {}
        هذا._مُحمّل = خطأ
    نهاية

    غير_متزامن دالة _حمّل_فهرس()
        إذا (هذا._مُحمّل)
            ارجع
        نهاية
        
        # قراءة فهرس الأرشيف
        متغير بيانات_فهرس = انتظر اقرأ_فهرس_أرشيف(هذا._مسار)
        هذا._فهرس = بيانات_فهرس
        هذا._مُحمّل = صحيح
    نهاية

    غير_متزامن دالة حمّل_نص(مفتاح)
        انتظر هذا._حمّل_فهرس()
        
        إذا (ليس هذا._فهرس[مفتاح])
            ارمي خطأ("الأصل غير موجود: " + مفتاح)
        نهاية
        
        متغير بيانات = انتظر اقرأ_ملف_من_أرشيف(هذا._مسار، مفتاح)
        ارجع فك_ترميز_نص(بيانات)
    نهاية

    غير_متزامن دالة حمّل_بيانات(مفتاح)
        انتظر هذا._حمّل_فهرس()
        
        إذا (ليس هذا._فهرس[مفتاح])
            ارمي خطأ("الأصل غير موجود: " + مفتاح)
        نهاية
        
        ارجع انتظر اقرأ_ملف_من_أرشيف(هذا._مسار، مفتاح)
    نهاية

    دالة قائمة_الأصول()
        ارجع هذا._فهرس.المفاتيح()
    نهاية
نهاية

# ─── عنصر حزمة الأصول (DefaultAssetBundle Widget) ───
صدّر صنف عنصر_حزمة_أصول يرث عنصر
    باني(حزمة، ابن)
        هذا._نوع = "حزمة_أصول_افتراضية_عنصر"
        هذا._حزمة = حزمة
        هذا._ابن = ابن
    نهاية

    دالة الحزمة()
        ارجع هذا._حزمة
    نهاية
نهاية

# ─── مسارات الأصول ───
صدّر صنف مسارات_أصول
    ساكن ثابت صور = "صور/"
    ساكن ثابت أيقونات = "أيقونات/"
    ساكن ثابت خطوط = "خطوط/"
    ساكن ثابت بيانات = "بيانات/"
    ساكن ثابت ترجمات = "ترجمات/"
    ساكن ثابت أصوات = "أصوات/"
    ساكن ثابت فيديو = "فيديو/"

    ساكن دالة صورة(اسم)
        ارجع مسارات_أصول.صور + اسم
    نهاية

    ساكن دالة أيقونة(اسم)
        ارجع مسارات_أصول.أيقونات + اسم
    نهاية

    ساكن دالة خط(اسم)
        ارجع مسارات_أصول.خطوط + اسم
    نهاية

    ساكن دالة ترجمة(لغة)
        ارجع مسارات_أصول.ترجمات + لغة + ".json"
    نهاية
نهاية

# ─── محمّل الأصول حسب الكثافة ───
صدّر صنف محمّل_صور_كثافة
    باني()
        هذا._كثافات = [1.0، 1.5، 2.0، 3.0، 4.0]
    نهاية

    دالة مسار_مناسب(مسار_أساسي، كثافة_شاشة)
        # البحث عن أقرب كثافة متاحة
        متغير أقرب = 1.0
        متغير فرق_أصغر = 999
        
        لكل ك في هذا._كثافات
            متغير فرق = |ك - كثافة_شاشة|
            إذا (فرق < فرق_أصغر)
                فرق_أصغر = فرق
                أقرب = ك
            نهاية
        نهاية
        
        # بناء المسار
        إذا (أقرب == 1.0)
            ارجع مسار_أساسي
        نهاية
        
        متغير أجزاء = مسار_أساسي.قسّم("/")
        متغير اسم = أجزاء.احذف_أخير()
        متغير مجلد_كثافة = نص(أقرب) + "x"
        أجزاء.أضف(مجلد_كثافة)
        أجزاء.أضف(اسم)
        ارجع أجزاء.اربط("/")
    نهاية
نهاية

# ─── تحميل مُسبق للأصول ───
صدّر صنف محمّل_مُسبق
    باني()
        هذا._قائمة_انتظار = []
        هذا._مُحمّلة = []
        هذا._جارٍ = خطأ
    نهاية

    دالة أضف(مسار)
        هذا._قائمة_انتظار.أضف(مسار)
        ارجع هذا
    نهاية

    دالة أضف_عدة(مسارات)
        لكل م في مسارات
            هذا._قائمة_انتظار.أضف(م)
        نهاية
        ارجع هذا
    نهاية

    غير_متزامن دالة حمّل_الكل(عند_التقدم = لاشيء)
        هذا._جارٍ = صحيح
        متغير إجمالي = هذا._قائمة_انتظار.الطول()
        
        لكل ف من 0 الى إجمالي
            متغير مسار = هذا._قائمة_انتظار[ف]
            حاول
                انتظر حزمة_أصول_افتراضية.النسخة().حمّل_بيانات(مسار)
                هذا._مُحمّلة.أضف(مسار)
            امسك خ
                # تجاهل الأخطاء، سجلها فقط
                اطبع("فشل تحميل: " + مسار)
            نهاية
            
            إذا (عند_التقدم != لاشيء)
                عند_التقدم((ف + 1) / إجمالي)
            نهاية
        نهاية
        
        هذا._جارٍ = خطأ
        هذا._قائمة_انتظار = []
    نهاية

    دالة التقدم()
        إذا (هذا._قائمة_انتظار.الطول() == 0)
            ارجع 1.0
        نهاية
        ارجع هذا._مُحمّلة.الطول() / (هذا._مُحمّلة.الطول() + هذا._قائمة_انتظار.الطول())
    نهاية
نهاية
