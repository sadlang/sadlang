# ─── هيكل_تحميل (Shimmer/Skeleton) ─── [عنصر جديد 43]
صدّر صنف هيكل_تحميل يرث عنصر
    باني(عرض = 200, ارتفاع = 20, نصف_قطر = 4, لون_أساس = "#E0E0E0", لون_تألق = "#F5F5F5", مدة = 1500)
        هذا._نوع = "هيكل_تحميل"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["نصف_قطر"] = نصف_قطر
        هذا._خصائص["لون_أساس"] = لون_أساس
        هذا._خصائص["لون_تألق"] = لون_تألق
        هذا._خصائص["مدة"] = مدة
    نهاية

    ساكن دالة دائري(نصف_قطر = 30, لون_أساس = "#E0E0E0")
        متغير هـ = جديد هيكل_تحميل(نصف_قطر * 2, نصف_قطر * 2, نصف_قطر, لون_أساس)
        ارجع هـ
    نهاية

    ساكن دالة نص(عرض = 150, ارتفاع = 14, لون_أساس = "#E0E0E0")
        ارجع جديد هيكل_تحميل(عرض, ارتفاع, 4, لون_أساس)
    نهاية
نهاية
