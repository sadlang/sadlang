# عناصر التقدم والتحميل مع دوال وصول وتعديل شاملة
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    شريط_تقدم: Progress Bar
# ===================================================================

صدّر صنف شريط_تقدم يرث عنصر
    باني(قيمة = لاشيء, لون = لاشيء, طريقة_عرض = لاشيء, خلفية = لاشيء, ارتفاع = لاشيء, زوايا = لاشيء)
        هذا._نوع = "شريط_تقدم"
        هذا._خصائص = {}
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["لون"] = لون
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
        هذا._خصائص["خلفية"] = خلفية
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["زوايا"] = زوايا
    نهاية

    دالة احصل_القيمة()
        ارجع هذا._خصائص["قيمة"]
    نهاية

    دالة عيّن_القيمة(قيمة)
        هذا._خصائص["قيمة"] = قيمة
        ارجع هذا
    نهاية

    دالة احصل_اللون()
        ارجع هذا._خصائص["لون"]
    نهاية

    دالة عيّن_اللون(لون)
        هذا._خصائص["لون"] = لون
        ارجع هذا
    نهاية

    دالة مكتمل()
        ارجع هذا._خصائص["قيمة"] >= 100
    نهاية

    دالة أعد_التعيين()
        هذا._خصائص["قيمة"] = 0
        ارجع هذا
    نهاية
نهاية

