# ─── متحكم_تمرير (ScrollController) ─── [نظام 11]
صدّر صنف متحكم_تمرير
    باني(إزاحة_أولية = 0, تسمية_تصحيح = لاشيء)
        هذا._إزاحة = إزاحة_أولية
        هذا._مستمعون = []
        هذا._متصل = خطأ
    نهاية

    دالة الإزاحة()
        ارجع هذا._إزاحة
    نهاية

    دالة حرّك_إلى(إزاحة, مدة = 300, منحنى = "سهولة")
        هذا._إزاحة = إزاحة
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة اقفز_إلى(إزاحة)
        هذا._إزاحة = إزاحة
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة أضف_مستمع(رد_نداء)
        هذا._مستمعون = هذا._مستمعون + [رد_نداء]
    نهاية

    دالة أزل_مستمع(رد_نداء)
        متغير جديدة = []
        لكل م في هذا._مستمعون
            إذا (م != رد_نداء)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مستمعون = جديدة
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
    نهاية
نهاية

