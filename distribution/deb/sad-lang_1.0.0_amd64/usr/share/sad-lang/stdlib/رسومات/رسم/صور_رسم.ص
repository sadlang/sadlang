# ─── مزود_صور (ImageProvider) ───
صدّر صنف مزود_صور
    باني()
        هذا._نوع = "مجرد"
    نهاية

    دالة حل(تهيئة)
        ارجع لاشيء
    نهاية
نهاية

# ─── صورة_شبكة (NetworkImage) ───
صدّر صنف صورة_شبكة يرث مزود_صور
    باني(رابط, مقياس = 1.0, ترويسات = لاشيء)
        هذا._نوع = "شبكة"
        هذا._رابط = رابط
        هذا._مقياس = مقياس
        هذا._ترويسات = ترويسات
    نهاية

    دالة الرابط()
        ارجع هذا._رابط
    نهاية
نهاية

# ─── صورة_أصل (AssetImage) ───
صدّر صنف صورة_أصل يرث مزود_صور
    باني(اسم_الأصل, حزمة = لاشيء)
        هذا._نوع = "أصل"
        هذا._اسم = اسم_الأصل
        هذا._حزمة = حزمة
    نهاية

    دالة الاسم()
        ارجع هذا._اسم
    نهاية
نهاية

# ─── صورة_ذاكرة (MemoryImage) ───
صدّر صنف صورة_ذاكرة يرث مزود_صور
    باني(بايتات)
        هذا._نوع = "ذاكرة"
        هذا._بايتات = بايتات
    نهاية

    دالة البايتات()
        ارجع هذا._بايتات
    نهاية
نهاية

# ─── صورة_ملف (FileImage) ───
صدّر صنف صورة_ملف يرث مزود_صور
    باني(مسار, مقياس = 1.0)
        هذا._نوع = "ملف"
        هذا._مسار = مسار
        هذا._مقياس = مقياس
    نهاية

    دالة المسار()
        ارجع هذا._مسار
    نهاية
نهاية

# ─── ملاءمة_صندوق (BoxFit) ───
صدّر ثابت ملاءمة = {
    "ملء": "fill",
    "احتواء": "contain",
    "تغطية": "cover",
    "عرض_كامل": "fitWidth",
    "ارتفاع_كامل": "fitHeight",
    "لا_شيء": "none",
    "تقليص": "scaleDown"
}

# ─── تكرار_صورة (ImageRepeat) ───
صدّر ثابت تكرار_صورة = {
    "تكرار": "repeat",
    "تكرار_أفقي": "repeatX",
    "تكرار_عمودي": "repeatY",
    "لا_تكرار": "noRepeat"
}

# ─── بيانات_أيقونة (IconData) ───
صدّر صنف بيانات_أيقونة
    باني(رمز, عائلة = "MaterialIcons", حزمة = لاشيء)
        هذا._رمز = رمز
        هذا._عائلة = عائلة
        هذا._حزمة = حزمة
    نهاية

    دالة الرمز()
        ارجع هذا._رمز
    نهاية

    دالة العائلة()
        ارجع هذا._عائلة
    نهاية
نهاية
