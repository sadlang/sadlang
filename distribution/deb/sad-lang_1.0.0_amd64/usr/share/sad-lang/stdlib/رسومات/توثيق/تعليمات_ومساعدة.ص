صدّر صنف مدير_جولات
    ساكن متغير _مثيل = لاشيء
    
    ساكن دالة احصل_مثيل()
        إذا (مدير_جولات._مثيل == لاشيء)
            مدير_جولات._مثيل = جديد مدير_جولات()
        نهاية
        ارجع مدير_جولات._مثيل
    نهاية

    باني()
        هذا._جولات = {}
        هذا._جولة_حالية = لاشيء
        هذا._خطوة_حالية = 0
        هذا._مكتملة = {}
    نهاية

    دالة سجّل_جولة(اسم، خطوات)
        هذا._جولات[اسم] = خطوات
    نهاية

    دالة ابدأ_جولة(اسم)
        إذا (هذا._جولات[اسم])
            هذا._جولة_حالية = اسم
            هذا._خطوة_حالية = 0
            هذا._أظهر_خطوة_حالية()
        نهاية
    نهاية

    دالة التالي()
        متغير خطوات = هذا._جولات[هذا._جولة_حالية]
        إذا (هذا._خطوة_حالية < خطوات.الطول() - 1)
            هذا._خطوة_حالية += 1
            هذا._أظهر_خطوة_حالية()
        وإلا
            هذا.أنهِ_جولة()
        نهاية
    نهاية

    دالة السابق()
        إذا (هذا._خطوة_حالية > 0)
            هذا._خطوة_حالية -= 1
            هذا._أظهر_خطوة_حالية()
        نهاية
    نهاية

    دالة تخطّ()
