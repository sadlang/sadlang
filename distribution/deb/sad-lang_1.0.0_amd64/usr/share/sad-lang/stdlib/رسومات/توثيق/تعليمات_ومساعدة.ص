    نهاية

    دالة أنهِ_جولة()
        إذا (هذا._جولة_حالية)
            هذا._مكتملة[هذا._جولة_حالية] = صحيح
            هذا._جولة_حالية = لاشيء
            هذا._خطوة_حالية = 0
        نهاية
    نهاية

    دالة مكتملة؟(اسم)
