    نهاية

    دالة أعد_تعيين(اسم)
        هذا._مكتملة[اسم] = خطأ
    نهاية

    دالة _أظهر_خطوة_حالية()
        متغير خطوات = هذا._جولات[هذا._جولة_حالية]
        متغير خطوة = خطوات[هذا._خطوة_حالية]
        
        إذا (خطوة._عند_ظهور)
            خطوة._عند_ظهور()
        نهاية
        
