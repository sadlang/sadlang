# ===================================================================
# اختبارات شاملة — التوجيه والتنقل
# ===================================================================
# يختبر: توجيه.ص, تنقل_متقدم.ص
#
# الاستخدام:
#   sad.exe stdlib/ui/اختبار/اختبار_توجيه.ص
# ===================================================================

استورد * من رسومات.اختبار.فحص

# ═══════════════════════════════════════════
# اختبارات التوجيه الأساسي
# ═══════════════════════════════════════════
مجموعة("التوجيه الأساسي", لامدا()
    اختبر("إنشاء موجه", لامدا()
        متغير موجه = {
            "مسارات": {},
            "مكدس": [],
            "الحالي": لاشيء
        }
        توقع_ليس_لاشيء(موجه, "إنشاء الموجه")
        توقع(موجه["الحالي"], لاشيء, "لا يوجد مسار حالي")
    نهاية)

    اختبر("تسجيل مسار", لامدا()
        متغير مسارات = {}
        مسارات["/"] = "الرئيسية"
        مسارات["/تسجيل"] = "تسجيل"
        مسارات["/ملف"] = "ملف_شخصي"

        توقع(مسارات["/"], "الرئيسية", "المسار الرئيسي")
        توقع(مسارات["/تسجيل"], "تسجيل", "مسار التسجيل")
        توقع(مسارات["/ملف"], "ملف_شخصي", "مسار الملف")
    نهاية)

    اختبر("التنقل بين المسارات", لامدا()
        متغير مكدس = []
        مكدس.أضف("/")
        توقع(مكدس[0], "/", "المسار الأول")

        مكدس.أضف("/تسجيل")
        متغير حالي = مكدس[مكدس.طول() - 1]
        توقع(حالي, "/تسجيل", "التنقل للأمام")
    نهاية)

    اختبر("الرجوع للخلف", لامدا()
        متغير مكدس = ["/", "/تسجيل", "/ملف"]
        # إزالة الأخير (pop)
        متغير طول = مكدس.طول()
        متغير حالي = مكدس[طول - 1]
        توقع(حالي, "/ملف", "قبل الرجوع")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات المعاملات
# ═══════════════════════════════════════════
مجموعة("معاملات المسار", لامدا()
    اختبر("تمرير معاملات", لامدا()
        متغير مسار = {
            "اسم": "/ملف",
            "معاملات": {"معرف": 42, "اسم": "أحمد"}
        }
        توقع(مسار["معاملات"]["معرف"], 42, "معامل رقمي")
        توقع(مسار["معاملات"]["اسم"], "أحمد", "معامل نصي")
    نهاية)

    اختبر("معاملات فارغة", لامدا()
        متغير مسار = {
            "اسم": "/",
            "معاملات": {}
        }
        توقع_لاشيء(مسار["معاملات"]["غير_موجود"], "معامل غير موجود")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات حراسة المسارات
# ═══════════════════════════════════════════
مجموعة("حراسة المسارات", لامدا()
    اختبر("حارس يمنع الوصول", لامدا()
        متغير مسجل = خطأ

        دالة حارس_تسجيل()
            ارجع مسجل
        نهاية

        متغير مسموح = حارس_تسجيل()
        توقع_خطأ(مسموح, "حارس يمنع غير المسجلين")

        مسجل = صحيح
        مسموح = حارس_تسجيل()
        توقع_صحيح(مسموح, "حارس يسمح للمسجلين")
    نهاية)

    اختبر("حارس دور المستخدم", لامدا()
        متغير مستخدم = {"دور": "عادي"}

        دالة حارس_إدارة(مستخدم)
            ارجع مستخدم["دور"] == "مدير"
        نهاية

        توقع_خطأ(حارس_إدارة(مستخدم), "مستخدم عادي لا يمكنه الوصول")
        مستخدم["دور"] = "مدير"
        توقع_صحيح(حارس_إدارة(مستخدم), "المدير يمكنه الوصول")
    نهاية)
نهاية)

# ─── تشغيل ───
شغّل_اختبارات()
