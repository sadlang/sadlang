    نهاية
نهاية

## عرض حوار تأكيد
صدّر دالة تأكيد(عنوان, رسالة)
    حاول
        ارجع حوار_تأكيد(عنوان, رسالة)
    امسك خ
        ارجع خطأ
    نهاية
نهاية

## عرض حوار إدخال نص
صدّر دالة إدخال(عنوان, رسالة = "", افتراضي = "")
    حاول
        ارجع حوار_إدخال(عنوان, رسالة, افتراضي)
    امسك خ
        ارجع لاشيء
    نهاية
نهاية
