# ===================================================================
# خدمة الحوارات — Dialog Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/حوارات.ص
# ===================================================================
# مكتبة حوارات شاملة تدعم:
#   - حوار تنبيه (Alert)
#   - حوار تأكيد (Confirm)
#   - حوار إدخال (Prompt)
#   - حوار اختيار (Selection)
#   - حوار تقدم (Progress)
#   - حوار مخصص (Custom)
#   - أوراق سفلية (Bottom Sheet)
#
# الاستخدام:
#   استورد * من رسومات.خدمات.حوارات
#   تنبيه("عنوان", "رسالة")
#   متغير نتيجة = تأكيد("سؤال", "هل أنت متأكد؟")
#
# المنصات المدعومة:
#   ✅ سطح المكتب (SDL_ShowMessageBox / Native dialogs)
#   ✅ النواة (Text-mode dialogs)
#   ✅ الويب (alert/confirm/prompt + modal divs)
#   ✅ أندرويد (AlertDialog / BottomSheetDialog)
#   ✅ iOS (UIAlertController / UIActionSheet)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت وتعدادات
# ===================================================================

صدّر تعداد نتيجة_حوار
    موافق
    إلغاء
    نعم
    لا
    مغلق
نهاية

صدّر تعداد نوع_حوار
    تنبيه          # رسالة + موافق
    تأكيد          # رسالة + موافق/إلغاء
    إدخال          # حقل نص + موافق/إلغاء
    اختيار         # قائمة خيارات
    تقدم           # شريط تقدم
نهاية

# ===================================================================
#       باني_حوار — Dialog Builder (Fluent API)
# ===================================================================

صدّر صنف باني_حوار
    باني(عنوان = "")
        هذا._عنوان = عنوان
        هذا._رسالة = ""
        هذا._نوع = نوع_حوار.تنبيه
        هذا._أزرار = []
        هذا._خيارات = []
        هذا._قيمة_افتراضية = ""
        هذا._قابل_إغلاق = صحيح
        هذا._أيقونة = ""
    نهاية

    ## تعيين العنوان
    دالة العنوان(عنوان)
        هذا._عنوان = عنوان
        ارجع هذا
    نهاية

    ## تعيين الرسالة
    دالة الرسالة(رسالة)
        هذا._رسالة = رسالة
        ارجع هذا
    نهاية

    ## إضافة زر
    دالة زر(عنوان, رد_نداء = لاشيء, رئيسي = خطأ)
        هذا._أزرار = هذا._أزرار + [{
            عنوان: عنوان,
            رد: رد_نداء,
            رئيسي: رئيسي
        }]
        ارجع هذا
    نهاية

    ## إضافة خيار (لحوار الاختيار)
    دالة خيار(عنوان, قيمة = لاشيء)
        إذا (قيمة == لاشيء)
            قيمة = عنوان
        نهاية
        هذا._خيارات = هذا._خيارات + [{عنوان: عنوان, قيمة: قيمة}]
        ارجع هذا
    نهاية

    ## تعيين كحوار إدخال
    دالة إدخال(قيمة_افتراضية = "")
        هذا._نوع = نوع_حوار.إدخال
        هذا._قيمة_افتراضية = قيمة_افتراضية
        ارجع هذا
    نهاية

    ## تعيين كحوار اختيار
    دالة اختيار()
        هذا._نوع = نوع_حوار.اختيار
        ارجع هذا
    نهاية

    ## هل يمكن الإغلاق؟
    دالة قابل_إغلاق(قيمة = صحيح)
        هذا._قابل_إغلاق = قيمة
        ارجع هذا
    نهاية

    ## أيقونة الحوار
    دالة الأيقونة(مسار)
        هذا._أيقونة = مسار
        ارجع هذا
    نهاية

    ## عرض الحوار
    دالة اعرض()
        إذا (هذا._نوع == نوع_حوار.تأكيد)
            حاول
                ارجع حوار_تأكيد(هذا._عنوان, هذا._رسالة)
            امسك خ
                ارجع خطأ
            نهاية
        نهاية
        إذا (هذا._نوع == نوع_حوار.إدخال)
            حاول
                ارجع حوار_إدخال(هذا._عنوان, هذا._رسالة, هذا._قيمة_افتراضية)
            امسك خ
                ارجع لاشيء
            نهاية
        نهاية
        # حوار تنبيه افتراضي
        حاول
            حوار_تنبيه(هذا._عنوان, هذا._رسالة)
        امسك خ
            # تجاهل
        نهاية
        ارجع نتيجة_حوار.موافق
    نهاية
نهاية

# ===================================================================
#       حوار_تقدم — Progress Dialog
# ===================================================================

صدّر صنف حوار_تقدم
    باني(عنوان = "جاري التحميل...", أقصى = 100)
        هذا._عنوان = عنوان
        هذا._أقصى = أقصى
        هذا._حالي = 0
        هذا._رسالة = ""
        هذا._مرئي = خطأ
        هذا._قابل_إلغاء = خطأ
        هذا._رد_إلغاء = لاشيء
    نهاية

    ## عرض حوار التقدم
    دالة اعرض()
        هذا._مرئي = صحيح
        حاول
            اعرض_حوار_تقدم(هذا._عنوان, هذا._رسالة)
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## تحديث التقدم
    دالة حدّث(قيمة, رسالة = لاشيء)
        هذا._حالي = قيمة
        إذا (رسالة != لاشيء)
            هذا._رسالة = رسالة
        نهاية
        حاول
            حدّث_حوار_تقدم(هذا._حالي, هذا._أقصى, هذا._رسالة)
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## إغلاق الحوار
    دالة أغلق()
        هذا._مرئي = خطأ
        حاول
            أغلق_حوار_تقدم()
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## النسبة المئوية
    دالة النسبة()
        إذا (هذا._أقصى == 0)
            ارجع 0
        نهاية
        ارجع (هذا._حالي * 100) / هذا._أقصى
    نهاية

    ## هل مرئي؟
    دالة مرئي()
        ارجع هذا._مرئي
    نهاية

    ## قابل للإلغاء
    دالة قابل_إلغاء(قيمة = صحيح, رد = لاشيء)
        هذا._قابل_إلغاء = قيمة
        هذا._رد_إلغاء = رد
        ارجع هذا
    نهاية
نهاية

