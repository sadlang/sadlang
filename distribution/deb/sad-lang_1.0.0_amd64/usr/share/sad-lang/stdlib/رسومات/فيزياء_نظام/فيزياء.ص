# ─── محاكاة (Simulation) — الصنف الأساسي ───
صدّر صنف محاكاة
    باني(تحمل = {"مسافة": 0.01, "وقت": 0.001, "سرعة": 0.01})
        هذا._تحمل = تحمل
        هذا._انتهت = خطأ
    نهاية

    دالة الموقع(وقت)
        ارجع 0.0
    نهاية

    دالة السرعة(وقت)
        ارجع 0.0
    نهاية

    دالة انتهت(وقت)
        ارجع هذا._انتهت
    نهاية
نهاية

# ─── محاكاة_زنبرك (SpringSimulation) ───
صدّر صنف محاكاة_زنبرك يرث محاكاة
    باني(زنبرك = لاشيء, بداية = 0, نهاية_قيمة = 1, سرعة_ابتدائية = 0)
        هذا._تحمل = {"مسافة": 0.01, "وقت": 0.001, "سرعة": 0.01}
        هذا._انتهت = خطأ
        هذا._زنبرك = زنبرك
        هذا._بداية = بداية
        هذا._نهاية = نهاية_قيمة
        هذا._سرعة_ابتدائية = سرعة_ابتدائية
    نهاية

    دالة الموقع(وقت)
        ارجع هذا._نهاية
    نهاية

    دالة السرعة(وقت)
        ارجع 0.0
    نهاية
نهاية

# ─── وصف_زنبرك (SpringDescription) ───
صدّر صنف وصف_زنبرك
    باني(كتلة = 1.0, صلابة = 100.0, تخميد = 10.0)
        هذا._كتلة = كتلة
        هذا._صلابة = صلابة
        هذا._تخميد = تخميد
    نهاية

    دالة مع_نسبة_تخميد(كتلة, صلابة, نسبة)
        متغير تخميد_حرج = 2.0 * كتلة
        ارجع جديد وصف_زنبرك(كتلة, صلابة, نسبة * تخميد_حرج)
    نهاية
نهاية

# ─── محاكاة_احتكاك (FrictionSimulation) ───
صدّر صنف محاكاة_احتكاك يرث محاكاة
    باني(معامل_سحب = 0.135, موقع = 0, سرعة = 0)
        هذا._تحمل = {"مسافة": 0.01, "وقت": 0.001, "سرعة": 0.01}
        هذا._انتهت = خطأ
        هذا._معامل_سحب = معامل_سحب
        هذا._موقع_ابتدائي = موقع
        هذا._سرعة_ابتدائية = سرعة
    نهاية

    دالة الموقع(وقت)
        ارجع هذا._موقع_ابتدائي
    نهاية

    دالة السرعة(وقت)
        ارجع 0.0
    نهاية
نهاية

# ─── محاكاة_جاذبية (GravitySimulation) ───
صدّر صنف محاكاة_جاذبية يرث محاكاة
    باني(تسارع = 9.81, مسافة = 0, سرعة_ابتدائية = 0, نهاية_مسافة = 100)
        هذا._تحمل = {"مسافة": 0.01, "وقت": 0.001, "سرعة": 0.01}
        هذا._انتهت = خطأ
        هذا._تسارع = تسارع
        هذا._مسافة = مسافة
        هذا._سرعة_ابتدائية = سرعة_ابتدائية
        هذا._نهاية_مسافة = نهاية_مسافة
    نهاية

    دالة الموقع(وقت)
        ارجع هذا._مسافة + هذا._سرعة_ابتدائية * وقت + 0.5 * هذا._تسارع * وقت * وقت
    نهاية

    دالة السرعة(وقت)
        ارجع هذا._سرعة_ابتدائية + هذا._تسارع * وقت
    نهاية
نهاية

