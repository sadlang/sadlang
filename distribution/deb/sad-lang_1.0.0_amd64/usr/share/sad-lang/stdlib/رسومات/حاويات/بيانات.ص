        هذا._نوع = "جدول_بيانات"
        هذا._خصائص = {}
        هذا._خصائص["أعمدة"] = أعمدة
        هذا._خصائص["صفوف"] = صفوف
        هذا._خصائص["قابل_فرز"] = قابل_فرز
        هذا._خصائص["قابل_تحديد"] = قابل_تحديد
        هذا._خصائص["عند_الفرز"] = عند_الفرز
        هذا._خصائص["عند_التحديد"] = عند_التحديد
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية
نهاية

