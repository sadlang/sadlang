# ===================================================================
#                    ترقيم_صفحات: Pagination
# ===================================================================

صدّر صنف ترقيم_صفحات يرث عنصر
    باني(الحالي = لاشيء, الإجمالي = لاشيء, عند_التغيير = لاشيء, لون_النشط = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "ترقيم_صفحات"
        هذا._خصائص = {}
        هذا._خصائص["الحالي"] = الحالي
        هذا._خصائص["الإجمالي"] = الإجمالي
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["لون_النشط"] = لون_النشط
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    دالة احصل_الحالي()
        ارجع هذا._خصائص["الحالي"]
    نهاية

    دالة عيّن_الحالي(قيمة)
        هذا._خصائص["الحالي"] = قيمة
        ارجع هذا
    نهاية

    دالة التالي()
        هذا._خصائص["الحالي"] = هذا._خصائص["الحالي"] + 1
        ارجع هذا
    نهاية

    دالة السابق()
        إذا (هذا._خصائص["الحالي"] > 1)
            هذا._خصائص["الحالي"] = هذا._خصائص["الحالي"] - 1
        نهاية
        ارجع هذا
    نهاية
نهاية

