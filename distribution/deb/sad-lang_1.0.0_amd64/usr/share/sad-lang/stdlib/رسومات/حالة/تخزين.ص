# ===================================================================
# نظام التخزين المحلي — Local Storage System
# ===================================================================
# تخزين بيانات محلية مع دعم للكائنات والتسلسل
#
# الاستخدام:
#   استورد * من رسومات.حالة.تخزين
# ===================================================================

# ─── مخزن (Store — in-memory key-value) ───
صدّر صنف مخزن
    باني(اسم)
        هذا._اسم = اسم
        هذا._بيانات = {}
        هذا._مستمعون = {}
    نهاية

    دالة عيّن(مفتاح, قيمة)
        متغير قديمة = هذا._بيانات[مفتاح]
        هذا._بيانات[مفتاح] = قيمة
        إذا (قديمة != قيمة)
            هذا._أشعر(مفتاح, قيمة)
        نهاية
    نهاية

    دالة احصل(مفتاح, افتراضي)
        متغير ق = هذا._بيانات[مفتاح]
        إذا (ق == لاشيء)
            ارجع افتراضي
        نهاية
        ارجع ق
    نهاية

    دالة احذف(مفتاح)
        هذا._بيانات[مفتاح] = لاشيء
    نهاية

    دالة امسح()
        هذا._بيانات = {}
    نهاية

    دالة المفاتيح()
        متغير قائمة = []
        لكل مفتاح في هذا._بيانات
            قائمة.أضف(مفتاح)
        نهاية
        ارجع قائمة
    نهاية

    دالة عند_تغيير(مفتاح, مستمع)
        إذا (هذا._مستمعون[مفتاح] == لاشيء)
            هذا._مستمعون[مفتاح] = []
        نهاية
        هذا._مستمعون[مفتاح].أضف(مستمع)
    نهاية

    دالة _أشعر(مفتاح, قيمة)
        متغير م = هذا._مستمعون[مفتاح]
        إذا (م != لاشيء)
            لكل مستمع في م
                مستمع(قيمة)
            نهاية
        نهاية
    نهاية
نهاية

# ─── تخزين_دائم (Persistent storage — wraps builtin) ───
صدّر صنف تخزين_دائم
    باني()
        # يعتمد على الدوال المدمجة خزّن واسترجع
    نهاية

    دالة حفظ(مفتاح, قيمة)
        خزّن(مفتاح, قيمة)
    نهاية

    دالة تحميل(مفتاح)
        ارجع استرجع(مفتاح)
    نهاية

    دالة حذف(مفتاح)
        احذف_مخزن(مفتاح)
    نهاية

    دالة مسح_الكل()
        امسح_المخزن()
    نهاية
نهاية

# ─── ذاكرة_مؤقتة (Cache with TTL) ───
صدّر صنف ذاكرة_مؤقتة
    باني(مدة_افتراضية)
        هذا._بيانات = {}
        هذا._أوقات = {}
        هذا._مدة = مدة_افتراضية
    نهاية

    دالة عيّن(مفتاح, قيمة, مدة)
        إذا (مدة == لاشيء)
            مدة = هذا._مدة
        نهاية
        هذا._بيانات[مفتاح] = قيمة
        هذا._أوقات[مفتاح] = وقت_الآن() + مدة
    نهاية

    دالة احصل(مفتاح)
        متغير انتهاء = هذا._أوقات[مفتاح]
        إذا (انتهاء != لاشيء و وقت_الآن() > انتهاء)
            هذا._بيانات[مفتاح] = لاشيء
            هذا._أوقات[مفتاح] = لاشيء
            ارجع لاشيء
        نهاية
        ارجع هذا._بيانات[مفتاح]
    نهاية

    دالة امسح()
        هذا._بيانات = {}
        هذا._أوقات = {}
    نهاية
نهاية

# ─── مخزن عام singleton ───
متغير _التخزين = لاشيء

صدّر دالة التخزين()
    إذا (_التخزين == لاشيء)
        _التخزين = جديد مخزن("_عام")
    نهاية
    ارجع _التخزين
نهاية
