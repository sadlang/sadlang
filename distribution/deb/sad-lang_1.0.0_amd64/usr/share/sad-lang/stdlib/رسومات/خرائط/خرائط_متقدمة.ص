# العيب #201: MapView - عرض الخريطة
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف موقع_جغرافي
    باني(خط_عرض، خط_طول)
        هذا.خط_عرض = خط_عرض
        هذا.خط_طول = خط_طول
    نهاية

    دالة المسافة_إلى(موقع_آخر)
        # حساب المسافة بالكيلومترات (صيغة Haversine)
        متغير نق = 6371  # نصف قطر الأرض
        متغير فرق_عرض = (موقع_آخر.خط_عرض - هذا.خط_عرض) * 3.14159 / 180
        متغير فرق_طول = (موقع_آخر.خط_طول - هذا.خط_طول) * 3.14159 / 180
        
        متغير أ = جا(فرق_عرض/2) * جا(فرق_عرض/2) +
                  جتا(هذا.خط_عرض * 3.14159/180) * جتا(موقع_آخر.خط_عرض * 3.14159/180) *
                  جا(فرق_طول/2) * جا(فرق_طول/2)
        
        متغير ج = 2 * قوس_جيب_تمام(جذر(أ))
        ارجع نق * ج
    نهاية

    دالة نص()
        ارجع هذا.خط_عرض + "، " + هذا.خط_طول
    نهاية
نهاية

صدّر صنف متحكم_خريطة
    باني()
        هذا._مركز = جديد موقع_جغرافي(24.7136، 46.6753)  # الرياض افتراضياً
        هذا._تكبير = 12
        هذا._دوران = 0
        هذا._إمالة = 0
        هذا._مستمعون = []
    نهاية

    دالة انتقل_إلى(موقع، تكبير، متحرك)
        هذا._مركز = موقع
        إذا (تكبير)
            هذا._تكبير = تكبير
        نهاية
        هذا._أخطر("انتقال"، {موقع: موقع، متحرك: متحرك أو صحيح})
    نهاية

    دالة كبّر()
        إذا (هذا._تكبير < 20)
            هذا._تكبير += 1
            هذا._أخطر("تكبير"، هذا._تكبير)
        نهاية
    نهاية

    دالة صغّر()
        إذا (هذا._تكبير > 1)
            هذا._تكبير -= 1
            هذا._أخطر("تكبير"، هذا._تكبير)
        نهاية
    نهاية

    دالة عيّن_تكبير(مستوى)
        هذا._تكبير = مستوى.ثبّت(1، 20)
        هذا._أخطر("تكبير"، هذا._تكبير)
    نهاية

    دالة دوّر(درجات)
        هذا._دوران = درجات % 360
        هذا._أخطر("دوران"، هذا._دوران)
    نهاية

    دالة أمِل(درجات)
        هذا._إمالة = درجات.ثبّت(0، 60)
        هذا._أخطر("إمالة"، هذا._إمالة)
    نهاية

    دالة راقب(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة _أخطر(حدث، بيانات)
        لكل مستمع في هذا._مستمعون
            مستمع({نوع: حدث، بيانات: بيانات})
        نهاية
    نهاية
نهاية

صدّر صنف عرض_خريطة
    باني(إعدادات)
        هذا._متحكم = إعدادات.متحكم أو جديد متحكم_خريطة()
        هذا._نوع = إعدادات.نوع أو "عادي"  # عادي، قمر_صناعي، تضاريس، هجين
        هذا._علامات = إعدادات.علامات أو []
        هذا._مسارات = إعدادات.مسارات أو []
        هذا._دوائر = إعدادات.دوائر أو []
        هذا._مضلعات = إعدادات.مضلعات أو []
        هذا._أظهر_موقعي = إعدادات.أظهر_موقعي أو خطأ
        هذا._أظهر_بوصلة = إعدادات.أظهر_بوصلة أو صحيح
        هذا._أظهر_مقياس = إعدادات.أظهر_مقياس أو صحيح
        هذا._عند_ضغط = إعدادات.عند_ضغط أو لاشيء
        هذا._عند_ضغط_طويل = إعدادات.عند_ضغط_طويل أو لاشيء
    نهاية

    دالة أضف_علامة(علامة)
        هذا._علامات.أضف(علامة)
    نهاية

    دالة أزل_علامة(معرف)
        هذا._علامات = هذا._علامات.فلتر(لامدا(ع) => ع.معرف != معرف نهاية)
    نهاية

    دالة بناء()
        ارجع {
            نوع: "عرض_خريطة"،
            متحكم: هذا._متحكم،
            نوع_خريطة: هذا._نوع،
            علامات: هذا._علامات،
            مسارات: هذا._مسارات
        }
    نهاية
نهاية

