# ─── سقالة التبويب (DefaultTabController) ───
صدّر صنف متحكم_تبويب_افتراضي يرث عنصر
    باني(طول، ابن، فهرس_ابتدائي = 0)
        هذا._نوع = "متحكم_تبويب_افتراضي"
        هذا._طول = طول
        هذا._ابن = ابن
        هذا._فهرس = فهرس_ابتدائي
        هذا._متحكم = جديد متحكم_تبويب(طول، فهرس_ابتدائي)
    نهاية

    دالة المتحكم()
        ارجع هذا._متحكم
    نهاية

    ساكن دالة من(سياق)
        متغير حالي = سياق
        بينما (حالي != لاشيء)
            إذا (حالي.النوع() == "متحكم_تبويب_افتراضي")
                ارجع حالي.المتحكم()
            نهاية
            حالي = حالي.الأب()
        نهاية
        ارجع لاشيء
    نهاية
نهاية

