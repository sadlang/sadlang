# ─── متحكم الصفحة (PageController) ───
صدّر صنف متحكم_صفحة
    باني(صفحة_ابتدائية = 0، نسبة_رؤية = 1.0)
        هذا._صفحة = صفحة_ابتدائية
        هذا._صفحة_ابتدائية = صفحة_ابتدائية
        هذا._نسبة_رؤية = نسبة_رؤية
        هذا._مستمعون = []
        هذا._موضع = 0.0
    نهاية

    دالة الصفحة()
        ارجع هذا._صفحة
    نهاية

    دالة الموضع()
        ارجع هذا._موضع
    نهاية

    غير_متزامن دالة انتقل_إلى_صفحة(صفحة، مدة = 300، منحنى = "سهولة")
        هذا._صفحة = صفحة
        هذا._موضع = صفحة
        هذا._أبلغ_المستمعين()
    نهاية

    غير_متزامن دالة التالي(مدة = 300، منحنى = "سهولة")
        انتظر هذا.انتقل_إلى_صفحة(هذا._صفحة + 1، مدة، منحنى)
    نهاية

    غير_متزامن دالة السابق(مدة = 300، منحنى = "سهولة")
        انتظر هذا.انتقل_إلى_صفحة(هذا._صفحة - 1، مدة، منحنى)
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة أزل_مستمع(مستمع)
        هذا._مستمعون.أزل(مستمع)
    نهاية

    دالة _أبلغ_المستمعين()
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
    نهاية
نهاية

# ─── عرض الصفحات (PageView) ───
صدّر صنف عرض_صفحات يرث عنصر
    باني(
        أبناء = لاشيء،
        بانٍ = لاشيء،
        متحكم = لاشيء،
        محور_تمرير = "أفقي"،
        معكوس = خطأ،
        فيزياء = لاشيء،
        عند_تغير_الصفحة = لاشيء،
        يختطف_إيماءة_سحب = صحيح،
        يسمح_بحشو_ضمني = صحيح
    )
        هذا._نوع = "عرض_صفحات"
        هذا._أبناء = أبناء أو []
        هذا._بانٍ = بانٍ
        هذا._متحكم = متحكم أو جديد متحكم_صفحة()
        هذا._محور = محور_تمرير
        هذا._معكوس = معكوس
        هذا._فيزياء = فيزياء
        هذا._عند_تغير = عند_تغير_الصفحة
        هذا._يختطف_إيماءة = يختطف_إيماءة_سحب
    نهاية

    دالة المتحكم()
        ارجع هذا._متحكم
    نهاية

    # ─── منشئات سريعة ───
    ساكن دالة بانٍ(
        بانٍ_عناصر،
        عدد_العناصر = لاشيء،
        متحكم = لاشيء،
        عند_تغير_الصفحة = لاشيء
    )
        ارجع جديد عرض_صفحات(
            لاشيء،
            بانٍ_عناصر،
            متحكم،
            "أفقي"،
            خطأ،
            لاشيء،
            عند_تغير_الصفحة
        )
    نهاية

    ساكن دالة مخصص(
        أبناء_مباشرين،
        متحكم = لاشيء،
        عند_تغير_الصفحة = لاشيء
    )
        ارجع جديد عرض_صفحات(
            أبناء_مباشرين،
            لاشيء،
            متحكم،
            "أفقي"،
            خطأ،
            لاشيء،
            عند_تغير_الصفحة
        )
    نهاية
نهاية

# ─── متحكم التبويب (TabController) ───
صدّر صنف متحكم_تبويب
    باني(طول، فهرس_ابتدائي = 0)
        هذا._طول = طول
        هذا._فهرس = فهرس_ابتدائي
        هذا._فهرس_سابق = فهرس_ابتدائي
        هذا._مستمعون = []
        هذا._متحرك = خطأ
    نهاية

    دالة الطول()
        ارجع هذا._طول
    نهاية

    دالة الفهرس()
        ارجع هذا._فهرس
    نهاية

    دالة الفهرس_السابق()
        ارجع هذا._فهرس_سابق
    نهاية

    دالة متحرك()
        ارجع هذا._متحرك
    نهاية

    دالة انتقل_إلى(فهرس)
        إذا (فهرس < 0 أو فهرس >= هذا._طول)
            ارجع
        نهاية
        
        هذا._فهرس_سابق = هذا._فهرس
        هذا._فهرس = فهرس
        هذا._أبلغ_المستمعين()
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة أزل_مستمع(مستمع)
        هذا._مستمعون.أزل(مستمع)
    نهاية

    دالة _أبلغ_المستمعين()
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
    نهاية
نهاية

