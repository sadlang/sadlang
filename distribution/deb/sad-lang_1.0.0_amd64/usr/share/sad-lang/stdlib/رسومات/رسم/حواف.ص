# ─── حواف (EdgeInsets) ───
صدّر صنف حواف
    باني(يسار = 0, أعلى = 0, يمين = 0, أسفل = 0)
        هذا._يسار = يسار
        هذا._أعلى = أعلى
        هذا._يمين = يمين
        هذا._أسفل = أسفل
    نهاية

    ساكن دالة الكل(قيمة)
        ارجع جديد حواف(قيمة, قيمة, قيمة, قيمة)
    نهاية

    ساكن دالة متماثل(أفقي = 0, عمودي = 0)
        ارجع جديد حواف(أفقي, عمودي, أفقي, عمودي)
    نهاية

    ساكن دالة فقط(يسار = 0, أعلى = 0, يمين = 0, أسفل = 0)
        ارجع جديد حواف(يسار, أعلى, يمين, أسفل)
    نهاية

    ساكن دالة صفر()
        ارجع جديد حواف(0, 0, 0, 0)
    نهاية

    دالة الأفقي()
        ارجع هذا._يسار + هذا._يمين
    نهاية

    دالة العمودي()
        ارجع هذا._أعلى + هذا._أسفل
    نهاية

    دالة المجموع()
        ارجع هذا._يسار + هذا._أعلى + هذا._يمين + هذا._أسفل
    نهاية

    دالة يسار()
        ارجع هذا._يسار
    نهاية

    دالة أعلى()
        ارجع هذا._أعلى
    نهاية

    دالة يمين()
        ارجع هذا._يمين
    نهاية

    دالة أسفل()
        ارجع هذا._أسفل
    نهاية
نهاية

# ─── حواف_اتجاهية (EdgeInsetsDirectional) — للغات RTL ───
صدّر صنف حواف_اتجاهية
    باني(بداية = 0, أعلى = 0, نهاية_حافة = 0, أسفل = 0)
        هذا._بداية = بداية
        هذا._أعلى = أعلى
        هذا._نهاية = نهاية_حافة
        هذا._أسفل = أسفل
    نهاية

    ساكن دالة فقط(بداية = 0, أعلى = 0, نهاية_حافة = 0, أسفل = 0)
        ارجع جديد حواف_اتجاهية(بداية, أعلى, نهاية_حافة, أسفل)
    نهاية

    دالة حل(اتجاه_النص)
        إذا (اتجاه_النص == "يمين_لذيسار")
            ارجع جديد حواف(هذا._نهاية, هذا._أعلى, هذا._بداية, هذا._أسفل)
        نهاية
        ارجع جديد حواف(هذا._بداية, هذا._أعلى, هذا._نهاية, هذا._أسفل)
    نهاية
نهاية

