        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["لون_خلفية"] = لون_خلفية
        هذا._خصائص["لون_أمامي"] = لون_أمامي
        هذا._خصائص["حجم"] = حجم
