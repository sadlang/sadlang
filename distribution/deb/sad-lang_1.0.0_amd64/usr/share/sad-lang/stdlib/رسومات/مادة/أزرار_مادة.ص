        ز._خصائص["تسمية"] = تسمية
        ز._خصائص["عند_الضغط"] = عند_الضغط
        ز._خصائص["لون_خلفية"] = لون_خلفية
        ز._نوع = "زر_عائم_ممتد"
        ارجع ز
    نهاية

    ساكن دالة صغير(ابن = لاشيء, عند_الضغط = لاشيء, لون_خلفية = لاشيء)
        متغير ز = جديد زر_عائم(ابن, عند_الضغط, لون_خلفية)
        ز._خصائص["حجم"] = "صغير"
        ارجع ز
    نهاية

    ساكن دالة كبير(ابن = لاشيء, عند_الضغط = لاشيء, لون_خلفية = لاشيء)
        متغير ز = جديد زر_عائم(ابن, عند_الضغط, لون_خلفية)
        ز._خصائص["حجم"] = "كبير"
        ارجع ز
    نهاية
