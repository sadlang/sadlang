# ─── زر_عائم (FloatingActionButton) ─── [عنصر جديد 32]
صدّر صنف زر_عائم يرث عنصر
    باني(ابن = لاشيء, عند_الضغط = لاشيء, لون_خلفية = لاشيء, لون_أمامي = لاشيء, حجم = لاشيء, ارتفاع_ظل = لاشيء, شكل = لاشيء, تلميح = لاشيء, بطولي = خطأ)
        هذا._نوع = "زر_عائم"
        هذا._خصائص = {}
