# بسم الله الرحمن الرحيم
# ===================================================================
# منحنيات الحركة — Animation Curves
# ===================================================================
#
# (AR) هذا الملف يوفر مكتبة شاملة من منحنيات الحركة
#      (Easing/Animation Curves) المستخدمة في:
#      - الحركات (animations) — تسارع وتباطؤ
#      - التمرير (scrolling) — منحنيات مخصصة
#      - الانتقالات (transitions) — تأثيرات بصرية
#
#      كل منحني يحوّل قيمة t ∈ [0,1] إلى قيمة خرج ∈ [0,1]
#      حيث t=0 هو البداية و t=1 هو النهاية
#
#      المنحنيات المتوفرة:
#      ─ خطي (linear): f(t) = t
#      ─ تباطؤ_داخلي (ease-in): بطيء ثم سريع
#      ─ تباطؤ_خارجي (ease-out): سريع ثم بطيء
#      ─ تباطؤ_داخلي_خارجي (ease-in-out): بطيء—سريع—بطيء
#      ─ ارتداد (bounce): يرتد عند النهاية
#      ─ مرن (elastic): يتذبذب حول الهدف
#      ─ تكعيبي (cubic bezier): منحنى بيزييه مخصص
#
#      مطابق لـ flutter/animation/curves.dart
#
# (EN) Comprehensive animation curves library. Each curve maps
#      t ∈ [0,1] to an output ∈ [0,1].
#
# الأصناف المُصدّرة:
#   - منحنى (Curve)                     — الصنف الأساسي
#   - منحنى_خطي (LinearCurve)
#   - منحنى_تباطؤ (EaseCurve)
#   - منحنى_ارتداد (BounceCurve)
#   - منحنى_مرن (ElasticCurve)
#   - منحنى_مخصص (CustomCurve)
#   - منحنى_معكوس (ReverseCurve)
#   - منحنى_متقلب (FlippedCurve)
#
# ثوابت جاهزة:
#   - خطي, تباطؤ, تباطؤ_داخلي, تباطؤ_خارجي, تباطؤ_داخلي_خارجي
#   - ارتداد_داخلي, ارتداد_خارجي, مرن_داخلي, مرن_خارجي
#
# الاستخدام:
#   استورد * من رسومات.فيزياء_نظام.منحنيات
# ===================================================================

# ─── منحنى (Curve) — الصنف الأساسي ───
صدّر صنف منحنى
    # (AR) الصنف الأساسي لجميع المنحنيات
    #      يجب على الأصناف الفرعية تجاوز دالة حوّل(ت)
    # (EN) Base class — subclasses override حوّل(ت)
    باني(اسم = "منحنى")
        هذا._اسم = اسم
    نهاية

    دالة حوّل(ت)
        # (AR) الدالة الأساسية — يجب تجاوزها
        ارجع ت
    نهاية

    دالة طبّق(ت)
        # (AR) تطبيق المنحنى مع ضمان الحدود
        إذا (ت <= 0.0)
            ارجع 0.0
        نهاية
        إذا (ت >= 1.0)
            ارجع 1.0
        نهاية
        ارجع هذا.حوّل(ت)
    نهاية

    دالة الاسم()
        ارجع هذا._اسم
    نهاية
نهاية

# ─── منحنى_خطي (LinearCurve) ───
صدّر صنف منحنى_خطي يرث منحنى
    # (AR) f(t) = t — لا تسارع ولا تباطؤ
    باني()
        هذا._اسم = "خطي"
    نهاية

    دالة حوّل(ت)
        ارجع ت
    نهاية
نهاية

# ─── منحنى_تباطؤ (EaseCurve) ───
صدّر صنف منحنى_تباطؤ يرث منحنى
    # (AR) منحنيات التباطؤ القياسية (ease-in, ease-out, ease-in-out)
    #      النمط "داخلي": بطيء في البداية، سريع في النهاية — f(t) = t²
    #      النمط "خارجي": سريع في البداية، بطيء في النهاية — f(t) = 1-(1-t)²
    #      النمط "داخلي_خارجي": بطيء—سريع—بطيء
    # (EN) Standard easing curves
    باني(نمط = "داخلي_خارجي", قوة = 2.0)
        هذا._اسم = "تباطؤ_" + نمط
        هذا._نمط = نمط
        هذا._قوة = قوة
    نهاية

    دالة حوّل(ت)
        إذا (هذا._نمط == "داخلي")
            # ease-in: t^n
            ارجع ت ** هذا._قوة
        نهاية
        إذا (هذا._نمط == "خارجي")
            # ease-out: 1 - (1-t)^n
            ارجع 1.0 - (1.0 - ت) ** هذا._قوة
        نهاية
        # ease-in-out
        إذا (ت < 0.5)
            ارجع (2.0 * ت) ** هذا._قوة / 2.0
        نهاية
        ارجع 1.0 - ((2.0 - 2.0 * ت) ** هذا._قوة) / 2.0
    نهاية
نهاية

# ─── منحنى_ارتداد (BounceCurve) ───
صدّر صنف منحنى_ارتداد يرث منحنى
    # (AR) منحنى ارتداد — يرتد عدة مرات عند النهاية
    #      مُستلهم من الكرة المرتدة
    # (EN) Bounce curve — bounces at the end like a ball
    باني(نمط = "خارجي")
        هذا._اسم = "ارتداد_" + نمط
        هذا._نمط = نمط
    نهاية

    دالة حوّل(ت)
        إذا (هذا._نمط == "داخلي")
            ارجع 1.0 - هذا._ارتداد_خارجي(1.0 - ت)
        نهاية
        ارجع هذا._ارتداد_خارجي(ت)
    نهاية

    دالة _ارتداد_خارجي(ت)
        # (AR) تقريب منحنى الارتداد القياسي
        إذا (ت < 0.3636)
            ارجع 7.5625 * ت * ت
        نهاية
        إذا (ت < 0.7272)
            متغير ت2 = ت - 0.5454
            ارجع 7.5625 * ت2 * ت2 + 0.75
        نهاية
        إذا (ت < 0.9090)
            متغير ت3 = ت - 0.8181
            ارجع 7.5625 * ت3 * ت3 + 0.9375
        نهاية
        متغير ت4 = ت - 0.9545
        ارجع 7.5625 * ت4 * ت4 + 0.984375
    نهاية
نهاية

# ─── منحنى_مرن (ElasticCurve) ───
صدّر صنف منحنى_مرن يرث منحنى
    # (AR) منحنى مرن — يتذبذب حول الهدف مثل الزنبرك
    #      المرونة period تتحكم بسرعة التذبذب
    # (EN) Elastic curve — oscillates around target like a spring
    باني(نمط = "خارجي", مرونة = 0.4)
        هذا._اسم = "مرن_" + نمط
        هذا._نمط = نمط
        هذا._مرونة = مرونة
    نهاية

    دالة حوّل(ت)
        إذا (هذا._نمط == "داخلي")
            إذا (ت == 0.0 أو ت == 1.0)
                ارجع ت
            نهاية
            # تقريب: مرن داخلي
            ارجع 0 - (2.0 ** (10.0 * ت - 10.0)) * 0.5
        نهاية
        # مرن خارجي
        إذا (ت == 0.0 أو ت == 1.0)
            ارجع ت
        نهاية
        ارجع 2.0 ** (0 - 10.0 * ت) * 0.5 + 1.0
    نهاية
نهاية

# ─── منحنى_معكوس (ReverseCurve) ───
صدّر صنف منحنى_معكوس يرث منحنى
    # (AR) يعكس أي منحنى آخر: f(t) = 1 - inner(1-t)
    # (EN) Reverses another curve
    باني(منحنى_داخلي = لاشيء)
        هذا._اسم = "معكوس"
        هذا._داخلي = منحنى_داخلي
    نهاية

    دالة حوّل(ت)
        إذا (هذا._داخلي == لاشيء)
            ارجع ت
        نهاية
        ارجع 1.0 - هذا._داخلي.طبّق(1.0 - ت)
    نهاية
نهاية

# ─── منحنى_متقلب (FlippedCurve) ───
صدّر صنف منحنى_متقلب يرث منحنى
    # (AR) يقلب الخرج: f(t) = 1 - inner(t)
    # (EN) Flips the output
    باني(منحنى_داخلي = لاشيء)
        هذا._اسم = "متقلب"
        هذا._داخلي = منحنى_داخلي
    نهاية

    دالة حوّل(ت)
        إذا (هذا._داخلي == لاشيء)
            ارجع 1.0 - ت
        نهاية
        ارجع 1.0 - هذا._داخلي.طبّق(ت)
    نهاية
نهاية

# ─── ثوابت المنحنيات الجاهزة ───
# (AR) منحنيات جاهزة للاستخدام المباشر
# (EN) Pre-built curve instances for direct use

ثابت خطي = جديد منحنى_خطي()
ثابت تباطؤ_داخلي = جديد منحنى_تباطؤ("داخلي")
ثابت تباطؤ_خارجي = جديد منحنى_تباطؤ("خارجي")
ثابت تباطؤ_داخلي_خارجي = جديد منحنى_تباطؤ("داخلي_خارجي")
ثابت تباطؤ = تباطؤ_داخلي_خارجي
ثابت تباطؤ_تكعيبي = جديد منحنى_تباطؤ("داخلي_خارجي", 3.0)
ثابت ارتداد_داخلي = جديد منحنى_ارتداد("داخلي")
ثابت ارتداد_خارجي = جديد منحنى_ارتداد("خارجي")
ثابت مرن_داخلي = جديد منحنى_مرن("داخلي")
ثابت مرن_خارجي = جديد منحنى_مرن("خارجي")
