# ===================================================================
# نظام التركيز — Focus System
# ===================================================================
# مطابق لـ flutter/widgets/focus_manager.dart + focus_scope.dart
# أنظمة جديدة: 1-5
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── عقدة_تركيز (FocusNode) ─── [نظام 1]
صدّر صنف عقدة_تركيز
    باني(قابل_للتخطي = خطأ, قابل_للتنازل = صحيح, تسمية_تصحيح = لاشيء)
        هذا._لديه_تركيز = خطأ
        هذا._أبناء = []
        هذا._أب = لاشيء
        هذا._قابل_للتخطي = قابل_للتخطي
        هذا._قابل_للتنازل = قابل_للتنازل
        هذا._تسمية_تصحيح = تسمية_تصحيح
        هذا._مستمعون = []
    نهاية

    دالة لديه_تركيز()
        ارجع هذا._لديه_تركيز
    نهاية

    دالة لديه_تركيز_أساسي()
        ارجع هذا._لديه_تركيز
    نهاية

    دالة اطلب_تركيز()
        هذا._لديه_تركيز = صحيح
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة ألغِ_تركيز()
        هذا._لديه_تركيز = خطأ
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة أضف_مستمع(رد_نداء)
        هذا._مستمعون = هذا._مستمعون + [رد_نداء]
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
        هذا._أبناء = []
    نهاية
نهاية

# ─── نطاق_تركيز (FocusScope) ─── [نظام 2]
صدّر صنف نطاق_تركيز يرث عنصر
    باني(ابن = لاشيء, عقدة = لاشيء, تركيز_تلقائي = خطأ)
        هذا._نوع = "نطاق_تركيز"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["عقدة"] = عقدة
        هذا._خصائص["تركيز_تلقائي"] = تركيز_تلقائي
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

