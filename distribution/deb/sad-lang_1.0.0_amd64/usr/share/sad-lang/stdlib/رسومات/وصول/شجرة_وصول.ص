# بسم الله الرحمن الرحيم
# ===================================================================
# إصلاح العيب #9: Accessibility Tree - شجرة إمكانية الوصول
# ===================================================================

# ─── أدوار إمكانية الوصول ───
صدّر تعداد دور_وصول
    زر = "button"
    رابط = "link"
    نص = "text"
    عنوان = "heading"
    صورة = "image"
    قائمة = "list"
    عنصر_قائمة = "listitem"
    حاوية = "group"
    منطقة = "region"
    حقل_نص = "textbox"
    خانة_اختيار = "checkbox"
    زر_راديو = "radio"
    منزلق = "slider"
    شريط_تقدم = "progressbar"
    علامة_تبويب = "tab"
    لوحة_تبويب = "tabpanel"
    قائمة_منسدلة = "combobox"
    حوار = "dialog"
    تنبيه = "alert"
    شجرة = "tree"
    عنصر_شجرة = "treeitem"
    جدول = "table"
    صف = "row"
    خلية = "cell"
نهاية

# ─── عقدة إمكانية الوصول ───
صدّر صنف عقدة_وصول
    باني(عنصر)
        هذا._عنصر = عنصر
        هذا._دور = دور_وصول.حاوية
        هذا._تسمية = ""
        هذا._وصف = ""
        هذا._قيمة = ""
        هذا._حالات = {}
        هذا._أبناء = []
        هذا._أب = لاشيء
        هذا._إجراءات = []
        هذا._خصائص = {}
    نهاية

    دالة عيّن_دور(دور)
        هذا._دور = دور
        ارجع هذا
    نهاية

    دالة عيّن_تسمية(تسمية)
        هذا._تسمية = تسمية
        ارجع هذا
    نهاية

    دالة عيّن_وصف(وصف)
        هذا._وصف = وصف
        ارجع هذا
    نهاية

    دالة عيّن_قيمة(قيمة)
        هذا._قيمة = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_حالة(اسم، قيمة)
        هذا._حالات[اسم] = قيمة
        ارجع هذا
    نهاية

    دالة أضف_إجراء(اسم، دالة_تنفيذ)
        هذا._إجراءات.أضف({اسم: اسم، نفّذ: دالة_تنفيذ})
        ارجع هذا
    نهاية

    دالة أضف_ابن(عقدة)
        عقدة._أب = هذا
        هذا._أبناء.أضف(عقدة)
        ارجع هذا
    نهاية

    دالة أزل_ابن(عقدة)
        عقدة._أب = لاشيء
        هذا._أبناء = هذا._أبناء.فلتر(لامدا(ع) => ع != عقدة)
        ارجع هذا
    نهاية

    دالة نفّذ_إجراء(اسم)
        لكل إجراء في هذا._إجراءات
            إذا (إجراء.اسم == اسم)
                إجراء.نفّذ()
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    دالة إلى_كائن()
        ارجع {
            دور: هذا._دور،
            تسمية: هذا._تسمية،
            وصف: هذا._وصف،
            قيمة: هذا._قيمة،
            حالات: هذا._حالات،
            إجراءات: هذا._إجراءات.خريطة(لامدا(إ) => إ.اسم)،
            أبناء: هذا._أبناء.خريطة(لامدا(ع) => ع.إلى_كائن())
        }
    نهاية
نهاية

# ─── شجرة إمكانية الوصول ───
صدّر صنف شجرة_وصول
    باني()
        هذا._جذر = لاشيء
        هذا._عقد_بالمعرف = {}
        هذا._عقدة_مركز = لاشيء
        هذا._مستمعون = []
    نهاية

    دالة عيّن_جذر(عقدة)
        هذا._جذر = عقدة
        هذا._فهرس_الشجرة(عقدة)
    نهاية

    دالة _فهرس_الشجرة(عقدة)
        إذا (عقدة._عنصر && عقدة._عنصر._معرف)
            هذا._عقد_بالمعرف[عقدة._عنصر._معرف] = عقدة
        نهاية
        
        لكل ابن في عقدة._أبناء
            هذا._فهرس_الشجرة(ابن)
        نهاية
    نهاية

    دالة جد_بالمعرف(معرف)
        ارجع هذا._عقد_بالمعرف[معرف]
    نهاية

    دالة عيّن_مركز(عقدة)
        متغير سابق = هذا._عقدة_مركز
        هذا._عقدة_مركز = عقدة
        
        هذا._أطلق_حدث("تغيير_مركز"، {
            سابق: سابق،
            جديد: عقدة
        })
    نهاية

    دالة المركز()
        ارجع هذا._عقدة_مركز
    نهاية

    دالة التالي(من_عقدة)
        إذا (من_عقدة == لاشيء)
            ارجع هذا._جذر
        نهاية
        
        # إذا لها أبناء، أول ابن
        إذا (من_عقدة._أبناء.الطول() > 0)
            ارجع من_عقدة._أبناء[0]
        نهاية
        
        # الأخ التالي
        متغير تالي = هذا._الأخ_التالي(من_عقدة)
        إذا (تالي != لاشيء)
            ارجع تالي
        نهاية
        
        # اصعد وجد الأخ التالي للأب
        متغير عقدة = من_عقدة._أب
        بينما (عقدة != لاشيء)
            تالي = هذا._الأخ_التالي(عقدة)
            إذا (تالي != لاشيء)
                ارجع تالي
            نهاية
            عقدة = عقدة._أب
        نهاية
        
        ارجع هذا._جذر
    نهاية

    دالة السابق(من_عقدة)
        إذا (من_عقدة == لاشيء)
            ارجع هذا._آخر_عميق(هذا._جذر)
        نهاية
        
        # الأخ السابق
        متغير سابق = هذا._الأخ_السابق(من_عقدة)
        إذا (سابق != لاشيء)
            ارجع هذا._آخر_عميق(سابق)
        نهاية
        
        # الأب
        إذا (من_عقدة._أب != لاشيء)
            ارجع من_عقدة._أب
        نهاية
        
        ارجع هذا._آخر_عميق(هذا._جذر)
    نهاية

    دالة _الأخ_التالي(عقدة)
        إذا (عقدة._أب == لاشيء)
            ارجع لاشيء
        نهاية
        
        متغير أبناء = عقدة._أب._أبناء
        متغير فهرس = أبناء.فهرس(عقدة)
        
        إذا (فهرس >= 0 و فهرس < أبناء.الطول() - 1)
            ارجع أبناء[فهرس + 1]
        نهاية
        
        ارجع لاشيء
    نهاية

    دالة _الأخ_السابق(عقدة)
        إذا (عقدة._أب == لاشيء)
            ارجع لاشيء
        نهاية
        
        متغير أبناء = عقدة._أب._أبناء
        متغير فهرس = أبناء.فهرس(عقدة)
        
        إذا (فهرس > 0)
            ارجع أبناء[فهرس - 1]
        نهاية
        
        ارجع لاشيء
    نهاية

    دالة _آخر_عميق(عقدة)
        بينما (عقدة._أبناء.الطول() > 0)
            عقدة = عقدة._أبناء[-1]
        نهاية
        ارجع عقدة
    نهاية

    دالة أضف_مستمع(حدث، دالة_callback)
        هذا._مستمعون.أضف({حدث: حدث، callback: دالة_callback})
    نهاية

    دالة _أطلق_حدث(نوع، بيانات)
        لكل مستمع في هذا._مستمعون
            إذا (مستمع.حدث == نوع)
                مستمع.callback(بيانات)
            نهاية
        نهاية
    نهاية

    دالة إلى_JSON()
        إذا (هذا._جذر != لاشيء)
            ارجع هذا._جذر.إلى_كائن()
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ─── قارئ الشاشة ───
صدّر صنف قارئ_شاشة
    باني(شجرة)
        هذا._شجرة = شجرة
        هذا._محرك_نطق = لاشيء
        هذا._صامت = خطأ
    نهاية

    دالة عيّن_محرك_نطق(محرك)
        هذا._محرك_نطق = محرك
    نهاية

    دالة اقرأ(عقدة)
        إذا (هذا._صامت)
            ارجع
        نهاية
        
        متغير نص = هذا._أنشئ_وصف(عقدة)
        
        إذا (هذا._محرك_نطق != لاشيء)
            هذا._محرك_نطق.انطق(نص)
        نهاية
        
        ارجع نص
    نهاية

    دالة _أنشئ_وصف(عقدة)
        متغير أجزاء = []
        
        # الدور
        متغير دور_عربي = هذا._ترجم_دور(عقدة._دور)
        أجزاء.أضف(دور_عربي)
        
        # التسمية
        إذا (عقدة._تسمية != "")
            أجزاء.أضف(عقدة._تسمية)
        نهاية
        
        # الحالات
        إذا (عقدة._حالات.محدد)
            أجزاء.أضف("محدد")
        نهاية
        إذا (عقدة._حالات.موسع)
            أجزاء.أضف("موسع")
        نهاية
        إذا (عقدة._حالات.معطل)
            أجزاء.أضف("معطل")
        نهاية
        
        # القيمة
        إذا (عقدة._قيمة != "")
            أجزاء.أضف("القيمة: " + عقدة._قيمة)
        نهاية
        
        ارجع أجزاء.اضم(" - ")
    نهاية

    دالة _ترجم_دور(دور)
        طابق (دور)
            عندما دور_وصول.زر:
                ارجع "زر"
            عندما دور_وصول.رابط:
                ارجع "رابط"
            عندما دور_وصول.نص:
                ارجع "نص"
            عندما دور_وصول.عنوان:
                ارجع "عنوان"
            عندما دور_وصول.صورة:
                ارجع "صورة"
            عندما دور_وصول.حقل_نص:
                ارجع "حقل نص"
            عندما دور_وصول.خانة_اختيار:
                ارجع "خانة اختيار"
            افتراضي:
                ارجع "عنصر"
        نهاية
    نهاية

    دالة صامت(قيمة)
        هذا._صامت = قيمة
    نهاية
نهاية
