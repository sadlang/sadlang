# ===================================================================
# كاشفات الإيماءات والتفاعلات اللمسية
# مطابق لـ flutter/gestures/ و flutter/widgets/gesture_detector.dart
#
# الاستخدام:
#   استورد * من رسومات.إيماءات_نظام.إيماءات
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── كاشف_إيماءات (GestureDetector) ───
صدّر صنف كاشف_إيماءات يرث عنصر
    باني(ابن = لاشيء)
        هذا._نوع = "كاشف_إيماءات"
        هذا._خصائص = {}
        هذا._خصائص["عند_النقر"] = لاشيء
        هذا._خصائص["عند_النقر_المزدوج"] = لاشيء
        هذا._خصائص["عند_الضغط_المطول"] = لاشيء
        هذا._خصائص["عند_بداية_السحب_أفقي"] = لاشيء
        هذا._خصائص["عند_تحديث_السحب_أفقي"] = لاشيء
        هذا._خصائص["عند_نهاية_السحب_أفقي"] = لاشيء
        هذا._خصائص["عند_بداية_السحب_عمودي"] = لاشيء
        هذا._خصائص["عند_تحديث_السحب_عمودي"] = لاشيء
        هذا._خصائص["عند_نهاية_السحب_عمودي"] = لاشيء
        هذا._خصائص["عند_بداية_القرص"] = لاشيء
        هذا._خصائص["عند_تحديث_القرص"] = لاشيء
        هذا._خصائص["عند_نهاية_القرص"] = لاشيء
        هذا._خصائص["سلوك_النقر"] = لاشيء
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية

    دالة عند_النقر(دالة_رد)
        هذا._خصائص["عند_النقر"] = دالة_رد
        ارجع هذا
    نهاية

    دالة عند_النقر_المزدوج(دالة_رد)
        هذا._خصائص["عند_النقر_المزدوج"] = دالة_رد
        ارجع هذا
    نهاية

    دالة عند_الضغط_المطول(دالة_رد)
        هذا._خصائص["عند_الضغط_المطول"] = دالة_رد
        ارجع هذا
    نهاية

    دالة عند_السحب_أفقي(بداية, تحديث, نهاية_سحب)
        هذا._خصائص["عند_بداية_السحب_أفقي"] = بداية
        هذا._خصائص["عند_تحديث_السحب_أفقي"] = تحديث
        هذا._خصائص["عند_نهاية_السحب_أفقي"] = نهاية_سحب
        ارجع هذا
    نهاية

    دالة عند_السحب_عمودي(بداية, تحديث, نهاية_سحب)
        هذا._خصائص["عند_بداية_السحب_عمودي"] = بداية
        هذا._خصائص["عند_تحديث_السحب_عمودي"] = تحديث
        هذا._خصائص["عند_نهاية_السحب_عمودي"] = نهاية_سحب
        ارجع هذا
    نهاية

    دالة عند_القرص(بداية, تحديث, نهاية_قرص)
        هذا._خصائص["عند_بداية_القرص"] = بداية
        هذا._خصائص["عند_تحديث_القرص"] = تحديث
        هذا._خصائص["عند_نهاية_القرص"] = نهاية_قرص
        ارجع هذا
    نهاية
نهاية

