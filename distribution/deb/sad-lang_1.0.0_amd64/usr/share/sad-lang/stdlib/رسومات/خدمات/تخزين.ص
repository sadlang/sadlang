# ===================================================================
# خدمة التخزين المحلي — Storage Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/تخزين.ص
# ===================================================================
# مكتبة تخزين شاملة تدعم:
#   - تخزين مفتاح-قيمة بسيط (SharedPreferences-style)
#   - تخزين آمن مشفر (Keychain/Keystore-style)
#   - تخزين مؤقت (Cache) مع انتهاء صلاحية
#   - تخزين على القرص مع تسلسل JSON
#   - أحداث عند تغيير القيم
#
# الاستخدام:
#   استورد * من رسومات.خدمات.تخزين
#   متغير مخزن = جديد مخزن_محلي()
#   مخزن.عيّن("مفتاح", "قيمة")
#   متغير ق = مخزن.احصل("مفتاح")
#
# المنصات المدعومة:
#   ✅ سطح المكتب (ملفات JSON على القرص)
#   ✅ النواة (ذاكرة فقط / قطاعات قرص خام)
#   ✅ الويب (localStorage / sessionStorage)
#   ✅ أندرويد (SharedPreferences / EncryptedSharedPreferences)
#   ✅ iOS (UserDefaults / Keychain)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت وتعدادات
# ===================================================================

صدّر تعداد نوع_تخزين
    ذاكرة       # RAM فقط — يُفقد عند الإغلاق
    محلي        # ملف على القرص — يبقى
    جلسة        # مؤقت — يُفقد عند إغلاق التطبيق
    آمن         # مشفر — للبيانات الحساسة
نهاية

صدّر تعداد حالة_تخزين
    مهيأ
    غير_مهيأ
    خطأ_قراءة
    خطأ_كتابة
    ممتلئ
نهاية

# ===================================================================
#       مخزن_محلي — التخزين الأساسي (مفتاح-قيمة)
# ===================================================================

صدّر صنف مخزن_محلي
    باني(اسم = "افتراضي", نوع = نوع_تخزين.محلي)
        هذا._اسم = اسم
        هذا._نوع = نوع
        هذا._بيانات = {}
        هذا._مراقبون = []
        هذا._حالة = حالة_تخزين.غير_مهيأ
        هذا._مسار_ملف = لاشيء
        هذا._تهيئة()
    نهاية

    # ─── التهيئة الداخلية ───
    دالة _تهيئة()
        حاول
            إذا (هذا._نوع == نوع_تخزين.محلي)
                هذا._مسار_ملف = _مسار_تخزين_افتراضي(هذا._اسم)
                هذا._حمّل_من_القرص()
            نهاية
            هذا._حالة = حالة_تخزين.مهيأ
        امسك خ
            هذا._حالة = حالة_تخزين.خطأ_قراءة
        نهاية
    نهاية

    # ─── القراءة والكتابة الأساسية ───

    ## تخزين قيمة بمفتاح
    دالة عيّن(مفتاح, قيمة)
        متغير قديمة = هذا._بيانات[مفتاح]
        هذا._بيانات[مفتاح] = قيمة
        هذا._أشعر("تغيير", مفتاح, قيمة, قديمة)
        إذا (هذا._نوع == نوع_تخزين.محلي)
            هذا._احفظ_على_القرص()
        نهاية
        ارجع هذا
    نهاية

    ## استرجاع قيمة بمفتاح مع قيمة افتراضية
    دالة احصل(مفتاح, افتراضي = لاشيء)
        إذا (هذا._بيانات[مفتاح] != لاشيء)
            ارجع هذا._بيانات[مفتاح]
        نهاية
        ارجع افتراضي
    نهاية

    ## تخزين عدد صحيح
    دالة عيّن_رقم(مفتاح, قيمة)
        ارجع هذا.عيّن(مفتاح, قيمة)
    نهاية

    ## استرجاع عدد صحيح
    دالة احصل_رقم(مفتاح, افتراضي = 0)
        متغير ق = هذا.احصل(مفتاح)
        إذا (ق == لاشيء)
            ارجع افتراضي
        نهاية
        ارجع ق
    نهاية

    ## تخزين قيمة منطقية
    دالة عيّن_منطقي(مفتاح, قيمة)
        ارجع هذا.عيّن(مفتاح, قيمة)
    نهاية

    ## استرجاع قيمة منطقية
    دالة احصل_منطقي(مفتاح, افتراضي = خطأ)
        متغير ق = هذا.احصل(مفتاح)
        إذا (ق == لاشيء)
            ارجع افتراضي
        نهاية
        ارجع ق
    نهاية

    ## تخزين قائمة
    دالة عيّن_قائمة(مفتاح, قائمة)
        ارجع هذا.عيّن(مفتاح, قائمة)
    نهاية

    ## استرجاع قائمة
    دالة احصل_قائمة(مفتاح, افتراضي = [])
        متغير ق = هذا.احصل(مفتاح)
        إذا (ق == لاشيء)
            ارجع افتراضي
        نهاية
        ارجع ق
    نهاية

    ## تخزين كائن (خريطة)
    دالة عيّن_كائن(مفتاح, كائن)
        ارجع هذا.عيّن(مفتاح, كائن)
    نهاية

    ## استرجاع كائن
    دالة احصل_كائن(مفتاح, افتراضي = {})
        متغير ق = هذا.احصل(مفتاح)
        إذا (ق == لاشيء)
            ارجع افتراضي
        نهاية
        ارجع ق
    نهاية

    # ─── الحذف والمسح ───

    ## حذف مفتاح
    دالة احذف(مفتاح)
        متغير قديمة = هذا._بيانات[مفتاح]
        هذا._بيانات[مفتاح] = لاشيء
        هذا._أشعر("حذف", مفتاح, لاشيء, قديمة)
        إذا (هذا._نوع == نوع_تخزين.محلي)
            هذا._احفظ_على_القرص()
        نهاية
    نهاية

    ## مسح كل البيانات
    دالة امسح()
        هذا._بيانات = {}
        هذا._أشعر("مسح", لاشيء, لاشيء, لاشيء)
        إذا (هذا._نوع == نوع_تخزين.محلي)
            هذا._احفظ_على_القرص()
        نهاية
    نهاية

    ## هل المفتاح موجود؟
    دالة يحتوي(مفتاح)
        ارجع هذا._بيانات[مفتاح] != لاشيء
    نهاية

    ## عدد العناصر المخزنة
    دالة العدد()
        متغير ع = 0
        لكل م في هذا._بيانات
            ع = ع + 1
        نهاية
        ارجع ع
    نهاية

    ## جميع المفاتيح
    دالة المفاتيح()
        متغير قائمة = []
        لكل م في هذا._بيانات
            قائمة = قائمة + [م]
        نهاية
        ارجع قائمة
    نهاية

    ## الحالة الحالية
    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    # ─── المراقبة (Events) ───

    ## مراقبة تغييرات المخزن
    دالة راقب(رد_نداء)
        هذا._مراقبون = هذا._مراقبون + [رد_نداء]
    نهاية

    ## إلغاء مراقبة
    دالة ألغِ_مراقبة(رد_نداء)
        متغير جديدة = []
        لكل م في هذا._مراقبون
            إذا (م != رد_نداء)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مراقبون = جديدة
    نهاية

    # ─── داخلي ───

    دالة _أشعر(نوع_حدث, مفتاح, قيمة_جديدة, قيمة_قديمة)
        لكل مراقب في هذا._مراقبون
            مراقب({
                نوع: نوع_حدث,
                مفتاح: مفتاح,
                جديدة: قيمة_جديدة,
                قديمة: قيمة_قديمة
            })
        نهاية
    نهاية

    دالة _حمّل_من_القرص()
        حاول
            إذا (هذا._مسار_ملف != لاشيء)
                متغير محتوى = حمّل_مخزن_قرص(هذا._اسم)
                إذا (محتوى != لاشيء)
                    هذا._بيانات = محتوى
                نهاية
            نهاية
        امسك خ
            هذا._حالة = حالة_تخزين.خطأ_قراءة
        نهاية
    نهاية

    دالة _احفظ_على_القرص()
        حاول
            إذا (هذا._مسار_ملف != لاشيء)
                احفظ_مخزن_قرص(هذا._اسم, هذا._بيانات)
            نهاية
        امسك خ
            هذا._حالة = حالة_تخزين.خطأ_كتابة
        نهاية
    نهاية
نهاية

# ===================================================================
#       تخزين_مؤقت — Cache مع انتهاء صلاحية
# ===================================================================

صدّر صنف تخزين_مؤقت
    باني(مدة_افتراضية = 300000)
        هذا._بيانات = {}
        هذا._أوقات = {}
        هذا._مدة_افتراضية = مدة_افتراضية
    نهاية

    ## تخزين مع مدة انتهاء (مللي ثانية)
    دالة عيّن(مفتاح, قيمة, مدة = لاشيء)
        إذا (مدة == لاشيء)
            مدة = هذا._مدة_افتراضية
        نهاية
        هذا._بيانات[مفتاح] = قيمة
        هذا._أوقات[مفتاح] = _الوقت_الحالي() + مدة
        ارجع هذا
    نهاية

    ## استرجاع (يُرجع لاشيء إذا انتهت الصلاحية)
    دالة احصل(مفتاح)
        إذا (هذا._بيانات[مفتاح] == لاشيء)
            ارجع لاشيء
        نهاية
        إذا (هذا._أوقات[مفتاح] != لاشيء)
            إذا (_الوقت_الحالي() > هذا._أوقات[مفتاح])
                هذا.احذف(مفتاح)
                ارجع لاشيء
            نهاية
        نهاية
        ارجع هذا._بيانات[مفتاح]
    نهاية

    ## حذف مفتاح من الذاكرة المؤقتة
    دالة احذف(مفتاح)
        هذا._بيانات[مفتاح] = لاشيء
        هذا._أوقات[مفتاح] = لاشيء
    نهاية

    ## مسح كل الذاكرة المؤقتة
    دالة امسح()
        هذا._بيانات = {}
        هذا._أوقات = {}
    نهاية

    ## تنظيف المنتهية فقط
    دالة نظّف()
        متغير الآن = _الوقت_الحالي()
        لكل م في هذا._أوقات
            إذا (هذا._أوقات[م] != لاشيء)
                إذا (الآن > هذا._أوقات[م])
                    هذا.احذف(م)
                نهاية
            نهاية
        نهاية
    نهاية

    ## هل المفتاح صالح؟
    دالة صالح(مفتاح)
        ارجع هذا.احصل(مفتاح) != لاشيء
    نهاية
نهاية

# ===================================================================
#       تخزين_آمن — للبيانات الحساسة (كلمات مرور، رموز)
# ===================================================================

صدّر صنف تخزين_آمن
    باني()
        هذا._مخزن = جديد مخزن_محلي("آمن", نوع_تخزين.آمن)
    نهاية

    ## تخزين سر بشكل مشفر
    دالة عيّن(مفتاح, قيمة)
        حاول
            متغير مشفر = _شفّر_آمن(قيمة)
            هذا._مخزن.عيّن(مفتاح, مشفر)
        امسك خ
            هذا._مخزن.عيّن(مفتاح, قيمة)
        نهاية
        ارجع هذا
    نهاية

    ## استرجاع وفك تشفير سر
    دالة احصل(مفتاح)
        متغير مشفر = هذا._مخزن.احصل(مفتاح)
        إذا (مشفر == لاشيء)
            ارجع لاشيء
        نهاية
        حاول
            ارجع _فكّ_آمن(مشفر)
        امسك خ
            ارجع مشفر
        نهاية
    نهاية

    ## حذف سر
    دالة احذف(مفتاح)
        هذا._مخزن.احذف(مفتاح)
    نهاية

    ## مسح كل الأسرار
    دالة امسح()
        هذا._مخزن.امسح()
    نهاية

    ## هل المفتاح موجود؟
    دالة يحتوي(مفتاح)
        ارجع هذا._مخزن.يحتوي(مفتاح)
    نهاية
نهاية

# ===================================================================
#       دوال مساعدة عامة (للتوافق مع API القديم)
# ===================================================================

متغير _المخزن_الافتراضي = لاشيء

دالة _المخزن()
    إذا (_المخزن_الافتراضي == لاشيء)
        _المخزن_الافتراضي = جديد مخزن_محلي()
    نهاية
    ارجع _المخزن_الافتراضي
نهاية

## تخزين قيمة (واجهة بسيطة)
صدّر دالة خزن(مفتاح, قيمة)
    _المخزن().عيّن(مفتاح, قيمة)
نهاية

## استرجاع قيمة (واجهة بسيطة)
صدّر دالة احصل(مفتاح)
    ارجع _المخزن().احصل(مفتاح)
نهاية

## حذف قيمة (واجهة بسيطة)
صدّر دالة احذف(مفتاح)
    _المخزن().احذف(مفتاح)
نهاية

## مسح كل التخزين (واجهة بسيطة)
صدّر دالة امسح()
    _المخزن().امسح()
نهاية

# ===================================================================
# دوال backend داخلية (تنادي C++ builtins)
# ===================================================================

دالة _مسار_تخزين_افتراضي(اسم)
    حاول
        ارجع مسار_التخزين(اسم)
    امسك خ
        ارجع اسم + ".json"
    نهاية
نهاية

دالة _الوقت_الحالي()
    حاول
        ارجع وقت_النظام()
    امسك خ
        ارجع 0
    نهاية
نهاية

دالة _شفّر_آمن(نص)
    حاول
        ارجع شفّر_نص(نص, "_sad_secure_key_")
    امسك خ
        ارجع نص
    نهاية
نهاية

دالة _فكّ_آمن(مشفر)
    حاول
        ارجع فكّ_تشفير(مشفر, "_sad_secure_key_")
    امسك خ
        ارجع مشفر
    نهاية
نهاية
