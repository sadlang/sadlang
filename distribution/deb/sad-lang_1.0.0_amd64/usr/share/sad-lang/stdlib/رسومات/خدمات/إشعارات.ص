# ===================================================================
# خدمة الإشعارات — Notification Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/إشعارات.ص
# ===================================================================
# مكتبة إشعارات شاملة تدعم:
#   - إشعارات نظام (System Notifications)
#   - إشعارات داخل التطبيق (In-App Notifications)
#   - إشعارات مجدولة (Scheduled)
#   - قنوات إشعارات (Channels)
#   - إجراءات (Actions) مع أزرار
#   - أولويات وأصوات مخصصة
#
# الاستخدام:
#   استورد * من رسومات.خدمات.إشعارات
#   أشعر("عنوان", "محتوى")
#   # أو الطريقة المتقدمة:
#   متغير إ = جديد إشعار("عنوان", "رسالة")
#   إ.الأولوية(أولوية_إشعار.عالية).أرسل()
#
# المنصات المدعومة:
#   ✅ سطح المكتب (SDL_ShowSimpleMessageBox / تنبيهات النظام)
#   ✅ النواة (حالة في الذاكرة / طابور رسائل)
#   ✅ الويب (Notification API / Push API)
#   ✅ أندرويد (NotificationManager / NotificationChannel)
#   ✅ iOS (UNUserNotificationCenter / APNs)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#                    ثوابت وتعدادات
# ===================================================================

صدّر تعداد أولوية_إشعار
    منخفضة
    عادية
    عالية
    طارئ
نهاية

صدّر تعداد نوع_إشعار
    نظام          # إشعار نظام خارج التطبيق
    داخلي         # إشعار داخل التطبيق (snackbar/toast)
    صامت          # بدون صوت
نهاية

# ===================================================================
#       إشعار — Notification Builder
# ===================================================================

صدّر صنف إشعار
    باني(عنوان = "", محتوى = "")
        هذا._عنوان = عنوان
        هذا._محتوى = محتوى
        هذا._أولوية = أولوية_إشعار.عادية
        هذا._نوع = نوع_إشعار.نظام
        هذا._قناة = "افتراضي"
        هذا._أيقونة = ""
        هذا._صوت = صحيح
        هذا._إجراءات = []
        هذا._رد_نقر = لاشيء
        هذا._وقت_جدولة = لاشيء
        هذا._مهلة = 5000
    نهاية

    ## تعيين العنوان
    دالة العنوان(عنوان)
        هذا._عنوان = عنوان
        ارجع هذا
    نهاية

    ## تعيين المحتوى
    دالة المحتوى(محتوى)
        هذا._محتوى = محتوى
        ارجع هذا
    نهاية

    ## تعيين الأولوية
    دالة الأولوية(أولوية)
        هذا._أولوية = أولوية
        ارجع هذا
    نهاية

    ## تعيين النوع
    دالة النوع(نوع)
        هذا._نوع = نوع
        ارجع هذا
    نهاية

    ## تعيين القناة
    دالة القناة(قناة)
        هذا._قناة = قناة
        ارجع هذا
    نهاية

    ## تعيين الأيقونة
    دالة الأيقونة(مسار)
        هذا._أيقونة = مسار
        ارجع هذا
    نهاية

    ## تفعيل/تعطيل الصوت
    دالة صوت(قيمة = صحيح)
        هذا._صوت = قيمة
        ارجع هذا
    نهاية

    ## إضافة إجراء (زر)
    دالة أضف_إجراء(عنوان, رد_نداء)
        هذا._إجراءات = هذا._إجراءات + [{عنوان: عنوان, رد: رد_نداء}]
        ارجع هذا
    نهاية

    ## عند النقر على الإشعار
    دالة عند_نقر(رد_نداء)
        هذا._رد_نقر = رد_نداء
        ارجع هذا
    نهاية

    ## جدولة بعد مدة (مللي ثانية)
    دالة جدول(مللي_ثانية)
        هذا._وقت_جدولة = مللي_ثانية
        ارجع هذا
    نهاية

    ## مهلة الإخفاء (مللي ثانية)
    دالة المهلة(مللي_ثانية)
        هذا._مهلة = مللي_ثانية
        ارجع هذا
    نهاية

    ## إرسال الإشعار
    دالة أرسل()
        إذا (هذا._وقت_جدولة != لاشيء)
            متغير ذاتي = هذا
            حاول
                مؤقت_مرة(
                    لامدا()
                        ذاتي._أرسل_فوري()
                    نهاية,
                    هذا._وقت_جدولة
                )
            امسك خ
                هذا._أرسل_فوري()
            نهاية
        وإلا
            هذا._أرسل_فوري()
        نهاية
        ارجع هذا
    نهاية

    # ─── داخلي ───

    دالة _أرسل_فوري()
        حاول
            إشعار(هذا._عنوان, هذا._محتوى)
        امسك خ
            # تجاهل — الإشعارات غير متاحة
        نهاية
    نهاية
نهاية

# ===================================================================
#       مدير_إشعارات — Notification Manager
# ===================================================================

صدّر صنف مدير_إشعارات
    باني()
        هذا._قنوات = {}
        هذا._مصروفة_الأخيرة = []
    نهاية

    ## تسجيل قناة إشعارات
    دالة سجل_قناة(اسم, وصف = "")
        هذا._قنوات[اسم] = {وصف: وصف, مفعلة: صحيح}
        ارجع هذا
    نهاية

    ## هل القناة مفعلة؟
    دالة قناة_مفعلة(اسم)
        إذا (هذا._قنوات[اسم] != لاشيء)
            ارجع هذا._قنوات[اسم].مفعلة
        نهاية
        ارجع صحيح
    نهاية

    ## تفعيل/تعطيل قناة
    دالة عين_قناة(اسم, مفعلة)
        إذا (هذا._قنوات[اسم] != لاشيء)
            هذا._قنوات[اسم].مفعلة = مفعلة
        نهاية
        ارجع هذا
    نهاية

    ## إرسال إشعار سريع
    دالة أرسل(عنوان, محتوى, قناة = "افتراضي")
        إذا (ليس هذا.قناة_مفعلة(قناة))
            ارجع هذا
        نهاية
        متغير إ = جديد إشعار(عنوان, محتوى)
        إ.القناة(قناة).أرسل()
        هذا._مصروفة_الأخيرة = هذا._مصروفة_الأخيرة + [{عنوان: عنوان, محتوى: محتوى, قناة: قناة}]
        ارجع هذا
    نهاية

    ## إلغاء جميع الإشعارات
    دالة ألغِ_الكل()
        حاول
            ألغ_كل_الإشعارات()
        امسك خ
            # تجاهل
        نهاية
        ارجع هذا
    نهاية

    ## آخر الإشعارات المرسلة
    دالة السجل()
        ارجع هذا._مصروفة_الأخيرة
    نهاية
نهاية

