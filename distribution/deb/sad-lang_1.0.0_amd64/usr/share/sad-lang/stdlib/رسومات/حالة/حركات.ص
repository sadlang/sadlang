# ─── منحنيات الحركة (Curves) ───
صدّر صنف منحنى
    ساكن دالة خطي(ن)
        ارجع ن
    نهاية

    ساكن دالة تسهيل_دخول(ن)
        ارجع ن * ن
    نهاية

    ساكن دالة تسهيل_خروج(ن)
        ارجع ن * (2 - ن)
    نهاية

    ساكن دالة تسهيل(ن)
        إذا (ن < 0.5)
            ارجع 2 * ن * ن
        وإلا
            ارجع -1 + (4 - 2 * ن) * ن
        نهاية
    نهاية

    ساكن دالة ارتداد(ن)
        إذا (ن < 1 / 2.75)
            ارجع 7.5625 * ن * ن
        وإلا
            إذا (ن < 2 / 2.75)
                متغير ن2 = ن - 1.5 / 2.75
                ارجع 7.5625 * ن2 * ن2 + 0.75
            وإلا
                إذا (ن < 2.5 / 2.75)
                    متغير ن2 = ن - 2.25 / 2.75
                    ارجع 7.5625 * ن2 * ن2 + 0.9375
                وإلا
                    متغير ن2 = ن - 2.625 / 2.75
                    ارجع 7.5625 * ن2 * ن2 + 0.984375
                نهاية
            نهاية
        نهاية
    نهاية

    ساكن دالة مرن(ن)
        ارجع ن * ن * ((2.70158 + 1) * ن - 2.70158)
    نهاية
نهاية

# ─── انتقال (Tween) ───
صدّر صنف انتقال
    باني(بداية, نهاية_ق)
        هذا.بداية = بداية
        هذا.نهاية_القيمة = نهاية_ق
    نهاية

    دالة قيّم(ن)
        ارجع هذا.بداية + (هذا.نهاية_القيمة - هذا.بداية) * ن
    نهاية
نهاية

# ─── انتقال_لون (ColorTween) ───
صدّر صنف انتقال_لون
    باني(بداية, نهاية_ق)
        هذا.بداية = بداية
        هذا.نهاية_القيمة = نهاية_ق
    نهاية

    دالة قيّم(ن)
        # استيفاء خطي بين لونين (hex → مزج → hex)
        ارجع هذا.بداية
    نهاية
نهاية

# ─── متحكم_حركة (AnimationController) ───
صدّر صنف متحكم_حركة
    باني(مدة)
        هذا.المدة = مدة
        هذا.القيمة = 0.0
        هذا._حالة = "متوقف"
        هذا._مستمعون = []
        هذا._مستمعو_حالة = []
        دالة _منحنى_خطي(ن)
            ارجع ن
        نهاية
        هذا._المنحنى = _منحنى_خطي
        هذا._مؤقت = لاشيء
        هذا._معكوس = خطأ
    نهاية

    دالة منحنى(دالة_منحنى)
        هذا._المنحنى = دالة_منحنى
        ارجع هذا
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
        ارجع هذا
    نهاية

    دالة أضف_مستمع_حالة(مستمع)
        هذا._مستمعو_حالة.أضف(مستمع)
        ارجع هذا
    نهاية

    دالة _أشعر()
        متغير قيمة_منحنى = هذا._المنحنى(هذا.القيمة)
        لكل م في هذا._مستمعون
            م(قيمة_منحنى)
        نهاية
    نهاية

    دالة _أشعر_حالة(حالة)
        هذا._حالة = حالة
        لكل م في هذا._مستمعو_حالة
            م(حالة)
        نهاية
    نهاية

    دالة تشغيل()
        هذا._معكوس = خطأ
        هذا._أشعر_حالة("تشغيل")
        هذا._بدء_حركة()
    نهاية

    دالة عكس()
        هذا._معكوس = صحيح
        هذا._أشعر_حالة("عكس")
        هذا._بدء_حركة()
    نهاية

    دالة تكرار(معكوس)
        إذا (معكوس == لاشيء)
            معكوس = خطأ
        نهاية
        هذا._أشعر_حالة("تكرار")
        هذا._بدء_حركة_مكررة(معكوس)
    نهاية

    دالة أوقف()
        هذا._أشعر_حالة("متوقف")
        إذا (هذا._مؤقت != لاشيء)
            أوقف_مؤقت(هذا._مؤقت)
            هذا._مؤقت = لاشيء
        نهاية
    نهاية

    دالة إعادة_ضبط()
        هذا.أوقف()
        هذا.القيمة = 0.0
        هذا._أشعر()
    نهاية

    دالة _بدء_حركة()
        متغير خطوات = 60
        متغير فترة = هذا.المدة / خطوات
        متغير خطوة = 1.0 / خطوات
        متغير ذات = هذا

        دالة _خطوة_حركة()
            إذا (ذات._معكوس)
                ذات.القيمة = ذات.القيمة - خطوة
                إذا (ذات.القيمة <= 0.0)
                    ذات.القيمة = 0.0
                    ذات._أشعر()
                    ذات.أوقف()
                    ذات._أشعر_حالة("مكتمل")
                    ارجع لاشيء
                نهاية
            وإلا
                ذات.القيمة = ذات.القيمة + خطوة
                إذا (ذات.القيمة >= 1.0)
                    ذات.القيمة = 1.0
                    ذات._أشعر()
                    ذات.أوقف()
                    ذات._أشعر_حالة("مكتمل")
                    ارجع لاشيء
                نهاية
            نهاية
            ذات._أشعر()
        نهاية
        هذا._مؤقت = كل_مدة(فترة, _خطوة_حركة)
    نهاية

    دالة _بدء_حركة_مكررة(معكوس)
        متغير خطوات = 60
        متغير فترة = هذا.المدة / خطوات
        متغير خطوة = 1.0 / خطوات
        متغير ذات = هذا
        متغير اتجاه_للأمام = صحيح

        دالة _خطوة_مكررة()
            إذا (اتجاه_للأمام)
                ذات.القيمة = ذات.القيمة + خطوة
                إذا (ذات.القيمة >= 1.0)
                    ذات.القيمة = 1.0
                    إذا (معكوس)
                        اتجاه_للأمام = خطأ
                    وإلا
                        ذات.القيمة = 0.0
                    نهاية
                نهاية
            وإلا
                ذات.القيمة = ذات.القيمة - خطوة
                إذا (ذات.القيمة <= 0.0)
                    ذات.القيمة = 0.0
                    اتجاه_للأمام = صحيح
                نهاية
            نهاية
            ذات._أشعر()
        نهاية
        هذا._مؤقت = كل_مدة(فترة, _خطوة_مكررة)
    نهاية
نهاية

# ─── حركة بسيطة (مساعد) ───
صدّر دالة حرّك(بداية, نهاية_ق, مدة, عند_تحديث, عند_اكتمال)
    متغير ت = جديد انتقال(بداية, نهاية_ق)
    متغير م = جديد متحكم_حركة(مدة)
    دالة _عند_تحديث(ق)
        عند_تحديث(ت.قيّم(ق))
    نهاية
    م.أضف_مستمع(_عند_تحديث)
    إذا (عند_اكتمال != لاشيء)
        دالة _عند_حالة(حالة)
            إذا (حالة == "مكتمل")
                عند_اكتمال()
            نهاية
        نهاية
        م.أضف_مستمع_حالة(_عند_حالة)
    نهاية
    م.تشغيل()
    ارجع م
نهاية
