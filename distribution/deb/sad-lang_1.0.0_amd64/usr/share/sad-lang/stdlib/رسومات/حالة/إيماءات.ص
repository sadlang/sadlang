# ===================================================================
# نظام الإيماءات المتقدم — Advanced Gestures
# ===================================================================
# التعرف على الإيماءات المعقدة والإيماءات المخصصة
#
# الاستخدام:
#   استورد * من رسومات.حالة.إيماءات
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── كاشف_إيماء (GestureDetector) ───
صدّر صنف كاشف_إيماء يرث عنصر
    باني(طفل)
        هذا._نوع = "كاشف_إيماء"
        هذا._خصائص = {}
        هذا._معالجات = {}
        إذا (طفل != لاشيء)
            هذا._أبناء = [طفل]
        وإلا
            هذا._أبناء = []
        نهاية
    نهاية

    دالة عند_ضغط(معالج)
        هذا._معالجات["ضغط"] = معالج
        ارجع هذا
    نهاية

    دالة عند_ضغط_مزدوج(معالج)
        هذا._معالجات["ضغط_مزدوج"] = معالج
        ارجع هذا
    نهاية

    دالة عند_ضغط_طويل(معالج)
        هذا._معالجات["ضغط_طويل"] = معالج
        ارجع هذا
    نهاية

    دالة عند_سحب_أفقي(معالج)
        هذا._معالجات["سحب_أفقي"] = معالج
        ارجع هذا
    نهاية

    دالة عند_سحب_عمودي(معالج)
        هذا._معالجات["سحب_عمودي"] = معالج
        ارجع هذا
    نهاية

    دالة عند_تكبير(معالج)
        هذا._معالجات["تكبير"] = معالج
        ارجع هذا
    نهاية

    دالة عند_تدوير(معالج)
        هذا._معالجات["تدوير"] = معالج
        ارجع هذا
    نهاية

    دالة عند_تمرير(معالج)
        هذا._معالجات["تمرير"] = معالج
        ارجع هذا
    نهاية
نهاية

