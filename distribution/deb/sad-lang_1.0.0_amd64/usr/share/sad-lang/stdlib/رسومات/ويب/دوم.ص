# ─── عنصر_ويب (DOM Element Wrapper) ───
صدّر صنف عنصر_ويب
    باني(وسم = "div", معرف = لاشيء, أصناف = لاشيء)
        هذا.وسم = وسم
        هذا.معرف = معرف
        هذا.أصناف = أصناف
        هذا._أبناء = []
        هذا._أنماط = {}
        هذا._أحداث = {}
        هذا._خصائص_ويب = {}
        هذا._نص_داخلي = لاشيء
    نهاية

    دالة أضف_طفل(طفل)
        هذا._أبناء.أضف(طفل)
        ارجع هذا
    نهاية

    دالة عيّن_نمط(اسم, قيمة)
        هذا._أنماط[اسم] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_حدث(اسم, معالج)
        هذا._أحداث[اسم] = معالج
        ارجع هذا
    نهاية

    دالة عيّن_خاصية(اسم, قيمة)
        هذا._خصائص_ويب[اسم] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_نص(نص)
        هذا._نص_داخلي = نص
        ارجع هذا
    نهاية

    # تحويل إلى HTML
    دالة إلى_html()
        متغير نتيجة = "<" + هذا.وسم

        # المعرف
        إذا (هذا.معرف != لاشيء)
            نتيجة = نتيجة + " id=\"" + هذا.معرف + "\""
        نهاية

        # الأصناف
        إذا (هذا.أصناف != لاشيء)
            نتيجة = نتيجة + " class=\"" + هذا.أصناف + "\""
        نهاية

        # الأنماط
        متغير أنماط_نص = ""
        لكل مفتاح في هذا._أنماط
            أنماط_نص = أنماط_نص + مفتاح + ":" + هذا._أنماط[مفتاح] + ";"
        نهاية
        إذا (أنماط_نص != "")
            نتيجة = نتيجة + " style=\"" + أنماط_نص + "\""
        نهاية

        # الخصائص
        لكل مفتاح في هذا._خصائص_ويب
            نتيجة = نتيجة + " " + مفتاح + "=\"" + هذا._خصائص_ويب[مفتاح] + "\""
        نهاية

        نتيجة = نتيجة + ">"

        # النص الداخلي
        إذا (هذا._نص_داخلي != لاشيء)
            نتيجة = نتيجة + هذا._نص_داخلي
        نهاية

        # الأطفال
        لكل طفل في هذا._أبناء
            نتيجة = نتيجة + طفل.إلى_html()
        نهاية

        # إغلاق الوسم
        نتيجة = نتيجة + "</" + هذا.وسم + ">"
        ارجع نتيجة
    نهاية
نهاية

# ─── مساعدات إنشاء عناصر ويب شائعة ───

صدّر دالة فقرة(نص, معرف = لاشيء)
    متغير ع = جديد عنصر_ويب("p", معرف)
    ع.عيّن_نص(نص)
    ارجع ع
نهاية

صدّر دالة عنوان(نص, مستوى = 1, معرف = لاشيء)
    متغير ع = جديد عنصر_ويب("h" + مستوى, معرف)
    ع.عيّن_نص(نص)
    ارجع ع
نهاية

صدّر دالة قسم(معرف = لاشيء, أصناف = لاشيء)
    ارجع جديد عنصر_ويب("div", معرف, أصناف)
نهاية

صدّر دالة زر_ويب(نص, معرف = لاشيء)
    متغير ع = جديد عنصر_ويب("button", معرف)
    ع.عيّن_نص(نص)
    ارجع ع
نهاية

صدّر دالة إدخال_ويب(نوع = "text", معرف = لاشيء, تلميح = لاشيء)
    متغير ع = جديد عنصر_ويب("input", معرف)
    ع.عيّن_خاصية("type", نوع)
    إذا (تلميح != لاشيء)
        ع.عيّن_خاصية("placeholder", تلميح)
    نهاية
    ارجع ع
نهاية

صدّر دالة صورة_ويب(مصدر, بديل = "", معرف = لاشيء)
    متغير ع = جديد عنصر_ويب("img", معرف)
    ع.عيّن_خاصية("src", مصدر)
    ع.عيّن_خاصية("alt", بديل)
    ارجع ع
نهاية

صدّر دالة رابط(نص, عنوان_ر, معرف = لاشيء)
    متغير ع = جديد عنصر_ويب("a", معرف)
    ع.عيّن_نص(نص)
    ع.عيّن_خاصية("href", عنوان_ر)
    ارجع ع
نهاية

صدّر دالة قائمة_مرتبة(عناصر, معرف = لاشيء)
    متغير ق = جديد عنصر_ويب("ol", معرف)
    لكل عنصر في عناصر
        متغير ع = جديد عنصر_ويب("li")
        ع.عيّن_نص(عنصر)
        ق.أضف_طفل(ع)
    نهاية
    ارجع ق
نهاية

صدّر دالة قائمة_غير_مرتبة(عناصر, معرف = لاشيء)
    متغير ق = جديد عنصر_ويب("ul", معرف)
    لكل عنصر في عناصر
        متغير ع = جديد عنصر_ويب("li")
        ع.عيّن_نص(عنصر)
        ق.أضف_طفل(ع)
    نهاية
    ارجع ق
نهاية

# ─── جدول HTML ───
صدّر دالة جدول_ويب(رؤوس, صفوف, معرف = لاشيء)
    متغير ج = جديد عنصر_ويب("table", معرف)

    # رأس الجدول
    متغير رأس = جديد عنصر_ويب("thead")
    متغير صف_رأس = جديد عنصر_ويب("tr")
    لكل ر في رؤوس
        متغير خلية = جديد عنصر_ويب("th")
        خلية.عيّن_نص(ر)
        صف_رأس.أضف_طفل(خلية)
    نهاية
    رأس.أضف_طفل(صف_رأس)
    ج.أضف_طفل(رأس)

    # جسم الجدول
    متغير جسم = جديد عنصر_ويب("tbody")
    لكل صف في صفوف
        متغير صف_ج = جديد عنصر_ويب("tr")
        لكل خلية_ق في صف
            متغير خلية = جديد عنصر_ويب("td")
            خلية.عيّن_نص(خلية_ق)
            صف_ج.أضف_طفل(خلية)
        نهاية
        جسم.أضف_طفل(صف_ج)
    نهاية
    ج.أضف_طفل(جسم)

    ارجع ج
نهاية
