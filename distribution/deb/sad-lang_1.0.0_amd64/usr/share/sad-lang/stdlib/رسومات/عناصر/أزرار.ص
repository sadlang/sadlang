# ===================================================================
#                    زر_تقسيم: SegmentedButton
# ===================================================================
صدّر صنف زر_تقسيم يرث عنصر
    باني(شرائح = لاشيء, المحدد = لاشيء, عند_التغيير = لاشيء, متعدد = خطأ, لون_محدد = لاشيء)
