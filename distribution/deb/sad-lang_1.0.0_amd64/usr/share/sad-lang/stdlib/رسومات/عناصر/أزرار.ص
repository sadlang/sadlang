        هذا._خصائص["أيقونة"] = أيقونة
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    # ─── دوال الوصول ───

    دالة احصل_النص()
        ارجع هذا._خصائص["نص"]
    نهاية

    دالة احصل_الخلفية()
        ارجع هذا._خصائص["لون_خلفية"]
    نهاية

    دالة احصل_لون_النص()
        ارجع هذا._خصائص["لون_نص"]
    نهاية

    دالة احصل_الأيقونة()
        ارجع هذا._خصائص["أيقونة"]
    نهاية

    # ─── دوال التعديل ───

    دالة عيّن_النص(قيمة)
        هذا._خصائص["نص"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_الخلفية(لون)
        هذا._خصائص["لون_خلفية"] = لون
        ارجع هذا
    نهاية

    دالة عيّن_لون_النص(لون)
        هذا._خصائص["لون_نص"] = لون
        ارجع هذا
    نهاية

    دالة عيّن_عند_الضغط(دالة_ضغط)
        هذا._خصائص["عند_الضغط"] = دالة_ضغط
        ارجع هذا
    نهاية

    دالة عيّن_الأيقونة(أيقونة)
        هذا._خصائص["أيقونة"] = أيقونة
        ارجع هذا
    نهاية

    دالة عيّن_حجم_الخط(حجم)
        هذا._خصائص["حجم_الخط"] = حجم
        ارجع هذا
    نهاية

    دالة عيّن_الزوايا(قيمة)
        هذا._خصائص["زوايا"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_الظل(قيمة)
        هذا._خصائص["ظل"] = قيمة
        ارجع هذا
    نهاية
نهاية

