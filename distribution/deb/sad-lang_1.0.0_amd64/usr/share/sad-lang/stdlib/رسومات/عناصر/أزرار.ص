        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["معطل"] = معطل
        هذا._خصائص["حشو"] = حشو
        هذا._خصائص["هامش"] = هامش
