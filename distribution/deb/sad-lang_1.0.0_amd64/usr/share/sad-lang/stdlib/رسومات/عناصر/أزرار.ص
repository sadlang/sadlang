        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["متعدد"] = متعدد
        هذا._خصائص["لون_محدد"] = لون_محدد
    نهاية

    دالة حدد(فهرس)
        إذا (هذا._خصائص["متعدد"])
            متغير محددة = هذا._خصائص["المحدد"]
            إذا (محددة == لاشيء)
                محددة = []
            نهاية
            محددة = محددة + [فهرس]
            هذا._خصائص["المحدد"] = محددة
        وإلا
            هذا._خصائص["المحدد"] = فهرس
        نهاية
        ارجع هذا
    نهاية

    دالة احصل_المحدد()
        ارجع هذا._خصائص["المحدد"]
    نهاية
