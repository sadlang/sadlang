# ─── عنصر_موروث (InheritedWidget) ─── [نظام 40]
صدّر صنف عنصر_موروث يرث عنصر
    باني(ابن = لاشيء)
        هذا._نوع = "عنصر_موروث"
        هذا._خصائص = {}
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية

    دالة يجب_إعلام_المعتمدين(عنصر_موروث_قديم)
        ارجع صحيح
    نهاية
نهاية

