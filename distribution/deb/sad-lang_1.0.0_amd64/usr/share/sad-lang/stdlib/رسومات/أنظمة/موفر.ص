# ─── موفّر (Provider) ─── [نظام 42]
صدّر صنف موفّر يرث عنصر
    باني(أنشئ, ابن = لاشيء, تخلص = لاشيء)
        هذا._نوع = "موفّر"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["أنشئ"] = أنشئ
        هذا._خصائص["تخلص"] = تخلص
        هذا._قيمة = لاشيء
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية

    ساكن دالة من(سياق)
        ارجع سياق._موفّر_قيمة
    نهاية

    دالة القيمة()
        إذا (هذا._قيمة == لاشيء)
            متغير أنشئ = هذا._خصائص["أنشئ"]
            إذا (أنشئ != لاشيء)
                هذا._قيمة = أنشئ()
            نهاية
        نهاية
        ارجع هذا._قيمة
    نهاية
نهاية

