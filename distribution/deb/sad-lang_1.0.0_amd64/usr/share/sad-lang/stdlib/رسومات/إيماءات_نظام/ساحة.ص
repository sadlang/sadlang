# بسم الله الرحمن الرحيم
# ===================================================================
# ساحة الإيماءات — Gesture Arena
# ===================================================================
#
# (AR) ساحة الإيماءات هي آلية حل التعارضات بين مُعرّفات الإيماءات.
#      عندما يلمس المستخدم الشاشة، قد يتنافس عدة مُعرّفات (نقر، سحب، قرص)
#      على نفس مجموعة الأحداث. الساحة تحدد أي مُعرّف "يفوز" ويحصل
#      على حق معالجة الإيماءة.
#
#      مطابق لـ flutter/gestures/arena.dart
#      و flutter/gestures/team.dart
#
# (EN) The Gesture Arena is a conflict resolution mechanism for gesture
#      recognizers. When the user touches the screen, multiple recognizers
#      may compete for the same set of events. The arena determines which
#      recognizer "wins" and gets to handle the gesture.
#
# الأصناف المُصدّرة:
#   - عضو_ساحة (GestureArenaEntry)   — عضو واحد في الساحة
#   - ساحة_إيماءات (GestureArena)     — ساحة واحدة لمؤشر واحد
#   - مدير_ساحة (GestureArenaManager) — مدير جميع الساحات
#   - فريق_إيماءات (GestureArenaTeam) — مجموعة معرّفات متعاونة
#
# الاستخدام:
#   استورد * من رسومات.إيماءات_نظام.ساحة
# ===================================================================

# ─── حالات الساحة ───
ثابت حالة_ساحة_مفتوحة = "مفتوحة"
ثابت حالة_ساحة_مغلقة = "مغلقة"
ثابت حالة_ساحة_محسومة = "محسومة"

# ─── عضو_ساحة (GestureArenaEntry) ───
صدّر صنف عضو_ساحة
    # (AR) يمثل مُعرّف إيماءة واحد مسجّل في ساحة
    #      يمكنه "القبول" (الادّعاء بالفوز) أو "الرفض" (التخلي عن التنافس)
    # (EN) Represents a single gesture recognizer registered in an arena
    باني(ساحة = لاشيء, معرّف = لاشيء, مُعرّف_مؤشر = 0)
        هذا._ساحة = ساحة
        هذا._معرّف = معرّف
        هذا._مُعرّف_مؤشر = مُعرّف_مؤشر
        هذا._محسوم = خطأ
    نهاية

    دالة اقبل()
        # (AR) أعلن القبول — أريد هذه الإيماءة
        إذا (هذا._ساحة != لاشيء)
            هذا._ساحة.اقبل(هذا._مُعرّف_مؤشر, هذا._معرّف)
        نهاية
        هذا._محسوم = صحيح
    نهاية

    دالة ارفض()
        # (AR) أعلن الرفض — لا أريد هذه الإيماءة
        إذا (هذا._ساحة != لاشيء)
            هذا._ساحة.ارفض(هذا._مُعرّف_مؤشر, هذا._معرّف)
        نهاية
        هذا._محسوم = صحيح
    نهاية
نهاية

# ─── ساحة_إيماءات (GestureArena) ───
صدّر صنف ساحة_إيماءات
    # (AR) ساحة واحدة لمؤشر (إصبع) واحد
    #      تحتوي على قائمة المتنافسين وتحسم الفائز
    # (EN) Single arena for one pointer (finger)
    باني()
        هذا._أعضاء = []
        هذا._حالة = حالة_ساحة_مفتوحة
        هذا._فائز = لاشيء
        هذا._مقبولون = []
        هذا._مرفوضون = []
    نهاية

    دالة أضف(معرّف)
        هذا._أعضاء = هذا._أعضاء + [معرّف]
    نهاية

    دالة اقبل(معرّف)
        # (AR) معرّف يعلن القبول — إذا لم يكن هناك فائز بعد، يفوز هذا
        إذا (هذا._فائز == لاشيء)
            هذا._فائز = معرّف
            هذا._حالة = حالة_ساحة_محسومة
            # أبلغ البقية بالرفض
            لكل عضو في هذا._أعضاء
                إذا (عضو != معرّف)
                    هذا._مرفوضون = هذا._مرفوضون + [عضو]
                نهاية
            نهاية
        نهاية
        هذا._مقبولون = هذا._مقبولون + [معرّف]
    نهاية

    دالة ارفض(معرّف)
        # (AR) معرّف يعلن الرفض — يخرج من المنافسة
        هذا._مرفوضون = هذا._مرفوضون + [معرّف]
        # إذا بقي واحد فقط، يفوز تلقائياً
        متغير المتبقون = []
        لكل عضو في هذا._أعضاء
            متغير مرفوض = خطأ
            لكل م في هذا._مرفوضون
                إذا (م == عضو)
                    مرفوض = صحيح
                نهاية
            نهاية
            إذا (مرفوض == خطأ)
                المتبقون = المتبقون + [عضو]
            نهاية
        نهاية
        إذا (المتبقون.طول() == 1)
            هذا._فائز = المتبقون[0]
            هذا._حالة = حالة_ساحة_محسومة
        نهاية
    نهاية

    دالة أغلق()
        # (AR) إغلاق الساحة — لا يمكن إضافة أعضاء جدد
        #      إذا لم يُحسم الفائز بعد، يفوز الأول
        هذا._حالة = حالة_ساحة_مغلقة
        إذا (هذا._فائز == لاشيء)
            إذا (هذا._أعضاء.طول() > 0)
                هذا._فائز = هذا._أعضاء[0]
                هذا._حالة = حالة_ساحة_محسومة
            نهاية
        نهاية
    نهاية

    دالة الفائز()
        ارجع هذا._فائز
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    دالة عدد_الأعضاء()
        ارجع هذا._أعضاء.طول()
    نهاية
نهاية

# ─── مدير_ساحة (GestureArenaManager) ───
صدّر صنف مدير_ساحة
    # (AR) يدير جميع ساحات الإيماءات — ساحة واحدة لكل مؤشر نشط
    #      المؤشر = إصبع على الشاشة أو نقرة فأرة
    # (EN) Manages all gesture arenas — one arena per active pointer
    باني()
        هذا._ساحات = {}
    نهاية

    دالة أضف(ملمس, معرّف)
        # (AR) إضافة معرّف إيماءة لساحة ملمس معين
        إذا (هذا._ساحات[ملمس] == لاشيء)
            هذا._ساحات[ملمس] = جديد ساحة_إيماءات()
        نهاية
        هذا._ساحات[ملمس].أضف(معرّف)
        ارجع جديد عضو_ساحة(هذا, معرّف, ملمس)
    نهاية

    دالة اقبل(ملمس, معرّف)
        إذا (هذا._ساحات[ملمس] != لاشيء)
            هذا._ساحات[ملمس].اقبل(معرّف)
        نهاية
    نهاية

    دالة ارفض(ملمس, معرّف)
        إذا (هذا._ساحات[ملمس] != لاشيء)
            هذا._ساحات[ملمس].ارفض(معرّف)
        نهاية
    نهاية

    دالة أغلق(ملمس)
        # (AR) إغلاق ساحة ملمس — يُستدعى عند رفع الإصبع
        إذا (هذا._ساحات[ملمس] != لاشيء)
            هذا._ساحات[ملمس].أغلق()
        نهاية
    نهاية

    دالة نظّف(ملمس)
        # (AR) إزالة ساحة ملمس بعد الانتهاء
        هذا._ساحات[ملمس] = لاشيء
    نهاية

    دالة الفائز(ملمس)
        إذا (هذا._ساحات[ملمس] != لاشيء)
            ارجع هذا._ساحات[ملمس].الفائز()
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ─── فريق_إيماءات (GestureArenaTeam) ───
صدّر صنف فريق_إيماءات
    # (AR) مجموعة من مُعرّفات الإيماءات تعمل كفريق واحد
    #      إذا فاز أي عضو في الفريق، يمكن للقائد التحكم بالنتيجة
    #      مفيد عندما يكون لديك عدة إيماءات متعاونة
    # (EN) A team of gesture recognizers that cooperate together
    باني()
        هذا._أعضاء = []
        هذا._قائد = لاشيء
    نهاية

    دالة أضف(معرّف)
        هذا._أعضاء = هذا._أعضاء + [معرّف]
    نهاية

    دالة القائد()
        ارجع هذا._قائد
    نهاية

    دالة عيّن_قائد(معرّف)
        هذا._قائد = معرّف
    نهاية

    دالة عدد_الأعضاء()
        ارجع هذا._أعضاء.طول()
    نهاية
نهاية
