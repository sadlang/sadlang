# العيب #242: KeyboardNavigation - تنقل لوحة المفاتيح
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف مدير_تركيز
    ساكن متغير _مثيل = لاشيء
    
    ساكن دالة احصل_مثيل()
        إذا (مدير_تركيز._مثيل == لاشيء)
            مدير_تركيز._مثيل = جديد مدير_تركيز()
        نهاية
        ارجع مدير_تركيز._مثيل
    نهاية

    باني()
        هذا._مناطق_تركيز = []
        هذا._فهرس_حالي = -1
        هذا._محبوسون = []  # مصيدة التركيز
    نهاية

    دالة سجّل_منطقة(عنصر، ترتيب)
        هذا._مناطق_تركيز.أضف({عنصر: عنصر، ترتيب: ترتيب أو 0})
        هذا._رتّب()
    نهاية

    دالة ألغِ_تسجيل(عنصر)
        هذا._مناطق_تركيز = هذا._مناطق_تركيز.فلتر(
            لامدا(م) => م.عنصر != عنصر نهاية
        )
    نهاية

    دالة التالي()
        إذا (هذا._مناطق_تركيز.الطول() == 0)
            ارجع
        نهاية
        
        هذا._فهرس_حالي += 1
        إذا (هذا._فهرس_حالي >= هذا._مناطق_تركيز.الطول())
            هذا._فهرس_حالي = 0
        نهاية
        
        هذا._طبّق_تركيز()
    نهاية

    دالة السابق()
        إذا (هذا._مناطق_تركيز.الطول() == 0)
            ارجع
        نهاية
        
        هذا._فهرس_حالي -= 1
        إذا (هذا._فهرس_حالي < 0)
            هذا._فهرس_حالي = هذا._مناطق_تركيز.الطول() - 1
        نهاية
        
        هذا._طبّق_تركيز()
    نهاية

    دالة احبس_تركيز(حاوية)
        هذا._محبوسون.أضف(حاوية)
    نهاية

    دالة أطلق_تركيز()
        هذا._محبوسون.احذف_آخر()
    نهاية

    دالة _رتّب()
        هذا._مناطق_تركيز.رتّب(لامدا(أ، ب) => أ.ترتيب - ب.ترتيب نهاية)
    نهاية

    دالة _طبّق_تركيز()
        متغير منطقة = هذا._مناطق_تركيز[هذا._فهرس_حالي]
        إذا (منطقة و منطقة.عنصر)
            # تطبيق التركيز
        نهاية
    نهاية
نهاية

صدّر صنف قابل_للتركيز
