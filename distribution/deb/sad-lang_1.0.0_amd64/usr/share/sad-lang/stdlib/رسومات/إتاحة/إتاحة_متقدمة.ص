# #244: Text Scaling - تكبير النص
صدّر صنف إعدادات_نص
    ساكن متغير _مقياس = 1
    ساكن متغير _مستمعون = []
    
    ساكن دالة عيّن_مقياس(مقياس)
        إعدادات_نص._مقياس = مقياس.ثبّت(0.5، 3)
        إعدادات_نص._أخطر()
    نهاية

    ساكن دالة احصل_مقياس()
        ارجع إعدادات_نص._مقياس
    نهاية

    ساكن دالة كبّر()
        إعدادات_نص.عيّن_مقياس(إعدادات_نص._مقياس + 0.1)
    نهاية

    ساكن دالة صغّر()
        إعدادات_نص.عيّن_مقياس(إعدادات_نص._مقياس - 0.1)
    نهاية

    ساكن دالة استعد_افتراضي()
        إعدادات_نص.عيّن_مقياس(1)
    نهاية

    ساكن دالة راقب(مستمع)
        إعدادات_نص._مستمعون.أضف(مستمع)
    نهاية

    ساكن دالة _أخطر()
        لكل مستمع في إعدادات_نص._مستمعون
            مستمع(إعدادات_نص._مقياس)
        نهاية
    نهاية
نهاية

