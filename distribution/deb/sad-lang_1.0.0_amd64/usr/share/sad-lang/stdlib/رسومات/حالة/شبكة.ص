# ===================================================================
# عميل HTTP متقدم — HTTP Client
# ===================================================================
# طلبات شبكة مبسطة مع ذاكرة مؤقتة ومعالجة أخطاء
#
# الاستخدام:
#   استورد * من رسومات.حالة.شبكة
# ===================================================================

# ─── استجابة (Response) ───
صدّر صنف استجابة
    باني(حالة, جسم, رؤوس)
        هذا.الحالة = حالة
        هذا.الجسم = جسم
        هذا.الرؤوس = رؤوس
    نهاية

    دالة نجح()
        ارجع هذا.الحالة >= 200 و هذا.الحالة < 300
    نهاية

    دالة جيسون()
        ارجع حلل_جيسون(هذا.الجسم)
    نهاية
نهاية

# ─── عميل_شبكة (HttpClient) ───
صدّر صنف عميل_شبكة
    باني(رابط_أساسي)
        هذا._أساسي = رابط_أساسي
        هذا._رؤوس_افتراضية = {}
        هذا._مهلة = 30000
        هذا._اعتراضات_قبل = []
        هذا._اعتراضات_بعد = []
    نهاية

    دالة رأس(مفتاح, قيمة)
        هذا._رؤوس_افتراضية[مفتاح] = قيمة
        ارجع هذا
    نهاية

    دالة مهلة(مدة)
        هذا._مهلة = مدة
        ارجع هذا
    نهاية

    دالة اعتراض_قبل(دالة_اعتراض)
        هذا._اعتراضات_قبل.أضف(دالة_اعتراض)
        ارجع هذا
    نهاية

    دالة اعتراض_بعد(دالة_اعتراض)
        هذا._اعتراضات_بعد.أضف(دالة_اعتراض)
        ارجع هذا
    نهاية

    دالة _رابط(مسار)
        إذا (هذا._أساسي != لاشيء)
            ارجع هذا._أساسي + مسار
        نهاية
        ارجع مسار
    نهاية

    دالة _نفذ(طريقة, مسار, جسم, رؤوس)
        متغير إعدادات = {
            "طريقة": طريقة,
            "رابط": هذا._رابط(مسار),
            "جسم": جسم,
            "رؤوس": رؤوس
        }

        # تطبيق اعتراضات ما قبل
        لكل اعتراض في هذا._اعتراضات_قبل
            إعدادات = اعتراض(إعدادات)
        نهاية

        متغير نتيجة = طلب_شبكة(إعدادات["رابط"], إعدادات["طريقة"], إعدادات["جسم"])
        متغير استجابة_ش = جديد استجابة(200, نتيجة, {})

        # تطبيق اعتراضات ما بعد
        لكل اعتراض في هذا._اعتراضات_بعد
            استجابة_ش = اعتراض(استجابة_ش)
        نهاية

        ارجع استجابة_ش
    نهاية

    دالة احصل(مسار, رؤوس)
        ارجع هذا._نفذ("GET", مسار, لاشيء, رؤوس)
    نهاية

    دالة أرسل(مسار, جسم, رؤوس)
        ارجع هذا._نفذ("POST", مسار, جسم, رؤوس)
    نهاية

    دالة حدّث(مسار, جسم, رؤوس)
        ارجع هذا._نفذ("PUT", مسار, جسم, رؤوس)
    نهاية

    دالة احذف(مسار, رؤوس)
        ارجع هذا._نفذ("DELETE", مسار, لاشيء, رؤوس)
    نهاية
نهاية

# ─── مساعدات ───
صدّر دالة عميل(رابط_أساسي)
    ارجع جديد عميل_شبكة(رابط_أساسي)
نهاية
