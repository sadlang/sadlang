# ===================================================================
# خدمة الوصولية — Accessibility Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/وصولية.ص
# ===================================================================
# مكتبة وصولية شاملة تدعم:
#   - قارئ الشاشة (Screen Reader)
#   - إعلانات صوتية
#   - حجم الخط
#   - تباين عالي
#   - تقليل الحركة
#   - التنقل بلوحة المفاتيح
#
# المنصات المدعومة:
#   ✅ سطح المكتب (MSAA / NSAccessibility / ATK)
#   ✅ النواة (غير مدعوم)
#   ✅ الويب (ARIA / Screen Reader API)
#   ✅ أندرويد (AccessibilityService / TalkBack)
#   ✅ iOS (VoiceOver / UIAccessibility)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#       مدير_وصولية — Accessibility Manager
# ===================================================================

صدّر صنف مدير_وصولية
    باني()
        # لا تهيئة مطلوبة
    نهاية

    ## إعلان نص لقارئ الشاشة
    دالة أعلن(نص, أولوية = "عادية")
        حاول
            اقرأ_شاشة(نص)
        امسك خ
            # تجاهل
        نهاية
    نهاية

    ## حجم خط النظام (1.0 = عادي)
    دالة حجم_الخط()
        حاول
            ارجع حجم_خط_النظام()
        امسك خ
            ارجع 1.0
        نهاية
    نهاية

    ## هل قارئ الشاشة مفعل؟
    دالة قارئ_مفعل()
        حاول
            ارجع هل_قارئ_شاشة()
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## هل تقليل الحركة مطلوب؟
    دالة تقليل_حركة()
        حاول
            ارجع هل_تقليل_حركة()
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## هل التباين العالي مطلوب؟
    دالة تباين_عالي()
        حاول
            ارجع هل_تباين_عالي()
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## هل النص الغامق مطلوب؟
    دالة نص_غامق()
        حاول
            ارجع هل_نص_غامق()
        امسك خ
            ارجع خطأ
        نهاية
    نهاية

    ## ملخص إعدادات الوصولية
    دالة ملخص()
        ارجع {
            حجم_خط: هذا.حجم_الخط(),
            قارئ_شاشة: هذا.قارئ_مفعل(),
            تقليل_حركة: هذا.تقليل_حركة(),
            تباين_عالي: هذا.تباين_عالي()
        }
    نهاية
نهاية

