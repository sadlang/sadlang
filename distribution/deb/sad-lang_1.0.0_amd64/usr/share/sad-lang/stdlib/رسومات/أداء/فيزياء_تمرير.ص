# ─── محاكي الفيزياء ───
صدّر صنف محاكي_فيزياء
    باني()
        هذا._موضع = 0
        هذا._سرعة = 0
        هذا._احتكاك = 0.015
        هذا._حد_أدنى = 0
        هذا._حد_أقصى = 1000
        هذا._مرونة = 0.5
    نهاية

    دالة عيّن_حدود(أدنى، أقصى)
        هذا._حد_أدنى = أدنى
        هذا._حد_أقصى = أقصى
    نهاية

    دالة طبّق_قوة(قوة)
        هذا._سرعة += قوة
    نهاية

    دالة حدّث(دلتا_ثانية)
        # طبّق الاحتكاك
        هذا._سرعة *= (1 - هذا._احتكاك)
        
        # حدّث الموضع
        هذا._موضع += هذا._سرعة * دلتا_ثانية * 60
        
        # تحقق من الحدود مع الارتداد
        إذا (هذا._موضع < هذا._حد_أدنى)
            هذا._موضع = هذا._حد_أدنى
            هذا._سرعة *= -هذا._مرونة
        وإلا إذا (هذا._موضع > هذا._حد_أقصى)
            هذا._موضع = هذا._حد_أقصى
            هذا._سرعة *= -هذا._مرونة
        نهاية
        
        # أوقف إذا كانت السرعة منخفضة جداً
        إذا (مطلق(هذا._سرعة) < 0.1)
            هذا._سرعة = 0
        نهاية
        
        ارجع هذا._موضع
    نهاية

    دالة نشط()
        ارجع مطلق(هذا._سرعة) > 0.1
    نهاية

    دالة أوقف()
        هذا._سرعة = 0
    نهاية
نهاية

# ─── فيزياء التمرير ───
صدّر صنف فيزياء_تمرير
    باني(نوع)
        طابق (نوع)
            عندما "iOS":
                هذا._احتكاك = 0.015
                هذا._مرونة = 0.55
                هذا._تجاوز_مسموح = صحيح
                هذا._حد_تجاوز = 100
            عندما "Android":
                هذا._احتكاك = 0.02
                هذا._مرونة = 0
                هذا._تجاوز_مسموح = صحيح
                هذا._حد_تجاوز = 50
            عندما "Windows":
                هذا._احتكاك = 0.025
                هذا._مرونة = 0
                هذا._تجاوز_مسموح = خطأ
                هذا._حد_تجاوز = 0
            افتراضي:
                هذا._احتكاك = 0.02
                هذا._مرونة = 0.3
                هذا._تجاوز_مسموح = صحيح
                هذا._حد_تجاوز = 75
        نهاية
        
        هذا._موضع = 0
        هذا._سرعة = 0
        هذا._حد_أدنى = 0
        هذا._حد_أقصى = 0
        هذا._في_تجاوز = خطأ
    نهاية

    دالة عيّن_حدود(أدنى، أقصى)
        هذا._حد_أدنى = أدنى
        هذا._حد_أقصى = أقصى
    نهاية

    دالة بدء_سحب(موضع)
        هذا._سرعة = 0
        هذا._موضع_سحب_سابق = موضع
    نهاية

    دالة تحديث_سحب(موضع)
        متغير دلتا = موضع - هذا._موضع_سحب_سابق
        هذا._موضع_سحب_سابق = موضع
        
        # إذا كنا خارج الحدود، طبّق مقاومة
        إذا (هذا._تجاوز_مسموح)
            إذا (هذا._موضع < هذا._حد_أدنى أو هذا._موضع > هذا._حد_أقصى)
                دلتا *= 0.5  # مقاومة 50%
            نهاية
        نهاية
        
        هذا._موضع += دلتا
        
        # قيّد التجاوز
        إذا (ليس هذا._تجاوز_مسموح)
            هذا._موضع = محصور(هذا._موضع، هذا._حد_أدنى، هذا._حد_أقصى)
        وإلا
            هذا._موضع = محصور(هذا._موضع، هذا._حد_أدنى - هذا._حد_تجاوز، هذا._حد_أقصى + هذا._حد_تجاوز)
        نهاية
        
        ارجع هذا._موضع
    نهاية

    دالة إنهاء_سحب(سرعة)
        هذا._سرعة = سرعة
    نهاية

    دالة حدّث(دلتا)
        # تحقق إذا كنا في منطقة التجاوز
        إذا (هذا._موضع < هذا._حد_أدنى)
            هذا._في_تجاوز = صحيح
            # ارجع للحد
            هذا._موضع += (هذا._حد_أدنى - هذا._موضع) * 0.1
            إذا (مطلق(هذا._موضع - هذا._حد_أدنى) < 0.5)
                هذا._موضع = هذا._حد_أدنى
                هذا._في_تجاوز = خطأ
            نهاية
            هذا._سرعة = 0
        وإلا إذا (هذا._موضع > هذا._حد_أقصى)
            هذا._في_تجاوز = صحيح
            # ارجع للحد
            هذا._موضع += (هذا._حد_أقصى - هذا._موضع) * 0.1
            إذا (مطلق(هذا._موضع - هذا._حد_أقصى) < 0.5)
                هذا._موضع = هذا._حد_أقصى
                هذا._في_تجاوز = خطأ
            نهاية
            هذا._سرعة = 0
        وإلا
            هذا._في_تجاوز = خطأ
            # طبّق الفيزياء العادية
            هذا._سرعة *= (1 - هذا._احتكاك)
            هذا._موضع += هذا._سرعة * دلتا
            
            # أوقف عند سرعة منخفضة
            إذا (مطلق(هذا._سرعة) < 0.5)
                هذا._سرعة = 0
            نهاية
        نهاية
        
        ارجع هذا._موضع
    نهاية

    دالة نشط()
        ارجع مطلق(هذا._سرعة) > 0.5 أو هذا._في_تجاوز
    نهاية

    دالة الموضع()
        ارجع هذا._موضع
    نهاية
نهاية

# ─── وحدة تحكم التمرير ───
صدّر صنف متحكم_تمرير
    باني(إعدادات)
        هذا._فيزياء = جديد فيزياء_تمرير(إعدادات.نوع أو "افتراضي")
        هذا._اتجاه = إعدادات.اتجاه أو "عمودي"
        هذا._عند_تمرير = إعدادات.عند_تمرير أو لاشيء
        هذا._جاري_سحب = خطأ
        هذا._نقاط_سرعة = []
    نهاية

    دالة عيّن_محتوى(حجم_محتوى، حجم_حاوية)
        متغير أقصى = ماكس(0، حجم_محتوى - حجم_حاوية)
        هذا._فيزياء.عيّن_حدود(0، أقصى)
    نهاية

    دالة عند_بداية_لمس(موضع)
        هذا._جاري_سحب = صحيح
        متغير قيمة = هذا._اتجاه == "عمودي" ? موضع.ص : موضع.س
        هذا._فيزياء.بدء_سحب(قيمة)
        هذا._نقاط_سرعة = [{موضع: قيمة، وقت: الآن()}]
    نهاية

    دالة عند_تحريك_لمس(موضع)
        إذا (ليس هذا._جاري_سحب)
            ارجع
        نهاية
        
        متغير قيمة = هذا._اتجاه == "عمودي" ? موضع.ص : موضع.س
        متغير موضع_جديد = هذا._فيزياء.تحديث_سحب(قيمة)
        
        # سجّل للسرعة
        هذا._نقاط_سرعة.أضف({موضع: قيمة، وقت: الآن()})
        إذا (هذا._نقاط_سرعة.الطول() > 10)
            هذا._نقاط_سرعة = هذا._نقاط_سرعة[-10:]
        نهاية
        
        إذا (هذا._عند_تمرير != لاشيء)
            هذا._عند_تمرير(موضع_جديد)
        نهاية
    نهاية

    دالة عند_نهاية_لمس()
        إذا (ليس هذا._جاري_سحب)
            ارجع
        نهاية
        
        هذا._جاري_سحب = خطأ
        
        # احسب السرعة من آخر نقاط
        متغير سرعة = هذا._احسب_سرعة()
        هذا._فيزياء.إنهاء_سحب(سرعة)
        
        # ابدأ حلقة التحديث
        هذا._ابدأ_تحديث()
    نهاية

    دالة _احسب_سرعة()
        إذا (هذا._نقاط_سرعة.الطول() < 2)
            ارجع 0
        نهاية
        
        متغير أولى = هذا._نقاط_سرعة[0]
        متغير أخيرة = هذا._نقاط_سرعة[-1]
        
        متغير فرق_موضع = أخيرة.موضع - أولى.موضع
        متغير فرق_وقت = (أخيرة.وقت - أولى.وقت) / 1000  # بالثواني
        
        إذا (فرق_وقت > 0)
            ارجع فرق_موضع / فرق_وقت * 0.1
        نهاية
        
        ارجع 0
    نهاية

    دالة _ابدأ_تحديث()
        إذا (هذا._فيزياء.نشط())
            متغير موضع = هذا._فيزياء.حدّث(16.67)  # ~60fps
            
            إذا (هذا._عند_تمرير != لاشيء)
                هذا._عند_تمرير(موضع)
            نهاية
            
            # جدول الإطار التالي
            طلب_إطار(لامدا() => هذا._ابدأ_تحديث())
        نهاية
    نهاية

    دالة مرر_إلى(موضع، متحرك)
        إذا (متحرك)
            # حركة سلسة
            # TODO: تنفيذ الحركة
        وإلا
            هذا._فيزياء._موضع = موضع
            إذا (هذا._عند_تمرير != لاشيء)
                هذا._عند_تمرير(موضع)
            نهاية
        نهاية
    نهاية
نهاية
