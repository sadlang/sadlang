# ─── حالة النموذج (FormState) ───
صدّر صنف حالة_نموذج
    باني()
        هذا._حقول = []
        هذا._وضع_التحقق_التلقائي = "معطل"
    نهاية

    دالة سجّل_حقل(حقل)
        هذا._حقول.أضف(حقل)
    نهاية

    دالة ألغِ_تسجيل_حقل(حقل)
        هذا._حقول.أزل(حقل)
    نهاية

    دالة تحقق()
        متغير صالح = صحيح
        لكل حقل في هذا._حقول
            إذا (ليس حقل.تحقق())
                صالح = خطأ
            نهاية
        نهاية
        ارجع صالح
    نهاية

    دالة احفظ()
        لكل حقل في هذا._حقول
            حقل.احفظ()
        نهاية
    نهاية

    دالة أعد_التعيين()
        لكل حقل في هذا._حقول
            حقل.أعد_التعيين()
        نهاية
    نهاية
نهاية

# ─── عنصر النموذج (Form Widget) ───
صدّر صنف نموذج يرث عنصر
    باني(
        ابن،
        مفتاح = لاشيء،
        وضع_التحقق_التلقائي = "معطل"،
        عند_التغيير = لاشيء
    )
        هذا._نوع = "نموذج"
        هذا._ابن = ابن
        هذا._مفتاح = مفتاح
        هذا._وضع_التحقق = وضع_التحقق_التلقائي
        هذا._عند_التغيير = عند_التغيير
        هذا._حالة = جديد حالة_نموذج()
        هذا._حالة._وضع_التحقق_التلقائي = وضع_التحقق_التلقائي
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية

    ساكن دالة من(سياق)
        متغير حالي = سياق
        بينما (حالي != لاشيء)
            إذا (حالي.النوع() == "نموذج")
                ارجع حالي.الحالة()
            نهاية
            حالي = حالي.الأب()
        نهاية
        ارجع لاشيء
    نهاية
نهاية

# ─── حقل نص النموذج (TextFormField) ───
صدّر صنف حقل_نص_نموذج يرث عنصر
    باني(
        متحكم = لاشيء،
        قيمة_ابتدائية = ""،
        مُصدِّق = لاشيء،
        عند_الحفظ = لاشيء،
        عند_التغيير = لاشيء،
        عند_التحقق = لاشيء،
        وضع_التحقق_التلقائي = لاشيء،
        تسمية = ""،
        تلميح = ""،
        نص_خطأ = لاشيء،
        بادئة = لاشيء،
        لاحقة = لاشيء،
        أقصى_طول = لاشيء،
        أسطر = 1،
        نوع_لوحة_المفاتيح = "نص"،
        إخفاء_النص = خطأ،
        مفعّل = صحيح،
        للقراءة_فقط = خطأ
    )
        هذا._نوع = "حقل_نص_نموذج"
        هذا._متحكم = متحكم
        هذا._قيمة = قيمة_ابتدائية
        هذا._قيمة_ابتدائية = قيمة_ابتدائية
        هذا._مُصدِّق = مُصدِّق
        هذا._عند_الحفظ = عند_الحفظ
        هذا._عند_التغيير = عند_التغيير
        هذا._عند_التحقق = عند_التحقق
        هذا._وضع_التحقق = وضع_التحقق_التلقائي
        
        # التزيين
        هذا._تسمية = تسمية
        هذا._تلميح = تلميح
        هذا._نص_خطأ = نص_خطأ
        هذا._بادئة = بادئة
        هذا._لاحقة = لاحقة
        
        # القيود
        هذا._أقصى_طول = أقصى_طول
        هذا._أسطر = أسطر
        هذا._نوع_لوحة = نوع_لوحة_المفاتيح
        هذا._إخفاء = إخفاء_النص
        هذا._مفعّل = مفعّل
        هذا._للقراءة = للقراءة_فقط
        
        # حالة التحقق
        هذا._خطأ_حالي = لاشيء
    نهاية

    دالة القيمة()
        إذا (هذا._متحكم != لاشيء)
            ارجع هذا._متحكم.النص()
        نهاية
        ارجع هذا._قيمة
    نهاية

    دالة تحقق()
        إذا (هذا._مُصدِّق == لاشيء)
            ارجع صحيح
        نهاية
        
        هذا._خطأ_حالي = هذا._مُصدِّق(هذا.القيمة())
        
        إذا (هذا._عند_التحقق != لاشيء)
            هذا._عند_التحقق(هذا._خطأ_حالي == لاشيء)
        نهاية
        
        ارجع هذا._خطأ_حالي == لاشيء
    نهاية

    دالة احفظ()
        إذا (هذا._عند_الحفظ != لاشيء)
            هذا._عند_الحفظ(هذا.القيمة())
        نهاية
    نهاية

    دالة أعد_التعيين()
        هذا._قيمة = هذا._قيمة_ابتدائية
        هذا._خطأ_حالي = لاشيء
        إذا (هذا._متحكم != لاشيء)
            هذا._متحكم.النص(هذا._قيمة_ابتدائية)
        نهاية
    نهاية

    دالة الخطأ()
        ارجع هذا._خطأ_حالي
    نهاية
نهاية

# ─── مُصدِّقات شائعة ───
صدّر صنف مُصدِّقات
    # التحقق من عدم الفراغ
    ساكن دالة مطلوب(رسالة = "هذا الحقل مطلوب")
        ارجع لامدا(قيمة):
            إذا (قيمة == لاشيء أو قيمة == "")
                ارجع رسالة
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # التحقق من البريد الإلكتروني
    ساكن دالة بريد_إلكتروني(رسالة = "بريد إلكتروني غير صالح")
        ارجع لامدا(قيمة):
            إذا (قيمة == لاشيء أو قيمة == "")
                ارجع لاشيء
            نهاية
            # نمط بسيط للبريد
            إذا (ليس قيمة.يحتوي("@") أو ليس قيمة.يحتوي("."))
                ارجع رسالة
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # التحقق من الحد الأدنى للطول
    ساكن دالة حد_أدنى(طول، رسالة = لاشيء)
        ارجع لامدا(قيمة):
            إذا (قيمة == لاشيء)
                ارجع لاشيء
            نهاية
            إذا (قيمة.الطول() < طول)
                ارجع رسالة أو "يجب أن يكون الحد الأدنى " + نص(طول) + " حرف"
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # التحقق من الحد الأقصى للطول
    ساكن دالة حد_أقصى(طول، رسالة = لاشيء)
        ارجع لامدا(قيمة):
            إذا (قيمة == لاشيء)
                ارجع لاشيء
            نهاية
            إذا (قيمة.الطول() > طول)
                ارجع رسالة أو "يجب ألا يتجاوز " + نص(طول) + " حرف"
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # التحقق من نمط (Regex)
    ساكن دالة نمط(تعبير، رسالة = "القيمة غير صالحة")
        ارجع لامدا(قيمة):
            إذا (قيمة == لاشيء أو قيمة == "")
                ارجع لاشيء
            نهاية
            إذا (ليس قيمة.يطابق(تعبير))
                ارجع رسالة
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # التحقق من رقم
    ساكن دالة رقم(رسالة = "يجب أن يكون رقماً")
        ارجع لامدا(قيمة):
            إذا (قيمة == لاشيء أو قيمة == "")
                ارجع لاشيء
            نهاية
            حاول
                رقم(قيمة)
                ارجع لاشيء
            امسك خ
                ارجع رسالة
            نهاية
        نهاية
    نهاية

    # التحقق من نطاق رقمي
    ساكن دالة نطاق(أدنى، أقصى، رسالة = لاشيء)
        ارجع لامدا(قيمة):
            إذا (قيمة == لاشيء أو قيمة == "")
                ارجع لاشيء
            نهاية
            حاول
                متغير ر = رقم(قيمة)
                إذا (ر < أدنى أو ر > أقصى)
                    ارجع رسالة أو "يجب أن تكون القيمة بين " + نص(أدنى) + " و " + نص(أقصى)
                نهاية
                ارجع لاشيء
            امسك خ
                ارجع "يجب أن يكون رقماً"
            نهاية
        نهاية
    نهاية

    # التحقق من كلمة مرور قوية
    ساكن دالة كلمة_مرور(رسالة = "كلمة المرور ضعيفة")
        ارجع لامدا(قيمة):
            إذا (قيمة == لاشيء أو قيمة == "")
                ارجع لاشيء
            نهاية
            إذا (قيمة.الطول() < 8)
                ارجع "يجب أن تكون 8 أحرف على الأقل"
            نهاية
            # يمكن إضافة تحققات إضافية (أرقام، رموز، إلخ)
            ارجع لاشيء
        نهاية
    نهاية

    # التحقق من تطابق
    ساكن دالة تطابق(حقل_آخر، رسالة = "القيمتان غير متطابقتين")
        ارجع لامدا(قيمة):
            إذا (قيمة != حقل_آخر.القيمة())
                ارجع رسالة
            نهاية
            ارجع لاشيء
        نهاية
    نهاية

    # دمج عدة مُصدِّقات
    ساكن دالة ادمج(قائمة_مُصدِّقات)
        ارجع لامدا(قيمة):
            لكل مُصدِّق في قائمة_مُصدِّقات
                متغير خطأ = مُصدِّق(قيمة)
                إذا (خطأ != لاشيء)
                    ارجع خطأ
                نهاية
            نهاية
            ارجع لاشيء
        نهاية
    نهاية
نهاية

# ─── أوضاع التحقق التلقائي ───
صدّر تعداد وضع_تحقق
    معطل،
    دائماً،
    عند_تفاعل_المستخدم،
    عند_إرسال
نهاية

