# ─── حقل_نص_تفاحة (CupertinoTextField) ───
## حقل إدخال نص بنمط iOS مع زوايا مستديرة وخلفية رمادية
صدّر صنف حقل_نص_تفاحة يرث عنصر
    باني(متحكم = لاشيء, نص_تلميح = لاشيء, بادئة = لاشيء, لاحقة = لاشيء, عند_التغيير = لاشيء)
        هذا._نوع = "حقل_نص_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["متحكم"] = متحكم
        هذا._خصائص["نص_تلميح"] = نص_تلميح
        هذا._خصائص["بادئة"] = بادئة
        هذا._خصائص["لاحقة"] = لاحقة
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["نوع_لوحة"] = "نص"
        هذا._خصائص["للقراءة_فقط"] = خطأ
        هذا._خصائص["معطل"] = خطأ
        هذا._خصائص["حجم_خط"] = 17
        هذا._خصائص["لون_نص"] = لاشيء
        هذا._خصائص["لون_خلفية"] = "#F2F2F7"
        هذا._خصائص["نصف_قطر"] = 8
        هذا._خصائص["حشوة"] = {"أفقي": 12, "عمودي": 10}
        هذا._خصائص["سطور_قصوى"] = 1
        هذا._خصائص["غموض"] = خطأ
        هذا._خصائص["تصحيح_تلقائي"] = صحيح
    نهاية

    دالة غموض(قيمة)
        هذا._خصائص["غموض"] = قيمة
        ارجع هذا
    نهاية

    دالة متعدد_السطور(سطور)
        هذا._خصائص["سطور_قصوى"] = سطور
        ارجع هذا
    نهاية

    دالة نوع_لوحة(نوع)
        هذا._خصائص["نوع_لوحة"] = نوع
        ارجع هذا
    نهاية
نهاية

