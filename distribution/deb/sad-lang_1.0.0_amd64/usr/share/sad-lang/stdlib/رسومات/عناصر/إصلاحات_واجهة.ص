# #32: SnackBar Queue
صدّر صنف مدير_رسائل_سريعة
    ساكن متغير _طابور = []
    ساكن متغير _حالية = لاشيء

    ساكن دالة أظهر(رسالة، مدة)
        مدير_رسائل_سريعة._طابور.أضف({
            رسالة: رسالة،
            مدة: مدة أو 3000
        })
        
        إذا (مدير_رسائل_سريعة._حالية == لاشيء)
            مدير_رسائل_سريعة._أظهر_التالية()
        نهاية
    نهاية

    ساكن دالة _أظهر_التالية()
        إذا (مدير_رسائل_سريعة._طابور.الطول() == 0)
            مدير_رسائل_سريعة._حالية = لاشيء
            ارجع
        نهاية

        مدير_رسائل_سريعة._حالية = مدير_رسائل_سريعة._طابور[0]
        مدير_رسائل_سريعة._طابور = مدير_رسائل_سريعة._طابور[1:]

        بعد(مدير_رسائل_سريعة._حالية.مدة، لامدا() =>
            مدير_رسائل_سريعة._أظهر_التالية()
        نهاية)
    نهاية
نهاية

