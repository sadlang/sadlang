# العيب #27: Shadow Rendering - رسم الظلال
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف ظل
    باني(إعدادات)
        هذا.لون = إعدادات.لون أو "أسود"
        هذا.إزاحة_س = إعدادات.إزاحة_س أو 0
        هذا.إزاحة_ص = إعدادات.إزاحة_ص أو 2
        هذا.ضبابية = إعدادات.ضبابية أو 4
        هذا.انتشار = إعدادات.انتشار أو 0
    نهاية

    دالة ارسم(سياق، مستطيل)
        سياق.احفظ()
        
        # أعد الإزاحة
        سياق.انقل(هذا.إزاحة_س، هذا.إزاحة_ص)
        
        # أعد الضبابية
        سياق.عيّن_ظل(هذا.لون، هذا.ضبابية)
        
        # ارسم الشكل مع الانتشار
        متغير م = جديد مستطيل(
            مستطيل.س - هذا.انتشار،
            مستطيل.ص - هذا.انتشار،
            مستطيل.عرض + هذا.انتشار * 2،
            مستطيل.ارتفاع + هذا.انتشار * 2
        )
        
        سياق.ارسم_مستطيل(م)
        
        سياق.استعد()
    نهاية
نهاية

