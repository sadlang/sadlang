# العيب #29: RichText - نص منسق
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف قطعة_نص
    باني(نص، نمط)
        هذا.نص = نص
        هذا.نمط = نمط أو {}
    نهاية
نهاية

صدّر صنف نص_منسق
    باني(قطع)
        هذا._قطع = قطع أو []
    نهاية

    دالة أضف(نص، نمط)
        هذا._قطع.أضف(جديد قطعة_نص(نص، نمط))
        ارجع هذا
    نهاية

    دالة ارسم(سياق، س، ص)
        متغير موضع_س = س
        
        لكل قطعة في هذا._قطع
            # طبّق النمط
            إذا (قطعة.نمط.خط)
                سياق.عيّن_خط(قطعة.نمط.خط)
            نهاية
            إذا (قطعة.نمط.حجم)
                سياق.عيّن_حجم_خط(قطعة.نمط.حجم)
            نهاية
            إذا (قطعة.نمط.لون)
                سياق.عيّن_لون(قطعة.نمط.لون)
            نهاية
            إذا (قطعة.نمط.عريض)
                سياق.عيّن_وزن_خط("عريض")
            نهاية
            إذا (قطعة.نمط.مائل)
                سياق.عيّن_نمط_خط("مائل")
            نهاية
            
            # ارسم النص
            سياق.ارسم_نص(قطعة.نص، موضع_س، ص)
            
            # حرك الموضع
            متغير قياس = سياق.قس_نص(قطعة.نص)
            موضع_س += قياس.عرض
        نهاية
    نهاية

    دالة النص_الكامل()
        ارجع هذا._قطع.خريطة(لامدا(ق) => ق.نص).اضم("")
    نهاية
نهاية

