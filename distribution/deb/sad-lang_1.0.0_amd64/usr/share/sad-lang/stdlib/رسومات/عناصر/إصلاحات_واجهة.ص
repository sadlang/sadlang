# العيب #30: SelectableText - نص قابل للتحديد
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف نص_قابل_للتحديد
    باني(نص، نمط)
        هذا._نص = نص
        هذا._نمط = نمط أو {}
        هذا._بداية_تحديد = -1
        هذا._نهاية_تحديد = -1
        هذا._جاري_تحديد = خطأ
    نهاية

    دالة عند_بداية_لمس(موضع)
        متغير فهرس = هذا._موضع_إلى_فهرس(موضع)
        هذا._بداية_تحديد = فهرس
        هذا._نهاية_تحديد = فهرس
        هذا._جاري_تحديد = صحيح
    نهاية

    دالة عند_تحريك_لمس(موضع)
        إذا (ليس هذا._جاري_تحديد)
            ارجع
        نهاية
        
        متغير فهرس = هذا._موضع_إلى_فهرس(موضع)
        هذا._نهاية_تحديد = فهرس
    نهاية

    دالة عند_نهاية_لمس()
        هذا._جاري_تحديد = خطأ
    نهاية

    دالة _موضع_إلى_فهرس(موضع)
        # تقريب بسيط - يحتاج قياس حقيقي
        متغير حجم_حرف = هذا._نمط.حجم أو 14
        متغير فهرس = اقسم_صحيح(موضع.س، حجم_حرف * 0.5)
        ارجع محصور(فهرس، 0، هذا._نص.الطول())
    نهاية

    دالة النص_المحدد()
        إذا (هذا._بداية_تحديد == -1)
            ارجع ""
        نهاية
        
        متغير بداية = مين(هذا._بداية_تحديد، هذا._نهاية_تحديد)
        متغير نهاية = ماكس(هذا._بداية_تحديد، هذا._نهاية_تحديد)
        
        ارجع هذا._نص.قطع(بداية، نهاية)
    نهاية

    دالة انسخ()
        ارجع هذا.النص_المحدد()
    نهاية

    دالة حدد_الكل()
        هذا._بداية_تحديد = 0
        هذا._نهاية_تحديد = هذا._نص.الطول()
    نهاية

    دالة ألغِ_التحديد()
        هذا._بداية_تحديد = -1
        هذا._نهاية_تحديد = -1
    نهاية

    دالة ارسم(سياق، س، ص)
        # ارسم خلفية التحديد
        إذا (هذا._بداية_تحديد != -1 و هذا._بداية_تحديد != هذا._نهاية_تحديد)
            متغير بداية = مين(هذا._بداية_تحديد، هذا._نهاية_تحديد)
            متغير نهاية = ماكس(هذا._بداية_تحديد، هذا._نهاية_تحديد)
            
            متغير حجم_حرف = هذا._نمط.حجم أو 14
            متغير س_بداية = س + بداية * حجم_حرف * 0.5
            متغير عرض = (نهاية - بداية) * حجم_حرف * 0.5
            
            سياق.عيّن_لون_تعبئة("rgba(0, 120, 215, 0.3)")
            سياق.ارسم_مستطيل_معبأ(س_بداية، ص - حجم_حرف، عرض، حجم_حرف * 1.2)
        نهاية
        
        # ارسم النص
        سياق.عيّن_لون(هذا._نمط.لون أو "أسود")
        سياق.ارسم_نص(هذا._نص، س، ص)
    نهاية
نهاية

