# العيب #28: Text Overflow - تجاوز النص
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر تعداد تجاوز_نص
    قطع = "clip"
    تلاشي = "fade"
    نقاط = "ellipsis"
    مرئي = "visible"
نهاية

صدّر صنف معالج_تجاوز_نص
    باني(نص، عرض_أقصى، نوع)
        هذا._نص = نص
        هذا._عرض_أقصى = عرض_أقصى
        هذا._نوع = نوع أو تجاوز_نص.نقاط
    نهاية

    دالة عالج(قياس)
        إذا (قياس.عرض <= هذا._عرض_أقصى)
            ارجع هذا._نص
        نهاية

        طابق (هذا._نوع)
            عندما تجاوز_نص.قطع:
                ارجع هذا._قطع(قياس)
            عندما تجاوز_نص.نقاط:
                ارجع هذا._نقاط(قياس)
            عندما تجاوز_نص.تلاشي:
                ارجع {نص: هذا._نص، تلاشي: صحيح}
            افتراضي:
                ارجع هذا._نص
        نهاية
    نهاية

    دالة _قطع(قياس)
        متغير نسبة = هذا._عرض_أقصى / قياس.عرض
        متغير طول = اقسم_صحيح(هذا._نص.الطول() * نسبة، 1)
        ارجع هذا._نص.قطع(0، طول)
    نهاية

    دالة _نقاط(قياس)
        متغير نسبة = (هذا._عرض_أقصى - 20) / قياس.عرض  # 20 للنقاط
        متغير طول = اقسم_صحيح(هذا._نص.الطول() * نسبة، 1)
        ارجع هذا._نص.قطع(0، طول) + "..."
    نهاية
نهاية

