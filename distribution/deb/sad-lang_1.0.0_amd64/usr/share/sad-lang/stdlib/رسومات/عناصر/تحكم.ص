استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    زر_راديو: Radio Button
# ===================================================================

صدّر صنف زر_راديو يرث عنصر
    باني(قيمة = لاشيء, مجموعة = لاشيء, محدد = لاشيء, عند_التغيير = لاشيء, تسمية = لاشيء, لون = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "زر_راديو"
        هذا._خصائص = {}
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["مجموعة"] = مجموعة
        هذا._خصائص["محدد"] = محدد
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["لون"] = لون
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    دالة محدد()
        ارجع هذا._خصائص["محدد"] == صحيح
    نهاية

    دالة حدّد()
        هذا._خصائص["محدد"] = صحيح
        ارجع هذا
    نهاية

    دالة ألغ_التحديد()
        هذا._خصائص["محدد"] = خطأ
        ارجع هذا
    نهاية
نهاية

# ===================================================================
#                    خطوات: Stepper (+/-)
# ===================================================================

صدّر صنف خطوات يرث عنصر
    باني(قيمة = لاشيء, حد_ادنى = لاشيء, حد_اقصى = لاشيء, خطوة = لاشيء, عند_التغيير = لاشيء, تسمية = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "خطوات"
        هذا._خصائص = {}
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["حد_ادنى"] = حد_ادنى
        هذا._خصائص["حد_اقصى"] = حد_اقصى
        هذا._خصائص["خطوة"] = خطوة
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    دالة احصل_القيمة()
        ارجع هذا._خصائص["قيمة"]
    نهاية

    دالة عيّن_القيمة(قيمة)
        هذا._خصائص["قيمة"] = قيمة
        ارجع هذا
    نهاية

    دالة زد()
        متغير خطوة = هذا._خصائص["خطوة"]
        إذا (خطوة == لاشيء)
            خطوة = 1
        نهاية
        هذا._خصائص["قيمة"] = هذا._خصائص["قيمة"] + خطوة
        ارجع هذا
    نهاية

    دالة أنقص()
        متغير خطوة = هذا._خصائص["خطوة"]
        إذا (خطوة == لاشيء)
            خطوة = 1
        نهاية
        هذا._خصائص["قيمة"] = هذا._خصائص["قيمة"] - خطوة
        ارجع هذا
    نهاية
نهاية

