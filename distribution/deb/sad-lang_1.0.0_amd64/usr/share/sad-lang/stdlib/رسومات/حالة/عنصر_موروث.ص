# ملف: عنصر_موروث.ص
# المسار: stdlib/رسومات/حالة/عنصر_موروث.ص
# ===================================================================
# نظام InheritedWidget لمشاركة البيانات في الشجرة
# يدعم O(1) lookup و smart rebuilding
# ===================================================================
# إصلاح العيب #12: غياب InheritedWidget
