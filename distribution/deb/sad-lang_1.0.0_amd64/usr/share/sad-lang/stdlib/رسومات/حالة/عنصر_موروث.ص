استورد * من رسومات.أساس.عنصر

# ─── عنصر موروثّ (InheritedWidget) ───
صدّر صنف عنصر_موروث يرث عنصر
    باني(ابن)
        هذا._نوع = "عنصر_موروث"
        هذا._ابن = ابن
        هذا._مستمعون = []
    نهاية

    # يُستدعى لتحديد ما إذا كان يجب إعادة البناء
    دالة يجب_إبلاغ_التابعين(قديم)
        # الافتراضي: دائماً أبلغ
        # الأصناف الفرعية تُعيد تعريفه للتحقق من التغييرات
        ارجع صحيح
    نهاية

    دالة أضف_تابع(عنصر)
        هذا._مستمعون.أضف(عنصر)
    نهاية

    دالة أزل_تابع(عنصر)
        هذا._مستمعون.أزل(عنصر)
    نهاية

    دالة أبلغ_التابعين()
        لكل م في هذا._مستمعون
            م.أعد_البناء()
        نهاية
    نهاية
نهاية

# ─── سياق البناء (BuildContext) ───
صدّر صنف سياق_بناء
    باني(عنصر)
        هذا._عنصر = عنصر
        هذا._التابعات = []
    نهاية

    # ─── البحث عن عنصر موروث ───
    دالة ابحث_عن_عنصر_موروث(نوع)
        متغير حالي = هذا._عنصر
        بينما (حالي != لاشيء)
            إذا (حالي.النوع() == نوع)
                ارجع حالي
            نهاية
            حالي = حالي.الأب()
        نهاية
        ارجع لاشيء
    نهاية

    # ─── الاعتماد على عنصر موروث (يسجل كتابع) ───
    دالة اعتمد_على_عنصر_موروث(نوع)
        متغير موروث = هذا.ابحث_عن_عنصر_موروث(نوع)
        إذا (موروث != لاشيء)
            موروث.أضف_تابع(هذا._عنصر)
            هذا._التابعات.أضف(موروث)
        نهاية
        ارجع موروث
    نهاية

    # ─── إلغاء الاعتمادات عند التفكيك ───
    دالة ألغِ_الاعتمادات()
        لكل م في هذا._التابعات
            م.أزل_تابع(هذا._عنصر)
        نهاية
        هذا._التابعات = []
    نهاية

    دالة الحجم()
        ارجع هذا._عنصر.الحجم()
    نهاية
نهاية

# ─── نموذج عنصر موروث مخصص (InheritedModel) ───
صدّر صنف نموذج_موروث يرث عنصر_موروث
    باني(ابن)
        الأساس(ابن)
        هذا._نوع = "نموذج_موروث"
        هذا._مستمعون_حسب_الجانب = {}
    نهاية

    # جوانب البيانات (aspects)
    دالة أضف_تابع_لجانب(عنصر، جانب)
        إذا (ليس هذا._مستمعون_حسب_الجانب[جانب])
            هذا._مستمعون_حسب_الجانب[جانب] = []
        نهاية
        هذا._مستمعون_حسب_الجانب[جانب].أضف(عنصر)
    نهاية

    دالة أبلغ_التابعين_لجانب(جانب)
        إذا (هذا._مستمعون_حسب_الجانب[جانب])
            لكل م في هذا._مستمعون_حسب_الجانب[جانب]
                م.أعد_البناء()
            نهاية
        نهاية
    نهاية

    دالة يجب_الإبلاغ_عن_تغيير_جانب(قديم، جانب)
        # الأصناف الفرعية تُعيد تعريفه
        ارجع صحيح
    نهاية
نهاية

# ─── مزود البيانات (Provider Pattern) ───
صدّر صنف مزود يرث عنصر_موروث
    باني(قيمة، ابن، أنشئ = لاشيء، تخلص = لاشيء)
        الأساس(ابن)
        هذا._نوع = "مزود"
        هذا._قيمة = قيمة
        هذا._أنشئ = أنشئ
        هذا._تخلص = تخلص
        
        إذا (هذا._أنشئ != لاشيء)
            هذا._قيمة = هذا._أنشئ()
        نهاية
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة يجب_إبلاغ_التابعين(قديم)
        ارجع هذا._قيمة != قديم._قيمة
    نهاية

    ساكن دالة من(سياق، نوع = لاشيء)
        متغير مزود = سياق.اعتمد_على_عنصر_موروث("مزود")
        إذا (مزود == لاشيء)
            ارمي خطأ("لم يُعثر على مزود في شجرة العناصر")
        نهاية
        ارجع مزود.القيمة()
    نهاية

    ساكن دالة قيمة_من(سياق، نوع = لاشيء)
        # مثل من() لكن بدون تسجيل كتابع
        متغير مزود = سياق.ابحث_عن_عنصر_موروث("مزود")
        إذا (مزود == لاشيء)
            ارمي خطأ("لم يُعثر على مزود في شجرة العناصر")
        نهاية
        ارجع مزود.القيمة()
    نهاية

    دالة تخلص_من_القيمة()
        إذا (هذا._تخلص != لاشيء)
            هذا._تخلص(هذا._قيمة)
        نهاية
    نهاية
نهاية

# ─── مزود التغيير (ChangeNotifierProvider) ───
صدّر صنف مزود_تغيير يرث مزود
    باني(أنشئ، ابن)
        الأساس(لاشيء، ابن، أنشئ، لاشيء)
        هذا._نوع = "مزود_تغيير"
        
        # الاشتراك في إشعارات التغيير
        هذا._قيمة.أضف_مستمع(لامدا: هذا.أبلغ_التابعين())
    نهاية

    دالة تخلص_من_القيمة()
        هذا._قيمة.تخلص()
    نهاية
نهاية

# ─── مستهلك (Consumer) ───
صدّر صنف مستهلك يرث عنصر
    باني(بانٍ)
        هذا._نوع = "مستهلك"
        هذا._بانٍ = بانٍ
    نهاية

    دالة ابنِ(سياق)
        متغير قيمة = مزود.من(سياق)
        ارجع هذا._بانٍ(سياق، قيمة)
    نهاية
نهاية

# ─── مستهلك متعدد (Consumer2, Consumer3...) ───
صدّر صنف مستهلك2 يرث عنصر
    باني(بانٍ)
        هذا._نوع = "مستهلك2"
        هذا._بانٍ = بانٍ
    نهاية

    دالة ابنِ(سياق)
        # يحتاج نوعين من المزودات
        # يُستخدم مع أنواع محددة
        ارجع هذا._بانٍ(سياق، لاشيء، لاشيء)
    نهاية
نهاية

# ─── محدد (Selector) - إعادة البناء الذكية ───
صدّر صنف محدد يرث عنصر
    باني(حدد، بانٍ)
        هذا._نوع = "محدد"
        هذا._حدد = حدد
        هذا._بانٍ = بانٍ
        هذا._قيمة_محددة_سابقة = لاشيء
    نهاية

    دالة ابنِ(سياق)
        متغير قيمة_كاملة = مزود.من(سياق)
        متغير قيمة_محددة = هذا._حدد(قيمة_كاملة)
        
        # فقط أعد البناء إذا تغيرت القيمة المحددة
        إذا (قيمة_محددة != هذا._قيمة_محددة_سابقة)
            هذا._قيمة_محددة_سابقة = قيمة_محددة
            ارجع هذا._بانٍ(سياق، قيمة_محددة)
        نهاية
        
        ارجع لاشيء
    نهاية
نهاية

# ─── مراقب التغيير (ChangeNotifier base class) ───
صدّر صنف مراقب_تغيير
    باني()
        هذا._مستمعون = []
        هذا._متخلص = خطأ
    نهاية

    دالة أضف_مستمع(مستمع)
        إذا (ليس هذا._متخلص)
            هذا._مستمعون.أضف(مستمع)
        نهاية
    نهاية

    دالة أزل_مستمع(مستمع)
        هذا._مستمعون.أزل(مستمع)
    نهاية

    دالة أبلغ_المستمعين()
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة تخلص()
        هذا._متخلص = صحيح
        هذا._مستمعون = []
    نهاية

    دالة متخلص()
        ارجع هذا._متخلص
    نهاية
نهاية

# ─── مراقب تغيير القيمة (ValueNotifier) ───
صدّر صنف مراقب_قيمة يرث مراقب_تغيير
    باني(قيمة)
        الأساس()
        هذا._قيمة = قيمة
    نهاية

    خاصية قيمة
        احصل()
            ارجع هذا._قيمة
        نهاية
        
        عيّن(ق)
            إذا (هذا._قيمة != ق)
                هذا._قيمة = ق
                هذا.أبلغ_المستمعين()
            نهاية
        نهاية
    نهاية
نهاية
