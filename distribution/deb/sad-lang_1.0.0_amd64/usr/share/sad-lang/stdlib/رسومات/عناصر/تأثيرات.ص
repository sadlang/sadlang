استورد * من رسومات.أساس.عنصر

# ─── تمويه (BackdropFilter) ───
صدّر صنف تمويه يرث عنصر
    باني(شدة = 10, ابن = لاشيء)
        هذا._نوع = "تمويه"
        هذا._خصائص = {}
        هذا._خصائص["شدة_س"] = شدة
        هذا._خصائص["شدة_ص"] = شدة
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

