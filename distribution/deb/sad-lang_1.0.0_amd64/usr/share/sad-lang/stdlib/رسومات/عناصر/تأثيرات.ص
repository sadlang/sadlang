# ─── تحويل (Transform) ───
صدّر صنف تحويل_عنصر يرث عنصر
    باني(ابن = لاشيء)
        هذا._نوع = "تحويل"
        هذا._خصائص = {}
        هذا._خصائص["دوران"] = 0
        هذا._خصائص["مقياس_س"] = 1.0
        هذا._خصائص["مقياس_ص"] = 1.0
        هذا._خصائص["إزاحة_س"] = 0
        هذا._خصائص["إزاحة_ص"] = 0
        هذا._خصائص["انحراف_س"] = 0
        هذا._خصائص["انحراف_ص"] = 0
        هذا._خصائص["مركز"] = "توسيط"
        هذا._أبناء = []
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية

    دالة دوران(زاوية)
        هذا._خصائص["دوران"] = زاوية
        ارجع هذا
    نهاية

    دالة مقياس(س, ص)
        هذا._خصائص["مقياس_س"] = س
        هذا._خصائص["مقياس_ص"] = ص
        ارجع هذا
    نهاية

    دالة إزاحة(س, ص)
        هذا._خصائص["إزاحة_س"] = س
        هذا._خصائص["إزاحة_ص"] = ص
        ارجع هذا
    نهاية
نهاية

