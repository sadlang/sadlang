# ─── إكمال_تلقائي (Autocomplete) ───
صدّر صنف إكمال_تلقائي يرث عنصر
    باني(اقتراحات = لاشيء, عند_اختيار = لاشيء, تلميح = لاشيء)
        هذا._نوع = "إكمال_تلقائي"
        هذا._خصائص = {}
        هذا._خصائص["اقتراحات"] = اقتراحات
        هذا._خصائص["عند_اختيار"] = عند_اختيار
        هذا._خصائص["تلميح"] = تلميح
    نهاية
نهاية

