#                    طبقة: Overlay للعناصر العائمة
# ===================================================================
صدّر صنف طبقة يرث عنصر
    باني()
        هذا._نوع = "طبقة"
        هذا._مدخلات = []
        هذا._خصائص = {}
    نهاية

    دالة أدخل(عنصر, فوق = لاشيء)
        متغير مدخل = جديد مدخل_طبقة(عنصر)
        إذا (فوق != لاشيء)
            متغير جديدة = []
            لكل م في هذا._مدخلات
                جديدة = جديدة + [م]
                إذا (م == فوق)
                    جديدة = جديدة + [مدخل]
                نهاية
            نهاية
            هذا._مدخلات = جديدة
        وإلا
            هذا._مدخلات = هذا._مدخلات + [مدخل]
        نهاية
        ارجع مدخل
    نهاية

    دالة أزل(مدخل)
        متغير جديدة = []
        لكل م في هذا._مدخلات
            إذا (م != مدخل)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مدخلات = جديدة
    نهاية

    دالة المدخلات()
        ارجع هذا._مدخلات
    نهاية
نهاية

