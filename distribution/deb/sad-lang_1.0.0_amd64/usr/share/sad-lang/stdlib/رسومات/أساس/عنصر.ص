# ===================================================================
#                    إدارة التركيز: Focus Management
# ===================================================================
صدّر صنف عقدة_تركيز
    باني(اسم = لاشيء)
        هذا._اسم = اسم
        هذا._مركّز = خطأ
        هذا._مستمعون = []
        هذا._أبناء = []
        هذا._أب = لاشيء
    نهاية

    دالة مركّز()
        ارجع هذا._مركّز
    نهاية

    دالة ركّز()
        هذا._مركّز = صحيح
        لكل مستمع في هذا._مستمعون
            مستمع(صحيح)
        نهاية
        ارجع هذا
    نهاية

    دالة أزل_التركيز()
        هذا._مركّز = خطأ
        لكل مستمع في هذا._مستمعون
            مستمع(خطأ)
        نهاية
        ارجع هذا
    نهاية

    دالة أضف_مستمع(دالة_رد)
        هذا._مستمعون = هذا._مستمعون + [دالة_رد]
    نهاية

    دالة التالي()
        # انتقال للعنصر التالي
        إذا (هذا._أب != لاشيء)
            متغير فهرس = 0
            لكل ابن في هذا._أب._أبناء
                إذا (ابن == هذا)
                    إذا (فهرس + 1 < طول(هذا._أب._أبناء))
                        هذا.أزل_التركيز()
                        هذا._أب._أبناء[فهرس + 1].ركّز()
                    نهاية
                نهاية
                فهرس = فهرس + 1
            نهاية
        نهاية
    نهاية

    دالة السابق()
        إذا (هذا._أب != لاشيء)
            متغير فهرس = 0
            لكل ابن في هذا._أب._أبناء
                إذا (ابن == هذا)
                    إذا (فهرس > 0)
                        هذا.أزل_التركيز()
                        هذا._أب._أبناء[فهرس - 1].ركّز()
                    نهاية
                نهاية
                فهرس = فهرس + 1
            نهاية
        نهاية
    نهاية
نهاية

صدّر صنف نطاق_تركيز يرث عقدة_تركيز
    باني(اسم = لاشيء)
        الأساس(اسم)
    نهاية

    دالة أضف_عقدة(عقدة)
        عقدة._أب = هذا
        هذا._أبناء = هذا._أبناء + [عقدة]
        ارجع هذا
    نهاية

    دالة ركّز_أول()
        إذا (طول(هذا._أبناء) > 0)
            هذا._أبناء[0].ركّز()
        نهاية
    نهاية
نهاية
