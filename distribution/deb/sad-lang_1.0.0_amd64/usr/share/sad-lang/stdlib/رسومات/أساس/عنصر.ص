# ===================================================================
#                    الصنف الأساسي: عنصر
# ===================================================================

صدّر صنف عنصر
    متغير _نوع
    متغير _خصائص
    متغير _أبناء
    متغير _ابن

    باني()
        هذا._نوع = ""
        هذا._خصائص = {}
        هذا._أبناء = []
    نهاية

    # ─── دوال القراءة الأساسية ───

    دالة بناء()
        ارجع هذا
    نهاية
    
    دالة النوع()
        ارجع هذا._نوع
    نهاية
    
    دالة الخصائص()
        ارجع هذا._خصائص
    نهاية
    
    دالة الأبناء()
        ارجع هذا._أبناء
    نهاية

    # ─── دوال وصول الخصائص العامة (Getters) ───

    دالة احصل(مفتاح)
        إذا (هذا._خصائص[مفتاح] != لاشيء)
            ارجع هذا._خصائص[مفتاح]
        نهاية
        ارجع لاشيء
    نهاية

    دالة احصل_الخلفية()
        ارجع هذا._خصائص["لون_خلفية"]
    نهاية

    دالة احصل_لون_النص()
        ارجع هذا._خصائص["لون_نص"]
    نهاية

    دالة احصل_العرض()
        ارجع هذا._خصائص["عرض"]
    نهاية

    دالة احصل_الارتفاع()
        ارجع هذا._خصائص["ارتفاع"]
    نهاية

    دالة احصل_الحشو()
        ارجع هذا._خصائص["حشو"]
    نهاية

    دالة احصل_الهامش()
        ارجع هذا._خصائص["هامش"]
    نهاية

    دالة احصل_طريقة_العرض()
        ارجع هذا._خصائص["طريقة_عرض"]
    نهاية

    # ─── دوال التعديل (Setters) ───

    دالة عيّن(مفتاح, قيمة)
        هذا._خصائص[مفتاح] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_الخلفية(لون)
        هذا._خصائص["لون_خلفية"] = لون
        ارجع هذا
    نهاية

    دالة عيّن_لون_النص(لون)
        هذا._خصائص["لون_نص"] = لون
        ارجع هذا
    نهاية

    دالة عيّن_العرض(قيمة)
        هذا._خصائص["عرض"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_الارتفاع(قيمة)
        هذا._خصائص["ارتفاع"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_الحشو(قيمة)
        هذا._خصائص["حشو"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_الهامش(قيمة)
        هذا._خصائص["هامش"] = قيمة
        ارجع هذا
    نهاية

    دالة عيّن_طريقة_العرض(قيمة)
        هذا._خصائص["طريقة_عرض"] = قيمة
        ارجع هذا
    نهاية

    # ─── دوال الأبناء ───

    دالة أضف_ابن(ابن)
        هذا._أبناء = هذا._أبناء + [ابن]
        ارجع هذا
    نهاية

    دالة أزل_ابن(فهرس)
        متغير جديدة = []
        متغير ع = 0
        لكل ابن في هذا._أبناء
            إذا (ع != فهرس)
                جديدة = جديدة + [ابن]
            نهاية
            ع = ع + 1
        نهاية
        هذا._أبناء = جديدة
        ارجع هذا
    نهاية

    دالة عدد_الأبناء()
        إذا (هذا._أبناء == لاشيء)
            ارجع 0
        نهاية
        ارجع طول(هذا._أبناء)
    نهاية

    # ─── دوال مساعدة ───

    دالة نسخ()
        متغير نسخة = جديد عنصر()
        نسخة._نوع = هذا._نوع
        نسخة._خصائص = هذا._خصائص
        نسخة._أبناء = هذا._أبناء
        نسخة._ابن = هذا._ابن
        ارجع نسخة
    نهاية

    دالة معطل()
        ارجع هذا._خصائص["معطل"] == صحيح
    نهاية

    دالة عيّن_معطل(قيمة)
        هذا._خصائص["معطل"] = قيمة
        ارجع هذا
    نهاية

    دالة مرئي()
        إذا (هذا._خصائص["مرئي"] == لاشيء)
            ارجع صحيح
        نهاية
        ارجع هذا._خصائص["مرئي"]
    نهاية

    دالة عيّن_مرئي(قيمة)
        هذا._خصائص["مرئي"] = قيمة
        ارجع هذا
    نهاية
نهاية

