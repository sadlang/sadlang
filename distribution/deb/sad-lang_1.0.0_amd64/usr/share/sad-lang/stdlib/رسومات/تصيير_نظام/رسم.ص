# بسم الله الرحمن الرحيم
# ===================================================================
# خط أنابيب الرسم — Paint Pipeline
# ===================================================================
#
# (AR) هذا الملف يوفر نظام الرسم الفعلي (Paint Pipeline) الذي
#      يحوّل كائنات التصيير إلى أوامر رسم على الشاشة.
#
#      خط الأنابيب:
#      ١. بناء شجرة الطبقات (Layer Tree) من كائنات التصيير
#      ٢. تركيب الطبقات (Compositing) — دمج الطبقات مع التحويلات
#      ٣. التنقيط (Rasterization) — تحويل الأوامر لبكسلات
#      ٤. العرض (Display) — إرسال الإطار للشاشة
#
#      مطابق لـ flutter/rendering/layer.dart
#      و flutter/rendering/object.dart (PaintingContext)
#
# (EN) Actual paint pipeline that converts render objects into
#      on-screen drawing commands through a layered compositing system.
#
# الأصناف المُصدّرة:
#   - طبقة (Layer)                — الطبقة الأساسية في شجرة الطبقات
#   - طبقة_حاوية (ContainerLayer)    — طبقة تحتوي على أبناء
#   - طبقة_إزاحة (OffsetLayer)      — طبقة مع إزاحة
#   - طبقة_قص (ClipLayer)          — طبقة مع قص
#   - طبقة_شفافية (OpacityLayer)    — طبقة مع شفافية
#   - طبقة_تحويل (TransformLayer)   — طبقة مع تحويلات هندسية
#   - سياق_رسم (PaintingContext)    — سياق الرسم
#   - قناة_رسم (Canvas)            — قناة الأوامر الرسومية
#
# الاستخدام:
#   استورد * من رسومات.تصيير_نظام.رسم
# ===================================================================

# ─── طبقة (Layer) — الطبقة الأساسية ───
صدّر صنف طبقة
    # (AR) العنصر الأساسي في شجرة الطبقات (Layer Tree)
    #      كل طبقة تمثل منطقة رسم مستقلة يمكن تركيبها
    # (EN) Base element in the layer tree — each layer represents
    #      an independent drawing region
    باني()
        هذا._أب = لاشيء
        هذا._يحتاج_إعادة_تركيب = صحيح
        هذا._مرفقة = خطأ
    نهاية

    دالة علم_يحتاج_تركيب()
        هذا._يحتاج_إعادة_تركيب = صحيح
        إذا (هذا._أب != لاشيء)
            هذا._أب.علم_يحتاج_تركيب()
        نهاية
    نهاية

    دالة ارفق()
        هذا._مرفقة = صحيح
    نهاية

    دالة افصل()
        هذا._مرفقة = خطأ
        هذا._أب = لاشيء
    نهاية
نهاية

# ─── طبقة_حاوية (ContainerLayer) ───
صدّر صنف طبقة_حاوية يرث طبقة
    # (AR) طبقة تحتوي على طبقات أبناء — تُشكّل عقد الشجرة الداخلية
    # (EN) Container layer that holds child layers — internal tree nodes
    باني()
        هذا._أب = لاشيء
        هذا._يحتاج_إعادة_تركيب = صحيح
        هذا._مرفقة = خطأ
        هذا._أبناء = []
    نهاية

    دالة أضف_ابن(طبقة_ابن)
        هذا._أبناء = هذا._أبناء + [طبقة_ابن]
        طبقة_ابن._أب = هذا
    نهاية

    دالة أزل_كل_الأبناء()
        لكل ابن في هذا._أبناء
            ابن._أب = لاشيء
        نهاية
        هذا._أبناء = []
    نهاية

    دالة الأبناء()
        ارجع هذا._أبناء
    نهاية
نهاية

# ─── طبقة_إزاحة (OffsetLayer) ───
صدّر صنف طبقة_إزاحة يرث طبقة_حاوية
    # (AR) طبقة مع إزاحة (offset) — تنقل كل محتوياتها بمقدار معين
    # (EN) Layer with offset — shifts all its contents by a given amount
    باني(إزاحة_س = 0, إزاحة_ص = 0)
        هذا._أب = لاشيء
        هذا._يحتاج_إعادة_تركيب = صحيح
        هذا._مرفقة = خطأ
        هذا._أبناء = []
        هذا._إزاحة_س = إزاحة_س
        هذا._إزاحة_ص = إزاحة_ص
    نهاية

    دالة الإزاحة()
        ارجع {"س": هذا._إزاحة_س, "ص": هذا._إزاحة_ص}
    نهاية

    دالة عيّن_إزاحة(س, ص)
        هذا._إزاحة_س = س
        هذا._إزاحة_ص = ص
        هذا.علم_يحتاج_تركيب()
    نهاية
نهاية

# ─── طبقة_قص (ClipLayer) ───
صدّر صنف طبقة_قص يرث طبقة_حاوية
    # (AR) طبقة تقص المحتوى بشكل معين (مستطيل، مستدير، مسار)
    # (EN) Layer that clips content to a specific shape
    باني(نوع_قص = "مستطيل", قيم = لاشيء)
        هذا._أب = لاشيء
        هذا._يحتاج_إعادة_تركيب = صحيح
        هذا._مرفقة = خطأ
        هذا._أبناء = []
        هذا._نوع_قص = نوع_قص
        هذا._قيم = قيم
    نهاية

    دالة نوع_القص()
        ارجع هذا._نوع_قص
    نهاية
نهاية

# ─── طبقة_شفافية (OpacityLayer) ───
صدّر صنف طبقة_شفافية يرث طبقة_حاوية
    # (AR) طبقة تطبق شفافية (opacity) على كل محتوياتها
    #      القيمة من 0.0 (شفاف تماماً) إلى 1.0 (معتم تماماً)
    # (EN) Layer that applies opacity to all its contents
    باني(شفافية = 1.0)
        هذا._أب = لاشيء
        هذا._يحتاج_إعادة_تركيب = صحيح
        هذا._مرفقة = خطأ
        هذا._أبناء = []
        هذا._شفافية = شفافية
    نهاية

    دالة الشفافية()
        ارجع هذا._شفافية
    نهاية

    دالة عيّن_شفافية(قيمة)
        هذا._شفافية = قيمة
        هذا.علم_يحتاج_تركيب()
    نهاية
نهاية

# ─── طبقة_تحويل (TransformLayer) ───
صدّر صنف طبقة_تحويل يرث طبقة_حاوية
    # (AR) طبقة تطبق تحويلات هندسية (إزاحة، دوران، تحجيم)
    # (EN) Layer that applies geometric transformations
    باني(تحويل = لاشيء)
        هذا._أب = لاشيء
        هذا._يحتاج_إعادة_تركيب = صحيح
        هذا._مرفقة = خطأ
        هذا._أبناء = []
        إذا (تحويل == لاشيء)
            هذا._تحويل = {"م11": 1, "م12": 0, "م21": 0, "م22": 1, "إزاحة_س": 0, "إزاحة_ص": 0}
        وإلا
            هذا._تحويل = تحويل
        نهاية
    نهاية

    دالة التحويل()
        ارجع هذا._تحويل
    نهاية

    دالة عيّن_تحويل(تحويل)
        هذا._تحويل = تحويل
        هذا.علم_يحتاج_تركيب()
    نهاية
نهاية

# ─── سياق_رسم (PaintingContext) ───
صدّر صنف سياق_رسم
    # (AR) سياق الرسم — يوفر واجهة للرسم على الطبقة الحالية
    #      يمرَّر لكل كائن تصيير أثناء مرحلة الرسم
    # (EN) Painting context — provides drawing interface for current layer
    باني(طبقة_حالية = لاشيء)
        إذا (طبقة_حالية == لاشيء)
            هذا._طبقة = جديد طبقة_إزاحة()
        وإلا
            هذا._طبقة = طبقة_حالية
        نهاية
        هذا._أوامر = []
    نهاية

    دالة القناة()
        # (AR) الحصول على قناة الرسم للطبقة الحالية
        ارجع هذا
    نهاية

    دالة ارسم_مستطيل(س, ص, عرض, ارتفاع, لون)
        هذا._أوامر = هذا._أوامر + [{"نوع": "مستطيل", "س": س, "ص": ص, "عرض": عرض, "ارتفاع": ارتفاع, "لون": لون}]
    نهاية

    دالة ارسم_دائرة(س, ص, نصف_قطر, لون)
        هذا._أوامر = هذا._أوامر + [{"نوع": "دائرة", "س": س, "ص": ص, "نصف_قطر": نصف_قطر, "لون": لون}]
    نهاية

    دالة ارسم_نص(س, ص, محتوى, حجم, لون)
        هذا._أوامر = هذا._أوامر + [{"نوع": "نص", "س": س, "ص": ص, "نص": محتوى, "حجم": حجم, "لون": لون}]
    نهاية

    دالة ارسم_خط(س1, ص1, س2, ص2, لون, سماكة)
        هذا._أوامر = هذا._أوامر + [{"نوع": "خط", "س1": س1, "ص1": ص1, "س2": س2, "ص2": ص2, "لون": لون, "سماكة": سماكة}]
    نهاية

    دالة ارسم_صورة(س, ص, عرض, ارتفاع, مصدر)
        هذا._أوامر = هذا._أوامر + [{"نوع": "صورة", "س": س, "ص": ص, "عرض": عرض, "ارتفاع": ارتفاع, "مصدر": مصدر}]
    نهاية

    دالة الأوامر()
        ارجع هذا._أوامر
    نهاية

    دالة مسح()
        هذا._أوامر = []
    نهاية

    دالة ارسم_ابن(ابن, إزاحة)
        # (AR) رسم كائن ابن مع إزاحة
        ابن.رسم(هذا)
    نهاية

    دالة ادفع_طبقة(طبقة_جديدة)
        # (AR) إضافة طبقة جديدة فوق الحالية
        هذا._طبقة.أضف_ابن(طبقة_جديدة)
    نهاية
نهاية
