# بسم الله الرحمن الرحيم
# ===================================================================
# شجرة الدلالات — Semantics Tree
# ===================================================================
#
# (AR) هذا الملف يوفر نظام شجرة الدلالات (Semantics Tree) الكامل
#      الذي يمثِّل الهيكل الدلالي للواجهة بالتوازي مع شجرة العناصر.
#
#      شجرة الدلالات:
#      ─ تُبنى تلقائيًا من عناصر الواجهة
#      ─ تُرسل لمنصة التشغيل (نظام التشغيل) ليستخدمها قارئ الشاشة
#      ─ تُحدَّث تلقائيًا عند تغيير الواجهة
#
#      المكونات:
#      1. عقدة_دلالات_كاملة — عقدة في الشجرة مع كل الخصائص
#      2. مالك_شجرة_دلالات — يملك ويدير الشجرة بالكامل
#      3. تحديث_دلالات — يصف تغيير واحد في الشجرة
#
#      مطابق لـ flutter/semantics/semantics.dart (SemanticsOwner, SemanticsNode)
#
# (EN) Complete Semantics Tree system — parallel tree describing
#      the semantic meaning of the UI for assistive technologies.
#
# الأصناف المُصدّرة:
#   - عقدة_دلالات_كاملة (SemanticsNode)         — عقدة شجرة كاملة
#   - مالك_شجرة_دلالات (SemanticsOwner)          — مدير الشجرة
#   - تحديث_دلالات (SemanticsUpdate)             — تحديث تزايدي
#   - حدث_دلالات (SemanticsEvent)                — حدث دلالي
#   - اتجاه_تمرير_دلالي (SemanticsSortDirection) — اتجاه الترتيب
#
# الاستخدام:
#   استورد * من رسومات.دلالات_نظام.شجرة
# ===================================================================

# ─── اتجاهات الترتيب ───
ثابت ترتيب_أمامي = "أمامي"      # Forward sort (LTR/TTB)
ثابت ترتيب_عكسي = "عكسي"       # Reverse sort (RTL/BTT)

# ─── عقدة_دلالات_كاملة (SemanticsNode) ───
صدّر صنف عقدة_دلالات_كاملة
    # (AR) عقدة كاملة في شجرة الدلالات — تحمل:
    #      - معرف فريد
    #      - بيانات دلالية (تسميات، إجراءات، أعلام)
    #      - موقع وحجم (مستطيل)
    #      - تحويلات هندسية
    #      - علاقات أب/أبناء
    # (EN) Complete node in the semantics tree
    باني(معرف = 0)
        هذا._معرف = معرف
        هذا._أب = لاشيء
        هذا._أبناء = []
        هذا._تسمية = ""
        هذا._قيمة = ""
        هذا._تلميح = ""
        هذا._أعلام = 0
        هذا._إجراءات = 0
        هذا._مستطيل = {"س": 0, "ص": 0, "عرض": 0, "ارتفاع": 0}
        هذا._مرئي = صحيح
        هذا._عمق = 0
        هذا._تغيّر = صحيح
        هذا._إجراءات_مخصصة = []
        هذا._ترتيب = لاشيء
    نهاية

    دالة المعرف()
        ارجع هذا._معرف
    نهاية

    دالة عيّن_تسمية(محتوى)
        هذا._تسمية = محتوى
        هذا._تغيّر = صحيح
        ارجع هذا
    نهاية

    دالة التسمية()
        ارجع هذا._تسمية
    نهاية

    دالة عيّن_قيمة(محتوى)
        هذا._قيمة = محتوى
        هذا._تغيّر = صحيح
        ارجع هذا
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة عيّن_تلميح(محتوى)
        هذا._تلميح = محتوى
        هذا._تغيّر = صحيح
        ارجع هذا
    نهاية

    دالة أضف_علم(علم)
        هذا._أعلام = هذا._أعلام + علم
        هذا._تغيّر = صحيح
        ارجع هذا
    نهاية

    دالة أضف_إجراء_نظامي(إجراء)
        هذا._إجراءات = هذا._إجراءات + إجراء
        هذا._تغيّر = صحيح
        ارجع هذا
    نهاية

    دالة عيّن_مستطيل(س, ص, عرض, ارتفاع)
        هذا._مستطيل = {"س": س, "ص": ص, "عرض": عرض, "ارتفاع": ارتفاع}
        هذا._تغيّر = صحيح
        ارجع هذا
    نهاية

    دالة المستطيل()
        ارجع هذا._مستطيل
    نهاية

    # ─── إدارة الأبناء ───

    دالة أضف_ابن(ابن)
        هذا._أبناء = هذا._أبناء + [ابن]
        ابن._أب = هذا
        ابن._عمق = هذا._عمق + 1
        هذا._تغيّر = صحيح
    نهاية

    دالة أزل_كل_أبناء()
        لكل ابن في هذا._أبناء
            ابن._أب = لاشيء
        نهاية
        هذا._أبناء = []
        هذا._تغيّر = صحيح
    نهاية

    دالة الأبناء()
        ارجع هذا._أبناء
    نهاية

    دالة الأب()
        ارجع هذا._أب
    نهاية

    دالة العمق()
        ارجع هذا._عمق
    نهاية

    # ─── لمعرفة إذا تغيرت العقدة ───

    دالة متغيرة()
        ارجع هذا._تغيّر
    نهاية

    دالة عيّن_نظيفة()
        هذا._تغيّر = خطأ
    نهاية

    دالة إلى_نص()
        ارجع "عقدة[" + هذا._معرف + "]: " + هذا._تسمية
    نهاية
نهاية

# ─── تحديث_دلالات (SemanticsUpdate) ───
صدّر صنف تحديث_دلالات
    # (AR) تحديث تزايدي (incremental) لشجرة الدلالات
    #      يحمل قائمة العقد المتغيرة فقط لتحسين الأداء
    # (EN) Incremental semantics tree update — only changed nodes
    باني()
        هذا._عقد_متغيرة = []
        هذا._عقد_محذوفة = []
    نهاية

    دالة أضف_تغيير(عقدة)
        هذا._عقد_متغيرة = هذا._عقد_متغيرة + [عقدة]
    نهاية

    دالة أضف_حذف(معرف)
        هذا._عقد_محذوفة = هذا._عقد_محذوفة + [معرف]
    نهاية

    دالة العقد_المتغيرة()
        ارجع هذا._عقد_متغيرة
    نهاية

    دالة العقد_المحذوفة()
        ارجع هذا._عقد_محذوفة
    نهاية

    دالة فارغ()
        ارجع هذا._عقد_متغيرة == [] و هذا._عقد_محذوفة == []
    نهاية
نهاية

# ─── حدث_دلالات (SemanticsEvent) ───
صدّر صنف حدث_دلالات
    # (AR) حدث دلالي يُرسل للمنصة — مثل إعلان عن تغيير
    #      أو إشعار مباشر لقارئ الشاشة
    # (EN) Semantic event sent to the platform (e.g., announcements)
    باني(نوع = "", رسالة = "", معرف_عقدة = 0)
        هذا._نوع = نوع
        هذا._رسالة = رسالة
        هذا._معرف_عقدة = معرف_عقدة
    نهاية

    دالة النوع()
        ارجع هذا._نوع
    نهاية

    دالة الرسالة()
        ارجع هذا._رسالة
    نهاية
نهاية

# ─── مالك_شجرة_دلالات (SemanticsOwner) ───
صدّر صنف مالك_شجرة_دلالات
    # (AR) المالك الرئيسي لشجرة الدلالات — مسؤول عن:
    #      ١. إنشاء وإدارة عقد الشجرة
    #      ٢. تتبع التغييرات وإرسال التحديثات
    #      ٣. توزيع الأحداث الدلالية
    #      ٤. ترقيم العقد تلقائيًا
    # (EN) Main owner of the semantics tree — manages creation,
    #      updates, and event dispatch
    باني()
        هذا._جذر = لاشيء
        هذا._عداد_معرفات = 0
        هذا._عقد_متغيرة = []
        هذا._أحداث_معلقة = []
    نهاية

    دالة عيّن_جذر(عقدة)
        هذا._جذر = عقدة
    نهاية

    دالة الجذر()
        ارجع هذا._جذر
    نهاية

    دالة أنشئ_عقدة()
        # (AR) إنشاء عقدة جديدة بمعرف فريد تلقائي
        هذا._عداد_معرفات = هذا._عداد_معرفات + 1
        ارجع جديد عقدة_دلالات_كاملة(هذا._عداد_معرفات)
    نهاية

    دالة علم_تغيير(عقدة)
        هذا._عقد_متغيرة = هذا._عقد_متغيرة + [عقدة]
    نهاية

    دالة أرسل_تحديثات()
        # (AR) بناء تحديث تزايدي وإرساله
        متغير تحديث = جديد تحديث_دلالات()
        لكل عقدة في هذا._عقد_متغيرة
            تحديث.أضف_تغيير(عقدة)
            عقدة.عيّن_نظيفة()
        نهاية
        هذا._عقد_متغيرة = []
        ارجع تحديث
    نهاية

    دالة أعلن(رسالة)
        # (AR) إعلان نصي لقارئ الشاشة
        متغير حدث = جديد حدث_دلالات("إعلان", رسالة, 0)
        هذا._أحداث_معلقة = هذا._أحداث_معلقة + [حدث]
        ارجع هذا
    نهاية

    دالة الأحداث_المعلقة()
        متغير أحداث = هذا._أحداث_معلقة
        هذا._أحداث_معلقة = []
        ارجع أحداث
    نهاية
نهاية
