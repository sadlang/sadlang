## استخراج بيانات صفوف حرف (8 قيم)
## حرف: حرف واحد (نص بطول 1)
## يُرجع: مصفوفة من 8 أرقام تمثل صفوف البكسلات
صدّر دالة خط_صفوف(حرف)
    متغير كود = رمز_حرف(حرف, 0)
    إذا (كود < 32)
        ارجع [0, 0, 0, 0, 0, 0, 0, 0]
    نهاية
    إذا (كود > 126)
        # حرف غير مدعوم — ارسم مربع ■
        ارجع [255, 129, 129, 129, 129, 129, 255, 0]
    نهاية
    متغير بداية = (كود - 32) * 8
    ارجع [
        _بيانات_خط[بداية],
        _بيانات_خط[بداية + 1],
        _بيانات_خط[بداية + 2],
        _بيانات_خط[بداية + 3],
        _بيانات_خط[بداية + 4],
        _بيانات_خط[بداية + 5],
        _بيانات_خط[بداية + 6],
        _بيانات_خط[بداية + 7]
    ]
نهاية

## فحص هل البت في الموقع المحدد مضاء
## قيمة: رقم صف البكسلات (0-255)
## عمود: موقع البت (0=يسار، 7=يمين)
صدّر دالة خط_بت(قيمة, عمود)
    # حساب يدوي لعملية AND بدلاً من بت_و() لتوافق دلالي
    متغير قوة = _قوى_2[عمود]
    متغير مقسوم = (قيمة - قيمة % قوة) / قوة
    ارجع مقسوم % 2 == 1
نهاية

