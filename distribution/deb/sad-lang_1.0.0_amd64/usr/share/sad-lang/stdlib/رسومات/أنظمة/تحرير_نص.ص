# ─── متحكم_نص (TextEditingController) ─── [نظام 45]
صدّر صنف متحكم_نص
    باني(نص = "")
        هذا._نص = نص
        هذا._تحديد = {"بداية": 0, "نهاية": 0}
        هذا._مستمعون = []
    نهاية

    دالة النص()
        ارجع هذا._نص
    نهاية

    دالة عيّن_نص(نص_جديد)
        هذا._نص = نص_جديد
        هذا._أعلم()
    نهاية

    دالة التحديد()
        ارجع هذا._تحديد
    نهاية

    دالة عيّن_تحديد(بداية, آخر)
        هذا._تحديد = {"بداية": بداية, "نهاية": آخر}
        هذا._أعلم()
    نهاية

    دالة امسح()
        هذا._نص = ""
        هذا._تحديد = {"بداية": 0, "نهاية": 0}
        هذا._أعلم()
    نهاية

    دالة أضف_مستمع(رد_نداء)
        هذا._مستمعون = هذا._مستمعون + [رد_نداء]
    نهاية

    دالة أزل_مستمع(رد_نداء)
        متغير جديدة = []
        لكل م في هذا._مستمعون
            إذا (م != رد_نداء)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مستمعون = جديدة
    نهاية

    دالة _أعلم()
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
    نهاية
نهاية

