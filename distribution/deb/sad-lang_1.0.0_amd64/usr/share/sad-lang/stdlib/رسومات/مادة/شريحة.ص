# ─── شارة (Badge) ─── [عنصر جديد 1]
صدّر صنف شارة يرث عنصر
    باني(ابن = لاشيء, تسمية = لاشيء, لون_خلفية = لاشيء, لون_نص = لاشيء, حجم_صغير = لاشيء, ظاهرة = صحيح, محاذاة = لاشيء)
        هذا._نوع = "شارة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["لون_خلفية"] = لون_خلفية
        هذا._خصائص["لون_نص"] = لون_نص
        هذا._خصائص["حجم_صغير"] = حجم_صغير
        هذا._خصائص["ظاهرة"] = ظاهرة
        هذا._خصائص["محاذاة"] = محاذاة
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية

    دالة عيّن_التسمية(تسمية)
        هذا._خصائص["تسمية"] = تسمية
        ارجع هذا
    نهاية

    دالة عيّن_الظهور(ظاهرة)
        هذا._خصائص["ظاهرة"] = ظاهرة
        ارجع هذا
    نهاية
نهاية

