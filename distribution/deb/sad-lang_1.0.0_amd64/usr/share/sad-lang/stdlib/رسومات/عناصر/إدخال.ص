# ===================================================================
#                    نموذج: Form — نظام التحقق المتكامل
# ===================================================================
صدّر صنف نموذج يرث عنصر
    باني(أبناء = لاشيء, عند_الإرسال = لاشيء, تحقق_تلقائي = خطأ)
        هذا._نوع = "نموذج"
        هذا._أبناء = أبناء
        هذا._خصائص = {}
        هذا._خصائص["عند_الإرسال"] = عند_الإرسال
        هذا._خصائص["تحقق_تلقائي"] = تحقق_تلقائي
        هذا._قيم = {}
        هذا._أخطاء = {}
        هذا._محققات = {}
    نهاية

    دالة سجّل_حقل(اسم, محقق = لاشيء)
        هذا._محققات[اسم] = محقق
        ارجع هذا
    نهاية

    دالة عيّن_قيمة_حقل(اسم, قيمة)
        هذا._قيم[اسم] = قيمة
        إذا (هذا._خصائص["تحقق_تلقائي"])
            هذا._تحقق_حقل(اسم)
        نهاية
        ارجع هذا
    نهاية

    دالة احصل_قيمة_حقل(اسم)
        ارجع هذا._قيم[اسم]
    نهاية

    دالة _تحقق_حقل(اسم)
        متغير محقق = هذا._محققات[اسم]
        إذا (محقق != لاشيء)
            متغير نتيجة = محقق(هذا._قيم[اسم])
            إذا (نتيجة != لاشيء)
                هذا._أخطاء[اسم] = نتيجة
            وإلا
                هذا._أخطاء[اسم] = لاشيء
            نهاية
        نهاية
    نهاية

    دالة تحقق()
        متغير صحيح = صحيح
        لكل اسم في هذا._محققات
            هذا._تحقق_حقل(اسم)
            إذا (هذا._أخطاء[اسم] != لاشيء)
                صحيح = خطأ
            نهاية
        نهاية
        ارجع صحيح
    نهاية

    دالة احصل_خطأ(اسم)
        ارجع هذا._أخطاء[اسم]
    نهاية

    دالة إرسال()
        إذا (هذا.تحقق())
            متغير معالج = هذا._خصائص["عند_الإرسال"]
            إذا (معالج != لاشيء)
                معالج(هذا._قيم)
            نهاية
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة امسح()
        هذا._قيم = {}
        هذا._أخطاء = {}
        ارجع هذا
    نهاية
نهاية

