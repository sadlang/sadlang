صدّر صنف حقل يرث عنصر
    باني(تلميح = لاشيء, قيمة = لاشيء, نوع = لاشيء, عند_التغيير = لاشيء, أيقونة = لاشيء, تسمية = لاشيء, لون_الحد = لاشيء, لون_خلفية = لاشيء, حجم_الخط = لاشيء, زوايا = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "حقل"
        هذا._خصائص = {}
        هذا._خصائص["تلميح"] = تلميح
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["نوع"] = نوع
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["أيقونة"] = أيقونة
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["لون_الحد"] = لون_الحد
        هذا._خصائص["لون_خلفية"] = لون_خلفية
        هذا._خصائص["حجم_الخط"] = حجم_الخط
        هذا._خصائص["زوايا"] = زوايا
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    دالة احصل_القيمة()
        ارجع هذا._خصائص["قيمة"]
    نهاية

    دالة عيّن_القيمة(قيمة)
        هذا._خصائص["قيمة"] = قيمة
        ارجع هذا
    نهاية

    دالة احصل_التلميح()
        ارجع هذا._خصائص["تلميح"]
    نهاية

    دالة عيّن_التلميح(قيمة)
        هذا._خصائص["تلميح"] = قيمة
        ارجع هذا
    نهاية

    دالة فارغ()
        ارجع هذا._خصائص["قيمة"] == لاشيء أو هذا._خصائص["قيمة"] == ""
    نهاية

    دالة امسح()
        هذا._خصائص["قيمة"] = ""
        ارجع هذا
    نهاية
