# ===================================================================
صدّر دالة محقق_مطلوب(رسالة = "هذا الحقل مطلوب")
    ارجع لامدا (قيمة)
        إذا (قيمة == لاشيء أو قيمة == "")
            ارجع رسالة
        نهاية
        ارجع لاشيء
    نهاية
نهاية

صدّر دالة محقق_بريد(رسالة = "بريد إلكتروني غير صالح")
    ارجع لامدا (قيمة)
        # تحقق بسيط من وجود @ و .
        إذا (قيمة == لاشيء أو قيمة == "")
            ارجع لاشيء
        نهاية
        # في التنفيذ الكامل: regex
        ارجع لاشيء
    نهاية
نهاية

صدّر دالة محقق_طول_أدنى(طول, رسالة = لاشيء)
    ارجع لامدا (قيمة)
        إذا (قيمة == لاشيء)
            ارجع لاشيء
        نهاية
        إذا (طول(قيمة) < طول)
            إذا (رسالة != لاشيء)
                ارجع رسالة
            نهاية
            ارجع "يجب ألا يقل عن " + طول + " أحرف"
        نهاية
        ارجع لاشيء
    نهاية
نهاية

