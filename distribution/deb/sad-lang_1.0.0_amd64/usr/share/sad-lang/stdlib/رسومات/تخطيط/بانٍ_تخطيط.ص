# ─── صندوق حجم الكسر (FractionallySizedBox) ───
صدّر صنف صندوق_حجم_كسري يرث عنصر
    باني(
        ابن = لاشيء،
        عامل_عرض = لاشيء،
        عامل_ارتفاع = لاشيء،
        محاذاة = "وسط"
    )
        هذا._نوع = "صندوق_حجم_كسري"
        هذا._ابن = ابن
        هذا._عامل_عرض = عامل_عرض
        هذا._عامل_ارتفاع = عامل_ارتفاع
        هذا._محاذاة = محاذاة
    نهاية
نهاية

