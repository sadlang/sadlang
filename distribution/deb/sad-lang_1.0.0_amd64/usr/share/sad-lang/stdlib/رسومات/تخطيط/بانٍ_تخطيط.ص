استورد * من رسومات.أساس.عنصر

# ─── قيود الصندوق (BoxConstraints) ───
صدّر صنف قيود_صندوق
    باني(أدنى_عرض = 0، أقصى_عرض = لا_نهائي، أدنى_ارتفاع = 0، أقصى_ارتفاع = لا_نهائي)
        هذا.أدنى_عرض = أدنى_عرض
        هذا.أقصى_عرض = أقصى_عرض
        هذا.أدنى_ارتفاع = أدنى_ارتفاع
        هذا.أقصى_ارتفاع = أقصى_ارتفاع
    نهاية

    # ─── خصائص محسوبة ───
    دالة أكبر_عرض()
        ارجع هذا.أقصى_عرض
    نهاية

    دالة أكبر_ارتفاع()
        ارجع هذا.أقصى_ارتفاع
    نهاية

    دالة أصغر_عرض()
        ارجع هذا.أدنى_عرض
    نهاية

    دالة أصغر_ارتفاع()
        ارجع هذا.أدنى_ارتفاع
    نهاية

    دالة لديه_عرض_محدود()
        ارجع هذا.أقصى_عرض < لا_نهائي
    نهاية

    دالة لديه_ارتفاع_محدود()
        ارجع هذا.أقصى_ارتفاع < لا_نهائي
    نهاية

    دالة لديه_حجم_أدنى_موحد()
        ارجع هذا.أدنى_عرض == هذا.أقصى_عرض
    نهاية

    دالة لديه_حجم_أقصى_موحد()
        ارجع هذا.أدنى_ارتفاع == هذا.أقصى_ارتفاع
    نهاية

    دالة ضيقة()
        ارجع هذا.أدنى_عرض == هذا.أقصى_عرض و هذا.أدنى_ارتفاع == هذا.أقصى_ارتفاع
    نهاية

    # ─── منشئات ثابتة ───
    ساكن دالة ضيقة_كاملة(عرض، ارتفاع)
        ارجع جديد قيود_صندوق(عرض، عرض، ارتفاع، ارتفاع)
    نهاية

    ساكن دالة ضيقة_عرض(عرض)
        ارجع جديد قيود_صندوق(عرض، عرض، 0، لا_نهائي)
    نهاية

    ساكن دالة ضيقة_ارتفاع(ارتفاع)
        ارجع جديد قيود_صندوق(0، لا_نهائي، ارتفاع، ارتفاع)
    نهاية

    ساكن دالة فضفاضة(عرض، ارتفاع)
        ارجع جديد قيود_صندوق(0، عرض، 0، ارتفاع)
    نهاية

    ساكن دالة توسيع(عرض = لا_نهائي، ارتفاع = لا_نهائي)
        ارجع جديد قيود_صندوق(
            عرض == لا_نهائي ? 0 : عرض،
            عرض،
            ارتفاع == لا_نهائي ? 0 : ارتفاع،
            ارتفاع
        )
    نهاية

    # ─── تعديل القيود ───
    دالة قيّد(حجم)
        ارجع {
            "عرض": هذا._قيّد_عرض(حجم["عرض"])،
            "ارتفاع": هذا._قيّد_ارتفاع(حجم["ارتفاع"])
        }
    نهاية

    دالة _قيّد_عرض(عرض)
        إذا (عرض < هذا.أدنى_عرض)
            ارجع هذا.أدنى_عرض
        نهاية
        إذا (عرض > هذا.أقصى_عرض)
            ارجع هذا.أقصى_عرض
        نهاية
        ارجع عرض
    نهاية

    دالة _قيّد_ارتفاع(ارتفاع)
        إذا (ارتفاع < هذا.أدنى_ارتفاع)
            ارجع هذا.أدنى_ارتفاع
        نهاية
        إذا (ارتفاع > هذا.أقصى_ارتفاع)
            ارجع هذا.أقصى_ارتفاع
        نهاية
        ارجع ارتفاع
    نهاية

    دالة أكبر_حجم()
        ارجع {
            "عرض": هذا.أقصى_عرض،
            "ارتفاع": هذا.أقصى_ارتفاع
        }
    نهاية

    دالة أصغر_حجم()
        ارجع {
            "عرض": هذا.أدنى_عرض،
            "ارتفاع": هذا.أدنى_ارتفاع
        }
    نهاية

    دالة تطبيق(قيود_أب)
        ارجع جديد قيود_صندوق(
            هذا._قيّد_عرض_مع_أب(هذا.أدنى_عرض، قيود_أب)،
            هذا._قيّد_عرض_مع_أب(هذا.أقصى_عرض، قيود_أب)،
            هذا._قيّد_ارتفاع_مع_أب(هذا.أدنى_ارتفاع، قيود_أب)،
            هذا._قيّد_ارتفاع_مع_أب(هذا.أقصى_ارتفاع، قيود_أب)
        )
    نهاية

    دالة _قيّد_عرض_مع_أب(عرض، قيود_أب)
        ارجع قيود_أب._قيّد_عرض(عرض)
    نهاية

    دالة _قيّد_ارتفاع_مع_أب(ارتفاع، قيود_أب)
        ارجع قيود_أب._قيّد_ارتفاع(ارتفاع)
    نهاية
نهاية

# ─── ثابت لا نهائي ───
ثابت لا_نهائي = 1e308

# ─── بانٍ التخطيط (LayoutBuilder) ───
صدّر صنف بانٍ_تخطيط يرث عنصر
    باني(بانٍ)
        هذا._نوع = "بانٍ_تخطيط"
        هذا._بانٍ = بانٍ
    نهاية

    دالة ابنِ(سياق، قيود)
        ارجع هذا._بانٍ(سياق، قيود)
    نهاية
نهاية

# ─── بانٍ محدود (ConstrainedBox) ───
صدّر صنف صندوق_مقيّد يرث عنصر
    باني(قيود، ابن = لاشيء)
        هذا._نوع = "صندوق_مقيّد"
        هذا._قيود = قيود
        هذا._ابن = ابن
    نهاية
نهاية

# ─── صندوق غير مقيّد (UnconstrainedBox) ───
صدّر صنف صندوق_غير_مقيّد يرث عنصر
    باني(ابن، محاذاة = "وسط"، محور_مقيّد = لاشيء)
        هذا._نوع = "صندوق_غير_مقيّد"
        هذا._ابن = ابن
        هذا._محاذاة = محاذاة
        هذا._محور_مقيّد = محور_مقيّد
    نهاية
نهاية

# ─── صندوق بحجم محدد (SizedBox) ───
صدّر صنف صندوق_بحجم يرث عنصر
    باني(عرض = لاشيء، ارتفاع = لاشيء، ابن = لاشيء)
        هذا._نوع = "صندوق_بحجم"
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
        هذا._ابن = ابن
    نهاية

    ساكن دالة توسيع(ابن = لاشيء)
        ارجع جديد صندوق_بحجم(لا_نهائي، لا_نهائي، ابن)
    نهاية

    ساكن دالة تقليص(ابن = لاشيء)
        ارجع جديد صندوق_بحجم(0، 0، ابن)
    نهاية

    ساكن دالة من_حجم(حجم، ابن = لاشيء)
        ارجع جديد صندوق_بحجم(حجم["عرض"]، حجم["ارتفاع"]، ابن)
    نهاية

    ساكن دالة مربع(بعد، ابن = لاشيء)
        ارجع جديد صندوق_بحجم(بعد، بعد، ابن)
    نهاية
نهاية

