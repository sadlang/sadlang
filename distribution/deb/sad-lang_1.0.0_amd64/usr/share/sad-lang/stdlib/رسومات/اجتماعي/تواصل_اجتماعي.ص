# #199: Poll
صدّر صنف خيار_استطلاع
    باني(إعدادات)
        هذا.معرف = إعدادات.معرف أو مولّد_معرف()
        هذا.نص = إعدادات.نص أو ""
        هذا.أصوات = إعدادات.أصوات أو 0
    نهاية
نهاية

صدّر صنف استطلاع
    باني(إعدادات)
        هذا.سؤال = إعدادات.سؤال أو ""
        هذا.خيارات = إعدادات.خيارات أو []
        هذا.متعدد = إعدادات.متعدد أو خطأ
        هذا.ينتهي = إعدادات.ينتهي أو لاشيء
        هذا.صوّتت = إعدادات.صوّتت أو لاشيء
    نهاية

    دالة نسبة_خيار(معرف)
        متغير إجمالي = 0
        لكل خيار في هذا.خيارات
            إجمالي += خيار.أصوات
        نهاية
        
        إذا (إجمالي == 0)
            ارجع 0
        نهاية
        
        متغير خيار = هذا.خيارات.ابحث(لامدا(خ) => خ.معرف == معرف نهاية)
        إذا (خيار)
            ارجع (خيار.أصوات / إجمالي) * 100
        نهاية
        ارجع 0
    نهاية

    دالة بناء()
        ارجع {
            نوع: "استطلاع"،
            سؤال: هذا.سؤال،
            خيارات: هذا.خيارات،
            صوّتت: هذا.صوّتت
        }
    نهاية
نهاية

