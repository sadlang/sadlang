نهاية

صدّر صنف منشور
    باني(إعدادات)
        هذا.معرف = إعدادات.معرف أو مولّد_معرف()
        هذا.مؤلف = إعدادات.مؤلف
        هذا.نوع = إعدادات.نوع أو نوع_منشور.نص
        هذا.محتوى = إعدادات.محتوى أو ""
        هذا.وسائط = إعدادات.وسائط أو []
        هذا.تاريخ = إعدادات.تاريخ أو وقت_الآن()
        هذا.إعجابات = إعدادات.إعجابات أو 0
        هذا.تعليقات = إعدادات.تعليقات أو 0
        هذا.مشاركات = إعدادات.مشاركات أو 0
        هذا.أعجبني = إعدادات.أعجبني أو خطأ
        هذا.محفوظ = إعدادات.محفوظ أو خطأ
    نهاية
نهاية

صدّر صنف بطاقة_منشور
    باني(إعدادات)
        هذا._منشور = إعدادات.منشور
        هذا._عند_إعجاب = إعدادات.عند_إعجاب أو لاشيء
        هذا._عند_تعليق = إعدادات.عند_تعليق أو لاشيء
        هذا._عند_مشاركة = إعدادات.عند_مشاركة أو لاشيء
        هذا._عند_حفظ = إعدادات.عند_حفظ أو لاشيء
        هذا._أظهر_إجراءات = إعدادات.أظهر_إجراءات أو صحيح
    نهاية

    دالة بناء()
        ارجع {
            نوع: "بطاقة_منشور"،
            منشور: هذا._منشور،
            أظهر_إجراءات: هذا._أظهر_إجراءات
        }
    نهاية
نهاية

صدّر صنف خلاصة
    باني(إعدادات)
        هذا._منشورات = إعدادات.منشورات أو []
        هذا._جاري_تحميل = خطأ
        هذا._انتهت = خطأ
        هذا._عند_تحميل_المزيد = إعدادات.عند_تحميل_المزيد أو لاشيء
        هذا._عند_تحديث = إعدادات.عند_تحديث أو لاشيء
    نهاية

    غير_متزامن دالة حمّل_المزيد()
        إذا (هذا._جاري_تحميل أو هذا._انتهت)
            ارجع
        نهاية
        
        هذا._جاري_تحميل = صحيح
        
        إذا (هذا._عند_تحميل_المزيد)
            متغير جديدة = انتظر هذا._عند_تحميل_المزيد()
            هذا._منشورات = هذا._منشورات.ادمج(جديدة)
            
            إذا (جديدة.الطول() == 0)
                هذا._انتهت = صحيح
            نهاية
        نهاية
        
        هذا._جاري_تحميل = خطأ
    نهاية

    غير_متزامن دالة تحديث()
        إذا (هذا._عند_تحديث)
            هذا._منشورات = انتظر هذا._عند_تحديث()
            هذا._انتهت = خطأ
        نهاية
    نهاية

    دالة بناء()
        ارجع {
            نوع: "خلاصة"،
            منشورات: هذا._منشورات،
            جاري_تحميل: هذا._جاري_تحميل
        }
    نهاية
نهاية

