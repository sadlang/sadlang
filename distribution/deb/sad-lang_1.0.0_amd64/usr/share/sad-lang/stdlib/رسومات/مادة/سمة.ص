# ===================================================================
# Material Design — السمات والثيم
# ===================================================================
# ThemeData, ColorScheme, TextTheme, Typography — M3
# مطابق لـ flutter/material/theme_data.dart + color_scheme.dart
#
# الاستخدام:
#   استورد * من رسومات.مادة.سمة
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── مخطط_ألوان (ColorScheme — M3) ───
صدّر صنف مخطط_ألوان
    باني()
        هذا.أساسي = "#6750A4"
        هذا.على_أساسي = "#FFFFFF"
        هذا.حاوية_أساسي = "#EADDFF"
        هذا.على_حاوية_أساسي = "#21005D"
        هذا.ثانوي = "#625B71"
        هذا.على_ثانوي = "#FFFFFF"
        هذا.حاوية_ثانوي = "#E8DEF8"
        هذا.ثالثي = "#7D5260"
        هذا.على_ثالثي = "#FFFFFF"
        هذا.خطأ = "#B3261E"
        هذا.على_خطأ = "#FFFFFF"
        هذا.خلفية = "#FFFBFE"
        هذا.على_خلفية = "#1C1B1F"
        هذا.سطح = "#FFFBFE"
        هذا.على_سطح = "#1C1B1F"
        هذا.نمط = "فاتح"
    نهاية

    ساكن دالة فاتح()
        ارجع جديد مخطط_ألوان()
    نهاية

    ساكن دالة داكن()
        متغير م = جديد مخطط_ألوان()
        م.خلفية = "#1C1B1F"
        م.على_خلفية = "#E6E1E5"
        م.سطح = "#1C1B1F"
        م.على_سطح = "#E6E1E5"
        م.حاوية_أساسي = "#4F378B"
        م.على_حاوية_أساسي = "#EADDFF"
        م.نمط = "داكن"
        ارجع م
    نهاية

    ساكن دالة من_بذرة(لون_بذرة)
        متغير م = جديد مخطط_ألوان()
        م.أساسي = لون_بذرة
        ارجع م
    نهاية
نهاية

