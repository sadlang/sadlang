نهاية

# ─── بيانات_السمة (ThemeData — M3) ───
صدّر صنف بيانات_السمة
    باني(مخطط = لاشيء)
        إذا (مخطط == لاشيء)
            مخطط = جديد مخطط_ألوان()
        نهاية
        هذا.مخطط_الألوان = مخطط
        هذا.سمة_النص = جديد سمة_نص()
        هذا.استخدام_مادة3 = صحيح
        هذا.سطوع = "فاتح"
        هذا.عائلة_الخط = لاشيء
        هذا.نصف_قطر_الحد = 12
    نهاية

    ساكن دالة فاتح(بذرة = لاشيء)
        إذا (بذرة != لاشيء)
            ارجع جديد بيانات_السمة(مخطط_ألوان.من_بذرة(بذرة))
        نهاية
        ارجع جديد بيانات_السمة(مخطط_ألوان.فاتح())
    نهاية

    ساكن دالة داكن(بذرة = لاشيء)
        متغير س = جديد بيانات_السمة(مخطط_ألوان.داكن())
        س.سطوع = "داكن"
        ارجع س
    نهاية
نهاية

# ─── عنصر_السمة (Theme widget) ───
صدّر صنف عنصر_السمة يرث عنصر
    باني(بيانات, ابن = لاشيء)
        هذا._نوع = "عنصر_السمة"
        هذا._خصائص = {}
        هذا._خصائص["بيانات"] = بيانات
        هذا._ابن = ابن
    نهاية
نهاية

# ─── تطبيق_مادة (MaterialApp) ───
صدّر صنف تطبيق_مادة يرث عنصر
    باني(عنوان = لاشيء, سمة = لاشيء, سمة_داكنة = لاشيء, الصفحة_الرئيسية = لاشيء)
        هذا._نوع = "تطبيق_مادة"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["سمة"] = سمة
        هذا._خصائص["سمة_داكنة"] = سمة_داكنة
        هذا._خصائص["الصفحة_الرئيسية"] = الصفحة_الرئيسية
        هذا._خصائص["وضع_السمة"] = "نظام"
        هذا._خصائص["إظهار_لافتة_تصحيح"] = خطأ
        هذا._خصائص["مسارات"] = {}
    نهاية

    دالة مع_مسارات(مسارات)
        هذا._خصائص["مسارات"] = مسارات
        ارجع هذا
    نهاية

    دالة مع_وضع_سمة(وضع)
        هذا._خصائص["وضع_السمة"] = وضع
        ارجع هذا
    نهاية
نهاية

# ─── هيكل_مادة (Scaffold — M3) ───
صدّر صنف هيكل_مادة يرث عنصر
    باني(جسم = لاشيء, شريط_تطبيق = لاشيء, شريط_تنقل_سفلي = لاشيء, درج = لاشيء, زر_عائم = لاشيء)
        هذا._نوع = "هيكل_مادة"
        هذا._خصائص = {}
        هذا._خصائص["جسم"] = جسم
        هذا._خصائص["شريط_تطبيق"] = شريط_تطبيق
        هذا._خصائص["شريط_تنقل_سفلي"] = شريط_تنقل_سفلي
        هذا._خصائص["درج"] = درج
        هذا._خصائص["زر_عائم"] = زر_عائم
        هذا._خصائص["لون_خلفية"] = لاشيء
        هذا._خصائص["درج_نهاية"] = لاشيء
        هذا._خصائص["شريط_سفلي"] = لاشيء
    نهاية
نهاية
