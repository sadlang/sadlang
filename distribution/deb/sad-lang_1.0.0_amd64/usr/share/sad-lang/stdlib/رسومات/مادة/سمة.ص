    باني()
        هذا.عرض_كبير = {"حجم": 57, "وزن": "عادي"}
        هذا.عرض_متوسط = {"حجم": 45, "وزن": "عادي"}
        هذا.عرض_صغير = {"حجم": 36, "وزن": "عادي"}
        هذا.عنوان_كبير = {"حجم": 32, "وزن": "عادي"}
        هذا.عنوان_متوسط = {"حجم": 28, "وزن": "عادي"}
        هذا.عنوان_صغير = {"حجم": 24, "وزن": "عادي"}
        هذا.تسمية_كبيرة = {"حجم": 16, "وزن": "متوسط"}
        هذا.تسمية_متوسطة = {"حجم": 14, "وزن": "متوسط"}
        هذا.تسمية_صغيرة = {"حجم": 11, "وزن": "متوسط"}
        هذا.جسم_كبير = {"حجم": 16, "وزن": "عادي"}
