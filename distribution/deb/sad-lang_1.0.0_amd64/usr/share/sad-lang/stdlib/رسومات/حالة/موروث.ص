# ===================================================================
# نظام العنصر الموروث — InheritedWidget Pattern
# ===================================================================
# مستوحى من Flutter (InheritedWidget, InheritedModel)
# يسمح بنقل البيانات أسفل شجرة العناصر بدون تمرير يدوي
#
# الاستخدام:
#   استورد * من رسومات.حالة.موروث
# ===================================================================

# ─── سجل المورثات (Registry) ───
متغير _مورثات = {}

# ─── عنصر_موروث (InheritedWidget) ───
صدّر صنف عنصر_موروث
    باني(اسم, بيانات)
        هذا._اسم = اسم
        هذا._بيانات = بيانات
        هذا._مستمعون = []
        # تسجيل في السجل العام
        _مورثات[اسم] = هذا
    نهاية

    دالة البيانات()
        ارجع هذا._بيانات
    نهاية

    دالة حدّث(بيانات_جديدة)
        متغير قديمة = هذا._بيانات
        هذا._بيانات = بيانات_جديدة
        إذا (قديمة != بيانات_جديدة)
            هذا._أشعر()
        نهاية
    نهاية

    دالة استمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
        ارجع هذا
    نهاية

    دالة _أشعر()
        لكل م في هذا._مستمعون
            م(هذا._بيانات)
        نهاية
    نهاية

    دالة تنظيف()
        هذا._مستمعون = []
        _مورثات[هذا._اسم] = لاشيء
    نهاية
نهاية

# ─── الحصول على عنصر موروث بالاسم ───
صدّر دالة من_سياق(اسم)
    ارجع _مورثات[اسم]
نهاية

# ─── نموذج_موروث (InheritedModel — with aspects) ───
صدّر صنف نموذج_موروث يرث عنصر_موروث
    باني(اسم, بيانات)
        الأساس(اسم, بيانات)
        هذا._مستمعو_جانب = {}
    نهاية

    دالة استمع_جانب(جانب, مستمع)
        إذا (هذا._مستمعو_جانب[جانب] == لاشيء)
            هذا._مستمعو_جانب[جانب] = []
        نهاية
        هذا._مستمعو_جانب[جانب].أضف(مستمع)
        ارجع هذا
    نهاية

    دالة حدّث_جانب(جانب, قيمة)
        هذا._بيانات[جانب] = قيمة
        # إشعار مستمعي هذا الجانب فقط
        متغير مستمعون = هذا._مستمعو_جانب[جانب]
        إذا (مستمعون != لاشيء)
            لكل م في مستمعون
                م(قيمة)
            نهاية
        نهاية
    نهاية
نهاية

# ─── باني_موروث (InheritedBuilder helper) ───
صدّر دالة باني_موروث(اسم, باني)
    متغير موروث = من_سياق(اسم)
    إذا (موروث != لاشيء)
        دالة _مستمع(بيانات)
            باني(بيانات)
        نهاية
        موروث.استمع(_مستمع)
        # استدعاء أولي بالبيانات الحالية
        باني(موروث.البيانات())
    نهاية
نهاية
