    نهاية

    دالة صدّر(بيانات، مسار)
        متغير محتوى = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
        محتوى += "<" + هذا._جذر + ">\n"
        
        لكل عنصر في بيانات
            محتوى += هذا._حوّل_عنصر(عنصر، هذا._عنصر، 1)
        نهاية
        
        محتوى += "</" + هذا._جذر + ">"
        
        # سيتم كتابة الملف في C++
        ارجع {نجاح: صحيح، مسار: مسار}
    نهاية

    دالة _حوّل_عنصر(قيمة، اسم، مستوى)
        ارجع ""
    نهاية
نهاية

