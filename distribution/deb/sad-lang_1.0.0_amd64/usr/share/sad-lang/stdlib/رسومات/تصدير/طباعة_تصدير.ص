# العيب #113: PrintPreview - معاينة الطباعة
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف معاينة_طباعة
    باني(إعدادات)
        هذا._محتوى = إعدادات.محتوى
        هذا._توجيه = إعدادات.توجيه
        هذا._حجم = إعدادات.حجم
        هذا._هوامش = إعدادات.هوامش أو {أعلى: 20، أسفل: 20، يمين: 20، يسار: 20}
        
        هذا._صفحات = []
        هذا._صفحة_حالية = 0
        هذا._تكبير = 1.0
    نهاية

    دالة توليد_صفحات()
        # سيتم تنفيذها في C++
        ارجع هذا._صفحات
    نهاية

    دالة التالية()
        إذا (هذا._صفحة_حالية < هذا._صفحات.الطول() - 1)
            هذا._صفحة_حالية += 1
        نهاية
    نهاية

    دالة السابقة()
        إذا (هذا._صفحة_حالية > 0)
            هذا._صفحة_حالية -= 1
        نهاية
    نهاية

    دالة اذهب_لصفحة(رقم)
        إذا (رقم >= 0 و رقم < هذا._صفحات.الطول())
            هذا._صفحة_حالية = رقم
        نهاية
    نهاية

    دالة كبّر(نسبة)
        هذا._تكبير = نسبة
    نهاية

    دالة بناء()
        ارجع {
            نوع: "معاينة_طباعة"،
            صفحات: هذا.توليد_صفحات()،
            صفحة_حالية: هذا._صفحة_حالية،
            تكبير: هذا._تكبير
        }
    نهاية
نهاية

