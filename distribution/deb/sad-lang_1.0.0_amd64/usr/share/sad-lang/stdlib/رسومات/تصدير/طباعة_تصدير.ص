صدّر صنف خدمة_الطباعة
    ساكن متغير _مثيل = لاشيء
    
    ساكن دالة احصل_مثيل()
        إذا (خدمة_الطباعة._مثيل == لاشيء)
            خدمة_الطباعة._مثيل = جديد خدمة_الطباعة()
        نهاية
        ارجع خدمة_الطباعة._مثيل
    نهاية

    باني()
        هذا._طابعات = []
        هذا._طابعة_افتراضية = لاشيء
        هذا._مهام = []
    نهاية

    دالة احصل_طابعات()
        # سيتم تنفيذها في C++
        ارجع هذا._طابعات
    نهاية

    دالة عيّن_طابعة_افتراضية(اسم)
        هذا._طابعة_افتراضية = اسم
    نهاية

    دالة اطبع(إعدادات)
        متغير مهمة = جديد مهمة_طباعة({
            محتوى: إعدادات.محتوى،
            طابعة: إعدادات.طابعة أو هذا._طابعة_افتراضية،
            نسخ: إعدادات.نسخ أو 1،
            توجيه: إعدادات.توجيه أو توجيه_ورقة.عمودي،
            حجم: إعدادات.حجم أو حجم_ورقة.A4،
            هوامش: إعدادات.هوامش أو {أعلى: 20، أسفل: 20، يمين: 20، يسار: 20}،
            ألوان: إعدادات.ألوان أو صحيح
        })
        
        هذا._مهام.أضف(مهمة)
        مهمة.ابدأ()
        
        ارجع مهمة
    نهاية

    دالة معاينة(محتوى، إعدادات)
        ارجع جديد معاينة_طباعة({
            محتوى: محتوى،
            توجيه: إعدادات.توجيه أو توجيه_ورقة.عمودي،
            حجم: إعدادات.حجم أو حجم_ورقة.A4،
            هوامش: إعدادات.هوامش
        })
    نهاية
نهاية

