# #116: CSVExporter
صدّر صنف مصدّر_CSV
    باني(إعدادات)
        هذا._فاصل = إعدادات.فاصل أو "،"
        هذا._ترويسة = إعدادات.ترويسة أو صحيح
        هذا._ترميز = إعدادات.ترميز أو "UTF-8"
    نهاية

    دالة صدّر(بيانات، مسار)
        متغير محتوى = ""
        
        إذا (بيانات.الطول() == 0)
            ارجع {نجاح: خطأ، خطأ: "لا توجد بيانات"}
        نهاية
        
        # الترويسة
        إذا (هذا._ترويسة)
            متغير أعمدة = بيانات[0].مفاتيح()
            محتوى = أعمدة.انضم(هذا._فاصل) + "\n"
        نهاية
        
        # البيانات
        لكل صف في بيانات
            متغير قيم = صف.قيم().خريطة(لامدا(ق) => هذا._هرّب(ق) نهاية)
            محتوى += قيم.انضم(هذا._فاصل) + "\n"
        نهاية
        
        # سيتم كتابة الملف في C++
        ارجع {نجاح: صحيح، مسار: مسار}
    نهاية

    دالة _هرّب(قيمة)
        متغير نص = نص(قيمة)
        إذا (نص.يحتوي_على(هذا._فاصل) أو نص.يحتوي_على("\""))
            ارجع "\"" + نص.استبدل("\"", "\"\"") + "\""
        نهاية
        ارجع نص
    نهاية
نهاية

