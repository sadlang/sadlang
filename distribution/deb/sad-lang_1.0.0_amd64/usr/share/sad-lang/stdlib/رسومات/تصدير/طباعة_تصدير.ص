# العيب #112: PrintJob - مهمة طباعة
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف مهمة_طباعة
    باني(إعدادات)
        هذا._معرف = إعدادات.معرف أو مولّد_معرف()
        هذا._محتوى = إعدادات.محتوى
        هذا._طابعة = إعدادات.طابعة
        هذا._نسخ = إعدادات.نسخ
        هذا._توجيه = إعدادات.توجيه
        هذا._حجم = إعدادات.حجم
        هذا._هوامش = إعدادات.هوامش
        هذا._ألوان = إعدادات.ألوان
        
        هذا._حالة = حالة_طباعة.انتظار
        هذا._تقدم = 0
        هذا._مستمعون = []
    نهاية

    دالة ابدأ()
        هذا._حالة = حالة_طباعة.جاري
        هذا._أخطر_مستمعين()
        # سيتم تنفيذ الطباعة الفعلية في C++
    نهاية

    دالة ألغِ()
        هذا._حالة = حالة_طباعة.ملغي
        هذا._أخطر_مستمعين()
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية

    دالة _أخطر_مستمعين()
        لكل مستمع في هذا._مستمعون
            مستمع({
                حالة: هذا._حالة،
                تقدم: هذا._تقدم
            })
        نهاية
    نهاية

    دالة احصل_حالة()
        ارجع هذا._حالة
    نهاية

    دالة احصل_تقدم()
        ارجع هذا._تقدم
    نهاية
نهاية

