# ===================================================================
# Material Design — التنقل
# ===================================================================
# NavigationBar, NavigationRail, NavigationDrawer, AppBar, TabBar
# مطابق لـ flutter/material/navigation*.dart
#
# الاستخدام:
#   استورد * من رسومات.مادة.تنقل
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── شريط_تنقل_مادة (NavigationBar — M3) ───
صدّر صنف شريط_تنقل_مادة يرث عنصر
    باني(وجهات = لاشيء, الفهرس_الحالي = 0, عند_التغيير = لاشيء)
        هذا._نوع = "شريط_تنقل_مادة"
        هذا._خصائص = {}
        هذا._خصائص["وجهات"] = وجهات
        هذا._خصائص["الفهرس_الحالي"] = الفهرس_الحالي
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["ارتفاع"] = 80
        هذا._خصائص["لون_مؤشر"] = لاشيء
        هذا._خصائص["لون_خلفية"] = لاشيء
    نهاية
نهاية

# ─── وجهة_تنقل (NavigationDestination) ───
صدّر صنف وجهة_تنقل
    باني(أيقونة, تسمية, أيقونة_محدد = لاشيء, شارة = لاشيء)
        هذا.أيقونة = أيقونة
        هذا.تسمية = تسمية
        هذا.أيقونة_محدد = أيقونة_محدد
        هذا.شارة = شارة
    نهاية
نهاية

