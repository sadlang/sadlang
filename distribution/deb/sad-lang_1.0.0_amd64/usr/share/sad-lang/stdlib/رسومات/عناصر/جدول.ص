# ===================================================================
# عناصر الجدول والبيانات — Data Table Widgets
# ===================================================================
# عناصر لعرض البيانات المنظمة
#
# ملاحظة: الأصناف التالية محذوفة (موجودة في ملفات أخرى):
#   تقويم → عناصر/منتقيات.ص
#   خط_زمني → حاويات/بيانات.ص
#
# الاستخدام:
#   استورد * من رسومات.عناصر.جدول
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ─── جدول (DataTable) ───
صدّر صنف جدول يرث عنصر
    باني(أعمدة = لاشيء, صفوف = لاشيء, قابل_ترتيب = لاشيء, عند_ترتيب = لاشيء)
        هذا._نوع = "جدول"
        هذا._خصائص = {}
        هذا._خصائص["أعمدة"] = أعمدة
        هذا._خصائص["صفوف"] = صفوف
        هذا._خصائص["قابل_ترتيب"] = قابل_ترتيب
        هذا._خصائص["عند_ترتيب"] = عند_ترتيب
    نهاية
نهاية

