# ─── جدول_مصفح (PaginatedDataTable) ───
صدّر صنف جدول_مصفح يرث عنصر
    باني(أعمدة = لاشيء, مصدر = لاشيء, صفوف_بالصفحة = لاشيء, عند_تغيير_صفحة = لاشيء)
        هذا._نوع = "جدول_مصفح"
        هذا._خصائص = {}
        هذا._خصائص["أعمدة"] = أعمدة
        هذا._خصائص["مصدر"] = مصدر
        هذا._خصائص["صفوف_بالصفحة"] = صفوف_بالصفحة
        هذا._خصائص["عند_تغيير_صفحة"] = عند_تغيير_صفحة
    نهاية
نهاية

# ─── مصدر_بيانات (DataTableSource — for pagination) ───
صدّر صنف مصدر_بيانات
    باني(بيانات)
        هذا._بيانات = بيانات
        هذا._صفحة = 0
        هذا._حجم = 10
    نهاية

    دالة الصفحة_الحالية()
        متغير بداية = هذا._صفحة * هذا._حجم
        متغير نتائج = []
        متغير ف = بداية
        بينما (ف < بداية + هذا._حجم و ف < طول(هذا._بيانات))
            نتائج.أضف(هذا._بيانات[ف])
            ف = ف + 1
        نهاية
        ارجع نتائج
    نهاية

    دالة التالي()
        إذا ((هذا._صفحة + 1) * هذا._حجم < طول(هذا._بيانات))
            هذا._صفحة = هذا._صفحة + 1
        نهاية
    نهاية

    دالة السابق()
        إذا (هذا._صفحة > 0)
            هذا._صفحة = هذا._صفحة - 1
        نهاية
    نهاية

    دالة عدد_الصفحات()
        ارجع (طول(هذا._بيانات) + هذا._حجم - 1) / هذا._حجم
    نهاية

    دالة الإجمالي()
        ارجع طول(هذا._بيانات)
    نهاية
نهاية

