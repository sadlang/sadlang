# ===================================================================
# Slivers — شرائح للتمرير المتقدم
# ===================================================================
# مطابق لـ Flutter CustomScrollView, SliverList, SliverGrid, etc.
# دعم كامل للتمرير المخصص والقوائم الكسولة
#
# الاستخدام:
#   استورد * من رسومات.تمرير_نظام.شرائح
#
#   عرض_تمرير_مخصص(
#       شرائح: [
#           شريط_تطبيق_منزلق(عنوان: "مرحباً"),
#           قائمة_شريحة(عناصر: [...])
#       ]
#   )
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    عرض_تمرير_مخصص (CustomScrollView)
# ===================================================================
صدّر صنف عرض_تمرير_مخصص يرث عنصر
    باني(شرائح = [], اتجاه = "عمودي", عكس = خطأ,
         متحكم = لاشيء, فيزياء = لاشيء, تقلص = خطأ,
         مركز = لاشيء, مرساة = 0.0, مدى_ذاكرة_تخزين = 0.0)
        هذا._نوع = "عرض_تمرير_مخصص"
        هذا._خصائص = {}
        هذا._خصائص["شرائح"] = شرائح
        هذا._خصائص["اتجاه"] = اتجاه
        هذا._خصائص["عكس"] = عكس
        هذا._خصائص["متحكم"] = متحكم
        هذا._خصائص["فيزياء"] = فيزياء
        هذا._خصائص["تقلص"] = تقلص
        هذا._خصائص["مركز"] = مركز
        هذا._خصائص["مرساة"] = مرساة
        هذا._خصائص["مدى_ذاكرة_تخزين"] = مدى_ذاكرة_تخزين
    نهاية

    دالة أضف_شريحة(شريحة)
        هذا._خصائص["شرائح"].أضف(شريحة)
        ارجع هذا
    نهاية
نهاية

# ===================================================================
#                    قائمة_شريحة (SliverList)
# ===================================================================
صدّر صنف قائمة_شريحة يرث عنصر
    باني(مفوض = لاشيء)
        هذا._نوع = "قائمة_شريحة"
        هذا._خصائص = {}
        هذا._خصائص["مفوض"] = مفوض
    نهاية
نهاية

# ===================================================================
#                    شبكة_شريحة (SliverGrid)
