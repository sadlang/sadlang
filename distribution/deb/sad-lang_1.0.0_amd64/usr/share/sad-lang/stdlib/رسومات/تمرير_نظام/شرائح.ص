# ===================================================================
#                    شريحة_مجموعة (SliverAnimatedList)
# ===================================================================
صدّر صنف شريحة_متحركة يرث عنصر
    باني(باني_أولي = لاشيء, عدد_أولي = 0)
        هذا._نوع = "شريحة_متحركة"
        هذا._خصائص = {}
        هذا._خصائص["باني_أولي"] = باني_أولي
        هذا._خصائص["عدد_أولي"] = عدد_أولي
    نهاية

    دالة أدرج(فهرس)
        # إدراج عنصر بحركة
        ارجع هذا
    نهاية

    دالة أزل(فهرس, باني)
        # إزالة عنصر بحركة
        ارجع هذا
    نهاية
نهاية

