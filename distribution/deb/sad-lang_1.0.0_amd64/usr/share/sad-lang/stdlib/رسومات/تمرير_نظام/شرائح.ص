# ===================================================================
#                    مفوض ابن القائمة (SliverChildDelegate)
# ===================================================================
صدّر صنف مفوض_أبناء_قائمة
    باني(باني, عدد_أبناء = لاشيء)
        هذا._باني = باني
        هذا._عدد = عدد_أبناء
    نهاية

    دالة العدد()
        ارجع هذا._عدد
    نهاية

    دالة ابنِ(فهرس)
        ارجع هذا._باني(فهرس)
    نهاية
نهاية

# ===================================================================
#                    مفوض ابن الشبكة (SliverGridDelegate)
# ===================================================================
صدّر صنف مفوض_شبكة_عدد_ثابت
    باني(عدد_أعمدة = 2, نسبة_عرض_ارتفاع = 1.0,
         تباعد_رئيسي = 0, تباعد_متقاطع = 0)
        هذا._عدد_أعمدة = عدد_أعمدة
        هذا._نسبة = نسبة_عرض_ارتفاع
        هذا._تباعد_رئيسي = تباعد_رئيسي
        هذا._تباعد_متقاطع = تباعد_متقاطع
    نهاية
نهاية

صدّر صنف مفوض_شبكة_مدى_ثابت
    باني(مدى_متقاطع = 200, تباعد_رئيسي = 0, تباعد_متقاطع = 0)
        هذا._مدى_متقاطع = مدى_متقاطع
        هذا._تباعد_رئيسي = تباعد_رئيسي
        هذا._تباعد_متقاطع = تباعد_متقاطع
    نهاية
نهاية

# ===================================================================
#                    خلفية_مرنة (FlexibleSpaceBar)
# ===================================================================
صدّر صنف خلفية_مرنة يرث عنصر
    باني(عنوان = لاشيء, خلفية = لاشيء, وضع_طي_عنوان = "تمدد",
         حشو_عنوان = لاشيء)
        هذا._نوع = "خلفية_مرنة"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["خلفية"] = خلفية
        هذا._خصائص["وضع_طي_عنوان"] = وضع_طي_عنوان
        هذا._خصائص["حشو_عنوان"] = حشو_عنوان
    نهاية
نهاية

# ===================================================================
#                    دوال مساعدة
# ===================================================================

# قائمة عدد محدد
صدّر دالة قائمة_شريحة_عدد(عدد, باني)
    ارجع قائمة_شريحة(مفوض: مفوض_أبناء_قائمة(باني, عدد))
نهاية

# شبكة عدد محدد
صدّر دالة شبكة_شريحة_عدد(عدد, باني, أعمدة = 2)
    ارجع شبكة_شريحة(
        مفوض: مفوض_أبناء_قائمة(باني, عدد),
        تفويض_شبكة: مفوض_شبكة_عدد_ثابت(عدد_أعمدة: أعمدة)
    )
نهاية

# عرض تمرير بسيط
صدّر دالة عرض_مخصص_بسيط(عنوان, عناصر)
    ارجع عرض_تمرير_مخصص(
        شرائح: [
            شريط_تطبيق_منزلق(عنوان: عنوان, عائم: صحيح, ثابت: صحيح),
            قائمة_شريحة_عدد(عناصر.حجم(), دالة(ف)
                ارجع عناصر[ف]
            نهاية)
        ]
    )
نهاية
