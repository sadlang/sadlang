صدّر صنف شبكة_شريحة يرث عنصر
    باني(مفوض = لاشيء, تفويض_شبكة = لاشيء)
        هذا._نوع = "شبكة_شريحة"
        هذا._خصائص = {}
        هذا._خصائص["مفوض"] = مفوض
        هذا._خصائص["تفويض_شبكة"] = تفويض_شبكة
    نهاية
نهاية

# ===================================================================
#                    شريط_تطبيق_منزلق (SliverAppBar)
# ===================================================================
صدّر صنف شريط_تطبيق_منزلق يرث عنصر
    باني(عنوان = لاشيء, إجراءات = [], تمدد = صحيح, ثابت = خطأ,
         عائم = خطأ, فوري = خطأ, مرن = صحيح,
         خلفية_مرنة = لاشيء, ارتفاع_متمدد = 200,
         لون_خلفية = لاشيء, لون_مقدمة = لاشيء,
         ظل = 4.0, شكل = لاشيء)
        هذا._نوع = "شريط_تطبيق_منزلق"
        هذا._خصائص = {}
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["إجراءات"] = إجراءات
        هذا._خصائص["تمدد"] = تمدد
        هذا._خصائص["ثابت"] = ثابت
        هذا._خصائص["عائم"] = عائم
        هذا._خصائص["فوري"] = فوري
        هذا._خصائص["مرن"] = مرن
        هذا._خصائص["خلفية_مرنة"] = خلفية_مرنة
        هذا._خصائص["ارتفاع_متمدد"] = ارتفاع_متمدد
        هذا._خصائص["لون_خلفية"] = لون_خلفية
        هذا._خصائص["لون_مقدمة"] = لون_مقدمة
        هذا._خصائص["ظل"] = ظل
        هذا._خصائص["شكل"] = شكل
    نهاية

    دالة عيّن_العنوان(عنوان)
        هذا._خصائص["عنوان"] = عنوان
        ارجع هذا
    نهاية

    دالة عيّن_خلفية_مرنة(خلفية)
        هذا._خصائص["خلفية_مرنة"] = خلفية
        ارجع هذا
    نهاية
نهاية

