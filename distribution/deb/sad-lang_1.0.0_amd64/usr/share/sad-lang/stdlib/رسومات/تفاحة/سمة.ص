# ─── ألوان_ديناميكية ───
## ألوان تتغير تلقائياً مع الوضع
صدّر صنف لون_ديناميكي_تفاحة
    باني(لون_فاتح, لون_داكن)
        هذا._فاتح = لون_فاتح
        هذا._داكن = لون_داكن
    نهاية

    دالة حل(سطوع)
        إذا (سطوع == "داكن")
            ارجع هذا._داكن
        نهاية
        ارجع هذا._فاتح
    نهاية

    ساكن دالة مع_سطوع(سطوع, فاتح, داكن)
        متغير ل = جديد لون_ديناميكي_تفاحة(فاتح, داكن)
        ارجع ل.حل(سطوع)
    نهاية
نهاية
