# ─── بيانات_سمة_تفاحة (CupertinoThemeData) ───
## بيانات السمة الكاملة
صدّر صنف بيانات_سمة_تفاحة
    باني(
        سطوع = "فاتح",
        لون_أساسي = "#007AFF",
        لون_تباين = مطابق = لاشيء,
        خط = لاشيء
    )
        هذا._سطوع = سطوع
        هذا._لون_أساسي = لون_أساسي
        هذا._لون_تباين = لون_تباين
        هذا._خط = خط
        
        # حساب الألوان بناء على السطوع
        هذا._ألوان = {}
        هذا._حدث_الألوان()
    نهاية

    دالة _حدث_الألوان()
        متغير ع = هذا._سطوع
        
        # خلفيات
        هذا._ألوان["خلفية"] = ألوان_نظام_تفاحة.خلفية_نظام[ع]
        هذا._ألوان["خلفية_سطح"] = ألوان_نظام_تفاحة.خلفية_ثانوية[ع]
        هذا._ألوان["خلفية_بطاقة"] = ألوان_نظام_تفاحة.خلفية_ثالثية[ع]
        
        # نصوص
        هذا._ألوان["نص"] = ألوان_نظام_تفاحة.نص_أولي[ع]
        هذا._ألوان["نص_ثانوي"] = ألوان_نظام_تفاحة.نص_ثانوي[ع]
        هذا._ألوان["نص_معطل"] = ألوان_نظام_تفاحة.نص_ثالثي[ع]
        
        # فواصل
        هذا._ألوان["فاصل"] = ألوان_نظام_تفاحة.فاصل[ع]
        
        # أزرار
        هذا._ألوان["زر"] = هذا._لون_أساسي
        هذا._ألوان["زر_نص"] = "#FFFFFF"
    نهاية

    دالة احصل_لون(اسم)
        ارجع هذا._ألوان[اسم]
    نهاية

    دالة داكن()
        هذا._سطوع = "داكن"
        هذا._حدث_الألوان()
        ارجع هذا
    نهاية

    دالة فاتح()
        هذا._سطوع = "فاتح"
        هذا._حدث_الألوان()
        ارجع هذا
    نهاية

    دالة نسخة(تعديلات = {})
        متغير نسخة = جديد بيانات_سمة_تفاحة(
            هذا._سطوع,
            تعديلات["لون_أساسي"] || هذا._لون_أساسي,
            تعديلات["لون_تباين"] || هذا._لون_تباين,
            تعديلات["خط"] || هذا._خط
        )
        ارجع نسخة
    نهاية
نهاية

# ─── سمة_تفاحة (CupertinoTheme) ───
## عنصر لتطبيق السمة على الأبناء
صدّر صنف سمة_تفاحة
    باني(بيانات, ابن)
        هذا._نوع = "سمة_تفاحة"
        هذا._بيانات = بيانات
        هذا._ابن = ابن
    نهاية

    ساكن دالة أوف(سياق)
        # يحصل على السمة الحالية من السياق
        ارجع سياق._سمة_تفاحة
    نهاية
نهاية

