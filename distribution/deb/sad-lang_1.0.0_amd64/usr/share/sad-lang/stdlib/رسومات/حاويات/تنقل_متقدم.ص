# ===================================================================
#                    تنقل_جانبي: SideNav (NavigationRail)
# ===================================================================

صدّر صنف تنقل_جانبي يرث عنصر
    باني(أبناء = لاشيء, الفهرس_الحالي = لاشيء, عند_التغيير = لاشيء, خلفية = لاشيء, مطوي = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "تنقل_جانبي"
        هذا._أبناء = أبناء
        هذا._خصائص = {}
        هذا._خصائص["الفهرس_الحالي"] = الفهرس_الحالي
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["خلفية"] = خلفية
        هذا._خصائص["مطوي"] = مطوي
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية

    دالة احصل_الفهرس()
        ارجع هذا._خصائص["الفهرس_الحالي"]
    نهاية

    دالة عيّن_الفهرس(قيمة)
        هذا._خصائص["الفهرس_الحالي"] = قيمة
        ارجع هذا
    نهاية
نهاية

