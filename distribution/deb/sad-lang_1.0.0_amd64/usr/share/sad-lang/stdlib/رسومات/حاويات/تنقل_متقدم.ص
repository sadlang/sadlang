استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    عرض_تنقل: NavigationView
# ===================================================================

صدّر صنف عرض_تنقل يرث عنصر
    باني(ابن = لاشيء, شريط = لاشيء, طريقة_عرض = لاشيء)
        هذا._نوع = "عرض_تنقل"
        هذا._ابن = ابن
        هذا._خصائص = {}
        هذا._خصائص["شريط"] = شريط
        هذا._خصائص["طريقة_عرض"] = طريقة_عرض
    نهاية
نهاية

