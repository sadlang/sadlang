# ─── دوال مساعدة للتنقل ───

## فتح صفحة جديدة بنمط iOS
صدّر دالة انتقل_تفاحة(سياق, صفحة)
    # يتم تنفيذها في وقت التشغيل
    ارجع {
        "نوع": "تنقل",
        "إجراء": "دفع",
        "مسار": جديد مسار_صفحة_تفاحة(صفحة)
    }
نهاية

