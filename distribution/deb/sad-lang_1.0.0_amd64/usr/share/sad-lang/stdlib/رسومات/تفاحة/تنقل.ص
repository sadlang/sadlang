# ─── هيكل_تبويب_تفاحة (CupertinoTabScaffold) ───
## هيكل تبويب كامل مع شريط تبويب سفلي
صدّر صنف هيكل_تبويب_تفاحة يرث عنصر
    باني(شريط_تبويب, بناء_تبويب, متحكم = لاشيء)
        هذا._نوع = "هيكل_تبويب_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["شريط_تبويب"] = شريط_تبويب
