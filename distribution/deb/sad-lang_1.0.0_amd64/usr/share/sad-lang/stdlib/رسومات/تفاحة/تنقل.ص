نهاية

# ─── متحكم_تبويب_تفاحة (CupertinoTabController) ───
## متحكم لإدارة التبويبات
صدّر صنف متحكم_تبويب_تفاحة
    باني(الفهرس_الأولي = 0)
        هذا._فهرس = الفهرس_الأولي
        هذا._مستمعون = []
    نهاية

    دالة احصل_فهرس()
        ارجع هذا._فهرس
    نهاية

    دالة عيّن_فهرس(قيمة)
        إذا (هذا._فهرس != قيمة)
            هذا._فهرس = قيمة
            لكل مستمع في هذا._مستمعون
                مستمع(قيمة)
            نهاية
        نهاية
    نهاية

    دالة أضف_مستمع(دالة_معالجة)
        هذا._مستمعون.أضف(دالة_معالجة)
    نهاية

    دالة أزل_مستمع(دالة_معالجة)
        هذا._مستمعون.أزل(دالة_معالجة)
    نهاية

    دالة تخلص()
        هذا._مستمعون = []
    نهاية
نهاية

