نهاية

# ─── ورقة_تفاحة (CupertinoSheet) ───
## ورقة منزلقة من الأسفل (iOS 15+ style sheet)
صدّر صنف ورقة_تفاحة يرث عنصر
    باني(ابن, قابلة_للسحب = صحيح)
        هذا._نوع = "ورقة_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = [ابن]
        هذا._خصائص["قابلة_للسحب"] = قابلة_للسحب
        هذا._خصائص["نصف_قطر_أعلى"] = 10
        هذا._خصائص["مقبض"] = صحيح
        هذا._خصائص["ارتفاع_أولي"] = 0.5  # 50% من الشاشة
        هذا._خصائص["ارتفاع_أقصى"] = 0.9  # 90% من الشاشة
        هذا._خصائص["نقاط_توقف"] = [0.5, 0.9]
    نهاية

    دالة نقاط_توقف(قائمة)
        هذا._خصائص["نقاط_توقف"] = قائمة
        ارجع هذا
    نهاية

    دالة بدون_مقبض()
        هذا._خصائص["مقبض"] = خطأ
        ارجع هذا
    نهاية
نهاية

