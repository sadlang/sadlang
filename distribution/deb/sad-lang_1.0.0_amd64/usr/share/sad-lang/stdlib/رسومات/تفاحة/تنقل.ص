# ─── مسار_صفحة_تفاحة (CupertinoPageRoute) ───
## مسار صفحة بانتقال iOS (slide from right)
صدّر صنف مسار_صفحة_تفاحة يرث عنصر
    باني(بناء, عنوان = لاشيء, ملء_شاشة = خطأ)
        هذا._نوع = "مسار_صفحة_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["بناء"] = بناء
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["ملء_شاشة"] = ملء_شاشة
        هذا._خصائص["قابل_للإغلاق"] = صحيح
        هذا._خصائص["إعدادات"] = لاشيء
    نهاية
نهاية

