# العيب #56: Switch - مفتاح
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف مفتاح
    باني(إعدادات)
        هذا._قيمة = إعدادات.قيمة أو خطأ
        هذا._لون_نشط = إعدادات.لون_نشط أو "#2196F3"
        هذا._لون_غير_نشط = إعدادات.لون_غير_نشط أو "#9E9E9E"
        هذا._عند_التغيير = إعدادات.عند_التغيير أو لاشيء
        هذا._معطل = إعدادات.معطل أو خطأ
    نهاية

    دالة بدّل()
        إذا (هذا._معطل)
            ارجع
        نهاية
        
        هذا._قيمة = ليس هذا._قيمة
        
        إذا (هذا._عند_التغيير)
            هذا._عند_التغيير(هذا._قيمة)
        نهاية
    نهاية

    دالة بناء()
        ارجع {
            نوع: "مفتاح"،
            قيمة: هذا._قيمة،
            لون: هذا._قيمة ? هذا._لون_نشط : هذا._لون_غير_نشط،
            معطل: هذا._معطل
        }
    نهاية
نهاية

