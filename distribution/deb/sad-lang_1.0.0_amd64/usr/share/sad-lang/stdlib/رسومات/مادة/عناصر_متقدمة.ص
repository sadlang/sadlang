# العيب #55: Slider - منزلق
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف منزلق
    باني(إعدادات)
        هذا._قيمة = إعدادات.قيمة أو 0
        هذا._حد_أدنى = إعدادات.حد_أدنى أو 0
        هذا._حد_أقصى = إعدادات.حد_أقصى أو 100
        هذا._أقسام = إعدادات.أقسام أو لاشيء
        هذا._لون = إعدادات.لون أو "#2196F3"
        هذا._لون_غير_نشط = إعدادات.لون_غير_نشط أو "#E0E0E0"
        هذا._عند_التغيير = إعدادات.عند_التغيير أو لاشيء
        هذا._عند_بدء_التغيير = إعدادات.عند_بدء_التغيير أو لاشيء
        هذا._عند_انتهاء_التغيير = إعدادات.عند_انتهاء_التغيير أو لاشيء
        هذا._أظهر_تسميات = إعدادات.أظهر_تسميات أو خطأ
    نهاية

    دالة عيّن_قيمة(قيمة)
        متغير مقيدة = ماكس(هذا._حد_أدنى، مين(هذا._حد_أقصى، قيمة))
        
        إذا (هذا._أقسام != لاشيء)
            متغير حجم_قسم = (هذا._حد_أقصى - هذا._حد_أدنى) / هذا._أقسام
            مقيدة = قرّب(مقيدة / حجم_قسم) * حجم_قسم
        نهاية
        
        إذا (مقيدة != هذا._قيمة)
            هذا._قيمة = مقيدة
            إذا (هذا._عند_التغيير)
                هذا._عند_التغيير(مقيدة)
            نهاية
        نهاية
    نهاية

    دالة بناء()
        ارجع {
            نوع: "منزلق"،
            قيمة: هذا._قيمة،
            حد_أدنى: هذا._حد_أدنى،
            حد_أقصى: هذا._حد_أقصى،
            أقسام: هذا._أقسام،
            لون: هذا._لون،
            لون_غير_نشط: هذا._لون_غير_نشط،
            أظهر_تسميات: هذا._أظهر_تسميات
        }
    نهاية
نهاية

# منزلق النطاق
صدّر صنف منزلق_نطاق
    باني(إعدادات)
        هذا._بداية = إعدادات.بداية أو 0
        هذا._نهاية = إعدادات.نهاية أو 100
        هذا._حد_أدنى = إعدادات.حد_أدنى أو 0
        هذا._حد_أقصى = إعدادات.حد_أقصى أو 100
        هذا._عند_التغيير = إعدادات.عند_التغيير أو لاشيء
    نهاية

    دالة عيّن_نطاق(بداية، نهاية)
        هذا._بداية = ماكس(هذا._حد_أدنى، مين(نهاية، بداية))
        هذا._نهاية = مين(هذا._حد_أقصى، ماكس(بداية، نهاية))
        
        إذا (هذا._عند_التغيير)
            هذا._عند_التغيير(هذا._بداية، هذا._نهاية)
        نهاية
    نهاية

    دالة بناء()
        ارجع {
            نوع: "منزلق_نطاق"،
            بداية: هذا._بداية،
            نهاية: هذا._نهاية،
            حد_أدنى: هذا._حد_أدنى،
            حد_أقصى: هذا._حد_أقصى
        }
    نهاية
نهاية

