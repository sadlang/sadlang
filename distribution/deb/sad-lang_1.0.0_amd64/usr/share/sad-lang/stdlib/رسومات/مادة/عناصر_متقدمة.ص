صدّر صنف زر_راديو
    باني(إعدادات)
        هذا._قيمة = إعدادات.قيمة
        هذا._قيمة_المجموعة = إعدادات.قيمة_المجموعة
        هذا._لون = إعدادات.لون أو "#2196F3"
        هذا._عند_التغيير = إعدادات.عند_التغيير أو لاشيء
        هذا._معطل = إعدادات.معطل أو خطأ
    نهاية

    دالة محدد؟()
        ارجع هذا._قيمة == هذا._قيمة_المجموعة
    نهاية

    دالة حدد()
        إذا (هذا._معطل)
            ارجع
