# العيب #60: TimePicker - منتقي الوقت
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف منتقي_وقت
    باني(إعدادات)
        هذا._ساعة = إعدادات.ساعة أو 12
        هذا._دقيقة = إعدادات.دقيقة أو 0
        هذا._نظام_24 = إعدادات.نظام_24 أو خطأ
        هذا._عند_التغيير = إعدادات.عند_التغيير أو لاشيء
    نهاية

    دالة أظهر(سياق)
        ارجع جديد وعد(لامدا(حل، رفض) =>
            هذا._حل = حل
        نهاية)
    نهاية

    دالة _نص_الوقت()
        متغير س = هذا._ساعة
        متغير فترة = ""
        
        إذا (ليس هذا._نظام_24)
            فترة = س >= 12 ? " م" : " ص"
            س = س % 12
            إذا (س == 0) س = 12 نهاية
        نهاية
        
        متغير د = هذا._دقيقة < 10 ? "0" + هذا._دقيقة : "" + هذا._دقيقة
        ارجع س + ":" + د + فترة
    نهاية

    دالة بناء()
        ارجع {
            نوع: "منتقي_وقت"،
            ساعة: هذا._ساعة،
            دقيقة: هذا._دقيقة،
            نظام_24: هذا._نظام_24
        }
    نهاية
نهاية
