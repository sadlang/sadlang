# العيب #57: Checkbox - مربع اختيار
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر تعداد حالة_اختيار
    غير_محدد،
    محدد،
    جزئي
نهاية

صدّر صنف مربع_اختيار
    باني(إعدادات)
        هذا._حالة = إعدادات.حالة أو حالة_اختيار.غير_محدد
        هذا._ثلاثي = إعدادات.ثلاثي أو خطأ
        هذا._لون = إعدادات.لون أو "#2196F3"
        هذا._عند_التغيير = إعدادات.عند_التغيير أو لاشيء
        هذا._معطل = إعدادات.معطل أو خطأ
    نهاية

    دالة بدّل()
        إذا (هذا._معطل)
            ارجع
        نهاية
        
        إذا (هذا._ثلاثي)
            طابق (هذا._حالة)
                عندما حالة_اختيار.غير_محدد:
                    هذا._حالة = حالة_اختيار.محدد
                عندما حالة_اختيار.محدد:
                    هذا._حالة = حالة_اختيار.جزئي
                عندما حالة_اختيار.جزئي:
                    هذا._حالة = حالة_اختيار.غير_محدد
            نهاية
        وإلا
            هذا._حالة = هذا._حالة == حالة_اختيار.محدد ? 
                حالة_اختيار.غير_محدد : حالة_اختيار.محدد
        نهاية
        
        إذا (هذا._عند_التغيير)
            هذا._عند_التغيير(هذا._حالة)
        نهاية
    نهاية

    دالة محدد؟()
        ارجع هذا._حالة == حالة_اختيار.محدد
    نهاية

    دالة بناء()
        ارجع {
            نوع: "مربع_اختيار"،
            حالة: هذا._حالة،
            لون: هذا._لون،
            معطل: هذا._معطل،
            ثلاثي: هذا._ثلاثي
        }
    نهاية
نهاية

