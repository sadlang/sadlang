# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف شارة
    باني(إعدادات)
        هذا._محتوى = إعدادات.محتوى أو ""
        هذا._عدد = إعدادات.عدد أو 0
        هذا._لون = إعدادات.لون أو "#F44336"
        هذا._لون_نص = إعدادات.لون_نص أو "#FFFFFF"
        هذا._موضع = إعدادات.موضع أو "أعلى_يمين"
        هذا._مرئية = إعدادات.مرئية أو صحيح
        هذا._أقصى_عدد = إعدادات.أقصى أو 99
        هذا._ابن = إعدادات.ابن أو لاشيء
    نهاية

    دالة عيّن_عدد(عدد)
        هذا._عدد = عدد
        هذا._مرئية = عدد > 0
    نهاية

    دالة _نص_العدد()
        إذا (هذا._عدد > هذا._أقصى_عدد)
            ارجع هذا._أقصى_عدد + "+"
        نهاية
        ارجع "" + هذا._عدد
    نهاية

    دالة بناء()
        ارجع {
            نوع: "شارة"،
            ابن: هذا._ابن,
            شارة: {
                نص: هذا._محتوى أو هذا._نص_العدد()،
                لون: هذا._لون،
                لون_نص: هذا._لون_نص،
                موضع: هذا._موضع،
                مرئية: هذا._مرئية و هذا._عدد > 0
            }
        }
    نهاية
نهاية

