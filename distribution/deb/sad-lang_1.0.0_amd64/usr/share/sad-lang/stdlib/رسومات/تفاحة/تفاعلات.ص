# ─── كاشف_إيماءة_تفاحة (GestureDetector) ───
## كاشف إيماءات اللمس المتعددة
صدّر صنف كاشف_إيماءة_تفاحة يرث عنصر
    باني(ابن)
        هذا._نوع = "كاشف_إيماءة_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = [ابن]
        هذا._خصائص["عند_الضغط"] = لاشيء
        هذا._خصائص["عند_الضغط_المطول"] = لاشيء
        هذا._خصائص["عند_الضغط_المزدوج"] = لاشيء
        هذا._خصائص["عند_السحب"] = لاشيء
        هذا._خصائص["عند_السحب_أفقي"] = لاشيء
        هذا._خصائص["عند_السحب_عمودي"] = لاشيء
        هذا._خصائص["عند_القرص"] = لاشيء
        هذا._خصائص["عند_الدوران"] = لاشيء
        هذا._خصائص["سلوك_ضرب"] = "معتم"
    نهاية

    دالة عند_الضغط(دالة_معالجة)
        هذا._خصائص["عند_الضغط"] = دالة_معالجة
        ارجع هذا
    نهاية

    دالة عند_الضغط_المطول(دالة_معالجة)
        هذا._خصائص["عند_الضغط_المطول"] = دالة_معالجة
        ارجع هذا
    نهاية

    دالة عند_الضغط_المزدوج(دالة_معالجة)
        هذا._خصائص["عند_الضغط_المزدوج"] = دالة_معالجة
        ارجع هذا
    نهاية

    دالة عند_السحب(تحديث, انتهاء = لاشيء)
        هذا._خصائص["عند_السحب"] = {"تحديث": تحديث, "انتهاء": انتهاء}
        ارجع هذا
    نهاية

    دالة عند_السحب_أفقي(تحديث, انتهاء = لاشيء)
        هذا._خصائص["عند_السحب_أفقي"] = {"تحديث": تحديث, "انتهاء": انتهاء}
        ارجع هذا
    نهاية

    دالة عند_السحب_عمودي(تحديث, انتهاء = لاشيء)
        هذا._خصائص["عند_السحب_عمودي"] = {"تحديث": تحديث, "انتهاء": انتهاء}
        ارجع هذا
    نهاية

    دالة عند_القرص(تحديث, انتهاء = لاشيء)
        هذا._خصائص["عند_القرص"] = {"تحديث": تحديث, "انتهاء": انتهاء}
        ارجع هذا
    نهاية

    دالة عند_الدوران(تحديث, انتهاء = لاشيء)
        هذا._خصائص["عند_الدوران"] = {"تحديث": تحديث, "انتهاء": انتهاء}
        ارجع هذا
    نهاية
نهاية

# ─── قابل_للسحب_تفاحة (Draggable) ───
## عنصر قابل للسحب
صدّر صنف قابل_للسحب_تفاحة يرث عنصر
    باني(ابن, بيانات = لاشيء, ردود_فعل = لاشيء)
        هذا._نوع = "قابل_للسحب_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = [ابن]
        هذا._خصائص["بيانات"] = بيانات
        هذا._خصائص["ردود_فعل"] = ردود_فعل
        هذا._خصائص["ابن_سحب"] = لاشيء
        هذا._خصائص["ابن_سحب_مكتمل"] = لاشيء
        هذا._خصائص["محور"] = لاشيء  # أفقي، عمودي، أو لاشيء للكل
        هذا._خصائص["اهتزاز"] = صحيح
    نهاية

    دالة ابن_أثناء_السحب(ابن)
        هذا._خصائص["ابن_سحب"] = ابن
        ارجع هذا
    نهاية

    دالة محور_أفقي()
        هذا._خصائص["محور"] = "أفقي"
        ارجع هذا
    نهاية

    دالة محور_عمودي()
        هذا._خصائص["محور"] = "عمودي"
        ارجع هذا
    نهاية
نهاية

# ─── هدف_سحب_تفاحة (DragTarget) ───
## هدف للعناصر المسحوبة
صدّر صنف هدف_سحب_تفاحة يرث عنصر
    باني(بناء, عند_القبول = لاشيء)
        هذا._نوع = "هدف_سحب_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["بناء"] = بناء
        هذا._خصائص["عند_القبول"] = عند_القبول
        هذا._خصائص["عند_ترك"] = لاشيء
        هذا._خصائص["عند_دخول"] = لاشيء
        هذا._خصائص["سوف_يقبل"] = لاشيء
    نهاية

    دالة سوف_يقبل(دالة_فحص)
        هذا._خصائص["سوف_يقبل"] = دالة_فحص
        ارجع هذا
    نهاية
نهاية

# ─── قابل_للمسح_تفاحة (Dismissible) ───
## عنصر قابل للإزالة بالسحب
صدّر صنف قابل_للمسح_تفاحة يرث عنصر
    باني(ابن, مفتاح, عند_المسح)
        هذا._نوع = "قابل_للمسح_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = [ابن]
        هذا._خصائص["مفتاح"] = مفتاح
        هذا._خصائص["عند_المسح"] = عند_المسح
        هذا._خصائص["اتجاه"] = "أفقي"
        هذا._خصائص["خلفية"] = لاشيء
        هذا._خصائص["خلفية_ثانوية"] = لاشيء
        هذا._خصائص["عتبة_مسح"] = 0.4
        هذا._خصائص["تأكيد_مسح"] = لاشيء
    نهاية

    دالة خلفية(عنصر)
        هذا._خصائص["خلفية"] = عنصر
        ارجع هذا
    نهاية

    دالة خلفية_ثانوية(عنصر)
        هذا._خصائص["خلفية_ثانوية"] = عنصر
        ارجع هذا
    نهاية

    دالة تأكيد(دالة_تأكيد)
        هذا._خصائص["تأكيد_مسح"] = دالة_تأكيد
        ارجع هذا
    نهاية

    دالة عمودي()
        هذا._خصائص["اتجاه"] = "عمودي"
        ارجع هذا
    نهاية
نهاية

# ─── اهتزاز_تفاحة (HapticFeedback) ───
## ردود الفعل اللمسية بنمط iOS
صدّر ثابت اهتزاز_تفاحة = {
    # أنواع الاهتزاز
    "خفيف": "خفيف",
    "متوسط": "متوسط",
    "ثقيل": "ثقيل",
    "صلب": "صلب",
    "ناعم": "ناعم",
    "اختيار": "اختيار",
    "نجاح": "نجاح",
    "تحذير": "تحذير",
    "خطأ": "خطأ"
}

## تشغيل اهتزاز
صدّر دالة اهتز(نوع = "متوسط")
    ارجع {
        "نوع": "اهتزاز",
        "شدة": اهتزاز_تفاحة[نوع]
    }
نهاية

# ─── ضغط_تفاحة (Inkwell/Pressable) ───
## منطقة ضغط مع تأثير بصري
صدّر صنف ضغط_تفاحة يرث عنصر
    باني(ابن, عند_الضغط = لاشيء)
        هذا._نوع = "ضغط_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = [ابن]
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["لون_تمييز"] = "rgba(0,0,0,0.1)"
        هذا._خصائص["نصف_قطر"] = لاشيء
        هذا._خصائص["معطل"] = خطأ
        هذا._خصائص["اهتزاز"] = صحيح
    نهاية

    دالة لون_تمييز(لون)
        هذا._خصائص["لون_تمييز"] = لون
        ارجع هذا
    نهاية

    دالة بدون_اهتزاز()
        هذا._خصائص["اهتزاز"] = خطأ
        ارجع هذا
    نهاية

    دالة نصف_قطر(قيمة)
        هذا._خصائص["نصف_قطر"] = قيمة
        ارجع هذا
    نهاية
نهاية

# ─── تمرير_3D_تفاحة (3D Touch / Force Press) ───
