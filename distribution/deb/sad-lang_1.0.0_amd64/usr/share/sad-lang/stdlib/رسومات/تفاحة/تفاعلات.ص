    نهاية

    دالة فتح(دالة_معالجة)
        هذا._خصائص["عند_فتح"] = دالة_معالجة
        ارجع هذا
    نهاية

    دالة إجراءات_سريعة(إجراءات)
        هذا._خصائص["إجراءات_سريعة"] = إجراءات
        ارجع هذا
    نهاية
