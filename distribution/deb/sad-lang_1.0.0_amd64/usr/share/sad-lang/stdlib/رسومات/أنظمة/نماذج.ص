# ─── نموذج (Form) ─── [نظام 23]
صدّر صنف نموذج يرث عنصر
    باني(ابن = لاشيء, تخزين_تلقائي = صحيح, عند_التغيير = لاشيء)
        هذا._نوع = "نموذج"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["تخزين_تلقائي"] = تخزين_تلقائي
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        إذا (ابن != لاشيء)
            هذا._أبناء = [ابن]
        نهاية
    نهاية
نهاية

# ─── حالة_نموذج (FormState) ─── [نظام 24]
صدّر صنف حالة_نموذج
    باني()
        هذا._حقول = []
    نهاية

    دالة تحقق()
        متغير صالح = صحيح
        لكل حقل في هذا._حقول
            إذا (حقل.تحقق() == خطأ)
                صالح = خطأ
            نهاية
        نهاية
        ارجع صالح
    نهاية

    دالة احفظ()
        لكل حقل في هذا._حقول
            حقل.احفظ()
        نهاية
    نهاية

    دالة أعد_تعيين()
        لكل حقل في هذا._حقول
            حقل.أعد_تعيين()
        نهاية
    نهاية

    دالة سجّل(حقل)
        هذا._حقول = هذا._حقول + [حقل]
    نهاية
نهاية

# ─── حقل_نموذج (FormField) ─── [نظام 25]
صدّر صنف حقل_نموذج يرث عنصر
    باني(باني, محقق = لاشيء, عند_الحفظ = لاشيء, قيمة_أولية = لاشيء, مفعّل = صحيح, تحقق_تلقائي = "عند_تفاعل_المستخدم")
        هذا._نوع = "حقل_نموذج"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["باني"] = باني
        هذا._خصائص["محقق"] = محقق
        هذا._خصائص["عند_الحفظ"] = عند_الحفظ
        هذا._خصائص["قيمة_أولية"] = قيمة_أولية
        هذا._خصائص["مفعّل"] = مفعّل
        هذا._خصائص["تحقق_تلقائي"] = تحقق_تلقائي
        هذا._قيمة = قيمة_أولية
        هذا._خطأ = لاشيء
    نهاية

    دالة تحقق()
        متغير محقق = هذا._خصائص["محقق"]
        إذا (محقق != لاشيء)
            هذا._خطأ = محقق(هذا._قيمة)
            ارجع هذا._خطأ == لاشيء
        نهاية
        ارجع صحيح
    نهاية

    دالة احفظ()
        متغير عند_الحفظ = هذا._خصائص["عند_الحفظ"]
        إذا (عند_الحفظ != لاشيء)
            عند_الحفظ(هذا._قيمة)
        نهاية
    نهاية

    دالة أعد_تعيين()
        هذا._قيمة = هذا._خصائص["قيمة_أولية"]
        هذا._خطأ = لاشيء
    نهاية

    دالة غيّر_قيمة(قيمة_جديدة)
        هذا._قيمة = قيمة_جديدة
    نهاية

    دالة الخطأ()
        ارجع هذا._خطأ
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية
نهاية

