    باني(متحكم = لاشيء, محقق = لاشيء, عند_الحفظ = لاشيء, قيمة_أولية = "", تزيين = لاشيء, نوع_لوحة_مفاتيح = "نص", حجب = خطأ, أقصى_أسطر = 1, أقصى_طول = لاشيء, مفعّل = صحيح, للقراءة_فقط = خطأ, عند_التغيير = لاشيء)
        هذا._نوع = "حقل_نص_نموذج"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["متحكم"] = متحكم
        هذا._خصائص["محقق"] = محقق
        هذا._خصائص["عند_الحفظ"] = عند_الحفظ
        هذا._خصائص["تزيين"] = تزيين
        هذا._خصائص["نوع_لوحة_مفاتيح"] = نوع_لوحة_مفاتيح
        هذا._خصائص["حجب"] = حجب
        هذا._خصائص["أقصى_أسطر"] = أقصى_أسطر
        هذا._خصائص["أقصى_طول"] = أقصى_طول
        هذا._خصائص["مفعّل"] = مفعّل
        هذا._خصائص["للقراءة_فقط"] = للقراءة_فقط
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._قيمة = قيمة_أولية
        هذا._خطأ = لاشيء
    نهاية
نهاية

# ─── محققات_شائعة (Common Validators) ─── [نظام 27]
صدّر صنف محققات
    ساكن دالة مطلوب(رسالة = "هذا الحقل مطلوب")
        ارجع لامدا قيمة: (قيمة == لاشيء أو قيمة == "") ? رسالة : لاشيء
    نهاية

    ساكن دالة أدنى_طول(طول, رسالة = لاشيء)
        ارجع لامدا قيمة: لاشيء
    نهاية

    ساكن دالة أقصى_طول(طول, رسالة = لاشيء)
        ارجع لامدا قيمة: لاشيء
    نهاية

    ساكن دالة بريد_إلكتروني(رسالة = "بريد إلكتروني غير صالح")
        ارجع لامدا قيمة: لاشيء
    نهاية

    ساكن دالة رقمي(رسالة = "يجب أن يكون رقمًا")
        ارجع لامدا قيمة: لاشيء
    نهاية

    ساكن دالة مركّب(محققات_قائمة)
        دالة _محقق(قيمة)
            لكل محقق في محققات_قائمة
                متغير نتيجة = محقق(قيمة)
                إذا (نتيجة != لاشيء)
                    ارجع نتيجة
                نهاية
            نهاية
            ارجع لاشيء
        نهاية
        ارجع _محقق
    نهاية
نهاية
