# بسم الله الرحمن الرحيم
# ===================================================================
# محرك سطح المكتب — Desktop Rendering Backend
# ===================================================================
#
# (AR) تنفيذ محرك الرسم لبيئة سطح المكتب (ويندوز/لينكس/ماك).
#      يستخدم الدوال المدمجة (شاشة_*) المُسجّلة في المفسر.
#
#      هذا المحرك يُستخدم عند تشغيل الكود عبر مفسر sad
#      ويوفر جسراً بين Canvas API ودوال الرسم المدمجة.
#
# (EN) Desktop rendering backend using built-in شاشة_* functions.
#      Used when running code through the sad interpreter.
#
# الاستخدام:
#   استورد * من رسومات.محرك.محرك_مدمج
#   متغير شاشة = جديد محرك_مدمج()
#   شاشة.تهيئة(1024, 768)
#   شاشة.ارسم_دائرة(512, 384, 100, 0xFF0000)
# ===================================================================

استورد * من رسومات.محرك.واجهة_محرك
استورد * من رسومات.محرك.أحداث

# ===================================================================
#          صنف محرك سطح المكتب
# ===================================================================

صدّر صنف محرك_مدمج يرث محرك_رسم

    باني()
        هذا._عرض = 0
        هذا._ارتفاع = 0
        هذا._مهيأ = خطأ
        هذا._قص_مفعل = خطأ
        هذا._قص_س = 0
        هذا._قص_ص = 0
        هذا._قص_ع = 0
        هذا._قص_ا = 0
        هذا._طابور = جديد طابور_أحداث()
        هذا._يعمل = صحيح
    نهاية

    # ─── تجاوز: تهيئة ───
    دالة تهيئة(عرض, ارتفاع, عمق = 32)
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
        شاشة_تهيئة_يدوي(0, عرض, ارتفاع, عرض * 4, عمق)
        هذا._مهيأ = صحيح
    نهاية

    # ─── تجاوز: رسم بكسل ───
    # الدوال المدمجة تأخذ مكونات RGB منفصلة
    دالة ارسم_بكسل(س, ص, لون)
        شاشة_نقطة(س, ص, لون_أحمر(لون), لون_أخضر(لون), لون_أزرق(لون))
    نهاية

    # ─── تجاوز: مسح ───
    دالة مسح(لون = 0)
        شاشة_مسح(لون_أحمر(لون), لون_أخضر(لون), لون_أزرق(لون))
    نهاية

    # ─── تجاوز: مستطيل ممتلئ (مُحسّن) ───
    دالة ارسم_مستطيل_ممتلئ(س, ص, عرض, ارتفاع, لون)
        شاشة_مستطيل_ممتلئ(
            س, ص, عرض, ارتفاع,
            لون_أحمر(لون), لون_أخضر(لون), لون_أزرق(لون)
        )
    نهاية

    # ─── تجاوز: دائرة ممتلئة (مُحسّن) ───
    دالة ارسم_دائرة_ممتلئة(مركز_س, مركز_ص, نصف_قطر, لون)
        شاشة_دائرة_ممتلئة(
            مركز_س, مركز_ص, نصف_قطر,
            لون_أحمر(لون), لون_أخضر(لون), لون_أزرق(لون)
        )
    نهاية

    # ─── تجاوز: رسم نص (مُحسّن — يستخدم خط النظام) ───
    دالة ارسم_نص(س, ص, محتوى, لون, مقياس = 1)
        شاشة_نص_utf8(
            س, ص, محتوى,
            لون_أحمر(لون), لون_أخضر(لون), لون_أزرق(لون)
        )
    نهاية

    # ─── تجاوز: تبديل المخزن ───
    دالة تبديل()
        شاشة_تبديل()
    نهاية

    # الدوال الأخرى (خط, مستطيل حدود, مثلث, Canvas)
    # تعمل عبر الوراثة من محرك_رسم (software rasterizer)

    # ===============================================================
    # ⬇ نظام الأحداث — SDL Events ⬇
    # ===============================================================

    ## الحصول على طابور الأحداث
    دالة طابور()
        ارجع هذا._طابور
    نهاية

    ## الحدث التالي
    دالة الحدث_التالي()
        ارجع هذا._طابور.التالي()
    نهاية

    ## هل توجد أحداث في الانتظار
    دالة توجد_أحداث()
        ارجع ليس هذا._طابور.فارغ()
    نهاية

    ## هل المحرك يعمل
    دالة يعمل()
        ارجع هذا._يعمل
    نهاية

    ## إيقاف المحرك
    دالة أوقف()
        هذا._يعمل = خطأ
    نهاية

    ## معالجة جميع الأحداث باستخدام دالة رد نداء
    دالة عالج_أحداث(معالج)
        بينما (ليس هذا._طابور.فارغ())
            متغير ح = هذا._طابور.التالي()
            إذا (ح != لاشيء)
                معالج(ح)
                إذا (ح.نوع == حدث_إغلاق)
                    هذا.أوقف()
                نهاية
            نهاية
        نهاية
    نهاية
نهاية
