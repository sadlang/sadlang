صدّر صنف حقل_كلمة_مرور يرث عنصر
    باني(قيمة = "", عند_التغيير = لاشيء,
         تسمية = "كلمة المرور", تلميح = "أدخل كلمة المرور",
         زر_إظهار = صحيح, قوة_كلمة_مرور = صحيح,
         متطلبات = لاشيء)
        هذا._نوع = "حقل_كلمة_مرور"
        هذا._خصائص = {}
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["تلميح"] = تلميح
        هذا._خصائص["زر_إظهار"] = زر_إظهار
        هذا._خصائص["قوة_كلمة_مرور"] = قوة_كلمة_مرور
        هذا._خصائص["متطلبات"] = متطلبات
        هذا._خصائص["مرئية"] = خطأ
    نهاية

    دالة بدّل_الرؤية()
        هذا._خصائص["مرئية"] = ليس هذا._خصائص["مرئية"]
        ارجع هذا
    نهاية

    دالة القوة()
        متغير قيمة = هذا._خصائص["قيمة"]
        متغير نقاط = 0
        
        إذا (قيمة.حجم() >= 8)
            نقاط = نقاط + 1
        نهاية
        إذا (قيمة.حجم() >= 12)
            نقاط = نقاط + 1
        نهاية
        # تحقق من وجود أرقام، حروف كبيرة، رموز...
        
        إذا (نقاط >= 4)
            ارجع "قوية"
        وإلا إذا (نقاط >= 2)
            ارجع "متوسطة"
        وإلا
            ارجع "ضعيفة"
        نهاية
    نهاية
نهاية

