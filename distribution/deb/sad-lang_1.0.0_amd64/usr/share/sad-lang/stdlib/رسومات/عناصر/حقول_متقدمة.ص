# ===================================================================
صدّر صنف حقل_وسوم يرث عنصر
    باني(قيمة = [], عند_التغيير = لاشيء,
         تسمية = "الوسوم", تلميح = "أضف وسم...",
         حد_أقصى = لاشيء, اقتراحات = [],
         قابل_للإنشاء = صحيح, فاصل = ",")
        هذا._نوع = "حقل_وسوم"
        هذا._خصائص = {}
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["تلميح"] = تلميح
        هذا._خصائص["حد_أقصى"] = حد_أقصى
        هذا._خصائص["اقتراحات"] = اقتراحات
        هذا._خصائص["قابل_للإنشاء"] = قابل_للإنشاء
        هذا._خصائص["فاصل"] = فاصل
    نهاية

    دالة أضف_وسم(وسم)
        متغير قيمة = هذا._خصائص["قيمة"]
        إذا (هذا._خصائص["حد_أقصى"] == لاشيء || قيمة.حجم() < هذا._خصائص["حد_أقصى"])
            قيمة.أضف(وسم)
            هذا._خصائص["قيمة"] = قيمة
        نهاية
        ارجع هذا
    نهاية

    دالة أزل_وسم(وسم)
        متغير جديدة = []
        لكل و في هذا._خصائص["قيمة"]
            إذا (و != وسم)
                جديدة.أضف(و)
            نهاية
        نهاية
        هذا._خصائص["قيمة"] = جديدة
        ارجع هذا
    نهاية
نهاية
