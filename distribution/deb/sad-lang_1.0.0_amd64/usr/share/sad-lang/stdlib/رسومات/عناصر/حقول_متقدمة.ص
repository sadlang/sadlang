# ===================================================================
#                   حقل_بحث_متقدم (Advanced Search Field)
# ===================================================================
صدّر صنف حقل_بحث_متقدم يرث عنصر
    باني(تلميح = "بحث...", قيمة = "", عند_التغيير = لاشيء,
         عند_الإرسال = لاشيء, عند_المسح = لاشيء,
         اقتراحات = [], عند_اختيار_اقتراح = لاشيء,
         أيقونة_بحث = صحيح, زر_مسح = صحيح,
         تحميل = خطأ, تأخير_بحث = 300,
         لون_خلفية = لاشيء, زوايا = 8)
        هذا._نوع = "حقل_بحث_متقدم"
        هذا._خصائص = {}
        هذا._خصائص["تلميح"] = تلميح
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["عند_الإرسال"] = عند_الإرسال
        هذا._خصائص["عند_المسح"] = عند_المسح
        هذا._خصائص["اقتراحات"] = اقتراحات
        هذا._خصائص["عند_اختيار_اقتراح"] = عند_اختيار_اقتراح
        هذا._خصائص["أيقونة_بحث"] = أيقونة_بحث
        هذا._خصائص["زر_مسح"] = زر_مسح
        هذا._خصائص["تحميل"] = تحميل
        هذا._خصائص["تأخير_بحث"] = تأخير_بحث
        هذا._خصائص["لون_خلفية"] = لون_خلفية
        هذا._خصائص["زوايا"] = زوايا
    نهاية

    دالة عيّن_الاقتراحات(اقتراحات)
        هذا._خصائص["اقتراحات"] = اقتراحات
        ارجع هذا
    نهاية

    دالة ابدأ_التحميل()
        هذا._خصائص["تحميل"] = صحيح
        ارجع هذا
    نهاية

    دالة أوقف_التحميل()
        هذا._خصائص["تحميل"] = خطأ
        ارجع هذا
    نهاية
نهاية

# ===================================================================
#                   حقل_رقم (Number Field)
# ===================================================================
صدّر صنف حقل_رقم يرث عنصر
    باني(قيمة = 0, أدنى = لاشيء, أقصى = لاشيء,
         خطوة = 1, عند_التغيير = لاشيء,
         تسمية = لاشيء, تلميح = لاشيء,
         أزرار_تعديل = صحيح, تنسيق = لاشيء,
         كسور = 0, معطل = خطأ)
        هذا._نوع = "حقل_رقم"
        هذا._خصائص = {}
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["أدنى"] = أدنى
        هذا._خصائص["أقصى"] = أقصى
        هذا._خصائص["خطوة"] = خطوة
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["تسمية"] = تسمية
        هذا._خصائص["تلميح"] = تلميح
        هذا._خصائص["أزرار_تعديل"] = أزرار_تعديل
        هذا._خصائص["تنسيق"] = تنسيق
        هذا._خصائص["كسور"] = كسور
        هذا._خصائص["معطل"] = معطل
    نهاية

    دالة زِد()
        متغير قيمة_جديدة = هذا._خصائص["قيمة"] + هذا._خصائص["خطوة"]
        إذا (هذا._خصائص["أقصى"] != لاشيء و قيمة_جديدة > هذا._خصائص["أقصى"])
            قيمة_جديدة = هذا._خصائص["أقصى"]
        نهاية
        هذا._خصائص["قيمة"] = قيمة_جديدة
        ارجع هذا
    نهاية

    دالة أنقص()
        متغير قيمة_جديدة = هذا._خصائص["قيمة"] - هذا._خصائص["خطوة"]
        إذا (هذا._خصائص["أدنى"] != لاشيء و قيمة_جديدة < هذا._خصائص["أدنى"])
            قيمة_جديدة = هذا._خصائص["أدنى"]
        نهاية
        هذا._خصائص["قيمة"] = قيمة_جديدة
        ارجع هذا
    نهاية
نهاية

