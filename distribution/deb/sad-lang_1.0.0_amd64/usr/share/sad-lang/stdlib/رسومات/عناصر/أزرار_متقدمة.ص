# ===================================================================
#                   زر_اجتماعي (Social Button)
# ===================================================================
صدّر صنف زر_اجتماعي يرث عنصر
    باني(نوع = "فيسبوك", نص = لاشيء, عند_الضغط = لاشيء,
         عرض = لاشيء, ارتفاع = 48, زوايا = 8)
        هذا._نوع = "زر_اجتماعي"
        هذا._خصائص = {}
        هذا._خصائص["نوع_اجتماعي"] = نوع
        هذا._خصائص["نص"] = نص
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["زوايا"] = زوايا
        
        # ألوان اجتماعية
        طابق (نوع)
            عندما "فيسبوك":
                هذا._خصائص["لون"] = "#1877F2"
                إذا (نص == لاشيء)
                    هذا._خصائص["نص"] = "متابعة عبر فيسبوك"
                نهاية
            عندما "جوجل":
                هذا._خصائص["لون"] = "#FFFFFF"
                هذا._خصائص["لون_نص"] = "#757575"
                هذا._خصائص["حدود"] = صحيح
                إذا (نص == لاشيء)
                    هذا._خصائص["نص"] = "متابعة عبر جوجل"
                نهاية
            عندما "تويتر":
                هذا._خصائص["لون"] = "#1DA1F2"
                إذا (نص == لاشيء)
                    هذا._خصائص["نص"] = "متابعة عبر تويتر"
                نهاية
            عندما "أبل":
                هذا._خصائص["لون"] = "#000000"
                إذا (نص == لاشيء)
                    هذا._خصائص["نص"] = "متابعة عبر أبل"
                نهاية
            عندما "مايكروسوفت":
                هذا._خصائص["لون"] = "#2F2F2F"
                إذا (نص == لاشيء)
                    هذا._خصائص["نص"] = "متابعة عبر مايكروسوفت"
                نهاية
            افتراضي:
                هذا._خصائص["لون"] = "#6366F1"
        نهاية
    نهاية
نهاية

