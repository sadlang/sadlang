        تباعد: تباعد,
        أبناء: شرائح
    )
نهاية

# إنشاء زر أيقونة مع نص
صدّر دالة زر_أيقونة_ونص(أيقونة, نص, عند_الضغط = لاشيء)
    ارجع زر(
        ابن: صف(
            أبناء: [أيقونة, نص(نص)]
        ),
        عند_الضغط: عند_الضغط
    )
نهاية
