# ===================================================================
# أزرار متقدمة — Advanced Buttons
# ===================================================================
# تحسين على أزرار.ص مع أنماط وأنواع إضافية
# ===================================================================

استورد * من رسومات.أساس.عنصر
استورد * من رسومات.حالة.إدارة

# ===================================================================
#                   زر_تقسيم (SegmentedButton)
# ===================================================================
صدّر صنف زر_تقسيم يرث عنصر
    باني(أجزاء = [], محدد = 0, متعدد = خطأ,
         عند_التغيير = لاشيء, اتجاه = "أفقي", نمط = لاشيء)
        هذا._نوع = "زر_تقسيم"
        هذا._خصائص = {}
        هذا._خصائص["أجزاء"] = أجزاء
        هذا._خصائص["محدد"] = محدد
        هذا._خصائص["متعدد"] = متعدد
        هذا._خصائص["عند_التغيير"] = عند_التغيير
        هذا._خصائص["اتجاه"] = اتجاه
        هذا._خصائص["نمط"] = نمط
    نهاية

    دالة حدّد(فهرس)
        هذا._خصائص["محدد"] = فهرس
        إذا (هذا._خصائص["عند_التغيير"] != لاشيء)
            هذا._خصائص["عند_التغيير"](فهرس)
        نهاية
        ارجع هذا
    نهاية
نهاية

# جزء الزر
صدّر صنف جزء_زر
    باني(تسمية = لاشيء, أيقونة = لاشيء, قيمة = لاشيء,
         ممكّن = صحيح, تلميح = لاشيء)
        هذا._تسمية = تسمية
        هذا._أيقونة = أيقونة
        هذا._قيمة = قيمة
        هذا._ممكّن = ممكّن
        هذا._تلميح = تلميح
    نهاية
نهاية

# ===================================================================
#                   زر_تبديل (ToggleButton)
# ===================================================================
صدّر صنف زر_تبديل يرث عنصر
    باني(أزرار = [], محددة = [], عند_الضغط = لاشيء,
         اتجاه = "أفقي", لون_محدد = لاشيء,
         لون_حدود = لاشيء, زوايا = 8)
        هذا._نوع = "زر_تبديل"
        هذا._خصائص = {}
        هذا._خصائص["أزرار"] = أزرار
        هذا._خصائص["محددة"] = محددة
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["اتجاه"] = اتجاه
        هذا._خصائص["لون_محدد"] = لون_محدد
        هذا._خصائص["لون_حدود"] = لون_حدود
        هذا._خصائص["زوايا"] = زوايا
    نهاية

    دالة بدّل(فهرس)
        متغير محددة = هذا._خصائص["محددة"]
        إذا (فهرس في محددة)
            # إزالة
            متغير جديدة = []
            لكل م في محددة
                إذا (م != فهرس)
                    جديدة.أضف(م)
                نهاية
            نهاية
            هذا._خصائص["محددة"] = جديدة
        وإلا
            # إضافة
            محددة.أضف(فهرس)
        نهاية
        ارجع هذا
    نهاية
نهاية

