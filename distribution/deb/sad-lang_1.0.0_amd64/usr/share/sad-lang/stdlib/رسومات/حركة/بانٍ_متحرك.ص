# ─── تدريج متسلسل (TweenSequence) ───
صدّر صنف تسلسل_تدريجات
    باني(عناصر)
        هذا._عناصر = عناصر
        هذا._إجمالي_الأوزان = 0
        
        لكل ع في عناصر
            هذا._إجمالي_الأوزان += ع.الوزن()
        نهاية
    نهاية

    دالة تحويل(ن)
        متغير وزن_حالي = 0
        
        لكل ع في هذا._عناصر
            متغير بداية_نطاق = وزن_حالي / هذا._إجمالي_الأوزان
            وزن_حالي += ع.الوزن()
            متغير نهاية_نطاق = وزن_حالي / هذا._إجمالي_الأوزان
            
            إذا (ن >= بداية_نطاق و ن < نهاية_نطاق)
                متغير ن_محلي = (ن - بداية_نطاق) / (نهاية_نطاق - بداية_نطاق)
                ارجع ع.التدريج().تحويل(ن_محلي)
            نهاية
        نهاية
        
        # آخر عنصر
        ارجع هذا._عناصر[هذا._عناصر.الطول() - 1].التدريج().تحويل(1.0)
    نهاية
نهاية

