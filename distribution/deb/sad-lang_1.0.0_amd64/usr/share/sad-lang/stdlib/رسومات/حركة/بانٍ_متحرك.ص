# ─── بانٍ متحرك (AnimatedBuilder) ───
صدّر صنف بانٍ_متحرك يرث عنصر
    باني(حركة، بانٍ، ابن = لاشيء)
        هذا._نوع = "بانٍ_متحرك"
        هذا._حركة = حركة
        هذا._بانٍ = بانٍ
        هذا._ابن = ابن
    نهاية

    دالة الحركة()
        ارجع هذا._حركة
    نهاية

    دالة ابنِ(سياق)
        ارجع هذا._بانٍ(سياق، هذا._ابن)
    نهاية
نهاية

# ─── بانٍ حركة Tween (TweenAnimationBuilder) ───
صدّر صنف بانٍ_حركة_تدريجية يرث عنصر
    باني(
        تدريج،
        مدة،
        بانٍ،
        ابن = لاشيء،
        منحنى = "خطي"،
        عند_الانتهاء = لاشيء
    )
        هذا._نوع = "بانٍ_حركة_تدريجية"
        هذا._تدريج = تدريج
        هذا._مدة = مدة
        هذا._بانٍ = بانٍ
        هذا._ابن = ابن
        هذا._منحنى = منحنى
        هذا._عند_الانتهاء = عند_الانتهاء
    نهاية

    دالة ابنِ(سياق، قيمة)
        ارجع هذا._بانٍ(سياق، قيمة، هذا._ابن)
    نهاية
نهاية

# ─── التدريج (Tween) ───
صدّر صنف تدريج
    باني(بداية، نهاية)
        هذا._بداية = بداية
        هذا._نهاية = نهاية
    نهاية

    دالة البداية()
        ارجع هذا._بداية
    نهاية

    دالة النهاية()
        ارجع هذا._نهاية
    نهاية

    دالة حرّك(حركة)
        ارجع جديد حركة_مُدرَّجة(هذا، حركة)
    نهاية

    دالة تحويل(ن)
        ارجع هذا._بداية + (هذا._نهاية - هذا._بداية) * ن
    نهاية

    دالة قيّم(ن)
        ارجع هذا.تحويل(ن)
    نهاية
نهاية

# ─── تدريج اللون (ColorTween) ───
صدّر صنف تدريج_لون يرث تدريج
    باني(بداية، نهاية)
        الأساس(بداية، نهاية)
    نهاية

    دالة تحويل(ن)
        # استخراج مكونات اللون
        متغير ش1 = (هذا._بداية >> 24) & 0xFF
        متغير أ1 = (هذا._بداية >> 16) & 0xFF
        متغير خ1 = (هذا._بداية >> 8) & 0xFF
        متغير ز1 = هذا._بداية & 0xFF
        
        متغير ش2 = (هذا._نهاية >> 24) & 0xFF
        متغير أ2 = (هذا._نهاية >> 16) & 0xFF
        متغير خ2 = (هذا._نهاية >> 8) & 0xFF
        متغير ز2 = هذا._نهاية & 0xFF
        
        # الاستيفاء
        متغير ش = رقم(ش1 + (ش2 - ش1) * ن)
        متغير أ = رقم(أ1 + (أ2 - أ1) * ن)
        متغير خ = رقم(خ1 + (خ2 - خ1) * ن)
        متغير ز = رقم(ز1 + (ز2 - ز1) * ن)
        
        ارجع (ش << 24) | (أ << 16) | (خ << 8) | ز
    نهاية
نهاية

# ─── تدريج الموضع (Offset Tween) ───
صدّر صنف تدريج_موضع يرث تدريج
    باني(بداية، نهاية)
        الأساس(بداية، نهاية)
    نهاية

    دالة تحويل(ن)
        ارجع {
            "س": هذا._بداية["س"] + (هذا._نهاية["س"] - هذا._بداية["س"]) * ن،
            "ص": هذا._بداية["ص"] + (هذا._نهاية["ص"] - هذا._بداية["ص"]) * ن
        }
    نهاية
نهاية

