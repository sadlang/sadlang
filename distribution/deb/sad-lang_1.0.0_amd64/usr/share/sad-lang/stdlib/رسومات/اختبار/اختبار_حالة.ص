استورد * من رسومات.اختبار.فحص

# ═══════════════════════════════════════════
# اختبارات إدارة الحالة الأساسية
# ═══════════════════════════════════════════
مجموعة("إدارة الحالة الأساسية", لامدا()
    اختبر("إنشاء حالة بسيطة", لامدا()
        متغير حالة = {"عداد": 0, "اسم": "اختبار"}
        توقع(حالة["عداد"], 0, "القيمة الأولية للعداد")
        توقع(حالة["اسم"], "اختبار", "القيمة الأولية للاسم")
    نهاية)

    اختبر("تحديث حالة", لامدا()
        متغير حالة = {"عداد": 0}
        حالة["عداد"] = حالة["عداد"] + 1
        توقع(حالة["عداد"], 1, "تحديث العداد")
        حالة["عداد"] = حالة["عداد"] + 5
        توقع(حالة["عداد"], 6, "تحديث العداد مرة أخرى")
    نهاية)

    اختبر("حالة متعددة الأنواع", لامدا()
        متغير حالة = {"رقم": 42, "نص": "مرحبا", "منطقي": صحيح, "قائمة": [1, 2, 3]}
        توقع(حالة["رقم"], 42, "نوع رقمي")
        توقع(حالة["نص"], "مرحبا", "نوع نصي")
        توقع(حالة["منطقي"], صحيح, "نوع منطقي")
    نهاية)

    اختبر("حالة فارغة", لامدا()
        متغير حالة = {}
        توقع_لاشيء(حالة["غير_موجود"], "مفتاح غير موجود يعيد لاشيء")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات ناقل الأحداث
# ═══════════════════════════════════════════
مجموعة("ناقل الأحداث", لامدا()
    اختبر("إرسال واستقبال حدث", لامدا()
        متغير استُقبل = خطأ
        متغير أحداث = []
        متغير ناقل = {"مستمعون": {}}

        # تسجيل مستمع
        ناقل["مستمعون"]["تحديث"] = [لامدا(بيانات)
            استُقبل = صحيح
            أحداث.أضف(بيانات)
        نهاية]

        # إرسال حدث
        متغير مستمعو = ناقل["مستمعون"]["تحديث"]
        إذا (مستمعو != لاشيء)
            لكل مستمع في مستمعو
                مستمع("بيانات_اختبار")
            نهاية
        نهاية

        توقع_صحيح(استُقبل, "الحدث تم استقباله")
    نهاية)

    اختبر("أحداث متعددة", لامدا()
        متغير عداد = 0
        متغير ناقل = {"مستمعون": {}}
        ناقل["مستمعون"]["عد"] = [لامدا(بيانات)
            عداد = عداد + 1
        نهاية]

        # إرسال 3 أحداث
        لكل ن في [1, 2, 3]
            متغير مستمعو = ناقل["مستمعون"]["عد"]
            لكل مستمع في مستمعو
                مستمع(ن)
            نهاية
        نهاية

        توقع(عداد, 3, "عدد الأحداث المستقبلة")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات التخزين المحلي
# ═══════════════════════════════════════════
مجموعة("التخزين المحلي", لامدا()
    اختبر("تخزين واسترجاع قيمة", لامدا()
        متغير تخزين = {}
        تخزين["مفتاح1"] = "قيمة1"
        توقع(تخزين["مفتاح1"], "قيمة1", "استرجاع القيمة المخزنة")
    نهاية)

    اختبر("حذف قيمة", لامدا()
        متغير تخزين = {"مفتاح1": "قيمة1", "مفتاح2": "قيمة2"}
        تخزين["مفتاح1"] = لاشيء
        توقع_لاشيء(تخزين["مفتاح1"], "القيمة المحذوفة")
        توقع(تخزين["مفتاح2"], "قيمة2", "القيمة غير المحذوفة")
    نهاية)

    اختبر("تخزين أنواع متعددة", لامدا()
        متغير تخزين = {}
        تخزين["رقم"] = 42
        تخزين["نص"] = "مرحبا"
        تخزين["منطقي"] = صحيح
        توقع(تخزين["رقم"], 42, "تخزين رقم")
        توقع(تخزين["نص"], "مرحبا", "تخزين نص")
        توقع(تخزين["منطقي"], صحيح, "تخزين منطقي")
    نهاية)
نهاية)

# ═══════════════════════════════════════════
# اختبارات الحالة المتقدمة (نمط Reducer)
# ═══════════════════════════════════════════
مجموعة("نمط المُخفض (Reducer)", لامدا()
    اختبر("مُخفض عداد", لامدا()
        دالة مخفض_عداد(حالة, إجراء)
            إذا (إجراء == "زيادة")
                ارجع حالة + 1
            وإلا
                إذا (إجراء == "نقصان")
                    ارجع حالة - 1
                وإلا
                    إذا (إجراء == "إعادة_ضبط")
                        ارجع 0
                    نهاية
                نهاية
            نهاية
            ارجع حالة
        نهاية

        متغير حالة = 0
        حالة = مخفض_عداد(حالة, "زيادة")
        توقع(حالة, 1, "زيادة العداد")
        حالة = مخفض_عداد(حالة, "زيادة")
        توقع(حالة, 2, "زيادة مرة أخرى")
        حالة = مخفض_عداد(حالة, "نقصان")
        توقع(حالة, 1, "نقصان العداد")
        حالة = مخفض_عداد(حالة, "إعادة_ضبط")
        توقع(حالة, 0, "إعادة ضبط العداد")
    نهاية)
نهاية)

# ─── تشغيل ───
شغّل_اختبارات()
