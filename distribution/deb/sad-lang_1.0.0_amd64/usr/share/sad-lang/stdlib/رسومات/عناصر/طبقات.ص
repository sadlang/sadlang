# ─── مدخل_طبقة (OverlayEntry) ───
صدّر صنف مدخل_طبقة
    باني(بانٍ, معتم = خطأ, قابل_للإغلاق = صحيح, محافظ_على_الحالة = خطأ)
        هذا._بانٍ = بانٍ
        هذا._معتم = معتم
        هذا._قابل_للإغلاق = قابل_للإغلاق
        هذا._محافظ = محافظ_على_الحالة
        هذا._مُدرج = خطأ
        هذا._عنصر = لاشيء
    نهاية

    دالة ابنِ()
        إذا (هذا._عنصر == لاشيء)
            هذا._عنصر = هذا._بانٍ()
        نهاية
        ارجع هذا._عنصر
    نهاية

    دالة حدّث()
        هذا._عنصر = هذا._بانٍ()
    نهاية

    دالة أزل()
        هذا._مُدرج = خطأ
    نهاية

    دالة مُدرج()
        ارجع هذا._مُدرج
    نهاية

    دالة معتم()
        ارجع هذا._معتم
    نهاية

    دالة قابل_للإغلاق()
        ارجع هذا._قابل_للإغلاق
    نهاية
نهاية

# ─── طبقة (Overlay) ───
صدّر صنف طبقة يرث عنصر
    باني(ابن = لاشيء)
        هذا._نوع = "طبقة"
        هذا._ابن = ابن
        هذا._مداخل = []
    نهاية

    # ─── إدراج مدخل ───
    دالة أدرج(مدخل, فوق = لاشيء, تحت = لاشيء)
        إذا (فوق != لاشيء)
            # إدراج فوق مدخل معين
            متغير فهرس = هذا._ابحث_عن_فهرس(فوق)
            إذا (فهرس >= 0)
                هذا._مداخل = هذا._أدرج_عند(هذا._مداخل, فهرس + 1, مدخل)
            وإلا
                هذا._مداخل = هذا._مداخل + [مدخل]
            نهاية
        وإلا إذا (تحت != لاشيء)
            متغير فهرس = هذا._ابحث_عن_فهرس(تحت)
            إذا (فهرس >= 0)
                هذا._مداخل = هذا._أدرج_عند(هذا._مداخل, فهرس, مدخل)
            وإلا
                هذا._مداخل = [مدخل] + هذا._مداخل
            نهاية
        وإلا
            # إدراج في النهاية
            هذا._مداخل = هذا._مداخل + [مدخل]
        نهاية
        
        مدخل._مُدرج = صحيح
        ارجع هذا
    نهاية

    # ─── إدراج الكل ───
    دالة أدرج_الكل(مداخل)
        لكل مدخل في مداخل
            هذا.أدرج(مدخل)
        نهاية
        ارجع هذا
    نهاية

    # ─── إعادة ترتيب ───
    دالة أعد_ترتيب(مدخل_قديم, فوق = لاشيء, تحت = لاشيء)
        # إزالة ثم إدراج
        هذا._مداخل = هذا._أزل_من_قائمة(هذا._مداخل, مدخل_قديم)
        هذا.أدرج(مدخل_قديم, فوق, تحت)
        ارجع هذا
    نهاية

    # ─── البحث عن فهرس ───
    دالة _ابحث_عن_فهرس(مدخل)
        متغير ف = 0
        لكل م في هذا._مداخل
            إذا (م == مدخل)
                ارجع ف
            نهاية
            ف = ف + 1
        نهاية
        ارجع -1
    نهاية

    دالة _أدرج_عند(قائمة, فهرس, عنصر)
        متغير جديدة = []
        متغير ف = 0
        لكل ع في قائمة
            إذا (ف == فهرس)
                جديدة = جديدة + [عنصر]
            نهاية
            جديدة = جديدة + [ع]
            ف = ف + 1
        نهاية
        إذا (فهرس >= طول(قائمة))
            جديدة = جديدة + [عنصر]
        نهاية
        ارجع جديدة
    نهاية

    دالة _أزل_من_قائمة(قائمة, عنصر)
        متغير جديدة = []
        لكل ع في قائمة
            إذا (ع != عنصر)
                جديدة = جديدة + [ع]
            نهاية
        نهاية
        ارجع جديدة
    نهاية

    # ─── المداخل الحالية ───
    دالة المداخل()
        ارجع هذا._مداخل
    نهاية
نهاية

