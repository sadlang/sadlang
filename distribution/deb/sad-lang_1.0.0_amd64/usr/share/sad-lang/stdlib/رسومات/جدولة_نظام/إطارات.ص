# بسم الله الرحمن الرحيم
# ===================================================================
# إدارة الإطارات — Frame Scheduling
# ===================================================================
#
# (AR) هذا الملف يوفر نظام إدارة الإطارات (Frame Scheduling)
#      المسؤول عن تنظيم دورة حياة كل إطار (frame) في التطبيق:
#
#      دورة الإطار الواحد:
#      ┌─────────────────────────────────────┐
#      │ 1. مرحلة_المهام_العابرة (Transient)    │ ← الحركات
#      │ 2. مرحلة_البناء (Build)               │ ← إعادة بناء العناصر
#      │ 3. مرحلة_التخطيط (Layout)             │ ← حساب الأحجام والمواقع
#      │ 4. مرحلة_التركيب (Compositing)        │ ← تجميع الطبقات
#      │ 5. مرحلة_الرسم (Paint)               │ ← الرسم الفعلي
#      │ 6. مرحلة_الدلالات (Semantics)         │ ← تحديث الدلالات
#      │ 7. مرحلة_التنظيف (Finalize)           │ ← مهام ما بعد الإطار
#      └─────────────────────────────────────┘
#
#      الهدف: 60 إطار/ثانية (16.67ms لكل إطار)
#      أو 120 إطار/ثانية (8.33ms لكل إطار) على الأجهزة الحديثة
#
#      مطابق لـ flutter/scheduler/binding.dart (SchedulerBinding)
#      و flutter/widgets/binding.dart (WidgetsBinding)
#
# (EN) Frame scheduling system managing the per-frame lifecycle:
#      transient callbacks → build → layout → compositing → paint
#
# الأصناف المُصدّرة:
#   - خط_أنابيب_إطار (FramePipeline)     — خط أنابيب الإطار الكامل
#   - مهمة_مؤجلة (DeferredTask)          — مهمة مؤجلة بأولوية
#   - طابور_أولويات (PriorityQueue)       — طابور مهام بأولوية
#   - حالة_خط_أنابيب (PipelineState)      — حالة الخط الحالية
#   - مراقب_أداء (PerformanceMonitor)      — مراقبة أداء الإطارات
#
# الاستخدام:
#   استورد * من رسومات.جدولة_نظام.إطارات
# ===================================================================

# ─── ثوابت ───
ثابت هدف_إطارات_ثانية = 60         # الهدف الافتراضي
ثابت مدة_إطار_مللي = 16            # 1000/60 ≈ 16.67ms
ثابت أقصى_مدة_إطار = 33            # ضعف المدة (30 fps)

# ─── أولويات المهام ───
ثابت أولوية_فورية = 0               # Immediate (animations)
ثابت أولوية_حركة = 100              # Animation priority
ثابت أولوية_لمس = 200               # Touch/gesture priority
ثابت أولوية_بناء = 500              # Widget build priority
ثابت أولوية_خاملة = 1000            # Idle priority

# ─── مراحل الإطار ───
ثابت مرحلة_خامل = "خامل"
ثابت مرحلة_عابرة = "عابرة"
ثابت مرحلة_بناء = "بناء"
ثابت مرحلة_تخطيط = "تخطيط"
ثابت مرحلة_تركيب = "تركيب"
ثابت مرحلة_رسم = "رسم"
ثابت مرحلة_دلالات = "دلالات"
ثابت مرحلة_تنظيف = "تنظيف"

# ─── مهمة_مؤجلة (DeferredTask) ───
صدّر صنف مهمة_مؤجلة
    # (AR) مهمة مؤجلة مع أولوية — تنتظر في الطابور حتى يحين وقتها
    #      الأولوية الأقل تُنفَّذ أولاً (0 = فوري)
    # (EN) Deferred task with priority — lower number = higher priority
    باني(رد_نداء = لاشيء, أولوية = أولوية_خاملة, تسمية = "")
        هذا._رد_نداء = رد_نداء
        هذا._أولوية = أولوية
        هذا._تسمية = تسمية
        هذا._نُفِّذت = خطأ
        هذا._ألغيت = خطأ
    نهاية

    دالة الأولوية()
        ارجع هذا._أولوية
    نهاية

    دالة التسمية()
        ارجع هذا._تسمية
    نهاية

    دالة نفّذ()
        إذا (هذا._ألغيت)
            ارجع
        نهاية
        إذا (هذا._رد_نداء != لاشيء)
            هذا._رد_نداء()
        نهاية
        هذا._نُفِّذت = صحيح
    نهاية

    دالة ألغِ()
        هذا._ألغيت = صحيح
    نهاية

    دالة نُفِّذت()
        ارجع هذا._نُفِّذت
    نهاية

    دالة أُلغيت()
        ارجع هذا._ألغيت
    نهاية
نهاية

# ─── طابور_أولويات (PriorityQueue) ───
صدّر صنف طابور_أولويات
    # (AR) طابور مهام مرتبة بالأولوية — الأقل رقمًا تنفَّذ أولاً
    # (EN) Priority queue — lower priority number = executed first
    باني()
        هذا._مهام = []
    نهاية

    دالة أضف(مهمة)
        هذا._مهام = هذا._مهام + [مهمة]
        ارجع هذا
    نهاية

    دالة اسحب_الأعلى()
        # (AR) سحب المهمة ذات الأولوية الأعلى (الرقم الأقل)
        إذا (هذا._مهام == [])
            ارجع لاشيء
        نهاية
        متغير أفضل = هذا._مهام[0]
        متغير فهرس_أفضل = 0
        متغير ف = 1
        بينما (ف < هذا.الحجم())
            إذا (هذا._مهام[ف].الأولوية() < أفضل.الأولوية())
                أفضل = هذا._مهام[ف]
                فهرس_أفضل = ف
            نهاية
            ف = ف + 1
        نهاية
        # إزالة المهمة المسحوبة (تقريب: نسخ بدونها)
        متغير جديدة = []
        متغير ف2 = 0
        بينما (ف2 < هذا.الحجم())
            إذا (ف2 != فهرس_أفضل)
                جديدة = جديدة + [هذا._مهام[ف2]]
            نهاية
            ف2 = ف2 + 1
        نهاية
        هذا._مهام = جديدة
        ارجع أفضل
    نهاية

    دالة الحجم()
        متغير عداد = 0
        لكل _ في هذا._مهام
            عداد = عداد + 1
        نهاية
        ارجع عداد
    نهاية

    دالة فارغ()
        ارجع هذا._مهام == []
    نهاية

    دالة مسح()
        هذا._مهام = []
    نهاية
نهاية

# ─── مراقب_أداء (PerformanceMonitor) ───
صدّر صنف مراقب_أداء
    # (AR) مراقبة أداء الإطارات — يتتبع:
    #      - وقت كل إطار
    #      - عدد الإطارات المتأخرة (jank)
    #      - متوسط زمن الإطار
    #      - أقصى وأدنى زمن
    # (EN) Frame performance monitor — tracks frame times, jank, averages
    باني()
        هذا._أوقات_إطارات = []
        هذا._أقصى_عينات = 120
        هذا._إطارات_متأخرة = 0
        هذا._إجمالي_إطارات = 0
    نهاية

    دالة سجّل_إطار(مدة_مللي)
        هذا._إجمالي_إطارات = هذا._إجمالي_إطارات + 1
        هذا._أوقات_إطارات = هذا._أوقات_إطارات + [مدة_مللي]

        # تقليم قائمة العينات
        بينما (هذا._حجم_أوقات() > هذا._أقصى_عينات)
            # حذف العنصر الأول (تقريب)
            متغير جديدة = []
            متغير ف = 1
            بينما (ف < هذا._حجم_أوقات())
                جديدة = جديدة + [هذا._أوقات_إطارات[ف]]
                ف = ف + 1
            نهاية
            هذا._أوقات_إطارات = جديدة
        نهاية

        # هل الإطار متأخر (jank)؟
        إذا (مدة_مللي > أقصى_مدة_إطار)
            هذا._إطارات_متأخرة = هذا._إطارات_متأخرة + 1
        نهاية
    نهاية

    دالة _حجم_أوقات()
        متغير عداد = 0
        لكل _ في هذا._أوقات_إطارات
            عداد = عداد + 1
        نهاية
        ارجع عداد
    نهاية

    دالة متوسط_وقت_إطار()
        إذا (هذا._أوقات_إطارات == [])
            ارجع 0.0
        نهاية
        متغير مجموع = 0
        لكل و في هذا._أوقات_إطارات
            مجموع = مجموع + و
        نهاية
        ارجع مجموع / هذا._حجم_أوقات()
    نهاية

    دالة إطارات_في_الثانية()
        متغير متوسط = هذا.متوسط_وقت_إطار()
        إذا (متوسط == 0)
            ارجع 0
        نهاية
        ارجع 1000 / متوسط
    نهاية

    دالة نسبة_التأخر()
        إذا (هذا._إجمالي_إطارات == 0)
            ارجع 0.0
        نهاية
        ارجع هذا._إطارات_متأخرة * 100 / هذا._إجمالي_إطارات
    نهاية

    دالة إعادة_ضبط()
        هذا._أوقات_إطارات = []
        هذا._إطارات_متأخرة = 0
        هذا._إجمالي_إطارات = 0
    نهاية
نهاية

# ─── خط_أنابيب_إطار (FramePipeline) ───
صدّر صنف خط_أنابيب_إطار
    # (AR) خط أنابيب الإطار الكامل — يدير تنفيذ كل مراحل الإطار
    #      بالترتيب الصحيح مع مراقبة الأداء
    # (EN) Complete frame pipeline — executes all phases in order
    باني()
        هذا._مرحلة = مرحلة_خامل
        هذا._رقم_إطار = 0
        هذا._رد_نداء_بناء = لاشيء
        هذا._رد_نداء_تخطيط = لاشيء
        هذا._رد_نداء_رسم = لاشيء
        هذا._رد_نداء_دلالات = لاشيء
        هذا._مهام_عابرة = []
        هذا._مهام_بعد = []
        هذا._طابور = جديد طابور_أولويات()
        هذا._مراقب = جديد مراقب_أداء()
        هذا._يحتاج_إطار = خطأ
    نهاية

    دالة عيّن_بناء(رد_نداء)
        هذا._رد_نداء_بناء = رد_نداء
        ارجع هذا
    نهاية

    دالة عيّن_تخطيط(رد_نداء)
        هذا._رد_نداء_تخطيط = رد_نداء
        ارجع هذا
    نهاية

    دالة عيّن_رسم(رد_نداء)
        هذا._رد_نداء_رسم = رد_نداء
        ارجع هذا
    نهاية

    دالة عيّن_دلالات(رد_نداء)
        هذا._رد_نداء_دلالات = رد_نداء
        ارجع هذا
    نهاية

    دالة اطلب_إطار()
        هذا._يحتاج_إطار = صحيح
    نهاية

    دالة جدول_مهمة_عابرة(رد_نداء)
        هذا._مهام_عابرة = هذا._مهام_عابرة + [رد_نداء]
        هذا.اطلب_إطار()
    نهاية

    دالة جدول_مهمة_بعد(رد_نداء)
        هذا._مهام_بعد = هذا._مهام_بعد + [رد_نداء]
    نهاية

    دالة جدول_مهمة_مؤجلة(رد_نداء, أولوية)
        متغير مهمة = جديد مهمة_مؤجلة(رد_نداء, أولوية)
        هذا._طابور.أضف(مهمة)
        ارجع مهمة
    نهاية

    دالة نفّذ_إطار(طابع_زمني)
        # (AR) تنفيذ دورة إطار كاملة بكل مراحلها
        هذا._رقم_إطار = هذا._رقم_إطار + 1
        متغير وقت_بداية = طابع_زمني

        # المرحلة 1: المهام العابرة (حركات + مؤقتات)
        هذا._مرحلة = مرحلة_عابرة
        متغير مهام = هذا._مهام_عابرة
        هذا._مهام_عابرة = []
        لكل مهمة في مهام
            مهمة(طابع_زمني)
        نهاية

        # المرحلة 2: البناء
        هذا._مرحلة = مرحلة_بناء
        إذا (هذا._رد_نداء_بناء != لاشيء)
            هذا._رد_نداء_بناء()
        نهاية

        # المرحلة 3: التخطيط
        هذا._مرحلة = مرحلة_تخطيط
        إذا (هذا._رد_نداء_تخطيط != لاشيء)
            هذا._رد_نداء_تخطيط()
        نهاية

        # المرحلة 4+5: التركيب والرسم
        هذا._مرحلة = مرحلة_رسم
        إذا (هذا._رد_نداء_رسم != لاشيء)
            هذا._رد_نداء_رسم()
        نهاية

        # المرحلة 6: الدلالات
        هذا._مرحلة = مرحلة_دلالات
        إذا (هذا._رد_نداء_دلالات != لاشيء)
            هذا._رد_نداء_دلالات()
        نهاية

        # المرحلة 7: التنظيف
        هذا._مرحلة = مرحلة_تنظيف
        متغير مهام_بعد = هذا._مهام_بعد
        هذا._مهام_بعد = []
        لكل مهمة في مهام_بعد
            مهمة()
        نهاية

        # العودة للخمول
        هذا._مرحلة = مرحلة_خامل
        هذا._يحتاج_إطار = خطأ
    نهاية

    دالة المرحلة()
        ارجع هذا._مرحلة
    نهاية

    دالة رقم_الإطار()
        ارجع هذا._رقم_إطار
    نهاية

    دالة المراقب()
        ارجع هذا._مراقب
    نهاية

    دالة يحتاج_إطار()
        ارجع هذا._يحتاج_إطار
    نهاية
نهاية
