# ─── ثوابت رياضية ───
ثابت باي = 3.14159265358979

# ─── رسم مثلث ───
صدّر دالة مثلث(ن1, ن2, ن3)
    متغير م = جديد مسار()
    م.انتقل_إلى(ن1.س, ن1.ص)
    م.خط_إلى(ن2.س, ن2.ص)
    م.خط_إلى(ن3.س, ن3.ص)
    م.أغلق()
    ارجع م
نهاية

# ─── رسم مضلع منتظم ───
صدّر دالة مضلع(مركز, نصف_قطر, عدد_أضلاع)
    متغير م = جديد مسار()
    متغير زاوية = -باي / 2
    متغير خطوة = 2 * باي / عدد_أضلاع
    متغير أول_س = مركز.س + نصف_قطر * _جتا(زاوية)
    متغير أول_ص = مركز.ص + نصف_قطر * _جا(زاوية)
    م.انتقل_إلى(أول_س, أول_ص)
    لكل ن في _نطاق(1, عدد_أضلاع)
        متغير ز = زاوية + خطوة * ن
        م.خط_إلى(مركز.س + نصف_قطر * _جتا(ز), مركز.ص + نصف_قطر * _جا(ز))
    نهاية
    م.أغلق()
    ارجع م
نهاية

# ─── رسم نجمة ───
صدّر دالة نجمة(مركز, نصف_قطر_خارجي, نصف_قطر_داخلي, عدد_رؤوس)
    متغير م = جديد مسار()
    متغير زاوية = -باي / 2
    متغير خطوة = باي / عدد_رؤوس
    متغير أول_س = مركز.س + نصف_قطر_خارجي * _جتا(زاوية)
    متغير أول_ص = مركز.ص + نصف_قطر_خارجي * _جا(زاوية)
    م.انتقل_إلى(أول_س, أول_ص)
    لكل ن في _نطاق(1, عدد_رؤوس * 2)
        متغير ز = زاوية + خطوة * ن
        متغير نق = نصف_قطر_داخلي
        إذا (ن % 2 == 0)
            نق = نصف_قطر_خارجي
        نهاية
        م.خط_إلى(مركز.س + نق * _جتا(ز), مركز.ص + نق * _جا(ز))
    نهاية
    م.أغلق()
    ارجع م
نهاية

# ─── رسم قلب ───
صدّر دالة قلب(مركز, حجم)
    متغير م = جديد مسار()
    متغير س = مركز.س
    متغير ص = مركز.ص
    متغير ح = حجم
    م.انتقل_إلى(س, ص + ح / 4)
    م.منحنى_مكعب(س + ح / 2, ص - ح / 2, س + ح, ص + ح / 4, س, ص + ح)
    م.انتقل_إلى(س, ص + ح / 4)
    م.منحنى_مكعب(س - ح / 2, ص - ح / 2, س - ح, ص + ح / 4, س, ص + ح)
    م.أغلق()
    ارجع م
نهاية

# ─── رسم سهم ───
صدّر دالة سهم(نقطة_بداية, نقطة_نهاية, حجم_رأس = 10)
    متغير م = جديد مسار()
    م.انتقل_إلى(نقطة_بداية.س, نقطة_بداية.ص)
    م.خط_إلى(نقطة_نهاية.س, نقطة_نهاية.ص)
    # رأس السهم
    متغير زاوية = _زاوية(نقطة_بداية, نقطة_نهاية)
    متغير س1 = نقطة_نهاية.س - حجم_رأس * _جتا(زاوية - باي / 6)
    متغير ص1 = نقطة_نهاية.ص - حجم_رأس * _جا(زاوية - باي / 6)
    متغير س2 = نقطة_نهاية.س - حجم_رأس * _جتا(زاوية + باي / 6)
    متغير ص2 = نقطة_نهاية.ص - حجم_رأس * _جا(زاوية + باي / 6)
    م.انتقل_إلى(نقطة_نهاية.س, نقطة_نهاية.ص)
    م.خط_إلى(س1, ص1)
    م.انتقل_إلى(نقطة_نهاية.س, نقطة_نهاية.ص)
    م.خط_إلى(س2, ص2)
    ارجع م
نهاية

# ─── رسم موجة ───
صدّر دالة موجة(بداية, عدد_موجات, سعة, طول_موجة)
    متغير م = جديد مسار()
    م.انتقل_إلى(بداية.س, بداية.ص)
    لكل ن في _نطاق(0, عدد_موجات)
        متغير س = بداية.س + طول_موجة * ن
        متغير تحكم_ص = بداية.ص - سعة
        إذا (ن % 2 != 0)
            تحكم_ص = بداية.ص + سعة
        نهاية
        م.منحنى_تربيعي(س + طول_موجة / 2, تحكم_ص, س + طول_موجة, بداية.ص)
    نهاية
    ارجع م
نهاية

# ─── رسم شبكة ───
صدّر دالة شبكة(مستطيل, صفوف, أعمدة)
    متغير م = جديد مسار()
    متغير عرض_خلية = مستطيل.عرض / أعمدة
    متغير ارتفاع_خلية = مستطيل.ارتفاع / صفوف
    # خطوط أفقية
    لكل ص في _نطاق(0, صفوف + 1)
        متغير ع = مستطيل.أعلى + ارتفاع_خلية * ص
        م.انتقل_إلى(مستطيل.يسار, ع)
        م.خط_إلى(مستطيل.يسار + مستطيل.عرض, ع)
    نهاية
    # خطوط عمودية
    لكل س في _نطاق(0, أعمدة + 1)
        متغير ي = مستطيل.يسار + عرض_خلية * س
        م.انتقل_إلى(ي, مستطيل.أعلى)
        م.خط_إلى(ي, مستطيل.أعلى + مستطيل.ارتفاع)
    نهاية
    ارجع م
نهاية

# ─── رسم حلزوني ───
صدّر دالة حلزون(مركز, لفات, نصف_قطر_أقصى)
    متغير م = جديد مسار()
    متغير خطوات = لفات * 36
    متغير خطوة_زاوية = 2 * باي * لفات / خطوات
    م.انتقل_إلى(مركز.س, مركز.ص)
    لكل ن في _نطاق(1, خطوات + 1)
        متغير ز = خطوة_زاوية * ن
        متغير نق = نصف_قطر_أقصى * ن / خطوات
        م.خط_إلى(مركز.س + نق * _جتا(ز), مركز.ص + نق * _جا(ز))
    نهاية
    ارجع م
نهاية

# ─── دوال مساعدة خاصة ───
دالة _جا(زاوية)
    # تقريب sin باستخدام سلسلة تايلور
    متغير ز = زاوية % (2 * باي)
    متغير نتيجة = ز
    متغير حد = ز
    لكل ن في _نطاق(1, 10)
        حد = -حد * ز * ز / ((2 * ن) * (2 * ن + 1))
        نتيجة = نتيجة + حد
    نهاية
    ارجع نتيجة
نهاية

دالة _جتا(زاوية)
    ارجع _جا(زاوية + باي / 2)
نهاية

دالة _زاوية(نقطة_بداية, نقطة_نهاية)
    متغير فس = نقطة_نهاية.س - نقطة_بداية.س
    متغير فص = نقطة_نهاية.ص - نقطة_بداية.ص
    # تقريب atan2
    إذا (فس == 0)
        إذا (فص > 0)
            ارجع باي / 2
        نهاية
        ارجع -باي / 2
    نهاية
    متغير ن = فص / فس
    متغير نتيجة = ن - ن * ن * ن / 3 + ن * ن * ن * ن * ن / 5
    إذا (فس < 0)
        إذا (فص >= 0)
            نتيجة = نتيجة + باي
        وإلا
            نتيجة = نتيجة - باي
        نهاية
    نهاية
    ارجع نتيجة
نهاية

دالة _نطاق(بداية, نهاية_ن)
    متغير قائمة = []
    متغير ن = بداية
    بينما (ن < نهاية_ن)
        قائمة.أضف(ن)
        ن = ن + 1
    نهاية
    ارجع قائمة
نهاية
