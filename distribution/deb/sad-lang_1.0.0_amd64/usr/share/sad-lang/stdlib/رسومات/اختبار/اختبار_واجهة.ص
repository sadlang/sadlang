صدّر صنف باحث_عنصر
    باني(جذر)
        هذا._جذر = جذر
        هذا._نتائج = []
    نهاية

    دالة بنوع(نوع)
        هذا._فلتر(لامدا(ع) => ع.نوع == نوع نهاية)
        ارجع هذا
    نهاية

    دالة بنص(نص)
        هذا._فلتر(لامدا(ع) => ع.نص و ع.نص.يحتوي_على(نص) نهاية)
        ارجع هذا
    نهاية

    دالة بمفتاح(مفتاح)
        هذا._فلتر(لامدا(ع) => ع.مفتاح == مفتاح نهاية)
        ارجع هذا
    نهاية

    دالة بسمة(اسم، قيمة)
        هذا._فلتر(لامدا(ع) => ع[اسم] == قيمة نهاية)
        ارجع هذا
    نهاية

    دالة أول()
        ارجع جديد باحث_عنصر_مفرد(هذا.احصل_أول())
    نهاية

    دالة أخير()
        ارجع جديد باحث_عنصر_مفرد(هذا.احصل_أخير())
    نهاية

    دالة بفهرس(رقم)
        ارجع جديد باحث_عنصر_مفرد(هذا._نتائج[رقم])
    نهاية

    دالة احصل_أول()
        إذا (هذا._نتائج.الطول() > 0)
            ارجع هذا._نتائج[0]
        نهاية
        ارجع لاشيء
    نهاية

    دالة احصل_أخير()
        إذا (هذا._نتائج.الطول() > 0)
            ارجع هذا._نتائج[هذا._نتائج.الطول() - 1]
        نهاية
        ارجع لاشيء
    نهاية

    دالة احصل_الكل()
        ارجع هذا._نتائج
    نهاية

    دالة العدد()
        ارجع هذا._نتائج.الطول()
    نهاية

    دالة _فلتر(شرط)
        # تطبيق الفلتر على شجرة العناصر
        هذا._نتائج = هذا._ابحث_عميق(هذا._جذر، شرط)
    نهاية

    دالة _ابحث_عميق(عنصر، شرط)
        متغير نتائج = []
        
        إذا (شرط(عنصر))
            نتائج.أضف(عنصر)
        نهاية
        
        إذا (عنصر.أبناء)
            لكل ابن في عنصر.أبناء
                نتائج = نتائج.ادمج(هذا._ابحث_عميق(ابن، شرط))
            نهاية
        نهاية
        
        ارجع نتائج
    نهاية
نهاية

