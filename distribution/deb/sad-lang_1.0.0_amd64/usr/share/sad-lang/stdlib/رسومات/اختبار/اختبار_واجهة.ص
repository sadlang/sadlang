            إجمالي: 0،
            نجح: 0،
            فشل: 0،
            تخطى: 0،
            مدة: 0
        }
        
        لكل مجموعة في هذا._مجموعات
            انتظر هذا._شغّل_مجموعة(مجموعة، نتائج)
        نهاية
        
