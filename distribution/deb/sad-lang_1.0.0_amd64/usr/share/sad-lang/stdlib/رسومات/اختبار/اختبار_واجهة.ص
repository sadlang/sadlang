                اختبار._حالة = حالة_اختبار.يعمل
                
                انتظر اختبار._دالة()
                
                اختبار._حالة = حالة_اختبار.نجح
                اختبار._مدة = وقت_الآن() - بداية
                نتائج.نجح += 1
                
                إذا (مجموعة._بعد_كل)
                    انتظر مجموعة._بعد_كل()
                نهاية
            امسك (خطأ)
                اختبار._حالة = حالة_اختبار.فشل
                اختبار._خطأ = خطأ
                نتائج.فشل += 1
            نهاية
            
            نتائج.إجمالي += 1
        نهاية
        
        إذا (مجموعة._بعد_الكل)
            انتظر مجموعة._بعد_الكل()
        نهاية
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون.أضف(مستمع)
    نهاية
نهاية

