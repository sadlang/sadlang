    غير_متزامن دالة _شغّل_مجموعة(مجموعة، نتائج)
        إذا (مجموعة._قبل_الكل)
            انتظر مجموعة._قبل_الكل()
        نهاية
        
        لكل اختبار في مجموعة._اختبارات
            حاول
                إذا (مجموعة._قبل_كل)
                    انتظر مجموعة._قبل_كل()
                نهاية
                
