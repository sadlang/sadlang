# ─── صف_إعداد_تفاحة ───
## صف واحد في الإعدادات
صدّر صنف صف_إعداد_تفاحة يرث عنصر
    باني(عنوان, قيمة = لاشيء, أيقونة = لاشيء, عند_الضغط = لاشيء)
        هذا._نوع = "صف_إعداد_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["عنوان"] = عنوان
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["أيقونة"] = أيقونة
        هذا._خصائص["عند_الضغط"] = عند_الضغط
        هذا._خصائص["سهم"] = (عند_الضغط != لاشيء)
        هذا._خصائص["نوع"] = "تنقل"
    نهاية

    ساكن دالة مفتاح(عنوان, قيمة, عند_التغيير, أيقونة = لاشيء)
        متغير ص = جديد صف_إعداد_تفاحة(عنوان, لاشيء, أيقونة, لاشيء)
        ص._خصائص["نوع"] = "مفتاح"
        ص._خصائص["قيمة_مفتاح"] = قيمة
        ص._خصائص["عند_التغيير"] = عند_التغيير
        ص._خصائص["سهم"] = خطأ
        ارجع ص
    نهاية

    ساكن دالة منزلق(عنوان, قيمة, عند_التغيير, حد_أدنى = 0, حد_أقصى = 1, أيقونة = لاشيء)
        متغير ص = جديد صف_إعداد_تفاحة(عنوان, لاشيء, أيقونة, لاشيء)
        ص._خصائص["نوع"] = "منزلق"
        ص._خصائص["قيمة_منزلق"] = قيمة
        ص._خصائص["عند_التغيير"] = عند_التغيير
        ص._خصائص["حد_أدنى"] = حد_أدنى
        ص._خصائص["حد_أقصى"] = حد_أقصى
        ص._خصائص["سهم"] = خطأ
        ارجع ص
    نهاية
نهاية

