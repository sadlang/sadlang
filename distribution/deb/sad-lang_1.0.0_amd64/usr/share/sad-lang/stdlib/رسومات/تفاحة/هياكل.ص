# ─── شريحة_قائمة_تفاحة (SliverList) ───
## شريحة قائمة للتمرير المخصص
صدّر صنف شريحة_قائمة_تفاحة يرث عنصر
    باني(مفوض)
        هذا._نوع = "شريحة_قائمة_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["مفوض"] = مفوض
    نهاية

    ساكن دالة بناء(بناء_عنصر, عدد_عناصر)
        متغير ش = جديد شريحة_قائمة_تفاحة({
            "نوع": "بناء",
            "بناء": بناء_عنصر,
            "عدد": عدد_عناصر
        })
        ارجع ش
    نهاية

    ساكن دالة ثابتة(أبناء)
        متغير ش = جديد شريحة_قائمة_تفاحة({
            "نوع": "ثابت",
            "أبناء": أبناء
        })
        ارجع ش
    نهاية
نهاية

