        # ربط المستمع بالحركة
        هذا._حركة.أضف_مستمع(هذا._عند_تغيير)
    نهاية

    دالة _عند_تغيير()
        # إعادة البناء عند تغيير قيمة الحركة
    نهاية

    دالة بناء()
        ارجع هذا._باني(هذا._حركة)
    نهاية

    دالة تنظيف()
        # يجب إزالة المستمع عند التنظيف
    نهاية
نهاية

