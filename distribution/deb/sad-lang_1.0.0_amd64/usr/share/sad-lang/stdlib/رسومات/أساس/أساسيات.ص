# ===================================================================
# أصناف Flutter الأساسية المفقودة — Missing Flutter Foundation Classes
# ===================================================================
# مستوحى من Flutter framework/foundation
# يشمل: مفتاح, سياق_البناء, عنصر_بسيط, مفتاح_عام,
#        باني_مستقبل, باني_تدفق, عقدة_تركيز
#
# الاستخدام:
#   استورد * من رسومات.أساس.أساسيات
# ===================================================================

استورد * من رسومات.أساس.عنصر

# ===================================================================
#                    نظام المفاتيح (Key System)
# ===================================================================

# ─── مفتاح (Key) — أساس نظام تعريف العناصر ───
صدّر صنف مفتاح
    باني(قيمة)
        هذا._قيمة = قيمة
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة
    نهاية

    دالة يساوي(آخر)
        إذا (آخر == لاشيء)
            ارجع خطأ
        نهاية
        ارجع هذا._قيمة == آخر._قيمة
    نهاية
نهاية

# ─── مفتاح_قيمة (ValueKey) — مفتاح مبني على قيمة ───
صدّر صنف مفتاح_قيمة يرث مفتاح
    باني(قيمة)
        الأساس(قيمة)
    نهاية
نهاية

# ─── مفتاح_فريد_تلقائي (UniqueKey) — مفتاح فريد تلقائي ───
متغير _عداد_مفاتيح = 0

صدّر صنف مفتاح_فريد_تلقائي يرث مفتاح
    باني()
        _عداد_مفاتيح = _عداد_مفاتيح + 1
        الأساس("_unique_" + _عداد_مفاتيح)
    نهاية

    دالة يساوي(آخر)
        ارجع هذا == آخر
    نهاية
نهاية

# ─── مفتاح_عام (GlobalKey) — للوصول للحالة عبر الشجرة ───
متغير _مفاتيح_عامة = {}

صدّر صنف مفتاح_عام يرث مفتاح
    باني(معرف = لاشيء)
        إذا (معرف == لاشيء)
            _عداد_مفاتيح = _عداد_مفاتيح + 1
            معرف = "_global_" + _عداد_مفاتيح
        نهاية
        الأساس(معرف)
        هذا._حالة = لاشيء
        هذا._عنصر = لاشيء
        _مفاتيح_عامة[معرف] = هذا
    نهاية

    دالة الحالة_الحالية()
        ارجع هذا._حالة
    نهاية

    دالة العنصر_الحالي()
        ارجع هذا._عنصر
    نهاية

    دالة _ربط_حالة(حالة)
        هذا._حالة = حالة
    نهاية

    دالة _ربط_عنصر(عنصر)
        هذا._عنصر = عنصر
    نهاية

    ساكن دالة من_معرف(معرف)
        ارجع _مفاتيح_عامة[معرف]
    نهاية
نهاية

# ===================================================================
#                    سياق البناء (BuildContext)
# ===================================================================

# ─── سياق_البناء (BuildContext) — معلومات سياق العنصر في الشجرة ───
صدّر صنف سياق_البناء
    باني(عنصر_حالي = لاشيء, أب = لاشيء)
        هذا._عنصر = عنصر_حالي
        هذا._أب = أب
        هذا._مورثات = {}
        هذا._حجم = لاشيء
    نهاية

    دالة العنصر()
        ارجع هذا._عنصر
    نهاية

    دالة سياق_الأب()
        ارجع هذا._أب
    نهاية

    # البحث عن عنصر موروث في السلسلة الأبوية
    دالة ابحث_عن(نوع)
        إذا (هذا._مورثات[نوع] != لاشيء)
            ارجع هذا._مورثات[نوع]
        نهاية
        إذا (هذا._أب != لاشيء)
            ارجع هذا._أب.ابحث_عن(نوع)
        نهاية
        ارجع لاشيء
    نهاية

    # تسجيل عنصر موروث في هذا السياق
    دالة سجّل_موروث(نوع, قيمة)
        هذا._مورثات[نوع] = قيمة
    نهاية

    # الحصول على حجم العنصر
    دالة الحجم()
        ارجع هذا._حجم
    نهاية

    # الحصول على السمة من السياق
    دالة سمة()
        ارجع هذا.ابحث_عن("سمة")
    نهاية

    # الحصول على استعلام الوسائط
    دالة وسائط()
        ارجع هذا.ابحث_عن("وسائط")
    نهاية

    # الحصول على الموجّه
    دالة موجّه()
        ارجع هذا.ابحث_عن("موجّه")
    نهاية
نهاية

