# ─── عنصر_بسيط (StatelessWidget) — عنصر عديم الحالة ───
صدّر صنف عنصر_بسيط يرث عنصر
    باني()
        الأساس()
        هذا._نوع = "عنصر_بسيط"
        هذا._سياق = لاشيء
    نهاية

    # يُعاد تعريفها في الأصناف الفرعية — يجب إرجاع عنصر واجهة
    دالة بناء(سياق)
        ارجع لاشيء
    نهاية

    دالة _بناء_داخلي(سياق)
        هذا._سياق = سياق
        ارجع هذا.بناء(سياق)
    نهاية
نهاية

# ===================================================================
#                    بناة غير متزامنة (Async Builders)
# ===================================================================

# ─── باني_مستقبل (FutureBuilder) — يبني عنصر بناءً على نتيجة غير متزامنة ───
صدّر صنف باني_مستقبل يرث عنصر
    باني(مستقبل, باني)
        الأساس()
        هذا._نوع = "باني_مستقبل"
        هذا._مستقبل = مستقبل
        هذا._باني = باني
        هذا._حالة = "انتظار"
        هذا._بيانات = لاشيء
        هذا._خطأ = لاشيء
    نهاية

    دالة بناء()
        ارجع هذا._باني(هذا._لقطة())
    نهاية

    دالة _لقطة()
        ارجع {
            "حالة": هذا._حالة,
            "بيانات": هذا._بيانات,
            "خطأ": هذا._خطأ,
            "في_انتظار": هذا._حالة == "انتظار",
            "مكتمل": هذا._حالة == "مكتمل",
            "فشل": هذا._حالة == "خطأ"
        }
    نهاية

    دالة _عند_اكتمال(نتيجة)
        هذا._بيانات = نتيجة
        هذا._حالة = "مكتمل"
    نهاية

    دالة _عند_خطأ(خطأ)
        هذا._خطأ = خطأ
        هذا._حالة = "خطأ"
    نهاية
نهاية

# ─── لقطة_غير_متزامنة (AsyncSnapshot) — نتيجة عملية غير متزامنة ───
صدّر صنف لقطة_غير_متزامنة
    باني(حالة, بيانات, خطأ)
        هذا.حالة = حالة
        هذا.بيانات = بيانات
        هذا.خطأ = خطأ
    نهاية

    دالة في_انتظار()
        ارجع هذا.حالة == "انتظار"
    نهاية

    دالة مكتمل()
        ارجع هذا.حالة == "مكتمل" و هذا.خطأ == لاشيء
    نهاية

    دالة فشل()
        ارجع هذا.خطأ != لاشيء
    نهاية

    ساكن دالة انتظار()
        ارجع جديد لقطة_غير_متزامنة("انتظار", لاشيء, لاشيء)
    نهاية

    ساكن دالة بيانات(قيمة)
        ارجع جديد لقطة_غير_متزامنة("مكتمل", قيمة, لاشيء)
    نهاية

    ساكن دالة خطأ_لقطة(رسالة_الخطأ)
        ارجع جديد لقطة_غير_متزامنة("خطأ", لاشيء, رسالة_الخطأ)
    نهاية
نهاية

# ─── باني_تدفق (StreamBuilder) — يبني عنصر بناءً على تدفق بيانات ───
صدّر صنف باني_تدفق يرث عنصر
    باني(تدفق, باني, قيمة_أولية = لاشيء)
        الأساس()
        هذا._نوع = "باني_تدفق"
        هذا._تدفق = تدفق
        هذا._باني = باني
        هذا._آخر_قيمة = قيمة_أولية
        هذا._خطأ = لاشيء
        هذا._حالة = "انتظار"
    نهاية

    دالة بناء()
        ارجع هذا._باني(هذا._لقطة())
    نهاية

    دالة _لقطة()
        ارجع جديد لقطة_غير_متزامنة(
            هذا._حالة,
            هذا._آخر_قيمة,
            هذا._خطأ
        )
    نهاية

    دالة _عند_بيانات(قيمة)
        هذا._آخر_قيمة = قيمة
        هذا._حالة = "نشط"
    نهاية

    دالة _عند_خطأ(رسالة_الخطأ)
        هذا._خطأ = رسالة_الخطأ
        هذا._حالة = "خطأ"
    نهاية

    دالة _عند_اكتمال()
        هذا._حالة = "مكتمل"
    نهاية
نهاية

# ===================================================================
#                    نظام التركيز (Focus System)
# ===================================================================

# ─── عقدة_تركيز (FocusNode) — إدارة التركيز ───
صدّر صنف عقدة_تركيز
    باني(تسمية = لاشيء)
        هذا._تسمية = تسمية
        هذا._مركز = خطأ
        هذا._مستمعون = []
        هذا._أب = لاشيء
        هذا._أبناء = []
    نهاية

    دالة مركز()
        ارجع هذا._مركز
    نهاية

    دالة طلب_تركيز()
        هذا._مركز = صحيح
        هذا._أشعر()
    نهاية

    دالة فقد_تركيز()
        هذا._مركز = خطأ
        هذا._أشعر()
    نهاية

    دالة أضف_مستمع(مستمع)
        هذا._مستمعون = هذا._مستمعون + [مستمع]
    نهاية

    دالة أزل_مستمع(مستمع)
        متغير جديدة = []
        لكل م في هذا._مستمعون
            إذا (م != مستمع)
                جديدة = جديدة + [م]
            نهاية
        نهاية
        هذا._مستمعون = جديدة
    نهاية

    دالة _أشعر()
        لكل م في هذا._مستمعون
            م(هذا._مركز)
        نهاية
    نهاية

    دالة تنظيف()
        هذا._مستمعون = []
        هذا._مركز = خطأ
    نهاية
نهاية

# ─── نطاق_تركيز (FocusScopeNode) — نطاق تركيز يجمع عدة عقد ───
صدّر صنف نطاق_تركيز يرث عقدة_تركيز
    باني(تسمية = لاشيء)
        الأساس(تسمية)
        هذا._العقد = []
        هذا._الحالي = لاشيء
    نهاية

    دالة أضف_عقدة(عقدة)
        هذا._العقد = هذا._العقد + [عقدة]
        عقدة._أب = هذا
    نهاية

    دالة ركز_على(عقدة)
        # فقد تركيز العقدة الحالية
        إذا (هذا._الحالي != لاشيء)
            هذا._الحالي.فقد_تركيز()
        نهاية
        # تركيز العقدة الجديدة
        هذا._الحالي = عقدة
        عقدة.طلب_تركيز()
    نهاية

    دالة التالي()
        إذا (طول(هذا._العقد) == 0)
            ارجع لاشيء
        نهاية
        متغير فهرس = 0
        إذا (هذا._الحالي != لاشيء)
            متغير ع = 0
            لكل عقدة في هذا._العقد
                إذا (عقدة == هذا._الحالي)
                    فهرس = ع + 1
                نهاية
                ع = ع + 1
            نهاية
            إذا (فهرس >= طول(هذا._العقد))
                فهرس = 0
            نهاية
        نهاية
        هذا.ركز_على(هذا._العقد[فهرس])
    نهاية
نهاية

