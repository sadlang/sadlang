نهاية

# ─── مؤشر_شبح_تفاحة (Shimmer Effect) ───
## تأثير التحميل الهيكلي (Skeleton loading)
صدّر صنف مؤشر_شبح_تفاحة يرث عنصر
    باني(عرض, ارتفاع, نصف_قطر = 8)
        هذا._نوع = "مؤشر_شبح_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["عرض"] = عرض
        هذا._خصائص["ارتفاع"] = ارتفاع
        هذا._خصائص["نصف_قطر"] = نصف_قطر
        هذا._خصائص["لون_قاعدة"] = "#E0E0E0"
        هذا._خصائص["لون_لامع"] = "#F5F5F5"
        هذا._خصائص["مدة"] = 1500  # مللي ثانية
    نهاية

    ساكن دالة دائري(قطر)
        متغير م = جديد مؤشر_شبح_تفاحة(قطر, قطر, قطر / 2)
        ارجع م
    نهاية

    ساكن دالة نص(عرض, ارتفاع = 16)
        ارجع جديد مؤشر_شبح_تفاحة(عرض, ارتفاع, 4)
    نهاية
نهاية

# ─── غطاء_تحميل_تفاحة ───
## غطاء شفاف مع مؤشر تحميل
صدّر صنف غطاء_تحميل_تفاحة يرث عنصر
    باني(ابن, يعرض = صحيح, رسالة = لاشيء)
        هذا._نوع = "غطاء_تحميل_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = [ابن]
        هذا._خصائص["يعرض"] = يعرض
        هذا._خصائص["رسالة"] = رسالة
        هذا._خصائص["لون_غطاء"] = "rgba(0,0,0,0.3)"
        هذا._خصائص["لون_مؤشر"] = "#FFFFFF"
    نهاية

    دالة مع_رسالة(نص)
        هذا._خصائص["رسالة"] = نص
        ارجع هذا
    نهاية
نهاية
