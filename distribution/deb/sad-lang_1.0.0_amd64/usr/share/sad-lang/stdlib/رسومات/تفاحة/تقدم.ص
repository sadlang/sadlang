# ─── مؤشر_نشاط_تفاحة (CupertinoActivityIndicator) ───
## مؤشر التحميل الدوار بنمط iOS
صدّر صنف مؤشر_نشاط_تفاحة يرث عنصر
    باني(نشط = صحيح, نصف_قطر = 10)
        هذا._نوع = "مؤشر_نشاط_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["نشط"] = نشط
        هذا._خصائص["نصف_قطر"] = نصف_قطر
        هذا._خصائص["لون"] = لاشيء  # يستخدم لون النظام تلقائياً
    نهاية

    دالة لون(قيمة)
        هذا._خصائص["لون"] = قيمة
        ارجع هذا
    نهاية

    # مؤشر جزئي (partial) بنسبة محددة
    ساكن دالة جزئي(قيمة, نصف_قطر = 10)
        متغير م = جديد مؤشر_نشاط_تفاحة(صحيح, نصف_قطر)
        م._خصائص["قيمة_جزئية"] = قيمة
        م._نوع = "مؤشر_نشاط_تفاحة_جزئي"
        ارجع م
    نهاية
نهاية

# ─── شريط_تقدم_تفاحة (CupertinoLinearProgressIndicator) ───
## شريط تقدم خطي بنمط iOS (غير موجود في Flutter الأصلي لكن مفيد)
صدّر صنف شريط_تقدم_تفاحة يرث عنصر
    باني(قيمة = لاشيء)
        هذا._نوع = "شريط_تقدم_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        # قيمة = لاشيء تعني غير محدد (indeterminate)
        هذا._خصائص["قيمة"] = قيمة
        هذا._خصائص["لون"] = "#007AFF"
        هذا._خصائص["لون_خلفية"] = "#E5E5EA"
        هذا._خصائص["ارتفاع"] = 4
        هذا._خصائص["نصف_قطر"] = 2
    نهاية

    دالة لون(قيمة)
        هذا._خصائص["لون"] = قيمة
        ارجع هذا
    نهاية
نهاية

# ─── سحب_تحديث_تفاحة (CupertinoSliverRefreshControl) ───
## التحديث بالسحب للأسفل بنمط iOS
صدّر صنف سحب_تحديث_تفاحة يرث عنصر
    باني(عند_التحديث = لاشيء, ارتفاع_تحديث = 60)
        هذا._نوع = "سحب_تحديث_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = []
        هذا._خصائص["عند_التحديث"] = عند_التحديث
        هذا._خصائص["ارتفاع_تحديث"] = ارتفاع_تحديث
        هذا._خصائص["بناء"] = لاشيء
    نهاية

    دالة بناء_مخصص(دالة_بناء)
        هذا._خصائص["بناء"] = دالة_بناء
        ارجع هذا
    نهاية
نهاية

# ─── محمّل_صفحة_تفاحة (CupertinoFullscreenDialogTransition) ───
## انتقال ملء الشاشة بنمط iOS (modal presentation)
صدّر صنف محمّل_صفحة_تفاحة يرث عنصر
    باني(تحريك, ابن, بتأثير_خطي = خطأ)
        هذا._نوع = "محمّل_صفحة_تفاحة"
        هذا._خصائص = {}
        هذا._أبناء = [ابن]
        هذا._خصائص["تحريك"] = تحريك
        هذا._خصائص["بتأثير_خطي"] = بتأثير_خطي
    نهاية
نهاية

