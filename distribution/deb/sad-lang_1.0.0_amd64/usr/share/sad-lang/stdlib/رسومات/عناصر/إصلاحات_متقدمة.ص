# العيب #16: Implicit Animations - الحركات الضمنية
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف حركة_ضمنية
    باني(خاصية، مدة، تسهيل)
        هذا._خاصية = خاصية
        هذا._مدة = مدة أو 300
        هذا._تسهيل = تسهيل أو "تسارع_تباطؤ"
        هذا._قيمة_حالية = لاشيء
        هذا._قيمة_هدف = لاشيء
        هذا._حركة = لاشيء
    نهاية

    دالة عيّن_قيمة(قيمة)
        إذا (هذا._قيمة_حالية == لاشيء)
            هذا._قيمة_حالية = قيمة
            هذا._قيمة_هدف = قيمة
            ارجع
        نهاية

        إذا (قيمة == هذا._قيمة_هدف)
            ارجع
        نهاية

        هذا._قيمة_هدف = قيمة
        هذا._ابدأ_حركة()
    نهاية

    دالة _ابدأ_حركة()
        إذا (هذا._حركة != لاشيء)
            هذا._حركة.أوقف()
        نهاية

        متغير بداية = هذا._قيمة_حالية
        متغير نهاية = هذا._قيمة_هدف
        متغير مدة = هذا._مدة

        هذا._حركة = جديد تحريك_قيمة(بداية، نهاية، مدة، لامدا(قيمة) =>
            هذا._قيمة_حالية = قيمة
            إذا (هذا._عند_تحديث != لاشيء)
                هذا._عند_تحديث(قيمة)
            نهاية
        نهاية)

        هذا._حركة.شغّل()
    نهاية

    دالة القيمة()
        ارجع هذا._قيمة_حالية
    نهاية
نهاية

صدّر صنف حاوية_متحركة
    باني()
        هذا._حركات = {}
    نهاية

    دالة عيّن_خاصية(اسم، قيمة، مدة)
        إذا (هذا._حركات[اسم] == لاشيء)
            هذا._حركات[اسم] = جديد حركة_ضمنية(اسم، مدة)
        نهاية
        هذا._حركات[اسم].عيّن_قيمة(قيمة)
    نهاية

    دالة احصل(اسم)
        إذا (هذا._حركات[اسم] != لاشيء)
            ارجع هذا._حركات[اسم].القيمة()
        نهاية
        ارجع لاشيء
    نهاية
نهاية

