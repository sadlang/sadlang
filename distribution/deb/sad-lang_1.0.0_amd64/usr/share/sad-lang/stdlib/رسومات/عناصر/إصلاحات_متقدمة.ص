# #21: ConstrainedBox
صدّر صنف صندوق_مقيد
    باني(قيود، ابن)
        هذا.قيود = قيود
        هذا.ابن = ابن
    نهاية

    دالة تخطيط(قيود_أب)
        متغير قيود_مدمجة = هذا._دمج_قيود(قيود_أب، هذا.قيود)
        هذا.ابن.تخطيط(قيود_مدمجة)
    نهاية

    دالة _دمج_قيود(أب، محلي)
        ارجع {
            أدنى_عرض: ماكس(أب.أدنى_عرض أو 0، محلي.أدنى_عرض أو 0)،
            أقصى_عرض: مين(أب.أقصى_عرض أو 999999، محلي.أقصى_عرض أو 999999)،
            أدنى_ارتفاع: ماكس(أب.أدنى_ارتفاع أو 0، محلي.أدنى_ارتفاع أو 0)،
            أقصى_ارتفاع: مين(أب.أقصى_ارتفاع أو 999999، محلي.أقصى_ارتفاع أو 999999)
        }
    نهاية
نهاية

# #22: AspectRatio
صدّر صنف نسبة_أبعاد
    باني(نسبة، ابن)
        هذا.نسبة = نسبة  # عرض / ارتفاع
        هذا.ابن = ابن
    نهاية

    دالة تخطيط(قيود)
        متغير عرض = قيود.أقصى_عرض
        متغير ارتفاع = عرض / هذا.نسبة

        إذا (ارتفاع > قيود.أقصى_ارتفاع)
            ارتفاع = قيود.أقصى_ارتفاع
            عرض = ارتفاع * هذا.نسبة
        نهاية

        هذا.ابن.تخطيط({
            أدنى_عرض: عرض،
            أقصى_عرض: عرض،
            أدنى_ارتفاع: ارتفاع،
            أقصى_ارتفاع: ارتفاع
        })

        ارجع {عرض: عرض، ارتفاع: ارتفاع}
    نهاية
نهاية

