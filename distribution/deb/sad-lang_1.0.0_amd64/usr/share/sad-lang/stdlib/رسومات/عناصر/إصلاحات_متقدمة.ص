# #25: BackdropFilter
صدّر صنف مرشح_خلفية
    باني(مرشح، ابن)
        هذا.مرشح = مرشح  # {نوع: "ضبابية"، كثافة: 10}
        هذا.ابن = ابن
    نهاية

    دالة ارسم(سياق)
        # احفظ منطقة الخلفية
        سياق.احفظ()
        
        طابق (هذا.مرشح.نوع)
            عندما "ضبابية":
                سياق.طبّق_ضبابية(هذا.مرشح.كثافة)
            عندما "تشبع":
                سياق.طبّق_تشبع(هذا.مرشح.قيمة)
        نهاية
        
        هذا.ابن.ارسم(سياق)
        سياق.استعد()
    نهاية
نهاية
