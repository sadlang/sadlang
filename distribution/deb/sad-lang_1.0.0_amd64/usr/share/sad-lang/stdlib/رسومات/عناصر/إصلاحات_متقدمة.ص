# العيب #18: Gesture Arena - حلبة الإيماءات
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف حلبة_إيماءات
    باني()
        هذا._متنافسون = []
        هذا._فائز = لاشيء
    نهاية

    دالة أضف_متنافس(كاشف)
        هذا._متنافسون.أضف({
            كاشف: كاشف،
            حالة: "منتظر"
        })
    نهاية

    دالة حسم()
        إذا (هذا._فائز != لاشيء)
            ارجع هذا._فائز
        نهاية

        # احسم بناءً على الأولوية والثقة
        متغير أفضل = لاشيء
        متغير أعلى_ثقة = 0

        لكل متنافس في هذا._متنافسون
            إذا (متنافس.حالة == "قبول")
                متغير ثقة = متنافس.كاشف.الثقة()
                إذا (ثقة > أعلى_ثقة)
                    أعلى_ثقة = ثقة
                    أفضل = متنافس
                نهاية
            نهاية
        نهاية

        إذا (أفضل != لاشيء)
            هذا._فائز = أفضل.كاشف
            # أخبر الخاسرين
            لكل متنافس في هذا._متنافسون
                إذا (متنافس != أفضل)
                    متنافس.كاشف.رفض()
                نهاية
            نهاية
        نهاية

        ارجع هذا._فائز
    نهاية

    دالة قبول(كاشف)
        لكل متنافس في هذا._متنافسون
            إذا (متنافس.كاشف == كاشف)
                متنافس.حالة = "قبول"
                توقف
            نهاية
        نهاية
        هذا.حسم()
    نهاية

    دالة رفض(كاشف)
        هذا._متنافسون = هذا._متنافسون.فلتر(لامدا(م) => م.كاشف != كاشف)
        هذا.حسم()
    نهاية

    دالة نظّف()
        هذا._متنافسون = []
        هذا._فائز = لاشيء
    نهاية
نهاية

