# العيب #17: Hero Transitions - انتقالات البطل
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف بطل
    باني(وسم، ابن)
        هذا.وسم = وسم
        هذا.ابن = ابن
        هذا._حدود = لاشيء
    نهاية

    دالة احفظ_حدود()
        هذا._حدود = هذا.ابن.احصل_حدود_عامة()
    نهاية

    دالة الحدود()
        ارجع هذا._حدود
    نهاية
نهاية

صدّر صنف متحكم_بطل
    ساكن متغير _أبطال = {}

    ساكن دالة سجّل(بطل)
        متحكم_بطل._أبطال[بطل.وسم] = بطل
        بطل.احفظ_حدود()
    نهاية

    ساكن دالة ألغِ_تسجيل(وسم)
        احذف متحكم_بطل._أبطال[وسم]
    نهاية

    ساكن دالة حرّك(وسم، حدود_جديدة، مدة)
        متغير بطل = متحكم_بطل._أبطال[وسم]
        إذا (بطل == لاشيء)
            ارجع لاشيء
        نهاية

        متغير حدود_قديمة = بطل.الحدود()
        
        # أنشئ طبقة انتقالية
        متغير طبقة = جديد طبقة_انتقال_بطل(بطل.ابن، حدود_قديمة، حدود_جديدة, مدة)
        طبقة.شغّل()
        
        ارجع طبقة
    نهاية
نهاية

صدّر صنف طبقة_انتقال_بطل
    باني(عنصر، من، إلى، مدة)
        هذا._عنصر = عنصر
        هذا._من = من
        هذا._إلى = إلى
        هذا._مدة = مدة أو 300
    نهاية

    دالة شغّل()
        # أخفِ العنصر الأصلي
        هذا._عنصر.عيّن_مرئي(خطأ)

        # أنشئ نسخة متحركة
        متغير حركة = جديد تحريك_متعدد({
            س: {من: هذا._من.س، إلى: هذا._إلى.س}،
            ص: {من: هذا._من.ص، إلى: هذا._إلى.ص}،
            عرض: {من: هذا._من.عرض، إلى: هذا._إلى.عرض}،
            ارتفاع: {من: هذا._من.ارتفاع، إلى: هذا._إلى.ارتفاع}
        }، هذا._مدة)

        حركة.عند_اكتمال = لامدا() =>
            هذا._عنصر.عيّن_مرئي(صحيح)
        نهاية

        حركة.شغّل()
    نهاية
نهاية

