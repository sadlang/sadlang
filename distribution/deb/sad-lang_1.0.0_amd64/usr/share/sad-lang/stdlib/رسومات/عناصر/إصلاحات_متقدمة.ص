# العيب #20: Form Validation - التحقق من النماذج
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف محقق_نموذج
    باني()
        هذا._حقول = {}
        هذا._أخطاء = {}
    نهاية

    دالة سجّل_حقل(اسم، قواعد)
        هذا._حقول[اسم] = {
            قواعد: قواعد،
            قيمة: ""
        }
    نهاية

    دالة عيّن_قيمة(اسم، قيمة)
        إذا (هذا._حقول[اسم] != لاشيء)
            هذا._حقول[اسم].قيمة = قيمة
            هذا._تحقق_حقل(اسم)
        نهاية
    نهاية

    دالة _تحقق_حقل(اسم)
        متغير حقل = هذا._حقول[اسم]
        متغير أخطاء = []

        لكل قاعدة في حقل.قواعد
            متغير نتيجة = قاعدة(حقل.قيمة)
            إذا (نتيجة != صحيح)
                أخطاء.أضف(نتيجة)
            نهاية
        نهاية

        إذا (أخطاء.الطول() > 0)
            هذا._أخطاء[اسم] = أخطاء
        وإلا
            احذف هذا._أخطاء[اسم]
        نهاية
    نهاية

    دالة تحقق_الكل()
        لكل اسم في هذا._حقول
            هذا._تحقق_حقل(اسم)
        نهاية
        ارجع مفاتيح(هذا._أخطاء).الطول() == 0
    نهاية

    دالة خطأ(اسم)
        ارجع هذا._أخطاء[اسم] ? هذا._أخطاء[اسم][0] : لاشيء
    نهاية

    دالة صالح()
        ارجع مفاتيح(هذا._أخطاء).الطول() == 0
    نهاية

    دالة القيم()
        متغير نتيجة = {}
        لكل اسم في هذا._حقول
            نتيجة[اسم] = هذا._حقول[اسم].قيمة
        نهاية
        ارجع نتيجة
    نهاية
نهاية

