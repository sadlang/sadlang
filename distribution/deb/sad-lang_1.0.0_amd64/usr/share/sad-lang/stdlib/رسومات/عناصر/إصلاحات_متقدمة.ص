# العيب #19: Theme Inheritance - وراثة السمات
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

صدّر صنف سمة
    باني(بيانات، أب)
        هذا._بيانات = بيانات أو {}
        هذا._أب = أب
    نهاية

    دالة احصل(مسار)
        متغير أجزاء = مسار.قسّم(".")
        متغير قيمة = هذا._بيانات

        لكل جزء في أجزاء
            إذا (قيمة == لاشيء)
                توقف
            نهاية
            قيمة = قيمة[جزء]
        نهاية

        # إذا لم نجد، ابحث في الأب
        إذا (قيمة == لاشيء و هذا._أب != لاشيء)
            ارجع هذا._أب.احصل(مسار)
        نهاية

        ارجع قيمة
    نهاية

    دالة عيّن(مسار، قيمة)
        متغير أجزاء = مسار.قسّم(".")
        متغير كائن = هذا._بيانات

        لكل ي في نطاق(0، أجزاء.الطول() - 1)
            إذا (كائن[أجزاء[ي]] == لاشيء)
                كائن[أجزاء[ي]] = {}
            نهاية
            كائن = كائن[أجزاء[ي]]
        نهاية

        كائن[أجزاء[-1]] = قيمة
    نهاية

    دالة دمج(سمة_أخرى)
        ارجع جديد سمة(دمج_عميق(هذا._بيانات، سمة_أخرى._بيانات)، هذا._أب)
    نهاية

    دالة ابن(تعديلات)
        ارجع جديد سمة(تعديلات، هذا)
    نهاية
نهاية

صدّر صنف مزود_سمة
    ساكن متغير _مكدس = []

    ساكن دالة ادفع(سمة)
        مزود_سمة._مكدس.أضف(سمة)
    نهاية

    ساكن دالة انزع()
        ارجع مزود_سمة._مكدس.انزع()
    نهاية

    ساكن دالة الحالية()
        إذا (مزود_سمة._مكدس.الطول() > 0)
            ارجع مزود_سمة._مكدس[-1]
        نهاية
        ارجع لاشيء
    نهاية

    ساكن دالة احصل(مسار)
        متغير سمة = مزود_سمة.الحالية()
        إذا (سمة != لاشيء)
            ارجع سمة.احصل(مسار)
        نهاية
        ارجع لاشيء
    نهاية
نهاية

