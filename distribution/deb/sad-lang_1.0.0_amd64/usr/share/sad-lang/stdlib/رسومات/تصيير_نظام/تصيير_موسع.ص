# ─── إزاحة_عرض (ViewportOffset) ───
صدّر صنف إزاحة_عرض
    باني(بكسلات = 0)
        هذا._بكسلات = بكسلات
        هذا._اتجاه = "خامل"
        هذا._مستمعون = []
    نهاية

    دالة البكسلات()
        ارجع هذا._بكسلات
    نهاية

    دالة عيّن_البكسلات(قيمة)
        هذا._بكسلات = قيمة
        لكل م في هذا._مستمعون
            م()
        نهاية
    نهاية

    دالة صحّح(قيمة)
        هذا._بكسلات = هذا._بكسلات + قيمة
    نهاية

    ساكن دالة صفر()
        ارجع جديد إزاحة_عرض(0)
    نهاية
نهاية

