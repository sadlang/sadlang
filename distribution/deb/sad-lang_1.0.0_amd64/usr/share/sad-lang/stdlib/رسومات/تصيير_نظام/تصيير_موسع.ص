# ─── طبقة_تصيير (RenderLayer — compositing) ───
صدّر صنف طبقة_تصيير
    باني()
        هذا._أبناء = []
        هذا._يحتاج_تركيب = صحيح
    نهاية

    دالة أضف_ابن(طبقة_فرعية)
        هذا._أبناء = هذا._أبناء + [طبقة_فرعية]
    نهاية

    دالة أزل_الكل()
        هذا._أبناء = []
    نهاية
نهاية

