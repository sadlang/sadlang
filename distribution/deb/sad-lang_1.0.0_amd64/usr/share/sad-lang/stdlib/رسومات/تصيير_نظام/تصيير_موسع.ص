استورد * من رسومات.تصيير_نظام.تصيير

# ─── تصيير_مرن (RenderFlex — Flexbox) ───
صدّر صنف تصيير_مرن يرث صندوق_تصيير
    باني(اتجاه = "أفقي", محاذاة_رئيسية = "بداية", محاذاة_متقاطعة = "بداية")
        هذا._قيود = لاشيء
        هذا._حجم = لاشيء
        هذا._موقع = {"س": 0, "ص": 0}
        هذا._أبناء = []
        هذا._يحتاج_رسم = صحيح
        هذا._يحتاج_تخطيط = صحيح
        هذا._اتجاه = اتجاه
        هذا._محاذاة_رئيسية = محاذاة_رئيسية
        هذا._محاذاة_متقاطعة = محاذاة_متقاطعة
        هذا._تباعد = 0
    نهاية

    دالة عيّن_الاتجاه(اتجاه)
        هذا._اتجاه = اتجاه
        هذا.علم_يحتاج_تخطيط()
    نهاية

    دالة عيّن_التباعد(تباعد)
        هذا._تباعد = تباعد
        هذا.علم_يحتاج_تخطيط()
    نهاية

    دالة تنفيذ_تخطيط()
        هذا._يحتاج_تخطيط = خطأ
    نهاية
نهاية

