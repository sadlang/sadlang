# ─── مُجدول (SchedulerBinding) ───
صدّر صنف مُجدول
    باني()
        هذا._مهام_عابرة = []
        هذا._مهام_مستمرة = []
        هذا._مهام_بعد_الإطار = []
        هذا._حالة = "خامل"
        هذا._رقم_الإطار = 0
        هذا._وقت_الإطار_الأخير = 0
    نهاية

    دالة جدول_إطار(رد_نداء)
        هذا._مهام_عابرة = هذا._مهام_عابرة + [رد_نداء]
        ارجع هذا
    نهاية

    دالة أضف_مهمة_مستمرة(رد_نداء)
        هذا._مهام_مستمرة = هذا._مهام_مستمرة + [رد_نداء]
        ارجع هذا
    نهاية

    دالة أزل_مهمة_مستمرة(رد_نداء)
        # يحتاج تنفيذ فلترة
        ارجع هذا
    نهاية

    دالة جدول_بعد_الإطار(رد_نداء)
        هذا._مهام_بعد_الإطار = هذا._مهام_بعد_الإطار + [رد_نداء]
        ارجع هذا
    نهاية

    دالة معالجة_إطار(طابع_وقت)
        هذا._رقم_الإطار = هذا._رقم_الإطار + 1
        هذا._حالة = "عابرة"

        # تنفيذ المهام العابرة
        متغير مهام = هذا._مهام_عابرة
        هذا._مهام_عابرة = []
        لكل مهمة في مهام
            مهمة(طابع_وقت)
        نهاية

        # تنفيذ المهام المستمرة
        هذا._حالة = "مستمرة"
        لكل مهمة في هذا._مهام_مستمرة
            مهمة(طابع_وقت)
        نهاية

        # تنفيذ مهام ما بعد الإطار
        هذا._حالة = "بعد_الإطار"
        متغير مهام_بعد = هذا._مهام_بعد_الإطار
        هذا._مهام_بعد_الإطار = []
        لكل مهمة في مهام_بعد
            مهمة(طابع_وقت)
        نهاية

        هذا._حالة = "خامل"
        هذا._وقت_الإطار_الأخير = طابع_وقت
    نهاية

    دالة رقم_الإطار()
        ارجع هذا._رقم_الإطار
    نهاية

    دالة الحالة()
        ارجع هذا._حالة
    نهاية
نهاية

# ─── مؤقت (Ticker) ───
صدّر صنف مؤقت
    باني(رد_نداء = لاشيء)
        هذا._رد_نداء = رد_نداء
        هذا._نشط = خطأ
        هذا._صامت = خطأ
        هذا._وقت_البداية = لاشيء
    نهاية

    دالة بدء()
        هذا._نشط = صحيح
        هذا._وقت_البداية = 0
        ارجع هذا
    نهاية

    دالة أوقف()
        هذا._نشط = خطأ
        ارجع هذا
    نهاية

    دالة نشط()
        ارجع هذا._نشط
    نهاية

    دالة صامت(قيمة)
        هذا._صامت = قيمة
        ارجع هذا
    نهاية

    دالة تخلص()
        هذا._نشط = خطأ
        هذا._رد_نداء = لاشيء
    نهاية
نهاية

# ─── مزود_مؤقت (TickerProvider) ───
صدّر صنف مزود_مؤقت
    باني()
        هذا._مؤقتات = []
    نهاية

    دالة أنشئ_مؤقت(رد_نداء)
        متغير م = جديد مؤقت(رد_نداء)
        هذا._مؤقتات = هذا._مؤقتات + [م]
        ارجع م
    نهاية

    دالة تخلص_الكل()
        لكل م في هذا._مؤقتات
            م.تخلص()
        نهاية
        هذا._مؤقتات = []
    نهاية
نهاية

# ─── أولوية (Priority) ───
صدّر صنف أولوية
    ساكن ثابت خاملة = 0
    ساكن ثابت حركة = 100000
    ساكن ثابت لمس = 200000
    ساكن ثابت كبح = 250000
نهاية

# ─── مهمة_مجدولة (ScheduledTask) ───
صدّر صنف مهمة_مجدولة
    باني(رد_نداء = لاشيء, أولوية = 0, تسمية = "")
        هذا._رد_نداء = رد_نداء
        هذا._أولوية = أولوية
        هذا._تسمية = تسمية
        هذا._ملغاة = خطأ
    نهاية

    دالة إلغاء()
        هذا._ملغاة = صحيح
    نهاية

    دالة ملغاة()
        ارجع هذا._ملغاة
    نهاية
نهاية
