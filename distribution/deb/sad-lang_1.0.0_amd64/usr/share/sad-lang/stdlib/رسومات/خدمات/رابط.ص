# ===================================================================
# خدمة الروابط — URL/Link Service (شامل متعدد المنصات)
# stdlib/رسومات/خدمات/رابط.ص
# ===================================================================
# مكتبة روابط شاملة تدعم:
#   - فتح روابط خارجية
#   - تحليل URLs
#   - بناء URLs
#   - مخطط Deep Links
#   - Universal Links
#
# المنصات المدعومة:
#   ✅ سطح المكتب (ShellExecute / xdg-open / open)
#   ✅ النواة (غير مدعوم)
#   ✅ الويب (window.open / location.href)
#   ✅ أندرويد (Intent.ACTION_VIEW)
#   ✅ iOS (UIApplication.open)
# ===================================================================

استورد * من _محرك_واجهات

# ===================================================================
#       محلل_رابط — URL Parser
# ===================================================================

صدّر صنف محلل_رابط
    باني(عنوان = "")
        هذا.عنوان = عنوان
        هذا.مخطط = ""       # http, https, ftp
        هذا.مضيف = ""
        هذا.منفذ = ""
        هذا.مسار = ""
        هذا.استعلام = ""
        هذا.جزء = ""        # fragment (#)
        إذا (عنوان != "")
            هذا._حلل()
        نهاية
    نهاية

    ## تحليل الرابط
    دالة _حلل()
        متغير ع = هذا.عنوان
        # استخراج المخطط
        حاول
            متغير فاصل = موقع_نص(ع, "://")
            إذا (فاصل > 0)
                هذا.مخطط = جزء_نص(ع, 0, فاصل)
                ع = جزء_نص(ع, فاصل + 3, طول(ع))
            نهاية
            # استخراج الجزء (#)
            فاصل = موقع_نص(ع, "#")
            إذا (فاصل >= 0)
                هذا.جزء = جزء_نص(ع, فاصل + 1, طول(ع))
                ع = جزء_نص(ع, 0, فاصل)
            نهاية
            # استخراج الاستعلام (?)
            فاصل = موقع_نص(ع, "?")
            إذا (فاصل >= 0)
                هذا.استعلام = جزء_نص(ع, فاصل + 1, طول(ع))
                ع = جزء_نص(ع, 0, فاصل)
            نهاية
            # استخراج المسار
            فاصل = موقع_نص(ع, "/")
            إذا (فاصل >= 0)
                هذا.مسار = جزء_نص(ع, فاصل, طول(ع))
                ع = جزء_نص(ع, 0, فاصل)
            نهاية
            هذا.مضيف = ع
        امسك خ
            هذا.مضيف = هذا.عنوان
        نهاية
    نهاية

    ## إعادة بناء الرابط كنص
    دالة نص()
        متغير نتيجة = ""
        إذا (هذا.مخطط != "")
            نتيجة = هذا.مخطط + "://"
        نهاية
        نتيجة = نتيجة + هذا.مضيف
        إذا (هذا.منفذ != "")
            نتيجة = نتيجة + ":" + هذا.منفذ
        نهاية
        نتيجة = نتيجة + هذا.مسار
        إذا (هذا.استعلام != "")
            نتيجة = نتيجة + "?" + هذا.استعلام
        نهاية
        إذا (هذا.جزء != "")
            نتيجة = نتيجة + "#" + هذا.جزء
        نهاية
        ارجع نتيجة
    نهاية
نهاية

