## فتح رابط خارجي
صدّر دالة افتح(عنوان)
    حاول
        افتح_رابط(عنوان)
    امسك خ
        # تجاهل
    نهاية
نهاية

## فتح رابط بريد إلكتروني
صدّر دالة بريد(إلى, موضوع = "", محتوى = "")
    متغير رابط = "mailto:" + إلى
    إذا (موضوع != "" أو محتوى != "")
        رابط = رابط + "?subject=" + موضوع + "&body=" + محتوى
    نهاية
    افتح(رابط)
نهاية

## فتح رابط هاتف
صدّر دالة هاتف(رقم)
    افتح("tel:" + رقم)
نهاية

## فتح رابط رسالة
صدّر دالة رسالة(رقم, نص = "")
    متغير رابط = "sms:" + رقم
    إذا (نص != "")
        رابط = رابط + "?body=" + نص
    نهاية
    افتح(رابط)
نهاية

## تحليل رابط
صدّر دالة حلل(عنوان)
    ارجع جديد محلل_رابط(عنوان)
نهاية
