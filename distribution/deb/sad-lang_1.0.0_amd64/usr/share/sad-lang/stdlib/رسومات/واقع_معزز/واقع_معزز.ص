صدّر صنف متجه_ثلاثي
    باني(س، ص، ع)
        هذا.س = س أو 0
        هذا.ص = ص أو 0
        هذا.ع = ع أو 0
    نهاية

    دالة جمع(آخر)
        ارجع جديد متجه_ثلاثي(
            هذا.س + آخر.س،
            هذا.ص + آخر.ص،
            هذا.ع + آخر.ع
        )
    نهاية

    دالة ضرب(عدد)
        ارجع جديد متجه_ثلاثي(
            هذا.س * عدد،
            هذا.ص * عدد،
            هذا.ع * عدد
        )
    نهاية

    دالة الطول()
        ارجع جذر(هذا.س*هذا.س + هذا.ص*هذا.ص + هذا.ع*هذا.ع)
    نهاية

    دالة تطبيع()
        متغير ط = هذا.الطول()
        إذا (ط > 0)
            ارجع جديد متجه_ثلاثي(هذا.س/ط، هذا.ص/ط، هذا.ع/ط)
        نهاية
        ارجع جديد متجه_ثلاثي(0، 0، 0)
    نهاية
نهاية

