#**
 * @module نصوص
 * @brief (AR) دوال معالجة النصوص
 * @brief (EN) String manipulation functions
 * 
 * الاستخدام:
 *   استورد نصوص
 *   استورد قسم، صل من نصوص
 **#

صدّر دالة قسم(نص، فاصل)
    # (AR) يقسم النص إلى مصفوفة بناءً على الفاصل
    ارجع split(نص، فاصل)
نهاية

صدّر دالة صل(مصفوفة، فاصل)
    # (AR) يصل عناصر المصفوفة بفاصل
    ارجع join(مصفوفة، فاصل)
نهاية

صدّر دالة أحرف_كبيرة(نص)
    # (AR) يحول النص إلى أحرف كبيرة
    ارجع upper(نص)
نهاية

صدّر دالة أحرف_صغيرة(نص)
    # (AR) يحول النص إلى أحرف صغيرة
    ارجع lower(نص)
نهاية

صدّر دالة قص_أطراف(نص)
    # (AR) يزيل المسافات من بداية ونهاية النص
    ارجع trim(نص)
نهاية

صدّر دالة استبدل(نص، قديم، جديد)
    # (AR) يستبدل جزءاً من النص
    ارجع replace(نص، قديم، جديد)
نهاية

صدّر دالة يحتوي(نص، جزء)
    # (AR) يتحقق إذا كان النص يحتوي على جزء
    ارجع contains(نص، جزء)
نهاية

صدّر دالة يبدأ_بـ(نص، بادئة)
    # (AR) يتحقق إذا كان النص يبدأ بالبادئة
    ارجع startsWith(نص، بادئة)
نهاية

صدّر دالة ينتهي_بـ(نص، لاحقة)
    # (AR) يتحقق إذا كان النص ينتهي باللاحقة
    ارجع endsWith(نص، لاحقة)
نهاية

صدّر دالة قطعة(نص، بداية، نهاية_)
    # (AR) يستخرج جزءاً من النص
    ارجع substring(نص، بداية، نهاية_)
نهاية

صدّر دالة بحث(نص، جزء)
    # (AR) يبحث عن موضع الجزء في النص
    ارجع indexOf(نص، جزء)
نهاية

صدّر دالة تكرار(نص، عدد)
    # (AR) يكرر النص عدة مرات
    ارجع repeat(نص، عدد)
نهاية

صدّر دالة عكس_نص(نص)
    # (AR) يعكس النص
    ارجع reverse(نص)
نهاية

صدّر دالة حرف_عند(نص، فهرس)
    # (AR) يجلب الحرف عند الفهرس
    ارجع charAt(نص، فهرس)
نهاية

صدّر دالة رمز_حرف(نص، فهرس)
    # (AR) يجلب رمز يونيكود للحرف
    ارجع charCodeAt(نص، فهرس)
نهاية

صدّر دالة من_رمز(رمز)
    # (AR) يحول رمز يونيكود إلى حرف
    ارجع fromCharCode(رمز)
نهاية

صدّر دالة تنسيق(قالب، ...قيم)
    # (AR) ينسق النص بالقيم
    ارجع format(قالب، قيم)
نهاية
