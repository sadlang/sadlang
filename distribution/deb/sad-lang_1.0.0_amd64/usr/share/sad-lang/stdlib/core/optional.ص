/**
 * @ملف optional.sad
 * @وصف نوع اختياري<ن> - يُمثِّل قيمة قد تكون موجودة أو غائبة
 * @المؤلف فريق لغة ص
 * @التاريخ يناير 2026
 * @الإصدار 1.0
 * @المرحلة المرحلة 4: US2 - أمان الذاكرة
 * 
 * =============================================================================
 *                         النوع الاختياري في لغة ص
 *                         Optional Type in Sad Language
 * =============================================================================
 * 
 *     النوع `اختياري<ن>` يُمثِّل قيمة قد تكون:
 *     
 *     • `بعض(قيمة)` - القيمة موجودة
 *     • `لاشيء` - القيمة غائبة (null-safe)
 *     
 *     هذا النوع يُغني عن استخدام null/nullptr الخطرة ويجعل
 *     الكود أكثر أماناً وصراحة.
 * 
 * =============================================================================
 *                              أمثلة الاستخدام
 * =============================================================================
 * 
 *     // إنشاء قيمة اختيارية
 *     دع عمر: اختياري<عدد> = بعض(25)
 *     دع اسم: اختياري<نص> = لاشيء
 *     
 *     // التحقق من الوجود
 *     إذا عمر.موجود() {
 *         اطبع("العمر: " + عمر.افتح())
 *     }
 *     
 *     // استخدام القيمة الافتراضية
 *     دع ن = اسم.أو_("مجهول")
 *     
 *     // التحويل (map)
 *     دع مضاعف = عمر.حول(|ع| ع * 2)
 *     
 *     // التسلسل (and_then)
 *     دع نتيجة = عمر.ثم(|ع| إذا ع > 18 { بعض("بالغ") } وإلا { لاشيء })
 */

// =============================================================================
//                         تعريف النوع / Type Definition
// =============================================================================

/**
 * @نوع اختياري<ن>
 * @وصف نوع يُمثِّل قيمة قد تكون موجودة أو غائبة
 * 
 *     هذا النوع معدد (enum) بحالتين:
 *     - `بعض(ن)` : تحتوي على قيمة من النوع ن
 *     - `لاشيء` : لا تحتوي على قيمة
 */
علني نوع_معدد اختياري<ن> {
    /// القيمة موجودة
    بعض(ن),
    
    /// القيمة غائبة
    لاشيء
}

// =============================================================================
//                         الدوال الأساسية / Basic Methods
// =============================================================================

تنفيذ<ن> اختياري<ن> {
    
    // =========================================================================
    //                         الإنشاء / Creation
    // =========================================================================
    
    /**
     * @دالة من_قيمة
     * @وصف إنشاء اختياري من قيمة موجودة
     * @معامل قيمة: القيمة المراد تغليفها
     * @إرجاع اختياري يحتوي على القيمة
     * 
     *     مثال:
     *         دع خ = اختياري.من_قيمة(42)
     *         // خ = بعض(42)
     */
    علني ثابتة دالة من_قيمة(قيمة: ن) -> اختياري<ن> {
        أرجع بعض(قيمة)
    }
    
    /**
     * @دالة فارغ
     * @وصف إنشاء اختياري فارغ
     * @إرجاع اختياري بدون قيمة
     * 
     *     مثال:
     *         دع خ: اختياري<عدد> = اختياري.فارغ()
     *         // خ = لاشيء
     */
    علني ثابتة دالة فارغ() -> اختياري<ن> {
        أرجع لاشيء
    }
    
    // =========================================================================
    //                         التحقق / Checking
    // =========================================================================
    
    /**
     * @دالة موجود
     * @وصف التحقق من وجود قيمة
     * @إرجاع صحيح إذا كانت القيمة موجودة
     * 
     *     مثال:
     *         دع خ = بعض(10)
     *         إذا خ.موجود() {
     *             اطبع("القيمة موجودة!")
     *         }
     */
    علني دالة موجود(&ذاتي) -> منطقي {
        تطابق ذاتي {
            بعض(_) => صحيح,
            لاشيء => خطأ
        }
    }
    
    /**
     * @دالة غائب
     * @وصف التحقق من غياب القيمة
     * @إرجاع صحيح إذا كانت القيمة غائبة
     * 
     *     مثال:
     *         دع خ: اختياري<عدد> = لاشيء
     *         إذا خ.غائب() {
     *             اطبع("لا توجد قيمة")
     *         }
     */
    علني دالة غائب(&ذاتي) -> منطقي {
        !ذاتي.موجود()
    }
    
    // =========================================================================
    //                         الوصول للقيمة / Value Access
    // =========================================================================
    
    /**
     * @دالة افتح
     * @وصف الحصول على القيمة (يُذعر إذا كانت غائبة)
     * @إرجاع القيمة الموجودة
     * @ذعر إذا كانت القيمة غائبة
     * 
     *     تحذير: هذه الدالة تُذعر إذا كانت القيمة غائبة!
     *     استخدم `موجود()` للتحقق أولاً أو استخدم `أو_()` للأمان.
     * 
     *     مثال:
     *         دع خ = بعض(42)
     *         دع ق = خ.افتح()  // ق = 42
     */
    علني دالة افتح(ذاتي) -> ن {
        تطابق ذاتي {
            بعض(قيمة) => قيمة,
            لاشيء => أذعر!("محاولة فتح قيمة اختيارية غائبة!")
        }
    }
    
    /**
     * @دالة افتح_أو
     * @وصف الحصول على القيمة أو قيمة افتراضية
     * @معامل افتراضي: القيمة الافتراضية إذا كانت غائبة
     * @إرجاع القيمة الموجودة أو الافتراضية
     * 
     *     مثال:
     *         دع خ: اختياري<عدد> = لاشيء
     *         دع ق = خ.افتح_أو(0)  // ق = 0
     */
    علني دالة افتح_أو(ذاتي، افتراضي: ن) -> ن {
        تطابق ذاتي {
            بعض(قيمة) => قيمة,
            لاشيء => افتراضي
        }
    }
    
    /**
     * @دالة افتح_أو_نفذ
     * @وصف الحصول على القيمة أو تنفيذ دالة للقيمة الافتراضية
     * @معامل د: دالة تُرجع القيمة الافتراضية (كسولة)
     * @إرجاع القيمة الموجودة أو نتيجة الدالة
     * 
     *     مثال:
     *         دع خ: اختياري<عدد> = لاشيء
     *         دع ق = خ.افتح_أو_نفذ(|| حساب_معقد())
     */
    علني دالة افتح_أو_نفذ<د: دالة() -> ن>(ذاتي، د: د) -> ن {
        تطابق ذاتي {
            بعض(قيمة) => قيمة,
            لاشيء => د()
        }
    }
    
    /**
     * @دالة أو_
     * @وصف اختصار لـ افتح_أو
     * @معامل افتراضي: القيمة الافتراضية
     * @إرجاع القيمة أو الافتراضية
     */
    علني دالة أو_(ذاتي، افتراضي: ن) -> ن {
        ذاتي.افتح_أو(افتراضي)
    }
    
    // =========================================================================
    //                         التحويل / Transformation
    // =========================================================================
    
    /**
     * @دالة حول
     * @وصف تحويل القيمة باستخدام دالة (map)
     * @معامل د: دالة التحويل
     * @إرجاع اختياري بالقيمة المحولة أو لاشيء
     * 
     *     مثال:
     *         دع خ = بعض(5)
     *         دع م = خ.حول(|ع| ع * 2)  // م = بعض(10)
     *         
     *         دع ف: اختياري<عدد> = لاشيء
     *         دع ن = ف.حول(|ع| ع * 2)  // ن = لاشيء
     */
    علني دالة حول<م، د: دالة(ن) -> م>(ذاتي، د: د) -> اختياري<م> {
        تطابق ذاتي {
            بعض(قيمة) => بعض(د(قيمة)),
            لاشيء => لاشيء
        }
    }
    
    /**
     * @دالة ثم
     * @وصف تسلسل العمليات (and_then / flatMap)
     * @معامل د: دالة تُرجع اختياري
     * @إرجاع نتيجة الدالة أو لاشيء
     * 
     *     مثال:
     *         دالة قسمة_آمنة(أ: عدد، ب: عدد) -> اختياري<عدد> {
     *             إذا ب == 0 { أرجع لاشيء }
     *             أرجع بعض(أ / ب)
     *         }
     *         
     *         دع نتيجة = بعض(10).ثم(|ع| قسمة_آمنة(ع، 2))
     *         // نتيجة = بعض(5)
     */
    علني دالة ثم<م، د: دالة(ن) -> اختياري<م>>(ذاتي، د: د) -> اختياري<م> {
        تطابق ذاتي {
            بعض(قيمة) => د(قيمة),
            لاشيء => لاشيء
        }
    }
    
    /**
     * @دالة صفي
     * @وصف تصفية القيمة بشرط (filter)
     * @معامل شرط: دالة الشرط
     * @إرجاع ذاتي إذا تحقق الشرط، وإلا لاشيء
     * 
     *     مثال:
     *         دع خ = بعض(18)
     *         دع بالغ = خ.صفي(|ع| ع >= 18)  // بالغ = بعض(18)
     *         
     *         دع صغير = بعض(10).صفي(|ع| ع >= 18)  // صغير = لاشيء
     */
    علني دالة صفي<د: دالة(&ن) -> منطقي>(ذاتي، شرط: د) -> اختياري<ن> {
        تطابق ذاتي {
            بعض(قيمة) => {
                إذا شرط(&قيمة) {
                    بعض(قيمة)
                } وإلا {
                    لاشيء
                }
            },
            لاشيء => لاشيء
        }
    }
    
    // =========================================================================
    //                         الدمج / Combining
    // =========================================================================
    
    /**
     * @دالة أو
     * @وصف إرجاع ذاتي إذا موجود، وإلا البديل
     * @معامل بديل: القيمة البديلة
     * @إرجاع ذاتي أو البديل
     * 
     *     مثال:
     *         دع أ: اختياري<عدد> = لاشيء
     *         دع ب = بعض(5)
     *         دع نتيجة = أ.أو(ب)  // نتيجة = بعض(5)
     */
    علني دالة أو(ذاتي، بديل: اختياري<ن>) -> اختياري<ن> {
        تطابق ذاتي {
            بعض(_) => ذاتي,
            لاشيء => بديل
        }
    }
    
    /**
     * @دالة و
     * @وصف إرجاع الآخر إذا كان ذاتي موجود، وإلا لاشيء
     * @معامل آخر: القيمة الأخرى
     * @إرجاع الآخر إذا ذاتي موجود
     * 
     *     مثال:
     *         دع أ = بعض(1)
     *         دع ب = بعض(2)
     *         دع نتيجة = أ.و(ب)  // نتيجة = بعض(2)
     */
    علني دالة و<م>(ذاتي، آخر: اختياري<م>) -> اختياري<م> {
        تطابق ذاتي {
            بعض(_) => آخر,
            لاشيء => لاشيء
        }
    }
    
    /**
     * @دالة ادمج
     * @وصف دمج قيمتين اختياريتين في واحدة
     * @معامل آخر: القيمة الأخرى
     * @معامل دامج: دالة الدمج
     * @إرجاع اختياري بالقيمة المدمجة
     * 
     *     مثال:
     *         دع أ = بعض(10)
     *         دع ب = بعض(5)
     *         دع مجموع = أ.ادمج(ب، |س، ص| س + ص)  // بعض(15)
     */
    علني دالة ادمج<م، نت، د: دالة(ن، م) -> نت>(
        ذاتي،
        آخر: اختياري<م>،
        دامج: د
    ) -> اختياري<نت> {
        تطابق (ذاتي، آخر) {
            (بعض(أ)، بعض(ب)) => بعض(دامج(أ، ب)),
            _ => لاشيء
        }
    }
    
    // =========================================================================
    //                         التحويل لأنواع أخرى / Conversion
    // =========================================================================
    
    /**
     * @دالة إلى_نتيجة
     * @وصف تحويل الاختياري إلى نتيجة
     * @معامل خطأ: قيمة الخطأ إذا كانت غائبة
     * @إرجاع نجاح(قيمة) أو فشل(خطأ)
     * 
     *     مثال:
     *         دع خ: اختياري<عدد> = لاشيء
     *         دع ن = خ.إلى_نتيجة("القيمة غير موجودة")
     *         // ن = فشل("القيمة غير موجودة")
     */
    علني دالة إلى_نتيجة<خ>(ذاتي، خطأ: خ) -> نتيجة<ن، خ> {
        تطابق ذاتي {
            بعض(قيمة) => نجاح(قيمة),
            لاشيء => فشل(خطأ)
        }
    }
    
    /**
     * @دالة إلى_قائمة
     * @وصف تحويل الاختياري إلى قائمة
     * @إرجاع قائمة بعنصر واحد أو فارغة
     * 
     *     مثال:
     *         دع خ = بعض(42)
     *         دع ق = خ.إلى_قائمة()  // [42]
     */
    علني دالة إلى_قائمة(ذاتي) -> قائمة<ن> {
        تطابق ذاتي {
            بعض(قيمة) => [قيمة],
            لاشيء => []
        }
    }
    
    // =========================================================================
    //                         التكرار / Iteration
    // =========================================================================
    
    /**
     * @دالة لكل
     * @وصف تنفيذ دالة على القيمة إذا كانت موجودة
     * @معامل د: الدالة للتنفيذ
     * 
     *     مثال:
     *         بعض(42).لكل(|ق| اطبع("القيمة: " + ق))
     *         // يطبع: القيمة: 42
     */
    علني دالة لكل<د: دالة(ن)>(ذاتي، د: د) {
        تطابق ذاتي {
            بعض(قيمة) => د(قيمة),
            لاشيء => {}
        }
    }
}

// =============================================================================
//                         تنفيذ السمات / Trait Implementations
// =============================================================================

/**
 * سمة المقارنة للنوع الاختياري
 */
تنفيذ<ن: مقارنة> مقارنة لـ اختياري<ن> {
    دالة يساوي(&ذاتي، آخر: &اختياري<ن>) -> منطقي {
        تطابق (ذاتي، آخر) {
            (بعض(أ)، بعض(ب)) => أ.يساوي(ب),
            (لاشيء، لاشيء) => صحيح,
            _ => خطأ
        }
    }
}

/**
 * سمة النسخ للنوع الاختياري (إذا كان ن قابل للنسخ)
 */
تنفيذ<ن: نسخ> نسخ لـ اختياري<ن> {
    دالة انسخ(&ذاتي) -> ذاتي {
        تطابق ذاتي {
            بعض(قيمة) => بعض(قيمة.انسخ()),
            لاشيء => لاشيء
        }
    }
}

/**
 * سمة الاستنساخ للنوع الاختياري
 */
تنفيذ<ن: استنساخ> استنساخ لـ اختياري<ن> {
    دالة استنسخ(&ذاتي) -> ذاتي {
        تطابق ذاتي {
            بعض(قيمة) => بعض(قيمة.استنسخ()),
            لاشيء => لاشيء
        }
    }
}

/**
 * سمة التنقيح للنوع الاختياري
 */
تنفيذ<ن: تنقيح> تنقيح لـ اختياري<ن> {
    دالة صيغة_تنقيح(&ذاتي) -> نص {
        تطابق ذاتي {
            بعض(قيمة) => "بعض(" + قيمة.صيغة_تنقيح() + ")",
            لاشيء => "لاشيء"
        }
    }
}

/**
 * سمة العرض للنوع الاختياري
 */
تنفيذ<ن: عرض> عرض لـ اختياري<ن> {
    دالة صيغة(&ذاتي) -> نص {
        تطابق ذاتي {
            بعض(قيمة) => قيمة.صيغة(),
            لاشيء => "(غائب)"
        }
    }
}

// =============================================================================
//                         الدوال المساعدة / Helper Functions
// =============================================================================

/**
 * @دالة بعض
 * @وصف إنشاء اختياري بقيمة موجودة (اختصار)
 * @معامل قيمة: القيمة
 * @إرجاع اختياري بالقيمة
 * 
 *     مثال:
 *         دع خ = بعض(42)
 */
علني دالة بعض<ن>(قيمة: ن) -> اختياري<ن> {
    اختياري::بعض(قيمة)
}

/**
 * @دالة لاشيء
 * @وصف إنشاء اختياري فارغ (اختصار)
 * @إرجاع اختياري فارغ
 * 
 *     مثال:
 *         دع خ: اختياري<عدد> = لاشيء()
 */
علني دالة لاشيء<ن>() -> اختياري<ن> {
    اختياري::لاشيء
}

// =============================================================================
//                         أمثلة الاستخدام / Usage Examples
// =============================================================================

/**
 * أمثلة توضيحية لاستخدام النوع الاختياري:
 * 
 *     // البحث في قاموس
 *     دالة ابحث_في_قاموس(قاموس: &قاموس<نص، عدد>، مفتاح: نص) -> اختياري<عدد> {
 *         إذا قاموس.يحتوي(مفتاح) {
 *             أرجع بعض(قاموس[مفتاح])
 *         }
 *         أرجع لاشيء
 *     }
 *     
 *     // استخدام مع التسلسل
 *     دع أعمار = قاموس::جديد()
 *     أعمار.أضف("أحمد"، 25)
 *     
 *     دع نتيجة = ابحث_في_قاموس(&أعمار، "أحمد")
 *         .حول(|ع| ع + 1)           // أضف سنة
 *         .صفي(|ع| ع >= 18)         // تأكد أنه بالغ
 *         .أو_(0)                    // قيمة افتراضية
 *     
 *     اطبع("العمر بعد سنة: " + نتيجة)
 *     
 *     // التعامل مع القيم الغائبة
 *     دع مجهول = ابحث_في_قاموس(&أعمار، "محمد")
 *     تطابق مجهول {
 *         بعض(عمر) => اطبع("العمر: " + عمر),
 *         لاشيء => اطبع("الشخص غير موجود")
 *     }
 */
