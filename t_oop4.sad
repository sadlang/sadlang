صنف شكل
    عام
        نص الاسم
        
        دالة نص وصف()
            ارجع الاسم
        نهاية
نهاية

صنف مربع يرث شكل
    عام
        رقم الضلع
        
        باني(رقم ض)
            الاسم = "مربع"
            الضلع = ض
        نهاية
        
        دالة رقم المساحة()
            ارجع الضلع * الضلع
        نهاية
نهاية

دالة رئيسية()
    متغير م = جديد مربع(7)
    اطبع("الشكل: ")
    اطبع_سطر(م.وصف())
    اطبع("المساحة: ")
    اطبع_سطر(م.المساحة())
    ارجع 0
نهاية
