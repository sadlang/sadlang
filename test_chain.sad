دالة رئيسية()
    متغير خ = 5
    إذا (خ == 1)
        اطبع_سطر("واحد")
    وإلا_إذا (خ == 2)
        اطبع_سطر("اثنان")
    وإلا_إذا (خ == 3)
        اطبع_سطر("ثلاثة")
    وإلا_إذا (خ == 4)
        اطبع_سطر("أربعة")
    وإلا_إذا (خ == 5)
        اطبع_سطر("خمسة")
    وإلا_إذا (خ == 6)
        اطبع_سطر("ستة")
    وإلا_إذا (خ == 7)
        اطبع_سطر("سبعة")
    وإلا_إذا (خ == 8)
        اطبع_سطر("ثمانية")
    وإلا_إذا (خ == 9)
        اطبع_سطر("تسعة")
    وإلا_إذا (خ == 10)
        اطبع_سطر("عشرة")
    وإلا
        اطبع_سطر("غير معروف")
    نهاية
نهاية
