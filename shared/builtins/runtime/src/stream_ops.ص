استورد حزمة::نواة::مكرر::*
استورد حزمة::نواة::مجموعات::*
استورد حزمة::نواة::اختياري::*

// ═══════════════════════════════════════════════════════════════════════════════
//                     سمة عمليات التدفق | Stream Operations Trait
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * 📋 سمة_عمليات_التدفق | StreamOpsTrait
 * 
 * السمة الأساسية لجميع عمليات التدفق
 * Base trait for all stream operations
 */
سمة عمليات_التدفق<عنصر>: مكرر<عنصر> {
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات التحويل | Transformation Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * حوّل | Map
     * 
     * تحويل كل عنصر باستخدام دالة
     * Transform each element using a function
     * 
     * مثال | Example:
     *   [1، 2، 3].حوّل(|س| س * 2)  // [2، 4، 6]
     */
    دالة حوّل<ناتج>(ذاتي، تحويل: دالة(عنصر) -> ناتج) -> محوّل_تدفق<ذاتي، ناتج>
    
    /**
     * حوّل_مسطح | Flat Map
     * 
     * تحويل كل عنصر لمكرر ثم تسطيح النتيجة
     * Transform each element to an iterator then flatten
     * 
     * مثال | Example:
     *   [[1، 2]، [3، 4]].حوّل_مسطح(|س| س)  // [1، 2، 3، 4]
     */
    دالة حوّل_مسطح<ناتج، مكرر_داخلي>(
        ذاتي، 
        تحويل: دالة(عنصر) -> مكرر_داخلي
    ) -> محوّل_مسطح<ذاتي، ناتج، مكرر_داخلي>
        حيث مكرر_داخلي: مكرر<ناتج>
    
    /**
     * صفّي_حوّل | Filter Map
     * 
     * ترشيح وتحويل في خطوة واحدة
     * Filter and transform in one step
     * 
     * مثال | Example:
     *   نصوص.صفّي_حوّل(|س| س.حوّل_لعدد().نجح())
     */
    دالة صفّي_حوّل<ناتج>(
        ذاتي، 
        تحويل: دالة(عنصر) -> اختياري<ناتج>
    ) -> مصفي_محوّل<ذاتي، ناتج>
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات الترشيح | Filtering Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * صفّي | Filter
     * 
     * الإبقاء على العناصر التي تحقق الشرط
     * Keep elements that satisfy the condition
     * 
     * مثال | Example:
     *   [1، 2، 3، 4، 5].صفّي(|س| س % 2 == 0)  // [2، 4]
     */
    دالة صفّي(ذاتي، شرط: دالة(&عنصر) -> منطقي) -> مصفي_تدفق<ذاتي>
    
    /**
     * أبقِ | Retain (alias for filter)
     */
    دالة أبقِ(ذاتي، شرط: دالة(&عنصر) -> منطقي) -> مصفي_تدفق<ذاتي> {
        أرجع ذاتي.صفّي(شرط)
    }
    
    /**
     * أزل | Remove (inverse filter)
     * 
     * إزالة العناصر التي تحقق الشرط
     * Remove elements that satisfy the condition
     * 
     * مثال | Example:
     *   [1، 2، 3، 4، 5].أزل(|س| س % 2 == 0)  // [1، 3، 5]
     */
    دالة أزل(ذاتي، شرط: دالة(&عنصر) -> منطقي) -> مصفي_تدفق<ذاتي> {
        أرجع ذاتي.صفّي(|س| !شرط(س))
    }
    
    /**
     * فريد | Unique / Distinct
     * 
     * إزالة العناصر المكررة
     * Remove duplicate elements
     * 
     * مثال | Example:
     *   [1، 2، 2، 3، 3، 3].فريد()  // [1، 2، 3]
     */
    دالة فريد(ذاتي) -> فريد_تدفق<ذاتي>
        حيث عنصر: تساوي + تجزئة
    
    /**
     * فريد_بـ | Unique by key
     * 
     * إزالة المكررات حسب مفتاح
     * Remove duplicates by key
     */
    دالة فريد_بـ<مفتاح>(
        ذاتي، 
        استخراج_مفتاح: دالة(&عنصر) -> مفتاح
    ) -> فريد_بمفتاح_تدفق<ذاتي، مفتاح>
        حيث مفتاح: تساوي + تجزئة
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات التحديد | Limiting Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * خذ | Take
     * 
     * أخذ أول n عناصر
     * Take first n elements
     * 
     * مثال | Example:
     *   [1، 2، 3، 4، 5].خذ(3)  // [1، 2، 3]
     */
    دالة خذ(ذاتي، عدد: عدد_طبيعي) -> آخذ_تدفق<ذاتي>
    
    /**
     * خذ_طالما | Take While
     * 
     * أخذ العناصر طالما الشرط صحيح
     * Take elements while condition is true
     * 
     * مثال | Example:
     *   [1، 2، 3، 4، 1].خذ_طالما(|س| س < 4)  // [1، 2، 3]
     */
    دالة خذ_طالما(ذاتي، شرط: دالة(&عنصر) -> منطقي) -> آخذ_مشروط<ذاتي>
    
    /**
     * أسقط | Drop / Skip
     * 
     * تخطي أول n عناصر
     * Skip first n elements
     * 
     * مثال | Example:
     *   [1، 2، 3، 4، 5].أسقط(2)  // [3، 4، 5]
     */
    دالة أسقط(ذاتي، عدد: عدد_طبيعي) -> مسقط_تدفق<ذاتي>
    
    /**
     * أسقط_طالما | Drop While
     * 
     * تخطي العناصر طالما الشرط صحيح
     * Skip elements while condition is true
     */
    دالة أسقط_طالما(ذاتي، شرط: دالة(&عنصر) -> منطقي) -> مسقط_مشروط<ذاتي>
    
    /**
     * خطوة | Step By
     * 
     * أخذ كل n-th عنصر
     * Take every n-th element
     * 
     * مثال | Example:
     *   [1، 2، 3، 4، 5، 6].خطوة(2)  // [1، 3، 5]
     */
    دالة خطوة(ذاتي، خطوة: عدد_طبيعي) -> خطوة_تدفق<ذاتي>
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات الجمع | Collection Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * اجمع | Collect
     * 
     * جمع كل العناصر في مجموعة
     * Collect all elements into a collection
     * 
     * مثال | Example:
     *   مكرر.اجمع::<قائمة<عدد>>()
     */
    دالة اجمع<مجموعة>(&ذاتي) -> مجموعة
        حيث مجموعة: من_مكرر<عنصر>
    
    /**
     * اجمع_قائمة | Collect to List (convenience)
     */
    دالة اجمع_قائمة(&ذاتي) -> قائمة<عنصر> {
        دع نتيجة: قائمة<عنصر> = []
        طالما دع بعض(ع) = ذاتي.التالي() {
            نتيجة.أضف(ع)
        }
        أرجع نتيجة
    }
    
    /**
     * طيّ | Fold
     * 
     * تجميع العناصر باستخدام دالة ثنائية
     * Aggregate elements using a binary function
     * 
     * مثال | Example:
     *   [1، 2، 3، 4].طيّ(0، |مجموع، س| مجموع + س)  // 10
     */
    دالة طيّ<تجميع>(
        &ذاتي، 
        ابتدائي: تجميع،
        دالة_: دالة(تجميع، عنصر) -> تجميع
    ) -> تجميع
    
    /**
     * اختزل | Reduce
     * 
     * مثل طيّ لكن يستخدم أول عنصر كقيمة ابتدائية
     * Like fold but uses first element as initial value
     * 
     * مثال | Example:
     *   [1، 2، 3، 4].اختزل(|أ، ب| أ + ب)  // 10
     */
    دالة اختزل(
        &ذاتي، 
        دالة_: دالة(عنصر، عنصر) -> عنصر
    ) -> اختياري<عنصر>
    
    /**
     * مجموع | Sum
     * 
     * مجموع كل العناصر
     * Sum of all elements
     */
    دالة مجموع(&ذاتي) -> عنصر
        حيث عنصر: جمع + صفر
    {
        أرجع ذاتي.طيّ(عنصر::صفر()، |أ، ب| أ + ب)
    }
    
    /**
     * جداء | Product
     * 
     * جداء كل العناصر
     * Product of all elements
     */
    دالة جداء(&ذاتي) -> عنصر
        حيث عنصر: ضرب + واحد
    {
        أرجع ذاتي.طيّ(عنصر::واحد()، |أ، ب| أ * ب)
    }
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات البحث | Search Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * جد | Find
     * 
     * إيجاد أول عنصر يطابق الشرط
     * Find first element matching condition
     */
    دالة جد(&ذاتي، شرط: دالة(&عنصر) -> منطقي) -> اختياري<عنصر>
    
    /**
     * جد_خريطة | Find Map
     * 
     * بحث مع تحويل في خطوة واحدة
     */
    دالة جد_خريطة<ناتج>(
        &ذاتي، 
        تحويل: دالة(عنصر) -> اختياري<ناتج>
    ) -> اختياري<ناتج>
    
    /**
     * أي | Any
     * 
     * هل يوجد عنصر يطابق الشرط؟
     * Does any element match the condition?
     */
    دالة أي(&ذاتي، شرط: دالة(&عنصر) -> منطقي) -> منطقي {
        أرجع ذاتي.جد(شرط).هو_بعض()
    }
    
    /**
     * كل | All
     * 
     * هل كل العناصر تطابق الشرط؟
     * Do all elements match the condition?
     */
    دالة كل(&ذاتي، شرط: دالة(&عنصر) -> منطقي) -> منطقي
    
    /**
     * لا_شيء | None
     * 
     * هل لا يوجد عنصر يطابق الشرط؟
     * Does no element match the condition?
     */
    دالة لا_شيء(&ذاتي، شرط: دالة(&عنصر) -> منطقي) -> منطقي {
        أرجع !ذاتي.أي(شرط)
    }
    
    /**
     * موضع | Position
     * 
     * إيجاد موضع أول عنصر يطابق الشرط
     * Find position of first matching element
     */
    دالة موضع(&ذاتي، شرط: دالة(&عنصر) -> منطقي) -> اختياري<عدد_طبيعي>
    
    /**
     * يحتوي | Contains
     * 
     * هل يحتوي على العنصر؟
     * Does it contain the element?
     */
    دالة يحتوي(&ذاتي، قيمة: &عنصر) -> منطقي
        حيث عنصر: تساوي
    {
        أرجع ذاتي.أي(|س| س == قيمة)
    }
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات الحد الأقصى/الأدنى | Min/Max Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * أقصى | Max
     * 
     * أكبر عنصر
     * Maximum element
     */
    دالة أقصى(&ذاتي) -> اختياري<عنصر>
        حيث عنصر: مرتب
    
    /**
     * أدنى | Min
     * 
     * أصغر عنصر
     * Minimum element
     */
    دالة أدنى(&ذاتي) -> اختياري<عنصر>
        حيث عنصر: مرتب
    
    /**
     * أقصى_بـ | Max By
     * 
     * أكبر عنصر حسب مفتاح
     * Maximum element by key
     */
    دالة أقصى_بـ<مفتاح>(
        &ذاتي، 
        استخراج: دالة(&عنصر) -> مفتاح
    ) -> اختياري<عنصر>
        حيث مفتاح: مرتب
    
    /**
     * أدنى_بـ | Min By
     * 
     * أصغر عنصر حسب مفتاح
     * Minimum element by key
     */
    دالة أدنى_بـ<مفتاح>(
        &ذاتي، 
        استخراج: دالة(&عنصر) -> مفتاح
    ) -> اختياري<عنصر>
        حيث مفتاح: مرتب
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات الفرز | Sorting Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * رتّب | Sort
     * 
     * ترتيب العناصر تصاعدياً
     * Sort elements in ascending order
     */
    دالة رتّب(&ذاتي) -> قائمة<عنصر>
        حيث عنصر: مرتب
    
    /**
     * رتّب_تنازلياً | Sort Descending
     */
    دالة رتّب_تنازلياً(&ذاتي) -> قائمة<عنصر>
        حيث عنصر: مرتب
    
    /**
     * رتّب_بـ | Sort By
     * 
     * ترتيب حسب مفتاح
     * Sort by key
     */
    دالة رتّب_بـ<مفتاح>(
        &ذاتي، 
        استخراج: دالة(&عنصر) -> مفتاح
    ) -> قائمة<عنصر>
        حيث مفتاح: مرتب
    
    /**
     * عكس | Reverse
     * 
     * عكس الترتيب
     * Reverse order
     */
    دالة عكس(&ذاتي) -> قائمة<عنصر>
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات التجميع | Grouping Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * جمّع_بـ | Group By
     * 
     * تجميع العناصر حسب مفتاح
     * Group elements by key
     * 
     * مثال | Example:
     *   كلمات.جمّع_بـ(|ك| ك.الطول())  // قاموس حسب الطول
     */
    دالة جمّع_بـ<مفتاح>(
        &ذاتي، 
        استخراج: دالة(&عنصر) -> مفتاح
    ) -> قاموس<مفتاح، قائمة<عنصر>>
        حيث مفتاح: تساوي + تجزئة
    
    /**
     * قسّم_بـ | Partition By
     * 
     * تقسيم لمجموعتين حسب شرط
     * Split into two groups by condition
     * 
     * مثال | Example:
     *   أرقام.قسّم_بـ(|ن| ن % 2 == 0)  // (زوجية، فردية)
     */
    دالة قسّم_بـ(
        &ذاتي، 
        شرط: دالة(&عنصر) -> منطقي
    ) -> (قائمة<عنصر>، قائمة<عنصر>)
    
    /**
     * قطع | Chunks
     * 
     * تقسيم لقطع متساوية
     * Split into equal chunks
     * 
     * مثال | Example:
     *   [1، 2، 3، 4، 5].قطع(2)  // [[1، 2]، [3، 4]، [5]]
     */
    دالة قطع(ذاتي، حجم: عدد_طبيعي) -> قطع_تدفق<ذاتي>
    
    /**
     * نافذة | Windows / Sliding Window
     * 
     * نافذة متحركة
     * Sliding window
     * 
     * مثال | Example:
     *   [1، 2، 3، 4].نافذة(2)  // [[1، 2]، [2، 3]، [3، 4]]
     */
    دالة نافذة(ذاتي، حجم: عدد_طبيعي) -> نافذة_تدفق<ذاتي>
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات الدمج | Combining Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * دمج | Zip
     * 
     * دمج مع مكرر آخر
     * Zip with another iterator
     */
    دالة دمج<آخر>(ذاتي، مكرر_آخر: آخر) -> دمج_تدفق<ذاتي، آخر>
        حيث آخر: مكرر
    
    /**
     * سلسل | Chain
     * 
     * سلسلة مع مكرر آخر
     * Chain with another iterator
     */
    دالة سلسل<آخر>(ذاتي، مكرر_آخر: آخر) -> سلسلة_تدفق<ذاتي، آخر>
        حيث آخر: مكرر<عنصر>
    
    /**
     * تشابك | Interleave
     * 
     * تشابك مع مكرر آخر
     * Interleave with another iterator
     * 
     * مثال | Example:
     *   [1، 3، 5].تشابك([2، 4، 6])  // [1، 2، 3، 4، 5، 6]
     */
    دالة تشابك<آخر>(ذاتي، مكرر_آخر: آخر) -> تشابك_تدفق<ذاتي، آخر>
        حيث آخر: مكرر<عنصر>
    
    /**
     * عدّد | Enumerate
     * 
     * إضافة فهرس لكل عنصر
     * Add index to each element
     */
    دالة عدّد(ذاتي) -> عدّد_تدفق<ذاتي>
    
    /**
     * فاصل | Intersperse
     * 
     * إدراج عنصر بين كل عنصرين
     * Insert element between every two elements
     * 
     * مثال | Example:
     *   [1، 2، 3].فاصل(0)  // [1، 0، 2، 0، 3]
     */
    دالة فاصل(ذاتي، فاصل: عنصر) -> فاصل_تدفق<ذاتي>
        حيث عنصر: نسخ
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات الجانب | Side Effect Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * لكل | For Each
     * 
     * تنفيذ عمل لكل عنصر
     * Execute action for each element
     */
    دالة لكل(&ذاتي، عمل: دالة(عنصر))
    
    /**
     * الق_نظرة | Inspect / Peek
     * 
     * إلقاء نظرة على كل عنصر (للتصحيح)
     * Peek at each element (for debugging)
     */
    دالة الق_نظرة(ذاتي، عمل: دالة(&عنصر)) -> نظرة_تدفق<ذاتي>
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                          عمليات متنوعة | Miscellaneous Operations
    // ═══════════════════════════════════════════════════════════════════════════
    
    /**
     * عد | Count
     * 
     * عد العناصر
     * Count elements
     */
    دالة عد(&ذاتي) -> عدد_طبيعي
    
    /**
     * أول | First
     * 
     * الحصول على أول عنصر
     * Get first element
     */
    دالة أول(&ذاتي) -> اختياري<عنصر> {
        أرجع ذاتي.التالي()
    }
    
    /**
     * آخر | Last
     * 
     * الحصول على آخر عنصر
     * Get last element
     */
    دالة آخر(&ذاتي) -> اختياري<عنصر>
    
    /**
     * n_ث | Nth
     * 
     * الحصول على العنصر n
     * Get n-th element
     */
    دالة n_ث(&ذاتي، فهرس: عدد_طبيعي) -> اختياري<عنصر> {
        أرجع ذاتي.أسقط(فهرس).أول()
    }
    
    /**
     * فارغ | Is Empty
     * 
     * هل فارغ؟
     * Is empty?
     */
    دالة فارغ(&ذاتي) -> منطقي {
        أرجع ذاتي.أول().هو_فارغ()
    }
    
    /**
     * دورة | Cycle
     * 
     * تكرار لانهائي
     * Infinite repetition
     */
    دالة دورة(ذاتي) -> دورة_تدفق<ذاتي>
        حيث عنصر: نسخ
    
    /**
     * مسح | Scan
     * 
     * طي مع إخراج كل قيمة وسيطة
     * Fold with output of each intermediate value
     * 
     * مثال | Example:
     *   [1، 2، 3].مسح(0، |م، س| م + س)  // [1، 3، 6]
     */
    دالة مسح<حالة>(
        ذاتي، 
        ابتدائي: حالة،
        تحديث: دالة(&حالة، عنصر) -> اختياري<عنصر>
    ) -> مسح_تدفق<ذاتي، حالة>
}

// ═══════════════════════════════════════════════════════════════════════════════
//                          التطبيق على القائمة | List Implementation
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * توسيع القائمة بعمليات التدفق
 * Extend List with stream operations
 */
تنفيذ<عنصر> عمليات_التدفق<عنصر> لـ قائمة<عنصر> {
    دالة حوّل<ناتج>(ذاتي، تحويل: دالة(عنصر) -> ناتج) -> محوّل_تدفق<ذاتي، ناتج> {
        أرجع محوّل_تدفق::جديد(ذاتي.مكرر()، تحويل)
    }
    
    دالة صفّي(ذاتي، شرط: دالة(&عنصر) -> منطقي) -> مصفي_تدفق<ذاتي> {
        أرجع مصفي_تدفق::جديد(ذاتي.مكرر()، شرط)
    }
    
    دالة خذ(ذاتي، عدد: عدد_طبيعي) -> آخذ_تدفق<ذاتي> {
        أرجع آخذ_تدفق::جديد(ذاتي.مكرر()، عدد)
    }
    
    دالة طيّ<تجميع>(
        &ذاتي، 
        ابتدائي: تجميع،
        دالة_: دالة(تجميع، عنصر) -> تجميع
    ) -> تجميع {
        متغير تجميع = ابتدائي
        لكل عنصر في ذاتي {
            تجميع = دالة_(تجميع، عنصر)
        }
        أرجع تجميع
    }
    
    دالة جد(&ذاتي، شرط: دالة(&عنصر) -> منطقي) -> اختياري<عنصر> {
        لكل عنصر في ذاتي {
            إذا شرط(&عنصر) {
                أرجع بعض(عنصر)
            }
        }
        أرجع فارغ
    }
    
    دالة كل(&ذاتي، شرط: دالة(&عنصر) -> منطقي) -> منطقي {
        لكل عنصر في ذاتي {
            إذا !شرط(&عنصر) {
                أرجع خطأ
            }
        }
        أرجع صحيح
    }
    
    دالة لكل(&ذاتي، عمل: دالة(عنصر)) {
        لكل عنصر في ذاتي {
            عمل(عنصر)
        }
    }
    
    دالة عد(&ذاتي) -> عدد_طبيعي {
        أرجع ذاتي.الطول()
    }
    
    // ... المزيد من التنفيذات
}

// ═══════════════════════════════════════════════════════════════════════════════
//                          أنواع التدفق المساعدة | Helper Stream Types
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * محوّل التدفق | Map Stream
 */
بنية محوّل_تدفق<مصدر، ناتج> {
    مصدر: مصدر،
    تحويل: دالة(مصدر::عنصر) -> ناتج
}

/**
 * مصفي التدفق | Filter Stream
 */
بنية مصفي_تدفق<مصدر> {
    مصدر: مصدر،
    شرط: دالة(&مصدر::عنصر) -> منطقي
}

/**
 * آخذ التدفق | Take Stream
 */
بنية آخذ_تدفق<مصدر> {
    مصدر: مصدر،
    متبقي: عدد_طبيعي
}

/**
 * مسقط التدفق | Skip Stream
 */
بنية مسقط_تدفق<مصدر> {
    مصدر: مصدر،
    متبقي: عدد_طبيعي
}

/**
 * عدّد التدفق | Enumerate Stream
 */
بنية عدّد_تدفق<مصدر> {
    مصدر: مصدر،
    فهرس: عدد_طبيعي
}

/**
 * دمج التدفق | Zip Stream
 */
بنية دمج_تدفق<أول، ثاني> {
    أول: أول،
    ثاني: ثاني
}

/**
 * سلسلة التدفق | Chain Stream
 */
بنية سلسلة_تدفق<أول، ثاني> {
    أول: اختياري<أول>،
    ثاني: ثاني
}

