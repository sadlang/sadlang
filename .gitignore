# ══════════════════════════════════════════════════════════════════
# .gitignore - لغة ص / Sad Programming Language
# ══════════════════════════════════════════════════════════════════

# ── مجلدات البناء / Build directories ──
build/
build_new/
out/
cmake-build-*/

# ── ملفات مُجمَّعة / Compiled files ──
*.exe
*.lib
*.pdb
*.obj
*.o
*.so
*.dll
*.dylib
*.a
*.ilk
*.exp

# ── ملفات IDE ──
.vs/
.vscode/settings.json
.vscode/c_cpp_properties.json
*.suo
*.user
*.userosscache
*.sln.docstates
*.code-workspace
.idea/

# ── CMake ──
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
_deps/

# ── سجلات / Logs ──
*.log

# ── ملفات مؤقتة / Temporary files ──
*.tmp
*.temp
*.swp
*.bak
*.backup
*~

# ── مجلد الملفات المؤقتة للتجارب / Scratch directory ──
_scratch/

# ── مخرجات BMAD / BMAD outputs ──
_bmad-output/

# ── مخرجات البناء والاختبار في الجذر / Build & test output in root ──
# (هذه الملفات يجب نقلها إلى build/ أو حذفها)
build_*.txt
test_*.txt
test_*.xml
test-results.xml
trait_*.txt
graphics_build.txt
sad_debug_log.txt
sadc_build_log*.txt
CMakeLists.txt.new
CMakeLists.txt.backup

# ── ملفات LLVM IR مؤقتة / LLVM IR temp files ──
*.ll
!examples/**/*.ll
!docs/**/*.ll

# ── ملفات تنفيذية تجريبية في الجذر ──
/*.exe
/*.so

# ── سكربتات مؤقتة في الجذر (أدوات تجريبية) ──
/fix*.py
/read_*.py
/tmp_*.py
/test_debug_cli*.py
/fix*.js
/tmp_*.js
!build_wasm.ps1

# ── ملفات أخرى مؤقتة ──
*.ppm
*.rsp
*.bc

# ── ملفات debug و trace ──
*_debug.txt
*_trace.txt
*_err.txt
*_out.txt
*_stderr.txt
*_stdout.txt
dbg*.txt
err*.txt
out*.txt
res*.txt
trace*.txt

# ── مخرجات SIR ──
sir_*.txt

# ── ملفات أدوات التنسيق / Formatter output ──
fmt_*.txt

# ── ملفات اختبار مترجم ──
comp_*.txt
exc_*.txt
fin_*.txt

# ── حزم الموبايل / Mobile packages ──
*.apk
*.ipa

# ── حزم ومكتبات خارجية / External packages ──
node_modules/
__pycache__/
*.pyc
.env

# ── نظام التشغيل / OS files ──
.DS_Store
Thumbs.db
Desktop.ini
