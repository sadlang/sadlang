# ======================================================================
# .gitignore - ملفات ومجلدات يتم تجاهلها بواسطة Git
# ======================================================================

# مجلدات البناء / Build directories
build/
cmake-build-*/
out/
bin/
lib/

# ملفات CMake المؤقتة / CMake temporary files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake

# ملفات الكائنات والمكتبات / Object files and libraries
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe

# ملفات Visual Studio / Visual Studio files
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates

# ملفات Visual Studio Code / VS Code files
.vscode/
*.code-workspace

# ملفات المحرر / Editor files
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ملفات الاختبار المؤقتة / Temporary test files
test_output/
*.log

# ملفات الوثائق المولدة / Generated documentation
docs/html/
docs/latex/
Doxygen/

# ملفات النظام / System files
.idea/
__pycache__/
*.pyc
node_modules/
