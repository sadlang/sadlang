# ════════════════════════════════════════════════════════════════
# .gitignore — لغة ص / Sad Programming Language
# ════════════════════════════════════════════════════════════════

# ── مجلدات البناء / Build directories ──
build/
build_new/
build_cov/
out/
cmake-build-*/

# ── ملفات مُجمَّعة / Compiled files ──
*.exe
*.lib
*.pdb
*.obj
*.o
*.so
*.dll
*.dylib
*.a
*.ilk
*.exp

# ── ملفات IDE ──
.vs/
.vscode/settings.json
.vscode/c_cpp_properties.json
*.suo
*.user
*.userosscache
*.sln.docstates
*.code-workspace
.idea/

# ── CMake ──
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
_deps/

# ── سجلات / Logs ──
*.log

# ── ملفات مؤقتة / Temporary files ──
*.tmp
*.temp
*.swp
*.bak
*.backup
*.fixed
*.new
*~

# ── مجلد الملفات المؤقتة للتجارب / Scratch directory ──
_scratch/

# ── مخرجات BMAD / BMAD outputs ──
# (متتبَّعة في git — حوكمة BMAD جزء من المستودع / tracked: BMAD governance is part of the repo)

# ── مخرجات بناء واختبار في الجذر ──
build_*.txt
test_*.txt
test_*.xml
test-results.xml
trait_*.txt
graphics_build.txt
sad_debug_log.txt
sadc_build_log*.txt
CMakeLists.txt.new
CMakeLists.txt.backup

# ── ملفات LLVM IR مؤقتة ──
*.ll
!examples/**/*.ll
!docs/**/*.ll

# ── ملفات تنفيذ تجريبية في الجذر ──
/*.exe
/*.so

# ── سكربتات مؤقتة في الجذر ──
/fix*.py
/read_*.py
/tmp_*.py
/test_debug_cli*.py
/fix*.js
/tmp_*.js
!build_wasm.ps1

# ── ملفات أخرى مؤقتة ──
*.ppm
*.rsp
*.bc

# ── ملفات debug و trace ──
*_debug.txt
*_trace.txt
*_err.txt
*_out.txt
*_stderr.txt
*_stdout.txt
dbg*.txt
err*.txt
out*.txt
res*.txt
trace*.txt

# ── مخرجات SIR ──
sir_*.txt
*.sir

# ── مخرجات أداة التنسيق / Formatter output ──
fmt_*.txt

# ── ملفات اختبار مترجم ──
comp_*.txt
exc_*.txt
fin_*.txt

# ── حزم الموبايل / Mobile packages ──
*.apk
*.ipa

# ── حزم خارجية ──
node_modules/
__pycache__/
*.pyc
.env

# ── نظام التشغيل / OS files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── ملفات تجريبية في الجذر ──
/_*
# استثناء: مخرجات حوكمة BMAD متتبَّعة في git / exception: BMAD governance tracked
!/_bmad-output/
/[0-9]*_*.ll
/[0-9]*_*.exe
/E[0-9]*_*.ll
/test_*.exe

# ── build/ outputs from individual test files ──
build/_*.ص
build/_*.ll
build/_*.sir
build/_*.txt
build/_*.log
build/_*.json
