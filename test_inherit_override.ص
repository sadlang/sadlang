# اختبار تجاوز الدوال (method override)
صنف حيوان
    متغير الاسم
    باني(اسم)
        هذا.الاسم = اسم
    نهاية
    دالة صوت()
        اطبع("...")
    نهاية
    دالة معلومات()
        اطبع("حيوان: " + هذا.الاسم)
    نهاية
نهاية

صنف قطة يرث حيوان
    باني(اسم)
        الأساس(اسم)
    نهاية
    دالة صوت()
        اطبع("مياو!")
    نهاية
نهاية

صنف كلب يرث حيوان
    باني(اسم)
        الأساس(اسم)
    نهاية
    دالة صوت()
        اطبع("هو هو!")
    نهاية
نهاية

متغير ق = جديد قطة("ميمي")
متغير ك = جديد كلب("بوبي")
ق.معلومات()
ق.صوت()
ك.معلومات()
ك.صوت()
