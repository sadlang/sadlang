# ══════════════════════════════════════════════════════════════════════
# برهان منطق مدير النوافذ (headless) — يعمل عبر sad-run بلا إطار عرض
# ══════════════════════════════════════════════════════════════════════
#
# يعزل منطق المدير من مدير_النوافذ.ص (رفع z / سحب / إغلاق) ويتحقّق منه رقميًّا
# دون فتح سطح حيّ، فيخرج نظيفًا (0) ويصلح بوّابةً في CI. دوالّ المنطق هنا مطابقة
# حرفيًّا لنظيرتها في مدير_النوافذ.ص (لغة ص لا تشارك حالة الوحدة عبر الاستيراد).
# ══════════════════════════════════════════════════════════════════════

# ─── معرّفات النوافذ (ثوابت مسمّاة) ───
متغير نافذة_المستكشف = 0
متغير نافذة_الطرفيّة = 1
متغير نافذة_الإعدادات = 2
متغير عدد_النوافذ = 3

# ─── حالة المدير (مطابقة لملفّ التطبيق) ───
متغير ترتيب_z = [0، 1، 2]
متغير إزاحة_س = [0.0، 40.0، 80.0]
متغير إزاحة_ص = [0.0، 40.0، 80.0]
متغير مغلقة = [خطأ، خطأ، خطأ]

# ─── دوالّ المدير الأساسيّة (مطابقة لملفّ التطبيق) ───
دالة ارفع_للأمام(رقم معرّف)
    متغير جديد = []
    لكل ع في ترتيب_z
        إذا (ع != معرّف)
            جديد = جديد + [ع]
        نهاية
    نهاية
    ترتيب_z = جديد + [معرّف]
نهاية

دالة أغلق_نافذة(رقم معرّف)
    مغلقة[معرّف] = صحيح
نهاية

دالة حرّك_نافذة(رقم معرّف، عشري دلتا_س، عشري دلتا_ص)
    إزاحة_س[معرّف] = إزاحة_س[معرّف] + دلتا_س
    إزاحة_ص[معرّف] = إزاحة_ص[معرّف] + دلتا_ص
نهاية

# ─── مساعد عرض الترتيب ───
دالة نص_الترتيب()
    ارجع نص(ترتيب_z[0]) + "," + نص(ترتيب_z[1]) + "," + نص(ترتيب_z[2])
نهاية

# المقدّمة المرئيّة + هي_المقدّمة — مطابقان لملفّ التطبيق (تتخطّيان المغلقة).
دالة المقدّمة_المرئيّة()
    متغير ن = عدد_النوافذ - 1
    بينما (ن >= 0)
        متغير م = ترتيب_z[ن]
        إذا (مغلقة[م] == خطأ)
            ارجع م
        نهاية
        ن = ن - 1
    نهاية
    ارجع -1
نهاية

دالة هي_المقدّمة(رقم معرّف)
    ارجع المقدّمة_المرئيّة() == معرّف
نهاية

# ─── تأكيد بسيط: يُهلِع بعلامة واضحة عند فشل الشرط ───
دالة تأكيد(شرط، رسالة)
    إذا (شرط == خطأ)
        اطبع_سطر("WM_ASSERT_FAIL: " + رسالة)
    نهاية
نهاية

# ══════════════════════════════════════════════════════════════════════
# البرهان
# ══════════════════════════════════════════════════════════════════════
اطبع_سطر("WM_BEGIN")

# (١) الترتيب الابتدائيّ: 0 خلفًا، 2 أمامًا.
اطبع_سطر("z0=" + نص_الترتيب())
تأكيد(نص_الترتيب() == "0,1,2"، "الترتيب الابتدائيّ")

# (٢) رفع المستكشف (0) للأمام ⇒ يصير آخر الترتيب (المقدّمة).
ارفع_للأمام(نافذة_المستكشف)
اطبع_سطر("z1=" + نص_الترتيب())
تأكيد(نص_الترتيب() == "1,2,0"، "رفع 0 للأمام")

# (٣) رفع الطرفيّة (1) للأمام ⇒ يصير آخر الترتيب، والباقي يتراجع.
ارفع_للأمام(نافذة_الطرفيّة)
اطبع_سطر("z2=" + نص_الترتيب())
تأكيد(نص_الترتيب() == "2,0,1"، "رفع 1 للأمام")

# التركيز يتبع المقدّمة: الطرفيّة هي المركَّزة الآن، لا المستكشف.
اطبع_سطر("مركّزة=" + نص(هي_المقدّمة(نافذة_الطرفيّة)))
تأكيد(هي_المقدّمة(نافذة_الطرفيّة) == صحيح، "الطرفيّة مركَّزة بعد الرفع")
تأكيد(هي_المقدّمة(نافذة_المستكشف) == خطأ، "المستكشف غير مركَّز")

# (٤) سحب الإعدادات (2) بمقدار (30،15) ثمّ (5،5) ⇒ يتراكم على 80 الابتدائيّة.
حرّك_نافذة(نافذة_الإعدادات، 30.0، 15.0)
حرّك_نافذة(نافذة_الإعدادات، 5.0، 5.0)
اطبع_سطر("موضع2=" + نص(إزاحة_س[نافذة_الإعدادات]) + "," + نص(إزاحة_ص[نافذة_الإعدادات]))
تأكيد(إزاحة_س[نافذة_الإعدادات] == 115.0، "تراكم إزاحة_س")
تأكيد(إزاحة_ص[نافذة_الإعدادات] == 100.0، "تراكم إزاحة_ص")

# (٥) إغلاق الطرفيّة (1) وهي المقدّمة ⇒ تُخفى، والتركيز ينتقل للمرئيّة التالية (0).
أغلق_نافذة(نافذة_الطرفيّة)
اطبع_سطر("مغلقة1=" + نص(مغلقة[نافذة_الطرفيّة]))
تأكيد(مغلقة[نافذة_الطرفيّة] == صحيح، "إغلاق 1")
تأكيد(مغلقة[نافذة_المستكشف] == خطأ، "المستكشف يبقى مفتوحًا")
اطبع_سطر("مقدّمة_بعد_الإغلاق=" + نص(المقدّمة_المرئيّة()))
تأكيد(المقدّمة_المرئيّة() == نافذة_المستكشف، "التركيز ينتقل للمرئيّة بعد إغلاق المقدّمة")
تأكيد(هي_المقدّمة(نافذة_الطرفيّة) == خطأ، "المغلقة لا تنال التركيز")

اطبع_سطر("WM_LOGIC_OK")
