# ══════════════════════════════════════════════════════════════════════
# مثال: سطح مكتب ص — بلغة ص التصريحيّة (نظير sad_desktop.cpp لكن بـص)
# ══════════════════════════════════════════════════════════════════════
#
# يبني الشجرة نفسها التي يبنيها features/graphics/backends/freestanding/
# tools/sad_desktop.cpp يدويًّا بـC++ (شريط علويّ + عنوان عربيّ مشكَّل +
# نصّ إرشاديّ + ٣ أزرار: تطبيق/طرفيّة/إطفاء) — لكن عبر مكتبة رسومات
# التصريحيّة (SadUI) بدل بناء IRNode بـC++.
#
# الغرض: إثبات مسار كود ص المولَّد ⇒ تشغيل_تطبيق (جسر وقت التشغيل).
# ══════════════════════════════════════════════════════════════════════

استورد رسومات

# ─── الألوان (ثوابت مسمّاة — نظير COLOR_* في sad_desktop.cpp) ───
متغير لون_الخلفية = "#123A6E"
متغير لون_النص_الفاتح = "#FFFFFF"
متغير لون_النص_الخافت = "#B8C6DB"
متغير لون_زر_التطبيق = "#1E824C"
متغير لون_زر_الطرفية = "#C0392B"
متغير لون_زر_الإطفاء = "#7A1F1F"

# ─── قياسات التخطيط (ثوابت مسمّاة — نظير قياسات sad_desktop.cpp) ───
متغير حجم_العنوان = 48
متغير حجم_التلميح = 24
متغير حجم_الزر = 32
متغير تباعد_الجذر = 48
متغير حشو_الجسد = 64

# ─── نصوص العرض (بيانات — نظير DESKTOP_TITLE_AR وأخواتها) ───
متغير عنوان_السطح = "سطح مكتب ص"
متغير نص_التلميح = "اضغط زرّ ‹الطرفيّة› أو F2 للصدَفة النصّيّة"
متغير نص_زر_التطبيق = "العرض التجريبيّ"
متغير نص_زر_الطرفية = "الطرفيّة"
متغير نص_زر_الإطفاء = "إطفاء"

# ─── ردود النداء (نظير EXPR_* + fireEvent في sad_desktop.cpp) ───
دالة شغّل_العرض()
    اطبع_سطر("طلب إطلاق العرض التجريبيّ")
نهاية

دالة اخرج_للصدفة()
    اطبع_سطر("طلب الخروج للصدَفة النصّيّة")
نهاية

دالة اطفئ_النظام()
    اطبع_سطر("طلب إطفاء النظام")
نهاية

# ─── الشجرة التصريحيّة: شريط علويّ + عنوان + تلميح + ٣ أزرار ───
متغير السطح = عمود(
    شريط_تطبيق(عنوان_السطح)،

    نص_عنصر(عنوان_السطح)
        .حجم_خط(حجم_العنوان)
        .لون(لون_النص_الفاتح)،

    نص_عنصر(نص_التلميح)
        .حجم_خط(حجم_التلميح)
        .لون(لون_النص_الخافت)،

    زر(نص_زر_التطبيق)
        .لون_خلفية(لون_زر_التطبيق)
        .حجم_خط(حجم_الزر)
        .عند_النقر(شغّل_العرض)،

    زر(نص_زر_الطرفية)
        .لون_خلفية(لون_زر_الطرفية)
        .حجم_خط(حجم_الزر)
        .عند_النقر(اخرج_للصدفة)،

    زر(نص_زر_الإطفاء)
        .لون_خلفية(لون_زر_الإطفاء)
        .حجم_خط(حجم_الزر)
        .عند_النقر(اطفئ_النظام)
)
    .لون_خلفية(لون_الخلفية)
    .تباعد(تباعد_الجذر)
    .حشوة(حشو_الجسد)

# ─── تشغيل التطبيق: يفتح النافذة ويدير الحلقة ويُرسِل الأحداث ───
تشغيل_تطبيق(السطح)
