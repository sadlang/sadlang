# مثال: برهان تفرّع الحدث (الفقاعات) بمنطق ص خالص — rfcs#51
# ══════════════════════════════════════════════════════════════════════
#
# يُثبت حيًّا أنّ نقرةً واحدة على زرٍّ ابن تُطلق معالِجَين:
#   • معالِج الابن (طور الهدف) ⇒ يُخضِّر «مؤشّر الابن».
#   • معالِج الأمّ (طور الفقاعات، لأنّها أعلنت `.تفرع("فقاعة")`) ⇒ يُخضِّر
#     «مؤشّر الأمّ» — رغم أنّ النقرة لم تقع عليها بل على ابنها.
#
# القياس الكمّيّ: المؤشّران يبدآن أحمرين. بعد النقر على الزرّ الابن يجب أن
# يصيرا **كلاهما** أخضرين. مؤشّرٌ واحدٌ أخضر فقط ⇒ الفقاعات لا تعمل.
#
# الطور مُعلَن على المعالِج لا على الحدث (نموذج DOM): بلا `.تفرع` لا انتشار،
# فهذا البرهان يُظهر الاشتراك الصريح في الفقاعات.
# ══════════════════════════════════════════════════════════════════════

استورد رسومات

# ─── ألوان (ثوابت مسمّاة) ───
متغير لون_السطح = "#0B1A2E"
متغير لون_أحمر = "#CC2222"
متغير لون_أخضر = "#22CC22"
متغير لون_الأمّ = "#243B6B"
متغير لون_الابن = "#6B3FA0"
متغير لون_النصّ = "#FFFFFF"

# ─── نصوص العرض (بيانات) ───
متغير عنوان_البرهان = "انقر الزرّ البنفسجيّ: يجب أن يخضرّ المؤشّران معًا"
متغير نص_الابن = "انقرني"
متغير وسم_الأمّ = "الأمّ"
متغير وسم_الابن = "الابن"

# ─── قياسات التخطيط (ثوابت مسمّاة) ───
متغير حجم_المؤشّر = 200
متغير عرض_الزرّ = 320
متغير ارتفاع_الزرّ = 160
متغير حجم_العنوان = 26
متغير حجم_النصّ = 34
متغير حشو_السطح = 40
متغير تباعد_السطح = 36
متغير تباعد_المؤشّرات = 80

# ─── المؤشّران البصريّان (يبدآن أحمرين؛ المعالِجان يُخضّرانهما) ───
متغير مؤشّر_الأمّ = زر(وسم_الأمّ)
    .عرض(حجم_المؤشّر)
    .ارتفاع(حجم_المؤشّر)
    .لون_خلفية(لون_أحمر)
    .حجم_خط(حجم_النصّ)

متغير مؤشّر_الابن = زر(وسم_الابن)
    .عرض(حجم_المؤشّر)
    .ارتفاع(حجم_المؤشّر)
    .لون_خلفية(لون_أحمر)
    .حجم_خط(حجم_النصّ)

# ─── معالِج الأمّ: يُطلَق في طور الفقاعات عند النقر على أيّ حفيد ───
دالة عند_نقر_الأمّ(حدث ح)
    مؤشّر_الأمّ.لون_خلفية(لون_أخضر)
    تحديث_حالة()
نهاية

# ─── معالِج الابن: يُطلَق في طور الهدف (النقرة عليه مباشرةً) ───
دالة عند_نقر_الابن(حدث ح)
    مؤشّر_الابن.لون_خلفية(لون_أخضر)
    تحديث_حالة()
نهاية

# ─── الزرّ الابن: هدف النقرة ───
متغير الابن = زر(نص_الابن)
    .عرض(عرض_الزرّ)
    .ارتفاع(ارتفاع_الزرّ)
    .لون_خلفية(لون_الابن)
    .حجم_خط(حجم_النصّ)
    .عند_النقر(عند_نقر_الابن)

# ─── الحاوية الأمّ: تحوي الابن وتشترك في فقاعات أحداثه صراحةً ───
متغير الأمّ = عمود(الابن)
    .لون_خلفية(لون_الأمّ)
    .حشوة(حشو_السطح)
    .عند_النقر(عند_نقر_الأمّ)
    .تفرع("فقاعة")

# ─── صفّ المؤشّرين (أمّ يمينًا/يسارًا حسب RTL؛ القياس بالموضع) ───
متغير صفّ_المؤشّرين = صف(مؤشّر_الأمّ، مؤشّر_الابن)
    .تباعد(تباعد_المؤشّرات)

# ─── السطح: عنوان + صفّ المؤشّرين + الحاوية الأمّ ───
متغير السطح = عمود(
    نص_عنصر(عنوان_البرهان)
        .حجم_خط(حجم_العنوان)
        .لون(لون_النصّ)،
    صفّ_المؤشّرين،
    الأمّ
)
    .لون_خلفية(لون_السطح)
    .تباعد(تباعد_السطح)
    .حشوة(حشو_السطح)

# ─── تشغيل التطبيق: يفتح النافذة ويدير الحلقة ويُرسِل الأحداث ───
تشغيل_تطبيق(السطح)
