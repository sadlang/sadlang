# ══════════════════════════════════════════════════════════════════════
# مدير النوافذ (WindowManager) — منطق ص خالص فوق نظام الحالة والأحداث القائم
# ══════════════════════════════════════════════════════════════════════
#
# يُثبت أنّ قشرة نوافذ شبيهة بويندوز تُبنى بمنطق ص وحده — لا تعديل على المحرّك
# (توسيع لا إعادة كتابة). يوفّر السلوكيّات الأربع الأساسيّة لِمدير النوافذ:
#
#   • ترتيب z: قائمة نوافذ مرتّبة، آخرها في الأمام؛ تُرسَم داخل «رصة» بترتيبها.
#   • رفع للأمام + تركيز: النقر على نافذة ينقلها إلى مقدّمة ترتيب z.
#   • سحب: السحب من شريط العنوان يجمع دلتا المؤشّر على الموضع الحرّ (إزاحة_س/ص).
#   • إغلاق: زرّ الإغلاق يخفي النافذة (يزيلها من العرض).
#
# لا fork/exec — كلّ «تطبيق» هو نافذة في القائمة. النوافذ ثلاث ثابتة العدد لأنّ
# حاويات العرض (رصة) تأخذ أبناءها موضعيًّا (لا نشرَ لمصفوفة إلى أبناء في لغة ص).
# ══════════════════════════════════════════════════════════════════════

استورد رسومات

# ─── معرّفات النوافذ الثلاث (ثوابت مسمّاة، لا أرقام سحريّة) ───
متغير نافذة_المستكشف = 0
متغير نافذة_الطرفيّة = 1
متغير نافذة_الإعدادات = 2
متغير عدد_النوافذ = 3

# ─── بيانات كلّ نافذة (مفهرَسة بالمعرّف) ───
متغير عناوين = ["المستكشف"، "الطرفيّة"، "الإعدادات"]
# محتوى الطرفيّة محاطٌ بمحرفَي تحكّم اتّجاهيّين (U+202A…U+202C) لعرض «$» يسارًا
# داخل سياق RTL — مقصود، لا يُحذف.
متغير محتويات = ["ملفّاتي ومجلّداتي"، "‪$ ‬صدفة النظام جاهزة"، "تفضيلات سطح المكتب"]
متغير ألوان_النوافذ = ["#1E824C"، "#2C3E50"، "#8E44AD"]

# ─── قياسات التخطيط (ثوابت مسمّاة) ───
متغير عرض_النافذة = 320
متغير ارتفاع_النافذة = 200
متغير حجم_عنوان_النافذة = 26
متغير حجم_محتوى_النافذة = 22
متغير ارتفاع_الشريط = 40
متغير حشو_الشريط = 12
متغير حجم_زر_الإغلاق = 28
متغير عرض_السطح = 1024
متغير ارتفاع_السطح = 768
متغير حجم_مخفي = 0

# ─── ألوان القشرة (ثوابت مسمّاة) ───
متغير لون_السطح = "#0B1A2E"
متغير لون_عنوان_الشريط = "#FFFFFF"
متغير لون_شريط_العنوان = "#16324F"
متغير لون_شريط_مركّز = "#2E6DA4"
متغير لون_المحتوى = "#ECF0F1"
متغير لون_زر_الإغلاق = "#C0392B"
متغير لون_نص_زر_الإغلاق = "#FFFFFF"
متغير نص_زر_الإغلاق = "X"

# ─── حالة المدير القابلة للتغيّر (تبقى عبر إعادة بناء الشجرة) ───
# ترتيب_z: أوّل عنصر في الخلف، آخر عنصر في المقدّمة (الأعلى تركيزًا).
متغير ترتيب_z = [0، 1، 2]
# موضع كلّ نافذة الحرّ (تُجمَع عليه دلتا السحب التفاضليّة).
متغير إزاحة_س = [0.0، 40.0، 80.0]
متغير إزاحة_ص = [0.0، 40.0، 80.0]
# هل النافذة مغلقة (مخفيّة من العرض)؟
متغير مغلقة = [خطأ، خطأ، خطأ]

# ══════════════════════════════════════════════════════════════════════
# دوالّ المدير الأساسيّة (منطق خالص — قابلة للبرهنة بلا عرض)
# ══════════════════════════════════════════════════════════════════════

# رفع نافذة إلى مقدّمة ترتيب z (تصير الأعلى والمركَّزة).
دالة ارفع_للأمام(رقم معرّف)
    متغير جديد = []
    لكل ع في ترتيب_z
        إذا (ع != معرّف)
            جديد = جديد + [ع]
        نهاية
    نهاية
    ترتيب_z = جديد + [معرّف]
نهاية

# إغلاق نافذة (إخفاؤها من العرض).
دالة أغلق_نافذة(رقم معرّف)
    مغلقة[معرّف] = صحيح
نهاية

# تحريك نافذة بمقدار دلتا المؤشّر التفاضليّة.
دالة حرّك_نافذة(رقم معرّف، عشري دلتا_س، عشري دلتا_ص)
    إزاحة_س[معرّف] = إزاحة_س[معرّف] + دلتا_س
    إزاحة_ص[معرّف] = إزاحة_ص[معرّف] + دلتا_ص
نهاية

# معرّف النافذة المرئيّة في المقدّمة = آخر عنصر غير مغلق في ترتيب z (-1 إن لا شيء).
دالة المقدّمة_المرئيّة()
    متغير ن = عدد_النوافذ - 1
    بينما (ن >= 0)
        متغير م = ترتيب_z[ن]
        إذا (مغلقة[م] == خطأ)
            ارجع م
        نهاية
        ن = ن - 1
    نهاية
    ارجع -1
نهاية

# هل النافذة هي المرئيّة في المقدّمة ⇒ هي المركَّزة؟ (تتخطّى المغلقة)
دالة هي_المقدّمة(رقم معرّف)
    ارجع المقدّمة_المرئيّة() == معرّف
نهاية

# ══════════════════════════════════════════════════════════════════════
# ردود نداء الأحداث لكلّ نافذة (تُوصِل الأحداث الحيّة بدوالّ المدير)
# ══════════════════════════════════════════════════════════════════════

دالة اسحب_المستكشف(حدث ح)
    حرّك_نافذة(نافذة_المستكشف، ح.دلتا_س، ح.دلتا_ص)
    تحديث_حالة()
نهاية
دالة اسحب_الطرفيّة(حدث ح)
    حرّك_نافذة(نافذة_الطرفيّة، ح.دلتا_س، ح.دلتا_ص)
    تحديث_حالة()
نهاية
دالة اسحب_الإعدادات(حدث ح)
    حرّك_نافذة(نافذة_الإعدادات، ح.دلتا_س، ح.دلتا_ص)
    تحديث_حالة()
نهاية

دالة ارفع_المستكشف()
    ارفع_للأمام(نافذة_المستكشف)
    تحديث_حالة()
نهاية
دالة ارفع_الطرفيّة()
    ارفع_للأمام(نافذة_الطرفيّة)
    تحديث_حالة()
نهاية
دالة ارفع_الإعدادات()
    ارفع_للأمام(نافذة_الإعدادات)
    تحديث_حالة()
نهاية

دالة اغلق_المستكشف()
    أغلق_نافذة(نافذة_المستكشف)
    تحديث_حالة()
نهاية
دالة اغلق_الطرفيّة()
    أغلق_نافذة(نافذة_الطرفيّة)
    تحديث_حالة()
نهاية
دالة اغلق_الإعدادات()
    أغلق_نافذة(نافذة_الإعدادات)
    تحديث_حالة()
نهاية

# ══════════════════════════════════════════════════════════════════════
# بناء العرض
# ══════════════════════════════════════════════════════════════════════

# يبني شريط عنوان قابلًا للسحب مع زرّ إغلاق فعّال، موصولًا بردود نداء المعرّف.
دالة ابنِ_شريط_العنوان(رقم معرّف)
    # زرّ الإغلاق الفعّال — عنصر قابل للنقر (لا دائرة تزيينيّة).
    متغير زر_الإغلاق = زر(نص_زر_الإغلاق)
        .عرض(حجم_زر_الإغلاق)
        .ارتفاع(حجم_زر_الإغلاق)
        .لون_خلفية(لون_زر_الإغلاق)
        .لون(لون_نص_زر_الإغلاق)

    إذا (معرّف == نافذة_المستكشف)
        زر_الإغلاق.عند_النقر(اغلق_المستكشف)
    نهاية
    إذا (معرّف == نافذة_الطرفيّة)
        زر_الإغلاق.عند_النقر(اغلق_الطرفيّة)
    نهاية
    إذا (معرّف == نافذة_الإعدادات)
        زر_الإغلاق.عند_النقر(اغلق_الإعدادات)
    نهاية

    # لون الشريط يعكس التركيز: النافذة المقدّمة تُميَّز بلون أزرق أفتح.
    متغير لون_الشريط = لون_شريط_العنوان
    إذا (هي_المقدّمة(معرّف))
        لون_الشريط = لون_شريط_مركّز
    نهاية

    # الشريط: عنوان + مساحة مرنة + زرّ الإغلاق، بخلفيّة داكنة، قابل للسحب.
    متغير الشريط = صف(
        نص_عنصر(عناوين[معرّف])
            .لون(لون_عنوان_الشريط)
            .حجم_خط(حجم_عنوان_النافذة)،
        زر_الإغلاق
    )
        .لون_خلفية(لون_الشريط)
        .حشوة(حشو_الشريط)
        .عرض(عرض_النافذة)
        .ارتفاع(ارتفاع_الشريط)

    إذا (معرّف == نافذة_المستكشف)
        الشريط.عند_السحب(اسحب_المستكشف)
    نهاية
    إذا (معرّف == نافذة_الطرفيّة)
        الشريط.عند_السحب(اسحب_الطرفيّة)
    نهاية
    إذا (معرّف == نافذة_الإعدادات)
        الشريط.عند_السحب(اسحب_الإعدادات)
    نهاية

    ارجع الشريط
نهاية

# يبني نافذةً كاملة (شريط عنوان + جسم) في موضعها الحرّ، موصولة برفع z عند النقر.
# النافذة المغلقة تُستبدَل بحاوية صفريّة الحجم (تختفي من العرض).
دالة ابنِ_نافذة(رقم معرّف)
    إذا (مغلقة[معرّف] == صحيح)
        ارجع حاوية()
            .عرض(حجم_مخفي)
            .ارتفاع(حجم_مخفي)
    نهاية

    متغير الجسم = نص_عنصر(محتويات[معرّف])
        .لون(لون_المحتوى)
        .حجم_خط(حجم_محتوى_النافذة)
        .حشوة(حشو_الشريط)

    متغير النافذة = نافذة(
        ابنِ_شريط_العنوان(معرّف)،
        الجسم
    )
        .عرض(عرض_النافذة)
        .ارتفاع(ارتفاع_النافذة)
        .لون_خلفية(ألوان_النوافذ[معرّف])
        .إزاحة_س(إزاحة_س[معرّف])
        .إزاحة_ص(إزاحة_ص[معرّف])

    إذا (معرّف == نافذة_المستكشف)
        النافذة.عند_النقر(ارفع_المستكشف)
    نهاية
    إذا (معرّف == نافذة_الطرفيّة)
        النافذة.عند_النقر(ارفع_الطرفيّة)
    نهاية
    إذا (معرّف == نافذة_الإعدادات)
        النافذة.عند_النقر(ارفع_الإعدادات)
    نهاية

    ارجع النافذة
نهاية

# يبني السطح: خلفيّة + النوافذ الثلاث مكدَّسة بترتيب z (آخرها في المقدّمة).
دالة ابنِ_السطح()
    ارجع رصة(
        ابنِ_نافذة(ترتيب_z[0])،
        ابنِ_نافذة(ترتيب_z[1])،
        ابنِ_نافذة(ترتيب_z[2])
    )
        .لون_خلفية(لون_السطح)
        .عرض(عرض_السطح)
        .ارتفاع(ارتفاع_السطح)
نهاية

# ─── تشغيل: يفتح السطح ويدير الحلقة ويُرسِل الأحداث (سحب/رفع/إغلاق حيًّا) ───
# برهان منطق المدير المعزول (رفع z/سحب/إغلاق) في: برهان_مدير_النوافذ.ص
اطبع_سطر("WM_DESKTOP_TREE_BUILT")
تشغيل_تطبيق(ابنِ_السطح)
