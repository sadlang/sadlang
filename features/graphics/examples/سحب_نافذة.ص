# ══════════════════════════════════════════════════════════════════════
# مثال: سحب نافذة بمنطق ص خالص — برهان ② EventData / FR-009
# ══════════════════════════════════════════════════════════════════════
#
# يُثبت أنّ منطق ص وحده (لا المحرّك) يحرّك نافذةً بمقدار حركة المؤشّر:
#   • رد النداء `عند_السحب` يتلقّى بنية «حدث» فيها دلتا_س/دلتا_ص (② rfcs#46).
#   • يجمع الدلتا التفاضليّة على موضع النافذة الحرّ (إزاحة_س/إزاحة_ص).
#   • `تحديث_حالة()` يعيد التخطيط والرسم فتتبع النافذةُ المؤشّرَ لحظةً بلحظة.
#
# النافذة زرٌّ مُنمَّق كصندوق: عنصرٌ ورقيّ يُصيب اختبارُ النقر أيَّ نقطة فيه،
# فيبدأ السحب من أيّ موضع على النافذة (دلالة الإمساك من شريط العنوان).
# ══════════════════════════════════════════════════════════════════════

استورد رسومات

# ─── ألوان (ثوابت مسمّاة) ───
متغير لون_السطح = "#0B1A2E"
متغير لون_النافذة = "#1E824C"
متغير لون_العنوان = "#FFFFFF"

# ─── نصوص العرض (بيانات) ───
متغير عنوان_البرهان = "اسحب النافذة الخضراء بالمؤشّر"
متغير نص_النافذة = "اسحبني"

# ─── قياسات التخطيط (ثوابت مسمّاة) ───
متغير عرض_النافذة = 360
متغير ارتفاع_النافذة = 240
متغير حجم_العنوان = 28
متغير حجم_النافذة = 40
متغير حشو_السطح = 40
متغير تباعد_السطح = 32

# ─── حالة الموضع الحرّ (تُجمَع عليها دلتا السحب التفاضليّة) ───
متغير إزاحة_النافذة_س = 0.0
متغير إزاحة_النافذة_ص = 0.0

# ─── النافذة القابلة للسحب (زرّ مُنمَّق كصندوق نافذة) ───
متغير النافذة = زر(نص_النافذة)
    .عرض(عرض_النافذة)
    .ارتفاع(ارتفاع_النافذة)
    .لون_خلفية(لون_النافذة)
    .حجم_خط(حجم_النافذة)

# ─── رد نداء السحب: يجمع الدلتا على الموضع ثمّ يطلب إعادة الرسم ───
دالة عند_سحب_النافذة(حدث ح)
    إزاحة_النافذة_س = إزاحة_النافذة_س + ح.دلتا_س
    إزاحة_النافذة_ص = إزاحة_النافذة_ص + ح.دلتا_ص
    النافذة.إزاحة_س(إزاحة_النافذة_س)
    النافذة.إزاحة_ص(إزاحة_النافذة_ص)
    تحديث_حالة()
نهاية

النافذة.عند_السحب(عند_سحب_النافذة)

# ─── السطح: عنوان إرشاديّ + النافذة القابلة للسحب ───
متغير السطح = عمود(
    نص_عنصر(عنوان_البرهان)
        .حجم_خط(حجم_العنوان)
        .لون(لون_العنوان)،
    النافذة
)
    .لون_خلفية(لون_السطح)
    .تباعد(تباعد_السطح)
    .حشوة(حشو_السطح)

# ─── تشغيل التطبيق: يفتح النافذة ويدير الحلقة ويُرسِل الأحداث ───
تشغيل_تطبيق(السطح)
