# =====================================================
# ملف تدريب 38: الدالة الرئيسية ونمط البرمجة المنظمة
# =====================================================
# دالة رئيسية() هي نقطة الدخول الاختيارية
# تُستدعى تلقائياً إن وُجدت
# نمط MVC: فصل البيانات عن المنطق عن العرض
# =====================================================

# === النموذج (Model): البيانات ===
صنف منتج
    باني(اسم، سعر، كمية)
        هذا.الاسم = اسم
        هذا.السعر = سعر
        هذا.الكمية = كمية
    نهاية
    
    دالة القيمة()
        ارجع هذا.السعر * هذا.الكمية
    نهاية
نهاية

صنف متجر
    باني(اسم)
        هذا.الاسم = اسم
        هذا.المنتجات = []
    نهاية
    
    دالة اضف(منتج)
        هذا.المنتجات.اضف(منتج)
    نهاية
    
    دالة عدد_المنتجات()
        ارجع طول(هذا.المنتجات)
    نهاية
    
    دالة إجمالي_القيمة()
        متغير مجموع = 0
        لكل م في هذا.المنتجات
            مجموع = مجموع + م.القيمة()
        نهاية
        ارجع مجموع
    نهاية
    
    دالة بحث(اسم_منتج)
        لكل م في هذا.المنتجات
            إذا (م.الاسم == اسم_منتج)
                ارجع م
            نهاية
        نهاية
        ارجع لاشيء
    نهاية
    
    دالة الأغلى()
        متغير أعلى_سعر = 0
        متغير أغلى = لاشيء
        لكل م في هذا.المنتجات
            إذا (م.السعر > أعلى_سعر)
                أعلى_سعر = م.السعر
                أغلى = م
            نهاية
        نهاية
        ارجع أغلى
    نهاية
نهاية

# === المتحكم (Controller): المنطق ===
دالة تهيئة_المتجر()
    متغير م = جديد متجر("سوق العربية")
    
    م.اضف(جديد منتج("لابتوب"، 3500، 10))
    م.اضف(جديد منتج("هاتف"، 2000، 25))
    م.اضف(جديد منتج("سماعات"، 150، 50))
    م.اضف(جديد منتج("شاشة"، 1200، 8))
    م.اضف(جديد منتج("لوحة مفاتيح"، 200، 30))
    
    ارجع م
نهاية

# === العرض (View): الواجهة ===
دالة عرض_خط(طول_الخط)
    متغير خط = ""
    متغير ع = 0
    بينما (ع < طول_الخط)
        خط = خط + "─"
        ع = ع + 1
    نهاية
    اطبع_سطر(خط)
نهاية

دالة عرض_المتجر(متجر)
    عرض_خط(40)
    اطبع_سطر("  🏪 " + متجر.الاسم)
    عرض_خط(40)
    اطبع_سطر("  عدد المنتجات: " + متجر.عدد_المنتجات())
    اطبع_سطر("")
    
    لكل م في متجر.المنتجات
        اطبع_سطر("  📦 " + م.الاسم)
        اطبع_سطر("     السعر: " + م.السعر + " ريال")
        اطبع_سطر("     الكمية: " + م.الكمية)
        اطبع_سطر("     القيمة: " + م.القيمة() + " ريال")
        اطبع_سطر("")
    نهاية
    
    عرض_خط(40)
    اطبع_سطر("  💰 إجمالي القيمة: " + متجر.إجمالي_القيمة() + " ريال")
    عرض_خط(40)
نهاية

دالة عرض_البحث(متجر، اسم)
    اطبع_سطر("")
    اطبع_سطر("=== بحث عن: " + اسم + " ===")
    متغير نتيجة = متجر.بحث(اسم)
    إذا (نتيجة != لاشيء)
        اطبع_سطر("  ✅ وُجد: " + نتيجة.الاسم + " — " + نتيجة.السعر + " ريال")
    وإلا
        اطبع_سطر("  ❌ لم يُوجد!")
    نهاية
نهاية

# === الدالة الرئيسية ===
دالة رئيسية()
    # تهيئة
    متغير المتجر = تهيئة_المتجر()
    
    # عرض المتجر
    عرض_المتجر(المتجر)
    
    # بحث
    عرض_البحث(المتجر، "هاتف")
    عرض_البحث(المتجر، "تابلت")
    
    # أغلى منتج
    متغير أغلى = المتجر.الأغلى()
    اطبع_سطر("")
    اطبع_سطر("=== أغلى منتج ===")
    اطبع_سطر("  👑 " + أغلى.الاسم + " — " + أغلى.السعر + " ريال")
    
    اطبع_سطر("")
    اطبع_سطر("✅ تم اختبار الدالة الرئيسية ونمط MVC بنجاح!")
نهاية
