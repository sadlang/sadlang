# =====================================================
# ملف تدريب 37: الوراثة المتقدمة والأساس
# =====================================================
# يرث: وراثة صنف من صنف آخر
# الأساس(): استدعاء باني الصنف الأب
# تعدد الأشكال (Polymorphism)
# =====================================================

# === الصنف الأساسي: مركبة ===
صنف مركبة
    باني(نوع، لون، سنة)
        هذا.النوع = نوع
        هذا.اللون = لون
        هذا.السنة = سنة
        هذا.السرعة = 0
    نهاية
    
    دالة تسريع(مقدار)
        هذا.السرعة = هذا.السرعة + مقدار
        اطبع_سطر("  ⚡ " + هذا.النوع + " تسارع إلى " + هذا.السرعة + " كم/س")
    نهاية
    
    دالة فرملة()
        هذا.السرعة = 0
        اطبع_سطر("  🛑 " + هذا.النوع + " توقف")
    نهاية
    
    دالة معلومات()
        ارجع هذا.النوع + " (" + هذا.اللون + "، " + هذا.السنة + ")"
    نهاية
نهاية

# === سيارة ترث من مركبة ===
صنف سيارة يرث مركبة
    باني(ماركة، لون، سنة، عدد_الأبواب)
        الأساس(ماركة، لون، سنة)
        هذا.عدد_الأبواب = عدد_الأبواب
    نهاية
    
    دالة معلومات()
        ارجع هذا.النوع + " (" + هذا.اللون + "، " + هذا.السنة + "، " + هذا.عدد_الأبواب + " أبواب)"
    نهاية
    
    دالة نفخ_بوق()
        اطبع_سطر("  📯 بيب بيب!")
    نهاية
نهاية

# === شاحنة ترث من مركبة ===
صنف شاحنة يرث مركبة
    باني(ماركة، لون، سنة، حمولة)
        الأساس(ماركة، لون، سنة)
        هذا.الحمولة = حمولة
    نهاية
    
    دالة معلومات()
        ارجع هذا.النوع + " (" + هذا.اللون + "، حمولة: " + هذا.الحمولة + " طن)"
    نهاية
    
    دالة شحن(بضاعة)
        اطبع_سطر("  📦 تحميل: " + بضاعة)
    نهاية
نهاية

# === دراجة ترث من مركبة ===
صنف دراجة يرث مركبة
    باني(نوع، لون، سنة، عدد_غيارات)
        الأساس(نوع، لون، سنة)
        هذا.الغيارات = عدد_غيارات
        هذا.الغيار_الحالي = 1
    نهاية
    
    دالة غير_غيار(غيار)
        إذا (غيار >= 1 و غيار <= هذا.الغيارات)
            هذا.الغيار_الحالي = غيار
            اطبع_سطر("  ⚙️ الغيار: " + غيار)
        وإلا
            اطبع_سطر("  ⚠️ غيار غير صحيح!")
        نهاية
    نهاية
نهاية

# === اختبار ===
اطبع_سطر("=== إنشاء المركبات ===")
متغير س = جديد سيارة("تويوتا"، "أحمر"، 2024، 4)
متغير ش = جديد شاحنة("مرسيدس"، "أبيض"، 2023، 10)
متغير د = جديد دراجة("BMX"، "أسود"، 2024، 6)

اطبع_سطر("  🚗 " + س.معلومات())
اطبع_سطر("  🚛 " + ش.معلومات())
اطبع_سطر("  🚲 " + د.معلومات())

# === تعدد الأشكال ===
اطبع_سطر("")
اطبع_سطر("=== تعدد الأشكال ===")
متغير مركبات = [س، ش، د]

لكل م في مركبات
    اطبع_سطر("  " + م.معلومات())
    م.تسريع(50)
نهاية

# === استخدام الدوال الخاصة ===
اطبع_سطر("")
اطبع_سطر("=== دوال خاصة ===")
س.نفخ_بوق()
ش.شحن("أثاث منزلي")
