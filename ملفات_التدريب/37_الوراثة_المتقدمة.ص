د.غير_غيار(7)

# === وراثة إضافية لنفس السلسلة ===
صنف سيارة_كهربائية يرث سيارة
    باني(ماركة، لون، سنة)
        الأساس(ماركة، لون، سنة، 4)
        هذا.البطارية = 100
    نهاية
    
    دالة شحن_بطارية()
        هذا.البطارية = 100
        اطبع_سطر("  🔋 البطارية مشحونة: " + هذا.البطارية + "%")
    نهاية
    
    دالة قيادة(مسافة)
        هذا.البطارية = هذا.البطارية - مسافة
        إذا (هذا.البطارية < 0)
            هذا.البطارية = 0
        نهاية
        اطبع_سطر("  🚗⚡ قيادة " + مسافة + " كم — البطارية: " + هذا.البطارية + "%")
    نهاية
نهاية

اطبع_سطر("")
اطبع_سطر("=== سيارة كهربائية ===")
متغير تسلا = جديد سيارة_كهربائية("تسلا"، "أبيض"، 2024)
اطبع_سطر("  " + تسلا.معلومات())
تسلا.قيادة(30)
تسلا.قيادة(50)
تسلا.شحن_بطارية()
تسلا.نفخ_بوق()

