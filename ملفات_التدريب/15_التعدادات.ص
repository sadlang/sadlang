# --- القسم 3: استخدام تعداد مع طابق ---
اطبع_سطر("=== تعداد وطابق ===")

تعداد الحالة
    نشط
    متوقف
    معلق
نهاية

دالة وصف_الحالة(ح)
    طابق (ح)
        عندما الحالة.نشط:
            ارجع "المستخدم نشط"
        عندما الحالة.متوقف:
            ارجع "المستخدم متوقف"
        عندما الحالة.معلق:
            ارجع "المستخدم معلق"
        افتراضي:
            ارجع "حالة غير معروفة"
    نهاية
نهاية

اطبع_سطر(وصف_الحالة(الحالة.نشط))
اطبع_سطر(وصف_الحالة(الحالة.معلق))

