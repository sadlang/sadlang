# القسم 1: خاصية قراءة فقط (getter)
اطبع_سطر("=== خاصية قراءة فقط ===")

صنف مستطيل
    باني(عرض، ارتفاع)
        هذا._عرض = عرض
        هذا._ارتفاع = ارتفاع
    نهاية

    خاصية المساحة
        احصل
            ارجع هذا._عرض * هذا._ارتفاع
        نهاية
    نهاية

    خاصية المحيط
        احصل
            ارجع 2 * (هذا._عرض + هذا._ارتفاع)
        نهاية
    نهاية
نهاية

متغير م = جديد مستطيل(5، 3)
اطبع_سطر(م"مستطيل 5×3:")
اطبع_سطر(م"  المساحة: {م.المساحة}")
اطبع_سطر(م"  المحيط: {م.المحيط}")

# القسم 2: خاصية قراءة وكتابة (getter + setter)
اطبع_سطر("=== خاصية قراءة وكتابة ===")

صنف حرارة
    باني(درجة)
        هذا._سيلسيوس = درجة
    نهاية

    خاصية سيلسيوس
        احصل
            ارجع هذا._سيلسيوس
        نهاية
        عيّن(قيمة)
            هذا._سيلسيوس = قيمة
        نهاية
    نهاية

    خاصية فهرنهايت
        احصل
            ارجع هذا._سيلسيوس * 9 / 5 + 32
        نهاية
        عيّن(قيمة)
            هذا._سيلسيوس = (قيمة - 32) * 5 / 9
        نهاية
    نهاية
نهاية

متغير ح = جديد حرارة(100)
اطبع_سطر(م"سيلسيوس: {ح.سيلسيوس}")
اطبع_سطر(م"فهرنهايت: {ح.فهرنهايت}")

# تعيين عبر setter
ح.فهرنهايت = 32
اطبع_سطر("بعد تعيين فهرنهايت = 32:")
اطبع_سطر(م"  سيلسيوس: {ح.سيلسيوس}")
اطبع_سطر(م"  فهرنهايت: {ح.فهرنهايت}")

# القسم 3: خاصية مع تحقق
اطبع_سطر("=== خاصية مع تحقق ===")

صنف حساب_بنكي
    باني(رصيد)
        هذا._رصيد = رصيد
        هذا._عمليات = 0
    نهاية

    خاصية الرصيد
        احصل
            ارجع هذا._رصيد
        نهاية
        عيّن(قيمة)
            إذا (قيمة >= 0)
                هذا._رصيد = قيمة
                هذا._عمليات = هذا._عمليات + 1
            وإلا
                اطبع_سطر("خطأ: لا يمكن تعيين رصيد سالب")
            نهاية
        نهاية
    نهاية

    خاصية عدد_العمليات
        احصل
            ارجع هذا._عمليات
        نهاية
    نهاية
نهاية

متغير حـ = جديد حساب_بنكي(1000)
اطبع_سطر(م"الرصيد: {حـ.الرصيد}")
حـ.الرصيد = 1500
اطبع_سطر(م"بعد تعيين 1500: {حـ.الرصيد}")
حـ.الرصيد = -100
اطبع_سطر(م"بعد محاولة تعيين -100: {حـ.الرصيد}")
اطبع_سطر(م"عدد العمليات الناجحة: {حـ.عدد_العمليات}")

# القسم 4: خاصية محسوبة
اطبع_سطر("=== خاصية محسوبة ===")

صنف متجه
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    خاصية الطول
        احصل
            ارجع (هذا.س ** 2 + هذا.ص ** 2) ** 0.5
        نهاية
    نهاية

    دالة وصف()
        ارجع م"متجه({هذا.س}، {هذا.ص}) طوله {هذا.الطول}"
    نهاية
نهاية

متغير ف = جديد متجه(3، 4)
اطبع_سطر(ف.وصف())

متغير ف2 = جديد متجه(0، 1)
اطبع_سطر(ف2.وصف())

