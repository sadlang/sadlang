#        مطابقة أنماط، ماكروز، لامدا، مولدات
# =====================================================

# === ماكرو عرض ===
ماكرو خط(طول)
    متغير س = ""
    متغير ع = 0
    بينما (ع < طول)
        س = س + "═"
        ع = ع + 1
    نهاية
    اطبع_سطر(س)
نهاية

# === سمة قابل_للهجوم ===
سمة قابل_للهجوم
    دالة تلقي_ضرر(ضرر)
نهاية

# === الصنف الأساسي: كائن اللعبة ===
صنف مجرد كائن_لعبة
    دالة مجرد وصف()
    
    دالة عرض()
        اطبع_سطر("  " + هذا.وصف())
    نهاية
نهاية

# === صنف الشخصية ===
صنف شخصية يرث كائن_لعبة
    نفّذ قابل_للهجوم
    
    باني(اسم، صحة، قوة، دفاع)
        هذا.الاسم = اسم
        هذا.الصحة = صحة
        هذا.الصحة_القصوى = صحة
        هذا.القوة = قوة
        هذا.الدفاع = دفاع
        هذا.المستوى = 1
        هذا.الخبرة = 0
        هذا.الحقيبة = []
    نهاية
    
    دالة وصف()
        ارجع "⚔️ " + هذا.الاسم + " [مستوى " + هذا.المستوى + "] HP:" + هذا.الصحة + "/" + هذا.الصحة_القصوى + " ATK:" + هذا.القوة + " DEF:" + هذا.الدفاع
    نهاية
    
    دالة حي()
        ارجع هذا.الصحة > 0
    نهاية
    
    دالة هاجم(هدف)
        متغير ضرر = هذا.القوة - هدف.الدفاع
        إذا (ضرر < 1)
            ضرر = 1
        نهاية
        هدف.تلقي_ضرر(ضرر)
        اطبع_سطر("  ⚔️ " + هذا.الاسم + " يهاجم " + هدف.الاسم + " بـ " + ضرر + " ضرر!")
    نهاية
    
    دالة تلقي_ضرر(ضرر)
        هذا.الصحة = هذا.الصحة - ضرر
        إذا (هذا.الصحة < 0)
            هذا.الصحة = 0
        نهاية
    نهاية
    
    دالة اشف(كمية)
        هذا.الصحة = هذا.الصحة + كمية
        إذا (هذا.الصحة > هذا.الصحة_القصوى)
            هذا.الصحة = هذا.الصحة_القصوى
        نهاية
        اطبع_سطر("  💚 " + هذا.الاسم + " استعاد " + كمية + " صحة → " + هذا.الصحة)
    نهاية
    
    دالة اكسب_خبرة(كمية)
        هذا.الخبرة = هذا.الخبرة + كمية
        اطبع_سطر("  ✨ +" + كمية + " خبرة!")
        
        إذا (هذا.الخبرة >= هذا.المستوى * 50)
            هذا.المستوى = هذا.المستوى + 1
            هذا.القوة = هذا.القوة + 2
            هذا.الدفاع = هذا.الدفاع + 1
            هذا.الصحة_القصوى = هذا.الصحة_القصوى + 10
            هذا.الصحة = هذا.الصحة_القصوى
            هذا.الخبرة = 0
            اطبع_سطر("  🎉 ارتقى المستوى! الآن مستوى " + هذا.المستوى)
        نهاية
    نهاية
    
    دالة اضف_للحقيبة(عنصر)
        هذا.الحقيبة.اضف(عنصر)
        اطبع_سطر("  🎒 حصلت على: " + عنصر)
    نهاية
نهاية

# === صنف الوحش ===
صنف وحش يرث كائن_لعبة
    نفّذ قابل_للهجوم
    
    باني(اسم، صحة، قوة، دفاع، خبرة_جائزة)
        هذا.الاسم = اسم
        هذا.الصحة = صحة
        هذا.القوة = قوة
        هذا.الدفاع = دفاع
        هذا.الخبرة_الجائزة = خبرة_جائزة
    نهاية
    
    دالة وصف()
        ارجع "👹 " + هذا.الاسم + " HP:" + هذا.الصحة + " ATK:" + هذا.القوة
    نهاية
    
    دالة حي()
        ارجع هذا.الصحة > 0
    نهاية
    
    دالة هاجم(هدف)
        متغير ضرر = هذا.القوة - هدف.الدفاع
        إذا (ضرر < 1)
            ضرر = 1
        نهاية
        هدف.تلقي_ضرر(ضرر)
        اطبع_سطر("  👹 " + هذا.الاسم + " يهاجم " + هدف.الاسم + " بـ " + ضرر + " ضرر!")
    نهاية
    
    دالة تلقي_ضرر(ضرر)
        هذا.الصحة = هذا.الصحة - ضرر
        إذا (هذا.الصحة < 0)
            هذا.الصحة = 0
        نهاية
    نهاية
نهاية

# === مولد الوحوش ===
مولد دالة وحوش_عشوائية(عدد)
    متغير أسماء = ["جوبلن"، "ذئب"، "هيكل عظمي"، "عفريت"، "تنين صغير"]
    متغير ع = 0
    بينما (ع < عدد)
        متغير فهرس = ع % طول(أسماء)
        متغير مستوى = ع + 1
        أنتج جديد وحش(
            أسماء[فهرس]،
            20 + مستوى * 5،
            5 + مستوى * 2،
            1 + مستوى،
            15 + مستوى * 10
        )
        ع = ع + 1
    نهاية
نهاية

# === محرك القتال ===
دالة قتال(بطل، عدو)
    خط!(30)
    اطبع_سطر("  ⚔️ بداية القتال!")
    بطل.عرض()
    عدو.عرض()
    خط!(30)
    
    متغير جولة = 1
    بينما (بطل.حي() و عدو.حي())
        اطبع_سطر("  --- جولة " + جولة + " ---")
        
        # هجوم البطل
        بطل.هاجم(عدو)
        إذا (ليس عدو.حي())
            اطبع_سطر("  🏆 " + عدو.الاسم + " هُزم!")
            بطل.اكسب_خبرة(عدو.الخبرة_الجائزة)
            ارجع صحيح
        نهاية
        
        # هجوم العدو
        عدو.هاجم(بطل)
        إذا (ليس بطل.حي())
            اطبع_سطر("  💀 " + بطل.الاسم + " سقط!")
            ارجع خطأ
        نهاية
        
        جولة = جولة + 1
    نهاية
    
    ارجع خطأ
نهاية

