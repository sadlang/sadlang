البطل.اضف_للحقيبة("سيف حديدي")
البطل.اضف_للحقيبة("درع جلدي")
البطل.اضف_للحقيبة("جرعة شفاء × 3")

# قتال سلسلة من الوحوش
متغير انتصارات = 0
متغير معارك = 0

لكل عدو في وحوش_عشوائية(4)
    معارك = معارك + 1
    اطبع_سطر("")
    اطبع_سطر("📍 المعركة " + معارك)
    
    متغير فاز = قتال(البطل، عدو)
    
    إذا (فاز)
        انتصارات = انتصارات + 1
        # شفاء بعد المعركة
        إذا (البطل.الصحة < البطل.الصحة_القصوى)
            البطل.اشف(15)
        نهاية
    وإلا
        اطبع_سطر("  انتهت المغامرة!")
        توقف
    نهاية
نهاية

