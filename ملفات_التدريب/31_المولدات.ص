# === مولد نصوص ===
مولد دالة أحرف_نص(نص_مدخل)
    متغير ع = 0
    بينما (ع < طول(نص_مدخل))
        أنتج نص_مدخل[ع]
        ع = ع + 1
    نهاية
نهاية

اطبع_سطر("=== أحرف كلمة 'مرحبا' ===")
لكل حرف في أحرف_نص("مرحبا")
    اطبع("[" + حرف + "] ")
نهاية
