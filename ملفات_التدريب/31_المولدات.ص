# ملف تدريب 31: المولدات (Generators)
# =====================================================
# المولدات تسمح بإنتاج قيم واحدة تلو الأخرى
# باستخدام الكلمة المفتاحية "أنتج" (yield)
# الترتيب: مولد دالة (وليس دالة مولد)
# =====================================================

# === مولد بسيط: أرقام تسلسلية ===
مولد دالة عداد(بداية، نهاية_العد)
    متغير ع = بداية
    بينما (ع <= نهاية_العد)
        أنتج ع
        ع = ع + 1
    نهاية
نهاية

اطبع_سطر("=== عداد من 1 إلى 5 ===")
لكل رقم في عداد(1، 5)
    اطبع_سطر("  " + رقم)
نهاية

# === مولد الأعداد الزوجية ===
مولد دالة أعداد_زوجية(حد)
    متغير ن = 0
    بينما (ن <= حد)
        أنتج ن
        ن = ن + 2
    نهاية
نهاية

اطبع_سطر("=== الأعداد الزوجية حتى 10 ===")
لكل ز في أعداد_زوجية(10)
    اطبع("  " + ز)
نهاية
اطبع_سطر("")

# === مولد مربعات الأعداد ===
مولد دالة مربعات(عدد)
    متغير ع = 1
    بينما (ع <= عدد)
        أنتج ع * ع
        ع = ع + 1
    نهاية
نهاية

اطبع_سطر("=== مربعات الأعداد من 1 إلى 6 ===")
لكل م في مربعات(6)
    اطبع("  " + م)
نهاية
