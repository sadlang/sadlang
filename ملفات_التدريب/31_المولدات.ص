# === مولد مع فلترة ===
مولد دالة أعداد_أولية(حد)
    متغير ن = 2
    بينما (ن <= حد)
        متغير أولي = صحيح
        متغير ق = 2
        بينما (ق * ق <= ن)
            إذا (ن % ق == 0)
                أولي = خطأ
                توقف
            نهاية
            ق = ق + 1
        نهاية
        إذا (أولي)
            أنتج ن
        نهاية
        ن = ن + 1
    نهاية
نهاية

اطبع_سطر("=== الأعداد الأولية حتى 30 ===")
لكل ع في أعداد_أولية(30)
    اطبع("  " + ع)
نهاية
