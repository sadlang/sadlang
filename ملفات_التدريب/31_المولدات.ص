# === استخدام المولد مع جمع النتائج ===
اطبع_سطر("=== جمع المربعات من 1 إلى 5 ===")
متغير مجموع = 0
لكل م في مربعات(5)
    مجموع = مجموع + م
نهاية
اطبع_سطر("  المجموع: " + مجموع)

