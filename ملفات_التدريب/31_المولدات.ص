# === مولد فيبوناتشي ===
مولد دالة فيبوناتشي(حد_أقصى)
    متغير أ = 0
    متغير ب = 1
    بينما (أ <= حد_أقصى)
        أنتج أ
        متغير مؤقت = أ + ب
        أ = ب
        ب = مؤقت
    نهاية
نهاية

اطبع_سطر("=== أعداد فيبوناتشي حتى 50 ===")
لكل ف في فيبوناتشي(50)
    اطبع("  " + ف)
نهاية
