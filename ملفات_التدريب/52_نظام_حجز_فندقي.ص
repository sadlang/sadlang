# ═══════════════════════════════════════════════

امتداد فندق
    # تقرير الغرف
    دالة تقرير_الغرف()
        اطبع_سطر(م"═══ الغرف في فندق {هذا.الاسم} ═══")
        لكل غ في هذا.الغرف
            اطبع_سطر(غ.وصف())
        نهاية
    نهاية

    # إيرادات متوقعة (لو امتلأ)
    دالة ايرادات_متوقعة(ليالي)
