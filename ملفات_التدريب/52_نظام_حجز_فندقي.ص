# ═══════════════════════════════════════════════
# 4. صنف النزيل
# ═══════════════════════════════════════════════

صنف نزيل
    متغير عام المعرف
    متغير عام الاسم
    متغير عام الجوال
    متغير عام الجنسية
    متغير عام الحجوزات
    متغير عام نقاط_الولاء

    باني(المعرف، الاسم، الجوال، الجنسية)
        هذا.المعرف = المعرف
        هذا.الاسم = الاسم
        هذا.الجوال = الجوال
        هذا.الجنسية = الجنسية
        هذا.الحجوزات = []
        هذا.نقاط_الولاء = 0
    نهاية

    دالة عام اضف_نقاط(نقاط)
        هذا.نقاط_الولاء = هذا.نقاط_الولاء + نقاط
    نهاية

    # مستوى العضوية حسب النقاط
    دالة عام مستوى_العضوية()
        إذا (هذا.نقاط_الولاء >= 1000)
            ارجع "ذهبي"
        وإلا إذا (هذا.نقاط_الولاء >= 500)
            ارجع "فضي"
        وإلا إذا (هذا.نقاط_الولاء >= 100)
            ارجع "برونزي"
        نهاية
        ارجع "عادي"
    نهاية

    # خصم بناء على المستوى
    دالة عام نسبة_الخصم()
        متغير المستوى = هذا.مستوى_العضوية()
        إذا (المستوى == "ذهبي")
            ارجع 20
        وإلا إذا (المستوى == "فضي")
            ارجع 10
        وإلا إذا (المستوى == "برونزي")
            ارجع 5
        نهاية
        ارجع 0
    نهاية

    دالة عام وصف()
        ارجع م"نزيل({هذا.الاسم}، {هذا.الجنسية}، نقاط: {هذا.نقاط_الولاء}، مستوى: {هذا.مستوى_العضوية()})"
    نهاية
نهاية

نفذ قابل_للعرض لـ نزيل
    دالة اعرض()
        اطبع_سطر(هذا.وصف())
    نهاية
نهاية

# ═══════════════════════════════════════════════
# 5. صنف الغرفة
# ═══════════════════════════════════════════════

صنف غرفة
    متغير عام الرقم
    متغير عام النوع
    متغير عام الطابق
    متغير عام السعر_اليومي
    متغير عام الوضع
    متغير عام السعة
    متغير عام اطلالة_بحرية

    باني(الرقم، النوع، الطابق، السعر_اليومي، السعة، اطلالة_بحرية)
        هذا.الرقم = الرقم
        هذا.النوع = النوع
        هذا.الطابق = الطابق
        هذا.السعر_اليومي = السعر_اليومي
        هذا.الوضع = وضع_الغرفة.متاحة
        هذا.السعة = السعة
        هذا.اطلالة_بحرية = اطلالة_بحرية
    نهاية

    دالة عام اشغل()
        هذا.الوضع = وضع_الغرفة.مشغولة
    نهاية

    دالة عام فرّغ()
        هذا.الوضع = وضع_الغرفة.متاحة
    نهاية

    دالة عام صيانة()
        هذا.الوضع = وضع_الغرفة.قيد_الصيانة
    نهاية

    دالة عام متاحة_الآن()
        ارجع هذا.الوضع == وضع_الغرفة.متاحة
    نهاية

    # اسم النوع
    دالة عام اسم_النوع()
        إذا (هذا.النوع == نوع_الغرفة.عادية)
            ارجع "عادية"
        وإلا إذا (هذا.النوع == نوع_الغرفة.ديلوكس)
            ارجع "ديلوكس"
        وإلا إذا (هذا.النوع == نوع_الغرفة.جناح)
            ارجع "جناح"
        وإلا إذا (هذا.النوع == نوع_الغرفة.رئاسي)
            ارجع "رئاسي"
        نهاية
        ارجع "غير معروف"
    نهاية

    # وصف الوضع
    دالة عام اسم_الوضع()
        إذا (هذا.الوضع == وضع_الغرفة.متاحة)
            ارجع "متاحة"
        وإلا إذا (هذا.الوضع == وضع_الغرفة.مشغولة)
            ارجع "مشغولة"
        نهاية
        ارجع "صيانة"
    نهاية

    دالة عام وصف()
        متغير بحر = ""
        إذا (هذا.اطلالة_بحرية)
            بحر = " 🌊"
        نهاية
        ارجع م"غرفة {هذا.الرقم} ({هذا.اسم_النوع()}) طابق {هذا.الطابق} - {هذا.السعر_اليومي} ر.س/ليلة [{هذا.اسم_الوضع()}]{بحر}"
    نهاية
نهاية

# ═══════════════════════════════════════════════
# 6. صنف الحجز
# ═══════════════════════════════════════════════

صنف حجز
    متغير عام المعرف
    متغير عام النزيل
    متغير عام الغرفة
    متغير عام ليالي
    متغير عام الوضع
    متغير عام خدمات_اضافية
    متغير عام المبلغ_الاجمالي
    متغير عام الخصم
    متغير عام المبلغ_النهائي

    باني(المعرف، النزيل، الغرفة، ليالي)
        هذا.المعرف = المعرف
        هذا.النزيل = النزيل
        هذا.الغرفة = الغرفة
        هذا.ليالي = ليالي
        هذا.الوضع = وضع_الحجز.مؤكد
        هذا.خدمات_اضافية = []
        # حساب المبلغ مباشرة في الباني
        هذا.المبلغ_الاجمالي = الغرفة.السعر_اليومي * ليالي
        متغير نسبة_خ = النزيل.نسبة_الخصم()
        هذا.الخصم = هذا.المبلغ_الاجمالي * نسبة_خ / 100
        هذا.المبلغ_النهائي = هذا.المبلغ_الاجمالي - هذا.الخصم
    نهاية

    # حساب المبلغ
    دالة خاص _احسب()
        # سعر الغرفة
        متغير سعر_اساسي = هذا.الغرفة.السعر_اليومي * هذا.ليالي

        # خدمات إضافية
        متغير سعر_خدمات = 0
        لكل خ في هذا.خدمات_اضافية
            سعر_خدمات = سعر_خدمات + خ["سعر"]
        نهاية

        هذا.المبلغ_الاجمالي = سعر_اساسي + سعر_خدمات

        # خصم الولاء
        متغير نسبة = هذا.النزيل.نسبة_الخصم()
        هذا.الخصم = هذا.المبلغ_الاجمالي * نسبة / 100
        هذا.المبلغ_النهائي = هذا.المبلغ_الاجمالي - هذا.الخصم
    نهاية

    # إضافة خدمة إضافية
    دالة عام اضف_خدمة(اسم، سعر)
        يتطلب سعر > 0
        هذا.خدمات_اضافية.اضف({"اسم": اسم، "سعر": سعر})
        هذا._احسب()
    نهاية

    # إلغاء الحجز
    دالة عام الغ()
        هذا.الوضع = وضع_الحجز.ملغي
        هذا.الغرفة.فرّغ()
    نهاية

    # إنهاء الحجز (خروج)
    دالة عام انهِ()
        هذا.الوضع = وضع_الحجز.منتهي
        هذا.الغرفة.فرّغ()
        # إضافة نقاط ولاء
        متغير نقاط = هذا.المبلغ_النهائي / 10
        هذا.النزيل.اضف_نقاط(نقاط)
    نهاية

    # اسم الوضع
    دالة عام اسم_الوضع()
        إذا (هذا.الوضع == وضع_الحجز.مؤكد)
            ارجع "مؤكد"
        وإلا إذا (هذا.الوضع == وضع_الحجز.ملغي)
            ارجع "ملغي"
        وإلا إذا (هذا.الوضع == وضع_الحجز.منتهي)
            ارجع "منتهي"
        نهاية
        ارجع "قيد الانتظار"
    نهاية

    # عرض تفاصيل الحجز
    دالة عام تفاصيل()
        اطبع_سطر(م"حجز #{هذا.المعرف} [{هذا.اسم_الوضع()}]")
        اطبع_سطر(م"  النزيل: {هذا.النزيل.الاسم}")
        اطبع_سطر(م"  الغرفة: {هذا.الغرفة.الرقم} ({هذا.الغرفة.اسم_النوع()})")
        اطبع_سطر(م"  الليالي: {هذا.ليالي}")
        اطبع_سطر(م"  المبلغ: {هذا.المبلغ_الاجمالي} ر.س")
        إذا (هذا.الخصم > 0)
            اطبع_سطر(م"  الخصم: {هذا.الخصم} ر.س ({هذا.النزيل.نسبة_الخصم()}%)")
        نهاية
        اطبع_سطر(م"  المبلغ النهائي: {هذا.المبلغ_النهائي} ر.س")
        إذا (طول(هذا.خدمات_اضافية) > 0)
            اطبع_سطر(م"  خدمات إضافية: {طول(هذا.خدمات_اضافية)}")
            لكل خ في هذا.خدمات_اضافية
                اطبع_سطر(م"    • {خ["اسم"]}: {خ["سعر"]} ر.س")
            نهاية
        نهاية
    نهاية
نهاية

نفذ قابل_للحساب لـ حجز
    دالة احسب_المبلغ()
        ارجع هذا.المبلغ_النهائي
    نهاية
نهاية

# ═══════════════════════════════════════════════
# 7. صنف الفندق (المدير الرئيسي)
# ═══════════════════════════════════════════════

صنف فندق
    متغير عام الاسم
    متغير عام عدد_النجوم
    متغير عام الغرف
    متغير عام النزلاء
    متغير عام الحجوزات
    متغير عام عداد_الحجوزات
    متغير عام عداد_النزلاء
    متغير عام الايرادات

    باني(الاسم، عدد_النجوم)
        هذا.الاسم = الاسم
        هذا.عدد_النجوم = عدد_النجوم
        هذا.الغرف = []
        هذا.النزلاء = []
        هذا.الحجوزات = []
        هذا.عداد_الحجوزات = 0
        هذا.عداد_النزلاء = 0
        هذا.الايرادات = 0
    نهاية

    # إضافة غرفة
    دالة عام اضف_غرفة(رقم، نوع، طابق، سعر، سعة، اطلالة)
        متغير غ = جديد غرفة(رقم، نوع، طابق، سعر، سعة، اطلالة)
        هذا.الغرف.اضف(غ)
        ارجع غ
    نهاية

    # تسجيل نزيل
    دالة عام سجل_نزيل(الاسم، الجوال، الجنسية)
        يتطلب طول(الاسم) > 0
        هذا.عداد_النزلاء = هذا.عداد_النزلاء + 1
        متغير ن = جديد نزيل(هذا.عداد_النزلاء، الاسم، الجوال، الجنسية)
        هذا.النزلاء.اضف(ن)
        ارجع ن
    نهاية

    # البحث عن غرفة متاحة بالنوع
    دالة عام ابحث_غرفة(النوع_المطلوب)
        لكل غ في هذا.الغرف
            إذا (غ.النوع == النوع_المطلوب و غ.متاحة_الآن())
                ارجع غ
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    # حجز غرفة
    دالة عام احجز(نزيل، النوع_المطلوب، ليالي)
        يتطلب ليالي > 0
        متغير غ = هذا.ابحث_غرفة(النوع_المطلوب)
        إذا (غ == لاشيء)
            ارجع لاشيء
        نهاية
        غ.اشغل()
        هذا.عداد_الحجوزات = هذا.عداد_الحجوزات + 1
        متغير ح = جديد حجز(هذا.عداد_الحجوزات، نزيل، غ، ليالي)
        هذا.الحجوزات.اضف(ح)
        نزيل.الحجوزات.اضف(ح)
        ارجع ح
    نهاية

    # إخراج نزيل (checkout)
    دالة عام اخرج(حجز_مطلوب)
        حجز_مطلوب.انهِ()
        هذا.الايرادات = هذا.الايرادات + حجز_مطلوب.المبلغ_النهائي
    نهاية

    # عدد الغرف المتاحة
    دالة عام الغرف_المتاحة()
        متغير عدد = 0
        لكل غ في هذا.الغرف
            إذا (غ.متاحة_الآن())
                عدد = عدد + 1
            نهاية
        نهاية
        ارجع عدد
    نهاية

    # عدد الغرف المشغولة
    دالة عام الغرف_المشغولة()
        ارجع طول(هذا.الغرف) - هذا.الغرف_المتاحة()
    نهاية

    # نسبة الإشغال
    دالة عام نسبة_الاشغال()
        إذا (طول(هذا.الغرف) == 0)
            ارجع 0
        نهاية
        ارجع (هذا.الغرف_المشغولة() * 100) / طول(هذا.الغرف)
    نهاية

    # غرف بنوع محدد
    دالة عام غرف_بنوع(النوع)
        متغير نتيجة = []
        لكل غ في هذا.الغرف
            إذا (غ.النوع == النوع)
                نتيجة.اضف(غ)
            نهاية
        نهاية
        ارجع نتيجة
    نهاية

    # إحصائيات
    دالة عام اطبع_احصائيات()
        اطبع_سطر(م"═══ إحصائيات فندق {هذا.الاسم} ═══")
        اطبع_سطر(م"عدد النجوم: {هذا.عدد_النجوم}")
        اطبع_سطر(م"إجمالي الغرف: {طول(هذا.الغرف)}")
        اطبع_سطر(م"الغرف المتاحة: {هذا.الغرف_المتاحة()}")
        اطبع_سطر(م"الغرف المشغولة: {هذا.الغرف_المشغولة()}")
        اطبع_سطر(م"نسبة الإشغال: {هذا.نسبة_الاشغال()}%")
        اطبع_سطر(م"النزلاء المسجلون: {طول(هذا.النزلاء)}")
        اطبع_سطر(م"إجمالي الحجوزات: {طول(هذا.الحجوزات)}")
        اطبع_سطر(م"الإيرادات: {هذا.الايرادات} ر.س")
    نهاية

    # أغلى حجز
    دالة عام اغلى_حجز()
        متغير اعلى = لاشيء
        متغير مبلغ_اعلى = 0
        لكل ح في هذا.الحجوزات
            إذا (ح.المبلغ_النهائي > مبلغ_اعلى)
                اعلى = ح
                مبلغ_اعلى = ح.المبلغ_النهائي
            نهاية
        نهاية
        ارجع اعلى
    نهاية
نهاية

