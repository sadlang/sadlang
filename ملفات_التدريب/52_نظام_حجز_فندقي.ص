        لكل غ في هذا.الغرف
            مجموع = مجموع + غ.السعر_اليومي * ليالي
        نهاية
        ارجع مجموع
    نهاية
نهاية

امتداد نزيل
    # ملخص الحجوزات
    دالة ملخص_حجوزات()
        اطبع_سطر(م"═══ حجوزات {هذا.الاسم} ═══")
        إذا (طول(هذا.الحجوزات) == 0)
            اطبع_سطر("  لا توجد حجوزات")
            ارجع لاشيء
        نهاية
        لكل ح في هذا.الحجوزات
            اطبع_سطر(م"  حجز #{ح.المعرف}: غرفة {ح.الغرفة.الرقم}، {ح.ليالي} ليالي، {ح.المبلغ_النهائي} ر.س [{ح.اسم_الوضع()}]")
        نهاية
        ارجع صحيح
    نهاية
نهاية

