# === العامل الثلاثي الأساسي ===
اطبع_سطر("=== العامل الثلاثي ===")

متغير عمر = 20
متغير تصنيف = عمر >= 18 ? "بالغ" : "قاصر"
اطبع_سطر("  العمر " + عمر + ": " + تصنيف)

متغير درجة = 85
متغير نتيجة = درجة >= 50 ? "ناجح" : "راسب"
اطبع_سطر("  الدرجة " + درجة + ": " + نتيجة)

# === العامل الثلاثي في حسابات ===
اطبع_سطر("")
اطبع_سطر("=== الثلاثي في حسابات ===")

متغير سعر = 100
متغير كمية = 15
متغير خصم = كمية > 10 ? 0.1 : 0
متغير المجموع = سعر * كمية * (1 - خصم)
اطبع_سطر("  الكمية: " + كمية)
اطبع_سطر("  الخصم: " + (خصم * 100) + "%")
اطبع_سطر("  المجموع: " + المجموع)

# === العامل الثلاثي المتداخل ===
اطبع_سطر("")
اطبع_سطر("=== تصنيف الدرجات ===")
دالة تصنيف_درجة(د)
    ارجع د >= 90 ? "ممتاز" : (د >= 80 ? "جيد جداً" : (د >= 70 ? "جيد" : (د >= 60 ? "مقبول" : "راسب")))
نهاية

متغير درجات = [95، 82، 73، 64، 45]
لكل د في درجات
    اطبع_سطر("  " + د + " → " + تصنيف_درجة(د))
نهاية

# === عامل العضوية (في) ===
اطبع_سطر("")
اطبع_سطر("=== عامل العضوية (في) ===")

متغير فواكه = ["تفاح"، "موز"، "برتقال"، "عنب"]
اطبع_سطر("  تفاح في الفواكه: " + ("تفاح" في فواكه))
اطبع_سطر("  مانجو في الفواكه: " + ("مانجو" في فواكه))

# === في مع أرقام ===
متغير أرقام = [2، 4، 6، 8، 10]
اطبع_سطر("")
اطبع_سطر("=== البحث في مصفوفة أرقام ===")
متغير بحث = [3، 4، 7، 8، 11]
لكل ر في بحث
    متغير موجود = ر في أرقام ? "✅ موجود" : "❌ غير موجود"
    اطبع_سطر("  " + ر + ": " + موجود)
نهاية

# === نظام صلاحيات ===
اطبع_سطر("")
اطبع_سطر("=== نظام صلاحيات ===")
متغير مشرفون = ["أحمد"، "سارة"، "محمد"]

دالة تحقق_صلاحية(اسم)
    ارجع اسم في مشرفون ? "مسموح" : "مرفوض"
نهاية

متغير مستخدمون = ["أحمد"، "خالد"، "سارة"، "نورة"]
لكل م في مستخدمون
    اطبع_سطر("  " + م + ": " + تحقق_صلاحية(م))
نهاية

# === دمج الثلاثي مع في ===
اطبع_سطر("")
اطبع_سطر("=== فلترة ذكية ===")
متغير قائمة_سوداء = [100، 200، 300]
متغير طلبات = [50، 100، 150، 200، 250]

لكل ط في طلبات
    متغير حالة_الطلب = ط في قائمة_سوداء ? "🚫 مرفوض" : "✅ مقبول"
    اطبع_سطر("  طلب " + ط + ": " + حالة_الطلب)
نهاية

# === عدّاد مع العامل الثلاثي ===
اطبع_سطر("")
اطبع_سطر("=== أزواج وأفراد ===")
متغير ع = 1
بينما (ع <= 10)
    متغير نوع = ع % 2 == 0 ? "زوجي" : "فردي"
    اطبع_سطر("  " + ع + " → " + نوع)
    ع = ع + 1
نهاية

اطبع_سطر("")
اطبع_سطر("✅ تم اختبار العامل الثلاثي وعامل العضوية بنجاح!")
