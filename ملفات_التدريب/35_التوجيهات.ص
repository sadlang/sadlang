# ملف تدريب 35: التوجيهات (Directives)
# =====================================================
# التوجيهات تبدأ بـ @ وتوفر تحكم منخفض المستوى
# @حجم(نوع) — حجم النوع بالبايتات
# @وقت_الترجمة — تنفيذ في وقت الترجمة
# =====================================================

# === @حجم: معرفة حجم الأنواع ===
اطبع_سطر("=== أحجام الأنواع ===")
اطبع_سطر("  حجم رقم: " + @حجم(رقم) + " بايت")
اطبع_سطر("  حجم عشري: " + @حجم(عشري) + " بايت")
اطبع_سطر("  حجم نص: " + @حجم(نص) + " بايت")
اطبع_سطر("  حجم منطقي: " + @حجم(منطقي) + " بايت")

# === استخدام @حجم في حسابات ===
اطبع_سطر("")
اطبع_سطر("=== حسابات الذاكرة ===")
متغير عدد_العناصر = 1000
متغير حجم_الرقم = @حجم(رقم)
متغير الذاكرة_المطلوبة = عدد_العناصر * حجم_الرقم
اطبع_سطر("  مصفوفة " + عدد_العناصر + " رقم تحتاج: " + الذاكرة_المطلوبة + " بايت")

متغير حجم_النص = @حجم(نص)
متغير ذاكرة_نصوص = عدد_العناصر * حجم_النص
اطبع_سطر("  مصفوفة " + عدد_العناصر + " نص تحتاج: " + ذاكرة_نصوص + " بايت")

# === مقارنة الأحجام ===
اطبع_سطر("")
اطبع_سطر("=== مقارنة الأحجام ===")
متغير أنواع_أسماء = ["رقم"، "عشري"، "نص"، "منطقي"]
متغير أحجام = [@حجم(رقم)، @حجم(عشري)، @حجم(نص)، @حجم(منطقي)]

متغير ع = 0
لكل اسم في أنواع_أسماء
    اطبع_سطر("  " + اسم + ": " + أحجام[ع] + " بايت")
    ع = ع + 1
نهاية

# === أكبر نوع ===
متغير أكبر_حجم = 0
متغير أكبر_نوع = ""
متغير ع٢ = 0
لكل ح في أحجام
    إذا (ح > أكبر_حجم)
        أكبر_حجم = ح
        أكبر_نوع = أنواع_أسماء[ع٢]
    نهاية
    ع٢ = ع٢ + 1
نهاية
اطبع_سطر("  أكبر نوع: " + أكبر_نوع + " (" + أكبر_حجم + " بايت)")

# === حساب بنية بيانات ===
اطبع_سطر("")
اطبع_سطر("=== حساب حجم بنية ===")
# بنية لشخص: اسم (نص) + عمر (رقم) + راتب (عشري) + نشط (منطقي)
متغير حجم_شخص = @حجم(نص) + @حجم(رقم) + @حجم(عشري) + @حجم(منطقي)
اطبع_سطر("  حجم بنية شخص: " + حجم_شخص + " بايت")

متغير عدد_موظفين = 500
اطبع_سطر("  " + عدد_موظفين + " موظف يحتاجون: " + (عدد_موظفين * حجم_شخص) + " بايت")

# === تقرير الذاكرة ===
اطبع_سطر("")
اطبع_سطر("=== تقرير الذاكرة ===")
دالة تنسيق_حجم(بايتات)
    إذا (بايتات < 1024)
        ارجع بايتات + " بايت"
    وإلا إذا (بايتات < 1024 * 1024)
        ارجع (بايتات / 1024) + " كيلوبايت"
    وإلا
        ارجع (بايتات / (1024 * 1024)) + " ميغابايت"
    نهاية
نهاية

اطبع_سطر("  1000 رقم: " + تنسيق_حجم(1000 * @حجم(رقم)))
اطبع_سطر("  1000 نص: " + تنسيق_حجم(1000 * @حجم(نص)))
اطبع_سطر("  500 شخص: " + تنسيق_حجم(500 * حجم_شخص))

اطبع_سطر("")
اطبع_سطر("✅ تم اختبار التوجيهات بنجاح!")
