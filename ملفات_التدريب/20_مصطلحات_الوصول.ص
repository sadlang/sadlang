# ملف تدريب 20: مصطلحات الوصول (عام / خاص / محمي)
# لغة ص — التحكم في رؤية أعضاء الصنف

# القسم 1: عام وخاص
اطبع_سطر("=== عام وخاص ===")

صنف حساب_بنكي
    متغير عام المالك
    متغير خاص _الرصيد
    
    باني(مالك، رصيد)
        هذا.المالك = مالك
        هذا._الرصيد = رصيد
    نهاية
    
    دالة عام الرصيد()
        ارجع هذا._الرصيد
    نهاية
    
    دالة عام إيداع(مبلغ)
        إذا (مبلغ > 0)
            هذا._الرصيد = هذا._الرصيد + مبلغ
            اطبع_سطر("تم إيداع " + مبلغ)
        نهاية
    نهاية
    
    دالة عام سحب(مبلغ)
        إذا (مبلغ <= هذا._الرصيد)
            هذا._الرصيد = هذا._الرصيد - مبلغ
            اطبع_سطر("تم سحب " + مبلغ)
        وإلا
            اطبع_سطر("رصيد غير كافي!")
        نهاية
    نهاية
نهاية

متغير ح = جديد حساب_بنكي("أحمد"، 5000)
اطبع_سطر("المالك: " + ح.المالك)
اطبع_سطر("الرصيد: " + ح.الرصيد())
ح.إيداع(2000)
اطبع_سطر("الرصيد الجديد: " + ح.الرصيد())
ح.سحب(3000)
اطبع_سطر("الرصيد بعد السحب: " + ح.الرصيد())

# القسم 2: وراثة مع محمي
اطبع_سطر("=== محمي ووراثة ===")

صنف شكل
    متغير محمي _النوع
    متغير محمي _اللون
    
    باني(نوع)
        هذا._النوع = نوع
        هذا._اللون = 0
    نهاية
    
    دالة عام النوع()
        ارجع هذا._النوع
    نهاية
نهاية

صنف دائرة يرث شكل
    متغير عام نصف_القطر
    
    باني(نصف_قطر)
        الأساس("دائرة")
        هذا.نصف_القطر = نصف_قطر
    نهاية
    
    دالة عام المساحة()
        ارجع 3.14 * هذا.نصف_القطر * هذا.نصف_القطر
    نهاية
    
    دالة عام وصف()
        ارجع هذا.النوع() + " بنصف قطر " + هذا.نصف_القطر
    نهاية
نهاية

متغير د = جديد دائرة(5)
اطبع_سطر(د.وصف())
اطبع_سطر("المساحة: " + د.المساحة())

# القسم 3: تطبيق عملي
اطبع_سطر("=== تطبيق عملي ===")

صنف موظف
    متغير عام الاسم
    متغير عام القسم
    متغير خاص _الراتب
    
    باني(اسم، قسم، راتب)
        هذا.الاسم = اسم
        هذا.القسم = قسم
        هذا._الراتب = راتب
    نهاية
    
    دالة عام الراتب()
        ارجع هذا._الراتب
    نهاية
    
    دالة عام زيادة_راتب(نسبة)
        هذا._الراتب = هذا._الراتب + (هذا._الراتب * نسبة / 100)
    نهاية
    
    دالة عام بطاقة()
        ارجع هذا.الاسم + " | " + هذا.القسم + " | " + هذا._الراتب + " ريال"
    نهاية
نهاية

متغير م1 = جديد موظف("سارة"، "الهندسة"، 8000)
اطبع_سطر(م1.بطاقة())
م1.زيادة_راتب(10)
اطبع_سطر("بعد زيادة 10%: " + م1.بطاقة())

اطبع_سطر("=== انتهى ملف مصطلحات الوصول ===")
