# ===================================================
# ملف تدريب 12: معالجة الأخطاء
# لغة ص — Sad Programming Language
# ===================================================
# يغطي هذا الملف:
# - حاول / امسك / أخيراً
# - ارمي (رمي استثناء)
# - التعامل مع أنواع مختلفة من الأخطاء
# ===================================================

# --- القسم 1: حاول وامسك أساسي ---
اطبع_سطر("=== حاول وامسك ===")

حاول
    متغير نتيجة = 10 / 0
    اطبع_سطر("النتيجة: " + نتيجة)
امسك خطأ
    اطبع_سطر("حدث خطأ: " + خطأ)
نهاية

# --- القسم 2: رمي استثناء ---
اطبع_سطر("=== رمي استثناء ===")

دالة تحقق_العمر(العمر)
    إذا (العمر < 0)
        ارمي "العمر لا يمكن أن يكون سالباً!"
    نهاية
    إذا (العمر > 150)
        ارمي "العمر غير واقعي!"
    نهاية
    ارجع "العمر مقبول: " + العمر
نهاية

حاول
    اطبع_سطر(تحقق_العمر(25))
    اطبع_سطر(تحقق_العمر(-5))
امسك خطأ
    اطبع_سطر("خطأ في العمر: " + خطأ)
نهاية

# --- القسم 3: حاول مع أخيراً ---
اطبع_سطر("=== أخيراً ===")

دالة عملية_خطيرة()
    اطبع_سطر("بداية العملية")
    ارمي "فشل في العملية!"
نهاية

حاول
    عملية_خطيرة()
امسك خطأ
    اطبع_سطر("تم التقاط: " + خطأ)
أخيراً
    اطبع_سطر("تنظيف الموارد (يُنفذ دائماً)")
نهاية

# --- القسم 4: معالجة أخطاء متعددة ---
اطبع_سطر("=== معالجة متعددة ===")

دالة قسمة_آمنة(أ، ب)
    إذا (ب == 0)
        ارمي "لا يمكن القسمة على صفر"
    نهاية
    ارجع أ / ب
نهاية

متغير عمليات = [[10، 2]، [20، 0]، [15، 3]، [8، 0]، [100، 5]]

لكل عملية في عمليات
    حاول
        متغير ناتج = قسمة_آمنة(عملية[0]، عملية[1])
        اطبع_سطر(عملية[0] + " / " + عملية[1] + " = " + ناتج)
    امسك خطأ
        اطبع_سطر(عملية[0] + " / " + عملية[1] + " => خطأ: " + خطأ)
    نهاية
نهاية

# --- القسم 5: إعادة رمي الاستثناء ---
اطبع_سطر("=== إعادة رمي ===")

دالة طبقة_أولى()
    ارمي "خطأ من الطبقة الأولى"
نهاية

دالة طبقة_ثانية()
    حاول
        طبقة_أولى()
    امسك خطأ
        اطبع_سطر("الطبقة الثانية التقطت: " + خطأ)
        ارمي "خطأ مُعاد: " + خطأ
    نهاية
نهاية

حاول
    طبقة_ثانية()
امسك خطأ
    اطبع_سطر("المستوى الأعلى التقط: " + خطأ)
نهاية

# --- القسم 6: دالة مع حماية كاملة ---
اطبع_سطر("=== حماية كاملة ===")

دالة احسب_المعدل(الدرجات)
    إذا (الدرجات.الطول() == 0)
        ارمي "القائمة فارغة!"
    نهاية
    
    متغير المجموع = 0
    لكل د في الدرجات
        المجموع = المجموع + د
    نهاية
    
    ارجع المجموع / الدرجات.الطول()
نهاية

حاول
    متغير معدل = احسب_المعدل([85، 90، 78، 92، 88])
    اطبع_سطر("المعدل: " + معدل)
    
    متغير معدل_فارغ = احسب_المعدل([])
    اطبع_سطر("لن يصل هنا")
امسك خطأ
    اطبع_سطر("خطأ في حساب المعدل: " + خطأ)
أخيراً
    اطبع_سطر("انتهت عملية حساب المعدل")
نهاية

اطبع_سطر("=== انتهى ملف معالجة الأخطاء ===")