# ===================================================
# ملف تدريب 04: الحلقات والتكرار
# لغة ص — Sad Programming Language
# ===================================================
# يغطي هذا الملف:
# - حلقة بينما (while)
# - حلقة لكل مع مصفوفة (for each)
# - حلقة لكل مع نطاق (range)
# - التحكم بالحلقات: توقف (break)، استمر (continue)
# - الحلقات المتداخلة
# ===================================================

# --- القسم 1: حلقة بينما ---
اطبع_سطر("=== حلقة بينما ===")

متغير عداد = 1
بينما (عداد <= 5)
    اطبع_سطر("العداد: " + عداد)
    عداد += 1
نهاية

# --- القسم 2: بينما مع شرط معقد ---
اطبع_سطر("=== بينما مع شرط معقد ===")

متغير مجموع = 0
متغير ي = 1
بينما (ي <= 10 و مجموع < 30)
    مجموع += ي
    ي += 1
نهاية
اطبع_سطر("المجموع: " + مجموع + " عند ي=" + ي)

# --- القسم 3: لكل مع مصفوفة ---
اطبع_سطر("=== لكل مع مصفوفة ===")

متغير فواكه = ["تفاح"، "برتقال"، "موز"، "عنب"]
لكل فاكهة في فواكه
    اطبع_سطر("فاكهة: " + فاكهة)
نهاية

# --- القسم 4: لكل مع مصفوفة أرقام ---
اطبع_سطر("=== لكل مع أرقام ===")

متغير أرقام = [10، 20، 30، 40، 50]
متغير الإجمالي = 0
لكل رقم في أرقام
    الإجمالي += رقم
نهاية
اطبع_سطر("الإجمالي: " + الإجمالي)

# --- القسم 5: لكل مع نطاق ---
اطبع_سطر("=== لكل مع نطاق ===")

# النطاق شامل: 1..5 يعطي 1, 2, 3, 4, 5
اطبع("من 1 إلى 5: ")
لكل ن في 1..5
    اطبع(ن + " ")
نهاية
اطبع_سطر("")

# --- القسم 6: توقف (break) ---
اطبع_سطر("=== التوقف (break) ===")

متغير ع = 0
بينما (صحيح)
    إذا (ع >= 5)
        توقف
    نهاية
    اطبع_سطر("ع = " + ع)
    ع += 1
نهاية
اطبع_سطر("خرجنا من الحلقة عند ع = " + ع)

# --- القسم 7: استمر (continue) ---
اطبع_سطر("=== الاستمرار (continue) ===")

# طباعة الأرقام الفردية فقط
اطبع("الأعداد الفردية: ")
لكل ن في 1..10
    إذا (ن % 2 == 0)
        استمر
    نهاية
    اطبع(ن + " ")
نهاية
اطبع_سطر("")

# --- القسم 8: حلقات متداخلة ---
اطبع_سطر("=== حلقات متداخلة ===")

# جدول الضرب (1-3)
لكل ص في 1..3
    لكل ع في 1..3
        اطبع_سطر(ص + " × " + ع + " = " + (ص * ع))
    نهاية
نهاية

# --- القسم 9: عد تنازلي ببينما ---
اطبع_سطر("=== عد تنازلي ===")

متغير ث = 5
بينما (ث > 0)
    اطبع_سطر(ث + "...")
    ث -= 1
نهاية
اطبع_سطر("انطلق!")

# --- القسم 10: بناء مصفوفة بحلقة ---
اطبع_سطر("=== بناء مصفوفة ===")

متغير مربعات = []
لكل ن في 1..5
    مربعات.اضف(ن * ن)
نهاية
اطبع_سطر("مربعات 1-5: " + مربعات)

# --- القسم 11: البحث في مصفوفة ---
اطبع_سطر("=== البحث في مصفوفة ===")

دالة بحث(القائمة، الهدف)
    متغير ف = 0
    بينما (ف < طول(القائمة))
        إذا (القائمة[ف] == الهدف)
            ارجع ف
        نهاية
        ف += 1
    نهاية
    ارجع -1
نهاية

متغير بيانات = [5، 12، 8، 3، 20]
اطبع_سطر("موقع 8: " + بحث(بيانات، 8))
اطبع_سطر("موقع 99: " + بحث(بيانات، 99))

# --- القسم 12: الأعداد الأولية ---
اطبع_سطر("=== الأعداد الأولية حتى 20 ===")

دالة هل_أولي(ن)
    إذا (ن < 2)
        ارجع خطأ
    نهاية
    متغير ق = 2
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            ارجع خطأ
        نهاية
        ق += 1
    نهاية
    ارجع صحيح
نهاية

اطبع("الأعداد الأولية: ")
لكل ن في 2..20
    إذا (هل_أولي(ن))
        اطبع(ن + " ")
    نهاية
نهاية
اطبع_سطر("")

اطبع_سطر("=== انتهى ملف الحلقات ===")
