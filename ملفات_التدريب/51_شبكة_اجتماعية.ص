# ═══════════════════════════════════════════════
# 7. صنف المجموعة
# ═══════════════════════════════════════════════

صنف مجموعة
    متغير عام الاسم
    متغير عام الوصف
    متغير عام المؤسس
    متغير عام الأعضاء
    متغير عام المنشورات

    باني(الاسم، الوصف، المؤسس)
        هذا.الاسم = الاسم
        هذا.الوصف = الوصف
        هذا.المؤسس = المؤسس
        هذا.الأعضاء = [المؤسس]
        هذا.المنشورات = []
    نهاية

    # انضمام عضو
