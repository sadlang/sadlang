# 4. الأصناف الأساسية
# ═══════════════════════════════════════════════

# صنف المستخدم
صنف مستخدم
    متغير عام المعرف
    متغير عام الاسم
    متغير عام البريد
    متغير عام الوضع
    متغير عام الأصدقاء
    متغير عام المنشورات
    متغير عام التنبيهات
    متغير عام تاريخ_التسجيل
    متغير عام عدد_الزيارات

    باني(المعرف، الاسم، البريد)
        هذا.المعرف = المعرف
        هذا.الاسم = الاسم
        هذا.البريد = البريد
        هذا.الوضع = وضع_الحساب.نشط
        هذا.الأصدقاء = []
        هذا.المنشورات = []
        هذا.التنبيهات = []
        هذا.تاريخ_التسجيل = "2025-01-15"
        هذا.عدد_الزيارات = 0
    نهاية

    # إضافة صديق
    دالة عام اضف_صديق(صديق)
        # تحقق من عدم إضافة نفسه
        إذا (صديق.المعرف == هذا.المعرف)
            ارجع خطأ
        نهاية
        # تحقق من عدم وجوده مسبقاً
        لكل ص في هذا.الأصدقاء
            إذا (ص.المعرف == صديق.المعرف)
                ارجع خطأ
            نهاية
        نهاية
        هذا.الأصدقاء.اضف(صديق)
        صديق.الأصدقاء.اضف(هذا)
        هذا.التنبيهات.اضف(م"أصبحت صديقاً لـ {صديق.الاسم}")
        صديق.التنبيهات.اضف(م"أصبحت صديقاً لـ {هذا.الاسم}")
        ارجع صحيح
    نهاية

    # نشر منشور
    دالة عام انشر(محتوى، نوع)
        يتطلب طول(محتوى) > 0
        متغير م = جديد منشور(هذا، محتوى، نوع)
        هذا.المنشورات.اضف(م)
        # إعلام الأصدقاء
        لكل ص في هذا.الأصدقاء
            ص.التنبيهات.اضف(م"منشور جديد من {هذا.الاسم}")
        نهاية
        ارجع م
    نهاية

    # عدد الأصدقاء
    دالة عام عدد_الاصدقاء()
        ارجع طول(هذا.الأصدقاء)
    نهاية

    # البحث عن صديق بالاسم
    دالة عام ابحث_صديق(اسم_البحث)
        لكل ص في هذا.الأصدقاء
            إذا (ص.الاسم == اسم_البحث)
                ارجع ص
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    # جلب التنبيهات
    دالة عام عدد_التنبيهات()
        ارجع طول(هذا.التنبيهات)
    نهاية

    # زيارة الملف الشخصي
    دالة عام زيارة()
        هذا.عدد_الزيارات = هذا.عدد_الزيارات + 1
    نهاية

    # وصف المستخدم
    دالة عام وصف()
        ارجع م"مستخدم({هذا.الاسم}، أصدقاء: {هذا.عدد_الاصدقاء()}، منشورات: {طول(هذا.المنشورات)})"
    نهاية
نهاية

