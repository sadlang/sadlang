# ═══════════════════════════════════════════════
# 5. صنف المنشور
# ═══════════════════════════════════════════════

صنف منشور
    متغير عام الكاتب
    متغير عام المحتوى
    متغير عام النوع
    متغير عام الإعجابات
    متغير عام التعليقات
    متغير عام المشاركات

    باني(الكاتب، المحتوى، النوع)
        هذا.الكاتب = الكاتب
        هذا.المحتوى = المحتوى
        هذا.النوع = النوع
        هذا.الإعجابات = 0
        هذا.التعليقات = []
        هذا.المشاركات = 0
    نهاية

    # إعجاب
    دالة عام اعجب()
        هذا.الإعجابات = هذا.الإعجابات + 1
    نهاية

    # تعليق
    دالة عام علق(المعلق، نص_التعليق)
        يتطلب طول(نص_التعليق) > 0
        متغير ت = جديد تعليق(المعلق، نص_التعليق)
        هذا.التعليقات.اضف(ت)
        ارجع ت
    نهاية

    # مشاركة
    دالة عام شارك()
        هذا.المشاركات = هذا.المشاركات + 1
    نهاية

    # مجموع التفاعلات
    دالة عام مجموع_التفاعلات()
        ارجع هذا.الإعجابات + طول(هذا.التعليقات) + هذا.المشاركات
    نهاية

    # وصف مختصر
    دالة عام ملخص()
        متغير نص_النوع = "غير معروف"
        إذا (هذا.النوع == نوع_المنشور.نص_عادي)
            نص_النوع = "نص"
        وإلا إذا (هذا.النوع == نوع_المنشور.صورة)
            نص_النوع = "صورة"
        وإلا إذا (هذا.النوع == نوع_المنشور.فيديو)
            نص_النوع = "فيديو"
        وإلا إذا (هذا.النوع == نوع_المنشور.استطلاع)
            نص_النوع = "استطلاع"
        نهاية
        ارجع م"[{نص_النوع}] {هذا.المحتوى} - {هذا.الإعجابات} إعجاب"
    نهاية
نهاية

# تنفيذ سمة قابل_للتفاعل للمنشور
نفذ قابل_للتفاعل لـ منشور
    دالة تفاعل(نوع_تفاعل)
