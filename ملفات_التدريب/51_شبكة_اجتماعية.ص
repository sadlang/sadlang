امتداد شبكة_اجتماعية
    # البحث عن أصدقاء مشتركين بين مستخدمين
    دالة اصدقاء_مشتركون(م1، م2)
        متغير مشتركون = []
        لكل ص1 في م1.الأصدقاء
            لكل ص2 في م2.الأصدقاء
                إذا (ص1.المعرف == ص2.المعرف)
                    مشتركون.اضف(ص1)
                نهاية
            نهاية
        نهاية
        ارجع مشتركون
    نهاية
نهاية

