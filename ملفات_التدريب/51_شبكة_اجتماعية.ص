        هذا.الأعضاء.اضف(عضو)
        ارجع صحيح
    نهاية

    # نشر في المجموعة
    دالة عام انشر_فيها(كاتب، محتوى)
        متغير م = جديد منشور(كاتب، محتوى، نوع_المنشور.نص_عادي)
        هذا.المنشورات.اضف(م)
        ارجع م
    نهاية

    # عدد الأعضاء
    دالة عام حجم()
        ارجع طول(هذا.الأعضاء)
    نهاية
نهاية

