# ═══════════════════════════════════════════════
# 9. صنف الشبكة الاجتماعية (المدير)
# ═══════════════════════════════════════════════

صنف شبكة_اجتماعية
    متغير عام الاسم
    متغير عام المستخدمون
    متغير عام المجموعات
    متغير عام الرسائل
    متغير عام العداد

    باني(الاسم)
        هذا.الاسم = الاسم
        هذا.المستخدمون = []
        هذا.المجموعات = []
        هذا.الرسائل = []
        هذا.العداد = 0
    نهاية

    # تسجيل مستخدم جديد
    دالة عام سجل(الاسم، البريد)
        يتطلب طول(الاسم) > 0
        يتطلب طول(البريد) > 0
        هذا.العداد = هذا.العداد + 1
        متغير م = جديد مستخدم(هذا.العداد، الاسم، البريد)
        هذا.المستخدمون.اضف(م)
        ارجع م
    نهاية

    # البحث عن مستخدم بالاسم
    دالة عام ابحث(اسم_البحث)
        لكل م في هذا.المستخدمون
            إذا (م.الاسم == اسم_البحث)
                ارجع م
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    # إنشاء مجموعة
    دالة عام انشئ_مجموعة(اسم_مج، وصف، المؤسس)
        متغير مج = جديد مجموعة(اسم_مج، وصف، المؤسس)
        هذا.المجموعات.اضف(مج)
        ارجع مج
    نهاية

    # إرسال رسالة خاصة
    دالة عام ارسل_رسالة(من، الى، نص_الرسالة)
        يتطلب طول(نص_الرسالة) > 0
        متغير ر = جديد رسالة_خاصة(من، الى، نص_الرسالة)
        هذا.الرسائل.اضف(ر)
        الى.التنبيهات.اضف(م"رسالة جديدة من {من.الاسم}")
        ارجع ر
    نهاية

    # إحصائيات الشبكة
    دالة عام احصائيات()
        متغير مجموع_أصدقاء = 0
        متغير مجموع_منشورات = 0
        متغير مجموع_تفاعلات = 0

        لكل م في هذا.المستخدمون
            مجموع_أصدقاء = مجموع_أصدقاء + م.عدد_الاصدقاء()
            لكل من في م.المنشورات
                مجموع_منشورات = مجموع_منشورات + 1
                مجموع_تفاعلات = مجموع_تفاعلات + من.مجموع_التفاعلات()
            نهاية
        نهاية

        اطبع_سطر(م"المستخدمون: {طول(هذا.المستخدمون)}")
        اطبع_سطر(م"المجموعات: {طول(هذا.المجموعات)}")
        اطبع_سطر(م"الرسائل: {طول(هذا.الرسائل)}")
        اطبع_سطر(م"إجمالي الأصدقاء: {مجموع_أصدقاء / 2}")
        اطبع_سطر(م"إجمالي المنشورات: {مجموع_منشورات}")
        اطبع_سطر(م"إجمالي التفاعلات: {مجموع_تفاعلات}")
    نهاية

    # ترتيب المستخدمين حسب الشعبية (bubble sort)
    دالة عام الأكثر_شعبية()
        متغير قائمة = []
        لكل م في هذا.المستخدمون
            قائمة.اضف(م)
        نهاية

        # ترتيب تنازلي حسب عدد الأصدقاء
        متغير ط = طول(قائمة)
        متغير ن = 0
        بينما (ن < ط - 1)
            متغير ي = 0
            بينما (ي < ط - 1 - ن)
                إذا (قائمة[ي].عدد_الاصدقاء() < قائمة[ي + 1].عدد_الاصدقاء())
                    متغير مؤقت = قائمة[ي]
                    قائمة[ي] = قائمة[ي + 1]
                    قائمة[ي + 1] = مؤقت
                نهاية
                ي = ي + 1
            نهاية
            ن = ن + 1
        نهاية

        ارجع قائمة
    نهاية

    # أكثر المنشورات تفاعلاً
    دالة عام اكثر_منشور_تفاعلا()
        متغير اعلى = لاشيء
        متغير اعلى_تفاعل = 0
        لكل م في هذا.المستخدمون
            لكل من في م.المنشورات
                إذا (من.مجموع_التفاعلات() > اعلى_تفاعل)
                    اعلى = من
                    اعلى_تفاعل = من.مجموع_التفاعلات()
                نهاية
            نهاية
        نهاية
        ارجع اعلى
    نهاية
نهاية

