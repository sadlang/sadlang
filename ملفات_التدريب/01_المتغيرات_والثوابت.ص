# ===================================================
# ملف تدريب 01: المتغيرات والثوابت
# لغة ص — Sad Programming Language
# ===================================================
# يغطي هذا الملف:
# - تعريف المتغيرات بـ متغير
# - تعريف الثوابت بـ ثابت
# - أنواع البيانات: رقم، عشري، نص، منطقي
# - استنتاج الأنواع (لا حاجة لذكر النوع)
# - التعيين الصريح للأنواع
# ===================================================

# --- القسم 1: متغيرات بأنواع مستنتجة ---
اطبع_سطر("=== المتغيرات مع استنتاج الأنواع ===")

متغير عدد = 42
متغير اسم = "أحمد"
متغير درجة = 95.5
متغير ناجح = صحيح

اطبع_سطر("العدد: " + عدد)
اطبع_سطر("الاسم: " + اسم)
اطبع_سطر("الدرجة: " + درجة)
اطبع_سطر("ناجح: " + ناجح)

# --- القسم 2: ثوابت ---
اطبع_سطر("=== الثوابت ===")

ثابت باي = 3.14159
ثابت الحد_الأقصى = 100
ثابت رسالة_ترحيب = "مرحباً بالعالم"

اطبع_سطر("باي: " + باي)
اطبع_سطر("الحد الأقصى: " + الحد_الأقصى)
اطبع_سطر(رسالة_ترحيب)

# --- القسم 3: تعيين الأنواع صراحةً ---
اطبع_سطر("=== أنواع صريحة ===")

رقم عمر = 25
عشري معدل = 3.75
نص مدينة = "الرياض"
منطقي موجود = خطأ

اطبع_سطر("العمر: " + عمر)
اطبع_سطر("المعدل: " + معدل)
اطبع_سطر("المدينة: " + مدينة)
اطبع_سطر("موجود: " + موجود)

# --- القسم 4: إعادة التعيين ---
اطبع_سطر("=== إعادة التعيين ===")

متغير قيمة = 10
اطبع_سطر("القيمة الأولى: " + قيمة)
قيمة = 20
اطبع_سطر("القيمة الثانية: " + قيمة)
قيمة = 30
اطبع_سطر("القيمة الثالثة: " + قيمة)

# --- القسم 5: عمليات على المتغيرات ---
اطبع_سطر("=== عمليات على المتغيرات ===")

متغير أ = 10
متغير ب = 20
متغير مجموع = أ + ب
اطبع_سطر("المجموع: " + مجموع)

متغير رسالة = "مرحباً"
متغير تحية = رسالة + " يا " + اسم
اطبع_سطر(تحية)

# --- القسم 6: لاشيء (null) ---
اطبع_سطر("=== لاشيء ===")

متغير قيمة_فارغة = لاشيء
اطبع_سطر("القيمة الفارغة: " + قيمة_فارغة)

# --- القسم 7: أسماء المتغيرات بالإنجليزية ---
اطبع_سطر("=== أسماء إنجليزية ===")

متغير count = 5
متغير name = "Ali"
اطبع_سطر("Count: " + count)
اطبع_سطر("Name: " + name)

اطبع_سطر("=== انتهى ملف المتغيرات ===")
