# --- القسم 1: مطابقة أساسية ---
اطبع_سطر("=== مطابقة أساسية ===")

متغير اليوم = 3

طابق (اليوم)
    عندما 1:
        اطبع_سطر("السبت")
    عندما 2:
        اطبع_سطر("الأحد")
    عندما 3:
        اطبع_سطر("الاثنين")
    عندما 4:
        اطبع_سطر("الثلاثاء")
    عندما 5:
        اطبع_سطر("الأربعاء")
    افتراضي:
        اطبع_سطر("يوم آخر")
نهاية

# --- القسم 2: مطابقة نصوص ---
اطبع_سطر("=== مطابقة نصوص ===")

دالة ترجم_لون(اللون)
    طابق (اللون)
        عندما "أحمر":
            ارجع "Red"
        عندما "أخضر":
            ارجع "Green"
        عندما "أزرق":
            ارجع "Blue"
        افتراضي:
            ارجع "Unknown"
    نهاية
نهاية

اطبع_سطر("أحمر = " + ترجم_لون("أحمر"))
اطبع_سطر("أخضر = " + ترجم_لون("أخضر"))
اطبع_سطر("أصفر = " + ترجم_لون("أصفر"))

# --- القسم 3: مطابقة نطاقات ---
اطبع_سطر("=== مطابقة نطاقات ===")

دالة صنف_العمر(العمر)
    طابق (العمر)
        عندما 0..12:
            ارجع "طفل"
        عندما 13..17:
            ارجع "مراهق"
        عندما 18..64:
            ارجع "بالغ"
        افتراضي:
            ارجع "كبير السن"
    نهاية
نهاية

متغير أعمار = [5، 15، 30، 70]
لكل عمر في أعمار
    اطبع_سطر("العمر " + عمر + ": " + صنف_العمر(عمر))
نهاية

# --- القسم 4: مطابقة بدائل ---
اطبع_سطر("=== مطابقة بدائل ===")

دالة نوع_الحرف(الحرف)
    طابق (الحرف)
        عندما "أ" || "إ" || "و" || "ي":
            ارجع "حرف علة"
        عندما "ب" || "ت" || "ث" || "ج":
            ارجع "حرف ساكن"
        افتراضي:
            ارجع "حرف آخر"
    نهاية
نهاية

اطبع_سطر("أ: " + نوع_الحرف("أ"))
اطبع_سطر("ب: " + نوع_الحرف("ب"))
اطبع_سطر("ك: " + نوع_الحرف("ك"))

# --- القسم 5: طابق مع حسابات ---
اطبع_سطر("=== طابق مع حسابات ===")

دالة تقييم_درجة(الدرجة)
    طابق (الدرجة)
        عندما 90..100:
            ارجع "ممتاز (A)"
        عندما 80..89:
            ارجع "جيد جداً (B)"
        عندما 70..79:
            ارجع "جيد (C)"
        عندما 60..69:
            ارجع "مقبول (D)"
        افتراضي:
            ارجع "راسب (F)"
    نهاية
نهاية

متغير درجات = [95، 82، 73، 65، 45]
لكل درجة في درجات
    اطبع_سطر("الدرجة " + درجة + ": " + تقييم_درجة(درجة))
نهاية

# --- القسم 6: طابق متداخل ---
اطبع_سطر("=== طابق متداخل ===")

دالة وصف_الطقس(الحرارة، المطر)
    متغير الجو = ""
    
    طابق (الحرارة)
        عندما 0..15:
            الجو = "بارد"
        عندما 16..30:
            الجو = "معتدل"
        افتراضي:
            الجو = "حار"
    نهاية
    
    إذا (المطر)
        الجو = الجو + " وممطر"
    وإلا
        الجو = الجو + " وصافي"
    نهاية
    
    ارجع الجو
نهاية

اطبع_سطر("10°، مطر: " + وصف_الطقس(10، صحيح))
اطبع_سطر("25°، صافي: " + وصف_الطقس(25، خطأ))
اطبع_سطر("40°، صافي: " + وصف_الطقس(40، خطأ))

اطبع_سطر("=== انتهى ملف مطابقة الأنماط ===")