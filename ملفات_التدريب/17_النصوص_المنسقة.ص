# ملف تدريب 17: النصوص المنسقة (F-Strings)
# لغة ص — م"..." تسمح بتضمين تعبيرات داخل النصوص

# القسم 1: f-string أساسي
اطبع_سطر("=== نصوص منسقة ===")

متغير الاسم = "أحمد"
متغير العمر = 25

اطبع_سطر(م"مرحباً {الاسم}، عمرك {العمر} سنة")
اطبع_سطر(م"بعد 5 سنوات ستكون {العمر + 5} سنة")

# القسم 2: تعبيرات حسابية
اطبع_سطر("=== تعبيرات حسابية ===")

متغير س = 7
متغير ص = 3

اطبع_سطر(م"{س} + {ص} = {س + ص}")
اطبع_سطر(م"{س} * {ص} = {س * ص}")
اطبع_سطر(م"{س} مربع = {س ** 2}")

# القسم 3: استدعاء دوال
اطبع_سطر("=== استدعاء دوال ===")

دالة تحية(اسم)
    ارجع "مرحباً " + اسم
نهاية

متغير الرسالة = تحية("أحمد")
اطبع_سطر(م"الرسالة: {الرسالة}")

# القسم 4: قوالب عملية
اطبع_سطر("=== قوالب عملية ===")

متغير المنتج = "حاسوب"
متغير السعر = 2500
متغير الكمية = 3

اطبع_سطر(م"المنتج: {المنتج}")
اطبع_سطر(م"السعر: {السعر} ريال")
اطبع_سطر(م"الكمية: {الكمية}")
اطبع_سطر(م"الإجمالي: {السعر * الكمية} ريال")

# القسم 5: مع أصناف
اطبع_سطر("=== مع أصناف ===")

صنف كتاب
    متغير عام العنوان
    متغير عام المؤلف
    متغير عام الصفحات
    
    باني(عنوان، مؤلف، صفحات)
        هذا.العنوان = عنوان
        هذا.المؤلف = مؤلف
        هذا.الصفحات = صفحات
    نهاية
نهاية

متغير ك = جديد كتاب("البرمجة بلغة ص"، "خالد"، 350)
اطبع_سطر(م"الكتاب: {ك.العنوان} بقلم {ك.المؤلف} ({ك.الصفحات} صفحة)")

# القسم 6: مع مصفوفات
اطبع_سطر("=== مع مصفوفات ===")

متغير أرقام = [10، 20، 30، 40، 50]
اطبع_سطر(م"أول عنصر: {أرقام[0]}")
اطبع_سطر(م"آخر عنصر: {أرقام[4]}")
اطبع_سطر(م"عدد العناصر: {أرقام.الطول()}")

# القسم 7: شرطيات
اطبع_سطر("=== شرطيات ===")

متغير نشط = صحيح
متغير حالة = نشط ? "نشط" : "غير نشط"
اطبع_سطر(م"الحالة: {حالة}")

متغير درجة = 85
متغير تقدير = درجة >= 90 ? "ممتاز" : "جيد"
اطبع_سطر(م"الدرجة {درجة}: {تقدير}")

