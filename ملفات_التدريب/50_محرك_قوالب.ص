# ═══════════ صنف: مرشح (Filter) ═══════════
# المرشحات مبنية على الأسماء — كل مرشح يُعرّف بسلوكه عبر طابق

صنف مرشح
    متغير عام الاسم

    باني(اسم)
        هذا.الاسم = اسم
    نهاية

    دالة عام طبق(قيمة)
        طابق (هذا.الاسم)
            عندما "مضاعفة":
                ارجع قيمة * 2
            عندما "مربع":
                ارجع قيمة * قيمة
            عندما "تزيين":
                ارجع م"★ {قيمة} ★"
            عندما "تحية":
                ارجع م"مرحبا يا {قيمة}!"
            عندما "أحرف_كبيرة":
                ارجع قيمة
            عندما "طول":
                ارجع طول(نص(قيمة))
            افتراضي:
                ارجع قيمة
        نهاية
    نهاية
نهاية

# ═══════════ صنف: قطعة_قالب (Template Part) ═══════════

صنف قطعة_قالب
    متغير عام النوع
    متغير عام المحتوى
    متغير عام الاسم_المتغير
    متغير عام المرشحات

    باني(نوع، محتوى)
        هذا.النوع = نوع
        هذا.المحتوى = محتوى
        هذا.الاسم_المتغير = ""
        هذا.المرشحات = []
    نهاية

    دالة عام وصف()
        طابق (هذا.النوع)
            عندما "نص_ثابت":
                ارجع م"نص: '{هذا.المحتوى}'"
            عندما "متغير":
                ارجع م"متغير: {هذا.الاسم_المتغير}"
            افتراضي:
                ارجع م"نوع: {هذا.النوع}"
        نهاية
    نهاية
نهاية

# ═══════════ صنف: سياق (Context) ═══════════

صنف سياق
    متغير خاص _بيانات
    متغير خاص _الأب

    باني()
        هذا._بيانات = {}
        هذا._الأب = لاشيء
    نهاية

    دالة عام عيّن(مفتاح، قيمة)
        يتطلب مفتاح != ""
        هذا._بيانات[مفتاح] = قيمة
    نهاية

    دالة عام احصل(مفتاح)
        إذا (هذا._بيانات[مفتاح] != لاشيء)
            ارجع هذا._بيانات[مفتاح]
        نهاية
        إذا (هذا._الأب != لاشيء)
            ارجع هذا._الأب.احصل(مفتاح)
        نهاية
        ارجع لاشيء
    نهاية

    دالة عام موجود(مفتاح)
        إذا (هذا._بيانات[مفتاح] != لاشيء)
            ارجع صحيح
        نهاية
        إذا (هذا._الأب != لاشيء)
            ارجع هذا._الأب.موجود(مفتاح)
        نهاية
        ارجع خطأ
    نهاية

    دالة عام نطاق_فرعي()
        متغير فرعي = جديد سياق()
        فرعي._الأب = هذا
        ارجع فرعي
    نهاية

    دالة عام المفاتيح()
        متغير مفاتيح = []
        # نجمع المفاتيح المعروفة التي أضافها المستخدم
        ارجع مفاتيح
    نهاية
نهاية

# ═══════════ صنف: محلل_قوالب ═══════════

صنف محلل_قوالب
    متغير خاص _النص
    متغير خاص _الموضع

    باني(نص_قالب)
        إذا (نص_قالب == "")
            ارمي "القالب لا يمكن أن يكون فارغاً"
        نهاية
        هذا._النص = نص_قالب
        هذا._الموضع = 0
    نهاية

    # تحليل القالب إلى قطع
    دالة عام حلل()
        أجّل اطبع_سطر("  📎 انتهى التحليل")
        
        متغير قطع = []
        متغير نص_حالي = ""
        متغير ع = 0
        متغير طول_النص = طول(هذا._النص)

        بينما (ع < طول_النص)
            متغير حرف = هذا._النص[ع]

            # التحقق من بداية متغير {{ ... }}
            إذا (حرف == "{" و ع + 1 < طول_النص و هذا._النص[ع + 1] == "{")
                # حفظ النص الثابت السابق
                إذا (نص_حالي != "")
                    متغير ق_نص = جديد قطعة_قالب("نص_ثابت"، نص_حالي)
                    قطع.اضف(ق_نص)
                    نص_حالي = ""
                نهاية

                # استخراج اسم المتغير
                ع = ع + 2  # تخطي {{
                متغير اسم_متغير = ""
                بينما (ع < طول_النص)
                    إذا (هذا._النص[ع] == "}" و ع + 1 < طول_النص و هذا._النص[ع + 1] == "}")
                        ع = ع + 2  # تخطي }}
                        توقف
                    وإلا
                        اسم_متغير = اسم_متغير + هذا._النص[ع]
                        ع = ع + 1
                    نهاية
                نهاية

                # إنشاء قطعة متغير
                متغير ق_متغير = جديد قطعة_قالب("متغير"، "")
                ق_متغير.الاسم_المتغير = اسم_متغير
                قطع.اضف(ق_متغير)
            وإلا
                نص_حالي = نص_حالي + حرف
                ع = ع + 1
            نهاية
        نهاية

        # النص المتبقي
        إذا (نص_حالي != "")
            متغير ق_أخير = جديد قطعة_قالب("نص_ثابت"، نص_حالي)
            قطع.اضف(ق_أخير)
        نهاية

        ارجع قطع
    نهاية
نهاية

# ═══════════ صنف: مسجل_مرشحات ═══════════

صنف مسجل_مرشحات
    متغير خاص _المرشحات

    باني()
        هذا._المرشحات = {}
    نهاية

    دالة عام سجل(اسم)
        هذا._المرشحات[اسم] = جديد مرشح(اسم)
    نهاية

    دالة عام طبق(اسم، قيمة)
        متغير م = هذا._المرشحات[اسم]
        إذا (م != لاشيء)
            ارجع م.طبق(قيمة)
        نهاية
        ارجع قيمة
    نهاية

    دالة عام موجود(اسم)
        ارجع هذا._المرشحات[اسم] != لاشيء
    نهاية
نهاية

# ═══════════ صنف: محرك_القوالب ═══════════

صنف محرك_القوالب
    متغير خاص _المرشحات
    متغير خاص _عداد

    باني()
        هذا._المرشحات = جديد مسجل_مرشحات()
        هذا._عداد = 0
        # تسجيل مرشحات افتراضية
        هذا._المرشحات.سجل("أحرف_كبيرة")
        هذا._المرشحات.سجل("طول")
    نهاية

    # عرض: تحليل القالب واستبدال المتغيرات
    دالة عام اعرض(نص_قالب، سياق_بيانات)
        يتطلب نص_قالب != ""
        هذا._عداد = هذا._عداد + 1

        متغير محلل = جديد محلل_قوالب(نص_قالب)
        متغير قطع = محلل.حلل()

        متغير نتيجة = ""
        لكل ق في قطع
            إذا (ق.النوع == "نص_ثابت")
                نتيجة = نتيجة + ق.المحتوى
            وإلا
                إذا (ق.النوع == "متغير")
                    متغير اسم = ق.الاسم_المتغير
                    # التحقق من وجود مرشح (اسم|مرشح)
                    متغير قيمة = سياق_بيانات.احصل(اسم)
                    إذا (قيمة != لاشيء)
                        نتيجة = نتيجة + نص(قيمة)
                    وإلا
                        نتيجة = نتيجة + م"[{اسم}؟]"
                    نهاية
                نهاية
            نهاية
        نهاية

        ارجع نتيجة
    نهاية

    # عرض قالب مع مصفوفة (تكرار)
    دالة عام اعرض_قائمة(قالب_عنصر، اسم_المتغير، قائمة، سياق_أب)
        متغير نتائج = []
        لكل عنصر في قائمة
            متغير سياق_فرعي = سياق_أب.نطاق_فرعي()
            سياق_فرعي.عيّن(اسم_المتغير، عنصر)
            متغير نتيجة = هذا.اعرض(قالب_عنصر، سياق_فرعي)
            نتائج.اضف(نتيجة)
        نهاية
        ارجع نتائج
    نهاية

    # عدد القوالب المعالجة
    دالة عام العداد()
        ارجع هذا._عداد
    نهاية

    # الوصول للمرشحات
    دالة عام المرشحات()
        ارجع هذا._المرشحات
    نهاية
نهاية

# ═══════════ طرق الامتداد ═══════════

امتداد محرك_القوالب
    دالة اعرض_فاتورة(بنود، ضريبة)
        متغير نتيجة = "═══════ فاتورة ═══════\n"
        متغير مجموع = 0
        متغير رقم = 1
        لكل بند في بنود
            متغير سعر = بند["سعر"]
            متغير كمية = بند["كمية"]
            متغير إجمالي = سعر * كمية
            مجموع = مجموع + إجمالي
            نتيجة = نتيجة + م"{رقم}. {بند["اسم"]} × {كمية} = {إجمالي}\n"
            رقم = رقم + 1
        نهاية
        متغير قيمة_ضريبة = مجموع * ضريبة / 100
        متغير الإجمالي = مجموع + قيمة_ضريبة
        نتيجة = نتيجة + م"───────────────\n"
        نتيجة = نتيجة + م"المجموع: {مجموع}\n"
        نتيجة = نتيجة + م"الضريبة ({ضريبة}%): {قيمة_ضريبة}\n"
        نتيجة = نتيجة + م"الإجمالي: {الإجمالي}\n"
        نتيجة = نتيجة + "═══════════════════"
        ارجع نتيجة
    نهاية
نهاية

