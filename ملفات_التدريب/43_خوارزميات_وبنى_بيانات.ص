# الجزء 3: خوارزميات البحث
# ═══════════════════════════════════════

# بحث خطي
دالة بحث_خطي(م، قيمة)
    متغير ط = 0
    بينما (ط < طول(م))
        إذا (م[ط] == قيمة)
            ارجع ط
        نهاية
        ط = ط + 1
    نهاية
    ارجع -1
نهاية

# بحث ثنائي (يتطلب مصفوفة مرتبة)
دالة بحث_ثنائي(م، قيمة)
    يتطلب طول(م) > 0
    متغير يسار = 0
    متغير يمين = طول(م) - 1
    بينما (يسار <= يمين)
        متغير فرق = (يمين - يسار) / 2
        متغير وسط = يسار + فرق - (فرق % 1)
        إذا (م[وسط] == قيمة)
            ارجع وسط
        وإلا
            إذا (م[وسط] < قيمة)
                يسار = وسط + 1
            وإلا
                يمين = وسط - 1
            نهاية
        نهاية
    نهاية
    ارجع -1
نهاية

