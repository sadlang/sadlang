        لكل ع في هذا.بيانات
            إذا (دالة_فلتر(ع))
                نتيجة = نتيجة + [ع]
            نهاية
        نهاية
        ارجع جديد مصفوفة_متقدمة(نتيجة)
    نهاية

    # تجميع (reduce)
    دالة عام جمّع(دالة_تجميع، قيمة_أولية)
