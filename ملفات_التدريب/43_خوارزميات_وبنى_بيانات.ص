# دالة تبديل عنصرين في مصفوفة
دالة بدّل(م، أ، ب)
    متغير مؤقت = م[أ]
    م[أ] = م[ب]
    م[ب] = مؤقت
    ارجع م
نهاية

# ترتيب الفقاعات (Bubble Sort)
دالة ترتيب_فقاعي(م)
    متغير ن = طول(م)
    متغير ط = 0
    بينما (ط < ن - 1)
        متغير ج = 0
        بينما (ج < ن - ط - 1)
            إذا (م[ج] > م[ج + 1])
                م = بدّل(م، ج، ج + 1)
            نهاية
            ج = ج + 1
        نهاية
        ط = ط + 1
    نهاية
    ارجع م
نهاية

# ترتيب الاختيار (Selection Sort)
دالة ترتيب_اختيار(م)
    متغير ن = طول(م)
    متغير ط = 0
    بينما (ط < ن - 1)
        متغير أصغر = ط
        متغير ج = ط + 1
        بينما (ج < ن)
            إذا (م[ج] < م[أصغر])
                أصغر = ج
            نهاية
            ج = ج + 1
        نهاية
        إذا (أصغر != ط)
            م = بدّل(م، ط، أصغر)
        نهاية
        ط = ط + 1
    نهاية
    ارجع م
نهاية

# ترتيب الإدراج (Insertion Sort)
دالة ترتيب_إدراج(م)
    متغير ن = طول(م)
    متغير ط = 1
    بينما (ط < ن)
        متغير مفتاح = م[ط]
        متغير ج = ط - 1
        بينما (ج >= 0 و م[ج] > مفتاح)
            م[ج + 1] = م[ج]
            ج = ج - 1
        نهاية
        م[ج + 1] = مفتاح
        ط = ط + 1
    نهاية
    ارجع م
نهاية

