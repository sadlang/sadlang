# هل العدد أولي؟
دالة أولي(ن)
    يتطلب ن > 0
    إذا (ن < 2)
        ارجع خطأ
    نهاية
    إذا (ن == 2)
        ارجع صحيح
    نهاية
    إذا (ن % 2 == 0)
        ارجع خطأ
    نهاية
    متغير ط = 3
    بينما (ط * ط <= ن)
        إذا (ن % ط == 0)
            ارجع خطأ
        نهاية
        ط = ط + 2
    نهاية
    ارجع صحيح
نهاية

# إيجاد الأعداد الأولية حتى ن (غربال بسيط)
دالة أعداد_أولية(حد)
    متغير نتيجة = []
    متغير ن = 2
    بينما (ن <= حد)
        إذا (أولي(ن))
            نتيجة = نتيجة + [ن]
        نهاية
        ن = ن + 1
    نهاية
    ارجع نتيجة
نهاية

# مجموع رقمي
دالة مجموع_أرقام(ن)
    متغير مجموع = 0
    متغير قيمة = ن
    إذا (قيمة < 0)
        قيمة = -قيمة
    نهاية
    بينما (قيمة > 0)
        مجموع = مجموع + (قيمة % 10)
        قيمة = (قيمة - (قيمة % 10)) / 10
    نهاية
    ارجع مجموع
نهاية

