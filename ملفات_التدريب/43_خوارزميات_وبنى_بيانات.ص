# --- المكدس (Stack) ---
صنف مكدس
    متغير خاص عناصر
    متغير خاص الحد_الأقصى

    باني(حد)
        هذا.عناصر = []
        هذا.الحد_الأقصى = حد
    نهاية

    دالة عام ادفع(قيمة)
        إذا (طول(هذا.عناصر) >= هذا.الحد_الأقصى)
            ارمي "المكدس ممتلئ!"
        نهاية
        هذا.عناصر = هذا.عناصر + [قيمة]
    نهاية

    دالة عام اسحب()
        إذا (طول(هذا.عناصر) == 0)
            ارمي "المكدس فارغ!"
        نهاية
        متغير فهرس = طول(هذا.عناصر) - 1
        متغير قيمة = هذا.عناصر[فهرس]
        # بناء مصفوفة جديدة بدون العنصر الأخير
        متغير جديدة = []
        متغير ط = 0
        بينما (ط < فهرس)
            جديدة = جديدة + [هذا.عناصر[ط]]
            ط = ط + 1
        نهاية
        هذا.عناصر = جديدة
        ارجع قيمة
    نهاية

    دالة عام القمة()
        إذا (طول(هذا.عناصر) == 0)
            ارمي "المكدس فارغ!"
        نهاية
        ارجع هذا.عناصر[طول(هذا.عناصر) - 1]
    نهاية

    دالة عام الحجم()
        ارجع طول(هذا.عناصر)
    نهاية

    دالة عام فارغ()
        ارجع طول(هذا.عناصر) == 0
    نهاية

    دالة عام اطبع_المكدس()
        إذا (طول(هذا.عناصر) == 0)
            اطبع_سطر("  [فارغ]")
            ارجع لاشيء
        نهاية
        متغير نتيجة = "  ["
        متغير ط = طول(هذا.عناصر) - 1
        بينما (ط >= 0)
            نتيجة = نتيجة + هذا.عناصر[ط]
            إذا (ط > 0)
                نتيجة = نتيجة + "، "
            نهاية
            ط = ط - 1
        نهاية
        اطبع_سطر(نتيجة + "]")
    نهاية
نهاية

# --- الطابور (Queue) ---
صنف طابور
    متغير خاص عناصر

    باني()
        هذا.عناصر = []
    نهاية

    دالة عام أدخل(قيمة)
        هذا.عناصر = هذا.عناصر + [قيمة]
    نهاية

    دالة عام أخرج()
        إذا (طول(هذا.عناصر) == 0)
            ارمي "الطابور فارغ!"
        نهاية
        متغير قيمة = هذا.عناصر[0]
        متغير جديدة = []
        متغير ط = 1
        بينما (ط < طول(هذا.عناصر))
            جديدة = جديدة + [هذا.عناصر[ط]]
            ط = ط + 1
        نهاية
        هذا.عناصر = جديدة
        ارجع قيمة
    نهاية

    دالة عام الأول()
        إذا (طول(هذا.عناصر) == 0)
            ارمي "الطابور فارغ!"
        نهاية
        ارجع هذا.عناصر[0]
    نهاية

    دالة عام الحجم()
        ارجع طول(هذا.عناصر)
    نهاية

    دالة عام فارغ()
        ارجع طول(هذا.عناصر) == 0
    نهاية
نهاية

