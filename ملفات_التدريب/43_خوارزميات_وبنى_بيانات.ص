# عكس نص
دالة اعكس_نص(نص)
    متغير نتيجة = ""
    متغير ط = طول(نص) - 1
    بينما (ط >= 0)
        نتيجة = نتيجة + نص[ط]
        ط = ط - 1
    نهاية
    ارجع نتيجة
نهاية

# تحقق هل النص متناظر (palindrome)
دالة متناظر(نص)
