# إيجاد أكبر مجموع متصل (Kadane's Algorithm)
دالة أكبر_مجموع_متصل(م)
    يتطلب طول(م) > 0
    متغير أقصى_حالي = م[0]
    متغير أقصى_عام = م[0]
    متغير ط = 1
    بينما (ط < طول(م))
        إذا (أقصى_حالي + م[ط] > م[ط])
            أقصى_حالي = أقصى_حالي + م[ط]
        وإلا
            أقصى_حالي = م[ط]
        نهاية
        إذا (أقصى_حالي > أقصى_عام)
            أقصى_عام = أقصى_حالي
        نهاية
        ط = ط + 1
    نهاية
    ارجع أقصى_عام
نهاية

# إزالة التكرارات من مصفوفة مرتبة
دالة أزل_التكرارات(م)
    إذا (طول(م) <= 1)
        ارجع م
    نهاية
    متغير نتيجة = [م[0]]
    متغير ط = 1
    بينما (ط < طول(م))
        إذا (م[ط] != م[ط - 1])
            نتيجة = نتيجة + [م[ط]]
        نهاية
        ط = ط + 1
    نهاية
    ارجع نتيجة
نهاية

# تقاطع مصفوفتين
دالة تقاطع(م1، م2)
    متغير نتيجة = []
    لكل ع في م1
        متغير وُجد = خطأ
        لكل ع2 في م2
            إذا (ع == ع2)
                وُجد = صحيح
            نهاية
        نهاية
        إذا (وُجد)
            # تحقق أنه غير مكرر في النتيجة
            متغير مكرر = خطأ
            لكل ن في نتيجة
                إذا (ن == ع)
                    مكرر = صحيح
                نهاية
            نهاية
            إذا (ليس مكرر)
                نتيجة = نتيجة + [ع]
            نهاية
        نهاية
    نهاية
    ارجع نتيجة
نهاية

