# ترتيب كائنات باستخدام السمة
دالة ترتيب_كائنات(م)
    متغير ن = طول(م)
    متغير ط = 0
    بينما (ط < ن - 1)
        متغير ج = 0
        بينما (ج < ن - ط - 1)
            إذا (م[ج].المفتاح() > م[ج + 1].المفتاح())
                متغير مؤقت = م[ج]
                م[ج] = م[ج + 1]
