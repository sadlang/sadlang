    نهاية

    # إيجاد عنصر (find)
    دالة عام ابحث(دالة_بحث)
        لكل ع في هذا.بيانات
            إذا (دالة_بحث(ع))
                ارجع ع
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    # هل كل العناصر تحقق الشرط؟
    دالة عام الكل(دالة_شرط)
        لكل ع في هذا.بيانات
            إذا (ليس دالة_شرط(ع))
                ارجع خطأ
            نهاية
        نهاية
        ارجع صحيح
    نهاية

    # هل أي عنصر يحقق الشرط؟
    دالة عام أي_واحد(دالة_شرط)
        لكل ع في هذا.بيانات
            إذا (دالة_شرط(ع))
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    دالة عام الحجم()
        ارجع طول(هذا.بيانات)
    نهاية
نهاية

