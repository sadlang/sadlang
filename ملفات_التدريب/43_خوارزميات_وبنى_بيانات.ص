# الجزء 4: الخوارزميات التكرارية
# ═══════════════════════════════════════

# العاملي (Factorial)
دالة عاملي(ن)
    يتطلب ن >= 0
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * عاملي(ن - 1)
نهاية

# فيبوناتشي (تكراري)
دالة فيبوناتشي(ن)
    يتطلب ن >= 0
    إذا (ن <= 1)
        ارجع ن
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

# فيبوناتشي (حلقي - أسرع)
دالة فيبوناتشي_سريع(ن)
    إذا (ن <= 1)
        ارجع ن
    نهاية
    متغير أ = 0
    متغير ب = 1
    متغير ط = 2
    بينما (ط <= ن)
        متغير مؤقت = أ + ب
        أ = ب
        ب = مؤقت
        ط = ط + 1
    نهاية
    ارجع ب
نهاية

# القوة (Power) — تكراري
دالة قوة(أساس، أس)
    إذا (أس == 0)
        ارجع 1
    نهاية
    إذا (أس % 2 == 0)
        متغير نصف_أس = أس / 2
        نصف_أس = نصف_أس - (نصف_أس % 1)
        متغير نصف = قوة(أساس، نصف_أس)
        ارجع نصف * نصف
    نهاية
    ارجع أساس * قوة(أساس، أس - 1)
نهاية

# القاسم المشترك الأكبر (GCD)
دالة قمأ(أ، ب)
    إذا (ب == 0)
        ارجع أ
    نهاية
    ارجع قمأ(ب، أ % ب)
نهاية

# المضاعف المشترك الأصغر (LCM)
دالة ممأ(أ، ب)
    ارجع (أ * ب) / قمأ(أ، ب)
نهاية

