# ═══════════════════════════════════════════════════════════════════
# الجزء الثاني: صنف الكتاب
# ═══════════════════════════════════════════════════════════════════

صنف كتاب
    متغير عام العنوان
    متغير عام المؤلف
    متغير عام السنة
    متغير عام النوع
    متغير عام متاح

    باني(عنوان، مؤلف، سنة، نوع)
        هذا.العنوان = عنوان
        هذا.المؤلف = مؤلف
        هذا.السنة = سنة
        هذا.النوع = نوع
        هذا.متاح = صحيح
    نهاية

    دالة عام معلومات()
        متغير الحالة = "متاح"
        إذا (ليس هذا.متاح)
            الحالة = "مُعار"
        نهاية
        ارجع هذا.العنوان + " — " + هذا.المؤلف + " (" + هذا.السنة + ") [" + الحالة + "]"
    نهاية

    دالة عام استعارة()
        إذا (هذا.متاح)
            هذا.متاح = خطأ
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة عام إرجاع()
        هذا.متاح = صحيح
    نهاية
نهاية

نفّذ قابل_للوصف لـ كتاب
    دالة وصف()
        ارجع "كتاب: " + هذا.العنوان
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════
# الجزء الثالث: صنف العضو
# ═══════════════════════════════════════════════════════════════════

صنف عضو
    متغير عام الاسم
    متغير عام الرقم
    متغير عام الكتب_المستعارة

    باني(اسم، رقم)
        هذا.الاسم = اسم
        هذا.الرقم = رقم
        هذا.الكتب_المستعارة = []
    نهاية

    دالة عام استعر(كتاب)
        إذا (طول(هذا.الكتب_المستعارة) >= 3)
            ارجع "لا يمكن الاستعارة — الحد الأقصى 3 كتب"
        نهاية

        إذا (كتاب.استعارة())
            هذا.الكتب_المستعارة = هذا.الكتب_المستعارة + [كتاب.العنوان]
            ارجع "تم استعارة: " + كتاب.العنوان
        نهاية
        ارجع "الكتاب غير متاح حالياً"
    نهاية

    دالة عام أرجع(كتاب)
        متغير جديدة = []
        متغير وُجد = خطأ
        لكل ع في هذا.الكتب_المستعارة
            إذا (ع != كتاب.العنوان)
                جديدة = جديدة + [ع]
            وإلا
                وُجد = صحيح
            نهاية
        نهاية
        إذا (وُجد)
            هذا.الكتب_المستعارة = جديدة
            كتاب.إرجاع()
            ارجع "تم إرجاع: " + كتاب.العنوان
        نهاية
        ارجع "هذا الكتاب ليس مستعاراً لك"
    نهاية

    دالة عام حالة()
        إذا (طول(هذا.الكتب_المستعارة) == 0)
            ارجع هذا.الاسم + " — لا كتب مستعارة"
        نهاية
        متغير نتيجة = هذا.الاسم + " — مستعار: "
        متغير أول = صحيح
        لكل عنصر في هذا.الكتب_المستعارة
            إذا (ليس أول)
                نتيجة = نتيجة + "، "
            نهاية
            نتيجة = نتيجة + عنصر
            أول = خطأ
        نهاية
        ارجع نتيجة
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════
# الجزء الرابع: دوال مساعدة
# ═══════════════════════════════════════════════════════════════════

دالة بحث_بالعنوان(كتب، كلمة)
    متغير نتائج = []
    لكل ك في كتب
        # بحث بسيط — هل العنوان يحتوي الكلمة؟
        إذا (ك.العنوان == كلمة)
            نتائج = نتائج + [ك]
        نهاية
    نهاية
    ارجع نتائج
نهاية

دالة بحث_بالنوع(كتب، نوع)
    متغير نتائج = []
    لكل ك في كتب
        إذا (ك.النوع == نوع)
            نتائج = نتائج + [ك]
        نهاية
    نهاية
    ارجع نتائج
نهاية

دالة إحصائيات(كتب)
    متغير إجمالي = طول(كتب)
    متغير متاحة = 0
    متغير مُعارة = 0
    لكل ك في كتب
        إذا (ك.متاح)
            متاحة = متاحة + 1
        وإلا
            مُعارة = مُعارة + 1
        نهاية
    نهاية
    ارجع {"إجمالي": إجمالي، "متاحة": متاحة، "معارة": مُعارة}
نهاية

