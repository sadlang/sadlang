# ملف تدريب 28: برنامج متكامل — نظام إدارة طلاب
# لغة ص — يجمع: أصناف، وراثة، مصفوفات، خرائط، لامدا، أنماط

# === الأصناف الأساسية ===
صنف طالب
    باني(اسم، معرف)
        هذا.اسم = اسم
        هذا.معرف = معرف
        هذا.درجات = {}
    نهاية

    دالة أضف_درجة(مادة، درجة)
        هذا.درجات[مادة] = درجة
    نهاية

    دالة المعدل()
        متغير مفاتيح = هذا.درجات.مفاتيح()
        إذا (طول(مفاتيح) == 0)
            ارجع 0
        نهاية
        متغير مجموع = 0
        لكل مادة في مفاتيح
            مجموع = مجموع + هذا.درجات[مادة]
        نهاية
        ارجع مجموع / طول(مفاتيح)
    نهاية

    دالة التقدير()
        متغير م = هذا.المعدل()
        طابق (م)
            عندما 90..100:
                ارجع "ممتاز"
            عندما 80..90:
                ارجع "جيد جداً"
            عندما 70..80:
                ارجع "جيد"
            عندما 60..70:
                ارجع "مقبول"
            افتراضي:
                ارجع "راسب"
        نهاية
    نهاية

    دالة وصف()
        ارجع م"{هذا.اسم} (#{هذا.معرف}) — المعدل: {هذا.المعدل()} [{هذا.التقدير()}]"
    نهاية
نهاية

# === الفصل الدراسي ===
صنف فصل
    باني(اسم)
        هذا.اسم = اسم
        هذا.طلاب = []
    نهاية

    دالة سجّل(طالب)
        هذا.طلاب.اضف(طالب)
        اطبع_سطر(م"  ✓ تم تسجيل {طالب.اسم} في {هذا.اسم}")
    نهاية

    دالة أعلى_معدل()
        إذا (طول(هذا.طلاب) == 0)
            ارجع لاشيء
        نهاية
        متغير الأفضل = هذا.طلاب[0]
        لكل ط في هذا.طلاب
            إذا (ط.المعدل() > الأفضل.المعدل())
                الأفضل = ط
            نهاية
        نهاية
        ارجع الأفضل
    نهاية

    دالة متوسط_الفصل()
        إذا (طول(هذا.طلاب) == 0)
            ارجع 0
        نهاية
        متغير مجموع = 0
        لكل ط في هذا.طلاب
            مجموع = مجموع + ط.المعدل()
        نهاية
        ارجع مجموع / طول(هذا.طلاب)
    نهاية

    دالة الناجحون()
        متغير نتيجة = []
        لكل ط في هذا.طلاب
            إذا (ط.المعدل() >= 60)
                نتيجة.اضف(ط)
            نهاية
        نهاية
        ارجع نتيجة
    نهاية

    دالة تقرير()
        اطبع_سطر(م"╔═══ تقرير فصل: {هذا.اسم} ═══╗")
        اطبع_سطر(م"عدد الطلاب: {طول(هذا.طلاب)}")
        اطبع_سطر("")
        لكل ط في هذا.طلاب
            اطبع_سطر("  " + ط.وصف())
        نهاية
        اطبع_سطر("")
        اطبع_سطر(م"متوسط الفصل: {هذا.متوسط_الفصل()}")
        متغير أفضل = هذا.أعلى_معدل()
        إذا (أفضل != لاشيء)
            اطبع_سطر(م"أعلى معدل: {أفضل.اسم} ({أفضل.المعدل()})")
        نهاية
        متغير ناجحون = هذا.الناجحون()
        اطبع_سطر(م"عدد الناجحين: {طول(ناجحون)} من {طول(هذا.طلاب)}")
        اطبع_سطر("╚═══════════════════════╝")
    نهاية
نهاية

