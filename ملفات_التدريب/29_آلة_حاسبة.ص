# ملف تدريب 29: برنامج متكامل — آلة حاسبة ذكية
# لغة ص — يجمع: طابق، لامدا، خرائط، حلقات، معالجة أخطاء

# === محرك العمليات ===
صنف آلة_حاسبة
    باني()
        هذا.التاريخ = []
        هذا.الذاكرة = 0
        هذا.العمليات = {
            "جمع": لامدا(أ، ب) => أ + ب،
            "طرح": لامدا(أ، ب) => أ - ب،
            "ضرب": لامدا(أ، ب) => أ * ب،
            "قسمة": لامدا(أ، ب) => أ / ب،
            "باقي": لامدا(أ، ب) => أ % ب،
            "قوة": لامدا(أ، ب) => أ ** ب
        }
    نهاية

    دالة حساب(عملية، أ، ب)
        # التحقق من العملية
        إذا (ليس هذا.العمليات.يحتوي(عملية))
            ارمي م"عملية غير معروفة: {عملية}"
        نهاية

        # التحقق من القسمة على صفر
        إذا (عملية == "قسمة" و ب == 0)
            ارمي "لا يمكن القسمة على صفر"
        نهاية

        متغير الدالة = هذا.العمليات[عملية]
        متغير النتيجة = الدالة(أ، ب)

        # حفظ في التاريخ
        هذا.التاريخ.اضف({
            "عملية": عملية،
            "أ": أ،
            "ب": ب،
            "النتيجة": النتيجة
        })

        ارجع النتيجة
    نهاية

    دالة حفظ_ذاكرة(قيمة)
        هذا.الذاكرة = قيمة
        اطبع_سطر(م"  [ذاكرة] حُفظت: {قيمة}")
    نهاية

    دالة استرجع_ذاكرة()
        ارجع هذا.الذاكرة
    نهاية

    دالة اعرض_التاريخ()
        اطبع_سطر("=== تاريخ العمليات ===")
        متغير ع = 1
        لكل عنصر في هذا.التاريخ
            اطبع_سطر(م"  {ع}. {عنصر["أ"]} {عنصر["عملية"]} {عنصر["ب"]} = {عنصر["النتيجة"]}")
            ع = ع + 1
        نهاية
    نهاية

    دالة مسح_التاريخ()
        هذا.التاريخ = []
        اطبع_سطر("  تم مسح التاريخ")
    نهاية
نهاية

# === دوال مساعدة ===
دالة عاملي(ن)
    يتطلب ن >= 0
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * عاملي(ن - 1)
نهاية

دالة فيبوناتشي(ن)
    يتطلب ن >= 0
    إذا (ن <= 1)
        ارجع ن
    نهاية
    متغير أ = 0
    متغير ب = 1
    متغير ع = 2
    بينما (ع <= ن)
        متغير مؤقت = ب
        ب = أ + ب
        أ = مؤقت
        ع = ع + 1
    نهاية
    ارجع ب
نهاية

دالة أولي(ن)
    إذا (ن < 2)
        ارجع خطأ
    نهاية
    متغير ق = 2
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            ارجع خطأ
        نهاية
        ق = ق + 1
    نهاية
    ارجع صحيح
نهاية

# === البرنامج الرئيسي ===
اطبع_سطر("╔═══════════════════════════╗")
اطبع_سطر("║   آلة حاسبة ذكية بلغة ص   ║")
اطبع_سطر("╚═══════════════════════════╝")

متغير حاسبة = جديد آلة_حاسبة()

# العمليات الأساسية
اطبع_سطر("\n=== العمليات الأساسية ===")
اطبع_سطر(م"100 + 250 = {حاسبة.حساب("جمع"، 100، 250)}")
اطبع_سطر(م"500 - 175 = {حاسبة.حساب("طرح"، 500، 175)}")
اطبع_سطر(م"12 × 15 = {حاسبة.حساب("ضرب"، 12، 15)}")
اطبع_سطر(م"100 ÷ 8 = {حاسبة.حساب("قسمة"، 100، 8)}")
اطبع_سطر(م"17 % 5 = {حاسبة.حساب("باقي"، 17، 5)}")
اطبع_سطر(م"2 ^ 10 = {حاسبة.حساب("قوة"، 2، 10)}")

# معالجة الأخطاء
اطبع_سطر("\n=== معالجة الأخطاء ===")
حاول
