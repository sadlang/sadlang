امسك خطأ
    اطبع_سطر(م"  ✗ خطأ: {خطأ}")
نهاية

# الذاكرة
اطبع_سطر("\n=== الذاكرة ===")
حاسبة.حفظ_ذاكرة(42)
اطبع_سطر(م"  استرجاع: {حاسبة.استرجع_ذاكرة()}")

# دوال رياضية متقدمة
اطبع_سطر("\n=== دوال رياضية ===")
اطبع_سطر(م"5! = {عاملي(5)}")
اطبع_سطر(م"10! = {عاملي(10)}")

اطبع("فيبوناتشي(0..10): ")
لكل ع في 0..10
    اطبع(لنص(فيبوناتشي(ع)) + " ")
نهاية
اطبع_سطر("")

# الأعداد الأولية
اطبع("أعداد أولية 1..30: ")
لكل ع في 1..30
    إذا (أولي(ع))
        اطبع(لنص(ع) + " ")
    نهاية
نهاية
اطبع_سطر("")

# عرض التاريخ
اطبع_سطر("")
حاسبة.اعرض_التاريخ()

اطبع_سطر("\n=== انتهت الآلة الحاسبة ===")
