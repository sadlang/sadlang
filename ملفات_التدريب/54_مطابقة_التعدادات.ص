دالة عرض_رسالة(ر)
    طابق (ر)
        عندما رسالة.نصية(م):
            اطبع_سطر("💬 رسالة نصية: " + م)
        عندما رسالة.صورة(ر، ع، ا):
            اطبع_سطر("🖼️ صورة: " + ر + " (" + ع + "×" + ا + ")")
        عندما رسالة.موقع(عرض، طول):
            اطبع_سطر("📍 موقع: " + عرض + "، " + طول)
        عندما رسالة.إشعار:
            اطبع_سطر("🔔 إشعار بدون محتوى")
        افتراضي:
            اطبع_سطر("❓ رسالة غير معروفة")
    نهاية
نهاية

