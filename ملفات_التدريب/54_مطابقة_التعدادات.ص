تعداد شكل
    دائرة(نصف_القطر)
    مستطيل(عرض، ارتفاع)
    مثلث(قاعدة، ارتفاع)
    نقطة
نهاية

دالة مساحة_الشكل(ش)
    طابق (ش)
        عندما شكل.دائرة(ق):
            ارجع 3.14159 * ق * ق
        عندما شكل.مستطيل(ع، ا):
            ارجع ع * ا
        عندما شكل.مثلث(ق، ا):
            ارجع 0.5 * ق * ا
        عندما شكل.نقطة:
            ارجع 0
        افتراضي:
            ارجع -1
    نهاية
نهاية

دالة وصف_الشكل(ش)
    طابق (ش)
        عندما شكل.دائرة(ق):
            ارجع "دائرة بنصف قطر " + ق
        عندما شكل.مستطيل(ع، ا):
            ارجع "مستطيل " + ع + "×" + ا
        عندما شكل.مثلث(ق، ا):
            ارجع "مثلث بقاعدة " + ق + " وارتفاع " + ا
        عندما شكل.نقطة:
            ارجع "نقطة (بدون مساحة)"
        افتراضي:
            ارجع "شكل غير معروف"
    نهاية
نهاية

متغير أشكال = [
