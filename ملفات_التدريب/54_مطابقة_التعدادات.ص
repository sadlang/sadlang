تعداد نوع_المنتج
    إلكتروني
    غذائي
    ملابس
نهاية

صنف منتج
    متغير عام الاسم
    متغير عام النوع
    متغير عام السعر

    باني(اسم، نوع، سعر)
        هذا.الاسم = اسم
        هذا.النوع = نوع
        هذا.السعر = سعر
    نهاية

    دالة عام وصف()
        متغير فئة = ""
        طابق (هذا.النوع)
            عندما نوع_المنتج.إلكتروني:
                فئة = "📱 إلكتروني"
            عندما نوع_المنتج.غذائي:
                فئة = "🍎 غذائي"
            عندما نوع_المنتج.ملابس:
                فئة = "👕 ملابس"
            افتراضي:
                فئة = "❓ غير مصنف"
        نهاية
        ارجع فئة + " | " + هذا.الاسم + " | " + هذا.السعر + " ر.س"
    نهاية
نهاية

