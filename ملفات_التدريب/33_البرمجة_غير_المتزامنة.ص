# =====================================================

# === دالة غير متزامنة بسيطة ===
دالة غير_متزامن جلب_رسالة()
    ارجع "مرحباً من الدالة غير المتزامنة!"
نهاية

# === استدعاء غير متزامن ===
دالة غير_متزامن عرض_رسالة()
    متغير رسالة = انتظر جلب_رسالة()
    اطبع_سطر(رسالة)
نهاية

اطبع_سطر("=== البرمجة غير المتزامنة ===")
عرض_رسالة()

# === محاكاة جلب بيانات ===
دالة غير_متزامن جلب_بيانات(مصدر)
    # محاكاة تأخير الشبكة
    ارجع "بيانات من " + مصدر
نهاية

دالة غير_متزامن جلب_اسم()
    ارجع "أحمد"
نهاية

دالة غير_متزامن جلب_عمر()
    ارجع 25
نهاية

# === تسلسل عمليات غير متزامنة ===
دالة غير_متزامن معالجة_البيانات()
    اطبع_سطر("")
    اطبع_سطر("=== تسلسل العمليات ===")
    
    متغير اسم = انتظر جلب_اسم()
    متغير عمر = انتظر جلب_عمر()
    متغير بيانات = انتظر جلب_بيانات("الخادم الرئيسي")
    
    اطبع_سطر("  الاسم: " + اسم)
    اطبع_سطر("  العمر: " + عمر)
    اطبع_سطر("  البيانات: " + بيانات)
نهاية

معالجة_البيانات()

# === معالجة أخطاء مع غير متزامن ===
دالة غير_متزامن عملية_قد_تفشل(نجاح)
    إذا (نجاح)
        ارجع "تمت العملية بنجاح"
    وإلا
        ارمي "فشلت العملية!"
    نهاية
نهاية

اطبع_سطر("")
اطبع_سطر("=== معالجة الأخطاء ===")

# عملية ناجحة
حاول
    متغير نتيجة = انتظر عملية_قد_تفشل(صحيح)
    اطبع_سطر("  ✅ " + نتيجة)
امسك خطأ
    اطبع_سطر("  ❌ خطأ: " + خطأ)
نهاية

# عملية فاشلة
حاول
    متغير نتيجة٢ = انتظر عملية_قد_تفشل(خطأ)
    اطبع_سطر("  ✅ " + نتيجة٢)
امسك خطأ
    اطبع_سطر("  ❌ خطأ: " + خطأ)
نهاية

# === نمط المعالج غير المتزامن ===
دالة غير_متزامن خطوة١()
    ارجع 10
نهاية

دالة غير_متزامن خطوة٢(قيمة)
    ارجع قيمة * 2
نهاية

دالة غير_متزامن خطوة٣(قيمة)
    ارجع قيمة + 5
نهاية

دالة غير_متزامن خط_أنابيب()
    اطبع_سطر("")
    اطبع_سطر("=== خط أنابيب غير متزامن ===")
    متغير ن١ = انتظر خطوة١()
    اطبع_سطر("  خطوة 1: " + ن١)
    
    متغير ن٢ = انتظر خطوة٢(ن١)
    اطبع_سطر("  خطوة 2: " + ن٢)
    
    متغير ن٣ = انتظر خطوة٣(ن٢)
    اطبع_سطر("  خطوة 3: " + ن٣)
    
    اطبع_سطر("  النتيجة النهائية: " + ن٣)
نهاية

خط_أنابيب()

اطبع_سطر("")
اطبع_سطر("✅ تم اختبار البرمجة غير المتزامنة بنجاح!")
