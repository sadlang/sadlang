# ===================================================
# ملف تدريب 02: العمليات الحسابية والمنطقية
# لغة ص — Sad Programming Language
# ===================================================
# يغطي هذا الملف:
# - العمليات الحسابية: + - * / % **
# - القسمة الطابقية: //
# - عمليات المقارنة: == != < > <= >=
# - العمليات المنطقية: و، أو، ليس، &&، ||، !
# - عوامل الإسناد المركبة: += -= *= /=
# - عامل العضوية: في
# - العامل الثلاثي: ? :
# - أولوية العمليات
# ===================================================

# --- القسم 1: العمليات الحسابية الأساسية ---
اطبع_سطر("=== العمليات الحسابية ===")

متغير أ = 10
متغير ب = 3

اطبع_سطر("أ = " + أ)
اطبع_سطر("ب = " + ب)

# الجمع
متغير الجمع = أ + ب
اطبع_سطر("أ + ب = " + الجمع)

# الطرح
متغير الطرح = أ - ب
اطبع_سطر("أ - ب = " + الطرح)

# الضرب
متغير الضرب = أ * ب
اطبع_سطر("أ * ب = " + الضرب)

# القسمة
متغير القسمة = أ / ب
اطبع_سطر("أ / ب = " + القسمة)

# باقي القسمة
متغير الباقي = أ % ب
اطبع_سطر("أ % ب = " + الباقي)

# الأس (الرفع لقوة)
متغير القوة = 2 ** 10
اطبع_سطر("2 ** 10 = " + القوة)

# --- القسم 2: القسمة الطابقية ---
اطبع_سطر("=== القسمة الطابقية ===")

متغير ق1 = 7 // 2
اطبع_سطر("7 // 2 = " + ق1)

متغير ق2 = 10 // 3
اطبع_سطر("10 // 3 = " + ق2)

متغير ق3 = 15 // 4
اطبع_سطر("15 // 4 = " + ق3)

# --- القسم 3: عمليات المقارنة ---
اطبع_سطر("=== عمليات المقارنة ===")

متغير س = 10
متغير ع = 20

اطبع_سطر("س == ع: " + (س == ع))
اطبع_سطر("س != ع: " + (س != ع))
اطبع_سطر("س < ع: " + (س < ع))
اطبع_سطر("س > ع: " + (س > ع))
اطبع_سطر("س <= 10: " + (س <= 10))
اطبع_سطر("ع >= 20: " + (ع >= 20))

# --- القسم 4: العمليات المنطقية ---
اطبع_سطر("=== العمليات المنطقية ===")

متغير ش1 = صحيح
متغير ش2 = خطأ

# باستخدام الكلمات العربية
اطبع_سطر("صحيح و خطأ: " + (ش1 و ش2))
اطبع_سطر("صحيح أو خطأ: " + (ش1 أو ش2))
اطبع_سطر("ليس صحيح: " + (ليس ش1))

# باستخدام الرموز
اطبع_سطر("صحيح && خطأ: " + (ش1 && ش2))
اطبع_سطر("صحيح || خطأ: " + (ش1 || ش2))
اطبع_سطر("!صحيح: " + (!ش1))

# --- القسم 5: عوامل الإسناد المركبة ---
اطبع_سطر("=== الإسناد المركب ===")

متغير قيمة = 100
اطبع_سطر("القيمة الأولية: " + قيمة)

قيمة += 10
اطبع_سطر("بعد += 10: " + قيمة)

قيمة -= 30
اطبع_سطر("بعد -= 30: " + قيمة)

قيمة *= 2
اطبع_سطر("بعد *= 2: " + قيمة)

قيمة /= 4
اطبع_سطر("بعد /= 4: " + قيمة)

# --- القسم 6: عامل العضوية ---
اطبع_سطر("=== عامل العضوية (في) ===")

متغير قائمة = [1, 2, 3, 4, 5]
اطبع_سطر("3 في القائمة: " + (3 في قائمة))
اطبع_سطر("9 في القائمة: " + (9 في قائمة))

# --- القسم 7: العامل الثلاثي ---
اطبع_سطر("=== العامل الثلاثي ===")

متغير عمر = 18
متغير حالة_العمر = عمر >= 18 ? "بالغ" : "قاصر"
اطبع_سطر("العمر " + عمر + ": " + حالة_العمر)

متغير عمر2 = 12
متغير حالة2 = عمر2 >= 18 ? "بالغ" : "قاصر"
اطبع_سطر("العمر " + عمر2 + ": " + حالة2)

# --- القسم 8: أولوية العمليات ---
اطبع_سطر("=== أولوية العمليات ===")

# الأس قبل الضرب
متغير ن1 = 2 + 3 * 4
اطبع_سطر("2 + 3 * 4 = " + ن1)

# الأقواس تغير الأولوية
متغير ن2 = (2 + 3) * 4
اطبع_سطر("(2 + 3) * 4 = " + ن2)

متغير ن3 = 2 ** 3 + 1
اطبع_سطر("2 ** 3 + 1 = " + ن3)

# --- القسم 9: عمليات على الأعداد العشرية ---
اطبع_سطر("=== أعداد عشرية ===")

متغير ف1 = 3.14
متغير ف2 = 2.71
اطبع_سطر("3.14 + 2.71 = " + (ف1 + ف2))
اطبع_سطر("3.14 * 2 = " + (ف1 * 2))

# --- القسم 10: دمج النصوص بـ + ---
اطبع_سطر("=== دمج النصوص ===")

متغير الاسم = "أحمد"
متغير المدينة = "الرياض"
متغير جملة = "مرحباً يا " + الاسم + " من " + المدينة
اطبع_سطر(جملة)

اطبع_سطر("=== انتهى ملف العمليات ===")
