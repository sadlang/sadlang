# بحث بالقسم
اطبع_سطر("")
اطبع_سطر("=== موظفو الهندسة ===")
متغير فريق_هندسة = نظام.بحث_بالقسم("هندسة")
لكل م في فريق_هندسة
    م.اطبع_نفسك()
نهاية

# زيادة رواتب
اطبع_سطر("")
اطبع_سطر("=== زيادة الرواتب ===")
ع١.زيادة_راتب(10)
ع٢.زيادة_راتب(15)

# بحث بالاسم
اطبع_سطر("")
اطبع_سطر("=== بحث عن نورة ===")
متغير نتيجة = نظام.بحث_بالاسم("نورة")
إذا (نتيجة != لاشيء)
    نتيجة.اطبع_نفسك()
وإلا
