اطبع_سطر("  عدد الموظفين: " + نظام.العدد())
اطبع_سطر("  إجمالي الرواتب: " + نظام.إجمالي_الرواتب() + " ريال")
اطبع_سطر("  متوسط الراتب: " + نظام.متوسط_الراتب() + " ريال")

متغير الأعلى = نظام.الأعلى_راتباً()
