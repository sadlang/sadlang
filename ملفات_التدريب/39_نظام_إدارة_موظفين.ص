#        مطابقة أنماط، عقود، معالجة أخطاء
# =====================================================

# === السمات ===
سمة قابل_للطباعة
    دالة اطبع_نفسك()
نهاية

# === ماكرو للتسجيل ===
ماكرو سجل(مستوى، رسالة)
    اطبع_سطر("[" + مستوى + "] " + رسالة)
نهاية

# === تعداد الأقسام ===
تعداد قسم
    هندسة
    تسويق
    مبيعات
    موارد_بشرية
    تقنية
نهاية

# === صنف الموظف الأساسي ===
صنف موظف
    نفّذ قابل_للطباعة
    
    باني(اسم، رقم، قسم، راتب)
        يتطلب راتب > 0
        هذا.الاسم = اسم
        هذا.الرقم = رقم
        هذا.القسم = قسم
        هذا.الراتب = راتب
        هذا.نشط = صحيح
    نهاية
    
    دالة اطبع_نفسك()
        اطبع_سطر("  [" + هذا.الرقم + "] " + هذا.الاسم + " — " + هذا.القسم + " — " + هذا.الراتب + " ريال")
    نهاية
    
    دالة زيادة_راتب(نسبة)
        يتطلب نسبة > 0
        يتطلب نسبة <= 50
        متغير زيادة = هذا.الراتب * نسبة / 100
        هذا.الراتب = هذا.الراتب + زيادة
        سجل!("INFO"، "زيادة راتب " + هذا.الاسم + " بمقدار " + زيادة)
    نهاية
نهاية

# === مدير يرث من موظف ===
صنف مدير يرث موظف
    باني(اسم، رقم، قسم، راتب)
        الأساس(اسم، رقم، قسم، راتب)
        هذا.فريق = []
    نهاية
    
    دالة اضف_عضو(موظف)
        هذا.فريق.اضف(موظف)
        سجل!("INFO"، "إضافة " + موظف.الاسم + " لفريق " + هذا.الاسم)
    نهاية
    
    دالة حجم_الفريق()
        ارجع طول(هذا.فريق)
    نهاية
    
    دالة اطبع_نفسك()
        اطبع_سطر("  👔 [" + هذا.الرقم + "] " + هذا.الاسم + " (مدير) — " + هذا.القسم + " — " + هذا.الراتب + " ريال (فريق: " + هذا.حجم_الفريق() + ")")
    نهاية
نهاية

# === نظام إدارة الموظفين ===
صنف نظام_موظفين
    باني()
        هذا.الموظفون = []
    نهاية
    
    دالة اضف(موظف)
        هذا.الموظفون.اضف(موظف)
    نهاية
    
    دالة العدد()
        ارجع طول(هذا.الموظفون)
    نهاية
    
    دالة بحث_بالاسم(اسم)
        لكل م في هذا.الموظفون
            إذا (م.الاسم == اسم)
                ارجع م
            نهاية
        نهاية
        ارجع لاشيء
    نهاية
    
    دالة بحث_بالقسم(قسم)
        متغير نتائج = []
        لكل م في هذا.الموظفون
            إذا (م.القسم == قسم)
                نتائج.اضف(م)
            نهاية
        نهاية
        ارجع نتائج
    نهاية
    
    دالة إجمالي_الرواتب()
        متغير مجموع = 0
        لكل م في هذا.الموظفون
            مجموع = مجموع + م.الراتب
        نهاية
        ارجع مجموع
    نهاية
    
    دالة متوسط_الراتب()
        إذا (هذا.العدد() == 0)
            ارجع 0
        نهاية
        ارجع هذا.إجمالي_الرواتب() / هذا.العدد()
    نهاية
    
    دالة الأعلى_راتباً()
        متغير أعلى = لاشيء
        متغير أعلى_راتب = 0
        لكل م في هذا.الموظفون
            إذا (م.الراتب > أعلى_راتب)
                أعلى_راتب = م.الراتب
                أعلى = م
            نهاية
        نهاية
        ارجع أعلى
    نهاية
    
    دالة عرض_الكل()
        لكل م في هذا.الموظفون
            م.اطبع_نفسك()
        نهاية
    نهاية
نهاية

# === البرنامج الرئيسي ===
اطبع_سطر("╔══════════════════════════════════════╗")
اطبع_سطر("║      نظام إدارة الموظفين            ║")
اطبع_سطر("╚══════════════════════════════════════╝")

