# القسم 1: اختبارات بسيطة
اطبع_سطر("=== الاختبارات البسيطة ===")

اختبر("جمع عددين")
    إذا (3 + 5 != 8)
        ارمي "3 + 5 يجب أن يساوي 8"
    نهاية
نهاية

اختبر("ضرب عددين")
    إذا (4 * 7 != 28)
        ارمي "4 * 7 يجب أن يساوي 28"
    نهاية
نهاية

اختبر("مقارنة نصوص")
    متغير نص = "مرحبا"
    إذا (نص != "مرحبا")
        ارمي "النص لا يتطابق"
    نهاية
نهاية

# القسم 2: اختبار خصائص (Property Testing)
اطبع_سطر("=== اختبار الخصائص ===")

اختبر("خاصية الجمع التبادلي") تكرارات 50 بذرة 42
    متغير أ = _تكرار + 1
    متغير ب = _تكرار * 3
    إذا (أ + ب != ب + أ)
        ارمي "الجمع ليس تبادلياً!"
    نهاية
نهاية

اختبر("خاصية الضرب بصفر") تكرارات 20 بذرة 7
    متغير ن = _تكرار * 5 + 1
    إذا (ن * 0 != 0)
        ارمي "أي عدد × 0 يجب أن يساوي 0"
    نهاية
نهاية

# القسم 3: اختبار مع المتغيرات العشوائية
اطبع_سطر("=== المتغيرات العشوائية ===")

اختبر("الأعداد العشوائية في النطاق") تكرارات 30 بذرة 99
    # _عشوائي_صحيح: عدد صحيح 0..999
    إذا (_عشوائي_صحيح < 0 أو _عشوائي_صحيح > 999)
        ارمي "خارج النطاق!"
    نهاية
نهاية

اختبر("متغيرات التكرار") تكرارات 5 بذرة 1
    # _تكرار: فهرس (0..N-1)
    # _التكرار_الحالي: رقم (1..N)
    # _إجمالي_التكرارات: المجموع
    إذا (_التكرار_الحالي != _تكرار + 1)
        ارمي "فرق بين التكرار والتكرار الحالي"
    نهاية
    إذا (_إجمالي_التكرارات != 5)
        ارمي "الإجمالي يجب أن يكون 5"
    نهاية
نهاية

# القسم 4: العقود البرمجية — يتطلب (Preconditions)
اطبع_سطر("=== العقود البرمجية ===")

دالة قسمة(أ، ب)
    يتطلب ب != 0
    ارجع أ / ب
نهاية

اطبع_سطر("قسمة(10, 2) = " + قسمة(10، 2))

# التقاط فشل العقد
حاول
    قسمة(5، 0)
امسك خطأ
    اطبع_سطر("فشل العقد (متوقع): تم التقاطه")
نهاية

# القسم 5: عقد يتطلب متعدد
دالة سحب(رصيد، مبلغ)
    يتطلب مبلغ > 0
    يتطلب مبلغ <= رصيد
    ارجع رصيد - مبلغ
نهاية

اطبع_سطر("سحب(1000, 300) = " + سحب(1000، 300))

حاول
    سحب(100، 500)
امسك خطأ
    اطبع_سطر("فشل: المبلغ أكبر من الرصيد (متوقع)")
نهاية

# القسم 6: العقد يضمن (Postconditions)
دالة قيمة_مطلقة(ن)
    يضمن النتيجة >= 0
    إذا (ن < 0)
        ارجع ن * -1
    نهاية
    ارجع ن
نهاية

اطبع_سطر("قيمة_مطلقة(-15) = " + قيمة_مطلقة(-15))
اطبع_سطر("قيمة_مطلقة(7) = " + قيمة_مطلقة(7))

# القسم 7: عقد مع يتطلب ويضمن معاً
دالة مساحة(عرض، ارتفاع)
    يتطلب عرض > 0
    يتطلب ارتفاع > 0
    يضمن النتيجة > 0
    ارجع عرض * ارتفاع
نهاية

اطبع_سطر("مساحة(5, 3) = " + مساحة(5، 3))

# القسم 8: قيود الأنواع (Where Constraints)
اطبع_سطر("=== قيود الأنواع ===")

دالة مضاعفة(أ)
    حيث ت: رقمي
    ارجع أ * 2
نهاية

اطبع_سطر("مضاعفة(15) = " + مضاعفة(15))
اطبع_سطر("مضاعفة(3.5) = " + مضاعفة(3.5))

# فشل القيد على نص
حاول
    مضاعفة("نص")
امسك خطأ
    اطبع_سطر("فشل قيد نوع (متوقع): معامل غير رقمي")
نهاية

# قيد قابل_للمقارنة
دالة الأكبر(أ، ب)
    حيث ت: قابل_للمقارنة
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

