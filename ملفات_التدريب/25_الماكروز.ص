# ملف تدريب 25: الماكروز (Macros)
# لغة ص — إنشاء أدوات إعادة استخدام خفيفة

# القسم 1: ماكرو بسيط
اطبع_سطر("=== ماكرو بسيط ===")

ماكرو سجّل(رسالة)
    اطبع_سطر("[سجل] " + رسالة)
نهاية

سجّل!("بدء البرنامج")
سجّل!("جاري التنفيذ...")
سجّل!("انتهى بنجاح")

# القسم 2: ماكرو تعبيري (يُرجع قيمة)
اطبع_سطر("=== ماكرو تعبيري ===")

ماكرو أكبر(أ، ب)
    إذا (أ > ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

اطبع_سطر("أكبر(10, 25) = " + أكبر!(10، 25))
اطبع_سطر("أكبر(99, 7) = " + أكبر!(99، 7))

ماكرو أصغر(أ، ب)
    إذا (أ < ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

اطبع_سطر("أصغر(10, 25) = " + أصغر!(10، 25))

# القسم 3: ماكرو بمعاملات متغيرة
اطبع_سطر("=== معاملات متغيرة ===")

ماكرو سجّل_الكل(...رسائل)
    لكل ر في رسائل
        اطبع_سطر("  → " + ر)
    نهاية
نهاية

اطبع_سطر("رسائل متعددة:")
سجّل_الكل!("رسالة أولى"، "رسالة ثانية"، "رسالة ثالثة")

# القسم 4: ماكرو بمعاملات ثابتة + متغيرة
اطبع_سطر("=== مستوى + رسائل ===")

ماكرو سجّل_بمستوى(مستوى، ...رسائل)
    لكل ر في رسائل
        اطبع_سطر("[" + مستوى + "] " + ر)
    نهاية
نهاية

سجّل_بمستوى!("معلومات"، "بدأ الخادم"، "جاهز للطلبات")
سجّل_بمستوى!("تحذير"، "الذاكرة منخفضة")
سجّل_بمستوى!("خطأ"، "فشل الاتصال"، "إعادة المحاولة")

# القسم 5: ماكرو لمقاييس الأداء
اطبع_سطر("=== ماكرو عملي ===")

ماكرو كرر(عدد، عمل)
    متغير ع = 0
    بينما (ع < عدد)
        عمل
        ع = ع + 1
    نهاية
نهاية

متغير مجموع = 0
كرر!(5، مجموع = مجموع + 10)
اطبع_سطر("بعد 5 تكرارات (+10): " + مجموع)

# القسم 6: ماكرو مع شروط
اطبع_سطر("=== ماكرو شرطي ===")

ماكرو تحقق(شرط، رسالة)
    إذا (ليس شرط)
        اطبع_سطر("✗ فشل: " + رسالة)
    وإلا
        اطبع_سطر("✓ نجح: " + رسالة)
    نهاية
نهاية

تحقق!(3 + 5 == 8، "الجمع صحيح")
تحقق!(10 > 5، "المقارنة صحيحة")
تحقق!(طول("مرحبا") == 5، "طول النص")

# القسم 7: أمان النطاق (Hygiene)
اطبع_سطر("=== أمان النطاق ===")

# متغيرات الماكرو لا تلوث النطاق الخارجي
متغير نتيجة_خارج = "أصلي"
ماكرو اختبر_نطاق()
    متغير نتيجة_خارج = "من الماكرو"
    ارجع نتيجة_خارج
نهاية

متغير قيمة = اختبر_نطاق!()
اطبع_سطر("النطاق الخارجي: " + نتيجة_خارج)
اطبع_سطر("قيمة الماكرو: " + قيمة)

اطبع_سطر("=== انتهى ملف الماكروز ===")
