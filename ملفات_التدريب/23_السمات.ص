# القسم 2: سمة مع عدة أصناف
اطبع_سطر("=== سمة مشتركة ===")

سمة قابل_للحساب
    دالة المساحة()
    دالة المحيط()
نهاية

صنف دائرة
    باني(نصف_القطر)
        هذا.نصف_القطر = نصف_القطر
    نهاية
نهاية

نفّذ قابل_للحساب لـ دائرة
    دالة المساحة()
        ارجع 3.14159 * هذا.نصف_القطر ** 2
    نهاية
    
    دالة المحيط()
        ارجع 2 * 3.14159 * هذا.نصف_القطر
    نهاية
نهاية

صنف مربع
    باني(ضلع)
        هذا.ضلع = ضلع
    نهاية
نهاية

نفّذ قابل_للحساب لـ مربع
    دالة المساحة()
        ارجع هذا.ضلع ** 2
    نهاية
    
    دالة المحيط()
        ارجع 4 * هذا.ضلع
    نهاية
نهاية

