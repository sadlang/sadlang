# الجزء 10: نظام المنتج-المستهلك
# ═══════════════════════════════════════

عنوان!("نمط المنتج-المستهلك")

صنف منتج
    متغير خاص الاسم
    متغير خاص القناة

    باني(اسم، قناة)
        هذا.الاسم = اسم
        هذا.القناة = قناة
    نهاية

    دالة عام أنتج(عدد)
        متغير ط = 1
        بينما (ط <= عدد)
            متغير منتَج = هذا.الاسم + "_منتج_" + ط
            هذا.القناة.أرسل(منتَج)
            ط = ط + 1
        نهاية
    نهاية
نهاية

صنف مستهلك
    متغير خاص الاسم
    متغير خاص القناة
    متغير عام المستهلَكات

    باني(اسم، قناة)
        هذا.الاسم = اسم
        هذا.القناة = قناة
        هذا.المستهلَكات = []
    نهاية

    دالة عام استهلك(عدد)
        متغير ط = 0
        بينما (ط < عدد)
            متغير عنصر = هذا.القناة.استقبل()
            هذا.المستهلَكات = هذا.المستهلَكات + [عنصر]
            ط = ط + 1
        نهاية
    نهاية
نهاية

متغير قناة_إنتاج = قناة(20)

متغير م1 = جديد منتج("مصنع_أ"، قناة_إنتاج)
