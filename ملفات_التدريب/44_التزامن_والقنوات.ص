متغير مستقبل_ب = مستقبل()
متغير مستقبل_ج = مستقبل()

أطلق
    # حسابات مختلفة
    متغير مجموع = 0
    متغير ط = 1
    بينما (ط <= 50)
        مجموع = مجموع + ط
        ط = ط + 1
    نهاية
    مستقبل_أ.عيّن(مجموع)
نهاية

أطلق
    متغير حاصل = 1
    متغير ط = 1
    بينما (ط <= 10)
        حاصل = حاصل * ط
        ط = ط + 1
    نهاية
    مستقبل_ب.عيّن(حاصل)
نهاية

أطلق
    # إيجاد عدد أولي
    متغير ن = 97
    متغير أولي = صحيح
    متغير ط = 2
    بينما (ط * ط <= ن)
        إذا (ن % ط == 0)
            أولي = خطأ
        نهاية
        ط = ط + 1
    نهاية
    مستقبل_ج.عيّن(أولي)
نهاية

# جمع النتائج
اطبع_سطر("  مجموع 1..50: " + مستقبل_أ.احصل())
اطبع_سطر("  10!: " + مستقبل_ب.احصل())
اطبع_سطر("  97 أولي؟ " + مستقبل_ج.احصل())

