# الجزء 12: نظام كامل — معالج مهام متوازي
# ═══════════════════════════════════════

عنوان!("معالج المهام المتوازي")

تعداد أولوية_مهمة
    عاجلة
    عادية
    منخفضة
نهاية

صنف مهمة
    متغير عام المعرف
    متغير عام الوصف
    متغير عام الأولوية
    متغير عام النتيجة

    باني(معرف، وصف، أولوية)
        هذا.المعرف = معرف
        هذا.الوصف = وصف
        هذا.الأولوية = أولوية
        هذا.النتيجة = لاشيء
    نهاية

    دالة عام نفّذ()
        # محاكاة تنفيذ المهمة
        هذا.النتيجة = "مكتمل: " + هذا.الوصف
        ارجع هذا.النتيجة
    نهاية

    دالة عام معلومات()
        متغير وصف_أولوية = "عادية"
        طابق (هذا.الأولوية)
            عندما "عاجلة":
                وصف_أولوية = "🔴 عاجلة"
            عندما "عادية":
                وصف_أولوية = "🟡 عادية"
            عندما "منخفضة":
                وصف_أولوية = "🟢 منخفضة"
        نهاية
        ارجع "[" + هذا.المعرف + "] " + هذا.الوصف + " (" + وصف_أولوية + ")"
    نهاية
نهاية

صنف معالج_مهام
    متغير خاص القناة
    متغير خاص قناة_النتائج
    متغير خاص عدد_العمال

    باني(عدد_عمال)
        هذا.القناة = قناة(50)
        هذا.قناة_النتائج = قناة(50)
        هذا.عدد_العمال = عدد_عمال
    نهاية

    دالة عام أضف_مهمة(مهمة)
        هذا.القناة.أرسل(مهمة)
    نهاية

    دالة عام نفّذ_الكل(عدد_مهام)
        # إطلاق العمال
        متغير مجموعة = مجموعة_انتظار()
        مجموعة.أضف(عدد_مهام)

        متغير ط = 0
        بينما (ط < عدد_مهام)
            متغير م = هذا.القناة.استقبل()
            متغير ق_ن = هذا.قناة_النتائج
            أطلق
                متغير نتيجة = م.نفّذ()
                ق_ن.أرسل(م)
                مجموعة.أنهي()
            نهاية
            ط = ط + 1
        نهاية

        مجموعة.انتظر()
    نهاية

    دالة عام اجمع_النتائج(عدد)
        متغير نتائج = []
        متغير ط = 0
        بينما (ط < عدد)
            متغير م = هذا.قناة_النتائج.استقبل()
            نتائج = نتائج + [م]
            ط = ط + 1
        نهاية
        ارجع نتائج
    نهاية
نهاية

# إنشاء معالج بـ 3 عمال
