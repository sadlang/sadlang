        متغير إحصاء = هذا._الجذر.إحصائيات_الامتدادات()
        اطبع_سطر("  توزيع الامتدادات:")
        # عرض الإحصاء
        متغير مفاتيح = ["ص"، "txt"، "md"، "json"، "csv"، "png"، "exe"]
