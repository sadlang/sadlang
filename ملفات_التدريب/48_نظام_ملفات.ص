# ═══════════ طرق الامتداد ═══════════

امتداد مجلد_نظام
    دالة أكبر_ملف()
        متغير ملفات = هذا.كل_الملفات()
        متغير أكبر = لاشيء
        متغير أعلى = 0
        لكل م في ملفات
            إذا (م.الحجم() > أعلى)
                أعلى = م.الحجم()
                أكبر = م
            نهاية
        نهاية
        ارجع أكبر
    نهاية

    دالة إحصائيات_الامتدادات()
        متغير ملفات = هذا.كل_الملفات()
        متغير إحصاء = {}
        لكل م في ملفات
            متغير ام = م.الامتداد
            إذا (إحصاء[ام] == لاشيء)
                إحصاء[ام] = 0
            نهاية
            إحصاء[ام] = إحصاء[ام] + 1
        نهاية
        ارجع إحصاء
    نهاية
نهاية

