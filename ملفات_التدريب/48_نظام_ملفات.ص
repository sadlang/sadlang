            نهاية
        نهاية

        متغير أكبر = هذا._الجذر.أكبر_ملف()
        إذا (أكبر != لاشيء)
            اطبع_سطر(م"  أكبر ملف: {أكبر.الاسم} ({حجم_مقروء!(أكبر.الحجم())})")
        نهاية
    نهاية
نهاية

# ═══════════ دوال مساعدة ═══════════

دالة انشئ_ملف(اسم، امتداد، محتوى)
    متغير م = جديد ملف_نظام(اسم، امتداد)
    م.عيّن_صلاحية("كامل")
    م.اكتب(محتوى)
    ارجع م
نهاية

دالة ترتيب_ملفات_بالحجم(ملفات)
    # ترتيب فقاعي تنازلي بالحجم
    متغير ن = طول(ملفات)
    متغير ع = 0
    بينما (ع < ن - 1)
        متغير ج = 0
        بينما (ج < ن - ع - 1)
            إذا (ملفات[ج].الحجم() < ملفات[ج + 1].الحجم())
                متغير مؤقت = ملفات[ج]
                ملفات[ج] = ملفات[ج + 1]
                ملفات[ج + 1] = مؤقت
            نهاية
            ج = ج + 1
        نهاية
        ع = ع + 1
    نهاية
    ارجع ملفات
نهاية

