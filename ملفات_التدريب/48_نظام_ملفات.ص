# ═══════════ الصنف الأساسي: عنصر_نظام ═══════════

صنف عنصر_نظام
    متغير عام الاسم
    متغير عام النوع
    متغير عام الأب
    متغير عام الصلاحية
    متغير خاص _التاريخ

    باني(اسم، نوع)
        هذا.الاسم = اسم
        هذا.النوع = نوع
        هذا.الأب = لاشيء
        هذا.الصلاحية = "قراءة"
        هذا._التاريخ = "2024-01-01"
    نهاية

    دالة عام المسار()
        إذا (هذا.الأب == لاشيء)
            ارجع "/" + هذا.الاسم
        نهاية
        متغير مسار_الأب = هذا.الأب.المسار()
        إذا (مسار_الأب == "/")
            ارجع "/" + هذا.الاسم
        نهاية
        ارجع مسار_الأب + "/" + هذا.الاسم
    نهاية

    دالة عام عيّن_صلاحية(صلاحية)
        هذا.الصلاحية = صلاحية
    نهاية

    دالة عام يطابق(نمط)
        # بحث بسيط بالاسم
        ارجع هذا.الاسم == نمط
    نهاية

    دالة عام ملخص()
        ارجع م"[{هذا.النوع}] {هذا.الاسم}"
    نهاية
نهاية

# ═══════════ صنف: ملف ═══════════

صنف ملف_نظام يرث عنصر_نظام
    متغير عام الامتداد
    متغير عام المحتوى
    متغير خاص _الحجم

    باني(اسم، امتداد)
        الأساس(اسم + "." + امتداد، "ملف")
        هذا.الامتداد = امتداد
        هذا.المحتوى = ""
        هذا._الحجم = 0
    نهاية

    دالة عام اكتب(محتوى)
        يتطلب هذا.الصلاحية == "كتابة" أو هذا.الصلاحية == "كامل"
        هذا.المحتوى = محتوى
        هذا._الحجم = طول(محتوى)
    نهاية

    دالة عام الحق(محتوى)
        يتطلب هذا.الصلاحية == "كتابة" أو هذا.الصلاحية == "كامل"
        هذا.المحتوى = هذا.المحتوى + محتوى
        هذا._الحجم = طول(هذا.المحتوى)
    نهاية

    دالة عام اقرأ()
        يتطلب هذا.الصلاحية != "تنفيذ"
        ارجع هذا.المحتوى
    نهاية

    دالة عام الحجم()
        ارجع هذا._الحجم
    نهاية

    دالة عام نوع_الملف()
        طابق (هذا.الامتداد)
            عندما "ص":
                ارجع "كود مصدري (لغة ص)"
            عندما "txt":
                ارجع "نص عادي"
            عندما "md":
                ارجع "وثيقة Markdown"
            عندما "json":
                ارجع "بيانات JSON"
            عندما "csv":
                ارجع "جدول CSV"
            عندما "png":
                ارجع "صورة PNG"
            عندما "exe":
                ارجع "تطبيق تنفيذي"
            افتراضي:
                ارجع "ملف " + هذا.الامتداد
        نهاية
    نهاية

    دالة عام ملخص()
        ارجع م"📄 {هذا.الاسم} ({حجم_مقروء!(هذا._الحجم)}) [{هذا.نوع_الملف()}]"
    نهاية
نهاية

# ═══════════ صنف: مجلد ═══════════

صنف مجلد_نظام يرث عنصر_نظام
    متغير خاص _المحتويات

    باني(اسم)
        الأساس(اسم، "مجلد")
        هذا._المحتويات = []
    نهاية

    دالة عام اضف(عنصر)
        عنصر.الأب = هذا
        هذا._المحتويات.اضف(عنصر)
    نهاية

    دالة عام احذف(اسم)
        متغير جديدة = []
        لكل ع في هذا._المحتويات
            إذا (ع.الاسم != اسم)
                جديدة.اضف(ع)
            نهاية
        نهاية
        هذا._المحتويات = جديدة
    نهاية

    دالة عام المحتويات()
        ارجع هذا._المحتويات
    نهاية

    دالة عام عدد_العناصر()
        ارجع طول(هذا._المحتويات)
    نهاية

    دالة عام ابحث(اسم)
        لكل ع في هذا._المحتويات
            إذا (ع.الاسم == اسم)
                ارجع ع
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    # حساب الحجم الإجمالي عودياً
    دالة عام الحجم()
        متغير حجم = 0
        لكل ع في هذا._المحتويات
            إذا (ع.النوع == "ملف")
                حجم = حجم + ع.الحجم()
            وإلا
                إذا (ع.النوع == "مجلد")
                    حجم = حجم + ع.الحجم()
                نهاية
            نهاية
        نهاية
        ارجع حجم
    نهاية

    # عد الملفات عودياً
    دالة عام عد_الملفات()
        متغير عدد = 0
        لكل ع في هذا._المحتويات
            إذا (ع.النوع == "ملف")
                عدد = عدد + 1
            وإلا
                إذا (ع.النوع == "مجلد")
                    عدد = عدد + ع.عد_الملفات()
                نهاية
            نهاية
        نهاية
        ارجع عدد
    نهاية

    # عد المجلدات عودياً
    دالة عام عد_المجلدات()
        متغير عدد = 0
        لكل ع في هذا._المحتويات
            إذا (ع.النوع == "مجلد")
                عدد = عدد + 1 + ع.عد_المجلدات()
            نهاية
        نهاية
        ارجع عدد
    نهاية

    # عرض شجرة عودياً
    دالة عام اعرض_شجرة(عمق)
        متغير بادئة = مسافات!(عمق)
        اطبع_سطر(م"{بادئة}📁 {هذا.الاسم}/")
        لكل ع في هذا._المحتويات
            إذا (ع.النوع == "مجلد")
                ع.اعرض_شجرة(عمق + 1)
            وإلا
                متغير بادئة2 = مسافات!(عمق + 1)
                اطبع_سطر(م"{بادئة2}{ع.ملخص()}")
            نهاية
        نهاية
    نهاية

    # بحث عودي بالامتداد
    دالة عام ابحث_بالامتداد(امتداد)
        متغير نتائج = []
        لكل ع في هذا._المحتويات
            إذا (ع.النوع == "ملف")
                إذا (ع.الامتداد == امتداد)
                    نتائج.اضف(ع)
                نهاية
            وإلا
                إذا (ع.النوع == "مجلد")
                    متغير فرعي = ع.ابحث_بالامتداد(امتداد)
                    لكل ن في فرعي
                        نتائج.اضف(ن)
                    نهاية
                نهاية
            نهاية
        نهاية
        ارجع نتائج
    نهاية

    # جمع كل الملفات عودياً
    دالة عام كل_الملفات()
        متغير نتائج = []
        لكل ع في هذا._المحتويات
            إذا (ع.النوع == "ملف")
                نتائج.اضف(ع)
            وإلا
                إذا (ع.النوع == "مجلد")
                    متغير فرعي = ع.كل_الملفات()
                    لكل ن في فرعي
                        نتائج.اضف(ن)
                    نهاية
                نهاية
            نهاية
        نهاية
        ارجع نتائج
    نهاية

    دالة عام ملخص()
        ارجع م"📁 {هذا.الاسم}/ ({هذا.عدد_العناصر()} عناصر، {حجم_مقروء!(هذا.الحجم())})"
    نهاية
نهاية

