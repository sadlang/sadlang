# ═══════════ بنية العملية المالية ═══════════

صنف عملية_مالية
    متغير عام النوع
    متغير عام المبلغ
    متغير عام الوصف
    متغير عام التاريخ

    باني(النوع، المبلغ، الوصف)
        هذا.النوع = النوع
        هذا.المبلغ = المبلغ
        هذا.الوصف = الوصف
        هذا.التاريخ = "2026-04-09"
    نهاية

    دالة عام نص_العملية()
        متغير نوع_نص = "مجهول"
        طابق (هذا.النوع)
            عندما "إيداع":
                نوع_نص = "⬆ إيداع"
            عندما "سحب":
                نوع_نص = "⬇ سحب"
            عندما "تحويل":
                نوع_نص = "↔ تحويل"
            افتراضي:
                نوع_نص = "؟ عملية"
        نهاية
        ارجع م"{نوع_نص}: {هذا.المبلغ} — {هذا.الوصف}"
    نهاية
نهاية

# ═══════════ الصنف الأساسي: حساب بنكي ═══════════

صنف حساب_بنكي
    متغير خاص _رصيد
    متغير خاص _رقم_الحساب
    متغير خاص _اسم_المالك
    متغير خاص _العمليات
    متغير خاص _نشط

    باني(رقم، اسم، رصيد_ابتدائي)
        يتطلب رصيد_ابتدائي >= 0
        هذا._رصيد = رصيد_ابتدائي
        هذا._رقم_الحساب = رقم
        هذا._اسم_المالك = اسم
        هذا._العمليات = []
        هذا._نشط = صحيح
    نهاية

    # === الدوال العامة ===

    دالة عام إيداع(مبلغ)
        يتطلب مبلغ > 0
        تحقق!(هذا._نشط، "الحساب مغلق")
        هذا._رصيد = هذا._رصيد + مبلغ
        متغير عملية = جديد عملية_مالية("إيداع"، مبلغ، م"إيداع {مبلغ}")
        هذا._العمليات.اضف(عملية)
        ارجع هذا._رصيد
    نهاية

    دالة عام سحب(مبلغ)
        يتطلب مبلغ > 0
        تحقق!(هذا._نشط، "الحساب مغلق")
        إذا (مبلغ > هذا._رصيد)
            ارمي م"رصيد غير كافٍ: المطلوب {مبلغ}، المتاح {هذا._رصيد}"
        نهاية
        هذا._رصيد = هذا._رصيد - مبلغ
        متغير عملية = جديد عملية_مالية("سحب"، مبلغ، م"سحب {مبلغ}")
        هذا._العمليات.اضف(عملية)
        ارجع هذا._رصيد
    نهاية

    دالة عام الرصيد()
        ارجع هذا._رصيد
    نهاية

    دالة عام الاسم()
        ارجع هذا._اسم_المالك
    نهاية

    دالة عام الرقم()
        ارجع هذا._رقم_الحساب
    نهاية

    دالة عام عدد_العمليات()
        ارجع طول(هذا._العمليات)
    نهاية

    دالة عام اغلق()
        هذا._نشط = خطأ
    نهاية

    دالة عام نشط()
        ارجع هذا._نشط
    نهاية

    دالة عام كشف_حساب()
        اطبع_سطر(م"═══ كشف حساب: {هذا._رقم_الحساب} ═══")
        اطبع_سطر(م"المالك: {هذا._اسم_المالك}")
        اطبع_سطر(م"الرصيد: {هذا._رصيد}")
        اطبع_سطر(م"عدد العمليات: {طول(هذا._العمليات)}")
        لكل عملية في هذا._العمليات
            اطبع_سطر("  " + عملية.نص_العملية())
        نهاية
        اطبع_سطر("═══════════════════════════════")
    نهاية
نهاية

# ═══════════ حساب التوفير — يرث حساب_بنكي ═══════════

صنف حساب_توفير يرث حساب_بنكي
    متغير خاص _نسبة_فائدة

    باني(رقم، اسم، رصيد، نسبة)
        الأساس(رقم، اسم، رصيد)
        هذا._نسبة_فائدة = نسبة
    نهاية

    دالة عام احسب_فائدة()
        متغير فائدة = هذا.الرصيد() * هذا._نسبة_فائدة / 100
        ارجع فائدة
    نهاية

    دالة عام اضف_فائدة()
        متغير فائدة = هذا.احسب_فائدة()
        هذا.إيداع(فائدة)
        ارجع فائدة
    نهاية

    دالة عام نسبة_الفائدة()
        ارجع هذا._نسبة_فائدة
    نهاية
نهاية

