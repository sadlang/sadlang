نهاية

# ═══════════ دوال مساعدة ═══════════

دالة تحويل(من_حساب، إلى_حساب، مبلغ)
    يتطلب مبلغ > 0
    من_حساب.سحب(مبلغ)
    إلى_حساب.إيداع(مبلغ)
    اطبع_سطر(م"✓ تحويل {مبلغ} من [{من_حساب.الرقم()}] إلى [{إلى_حساب.الرقم()}]")
نهاية

دالة اعلى_رصيد(حسابات)
    متغير أعلى = لاشيء
    متغير أعلى_رصيد = -1
    لكل حساب في حسابات
        إذا (حساب.الرصيد() > أعلى_رصيد)
            أعلى = حساب
            أعلى_رصيد = حساب.الرصيد()
        نهاية
    نهاية
    ارجع أعلى
نهاية

دالة مجموع_الأرصدة(حسابات)
    متغير مجموع = 0
    لكل حساب في حسابات
        مجموع = مجموع + حساب.الرصيد()
    نهاية
    ارجع مجموع
نهاية

