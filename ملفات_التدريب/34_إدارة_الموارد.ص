# =====================================================
# ملف تدريب 34: إدارة الموارد (باستخدام + هدم)
# =====================================================
# باستخدام: كتلة لإدارة الموارد تلقائياً
# هدم(): يُستدعى عند انتهاء عمر الكائن
# ملاحظة: داخل باستخدام لا تستخدم "متغير" لتعريف جديد
# =====================================================

# === صنف ملف مع هدم ===
صنف ملف
    باني(اسم)
        هذا.اسم = اسم
        هذا.مفتوح = صحيح
        اطبع_سطر("  📂 فتح الملف: " + اسم)
    نهاية
    
    دالة اكتب(محتوى)
        إذا (هذا.مفتوح)
            اطبع_سطر("  ✏️ كتابة: " + محتوى)
        وإلا
            اطبع_سطر("  ❌ الملف مغلق!")
        نهاية
    نهاية
    
    دالة اقرأ()
        إذا (هذا.مفتوح)
            ارجع "محتوى " + هذا.اسم
        وإلا
            ارجع "خطأ: الملف مغلق"
        نهاية
    نهاية
    
    دالة أغلق()
        هذا.مفتوح = خطأ
        اطبع_سطر("  📁 إغلاق الملف: " + هذا.اسم)
    نهاية
    
    هدم()
        اطبع_سطر("  🗑️ تحرير مورد الملف: " + هذا.اسم)
    نهاية
نهاية

# === استخدام باستخدام ===
اطبع_سطر("=== إدارة الموارد بـ باستخدام ===")
باستخدام م = جديد ملف("بيانات.txt")
    م.اكتب("مرحباً بالعالم")
    اطبع_سطر("  📖 قراءة: " + م.اقرأ())
نهاية

# === صنف اتصال قاعدة بيانات ===
اطبع_سطر("")
صنف اتصال
    باني(خادم)
        هذا.خادم = خادم
        هذا.متصل = صحيح
        اطبع_سطر("  🔌 اتصال بـ: " + خادم)
    نهاية
    
    دالة استعلام(جملة)
        إذا (هذا.متصل)
            ارجع "نتيجة: " + جملة
        وإلا
            ارمي "الاتصال مغلق!"
        نهاية
    نهاية
    
    دالة أغلق()
        هذا.متصل = خطأ
        اطبع_سطر("  🔒 قطع الاتصال عن: " + هذا.خادم)
    نهاية
    
    هدم()
        اطبع_سطر("  🗑️ تحرير اتصال: " + هذا.خادم)
    نهاية
نهاية

اطبع_سطر("=== اتصال قاعدة بيانات ===")
باستخدام قب = جديد اتصال("localhost:3306")
    اطبع_سطر("  " + قب.استعلام("SELECT * FROM users"))
    اطبع_سطر("  " + قب.استعلام("SELECT COUNT(*) FROM orders"))
نهاية

# === الهدم اليدوي ===
اطبع_سطر("")
اطبع_سطر("=== إنشاء وتدمير يدوي ===")
متغير م٢ = جديد ملف("تقرير.txt")
م٢.اكتب("بيانات التقرير")
م٢.أغلق()
اطبع_سطر("  الملف مغلق يدوياً")

# === نمط المصنع مع إدارة الموارد ===
اطبع_سطر("")
صنف مسجل
    باني(مستوى)
        هذا.مستوى = مستوى
        هذا.سجلات = []
    نهاية
    
    دالة سجل(رسالة)
        متغير إدخال = "[" + هذا.مستوى + "] " + رسالة
        هذا.سجلات.اضف(إدخال)
        اطبع_سطر("  " + إدخال)
    نهاية
    
    دالة عدد_السجلات()
        ارجع طول(هذا.سجلات)
    نهاية
    
    هدم()
        اطبع_سطر("  🗑️ حفظ " + طول(هذا.سجلات) + " سجلات قبل الحذف")
    نهاية
نهاية

اطبع_سطر("=== نظام التسجيل ===")
باستخدام سجل = جديد مسجل("INFO")
    سجل.سجل("بدء التطبيق")
    سجل.سجل("تحميل الإعدادات")
    سجل.سجل("جاهز للعمل")
    اطبع_سطر("  عدد السجلات: " + سجل.عدد_السجلات())
نهاية

اطبع_سطر("")
اطبع_سطر("✅ تم اختبار إدارة الموارد بنجاح!")
