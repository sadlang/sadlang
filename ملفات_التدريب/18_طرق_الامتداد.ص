# ملف تدريب 18: طرق الامتداد (Extension Methods)
# لغة ص — إضافة دوال جديدة لأصناف موجودة

# القسم 1: امتداد بسيط
اطبع_سطر("=== امتداد بسيط ===")

صنف نقطة
    متغير عام س
    متغير عام ص
    
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
نهاية

امتداد نقطة
    دالة وصف()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
    
    دالة المسافة_من_الأصل()
        ارجع (هذا.س ** 2 + هذا.ص ** 2) ** 0.5
    نهاية
نهاية

متغير ن = جديد نقطة(3، 4)
اطبع_سطر("النقطة: " + ن.وصف())
اطبع_سطر("المسافة من الأصل: " + ن.المسافة_من_الأصل())

# القسم 2: امتداد لصنف آخر
اطبع_سطر("=== امتداد حساب بنكي ===")

صنف حساب
    متغير عام المالك
    متغير عام الرصيد
    
    باني(مالك، رصيد)
        هذا.المالك = مالك
        هذا.الرصيد = رصيد
    نهاية
نهاية

امتداد حساب
    دالة إيداع(مبلغ)
        هذا.الرصيد = هذا.الرصيد + مبلغ
    نهاية
    
    دالة سحب(مبلغ)
        إذا (مبلغ > هذا.الرصيد)
            اطبع_سطر("رصيد غير كافي!")
            ارجع خطأ
        نهاية
        هذا.الرصيد = هذا.الرصيد - مبلغ
        ارجع صحيح
    نهاية
    
    دالة عرض()
        اطبع_سطر(هذا.المالك + ": " + هذا.الرصيد + " ريال")
    نهاية
نهاية

متغير ح = جديد حساب("أحمد"، 5000)
ح.عرض()
ح.إيداع(2000)
ح.عرض()
ح.سحب(3000)
ح.عرض()

# القسم 3: امتداد متعدد
اطبع_سطر("=== امتدادات متعددة ===")

صنف مستطيل
    متغير عام العرض
    متغير عام الارتفاع
    
    باني(عرض، ارتفاع)
        هذا.العرض = عرض
        هذا.الارتفاع = ارتفاع
    نهاية
نهاية

امتداد مستطيل
    دالة المساحة()
        ارجع هذا.العرض * هذا.الارتفاع
    نهاية
    
    دالة المحيط()
        ارجع 2 * (هذا.العرض + هذا.الارتفاع)
    نهاية
    
    دالة هل_مربع()
        ارجع هذا.العرض == هذا.الارتفاع
    نهاية
نهاية

متغير م1 = جديد مستطيل(10، 5)
اطبع_سطر("المساحة: " + م1.المساحة())
اطبع_سطر("المحيط: " + م1.المحيط())
اطبع_سطر("مربع؟ " + م1.هل_مربع())

متغير م2 = جديد مستطيل(7، 7)
اطبع_سطر("مربع؟ " + م2.هل_مربع())

اطبع_سطر("=== انتهى ملف طرق الامتداد ===")
