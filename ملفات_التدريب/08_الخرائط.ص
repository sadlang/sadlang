# --- القسم 1: إنشاء خريطة ---
اطبع_سطر("=== إنشاء الخرائط ===")

متغير شخص = {"اسم": "أحمد"، "عمر": 25، "مدينة": "الرياض"}
اطبع_سطر("الشخص: " + شخص)

# --- القسم 2: الوصول والتعديل ---
اطبع_سطر("=== الوصول والتعديل ===")

اطبع_سطر("الاسم: " + شخص["اسم"])
اطبع_سطر("العمر: " + شخص["عمر"])

# تعديل قيمة
شخص["عمر"] = 26
اطبع_سطر("العمر الجديد: " + شخص["عمر"])

# إضافة مفتاح جديد
شخص["وظيفة"] = "مهندس"
اطبع_سطر("بعد الإضافة: " + شخص)

# --- القسم 3: طرق الخريطة ---
اطبع_سطر("=== طرق الخريطة ===")

اطبع_سطر("الحجم: " + شخص.الحجم())
اطبع_سطر("المفاتيح: " + شخص.مفاتيح())
اطبع_سطر("القيم: " + شخص.القيم())

# فحص وجود مفتاح
اطبع_سطر("يحتوي 'اسم': " + شخص.يحتوي("اسم"))
اطبع_سطر("يحتوي 'هاتف': " + شخص.يحتوي("هاتف"))

# --- القسم 4: خريطة فارغة ---
اطبع_سطر("=== خريطة فارغة ===")

متغير خ = {}
اطبع_سطر("فارغة: " + خ.فارغة())
خ["أ"] = 1
خ["ب"] = 2
اطبع_سطر("بعد الإضافة: " + خ)
اطبع_سطر("فارغة الآن: " + خ.فارغة())

# --- القسم 5: حذف من خريطة ---
اطبع_سطر("=== الحذف ===")

متغير درجات = {"رياضيات": 90، "علوم": 85، "لغة": 92}
اطبع_سطر("قبل الحذف: " + درجات)
درجات.احذف("علوم")
اطبع_سطر("بعد حذف 'علوم': " + درجات)

# --- القسم 6: التكرار على الخريطة ---
اطبع_سطر("=== التكرار ===")

متغير عواصم = {"مصر": "القاهرة"، "السعودية": "الرياض"، "الإمارات": "أبوظبي"}
متغير المفاتيح = عواصم.مفاتيح()
لكل مفتاح في المفاتيح
    اطبع_سطر(مفتاح + " -> " + عواصم[مفتاح])
نهاية

# --- القسم 7: أمثلة عملية ---
اطبع_سطر("=== أمثلة عملية ===")

# عداد الكلمات
دالة عد_أحرف(الكلمة)
    متغير العداد = {}
    متغير ف = 0
    بينما (ف < الكلمة.طول())
        متغير حرف = الكلمة[ف]
        إذا (العداد.يحتوي(حرف))
            العداد[حرف] = العداد[حرف] + 1
        وإلا
            العداد[حرف] = 1
        نهاية
        ف += 1
    نهاية
    ارجع العداد
نهاية

متغير نتيجة_العد = عد_أحرف("hello")
اطبع_سطر("أحرف hello: " + نتيجة_العد)

