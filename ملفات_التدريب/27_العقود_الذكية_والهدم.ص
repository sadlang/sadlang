# ملف تدريب 27: العقود الذكية والهدم
# لغة ص — عقد ذكي وتدمير الكائنات

# القسم 1: عقد ذكي بسيط
اطبع_سطر("=== العقود الذكية ===")

عقد محفظة
    متغير عام رصيد
    متغير عام مالك

    باني(مالك، رصيد_ابتدائي)
        هذا.مالك = مالك
        هذا.رصيد = رصيد_ابتدائي
    نهاية

    دالة عام إيداع(مبلغ)
        إذا (مبلغ > 0)
            هذا.رصيد = هذا.رصيد + مبلغ
            اطبع_سطر(م"  ← إيداع {مبلغ}، الرصيد الجديد: {هذا.رصيد}")
        نهاية
    نهاية

    دالة عام سحب(مبلغ)
        إذا (مبلغ > 0 و مبلغ <= هذا.رصيد)
            هذا.رصيد = هذا.رصيد - مبلغ
            اطبع_سطر(م"  → سحب {مبلغ}، الرصيد الجديد: {هذا.رصيد}")
            ارجع صحيح
        نهاية
        اطبع_سطر("  ✗ رصيد غير كافٍ")
        ارجع خطأ
    نهاية

    دالة عام معلومات()
        اطبع_سطر(م"  المالك: {هذا.مالك}، الرصيد: {هذا.رصيد}")
    نهاية
نهاية

متغير م = جديد محفظة("أحمد"، 1000)
م.معلومات()
م.إيداع(500)
م.سحب(200)
م.سحب(2000)
م.معلومات()

# القسم 2: عقد ذكي متقدم
اطبع_سطر("=== عقد تصويت ===")

عقد تصويت
    متغير عام عنوان
    متغير عام خيارات
    متغير عام أصوات
    متغير عام مفتوح

    باني(عنوان، خيارات)
        هذا.عنوان = عنوان
        هذا.خيارات = خيارات
        هذا.أصوات = {}
        هذا.مفتوح = صحيح
        # تهيئة الأصوات لكل خيار
        لكل خ في خيارات
            هذا.أصوات[خ] = 0
        نهاية
    نهاية

    دالة عام صوّت(خيار)
        إذا (ليس هذا.مفتوح)
            اطبع_سطر("  ✗ التصويت مغلق")
            ارجع خطأ
        نهاية
        إذا (هذا.أصوات.يحتوي(خيار))
            هذا.أصوات[خيار] = هذا.أصوات[خيار] + 1
            اطبع_سطر(م"  ✓ تم التصويت لـ '{خيار}'")
            ارجع صحيح
        نهاية
        اطبع_سطر(م"  ✗ خيار غير موجود: '{خيار}'")
        ارجع خطأ
    نهاية

    دالة عام أغلق()
        هذا.مفتوح = خطأ
        اطبع_سطر("  تم إغلاق التصويت")
    نهاية

    دالة عام النتائج()
        اطبع_سطر(م"نتائج: {هذا.عنوان}")
        لكل خ في هذا.خيارات
            اطبع_سطر(م"  {خ}: {هذا.أصوات[خ]} صوت")
        نهاية
    نهاية
نهاية

متغير ت = جديد تصويت("أفضل لغة؟"، ["ص"، "بايثون"، "جافا"])
