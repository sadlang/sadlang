# القسم 3: الهدم (Destructor)
اطبع_سطر("=== الهدم ===")

صنف اتصال
    باني(اسم)
        هذا.اسم = اسم
        هذا.نشط = صحيح
        اطبع_سطر(م"  تم فتح اتصال: {اسم}")
    نهاية

    دالة أغلق()
        هذا.نشط = خطأ
        اطبع_سطر(م"  تم إغلاق اتصال: {هذا.اسم}")
    نهاية

    هدم()
        إذا (هذا.نشط)
            اطبع_سطر(م"  [هدم] إغلاق تلقائي: {هذا.اسم}")
        نهاية
    نهاية
نهاية

متغير إ = جديد اتصال("قاعدة_بيانات")
اطبع_سطر(م"  الحالة: نشط={إ.نشط}")
إ.أغلق()
اطبع_سطر(م"  الحالة: نشط={إ.نشط}")

# القسم 4: صنف مع باني وهدم ودوال
اطبع_سطر("=== إدارة الموارد ===")

صنف مسجّل
    باني(اسم)
        هذا.اسم = اسم
        هذا.سجلات = []
        اطبع_سطر(م"أُنشئ مسجّل: {اسم}")
    نهاية

    دالة سجّل(رسالة)
        هذا.سجلات.اضف(رسالة)
    نهاية

    دالة اعرض()
        اطبع_سطر(م"سجلات '{هذا.اسم}':")
        لكل س في هذا.سجلات
            اطبع_سطر("  - " + س)
        نهاية
    نهاية

    هدم()
        اطبع_سطر(م"[هدم] تنظيف مسجّل {هذا.اسم} ({طول(هذا.سجلات)} سجل)")
    نهاية
نهاية

متغير س = جديد مسجّل("النظام")
