# القسم 2: محاكاة تصدير واستيراد
اطبع_سطر("=== محاكاة الوحدات ===")

# تعريف "وحدة" رياضيات
دالة رياضيات_جمع(أ، ب)
    ارجع أ + ب
نهاية

دالة رياضيات_ضرب(أ، ب)
    ارجع أ * ب
نهاية

دالة رياضيات_قوة(أساس، أس)
    متغير نتيجة = 1
    متغير ع = 0
    بينما (ع < أس)
        نتيجة = نتيجة * أساس
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# استخدام "الوحدة"
اطبع_سطر("جمع: " + رياضيات_جمع(10، 20))
اطبع_سطر("ضرب: " + رياضيات_ضرب(5، 7))
اطبع_سطر("2^10: " + رياضيات_قوة(2، 10))

# القسم 3: تنظيم بالأصناف
اطبع_سطر("=== تنظيم بالأصناف ===")

صنف نصوص
    دالة ساكن عكس(نص)
        متغير نتيجة = ""
        متغير ي = طول(نص) - 1
        بينما (ي >= 0)
            نتيجة = نتيجة + نص[ي]
            ي = ي - 1
        نهاية
        ارجع نتيجة
    نهاية
    
    دالة ساكن تكرار(نص، مرات)
        متغير نتيجة = ""
        متغير ع = 0
        بينما (ع < مرات)
            نتيجة = نتيجة + نص
            ع = ع + 1
        نهاية
        ارجع نتيجة
    نهاية
نهاية

اطبع_سطر("عكس 'مرحبا': " + نصوص.عكس("مرحبا"))
اطبع_سطر("تكرار 'ها' 3 مرات: " + نصوص.تكرار("ها"، 3))

