# ═══════════ سلة التسوق ═══════════

صنف سلة_تسوق
    متغير خاص _العناصر
    متغير عام المالك

    باني(مالك)
        هذا._العناصر = []
        هذا.المالك = مالك
    نهاية

    دالة عام اضف(منتج، عدد)
        يتطلب عدد > 0
        # تحقق من توفر الكمية
        إذا (منتج.الكمية < عدد)
            ارمي م"الكمية المطلوبة ({عدد}) أكبر من المتوفر ({منتج.الكمية})"
        نهاية

        # تحقق هل المنتج موجود بالفعل
        متغير موجود = خطأ
        لكل عنصر في هذا._العناصر
            إذا (عنصر.المنتج.المعرف == منتج.المعرف)
                عنصر.العدد = عنصر.العدد + عدد
                موجود = صحيح
                توقف
            نهاية
        نهاية

        إذا (ليس موجود)
            هذا._العناصر.اضف(جديد عنصر_سلة(منتج، عدد))
        نهاية
    نهاية

    دالة عام احذف(معرف_منتج)
        متغير جديدة = []
        لكل عنصر في هذا._العناصر
            إذا (عنصر.المنتج.المعرف != معرف_منتج)
                جديدة.اضف(عنصر)
            نهاية
        نهاية
        هذا._العناصر = جديدة
    نهاية

    دالة عام عدد_العناصر()
        ارجع طول(هذا._العناصر)
    نهاية

    دالة عام العناصر()
        ارجع هذا._العناصر
    نهاية

    دالة عام المجموع()
        متغير مجموع = 0
        لكل عنصر في هذا._العناصر
            مجموع = مجموع + عنصر.الإجمالي()
        نهاية
        ارجع مجموع
    نهاية

    دالة عام اعرض()
        اطبع_سطر(م"🛒 سلة {هذا.المالك}:")
        إذا (طول(هذا._العناصر) == 0)
            اطبع_سطر("  (فارغة)")
            ارجع لاشيء
        نهاية
        لكل عنصر في هذا._العناصر
            متغير م = عنصر.المنتج
            اطبع_سطر(م"  • {م.الاسم} × {عنصر.العدد} = {عنصر.الإجمالي()} ريال")
        نهاية
        فاصل!()
        اطبع_سطر(م"  المجموع: {هذا.المجموع()} ريال")
    نهاية

    دالة عام فارغة()
        ارجع طول(هذا._العناصر) == 0
    نهاية
نهاية

# ═══════════ نظام الطلبات ═══════════

صنف طلب
    متغير عام رقم_الطلب
    متغير عام العميل
    متغير عام العناصر
    متغير عام المجموع
    متغير عام الضريبة
    متغير عام الإجمالي
    متغير عام طريقة_دفع
    متغير عام الخصم_العام

    باني(رقم، عميل، سلة، طريقة، خصم)
        هذا.رقم_الطلب = رقم
        هذا.العميل = عميل
        هذا.العناصر = سلة.العناصر()
        هذا.الخصم_العام = خصم
        
        # حساب المجموع
        متغير مج = سلة.المجموع()
        
        # تطبيق خصم إضافي
        إذا (خصم > 0)
            مج = مج * (100 - خصم) / 100
        نهاية
        
        هذا.المجموع = مج
        هذا.الضريبة = مج * 15 / 100
        هذا.الإجمالي = مج + هذا.الضريبة
        هذا.طريقة_دفع = طريقة
    نهاية

    دالة عام اطبع_فاتورة()
        اطبع_سطر("╔═══════════════════════════════════╗")
        اطبع_سطر(م"║  فاتورة طلب #{هذا.رقم_الطلب}          ║")
        اطبع_سطر("╚═══════════════════════════════════╝")
        اطبع_سطر(م"العميل: {هذا.العميل}")
        اطبع_سطر(م"طريقة الدفع: {هذا.طريقة_دفع}")
        فاصل!()

        لكل عنصر في هذا.العناصر
            متغير م = عنصر.المنتج
            اطبع_سطر(م"  {م.الاسم} × {عنصر.العدد} = {عنصر.الإجمالي()} ريال")
        نهاية

        فاصل!()
        إذا (هذا.الخصم_العام > 0)
            اطبع_سطر(م"  خصم إضافي: {هذا.الخصم_العام}%")
        نهاية
        اطبع_سطر(م"  المجموع: {هذا.المجموع} ريال")
        اطبع_سطر(م"  ضريبة (15%): {هذا.الضريبة} ريال")
        اطبع_سطر(م"  ═══ الإجمالي: {هذا.الإجمالي} ريال ═══")
    نهاية
نهاية

# ═══════════ نظام العملاء ═══════════

صنف عميل
    متغير عام الاسم
    متغير عام البريد
    متغير عام النقاط
    متغير خاص _الطلبات
    متغير خاص _المستوى

    باني(اسم، بريد)
        هذا.الاسم = اسم
        هذا.البريد = بريد
        هذا.النقاط = 0
        هذا._الطلبات = []
        هذا._المستوى = "عادي"
    نهاية

    دالة عام اضف_طلب(طلب)
        هذا._الطلبات.اضف(طلب)
        # إضافة نقاط (1 نقطة لكل 10 ريال)
        متغير نقاط_جديدة = أرضية(طلب.الإجمالي / 10)
        هذا.النقاط = هذا.النقاط + نقاط_جديدة
        هذا._حدث_المستوى()
    نهاية

    دالة خاص _حدث_المستوى()
        طابق (هذا.النقاط)
            عندما 0..100:
                هذا._المستوى = "عادي"
            عندما 100..500:
                هذا._المستوى = "فضي"
            عندما 500..1000:
                هذا._المستوى = "ذهبي"
            افتراضي:
                هذا._المستوى = "بلاتيني"
        نهاية
    نهاية

    دالة عام المستوى()
        ارجع هذا._المستوى
    نهاية

    دالة عام عدد_الطلبات()
        ارجع طول(هذا._الطلبات)
    نهاية

    دالة عام إجمالي_المشتريات()
        متغير مجموع = 0
        لكل ط في هذا._الطلبات
            مجموع = مجموع + ط.الإجمالي
        نهاية
        ارجع مجموع
    نهاية

    دالة عام ملخص()
        ارجع م"{هذا.الاسم} | {هذا._المستوى} | {هذا.النقاط} نقطة | {طول(هذا._الطلبات)} طلبات"
    نهاية
نهاية

# ═══════════ المتجر ═══════════

صنف متجر
    متغير عام الاسم
