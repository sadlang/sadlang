    نهاية

    دالة عام سجل_عميل(عميل)
        هذا._العملاء.اضف(عميل)
    نهاية

    دالة عام ابحث_منتج(اسم)
        لكل م في هذا._المنتجات
            إذا (م.الاسم == اسم)
                ارجع م
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    دالة عام المنتجات_بالفئة(فئة)
        متغير نتيجة = []
        لكل م في هذا._المنتجات
            إذا (م.الفئة == فئة)
                نتيجة.اضف(م)
            نهاية
        نهاية
        ارجع نتيجة
    نهاية

    دالة عام المنتجات_المتوفرة()
        متغير نتيجة = []
        لكل م في هذا._المنتجات
            إذا (م.متوفر())
                نتيجة.اضف(م)
            نهاية
        نهاية
        ارجع نتيجة
    نهاية

    دالة عام انشئ_طلب(عميل، سلة، طريقة، خصم)
        هذا._عداد_الطلبات = هذا._عداد_الطلبات + 1

        # سحب الكمية من المخزون
        لكل عنصر في سلة.العناصر()
            عنصر.المنتج.اسحب(عنصر.العدد)
        نهاية

        متغير ط = جديد طلب(هذا._عداد_الطلبات، عميل.الاسم، سلة، طريقة، خصم)
        عميل.اضف_طلب(ط)
        ارجع ط
    نهاية

    دالة عام اعرض_المنتجات()
        اطبع_سطر(م"📦 منتجات {هذا.الاسم}:")
        لكل م في هذا._المنتجات
            م.اعرض()
        نهاية
    نهاية

    دالة عام تقرير_المبيعات()
        اطبع_سطر(م"═══ تقرير مبيعات {هذا.الاسم} ═══")
        اطبع_سطر(م"عدد المنتجات: {طول(هذا._المنتجات)}")
        اطبع_سطر(م"عدد العملاء: {طول(هذا._العملاء)}")
        اطبع_سطر(م"عدد الطلبات: {هذا._عداد_الطلبات}")
        
        # حساب إجمالي الإيرادات
        متغير إيرادات = 0
        لكل ع في هذا._العملاء
            إيرادات = إيرادات + ع.إجمالي_المشتريات()
        نهاية
        اطبع_سطر(م"إجمالي الإيرادات: {إيرادات} ريال")
    نهاية
نهاية

# ═══════════ طرق الامتداد ═══════════

امتداد متجر
    دالة أغلى_منتج()
        متغير أغلى = لاشيء
        متغير أعلى_سعر = 0
        لكل م في هذا._المنتجات
            إذا (م.السعر > أعلى_سعر)
                أعلى_سعر = م.السعر
                أغلى = م
            نهاية
        نهاية
        ارجع أغلى
    نهاية

    دالة أرخص_منتج()
        متغير أرخص = لاشيء
        متغير أقل_سعر = 999999
        لكل م في هذا._المنتجات
            إذا (م.السعر < أقل_سعر)
                أقل_سعر = م.السعر
                أرخص = م
            نهاية
        نهاية
        ارجع أرخص
    نهاية

    دالة متوسط_الأسعار()
        إذا (طول(هذا._المنتجات) == 0)
            ارجع 0
        نهاية
        متغير مجموع = 0
        لكل م في هذا._المنتجات
            مجموع = مجموع + م.السعر
        نهاية
        ارجع أرضية(مجموع / طول(هذا._المنتجات))
    نهاية
نهاية

