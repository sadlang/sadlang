# ═══════════ صنف المنتج ═══════════

صنف منتج
    متغير عام المعرف
    متغير عام الاسم
    متغير عام السعر
    متغير عام الفئة
    متغير عام الكمية
    متغير خاص _الخصم

    باني(معرف، اسم، سعر، فئة، كمية)
        إذا (سعر <= 0)
            ارمي "السعر يجب أن يكون موجباً"
        نهاية
        إذا (كمية < 0)
            ارمي "الكمية لا يمكن أن تكون سالبة"
        نهاية
        هذا.المعرف = معرف
        هذا.الاسم = اسم
        هذا.السعر = سعر
        هذا.الفئة = فئة
        هذا.الكمية = كمية
        هذا._الخصم = 0
    نهاية

    دالة عام السعر_النهائي()
        ارجع هذا.السعر * (100 - هذا._الخصم) / 100
    نهاية

    دالة عام متوفر()
        ارجع هذا.الكمية > 0
    نهاية

    دالة عام تطبيق_خصم(نسبة)
        يتطلب نسبة >= 0
        يتطلب نسبة <= 100
        هذا._الخصم = نسبة
    نهاية

    دالة عام الخصم()
        ارجع هذا._الخصم
    نهاية

    دالة عام اعرض()
        متغير متاح = "متوفر"
        إذا (ليس هذا.متوفر())
            متاح = "غير متوفر"
        نهاية
        متغير سعر_خصم = ""
        إذا (هذا._الخصم > 0)
            سعر_خصم = م" (خصم {هذا._الخصم}% → {هذا.السعر_النهائي()})"
        نهاية
        اطبع_سطر(م"  [{هذا.المعرف}] {هذا.الاسم} | {هذا.السعر} ريال{سعر_خصم} | {هذا.الفئة} | {متاح} ({هذا.الكمية})")
    نهاية

    دالة عام اسحب(كمية)
        يتطلب كمية > 0
        إذا (كمية > هذا.الكمية)
            ارمي م"لا يوجد كمية كافية من {هذا.الاسم}"
        نهاية
        هذا.الكمية = هذا.الكمية - كمية
    نهاية
