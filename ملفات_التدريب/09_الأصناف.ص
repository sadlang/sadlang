# ===================================================
# ملف تدريب 09: الأصناف الأساسية (البرمجة الكائنية)
# لغة ص — Sad Programming Language
# ===================================================
# يغطي هذا الملف:
# - تعريف الأصناف بكلمة صنف
# - الباني (constructor)
# - الخصائص والطرق
# - مستويات الوصول: عام، خاص، محمي
# - كلمة هذا (this)
# - إنشاء الكائنات بكلمة جديد
# ===================================================

# --- القسم 1: صنف بسيط ---
اطبع_سطر("=== صنف بسيط ===")

صنف شخص
    باني(الاسم، العمر)
        هذا.الاسم = الاسم
        هذا.العمر = العمر
    نهاية

    دالة عرّف_نفسك()
        اطبع_سطر("أنا " + هذا.الاسم + " وعمري " + هذا.العمر)
    نهاية
نهاية

متغير أحمد = جديد شخص("أحمد"، 25)
أحمد.عرّف_نفسك()

متغير فاطمة = جديد شخص("فاطمة"، 30)
فاطمة.عرّف_نفسك()

# --- القسم 2: الوصول للخصائص ---
اطبع_سطر("=== الوصول للخصائص ===")

اطبع_سطر("اسم أحمد: " + أحمد.الاسم)
اطبع_سطر("عمر فاطمة: " + فاطمة.العمر)

# تعديل خاصية
أحمد.العمر = 26
اطبع_سطر("عمر أحمد الجديد: " + أحمد.العمر)

# --- القسم 3: طرق مع إرجاع قيمة ---
اطبع_سطر("=== طرق مع إرجاع ===")

صنف مستطيل
    باني(العرض، الارتفاع)
        هذا.العرض = العرض
        هذا.الارتفاع = الارتفاع
    نهاية

    دالة المساحة()
        ارجع هذا.العرض * هذا.الارتفاع
    نهاية

    دالة المحيط()
        ارجع 2 * (هذا.العرض + هذا.الارتفاع)
    نهاية

    دالة وصف()
        ارجع "مستطيل " + هذا.العرض + "×" + هذا.الارتفاع
    نهاية
نهاية

متغير م = جديد مستطيل(5، 3)
اطبع_سطر(م.وصف())
اطبع_سطر("المساحة: " + م.المساحة())
اطبع_سطر("المحيط: " + م.المحيط())

# --- القسم 4: صنف مع مصفوفة ---
اطبع_سطر("=== صنف مع مصفوفة ===")

صنف قائمة_طلاب
    باني()
        هذا.الطلاب = []
    نهاية

    دالة أضف_طالب(الاسم)
        هذا.الطلاب.اضف(الاسم)
    نهاية

    دالة العدد()
        ارجع هذا.الطلاب.الطول()
    نهاية

    دالة عرض_الكل()
        لكل طالب في هذا.الطلاب
            اطبع_سطر("  - " + طالب)
        نهاية
    نهاية
نهاية

متغير الفصل = جديد قائمة_طلاب()
الفصل.أضف_طالب("أحمد")
الفصل.أضف_طالب("محمد")
الفصل.أضف_طالب("فاطمة")
اطبع_سطر("عدد الطلاب: " + الفصل.العدد())
الفصل.عرض_الكل()

# --- القسم 5: صنف حساب بنكي ---
اطبع_سطر("=== حساب بنكي ===")

صنف حساب
    باني(صاحب_الحساب، الرصيد_المبدئي)
        هذا.الصاحب = صاحب_الحساب
        هذا.الرصيد = الرصيد_المبدئي
    نهاية

    دالة إيداع(مبلغ)
        هذا.الرصيد += مبلغ
        اطبع_سطر("تم إيداع " + مبلغ + " - الرصيد: " + هذا.الرصيد)
    نهاية

    دالة سحب(مبلغ)
        إذا (مبلغ > هذا.الرصيد)
            اطبع_سطر("رصيد غير كافٍ!")
        وإلا
            هذا.الرصيد -= مبلغ
            اطبع_سطر("تم سحب " + مبلغ + " - الرصيد: " + هذا.الرصيد)
        نهاية
    نهاية

    دالة معلومات()
        اطبع_سطر("صاحب الحساب: " + هذا.الصاحب + " | الرصيد: " + هذا.الرصيد)
    نهاية
نهاية

متغير حسابي = جديد حساب("محمد"، 1000)
حسابي.معلومات()
حسابي.إيداع(500)
حسابي.سحب(200)
حسابي.سحب(2000)
حسابي.معلومات()

# --- القسم 6: صنف مع خريطة ---
اطبع_سطر("=== صنف مع خريطة ===")

صنف دفتر_عناوين
    باني()
        هذا.العناوين = {}
    نهاية

    دالة أضف(الاسم، الهاتف)
        هذا.العناوين[الاسم] = الهاتف
    نهاية

    دالة ابحث(الاسم)
        إذا (هذا.العناوين.يحتوي(الاسم))
            ارجع هذا.العناوين[الاسم]
        نهاية
        ارجع "غير موجود"
    نهاية
نهاية

متغير دفتر = جديد دفتر_عناوين()
دفتر.أضف("أحمد"، "0512345678")
دفتر.أضف("محمد"، "0598765432")

اطبع_سطر("هاتف أحمد: " + دفتر.ابحث("أحمد"))
اطبع_سطر("هاتف علي: " + دفتر.ابحث("علي"))

اطبع_سطر("=== انتهى ملف الأصناف ===")
