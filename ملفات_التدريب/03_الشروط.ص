# --- القسم 5: الشروط المتداخلة ---
اطبع_سطر("=== الشروط المتداخلة ===")

متغير رقم_المستخدم = 15

إذا (رقم_المستخدم > 0)
    إذا (رقم_المستخدم % 2 == 0)
        اطبع_سطر(رقم_المستخدم + " موجب وزوجي")
    وإلا
        اطبع_سطر(رقم_المستخدم + " موجب وفردي")
    نهاية
وإلا
    اطبع_سطر(رقم_المستخدم + " سالب أو صفر")
نهاية

