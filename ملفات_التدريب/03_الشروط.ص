# --- القسم 9: العامل الثلاثي في سياقات مختلفة ---
اطبع_سطر("=== العامل الثلاثي ===")

متغير درجة_حرارة = 35
متغير وصف = درجة_حرارة > 30 ? "حار" : "معتدل"
اطبع_سطر("الطقس: " + وصف)

متغير رقم_ما = -5
متغير القيمة_المطلقة = رقم_ما < 0 ? رقم_ما * -1 : رقم_ما
اطبع_سطر("القيمة المطلقة لـ " + رقم_ما + " هي " + القيمة_المطلقة)

# العامل الثلاثي كوسيط دالة
دالة وصف_عدد(ن)
    ارجع ن > 0 ? "موجب" : (ن < 0 ? "سالب" : "صفر")
نهاية

اطبع_سطر("5: " + وصف_عدد(5))
اطبع_سطر("-3: " + وصف_عدد(-3))
اطبع_سطر("0: " + وصف_عدد(0))

اطبع_سطر("=== انتهى ملف الشروط ===")
