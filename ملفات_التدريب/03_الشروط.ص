# --- القسم 4: اختبار سلسلة الشروط مع قيم مختلفة ---
اطبع_سطر("=== اختبار قيم مختلفة ===")

دالة تصنيف_علامة(ع)
    إذا (ع >= 90)
        ارجع "ممتاز"
    وإلا إذا (ع >= 80)
        ارجع "جيد جداً"
    وإلا إذا (ع >= 70)
        ارجع "جيد"
    وإلا إذا (ع >= 60)
        ارجع "مقبول"
    وإلا
        ارجع "راسب"
    نهاية
نهاية

اطبع_سطر("95: " + تصنيف_علامة(95))
اطبع_سطر("82: " + تصنيف_علامة(82))
