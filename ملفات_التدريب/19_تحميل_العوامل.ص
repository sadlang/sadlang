# ملف تدريب 19: تحميل العوامل الزائد (Operator Overloading)
# لغة ص — تخصيص سلوك العوامل (+، -، *، /) على الأصناف

# القسم 1: تحميل عامل الجمع
اطبع_سطر("=== تحميل العوامل ===")

صنف متجه
    متغير عام س
    متغير عام ص
    
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    
    عامل +(آخر)
        ارجع جديد متجه(هذا.س + آخر.س، هذا.ص + آخر.ص)
    نهاية
    
    عامل -(آخر)
        ارجع جديد متجه(هذا.س - آخر.س، هذا.ص - آخر.ص)
    نهاية
    
    عامل ==(آخر)
        ارجع هذا.س == آخر.س و هذا.ص == آخر.ص
    نهاية
    
    دالة وصف()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير ف1 = جديد متجه(3، 4)
متغير ف2 = جديد متجه(1، 2)

متغير مجموع = ف1 + ف2
اطبع_سطر(ف1.وصف() + " + " + ف2.وصف() + " = " + مجموع.وصف())

متغير فرق = ف1 - ف2
اطبع_سطر(ف1.وصف() + " - " + ف2.وصف() + " = " + فرق.وصف())

# القسم 2: مقارنة
اطبع_سطر("=== مقارنة ===")

متغير ف3 = جديد متجه(3، 4)
اطبع_سطر("ف1 == ف3: " + (ف1 == ف3))
اطبع_سطر("ف1 == ف2: " + (ف1 == ف2))

# القسم 3: عامل ضرب
اطبع_سطر("=== عامل ضرب ===")

صنف كسر
    متغير عام البسط
    متغير عام المقام
    
    باني(بسط، مقام)
        هذا.البسط = بسط
        هذا.المقام = مقام
    نهاية
    
    عامل *(آخر)
        ارجع جديد كسر(هذا.البسط * آخر.البسط، هذا.المقام * آخر.المقام)
    نهاية
    
    عامل +(آخر)
        متغير بسط_جديد = هذا.البسط * آخر.المقام + آخر.البسط * هذا.المقام
        متغير مقام_جديد = هذا.المقام * آخر.المقام
        ارجع جديد كسر(بسط_جديد، مقام_جديد)
    نهاية
    
    دالة وصف()
        ارجع هذا.البسط + "/" + هذا.المقام
    نهاية
نهاية

متغير ك1 = جديد كسر(1، 2)
متغير ك2 = جديد كسر(3، 4)

متغير حاصل_ضرب = ك1 * ك2
اطبع_سطر(ك1.وصف() + " × " + ك2.وصف() + " = " + حاصل_ضرب.وصف())

متغير حاصل_جمع = ك1 + ك2
اطبع_سطر(ك1.وصف() + " + " + ك2.وصف() + " = " + حاصل_جمع.وصف())

اطبع_سطر("=== انتهى ملف تحميل العوامل ===")
