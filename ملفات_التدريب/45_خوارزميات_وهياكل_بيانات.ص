# ─── 10) مطابقة الأنماط ───
اطبع_سطر("=== مطابقة الأنماط مع الخوارزميات ===")

دالة وصف_تعقيد(خوارزمية)
    طابق (خوارزمية)
        عندما "بحث_خطي":
            ارجع "O(n)"
        عندما "بحث_ثنائي":
            ارجع "O(log n)"
        عندما "ترتيب_فقاعي":
            ارجع "O(n²)"
        عندما "ترتيب_الدمج":
            ارجع "O(n log n)"
        افتراضي:
            ارجع "غير معروف"
    نهاية
نهاية

متغير خوارزميات = ["بحث_خطي"، "بحث_ثنائي"، "ترتيب_فقاعي"، "ترتيب_الدمج"، "أخرى"]
لكل خ في خوارزميات
    اطبع_سطر(م"  {خ}: {وصف_تعقيد(خ)}")
