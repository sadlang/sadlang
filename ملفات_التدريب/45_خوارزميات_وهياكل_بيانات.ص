# ═══════════ مصفوفة ثنائية الأبعاد (مصفوفة رياضية) ═══════════

صنف مصفوفة_رقمية
    متغير خاص _صفوف
    متغير خاص _أعمدة
    متغير خاص _بيانات

    باني(صفوف، أعمدة)
        يتطلب صفوف > 0
        يتطلب أعمدة > 0
        هذا._صفوف = صفوف
        هذا._أعمدة = أعمدة
        هذا._بيانات = []
        # ملء بأصفار
        متغير ع = 0
        بينما (ع < صفوف * أعمدة)
            هذا._بيانات.اضف(0)
            ع = ع + 1
        نهاية
    نهاية

    دالة عام عيّن(صف، عمود، قيمة)
        يتطلب صف >= 0
        يتطلب عمود >= 0
        يتطلب صف < هذا._صفوف
        يتطلب عمود < هذا._أعمدة
        هذا._بيانات[صف * هذا._أعمدة + عمود] = قيمة
    نهاية

    دالة عام احصل(صف، عمود)
        يتطلب صف >= 0
        يتطلب عمود >= 0
        يتطلب صف < هذا._صفوف
        يتطلب عمود < هذا._أعمدة
        ارجع هذا._بيانات[صف * هذا._أعمدة + عمود]
    نهاية

    دالة عام الصفوف()
        ارجع هذا._صفوف
    نهاية

    دالة عام الأعمدة()
        ارجع هذا._أعمدة
    نهاية

    دالة عام اطبع_المصفوفة()
        متغير ص = 0
        بينما (ص < هذا._صفوف)
            متغير سطر = "| "
            متغير ع = 0
            بينما (ع < هذا._أعمدة)
                سطر = سطر + نص(هذا.احصل(ص، ع)) + "\t"
                ع = ع + 1
            نهاية
            اطبع_سطر(سطر + "|")
            ص = ص + 1
        نهاية
    نهاية

    دالة عام مجموع_الكل()
        متغير م = 0
        لكل ق في هذا._بيانات
            م = م + ق
        نهاية
        ارجع م
    نهاية
نهاية

