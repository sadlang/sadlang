# ═══════════ خوارزميات الترتيب ═══════════

# --- ترتيب الفقاعة (Bubble Sort) ---
دالة ترتيب_فقاعي(مصفوفة)
    متغير ن = طول(مصفوفة)
    متغير ع = 0
    بينما (ع < ن - 1)
        متغير ج = 0
        بينما (ج < ن - ع - 1)
            إذا (مصفوفة[ج] > مصفوفة[ج + 1])
                # تبديل
                متغير مؤقت = مصفوفة[ج]
                مصفوفة[ج] = مصفوفة[ج + 1]
                مصفوفة[ج + 1] = مؤقت
            نهاية
            ج = ج + 1
        نهاية
        ع = ع + 1
    نهاية
    ارجع مصفوفة
نهاية

# --- ترتيب الاختيار (Selection Sort) ---
دالة ترتيب_اختيار(مصفوفة)
    متغير ن = طول(مصفوفة)
    متغير ع = 0
    بينما (ع < ن - 1)
        متغير أصغر = ع
        متغير ج = ع + 1
        بينما (ج < ن)
            إذا (مصفوفة[ج] < مصفوفة[أصغر])
                أصغر = ج
            نهاية
            ج = ج + 1
        نهاية
        إذا (أصغر != ع)
            متغير مؤقت = مصفوفة[ع]
            مصفوفة[ع] = مصفوفة[أصغر]
            مصفوفة[أصغر] = مؤقت
        نهاية
        ع = ع + 1
    نهاية
    ارجع مصفوفة
نهاية

# --- ترتيب الإدراج (Insertion Sort) ---
دالة ترتيب_إدراج(مصفوفة)
    متغير ع = 1
    بينما (ع < طول(مصفوفة))
        متغير مفتاح = مصفوفة[ع]
        متغير ج = ع - 1
        بينما (ج >= 0 و مصفوفة[ج] > مفتاح)
            مصفوفة[ج + 1] = مصفوفة[ج]
            ج = ج - 1
        نهاية
        مصفوفة[ج + 1] = مفتاح
        ع = ع + 1
    نهاية
    ارجع مصفوفة
نهاية

# ═══════════ خوارزميات البحث ═══════════

# --- بحث خطي ---
دالة بحث_خطي(مصفوفة، هدف)
    متغير ع = 0
    بينما (ع < طول(مصفوفة))
        إذا (مصفوفة[ع] == هدف)
            ارجع ع
        نهاية
        ع = ع + 1
    نهاية
    ارجع -1
نهاية

# --- بحث ثنائي (يتطلب مصفوفة مرتبة) ---
دالة بحث_ثنائي(مصفوفة، هدف)
    متغير بداية = 0
    متغير نهاية_ب = طول(مصفوفة) - 1
    بينما (بداية <= نهاية_ب)
        متغير وسط = أرضية(بداية + (نهاية_ب - بداية) / 2)
        إذا (مصفوفة[وسط] == هدف)
            ارجع وسط
        وإلا
            إذا (مصفوفة[وسط] < هدف)
                بداية = وسط + 1
            وإلا
                نهاية_ب = وسط - 1
            نهاية
        نهاية
    نهاية
    ارجع -1
نهاية

# ═══════════ خوارزميات عودية ═══════════

# --- مضروب ---
دالة مضروب(ن)
    يتطلب ن >= 0
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

# --- فيبوناتشي ---
دالة فيبوناتشي(ن)
    يتطلب ن >= 0
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

# --- القاسم المشترك الأكبر (GCD) ---
دالة ق_م_أ(أ، ب)
    يتطلب أ >= 0
    يتطلب ب >= 0
    إذا (ب == 0)
        ارجع أ
    نهاية
    ارجع ق_م_أ(ب، أ % ب)
نهاية

# --- أس (Power) ---
دالة أس(قاعدة، قوة)
    يتطلب قوة >= 0
    إذا (قوة == 0)
        ارجع 1
    نهاية
    إذا (قوة == 1)
        ارجع قاعدة
    نهاية
    إذا (قوة % 2 == 0)
        متغير نصف = أس(قاعدة، قوة / 2)
        ارجع نصف * نصف
    وإلا
        ارجع قاعدة * أس(قاعدة، قوة - 1)
    نهاية
نهاية

# ═══════════ خوارزميات المصفوفات ═══════════

# --- عكس مصفوفة ---
دالة اعكس(مصفوفة)
    متغير نتيجة = []
    متغير ع = طول(مصفوفة) - 1
    بينما (ع >= 0)
        نتيجة.اضف(مصفوفة[ع])
        ع = ع - 1
    نهاية
    ارجع نتيجة
نهاية

# --- إزالة التكرارات ---
دالة فريدة(مصفوفة)
    متغير نتيجة = []
    لكل عنصر في مصفوفة
        متغير موجود = خطأ
        لكل ن في نتيجة
            إذا (ن == عنصر)
                موجود = صحيح
            نهاية
        نهاية
        إذا (ليس موجود)
            نتيجة.اضف(عنصر)
        نهاية
    نهاية
    ارجع نتيجة
نهاية

# --- مجموع مصفوفة ---
دالة مجموع(مصفوفة)
    متغير م = 0
    لكل عنصر في مصفوفة
        م = م + عنصر
    نهاية
    ارجع م
نهاية

# --- أقصى وأدنى ---
دالة أقصى(مصفوفة)
    يتطلب طول(مصفوفة) > 0
    متغير م = مصفوفة[0]
    لكل عنصر في مصفوفة
        إذا (عنصر > م)
            م = عنصر
        نهاية
    نهاية
    ارجع م
نهاية

دالة أدنى(مصفوفة)
    يتطلب طول(مصفوفة) > 0
    متغير م = مصفوفة[0]
    لكل عنصر في مصفوفة
        إذا (عنصر < م)
            م = عنصر
        نهاية
    نهاية
    ارجع م
نهاية

# --- المتوسط ---
دالة متوسط(مصفوفة)
    يتطلب طول(مصفوفة) > 0
    ارجع مجموع(مصفوفة) / طول(مصفوفة)
