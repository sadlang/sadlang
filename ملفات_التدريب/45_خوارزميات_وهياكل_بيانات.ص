# ═══════════ صنف: قائمة مترابطة ═══════════

صنف قائمة_مترابطة
    متغير خاص _الرأس
    متغير خاص _الحجم

    باني()
        هذا._الرأس = لاشيء
        هذا._الحجم = 0
    نهاية

    دالة عام الحجم()
        ارجع هذا._الحجم
    نهاية

    دالة عام فارغة()
        ارجع هذا._الحجم == 0
    نهاية

    دالة عام اضف_للأول(قيمة)
        متغير جديدة = جديد عقدة(قيمة)
        جديدة.التالي = هذا._الرأس
        هذا._الرأس = جديدة
        هذا._الحجم = هذا._الحجم + 1
    نهاية

    دالة عام اضف_للآخر(قيمة)
        متغير جديدة = جديد عقدة(قيمة)
        إذا (هذا._الرأس == لاشيء)
            هذا._الرأس = جديدة
        وإلا
            متغير حالي = هذا._الرأس
            بينما (حالي.التالي != لاشيء)
                حالي = حالي.التالي
            نهاية
            حالي.التالي = جديدة
        نهاية
        هذا._الحجم = هذا._الحجم + 1
    نهاية

    دالة عام يحتوي(قيمة)
        متغير حالي = هذا._الرأس
        بينما (حالي != لاشيء)
            إذا (حالي.القيمة == قيمة)
                ارجع صحيح
            نهاية
            حالي = حالي.التالي
        نهاية
        ارجع خطأ
    نهاية

    دالة عام إلى_مصفوفة()
        متغير نتيجة = []
        متغير حالي = هذا._الرأس
        بينما (حالي != لاشيء)
            نتيجة.اضف(حالي.القيمة)
            حالي = حالي.التالي
        نهاية
        ارجع نتيجة
    نهاية

    دالة عام اطبع_القائمة()
        متغير نتيجة = ""
        متغير حالي = هذا._الرأس
        بينما (حالي != لاشيء)
            نتيجة = نتيجة + نص(حالي.القيمة)
            إذا (حالي.التالي != لاشيء)
                نتيجة = نتيجة + " → "
            نهاية
            حالي = حالي.التالي
        نهاية
        ارجع نتيجة
    نهاية
نهاية

