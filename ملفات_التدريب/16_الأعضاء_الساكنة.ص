# --- القسم 1: متغير ساكن ---
اطبع_سطر("=== متغير ساكن ===")

صنف عداد
    متغير ساكن العدد = 0
    
    باني()
        عداد.العدد = عداد.العدد + 1
    نهاية
    
    دالة ساكن الحالي()
        ارجع عداد.العدد
    نهاية
نهاية

جديد عداد()
جديد عداد()
جديد عداد()
اطبع_سطر("عدد الكائنات: " + عداد.الحالي())

# --- القسم 2: دالة ساكنة ---
اطبع_سطر("=== دالة ساكنة ===")

صنف رياضيات
    دالة ساكن القيمة_المطلقة(ن)
        إذا (ن < 0)
            ارجع -ن
        نهاية
        ارجع ن
    نهاية
    
    دالة ساكن الأكبر(أ، ب)
        إذا (أ > ب)
            ارجع أ
        نهاية
        ارجع ب
    نهاية
    
    دالة ساكن الأصغر(أ، ب)
        إذا (أ < ب)
            ارجع أ
        نهاية
        ارجع ب
    نهاية
نهاية

اطبع_سطر("القيمة المطلقة لـ -7: " + رياضيات.القيمة_المطلقة(-7))
اطبع_سطر("الأكبر بين 10 و 25: " + رياضيات.الأكبر(10، 25))
اطبع_سطر("الأصغر بين 10 و 25: " + رياضيات.الأصغر(10، 25))

# --- القسم 3: مصنع كائنات (Factory Pattern) ---
اطبع_سطر("=== مصنع كائنات ===")

صنف مستخدم
    متغير عام الاسم
    متغير عام الدور
    
    متغير ساكن العدد_الكلي = 0
    
    باني(اسم، دور)
        هذا.الاسم = اسم
        هذا.الدور = دور
        مستخدم.العدد_الكلي = مستخدم.العدد_الكلي + 1
    نهاية
    
    دالة ساكن انشئ_مدير(اسم)
        ارجع جديد مستخدم(اسم، "مدير")
    نهاية
    
    دالة ساكن انشئ_موظف(اسم)
        ارجع جديد مستخدم(اسم، "موظف")
    نهاية
    
    دالة وصف()
        ارجع هذا.الاسم + " (" + هذا.الدور + ")"
    نهاية
نهاية

متغير م1 = مستخدم.انشئ_مدير("أحمد")
متغير م2 = مستخدم.انشئ_موظف("سارة")
متغير م3 = مستخدم.انشئ_موظف("محمد")

اطبع_سطر(م1.وصف())
اطبع_سطر(م2.وصف())
اطبع_سطر(م3.وصف())
اطبع_سطر("العدد الكلي: " + مستخدم.العدد_الكلي)

اطبع_سطر("=== انتهى ملف الأعضاء الساكنة ===")