# --- القسم 1: وراثة بسيطة ---
اطبع_سطر("=== وراثة بسيطة ===")

صنف حيوان
    باني(الاسم، الصوت)
        هذا.الاسم = الاسم
        هذا.الصوت = الصوت
    نهاية

    دالة تكلم()
        اطبع_سطر(هذا.الاسم + " يقول: " + هذا.الصوت)
    نهاية
نهاية

صنف قطة يرث حيوان
    باني(الاسم)
        الأساس(الاسم، "مياو")
    نهاية
نهاية

صنف كلب يرث حيوان
    باني(الاسم)
        الأساس(الاسم، "هاو")
    نهاية
نهاية

متغير ق = جديد قطة("ميمي")
متغير ك = جديد كلب("ريكس")

ق.تكلم()
ك.تكلم()

# --- القسم 2: وراثة مع طرق إضافية ---
اطبع_سطر("=== وراثة مع طرق إضافية ===")

صنف شكل
    باني(اللون)
        هذا.اللون = اللون
    نهاية

    دالة وصف()
        ارجع "شكل بلون " + هذا.اللون
    نهاية
نهاية

صنف دائرة يرث شكل
    باني(اللون، نصف_القطر)
        الأساس(اللون)
        هذا.نصف_القطر = نصف_القطر
    نهاية

    دالة المساحة()
        ارجع 3.14159 * هذا.نصف_القطر ** 2
    نهاية

    دالة وصف()
        ارجع "دائرة " + هذا.اللون + " نصف قطرها " + هذا.نصف_القطر
    نهاية
نهاية

صنف مربع_شكل يرث شكل
    باني(اللون، الضلع)
        الأساس(اللون)
        هذا.الضلع = الضلع
    نهاية

    دالة المساحة()
        ارجع هذا.الضلع ** 2
    نهاية

    دالة وصف()
        ارجع "مربع " + هذا.اللون + " ضلعه " + هذا.الضلع
    نهاية
نهاية

متغير د = جديد دائرة("أحمر"، 5)
متغير مرب = جديد مربع_شكل("أزرق"، 4)

اطبع_سطر(د.وصف())
اطبع_سطر("مساحة الدائرة: " + د.المساحة())
اطبع_سطر(مرب.وصف())
اطبع_سطر("مساحة المربع: " + مرب.المساحة())

# --- القسم 3: تعدد الأشكال ---
اطبع_سطر("=== تعدد الأشكال ===")

متغير الأشكال = [د، مرب]
لكل شكل_حالي في الأشكال
    اطبع_سطر(شكل_حالي.وصف() + " - المساحة: " + شكل_حالي.المساحة())
نهاية

# --- القسم 4: وراثة متسلسلة ---
اطبع_سطر("=== وراثة متسلسلة ===")

صنف كائن_حي
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية
نهاية

صنف حيوان_2 يرث كائن_حي
    باني(الاسم، النوع)
        الأساس(الاسم)
        هذا.النوع = النوع
    نهاية
نهاية

صنف طائر يرث حيوان_2
    باني(الاسم)
        الأساس(الاسم، "طائر")
        هذا.يطير = صحيح
    نهاية

    دالة معلومات()
        ارجع هذا.الاسم + " - " + هذا.النوع + " - يطير: " + هذا.يطير
    نهاية
نهاية

متغير ط = جديد طائر("نسر")
اطبع_سطر(ط.معلومات())

# --- القسم 5: مثال عملي - نظام موظفين ---
اطبع_سطر("=== نظام موظفين ===")

صنف موظف
    باني(الاسم، الراتب)
        هذا.الاسم = الاسم
        هذا.الراتب = الراتب
    نهاية

    دالة معلومات()
        ارجع هذا.الاسم + " - الراتب: " + هذا.الراتب
    نهاية
نهاية

صنف مدير يرث موظف
    باني(الاسم، الراتب، القسم)
        الأساس(الاسم، الراتب)
        هذا.القسم = القسم
    نهاية

    دالة معلومات()
        ارجع هذا.الاسم + " - مدير " + هذا.القسم + " - الراتب: " + هذا.الراتب
    نهاية
نهاية

صنف مبرمج يرث موظف
    باني(الاسم، الراتب، اللغة_برمجة)
        الأساس(الاسم، الراتب)
        هذا.اللغة = اللغة_برمجة
    نهاية

    دالة معلومات()
        ارجع هذا.الاسم + " - مبرمج " + هذا.اللغة + " - الراتب: " + هذا.الراتب
    نهاية
نهاية

متغير فريق = [
    جديد مدير("أحمد"، 15000، "التقنية")،
    جديد مبرمج("محمد"، 12000، "لغة ص")،
    جديد مبرمج("فاطمة"، 13000، "Python")
]

لكل عضو في فريق
    اطبع_سطر(عضو.معلومات())
نهاية

اطبع_سطر("=== انتهى ملف الوراثة ===")
