# 8. صنف الوحش (يرث كائن_حي)
# ═══════════════════════════════════════════════

صنف وحش يرث كائن_حي
    متغير عام خبرة_المكافأة
    متغير عام ذهب_المكافأة
    متغير عام غنيمة

    باني(الاسم، الصحة، القوة، الدفاع، خبرة_المكافأة، ذهب_المكافأة)
        الأساس(الاسم، الصحة، القوة، الدفاع)
        هذا.خبرة_المكافأة = خبرة_المكافأة
        هذا.ذهب_المكافأة = ذهب_المكافأة
        هذا.غنيمة = لاشيء
    نهاية

    دالة عام معلومات()
        ارجع م"{هذا.الاسم} {هذا.شريط_الصحة()} (قوة: {هذا.القوة}، دفاع: {هذا.الدفاع})"
    نهاية
نهاية

# ═══════════════════════════════════════════════
# 9. صنف الغرفة (موقع في الخريطة)
# ═══════════════════════════════════════════════

صنف غرفة_لعبة
    متغير عام المعرف
    متغير عام الاسم
    متغير عام الوصف_نصي
    متغير عام المخارج
    متغير عام الأغراض
    متغير عام الوحوش
    متغير عام مقفلة
    متغير عام تمت_زيارتها

    باني(المعرف، الاسم، الوصف_نصي)
        هذا.المعرف = المعرف
        هذا.الاسم = الاسم
        هذا.الوصف_نصي = الوصف_نصي
        هذا.المخارج = {"شمال": لاشيء، "جنوب": لاشيء، "شرق": لاشيء، "غرب": لاشيء}
        هذا.الأغراض = []
        هذا.الوحوش = []
        هذا.مقفلة = خطأ
        هذا.تمت_زيارتها = خطأ
    نهاية

    # ربط مخرج
    دالة عام اربط(اتجاه_نص، غرفة_هدف)
        هذا.المخارج[اتجاه_نص] = غرفة_هدف
    نهاية

    # الحصول على المخارج المتاحة
    دالة عام المخارج_المتاحة()
        متغير متاحة = []
        متغير اتجاهات = ["شمال"، "جنوب"، "شرق"، "غرب"]
        لكل اتج في اتجاهات
            إذا (هذا.المخارج[اتج] != لاشيء)
                متاحة.اضف(اتج)
            نهاية
        نهاية
        ارجع متاحة
    نهاية

    # هل آمنة (لا وحوش)
    دالة عام آمنة()
        ارجع طول(هذا.الوحوش) == 0
    نهاية

    # وصف الغرفة
    دالة عام اعرض()
        اطبع_سطر(م"╔═ {هذا.الاسم} ═╗")
        اطبع_سطر(هذا.الوصف_نصي)

        # الأغراض
        إذا (طول(هذا.الأغراض) > 0)
            اطبع_سطر(م"أغراض في الأرض ({طول(هذا.الأغراض)}):")
            لكل غ في هذا.الأغراض
                اطبع_سطر(م"  ✦ {غ.معلومات()}")
            نهاية
        نهاية

        # الوحوش
        إذا (طول(هذا.الوحوش) > 0)
            اطبع_سطر(م"وحوش ({طول(هذا.الوحوش)}):")
            لكل و في هذا.الوحوش
                اطبع_سطر(م"  ⚔ {و.معلومات()}")
            نهاية
        نهاية

        # المخارج
        متغير مخارج = هذا.المخارج_المتاحة()
        متغير نص_مخارج = ""
        لكل م في مخارج
            إذا (طول(نص_مخارج) > 0)
                نص_مخارج = نص_مخارج + "، "
            نهاية
            نص_مخارج = نص_مخارج + م
        نهاية
        اطبع_سطر(م"المخارج: {نص_مخارج}")
    نهاية
نهاية

# ═══════════════════════════════════════════════
# 10. صنف نظام القتال
# ═══════════════════════════════════════════════

صنف نظام_القتال
    متغير عام سجل_المعارك

    باني()
        هذا.سجل_المعارك = []
    نهاية

    # معركة بين بطل ووحش
    دالة عام قاتل(البطل، الوحش_المقاتل)
        يتطلب البطل.حي
        يتطلب الوحش_المقاتل.حي

        متغير سجل = []
        سجل.اضف(م"⚔ بدأت المعركة: {البطل.الاسم} ضد {الوحش_المقاتل.الاسم}!")

        متغير جولة = 0
        بينما (البطل.حي و الوحش_المقاتل.حي)
            جولة = جولة + 1
            سجل.اضف(م"-- الجولة {جولة} --")

            # هجوم البطل
            متغير ضرر_بطل = الوحش_المقاتل.تلقى_ضرر(البطل.قوة_الهجوم())
            سجل.اضف(م"{البطل.الاسم} يهاجم → {ضرر_بطل} ضرر")

            إذا (!(الوحش_المقاتل.حي))
                سجل.اضف(م"✓ {الوحش_المقاتل.الاسم} هُزم!")
                توقف
            نهاية

            # هجوم الوحش
            متغير ضرر_وحش = البطل.تلقى_ضرر(الوحش_المقاتل.القوة)
            سجل.اضف(م"{الوحش_المقاتل.الاسم} يهاجم → {ضرر_وحش} ضرر")

            إذا (!(البطل.حي))
                سجل.اضف(م"✗ {البطل.الاسم} سقط في المعركة!")
            نهاية
        نهاية

        # نتيجة المعركة
        متغير نتيجة = {"فوز": !(الوحش_المقاتل.حي)، "جولات": جولة، "سجل": سجل}

        إذا (!(الوحش_المقاتل.حي))
            # مكافآت
            البطل.اكسب_خبرة(الوحش_المقاتل.خبرة_المكافأة)
            البطل.الذهب = البطل.الذهب + الوحش_المقاتل.ذهب_المكافأة
            البطل.الانتصارات = البطل.الانتصارات + 1
