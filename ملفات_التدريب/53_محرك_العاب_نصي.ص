# 4. صنف الغرض (العناصر)
# ═══════════════════════════════════════════════

صنف غرض
    متغير عام الاسم
    متغير عام النوع
    متغير عام القيمة
    متغير عام الوصف_نصي
    متغير عام قابل_للتكديس
    متغير عام الكمية

    باني(الاسم، النوع، القيمة، الوصف_نصي)
        هذا.الاسم = الاسم
        هذا.النوع = النوع
        هذا.القيمة = القيمة
        هذا.الوصف_نصي = الوصف_نصي
        هذا.قابل_للتكديس = صحيح
        هذا.الكمية = 1
    نهاية

    # اسم النوع
    دالة عام اسم_النوع()
        إذا (هذا.النوع == نوع_الغرض.سلاح)
            ارجع "سلاح"
        وإلا إذا (هذا.النوع == نوع_الغرض.درع)
            ارجع "درع"
        وإلا إذا (هذا.النوع == نوع_الغرض.جرعة)
            ارجع "جرعة"
        وإلا إذا (هذا.النوع == نوع_الغرض.مفتاح)
            ارجع "مفتاح"
        وإلا إذا (هذا.النوع == نوع_الغرض.كنز)
            ارجع "كنز"
        نهاية
        ارجع "غير معروف"
    نهاية

    دالة عام معلومات()
        ارجع م"[{هذا.اسم_النوع()}] {هذا.الاسم} (قوة: {هذا.القيمة})"
    نهاية
نهاية

نفذ قابل_للوصف لـ غرض
