# ═══════════════════════════════════════════════
# 5. صنف المخزون
# ═══════════════════════════════════════════════

صنف مخزون
    متغير عام الأغراض
    متغير عام السعة

    باني(السعة)
        هذا.الأغراض = []
        هذا.السعة = السعة
    نهاية

    # إضافة غرض
    دالة عام اضف(غ)
        يتطلب غ != لاشيء
        إذا (طول(هذا.الأغراض) >= هذا.السعة)
            ارجع خطأ
        نهاية
        هذا.الأغراض.اضف(غ)
        ارجع صحيح
    نهاية

    # إزالة غرض بالاسم
    دالة عام ازل(اسم_الغرض)
        متغير ف = 0
        بينما (ف < طول(هذا.الأغراض))
            إذا (هذا.الأغراض[ف].الاسم == اسم_الغرض)
                # نقل آخر عنصر للفهرس الحالي ثم حذفه
                متغير آخر_فهرس = طول(هذا.الأغراض) - 1
                إذا (ف != آخر_فهرس)
                    هذا.الأغراض[ف] = هذا.الأغراض[آخر_فهرس]
                نهاية
                هذا.الأغراض.احذف_اخير()
                ارجع صحيح
            نهاية
            ف = ف + 1
        نهاية
        ارجع خطأ
    نهاية

    # البحث عن غرض
    دالة عام ابحث(اسم_الغرض)
        لكل غ في هذا.الأغراض
            إذا (غ.الاسم == اسم_الغرض)
                ارجع غ
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    # هل يملك غرض من نوع معين
    دالة عام يملك_نوع(النوع)
        لكل غ في هذا.الأغراض
            إذا (غ.النوع == النوع)
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    # عرض المخزون
    دالة عام اعرض()
        اطبع_سطر(م"المخزون ({طول(هذا.الأغراض)}/{هذا.السعة}):")
        إذا (طول(هذا.الأغراض) == 0)
            اطبع_سطر("  (فارغ)")
            ارجع لاشيء
        نهاية
        لكل غ في هذا.الأغراض
            اطبع_سطر(م"  • {غ.معلومات()}")
        نهاية
        ارجع صحيح
    نهاية

    # إجمالي القيمة
    دالة عام قيمة_اجمالية()
        متغير مجموع = 0
        لكل غ في هذا.الأغراض
            مجموع = مجموع + غ.القيمة
        نهاية
        ارجع مجموع
    نهاية
نهاية

# ═══════════════════════════════════════════════
# 6. صنف الكائن الحي (أساس)
# ═══════════════════════════════════════════════

صنف كائن_حي
    متغير عام الاسم
    متغير عام الصحة
    متغير عام الصحة_القصوى
    متغير عام القوة
    متغير عام الدفاع
    متغير عام حي

    باني(الاسم، الصحة، القوة، الدفاع)
        هذا.الاسم = الاسم
        هذا.الصحة = الصحة
        هذا.الصحة_القصوى = الصحة
        هذا.القوة = القوة
        هذا.الدفاع = الدفاع
        هذا.حي = صحيح
    نهاية

    # تلقي ضرر
    دالة عام تلقى_ضرر(مقدار)
        متغير ضرر_فعلي = مقدار - هذا.الدفاع
        إذا (ضرر_فعلي < 1)
            ضرر_فعلي = 1
        نهاية
        هذا.الصحة = هذا.الصحة - ضرر_فعلي
        إذا (هذا.الصحة <= 0)
            هذا.الصحة = 0
            هذا.حي = خطأ
        نهاية
        ارجع ضرر_فعلي
    نهاية

    # شفاء
    دالة عام اشفِ(مقدار)
        هذا.الصحة = هذا.الصحة + مقدار
        إذا (هذا.الصحة > هذا.الصحة_القصوى)
            هذا.الصحة = هذا.الصحة_القصوى
        نهاية
    نهاية

    # نسبة الصحة
    دالة عام نسبة_الصحة()
        ارجع (هذا.الصحة * 100) / هذا.الصحة_القصوى
    نهاية

    # شريط الصحة
    دالة عام شريط_الصحة()
        متغير نسبة = هذا.نسبة_الصحة()
        متغير ممتلئ = نسبة / 10
        متغير شريط = "["
        متغير ن = 0
        بينما (ن < 10)
            إذا (ن < ممتلئ)
                شريط = شريط + "█"
            وإلا
                شريط = شريط + "░"
            نهاية
            ن = ن + 1
        نهاية
        شريط = شريط + م"] {هذا.الصحة}/{هذا.الصحة_القصوى}"
        ارجع شريط
    نهاية
نهاية

# ═══════════════════════════════════════════════
# 7. صنف البطل (يرث كائن_حي)
# ═══════════════════════════════════════════════

صنف بطل يرث كائن_حي
    متغير عام المستوى
    متغير عام الخبرة
    متغير عام الذهب
    متغير عام المخزن
    متغير عام السلاح_الحالي
    متغير عام الدرع_الحالي
    متغير عام الموقع_الحالي
    متغير عام الانتصارات
    متغير عام السجل

    باني(الاسم)
        الأساس(الاسم، 100، 15، 5)
        هذا.المستوى = 1
        هذا.الخبرة = 0
        هذا.الذهب = 50
        هذا.المخزن = جديد مخزون(10)
        هذا.السلاح_الحالي = لاشيء
        هذا.الدرع_الحالي = لاشيء
        هذا.الموقع_الحالي = لاشيء
        هذا.الانتصارات = 0
        هذا.السجل = []
    نهاية

    # تجهيز سلاح
    دالة عام جهز_سلاح(اسم_السلاح)
        متغير غ = هذا.المخزن.ابحث(اسم_السلاح)
        إذا (غ == لاشيء)
            ارجع خطأ
        نهاية
        إذا (غ.النوع != نوع_الغرض.سلاح)
            ارجع خطأ
        نهاية
        هذا.السلاح_الحالي = غ
        ارجع صحيح
    نهاية

    # تجهيز درع
    دالة عام جهز_درع(اسم_الدرع)
        متغير غ = هذا.المخزن.ابحث(اسم_الدرع)
        إذا (غ == لاشيء)
            ارجع خطأ
        نهاية
        إذا (غ.النوع != نوع_الغرض.درع)
            ارجع خطأ
        نهاية
        هذا.الدرع_الحالي = غ
        ارجع صحيح
    نهاية

    # قوة الهجوم الفعلية
    دالة عام قوة_الهجوم()
        متغير ق = هذا.القوة
        إذا (هذا.السلاح_الحالي != لاشيء)
            ق = ق + هذا.السلاح_الحالي.القيمة
        نهاية
        ارجع ق
    نهاية

    # دفاع فعلي
    دالة عام دفاع_فعلي()
        متغير د = هذا.الدفاع
        إذا (هذا.الدرع_الحالي != لاشيء)
            د = د + هذا.الدرع_الحالي.القيمة
        نهاية
        ارجع د
    نهاية

    # كسب خبرة
    دالة عام اكسب_خبرة(مقدار)
        هذا.الخبرة = هذا.الخبرة + مقدار
        # ترقية عند 100 خبرة لكل مستوى
        بينما (هذا.الخبرة >= هذا.المستوى * 100)
            هذا.الخبرة = هذا.الخبرة - هذا.المستوى * 100
            هذا.المستوى = هذا.المستوى + 1
            هذا.الصحة_القصوى = هذا.الصحة_القصوى + 20
            هذا.الصحة = هذا.الصحة_القصوى
            هذا.القوة = هذا.القوة + 3
            هذا.الدفاع = هذا.الدفاع + 2
            سجل_حدث!(م"{هذا.الاسم} ارتقى إلى المستوى {هذا.المستوى}!")
        نهاية
    نهاية

    # استخدام جرعة
    دالة عام استخدم_جرعة(اسم_الجرعة)
        متغير غ = هذا.المخزن.ابحث(اسم_الجرعة)
        إذا (غ == لاشيء)
            ارجع خطأ
        نهاية
        إذا (غ.النوع != نوع_الغرض.جرعة)
            ارجع خطأ
        نهاية
        هذا.اشفِ(غ.القيمة)
        هذا.المخزن.ازل(اسم_الجرعة)
        ارجع صحيح
    نهاية

    # ملخص البطل
    دالة عام ملخص()
        اطبع_سطر(م"═══ {هذا.الاسم} (مستوى {هذا.المستوى}) ═══")
        اطبع_سطر(م"الصحة: {هذا.شريط_الصحة()}")
        اطبع_سطر(م"القوة: {هذا.قوة_الهجوم()} | الدفاع: {هذا.دفاع_فعلي()}")
        اطبع_سطر(م"الخبرة: {هذا.الخبرة}/{هذا.المستوى * 100} | الذهب: {هذا.الذهب}")
        اطبع_سطر(م"الانتصارات: {هذا.الانتصارات}")
        إذا (هذا.السلاح_الحالي != لاشيء)
            اطبع_سطر(م"السلاح: {هذا.السلاح_الحالي.الاسم}")
        نهاية
        إذا (هذا.الدرع_الحالي != لاشيء)
            اطبع_سطر(م"الدرع: {هذا.الدرع_الحالي.الاسم}")
        نهاية
    نهاية
نهاية

