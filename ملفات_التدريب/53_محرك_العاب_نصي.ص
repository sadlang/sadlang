# 11. صنف محرك اللعبة
# ═══════════════════════════════════════════════

صنف محرك_اللعبة
    متغير عام اسم_اللعبة
    متغير عام البطل_الحالي
    متغير عام الغرف
    متغير عام نظام_القتال
    متغير عام وضع_اللعبة_الحالي
    متغير عام الأحداث

    باني(اسم_اللعبة)
        هذا.اسم_اللعبة = اسم_اللعبة
        هذا.البطل_الحالي = لاشيء
        هذا.الغرف = []
        هذا.نظام_القتال = جديد نظام_القتال()
        هذا.وضع_اللعبة_الحالي = وضع_اللعبة.جاري
        هذا.الأحداث = []
    نهاية

    # إضافة غرفة
    دالة عام اضف_غرفة(غ)
        هذا.الغرف.اضف(غ)
    نهاية

    # نقل البطل لاتجاه معين
    دالة عام تحرك(اتجاه_نص)
        يتطلب هذا.البطل_الحالي != لاشيء
        متغير الموقع = هذا.البطل_الحالي.الموقع_الحالي
        متغير الهدف = الموقع.المخارج[اتجاه_نص]
        إذا (الهدف == لاشيء)
            ارجع خطأ
        نهاية
        إذا (الهدف.مقفلة)
            # تحقق من وجود مفتاح
            إذا (هذا.البطل_الحالي.المخزن.يملك_نوع(نوع_الغرض.مفتاح))
                الهدف.مقفلة = خطأ
                هذا.الأحداث.اضف("فتح قفل باستخدام مفتاح!")
            وإلا
                هذا.الأحداث.اضف("الباب مقفل! تحتاج مفتاحاً.")
                ارجع خطأ
            نهاية
        نهاية
        هذا.البطل_الحالي.الموقع_الحالي = الهدف
        الهدف.تمت_زيارتها = صحيح
        هذا.الأحداث.اضف(م"انتقلت {اتجاه_نص} إلى {الهدف.الاسم}")
        ارجع صحيح
    نهاية

    # التقاط غرض من الأرض
    دالة عام التقط(اسم_الغرض)
        متغير الموقع = هذا.البطل_الحالي.الموقع_الحالي
        متغير ف = 0
        بينما (ف < طول(الموقع.الأغراض))
            إذا (الموقع.الأغراض[ف].الاسم == اسم_الغرض)
                متغير غ = الموقع.الأغراض[ف]
                إذا (هذا.البطل_الحالي.المخزن.اضف(غ))
                    # إزالة من الأرض
                    متغير آخر = طول(الموقع.الأغراض) - 1
                    إذا (ف != آخر)
                        الموقع.الأغراض[ف] = الموقع.الأغراض[آخر]
                    نهاية
                    الموقع.الأغراض.احذف_اخير()
                    هذا.الأحداث.اضف(م"التقطت: {غ.الاسم}")
                    ارجع صحيح
                وإلا
                    هذا.الأحداث.اضف("المخزون ممتلئ!")
                    ارجع خطأ
                نهاية
            نهاية
            ف = ف + 1
        نهاية
        ارجع خطأ
    نهاية

    # القتال مع وحش في الغرفة
    دالة عام هاجم(اسم_الوحش_المطلوب)
        متغير الموقع = هذا.البطل_الحالي.الموقع_الحالي
        متغير وحش_مستهدف = لاشيء
        متغير فهرس_الوحش = -1
        متغير ف = 0
        بينما (ف < طول(الموقع.الوحوش))
            إذا (الموقع.الوحوش[ف].الاسم == اسم_الوحش_المطلوب)
                وحش_مستهدف = الموقع.الوحوش[ف]
                فهرس_الوحش = ف
                توقف
            نهاية
            ف = ف + 1
        نهاية

        إذا (وحش_مستهدف == لاشيء)
            ارجع لاشيء
        نهاية

        متغير نتيجة = هذا.نظام_القتال.قاتل(هذا.البطل_الحالي، وحش_مستهدف)

        # إزالة الوحش إذا هُزم
        إذا (نتيجة["فوز"])
            # غنيمة
            إذا (وحش_مستهدف.غنيمة != لاشيء)
                الموقع.الأغراض.اضف(وحش_مستهدف.غنيمة)
                هذا.الأحداث.اضف(م"سقطت غنيمة: {وحش_مستهدف.غنيمة.الاسم}")
            نهاية
            # إزالة من الغرفة
            متغير آخر = طول(الموقع.الوحوش) - 1
            إذا (فهرس_الوحش != آخر)
                الموقع.الوحوش[فهرس_الوحش] = الموقع.الوحوش[آخر]
            نهاية
            الموقع.الوحوش.احذف_اخير()
        نهاية

        ارجع نتيجة
    نهاية

    # عدد الغرف المزارة
    دالة عام غرف_مزارة()
        متغير عدد = 0
        لكل غ في هذا.الغرف
            إذا (غ.تمت_زيارتها)
                عدد = عدد + 1
            نهاية
        نهاية
        ارجع عدد
    نهاية

    # إحصائيات اللعبة
    دالة عام احصائيات()
        اطبع_سطر(م"═══ إحصائيات {هذا.اسم_اللعبة} ═══")
        اطبع_سطر(م"الغرف: {طول(هذا.الغرف)} (مزارة: {هذا.غرف_مزارة()})")
        اطبع_سطر(م"المعارك: {هذا.نظام_القتال.عدد_المعارك()}")
        اطبع_سطر(م"الانتصارات: {هذا.نظام_القتال.عدد_الانتصارات()}")
        اطبع_سطر(م"الأحداث: {طول(هذا.الأحداث)}")
    نهاية
