# ملف تدريب 30: برنامج متكامل — نظام مكتبة
# لغة ص — يجمع: كل ميزات اللغة في مشروع واحد

# === تعدادات ===
تعداد حالة_الكتاب
    متاح
    معار
    مفقود
نهاية

# === بنى ===
بنية تاريخ
    رقم يوم = 1
    رقم شهر = 1
    رقم سنة = 2024
نهاية

# === سمة ===
سمة قابل_للبحث
    دالة يطابق(استعلام)
نهاية

# === أصناف ===
صنف كتاب
    باني(عنوان، مؤلف، رقم_isbn)
        هذا.عنوان = عنوان
        هذا.مؤلف = مؤلف
        هذا.رقم_isbn = رقم_isbn
        هذا.الحالة = "متاح"
        هذا.المستعير = لاشيء
    نهاية

    دالة وصف()
        ارجع م"'{هذا.عنوان}' بقلم {هذا.مؤلف} [{هذا.الحالة}]"
    نهاية
نهاية

نفّذ قابل_للبحث لـ كتاب
    دالة يطابق(استعلام)
        ارجع هذا.عنوان.يحتوي(استعلام) أو هذا.مؤلف.يحتوي(استعلام)
    نهاية
نهاية

صنف عضو
    باني(اسم، معرف)
        هذا.اسم = اسم
        هذا.معرف = معرف
        هذا.كتب_معارة = []
        هذا.الحد_الأقصى = 3
    نهاية

    دالة يمكن_الاستعارة()
        ارجع طول(هذا.كتب_معارة) < هذا.الحد_الأقصى
    نهاية

    دالة وصف()
        ارجع م"{هذا.اسم} (#{هذا.معرف}) — معار: {طول(هذا.كتب_معارة)}/{هذا.الحد_الأقصى}"
    نهاية
نهاية

# === المكتبة ===
صنف مكتبة
    باني(اسم)
        هذا.اسم = اسم
        هذا.كتب = []
        هذا.أعضاء = []
        هذا.سجل_العمليات = []
    نهاية

    # إضافة كتاب
    دالة أضف_كتاب(كتاب)
        هذا.كتب.اضف(كتاب)
        اطبع_سطر(م"  📚 أُضيف: {كتاب.وصف()}")
    نهاية

    # تسجيل عضو
    دالة سجّل_عضو(عضو)
        هذا.أعضاء.اضف(عضو)
        اطبع_سطر(م"  👤 تسجيل عضو: {عضو.اسم}")
    نهاية

    # إعارة كتاب
    دالة أعر(رقم_isbn، معرف_عضو)
        # البحث عن الكتاب
        متغير الكتاب = لاشيء
        لكل ك في هذا.كتب
            إذا (ك.رقم_isbn == رقم_isbn)
                الكتاب = ك
                توقف
            نهاية
        نهاية

        إذا (الكتاب == لاشيء)
            اطبع_سطر(م"  ✗ كتاب غير موجود: {رقم_isbn}")
            ارجع خطأ
        نهاية

        إذا (الكتاب.الحالة != "متاح")
            اطبع_سطر(م"  ✗ الكتاب غير متاح: {الكتاب.عنوان}")
            ارجع خطأ
        نهاية

        # البحث عن العضو
        متغير العضو = لاشيء
        لكل ع في هذا.أعضاء
            إذا (ع.معرف == معرف_عضو)
                العضو = ع
                توقف
            نهاية
        نهاية

        إذا (العضو == لاشيء)
            اطبع_سطر(م"  ✗ عضو غير موجود: {معرف_عضو}")
            ارجع خطأ
        نهاية

        إذا (ليس العضو.يمكن_الاستعارة())
            اطبع_سطر(م"  ✗ {العضو.اسم} وصل للحد الأقصى")
            ارجع خطأ
        نهاية

        # تنفيذ الإعارة
        الكتاب.الحالة = "معار"
        الكتاب.المستعير = العضو.اسم
        العضو.كتب_معارة.اضف(الكتاب.عنوان)

        هذا.سجل_العمليات.اضف(م"إعارة: '{الكتاب.عنوان}' → {العضو.اسم}")
        اطبع_سطر(م"  ✓ تمت إعارة '{الكتاب.عنوان}' لـ {العضو.اسم}")
        ارجع صحيح
    نهاية

    # إرجاع كتاب
    دالة أرجع(رقم_isbn)
        لكل ك في هذا.كتب
            إذا (ك.رقم_isbn == رقم_isbn و ك.الحالة == "معار")
                متغير المستعير = ك.المستعير
                ك.الحالة = "متاح"
                ك.المستعير = لاشيء

                # إزالة من قائمة العضو
                لكل ع في هذا.أعضاء
                    إذا (ع.اسم == المستعير)
                        متغير جديدة = []
                        لكل عن في ع.كتب_معارة
                            إذا (عن != ك.عنوان)
                                جديدة.اضف(عن)
                            نهاية
                        نهاية
                        ع.كتب_معارة = جديدة
                        توقف
                    نهاية
                نهاية

                هذا.سجل_العمليات.اضف(م"إرجاع: '{ك.عنوان}' ← {المستعير}")
                اطبع_سطر(م"  ✓ تم إرجاع '{ك.عنوان}'")
                ارجع صحيح
            نهاية
        نهاية
        اطبع_سطر("  ✗ لم يُعثر على الكتاب المعار")
        ارجع خطأ
    نهاية

    # بحث
    دالة بحث(استعلام)
        متغير نتائج = []
        لكل ك في هذا.كتب
            إذا (ك.يطابق(استعلام))
                نتائج.اضف(ك)
            نهاية
        نهاية
        ارجع نتائج
    نهاية

    # إحصائيات
    دالة إحصائيات()
        متغير متاحة = 0
        متغير معارة = 0
        لكل ك في هذا.كتب
            إذا (ك.الحالة == "متاح")
                متاحة = متاحة + 1
            وإلا
                معارة = معارة + 1
            نهاية
        نهاية

        اطبع_سطر(م"╔═══ إحصائيات {هذا.اسم} ═══╗")
        اطبع_سطر(م"  إجمالي الكتب: {طول(هذا.كتب)}")
        اطبع_سطر(م"  متاحة: {متاحة}")
        اطبع_سطر(م"  معارة: {معارة}")
        اطبع_سطر(م"  الأعضاء: {طول(هذا.أعضاء)}")
        اطبع_سطر(م"  عمليات مسجلة: {طول(هذا.سجل_العمليات)}")
        اطبع_سطر("╚═══════════════════════════╝")
    نهاية

    # عرض السجل
    دالة اعرض_السجل()
        اطبع_سطر("=== سجل العمليات ===")
        لكل عملية في هذا.سجل_العمليات
            اطبع_سطر("  • " + عملية)
        نهاية
    نهاية
نهاية

# === التشغيل ===
اطبع_سطر("╔═══════════════════════════╗")
اطبع_سطر("║    نظام إدارة المكتبة     ║")
اطبع_سطر("╚═══════════════════════════╝")

# إنشاء المكتبة
متغير المكتبة = جديد مكتبة("مكتبة المعرفة")

# إضافة كتب
اطبع_سطر("\n--- إضافة الكتب ---")
المكتبة.أضف_كتاب(جديد كتاب("تعلم لغة ص"، "أحمد محمد"، "001"))
المكتبة.أضف_كتاب(جديد كتاب("أساسيات البرمجة"، "سارة علي"، "002"))
المكتبة.أضف_كتاب(جديد كتاب("الخوارزميات"، "أحمد محمد"، "003"))
المكتبة.أضف_كتاب(جديد كتاب("قواعد البيانات"، "فاطمة حسن"، "004"))
المكتبة.أضف_كتاب(جديد كتاب("الشبكات"، "محمد خالد"، "005"))

# تسجيل أعضاء
اطبع_سطر("\n--- تسجيل الأعضاء ---")
المكتبة.سجّل_عضو(جديد عضو("علي"، "W01"))
المكتبة.سجّل_عضو(جديد عضو("نور"، "W02"))

# إعارة كتب
اطبع_سطر("\n--- إعارة الكتب ---")
المكتبة.أعر("001"، "W01")
المكتبة.أعر("003"، "W01")
المكتبة.أعر("002"، "W02")
المكتبة.أعر("001"، "W02")

# إرجاع
اطبع_سطر("\n--- إرجاع ---")
المكتبة.أرجع("001")

# إعارة مرة أخرى
المكتبة.أعر("001"، "W02")

# بحث
اطبع_سطر("\n--- بحث ---")
متغير نتائج = المكتبة.بحث("أحمد")
اطبع_سطر(م"نتائج البحث عن 'أحمد': {طول(نتائج)} نتيجة")
لكل ن في نتائج
    اطبع_سطر("  → " + ن.وصف())
نهاية

# الإحصائيات
اطبع_سطر("")
المكتبة.إحصائيات()

# السجل
اطبع_سطر("")
المكتبة.اعرض_السجل()

# عرض حالة الأعضاء
اطبع_سطر("\n=== حالة الأعضاء ===")
لكل ع في المكتبة.أعضاء
    اطبع_سطر("  " + ع.وصف())
نهاية

اطبع_سطر("\n=== انتهى نظام المكتبة ===")
