# --- القسم 7: دوال عملية ---
اطبع_سطر("=== دوال عملية ===")

# أكبر عنصر في مصفوفة
دالة أكبر_عنصر(القائمة)
    متغير الأكبر = القائمة[0]
    متغير ف = 1
    بينما (ف < طول(القائمة))
        إذا (القائمة[ف] > الأكبر)
            الأكبر = القائمة[ف]
        نهاية
        ف += 1
    نهاية
    ارجع الأكبر
نهاية

اطبع_سطر("أكبر عنصر في [3,7,2,9,4]: " + أكبر_عنصر([3، 7، 2، 9، 4]))

# عكس نص
دالة عكس_نص(الكلمة)
    متغير الناتج = ""
    متغير ف = الكلمة.طول() - 1
    بينما (ف >= 0)
        الناتج += الكلمة[ف]
        ف -= 1
    نهاية
    ارجع الناتج
نهاية

اطبع_سطر("عكس Hello: " + عكس_نص("Hello"))

# --- القسم 8: إرجاع قيم متعددة عبر مصفوفة ---
اطبع_سطر("=== إرجاع قيم متعددة ===")

دالة حساب_إحصائيات(الأرقام)
    متغير المجموع = 0
    لكل رقم في الأرقام
        المجموع += رقم
    نهاية
    متغير المتوسط = المجموع / طول(الأرقام)
    ارجع [المجموع، المتوسط]
نهاية

متغير النتائج = حساب_إحصائيات([10، 20، 30، 40])
اطبع_سطر("المجموع: " + النتائج[0])
اطبع_سطر("المتوسط: " + النتائج[1])

