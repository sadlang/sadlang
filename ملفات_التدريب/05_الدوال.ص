# --- القسم 6: التكرار (Recursion) ---
اطبع_سطر("=== التكرار ===")

دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

اطبع_سطر("5! = " + مضروب(5))
اطبع_سطر("10! = " + مضروب(10))

# فيبوناتشي
دالة فيبوناتشي(ن)
    إذا (ن <= 1)
        ارجع ن
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
