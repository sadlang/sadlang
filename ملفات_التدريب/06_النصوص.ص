# ===================================================
# ملف تدريب 06: النصوص ودوالها
# لغة ص — Sad Programming Language
# ===================================================
# يغطي هذا الملف:
# - إنشاء النصوص
# - دمج النصوص بـ +
# - النصوص المنسقة (F-strings) بـ م""
# - دوال النصوص المدمجة
# - طرق النقطة على النصوص
# - الوصول لأحرف النص بالفهرس
# ===================================================

# --- القسم 1: إنشاء النصوص ---
اطبع_سطر("=== إنشاء النصوص ===")

متغير اسم = "أحمد"
متغير جملة = "مرحباً بالعالم"
متغير فارغ = ""

اطبع_سطر("الاسم: " + اسم)
اطبع_سطر("الجملة: " + جملة)
اطبع_سطر("فارغ: [" + فارغ + "]")

# --- القسم 2: دمج النصوص ---
اطبع_سطر("=== دمج النصوص ===")

متغير الاسم_الأول = "محمد"
متغير الاسم_الأخير = "العلي"
متغير الاسم_الكامل = الاسم_الأول + " " + الاسم_الأخير
اطبع_سطر("الاسم الكامل: " + الاسم_الكامل)

# دمج نص مع رقم
متغير عمر_الشخص = 25
اطبع_سطر("العمر: " + عمر_الشخص + " سنة")

# --- القسم 3: النصوص المنسقة (F-strings) ---
اطبع_سطر("=== النصوص المنسقة ===")

متغير اسم_المستخدم = "فاطمة"
متغير عمر_المستخدم = 30
اطبع_سطر(م"مرحباً {اسم_المستخدم}! عمرك {عمر_المستخدم} سنة")

# تعبيرات داخل F-strings
اطبع_سطر(م"2 + 3 = {2 + 3}")
اطبع_سطر(م"10 * 5 = {10 * 5}")

متغير سعر = 49.99
متغير كمية = 3
اطبع_سطر(م"الإجمالي: {سعر * كمية} ريال")

# --- القسم 4: طول النص ---
اطبع_سطر("=== طول النص ===")

متغير كلمة = "مرحبا"
اطبع_سطر("طول 'مرحبا': " + طول(كلمة))
اطبع_سطر("طول 'Hello': " + طول("Hello"))

# بطريقة النقطة
اطبع_سطر("بالنقطة: " + كلمة.طول())

# --- القسم 5: الوصول لأحرف النص ---
اطبع_سطر("=== الوصول لأحرف النص ===")

متغير نص_إنجليزي = "Hello"
اطبع_سطر("الحرف الأول: " + نص_إنجليزي[0])
اطبع_سطر("الحرف الثاني: " + نص_إنجليزي[1])
اطبع_سطر("الحرف الأخير: " + نص_إنجليزي[4])

# --- القسم 6: تحويل الحالة ---
اطبع_سطر("=== تحويل الحالة ===")

متغير كل_اتجاه = "Hello World"
اطبع_سطر("كبير: " + كل_اتجاه.تحويل_كبير())
اطبع_سطر("صغير: " + كل_اتجاه.تحويل_صغير())

# --- القسم 7: البحث في النصوص ---
اطبع_سطر("=== البحث في النصوص ===")

متغير جملة_بحث = "مرحباً بالعالم العربي"
اطبع_سطر("يحتوي على 'العالم': " + جملة_بحث.يحتوي("العالم"))
اطبع_سطر("يبدأ بـ 'مرحباً': " + جملة_بحث.يبدأ_بـ("مرحباً"))
اطبع_سطر("ينتهي بـ 'العربي': " + جملة_بحث.ينتهي_بـ("العربي"))

# --- القسم 8: الاستبدال ---
اطبع_سطر("=== الاستبدال ===")

متغير أصلي = "مرحباً يا عالم"
متغير معدل = أصلي.استبدل("عالم"، "دنيا")
اطبع_سطر("الأصلي: " + أصلي)
اطبع_سطر("المعدل: " + معدل)

# --- القسم 9: التقسيم والدمج ---
اطبع_سطر("=== التقسيم ===")

متغير جملة_كاملة = "أحمد,محمد,فاطمة,عائشة"
متغير أجزاء = جملة_كاملة.قسم(",")
اطبع_سطر("الأجزاء: " + أجزاء)
اطبع_سطر("العنصر الأول: " + أجزاء[0])
اطبع_سطر("عدد الأجزاء: " + أجزاء.الطول())

# إعادة الدمج
متغير مدمج = أجزاء.صل(" و ")
اطبع_سطر("المدمج: " + مدمج)

# --- القسم 10: تحويل الأنواع ---
اطبع_سطر("=== تحويل الأنواع ===")

متغير رقم_كنص = "42"
متغير الرقم = لرقم(رقم_كنص)
اطبع_سطر("الرقم + 8 = " + (الرقم + 8))

متغير عدد = 100
متغير عدد_كنص = لنص(عدد)
اطبع_سطر("النص: " + عدد_كنص + " (نوعه: " + نوع(عدد_كنص) + ")")

# --- القسم 11: أمثلة عملية ---
اطبع_سطر("=== أمثلة عملية ===")

# عد الكلمات
دالة عد_كلمات(جملة_عد)
    متغير الكلمات = جملة_عد.قسم(" ")
    ارجع الكلمات.الطول()
نهاية

اطبع_سطر("عدد الكلمات في 'أنا أحب البرمجة': " + عد_كلمات("أنا أحب البرمجة"))

# تكرار نص
دالة كرر_نص(الحرف، العدد)
    متغير الناتج = ""
    متغير ف = 0
    بينما (ف < العدد)
        الناتج += الحرف
        ف += 1
    نهاية
    ارجع الناتج
نهاية

اطبع_سطر(كرر_نص("*"، 20))
اطبع_سطر(كرر_نص("-"، 10))

اطبع_سطر("=== انتهى ملف النصوص ===")
