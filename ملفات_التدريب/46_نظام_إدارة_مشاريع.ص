# ═══════════ صنف: مهمة ═══════════

صنف مهمة
    متغير عام المعرف
    متغير عام العنوان
    متغير عام الوصف
    متغير عام الحالة
    متغير عام الأولوية
    متغير عام المسؤول
    متغير عام التعليقات
    متغير خاص _ساعات_متقدرة
    متغير خاص _ساعات_فعلية

    باني(معرف، عنوان، وصف، أولوية)
        هذا.المعرف = معرف
        هذا.العنوان = عنوان
        هذا.الوصف = وصف
        هذا.الحالة = "جديدة"
        هذا.الأولوية = أولوية
        هذا.المسؤول = لاشيء
        هذا.التعليقات = []
        هذا._ساعات_متقدرة = 0
        هذا._ساعات_فعلية = 0
    نهاية

    دالة عام عيّن_مسؤول(مسؤول)
        هذا.المسؤول = مسؤول
    نهاية

    دالة عام عيّن_ساعات(متقدرة، فعلية)
        يتطلب متقدرة >= 0
        يتطلب فعلية >= 0
        هذا._ساعات_متقدرة = متقدرة
        هذا._ساعات_فعلية = فعلية
    نهاية

    دالة عام غيّر_الحالة(حالة_جديدة)
        # التحققات المنطقية
        إذا (هذا.الحالة == "ملغاة")
            ارمي "لا يمكن تغيير حالة مهمة ملغاة"
        نهاية
        إذا (هذا.الحالة == "مكتملة" و حالة_جديدة != "ملغاة")
            ارمي "المهمة مكتملة بالفعل"
        نهاية
        هذا.الحالة = حالة_جديدة
    نهاية

    دالة عام اضف_تعليق(نص_التعليق)
        يتطلب طول(نص_التعليق) > 0
        هذا.التعليقات.اضف(نص_التعليق)
    نهاية

    دالة عام مكتملة()
        ارجع هذا.الحالة == "مكتملة"
    نهاية

    دالة عام الكفاءة()
        إذا (هذا._ساعات_متقدرة == 0)
            ارجع 0
        نهاية
        ارجع أرضية(هذا._ساعات_متقدرة / هذا._ساعات_فعلية * 100)
    نهاية

    دالة عام رقم_الأولوية()
        طابق (هذا.الأولوية)
            عندما "حرجة":
                ارجع 4
            عندما "عالية":
                ارجع 3
            عندما "متوسطة":
                ارجع 2
            عندما "منخفضة":
                ارجع 1
            افتراضي:
                ارجع 0
        نهاية
    نهاية

    دالة عام ملخص()
        متغير حالة_رمز = "◻"
        طابق (هذا.الحالة)
            عندما "جديدة":
                حالة_رمز = "◻"
            عندما "قيد_التنفيذ":
                حالة_رمز = "🔄"
            عندما "مراجعة":
                حالة_رمز = "👁"
            عندما "مكتملة":
                حالة_رمز = "✅"
            عندما "ملغاة":
                حالة_رمز = "❌"
            افتراضي:
                حالة_رمز = "?"
        نهاية
        متغير م = هذا.المسؤول
        إذا (م == لاشيء)
            م = "غير معيّن"
        نهاية
        ارجع م"{حالة_رمز} [{هذا.المعرف}] {هذا.العنوان} ({هذا.الأولوية}) — {م}"
    نهاية
نهاية

