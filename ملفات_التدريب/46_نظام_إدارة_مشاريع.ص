# ═══════════ صنف: مشروع ═══════════

صنف مشروع
    متغير عام الاسم
    متغير عام الوصف
    متغير خاص _المهام
    متغير خاص _عداد_المهام
    متغير خاص _الأعضاء

    باني(اسم، وصف)
        هذا.الاسم = اسم
        هذا.الوصف = وصف
        هذا._المهام = []
        هذا._عداد_المهام = 0
        هذا._الأعضاء = []
    نهاية

    دالة عام اضف_عضو(اسم)
        هذا._الأعضاء.اضف(اسم)
    نهاية

    دالة عام الأعضاء()
        ارجع هذا._الأعضاء
    نهاية

    دالة عام انشئ_مهمة(عنوان، وصف، أولوية)
        هذا._عداد_المهام = هذا._عداد_المهام + 1
        متغير معرف = م"T-{هذا._عداد_المهام}"
        متغير م = جديد مهمة(معرف، عنوان، وصف، أولوية)
        هذا._المهام.اضف(م)
        ارجع م
    نهاية

    دالة عام عدد_المهام()
        ارجع طول(هذا._المهام)
    نهاية

    دالة عام المهام()
        ارجع هذا._المهام
    نهاية

    دالة عام المهام_بالحالة(حالة)
        متغير نتيجة = []
        لكل م في هذا._المهام
            إذا (م.الحالة == حالة)
                نتيجة.اضف(م)
            نهاية
        نهاية
        ارجع نتيجة
    نهاية

    دالة عام المهام_بالأولوية(أولوية)
        متغير نتيجة = []
        لكل م في هذا._المهام
            إذا (م.الأولوية == أولوية)
                نتيجة.اضف(م)
            نهاية
        نهاية
        ارجع نتيجة
    نهاية

    دالة عام نسبة_الإنجاز()
        إذا (طول(هذا._المهام) == 0)
            ارجع 0
        نهاية
        متغير مكتملة = 0
        لكل م في هذا._المهام
            إذا (م.مكتملة())
                مكتملة = مكتملة + 1
            نهاية
        نهاية
        ارجع أرضية(مكتملة / طول(هذا._المهام) * 100)
    نهاية

    دالة عام تقرير()
        اطبع_سطر(م"╔═══ مشروع: {هذا.الاسم} ═══╗")
        اطبع_سطر(م"الوصف: {هذا.الوصف}")
        اطبع_سطر(م"الأعضاء: {هذا._الأعضاء}")
        اطبع_سطر(م"عدد المهام: {طول(هذا._المهام)}")
        اطبع_سطر(م"نسبة الإنجاز: {هذا.نسبة_الإنجاز()}%")
        خط_فاصل!()

        # عرض المهام حسب الحالة
        متغير حالات = ["جديدة"، "قيد_التنفيذ"، "مراجعة"، "مكتملة"، "ملغاة"]
        لكل حالة في حالات
            متغير مهام = هذا.المهام_بالحالة(حالة)
            إذا (طول(مهام) > 0)
                اطبع_سطر(م"  {حالة} ({طول(مهام)}):")
                لكل م في مهام
                    اطبع_سطر(م"    {م.ملخص()}")
                نهاية
            نهاية
        نهاية
        خط_فاصل!()
    نهاية
نهاية

