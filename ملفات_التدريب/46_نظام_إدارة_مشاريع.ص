# ═══════════ صنف: تقرير إحصائي ═══════════

صنف تقرير_إحصائي
    متغير خاص _مشاريع

    باني()
        هذا._مشاريع = []
    نهاية

    دالة عام اضف_مشروع(مشروع)
        هذا._مشاريع.اضف(مشروع)
    نهاية

    دالة عام إجمالي_المهام()
        متغير عدد = 0
        لكل مش في هذا._مشاريع
            عدد = عدد + مش.عدد_المهام()
        نهاية
        ارجع عدد
    نهاية

    دالة عام متوسط_الإنجاز()
        إذا (طول(هذا._مشاريع) == 0)
            ارجع 0
        نهاية
        متغير مجموع = 0
        لكل مش في هذا._مشاريع
            مجموع = مجموع + مش.نسبة_الإنجاز()
        نهاية
        ارجع أرضية(مجموع / طول(هذا._مشاريع))
    نهاية

    دالة عام اطبع_تقرير()
        اطبع_سطر("══════════ تقرير إحصائي شامل ══════════")
        لكل مش في هذا._مشاريع
            اطبع_سطر(م"  📊 {مش.ملخص_سريع()}")
        نهاية
        اطبع_سطر(م"  ─── إجمالي المهام: {هذا.إجمالي_المهام()}")
        اطبع_سطر(م"  ─── متوسط الإنجاز: {هذا.متوسط_الإنجاز()}%")
        اطبع_سطر("══════════════════════════════════════════")
    نهاية
نهاية

# ═══════════ دوال مساعدة ═══════════

دالة ترتيب_بالأولوية(مهام)
    # ترتيب فقاعي بسيط حسب رقم الأولوية (تنازلي)
    متغير ن = طول(مهام)
    متغير ع = 0
    بينما (ع < ن - 1)
        متغير ج = 0
        بينما (ج < ن - ع - 1)
            إذا (مهام[ج].رقم_الأولوية() < مهام[ج + 1].رقم_الأولوية())
                متغير مؤقت = مهام[ج]
                مهام[ج] = مهام[ج + 1]
                مهام[ج + 1] = مؤقت
            نهاية
            ج = ج + 1
        نهاية
        ع = ع + 1
    نهاية
    ارجع مهام
نهاية

