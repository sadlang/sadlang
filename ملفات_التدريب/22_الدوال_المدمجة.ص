# القسم 6: المصفوفات - عمليات مدمجة
اطبع_سطر("=== عمليات المصفوفات ===")
متغير م = [10، 20، 30، 40، 50]
اطبع_سطر("المصفوفة: " + م)
اطبع_سطر("طول: " + طول(م))

# إضافة عنصر
م.اضف(60)
اطبع_سطر("بعد اضف(60): " + م)

# حذف وإرجاع آخر عنصر
متغير آخر = م.احذف_اخير()
اطبع_سطر("احذف_اخير() أرجع: " + آخر)
اطبع_سطر("بعد الحذف: " + م)

# فهرس عنصر
اطبع_سطر("فهرس(30) = " + م.فهرس(30))

# يحتوي
اطبع_سطر("يحتوي(20) = " + م.يحتوي(20))
اطبع_سطر("يحتوي(99) = " + م.يحتوي(99))

# القسم 7: النصوص - عمليات مدمجة
اطبع_سطر("=== عمليات النصوص ===")
متغير نص = "مرحباً بالعالم العربي"
اطبع_سطر("النص: " + نص)
اطبع_سطر("طول: " + طول(نص))

# الوصول بالفهرس
اطبع_سطر("نص[0] = " + نص[0])

# يحتوي
اطبع_سطر("يحتوي('العالم') = " + نص.يحتوي("العالم"))

# يبدأ_بـ وينتهي_بـ
اطبع_سطر("يبدأ_بـ('مرحباً') = " + نص.يبدأ_بـ("مرحباً"))
اطبع_سطر("ينتهي_بـ('العربي') = " + نص.ينتهي_بـ("العربي"))

# تقسيم
متغير أجزاء = نص.قسّم(" ")
اطبع_سطر("تقسيم بمسافة: " + أجزاء)

# صل (join)
متغير مصفوفة_كلمات = ["أ"، "ب"، "ج"]
اطبع_سطر("صل بفاصلة: " + مصفوفة_كلمات.صل("، "))

# استبدال
متغير نص2 = "مرحبا يا عالم"
اطبع_سطر("استبدال: " + نص2.استبدل("عالم"، "دنيا"))

