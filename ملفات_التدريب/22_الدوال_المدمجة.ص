اطبع_سطر("حجم: " + خ.حجم())

# القسم 9: دوال رياضية
اطبع_سطر("=== دوال رياضية ===")
# حساب القيمة المطلقة يدوياً
دالة مطلقة(ن)
    إذا (ن < 0)
        ارجع ن * -1
    نهاية
    ارجع ن
نهاية
اطبع_سطر("مطلقة(-15) = " + مطلقة(-15))
اطبع_سطر("2 ** 10 = " + (2 ** 10))
