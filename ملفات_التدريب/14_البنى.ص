# --- القسم 1: بنية بسيطة ---
اطبع_سطر("=== بنية بسيطة ===")

بنية نقطة
    رقم س = 0
    رقم ص = 0
نهاية

متغير ن1 = جديد نقطة()
ن1.س = 5
ن1.ص = 10
اطبع_سطر("النقطة: (" + ن1.س + "، " + ن1.ص + ")")

# --- القسم 2: بنية مع أنواع مختلفة ---
اطبع_سطر("=== بنية مختلطة ===")

بنية شخص
    نص الاسم = ""
    رقم العمر = 0
    نص المدينة = ""
نهاية

متغير ش = جديد شخص()
ش.الاسم = "أحمد"
ش.العمر = 25
ش.المدينة = "الرياض"
اطبع_سطر(ش.الاسم + " — عمره " + ش.العمر + " من " + ش.المدينة)

# --- القسم 3: مصفوفة من البنى ---
اطبع_سطر("=== مصفوفة بنى ===")

بنية طالب
    نص الاسم = ""
    رقم الدرجة = 0
نهاية

دالة انشئ_طالب(اسم، درجة)
    متغير ط = جديد طالب()
    ط.الاسم = اسم
    ط.الدرجة = درجة
    ارجع ط
نهاية

متغير الطلاب = [
    انشئ_طالب("أحمد"، 85)،
    انشئ_طالب("سارة"، 92)،
    انشئ_طالب("محمد"، 78)،
    انشئ_طالب("فاطمة"، 95)
]

لكل ط في الطلاب
    اطبع_سطر(ط.الاسم + ": " + ط.الدرجة)
نهاية

# --- القسم 4: تعديل حقول البنية ---
اطبع_سطر("=== تعديل حقول ===")

بنية مستطيل
    رقم العرض = 0
    رقم الارتفاع = 0
نهاية

متغير م = جديد مستطيل()
م.العرض = 10
م.الارتفاع = 5

اطبع_سطر("المستطيل: " + م.العرض + " × " + م.الارتفاع)
اطبع_سطر("المساحة: " + م.العرض * م.الارتفاع)
اطبع_سطر("المحيط: " + 2 * (م.العرض + م.الارتفاع))

# --- القسم 5: بنية مع دالة مساعدة ---
اطبع_سطر("=== دوال مساعدة ===")

بنية لون
    رقم أحمر = 0
    رقم أخضر = 0
    رقم أزرق = 0
نهاية

دالة انشئ_لون(ح، خ، ز)
    متغير ل = جديد لون()
    ل.أحمر = ح
    ل.أخضر = خ
    ل.أزرق = ز
    ارجع ل
نهاية

دالة وصف_لون(ل)
    ارجع "RGB(" + ل.أحمر + "، " + ل.أخضر + "، " + ل.أزرق + ")"
نهاية

متغير أبيض = انشئ_لون(255، 255، 255)
متغير أسود = انشئ_لون(0، 0، 0)
متغير أحمر = انشئ_لون(255، 0، 0)

اطبع_سطر("أبيض: " + وصف_لون(أبيض))
اطبع_سطر("أسود: " + وصف_لون(أسود))
اطبع_سطر("أحمر: " + وصف_لون(أحمر))

اطبع_سطر("=== انتهى ملف البنى ===")