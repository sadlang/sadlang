# ملف تدريب 32: الأصناف المجردة (Abstract Classes)
# =====================================================
# الصنف المجرد لا يمكن إنشاء كائن منه مباشرة
# الترتيب: صنف مجرد (الصفة بعد الموصوف)
# الدالة المجردة: دالة مجرد (بدون جسم)
# =====================================================

# === صنف مجرد: شكل هندسي ===
صنف مجرد شكل
    دالة مجرد المساحة()
    دالة مجرد المحيط()
    
    دالة وصف()
        ارجع "شكل هندسي - المساحة: " + هذا.المساحة()
    نهاية
نهاية

# === دائرة ترث من شكل ===
صنف دائرة يرث شكل
    باني(نق)
        هذا.نصف_القطر = نق
    نهاية
    
    دالة المساحة()
        ارجع 3.14159 * هذا.نصف_القطر ** 2
    نهاية
    
    دالة المحيط()
        ارجع 2 * 3.14159 * هذا.نصف_القطر
    نهاية
نهاية

# === مستطيل يرث من شكل ===
صنف مستطيل يرث شكل
    باني(ط، ع)
        هذا.الطول = ط
        هذا.العرض = ع
    نهاية
    
    دالة المساحة()
        ارجع هذا.الطول * هذا.العرض
    نهاية
    
    دالة المحيط()
        ارجع 2 * (هذا.الطول + هذا.العرض)
    نهاية
نهاية

# === مثلث يرث من شكل ===
صنف مثلث يرث شكل
    باني(قاعدة، ارتفاع، ض١، ض٢، ض٣)
        هذا.القاعدة = قاعدة
        هذا.الارتفاع = ارتفاع
        هذا.ض١ = ض١
        هذا.ض٢ = ض٢
        هذا.ض٣ = ض٣
    نهاية
    
    دالة المساحة()
        ارجع 0.5 * هذا.القاعدة * هذا.الارتفاع
    نهاية
    
    دالة المحيط()
        ارجع هذا.ض١ + هذا.ض٢ + هذا.ض٣
    نهاية
نهاية

# === اختبار تعدد الأشكال ===
اطبع_سطر("=== الأشكال الهندسية ===")
متغير أشكال = [
    جديد دائرة(5)،
    جديد مستطيل(4، 6)،
    جديد مثلث(3، 4، 3، 4، 5)
]

متغير أسماء = ["دائرة"، "مستطيل"، "مثلث"]
متغير ع = 0
لكل شكل في أشكال
    اطبع_سطر("--- " + أسماء[ع] + " ---")
    اطبع_سطر("  المساحة: " + شكل.المساحة())
    اطبع_سطر("  المحيط: " + شكل.المحيط())
    اطبع_سطر("  الوصف: " + شكل.وصف())
    ع = ع + 1
نهاية

# === محاولة إنشاء صنف مجرد مباشرة (خطأ) ===
اطبع_سطر("")
اطبع_سطر("=== اختبار منع إنشاء المجرد ===")
حاول
    متغير ش = جديد شكل()
    اطبع_سطر("⚠️ لا يجب أن نصل هنا!")
امسك خطأ
    اطبع_سطر("✅ تم منع إنشاء صنف مجرد: " + خطأ)
نهاية

# === صنف مجرد مع دوال ملموسة ===
صنف مجرد كائن_حي
    دالة مجرد تنفس()
    
    دالة حياة()
        ارجع "أنا كائن حي"
    نهاية
نهاية

صنف إنسان يرث كائن_حي
    باني(اسم)
        هذا.اسم = اسم
    نهاية
    
    دالة تنفس()
        ارجع هذا.اسم + " يتنفس"
    نهاية
نهاية

متغير شخص = جديد إنسان("أحمد")
اطبع_سطر("")
اطبع_سطر("=== كائن حي ===")
اطبع_سطر(شخص.حياة())
اطبع_سطر(شخص.تنفس())

# === مجموع المساحات ===
اطبع_سطر("")
اطبع_سطر("=== مجموع المساحات ===")
متغير مجموع = 0
لكل ش في أشكال
    مجموع = مجموع + ش.المساحة()
نهاية
اطبع_سطر("  المجموع: " + مجموع)

اطبع_سطر("✅ تم اختبار الأصناف المجردة بنجاح!")
