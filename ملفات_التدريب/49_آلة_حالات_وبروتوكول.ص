# ═══════════ صنف: آلة_حالات (FSM) ═══════════

صنف آلة_حالات
    متغير عام الاسم
    متغير خاص _الوضع_الحالي
    متغير خاص _الانتقالات
    متغير خاص _السجل
    متغير خاص _المحفوظات
    متغير خاص _عداد_انتقالات

    باني(اسم، وضع_أولي)
        هذا.الاسم = اسم
        هذا._الوضع_الحالي = وضع_أولي
        هذا._الانتقالات = []
        هذا._السجل = جديد سجل_أحداث()
        هذا._المحفوظات = [وضع_أولي]
        هذا._عداد_انتقالات = 0
        هذا._السجل.سجل("معلومات"، م"آلة '{اسم}' بدأت بالوضع: {وضع_أولي}")
    نهاية

    دالة عام اضف_انتقال(انتقال)
        هذا._الانتقالات.اضف(انتقال)
    نهاية

    دالة عام الوضع()
        ارجع هذا._الوضع_الحالي
    نهاية

    # معالجة حدث — إيجاد انتقال مناسب وتنفيذه
    دالة عام عالج(حدث)
        متغير وجد = خطأ
        لكل ا في هذا._الانتقالات
            إذا (ا.من_وضع == هذا._الوضع_الحالي و ا.الحدث == حدث)
                # التحقق من الشرط
                متغير مسموح = صحيح
                إذا (ا.الشرط != لاشيء)
                    مسموح = ا.الشرط()
                نهاية

                إذا (مسموح)
                    متغير سابق = هذا._الوضع_الحالي
                    هذا._الوضع_الحالي = ا.إلى_وضع
                    هذا._عداد_انتقالات = هذا._عداد_انتقالات + 1
                    هذا._المحفوظات.اضف(هذا._الوضع_الحالي)

                    هذا._السجل.سجل("معلومات"، م"انتقال: {سابق} → {هذا._الوضع_الحالي} [حدث: {حدث}]")

                    # تنفيذ الفعل
                    إذا (ا.الفعل != لاشيء)
                        ا.الفعل()
                    نهاية

                    وجد = صحيح
                    توقف
                وإلا
                    هذا._السجل.سجل("تحذير"، م"شرط لم يتحقق: {حدث} في {هذا._الوضع_الحالي}")
                نهاية
            نهاية
        نهاية

        إذا (وجد == خطأ)
            هذا._السجل.سجل("خطأ"، م"حدث غير معروف: '{حدث}' في الوضع '{هذا._الوضع_الحالي}'")
        نهاية

        ارجع وجد
    نهاية

    دالة عام إعادة_ضبط(وضع)
        هذا._الوضع_الحالي = وضع
        هذا._المحفوظات = [وضع]
        هذا._عداد_انتقالات = 0
        هذا._السجل.سجل("معلومات"، م"تم إعادة الضبط إلى: {وضع}")
    نهاية

    دالة عام عدد_الانتقالات()
        ارجع هذا._عداد_انتقالات
    نهاية

    دالة عام المحفوظات()
        ارجع هذا._المحفوظات
    نهاية

    دالة عام السجل()
        ارجع هذا._السجل
    نهاية
نهاية

# ═══════════ طرق الامتداد ═══════════

امتداد آلة_حالات
    دالة اطبع_المحفوظات()
        متغير م = هذا.المحفوظات()
        اطبع_سطر(م"  المحفوظات ({طول(م)} خطوات):")
        متغير ع = 0
        بينما (ع < طول(م))
            إذا (ع < طول(م) - 1)
                اطبع(م"  {م[ع]} →")
            وإلا
                اطبع_سطر(م"  [{م[ع]}]")
            نهاية
            ع = ع + 1
        نهاية
    نهاية
نهاية

# ═══════════ صنف: محاكي_بروتوكول ═══════════

صنف محاكي_بروتوكول
    متغير خاص _آلة
    متغير خاص _المخزن_صادر
    متغير خاص _المخزن_وارد
    متغير خاص _العداد
    متغير خاص _الرسائل_مؤكدة
    متغير خاص _النبضات
    متغير عام المعرف

    باني(معرف)
        هذا.المعرف = معرف
        هذا._العداد = 0
        هذا._الرسائل_مؤكدة = 0
        هذا._النبضات = 0
        هذا._المخزن_صادر = جديد مخزن_مؤقت(20)
        هذا._المخزن_وارد = جديد مخزن_مؤقت(20)

        # إعداد آلة الحالات
        هذا._آلة = جديد آلة_حالات(م"بروتوكول-{معرف}"، "غير_متصل")

        # تعريف الانتقالات
        هذا._آلة.اضف_انتقال(جديد انتقال("غير_متصل"، "مصافحة"، "اتصل"))
        هذا._آلة.اضف_انتقال(جديد انتقال("مصافحة"، "متصل"، "مصافحة_نجحت"))
        هذا._آلة.اضف_انتقال(جديد انتقال("مصافحة"، "خطأ"، "مصافحة_فشلت"))
        هذا._آلة.اضف_انتقال(جديد انتقال("متصل"، "إرسال"، "أرسل"))
        هذا._آلة.اضف_انتقال(جديد انتقال("متصل"، "استقبال"، "استقبل"))
        هذا._آلة.اضف_انتقال(جديد انتقال("متصل"، "متصل"، "نبض"))
        هذا._آلة.اضف_انتقال(جديد انتقال("إرسال"، "متصل"، "تم_الإرسال"))
        هذا._آلة.اضف_انتقال(جديد انتقال("استقبال"، "متصل"، "تم_الاستقبال"))
        هذا._آلة.اضف_انتقال(جديد انتقال("متصل"، "إغلاق"، "أغلق"))
        هذا._آلة.اضف_انتقال(جديد انتقال("إغلاق"، "غير_متصل"، "تم_الإغلاق"))
        هذا._آلة.اضف_انتقال(جديد انتقال("خطأ"، "غير_متصل"، "إعادة_ضبط"))
    نهاية

    دالة عام الوضع()
        ارجع هذا._آلة.الوضع()
    نهاية

    دالة عام اتصل()
        ارجع هذا._آلة.عالج("اتصل")
    نهاية

    دالة عام مصافحة()
        # محاكاة نجاح المصافحة
        ارجع هذا._آلة.عالج("مصافحة_نجحت")
    نهاية

    دالة عام أرسل_رسالة(مستقبل، محتوى)
        يتطلب هذا._آلة.الوضع() == "متصل"
        هذا._العداد = هذا._العداد + 1
        متغير ر = جديد رسالة("بيانات"، محتوى، هذا.المعرف، مستقبل، هذا._العداد)
        هذا._المخزن_صادر.اضف(ر)

        # انتقل إلى وضع الإرسال ثم ارجع
        هذا._آلة.عالج("أرسل")
        هذا._آلة.عالج("تم_الإرسال")

        سجل!("معلومات"، م"{هذا.المعرف}: أرسل → {مستقبل}: '{محتوى}'")
        ارجع ر
    نهاية

    دالة عام استقبل_رسالة(رسالة)
        يتطلب هذا._آلة.الوضع() == "متصل"
        هذا._المخزن_وارد.اضف(رسالة)

        هذا._آلة.عالج("استقبل")
        هذا._آلة.عالج("تم_الاستقبال")

        سجل!("معلومات"، م"{هذا.المعرف}: استقبل ← {رسالة.المرسل}: '{رسالة.المحتوى}'")
    نهاية

    دالة عام أكد_رسالة(رقم)
        هذا._الرسائل_مؤكدة = هذا._الرسائل_مؤكدة + 1
        سجل!("تتبع"، م"{هذا.المعرف}: تأكيد رسالة #{رقم}")
    نهاية

    دالة عام نبض()
        يتطلب هذا._آلة.الوضع() == "متصل"
        هذا._آلة.عالج("نبض")
        هذا._النبضات = هذا._النبضات + 1
    نهاية

    دالة عام أغلق()
        إذا (هذا._آلة.الوضع() == "متصل")
            هذا._آلة.عالج("أغلق")
            هذا._آلة.عالج("تم_الإغلاق")
            سجل!("معلومات"، م"{هذا.المعرف}: تم الإغلاق")
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة عام إحصائيات()
        ارجع {
            "المعرف": هذا.المعرف،
            "الوضع": هذا.الوضع()،
            "رسائل_صادرة": هذا._المخزن_صادر.الحجم()،
            "رسائل_واردة": هذا._المخزن_وارد.الحجم()،
            "مؤكدة": هذا._الرسائل_مؤكدة،
            "نبضات": هذا._النبضات،
            "انتقالات": هذا._آلة.عدد_الانتقالات()
        }
    نهاية

    دالة عام الرسائل_الصادرة()
        ارجع هذا._المخزن_صادر.الكل()
    نهاية

    دالة عام الرسائل_الواردة()
        ارجع هذا._المخزن_وارد.الكل()
    نهاية
نهاية

# ═══════════ دالة: محاكاة الاتصال ═══════════

دالة محاكاة_اتصال(عقدة_أ، عقدة_ب)
    أجّل اطبع_سطر("  📎 انتهت جلسة الاتصال")

    اطبع_سطر(م"  🔗 محاكاة اتصال: {عقدة_أ.المعرف} ↔ {عقدة_ب.المعرف}")

    # الاتصال
    عقدة_أ.اتصل()
    عقدة_أ.مصافحة()
    عقدة_ب.اتصل()
    عقدة_ب.مصافحة()

    اطبع_سطر(م"  وضع {عقدة_أ.المعرف}: {عقدة_أ.الوضع()}")
    اطبع_سطر(م"  وضع {عقدة_ب.المعرف}: {عقدة_ب.الوضع()}")

    # تبادل الرسائل
    متغير ر1 = عقدة_أ.أرسل_رسالة(عقدة_ب.المعرف، "مرحبا!")
    عقدة_ب.استقبل_رسالة(ر1)
    عقدة_ب.أكد_رسالة(ر1.الرقم_التسلسلي)

    متغير ر2 = عقدة_ب.أرسل_رسالة(عقدة_أ.المعرف، "أهلاً وسهلاً!")
    عقدة_أ.استقبل_رسالة(ر2)
    عقدة_أ.أكد_رسالة(ر2.الرقم_التسلسلي)

    متغير ر3 = عقدة_أ.أرسل_رسالة(عقدة_ب.المعرف، "كيف حالك؟")
    عقدة_ب.استقبل_رسالة(ر3)
    عقدة_ب.أكد_رسالة(ر3.الرقم_التسلسلي)

    # نبضات
    عقدة_أ.نبض()
    عقدة_ب.نبض()
    عقدة_أ.نبض()

    # إغلاق
    عقدة_أ.أغلق()
    عقدة_ب.أغلق()
نهاية

