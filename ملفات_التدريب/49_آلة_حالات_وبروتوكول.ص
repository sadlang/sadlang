# ═══════════ صنف: مخزن_مؤقت (Buffer) ═══════════

صنف مخزن_مؤقت
    متغير خاص _بيانات
    متغير خاص _السعة

    باني(سعة)
        إذا (سعة <= 0)
            ارمي "السعة يجب أن تكون موجبة"
        نهاية
        هذا._بيانات = []
        هذا._السعة = سعة
    نهاية

    دالة عام اضف(عنصر)
        يتطلب طول(هذا._بيانات) < هذا._السعة
        هذا._بيانات.اضف(عنصر)
    نهاية

    دالة عام استخرج()
        يتطلب طول(هذا._بيانات) > 0
        متغير أول = هذا._بيانات[0]
        # إزالة أول عنصر
        متغير جديدة = []
        متغير ع = 1
        بينما (ع < طول(هذا._بيانات))
            جديدة.اضف(هذا._بيانات[ع])
            ع = ع + 1
        نهاية
        هذا._بيانات = جديدة
        ارجع أول
    نهاية

    دالة عام اطلع()
        يتطلب طول(هذا._بيانات) > 0
        ارجع هذا._بيانات[0]
    نهاية

    دالة عام الحجم()
        ارجع طول(هذا._بيانات)
    نهاية

    دالة عام فارغ()
        ارجع طول(هذا._بيانات) == 0
    نهاية

    دالة عام ممتلئ()
        ارجع طول(هذا._بيانات) >= هذا._السعة
    نهاية

    دالة عام أفرغ()
        هذا._بيانات = []
    نهاية

    دالة عام الكل()
        ارجع هذا._بيانات
    نهاية
نهاية

# ═══════════ صنف: سجل_أحداث ═══════════

صنف سجل_أحداث
