# --- القسم 5: التكرار ---
اطبع_سطر("=== التكرار ===")

متغير ألوان = ["أحمر"، "أخضر"، "أزرق"]
لكل لون في ألوان
    اطبع_سطر("اللون: " + لون)
نهاية

# التكرار بالفهرس
اطبع_سطر("--- بالفهرس ---")
متغير ف = 0
بينما (ف < ألوان.الطول())
    اطبع_سطر("ألوان[" + ف + "] = " + ألوان[ف])
    ف += 1
نهاية

