# --- القسم 10: أمثلة عملية ---
اطبع_سطر("=== أمثلة عملية ===")

# مجموع مصفوفة
دالة مجموع_مصفوفة(م)
    متغير المجموع = 0
    لكل عنصر في م
        المجموع += عنصر
    نهاية
    ارجع المجموع
نهاية

اطبع_سطر("مجموع [1,2,3,4,5]: " + مجموع_مصفوفة([1، 2، 3، 4، 5]))

# فرز فقاعي
دالة فرز_فقاعي(م)
    متغير الحجم = م.الطول()
    متغير ف = 0
    بينما (ف < الحجم)
        متغير ج = 0
        بينما (ج < الحجم - ف - 1)
            إذا (م[ج] > م[ج + 1])
                متغير مؤقت = م[ج]
                م[ج] = م[ج + 1]
                م[ج + 1] = مؤقت
            نهاية
            ج += 1
        نهاية
        ف += 1
    نهاية
    ارجع م
نهاية

متغير غير_مرتبة = [5، 3، 8، 1، 9، 2]
اطبع_سطر("قبل الفرز: " + غير_مرتبة)
متغير مرتبة = فرز_فقاعي(غير_مرتبة)
اطبع_سطر("بعد الفرز: " + مرتبة)

اطبع_سطر("=== انتهى ملف المصفوفات ===")
