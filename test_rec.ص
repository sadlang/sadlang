## Minimal: recursive call from بينما loop

صنف معالج
    رقم ن

    باني(رقم ابتداء)
        هذا.ن = ابتداء
    نهاية

    دالة معالج_داخلي()
        متغير م = هذا
        # يستهلك جميع الموارد المتبقية (ن→10)
        م.ن = 10
        ارجع "داخلي"
    نهاية

    دالة تشغيل()
        متغير م = هذا
        متغير نتيجة = ""
        بينما (م.ن < 10)
            متغير طفل = م.معالج_داخلي()
            نتيجة = نتيجة + طفل
        نهاية
        ارجع نتيجة
    نهاية
نهاية

# اختبار: ن=0, يستدعي معالج_داخلي الذي يضبط ن=10
# إذاً: 1 تكرار، نتيجة = "داخلي"
متغير م = جديد معالج(0)
اطبع("نتيجة: ")
اطبع_سطر(م.تشغيل())
اطبع("ن النهائي: ")
اطبع_سطر(م.ن)
