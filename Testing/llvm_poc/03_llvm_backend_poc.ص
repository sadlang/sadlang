#**
 * إثبات مفهوم — الحاجز ١: خلفيّة LLVM-IR نصّيّة تُستدعى خارجيًّا
 * لغة ص تبني نصّ LLVM-IR، تكتبه، وتستدعي llc + clang عبر نفذ_امر.
 **#

استورد أساسيات
استورد تأكيدات

# ═══ ثوابت المسارات (لا سلاسل مباشرة منطقيّة متكرّرة) ═══
متغير مجلد = "Testing/llvm_poc/"
متغير ملف_ير = مجلد + "out.ll"
متغير ملف_أسم = مجلد + "out.s"
متغير ملف_تنفيذ = مجلد + "out.exe"
متغير أمر_تنفيذ = "Testing\\llvm_poc\\out.exe"
متغير llc = "C:\\llvm_dev\\LLVM\\bin\\llc.exe"
متغير clang = "C:\\llvm_dev\\LLVM\\bin\\clang.exe"

# ═══ ① بناء نصّ LLVM-IR في متغيّر نصّيّ ═══
متغير ير = ""
ير = ير + "; مولَّد بلغة ص — الحاجز ١ PoC\n"
ير = ير + "define i32 @main() {\n"
ير = ير + "entry:\n"
ير = ير + "  ret i32 42\n"
ير = ير + "}\n"

اطبع("═══ نصّ LLVM-IR المولَّد ═══")
اطبع(ير)

# ═══ ② كتابته إلى out.ll ═══
اكتب_ملف(ملف_ير, ير)
إذا (هل_موجود(ملف_ير))
    اطبع("PASS: كُتب out.ll")
وإلا
    اطبع("FAIL: تعذّر كتابة out.ll")
نهاية

# ═══ ③ استدعاء llc: out.ll -> out.s ═══
متغير أمر_llc = llc + " " + ملف_ير + " -o " + ملف_أسم
اطبع("تشغيل: " + أمر_llc)
متغير رمز_llc = نفذ_امر(أمر_llc)
اطبع("رمز llc:")
اطبع(رمز_llc)

# ═══ ④ التجميع + الربط: out.s -> out.exe ═══
متغير أمر_clang = clang + " " + ملف_أسم + " -o " + ملف_تنفيذ
اطبع("تشغيل: " + أمر_clang)
متغير رمز_clang = نفذ_امر(أمر_clang)
اطبع("رمز clang:")
اطبع(رمز_clang)

# ═══ ⑤ تنفيذ الناتج والتقاط رمز الخروج ═══
إذا (هل_موجود(ملف_تنفيذ))
    اطبع("PASS: أُنتج out.exe")
    متغير رمز_تنفيذ = نفذ_امر(أمر_تنفيذ)
    اطبع("رمز خروج البرنامج المولَّد (متوقّع 42):")
    اطبع(رمز_تنفيذ)
وإلا
    اطبع("FAIL: لم يُنتَج out.exe")
نهاية
