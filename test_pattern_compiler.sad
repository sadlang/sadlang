# اختبار pattern matching للمترجم
# Pattern matching compiler test

دالة رئيسية()
    # --- 1. مطابقة ارقام ---
    اطبع_سطر("--- 1. مطابقة ارقام ---")
    متغير س = 42
    طابق س
        حالة 42:
            اطبع_سطر("الرقم هو 42 - صحيح!")
        حالة _:
            اطبع_سطر("رقم آخر")
    نهاية

    # --- 2. مطابقة نصوص ---
    اطبع_سطر("--- 2. مطابقة نصوص ---")
    متغير لون = "ازرق"
    طابق لون
        حالة "احمر":
            اطبع_سطر("اللون احمر")
        حالة "ازرق":
            اطبع_سطر("اللون ازرق - صحيح!")
        حالة _:
            اطبع_سطر("لون غير معروف")
    نهاية

    # --- 3. النمط الشامل ---
    اطبع_سطر("--- 3. النمط الشامل ---")
    متغير ق = 999
    طابق ق
        حالة 1:
            اطبع_سطر("واحد")
        حالة 2:
            اطبع_سطر("اثنان")
        حالة _:
            اطبع_سطر("قيمة اخرى - صحيح!")
    نهاية

    # --- 4. مطابقة قيم منطقية ---
    اطبع_سطر("--- 4. قيم منطقية ---")
    متغير ن = صحيح
    طابق ن
        حالة صحيح:
            اطبع_سطر("النتيجة صحيحة - صحيح!")
        حالة خطأ:
            اطبع_سطر("النتيجة خاطئة")
    نهاية

    # --- 5. مطابقة الصفر ---
    اطبع_سطر("--- 5. مطابقة الصفر ---")
    متغير ص = 0
    طابق ص
        حالة 0:
            اطبع_سطر("القيمة صفر - صحيح!")
        حالة _:
            اطبع_سطر("قيمة غير صفرية")
    نهاية

    # --- 6. match متعدد ---
    اطبع_سطر("--- 6. match متعدد ---")
    متغير ع = 15
    طابق ع
        حالة 10:
            اطبع_سطر("عشرة")
        حالة 15:
            اطبع_سطر("خمسة عشر - صحيح!")
        حالة 20:
            اطبع_سطر("عشرون")
        حالة _:
            اطبع_سطر("رقم آخر")
    نهاية

    اطبع_سطر("=== اكتمل الاختبار ===")
    ارجع 0
نهاية
