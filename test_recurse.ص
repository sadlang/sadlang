## Minimal: RECURSIVE call to SAME METHOD from inside loop body

صنف معالج
    رقم ن

    باني(رقم ابتداء)
        هذا.ن = ابتداء
    نهاية

    دالة معالج_داخلي()
        متغير م = هذا
        م.ن = م.ن + 1  # advance ن
        # استدعاء تشغيل() بشكل متكرر — نفس الدالة التي استدعتنا
        متغير نتيجة_داخلية = م.تشغيل()
        ارجع "د(" + نتيجة_داخلية + ")"
    نهاية

    دالة تشغيل()
        متغير م = هذا
        متغير نتيجة = ""
        بينما (م.ن < 3)
            متغير طفل = م.معالج_داخلي()
            نتيجة = نتيجة + طفل
        نهاية
        ارجع نتيجة
    نهاية
نهاية

# ن=0:
# تشغيل() → loop (0<3): معالج_داخلي() → ن=1 → تشغيل() → loop (1<3): معالج_داخلي() → ن=2 → تشغيل() → loop (2<3): معالج_داخلي() → ن=3 → تشغيل() → loop(3<3=false) → returns "" 
# Back up chain: returns "د()" then "د(د())" then "د(د(د()))"
متغير م = جديد معالج(0)
اطبع("نتيجة: ")
اطبع_سطر(م.تشغيل())
اطبع("ن النهائي: ")
اطبع_سطر(م.ن)
