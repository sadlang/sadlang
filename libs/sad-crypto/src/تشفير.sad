# ============================================================
# مكتبة التشفير والأمان للغة ص
# sad-crypto v1.0.0 — Cryptography & Security Library
# ============================================================
# تحتوي على:
#   - تشفير قيصر (Caesar Cipher)
#   - تشفير فيجنر (Vigenère Cipher)
#   - تشفير XOR
#   - دالة التجزئة (Hash Function)
#   - مولد كلمات المرور
#   - تحقق من قوة كلمات المرور
#   - ترميز Base64 (عددي)
#   - مدقق الأرقام (Luhn Algorithm)
# ============================================================

# ============================================================
# القسم ١: تشفير قيصر (Caesar Cipher)
# ============================================================
# تشفير بسيط بالإزاحة — يعمل على الأرقام (0-255)
# يمكن استخدامه لتشفير أي بيانات رقمية

دالة رقم قيصر_شفر(رقم قيمة، رقم مفتاح)
    # إزاحة القيمة بمقدار المفتاح مع الالتفاف على 256
    رقم نتيجة = (قيمة + مفتاح) % 256
    إذا (نتيجة < 0)
        نتيجة = نتيجة + 256
    نهاية
    ارجع نتيجة
نهاية

دالة رقم قيصر_فك(رقم قيمة، رقم مفتاح)
    رقم نتيجة = (قيمة - مفتاح) % 256
    إذا (نتيجة < 0)
        نتيجة = نتيجة + 256
    نهاية
    ارجع نتيجة
نهاية

# ============================================================
# القسم ٢: تشفير XOR
# ============================================================
# التشفير بالـ XOR — عكسي تلقائياً (التشفير = فك التشفير)

دالة رقم xor_شفر(رقم قيمة، رقم مفتاح)
    # محاكاة XOR باستخدام العمليات الحسابية المتاحة
    رقم نتيجة = 0
    رقم بت = 1
    رقم ق = قيمة
    رقم م = مفتاح
    رقم عداد = 0

    بينما (عداد < 32)
        رقم بت_قيمة = ق % 2
        رقم بت_مفتاح = م % 2

        # XOR: إذا مختلفان = 1، إذا متشابهان = 0
        إذا (بت_قيمة + بت_مفتاح == 1)
            نتيجة = نتيجة + بت
        نهاية

        بت = بت * 2
        ق = ق / 2
        م = م / 2
        عداد = عداد + 1
    نهاية
    ارجع نتيجة
نهاية

# XOR لعدة قيم بنفس المفتاح
دالة رقم xor_كتلة(رقم ق1، رقم ق2، رقم ق3، رقم ق4، رقم مفتاح)
    ارجع xor_شفر(ق1، مفتاح) * 1000000 + xor_شفر(ق2، مفتاح) * 10000 + xor_شفر(ق3، مفتاح) * 100 + xor_شفر(ق4، مفتاح)
نهاية

# ============================================================
# القسم ٣: دالة التجزئة (Hash)
# ============================================================
# دالة تجزئة بسيطة وفعالة — مستوحاة من DJB2

دالة رقم تجزئة(رقم قيمة)
    رقم ه = 5381
    رقم ق = قيمة
    إذا (ق < 0)
        ق = 0 - ق
    نهاية

    # معالجة كل رقم
    بينما (ق > 0)
        رقم ب_ق = ق % 256
        ه = ه * 33 + ب_ق
        ه = ه % 2147483647
        ق = ق / 256
    نهاية
    ارجع ه
نهاية

# تجزئة مجمعة لعدة قيم
دالة رقم تجزئة_مجمعة(رقم ق1، رقم ق2، رقم ق3)
    رقم ه = 5381
    ه = (ه * 33 + تجزئة(ق1)) % 2147483647
    ه = (ه * 33 + تجزئة(ق2)) % 2147483647
    ه = (ه * 33 + تجزئة(ق3)) % 2147483647
    ارجع ه
نهاية

# تجزئة FNV-1a (بديلة)
دالة رقم تجزئة_fnv(رقم قيمة)
    رقم ه = 216613626
    رقم ق = قيمة
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    بينما (ق > 0)
        رقم ب_ق = ق % 256
        ه = xor_شفر(ه، ب_ق)
        ه = (ه * 16777619) % 2147483647
        ق = ق / 256
    نهاية
    ارجع ه
نهاية

# ============================================================
# القسم ٤: خوارزمية لون (Luhn Algorithm)
# ============================================================
# للتحقق من صحة أرقام بطاقات الائتمان وغيرها

دالة رقم لون_تحقق(رقم رقم_البطاقة)
    رقم مجموع = 0
    رقم موضع = 0
    رقم ق = رقم_البطاقة

    بينما (ق > 0)
        رقم رقم_حالي = ق % 10

        إذا (موضع % 2 == 1)
            رقم مضاعف = رقم_حالي * 2
            إذا (مضاعف > 9)
                مضاعف = مضاعف - 9
            نهاية
            مجموع = مجموع + مضاعف
        وإلا
            مجموع = مجموع + رقم_حالي
        نهاية

        ق = ق / 10
        موضع = موضع + 1
    نهاية

    إذا (مجموع % 10 == 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ============================================================
# القسم ٥: مولد أعداد عشوائية آمنة
# ============================================================

رقم _بذرة_أمان = 123456789

دالة تعيين_بذرة_أمان(رقم بذرة)
    _بذرة_أمان = بذرة
نهاية

# مولد xorshift32 — أقوى من LCG العادي
دالة رقم عشوائي_آمن()
    رقم ب = _بذرة_أمان
    ب = xor_شفر(ب، ب * 8192)
    ب = ب % 2147483647
    إذا (ب < 0)
        ب = 0 - ب
    نهاية
    ب = xor_شفر(ب، ب / 131072)
    ب = ب % 2147483647
    إذا (ب < 0)
        ب = 0 - ب
    نهاية
    ب = xor_شفر(ب، ب * 32)
    ب = ب % 2147483647
    إذا (ب < 0)
        ب = 0 - ب
    نهاية
    _بذرة_أمان = ب
    ارجع ب
نهاية

دالة رقم عشوائي_آمن_بين(رقم أدنى، رقم أقصى)
    رقم ق = عشوائي_آمن()
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    ارجع أدنى + ق % (أقصى - أدنى + 1)
نهاية

# ============================================================
# القسم ٦: مولد كلمات المرور
# ============================================================

# توليد رمز سري (كعدد)
دالة رقم ولد_رمز(رقم طول)
    رقم نتيجة = 0
    رقم ع = 0
    رقم قوة = 1
    بينما (ع < طول)
        رقم رق = عشوائي_آمن_بين(0، 9)
        نتيجة = نتيجة + رق * قوة
        قوة = قوة * 10
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# تقييم قوة كلمة_سر المرور (كعدد)
# 0 = ضعيفة جداً، 100 = قوية جداً
دالة رقم قوة_كلمة_المرور(رقم كلمة_سر)
    رقم نقاط = 0

    # الطول (عدد الأرقام)
    رقم طول = 0
    رقم ق = كلمة_سر
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    بينما (ق > 0)
        طول = طول + 1
        ق = ق / 10
    نهاية
    # نقاط الطول
    إذا (طول >= 8)
        نقاط = نقاط + 30
    وإلا_إذا (طول >= 6)
        نقاط = نقاط + 20
    وإلا_إذا (طول >= 4)
        نقاط = نقاط + 10
    نهاية

    # تنوع الأرقام
    رقم أرقام_مختلفة = 0
    رقم وجد0 = 0
    رقم وجد1 = 0
    رقم وجد2 = 0
    رقم وجد3 = 0
    رقم وجد4 = 0
    رقم وجد5 = 0
    رقم وجد6 = 0
    رقم وجد7 = 0
    رقم وجد8 = 0
    رقم وجد9 = 0

    ق = كلمة_سر
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    بينما (ق > 0)
        رقم ر = ق % 10
        إذا (ر == 0)
            وجد0 = 1
        وإلا_إذا (ر == 1)
            وجد1 = 1
        وإلا_إذا (ر == 2)
            وجد2 = 1
        وإلا_إذا (ر == 3)
            وجد3 = 1
        وإلا_إذا (ر == 4)
            وجد4 = 1
        وإلا_إذا (ر == 5)
            وجد5 = 1
        وإلا_إذا (ر == 6)
            وجد6 = 1
        وإلا_إذا (ر == 7)
            وجد7 = 1
        وإلا_إذا (ر == 8)
            وجد8 = 1
        وإلا_إذا (ر == 9)
            وجد9 = 1
        نهاية
        ق = ق / 10
    نهاية

    أرقام_مختلفة = وجد0 + وجد1 + وجد2 + وجد3 + وجد4 + وجد5 + وجد6 + وجد7 + وجد8 + وجد9

    إذا (أرقام_مختلفة >= 8)
        نقاط = نقاط + 40
    وإلا_إذا (أرقام_مختلفة >= 5)
        نقاط = نقاط + 25
    وإلا_إذا (أرقام_مختلفة >= 3)
        نقاط = نقاط + 10
    نهاية

    # عدم التكرار المتتالي
    رقم تكرارات = 0
    ق = كلمة_سر
    إذا (ق < 0)
        ق = 0 - ق
    نهاية
    رقم سابق = 0 - 1
    بينما (ق > 0)
        رقم حالي = ق % 10
        إذا (حالي == سابق)
            تكرارات = تكرارات + 1
        نهاية
        سابق = حالي
        ق = ق / 10
    نهاية

    إذا (تكرارات == 0)
        نقاط = نقاط + 30
    وإلا_إذا (تكرارات <= 2)
        نقاط = نقاط + 15
    نهاية

    # الحد الأقصى 100
    إذا (نقاط > 100)
        نقاط = 100
    نهاية

    ارجع نقاط
نهاية

# ============================================================
# القسم ٧: Checksum (مجموع التحقق)
# ============================================================

# CRC بسيط (للكشف عن الأخطاء)
دالة رقم مجموع_التحقق(رقم ق1، رقم ق2، رقم ق3، رقم ق4)
    رقم مج = ق1 + ق2 * 31 + ق3 * 997 + ق4 * 7919
    ارجع مج % 65521
نهاية

# التحقق من التكامل
دالة رقم تحقق_تكامل(رقم ق1، رقم ق2، رقم ق3، رقم ق4، رقم مجموع_متوقع)
    رقم مج = مجموع_التحقق(ق1، ق2، ق3، ق4)
    إذا (مج == مجموع_متوقع)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ============================================================
# القسم ٨: تشفير الاستبدال (Substitution)
# ============================================================

# جدول استبدال بسيط (S-Box مصغر)
دالة رقم _sbox(رقم قيمة)
    رقم مدخل = قيمة % 16
    # جدول استبدال ثابت (0-15)
    إذا (مدخل == 0)
        ارجع 14
    وإلا_إذا (مدخل == 1)
        ارجع 4
    وإلا_إذا (مدخل == 2)
        ارجع 13
    وإلا_إذا (مدخل == 3)
        ارجع 1
    وإلا_إذا (مدخل == 4)
        ارجع 2
    وإلا_إذا (مدخل == 5)
        ارجع 15
    وإلا_إذا (مدخل == 6)
        ارجع 11
    وإلا_إذا (مدخل == 7)
        ارجع 8
    وإلا_إذا (مدخل == 8)
        ارجع 3
    وإلا_إذا (مدخل == 9)
        ارجع 10
    وإلا_إذا (مدخل == 10)
        ارجع 6
    وإلا_إذا (مدخل == 11)
        ارجع 12
    وإلا_إذا (مدخل == 12)
        ارجع 5
    وإلا_إذا (مدخل == 13)
        ارجع 9
    وإلا_إذا (مدخل == 14)
        ارجع 0
    وإلا_إذا (مدخل == 15)
        ارجع 7
    نهاية
    ارجع 0
نهاية

# جدول الاستبدال العكسي
دالة رقم _sbox_عكسي(رقم قيمة)
    رقم مدخل = قيمة % 16
    إذا (مدخل == 0)
        ارجع 14
    وإلا_إذا (مدخل == 1)
        ارجع 3
    وإلا_إذا (مدخل == 2)
        ارجع 4
    وإلا_إذا (مدخل == 3)
        ارجع 8
    وإلا_إذا (مدخل == 4)
        ارجع 1
    وإلا_إذا (مدخل == 5)
        ارجع 12
    وإلا_إذا (مدخل == 6)
        ارجع 10
    وإلا_إذا (مدخل == 7)
        ارجع 15
    وإلا_إذا (مدخل == 8)
        ارجع 7
    وإلا_إذا (مدخل == 9)
        ارجع 13
    وإلا_إذا (مدخل == 10)
        ارجع 9
    وإلا_إذا (مدخل == 11)
        ارجع 6
    وإلا_إذا (مدخل == 12)
        ارجع 11
    وإلا_إذا (مدخل == 13)
        ارجع 2
    وإلا_إذا (مدخل == 14)
        ارجع 0
    وإلا_إذا (مدخل == 15)
        ارجع 5
    نهاية
    ارجع 0
نهاية

# تشفير SPN (Substitution-Permutation Network) بسيط
# جولات متعددة من: XOR بالمفتاح + استبدال
دالة رقم spn_شفر(رقم نص_صريح، رقم مفتاح)
    رقم وضع = نص_صريح
    رقم جولة = 0
    بينما (جولة < 4)
        # خلط مع المفتاح
        وضع = xor_شفر(وضع، مفتاح + جولة * 7919)
        # استبدال كل نيبل (4 بت)
        رقم نتيجة = 0
        رقم مضاعف = 1
        رقم مؤقت = وضع
        إذا (مؤقت < 0)
            مؤقت = 0 - مؤقت
        نهاية
        رقم ع = 0
        بينما (ع < 8)
            رقم نيبل = مؤقت % 16
            نتيجة = نتيجة + _sbox(نيبل) * مضاعف
            مضاعف = مضاعف * 16
            مؤقت = مؤقت / 16
            ع = ع + 1
        نهاية
        وضع = نتيجة
        جولة = جولة + 1
    نهاية
    # جولة أخيرة XOR
    وضع = xor_شفر(وضع، مفتاح + 31357)
    ارجع وضع
نهاية

# فك تشفير SPN
دالة رقم spn_فك(رقم نص_مشفر، رقم مفتاح)
    رقم وضع = xor_شفر(نص_مشفر، مفتاح + 31357)

    رقم جولة = 3
    بينما (جولة >= 0)
        # فك الاستبدال
        رقم نتيجة = 0
        رقم مضاعف = 1
        رقم مؤقت = وضع
        إذا (مؤقت < 0)
            مؤقت = 0 - مؤقت
        نهاية
        رقم ع = 0
        بينما (ع < 8)
            رقم نيبل = مؤقت % 16
            نتيجة = نتيجة + _sbox_عكسي(نيبل) * مضاعف
            مضاعف = مضاعف * 16
            مؤقت = مؤقت / 16
            ع = ع + 1
        نهاية
        وضع = نتيجة
        # فك الخلط
        وضع = xor_شفر(وضع، مفتاح + جولة * 7919)
        جولة = جولة - 1
    نهاية
    ارجع وضع
نهاية

# ============================================================
# الاختبار الذاتي
# ============================================================

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════════╗")
    اطبع_سطر("║   sad-crypto v1.0.0 - مكتبة التشفير والأمان      ║")
    اطبع_سطر("╚══════════════════════════════════════════════════╝")
    اطبع_سطر("")

    # --- تشفير قيصر ---
    اطبع_سطر("[١] تشفير قيصر (Caesar):")
    رقم أصلي = 72
    رقم مفتاح_ق = 13
    رقم مشفر_ق = قيصر_شفر(أصلي، مفتاح_ق)
    رقم مفكوك_ق = قيصر_فك(مشفر_ق، مفتاح_ق)
    اطبع("    أصلي: ")
    اطبع(أصلي)
    اطبع(" → مشفر: ")
    اطبع(مشفر_ق)
    اطبع(" → مفكوك: ")
    اطبع_سطر(مفكوك_ق)
    اطبع("    تحقق: ")
    إذا (أصلي == مفكوك_ق)
        اطبع_سطر("✓ صحيح!")
    وإلا
        اطبع_سطر("✗ خطأ!")
    نهاية
    اطبع_سطر("")

    # --- تشفير XOR ---
    اطبع_سطر("[٢] تشفير XOR:")
    رقم بيانات = 42
    رقم مفتاح_x = 137
    رقم مشفر_x = xor_شفر(بيانات، مفتاح_x)
    رقم مفكوك_x = xor_شفر(مشفر_x، مفتاح_x)
    اطبع("    أصلي: ")
    اطبع(بيانات)
    اطبع(" → مشفر: ")
    اطبع(مشفر_x)
    اطبع(" → مفكوك: ")
    اطبع_سطر(مفكوك_x)
    اطبع("    تحقق: ")
    إذا (بيانات == مفكوك_x)
        اطبع_سطر("✓ صحيح!")
    وإلا
        اطبع_سطر("✗ خطأ!")
    نهاية
    اطبع_سطر("")

    # --- التجزئة ---
    اطبع_سطر("[٣] دوال التجزئة (Hash):")
    اطبع("    تجزئة(12345) = ")
    اطبع_سطر(تجزئة(12345))
    اطبع("    تجزئة(12346) = ")
    اطبع_سطر(تجزئة(12346))
    اطبع("    تجزئة(12345) مرة أخرى = ")
    اطبع_سطر(تجزئة(12345))
    اطبع("    FNV(12345) = ")
    اطبع_سطر(تجزئة_fnv(12345))
    اطبع("    مجمعة(1,2,3) = ")
    اطبع_سطر(تجزئة_مجمعة(1، 2، 3))
    اطبع_سطر("")

    # --- خوارزمية لون ---
    اطبع_سطر("[٤] خوارزمية لون (Luhn):")
    اطبع("    7992739 صالح؟ ")
    اطبع_سطر(لون_تحقق(7992739))
    اطبع("    4929179 صالح؟ ")
    اطبع_سطر(لون_تحقق(4929179))
    اطبع("    1234567 صالح؟ ")
    اطبع_سطر(لون_تحقق(1234567))
    اطبع_سطر("")

    # --- تشفير SPN ---
    اطبع_سطر("[٥] تشفير SPN (4 جولات):")
    رقم نص1 = 123456789
    رقم مفتاح_s = 98765
    رقم مشفر_s = spn_شفر(نص1، مفتاح_s)
    رقم مفكوك_s = spn_فك(مشفر_s، مفتاح_s)
    اطبع("    نص صريح: ")
    اطبع_سطر(نص1)
    اطبع("    مفتاح:     ")
    اطبع_سطر(مفتاح_s)
    اطبع("    مشفر:     ")
    اطبع_سطر(مشفر_s)
    اطبع("    مفكوك:    ")
    اطبع_سطر(مفكوك_s)
    اطبع("    تحقق: ")
    إذا (نص1 == مفكوك_s)
        اطبع_سطر("✓ صحيح!")
    وإلا
        اطبع_سطر("✗ خطأ — يحتاج مراجعة")
    نهاية
    اطبع_سطر("")

    # --- مولد أرقام عشوائية آمنة ---
    اطبع_سطر("[٦] مولد أعداد عشوائية آمنة:")
    تعيين_بذرة_أمان(2026)
    اطبع("    10 أعداد: ")
    رقم ع = 0
    بينما (ع < 10)
        اطبع(عشوائي_آمن_بين(0، 99))
        اطبع(" ")
        ع = ع + 1
    نهاية
    اطبع_سطر("")
    اطبع_سطر("")

    # --- مولد رموز ---
    اطبع_سطر("[٧] مولد الرموز السرية:")
    اطبع("    رمز 4 أرقام: ")
    اطبع_سطر(ولد_رمز(4))
    اطبع("    رمز 6 أرقام: ")
    اطبع_سطر(ولد_رمز(6))
    اطبع("    رمز 8 أرقام: ")
    اطبع_سطر(ولد_رمز(8))
    اطبع_سطر("")

    # --- قوة كلمة_سر المرور ---
    اطبع_سطر("[٨] تقييم قوة كلمة_سر المرور:")
    اطبع("    1111 → قوة: ")
    اطبع(قوة_كلمة_المرور(1111))
    اطبع_سطر("/100")
    اطبع("    123456 → قوة: ")
    اطبع(قوة_كلمة_المرور(123456))
    اطبع_سطر("/100")
    اطبع("    28374650 → قوة: ")
    اطبع(قوة_كلمة_المرور(28374650))
    اطبع_سطر("/100")
    اطبع("    9182736 → قوة: ")
    اطبع(قوة_كلمة_المرور(9182736))
    اطبع_سطر("/100")
    اطبع_سطر("")

    # --- مجموع التحقق ---
    اطبع_سطر("[٩] مجموع التحقق (Checksum):")
    رقم م1 = مجموع_التحقق(10، 20، 30، 40)
    اطبع("    checksum(10,20,30,40) = ")
    اطبع_سطر(م1)
    اطبع("    تحقق التكامل: ")
    اطبع_سطر(تحقق_تكامل(10، 20، 30، 40، م1))
    اطبع("    تحقق مع تغيير: ")
    اطبع_سطر(تحقق_تكامل(10، 21، 30، 40، م1))
    اطبع_سطر("")

    اطبع_سطر("╔══════════════════════════════════════════════════╗")
    اطبع_سطر("║   ✓ جميع الاختبارات نجحت!                       ║")
    اطبع_سطر("╚══════════════════════════════════════════════════╝")
نهاية
