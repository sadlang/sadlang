# ============================================================
# مكتبة الرياضيات المتقدمة للغة ص
# sad-math v1.0.0 — Advanced Mathematics Library
# ============================================================
# تحتوي على:
#   - الثوابت الرياضية (ط، هـ، الجذر)
#   - دوال الأسس والقوى واللوغاريتمات
#   - العاملي والتوافيق والتباديل
#   - متتاليات (فيبوناتشي، الأعداد الأولية)
#   - خوارزميات الترتيب والبحث
#   - التحليل العددي (نيوتن رافسون)
#   - الإحصاء (المتوسط، الانحراف المعياري)
# ============================================================

# ===== الثوابت الرياضية =====
رقم ط = 3141592    # π × 10^6 (تقريب بالأعداد الصحيحة)
رقم هـ = 2718281    # e × 10^6

# ============================================================
# القسم ١: دوال الأرقام الأساسية
# ============================================================

دالة رقم القيمة_المطلقة(رقم س)
    إذا (س < 0)
        ارجع 0 - س
    نهاية
    ارجع س
نهاية

دالة رقم الاكبر(رقم أ، رقم ب)
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة رقم الاصغر(رقم أ، رقم ب)
    إذا (أ < ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

دالة رقم الحصر(رقم قيمة، رقم حد_ادنى، رقم حد_اقصى)
    إذا (قيمة < حد_ادنى)
        ارجع حد_ادنى
    نهاية
    إذا (قيمة > حد_اقصى)
        ارجع حد_اقصى
    نهاية
    ارجع قيمة
نهاية

دالة رقم الاشارة(رقم س)
    إذا (س > 0)
        ارجع 1
    وإلا_إذا (س < 0)
        ارجع 0 - 1
    نهاية
    ارجع 0
نهاية

# ============================================================
# القسم ٢: الأسس والقوى واللوغاريتمات
# ============================================================

دالة رقم القوة(رقم اساس، رقم أس)
    إذا (أس == 0)
        ارجع 1
    نهاية
    إذا (أس < 0)
        ارجع 0
    نهاية
    رقم ناتج = 1
    رقم ع = 0
    بينما (ع < أس)
        ناتج = ناتج * اساس
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# قوة بالتكرار السريع O(log n)
دالة رقم القوة_السريعة(رقم اساس، رقم أس)
    إذا (أس == 0)
        ارجع 1
    نهاية
    رقم ناتج = 1
    رقم ق = اساس
    رقم ن = أس
    بينما (ن > 0)
        إذا (ن % 2 == 1)
            ناتج = ناتج * ق
        نهاية
        ق = ق * ق
        ن = ن / 2
    نهاية
    ارجع ناتج
نهاية

# الجذر التربيعي بطريقة نيوتن (يرجع عدداً صحيحاً)
دالة رقم الجذر_التربيعي(رقم ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    رقم تخمين = ن / 2
    رقم عداد = 0
    بينما (عداد < 50)
        رقم تخمين_جديد = (تخمين + ن / تخمين) / 2
        إذا (تخمين_جديد == تخمين)
            ارجع تخمين
        نهاية
        تخمين = تخمين_جديد
        عداد = عداد + 1
    نهاية
    ارجع تخمين
نهاية

# اللوغاريتم بالأساس 2 (عدد صحيح)
دالة رقم لوغاريتم2(رقم ن)
    إذا (ن <= 0)
        ارجع 0 - 1
    نهاية
    رقم ناتج = 0
    رقم قيمة = ن
    بينما (قيمة > 1)
        قيمة = قيمة / 2
        ناتج = ناتج + 1
    نهاية
    ارجع ناتج
نهاية

# اللوغاريتم بالأساس 10 (عدد صحيح)
دالة رقم لوغاريتم10(رقم ن)
    إذا (ن <= 0)
        ارجع 0 - 1
    نهاية
    رقم ناتج = 0
    رقم قيمة = ن
    بينما (قيمة >= 10)
        قيمة = قيمة / 10
        ناتج = ناتج + 1
    نهاية
    ارجع ناتج
نهاية

# ============================================================
# القسم ٣: العاملي والتوافيق
# ============================================================

دالة رقم العاملي(رقم ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    رقم ناتج = 1
    رقم ع = 2
    بينما (ع <= ن)
        ناتج = ناتج * ع
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# التوافيق C(n, k) = n! / (k! × (n-k)!)
دالة رقم التوافيق(رقم ن، رقم ك)
    إذا (ك > ن)
        ارجع 0
    نهاية
    إذا (ك == 0)
        ارجع 1
    نهاية
    إذا (ك == ن)
        ارجع 1
    نهاية
    # تحسين: C(n,k) = C(n, n-k)
    رقم ك_فعلي = ك
    إذا (ك > ن - ك)
        ك_فعلي = ن - ك
    نهاية
    رقم ناتج = 1
    رقم ع = 0
    بينما (ع < ك_فعلي)
        ناتج = ناتج * (ن - ع)
        ناتج = ناتج / (ع + 1)
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# التباديل P(n, k) = n! / (n-k)!
دالة رقم التباديل(رقم ن، رقم ك)
    إذا (ك > ن)
        ارجع 0
    نهاية
    رقم ناتج = 1
    رقم ع = 0
    بينما (ع < ك)
        ناتج = ناتج * (ن - ع)
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# ============================================================
# القسم ٤: نظرية الأعداد
# ============================================================

دالة رقم هل_زوجي(رقم ن)
    إذا (ن % 2 == 0)
        ارجع 1
    نهاية
    ارجع 0
نهاية

دالة رقم هل_فردي(رقم ن)
    إذا (ن % 2 == 1)
        ارجع 1
    نهاية
    ارجع 0
نهاية

دالة رقم هل_اولي(رقم ن)
    إذا (ن <= 1)
        ارجع 0
    نهاية
    إذا (ن <= 3)
        ارجع 1
    نهاية
    إذا (ن % 2 == 0)
        ارجع 0
    نهاية
    رقم قاسم = 3
    بينما (قاسم * قاسم <= ن)
        إذا (ن % قاسم == 0)
            ارجع 0
        نهاية
        قاسم = قاسم + 2
    نهاية
    ارجع 1
نهاية

# القاسم المشترك الأكبر (خوارزمية إقليدس)
دالة رقم ق_م_أ(رقم أ، رقم ب)
    رقم س = القيمة_المطلقة(أ)
    رقم ص = القيمة_المطلقة(ب)
    بينما (ص > 0)
        رقم باقي = س % ص
        س = ص
        ص = باقي
    نهاية
    ارجع س
نهاية

# المضاعف المشترك الأصغر
دالة رقم م_م_أ(رقم أ، رقم ب)
    إذا (أ == 0)
        ارجع 0
    نهاية
    إذا (ب == 0)
        ارجع 0
    نهاية
    رقم حاصل = القيمة_المطلقة(أ) * القيمة_المطلقة(ب)
    ارجع حاصل / ق_م_أ(أ، ب)
نهاية

# عدد القواسم
دالة رقم عدد_القواسم(رقم ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    رقم عدد = 0
    رقم ق = 1
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            عدد = عدد + 1
            إذا (ق * ق < ن)
                عدد = عدد + 1
            نهاية
        نهاية
        ق = ق + 1
    نهاية
    ارجع عدد
نهاية

# مجموع القواسم (بدون العدد نفسه)
دالة رقم مجموع_القواسم(رقم ن)
    إذا (ن <= 1)
        ارجع 0
    نهاية
    رقم مجموع = 1
    رقم ق = 2
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            مجموع = مجموع + ق
            إذا (ق * ق < ن)
                مجموع = مجموع + ن / ق
            نهاية
        نهاية
        ق = ق + 1
    نهاية
    ارجع مجموع
نهاية

# هل العدد كامل (مجموع قواسمه = هو نفسه)
دالة رقم هل_كامل(رقم ن)
    إذا (ن <= 1)
        ارجع 0
    نهاية
    إذا (مجموع_القواسم(ن) == ن)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# ============================================================
# القسم ٥: المتتاليات
# ============================================================

دالة رقم فيبوناتشي(رقم ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    رقم أ = 0
    رقم ب = 1
    رقم ع = 2
    بينما (ع <= ن)
        رقم جمع = أ + ب
        أ = ب
        ب = جمع
        ع = ع + 1
    نهاية
    ارجع ب
نهاية

# المجموع حتى ن: 1 + 2 + ... + n
دالة رقم المجموع_حتى(رقم ن)
    ارجع ن * (ن + 1) / 2
نهاية

# مجموع المربعات حتى ن
دالة رقم مجموع_المربعات(رقم ن)
    ارجع ن * (ن + 1) * (2 * ن + 1) / 6
نهاية

# مجموع المكعبات حتى ن
دالة رقم مجموع_المكعبات(رقم ن)
    رقم م = المجموع_حتى(ن)
    ارجع م * م
نهاية

# ============================================================
# القسم ٦: الهندسة
# ============================================================

# محيط المستطيل
دالة رقم محيط_المستطيل(رقم طول، رقم عرض)
    ارجع 2 * (طول + عرض)
نهاية

# مساحة المستطيل
دالة رقم مساحة_المستطيل(رقم طول، رقم عرض)
    ارجع طول * عرض
نهاية

# مساحة المثلث
دالة رقم مساحة_المثلث(رقم قاعدة، رقم ارتفاع)
    ارجع قاعدة * ارتفاع / 2
نهاية

# محيط الدائرة (تقريبي بالأعداد الصحيحة)
# الناتج مضروب في 1000 للدقة
دالة رقم محيط_الدائرة(رقم نصف_قطر)
    ارجع 2 * 3142 * نصف_قطر / 1000
نهاية

# مساحة الدائرة (تقريبية)
دالة رقم مساحة_الدائرة(رقم نصف_قطر)
    ارجع 3142 * نصف_قطر * نصف_قطر / 1000
نهاية

# المسافة الإقليدية² (بدون جذر، لتجنب الكسور)
دالة رقم المسافة_المربعة(رقم س1، رقم ص1، رقم س2، رقم ص2)
    رقم فرق_س = س2 - س1
    رقم فرق_ص = ص2 - ص1
    ارجع فرق_س * فرق_س + فرق_ص * فرق_ص
نهاية

# حجم المكعب
دالة رقم حجم_المكعب(رقم ضلع)
    ارجع ضلع * ضلع * ضلع
نهاية

# حجم المنشور
دالة رقم حجم_المنشور(رقم طول، رقم عرض، رقم ارتفاع)
    ارجع طول * عرض * ارتفاع
نهاية

# مساحة سطح المكعب
دالة رقم مساحة_سطح_المكعب(رقم ضلع)
    ارجع 6 * ضلع * ضلع
نهاية

# ============================================================
# القسم ٧: خوارزميات مفيدة
# ============================================================

# تحويل رقم عشري إلى ثنائي (عدد البتات)
دالة رقم عدد_البتات(رقم ن)
    إذا (ن == 0)
        ارجع 1
    نهاية
    رقم عدد = 0
    رقم قيمة = القيمة_المطلقة(ن)
    بينما (قيمة > 0)
        عدد = عدد + 1
        قيمة = قيمة / 2
    نهاية
    ارجع عدد
نهاية

# عدد أرقام العدد (بالنظام العشري)
دالة رقم عدد_الأرقام(رقم ن)
    إذا (ن == 0)
        ارجع 1
    نهاية
    رقم عدد = 0
    رقم قيمة = القيمة_المطلقة(ن)
    بينما (قيمة > 0)
        عدد = عدد + 1
        قيمة = قيمة / 10
    نهاية
    ارجع عدد
نهاية

# عكس أرقام العدد
دالة رقم عكس_الأرقام(رقم ن)
    رقم نتيجة = 0
    رقم قيمة = القيمة_المطلقة(ن)
    بينما (قيمة > 0)
        نتيجة = نتيجة * 10 + قيمة % 10
        قيمة = قيمة / 10
    نهاية
    إذا (ن < 0)
        ارجع 0 - نتيجة
    نهاية
    ارجع نتيجة
نهاية

# هل العدد متقلب (palindrome)
دالة رقم هل_متقلب(رقم ن)
    إذا (ن < 0)
        ارجع 0
    نهاية
    إذا (عكس_الأرقام(ن) == ن)
        ارجع 1
    نهاية
    ارجع 0
نهاية

# مولد أعداد شبه عشوائية (خوارزمية LCG)
رقم _بذرة_عشوائية = 42

دالة تعيين_البذرة(رقم بذرة)
    _بذرة_عشوائية = بذرة
نهاية

دالة رقم عشوائي(رقم حد_اقصى)
    _بذرة_عشوائية = (_بذرة_عشوائية * 1103515245 + 12345) % 2147483647
    رقم ق = القيمة_المطلقة(_بذرة_عشوائية)
    ارجع ق % حد_اقصى
نهاية

دالة رقم عشوائي_بين(رقم حد_ادنى، رقم حد_اقصى)
    ارجع حد_ادنى + عشوائي(حد_اقصى - حد_ادنى + 1)
نهاية

# ============================================================
# القسم ٨: دالة الاختبار الذاتي
# ============================================================

دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════════════════════╗")
    اطبع_سطر("║   sad-math v1.0.0 - مكتبة الرياضيات المتقدمة     ║")
    اطبع_سطر("╚══════════════════════════════════════════════════╝")
    اطبع_سطر("")

    # --- اختبار الأساسيات ---
    اطبع_سطر("[١] الدوال الأساسية:")
    اطبع("    |−7| = ")
    اطبع_سطر(القيمة_المطلقة(0 - 7))
    اطبع("    الأكبر(15، 23) = ")
    اطبع_سطر(الاكبر(15، 23))
    اطبع("    الأصغر(15، 23) = ")
    اطبع_سطر(الاصغر(15، 23))
    اطبع("    الحصر(150، 0، 100) = ")
    اطبع_سطر(الحصر(150، 0، 100))
    اطبع_سطر("")

    # --- اختبار القوى ---
    اطبع_سطر("[٢] القوى واللوغاريتمات:")
    رقم ع1 = 1
    بينما (ع1 <= 10)
        اطبع("    2^")
        اطبع(ع1)
        اطبع(" = ")
        اطبع_سطر(القوة(2، ع1))
        ع1 = ع1 + 1
    نهاية
    اطبع("    √144 = ")
    اطبع_سطر(الجذر_التربيعي(144))
    اطبع("    √10000 = ")
    اطبع_سطر(الجذر_التربيعي(10000))
    اطبع("    log2(1024) = ")
    اطبع_سطر(لوغاريتم2(1024))
    اطبع_سطر("")

    # --- العاملي والتوافيق ---
    اطبع_سطر("[٣] العاملي والتوافيق:")
    رقم ع2 = 1
    بينما (ع2 <= 10)
        اطبع("    ")
        اطبع(ع2)
        اطبع("! = ")
        اطبع_سطر(العاملي(ع2))
        ع2 = ع2 + 1
    نهاية
    اطبع("    C(10,3) = ")
    اطبع_سطر(التوافيق(10، 3))
    اطبع("    C(20,5) = ")
    اطبع_سطر(التوافيق(20، 5))
    اطبع("    P(10,3) = ")
    اطبع_سطر(التباديل(10، 3))
    اطبع_سطر("")

    # --- نظرية الأعداد ---
    اطبع_سطر("[٤] نظرية الأعداد:")
    اطبع("    الأولية حتى 50: ")
    رقم ع3 = 2
    بينما (ع3 <= 50)
        إذا (هل_اولي(ع3) == 1)
            اطبع(ع3)
            اطبع(" ")
        نهاية
        ع3 = ع3 + 1
    نهاية
    اطبع_سطر("")
    اطبع("    ق.م.أ(48، 36) = ")
    اطبع_سطر(ق_م_أ(48، 36))
    اطبع("    م.م.أ(12، 18) = ")
    اطبع_سطر(م_م_أ(12، 18))
    اطبع("    6 عدد كامل؟ ")
    اطبع_سطر(هل_كامل(6))
    اطبع("    28 عدد كامل؟ ")
    اطبع_سطر(هل_كامل(28))
    اطبع_سطر("")

    # --- متتاليات ---
    اطبع_سطر("[٥] المتتاليات:")
    اطبع("    فيبوناتشي: ")
    رقم ع4 = 0
    بينما (ع4 <= 15)
        اطبع(فيبوناتشي(ع4))
        اطبع(" ")
        ع4 = ع4 + 1
    نهاية
    اطبع_سطر("")
    اطبع("    مجموع 1..100 = ")
    اطبع_سطر(المجموع_حتى(100))
    اطبع("    مجموع المربعات 1..10 = ")
    اطبع_سطر(مجموع_المربعات(10))
    اطبع_سطر("")

    # --- الهندسة ---
    اطبع_سطر("[٦] الهندسة:")
    اطبع("    مساحة مستطيل 5×8 = ")
    اطبع_سطر(مساحة_المستطيل(5، 8))
    اطبع("    مساحة مثلث قاعدة=10 ارتفاع=6 = ")
    اطبع_سطر(مساحة_المثلث(10، 6))
    اطبع("    محيط دائرة نق=7 ≈ ")
    اطبع_سطر(محيط_الدائرة(7))
    اطبع("    حجم مكعب ضلع=5 = ")
    اطبع_سطر(حجم_المكعب(5))
    اطبع_سطر("")

    # --- خوارزميات ---
    اطبع_سطر("[٧] خوارزميات:")
    اطبع("    12321 متقلب؟ ")
    اطبع_سطر(هل_متقلب(12321))
    اطبع("    12345 متقلب؟ ")
    اطبع_سطر(هل_متقلب(12345))
    اطبع("    عدد أرقام 123456 = ")
    اطبع_سطر(عدد_الأرقام(123456))
    اطبع("    عكس 12345 = ")
    اطبع_سطر(عكس_الأرقام(12345))
    اطبع_سطر("")

    # --- أعداد عشوائية ---
    اطبع_سطر("[٨] أعداد عشوائية:")
    تعيين_البذرة(2026)
    رقم ع5 = 0
    اطبع("    10 أعداد عشوائية (0-99): ")
    بينما (ع5 < 10)
        اطبع(عشوائي(100))
        اطبع(" ")
        ع5 = ع5 + 1
    نهاية
    اطبع_سطر("")
    اطبع_سطر("")

    اطبع_سطر("╔══════════════════════════════════════════════════╗")
    اطبع_سطر("║   ✓ جميع الاختبارات نجحت!                       ║")
    اطبع_سطر("╚══════════════════════════════════════════════════╝")
نهاية
