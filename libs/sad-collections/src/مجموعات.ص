    دالة رقم أضف(رقم قيمة)
        إذا (الحجم >= 20)
            ارجع 0
        نهاية
        _خزن(الحجم، قيمة)
        الحجم = الحجم + 1
        ارجع 1
    نهاية

    دالة رقم اجلب(رقم فهرس)
        إذا (فهرس < 0)
            ارجع 0 - 1
        نهاية
        إذا (فهرس >= الحجم)
            ارجع 0 - 1
        نهاية
        ارجع _أحضر(فهرس)
    نهاية

    دالة ضع(رقم فهرس، رقم قيمة)
        إذا (فهرس >= 0)
            إذا (فهرس < الحجم)
                _خزن(فهرس، قيمة)
            نهاية
        نهاية
    نهاية

    دالة رقم الطول()
        ارجع الحجم
    نهاية

    # --- بحث خطي ---
    دالة رقم ابحث(رقم قيمة)
        رقم ع = 0
        بينما (ع < الحجم)
            إذا (_أحضر(ع) == قيمة)
                ارجع ع
            نهاية
            ع = ع + 1
        نهاية
        ارجع 0 - 1
    نهاية

    # --- يحتوي ---
    دالة رقم يحتوي(رقم قيمة)
        إذا (ابحث(قيمة) >= 0)
            ارجع 1
        نهاية
        ارجع 0
    نهاية

    # --- الحد الأقصى ---
    دالة رقم الأقصى()
        إذا (الحجم == 0)
            ارجع 0
        نهاية
        رقم أقصى = _أحضر(0)
        رقم ع = 1
        بينما (ع < الحجم)
            رقم ق = _أحضر(ع)
            إذا (ق > أقصى)
                أقصى = ق
            نهاية
            ع = ع + 1
        نهاية
        ارجع أقصى
    نهاية

    # --- الحد الأدنى ---
    دالة رقم الأدنى()
        إذا (الحجم == 0)
            ارجع 0
        نهاية
        رقم أدنى = _أحضر(0)
        رقم ع = 1
        بينما (ع < الحجم)
            رقم ق = _أحضر(ع)
            إذا (ق < أدنى)
                أدنى = ق
            نهاية
            ع = ع + 1
        نهاية
        ارجع أدنى
    نهاية

    # --- المجموع ---
    دالة رقم المجموع()
        رقم مج = 0
        رقم ع = 0
        بينما (ع < الحجم)
            مج = مج + _أحضر(ع)
            ع = ع + 1
        نهاية
        ارجع مج
    نهاية

    # --- المتوسط ---
    دالة رقم المتوسط()
        إذا (الحجم == 0)
            ارجع 0
        نهاية
        ارجع المجموع() / الحجم
    نهاية

    # --- ترتيب فقاعي (تصاعدي) ---
    دالة رتب_تصاعدي()
        رقم ن = الحجم
        رقم ع = 0
        بينما (ع < ن - 1)
            رقم ج = 0
            بينما (ج < ن - ع - 1)
                رقم أ = _أحضر(ج)
                رقم ب = _أحضر(ج + 1)
                إذا (أ > ب)
                    _خزن(ج، ب)
                    _خزن(ج + 1، أ)
                نهاية
                ج = ج + 1
            نهاية
            ع = ع + 1
        نهاية
    نهاية

    # --- ترتيب تنازلي ---
    دالة رتب_تنازلي()
        رقم ن = الحجم
        رقم ع = 0
        بينما (ع < ن - 1)
            رقم ج = 0
            بينما (ج < ن - ع - 1)
                رقم أ = _أحضر(ج)
                رقم ب = _أحضر(ج + 1)
                إذا (أ < ب)
                    _خزن(ج، ب)
                    _خزن(ج + 1، أ)
                نهاية
                ج = ج + 1
            نهاية
            ع = ع + 1
        نهاية
    نهاية

    # --- عكس المصفوفة ---
    دالة اعكس()
        رقم يسار = 0
        رقم يمين = الحجم - 1
        بينما (يسار < يمين)
            رقم مؤقت = _أحضر(يسار)
            _خزن(يسار، _أحضر(يمين))
            _خزن(يمين، مؤقت)
            يسار = يسار + 1
            يمين = يمين - 1
        نهاية
    نهاية

    دالة اعرض()
        اطبع("    [")
        رقم ع = 0
        بينما (ع < الحجم)
            اطبع(_أحضر(ع))
            إذا (ع + 1 < الحجم)
                اطبع(", ")
            نهاية
            ع = ع + 1
        نهاية
        اطبع_سطر("]")
    نهاية
