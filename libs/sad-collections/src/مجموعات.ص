# ============================================================
# القسم ٣: العداد / المراكم — Accumulator
# ============================================================

صنف عداد
    رقم القيمة
    رقم العمليات
    رقم الادنى
    رقم الاقصى

    باني(رقم قيمة_ابتدائية)
        القيمة = قيمة_ابتدائية
        العمليات = 0
        الادنى = قيمة_ابتدائية
        الاقصى = قيمة_ابتدائية
    نهاية

    دالة أضف(رقم ن)
        القيمة = القيمة + ن
        العمليات = العمليات + 1
        إذا (القيمة < الادنى)
            الادنى = القيمة
        نهاية
        إذا (القيمة > الاقصى)
            الاقصى = القيمة
        نهاية
    نهاية

    دالة اطرح(رقم ن)
        القيمة = القيمة - ن
        العمليات = العمليات + 1
        إذا (القيمة < الادنى)
            الادنى = القيمة
        نهاية
        إذا (القيمة > الاقصى)
            الاقصى = القيمة
        نهاية
    نهاية

    دالة اضرب(رقم ن)
        القيمة = القيمة * ن
        العمليات = العمليات + 1
        إذا (القيمة < الادنى)
            الادنى = القيمة
        نهاية
        إذا (القيمة > الاقصى)
            الاقصى = القيمة
        نهاية
    نهاية

    دالة أعد()
        القيمة = 0
        العمليات = 0
        الادنى = 0
        الاقصى = 0
    نهاية

    دالة رقم الحالي()
        ارجع القيمة
    نهاية

    دالة رقم كم_عملية()
        ارجع العمليات
    نهاية

    دالة اعرض()
        اطبع("    عداد = ")
        اطبع(القيمة)
        اطبع(" (عمليات: ")
        اطبع(العمليات)
        اطبع(", أدنى: ")
        اطبع(الادنى)
        اطبع(", أقصى: ")
        اطبع(الاقصى)
        اطبع_سطر(")")
    نهاية
نهاية

# ============================================================
# القسم ٤: المدى / النطاق — Range
# ============================================================

صنف نطاق
    رقم البداية
    رقم النهاية
    رقم الخطوة

    باني(رقم ب، رقم ن، رقم خ)
        البداية = ب
        النهاية = ن
        الخطوة = خ
    نهاية

    دالة رقم يحتوي(رقم قيمة)
        إذا (قيمة >= البداية)
            إذا (قيمة <= النهاية)
                إذا (الخطوة > 0)
                    إذا ((قيمة - البداية) % الخطوة == 0)
                        ارجع 1
                    نهاية
                نهاية
            نهاية
        نهاية
        ارجع 0
    نهاية

    دالة رقم الطول()
        إذا (الخطوة <= 0)
            ارجع 0
        نهاية
        ارجع (النهاية - البداية) / الخطوة + 1
    نهاية

    # طباعة جميع العناصر
    دالة اعرض()
        اطبع("    مدى[")
        اطبع(البداية)
        اطبع("..")
        اطبع(النهاية)
        اطبع(" خطوة ")
        اطبع(الخطوة)
        اطبع("]: ")
        رقم ق = البداية
        بينما (ق <= النهاية)
            اطبع(ق)
            إذا (ق + الخطوة <= النهاية)
                اطبع(" ")
            نهاية
            ق = ق + الخطوة
        نهاية
        اطبع_سطر("")
    نهاية

    # مجموع عناصر المدى
    دالة رقم المجموع()
        رقم مج = 0
        رقم ق = البداية
        بينما (ق <= النهاية)
            مج = مج + ق
            ق = ق + الخطوة
        نهاية
        ارجع مج
    نهاية
نهاية

