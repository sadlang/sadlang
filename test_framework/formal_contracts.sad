/// ============================================================================
/// إطار اختبار لغة ص — T0123
/// بنية اختبار رسمية للغة ص
/// ============================================================================
///
/// # إطار_اختبار_ص
///
/// إطار اختبار رسمي للغة ص يُستخدم للتحقق من صحة المترجم
/// وضمان جودة الكود المكتوب بلغة ص.
///
/// ## المفاهيم الأساسية:
/// - عقد (Contract): شرط يجب أن يتحقق
/// - اختبار (Test): وحدة اختبار واحدة
/// - مجموعة (Suite): مجموعة اختبارات مرتبطة
/// - تأكيد (Assertion): فحص قيمة
///
/// ## الاستخدام:
/// ```sad
/// اختبار "جمع عددين" {
///   أكّد_مساواة(٣ + ٤, ٧)
/// }
///
/// مجموعة "العمليات الحسابية" {
///   اختبار "جمع" { أكّد_مساواة(١ + ١, ٢) }
///   اختبار "طرح" { أكّد_مساواة(٥ - ٣, ٢) }
///   اختبار "ضرب" { أكّد_مساواة(٣ * ٤, ١٢) }
///   اختبار "قسمة" { أكّد_مساواة(١٠ / ٢, ٥) }
/// }
/// ```

// === تعريفات الإطار ===

// --- نتيجة الاختبار ---
// نجاح | فشل(سبب: نص) | تخطي(سبب: نص) | خطأ(تفاصيل: نص)

// --- إحصائيات ---
// عدد_الاختبارات: عدد
// ناجحة: عدد
// فاشلة: عدد
// متخطاة: عدد
// أخطاء: عدد
// المدة_بالملي: عدد

// === التأكيدات الأساسية ===

// أكّد(شرط: منطقي, رسالة؟: نص)
//   إذا !شرط → فشل مع الرسالة

// أكّد_مساواة<ن>(فعلي: ن, متوقع: ن, رسالة؟: نص)
//   إذا فعلي != متوقع → فشل

// أكّد_عدم_مساواة<ن>(فعلي: ن, متوقع: ن)
//   إذا فعلي == متوقع → فشل

// أكّد_صحيح(قيمة: منطقي)
//   ≡ أكّد_مساواة(قيمة, صحيح)

// أكّد_خاطئ(قيمة: منطقي)
//   ≡ أكّد_مساواة(قيمة, خاطئ)

// أكّد_فارغ(قيمة: أي؟)
//   إذا قيمة != فارغ → فشل

// أكّد_غير_فارغ(قيمة: أي؟)
//   إذا قيمة == فارغ → فشل

// === التأكيدات المتقدمة ===

// أكّد_يحتوي(نص: نص, جزء: نص)
//   إذا !نص.يحتوي(جزء) → فشل

// أكّد_يبدأ_بـ(نص: نص, بداية: نص)
//   إذا !نص.يبدأ_بـ(بداية) → فشل

// أكّد_ينتهي_بـ(نص: نص, نهاية: نص)
//   إذا !نص.ينتهي_بـ(نهاية) → فشل

// أكّد_يطابق(نص: نص, نمط: تعبير_نمطي)
//   إذا !نمط.يطابق(نص) → فشل

// أكّد_أكبر_من(فعلي: عدد, حد: عدد)
// أكّد_أصغر_من(فعلي: عدد, حد: عدد)
// أكّد_بين(فعلي: عدد, أدنى: عدد, أقصى: عدد)

// أكّد_قريب_من(فعلي: عدد_عشري, متوقع: عدد_عشري, هامش: عدد_عشري)
//   إذا |فعلي - متوقع| > هامش → فشل

// === تأكيدات القوائم ===

// أكّد_فارغة(قائمة: قائمة<أي>)
// أكّد_غير_فارغة(قائمة: قائمة<أي>)
// أكّد_طول(قائمة: قائمة<أي>, طول: عدد)
// أكّد_يحتوي_عنصر(قائمة: قائمة<أي>, عنصر: أي)
// أكّد_لا_يحتوي(قائمة: قائمة<أي>, عنصر: أي)
// أكّد_مرتبة(قائمة: قائمة<عدد>)

// === تأكيدات الأخطاء ===

// أكّد_يرمي<خ: خطأ>(دالة: () -> أي)
//   إذا لم ترمِ الدالة خطأ من نوع خ → فشل

// أكّد_لا_يرمي(دالة: () -> أي)
//   إذا رمت الدالة خطأ → فشل

// أكّد_يرمي_رسالة(دالة: () -> أي, رسالة: نص)
//   التقاط الخطأ والتحقق من رسالته

// === تأكيدات الأداء ===

// أكّد_أقل_من_ملي(دالة: () -> أي, حد_ملي: عدد)
//   قياس المدة والتحقق أنها < الحد

// أكّد_ذاكرة_أقل_من(دالة: () -> أي, حد_بايت: عدد)
//   قياس الذاكرة المستخدمة

// === تأكيدات النص العربي ===

// أكّد_اتجاه_يمين(نص: نص)
//   التحقق أن النص يبدأ بحرف عربي

// أكّد_عدد_أحرف(نص: نص, عدد: عدد)
//   حساب بوحدات الجرافيم (grapheme clusters)

// أكّد_تشكيل_صحيح(نص: نص)
//   التحقق من صحة التشكيل

// === بنية الاختبار ===

// مجموعة(اسم: نص, محتوى: () -> فراغ)
//   تجميع اختبارات مرتبطة

// اختبار(اسم: نص, جسم: () -> فراغ)
//   وحدة اختبار واحدة

// اختبار_غير_متزامن(اسم: نص, جسم: () -> مستقبل<فراغ>)
//   اختبار غير متزامن مع timeout

// قبل_كل(تهيئة: () -> فراغ)
//   تنفيذ قبل كل اختبار

// بعد_كل(تنظيف: () -> فراغ)
//   تنفيذ بعد كل اختبار

// قبل_الكل(تهيئة: () -> فراغ)
//   تنفيذ مرة قبل كل الاختبارات

// بعد_الكل(تنظيف: () -> فراغ)
//   تنفيذ مرة بعد كل الاختبارات

// === التشغيل ===

// شغّل_اختبارات(مرشح؟: نص) -> إحصائيات
//   تشغيل الاختبارات مع طباعة النتائج

// === مثال شامل ===

// ```sad
// استخدم إطار_اختبار_ص.*
//
// مجموعة "المحلل اللغوي" {
//   متغير محلل: محلل_لغوي
//
//   قبل_كل {
//     محلل = محلل_لغوي.جديد()
//   }
//
//   اختبار "تعريف متغير" {
//     ثابت نتيجة = محلل.حلّل("متغير س = ٥")
//     أكّد_غير_فارغ(نتيجة)
//     أكّد_مساواة(نتيجة.نوع, "تعريف_متغير")
//     أكّد_مساواة(نتيجة.اسم, "س")
//   }
//
//   اختبار "خطأ تركيبي" {
//     أكّد_يرمي<خطأ_تركيبي>({
//       محلل.حلّل("متغير = ")
//     })
//   }
//
//   اختبار "أداء: تحليل 1000 سطر < 50ms" {
//     ثابت كود = "متغير س = ٥\n" * ١٠٠٠
//     أكّد_أقل_من_ملي({ محلل.حلّل(كود) }, ٥٠)
//   }
// }
// ```
