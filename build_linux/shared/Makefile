	cd /mnt/c/s_lang/s-programming-language/build_linux && $(MAKE) $(MAKESILENT) -f shared/CMakeFiles/sad_shared.dir/build.make shared/CMakeFiles/sad_shared.dir/utils/src/string_utils.cpp.i
.PHONY : utils/src/string_utils.cpp.i

utils/src/string_utils.s: utils/src/string_utils.cpp.s
.PHONY : utils/src/string_utils.s

# target to generate assembly for a file
utils/src/string_utils.cpp.s:
	cd /mnt/c/s_lang/s-programming-language/build_linux && $(MAKE) $(MAKESILENT) -f shared/CMakeFiles/sad_shared.dir/build.make shared/CMakeFiles/sad_shared.dir/utils/src/string_utils.cpp.s
.PHONY : utils/src/string_utils.cpp.s

