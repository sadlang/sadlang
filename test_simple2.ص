من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد تطابق، بحث

# اختبارات بسيطة جداً
اطبع_سطر("1: d")
اطبع(تطابق("\\d", "5", 0))
اطبع_سطر("")

اطبع_سطر("2: dd")
اطبع(تطابق("\\d\\d", "12", 0))
اطبع_سطر("")

اطبع_سطر("3: بحث d")
متغير ر = بحث("\\d", "a5b", 0)
إذا (ر != لاشيء)
    اطبع_سطر(ر.النص_المطابق)
وإلا
    اطبع_سطر("لاشيء")
نهاية

اطبع_سطر("4: بحث dd في 123")
ر = بحث("\\d\\d", "123", 0)
إذا (ر != لاشيء)
    اطبع_سطر(ر.النص_المطابق)
وإلا
    اطبع_سطر("لاشيء")
نهاية

اطبع_سطر("5: بحث ddd في 123")
ر = بحث("\\d\\d\\d", "123", 0)
إذا (ر != لاشيء)
    اطبع_سطر(ر.النص_المطابق)
وإلا
    اطبع_سطر("لاشيء")
نهاية

اطبع_سطر("انتهى")
