صنف محرك_ت
    رقم القيمة
    متغير البيانات

    باني(رقم ق، رقم ب)
        هذا.القيمة = ق
        هذا.البيانات = ب
    نهاية

    دالة رقم تشغيل(نص ن)
        متغير م = هذا
        متغير ق = م.القيمة
        متغير ب = م.البيانات
        ## استدعاء دالة خارجية مع م كمعامل
        متغير نتيجة = حسب(م, ن)
        ## هل م لا يزال صحيحاً؟
        اطبع_سطر("بعد حسب، م.القيمة:")
        اطبع_سطر(م.القيمة)
        ارجع نتيجة
    نهاية
نهاية

دالة رقم حسب(مح, نص ن)
    متغير طول_ن = طول(ن)
    ارجع مح.القيمة + طول_ن
