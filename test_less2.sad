دالة رئيسية()
    متغير مستمر = 1
    بينما (مستمر > 0)
        متغير اختيار = 7
        إذا (اختيار == 0)
            مستمر = 0
        وإلا_إذا (اختيار == 1)
            اطبع_سطر("واحد")
            متغير ناتج = 10
            إذا (ناتج < 5)
                اطبع_سطر("صغير")
            نهاية
            إذا (ناتج < 100)
                اطبع_سطر("أقل من مئة")
            نهاية
        وإلا_إذا (اختيار == 7)
            اطبع_سطر("سبعة")
            متغير ن = 5
            إذا (ن < 0)
                اطبع_سطر("سالب")
            وإلا
                اطبع_سطر("موجب")
            نهاية
        نهاية
        مستمر = 0
    نهاية
نهاية
