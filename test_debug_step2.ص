من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد تعبير، م_بحث، م_ابحث_من، احسب_مجموعات

## نفس منطق بحث() المستقلة، لكن خطوة بخطوة
متغير نمط = "<.+?>"
متغير نص = "<مرحبا><عالم>"
متغير أعلام = 0

اطبع("الخطوة 1: إنشاء تعبير...")
متغير تع = جديد تعبير(نمط، أعلام)
اطبع("نوع تع.المحرك = ")
اطبع_سطر(تع.المحرك)
اطبع("تع.عدد_المجموعات = ")
اطبع_سطر(تع.عدد_المجموعات)

اطبع("الخطوة 2: استدعاء م_ابحث_من مباشرة...")
متغير مح2 = تع.المحرك
متغير شج2 = مح2.الشجرة
اطبع("شجرة موجودة: ")
اطبع_سطر(شج2 != لاشيء)
متغير حالة = م_ابحث_من(شج2، تع.عدد_المجموعات، تع.الأعلام، نص، 0)
اطبع("حالة = ")
اطبع_سطر(حالة)

اطبع("الخطوة 3: تع.بحث()...")
متغير ن = تع.بحث(نص)
اطبع("ن = ")
اطبع_سطر(ن)
