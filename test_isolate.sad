# اختبار سريع
دالة رقم القيمة_المطلقة(رقم ن)
    إذا (ن < 0)
        ارجع 0 - ن
    نهاية
    ارجع ن
نهاية

دالة رقم القاسم_المشترك_الأكبر(رقم أ، رقم ب)
    أ = القيمة_المطلقة(أ)
    ب = القيمة_المطلقة(ب)
    بينما (ب != 0)
        رقم باقي = أ - ((أ / ب) * ب)
        أ = ب
        ب = باقي
    نهاية
    ارجع أ
نهاية

دالة منطقي هل_أولي(رقم ن)
    إذا (ن <= 1)
        ارجع خطأ
    نهاية
    إذا (ن <= 3)
        ارجع صح
    نهاية
    رقم قاسم = 2
    بينما (قاسم * قاسم <= ن)
        رقم باقي = ن - ((ن / قاسم) * قاسم)
        إذا (باقي == 0)
            ارجع خطأ
        نهاية
        قاسم = قاسم + 1
    نهاية
    ارجع صح
نهاية

دالة رقم عد_الأعداد_الأولية(رقم حد)
    رقم عدد = 0
    رقم ن = 2
    بينما (ن <= حد)
        إذا (هل_أولي(ن))
            عدد = عدد + 1
        نهاية
        ن = ن + 1
    نهاية
    ارجع عدد
نهاية

دالة رئيسية()
    رقم ق = القاسم_المشترك_الأكبر(48، 36)
    اطبع("قمأ = ")
    اطبع_سطر(ق)
    رقم أولية = عد_الأعداد_الأولية(50)
    اطبع("أولية = ")
    اطبع_سطر(أولية)
    اطبع_سطر("تم")
نهاية
