# محاولة مباشرة
اطبع_سطر("=== اختبار مباشر ===")

متغير نص_نمط = "\\d{3}"
متغير نص_م = "123"

متغير مح_ل = جديد محلل(نص_نمط، 0)
متغير شج = مح_ل.حلل()
اطبع_سطر("شجرة: تم")

متغير عدد_مج = مح_ل.عدد_المجموعات
اطبع("عدد مجموعات: ")
اطبع_سطر(عدد_مج)

متغير نتيجة = م_ابحث_من(شج، عدد_مج، 0، نص_م، 0)
إذا (نتيجة != لاشيء)
    اطبع_سطر("وجد تطابق!")
    اطبع(نتيجة.المجموعات[0][0])
    اطبع(" - ")
    اطبع_سطر(نتيجة.المجموعات[0][1])
وإلا
    اطبع_سطر("لا تطابق")
