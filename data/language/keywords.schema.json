{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sad Language Keywords Lexicon Schema",
  "description": "(AR) مخطط التحقق لملف keywords.yaml. (EN) Validation schema for keywords.yaml.",
  "type": "object",
  "required": ["version", "language", "categories"],
  "additionalProperties": false,
  "properties": {
    "version":  { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "language": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "object",
      "required": ["reserved", "operators", "contextual", "builtin_types"],
      "additionalProperties": false,
      "properties": {
        "reserved":      { "$ref": "#/definitions/category" },
        "operators":     { "$ref": "#/definitions/category" },
        "contextual":    { "$ref": "#/definitions/category" },
        "builtin_types": { "$ref": "#/definitions/category" }
      }
    }
  },
  "definitions": {
    "category": {
      "type": "object",
      "required": ["description", "emittedByLexer", "keywords"],
      "additionalProperties": false,
      "properties": {
        "description":    { "type": "string" },
        "emittedByLexer": { "type": "boolean" },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["word", "tokenType"],
      "additionalProperties": false,
      "properties": {
        "word":      { "type": "string", "minLength": 1 },
        "tokenType": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "english":   { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["block_opener", "block_closer", "inter_block", "import_keyword"]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
