## test if creating object inside a method with م.field arguments corrupts outer م

صنف حالة_ت
    رقم العدد
    رقم الأعلام

    باني(نص ن, رقم عدد, رقم أعلام)
        هذا.العدد = عدد
        هذا.الأعلام = أعلام
        ## داخل الباني: متغير م = هذا
        متغير م = هذا
        اطبع("داخل الباني، م.العدد: ")
        اطبع_سطر(م.العدد)
    نهاية
نهاية

صنف محرك_ت
    رقم عدد_المجموعات
    رقم الأعلام
    رقم الشجرة

    باني(رقم عدد, رقم أعلام, رقم شجرة)
        هذا.عدد_المجموعات = عدد
        هذا.الأعلام = أعلام
        هذا.الشجرة = شجرة
    نهاية

    دالة ابحث_من(نص نص_م, رقم بداية_م)
        متغير م = هذا
        اطبع("قبل جديد: م.الشجرة = ")
        اطبع_سطر(م.الشجرة)
        ## هنا المشكلة: جديد مع م.field كمعامل
        متغير الحالة = جديد حالة_ت(نص_م, م.عدد_المجموعات, م.الأعلام)
        اطبع("بعد جديد: م.الشجرة = ")
        اطبع_سطر(م.الشجرة)
    نهاية
نهاية

متغير مح = جديد محرك_ت(3, 0, 99)
مح.ابحث_من("مرحبا", 0)
