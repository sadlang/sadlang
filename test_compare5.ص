من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد تعبير، م_بحث

## اختبار مباشر: هل م_بحث يعيد نفس النتيجة مرتين؟
متغير نمط = "<.+?>"
متغير نص_م = "<مرحبا><عالم>"
متغير أعلام = 0

متغير تع = جديد تعبير(نمط، أعلام)
متغير مح = تع.المحرك
متغير عدد = تع.عدد_المجموعات
متغير الأعلام = تع.الأعلام

## مباشرة
اطبع("م_بحث(مح، عدد، الأعلام، نص_م) = ")
متغير جواب1 = م_بحث(مح، عدد، الأعلام، نص_م)
اطبع_سطر(جواب1 == لاشيء)

## عبر الـmethod
اطبع("تع.بحث(نص_م) = ")
متغير جواب2 = تع.بحث(نص_م)
اطبع("جواب2 نوع اعتيادي؟ ")
## اذا كان نتيجة، يجب أن يحتوي على البداية
متغير تع_شج = تع.المحرك
اطبع_سطر(جواب2 == تع_شج)
