صنف حيوان
    عام
        نص الاسم
        رقم العمر
        
        باني(نص اسم، رقم عمر)
            هذا.الاسم = اسم
            هذا.العمر = عمر
        نهاية
        
        دالة نص وصف()
            ارجع هذا.الاسم
        نهاية
نهاية

دالة رئيسية()
    متغير ح = جديد حيوان("قطة"، 3)
    اطبع_سطر(ح.وصف())
    اطبع_سطر(ح.الاسم)
    ارجع 0
نهاية
