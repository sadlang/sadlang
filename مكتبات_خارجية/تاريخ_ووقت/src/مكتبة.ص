# مكتبة التاريخ والوقت — لغة ص
# Date & Time Library for Sad Language

## تاريخ: يمثل تاريخاً (سنة، شهر، يوم)
صنف تاريخ
   باني(السنة, الشهر, اليوم)
      هذا.السنة = السنة
      هذا.الشهر = الشهر
      هذا.اليوم = اليوم
   نهاية

   دالة نص()
      ارجع هذا.السنة + "-" + هذا.الشهر + "-" + هذا.اليوم
   نهاية

   دالة هل_كبيسة()
      إذا (هذا.السنة % 400 == 0)
         ارجع صحيح
      نهاية
      إذا (هذا.السنة % 100 == 0)
         ارجع خطأ
      نهاية
      ارجع هذا.السنة % 4 == 0
   نهاية

   دالة أيام_الشهر()
      متغير أيام = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
      متغير نتيجة = أيام[هذا.الشهر - 1]
      إذا (هذا.الشهر == 2 و هذا.هل_كبيسة())
         نتيجة = 29
      نهاية
      ارجع نتيجة
   نهاية

   دالة يوم_الأسبوع()
      # خوارزمية Zeller المبسطة
      متغير ش = هذا.الشهر
      متغير س = هذا.السنة
      إذا (ش < 3)
         ش = ش + 12
         س = س - 1
      نهاية
      متغير ق = هذا.اليوم
      متغير ك = س % 100
      متغير ج = س / 100
      متغير ي = (ق + (13 * (ش + 1)) / 5 + ك + ك / 4 + ج / 4 - 2 * ج) % 7
      إذا (ي < 0)
         ي = ي + 7
      نهاية
      متغير أيام_الأسبوع = ["السبت", "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة"]
      ارجع أيام_الأسبوع[ي]
   نهاية

   دالة أضف_أيام(عدد)
      متغير ي = هذا.اليوم + عدد
      متغير ش = هذا.الشهر
      متغير س = هذا.السنة
      بينما (ي > 31)
         ي = ي - 30
         ش = ش + 1
         إذا (ش > 12)
            ش = 1
            س = س + 1
         نهاية
      نهاية
      ارجع جديد تاريخ(س, ش, ي)
   نهاية
نهاية

## وقت: يمثل وقتاً (ساعة، دقيقة، ثانية)
صنف وقت
   باني(الساعة, الدقيقة, الثانية)
      هذا.الساعة = الساعة
      هذا.الدقيقة = الدقيقة
      هذا.الثانية = الثانية
   نهاية

   دالة نص()
      ارجع هذا.الساعة + ":" + هذا.الدقيقة + ":" + هذا.الثانية
   نهاية

   دالة إلى_ثوانٍ()
      ارجع هذا.الساعة * 3600 + هذا.الدقيقة * 60 + هذا.الثانية
   نهاية

   دالة أضف_دقائق(عدد)
      متغير مجموع = هذا.إلى_ثوانٍ() + عدد * 60
      متغير س = (مجموع / 3600) % 24
      متغير د = (مجموع % 3600) / 60
      متغير ث = مجموع % 60
      ارجع جديد وقت(س, د, ث)
   نهاية
نهاية

## دوال مساعدة
دالة الفرق_بالأيام(تاريخ1, تاريخ2)
   # تقريب بسيط
   متغير أيام1 = تاريخ1.السنة * 365 + تاريخ1.الشهر * 30 + تاريخ1.اليوم
   متغير أيام2 = تاريخ2.السنة * 365 + تاريخ2.الشهر * 30 + تاريخ2.اليوم
   متغير فرق = أيام2 - أيام1
   إذا (فرق < 0)
      فرق = -فرق
   نهاية
   ارجع فرق
نهاية

دالة اسم_الشهر(رقم_الشهر)
   متغير أشهر = ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
                   "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"]
   إذا (رقم_الشهر >= 1 و رقم_الشهر <= 12)
      ارجع أشهر[رقم_الشهر - 1]
   نهاية
   ارجع "غير معروف"
نهاية

