## إضافة ساعات
دالة أضف_ساعات(و, عدد)
   متغير مجموع = و.إلى_ثوانٍ() + عدد * 3600
   بينما (مجموع < 0)
      مجموع = مجموع + 86400
   نهاية
   مجموع = مجموع % 86400
   متغير س = (مجموع - مجموع % 3600) / 3600
   متغير باقي = مجموع % 3600
   متغير د = (باقي - باقي % 60) / 60
   متغير ث = باقي % 60
   ارجع جديد وقت(س, د, ث)
نهاية

## إضافة ثوانٍ
دالة أضف_ثوانٍ(و, عدد)
   متغير مجموع = و.إلى_ثوانٍ() + عدد
   بينما (مجموع < 0)
      مجموع = مجموع + 86400
   نهاية
   مجموع = مجموع % 86400
   متغير س = (مجموع - مجموع % 3600) / 3600
   متغير باقي = مجموع % 3600
   متغير د = (باقي - باقي % 60) / 60
   متغير ث = باقي % 60
   ارجع جديد وقت(س, د, ث)
نهاية

## الفرق بين وقتين (بالثواني)
دالة الفرق_بالثواني(و1, و2)
   متغير فرق = و2.إلى_ثوانٍ() - و1.إلى_ثوانٍ()
   إذا (فرق < 0)
      فرق = فرق * -1
   نهاية
   ارجع فرق
نهاية

## تنسيق وقت مع فترة (12 ساعة)
دالة وقت_12_ساعة(و)
   متغير ساعة = و.الساعة
   متغير فترة = "ص"
   إذا (ساعة >= 12)
      فترة = "م"
   نهاية
   إذا (ساعة > 12)
      ساعة = ساعة - 12
   نهاية
   إذا (ساعة == 0)
      ساعة = 12
   نهاية
   ارجع ساعة + ":" + و.الدقيقة + " " + فترة
نهاية

