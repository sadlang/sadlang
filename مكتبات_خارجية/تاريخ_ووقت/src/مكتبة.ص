## يوم السنة (1-366)
دالة يوم_السنة(ت)
   متغير الأيام = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
   إذا (ت.هل_كبيسة())
      الأيام[1] = 29
   نهاية
   متغير المجموع = 0
   متغير ي = 0
   بينما (ي < ت.الشهر - 1)
      المجموع = المجموع + الأيام[ي]
      ي = ي + 1
   نهاية
   ارجع المجموع + ت.اليوم
نهاية

## رقم الأسبوع في السنة (تقريبي)
دالة رقم_الأسبوع(ت)
   متغير يوم = يوم_السنة(ت)
   ارجع (يوم - 1) / 7 + 1
نهاية

## إضافة أشهر
دالة أضف_أشهر(ت, عدد)
   متغير ش = ت.الشهر + عدد
   متغير س = ت.السنة
   بينما (ش > 12)
      ش = ش - 12
      س = س + 1
   نهاية
   بينما (ش < 1)
      ش = ش + 12
      س = س - 1
   نهاية
   # تأكد أن اليوم صالح
   متغير تاريخ_جديد = جديد تاريخ(س, ش, 1)
   متغير أقصى_أيام = تاريخ_جديد.أيام_الشهر()
   متغير ي = ت.اليوم
   إذا (ي > أقصى_أيام)
      ي = أقصى_أيام
   نهاية
   ارجع جديد تاريخ(س, ش, ي)
نهاية

## إضافة سنوات
دالة أضف_سنوات(ت, عدد)
   متغير س = ت.السنة + عدد
   متغير ي = ت.اليوم
   # فبراير 29 في سنة غير كبيسة
   إذا (ت.الشهر == 2 و ي == 29)
      متغير اختبار = جديد تاريخ(س, 1, 1)
      إذا (ليس اختبار.هل_كبيسة())
         ي = 28
      نهاية
   نهاية
   ارجع جديد تاريخ(س, ت.الشهر, ي)
نهاية

## هل التاريخ قبل تاريخ آخر؟
دالة قبل(ت1, ت2)
   إذا (ت1.السنة < ت2.السنة)
      ارجع صحيح
   نهاية
   إذا (ت1.السنة > ت2.السنة)
      ارجع خطأ
   نهاية
   إذا (ت1.الشهر < ت2.الشهر)
      ارجع صحيح
   نهاية
   إذا (ت1.الشهر > ت2.الشهر)
      ارجع خطأ
   نهاية
   ارجع ت1.اليوم < ت2.اليوم
نهاية

## هل التاريخان متساويان؟
دالة تاريخ_متساوي(ت1, ت2)
   ارجع ت1.السنة == ت2.السنة و ت1.الشهر == ت2.الشهر و ت1.اليوم == ت2.اليوم
نهاية

