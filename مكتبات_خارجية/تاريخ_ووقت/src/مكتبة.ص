صنف موقت
   باني()
      هذا._البداية = 0
      هذا._الأحداث = []
   نهاية

   دالة ابدأ(الوقت_الحالي)
      هذا._البداية = الوقت_الحالي
   نهاية

   دالة سجل(الاسم, الوقت_الحالي)
      متغير المدة = الوقت_الحالي - هذا._البداية
      هذا._الأحداث = هذا._الأحداث + [[الاسم, المدة]]
   نهاية

   دالة اطبع_الأحداث()
      اطبع_سطر("═══ سجل الموقت ═══")
      لكل حدث في هذا._الأحداث
         اطبع_سطر(حدث[0] + ": " + حدث[1] + " ثانية")
      نهاية
   نهاية
نهاية

