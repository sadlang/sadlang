## تنسيق كامل: "الأربعاء 15 يناير 2025"
دالة تاريخ_كامل(ت)
   ارجع ت.يوم_الأسبوع() + " " + ت.اليوم + " " + اسم_الشهر(ت.الشهر) + " " + ت.السنة
نهاية

## تنسيق مختصر: "15/01/2025"
دالة تاريخ_مختصر(ت)
   متغير ي = ت.اليوم
   متغير ش = ت.الشهر
   متغير نص_ي = "" + ي
   متغير نص_ش = "" + ش
   إذا (ي < 10)
      نص_ي = "0" + ي
   نهاية
   إذا (ش < 10)
      نص_ش = "0" + ش
   نهاية
   ارجع نص_ي + "/" + نص_ش + "/" + ت.السنة
نهاية

## تنسيق ISO: "2025-01-15"
دالة تاريخ_iso(ت)
   متغير ي = ت.اليوم
   متغير ش = ت.الشهر
   متغير نص_ي = "" + ي
   متغير نص_ش = "" + ش
   إذا (ي < 10)
      نص_ي = "0" + ي
   نهاية
   إذا (ش < 10)
      نص_ش = "0" + ش
   نهاية
   ارجع ت.السنة + "-" + نص_ش + "-" + نص_ي
نهاية

