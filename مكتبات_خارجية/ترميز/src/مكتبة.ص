## تحويل رقم إلى تمثيل ست عشري
دالة رقم_إلى_ست_عشري(الرقم)
   إذا (الرقم == 0)
      ارجع "0"
   نهاية
   متغير الأحرف = "0123456789abcdef"
   متغير النتيجة = ""
   متغير ن = الرقم
   بينما (ن > 0)
      متغير الباقي = ن % 16
      متغير أحرف_المصفوفة = []
      لكل ح في الأحرف
         أحرف_المصفوفة = أحرف_المصفوفة + [ح]
      نهاية
      النتيجة = أحرف_المصفوفة[الباقي] + النتيجة
      ن = (ن - الباقي) / 16
   نهاية
   ارجع النتيجة
نهاية

## تحويل ست عشري إلى رقم
دالة ست_عشري_إلى_رقم(نص_ست_عشري)
   متغير النتيجة = 0
   متغير الأحرف = "0123456789abcdef"
   لكل حرف في نص_ست_عشري
      متغير القيمة = 0
      متغير ي = 0
      لكل ح في الأحرف
         إذا (ح == حرف)
            القيمة = ي
         نهاية
         ي = ي + 1
      نهاية
      النتيجة = النتيجة * 16 + القيمة
   نهاية
   ارجع النتيجة
نهاية

## تحويل رقم إلى تمثيل ثنائي
دالة رقم_إلى_ثنائي(الرقم)
   إذا (الرقم == 0)
      ارجع "0"
   نهاية
   متغير النتيجة = ""
   متغير ن = الرقم
   بينما (ن > 0)
      إذا (ن % 2 == 0)
         النتيجة = "0" + النتيجة
      وإلا
         النتيجة = "1" + النتيجة
      نهاية
      ن = (ن - ن % 2) / 2
   نهاية
   ارجع النتيجة
نهاية

