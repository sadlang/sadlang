# شفرة مورس (Morse Code)
# ═══════════════════════════════════════════════════════════

دالة إلى_مورس(نص)
   # جدول مورس للأحرف الإنجليزية والأرقام
   متغير الأحرف = "abcdefghijklmnopqrstuvwxyz0123456789"
   متغير أحرف_م = []
   لكل ح في الأحرف
      أحرف_م = أحرف_م + [ح]
   نهاية
   متغير المورس = [".-", "-...", "-.-.", "-..", ".", "..-.", "--.", "....", "..", ".---",
                    "-.-", ".-..", "--", "-.", "---", ".--.", "--.-", ".-.", "...", "-",
                    "..-", "...-", ".--", "-..-", "-.--", "--..",
                    "-----", ".----", "..---", "...--", "....-", ".....", "-....", "--...", "---..", "----."]
   
   متغير النتيجة = ""
   متغير أول = صحيح
   
   لكل حرف في نص
      إذا (حرف == " ")
         النتيجة = النتيجة + " / "
         أول = صحيح
      وإلا
         # تحويل إلى صغير
         متغير حرف_صغير = حرف
         متغير كبيرة = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
         متغير صغيرة = "abcdefghijklmnopqrstuvwxyz"
         متغير ك = 0
         متغير كبيرة_م = []
         لكل ح في كبيرة
            كبيرة_م = كبيرة_م + [ح]
         نهاية
         متغير صغيرة_م = []
         لكل ح في صغيرة
            صغيرة_م = صغيرة_م + [ح]
         نهاية
         لكل ح في كبيرة_م
            إذا (حرف == ح)
               حرف_صغير = صغيرة_م[ك]
            نهاية
            ك = ك + 1
         نهاية
         
         # ابحث عن الحرف في الجدول
         متغير وجد = خطأ
         متغير ي = 0
         لكل ح في أحرف_م
            إذا (ح == حرف_صغير و ليس وجد)
               إذا (ليس أول)
                  النتيجة = النتيجة + " "
               نهاية
               النتيجة = النتيجة + المورس[ي]
               وجد = صحيح
               أول = خطأ
            نهاية
            ي = ي + 1
         نهاية
      نهاية
   نهاية
   ارجع النتيجة
نهاية

# ═══════════════════════════════════════════════════════════
# ترميز Run-Length Encoding (RLE)
# ═══════════════════════════════════════════════════════════

دالة rle_ترميز(نص)
   متغير الأحرف = []
   لكل ح في نص
      الأحرف = الأحرف + [ح]
   نهاية
   متغير الطول = 0
   لكل _ في الأحرف
      الطول = الطول + 1
   نهاية
   إذا (الطول == 0)
      ارجع ""
   نهاية
   
   متغير النتيجة = ""
   متغير الحالي = الأحرف[0]
   متغير العدد = 1
   متغير ي = 1
   بينما (ي < الطول)
      إذا (الأحرف[ي] == الحالي)
         العدد = العدد + 1
      وإلا
         النتيجة = النتيجة + الحالي + العدد
         الحالي = الأحرف[ي]
         العدد = 1
      نهاية
      ي = ي + 1
   نهاية
   النتيجة = النتيجة + الحالي + العدد
   ارجع النتيجة
نهاية

