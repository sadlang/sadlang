# تشفير قيصر (Caesar Cipher)
# ═══════════════════════════════════════════════════════════

دالة قيصر_تشفير(نص, إزاحة)
   متغير النتيجة = ""
   متغير أحرف_صغيرة = "abcdefghijklmnopqrstuvwxyz"
   متغير أحرف_كبيرة = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
   
   لكل حرف في نص
      متغير تم = خطأ
      # أحرف صغيرة
      متغير ي = 0
      متغير صغيرة_م = []
      لكل ح في أحرف_صغيرة
         صغيرة_م = صغيرة_م + [ح]
      نهاية
      لكل ح في صغيرة_م
         إذا (حرف == ح و ليس تم)
            النتيجة = النتيجة + صغيرة_م[(ي + إزاحة) % 26]
            تم = صحيح
         نهاية
         ي = ي + 1
      نهاية
      # أحرف كبيرة
      ي = 0
      متغير كبيرة_م = []
      لكل ح في أحرف_كبيرة
         كبيرة_م = كبيرة_م + [ح]
      نهاية
      لكل ح في كبيرة_م
         إذا (حرف == ح و ليس تم)
            النتيجة = النتيجة + كبيرة_م[(ي + إزاحة) % 26]
            تم = صحيح
         نهاية
         ي = ي + 1
      نهاية
      إذا (ليس تم)
         النتيجة = النتيجة + حرف
      نهاية
   نهاية
   ارجع النتيجة
نهاية

دالة قيصر_فك(نص, إزاحة)
   ارجع قيصر_تشفير(نص, 26 - إزاحة % 26)
نهاية

