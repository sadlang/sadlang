# عكس النص
# ═══════════════════════════════════════════════════════════

دالة اعكس(نص)
   متغير الأحرف = []
   لكل ح في نص
      الأحرف = الأحرف + [ح]
   نهاية
   متغير الطول = 0
   لكل _ في الأحرف
      الطول = الطول + 1
   نهاية
   متغير النتيجة = ""
   متغير ي = الطول - 1
   بينما (ي >= 0)
      النتيجة = النتيجة + الأحرف[ي]
      ي = ي - 1
   نهاية
   ارجع النتيجة
نهاية

