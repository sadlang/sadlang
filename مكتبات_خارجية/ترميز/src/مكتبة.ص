## ترميز URL بسيط (يحول المسافات إلى %20)
دالة ترميز_url(نص)
   متغير النتيجة = ""
   لكل حرف في نص
      إذا (حرف == " ")
         النتيجة = النتيجة + "%20"
      وإلا
         إذا (حرف == "&")
            النتيجة = النتيجة + "%26"
         وإلا
            إذا (حرف == "=")
               النتيجة = النتيجة + "%3D"
            وإلا
               إذا (حرف == "?")
                  النتيجة = النتيجة + "%3F"
               وإلا
                  النتيجة = النتيجة + حرف
               نهاية
            نهاية
         نهاية
      نهاية
   نهاية
   ارجع النتيجة
نهاية

## فك ترميز URL بسيط
دالة فك_ترميز_url(نص)
   متغير النتيجة = ""
   متغير الأحرف = []
   لكل حرف في نص
      الأحرف = الأحرف + [حرف]
   نهاية
   متغير الطول = 0
   لكل _ في الأحرف
      الطول = الطول + 1
   نهاية
   متغير ي = 0
   بينما (ي < الطول)
      إذا (الأحرف[ي] == "%" و ي + 2 < الطول)
         متغير كود = الأحرف[ي + 1] + الأحرف[ي + 2]
         إذا (كود == "20")
            النتيجة = النتيجة + " "
         وإلا
            إذا (كود == "26")
               النتيجة = النتيجة + "&"
            وإلا
               إذا (كود == "3D")
                  النتيجة = النتيجة + "="
               وإلا
                  إذا (كود == "3F")
                     النتيجة = النتيجة + "?"
                  وإلا
                     النتيجة = النتيجة + "%" + كود
                  نهاية
               نهاية
            نهاية
         نهاية
         ي = ي + 3
      وإلا
         النتيجة = النتيجة + الأحرف[ي]
         ي = ي + 1
      نهاية
   نهاية
   ارجع النتيجة
نهاية

## ترميز ROT13 (تشفير بسيط)
دالة rot13(نص)
   متغير النتيجة = ""
   متغير أحرف_صغيرة = "abcdefghijklmnopqrstuvwxyz"
   متغير أحرف_كبيرة = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
   
   لكل حرف في نص
      متغير تم = خطأ
      # بحث في الأحرف الصغيرة
      متغير ي = 0
      لكل ح في أحرف_صغيرة
         إذا (حرف == ح و ليس تم)
            متغير أحرف_م = []
            لكل ح2 في أحرف_صغيرة
               أحرف_م = أحرف_م + [ح2]
            نهاية
            النتيجة = النتيجة + أحرف_م[(ي + 13) % 26]
            تم = صحيح
         نهاية
         ي = ي + 1
      نهاية
      # بحث في الأحرف الكبيرة
      ي = 0
      لكل ح في أحرف_كبيرة
         إذا (حرف == ح و ليس تم)
            متغير أحرف_ك = []
            لكل ح2 في أحرف_كبيرة
               أحرف_ك = أحرف_ك + [ح2]
            نهاية
            النتيجة = النتيجة + أحرف_ك[(ي + 13) % 26]
            تم = صحيح
         نهاية
         ي = ي + 1
      نهاية
      إذا (ليس تم)
         النتيجة = النتيجة + حرف
      نهاية
   نهاية
   ارجع النتيجة
نهاية

