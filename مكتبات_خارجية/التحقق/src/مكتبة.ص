## التحقق من طول النص
دالة طول_بين(نص, أدنى, أقصى)
   متغير ط = 0
   متغير ن2 = نص + ""
   # حساب الطول بالتكرار
   لكل حرف في نص
      ط = ط + 1
   نهاية
   ارجع ط >= أدنى و ط <= أقصى
نهاية

## التحقق من أن النص يحتوي على أرقام فقط
دالة أرقام_فقط(نص)
   إذا (نص == "")
      ارجع خطأ
   نهاية
   متغير الأرقام = "0123456789"
   لكل حرف في نص
      متغير موجود = خطأ
      لكل رقم في الأرقام
         إذا (حرف == رقم)
            موجود = صحيح
         نهاية
      نهاية
      إذا (ليس موجود)
         ارجع خطأ
      نهاية
   نهاية
   ارجع صحيح
نهاية

## التحقق من أن النص يحتوي على حروف فقط (إنجليزية)
دالة حروف_فقط(نص)
