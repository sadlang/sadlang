نهاية

## التحقق من صحة البريد الإلكتروني (تحقق بسيط)
دالة بريد_صالح(بريد)
   إذا (بريد == "" أو بريد == لاشيء)
      ارجع خطأ
   نهاية
   متغير وجد_آت = خطأ
   متغير وجد_نقطة_بعد = خطأ
   متغير بعد_آت = خطأ
   لكل حرف في بريد
      إذا (حرف == "@")
         إذا (وجد_آت)
            ارجع خطأ
         نهاية
         وجد_آت = صحيح
         بعد_آت = صحيح
      نهاية
      إذا (حرف == "." و بعد_آت)
         وجد_نقطة_بعد = صحيح
      نهاية
   نهاية
   ارجع وجد_آت و وجد_نقطة_بعد
نهاية

