## التحقق من أن النص يبدأ بحرف معين
دالة يبدأ_بـ(نص, بادئة)
   متغير أحرف_نص = []
   لكل ح في نص
      أحرف_نص = أحرف_نص + [ح]
   نهاية
   متغير أحرف_بادئة = []
   لكل ح في بادئة
      أحرف_بادئة = أحرف_بادئة + [ح]
   نهاية
   متغير طول_بادئة = _طول(بادئة)
   إذا (_طول(نص) < طول_بادئة)
      ارجع خطأ
   نهاية
   متغير ي = 0
   لكل ح في أحرف_بادئة
      إذا (أحرف_نص[ي] != ح)
         ارجع خطأ
      نهاية
      ي = ي + 1
   نهاية
   ارجع صحيح
نهاية

## التحقق من أن النص ينتهي بنص معين
دالة ينتهي_بـ(نص, لاحقة)
   متغير أحرف_نص = []
   لكل ح في نص
      أحرف_نص = أحرف_نص + [ح]
   نهاية
   متغير أحرف_لاحقة = []
   لكل ح في لاحقة
      أحرف_لاحقة = أحرف_لاحقة + [ح]
   نهاية
   متغير طول_نص = _طول(نص)
   متغير طول_لاحقة = _طول(لاحقة)
   إذا (طول_نص < طول_لاحقة)
      ارجع خطأ
   نهاية
   متغير بداية = طول_نص - طول_لاحقة
   متغير ي = 0
   لكل ح في أحرف_لاحقة
      إذا (أحرف_نص[بداية + ي] != ح)
         ارجع خطأ
      نهاية
      ي = ي + 1
   نهاية
   ارجع صحيح
نهاية

## التحقق من قوة كلمة المرور
## يرجع مصفوفة [القوة, الأخطاء]
## القوة: "ضعيفة", "متوسطة", "قوية", "قوية جداً"
دالة قوة_كلمة_مرور(كلمة_مرور)
   متغير الطول = _طول(كلمة_مرور)
   متغير الأخطاء = []
   متغير نقاط = 0
   
   # التحقق من الطول
   إذا (الطول < 6)
      الأخطاء = الأخطاء + ["يجب أن تكون 6 أحرف على الأقل"]
   وإلا
      إذا (الطول >= 8)
         نقاط = نقاط + 1
      نهاية
      إذا (الطول >= 12)
         نقاط = نقاط + 1
      نهاية
   نهاية
   
   # التحقق من وجود أرقام
   متغير يوجد_رقم = خطأ
   متغير الأرقام = "0123456789"
   لكل حرف في كلمة_مرور
      لكل رقم في الأرقام
         إذا (حرف == رقم)
            يوجد_رقم = صحيح
         نهاية
      نهاية
   نهاية
   إذا (يوجد_رقم)
      نقاط = نقاط + 1
   وإلا
      الأخطاء = الأخطاء + ["يجب أن تحتوي على رقم واحد على الأقل"]
   نهاية
   
   # التحقق من وجود أحرف صغيرة
   متغير يوجد_صغير = خطأ
   متغير أحرف_صغيرة = "abcdefghijklmnopqrstuvwxyz"
   لكل حرف في كلمة_مرور
      لكل ح في أحرف_صغيرة
         إذا (حرف == ح)
            يوجد_صغير = صحيح
         نهاية
      نهاية
   نهاية
   إذا (يوجد_صغير)
      نقاط = نقاط + 1
   نهاية
   
   # التحقق من وجود أحرف كبيرة
   متغير يوجد_كبير = خطأ
   متغير أحرف_كبيرة = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
   لكل حرف في كلمة_مرور
      لكل ح في أحرف_كبيرة
         إذا (حرف == ح)
            يوجد_كبير = صحيح
         نهاية
      نهاية
   نهاية
   إذا (يوجد_كبير)
      نقاط = نقاط + 1
   نهاية
   
   # النتيجة
   متغير القوة = "ضعيفة"
   إذا (نقاط >= 4)
      القوة = "قوية جداً"
   وإلا
      إذا (نقاط >= 3)
         القوة = "قوية"
      وإلا
         إذا (نقاط >= 2)
            القوة = "متوسطة"
         نهاية
      نهاية
   نهاية
   
   ارجع [القوة, الأخطاء]
نهاية

## التحقق باستخدام خوارزمية Luhn (بطاقات ائتمان)
دالة لون_صالح(الرقم)
   متغير الأحرف = []
   لكل ح في الرقم
      الأحرف = الأحرف + [ح]
   نهاية
   متغير الطول = _طول(الرقم)
   
   متغير المجموع = 0
   متغير ي = الطول - 1
   متغير مضاعف = خطأ
   بينما (ي >= 0)
      متغير أرقام_م = "0123456789"
      متغير أرقام_مصفوفة = []
      لكل ر في أرقام_م
         أرقام_مصفوفة = أرقام_مصفوفة + [ر]
      نهاية
      متغير الرقم = 0
      متغير ك = 0
      لكل ر في أرقام_مصفوفة
         إذا (ر == الأحرف[ي])
            الرقم = ك
         نهاية
         ك = ك + 1
      نهاية
      
      إذا (مضاعف)
         الرقم = الرقم * 2
         إذا (الرقم > 9)
            الرقم = الرقم - 9
         نهاية
      نهاية
      
      المجموع = المجموع + الرقم
      مضاعف = ليس مضاعف
      ي = ي - 1
   نهاية
   
   ارجع المجموع % 10 == 0
نهاية

