## قاعدة تحقق مخصصة
صنف قاعدة_تحقق
   متغير الاسم = ""
   متغير الرسالة = ""
   
   باني(الاسم, الرسالة)
      هذا.الاسم = الاسم
      هذا.الرسالة = الرسالة
   نهاية
نهاية

## نتيجة التحقق
صنف نتيجة
   متغير صالح = صحيح
   متغير الأخطاء = []
   
   باني()
      هذا.صالح = صحيح
      هذا.الأخطاء = []
   نهاية
   
   دالة أضف_خطأ(رسالة)
      هذا.صالح = خطأ
      هذا.الأخطاء = هذا.الأخطاء + [رسالة]
   نهاية
   
   دالة اطبع_الأخطاء()
      إذا (هذا.صالح)
         اطبع_سطر("✅ جميع التحققات نجحت")
      وإلا
         اطبع_سطر("❌ أخطاء التحقق:")
         لكل خطأ في هذا.الأخطاء
            اطبع_سطر("  - " + خطأ)
         نهاية
      نهاية
   نهاية
نهاية

