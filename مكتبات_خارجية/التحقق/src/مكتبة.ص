صنف محقق
   باني(الاسم)
      هذا.الاسم = الاسم
      هذا._النتيجة = جديد نتيجة()
   نهاية

   دالة تحقق_ليس_فارغاً(القيمة)
      إذا (ليس ليس_فارغاً(القيمة))
         هذا._النتيجة.أضف_خطأ(هذا.الاسم + " لا يمكن أن يكون فارغاً")
      نهاية
      ارجع هذا
   نهاية

   دالة تحقق_طول(القيمة, أدنى, أقصى)
      إذا (ليس طول_بين(القيمة, أدنى, أقصى))
         هذا._النتيجة.أضف_خطأ(هذا.الاسم + " يجب أن يكون بين " + أدنى + " و " + أقصى + " حرفاً")
      نهاية
      ارجع هذا
   نهاية

   دالة تحقق_أرقام(القيمة)
      إذا (ليس أرقام_فقط(القيمة))
         هذا._النتيجة.أضف_خطأ(هذا.الاسم + " يجب أن يحتوي على أرقام فقط")
      نهاية
      ارجع هذا
   نهاية

   دالة تحقق_بريد(القيمة)
      إذا (ليس بريد_صالح(القيمة))
         هذا._النتيجة.أضف_خطأ(هذا.الاسم + " بريد إلكتروني غير صالح")
      نهاية
      ارجع هذا
   نهاية

   دالة تحقق_نطاق(القيمة, أدنى, أقصى)
      إذا (ليس في_نطاق(القيمة, أدنى, أقصى))
         هذا._النتيجة.أضف_خطأ(هذا.الاسم + " يجب أن يكون بين " + أدنى + " و " + أقصى)
      نهاية
      ارجع هذا
   نهاية

   دالة النتيجة()
      ارجع هذا._النتيجة
   نهاية
نهاية

