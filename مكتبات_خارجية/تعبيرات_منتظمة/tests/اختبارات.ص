من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد تعبير، نتيجة_مطابقة، أعلام
من مكتبات_خارجية.تعبيرات_منتظمة.src.مكتبة استورد تطابق، بحث، بحث_الكل، استبدل، استبدل_الكل، تقسيم، يحتوي

# =============================================================================
#                   إطار الاختبار البسيط / Simple Test Framework
# =============================================================================

متغير عدد_النجاح = 0
متغير عدد_الفشل = 0
متغير عدد_الاختبارات = 0

دالة تحقق(نص الاسم، الشرط)
    عدد_الاختبارات = عدد_الاختبارات + 1
    إذا (الشرط == 1 أو الشرط == صحيح)
        عدد_النجاح = عدد_النجاح + 1
        اطبع("  ✓ ")
        اطبع_سطر(الاسم)
    وإلا
        عدد_الفشل = عدد_الفشل + 1
        اطبع("  ✗ فشل: ")
        اطبع_سطر(الاسم)
    نهاية
نهاية

دالة تحقق_نص(نص الاسم، نص الفعلي، نص المتوقع)
    عدد_الاختبارات = عدد_الاختبارات + 1
    إذا (الفعلي == المتوقع)
        عدد_النجاح = عدد_النجاح + 1
        اطبع("  ✓ ")
        اطبع_سطر(الاسم)
    وإلا
        عدد_الفشل = عدد_الفشل + 1
        اطبع("  ✗ فشل: ")
        اطبع_سطر(الاسم)
        اطبع("    المتوقع: '")
        اطبع(المتوقع)
        اطبع_سطر("'")
        اطبع("    الفعلي:  '")
        اطبع(الفعلي)
        اطبع_سطر("'")
    نهاية
نهاية

دالة ابدأ_مجموعة(نص العنوان)
    اطبع_سطر("")
    اطبع("═══ ")
    اطبع_سطر(العنوان)
نهاية

دالة اطبع_ملخص()
    اطبع_سطر("")
    اطبع_سطر("══════════════════════════════════════")
    اطبع("النتيجة: ")
    اطبع(عدد_النجاح)
    اطبع(" نجح، ")
    اطبع(عدد_الفشل)
    اطبع(" فشل، إجمالي ")
    اطبع_سطر(عدد_الاختبارات)
    اطبع_سطر("══════════════════════════════════════")
    إذا (عدد_الفشل == 0)
        اطبع_سطر("✓ جميع الاختبارات نجحت!")
    وإلا
        اطبع_سطر("✗ بعض الاختبارات فشلت!")
    نهاية
نهاية


# =============================================================================
#                اختبارات المطابقة الأساسية / Basic Match Tests
# =============================================================================

دالة اختبار_مطابقة_أساسية()
    ابدأ_مجموعة("المطابقة الأساسية")

    # حروف حرفية
    تحقق("حروف حرفية بسيطة", تطابق("مرحبا", "مرحبا", 0))
    تحقق("حروف حرفية إنجليزية", تطابق("hello", "hello", 0))
    تحقق("لا تطابق مختلف", 1 - تطابق("hello", "world", 0))

    # النقطة
    تحقق("نقطة تطابق أي حرف", تطابق(".", "أ", 0))
    تحقق("نقطة تطابق رقم", تطابق(".", "5", 0))
    تحقق("نقطة لا تطابق سطر جديد", 1 - تطابق(".", "\n", 0))

    # التتابع
    تحقق("أ.ب تطابق 'أهب'", تطابق("أ.ب", "أهب", 0))
    تحقق("أ.ب لا تطابق 'أهج'", 1 - تطابق("أ.ج", "أهب", 0))
نهاية


# =============================================================================
#                اختبارات الكميات / Quantifier Tests
# =============================================================================

دالة اختبار_كميات()
    ابدأ_مجموعة("الكميات")

    # نجمة *
    تحقق("* صفر مرة", تطابق("أ*ب", "ب", 0))
    تحقق("* مرة واحدة", تطابق("أ*ب", "أب", 0))
    تحقق("* عدة مرات", تطابق("أ*ب", "أأأب", 0))

    # زائد +
    تحقق("+ واحد على الأقل", تطابق("أ+", "أ", 0))
    تحقق("+ عدة", تطابق("أ+", "أأأ", 0))
    تحقق("+ لا يقبل صفر", 1 - تطابق("أ+", "", 0))

    # علامة استفهام ?
    تحقق("? صفر مرة", تطابق("أ?ب", "ب", 0))
    تحقق("? مرة واحدة", تطابق("أ?ب", "أب", 0))
    تحقق("? لا يقبل أكثر من مرة", 1 - تطابق("أ?ب", "أأب", 0))

    # الكمية المحددة {n}
    تحقق("{3} بالضبط", تطابق("أ{3}", "أأأ", 0))
    تحقق("{3} لا يقبل أقل", 1 - تطابق("أ{3}", "أأ", 0))
    تحقق("{3} لا يقبل أكثر", 1 - تطابق("أ{3}", "أأأأ", 0))

    # الكمية {n,m}
    تحقق("{2,4} الحد الأدنى", تطابق("أ{2,4}", "أأ", 0))
    تحقق("{2,4} الوسط", تطابق("أ{2,4}", "أأأ", 0))
    تحقق("{2,4} الحد الأقصى", تطابق("أ{2,4}", "أأأأ", 0))
    تحقق("{2,4} لا يقبل أقل من الحد الأدنى", 1 - تطابق("أ{2,4}", "أ", 0))

    # الكمية الكسولة *?
    متغير ن1 = بحث("<.+?>", "<مرحبا><عالم>", 0)
    إذا (ن1 != لاشيء)
        تحقق_نص("كسولة *? تأخذ أقل ما يمكن", ن1.النص_المطابق, "<مرحبا>")
    وإلا
        تحقق("كسولة *? وجد تطابق", 0)
    نهاية
نهاية


# =============================================================================
#           اختبارات فئات الحروف / Character Class Tests
# =============================================================================

دالة اختبار_فئات_حروف()
    ابدأ_مجموعة("فئات الحروف")

    # فئة بسيطة
    تحقق("[abc] تطابق a", يحتوي("[abc]", "a", 0))
    تحقق("[abc] تطابق b", يحتوي("[abc]", "b", 0))
    تحقق("[abc] لا تطابق d", 1 - يحتوي("[abc]", "d", 0))

    # نطاق
    تحقق("[a-z] تطابق حرفاً صغيراً", يحتوي("[a-z]", "m", 0))
    تحقق("[0-9] تطابق رقماً", يحتوي("[0-9]", "7", 0))
    تحقق("[a-z] لا تطابق رقماً", 1 - يحتوي("[a-z]", "5", 0))

    # فئة سلبية
    تحقق("[^abc] لا تطابق a", 1 - يحتوي("[^abc]", "a", 0))
    تحقق("[^abc] تطابق d", يحتوي("[^abc]", "d", 0))
    تحقق("[^0-9] لا تطابق رقماً", 1 - يحتوي("[^0-9]", "5", 0))

    # فئات خاصة
    تحقق("\\d تطابق رقماً", يحتوي("\\d", "9", 0))
    تحقق("\\d لا تطابق حرفاً", 1 - يحتوي("\\d", "أ", 0))
    تحقق("\\w تطابق حرف كلمة", يحتوي("\\w", "a", 0))
    تحقق("\\s تطابق مسافة", يحتوي("\\s", " ", 0))
    تحقق("\\S لا تطابق مسافة", 1 - يحتوي("\\S", " ", 0))
نهاية


# =============================================================================
#              اختبارات التناوب والمجموعات / Alternation & Groups
# =============================================================================

دالة اختبار_تناوب_ومجموعات()
    ابدأ_مجموعة("التناوب والمجموعات")

    # تناوب |
    تحقق("تناوب: الخيار الأول", يحتوي("قط|كلب", "قط", 0))
    تحقق("تناوب: الخيار الثاني", يحتوي("قط|كلب", "كلب", 0))
    تحقق("تناوب: لا يطابق غيرهما", 1 - يحتوي("قط|كلب", "سمكة", 0))

    # مجموعات التقاطية
    متغير ن2 = بحث("(\\d+)-(\\d+)", "الرقم 123-456 في النص", 0)
    إذا (ن2 != لاشيء)
        تحقق_نص("مجموعة (1)", ن2.مجموعة(1), "123")
        تحقق_نص("مجموعة (2)", ن2.مجموعة(2), "456")
    وإلا
        تحقق("وجد تطابق مجموعات", 0)
    نهاية

    # مجموعة غير التقاطية
    متغير ن3 = بحث("(?:مر|أهل)حبا", "مرحبا بكم", 0)
    إذا (ن3 != لاشيء)
        تحقق_نص("(?:...) لا تلتقط", ن3.النص_المطابق, "مرحبا")
    وإلا
        تحقق("(?:...) وجد تطابق", 0)
    نهاية
نهاية


