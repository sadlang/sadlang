# =============================================================================
#             اختبارات المجموعات المسماة / Named Groups Tests
# =============================================================================

دالة اختبار_مجموعات_مسماة()
    ابدأ_مجموعة("المجموعات المسماة")

    # صيغة (اسم:نمط) — تحديد الاسم
    متغير ن1 = بحث("(السنة:\\d{4})-(الشهر:\\d{2})-(اليوم:\\d{2})", "التاريخ: 2024-03-15", 0)
    إذا (ن1 != لاشيء)
        تحقق_نص("(اسم:نمط) — مجموعة السنة", ن1.مجموعة_مسماة("السنة"), "2024")
        تحقق_نص("(اسم:نمط) — مجموعة الشهر", ن1.مجموعة_مسماة("الشهر"), "03")
        تحقق_نص("(اسم:نمط) — مجموعة اليوم", ن1.مجموعة_مسماة("اليوم"), "15")
    وإلا
        تحقق("مجموعات مسماة — وجد تطابق", 0)
    نهاية

    # مجموعة مسماة بأسماء إنجليزية
    متغير ن2 = بحث("(year:\\d{4})-(month:\\d{2})", "2025-07", 0)
    إذا (ن2 != لاشيء)
        تحقق_نص("اسم إنجليزي — year", ن2.مجموعة_مسماة("year"), "2025")
        تحقق_نص("اسم إنجليزي — month", ن2.مجموعة_مسماة("month"), "07")
    وإلا
        تحقق("مجموعات مسماة إنجليزية — وجد", 0)
    نهاية

    # مجموعة غير مسماة تبقى مجموعة عادية
    متغير ن3 = بحث("(\\d+)-(\\d+)", "100-200", 0)
    إذا (ن3 != لاشيء)
        تحقق_نص("المجموعة العادية تعمل مع المسمى", ن3.مجموعة(1), "100")
        تحقق_نص("المجموعة العادية 2", ن3.مجموعة(2), "200")
    وإلا
        تحقق("مجموعة عادية داخل نمط مسمى — وجد", 0)
    نهاية

    # صيغة (?<اسم>نمط) — صيغة .NET/PCRE
    متغير ن4 = بحث("(?<كلمة>[a-z]+)", "hello world", 0)
    إذا (ن4 != لاشيء)
        تحقق_نص("(?<name>) — صحيح", ن4.مجموعة_مسماة("كلمة"), "hello")
    وإلا
        تحقق("(?<name>) — وجد تطابق", 0)
    نهاية

    # صيغة (?P<name>...) — صيغة Python
    متغير ن5 = بحث("(?P<رقم>\\d+)", "الرقم 42", 0)
    إذا (ن5 != لاشيء)
        تحقق_نص("(?P<name>) — صحيح", ن5.مجموعة_مسماة("رقم"), "42")
    وإلا
        تحقق("(?P<name>) — وجد", 0)
    نهاية

    # مرجع خلفي مُسمى \k<اسم>
    متغير ن6 = بحث("(كلمة:\\w+)\\s+\\k<كلمة>", "مرحبا مرحبا", 0)
    إذا (ن6 != لاشيء)
        تحقق_نص("\\k<name> — نجح الكلمة المكررة", ن6.مجموعة_مسماة("كلمة"), "مرحبا")
    وإلا
        تحقق("\\k<name> — وجد تطابق", 0)
    نهاية

    # مرجع خلفي مُسمى بصيغة (?P=اسم)
    متغير ن7 = بحث("(tag:\\w+)\\s+(?P=tag)", "test test", 0)
    إذا (ن7 != لاشيء)
        تحقق_نص("(?P=name) — نجح", ن7.مجموعة_مسماة("tag"), "test")
    وإلا
        تحقق("(?P=name) — وجد تطابق", 0)
    نهاية

    # مجموعة مسماة مع الاستبدال (يستخدم رقم المجموعة في البديل)
    متغير ن8_نص = استبدل("(الاسم:[A-Za-z]+)", "المستخدم John محظوظ", "[\\1]", 0)
    تحقق("استبدال مجموعة مسماة بالرقم", يحتوي("\\[", ن8_نص, 0))

    # مجموعة مسماة فارغة إن لم نجد الاسم
    متغير ن9 = بحث("(اسم:\\w+)", "كلمة", 0)
    إذا (ن9 != لاشيء)
        تحقق_نص("مجموعة مسماة غير موجودة ترجع فارغ", ن9.مجموعة_مسماة("مجهول"), "")
    وإلا
        تحقق("اسم غير معرّف — وجد تطابق", 0)
    نهاية
