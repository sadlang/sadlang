#               اختبارات المراسي / Anchor Tests
# =============================================================================

دالة اختبار_مراسي()
    ابدأ_مجموعة("المراسي")

    # ^ مرساة البداية
    تحقق("^ يطابق بداية النص", يحتوي("^مرحبا", "مرحبا بالعالم", 0))
    تحقق("^ لا يطابق في المنتصف", 1 - يحتوي("^العالم", "مرحبا بالعالم", 0))

    # $ مرساة النهاية
    تحقق("$ يطابق نهاية النص", يحتوي("العالم$", "مرحبا بالعالم", 0))
    تحقق("$ لا يطابق في البداية", 1 - يحتوي("مرحبا$", "مرحبا بالعالم", 0))

    # ^ و $ معاً
    تحقق("^...$ يطابق النص كاملاً", يحتوي("^مرحبا$", "مرحبا", 0))
    تحقق("^...$ لا يطابق نصاً أطول", 1 - يحتوي("^مرح$", "مرحبا", 0))
نهاية


# =============================================================================
#              اختبارات البحث والاستبدال / Search & Replace Tests
# =============================================================================

دالة اختبار_بحث_واستبدال()
    ابدأ_مجموعة("البحث والاستبدال")

    # بحث بسيط
    متغير ن4 = بحث("\\d+", "لدي 42 كتاباً", 0)
    إذا (ن4 != لاشيء)
        تحقق_نص("بحث: العثور على تطابق", ن4.النص_المطابق, "42")
        تحقق("بحث: موضع البداية صحيح", ن4.البداية == 4)
    وإلا
        تحقق("بحث: وجد تطابق", 0)
    نهاية

    # بحث_الكل
    متغير كل_أرقام = بحث_الكل("\\d+", "أنا 25 سنة ووزني 70 كجم", 0)
    تحقق("بحث_الكل: عدد النتائج", طول(كل_أرقام) == 2)
    إذا (طول(كل_أرقام) >= 2)
        تحقق_نص("بحث_الكل: النتيجة الأولى", كل_أرقام[0].النص_المطابق, "25")
        تحقق_نص("بحث_الكل: النتيجة الثانية", كل_أرقام[1].النص_المطابق, "70")
    نهاية

    # استبدل
    متغير نص_مستبدل = استبدل("\\d+", "السعر 100 ريال", "***", 0)
    تحقق_نص("استبدل: أول تطابق", نص_مستبدل, "السعر *** ريال")

    # استبدل_الكل
    متغير نص_كل = استبدل_الكل("\\d+", "لدي 5 قطط و 3 كلاب", "N", 0)
    تحقق_نص("استبدل_الكل: جميع التطابقات", نص_كل, "لدي N قطط و N كلاب")

    # استبدال مع مرجع مجموعة \1
    متغير مع_مجموعة = استبدل_الكل("(\\w+)@(\\w+)", "user@example.com أو test@domain.org", "\\2/\\1", 0)
    # تُقلب البريد: username@domain → domain/username

    # تقسيم
    متغير أجزاء = تقسيم("،|,|;", "الرياض,جدة;مكة،المدينة", -1, 0)
    تحقق("تقسيم: عدد الأجزاء", طول(أجزاء) == 4)
    إذا (طول(أجزاء) >= 4)
        تحقق_نص("تقسيم: الجزء الأول", أجزاء[0], "الرياض")
        تحقق_نص("تقسيم: الجزء الأخير", أجزاء[3], "المدينة")
    نهاية
نهاية


