## ملف: محلل.ص  — محلل التعبيرات المنتظمة
من عقد استورد عقدة، عقدة_حرف، عقدة_أي، عقدة_فئة، عقدة_تسلسل
من عقد استورد عقدة_تناوب، عقدة_مجموعة، عقدة_كمية
من عقد استورد عقدة_مرساة، عقدة_فئة_خاصة، عقدة_مرجع، عقدة_مرجع_مسمى

صدّر صنف محلل
    نص النمط
    رقم الموضع
    رقم الطول
    رقم عداد_مجموعات
    رقم الأعلام

    باني(نص نمط، رقم أعلام)
        هذا.النمط = نمط
        هذا.الموضع = 0
        هذا.الطول = طول(هذا.النمط)
        هذا.عداد_مجموعات = 0
        هذا.الأعلام = أعلام
    نهاية

    # ---- دوال مساعدة ----

    دالة رقم نهاية_النمط()
        متغير م = هذا
        ارجع م.الموضع >= م.الطول
    نهاية

    دالة نص اقرأ_حالي()
        متغير م = هذا
        إذا (م.الموضع >= م.الطول)
            ارجع ""
        نهاية
        ارجع استخراج(م.النمط، م.الموضع، 1)
    نهاية

    دالة نص اقرأ_تالي()
        متغير م = هذا
        إذا (م.الموضع + 1 >= م.الطول)
            ارجع ""
        نهاية
        ارجع استخراج(م.النمط، م.الموضع + 1، 1)
    نهاية

    دالة تقدم(رقم ن)
        متغير م = هذا
        م.الموضع = م.الموضع + ن
    نهاية

    دالة نص استهلك()
        متغير م = هذا
        متغير ح = م.اقرأ_حالي()
        م.تقدم(1)
        ارجع ح
    نهاية

    دالة توقع(نص ح)
        متغير م = هذا
        إذا (م.اقرأ_حالي() != ح)
            ارمي("خطأ في النمط: توقعت '" + ح + "' عند الموضع " + م.الموضع)
        نهاية
        م.تقدم(1)
    نهاية

    # ---- المحلل ----

    دالة تحليل()
        متغير م = هذا
        متغير نتيجة = م.تحليل_تعبير()
        إذا (م.الموضع < م.الطول)
            ارمي("خطأ في النمط: حرف غير متوقع")
        نهاية
        ارجع نتيجة
    نهاية

    دالة تحليل_تعبير()
        متغير م = هذا
        متغير خيارات = []
        متغير فرع1 = م.تحليل_تسلسل()
        أضف(خيارات، فرع1)

        بينما (م.الموضع < م.الطول و م.اقرأ_حالي() == "|")
            م.تقدم(1)
            متغير فرع_ج = م.تحليل_تسلسل()
            أضف(خيارات، فرع_ج)
        نهاية

        إذا (طول(خيارات) == 1)
            ارجع خيارات[0]
        نهاية

        متغير عقدة_ت = جديد عقدة_تناوب()
        عقدة_ت.الخيارات = خيارات
        ارجع عقدة_ت
    نهاية

    دالة تحليل_تسلسل()
        متغير م = هذا
        متغير أبناء = []

        بينما (م.الموضع < م.الطول و م.اقرأ_حالي() != "|" و م.اقرأ_حالي() != ")")
            متغير طفل_ت = م.تحليل_مفرد()
            أضف(أبناء، طفل_ت)
        نهاية

        إذا (طول(أبناء) == 0)
            متغير تسلسل_فارغ = جديد عقدة_تسلسل()
            ارجع تسلسل_فارغ
        نهاية

        إذا (طول(أبناء) == 1)
            ارجع أبناء[0]
        نهاية

        متغير عقدة_تس = جديد عقدة_تسلسل()
        عقدة_تس.الأبناء = أبناء
        ارجع عقدة_تس
    نهاية

    دالة تحليل_مفرد()
        متغير م = هذا
        متغير ذرة = م.تحليل_ذرة()
        إذا (م.الموضع >= م.الطول)
            ارجع ذرة
        نهاية
        متغير ح = م.اقرأ_حالي()
        إذا (ح == "*" أو ح == "+" أو ح == "?" أو ح == "{")
            ارجع م.تحليل_كمية(ذرة)
        نهاية
        ارجع ذرة
    نهاية

    دالة تحليل_ذرة()
        متغير م = هذا
        متغير ح = م.اقرأ_حالي()

        إذا (ح == "^")
            م.تقدم(1)
            ارجع جديد عقدة_مرساة(8)
        نهاية

        إذا (ح == "$")
            م.تقدم(1)
            ارجع جديد عقدة_مرساة(9)
        نهاية

        إذا (ح == ".")
            م.تقدم(1)
            متغير يشمل = 0
            إذا (م.الأعلام >= 4)
                متغير علم_s = (م.الأعلام / 4) % 2
                إذا (علم_s == 1)
                    يشمل = 1
                نهاية
            نهاية
            ارجع جديد عقدة_أي(يشمل)
        نهاية

        إذا (ح == "\\")
            م.تقدم(1)
            ارجع م.تحليل_هروب()
        نهاية

        إذا (ح == "[")
            ارجع م.تحليل_فئة()
        نهاية

        إذا (ح == "(")
            ارجع م.تحليل_مجموعة()
        نهاية

        متغير ح2 = م.استهلك()
        ارجع جديد عقدة_حرف(ح2)
    نهاية

    دالة تحليل_هروب()
        متغير م = هذا
        إذا (م.الموضع >= م.الطول)
            ارمي("خطأ في النمط: شرطة مائلة في النهاية")
        نهاية
        متغير ح = م.استهلك()

        إذا (ح == "d" أو ح == "D" أو ح == "w" أو ح == "W" أو ح == "s" أو ح == "S")
            ارجع جديد عقدة_فئة_خاصة(ح)
        نهاية

        إذا (ح == "b" أو ح == "B")
            ارجع جديد عقدة_فئة_خاصة(ح)
        نهاية

        إذا (رمز_حرف(ح، 0) >= 49 و رمز_حرف(ح، 0) <= 57)
            متغير رقم_مرجع = رمز_حرف(ح، 0) - 48
            ارجع جديد عقدة_مرجع(رقم_مرجع)
        نهاية

        ## \k<اسم> — مرجع خلفي مُسمى
        إذا (ح == "k")
            إذا (م.الموضع < م.الطول و م.اقرأ_حالي() == "<")
                م.تقدم(1)
                متغير اسم_ك = ""
                بينما (م.الموضع < م.الطول و م.اقرأ_حالي() != ">")
                    متغير ح_ك = م.استهلك()
                    اسم_ك = اسم_ك + ح_ك
                نهاية
                م.توقع(">")
                ارجع جديد عقدة_مرجع_مسمى(اسم_ك)
            نهاية
            ارجع جديد عقدة_حرف("k")
        نهاية

        إذا (ح == "n")
            ارجع جديد عقدة_حرف("\n")
        نهاية
        إذا (ح == "t")
            ارجع جديد عقدة_حرف("\t")
        نهاية
        إذا (ح == "r")
            ارجع جديد عقدة_حرف("\r")
        نهاية

        ارجع جديد عقدة_حرف(ح)
    نهاية

    دالة تحليل_فئة()
        متغير م = هذا
        م.توقع("[")

        متغير عقدة_ف = جديد عقدة_فئة()

        إذا (م.الموضع < م.الطول و م.اقرأ_حالي() == "^")
            م.تقدم(1)
            عقدة_ف.سلبي = 1
        نهاية

        بينما (م.الموضع < م.الطول و م.اقرأ_حالي() != "]")
            إذا (م.اقرأ_حالي() == "\\")
                م.تقدم(1)
                إذا (م.الموضع >= م.الطول)
                    ارمي("خطأ في النمط: شرطة مائلة في نهاية الفئة")
                نهاية
                متغير ح_هروب = م.استهلك()
                إذا (ح_هروب == "d" أو ح_هروب == "D" أو ح_هروب == "w" أو ح_هروب == "W" أو ح_هروب == "s" أو ح_هروب == "S")
                    أضف(عقدة_ف.العناصر، ["خ", ح_هروب])
                وإلا إذا (ح_هروب == "n")
                    أضف(عقدة_ف.العناصر، ["ح", "\n"])
                وإلا إذا (ح_هروب == "t")
                    أضف(عقدة_ف.العناصر، ["ح", "\t"])
                وإلا إذا (ح_هروب == "r")
                    أضف(عقدة_ف.العناصر، ["ح", "\r"])
                وإلا
                    أضف(عقدة_ف.العناصر، ["ح", ح_هروب])
                نهاية
            وإلا
                متغير ح_الفئة = م.استهلك()
                إذا (م.الموضع < م.الطول و م.اقرأ_حالي() == "-" و م.اقرأ_تالي() != "]")
                    م.تقدم(1)
                    إذا (م.الموضع >= م.الطول)
                        أضف(عقدة_ف.العناصر، ["ح", ح_الفئة])
                        أضف(عقدة_ف.العناصر، ["ح", "-"])
                    وإلا
                        متغير ح_نهاية_ف = م.استهلك()
                        أضف(عقدة_ف.العناصر، ["ن", ح_الفئة, ح_نهاية_ف])
                    نهاية
                وإلا
                    أضف(عقدة_ف.العناصر، ["ح", ح_الفئة])
                نهاية
            نهاية
        نهاية

        م.توقع("]")
        ارجع عقدة_ف
    نهاية

    دالة تحليل_مجموعة()
        متغير م = هذا
        م.توقع("(")

        متغير يلتزم = 1
        متغير اسم_المجموعة_م = ""
        متغير رقم_المجموعة_م = 0

        إذا (م.الموضع < م.الطول و م.اقرأ_حالي() == "?")
            م.تقدم(1)

            إذا (م.الموضع >= م.الطول)
                ارمي("خطأ في النمط: '?' غير مكتملة")
            نهاية

            متغير نوع_م = م.اقرأ_حالي()

            إذا (نوع_م == ":")
                م.تقدم(1)
                يلتزم = 0
            وإلا إذا (نوع_م == "<")
                م.تقدم(1)
                متغير اسم_نص_م = ""
                بينما (م.الموضع < م.الطول و م.اقرأ_حالي() != ">")
                    متغير ح_اسم = م.استهلك()
                    اسم_نص_م = اسم_نص_م + ح_اسم
                نهاية
                م.توقع(">")
                اسم_المجموعة_م = اسم_نص_م
                م.عداد_مجموعات = م.عداد_مجموعات + 1
                رقم_المجموعة_م = م.عداد_مجموعات
            وإلا إذا (نوع_م == "P")
                ## (?P<اسم>...) — صيغة Python للتسمية
                ## (?P=اسم) — مرجع خلفي مُسمى بصيغة Python
                م.تقدم(1)
                إذا (م.الموضع < م.الطول و م.اقرأ_حالي() == "<")
                    م.تقدم(1)
                    متغير اسم_نص_پ = ""
                    بينما (م.الموضع < م.الطول و م.اقرأ_حالي() != ">")
                        متغير ح_اسم_پ = م.استهلك()
                        اسم_نص_پ = اسم_نص_پ + ح_اسم_پ
                    نهاية
                    م.توقع(">")
                    اسم_المجموعة_م = اسم_نص_پ
                    م.عداد_مجموعات = م.عداد_مجموعات + 1
                    رقم_المجموعة_م = م.عداد_مجموعات
                وإلا إذا (م.الموضع < م.الطول و م.اقرأ_حالي() == "=")
                    ## (?P=اسم) — مرجع خلفي مُسمى (يتوقف على اكتمال الاسم بـ ")")
                    م.تقدم(1)
                    متغير اسم_مرجع_پ = ""
                    بينما (م.الموضع < م.الطول و م.اقرأ_حالي() != ")")
                        متغير ح_مرجع_پ = م.استهلك()
                        اسم_مرجع_پ = اسم_مرجع_پ + ح_مرجع_پ
                    نهاية
                    م.توقع(")")
                    ## أرجع مرجع مُسمى مباشرةً (لا يوجد طفل — عقدة كاملة بدون تحليل_تعبير)
                    ارجع جديد عقدة_مرجع_مسمى(اسم_مرجع_پ)
                وإلا
                    ارمي("خطأ في النمط: توقعت '<' أو '=' بعد ?P")
                نهاية
            وإلا إذا (نوع_م == "=")
                م.تقدم(1)
                يلتزم = 0
            وإلا إذا (نوع_م == "!")
                م.تقدم(1)
                يلتزم = 0
            وإلا
                ارمي("خطأ في النمط: نوع مجموعة غير مدعوم")
            نهاية
        وإلا
            ## تحقق من صيغة (اسم:نمط) — اسم يتبعه ':' مباشرة قبل أي شيء آخر
            متغير اسم_مؤقت = ""
            متغير موضع_مبدأ = م.الموضع
            متغير يحتوي_نقطتين = 0

            ## اقرأ حروف الاسم حتى ':' أو حرف غير معرّف
            ## ملاحظة: توقف لا يعمل داخل إذا/وإلا — نستخدم متغير الاستمرار
            متغير استمر_م = 1
            بينما (م.الموضع < م.الطول و استمر_م == 1)
                متغير ح_ن = م.اقرأ_حالي()
                متغير رمز_ن = رمز_حرف(ح_ن، 0)
                ## حروف مسموح بها في الاسم: a-z A-Z 0-9 _ والعربية (216-219)
                متغير هو_حرف_اسم = 0
                إذا ((رمز_ن >= 65 و رمز_ن <= 90) أو (رمز_ن >= 97 و رمز_ن <= 122))
                    هو_حرف_اسم = 1
                نهاية
                إذا (رمز_ن >= 48 و رمز_ن <= 57)
                    هو_حرف_اسم = 1
                نهاية
                إذا (رمز_ن == 95)
                    هو_حرف_اسم = 1
                نهاية
                إذا (رمز_ن >= 216 و رمز_ن <= 219)
                    هو_حرف_اسم = 1
                نهاية
                إذا (هو_حرف_اسم == 1)
                    اسم_مؤقت = اسم_مؤقت + ح_ن
                    م.تقدم(1)
                وإلا إذا (ح_ن == ":")
                    يحتوي_نقطتين = 1
                    م.تقدم(1)
                    استمر_م = 0
                وإلا
                    استمر_م = 0
                نهاية
            نهاية

            إذا (يحتوي_نقطتين == 1 و طول(اسم_مؤقت) > 0)
                ## صيغة (اسم:نمط) — مجموعة مسماة عربية
                اسم_المجموعة_م = اسم_مؤقت
                م.عداد_مجموعات = م.عداد_مجموعات + 1
                رقم_المجموعة_م = م.عداد_مجموعات
            وإلا
                ## ليست صيغة مسماة — ارجع للبداية ونجعلها مجموعة عادية
                م.الموضع = موضع_مبدأ
                م.عداد_مجموعات = م.عداد_مجموعات + 1
                رقم_المجموعة_م = م.عداد_مجموعات
            نهاية
        نهاية

        متغير طفل_م = م.تحليل_تعبير()
        م.توقع(")")

        ارجع جديد عقدة_مجموعة(رقم_المجموعة_م، طفل_م، اسم_المجموعة_م، يلتزم)
    نهاية

    دالة تحليل_كمية(ذرة)
        متغير م = هذا
        متغير ح = م.استهلك()

        متغير أدنى_ك = 0
        متغير أقصى_ك = -1
        متغير جشع_ك = 1

        إذا (ح == "*")
            أدنى_ك = 0
            أقصى_ك = -1
        وإلا إذا (ح == "+")
            أدنى_ك = 1
            أقصى_ك = -1
        وإلا إذا (ح == "?")
            أدنى_ك = 0
            أقصى_ك = 1
        وإلا إذا (ح == "{")
            متغير أدنى_نص = ""
            بينما (م.الموضع < م.الطول و م.اقرأ_حالي() != "," و م.اقرأ_حالي() != "}")
                متغير ح_رقم = م.استهلك()
                أدنى_نص = أدنى_نص + ح_رقم
            نهاية

            إذا (طول(أدنى_نص) == 0)
                ارمي("خطأ في النمط: الحد الأدنى في {} فارغ")
            نهاية

            أدنى_ك = م.حول_إلى_رقم(أدنى_نص)

            إذا (م.الموضع < م.الطول و م.اقرأ_حالي() == ",")
                م.تقدم(1)
                متغير أقصى_نص = ""
                بينما (م.الموضع < م.الطول و م.اقرأ_حالي() != "}")
                    متغير ح_رقم2 = م.استهلك()
                    أقصى_نص = أقصى_نص + ح_رقم2
                نهاية
                إذا (طول(أقصى_نص) == 0)
                    أقصى_ك = -1
                وإلا
                    أقصى_ك = م.حول_إلى_رقم(أقصى_نص)
                نهاية
            وإلا
                أقصى_ك = أدنى_ك
            نهاية

            م.توقع("}")
        نهاية

        إذا (م.الموضع < م.الطول و م.اقرأ_حالي() == "?")
            م.تقدم(1)
            جشع_ك = 0
        نهاية

        ارجع جديد عقدة_كمية(ذرة، أدنى_ك، أقصى_ك، جشع_ك)
    نهاية

    دالة رقم حول_إلى_رقم(نص نص_رقمي)
        متغير نتيجة = 0
        متغير ط = 0
        بينما (ط < طول(نص_رقمي))
            متغير رمز = رمز_حرف(نص_رقمي، ط)
            إذا (رمز < 48 أو رمز > 57)
                ارمي("خطأ في النمط: حرف غير رقمي في الكمية")
            نهاية
            نتيجة = نتيجة * 10 + (رمز - 48)
            ط = ط + 1
        نهاية
        ارجع نتيجة
    نهاية
نهاية
