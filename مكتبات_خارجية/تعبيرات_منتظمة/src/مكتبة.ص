## بناء نتيجة_مطابقة من حالة مطابقة
دالة بناء_نتيجة_م(نص ن، الحالة)
    متغير مجموعات_ح = الحالة.المجموعات
    متغير بداية_ن = مجموعات_ح[0][0]
    متغير نهاية_ن = مجموعات_ح[0][1]
    متغير طول_م = نهاية_ن - بداية_ن
    متغير نص_م = ""
    إذا (طول_م > 0)
        نص_م = استخراج(ن، بداية_ن، طول_م)
    نهاية
    متغير مجموعات = []
    متغير ك = 1
    بينما (ك < طول(مجموعات_ح))
        متغير نص_ك = الحالة.نص_مجموعة(ك)
        أضف(مجموعات، نص_ك)
        ك = ك + 1
    نهاية
    متغير نت = جديد نتيجة_مطابقة(نص_م، بداية_ن، نهاية_ن، مجموعات)
    ## احسب خريطة الأسماء ونقلها إلى نتيجة_مطابقة
    الحالة.أعد_حساب_أسماء(ن)
    متغير أسماء_ق = الحالة.الأسماء
    متغير مفاتيح_ن = أسماء_ق.مفاتيح()
    متغير ك_أ = 0
    بينما (ك_أ < طول(مفاتيح_ن))
        متغير مفتاح_ن = مفاتيح_ن[ك_أ]
        نت.المجموعات_المسماة[مفتاح_ن] = أسماء_ق[مفتاح_ن]
        ك_أ = ك_أ + 1
    نهاية
    ارجع نت
نهاية

## حل مراجع المجموعات في نص البديل (\1 \2 ...)
دالة نص حل_مرجع_م(نص البديل، نتيجة_م)
    متغير نتيجة_نص = ""
    متغير ك = 0
    متغير طول_ب = طول(البديل)

    بينما (ك < طول_ب)
        متغير ح = استخراج(البديل، ك، 1)
        إذا (ح == "\\" و ك + 1 < طول_ب)
            متغير ح_ت = استخراج(البديل، ك + 1، 1)
            متغير رمز_ت = رمز_حرف(ح_ت، 0)
            إذا (رمز_ت >= 49 و رمز_ت <= 57)
                متغير رقم_م = رمز_ت - 48
                متغير نص_مجموعة_م = نتيجة_م.مجموعة(رقم_م)
                نتيجة_نص = نتيجة_نص + نص_مجموعة_م
                ك = ك + 2
            وإلا
                نتيجة_نص = نتيجة_نص + ح_ت
                ك = ك + 2
            نهاية
        وإلا
            نتيجة_نص = نتيجة_نص + ح
            ك = ك + 1
        نهاية
    نهاية

    ارجع نتيجة_نص
نهاية


