##
## ملف: عقد.ص
## الوصف: أنواع عقد شجرة تحليل التعبيرات المنتظمة (AST)
##         AST Node types for Regular Expression parse tree
##
## هذا الملف يعرّف بنية شجرة التحليل التي ينشئها المحلل (محلل.ص)
## ويستخدمها المحرك (محرك.ص) للمطابقة.
##

# =============================================================================
#             ثوابت أنواع العقد / AST Node Type Constants
# =============================================================================

## أنواع عقد الشجرة
صدّر صنف ن_نوع
    ## حرف حرفي عادي مثل 'أ' أو 'a'
    ساكن رقم حرفي = 1

    ## نقطة — تطابق أي حرف ما عدا السطر الجديد
    ساكن رقم نقطة = 2

    ## فئة حروف مثل [أبت] أو [a-z] أو [^0-9]
    ساكن رقم فئة = 3

    ## تسلسل: مطابقة أ ثم ب ثم ت
    ساكن رقم تسلسل = 4

    ## تناوب: مطابقة أ أو ب
    ساكن رقم تناوب = 5

    ## مجموعة: (...) مع أو بدون التقاط
    ساكن رقم مجموعة = 6

    ## كمية: * + ? {n} {n,m}
    ساكن رقم كمية = 7

    ## مرساة بداية السطر ^
    ساكن رقم مرساة_بداية = 8

    ## مرساة نهاية السطر $
    ساكن رقم مرساة_نهاية = 9

    ## فئة خاصة: \d \D \w \W \s \S \b \B
    ساكن رقم فئة_خاصة = 10

    ## مرجع خلفي: \1 \2 ...
    ساكن رقم مرجع_خلفي = 11

    ## مرجع خلفي مُسمى: \k<اسم> أو (?P=اسم)
    ساكن رقم مرجع_مسمى = 12
نهاية


# =============================================================================
#                     العقدة الأساسية / Base Node
# =============================================================================

## العقدة الأساسية لجميع عقد شجرة التحليل
صدّر صنف عقدة
    ## نوع العقدة (من ثوابت ن_نوع)
    رقم النوع

    باني(رقم نوع)
        هذا.النوع = نوع
    نهاية
نهاية


# =============================================================================
#                    عقد الأنواع المختلفة / Node Types
# =============================================================================

## عقدة حرف حرفي: تطابق حرفاً واحداً بالضبط
صدّر صنف عقدة_حرف يرث عقدة
    ## الحرف المراد مطابقته (نص بطول واحد)
    نص الحرف

    باني(نص ح)
        أساس(1)
        هذا.الحرف = ح
    نهاية
نهاية


## عقدة "أي حرف": النقطة . تطابق أي حرف ما عدا السطر الجديد
صدّر صنف عقدة_أي يرث عقدة
    ## هل تطابق السطر الجديد أيضاً؟ (وضع dotall)
    رقم يشمل_سطر_جديد

    باني(رقم شمل_سطر)
        أساس(2)
        هذا.يشمل_سطر_جديد = شمل_سطر
    نهاية
نهاية


## عقدة فئة الحروف: [abc] أو [a-z] أو [^...]
صدّر صنف عقدة_فئة يرث عقدة
    ## قائمة عناصر الفئة، كل عنصر مصفوفة [نوع, قيمة_أو_نطاق]
    ## نوع 1 = حرف واحد [ "ح", "أ" ]
    ## نوع 2 = نطاق  [ "ن", "a", "z" ]
    ## نوع 3 = فئة خاصة [ "خ", "d" ]
    مصفوفة العناصر

    ## 1 للفئة السلبية [^...], 0 للعادية
    رقم سلبي

    باني()
        أساس(3)
        هذا.العناصر = []
        هذا.سلبي = 0
    نهاية
نهاية


## عقدة التسلسل: مطابقة سلسلة من الأنماط المتتالية
صدّر صنف عقدة_تسلسل يرث عقدة
    ## قائمة الأبناء بالترتيب
    مصفوفة الأبناء

    باني()
        أساس(4)
        هذا.الأبناء = []
    نهاية
نهاية


## عقدة التناوب: مطابقة أحد الأنماط البديلة (a|b|c)
صدّر صنف عقدة_تناوب يرث عقدة
    ## قائمة الخيارات
    مصفوفة الخيارات

    باني()
        أساس(5)
        هذا.الخيارات = []
    نهاية
نهاية


## عقدة المجموعة: تجميع النمط (...)
صدّر صنف عقدة_مجموعة يرث عقدة
    ## رقم المجموعة (1 للأولى، 0 إذا غير التقاطية)
    رقم رقم_م

    ## اسم المجموعة المسماة (?<اسم>...) أو "" إذا بلا اسم
    نص اسم_م

    ## النمط الفرعي داخل المجموعة
    متغير طفل

    ## 1 = يلتقط, 0 = لا يلتقط (?:...)
    رقم التزام

    باني(رقم رقم_ب، طفل_م، نص اسم، رقم يلتزم)
        أساس(6)
        هذا.رقم_م = رقم_ب
        هذا.طفل = طفل_م
        هذا.اسم_م = اسم
        هذا.التزام = يلتزم
    نهاية
نهاية


## عقدة الكمية: التحكم في عدد مرات التكرار
صدّر صنف عقدة_كمية يرث عقدة
    ## النمط الفرعي الذي يُكرَّر
    متغير طفل

    ## الحد الأدنى لعدد التكرارات (>= 0)
    رقم أدنى

    ## الحد الأقصى (-1 يعني لا نهاية)
    رقم أقصى

    ## 1 = جشع (greedy, الافتراضي), 0 = كسول (lazy, +? *? ??)
    رقم جشع

    باني(طفل_ك, رقم أدنى_ك، رقم أقصى_ك، رقم جشع_ك)
        أساس(7)
        هذا.طفل = طفل_ك
        هذا.أدنى = أدنى_ك
        هذا.أقصى = أقصى_ك
        هذا.جشع = جشع_ك
    نهاية
نهاية


## عقدة المرساة: ^ للبداية أو $ للنهاية
صدّر صنف عقدة_مرساة يرث عقدة
    ## 8 = بداية السطر, 9 = نهاية السطر
    رقم نوع_م

    باني(رقم ن)
        أساس(ن)
        هذا.نوع_م = ن
    نهاية
نهاية


## عقدة الفئة الخاصة: \d \D \w \W \s \S \b \B
صدّر صنف عقدة_فئة_خاصة يرث عقدة
    ## الحرف المميز بعد الشرطة المائلة: "d" "D" "w" "W" "s" "S" "b" "B"
    نص هوية

    باني(نص ن)
        أساس(10)
        هذا.هوية = ن
    نهاية
نهاية


## عقدة المرجع الخلفي: \1 \2 ... يرجع إلى مجموعة ملتقطة
صدّر صنف عقدة_مرجع يرث عقدة
    ## رقم المجموعة المُرجَع إليها (1-مبني)
    رقم رقم_المجموعة

    باني(رقم رقم_ب)
        أساس(11)
        هذا.رقم_المجموعة = رقم_ب
    نهاية
نهاية


## عقدة المرجع الخلفي المُسمى: \k<اسم> أو (?P=اسم)
صدّر صنف عقدة_مرجع_مسمى يرث عقدة
    ## اسم المجموعة المُرجَع إليها
    نص اسم_المجموعة

    باني(نص اسم_ب)
        أساس(12)
        هذا.اسم_المجموعة = اسم_ب
    نهاية
