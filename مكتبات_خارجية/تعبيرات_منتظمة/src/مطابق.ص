## ملف: مطابق.ص — محرك مطابقة التعبيرات المنتظمة
## لا يستورد من عقد — يصل لحقول العقد مباشرةً دون استيراد (تجنباً لتعارض الاستيراد)

## حالة_مطابقة: تحفظ النص والمجموعات الملتقطة
صدّر صنف حالة_مطابقة
    نص النص
    رقم الطول
    رقم عدد_المجموعات
    مصفوفة المجموعات
    خريطة الأسماء
    رقم الأعلام
    ## خريطة: رقم المجموعة → اسمها (للإيجاد العكسي عند استعادة المجموعات)
    خريطة أرقام_الأسماء

    باني(نص ن، رقم عدد_م، رقم أعلام)
        هذا.النص = ن
        هذا.الطول = طول(ن)
        هذا.عدد_المجموعات = عدد_م
        هذا.الأعلام = أعلام
        هذا.المجموعات = []
        هذا.الأسماء = {}
        هذا.أرقام_الأسماء = {}
        متغير ك = 0
        بينما (ك <= عدد_م)
            أضف(هذا.المجموعات، [-1، -1])
            ك = ك + 1
        نهاية
    نهاية

    دالة مصفوفة احفظ_مجموعات()
        متغير نسخة = []
        متغير ك = 0
        بينما (ك < طول(هذا.المجموعات))
            أضف(نسخة، [هذا.المجموعات[ك][0]، هذا.المجموعات[ك][1]])
            ك = ك + 1
        نهاية
        ارجع نسخة
    نهاية

    دالة استعد_مجموعات(مصفوفة نسخة)
        متغير ك = 0
        بينما (ك < طول(نسخة))
            هذا.المجموعات[ك] = نسخة[ك]
            ك = ك + 1
        نهاية
    نهاية

    ## سجّل اسم مجموعة (يُربط رقم المجموعة باسمها)
    دالة سجّل_اسم(رقم رقم_ك، نص الاسم)
        هذا.أرقام_الأسماء[رقم_ك] = الاسم
    نهاية

    ## احتسب خريطة الأسماء من المجموعات الحالية
    دالة أعد_حساب_أسماء(النص_م)
        هذا.الأسماء = {}
        ## كل مجموعة مسماة مسجّلة في أرقام_الأسماء، نحسب قيمتها من بياناتها
        متغير ك_أ = 1
        بينما (ك_أ < طول(هذا.المجموعات))
            إذا (يحتوي_على(هذا.أرقام_الأسماء، ك_أ))
                متغير اسم_أ = هذا.أرقام_الأسماء[ك_أ]
                متغير بداية_أ = هذا.المجموعات[ك_أ][0]
                متغير نهاية_أ = هذا.المجموعات[ك_أ][1]
                إذا (بداية_أ >= 0 و نهاية_أ >= بداية_أ)
                    متغير طول_أ = نهاية_أ - بداية_أ
                    متغير نص_أ = ""
                    إذا (طول_أ > 0)
                        نص_أ = استخراج(النص_م، بداية_أ، طول_أ)
                    نهاية
                    هذا.الأسماء[اسم_أ] = نص_أ
                نهاية
            نهاية
            ك_أ = ك_أ + 1
        نهاية
    نهاية

    دالة نص نص_مجموعة(رقم ك)
        إذا (ك < 0 أو ك >= طول(هذا.المجموعات))
            ارجع ""
        نهاية
        متغير بداية = هذا.المجموعات[ك][0]
        متغير نهاية_ك = هذا.المجموعات[ك][1]
        إذا (بداية < 0 أو نهاية_ك < 0)
            ارجع ""
        نهاية
        ارجع استخراج(هذا.النص، بداية، نهاية_ك - بداية)
    نهاية
نهاية


## === دوال مساعدة على مستوى الوحدة — تتجنب مشكلة تلوث الكائن المُجدوَل ===
## هذه الدوال تستقبل محرك_م صراحةً كمعامل أول

دالة رقم م_يطابق_خاصة(نص نوع_خ، نص ح)
    متغير رمز_ح = رمز_حرف(ح، 0)
    متغير هو_رقم = 0
    متغير هو_حرف = 0
    متغير هو_مسافة = 0

    إذا (رمز_ح >= 48 و رمز_ح <= 57)
        هو_رقم = 1
    نهاية
    إذا ((رمز_ح >= 65 و رمز_ح <= 90) أو (رمز_ح >= 97 و رمز_ح <= 122) أو هو_رقم == 1 أو رمز_ح == 95)
        هو_حرف = 1
    نهاية
    ## العربية بشكل افتراضي ضمن \w (أول بايت UTF-8: 0xD8-0xDB = 216-219)
    إذا (رمز_ح >= 216 و رمز_ح <= 219)
        هو_حرف = 1
    نهاية
    إذا (ح == " " أو ح == "\t" أو ح == "\n" أو ح == "\r")
        هو_مسافة = 1
    نهاية

    إذا (نوع_خ == "d")
        ارجع هو_رقم
    نهاية
    إذا (نوع_خ == "D")
        ارجع 1 - هو_رقم
    نهاية
    إذا (نوع_خ == "w")
        ارجع هو_حرف
    نهاية
    إذا (نوع_خ == "W")
        ارجع 1 - هو_حرف
    نهاية
    إذا (نوع_خ == "s")
        ارجع هو_مسافة
    نهاية
    إذا (نوع_خ == "S")
        ارجع 1 - هو_مسافة
    نهاية
    ارجع 0
نهاية

دالة رقم م_طابق_فئة(شجرة، نص نص_م، رقم موضع، رقم أعلام)
    إذا (موضع >= طول(نص_م))
        ارجع -1
    نهاية
    متغير ح = استخراج(نص_م، موضع، 1)
    ## تطبيق طي الحالة إن أُعلم عدم الحساسية
    متغير ح_م = ح
    إذا (أعلام % 2 == 1)
        ح_م = أحرف_صغيرة(ح)
    نهاية
    متغير عناصر = شجرة.العناصر
    متغير سلبي = شجرة.سلبي
    متغير متطابق = 0
    متغير ي = 0

    بينما (ي < طول(عناصر) و متطابق == 0)
        متغير عنصر = عناصر[ي]
        متغير نوع_ع = عنصر[0]
        إذا (نوع_ع == "ح")
            إذا (أعلام % 2 == 1)
                إذا (أحرف_صغيرة(عنصر[1]) == ح_م)
                    متطابق = 1
                نهاية
            وإلا
                إذا (عنصر[1] == ح)
                    متطابق = 1
                نهاية
            نهاية
        نهاية
        إذا (نوع_ع == "ن")
            إذا (أعلام % 2 == 1)
                متغير ر_بداية_ص = رمز_حرف(أحرف_صغيرة(عنصر[1])، 0)
                متغير ر_نهاية_ص = رمز_حرف(أحرف_صغيرة(عنصر[2])، 0)
                إذا (رمز_حرف(ح_م، 0) >= ر_بداية_ص و رمز_حرف(ح_م، 0) <= ر_نهاية_ص)
                    متطابق = 1
                نهاية
            وإلا
                متغير ر_بداية = رمز_حرف(عنصر[1]، 0)
                متغير ر_نهاية = رمز_حرف(عنصر[2]، 0)
                متغير ر_ح = رمز_حرف(ح، 0)
                إذا (ر_ح >= ر_بداية و ر_ح <= ر_نهاية)
                    متطابق = 1
                نهاية
            نهاية
        نهاية
        إذا (نوع_ع == "خ")
            إذا (م_يطابق_خاصة(عنصر[1]، ح) == 1)
                متطابق = 1
            نهاية
        نهاية
        ي = ي + 1
    نهاية

    إذا (سلبي == 1 و متطابق == 0)
        ارجع موضع + 1
    نهاية
    إذا (سلبي == 0 و متطابق == 1)
        ارجع موضع + 1
    نهاية
    ارجع -1
نهاية

دالة رقم م_طابق_فئة_خاصة(شجرة، نص نص_م، رقم موضع)
    إذا (موضع >= طول(نص_م))
        ارجع -1
    نهاية
    متغير ح = استخراج(نص_م، موضع، 1)
    إذا (م_يطابق_خاصة(شجرة.هوية، ح) == 1)
        ارجع موضع + 1
    نهاية
    ارجع -1
نهاية

دالة رقم م_طابق_مرجع(شجرة، نص نص_م، رقم موضع، الحالة)
    متغير رقم_ك = شجرة.رقم_المجموعة
    متغير نص_المجموعة = الحالة.نص_مجموعة(رقم_ك)
    إذا (نص_المجموعة == "")
        ارجع -1
    نهاية
    متغير طول_مجموعة = طول(نص_المجموعة)
    إذا (موضع + طول_مجموعة > طول(نص_م))
        ارجع -1
    نهاية
    متغير منقطع = استخراج(نص_م، موضع، طول_مجموعة)
    إذا ((الحالة.الأعلام % 2) == 1)
        إذا (أحرف_صغيرة(منقطع) == أحرف_صغيرة(نص_المجموعة))
            ارجع موضع + طول_مجموعة
        نهاية
    وإلا
        إذا (منقطع == نص_المجموعة)
            ارجع موضع + طول_مجموعة
        نهاية
    نهاية
    ارجع -1
نهاية

## مطابقة مرجع خلفي مُسمى \k<اسم> أو (?P=اسم)
دالة رقم م_طابق_مرجع_مسمى(شجرة، نص نص_م، رقم موضع، الحالة)
    متغير اسم_ك = شجرة.اسم_المجموعة
    ## احسب خريطة الأسماء من المجموعات الحالية
    الحالة.أعد_حساب_أسماء(نص_م)
    ## ابحث عن الاسم في خريطة الأسماء
    إذا (ليس يحتوي_على(الحالة.الأسماء، اسم_ك))
        ارجع -1
    نهاية
    متغير نص_المجموعة_م = الحالة.الأسماء[اسم_ك]
    إذا (نص_المجموعة_م == "")
        ارجع -1
    نهاية
    متغير طول_مجموعة_م = طول(نص_المجموعة_م)
    إذا (موضع + طول_مجموعة_م > طول(نص_م))
        ارجع -1
    نهاية
    متغير منقطع_م = استخراج(نص_م، موضع، طول_مجموعة_م)
    إذا ((الحالة.الأعلام % 2) == 1)
        إذا (أحرف_صغيرة(منقطع_م) == أحرف_صغيرة(نص_المجموعة_م))
            ارجع موضع + طول_مجموعة_م
        نهاية
    وإلا
        إذا (منقطع_م == نص_المجموعة_م)
            ارجع موضع + طول_مجموعة_م
        نهاية
    نهاية
    ارجع -1
نهاية

## الدالة الرئيسية للمطابقة (خارج الصنف — تتحاشى تلوث م)
دالة رقم م_طابق_عقدة(مح، شجرة، نص نص_م، رقم موضع، الحالة)
    متغير النوع = شجرة.النوع

    إذا (النوع == 1)
        إذا (موضع >= طول(نص_م))
            ارجع -1
        نهاية
        متغير ح1 = استخراج(نص_م، موضع، 1)
        إذا (الحالة.الأعلام % 2 == 1)
            إذا (أحرف_صغيرة(ح1) == أحرف_صغيرة(شجرة.الحرف))
                ارجع موضع + 1
            نهاية
        وإلا
            إذا (ح1 == شجرة.الحرف)
                ارجع موضع + 1
            نهاية
        نهاية
        ارجع -1
    نهاية

    إذا (النوع == 2)
        إذا (موضع >= طول(نص_م))
            ارجع -1
        نهاية
        متغير ح2 = استخراج(نص_م، موضع، 1)
        إذا (ح2 == "\n" و شجرة.يشمل_سطر_جديد == 0)
            ارجع -1
        نهاية
        ارجع موضع + 1
    نهاية

    إذا (النوع == 3)
        ارجع م_طابق_فئة(شجرة، نص_م، موضع، الحالة.الأعلام)
    نهاية

    إذا (النوع == 4)
        ارجع م_طابق_تسلسل(مح، شجرة، نص_م، موضع، الحالة)
    نهاية

    إذا (النوع == 5)
        ارجع م_طابق_تناوب(مح، شجرة، نص_م، موضع، الحالة)
    نهاية

    إذا (النوع == 6)
        ارجع م_طابق_مجموعة(مح، شجرة، نص_م، موضع، الحالة)
    نهاية

    إذا (النوع == 7)
        ارجع م_طابق_كمية(مح، شجرة، نص_م، موضع، الحالة)
    نهاية

    إذا (النوع == 8)
        إذا (موضع == 0)
            ارجع موضع
        نهاية
        ارجع -1
    نهاية

    إذا (النوع == 9)
        إذا (موضع == طول(نص_م))
            ارجع موضع
        نهاية
        ارجع -1
    نهاية

    إذا (النوع == 10)
        متغير هوية_10 = شجرة.هوية
        إذا (هوية_10 == "b" أو هوية_10 == "B")
            ارجع م_طابق_حد_كلمة(شجرة، نص_م، موضع، الحالة)
        نهاية
        ارجع م_طابق_فئة_خاصة(شجرة، نص_م، موضع)
    نهاية

    إذا (النوع == 11)
        ارجع م_طابق_مرجع(شجرة، نص_م، موضع، الحالة)
    نهاية

    إذا (النوع == 12)
        ارجع م_طابق_مرجع_مسمى(شجرة، نص_م، موضع، الحالة)
    نهاية

    ارجع -1
نهاية

## جمع كل المواضع الممكنة لعقدة كمية (مع حفظ المجموعات لكل موضع)
## ترجع مصفوفة من أزواج [موضع, نسخة_مجموعات] مرتبة حسب نوع الكمية
دالة مصفوفة م_كل_مواضع_كمية(مح، شجرة_ك، نص نص_م، رقم موضع، الحالة)
    متغير طفل_ك = شجرة_ك.طفل
    متغير أدنى_ك = شجرة_ك.أدنى
    متغير أقصى_ك = شجرة_ك.أقصى
    متغير جشع_ك = شجرة_ك.جشع

    ## اجمع كل المواضع الممكنة (من الأدنى إلى الأقصى)
    متغير مواضع_ك = [[موضع، الحالة.احفظ_مجموعات()]]
    متغير موضع_ح = موضع
    متغير عدد_ك = 0
    متغير استمر_ك2 = 1

    بينما (استمر_ك2 == 1)
        إذا (أقصى_ك >= 0 و عدد_ك >= أقصى_ك)
            استمر_ك2 = 0
        وإلا
            متغير نسخة_ك2 = الحالة.احفظ_مجموعات()
            متغير نتيجة_ك2 = م_طابق_عقدة(مح، طفل_ك، نص_م، موضع_ح، الحالة)
            إذا (نتيجة_ك2 < 0 أو نتيجة_ك2 == موضع_ح)
                الحالة.استعد_مجموعات(نسخة_ك2)
                استمر_ك2 = 0
            وإلا
                موضع_ح = نتيجة_ك2
                عدد_ك = عدد_ك + 1
                أضف(مواضع_ك، [موضع_ح، الحالة.احفظ_مجموعات()])
            نهاية
        نهاية
    نهاية

    ## تحقق من الحد الأدنى
    إذا (عدد_ك < أدنى_ك)
        ارجع []
    نهاية

    ## رتّب: جشع = من الأكثر إلى الأقل (عكس الترتيب)، كسول = من الأقل إلى الأكثر
    متغير نتائج_ك = []
    إذا (جشع_ك == 1)
        ## جشع: ابدأ من الأقصى (آخر عنصر) نزولاً إلى الأدنى
        متغير ك_ع = طول(مواضع_ك) - 1
        بينما (ك_ع >= أدنى_ك)
            أضف(نتائج_ك، مواضع_ك[ك_ع])
            ك_ع = ك_ع - 1
        نهاية
    وإلا
        ## كسول: ابدأ من الأدنى صعوداً
        متغير ك_ل = أدنى_ك
        بينما (ك_ل < طول(مواضع_ك))
            أضف(نتائج_ك، مواضع_ك[ك_ل])
            ك_ل = ك_ل + 1
        نهاية
    نهاية

    ارجع نتائج_ك
نهاية

## التحقق هل حرف يعتبر "حرف كلمة" (يُستخدم في \b)
## الأعلام: بت 8 = وضع يونيكود (يشمل الحروف العربية)
دالة رقم م_هو_حرف_كلمة(نص ح، رقم أعلام)
    متغير رمز_ح = رمز_حرف(ح، 0)
    ## ASCII \w = [a-zA-Z0-9_]
    إذا ((رمز_ح >= 65 و رمز_ح <= 90) أو (رمز_ح >= 97 و رمز_ح <= 122))
        ارجع 1
    نهاية
    إذا (رمز_ح >= 48 و رمز_ح <= 57)
        ارجع 1
    نهاية
    إذا (رمز_ح == 95)
        ارجع 1
    نهاية
    ## العربية بشكل افتراضي ضمن \w (أول بايت UTF-8: 0xD8-0xDB = 216-219)
    إذا (رمز_ح >= 216 و رمز_ح <= 219)
        ارجع 1
    نهاية
    ارجع 0
نهاية

## مطابقة حد الكلمة \b أو \B (تأكيد بعرض صفري)
دالة رقم م_طابق_حد_كلمة(شجرة، نص نص_م، رقم موضع، الحالة)
    متغير أعلام_ح = الحالة.الأعلام
    متغير طول_ن_ح = طول(نص_م)
    متغير سابق_كلمة = 0
    إذا (موضع > 0)
        متغير ح_سابق = استخراج(نص_م، موضع - 1، 1)
        سابق_كلمة = م_هو_حرف_كلمة(ح_سابق، أعلام_ح)
    نهاية
    متغير لاحق_كلمة = 0
    إذا (موضع < طول_ن_ح)
        متغير ح_لاحق = استخراج(نص_م، موضع، 1)
        لاحق_كلمة = م_هو_حرف_كلمة(ح_لاحق، أعلام_ح)
    نهاية
    متغير على_حد = 0
    إذا (سابق_كلمة != لاحق_كلمة)
        على_حد = 1
    نهاية
    إذا (شجرة.هوية == "b")
        إذا (على_حد == 1)
            ارجع موضع
        نهاية
        ارجع -1
    نهاية
    ## \B: عكس \b
    إذا (على_حد == 0)
        ارجع موضع
    نهاية
    ارجع -1
نهاية

## جمع جميع المواضع الممكنة لأي نوع عقدة (backtracking عام)
دالة مصفوفة م_كل_مواضع_عقدة(مح، شجرة، نص نص_م، رقم موضع، الحالة)
    متغير النوع_ع = شجرة.النوع

    ## كمية: دالة متخصصة
    إذا (النوع_ع == 7)
        ارجع م_كل_مواضع_كمية(مح، شجرة، نص_م، موضع، الحالة)
    نهاية

    ## مجموعة: تستخدم مسار الاحتياط (م_طابق_مجموعة يسجل الالتقاط)
    ## ملاحظة: مجموعة تنتج موضعاً واحداً فقط (لا backtracking داخلي بسبب التقاط)
    ## إذا احتجنا backtracking داخل المجموعة سنعالجها لاحقاً

    ## تناوب: جمع مواضع جميع الفروع بالترتيب
    إذا (النوع_ع == 5)
        متغير خيارات_ت5 = شجرة.الخيارات
        متغير نتائج_ت5 = []
        متغير نسخة_ق5 = الحالة.احفظ_مجموعات()
        متغير ي_ت5 = 0
        بينما (ي_ت5 < طول(خيارات_ت5))
            الحالة.استعد_مجموعات(نسخة_ق5)
            متغير مواضع_ف5 = م_كل_مواضع_عقدة(مح، خيارات_ت5[ي_ت5]، نص_م، موضع، الحالة)
            متغير ك_ف5 = 0
            بينما (ك_ف5 < طول(مواضع_ف5))
                أضف(نتائج_ت5، مواضع_ف5[ك_ف5])
                ك_ف5 = ك_ف5 + 1
            نهاية
            ي_ت5 = ي_ت5 + 1
        نهاية
        الحالة.استعد_مجموعات(نسخة_ق5)
        ارجع نتائج_ت5
    نهاية

    ## للأنواع الأخرى: موضع واحد فقط
    متغير نسخة_ع2 = الحالة.احفظ_مجموعات()
