## مطابقة تسلسل مع إمكانية التراجع الكامل (backtracking عام لجميع أنواع العقد)
## ابتداء: فهرس الطفل الحالي، موضع: الموضع الحالي في النص
دالة رقم م_طابق_تتابع_من(مح، أبناء، رقم ابتداء، نص نص_م، رقم موضع، الحالة)
    ## حالة الأساس: أنهينا جميع العناصر بنجاح
    إذا (ابتداء >= طول(أبناء))
        ارجع موضع
    نهاية

    متغير طفل_ص = أبناء[ابتداء]

    ## اجمع جميع المواضع الممكنة لهذا الطفل (backtracking عام)
    متغير نسخة_قبل_ت = الحالة.احفظ_مجموعات()
    متغير مرشحات_ت = م_كل_مواضع_عقدة(مح، طفل_ص، نص_م، موضع، الحالة)
    الحالة.استعد_مجموعات(نسخة_قبل_ت)

    إذا (طول(مرشحات_ت) == 0)
        ارجع -1
    نهاية

    متغير ك_ت = 0
    بينما (ك_ت < طول(مرشحات_ت))
        متغير مرشح_ت = مرشحات_ت[ك_ت]
        متغير موضع_ت = مرشح_ت[0]
        متغير نسخة_ت = مرشح_ت[1]
        الحالة.استعد_مجموعات(نسخة_ت)
        متغير ناتج_ت = م_طابق_تتابع_من(مح، أبناء، ابتداء + 1، نص_م، موضع_ت، الحالة)
        إذا (ناتج_ت >= 0)
            ارجع ناتج_ت
        نهاية
        ك_ت = ك_ت + 1
    نهاية

    الحالة.استعد_مجموعات(نسخة_قبل_ت)
    ارجع -1
نهاية

دالة رقم م_طابق_تسلسل(مح، شجرة، نص نص_م، رقم موضع، الحالة)
    متغير أبناء = شجرة.الأبناء
    ارجع م_طابق_تتابع_من(مح، أبناء، 0، نص_م، موضع، الحالة)
نهاية

دالة رقم م_طابق_تناوب(مح، شجرة، نص نص_م، رقم موضع، الحالة)
    متغير خيارات = شجرة.الخيارات
    متغير ي = 0
    متغير نتيجة_ت = -1

    بينما (ي < طول(خيارات) و نتيجة_ت < 0)
        متغير نسخة_م = الحالة.احفظ_مجموعات()
        متغير نتيجة_فرع = م_طابق_عقدة(مح، خيارات[ي]، نص_م، موضع، الحالة)
        إذا (نتيجة_فرع >= 0)
            نتيجة_ت = نتيجة_فرع
        وإلا
            الحالة.استعد_مجموعات(نسخة_م)
            ي = ي + 1
        نهاية
    نهاية

    ارجع نتيجة_ت
نهاية

دالة رقم م_طابق_مجموعة(مح، شجرة، نص نص_م، رقم موضع، الحالة)
    متغير رقم_ك = شجرة.رقم_م
    متغير نتيجة_ج = م_طابق_عقدة(مح، شجرة.طفل، نص_م، موضع، الحالة)
    إذا (نتيجة_ج >= 0 و رقم_ك > 0 و شجرة.التزام == 1)
        الحالة.المجموعات[رقم_ك] = [موضع، نتيجة_ج]
        ## إذا كانت المجموعة مسماة، سجّل الرابط رقم→اسم
        إذا (شجرة.اسم_م != "")
            الحالة.سجّل_اسم(رقم_ك، شجرة.اسم_م)
        نهاية
    نهاية
    ارجع نتيجة_ج
نهاية

دالة رقم م_طابق_كمية(مح، شجرة، نص نص_م، رقم موضع، الحالة)
    متغير طفل = شجرة.طفل
    متغير أدنى = شجرة.أدنى
    متغير أقصى = شجرة.أقصى
    متغير جشع = شجرة.جشع

    متغير مواضع = [موضع]
    متغير موضع_ح = موضع
    متغير عدد = 0
    متغير استمر_ك = 1

    بينما (استمر_ك == 1)
        إذا (أقصى >= 0 و عدد >= أقصى)
            استمر_ك = 0
        وإلا
            متغير نسخة_ك = الحالة.احفظ_مجموعات()
            متغير نتيجة_ك = م_طابق_عقدة(مح، طفل، نص_م، موضع_ح، الحالة)
            إذا (نتيجة_ك < 0 أو نتيجة_ك == موضع_ح)
                الحالة.استعد_مجموعات(نسخة_ك)
                استمر_ك = 0
            وإلا
                موضع_ح = نتيجة_ك
                أضف(مواضع، موضع_ح)
                عدد = عدد + 1
            نهاية
        نهاية
    نهاية

    إذا (عدد < أدنى)
        ارجع -1
    نهاية

    إذا (جشع == 1)
        ارجع مواضع[طول(مواضع) - 1]
    نهاية

    ارجع مواضع[أدنى]
نهاية


## دالة مساعدة: ابحث عن أول تطابق (مستوى الوحدة — لا تفسد هذا)
دالة م_ابحث_من(شجرة_م، رقم عدد_مج_م، رقم أعلام_م، نص نص_م، رقم بداية_م)
    متغير طول_ن = طول(نص_م)
    متغير موضع = بداية_م
    متغير وجد = 0
    متغير حالة_ن = لاشيء

    بينما (موضع <= طول_ن و وجد == 0)
        متغير الحالة = جديد حالة_مطابقة(نص_م، عدد_مج_م، أعلام_م)
        متغير نهاية_م = م_طابق_عقدة(شجرة_م، شجرة_م، نص_م، موضع، الحالة)
        إذا (نهاية_م >= 0)
            الحالة.المجموعات[0] = [موضع، نهاية_م]
            حالة_ن = الحالة
            وجد = 1
        وإلا
            موضع = موضع + 1
        نهاية
    نهاية

    ارجع حالة_ن
نهاية

## دالة مساعدة: ابحث عن جميع التطابقات (مستوى الوحدة — لا تفسد هذا)
دالة م_ابحث_الكل(شجرة_م، رقم عدد_مج_م، رقم أعلام_م، نص نص_م)
    متغير نتائج = []
    متغير طول_ن = طول(نص_م)
    متغير موضع = 0

    بينما (موضع <= طول_ن)
        متغير الحالة = جديد حالة_مطابقة(نص_م، عدد_مج_م، أعلام_م)
        متغير نهاية_م = م_طابق_عقدة(شجرة_م، شجرة_م، نص_م، موضع، الحالة)
        إذا (نهاية_م >= 0)
            الحالة.المجموعات[0] = [موضع، نهاية_م]
            أضف(نتائج، الحالة)
            إذا (نهاية_م > موضع)
                موضع = نهاية_م
            وإلا
                موضع = موضع + 1
            نهاية
        وإلا
            موضع = موضع + 1
        نهاية
    نهاية

    ارجع نتائج
نهاية


