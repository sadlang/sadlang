# اختبارات إطار الاختبار
# ═══════════════════════════════════════
# ملاحظة: دوال التأكيد (تأكد_يساوي...) تعدّل متغيرات الموديول الداخلية
# (_عدد_الاختبارات، _عدد_النجاح...) التي لا تعمل عبر حدود الاستيراد
# لذلك نختبر الدوال التي لا تعدّل حالة داخلية فقط + صنف طاقم_اختبار

من مكتبات_خارجية.اختبار.src.مكتبة استورد فاصل
من مكتبات_خارجية.اختبار.src.مكتبة استورد طاقم_اختبار

اطبع_سطر("╔══════════════════════════════════════╗")
اطبع_سطر("║ اختبارات إطار الاختبار              ║")
اطبع_سطر("╚══════════════════════════════════════╝")

متغير _نجح = 0
متغير _فشل = 0

دالة _تحقق(الوصف, الشرط)
   إذا (الشرط)
      _نجح = _نجح + 1
      اطبع_سطر("  ✓ " + الوصف)
   وإلا
      _فشل = _فشل + 1
      اطبع_سطر("  ✗ " + الوصف)
   نهاية
نهاية

# ═══ منطق التأكيد (اختبار ذاتي بدون مكتبة) ═══
اطبع_سطر("")
اطبع_سطر("── منطق التساوي ──")
_تحقق("5 == 5", 5 == 5)
_تحقق("5 != 10", 5 != 10)
_تحقق("'مرحبا' == 'مرحبا'", "مرحبا" == "مرحبا")

اطبع_سطر("")
اطبع_سطر("── منطق صحيح/خطأ ──")
_تحقق("صحيح == صحيح", صحيح == صحيح)
_تحقق("خطأ == خطأ", خطأ == خطأ)
_تحقق("صحيح != خطأ", صحيح != خطأ)

اطبع_سطر("")
اطبع_سطر("── منطق المقارنات ──")
_تحقق("10 > 5", 10 > 5)
_تحقق("3 < 8", 3 < 8)
_تحقق("5 >= 5", 5 >= 5)
_تحقق("5 <= 5", 5 <= 5)
_تحقق("7 >= 3", 7 >= 3)
_تحقق("2 <= 9", 2 <= 9)

اطبع_سطر("")
اطبع_سطر("── القيم الخاصة ──")
_تحقق("42 ليس لاشيء", 42 != لاشيء)
_تحقق("لاشيء == لاشيء", لاشيء == لاشيء)
_تحقق("'نص' ليس لاشيء", "نص" != لاشيء)

اطبع_سطر("")
اطبع_سطر("── القيم القريبة ──")
متغير فرق = 3.15 - 3.14
_تحقق("3.14 قريب من 3.15 بهامش 0.02", فرق < 0.02 و فرق > -0.02)
متغير فرق2 = 1.0 - 1.001
_تحقق("1.0 قريب من 1.001 بهامش 0.01", فرق2 < 0.01 و فرق2 > -0.01)

اطبع_سطر("")
اطبع_سطر("── النطاق ──")
_تحقق("5 في [1, 10]", 5 >= 1 و 5 <= 10)
_تحقق("0 ليس في [1, 10]", ليس (0 >= 1 و 0 <= 10))
_تحقق("10 في [1, 10]", 10 >= 1 و 10 <= 10)

اطبع_سطر("")
اطبع_سطر("── الاستثناءات ──")
متغير رُمي = خطأ
حاول
   ارمي "خطأ اختباري"
امسك (خ)
   رُمي = صحيح
نهاية
_تحقق("الاستثناء يُرمى ويُمسك", رُمي)

متغير بدون_خطأ = صحيح
حاول
   متغير س = 42
امسك (خ)
   بدون_خطأ = خطأ
نهاية
_تحقق("لا استثناء عند عملية عادية", بدون_خطأ)

# ═══ فاصل (دالة مكتبة) ═══
اطبع_سطر("")
اطبع_سطر("── الفاصل ──")

دالة _اختبار_فاصل()
   فاصل("قسم اختباري")
نهاية

متغير فاصل_نجح = صحيح
حاول
   _اختبار_فاصل()
امسك (خ)
   فاصل_نجح = خطأ
نهاية
_تحقق("فاصل() يعمل بدون خطأ", فاصل_نجح)

# ═══ طاقم اختبار ═══
اطبع_سطر("")
اطبع_سطر("── طاقم_اختبار ──")
متغير الطاقم = جديد طاقم_اختبار("طاقم تجريبي")
_تحقق("إنشاء طاقم اختبار", الطاقم != لاشيء)

# ═══ التقرير ═══
اطبع_سطر("")
اطبع_سطر("═══════════════════════════════")
اطبع_سطر("النتائج: " + _نجح + " نجح، " + _فشل + " فشل")
إذا (_فشل == 0)
   اطبع_سطر("✓ جميع الاختبارات ناجحة!")
وإلا
   اطبع_سطر("✗ بعض الاختبارات فشلت")
نهاية
اطبع_سطر("═══════════════════════════════")
