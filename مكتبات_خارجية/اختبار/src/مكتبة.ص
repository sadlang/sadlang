# مجموعة اختبارات ككائن (Test Suite)
# ═══════════════════════════════════════════════════════════

صنف طاقم_اختبار
   باني(الاسم)
      هذا.الاسم = الاسم
      هذا._الاختبارات = []
      هذا._نجح = 0
      هذا._فشل = 0
   نهاية

   ## إضافة اختبار (اسم + دالة)
   دالة أضف(اسم_الاختبار, دالة_اختبار)
      هذا._الاختبارات = هذا._الاختبارات + [[اسم_الاختبار, دالة_اختبار]]
   نهاية

   ## تشغيل جميع الاختبارات
   دالة شغّل()
      اطبع_سطر("")
      اطبع_سطر("╔══════════════════════════════════════╗")
      اطبع_سطر("║ طاقم: " + هذا.الاسم)
      اطبع_سطر("╚══════════════════════════════════════╝")
      
      لكل اختبار في هذا._الاختبارات
         متغير الاسم = اختبار[0]
         متغير الدالة = اختبار[1]
         حاول
            الدالة()
            هذا._نجح = هذا._نجح + 1
            اطبع_سطر("  ✓ " + الاسم)
         امسك (خطأ)
            هذا._فشل = هذا._فشل + 1
            اطبع_سطر("  ✗ " + الاسم + " — خطأ: " + خطأ)
         نهاية
      نهاية
      
      هذا._اطبع_ملخص()
   نهاية

   دالة _اطبع_ملخص()
      متغير المجموع = هذا._نجح + هذا._فشل
      اطبع_سطر("")
      اطبع_سطر("  الملخص: " + هذا._نجح + "/" + المجموع + " نجح")
      إذا (هذا._فشل == 0)
         اطبع_سطر("  ✓ جميع الاختبارات ناجحة!")
      وإلا
         اطبع_سطر("  ✗ " + هذا._فشل + " اختبار فشل")
      نهاية
   نهاية

   دالة كل_الاختبارات_ناجحة()
      ارجع هذا._فشل == 0
   نهاية
نهاية

