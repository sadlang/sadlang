نهاية

## التأكيد: تساوي
دالة تأكد_يساوي(الفعلي, المتوقع, الوصف)
   _عدد_الاختبارات = _عدد_الاختبارات + 1
   إذا (الفعلي == المتوقع)
      _عدد_النجاح = _عدد_النجاح + 1
      اطبع_سطر("  ✓ " + الوصف)
   وإلا
      _عدد_الفشل = _عدد_الفشل + 1
      اطبع_سطر("  ✗ " + الوصف)
      اطبع_سطر("    المتوقع: " + المتوقع)
      اطبع_سطر("    الفعلي:  " + الفعلي)
   نهاية
نهاية

