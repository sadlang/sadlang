## سجل رسالة مع تصنيف
دالة _سجل_مصنف(المستوى, التصنيف, الرسالة)
   إذا (المستوى >= _المستوى_الحالي)
      اطبع_سطر(_رمز_المستوى(المستوى) + " [" + _اسم_المستوى(المستوى) + "][" + التصنيف + "] " + الرسالة)
   نهاية
نهاية

