## تسجيل محدد بزمن (يطبع الرسالة مع جملة البداية والنهاية)
دالة سجل_عملية(الاسم, الدالة)
   سجل_معلومة("بدء: " + الاسم)
   حاول
      متغير النتيجة = الدالة()
      سجل_معلومة("انتهى: " + الاسم)
      ارجع النتيجة
   امسك (خطأ)
      سجل_خطأ("فشل: " + الاسم + " — " + خطأ)
      ارمي خطأ
   نهاية
نهاية

