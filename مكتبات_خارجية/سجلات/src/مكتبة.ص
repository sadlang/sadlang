# مُسجّل ككائن (Object Logger)
# ═══════════════════════════════════════════════════════════

صنف مسجل
   باني(الاسم)
      هذا.الاسم = الاسم
      هذا._المستوى = معلومة
      هذا._السجل = []
      هذا._الحد_الأقصى = 1000
      هذا._مفعّل = صحيح
   نهاية

   دالة عيّن_المستوى(المستوى)
      هذا._المستوى = المستوى
   نهاية

   دالة عيّن_الحد(الحد)
      هذا._الحد_الأقصى = الحد
   نهاية

   دالة فعّل()
      هذا._مفعّل = صحيح
   نهاية

   دالة عطّل()
      هذا._مفعّل = خطأ
   نهاية

   دالة _سجل(المستوى, الرسالة)
      إذا (ليس هذا._مفعّل)
         ارجع لاشيء
      نهاية
      إذا (المستوى >= هذا._المستوى)
         متغير نص_سجل = _رمز_المستوى(المستوى) + " [" + _اسم_المستوى(المستوى) + "][" + هذا.الاسم + "] " + الرسالة
         اطبع_سطر(نص_سجل)
         
         # حفظ في السجل المحلي
         متغير عدد = 0
         لكل _ في هذا._السجل
            عدد = عدد + 1
         نهاية
         إذا (عدد >= هذا._الحد_الأقصى)
            # إزالة أقدم عنصر
            متغير جديدة = []
            متغير ي = 0
            لكل عنصر في هذا._السجل
               إذا (ي > 0)
                  جديدة = جديدة + [عنصر]
               نهاية
               ي = ي + 1
            نهاية
            هذا._السجل = جديدة
         نهاية
         هذا._السجل = هذا._السجل + [[المستوى, الرسالة]]
      نهاية
   نهاية

   دالة تتبع(الرسالة)
      هذا._سجل(0, الرسالة)
   نهاية

   دالة تصحيح(الرسالة)
      هذا._سجل(1, الرسالة)
   نهاية

   دالة معلومة(الرسالة)
      هذا._سجل(2, الرسالة)
   نهاية

   دالة تحذير(الرسالة)
      هذا._سجل(3, الرسالة)
   نهاية

   دالة خطأ(الرسالة)
      هذا._سجل(4, الرسالة)
   نهاية

   دالة حرج(الرسالة)
      هذا._سجل(5, الرسالة)
   نهاية

   ## الحصول على السجل المحفوظ
   دالة السجل()
      متغير نسخة = []
      لكل عنصر في هذا._السجل
         نسخة = نسخة + [عنصر]
      نهاية
      ارجع نسخة
   نهاية

   ## عدد الرسائل المسجلة
   دالة عدد_الرسائل()
      متغير عدد = 0
      لكل _ في هذا._السجل
         عدد = عدد + 1
      نهاية
      ارجع عدد
   نهاية

   ## مسح السجل
   دالة امسح()
      هذا._السجل = []
   نهاية

   ## طباعة جميع الرسائل المحفوظة
   دالة اطبع_الكل()
      اطبع_سطر("═══ سجل [" + هذا.الاسم + "] ═══")
      لكل عنصر في هذا._السجل
         اطبع_سطر("  " + _رمز_المستوى(عنصر[0]) + " " + عنصر[1])
      نهاية
      اطبع_سطر("═══ نهاية السجل (" + هذا.عدد_الرسائل() + " رسالة) ═══")
   نهاية

   ## تصفية الرسائل بمستوى معين
   دالة رسائل_بمستوى(المستوى)
      متغير النتيجة = []
      لكل عنصر في هذا._السجل
         إذا (عنصر[0] == المستوى)
            النتيجة = النتيجة + [عنصر[1]]
         نهاية
      نهاية
      ارجع النتيجة
   نهاية

   ## عدد الأخطاء المسجلة
   دالة عدد_الأخطاء()
      متغير عدد = 0
      لكل عنصر في هذا._السجل
         إذا (عنصر[0] >= 4)
            عدد = عدد + 1
         نهاية
      نهاية
      ارجع عدد
   نهاية

   ## هل يوجد أخطاء؟
   دالة يوجد_أخطاء()
      ارجع هذا.عدد_الأخطاء() > 0
   نهاية
نهاية

