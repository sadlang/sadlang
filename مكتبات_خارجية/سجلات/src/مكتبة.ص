## مستويات التسجيل
ثابت تتبع = 0
ثابت تصحيح = 1
ثابت معلومة = 2
ثابت تحذير = 3
ثابت خطأ_مستوى = 4
ثابت حرج = 5

متغير _المستوى_الحالي = معلومة

## أسماء المستويات
دالة _اسم_المستوى(المستوى)
   إذا (المستوى == تتبع)
      ارجع "تتبع"
   نهاية
   إذا (المستوى == تصحيح)
      ارجع "تصحيح"
   نهاية
   إذا (المستوى == معلومة)
      ارجع "معلومة"
   نهاية
   إذا (المستوى == تحذير)
      ارجع "تحذير"
   نهاية
   إذا (المستوى == خطأ_مستوى)
      ارجع "خطأ"
   نهاية
   إذا (المستوى == حرج)
      ارجع "حرج"
   نهاية
   ارجع "مجهول"
نهاية

## رموز المستويات
دالة _رمز_المستوى(المستوى)
   إذا (المستوى == تتبع)
      ارجع "🔍"
   نهاية
   إذا (المستوى == تصحيح)
      ارجع "🐛"
   نهاية
   إذا (المستوى == معلومة)
      ارجع "ℹ️"
   نهاية
   إذا (المستوى == تحذير)
      ارجع "⚠️"
   نهاية
   إذا (المستوى == خطأ_مستوى)
      ارجع "❌"
   نهاية
   إذا (المستوى == حرج)
