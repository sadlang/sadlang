_تحقق("اسم تصحيح", _اسم_المستوى(1) == "تصحيح")
_تحقق("اسم معلومة", _اسم_المستوى(2) == "معلومة")
_تحقق("اسم تحذير", _اسم_المستوى(3) == "تحذير")
_تحقق("اسم خطأ", _اسم_المستوى(4) == "خطأ")
_تحقق("اسم حرج", _اسم_المستوى(5) == "حرج")
