من مكتبات_خارجية.سجلات.src.مكتبة استورد سجل_تتبع, سجل_تصحيح

اطبع_سطر("╔══════════════════════════════════════╗")
اطبع_سطر("║ اختبارات مكتبة السجلات              ║")
اطبع_سطر("╚══════════════════════════════════════╝")

متغير _نجح = 0
متغير _فشل = 0

دالة _تحقق(الوصف, الشرط)
   إذا (الشرط)
      _نجح = _نجح + 1
      اطبع_سطر("  ✓ " + الوصف)
   وإلا
      _فشل = _فشل + 1
      اطبع_سطر("  ✗ " + الوصف)
   نهاية
نهاية

# ═══ المستويات ═══
اطبع_سطر("")
اطبع_سطر("── المستويات ──")
_تحقق("تتبع = 0", تتبع == 0)
_تحقق("تصحيح = 1", تصحيح == 1)
_تحقق("معلومة = 2", معلومة == 2)
_تحقق("تحذير = 3", تحذير == 3)
_تحقق("خطأ_مستوى = 4", خطأ_مستوى == 4)
_تحقق("حرج = 5", حرج == 5)

