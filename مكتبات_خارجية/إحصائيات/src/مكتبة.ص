نهاية

## التباين المشترك (Covariance)
دالة التباين_المشترك(بيانات_س, بيانات_ص)
   متغير ن = العدد(بيانات_س)
   إذا (ن != العدد(بيانات_ص))
      ارمي "المصفوفتان يجب أن تكونا بنفس الطول"
   نهاية
   إذا (ن == 0)
      ارمي "مصفوفة فارغة"
   نهاية
   متغير م_س = المتوسط(بيانات_س)
   متغير م_ص = المتوسط(بيانات_ص)
   متغير مج = 0
   متغير ي = 0
   بينما (ي < ن)
      مج = مج + (بيانات_س[ي] - م_س) * (بيانات_ص[ي] - م_ص)
      ي = ي + 1
   نهاية
   ارجع مج / ن
نهاية

## معامل الارتباط (Correlation coefficient)
دالة الارتباط(بيانات_س, بيانات_ص)
   متغير التب = التباين_المشترك(بيانات_س, بيانات_ص)
   متغير ا_س = الانحراف_المعياري(بيانات_س)
   متغير ا_ص = الانحراف_المعياري(بيانات_ص)
   إذا (ا_س == 0 أو ا_ص == 0)
      ارجع 0
   نهاية
   ارجع التب / (ا_س * ا_ص)
نهاية

## الانحدار الخطي البسيط (يرجع [slope, intercept])
دالة الانحدار_الخطي(بيانات_س, بيانات_ص)
   متغير ن = العدد(بيانات_س)
   إذا (ن != العدد(بيانات_ص) أو ن == 0)
      ارمي "بيانات غير صالحة"
   نهاية
   متغير م_س = المتوسط(بيانات_س)
   متغير م_ص = المتوسط(بيانات_ص)
   
   متغير البسط = 0
   متغير المقام = 0
   متغير ي = 0
   بينما (ي < ن)
      البسط = البسط + (بيانات_س[ي] - م_س) * (بيانات_ص[ي] - م_ص)
      المقام = المقام + (بيانات_س[ي] - م_س) * (بيانات_س[ي] - م_س)
      ي = ي + 1
   نهاية
   
   إذا (المقام == 0)
      ارجع [0, م_ص]
   نهاية
   متغير الميل = البسط / المقام
   متغير التقاطع = م_ص - الميل * م_س
   ارجع [الميل, التقاطع]
نهاية

## المتوسط المتحرك البسيط (Simple Moving Average)
دالة المتوسط_المتحرك(البيانات, حجم_النافذة)
   متغير ن = العدد(البيانات)
   إذا (حجم_النافذة > ن أو حجم_النافذة <= 0)
      ارمي "حجم النافذة غير صالح"
   نهاية
   متغير النتيجة = []
   متغير ي = 0
   بينما (ي <= ن - حجم_النافذة)
      متغير مج = 0
      متغير ك = 0
      بينما (ك < حجم_النافذة)
         مج = مج + البيانات[ي + ك]
         ك = ك + 1
      نهاية
      النتيجة = النتيجة + [مج / حجم_النافذة]
      ي = ي + 1
   نهاية
   ارجع النتيجة
نهاية

