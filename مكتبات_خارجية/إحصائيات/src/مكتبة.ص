## ترتيب مصفوفة (bubble sort)
دالة رتّب(البيانات)
   متغير نسخة = []
   لكل قيمة في البيانات
      نسخة = نسخة + [قيمة]
   نهاية
   متغير ن = العدد(نسخة)
   متغير ي = 0
   بينما (ي < ن - 1)
      متغير ك = 0
      بينما (ك < ن - ي - 1)
         إذا (نسخة[ك] > نسخة[ك + 1])
            متغير مؤقت = نسخة[ك]
            نسخة[ك] = نسخة[ك + 1]
            نسخة[ك + 1] = مؤقت
         نهاية
         ك = ك + 1
      نهاية
      ي = ي + 1
   نهاية
   ارجع نسخة
نهاية

## الوسيط
دالة الوسيط(البيانات)
   متغير ن = العدد(البيانات)
   إذا (ن == 0)
      ارمي "مصفوفة فارغة"
   نهاية
   متغير مرتبة = رتّب(البيانات)
   إذا (ن % 2 == 1)
      ارجع مرتبة[(ن - 1) / 2]
   وإلا
      ارجع (مرتبة[ن / 2 - 1] + مرتبة[ن / 2]) / 2
   نهاية
نهاية

## التباين
دالة التباين(البيانات)
   متغير ن = العدد(البيانات)
   إذا (ن == 0)
      ارمي "مصفوفة فارغة"
   نهاية
   متغير م = المتوسط(البيانات)
   متغير مج = 0
   لكل قيمة في البيانات
      مج = مج + (قيمة - م) * (قيمة - م)
   نهاية
   ارجع مج / ن
نهاية

## الانحراف المعياري (تقريبي باستخدام طريقة نيوتن)
دالة الانحراف_المعياري(البيانات)
   متغير ت = التباين(البيانات)
   # جذر تربيعي تقريبي بطريقة نيوتن
   إذا (ت == 0)
      ارجع 0
   نهاية
   متغير تخمين = ت / 2
   متغير ي = 0
   بينما (ي < 20)
      تخمين = (تخمين + ت / تخمين) / 2
      ي = ي + 1
   نهاية
   ارجع تخمين
نهاية

## المنوال (القيمة الأكثر تكرارًا)
دالة المنوال(البيانات)
   متغير ن = العدد(البيانات)
   إذا (ن == 0)
      ارمي "مصفوفة فارغة"
   نهاية
   متغير أكثر_قيمة = البيانات[0]
   متغير أكثر_عدد = 0
   لكل قيمة في البيانات
      متغير عدد = 0
      لكل ق في البيانات
         إذا (ق == قيمة)
            عدد = عدد + 1
         نهاية
      نهاية
      إذا (عدد > أكثر_عدد)
         أكثر_عدد = عدد
         أكثر_قيمة = قيمة
      نهاية
   نهاية
   ارجع أكثر_قيمة
نهاية

## التكرارات (عدد مرات ظهور كل قيمة)
دالة التكرارات(البيانات)
   متغير الفريدة = []
   متغير الأعداد = []
   لكل قيمة في البيانات
      متغير موجود = خطأ
      متغير ي = 0
      لكل ف في الفريدة
         إذا (ف == قيمة)
            الأعداد[ي] = الأعداد[ي] + 1
            موجود = صحيح
         نهاية
         ي = ي + 1
      نهاية
      إذا (ليس موجود)
         الفريدة = الفريدة + [قيمة]
         الأعداد = الأعداد + [1]
      نهاية
   نهاية
   # إرجاع كقائمة من [قيمة, عدد]
   متغير النتيجة = []
   متغير ي = 0
   لكل ف في الفريدة
      النتيجة = النتيجة + [[ف, الأعداد[ي]]]
      ي = ي + 1
   نهاية
   ارجع النتيجة
نهاية

