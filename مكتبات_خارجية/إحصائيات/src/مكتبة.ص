## مصفوفة التكرارات لرسم بياني (histogram bins)
دالة مصفوفة_تكرارات(البيانات, عدد_الفئات)
   متغير أصغر = الأصغر(البيانات)
   متغير أكبر = الأكبر(البيانات)
   متغير حجم_فئة = (أكبر - أصغر) / عدد_الفئات
   إذا (حجم_فئة == 0)
      ارجع [[أصغر, العدد(البيانات)]]
   نهاية
   
   متغير الفئات = []
   متغير ي = 0
   بينما (ي < عدد_الفئات)
      الفئات = الفئات + [0]
      ي = ي + 1
   نهاية
   
   لكل قيمة في البيانات
      متغير فهرس = (قيمة - أصغر) / حجم_فئة
      متغير ف = فهرس - فهرس % 1
      إذا (ف >= عدد_الفئات)
         ف = عدد_الفئات - 1
      نهاية
      الفئات[ف] = الفئات[ف] + 1
   نهاية
   
   # إرجاع كقائمة [بداية_الفئة, العدد]
   متغير النتيجة = []
   ي = 0
   بينما (ي < عدد_الفئات)
      النتيجة = النتيجة + [[أصغر + ي * حجم_فئة, الفئات[ي]]]
      ي = ي + 1
   نهاية
   ارجع النتيجة
نهاية

