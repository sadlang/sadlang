## تطبيع البيانات (0-1)
دالة التطبيع(البيانات)
   متغير أصغر = الأصغر(البيانات)
   متغير أكبر = الأكبر(البيانات)
   متغير المدى_ق = أكبر - أصغر
   إذا (المدى_ق == 0)
      متغير النتيجة = []
      لكل _ في البيانات
         النتيجة = النتيجة + [0]
      نهاية
      ارجع النتيجة
   نهاية
   متغير النتيجة = []
   لكل قيمة في البيانات
      النتيجة = النتيجة + [(قيمة - أصغر) / المدى_ق]
   نهاية
   ارجع النتيجة
نهاية

## المتوسط المرجح
دالة المتوسط_المرجح(القيم, الأوزان)
   متغير ن = العدد(القيم)
   إذا (ن != العدد(الأوزان) أو ن == 0)
      ارمي "بيانات غير صالحة"
   نهاية
   متغير مج_مرجح = 0
   متغير مج_أوزان = 0
   متغير ي = 0
   بينما (ي < ن)
      مج_مرجح = مج_مرجح + القيم[ي] * الأوزان[ي]
      مج_أوزان = مج_أوزان + الأوزان[ي]
      ي = ي + 1
   نهاية
   إذا (مج_أوزان == 0)
      ارمي "مجموع الأوزان صفر"
   نهاية
   ارجع مج_مرجح / مج_أوزان
نهاية

