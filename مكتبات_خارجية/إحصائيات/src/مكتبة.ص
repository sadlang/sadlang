## الجذر التربيعي (طريقة نيوتن)
دالة _جذر(قيمة)
   إذا (قيمة <= 0)
      ارجع 0
   نهاية
   متغير تخمين = قيمة / 2
   متغير ي = 0
   بينما (ي < 25)
      تخمين = (تخمين + قيمة / تخمين) / 2
      ي = ي + 1
   نهاية
   ارجع تخمين
نهاية

## القيمة المطلقة
دالة _مطلق(ن)
   إذا (ن < 0)
      ارجع ن * -1
   نهاية
   ارجع ن
نهاية

## متوسط هندسي (تقريبي — حاصل ضرب ثم الجذر النوني)
دالة المتوسط_الهندسي(البيانات)
   متغير ن = العدد(البيانات)
   إذا (ن == 0)
      ارمي "مصفوفة فارغة"
   نهاية
   # حساب عبر مجموع اللوغاريتمات التقريبية
   متغير حاصل_ضرب = 1
   لكل قيمة في البيانات
      إذا (قيمة <= 0)
         ارمي "المتوسط الهندسي يتطلب أرقاماً موجبة"
      نهاية
      حاصل_ضرب = حاصل_ضرب * قيمة
   نهاية
   # الجذر النوني التقريبي
   متغير تخمين = حاصل_ضرب
   متغير ي = 0
   بينما (ي < 50)
      # Newton's method for x^n = product
      متغير قوة = 1
      متغير ك = 0
      بينما (ك < ن - 1)
         قوة = قوة * تخمين
         ك = ك + 1
      نهاية
      تخمين = تخمين - (قوة * تخمين - حاصل_ضرب) / (ن * قوة)
      ي = ي + 1
   نهاية
   ارجع تخمين
نهاية

## متوسط توافقي
دالة المتوسط_التوافقي(البيانات)
   متغير ن = العدد(البيانات)
   إذا (ن == 0)
      ارمي "مصفوفة فارغة"
   نهاية
   متغير مج_مقلوب = 0
   لكل قيمة في البيانات
      إذا (قيمة == 0)
         ارمي "لا يمكن حساب المتوسط التوافقي مع صفر"
      نهاية
      مج_مقلوب = مج_مقلوب + 1 / قيمة
   نهاية
   ارجع ن / مج_مقلوب
نهاية

## المئين (Percentile) — بالترتيب
دالة المئين(البيانات, النسبة)
   متغير ن = العدد(البيانات)
   إذا (ن == 0)
      ارمي "مصفوفة فارغة"
   نهاية
   متغير مرتبة = رتّب(البيانات)
   متغير الموضع = النسبة / 100 * (ن - 1)
   متغير أسفل = الموضع - الموضع % 1
   متغير الكسر = الموضع % 1
   إذا (أسفل + 1 < ن)
      ارجع مرتبة[أسفل] * (1 - الكسر) + مرتبة[أسفل + 1] * الكسر
   نهاية
   ارجع مرتبة[أسفل]
نهاية

