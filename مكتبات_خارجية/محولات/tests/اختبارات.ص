متغير _نجح = 0
متغير _فشل = 0

دالة _تحقق(الوصف, الشرط)
   إذا (الشرط)
      _نجح = _نجح + 1
      اطبع_سطر("  ✓ " + الوصف)
   وإلا
      _فشل = _فشل + 1
      اطبع_سطر("  ✗ " + الوصف)
   نهاية
نهاية

دالة _قريب(أ, ب)
   متغير فرق = أ - ب
   إذا (فرق < 0)
      فرق = فرق * -1
   نهاية
   ارجع فرق < 0.01
نهاية

