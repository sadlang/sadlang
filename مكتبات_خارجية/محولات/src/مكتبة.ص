## محول شامل — يتعرف على الوحدة
صنف محول
   باني()
      هذا._المعاملات = []
   نهاية

   دالة أضف_تحويل(من, إلى, المعامل)
      هذا._المعاملات = هذا._المعاملات + [[من, إلى, المعامل]]
   نهاية

   دالة حوّل(القيمة, من, إلى)
      لكل تحويل في هذا._المعاملات
         إذا (تحويل[0] == من و تحويل[1] == إلى)
            ارجع القيمة * تحويل[2]
         نهاية
      نهاية
      ارمي "تحويل غير مدعوم: " + من + " إلى " + إلى
   نهاية
نهاية

