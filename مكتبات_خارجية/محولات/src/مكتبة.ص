# الأرقام الرومانية
# ═══════════════════════════════════════════════════════════

دالة إلى_روماني(الرقم)
   متغير النتيجة = ""
   متغير ن = الرقم
   
   بينما (ن >= 1000)
      النتيجة = النتيجة + "M"
      ن = ن - 1000
   نهاية
   بينما (ن >= 900)
      النتيجة = النتيجة + "CM"
      ن = ن - 900
   نهاية
   بينما (ن >= 500)
      النتيجة = النتيجة + "D"
      ن = ن - 500
   نهاية
   بينما (ن >= 400)
      النتيجة = النتيجة + "CD"
      ن = ن - 400
   نهاية
   بينما (ن >= 100)
      النتيجة = النتيجة + "C"
      ن = ن - 100
   نهاية
   بينما (ن >= 90)
      النتيجة = النتيجة + "XC"
      ن = ن - 90
   نهاية
   بينما (ن >= 50)
      النتيجة = النتيجة + "L"
      ن = ن - 50
   نهاية
   بينما (ن >= 40)
      النتيجة = النتيجة + "XL"
      ن = ن - 40
   نهاية
   بينما (ن >= 10)
      النتيجة = النتيجة + "X"
      ن = ن - 10
   نهاية
   بينما (ن >= 9)
      النتيجة = النتيجة + "IX"
      ن = ن - 9
   نهاية
   بينما (ن >= 5)
      النتيجة = النتيجة + "V"
      ن = ن - 5
   نهاية
   بينما (ن >= 4)
      النتيجة = النتيجة + "IV"
      ن = ن - 4
   نهاية
   بينما (ن >= 1)
      النتيجة = النتيجة + "I"
      ن = ن - 1
   نهاية
   
   ارجع النتيجة
نهاية

