## تنسيق الحجم بشكل قابل للقراءة
دالة تنسيق_حجم(البايت)
   إذا (البايت < 1024)
      ارجع البايت + " بايت"
   نهاية
   إذا (البايت < 1024 * 1024)
      ارجع (البايت / 1024) + " كيلوبايت"
   نهاية
   إذا (البايت < 1024 * 1024 * 1024)
      ارجع (البايت / (1024 * 1024)) + " ميغابايت"
   نهاية
   ارجع (البايت / (1024 * 1024 * 1024)) + " غيغابايت"
نهاية

