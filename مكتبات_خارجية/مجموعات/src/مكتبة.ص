            أكبر_مفتاح = م
         نهاية
         ي = ي + 1
      نهاية
      ارجع أكبر_مفتاح
   نهاية

   دالة المجموع()
      متغير مج = 0
      لكل ق في هذا._خريطة.القيم()
         مج = مج + ق
      نهاية
      ارجع مج
   نهاية

   دالة العناصر_الفريدة()
      ارجع هذا._خريطة.المفاتيح()
   نهاية
