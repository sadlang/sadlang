# اختبارات مكتبة الألوان
# ═══════════════════════════════════════

من مكتبات_خارجية.ألوان.src.مكتبة استورد لون, لوحة, تدرج
من مكتبات_خارجية.ألوان.src.مكتبة استورد أحمر, أخضر, أزرق, أبيض, أسود, أصفر, ذهبي
من مكتبات_خارجية.ألوان.src.مكتبة استورد من_سداسي, لون_نص_لخلفية

اطبع_سطر("╔══════════════════════════════════════╗")
اطبع_سطر("║ اختبارات مكتبة الألوان              ║")
اطبع_سطر("╚══════════════════════════════════════╝")

متغير _نجح = 0
متغير _فشل = 0

دالة _تحقق(الوصف, الشرط)
   إذا (الشرط)
      _نجح = _نجح + 1
      اطبع_سطر("  ✓ " + الوصف)
   وإلا
      _فشل = _فشل + 1
      اطبع_سطر("  ✗ " + الوصف)
   نهاية
نهاية

# ═══ صنف لون ═══
اطبع_سطر("")
اطبع_سطر("── إنشاء الألوان ──")
متغير ل = جديد لون(255, 0, 0)
_تحقق("إنشاء لون أحمر", ل.أحمر == 255 و ل.أخضر == 0 و ل.أزرق == 0)
_تحقق("تمثيل نصي", ل.نص() == "rgb(255, 0, 0)")

متغير ل2 = جديد لون(100, 200, 50)
_تحقق("لون مخصص", ل2.أحمر == 100 و ل2.أخضر == 200 و ل2.أزرق == 50)

# ═══ السداسي عشري ═══
اطبع_سطر("")
اطبع_سطر("── التمثيل السداسي ──")
متغير أحمر_سداسي = جديد لون(255, 0, 0)
_تحقق("سداسي أحمر", أحمر_سداسي.سداسي() == "#ff0000")

متغير أبيض_سداسي = جديد لون(255, 255, 255)
_تحقق("سداسي أبيض", أبيض_سداسي.سداسي() == "#ffffff")

متغير أسود_سداسي = جديد لون(0, 0, 0)
_تحقق("سداسي أسود", أسود_سداسي.سداسي() == "#000000")

# ═══ المزج ═══
اطبع_سطر("")
اطبع_سطر("── المزج ──")
متغير ل_أحمر = جديد لون(255, 0, 0)
متغير ل_أزرق = جديد لون(0, 0, 255)
متغير ممزوج = ل_أحمر.مزج(ل_أزرق, 0.5)
_تحقق("مزج أحمر+أزرق 50%", ممزوج.أحمر == 128 و ممزوج.أزرق == 128)

متغير ممزوج0 = ل_أحمر.مزج(ل_أزرق, 0)
_تحقق("مزج بنسبة 0 = اللون الأصلي", ممزوج0.أحمر == 255 و ممزوج0.أزرق == 0)

# ═══ التفتيح والتغميق ═══
اطبع_سطر("")
اطبع_سطر("── التفتيح والتغميق ──")
متغير ل3 = جديد لون(100, 100, 100)
متغير فاتح = ل3.أفتح(0.5)
_تحقق("التفتيح يزيد القيم", فاتح.أحمر > 100)

متغير غامق = ل3.أغمق(0.5)
_تحقق("التغميق ينقص القيم", غامق.أحمر < 100)

# ═══ الإضاءة ═══
اطبع_سطر("")
اطبع_سطر("── الإضاءة ──")
متغير أبيض_ل = جديد لون(255, 255, 255)
_تحقق("الأبيض فاتح", أبيض_ل.هل_فاتح() == صحيح)
_تحقق("الأبيض ليس غامق", أبيض_ل.هل_غامق() == خطأ)

متغير أسود_ل = جديد لون(0, 0, 0)
_تحقق("الأسود غامق", أسود_ل.هل_غامق() == صحيح)

# ═══ العكس ═══
اطبع_سطر("")
اطبع_سطر("── العكس والرمادي ──")
متغير ل4 = جديد لون(255, 0, 0)
متغير معكوس = ل4.عكس()
_تحقق("عكس الأحمر = سماوي", معكوس.أحمر == 0 و معكوس.أخضر == 255 و معكوس.أزرق == 255)

متغير رمادي_ل = ل4.رمادي()
_تحقق("الرمادي: القيم متساوية", رمادي_ل.أحمر == رمادي_ل.أخضر و رمادي_ل.أخضر == رمادي_ل.أزرق)

# ═══ التساوي والمسافة ═══
اطبع_سطر("")
اطبع_سطر("── التساوي والمسافة ──")
متغير ل5 = جديد لون(100, 200, 50)
متغير ل6 = جديد لون(100, 200, 50)
متغير ل7 = جديد لون(200, 100, 50)
_تحقق("لونان متساويان", ل5.يساوي(ل6) == صحيح)
_تحقق("لونان مختلفان", ل5.يساوي(ل7) == خطأ)
_تحقق("المسافة بين لونين متساويين = 0", ل5.المسافة(ل6) == 0)
_تحقق("المسافة بين لونين مختلفين > 0", ل5.المسافة(ل7) > 0)

# ═══ الألوان المحددة مسبقاً ═══
اطبع_سطر("")
اطبع_سطر("── الألوان المحددة مسبقاً ──")
_تحقق("أحمر()", أحمر().أحمر == 255 و أحمر().أخضر == 0)
_تحقق("أخضر()", أخضر().أخضر == 128)
_تحقق("أزرق()", أزرق().أزرق == 255)
_تحقق("أصفر()", أصفر().أحمر == 255 و أصفر().أخضر == 255)
_تحقق("ذهبي()", ذهبي().أحمر == 255)

# ═══ من سداسي ═══
اطبع_سطر("")
اطبع_سطر("── من سداسي ──")
متغير من_ساد = من_سداسي("#ff0000")
_تحقق("من سداسي أحمر", من_ساد.أحمر == 255 و من_ساد.أخضر == 0)

# ═══ اللوحة ═══
اطبع_سطر("")
اطبع_سطر("── اللوحة ──")
متغير اللوحة = جديد لوحة("اختبار")
اللوحة.أضف("أحمر", أحمر())
اللوحة.أضف("أزرق", أزرق())
_تحقق("عدد ألوان اللوحة", اللوحة.العدد() == 2)
_تحقق("لون بالترتيب", اللوحة.لون_بالترتيب(0).أحمر == 255)

# ═══ التدرج ═══
اطبع_سطر("")
اطبع_سطر("── التدرج ──")
متغير التدرج = جديد تدرج(أحمر(), أزرق())
متغير وسط = التدرج.لون_عند(0.5)
_تحقق("وسط التدرج", وسط.أحمر == 128 و وسط.أزرق == 128)

متغير خطوات_م = التدرج.خطوات(3)
متغير عدد_خطوات = 0
لكل _ في خطوات_م
   عدد_خطوات = عدد_خطوات + 1
نهاية
_تحقق("3 خطوات تدرج", عدد_خطوات == 3)

# ═══ لون النص للخلفية ═══
اطبع_سطر("")
اطبع_سطر("── لون النص للخلفية ──")
_تحقق("نص أبيض على خلفية سوداء", لون_نص_لخلفية(أسود()).أحمر == 255)
_تحقق("نص أسود على خلفية بيضاء", لون_نص_لخلفية(أبيض()).أحمر == 0)

# ═══ التقرير ═══
اطبع_سطر("")
اطبع_سطر("═══════════════════════════════")
اطبع_سطر("النتائج: " + _نجح + " نجح، " + _فشل + " فشل")
إذا (_فشل == 0)
   اطبع_سطر("✓ جميع الاختبارات ناجحة!")
وإلا
   اطبع_سطر("✗ بعض الاختبارات فشلت")
