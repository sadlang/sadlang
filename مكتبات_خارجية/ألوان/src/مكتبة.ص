# إنشاء لون من سداسي عشري
# ═══════════════════════════════════════════════════════════

دالة من_سداسي(سداسي)
   # إزالة # من البداية
   متغير الأحرف = []
   متغير أول = صحيح
   لكل حرف في سداسي
      إذا (أول و حرف == "#")
         أول = خطأ
      وإلا
         الأحرف = الأحرف + [حرف]
         أول = خطأ
      نهاية
   نهاية
   متغير ر = _سداسي_إلى_رقم(الأحرف[0] + الأحرف[1])
   متغير خ = _سداسي_إلى_رقم(الأحرف[2] + الأحرف[3])
   متغير ز = _سداسي_إلى_رقم(الأحرف[4] + الأحرف[5])
   ارجع جديد لون(ر, خ, ز)
نهاية

