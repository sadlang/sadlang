# تدرج لوني (Gradient)
# ═══════════════════════════════════════════════════════════

صنف تدرج
   باني(لون_بداية, لون_نهاية)
      هذا.البداية = لون_بداية
      هذا.النهاية = لون_نهاية
   نهاية

   ## الحصول على لون في نقطة معينة من التدرج (0-1)
   دالة لون_عند(نسبة)
      ارجع هذا.البداية.مزج(هذا.النهاية, نسبة)
   نهاية

   ## إنشاء مصفوفة ألوان بعدد خطوات محدد
   دالة خطوات(عدد)
      إذا (عدد < 2)
         ارجع [هذا.البداية.نسخة()]
      نهاية
      متغير النتيجة = []
      متغير ي = 0
      بينما (ي < عدد)
         متغير ن = ي / (عدد - 1)
         النتيجة = النتيجة + [هذا.لون_عند(ن)]
         ي = ي + 1
      نهاية
      ارجع النتيجة
   نهاية

   ## تمثيل CSS للتدرج
   دالة css_خطي(الاتجاه)
      ارجع "linear-gradient(" + الاتجاه + ", " + هذا.البداية.سداسي() + ", " + هذا.النهاية.سداسي() + ")"
   نهاية
نهاية

