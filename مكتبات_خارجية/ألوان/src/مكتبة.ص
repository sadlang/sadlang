دالة _حصر(قيمة, أدنى, أقصى)
   إذا (قيمة < أدنى)
      ارجع أدنى
   نهاية
   إذا (قيمة > أقصى)
      ارجع أقصى
   نهاية
   ارجع قيمة
نهاية

دالة _تقريب(قيمة)
   متغير جزء_صحيح = قيمة - قيمة % 1
   إذا (قيمة % 1 >= 0.5)
      ارجع جزء_صحيح + 1
   نهاية
   ارجع جزء_صحيح
نهاية

دالة _قيمة_مطلقة(ن)
   إذا (ن < 0)
      ارجع ن * -1
   نهاية
   ارجع ن
نهاية

دالة _أكبر_من(أ, ب)
   إذا (أ > ب)
      ارجع أ
   نهاية
   ارجع ب
نهاية

دالة _أصغر_من(أ, ب)
   إذا (أ < ب)
      ارجع أ
   نهاية
   ارجع ب
نهاية

دالة _رقم_سداسي(رقم)
   متغير الأحرف = "0123456789abcdef"
   متغير أحرف_م = []
   لكل ح في الأحرف
      أحرف_م = أحرف_م + [ح]
   نهاية
   متغير ن = _حصر(_تقريب(رقم), 0, 255)
   ارجع أحرف_م[(ن - ن % 16) / 16] + أحرف_م[ن % 16]
نهاية

دالة _سداسي_إلى_رقم(سداسي)
   متغير الأحرف = "0123456789abcdef"
   متغير أحرف_م = []
   لكل ح في الأحرف
      أحرف_م = أحرف_م + [ح]
   نهاية
   متغير النتيجة = 0
   لكل حرف في سداسي
      متغير ي = 0
      لكل ح في أحرف_م
         إذا (ح == حرف)
            النتيجة = النتيجة * 16 + ي
         نهاية
         ي = ي + 1
      نهاية
   نهاية
   ارجع النتيجة
نهاية

# ═══════════════════════════════════════════════════════════
# صنف اللون الرئيسي (RGB)
# ═══════════════════════════════════════════════════════════

صنف لون
   باني(أحمر, أخضر, أزرق)
      هذا.أحمر = _حصر(_تقريب(أحمر), 0, 255)
      هذا.أخضر = _حصر(_تقريب(أخضر), 0, 255)
      هذا.أزرق = _حصر(_تقريب(أزرق), 0, 255)
   نهاية

   ## تمثيل نصي rgb(r, g, b)
   دالة نص()
      ارجع "rgb(" + هذا.أحمر + ", " + هذا.أخضر + ", " + هذا.أزرق + ")"
   نهاية

   ## تمثيل سداسي عشري #rrggbb
   دالة سداسي()
      ارجع "#" + _رقم_سداسي(هذا.أحمر) + _رقم_سداسي(هذا.أخضر) + _رقم_سداسي(هذا.أزرق)
   نهاية

   ## مزج لونين بنسبة (0 = هذا اللون, 1 = اللون الآخر)  
   دالة مزج(لون_آخر, نسبة)
      متغير ن = _حصر(نسبة, 0, 1)
      متغير ر = هذا.أحمر * (1 - ن) + لون_آخر.أحمر * ن
      متغير خ = هذا.أخضر * (1 - ن) + لون_آخر.أخضر * ن
      متغير ز = هذا.أزرق * (1 - ن) + لون_آخر.أزرق * ن
      ارجع جديد لون(ر, خ, ز)
   نهاية

   ## تفتيح اللون بنسبة (0-1)
   دالة أفتح(نسبة)
      ارجع هذا.مزج(جديد لون(255, 255, 255), نسبة)
   نهاية

   ## تغميق اللون بنسبة (0-1)
   دالة أغمق(نسبة)
      ارجع هذا.مزج(جديد لون(0, 0, 0), نسبة)
   نهاية

   ## حساب الإضاءة (luminance) 0-255
   دالة إضاءة()
      ارجع (هذا.أحمر * 299 + هذا.أخضر * 587 + هذا.أزرق * 114) / 1000
   نهاية

   ## هل اللون فاتح؟
   دالة هل_فاتح()
      ارجع هذا.إضاءة() > 128
   نهاية

   ## هل اللون غامق؟
   دالة هل_غامق()
      ارجع هذا.إضاءة() <= 128
   نهاية

   ## عكس اللون (complementary)
   دالة عكس()
      ارجع جديد لون(255 - هذا.أحمر, 255 - هذا.أخضر, 255 - هذا.أزرق)
   نهاية

   ## تدرج رمادي
   دالة رمادي()
      متغير م = _تقريب((هذا.أحمر + هذا.أخضر + هذا.أزرق) / 3)
      ارجع جديد لون(م, م, م)
   نهاية

   ## هل اللونان متساويان؟
   دالة يساوي(لون_آخر)
      ارجع هذا.أحمر == لون_آخر.أحمر و هذا.أخضر == لون_آخر.أخضر و هذا.أزرق == لون_آخر.أزرق
   نهاية

   ## المسافة بين لونين (Euclidean distance)
   دالة المسافة(لون_آخر)
      متغير فر = هذا.أحمر - لون_آخر.أحمر
      متغير فخ = هذا.أخضر - لون_آخر.أخضر
      متغير فز = هذا.أزرق - لون_آخر.أزرق
      متغير مج = فر * فر + فخ * فخ + فز * فز
      # جذر تربيعي تقريبي بطريقة نيوتن
      إذا (مج == 0)
         ارجع 0
      نهاية
      متغير تخمين = مج / 2
      متغير ي = 0
      بينما (ي < 20)
         تخمين = (تخمين + مج / تخمين) / 2
         ي = ي + 1
      نهاية
      ارجع تخمين
   نهاية

   ## نسبة التباين (contrast ratio) — تقريبي
   دالة التباين(لون_آخر)
      متغير إ1 = هذا.إضاءة() + 5
      متغير إ2 = لون_آخر.إضاءة() + 5
      إذا (إ1 > إ2)
         ارجع إ1 / إ2
      نهاية
      ارجع إ2 / إ1
   نهاية

   ## تحويل إلى HSL (تقريبي) - يرجع مصفوفة [H, S, L]
   دالة إلى_hsl()
      متغير ر = هذا.أحمر / 255
      متغير خ = هذا.أخضر / 255
      متغير ز = هذا.أزرق / 255
      
      متغير أكبر = _أكبر_من(_أكبر_من(ر, خ), ز)
      متغير أصغر = _أصغر_من(_أصغر_من(ر, خ), ز)
      متغير الفرق = أكبر - أصغر
      
      # حساب L
      متغير ل = (أكبر + أصغر) / 2
      
      # حساب S
      متغير س = 0
      إذا (الفرق > 0)
         إذا (ل < 0.5)
            س = الفرق / (أكبر + أصغر)
         وإلا
            س = الفرق / (2 - أكبر - أصغر)
         نهاية
      نهاية
      
      # حساب H
      متغير ص = 0
      إذا (الفرق > 0)
         إذا (أكبر == ر)
            ص = 60 * ((خ - ز) / الفرق)
         وإلا
            إذا (أكبر == خ)
               ص = 60 * ((ز - ر) / الفرق + 2)
            وإلا
               ص = 60 * ((ر - خ) / الفرق + 4)
            نهاية
         نهاية
         إذا (ص < 0)
            ص = ص + 360
         نهاية
      نهاية
      
      ارجع [_تقريب(ص), _تقريب(س * 100), _تقريب(ل * 100)]
   نهاية

   ## تعديل الشفافية (يرجع نص rgba)
   دالة مع_شفافية(ألفا)
      متغير أ = _حصر(ألفا, 0, 1)
      ارجع "rgba(" + هذا.أحمر + ", " + هذا.أخضر + ", " + هذا.أزرق + ", " + أ + ")"
   نهاية

   ## تعديل التشبع (زيادة أو نقصان)
   دالة تشبع(نسبة)
      # تحويل إلى رمادي نسبي ثم العودة
      متغير م_رمادي = _تقريب((هذا.أحمر + هذا.أخضر + هذا.أزرق) / 3)
      متغير ن = _حصر(نسبة, -1, 1)
      إذا (ن >= 0)
         # زيادة التشبع: ابتعد عن الرمادي
         متغير ر = هذا.أحمر + (هذا.أحمر - م_رمادي) * ن
         متغير خ = هذا.أخضر + (هذا.أخضر - م_رمادي) * ن
         متغير ز = هذا.أزرق + (هذا.أزرق - م_رمادي) * ن
         ارجع جديد لون(ر, خ, ز)
      وإلا
         # نقصان التشبع: اقترب من الرمادي
         متغير عكس_ن = _قيمة_مطلقة(ن)
         ارجع هذا.مزج(جديد لون(م_رمادي, م_رمادي, م_رمادي), عكس_ن)
      نهاية
   نهاية

   ## نسخة من اللون
   دالة نسخة()
      ارجع جديد لون(هذا.أحمر, هذا.أخضر, هذا.أزرق)
   نهاية
نهاية

# ═══════════════════════════════════════════════════════════
# لوحة ألوان (Color Palette)
# ═══════════════════════════════════════════════════════════

صنف لوحة
   باني(الاسم)
      هذا.الاسم = الاسم
      هذا._ألوان = []
      هذا._أسماء = []
   نهاية

   دالة أضف(الاسم, اللون)
      هذا._ألوان = هذا._ألوان + [اللون]
      هذا._أسماء = هذا._أسماء + [الاسم]
   نهاية

   دالة العدد()
      متغير عدد = 0
      لكل _ في هذا._ألوان
         عدد = عدد + 1
      نهاية
      ارجع عدد
   نهاية

   دالة لون_بالترتيب(الترتيب)
      ارجع هذا._ألوان[الترتيب]
   نهاية

   دالة اسم_بالترتيب(الترتيب)
      ارجع هذا._أسماء[الترتيب]
   نهاية

   دالة اعرض()
      اطبع_سطر("لوحة: " + هذا.الاسم)
      متغير ي = 0
      لكل لون في هذا._ألوان
         اطبع_سطر("  " + هذا._أسماء[ي] + ": " + لون.نص() + " " + لون.سداسي())
         ي = ي + 1
      نهاية
   نهاية
نهاية

