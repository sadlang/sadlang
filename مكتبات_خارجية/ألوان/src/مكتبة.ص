## إنشاء لون عشوائي باستخدام بذرة
دالة لون_من_بذرة(بذرة)
   متغير ر = (بذرة * 137 + 53) % 256
   متغير خ = (بذرة * 97 + 71) % 256
   متغير ز = (بذرة * 223 + 37) % 256
   ارجع جديد لون(ر, خ, ز)
نهاية

## لوحة ألوان مولدة تلقائياً
دالة لوحة_تلقائية(عدد_الألوان, لون_أساسي)
   متغير اللوحة = جديد لوحة("تلقائية")
   اللوحة.أضف("أساسي", لون_أساسي)
   
   متغير ي = 1
   بينما (ي < عدد_الألوان)
      متغير نسبة = ي / عدد_الألوان
      متغير جديد_لون = لون_أساسي.أفتح(نسبة * 0.7)
      اللوحة.أضف("تدرج_" + ي, جديد_لون)
      ي = ي + 1
   نهاية
   
   ارجع اللوحة
نهاية

