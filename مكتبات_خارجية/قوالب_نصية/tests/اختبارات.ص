# اختبارات مكتبة القوالب النصية
# ═══════════════════════════════════════

من مكتبات_خارجية.قوالب_نصية.src.مكتبة استورد استبدل, نسّق, كرر, اضم
من مكتبات_خارجية.قوالب_نصية.src.مكتبة استورد عنصر_html, عنصر_xml
من مكتبات_خارجية.قوالب_نصية.src.مكتبة استورد عنوان_md, عريض_md, مائل_md, رابط_md
من مكتبات_خارجية.قوالب_نصية.src.مكتبة استورد هروب_html, كرر_نص

اطبع_سطر("╔══════════════════════════════════════╗")
اطبع_سطر("║ اختبارات مكتبة القوالب النصية       ║")
اطبع_سطر("╚══════════════════════════════════════╝")

متغير _نجح = 0
متغير _فشل = 0

دالة _تحقق(الوصف, الشرط)
   إذا (الشرط)
      _نجح = _نجح + 1
      اطبع_سطر("  ✓ " + الوصف)
   وإلا
      _فشل = _فشل + 1
      اطبع_سطر("  ✗ " + الوصف)
   نهاية
نهاية

# ═══ الاستبدال ═══
اطبع_سطر("")
اطبع_سطر("── الاستبدال ──")
متغير نتيجة = استبدل("مرحبا {{اسم}}", "اسم", "أحمد")
_تحقق("استبدال بسيط", نتيجة == "مرحبا أحمد")

متغير نتيجة2 = استبدل("{{س}} + {{س}}", "س", "5")
_تحقق("استبدال متعدد لنفس المفتاح", نتيجة2 == "5 + 5")

# ═══ التنسيق ═══
اطبع_سطر("")
اطبع_سطر("── التنسيق ──")
متغير قالب = "{{اسم}} عمره {{عمر}}"
متغير بيانات = [["اسم", "سعيد"], ["عمر", "25"]]
متغير ناتج = نسّق(قالب, بيانات)
_تحقق("تنسيق متعدد", ناتج == "سعيد عمره 25")

# ═══ التكرار ═══
اطبع_سطر("")
اطبع_سطر("── التكرار ──")
متغير تكرار_ن = كرر("- {{عنصر}}", "عنصر", ["أ", "ب", "ج"])
_تحقق("التكرار يعمل", تكرار_ن != "")

# ═══ الضم ═══
اطبع_سطر("")
اطبع_سطر("── الضم ──")
_تحقق("ضم بفاصلة", اضم(["أ", "ب", "ج"], "، ") == "أ، ب، ج")
_تحقق("ضم بمسافة", اضم(["1", "2", "3"], " ") == "1 2 3")
_تحقق("عنصر واحد", اضم(["فقط"], "-") == "فقط")

# ═══ عناصر HTML ═══
اطبع_سطر("")
اطبع_سطر("── عناصر HTML ──")
_تحقق("عنصر p", عنصر_html("p", "نص") == "<p>نص</p>")
_تحقق("عنصر h1", عنصر_html("h1", "عنوان") == "<h1>عنوان</h1>")

# ═══ عنصر XML ═══
اطبع_سطر("")
اطبع_سطر("── XML ──")
_تحقق("عنصر XML", عنصر_xml("name", "أحمد") == "<name>أحمد</name>")

# ═══ Markdown ═══
اطبع_سطر("")
اطبع_سطر("── Markdown ──")
_تحقق("عنوان H1", عنوان_md(1, "عنوان") == "# عنوان")
_تحقق("عنوان H3", عنوان_md(3, "عنوان") == "### عنوان")
_تحقق("عريض", عريض_md("نص") == "**نص**")
_تحقق("مائل", مائل_md("نص") == "*نص*")
_تحقق("رابط MD", رابط_md("نص", "https://x.com") == "[نص](https://x.com)")

# ═══ هروب HTML ═══
اطبع_سطر("")
اطبع_سطر("── هروب HTML ──")
متغير هارب = هروب_html("<b>test</b>")
_تحقق("هروب HTML يعمل", هارب != "<b>test</b>")

# ═══ تكرار النص ═══
اطبع_سطر("")
اطبع_سطر("── تكرار النص ──")
_تحقق("تكرار 3 مرات", كرر_نص("ab", 3) == "ababab")
_تحقق("تكرار مرة واحدة", كرر_نص("x", 1) == "x")

# ═══ التقرير ═══
اطبع_سطر("")
اطبع_سطر("═══════════════════════════════")
اطبع_سطر("النتائج: " + _نجح + " نجح، " + _فشل + " فشل")
إذا (_فشل == 0)
   اطبع_سطر("✓ جميع الاختبارات ناجحة!")
وإلا
   اطبع_سطر("✗ بعض الاختبارات فشلت")
نهاية
اطبع_سطر("═══════════════════════════════")