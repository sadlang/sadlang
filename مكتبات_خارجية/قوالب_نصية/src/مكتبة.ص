## جدول HTML كامل من مصفوفة ثنائية
دالة جدول_html(الرؤوس, الصفوف)
   متغير النتيجة = "<table>\n<thead>\n<tr>\n"
   لكل رأس في الرؤوس
      النتيجة = النتيجة + "  <th>" + رأس + "</th>\n"
   نهاية
   النتيجة = النتيجة + "</tr>\n</thead>\n<tbody>\n"
   لكل صف في الصفوف
      النتيجة = النتيجة + "<tr>\n"
      لكل خلية في صف
         النتيجة = النتيجة + "  <td>" + خلية + "</td>\n"
      نهاية
      النتيجة = النتيجة + "</tr>\n"
   نهاية
   النتيجة = النتيجة + "</tbody>\n</table>"
   ارجع النتيجة
نهاية

