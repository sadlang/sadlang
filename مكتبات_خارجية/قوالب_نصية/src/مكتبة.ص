# تحويل هروب HTML
# ═══════════════════════════════════════════════════════════

دالة هروب_html(نص)
   متغير النتيجة = ""
   لكل حرف في نص
      إذا (حرف == "<")
         النتيجة = النتيجة + "&lt;"
      وإلا
         إذا (حرف == ">")
            النتيجة = النتيجة + "&gt;"
         وإلا
            إذا (حرف == "&")
               النتيجة = النتيجة + "&amp;"
            وإلا
               إذا (حرف == "\"")
                  النتيجة = النتيجة + "&quot;"
               وإلا
                  النتيجة = النتيجة + حرف
               نهاية
            نهاية
         نهاية
      نهاية
   نهاية
   ارجع النتيجة
نهاية

## تكرار نص عدة مرات
دالة كرر_نص(النص, العدد)
   متغير النتيجة = ""
   متغير ي = 0
   بينما (ي < العدد)
      النتيجة = النتيجة + النص
      ي = ي + 1
   نهاية
   ارجع النتيجة
نهاية

## محاذاة يمين بعرض معين
دالة محاذاة_يمين(النص, العرض, الحرف)
   متغير الطول = 0
   لكل _ في النص
      الطول = الطول + 1
   نهاية
   إذا (الطول >= العرض)
      ارجع النص
   نهاية
   ارجع كرر_نص(الحرف, العرض - الطول) + النص
نهاية

## محاذاة يسار بعرض معين
دالة محاذاة_يسار(النص, العرض, الحرف)
   متغير الطول = 0
   لكل _ في النص
      الطول = الطول + 1
   نهاية
   إذا (الطول >= العرض)
      ارجع النص
   نهاية
   ارجع النص + كرر_نص(الحرف, العرض - الطول)
نهاية

