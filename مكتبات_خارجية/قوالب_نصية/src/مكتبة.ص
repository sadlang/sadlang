دالة عنصر_xml(الوسم, المحتوى)
   ارجع "<" + الوسم + ">" + المحتوى + "</" + الوسم + ">"
نهاية

دالة عنصر_xml_مع_خصائص(الوسم, الخصائص, المحتوى)
   # الخصائص: مصفوفة [اسم, قيمة]
   متغير فتح = "<" + الوسم
   لكل خاصية في الخصائص
      فتح = فتح + " " + خاصية[0] + "=\"" + خاصية[1] + "\""
   نهاية
   فتح = فتح + ">"
   ارجع فتح + المحتوى + "</" + الوسم + ">"
نهاية

