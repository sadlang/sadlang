## استبدال بسيط: يستبدل {{مفتاح}} بالقيمة
دالة استبدل(قالب, المفتاح, القيمة)
   متغير النتيجة = ""
   متغير ط = 0
   متغير الأحرف = []
   لكل حرف في قالب
      الأحرف = الأحرف + [حرف]
   نهاية
   
   متغير ي = 0
   متغير الطول = 0
   لكل _ في الأحرف
      الطول = الطول + 1
   نهاية
   
   متغير العلامة = "{{" + المفتاح + "}}"
   متغير طول_العلامة = 0
   لكل _ في العلامة
      طول_العلامة = طول_العلامة + 1
   نهاية
   
   بينما (ي < الطول)
      # تحقق من وجود العلامة في الموضع الحالي
      متغير تطابق = صحيح
      متغير ك = 0
      متغير أحرف_العلامة = []
      لكل ح في العلامة
         أحرف_العلامة = أحرف_العلامة + [ح]
      نهاية
      
      لكل ح_علامة في أحرف_العلامة
         إذا (ي + ك < الطول)
            إذا (الأحرف[ي + ك] != ح_علامة)
               تطابق = خطأ
            نهاية
         وإلا
            تطابق = خطأ
         نهاية
         ك = ك + 1
      نهاية
      
      إذا (تطابق)
         النتيجة = النتيجة + القيمة
         ي = ي + طول_العلامة
      وإلا
         النتيجة = النتيجة + الأحرف[ي]
         ي = ي + 1
      نهاية
   نهاية
   
   ارجع النتيجة
نهاية

## تنسيق نص مع عدة استبدالات (قائمة من [مفتاح, قيمة])
دالة نسّق(قالب, الاستبدالات)
   متغير النتيجة = قالب
   لكل زوج في الاستبدالات
      النتيجة = استبدل(النتيجة, زوج[0], زوج[1])
   نهاية
   ارجع النتيجة
نهاية

## تكرار قالب لكل عنصر في قائمة
دالة كرر(قالب, المفتاح, القائمة)
   متغير النتيجة = ""
   لكل عنصر في القائمة
      النتيجة = النتيجة + استبدل(قالب, المفتاح, عنصر) + "\n"
   نهاية
   ارجع النتيجة
نهاية

## ضم مصفوفة نصوص بفاصل
دالة اضم(القائمة, الفاصل)
   متغير النتيجة = ""
   متغير أول = صحيح
   لكل عنصر في القائمة
      إذا (ليس أول)
         النتيجة = النتيجة + الفاصل
      نهاية
      النتيجة = النتيجة + عنصر
      أول = خطأ
   نهاية
   ارجع النتيجة
نهاية

## بناء سطر جدول
دالة سطر_جدول(الأعمدة, الفاصل)
   ارجع الفاصل + " " + اضم(الأعمدة, " " + الفاصل + " ") + " " + الفاصل
نهاية

