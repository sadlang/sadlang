## بناء كائن JSON من مصفوفة [مفتاح, قيمة]
دالة json_كائن(الأزواج)
   متغير النتيجة = "{\n"
   متغير أول = صحيح
   لكل زوج في الأزواج
      إذا (ليس أول)
         النتيجة = النتيجة + ",\n"
      نهاية
      النتيجة = النتيجة + "  \"" + زوج[0] + "\": \"" + زوج[1] + "\""
      أول = خطأ
   نهاية
   النتيجة = النتيجة + "\n}"
   ارجع النتيجة
نهاية

## بناء مصفوفة JSON
دالة json_مصفوفة(العناصر)
   متغير النتيجة = "["
   متغير أول = صحيح
   لكل عنصر في العناصر
      إذا (ليس أول)
         النتيجة = النتيجة + ", "
      نهاية
      النتيجة = النتيجة + "\"" + عنصر + "\""
      أول = خطأ
   نهاية
   النتيجة = النتيجة + "]"
   ارجع النتيجة
نهاية

