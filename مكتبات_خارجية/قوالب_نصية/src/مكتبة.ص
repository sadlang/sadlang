## عنوان Markdown
دالة عنوان_md(المستوى, النص)
   متغير رمز = ""
   متغير ي = 0
   بينما (ي < المستوى)
      رمز = رمز + "#"
      ي = ي + 1
   نهاية
   ارجع رمز + " " + النص
نهاية

