## جدول Markdown
دالة جدول_md(الرؤوس, الصفوف)
   متغير النتيجة = "| " + اضم(الرؤوس, " | ") + " |\n"
   # خط الفصل
   النتيجة = النتيجة + "|"
   لكل _ في الرؤوس
      النتيجة = النتيجة + " --- |"
   نهاية
   النتيجة = النتيجة + "\n"
   # الصفوف
   لكل صف في الصفوف
      النتيجة = النتيجة + "| " + اضم(صف, " | ") + " |\n"
   نهاية
   ارجع النتيجة
نهاية

