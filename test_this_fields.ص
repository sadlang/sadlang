## اختبار: هل التعليق على هذا في thin wrapper صحيح؟

صنف أ_م
    رقم ق_أ

    باني(رقم ق)
        هذا.ق_أ = ق
    نهاية
نهاية

صنف ب_م
    رقم ق_ب

    باني(رقم ق)
        هذا.ق_ب = ق
    نهاية
نهاية

صنف حاوية_م
    متغير الأ  ## كائن أ
    متغير الب  ## كائن ب
    رقم العدد

    باني(رقم عدد_م)
        هذا.العدد = عدد_م
        ## ينشئ جديد مرتين
        متغير أ_داخلي = جديد أ_م(10)
        هذا.الأ = أ_داخلي
        متغير ب_داخلي = جديد ب_م(20)
        هذا.الب = ب_داخلي
    نهاية

    دالة اجمع()
        ## thin wrapper
        ارجع هذا.الأ.ق_أ + هذا.الب.ق_ب + هذا.العدد
    نهاية
نهاية

متغير ح = جديد حاوية_م(5)
اطبع("ح.العدد = ")
اطبع_سطر(ح.العدد)
اطبع("ح.الأ.ق_أ = ")
اطبع_سطر(ح.الأ.ق_أ)
اطبع("ح.الب.ق_ب = ")
اطبع_سطر(ح.الب.ق_ب)
اطبع("ح.اجمع() = ")
اطبع_سطر(ح.اجمع())
