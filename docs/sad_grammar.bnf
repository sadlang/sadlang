# ═══════════════════════════════════════════════════════════════════════════
# قواعد لغة ص النحوية — صيغة BNF رسمية
# ═══════════════════════════════════════════════════════════════════════════
#
# المصدر: مستخرجة من المحلل النحوي (31 ملف C++ في shared/parser/)
# التاريخ: يونيو 2025
# الإصدار: 2.1 — مُدقق ومُحسّن بمقارنة مباشرة مع كود المحلل
#
# ═══════════════════════════════════════════════════════════════════════════
# الاصطلاحات:
#   →     يُنتِج
#   |     أو (بديل)
#   [ ]   اختياري (صفر أو واحد)
#   *     صفر أو أكثر
#   +     واحد أو أكثر
#   'x'   رمز حرفي
#   X     قاعدة غير طرفية
#   #     تعليق
#
#   ⚠️ = قاعدة مهمة أو تغيير حديث
#
# سلسلة الأولوية الكاملة (من الأعلى للأدنى — أعلى = يُنفَّذ أولاً):
#   pipeline → assignment → ternary → null_coalesce → logical_or →
#   logical_and → bitwise_or → bitwise_xor → bitwise_and → equality →
#   comparison (+ في) → range → term (+ - << >>) → factor (* / // %) →
#   unary (- ! ~ ++ -- &) → power (**) → postfix → primary
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════
#  1. بنية البرنامج
# ═══════════════════════════════════════════════════

program
    → declaration* EOF

declaration
    → directive_stmt
    | decorator_list (function_decl | class_decl)
    | import_stmt
    | from_import_stmt
    | export_decl
    | extern_func_decl
    | function_decl
    | generator_func_decl
    | class_decl
    | struct_decl
    | enum_decl
    | trait_decl
    | impl_decl
    | extension_decl
    | template_decl
    | namespace_decl
    | macro_decl
    | contract_decl
    | type_alias_decl
    | test_decl
    | switch_stmt
    | var_decl
    | statement

block
    → statement* 'نهاية'

# ═══════════════════════════════════════════════════
#  2. التصريحات
# ═══════════════════════════════════════════════════

# ─── 2.1 الدوال ──────────────────────────────────

function_decl
    → decorator_list 'دالة' [return_type] IDENTIFIER
      [lifetime_params] '(' [param_list] ')'
      [contract_clause*]
      [where_clause]
      block

async_function_decl
    → 'دالة' 'غير_متزامن' [return_type] IDENTIFIER
      '(' [param_list] ')' block

generator_func_decl
    → 'مولد' 'دالة' [return_type] IDENTIFIER
      '(' [param_list] ')' block

main_func_decl
    → 'دالة' ['رقم'] 'رئيسية' '(' [main_params] ')' block

main_params
    → 'نص' '[]' IDENTIFIER

extern_func_decl
    → 'خارجي' [linkage] 'دالة' [type] IDENTIFIER '(' [param_list] ')'

linkage
    → '(' STRING ')'

return_type
    → type_token

param_list
    → parameter (COMMA parameter)*

parameter
    → [type] IDENTIFIER ['=' expression]
    | '...' IDENTIFIER

contract_clause
    → 'يتطلب' expression [SEMICOLON]
    | 'يضمن' expression [SEMICOLON]
    | 'ثابت' expression [SEMICOLON]
    | 'يفترض' expression [SEMICOLON]
    | 'يؤكد' expression [SEMICOLON]

where_clause
    → 'حيث' constraint (COMMA constraint)*

constraint
    → IDENTIFIER ':' trait_name ('+' trait_name)*

lifetime_params
    → '<' LIFETIME (COMMA LIFETIME)* '>'

LIFETIME
    → "'" IDENTIFIER
    | "'ثابت"
    | "'_"

decorator_list
    → ('@' expression)*

# ─── 2.2 المتغيرات والثوابت ─────────────────────

var_decl
    → 'متغير' IDENTIFIER ['=' expression] [SEMICOLON]
    | 'ثابت' IDENTIFIER '=' expression [SEMICOLON]
    | type IDENTIFIER ['=' expression] [SEMICOLON]
    | IDENTIFIER IDENTIFIER ['=' expression] [SEMICOLON]

# ─── 2.3 الأصناف (الصفة بعد الموصوف) ────────────

# ⚠️ المعدلات (مجرد، محكم) تأتي بعد 'صنف' — قاعدة الصفة بعد الموصوف
class_decl
    → 'صنف' ['مجرد'] ['محكم'] IDENTIFIER
      ['يرث' IDENTIFIER (COMMA IDENTIFIER)*]
      [('نفّذ' | 'نفذ') IDENTIFIER (COMMA IDENTIFIER)*]
      class_body

class_body
    → class_member* 'نهاية'

class_member
    → field_decl
    | method_decl
    | constructor_decl
    | destructor_decl
    | property_decl
    | operator_decl
    | const_member_decl
    | nested_class_decl

# ⚠️ جميع المعدلات (عام/خاص/محمي/ساكن/مجرد) تأتي بعد الكلمة المفتاحية
field_decl
    → 'متغير' [access_mod] ['ساكن'] [type] IDENTIFIER ['=' expression] [SEMICOLON]
    | type [access_mod] IDENTIFIER ['=' expression] [SEMICOLON]

method_decl
    → 'دالة' [access_mod] ['ساكن'] ['مجرد']
      ['غير_متزامن' | 'غير_متزامنة']
      [return_type] IDENTIFIER
      '(' [param_list] ')'
      [contract_clause*]
      [where_clause]
      block

constructor_decl
    → 'باني' [access_mod] '(' [ctor_params] ')'
      [':' 'الأساس' '(' [arg_list] ')']
      block

destructor_decl
    → 'هدم' [access_mod] '(' ')' block

property_decl
    → 'خاصية' [access_mod] ['ساكن'] [type] IDENTIFIER
      getter_block
      [setter_block]
      'نهاية'

getter_block
    → ('احصل' | KEYWORD_GET) statement* 'نهاية'

setter_block
    → ('عيّن' | 'عين' | KEYWORD_SET) ['(' IDENTIFIER ')'] statement* 'نهاية'

operator_decl
    → 'عامل' [access_mod] operator_symbol '(' [param_list] ')' block

const_member_decl
    → 'ثابت' [access_mod] IDENTIFIER '=' expression
      (COMMA IDENTIFIER '=' expression)* [SEMICOLON]

access_mod
    → 'عام'
    | 'خاص'
    | 'محمي'

ctor_params
    → ctor_param (COMMA ctor_param)*

ctor_param
    → 'هذا' '.' IDENTIFIER ['=' expression]
    | [type] IDENTIFIER ['=' expression]

operator_symbol
    → '+' | '-' | '*' | '/' | '%' | '**'
    | '==' | '!=' | '<' | '>' | '<=' | '>='
    | '[]' | '[]='
    | '()' | '()'
    | 'في'

# ─── 2.4 البنى ──────────────────────────────────

struct_decl
    → 'بنية' IDENTIFIER struct_body

struct_body
    → struct_member* 'نهاية'

struct_member
    → struct_field
    | struct_method
    | struct_constructor

struct_field
    → 'متغير' [access_mod] [type] IDENTIFIER ['=' expression] [SEMICOLON]
    | type IDENTIFIER ['=' expression] [SEMICOLON]

struct_method
    → 'دالة' [access_mod] ['ساكن'] [return_type] IDENTIFIER
      '(' [param_list] ')' block

struct_constructor
    → 'باني' [access_mod] '(' [ctor_params] ')' block

# ─── 2.5 التعدادات ──────────────────────────────

enum_decl
    → 'تعداد' IDENTIFIER enum_body

enum_body
    → enum_variant* 'نهاية'

enum_variant
    → IDENTIFIER ['(' type_list ')'] ['=' expression] [COMMA]

type_list
    → type (COMMA type)*

# ─── 2.6 السمات والتنفيذ ────────────────────────

trait_decl
    → 'سمة' IDENTIFIER trait_body

trait_body
    → (method_signature | method_decl)* 'نهاية'

method_signature
    → 'دالة' [return_type] IDENTIFIER '(' [param_list] ')' [SEMICOLON]

impl_decl
    → ('نفّذ' | 'نفذ') IDENTIFIER ['لـ' IDENTIFIER] impl_body

impl_body
    → method_decl* 'نهاية'

extension_decl
    → 'امتداد' IDENTIFIER extension_body

extension_body
    → method_decl* 'نهاية'

# ─── 2.7 الماكروز ───────────────────────────────

macro_decl
    → 'ماكرو' IDENTIFIER '(' [macro_params] ')' block

macro_params
    → macro_param (COMMA macro_param)*

macro_param
    → IDENTIFIER
    | '...' IDENTIFIER

macro_call
    → IDENTIFIER '!' '(' [arg_list] ')'

# ─── 2.8 القوالب ────────────────────────────────

template_decl
    → 'قالب' '<' template_params '>' (function_decl | class_decl)

template_params
    → type_param (COMMA type_param)*

type_param
    → 'نوع' IDENTIFIER [':' constraint]

# ─── 2.9 فضاء الأسماء ───────────────────────────

namespace_decl
    → 'فضاء' IDENTIFIER declaration* 'نهاية_فضاء'

# ─── 2.10 العقود الذكية ─────────────────────────

contract_decl
    → 'عقد' IDENTIFIER ['يرث' IDENTIFIER] class_body

# ─── 2.11 أسماء الأنواع المستعارة ───────────────

type_alias_decl
    → 'نوع' IDENTIFIER '=' expression

# ─── 2.12 الاختبارات ────────────────────────────

test_decl
    → 'اختبر' '(' STRING ')' ['تكرارات' NUMBER] ['بذرة' NUMBER] block

# ═══════════════════════════════════════════════════
#  3. الاستيراد والتصدير
# ═══════════════════════════════════════════════════

import_stmt
    → 'استورد' module_path ['كـ' IDENTIFIER]
    | 'استورد' '*' 'من' module_path
    | 'استورد' import_items 'من' module_path
    | 'استورد' STRING ['كـ' IDENTIFIER]

from_import_stmt
    → 'من' module_path 'استورد' import_items
    | 'من' module_path 'استورد' '*'

module_path
    → IDENTIFIER ('.' IDENTIFIER)*
    | '.' IDENTIFIER ('.' IDENTIFIER)*
    | '..' IDENTIFIER ('.' IDENTIFIER)*
    | STRING

import_items
    → import_item (COMMA import_item)*

import_item
    → IDENTIFIER ['كـ' IDENTIFIER]

export_decl
    → 'صدّر' '*' 'من' module_path
    | 'صدّر' export_items 'من' module_path
    | 'صدّر' IDENTIFIER '=' expression
    | 'صدّر' declaration

export_items
    → export_item (COMMA export_item)*

export_item
    → IDENTIFIER ['كـ' IDENTIFIER]

# ═══════════════════════════════════════════════════
#  4. الجمل (Statements)
# ═══════════════════════════════════════════════════

statement
    → expression_stmt
    | if_stmt
    | while_stmt
    | for_stmt
    | return_stmt
    | yield_stmt
    | break_stmt
    | continue_stmt
    | try_stmt
    | throw_stmt
    | match_stmt
    | defer_stmt
    | launch_stmt
    | select_stmt
    | using_stmt
    | var_decl

expression_stmt
    → expression [SEMICOLON]

# ─── 4.1 الشرط ──────────────────────────────────

if_stmt
    → ('إذا' | 'اذا') '(' expression ')' block
      [('وإلا' | 'والا') (if_stmt | block)]

# ─── 4.2 الحلقات ────────────────────────────────

while_stmt
    → 'بينما' '(' expression ')' block

for_stmt
    → 'لكل' loop_var [COMMA loop_var]
      ('في' expression | 'من' expression ('الى' | 'إلى') expression)
      block

loop_var
    → IDENTIFIER | type_token | keyword_as_name

break_stmt
    → 'توقف' [SEMICOLON]

continue_stmt
    → 'استمر' [SEMICOLON]

# ─── 4.3 الإرجاع ────────────────────────────────

return_stmt
    → 'ارجع' [expression] [SEMICOLON]

yield_stmt
    → 'أنتج' [expression] [SEMICOLON]
    | 'أنتج' 'من' expression [SEMICOLON]

# ─── 4.4 معالجة الأخطاء ─────────────────────────

try_stmt
    → 'حاول' block
      ('امسك' IDENTIFIER block)*
      ['أخيراً' block]

throw_stmt
    → 'ارمي' expression [SEMICOLON]

# ─── 4.5 مطابقة الأنماط ─────────────────────────

match_stmt
    → 'طابق' '(' expression ')'
      match_case*
      ['افتراضي' ':' block]
      'نهاية'

match_case
    → 'عندما' pattern [guard] ':' block

guard
    → 'إذا' expression

pattern
    → literal_pattern
    | wildcard_pattern
    | variable_pattern
    | range_pattern
    | list_pattern
    | struct_pattern
    | or_pattern
    | bind_pattern
    | enum_pattern

literal_pattern
    → NUMBER | STRING | 'صحيح' | 'خطأ' | 'لاشيء'
    | '-' NUMBER

wildcard_pattern
    → '_'

variable_pattern
    → IDENTIFIER

range_pattern
    → NUMBER '..' NUMBER
    | NUMBER '..=' NUMBER

list_pattern
    → '[' ']'
    | '[' pattern (COMMA pattern)* [COMMA '*' IDENTIFIER] ']'

struct_pattern
    → '{' struct_field_pattern (COMMA struct_field_pattern)* '}'

struct_field_pattern
    → IDENTIFIER ':' pattern
    | IDENTIFIER
    | '..' IDENTIFIER

or_pattern
    → pattern ('||' pattern)+

bind_pattern
    → IDENTIFIER '@' pattern

enum_pattern
    → IDENTIFIER '.' IDENTIFIER ['(' pattern (COMMA pattern)* ')']

# ─── 4.6 التأجيل (LIFO — الأخير يُنفَّذ أولاً) ─

defer_stmt
    → 'أجّل' statement
    | 'أجّل' block

# ─── 4.7 الخيوط الخفيفة (Goroutines) ────────────

launch_stmt
    → ('أطلق' | 'اطلق') expression
    | ('أطلق' | 'اطلق') block

# ─── 4.8 الاختيار من القنوات ─────────────────────

select_stmt
    → 'اختر'
      select_case*
      ['افتراضي' ':' block]
      'نهاية'

select_case
    → 'عندما' expression ':' block

# ─── 4.9 مدير السياق ────────────────────────────

using_stmt
    → 'باستخدام' var_decl block

# ─── 4.10 جملة الحالة (Switch) ──────────────────

switch_stmt
    → 'حالة' IDENTIFIER block

# ═══════════════════════════════════════════════════
#  5. التعبيرات (Expressions) — حسب الأولوية
# ═══════════════════════════════════════════════════

# سلسلة الأولوية (الأعلى يُحلل أولاً):
#   pipeline > assignment > ternary > null_coalesce >
#   logical_or > logical_and > bitwise_or > bitwise_xor > bitwise_and >
#   equality > comparison > range > term > factor > unary > power >
#   postfix > primary

expression
    → pipeline

# ─── 5.1 عامل الأنبوب (|>) ─────────────────────
# إزالة السكر النحوي:
#   a |> f       →  f(a)
#   a |> f(b, c) →  f(a, b, c)
#   a |> f |> g  →  g(f(a))

pipeline
    → assignment ('|>' assignment)*

# ─── 5.2 الإسناد ────────────────────────────────

assignment
    → assign_target '=' assignment
    | assign_target '+=' assignment
    | assign_target '-=' assignment
    | assign_target '*=' assignment
    | assign_target '/=' assignment
    | assign_target '//=' assignment
    | assign_target '%=' assignment
    | IDENTIFIER ':=' assignment
    | ternary

assign_target
    → IDENTIFIER
    | postfix '.' IDENTIFIER
    | postfix '[' expression ']'

# ─── 5.3 العامل الثلاثي ─────────────────────────
# ربط يميني: a ? b : c ? d : e → a ? b : (c ? d : e)

ternary
    → null_coalesce '?' expression ':' ternary
    | null_coalesce

# ─── 5.4 تجميع القيمة الفارغة (??) ─────────────
# ⚠️ عامل جديد: تعبير1 ?? تعبير2
# يُرجع تعبير1 إذا لم يكن لاشيء ، وإلا يُرجع تعبير2

null_coalesce
    → logical_or ('??' logical_or)*

# ─── 5.5 العوامل المنطقية ───────────────────────

logical_or
    → logical_and (('||' | 'أو') logical_and)*

logical_and
    → bitwise_or (('&&' | 'و') bitwise_or)*

# ─── 5.6 العوامل البتّية ────────────────────────

bitwise_or
    → bitwise_xor ('|' bitwise_xor)*

bitwise_xor
    → bitwise_and ('^' bitwise_and)*

bitwise_and
    → equality ('&' equality)*

# ─── 5.7 المساواة ───────────────────────────────

equality
    → comparison (('==' | '!=') comparison)*

# ─── 5.8 المقارنة والعضوية ──────────────────────
# ⚠️ 'في' (membership) في نفس مستوى المقارنة وليس مستوى منفصل

comparison
    → range (('<' | '>' | '<=' | '>=' | 'في') range)*

# ─── 5.9 النطاق ─────────────────────────────────
# يدعم مدى مفتوح: 1.. (بدون نهاية)

range
    → term '..' [term]
    | term

# ─── 5.10 الجمع والطرح والإزاحة ─────────────────
# ⚠️ إزاحة البت (<< >>) في نفس مستوى الجمع/الطرح

term
    → factor (('+' | '-') factor)*
      (('<<' | '>>') factor)*

# ─── 5.11 الضرب والقسمة ─────────────────────────
# ⚠️ يدعم القسمة الصحيحة '//' بالإضافة لـ '/'

factor
    → unary (('*' | '/' | '//' | '%') unary)*

# ─── 5.12 العوامل الأحادية ──────────────────────

unary
    → ('-' | '!' | 'ليس' | '~' | '++' | '--') unary
    | borrow_expr
    | power

# ⚠️ الاستعارة: &متغير أو &متغير_قابل_للتعديل مع عمر اختياري
borrow_expr
    → '&' [LIFETIME] ['متغير'] IDENTIFIER

# ─── 5.13 الأُس ─────────────────────────────────
# ربط يميني: 2**3**4 → 2**(3**4)

power
    → postfix ('**' power)?

# ─── 5.14 العوامل البعدية ───────────────────────

postfix
    → primary postfix_op*

postfix_op
    → '(' [arg_list] ')'                                      # استدعاء دالة
    | '[' expression ']'                                       # فهرسة
    | '[' [expression] ':' [expression] [':' expression] ']'   # شريحة
    | '.' IDENTIFIER                                           # وصول عضو
    | '.' NUMBER                                               # وصول صف بالفهرس
    | '?.' IDENTIFIER                                          # وصول آمن (optional chaining)
    | '?[' expression ']'                                      # فهرسة آمنة
    | '++' | '--'                                              # زيادة/نقصان بعدي
    | '!' '(' [arg_list] ')'                                   # استدعاء ماكرو

# ─── 5.15 التعبيرات الأولية ─────────────────────

primary
    → NUMBER_INTEGER | NUMBER_DOUBLE
    | STRING_LITERAL | STRING_RAW | STRING_FSTRING
    | 'صحيح' | 'خطأ' | 'لاشيء'
    | IDENTIFIER
    | 'جديد' IDENTIFIER ['<' type_args '>'] '(' [arg_list] ')'
    | 'هذا'
    | 'الأساس'
    | 'انتظر' expression
    | 'انشر' expression
    | 'لامدا' lambda_expr
    | '@' directive_expr
    | grouping_or_tuple
    | arrow_func
    | array_literal
    | map_literal
    | abs_expr
    | type_keyword '(' [arg_list] ')'
    | IDENTIFIER '<' type_args '>'

# ─── 5.16 الأقواس والصفوف والدوال السهمية ───────

# ⚠️ التمييز بين التجميع والصف (Tuple):
#   ()              → صف فارغ
#   (expr)          → تعبير عادي (أو معامل دالة سهمية إذا تلاه =>)
#   (expr,)         → صف بعنصر واحد
#   (expr, expr)    → صف بعنصرين أو أكثر

grouping_or_tuple
    → '(' ')'                                                  # صف فارغ
    | '(' expression ')'                                       # تعبير مُجمَّع
    | '(' expression COMMA ')'                                 # صف بعنصر واحد
    | '(' expression (COMMA expression)+ [COMMA] ')'           # صف متعدد

arrow_func
    → '(' expression ')' '=>' expression

# ─── 5.17 المصفوفات ─────────────────────────────

array_literal
    → '[' ']'
    | '[' array_items ']'

array_items
    → expression (COMMA expression)* [COMMA]
    | expression 'لكل' IDENTIFIER 'في' expression ['إذا' expression]

# ─── 5.18 الخرائط ───────────────────────────────
# ⚠️ يدعم: خرائط عادية، dict comprehension، set comprehension، spread

map_literal
    → '{' '}'                                                  # خريطة فارغة
    | '{' map_entries '}'                                      # خريطة عادية
    | '{' dict_comprehension '}'                               # dict comprehension
    | '{' set_comprehension '}'                                # set comprehension
    | '{' spread_map '}'                                       # خريطة تبدأ بـ spread

map_entries
    → map_entry (COMMA map_entry)* [COMMA]

map_entry
    → expression (':' | '=') expression
    | '...' expression                                         # spread في خريطة

dict_comprehension
    → expression ':' expression 'لكل' IDENTIFIER 'في' expression ['إذا' expression]

set_comprehension
    → expression 'لكل' IDENTIFIER 'في' expression ['إذا' expression]

spread_map
    → '...' expression (COMMA (map_entry | '...' expression))* [COMMA]

# ─── 5.19 القيمة المطلقة ────────────────────────

abs_expr
    → '|' expression '|'

# ─── 5.20 اللامدا ───────────────────────────────

lambda_expr
    → '(' [param_list] ')' '=>' expression                     # سهمية مع تعبير
    | '(' [param_list] ')' '=>' block                           # سهمية مع كتلة
    | '(' [param_list] ')' block                                # بلا فاصل

arg_list
    → expression (COMMA expression)*

# ═══════════════════════════════════════════════════
#  6. التوجيهات (@)
# ═══════════════════════════════════════════════════

directive_stmt
    → '@حجم' '(' type ')'
    | '@ذري' '(' atomic_op COMMA expression [COMMA expression] ')'
    | '@غير_آمن' block
    | '@وقت_الترجمة' block
    | '@متطاير' var_decl
    | '@تجميع' '(' STRING ')'

atomic_op
    → 'تحميل' | 'تخزين' | 'مبادلة'
    | 'جمع' | 'طرح' | 'مقارنة_ومبادلة'

# ═══════════════════════════════════════════════════
#  7. التجميع المُدمج
# ═══════════════════════════════════════════════════

asm_expr
    → 'تجميع!' '(' STRING
      [':' asm_operands]
      [':' asm_operands]
      [':' clobber_list]
      [':' option_list]
      ')'

asm_operands
    → asm_operand (COMMA asm_operand)*

asm_operand
    → ['=' | '+'] register_class '(' expression ')'

register_class
    → 'r' | 'a' | 'b' | 'c' | 'd' | 'S' | 'D'
    | 'm' | 'o' | 'i' | 'f' | 'x' | 'y'

clobber_list
    → STRING (SEMICOLON STRING)*

option_list
    → STRING (SEMICOLON STRING)*

# ═══════════════════════════════════════════════════
#  8. واجهة المستخدم التصريحية
# ═══════════════════════════════════════════════════

ui_element
    → component_name ui_property* ui_element* 'نهاية'

component_name
    → 'نص' | 'صورة' | 'أيقونة'
    | 'زر' | 'حقل_نص' | 'منطقة_نص' | 'تبديل' | 'منزلق'
    | 'منتقي' | 'منتقي_تاريخ' | 'منتقي_لون'
    | 'عمود' | 'صف' | 'رصة' | 'شبكة'
    | 'عمود_كسول' | 'صف_كسول' | 'شبكة_كسولة'
    | 'فاصل' | 'فاصل_خط'
    | 'حاوية' | 'بطاقة' | 'سطح' | 'هيكل' | 'صندوق'
    | 'عرض_تنقل' | 'رابط_تنقل' | 'عرض_أقسام' | 'قسم'
    | 'قائمة' | 'قسم_قائمة' | 'لكل'
    | 'تنبيه' | 'ورقة' | 'حوار' | 'قائمة_خيارات'
    | 'لوحة' | 'خريطة' | 'عرض_ويب' | 'مشغل_فيديو'
    | 'منشئ_واجهة' | 'واجهة_مخصصة' | 'مجموعة'

ui_property
    → IDENTIFIER '=' property_value

property_value
    → STRING | NUMBER | 'صحيح' | 'خطأ'
    | '@' expression
    | '!!' expression
    | lambda_expr

# ═══════════════════════════════════════════════════
#  9. أنماط الماكرو المتقدمة
# ═══════════════════════════════════════════════════

macro_pattern
    → pattern_element+

pattern_element
    → STRING
    | meta_variable
    | repetition_element

meta_variable
    → '$' IDENTIFIER ':' fragment_kind
    | '$' IDENTIFIER

fragment_kind
    → 'عبر' | 'expr'
    | 'قيمة' | 'lit'
    | 'نوع' | 'ty'
    | 'كتلة' | 'block'
    | 'معرّف' | 'ident'
    | 'رمز' | 'tt'
    | 'مسار' | 'path'
    | 'نمط' | 'pat'
    | 'جملة' | 'stmt'
    | 'عنصر' | 'item'

repetition_element
    → '$' '(' pattern ')' repetition_op [separator]

repetition_op
    → '*' | '+' | '?' | '؟'

separator
    → ',' | '،' | ';' | '؛'

# ═══════════════════════════════════════════════════
#  10. الأنواع
# ═══════════════════════════════════════════════════

type
    → 'رقم'
    | 'عشري'
    | 'نص'
    | 'منطقي'
    | 'فراغ'
    | 'عدم'
    | 'مصفوفة'
    | 'خريطة'
    | 'أي'
    | IDENTIFIER

type_token
    → type

type_args
    → type (COMMA type)*

# ═══════════════════════════════════════════════════
#  11. الرموز المساعدة
# ═══════════════════════════════════════════════════

COMMA
    → ',' | '،'

SEMICOLON
    → ';' | '؛'

IDENTIFIER
    → [أ-ي a-z A-Z _] [أ-ي a-z A-Z 0-9 _]*

NUMBER_INTEGER
    → [0-9]+
    | '0x' [0-9a-fA-F]+
    | '0b' [01]+
    | '0o' [0-7]+

NUMBER_DOUBLE
    → [0-9]+ '.' [0-9]+ (['e' | 'E'] ['+' | '-']? [0-9]+)?

STRING_LITERAL
    → '"' [^"]* '"'
    | "'" [^']* "'"

STRING_RAW
    → 'r"' [^"]* '"'

STRING_FSTRING
    → 'f"' (text | '{' expression '}')* '"'

# ═══════════════════════════════════════════════════
#  12. جدول العوامل (حسب الأولوية: الأعلى أولاً)
# ═══════════════════════════════════════════════════

# المستوى | العوامل                  | الربط    | الوصف
# ────────|────────────────────────|──────── |──────────────
#  1      | |>                      | يساري   | الأنبوب
#  2      | = += -= *= /= //= %=   | يميني   | الإسناد
#  2      | :=                      | يميني   | Walrus (إسناد داخل تعبير)
#  3      | ? :                     | يميني   | ثلاثي شرطي
#  4      | ??                      | يساري   | تجميع الفارغ
#  5      | || أو                   | يساري   | OR منطقي
#  6      | && و                    | يساري   | AND منطقي
#  7      | |                       | يساري   | OR بتّي
#  8      | ^                       | يساري   | XOR بتّي
#  9      | &                       | يساري   | AND بتّي
# 10      | == !=                   | يساري   | مساواة
# 11      | < > <= >= في            | يساري   | مقارنة + عضوية
# 12      | ..                      | —       | نطاق
# 13      | + - << >>               | يساري   | جمع/طرح/إزاحة
# 14      | * / // %                | يساري   | ضرب/قسمة/باقي
# 15      | - ! ليس ~ ++ -- &       | أحادي   | أحادي (بادئة)
# 16      | **                      | يميني   | أُس
# 17      | () [] . ?. ?[ ++ --     | يساري   | بعدية (لاحقة)

# ═══════════════════════════════════════════════════
#  13. الكلمات المحجوزة (40)
# ═══════════════════════════════════════════════════

# دالة  ارجع  صنف  بنية  تعداد  يرث  نهاية  جديد  هذا  باني  الأساس
# إذا  وإلا  بينما  لكل  في  توقف  استمر
# طابق  عندما  افتراضي
# حاول  امسك  ارمي  أخيراً
# عام  خاص  محمي  مجرد
# استورد  من  كـ  صدّر
# متغير  ثابت  ساكن  خارجي
# صحيح  خطأ  لاشيء

# ═══════════════════════════════════════════════════
#  14. الكلمات السياقية (~25)
# ═══════════════════════════════════════════════════

# غير_متزامن  انتظر  لامدا  أنتج  مولد  باستخدام
# سمة  نفّذ/نفذ  امتداد  قالب  فضاء  نهاية_فضاء
# خاصية  احصل  عيّن  هدم  عامل  رئيسية
# ماكرو  أجّل  أطلق/اطلق  اختر  اختبر
# يتطلب  يضمن  حيث  عقد  نوع  محكم  حالة  انشر

# ═══════════════════════════════════════════════════
#  15. العوامل المنطقية العربية (3)
# ═══════════════════════════════════════════════════

# و   ← معادل &&
# أو  ← معادل ||
# ليس ← معادل !

# ═══════════════════════════════════════════════════
#  نهاية الملف
# ═══════════════════════════════════════════════════
