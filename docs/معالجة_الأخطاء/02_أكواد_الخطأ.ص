# ===================================================
# 02 - أكواد الخطأ
# استخدام قيم إرجاع خاصة للإشارة إلى الأخطاء
# ===================================================

# --- مثال 1: دالة تُرجع -1 عند الخطأ ---
دالة رقم جد_الفرق(أ، ب)
    إذا (أ < ب)
        اطبع_سطر("خطأ: العدد الأول أصغر من الثاني")
        ارجع -1
    وإلا
        متغير فرق = أ - ب
        ارجع فرق
    نهاية
نهاية

# --- مثال 2: كود النجاح 1 والفشل 0 ---
دالة تحقق_زوجي(ع)
    متغير باقي = ع % 2
    إذا (باقي == 0)
        ارجع 1
    وإلا
        ارجع 0
    نهاية
نهاية

# --- مثال 3: أكواد خطأ متعددة ---
دالة رقم تحقق_نطاق_حرارة(درجة)
    إذا (درجة < -50)
        ارجع -2
    والا_اذا (درجة > 60)
        ارجع -1
    وإلا
        ارجع 0
    نهاية
نهاية

دالة اطبع_حالة_حرارة(كود)
    إذا (كود == 0)
        اطبع_سطر("الحرارة ضمن النطاق الطبيعي")
    والا_اذا (كود == -1)
        اطبع_سطر("خطأ: الحرارة مرتفعة جداً")
    والا_اذا (كود == -2)
        اطبع_سطر("خطأ: الحرارة منخفضة جداً")
    وإلا
        اطبع_سطر("كود خطأ غير معروف")
    نهاية
نهاية

# --- مثال 4: التحقق من كود خطأ واستخدام النتيجة ---
دالة معالج_فرق(أ، ب)
    متغير نتيجة = جد_الفرق(أ، ب)
    إذا (نتيجة == -1)
        اطبع_سطر("لم تتم العملية بسبب خطأ")
    وإلا
        اطبع_سطر("الفرق هو: " + نتيجة)
    نهاية
نهاية

# --- مثال 5: كود خطأ للقسمة ---
دالة رقم قسمة_بكود(أ، ب)
    إذا (ب == 0)
        ارجع -9999
    وإلا
        متغير ناتج = أ / ب
        ارجع ناتج
    نهاية
نهاية

# --- مثال 6: تسلسل التحقق ---
دالة سلسلة_تحقق(ع)
    متغير كود1 = تحقق_زوجي(ع)
    إذا (كود1 == 0)
        اطبع_سطر("العدد " + ع + " فردي")
    وإلا
        اطبع_سطر("العدد " + ع + " زوجي")
    نهاية
نهاية

# --- مثال 7: كود خطأ مع رسالة ---
دالة رقم احسب_نسبة(جزء، كل)
    إذا (كل == 0)
        اطبع_سطر("خطأ كود -1: المقام صفر")
        ارجع -1
    والا_اذا (جزء < 0)
        اطبع_سطر("خطأ كود -2: الجزء سالب")
        ارجع -2
    والا_اذا (جزء > كل)
        اطبع_سطر("خطأ كود -3: الجزء أكبر من الكل")
        ارجع -3
    وإلا
        متغير ناتج = جزء * 100 / كل
        ارجع ناتج
    نهاية
نهاية

# --- مثال 8: تجميع أكواد الأخطاء ---
دالة تقرير_أخطاء(ك1، ك2، ك3)
    متغير عدد = 0
    إذا (ك1 != 0)
        متغير عدد2 = عدد + 1
        اطبع_سطر("خطأ في العملية الأولى، كود: " + ك1)
    وإلا
        متغير عدد2 = عدد
    نهاية
    إذا (ك2 != 0)
        متغير عدد3 = عدد2 + 1
        اطبع_سطر("خطأ في العملية الثانية، كود: " + ك2)
    وإلا
        متغير عدد3 = عدد2
    نهاية
    إذا (ك3 != 0)
        متغير عدد4 = عدد3 + 1
        اطبع_سطر("خطأ في العملية الثالثة، كود: " + ك3)
    وإلا
        متغير عدد4 = عدد3
    نهاية
    اطبع_سطر("إجمالي الأخطاء: " + عدد4)
نهاية

# --- الدالة الرئيسية ---
دالة رئيسية()
    اطبع_سطر("=== أكواد الخطأ ===")

    اطبع_سطر("--- مثال 1: دالة الفرق ---")
    متغير ف1 = جد_الفرق(10، 3)
    اطبع_سطر("الفرق: " + ف1)
    متغير ف2 = جد_الفرق(3، 10)
    اطبع_سطر("الفرق: " + ف2)

    اطبع_سطر("--- مثال 2: التحقق من الزوجية ---")
    متغير ز1 = تحقق_زوجي(4)
    اطبع_سطر("هل 4 زوجي؟ " + ز1)
    متغير ز2 = تحقق_زوجي(7)
    اطبع_سطر("هل 7 زوجي؟ " + ز2)

    اطبع_سطر("--- مثال 3: نطاق الحرارة ---")
    متغير ح1 = تحقق_نطاق_حرارة(25)
    اطبع_حالة_حرارة(ح1)
    متغير ح2 = تحقق_نطاق_حرارة(70)
    اطبع_حالة_حرارة(ح2)
    متغير ح3 = تحقق_نطاق_حرارة(-60)
    اطبع_حالة_حرارة(ح3)

    اطبع_سطر("--- مثال 4: معالجة نتيجة الفرق ---")
    معالج_فرق(20، 5)
    معالج_فرق(5، 20)

    اطبع_سطر("--- مثال 5: القسمة بكود خطأ ---")
    متغير ق1 = قسمة_بكود(20، 4)
    اطبع_سطر("ناتج القسمة: " + ق1)
    متغير ق2 = قسمة_بكود(20، 0)
    اطبع_سطر("ناتج القسمة: " + ق2)

    اطبع_سطر("--- مثال 6: سلسلة التحقق ---")
    سلسلة_تحقق(8)
    سلسلة_تحقق(15)

    اطبع_سطر("--- مثال 7: حساب النسبة ---")
    متغير ن1 = احسب_نسبة(75، 100)
    اطبع_سطر("النسبة: " + ن1)
    متغير ن2 = احسب_نسبة(50، 0)
    اطبع_سطر("النسبة: " + ن2)

    اطبع_سطر("--- مثال 8: تقرير الأخطاء ---")
    تقرير_أخطاء(0، -1، -2)

    اطبع_سطر("=== انتهى ===")
نهاية
