# ===================================================
# 07 - كائن النتيجة
# نمط تغليف النجاح والفشل في كائن واحد
# ===================================================

# --- مثال 1: صنف النتيجة الأساسي ---
صنف نتيجة_عملية
    باني(نجاح_قيمة، كود_قيمة، رسالة_قيمة)
        هذا.نجاح = نجاح_قيمة
        هذا.كود = كود_قيمة
        هذا.رسالة = رسالة_قيمة
    نهاية

    دالة اطبع_النتيجة()
        إذا (هذا.نجاح == 1)
            اطبع_سطر("نجاح [" + هذا.كود + "]: " + هذا.رسالة)
        وإلا
            اطبع_سطر("فشل [" + هذا.كود + "]: " + هذا.رسالة)
        نهاية
    نهاية
نهاية

# --- مثال 2: قسمة تُرجع كائن نتيجة ---
دالة قسمة_بنتيجة(أ، ب)
    إذا (ب == 0)
        متغير ن = جديد نتيجة_عملية(0، -1، "القسمة على صفر غير ممكنة")
        ن.اطبع_النتيجة()
    وإلا
        متغير ناتج = أ / ب
        متغير ن = جديد نتيجة_عملية(1، 0، "ناتج القسمة: " + ناتج)
        ن.اطبع_النتيجة()
    نهاية
نهاية

# --- مثال 3: صنف نتيجة التحقق ---
صنف نتيجة_تحقق
    باني(صالح_قيمة، تفاصيل_قيمة)
        هذا.صالح = صالح_قيمة
        هذا.تفاصيل = تفاصيل_قيمة
    نهاية

    دالة اعرض()
        إذا (هذا.صالح == 1)
            اطبع_سطر("صالح: " + هذا.تفاصيل)
        وإلا
            اطبع_سطر("غير صالح: " + هذا.تفاصيل)
        نهاية
    نهاية
نهاية

# --- مثال 4: التحقق من العمر بكائن ---
دالة تحقق_عمر_كائن(سن)
    إذا (سن < 0)
        متغير ن = جديد نتيجة_تحقق(0، "العمر سالب")
        ن.اعرض()
    والا_اذا (سن > 150)
        متغير ن = جديد نتيجة_تحقق(0، "العمر غير واقعي")
        ن.اعرض()
    والا_اذا (سن < 18)
        متغير ن = جديد نتيجة_تحقق(0، "العمر أقل من 18")
        ن.اعرض()
    وإلا
        متغير ن = جديد نتيجة_تحقق(1، "العمر " + سن + " مقبول")
        ن.اعرض()
    نهاية
نهاية

# --- مثال 5: صنف حالة العملية ---
صنف حالة_عملية
    باني(اسم_قيمة، حالة_قيمة، وصف_قيمة)
        هذا.اسم = اسم_قيمة
        هذا.حالة = حالة_قيمة
        هذا.وصف = وصف_قيمة
    نهاية

    دالة تقرير()
        اطبع_سطر("العملية: " + هذا.اسم)
        اطبع_سطر("الحالة: " + هذا.حالة)
        اطبع_سطر("الوصف: " + هذا.وصف)
    نهاية
نهاية

# --- مثال 6: تسلسل عمليات مع تقارير ---
دالة عملية_إيداع(رصيد، مبلغ)
    إذا (مبلغ <= 0)
        متغير ح = جديد حالة_عملية("إيداع"، "فشل"، "المبلغ يجب أن يكون موجباً")
        ح.تقرير()
    وإلا
        متغير جديد_ر = رصيد + مبلغ
        متغير ح = جديد حالة_عملية("إيداع"، "نجاح"، "الرصيد الجديد: " + جديد_ر)
        ح.تقرير()
    نهاية
نهاية

دالة عملية_سحب(رصيد، مبلغ)
    إذا (مبلغ <= 0)
        متغير ح = جديد حالة_عملية("سحب"، "فشل"، "المبلغ يجب أن يكون موجباً")
        ح.تقرير()
    والا_اذا (مبلغ > رصيد)
        متغير ح = جديد حالة_عملية("سحب"، "فشل"، "الرصيد غير كافٍ")
        ح.تقرير()
    وإلا
        متغير جديد_ر = رصيد - مبلغ
        متغير ح = جديد حالة_عملية("سحب"، "نجاح"، "الرصيد المتبقي: " + جديد_ر)
        ح.تقرير()
    نهاية
نهاية

# --- مثال 7: نتيجة مع مستوى الخطأ ---
صنف نتيجة_مفصلة
    باني(ناجح_قيمة، مستوى_قيمة، رسالة_قيمة)
        هذا.ناجح = ناجح_قيمة
        هذا.مستوى = مستوى_قيمة
        هذا.رسالة = رسالة_قيمة
    نهاية

    دالة اعرض_مفصل()
        إذا (هذا.مستوى == 0)
            اطبع_سطر("[معلومة] " + هذا.رسالة)
        والا_اذا (هذا.مستوى == 1)
            اطبع_سطر("[تحذير] " + هذا.رسالة)
        والا_اذا (هذا.مستوى == 2)
            اطبع_سطر("[خطأ] " + هذا.رسالة)
        وإلا
            اطبع_سطر("[حرج] " + هذا.رسالة)
        نهاية
    نهاية
نهاية

دالة فحص_قيمة(ع)
    إذا (ع < 0)
        متغير ن = جديد نتيجة_مفصلة(0، 2، "القيمة سالبة: " + ع)
        ن.اعرض_مفصل()
    والا_اذا (ع == 0)
        متغير ن = جديد نتيجة_مفصلة(1، 1، "القيمة صفر، قد تسبب مشاكل")
        ن.اعرض_مفصل()
    والا_اذا (ع > 1000)
        متغير ن = جديد نتيجة_مفصلة(1، 1، "القيمة كبيرة جداً: " + ع)
        ن.اعرض_مفصل()
    وإلا
        متغير ن = جديد نتيجة_مفصلة(1، 0، "القيمة مقبولة: " + ع)
        ن.اعرض_مفصل()
    نهاية
نهاية

# --- مثال 8: نظام تقييم شامل بكائنات ---
صنف تقرير_تقييم
    باني(اسم_قيمة، درجة_قيمة، ملاحظات_قيمة)
        هذا.اسم = اسم_قيمة
        هذا.درجة = درجة_قيمة
        هذا.ملاحظات = ملاحظات_قيمة
    نهاية

    دالة اعرض_تقرير()
        اطبع_سطر("--- تقرير التقييم ---")
        اطبع_سطر("الاسم: " + هذا.اسم)
        اطبع_سطر("الدرجة: " + هذا.درجة)
        اطبع_سطر("الملاحظات: " + هذا.ملاحظات)
    نهاية
نهاية

دالة تقييم_شامل(درجة)
    إذا (درجة < 0)
        متغير ت = جديد تقرير_تقييم("مجهول"، 0، "خطأ: درجة سالبة")
        ت.اعرض_تقرير()
    والا_اذا (درجة > 100)
        متغير ت = جديد تقرير_تقييم("مجهول"، 0، "خطأ: درجة تتجاوز 100")
        ت.اعرض_تقرير()
    والا_اذا (درجة >= 90)
        متغير ت = جديد تقرير_تقييم("طالب"، درجة، "ممتاز - أداء متميز")
        ت.اعرض_تقرير()
    والا_اذا (درجة >= 70)
        متغير ت = جديد تقرير_تقييم("طالب"، درجة، "جيد - يحتاج تحسين بسيط")
        ت.اعرض_تقرير()
    وإلا
        متغير ت = جديد تقرير_تقييم("طالب"، درجة، "ضعيف - يحتاج متابعة")
        ت.اعرض_تقرير()
    نهاية
نهاية

# --- الدالة الرئيسية ---
دالة رئيسية()
    اطبع_سطر("=== كائن النتيجة ===")

    اطبع_سطر("--- مثال 1 و 2: قسمة بنتيجة ---")
    قسمة_بنتيجة(10، 3)
    قسمة_بنتيجة(10، 0)

    اطبع_سطر("--- مثال 3 و 4: التحقق من العمر ---")
    تحقق_عمر_كائن(25)
    تحقق_عمر_كائن(-5)
    تحقق_عمر_كائن(10)

    اطبع_سطر("--- مثال 5 و 6: عمليات بنكية ---")
    عملية_إيداع(5000، 2000)
    عملية_إيداع(5000، -100)
    عملية_سحب(5000، 2000)
    عملية_سحب(5000، 8000)

    اطبع_سطر("--- مثال 7: فحص قيمة ---")
    فحص_قيمة(50)
    فحص_قيمة(-10)
    فحص_قيمة(0)
    فحص_قيمة(5000)

    اطبع_سطر("--- مثال 8: تقييم شامل ---")
    تقييم_شامل(95)
    تقييم_شامل(75)
    تقييم_شامل(40)
    تقييم_شامل(-10)

    اطبع_سطر("=== انتهى ===")
نهاية
