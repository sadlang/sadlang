# ===================================================
# 03 - الحراسة (Guard Clauses)
# نمط الإرجاع المبكر لتجنب التعقيد
# ===================================================

# --- مثال 1: حراسة بسيطة ---
دالة رقم مضاعف_آمن(ع)
    إذا (ع < 0)
        ارجع -1
    نهاية
    متغير ناتج = ع * 2
    ارجع ناتج
نهاية

# --- مثال 2: حراسة متعددة ---
دالة رقم قسمة_محروسة(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("حراسة: المقسوم عليه صفر")
        ارجع -1
    نهاية
    إذا (أ < 0)
        اطبع_سطر("حراسة: البسط سالب")
        ارجع -1
    نهاية
    متغير ناتج = أ / ب
    ارجع ناتج
نهاية

# --- مثال 3: حراسة العمر قبل التسجيل ---
دالة تسجيل_مستخدم(سن)
    إذا (سن < 13)
        اطبع_سطر("مرفوض: العمر أقل من 13")
        ارجع 0
    نهاية
    إذا (سن > 120)
        اطبع_سطر("مرفوض: العمر غير واقعي")
        ارجع 0
    نهاية
    اطبع_سطر("تم التسجيل بنجاح، العمر: " + سن)
    ارجع 1
نهاية

# --- مثال 4: حراسة الرصيد ---
دالة رقم سحب_مبلغ(رصيد، مبلغ)
    إذا (مبلغ <= 0)
        اطبع_سطر("حراسة: المبلغ يجب أن يكون موجباً")
        ارجع رصيد
    نهاية
    إذا (مبلغ > رصيد)
        اطبع_سطر("حراسة: الرصيد غير كافٍ")
        ارجع رصيد
    نهاية
    متغير رصيد_جديد = رصيد - مبلغ
    اطبع_سطر("تم السحب، الرصيد المتبقي: " + رصيد_جديد)
    ارجع رصيد_جديد
نهاية

# --- مثال 5: حراسة قبل الحساب ---
دالة رقم احسب_معدل(مجموع، عدد)
    إذا (عدد == 0)
        اطبع_سطر("حراسة: لا يمكن حساب المعدل لصفر عناصر")
        ارجع -1
    نهاية
    إذا (مجموع < 0)
        اطبع_سطر("حراسة: المجموع لا يمكن أن يكون سالباً")
        ارجع -1
    نهاية
    متغير معدل = مجموع / عدد
    اطبع_سطر("المعدل: " + معدل)
    ارجع معدل
نهاية

# --- مثال 6: حراسة ثلاثية المستويات ---
دالة رقم عملية_حسابية(أ، ب، عملية)
    إذا (عملية < 1)
        اطبع_سطر("حراسة: رقم العملية غير صالح")
        ارجع -9999
    نهاية
    إذا (عملية > 4)
        اطبع_سطر("حراسة: رقم العملية غير صالح")
        ارجع -9999
    نهاية
    # 1=جمع، 2=طرح، 3=ضرب، 4=قسمة
    إذا (عملية == 4)
        إذا (ب == 0)
            اطبع_سطر("حراسة: القسمة على صفر")
            ارجع -9999
        نهاية
    نهاية
    إذا (عملية == 1)
        متغير ن = أ + ب
        ارجع ن
    والا_اذا (عملية == 2)
        متغير ن = أ - ب
        ارجع ن
    والا_اذا (عملية == 3)
        متغير ن = أ * ب
        ارجع ن
    وإلا
        متغير ن = أ / ب
        ارجع ن
    نهاية
نهاية

# --- مثال 7: حراسة بنمط التراكم ---
دالة رقم جمع_ثلاثة(أ، ب، ج)
    إذا (أ < 0)
        اطبع_سطر("حراسة: القيمة الأولى سالبة")
        ارجع -1
    نهاية
    إذا (ب < 0)
        اطبع_سطر("حراسة: القيمة الثانية سالبة")
        ارجع -1
    نهاية
    إذا (ج < 0)
        اطبع_سطر("حراسة: القيمة الثالثة سالبة")
        ارجع -1
    نهاية
    متغير مجموع = أ + ب + ج
    ارجع مجموع
نهاية

# --- مثال 8: حراسة مع رسائل تفصيلية ---
دالة تحويل_درجة(درجة، من_نظام)
    # من_نظام: 1=مئوي، 2=فهرنهايت
    إذا (من_نظام != 1)
        إذا (من_نظام != 2)
            اطبع_سطر("حراسة: نظام غير معروف، استخدم 1 أو 2")
            ارجع -9999
        نهاية
    نهاية
    إذا (من_نظام == 1)
        إذا (درجة < -273)
            اطبع_سطر("حراسة: أقل من الصفر المطلق")
            ارجع -9999
        نهاية
        متغير ف = درجة * 9 / 5 + 32
        اطبع_سطر("النتيجة بالفهرنهايت: " + ف)
        ارجع ف
    وإلا
        إذا (درجة < -459)
            اطبع_سطر("حراسة: أقل من الصفر المطلق")
            ارجع -9999
        نهاية
        متغير م = (درجة - 32) * 5 / 9
        اطبع_سطر("النتيجة بالمئوي: " + م)
        ارجع م
    نهاية
نهاية

# --- الدالة الرئيسية ---
دالة رئيسية()
    اطبع_سطر("=== الحراسة (Guard Clauses) ===")

    اطبع_سطر("--- مثال 1: حراسة بسيطة ---")
    متغير ن1 = مضاعف_آمن(5)
    اطبع_سطر("مضاعف 5: " + ن1)
    متغير ن2 = مضاعف_آمن(-3)
    اطبع_سطر("مضاعف -3: " + ن2)

    اطبع_سطر("--- مثال 2: حراسة متعددة ---")
    متغير ن3 = قسمة_محروسة(10، 2)
    اطبع_سطر("الناتج: " + ن3)
    متغير ن4 = قسمة_محروسة(10، 0)
    اطبع_سطر("الناتج: " + ن4)

    اطبع_سطر("--- مثال 3: تسجيل مستخدم ---")
    تسجيل_مستخدم(25)
    تسجيل_مستخدم(10)
    تسجيل_مستخدم(130)

    اطبع_سطر("--- مثال 4: سحب مبلغ ---")
    متغير ر1 = سحب_مبلغ(1000، 300)
    متغير ر2 = سحب_مبلغ(1000، 1500)
    متغير ر3 = سحب_مبلغ(1000، -50)

    اطبع_سطر("--- مثال 5: حساب المعدل ---")
    متغير م1 = احسب_معدل(300، 3)
    متغير م2 = احسب_معدل(0، 0)

    اطبع_سطر("--- مثال 6: العمليات الحسابية ---")
    متغير ع1 = عملية_حسابية(10، 5، 1)
    اطبع_سطر("جمع: " + ع1)
    متغير ع2 = عملية_حسابية(10، 5، 3)
    اطبع_سطر("ضرب: " + ع2)
    متغير ع3 = عملية_حسابية(10، 0، 4)
    اطبع_سطر("قسمة: " + ع3)

    اطبع_سطر("--- مثال 7: جمع ثلاثة ---")
    متغير ج1 = جمع_ثلاثة(10، 20، 30)
    اطبع_سطر("المجموع: " + ج1)
    متغير ج2 = جمع_ثلاثة(10، -5، 30)
    اطبع_سطر("المجموع: " + ج2)

    اطبع_سطر("--- مثال 8: تحويل درجات ---")
    تحويل_درجة(100، 1)
    تحويل_درجة(212، 2)
    تحويل_درجة(100، 5)

    اطبع_سطر("=== انتهى ===")
نهاية
