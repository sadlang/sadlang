# 06 - القيم الافتراضية
# توفير قيم بديلة عند وجود مدخلات غير صالحة
# ===================================================

# --- مثال 1: قيمة افتراضية بسيطة ---
دالة رقم مع_افتراضي(قيمة، قيمة_بديلة)
    إذا (قيمة <= 0)
        اطبع_سطر("استخدام القيمة الافتراضية: " + قيمة_بديلة)
        ارجع قيمة_بديلة
    وإلا
        ارجع قيمة
    نهاية
نهاية

# --- مثال 2: حد أدنى مضمون ---
دالة رقم على_الأقل(قيمة، حد_أدنى)
    إذا (قيمة < حد_أدنى)
        اطبع_سطر("تم رفع القيمة إلى الحد الأدنى: " + حد_أدنى)
        ارجع حد_أدنى
    وإلا
        ارجع قيمة
    نهاية
نهاية

# --- مثال 3: حد أقصى مضمون ---
دالة رقم على_الأكثر(قيمة، حد_أقصى)
    إذا (قيمة > حد_أقصى)
        اطبع_سطر("تم خفض القيمة إلى الحد الأقصى: " + حد_أقصى)
        ارجع حد_أقصى
    وإلا
        ارجع قيمة
    نهاية
نهاية

# --- مثال 4: قسمة مع قيمة افتراضية ---
دالة رقم قسمة_افتراضية(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("القسمة على صفر: إرجاع 0 كقيمة افتراضية")
        ارجع 0
    وإلا
        متغير ناتج = أ / ب
        ارجع ناتج
    نهاية
نهاية

# --- مثال 5: إعدادات افتراضية ---
دالة ضبط_إعدادات(سرعة، حجم، سطوع)
    # السرعة: 1-10، الحجم: 0-100، السطوع: 0-100
    متغير س_نهائي = سرعة
    إذا (سرعة < 1)
        س_نهائي = 5
        اطبع_سطر("السرعة غير صالحة، استخدام الافتراضي: 5")
    والا_اذا (سرعة > 10)
        س_نهائي = 5
        اطبع_سطر("السرعة غير صالحة، استخدام الافتراضي: 5")
    نهاية
    متغير ح_نهائي = حجم
    إذا (حجم < 0)
        ح_نهائي = 50
        اطبع_سطر("الحجم غير صالح، استخدام الافتراضي: 50")
    والا_اذا (حجم > 100)
        ح_نهائي = 50
        اطبع_سطر("الحجم غير صالح، استخدام الافتراضي: 50")
    نهاية
    متغير ض_نهائي = سطوع
    إذا (سطوع < 0)
        ض_نهائي = 70
        اطبع_سطر("السطوع غير صالح، استخدام الافتراضي: 70")
    والا_اذا (سطوع > 100)
        ض_نهائي = 70
        اطبع_سطر("السطوع غير صالح، استخدام الافتراضي: 70")
    نهاية
    اطبع_سطر("الإعدادات: سرعة=" + س_نهائي + " حجم=" + ح_نهائي + " سطوع=" + ض_نهائي)
نهاية

# --- مثال 6: عمر افتراضي ---
دالة رقم عمر_صالح(سن)
    إذا (سن < 0)
        اطبع_سطر("عمر سالب: استخدام 0")
        ارجع 0
    والا_اذا (سن > 150)
        اطبع_سطر("عمر غير واقعي: استخدام 0")
        ارجع 0
    وإلا
        ارجع سن
    نهاية
نهاية

# --- مثال 7: حساب المعدل مع افتراضي آمن ---
دالة رقم معدل_آمن(مجموع، عدد)
    إذا (عدد <= 0)
        اطبع_سطر("عدد غير صالح: إرجاع 0")
        ارجع 0
    نهاية
    إذا (مجموع < 0)
        اطبع_سطر("مجموع سالب: استخدام 0")
        ارجع 0
    نهاية
    متغير معدل = مجموع / عدد
    ارجع معدل
نهاية

# --- مثال 8: نظام نقاط مع حدود ---
دالة رقم أضف_نقاط(ر_حالي، نقاط_جديدة)
    # الرصيد الحالي لا يقل عن 0 ولا يزيد عن 10000
    متغير ر_فعلي = ر_حالي
    إذا (ر_حالي < 0)
        ر_فعلي = 0
    نهاية
    متغير ن_فعلية = نقاط_جديدة
    إذا (نقاط_جديدة < 0)
        ن_فعلية = 0
        اطبع_سطر("نقاط سالبة: استخدام 0")
    نهاية
    متغير مجموع = ر_فعلي + ن_فعلية
    إذا (مجموع > 10000)
        اطبع_سطر("تم تقييد النقاط إلى الحد الأقصى: 10000")
        ارجع 10000
    وإلا
        اطبع_سطر("الرصيد الجديد: " + مجموع)
        ارجع مجموع
    نهاية
نهاية

