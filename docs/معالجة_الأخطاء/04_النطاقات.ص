# 04 - النطاقات
# التحقق من أن القيم تقع ضمن حدود معينة
# ===================================================

# --- مثال 1: التحقق من نطاق بسيط ---
دالة في_نطاق(قيمة، حد_أدنى، حد_أقصى)
    إذا (قيمة < حد_أدنى)
        اطبع_سطر("القيمة " + قيمة + " أقل من الحد الأدنى " + حد_أدنى)
        ارجع 0
    والا_اذا (قيمة > حد_أقصى)
        اطبع_سطر("القيمة " + قيمة + " أكبر من الحد الأقصى " + حد_أقصى)
        ارجع 0
    وإلا
        اطبع_سطر("القيمة " + قيمة + " ضمن النطاق")
        ارجع 1
    نهاية
نهاية

# --- مثال 2: تقييد القيمة للنطاق (Clamp) ---
دالة رقم قيّد(قيمة، حد_أدنى، حد_أقصى)
    إذا (قيمة < حد_أدنى)
        اطبع_سطر("تم تقييد القيمة إلى الحد الأدنى: " + حد_أدنى)
        ارجع حد_أدنى
    والا_اذا (قيمة > حد_أقصى)
        اطبع_سطر("تم تقييد القيمة إلى الحد الأقصى: " + حد_أقصى)
        ارجع حد_أقصى
    وإلا
        ارجع قيمة
    نهاية
نهاية

# --- مثال 3: التحقق من نطاق العمر ---
دالة تصنيف_عمر(سن)
    إذا (سن < 0)
        اطبع_سطر("خطأ: عمر سالب")
        ارجع -1
    والا_اذا (سن < 13)
        اطبع_سطر("طفل")
        ارجع 1
    والا_اذا (سن < 18)
        اطبع_سطر("مراهق")
        ارجع 2
    والا_اذا (سن < 60)
        اطبع_سطر("بالغ")
        ارجع 3
    والا_اذا (سن <= 120)
        اطبع_سطر("كبير السن")
        ارجع 4
    وإلا
        اطبع_سطر("خطأ: عمر غير واقعي")
        ارجع -1
    نهاية
نهاية

# --- مثال 4: التحقق من نطاق الدرجات ---
دالة تقدير_درجة(درجة)
    إذا (درجة < 0)
        اطبع_سطر("خطأ: درجة سالبة")
    والا_اذا (درجة > 100)
        اطبع_سطر("خطأ: درجة تتجاوز 100")
    والا_اذا (درجة >= 90)
        اطبع_سطر("ممتاز")
    والا_اذا (درجة >= 80)
        اطبع_سطر("جيد جداً")
    والا_اذا (درجة >= 70)
        اطبع_سطر("جيد")
    والا_اذا (درجة >= 60)
        اطبع_سطر("مقبول")
    وإلا
        اطبع_سطر("راسب")
    نهاية
نهاية

# --- مثال 5: التحقق من صحة الشهر واليوم ---
دالة رقم أيام_الشهر(شهر)
    إذا (شهر < 1)
        ارجع -1
    والا_اذا (شهر > 12)
        ارجع -1
    والا_اذا (شهر == 2)
        ارجع 28
    والا_اذا (شهر == 4)
        ارجع 30
    والا_اذا (شهر == 6)
        ارجع 30
    والا_اذا (شهر == 9)
        ارجع 30
    والا_اذا (شهر == 11)
        ارجع 30
    وإلا
        ارجع 31
    نهاية
نهاية

دالة تحقق_تاريخ(شهر، يوم)
    متغير أقصى = أيام_الشهر(شهر)
    إذا (أقصى == -1)
        اطبع_سطر("خطأ: شهر غير صالح: " + شهر)
        ارجع 0
    نهاية
    إذا (يوم < 1)
        اطبع_سطر("خطأ: اليوم أقل من 1")
        ارجع 0
    نهاية
    إذا (يوم > أقصى)
        اطبع_سطر("خطأ: اليوم " + يوم + " يتجاوز أيام الشهر " + أقصى)
        ارجع 0
    نهاية
    اطبع_سطر("التاريخ صالح: شهر " + شهر + " يوم " + يوم)
    ارجع 1
نهاية

# --- مثال 6: التحقق من نطاق الراتب ---
دالة تحقق_راتب(راتب)
    متغير حد_أدنى = 1500
    متغير حد_أقصى = 100000
    إذا (راتب < حد_أدنى)
        اطبع_سطر("تحذير: الراتب " + راتب + " أقل من الحد الأدنى " + حد_أدنى)
        ارجع 0
    والا_اذا (راتب > حد_أقصى)
        اطبع_سطر("تحذير: الراتب " + راتب + " يتجاوز الحد الأقصى " + حد_أقصى)
        ارجع 0
    وإلا
        اطبع_سطر("الراتب " + راتب + " مقبول")
        ارجع 1
    نهاية
نهاية

# --- مثال 7: نطاقات متداخلة ---
دالة تصنيف_حرارة(درجة)
    إذا (درجة < -50)
        اطبع_سطر("خطأ: أقل من النطاق المقبول")
    والا_اذا (درجة < 0)
        اطبع_سطر("تجمد")
    والا_اذا (درجة < 15)
        اطبع_سطر("بارد")
    والا_اذا (درجة < 25)
        اطبع_سطر("معتدل")
    والا_اذا (درجة < 35)
        اطبع_سطر("حار")
    والا_اذا (درجة <= 60)
        اطبع_سطر("حار جداً")
    وإلا
        اطبع_سطر("خطأ: أعلى من النطاق المقبول")
    نهاية
نهاية

# --- مثال 8: ضبط مستوى الصوت ---
دالة رقم ضبط_صوت(مستوى_حالي، تغيير)
    متغير مستوى_جديد = مستوى_حالي + تغيير
    إذا (مستوى_جديد < 0)
        اطبع_سطر("تم ضبط الصوت إلى الحد الأدنى: 0")
        ارجع 0
    والا_اذا (مستوى_جديد > 100)
        اطبع_سطر("تم ضبط الصوت إلى الحد الأقصى: 100")
        ارجع 100
    وإلا
        اطبع_سطر("مستوى الصوت: " + مستوى_جديد)
        ارجع مستوى_جديد
    نهاية
نهاية

# --- الدالة الرئيسية ---
دالة رئيسية()
    اطبع_سطر("=== النطاقات ===")

    اطبع_سطر("--- مثال 1: في نطاق ---")
    في_نطاق(5، 1، 10)
    في_نطاق(15، 1، 10)
    في_نطاق(-3، 1، 10)

    اطبع_سطر("--- مثال 2: تقييد القيمة ---")
    متغير ق1 = قيّد(5، 0، 10)
    اطبع_سطر("النتيجة: " + ق1)
    متغير ق2 = قيّد(15، 0، 10)
    اطبع_سطر("النتيجة: " + ق2)
    متغير ق3 = قيّد(-5، 0، 10)
    اطبع_سطر("النتيجة: " + ق3)

    اطبع_سطر("--- مثال 3: تصنيف العمر ---")
    تصنيف_عمر(5)
    تصنيف_عمر(15)
    تصنيف_عمر(30)
    تصنيف_عمر(70)
    تصنيف_عمر(-1)

    اطبع_سطر("--- مثال 4: تقدير الدرجة ---")
    تقدير_درجة(95)
    تقدير_درجة(85)
    تقدير_درجة(55)
    تقدير_درجة(-10)

    اطبع_سطر("--- مثال 5: التحقق من التاريخ ---")
    تحقق_تاريخ(1، 15)
    تحقق_تاريخ(2، 30)
    تحقق_تاريخ(13، 1)
    تحقق_تاريخ(6، 31)

    اطبع_سطر("--- مثال 6: التحقق من الراتب ---")
    تحقق_راتب(5000)
    تحقق_راتب(500)
    تحقق_راتب(200000)

    اطبع_سطر("--- مثال 7: تصنيف الحرارة ---")
    تصنيف_حرارة(20)
    تصنيف_حرارة(-10)
    تصنيف_حرارة(40)
    تصنيف_حرارة(-60)

    اطبع_سطر("--- مثال 8: ضبط الصوت ---")
    متغير ص1 = ضبط_صوت(50، 20)
    متغير ص2 = ضبط_صوت(95، 10)
    متغير ص3 = ضبط_صوت(5، -10)

    اطبع_سطر("=== انتهى ===")
نهاية
