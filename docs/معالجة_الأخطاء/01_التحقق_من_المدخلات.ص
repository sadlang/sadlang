        اطبع_سطر("خطأ: كلمة المرور قصيرة جداً")
        ارجع 0
    والا_اذا (طول > 50)
        اطبع_سطر("خطأ: كلمة المرور طويلة جداً")
        ارجع 0
    وإلا
        اطبع_سطر("طول كلمة المرور مقبول")
        ارجع 1
    نهاية
نهاية

