# --- الدالة الرئيسية ---
دالة رئيسية()
    اطبع_سطر("=== التحقق من المدخلات ===")

    اطبع_سطر("--- مثال 1: التحقق من عدد موجب ---")
    تحقق_موجب(5)
    تحقق_موجب(-3)

    اطبع_سطر("--- مثال 2: التحقق من قيمة غير صفرية ---")
    تحقق_غير_صفري(10)
    تحقق_غير_صفري(0)

    اطبع_سطر("--- مثال 3: القسمة الآمنة ---")
    متغير ن1 = قسمة_آمنة(10، 2)
    اطبع_سطر("ناتج القسمة: " + ن1)
    متغير ن2 = قسمة_آمنة(10، 0)
    اطبع_سطر("ناتج القسمة: " + ن2)

    اطبع_سطر("--- مثال 4: التحقق من العمر ---")
    تحقق_عمر(25)
    تحقق_عمر(-5)
    تحقق_عمر(200)

    اطبع_سطر("--- مثال 5: التحقق من طول كلمة المرور ---")
    تحقق_طول(3)
    تحقق_طول(10)
    تحقق_طول(60)

    اطبع_سطر("--- مثال 6: التحقق من الدرجة ---")
    تحقق_درجة(85)
    تحقق_درجة(-10)
    تحقق_درجة(110)

    اطبع_سطر("--- مثال 7: الضرب الآمن ---")
    متغير ن3 = ضرب_آمن(4، 5)
    اطبع_سطر("ناتج الضرب: " + ن3)
    متغير ن4 = ضرب_آمن(-2، 5)
    اطبع_سطر("ناتج الضرب: " + ن4)

    اطبع_سطر("--- مثال 8: التحقق من الشهر ---")
    تحقق_شهر(6)
    تحقق_شهر(0)
    تحقق_شهر(13)

    اطبع_سطر("=== انتهى ===")
نهاية
