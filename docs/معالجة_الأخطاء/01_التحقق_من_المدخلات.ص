# --- مثال 7: التحقق المزدوج قبل العملية ---
دالة رقم ضرب_آمن(أ، ب)
    إذا (أ < 0)
        اطبع_سطر("خطأ: العامل الأول سالب")
        ارجع -1
    وإلا
        إذا (ب < 0)
            اطبع_سطر("خطأ: العامل الثاني سالب")
            ارجع -1
        وإلا
            متغير ناتج = أ * ب
            ارجع ناتج
        نهاية
    نهاية
