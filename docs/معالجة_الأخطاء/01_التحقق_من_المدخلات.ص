# --- مثال 1: التحقق من أن العدد موجب ---
دالة تحقق_موجب(ع)
    إذا (ع > 0)
        اطبع_سطر("العدد موجب: صالح للعملية")
        ارجع 1
    وإلا
        اطبع_سطر("خطأ: العدد ليس موجباً")
        ارجع 0
    نهاية
نهاية

# --- مثال 2: التحقق من أن العدد ليس صفراً ---
دالة تحقق_غير_صفري(ع)
    إذا (ع == 0)
        اطبع_سطر("خطأ: القيمة صفر غير مقبولة")
        ارجع 0
    وإلا
        اطبع_سطر("القيمة غير صفرية: مقبولة")
        ارجع 1
    نهاية
نهاية

# --- مثال 3: التحقق من قابلية القسمة ---
دالة رقم قسمة_آمنة(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("خطأ: لا يمكن القسمة على صفر")
        ارجع -1
    وإلا
        متغير ناتج = أ / ب
        ارجع ناتج
    نهاية
نهاية

# --- مثال 4: التحقق من العمر ---
دالة تحقق_عمر(عمر)
    إذا (عمر < 0)
        اطبع_سطر("خطأ: العمر لا يمكن أن يكون سالباً")
        ارجع 0
    والا_اذا (عمر > 150)
        اطبع_سطر("خطأ: العمر غير واقعي")
        ارجع 0
    وإلا
        اطبع_سطر("العمر صالح")
        ارجع 1
    نهاية
نهاية

# --- مثال 5: التحقق من طول كلمة المرور ---
دالة تحقق_طول(طول)
