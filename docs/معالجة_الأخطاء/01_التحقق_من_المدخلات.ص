# --- مثال 8: التحقق من صحة رقم الشهر ---
دالة تحقق_شهر(شهر)
    إذا (شهر < 1)
        اطبع_سطر("خطأ: رقم الشهر أقل من 1")
        ارجع 0
    والا_اذا (شهر > 12)
        اطبع_سطر("خطأ: رقم الشهر أكبر من 12")
        ارجع 0
    وإلا
        اطبع_سطر("رقم الشهر صحيح")
        ارجع 1
    نهاية
