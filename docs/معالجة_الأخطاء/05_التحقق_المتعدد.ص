# --- مثال 1: التحقق من عملية حسابية ---
دالة رقم عملية_آمنة(أ، ب)
    متغير صالح = 1
    إذا (أ < 0)
        اطبع_سطر("تحذير: العامل الأول سالب")
        صالح = 0
    نهاية
    إذا (ب == 0)
        اطبع_سطر("خطأ: العامل الثاني صفر")
        صالح = 0
    نهاية
    إذا (صالح == 0)
        اطبع_سطر("العملية مرفوضة بسبب مدخلات غير صالحة")
        ارجع -1
    نهاية
    متغير ناتج = أ / ب
    ارجع ناتج
نهاية

# --- مثال 2: التحقق من بيانات الموظف ---
دالة تحقق_موظف(سن، خبرة، راتب)
    متغير أخطاء = 0
    إذا (سن < 18)
        اطبع_سطر("خطأ: العمر أقل من 18")
        أخطاء = أخطاء + 1
    نهاية
    إذا (سن > 65)
        اطبع_سطر("خطأ: العمر أكبر من 65")
        أخطاء = أخطاء + 1
    نهاية
    إذا (خبرة < 0)
        اطبع_سطر("خطأ: الخبرة لا تكون سالبة")
        أخطاء = أخطاء + 1
    نهاية
    إذا (راتب <= 0)
        اطبع_سطر("خطأ: الراتب يجب أن يكون موجباً")
        أخطاء = أخطاء + 1
    نهاية
    إذا (أخطاء == 0)
        اطبع_سطر("بيانات الموظف صالحة")
    وإلا
        اطبع_سطر("عدد الأخطاء: " + أخطاء)
    نهاية
    ارجع أخطاء
نهاية

# --- مثال 3: التحقق من المثلث ---
دالة تحقق_مثلث(أ، ب، ج)
    إذا (أ <= 0)
        اطبع_سطر("خطأ: الضلع الأول غير موجب")
        ارجع 0
    نهاية
    إذا (ب <= 0)
        اطبع_سطر("خطأ: الضلع الثاني غير موجب")
        ارجع 0
    نهاية
    إذا (ج <= 0)
        اطبع_سطر("خطأ: الضلع الثالث غير موجب")
        ارجع 0
    نهاية
    # التحقق من عدم المساواة المثلثية
    إذا (أ + ب <= ج)
        اطبع_سطر("خطأ: الأطوال لا تشكل مثلثاً")
        ارجع 0
    نهاية
    إذا (أ + ج <= ب)
        اطبع_سطر("خطأ: الأطوال لا تشكل مثلثاً")
        ارجع 0
    نهاية
    إذا (ب + ج <= أ)
        اطبع_سطر("خطأ: الأطوال لا تشكل مثلثاً")
        ارجع 0
    نهاية
    اطبع_سطر("الأطوال تشكل مثلثاً صالحاً")
    ارجع 1
نهاية

# --- مثال 4: التحقق من عملية التحويل ---
دالة رقم تحويل_عملة(مبلغ، سعر_صرف)
    إذا (مبلغ < 0)
        اطبع_سطر("خطأ: المبلغ سالب")
        ارجع -1
    نهاية
    إذا (سعر_صرف <= 0)
        اطبع_سطر("خطأ: سعر الصرف غير صالح")
        ارجع -1
    نهاية
    متغير ناتج = مبلغ * سعر_صرف
    اطبع_سطر("المبلغ بعد التحويل: " + ناتج)
    ارجع ناتج
نهاية

# --- مثال 5: نظام تقييم شامل ---
دالة تقييم_طالب(حضور، درجة_اختبار، درجة_مشروع)
    متغير مشاكل = 0
    إذا (حضور < 0)
        اطبع_سطر("خطأ: الحضور سالب")
        مشاكل = مشاكل + 1
    والا_اذا (حضور > 100)
        اطبع_سطر("خطأ: الحضور يتجاوز 100")
        مشاكل = مشاكل + 1
    نهاية
    إذا (درجة_اختبار < 0)
        اطبع_سطر("خطأ: درجة الاختبار سالبة")
        مشاكل = مشاكل + 1
    والا_اذا (درجة_اختبار > 100)
        اطبع_سطر("خطأ: درجة الاختبار تتجاوز 100")
        مشاكل = مشاكل + 1
    نهاية
    إذا (درجة_مشروع < 0)
        اطبع_سطر("خطأ: درجة المشروع سالبة")
        مشاكل = مشاكل + 1
    والا_اذا (درجة_مشروع > 100)
        اطبع_سطر("خطأ: درجة المشروع تتجاوز 100")
        مشاكل = مشاكل + 1
    نهاية
    إذا (مشاكل > 0)
        اطبع_سطر("التقييم مرفوض، عدد المشاكل: " + مشاكل)
        ارجع -1
    نهاية
    # حساب الدرجة النهائية
    متغير نهائي = حضور * 20 / 100 + درجة_اختبار * 50 / 100 + درجة_مشروع * 30 / 100
    اطبع_سطر("الدرجة النهائية: " + نهائي)
    ارجع نهائي
نهاية

# --- مثال 6: التحقق من إحداثيات ---
دالة تحقق_إحداثيات(س، ص)
    إذا (س < -180)
        اطبع_سطر("خطأ: خط الطول أقل من -180")
        ارجع 0
    والا_اذا (س > 180)
        اطبع_سطر("خطأ: خط الطول أكبر من 180")
        ارجع 0
    نهاية
    إذا (ص < -90)
        اطبع_سطر("خطأ: خط العرض أقل من -90")
        ارجع 0
    والا_اذا (ص > 90)
        اطبع_سطر("خطأ: خط العرض أكبر من 90")
        ارجع 0
    نهاية
    اطبع_سطر("الإحداثيات صالحة: " + س + "، " + ص)
    ارجع 1
نهاية

# --- مثال 7: التحقق من كلمة المرور (بالطول) ---
دالة تحقق_كلمة_مرور(طول، عدد_أرقام، عدد_رموز)
    متغير قوة = 0
    إذا (طول < 8)
        اطبع_سطر("ضعيفة: الطول أقل من 8")
    وإلا
        قوة = قوة + 1
    نهاية
    إذا (عدد_أرقام < 1)
        اطبع_سطر("ضعيفة: لا توجد أرقام")
    وإلا
        قوة = قوة + 1
    نهاية
    إذا (عدد_رموز < 1)
        اطبع_سطر("ضعيفة: لا توجد رموز")
    وإلا
        قوة = قوة + 1
    نهاية
    إذا (قوة == 3)
        اطبع_سطر("كلمة المرور قوية")
    والا_اذا (قوة == 2)
        اطبع_سطر("كلمة المرور متوسطة")
    وإلا
        اطبع_سطر("كلمة المرور ضعيفة")
    نهاية
    ارجع قوة
نهاية

# --- مثال 8: التحقق الشامل من معاملة مالية ---
دالة تحقق_معاملة(رصيد، مبلغ، حد_يومي، عدد_معاملات)
    إذا (مبلغ <= 0)
        اطبع_سطر("خطأ: المبلغ يجب أن يكون موجباً")
        ارجع 0
    نهاية
    إذا (مبلغ > رصيد)
        اطبع_سطر("خطأ: الرصيد غير كافٍ")
        ارجع 0
    نهاية
    إذا (مبلغ > حد_يومي)
        اطبع_سطر("خطأ: المبلغ يتجاوز الحد اليومي")
        ارجع 0
    نهاية
    إذا (عدد_معاملات >= 10)
        اطبع_سطر("خطأ: تم تجاوز عدد المعاملات اليومية")
        ارجع 0
    نهاية
    متغير رصيد_متبقي = رصيد - مبلغ
    اطبع_سطر("تمت المعاملة بنجاح، الرصيد المتبقي: " + رصيد_متبقي)
    ارجع 1
نهاية

# --- الدالة الرئيسية ---
دالة رئيسية()
    اطبع_سطر("=== التحقق المتعدد ===")

    اطبع_سطر("--- مثال 1: عملية آمنة ---")
    متغير ن1 = عملية_آمنة(10، 2)
    اطبع_سطر("الناتج: " + ن1)
    متغير ن2 = عملية_آمنة(-5، 0)
    اطبع_سطر("الناتج: " + ن2)

    اطبع_سطر("--- مثال 2: بيانات موظف ---")
    تحقق_موظف(30، 5، 5000)
    تحقق_موظف(15، -1، 0)

    اطبع_سطر("--- مثال 3: التحقق من مثلث ---")
    تحقق_مثلث(3، 4، 5)
    تحقق_مثلث(1، 2، 10)

    اطبع_سطر("--- مثال 4: تحويل عملة ---")
    متغير ت1 = تحويل_عملة(100، 3)
    متغير ت2 = تحويل_عملة(-50، 3)

    اطبع_سطر("--- مثال 5: تقييم طالب ---")
    تقييم_طالب(90، 85، 80)
    تقييم_طالب(-5، 110، 80)

    اطبع_سطر("--- مثال 6: إحداثيات ---")
    تحقق_إحداثيات(45، 35)
    تحقق_إحداثيات(200، -100)

    اطبع_سطر("--- مثال 7: كلمة المرور ---")
    تحقق_كلمة_مرور(10، 2، 1)
    تحقق_كلمة_مرور(5، 0، 0)

    اطبع_سطر("--- مثال 8: معاملة مالية ---")
    تحقق_معاملة(10000، 500، 5000، 3)
    تحقق_معاملة(1000، 2000، 5000، 3)
    تحقق_معاملة(10000، 500، 5000، 10)

    اطبع_سطر("=== انتهى ===")
نهاية
