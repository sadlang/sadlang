# --- مثال 5: مدقق رقم الهاتف (بعدد الخانات) ---
دالة رقم دقق_هاتف(عدد_خانات)
    إذا (عدد_خانات < 7)
        متغير ن = جديد نتيجة_فحص(0، "رقم الهاتف قصير جداً")
        ن.اطبع()
        ارجع 0
