# --- مثال 1: صنف نتيجة الفحص ---
صنف نتيجة_فحص
    باني(صالح_قيمة، رسالة_قيمة)
        هذا.صالح = صالح_قيمة
        هذا.رسالة = رسالة_قيمة
    نهاية

    دالة اطبع()
        إذا (هذا.صالح == 1)
            اطبع_سطر("  [صالح] " + هذا.رسالة)
        وإلا
            اطبع_سطر("  [خطأ] " + هذا.رسالة)
        نهاية
    نهاية
نهاية

# --- مثال 2: مدقق العمر ---
دالة رقم دقق_عمر(سن)
    إذا (سن < 0)
        متغير ن = جديد نتيجة_فحص(0، "العمر لا يمكن أن يكون سالباً")
        ن.اطبع()
        ارجع 0
    والا_اذا (سن > 150)
        متغير ن = جديد نتيجة_فحص(0، "العمر غير واقعي")
        ن.اطبع()
        ارجع 0
    وإلا
        متغير ن = جديد نتيجة_فحص(1، "العمر " + سن + " صالح")
        ن.اطبع()
        ارجع 1
    نهاية
نهاية

# --- مثال 3: مدقق الراتب ---
دالة رقم دقق_راتب(راتب)
    إذا (راتب <= 0)
        متغير ن = جديد نتيجة_فحص(0، "الراتب يجب أن يكون موجباً")
        ن.اطبع()
        ارجع 0
    والا_اذا (راتب < 1000)
        متغير ن = جديد نتيجة_فحص(0، "الراتب أقل من الحد الأدنى 1000")
        ن.اطبع()
        ارجع 0
    والا_اذا (راتب > 500000)
        متغير ن = جديد نتيجة_فحص(0، "الراتب يتجاوز الحد الأقصى 500000")
        ن.اطبع()
        ارجع 0
    وإلا
        متغير ن = جديد نتيجة_فحص(1، "الراتب " + راتب + " صالح")
        ن.اطبع()
        ارجع 1
    نهاية
نهاية

