    نهاية
نهاية

# --- مثال 6: صنف عداد الأخطاء ---
صنف عداد_تدقيق
    باني(اسم_قيمة)
        هذا.اسم = اسم_قيمة
        هذا.نجح = 0
        هذا.فشل = 0
    نهاية

    دالة سجل_نجاح()
        هذا.نجح = هذا.نجح + 1
    نهاية

    دالة سجل_فشل()
        هذا.فشل = هذا.فشل + 1
    نهاية

    دالة رقم مجموع_الاختبارات()
        متغير مج = هذا.نجح + هذا.فشل
        ارجع مج
    نهاية

    دالة اطبع_ملخص()
        اطبع_سطر("=== ملخص التدقيق: " + هذا.اسم + " ===")
        اطبع_سطر("  نجح: " + هذا.نجح)
        اطبع_سطر("  فشل: " + هذا.فشل)
        متغير مج = هذا.نجح + هذا.فشل
        اطبع_سطر("  المجموع: " + مج)
    نهاية
نهاية

# --- مثال 7: التحقق الشامل من بيانات موظف ---
دالة تدقيق_موظف(سن، راتب، خبرة، درجة_تقييم)
    اطبع_سطر("بدء تدقيق بيانات الموظف...")
    متغير عداد = جديد عداد_تدقيق("موظف")

    متغير ن_عمر = دقق_عمر(سن)
    إذا (ن_عمر == 1)
        عداد.سجل_نجاح()
    وإلا
        عداد.سجل_فشل()
    نهاية

    متغير ن_راتب = دقق_راتب(راتب)
    إذا (ن_راتب == 1)
        عداد.سجل_نجاح()
    وإلا
        عداد.سجل_فشل()
    نهاية

    # تحقق من الخبرة
    إذا (خبرة < 0)
        متغير ن_خ = جديد نتيجة_فحص(0، "الخبرة لا تكون سالبة")
        ن_خ.اطبع()
        عداد.سجل_فشل()
    والا_اذا (خبرة > 50)
        متغير ن_خ = جديد نتيجة_فحص(0، "الخبرة غير واقعية")
        ن_خ.اطبع()
        عداد.سجل_فشل()
    وإلا
        متغير ن_خ = جديد نتيجة_فحص(1، "الخبرة " + خبرة + " سنة صالحة")
        ن_خ.اطبع()
        عداد.سجل_نجاح()
    نهاية

    متغير ن_درجة = دقق_درجة(درجة_تقييم)
    إذا (ن_درجة == 1)
        عداد.سجل_نجاح()
    وإلا
        عداد.سجل_فشل()
    نهاية

    عداد.اطبع_ملخص()
نهاية

# --- مثال 8: نظام التدقيق الكامل ---
دالة تدقيق_معاملة_مالية(رصيد، مبلغ، حد_يومي)
    اطبع_سطر("بدء تدقيق المعاملة المالية...")
    متغير عداد = جديد عداد_تدقيق("معاملة مالية")

    # تحقق من الرصيد
    إذا (رصيد < 0)
        متغير ن1 = جديد نتيجة_فحص(0، "الرصيد سالب")
        ن1.اطبع()
        عداد.سجل_فشل()
    وإلا
        متغير ن1 = جديد نتيجة_فحص(1، "الرصيد " + رصيد + " صالح")
        ن1.اطبع()
        عداد.سجل_نجاح()
    نهاية

    # تحقق من المبلغ
    إذا (مبلغ <= 0)
        متغير ن2 = جديد نتيجة_فحص(0، "المبلغ يجب أن يكون موجباً")
        ن2.اطبع()
        عداد.سجل_فشل()
    وإلا
        متغير ن2 = جديد نتيجة_فحص(1، "المبلغ " + مبلغ + " صالح")
        ن2.اطبع()
        عداد.سجل_نجاح()
    نهاية

    # تحقق من الرصيد الكافي
    إذا (مبلغ > رصيد)
        متغير ن3 = جديد نتيجة_فحص(0، "الرصيد غير كافٍ للمبلغ المطلوب")
        ن3.اطبع()
        عداد.سجل_فشل()
    وإلا
        متغير ن3 = جديد نتيجة_فحص(1، "الرصيد كافٍ")
        ن3.اطبع()
        عداد.سجل_نجاح()
    نهاية

    # تحقق من الحد اليومي
    إذا (مبلغ > حد_يومي)
        متغير ن4 = جديد نتيجة_فحص(0، "المبلغ يتجاوز الحد اليومي " + حد_يومي)
        ن4.اطبع()
        عداد.سجل_فشل()
    وإلا
        متغير ن4 = جديد نتيجة_فحص(1، "المبلغ ضمن الحد اليومي")
        ن4.اطبع()
        عداد.سجل_نجاح()
    نهاية

    عداد.اطبع_ملخص()
نهاية

