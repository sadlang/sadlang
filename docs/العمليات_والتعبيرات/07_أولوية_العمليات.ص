# أولوية العمليات (Operator Precedence)
# يشرح هذا الملف ترتيب أولوية العمليات الحسابية والمنطقية
# وكيفية استخدام الأقواس للتحكم في ترتيب التنفيذ

# دالة مساعدة لحساب القوة (بدلاً من عامل ** الذي لا يتوافق مع المترجم)
دالة قوة_عدد(قاعد، مرات)
    متغير ناتج = 1
    متغير ت = 0
    بينما (ت < مرات)
        ناتج = ناتج * قاعد
        ت = ت + 1
    نهاية
    ارجع ناتج
