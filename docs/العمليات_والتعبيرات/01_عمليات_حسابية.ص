# مثال 1: العمليات الحسابية الأساسية
# المستوى: مبتدئ
# يوضح جميع العمليات الحسابية في لغة ص


دالة رئيسية()
    متغير أ = 15
    متغير ب = 4

    اطبع_سطر("=== العمليات الحسابية الأساسية ===")
    اطبع_سطر("أ = " + أ)
    اطبع_سطر("ب = " + ب)
    اطبع_سطر("")

    # الجمع
    اطبع_سطر("الجمع: " + أ + " + " + ب + " = " + (أ + ب))

    # الطرح
    اطبع_سطر("الطرح: " + أ + " - " + ب + " = " + (أ - ب))

    # الضرب
    اطبع_سطر("الضرب: " + أ + " * " + ب + " = " + (أ * ب))

    # القسمة
    اطبع_سطر("القسمة: " + أ + " / " + ب + " = " + (أ / ب))

    # باقي القسمة
    اطبع_سطر("باقي القسمة: " + أ + " % " + ب + " = " + (أ % ب))

    # الأُس
    اطبع_سطر("الأُس: " + أ + " ** 2 = " + (أ ** 2))
    اطبع_سطر("الأُس: 2 ** 10 = " + (2 ** 10))

    # === حسابات عملية ===
    اطبع_سطر("")
    اطبع_سطر("=== حسابات عملية ===")

    # حساب محيط ومساحة مستطيل
    متغير الطول = 12
    متغير العرض = 8
    متغير المحيط = 2 * (الطول + العرض)
    متغير المساحة = الطول * العرض

    اطبع_سطر("المستطيل: طول=" + الطول + "، عرض=" + العرض)
    اطبع_سطر("المحيط: " + المحيط)
    اطبع_سطر("المساحة: " + المساحة)
نهاية
