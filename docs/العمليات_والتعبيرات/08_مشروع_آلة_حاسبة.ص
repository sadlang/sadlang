# مشروع آلة حاسبة (Calculator Project)
# آلة حاسبة بسيطة تستخدم دوال منفصلة لكل عملية حسابية
# تعرض أمثلة على الجمع والطرح والضرب والقسمة والأس وباقي القسمة

دالة جمع(أ، ب)
    ارجع أ + ب
نهاية

دالة طرح(أ، ب)
    ارجع أ - ب
نهاية

دالة ضرب(أ، ب)
    ارجع أ * ب
نهاية

دالة قسمة(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("خطأ: لا يمكن القسمة على صفر!")
        ارجع 0
    نهاية
    ارجع أ / ب
نهاية

دالة باقي_قسمة(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("خطأ: لا يمكن حساب الباقي مع صفر!")
        ارجع 0
    نهاية
    ارجع أ % ب
نهاية

دالة أس(قاعدة، قوة)
    ارجع قاعدة ** قوة
نهاية

صنف آلة_حاسبة
    باني()
        هذا.العمليات = 0
        هذا.آخر_نتيجة = 0
    نهاية

    دالة احسب_جمع(أ، ب)
        هذا.العمليات += 1
        هذا.آخر_نتيجة = جمع(أ، ب)
        ارجع هذا.آخر_نتيجة
    نهاية

    دالة احسب_طرح(أ، ب)
        هذا.العمليات += 1
        هذا.آخر_نتيجة = طرح(أ، ب)
        ارجع هذا.آخر_نتيجة
    نهاية

    دالة احسب_ضرب(أ، ب)
        هذا.العمليات += 1
        هذا.آخر_نتيجة = ضرب(أ، ب)
        ارجع هذا.آخر_نتيجة
    نهاية

    دالة احسب_قسمة(أ، ب)
        هذا.العمليات += 1
        هذا.آخر_نتيجة = قسمة(أ، ب)
        ارجع هذا.آخر_نتيجة
    نهاية

    دالة احسب_أس(أ، ب)
        هذا.العمليات += 1
        هذا.آخر_نتيجة = أس(أ، ب)
        ارجع هذا.آخر_نتيجة
    نهاية

    دالة عدد_العمليات()
        ارجع هذا.العمليات
    نهاية

    دالة آخر_قيمة()
        ارجع هذا.آخر_نتيجة
    نهاية
نهاية

دالة رئيسية()

    # --- اختبار الدوال الأساسية ---
    اطبع_سطر("=== اختبار الدوال الأساسية ===")
    اطبع_سطر("جمع(10, 5) = " + جمع(10, 5))
    اطبع_سطر("طرح(10, 5) = " + طرح(10, 5))
    اطبع_سطر("ضرب(10, 5) = " + ضرب(10, 5))
    اطبع_سطر("قسمة(10, 5) = " + قسمة(10, 5))
    اطبع_سطر("باقي_قسمة(10, 3) = " + باقي_قسمة(10, 3))
    اطبع_سطر("أس(2, 8) = " + أس(2, 8))

    # --- اختبار القسمة على صفر ---
    اطبع_سطر("")
    اطبع_سطر("=== اختبار القسمة على صفر ===")
    متغير ن = قسمة(10, 0)
    اطبع_سطر("نتيجة القسمة على صفر: " + ن)

    # --- استخدام صنف آلة_حاسبة ---
    اطبع_سطر("")
    اطبع_سطر("=== استخدام صنف آلة_حاسبة ===")
    متغير حاسبة = جديد آلة_حاسبة()

    متغير ن1 = حاسبة.احسب_جمع(100, 50)
    اطبع_سطر("100 + 50 = " + ن1)

    متغير ن2 = حاسبة.احسب_طرح(200, 75)
    اطبع_سطر("200 - 75 = " + ن2)

    متغير ن3 = حاسبة.احسب_ضرب(12, 8)
    اطبع_سطر("12 * 8 = " + ن3)

    متغير ن4 = حاسبة.احسب_قسمة(144, 12)
    اطبع_سطر("144 / 12 = " + ن4)

    متغير ن5 = حاسبة.احسب_أس(3, 4)
    اطبع_سطر("3 ** 4 = " + ن5)

    اطبع_سطر("عدد العمليات: " + حاسبة.عدد_العمليات())
    اطبع_سطر("آخر نتيجة: " + حاسبة.آخر_قيمة())

    # --- سلسلة عمليات ---
    اطبع_سطر("")
    اطبع_سطر("=== سلسلة عمليات ===")
    # حساب: ((10 + 5) * 3 - 15) / 6
    متغير خطوة1 = حاسبة.احسب_جمع(10, 5)
    اطبع_سطر("خطوة 1: 10 + 5 = " + خطوة1)

    متغير خطوة2 = حاسبة.احسب_ضرب(خطوة1, 3)
    اطبع_سطر("خطوة 2: " + خطوة1 + " * 3 = " + خطوة2)

    متغير خطوة3 = حاسبة.احسب_طرح(خطوة2, 15)
    اطبع_سطر("خطوة 3: " + خطوة2 + " - 15 = " + خطوة3)

    متغير خطوة4 = حاسبة.احسب_قسمة(خطوة3, 6)
    اطبع_سطر("خطوة 4: " + خطوة3 + " / 6 = " + خطوة4)

    اطبع_سطر("إجمالي العمليات: " + حاسبة.عدد_العمليات())

    # --- جدول الضرب ---
    اطبع_سطر("")
    اطبع_سطر("=== جدول ضرب العدد 7 ===")
    متغير ي = 1
    بينما (ي <= 10)
        متغير حاصل_الضرب = ضرب(7, ي)
        اطبع_سطر("7 * " + ي + " = " + حاصل_الضرب)
        ي += 1
    نهاية

    # --- حساب المضروب (factorial) ---
    اطبع_سطر("")
    اطبع_سطر("=== حساب المضروب ===")
    متغير عدد = 1
    متغير مضروب = 1
    بينما (عدد <= 8)
        مضروب = ضرب(مضروب, عدد)
        اطبع_سطر(عدد + "! = " + مضروب)
        عدد += 1
    نهاية

    # --- حساب قوى العدد 2 ---
    اطبع_سطر("")
    اطبع_سطر("=== قوى العدد 2 ===")
    متغير ق = 0
    بينما (ق <= 10)
        متغير القوة = أس(2, ق)
        اطبع_سطر("2 ^ " + ق + " = " + القوة)
        ق += 1
    نهاية

    اطبع_سطر("")
    اطبع_سطر("تم الانتهاء من مشروع الآلة الحاسبة")

نهاية
