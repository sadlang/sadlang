# مثال 6: محاكاة عمليات البت باستخدام العمليات الحسابية
# المستوى: متوسط
# ملاحظة: عمليات البت المباشرة (&, |, ^, ~, <<, >>) ستُدعم مستقبلاً
# هنا نحاكيها بدوال حسابية


دالة لديه_صلاحية(المجموع، الصلاحية)
    متغير باقي = المجموع % (الصلاحية * 2)
    ارجع باقي >= الصلاحية
نهاية


دالة رئيسية()
    اطبع_سطر("=== محاكاة عمليات البت ===")

    # === القوى الثنائية (أساس عمليات البت) ===
    اطبع_سطر("=== قوى العدد 2 ===")
    متغير قوة = 1
    متغير أس = 0
    بينما (أس < 8)
        اطبع_سطر("2^" + أس + " = " + قوة)
        قوة *= 2
        أس += 1
    نهاية

    # === محاكاة الإزاحة لليسار (ضرب بقوى 2) ===
    اطبع_سطر("")
    اطبع_سطر("=== إزاحة لليسار (ضرب ×2) ===")
    متغير عدد = 5
    اطبع_سطر(عدد + " × 1 = " + عدد)
    اطبع_سطر(عدد + " × 2 = " + (عدد * 2))
    اطبع_سطر(عدد + " × 4 = " + (عدد * 4))
    اطبع_سطر(عدد + " × 8 = " + (عدد * 8))

    # === محاكاة الإزاحة لليمين (قسمة على قوى 2) ===
    اطبع_سطر("")
    اطبع_سطر("=== إزاحة لليمين (قسمة ÷2) ===")
    متغير قيمة = 64
    اطبع_سطر(قيمة + " ÷ 1 = " + قيمة)
    اطبع_سطر(قيمة + " ÷ 2 = " + (قيمة / 2))
    اطبع_سطر(قيمة + " ÷ 4 = " + (قيمة / 4))
    اطبع_سطر(قيمة + " ÷ 8 = " + (قيمة / 8))

    # === نظام صلاحيات بسيط بالأرقام ===
    اطبع_سطر("")
    اطبع_سطر("=== نظام الصلاحيات ===")

    ثابت صلاحية_قراءة = 1
    ثابت صلاحية_كتابة = 2
    ثابت صلاحية_تنفيذ = 4

    # دمج الصلاحيات (جمع)
    متغير مستخدم_عادي = صلاحية_قراءة
    متغير محرر = صلاحية_قراءة + صلاحية_كتابة
    متغير مدير = صلاحية_قراءة + صلاحية_كتابة + صلاحية_تنفيذ

    اطبع_سطر("مستخدم عادي: " + مستخدم_عادي)
    اطبع_سطر("محرر: " + محرر)
    اطبع_سطر("مدير: " + مدير)

    # التحقق من صلاحية باستخدام باقي القسمة

    اطبع_سطر("المحرر لديه قراءة: " + لديه_صلاحية(محرر، صلاحية_قراءة))
    اطبع_سطر("المحرر لديه كتابة: " + لديه_صلاحية(محرر، صلاحية_كتابة))
    اطبع_سطر("المحرر لديه تنفيذ: " + لديه_صلاحية(محرر، صلاحية_تنفيذ))
    اطبع_سطر("المستخدم العادي لديه كتابة: " + لديه_صلاحية(مستخدم_عادي، صلاحية_كتابة))
نهاية
