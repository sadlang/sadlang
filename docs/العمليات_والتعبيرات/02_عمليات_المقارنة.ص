# مثال 2: عمليات المقارنة
# المستوى: مبتدئ
# يوضح جميع عمليات المقارنة في لغة ص


دالة رئيسية()
    متغير س = 10
    متغير ص = 20
    متغير ع = 10

    اطبع_سطر("=== عمليات المقارنة ===")
    اطبع_سطر("س = " + س + "، ص = " + ص + "، ع = " + ع)
    اطبع_سطر("")

    # يساوي
    اطبع_سطر("س == ص: " + (س == ص))
    اطبع_سطر("س == ع: " + (س == ع))

    # لا يساوي
    اطبع_سطر("س != ص: " + (س != ص))
    اطبع_سطر("س != ع: " + (س != ع))

    # أكبر من
    اطبع_سطر("ص > س: " + (ص > س))
    اطبع_سطر("س > ص: " + (س > ص))

    # أصغر من
    اطبع_سطر("س < ص: " + (س < ص))
    اطبع_سطر("ص < س: " + (ص < س))

    # أكبر من أو يساوي
    اطبع_سطر("س >= ع: " + (س >= ع))
    اطبع_سطر("س >= ص: " + (س >= ص))

    # أصغر من أو يساوي
    اطبع_سطر("س <= ع: " + (س <= ع))
    اطبع_سطر("س <= ص: " + (س <= ص))

    # === مقارنة النصوص ===
    اطبع_سطر("")
    اطبع_سطر("=== مقارنة النصوص ===")
    متغير اسم1 = "أحمد"
    متغير اسم2 = "سارة"
    متغير اسم3 = "أحمد"

    اطبع_سطر("أحمد == أحمد: " + (اسم1 == اسم3))
    اطبع_سطر("أحمد == سارة: " + (اسم1 == اسم2))
    اطبع_سطر("أحمد != سارة: " + (اسم1 != اسم2))

    # === استخدام المقارنات في الشروط ===
    اطبع_سطر("")
    اطبع_سطر("=== تصنيف الأعداد ===")
    متغير أرقام = [5، 12، -3، 0، 25، -7]
    لكل رقم في أرقام
        إذا (رقم > 0)
            اطبع_سطر(رقم + " → موجب")
        وإلا_إذا (رقم < 0)
            اطبع_سطر(رقم + " → سالب")
        وإلا
            اطبع_سطر(رقم + " → صفر")
        نهاية
    نهاية
نهاية
