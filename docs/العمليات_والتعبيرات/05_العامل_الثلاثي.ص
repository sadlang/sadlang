# التعبيرات الشرطية (Conditional Expressions)
# بدلاً من العامل الثلاثي ? : نستخدم إذا/وإلا لتحقيق نفس المنطق الشرطي
# هذا الأسلوب أوضح وأسهل قراءة

دالة الحد_الأقصى(أ، ب)
    إذا (أ > ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

دالة الحد_الأدنى(أ، ب)
    إذا (أ < ب)
        ارجع أ
    وإلا
        ارجع ب
    نهاية
نهاية

دالة القيمة_المطلقة(س)
    إذا (س < 0)
        ارجع س * (0 - 1)
    وإلا
        ارجع س
    نهاية
نهاية

دالة تصنيف_العمر(عمر)
    إذا (عمر < 13)
        ارجع "طفل"
    والا_اذا (عمر < 18)
        ارجع "مراهق"
    والا_اذا (عمر < 60)
        ارجع "بالغ"
    وإلا
        ارجع "كبير"
    نهاية
نهاية

دالة تصنيف_الدرجة(درجة)
    إذا (درجة >= 90)
        ارجع "ممتاز"
    والا_اذا (درجة >= 80)
        ارجع "جيد جداً"
    والا_اذا (درجة >= 70)
        ارجع "جيد"
    والا_اذا (درجة >= 60)
        ارجع "مقبول"
    وإلا
        ارجع "راسب"
    نهاية
نهاية

