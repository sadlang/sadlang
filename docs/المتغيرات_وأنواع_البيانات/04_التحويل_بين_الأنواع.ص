# مثال 4: التحويل بين الأنواع
# المستوى: متوسط
# يوضح هذا المثال كيفية التحويل بين أنواع البيانات المختلفة

# === تحويل نص إلى رقم ===

دالة رئيسية()
    متغير نص_رقمي = "42"
    متغير العدد = لرقم(نص_رقمي)
    اطبع_سطر("=== تحويل نص إلى رقم ===")
    اطبع_سطر("النص: " + نص_رقمي)
    اطبع_سطر("الرقم: " + العدد)
    اطبع_سطر("بعد الجمع: " + (العدد + 8))

    # === تحويل نص إلى عشري ===
    متغير نص_عشري = "3.14"
    متغير العشري = لعشري(نص_عشري)
    اطبع_سطر("")
    اطبع_سطر("=== تحويل نص إلى عشري ===")
    اطبع_سطر("النص: " + نص_عشري)
    اطبع_سطر("العشري: " + العشري)

    # === تحويل رقم إلى نص ===
    متغير رقم_أصلي = 100
    متغير النص = لنص(رقم_أصلي)
    اطبع_سطر("")
    اطبع_سطر("=== تحويل رقم إلى نص ===")
    اطبع_سطر("الرقم: " + رقم_أصلي)
    اطبع_سطر("النص: " + النص)

    # === التحويل في سياق عملي ===
    اطبع_سطر("")
    اطبع_سطر("=== مثال عملي: حساب المعدل ===")
    متغير درجة1 = "85"
    متغير درجة2 = "92"
    متغير درجة3 = "78"

    متغير المجموع = لرقم(درجة1) + لرقم(درجة2) + لرقم(درجة3)
    متغير المعدل = المجموع / 3

    اطبع_سطر("الدرجة 1: " + درجة1)
    اطبع_سطر("الدرجة 2: " + درجة2)
    اطبع_سطر("الدرجة 3: " + درجة3)
    اطبع_سطر("المجموع: " + المجموع)
    اطبع_سطر("المعدل: " + المعدل)

    # === استخدام إلى_رقم و إلى_نص (الصيغة البديلة) ===
    اطبع_سطر("")
    اطبع_سطر("=== الصيغة البديلة ===")
    متغير قيمة = إلى_رقم("256")
    اطبع_سطر("إلى_رقم: " + قيمة)
    متغير نتيجة_نص = إلى_نص(قيمة * 2)
    اطبع_سطر("إلى_نص: " + نتيجة_نص)
نهاية
