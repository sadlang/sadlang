# مثال 8: مشروع متكامل - نظام إدارة المخزون
# المستوى: متقدم جداً
# يوضح استخدام جميع أنواع المتغيرات والبيانات في مشروع حقيقي

# === ثوابت النظام ===

دالة عرض_المخزون()
    اطبع_سطر("")
    اطبع_سطر("=== حالة المخزون ===")
    متغير ي = 0
    بينما (ي < طول(المنتجات))
        متغير الحالة = "متوفر"
        إذا (الكميات[ي] < الحد_الأدنى_للمخزون)
            الحالة = "⚠ منخفض"
        نهاية

دالة إجمالي_المخزون()
    متغير الإجمالي = 0
    متغير ي = 0
    بينما (ي < طول(المنتجات))
        الإجمالي += الأسعار[ي] * الكميات[ي]
        ي += 1
    نهاية

دالة بحث(اسم_المنتج)
    متغير ي = 0
    بينما (ي < طول(المنتجات))
        إذا (المنتجات[ي] == اسم_المنتج)
            اطبع_سطر("✓ تم العثور على: " + اسم_المنتج)
            اطبع_سطر("  السعر: " + الأسعار[ي] + " ريال")
            اطبع_سطر("  الكمية: " + الكميات[ي])
            متغير سعر_شامل = الأسعار[ي] + (الأسعار[ي] * معدل_الضريبة)
            اطبع_سطر("  السعر شامل الضريبة: " + سعر_شامل + " ريال")
            ارجع صحيح
        نهاية

دالة إحصائيات()
    متغير أعلى_سعر = 0
    متغير أقل_سعر = الأسعار[0]
    متغير إجمالي_كميات = 0
    متغير منتجات_منخفضة = 0
    
    متغير ي = 0
    بينما (ي < طول(الأسعار))
        إذا (الأسعار[ي] > أعلى_سعر)
            أعلى_سعر = الأسعار[ي]
        نهاية


دالة رئيسية()
    ثابت اسم_النظام = "نظام إدارة المخزون"
    ثابت الإصدار = "2.0"
    ثابت معدل_الضريبة = 0.15
    ثابت الحد_الأدنى_للمخزون = 5

    اطبع_سطر("╔═══════════════════════════════╗")
    اطبع_سطر("║  " + اسم_النظام + " v" + الإصدار + "  ║")
    اطبع_سطر("╚═══════════════════════════════╝")

    # === بيانات المنتجات ===
    متغير المنتجات = ["لابتوب"، "هاتف"، "شاشة"، "لوحة مفاتيح"، "ماوس"]
    متغير الأسعار = [3500، 2000، 1200، 150، 75]
    متغير الكميات = [10، 25، 15، 50، 100]

    # === دالة عرض المخزون ===
            اطبع_سطر(المنتجات[ي] + " | السعر: " + الأسعار[ي] + " | الكمية: " + الكميات[ي] + " | " + الحالة)
            ي += 1
        نهاية
    نهاية

    # === دالة حساب إجمالي المخزون ===
        ارجع الإجمالي
    نهاية

    # === دالة البحث عن منتج ===
            ي += 1
        نهاية
        اطبع_سطر("✗ المنتج '" + اسم_المنتج + "' غير موجود")
        ارجع خطأ
    نهاية

    # === دالة الإحصائيات ===
            إذا (الأسعار[ي] < أقل_سعر)
                أقل_سعر = الأسعار[ي]
            نهاية
            إجمالي_كميات += الكميات[ي]
            إذا (الكميات[ي] < الحد_الأدنى_للمخزون)
                منتجات_منخفضة += 1
            نهاية
            ي += 1
        نهاية

        اطبع_سطر("")
        اطبع_سطر("=== الإحصائيات ===")
        اطبع_سطر("عدد المنتجات: " + طول(المنتجات))
        اطبع_سطر("أعلى سعر: " + أعلى_سعر + " ريال")
        اطبع_سطر("أقل سعر: " + أقل_سعر + " ريال")
        اطبع_سطر("إجمالي الكميات: " + إجمالي_كميات + " وحدة")
        اطبع_سطر("قيمة المخزون: " + إجمالي_المخزون() + " ريال")
        اطبع_سطر("منتجات منخفضة المخزون: " + منتجات_منخفضة)
    نهاية

    # === تشغيل النظام ===
    عرض_المخزون()

    اطبع_سطر("")
    اطبع_سطر("=== البحث عن منتجات ===")
    بحث("لابتوب")
    اطبع_سطر("")
    بحث("طابعة")

    إحصائيات()

    اطبع_سطر("")
    اطبع_سطر("=== نهاية التقرير ===")
نهاية
