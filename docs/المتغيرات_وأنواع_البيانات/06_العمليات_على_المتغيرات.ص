# مثال 6: العمليات على المتغيرات
# المستوى: متوسط
# يوضح العمليات الحسابية وعمليات الإسناد المركبة

# === العمليات الحسابية الأساسية ===

دالة رئيسية()
    متغير أ = 20
    متغير ب = 7

    اطبع_سطر("=== العمليات الحسابية ===")
    اطبع_سطر("أ = " + أ + "، ب = " + ب)
    اطبع_سطر("أ + ب = " + (أ + ب))
    اطبع_سطر("أ - ب = " + (أ - ب))
    اطبع_سطر("أ * ب = " + (أ * ب))
    اطبع_سطر("أ / ب = " + (أ / ب))
    اطبع_سطر("أ % ب = " + (أ % ب))
    اطبع_سطر("أ ** 2 = " + (أ ** 2))

    # === عمليات الإسناد المركبة ===
    اطبع_سطر("")
    اطبع_سطر("=== عمليات الإسناد المركبة ===")
    متغير عداد = 10
    اطبع_سطر("القيمة الأولية: " + عداد)

    عداد += 5
    اطبع_سطر("بعد += 5: " + عداد)

    عداد -= 3
    اطبع_سطر("بعد -= 3: " + عداد)

    عداد *= 2
    اطبع_سطر("بعد *= 2: " + عداد)

    عداد /= 4
    اطبع_سطر("بعد /= 4: " + عداد)

    # === العمليات المنطقية ===
    اطبع_سطر("")
    اطبع_سطر("=== العمليات المنطقية ===")
    متغير س = 15
    متغير أكبر = س > 10
    متغير أصغر = س < 20
    متغير يساوي = س == 15

    اطبع_سطر("س > 10: " + أكبر)
    اطبع_سطر("س < 20: " + أصغر)
    اطبع_سطر("س == 15: " + يساوي)

    # === عمليات مقارنة ===
    اطبع_سطر("")
    اطبع_سطر("=== المقارنات ===")
    اطبع_سطر("10 == 10: " + (10 == 10))
    اطبع_سطر("10 != 20: " + (10 != 20))
    اطبع_سطر("10 > 5: " + (10 > 5))
    اطبع_سطر("10 < 5: " + (10 < 5))
    اطبع_سطر("10 >= 10: " + (10 >= 10))
    اطبع_سطر("10 <= 20: " + (10 <= 20))

    # === دمج النصوص ===
    اطبع_سطر("")
    اطبع_سطر("=== دمج النصوص ===")
    متغير الاسم_الأول = "محمد"
    متغير الاسم_الأخير = "العلي"
    متغير الاسم_الكامل = الاسم_الأول + " " + الاسم_الأخير
    اطبع_سطر("الاسم الكامل: " + الاسم_الكامل)
نهاية
