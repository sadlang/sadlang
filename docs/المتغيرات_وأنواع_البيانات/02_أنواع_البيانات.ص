# مثال 2: أنواع البيانات
# المستوى: مبتدئ
# يوضح هذا المثال جميع أنواع البيانات الأساسية في لغة ص
# ملاحظة: تم تجنب المصفوفات الحرفية والعامل الثلاثي ونفي الأعداد العشرية لتوافق المترجم

# ======================================================
# مثال 1: الأعداد الصحيحة - التعريف والعمليات الأساسية
# ======================================================

دالة رئيسية()
    اطبع_سطر("=== مثال 1: الأعداد الصحيحة ===")
    متغير عدد_موجب = 42
    متغير عدد_سالب = -17
    متغير صفر = 0
    متغير عدد_كبير = 1000000
    اطبع_سطر("عدد موجب: " + عدد_موجب)
    اطبع_سطر("عدد سالب: " + عدد_سالب)
    اطبع_سطر("صفر: " + صفر)
    اطبع_سطر("عدد كبير: " + عدد_كبير)

    # العمليات الحسابية على الأعداد الصحيحة
    متغير مجموع = عدد_موجب + 8
    متغير فرق = عدد_موجب - 12
    متغير حاصل_ضرب = 6 * 7
    متغير حاصل_قسمة = 100 / 4
    متغير باقي_القسمة = 17 % 5
    اطبع_سطر("42 + 8 = " + مجموع)
    اطبع_سطر("42 - 12 = " + فرق)
    اطبع_سطر("6 * 7 = " + حاصل_ضرب)
    اطبع_سطر("100 / 4 = " + حاصل_قسمة)
    اطبع_سطر("17 % 5 = " + باقي_القسمة)

    # ======================================================
    # مثال 2: الأعداد العشرية
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 2: الأعداد العشرية ===")
    متغير باي = 3.14159
    متغير معدل = 95.75
    متغير سعر = 49.99
    متغير نسبة = 0.85
    اطبع_سطر("باي: " + باي)
    اطبع_سطر("المعدل: " + معدل)
    اطبع_سطر("السعر: " + سعر)
    اطبع_سطر("النسبة: " + نسبة)

    # عمليات حسابية على الأعداد العشرية
    متغير نتيجة_جمع = باي + 1.0
    متغير نتيجة_ضرب = سعر * 2.0
    متغير نصف_الباي = باي / 2.0
    اطبع_سطر("باي + 1.0 = " + نتيجة_جمع)
    اطبع_سطر("السعر * 2.0 = " + نتيجة_ضرب)
    اطبع_سطر("باي / 2.0 = " + نصف_الباي)

    # ======================================================
    # مثال 3: النصوص - التعريف والعمليات
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 3: النصوص ===")
    متغير تحية = "مرحباً"
    متغير اسم = "بالعالم"
    متغير جملة_طويلة = "لغة ص هي لغة برمجة عربية حديثة"
    اطبع_سطر("تحية: " + تحية)
    اطبع_سطر("اسم: " + اسم)
    اطبع_سطر("جملة: " + جملة_طويلة)

    # دمج النصوص
    متغير رسالة = تحية + " " + اسم + "!"
    اطبع_سطر("رسالة كاملة: " + رسالة)

    # دمج النصوص مع أرقام
    متغير عمر = 25
    متغير تعريف = "عمري " + عمر + " سنة"
    اطبع_سطر(تعريف)

    # ======================================================
    # مثال 4: القيم المنطقية
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 4: القيم المنطقية ===")
    متغير نعم = صحيح
    متغير لا = خطأ
    اطبع_سطر("قيمة صحيح: " + نعم)
    اطبع_سطر("قيمة خطأ: " + لا)

    # القيم المنطقية من المقارنات
    متغير أ = 10
    متغير ب = 20
    متغير هل_أكبر = أ > ب
    متغير هل_يساوي = أ == ب
    متغير هل_أصغر = أ < ب
    اطبع_سطر("10 > 20: " + هل_أكبر)
    اطبع_سطر("10 == 20: " + هل_يساوي)
    اطبع_سطر("10 < 20: " + هل_أصغر)

    # النفي المنطقي
    متغير ليس_صحيح = !نعم
    متغير ليس_خطأ = !لا
    اطبع_سطر("!صحيح = " + ليس_صحيح)
    اطبع_سطر("!خطأ = " + ليس_خطأ)

    # ======================================================
    # مثال 5: العمليات بين أنواع مختلفة
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 5: العمليات بين الأنواع ===")

    # الأعداد العشرية معاً
    متغير عدد_ص = 10.0
    متغير عشري_ق = 3.5
    متغير نتيجة_مختلطة = عدد_ص + عشري_ق
    اطبع_سطر("10.0 + 3.5 = " + نتيجة_مختلطة)

    متغير ضرب_مختلط = عدد_ص * عشري_ق
    اطبع_سطر("10.0 * 3.5 = " + ضرب_مختلط)

    # الأرقام مع النصوص عبر الدمج
    متغير الرقم = 42
    متغير النص_الناتج = "الإجابة هي: " + الرقم
    اطبع_سطر(النص_الناتج)

    متغير السعر_النهائي = 99.99
    اطبع_سطر("السعر: " + السعر_النهائي + " ريال")

    # ======================================================
    # مثال 6: الأس والعمليات المتقدمة
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 6: الأس والعمليات المتقدمة ===")

    # حساب الأس بالضرب اليدوي
    متغير مربع = 5 * 5
    متغير مكعب = 3 * 3 * 3
    متغير قوة_اثنين = 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2
    اطبع_سطر("5 * 5 = " + مربع)
    اطبع_سطر("3 * 3 * 3 = " + مكعب)
    اطبع_سطر("2^10 = " + قوة_اثنين)

    # عمليات متسلسلة
    متغير نتيجة1 = 2 + 3 * 4
    متغير نتيجة2 = (2 + 3) * 4
    اطبع_سطر("2 + 3 * 4 = " + نتيجة1)
    اطبع_سطر("(2 + 3) * 4 = " + نتيجة2)

    # ======================================================
    # مثال 7: المقارنات وأنواعها
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 7: المقارنات ===")

    متغير س = 15
    متغير ع = 15
    متغير ك = 20

    اطبع_سطر("س = " + س + " ع = " + ع + " ك = " + ك)
    اطبع_سطر("س == ع: " + (س == ع))
    اطبع_سطر("س != ك: " + (س != ك))
    اطبع_سطر("س < ك: " + (س < ك))
    اطبع_سطر("س > ك: " + (س > ك))
    اطبع_سطر("س <= ع: " + (س <= ع))
    اطبع_سطر("ك >= س: " + (ك >= س))

    # مقارنة النصوص
    متغير كلمة1 = "أحمد"
    متغير كلمة2 = "أحمد"
    متغير كلمة3 = "سارة"
    اطبع_سطر("أحمد == أحمد: " + (كلمة1 == كلمة2))
    اطبع_سطر("أحمد == سارة: " + (كلمة1 == كلمة3))

    # ======================================================
    # مثال 8: استخدام الأنواع مع الدوال
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 8: الأنواع مع الدوال ===")

    # استدعاء دوال تتعامل مع أنواع مختلفة
    متغير مضاعف = ضعف(21)
    اطبع_سطر("ضعف 21 = " + مضاعف)

    متغير وصف = وصف_العدد(42)
    اطبع_سطر("وصف 42: " + وصف)

    متغير وصف2 = وصف_العدد(0)
    اطبع_سطر("وصف 0: " + وصف2)

    متغير وصف3 = وصف_العدد(-5)
    اطبع_سطر("وصف -5: " + وصف3)

    # تجميع أنواع مختلفة باستخدام دالة
    عرض_بيانات("أحمد"، 30، 85)
    عرض_بيانات("سارة"، 25، 92)

    اطبع_سطر("")
    اطبع_سطر("=== انتهت أمثلة أنواع البيانات ===")
نهاية

