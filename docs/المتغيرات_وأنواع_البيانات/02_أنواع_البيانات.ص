# دالة تُرجع ضعف العدد
دالة ضعف(ن)
    ارجع ن * 2
نهاية

# دالة تصف العدد (موجب/سالب/صفر)
دالة نص وصف_العدد(ن)
    متغير وصف_ناتج = "صفر"
    إذا (ن > 0)
        وصف_ناتج = "عدد موجب"
    والا_اذا (ن < 0)
        وصف_ناتج = "عدد سالب"
    نهاية
    ارجع وصف_ناتج
نهاية

# دالة لعرض بيانات شخص (بديل عن استخدام الأصناف)
دالة عرض_بيانات(الاسم، العمر، المعدل)
    اطبع_سطر("الاسم: " + الاسم + " | العمر: " + العمر + " | المعدل: " + المعدل)
نهاية
