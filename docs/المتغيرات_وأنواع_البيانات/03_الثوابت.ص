# مثال 3: الثوابت
# المستوى: مبتدئ
# يوضح هذا المثال أنماط استخدام القيم الثابتة في لغة ص
# ملاحظة: نستخدم "متغير" هنا لأن "ثابت" قد يسبب مشاكل مع المترجم حالياً
# في الإصدارات المستقبلية، استبدل "متغير" بـ "ثابت" لمنع التعديل

# ======================================================
# مثال 1: ثوابت رياضية أساسية
# ======================================================

دالة رئيسية()
    اطبع_سطر("=== مثال 1: ثوابت رياضية ===")

    # هذه القيم ثوابت رياضية معروفة - لا يجب تعديلها
    متغير باي = 3.14159
    متغير هـ = 2.71828
    متغير الجذر2 = 1.41421
    متغير النسبة_الذهبية = 1.61803

    اطبع_سطر("ط (باي): " + باي)
    اطبع_سطر("هـ (أويلر): " + هـ)
    اطبع_سطر("جذر 2: " + الجذر2)
    اطبع_سطر("النسبة الذهبية: " + النسبة_الذهبية)

    # ======================================================
    # مثال 2: ثوابت فيزيائية
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 2: ثوابت فيزيائية ===")

    # ثوابت فيزيائية - قيم لا تتغير أبداً
    متغير سرعة_الضوء = 299792        # كم/ث
    متغير تسارع_الجاذبية = 9.81      # م/ث²
    متغير الصفر_المطلق = 273          # درجة مئوية (القيمة المطلقة)
    متغير سرعة_الصوت = 343            # م/ث في الهواء

    اطبع_سطر("سرعة الضوء: " + سرعة_الضوء + " كم/ث")
    اطبع_سطر("تسارع الجاذبية: " + تسارع_الجاذبية + " م/ث²")
    اطبع_سطر("الصفر المطلق: " + الصفر_المطلق + " درجة")
    اطبع_سطر("سرعة الصوت: " + سرعة_الصوت + " م/ث")

    # ======================================================
    # مثال 3: ثوابت البرنامج والإعدادات
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 3: ثوابت البرنامج ===")

    # معلومات ثابتة عن البرنامج
    متغير اسم_البرنامج = "نظام إدارة الطلاب"
    متغير الإصدار = "2.1.0"
    متغير المطور = "فريق لغة ص"
    متغير سنة_الإصدار = 2026

    اطبع_سطر("البرنامج: " + اسم_البرنامج)
    اطبع_سطر("الإصدار: " + الإصدار)
    اطبع_سطر("المطور: " + المطور)
    اطبع_سطر("سنة الإصدار: " + سنة_الإصدار)

    # ======================================================
    # مثال 4: استخدام الثوابت في حسابات الدائرة
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 4: حسابات الدائرة ===")

    # باي ثابت رياضي يُستخدم في حسابات الدائرة
    متغير ثابت_باي = 3.14159

    # جميع القيم عشرية لتجنب خلط الأنواع مع المترجم
    متغير نصف_القطر = 5.0
    متغير المحيط = 2.0 * ثابت_باي * نصف_القطر
    متغير المساحة = ثابت_باي * نصف_القطر * نصف_القطر

    اطبع_سطر("نصف القطر: " + نصف_القطر)
    اطبع_سطر("المحيط: " + المحيط)
    اطبع_سطر("المساحة: " + المساحة)

    متغير نصف_القطر2 = 10.0
    متغير المحيط2 = 2.0 * ثابت_باي * نصف_القطر2
    متغير المساحة2 = ثابت_باي * نصف_القطر2 * نصف_القطر2

    اطبع_سطر("نصف القطر: " + نصف_القطر2)
    اطبع_سطر("المحيط: " + المحيط2)
    اطبع_سطر("المساحة: " + المساحة2)

    # ======================================================
    # مثال 5: ثوابت مالية - الضرائب والعملات
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 5: ثوابت مالية ===")

    # نسب ضريبية ثابتة - لا يجب تعديلها في البرنامج
    # جميع القيم عشرية لتجنب خلط الأنواع
    متغير نسبة_الضريبة = 0.15       # 15% ضريبة القيمة المضافة
    متغير نسبة_الخصم = 0.10         # 10% خصم العملاء المميزين
    متغير عملة = "ريال"

    متغير سعر_المنتج = 200.0
    متغير قيمة_الضريبة = سعر_المنتج * نسبة_الضريبة
    متغير قيمة_الخصم = سعر_المنتج * نسبة_الخصم
    متغير السعر_بعد_الخصم = سعر_المنتج - قيمة_الخصم
    متغير الإجمالي = السعر_بعد_الخصم + قيمة_الضريبة

    اطبع_سطر("سعر المنتج: " + سعر_المنتج + " " + عملة)
    اطبع_سطر("الخصم: " + قيمة_الخصم + " " + عملة)
    اطبع_سطر("بعد الخصم: " + السعر_بعد_الخصم + " " + عملة)
    اطبع_سطر("الضريبة: " + قيمة_الضريبة + " " + عملة)
    اطبع_سطر("الإجمالي: " + الإجمالي + " " + عملة)

    # ======================================================
    # مثال 6: ثوابت تحويل الوحدات
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 6: تحويل الوحدات ===")

    # معاملات التحويل - قيم ثابتة عالمياً
    متغير كم_إلى_ميل = 0.621371
    متغير كغ_إلى_رطل = 2.20462
    متغير م_إلى_قدم = 3.28084
    متغير لتر_إلى_غالون = 0.264172

    # جميع القيم عشرية لتجنب خلط الأنواع مع معاملات التحويل
    متغير مسافة_كم = 100.0
    متغير وزن_كغ = 75.0
    متغير طول_م = 180.0

    اطبع_سطر(مسافة_كم + " كم = " + مسافة_كم * كم_إلى_ميل + " ميل")
    اطبع_سطر(وزن_كغ + " كغ = " + وزن_كغ * كغ_إلى_رطل + " رطل")
    اطبع_سطر(طول_م + " م = " + طول_م * م_إلى_قدم + " قدم")

    # ======================================================
    # مثال 7: ثوابت في الشروط والحدود
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 7: الحدود والشروط ===")

    # حدود ثابتة للنظام
    متغير الحد_الأدنى_للعمر = 18
    متغير الحد_الأقصى_للعمر = 65
    متغير الحد_الأدنى_للدرجة = 50
    متغير درجة_التميز = 90

    متغير عمر_المستخدم = 25
    متغير درجة_الطالب = 88

    # فحص العمر
    إذا (عمر_المستخدم >= الحد_الأدنى_للعمر)
        اطبع_سطر("العمر " + عمر_المستخدم + ": مسموح (الحد الأدنى " + الحد_الأدنى_للعمر + ")")
    وإلا
        اطبع_سطر("العمر " + عمر_المستخدم + ": غير مسموح")
    نهاية

    # فحص الدرجة
    إذا (درجة_الطالب >= درجة_التميز)
        اطبع_سطر("الدرجة " + درجة_الطالب + ": متميز!")
    والا_اذا (درجة_الطالب >= الحد_الأدنى_للدرجة)
        اطبع_سطر("الدرجة " + درجة_الطالب + ": ناجح")
    وإلا
        اطبع_سطر("الدرجة " + درجة_الطالب + ": راسب")
    نهاية

    # حلقة مع حد ثابت
    متغير الحد_الأقصى = 5
    متغير عداد = 1
    اطبع_سطر("العد حتى " + الحد_الأقصى + ":")
    بينما (عداد <= الحد_الأقصى)
        اطبع_سطر("  " + عداد)
        عداد = عداد + 1
    نهاية

    # ======================================================
    # مثال 8: تجميع الثوابت في صنف (نمط التنظيم)
    # ======================================================
    اطبع_سطر("")
    اطبع_سطر("=== مثال 8: تنظيم الثوابت في أصناف ===")

    # استخدام صنف لتجميع الثوابت المترابطة
    متغير إعدادات = جديد إعدادات_النظام("مخزن البيانات"، "3.0"، 500، 100)
    إعدادات.طباعة()

    # استخدام القيم الثابتة من الصنف
    اطبع_سطر("فحص حد الطلبات:")
    متغير طلبات_حالية = 450
    إذا (طلبات_حالية < إعدادات.الحد_الأقصى_للطلبات)
        متغير المتبقي = إعدادات.الحد_الأقصى_للطلبات - طلبات_حالية
        اطبع_سطر("  الطلبات: " + طلبات_حالية + " | المتبقي: " + المتبقي)
    وإلا
        اطبع_سطر("  تم الوصول للحد الأقصى!")
    نهاية

    اطبع_سطر("")
    اطبع_سطر("=== انتهت أمثلة الثوابت ===")
نهاية

# === صنف لتنظيم ثوابت النظام ===

صنف إعدادات_النظام
    باني(اسم، إصدار، حد_طلبات، حد_مستخدمين)
        هذا.اسم_النظام = اسم
        هذا.الإصدار = إصدار
        هذا.الحد_الأقصى_للطلبات = حد_طلبات
        هذا.الحد_الأقصى_للمستخدمين = حد_مستخدمين
    نهاية

    دالة طباعة()
        اطبع_سطر("النظام: " + هذا.اسم_النظام)
        اطبع_سطر("الإصدار: " + هذا.الإصدار)
        اطبع_سطر("حد الطلبات: " + هذا.الحد_الأقصى_للطلبات)
        اطبع_سطر("حد المستخدمين: " + هذا.الحد_الأقصى_للمستخدمين)
    نهاية
نهاية
