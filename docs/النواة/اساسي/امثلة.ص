# المثال 5: تعريف مصفوفة أعداد وطباعتها
مصفوفة درجات = [90، 85، 78]
اطبع_سطر("الدرجات: " + درجات)  # يطبع: الدرجات: [90, 85, 78]

# المثال 6: تعريف خريطة (قاموس) بيانات والوصول لقيمة
خريطة طالب = {"اسم": "ليلى"، "معدل": 95}
اطبع_سطر("اسم الطالبة: " + طالب["اسم"])  # يطبع: اسم الطالبة: ليلى

# المثال 7: تغيير قيمة متغير بعد تعريفه
