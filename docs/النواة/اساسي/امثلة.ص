# أمثلة أساسية على تعريف المتغيرات في لغة ص

# المثال 1: تعريف عدد صحيح وطباعته
رقم العمر = 25
اطبع_سطر("العمر هو: " + العمر)  # يطبع: العمر هو: 25

# المثال 2: تعريف عدد عشري واستخدامه في عملية حسابية
عشري النسبة = 0.75
اطبع_سطر("النسبة: " + النسبة * 100 + "%")  # يطبع: النسبة: 75%

