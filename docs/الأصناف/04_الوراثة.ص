# ========================================
# دوال مساعدة
# ========================================

دالة رقم حساب_مكافأة(سنوات_خبرة)
    متغير مكافأة = 500
    إذا (سنوات_خبرة > 10)
        مكافأة = 2000
    والا_اذا (سنوات_خبرة > 5)
        مكافأة = 1000
    نهاية
    ارجع مكافأة
نهاية

دالة رقم تحديد_المستوى(سنوات)
    متغير مستوى = 1
    إذا (سنوات > 10)
        مستوى = 4
    والا_اذا (سنوات > 5)
        مستوى = 3
    والا_اذا (سنوات > 2)
        مستوى = 2
    نهاية
    ارجع مستوى
نهاية

# ========================================
# التنفيذ: 8 أمثلة تعليمية
# ========================================

دالة رئيسية()
    # === المثال 1: صنف بسيط مع حقول وطرق ===
    اطبع_سطر("=== المثال 1: صنف بسيط ===")
    متغير س1 = جديد عنصر("قلم"، 5)
    متغير س2 = جديد عنصر("دفتر"، 15)
    س1.عرض()
    س2.عرض()
    اطبع_سطر("  العنصران: " + س1.الاسم + " و " + س2.الاسم)
    اطبع_سطر("")

    # === المثال 2: صنف عداد مع عمليات ===
    اطبع_سطر("=== المثال 2: عداد مع عمليات ===")
    متغير ع1 = جديد عداد("المخزون"، 100)
    ع1.عرض()
    متغير ز1 = ع1.زيادة(50)
    متغير ن1 = ع1.نقصان(30)
    ع1.عرض()
    اطبع_سطر("")

    # === المثال 3: التنسيق بين صنفين عبر القيم ===
    اطبع_سطر("=== المثال 3: التنسيق بين صنفين ===")
    متغير م1 = جديد منتج("لابتوب"، 3000)
    م1.عرض()
    متغير سعر_م1 = م1.احصل_السعر()
    متغير ط1 = جديد طلبية("ط001"، 3)
    متغير مجموع1 = ط1.حساب(سعر_م1)
    اطبع_سطر("  اجمالي الطلب: " + مجموع1 + " ريال")
    اطبع_سطر("")

    # === المثال 4: تجميع البيانات من كائنات متعددة ===
    اطبع_سطر("=== المثال 4: تجميع البيانات ===")
    متغير مو1 = جديد موظف("أحمد"، 8000)
    متغير مو2 = جديد موظف("سارة"، 9000)
    متغير مو3 = جديد موظف("خالد"، 7500)
    مو1.عرض()
    مو2.عرض()
    مو3.عرض()
    متغير تق = جديد تقرير("الرواتب"، 0)
    متغير ر1 = مو1.احصل_الراتب()
    متغير ر2 = مو2.احصل_الراتب()
    متغير ر3 = مو3.احصل_الراتب()
    متغير ت1 = تق.اضف(ر1)
    متغير ت2 = تق.اضف(ر2)
    متغير ت3 = تق.اضف(ر3)
    تق.عرض()
    اطبع_سطر("")

    # === المثال 5: توسيع السلوك بدوال مساعدة ===
    اطبع_سطر("=== المثال 5: دوال مساعدة ===")
    متغير خبرة1 = 7
    متغير مكافأة1 = حساب_مكافأة(خبرة1)
    متغير مستوى1 = تحديد_المستوى(خبرة1)
    اطبع_سطر("  الموظف: " + مو1.الاسم)
    اطبع_سطر("  الخبرة: " + خبرة1 + " سنوات")
    اطبع_سطر("  المستوى: " + مستوى1)
    اطبع_سطر("  المكافأة: " + مكافأة1 + " ريال")
    متغير خبرة2 = 12
    متغير مكافأة2 = حساب_مكافأة(خبرة2)
    متغير مستوى2 = تحديد_المستوى(خبرة2)
    اطبع_سطر("  الموظف: " + مو2.الاسم)
    اطبع_سطر("  الخبرة: " + خبرة2 + " سنوات")
    اطبع_سطر("  المستوى: " + مستوى2)
    اطبع_سطر("  المكافأة: " + مكافأة2 + " ريال")
    اطبع_سطر("")

    # === المثال 6: ادارة المهام ===
    اطبع_سطر("=== المثال 6: ادارة المهام ===")
    متغير مه1 = جديد مهمة("تصميم الواجهة"، 3)
    متغير مه2 = جديد مهمة("كتابة الكود"، 5)
    متغير مه3 = جديد مهمة("الاختبار"، 2)
    مه1.عرض()
    مه2.عرض()
    مه3.عرض()
    متغير مدة1 = مه1.احصل_المدة()
    متغير مدة2 = مه2.احصل_المدة()
    متغير وقت_كلي = مدة1 + مدة2
    اطبع_سطر("  المهام المنجزة: 2 من 3")
    اطبع_سطر("  الوقت المستغرق: " + وقت_كلي + " ساعات")
    اطبع_سطر("")

    # === المثال 7: تبادل البيانات بين الأصناف ===
    اطبع_سطر("=== المثال 7: تبادل البيانات ===")
    متغير خ1 = جديد خزنة("الصندوق أ"، 5000)
    متغير خ2 = جديد خزنة("الصندوق ب"، 2000)
    متغير مبلغ_تحويل = 1500
    اطبع_سطر("  تحويل " + مبلغ_تحويل + ":")
    متغير نجح = خ1.اسحب(مبلغ_تحويل)
    إذا (نجح == 1)
        متغير ا1 = خ2.اضف(مبلغ_تحويل)
    نهاية
    اطبع_سطر("  محاولة تحويل 10000:")
    متغير نجح2 = خ1.اسحب(10000)
    إذا (نجح2 == 1)
        متغير ا2 = خ2.اضف(10000)
    نهاية
    اطبع_سطر("")

    # === المثال 8: نظام متجر شامل ===
    اطبع_سطر("=== المثال 8: نظام المتجر الشامل ===")
    متغير ب1 = جديد بضاعة("هاتف"، 2500)
    متغير ب2 = جديد بضاعة("سماعة"، 350)
    ب1.عرض()
    ب2.عرض()
    اطبع_سطر("")
    متغير الصندوق = جديد صندوق("صندوق المتجر"، 0)
    اطبع_سطر("--- عمليات البيع ---")
    متغير سعر1 = ب1.احصل_السعر()
    متغير قيمة1 = سعر1 * 2
    اطبع_سطر("  بيع 2 من " + ب1.الاسم + " بسعر " + سعر1)
    متغير ج1 = الصندوق.تحصيل(قيمة1)
    متغير سعر2 = ب2.احصل_السعر()
    متغير قيمة2 = سعر2 * 5
    اطبع_سطر("  بيع 5 من " + ب2.الاسم + " بسعر " + سعر2)
    متغير ج2 = الصندوق.تحصيل(قيمة2)
    اطبع_سطر("")
    اطبع_سطر("--- الملخص ---")
    متغير اجمالي = الصندوق.احصل_الرصيد()
    اطبع_سطر("  اجمالي الصندوق: " + اجمالي + " ريال")
نهاية
