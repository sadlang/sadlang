نهاية

# --- صنف خزنة ---
صنف خزنة
    باني(الاسم، الرصيد)
        هذا.الاسم = الاسم
        هذا.الرصيد = الرصيد
    نهاية

    دالة رقم احصل_الرصيد()
        ارجع هذا.الرصيد
    نهاية

    دالة رقم اضف(مبلغ)
        هذا.الرصيد = هذا.الرصيد + مبلغ
        اطبع_سطر("  " + هذا.الاسم + ": +" + مبلغ + " = " + هذا.الرصيد)
        ارجع هذا.الرصيد
    نهاية

    دالة رقم اسحب(مبلغ)
        متغير تم = 0
        إذا (مبلغ <= هذا.الرصيد)
            هذا.الرصيد = هذا.الرصيد - مبلغ
            اطبع_سطر("  " + هذا.الاسم + ": -" + مبلغ + " = " + هذا.الرصيد)
            تم = 1
        وإلا
            اطبع_سطر("  " + هذا.الاسم + ": رصيد غير كاف")
        نهاية
        ارجع تم
    نهاية
نهاية

