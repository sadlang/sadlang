    نهاية
نهاية

# --- صنف تقرير ---
صنف تقرير
    باني(العنوان، المجموع)
        هذا.العنوان = العنوان
        هذا.المجموع = المجموع
    نهاية

    دالة رقم اضف(مبلغ)
        هذا.المجموع = هذا.المجموع + مبلغ
        اطبع_سطر("  اضافة " + مبلغ + " للتقرير (المجموع: " + هذا.المجموع + ")")
        ارجع هذا.المجموع
    نهاية

    دالة رقم احصل_المجموع()
        ارجع هذا.المجموع
    نهاية

    دالة عرض()
        اطبع_سطر("  تقرير [" + هذا.العنوان + "]: المجموع = " + هذا.المجموع)
    نهاية
نهاية

