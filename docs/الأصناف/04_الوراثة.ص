# مثال 4: التكوين والتوسيع (Composition and Extension)
# المستوى: متوسط
# بدلاً من الوراثة نستخدم التكوين: أصناف مستقلة ودوال تنسيقية تتعاون معاً
# لإعادة استخدام الكود نقرأ القيم من كائن عبر حقوله ونمررها لكائن آخر

# ========================================
# تعريف الأصناف
# ========================================

# --- صنف عنصر بسيط ---
صنف عنصر
    باني(الاسم، السعر)
        هذا.الاسم = الاسم
        هذا.السعر = السعر
    نهاية

    دالة رقم احصل_السعر()
        ارجع هذا.السعر
    نهاية

    دالة عرض()
        اطبع_سطر("  " + هذا.الاسم + ": " + هذا.السعر + " ريال")
    نهاية
نهاية

# --- صنف عداد ---
صنف عداد
    باني(الاسم، القيمة)
        هذا.الاسم = الاسم
        هذا.القيمة = القيمة
    نهاية

    دالة رقم زيادة(مقدار)
        هذا.القيمة = هذا.القيمة + مقدار
        اطبع_سطر("  " + هذا.الاسم + " بعد زيادة " + مقدار + ": " + هذا.القيمة)
        ارجع هذا.القيمة
    نهاية

    دالة رقم نقصان(مقدار)
        هذا.القيمة = هذا.القيمة - مقدار
        اطبع_سطر("  " + هذا.الاسم + " بعد نقص " + مقدار + ": " + هذا.القيمة)
        ارجع هذا.القيمة
    نهاية

    دالة رقم احصل_القيمة()
        ارجع هذا.القيمة
    نهاية

    دالة عرض()
        اطبع_سطر("  " + هذا.الاسم + " = " + هذا.القيمة)
    نهاية
نهاية

