نهاية

# --- صنف طلبية ---
صنف طلبية
    باني(الرمز، العدد)
        هذا.الرمز = الرمز
        هذا.العدد = العدد
    نهاية

    دالة رقم حساب(سعر_الوحدة)
        متغير المجموع = هذا.العدد * سعر_الوحدة
        اطبع_سطر("  طلب " + هذا.الرمز + ": " + هذا.العدد + " وحدات × " + سعر_الوحدة + " = " + المجموع)
        ارجع المجموع
    نهاية
نهاية

