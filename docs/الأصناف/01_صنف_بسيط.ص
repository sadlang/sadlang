# مثال 1: صنف بسيط
# المستوى: مبتدئ

# === تعريف صنف بسيط ===

صنف شخص
    باني(اسم، عمر)
        هذا.اسم = اسم
        هذا.عمر = عمر
    نهاية

    دالة عرض()
        اطبع_سطر("الاسم: " + هذا.اسم + "، العمر: " + هذا.عمر)
    نهاية
نهاية

صنف منتج
    باني(الاسم، السعر)
        هذا.الاسم = الاسم
        هذا.السعر = السعر
    نهاية

    دالة معلومات()
        اطبع_سطر(هذا.الاسم + " - " + هذا.السعر + " ريال")
    نهاية
نهاية

دالة رئيسية()
    # === إنشاء كائنات ===
    اطبع_سطر("=== إنشاء كائنات ===")
    متغير أحمد = جديد شخص("أحمد"، 25)
    متغير سارة = جديد شخص("سارة"، 22)
    متغير فهد = جديد شخص("فهد"، 30)

    # === استدعاء الطرق ===
    أحمد.عرض()
    سارة.عرض()
    فهد.عرض()

    # === الوصول للحقول ===
    اطبع_سطر("")
    اطبع_سطر("=== الوصول المباشر للحقول ===")
    اطبع_سطر("اسم أحمد: " + أحمد.اسم)
    اطبع_سطر("عمر سارة: " + سارة.عمر)

    # === تعديل حقل ===
    اطبع_سطر("")
    اطبع_سطر("=== بعد تعديل العمر ===")
    أحمد.عمر = 26
    أحمد.عرض()

    # === صنف آخر ===
    اطبع_سطر("")
    اطبع_سطر("=== المنتجات ===")
    متغير م1 = جديد منتج("لابتوب"، 3500)
    متغير م2 = جديد منتج("هاتف"، 2000)
    م1.معلومات()
    م2.معلومات()
نهاية
