# مثال 7: البنى والتعدادات
# المستوى: متوسط
# أصناف بسيطة كبنى (data-only) وثوابت رقمية كتعدادات

# === تعدادات باستخدام ثوابت رقمية ===

# ألوان
متغير لون_أحمر = 1
متغير لون_أخضر = 2
متغير لون_أزرق = 3
متغير لون_أصفر = 4
متغير لون_أبيض = 5

# حالات الطلب
متغير حالة_جديد = 0
متغير حالة_قيد_التنفيذ = 1
متغير حالة_مكتمل = 2
متغير حالة_ملغي = 3

# أنواع الأولوية
متغير أولوية_منخفضة = 1
متغير أولوية_عادية = 2
متغير أولوية_عالية = 3
متغير أولوية_حرجة = 4

# === دوال مساعدة للتعدادات ===

دالة اسم_اللون(رقم_اللون)
    إذا (رقم_اللون == 1)
        ارجع "أحمر"
    والا_اذا (رقم_اللون == 2)
        ارجع "أخضر"
    والا_اذا (رقم_اللون == 3)
        ارجع "أزرق"
    والا_اذا (رقم_اللون == 4)
        ارجع "أصفر"
    والا_اذا (رقم_اللون == 5)
        ارجع "أبيض"
    وإلا
        ارجع "غير معروف"
    نهاية
نهاية

دالة اسم_الحالة(رقم_الحالة)
    إذا (رقم_الحالة == 0)
        ارجع "جديد"
    والا_اذا (رقم_الحالة == 1)
        ارجع "قيد التنفيذ"
    والا_اذا (رقم_الحالة == 2)
        ارجع "مكتمل"
    والا_اذا (رقم_الحالة == 3)
        ارجع "ملغي"
    وإلا
        ارجع "غير معروف"
    نهاية
نهاية

دالة اسم_الأولوية(رقم_الأولوية)
    إذا (رقم_الأولوية == 1)
        ارجع "منخفضة"
    والا_اذا (رقم_الأولوية == 2)
        ارجع "عادية"
    والا_اذا (رقم_الأولوية == 3)
        ارجع "عالية"
    والا_اذا (رقم_الأولوية == 4)
        ارجع "حرجة"
    وإلا
        ارجع "غير معروف"
    نهاية
نهاية

# === بنية نقطة ===
صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة عرض()
        اطبع_سطر("(" + هذا.س + "، " + هذا.ص + ")")
    نهاية

    دالة مربع_المسافة()
        ارجع هذا.س * هذا.س + هذا.ص * هذا.ص
    نهاية
نهاية

# === بنية لون RGB ===
صنف لون_ر_ج_ز
    باني(أحمر، أخضر، أزرق)
        هذا.أحمر = أحمر
        هذا.أخضر = أخضر
        هذا.أزرق = أزرق
    نهاية

    دالة عرض()
        اطبع_سطر("RGB(" + هذا.أحمر + "، " + هذا.أخضر + "، " + هذا.أزرق + ")")
    نهاية
نهاية

# === بنية تاريخ ===
صنف تاريخ
    باني(اليوم، الشهر، السنة)
        هذا.اليوم = اليوم
        هذا.الشهر = الشهر
        هذا.السنة = السنة
    نهاية

    دالة عرض()
        اطبع_سطر(هذا.اليوم + "/" + هذا.الشهر + "/" + هذا.السنة)
    نهاية
نهاية

# === صنف طلب (يستخدم التعدادات) ===
صنف طلب
    باني(رقم_الطلب، المنتج، الأولوية)
        هذا.الرقم = رقم_الطلب
        هذا.المنتج = المنتج
        هذا.الحالة = حالة_جديد
        هذا.الأولوية = الأولوية
    نهاية

    دالة تحديث_الحالة(حالة_جديدة)
        هذا.الحالة = حالة_جديدة
        اطبع_سطر("طلب #" + هذا.الرقم + " -> " + اسم_الحالة(حالة_جديدة))
    نهاية

    دالة عرض()
        اطبع_سطر("طلب #" + هذا.الرقم + ": " + هذا.المنتج)
        اطبع_سطر("  الحالة: " + اسم_الحالة(هذا.الحالة))
        اطبع_سطر("  الأولوية: " + اسم_الأولوية(هذا.الأولوية))
    نهاية
نهاية

# === بنية مقاسات ===
صنف مقاسات
    باني(الطول، العرض، الارتفاع)
        هذا.الطول = الطول
        هذا.العرض = العرض
        هذا.الارتفاع = الارتفاع
        هذا.الحجم = الطول * العرض * الارتفاع
    نهاية

    دالة عرض()
        اطبع_سطر(هذا.الطول + " x " + هذا.العرض + " x " + هذا.الارتفاع)
        اطبع_سطر("  الحجم: " + هذا.الحجم)
    نهاية
نهاية

دالة رئيسية()
    # === البنى ===
    اطبع_سطر("=== البنى (Structs) ===")
    اطبع_سطر("")

    اطبع_سطر("--- النقاط ---")
    متغير ن1 = جديد نقطة(3، 4)
    متغير ن2 = جديد نقطة(0، 0)
    متغير ن3 = جديد نقطة(6، 8)
    ن1.عرض()
    ن2.عرض()
    ن3.عرض()
    اطبع_سطر("مربع المسافة للنقطة (3,4): " + ن1.مربع_المسافة())
    اطبع_سطر("مربع المسافة للنقطة (6,8): " + ن3.مربع_المسافة())

    اطبع_سطر("")
    اطبع_سطر("--- الألوان RGB ---")
    متغير ل1 = جديد لون_ر_ج_ز(255، 0، 0)
    متغير ل2 = جديد لون_ر_ج_ز(0، 128، 255)
    متغير ل3 = جديد لون_ر_ج_ز(64، 224، 208)
    ل1.عرض()
    ل2.عرض()
    ل3.عرض()

    اطبع_سطر("")
    اطبع_سطر("--- التواريخ ---")
    متغير ت1 = جديد تاريخ(15، 6، 2025)
    متغير ت2 = جديد تاريخ(1، 1، 2026)
    ت1.عرض()
    ت2.عرض()

    اطبع_سطر("")
    اطبع_سطر("--- المقاسات ---")
    متغير صندوق = جديد مقاسات(30، 20، 15)
    صندوق.عرض()

    # === التعدادات ===
    اطبع_سطر("")
    اطبع_سطر("=== التعدادات (Enums) ===")
    اطبع_سطر("")

    اطبع_سطر("--- الألوان كتعداد ---")
    اطبع_سطر("اللون 1: " + اسم_اللون(لون_أحمر))
    اطبع_سطر("اللون 2: " + اسم_اللون(لون_أزرق))
    اطبع_سطر("اللون 3: " + اسم_اللون(لون_أصفر))
    اطبع_سطر("رقم غير صالح: " + اسم_اللون(99))

    اطبع_سطر("")
    اطبع_سطر("--- الأولويات ---")
    اطبع_سطر("أولوية 1: " + اسم_الأولوية(أولوية_منخفضة))
    اطبع_سطر("أولوية 4: " + اسم_الأولوية(أولوية_حرجة))

    # === نظام الطلبات ===
    اطبع_سطر("")
    اطبع_سطر("--- نظام الطلبات ---")
    متغير ط1 = جديد طلب(101، "لابتوب"، أولوية_عالية)
    متغير ط2 = جديد طلب(102، "هاتف"، أولوية_عادية)
    متغير ط3 = جديد طلب(103، "خادم"، أولوية_حرجة)

    ط1.عرض()
    اطبع_سطر("")
    ط2.عرض()
    اطبع_سطر("")
    ط3.عرض()

    اطبع_سطر("")
    اطبع_سطر("--- تحديث الحالات ---")
    ط1.تحديث_الحالة(حالة_قيد_التنفيذ)
    ط2.تحديث_الحالة(حالة_قيد_التنفيذ)
    ط3.تحديث_الحالة(حالة_قيد_التنفيذ)
    ط1.تحديث_الحالة(حالة_مكتمل)
    ط2.تحديث_الحالة(حالة_ملغي)
    ط3.تحديث_الحالة(حالة_مكتمل)

    اطبع_سطر("")
    اطبع_سطر("--- الحالة النهائية ---")
    ط1.عرض()
    اطبع_سطر("")
    ط2.عرض()
    اطبع_سطر("")
    ط3.عرض()
نهاية
