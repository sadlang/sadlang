# مثال 8: نظام بنكي متكامل
# المستوى: متقدم
# مشروع يجمع مفاهيم OOP: أصناف متعددة، تغليف، تجميع، طرق متقدمة
# لا يستخدم مصفوفات - يعتمد على حقول بسيطة وعدادات

# === تعدادات حالة الحساب ===
متغير حالة_نشط = 1
متغير حالة_مجمد = 2
متغير حالة_مغلق = 3

دالة اسم_حالة_الحساب(الحالة)
    إذا (الحالة == 1)
        ارجع "نشط"
    والا_اذا (الحالة == 2)
        ارجع "مجمد"
    والا_اذا (الحالة == 3)
        ارجع "مغلق"
    وإلا
        ارجع "غير معروف"
    نهاية
نهاية

# === تعدادات نوع العملية ===
متغير عملية_إيداع = 1
متغير عملية_سحب = 2
متغير عملية_تحويل_صادر = 3
متغير عملية_تحويل_وارد = 4

دالة اسم_العملية(النوع)
    إذا (النوع == 1)
        ارجع "إيداع"
    والا_اذا (النوع == 2)
        ارجع "سحب"
    والا_اذا (النوع == 3)
        ارجع "تحويل صادر"
    والا_اذا (النوع == 4)
        ارجع "تحويل وارد"
    وإلا
        ارجع "غير معروف"
    نهاية
نهاية

# === عداد عمليات عام ===
متغير عداد_العمليات_الكلي = 0
متغير إجمالي_الأموال_المتحركة = 0

# === صنف العملية ===
صنف عملية
    باني(نوع_العملية، المبلغ، الوصف)
        عداد_العمليات_الكلي = عداد_العمليات_الكلي + 1
        هذا.الرقم = عداد_العمليات_الكلي
        هذا.النوع = نوع_العملية
        هذا.المبلغ = المبلغ
        هذا.الوصف = الوصف
        إجمالي_الأموال_المتحركة = إجمالي_الأموال_المتحركة + المبلغ
    نهاية

    دالة عرض()
        اطبع_سطر("  عملية #" + هذا.الرقم + " | " + اسم_العملية(هذا.النوع) + " | " + هذا.المبلغ + " ريال | " + هذا.الوصف)
    نهاية
نهاية

# === صنف الحساب ===
صنف حساب
    باني(رقم_الحساب، اسم_المالك، الرصيد_الأولي)
        هذا.الرقم = رقم_الحساب
        هذا.المالك = اسم_المالك
        هذا.الرصيد = الرصيد_الأولي
        هذا.الحالة = حالة_نشط
        هذا.عدد_العمليات = 0
        هذا.إجمالي_الإيداعات = 0
        هذا.إجمالي_السحوبات = 0
        هذا.آخر_عملية_رقم = 0
        هذا.آخر_عملية_نوع = ""
        هذا.آخر_عملية_مبلغ = 0
    نهاية

    # التحقق من إمكانية التنفيذ
    دالة رقم نشط()
        متغير نتيجة = 0
        إذا (هذا.الحالة == حالة_نشط)
            نتيجة = 1
        نهاية
        ارجع نتيجة
    نهاية

    # إيداع
    دالة رقم إيداع(مبلغ)
        متغير نتيجة = 0
        متغير رصيد_ج = هذا.الرصيد
        متغير عمليات_ج = هذا.عدد_العمليات
        متغير إيداعات_ج = هذا.إجمالي_الإيداعات
        متغير آخر_رقم = هذا.آخر_عملية_رقم
        متغير آخر_نوع = هذا.آخر_عملية_نوع
        متغير آخر_مبلغ = هذا.آخر_عملية_مبلغ
        إذا (هذا.نشط() == 0)
            اطبع_سطر("خطأ: الحساب " + هذا.الرقم + " غير نشط")
        والا_اذا (مبلغ <= 0)
            اطبع_سطر("خطأ: المبلغ يجب أن يكون موجباً")
        وإلا
            رصيد_ج = رصيد_ج + مبلغ
            عمليات_ج = عمليات_ج + 1
            إيداعات_ج = إيداعات_ج + مبلغ
            متغير ع = جديد عملية(عملية_إيداع، مبلغ، "إيداع في " + هذا.الرقم)
            آخر_رقم = ع.الرقم
            آخر_نوع = "إيداع"
            آخر_مبلغ = مبلغ
            اطبع_سطر("تم إيداع " + مبلغ + " ريال -> الرصيد: " + رصيد_ج)
            نتيجة = 1
        نهاية
        هذا.الرصيد = رصيد_ج
        هذا.عدد_العمليات = عمليات_ج
        هذا.إجمالي_الإيداعات = إيداعات_ج
        هذا.آخر_عملية_رقم = آخر_رقم
        هذا.آخر_عملية_نوع = آخر_نوع
        هذا.آخر_عملية_مبلغ = آخر_مبلغ
        ارجع نتيجة
    نهاية

    # سحب
    دالة رقم سحب(مبلغ)
        متغير نتيجة = 0
        متغير رصيد_ج = هذا.الرصيد
        متغير عمليات_ج = هذا.عدد_العمليات
        متغير سحوبات_ج = هذا.إجمالي_السحوبات
        متغير آخر_رقم = هذا.آخر_عملية_رقم
        متغير آخر_نوع = هذا.آخر_عملية_نوع
        متغير آخر_مبلغ = هذا.آخر_عملية_مبلغ
        إذا (هذا.نشط() == 0)
            اطبع_سطر("خطأ: الحساب " + هذا.الرقم + " غير نشط")
        والا_اذا (مبلغ <= 0)
            اطبع_سطر("خطأ: المبلغ يجب أن يكون موجباً")
        والا_اذا (مبلغ > هذا.الرصيد)
            اطبع_سطر("خطأ: رصيد غير كافٍ (المتاح: " + هذا.الرصيد + ")")
        وإلا
            رصيد_ج = رصيد_ج - مبلغ
            عمليات_ج = عمليات_ج + 1
            سحوبات_ج = سحوبات_ج + مبلغ
            متغير ع = جديد عملية(عملية_سحب، مبلغ، "سحب من " + هذا.الرقم)
            آخر_رقم = ع.الرقم
            آخر_نوع = "سحب"
            آخر_مبلغ = مبلغ
            اطبع_سطر("تم سحب " + مبلغ + " ريال -> الرصيد: " + رصيد_ج)
            نتيجة = 1
        نهاية
        هذا.الرصيد = رصيد_ج
        هذا.عدد_العمليات = عمليات_ج
        هذا.إجمالي_السحوبات = سحوبات_ج
        هذا.آخر_عملية_رقم = آخر_رقم
        هذا.آخر_عملية_نوع = آخر_نوع
        هذا.آخر_عملية_مبلغ = آخر_مبلغ
        ارجع نتيجة
    نهاية

    # تجميد
    دالة تجميد()
        هذا.الحالة = حالة_مجمد
        اطبع_سطر("تم تجميد حساب " + هذا.المالك + " (" + هذا.الرقم + ")")
    نهاية

    # تنشيط
    دالة رقم تنشيط()
        متغير نتيجة = 0
        متغير حالة_ج = هذا.الحالة
        إذا (هذا.الحالة == حالة_مغلق)
            اطبع_سطر("خطأ: لا يمكن تنشيط حساب مغلق")
        وإلا
            حالة_ج = حالة_نشط
            اطبع_سطر("تم تنشيط حساب " + هذا.المالك)
            نتيجة = 1
        نهاية
        هذا.الحالة = حالة_ج
        ارجع نتيجة
    نهاية

    # إغلاق
    دالة رقم إغلاق()
        متغير نتيجة = 0
        متغير حالة_ج = هذا.الحالة
        إذا (هذا.الرصيد > 0)
            اطبع_سطر("تحذير: يجب سحب الرصيد " + هذا.الرصيد + " قبل الإغلاق")
        وإلا
            حالة_ج = حالة_مغلق
            اطبع_سطر("تم إغلاق حساب " + هذا.المالك)
            نتيجة = 1
        نهاية
        هذا.الحالة = حالة_ج
        ارجع نتيجة
    نهاية

    # كشف حساب
    دالة كشف_حساب()
        اطبع_سطر("========================================")
        اطبع_سطر("  كشف حساب: " + هذا.المالك)
        اطبع_سطر("  رقم الحساب: " + هذا.الرقم)
        اطبع_سطر("  الحالة: " + اسم_حالة_الحساب(هذا.الحالة))
        اطبع_سطر("  الرصيد الحالي: " + هذا.الرصيد + " ريال")
        اطبع_سطر("  عدد العمليات: " + هذا.عدد_العمليات)
        اطبع_سطر("  إجمالي الإيداعات: " + هذا.إجمالي_الإيداعات + " ريال")
        اطبع_سطر("  إجمالي السحوبات: " + هذا.إجمالي_السحوبات + " ريال")
        إذا (هذا.عدد_العمليات > 0)
            اطبع_سطر("  آخر عملية: " + هذا.آخر_عملية_نوع + " بمبلغ " + هذا.آخر_عملية_مبلغ)
        نهاية
        اطبع_سطر("========================================")
    نهاية
نهاية

# === صنف البنك ===
صنف بنك
    باني(اسم_البنك)
        هذا.الاسم = اسم_البنك
        هذا.عدد_الحسابات = 0
        هذا.عدد_التحويلات = 0
        هذا.إجمالي_التحويلات = 0
    نهاية

    # تحويل بين حسابين
    دالة رقم تحويل(من_حساب، إلى_حساب، مبلغ)
        متغير نتيجة = 0
        متغير تحويلات_ج = هذا.عدد_التحويلات
        متغير إجمالي_ج = هذا.إجمالي_التحويلات
        إذا (مبلغ <= 0)
            اطبع_سطر("خطأ: مبلغ التحويل يجب أن يكون موجباً")
        والا_اذا (من_حساب.الحالة != حالة_نشط)
            اطبع_سطر("خطأ: حساب المرسل غير نشط")
        والا_اذا (إلى_حساب.الحالة != حالة_نشط)
            اطبع_سطر("خطأ: حساب المستلم غير نشط")
        والا_اذا (مبلغ > من_حساب.الرصيد)
            اطبع_سطر("خطأ: رصيد غير كافٍ في حساب " + من_حساب.المالك)
        وإلا
            # تنفيذ التحويل
            من_حساب.الرصيد = من_حساب.الرصيد - مبلغ
            من_حساب.عدد_العمليات = من_حساب.عدد_العمليات + 1
            من_حساب.إجمالي_السحوبات = من_حساب.إجمالي_السحوبات + مبلغ
            متغير ع1 = جديد عملية(عملية_تحويل_صادر، مبلغ، "تحويل من " + من_حساب.الرقم + " إلى " + إلى_حساب.الرقم)
            من_حساب.آخر_عملية_رقم = ع1.الرقم
            من_حساب.آخر_عملية_نوع = "تحويل صادر"
            من_حساب.آخر_عملية_مبلغ = مبلغ

            إلى_حساب.الرصيد = إلى_حساب.الرصيد + مبلغ
            إلى_حساب.عدد_العمليات = إلى_حساب.عدد_العمليات + 1
            إلى_حساب.إجمالي_الإيداعات = إلى_حساب.إجمالي_الإيداعات + مبلغ
            متغير ع2 = جديد عملية(عملية_تحويل_وارد، مبلغ، "تحويل إلى " + إلى_حساب.الرقم + " من " + من_حساب.الرقم)
            إلى_حساب.آخر_عملية_رقم = ع2.الرقم
            إلى_حساب.آخر_عملية_نوع = "تحويل وارد"
            إلى_حساب.آخر_عملية_مبلغ = مبلغ

            تحويلات_ج = تحويلات_ج + 1
            إجمالي_ج = إجمالي_ج + مبلغ
            اطبع_سطر("تم تحويل " + مبلغ + " ريال من " + من_حساب.المالك + " إلى " + إلى_حساب.المالك)
            نتيجة = 1
        نهاية
        هذا.عدد_التحويلات = تحويلات_ج
        هذا.إجمالي_التحويلات = إجمالي_ج
        ارجع نتيجة
    نهاية

    # إحصائيات البنك
    دالة إحصائيات()
        اطبع_سطر("========================================")
        اطبع_سطر("  إحصائيات " + هذا.الاسم)
        اطبع_سطر("  عدد الحسابات: " + هذا.عدد_الحسابات)
        اطبع_سطر("  عدد التحويلات: " + هذا.عدد_التحويلات)
        اطبع_سطر("  إجمالي التحويلات: " + هذا.إجمالي_التحويلات + " ريال")
        اطبع_سطر("  إجمالي العمليات في النظام: " + عداد_العمليات_الكلي)
        اطبع_سطر("  إجمالي الأموال المتحركة: " + إجمالي_الأموال_المتحركة + " ريال")
        اطبع_سطر("========================================")
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== نظام بنكي متكامل ===")
    اطبع_سطر("")

    # إنشاء البنك
    متغير البنك = جديد بنك("بنك ص العربي")

    # إنشاء حسابات
    اطبع_سطر("--- فتح الحسابات ---")
    متغير ح1 = جديد حساب("SA-1001"، "أحمد"، 10000)
    البنك.عدد_الحسابات = البنك.عدد_الحسابات + 1
    اطبع_سطر("تم فتح حساب " + ح1.المالك + " برصيد " + ح1.الرصيد)

    متغير ح2 = جديد حساب("SA-1002"، "سارة"، 7500)
    البنك.عدد_الحسابات = البنك.عدد_الحسابات + 1
    اطبع_سطر("تم فتح حساب " + ح2.المالك + " برصيد " + ح2.الرصيد)

    متغير ح3 = جديد حساب("SA-1003"، "فهد"، 3000)
    البنك.عدد_الحسابات = البنك.عدد_الحسابات + 1
    اطبع_سطر("تم فتح حساب " + ح3.المالك + " برصيد " + ح3.الرصيد)

    # عمليات إيداع
    اطبع_سطر("")
    اطبع_سطر("--- عمليات الإيداع ---")
    ح1.إيداع(5000)
    ح2.إيداع(2500)
    ح3.إيداع(1000)

    # عمليات سحب
    اطبع_سطر("")
    اطبع_سطر("--- عمليات السحب ---")
    ح1.سحب(3000)
    ح2.سحب(1000)
    ح3.سحب(500)

    # محاولة سحب زائد
    اطبع_سطر("")
    اطبع_سطر("--- محاولة سحب أكثر من الرصيد ---")
    ح3.سحب(50000)

    # تحويلات
    اطبع_سطر("")
    اطبع_سطر("--- التحويلات ---")
    البنك.تحويل(ح1، ح2، 2000)
    البنك.تحويل(ح2، ح3، 1500)
    البنك.تحويل(ح3، ح1، 500)

    # محاولة تحويل فاشلة
    اطبع_سطر("")
    اطبع_سطر("--- محاولة تحويل فاشلة ---")
    البنك.تحويل(ح3، ح1، 999999)

    # كشوفات الحسابات
    اطبع_سطر("")
    اطبع_سطر("--- كشوفات الحسابات ---")
    ح1.كشف_حساب()
    اطبع_سطر("")
    ح2.كشف_حساب()
    اطبع_سطر("")
    ح3.كشف_حساب()

    # تجميد وتنشيط
    اطبع_سطر("")
    اطبع_سطر("--- تجميد وتنشيط الحسابات ---")
    ح2.تجميد()
    ح2.إيداع(100)
    البنك.تحويل(ح1، ح2، 500)

    اطبع_سطر("")
    ح2.تنشيط()
    ح2.إيداع(100)
    ح2.كشف_حساب()

    # محاولة إغلاق حساب
    اطبع_سطر("")
    اطبع_سطر("--- إغلاق الحسابات ---")
    ح3.إغلاق()
    ح3.سحب(ح3.الرصيد)
    ح3.إغلاق()
    ح3.إيداع(100)

    # إحصائيات البنك
    اطبع_سطر("")
    البنك.إحصائيات()
نهاية
