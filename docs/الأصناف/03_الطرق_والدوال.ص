# مثال 3: الطرق والدوال في الأصناف
# المستوى: متوسط
# يوضح إنشاء طرق متعددة داخل صنف واحد (حساب بنكي)

# === صنف حساب بنكي ===

صنف حساب_بنكي
    باني(صاحب_الحساب، رقم_الحساب، رصيد_أولي)
        هذا.الصاحب = صاحب_الحساب
        هذا.الرقم = رقم_الحساب
        هذا.الرصيد = رصيد_أولي
        هذا.عدد_العمليات = 0
        هذا.آخر_عملية = "لا توجد"
    نهاية

    # طريقة الإيداع مع التحقق
    دالة رقم إيداع(مبلغ)
        متغير نتيجة = 0
        متغير رصيد_ج = هذا.الرصيد
        متغير عمليات_ج = هذا.عدد_العمليات
        متغير آخر_ج = هذا.آخر_عملية
        إذا (مبلغ <= 0)
            اطبع_سطر("خطأ: المبلغ يجب أن يكون موجباً")
        وإلا
            رصيد_ج = رصيد_ج + مبلغ
            عمليات_ج = عمليات_ج + 1
            آخر_ج = "إيداع " + مبلغ + " ريال"
            اطبع_سطر("تم إيداع " + مبلغ + " ريال في حساب " + هذا.الصاحب)
            نتيجة = 1
        نهاية
        هذا.الرصيد = رصيد_ج
        هذا.عدد_العمليات = عمليات_ج
        هذا.آخر_عملية = آخر_ج
        ارجع نتيجة
    نهاية

    # طريقة السحب مع فحص الرصيد
    دالة رقم سحب(مبلغ)
        متغير نتيجة = 0
        متغير رصيد_ج = هذا.الرصيد
        متغير عمليات_ج = هذا.عدد_العمليات
        متغير آخر_ج = هذا.آخر_عملية
        إذا (مبلغ <= 0)
            اطبع_سطر("خطأ: المبلغ يجب أن يكون موجباً")
        والا_اذا (مبلغ > هذا.الرصيد)
            اطبع_سطر("خطأ: رصيد غير كافٍ (المتاح: " + هذا.الرصيد + ")")
        وإلا
            رصيد_ج = رصيد_ج - مبلغ
            عمليات_ج = عمليات_ج + 1
            آخر_ج = "سحب " + مبلغ + " ريال"
            اطبع_سطر("تم سحب " + مبلغ + " ريال من حساب " + هذا.الصاحب)
            نتيجة = 1
        نهاية
        هذا.الرصيد = رصيد_ج
        هذا.عدد_العمليات = عمليات_ج
        هذا.آخر_عملية = آخر_ج
        ارجع نتيجة
    نهاية

    # طريقة فحص الرصيد
    دالة الرصيد_الحالي()
        ارجع هذا.الرصيد
    نهاية

    # طريقة فحص كفاية الرصيد
    دالة رقم يكفي(مبلغ)
        متغير نتيجة = 0
        إذا (هذا.الرصيد >= مبلغ)
            نتيجة = 1
        نهاية
        ارجع نتيجة
    نهاية

    # طريقة التحويل إلى حساب آخر
    دالة رقم تحويل(حساب_المستلم، مبلغ)
        متغير نتيجة = 0
        متغير رصيد_ج = هذا.الرصيد
        متغير عمليات_ج = هذا.عدد_العمليات
        متغير آخر_ج = هذا.آخر_عملية
        إذا (مبلغ <= 0)
            اطبع_سطر("خطأ: مبلغ التحويل يجب أن يكون موجباً")
        والا_اذا (مبلغ > هذا.الرصيد)
            اطبع_سطر("خطأ: رصيد غير كافٍ للتحويل")
        وإلا
            رصيد_ج = رصيد_ج - مبلغ
            عمليات_ج = عمليات_ج + 1
            آخر_ج = "تحويل " + مبلغ + " إلى " + حساب_المستلم.الصاحب
            حساب_المستلم.الرصيد = حساب_المستلم.الرصيد + مبلغ
            حساب_المستلم.عدد_العمليات = حساب_المستلم.عدد_العمليات + 1
            حساب_المستلم.آخر_عملية = "تحويل وارد " + مبلغ + " من " + هذا.الصاحب
            اطبع_سطر("تم تحويل " + مبلغ + " ريال من " + هذا.الصاحب + " إلى " + حساب_المستلم.الصاحب)
            نتيجة = 1
        نهاية
        هذا.الرصيد = رصيد_ج
        هذا.عدد_العمليات = عمليات_ج
        هذا.آخر_عملية = آخر_ج
        ارجع نتيجة
    نهاية

    # طريقة عرض معلومات الحساب
    دالة عرض()
        اطبع_سطر("--- معلومات الحساب ---")
        اطبع_سطر("  صاحب الحساب: " + هذا.الصاحب)
        اطبع_سطر("  رقم الحساب: " + هذا.الرقم)
        اطبع_سطر("  الرصيد: " + هذا.الرصيد + " ريال")
        اطبع_سطر("  عدد العمليات: " + هذا.عدد_العمليات)
        اطبع_سطر("  آخر عملية: " + هذا.آخر_عملية)
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== نظام الحسابات البنكية ===")
    اطبع_سطر("")

    # إنشاء حسابات
    متغير حساب1 = جديد حساب_بنكي("أحمد"، "SA001"، 5000)
    متغير حساب2 = جديد حساب_بنكي("سارة"، "SA002"، 3000)

    # عرض الحسابات الأولية
    حساب1.عرض()
    اطبع_سطر("")
    حساب2.عرض()

    # عمليات الإيداع
    اطبع_سطر("")
    اطبع_سطر("=== عمليات الإيداع ===")
    حساب1.إيداع(2000)
    حساب2.إيداع(1500)
    حساب1.إيداع(-500)

    # عمليات السحب
    اطبع_سطر("")
    اطبع_سطر("=== عمليات السحب ===")
    حساب1.سحب(1000)
    حساب2.سحب(500)

    # محاولة سحب أكثر من الرصيد
    اطبع_سطر("")
    اطبع_سطر("=== محاولة سحب زائد ===")
    حساب2.سحب(10000)

    # فحص كفاية الرصيد
    اطبع_سطر("")
    اطبع_سطر("=== فحص كفاية الرصيد ===")
    إذا (حساب1.يكفي(3000))
        اطبع_سطر("حساب أحمد يكفي لـ 3000 ريال")
    وإلا
        اطبع_سطر("حساب أحمد لا يكفي لـ 3000 ريال")
    نهاية

    # تحويل بين الحسابات
    اطبع_سطر("")
    اطبع_سطر("=== تحويل بين الحسابات ===")
    حساب1.تحويل(حساب2، 1500)

    # عرض الحسابات النهائية
    اطبع_سطر("")
    اطبع_سطر("=== الحالة النهائية ===")
    حساب1.عرض()
    اطبع_سطر("")
    حساب2.عرض()

    # الأرصدة النهائية
    اطبع_سطر("")
    اطبع_سطر("رصيد أحمد: " + حساب1.الرصيد_الحالي() + " ريال")
    اطبع_سطر("رصيد سارة: " + حساب2.الرصيد_الحالي() + " ريال")
نهاية
