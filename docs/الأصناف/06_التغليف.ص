# مثال 6: التغليف (Encapsulation)
# المستوى: متوسط
# حماية البيانات من خلال طرق الوصول (getter/setter) مع التحقق
# نستخدم 0 و 1 بدلاً من القيم المنطقية في الحقول والإرجاع

# ========================================
# تعريف الأصناف
# ========================================

# --- صنف صندوق قيم (مثال بسيط للتغليف) ---
صنف صندوق_قيم
    باني(الاسم، القيمة)
        هذا.الاسم = الاسم
        هذا.القيمة = القيمة
    نهاية

    دالة رقم احصل_القيمة()
        ارجع هذا.القيمة
    نهاية

    دالة رقم ضبط_القيمة(قيمة_جديدة)
        متغير تم = 0
        إذا (قيمة_جديدة >= 0)
            هذا.القيمة = قيمة_جديدة
            اطبع_سطر("  تم ضبط " + هذا.الاسم + " على " + قيمة_جديدة)
            تم = 1
        وإلا
            اطبع_سطر("  رفض: القيمة لا يمكن ان تكون سالبة")
        نهاية
        ارجع تم
    نهاية

    دالة عرض()
        اطبع_سطر("  " + هذا.الاسم + " = " + هذا.القيمة)
    نهاية
نهاية

# --- صنف حساب بنك (بدون حقول مهيأة بقيم ثابتة في الباني) ---
صنف حساب_بنك
    باني(الاسم، الرصيد)
        هذا.الاسم = الاسم
        هذا.الرصيد = الرصيد
    نهاية

    دالة رقم احصل_الرصيد()
        ارجع هذا.الرصيد
    نهاية

    دالة رقم ايداع(مبلغ)
        متغير تم = 0
        إذا (مبلغ <= 0)
            اطبع_سطر("  رفض: المبلغ يجب ان يكون اكبر من صفر")
        وإلا
            هذا.الرصيد = هذا.الرصيد + مبلغ
            اطبع_سطر("  ايداع " + مبلغ + " - الرصيد: " + هذا.الرصيد)
            تم = 1
        نهاية
        ارجع تم
    نهاية

    دالة رقم سحب(مبلغ)
        متغير تم = 0
        إذا (مبلغ <= 0)
            اطبع_سطر("  رفض: المبلغ يجب ان يكون اكبر من صفر")
        والا_اذا (مبلغ > هذا.الرصيد)
            اطبع_سطر("  رفض: رصيد غير كاف (الرصيد: " + هذا.الرصيد + ")")
        وإلا
            هذا.الرصيد = هذا.الرصيد - مبلغ
            اطبع_سطر("  سحب " + مبلغ + " - الرصيد: " + هذا.الرصيد)
            تم = 1
        نهاية
        ارجع تم
    نهاية

    دالة عرض()
        اطبع_سطر("  --- حساب " + هذا.الاسم + " ---")
        اطبع_سطر("    الرصيد: " + هذا.الرصيد)
    نهاية
نهاية

# --- صنف درجة (قيمة ضمن نطاق 0-100) ---
صنف درجة
    باني(الاسم، القيمة)
        هذا.الاسم = الاسم
        هذا.القيمة = القيمة
    نهاية

    دالة رقم احصل_القيمة()
        ارجع هذا.القيمة
    نهاية

    دالة رقم ضبط_القيمة(قيمة_جديدة)
        متغير تم = 0
        إذا (قيمة_جديدة < 0)
            اطبع_سطر("  رفض: الدرجة لا يمكن ان تكون سالبة")
        والا_اذا (قيمة_جديدة > 100)
            اطبع_سطر("  رفض: الدرجة لا يمكن ان تتجاوز 100")
        وإلا
            هذا.القيمة = قيمة_جديدة
            اطبع_سطر("  تم تحديث الدرجة الى " + قيمة_جديدة)
            تم = 1
        نهاية
        ارجع تم
    نهاية

    دالة رقم احصل_التقدير()
        متغير تق = 1
        إذا (هذا.القيمة >= 90)
            تق = 5
        والا_اذا (هذا.القيمة >= 80)
            تق = 4
        والا_اذا (هذا.القيمة >= 70)
            تق = 3
        والا_اذا (هذا.القيمة >= 60)
            تق = 2
        نهاية
        ارجع تق
    نهاية

    دالة عرض()
        اطبع_سطر("  " + هذا.الاسم + ": " + هذا.القيمة)
    نهاية
نهاية

# --- صنف عداد محمي (بحد أدنى وأقصى ثابتين) ---
صنف عداد_محمي
    باني(الاسم، القيمة)
        هذا.الاسم = الاسم
        هذا.القيمة = القيمة
    نهاية

    دالة رقم احصل_القيمة()
        ارجع هذا.القيمة
    نهاية

    دالة رقم زيادة(مقدار)
        متغير تم = 0
        متغير جديدة = هذا.القيمة + مقدار
        إذا (جديدة > 1000)
            اطبع_سطر("  رفض: تجاوز الحد الاقصى 1000")
        وإلا
            هذا.القيمة = جديدة
            اطبع_سطر("  " + هذا.الاسم + " زيادة الى " + هذا.القيمة)
            تم = 1
        نهاية
        ارجع تم
    نهاية

    دالة رقم نقصان(مقدار)
        متغير تم = 0
        متغير جديدة = هذا.القيمة - مقدار
        إذا (جديدة < 0)
            اطبع_سطر("  رفض: تجاوز الحد الادنى 0")
        وإلا
            هذا.القيمة = جديدة
            اطبع_سطر("  " + هذا.الاسم + " نقصان الى " + هذا.القيمة)
            تم = 1
        نهاية
        ارجع تم
    نهاية

    دالة عرض()
        اطبع_سطر("  " + هذا.الاسم + " = " + هذا.القيمة)
    نهاية
نهاية

