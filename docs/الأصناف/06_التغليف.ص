نهاية

# --- صنف حساب مستخدم (التحقق من العمر) ---
صنف حساب_مستخدم
    باني(الاسم، العمر)
        هذا.الاسم = الاسم
        هذا.العمر = العمر
    نهاية

    دالة رقم احصل_العمر()
        ارجع هذا.العمر
    نهاية

    دالة رقم ضبط_العمر(عمر_جديد)
        متغير تم = 0
        إذا (عمر_جديد < 0)
            اطبع_سطر("  رفض: العمر لا يمكن ان يكون سالبا")
        والا_اذا (عمر_جديد > 150)
            اطبع_سطر("  رفض: العمر غير واقعي")
        وإلا
            هذا.العمر = عمر_جديد
            اطبع_سطر("  تم تحديث العمر الى: " + عمر_جديد)
            تم = 1
        نهاية
        ارجع تم
    نهاية

    دالة رقم بالغ()
        متغير ناتج = 0
        إذا (هذا.العمر >= 18)
            ناتج = 1
        نهاية
        ارجع ناتج
    نهاية

    دالة عرض()
        اطبع_سطر("  --- حساب " + هذا.الاسم + " ---")
        اطبع_سطر("    العمر: " + هذا.العمر)
    نهاية
نهاية

