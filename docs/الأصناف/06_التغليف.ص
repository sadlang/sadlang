دالة رئيسية()
    # === المثال 1: التغليف الأساسي (getter/setter) ===
    اطبع_سطر("=== المثال 1: التغليف الأساسي ===")
    متغير ص1 = جديد صندوق_قيم("الرصيد"، 100)
    ص1.عرض()
    متغير قيمة1 = ص1.احصل_القيمة()
    اطبع_سطر("  القيمة عبر getter: " + قيمة1)
    متغير ض1 = ص1.ضبط_القيمة(200)
    ص1.عرض()
    متغير ض2 = ص1.ضبط_القيمة(-50)
    ص1.عرض()
    اطبع_سطر("")

    # === المثال 2: التحقق عند الإيداع والسحب ===
    اطبع_سطر("=== المثال 2: الحساب المصرفي ===")
    متغير حساب = جديد حساب_بنك("أحمد"، 1000)
    متغير ا1 = حساب.ايداع(500)
    متغير ا2 = حساب.سحب(200)
    متغير رصيد = حساب.احصل_الرصيد()
    اطبع_سطر("  الرصيد الحالي: " + رصيد)
    اطبع_سطر("")

    # === المثال 3: رفض العمليات غير الصالحة ===
    اطبع_سطر("=== المثال 3: رفض العمليات غير الصالحة ===")
    متغير ا3 = حساب.ايداع(-100)
    متغير ا4 = حساب.سحب(0)
    متغير ا5 = حساب.سحب(99999)
    حساب.عرض()
    اطبع_سطر("")

    # === المثال 4: تحويل بين حسابين ===
    اطبع_سطر("=== المثال 4: تحويل بين حسابين ===")
    متغير حساب2 = جديد حساب_بنك("سارة"، 500)
    حساب.عرض()
    حساب2.عرض()
    اطبع_سطر("  تحويل 300 من أحمد الى سارة:")
    متغير نجح_سحب = حساب.سحب(300)
    إذا (نجح_سحب == 1)
        متغير نجح_ايداع = حساب2.ايداع(300)
    نهاية
    حساب.عرض()
    حساب2.عرض()
    اطبع_سطر("")

    # === المثال 5: الدرجات مع فحص النطاق ===
    اطبع_سطر("=== المثال 5: الدرجات المحمية ===")
    متغير د1 = جديد درجة("أحمد"، 85)
    د1.عرض()
    متغير تقدير1 = د1.احصل_التقدير()
    اطبع_سطر("  التقدير: " + تقدير1 + " (5=ممتاز 4=جيد جدا 3=جيد 2=مقبول 1=راسب)")
    متغير ض3 = د1.ضبط_القيمة(95)
    متغير تقدير2 = د1.احصل_التقدير()
    اطبع_سطر("  التقدير بعد التعديل: " + تقدير2)
    متغير ض4 = د1.ضبط_القيمة(-10)
    متغير ض5 = د1.ضبط_القيمة(200)
    اطبع_سطر("")

    # === المثال 6: العداد المحمي بحدود ===
    اطبع_سطر("=== المثال 6: العداد المحمي ===")
    متغير عد = جديد عداد_محمي("مستوى الطاقة"، 500)
    عد.عرض()
    متغير ز1 = عد.زيادة(300)
    عد.عرض()
    متغير ز2 = عد.زيادة(300)
    متغير ن1 = عد.نقصان(900)
    عد.عرض()
    اطبع_سطر("")

    # === المثال 7: المقياس والبطاقة (أنماط تغليف مختلفة) ===
    اطبع_سطر("=== المثال 7: انماط تغليف مختلفة ===")
    متغير مق = جديد مقياس("التقدم"، 0)
    متغير تق1 = مق.تقدم(25)
    متغير تق2 = مق.تقدم(30)
    متغير تق3 = مق.تقدم(-5)
    مق.عرض()
    اطبع_سطر("")
    متغير بط = جديد بطاقة_عمل("سارة"، "ب1234")
    بط.عرض()
    اطبع_سطر("  الاسم: " + بط.الاسم + " الرمز: " + بط.الرمز)
    اطبع_سطر("")

    # === المثال 8: مثال شامل — حساب المستخدم ===
    اطبع_سطر("=== المثال 8: حساب المستخدم الشامل ===")
    متغير مستخدم1 = جديد حساب_مستخدم("فهد"، 25)
    مستخدم1.عرض()

    متغير هل_بالغ = مستخدم1.بالغ()
    إذا (هل_بالغ == 1)
        اطبع_سطر("  بالغ: نعم")
    وإلا
        اطبع_سطر("  بالغ: لا")
    نهاية

    متغير ض6 = مستخدم1.ضبط_العمر(200)
    متغير ض7 = مستخدم1.ضبط_العمر(-5)
    متغير ض8 = مستخدم1.ضبط_العمر(26)
    مستخدم1.عرض()
    اطبع_سطر("")

    متغير مستخدم2 = جديد حساب_مستخدم("ليلى"، 15)
    مستخدم2.عرض()
    متغير هل_بالغ2 = مستخدم2.بالغ()
    إذا (هل_بالغ2 == 1)
        اطبع_سطر("  بالغ: نعم")
    وإلا
        اطبع_سطر("  بالغ: لا")
    نهاية
