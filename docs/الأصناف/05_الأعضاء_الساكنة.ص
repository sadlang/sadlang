# مثال 5: متغيرات المستوى العلوي
# المستوى: متوسط
# بدلاً من الأعضاء الساكنة نستخدم متغيرات ودوال على مستوى الملف لتتبع الحالة

# === عداد المعرفات ومولد المعرفات ===
متغير عداد_المستخدمين = 0
متغير آخر_معرف = 0

دالة معرف_جديد()
    آخر_معرف = آخر_معرف + 1
    ارجع آخر_معرف
نهاية

صنف مستخدم
    باني(الاسم)
        هذا.المعرف = معرف_جديد()
        هذا.الاسم = الاسم
        عداد_المستخدمين = عداد_المستخدمين + 1
    نهاية

    دالة عرض()
        اطبع_سطر("مستخدم #" + هذا.المعرف + ": " + هذا.الاسم)
    نهاية
نهاية

# === نظام السجل (Logging) ===
متغير مستوى_السجل = 1
متغير اسم_النظام = "تطبيقي"
متغير عدد_الأخطاء = 0
متغير عدد_الرسائل = 0

دالة سجل_رسالة(المستوى، الرسالة)
    إذا (المستوى >= مستوى_السجل)
        عدد_الرسائل = عدد_الرسائل + 1
        اطبع_سطر("[" + اسم_النظام + "] " + الرسالة)
    نهاية
نهاية

دالة سجل_خطأ(الرسالة)
    عدد_الأخطاء = عدد_الأخطاء + 1
    عدد_الرسائل = عدد_الرسائل + 1
    اطبع_سطر("[خطأ #" + عدد_الأخطاء + "] " + الرسالة)
نهاية

دالة تغيير_مستوى_السجل(مستوى_جديد)
    متغير ق = مستوى_جديد
    مستوى_السجل = ق
    اطبع_سطر("تم تغيير مستوى السجل إلى: " + ق)
نهاية

# === حاسبة مع ذاكرة ===
متغير ذاكرة_الحاسبة = 0
متغير عدد_الحسابات = 0

دالة حساب_جمع(أ، ب)
    متغير الناتج = أ + ب
    ذاكرة_الحاسبة = الناتج
    عدد_الحسابات = عدد_الحسابات + 1
    ارجع الناتج
نهاية

دالة حساب_طرح(أ، ب)
    متغير الناتج = أ - ب
    ذاكرة_الحاسبة = الناتج
    عدد_الحسابات = عدد_الحسابات + 1
    ارجع الناتج
نهاية

دالة حساب_ضرب(أ، ب)
    متغير الناتج = أ * ب
    ذاكرة_الحاسبة = الناتج
    عدد_الحسابات = عدد_الحسابات + 1
    ارجع الناتج
نهاية

دالة قراءة_الذاكرة()
    ارجع ذاكرة_الحاسبة
نهاية

دالة مسح_الذاكرة()
    ذاكرة_الحاسبة = 0
    اطبع_سطر("تم مسح الذاكرة")
نهاية

# === عداد الزيارات ===
متغير عدد_الزيارات = 0
متغير آخر_زائر = "لا أحد"

دالة تسجيل_زيارة(اسم_الزائر)
    متغير ق = اسم_الزائر
    عدد_الزيارات = عدد_الزيارات + 1
    آخر_زائر = ق
    اطبع_سطر("زيارة #" + عدد_الزيارات + " من: " + ق)
نهاية

دالة رئيسية()
    # === اختبار العداد والمعرفات ===
    اطبع_سطر("=== متغيرات المستوى العلوي ===")
    اطبع_سطر("")
    اطبع_سطر("--- نظام المستخدمين ---")

    متغير م1 = جديد مستخدم("أحمد")
    متغير م2 = جديد مستخدم("سارة")
    متغير م3 = جديد مستخدم("فهد")

    م1.عرض()
    م2.عرض()
    م3.عرض()
    اطبع_سطر("عدد المستخدمين الكلي: " + عداد_المستخدمين)
    اطبع_سطر("آخر معرف: " + آخر_معرف)

    # === اختبار نظام السجل ===
    اطبع_سطر("")
    اطبع_سطر("--- نظام السجل ---")
    سجل_رسالة(1، "بدأ التطبيق")
    سجل_رسالة(2، "جارِ تحميل البيانات")
    سجل_رسالة(0، "هذه الرسالة لن تظهر")

    سجل_خطأ("ملف غير موجود")
    سجل_خطأ("اتصال فاشل بالخادم")

    اطبع_سطر("عدد الأخطاء: " + عدد_الأخطاء)
    اطبع_سطر("عدد الرسائل: " + عدد_الرسائل)

    # تغيير مستوى السجل
    اطبع_سطر("")
    تغيير_مستوى_السجل(3)
    سجل_رسالة(1، "لن تظهر بعد تغيير المستوى")
    سجل_رسالة(3، "ستظهر لأن المستوى كافٍ")

    # === اختبار الحاسبة ===
    اطبع_سطر("")
    اطبع_سطر("--- الحاسبة مع الذاكرة ---")
    متغير ن1 = حساب_جمع(10، 20)
    اطبع_سطر("10 + 20 = " + ن1)
    اطبع_سطر("الذاكرة: " + قراءة_الذاكرة())

    متغير ن2 = حساب_ضرب(5، 8)
    اطبع_سطر("5 * 8 = " + ن2)
    اطبع_سطر("الذاكرة: " + قراءة_الذاكرة())

    متغير ن3 = حساب_طرح(100، 37)
    اطبع_سطر("100 - 37 = " + ن3)
    اطبع_سطر("الذاكرة: " + قراءة_الذاكرة())

    اطبع_سطر("عدد الحسابات: " + عدد_الحسابات)
    مسح_الذاكرة()
    اطبع_سطر("الذاكرة بعد المسح: " + قراءة_الذاكرة())

    # === اختبار عداد الزيارات ===
    اطبع_سطر("")
    اطبع_سطر("--- عداد الزيارات ---")
    تسجيل_زيارة("أحمد")
    تسجيل_زيارة("سارة")
    تسجيل_زيارة("فهد")
    تسجيل_زيارة("نورة")
    اطبع_سطر("إجمالي الزيارات: " + عدد_الزيارات)
    اطبع_سطر("آخر زائر: " + آخر_زائر)
نهاية
