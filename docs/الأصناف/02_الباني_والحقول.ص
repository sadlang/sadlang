# مثال 2: الباني والحقول
# المستوى: مبتدئ - متوسط
# يوضح كيفية استخدام الباني لتهيئة حقول الصنف

# === صنف طالب ===
# تهيئة حقول أساسية وطرق عرض وفحص

صنف طالب
    باني(الاسم، العمر، المعدل)
        هذا.الاسم = الاسم
        هذا.العمر = العمر
        هذا.المعدل = المعدل
    نهاية

    دالة عرض()
        اطبع_سطر("الطالب: " + هذا.الاسم)
        اطبع_سطر("  العمر: " + هذا.العمر)
        اطبع_سطر("  المعدل: " + هذا.المعدل)
    نهاية

    دالة ناجح()
        إذا (هذا.المعدل >= 60)
            اطبع_سطر(هذا.الاسم + " -> ناجح")
        وإلا
            اطبع_سطر(هذا.الاسم + " -> راسب")
        نهاية
    نهاية

    دالة تقدير()
        إذا (هذا.المعدل >= 90)
            اطبع_سطر(هذا.الاسم + " - تقدير: ممتاز")
        والا_اذا (هذا.المعدل >= 80)
            اطبع_سطر(هذا.الاسم + " - تقدير: جيد جداً")
        والا_اذا (هذا.المعدل >= 70)
            اطبع_سطر(هذا.الاسم + " - تقدير: جيد")
        والا_اذا (هذا.المعدل >= 60)
            اطبع_سطر(هذا.الاسم + " - تقدير: مقبول")
        وإلا
            اطبع_سطر(هذا.الاسم + " - تقدير: راسب")
        نهاية
    نهاية
نهاية

# === صنف إعدادات ===
# حقول من أنواع مختلفة (نصوص، أرقام، منطقية)
# حقل إضافي يُعيَّن في الباني بقيمة ثابتة

صنف إعدادات
    باني(اسم_التطبيق، الإصدار، الوضع_المظلم)
        هذا.اسم_التطبيق = اسم_التطبيق
        هذا.الإصدار = الإصدار
        هذا.الوضع_المظلم = الوضع_المظلم
        هذا.اللغة = "العربية"
    نهاية

    دالة عرض()
        اطبع_سطر("التطبيق: " + هذا.اسم_التطبيق)
        اطبع_سطر("  الإصدار: " + هذا.الإصدار)
        اطبع_سطر("  اللغة: " + هذا.اللغة)
        إذا (هذا.الوضع_المظلم)
            اطبع_سطر("  الوضع: مظلم")
        وإلا
            اطبع_سطر("  الوضع: فاتح")
        نهاية
    نهاية

    دالة تبديل_الوضع()
        إذا (هذا.الوضع_المظلم)
            هذا.الوضع_المظلم = خطأ
            اطبع_سطر("تم التبديل إلى الوضع الفاتح")
        وإلا
            هذا.الوضع_المظلم = صحيح
            اطبع_سطر("تم التبديل إلى الوضع المظلم")
        نهاية
    نهاية

    دالة تغيير_اللغة(لغة_جديدة)
        هذا.اللغة = لغة_جديدة
        اطبع_سطر("تم تغيير اللغة إلى: " + لغة_جديدة)
    نهاية
نهاية

# === صنف مستطيل ===
# حقول محسوبة في الباني (المساحة والمحيط)

صنف مستطيل
    باني(الطول، العرض)
        هذا.الطول = الطول
        هذا.العرض = العرض
        هذا.المساحة = الطول * العرض
        هذا.المحيط = 2 * (الطول + العرض)
    نهاية

    دالة عرض_المعلومات()
        اطبع_سطر("المستطيل:")
        اطبع_سطر("  الطول: " + هذا.الطول)
        اطبع_سطر("  العرض: " + هذا.العرض)
        اطبع_سطر("  المساحة: " + هذا.المساحة)
        اطبع_سطر("  المحيط: " + هذا.المحيط)
    نهاية

    دالة رقم هل_مربع()
        متغير ناتج = 0
        إذا (هذا.الطول == هذا.العرض)
            ناتج = 1
        نهاية
        ارجع ناتج
    نهاية

    دالة تغيير_الأبعاد(طول_جديد، عرض_جديد)
        هذا.الطول = طول_جديد
        هذا.العرض = عرض_جديد
        هذا.المساحة = طول_جديد * عرض_جديد
        هذا.المحيط = 2 * (طول_جديد + عرض_جديد)
        اطبع_سطر("تم تحديث الأبعاد")
    نهاية
نهاية

دالة رئيسية()
    اطبع_سطر("=== صنف طالب ===")
    متغير ط1 = جديد طالب("أحمد"، 20، 85)
    متغير ط2 = جديد طالب("سارة"، 19، 92)
    متغير ط3 = جديد طالب("خالد"، 21، 45)

    ط1.عرض()
    ط1.ناجح()
    ط1.تقدير()
    اطبع_سطر("")

    ط2.عرض()
    ط2.ناجح()
    ط2.تقدير()
    اطبع_سطر("")

    ط3.عرض()
    ط3.ناجح()
    ط3.تقدير()

    # الوصول المباشر والتعديل
    اطبع_سطر("")
    اطبع_سطر("=== الوصول المباشر والتعديل ===")
    اطبع_سطر("اسم الطالب الأول: " + ط1.الاسم)
    اطبع_سطر("معدل الطالب الثاني: " + ط2.المعدل)
    ط3.المعدل = 65
    اطبع_سطر("بعد تعديل معدل خالد:")
    ط3.عرض()
    ط3.ناجح()

    # صنف إعدادات
    اطبع_سطر("")
    اطبع_سطر("=== صنف إعدادات ===")
    متغير إع = جديد إعدادات("تطبيقي"، "2.1"، صحيح)
    إع.عرض()
    اطبع_سطر("")
    إع.تبديل_الوضع()
    إع.عرض()
    اطبع_سطر("")
    إع.تغيير_اللغة("English")
    إع.عرض()

    # صنف مستطيل - حقول محسوبة
    اطبع_سطر("")
    اطبع_سطر("=== صنف مستطيل ===")
    متغير م1 = جديد مستطيل(10، 5)
    م1.عرض_المعلومات()

    اطبع_سطر("")
    متغير م2 = جديد مستطيل(7، 7)
    م2.عرض_المعلومات()
    إذا (م2.هل_مربع())
        اطبع_سطر("  هذا مربع!")
    نهاية

    اطبع_سطر("")
    م1.تغيير_الأبعاد(20، 10)
    م1.عرض_المعلومات()
نهاية
