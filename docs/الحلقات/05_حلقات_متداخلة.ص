# مثال 5: حلقات متداخلة
# المستوى: متوسط

# === جدول الضرب الكامل ===

دالة رئيسية()
    اطبع_سطر("=== جدول الضرب (1-5) ===")
    لكل ي في 1..5
        متغير سطر = ""
        لكل ج في 1..5
            متغير نتيجة = ي * ج
            سطر = سطر + ي + "×" + ج + "=" + نتيجة + "\t"
        نهاية
        اطبع_سطر(سطر)
    نهاية

    # === مثلث النجوم ===
    اطبع_سطر("")
    اطبع_سطر("=== مثلث النجوم ===")
    لكل ي في 1..6
        متغير سطر = ""
        متغير ج = 0
        بينما (ج < ي)
            سطر = سطر + "* "
            ج += 1
        نهاية
        اطبع_سطر(سطر)
    نهاية

    # === البحث في مصفوفة ثنائية ===
    اطبع_سطر("")
    اطبع_سطر("=== جدول الدرجات ===")
    متغير المواد = ["رياضيات"، "علوم"، "لغة"]
    متغير الطلاب = ["أحمد"، "سارة"، "فهد"]
    متغير الدرجات = [
        [88، 92، 85]،
        [95، 88، 97]،
        [72، 68، 75]
    ]

    متغير ط = 0
    بينما (ط < طول(الطلاب))
        اطبع_سطر("")
        اطبع_سطر("--- " + الطلاب[ط] + " ---")
        متغير م = 0
        بينما (م < طول(المواد))
            اطبع_سطر(المواد[م] + ": " + الدرجات[ط][م])
            م += 1
        نهاية
        ط += 1
    نهاية

    # === عد التكرارات ===
    اطبع_سطر("")
    اطبع_سطر("=== عد الأزواج ===")
    متغير أرقام = [1، 2، 3، 4، 5]
    متغير عدد_الأزواج = 0

    لكل أ في أرقام
        لكل ب في أرقام
            إذا (أ < ب)
                اطبع_سطر("(" + أ + "، " + ب + ") مجموعهما: " + (أ + ب))
                عدد_الأزواج += 1
            نهاية
        نهاية
    نهاية
    اطبع_سطر("عدد الأزواج: " + عدد_الأزواج)
نهاية
