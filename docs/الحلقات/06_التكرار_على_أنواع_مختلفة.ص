# التكرار على أنواع مختلفة - معالجة بيانات متنوعة بحلقة بينما
# يوضح هذا الملف ثمانية أمثلة لمعالجة أنواع بيانات مختلفة باستخدام بينما

# صنف مساعد: عدّاد بحد أقصى
صنف عداد_محدود
    باني(بداية، حد)
        هذا.القيمة = بداية
        هذا.الحد = حد
    نهاية

    دالة زد()
        هذا.القيمة = هذا.القيمة + 1
    نهاية

    دالة رقم انتهى()
        متغير ناتج = 0
        إذا (هذا.القيمة > هذا.الحد)
            ناتج = 1
        نهاية
        ارجع ناتج
    نهاية

    دالة الحالي()
        ارجع هذا.القيمة
    نهاية
نهاية

# صنف مساعد: مُراكم
صنف مراكم
    باني()
        هذا.القيمة = 0
        هذا.العدد = 0
    نهاية

    دالة أضف(ن)
        هذا.القيمة = هذا.القيمة + ن
        هذا.العدد = هذا.العدد + 1
    نهاية

    دالة المجموع()
        ارجع هذا.القيمة
    نهاية

    دالة العدد()
        ارجع هذا.العدد
    نهاية
نهاية

دالة رئيسية()

    # مثال 1: تسلسل أعداد صحيحة - المربعات الكاملة
    اطبع_سطر("=== مثال 1: المربعات الكاملة حتى 200 ===")
    متغير ع = 1
    بينما (ع * ع <= 200)
        اطبع_سطر(ع + " مربعه = " + ع * ع)
        ع = ع + 1
    نهاية

    # مثال 2: تسلسل عشري - تراكم الكسور
    اطبع_سطر("=== مثال 2: تراكم عشري ===")
    متغير مجموع = 0.0
    متغير كسر = 0.0
    ع = 1
    بينما (ع <= 10)
        كسر = 1.0 / ع
        مجموع = مجموع + كسر
        اطبع_سطر("1/" + ع + " = " + كسر + "  المجموع = " + مجموع)
        ع = ع + 1
    نهاية

    # مثال 3: بناء نصوص عبر التكرار
    اطبع_سطر("=== مثال 3: بناء نصوص ===")
    متغير نتيجة = ""
    ع = 1
    بينما (ع <= 8)
        نتيجة = نتيجة + "(" + ع + ")"
        اطبع_سطر("الخطوة " + ع + ": " + نتيجة)
        ع = ع + 1
    نهاية

    # مثال 4: استخراج أرقام من عدد وعكسه
    اطبع_سطر("=== مثال 4: استخراج الأرقام ===")
    متغير عدد = 987654
    متغير نسخة = عدد
    متغير عكسي = 0
    متغير خانة = 0
    بينما (نسخة > 0)
        خانة = نسخة % 10
        عكسي = عكسي * 10 + خانة
        اطبع_سطر("الرقم: " + خانة)
        نسخة = (نسخة - خانة) / 10
    نهاية
    اطبع_سطر("العدد الأصلي: " + عدد)
    اطبع_سطر("العدد المعكوس: " + عكسي)

    # مثال 5: نمط منطقي - تبديل حالة
    اطبع_سطر("=== مثال 5: تبديل الحالة المنطقية ===")
    متغير وضع = صحيح
    ع = 1
    بينما (ع <= 10)
        إذا (وضع)
            اطبع_سطر("الدورة " + ع + ": مفعّل")
        وإلا
            اطبع_سطر("الدورة " + ع + ": معطّل")
        نهاية
        وضع = !وضع
        ع = ع + 1
    نهاية

    # مثال 6: إحصاء الزوجي والفردي
    اطبع_سطر("=== مثال 6: إحصاء الزوجي والفردي ===")
    متغير زوجي = 0
    متغير فردي = 0
    ع = 1
    بينما (ع <= 100)
        إذا (ع % 2 == 0)
            زوجي = زوجي + 1
        وإلا
            فردي = فردي + 1
        نهاية
        ع = ع + 1
    نهاية
    اطبع_سطر("الأعداد الزوجية: " + زوجي)
    اطبع_سطر("الأعداد الفردية: " + فردي)

    # مثال 7: تسلسل القوى
    اطبع_سطر("=== مثال 7: تسلسل القوى ===")
    متغير قاعدة = 2
    متغير قيمة = 1
    متغير أس = 0
    بينما (أس <= 15)
        اطبع_سطر(قاعدة + " أس " + أس + " = " + قيمة)
        قيمة = قيمة * قاعدة
        أس = أس + 1
    نهاية

    # مثال 8: تراكم المربعات بحلقة عادية
    اطبع_سطر("=== مثال 8: تراكم المربعات ===")
    متغير ح = 1
    متغير مربع = 0
    متغير مجموع_مربعات = 0
    متغير عدد_عناصر = 0
    بينما (ح <= 10)
        مربع = ح * ح
        مجموع_مربعات = مجموع_مربعات + مربع
        عدد_عناصر = عدد_عناصر + 1
        اطبع_سطر("مربع " + ح + " = " + مربع)
        ح = ح + 1
    نهاية
    اطبع_سطر("مجموع المربعات: " + مجموع_مربعات)
    اطبع_سطر("عدد العناصر: " + عدد_عناصر)

    اطبع_سطر("=== انتهت أمثلة التكرار على أنواع مختلفة ===")
نهاية
