# أنماط الحلقات الشائعة - أنماط برمجية عملية
# يوضح هذا الملف ثمانية أنماط شائعة في البرمجة باستخدام حلقة بينما

# دالة مساعدة: حساب القيمة المطلقة
دالة مطلق(ن)
    إذا (ن < 0)
        ارجع 0 - ن
    نهاية
    ارجع ن
نهاية

دالة رئيسية()

    # مثال 1: نمط التراكم - مجموع المربعات
    اطبع_سطر("=== مثال 1: التراكم ===")
    متغير مجموع = 0
    متغير ع = 1
    بينما (ع <= 10)
        مجموع = مجموع + ع * ع
        اطبع_سطر("بعد إضافة " + ع + " تربيع: المجموع = " + مجموع)
        ع = ع + 1
    نهاية

    # مثال 2: نمط البحث - إيجاد أول عدد تام
    # العدد التام: مجموع قواسمه (بدون نفسه) = العدد
    اطبع_سطر("=== مثال 2: البحث عن عدد تام ===")
    ع = 2
    متغير وجد = خطأ
    متغير ص = 0
    متغير سطر = ""
    متغير مجموع_قواسم = 0
    بينما (!وجد)
        مجموع_قواسم = 0
        ص = 1
        بينما (ص < ع)
            إذا (ع % ص == 0)
                مجموع_قواسم = مجموع_قواسم + ص
            نهاية
            ص = ص + 1
        نهاية
        إذا (مجموع_قواسم == ع)
            اطبع_سطر("أول عدد تام: " + ع)
            وجد = صحيح
        نهاية
        ع = ع + 1
    نهاية

    # مثال 3: نمط التحقق - فحص التناظر
    اطبع_سطر("=== مثال 3: التحقق من التناظر ===")
    متغير عدد = 12321
    متغير نسخة = عدد
    متغير عكسي = 0
    متغير خانة = 0
    بينما (نسخة > 0)
        خانة = نسخة % 10
        عكسي = عكسي * 10 + خانة
        نسخة = (نسخة - خانة) / 10
    نهاية
    إذا (عدد == عكسي)
        اطبع_سطر(عدد + " عدد متناظر")
    وإلا
        اطبع_سطر(عدد + " ليس متناظراً")
    نهاية

    # مثال 4: نمط النجوم - مثلث متساوي الساقين
    اطبع_سطر("=== مثال 4: مثلث نجوم ===")
    متغير صف = 1
    متغير ف = 0
    بينما (صف <= 6)
        سطر = ""
        ف = 1
        بينما (ف <= 6 - صف)
            سطر = سطر + " "
            ف = ف + 1
        نهاية
        ف = 1
        بينما (ف <= صف * 2 - 1)
            سطر = سطر + "*"
            ف = ف + 1
        نهاية
        اطبع_سطر(سطر)
        صف = صف + 1
    نهاية

    # مثال 5: نمط الأرقام - هرم أرقام
    اطبع_سطر("=== مثال 5: هرم أرقام ===")
    صف = 1
    بينما (صف <= 5)
        سطر = ""
        ف = 1
        بينما (ف <= 5 - صف)
            سطر = سطر + " "
            ف = ف + 1
        نهاية
        ف = 1
        بينما (ف <= صف)
            سطر = سطر + ف
            ف = ف + 1
        نهاية
        ف = صف - 1
        بينما (ف >= 1)
            سطر = سطر + ف
            ف = ف - 1
        نهاية
        اطبع_سطر(سطر)
        صف = صف + 1
    نهاية

    # مثال 6: إيجاد الأكبر والأصغر في تسلسل محسوب
    اطبع_سطر("=== مثال 6: الأكبر والأصغر ===")
    # التسلسل: ع*ع - 10*ع + 30 للأعداد من 1 إلى 15
    متغير أكبر = 1 * 1 - 10 * 1 + 30
    متغير أصغر = أكبر
    متغير قيمة = 0
    ع = 1
    بينما (ع <= 15)
        قيمة = ع * ع - 10 * ع + 30
        إذا (قيمة > أكبر)
            أكبر = قيمة
        نهاية
        إذا (قيمة < أصغر)
            أصغر = قيمة
        نهاية
        ع = ع + 1
    نهاية
    اطبع_سطر("أكبر قيمة: " + أكبر)
    اطبع_سطر("أصغر قيمة: " + أصغر)

    # مثال 7: عدّ الأعداد الأولية حتى 50
    اطبع_سطر("=== مثال 7: عدّ الأعداد الأولية حتى 50 ===")
    متغير عداد_أولي = 0
    متغير أولي = صحيح
    ع = 2
    بينما (ع <= 50)
        أولي = صحيح
        ص = 2
        بينما (ص * ص <= ع)
            إذا (ع % ص == 0)
                أولي = خطأ
            نهاية
            ص = ص + 1
        نهاية
        إذا (أولي)
            اطبع_سطر("أولي: " + ع)
            عداد_أولي = عداد_أولي + 1
        نهاية
        ع = ع + 1
    نهاية
    اطبع_سطر("عدد الأعداد الأولية حتى 50: " + عداد_أولي)

    # مثال 8: مستطيل مجوّف من النجوم
    اطبع_سطر("=== مثال 8: مستطيل مجوّف ===")
    متغير عرض = 10
    متغير ارتفاع = 5
    متغير عمود = 0
    صف = 1
    بينما (صف <= ارتفاع)
        سطر = ""
        عمود = 1
        بينما (عمود <= عرض)
            إذا (صف == 1)
                سطر = سطر + "*"
            والا_اذا (صف == ارتفاع)
                سطر = سطر + "*"
            والا_اذا (عمود == 1)
                سطر = سطر + "*"
            والا_اذا (عمود == عرض)
                سطر = سطر + "*"
            وإلا
                سطر = سطر + " "
            نهاية
            عمود = عمود + 1
        نهاية
        اطبع_سطر(سطر)
        صف = صف + 1
    نهاية

    اطبع_سطر("=== انتهت أنماط الحلقات ===")
نهاية
