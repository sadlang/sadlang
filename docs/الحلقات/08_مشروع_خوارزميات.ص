# دالة: القاسم المشترك الأكبر (خوارزمية إقليدس)
دالة قاص_م_أ(أ، ب)
    متغير س = أ
    متغير ص = ب
    متغير باقي = 0
    بينما (ص != 0)
        باقي = س % ص
        س = ص
        ص = باقي
    نهاية
    ارجع س
نهاية

# دالة: المضاعف المشترك الأصغر
دالة م_م_أ(أ، ب)
    متغير ق = قاص_م_أ(أ، ب)
    ارجع (أ * ب) / ق
نهاية

# دالة: حساب القوة (الأس)
دالة قوة(قاعدة، أس)
    متغير نتيجة = 1
    متغير ع = 0
    بينما (ع < أس)
        نتيجة = نتيجة * قاعدة
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# دالة: فحص الأولية
دالة أولي(ن)
    إذا (ن < 2)
        ارجع خطأ
    نهاية
    إذا (ن == 2)
        ارجع صحيح
    نهاية
    إذا (ن % 2 == 0)
        ارجع خطأ
    نهاية
    متغير ق = 3
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            ارجع خطأ
        نهاية
        ق = ق + 2
    نهاية
    ارجع صحيح
نهاية

# دالة: مجموع أرقام عدد
دالة مجموع_أرقام(ن)
    متغير مجموع = 0
    متغير نسخة = ن
    بينما (نسخة > 0)
        مجموع = مجموع + نسخة % 10
        نسخة = (نسخة - نسخة % 10) / 10
    نهاية
    ارجع مجموع
نهاية

# دالة: عدّ أرقام عدد
دالة عدد_الأرقام(ن)
    إذا (ن == 0)
        ارجع 1
    نهاية
    متغير عدد = 0
    متغير نسخة = ن
    بينما (نسخة > 0)
        نسخة = (نسخة - نسخة % 10) / 10
        عدد = عدد + 1
    نهاية
    ارجع عدد
نهاية

# دالة: عكس عدد
دالة عكس_عدد(ن)
    متغير عكسي = 0
    متغير نسخة = ن
    متغير خانة = 0
    بينما (نسخة > 0)
        خانة = نسخة % 10
        عكسي = عكسي * 10 + خانة
        نسخة = (نسخة - خانة) / 10
    نهاية
    ارجع عكسي
نهاية

# دالة: العاملي
دالة عاملي(ن)
    متغير نتيجة = 1
    متغير ع = 2
    بينما (ع <= ن)
        نتيجة = نتيجة * ع
        ع = ع + 1
    نهاية
    ارجع نتيجة
