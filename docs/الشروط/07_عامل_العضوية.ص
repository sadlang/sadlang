# مثال 7: عامل العضوية (في)
# المستوى: متقدم


دالة رئيسية()
    اطبع_سطر("=== عامل العضوية 'في' ===")

    # === التحقق من وجود عنصر في مصفوفة ===
    متغير الفواكه = ["تفاح"، "برتقال"، "موز"، "عنب"، "رمان"]

    إذا ("برتقال" في الفواكه)
        اطبع_سطر("✓ البرتقال موجود في القائمة")
    نهاية

    إذا ("كيوي" في الفواكه)
        اطبع_سطر("الكيوي موجود")
    وإلا
        اطبع_سطر("✗ الكيوي غير موجود في القائمة")
    نهاية

    # === البحث في مصفوفة أرقام ===
    اطبع_سطر("")
    اطبع_سطر("=== البحث في الأرقام ===")
    متغير الأرقام = [2، 4، 6، 8، 10، 12]

    لكل بحث في [3، 6، 9، 12]
        إذا (بحث في الأرقام)
            اطبع_سطر(بحث + " ← موجود ✓")
        وإلا
            اطبع_سطر(بحث + " ← غير موجود ✗")
        نهاية
    نهاية

    # === التحقق من الأحرف في نص ===
    اطبع_سطر("")
    اطبع_سطر("=== البحث في النصوص ===")
    متغير الجملة = "مرحباً بكم في لغة ص"

    متغير كلمات_بحث = ["لغة"، "برمجة"، "مرحباً"، "عالم"]
    لكل عبارة في كلمات_بحث
        إذا (عبارة في الجملة)
            اطبع_سطر("'" + عبارة + "' موجودة في الجملة")
        وإلا
            اطبع_سطر("'" + عبارة + "' غير موجودة في الجملة")
        نهاية
    نهاية

    # === نظام صلاحيات ===
    اطبع_سطر("")
    اطبع_سطر("=== نظام الصلاحيات ===")

    متغير الأدوار_المسموحة = ["مدير"، "محرر"، "مشرف"]
    متغير دور_المستخدم = "محرر"

    إذا (دور_المستخدم في الأدوار_المسموحة)
        اطبع_سطر("✓ مرحباً! لديك صلاحية الوصول")
    وإلا
        اطبع_سطر("✗ ليس لديك صلاحية الوصول")
    نهاية
نهاية
