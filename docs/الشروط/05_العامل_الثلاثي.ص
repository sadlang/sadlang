# مثال 5: الاختيار الشرطي
# المستوى: مبتدئ - متوسط
# أنماط تعيين القيم بناءً على شروط باستخدام إذا/وإلا

# === دوال مساعدة للاختيار الشرطي ===

# 1. تحديد حالة العمر
دالة حالة_العمر(العمر)
    متغير الحالة = ""
    إذا (العمر >= 18)
        الحالة = "بالغ"
    وإلا
        الحالة = "قاصر"
    نهاية
    ارجع الحالة
نهاية

# 2. تحديد نتيجة الامتحان
دالة نتيجة_امتحان(الدرجة)
    متغير النتيجة = ""
    إذا (الدرجة >= 50)
        النتيجة = "ناجح"
    وإلا
        النتيجة = "راسب"
    نهاية
    ارجع النتيجة
نهاية

# 3. تحديد الأكبر
دالة الأكبر(أ، ب)
    متغير الناتج = 0
    إذا (أ > ب)
        الناتج = أ
    وإلا
        الناتج = ب
    نهاية
    ارجع الناتج
نهاية

# 4. تحديد الأصغر
دالة الأصغر(أ، ب)
    متغير الناتج = 0
    إذا (أ < ب)
        الناتج = أ
    وإلا
        الناتج = ب
    نهاية
    ارجع الناتج
نهاية

# 5. تحديد الإشارة
دالة إشارة_العدد(ع)
    متغير الوصف = ""
    إذا (ع > 0)
        الوصف = "موجب"
    والا_اذا (ع < 0)
        الوصف = "سالب"
    وإلا
        الوصف = "صفر"
    نهاية
    ارجع الوصف
نهاية

# 6. زوجي أو فردي
دالة نوع_العدد(ع)
    متغير النوع = ""
    إذا (ع % 2 == 0)
        النوع = "زوجي"
    وإلا
        النوع = "فردي"
    نهاية
    ارجع النوع
نهاية

# 7. تقدير الدرجة
دالة تقدير_الدرجة(الدرجة)
    متغير التقدير = ""
    إذا (الدرجة >= 90)
        التقدير = "ممتاز"
    والا_اذا (الدرجة >= 80)
        التقدير = "جيد جداً"
    والا_اذا (الدرجة >= 70)
        التقدير = "جيد"
    والا_اذا (الدرجة >= 60)
        التقدير = "مقبول"
    وإلا
        التقدير = "راسب"
    نهاية
    ارجع التقدير
نهاية

# 8. رسالة الترحيب حسب الوقت
دالة رسالة_ترحيب(الساعة)
    متغير الرسالة = ""
    إذا (الساعة < 12)
        الرسالة = "صباح الخير"
    والا_اذا (الساعة < 17)
        الرسالة = "مساء الخير"
    والا_اذا (الساعة < 21)
        الرسالة = "مساء النور"
    وإلا
        الرسالة = "تصبح على خير"
    نهاية
    ارجع الرسالة
نهاية

