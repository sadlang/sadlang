# مثال 2: شروط متعددة
# المستوى: مبتدئ

# === تقدير الدرجات ===

دالة رئيسية()
    اطبع_سطر("=== نظام التقديرات ===")

    متغير درجات = [95، 82، 67، 55، 43، 78، 91]

    لكل درجة في درجات
        إذا (درجة >= 90)
            اطبع_سطر(درجة + " → ممتاز (A)")
        وإلا_إذا (درجة >= 80)
            اطبع_سطر(درجة + " → جيد جداً (B)")
        وإلا_إذا (درجة >= 70)
            اطبع_سطر(درجة + " → جيد (C)")
        وإلا_إذا (درجة >= 60)
            اطبع_سطر(درجة + " → مقبول (D)")
        وإلا
            اطبع_سطر(درجة + " → راسب (F)")
        نهاية
    نهاية

    # === تصنيف الأعمار ===
    اطبع_سطر("")
    اطبع_سطر("=== تصنيف الأعمار ===")

    متغير أعمار = [5، 13، 18، 25، 45، 70]

    لكل عمر في أعمار
        إذا (عمر < 6)
            اطبع_سطر(عمر + " سنة → طفل")
        وإلا_إذا (عمر < 13)
            اطبع_سطر(عمر + " سنة → صبي")
        وإلا_إذا (عمر < 18)
            اطبع_سطر(عمر + " سنة → مراهق")
        وإلا_إذا (عمر < 60)
            اطبع_سطر(عمر + " سنة → بالغ")
        وإلا
            اطبع_سطر(عمر + " سنة → كبير السن")
        نهاية
    نهاية

    # === تصنيف درجة الحرارة ===
    اطبع_سطر("")
    اطبع_سطر("=== حالة الطقس ===")

    متغير حرارات = [-5، 10، 25، 35، 48]

    لكل ح في حرارات
        إذا (ح < 0)
            اطبع_سطر(ح + "° → متجمد 🥶")
        وإلا_إذا (ح < 15)
            اطبع_سطر(ح + "° → بارد 🧊")
        وإلا_إذا (ح < 30)
            اطبع_سطر(ح + "° → معتدل 🌤")
        وإلا_إذا (ح < 40)
            اطبع_سطر(ح + "° → حار ☀")
        وإلا
            اطبع_سطر(ح + "° → حار جداً 🔥")
        نهاية
    نهاية
نهاية
