# مثال 6: العمليات المنطقية في الشروط
# المستوى: متوسط


دالة رئيسية()
    اطبع_سطر("=== العمليات المنطقية بالرموز ===")

    متغير العمر = 25
    متغير الراتب = 8000
    متغير لديه_كفيل = صحيح

    # && (و)
    إذا (العمر >= 18 && الراتب >= 5000)
        اطبع_سطر("مؤهل للقرض (&&)")
    نهاية

    # || (أو)
    إذا (الراتب >= 10000 || لديه_كفيل)
        اطبع_سطر("مؤهل للقرض الكبير (||)")
    نهاية

    # ! (ليس)
    متغير محظور = خطأ
    إذا (!محظور)
        اطبع_سطر("الحساب نشط (!)")
    نهاية

    # === نفس الشروط بالكلمات العربية ===
    اطبع_سطر("")
    اطبع_سطر("=== العمليات المنطقية بالعربية ===")

    # و
    إذا (العمر >= 18 و الراتب >= 5000)
        اطبع_سطر("مؤهل للقرض (و)")
    نهاية

    # أو
    إذا (الراتب >= 10000 أو لديه_كفيل)
        اطبع_سطر("مؤهل للقرض الكبير (أو)")
    نهاية

    # ليس
    إذا (ليس محظور)
        اطبع_سطر("الحساب نشط (ليس)")
    نهاية

    # === شروط مركبة ===
    اطبع_سطر("")
    اطبع_سطر("=== شروط مركبة ===")

    متغير الطلاب = [
        {"اسم": "أحمد"، "عمر": 22، "معدل": 3.8، "حاضر": صحيح}،
        {"اسم": "سارة"، "عمر": 19، "معدل": 2.5، "حاضر": خطأ}،
        {"اسم": "فهد"، "عمر": 24، "معدل": 3.2، "حاضر": صحيح}
    ]

    لكل طالب في الطلاب
        إذا (طالب["معدل"] >= 3.0 و طالب["حاضر"])
            اطبع_سطر(طالب["اسم"] + ": مؤهل للتخرج ✓")
        وإلا_إذا (طالب["معدل"] >= 3.0 و ليس طالب["حاضر"])
            اطبع_سطر(طالب["اسم"] + ": معدل جيد لكن غائب")
        وإلا
            اطبع_سطر(طالب["اسم"] + ": يحتاج تحسين")
        نهاية
    نهاية
نهاية
