# مثال 8: نظام تقييم طلاب شامل
# المستوى: متقدم جداً


دالة تقدير(درجة)
    إذا (درجة >= 95)
        ارجع "A+"
    وإلا_إذا (درجة >= 90)
        ارجع "A"
    وإلا_إذا (درجة >= 85)
        ارجع "B+"
    وإلا_إذا (درجة >= 80)
        ارجع "B"
    وإلا_إذا (درجة >= 75)
        ارجع "C+"
    وإلا_إذا (درجة >= 70)
        ارجع "C"
    وإلا_إذا (درجة >= 60)
        ارجع "D"
    وإلا
        ارجع "F"
    نهاية

دالة حالة_الطالب(معدل)
    إذا (معدل >= 90)
        ارجع "شرف أول 🏆"
    وإلا_إذا (معدل >= 85)
        ارجع "شرف ثاني ⭐"
    وإلا_إذا (معدل >= 70)
        ارجع "ناجح ✓"
    وإلا_إذا (معدل >= 60)
        ارجع "ناجح بتحفظ ⚠"
    وإلا
        ارجع "راسب ✗"
    نهاية

دالة توصية(معدل، أعلى_مادة، أدنى_مادة)
    إذا (معدل >= 90 و أدنى_مادة >= 80)
        ارجع "طالب متفوق - يُرشح للتميز"
    وإلا_إذا (معدل >= 80 و أدنى_مادة >= 70)
        ارجع "أداء جيد - يُرشح للنشاطات"
    وإلا_إذا (أعلى_مادة >= 90 و أدنى_مادة < 70)
        ارجع "تفاوت في المستوى - يحتاج متابعة"
    وإلا_إذا (معدل < 60)
        ارجع "يحتاج دعم أكاديمي عاجل"
    وإلا
        ارجع "أداء مقبول - يحتاج تحسين"
    نهاية


دالة رئيسية()
    اطبع_سطر("╔══════════════════════════════════╗")
    اطبع_سطر("║     نظام تقييم الطلاب الشامل      ║")
    اطبع_سطر("╚══════════════════════════════════╝")

    # === بيانات الطلاب ===
    متغير الأسماء = ["أحمد"، "سارة"، "فهد"، "نورة"، "خالد"]
    متغير الرياضيات = [88، 95، 72، 84، 65]
    متغير العلوم = [92، 88، 68، 90، 70]
    متغير اللغة = [85، 97، 75، 82، 60]

    # === دالة التقدير ===
    نهاية

    # === دالة الحالة ===
    نهاية

    # === دالة التوصية ===
    نهاية

    # === التقرير الشامل ===
    متغير عدد_المتفوقين = 0
    متغير عدد_الناجحين = 0
    متغير عدد_الراسبين = 0
    متغير أعلى_معدل = 0
    متغير اسم_الأول = ""

    متغير ي = 0
    بينما (ي < طول(الأسماء))
        اطبع_سطر("")
        اطبع_سطر("━━━ " + الأسماء[ي] + " ━━━")

        متغير المعدل = (الرياضيات[ي] + العلوم[ي] + اللغة[ي]) / 3

        # أعلى وأدنى مادة
        متغير الأعلى = الرياضيات[ي]
        إذا (العلوم[ي] > الأعلى)
            الأعلى = العلوم[ي]
        نهاية
        إذا (اللغة[ي] > الأعلى)
            الأعلى = اللغة[ي]
        نهاية

        متغير الأدنى = الرياضيات[ي]
        إذا (العلوم[ي] < الأدنى)
            الأدنى = العلوم[ي]
        نهاية
        إذا (اللغة[ي] < الأدنى)
            الأدنى = اللغة[ي]
        نهاية

        اطبع_سطر("الرياضيات: " + الرياضيات[ي] + " (" + تقدير(الرياضيات[ي]) + ")")
        اطبع_سطر("العلوم: " + العلوم[ي] + " (" + تقدير(العلوم[ي]) + ")")
        اطبع_سطر("اللغة: " + اللغة[ي] + " (" + تقدير(اللغة[ي]) + ")")
        اطبع_سطر("المعدل: " + المعدل + " → " + حالة_الطالب(المعدل))
        اطبع_سطر("التوصية: " + توصية(المعدل، الأعلى، الأدنى))

        # إحصائيات
        إذا (المعدل >= 85)
            عدد_المتفوقين += 1
        وإلا_إذا (المعدل >= 60)
            عدد_الناجحين += 1
        وإلا
            عدد_الراسبين += 1
        نهاية

        إذا (المعدل > أعلى_معدل)
            أعلى_معدل = المعدل
            اسم_الأول = الأسماء[ي]
        نهاية

        ي += 1
    نهاية

    # === ملخص الصف ===
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════")
    اطبع_سطر("         ملخص الصف")
    اطبع_سطر("═══════════════════════════════")
    اطبع_سطر("إجمالي الطلاب: " + طول(الأسماء))
    اطبع_سطر("المتفوقون: " + عدد_المتفوقين)
    اطبع_سطر("الناجحون: " + عدد_الناجحين)
    اطبع_سطر("الراسبون: " + عدد_الراسبين)
    اطبع_سطر("الأول على الصف: " + اسم_الأول + " (معدل " + أعلى_معدل + ")")
نهاية
