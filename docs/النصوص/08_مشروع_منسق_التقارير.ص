# دالة مساعدة: تكرار حرف (تراكم داخل حلقة يعمل)
دالة تكرار(المحرف، مرات)
    متغير ناتج = ""
    متغير ع = 0
    بينما (ع < مرات)
        ناتج = ناتج + المحرف
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# دالة: خط مزدوج
دالة خط_مزدوج(عرض)
    ارجع تكرار("=", عرض)
نهاية

# دالة: خط مفرد
دالة خط_مفرد(عرض)
    ارجع تكرار("-", عرض)
نهاية

# دالة: طباعة عنوان منسق
دالة عنوان(تسمية، عرض)
    اطبع_سطر(خط_مزدوج(عرض))
    اطبع_سطر("  " + تسمية)
    اطبع_سطر(خط_مزدوج(عرض))
نهاية

# دالة: طباعة عنوان فرعي
دالة عنوان_فرعي(تسمية، عرض)
    اطبع_سطر(خط_مفرد(عرض))
    اطبع_سطر("  " + تسمية)
    اطبع_سطر(خط_مفرد(عرض))
نهاية

# دالة: زوج مفتاح-قيمة
دالة زوج(مفتاح، قيمة_نص)
    ارجع "  " + مفتاح + ": " + قيمة_نص
