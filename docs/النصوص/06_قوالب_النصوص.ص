دالة تكرار_حرف(حرف، عدد)
    متغير ناتج = ""
    متغير ع = 0
    بينما (ع < عدد)
        ناتج = ناتج + حرف
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

دالة فاصل(عرض)
    ارجع "+" + تكرار_حرف("-", عرض - 2) + "+"
