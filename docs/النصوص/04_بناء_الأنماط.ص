# بناء الأنماط - نجوم ومربعات وأهرامات باستخدام دمج النصوص
# Pattern Building - stars, boxes, pyramids using string concatenation

دالة تكرار(حرف، عدد)
    متغير ناتج = ""
    متغير ع = 0
    بينما (ع < عدد)
        ناتج = ناتج + حرف
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

دالة رئيسية()
    # --- مثال 1: مثلث نجوم ---
    اطبع_سطر("=== مثال 1: مثلث نجوم ===")
    متغير ع1 = 1
    بينما (ع1 <= 6)
        اطبع_سطر(تكرار("*", ع1))
        ع1 = ع1 + 1
    نهاية

    # --- مثال 2: مربع مفرغ ---
    اطبع_سطر("=== مثال 2: مربع مفرغ ===")
    متغير البعد = 6
    اطبع_سطر(تكرار("#", البعد))
    متغير ع2 = 1
    بينما (ع2 < البعد - 1)
        اطبع_سطر("#" + تكرار(" ", البعد - 2) + "#")
        ع2 = ع2 + 1
    نهاية
    اطبع_سطر(تكرار("#", البعد))

    # --- مثال 3: هرم متمركز ---
    اطبع_سطر("=== مثال 3: هرم متمركز ===")
    متغير ارتفاع = 6
    متغير ع3 = 1
    بينما (ع3 <= ارتفاع)
        متغير مسافات = تكرار(" ", ارتفاع - ع3)
        متغير نجوم3 = تكرار("*", ع3 + ع3 - 1)
        اطبع_سطر(مسافات + نجوم3)
        ع3 = ع3 + 1
    نهاية

    # --- مثال 4: معين ---
    اطبع_سطر("=== مثال 4: معين ===")
    متغير نصف = 5
    متغير ع4 = 1
    بينما (ع4 <= نصف)
        اطبع_سطر(تكرار(" ", نصف - ع4) + تكرار("*", ع4 + ع4 - 1))
        ع4 = ع4 + 1
    نهاية
    متغير ع4ب = نصف - 1
    بينما (ع4ب >= 1)
        اطبع_سطر(تكرار(" ", نصف - ع4ب) + تكرار("*", ع4ب + ع4ب - 1))
        ع4ب = ع4ب - 1
    نهاية

    # --- مثال 5: سلم ---
    اطبع_سطر("=== مثال 5: سلم ===")
    متغير ع5 = 1
    بينما (ع5 <= 6)
        متغير درجة = تكرار("_", ع5 * 3) + "|"
        اطبع_سطر(درجة)
        ع5 = ع5 + 1
    نهاية

    # --- مثال 6: شجرة ---
    اطبع_سطر("=== مثال 6: شجرة ===")
    متغير ع6 = 1
    بينما (ع6 <= 7)
        اطبع_سطر(تكرار(" ", 7 - ع6) + تكرار("^", ع6 + ع6 - 1))
        ع6 = ع6 + 1
    نهاية
    اطبع_سطر(تكرار(" ", 5) + "||")
    اطبع_سطر(تكرار(" ", 5) + "||")

    # --- مثال 7: إطار مع عنوان ---
    اطبع_سطر("=== مثال 7: إطار مع عنوان ===")
    متغير عرض = 24
    اطبع_سطر("+" + تكرار("-", عرض - 2) + "+")
    اطبع_سطر("|" + تكرار(" ", 6) + "مرحبا!" + تكرار(" ", 6) + "|")
    اطبع_سطر("|" + تكرار(" ", عرض - 2) + "|")
    اطبع_سطر("|" + تكرار(" ", 4) + "لغة ص رائعة" + تكرار(" ", 4) + "|")
    اطبع_سطر("+" + تكرار("-", عرض - 2) + "+")

    # --- مثال 8: نمط شطرنج ---
    اطبع_سطر("=== مثال 8: نمط شطرنج ===")
    متغير ع8 = 0
    بينما (ع8 < 6)
        متغير سطر8 = ""
        متغير عمود = 0
        بينما (عمود < 6)
            متغير مجموع8 = ع8 + عمود
            متغير باقي8 = مجموع8 % 2
            إذا (باقي8 == 0)
                سطر8 = سطر8 + "##"
            وإلا
                سطر8 = سطر8 + "  "
            نهاية
            عمود = عمود + 1
        نهاية
        اطبع_سطر(سطر8)
        ع8 = ع8 + 1
    نهاية
نهاية
