# تكرار النصوص - أنماط التكرار باستخدام الحلقات
# String Repetition - repetition patterns using loops

دالة تكرار_نص(الحرف، العدد)
    متغير ناتج = ""
    متغير ع = 0
    بينما (ع < العدد)
        ناتج = ناتج + الحرف
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

دالة رئيسية()
    # --- مثال 1: تكرار حرف واحد ---
    اطبع_سطر("=== مثال 1: تكرار حرف واحد ===")
    متغير نجوم = تكرار_نص("*", 20)
    اطبع_سطر(نجوم)

    # --- مثال 2: تكرار كلمة ---
    اطبع_سطر("=== مثال 2: تكرار كلمة ===")
    متغير ع2 = 0
    بينما (ع2 < 5)
        اطبع_سطر("مرحبا!")
        ع2 = ع2 + 1
    نهاية

    # --- مثال 3: بناء خط متدرج ---
    اطبع_سطر("=== مثال 3: بناء خط متدرج ===")
    متغير ع3 = 1
    بينما (ع3 <= 8)
        متغير خط = تكرار_نص("#", ع3)
        اطبع_سطر(خط)
        ع3 = ع3 + 1
    نهاية

    # --- مثال 4: خط عكسي ---
    اطبع_سطر("=== مثال 4: خط عكسي ===")
    متغير ع4 = 8
    بينما (ع4 >= 1)
        متغير خط4 = تكرار_نص("=", ع4)
        اطبع_سطر(خط4)
        ع4 = ع4 - 1
    نهاية

    # --- مثال 5: تكرار مع أرقام ---
    اطبع_سطر("=== مثال 5: تكرار مع أرقام ===")
    متغير ع5 = 1
    بينما (ع5 <= 8)
        متغير سطر5 = "السطر " + ع5 + ": " + تكرار_نص(".", ع5)
        اطبع_سطر(سطر5)
        ع5 = ع5 + 1
    نهاية

    # --- مثال 6: إطار بسيط ---
    اطبع_سطر("=== مثال 6: إطار بسيط ===")
    متغير حد = تكرار_نص("-", 20)
    اطبع_سطر("+" + حد + "+")
    متغير ع6 = 0
    بينما (ع6 < 3)
        اطبع_سطر("|" + تكرار_نص(" ", 20) + "|")
        ع6 = ع6 + 1
    نهاية
    اطبع_سطر("+" + حد + "+")

    # --- مثال 7: نمط متناوب ---
    اطبع_سطر("=== مثال 7: نمط متناوب ===")
    متغير ع7 = 0
    بينما (ع7 < 8)
        متغير باقي = ع7 % 2
        إذا (باقي == 0)
            اطبع_سطر(تكرار_نص("*-", 10))
        وإلا
            اطبع_سطر(تكرار_نص("-*", 10))
        نهاية
        ع7 = ع7 + 1
    نهاية

    # --- مثال 8: بناء مسطرة ---
    اطبع_سطر("=== مثال 8: بناء مسطرة ===")
    متغير مسطرة = ""
    متغير ع8 = 0
    بينما (ع8 <= 8)
        مسطرة = مسطرة + ع8 + "..."
        ع8 = ع8 + 1
    نهاية
    اطبع_سطر(مسطرة)
    اطبع_سطر(تكرار_نص("-", 40))
نهاية
