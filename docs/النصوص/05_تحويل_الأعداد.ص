# تحويل الأعداد - استخراج الأرقام وبناء نصوص
# Number-to-Text Patterns - digit extraction and text building

دالة عدد_لنص_عربي(المدخل)
    متغير ناتج = ""
    متغير القيمة = المدخل
    إذا (القيمة == 0)
        ارجع "صفر"
    نهاية
    إذا (القيمة < 0)
        ناتج = "سالب "
        القيمة = 0 - القيمة
    نهاية
    إذا (القيمة == 1)
        ناتج = ناتج + "واحد"
    والا_اذا (القيمة == 2)
        ناتج = ناتج + "اثنان"
    والا_اذا (القيمة == 3)
        ناتج = ناتج + "ثلاثة"
    والا_اذا (القيمة == 4)
        ناتج = ناتج + "أربعة"
    والا_اذا (القيمة == 5)
        ناتج = ناتج + "خمسة"
    والا_اذا (القيمة == 6)
        ناتج = ناتج + "ستة"
    والا_اذا (القيمة == 7)
        ناتج = ناتج + "سبعة"
    والا_اذا (القيمة == 8)
        ناتج = ناتج + "ثمانية"
    والا_اذا (القيمة == 9)
        ناتج = ناتج + "تسعة"
    وإلا
        ناتج = ناتج + القيمة
    نهاية
    ارجع ناتج
نهاية

دالة عدد_الخانات(المدخل)
    متغير القيمة = المدخل
    إذا (القيمة < 0)
        القيمة = 0 - القيمة
    نهاية
    إذا (القيمة == 0)
        ارجع 1
    نهاية
    متغير خانات = 0
    بينما (القيمة > 0)
        القيمة = القيمة / 10
        خانات = خانات + 1
    نهاية
    ارجع خانات
نهاية

دالة رئيسية()
    # --- مثال 1: تحويل رقم لنص عربي ---
    اطبع_سطر("=== مثال 1: تحويل رقم لنص عربي ===")
    متغير ع1 = 0
    بينما (ع1 <= 9)
        اطبع_سطر(ع1 + " = " + عدد_لنص_عربي(ع1))
        ع1 = ع1 + 1
    نهاية

    # --- مثال 2: عد الخانات ---
    اطبع_سطر("=== مثال 2: عد الخانات ===")
    اطبع_سطر("خانات 5: " + عدد_الخانات(5))
    اطبع_سطر("خانات 42: " + عدد_الخانات(42))
    اطبع_سطر("خانات 100: " + عدد_الخانات(100))
    اطبع_سطر("خانات 9999: " + عدد_الخانات(9999))

    # --- مثال 3: فصل الخانات بنقاط ---
    اطبع_سطر("=== مثال 3: فصل الخانات بنقاط ===")
    متغير قيم = 12345
    متغير باقي3 = قيم
    متغير نص_مفصول = ""
    بينما (باقي3 > 0)
        متغير رقم3 = باقي3 % 10
        إذا (نص_مفصول == "")
            نص_مفصول = "" + رقم3
        وإلا
            نص_مفصول = رقم3 + "." + نص_مفصول
        نهاية
        باقي3 = باقي3 / 10
    نهاية
    اطبع_سطر("12345 مفصول: " + نص_مفصول)

    # --- مثال 4: جدول ضرب بنص ---
    اطبع_سطر("=== مثال 4: جدول ضرب بنص ===")
    متغير الرقم = 7
    متغير ع4 = 1
    بينما (ع4 <= 8)
        متغير حاصل = الرقم * ع4
        اطبع_سطر(الرقم + " × " + ع4 + " = " + حاصل)
        ع4 = ع4 + 1
    نهاية

    # --- مثال 5: شريط تقدم نصي ---
    اطبع_سطر("=== مثال 5: شريط تقدم نصي ===")
    متغير ع5 = 0
    بينما (ع5 <= 8)
        متغير ممتلئ = ""
        متغير فارغ5 = ""
        متغير ف1 = 0
        بينما (ف1 < ع5)
            ممتلئ = ممتلئ + "="
            ف1 = ف1 + 1
        نهاية
        متغير ف2 = 0
        بينما (ف2 < 8 - ع5)
            فارغ5 = فارغ5 + " "
            ف2 = ف2 + 1
        نهاية
        متغير نسبة = ع5 * 12
        اطبع_سطر("[" + ممتلئ + فارغ5 + "] " + نسبة + "%")
        ع5 = ع5 + 1
    نهاية

    # --- مثال 6: تحويل ثنائي ---
    اطبع_سطر("=== مثال 6: تحويل ثنائي ===")
    متغير ع6 = 1
    بينما (ع6 <= 8)
        متغير قيمة6 = ع6
        متغير ثنائي = ""
        بينما (قيمة6 > 0)
            متغير بت = قيمة6 % 2
            ثنائي = بت + ثنائي
            قيمة6 = قيمة6 / 2
        نهاية
        اطبع_سطر(ع6 + " ثنائي = " + ثنائي)
        ع6 = ع6 + 1
    نهاية

    # --- مثال 7: بناء رقم تنازلي ---
    اطبع_سطر("=== مثال 7: بناء رقم تنازلي ===")
    متغير تنازلي = ""
    متغير ع7 = 8
    بينما (ع7 >= 1)
        إذا (تنازلي == "")
            تنازلي = "" + ع7
        وإلا
            تنازلي = تنازلي + "-" + ع7
        نهاية
        اطبع_سطر(تنازلي)
        ع7 = ع7 - 1
    نهاية

    # --- مثال 8: مقارنة أعداد بنص ---
    اطبع_سطر("=== مثال 8: مقارنة أعداد بنص ===")
    متغير ق1 = 15
    متغير ق2 = 30
    متغير ق3 = 10
    متغير ق4 = 45
    متغير اكبر = ق1
    إذا (ق2 > اكبر)
        اكبر = ق2
    نهاية
    إذا (ق3 > اكبر)
        اكبر = ق3
    نهاية
    إذا (ق4 > اكبر)
        اكبر = ق4
    نهاية
    اطبع_سطر("الأعداد: " + ق1 + ", " + ق2 + ", " + ق3 + ", " + ق4)
    اطبع_سطر("الأكبر: " + اكبر)
نهاية
