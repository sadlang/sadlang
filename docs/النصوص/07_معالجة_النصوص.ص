# String Processing - accumulation and manipulation with functions

# دالة مساعدة: تكرار حرف (التراكم داخل حلقة يعمل)
دالة تكرار_حرف(المحرف، عدد)
    متغير ناتج = ""
    متغير ع = 0
    بينما (ع < عدد)
        ناتج = ناتج + المحرف
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# دالة مساعدة: خط فاصل
دالة خط_فاصل(عرض)
    ارجع تكرار_حرف("-", عرض)
نهاية

# دالة بناء سطر مرقم
دالة بناء_سطر_مرقم(رقم_السطر)
    ارجع رقم_السطر + ". مهمة رقم " + رقم_السطر
نهاية

# دالة بناء سطر جدول
دالة بناء_سطر_جدول(قيمة)
    متغير مربع = قيمة * قيمة
    ارجع "|   " + قيمة + "   |   " + مربع + "   |"
نهاية

# دالة بناء سطر قوى
دالة بناء_سطر_قوى(قيمة)
    متغير مربع = قيمة * قيمة
    متغير مكعب = قيمة * قيمة * قيمة
    ارجع قيمة + " : مربع=" + مربع + " مكعب=" + مكعب
