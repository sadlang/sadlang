# دالة تحسب العاملي (تكرارية)
دالة عاملي(ن)
    متغير نتيجة = 1
    متغير ع = 1
    بينما (ع <= ن)
        نتيجة = نتيجة * ع
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# دالة تحسب مجموع الأعداد من 1 إلى ن
دالة مجموع(ن)
    متغير ناتج = 0
    متغير ع = 1
    بينما (ع <= ن)
        ناتج = ناتج + ع
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# --- البرنامج الرئيسي ---

دالة رئيسية()
    # 1. استدعاء دالة بدون معاملات
    اطبع_سطر("=== مثال 1: دالة بدون معاملات ===")
    تحية_عامة()

    # 2. استدعاء دالة بمعامل
    اطبع_سطر("=== مثال 2: دالة بمعامل ===")
    تحية("أحمد")
    تحية("سارة")

    # 3. دالة ترجع قيمة
    اطبع_سطر("=== مثال 3: دالة ترجع قيمة ===")
    متغير ن1 = مربع(5)
    اطبع_سطر("مربع 5 = " + ن1)
    متغير ن2 = مربع(12)
    اطبع_سطر("مربع 12 = " + ن2)

    # 4. دالة بمعاملين
    اطبع_سطر("=== مثال 4: دالة بمعاملين ===")
    متغير الأكبر = أكبر(30، 45)
    اطبع_سطر("الأكبر بين 30 و 45 هو: " + الأكبر)
    متغير الأكبر2 = أكبر(100، 7)
    اطبع_سطر("الأكبر بين 100 و 7 هو: " + الأكبر2)

    # 5. دالة العاملي
    اطبع_سطر("=== مثال 5: العاملي ===")
    اطبع_سطر("!5 = " + عاملي(5))
    اطبع_سطر("!7 = " + عاملي(7))
    اطبع_سطر("!10 = " + عاملي(10))

    # 6. تمرير نتائج دالة إلى دالة أخرى
    اطبع_سطر("=== مثال 6: تمرير نتائج بين الدوال ===")
    متغير س = مجموع(10)
    اطبع_سطر("مجموع 1 إلى 10 = " + س)
    متغير الأكبر3 = أكبر(مربع(3)، مربع(2))
    اطبع_سطر("الأكبر بين مربع(3) ومربع(2) = " + الأكبر3)
