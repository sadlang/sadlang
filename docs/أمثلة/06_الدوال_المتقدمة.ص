# دالة حساب الأُس (قاعدة ^ أس)
دالة قوة(قاعدة، أس)
    متغير نتيجة = 1
    متغير ع = 0
    بينما (ع < أس)
        نتيجة = نتيجة * قاعدة
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# دالة القيمة المطلقة
دالة مطلق(ن)
    إذا (ن < 0)
        ارجع 0 - ن
    نهاية
    ارجع ن
نهاية

# دالة فحص الأولية
دالة هل_أولي(ن)
    إذا (ن < 2)
        ارجع 0
    نهاية
    إذا (ن == 2)
        ارجع 1
    نهاية
    إذا (ن % 2 == 0)
        ارجع 0
    نهاية
    متغير ق = 3
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            ارجع 0
        نهاية
        ق = ق + 2
    نهاية
    ارجع 1
نهاية

# دالة القاسم المشترك الأكبر (خوارزمية إقليدس)
دالة ق_م_أ(أ، ب)
    متغير قأ = أ
    متغير قب = ب
    بينما (قب != 0)
        متغير باقي = قأ % قب
        قأ = قب
        قب = باقي
    نهاية
    ارجع قأ
نهاية

# دالة المضاعف المشترك الأصغر (تستدعي ق_م_أ)
دالة م_م_أ(أ، ب)
    متغير قأ = أ
    متغير قب = ب
    متغير القاسم = ق_م_أ(قأ، قب)
    ارجع (قأ * قب) / القاسم
نهاية

# دالة مجموع أرقام العدد
دالة مجموع_أرقام(ن)
    متغير ع = ن
    إذا (ع < 0)
        ع = 0 - ع
    نهاية
    متغير مجموع = 0
    بينما (ع > 0)
        متغير باقي = ع % 10
        مجموع = مجموع + باقي
        ع = (ع - باقي) / 10
    نهاية
    ارجع مجموع
نهاية

# دالة عكس العدد
دالة عكس_عدد(ن)
    متغير ع = ن
    متغير معكوس = 0
    بينما (ع > 0)
        متغير باقي = ع % 10
        معكوس = معكوس * 10 + باقي
        ع = (ع - باقي) / 10
    نهاية
    ارجع معكوس
نهاية

# دالة فيبوناتشي (تكرارية)
دالة فيبوناتشي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    متغير سابق1 = 0
    متغير سابق2 = 1
    متغير ع = 2
    متغير حالي = 0
    بينما (ع <= ن)
        حالي = سابق1 + سابق2
        سابق1 = سابق2
        سابق2 = حالي
        ع = ع + 1
    نهاية
    ارجع سابق2
نهاية

# دالة العاملي (للاستخدام في التوافيق)
دالة عاملي(ن)
    متغير نتيجة = 1
    متغير ع = 2
    بينما (ع <= ن)
        نتيجة = نتيجة * ع
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# دالة التوافيق C(n, k) - تستدعي العاملي
دالة توافيق(ن، ك)
    متغير قن = ن
    متغير قك = ك
    متغير فرق = قن - قك
    ارجع عاملي(قن) / (عاملي(قك) * عاملي(فرق))
نهاية

