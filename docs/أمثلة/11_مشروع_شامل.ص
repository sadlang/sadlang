# مشروع شامل - نظام إدارة درجات الطلاب
# يستخدم: أصناف، دوال، حلقات، شروط

# --- صنف الطالب ---

صنف طالب
    باني(اسم_ط، رياضيات، علوم، لغة_عربية)
        هذا.الاسم = اسم_ط
        هذا.رياضيات = رياضيات
        هذا.علوم = علوم
        هذا.عربية = لغة_عربية
    نهاية

    دالة المجموع()
        ارجع هذا.رياضيات + هذا.علوم + هذا.عربية
    نهاية

    دالة المعدل()
        ارجع هذا.المجموع() / 3
    نهاية

    دالة نص التقدير()
        متغير نتيجة = ""
        متغير م = هذا.المعدل()
        إذا (م >= 90)
            نتيجة = "ممتاز"
        والا_اذا (م >= 80)
            نتيجة = "جيد جداً"
        والا_اذا (م >= 70)
            نتيجة = "جيد"
        والا_اذا (م >= 60)
            نتيجة = "مقبول"
        وإلا
            نتيجة = "راسب"
        نهاية
        ارجع نتيجة
    نهاية

    دالة رقم ناجح()
        متغير نتيجة = 0
        متغير م = هذا.المعدل()
        إذا (م >= 60)
            نتيجة = 1
        نهاية
        ارجع نتيجة
    نهاية

    دالة عرض_بيانات()
        اطبع_سطر("  الاسم: " + هذا.الاسم)
        اطبع_سطر("  الرياضيات: " + هذا.رياضيات)
        اطبع_سطر("  العلوم: " + هذا.علوم)
        اطبع_سطر("  العربية: " + هذا.عربية)
        اطبع_سطر("  المجموع: " + هذا.المجموع())
        اطبع_سطر("  المعدل: " + هذا.المعدل())
        اطبع_سطر("  التقدير: " + هذا.التقدير())
    نهاية
نهاية

# --- دوال مساعدة ---

# دالة طباعة خط فاصل
دالة خط()
    اطبع_سطر("----------------------------------")
نهاية

# دالة تحديد أعلى قيمة بين اثنتين
دالة الأعلى(أ، ب)
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

# --- البرنامج الرئيسي ---

دالة رئيسية()
    اطبع_سطر("==================================")
    اطبع_سطر("   نظام إدارة درجات الطلاب       ")
    اطبع_سطر("==================================")
    اطبع_سطر("")

    # إنشاء الطلاب
    متغير ط1 = جديد طالب("أحمد الفارسي"، 95، 88، 92)
    متغير ط2 = جديد طالب("سارة المحمدي"، 78، 82، 85)
    متغير ط3 = جديد طالب("خالد العمري"، 65، 70، 60)
    متغير ط4 = جديد طالب("نورة السالم"، 90، 95، 88)
    متغير ط5 = جديد طالب("عمر الحسني"، 45، 50، 55)

    # عرض بيانات كل طالب
    اطبع_سطر("=== بيانات الطلاب ===")
    اطبع_سطر("")

    اطبع_سطر("الطالب #1:")
    ط1.عرض_بيانات()
    خط()

    اطبع_سطر("الطالب #2:")
    ط2.عرض_بيانات()
    خط()

    اطبع_سطر("الطالب #3:")
    ط3.عرض_بيانات()
    خط()

    اطبع_سطر("الطالب #4:")
    ط4.عرض_بيانات()
    خط()

    اطبع_سطر("الطالب #5:")
    ط5.عرض_بيانات()
    خط()

    # حساب الإحصائيات مباشرة (بدون تعديل حقول كائن)
    اطبع_سطر("")
    اطبع_سطر("==================================")
    اطبع_سطر("     التقرير النهائي للصف         ")
    اطبع_سطر("==================================")
    اطبع_سطر("")

    # عدد الناجحين والراسبين
    متغير ناجحون = 0
    متغير راسبون = 0

    متغير ن1 = ط1.ناجح()
    إذا (ن1 == 1)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية

    متغير ن2 = ط2.ناجح()
    إذا (ن2 == 1)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية

    متغير ن3 = ط3.ناجح()
    إذا (ن3 == 1)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية

    متغير ن4 = ط4.ناجح()
    إذا (ن4 == 1)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية

    متغير ن5 = ط5.ناجح()
    إذا (ن5 == 1)
        ناجحون = ناجحون + 1
    وإلا
        راسبون = راسبون + 1
    نهاية

    اطبع_سطر("عدد الطلاب: 5")
    اطبع_سطر("عدد الناجحين: " + ناجحون)
    اطبع_سطر("عدد الراسبين: " + راسبون)

    # المعدل العام
    متغير مجموع_معدلات = ط1.المعدل() + ط2.المعدل() + ط3.المعدل() + ط4.المعدل() + ط5.المعدل()
    متغير المعدل_العام = مجموع_معدلات / 5
    اطبع_سطر("المعدل العام: " + المعدل_العام)

    # إيجاد الطالب الأول (الأعلى معدلاً)
    متغير أعلى = ط1.المعدل()
    متغير اسم_الأول = ط1.الاسم

    إذا (ط2.المعدل() > أعلى)
        أعلى = ط2.المعدل()
        اسم_الأول = ط2.الاسم
    نهاية
    إذا (ط3.المعدل() > أعلى)
        أعلى = ط3.المعدل()
        اسم_الأول = ط3.الاسم
    نهاية
    إذا (ط4.المعدل() > أعلى)
        أعلى = ط4.المعدل()
        اسم_الأول = ط4.الاسم
    نهاية
    إذا (ط5.المعدل() > أعلى)
        أعلى = ط5.المعدل()
        اسم_الأول = ط5.الاسم
    نهاية
    اطبع_سطر("الطالب الأول: " + اسم_الأول + " (معدل: " + أعلى + ")")

    # تحليل إضافي
    اطبع_سطر("")
    اطبع_سطر("=== تحليل إضافي ===")

    # أعلى درجة رياضيات
    متغير أعلى_رياضيات = ط1.رياضيات
    أعلى_رياضيات = الأعلى(أعلى_رياضيات، ط2.رياضيات)
    أعلى_رياضيات = الأعلى(أعلى_رياضيات، ط3.رياضيات)
    أعلى_رياضيات = الأعلى(أعلى_رياضيات، ط4.رياضيات)
    أعلى_رياضيات = الأعلى(أعلى_رياضيات، ط5.رياضيات)
    اطبع_سطر("أعلى درجة في الرياضيات: " + أعلى_رياضيات)

    # أعلى درجة علوم
    متغير أعلى_علوم = ط1.علوم
    أعلى_علوم = الأعلى(أعلى_علوم، ط2.علوم)
    أعلى_علوم = الأعلى(أعلى_علوم، ط3.علوم)
    أعلى_علوم = الأعلى(أعلى_علوم، ط4.علوم)
    أعلى_علوم = الأعلى(أعلى_علوم، ط5.علوم)
    اطبع_سطر("أعلى درجة في العلوم: " + أعلى_علوم)

    # مقارنة بين طالبين
    اطبع_سطر("")
    اطبع_سطر("=== مقارنة بين أحمد ونورة ===")
    متغير معدل_أحمد = ط1.المعدل()
    متغير معدل_نورة = ط4.المعدل()
    اطبع_سطر("معدل أحمد: " + معدل_أحمد)
    اطبع_سطر("معدل نورة: " + معدل_نورة)
    متغير فرق = معدل_أحمد - معدل_نورة
    إذا (فرق < 0)
        فرق = 0 - فرق
    نهاية
    اطبع_سطر("الفرق: " + فرق)

    إذا (معدل_أحمد > معدل_نورة)
        اطبع_سطر("أحمد متفوق")
    والا_اذا (معدل_نورة > معدل_أحمد)
        اطبع_سطر("نورة متفوقة")
    وإلا
        اطبع_سطر("متعادلان!")
    نهاية

    # نسبة النجاح
    اطبع_سطر("")
    اطبع_سطر("=== الإحصائيات ===")
    متغير نسبة = (ناجحون * 100) / 5
    اطبع_سطر("نسبة النجاح: " + نسبة + "%")

    اطبع_سطر("")
    اطبع_سطر("تم تنفيذ نظام إدارة الدرجات بنجاح!")
نهاية
