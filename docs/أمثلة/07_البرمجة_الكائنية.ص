# البرمجة الكائنية - الأصناف والكائنات

# --- صنف المستطيل ---

صنف مستطيل
    باني(عرض، ارتفاع)
        هذا.العرض = عرض
        هذا.الارتفاع = ارتفاع
    نهاية

    دالة رقم المساحة()
        ارجع هذا.العرض * هذا.الارتفاع
    نهاية

    دالة رقم المحيط()
        ارجع 2 * (هذا.العرض + هذا.الارتفاع)
    نهاية

    دالة وصف()
        اطبع_سطر("مستطيل بعرض " + هذا.العرض + " وارتفاع " + هذا.الارتفاع)
        اطبع_سطر("  المساحة = " + هذا.المساحة())
        اطبع_سطر("  المحيط = " + هذا.المحيط())
    نهاية
نهاية

# --- صنف الدائرة ---

صنف دائرة
    باني(نصف_قطر)
        هذا.نق = نصف_قطر
    نهاية

    دالة رقم المساحة()
        ارجع 314 * هذا.نق * هذا.نق / 100
    نهاية

    دالة رقم المحيط()
        ارجع 2 * 314 * هذا.نق / 100
    نهاية

    دالة وصف()
        اطبع_سطر("دائرة بنصف قطر " + هذا.نق)
        اطبع_سطر("  المساحة ≈ " + هذا.المساحة())
        اطبع_سطر("  المحيط ≈ " + هذا.المحيط())
    نهاية
نهاية

# --- صنف الطالب ---

صنف طالب
    باني(اسم_طالب، درجة1، درجة2، درجة3)
        هذا.الاسم = اسم_طالب
        هذا.د1 = درجة1
        هذا.د2 = درجة2
        هذا.د3 = درجة3
    نهاية

    دالة رقم المعدل()
        ارجع (هذا.د1 + هذا.د2 + هذا.د3) / 3
    نهاية

    دالة نص التقدير()
        متغير نتيجة = ""
        متغير م = هذا.المعدل()
        إذا (م >= 90)
            نتيجة = "ممتاز"
        والا_اذا (م >= 80)
            نتيجة = "جيد جداً"
        والا_اذا (م >= 70)
            نتيجة = "جيد"
        والا_اذا (م >= 60)
            نتيجة = "مقبول"
        وإلا
            نتيجة = "راسب"
        نهاية
        ارجع نتيجة
    نهاية

    دالة رقم ناجح()
        متغير نتيجة = 0
        متغير م = هذا.المعدل()
        إذا (م >= 60)
            نتيجة = 1
        نهاية
        ارجع نتيجة
    نهاية

    دالة عرض()
        اطبع_سطر("الطالب: " + هذا.الاسم)
        اطبع_سطر("  الدرجات: " + هذا.د1 + "، " + هذا.د2 + "، " + هذا.د3)
        اطبع_سطر("  المعدل: " + هذا.المعدل())
        اطبع_سطر("  التقدير: " + هذا.التقدير())
    نهاية
نهاية

# --- صنف الكتاب ---

صنف كتاب
    باني(عنوان_كتاب، مؤلف_كتاب، عدد_صفحات)
        هذا.العنوان = عنوان_كتاب
        هذا.المؤلف = مؤلف_كتاب
        هذا.الصفحات = عدد_صفحات
    نهاية

    دالة ملخص()
        اطبع_سطر("كتاب: " + هذا.العنوان)
        اطبع_سطر("  المؤلف: " + هذا.المؤلف)
        اطبع_سطر("  عدد الصفحات: " + هذا.الصفحات)
    نهاية

    دالة رقم هل_طويل()
        متغير نتيجة = 0
        إذا (هذا.الصفحات > 300)
            نتيجة = 1
        نهاية
        ارجع نتيجة
    نهاية
نهاية

# --- البرنامج الرئيسي ---

دالة رئيسية()
    # 1. المستطيلات
    اطبع_سطر("=== المستطيلات ===")
    متغير م1 = جديد مستطيل(5، 3)
    م1.وصف()
    اطبع_سطر("")
    متغير م2 = جديد مستطيل(10، 7)
    م2.وصف()

    اطبع_سطر("")

    # 2. الدوائر
    اطبع_سطر("=== الدوائر ===")
    متغير د1 = جديد دائرة(5)
    د1.وصف()
    اطبع_سطر("")
    متغير د2 = جديد دائرة(10)
    د2.وصف()

    # مقارنة المساحات
    اطبع_سطر("")
    اطبع_سطر("مساحة المستطيل الأول: " + م1.المساحة())
    اطبع_سطر("مساحة الدائرة الأولى: " + د1.المساحة())

    اطبع_سطر("")

    # 3. الطلاب
    اطبع_سطر("=== الطلاب ===")
    متغير ط1 = جديد طالب("سارة"، 95، 88، 92)
    ط1.عرض()
    اطبع_سطر("")
    متغير ط2 = جديد طالب("محمد"، 70، 65، 75)
    ط2.عرض()
    اطبع_سطر("")
    متغير ط3 = جديد طالب("ليلى"، 50، 45، 55)
    ط3.عرض()

    # مقارنة الطلاب
    اطبع_سطر("")
    اطبع_سطر("=== المقارنة ===")
    إذا (ط1.المعدل() > ط2.المعدل())
        اطبع_سطر(ط1.الاسم + " أعلى معدلاً من " + ط2.الاسم)
    وإلا
        اطبع_سطر(ط2.الاسم + " أعلى معدلاً من " + ط1.الاسم)
    نهاية

    اطبع_سطر("")

    # 4. الكتب
    اطبع_سطر("=== الكتب ===")
    متغير ك1 = جديد كتاب("مقدمة ابن خلدون"، "ابن خلدون"، 500)
    ك1.ملخص()
    متغير طويل1 = ك1.هل_طويل()
    إذا (طويل1 == 1)
        اطبع_سطر("  هذا كتاب طويل")
    وإلا
        اطبع_سطر("  هذا كتاب قصير")
    نهاية
    اطبع_سطر("")
    متغير ك2 = جديد كتاب("الأمير الصغير"، "سانت إكزوبيري"، 96)
    ك2.ملخص()
    متغير طويل2 = ك2.هل_طويل()
    إذا (طويل2 == 1)
        اطبع_سطر("  هذا كتاب طويل")
    وإلا
        اطبع_سطر("  هذا كتاب قصير")
    نهاية
نهاية
