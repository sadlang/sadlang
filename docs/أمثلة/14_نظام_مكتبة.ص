# مثال شامل: نظام إدارة مكتبة
# Comprehensive example: Library management system

صنف كتاب
    باني(العنوان، المؤلف، السنة)
        هذا.العنوان = العنوان
        هذا.المؤلف = المؤلف
        هذا.السنة = السنة
        هذا.مستعار = خطأ
    نهاية

    دالة معلومات()
        متغير الحالة = "متاح"
        إذا (هذا.مستعار)
            الحالة = "مُستعار"
        نهاية
        ارجع هذا.العنوان + " — " + هذا.المؤلف + " (" + هذا.السنة + ") [" + الحالة + "]"
    نهاية

    دالة استعر()
        إذا (هذا.مستعار)
            اطبع_سطر("⚠ الكتاب مُستعار بالفعل: " + هذا.العنوان)
            ارجع خطأ
        نهاية
        هذا.مستعار = صحيح
        اطبع_سطر("✓ تم استعارة: " + هذا.العنوان)
        ارجع صحيح
    نهاية

    دالة أرجع()
        هذا.مستعار = خطأ
        اطبع_سطر("✓ تم إرجاع: " + هذا.العنوان)
    نهاية
نهاية

# إنشاء الكتب
متغير كتب = []
كتب.أضف(جديد كتاب("مقدمة ابن خلدون"، "ابن خلدون"، 1377))
كتب.أضف(جديد كتاب("ألف ليلة وليلة"، "مجهول"، 800))
كتب.أضف(جديد كتاب("الخوارزمي في الجبر"، "الخوارزمي"، 820))
كتب.أضف(جديد كتاب("رسالة الغفران"، "أبو العلاء المعري"، 1033))

# عرض الحالة الأولية
دالة عرض_الكتب(كتب)
    اطبع_سطر("═══ المكتبة الوطنية ═══")
    اطبع_سطر("إجمالي الكتب: " + كتب.طول())
    لكل ك في كتب
        اطبع_سطر("  " + ك.معلومات())
    نهاية
نهاية

عرض_الكتب(كتب)

# استعارة بعض الكتب
اطبع_سطر("")
اطبع_سطر("--- عمليات الاستعارة ---")
كتب[0].استعر()
كتب[2].استعر()
كتب[0].استعر()    # محاولة استعارة مرة ثانية

# عرض الحالة بعد الاستعارة
اطبع_سطر("")
عرض_الكتب(كتب)

# إرجاع كتاب
اطبع_سطر("")
اطبع_سطر("--- عملية الإرجاع ---")
كتب[0].أرجع()

اطبع_سطر("")
عرض_الكتب(كتب)
