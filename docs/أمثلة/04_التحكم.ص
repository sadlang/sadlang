# أمثلة على التحكم بالتدفق

# الشروط

دالة رئيسية()
    متغير درجة = 85

    إذا (درجة >= 90)
        اطبع_سطر("ممتاز")
    والا_اذا (درجة >= 80)
        اطبع_سطر("جيد جداً")
    والا_اذا (درجة >= 70)
        اطبع_سطر("جيد")
    وإلا
        اطبع_سطر("مقبول")
    نهاية

    # حلقة بينما
    اطبع_سطر("العد التنازلي:")
    متغير عداد = 5
    بينما (عداد > 0)
        اطبع_سطر(عداد)
        عداد = عداد - 1
    نهاية
    اطبع_سطر("انطلق!")

    # حلقة لكل مع مصفوفة
    متغير فواكه = ["تفاح"، "موز"، "برتقال"، "عنب"]
    لكل فاكهة في فواكه
        اطبع_سطر("فاكهة: " + فاكهة)
    نهاية

    # لكل مع نطاق
    لكل ع في 1..5
        اطبع_سطر("العدد: " + ع)
    نهاية

    # اخرج وتابع
    لكل ع في 1..10
        إذا (ع % 2 == 0)
            تابع
        نهاية
        إذا (ع > 7)
            اخرج
        نهاية
        اطبع_سطر("فردي: " + ع)
    نهاية

    # حالة (Switch)
    متغير لون = "أحمر"
    حالة (لون)
        عندما "أحمر":
            اطبع_سطر("توقف!")
        عندما "أصفر":
            اطبع_سطر("استعد!")
        عندما "أخضر":
            اطبع_سطر("انطلق!")
        افتراضي:
            اطبع_سطر("لون غير معروف")
    نهاية
نهاية
