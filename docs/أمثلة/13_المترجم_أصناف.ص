# مثال على البرمجة الكائنية مع الوراثة
# Example: OOP with inheritance

صنف شكل
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية

    دالة وصف()
        ارجع "شكل: " + هذا.الاسم
    نهاية
نهاية

صنف مستطيل يرث شكل
    باني(العرض، الارتفاع)
        هذا.الاسم = "مستطيل"
        هذا.العرض = العرض
        هذا.الارتفاع = الارتفاع
    نهاية

    دالة المساحة()
        ارجع هذا.العرض * هذا.الارتفاع
    نهاية

    دالة المحيط()
        ارجع 2 * (هذا.العرض + هذا.الارتفاع)
    نهاية
نهاية

صنف دائرة يرث شكل
    باني(نصف_القطر)
        هذا.الاسم = "دائرة"
        هذا.نصف_القطر = نصف_القطر
    نهاية

    دالة المساحة()
        ارجع 3.14159 * هذا.نصف_القطر ** 2
    نهاية

    دالة المحيط()
        ارجع 2 * 3.14159 * هذا.نصف_القطر
    نهاية
نهاية

# إنشاء الأشكال
متغير م = جديد مستطيل(8، 5)
متغير د = جديد دائرة(4)

اطبع_سطر("═══ الأشكال الهندسية ═══")
اطبع_سطر(م.وصف())
اطبع_سطر("  المساحة: " + م.المساحة())
اطبع_سطر("  المحيط: " + م.المحيط())
اطبع_سطر(د.وصف())
اطبع_سطر("  المساحة: " + د.المساحة())
اطبع_سطر("  المحيط: " + د.المحيط())
