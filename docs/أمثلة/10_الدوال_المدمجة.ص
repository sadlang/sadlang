# الحد الأدنى
دالة حد_أدنى(أ، ب)
    إذا (أ < ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

# الحد الأقصى
دالة حد_أقصى(أ، ب)
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

# الأُس (قاعدة مرفوعة لقوة)
دالة قوة(قاعدة، أس)
    متغير نتيجة = 1
    متغير ع = 0
    بينما (ع < أس)
        نتيجة = نتيجة * قاعدة
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# الجذر التربيعي التقريبي (طريقة نيوتن)
دالة جذر_تقريبي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    متغير تخمين = ن / 2
    متغير تكرار = 0
    بينما (تكرار < 20)
        تخمين = (تخمين + ن / تخمين) / 2
        تكرار = تكرار + 1
    نهاية
    ارجع تخمين
نهاية

# هل العدد زوجي؟
دالة زوجي(ن)
    ارجع ن % 2 == 0
نهاية

# هل العدد فردي؟
دالة فردي(ن)
    ارجع ن % 2 != 0
نهاية

# تحديد العدد ضمن نطاق (clamp)
دالة حصر(قيمة، أدنى، أقصى)
    إذا (قيمة < أدنى)
        ارجع أدنى
    نهاية
    إذا (قيمة > أقصى)
        ارجع أقصى
    نهاية
    ارجع قيمة
نهاية

