# النصوص والعمليات - عمليات على النصوص والأنماط الرقمية

# --- دوال مساعدة ---

# دالة تكرار نص عدة مرات
دالة كرر_نص(محتوى، عدد)
    متغير ناتج = ""
    متغير ع = 0
    بينما (ع < عدد)
        ناتج = ناتج + محتوى
        ع = ع + 1
    نهاية
    ارجع ناتج
نهاية

# دالة بناء خط فاصل
دالة خط_فاصل(طول)
    ارجع كرر_نص("-"، طول)
نهاية

# دالة تحويل رقم إلى نص عربي بسيط (0-9)
دالة رقم_عربي(ر)
    إذا (ر == 0)
        ارجع "صفر"
    والا_اذا (ر == 1)
        ارجع "واحد"
    والا_اذا (ر == 2)
        ارجع "اثنان"
    والا_اذا (ر == 3)
        ارجع "ثلاثة"
    والا_اذا (ر == 4)
        ارجع "أربعة"
    والا_اذا (ر == 5)
        ارجع "خمسة"
    والا_اذا (ر == 6)
        ارجع "ستة"
    والا_اذا (ر == 7)
        ارجع "سبعة"
    والا_اذا (ر == 8)
        ارجع "ثمانية"
    والا_اذا (ر == 9)
        ارجع "تسعة"
    وإلا
        ارجع "?"
    نهاية
نهاية

# --- البرنامج الرئيسي ---

دالة رئيسية()
    # 1. دمج النصوص
    اطبع_سطر("=== دمج النصوص ===")
    متغير الاسم_الأول = "محمد"
    متغير اسم_العائلة = "العربي"
    متغير الاسم_الكامل = الاسم_الأول + " " + اسم_العائلة
    اطبع_سطر("الاسم الكامل: " + الاسم_الكامل)

    # 2. بناء نص في حلقة
    اطبع_سطر("")
    اطبع_سطر("=== بناء نص في حلقة ===")
    متغير جملة = ""
    متغير ع = 1
    بينما (ع <= 5)
        إذا (ع > 1)
            جملة = جملة + "، "
        نهاية
        جملة = جملة + رقم_عربي(ع)
        ع = ع + 1
    نهاية
    اطبع_سطر("الأرقام: " + جملة)

    # 3. النجوم والأنماط
    اطبع_سطر("")
    اطبع_سطر("=== مثلث من النجوم ===")
    متغير صف = 1
    بينما (صف <= 6)
        اطبع_سطر(كرر_نص("*"، صف))
        صف = صف + 1
    نهاية

    # 4. مثلث معكوس
    اطبع_سطر("")
    اطبع_سطر("=== مثلث معكوس ===")
    صف = 6
    بينما (صف >= 1)
        اطبع_سطر(كرر_نص("#"، صف))
        صف = صف - 1
    نهاية

    # 5. جدول الضرب كنصوص
    اطبع_سطر("")
    اطبع_سطر("=== جدول ضرب 7 ===")
    اطبع_سطر(خط_فاصل(25))
    متغير م = 1
    بينما (م <= 10)
        متغير حاصل = 7 * م
        اطبع_سطر("7 × " + م + " = " + حاصل)
        م = م + 1
    نهاية
    اطبع_سطر(خط_فاصل(25))

    # 6. الأنماط الرقمية - مجموع تراكمي
    اطبع_سطر("")
    اطبع_سطر("=== المجموع التراكمي ===")
    متغير مجموع = 0
    متغير ر = 1
    بينما (ر <= 8)
        مجموع = مجموع + ر
        اطبع_سطر("المجموع بعد إضافة " + ر + " = " + مجموع)
        ر = ر + 1
    نهاية

    # 7. بناء نص مع فواصل
    اطبع_سطر("")
    اطبع_سطر("=== بناء قائمة أعداد زوجية ===")
    متغير قائمة = ""
    متغير ز = 2
    بينما (ز <= 20)
        إذا (ز > 2)
            قائمة = قائمة + " - "
        نهاية
        قائمة = قائمة + ز
        ز = ز + 2
    نهاية
    اطبع_سطر("الأعداد الزوجية: " + قائمة)

    # 8. هرم مركزي
    اطبع_سطر("")
    اطبع_سطر("=== هرم مركزي ===")
    متغير مستوى = 1
    بينما (مستوى <= 5)
        متغير فراغات = كرر_نص(" "، 5 - مستوى)
        متغير نجوم = كرر_نص("*"، 2 * مستوى - 1)
        اطبع_سطر(فراغات + نجوم)
        مستوى = مستوى + 1
    نهاية
نهاية
