# مثال على الدوال التكرارية والحلقات
# Example: Recursive functions and loops

دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

دالة فيبوناتشي(ن)
    إذا (ن <= 1)
        ارجع ن
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

دالة مجموع_إلى(ن)
    متغير مجموع = 0
    متغير ي = 1
    بينما (ي <= ن)
        مجموع = مجموع + ي
        ي = ي + 1
    نهاية
    ارجع مجموع
نهاية

