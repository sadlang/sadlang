اطبع_سطر("═══ اختبار الدوال الرياضية ═══")
اطبع_سطر("مضروب 5: " + مضروب(5))
اطبع_سطر("مضروب 10: " + مضروب(10))
اطبع_سطر("فيبوناتشي 10: " + فيبوناتشي(10))
اطبع_سطر("مجموع 1 إلى 100: " + مجموع_إلى(100))
