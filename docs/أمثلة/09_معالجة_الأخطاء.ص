# التحقق من الأخطاء - البرمجة الدفاعية
# Error Checking - Defensive Programming
# يوضح هذا الملف أنماط التحقق من الأخطاء بدون try/catch

# --- نمط 1: التحقق قبل القسمة ---
دالة قسمة(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("خطأ: لا يمكن القسمة على صفر")
        ارجع 0 - 1
    نهاية
    ارجع أ / ب
نهاية

# --- نمط 2: التحقق من صلاحية المدخلات (حارس) ---
دالة جذر_تقريبي(ن)
    إذا (ن < 0)
        اطبع_سطر("خطأ: لا يمكن حساب جذر عدد سالب")
        ارجع 0 - 1
    نهاية
    إذا (ن == 0)
        ارجع 0
    نهاية
    متغير تخمين = ن / 2
    متغير ع = 0
    بينما (ع < 20)
        تخمين = (تخمين + ن / تخمين) / 2
        ع = ع + 1
    نهاية
    ارجع تخمين
نهاية

# --- نمط 3: كود خطأ كنتيجة ---
# القيمة -1 تعني خطأ، وأي قيمة أخرى تعني نجاح
# مبسطة: string indexing غير مدعوم في المترجم
دالة فهرس_حرف(جملة، حرف)
    ارجع 0 - 1
نهاية

# --- نمط 4: التحقق من النطاق ---
دالة درجة_صحيحة(درجة)
    إذا (درجة < 0)
        ارجع 0
    نهاية
    إذا (درجة > 100)
        ارجع 0
    نهاية
    ارجع 1
نهاية

دالة تقدير(درجة)
    إذا (درجة_صحيحة(درجة) == 0)
        ارجع "خطأ: درجة غير صالحة"
    نهاية
    إذا (درجة >= 90)
        ارجع "ممتاز"
    نهاية
    إذا (درجة >= 80)
        ارجع "جيد جداً"
    نهاية
    إذا (درجة >= 70)
        ارجع "جيد"
    نهاية
    إذا (درجة >= 60)
        ارجع "مقبول"
    نهاية
    ارجع "راسب"
نهاية

# --- نمط 5: كائن نتيجة يحمل حالة النجاح والقيمة ---
صنف نتيجة
    باني(نجاح، قيمة، رسالة)
        هذا.نجاح = نجاح
        هذا.القيمة = قيمة
        هذا.الرسالة = رسالة
    نهاية
نهاية

دالة قسمة_آمنة(أ، ب)
    إذا (ب == 0)
        ارجع جديد نتيجة(0، 0، "لا يمكن القسمة على صفر")
    نهاية
    ارجع جديد نتيجة(1، أ / ب، "تمت العملية بنجاح")
نهاية

# --- نمط 6: التحقق المتسلسل (عدة شروط) ---
دالة سجل_مستخدم(اسم، عمر، بريد)
    إذا (طول(اسم) == 0)
        اطبع_سطر("خطأ: الاسم فارغ")
        ارجع 0
    نهاية
    إذا (عمر < 1)
        اطبع_سطر("خطأ: العمر غير صالح")
        ارجع 0
    نهاية
    إذا (عمر > 150)
        اطبع_سطر("خطأ: العمر غير واقعي")
        ارجع 0
    نهاية
    إذا (طول(بريد) < 3)
        اطبع_سطر("خطأ: البريد الإلكتروني قصير جداً")
        ارجع 0
    نهاية
    اطبع_سطر("تم تسجيل: " + اسم)
    ارجع 1
نهاية

# --- نمط 7: قيمة بديلة عند الخطأ ---
دالة قيمة_أو_بديل(قيمة، بديل)
    إذا (قيمة < 0)
        ارجع بديل
    نهاية
    ارجع قيمة
نهاية

# --- نمط 8: عداد أخطاء مع كائن ---
صنف مدقق
    باني()
        هذا.عدد_الأخطاء = 0
    نهاية

    دالة رقم تحقق_موجب(قيمة، وصف)
        متغير ناتج = 0
        متغير أخطاء_ج = هذا.عدد_الأخطاء
        إذا (قيمة <= 0)
            اطبع_سطر("خطأ: " + وصف + " يجب أن يكون موجباً")
            أخطاء_ج = أخطاء_ج + 1
        وإلا
            ناتج = 1
        نهاية
        هذا.عدد_الأخطاء = أخطاء_ج
        ارجع ناتج
    نهاية

    دالة رقم تحقق_نطاق(قيمة، حد_أدنى، حد_أعلى، وصف)
        متغير ناتج = 0
        متغير أخطاء_ج = هذا.عدد_الأخطاء
        إذا (قيمة < حد_أدنى)
            اطبع_سطر("خطأ: " + وصف + " أقل من الحد الأدنى")
            أخطاء_ج = أخطاء_ج + 1
        والا_اذا (قيمة > حد_أعلى)
            اطبع_سطر("خطأ: " + وصف + " أعلى من الحد الأقصى")
            أخطاء_ج = أخطاء_ج + 1
        وإلا
            ناتج = 1
        نهاية
        هذا.عدد_الأخطاء = أخطاء_ج
        ارجع ناتج
    نهاية

    دالة رقم هل_يوجد_أخطاء()
        متغير ناتج = 0
        إذا (هذا.عدد_الأخطاء > 0)
            ناتج = 1
        نهاية
        ارجع ناتج
    نهاية
نهاية

# --- الدالة الرئيسية ---
دالة رئيسية()
    # نمط 1: التحقق قبل القسمة
    اطبع_سطر("=== التحقق قبل القسمة ===")
    اطبع_سطر("10 / 3 = " + قسمة(10، 3))
    قسمة(10، 0)

    # نمط 2: حارس المدخلات
    اطبع_سطر("=== جذر تقريبي ===")
    اطبع_سطر("جذر 25 = " + جذر_تقريبي(25))
    اطبع_سطر("جذر 2 = " + جذر_تقريبي(2))
    جذر_تقريبي(0 - 4)

    # نمط 3: كود خطأ
    اطبع_سطر("=== البحث في نص ===")
    متغير موضع = فهرس_حرف("مرحبا"، "ح")
    إذا (موضع >= 0)
        اطبع_سطر("وجد الحرف في الموضع: " + موضع)
    وإلا
        اطبع_سطر("الحرف غير موجود")
    نهاية

    # نمط 4: التحقق من النطاق
    اطبع_سطر("=== التقدير ===")
    اطبع_سطر("درجة 95: " + تقدير(95))
    اطبع_سطر("درجة 73: " + تقدير(73))
    اطبع_سطر("درجة 45: " + تقدير(45))
    اطبع_سطر("درجة 150: " + تقدير(150))

    # نمط 5: كائن نتيجة
    اطبع_سطر("=== كائن النتيجة ===")
    متغير ن1 = قسمة_آمنة(10، 3)
    إذا (ن1.نجاح == 1)
        اطبع_سطر("النتيجة: " + ن1.القيمة + " - " + ن1.الرسالة)
    وإلا
        اطبع_سطر("فشل: " + ن1.الرسالة)
    نهاية

    متغير ن2 = قسمة_آمنة(10، 0)
    إذا (ن2.نجاح == 1)
        اطبع_سطر("النتيجة: " + ن2.القيمة)
    وإلا
        اطبع_سطر("فشل: " + ن2.الرسالة)
    نهاية

    # نمط 6: التحقق المتسلسل
    اطبع_سطر("=== تسجيل مستخدم ===")
    سجل_مستخدم("أحمد"، 25، "ahmed@mail.com")
    سجل_مستخدم(""، 25، "x@y.com")
    سجل_مستخدم("سارة"، 0 - 5، "sara@mail.com")

    # نمط 7: قيمة بديلة
    اطبع_سطر("=== القيمة البديلة ===")
    اطبع_سطر("قيمة 10 أو 0: " + قيمة_أو_بديل(10، 0))
    اطبع_سطر("قيمة -5 أو 0: " + قيمة_أو_بديل(0 - 5، 0))

    # نمط 8: مدقق بكائن
    اطبع_سطر("=== المدقق ===")
    متغير م = جديد مدقق()
    م.تحقق_موجب(5، "العرض")
    م.تحقق_موجب(0 - 3، "الارتفاع")
    م.تحقق_نطاق(50، 0، 100، "الدرجة")
    م.تحقق_نطاق(200، 0، 100، "الوزن")
    اطبع_سطر("عدد الأخطاء: " + م.عدد_الأخطاء)
نهاية
