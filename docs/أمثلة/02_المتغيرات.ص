# أمثلة على المتغيرات والأنواع

# متغيرات عامة

دالة رئيسية()
    متغير اسم = "أحمد"
    متغير عمر = 25
    متغير طول_م = 1.75
    متغير طالب = صحيح

    اطبع_سطر("الاسم: " + اسم)
    اطبع_سطر("العمر: " + عمر)
    اطبع_سطر("الطول: " + طول_م)
    اطبع_سطر("طالب: " + طالب)

    # متغيرات بنوع محدد
    رقم عدد = 42
    نص رسالة = "لغة ص رائعة"
    منطقي نشط = صحيح

    اطبع_سطر("العدد: " + عدد)
    اطبع_سطر("الرسالة: " + رسالة)
    اطبع_سطر("نشط: " + نشط)

    # ثوابت
    ثابت باي = 3.14159
    ثابت اسم_التطبيق = "تطبيق ص"
    اطبع_سطر("باي: " + باي)
    اطبع_سطر("التطبيق: " + اسم_التطبيق)

    # مصفوفة
    متغير أرقام = [1، 2، 3، 4، 5]
    اطبع_سطر("الأرقام: " + أرقام)

    # خريطة
    متغير شخص = {"اسم": "سارة"، "عمر": 30}
    اطبع_سطر("الشخص: " + شخص)
