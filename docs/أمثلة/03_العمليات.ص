# أمثلة على العمليات والتعبيرات

# العمليات الحسابية

دالة رئيسية()
    متغير أ = 15
    متغير ب = 4

    اطبع_سطر("الجمع: " + (أ + ب))
    اطبع_سطر("الطرح: " + (أ - ب))
    اطبع_سطر("الضرب: " + (أ * ب))
    اطبع_سطر("القسمة: " + (أ / ب))
    اطبع_سطر("الباقي: " + (أ % ب))
    اطبع_سطر("الأس: " + (2 ** 10))

    # عمليات المقارنة
    اطبع_سطر("15 == 15: " + (15 == 15))
    اطبع_سطر("15 != 4: " + (15 != 4))
    اطبع_سطر("15 > 4: " + (15 > 4))
    اطبع_سطر("15 < 4: " + (15 < 4))

    # العمليات المنطقية
    اطبع_سطر("صحيح و صحيح: " + (صحيح && صحيح))
    اطبع_سطر("صحيح أو خطأ: " + (صحيح || خطأ))
    اطبع_سطر("ليس صحيح: " + (!صحيح))

    # العامل الثلاثي
    متغير درجة = 85
    متغير تقدير = درجة >= 90 ? "ممتاز" : "جيد"
    اطبع_سطر("التقدير: " + تقدير)

    # الإسناد المركب
    متغير عداد = 0
    عداد += 5
    اطبع_سطر("بعد += 5: " + عداد)
    عداد *= 3
    اطبع_سطر("بعد *= 3: " + عداد)
نهاية
