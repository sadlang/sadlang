# --- مثال 1: المضروب (Factorial) ---
دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

# --- مثال 2: مجموع الأعداد من 1 إلى ن ---
دالة مجموع_حتى(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    ارجع ن + مجموع_حتى(ن - 1)
نهاية

# --- مثال 3: حساب القوة (تكراري بدلاً من عودي لتوافق المترجم) ---
# ملاحظة: نستخدم حلقة بدلاً من العودية لتجنب مشاكل استنتاج الأنواع
دالة حساب_قوة(قاعد، مرات)
    متغير ناتج = 1
    متغير ت = 0
    بينما (ت < مرات)
        ناتج = ناتج * قاعد
        ت = ت + 1
    نهاية
    ارجع ناتج
نهاية

# دالة مساعدة: قسمة صحيحة على 10
دالة قسمة10(عدد)
    ارجع (عدد - عدد % 10) / 10
نهاية

# دالة مساعدة: قسمة صحيحة على 2
دالة قسمة2(عدد)
    ارجع (عدد - عدد % 2) / 2
نهاية

# --- مثال 4: عد الأرقام في عدد ---
دالة عد_أرقام(عدد)
    إذا (عدد < 0)
        عدد = 0 - عدد
    نهاية
    إذا (عدد < 10)
        ارجع 1
    نهاية
    ارجع 1 + عد_أرقام(قسمة10(عدد))
نهاية

# --- مثال 5: فيبوناتشي ---
دالة فيبوناتشي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

# --- مثال 6: القاسم المشترك الأكبر (GCD) ---
دالة ق_م_أ(أ، ب)
    إذا (ب == 0)
        ارجع أ
    نهاية
    ارجع ق_م_أ(ب، أ % ب)
نهاية

# --- مثال 7: مجموع أرقام العدد ---
دالة مجموع_أرقام(عدد)
    إذا (عدد < 0)
        عدد = 0 - عدد
    نهاية
    إذا (عدد < 10)
        ارجع عدد
    نهاية
    ارجع عدد % 10 + مجموع_أرقام(قسمة10(عدد))
نهاية

# --- مثال 8: التمثيل الثنائي ---
دالة إلى_ثنائي(عدد)
    إذا (عدد <= 0)
        ارجع "0"
    نهاية
    إذا (عدد == 1)
        ارجع "1"
    نهاية
    متغير باقي = عدد % 2
    ارجع إلى_ثنائي(قسمة2(عدد)) + "" + باقي
نهاية

