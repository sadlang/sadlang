# --- مثال 1: معامل واحد ---
دالة ضعف(عدد)
    ارجع عدد * 2
نهاية

# --- مثال 2: معاملات متعددة ---
دالة حاصل_الطرح(أ، ب)
    ارجع أ - ب
نهاية

# --- مثال 3: خلط أنواع مختلفة ---
دالة كرر_نص(نص_أصلي، عدد_مرات)
    متغير النتيجة = ""
    متغير ع = 0
    بينما (ع < عدد_مرات)
        النتيجة = النتيجة + نص_أصلي
        ع = ع + 1
    نهاية
    ارجع النتيجة
نهاية

# --- مثال 4: نمط القيمة الافتراضية باستخدام إذا ---
دالة تحية_مع_لقب(الاسم، اللقب)
    متغير لقب_فعلي = "سيد"
    إذا (اللقب != "")
        لقب_فعلي = اللقب
    نهاية
    ارجع "مرحباً " + لقب_فعلي + " " + الاسم
نهاية

# --- مثال 5: دالة تتعامل مع نص وعدد ---
دالة اصنع_بطاقة(الاسم، العمر)
    ارجع "الاسم: " + الاسم + " | العمر: " + العمر
نهاية

# --- مثال 6: تمرير نتائج دالة لدالة أخرى ---
دالة حساب_مساحة(طول، عرض)
    ارجع طول * عرض
نهاية

دالة وصف_مساحة(المساحة)
    إذا (المساحة > 100)
        ارجع "مساحة كبيرة: " + المساحة
    وإلا
        ارجع "مساحة صغيرة: " + المساحة
    نهاية
نهاية

# --- مثال 7: دالة بثلاثة معاملات ---
دالة معادلة_خطية(أ، ب، س)
    # حساب أ*س + ب
    ارجع أ * س + ب
نهاية

# --- مثال 8: سلسلة دوال تتبادل النتائج ---
دالة سنتيمتر_إلى_متر(سم)
    ارجع سم / 100
نهاية

دالة متر_إلى_كيلومتر(م)
    ارجع م / 1000
نهاية

