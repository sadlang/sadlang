# --- مثال 1: دالة تحقق من الزوجية ---
دالة زوجي(عدد)
    ارجع عدد % 2 == 0
نهاية

# --- مثال 2: دالة تحقق من الفردية ---
دالة فردي(عدد)
    ارجع عدد % 2 != 0
نهاية

# --- مثال 3: دالة القيمة المطلقة ---
دالة قيمة_مطلقة(عدد)
    إذا (عدد < 0)
        ارجع 0 - عدد
    نهاية
    ارجع عدد
نهاية

# --- مثال 4: دالة الأكبر بين عددين ---
دالة الأكبر(أ، ب)
    إذا (أ > ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

# --- مثال 5: دالة الأصغر بين عددين ---
دالة الأصغر(أ، ب)
    إذا (أ < ب)
        ارجع أ
    نهاية
    ارجع ب
نهاية

# --- مثال 6: دالة التحقق من نطاق ---
دالة في_نطاق(قيمة، حد_أدنى، حد_أقصى)
    متغير فوق_الأدنى = قيمة >= حد_أدنى
    متغير تحت_الأقصى = قيمة <= حد_أقصى
    إذا (فوق_الأدنى)
        إذا (تحت_الأقصى)
            ارجع صحيح
        نهاية
    نهاية
    ارجع خطأ
نهاية

# --- مثال 7: دالة تحويل درجة الحرارة ---
دالة سيليزي_إلى_فهرنهايت(د)
    ارجع د * 9 / 5 + 32
نهاية

# --- مثال 8: دالة تصنيف العمر ---
دالة تصنيف_عمر(عمر)
    إذا (عمر < 0)
        ارجع "عمر غير صالح"
    والا_اذا (عمر < 13)
        ارجع "طفل"
    والا_اذا (عمر < 18)
        ارجع "مراهق"
    والا_اذا (عمر < 60)
        ارجع "بالغ"
    وإلا
        ارجع "كبير السن"
    نهاية
