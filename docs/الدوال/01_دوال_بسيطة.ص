# 01 - الدوال البسيطة
# Simple Function Basics
# يوضح هذا الملف أساسيات تعريف واستدعاء الدوال
# ===================================================

# --- مثال 1: دالة بدون معاملات ---
دالة تحية_بسيطة()
    اطبع_سطر("مرحباً بك في لغة ص!")
نهاية

# --- مثال 2: دالة ترجع قيمة عددية ---
دالة اعطني_عشرة()
    ارجع 10
نهاية

# --- مثال 3: دالة ترحيب باسم ---
دالة رحب(الاسم)
    ارجع "أهلاً يا " + الاسم + "!"
نهاية

# --- مثال 4: دالة جمع عددين ---
دالة اجمع(أ، ب)
    ارجع أ + ب
نهاية

# --- مثال 5: دالة ضرب عددين ---
دالة اضرب(أ، ب)
    ارجع أ * ب
نهاية

# --- مثال 6: دالة حساب المربع ---
دالة مربع(س)
    ارجع س * س
نهاية

# --- مثال 7: دالة ترجع قيمة منطقية ---
دالة هل_موجب(عدد)
    ارجع عدد > 0
نهاية

# --- مثال 8: دالة مركبة تستخدم نتائج دوال أخرى ---
دالة مجموع_المربعات(أ، ب)
    متغير م1 = مربع(أ)
    متغير م2 = مربع(ب)
    ارجع م1 + م2
نهاية

دالة رئيسية()
    اطبع_سطر("=== 01: الدوال البسيطة ===")

    # مثال 1: دالة بدون معاملات
    اطبع_سطر("--- مثال 1: دالة بدون معاملات ---")
    تحية_بسيطة()

    # مثال 2: دالة ترجع قيمة
    اطبع_سطر("--- مثال 2: دالة ترجع قيمة ---")
    متغير القيمة = اعطني_عشرة()
    اطبع_سطر("القيمة المرجعة: " + القيمة)

    # مثال 3: دالة ترحيب
    اطبع_سطر("--- مثال 3: دالة ترحيب ---")
    متغير رسالة = رحب("أحمد")
    اطبع_سطر(رسالة)
    اطبع_سطر(رحب("سارة"))

    # مثال 4: دالة الجمع
    اطبع_سطر("--- مثال 4: دالة الجمع ---")
    متغير ناتج_الجمع = اجمع(15، 25)
    اطبع_سطر("15 + 25 = " + ناتج_الجمع)

    # مثال 5: دالة الضرب
    اطبع_سطر("--- مثال 5: دالة الضرب ---")
    متغير ناتج_الضرب = اضرب(6، 7)
    اطبع_سطر("6 * 7 = " + ناتج_الضرب)

    # مثال 6: دالة المربع
    اطبع_سطر("--- مثال 6: دالة المربع ---")
    اطبع_سطر("مربع 5 = " + مربع(5))
    اطبع_سطر("مربع 12 = " + مربع(12))

    # مثال 7: دالة منطقية
    اطبع_سطر("--- مثال 7: دالة منطقية ---")
    اطبع_سطر("هل 10 موجب؟ " + هل_موجب(10))
    اطبع_سطر("هل -3 موجب؟ " + هل_موجب(-3))
    اطبع_سطر("هل 0 موجب؟ " + هل_موجب(0))

    # مثال 8: استدعاء دوال داخل تعبيرات
    اطبع_سطر("--- مثال 8: استدعاء دوال في تعبيرات ---")
    متغير النتيجة = مجموع_المربعات(3، 4)
    اطبع_سطر("مجموع مربعات 3 و 4 = " + النتيجة)
    متغير مركب = اجمع(مربع(2)، مربع(3))
    اطبع_سطر("مربع(2) + مربع(3) = " + مركب)

    اطبع_سطر("=== انتهى 01 ===")
نهاية
