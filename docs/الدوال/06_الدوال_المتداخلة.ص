# --- مثال 1: مجموعة دوال التحقق من الأعداد ---
دالة هل_زوجي(عدد)
    ارجع عدد % 2 == 0
نهاية

دالة هل_فردي(عدد)
    ارجع !هل_زوجي(عدد)
نهاية

دالة هل_موجب(عدد)
    ارجع عدد > 0
نهاية

دالة هل_سالب(عدد)
    ارجع عدد < 0
نهاية

# --- مثال 2: دوال تنسيق النصوص ---
دالة أضف_أقواس(محتوى)
    ارجع "(" + محتوى + ")"
نهاية

دالة أضف_نجوم(محتوى)
    ارجع "== " + محتوى + " =="
نهاية

دالة عنوان_منسق(محتوى)
    ارجع أضف_نجوم(محتوى)
نهاية

# --- مثال 3: دوال الحسابات المالية ---
دالة حساب_ضريبة(المبلغ، نسبة_الضريبة)
    ارجع المبلغ * نسبة_الضريبة / 100
نهاية

دالة المبلغ_بعد_الضريبة(المبلغ، نسبة_الضريبة)
    متغير الضريبة = حساب_ضريبة(المبلغ، نسبة_الضريبة)
    ارجع المبلغ + الضريبة
نهاية

دالة وصف_فاتورة(الصنف، المبلغ، نسبة_الضريبة)
    متغير الضريبة = حساب_ضريبة(المبلغ، نسبة_الضريبة)
    متغير الإجمالي = المبلغ_بعد_الضريبة(المبلغ، نسبة_الضريبة)
    ارجع الصنف + ": " + المبلغ + " + ضريبة " + الضريبة + " = " + الإجمالي
نهاية

# --- مثال 4: دوال تحويل الوحدات ---
دالة كم_إلى_ميل(كم)
    ارجع كم * 621 / 1000
نهاية

دالة ميل_إلى_كم(ميل)
    ارجع ميل * 1609 / 1000
نهاية

دالة مقارنة_مسافة(مسافة_كم)
    متغير بالميل = كم_إلى_ميل(مسافة_كم)
    ارجع "" + مسافة_كم + " كم = " + بالميل + " ميل"
نهاية

# --- مثال 5: دوال معالجة الدرجات ---
دالة تقدير_درجة(درجة)
    إذا (درجة >= 90)
        ارجع "ممتاز"
    والا_اذا (درجة >= 80)
        ارجع "جيد جداً"
    والا_اذا (درجة >= 70)
        ارجع "جيد"
    والا_اذا (درجة >= 60)
        ارجع "مقبول"
    وإلا
        ارجع "راسب"
    نهاية
نهاية

دالة هل_ناجح(درجة)
    ارجع درجة >= 60
نهاية

دالة تقرير_طالب(الاسم، درجة)
    متغير التقدير = تقدير_درجة(درجة)
    متغير الحالة = "ناجح"
    إذا (!هل_ناجح(درجة))
        الحالة = "راسب"
    نهاية
    ارجع الاسم + " | " + درجة + " | " + التقدير + " | " + الحالة
نهاية

# --- مثال 6: دوال العمليات على عدد ---
دالة مكعب(عدد)
    ارجع عدد * عدد * عدد
نهاية

دالة مربع(عدد)
    ارجع عدد * عدد
نهاية

دالة مجموع_مربع_ومكعب(عدد)
    ارجع مربع(عدد) + مكعب(عدد)
نهاية

# --- مثال 7: دوال التحقق من كلمة المرور ---
دالة طول_كافي(طول)
    ارجع طول >= 8
نهاية

دالة تقييم_قوة(طول)
    إذا (طول >= 16)
        ارجع "قوية جداً"
    والا_اذا (طول >= 12)
        ارجع "قوية"
    والا_اذا (طول >= 8)
        ارجع "متوسطة"
    وإلا
        ارجع "ضعيفة"
    نهاية
نهاية

دالة فحص_كلمة_مرور(طول)
    إذا (!طول_كافي(طول))
        ارجع "مرفوضة - الطول " + طول + " غير كاف"
    نهاية
    ارجع "مقبولة - القوة: " + تقييم_قوة(طول)
نهاية

# --- مثال 8: دوال بناء تقرير ---
دالة خط_فاصل()
    ارجع "------------------------"
نهاية

دالة سطر_بيانات(التسمية، القيمة)
    ارجع التسمية + ": " + القيمة
نهاية

دالة تقرير_منتج(الاسم، السعر، الكمية)
    متغير الإجمالي = السعر * الكمية
    اطبع_سطر(خط_فاصل())
    اطبع_سطر(سطر_بيانات("المنتج"، الاسم))
    اطبع_سطر(سطر_بيانات("السعر"، السعر))
    اطبع_سطر(سطر_بيانات("الكمية"، الكمية))
    اطبع_سطر(سطر_بيانات("الإجمالي"، الإجمالي))
    اطبع_سطر(خط_فاصل())
نهاية

دالة رئيسية()
    اطبع_سطر("=== 06: تنظيم الدوال ===")

    # مثال 1: التحقق من الأعداد
    اطبع_سطر("--- مثال 1: دوال التحقق من الأعداد ---")
    اطبع_سطر("هل 4 زوجي؟ " + هل_زوجي(4))
    اطبع_سطر("هل 7 فردي؟ " + هل_فردي(7))
    اطبع_سطر("هل 5 موجب؟ " + هل_موجب(5))
    اطبع_سطر("هل -3 سالب؟ " + هل_سالب(-3))

    # مثال 2: تنسيق النصوص
    اطبع_سطر("--- مثال 2: تنسيق النصوص ---")
    اطبع_سطر(أضف_أقواس("لغة ص"))
