# أنواع الإرجاع في الدوال
# Return Types in Functions
# يوضح هذا الملف أنماط إرجاع القيم المختلفة من الدوال

# --- مثال 1: إرجاع عدد صحيح ---
دالة مربع(س)
    ارجع س * س
نهاية

# --- مثال 2: إرجاع نتيجة قسمة صحيحة ---
# ملاحظة: نستخدم قسمة صحيحة (/ 2) لتوافق المترجم
دالة نصف(س)
    ارجع س / 2
نهاية

# --- مثال 3: إرجاع نص ---
دالة تحية(اسم)
    ارجع "مرحباً يا " + اسم + "!"
نهاية

# --- مثال 4: إرجاع قيمة منطقية ---
دالة هل_موجب(س)
    ارجع س > 0
نهاية

# --- مثال 5: إرجاع مبكر (حالة خاصة) ---
دالة قسمة_آمنة(أ، ب)
    إذا (ب == 0)
        ارجع 0 - 1
    نهاية
    ارجع أ / ب
نهاية

# --- مثال 6: مسارات إرجاع متعددة ---
دالة تصنيف_عمر(عمر)
    إذا (عمر < 0)
        ارجع "خطأ: عمر سالب"
    نهاية
    إذا (عمر < 13)
        ارجع "طفل"
    نهاية
    إذا (عمر < 18)
        ارجع "مراهق"
    نهاية
    إذا (عمر < 60)
        ارجع "بالغ"
    نهاية
    ارجع "كبير"
نهاية

# --- مثال 7: إرجاع نتيجة حسابية صحيحة مركبة ---
# تقريب صحيح لمساحة الدائرة: 355/113 ≈ باي
دالة مساحة_دائرة_تقريب(نق)
    ارجع (355 * نق * نق) / 113
نهاية

# --- مثال 8: إرجاع بناءً على شرط منطقي مركب ---
دالة هل_في_نطاق(قيمة، حد_أدنى، حد_أعلى)
    إذا (قيمة >= حد_أدنى)
        إذا (قيمة <= حد_أعلى)
            ارجع 1
        نهاية
    نهاية
    ارجع 0
نهاية

# --- الدالة الرئيسية ---
دالة رئيسية()
    # اختبار 1: إرجاع عدد صحيح
    اطبع_سطر("مربع 5 = " + مربع(5))

    # اختبار 2: إرجاع نتيجة قسمة صحيحة
    اطبع_سطر("نصف 7 = " + نصف(7))
    اطبع_سطر("نصف 10 = " + نصف(10))

    # اختبار 2ب: حساب عشري مباشر (بدون دالة)
    # جميع القيم عشرية لتجنب خلط الأنواع
    متغير نصف_عشري = 7.0 / 2.0
    اطبع_سطر("نصف 7 (عشري) = " + نصف_عشري)

    # اختبار 3: إرجاع نص
    اطبع_سطر(تحية("أحمد"))

    # اختبار 4: إرجاع قيمة منطقية
    إذا (هل_موجب(5))
        اطبع_سطر("5 عدد موجب: صحيح")
    نهاية
    إذا (هل_موجب(0 - 3) == خطأ)
        اطبع_سطر("-3 ليس موجباً: صحيح")
    نهاية

    # اختبار 5: إرجاع مبكر
    اطبع_سطر("10 / 2 = " + قسمة_آمنة(10، 2))
    اطبع_سطر("10 / 0 = " + قسمة_آمنة(10، 0))

    # اختبار 6: مسارات إرجاع متعددة
    اطبع_سطر("عمر 5: " + تصنيف_عمر(5))
    اطبع_سطر("عمر 15: " + تصنيف_عمر(15))
    اطبع_سطر("عمر 30: " + تصنيف_عمر(30))
    اطبع_سطر("عمر 70: " + تصنيف_عمر(70))

    # اختبار 7أ: تقريب صحيح لمساحة الدائرة (دالة)
    اطبع_سطر("مساحة دائرة نصف قطرها 5 (تقريب) = " + مساحة_دائرة_تقريب(5))

    # اختبار 7ب: مساحة دائرة بقيم عشرية (مباشر)
    # جميع القيم عشرية لتجنب خلط الأنواع
    متغير ط = 3.14159
    متغير نق = 5.0
    متغير المساحة = ط * نق * نق
    اطبع_سطر("مساحة دائرة نصف قطرها 5 (دقيق) = " + المساحة)

    # اختبار 8: فحص النطاق
    إذا (هل_في_نطاق(5، 1، 10) == 1)
        اطبع_سطر("5 ضمن النطاق 1-10: صحيح")
    نهاية
    إذا (هل_في_نطاق(15، 1، 10) == 0)
        اطبع_سطر("15 خارج النطاق 1-10: صحيح")
    نهاية
نهاية
