دالة هل_أولي(عدد)
    إذا (عدد < 2)
        ارجع 0
    نهاية
    إذا (عدد == 2)
        ارجع 1
    نهاية
    إذا (عدد % 2 == 0)
        ارجع 0
    نهاية
    متغير ق = 3
    بينما (ق * ق <= عدد)
        إذا (عدد % ق == 0)
            ارجع 0
        نهاية
        ق = ق + 2
    نهاية
    ارجع 1
