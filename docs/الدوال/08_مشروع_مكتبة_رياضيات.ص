# ===== هل العدد كامل (Perfect Number)؟ =====
دالة هل_كامل(عدد)
    إذا (عدد <= 1)
        ارجع 0
    نهاية
    متغير مجموع = 1
    متغير ق = 2
    بينما (ق * ق <= عدد)
        إذا (عدد % ق == 0)
            مجموع = مجموع + ق
            إذا (ق != عدد / ق)
                مجموع = مجموع + عدد / ق
            نهاية
        نهاية
        ق = ق + 1
    نهاية
    متغير نتيجة = 0
    إذا (مجموع == عدد)
        نتيجة = 1
    نهاية
    ارجع نتيجة
نهاية

# ===== مجموع الأرقام =====
دالة مجموع_أرقام(عدد)
    متغير ن = قيمة_مطلقة(عدد)
    متغير مجموع = 0
    بينما (ن > 0)
        مجموع = مجموع + ن % 10
        ن = (ن - ن % 10) / 10
    نهاية
    ارجع مجموع
