# ===== القاسم المشترك الأكبر =====
دالة ق_م_أ(أ، ب)
    متغير قأ = قيمة_مطلقة(أ)
    متغير قب = قيمة_مطلقة(ب)
    بينما (قب != 0)
        متغير باقي = قأ % قب
        قأ = قب
        قب = باقي
    نهاية
    ارجع قأ
نهاية

# ===== المضاعف المشترك الأصغر =====
دالة م_م_أ(أ، ب)
    متغير قأ = أ
    متغير قب = ب
    إذا (قأ == 0)
        ارجع 0
    نهاية
    إذا (قب == 0)
        ارجع 0
    نهاية
    متغير حاصل = قيمة_مطلقة(قأ) * قيمة_مطلقة(قب)
    ارجع حاصل / ق_م_أ(قأ، قب)
نهاية

