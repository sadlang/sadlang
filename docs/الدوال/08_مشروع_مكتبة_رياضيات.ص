# ===== الأس (القوة) =====
دالة أس(قاعدة، قوة)
    إذا (قوة == 0)
        ارجع 1
    نهاية
    متغير النتيجة = 1
    متغير ع = 0
    بينما (ع < قوة)
        النتيجة = النتيجة * قاعدة
        ع = ع + 1
    نهاية
    ارجع النتيجة
نهاية

# ===== المضروب =====
دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    متغير النتيجة = 1
    متغير ع = 2
    بينما (ع <= ن)
        النتيجة = النتيجة * ع
        ع = ع + 1
    نهاية
    ارجع النتيجة
نهاية

