# أنماط إنتاج البيانات
# Data Production Patterns
# يوضح هذا الملف أنماط إنتاج البيانات باستخدام الحلقات والكائنات

# --- مثال 1: حساب مجموع متسلسلة ---
دالة مجموع_حتى(ن)
    متغير مجموع = 0
    متغير ع = 1
    بينما (ع <= ن)
        مجموع = مجموع + ع
        ع = ع + 1
    نهاية
    ارجع مجموع
نهاية

# --- مثال 2: حساب المضروب ---
دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    متغير نتيجة = 1
    متغير ع = 2
    بينما (ع <= ن)
        نتيجة = نتيجة * ع
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# --- مثال 3: حساب فيبوناتشي عند موضع معين ---
دالة فيبوناتشي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    متغير أ = 0
    متغير ب = 1
    متغير ع = 2
    بينما (ع <= ن)
        متغير مؤقت = أ + ب
        أ = ب
        ب = مؤقت
        ع = ع + 1
    نهاية
    ارجع ب
نهاية

# --- مثال 4: عد عوامل عدد ---
دالة عدد_العوامل(ن)
    متغير عداد = 0
    متغير ع = 1
    بينما (ع <= ن)
        إذا (ن % ع == 0)
            عداد = عداد + 1
        نهاية
        ع = ع + 1
    نهاية
    ارجع عداد
نهاية

# --- مثال 5: كائن عداد يحتفظ بالحالة ---
صنف عداد
    باني()
        هذا.القيمة = 0
    نهاية

    دالة زيادة()
        هذا.القيمة = هذا.القيمة + 1
        ارجع هذا.القيمة
    نهاية

    دالة نقصان()
        هذا.القيمة = هذا.القيمة - 1
        ارجع هذا.القيمة
    نهاية

    دالة الحالي()
        ارجع هذا.القيمة
    نهاية
نهاية

# --- مثال 6: كائن مُراكم يجمع القيم ---
صنف مراكم
    باني(قيمة_أولية)
        هذا.المجموع = قيمة_أولية
        هذا.العدد = 0
    نهاية

    دالة أضف(قيمة)
        هذا.المجموع = هذا.المجموع + قيمة
        هذا.العدد = هذا.العدد + 1
        ارجع هذا.المجموع
    نهاية

    دالة رقم المتوسط()
        متغير نتيجة = 0
        إذا (هذا.العدد > 0)
            نتيجة = هذا.المجموع / هذا.العدد
        نهاية
        ارجع نتيجة
    نهاية
نهاية

# --- مثال 7: حساب القوى (أس) ---
دالة قوة(قاعدة، طاقة)
    متغير نتيجة = 1
    متغير ع = 0
    بينما (ع < طاقة)
        نتيجة = نتيجة * قاعدة
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

# --- مثال 8: كائن منتج لسلسلة أعداد ---
صنف منتج_أعداد
    باني(بداية، خطوة)
        هذا.الحالي = بداية
        هذا.الخطوة = خطوة
    نهاية

    دالة التالي()
        متغير قيمة = هذا.الحالي
        هذا.الحالي = هذا.الحالي + هذا.الخطوة
        ارجع قيمة
    نهاية

    دالة رقم مجموع_عناصر(عدد)
        متغير مجموع = 0
        متغير ع = 0
        بينما (ع < عدد)
            مجموع = مجموع + هذا.التالي()
            ع = ع + 1
        نهاية
        ارجع مجموع
    نهاية
نهاية

# --- الدالة الرئيسية ---
دالة رئيسية()
    # مثال 1: مجموع متسلسلة
    اطبع_سطر("مجموع 1 إلى 10 = " + مجموع_حتى(10))

    # مثال 2: المضروب
    اطبع_سطر("مضروب 5 = " + مضروب(5))
    اطبع_سطر("مضروب 7 = " + مضروب(7))

    # مثال 3: فيبوناتشي
    اطبع_سطر("فيبوناتشي(0) = " + فيبوناتشي(0))
    اطبع_سطر("فيبوناتشي(1) = " + فيبوناتشي(1))
    اطبع_سطر("فيبوناتشي(7) = " + فيبوناتشي(7))
    اطبع_سطر("فيبوناتشي(10) = " + فيبوناتشي(10))

    # مثال 4: عد العوامل
    اطبع_سطر("عوامل 12 = " + عدد_العوامل(12))
    اطبع_سطر("عوامل 7 = " + عدد_العوامل(7))

    # مثال 5: كائن عداد
    متغير ع = جديد عداد()
    ع.زيادة()
    ع.زيادة()
    ع.زيادة()
    اطبع_سطر("العداد بعد 3 زيادات = " + ع.الحالي())
    ع.نقصان()
    اطبع_سطر("العداد بعد نقصان = " + ع.الحالي())

    # مثال 6: كائن مُراكم
    متغير م = جديد مراكم(0)
    م.أضف(10)
    م.أضف(20)
    م.أضف(30)
    اطبع_سطر("المجموع = " + م.المجموع)
    اطبع_سطر("العدد = " + م.العدد)

    # مثال 7: القوى
    اطبع_سطر("2 أس 8 = " + قوة(2، 8))
    اطبع_سطر("3 أس 4 = " + قوة(3، 4))

    # مثال 8: منتج أعداد
    متغير منتج = جديد منتج_أعداد(1، 2)
    اطبع_سطر("التالي = " + منتج.التالي())
    اطبع_سطر("التالي = " + منتج.التالي())
    اطبع_سطر("التالي = " + منتج.التالي())

    متغير منتج2 = جديد منتج_أعداد(0، 5)
    اطبع_سطر("مجموع أول 4 عناصر (بخطوة 5) = " + منتج2.مجموع_عناصر(4))
نهاية
