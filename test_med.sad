دالة عرض(نص رسالة)
    اطبع_سطر("  " + رسالة)
نهاية

دالة عرض_متغير(نص اسم، نص قيمة، رقم بداية، رقم نهايته)
    اطبع_سطر("  متغير '" + اسم + "' = " + قيمة)
    اطبع_سطر("    العمر: من " + لنص(بداية) + " إلى " + لنص(نهايته))
نهاية

دالة منطقي تحقق(نص وصف، منطقي نتيجة)
    إذا (نتيجة)
        اطبع_سطر("  [✓] " + وصف)
    وإلا
        اطبع_سطر("  [✗] " + وصف)
    نهاية
    ارجع نتيجة
نهاية

دالة مثال_1()
    اطبع_سطر("=== مثال أول ===")
    عرض_متغير("أ"، "10"، 1، 5)
    عرض_متغير("ب"، "20"، 2، 8)
    عرض("نهاية المثال")
نهاية

دالة مثال_2()
    اطبع_سطر("=== مثال ثاني ===")
    رقم ن = 0
    إذا (تحقق("قاعدة 1"، صحيح))
        ن = ن + 1
    نهاية
    إذا (تحقق("قاعدة 2"، صحيح))
        ن = ن + 1
    نهاية
    إذا (تحقق("قاعدة 3"، صحيح))
        ن = ن + 1
    نهاية
    اطبع_سطر("  نتيجة: " + لنص(ن) + "/3")
نهاية

دالة مثال_3()
    اطبع_سطر("=== مثال ثالث ===")
    عرض_متغير("س"، "100"، 1، 10)
    عرض_متغير("ع"، "200"، 3، 7)
    عرض("فحص عمر المرجع")
    إذا (3 > 1)
        إذا (7 < 10)
            عرض("المرجع ع يعيش ضمن عمر س")
        وإلا
            عرض("خطأ: المرجع أطول عمراً")
        نهاية
    نهاية
نهاية

دالة رئيسية() -> رقم
    اطبع_سطر("اختبار")
    مثال_1()
    مثال_2()
    مثال_3()
    ارجع 0
نهاية
