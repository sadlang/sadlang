استورد واجهة_هاتف

// الشاشة الرئيسية
واجهة شاشة_رئيسية {
    @حالة عداد: عدد = 0

    عرض() {
        عمود(توسيط: صحيح) {
            نص("مرحباً من لغة ص! 🌟")
                .حجم_خط(24)
                .لون(.أزرق)

            نص("العداد: " + نص(عداد))
                .حجم_خط(18)

            زر("+1") {
                عداد = عداد + 1
            }
            .نمط(.مملوء)
            .لون_خلفية(.أخضر)
        }
    }
}

// نقطة الدخول
دالة رئيسية() {
    أعرض(شاشة_رئيسية())
}
