# =============================================================================
# اختبار iOS 3: نظام الإشعارات المحلية
# =============================================================================

صنف اشعار
    باني(عنوان، رسالة)
        هذا.المعرف = ""
        هذا.العنوان = عنوان
        هذا.الرسالة = رسالة
        هذا.شارة = 0
        هذا.صوت = "افتراضي"
        هذا.تأخير = 0
        هذا.مكرر = خطأ
        هذا.تم_التسليم = خطأ
    نهاية
نهاية

صنف مركز_اشعارات
    باني()
        هذا.الاشعارات = []
        هذا.المسلّمة = []
        هذا.العداد = 0
        هذا.مصرح = خطأ
    نهاية

    دالة اطلب_إذن()
        هذا.مصرح = صحيح
        ارجع صحيح
    نهاية

    دالة جدول(اشعار_وارد)
        هذا.العداد = هذا.العداد + 1
        اشعار_وارد.المعرف = "اشعار_" + نص(هذا.العداد)
        هذا.الاشعارات = هذا.الاشعارات + [اشعار_وارد]
        ارجع اشعار_وارد.المعرف
    نهاية

    دالة سلّم(معرف_الاشعار)
        لكل إ في هذا.الاشعارات
            إذا (إ.المعرف == معرف_الاشعار)
                إ.تم_التسليم = صحيح
                هذا.المسلّمة = هذا.المسلّمة + [إ]
            نهاية
        نهاية
    نهاية

    دالة الغ(معرف_الاشعار)
        متغير محدثة = []
        لكل إ في هذا.الاشعارات
            إذا (إ.المعرف != معرف_الاشعار)
                محدثة = محدثة + [إ]
            نهاية
        نهاية
        هذا.الاشعارات = محدثة
    نهاية

    دالة عدد_المجدولة()
        متغير عدد = 0
        لكل إ في هذا.الاشعارات
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية

    دالة عدد_المسلمة()
        متغير عدد = 0
        لكل إ في هذا.المسلّمة
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية

    دالة الغ_الكل()
        هذا.الاشعارات = []
    نهاية
نهاية

# --- تشغيل الاختبارات ---
متغير نجاح = 0
متغير فشل = 0

# اختبار 1: إنشاء مركز إشعارات
متغير مركز = جديد مركز_اشعارات()
إذا (مركز.مصرح == خطأ)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: مركز إشعارات")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 1: مركز")
نهاية

# اختبار 2: طلب إذن
إذا (مركز.اطلب_إذن() == صحيح)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 2: طلب إذن")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 2: إذن")
نهاية

# اختبار 3: جدولة إشعار
متغير إ1 = جديد اشعار("رسالة جديدة"، "لديك رسالة من أحمد")
متغير معرف1 = مركز.جدول(إ1)
إذا (معرف1 == "اشعار_1")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 3: جدولة إشعار")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 3: جدولة — " + معرف1)
نهاية

# اختبار 4: عدد المجدولة
متغير إ2 = جديد اشعار("تذكير"، "لا تنسَ الاجتماع")
مركز.جدول(إ2)
إذا (مركز.عدد_المجدولة() == 2)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 4: مجدولة = 2")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 4: مجدولة — " + نص(مركز.عدد_المجدولة()))
نهاية

# اختبار 5: تسليم إشعار
مركز.سلّم("اشعار_1")
إذا (مركز.عدد_المسلمة() == 1)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 5: تسليم إشعار")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 5: تسليم — " + نص(مركز.عدد_المسلمة()))
نهاية

# اختبار 6: إلغاء إشعار
مركز.الغ("اشعار_2")
إذا (مركز.عدد_المجدولة() == 1)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 6: إلغاء إشعار")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 6: إلغاء — " + نص(مركز.عدد_المجدولة()))
نهاية

# اختبار 7: إشعار بشارة
متغير إ3 = جديد اشعار("تحديث"، "يتوفر تحديث جديد")
إ3.شارة = 5
إذا (إ3.شارة == 5)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 7: إشعار بشارة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 7: شارة")
نهاية

# اختبار 8: صوت مخصص
إ3.صوت = "تنبيه"
إذا (إ3.صوت == "تنبيه")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 8: صوت مخصص")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 8: صوت")
نهاية

# اختبار 9: إشعار مكرر
إ3.مكرر = صحيح
إذا (إ3.مكرر == صحيح)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 9: إشعار مكرر")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 9: مكرر")
نهاية

# اختبار 10: إلغاء الكل
مركز.الغ_الكل()
إذا (مركز.عدد_المجدولة() == 0)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 10: إلغاء الكل")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 10: إلغاء الكل")
نهاية

اطبع_سطر("─────────────────────────────")
اطبع_سطر("إشعارات iOS: " + نص(نجاح) + "/" + نص(نجاح + فشل))
