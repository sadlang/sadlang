# =============================================================================
# اختبار iOS 5: URLSession (طلبات الشبكة)
# =============================================================================

صنف طلب_url
    باني(رابط، طريقة)
        هذا.الرابط = رابط
        هذا.الطريقة = طريقة
        هذا.الترويسات_مفاتيح = []
        هذا.الترويسات_قيم = []
        هذا.الجسم = ""
        هذا.مهلة = 60
        هذا.سياسة_التخزين = "افتراضي"
    نهاية

    دالة اضف_ترويسة(مفتاح، قيمة_ت)
        هذا.الترويسات_مفاتيح = هذا.الترويسات_مفاتيح + [مفتاح]
        هذا.الترويسات_قيم = هذا.الترويسات_قيم + [قيمة_ت]
    نهاية

    دالة عيّن_جسم(محتوى)
        هذا.الجسم = محتوى
    نهاية

    دالة عدد_الترويسات()
        متغير عدد = 0
        لكل ت في هذا.الترويسات_مفاتيح
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية
نهاية

صنف استجابة_url
    باني(الرمز، محتوى_الاستجابة، نوع_المحتوى)
        هذا.الرمز = الرمز
        هذا.المحتوى = محتوى_الاستجابة
        هذا.نوع_المحتوى = نوع_المحتوى
        هذا.ناجحة = (الرمز >= 200 و الرمز < 300)
    نهاية
نهاية

صنف جلسة_url
    باني()
        هذا.الطلبات = []
        هذا.عدد_الطلبات = 0
    نهاية

    دالة نفّذ(طلب)
        هذا.عدد_الطلبات = هذا.عدد_الطلبات + 1
        هذا.الطلبات = هذا.الطلبات + [طلب]

        إذا (طلب.الطريقة == "GET")
            ارجع جديد استجابة_url(200، "{\"بيانات\": []}"، "application/json")
        نهاية
        إذا (طلب.الطريقة == "POST")
            ارجع جديد استجابة_url(201، "{\"تم\": true}"، "application/json")
        نهاية
        إذا (طلب.الطريقة == "DELETE")
            ارجع جديد استجابة_url(204، ""، "")
        نهاية
        ارجع جديد استجابة_url(400، "خطأ"، "text/plain")
    نهاية

    دالة تحميل(رابط_ملف)
        هذا.عدد_الطلبات = هذا.عدد_الطلبات + 1
        ارجع جديد استجابة_url(200، "بيانات_ملف"، "application/octet-stream")
    نهاية
نهاية

# --- تشغيل الاختبارات ---
متغير نجاح = 0
متغير فشل = 0

# اختبار 1: إنشاء طلب
متغير ط1 = جديد طلب_url("https://api.sad.dev/v1/users"، "GET")
إذا (ط1.الرابط == "https://api.sad.dev/v1/users" و ط1.الطريقة == "GET")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: إنشاء طلب")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 1: طلب")
نهاية

# اختبار 2: إضافة ترويسات
ط1.اضف_ترويسة("Accept"، "application/json")
ط1.اضف_ترويسة("Authorization"، "Bearer xyz")
إذا (ط1.عدد_الترويسات() == 2)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 2: ترويسات")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 2: ترويسات — " + نص(ط1.عدد_الترويسات()))
نهاية

# اختبار 3: جلسة جديدة
متغير جلسة = جديد جلسة_url()
إذا (جلسة.عدد_الطلبات == 0)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 3: جلسة جديدة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 3: جلسة")
نهاية

# اختبار 4: GET request
متغير ر1 = جلسة.نفّذ(ط1)
إذا (ر1.الرمز == 200 و ر1.ناجحة == صحيح)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 4: GET 200")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 4: GET — " + نص(ر1.الرمز))
نهاية

# اختبار 5: POST request
متغير ط2 = جديد طلب_url("https://api.sad.dev/v1/users"، "POST")
ط2.عيّن_جسم("{\"اسم\": \"عمر\"}")
متغير ر2 = جلسة.نفّذ(ط2)
إذا (ر2.الرمز == 201)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 5: POST 201")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 5: POST — " + نص(ر2.الرمز))
نهاية

# اختبار 6: DELETE request
متغير ط3 = جديد طلب_url("https://api.sad.dev/v1/users/1"، "DELETE")
متغير ر3 = جلسة.نفّذ(ط3)
إذا (ر3.الرمز == 204)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 6: DELETE 204")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 6: DELETE — " + نص(ر3.الرمز))
نهاية

# اختبار 7: عداد الطلبات
إذا (جلسة.عدد_الطلبات == 3)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 7: عداد = 3")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 7: عداد — " + نص(جلسة.عدد_الطلبات))
نهاية

# اختبار 8: تحميل ملف
متغير ر4 = جلسة.تحميل("https://cdn.sad.dev/files/doc.pdf")
إذا (ر4.الرمز == 200 و ر4.نوع_المحتوى == "application/octet-stream")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 8: تحميل ملف")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 8: تحميل")
نهاية

# اختبار 9: نوع محتوى JSON
إذا (ر1.نوع_المحتوى == "application/json")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 9: نوع محتوى JSON")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 9: نوع محتوى")
نهاية

# اختبار 10: مهلة وسياسة تخزين
إذا (ط1.مهلة == 60 و ط1.سياسة_التخزين == "افتراضي")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 10: مهلة وسياسة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 10: مهلة")
نهاية

اطبع_سطر("─────────────────────────────")
اطبع_سطر("URLSession iOS: " + نص(نجاح) + "/" + نص(نجاح + فشل))
