# =============================================================================
# اختبار iOS 4: Core Data (قاعدة بيانات محلية)
# =============================================================================

صنف كيان
    باني(اسم_الكيان)
        هذا.الاسم = اسم_الكيان
        هذا.السجلات = []
        هذا.العداد = 0
    نهاية

    دالة اضف(سجل_بيانات)
        هذا.العداد = هذا.العداد + 1
        سجل_بيانات.المعرف = هذا.العداد
        هذا.السجلات = هذا.السجلات + [سجل_بيانات]
        ارجع سجل_بيانات
    نهاية

    دالة احذف(معرف)
        متغير محدثة = []
        لكل س في هذا.السجلات
            إذا (س.المعرف != معرف)
                محدثة = محدثة + [س]
            نهاية
        نهاية
        هذا.السجلات = محدثة
    نهاية

    دالة عدد()
        متغير عدد = 0
        لكل س في هذا.السجلات
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية

    دالة ابحث(معرف)
        لكل س في هذا.السجلات
            إذا (س.المعرف == معرف)
                ارجع س
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    دالة مسح()
        هذا.السجلات = []
        هذا.العداد = 0
    نهاية
نهاية

صنف سجل
    باني(بيانات_نصية)
        هذا.المعرف = 0
        هذا.البيانات = بيانات_نصية
        هذا.حقول_مفاتيح = []
        هذا.حقول_قيم = []
    نهاية

    دالة عيّن_حقل(مفتاح، قيمة_الحقل)
        هذا.حقول_مفاتيح = هذا.حقول_مفاتيح + [مفتاح]
        هذا.حقول_قيم = هذا.حقول_قيم + [قيمة_الحقل]
    نهاية

    دالة احصل_حقل(مفتاح)
        متغير ع = 0
        لكل م في هذا.حقول_مفاتيح
            إذا (م == مفتاح)
                ارجع هذا.حقول_قيم[ع]
            نهاية
            ع = ع + 1
        نهاية
        ارجع لاشيء
    نهاية
نهاية

صنف قاعدة_بيانات
    باني(اسم_القاعدة)
        هذا.الاسم = اسم_القاعدة
        هذا.الكيانات_أسماء = []
        هذا.الكيانات = []
    نهاية

    دالة سجّل_كيان(اسم_كيان)
        هذا.الكيانات_أسماء = هذا.الكيانات_أسماء + [اسم_كيان]
        هذا.الكيانات = هذا.الكيانات + [جديد كيان(اسم_كيان)]
    نهاية

    دالة احصل_كيان(اسم_كيان)
        متغير ع = 0
        لكل ا في هذا.الكيانات_أسماء
            إذا (ا == اسم_كيان)
                ارجع هذا.الكيانات[ع]
            نهاية
            ع = ع + 1
        نهاية
        ارجع لاشيء
    نهاية

    دالة عدد_الكيانات()
        متغير عدد = 0
        لكل ك في هذا.الكيانات
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية
نهاية

# --- تشغيل الاختبارات ---
متغير نجاح = 0
متغير فشل = 0

# اختبار 1: إنشاء قاعدة بيانات
متغير قاعدة = جديد قاعدة_بيانات("التطبيق")
إذا (قاعدة.الاسم == "التطبيق")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: إنشاء قاعدة بيانات")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 1: قاعدة")
نهاية

# اختبار 2: تسجيل كيان
قاعدة.سجّل_كيان("مستخدم")
إذا (قاعدة.عدد_الكيانات() == 1)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 2: تسجيل كيان")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 2: كيان")
نهاية

# اختبار 3: إضافة سجل
متغير كيان_مستخدم = قاعدة.احصل_كيان("مستخدم")
متغير س1 = جديد سجل("مستخدم")
س1.عيّن_حقل("الاسم"، "فاطمة")
س1.عيّن_حقل("البريد"، "fatima@sad.dev")
كيان_مستخدم.اضف(س1)
إذا (كيان_مستخدم.عدد() == 1)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 3: إضافة سجل")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 3: سجل")
نهاية

# اختبار 4: قراءة حقل
متغير نتيجة = كيان_مستخدم.ابحث(1)
إذا (نتيجة.احصل_حقل("الاسم") == "فاطمة")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 4: قراءة حقل")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 4: حقل")
نهاية

# اختبار 5: إضافة سجلات متعددة
متغير س2 = جديد سجل("مستخدم")
س2.عيّن_حقل("الاسم"، "خالد")
كيان_مستخدم.اضف(س2)
متغير س3 = جديد سجل("مستخدم")
س3.عيّن_حقل("الاسم"، "ليلى")
كيان_مستخدم.اضف(س3)
إذا (كيان_مستخدم.عدد() == 3)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 5: 3 سجلات")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 5: سجلات — " + نص(كيان_مستخدم.عدد()))
نهاية

# اختبار 6: حذف سجل
كيان_مستخدم.احذف(2)
إذا (كيان_مستخدم.عدد() == 2)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 6: حذف سجل")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 6: حذف — " + نص(كيان_مستخدم.عدد()))
نهاية

# اختبار 7: بحث بعد حذف
إذا (كيان_مستخدم.ابحث(2) == لاشيء)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 7: بحث بعد حذف")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 7: بحث")
نهاية

# اختبار 8: كيان ثاني
قاعدة.سجّل_كيان("منشور")
متغير كيان_منشور = قاعدة.احصل_كيان("منشور")
متغير م_س1 = جديد سجل("منشور")
م_س1.عيّن_حقل("عنوان_المنشور"، "أول منشور")
كيان_منشور.اضف(م_س1)
إذا (قاعدة.عدد_الكيانات() == 2 و كيان_منشور.عدد() == 1)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 8: كيان ثاني")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 8: كيان ثاني")
نهاية

# اختبار 9: معرف تلقائي للكيان الثاني
إذا (م_س1.المعرف == 1)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 9: معرف مستقل")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 9: معرف — " + نص(م_س1.المعرف))
نهاية

# اختبار 10: مسح كيان
كيان_مستخدم.مسح()
إذا (كيان_مستخدم.عدد() == 0)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 10: مسح كيان")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 10: مسح")
نهاية

اطبع_سطر("─────────────────────────────")
اطبع_سطر("Core Data iOS: " + نص(نجاح) + "/" + نص(نجاح + فشل))
