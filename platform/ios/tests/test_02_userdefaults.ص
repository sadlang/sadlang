# =============================================================================
# اختبار iOS 2: UserDefaults (تخزين محلي iOS)
# =============================================================================

صنف تخزين_ios
    باني(اسم_النطاق)
        هذا.النطاق = اسم_النطاق
        هذا.مفاتيح = []
        هذا.قيم = []
        هذا.أنواع = []
    نهاية

    دالة عيّن(مفتاح، قيمة_المدخل، نوع_القيمة)
        متغير موقع = -1
        متغير ع = 0
        لكل م في هذا.مفاتيح
            إذا (م == مفتاح)
                موقع = ع
            نهاية
            ع = ع + 1
        نهاية
        إذا (موقع >= 0)
            هذا.قيم[موقع] = قيمة_المدخل
            هذا.أنواع[موقع] = نوع_القيمة
        وإلا
            هذا.مفاتيح = هذا.مفاتيح + [مفتاح]
            هذا.قيم = هذا.قيم + [قيمة_المدخل]
            هذا.أنواع = هذا.أنواع + [نوع_القيمة]
        نهاية
    نهاية

    دالة احصل(مفتاح)
        متغير ع = 0
        لكل م في هذا.مفاتيح
            إذا (م == مفتاح)
                ارجع هذا.قيم[ع]
            نهاية
            ع = ع + 1
        نهاية
        ارجع لاشيء
    نهاية

    دالة احذف(مفتاح)
        متغير مفاتيح_م = []
        متغير قيم_م = []
        متغير أنواع_م = []
        متغير ع = 0
        لكل م في هذا.مفاتيح
            إذا (م != مفتاح)
                مفاتيح_م = مفاتيح_م + [م]
                قيم_م = قيم_م + [هذا.قيم[ع]]
                أنواع_م = أنواع_م + [هذا.أنواع[ع]]
            نهاية
            ع = ع + 1
        نهاية
        هذا.مفاتيح = مفاتيح_م
        هذا.قيم = قيم_م
        هذا.أنواع = أنواع_م
    نهاية

    دالة عدد()
        متغير عدد = 0
        لكل م في هذا.مفاتيح
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية

    دالة مسح_الكل()
        هذا.مفاتيح = []
        هذا.قيم = []
        هذا.أنواع = []
    نهاية
نهاية

# --- تشغيل الاختبارات ---
متغير نجاح = 0
متغير فشل = 0

# اختبار 1: إنشاء UserDefaults
متغير تخزين = جديد تخزين_ios("com.sadlang.test")
إذا (تخزين.النطاق == "com.sadlang.test")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: إنشاء UserDefaults")
وإلا
