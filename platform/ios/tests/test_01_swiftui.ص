# =============================================================================
# اختبار iOS 1: مكونات واجهة SwiftUI
# =============================================================================

صنف مكون_swiftui
    باني(نوع، محتوى)
        هذا.النوع = نوع
        هذا.المحتوى = محتوى
        هذا.لون = "أزرق"
        هذا.حجم_خط = 16
        هذا.مبطن = خطأ
        هذا.زاوية = 0
        هذا.الأبناء = []
    نهاية

    دالة عيّن_لون(لون_المكون)
        هذا.لون = لون_المكون
    نهاية

    دالة عيّن_حجم(حجم)
        هذا.حجم_خط = حجم
    نهاية

    دالة اضف_ابن(ابن)
        هذا.الأبناء = هذا.الأبناء + [ابن]
    نهاية

    دالة عدد_الأبناء()
        متغير عدد = 0
        لكل أ في هذا.الأبناء
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية

    دالة بطانة()
        هذا.مبطن = صحيح
    نهاية

    دالة زاوية_دائرية(نصف_قطر)
        هذا.زاوية = نصف_قطر
    نهاية
نهاية

# --- تشغيل الاختبارات ---
متغير نجاح = 0
متغير فشل = 0

# اختبار 1: Text view
متغير نص_عرض = جديد مكون_swiftui("Text"، "مرحباً بالعالم")
إذا (نص_عرض.النوع == "Text" و نص_عرض.المحتوى == "مرحباً بالعالم")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: Text view")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 1: Text")
نهاية

# اختبار 2: Button
متغير زر_ضغط = جديد مكون_swiftui("Button"، "اضغط هنا")
زر_ضغط.عيّن_لون("أخضر")
إذا (زر_ضغط.النوع == "Button" و زر_ضغط.لون == "أخضر")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 2: Button + لون")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 2: Button")
نهاية

# اختبار 3: VStack
متغير عمود = جديد مكون_swiftui("VStack"، "")
عمود.اضف_ابن(نص_عرض)
عمود.اضف_ابن(زر_ضغط)
إذا (عمود.عدد_الأبناء() == 2)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 3: VStack + أبناء")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 3: VStack")
نهاية

# اختبار 4: HStack
متغير صف = جديد مكون_swiftui("HStack"، "")
صف.اضف_ابن(جديد مكون_swiftui("Image"، "star"))
صف.اضف_ابن(جديد مكون_swiftui("Text"، "تقييم"))
صف.اضف_ابن(جديد مكون_swiftui("Spacer"، ""))
إذا (صف.عدد_الأبناء() == 3)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 4: HStack + 3 عناصر")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 4: HStack")
نهاية

# اختبار 5: Modifiers
متغير بطاقة = جديد مكون_swiftui("Card"، "بطاقة معلومات")
بطاقة.بطانة()
بطاقة.زاوية_دائرية(12)
إذا (بطاقة.مبطن == صحيح و بطاقة.زاوية == 12)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 5: Modifiers")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 5: Modifiers")
نهاية

# اختبار 6: حجم الخط
نص_عرض.عيّن_حجم(24)
إذا (نص_عرض.حجم_خط == 24)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 6: حجم الخط")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 6: حجم الخط")
نهاية

# اختبار 7: تداخل مكونات
متغير قائمة = جديد مكون_swiftui("List"، "")
قائمة.اضف_ابن(عمود)
قائمة.اضف_ابن(صف)
إذا (قائمة.عدد_الأبناء() == 2)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 7: تداخل مكونات")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 7: تداخل")
نهاية

# اختبار 8: اللون الافتراضي
متغير مكون_لون = جديد مكون_swiftui("Label"، "عنوان")
إذا (مكون_لون.لون == "أزرق")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 8: لون افتراضي")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 8: لون")
نهاية

# اختبار 9: NavigationView
متغير تنقل = جديد مكون_swiftui("NavigationView"، "")
تنقل.اضف_ابن(قائمة)
إذا (تنقل.النوع == "NavigationView" و تنقل.عدد_الأبناء() == 1)
