تبويبات.اضف_ابن(جديد مكون_swiftui("Tab"، "الرئيسية"))
تبويبات.اضف_ابن(جديد مكون_swiftui("Tab"، "البحث"))
تبويبات.اضف_ابن(جديد مكون_swiftui("Tab"، "الإعدادات"))
إذا (تبويبات.عدد_الأبناء() == 3)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 10: TabView + 3 تبويبات")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 10: TabView")
نهاية

اطبع_سطر("─────────────────────────────")
اطبع_سطر("مكونات SwiftUI: " + نص(نجاح) + "/" + نص(نجاح + فشل))
