#!/bin/bash
# بسم الله الرحمن الرحيم
# Gradle wrapper script for Android build

# Add default JVM options here
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# OS specific support
cygwin=false
case "`uname`" in
  CYGWIN* ) cygwin=true ;;
esac

# Determine the project base directory
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
APP_HOME="$SCRIPT_DIR"

# Use the maximum available, or set MAX_FD != -1 to use that value
MAX_FD="maximum"

# Download and use gradle wrapper
GRADLE_VERSION="8.5"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
GRADLE_WRAPPER_JAR="$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION/gradle-wrapper.jar"

# Check if wrapper jar exists
if [ ! -f "$GRADLE_WRAPPER_JAR" ]; then
    echo "Downloading Gradle $GRADLE_VERSION wrapper..."
    mkdir -p "$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION"
    GRADLE_URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    GRADLE_ZIP="$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION/gradle.zip"
    
    if command -v curl &> /dev/null; then
        curl -L -o "$GRADLE_ZIP" "$GRADLE_URL"
    elif command -v wget &> /dev/null; then
        wget -O "$GRADLE_ZIP" "$GRADLE_URL"
    else
        echo "Error: curl or wget required to download Gradle"
        exit 1
    fi
    
    unzip -q "$GRADLE_ZIP" -d "$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION"
    mv "$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION/gradle-$GRADLE_VERSION" \
       "$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION/gradle"
    rm "$GRADLE_ZIP"
fi

GRADLE_HOME="$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION/gradle"
CLASSPATH="$GRADLE_HOME/lib/gradle-launcher-$GRADLE_VERSION.jar"

# Determine the Java command to use
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS \
    -classpath "$GRADLE_HOME/lib/*" \
    org.gradle.launcher.GradleMain "$@"
