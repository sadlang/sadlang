# اختبار 4: محاكاة الأذونات (Permissions)
# =============================================================================

# --- نظام الأذونات ---

صنف مدير_الأذونات
    باني()
        هذا.أذونات_ممنوحة = []
        هذا.أذونات_مرفوضة = []
        هذا.طلبات = []
    نهاية

    دالة منح(إذن)
        متغير موجود = خطأ
        لكل أ في هذا.أذونات_ممنوحة
            إذا (أ == إذن)
                موجود = صحيح
            نهاية
        نهاية
        إذا (موجود == خطأ)
            هذا.أذونات_ممنوحة = هذا.أذونات_ممنوحة + [إذن]
        نهاية
    نهاية

    دالة رفض(إذن)
        متغير موجود = خطأ
        لكل أ في هذا.أذونات_مرفوضة
            إذا (أ == إذن)
                موجود = صحيح
            نهاية
        نهاية
        إذا (موجود == خطأ)
            هذا.أذونات_مرفوضة = هذا.أذونات_مرفوضة + [إذن]
        نهاية
    نهاية

    دالة تحقق(إذن)
        لكل أ في هذا.أذونات_ممنوحة
            إذا (أ == إذن)
                ارجع صحيح
            نهاية
        نهاية
        ارجع خطأ
    نهاية

    دالة اطلب(إذن)
        هذا.طلبات = هذا.طلبات + [إذن]
        ارجع هذا.تحقق(إذن)
    نهاية

    دالة عدد_الممنوحة()
        متغير عدد = 0
        لكل أ في هذا.أذونات_ممنوحة
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية

    دالة عدد_الطلبات()
        متغير عدد = 0
        لكل ط في هذا.طلبات
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية
نهاية

# --- محاكاة ميزة تحتاج أذونات ---
صنف مدير_الكاميرا
    باني(أذونات)
        هذا.أذونات = أذونات
        هذا.مفتوحة = خطأ
    نهاية

    دالة افتح()
        إذا (هذا.أذونات.تحقق("كاميرا"))
            هذا.مفتوحة = صحيح
            ارجع صحيح
        نهاية
        ارجع خطأ
    نهاية

    دالة التقط()
        إذا (هذا.مفتوحة)
            ارجع "صورة_" + نص(42)
        نهاية
        ارجع ""
    نهاية
نهاية

صنف مدير_الموقع
    باني(أذونات)
        هذا.أذونات = أذونات
    نهاية

    دالة احصل_موقع()
        إذا (هذا.أذونات.تحقق("موقع_دقيق"))
            ارجع "24.7136,46.6753"
        وإلا
            إذا (هذا.أذونات.تحقق("موقع_تقريبي"))
                ارجع "24.7,46.7"
            نهاية
        نهاية
        ارجع ""
    نهاية
نهاية

# --- تشغيل الاختبارات ---
متغير نجاح = 0
متغير فشل = 0

متغير أذونات = جديد مدير_الأذونات()

# اختبار 1: لا أذونات
إذا (أذونات.عدد_الممنوحة() == 0)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: لا أذونات افتراضياً")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 1: لا أذونات افتراضياً")
نهاية

