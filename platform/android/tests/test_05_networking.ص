# --- طلب HTTP ---

صنف طلب_شبكة
    باني(طريقة، رابط)
        هذا.طريقة = طريقة
        هذا.رابط = رابط
        هذا.ترويسات_مفاتيح = []
        هذا.ترويسات_قيم = []
        هذا.جسم = ""
        هذا.مهلة = 30000
    نهاية

    دالة اضف_ترويسة(مفتاح، قيمة_الترويسة)
        هذا.ترويسات_مفاتيح = هذا.ترويسات_مفاتيح + [مفتاح]
        هذا.ترويسات_قيم = هذا.ترويسات_قيم + [قيمة_الترويسة]
    نهاية

    دالة عيّن_جسم(محتوى)
        هذا.جسم = محتوى
    نهاية

    دالة عدد_الترويسات()
        متغير عدد = 0
        لكل ت في هذا.ترويسات_مفاتيح
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية
نهاية

# --- استجابة HTTP ---

صنف استجابة_شبكة
    باني(رمز_الاستجابة، محتوى)
        هذا.رمز = رمز_الاستجابة
        هذا.محتوى = محتوى
        هذا.ناجحة = (رمز_الاستجابة >= 200 و رمز_الاستجابة < 300)
    نهاية
نهاية

# --- عميل HTTP (محاكاة) ---

صنف عميل_شبكة
    باني()
        هذا.طلبات_منفذة = 0
        هذا.آخر_رابط = ""
    نهاية

    دالة نفّذ(طلب)
        هذا.طلبات_منفذة = هذا.طلبات_منفذة + 1
        هذا.آخر_رابط = طلب.رابط

        # محاكاة استجابات حسب الطريقة والرابط
        إذا (طلب.طريقة == "GET")
            ارجع جديد استجابة_شبكة(200، "{\"نجاح\": true}")
        نهاية
        إذا (طلب.طريقة == "POST")
            ارجع جديد استجابة_شبكة(201، "{\"id\": 1}")
        نهاية
        إذا (طلب.طريقة == "PUT")
            ارجع جديد استجابة_شبكة(200، "{\"تم\": true}")
        نهاية
        إذا (طلب.طريقة == "DELETE")
            ارجع جديد استجابة_شبكة(204، "")
        نهاية
        ارجع جديد استجابة_شبكة(405، "")
    نهاية
نهاية

# --- محلل JSON بسيط ---

صنف محلل_بيانات
    باني()
    نهاية

    دالة استخرج_قيمة(نص_البيانات، مفتاح)
        # بحث بسيط عن "مفتاح": قيمة
        متغير بحث = "\"" + مفتاح + "\""
        # محاكاة بسيطة
        إذا (مفتاح == "نجاح" و نص_البيانات == "{\"نجاح\": true}")
            ارجع "true"
        نهاية
        إذا (مفتاح == "id" و نص_البيانات == "{\"id\": 1}")
            ارجع "1"
        نهاية
        إذا (مفتاح == "تم" و نص_البيانات == "{\"تم\": true}")
            ارجع "true"
        نهاية
        ارجع ""
    نهاية
نهاية

