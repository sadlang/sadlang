# --- اختبار مكونات واجهة المستخدم ---

صنف مكون_واجهة
    باني(نوع، نص_العرض)
        هذا.نوع = نوع
        هذا.نص_العرض = نص_العرض
        هذا.مرئي = صحيح
        هذا.مفعل = صحيح
        هذا.عرض = 100
        هذا.ارتفاع = 50
    نهاية

    دالة اخفاء()
        هذا.مرئي = خطأ
    نهاية

    دالة اظهار()
        هذا.مرئي = صحيح
    نهاية

    دالة تعطيل()
        هذا.مفعل = خطأ
    نهاية

    دالة تحجيم(عرض، ارتفاع)
        هذا.عرض = عرض
        هذا.ارتفاع = ارتفاع
    نهاية
نهاية

صنف تخطيط
    باني(نوع_تخطيط)
        هذا.نوع_تخطيط = نوع_تخطيط
        هذا.مكونات = []
        هذا.هامش = 8
    نهاية

    دالة اضف(مكون)
        هذا.مكونات = هذا.مكونات + [مكون]
    نهاية

    دالة عدد_المكونات()
        متغير عداد = 0
        لكل م في هذا.مكونات
            عداد = عداد + 1
        نهاية
        ارجع عداد
    نهاية
نهاية

# --- تشغيل الاختبارات ---
متغير نجاح = 0
متغير فشل = 0

# اختبار 1: إنشاء زر
متغير زر = جديد مكون_واجهة("زر"، "اضغط هنا")
إذا (زر.نوع == "زر" و زر.نص_العرض == "اضغط هنا")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: إنشاء زر")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 1: إنشاء زر")
نهاية

# اختبار 2: إنشاء نص
متغير عنوان = جديد مكون_واجهة("نص"، "مرحباً")
إذا (عنوان.نوع == "نص" و عنوان.مرئي == صحيح)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 2: إنشاء نص")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 2: إنشاء نص")
نهاية

# اختبار 3: إخفاء/إظهار
زر.اخفاء()
إذا (زر.مرئي == خطأ)
    زر.اظهار()
    إذا (زر.مرئي == صحيح)
        نجاح = نجاح + 1
        اطبع_سطر("✅ اختبار 3: إخفاء/إظهار")
    وإلا
        فشل = فشل + 1
        اطبع_سطر("❌ اختبار 3: إخفاء/إظهار")
    نهاية
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 3: إخفاء/إظهار")
نهاية

# اختبار 4: تعطيل مكون
زر.تعطيل()
إذا (زر.مفعل == خطأ)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 4: تعطيل مكون")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 4: تعطيل مكون")
نهاية

# اختبار 5: تغيير الحجم
زر.تحجيم(200، 80)
إذا (زر.عرض == 200 و زر.ارتفاع == 80)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 5: تغيير الحجم")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 5: تغيير الحجم")
نهاية

# اختبار 6: تخطيط عمودي
متغير تخطيط_رئيسي = جديد تخطيط("عمودي")
إذا (تخطيط_رئيسي.نوع_تخطيط == "عمودي")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 6: تخطيط عمودي")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 6: تخطيط عمودي")
نهاية

# اختبار 7: إضافة مكونات للتخطيط
تخطيط_رئيسي.اضف(زر)
تخطيط_رئيسي.اضف(عنوان)
إذا (تخطيط_رئيسي.عدد_المكونات() == 2)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 7: إضافة مكونات")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 7: إضافة مكونات")
نهاية

# اختبار 8: حقل إدخال
متغير حقل = جديد مكون_واجهة("حقل_إدخال"، "")
إذا (حقل.نوع == "حقل_إدخال" و حقل.مفعل == صحيح)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 8: حقل إدخال")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 8: حقل إدخال")
نهاية

# اختبار 9: قائمة مكونات
متغير قائمة_تخطيط = جديد تخطيط("أفقي")
قائمة_تخطيط.اضف(جديد مكون_واجهة("أيقونة"، "🏠"))
قائمة_تخطيط.اضف(جديد مكون_واجهة("أيقونة"، "⚙️"))
قائمة_تخطيط.اضف(جديد مكون_واجهة("أيقونة"، "📱"))
إذا (قائمة_تخطيط.عدد_المكونات() == 3)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 9: قائمة مكونات")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 9: قائمة مكونات")
نهاية

# اختبار 10: الحجم الافتراضي
متغير مكون_افتراضي = جديد مكون_واجهة("فاصل"، "")
إذا (مكون_افتراضي.عرض == 100 و مكون_افتراضي.ارتفاع == 50)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 10: حجم افتراضي")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 10: حجم افتراضي")
نهاية

اطبع_سطر("─────────────────────────────")
اطبع_سطر("واجهة Android أساسية: " + نص(نجاح) + "/" + نص(نجاح + فشل))
