# =============================================================================
# اختبار 3: دورة حياة Activity
# =============================================================================

# --- محاكاة دورة حياة Activity ---

صنف نشاط
    باني(اسم_النشاط)
        هذا.الاسم = اسم_النشاط
        هذا.مراحل = []
        هذا.نشط = خطأ
        هذا.مرئي = خطأ
        هذا.بيانات_محفوظة = []
        هذا.مفاتيح_محفوظة = []
    نهاية

    دالة عند_الإنشاء()
        هذا.مراحل = هذا.مراحل + ["إنشاء"]
    نهاية

    دالة عند_البدء()
        هذا.مرئي = صحيح
        هذا.مراحل = هذا.مراحل + ["بدء"]
    نهاية

    دالة عند_الاستئناف()
        هذا.نشط = صحيح
        هذا.مراحل = هذا.مراحل + ["استئناف"]
    نهاية

    دالة عند_الإيقاف_المؤقت()
        هذا.نشط = خطأ
        هذا.مراحل = هذا.مراحل + ["إيقاف_مؤقت"]
    نهاية

    دالة عند_التوقف()
        هذا.مرئي = خطأ
        هذا.مراحل = هذا.مراحل + ["توقف"]
    نهاية

    دالة عند_التدمير()
        هذا.نشط = خطأ
        هذا.مرئي = خطأ
        هذا.مراحل = هذا.مراحل + ["تدمير"]
    نهاية

    دالة حفظ_البيانات(مفتاح، قيمة_محفوظة)
        هذا.مفاتيح_محفوظة = هذا.مفاتيح_محفوظة + [مفتاح]
        هذا.بيانات_محفوظة = هذا.بيانات_محفوظة + [قيمة_محفوظة]
    نهاية

    دالة استعادة_بيانات(مفتاح)
        متغير ع = 0
        لكل م في هذا.مفاتيح_محفوظة
            إذا (م == مفتاح)
                ارجع هذا.بيانات_محفوظة[ع]
            نهاية
            ع = ع + 1
        نهاية
        ارجع لاشيء
    نهاية

    دالة عدد_المراحل()
        متغير عدد = 0
        لكل م في هذا.مراحل
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية

    دالة آخر_مرحلة()
        متغير آخر = ""
        لكل م في هذا.مراحل
            آخر = م
        نهاية
        ارجع آخر
    نهاية
نهاية

# --- مدير التنقل ---
صنف مدير_التنقل
    باني()
        هذا.المكدس = []
    نهاية

    دالة انتقل(نشاط_هدف)
        هذا.المكدس = هذا.المكدس + [نشاط_هدف]
    نهاية

    دالة عدد_الأنشطة()
        متغير عدد = 0
        لكل ن في هذا.المكدس
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية
نهاية

# --- تشغيل الاختبارات ---
متغير نجاح = 0
متغير فشل = 0

# اختبار 1: إنشاء نشاط
متغير نشاط_رئيسي = جديد نشاط("الرئيسية")
إذا (نشاط_رئيسي.الاسم == "الرئيسية")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: إنشاء نشاط")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 1: إنشاء نشاط")
نهاية

# اختبار 2: دورة حياة كاملة - onCreate
نشاط_رئيسي.عند_الإنشاء()
إذا (نشاط_رئيسي.آخر_مرحلة() == "إنشاء")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 2: onCreate")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 2: onCreate")
نهاية

# اختبار 3: onStart
نشاط_رئيسي.عند_البدء()
إذا (نشاط_رئيسي.مرئي == صحيح)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 3: onStart — مرئي")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 3: onStart — مرئي")
نهاية

# اختبار 4: onResume
نشاط_رئيسي.عند_الاستئناف()
إذا (نشاط_رئيسي.نشط == صحيح)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 4: onResume — نشط")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 4: onResume — نشط")
نهاية

# اختبار 5: onPause
نشاط_رئيسي.عند_الإيقاف_المؤقت()
إذا (نشاط_رئيسي.نشط == خطأ)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 5: onPause — غير نشط")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 5: onPause — غير نشط")
نهاية

# اختبار 6: onStop
نشاط_رئيسي.عند_التوقف()
إذا (نشاط_رئيسي.مرئي == خطأ)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 6: onStop — غير مرئي")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 6: onStop — غير مرئي")
نهاية

# اختبار 7: تسلسل المراحل
إذا (نشاط_رئيسي.عدد_المراحل() == 5)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 7: تسلسل 5 مراحل")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 7: تسلسل — توقع 5 حصل " + نص(نشاط_رئيسي.عدد_المراحل()))
نهاية

# اختبار 8: حفظ واستعادة البيانات (onSaveInstanceState)
نشاط_رئيسي.حفظ_البيانات("موقع_التمرير"، "150")
إذا (نشاط_رئيسي.استعادة_بيانات("موقع_التمرير") == "150")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 8: حفظ واستعادة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 8: حفظ واستعادة")
نهاية

# اختبار 9: onDestroy
نشاط_رئيسي.عند_التدمير()
إذا (نشاط_رئيسي.آخر_مرحلة() == "تدمير")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 9: onDestroy")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 9: onDestroy")
نهاية

# اختبار 10: مدير التنقل
متغير تنقل = جديد مدير_التنقل()
تنقل.انتقل(جديد نشاط("إعدادات"))
تنقل.انتقل(جديد نشاط("ملف_شخصي"))
إذا (تنقل.عدد_الأنشطة() == 2)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 10: مدير التنقل")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 10: مدير التنقل")
نهاية

اطبع_سطر("─────────────────────────────")
اطبع_سطر("دورة حياة Activity: " + نص(نجاح) + "/" + نص(نجاح + فشل))
