# =============================================================================
# اختبار 2: تخزين البيانات (SharedPreferences Pattern)
# =============================================================================

# --- محاكاة SharedPreferences ---

صنف تخزين_محلي
    باني(اسم_المخزن)
        هذا.اسم = اسم_المخزن
        هذا.بيانات_نصية = []
        هذا.مفاتيح_نصية = []
        هذا.بيانات_رقمية = []
        هذا.مفاتيح_رقمية = []
        هذا.بيانات_منطقية = []
        هذا.مفاتيح_منطقية = []
    نهاية

    دالة احفظ_نص(مفتاح، قيمة_نصية)
        متغير موجود = -1
        متغير ع = 0
        لكل م في هذا.مفاتيح_نصية
            إذا (م == مفتاح)
                موجود = ع
            نهاية
            ع = ع + 1
        نهاية
        إذا (موجود >= 0)
            هذا.بيانات_نصية[موجود] = قيمة_نصية
        وإلا
            هذا.مفاتيح_نصية = هذا.مفاتيح_نصية + [مفتاح]
            هذا.بيانات_نصية = هذا.بيانات_نصية + [قيمة_نصية]
        نهاية
    نهاية

    دالة اقرأ_نص(مفتاح، افتراضي)
        متغير ع = 0
        لكل م في هذا.مفاتيح_نصية
            إذا (م == مفتاح)
                ارجع هذا.بيانات_نصية[ع]
            نهاية
            ع = ع + 1
        نهاية
        ارجع افتراضي
    نهاية

    دالة احفظ_رقم(مفتاح، قيمة_رقمية)
        متغير موجود = -1
        متغير ع = 0
        لكل م في هذا.مفاتيح_رقمية
            إذا (م == مفتاح)
                موجود = ع
            نهاية
            ع = ع + 1
        نهاية
        إذا (موجود >= 0)
            هذا.بيانات_رقمية[موجود] = قيمة_رقمية
        وإلا
            هذا.مفاتيح_رقمية = هذا.مفاتيح_رقمية + [مفتاح]
            هذا.بيانات_رقمية = هذا.بيانات_رقمية + [قيمة_رقمية]
        نهاية
    نهاية

    دالة اقرأ_رقم(مفتاح، افتراضي)
        متغير ع = 0
        لكل م في هذا.مفاتيح_رقمية
            إذا (م == مفتاح)
                ارجع هذا.بيانات_رقمية[ع]
            نهاية
            ع = ع + 1
        نهاية
        ارجع افتراضي
    نهاية

    دالة احفظ_منطقي(مفتاح، قيمة_منطقية)
        متغير موجود = -1
        متغير ع = 0
        لكل م في هذا.مفاتيح_منطقية
            إذا (م == مفتاح)
                موجود = ع
            نهاية
            ع = ع + 1
        نهاية
        إذا (موجود >= 0)
            هذا.بيانات_منطقية[موجود] = قيمة_منطقية
        وإلا
            هذا.مفاتيح_منطقية = هذا.مفاتيح_منطقية + [مفتاح]
            هذا.بيانات_منطقية = هذا.بيانات_منطقية + [قيمة_منطقية]
        نهاية
    نهاية

    دالة اقرأ_منطقي(مفتاح، افتراضي)
        متغير ع = 0
        لكل م في هذا.مفاتيح_منطقية
            إذا (م == مفتاح)
                ارجع هذا.بيانات_منطقية[ع]
            نهاية
            ع = ع + 1
        نهاية
        ارجع افتراضي
    نهاية

    دالة مسح_الكل()
        هذا.بيانات_نصية = []
        هذا.مفاتيح_نصية = []
        هذا.بيانات_رقمية = []
        هذا.مفاتيح_رقمية = []
        هذا.بيانات_منطقية = []
        هذا.مفاتيح_منطقية = []
    نهاية

    دالة عدد_المفاتيح()
        متغير عدد = 0
        لكل م في هذا.مفاتيح_نصية
            عدد = عدد + 1
        نهاية
        لكل م في هذا.مفاتيح_رقمية
            عدد = عدد + 1
        نهاية
        لكل م في هذا.مفاتيح_منطقية
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية
نهاية

# --- تشغيل الاختبارات ---
متغير نجاح = 0
متغير فشل = 0

# اختبار 1: إنشاء مخزن
متغير مخزن = جديد تخزين_محلي("إعدادات_التطبيق")
إذا (مخزن.اسم == "إعدادات_التطبيق")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 1: إنشاء مخزن")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 1: إنشاء مخزن")
نهاية

# اختبار 2: حفظ نص
مخزن.احفظ_نص("اسم_المستخدم"، "أحمد")
إذا (مخزن.اقرأ_نص("اسم_المستخدم"، "") == "أحمد")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 2: حفظ نص")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 2: حفظ نص")
نهاية

# اختبار 3: حفظ رقم
مخزن.احفظ_رقم("عمر_المستخدم"، 25)
إذا (مخزن.اقرأ_رقم("عمر_المستخدم"، 0) == 25)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 3: حفظ رقم")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 3: حفظ رقم")
نهاية

# اختبار 4: حفظ منطقي
مخزن.احفظ_منطقي("الوضع_الداكن"، صحيح)
إذا (مخزن.اقرأ_منطقي("الوضع_الداكن"، خطأ) == صحيح)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 4: حفظ منطقي")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 4: حفظ منطقي")
نهاية

# اختبار 5: قيمة افتراضية
إذا (مخزن.اقرأ_نص("غير_موجود"، "مجهول") == "مجهول")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 5: قيمة افتراضية نص")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 5: قيمة افتراضية نص")
نهاية

# اختبار 6: قيمة افتراضية رقم
إذا (مخزن.اقرأ_رقم("غير_موجود"، 99) == 99)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 6: قيمة افتراضية رقم")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 6: قيمة افتراضية رقم")
نهاية

# اختبار 7: تحديث قيمة موجودة
مخزن.احفظ_نص("اسم_المستخدم"، "محمد")
إذا (مخزن.اقرأ_نص("اسم_المستخدم"، "") == "محمد")
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 7: تحديث قيمة")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 7: تحديث قيمة")
نهاية

# اختبار 8: عدد المفاتيح
إذا (مخزن.عدد_المفاتيح() == 3)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 8: عدد المفاتيح")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 8: عدد المفاتيح — توقع 3 حصل " + نص(مخزن.عدد_المفاتيح()))
نهاية

# اختبار 9: مخزن مستقل
متغير مخزن2 = جديد تخزين_محلي("مخزن_ثاني")
مخزن2.احفظ_نص("بيانات"، "قيمة")
إذا (مخزن2.عدد_المفاتيح() == 1 و مخزن.عدد_المفاتيح() == 3)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 9: مخزن مستقل")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 9: مخزن مستقل")
نهاية

# اختبار 10: مسح الكل
مخزن.مسح_الكل()
إذا (مخزن.عدد_المفاتيح() == 0)
    نجاح = نجاح + 1
    اطبع_سطر("✅ اختبار 10: مسح الكل")
وإلا
    فشل = فشل + 1
    اطبع_سطر("❌ اختبار 10: مسح الكل")
نهاية

اطبع_سطر("─────────────────────────────")
اطبع_سطر("تخزين البيانات: " + نص(نجاح) + "/" + نص(نجاح + فشل))
