            متغير طفل = م.معالج_داخلي()
            اطبع("  بعد: ن=" + م.ن + " طفل=" + طفل)
            نتيجة = نتيجة + طفل
        نهاية
        اطبع("انتهى تشغيل: ن=" + م.ن + " نتيجة=" + نتيجة)
        ارجع نتيجة
    نهاية
