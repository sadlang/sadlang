    رقم ن

    باني(رقم ابتداء)
        هذا.ن = ابتداء
    نهاية

    دالة معالج_داخلي()
        متغير م = هذا
        م.ن = م.ن + 1
        ارجع "د"
    نهاية

    دالة تشغيل()
        متغير م = هذا
        متغير نتيجة = ""
        اطبع("تشغيل: ن=" + م.ن)
        بينما (م.ن < 3)
