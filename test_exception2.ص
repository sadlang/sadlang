#**
 * @وصف تحقق — [دالة تحقق]
 *
 * @معامل ن — [رقم]
 *
 * @مثال
 *   تحقق(...)
 **#
دالة تحقق(ن)
    إذا (ن < 0)
        ارمي "رقم سالب"
    نهاية
    ارجع ن * 2
نهاية

حاول
    ثابت أ = تحقق(5)
    اطبع("تحقق(5)=" + أ)
    ثابت ب = تحقق(-3)
    اطبع("لن يصل " + ب)
امسك (م)
    اطبع("خطأ: " + م)
نهاية

