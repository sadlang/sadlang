## اختبار: standalone function تقرأ field من object مُمرر بالوسيط

صنف محرك_م
    متغير الشجرة

    باني(شجرة_ع)
        هذا.الشجرة = شجرة_ع
    نهاية
نهاية

دالة م_ابحث_من_م(شجرة_م2، نص نص_م)
    ## تنشئ جديد
    متغير حالة = جديد محرك_م(شجرة_م2)
    ارجع حالة
نهاية

دالة م_بحث_م(المحرك_م، نص ن)
    ## تقرأ field من object مُمرر
    متغير حالة_م = م_ابحث_من_م(المحرك_م.الشجرة، ن)
    إذا (حالة_م == لاشيء)
        ارجع لاشيء
    نهاية
    ارجع حالة_م.الشجرة
نهاية

صنف داخلي_م
    رقم ق

    باني(رقم قيمة)
        هذا.ق = قيمة
    نهاية
نهاية

صنف تعبير_م
    نص النمط_م
    متغير المحرك

    باني(نص نمط)
        هذا.النمط_م = نمط
        متغير أ = جديد داخلي_م(77)
        متغير محرك_للداخل = جديد محرك_م(أ)
        هذا.المحرك = محرك_للداخل
    نهاية

    دالة ابحث(نص ن)
        ارجع م_بحث_م(هذا.المحرك، ن)
    نهاية
نهاية

دالة بحث_م(نص نمط، نص النص)
    متغير تع = جديد تعبير_م(نمط)
    ارجع تع.ابحث(النص)
نهاية

متغير ن = بحث_م("نمط", "نص")
اطبع("ن = ")
اطبع_سطر(ن)
إذا (ن != لاشيء)
    اطبع("ن.ق = ")
    اطبع_سطر(ن.ق)
نهاية
