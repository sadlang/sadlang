# اختبار أصناف الاستثناء المخصصة

# تعريف صنف الاستثناء الأساسي
صنف استثناء
    باني(رسالة)
        هذا.رسالة = رسالة
    نهاية
نهاية

# تعريف صنف خطأ حسابي يرث من استثناء
صنف خطأ_حسابي يرث استثناء
    باني(رسالة)
        الأساس(رسالة)
    نهاية
نهاية

# تعريف صنف خطأ قسمة يرث من خطأ_حسابي
صنف خطأ_قسمة يرث خطأ_حسابي
    باني(رسالة)
        الأساس(رسالة)
    نهاية
نهاية

# تعريف صنف خطأ شبكة (لا يرث من خطأ_حسابي)
صنف خطأ_شبكة يرث استثناء
    باني(رسالة)
        الأساس(رسالة)
    نهاية
نهاية

