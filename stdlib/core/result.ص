/**
 * @ملف result.sad
 * @وصف نوع نتيجة<ن،خ> - يُمثِّل عملية قد تنجح أو تفشل
 * @المؤلف فريق لغة ص
 * @التاريخ يناير 2026
 * @الإصدار 1.0
 * @المرحلة المرحلة 4: US2 - أمان الذاكرة
 * 
 * =============================================================================
 *                         نوع النتيجة في لغة ص
 *                         Result Type in Sad Language
 * =============================================================================
 * 
 *     النوع `نتيجة<ن،خ>` يُمثِّل نتيجة عملية قد:
 *     
 *     • `نجاح(قيمة)` - العملية نجحت وأرجعت قيمة
 *     • `فشل(خطأ)` - العملية فشلت مع سبب الفشل
 *     
 *     هذا النوع يُغني عن استخدام الاستثناءات ويجعل
 *     معالجة الأخطاء صريحة وآمنة.
 * 
 * =============================================================================
 *                              أمثلة الاستخدام
 * =============================================================================
 * 
 *     // دالة تُرجع نتيجة
 *     دالة قسمة(أ: عدد، ب: عدد) -> نتيجة<عدد، نص> {
 *         إذا ب == 0 {
 *             أرجع فشل("لا يمكن القسمة على صفر")
 *         }
 *         أرجع نجاح(أ / ب)
 *     }
 *     
 *     // معالجة النتيجة
 *     تطابق قسمة(10، 2) {
 *         نجاح(ق) => اطبع("الناتج: " + ق),
 *         فشل(خ) => اطبع("خطأ: " + خ)
 *     }
 *     
 *     // التسلسل مع ?
 *     دالة حساب_معقد() -> نتيجة<عدد، نص> {
 *         دع أ = قسمة(100، 5)?    // ينشر الفشل تلقائياً
 *         دع ب = قسمة(أ، 2)?
 *         أرجع نجاح(ب)
 *     }
 */

// =============================================================================
//                         تعريف النوع / Type Definition
// =============================================================================

/**
 * @نوع نتيجة<ن،خ>
 * @وصف نوع يُمثِّل نتيجة عملية قد تنجح أو تفشل
 * @نوع_عام ن: نوع القيمة عند النجاح
 * @نوع_عام خ: نوع الخطأ عند الفشل
 * 
 *     هذا النوع معدد (enum) بحالتين:
 *     - `نجاح(ن)` : العملية نجحت مع قيمة
 *     - `فشل(خ)` : العملية فشلت مع خطأ
 */
علني نوع_معدد نتيجة<ن، خ> {
    /// العملية نجحت مع قيمة
    نجاح(ن),
    
    /// العملية فشلت مع خطأ
    فشل(خ)
}

// =============================================================================
//                         الدوال الأساسية / Basic Methods
// =============================================================================

تنفيذ<ن، خ> نتيجة<ن، خ> {
    
    // =========================================================================
    //                         الإنشاء / Creation
    // =========================================================================
    
    /**
     * @دالة من_نجاح
     * @وصف إنشاء نتيجة ناجحة
     * @معامل قيمة: قيمة النجاح
     * @إرجاع نتيجة ناجحة
     * 
     *     مثال:
     *         دع ن = نتيجة.من_نجاح(42)
     *         // ن = نجاح(42)
     */
    علني ثابتة دالة من_نجاح(قيمة: ن) -> نتيجة<ن، خ> {
        أرجع نجاح(قيمة)
    }
    
    /**
     * @دالة من_فشل
     * @وصف إنشاء نتيجة فاشلة
     * @معامل خطأ: سبب الفشل
     * @إرجاع نتيجة فاشلة
     * 
     *     مثال:
     *         دع ن: نتيجة<عدد، نص> = نتيجة.من_فشل("خطأ!")
     *         // ن = فشل("خطأ!")
     */
    علني ثابتة دالة من_فشل(خطأ: خ) -> نتيجة<ن، خ> {
        أرجع فشل(خطأ)
    }
    
    // =========================================================================
    //                         التحقق / Checking
    // =========================================================================
    
    /**
     * @دالة ناجح
     * @وصف التحقق من نجاح العملية
     * @إرجاع صحيح إذا كانت النتيجة نجاح
     * 
     *     مثال:
     *         دع ن = نجاح(10)
     *         إذا ن.ناجح() {
     *             اطبع("العملية نجحت!")
     *         }
     */
    علني دالة ناجح(&ذاتي) -> منطقي {
        تطابق ذاتي {
            نجاح(_) => صحيح,
            فشل(_) => خطأ
        }
    }
    
    /**
     * @دالة فاشل
     * @وصف التحقق من فشل العملية
     * @إرجاع صحيح إذا كانت النتيجة فشل
     * 
     *     مثال:
     *         دع ن: نتيجة<عدد، نص> = فشل("خطأ")
     *         إذا ن.فاشل() {
     *             اطبع("العملية فشلت")
     *         }
     */
    علني دالة فاشل(&ذاتي) -> منطقي {
        !ذاتي.ناجح()
    }
    
    // =========================================================================
    //                         الوصول للقيمة / Value Access
    // =========================================================================
    
    /**
     * @دالة افتح
     * @وصف الحصول على القيمة (يُذعر إذا فشل)
     * @إرجاع قيمة النجاح
     * @ذعر إذا كانت النتيجة فشل
     * 
     *     تحذير: هذه الدالة تُذعر إذا كانت النتيجة فشل!
     *     استخدم `ناجح()` للتحقق أولاً أو استخدم `أو_()` للأمان.
     * 
     *     مثال:
     *         دع ن = نجاح(42)
     *         دع ق = ن.افتح()  // ق = 42
     */
    علني دالة افتح(ذاتي) -> ن {
        تطابق ذاتي {
            نجاح(قيمة) => قيمة,
            فشل(_) => أذعر!("محاولة فتح نتيجة فاشلة!")
        }
    }
    
    /**
     * @دالة افتح_خطأ
     * @وصف الحصول على الخطأ (يُذعر إذا نجح)
     * @إرجاع قيمة الخطأ
     * @ذعر إذا كانت النتيجة نجاح
     * 
     *     مثال:
     *         دع ن: نتيجة<عدد، نص> = فشل("خطأ")
     *         دع خ = ن.افتح_خطأ()  // خ = "خطأ"
     */
    علني دالة افتح_خطأ(ذاتي) -> خ {
        تطابق ذاتي {
            نجاح(_) => أذعر!("محاولة فتح خطأ من نتيجة ناجحة!"),
            فشل(خطأ) => خطأ
        }
    }
    
    /**
     * @دالة افتح_أو
     * @وصف الحصول على القيمة أو قيمة افتراضية
     * @معامل افتراضي: القيمة الافتراضية عند الفشل
     * @إرجاع قيمة النجاح أو الافتراضية
     * 
     *     مثال:
     *         دع ن: نتيجة<عدد، نص> = فشل("خطأ")
     *         دع ق = ن.افتح_أو(0)  // ق = 0
     */
    علني دالة افتح_أو(ذاتي، افتراضي: ن) -> ن {
        تطابق ذاتي {
            نجاح(قيمة) => قيمة,
            فشل(_) => افتراضي
        }
    }
    
    /**
     * @دالة افتح_أو_نفذ
     * @وصف الحصول على القيمة أو تنفيذ دالة للقيمة الافتراضية
     * @معامل د: دالة تستقبل الخطأ وتُرجع قيمة افتراضية
     * @إرجاع قيمة النجاح أو نتيجة الدالة
     * 
     *     مثال:
     *         دع ن: نتيجة<عدد، نص> = فشل("خطأ")
     *         دع ق = ن.افتح_أو_نفذ(|خ| {
     *             اطبع("حدث خطأ: " + خ)
     *             أرجع -1
     *         })
     */
    علني دالة افتح_أو_نفذ<د: دالة(خ) -> ن>(ذاتي، د: د) -> ن {
        تطابق ذاتي {
            نجاح(قيمة) => قيمة,
            فشل(خطأ) => د(خطأ)
        }
    }
    
    /**
     * @دالة أو_
     * @وصف اختصار لـ افتح_أو
     */
    علني دالة أو_(ذاتي، افتراضي: ن) -> ن {
        ذاتي.افتح_أو(افتراضي)
    }
    
    // =========================================================================
    //                         التحويل / Transformation
    // =========================================================================
    
    /**
     * @دالة حول
     * @وصف تحويل قيمة النجاح باستخدام دالة (map)
     * @معامل د: دالة التحويل
     * @إرجاع نتيجة بالقيمة المحولة أو نفس الفشل
     * 
     *     مثال:
     *         دع ن = نجاح(5)
     *         دع م = ن.حول(|ق| ق * 2)  // م = نجاح(10)
     *         
     *         دع ف: نتيجة<عدد، نص> = فشل("خطأ")
     *         دع م2 = ف.حول(|ق| ق * 2)  // م2 = فشل("خطأ")
     */
    علني دالة حول<م، د: دالة(ن) -> م>(ذاتي، د: د) -> نتيجة<م، خ> {
        تطابق ذاتي {
            نجاح(قيمة) => نجاح(د(قيمة)),
            فشل(خطأ) => فشل(خطأ)
        }
    }
    
    /**
     * @دالة حول_خطأ
     * @وصف تحويل قيمة الخطأ باستخدام دالة (map_err)
     * @معامل د: دالة تحويل الخطأ
     * @إرجاع نتيجة بنفس النجاح أو الخطأ المحول
     * 
     *     مثال:
     *         دع ن: نتيجة<عدد، عدد> = فشل(404)
     *         دع م = ن.حول_خطأ(|ك| "خطأ رقم " + ك)
     *         // م = فشل("خطأ رقم 404")
     */
    علني دالة حول_خطأ<خ2، د: دالة(خ) -> خ2>(ذاتي، د: د) -> نتيجة<ن، خ2> {
        تطابق ذاتي {
            نجاح(قيمة) => نجاح(قيمة),
            فشل(خطأ) => فشل(د(خطأ))
        }
    }
    
    /**
     * @دالة ثم
     * @وصف تسلسل العمليات (and_then / flatMap)
     * @معامل د: دالة تُرجع نتيجة
     * @إرجاع نتيجة الدالة أو نفس الفشل
     * 
     *     مثال:
     *         دالة ضرب_آمن(أ: عدد) -> نتيجة<عدد، نص> {
     *             إذا أ > 1000 { أرجع فشل("العدد كبير جداً") }
     *             أرجع نجاح(أ * 2)
     *         }
     *         
     *         دع نتيجة = نجاح(10).ثم(ضرب_آمن)
     *         // نتيجة = نجاح(20)
     */
    علني دالة ثم<م، د: دالة(ن) -> نتيجة<م، خ>>(ذاتي، د: د) -> نتيجة<م، خ> {
        تطابق ذاتي {
            نجاح(قيمة) => د(قيمة),
            فشل(خطأ) => فشل(خطأ)
        }
    }
    
    /**
     * @دالة أو_جرب
     * @وصف إرجاع ذاتي إذا نجح، وإلا جرب البديل
     * @معامل د: دالة تُرجع نتيجة بديلة
     * @إرجاع ذاتي أو نتيجة الدالة
     * 
     *     مثال:
     *         دالة من_ذاكرة() -> نتيجة<بيانات، نص> { ... }
     *         دالة من_قرص() -> نتيجة<بيانات، نص> { ... }
     *         
     *         دع بيانات = من_ذاكرة().أو_جرب(من_قرص)
     */
    علني دالة أو_جرب<د: دالة(خ) -> نتيجة<ن، خ>>(ذاتي، د: د) -> نتيجة<ن، خ> {
        تطابق ذاتي {
            نجاح(_) => ذاتي,
            فشل(خطأ) => د(خطأ)
        }
    }
    
    // =========================================================================
    //                         التحويل لأنواع أخرى / Conversion
    // =========================================================================
    
    /**
     * @دالة نجاح_إلى_اختياري
     * @وصف تحويل النتيجة إلى اختياري (يتجاهل الخطأ)
     * @إرجاع بعض(قيمة) أو لاشيء
     * 
     *     مثال:
     *         دع ن = نجاح(42)
     *         دع خ = ن.نجاح_إلى_اختياري()  // خ = بعض(42)
     *         
     *         دع ف: نتيجة<عدد، نص> = فشل("خطأ")
     *         دع خ2 = ف.نجاح_إلى_اختياري()  // خ2 = لاشيء
     */
    علني دالة نجاح_إلى_اختياري(ذاتي) -> اختياري<ن> {
        تطابق ذاتي {
            نجاح(قيمة) => بعض(قيمة),
            فشل(_) => لاشيء
        }
    }
    
    /**
     * @دالة خطأ_إلى_اختياري
     * @وصف تحويل الخطأ إلى اختياري (يتجاهل النجاح)
     * @إرجاع بعض(خطأ) أو لاشيء
     * 
     *     مثال:
     *         دع ف: نتيجة<عدد، نص> = فشل("خطأ")
     *         دع خ = ف.خطأ_إلى_اختياري()  // خ = بعض("خطأ")
     */
    علني دالة خطأ_إلى_اختياري(ذاتي) -> اختياري<خ> {
        تطابق ذاتي {
            نجاح(_) => لاشيء,
            فشل(خطأ) => بعض(خطأ)
        }
    }
    
    /**
     * @دالة اقلب
     * @وصف قلب النتيجة (النجاح يصبح فشل والعكس)
     * @إرجاع نتيجة مقلوبة
     * 
     *     مثال:
     *         دع ن = نجاح(42)
     *         دع م = ن.اقلب()  // م: نتيجة<نص، عدد> = فشل(42)
     */
    علني دالة اقلب(ذاتي) -> نتيجة<خ، ن> {
        تطابق ذاتي {
            نجاح(قيمة) => فشل(قيمة),
            فشل(خطأ) => نجاح(خطأ)
        }
    }
    
    // =========================================================================
    //                         التكرار / Iteration
    // =========================================================================
    
    /**
     * @دالة لكل
     * @وصف تنفيذ دالة على القيمة إذا نجحت
     * @معامل د: الدالة للتنفيذ
     * 
     *     مثال:
     *         نجاح(42).لكل(|ق| اطبع("القيمة: " + ق))
     *         // يطبع: القيمة: 42
     */
    علني دالة لكل<د: دالة(ن)>(ذاتي، د: د) {
        تطابق ذاتي {
            نجاح(قيمة) => د(قيمة),
            فشل(_) => {}
        }
    }
    
    /**
     * @دالة لكل_خطأ
     * @وصف تنفيذ دالة على الخطأ إذا فشل
     * @معامل د: الدالة للتنفيذ
     * 
     *     مثال:
     *         فشل("خطأ").لكل_خطأ(|خ| اطبع("حدث: " + خ))
     *         // يطبع: حدث: خطأ
     */
    علني دالة لكل_خطأ<د: دالة(خ)>(ذاتي، د: د) {
        تطابق ذاتي {
            نجاح(_) => {},
            فشل(خطأ) => د(خطأ)
        }
    }
    
    // =========================================================================
    //                         المعالجة / Handling
    // =========================================================================
    
    /**
     * @دالة عالج
     * @وصف معالجة كلتا الحالتين بدالتين منفصلتين
     * @معامل عند_نجاح: دالة للنجاح
     * @معامل عند_فشل: دالة للفشل
     * @إرجاع نتيجة المعالجة
     * 
     *     مثال:
     *         دع نتيجة = قسمة(10، 2).عالج(
     *             |ق| "الناتج: " + ق,
     *             |خ| "خطأ: " + خ
     *         )
     */
    علني دالة عالج<ر، دن: دالة(ن) -> ر، دخ: دالة(خ) -> ر>(
        ذاتي،
        عند_نجاح: دن،
        عند_فشل: دخ
    ) -> ر {
        تطابق ذاتي {
            نجاح(قيمة) => عند_نجاح(قيمة),
            فشل(خطأ) => عند_فشل(خطأ)
        }
    }
    
    /**
     * @دالة توقع
     * @وصف افتح مع رسالة خطأ مخصصة
     * @معامل رسالة: رسالة الخطأ عند الفشل
     * @إرجاع قيمة النجاح
     * @ذعر مع الرسالة إذا فشل
     * 
     *     مثال:
     *         دع ق = نجاح(42).توقع("يجب أن تنجح!")
     */
    علني دالة توقع(ذاتي، رسالة: نص) -> ن {
        تطابق ذاتي {
            نجاح(قيمة) => قيمة,
            فشل(_) => أذعر!(رسالة)
        }
    }
    
    /**
     * @دالة توقع_خطأ
     * @وصف افتح_خطأ مع رسالة خطأ مخصصة
     * @معامل رسالة: رسالة الخطأ عند النجاح
     * @إرجاع قيمة الخطأ
     * @ذعر مع الرسالة إذا نجح
     */
    علني دالة توقع_خطأ(ذاتي، رسالة: نص) -> خ {
        تطابق ذاتي {
            نجاح(_) => أذعر!(رسالة),
            فشل(خطأ) => خطأ
        }
    }
}

// =============================================================================
//                         تنفيذ السمات / Trait Implementations
// =============================================================================

/**
 * سمة المقارنة للنتيجة
 */
تنفيذ<ن: مقارنة، خ: مقارنة> مقارنة لـ نتيجة<ن، خ> {
    دالة يساوي(&ذاتي، آخر: &نتيجة<ن، خ>) -> منطقي {
        تطابق (ذاتي، آخر) {
            (نجاح(أ)، نجاح(ب)) => أ.يساوي(ب),
            (فشل(أ)، فشل(ب)) => أ.يساوي(ب),
            _ => خطأ
        }
    }
}

/**
 * سمة النسخ للنتيجة
 */
تنفيذ<ن: نسخ، خ: نسخ> نسخ لـ نتيجة<ن، خ> {
    دالة انسخ(&ذاتي) -> ذاتي {
        تطابق ذاتي {
            نجاح(قيمة) => نجاح(قيمة.انسخ()),
            فشل(خطأ) => فشل(خطأ.انسخ())
        }
    }
}

/**
 * سمة الاستنساخ للنتيجة
 */
تنفيذ<ن: استنساخ، خ: استنساخ> استنساخ لـ نتيجة<ن، خ> {
    دالة استنسخ(&ذاتي) -> ذاتي {
        تطابق ذاتي {
            نجاح(قيمة) => نجاح(قيمة.استنسخ()),
            فشل(خطأ) => فشل(خطأ.استنسخ())
        }
    }
}

/**
 * سمة التنقيح للنتيجة
 */
تنفيذ<ن: تنقيح، خ: تنقيح> تنقيح لـ نتيجة<ن، خ> {
    دالة صيغة_تنقيح(&ذاتي) -> نص {
        تطابق ذاتي {
            نجاح(قيمة) => "نجاح(" + قيمة.صيغة_تنقيح() + ")",
            فشل(خطأ) => "فشل(" + خطأ.صيغة_تنقيح() + ")"
        }
    }
}

/**
 * سمة العرض للنتيجة
 */
تنفيذ<ن: عرض، خ: عرض> عرض لـ نتيجة<ن، خ> {
    دالة صيغة(&ذاتي) -> نص {
        تطابق ذاتي {
            نجاح(قيمة) => قيمة.صيغة(),
            فشل(خطأ) => "خطأ: " + خطأ.صيغة()
        }
    }
}

// =============================================================================
//                         الدوال المساعدة / Helper Functions
// =============================================================================

/**
 * @دالة نجاح
 * @وصف إنشاء نتيجة ناجحة (اختصار)
 * @معامل قيمة: القيمة
 * @إرجاع نتيجة ناجحة
 * 
 *     مثال:
 *         دع ن = نجاح(42)
 */
علني دالة نجاح<ن، خ>(قيمة: ن) -> نتيجة<ن، خ> {
    نتيجة::نجاح(قيمة)
}

/**
 * @دالة فشل
 * @وصف إنشاء نتيجة فاشلة (اختصار)
 * @معامل خطأ: سبب الفشل
 * @إرجاع نتيجة فاشلة
 * 
 *     مثال:
 *         دع ن: نتيجة<عدد، نص> = فشل("خطأ")
 */
علني دالة فشل<ن، خ>(خطأ: خ) -> نتيجة<ن، خ> {
    نتيجة::فشل(خطأ)
}

// =============================================================================
//                         أنواع الأخطاء الشائعة / Common Error Types
// =============================================================================

/**
 * @نوع خطأ_عام
 * @وصف نوع خطأ عام للاستخدام البسيط
 */
علني هيكل خطأ_عام {
    /// رسالة الخطأ
    علني رسالة: نص,
    
    /// رمز الخطأ (اختياري)
    علني رمز: اختياري<عدد>
}

تنفيذ خطأ_عام {
    /**
     * @دالة جديد
     * @وصف إنشاء خطأ عام جديد
     */
    علني ثابتة دالة جديد(رسالة: نص) -> خطأ_عام {
        خطأ_عام {
            رسالة: رسالة,
            رمز: لاشيء
        }
    }
    
    /**
     * @دالة مع_رمز
     * @وصف إنشاء خطأ عام مع رمز
     */
    علني ثابتة دالة مع_رمز(رسالة: نص، رمز: عدد) -> خطأ_عام {
        خطأ_عام {
            رسالة: رسالة,
            رمز: بعض(رمز)
        }
    }
}

تنفيذ عرض لـ خطأ_عام {
    دالة صيغة(&ذاتي) -> نص {
        تطابق ذاتي.رمز {
            بعض(ر) => "[" + ر + "] " + ذاتي.رسالة,
            لاشيء => ذاتي.رسالة
        }
    }
}

