/**
 * =============================================================================
 * ملف: مولد_عشوائي.ص
 * الوصف: مولد قيم عشوائية لاختبار الخصائص
 * المهمة: T245 - Random value generator
 * المرحلة: Phase 25 - User Story 22 (Property Testing)
 * =============================================================================
 * 
 * 🎲 دليل المبتدئ للتوليد العشوائي
 * ═════════════════════════════════
 * 
 * ما هو المولد العشوائي؟
 * ───────────────────────
 * يُنتج قيم "عشوائية" لاستخدامها في الاختبارات.
 * 
 * لماذا "عشوائية" بين علامتي تنصيص؟
 * ──────────────────────────────────
 * لأنها في الحقيقة أرقام "شبه عشوائية" (pseudo-random).
 * تُحسب من معادلة رياضية لكنها تبدو عشوائية!
 * 
 * البذرة (Seed):
 * ───────────────
 * رقم البداية للمعادلة.
 * نفس البذرة = نفس سلسلة الأرقام!
 * مفيد لإعادة إنتاج الأخطاء.
 * 
 * مثال:
 * ─────
 * ```ص
 * متغير مولد = مولد_عشوائي_جديد(42)
 * 
 * اطبع(مولد.عدد())      // نفس الرقم كل مرة!
 * اطبع(مولد.عشري())     // 0.0 إلى 1.0
 * اطبع(مولد.منطقي())    // صحيح أو خطأ
 * اطبع(مولد.نص(10))     // نص طوله 10
 * ```
 * 
 * =============================================================================
 */

// =============================================================================
// هيكل المولد العشوائي
// =============================================================================

/**
 * مولد أرقام عشوائية
 * يستخدم خوارزمية xorshift64 للسرعة
 */
هيكل مولد_عشوائي:
    // الحالة الداخلية
    حالة: عدد64
نهاية

// =============================================================================
// إنشاء المولد
// =============================================================================

/**
 * إنشاء مولد عشوائي جديد
 * 
 * # المعطيات
 * - بذرة: قيمة البداية (اختياري)
 * 
 * # مثال
 * ```ص
 * متغير م = مولد_عشوائي_جديد()      // بذرة تلقائية
 * متغير م2 = مولد_عشوائي_جديد(42)   // بذرة محددة
 * ```
 */
دالة مولد_عشوائي_جديد(بذرة: عدد64 = 0) ← مولد_عشوائي:
    متغير م: مولد_عشوائي
    
    إذا بذرة == 0:
        // استخدام الوقت كبذرة
        م.حالة = _الوقت_الحالي_نانو()
    وإلا:
        م.حالة = بذرة
    نهاية
    
    // خلط أولي للحالة
    م._خطوة()
    م._خطوة()
    
    أرجع م
نهاية

// =============================================================================
// التوليد الأساسي
// =============================================================================

/**
 * خطوة واحدة من xorshift64
 */
دالة (م: &مولد_عشوائي) _خطوة():
    م.حالة = م.حالة ^ (م.حالة << 13)
    م.حالة = م.حالة ^ (م.حالة >> 7)
    م.حالة = م.حالة ^ (م.حالة << 17)
نهاية

/**
 * توليد عدد صحيح عشوائي
 * 
 * # مثال
 * ```ص
 * متغير ع = مولد.عدد()
 * ```
 */
دالة (م: &مولد_عشوائي) عدد() ← عدد64:
    م._خطوة()
    أرجع م.حالة
نهاية

/**
 * توليد عدد في نطاق
 * 
 * # المعطيات
 * - من: الحد الأدنى (شامل)
 * - إلى: الحد الأعلى (غير شامل)
 * 
 * # مثال
 * ```ص
 * متغير نرد = مولد.عدد_في_نطاق(1, 7)  // 1 إلى 6
 * ```
 */
دالة (م: &مولد_عشوائي) عدد_في_نطاق(من: عدد64, إلى: عدد64) ← عدد64:
    متغير نطاق = إلى - من
    إذا نطاق <= 0:
        أرجع من
    نهاية
    
    أرجع من + (م.عدد() % نطاق)
نهاية

/**
 * توليد عدد عشري (0.0 إلى 1.0)
 */
دالة (م: &مولد_عشوائي) عشري() ← عشري64:
    أرجع (م.عدد() % 1000000) / 1000000.0
نهاية

/**
 * توليد عشري في نطاق
 */
دالة (م: &مولد_عشوائي) عشري_في_نطاق(من: عشري64, إلى: عشري64) ← عشري64:
    أرجع من + (م.عشري() * (إلى - من))
نهاية

/**
 * توليد قيمة منطقية
 */
دالة (م: &مولد_عشوائي) منطقي() ← منطقي:
    أرجع م.عدد() % 2 == 0
نهاية

// =============================================================================
// توليد النصوص
// =============================================================================

/**
 * توليد حرف عشوائي
 */
دالة (م: &مولد_عشوائي) حرف() ← حرف:
    // حروف عربية وإنجليزية
    ثابت حروف = "أبتثجحخدذرزسشصضطظعغفقكلمنهوي" +
                 "abcdefghijklmnopqrstuvwxyz" +
                 "0123456789"
    
    متغير فهرس = م.عدد_في_نطاق(0, طول(حروف))
    أرجع حروف[فهرس]
نهاية

/**
 * توليد نص عشوائي
 * 
 * # المعطيات
 * - طول: طول النص المطلوب
 * 
 * # مثال
 * ```ص
 * متغير نص = مولد.نص(10)  // نص من 10 أحرف
 * ```
 */
دالة (م: &مولد_عشوائي) نص(الطول: عدد) ← نص:
    متغير نتيجة = ""
    
    لكل _ في مدى(0, الطول):
        نتيجة = نتيجة + م.حرف()
    نهاية
    
    أرجع نتيجة
نهاية

/**
 * توليد نص بطول عشوائي
 */
دالة (م: &مولد_عشوائي) نص_عشوائي_الطول(حد_أدنى: عدد = 0, حد_أقصى: عدد = 100) ← نص:
    متغير الطول = م.عدد_في_نطاق(حد_أدنى, حد_أقصى + 1)
    أرجع م.نص(الطول)
نهاية

// =============================================================================
// توليد المصفوفات
// =============================================================================

/**
 * توليد مصفوفة أعداد
 * 
 * # المعطيات
 * - حجم: حجم المصفوفة
 * 
 * # مثال
 * ```ص
 * متغير أعداد = مولد.مصفوفة_أعداد(5)  // [?, ?, ?, ?, ?]
 * ```
 */
دالة (م: &مولد_عشوائي) مصفوفة_أعداد(حجم: عدد) ← مصفوفة<عدد64>:
    متغير نتيجة: مصفوفة<عدد64> = []
    
    لكل _ في مدى(0, حجم):
        أضف(نتيجة, م.عدد())
    نهاية
    
    أرجع نتيجة
نهاية

/**
 * توليد مصفوفة بحجم عشوائي
 */
دالة (م: &مولد_عشوائي) مصفوفة_أعداد_عشوائية(حد_أقصى: عدد = 100) ← مصفوفة<عدد64>:
    متغير حجم = م.عدد_في_نطاق(0, حد_أقصى + 1)
    أرجع م.مصفوفة_أعداد(حجم)
نهاية

// =============================================================================
// توليد خاص لاختبار الخصائص
// =============================================================================

/**
 * توليد قيمة من نوع معين
 * 
 * تستخدم داخلياً من إطار اختبار الخصائص
 */
دالة (م: &مولد_عشوائي) قيمة_من_نوع(اسم_النوع: نص) ← أي:
    طابق اسم_النوع:
        "عدد" | "int" | "i32":
            أرجع م.عدد_في_نطاق(-2147483648, 2147483647)
        "عدد64" | "i64":
            أرجع م.عدد()
        "عشري" | "float" | "f32":
            أرجع م.عشري_في_نطاق(-1000000.0, 1000000.0)
        "عشري64" | "f64":
            أرجع م.عشري_في_نطاق(-1e15, 1e15)
        "منطقي" | "bool":
            أرجع م.منطقي()
        "نص" | "string":
            أرجع م.نص_عشوائي_الطول(0, 50)
        "حرف" | "char":
            أرجع م.حرف()
        _:
            أرجع لا_شيء
    نهاية
نهاية

/**
 * حالات حدية (Edge Cases)
 * 
 * يولد قيم خاصة غالباً تكشف الأخطاء
 */
دالة (م: &مولد_عشوائي) عدد_حدي() ← عدد64:
    ثابت حالات_حدية = [
        0,
        1,
        -1,
        2147483647,    // أكبر i32
        -2147483648,   // أصغر i32
        9223372036854775807,   // أكبر i64
        // -9223372036854775808  // أصغر i64
    ]
    
    // 20% فرصة لقيمة حدية
    إذا م.عدد_في_نطاق(0, 5) == 0:
        متغير فهرس = م.عدد_في_نطاق(0, طول(حالات_حدية))
        أرجع حالات_حدية[فهرس]
    نهاية
    
    أرجع م.عدد()
نهاية

/**
 * نص حدي
 */
دالة (م: &مولد_عشوائي) نص_حدي() ← نص:
    ثابت حالات_حدية = [
        "",            // نص فارغ
        " ",           // مسافة
        "\t",          // tab
        "\n",          // سطر جديد
        "null",        // قد يسبب مشاكل
        "true",
        "false",
        "0",
        "-1",
        "أبجد",        // عربي
        "🎉",          // emoji
        "a" * 1000     // نص طويل
    ]
    
    إذا م.عدد_في_نطاق(0, 5) == 0:
        متغير فهرس = م.عدد_في_نطاق(0, طول(حالات_حدية))
        أرجع حالات_حدية[فهرس]
    نهاية
    
    أرجع م.نص_عشوائي_الطول()
نهاية

// =============================================================================
// أدوات مساعدة
// =============================================================================

/**
 * اختيار عشوائي من قائمة
 */
دالة (م: &مولد_عشوائي) اختر<ن>(قائمة: مصفوفة<ن>) ← ن:
    إذا طول(قائمة) == 0:
        ذعر("لا يمكن الاختيار من قائمة فارغة")
    نهاية
    
    متغير فهرس = م.عدد_في_نطاق(0, طول(قائمة))
    أرجع قائمة[فهرس]
نهاية

/**
 * خلط مصفوفة
 */
دالة (م: &مولد_عشوائي) اخلط<ن>(قائمة: &مصفوفة<ن>):
    متغير ط = طول(قائمة)
    
    لكل ي في مدى(ط - 1, 0, -1):
        متغير ج = م.عدد_في_نطاق(0, ي + 1)
        // تبديل
        متغير مؤقت = قائمة[ي]
        قائمة[ي] = قائمة[ج]
        قائمة[ج] = مؤقت
    نهاية
نهاية

/**
 * توليد واحد من عدة خيارات بأوزان
 */
دالة (م: &مولد_عشوائي) اختر_بوزن<ن>(خيارات: مصفوفة<(ن, عدد)>) ← ن:
    متغير مجموع_الأوزان = 0
    لكل (_, وزن) في خيارات:
        مجموع_الأوزان = مجموع_الأوزان + وزن
    نهاية
    
    متغير عشوائي = م.عدد_في_نطاق(0, مجموع_الأوزان)
    متغير تراكم = 0
    
    لكل (قيمة, وزن) في خيارات:
        تراكم = تراكم + وزن
        إذا عشوائي < تراكم:
            أرجع قيمة
        نهاية
    نهاية
    
    // لن نصل هنا عادة
    أرجع خيارات[0].0
نهاية

