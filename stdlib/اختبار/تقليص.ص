/**
 * =============================================================================
 * ملف: تقليص.ص
 * الوصف: خوارزمية تقليص حالات الفشل (Shrinking)
 * المهمة: T246 - Shrinking algorithm
 * المرحلة: Phase 25 - User Story 22 (Property Testing)
 * =============================================================================
 * 
 * 🔬 دليل المبتدئ للتقليص (Shrinking)
 * ═════════════════════════════════════
 * 
 * ما هو التقليص؟
 * ────────────────
 * عندما يفشل اختبار الخصائص، قد تكون القيمة المسببة معقدة:
 *   فشل مع: [4892, -2847, 9921, 0, -182, 4421, 773]
 * 
 * التقليص يحاول إيجاد أبسط قيمة تسبب نفس الفشل:
 *   فشل مع: [0]
 * 
 * لماذا هذا مهم؟
 * ────────────────
 * ✓ فهم سبب الخطأ أسهل
 * ✓ تقليل وقت التصحيح
 * ✓ اختبارات انحدار أبسط
 * 
 * كيف يعمل؟
 * ──────────
 * 1. نجد قيمة تفشل
 * 2. نولد قيم "أصغر" منها
 * 3. نختبر كل قيمة
 * 4. إذا فشلت، نكرر من الخطوة 2
 * 5. نتوقف عندما لا نجد أصغر
 * 
 * استراتيجيات التقليص:
 * ─────────────────────
 * - الأعداد: نقترب من الصفر
 * - النصوص: نحذف أحرف
 * - المصفوفات: نحذف عناصر
 * - الأنواع المركبة: نقلص كل جزء
 * 
 * =============================================================================
 */

// =============================================================================
// واجهة القابل للتقليص
// =============================================================================

/**
 * واجهة تُطبق على الأنواع التي يمكن تقليصها
 */
واجهة قابل_للتقليص<ن>:
    /**
     * توليد قيم أصغر من القيمة الحالية
     * 
     * # ملاحظة
     * يجب أن تكون القيم المُرجعة "أصغر" بطريقة منطقية
     */
    دالة قلص(قيمة: ن) ← مولد<ن>
نهاية

// =============================================================================
// تقليص الأعداد
// =============================================================================

/**
 * تقليص عدد صحيح
 * 
 * الاستراتيجية: القسمة على 2، ثم الاقتراب من الصفر
 */
دالة قلص_عدد(ع: عدد64) ← مولد<عدد64>:
    إذا ع == 0:
        أرجع مولد_فارغ()
    نهاية
    
    متغير المرشحين: مصفوفة<عدد64> = []
    
    // الصفر دائماً أبسط
    أضف(المرشحين, 0)
    
    // القسمة على 2
    أضف(المرشحين, ع / 2)
    
    // الاقتراب من الصفر
    إذا ع > 0:
        أضف(المرشحين, ع - 1)
    وإلا:
        أضف(المرشحين, ع + 1)
    نهاية
    
    // القيمة المطلقة (إذا سالب)
    إذا ع < 0:
        أضف(المرشحين, -ع)
    نهاية
    
    // إزالة التكرار والقيمة الأصلية
    أرجع _من_قائمة_فريدة(المرشحين, ع)
نهاية

/**
 * تقليص عدد عشري
 */
دالة قلص_عشري(ع: عشري64) ← مولد<عشري64>:
    إذا ع == 0.0:
        أرجع مولد_فارغ()
    نهاية
    
    متغير المرشحين: مصفوفة<عشري64> = []
    
    // الصفر
    أضف(المرشحين, 0.0)
    
    // تقريب لأقرب صحيح
    أضف(المرشحين, قرب(ع))
    
    // القسمة على 2
    أضف(المرشحين, ع / 2.0)
    
    // إزالة الكسور
    أضف(المرشحين, اقتطع(ع))
    
    أرجع _من_قائمة_فريدة(المرشحين, ع)
نهاية

// =============================================================================
// تقليص النصوص
// =============================================================================

/**
 * تقليص نص
 * 
 * الاستراتيجيات:
 * 1. النص الفارغ
 * 2. النصف الأول / الثاني
 * 3. حذف حرف واحد في كل موقع
 */
دالة قلص_نص(ن: نص) ← مولد<نص>:
    إذا طول(ن) == 0:
        أرجع مولد_فارغ()
    نهاية
    
    متغير المرشحين: مصفوفة<نص> = []
    
    // النص الفارغ
    أضف(المرشحين, "")
    
    // النصف الأول
    إذا طول(ن) > 1:
        أضف(المرشحين, ن[0..طول(ن)/2])
        أضف(المرشحين, ن[طول(ن)/2..])
    نهاية
    
    // حذف حرف واحد
    لكل ي في مدى(0, طول(ن)):
        متغير بدون = ن[0..ي] + ن[ي+1..]
        أضف(المرشحين, بدون)
    نهاية
    
    // استبدال بأحرف أبسط
    إذا طول(ن) == 1:
        أضف(المرشحين, "a")
        أضف(المرشحين, "0")
    نهاية
    
    أرجع _من_قائمة_فريدة(المرشحين, ن)
نهاية

// =============================================================================
// تقليص المصفوفات
// =============================================================================

/**
 * تقليص مصفوفة
 * 
 * الاستراتيجيات:
 * 1. المصفوفة الفارغة
 * 2. النصف الأول / الثاني
 * 3. حذف عنصر واحد
 * 4. تقليص كل عنصر
 */
دالة قلص_مصفوفة<ن>(م: مصفوفة<ن>, قلص_عنصر: دالة(ن) ← مولد<ن>) ← مولد<مصفوفة<ن>>:
    إذا طول(م) == 0:
        أرجع مولد_فارغ()
    نهاية
    
    متغير المرشحين: مصفوفة<مصفوفة<ن>> = []
    
    // الفارغة
    أضف(المرشحين, [])
    
    // الأنصاف
    إذا طول(م) > 1:
        أضف(المرشحين, م[0..طول(م)/2])
        أضف(المرشحين, م[طول(م)/2..])
    نهاية
    
    // حذف عنصر واحد
    لكل ي في مدى(0, طول(م)):
        متغير بدون = م[0..ي] + م[ي+1..]
        أضف(المرشحين, بدون)
    نهاية
    
    // تقليص كل عنصر (أول 3 فقط للأداء)
    لكل ي في مدى(0, حد_أدنى(3, طول(م))):
        لكل مُقلص في قلص_عنصر(م[ي]):
            متغير نسخة = انسخ(م)
            نسخة[ي] = مُقلص
            أضف(المرشحين, نسخة)
        نهاية
    نهاية
    
    أرجع _من_قائمة_فريدة(المرشحين, م)
نهاية

// =============================================================================
// تقليص الاختياري
// =============================================================================

/**
 * تقليص قيمة اختيارية
 */
دالة قلص_اختياري<ن>(خ: اختياري<ن>, قلص_قيمة: دالة(ن) ← مولد<ن>) ← مولد<اختياري<ن>>:
    طابق خ:
        لا_شيء:
            أرجع مولد_فارغ()
        
        بعض(ق):
            متغير المرشحين: مصفوفة<اختياري<ن>> = []
            
            // لا_شيء أبسط
            أضف(المرشحين, لا_شيء)
            
            // تقليص القيمة
            لكل مُقلص في قلص_قيمة(ق):
                أضف(المرشحين, بعض(مُقلص))
            نهاية
            
            أرجع _من_قائمة(المرشحين)
    نهاية
نهاية

// =============================================================================
// تقليص الصفوف
// =============================================================================

/**
 * تقليص صف (tuple) ثنائي
 */
دالة قلص_صف2<أ, ب>(
    صف: (أ, ب),
    قلص_أ: دالة(أ) ← مولد<أ>,
    قلص_ب: دالة(ب) ← مولد<ب>
) ← مولد<(أ, ب)>:
    متغير (ق_أ, ق_ب) = صف
    متغير المرشحين: مصفوفة<(أ, ب)> = []
    
    // تقليص العنصر الأول
    لكل مُقلص في قلص_أ(ق_أ):
        أضف(المرشحين, (مُقلص, ق_ب))
    نهاية
    
    // تقليص العنصر الثاني
    لكل مُقلص في قلص_ب(ق_ب):
        أضف(المرشحين, (ق_أ, مُقلص))
    نهاية
    
    أرجع _من_قائمة(المرشحين)
نهاية

// =============================================================================
// محرك التقليص
// =============================================================================

/**
 * نتيجة التقليص
 */
هيكل نتيجة_تقليص<ن>:
    القيمة_الأصلية: ن
    القيمة_المُقلصة: ن
    عدد_المحاولات: عدد
    نجح: منطقي
نهاية

/**
 * محرك التقليص الرئيسي
 * 
 * # المعطيات
 * - قيمة: القيمة التي تسبب الفشل
 * - اختبار: دالة تُرجع صحيح إذا فشل الاختبار
 * - قلص: دالة توليد قيم أصغر
 * - حد_محاولات: الحد الأقصى للمحاولات
 */
دالة قلص_حتى_الحد_الأدنى<ن>(
    قيمة: ن,
    اختبار: دالة(ن) ← منطقي,
    قلص: دالة(ن) ← مولد<ن>,
    حد_محاولات: عدد = 100
) ← نتيجة_تقليص<ن>:
    
    متغير الحالية = قيمة
    متغير محاولات = 0
    متغير تغير = صحيح
    
    طالما تغير و محاولات < حد_محاولات:
        تغير = خطأ
        
        لكل مُقلص في قلص(الحالية):
            محاولات = محاولات + 1
            
            إذا محاولات >= حد_محاولات:
                توقف
            نهاية
            
            // هل يسبب نفس الفشل؟
            إذا اختبار(مُقلص):
                الحالية = مُقلص
                تغير = صحيح
                توقف
            نهاية
        نهاية
    نهاية
    
    أرجع نتيجة_تقليص {
        القيمة_الأصلية = قيمة,
        القيمة_المُقلصة = الحالية,
        عدد_المحاولات = محاولات,
        نجح = الحالية != قيمة
    }
نهاية

// =============================================================================
// تقليص تلقائي
// =============================================================================

/**
 * تقليص تلقائي بناءً على النوع
 */
دالة قلص_تلقائي(قيمة: أي) ← مولد<أي>:
    طابق نوع(قيمة):
        "عدد" | "عدد32" | "عدد64":
            أرجع قلص_عدد(قيمة كـ عدد64)
        
        "عشري" | "عشري32" | "عشري64":
            أرجع قلص_عشري(قيمة كـ عشري64)
        
        "نص":
            أرجع قلص_نص(قيمة كـ نص)
        
        "منطقي":
            // المنطقي لا يُقلص (فقط قيمتان)
            أرجع مولد_فارغ()
        
        _:
            // نوع غير معروف
            أرجع مولد_فارغ()
    نهاية
نهاية

// =============================================================================
// أدوات مساعدة
// =============================================================================

/**
 * إنشاء مولد من قائمة مع إزالة التكرار وقيمة معينة
 */
دالة _من_قائمة_فريدة<ن>(قائمة: مصفوفة<ن>, استبعد: ن) ← مولد<ن>:
    متغير فريدة: مجموعة<ن> = مجموعة_جديدة()
    
    لكل عنصر في قائمة:
        إذا عنصر != استبعد:
            أضف_للمجموعة(فريدة, عنصر)
        نهاية
    نهاية
    
    أرجع مولد_من_مجموعة(فريدة)
نهاية

/**
 * إنشاء مولد من قائمة
 */
دالة _من_قائمة<ن>(قائمة: مصفوفة<ن>) ← مولد<ن>:
    متغير فهرس = 0
    
    أرجع مولد {
        التالي = دالة() ← اختياري<ن>:
            إذا فهرس >= طول(قائمة):
                أرجع لا_شيء
            نهاية
            متغير قيمة = قائمة[فهرس]
            فهرس = فهرس + 1
            أرجع بعض(قيمة)
        نهاية
    }
نهاية

