/**
 * =============================================================================
 * ملف: عشوائي.ص
 * الوصف: واجهة Arbitrary للأنواع القابلة للتوليد العشوائي
 * المهمة: T247 - Arbitrary trait for types
 * المرحلة: Phase 25 - User Story 22 (Property Testing)
 * =============================================================================
 * 
 * 🎯 دليل المبتدئ لواجهة عشوائي
 * ═══════════════════════════════
 * 
 * ما هي واجهة عشوائي (Arbitrary)؟
 * ──────────────────────────────────
 * واجهة تُعرّف كيفية توليد قيم عشوائية لنوع معين.
 * 
 * لماذا نحتاجها؟
 * ────────────────
 * لكي يعمل اختبار الخصائص، نحتاج طريقة لتوليد
 * قيم عشوائية من أي نوع.
 * 
 * كيف نستخدمها؟
 * ──────────────
 * 1. طبّق الواجهة على نوعك
 * 2. اكتب دالة التوليد
 * 3. استخدمها في اختبارات الخصائص
 * 
 * مثال:
 * ─────
 * ```ص
 * هيكل نقطة:
 *     س: عدد
 *     ص: عدد
 * نهاية
 * 
 * طبّق عشوائي<نقطة>:
 *     دالة عشوائي(مولد: &مولد_عشوائي) ← نقطة:
 *         أرجع نقطة {
 *             س = مولد.عدد_في_نطاق(-100, 100),
 *             ص = مولد.عدد_في_نطاق(-100, 100)
 *         }
 *     نهاية
 * نهاية
 * ```
 * 
 * الآن يمكن استخدام نقطة في اختبارات الخصائص!
 * 
 * =============================================================================
 */

استورد "مولد_عشوائي" { مولد_عشوائي }
استورد "تقليص" { قلص_عدد, قلص_نص, قلص_مصفوفة }

// =============================================================================
// واجهة عشوائي
// =============================================================================

/**
 * واجهة للأنواع التي يمكن توليد قيم عشوائية منها
 * 
 * # المطلوب تطبيقه
 * - عشوائي: دالة تولد قيمة عشوائية
 * 
 * # اختياري
 * - قلص: دالة لتوليد قيم أصغر
 */
واجهة عشوائي<ن>:
    /**
     * توليد قيمة عشوائية
     */
    دالة عشوائي(مولد: &مولد_عشوائي) ← ن
    
    /**
     * توليد قيم أصغر للتقليص
     * (افتراضي: لا تقليص)
     */
    دالة قلص(قيمة: ن) ← مولد<ن> = مولد_فارغ()
نهاية

// =============================================================================
// تطبيقات الأنواع الأساسية
// =============================================================================

/**
 * عشوائي للأعداد الصحيحة
 */
طبّق عشوائي<عدد>:
    دالة عشوائي(مولد: &مولد_عشوائي) ← عدد:
        // 10% حالات حدية
        إذا مولد.عدد_في_نطاق(0, 10) == 0:
            أرجع مولد.اختر([0, 1, -1, 2147483647, -2147483648])
        نهاية
        أرجع مولد.عدد_في_نطاق(-2147483648, 2147483647)
    نهاية
    
    دالة قلص(قيمة: عدد) ← مولد<عدد>:
        أرجع قلص_عدد(قيمة)
    نهاية
نهاية

/**
 * عشوائي للأعداد الطويلة
 */
طبّق عشوائي<عدد64>:
    دالة عشوائي(مولد: &مولد_عشوائي) ← عدد64:
        أرجع مولد.عدد()
    نهاية
    
    دالة قلص(قيمة: عدد64) ← مولد<عدد64>:
        أرجع قلص_عدد(قيمة)
    نهاية
نهاية

/**
 * عشوائي للأعداد العشرية
 */
طبّق عشوائي<عشري64>:
    دالة عشوائي(مولد: &مولد_عشوائي) ← عشري64:
        // 10% حالات خاصة
        إذا مولد.عدد_في_نطاق(0, 10) == 0:
            أرجع مولد.اختر([0.0, 1.0, -1.0, 0.5, -0.5])
        نهاية
        أرجع مولد.عشري_في_نطاق(-1e10, 1e10)
    نهاية
نهاية

/**
 * عشوائي للقيم المنطقية
 */
طبّق عشوائي<منطقي>:
    دالة عشوائي(مولد: &مولد_عشوائي) ← منطقي:
        أرجع مولد.منطقي()
    نهاية
    
    // المنطقي لا يُقلص (قيمتان فقط)
نهاية

/**
 * عشوائي للنصوص
 */
طبّق عشوائي<نص>:
    دالة عشوائي(مولد: &مولد_عشوائي) ← نص:
        // 10% حالات خاصة
        إذا مولد.عدد_في_نطاق(0, 10) == 0:
            أرجع مولد.اختر([
                "",
                " ",
                "\n",
                "null",
                "مرحبا",
                "🎉"
            ])
        نهاية
        أرجع مولد.نص_عشوائي_الطول(0, 100)
    نهاية
    
    دالة قلص(قيمة: نص) ← مولد<نص>:
        أرجع قلص_نص(قيمة)
    نهاية
نهاية

/**
 * عشوائي للحروف
 */
طبّق عشوائي<حرف>:
    دالة عشوائي(مولد: &مولد_عشوائي) ← حرف:
        أرجع مولد.حرف()
    نهاية
نهاية

// =============================================================================
// تطبيقات الأنواع المركبة
// =============================================================================

/**
 * عشوائي للمصفوفات
 */
طبّق عشوائي<مصفوفة<ن>> حيث ن: عشوائي:
    دالة عشوائي(مولد: &مولد_عشوائي) ← مصفوفة<ن>:
        // 10% فرصة لمصفوفة فارغة
        إذا مولد.عدد_في_نطاق(0, 10) == 0:
            أرجع []
        نهاية
        
        متغير حجم = مولد.عدد_في_نطاق(0, 20)
        متغير نتيجة: مصفوفة<ن> = []
        
        لكل _ في مدى(0, حجم):
            أضف(نتيجة, ن.عشوائي(مولد))
        نهاية
        
        أرجع نتيجة
    نهاية
    
    دالة قلص(قيمة: مصفوفة<ن>) ← مولد<مصفوفة<ن>>:
        أرجع قلص_مصفوفة(قيمة, ن.قلص)
    نهاية
نهاية

/**
 * عشوائي للاختياري
 */
طبّق عشوائي<اختياري<ن>> حيث ن: عشوائي:
    دالة عشوائي(مولد: &مولد_عشوائي) ← اختياري<ن>:
        // 20% فرصة لـ لا_شيء
        إذا مولد.عدد_في_نطاق(0, 5) == 0:
            أرجع لا_شيء
        نهاية
        
        أرجع بعض(ن.عشوائي(مولد))
    نهاية
نهاية

/**
 * عشوائي للصفوف الثنائية
 */
طبّق عشوائي<(أ, ب)> حيث أ: عشوائي, ب: عشوائي:
    دالة عشوائي(مولد: &مولد_عشوائي) ← (أ, ب):
        أرجع (أ.عشوائي(مولد), ب.عشوائي(مولد))
    نهاية
نهاية

/**
 * عشوائي للصفوف الثلاثية
 */
طبّق عشوائي<(أ, ب, ج)> حيث أ: عشوائي, ب: عشوائي, ج: عشوائي:
    دالة عشوائي(مولد: &مولد_عشوائي) ← (أ, ب, ج):
        أرجع (أ.عشوائي(مولد), ب.عشوائي(مولد), ج.عشوائي(مولد))
    نهاية
نهاية

// =============================================================================
// عشوائي مع قيود
// =============================================================================

/**
 * عدد في نطاق محدد
 */
هيكل عدد_محدود:
    من: عدد
    إلى: عدد
نهاية

طبّق عشوائي<عدد_محدود>:
    دالة عشوائي_مع_نطاق(مولد: &مولد_عشوائي, من: عدد, إلى: عدد) ← عدد:
        أرجع مولد.عدد_في_نطاق(من, إلى)
    نهاية
نهاية

/**
 * نص بطول محدد
 */
هيكل نص_محدود:
    حد_أدنى: عدد
    حد_أقصى: عدد
نهاية

دالة نص_عشوائي_محدود(مولد: &مولد_عشوائي, حد_أدنى: عدد, حد_أقصى: عدد) ← نص:
    أرجع مولد.نص_عشوائي_الطول(حد_أدنى, حد_أقصى)
نهاية

/**
 * مصفوفة بحجم محدد
 */
دالة مصفوفة_عشوائية_محدودة<ن>(
    مولد: &مولد_عشوائي,
    حد_أدنى: عدد,
    حد_أقصى: عدد
) ← مصفوفة<ن> حيث ن: عشوائي:
    متغير حجم = مولد.عدد_في_نطاق(حد_أدنى, حد_أقصى + 1)
    متغير نتيجة: مصفوفة<ن> = []
    
    لكل _ في مدى(0, حجم):
        أضف(نتيجة, ن.عشوائي(مولد))
    نهاية
    
    أرجع نتيجة
نهاية

