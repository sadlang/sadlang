/**
 * ماكرو لتطبيق عشوائي على تعداد
 * 
 * # مثال
 * ```ص
 * تعداد لون:
 *     أحمر
 *     أخضر
 *     أزرق
 * نهاية
 * 
 * طبّق_عشوائي_تعداد!(لون)
 * ```
 */
ماكرو طبّق_عشوائي_تعداد(اسم_التعداد, ...القيم):
    طبّق عشوائي<#اسم_التعداد>:
        دالة عشوائي(مولد: &مولد_عشوائي) ← #اسم_التعداد:
            متغير جميع_القيم = [#(القيم),*]
            متغير فهرس = مولد.عدد_في_نطاق(0, طول(جميع_القيم))
            أرجع جميع_القيم[فهرس]
        نهاية
    نهاية
نهاية

// =============================================================================
// دوال مساعدة
// =============================================================================

/**
 * توليد قيمة عشوائية من نوع معين
 */
دالة ولّد<ن>(مولد: &مولد_عشوائي) ← ن حيث ن: عشوائي:
    أرجع ن.عشوائي(مولد)
نهاية

/**
 * توليد قائمة من القيم العشوائية
 */
دالة ولّد_قائمة<ن>(مولد: &مولد_عشوائي, عدد: عدد) ← مصفوفة<ن> حيث ن: عشوائي:
    متغير نتيجة: مصفوفة<ن> = []
    
    لكل _ في مدى(0, عدد):
        أضف(نتيجة, ولّد<ن>(مولد))
    نهاية
    
    أرجع نتيجة
نهاية

/**
 * توليد قيمة تحقق شرط معين
 */
دالة ولّد_بشرط<ن>(
    مولد: &مولد_عشوائي,
    شرط: دالة(ن) ← منطقي,
    حد_محاولات: عدد = 1000
) ← اختياري<ن> حيث ن: عشوائي:
    
    لكل _ في مدى(0, حد_محاولات):
        متغير قيمة = ولّد<ن>(مولد)
        إذا شرط(قيمة):
            أرجع بعض(قيمة)
        نهاية
    نهاية
    
    أرجع لا_شيء
نهاية

/**
 * توليد واحد من عدة خيارات
 */
دالة أحد<ن>(مولد: &مولد_عشوائي, خيارات: مصفوفة<ن>) ← ن:
    إذا طول(خيارات) == 0:
        ذعر("لا يمكن الاختيار من قائمة فارغة")
    نهاية
    
    متغير فهرس = مولد.عدد_في_نطاق(0, طول(خيارات))
    أرجع خيارات[فهرس]
نهاية

/**
 * توليد تكرار من قيمة
 */
دالة كرر<ن>(مولد: &مولد_عشوائي, قيمة: ن, عدد: عدد) ← مصفوفة<ن>:
    متغير نتيجة: مصفوفة<ن> = []
    
    لكل _ في مدى(0, عدد):
        أضف(نتيجة, قيمة)
    نهاية
    
    أرجع نتيجة
نهاية

// =============================================================================
// مركبات معقدة
// =============================================================================

/**
 * توليد قاموس عشوائي
 */
دالة قاموس_عشوائي<م, ق>(
    مولد: &مولد_عشوائي,
    حد_أقصى: عدد = 20
) ← قاموس<م, ق> حيث م: عشوائي, ق: عشوائي:
    متغير حجم = مولد.عدد_في_نطاق(0, حد_أقصى + 1)
    متغير نتيجة: قاموس<م, ق> = قاموس_جديد()
    
    لكل _ في مدى(0, حجم):
        متغير مفتاح = ولّد<م>(مولد)
        متغير قيمة = ولّد<ق>(مولد)
        نتيجة[مفتاح] = قيمة
    نهاية
    
    أرجع نتيجة
نهاية

/**
 * توليد مجموعة عشوائية
 */
دالة مجموعة_عشوائية<ن>(
    مولد: &مولد_عشوائي,
    حد_أقصى: عدد = 20
) ← مجموعة<ن> حيث ن: عشوائي:
    متغير حجم = مولد.عدد_في_نطاق(0, حد_أقصى + 1)
    متغير نتيجة: مجموعة<ن> = مجموعة_جديدة()
    
    لكل _ في مدى(0, حجم):
        أضف_للمجموعة(نتيجة, ولّد<ن>(مولد))
    نهاية
    
    أرجع نتيجة
نهاية

