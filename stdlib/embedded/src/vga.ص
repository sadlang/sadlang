/**
 * (AR) وحدة التحكم بالمؤشر
 *      تستخدم منافذ I/O للتحكم بموقع المؤشر
 */
وحدة مؤشر {
    // (AR) منافذ VGA
    ثابت منفذ_تحكم: ص16 = 0x3D4؛
    ثابت منفذ_بيانات: ص16 = 0x3D5؛
    
    /**
     * (AR) تفعيل المؤشر
     */
    دالة عامة فعّل() {
        غير_آمن {
            // (AR) سجل بداية المؤشر
            أخرج_بايت(منفذ_تحكم، 0x0A)؛
            دع حالي = أدخل_بايت(منفذ_بيانات)؛
            أخرج_بايت(منفذ_بيانات، حالي & 0xC0)؛  // (AR) تفعيل
            
            // (AR) سجل نهاية المؤشر
            أخرج_بايت(منفذ_تحكم، 0x0B)؛
            دع حالي = أدخل_بايت(منفذ_بيانات)؛
            أخرج_بايت(منفذ_بيانات، (حالي & 0xE0) | 15)؛
        }
    }
    
    /**
     * (AR) إخفاء المؤشر
     */
    دالة عامة أخفِ() {
        غير_آمن {
            أخرج_بايت(منفذ_تحكم، 0x0A)؛
            أخرج_بايت(منفذ_بيانات، 0x20)؛  // (AR) بت الإخفاء
        }
    }
    
    /**
     * (AR) تحديث موقع المؤشر
     */
    دالة عامة حدّث_موقع(صف: ص_حجم، عمود: ص_حجم) {
        دع موقع = صف * عرض_شاشة + عمود؛
        
        غير_آمن {
            // (AR) البايت السفلي
            أخرج_بايت(منفذ_تحكم، 0x0F)؛
            أخرج_بايت(منفذ_بيانات، (موقع & 0xFF) كـ ص8)؛
            
            // (AR) البايت العلوي
            أخرج_بايت(منفذ_تحكم، 0x0E)؛
            أخرج_بايت(منفذ_بيانات، ((موقع >> 8) & 0xFF) كـ ص8)؛
        }
    }
    
    /**
     * (AR) قراءة موقع المؤشر الحالي
     */
    دالة عامة اقرأ_موقع() -> (ص_حجم، ص_حجم) {
        دع موقع: ص16؛
        
        غير_آمن {
            أخرج_بايت(منفذ_تحكم، 0x0F)؛
            موقع = أدخل_بايت(منفذ_بيانات) كـ ص16؛
            
            أخرج_بايت(منفذ_تحكم، 0x0E)؛
            موقع |= (أدخل_بايت(منفذ_بيانات) كـ ص16) << 8؛
        }
        
        دع صف = (موقع كـ ص_حجم) / عرض_شاشة؛
        دع عمود = (موقع كـ ص_حجم) % عرض_شاشة؛
        
        (صف، عمود)
    }
    
    // (AR) دوال I/O
    #[مضمنة(دائماً)]
    دالة غير_آمنة أخرج_بايت(منفذ: ص16، قيمة: ص8) {
        تجميع!(
            "out dx, al"
            :
            : "{dx}"(منفذ)، "{al}"(قيمة)
            :
            : "volatile"
        )؛
    }
    
    #[مضمنة(دائماً)]
    دالة غير_آمنة أدخل_بايت(منفذ: ص16) -> ص8 {
        دع قيمة: ص8؛
        تجميع!(
            "in al, dx"
            : "={al}"(قيمة)
            : "{dx}"(منفذ)
            :
            : "volatile"
        )؛
        قيمة
    }
}

