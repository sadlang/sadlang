/**
 * (AR) ثوابت وضع النص VGA القياسي
 */
ثابت عام عنوان_VGA: ص_مؤشر = 0xB8000؛
ثابت عام عرض_شاشة: ص_حجم = 80؛
ثابت عام ارتفاع_شاشة: ص_حجم = 25؛
ثابت عام حجم_المخزن: ص_حجم = عرض_شاشة * ارتفاع_شاشة * 2؛

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) ألوان VGA
//                    (EN) VGA Colors
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) ألوان VGA القياسية (16 لون)
 * 
 * مثال:
 * @code
 * // تعيين لون النص إلى أخضر فاتح على خلفية سوداء
 * دع لون = لون_VGA::أخضر_فاتح؛
 * @endcode
 */
#[repr(u8)]
تعداد لون_VGA {
    أسود = 0x0،
    أزرق = 0x1،
    أخضر = 0x2،
    سماوي = 0x3،
    أحمر = 0x4،
    بنفسجي = 0x5،
    بني = 0x6،
    رمادي_فاتح = 0x7،
    رمادي_داكن = 0x8،
    أزرق_فاتح = 0x9،
    أخضر_فاتح = 0xA،
    سماوي_فاتح = 0xB،
    أحمر_فاتح = 0xC،
    وردي = 0xD،
    أصفر = 0xE،
    أبيض = 0xF،
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) بايت اللون
//                    (EN) Color Byte
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) هيكل بايت اللون
 *      يجمع بين لون المقدمة ولون الخلفية
 */
#[repr(transparent)]
هيكل كود_لون {
    قيمة: ص8،
}

تطبيق كود_لون {
    /**
     * (AR) إنشاء كود لون جديد
     * 
     * @param مقدمة - لون النص
     * @param خلفية - لون الخلفية
     * @returns كود اللون المركب
     */
    #[مضمنة(دائماً)]
    دالة عامة جديد(مقدمة: لون_VGA، خلفية: لون_VGA) -> ذاتي {
        كود_لون {
            قيمة: (مقدمة كـ ص8) | ((خلفية كـ ص8) << 4)
        }
    }
    
    /**
     * (AR) كود لون افتراضي (أبيض على أسود)
     */
    #[مضمنة(دائماً)]
    دالة عامة افتراضي() -> ذاتي {
        كود_لون::جديد(لون_VGA::أبيض، لون_VGA::أسود)
    }
    
    /**
     * (AR) كود لون للتحذيرات (أصفر على أسود)
     */
    #[مضمنة(دائماً)]
    دالة عامة تحذير() -> ذاتي {
        كود_لون::جديد(لون_VGA::أصفر، لون_VGA::أسود)
    }
    
    /**
     * (AR) كود لون للأخطاء (أحمر فاتح على أسود)
     */
    #[مضمنة(دائماً)]
    دالة عامة خطأ() -> ذاتي {
        كود_لون::جديد(لون_VGA::أحمر_فاتح، لون_VGA::أسود)
    }
    
    /**
     * (AR) كود لون للنجاح (أخضر فاتح على أسود)
     */
    #[مضمنة(دائماً)]
    دالة عامة نجاح() -> ذاتي {
        كود_لون::جديد(لون_VGA::أخضر_فاتح، لون_VGA::أسود)
    }
    
    /**
     * (AR) كود لون للمعلومات (سماوي على أسود)
     */
    #[مضمنة(دائماً)]
    دالة عامة معلومات() -> ذاتي {
        كود_لون::جديد(لون_VGA::سماوي_فاتح، لون_VGA::أسود)
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) محرف الشاشة
//                    (EN) Screen Character
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) محرف واحد على الشاشة
 *      يتضمن الحرف واللون
 */
#[repr(C)]
هيكل محرف_شاشة {
    حرف: ص8،
    لون: كود_لون،
}

تطبيق محرف_شاشة {
    /**
     * (AR) إنشاء محرف جديد
     */
    #[مضمنة(دائماً)]
    دالة عامة جديد(حرف: ص8، لون: كود_لون) -> ذاتي {
        محرف_شاشة { حرف، لون }
    }
    
    /**
     * (AR) محرف فارغ (مسافة بيضاء)
     */
    #[مضمنة(دائماً)]
    دالة عامة فارغ() -> ذاتي {
        محرف_شاشة::جديد(b' '، كود_لون::افتراضي())
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) كاتب VGA
//                    (EN) VGA Writer
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) كاتب شاشة VGA
 *      يوفر واجهة عالية المستوى للكتابة على الشاشة
 * 
 * مثال:
 * @code
 * دع متغير كاتب = كاتب_VGA::جديد()؛
 * 
 * // مسح الشاشة
 * كاتب.امسح()؛
 * 
 * // كتابة نص
 * كاتب.اكتب_نص("مرحباً بالعالم!")؛
 * 
 * // سطر جديد
 * كاتب.سطر_جديد()؛
 * 
 * // كتابة بلون مختلف
 * كاتب.عيّن_لون(كود_لون::خطأ())؛
 * كاتب.اكتب_نص("حدث خطأ!")؛
 * @endcode
 */
هيكل كاتب_VGA {
    عمود: ص_حجم،
    صف: ص_حجم،
    لون: كود_لون،
    مخزن: *متغير محرف_شاشة،
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) تطبيق كاتب VGA
//                    (EN) VGA Writer Implementation
// ═══════════════════════════════════════════════════════════════════════════════

تطبيق كاتب_VGA {
    /**
     * (AR) إنشاء كاتب VGA جديد
     */
    دالة عامة جديد() -> ذاتي {
        كاتب_VGA {
            عمود: 0،
            صف: 0،
            لون: كود_لون::افتراضي()،
            مخزن: عنوان_VGA كـ *متغير محرف_شاشة،
        }
    }
    
    /**
     * (AR) تعيين لون الكتابة
     */
    #[مضمنة(دائماً)]
    دالة عامة عيّن_لون(&متغير ذاتي، لون: كود_لون) {
        ذاتي.لون = لون؛
    }
    
    /**
     * (AR) تعيين موقع المؤشر
     */
    #[مضمنة(دائماً)]
    دالة عامة انتقل(&متغير ذاتي، صف: ص_حجم، عمود: ص_حجم) {
        إذا صف < ارتفاع_شاشة && عمود < عرض_شاشة {
            ذاتي.صف = صف؛
            ذاتي.عمود = عمود؛
        }
    }
    
    /**
     * (AR) مسح الشاشة
     */
    دالة عامة امسح(&متغير ذاتي) {
        دع فارغ = محرف_شاشة::فارغ()؛
        لكل صف في 0..ارتفاع_شاشة {
            لكل عمود في 0..عرض_شاشة {
                دع فهرس = صف * عرض_شاشة + عمود؛
                غير_آمن {
                    ذاتي.مخزن.إزاحة(فهرس كـ ص_فرق).اكتب_متطاير(فارغ)؛
                }
            }
        }
        ذاتي.عمود = 0؛
        ذاتي.صف = 0؛
    }
    
    /**
     * (AR) كتابة بايت واحد
     */
    دالة عامة اكتب_بايت(&متغير ذاتي، بايت: ص8) {
        طابق بايت {
            b'\n' => ذاتي.سطر_جديد()،
            b'\r' => ذاتي.عمود = 0،
            b'\t' => {
                // (AR) تقدم إلى الموقع التالي القابل للقسمة على 8
                دع مسافات = 8 - (ذاتي.عمود % 8)؛
                لكل _ في 0..مسافات {
                    ذاتي.اكتب_بايت(b' ')؛
                }
            }،
            بايت => {
                إذا ذاتي.عمود >= عرض_شاشة {
                    ذاتي.سطر_جديد()؛
                }
                
                دع فهرس = ذاتي.صف * عرض_شاشة + ذاتي.عمود؛
                دع محرف = محرف_شاشة::جديد(بايت، ذاتي.لون)؛
                
                غير_آمن {
                    ذاتي.مخزن.إزاحة(فهرس كـ ص_فرق).اكتب_متطاير(محرف)؛
                }
                
                ذاتي.عمود += 1؛
            }
        }
    }
    
    /**
     * (AR) كتابة سلسلة نصية
     */
    دالة عامة اكتب_نص(&متغير ذاتي، نص: &نص) {
        لكل بايت في نص.كـ_بايتات() {
            // (AR) تحويل الأحرف غير القابلة للطباعة إلى علامة استفهام
            طابق بايت {
                0x20..=0x7E | b'\n' | b'\r' | b'\t' => ذاتي.اكتب_بايت(بايت)،
                _ => ذاتي.اكتب_بايت(0xFE)، // (AR) علامة ■
            }
        }
    }
    
    /**
     * (AR) الانتقال لسطر جديد
     */
    دالة عامة سطر_جديد(&متغير ذاتي) {
        ذاتي.عمود = 0؛
        إذا ذاتي.صف < ارتفاع_شاشة - 1 {
            ذاتي.صف += 1؛
        } وإلا {
            ذاتي.مرر()؛
        }
    }
    
    /**
     * (AR) تمرير الشاشة للأعلى
     */
    دالة خاصة مرر(&متغير ذاتي) {
        // (AR) نسخ كل صف للصف الذي فوقه
        لكل صف في 1..ارتفاع_شاشة {
            لكل عمود في 0..عرض_شاشة {
                دع فهرس_مصدر = صف * عرض_شاشة + عمود؛
                دع فهرس_هدف = (صف - 1) * عرض_شاشة + عمود؛
                
                غير_آمن {
                    دع محرف = ذاتي.مخزن.إزاحة(فهرس_مصدر كـ ص_فرق).اقرأ_متطاير()؛
                    ذاتي.مخزن.إزاحة(فهرس_هدف كـ ص_فرق).اكتب_متطاير(محرف)؛
                }
            }
        }
        
        // (AR) مسح الصف الأخير
        دع فارغ = محرف_شاشة::فارغ()؛
        دع صف_أخير = ارتفاع_شاشة - 1؛
        لكل عمود في 0..عرض_شاشة {
            دع فهرس = صف_أخير * عرض_شاشة + عمود؛
            غير_آمن {
                ذاتي.مخزن.إزاحة(فهرس كـ ص_فرق).اكتب_متطاير(فارغ)؛
            }
        }
    }
    
    /**
     * (AR) كتابة رقم صحيح
     */
    دالة عامة اكتب_رقم(&متغير ذاتي، رقم: ص64) {
        إذا رقم == 0 {
            ذاتي.اكتب_بايت(b'0')؛
            إرجاع؛
        }
        
        // (AR) مخزن مؤقت للأرقام (أقصى 20 رقم لـ u64)
        دع متغير أرقام: [ص8؛ 20] = [0؛ 20]؛
        دع متغير عدد = 0؛
        دع متغير ن = رقم؛
        
        بينما ن > 0 {
            أرقام[عدد] = b'0' + (ن % 10) كـ ص8؛
            ن /= 10؛
            عدد += 1؛
        }
        
        // (AR) كتابة الأرقام بالترتيب الصحيح
        بينما عدد > 0 {
            عدد -= 1؛
            ذاتي.اكتب_بايت(أرقام[عدد])؛
        }
    }
    
    /**
     * (AR) كتابة رقم بالنظام الست عشري
     */
    دالة عامة اكتب_ست_عشري(&متغير ذاتي، رقم: ص64) {
        ذاتي.اكتب_نص("0x")؛
        
        // (AR) كتابة 16 رقم ست عشري (64 بت)
        لكل ي في (0..16).عكس() {
            دع رقم = ((رقم >> (ي * 4)) & 0xF) كـ ص8؛
            دع حرف = إذا رقم < 10 {
                b'0' + رقم
            } وإلا {
                b'A' + (رقم - 10)
            }؛
            ذاتي.اكتب_بايت(حرف)؛
        }
    }
    
    /**
     * (AR) رسم إطار
     */
    دالة عامة ارسم_إطار(&متغير ذاتي، س: ص_حجم، ص: ص_حجم، عرض: ص_حجم، ارتفاع: ص_حجم) {
        // (AR) أحرف الإطار (Code Page 437)
        ثابت زاوية_علوية_يسرى: ص8 = 0xC9؛   // ╔
        ثابت زاوية_علوية_يمنى: ص8 = 0xBB؛   // ╗
        ثابت زاوية_سفلية_يسرى: ص8 = 0xC8؛   // ╚
        ثابت زاوية_سفلية_يمنى: ص8 = 0xBC؛   // ╝
        ثابت خط_أفقي: ص8 = 0xCD؛            // ═
        ثابت خط_عمودي: ص8 = 0xBA؛           // ║
        
        // (AR) الصف العلوي
        ذاتي.انتقل(ص، س)؛
        ذاتي.اكتب_بايت(زاوية_علوية_يسرى)؛
        لكل _ في 0..(عرض - 2) {
            ذاتي.اكتب_بايت(خط_أفقي)؛
        }
        ذاتي.اكتب_بايت(زاوية_علوية_يمنى)؛
        
        // (AR) الصفوف الوسطى
        لكل صف في 1..(ارتفاع - 1) {
            ذاتي.انتقل(ص + صف، س)؛
            ذاتي.اكتب_بايت(خط_عمودي)؛
            ذاتي.انتقل(ص + صف، س + عرض - 1)؛
            ذاتي.اكتب_بايت(خط_عمودي)؛
        }
        
        // (AR) الصف السفلي
        ذاتي.انتقل(ص + ارتفاع - 1، س)؛
        ذاتي.اكتب_بايت(زاوية_سفلية_يسرى)؛
        لكل _ في 0..(عرض - 2) {
            ذاتي.اكتب_بايت(خط_أفقي)؛
        }
        ذاتي.اكتب_بايت(زاوية_سفلية_يمنى)؛
    }
    
    /**
     * (AR) رسم شريط تقدم
     */
    دالة عامة ارسم_تقدم(&متغير ذاتي، س: ص_حجم، ص: ص_حجم، عرض: ص_حجم، نسبة: ص8) {
        ذاتي.انتقل(ص، س)؛
        ذاتي.اكتب_بايت(b'[')؛
        
        دع ممتلئ = ((نسبة كـ ص_حجم) * (عرض - 2)) / 100؛
        
        لكل ي في 0..(عرض - 2) {
            إذا ي < ممتلئ {
                ذاتي.اكتب_بايت(0xDB)؛  // (AR) مربع ممتلئ █
            } وإلا {
                ذاتي.اكتب_بايت(0xB0)؛  // (AR) مربع فاتح ░
            }
        }
        
        ذاتي.اكتب_بايت(b']')؛
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) الكاتب العام
//                    (EN) Global Writer
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) كاتب VGA عام (singleton)
 *      يمكن استخدامه من أي مكان في البرنامج
 */
ثابت متغير كاتب_عام: اختيار<كاتب_VGA> = لا_شيء؛

/**
 * (AR) تهيئة الكاتب العام
 */
دالة عامة تهيئة() {
    غير_آمن {
        كاتب_عام = بعض(كاتب_VGA::جديد())؛
    }
}

/**
 * (AR) الحصول على الكاتب العام
 */
دالة عامة كاتب() -> &'ثابت متغير كاتب_VGA {
    غير_آمن {
        كاتب_عام.كـ_مرجع_متغير().توقع("VGA لم يتم تهيئته")
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) ماكرو الطباعة
//                    (EN) Print Macro
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) ماكرو للطباعة على شاشة VGA
 * 
 * مثال:
 * @code
 * اطبع!("مرحباً {}!"، "عالم")؛
 * اطبع_سطر!("القيمة = {}"، 42)؛
 * @endcode
 */
// ملاحظة: الماكرو يُعرَّف في محرك الماكرو الخاص بلغة ص

