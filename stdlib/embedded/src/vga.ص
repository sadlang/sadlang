        كاتب.عيّن_لون(كود_لون::جديد(لون_VGA::أصفر، لون_VGA::أسود))؛
        كاتب.انتقل(7، 30)؛
        كاتب.اكتب_نص("نظام ص")؛
        
        // (AR) رسالة الترحيب
        كاتب.عيّن_لون(كود_لون::افتراضي())؛
        كاتب.انتقل(10، 15)؛
        كاتب.اكتب_نص("جاري التحميل...")؛
        
        // (AR) شريط التقدم
        كاتب.انتقل(12، 15)؛
        كاتب.ارسم_تقدم(15، 12، 50، 75)؛
    }
