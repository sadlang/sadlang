#[cfg(test)]
وحدة اختبارات {
    استخدم super::*؛
    
    /**
     * (AR) مثال: التحكم في GPIO
     */
    #[اختبار]
    دالة مثال_gpio() {
        // (AR) تعريف سجل GPIO (مثال STM32)
        ثابت GPIOA_ODR: ص_مؤشر = 0x4002_0014؛
        
        // (AR) إنشاء سجل متطاير
        دع سجل = سجل_متطاير::<ص32>::جديد(GPIOA_ODR)؛
        
        // (AR) تشغيل LED على Pin 5
        سجل.عيّن_بتات(1 << 5)؛
        
        // (AR) إطفاء LED
        سجل.امسح_بتات(1 << 5)؛
        
        // (AR) قلب حالة LED
        سجل.اقلب_بتات(1 << 5)؛
    }
    
    /**
     * (AR) مثال: قراءة معرف المعالج
     */
    #[اختبار]
    #[cfg(target_arch = "arm")]
    دالة مثال_cpuid() {
        دع cpuid = سجل_قراءة::<ص32>::جديد(cortex_m::عنوان_CPUID)؛
        دع قيمة = cpuid.اقرأ()؛
        
        // (AR) استخراج الحقول
        دع implementer = (قيمة >> 24) & 0xFF؛
        دع variant = (قيمة >> 20) & 0x0F؛
        دع partno = (قيمة >> 4) & 0xFFF؛
        دع revision = قيمة & 0x0F؛
    }
}
