/**
 * (AR) نوع الوصول للسجل
 *      يحدد العمليات المسموح بها على السجل
 */
تعداد_أعلام نوع_وصول {
    قراءة = 0x01،     // (AR) قراءة فقط (RO)
    كتابة = 0x02،     // (AR) كتابة فقط (WO)
    قراءة_كتابة = 0x03،  // (AR) قراءة وكتابة (RW)
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) السجل المتطاير
//                    (EN) Volatile Register
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) سجل MMIO متطاير
 *      يضمن أن القراءة والكتابة لا يتم تحسينها من قبل المترجم
 * 
 * @param ن - نوع البيانات (ص8، ص16، ص32، ص64)
 * 
 * مثال:
 * @code
 * // تعريف سجل GPIO
 * دع سجل_بيانات: سجل_متطاير<ص32> = سجل_متطاير::جديد(0x4002_0014)؛
 * 
 * // قراءة القيمة
 * دع قيمة = سجل_بيانات.اقرأ()؛
 * 
 * // كتابة قيمة
 * سجل_بيانات.اكتب(0xFF)؛
 * @endcode
 */
هيكل سجل_متطاير<ن: نوع> {
    عنوان: ص_مؤشر،  // (AR) عنوان السجل في الذاكرة
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) تطبيق سجل_متطاير
//                    (EN) Volatile Register Implementation
// ═══════════════════════════════════════════════════════════════════════════════

تطبيق<ن: نوع> سجل_متطاير<ن> {
    /**
     * (AR) إنشاء سجل جديد
     *      ينشئ مرجع لسجل MMIO في العنوان المحدد
     * 
     * @param عنوان - عنوان السجل في الذاكرة
     * @returns سجل_متطاير جديد
     * 
     * تحذير: يجب أن يكون العنوان صالحاً ومحاذياً بشكل صحيح
     */
    #[مضمنة(دائماً)]
    دالة عامة جديد(عنوان: ص_مؤشر) -> ذاتي {
        سجل_متطاير { عنوان }
    }
    
    /**
     * (AR) قراءة قيمة من السجل
     *      تضمن أن القراءة تحدث فعلياً (volatile read)
     * 
     * @returns القيمة المقروءة من السجل
     */
    #[مضمنة(دائماً)]
    دالة عامة اقرأ(&ذاتي) -> ن {
        // (AR) استخدام تجميع مضمن للقراءة المتطايرة
        دع قيمة: ن؛
        غير_آمن {
            تجميع!(
                ""
                : "=r"(قيمة)
                : "m"(*(ذاتي.عنوان كـ *ن))
                :
                : "volatile"
            )؛
        }
        قيمة
    }
    
    /**
     * (AR) كتابة قيمة إلى السجل
     *      تضمن أن الكتابة تحدث فعلياً (volatile write)
     * 
     * @param قيمة - القيمة المراد كتابتها
     */
    #[مضمنة(دائماً)]
    دالة عامة اكتب(&ذاتي، قيمة: ن) {
        غير_آمن {
            تجميع!(
                ""
                :
                : "m"(*(ذاتي.عنوان كـ *ن متغير))، "r"(قيمة)
                :
                : "volatile"
            )؛
        }
    }
    
    /**
     * (AR) تعديل بتات محددة في السجل
     *      قراءة-تعديل-كتابة آمنة
     * 
     * @param قناع - البتات المراد تعديلها
     * @param قيمة - القيمة الجديدة للبتات
     */
    #[مضمنة(دائماً)]
    دالة عامة عدّل(&ذاتي، قناع: ن، قيمة: ن) {
        دع حالي = ذاتي.اقرأ()؛
        دع جديد = (حالي & !قناع) | (قيمة & قناع)؛
        ذاتي.اكتب(جديد)؛
    }
    
    /**
     * (AR) تعيين بتات (OR)
     *      يضيف البتات المحددة دون تغيير الباقي
     * 
     * @param بتات - البتات المراد تعيينها
     */
    #[مضمنة(دائماً)]
    دالة عامة عيّن_بتات(&ذاتي، بتات: ن) {
        دع حالي = ذاتي.اقرأ()؛
        ذاتي.اكتب(حالي | بتات)؛
    }
    
    /**
     * (AR) مسح بتات (AND NOT)
     *      يمسح البتات المحددة دون تغيير الباقي
     * 
     * @param بتات - البتات المراد مسحها
     */
    #[مضمنة(دائماً)]
    دالة عامة امسح_بتات(&ذاتي، بتات: ن) {
        دع حالي = ذاتي.اقرأ()؛
        ذاتي.اكتب(حالي & !بتات)؛
    }
    
    /**
     * (AR) قلب بتات (XOR)
     * 
     * @param بتات - البتات المراد قلبها
     */
    #[مضمنة(دائماً)]
    دالة عامة اقلب_بتات(&ذاتي، بتات: ن) {
        دع حالي = ذاتي.اقرأ()؛
        ذاتي.اكتب(حالي ^ بتات)؛
    }
    
    /**
     * (AR) فحص بت محدد
     * 
     * @param موقع - موقع البت (0-indexed)
     * @returns صحيح إذا كان البت معيناً
     */
    #[مضمنة(دائماً)]
    دالة عامة بت_معين(&ذاتي، موقع: ص32) -> منطقي {
        (ذاتي.اقرأ() >> موقع) & 1 != 0
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) سجل القراءة فقط
//                    (EN) Read-Only Register
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) سجل للقراءة فقط
 *      يمنع الكتابة على مستوى النوع
 */
هيكل سجل_قراءة<ن: نوع> {
    داخلي: سجل_متطاير<ن>،
}

تطبيق<ن: نوع> سجل_قراءة<ن> {
    /**
     * (AR) إنشاء سجل قراءة جديد
     */
    #[مضمنة(دائماً)]
    دالة عامة جديد(عنوان: ص_مؤشر) -> ذاتي {
        سجل_قراءة { داخلي: سجل_متطاير::جديد(عنوان) }
    }
    
    /**
     * (AR) قراءة القيمة
     */
    #[مضمنة(دائماً)]
    دالة عامة اقرأ(&ذاتي) -> ن {
        ذاتي.داخلي.اقرأ()
    }
    
    /**
     * (AR) فحص بت
     */
    #[مضمنة(دائماً)]
    دالة عامة بت_معين(&ذاتي، موقع: ص32) -> منطقي {
        ذاتي.داخلي.بت_معين(موقع)
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) سجل الكتابة فقط
//                    (EN) Write-Only Register
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) سجل للكتابة فقط
 *      يمنع القراءة على مستوى النوع
 */
هيكل سجل_كتابة<ن: نوع> {
    داخلي: سجل_متطاير<ن>،
}

تطبيق<ن: نوع> سجل_كتابة<ن> {
    /**
     * (AR) إنشاء سجل كتابة جديد
     */
    #[مضمنة(دائماً)]
    دالة عامة جديد(عنوان: ص_مؤشر) -> ذاتي {
        سجل_كتابة { داخلي: سجل_متطاير::جديد(عنوان) }
    }
    
    /**
     * (AR) كتابة قيمة
     */
    #[مضمنة(دائماً)]
    دالة عامة اكتب(&ذاتي، قيمة: ن) {
        ذاتي.داخلي.اكتب(قيمة)؛
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) كتلة السجلات
//                    (EN) Register Block
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) كتلة سجلات متتالية
 *      تمثل مجموعة سجلات لجهاز طرفي
 * 
 * مثال: GPIO على STM32
 * @code
 * // تعريف كتلة سجلات GPIO
 * هيكل سجلات_GPIO {
 *     MODER: سجل_متطاير<ص32>،    // 0x00
 *     OTYPER: سجل_متطاير<ص32>،   // 0x04
 *     OSPEEDR: سجل_متطاير<ص32>،  // 0x08
 *     PUPDR: سجل_متطاير<ص32>،    // 0x0C
 *     IDR: سجل_قراءة<ص32>،       // 0x10 (قراءة فقط)
 *     ODR: سجل_متطاير<ص32>،      // 0x14
 *     BSRR: سجل_كتابة<ص32>،      // 0x18 (كتابة فقط)
 *     LCKR: سجل_متطاير<ص32>،     // 0x1C
 * }
 * 
 * // الوصول للسجلات
 * دع GPIOA: &سجلات_GPIO = من_عنوان(0x4002_0000)؛
 * @endcode
 */
سمة كتلة_سجلات {
    /**
     * (AR) العنوان الأساسي للكتلة
     */
    دالة عنوان_أساسي() -> ص_مؤشر؛
    
    /**
     * (AR) حجم الكتلة بالبايت
     */
    دالة حجم() -> ص_حجم؛
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) ماكرو تعريف الطرفيات
//                    (EN) Peripheral Definition Macro
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) ماكرو لتعريف طرفي مع سجلاته
 * 
 * مثال:
 * @code
 * طرفي! GPIO_A في 0x4002_0000 {
 *     MODER @ 0x00: قراءة_كتابة ص32،
 *     IDR @ 0x10: قراءة ص32،
 *     ODR @ 0x14: قراءة_كتابة ص32،
 *     BSRR @ 0x18: كتابة ص32،
 * }
 * @endcode
 */

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) سجل الحقول
//                    (EN) Field Register
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) حقل داخل سجل
 *      يمثل مجموعة بتات متتالية داخل سجل
 */
هيكل حقل_سجل<ن: نوع> {
    سجل: سجل_متطاير<ن>،
    قناع: ن،
    إزاحة: ص32،
}

تطبيق<ن: نوع> حقل_سجل<ن> 
    حيث ن: عمليات_بت 
{
    /**
     * (AR) إنشاء حقل جديد
     * 
     * @param عنوان - عنوان السجل
     * @param موقع - موقع البت الأول للحقل
     * @param عرض - عدد البتات في الحقل
     */
    #[مضمنة(دائماً)]
    دالة عامة جديد(عنوان: ص_مؤشر، موقع: ص32، عرض: ص32) -> ذاتي {
        دع قناع = ((1 << عرض) - 1) << موقع؛
        حقل_سجل {
            سجل: سجل_متطاير::جديد(عنوان)،
            قناع: قناع كـ ن،
            إزاحة: موقع،
        }
    }
    
    /**
     * (AR) قراءة قيمة الحقل
     */
    #[مضمنة(دائماً)]
    دالة عامة اقرأ(&ذاتي) -> ن {
        (ذاتي.سجل.اقرأ() & ذاتي.قناع) >> ذاتي.إزاحة
    }
    
    /**
     * (AR) كتابة قيمة للحقل
     */
    #[مضمنة(دائماً)]
    دالة عامة اكتب(&ذاتي، قيمة: ن) {
        دع حالي = ذاتي.سجل.اقرأ() & !ذاتي.قناع؛
        دع جديد = حالي | ((قيمة << ذاتي.إزاحة) & ذاتي.قناع)؛
        ذاتي.سجل.اكتب(جديد)؛
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) حواجز الذاكرة
//                    (EN) Memory Barriers
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) حاجز القراءة
 *      يضمن اكتمال جميع القراءات السابقة
 */
#[مضمنة(دائماً)]
دالة عامة حاجز_قراءة() {
    #[cfg(target_arch = "arm")]
    غير_آمن {
        تجميع!("dmb" ::: "memory")؛
    }
    
    #[cfg(target_arch = "x86_64")]
    غير_آمن {
        تجميع!("lfence" ::: "memory")؛
    }
}

/**
 * (AR) حاجز الكتابة
 *      يضمن اكتمال جميع الكتابات السابقة
 */
#[مضمنة(دائماً)]
دالة عامة حاجز_كتابة() {
    #[cfg(target_arch = "arm")]
    غير_آمن {
        تجميع!("dmb st" ::: "memory")؛
    }
    
    #[cfg(target_arch = "x86_64")]
    غير_آمن {
        تجميع!("sfence" ::: "memory")؛
    }
}

/**
 * (AR) حاجز كامل
 *      يضمن اكتمال جميع العمليات السابقة
 */
#[مضمنة(دائماً)]
دالة عامة حاجز_ذاكرة() {
    #[cfg(target_arch = "arm")]
    غير_آمن {
        تجميع!("dmb" ::: "memory")؛
    }
    
    #[cfg(target_arch = "x86_64")]
    غير_آمن {
        تجميع!("mfence" ::: "memory")؛
    }
}

/**
 * (AR) حاجز التعليمات (ISB)
 *      يضمن تنفيذ جميع التعليمات السابقة قبل المتابعة
 */
#[مضمنة(دائماً)]
دالة عامة حاجز_تعليمات() {
    #[cfg(target_arch = "arm")]
    غير_آمن {
        تجميع!("isb" ::: "memory")؛
    }
    
    #[cfg(target_arch = "x86_64")]
    غير_آمن {
        // x86 لا يحتاج ISB صريح في معظم الحالات
        تجميع!("" ::: "memory")؛
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) عناوين شائعة (ARM Cortex-M)
//                    (EN) Common Addresses (ARM Cortex-M)
// ═══════════════════════════════════════════════════════════════════════════════

#[cfg(target_arch = "arm")]
وحدة cortex_m {
    /**
     * (AR) عناوين الطرفيات الخاصة بـ Cortex-M
     */
    
    // System Control Block (SCB)
    ثابت عام عنوان_SCB: ص_مؤشر = 0xE000_ED00؛
    ثابت عام عنوان_CPUID: ص_مؤشر = 0xE000_ED00؛
    ثابت عام عنوان_ICSR: ص_مؤشر = 0xE000_ED04؛
    ثابت عام عنوان_VTOR: ص_مؤشر = 0xE000_ED08؛
    ثابت عام عنوان_AIRCR: ص_مؤشر = 0xE000_ED0C؛
    
    // SysTick
    ثابت عام عنوان_SYST_CSR: ص_مؤشر = 0xE000_E010؛
    ثابت عام عنوان_SYST_RVR: ص_مؤشر = 0xE000_E014؛
    ثابت عام عنوان_SYST_CVR: ص_مؤشر = 0xE000_E018؛
    
    // NVIC
    ثابت عام عنوان_NVIC_ISER: ص_مؤشر = 0xE000_E100؛
    ثابت عام عنوان_NVIC_ICER: ص_مؤشر = 0xE000_E180؛
    ثابت عام عنوان_NVIC_ISPR: ص_مؤشر = 0xE000_E200؛
    ثابت عام عنوان_NVIC_ICPR: ص_مؤشر = 0xE000_E280؛
}

