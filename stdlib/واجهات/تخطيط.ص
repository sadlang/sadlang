# ─── مقطع ───────────────────────────────────────────────────────────
# مقطع في الصفحة — بطاقة تحتوي عمود مع عنوان
صدّر دالة مقطع(عنوان_القسم, تباعد_داخلي = 8)
    متغير ب = مكون("بطاقة", {"حشوة": 16, "حدود": 8})
    متغير ع = مكون("عمود", {"تباعد": تباعد_داخلي})
    عنصر_اضف(ع, مكون("نص", {"محتوى": عنوان_القسم, "حجم": 20, "لون": "#212121"}))
    عنصر_اضف(ع, مكون("خط_فاصل", {}))
    عنصر_اضف(ب, ع)
    ارجع ب
نهاية

