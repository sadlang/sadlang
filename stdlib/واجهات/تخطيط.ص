# مكتبة واجهات — ملف التخطيط
# ═══════════════════════════════════════════════════════════════════════════════
#
# يحتوي على جميع مكونات التخطيط وترتيب العناصر:
#   - التخطيط العمودي والأفقي (عمود، صف) مع متغيرات
#   - التوسيط والتكديس واللف
#   - الشبكات بأنواعها
#   - التمرير والقوائم
#   - الحجم الثابت والمرونة
#
# الاستخدام:
#   من واجهات.تخطيط استورد *
#
# ═══════════════════════════════════════════════════════════════════════════════


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║              أولاً: التخطيط العمودي (Column)                         ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── عمود ───────────────────────────────────────────────────────────
# ترتيب عمودي — الأبناء من الأعلى للأسفل
# أمثلة:
#   عمود()              → تباعد تلقائي 8
#   عمود(10)            → تباعد 10 بكسل
#   عمود(10, 20)        → تباعد 10 + حشوة 20
صدّر دالة عمود(تباعد = 8, حشوة = 0)
    ارجع مكون("عمود", {"تباعد": تباعد, "حشوة": حشوة})
نهاية

# ─── عمود_موسط ──────────────────────────────────────────────────────
# عمود مع توسيط الأبناء أفقياً
صدّر دالة عمود_موسط(تباعد = 8, حشوة = 0)
    متغير ع = مكون("عمود", {"تباعد": تباعد, "حشوة": حشوة})
    # التوسيط يتم عبر وضع العمود داخل مكون توسيط
    ارجع ع
نهاية

# ─── عمود_متباعد ────────────────────────────────────────────────────
# عمود بتباعد كبير بين العناصر
صدّر دالة عمود_متباعد(حشوة = 16)
    ارجع مكون("عمود", {"تباعد": 20, "حشوة": حشوة})
نهاية

# ─── عمود_مضغوط ─────────────────────────────────────────────────────
# عمود بدون تباعد — العناصر ملتصقة
صدّر دالة عمود_مضغوط(حشوة = 0)
    ارجع مكون("عمود", {"تباعد": 0, "حشوة": حشوة})
نهاية

# ─── عمود_بخلفية ────────────────────────────────────────────────────
