// ═══════════════════════════════════════════════════════════════════
// القسم ٥: تحريكات نابضية (Spring Physics)
// ─────────────────────────────────────────────────────────────────
// تحاكي فيزياء النابض الحقيقية — تعطي إحساساً طبيعياً جداً
//
// المعاملات:
//   صلابة: كلما زادت → حركة أسرع (الافتراضي: ١٨٠)
//   تخميد: كلما زاد → تذبذب أقل (الافتراضي: ١٢)
//   كتلة: كلما زادت → حركة أبطأ (الافتراضي: ١)
//
// أمثلة:
//   نابض_سريع() — صلابة عالية، تخميد عالي → حركة حادة
//   نابض_ناعم() — صلابة منخفضة، تخميد منخفض → تذبذب كثير
//   نابض_ثقيل() — كتلة كبيرة → حركة بطيئة وثقيلة
// ═══════════════════════════════════════════════════════════════════

// إنشاء تحريك نابضي
// الهدف: القيمة التي يجب الوصول إليها
دالة حركة_نابض(هدف, صلابة, تخميد, كتلة)
    أرجع تحريك_نابض(هدف, صلابة, تخميد, كتلة)
نهاية

// نابض بالإعدادات الافتراضية
دالة نابض(هدف)
    أرجع تحريك_نابض(هدف, 180, 12, 1)
نهاية

// نابض سريع — لاستجابة فورية
دالة نابض_سريع(هدف)
    أرجع تحريك_نابض(هدف, 400, 20, 0.5)
نهاية

// نابض ناعم — لحركة متذبذبة جميلة
دالة نابض_ناعم(هدف)
    أرجع تحريك_نابض(هدف, 100, 8, 1)
نهاية

// نابض ثقيل — لحركة بطيئة وثقيلة
دالة نابض_ثقيل(هدف)
    أرجع تحريك_نابض(هدف, 120, 15, 3)
نهاية


// ═══════════════════════════════════════════════════════════════════
// القسم ٦: أدوات التسهيل اليدوي
// ─────────────────────────────────────────────────────────────────
// لحساب قيم منحنيات التسهيل يدوياً (بدون تحريك كامل)
// مفيد لإنشاء تأثيرات مخصصة
// ═══════════════════════════════════════════════════════════════════

// حساب قيمة منحنى تسهيل يدوياً
// اسم: اسم المنحنى (مثل "ارتداد")
// ت: التقدم (٠.٠ إلى ١.٠)
// يُرجع: القيمة المحوَّلة
دالة احسب_تسهيل(اسم, ت)
    أرجع تسهيل(اسم, ت)
نهاية

// خلط خطي بين قيمتين
// أ: القيمة الأولى
// ب: القيمة الثانية
// ت: نسبة الخلط (٠ = أ بالكامل، ١ = ب بالكامل)
دالة اخلط(أ, ب, ت)
    أرجع أ + (ب - أ) * ت
نهاية

// خلط بمنحنى تسهيل
// مثل اخلط() لكن مع تطبيق منحنى تسهيل على ت
دالة اخلط_بتسهيل(أ, ب, ت, اسم_تسهيل)
    متغير ت_محول = تسهيل(اسم_تسهيل, ت)
    أرجع أ + (ب - أ) * ت_محول
نهاية


// ═══════════════════════════════════════════════════════════════════
// القسم ٧: دوال مساعدة متقدمة
// ═══════════════════════════════════════════════════════════════════

// تحريك وربط وتشغيل في سطر واحد
// ينشئ تحريكاً، يربطه بعنصر وخاصية، ويبدأه فوراً
//
// مثال:
//   حرّك(عنصري, "شفافية", 0, 255, 500, "سهولة_خروج")
//
دالة حرّك(عنصر, خاصية, من, إلى, مدة, تسهيل)
    متغير ح = تحريك_جديد(من, إلى, مدة, تسهيل)
    تحريك_ربط(ح, عنصر, خاصية)
    تحريك_شغل(ح)
    أرجع ح
نهاية

// نسخة بدون تسهيل
دالة حرّك_بسيط(عنصر, خاصية, من, إلى, مدة)
    متغير ح = تحريك_جديد(من, إلى, مدة, "سهولة")
    تحريك_ربط(ح, عنصر, خاصية)
    تحريك_شغل(ح)
    أرجع ح
نهاية

// تحريك مع تكرار لانهائي
دالة حرّك_مكرر(عنصر, خاصية, من, إلى, مدة, تسهيل)
    متغير ح = تحريك_جديد(من, إلى, مدة, تسهيل)
    تحريك_ربط(ح, عنصر, خاصية)
    تحريك_تكرار(ح, صحيح)
    تحريك_بندول(ح, صحيح)
    تحريك_شغل(ح)
    أرجع ح
نهاية

// تحريك مع تأخير
دالة حرّك_متأخر(عنصر, خاصية, من, إلى, مدة, تأخير, تسهيل)
    متغير ح = تحريك_جديد(من, إلى, مدة, تسهيل)
    تحريك_ربط(ح, عنصر, خاصية)
    تحريك_تأخير(ح, تأخير)
    تحريك_شغل(ح)
    أرجع ح
نهاية
