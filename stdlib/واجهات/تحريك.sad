// ═══════════════════════════════════════════════════════════════════════════════
// مكتبة التحريك — واجهات لغة ص
// ─────────────────────────────────────────────────────────────────────────────
//
// توفر واجهة عربية سهلة لنظام التحريك:
//   - تحريكات رقمية بمنحنيات تسهيل متعددة
//   - تحريكات ألوان
//   - تحريكات نابضية (فيزياء النابض)
//   - تحريكات جاهزة (ظهور، اختفاء، انزلاق، نبضة، اهتزاز)
//   - أدوات مساعدة للتحريك المتقدم
//
// الاستخدام:
//   من واجهات.تحريك استورد *
//
// مثال بسيط:
//   متغير ح = حركة_ظهور(عنصر_النص, 500)
//
// مثال متقدم:
//   متغير ح = حركة(0, 100, 1000, "ارتداد")
//   حركة_ربط(ح, عنصر, "ارتفاع")
//   حركة_شغل(ح)
//
// ═══════════════════════════════════════════════════════════════════════════════


// ═══════════════════════════════════════════════════════════════════
// القسم ١: إنشاء التحريكات الأساسية
// ─────────────────────────────────────────────────────────────────
// دوال غلاف (wrapper) للدوال المدمجة مع أسماء عربية واضحة
// ═══════════════════════════════════════════════════════════════════

// إنشاء تحريك رقمي
// من: قيمة البداية
// إلى: قيمة النهاية
// مدة: المدة بالمللي ثانية
// تسهيل: اسم منحنى التسهيل (اختياري، الافتراضي: "سهولة")
//
// أسماء التسهيل المتاحة:
//   "خطي"           — سرعة ثابتة
//   "سهولة_دخول"    — بداية بطيئة
//   "سهولة_خروج"    — نهاية بطيئة
//   "سهولة"          — بداية ونهاية بطيئة (الافتراضي)
//   "ارتداد"         — يرتد في النهاية كالكرة
//   "ارتداد_دخول"    — يرتد في البداية
//   "مرن"            — تذبذب نابضي في النهاية
//   "مرن_دخول"       — تذبذب نابضي في البداية
//   "رجوع"           — يتجاوز الهدف ثم يعود
//   "رجوع_دخول"      — يتراجع قبل الانطلاق
//   "دائري"          — منحنى دائري
//
دالة حركة(من, إلى, مدة, تسهيل)
    أرجع تحريك_جديد(من, إلى, مدة, تسهيل)
نهاية

// نسخة بدون تسهيل (يستخدم "سهولة" افتراضياً)
دالة حركة_بسيطة(من, إلى, مدة)
    أرجع تحريك_جديد(من, إلى, مدة, "سهولة")
نهاية


