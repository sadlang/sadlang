دالة حركة_انزلاق_يمين(عنصر, مسافة, مدة)
    أرجع انزلاق_يمين(عنصر, مسافة, مدة)
نهاية

دالة حركة_انزلاق_يسار(عنصر, مسافة, مدة)
    أرجع انزلاق_يسار(عنصر, مسافة, مدة)
نهاية

دالة حركة_انزلاق_أعلى(عنصر, مسافة, مدة)
    أرجع انزلاق_أعلى(عنصر, مسافة, مدة)
نهاية

دالة حركة_انزلاق_أسفل(عنصر, مسافة, مدة)
    أرجع انزلاق_أسفل(عنصر, مسافة, مدة)
