دالة حركة_منتهية(معرف)
    أرجع تحريك_اكتمل(معرف)
نهاية

// التقدم (٠ إلى ١)
دالة حركة_تقدم(معرف)
    أرجع تحريك_تقدم(معرف)
نهاية


// ═══════════════════════════════════════════════════════════════════
// القسم ٣: خيارات التحريك
// ═══════════════════════════════════════════════════════════════════

// تكرار لانهائي
دالة حركة_كرر(معرف)
    تحريك_تكرار(معرف, صحيح)
نهاية

// إيقاف التكرار
دالة حركة_لا_تكرر(معرف)
    تحريك_تكرار(معرف, خطأ)
نهاية

// ذهاب وإياب (مثل البندول)
دالة حركة_بندول(معرف)
    تحريك_بندول(معرف, صحيح)
نهاية

// تأخير قبل البدء (بالمللي ثانية)
دالة حركة_تأخير(معرف, مدة)
    تحريك_تأخير(معرف, مدة)
نهاية

// ربط التحريك بخاصية عنصر واجهة
// الخصائص المدعومة:
//   "شفافية"   — شفافية العنصر (٠-٢٥٥)
//   "عرض"      — عرض العنصر
//   "ارتفاع"   — ارتفاع العنصر
//   "حجم"      — حجم الخط
//   "حشوة"     — الحشوة الداخلية
//   "تباعد"    — المسافة بين الأبناء
//   "انحناء"   — انحناء الحواف
//   "حدود"     — سمك الحدود
//   "قيمة"     — قيمة (منزلق، شريط تقدم)
//   "تمرير"    — موضع التمرير
//   "مرونة"    — معامل المرونة (flex)
دالة حركة_ربط(معرف_حركة, معرف_عنصر, خاصية)
    تحريك_ربط(معرف_حركة, معرف_عنصر, خاصية)
نهاية

// حذف تحريك
دالة حركة_حذف(معرف)
    تحريك_حذف(معرف)
نهاية

// حذف جميع التحريكات
دالة مسح_كل_الحركات()
    مسح_تحريكات()
نهاية


// ═══════════════════════════════════════════════════════════════════
// القسم ٤: تحريكات جاهزة
// ─────────────────────────────────────────────────────────────────
// تحريكات شائعة بسطر واحد — تُنشئ التحريك وتبدأ فوراً
// ═══════════════════════════════════════════════════════════════════

// ── ظهور تدريجي ──
// يُظهر عنصراً بتأثير تلاشي (من شفاف إلى معتم)
// مثال: حركة_ظهور(عنصر_النص)
// مثال: حركة_ظهور(عنصر_النص, 500)  // نصف ثانية
دالة حركة_ظهور(عنصر, مدة)
    أرجع ظهور(عنصر, مدة)
نهاية

// نسخة بدون مدة (٣٠٠ مللي ثانية افتراضي)
دالة اظهر(عنصر)
    أرجع ظهور(عنصر, 300)
نهاية

// ── اختفاء تدريجي ──
// يُخفي عنصراً بتأثير تلاشي (من معتم إلى شفاف)
دالة حركة_اختفاء(عنصر, مدة)
    أرجع اختفاء(عنصر, مدة)
نهاية

دالة اخفِ(عنصر)
    أرجع اختفاء(عنصر, 300)
نهاية

