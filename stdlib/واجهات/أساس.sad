# بسم الله الرحمن الرحيم
# ═══════════════════════════════════════════════════════════════════════════════
# مكتبة واجهات — ملف المكونات الأساسية
# ═══════════════════════════════════════════════════════════════════════════════
#
# هذا الملف يحتوي على المكونات الأساسية لبناء واجهات المستخدم:
#   - النصوص بأنواعها (نص، عنوان، تسمية، فقرة، رابط، كود، اقتباس)
#   - الأزرار بأنواعها (عادي، محيط، نصي، أيقونة، عائم، تبديل، مجموعة)
#   - العناصر البصرية (أيقونة، صورة رمزية، شارة، رقاقة، وسم)
#   - الحاويات الأساسية (حاوية، بطاقة، فاصل، مسافة)
#   - مكونات مركبة جاهزة (بطاقة نص، بطاقة رقم، صف أزرار...)
#
# الاستخدام:
#   من واجهات.أساس استورد *
#
# ═══════════════════════════════════════════════════════════════════════════════


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║                     أولاً: مكونات النصوص                              ║
# ║  تشمل 7 أنواع أساسية + 8 متغيرات = 15 مكون نصي                      ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── نص ─────────────────────────────────────────────────────────────
# نص عادي — المكون الأكثر استخداماً
# المعاملات: محتوى (إجباري)، مقاس (اختياري=20)، لون (اختياري)
# أمثلة:
#   نص("مرحباً بالعالم")
#   نص("مرحباً", 24)
#   نص("مرحباً", 24, "#FF0000")
صدّر دالة نص(محتوى, مقاس = 20, لون = "#333333")
    ارجع مكون("نص", {"محتوى": محتوى, "حجم": مقاس, "لون": لون})
نهاية

# ─── نص_عريض ────────────────────────────────────────────────────────
# نص بخط عريض (يُحاكى بزيادة حجم الخط قليلاً + لون أغمق)
صدّر دالة نص_عريض(محتوى, مقاس = 20, لون = "#212121")
    ارجع مكون("نص", {"محتوى": محتوى, "حجم": مقاس + 1, "لون": لون})
نهاية

# ─── نص_خافت ────────────────────────────────────────────────────────
# نص بلون خافت — مناسب للتفاصيل الثانوية
صدّر دالة نص_خافت(محتوى, مقاس = 16)
    ارجع مكون("نص", {"محتوى": محتوى, "حجم": مقاس, "لون": "#9E9E9E"})
نهاية

# ─── نص_ملون ────────────────────────────────────────────────────────
# نص بلون مخصص — اختصار لتحديد اللون بسرعة
صدّر دالة نص_ملون(محتوى, لون, مقاس = 20)
    ارجع مكون("نص", {"محتوى": محتوى, "حجم": مقاس, "لون": لون})
نهاية

# ─── نص_صغير ────────────────────────────────────────────────────────
# نص بحجم صغير — مناسب للحواشي والتعليقات
صدّر دالة نص_صغير(محتوى, لون = "#757575")
    ارجع مكون("نص", {"محتوى": محتوى, "حجم": 12, "لون": لون})
نهاية

# ─── نص_كبير ────────────────────────────────────────────────────────
# نص بحجم كبير — مناسب للأرقام والإحصائيات البارزة
صدّر دالة نص_كبير(محتوى, لون = "#212121")
    ارجع مكون("نص", {"محتوى": محتوى, "حجم": 36, "لون": لون})
نهاية

# ─── عنوان ──────────────────────────────────────────────────────────
# عنوان رئيسي — يدعم 4 مستويات (1=أكبر، 4=أصغر)
# أمثلة:
#   عنوان("الصفحة الرئيسية")         → مستوى 1 (حجم 32)
#   عنوان("قسم فرعي", 2)             → مستوى 2 (حجم 26)
#   عنوان("عنوان صغير", 3)           → مستوى 3 (حجم 22)
#   عنوان("أصغر عنوان", 4)           → مستوى 4 (حجم 18)
صدّر دالة عنوان(محتوى, مستوى = 1)
    متغير مقاس = 32
    اذا (مستوى == 2)
        مقاس = 26
    والا اذا (مستوى == 3)
        مقاس = 22
    والا اذا (مستوى == 4)
        مقاس = 18
    نهاية
    ارجع مكون("عنوان", {"محتوى": محتوى, "مستوى": مستوى, "حجم": مقاس})
نهاية

# ─── عنوان_ملون ─────────────────────────────────────────────────────
# عنوان بلون مخصص
صدّر دالة عنوان_ملون(محتوى, لون, مستوى = 1)
    متغير مقاس = 32
    اذا (مستوى == 2)
        مقاس = 26
    والا اذا (مستوى == 3)
        مقاس = 22
    نهاية
    ارجع مكون("عنوان", {"محتوى": محتوى, "مستوى": مستوى, "حجم": مقاس, "لون": لون})
نهاية

# ─── تسمية ──────────────────────────────────────────────────────────
# تسمية — نص صغير رمادي مناسب لتسمية الحقول والعناصر
صدّر دالة تسمية(محتوى, لون = "#757575")
    ارجع مكون("تسمية", {"محتوى": محتوى, "حجم": 14, "لون": لون})
نهاية

# ─── تسمية_مطلوبة ───────────────────────────────────────────────────
# تسمية مع علامة * حمراء تدل على أن الحقل مطلوب
صدّر دالة تسمية_مطلوبة(محتوى)
    ارجع مكون("تسمية", {"محتوى": محتوى + " *", "حجم": 14, "لون": "#D32F2F"})
نهاية

# ─── فقرة ───────────────────────────────────────────────────────────
# فقرة نصية — مناسبة للنصوص الطويلة والشروحات
صدّر دالة فقرة(محتوى)
    ارجع مكون("فقرة", {"محتوى": محتوى, "حجم": 16, "لون": "#424242"})
نهاية

# ─── رابط ───────────────────────────────────────────────────────────
# نص بنمط رابط (لون أزرق)
صدّر دالة رابط(محتوى, لون = "#1565C0")
    ارجع مكون("رابط", {"محتوى": محتوى, "حجم": 16, "لون": لون})
نهاية

# ─── كود ────────────────────────────────────────────────────────────
# عرض كود برمجي بخلفية رمادية
صدّر دالة كود(محتوى)
    ارجع مكون("كود", {"محتوى": محتوى, "حجم": 14})
نهاية

# ─── اقتباس ────────────────────────────────────────────────────────
# نص مقتبس بخط جانبي
صدّر دالة اقتباس(محتوى)
    ارجع مكون("اقتباس", {"محتوى": محتوى, "حجم": 16})
نهاية


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║                        ثانياً: الأزرار                                ║
# ║  تشمل 7 أنواع أساسية + 8 متغيرات = 15 مكون زر                       ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── زر ─────────────────────────────────────────────────────────────
# زر عادي مملوء باللون — النوع الأكثر استخداماً
# المعاملات: نص_الزر (إجباري)، لون (اختياري)
# أمثلة:
#   زر("اضغط هنا")
#   زر("حفظ", "#4CAF50")
#   زر("حذف", "#F44336")
صدّر دالة زر(نص_الزر, لون = "#1976D2")
    ارجع مكون("زر", {"محتوى": نص_الزر, "لون_زر": لون, "حدود": 8})
نهاية

# ─── زر_نجاح ────────────────────────────────────────────────────────
# زر أخضر — للعمليات الإيجابية (حفظ، تأكيد، إضافة)
صدّر دالة زر_نجاح(نص_الزر)
    ارجع مكون("زر", {"محتوى": نص_الزر, "لون_زر": "#4CAF50", "حدود": 8})
نهاية

# ─── زر_خطر ─────────────────────────────────────────────────────────
# زر أحمر — للعمليات الخطيرة (حذف، إلغاء، رفض)
صدّر دالة زر_خطر(نص_الزر)
    ارجع مكون("زر", {"محتوى": نص_الزر, "لون_زر": "#F44336", "حدود": 8})
نهاية

# ─── زر_تحذير ───────────────────────────────────────────────────────
# زر برتقالي — للتحذيرات
صدّر دالة زر_تحذير(نص_الزر)
    ارجع مكون("زر", {"محتوى": نص_الزر, "لون_زر": "#FF9800", "حدود": 8})
نهاية

# ─── زر_محيط ────────────────────────────────────────────────────────
# زر بإطار فقط بدون خلفية ملونة — للأوامر الثانوية
صدّر دالة زر_محيط(نص_الزر, لون = "#1976D2")
    ارجع مكون("زر_محيط", {"محتوى": نص_الزر, "لون_زر": لون, "حدود": 8})
نهاية

# ─── زر_نصي ─────────────────────────────────────────────────────────
# زر بنص فقط بدون خلفية — للأوامر الأقل أهمية
صدّر دالة زر_نصي(نص_الزر, لون = "#1976D2")
    ارجع مكون("زر_نصي", {"محتوى": نص_الزر, "لون": لون})
نهاية

# ─── زر_ايقونة ──────────────────────────────────────────────────────
# زر دائري بأيقونة — للأوامر السريعة (حذف، تعديل، إضافة)
صدّر دالة زر_ايقونة(رمز, لون = "#1976D2")
    ارجع مكون("زر_ايقونة", {"ايقونة": رمز, "لون_زر": لون})
نهاية

# ─── زر_عائم ────────────────────────────────────────────────────────
# زر عائم (FAB) — العمل الرئيسي في الصفحة
صدّر دالة زر_عائم(رمز, لون = "#FF9800")
    ارجع مكون("زر_عائم", {"ايقونة": رمز, "لون_زر": لون})
نهاية

# ─── زر_تبديل ───────────────────────────────────────────────────────
# زر قابل للتبديل (مفعّل/معطّل) — لخيارات التصفية مثلاً
صدّر دالة زر_تبديل(نص_الزر, لون = "#1976D2")
    ارجع مكون("زر_تبديل", {"محتوى": نص_الزر, "لون_زر": لون})
نهاية

# ─── زر_كامل_العرض ──────────────────────────────────────────────────
# زر يمتد بكامل العرض — مناسب لنماذج تسجيل الدخول
صدّر دالة زر_كامل_العرض(نص_الزر, لون = "#1976D2")
    متغير ز = مكون("زر", {"محتوى": نص_الزر, "لون_زر": لون, "حدود": 8})
    خصائص(ز, {"مرونة": 1})
    ارجع ز
نهاية

# ─── مجموعة_أزرار ───────────────────────────────────────────────────
# حاوية لعدة أزرار — تُرتبها أفقياً
صدّر دالة مجموعة_أزرار()
    ارجع مكون("مجموعة_أزرار", {"تباعد": 8})
نهاية


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║                    ثالثاً: العناصر البصرية                             ║
# ║  تشمل أيقونات، صور رمزية، شارات، رقاقات، وسوم                       ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── ايقونة ─────────────────────────────────────────────────────────
# أيقونة رمزية — تعرض حرف واحد كأيقونة
# أمثلة: ايقونة("★")  ايقونة("♥")  ايقونة("✓")
صدّر دالة ايقونة(رمز)
    ارجع مكون("ايقونة", {"ايقونة": رمز})
نهاية

# ─── صورة_رمزية ─────────────────────────────────────────────────────
# دائرة ملونة بحرف في وسطها — لعرض صورة المستخدم
# أمثلة:
#   صورة_رمزية("أ")
#   صورة_رمزية("م", "#E91E63")
صدّر دالة صورة_رمزية(حرف, لون = "#1976D2")
    ارجع مكون("صورة_رمزية", {"محتوى": حرف, "خلفية": لون})
نهاية

# ─── صورة_رمزية_كبيرة ───────────────────────────────────────────────
# صورة رمزية بحجم أكبر — لصفحات البروفايل
صدّر دالة صورة_رمزية_كبيرة(حرف, لون = "#1976D2")
    متغير ص = مكون("صورة_رمزية", {"محتوى": حرف, "خلفية": لون})
    خصائص(ص, {"عرض": 80, "ارتفاع": 80, "حجم": 36})
    ارجع ص
نهاية

# ─── شارة ───────────────────────────────────────────────────────────
# دائرة صغيرة بعدد — للإشعارات والعدادات
صدّر دالة شارة(عدد)
    ارجع مكون("شارة", {"قيمة": عدد})
نهاية

# ─── رقاقة ──────────────────────────────────────────────────────────
# عنصر صغير مستطيل — لعرض الوسوم والفئات
# أمثلة:
#   رقاقة("نشط", "#4CAF50")
#   رقاقة("جديد", "#FF9800")
صدّر دالة رقاقة(نص_ر, لون = "#E0E0E0")
    ارجع مكون("رقاقة", {"محتوى": نص_ر, "خلفية": لون})
نهاية

# ─── رقاقة_نجاح ────────────────────────────────────────────────────
# رقاقة خضراء جاهزة
صدّر دالة رقاقة_نجاح(نص_ر)
    ارجع مكون("رقاقة", {"محتوى": نص_ر, "خلفية": "#C8E6C9"})
نهاية

# ─── رقاقة_خطر ─────────────────────────────────────────────────────
# رقاقة حمراء جاهزة
صدّر دالة رقاقة_خطر(نص_ر)
    ارجع مكون("رقاقة", {"محتوى": نص_ر, "خلفية": "#FFCDD2"})
نهاية

# ─── رقاقة_معلومات ─────────────────────────────────────────────────
# رقاقة زرقاء جاهزة
صدّر دالة رقاقة_معلومات(نص_ر)
    ارجع مكون("رقاقة", {"محتوى": نص_ر, "خلفية": "#BBDEFB"})
نهاية

# ─── وسم ────────────────────────────────────────────────────────────
# وسم ملون — مثل الرقاقة لكن بلون أكثر تميزاً
صدّر دالة وسم(نص_و, لون = "#2196F3")
    ارجع مكون("وسم", {"محتوى": نص_و, "خلفية": لون})
نهاية

# ─── نقطة_حالة ──────────────────────────────────────────────────────
# دائرة صغيرة ملونة — حالة فورية (متصل/غير متصل)
# أمثلة:
#   نقطة_حالة("#4CAF50")   → نقطة خضراء (متصل)
#   نقطة_حالة("#F44336")   → نقطة حمراء (غير متصل)
صدّر دالة نقطة_حالة(لون)
    متغير ألوان = لون
    متغير ق = ألوان
    ارجع مكون("نقطة_حالة", {"خلفية": ق})
نهاية

# ─── صندوق_لون ──────────────────────────────────────────────────────
# مربع ملون — لعرض عينات الألوان
صدّر دالة صندوق_لون(لون, عرض = 40, ارتفاع = 40)
    ارجع مكون("صندوق_لون", {"خلفية": لون, "عرض": عرض, "ارتفاع": ارتفاع})
نهاية

# ─── صورة ───────────────────────────────────────────────────────────
# عنصر صورة — يعرض نص بديل حالياً
صدّر دالة صورة(بديل)
    ارجع مكون("صورة", {"محتوى": بديل})
نهاية

# ─── فاصل_بصري ──────────────────────────────────────────────────────
# فاصل عمودي أو أفقي — خط رفيع
صدّر دالة فاصل_بصري()
    ارجع مكون("فاصل", {})
نهاية


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║                  رابعاً: الحاويات الأساسية                             ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── حاوية ──────────────────────────────────────────────────────────
# حاوية عامة — أساس كل شيء
صدّر دالة حاوية(حشوة = 0)
    ارجع مكون("حاوية", {"حشوة": حشوة})
نهاية

# ─── حاوية_ملونة ────────────────────────────────────────────────────
# حاوية بلون خلفية
صدّر دالة حاوية_ملونة(لون, حشوة = 16)
    ارجع مكون("حاوية", {"خلفية": لون, "حشوة": حشوة, "حدود": 8})
نهاية

# ─── حاوية_محددة ────────────────────────────────────────────────────
# حاوية بحدود — لتمييز منطقة معينة
صدّر دالة حاوية_محددة(لون_حدود = "#E0E0E0", حشوة = 12)
    متغير ح = مكون("حاوية", {"حشوة": حشوة, "حدود": 8})
    خصائص(ح, {"سمك_حدود": 1})
    ارجع ح
نهاية

# ─── بطاقة ──────────────────────────────────────────────────────────
# بطاقة مرفوعة — للمحتوى المهم
صدّر دالة بطاقة(حشوة = 12, حدود = 8)
    ارجع مكون("بطاقة", {"حشوة": حشوة, "حدود": حدود})
نهاية

# ─── خط_فاصل ────────────────────────────────────────────────────────
# خط فاصل أفقي
صدّر دالة خط_فاصل()
    ارجع مكون("خط_فاصل", {})
نهاية

# ─── مسافة ──────────────────────────────────────────────────────────
# فراغ بين العناصر بحجم محدد
صدّر دالة مسافة(مقاس = 16)
    ارجع مكون("فاصل", {"ارتفاع": مقاس})
نهاية


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║                 خامساً: مكونات مركبة جاهزة                            ║
# ║  تنشئ تراكيب شائعة من المكونات الأساسية                               ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── بطاقة_نص ───────────────────────────────────────────────────────
# بطاقة جاهزة بعنوان ومحتوى نصي
صدّر دالة بطاقة_نص(عنوان_البطاقة, محتوى_البطاقة)
    متغير ب = بطاقة(12, 8)
    متغير ع = مكون("عمود", {"تباعد": 6})
    عنصر_اضف(ع, نص(عنوان_البطاقة, 22, "#212121"))
    عنصر_اضف(ع, نص(محتوى_البطاقة, 16, "#646464"))
    عنصر_اضف(ب, ع)
    ارجع ب
نهاية

# ─── بطاقة_رقم ──────────────────────────────────────────────────────
# بطاقة إحصائية — تسمية + رقم بارز
صدّر دالة بطاقة_رقم(تسمية_ر, الرقم, لون_ر = "#1976D2")
    متغير ب = بطاقة(16, 12)
    متغير ع = مكون("عمود", {"تباعد": 4})
    عنصر_اضف(ع, نص(تسمية_ر, 14, "#757575"))
    عنصر_اضف(ع, نص(لنص(الرقم), 36, لون_ر))
    عنصر_اضف(ب, ع)
    ارجع ب
نهاية

# ─── بطاقة_مستخدم ───────────────────────────────────────────────────
# بطاقة بروفايل مستخدم — صورة رمزية + اسم + وصف
صدّر دالة بطاقة_مستخدم(الاسم, الوصف, حرف_الرمز, لون_الرمز = "#1976D2")
    متغير ب = بطاقة(16, 12)
    متغير ص = مكون("صف", {"تباعد": 12})
    عنصر_اضف(ص, صورة_رمزية(حرف_الرمز, لون_الرمز))
    متغير ع = مكون("عمود", {"تباعد": 2})
    عنصر_اضف(ع, نص(الاسم, 18, "#212121"))
    عنصر_اضف(ع, نص(الوصف, 14, "#757575"))
    عنصر_اضف(ص, ع)
    عنصر_اضف(ب, ص)
    ارجع ب
نهاية

# ─── بطاقة_منتج ─────────────────────────────────────────────────────
# بطاقة منتج — صورة + اسم + سعر + زر شراء
صدّر دالة بطاقة_منتج(اسم_المنتج, السعر, لون_المنتج = "#E3F2FD")
    متغير ب = بطاقة(12, 12)
    متغير ع = مكون("عمود", {"تباعد": 8})
    عنصر_اضف(ع, حاوية_ملونة(لون_المنتج, 24))
    عنصر_اضف(ع, نص(اسم_المنتج, 18, "#212121"))
    عنصر_اضف(ع, نص(السعر, 22, "#4CAF50"))
    عنصر_اضف(ع, زر("اشتري الآن", "#FF9800"))
    عنصر_اضف(ب, ع)
    ارجع ب
نهاية

# ─── بطاقة_اجراء ────────────────────────────────────────────────────
# بطاقة بزر إجراء — عنوان + وصف + زر
صدّر دالة بطاقة_اجراء(عنوان_الاجراء, الوصف, نص_الزر_اج, لون_الزر_اج = "#1976D2")
    متغير ب = بطاقة(16, 12)
    متغير ع = مكون("عمود", {"تباعد": 8})
    عنصر_اضف(ع, نص(عنوان_الاجراء, 20, "#212121"))
    عنصر_اضف(ع, نص(الوصف, 14, "#757575"))
    عنصر_اضف(ع, زر(نص_الزر_اج, لون_الزر_اج))
    عنصر_اضف(ب, ع)
    ارجع ب
نهاية

# ─── صف_ازرار ───────────────────────────────────────────────────────
# صف يحتوي زرين متجاورين
صدّر دالة صف_ازرار(نص1, نص2, لون1 = "#1976D2", لون2 = "#757575")
    متغير ص = مكون("صف", {"تباعد": 8})
    عنصر_اضف(ص, زر(نص1, لون1))
    عنصر_اضف(ص, زر(نص2, لون2))
    ارجع ص
نهاية

# ─── صف_ازرار_ثلاثي ─────────────────────────────────────────────────
# صف يحتوي ثلاثة أزرار
صدّر دالة صف_ازرار_ثلاثي(نص1, نص2, نص3, لون1 = "#4CAF50", لون2 = "#FF9800", لون3 = "#F44336")
    متغير ص = مكون("صف", {"تباعد": 8})
    عنصر_اضف(ص, زر(نص1, لون1))
    عنصر_اضف(ص, زر(نص2, لون2))
    عنصر_اضف(ص, زر(نص3, لون3))
    ارجع ص
نهاية

# ─── عنصر_مع_ايقونة ─────────────────────────────────────────────────
# صف: أيقونة + نص — لعرض معلومة مع رمز
صدّر دالة عنصر_مع_ايقونة(رمز, محتوى_النص, مقاس_نص = 16)
    متغير ص = مكون("صف", {"تباعد": 8})
    عنصر_اضف(ص, نص(رمز, مقاس_نص + 4, "#1976D2"))
    عنصر_اضف(ص, نص(محتوى_النص, مقاس_نص))
    ارجع ص
نهاية

# ─── رأس_قسم ────────────────────────────────────────────────────────
# عنوان قسم مع خط فاصل تحته
صدّر دالة رأس_قسم(محتوى_الرأس)
    متغير ع = مكون("عمود", {"تباعد": 4})
    عنصر_اضف(ع, نص(محتوى_الرأس, 22, "#212121"))
    عنصر_اضف(ع, خط_فاصل())
    ارجع ع
نهاية

# ─── زوج_قيمة ───────────────────────────────────────────────────────
# صف: تسمية + قيمة — لعرض أزواج المعلومات
صدّر دالة زوج_قيمة(المفتاح, القيمة_نص)
    متغير ص = مكون("صف", {"تباعد": 8})
    عنصر_اضف(ص, نص(المفتاح, 14, "#757575"))
    عنصر_اضف(ص, نص(القيمة_نص, 14, "#212121"))
    ارجع ص
نهاية


