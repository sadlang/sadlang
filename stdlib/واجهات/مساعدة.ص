        نهاية
        متغير د = مكون("حاوية", {"لون_خلفية": اللون_خ, "حدود": 15, "عرض": 30, "ارتفاع": 30})
        عنصر_اضف(د, مكون("نص", {"محتوى": لنص(خ), "لون": "#FFFFFF", "حجم": 14}))
        عنصر_اضف(ص, د)
        اذا (خ < 3)
            عنصر_اضف(ص, مكون("حاوية", {"لون_خلفية": اللون_خ, "عرض": 40, "ارتفاع": 3}))
        نهاية
        خ = خ + 1
