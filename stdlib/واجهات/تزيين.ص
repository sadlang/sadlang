    متغير ح = مكون("حاوية", {"لون_خلفية": لون_خلف, "حدود": القطر / 2, "عرض": القطر, "ارتفاع": القطر})
    عنصر_اضف(ح, مكون("نص", {"محتوى": الأحرف, "لون": "#FFFFFF", "حجم": القطر / 2}))
    ارجع ح
نهاية

