# ── 11. مواقيت_صلاة — جدول الصلوات الخمس ─────────────────────────────

صدّر دالة مواقيت_صلاة(الفجر_وقت, الشروق_وقت, الظهر_وقت, العصر_وقت, المغرب_وقت, العشاء_وقت, الصلاة_الحالية = "")
    متغير ب_مواقيت = مكون("بطاقة", {"حدود": 12, "حشوة": 16})
    متغير ع_مواقيت = مكون("عمود", {"تباعد": 8})
    # العنوان
    متغير رأس_موا = مكون("حاوية", {"لون_خلفية": "#1B5E20", "حدود": 10, "حشوة": 12})
    متغير ص_عنو = مكون("صف", {"تباعد": 8})
    عنصر_اضف(ص_عنو, مكون("نص", {"محتوى": "🕌", "حجم": 24}))
    عنصر_اضف(ص_عنو, مكون("نص", {"محتوى": "مواقيت الصلاة", "حجم": 20, "لون": "#FFFFFF"}))
    عنصر_اضف(رأس_موا, ص_عنو)
    عنصر_اضف(ع_مواقيت, رأس_موا)
    # الصلوات — بناء يدوي لتفادي مشاكل الحلقات في السياق المستورد
    متغير صف_فجر = مكون("صف", {"تباعد": 12, "حشوة": 8})
    عنصر_اضف(صف_فجر, مكون("نص", {"محتوى": "🌙 الفجر", "حجم": 16, "لون": "#212121"}))
