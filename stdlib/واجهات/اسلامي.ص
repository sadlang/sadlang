# ── 1. عرض_آية — آية قرآنية مع رقمها وتشكيل ──────────────────────────

صدّر دالة عرض_آية(نص_الآية, رقم_الآية = 0, اسم_السورة = "")
    متغير ب_آية = مكون("بطاقة", {"حدود": 12, "حشوة": 20, "لون_خلفية": "#FFF8E1"})
    متغير ع_آية = مكون("عمود", {"تباعد": 12})
    # زخرفة علوية
    عنصر_اضف(ع_آية, مكون("نص", {"محتوى": "﴿", "حجم": 24, "لون": "#BF360C"}))
    # نص الآية
    عنصر_اضف(ع_آية, مكون("نص", {"محتوى": نص_الآية, "حجم": 28, "لون": "#1B5E20"}))
    # زخرفة سفلية مع رقم الآية
    متغير ص_سفلي = مكون("صف", {"تباعد": 12})
    عنصر_اضف(ص_سفلي, مكون("نص", {"محتوى": "﴾", "حجم": 24, "لون": "#BF360C"}))
    اذا (رقم_الآية > 0)
        عنصر_اضف(ص_سفلي, مكون("نص", {"محتوى": "﴿" + لنص(رقم_الآية) + "﴾", "حجم": 16, "لون": "#795548"}))
    نهاية
    اذا (اسم_السورة != "")
        عنصر_اضف(ص_سفلي, مكون("نص", {"محتوى": "سورة " + اسم_السورة, "حجم": 14, "لون": "#8D6E63"}))
    نهاية
    عنصر_اضف(ع_آية, ص_سفلي)
    عنصر_اضف(ب_آية, ع_آية)
    ارجع ب_آية
نهاية


# ── 2. بطاقة_سورة — بطاقة معلومات سورة ───────────────────────────────

صدّر دالة بطاقة_سورة(الرقم_س, الاسم_س, عدد_آيات_س, نزول_س = "مكية", الترتيب_س = 0)
    متغير ب_سورة = مكون("بطاقة", {"حدود": 10, "حشوة": 14})
    متغير ص_سورة = مكون("صف", {"تباعد": 12})
    # رقم السورة (دائرة)
    متغير دائرة_رقم = مكون("حاوية", {"لون_خلفية": "#1B5E20", "حدود": 20, "عرض": 40, "ارتفاع": 40})
    عنصر_اضف(دائرة_رقم, مكون("نص", {"محتوى": لنص(الرقم_س), "حجم": 16, "لون": "#FFFFFF"}))
    عنصر_اضف(ص_سورة, دائرة_رقم)
    # معلومات السورة
    متغير ع_معلومات = مكون("عمود", {"تباعد": 2})
    عنصر_اضف(ع_معلومات, مكون("نص", {"محتوى": الاسم_س, "حجم": 18, "لون": "#1B5E20"}))
    عنصر_اضف(ع_معلومات, مكون("نص", {"محتوى": لنص(عدد_آيات_س) + " آية — " + نزول_س, "حجم": 12, "لون": "#757575"}))
    عنصر_اضف(ص_سورة, ع_معلومات)
    عنصر_اضف(ب_سورة, ص_سورة)
    ارجع ب_سورة
نهاية


