# ── 8. شريط_تقدم_ختمة — تقدم ختم القرآن ─────────────────────────────

صدّر دالة شريط_تقدم_ختمة(الصفحات_المقروءة = 0, اجمالي_الصفحات = 604)
    متغير نسبة_تق = 0
    اذا (اجمالي_الصفحات > 0)
        نسبة_تق = (الصفحات_المقروءة * 100) / اجمالي_الصفحات
    نهاية
    متغير ب_ختمة = مكون("بطاقة", {"حدود": 12, "حشوة": 16, "لون_خلفية": "#E8F5E9"})
    متغير ع_ختمة = مكون("عمود", {"تباعد": 8})
    عنصر_اضف(ع_ختمة, مكون("نص", {"محتوى": "📖 تقدم الختمة", "حجم": 18, "لون": "#1B5E20"}))
    عنصر_اضف(ع_ختمة, مكون("شريط_تقدم", {"قيمة": نسبة_تق}))
    متغير ص_تق = مكون("صف", {"تباعد": 16})
    عنصر_اضف(ص_تق, مكون("نص", {"محتوى": لنص(الصفحات_المقروءة) + " / " + لنص(اجمالي_الصفحات) + " صفحة", "حجم": 14, "لون": "#2E7D32"}))
