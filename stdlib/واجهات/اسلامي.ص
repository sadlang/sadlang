صدّر دالة زخرفة_اسلامية(نمط_الزخرفة = "نجمة", لون_الزخرفة = "#1B5E20")
    متغير ب_زخرفة = مكون("حاوية", {"حشوة": 8})
    متغير ص_زخرفة = مكون("صف", {"تباعد": 2})
    متغير رمز_ز = "✦"
    اذا (نمط_الزخرفة == "نجمة")
        رمز_ز = "✦"
    نهاية
    اذا (نمط_الزخرفة == "وردة")
        رمز_ز = "❁"
    نهاية
    اذا (نمط_الزخرفة == "هلال")
        رمز_ز = "☪"
    نهاية
    اذا (نمط_الزخرفة == "ماسة")
        رمز_ز = "◆"
    نهاية
    متغير ز_ف = 0
