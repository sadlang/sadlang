# ║  4. جدول_زمني_مشاريع — Gantt Chart عربي                            ║
# ╚═══════════════════════════════════════════════════════════════════════╝

صدّر دالة جدول_زمني_مشاريع(عنوان_المشروع)
    متغير ب_غ = مكون("بطاقة", {"حدود": 8, "حشوة": 16})
    متغير ع_غ = مكون("عمود", {"تباعد": 8})
    عنصر_اضف(ع_غ, مكون("نص", {"محتوى": "📊 " + عنوان_المشروع, "حجم": 20, "لون": "#1565C0"}))
    # رأس الجدول (أيام)
    متغير رأس = مكون("صف", {"تباعد": 2})
    عنصر_اضف(رأس, مكون("حاوية", {"عرض": 120, "حشوة": 4}))
    متغير يوم = 1
    طالما (يوم <= 7)
        متغير خلية_يوم = مكون("حاوية", {"لون_خلفية": "#E3F2FD", "عرض": 40, "حشوة": 4})
        عنصر_اضف(خلية_يوم, مكون("نص", {"محتوى": "ي" + لنص(يوم), "حجم": 10, "لون": "#1565C0"}))
        عنصر_اضف(رأس, خلية_يوم)
        يوم = يوم + 1
    نهاية
    عنصر_اضف(ع_غ, رأس)
    عنصر_اضف(ب_غ, ع_غ)
    ارجع ب_غ
نهاية

# إضافة مهمة لجدول زمني — اسم + بداية + نهاية + لون
صدّر دالة مهمة_مشروع(الجدول, اسم_المهمة, بداية_يوم, نهاية_يوم, لون_مهمة = "#1976D2")
    متغير ص_مهمة = مكون("صف", {"تباعد": 2})
    # اسم المهمة
    متغير خلية_اسم = مكون("حاوية", {"عرض": 120, "حشوة": 4})
    عنصر_اضف(خلية_اسم, مكون("نص", {"محتوى": اسم_المهمة, "حجم": 12, "لون": "#424242"}))
    عنصر_اضف(ص_مهمة, خلية_اسم)
    # الشريط الزمني
    متغير خ = 1
    طالما (خ <= 7)
        متغير لون_خلية = "#FAFAFA"
        اذا (خ >= بداية_يوم و خ <= نهاية_يوم)
            لون_خلية = لون_مهمة
        نهاية
        عنصر_اضف(ص_مهمة, مكون("حاوية", {"لون_خلفية": لون_خلية, "عرض": 40, "ارتفاع": 24, "حدود": 2}))
        خ = خ + 1
    نهاية
    عنصر_اضف(الجدول, ص_مهمة)
نهاية


