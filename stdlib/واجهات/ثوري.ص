# ║  5. مشغل_موجات — عارض موجات صوتية بأشرطة                          ║
# ╚═══════════════════════════════════════════════════════════════════════╝

صدّر دالة مشغل_موجات(عنوان_الصوت = "ملف صوتي", المدة = "3:45")
    متغير ب_صوت = مكون("بطاقة", {"حدود": 12, "حشوة": 16, "لون_خلفية": "#263238"})
    متغير ع_صوت = مكون("عمود", {"تباعد": 12})
    عنصر_اضف(ع_صوت, مكون("نص", {"محتوى": عنوان_الصوت, "حجم": 16, "لون": "#ECEFF1"}))
    # الموجات (أشرطة عشوائية)
    متغير ص_موجات = مكون("صف", {"تباعد": 2})
    متغير ارتفاعات = [20, 35, 15, 45, 30, 50, 25, 40, 18, 48, 22, 38, 28, 42, 16, 44, 32, 36, 20, 46, 24, 40, 30, 34, 14]
    متغير مج = 0
    طالما (مج < 25)
        عنصر_اضف(ص_موجات, مكون("حاوية", {"لون_خلفية": "#4FC3F7", "عرض": 4, "ارتفاع": ارتفاعات[مج], "حدود": 2}))
        مج = مج + 1
    نهاية
    عنصر_اضف(ع_صوت, ص_موجات)
    # أزرار التحكم
    متغير ص_تحكم = مكون("صف", {"تباعد": 16})
    عنصر_اضف(ص_تحكم, مكون("نص", {"محتوى": "0:00", "حجم": 12, "لون": "#90A4AE"}))
    عنصر_اضف(ص_تحكم, مكون("زر", {"محتوى": "⏮", "لون_زر": "#455A64", "حدود": 20, "المعرف": "صوت_سابق"}))
    عنصر_اضف(ص_تحكم, مكون("زر", {"محتوى": "▶", "لون_زر": "#4FC3F7", "حدود": 24, "المعرف": "صوت_تشغيل"}))
    عنصر_اضف(ص_تحكم, مكون("زر", {"محتوى": "⏭", "لون_زر": "#455A64", "حدود": 20, "المعرف": "صوت_تالي"}))
    عنصر_اضف(ص_تحكم, مكون("نص", {"محتوى": المدة, "حجم": 12, "لون": "#90A4AE"}))
    عنصر_اضف(ع_صوت, ص_تحكم)
    عنصر_اضف(ب_صوت, ع_صوت)
    ارجع ب_صوت
نهاية


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  6. خريطة_حرارية — Heatmap بمصفوفة بيانات                          ║
# ╚═══════════════════════════════════════════════════════════════════════╝

صدّر دالة خريطة_حرارية(العنوان_خ, صفوف_خ = 7, اعمدة_خ = 7)
    متغير ب_حرارة = مكون("بطاقة", {"حدود": 8, "حشوة": 16})
    متغير ع_حرارة = مكون("عمود", {"تباعد": 8})
    عنصر_اضف(ع_حرارة, مكون("نص", {"محتوى": العنوان_خ, "حجم": 18, "لون": "#212121"}))
    # الشبكة الحرارية
    متغير صف_ح = 0
    طالما (صف_ح < صفوف_خ)
        متغير ص_خ = مكون("صف", {"تباعد": 2})
        متغير عمود_ح = 0
        طالما (عمود_ح < اعمدة_خ)
            # ألوان متدرجة حسب الموضع
            متغير شدة = ((صف_ح * اعمدة_خ + عمود_ح) * 37) % 5
            متغير لون_ح = "#E8F5E9"
            اذا (شدة == 1)
                لون_ح = "#A5D6A7"
            نهاية
            اذا (شدة == 2)
                لون_ح = "#66BB6A"
            نهاية
            اذا (شدة == 3)
                لون_ح = "#2E7D32"
            نهاية
            اذا (شدة == 4)
                لون_ح = "#1B5E20"
            نهاية
            عنصر_اضف(ص_خ, مكون("حاوية", {"لون_خلفية": لون_ح, "عرض": 26, "ارتفاع": 26, "حدود": 3}))
            عمود_ح = عمود_ح + 1
        نهاية
        عنصر_اضف(ع_حرارة, ص_خ)
        صف_ح = صف_ح + 1
    نهاية
    # مفتاح الألوان
    متغير مفتاح = مكون("صف", {"تباعد": 4})
    عنصر_اضف(مفتاح, مكون("نص", {"محتوى": "أقل", "حجم": 10, "لون": "#9E9E9E"}))
    عنصر_اضف(مفتاح, مكون("حاوية", {"لون_خلفية": "#E8F5E9", "عرض": 16, "ارتفاع": 16, "حدود": 2}))
    عنصر_اضف(مفتاح, مكون("حاوية", {"لون_خلفية": "#66BB6A", "عرض": 16, "ارتفاع": 16, "حدود": 2}))
    عنصر_اضف(مفتاح, مكون("حاوية", {"لون_خلفية": "#1B5E20", "عرض": 16, "ارتفاع": 16, "حدود": 2}))
    عنصر_اضف(مفتاح, مكون("نص", {"محتوى": "أكثر", "حجم": 10, "لون": "#9E9E9E"}))
    عنصر_اضف(ع_حرارة, مفتاح)
    عنصر_اضف(ب_حرارة, ع_حرارة)
    ارجع ب_حرارة
نهاية


