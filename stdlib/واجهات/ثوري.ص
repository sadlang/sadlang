# ║  2. لوحة_رسم_حر — منطقة رسم بأدوات                                ║
# ╚═══════════════════════════════════════════════════════════════════════╝

صدّر دالة لوحة_رسم_حر(عرض_اللوحة = 600, ارتفاع_اللوحة = 400)
    متغير ب_جذر = مكون("بطاقة", {"حدود": 8})
    متغير ع_رئيسي = مكون("عمود", {"تباعد": 0})
    # شريط الأدوات
    متغير ادوات = مكون("حاوية", {"لون_خلفية": "#F5F5F5", "حشوة": 8})
    متغير ص_ادوات = مكون("صف", {"تباعد": 6})
    عنصر_اضف(ص_ادوات, مكون("زر", {"محتوى": "✏️ قلم", "لون_زر": "#1976D2", "حدود": 6, "المعرف": "اداة_قلم"}))
    عنصر_اضف(ص_ادوات, مكون("زر", {"محتوى": "⬜ مربع", "لون_زر": "#757575", "حدود": 6, "المعرف": "اداة_مربع"}))
    عنصر_اضف(ص_ادوات, مكون("زر", {"محتوى": "⭕ دائرة", "لون_زر": "#757575", "حدود": 6, "المعرف": "اداة_دائرة"}))
    عنصر_اضف(ص_ادوات, مكون("زر", {"محتوى": "📏 خط", "لون_زر": "#757575", "حدود": 6, "المعرف": "اداة_خط"}))
    عنصر_اضف(ص_ادوات, مكون("زر", {"محتوى": "🗑️ مسح", "لون_زر": "#F44336", "حدود": 6, "المعرف": "اداة_مسح"}))
    عنصر_اضف(ادوات, ص_ادوات)
    عنصر_اضف(ع_رئيسي, ادوات)
    # لوحة الرسم
    متغير لوحة_ر = مكون("حاوية", {"لون_خلفية": "#FFFFFF", "عرض": عرض_اللوحة, "ارتفاع": ارتفاع_اللوحة, "لون_حدود": "#E0E0E0"})
    عنصر_اضف(لوحة_ر, مكون("نص", {"محتوى": "🎨 ارسم هنا", "لون": "#BDBDBD", "حجم": 24}))
    عنصر_اضف(ع_رئيسي, لوحة_ر)
    # شريط الألوان
    متغير الوان = مكون("حاوية", {"لون_خلفية": "#FAFAFA", "حشوة": 8})
    متغير ص_الوان = مكون("صف", {"تباعد": 4})
    متغير قائمة_الوان = ["#000000", "#F44336", "#4CAF50", "#2196F3", "#FF9800", "#9C27B0", "#795548", "#607D8B"]
    متغير ف = 0
    طالما (ف < 8)
        عنصر_اضف(ص_الوان, مكون("حاوية", {"لون_خلفية": قائمة_الوان[ف], "عرض": 24, "ارتفاع": 24, "حدود": 12}))
        ف = ف + 1
    نهاية
    عنصر_اضف(الوان, ص_الوان)
    عنصر_اضف(ع_رئيسي, الوان)
    عنصر_اضف(ب_جذر, ع_رئيسي)
    ارجع ب_جذر
نهاية


