# ║  3. مخطط_عقلي — Mind Map بعقد وروابط                               ║
# ╚═══════════════════════════════════════════════════════════════════════╝

صدّر دالة مخطط_عقلي(العنوان_المع, فروع = [])
    متغير ح_خ = مكون("بطاقة", {"حدود": 12, "حشوة": 20, "لون_خلفية": "#F3E5F5"})
    متغير ع_خ = مكون("عمود", {"تباعد": 16})
    # العقدة المركزية
    متغير مركز = مكون("حاوية", {"لون_خلفية": "#6A1B9A", "حدود": 20, "حشوة": 16})
    عنصر_اضف(مركز, مكون("نص", {"محتوى": العنوان_المع, "لون": "#FFFFFF", "حجم": 20}))
    عنصر_اضف(ع_خ, مركز)
    # الفروع
    متغير ص_فروع = مكون("صف", {"تباعد": 12})
    متغير فه = 0
    طالما (فه < 6 و فه < #فروع)
        متغير فرع = مكون("حاوية", {"لون_خلفية": "#CE93D8", "حدود": 12, "حشوة": 10})
        عنصر_اضف(فرع, مكون("نص", {"محتوى": فروع[فه], "لون": "#4A148C", "حجم": 14}))
        عنصر_اضف(ص_فروع, فرع)
        فه = فه + 1
    نهاية
    عنصر_اضف(ع_خ, ص_فروع)
    عنصر_اضف(ح_خ, ع_خ)
    ارجع ح_خ
نهاية


