# ║  1. محرر_كود_مباشر — محرر أكواد مع تلوين وأرقام أسطر              ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# محرر كود مع سطور مرقمة وخلفية داكنة — يحاكي VS Code
صدّر دالة محرر_كود_مباشر(الكود = "", اللغة = "sad", عدد_اسطر = 15)
    متغير ح_جذر = مكون("بطاقة", {"حدود": 8, "حشوة": 0})
    # شريط عنوان المحرر
    متغير شريط = مكون("حاوية", {"لون_خلفية": "#1E1E1E", "حشوة": 8})
    متغير ص_شريط = مكون("صف", {"تباعد": 8})
    عنصر_اضف(ص_شريط, مكون("نص", {"محتوى": "●", "لون": "#FF5F56", "حجم": 10}))
    عنصر_اضف(ص_شريط, مكون("نص", {"محتوى": "●", "لون": "#FFBD2E", "حجم": 10}))
    عنصر_اضف(ص_شريط, مكون("نص", {"محتوى": "●", "لون": "#27C93F", "حجم": 10}))
    عنصر_اضف(ص_شريط, مكون("نص", {"محتوى": "  " + اللغة, "لون": "#858585", "حجم": 12}))
    عنصر_اضف(شريط, ص_شريط)
    عنصر_اضف(ح_جذر, شريط)
    # منطقة الكود
    متغير منطقة_ك = مكون("حاوية", {"لون_خلفية": "#1E1E1E", "حشوة": 12})
    متغير ص_كود = مكون("صف", {"تباعد": 12})
    # عمود أرقام الأسطر
    متغير ع_ارقام = مكون("عمود", {"تباعد": 2})
    متغير سطر_ر = 1
    طالما (سطر_ر <= عدد_اسطر)
        عنصر_اضف(ع_ارقام, مكون("نص", {"محتوى": لنص(سطر_ر), "لون": "#858585", "حجم": 13}))
        سطر_ر = سطر_ر + 1
    نهاية
    عنصر_اضف(ص_كود, ع_ارقام)
    # عمود الكود نفسه
    متغير ع_كود = مكون("عمود", {"تباعد": 2})
    عنصر_اضف(ع_كود, مكون("نص", {"محتوى": الكود, "لون": "#D4D4D4", "حجم": 13}))
    عنصر_اضف(ص_كود, ع_كود)
    عنصر_اضف(منطقة_ك, ص_كود)
    عنصر_اضف(ح_جذر, منطقة_ك)
    # شريط الحالة السفلي
    متغير حالة_س = مكون("حاوية", {"لون_خلفية": "#007ACC", "حشوة": 4})
    متغير ص_حالة = مكون("صف", {"تباعد": 16})
    عنصر_اضف(ص_حالة, مكون("نص", {"محتوى": "سطر 1، عمود 1", "لون": "#FFFFFF", "حجم": 11}))
    عنصر_اضف(ص_حالة, مكون("نص", {"محتوى": "UTF-8", "لون": "#FFFFFF", "حجم": 11}))
    عنصر_اضف(ص_حالة, مكون("نص", {"محتوى": اللغة, "لون": "#FFFFFF", "حجم": 11}))
    عنصر_اضف(حالة_س, ص_حالة)
    عنصر_اضف(ح_جذر, حالة_س)
    ارجع ح_جذر
نهاية


