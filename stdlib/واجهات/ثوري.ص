                لون_قر = "#000000"
            والا
                اذا ((صف_قر + عمود_قر) % 3 == 0)
                    لون_قر = "#000000"
                نهاية
            نهاية
            عنصر_اضف(ص_قر, مكون("حاوية", {"لون_خلفية": لون_قر, "عرض": 12, "ارتفاع": 12}))
            عمود_قر = عمود_قر + 1
        نهاية
        عنصر_اضف(شبكة_رمز, ص_قر)
        صف_قر = صف_قر + 1
    نهاية
    عنصر_اضف(ع_رمز, شبكة_رمز)
    عنصر_اضف(ع_رمز, مكون("نص", {"محتوى": البيانات_رمز, "حجم": 11, "لون": "#757575"}))
    عنصر_اضف(ب_رمز, ع_رمز)
    ارجع ب_رمز
