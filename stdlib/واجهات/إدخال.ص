# ─── حقل_مع_تسمية ───────────────────────────────────────────────────
# حقل إدخال مع تسمية فوقه — يُضاف تلقائياً للأب
# يُرجع معرّف الحقل (لقراءة النص لاحقاً)
# مثال:
#   متغير حقل_الاسم = حقل_مع_تسمية("الاسم الكامل", "أدخل اسمك", العمود)
#   متغير النص = نص_حقل(حقل_الاسم)
صدّر دالة حقل_مع_تسمية(نص_التسمية, تلميح_الحقل, اب)
    عنصر_اضف(اب, مكون("تسمية", {"محتوى": نص_التسمية, "حجم": 14, "لون": "#505050"}))
    متغير ح = حقل(تلميح_الحقل)
    عنصر_اضف(اب, ح)
    ارجع ح
نهاية

