# ─── نموذج ──────────────────────────────────────────────────────────
# حاوية نموذج — بطاقة بعمود منسق لحقول الإدخال
# تُرجع عمود الحقول لإضافة المكونات إليه
# مثال:
#   متغير ن = نموذج("تسجيل الدخول")
#   متغير حقل_اسم = حقل_مع_تسمية("الاسم", "أدخل اسمك", ن)
صدّر دالة نموذج(عنوان_النموذج = "")
    متغير ع = مكون("عمود", {"تباعد": 10, "حشوة": 20})
    اذا (عنوان_النموذج != "")
        عنصر_اضف(ع, مكون("نص", {"محتوى": عنوان_النموذج, "حجم": 24, "لون": "#212121"}))
        عنصر_اضف(ع, مكون("خط_فاصل", {}))
    نهاية
    ارجع ع
نهاية

# ─── نموذج_بطاقة ────────────────────────────────────────────────────
# نموذج داخل بطاقة
صدّر دالة نموذج_بطاقة(عنوان_النموذج = "")
    متغير ب = مكون("بطاقة", {"حشوة": 20, "حدود": 12})
    متغير ع = مكون("عمود", {"تباعد": 10})
    اذا (عنوان_النموذج != "")
        عنصر_اضف(ع, مكون("نص", {"محتوى": عنوان_النموذج, "حجم": 24, "لون": "#212121"}))
        عنصر_اضف(ع, مكون("خط_فاصل", {}))
    نهاية
    عنصر_اضف(ب, ع)
    ارجع ع
نهاية

# ─── نموذج_تسجيل_دخول ──────────────────────────────────────────────
# نموذج تسجيل دخول جاهز — يُرجع [حقل_مستخدم, حقل_مرور, زر_دخول]
صدّر دالة نموذج_تسجيل_دخول(اب)
    متغير ع = مكون("عمود", {"تباعد": 12, "حشوة": 24})

    # العنوان
    عنصر_اضف(ع, مكون("نص", {"محتوى": "تسجيل الدخول", "حجم": 28, "لون": "#1976D2"}))
    عنصر_اضف(ع, مكون("خط_فاصل", {}))

    # حقل المستخدم
    عنصر_اضف(ع, مكون("تسمية", {"محتوى": "اسم المستخدم", "حجم": 14, "لون": "#505050"}))
    متغير ح_مستخدم = حقل("أدخل اسم المستخدم")
    عنصر_اضف(ع, ح_مستخدم)

    # حقل المرور
    عنصر_اضف(ع, مكون("تسمية", {"محتوى": "كلمة المرور", "حجم": 14, "لون": "#505050"}))
    متغير ح_مرور = حقل_سر("أدخل كلمة المرور")
    عنصر_اضف(ع, ح_مرور)

    # زر الدخول
    متغير ز_دخول = مكون("زر", {"محتوى": "دخول", "لون_زر": "#1976D2", "حدود": 8})
    عنصر_اضف(ع, ز_دخول)

    عنصر_اضف(اب, ع)
    ارجع [ح_مستخدم, ح_مرور, ز_دخول]
نهاية

# ─── نموذج_تسجيل ────────────────────────────────────────────────────
# نموذج تسجيل حساب جديد — يُرجع [حقل_اسم, حقل_ايميل, حقل_مرور, حقل_تأكيد, زر_تسجيل]
صدّر دالة نموذج_تسجيل(اب)
    متغير ع = مكون("عمود", {"تباعد": 10, "حشوة": 24})

    عنصر_اضف(ع, مكون("نص", {"محتوى": "حساب جديد", "حجم": 28, "لون": "#1976D2"}))
    عنصر_اضف(ع, مكون("خط_فاصل", {}))

    عنصر_اضف(ع, مكون("تسمية", {"محتوى": "الاسم الكامل *", "حجم": 14, "لون": "#D32F2F"}))
    متغير ح_اسم = حقل("أدخل اسمك الكامل")
    عنصر_اضف(ع, ح_اسم)

    عنصر_اضف(ع, مكون("تسمية", {"محتوى": "البريد الإلكتروني *", "حجم": 14, "لون": "#D32F2F"}))
    متغير ح_ايميل = حقل("example@email.com")
    عنصر_اضف(ع, ح_ايميل)

    عنصر_اضف(ع, مكون("تسمية", {"محتوى": "كلمة المرور *", "حجم": 14, "لون": "#D32F2F"}))
    متغير ح_مرور2 = حقل_سر("6 أحرف على الأقل")
    عنصر_اضف(ع, ح_مرور2)

    عنصر_اضف(ع, مكون("تسمية", {"محتوى": "تأكيد كلمة المرور *", "حجم": 14, "لون": "#D32F2F"}))
    متغير ح_تأكيد = حقل_سر("أعد كتابة كلمة المرور")
    عنصر_اضف(ع, ح_تأكيد)

    متغير ز_تسجيل = مكون("زر", {"محتوى": "إنشاء حساب", "لون_زر": "#4CAF50", "حدود": 8})
    عنصر_اضف(ع, ز_تسجيل)

    عنصر_اضف(اب, ع)
    ارجع [ح_اسم, ح_ايميل, ح_مرور2, ح_تأكيد, ز_تسجيل]
نهاية


