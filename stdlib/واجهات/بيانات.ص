    متغير ب = مكون("بطاقة", {"حشوة": 12, "حدود": 8})
    متغير ع = مكون("عمود", {"تباعد": 8})
    عنصر_اضف(ع, مكون("نص", {"محتوى": عنوان_الجدول, "حجم": 18, "لون": "#212121"}))
    عنصر_اضف(ع, مكون("خط_فاصل", {}))
    متغير ج = جدول_بسيط(عدد_اعمدة)
    عنصر_اضف(ع, ج)
    عنصر_اضف(ب, ع)
    عنصر_اضف(اب, ب)
    ارجع ج
