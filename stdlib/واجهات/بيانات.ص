# ─── بطاقة_احصائية ──────────────────────────────────────────────────
# بطاقة عرض إحصائية — تسمية + رقم + نسبة تغير
صدّر دالة بطاقة_احصائية(التسمية, الرقم, التغيير = "", لون_التغيير = "#4CAF50")
    متغير ب = مكون("بطاقة", {"حشوة": 16, "حدود": 12})
    متغير ع = مكون("عمود", {"تباعد": 4})
    عنصر_اضف(ع, مكون("نص", {"محتوى": التسمية, "حجم": 13, "لون": "#757575"}))
    عنصر_اضف(ع, مكون("نص", {"محتوى": لنص(الرقم), "حجم": 32, "لون": "#212121"}))
    اذا (التغيير != "")
        عنصر_اضف(ع, مكون("نص", {"محتوى": التغيير, "حجم": 13, "لون": لون_التغيير}))
    نهاية
    عنصر_اضف(ب, ع)
    ارجع ب
نهاية

# ─── بطاقة_نسبة ─────────────────────────────────────────────────────
# بطاقة بشريط تقدم — تسمية + نسبة مئوية + شريط
صدّر دالة بطاقة_نسبة(التسمية, النسبة, لون_الشريط = "#1976D2")
    متغير ب = مكون("بطاقة", {"حشوة": 16, "حدود": 12})
    متغير ع = مكون("عمود", {"تباعد": 6})
    متغير ص = مكون("صف", {"تباعد": 8})
    عنصر_اضف(ص, مكون("نص", {"محتوى": التسمية, "حجم": 14, "لون": "#424242"}))
    عنصر_اضف(ص, مكون("نص", {"محتوى": لنص(النسبة) + "%", "حجم": 14, "لون": لون_الشريط}))
    عنصر_اضف(ع, ص)
    متغير شريط = مكون("شريط_تقدم", {"قيمة": النسبة})
    عنصر_اضف(ع, شريط)
    عنصر_اضف(ب, ع)
    ارجع ب
نهاية

# ─── لوحة_احصائيات ──────────────────────────────────────────────────
