# ─── عنصر_قائمة ─────────────────────────────────────────────────────
# عنصر في قائمة بيانات — عنوان + وصف فرعي
# مثال: عنصر_قائمة("أحمد محمد", "مدير المشروع")
صدّر دالة عنصر_قائمة(عنوان_العنصر, وصف_العنصر = "")
    ارجع مكون("عنصر_بيانات", {"محتوى": عنوان_العنصر, "عنوان_فرعي": وصف_العنصر})
نهاية

# ─── عنصر_قائمة_غني ─────────────────────────────────────────────────
# عنصر قائمة مع أيقونة — صورة رمزية + عنوان + وصف
صدّر دالة عنصر_قائمة_غني(حرف_رمزي, عنوان_العنصر, وصف_العنصر, لون_الرمز = "#1976D2")
    متغير ص = مكون("صف", {"تباعد": 12, "حشوة": 8})
    عنصر_اضف(ص, مكون("صورة_رمزية", {"محتوى": حرف_رمزي, "خلفية": لون_الرمز}))
    متغير ع = مكون("عمود", {"تباعد": 2})
    عنصر_اضف(ع, مكون("نص", {"محتوى": عنوان_العنصر, "حجم": 16, "لون": "#212121"}))
    اذا (وصف_العنصر != "")
        عنصر_اضف(ع, مكون("نص", {"محتوى": وصف_العنصر, "حجم": 13, "لون": "#757575"}))
    نهاية
    عنصر_اضف(ص, ع)
    ارجع ص
نهاية

