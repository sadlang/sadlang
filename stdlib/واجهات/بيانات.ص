    عنصر_اضف(ش, بطاقة_احصائية(ت2, ر2))
    عنصر_اضف(ش, بطاقة_احصائية(ت3, ر3))
    عنصر_اضف(ش, بطاقة_احصائية(ت4, ر4))
    ارجع ش
