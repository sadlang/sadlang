# ╔═══════════════════════════════════════════════════════════════════════╗
# ║             سادساً: لوحات الألوان وأدوات مساعدة                        ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── لوحة_مادية ─────────────────────────────────────────────────────
# ألوان المادية (Material) — إرجاع لون حسب الاسم
صدّر دالة لوحة_مادية(اسم_اللون)
    اذا (اسم_اللون == "أحمر")
        ارجع "#F44336"
    نهاية
    اذا (اسم_اللون == "وردي")
        ارجع "#E91E63"
    نهاية
    اذا (اسم_اللون == "بنفسجي")
        ارجع "#9C27B0"
    نهاية
    اذا (اسم_اللون == "نيلي")
        ارجع "#3F51B5"
    نهاية
    اذا (اسم_اللون == "أزرق")
        ارجع "#2196F3"
    نهاية
    اذا (اسم_اللون == "سماوي")
        ارجع "#00BCD4"
    نهاية
    اذا (اسم_اللون == "أخضر")
        ارجع "#4CAF50"
    نهاية
    اذا (اسم_اللون == "أصفر")
        ارجع "#FFEB3B"
    نهاية
    اذا (اسم_اللون == "برتقالي")
        ارجع "#FF9800"
    نهاية
    اذا (اسم_اللون == "بني")
        ارجع "#795548"
    نهاية
    اذا (اسم_اللون == "رمادي")
        ارجع "#9E9E9E"
    نهاية
    ارجع "#000000"
نهاية

# ─── لون_فاتح ───────────────────────────────────────────────────────
# إرجاع نسخة فاتحة من اللون الأساسي
صدّر دالة لون_فاتح(اسم_اللون)
    اذا (اسم_اللون == "أحمر")
        ارجع "#FFCDD2"
    نهاية
    اذا (اسم_اللون == "أزرق")
        ارجع "#BBDEFB"
    نهاية
    اذا (اسم_اللون == "أخضر")
        ارجع "#C8E6C9"
    نهاية
    اذا (اسم_اللون == "برتقالي")
        ارجع "#FFE0B2"
    نهاية
    اذا (اسم_اللون == "بنفسجي")
        ارجع "#E1BEE7"
    نهاية
    ارجع "#F5F5F5"
نهاية

# ─── لون_داكن ───────────────────────────────────────────────────────
# إرجاع نسخة داكنة من اللون الأساسي
صدّر دالة لون_داكن(اسم_اللون)
    اذا (اسم_اللون == "أحمر")
        ارجع "#B71C1C"
    نهاية
    اذا (اسم_اللون == "أزرق")
        ارجع "#0D47A1"
    نهاية
    اذا (اسم_اللون == "أخضر")
        ارجع "#1B5E20"
    نهاية
    اذا (اسم_اللون == "برتقالي")
        ارجع "#E65100"
    نهاية
    اذا (اسم_اللون == "بنفسجي")
        ارجع "#4A148C"
    نهاية
    ارجع "#212121"
نهاية


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║           سابعاً: تطبيق السمات على مكونات                             ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── تطبيق_سمة ──────────────────────────────────────────────────────
# تطبيق سمة — إرجاع التطبيق بالسمة المختارة
صدّر دالة تطبيق_سمة(السمة)
    ارجع السمة
نهاية

# ─── نص_بسمة ────────────────────────────────────────────────────────
# نص يستخدم ألوان السمة تلقائياً
صدّر دالة نص_بسمة(المحتوى, السمة)
    ارجع مكون("نص", {"محتوى": المحتوى, "حجم": 16, "لون": "#212121"})
نهاية

# ─── عنوان_بسمة ─────────────────────────────────────────────────────
# عنوان يستخدم ألوان السمة
صدّر دالة عنوان_بسمة(المحتوى, السمة)
    ارجع مكون("نص", {"محتوى": المحتوى, "حجم": 24, "لون": "#1976D2"})
نهاية

# ─── زر_بسمة ────────────────────────────────────────────────────────
# زر يستخدم الألوان الرئيسية للسمة
صدّر دالة زر_بسمة(المحتوى, السمة)
    ارجع مكون("زر", {"محتوى": المحتوى, "لون_زر": "#1976D2", "حدود": 8})
نهاية

# ─── بطاقة_بسمة ─────────────────────────────────────────────────────
# بطاقة تستخدم ألوان السمة
صدّر دالة بطاقة_بسمة(السمة)
    ارجع مكون("بطاقة", {"حدود": 8, "حشوة": 16, "لون_خلفية": "#FFFFFF"})
نهاية


# ═══════════════════════════════════════════════════════════════════════════════
# نهاية ملف الثيمات — 25+ ثيمة ودالة مساعدة
# ═══════════════════════════════════════════════════════════════════════════════
