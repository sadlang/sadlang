# ─── ثيمة_مادية ─────────────────────────────────────────────────────
# سمة Material Design الكلاسيكية — ألوان زرقاء
صدّر دالة ثيمة_مادية()
    ارجع تطبيق_م(
        "لون_رئيسي", "#1976D2",
        "لون_ثانوي", "#FF4081",
        "لون_خلفية", "#FAFAFA",
        "لون_سطح", "#FFFFFF",
        "لون_نص", "#212121",
        "لون_نص_ثانوي", "#757575",
        "لون_نجاح", "#4CAF50",
        "لون_تحذير", "#FF9800",
        "لون_خطأ", "#F44336",
        "لون_معلومات", "#2196F3",
        "حجم_عنوان", 24,
        "حجم_نص", 16,
        "حجم_صغير", 12,
        "تباعد", 8,
        "حدود", 8,
        "حشوة", 16
    )
نهاية


