/**
 * ===================================================================================
 *  تحليل التعبير الجيني - Gene Expression Analysis (T474)
 * ===================================================================================
 * 
 *  الوصف: أدوات تحليل بيانات التعبير الجيني
 *  Description: Gene expression data analysis tools
 * 
 *  المميزات:
 *  - قراءة بيانات RNA-seq
 *  - التطبيع (RPKM, TPM, FPKM)
 *  - التحليل التفاضلي
 *  - تجميع الجينات
 * 
 * ===================================================================================
 */

// ============== هياكل البيانات الأساسية ==============

هيكل معلومات_جين {
    المعرف: نص
    الاسم: نص
    الكروموسوم: نص
    البداية: عدد
    النهاية: عدد
    الاتجاه: حرف  // '+' أو '-'
    الطول: عدد
نهاية

هيكل عينة {
    المعرف: نص
    الاسم: نص
    المجموعة: نص  // مثل: "تحكم" أو "معالج"
    القراءات: خريطة[نص، عدد]  // معرف_جين -> عدد_القراءات
    العمق_الكلي: عدد
نهاية

هيكل نتيجة_تطبيع {
    القيم: خريطة[نص، عشري]  // معرف_جين -> قيمة مطبعة
    الطريقة: نص
نهاية

// ============== قارئ البيانات ==============

صنف قارئ_تعبير_جيني {
    خاص الجينات: مصفوفة[معلومات_جين]
    خاص العينات: مصفوفة[عينة]
    خاص مصفوفة_العد: مصفوفة[مصفوفة[عدد]]
    
    دالة بناء():
        الجينات = مصفوفة[معلومات_جين]()
        العينات = مصفوفة[عينة]()
        مصفوفة_العد = مصفوفة[مصفوفة[عدد]]()
    نهاية
    
    // قراءة ملف GTF/GFF للحصول على معلومات الجينات
    دالة قراءة_تعليقات_جينية(مسار: نص):
        متغير محتوى: نص = قراءة_ملف(مسار)
        متغير أسطر: مصفوفة[نص] = قسم(محتوى، "\n")
        
        لكل سطر في أسطر:
            إذا طول(سطر) == 0 أو سطر[0] == '#':
                تابع
            نهاية
            
            متغير حقول: مصفوفة[نص] = قسم(سطر، "\t")
            إذا طول_مصفوفة(حقول) < 9:
                تابع
            نهاية
            
            إذا حقول[2] == "gene":
                متغير جين: معلومات_جين
                جين.الكروموسوم = حقول[0]
                جين.البداية = كعدد(حقول[3])
                جين.النهاية = كعدد(حقول[4])
                جين.الاتجاه = حقول[6][0]
                جين.الطول = جين.النهاية - جين.البداية + 1
                
                // استخراج المعرف والاسم من الحقل التاسع
                متغير صفات: نص = حقول[8]
                جين.المعرف = استخراج_صفة(صفات، "gene_id")
                جين.الاسم = استخراج_صفة(صفات، "gene_name")
                
                مصفوفة_أضف(الجينات، جين)
            نهاية
        نهاية
    نهاية
    
    // قراءة مصفوفة العد (count matrix)
    دالة قراءة_مصفوفة_عد(مسار: نص):
        متغير محتوى: نص = قراءة_ملف(مسار)
        متغير أسطر: مصفوفة[نص] = قسم(محتوى، "\n")
        
        إذا طول_مصفوفة(أسطر) == 0:
            أرجع
        نهاية
        
        // السطر الأول يحتوي أسماء العينات
        متغير رأس: مصفوفة[نص] = قسم(أسطر[0]، "\t")
        لكل ف من 1 حتى طول_مصفوفة(رأس):
            متغير ع: عينة
            ع.المعرف = رأس[ف]
            ع.الاسم = رأس[ف]
            ع.القراءات = خريطة[نص، عدد]()
            ع.العمق_الكلي = 0
            مصفوفة_أضف(العينات، ع)
        نهاية
        
        // بقية الأسطر تحتوي بيانات الجينات
        لكل ف من 1 حتى طول_مصفوفة(أسطر):
            متغير حقول: مصفوفة[نص] = قسم(أسطر[ف]، "\t")
            إذا طول_مصفوفة(حقول) < 2:
                تابع
            نهاية
            
            متغير معرف_جين: نص = حقول[0]
            
            لكل ج من 1 حتى طول_مصفوفة(حقول):
                إذا ج - 1 < طول_مصفوفة(العينات):
                    متغير قراءات: عدد = كعدد(حقول[ج])
                    العينات[ج - 1].القراءات[معرف_جين] = قراءات
                    العينات[ج - 1].العمق_الكلي = العينات[ج - 1].العمق_الكلي + قراءات
                نهاية
            نهاية
        نهاية
    نهاية
    
    دالة الحصول_على_جينات() -> مصفوفة[معلومات_جين]:
        أرجع الجينات
    نهاية
    
    دالة الحصول_على_عينات() -> مصفوفة[عينة]:
        أرجع العينات
    نهاية
    
    خاص دالة استخراج_صفة(صفات: نص، اسم: نص) -> نص:
        متغير نمط: نص = اسم + " \""
        متغير موقع: عدد = بحث(صفات، نمط)
        
        إذا موقع < 0:
            نمط = اسم + "=\""
            موقع = بحث(صفات، نمط)
        نهاية
        
        إذا موقع >= 0:
            متغير بداية: عدد = موقع + طول(نمط)
            متغير نهاية: عدد = بحث_من(صفات، "\"", بداية)
            إذا نهاية > بداية:
                أرجع صفات[بداية:نهاية]
            نهاية
        نهاية
        
        أرجع ""
    نهاية
نهاية

// ============== التطبيع ==============

صنف مطبع_التعبير {
    خاص الجينات: مصفوفة[معلومات_جين]
    
    دالة بناء(جينات: مصفوفة[معلومات_جين]):
        الجينات = جينات
    نهاية
    
    // تطبيع RPKM (Reads Per Kilobase Million)
    // RPKM = (عدد_القراءات × 10^9) / (طول_الجين × إجمالي_القراءات)
    دالة حساب_RPKM(عينة: عينة) -> نتيجة_تطبيع:
        متغير نتيجة: نتيجة_تطبيع
        نتيجة.الطريقة = "RPKM"
        نتيجة.القيم = خريطة[نص، عشري]()
        
        متغير إجمالي_القراءات_بالمليون: عشري = كعشري(عينة.العمق_الكلي) / 1000000.0
        
        لكل جين في الجينات:
            إذا جين.المعرف في عينة.القراءات:
                متغير قراءات: عدد = عينة.القراءات[جين.المعرف]
                متغير طول_بالكيلو: عشري = كعشري(جين.الطول) / 1000.0
                
                إذا طول_بالكيلو > 0.0 و إجمالي_القراءات_بالمليون > 0.0:
                    نتيجة.القيم[جين.المعرف] = كعشري(قراءات) / (طول_بالكيلو * إجمالي_القراءات_بالمليون)
                وإلا:
                    نتيجة.القيم[جين.المعرف] = 0.0
                نهاية
            نهاية
        نهاية
        
        أرجع نتيجة
    نهاية
    
    // تطبيع TPM (Transcripts Per Million)
    // أفضل للمقارنة بين العينات
    دالة حساب_TPM(عينة: عينة) -> نتيجة_تطبيع:
        متغير نتيجة: نتيجة_تطبيع
        نتيجة.الطريقة = "TPM"
        نتيجة.القيم = خريطة[نص، عشري]()
        
        // الخطوة 1: حساب RPK لكل جين
        متغير RPK: خريطة[نص، عشري] = خريطة[نص، عشري]()
        متغير مجموع_RPK: عشري = 0.0
        
        لكل جين في الجينات:
            إذا جين.المعرف في عينة.القراءات:
                متغير قراءات: عدد = عينة.القراءات[جين.المعرف]
                متغير طول_بالكيلو: عشري = كعشري(جين.الطول) / 1000.0
                
                إذا طول_بالكيلو > 0.0:
                    متغير rpk: عشري = كعشري(قراءات) / طول_بالكيلو
                    RPK[جين.المعرف] = rpk
                    مجموع_RPK = مجموع_RPK + rpk
                نهاية
            نهاية
        نهاية
        
        // الخطوة 2: التطبيع لمليون
        متغير معامل_التحجيم: عشري = مجموع_RPK / 1000000.0
        
        لكل (معرف، rpk) في RPK:
            إذا معامل_التحجيم > 0.0:
                نتيجة.القيم[معرف] = rpk / معامل_التحجيم
            وإلا:
                نتيجة.القيم[معرف] = 0.0
            نهاية
        نهاية
        
        أرجع نتيجة
    نهاية
    
    // تطبيع FPKM (للقراءات المزدوجة)
    دالة حساب_FPKM(عينة: عينة) -> نتيجة_تطبيع:
        // FPKM مماثل لـ RPKM لكن للقراءات المزدوجة (paired-end)
        متغير نتيجة: نتيجة_تطبيع = حساب_RPKM(عينة)
        نتيجة.الطريقة = "FPKM"
        أرجع نتيجة
    نهاية
    
    // تطبيع CPM (Counts Per Million)
    دالة حساب_CPM(عينة: عينة) -> نتيجة_تطبيع:
        متغير نتيجة: نتيجة_تطبيع
        نتيجة.الطريقة = "CPM"
        نتيجة.القيم = خريطة[نص، عشري]()
        
        متغير معامل: عشري = 1000000.0 / كعشري(عينة.العمق_الكلي)
        
        لكل (معرف، قراءات) في عينة.القراءات:
            نتيجة.القيم[معرف] = كعشري(قراءات) * معامل
        نهاية
        
        أرجع نتيجة
    نهاية
نهاية

// ============== التحليل التفاضلي ==============

هيكل نتيجة_تفاضلية {
    معرف_الجين: نص
    اسم_الجين: نص
    التغير_اللوغاريتمي: عشري  // log2 fold change
    قيمة_p: عشري
    قيمة_p_معدلة: عشري  // FDR
    متوسط_التحكم: عشري
    متوسط_المعالجة: عشري
    مهم: منطقي
نهاية

صنف محلل_تفاضلي {
    خاص عتبة_التغير: عشري = 1.0  // |log2FC| >= 1
    خاص عتبة_p: عشري = 0.05
    
    دالة بناء():
    نهاية
    
    دالة تعيين_عتبات(تغير: عشري، p: عشري):
        عتبة_التغير = تغير
        عتبة_p = p
    نهاية
    
    دالة تحليل(عينات_تحكم: مصفوفة[نتيجة_تطبيع]، عينات_معالجة: مصفوفة[نتيجة_تطبيع]) -> مصفوفة[نتيجة_تفاضلية]:
        متغير نتائج: مصفوفة[نتيجة_تفاضلية] = مصفوفة[نتيجة_تفاضلية]()
        
        // جمع كل الجينات
        متغير جينات: مجموعة[نص] = مجموعة[نص]()
        لكل عينة في عينات_تحكم:
            لكل (معرف، _) في عينة.القيم:
                أضف(جينات، معرف)
            نهاية
        نهاية
        
        لكل معرف في جينات:
            متغير نتيجة: نتيجة_تفاضلية
            نتيجة.معرف_الجين = معرف
            
            // حساب المتوسطات
            متغير قيم_تحكم: مصفوفة[عشري] = مصفوفة[عشري]()
            متغير قيم_معالجة: مصفوفة[عشري] = مصفوفة[عشري]()
            
            لكل عينة في عينات_تحكم:
                إذا معرف في عينة.القيم:
                    مصفوفة_أضف(قيم_تحكم، عينة.القيم[معرف])
                نهاية
            نهاية
            
            لكل عينة في عينات_معالجة:
                إذا معرف في عينة.القيم:
                    مصفوفة_أضف(قيم_معالجة، عينة.القيم[معرف])
                نهاية
            نهاية
            
            نتيجة.متوسط_التحكم = متوسط(قيم_تحكم)
            نتيجة.متوسط_المعالجة = متوسط(قيم_معالجة)
            
            // حساب التغير اللوغاريتمي
            إذا نتيجة.متوسط_التحكم > 0.0:
                نتيجة.التغير_اللوغاريتمي = لوغاريتم٢(نتيجة.متوسط_المعالجة + 1.0) - لوغاريتم٢(نتيجة.متوسط_التحكم + 1.0)
            وإلا:
                نتيجة.التغير_اللوغاريتمي = 0.0
            نهاية
            
            // حساب قيمة p (اختبار t مبسط)
            نتيجة.قيمة_p = اختبار_t(قيم_تحكم، قيم_معالجة)
            
            // تحديد الأهمية
            نتيجة.مهم = قيمة_مطلقة(نتيجة.التغير_اللوغاريتمي) >= عتبة_التغير و نتيجة.قيمة_p <= عتبة_p
            
            مصفوفة_أضف(نتائج، نتيجة)
        نهاية
        
        // تصحيح FDR (Benjamini-Hochberg)
        نتائج = تصحيح_FDR(نتائج)
        
        أرجع نتائج
    نهاية
    
    خاص دالة اختبار_t(مجموعة١: مصفوفة[عشري]، مجموعة٢: مصفوفة[عشري]) -> عشري:
        إذا طول_مصفوفة(مجموعة١) < 2 أو طول_مصفوفة(مجموعة٢) < 2:
            أرجع 1.0
        نهاية
        
        متغير م١: عشري = متوسط(مجموعة١)
        متغير م٢: عشري = متوسط(مجموعة٢)
        متغير ت١: عشري = تباين(مجموعة١)
        متغير ت٢: عشري = تباين(مجموعة٢)
        متغير ن١: عدد = طول_مصفوفة(مجموعة١)
        متغير ن٢: عدد = طول_مصفوفة(مجموعة٢)
        
        متغير خطأ_معياري: عشري = جذر(ت١ / كعشري(ن١) + ت٢ / كعشري(ن٢))
        
        إذا خطأ_معياري == 0.0:
            أرجع 1.0
        نهاية
        
        متغير t: عشري = قيمة_مطلقة(م١ - م٢) / خطأ_معياري
        
        // تحويل تقريبي لقيمة p (مبسط)
        أرجع 2.0 * (1.0 - دالة_توزيع_t(t، ن١ + ن٢ - 2))
    نهاية
    
    خاص دالة تصحيح_FDR(نتائج: مصفوفة[نتيجة_تفاضلية]) -> مصفوفة[نتيجة_تفاضلية]:
        // ترتيب حسب قيمة p
        متغير مرتبة: مصفوفة[نتيجة_تفاضلية] = ترتيب_حسب_p(نتائج)
        متغير ن: عدد = طول_مصفوفة(مرتبة)
        
        // حساب قيمة p المعدلة
        متغير أدنى: عشري = 1.0
        لكل ف من ن - 1 حتى 0 بخطوة -1:
            متغير q: عشري = مرتبة[ف].قيمة_p * كعشري(ن) / كعشري(ف + 1)
            إذا q < أدنى:
                أدنى = q
            نهاية
            مرتبة[ف].قيمة_p_معدلة = أدنى(أدنى، 1.0)
            
            // تحديث الأهمية
            مرتبة[ف].مهم = قيمة_مطلقة(مرتبة[ف].التغير_اللوغاريتمي) >= عتبة_التغير و مرتبة[ف].قيمة_p_معدلة <= عتبة_p
        نهاية
        
        أرجع مرتبة
    نهاية
    
    خاص دالة ترتيب_حسب_p(نتائج: مصفوفة[نتيجة_تفاضلية]) -> مصفوفة[نتيجة_تفاضلية]:
        // ترتيب فقاعي بسيط
        متغير مرتبة: مصفوفة[نتيجة_تفاضلية] = نسخ(نتائج)
        
        لكل ف من 0 حتى طول_مصفوفة(مرتبة) - 1:
            لكل ج من 0 حتى طول_مصفوفة(مرتبة) - ف - 1:
                إذا مرتبة[ج].قيمة_p > مرتبة[ج + 1].قيمة_p:
                    متغير مؤقت: نتيجة_تفاضلية = مرتبة[ج]
                    مرتبة[ج] = مرتبة[ج + 1]
                    مرتبة[ج + 1] = مؤقت
                نهاية
            نهاية
        نهاية
        
        أرجع مرتبة
    نهاية
نهاية

// ============== تجميع الجينات ==============

صنف مجمع_الجينات {
    خاص عدد_المجموعات: عدد
    خاص المراكز: مصفوفة[مصفوفة[عشري]]
    خاص التخصيصات: مصفوفة[عدد]
    
    دالة بناء(ك: عدد):
        عدد_المجموعات = ك
        المراكز = مصفوفة[مصفوفة[عشري]]()
        التخصيصات = مصفوفة[عدد]()
    نهاية
    
    // تجميع K-means
    دالة تجميع(بيانات: مصفوفة[مصفوفة[عشري]]، تكرارات_قصوى: عدد = 100) -> مصفوفة[عدد]:
        متغير ن: عدد = طول_مصفوفة(بيانات)
        متغير أبعاد: عدد = طول_مصفوفة(بيانات[0])
        
        // تهيئة المراكز عشوائياً
        تهيئة_المراكز(بيانات)
        
        // تهيئة التخصيصات
        التخصيصات = مصفوفة[عدد]()
        لكل _ من 0 حتى ن:
            مصفوفة_أضف(التخصيصات، 0)
        نهاية
        
        // التكرار
        لكل تكرار من 0 حتى تكرارات_قصوى:
            // تعيين كل نقطة لأقرب مركز
            متغير تغير: منطقي = خطأ
            
            لكل ف من 0 حتى ن:
                متغير أقرب: عدد = إيجاد_أقرب_مركز(بيانات[ف])
                إذا أقرب != التخصيصات[ف]:
                    التخصيصات[ف] = أقرب
                    تغير = صحيح
                نهاية
            نهاية
            
            إذا لا تغير:
                توقف
            نهاية
            
            // تحديث المراكز
            تحديث_المراكز(بيانات)
        نهاية
        
        أرجع التخصيصات
    نهاية
    
    خاص دالة تهيئة_المراكز(بيانات: مصفوفة[مصفوفة[عشري]]):
        المراكز = مصفوفة[مصفوفة[عشري]]()
        
        // اختيار أولي عشوائي (k-means++)
        متغير مستخدم: مجموعة[عدد] = مجموعة[عدد]()
        
        لكل _ من 0 حتى عدد_المجموعات:
            متغير فهرس: عدد = عشوائي(0، طول_مصفوفة(بيانات) - 1)
            طالما فهرس في مستخدم:
                فهرس = (فهرس + 1) % طول_مصفوفة(بيانات)
            نهاية
            أضف(مستخدم، فهرس)
            مصفوفة_أضف(المراكز، نسخ(بيانات[فهرس]))
        نهاية
    نهاية
    
    خاص دالة إيجاد_أقرب_مركز(نقطة: مصفوفة[عشري]) -> عدد:
        متغير أقرب: عدد = 0
        متغير أدنى_مسافة: عشري = مسافة_إقليدية(نقطة، المراكز[0])
        
        لكل ف من 1 حتى عدد_المجموعات:
            متغير مسافة: عشري = مسافة_إقليدية(نقطة، المراكز[ف])
            إذا مسافة < أدنى_مسافة:
                أدنى_مسافة = مسافة
                أقرب = ف
            نهاية
        نهاية
        
        أرجع أقرب
    نهاية
    
    خاص دالة تحديث_المراكز(بيانات: مصفوفة[مصفوفة[عشري]]):
        متغير أبعاد: عدد = طول_مصفوفة(بيانات[0])
        
        لكل ك من 0 حتى عدد_المجموعات:
            متغير مجموع: مصفوفة[عشري] = مصفوفة[عشري]()
            متغير عدد: عدد = 0
            
            لكل _ من 0 حتى أبعاد:
                مصفوفة_أضف(مجموع، 0.0)
            نهاية
            
            لكل ف من 0 حتى طول_مصفوفة(بيانات):
                إذا التخصيصات[ف] == ك:
                    لكل بعد من 0 حتى أبعاد:
                        مجموع[بعد] = مجموع[بعد] + بيانات[ف][بعد]
                    نهاية
                    عدد = عدد + 1
                نهاية
            نهاية
            
            إذا عدد > 0:
                لكل بعد من 0 حتى أبعاد:
                    المراكز[ك][بعد] = مجموع[بعد] / كعشري(عدد)
                نهاية
            نهاية
        نهاية
    نهاية
    
    دالة الحصول_على_المراكز() -> مصفوفة[مصفوفة[عشري]]:
        أرجع المراكز
    نهاية
نهاية

// ============== تحليل الإثراء ==============

هيكل نتيجة_إثراء {
    مسار: نص
    وصف: نص
    جينات_في_المسار: عدد
    جينات_مهمة: عدد
    نسبة_الإثراء: عشري
    قيمة_p: عشري
نهاية

صنف محلل_الإثراء {
    خاص المسارات: خريطة[نص، مصفوفة[نص]]  // اسم_المسار -> قائمة_الجينات
    
    دالة بناء():
        المسارات = خريطة[نص، مصفوفة[نص]]()
    نهاية
    
    دالة تحميل_مسارات(مسار_ملف: نص):
        متغير محتوى: نص = قراءة_ملف(مسار_ملف)
        متغير أسطر: مصفوفة[نص] = قسم(محتوى، "\n")
        
        لكل سطر في أسطر:
            متغير حقول: مصفوفة[نص] = قسم(سطر، "\t")
            إذا طول_مصفوفة(حقول) >= 3:
                متغير اسم: نص = حقول[0]
                متغير جينات: مصفوفة[نص] = قسم(حقول[2]، ",")
                المسارات[اسم] = جينات
            نهاية
        نهاية
    نهاية
    
    دالة تحليل_إثراء(جينات_مهمة: مصفوفة[نص]، كل_الجينات: مصفوفة[نص]) -> مصفوفة[نتيجة_إثراء]:
        متغير نتائج: مصفوفة[نتيجة_إثراء] = مصفوفة[نتيجة_إثراء]()
        
        متغير ن_كلي: عدد = طول_مصفوفة(كل_الجينات)
        متغير ن_مهم: عدد = طول_مصفوفة(جينات_مهمة)
        متغير مجموعة_مهمة: مجموعة[نص] = إلى_مجموعة(جينات_مهمة)
        
        لكل (اسم_مسار، جينات_مسار) في المسارات:
            متغير ن_مسار: عدد = طول_مصفوفة(جينات_مسار)
            
            // عد الجينات المهمة في هذا المسار
            متغير تداخل: عدد = 0
            لكل جين في جينات_مسار:
                إذا جين في مجموعة_مهمة:
                    تداخل = تداخل + 1
                نهاية
            نهاية
            
            إذا تداخل > 0:
                متغير نتيجة: نتيجة_إثراء
                نتيجة.مسار = اسم_مسار
                نتيجة.جينات_في_المسار = ن_مسار
                نتيجة.جينات_مهمة = تداخل
                
                // حساب نسبة الإثراء
                متغير متوقع: عشري = كعشري(ن_مهم * ن_مسار) / كعشري(ن_كلي)
                نتيجة.نسبة_الإثراء = كعشري(تداخل) / متوقع
                
                // حساب قيمة p (اختبار فيشر المبسط)
                نتيجة.قيمة_p = اختبار_هيبرجيومتري(تداخل، ن_مهم، ن_مسار، ن_كلي)
                
                مصفوفة_أضف(نتائج، نتيجة)
            نهاية
        نهاية
        
        أرجع نتائج
    نهاية
    
    خاص دالة اختبار_هيبرجيومتري(ك: عدد، ن: عدد، ك_كبير: عدد، ن_كبير: عدد) -> عشري:
        // تقريب للقيمة p
        متغير متوقع: عشري = كعشري(ن * ك_كبير) / كعشري(ن_كبير)
        متغير تباين: عشري = متوقع * (1.0 - كعشري(ك_كبير) / كعشري(ن_كبير)) * كعشري(ن_كبير - ن) / كعشري(ن_كبير - 1)
        
        إذا تباين <= 0.0:
            أرجع 1.0
        نهاية
        
        متغير z: عشري = (كعشري(ك) - متوقع) / جذر(تباين)
        
        // تقريب لدالة التوزيع الطبيعي
        أرجع 1.0 - دالة_توزيع_طبيعي(z)
    نهاية
نهاية

// ============== دوال مساعدة ==============

دالة متوسط(قيم: مصفوفة[عشري]) -> عشري:
    إذا طول_مصفوفة(قيم) == 0:
        أرجع 0.0
    نهاية
    
    متغير مجموع: عشري = 0.0
    لكل قيمة في قيم:
        مجموع = مجموع + قيمة
    نهاية
    
    أرجع مجموع / كعشري(طول_مصفوفة(قيم))
نهاية

دالة تباين(قيم: مصفوفة[عشري]) -> عشري:
    إذا طول_مصفوفة(قيم) < 2:
        أرجع 0.0
    نهاية
    
    متغير م: عشري = متوسط(قيم)
    متغير مجموع: عشري = 0.0
    
    لكل قيمة في قيم:
        مجموع = مجموع + (قيمة - م) * (قيمة - م)
    نهاية
    
    أرجع مجموع / كعشري(طول_مصفوفة(قيم) - 1)
نهاية

دالة مسافة_إقليدية(أ: مصفوفة[عشري]، ب: مصفوفة[عشري]) -> عشري:
    متغير مجموع: عشري = 0.0
    لكل ف من 0 حتى طول_مصفوفة(أ):
        متغير فرق: عشري = أ[ف] - ب[ف]
        مجموع = مجموع + فرق * فرق
    نهاية
    أرجع جذر(مجموع)
نهاية

دالة لوغاريتم٢(x: عشري) -> عشري:
    أرجع لوغاريتم(x) / لوغاريتم(2.0)
نهاية

دالة قيمة_مطلقة(x: عشري) -> عشري:
    إذا x < 0.0:
        أرجع -x
    نهاية
    أرجع x
نهاية

دالة أدنى(أ: عشري، ب: عشري) -> عشري:
    إذا أ < ب:
        أرجع أ
    نهاية
    أرجع ب
نهاية

// تقريب لدالة توزيع t
دالة دالة_توزيع_t(t: عشري، درجات_حرية: عدد) -> عشري:
    // تقريب باستخدام التوزيع الطبيعي للدرجات الكبيرة
    إذا درجات_حرية > 30:
        أرجع دالة_توزيع_طبيعي(t)
    نهاية
    
    // تقريب مبسط
    متغير x: عشري = درجات_حرية / (درجات_حرية + t * t)
    أرجع 0.5 + 0.5 * (1.0 - x) * علامة(t)
نهاية

دالة دالة_توزيع_طبيعي(z: عشري) -> عشري:
    // تقريب Abramowitz و Stegun
    متغير a1: عشري = 0.254829592
    متغير a2: عشري = -0.284496736
    متغير a3: عشري = 1.421413741
    متغير a4: عشري = -1.453152027
    متغير a5: عشري = 1.061405429
    متغير p: عشري = 0.3275911
    
    متغير علامة: عدد = 1
    إذا z < 0.0:
        علامة = -1
    نهاية
    z = قيمة_مطلقة(z) / جذر(2.0)
    
    متغير t: عشري = 1.0 / (1.0 + p * z)
    متغير y: عشري = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * أس(-z * z)
    
    أرجع 0.5 * (1.0 + كعشري(علامة) * y)
نهاية

دالة علامة(x: عشري) -> عشري:
    إذا x > 0.0:
        أرجع 1.0
    وإلا إذا x < 0.0:
        أرجع -1.0
    نهاية
    أرجع 0.0
نهاية

دالة إلى_مجموعة(قائمة: مصفوفة[نص]) -> مجموعة[نص]:
    متغير م: مجموعة[نص] = مجموعة[نص]()
    لكل عنصر في قائمة:
        أضف(م، عنصر)
    نهاية
    أرجع م
نهاية
