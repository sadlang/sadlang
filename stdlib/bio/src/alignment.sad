 */

// ============== مصفوفات الاستبدال ==============

// مصفوفة BLOSUM62 (مبسطة لـ 20 حمض أميني)
هيكل مصفوفة_استبدال {
    القيم: مصفوفة[مصفوفة[عدد]]
    الأحماض: نص = "ARNDCQEGHILKMFPSTWYV"
نهاية

دالة مصفوفة_BLOSUM62() -> مصفوفة_استبدال:
    متغير م: مصفوفة_استبدال
    
    // تهيئة بقيم BLOSUM62 الفعلية (مبسطة)
    // كل صف يمثل حمض أميني
    م.القيم = مصفوفة[مصفوفة[عدد]]()
    
    // A  R  N  D  C  Q  E  G  H  I  L  K  M  F  P  S  T  W  Y  V
    مصفوفة_أضف(م.القيم، [4، -1، -2، -2، 0، -1، -1، 0، -2، -1، -1، -1، -1، -2، -1، 1، 0، -3، -2، 0])  // A
    مصفوفة_أضف(م.القيم، [-1، 5، 0، -2، -3، 1، 0، -2، 0، -3، -2، 2، -1، -3، -2، -1، -1، -3، -2، -3])  // R
    مصفوفة_أضف(م.القيم، [-2، 0، 6، 1، -3، 0، 0، 0، 1، -3، -3، 0، -2، -3، -2، 1، 0، -4، -2، -3])  // N
    مصفوفة_أضف(م.القيم، [-2، -2، 1، 6، -3، 0، 2، -1، -1، -3، -4، -1، -3، -3، -1، 0، -1، -4، -3، -3])  // D
    مصفوفة_أضف(م.القيم، [0، -3، -3، -3، 9، -3، -4، -3، -3، -1، -1، -3، -1، -2، -3، -1، -1، -2، -2، -1])  // C
    مصفوفة_أضف(م.القيم، [-1، 1، 0، 0، -3، 5، 2، -2، 0، -3، -2، 1، 0، -3، -1، 0، -1، -2، -1، -2])  // Q
    مصفوفة_أضف(م.القيم، [-1، 0، 0، 2، -4، 2، 5، -2، 0، -3، -3، 1، -2، -3، -1، 0، -1، -3، -2، -2])  // E
    مصفوفة_أضف(م.القيم، [0، -2، 0، -1، -3، -2، -2، 6، -2، -4، -4، -2، -3، -3، -2، 0، -2، -2، -3، -3])  // G
    مصفوفة_أضف(م.القيم، [-2، 0، 1، -1، -3، 0، 0، -2، 8، -3، -3، -1، -2، -1، -2، -1، -2، -2، 2، -3])  // H
    مصفوفة_أضف(م.القيم، [-1، -3، -3، -3، -1، -3، -3، -4، -3، 4، 2، -3، 1، 0، -3، -2، -1، -3، -1، 3])  // I
    مصفوفة_أضف(م.القيم، [-1، -2، -3، -4، -1، -2، -3، -4، -3، 2، 4، -2، 2، 0، -3، -2، -1، -2، -1، 1])  // L
    مصفوفة_أضف(م.القيم، [-1، 2، 0، -1، -3، 1، 1، -2، -1، -3، -2، 5، -1، -3، -1، 0، -1، -3، -2، -2])  // K
    مصفوفة_أضف(م.القيم، [-1، -1، -2، -3، -1، 0، -2، -3، -2، 1، 2، -1، 5، 0، -2، -1، -1، -1، -1، 1])  // M
    مصفوفة_أضف(م.القيم، [-2، -3، -3، -3، -2، -3، -3، -3، -1، 0، 0، -3، 0، 6، -4، -2، -2، 1، 3، -1])  // F
    مصفوفة_أضف(م.القيم، [-1، -2، -2، -1، -3، -1، -1، -2، -2، -3، -3، -1، -2، -4، 7، -1، -1، -4، -3، -2])  // P
    مصفوفة_أضف(م.القيم، [1، -1، 1، 0، -1، 0، 0، 0، -1، -2، -2، 0، -1، -2، -1، 4، 1، -3، -2، -2])  // S
    مصفوفة_أضف(م.القيم، [0، -1، 0، -1، -1، -1، -1، -2، -2، -1، -1، -1، -1، -2، -1، 1، 5، -2، -2، 0])  // T
    مصفوفة_أضف(م.القيم، [-3، -3، -4، -4، -2، -2، -3، -2، -2، -3، -2، -3، -1، 1، -4، -3، -2، 11، 2، -3])  // W
    مصفوفة_أضف(م.القيم، [-2، -2، -2، -3، -2، -1، -2، -3، 2، -1، -1، -2، -1، 3، -3، -2، -2، 2، 7، -1])  // Y
    مصفوفة_أضف(م.القيم، [0، -3، -3، -3، -1، -2، -2، -3، -3، 3، 1، -2، 1، -1، -2، -2، 0، -3، -1، 4])  // V
    
    أرجع م
نهاية

دالة نقاط_استبدال(م: مصفوفة_استبدال، أ: حرف، ب: حرف) -> عدد:
    متغير فهرس_أ: عدد = موقع_حرف(م.الأحماض، أ)
    متغير فهرس_ب: عدد = موقع_حرف(م.الأحماض، ب)
    
    إذا فهرس_أ < 0 أو فهرس_ب < 0:
        أرجع -4  // عقوبة لحرف غير معروف
    نهاية
    
    أرجع م.القيم[فهرس_أ][فهرس_ب]
نهاية

// ============== نتيجة المحاذاة ==============

هيكل نتيجة_محاذاة {
    التسلسل_الأول: نص
    التسلسل_الثاني: نص
    المحاذاة_الأولى: نص
    المحاذاة_الثانية: نص
    النقاط: عدد
    الهوية: عشري  // نسبة التطابق
    الفجوات: عدد
    الطول: عدد
نهاية

// ============== محاذاة عالمية (Needleman-Wunsch) ==============

صنف محاذاة_عالمية {
    خاص المصفوفة: مصفوفة_استبدال
    خاص عقوبة_فجوة: عدد = -10
    خاص تمديد_فجوة: عدد = -1
    
    دالة بناء():
        المصفوفة = مصفوفة_BLOSUM62()
    نهاية
    
    دالة تعيين_عقوبة_فجوة(فتح: عدد، تمديد: عدد):
        عقوبة_فجوة = فتح
        تمديد_فجوة = تمديد
    نهاية
    
    دالة محاذاة(تسلسل١: نص، تسلسل٢: نص) -> نتيجة_محاذاة:
        متغير م: عدد = طول(تسلسل١)
        متغير ن: عدد = طول(تسلسل٢)
        
        // إنشاء مصفوفة النقاط
        متغير نقاط: مصفوفة[مصفوفة[عدد]] = مصفوفة[مصفوفة[عدد]]()
        
        // تهيئة
        لكل ف من 0 حتى م + 1:
            متغير صف: مصفوفة[عدد] = مصفوفة[عدد]()
            لكل ج من 0 حتى ن + 1:
                مصفوفة_أضف(صف، 0)
            نهاية
            مصفوفة_أضف(نقاط، صف)
        نهاية
        
        // تهيئة الصف والعمود الأول
        لكل ف من 1 حتى م + 1:
            نقاط[ف][0] = عقوبة_فجوة + (ف - 1) * تمديد_فجوة
        نهاية
        لكل ج من 1 حتى ن + 1:
            نقاط[0][ج] = عقوبة_فجوة + (ج - 1) * تمديد_فجوة
        نهاية
        
        // ملء المصفوفة
        لكل ف من 1 حتى م + 1:
            لكل ج من 1 حتى ن + 1:
                متغير تطابق: عدد = نقاط[ف - 1][ج - 1] + 
                    نقاط_استبدال(المصفوفة، تسلسل١[ف - 1]، تسلسل٢[ج - 1])
                متغير حذف: عدد = نقاط[ف - 1][ج] + تمديد_فجوة
                متغير إدراج: عدد = نقاط[ف][ج - 1] + تمديد_فجوة
                
                نقاط[ف][ج] = أقصى٣(تطابق، حذف، إدراج)
            نهاية
        نهاية
        
        // التتبع الخلفي
        أرجع تتبع_خلفي(نقاط، تسلسل١، تسلسل٢)
    نهاية
    
    خاص دالة تتبع_خلفي(نقاط: مصفوفة[مصفوفة[عدد]]، تسلسل١: نص، تسلسل٢: نص) -> نتيجة_محاذاة:
        متغير نتيجة: نتيجة_محاذاة
        نتيجة.التسلسل_الأول = تسلسل١
        نتيجة.التسلسل_الثاني = تسلسل٢
        
        متغير محاذاة١: نص = ""
        متغير محاذاة٢: نص = ""
        
        متغير ف: عدد = طول(تسلسل١)
        متغير ج: عدد = طول(تسلسل٢)
        
        طالما ف > 0 أو ج > 0:
            إذا ف > 0 و ج > 0:
                متغير قيمة_حالية: عدد = نقاط[ف][ج]
                متغير قطري: عدد = نقاط[ف - 1][ج - 1] + 
                    نقاط_استبدال(المصفوفة، تسلسل١[ف - 1]، تسلسل٢[ج - 1])
                
                إذا قيمة_حالية == قطري:
                    محاذاة١ = تسلسل١[ف - 1] + محاذاة١
                    محاذاة٢ = تسلسل٢[ج - 1] + محاذاة٢
                    ف = ف - 1
                    ج = ج - 1
                    تابع
                نهاية
            نهاية
            
            إذا ف > 0 و نقاط[ف][ج] == نقاط[ف - 1][ج] + تمديد_فجوة:
                محاذاة١ = تسلسل١[ف - 1] + محاذاة١
                محاذاة٢ = "-" + محاذاة٢
                ف = ف - 1
                نتيجة.الفجوات = نتيجة.الفجوات + 1
            وإلا إذا ج > 0:
                محاذاة١ = "-" + محاذاة١
                محاذاة٢ = تسلسل٢[ج - 1] + محاذاة٢
                ج = ج - 1
                نتيجة.الفجوات = نتيجة.الفجوات + 1
            نهاية
        نهاية
        
        نتيجة.المحاذاة_الأولى = محاذاة١
        نتيجة.المحاذاة_الثانية = محاذاة٢
        نتيجة.النقاط = نقاط[طول(تسلسل١)][طول(تسلسل٢)]
        نتيجة.الطول = طول(محاذاة١)
        
        // حساب نسبة الهوية
        متغير تطابقات: عدد = 0
        لكل ف من 0 حتى طول(محاذاة١):
            إذا محاذاة١[ف] == محاذاة٢[ف] و محاذاة١[ف] != '-':
                تطابقات = تطابقات + 1
            نهاية
        نهاية
        نتيجة.الهوية = كعشري(تطابقات) / كعشري(نتيجة.الطول) * 100.0
        
        أرجع نتيجة
    نهاية
نهاية

// ============== محاذاة محلية (Smith-Waterman) ==============

صنف محاذاة_محلية {
    خاص المصفوفة: مصفوفة_استبدال
    خاص عقوبة_فجوة: عدد = -10
    خاص تمديد_فجوة: عدد = -1
    
    دالة بناء():
        المصفوفة = مصفوفة_BLOSUM62()
    نهاية
    
    دالة محاذاة(تسلسل١: نص، تسلسل٢: نص) -> نتيجة_محاذاة:
        متغير م: عدد = طول(تسلسل١)
        متغير ن: عدد = طول(تسلسل٢)
        
        // إنشاء مصفوفة النقاط
        متغير نقاط: مصفوفة[مصفوفة[عدد]] = مصفوفة[مصفوفة[عدد]]()
        
        // تهيئة بأصفار
        لكل ف من 0 حتى م + 1:
            متغير صف: مصفوفة[عدد] = مصفوفة[عدد]()
            لكل ج من 0 حتى ن + 1:
                مصفوفة_أضف(صف، 0)
            نهاية
            مصفوفة_أضف(نقاط، صف)
        نهاية
        
        // ملء المصفوفة وتتبع الأقصى
        متغير أقصى_نقاط: عدد = 0
        متغير أقصى_ف: عدد = 0
        متغير أقصى_ج: عدد = 0
        
        لكل ف من 1 حتى م + 1:
            لكل ج من 1 حتى ن + 1:
                متغير تطابق: عدد = نقاط[ف - 1][ج - 1] + 
                    نقاط_استبدال(المصفوفة، تسلسل١[ف - 1]، تسلسل٢[ج - 1])
                متغير حذف: عدد = نقاط[ف - 1][ج] + تمديد_فجوة
                متغير إدراج: عدد = نقاط[ف][ج - 1] + تمديد_فجوة
                
                // الفرق عن المحاذاة العالمية: لا نقبل قيم سالبة
                نقاط[ف][ج] = أقصى٤(0، تطابق، حذف، إدراج)
                
                إذا نقاط[ف][ج] > أقصى_نقاط:
                    أقصى_نقاط = نقاط[ف][ج]
                    أقصى_ف = ف
                    أقصى_ج = ج
                نهاية
            نهاية
        نهاية
        
        // التتبع الخلفي من الأقصى
        أرجع تتبع_خلفي_محلي(نقاط، تسلسل١، تسلسل٢، أقصى_ف، أقصى_ج)
    نهاية
    
    خاص دالة تتبع_خلفي_محلي(نقاط: مصفوفة[مصفوفة[عدد]]، تسلسل١: نص، تسلسل٢: نص، بداية_ف: عدد، بداية_ج: عدد) -> نتيجة_محاذاة:
        متغير نتيجة: نتيجة_محاذاة
        نتيجة.التسلسل_الأول = تسلسل١
        نتيجة.التسلسل_الثاني = تسلسل٢
        
        متغير محاذاة١: نص = ""
        متغير محاذاة٢: نص = ""
        
        متغير ف: عدد = بداية_ف
        متغير ج: عدد = بداية_ج
        
        // التتبع حتى نصل لصفر
        طالما ف > 0 و ج > 0 و نقاط[ف][ج] > 0:
            متغير قيمة_حالية: عدد = نقاط[ف][ج]
            
            إذا ف > 0 و ج > 0:
                متغير قطري: عدد = نقاط[ف - 1][ج - 1] + 
                    نقاط_استبدال(المصفوفة، تسلسل١[ف - 1]، تسلسل٢[ج - 1])
                
                إذا قيمة_حالية == قطري:
                    محاذاة١ = تسلسل١[ف - 1] + محاذاة١
                    محاذاة٢ = تسلسل٢[ج - 1] + محاذاة٢
                    ف = ف - 1
                    ج = ج - 1
                    تابع
                نهاية
            نهاية
            
            إذا ف > 0 و نقاط[ف][ج] == نقاط[ف - 1][ج] + تمديد_فجوة:
                محاذاة١ = تسلسل١[ف - 1] + محاذاة١
                محاذاة٢ = "-" + محاذاة٢
                ف = ف - 1
                نتيجة.الفجوات = نتيجة.الفجوات + 1
            وإلا إذا ج > 0:
                محاذاة١ = "-" + محاذاة١
                محاذاة٢ = تسلسل٢[ج - 1] + محاذاة٢
                ج = ج - 1
                نتيجة.الفجوات = نتيجة.الفجوات + 1
            وإلا:
                توقف
            نهاية
        نهاية
        
        نتيجة.المحاذاة_الأولى = محاذاة١
        نتيجة.المحاذاة_الثانية = محاذاة٢
        نتيجة.النقاط = نقاط[بداية_ف][بداية_ج]
        نتيجة.الطول = طول(محاذاة١)
        
        // حساب نسبة الهوية
        متغير تطابقات: عدد = 0
        لكل ف من 0 حتى طول(محاذاة١):
            إذا محاذاة١[ف] == محاذاة٢[ف] و محاذاة١[ف] != '-':
                تطابقات = تطابقات + 1
            نهاية
        نهاية
        
        إذا نتيجة.الطول > 0:
            نتيجة.الهوية = كعشري(تطابقات) / كعشري(نتيجة.الطول) * 100.0
        نهاية
        
        أرجع نتيجة
    نهاية
نهاية

// ============== محاذاة متعددة (مبسطة) ==============

صنف محاذاة_متعددة {
    خاص التسلسلات: مصفوفة[نص]
    خاص الأسماء: مصفوفة[نص]
    خاص المحاذاة_الناتجة: مصفوفة[نص]
    
    دالة بناء():
        التسلسلات = مصفوفة[نص]()
        الأسماء = مصفوفة[نص]()
        المحاذاة_الناتجة = مصفوفة[نص]()
    نهاية
    
    دالة إضافة_تسلسل(تسلسل: نص، اسم: نص = ""):
        مصفوفة_أضف(التسلسلات، تسلسل)
        مصفوفة_أضف(الأسماء، اسم)
    نهاية
    
    // محاذاة تقدمية بسيطة
    دالة محاذاة() -> مصفوفة[نص]:
        إذا طول_مصفوفة(التسلسلات) < 2:
            أرجع التسلسلات
        نهاية
        
        المحاذاة_الناتجة = مصفوفة[نص]()
        
        // البدء بمحاذاة أول تسلسلين
        متغير محاذي: محاذاة_عالمية = محاذاة_عالمية()
        متغير نتيجة: نتيجة_محاذاة = محاذي.محاذاة(التسلسلات[0]، التسلسلات[1])
        
        مصفوفة_أضف(المحاذاة_الناتجة، نتيجة.المحاذاة_الأولى)
        مصفوفة_أضف(المحاذاة_الناتجة، نتيجة.المحاذاة_الثانية)
        
        // إضافة التسلسلات المتبقية
        لكل ف من 2 حتى طول_مصفوفة(التسلسلات):
            // إنشاء تسلسل إجماع
            متغير إجماع: نص = إنشاء_إجماع(المحاذاة_الناتجة)
            
            // محاذاة التسلسل الجديد مع الإجماع
            نتيجة = محاذي.محاذاة(إجماع، التسلسلات[ف])
            
            // إضافة الفجوات للتسلسلات السابقة
            المحاذاة_الناتجة = تحديث_فجوات(المحاذاة_الناتجة، إجماع، نتيجة.المحاذاة_الأولى)
            
            // إضافة التسلسل الجديد
            مصفوفة_أضف(المحاذاة_الناتجة، نتيجة.المحاذاة_الثانية)
        نهاية
        
        أرجع المحاذاة_الناتجة
    نهاية
    
    // إنشاء تسلسل إجماع
    خاص دالة إنشاء_إجماع(محاذاة: مصفوفة[نص]) -> نص:
        إذا طول_مصفوفة(محاذاة) == 0:
            أرجع ""
        نهاية
        
        متغير طول_محاذاة: عدد = طول(محاذاة[0])
        متغير إجماع: نص = ""
        
        لكل موقع من 0 حتى طول_محاذاة:
            // عد الحروف في هذا الموقع
            متغير أعداد: خريطة[حرف، عدد] = خريطة[حرف، عدد]()
            
            لكل تسلسل في محاذاة:
                إذا موقع < طول(تسلسل) و تسلسل[موقع] != '-':
                    أعداد[تسلسل[موقع]] = أعداد[تسلسل[موقع]] + 1
                نهاية
            نهاية
            
            // إيجاد الأكثر شيوعاً
            متغير أفضل_حرف: حرف = '-'
            متغير أفضل_عدد: عدد = 0
            لكل (حرف، عدد) في أعداد:
                إذا عدد > أفضل_عدد:
                    أفضل_حرف = حرف
                    أفضل_عدد = عدد
                نهاية
            نهاية
            
            إجماع = إجماع + أفضل_حرف
        نهاية
        
        أرجع إجماع
    نهاية
    
    خاص دالة تحديث_فجوات(محاذاة: مصفوفة[نص]، إجماع_قديم: نص، إجماع_جديد: نص) -> مصفوفة[نص]:
        // تبسيط: إرجاع نفس المحاذاة
        أرجع محاذاة
    نهاية
    
    // حساب درجة الحفظ لكل موقع
    دالة درجات_الحفظ() -> مصفوفة[عشري]:
        متغير درجات: مصفوفة[عشري] = مصفوفة[عشري]()
        
        إذا طول_مصفوفة(المحاذاة_الناتجة) == 0:
            أرجع درجات
        نهاية
        
        متغير طول_محاذاة: عدد = طول(المحاذاة_الناتجة[0])
        متغير عدد_التسلسلات: عدد = طول_مصفوفة(المحاذاة_الناتجة)
        
        لكل موقع من 0 حتى طول_محاذاة:
            متغير أعداد: خريطة[حرف، عدد] = خريطة[حرف، عدد]()
            متغير غير_فجوات: عدد = 0
            
            لكل تسلسل في المحاذاة_الناتجة:
                إذا موقع < طول(تسلسل):
                    متغير ح: حرف = تسلسل[موقع]
                    إذا ح != '-':
                        أعداد[ح] = أعداد[ح] + 1
                        غير_فجوات = غير_فجوات + 1
                    نهاية
                نهاية
            نهاية
            
            // حساب درجة الحفظ (أكثر حرف شيوعاً / عدد غير الفجوات)
            متغير أقصى_عدد: عدد = 0
            لكل (_, عدد) في أعداد:
                إذا عدد > أقصى_عدد:
                    أقصى_عدد = عدد
                نهاية
            نهاية
            
            إذا غير_فجوات > 0:
                مصفوفة_أضف(درجات، كعشري(أقصى_عدد) / كعشري(غير_فجوات))
            وإلا:
                مصفوفة_أضف(درجات، 0.0)
            نهاية
        نهاية
        
        أرجع درجات
    نهاية
نهاية

// ============== تنسيق النتائج ==============

دالة تنسيق_محاذاة(نتيجة: نتيجة_محاذاة، عرض: عدد = 60) -> نص:
    متغير ناتج: نص = ""
    متغير طول: عدد = طول(نتيجة.المحاذاة_الأولى)
    
    ناتج = ناتج + "النقاط: " + كنص(نتيجة.النقاط) + "\n"
    ناتج = ناتج + "الهوية: " + كنص(نتيجة.الهوية) + "%\n"
    ناتج = ناتج + "الفجوات: " + كنص(نتيجة.الفجوات) + "\n\n"
    
    لكل بداية من 0 حتى طول بخطوة عرض:
        متغير نهاية: عدد = أدنى(بداية + عرض، طول)
        
        ناتج = ناتج + "تسلسل1: " + نتيجة.المحاذاة_الأولى[بداية:نهاية] + "\n"
        
        // سطر المقارنة
        ناتج = ناتج + "         "
        لكل ف من بداية حتى نهاية:
            إذا نتيجة.المحاذاة_الأولى[ف] == نتيجة.المحاذاة_الثانية[ف]:
                إذا نتيجة.المحاذاة_الأولى[ف] != '-':
                    ناتج = ناتج + "|"
                وإلا:
                    ناتج = ناتج + " "
                نهاية
            وإلا:
                ناتج = ناتج + " "
            نهاية
        نهاية
        ناتج = ناتج + "\n"
        
        ناتج = ناتج + "تسلسل2: " + نتيجة.المحاذاة_الثانية[بداية:نهاية] + "\n\n"
    نهاية
    
    أرجع ناتج
نهاية

// ============== دوال مساعدة ==============

دالة أقصى٣(أ: عدد، ب: عدد، ج: عدد) -> عدد:
    متغير م: عدد = أ
    إذا ب > م:
        م = ب
    نهاية
    إذا ج > م:
        م = ج
    نهاية
    أرجع م
نهاية

دالة أقصى٤(أ: عدد، ب: عدد، ج: عدد، د: عدد) -> عدد:
    أرجع أقصى٣(أقصى٣(أ، ب، ج)، د، د)
نهاية

دالة موقع_حرف(نص: نص، حرف: حرف) -> عدد:
    لكل ف من 0 حتى طول(نص):
        إذا نص[ف] == حرف:
            أرجع ف
        نهاية
    نهاية
    أرجع -1
نهاية

دالة أدنى(أ: عدد، ب: عدد) -> عدد:
    إذا أ < ب:
        أرجع أ
    نهاية
    أرجع ب
نهاية
