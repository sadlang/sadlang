/**
 * ===================================================================================
 *  طي البروتينات - Protein Folding DSL (T472)
 * ===================================================================================
 * 
 *  الوصف: لغة تخصصية لمحاكاة طي البروتينات
 *  Description: Domain-specific language for protein folding simulation
 * 
 *  المميزات:
 *  - تمثيل البنية الثانوية والثالثية
 *  - حساب الطاقة
 *  - محاكاة الطي
 *  - تحليل الاستقرار
 * 
 * ===================================================================================
 */

// ============== الثوابت الفيزيائية ==============

ثابت ثابت_بولتزمان: عشري = 1.380649e-23  // J/K
ثابت حرارة_الغرفة: عشري = 298.15         // كلفن
ثابت ط: عشري = 3.14159265358979

// ============== إحداثيات ثلاثية الأبعاد ==============

هيكل متجه٣ {
    س: عشري = 0.0
    ص: عشري = 0.0
    ع: عشري = 0.0
نهاية

دالة متجه٣_جديد(س: عشري، ص: عشري، ع: عشري) -> متجه٣:
    متغير م: متجه٣
    م.س = س
    م.ص = ص
    م.ع = ع
    أرجع م
نهاية

دالة مسافة(أ: متجه٣، ب: متجه٣) -> عشري:
    متغير دس: عشري = ب.س - أ.س
    متغير دص: عشري = ب.ص - أ.ص
    متغير دع: عشري = ب.ع - أ.ع
    أرجع جذر(دس * دس + دص * دص + دع * دع)
نهاية

دالة زاوية(أ: متجه٣، ب: متجه٣، ج: متجه٣) -> عشري:
    // حساب الزاوية ABC
    متغير با: متجه٣ = متجه٣_جديد(أ.س - ب.س، أ.ص - ب.ص، أ.ع - ب.ع)
    متغير بج: متجه٣ = متجه٣_جديد(ج.س - ب.س، ج.ص - ب.ص، ج.ع - ب.ع)
    
    متغير نقطي: عشري = با.س * بج.س + با.ص * بج.ص + با.ع * بج.ع
    متغير طول_با: عشري = جذر(با.س * با.س + با.ص * با.ص + با.ع * با.ع)
    متغير طول_بج: عشري = جذر(بج.س * بج.س + بج.ص * بج.ص + بج.ع * بج.ع)
    
    إذا طول_با < 0.0001 أو طول_بج < 0.0001:
        أرجع 0.0
    نهاية
    
    متغير جتا_زاوية: عشري = نقطي / (طول_با * طول_بج)
    // تقييد القيمة
    إذا جتا_زاوية > 1.0:
        جتا_زاوية = 1.0
    نهاية
    إذا جتا_زاوية < -1.0:
        جتا_زاوية = -1.0
    نهاية
    
    أرجع قوس_جتا(جتا_زاوية)
نهاية

// ============== خصائص الأحماض الأمينية ==============

تعداد نوع_حمض_أميني {
    ألانين،
    أرجينين،
    أسباراجين،
    أسبارتات،
    سيستين،
    جلوتامات،
    جلوتامين،
    جلايسين،
    هيستيدين،
    آيزوليوسين،
    ليوسين،
    لايسين،
    ميثيونين،
    فينيل_ألانين،
    برولين،
    سيرين،
    ثريونين،
    تربتوفان،
    تيروسين،
    فالين
نهاية

هيكل خصائص_حمض {
    كاره_للماء: عشري    // مقياس كايت-دوليتل
    حجم: عشري           // Å³
    شحنة: عشري          // عند pH 7
    قطبي: منطقي
نهاية

دالة خصائص_حمض_أميني(نوع: نوع_حمض_أميني) -> خصائص_حمض:
    متغير خ: خصائص_حمض
    
    تطابق نوع:
        حالة نوع_حمض_أميني.ألانين:
            خ.كاره_للماء = 1.8
            خ.حجم = 88.6
            خ.شحنة = 0.0
            خ.قطبي = خطأ
            
        حالة نوع_حمض_أميني.أرجينين:
            خ.كاره_للماء = -4.5
            خ.حجم = 173.4
            خ.شحنة = 1.0
            خ.قطبي = صحيح
            
        حالة نوع_حمض_أميني.ليوسين:
            خ.كاره_للماء = 3.8
            خ.حجم = 166.7
            خ.شحنة = 0.0
            خ.قطبي = خطأ
            
        حالة نوع_حمض_أميني.آيزوليوسين:
            خ.كاره_للماء = 4.5
            خ.حجم = 166.7
            خ.شحنة = 0.0
            خ.قطبي = خطأ
            
        حالة نوع_حمض_أميني.فالين:
            خ.كاره_للماء = 4.2
            خ.حجم = 140.0
            خ.شحنة = 0.0
            خ.قطبي = خطأ
            
        حالة نوع_حمض_أميني.سيرين:
            خ.كاره_للماء = -0.8
            خ.حجم = 89.0
            خ.شحنة = 0.0
            خ.قطبي = صحيح
            
        حالة نوع_حمض_أميني.جلايسين:
            خ.كاره_للماء = -0.4
            خ.حجم = 60.1
            خ.شحنة = 0.0
            خ.قطبي = خطأ
            
        حالة _:
            // قيم افتراضية
            خ.كاره_للماء = 0.0
            خ.حجم = 100.0
            خ.شحنة = 0.0
            خ.قطبي = خطأ
    نهاية
    
    أرجع خ
نهاية

// ============== البنية الثانوية ==============

تعداد بنية_ثانوية {
    ملف،           // Coil
    لولب_ألفا،     // Alpha helix
    صفيحة_بيتا،    // Beta sheet
    دورة،          // Turn
    جسر_بيتا       // Beta bridge
نهاية

هيكل بقايا {
    النوع: نوع_حمض_أميني
    الرقم: عدد
    الموضع_CA: متجه٣         // ذرة ألفا كربون
    الموضع_N: متجه٣          // ذرة نيتروجين
    الموضع_C: متجه٣          // ذرة كربونيل
    الموضع_O: متجه٣          // ذرة أكسجين
    البنية: بنية_ثانوية = بنية_ثانوية.ملف
    فاي: عشري = 0.0          // زاوية Phi
    بساي: عشري = 0.0         // زاوية Psi
نهاية

// ============== حساب الطاقة ==============

هيكل حقل_قوة {
    // معاملات الروابط
    ثابت_رابطة: عشري = 300.0    // kcal/(mol·Å²)
    طول_رابطة_CC: عشري = 1.54   // Å
    طول_رابطة_CN: عشري = 1.47
    طول_رابطة_CO: عشري = 1.23
    
    // معاملات الزوايا
    ثابت_زاوية: عشري = 50.0     // kcal/(mol·rad²)
    
    // معاملات فان دير فالس
    إبسيلون: عشري = 0.1         // kcal/mol
    سيجما: عشري = 3.4           // Å
    
    // معاملات الروابط الهيدروجينية
    طاقة_رابطة_H: عشري = -3.0   // kcal/mol
    مسافة_رابطة_H_مثلى: عشري = 2.9  // Å
نهاية

صنف حاسب_الطاقة {
    خاص الحقل: حقل_قوة
    
    دالة بناء():
        الحقل = حقل_قوة()
    نهاية
    
    // ============== طاقة الروابط ==============
    
    دالة طاقة_رابطة(م١: متجه٣، م٢: متجه٣، طول_مثالي: عشري) -> عشري:
        متغير د: عشري = مسافة(م١، م٢)
        متغير فرق: عشري = د - طول_مثالي
        أرجع 0.5 * الحقل.ثابت_رابطة * فرق * فرق
    نهاية
    
    // ============== طاقة الزوايا ==============
    
    دالة طاقة_زاوية(أ: متجه٣، ب: متجه٣، ج: متجه٣، زاوية_مثالية: عشري) -> عشري:
        متغير ز: عشري = زاوية(أ، ب، ج)
        متغير فرق: عشري = ز - زاوية_مثالية
        أرجع 0.5 * الحقل.ثابت_زاوية * فرق * فرق
    نهاية
    
    // ============== طاقة فان دير فالس (Lennard-Jones) ==============
    
    دالة طاقة_LJ(م١: متجه٣، م٢: متجه٣) -> عشري:
        متغير ر: عشري = مسافة(م١، م٢)
        
        إذا ر < 0.001:
            أرجع 1000000.0  // تجنب القسمة على صفر
        نهاية
        
        متغير نسبة: عشري = الحقل.سيجما / ر
        متغير نسبة٦: عشري = قوة(نسبة، 6)
        متغير نسبة١٢: عشري = نسبة٦ * نسبة٦
        
        أرجع 4.0 * الحقل.إبسيلون * (نسبة١٢ - نسبة٦)
    نهاية
    
    // ============== طاقة الرابطة الهيدروجينية ==============
    
    دالة طاقة_رابطة_هيدروجينية(مانح: متجه٣، مستقبل: متجه٣) -> عشري:
        متغير د: عشري = مسافة(مانح، مستقبل)
        
        // دالة طاقة بسيطة
        إذا د > 4.0:  // المسافة القصوى للرابطة الهيدروجينية
            أرجع 0.0
        نهاية
        
        متغير فرق: عشري = د - الحقل.مسافة_رابطة_H_مثلى
        أرجع الحقل.طاقة_رابطة_H * تجا(1.0 + فرق * فرق)
    نهاية
    
    // ============== طاقة كارهة للماء ==============
    
    دالة طاقة_كارهة_للماء(بقايا١: بقايا، بقايا٢: بقايا) -> عشري:
        متغير خ١: خصائص_حمض = خصائص_حمض_أميني(بقايا١.النوع)
        متغير خ٢: خصائص_حمض = خصائص_حمض_أميني(بقايا٢.النوع)
        
        متغير د: عشري = مسافة(بقايا١.الموضع_CA، بقايا٢.الموضع_CA)
        
        إذا د > 8.0:  // مسافة القطع
            أرجع 0.0
        نهاية
        
        // التأثير الكاره للماء: أقوى عندما كلاهما كاره للماء
        متغير تفاعل: عشري = خ١.كاره_للماء * خ٢.كاره_للماء
        
        إذا تفاعل > 0:  // كلاهما كاره للماء
            أرجع -0.1 * تفاعل / د
        نهاية
        
        أرجع 0.0
    نهاية
    
    // ============== الطاقة الكلية ==============
    
    دالة طاقة_كلية(بقايا: مصفوفة[بقايا]) -> عشري:
        متغير طاقة: عشري = 0.0
        متغير ن: عدد = طول_مصفوفة(بقايا)
        
        // طاقة الروابط (CA-CA)
        لكل ف من 0 حتى ن - 1:
            طاقة = طاقة + طاقة_رابطة(
                بقايا[ف].الموضع_CA،
                بقايا[ف + 1].الموضع_CA،
                3.8  // مسافة CA-CA نموذجية
            )
        نهاية
        
        // تفاعلات غير رابطية
        لكل ف من 0 حتى ن - 1:
            لكل ج من ف + 3 حتى ن:  // تخطي الجيران القريبين
                // فان دير فالس
                طاقة = طاقة + طاقة_LJ(
                    بقايا[ف].الموضع_CA،
                    بقايا[ج].الموضع_CA
                )
                
                // تأثير كاره للماء
                طاقة = طاقة + طاقة_كارهة_للماء(بقايا[ف]، بقايا[ج])
            نهاية
        نهاية
        
        أرجع طاقة
    نهاية
نهاية

// ============== محاكي الطي ==============

صنف محاكي_طي_بروتين {
    خاص البقايا: مصفوفة[بقايا]
    خاص الحاسب: حاسب_الطاقة
    خاص الحرارة: عشري = 300.0  // كلفن
    خاص خطوات: عدد = 0
    
    دالة بناء(تسلسل: نص):
        الحاسب = حاسب_الطاقة()
        تهيئة_سلسلة_خطية(تسلسل)
    نهاية
    
    // تهيئة البروتين كسلسلة خطية ممتدة
    خاص دالة تهيئة_سلسلة_خطية(تسلسل: نص):
        البقايا = مصفوفة[بقايا]()
        
        لكل ف من 0 حتى طول(تسلسل):
            متغير ب: بقايا
            ب.الرقم = ف
            
            // موضع خطي
            ب.الموضع_CA = متجه٣_جديد(
                كعشري(ف) * 3.8،  // مسافة CA-CA
                0.0،
                0.0
            )
            
            // تحويل الحرف لنوع حمض أميني
            ب.النوع = حرف_إلى_حمض(تسلسل[ف])
            
            مصفوفة_أضف(البقايا، ب)
        نهاية
    نهاية
    
    // ============== خطوة مونتي كارلو ==============
    
    دالة خطوة_مونتي_كارلو() -> منطقي:
        إذا طول_مصفوفة(البقايا) < 2:
            أرجع خطأ
        نهاية
        
        // اختيار بقايا عشوائية
        متغير فهرس: عدد = عشوائي_عدد(0، طول_مصفوفة(البقايا) - 1)
        
        // حفظ الموضع القديم
        متغير موضع_قديم: متجه٣ = البقايا[فهرس].الموضع_CA
        
        // حساب الطاقة الحالية
        متغير طاقة_قديمة: عشري = الحاسب.طاقة_كلية(البقايا)
        
        // تحريك عشوائي
        متغير دس: عشري = (عشوائي() - 0.5) * 0.5
        متغير دص: عشري = (عشوائي() - 0.5) * 0.5
        متغير دع: عشري = (عشوائي() - 0.5) * 0.5
        
        البقايا[فهرس].الموضع_CA = متجه٣_جديد(
            موضع_قديم.س + دس،
            موضع_قديم.ص + دص،
            موضع_قديم.ع + دع
        )
        
        // حساب الطاقة الجديدة
        متغير طاقة_جديدة: عشري = الحاسب.طاقة_كلية(البقايا)
        
        // معيار متروبوليس
        متغير فرق_طاقة: عشري = طاقة_جديدة - طاقة_قديمة
        
        إذا فرق_طاقة < 0:
            // قبول الحركة (طاقة أقل)
            خطوات = خطوات + 1
            أرجع صحيح
        وإلا:
            // احتمال القبول
            متغير احتمال: عشري = تجا(-فرق_طاقة / (ثابت_بولتزمان * الحرارة))
            
            إذا عشوائي() < احتمال:
                خطوات = خطوات + 1
                أرجع صحيح
            وإلا:
                // رفض الحركة
                البقايا[فهرس].الموضع_CA = موضع_قديم
                أرجع خطأ
            نهاية
        نهاية
    نهاية
    
    // ============== محاكاة كاملة ==============
    
    دالة محاكاة(عدد_الخطوات: عدد) -> عشري:
        متغير قبول: عدد = 0
        
        لكل _ من 0 حتى عدد_الخطوات:
            إذا خطوة_مونتي_كارلو():
                قبول = قبول + 1
            نهاية
        نهاية
        
        // إرجاع نسبة القبول
        أرجع كعشري(قبول) / كعشري(عدد_الخطوات)
    نهاية
    
    // ============== التبريد المحاكى ==============
    
    دالة تبريد_محاكى(حرارة_بداية: عشري، حرارة_نهاية: عشري، خطوات_لكل_حرارة: عدد):
        متغير عامل_تبريد: عشري = 0.95
        الحرارة = حرارة_بداية
        
        طالما الحرارة > حرارة_نهاية:
            محاكاة(خطوات_لكل_حرارة)
            الحرارة = الحرارة * عامل_تبريد
        نهاية
    نهاية
    
    // ============== التحليل ==============
    
    دالة الطاقة_الحالية() -> عشري:
        أرجع الحاسب.طاقة_كلية(البقايا)
    نهاية
    
    دالة نصف_قطر_الدوران() -> عشري:
        // Radius of gyration
        متغير ن: عدد = طول_مصفوفة(البقايا)
        إذا ن == 0:
            أرجع 0.0
        نهاية
        
        // حساب مركز الكتلة
        متغير مركز: متجه٣ = متجه٣_جديد(0.0، 0.0، 0.0)
        لكل ب في البقايا:
            مركز.س = مركز.س + ب.الموضع_CA.س
            مركز.ص = مركز.ص + ب.الموضع_CA.ص
            مركز.ع = مركز.ع + ب.الموضع_CA.ع
        نهاية
        مركز.س = مركز.س / كعشري(ن)
        مركز.ص = مركز.ص / كعشري(ن)
        مركز.ع = مركز.ع / كعشري(ن)
        
        // حساب نصف قطر الدوران
        متغير مجموع: عشري = 0.0
        لكل ب في البقايا:
            متغير د: عشري = مسافة(ب.الموضع_CA، مركز)
            مجموع = مجموع + د * د
        نهاية
        
        أرجع جذر(مجموع / كعشري(ن))
    نهاية
    
    دالة عدد_الخطوات_المقبولة() -> عدد:
        أرجع خطوات
    نهاية
نهاية

// ============== دوال مساعدة ==============

دالة حرف_إلى_حمض(ح: حرف) -> نوع_حمض_أميني:
    تطابق ح:
        حالة 'A': أرجع نوع_حمض_أميني.ألانين
        حالة 'R': أرجع نوع_حمض_أميني.أرجينين
        حالة 'N': أرجع نوع_حمض_أميني.أسباراجين
        حالة 'D': أرجع نوع_حمض_أميني.أسبارتات
        حالة 'C': أرجع نوع_حمض_أميني.سيستين
        حالة 'E': أرجع نوع_حمض_أميني.جلوتامات
        حالة 'Q': أرجع نوع_حمض_أميني.جلوتامين
        حالة 'G': أرجع نوع_حمض_أميني.جلايسين
        حالة 'H': أرجع نوع_حمض_أميني.هيستيدين
        حالة 'I': أرجع نوع_حمض_أميني.آيزوليوسين
        حالة 'L': أرجع نوع_حمض_أميني.ليوسين
        حالة 'K': أرجع نوع_حمض_أميني.لايسين
        حالة 'M': أرجع نوع_حمض_أميني.ميثيونين
        حالة 'F': أرجع نوع_حمض_أميني.فينيل_ألانين
        حالة 'P': أرجع نوع_حمض_أميني.برولين
        حالة 'S': أرجع نوع_حمض_أميني.سيرين
        حالة 'T': أرجع نوع_حمض_أميني.ثريونين
        حالة 'W': أرجع نوع_حمض_أميني.تربتوفان
        حالة 'Y': أرجع نوع_حمض_أميني.تيروسين
        حالة 'V': أرجع نوع_حمض_أميني.فالين
        حالة _: أرجع نوع_حمض_أميني.جلايسين  // افتراضي
    نهاية
نهاية

// دوال رياضية مساعدة
دالة جذر(س: عشري) -> عشري:
    أرجع 0.0  // تنفيذ داخلي
نهاية

دالة قوة(أساس: عشري، أس: عدد) -> عشري:
    أرجع 0.0  // تنفيذ داخلي
