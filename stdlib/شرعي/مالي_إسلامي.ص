// مكتبة المالية الإسلامية — مرابحة/مضاربة/إجارة/استصناع
// ملف بلغة ص — المكتبة القياسية

// === مكتبة المالية الإسلامية ===
// تنفيذ العقود المالية الإسلامية الأساسية

// --- المرابحة ---
// بيع بتكلفة + ربح معلوم
هيكل مرابحة {
    نص اسم_السلعة;
    عدد_حقيقي تكلفة_الشراء;
    عدد_حقيقي نسبة_الربح;    // مثال: 0.15 = 15%
    عدد_صحيح عدد_الأقساط;
}

دالة سعر_البيع(مرابحة م) -> عدد_حقيقي {
    ارجع م.تكلفة_الشراء * (1.0 + م.نسبة_الربح);
}

دالة قسط_شهري(مرابحة م) -> عدد_حقيقي {
    ارجع سعر_البيع(م) / م.عدد_الأقساط;
}

// --- المضاربة ---
// شراكة: رأس مال من طرف + عمل من طرف
هيكل مضاربة {
    نص اسم_المشروع;
    عدد_حقيقي رأس_المال;
    عدد_حقيقي نسبة_ربح_المالك;    // مثال: 0.60
    عدد_حقيقي نسبة_ربح_العامل;    // مثال: 0.40
}

دالة توزيع_أرباح(مضاربة م, عدد_حقيقي ربح) -> (عدد_حقيقي, عدد_حقيقي) {
    ثابت حصة_المالك = ربح * م.نسبة_ربح_المالك;
    ثابت حصة_العامل = ربح * م.نسبة_ربح_العامل;
    ارجع (حصة_المالك, حصة_العامل);
}

// --- الإجارة ---
// تأجير أصل مع إمكانية التملك
هيكل إجارة {
    نص وصف_الأصل;
    عدد_حقيقي قيمة_الأصل;
    عدد_حقيقي إيجار_شهري;
    عدد_صحيح مدة_الأشهر;
    منطقي ينتهي_بالتملك;
}

دالة إجمالي_الإيجار(إجارة إ) -> عدد_حقيقي {
    ارجع إ.إيجار_شهري * إ.مدة_الأشهر;
}

دالة قيمة_التملك(إجارة إ) -> عدد_حقيقي {
    إذا (إ.ينتهي_بالتملك) {
        ارجع إ.قيمة_الأصل - إجمالي_الإيجار(إ);
    }
    ارجع إ.قيمة_الأصل;
}

// --- الاستصناع ---
// عقد تصنيع بمواصفات محددة
هيكل استصناع {
    نص وصف_المنتج;
    عدد_حقيقي السعر_المتفق;
    عدد_صحيح مدة_التسليم_أيام;
    قائمة<نص> المواصفات;
}

// --- الزكاة ---
دالة حساب_زكاة_المال(عدد_حقيقي مبلغ, عدد_حقيقي نصاب) -> عدد_حقيقي {
    إذا (مبلغ >= نصاب) {
        ارجع مبلغ * 0.025;  // 2.5%
    }
    ارجع 0.0;
}

// --- التحقق الشرعي ---
دالة هل_يحتوي_ربا(نص عقد) -> منطقي {
    // فحص العقد للكشف عن الربا
    ارجع عقد.يحتوي("فائدة") أو عقد.يحتوي("ربا");
}

دالة هل_يحتوي_غرر(نص عقد) -> منطقي {
    // فحص الغرر (الجهالة المفرطة)
    ارجع عقد.يحتوي("مجهول") أو عقد.يحتوي("غرر");
}
