/**
 * (AR) خطأ الإرسال - يحدث عند إغلاق المستقبل
 */
عام هيكل خطأ_إرسال<ن>(عام ن)؛

تنفيذ<ن> خطأ_إرسال<ن> {
    /**
     * (AR) استرجاع القيمة التي فشل إرسالها
     */
    عام دالة إلى_قيمة(ذات) -> ن {
        ذات.0
    }
}

/**
 * (AR) خطأ الاستقبال - يحدث عند إغلاق المرسل
 */
عام هيكل خطأ_استقبال؛

/**
 * (AR) خطأ المحاولة - للعمليات غير المحجوبة
 */
عام تعداد خطأ_محاولة_إرسال<ن> {
    ممتلئ(ن)،         // (AR) القناة ممتلئة
    مغلق(ن)           // (AR) القناة مغلقة
}

عام تعداد خطأ_محاولة_استقبال {
    فارغ،              // (AR) القناة فارغة
    مغلق              // (AR) القناة مغلقة
}

