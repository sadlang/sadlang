/**
 * (AR) قناة تحافظ على آخر قيمة فقط
 */
عام هيكل مرسل_ساعة<ن: استنساخ> {
    حالة: قوس<قفل_دوار<(ن، عدد_صحيح_64، مصفوفة<منبه>)>>
}

تنفيذ<ن: استنساخ> مرسل_ساعة<ن> {
    عام دالة أرسل(&ذات، قيمة: ن) {
        دع متغير حالة = ذات.حالة.أقفل()؛
        حالة.0 = قيمة؛
        حالة.1 += 1؛
        
        لكل منبه في حالة.2.استنزف(..) {
            منبه.أنبه()؛
        }
    }
    
    عام دالة اشترك(&ذات) -> مستقبل_ساعة<ن> {
        دع حالة = ذات.حالة.أقفل()؛
        مستقبل_ساعة {
            حالة: قوس::استنسخ(&ذات.حالة)،
            آخر_رقم: حالة.1
        }
    }
}

عام هيكل مستقبل_ساعة<ن: استنساخ> {
    حالة: قوس<قفل_دوار<(ن، عدد_صحيح_64، مصفوفة<منبه>)>>،
    آخر_رقم: عدد_صحيح_64
}

تنفيذ<ن: استنساخ> مستقبل_ساعة<ن> {
    عام دالة أحدث(&ذات) -> ن {
        ذات.حالة.أقفل().0.استنسخ()
    }
    
    عام غير_متزامن دالة تغير(&متغير ذات) -> ن {
        حلقة {
            {
                دع حالة = ذات.حالة.أقفل()؛
                إذا حالة.1 > ذات.آخر_رقم {
                    ذات.آخر_رقم = حالة.1؛
                    أرجع حالة.0.استنسخ()؛
                }
            }
            
            انتظر انتظار_ساعة { حالة: قوس::استنسخ(&ذات.حالة) }؛
        }
    }
}

هيكل انتظار_ساعة<ن: استنساخ> {
    حالة: قوس<قفل_دوار<(ن، عدد_صحيح_64، مصفوفة<منبه>)>>
}

تنفيذ<ن: استنساخ> مستقبل لـ انتظار_ساعة<ن> {
    نوع ناتج = ()؛
    
    دالة استطلع(&متغير ذات، سياق: &متغير سياق) -> حالة_استطلاع<()> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        حالة.2.ادفع(سياق.منبه().استنسخ())؛
        حالة_استطلاع::معلق
    }
}

/**
 * (AR) إنشاء قناة ساعة
 */
عام دالة ساعة<ن: استنساخ>(قيمة_ابتدائية: ن) -> (مرسل_ساعة<ن>، مستقبل_ساعة<ن>) {
    دع حالة = قوس::جديد(قفل_دوار::جديد((قيمة_ابتدائية، 0، مصفوفة::جديد())))؛
    
    (
        مرسل_ساعة { حالة: قوس::استنسخ(&حالة) }،
        مستقبل_ساعة { حالة: حالة، آخر_رقم: 0 }
    )
}

