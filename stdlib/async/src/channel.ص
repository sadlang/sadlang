//                    (AR) مستقبلات الانتظار
//                    (EN) Wait Futures
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) مستقبل انتظار الإرسال
 */
هيكل انتظار_مرسل<ن> {
    حالة: قوس<قفل_دوار<حالة_قناة<ن>>>
}

تنفيذ<ن> مستقبل لـ انتظار_مرسل<ن> {
    نوع ناتج = ()؛
    
    دالة استطلع(&متغير ذات، سياق: &متغير سياق) -> حالة_استطلاع<()> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        
        إذا !حالة.ممتلئ() || حالة.مغلق {
            حالة_استطلاع::جاهز(())
        } وإلا {
            حالة.منبهات_مرسلين.ادفع(سياق.منبه().استنسخ())؛
            حالة_استطلاع::معلق
        }
    }
}

/**
 * (AR) مستقبل انتظار الاستقبال
 */
هيكل انتظار_مستقبل<ن> {
    حالة: قوس<قفل_دوار<حالة_قناة<ن>>>
}

تنفيذ<ن> مستقبل لـ انتظار_مستقبل<ن> {
    نوع ناتج = ()؛
    
    دالة استطلع(&متغير ذات، سياق: &متغير سياق) -> حالة_استطلاع<()> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        
        إذا !حالة.طابور.فارغ() || حالة.عدد_المرسلين == 0 {
            حالة_استطلاع::جاهز(())
        } وإلا {
            حالة.منبهات_مستقبلين.ادفع(سياق.منبه().استنسخ())؛
            حالة_استطلاع::معلق
        }
    }
}

