/**
 * (AR) إنشاء قناة غير محدودة
 */
عام دالة قناة<ن>() -> (مرسل<ن>، مستقبل_قناة<ن>) {
    دع حالة = قوس::جديد(قفل_دوار::جديد(حالة_قناة::جديد(لا_شيء)))؛
    
    (
        مرسل { حالة: قوس::استنسخ(&حالة) }،
        مستقبل_قناة { حالة: حالة }
    )
}

/**
 * (AR) إنشاء قناة محدودة
 */
عام دالة قناة_محدودة<ن>(سعة: عدد) -> (مرسل<ن>، مستقبل_قناة<ن>) {
    دع حالة = قوس::جديد(قفل_دوار::جديد(حالة_قناة::جديد(بعض(سعة))))؛
    
    (
        مرسل { حالة: قوس::استنسخ(&حالة) }،
        مستقبل_قناة { حالة: حالة }
    )
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) قناة لمرة واحدة (Oneshot)
//                    (EN) Oneshot Channel
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) حالة قناة لمرة واحدة
 */
هيكل حالة_لمرة<ن> {
    قيمة: اختياري<ن>،
    مكتمل: منطقي،
    منبه: اختياري<منبه>
}

/**
 * (AR) مرسل لمرة واحدة
 */
عام هيكل مرسل_لمرة<ن> {
    حالة: قوس<قفل_دوار<حالة_لمرة<ن>>>
}

تنفيذ<ن> مرسل_لمرة<ن> {
    /**
     * (AR) إرسال القيمة (يستهلك المرسل)
     */
    عام دالة أرسل(ذات، قيمة: ن) -> نتيجة<()، ن> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        
        إذا حالة.مكتمل {
            أرجع خطأ(قيمة)؛
        }
        
        حالة.قيمة = بعض(قيمة)؛
        حالة.مكتمل = صحيح؛
        
        إذا دع بعض(منبه) = حالة.منبه.خذ() {
            منبه.أنبه()؛
        }
        
        موافق(())
    }
}

/**
 * (AR) مستقبل لمرة واحدة
 */
عام هيكل مستقبل_لمرة<ن> {
    حالة: قوس<قفل_دوار<حالة_لمرة<ن>>>
}

تنفيذ<ن> مستقبل لـ مستقبل_لمرة<ن> {
    نوع ناتج = نتيجة<ن، خطأ_استقبال>؛
    
    دالة استطلع(&متغير ذات، سياق: &متغير سياق) -> حالة_استطلاع<نتيجة<ن، خطأ_استقبال>> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        
        إذا دع بعض(قيمة) = حالة.قيمة.خذ() {
            حالة_استطلاع::جاهز(موافق(قيمة))
        } وإلا إذا حالة.مكتمل {
            حالة_استطلاع::جاهز(خطأ(خطأ_استقبال))
        } وإلا {
            حالة.منبه = بعض(سياق.منبه().استنسخ())؛
            حالة_استطلاع::معلق
        }
    }
}

/**
 * (AR) إنشاء قناة لمرة واحدة
 */
عام دالة لمرة<ن>() -> (مرسل_لمرة<ن>، مستقبل_لمرة<ن>) {
    دع حالة = قوس::جديد(قفل_دوار::جديد(حالة_لمرة {
        قيمة: لا_شيء،
        مكتمل: خطأ،
        منبه: لا_شيء
    }))؛
    
    (
        مرسل_لمرة { حالة: قوس::استنسخ(&حالة) }،
        مستقبل_لمرة { حالة: حالة }
    )
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) قناة البث (Broadcast)
//                    (EN) Broadcast Channel
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) حالة قناة البث
 */
هيكل حالة_بث<ن: استنساخ> {
    طابور: طابور<(عدد_صحيح_64، ن)>،    // (AR) (رقم تسلسلي، قيمة)
    رقم_تسلسلي: عدد_صحيح_64،
    سعة: عدد،
    عدد_المستقبلين: عدد_صحيح،
    مغلق: منطقي،
    منبهات: مصفوفة<منبه>
}

/**
 * (AR) مرسل البث
 */
عام هيكل مرسل_بث<ن: استنساخ> {
    حالة: قوس<قفل_دوار<حالة_بث<ن>>>
}

تنفيذ<ن: استنساخ> مرسل_بث<ن> {
    /**
     * (AR) إرسال رسالة لجميع المستقبلين
     */
    عام دالة أرسل(&ذات، قيمة: ن) -> نتيجة<عدد، خطأ_إرسال<ن>> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        
        إذا حالة.مغلق || حالة.عدد_المستقبلين == 0 {
            أرجع خطأ(خطأ_إرسال(قيمة))؛
        }
        
        دع رقم = حالة.رقم_تسلسلي؛
        حالة.رقم_تسلسلي += 1؛
        
        حالة.طابور.أضف((رقم، قيمة))؛
        
        // (AR) احتفظ بالسعة فقط
        بينما حالة.طابور.طول() > حالة.سعة {
            حالة.طابور.اسحب()؛
        }
        
        // (AR) أنبه جميع المستقبلين
        دع عدد = حالة.منبهات.طول() كـ عدد؛
        لكل منبه في حالة.منبهات.استنزف(..) {
            منبه.أنبه()؛
        }
        
        موافق(عدد)
    }
    
    /**
     * (AR) الاشتراك (إنشاء مستقبل جديد)
     */
    عام دالة اشترك(&ذات) -> مستقبل_بث<ن> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        حالة.عدد_المستقبلين += 1؛
        
        مستقبل_بث {
            حالة: قوس::استنسخ(&ذات.حالة)،
            رقم_تسلسلي: حالة.رقم_تسلسلي
        }
    }
}

/**
 * (AR) مستقبل البث
 */
عام هيكل مستقبل_بث<ن: استنساخ> {
    حالة: قوس<قفل_دوار<حالة_بث<ن>>>،
    رقم_تسلسلي: عدد_صحيح_64
}

تنفيذ<ن: استنساخ> استنساخ لـ مستقبل_بث<ن> {
    دالة استنسخ(&ذات) -> مستقبل_بث<ن> {
        ذات.حالة.أقفل().عدد_المستقبلين += 1؛
        مستقبل_بث {
            حالة: قوس::استنسخ(&ذات.حالة)،
            رقم_تسلسلي: ذات.رقم_تسلسلي
        }
    }
}

تنفيذ<ن: استنساخ> إسقاط لـ مستقبل_بث<ن> {
    دالة أسقط(&متغير ذات) {
        ذات.حالة.أقفل().عدد_المستقبلين -= 1؛
    }
}

تنفيذ<ن: استنساخ> مستقبل_بث<ن> {
    /**
     * (AR) استقبال الرسالة التالية
     */
    عام غير_متزامن دالة استقبل(&متغير ذات) -> نتيجة<ن، خطأ_استقبال> {
        حلقة {
            {
                دع حالة = ذات.حالة.أقفل()؛
                
                // (AR) ابحث عن أول رسالة بعد الرقم التسلسلي
                لكل (رقم، قيمة) في حالة.طابور.مكرر() {
                    إذا *رقم >= ذات.رقم_تسلسلي {
                        ذات.رقم_تسلسلي = *رقم + 1؛
                        أرجع موافق(قيمة.استنسخ())؛
                    }
                }
                
                إذا حالة.مغلق {
                    أرجع خطأ(خطأ_استقبال)؛
                }
            }
            
            انتظر انتظار_بث { حالة: قوس::استنسخ(&ذات.حالة) }؛
        }
    }
}

/**
 * (AR) مستقبل انتظار البث
 */
هيكل انتظار_بث<ن: استنساخ> {
    حالة: قوس<قفل_دوار<حالة_بث<ن>>>
}

تنفيذ<ن: استنساخ> مستقبل لـ انتظار_بث<ن> {
    نوع ناتج = ()؛
    
    دالة استطلع(&متغير ذات، سياق: &متغير سياق) -> حالة_استطلاع<()> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        
        إذا !حالة.طابور.فارغ() || حالة.مغلق {
            حالة_استطلاع::جاهز(())
        } وإلا {
            حالة.منبهات.ادفع(سياق.منبه().استنسخ())؛
            حالة_استطلاع::معلق
        }
    }
}

/**
 * (AR) إنشاء قناة بث
 */
عام دالة بث<ن: استنساخ>(سعة: عدد) -> مرسل_بث<ن> {
    دع حالة = قوس::جديد(قفل_دوار::جديد(حالة_بث {
        طابور: طابور::جديد()،
        رقم_تسلسلي: 0،
        سعة: سعة،
        عدد_المستقبلين: 0،
        مغلق: خطأ،
        منبهات: مصفوفة::جديد()
    }))؛
    
    مرسل_بث { حالة: حالة }
}

