//                    (AR) الحالة الداخلية للقناة
//                    (EN) Internal Channel State
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) الحالة المشتركة للقناة
 */
هيكل حالة_قناة<ن> {
    طابور: طابور<ن>،
    مغلق: منطقي،
    عدد_المرسلين: عدد_صحيح،
    منبهات_مستقبلين: مصفوفة<منبه>،
    منبهات_مرسلين: مصفوفة<منبه>،
    سعة: اختياري<عدد>                    // (AR) لا_شيء = غير محدود
}

تنفيذ<ن> حالة_قناة<ن> {
    دالة جديد(سعة: اختياري<عدد>) -> حالة_قناة<ن> {
        حالة_قناة {
            طابور: طابور::جديد()،
            مغلق: خطأ،
            عدد_المرسلين: 1،
            منبهات_مستقبلين: مصفوفة::جديد()،
            منبهات_مرسلين: مصفوفة::جديد()،
            سعة: سعة
        }
    }
    
    دالة ممتلئ(&ذات) -> منطقي {
        طابق ذات.سعة {
            بعض(سعة) => ذات.طابور.طول() >= سعة،
            لا_شيء => خطأ
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) قناة MPSC غير محدودة
//                    (EN) Unbounded MPSC Channel
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) مرسل القناة - يمكن استنساخه لإنشاء مرسلين متعددين
 */
عام هيكل مرسل<ن> {
    حالة: قوس<قفل_دوار<حالة_قناة<ن>>>
}

تنفيذ<ن> استنساخ لـ مرسل<ن> {
    دالة استنسخ(&ذات) -> مرسل<ن> {
        ذات.حالة.أقفل().عدد_المرسلين += 1؛
        مرسل { حالة: قوس::استنسخ(&ذات.حالة) }
    }
}

تنفيذ<ن> إسقاط لـ مرسل<ن> {
    دالة أسقط(&متغير ذات) {
        دع متغير حالة = ذات.حالة.أقفل()؛
        حالة.عدد_المرسلين -= 1؛
        
        إذا حالة.عدد_المرسلين == 0 {
            // (AR) آخر مرسل، أنبه المستقبلين
            لكل منبه في حالة.منبهات_مستقبلين.استنزف(..) {
                منبه.أنبه()؛
            }
        }
    }
}

تنفيذ<ن> مرسل<ن> {
    /**
     * (AR) إرسال قيمة للقناة
     */
    عام دالة أرسل(&ذات، قيمة: ن) -> نتيجة<()، خطأ_إرسال<ن>> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        
        إذا حالة.مغلق {
            أرجع خطأ(خطأ_إرسال(قيمة))؛
        }
        
        حالة.طابور.أضف(قيمة)؛
        
        // (AR) أنبه المستقبلين المنتظرين
        إذا دع بعض(منبه) = حالة.منبهات_مستقبلين.انبثق() {
            منبه.أنبه()؛
        }
        
        موافق(())
    }
    
    /**
     * (AR) إرسال غير متزامن (للقنوات المحدودة)
     */
    عام غير_متزامن دالة أرسل_انتظر(&ذات، قيمة: ن) -> نتيجة<()، خطأ_إرسال<ن>> {
        حلقة {
            {
                دع متغير حالة = ذات.حالة.أقفل()؛
                
                إذا حالة.مغلق {
                    أرجع خطأ(خطأ_إرسال(قيمة))؛
                }
                
                إذا !حالة.ممتلئ() {
                    حالة.طابور.أضف(قيمة)؛
                    
                    إذا دع بعض(منبه) = حالة.منبهات_مستقبلين.انبثق() {
                        منبه.أنبه()؛
                    }
                    
                    أرجع موافق(())؛
                }
            }
            
            // (AR) انتظر حتى تتوفر مساحة
            انتظر انتظار_مرسل { حالة: قوس::استنسخ(&ذات.حالة) }؛
        }
    }
}

/**
 * (AR) مستقبل القناة - فريد (لا يمكن استنساخه)
 */
عام هيكل مستقبل_قناة<ن> {
    حالة: قوس<قفل_دوار<حالة_قناة<ن>>>
}

تنفيذ<ن> إسقاط لـ مستقبل_قناة<ن> {
    دالة أسقط(&متغير ذات) {
        دع متغير حالة = ذات.حالة.أقفل()؛
        حالة.مغلق = صحيح؛
        
        // (AR) أنبه المرسلين المنتظرين
        لكل منبه في حالة.منبهات_مرسلين.استنزف(..) {
            منبه.أنبه()؛
        }
    }
}

تنفيذ<ن> مستقبل_قناة<ن> {
    /**
     * (AR) استقبال قيمة (محجوب)
     */
    عام دالة استقبل(&ذات) -> نتيجة<ن، خطأ_استقبال> {
        حلقة {
            دع متغير حالة = ذات.حالة.أقفل()؛
            
            إذا دع بعض(قيمة) = حالة.طابور.اسحب() {
                // (AR) أنبه المرسلين المنتظرين
                إذا دع بعض(منبه) = حالة.منبهات_مرسلين.انبثق() {
                    منبه.أنبه()؛
                }
                أرجع موافق(قيمة)؛
            }
            
            إذا حالة.عدد_المرسلين == 0 {
                أرجع خطأ(خطأ_استقبال)؛
            }
            
            // (AR) انتظر... (في بيئة حقيقية)
        }
    }
    
    /**
     * (AR) محاولة استقبال (غير محجوب)
     */
    عام دالة حاول_استقبل(&ذات) -> نتيجة<ن، خطأ_محاولة_استقبال> {
        دع متغير حالة = ذات.حالة.أقفل()؛
        
        إذا دع بعض(قيمة) = حالة.طابور.اسحب() {
            إذا دع بعض(منبه) = حالة.منبهات_مرسلين.انبثق() {
                منبه.أنبه()؛
            }
            موافق(قيمة)
        } وإلا إذا حالة.عدد_المرسلين == 0 {
            خطأ(خطأ_محاولة_استقبال::مغلق)
        } وإلا {
            خطأ(خطأ_محاولة_استقبال::فارغ)
        }
    }
    
    /**
     * (AR) استقبال غير متزامن
     */
    عام غير_متزامن دالة استقبل_انتظر(&ذات) -> نتيجة<ن، خطأ_استقبال> {
        حلقة {
            {
                دع متغير حالة = ذات.حالة.أقفل()؛
                
                إذا دع بعض(قيمة) = حالة.طابور.اسحب() {
                    إذا دع بعض(منبه) = حالة.منبهات_مرسلين.انبثق() {
                        منبه.أنبه()؛
                    }
                    أرجع موافق(قيمة)؛
                }
                
                إذا حالة.عدد_المرسلين == 0 {
                    أرجع خطأ(خطأ_استقبال)؛
                }
            }
            
            // (AR) انتظر حتى تتوفر قيمة
            انتظر انتظار_مستقبل { حالة: قوس::استنسخ(&ذات.حالة) }؛
        }
    }
}

