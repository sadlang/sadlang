#[اختبار]
دالة اختبار_منفذ_بسيط() {
    دع منفذ = منفذ::جديد()؛
    
    دع متغير نفذ = خطأ؛
    
    منفذ.أنتج(غير_متزامن {
        نفذ = صحيح؛
    })؛
    
    منفذ.شغل_حتى_الاكتمال()؛
    
    تأكد!(نفذ)؛
}

#[اختبار]
دالة اختبار_تأخير() {
    دع بداية = وقت::الآن()؛
    
    شغل_حتى_الاكتمال(غير_متزامن {
        تأخير(مدة::من_ميلي_ثانية(100)).انتظر؛
    })؛
    
    دع مضى = وقت::الآن().مدة_منذ(بداية)؛
    تأكد!(مضى >= مدة::من_ميلي_ثانية(100))؛
}

#[اختبار]
دالة اختبار_مهام_متعددة() {
    دع نتائج = قوس::جديد(قفل_دوار::جديد(مصفوفة::جديد()))؛
    
    شغل_جميع([
        {
            دع ن = قوس::استنسخ(&نتائج)؛
            غير_متزامن حرك {
                ن.أقفل().ادفع(1)؛
            }
        }،
        {
            دع ن = قوس::استنسخ(&نتائج)؛
            غير_متزامن حرك {
                ن.أقفل().ادفع(2)؛
            }
        }،
        {
            دع ن = قوس::استنسخ(&نتائج)؛
            غير_متزامن حرك {
                ن.أقفل().ادفع(3)؛
            }
        }
    ].مكرر())؛
    
    دع قيم = نتائج.أقفل()؛
    تأكد_يساوي!(قيم.طول()، 3)؛
}
