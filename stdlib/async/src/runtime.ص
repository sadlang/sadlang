استيراد صدى::متزامن::مستقبل { مستقبل، حالة_استطلاع، جاهز، معلق }؛
استيراد صدى::متزامن::قناة { قناة، مرسل، مستقبل_قناة }؛
استيراد صدى::مجموعات::طابور { طابور }؛
استيراد صدى::مجموعات::خريطة { خريطة }؛
استيراد صدى::خيوط::خيط؛
استيراد صدى::خيوط::قفل_دوار؛
استيراد صدى::وقت::مدة؛

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) معرفات المهام
//                    (EN) Task Identifiers
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) معرف فريد للمهمة
 */
نوع معرف_مهمة = عدد_صحيح_64؛

/**
 * (AR) عداد المعرفات
 */
متغير_عام عداد_المعرفات: ذري<عدد_صحيح_64> = ذري::جديد(0)؛

/**
 * (AR) توليد معرف جديد
 */
دالة معرف_جديد() -> معرف_مهمة {
    أرجع عداد_المعرفات.زد_واحصل(1)؛
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) حالات المهمة
//                    (EN) Task States
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) حالة المهمة في نظام التشغيل
 */
تعداد حالة_المهمة {
    جاهزة،              // (AR) جاهزة للتنفيذ
    قيد_التنفيذ،        // (AR) يتم تنفيذها حالياً
    معلقة،              // (AR) تنتظر شيئاً
    مكتملة،             // (AR) اكتملت بنجاح
    فاشلة               // (AR) فشلت
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) المُنبه (Waker)
//                    (EN) Waker
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) جدول الوظائف الافتراضية للمُنبه
 * 
 *      ┌─────────────────────────────────────────────────────────────────────────┐
 *      │                    RawWakerVTable                                       │
 *      ├─────────────────────────────────────────────────────────────────────────┤
 *      │    استنسخ: (بيانات) -> *خام                                             │
 *      │    أنبه: (بيانات) -> ()                                                  │
 *      │    أنبه_بالقيمة: (بيانات) -> ()                                          │
 *      │    أسقط: (بيانات) -> ()                                                 │
 *      └─────────────────────────────────────────────────────────────────────────┘
 */
هيكل جدول_منبه_خام {
    استنسخ: دالة(*ثابت خام) -> *خام،
    أنبه: دالة(*ثابت خام)،
    أنبه_بالقيمة: دالة(*ثابت خام)،
    أسقط: دالة(*ثابت خام)
}

/**
 * (AR) المُنبه الخام
 */
هيكل منبه_خام {
    بيانات: *ثابت خام،
    جدول: &ثابت جدول_منبه_خام
}

/**
 * (AR) المُنبه - يُستخدم لإيقاظ المهام المعلقة
 */
هيكل منبه {
    خام: منبه_خام
}

تنفيذ منبه {
    /**
     * (AR) إيقاظ المهمة المرتبطة
     */
    دالة أنبه(&ذات) {
        دع جدول = ذات.خام.جدول؛
        (جدول.أنبه)(ذات.خام.بيانات)؛
    }
    
    /**
     * (AR) استنساخ المُنبه
     */
    دالة استنسخ(&ذات) -> منبه {
        دع جدول = ذات.خام.جدول؛
        دع بيانات_جديدة = (جدول.استنسخ)(ذات.خام.بيانات)؛
        منبه {
            خام: منبه_خام {
                بيانات: بيانات_جديدة،
                جدول: جدول
            }
        }
    }
}

تنفيذ إسقاط لـ منبه {
    دالة أسقط(&متغير ذات) {
        دع جدول = ذات.خام.جدول؛
        (جدول.أسقط)(ذات.خام.بيانات)؛
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) سياق الاستطلاع
//                    (EN) Poll Context
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) سياق الاستطلاع - يُمرر للمستقبل عند الاستطلاع
 */
هيكل سياق {
    منبه: &منبه
}

تنفيذ سياق {
    /**
     * (AR) إنشاء سياق جديد
     */
    دالة جديد(منبه: &منبه) -> سياق {
        سياق { منبه: منبه }
    }
    
    /**
     * (AR) الحصول على المُنبه
     */
    دالة منبه(&ذات) -> &منبه {
        ذات.منبه
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) المهمة
//                    (EN) Task
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) غلاف المهمة - يلف أي مستقبل
 */
هيكل مهمة {
    معرف: معرف_مهمة،
    مستقبل: صندوق<يطبق مستقبل<ناتج = ()> + أرسل>،
    حالة: حالة_المهمة
}

تنفيذ مهمة {
    /**
     * (AR) إنشاء مهمة جديدة
     */
    دالة جديد<م>(مستقبل: م) -> مهمة
    حيث م: مستقبل<ناتج = ()> + أرسل + 'ثابت
    {
        مهمة {
            معرف: معرف_جديد()،
            مستقبل: صندوق::جديد(مستقبل)،
            حالة: حالة_المهمة::جاهزة
        }
    }
    
    /**
     * (AR) استطلاع المهمة
     */
    دالة استطلع(&متغير ذات، سياق: &متغير سياق) -> حالة_استطلاع<()> {
        ذات.حالة = حالة_المهمة::قيد_التنفيذ؛
        
        دع نتيجة = ذات.مستقبل.استطلع(سياق)؛
        
        طابق نتيجة {
            حالة_استطلاع::جاهز(_) => {
                ذات.حالة = حالة_المهمة::مكتملة؛
                حالة_استطلاع::جاهز(())
            }
            حالة_استطلاع::معلق => {
                ذات.حالة = حالة_المهمة::معلقة؛
                حالة_استطلاع::معلق
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) طابور المهام
//                    (EN) Task Queue
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) طابور المهام الجاهزة للتنفيذ
 */
هيكل طابور_المهام {
    طابور: قفل_دوار<طابور<قوس<مهمة>>>،
}

تنفيذ طابور_المهام {
    /**
     * (AR) إنشاء طابور فارغ
     */
    دالة جديد() -> طابور_المهام {
        طابور_المهام {
            طابور: قفل_دوار::جديد(طابور::جديد())
        }
    }
    
    /**
     * (AR) إضافة مهمة للطابور
     */
    دالة أضف(&ذات، مهمة: قوس<مهمة>) {
        ذات.طابور.أقفل().أضف(مهمة)؛
    }
    
    /**
     * (AR) سحب مهمة من الطابور
     */
    دالة اسحب(&ذات) -> اختياري<قوس<مهمة>> {
        ذات.طابور.أقفل().اسحب()
    }
    
    /**
     * (AR) هل الطابور فارغ؟
     */
    دالة فارغ(&ذات) -> منطقي {
        ذات.طابور.أقفل().فارغ()
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) منبه المهمة
//                    (EN) Task Waker
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) بيانات منبه المهمة
 */
هيكل بيانات_منبه_مهمة {
    معرف: معرف_مهمة،
    طابور: قوس<طابور_المهام>،
    مهام: قوس<قفل_دوار<خريطة<معرف_مهمة، قوس<مهمة>>>>
}

/**
 * (AR) جدول وظائف منبه المهمة
 */
ثابت جدول_منبه_مهمة: جدول_منبه_خام = جدول_منبه_خام {
    استنسخ: منبه_مهمة_استنسخ،
    أنبه: منبه_مهمة_أنبه،
    أنبه_بالقيمة: منبه_مهمة_أنبه_بالقيمة،
    أسقط: منبه_مهمة_أسقط
}؛

/**
 * (AR) استنساخ بيانات المنبه
 */
دالة منبه_مهمة_استنسخ(بيانات: *ثابت خام) -> *خام {
    دع قوس_بيانات = غير_آمن {
        قوس::من_خام(بيانات كـ *ثابت بيانات_منبه_مهمة)
    }؛
    دع نسخة = قوس::استنسخ(&قوس_بيانات)؛
    // (AR) لا تسقط النسخة الأصلية
    صدى::ذاكرة::انسَ(قوس_بيانات)؛
    قوس::إلى_خام(نسخة) كـ *خام
}

/**
 * (AR) إيقاظ المهمة
 */
دالة منبه_مهمة_أنبه(بيانات: *ثابت خام) {
    دع قوس_بيانات = غير_آمن {
        قوس::من_خام(بيانات كـ *ثابت بيانات_منبه_مهمة)
    }؛
    
    // (AR) ابحث عن المهمة وأضفها للطابور
    إذا دع بعض(مهمة) = قوس_بيانات.مهام.أقفل().احصل(&قوس_بيانات.معرف) {
        قوس_بيانات.طابور.أضف(قوس::استنسخ(مهمة))؛
    }
    
    // (AR) لا تسقط البيانات
    صدى::ذاكرة::انسَ(قوس_بيانات)؛
}

/**
 * (AR) إيقاظ المهمة (بالقيمة)
 */
دالة منبه_مهمة_أنبه_بالقيمة(بيانات: *ثابت خام) {
    منبه_مهمة_أنبه(بيانات)؛
    منبه_مهمة_أسقط(بيانات)؛
}

/**
 * (AR) إسقاط بيانات المنبه
 */
دالة منبه_مهمة_أسقط(بيانات: *ثابت خام) {
    غير_آمن {
        دع _ = قوس::من_خام(بيانات كـ *ثابت بيانات_منبه_مهمة)؛
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) المُنفذ
//                    (EN) Executor
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) مُنفذ المهام - يشغل حلقة الأحداث
 * 
 *      ┌─────────────────────────────────────────────────────────────────────────┐
 *      │                    حلقة المُنفذ                                          │
 *      ├─────────────────────────────────────────────────────────────────────────┤
 *      │                                                                         │
 *      │    ┌────────┐     استطلع     ┌────────┐     جاهز      ┌────────┐       │
 *      │    │ طابور  │ ──────────────> │ مهمة   │ ──────────────> │ اكتمل  │      │
 *      │    │ المهام │                 │        │                 │        │       │
 *      │    └────────┘                 └────────┘                 └────────┘       │
 *      │         ▲                          │                                      │
 *      │         │                          │ معلق                                 │
 *      │         │                          ▼                                      │
 *      │         │ أنبه               ┌────────┐                                   │
 *      │         └─────────────────── │ انتظار │                                   │
 *      │                              └────────┘                                   │
 *      │                                                                         │
 *      └─────────────────────────────────────────────────────────────────────────┘
 */
هيكل منفذ {
    طابور: قوس<طابور_المهام>،
    مهام: قوس<قفل_دوار<خريطة<معرف_مهمة، قوس<مهمة>>>>،
    يعمل: ذري<منطقي>
}

تنفيذ منفذ {
    /**
     * (AR) إنشاء مُنفذ جديد
     */
    دالة جديد() -> منفذ {
        منفذ {
            طابور: قوس::جديد(طابور_المهام::جديد())،
            مهام: قوس::جديد(قفل_دوار::جديد(خريطة::جديد()))،
            يعمل: ذري::جديد(خطأ)
        }
    }
    
    /**
     * (AR) إنتاج مهمة جديدة
     */
    دالة أنتج<م>(&ذات، مستقبل: م) -> معرف_مهمة
    حيث م: مستقبل<ناتج = ()> + أرسل + 'ثابت
    {
        دع مهمة = قوس::جديد(مهمة::جديد(مستقبل))؛
        دع معرف = مهمة.معرف؛
        
        ذات.مهام.أقفل().أدخل(معرف، قوس::استنسخ(&مهمة))؛
        ذات.طابور.أضف(مهمة)؛
        
        معرف
    }
    
    /**
     * (AR) تشغيل حلقة الأحداث حتى اكتمال جميع المهام
     */
    دالة شغل_حتى_الاكتمال(&ذات) {
        ذات.يعمل.خزن(صحيح، ترتيب::متسلسل)؛
        
        بينما ذات.يعمل.حمل(ترتيب::متسلسل) {
            // (AR) اسحب المهمة التالية
            طابق ذات.طابور.اسحب() {
                بعض(مهمة) => {
                    دع معرف = مهمة.معرف؛
                    
                    // (AR) أنشئ المنبه
                    دع بيانات_منبه = قوس::جديد(بيانات_منبه_مهمة {
                        معرف: معرف،
                        طابور: قوس::استنسخ(&ذات.طابور)،
                        مهام: قوس::استنسخ(&ذات.مهام)
                    })؛
                    
                    دع منبه_خام = منبه_خام {
                        بيانات: قوس::إلى_خام(بيانات_منبه) كـ *ثابت خام،
                        جدول: &جدول_منبه_مهمة
                    }؛
                    
                    دع المنبه = منبه { خام: منبه_خام }؛
                    دع متغير سياق = سياق::جديد(&المنبه)؛
                    
                    // (AR) استطلع المهمة
                    دع متغير مهمة_قفل = مهمة؛
                    طابق قوس::احصل_متغير(&متغير مهمة_قفل).استطلع(&متغير سياق) {
                        حالة_استطلاع::جاهز(_) => {
                            // (AR) اكتملت المهمة، أزلها
                            ذات.مهام.أقفل().أزل(&معرف)؛
                        }
                        حالة_استطلاع::معلق => {
                            // (AR) المهمة معلقة، ستُوقظ لاحقاً
                        }
                    }
                }
                لا_شيء => {
                    // (AR) لا مهام جاهزة
                    إذا ذات.مهام.أقفل().فارغ() {
                        // (AR) لا مهام متبقية، توقف
                        ذات.يعمل.خزن(خطأ، ترتيب::متسلسل)؛
                    } وإلا {
                        // (AR) انتظر قليلاً
                        خيط::نم(مدة::من_ميكروثانية(100))؛
                    }
                }
            }
        }
    }
    
    /**
     * (AR) إيقاف المُنفذ
     */
    دالة أوقف(&ذات) {
        ذات.يعمل.خزن(خطأ، ترتيب::متسلسل)؛
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) نظام التشغيل العام
//                    (EN) Global Runtime
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) المُنفذ العام الافتراضي
 */
متغير_عام منفذ_افتراضي: خامل<منفذ> = خامل::جديد(|| منفذ::جديد())؛

/**
 * (AR) إنتاج مهمة في المُنفذ الافتراضي
 */
عام دالة أنتج<م>(مستقبل: م) -> معرف_مهمة
حيث م: مستقبل<ناتج = ()> + أرسل + 'ثابت
{
    منفذ_افتراضي.أنتج(مستقبل)
}

/**
 * (AR) تشغيل مستقبل حتى الاكتمال
 */
عام دالة شغل_حتى_الاكتمال<م>(مستقبل: م)
حيث م: مستقبل<ناتج = ()> + أرسل + 'ثابت
{
    منفذ_افتراضي.أنتج(مستقبل)؛
    منفذ_افتراضي.شغل_حتى_الاكتمال()؛
}

/**
 * (AR) تشغيل مهام متعددة
 */
عام دالة شغل_جميع<م، ع>(مستقبلات: ع)
حيث م: مستقبل<ناتج = ()> + أرسل + 'ثابت،
      ع: مكرر<عنصر = م>
{
    لكل مستقبل في مستقبلات {
        منفذ_افتراضي.أنتج(مستقبل)؛
    }
    منفذ_افتراضي.شغل_حتى_الاكتمال()؛
}

// ═══════════════════════════════════════════════════════════════════════════════
//                    (AR) أدوات مساعدة
//                    (EN) Helper Utilities
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * (AR) تأخير غير متزامن
 */
عام هيكل تأخير {
    مدة: مدة،
    بدأ: اختياري<وقت>
}

تنفيذ تأخير {
    عام دالة جديد(مدة: مدة) -> تأخير {
        تأخير {
            مدة: مدة،
            بدأ: لا_شيء
        }
    }
}

تنفيذ مستقبل لـ تأخير {
    نوع ناتج = ()؛
    
    دالة استطلع(&متغير ذات، سياق: &متغير سياق) -> حالة_استطلاع<()> {
        دع الآن = وقت::الآن()؛
        
        إذا ذات.بدأ.هو_لا_شيء() {
            ذات.بدأ = بعض(الآن)؛
        }
        
        دع بداية = ذات.بدأ.فك()؛
        دع مضى = الآن.مدة_منذ(بداية)؛
        
        إذا مضى >= ذات.مدة {
            حالة_استطلاع::جاهز(())
        } وإلا {
            // (AR) جدول إيقاظ بعد المدة المتبقية
            دع منبه = سياق.منبه().استنسخ()؛
            دع المتبقي = ذات.مدة - مضى؛
            
            // (AR) في تنفيذ حقيقي، سنستخدم مؤقت النظام
            خيط::أنتج(حرك || {
                خيط::نم(المتبقي)؛
                منبه.أنبه()؛
            })؛
            
            حالة_استطلاع::معلق
        }
    }
}

/**
 * (AR) دالة مساعدة للتأخير
 */
عام دالة تأخير(مدة: مدة) -> تأخير {
    تأخير::جديد(مدة)
}

/**
 * (AR) مستقبل جاهز فوراً
 */
عام هيكل جاهز_فوراً<ن> {
    قيمة: اختياري<ن>
}

تنفيذ<ن> جاهز_فوراً<ن> {
    عام دالة جديد(قيمة: ن) -> جاهز_فوراً<ن> {
        جاهز_فوراً { قيمة: بعض(قيمة) }
    }
}

تنفيذ<ن> مستقبل لـ جاهز_فوراً<ن> {
    نوع ناتج = ن؛
    
    دالة استطلع(&متغير ذات، _سياق: &متغير سياق) -> حالة_استطلاع<ن> {
        طابق ذات.قيمة.خذ() {
            بعض(قيمة) => حالة_استطلاع::جاهز(قيمة)،
            لا_شيء => هلع!("تم استطلاع جاهز_فوراً بعد الاكتمال")
        }
    }
}

/**
 * (AR) مستقبل معلق دائماً
 */
عام هيكل معلق_دائماً؛

تنفيذ مستقبل لـ معلق_دائماً {
    نوع ناتج = !؛
    
    دالة استطلع(&متغير ذات، _سياق: &متغير سياق) -> حالة_استطلاع<!> {
        حالة_استطلاع::معلق
    }
}

