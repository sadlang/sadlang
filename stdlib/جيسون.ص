# ═══ التوليد ═══

دالة اهرب_نص(القيمة)
    متغير المتراكم = علامة_اقتباس
    متغير الموضع = 0

    بينما (الموضع < طول(القيمة))
        متغير الحرف = القيمة.جزء(الموضع، 1)
        إذا (الحرف == علامة_اقتباس)
            المتراكم = المتراكم + شرطة_خلفية + علامة_اقتباس
        وإلا إذا (الحرف == شرطة_خلفية)
            المتراكم = المتراكم + شرطة_خلفية + شرطة_خلفية
        وإلا إذا (الحرف == سطر_جديد)
            المتراكم = المتراكم + شرطة_خلفية + رمز_سطر_جديد
        وإلا إذا (الحرف == جدولة)
            المتراكم = المتراكم + شرطة_خلفية + رمز_جدولة
        وإلا إذا (الحرف == ارجاع_السطر)
            المتراكم = المتراكم + شرطة_خلفية + رمز_ارجاع
        وإلا إذا (الحرف == مسافة_خلفية)
            المتراكم = المتراكم + شرطة_خلفية + رمز_مسافة_خلفية
        وإلا إذا (الحرف == تغذية_صفحة)
            المتراكم = المتراكم + شرطة_خلفية + رمز_تغذية_صفحة
        وإلا
            المتراكم = المتراكم + الحرف
        نهاية
        الموضع = الموضع + 1
    نهاية

    ارجع المتراكم + علامة_اقتباس
نهاية

دالة ولد_قيمة(القيمة، البادئة، الازاحة)
    # (AR) البادئةُ نصُّ إزاحةِ السطر؛ إن كانت الإزاحةُ فارغةً فالإخراجُ مضغوطٌ بلا أسطر
    إذا (القيمة == لاشيء)
        ارجع نص_لاشيء
    نهاية
    إذا (القيمة == صحيح)
        ارجع نص_صحيح
    نهاية
    إذا (القيمة == خطأ)
        ارجع نص_خطأ
    نهاية

    متغير نوع_القيمة = نوع(القيمة)
    إذا (نوع_القيمة == اسم_نوع_نص)
        ارجع اهرب_نص(القيمة)
    نهاية
    إذا (نوع_القيمة == اسم_نوع_رقم أو نوع_القيمة == اسم_نوع_عشري)
        ارجع نص(القيمة)
    نهاية

    متغير منسق = الازاحة != نص_فارغ
    متغير بادئة_داخلية = البادئة + الازاحة
    متغير فاصل_السطر = نص_فارغ
    متغير بادئة_السطر = نص_فارغ
    متغير بادئة_الغلق = نص_فارغ
    إذا (منسق)
        فاصل_السطر = سطر_جديد
        بادئة_السطر = بادئة_داخلية
        بادئة_الغلق = البادئة
    نهاية

    إذا (نوع_القيمة == اسم_نوع_مصفوفة)
        إذا (طول(القيمة) == 0)
            ارجع فتح_مصفوفة + غلق_مصفوفة
        نهاية
        متغير متراكم_المصفوفة = فتح_مصفوفة + فاصل_السطر
        متغير موضع_العنصر = 0
        بينما (موضع_العنصر < طول(القيمة))
            إذا (موضع_العنصر > 0)
                متراكم_المصفوفة = متراكم_المصفوفة + فاصلة + فاصل_السطر
            نهاية
            متراكم_المصفوفة = متراكم_المصفوفة + بادئة_السطر + ولد_قيمة(القيمة[موضع_العنصر]، بادئة_داخلية، الازاحة)
            موضع_العنصر = موضع_العنصر + 1
        نهاية
        ارجع متراكم_المصفوفة + فاصل_السطر + بادئة_الغلق + غلق_مصفوفة
    نهاية

    ارجع ولد_كائن(القيمة، منسق، فاصل_السطر، بادئة_السطر، بادئة_الغلق، بادئة_داخلية، الازاحة)
نهاية

# (AR) ذراعُ الكائن مستخرَجةٌ بمعاملٍ **مُصرَّحِ النوع** `خريطة`. السببُ ليس تجميلًا:
#      `ولد_قيمة` تتلقّى القيمةَ ديناميكيّةً، وفحصُ `نوع(القيمة)` يثبت أنّها خريطةٌ
#      زمنَ التشغيل — لكنّ المصرِّفَ لا يرى ذلك، فيبقى نوعُها الساكنُ عددًا،
#      فتسقط `القيمة.مفاتيح()` إلى نداءِ رمزٍ لا وجودَ له. التصريحُ هنا يُبلّغ
#      المصرِّفَ بما أثبته الفحصُ: تضييقٌ مُعلَنٌ في المصدر، لا مُخمَّنٌ في المصرِّف.
دالة نص ولد_كائن(خريطة الكائن، منطقي منسق، نص فاصل_السطر، نص بادئة_السطر،
                 نص بادئة_الغلق، نص بادئة_داخلية، نص الازاحة)
    متغير المفاتيح = الكائن.مفاتيح()
    إذا (طول(المفاتيح) == 0)
        ارجع فتح_كائن + غلق_كائن
    نهاية

    متغير متراكم_الكائن = فتح_كائن + فاصل_السطر
    متغير موضع_المفتاح = 0
    بينما (موضع_المفتاح < طول(المفاتيح))
        إذا (موضع_المفتاح > 0)
            متراكم_الكائن = متراكم_الكائن + فاصلة + فاصل_السطر
        نهاية
        متغير المفتاح = المفاتيح[موضع_المفتاح]
        متراكم_الكائن = متراكم_الكائن + بادئة_السطر + اهرب_نص(المفتاح) + نقطتان
        إذا (منسق)
            متراكم_الكائن = متراكم_الكائن + مسافة
        نهاية
        متراكم_الكائن = متراكم_الكائن + ولد_قيمة(الكائن.احصل(المفتاح)، بادئة_داخلية، الازاحة)
        موضع_المفتاح = موضع_المفتاح + 1
    نهاية

    ارجع متراكم_الكائن + فاصل_السطر + بادئة_الغلق + غلق_كائن
نهاية

