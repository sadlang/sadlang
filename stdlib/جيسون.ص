دالة رقم قيمة_رقم_ست_عشري(نص الحرف)
    # (AR) يعيد قيمةَ الخانةِ أو `قيمة_غير_ست_عشرية` — لا يرمي، ليقرّر المنادي
    #      رسالةَ الخطأِ بموضعِه.
    #
    #      حسابٌ لا مسح: كانت حلقةً من ستَّ عشرةَ دورةً تنادي `حرف_عند` مرّتين في
    #      كلِّ دورة، و`حرف_عند` تخصّص نصًّا جديدًا — فاثنان وثلاثون تخصيصًا لخانةٍ
    #      واحدةٍ، ومئةٌ وثمانيةٌ وعشرون لكلِّ `\uXXXX`. وترويسةُ الوحدةِ تُعلِن أنّ
    #      التحليلَ تربيعيُّ الزمنِ بلا سقفٍ على طولِ المدخل وتسمّي منعَ الخدمةِ
    #      بلفظِه، فمضاعفةُ ثابتِ الكلفةِ على مسارٍ يُعرَف أنّه سطحُ هجومٍ ليست
    #      تفصيلًا. وحدودُ المدياتِ تُقرأ من الجدولَين نفسِهما لا من أعدادٍ عارية،
    #      فيبقى الجدولُ مصدرَ الحقيقةِ كما كان.
    #
    # ⚠️ فحصُ الفراغِ صريحٌ هنا ولازم: أمانُ `اقرا_اربع_ست_عشريات` من القراءةِ خارجَ
    #    الحدودِ قائمٌ على أنّ النصَّ الفارغَ (تجاوزُ النهاية) غيرُ ست عشريّ. كان
    #    ذلك يقع تلقائيًّا لأنّ الفارغَ لا يطابق حرفًا في المسح؛ ومع الحسابِ صار
    #    يتوقّف على `رمز_حرف("")` وهو غيرُ مضمون، فيُفحَص أوّلًا. حارسُه ١٤٩.
    إذا (الحرف == نص_فارغ)
        ارجع قيمة_غير_ست_عشرية
    نهاية

    متغير رمز_الحرف = رمز_حرف(الحرف، فهرس_اول_محرف)
    متغير رمز_الخانة_صفر = رمز_حرف(ارقام_ست_عشرية_صغيرة، فهرس_اول_محرف)
    متغير رمز_الخانة_الحرفية_الصغيرة = رمز_حرف(ارقام_ست_عشرية_صغيرة، فهرس_اول_خانة_حرفية)
    متغير رمز_الخانة_الحرفية_الكبيرة = رمز_حرف(ارقام_ست_عشرية_كبيرة، فهرس_اول_خانة_حرفية)

    متغير القيمة_الرقمية = رمز_الحرف - رمز_الخانة_صفر
    إذا (القيمة_الرقمية >= 0 و القيمة_الرقمية < فهرس_اول_خانة_حرفية)
        ارجع القيمة_الرقمية
    نهاية

    متغير القيمة_الصغيرة = رمز_الحرف - رمز_الخانة_الحرفية_الصغيرة + فهرس_اول_خانة_حرفية
    إذا (القيمة_الصغيرة >= فهرس_اول_خانة_حرفية و القيمة_الصغيرة < اساس_ست_عشري)
        ارجع القيمة_الصغيرة
    نهاية

    متغير القيمة_الكبيرة = رمز_الحرف - رمز_الخانة_الحرفية_الكبيرة + فهرس_اول_خانة_حرفية
    إذا (القيمة_الكبيرة >= فهرس_اول_خانة_حرفية و القيمة_الكبيرة < اساس_ست_عشري)
        ارجع القيمة_الكبيرة
    نهاية

    ارجع قيمة_غير_ست_عشرية
نهاية

دالة نص هروب_محرف_تحكم(نص الحرف)
    # (AR) يُنتج `\u00XX` لمحرفِ تحكّمٍ واحد. الخانتان العلياوان صفران دائمًا
    #      لأنّ المدى المقصودَ U+0000–U+001F، فلا يلزم إلّا نصفا البايتِ الأدنيان.
    متغير الرمز = رمز_حرف(الحرف، فهرس_اول_محرف)
    متغير النصف_الاعلى = حرف_عند(ارقام_ست_عشرية_صغيرة، الرمز // اساس_ست_عشري)
    متغير النصف_الادنى = حرف_عند(ارقام_ست_عشرية_صغيرة، الرمز % اساس_ست_عشري)
    ارجع بادئة_هروب_يونيكود + النصف_الاعلى + النصف_الادنى
نهاية

دالة رقم اقرا_اربع_ست_عشريات(نص المصدر، رقم الموضع)
    # (AR) يعيد نقطةَ الترميزِ أو `قيمة_غير_ست_عشرية` إن أخفقت خانةٌ واحدةٌ —
    #      والحارسُ لا يلتبس بقيمةٍ صحيحةٍ لأنّ أربعَ خاناتٍ لا تُنتج سالبًا أبدًا.
    #      ولا يقرأ خارجَ الحدود: `حرف_عند` يعيد فارغًا بعد النهايةِ والفارغُ
    #      غيرُ ست عشريٍّ تلقائيًّا.
    متغير القيمة = 0
    متغير العداد = 0
    بينما (العداد < عدد_خانات_يونيكود)
        متغير الخانة = قيمة_رقم_ست_عشري(حرف_عند(المصدر، الموضع + العداد))
        إذا (الخانة == قيمة_غير_ست_عشرية)
            ارجع قيمة_غير_ست_عشرية
        نهاية
        القيمة = القيمة * اساس_ست_عشري + الخانة
        العداد = العداد + 1
    نهاية
    ارجع القيمة
نهاية

دالة نص حرف_عند(نص المصدر، رقم الموضع)
    # (AR) يعيد حرفًا واحدًا نصًّا، أو نصًّا فارغًا عند تجاوز النهاية
    إذا (الموضع < 0 أو الموضع >= طول(المصدر))
        ارجع نص_فارغ
    نهاية
    ارجع المصدر.جزء(الموضع، 1)
نهاية

دالة منطقي هو_فراغ(نص الحرف)
    ارجع الحرف == مسافة أو الحرف == جدولة أو الحرف == سطر_جديد أو الحرف == ارجاع_السطر
نهاية

دالة منطقي هو_رقم(نص الحرف)
    ارجع الحرف >= حرف_الرقم_الادنى و الحرف <= حرف_الرقم_الاعلى
نهاية

دالة رقم تخط_الفراغ(نص المصدر، رقم الموضع)
    متغير موضع_جار = الموضع
    بينما (موضع_جار < طول(المصدر) و هو_فراغ(حرف_عند(المصدر، موضع_جار)))
        موضع_جار = موضع_جار + 1
    نهاية
    ارجع موضع_جار
نهاية

دالة رقم توقع(نص المصدر، رقم الموضع، نص المنتظر)
    # (AR) يتحقّق من حرفٍ بعينه ويعيد الموضعَ التالي، أو يرمي عند المخالفة
    إذا (حرف_عند(المصدر، الموضع) != المنتظر)
        ارمي وسم_الخطا + رسالة_توقع + المنتظر + عبارة_عند_الموضع + نص(الموضع)
    نهاية
    ارجع الموضع + 1
نهاية

# ═══ التحليل ═══
# لأنّ ص تمرّر بالقيمة، تعيد كلُّ دالّةِ تحليلٍ زوجًا: [القيمة، الموضعُ التالي]
#
# (AR) والعقدُ مصرَّحٌ لا موصوفٌ وحدَه: كان مكتوبًا في هذا التعليقِ ومفقودًا في
#      التوقيعات، فلا يحرسه المصرِّف. ودالّةُ تحليلٍ تعيد نصًّا بدل الزوجِ يومًا
#      كانت تمرّ ساكنةً وتنفجر عند `الزوج[فهرس_الموضع_التالي]`.

دالة مصفوفة حلل_نص(نص المصدر، رقم الموضع)
    متغير موضع_جار = توقع(المصدر، الموضع، علامة_اقتباس)
    متغير المتراكم = نص_فارغ

    بينما (صحيح)
        متغير الحرف = حرف_عند(المصدر، موضع_جار)

        إذا (الحرف == نص_فارغ)
            ارمي وسم_الخطا + رسالة_نص_غير_مغلق + عبارة_عند_الموضع + نص(الموضع)
        نهاية
        إذا (الحرف == علامة_اقتباس)
            ارجع [المتراكم، موضع_جار + 1]
        نهاية

        إذا (الحرف == شرطة_خلفية)
            متغير حرف_الهروب = حرف_عند(المصدر، موضع_جار + 1)
            # (AR) التقدّمُ متغيّرٌ لأنّ `\uXXXX` ستّةٌ وزوجَ البدائلِ اثنا عشر.
            متغير تقدم_الهروب = طول_الهروب_القياسي
            إذا (حرف_الهروب == علامة_اقتباس)
                المتراكم = المتراكم + علامة_اقتباس
            وإلا إذا (حرف_الهروب == شرطة_خلفية)
                المتراكم = المتراكم + شرطة_خلفية
            وإلا إذا (حرف_الهروب == شرطة_امامية)
                المتراكم = المتراكم + شرطة_امامية
            وإلا إذا (حرف_الهروب == رمز_سطر_جديد)
                المتراكم = المتراكم + سطر_جديد
            وإلا إذا (حرف_الهروب == رمز_جدولة)
                المتراكم = المتراكم + جدولة
            وإلا إذا (حرف_الهروب == رمز_ارجاع)
                المتراكم = المتراكم + ارجاع_السطر
            وإلا إذا (حرف_الهروب == رمز_مسافة_خلفية)
                المتراكم = المتراكم + مسافة_خلفية
