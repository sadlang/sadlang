        إذا (منسق)
            متراكم_الكائن = متراكم_الكائن + مسافة
        نهاية
        متراكم_الكائن = متراكم_الكائن + ولد_قيمة(الكائن.احصل(المفتاح)، بادئة_داخلية، الازاحة)
        موضع_المفتاح = موضع_المفتاح + 1
    نهاية

