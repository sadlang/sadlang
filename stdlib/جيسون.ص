# (AR) ذراعُ الكائنِ مستخرَجةٌ بمعاملٍ **مُصرَّحِ النوع** (`خريطة`)، وذراعُ المصفوفةِ
#      تبقى `أي` — والفرقُ بينهما مقيسٌ لا اعتباطيّ، يشرحه ما بعدَ الفقرةِ الأولى.
#      السببُ ليس تجميلًا: `ولد_قيمة` تتلقّى القيمةَ ديناميكيّةً، وفحصُ `نوع(القيمة)`
#      يثبت الصنفَ زمنَ التشغيل — لكنّ المصرِّفَ لا يرى ذلك، فيبقى النوعُ الساكنُ
#      عددًا، فتسقط `القيمة.مفاتيح()` إلى نداءِ رمزٍ لا وجودَ له. التصريحُ يُبلّغ
#      المصرِّفَ بما أثبته الفحصُ: تضييقٌ مُعلَنٌ في المصدر، لا مُخمَّنٌ في المصرِّف.
#
#      لكنّ التضييقَ يصلح للخريطةِ ولا يصلح للمصفوفة، **مقيسًا لا مفترَضًا**:
#      جُرِّب `مصفوفة القيمة` هنا فانكسر ١٤٣ و١٤٤ على المصرِّفِ وحدَه، وطبعا
#      `[2534651392384,…]` مكانَ `[[1,2],[3]]` — أي عناوينَ خامًّا. والسببُ أنّ
#      عنصرَ مصفوفةٍ **مُصرَّحةٍ** يخرج عددًا صريحًا فيضيع وسمُه، بينما عنصرَ «أي»
#      يخرج موسومًا. فالتصريحُ هنا **يُتلِف** ما يحفظه هناك، والوسمُ هو المطلوب:
#      حاوياتُ جيسون مختلطةُ العناصرِ بطبيعتِها. فتبقى `أي` عن قياسٍ لا عن إهمال.
#      (وهذا تباعدٌ في المصرِّفِ بين العائلتَين يستحقّ بطاقةً على حدة.)
#
#      والمشتقّاتُ تُشتَقّ حيث تُستهلَك ولا تُمرَّر: خمسةُ معاملاتٍ كانت **مشتقّةً** من `البادئة`
#      و`الازاحة` في المنادي ثمّ تُمرَّر عبر حدٍّ لا يتحقّق منها، وأربعةٌ منها نوعُها
#      `نص` وتُمرَّر بالموضع — فتبديلُ `بادئة_السطر` بـ`بادئة_الغلق` سهوًا يمرّ
#      على المصرِّفِ صامتًا ويقلب التنسيق. صار الاشتقاقُ حيث يُستهلَك.
دالة نص ولد_مصفوفة(أي القيمة، نص البادئة، نص الازاحة، رقم العمق)
    إذا (طول(القيمة) == 0)
        ارجع فتح_مصفوفة + غلق_مصفوفة
    نهاية

    متغير منسق = هل_الاخراج_منسق(الازاحة)
    متغير بادئة_داخلية = البادئة + الازاحة
    متغير فاصل_السطر = نص_فارغ
    متغير بادئة_السطر = نص_فارغ
    متغير بادئة_الغلق = نص_فارغ
    إذا (منسق)
        فاصل_السطر = سطر_جديد
        بادئة_السطر = بادئة_داخلية
        بادئة_الغلق = البادئة
    نهاية

    متغير متراكم_المصفوفة = فتح_مصفوفة + فاصل_السطر
    متغير موضع_العنصر = 0
    بينما (موضع_العنصر < طول(القيمة))
        إذا (موضع_العنصر > 0)
            متراكم_المصفوفة = متراكم_المصفوفة + فاصلة + فاصل_السطر
        نهاية
        متراكم_المصفوفة = متراكم_المصفوفة + بادئة_السطر + ولد_قيمة(القيمة[موضع_العنصر]، بادئة_داخلية، الازاحة، العمق + 1)
        موضع_العنصر = موضع_العنصر + 1
    نهاية

    ارجع متراكم_المصفوفة + فاصل_السطر + بادئة_الغلق + غلق_مصفوفة
نهاية

دالة نص ولد_كائن(خريطة الكائن، نص البادئة، نص الازاحة، رقم العمق)
    متغير المفاتيح = الكائن.مفاتيح()
    إذا (طول(المفاتيح) == 0)
        ارجع فتح_كائن + غلق_كائن
    نهاية

    متغير منسق = هل_الاخراج_منسق(الازاحة)
    متغير بادئة_داخلية = البادئة + الازاحة
    متغير فاصل_السطر = نص_فارغ
    متغير بادئة_السطر = نص_فارغ
    متغير بادئة_الغلق = نص_فارغ
    إذا (منسق)
        فاصل_السطر = سطر_جديد
        بادئة_السطر = بادئة_داخلية
        بادئة_الغلق = البادئة
    نهاية

    متغير متراكم_الكائن = فتح_كائن + فاصل_السطر
    متغير موضع_المفتاح = 0
    بينما (موضع_المفتاح < طول(المفاتيح))
        إذا (موضع_المفتاح > 0)
            متراكم_الكائن = متراكم_الكائن + فاصلة + فاصل_السطر
        نهاية
        متغير المفتاح = المفاتيح[موضع_المفتاح]
        متراكم_الكائن = متراكم_الكائن + بادئة_السطر + اهرب_نص(المفتاح) + نقطتان
        إذا (منسق)
            متراكم_الكائن = متراكم_الكائن + مسافة
        نهاية
        متراكم_الكائن = متراكم_الكائن + ولد_قيمة(الكائن.احصل(المفتاح)، بادئة_داخلية، الازاحة، العمق + 1)
        موضع_المفتاح = موضع_المفتاح + 1
    نهاية

    ارجع متراكم_الكائن + فاصل_السطر + بادئة_الغلق + غلق_كائن
