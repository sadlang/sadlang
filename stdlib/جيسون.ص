#**
 * @module جيسون
 * @brief (AR) تحليلُ جيسون وتوليدُه — تنفيذٌ بلغة ص خالصة
 * @brief (EN) JSON parsing and serialization — pure Sad implementation
 *
 * لا تستدعي هذه الوحدةُ أيَّ دالّةٍ مضمّنةٍ مكتوبةٍ بـC++؛ تقتصر على
 * أوّليّاتِ اللغة.
 *
 * ⚠️ حالةُ التشغيل — قِيدٌ معلَنٌ لا سهو:
 *   • **المفسّر (sad-run): يعمل كاملًا** — تحليلٌ وتوليدٌ مضغوطٌ وتنسيق.
 *   • **المصرّف (sad-build): التحليلُ يعمل، والتوليدُ لا.** `ولد()` تُرجع عنوانًا
 *     يُطبَع عددًا، وقد تنهار على بعض المُدخَلات. والسببُ عيبُ مصرِّفٍ مسجَّلٌ
 *     (ز.٣٦): موقعُ النداءِ وجسمُ الدالّةِ يختلفان في نوعِ المعامل، فيُمرَّر
 *     عددٌ إلى معاملٍ بُني على أنّه نصّ — بلا أيِّ تشخيص. ليس عيبًا في هذا الملفّ،
 *     ولا يُعالَج بالالتفافِ عليه هنا.
 *   لذلك **لا تعتمد على هذه الوحدة في مسارٍ مُصرَّفٍ حتّى يُسدّ ز.٣٦.**
 *
 * قيدٌ ثانٍ معلَن: هروبُ `\uXXXX` غيرُ مدعومٍ تحليلًا (يحتاج «حرف_من_رمز» من
 * وحدةِ «خرائط» المحظورِ استيرادُها هنا) — يُرمى بخطأٍ مميَّزٍ لا يُتجاهَل صامتًا.
 *
 * تنبيهان:
 *   ١) لا تستورد وحدةَ «خرائط» هنا — فدالّتُها «رقم» تُظلِّل مُحوِّلَ النوع
 *      «رقم» الذي يعتمد عليه تحليلُ الأعداد.
 *   ٢) معرّفاتُ هذا الملفّ خاليةٌ من التشكيل عمدًا — فالمترجم يجرّد الشدّة
 *      عند البحث عن الأسماء، فتفشل الاستدعاءاتُ التعاوديّة صامتةً.
 *
 * الاستخدام:
 *   استورد حلل، ولد، نسق من جيسون
 *   متغير قيمة = حلل("{\"اسم\": \"ص\"}")
 *   متغير نص_الخرج = ولد(قيمة)
 **#

# ═══ الثوابتُ المعجميّة ═══

ثابت فتح_كائن = "{"
ثابت غلق_كائن = "}"
ثابت فتح_مصفوفة = "["
ثابت غلق_مصفوفة = "]"
ثابت فاصلة = ","
ثابت نقطتان = ":"
ثابت علامة_اقتباس = "\""
ثابت شرطة_خلفية = "\\"
ثابت شرطة_امامية = "/"
ثابت اشارة_سالب = "-"
ثابت اشارة_موجب = "+"
ثابت نقطة_عشرية = "."
ثابت اصغر_رقم = "0"
ثابت اكبر_رقم = "9"
ثابت رمز_الاس_صغير = "e"
ثابت رمز_الاس_كبير = "E"
ثابت رمز_سطر_جديد = "n"
ثابت رمز_جدولة = "t"
ثابت رمز_ارجاع = "r"
ثابت رمز_مسافة_خلفية = "b"
ثابت رمز_تغذية_صفحة = "f"
ثابت رمز_يونيكود = "u"
ثابت مسافة_خلفية = "\b"
ثابت تغذية_صفحة = "\f"
ثابت نص_صحيح = "true"
ثابت نص_خاطئ = "false"
ثابت نص_عدم = "null"
ثابت نص_فارغ = ""
ثابت مسافة = " "
ثابت جدولة = "\t"
ثابت سطر_جديد = "\n"
ثابت ارجاع_السطر = "\r"
ثابت ازاحة_مسافتين = "  "
ثابت اسم_نوع_نص = "نص"
ثابت اسم_نوع_رقم = "رقم"
ثابت اسم_نوع_عشري = "عشري"
ثابت اسم_نوع_مصفوفة = "مصفوفة"

# ═══ أدواتٌ معجميّةٌ داخليّة ═══

دالة حرف_عند(المصدر، الموضع)
    # (AR) يعيد حرفًا واحدًا نصًّا، أو نصًّا فارغًا عند تجاوز النهاية
    إذا (الموضع < 0 أو الموضع >= طول(المصدر))
        ارجع نص_فارغ
    نهاية
    ارجع المصدر.جزء(الموضع، 1)
نهاية

دالة هو_فراغ(الحرف)
    ارجع الحرف == مسافة أو الحرف == جدولة أو الحرف == سطر_جديد أو الحرف == ارجاع_السطر
نهاية

دالة هو_رقم(الحرف)
    ارجع الحرف >= اصغر_رقم و الحرف <= اكبر_رقم
نهاية

دالة تخط_الفراغ(المصدر، الموضع)
    متغير موضع_جار = الموضع
    بينما (موضع_جار < طول(المصدر) و هو_فراغ(حرف_عند(المصدر، موضع_جار)))
        موضع_جار = موضع_جار + 1
    نهاية
    ارجع موضع_جار
نهاية

دالة توقع(المصدر، الموضع، المنتظر)
    # (AR) يتحقّق من حرفٍ بعينه ويعيد الموضعَ التالي، أو يرمي عند المخالفة
    إذا (حرف_عند(المصدر، الموضع) != المنتظر)
        ارمي "جيسون: توقّعتُ " + المنتظر + " عند الموضع " + نص(الموضع)
    نهاية
    ارجع الموضع + 1
نهاية

# ═══ التحليل ═══
# لأنّ ص تمرّر بالقيمة، تعيد كلُّ دالّةِ تحليلٍ زوجًا: [القيمة، الموضعُ التالي]

دالة حلل_نص(المصدر، الموضع)
    متغير موضع_جار = توقع(المصدر، الموضع، علامة_اقتباس)
    متغير المتراكم = نص_فارغ

    بينما (صحيح)
        متغير الحرف = حرف_عند(المصدر، موضع_جار)

        إذا (الحرف == نص_فارغ)
            ارمي "جيسون: نصٌّ غيرُ مُغلَقٍ يبدأ عند الموضع " + نص(الموضع)
        نهاية
        إذا (الحرف == علامة_اقتباس)
            ارجع [المتراكم، موضع_جار + 1]
        نهاية

        إذا (الحرف == شرطة_خلفية)
            متغير حرف_الهروب = حرف_عند(المصدر، موضع_جار + 1)
            # (AR) طولُ الهروبِ حرفان إلّا ‏\uXXXX فستّة. نحمله متغيّرًا بدل «استمر»
            #      كي يبقى للحلقةِ مخرجٌ واحدٌ ويسهل تتبّعُ الموضع.
            متغير طول_الهروب = 2
            إذا (حرف_الهروب == علامة_اقتباس)
                المتراكم = المتراكم + علامة_اقتباس
            وإلا إذا (حرف_الهروب == شرطة_خلفية)
                المتراكم = المتراكم + شرطة_خلفية
            وإلا إذا (حرف_الهروب == شرطة_امامية)
                المتراكم = المتراكم + شرطة_امامية
            وإلا إذا (حرف_الهروب == رمز_سطر_جديد)
                المتراكم = المتراكم + سطر_جديد
            وإلا إذا (حرف_الهروب == رمز_جدولة)
                المتراكم = المتراكم + جدولة
            وإلا إذا (حرف_الهروب == رمز_ارجاع)
                المتراكم = المتراكم + ارجاع_السطر
            وإلا إذا (حرف_الهروب == رمز_مسافة_خلفية)
                المتراكم = المتراكم + مسافة_خلفية
            وإلا إذا (حرف_الهروب == رمز_تغذية_صفحة)
                المتراكم = المتراكم + تغذية_صفحة
            وإلا إذا (حرف_الهروب == رمز_يونيكود)
                # (AR) ‏\uXXXX هو الصيغةُ القياسيّةُ التي تُخرِجها معظمُ المولّدات لأيِّ نصٍّ
                #      غيرِ لاتينيّ، فهذا **قيدٌ حقيقيٌّ** يمنع قراءةَ جيسون شائع. وسببُ
                #      بقائه: فكُّه يحتاج «حرف_من_رمز» وهي في وحدةِ «خرائط» التي لا يجوز
                #      استيرادُها هنا (دالّتُها «رقم» تُظلِّل مُحوِّلَ النوعِ الذي يعتمد عليه
                #      تحليلُ الأعداد). رسالةٌ مميَّزةٌ تُسمّي القيدَ خيرٌ من رفضٍ غامضٍ.
                ارمي "جيسون: هروبُ يونيكود \\u غيرُ مدعومٍ بعد عند الموضع " + نص(موضع_جار)
            وإلا
                ارمي "جيسون: هروبٌ غيرُ مدعومٍ عند الموضع " + نص(موضع_جار)
            نهاية
            موضع_جار = موضع_جار + طول_الهروب
        وإلا
            المتراكم = المتراكم + الحرف
            موضع_جار = موضع_جار + 1
        نهاية
    نهاية
نهاية

دالة حلل_عدد(المصدر، الموضع)
    # (AR) يُعدُّ كلُّ مقطعٍ أرقامَه على حدة. الفحصُ «هل استُهلك شيء؟» لا يكفي:
    #      «-» وحدَها تتخطّاه فتصل إلى «رقم()» فتُسرَّب رسالةُ مدمَجةٍ داخليّة
    #      (RUN037) بدل خطأِ الوحدة — تسريبُ تفاصيلِ تنفيذٍ وخرقُ عقدِ الوحدة.
    متغير البداية = الموضع
    متغير موضع_جار = الموضع

    إذا (حرف_عند(المصدر، موضع_جار) == اشارة_سالب)
        موضع_جار = موضع_جار + 1
    نهاية

    متغير عدد_ارقام_الصحيح = 0
    بينما (هو_رقم(حرف_عند(المصدر، موضع_جار)))
        موضع_جار = موضع_جار + 1
        عدد_ارقام_الصحيح = عدد_ارقام_الصحيح + 1
    نهاية
    إذا (عدد_ارقام_الصحيح == 0)
        ارمي "جيسون: عددٌ خاطئٌ عند الموضع " + نص(البداية)
    نهاية

    # (AR) جيسون يمنع الصفرَ البادئ: «01» ليست عددًا صحيحًا في المواصفة.
    إذا (عدد_ارقام_الصحيح > 1 و حرف_عند(المصدر، موضع_جار - عدد_ارقام_الصحيح) == اصغر_رقم)
        ارمي "جيسون: صفرٌ بادئٌ غيرُ مسموحٍ عند الموضع " + نص(البداية)
    نهاية

    إذا (حرف_عند(المصدر، موضع_جار) == نقطة_عشرية)
        موضع_جار = موضع_جار + 1
        متغير عدد_ارقام_الكسر = 0
        بينما (هو_رقم(حرف_عند(المصدر، موضع_جار)))
            موضع_جار = موضع_جار + 1
            عدد_ارقام_الكسر = عدد_ارقام_الكسر + 1
        نهاية
        إذا (عدد_ارقام_الكسر == 0)
            ارمي "جيسون: كسرٌ بلا أرقامٍ عند الموضع " + نص(البداية)
        نهاية
    نهاية

    متغير حرف_الاس = حرف_عند(المصدر، موضع_جار)
    إذا (حرف_الاس == رمز_الاس_صغير أو حرف_الاس == رمز_الاس_كبير)
        موضع_جار = موضع_جار + 1
        متغير حرف_الاشارة = حرف_عند(المصدر، موضع_جار)
        إذا (حرف_الاشارة == اشارة_سالب أو حرف_الاشارة == اشارة_موجب)
            موضع_جار = موضع_جار + 1
        نهاية
        متغير عدد_ارقام_الاس = 0
        بينما (هو_رقم(حرف_عند(المصدر، موضع_جار)))
            موضع_جار = موضع_جار + 1
            عدد_ارقام_الاس = عدد_ارقام_الاس + 1
        نهاية
        إذا (عدد_ارقام_الاس == 0)
            ارمي "جيسون: أُسٌّ بلا أرقامٍ عند الموضع " + نص(البداية)
        نهاية
    نهاية

    متغير نص_العدد = المصدر.جزء(البداية، موضع_جار - البداية)
    إذا (نص_العدد.يحتوي(نقطة_عشرية) أو نص_العدد.يحتوي(رمز_الاس_صغير) أو نص_العدد.يحتوي(رمز_الاس_كبير))
        ارجع [عشري(نص_العدد)، موضع_جار]
    نهاية
    ارجع [رقم(نص_العدد)، موضع_جار]
نهاية

دالة حلل_قيمة(المصدر، الموضع)
    متغير موضع_جار = تخط_الفراغ(المصدر، الموضع)
    متغير الحرف = حرف_عند(المصدر، موضع_جار)

    إذا (الحرف == نص_فارغ)
        ارمي "جيسون: نهايةٌ مبتورةٌ عند الموضع " + نص(موضع_جار)
    نهاية
    إذا (الحرف == علامة_اقتباس)
        ارجع حلل_نص(المصدر، موضع_جار)
    نهاية
    إذا (الحرف == فتح_كائن)
        ارجع حلل_كائن(المصدر، موضع_جار)
    نهاية
    إذا (الحرف == فتح_مصفوفة)
        ارجع حلل_مصفوفة(المصدر، موضع_جار)
    نهاية
    إذا (الحرف == اشارة_سالب أو هو_رقم(الحرف))
        ارجع حلل_عدد(المصدر، موضع_جار)
    نهاية
    إذا (المصدر.جزء(موضع_جار، 4) == نص_صحيح)
        ارجع [صحيح، موضع_جار + 4]
    نهاية
    إذا (المصدر.جزء(موضع_جار، 5) == نص_خاطئ)
        ارجع [خطأ، موضع_جار + 5]
    نهاية
    إذا (المصدر.جزء(موضع_جار، 4) == نص_عدم)
        ارجع [لاشيء، موضع_جار + 4]
    نهاية

    ارمي "جيسون: رمزٌ غيرُ متوقَّعٍ عند الموضع " + نص(موضع_جار)
نهاية

دالة حلل_مصفوفة(المصدر، الموضع)
    متغير موضع_جار = توقع(المصدر، الموضع، فتح_مصفوفة)
    متغير الناتج = []

    موضع_جار = تخط_الفراغ(المصدر، موضع_جار)
    إذا (حرف_عند(المصدر، موضع_جار) == غلق_مصفوفة)
        ارجع [الناتج، موضع_جار + 1]
    نهاية

    بينما (صحيح)
        متغير الزوج = حلل_قيمة(المصدر، موضع_جار)
        الناتج.أضف(الزوج[0])
        موضع_جار = تخط_الفراغ(المصدر، الزوج[1])

        متغير الفاصل = حرف_عند(المصدر، موضع_جار)
        إذا (الفاصل == غلق_مصفوفة)
            ارجع [الناتج، موضع_جار + 1]
        نهاية
        إذا (الفاصل != فاصلة)
            ارمي "جيسون: توقّعتُ فاصلةً أو قوسَ إغلاقٍ عند الموضع " + نص(موضع_جار)
        نهاية
        موضع_جار = موضع_جار + 1
    نهاية
نهاية

دالة حلل_كائن(المصدر، الموضع)
    متغير موضع_جار = توقع(المصدر، الموضع، فتح_كائن)
    متغير الناتج = {}

    موضع_جار = تخط_الفراغ(المصدر، موضع_جار)
    إذا (حرف_عند(المصدر، موضع_جار) == غلق_كائن)
        ارجع [الناتج، موضع_جار + 1]
    نهاية

    بينما (صحيح)
        موضع_جار = تخط_الفراغ(المصدر، موضع_جار)
        إذا (حرف_عند(المصدر، موضع_جار) != علامة_اقتباس)
            ارمي "جيسون: توقّعتُ مفتاحًا نصّيًّا عند الموضع " + نص(موضع_جار)
        نهاية

        متغير زوج_المفتاح = حلل_نص(المصدر، موضع_جار)
        موضع_جار = تخط_الفراغ(المصدر، زوج_المفتاح[1])
        موضع_جار = توقع(المصدر، موضع_جار، نقطتان)

        متغير زوج_القيمة = حلل_قيمة(المصدر، موضع_جار)
        الناتج.عين(زوج_المفتاح[0]، زوج_القيمة[0])
        موضع_جار = تخط_الفراغ(المصدر، زوج_القيمة[1])

        متغير الفاصل = حرف_عند(المصدر، موضع_جار)
        إذا (الفاصل == غلق_كائن)
            ارجع [الناتج، موضع_جار + 1]
        نهاية
        إذا (الفاصل != فاصلة)
            ارمي "جيسون: توقّعتُ فاصلةً أو قوسَ إغلاقٍ عند الموضع " + نص(موضع_جار)
        نهاية
        موضع_جار = موضع_جار + 1
    نهاية
نهاية

صدّر دالة حلل(المصدر)
    # (AR) يحلّل نصَّ جيسون ويعيد القيمةَ المقابلة
    متغير الزوج = حلل_قيمة(المصدر، 0)
    متغير الباقي = تخط_الفراغ(المصدر، الزوج[1])
    إذا (الباقي < طول(المصدر))
        ارمي "جيسون: زوائدُ بعد نهاية القيمة عند الموضع " + نص(الباقي)
    نهاية
    ارجع الزوج[0]
نهاية

# ═══ التوليد ═══

دالة اهرب_نص(القيمة)
    متغير المتراكم = علامة_اقتباس
    متغير الموضع = 0

    بينما (الموضع < طول(القيمة))
        متغير الحرف = القيمة.جزء(الموضع، 1)
        إذا (الحرف == علامة_اقتباس)
            المتراكم = المتراكم + شرطة_خلفية + علامة_اقتباس
        وإلا إذا (الحرف == شرطة_خلفية)
            المتراكم = المتراكم + شرطة_خلفية + شرطة_خلفية
        وإلا إذا (الحرف == سطر_جديد)
            المتراكم = المتراكم + شرطة_خلفية + رمز_سطر_جديد
        وإلا إذا (الحرف == جدولة)
            المتراكم = المتراكم + شرطة_خلفية + رمز_جدولة
        وإلا إذا (الحرف == ارجاع_السطر)
            المتراكم = المتراكم + شرطة_خلفية + رمز_ارجاع
        وإلا إذا (الحرف == مسافة_خلفية)
            المتراكم = المتراكم + شرطة_خلفية + رمز_مسافة_خلفية
