# ─── مستودع_الإضافات (PluginRegistry) ───
## المستودع الرئيسي لإدارة المصادر والتثبيت
صدّر صنف مستودع_الإضافات
    باني()
        هذا._مصادر = []
        هذا._مثبتة = {}
        هذا._مسار_تثبيت = "~/.sad/إضافات/"
        هذا._ذاكرة_مؤقتة = {}
    نهاية

    ## إضافة مصدر جديد
    دالة أضف_مصدر(مصدر)
        هذا._مصادر.أضف(مصدر)
    نهاية

    ## البحث في جميع المصادر
    دالة ابحث(استعلام)
        متغير نتائج = []
        لكل مصدر في هذا._مصادر
            نتائج.أضف_كل(مصدر.ابحث(استعلام))
        نهاية
        ارجع هذا._أزل_مكرر(نتائج)
    نهاية

    ## الحصول على معلومات إضافة
    دالة معلومات(معرف)
        # التحقق من الذاكرة المؤقتة
        إذا (هذا._ذاكرة_مؤقتة[معرف] != لاشيء)
            ارجع هذا._ذاكرة_مؤقتة[معرف]
        نهاية

        لكل مصدر في هذا._مصادر
            متغير م = مصدر.معلومات(معرف)
            إذا (م != لاشيء)
                هذا._ذاكرة_مؤقتة[معرف] = م
                ارجع م
            نهاية
        نهاية
        ارجع لاشيء
    نهاية

    ## تثبيت إضافة
    دالة ثبّت(معرف, إصدار = "أحدث")
        # التحقق من التثبيت السابق
        إذا (هذا._مثبتة[معرف] != لاشيء)
            ارجع {"نجاح": خطأ, "خطأ": "الإضافة مثبتة مسبقاً"}
        نهاية

        # البحث عن الإضافة
        لكل مصدر في هذا._مصادر
            متغير مسار = مصدر.حمّل(معرف, إصدار)
            إذا (مسار != لاشيء)
                # نسخ الملفات للمسار المحلي
                هذا._مثبتة[معرف] = {
                    "إصدار": إصدار,
                    "مسار": هذا._مسار_تثبيت + معرف,
                    "مصدر": مصدر
                }
                
                ارجع {"نجاح": صحيح, "مسار": هذا._مسار_تثبيت + معرف}
            نهاية
        نهاية

        ارجع {"نجاح": خطأ, "خطأ": "لم يتم العثور على الإضافة"}
    نهاية

    ## إزالة تثبيت إضافة
    دالة أزل(معرف)
        إذا (هذا._مثبتة[معرف] == لاشيء)
            ارجع {"نجاح": خطأ, "خطأ": "الإضافة غير مثبتة"}
        نهاية

        # حذف الملفات
        # TODO: حذف المجلد

        هذا._مثبتة.احذف(معرف)
        ارجع {"نجاح": صحيح}
    نهاية

    ## تحديث إضافة
    دالة حدّث(معرف)
        إذا (هذا._مثبتة[معرف] == لاشيء)
            ارجع {"نجاح": خطأ, "خطأ": "الإضافة غير مثبتة"}
        نهاية

        # إزالة وإعادة تثبيت
        هذا.أزل(معرف)
        ارجع هذا.ثبّت(معرف, "أحدث")
    نهاية

    ## تحديث جميع الإضافات
    دالة حدّث_الكل()
        متغير نتائج = []
        لكل معرف في هذا._مثبتة.مفاتيح()
            نتائج.أضف(هذا.حدّث(معرف))
        نهاية
        ارجع نتائج
    نهاية

    ## قائمة الإضافات المثبتة
    دالة مثبتة()
        متغير قائمة = []
        لكل معرف في هذا._مثبتة.مفاتيح()
            قائمة.أضف({
                "معرف": معرف,
                "إصدار": هذا._مثبتة[معرف].إصدار,
                "مسار": هذا._مثبتة[معرف].مسار
            })
        نهاية
        ارجع قائمة
    نهاية

    ## التحقق من وجود تحديثات
    دالة تحقق_تحديثات()
        متغير تحديثات = []
        لكل معرف في هذا._مثبتة.مفاتيح()
            متغير إصدار_حالي = هذا._مثبتة[معرف].إصدار
            متغير إصدارات = هذا._مثبتة[معرف].مصدر.إصدارات(معرف)
            
            إذا (إصدارات.طول() > 0)
                متغير أحدث = إصدارات[إصدارات.طول() - 1]
                إذا (أحدث != إصدار_حالي)
                    تحديثات.أضف({
                        "معرف": معرف,
                        "حالي": إصدار_حالي,
                        "متاح": أحدث
                    })
                نهاية
            نهاية
        نهاية
        ارجع تحديثات
    نهاية

    # ─── دوال داخلية ───

    دالة _أزل_مكرر(قائمة)
        متغير فريدة = {}
        لكل عنصر في قائمة
            فريدة[عنصر.معرف] = عنصر
        نهاية
        ارجع فريدة.قيم()
    نهاية
نهاية

# ─── المستودع العام الافتراضي ───
صدّر متغير مستودع = جديد مستودع_الإضافات()

# إضافة المصدر المحلي افتراضياً
مستودع.أضف_مصدر(جديد مصدر_محلي("إضافات/"))
مستودع.أضف_مصدر(جديد مصدر_محلي("~/.sad/إضافات/"))

