    دالة حساب_معاملات_مصدر(فهرس: عدد) -> معاملات_مخرج:
        متغير مخرج: معاملات_مخرج
        
        إذا فهرس < 0 أو فهرس >= طول_مصفوفة(المصادر):
            أرجع مخرج
