تعداد نوع_توهين {
    خطي،
    تربيعي،         // 1/r² - واقعي
    لوغاريتمي،
    مخصص
نهاية

هيكل مصدر_صوت {
    الموضع: متجه_صوت
    السرعة: متجه_صوت
    الحجم: عشري = 1.0
    النبرة: عشري = 1.0
    
    // نطاق الصوت
    المسافة_دنيا: عشري = 1.0      // الحجم الكامل
    المسافة_قصوى: عشري = 100.0   // لا يُسمع بعدها
    
    // التوهين
    نوع_التوهين: نوع_توهين = نوع_توهين.تربيعي
    عامل_التوهين: عشري = 1.0
    
    // الاتجاهية (مخروط الصوت)
    اتجاهي: منطقي = خطأ
    اتجاه: متجه_صوت
    زاوية_داخلية: عشري = 360.0   // درجات - حجم كامل
    زاوية_خارجية: عشري = 360.0   // درجات - بدء التوهين
    حجم_خارجي: عشري = 0.0        // الحجم خارج المخروط
    
    // الحالة
    يعمل: منطقي = خطأ
    تكرار: منطقي = خطأ
    معرف_المورد: نص = ""
نهاية

دالة مصدر_صوت_جديد(موضع: متجه_صوت) -> مصدر_صوت:
    متغير م: مصدر_صوت
    م.الموضع = موضع
    م.السرعة = متجه_صوت_جديد(0.0، 0.0، 0.0)
    م.اتجاه = متجه_صوت_جديد(0.0، 0.0، -1.0)
    أرجع م
نهاية

// ============== حساب التوهين ==============

دالة حساب_توهين(مصدر: مصدر_صوت، مسافة: عشري) -> عشري:
    إذا مسافة <= مصدر.المسافة_دنيا:
        أرجع 1.0
    نهاية
    
    إذا مسافة >= مصدر.المسافة_قصوى:
        أرجع 0.0
    نهاية
    
    متغير نسبة: عشري = (مسافة - مصدر.المسافة_دنيا) / 
                        (مصدر.المسافة_قصوى - مصدر.المسافة_دنيا)
    
    تطابق مصدر.نوع_التوهين:
        حالة نوع_توهين.خطي:
            أرجع 1.0 - نسبة
            
        حالة نوع_توهين.تربيعي:
            متغير عامل: عشري = مصدر.المسافة_دنيا / مسافة
            أرجع عامل * عامل * مصدر.عامل_التوهين
            
        حالة نوع_توهين.لوغاريتمي:
            أرجع 1.0 - (سجل(1.0 + نسبة * 9.0) / سجل(10.0))
            
        حالة _:
            أرجع 1.0 - نسبة
    نهاية
نهاية

// ============== حساب الاتجاهية ==============

دالة حساب_اتجاهية(مصدر: مصدر_صوت، اتجاه_للمستمع: متجه_صوت) -> عشري:
    إذا !مصدر.اتجاهي:
        أرجع 1.0
    نهاية
    
    // حساب الزاوية بين اتجاه المصدر واتجاه المستمع
    متغير اتجاه_م: متجه_صوت = طبيعي_متجه(مصدر.اتجاه)
    متغير اتجاه_ل: متجه_صوت = طبيعي_متجه(اتجاه_للمستمع)
    
    // حاصل الضرب النقطي
    متغير نقطي: عشري = اتجاه_م.س * اتجاه_ل.س + 
                        اتجاه_م.ص * اتجاه_ل.ص + 
                        اتجاه_م.ع * اتجاه_ل.ع
    
    متغير زاوية: عشري = قوس_جتا(نقطي) * 180.0 / 3.14159  // تحويل للدرجات
    
    إذا زاوية <= مصدر.زاوية_داخلية / 2.0:
        أرجع 1.0
    نهاية
    
    إذا زاوية >= مصدر.زاوية_خارجية / 2.0:
        أرجع مصدر.حجم_خارجي
    نهاية
    
    // استيفاء بين الداخلية والخارجية
    متغير نسبة: عشري = (زاوية - مصدر.زاوية_داخلية / 2.0) /
                        ((مصدر.زاوية_خارجية - مصدر.زاوية_داخلية) / 2.0)
    أرجع 1.0 - نسبة * (1.0 - مصدر.حجم_خارجي)
نهاية

// ============== تأثير دوبلر ==============

دالة حساب_دوبلر(مصدر: مصدر_صوت، مستمع: مستمع) -> عشري:
    متغير اتجاه: متجه_صوت = فرق_متجه(مصدر.الموضع، مستمع.الموضع)
    متغير اتجاه_ط: متجه_صوت = طبيعي_متجه(اتجاه)
    
    // سرعة المصدر باتجاه المستمع
    متغير سرعة_مصدر: عشري = مصدر.السرعة.س * اتجاه_ط.س +
                             مصدر.السرعة.ص * اتجاه_ط.ص +
                             مصدر.السرعة.ع * اتجاه_ط.ع
    
    // سرعة المستمع باتجاه المصدر (عكس الاتجاه)
    متغير سرعة_مستمع: عشري = -(مستمع.السرعة.س * اتجاه_ط.س +
                                مستمع.السرعة.ص * اتجاه_ط.ص +
                                مستمع.السرعة.ع * اتجاه_ط.ع)
    
    // معادلة دوبلر: f' = f * (c + vr) / (c + vs)
    متغير بسط: عشري = سرعة_الصوت + سرعة_مستمع
    متغير مقام: عشري = سرعة_الصوت + سرعة_مصدر
    
    إذا قيمة_مطلقة(مقام) < 0.001:
        أرجع 1.0
    نهاية
    
    أرجع بسط / مقام
نهاية

// ============== HRTF - دالة نقل الرأس ==============

هيكل معاملات_HRTF {
    // تأخير بين الأذنين (ITD)
    تأخير_يسار: عشري = 0.0  // ميلي ثانية
    تأخير_يمين: عشري = 0.0
    
    // فرق الشدة بين الأذنين (ILD)
    مكسب_يسار: عشري = 1.0
    مكسب_يمين: عشري = 1.0
    
    // فلتر لكل أذن (مبسط)
    قطع_ترددي_يسار: عشري = 20000.0  // هرتز
    قطع_ترددي_يمين: عشري = 20000.0
نهاية

دالة حساب_HRTF(مستمع: مستمع، موضع_مصدر: متجه_صوت) -> معاملات_HRTF:
    متغير معاملات: معاملات_HRTF
    
    // اتجاه المصدر بالنسبة للمستمع
    متغير اتجاه: متجه_صوت = فرق_متجه(مستمع.الموضع، موضع_مصدر)
    متغير اتجاه_ط: متجه_صوت = طبيعي_متجه(اتجاه)
    
    // حساب الزاوية الأفقية (azimuth) بالنسبة لاتجاه النظر
    // نحتاج لتحويل لنظام المستمع المحلي
    
    // تبسيط: نستخدم المركبة X مباشرة
    متغير جانبية: عشري = اتجاه_ط.س  // -1 (يسار) إلى +1 (يمين)
    
    // حساب ITD (Interaural Time Difference)
    // تقريب: نصف قطر الرأس ~8.75 سم
    ثابت نصف_قطر_رأس: عشري = 0.0875  // متر
    متغير زاوية_أفقية: عشري = قوس_جا(جانبية)
    متغير ITD: عشري = نصف_قطر_رأس * (زاوية_أفقية + جا(زاوية_أفقية)) / سرعة_الصوت
    
    إذا جانبية >= 0:  // المصدر على اليمين
        معاملات.تأخير_يسار = ITD * 1000.0  // تحويل لميلي ثانية
        معاملات.تأخير_يمين = 0.0
    وإلا:  // المصدر على اليسار
        معاملات.تأخير_يسار = 0.0
        معاملات.تأخير_يمين = قيمة_مطلقة(ITD) * 1000.0
    نهاية
    
    // حساب ILD (Interaural Level Difference)
    // تقريب مبسط
    متغير ILD_dB: عشري = 10.0 * جانبية  // حتى 10 dB فرق
    متغير ILD_خطي: عشري = قوة(10.0، ILD_dB / 20.0)
    
    إذا جانبية >= 0:  // المصدر على اليمين
        معاملات.مكسب_يمين = 1.0
        معاملات.مكسب_يسار = 1.0 / ILD_خطي
    وإلا:  // المصدر على اليسار
        معاملات.مكسب_يسار = 1.0
        معاملات.مكسب_يمين = ILD_خطي
    نهاية
    
    // فلترة بسيطة (تأثير ظل الرأس)
    // الترددات العالية تُمتص أكثر
    متغير امتصاص: عشري = قيمة_مطلقة(جانبية) * 5000.0
    إذا جانبية >= 0:
        معاملات.قطع_ترددي_يسار = 20000.0 - امتصاص
    وإلا:
        معاملات.قطع_ترددي_يمين = 20000.0 - امتصاص
    نهاية
    
    أرجع معاملات
نهاية

