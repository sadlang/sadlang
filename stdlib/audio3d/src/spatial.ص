// ============== الثوابت الصوتية ==============

ثابت سرعة_الصوت: عشري = 343.0        // متر/ثانية في الهواء عند 20°C
ثابت العتبة_السمعية: عشري = 0.00001  // أصغر ضغط صوتي مسموع

// ============== متجه ثلاثي للصوت ==============

هيكل متجه_صوت 
    س: عشري = 0.0
    ص: عشري = 0.0
    ع: عشري = 0.0
نهاية

دالة متجه_صوت_جديد(س: عشري، ص: عشري، ع: عشري) -> متجه_صوت:
    متغير م: متجه_صوت
    م.س = س
    م.ص = ص
    م.ع = ع
    أرجع م
نهاية

دالة طول_متجه(م: متجه_صوت) -> عشري:
    أرجع جذر(م.س * م.س + م.ص * م.ص + م.ع * م.ع)
نهاية

دالة طبيعي_متجه(م: متجه_صوت) -> متجه_صوت:
    متغير ط: عشري = طول_متجه(م)
    إذا ط < 0.0001:
        أرجع متجه_صوت_جديد(0.0، 0.0، 0.0)
    نهاية
    أرجع متجه_صوت_جديد(م.س / ط، م.ص / ط، م.ع / ط)
نهاية

دالة فرق_متجه(أ: متجه_صوت، ب: متجه_صوت) -> متجه_صوت:
    أرجع متجه_صوت_جديد(ب.س - أ.س، ب.ص - أ.ص، ب.ع - أ.ع)
نهاية

