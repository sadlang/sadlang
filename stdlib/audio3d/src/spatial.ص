        // حساب المسافة والاتجاه
        متغير اتجاه: متجه_صوت = فرق_متجه(المستمع.الموضع، مصدر.الموضع)
        متغير مسافة: عشري = طول_متجه(اتجاه)
        
        // التوهين بالمسافة
        متغير توهين: عشري = حساب_توهين(مصدر، مسافة)
        
        // الاتجاهية
        متغير اتجاهية: عشري = حساب_اتجاهية(مصدر، اتجاه)
        
        // الحجم الأساسي
        متغير حجم_أساسي: عشري = مصدر.الحجم * توهين * اتجاهية * الحجم_الرئيسي
        
        // HRTF
        إذا تفعيل_HRTF:
            متغير hrtf: معاملات_HRTF = حساب_HRTF(المستمع، مصدر.الموضع)
            مخرج.حجم_يسار = حجم_أساسي * hrtf.مكسب_يسار
            مخرج.حجم_يمين = حجم_أساسي * hrtf.مكسب_يمين
            مخرج.تأخير_يسار = hrtf.تأخير_يسار
            مخرج.تأخير_يمين = hrtf.تأخير_يمين
        وإلا:
