// ============== حساب الانعكاسات المبكرة ==============

هيكل انعكاس_مبكر {
    التأخير: عشري      // ميلي ثانية
    المكسب: عشري
    الاتجاه: متجه_صوت  // من أين يأتي الانعكاس
نهاية

دالة حساب_انعكاسات_مبكرة(
        مصدر: متجه_صوت،
        مستمع: متجه_صوت،
        غرفة: إعدادات_صدى) -> مصفوفة[انعكاس_مبكر]:
    
    متغير انعكاسات: مصفوفة[انعكاس_مبكر]
    
    // 6 انعكاسات أولية (الجدران الـ 6)
    متغير مواضع_انعكاس: مصفوفة[متجه_صوت]
    
    // الجدار الأمامي
    مصفوفة_أضف(مواضع_انعكاس، متجه_صوت_جديد(مصدر.س، مصدر.ص، -مصدر.ع))
    // الجدار الخلفي
    مصفوفة_أضف(مواضع_انعكاس، متجه_صوت_جديد(مصدر.س، مصدر.ص، غرفة.الطول * 2 - مصدر.ع))
    // الجدار الأيسر
    مصفوفة_أضف(مواضع_انعكاس، متجه_صوت_جديد(-مصدر.س، مصدر.ص، مصدر.ع))
    // الجدار الأيمن
    مصفوفة_أضف(مواضع_انعكاس، متجه_صوت_جديد(غرفة.العرض * 2 - مصدر.س، مصدر.ص، مصدر.ع))
    // الأرضية
    مصفوفة_أضف(مواضع_انعكاس، متجه_صوت_جديد(مصدر.س، -مصدر.ص، مصدر.ع))
    // السقف
    مصفوفة_أضف(مواضع_انعكاس، متجه_صوت_جديد(مصدر.س، غرفة.الارتفاع * 2 - مصدر.ص، مصدر.ع))
    
    متغير معاملات_انعكاس: مصفوفة[عشري]
    مصفوفة_أضف(معاملات_انعكاس، غرفة.انعكاسية_جدران)  // أمامي
    مصفوفة_أضف(معاملات_انعكاس، غرفة.انعكاسية_جدران)  // خلفي
    مصفوفة_أضف(معاملات_انعكاس، غرفة.انعكاسية_جدران)  // أيسر
    مصفوفة_أضف(معاملات_انعكاس، غرفة.انعكاسية_جدران)  // أيمن
    مصفوفة_أضف(معاملات_انعكاس، غرفة.انعكاسية_أرضية)  // أرضية
    مصفوفة_أضف(معاملات_انعكاس، غرفة.انعكاسية_سقف)    // سقف
    
    لكل ف من 0 حتى 6:
        متغير موضع_افتراضي: متجه_صوت = مواضع_انعكاس[ف]
        متغير اتجاه: متجه_صوت = فرق_متجه(مستمع، موضع_افتراضي)
        متغير مسافة: عشري = طول_متجه(اتجاه)
        
        متغير ان: انعكاس_مبكر
        ان.التأخير = (مسافة / سرعة_الصوت) * 1000.0  // بالميلي ثانية
        ان.المكسب = معاملات_انعكاس[ف] / (مسافة * مسافة)
        ان.الاتجاه = طبيعي_متجه(اتجاه)
        
        مصفوفة_أضف(انعكاسات، ان)
    نهاية
    
    أرجع انعكاسات
نهاية

// ============== مدير الصوت المكاني ==============

صنف مدير_صوت_مكاني {
    خاص المستمع: مستمع
    خاص المصادر: مصفوفة[مصدر_صوت]
    خاص إعدادات_الغرفة: إعدادات_صدى
    خاص تفعيل_HRTF: منطقي = صحيح
    خاص تفعيل_دوبلر: منطقي = صحيح
    خاص تفعيل_صدى: منطقي = صحيح
    خاص الحجم_الرئيسي: عشري = 1.0
    
    دالة بناء():
        المستمع = مستمع_افتراضي()
        المصادر = مصفوفة[مصدر_صوت]()
        إعدادات_الغرفة = إعدادات_غرفة_مسبقة(نوع_غرفة.متوسطة)
