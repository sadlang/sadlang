# Keystore الآمن
# ═══════════════════════════════════════════════════════════════════════════

صنف مخزن_مفاتيح_آمن
    متغير الاسم
    
    باني(الاسم)
        هذا.الاسم = الاسم أو "default"
    نهاية
    
    دالة أنشئ_مفتاح(المعرف، الإعدادات)
        ارجع وعد(دالة(نجح، فشل)
            متغير مفتاح = _keystore_create(المعرف، الإعدادات)
            نجح(مفتاح)
        نهاية)
    نهاية
    
    دالة احصل_مفتاح(المعرف)
        ارجع _keystore_get(المعرف)
    نهاية
    
    دالة احذف_مفتاح(المعرف)
        ارجع _keystore_delete(المعرف)
    نهاية
    
    دالة شفّر_بمفتاح(المعرف، البيانات)
        ارجع وعد(دالة(نجح، فشل)
            متغير مشفر = _keystore_encrypt(المعرف، البيانات)
            نجح(مشفر)
        نهاية)
    نهاية
    
    دالة فك_تشفير_بمفتاح(المعرف، البيانات_المشفرة)
        ارجع وعد(دالة(نجح، فشل)
            متغير نص = _keystore_decrypt(المعرف، البيانات_المشفرة)
            نجح(نص)
        نهاية)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# SSL Pinning
# ═══════════════════════════════════════════════════════════════════════════

صنف ssl_pinning_متقدم
    متغير الشهادات
    
    باني()
        هذا.الشهادات = {}
    نهاية
    
    دالة أضف_pin(النطاق، التجزئة)
        إذا (!هذا.الشهادات[النطاق])
            هذا.الشهادات[النطاق] = []
        نهاية
        هذا.الشهادات[النطاق].أضف(التجزئة)
    نهاية
    
    دالة أضف_شهادة(النطاق، مسار_الشهادة)
        متغير التجزئة = _certificate_hash(مسار_الشهادة)
        هذا.أضف_pin(النطاق، التجزئة)
    نهاية
    
    دالة تحقق(النطاق، الشهادة)
        متغير التجزئة = _certificate_hash(الشهادة)
        متغير الpins = هذا.الشهادات[النطاق]
        
        إذا (!الpins)
            ارجع صحيح
        نهاية
        
        ارجع الpins.يحتوي(التجزئة)
    نهاية
    
    دالة فعّل()
        _enable_ssl_pinning(هذا.الشهادات)
    نهاية
نهاية

