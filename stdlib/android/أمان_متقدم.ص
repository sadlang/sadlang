# OAuth 2.0 المتقدم
# ═══════════════════════════════════════════════════════════════════════════

صنف OAuth2_متقدم
    متغير معرف_العميل
    متغير رابط_التفويض
    متغير رابط_الرمز
    متغير رابط_إعادة_التوجيه
    متغير النطاقات
    
    باني(الإعدادات)
        هذا.معرف_العميل = الإعدادات["معرف_العميل"]
        هذا.رابط_التفويض = الإعدادات["رابط_التفويض"]
        هذا.رابط_الرمز = الإعدادات["رابط_الرمز"]
        هذا.رابط_إعادة_التوجيه = الإعدادات["رابط_إعادة_التوجيه"]
        هذا.النطاقات = الإعدادات["النطاقات"] أو []
    نهاية
    
    دالة ابدأ_التسجيل()
        ارجع وعد(دالة(نجح، فشل)
            متغير رمز = _oauth_browser(هذا.رابط_التفويض، هذا.رابط_إعادة_التوجيه)
            إذا (رمز)
                نجح(رمز)
            وإلا
                فشل("فشل التسجيل")
            نهاية
        نهاية)
    نهاية
    
    دالة استبدل_الرمز(رمز_التفويض)
        ارجع وعد(دالة(نجح، فشل)
            نجح({"رمز_الوصول" = ""، "رمز_التحديث" = ""})
        نهاية)
    نهاية
نهاية

دالة OAuth_Google_متقدم(الإعدادات)
    ارجع OAuth2_متقدم({
        "معرف_العميل" = الإعدادات["معرف_العميل"]،
