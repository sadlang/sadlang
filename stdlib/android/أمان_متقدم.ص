# حماية من التلاعب
# ═══════════════════════════════════════════════════════════════════════════

صنف حماية_التطبيق_متقدمة
    باني()
    نهاية
    
    دالة تحقق_السلامة()
        ارجع وعد(دالة(نجح، فشل)
            متغير النتائج = {
                "الجذر" = _is_rooted()،
                "المحاكي" = _is_emulator()،
                "معدل" = _is_tampered()،
                "مصحح" = _is_debugger_attached()
            }
            
            متغير آمن = !النتائج.الجذر و !النتائج.المحاكي و !النتائج.معدل و !النتائج.مصحح
            نجح({"آمن" = آمن، "التفاصيل" = النتائج})
        نهاية)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# التشفير من طرف لطرف (E2E)
# ═══════════════════════════════════════════════════════════════════════════

صنف تشفير_E2E_متقدم
    متغير مفتاحي_الخاص
    متغير مفتاحي_العام
    متغير مفاتيح_المستخدمين
    
    باني()
        هذا.مفاتيح_المستخدمين = {}
    نهاية
    
    دالة هيئ()
        ارجع وعد(دالة(نجح، فشل)
            متغير rsa = مشفر_RSA()
            rsa.ولّد_زوج_مفاتيح(2048)
            
            هذا.مفتاحي_الخاص = rsa.المفتاح_الخاص
            هذا.مفتاحي_العام = rsa.المفتاح_العام
            
            نجح()
        نهاية)
    نهاية
    
    دالة سجّل_مفتاح_مستخدم(معرف_المستخدم، المفتاح_العام)
        هذا.مفاتيح_المستخدمين[معرف_المستخدم] = المفتاح_العام
    نهاية
    
    دالة شفّر_رسالة(معرف_المستلم، الرسالة)
        ارجع وعد(دالة(نجح، فشل)
            متغير المفتاح_العام = هذا.مفاتيح_المستخدمين[معرف_المستلم]
            
            إذا (!المفتاح_العام)
                فشل("مفتاح المستخدم غير موجود")
                ارجع
            نهاية
            
            متغير مفتاح_الجلسة = ولّد_مفتاح_عشوائي(32)
            متغير aes = مشفر_AES({"المفتاح" = مفتاح_الجلسة})
            متغير رسالة_مشفرة = انتظر aes.شفّر(الرسالة)
            
            متغير rsa = مشفر_RSA()
            rsa.المفتاح_العام = المفتاح_العام
            متغير مفتاح_مشفر = انتظر rsa.شفّر(مفتاح_الجلسة)
            
            نجح({"الرسالة" = رسالة_مشفرة، "المفتاح" = مفتاح_مشفر})
        نهاية)
    نهاية
نهاية

