# التشفير المتقدم
# ═══════════════════════════════════════════════════════════════════════════

صنف مشفر_AES
    متغير المفتاح
    متغير خوارزمية
    
    باني(الإعدادات)
        هذا.المفتاح = الإعدادات["المفتاح"]
        هذا.خوارزمية = الإعدادات["الخوارزمية"] أو "AES-256-GCM"
    نهاية
    
    دالة شفّر(النص)
        ارجع وعد(دالة(نجح، فشل)
            متغير iv = ولّد_iv()
            متغير مشفر = _aes_encrypt(النص، هذا.المفتاح، iv)
            نجح({"بيانات" = مشفر، "iv" = iv})
        نهاية)
    نهاية
    
    دالة فك_التشفير(البيانات_المشفرة، iv)
        ارجع وعد(دالة(نجح، فشل)
            متغير نص = _aes_decrypt(البيانات_المشفرة، هذا.المفتاح، iv)
            نجح(نص)
        نهاية)
    نهاية
نهاية

صنف مشفر_RSA
    متغير المفتاح_العام
    متغير المفتاح_الخاص
    
    باني()
        هذا.المفتاح_العام = لا_شيء
        هذا.المفتاح_الخاص = لا_شيء
    نهاية
    
    دالة ولّد_زوج_مفاتيح(الحجم)
        متغير الحجم_الفعلي = الحجم أو 2048
        متغير زوج = _rsa_generate(الحجم_الفعلي)
        هذا.المفتاح_العام = زوج.عام
        هذا.المفتاح_الخاص = زوج.خاص
        ارجع هذا
    نهاية
    
    دالة شفّر(النص)
        ارجع وعد(دالة(نجح، فشل)
            متغير مشفر = _rsa_encrypt(النص، هذا.المفتاح_العام)
            نجح(مشفر)
        نهاية)
    نهاية
    
    دالة فك_التشفير(البيانات_المشفرة)
        ارجع وعد(دالة(نجح، فشل)
            متغير نص = _rsa_decrypt(البيانات_المشفرة، هذا.المفتاح_الخاص)
            نجح(نص)
        نهاية)
    نهاية
    
    دالة وقّع(البيانات)
        ارجع _rsa_sign(البيانات، هذا.المفتاح_الخاص)
    نهاية
    
    دالة تحقق_التوقيع(البيانات، التوقيع)
        ارجع _rsa_verify(البيانات، التوقيع، هذا.المفتاح_العام)
    نهاية
نهاية

# دوال التجزئة
دالة تجزئة_SHA256(النص)
    ارجع _sha256(النص)
نهاية

دالة تجزئة_SHA512(النص)
    ارجع _sha512(النص)
نهاية

دالة HMAC(الرسالة، المفتاح، الخوارزمية)
    ارجع _hmac(الرسالة، المفتاح، الخوارزمية أو "SHA256")
نهاية

دالة اشتق_مفتاح(كلمة_السر، الملح، التكرارات، الطول)
