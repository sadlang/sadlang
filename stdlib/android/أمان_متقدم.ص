# JWT المتقدم
# ═══════════════════════════════════════════════════════════════════════════

صنف JWT_متقدم
    متغير السر
    متغير الخوارزمية
    
    باني(الإعدادات)
        هذا.السر = الإعدادات["السر"]
        هذا.الخوارزمية = الإعدادات["الخوارزمية"] أو "HS256"
    نهاية
    
    دالة أنشئ(الحمولة، الخيارات)
        متغير الرأس = {"alg" = هذا.الخوارزمية، "typ" = "JWT"}
        متغير الحمولة_النهائية = {...الحمولة}
        
        إذا (الخيارات["انتهاء"])
            الحمولة_النهائية["exp"] = الآن() + الخيارات["انتهاء"]
        نهاية
        
        متغير الرأس_مرمز = base64url(إلى_json(الرأس))
        متغير الحمولة_مرمزة = base64url(إلى_json(الحمولة_النهائية))
        متغير التوقيع = هذا.وقّع(الرأس_مرمز + "." + الحمولة_مرمزة)
        
        ارجع الرأس_مرمز + "." + الحمولة_مرمزة + "." + التوقيع
    نهاية
    
    دالة تحقق(الرمز)
        متغير أجزاء = الرمز.قسّم(".")
        
        إذا (أجزاء.الطول() != 3)
            ارجع {"صالح" = خطأ، "الخطأ" = "تنسيق غير صالح"}
        نهاية
        
        متغير التوقيع_المتوقع = هذا.وقّع(أجزاء[0] + "." + أجزاء[1])
        
        إذا (أجزاء[2] != التوقيع_المتوقع)
            ارجع {"صالح" = خطأ، "الخطأ" = "توقيع غير صالح"}
        نهاية
        
        متغير الحمولة = من_json(base64url_decode(أجزاء[1]))
        
        إذا (الحمولة["exp"] و الحمولة["exp"] < الآن())
            ارجع {"صالح" = خطأ، "الخطأ" = "الرمز منتهي الصلاحية"}
        نهاية
        
        ارجع {"صالح" = صحيح، "الحمولة" = الحمولة}
    نهاية
    
    دالة وقّع(البيانات)
        ارجع HMAC(البيانات، هذا.السر، "SHA256")
    نهاية
نهاية

