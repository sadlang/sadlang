نهاية

# ═══════════════════════════════════════════════════════════════════════════
# المصادقة البيومترية المتقدمة
# ═══════════════════════════════════════════════════════════════════════════

صنف مصادقة_بيومترية_متقدمة
    متغير متاح
    متغير الأنواع_المدعومة
    
    باني()
        هذا.متاح = خطأ
        هذا.الأنواع_المدعومة = []
    نهاية
    
    دالة تحقق_التوفر()
        ارجع وعد(دالة(نجح، فشل)
            هذا.متاح = _biometric_available()
            هذا.الأنواع_المدعومة = _biometric_types()
            نجح({
                "متاح" = هذا.متاح،
                "الأنواع" = هذا.الأنواع_المدعومة
            })
        نهاية)
    نهاية
    
    دالة صادق(الإعدادات)
        ارجع وعد(دالة(نجح، فشل)
            متغير العنوان = الإعدادات["العنوان"] أو "تحقق من هويتك"
            متغير الوصف = الإعدادات["الوصف"] أو "استخدم بصمتك أو وجهك"
            
            متغير نتيجة = _biometric_authenticate(العنوان، الوصف)
            
            إذا (نتيجة.نجح)
                نجح({"نجح" = صحيح})
            وإلا
                فشل({"نجح" = خطأ، "السبب" = نتيجة.السبب})
            نهاية
        نهاية)
    نهاية
نهاية

دالة صادق_بيومتري(الإعدادات)
    متغير المصادق = مصادقة_بيومترية_متقدمة()
    ارجع المصادق.صادق(الإعدادات)
نهاية

