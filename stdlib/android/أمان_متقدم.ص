        "رابط_الرمز" = "https://oauth2.googleapis.com/token"،
        "رابط_إعادة_التوجيه" = الإعدادات["رابط_إعادة_التوجيه"]،
        "النطاقات" = الإعدادات["النطاقات"] أو ["openid"، "email"، "profile"]
    })
نهاية

