        هذا.الحد_الأقصى = الإعدادات["إلى"] أو 1.0
        هذا.القيمة = هذا.الحد_الأدنى
        هذا.المدة = الإعدادات["المدة"] أو 300
        هذا.المنحنى = الإعدادات["المنحنى"] أو منحنيات.ease_in_out
        هذا.الحالة = "متوقف"
    نهاية
    
    دالة ابدأ()
        هذا.الحالة = "يعمل"
        # بدء الحركة
    نهاية
    
    دالة أوقف()
        هذا.الحالة = "متوقف"
    نهاية
    
    دالة عكس()
        # عكس اتجاه الحركة
    نهاية
    
    دالة كرر(عدد_مرات)
        # تكرار الحركة
    نهاية
    
    دالة أعد_الضبط()
        هذا.القيمة = هذا.الحد_الأدنى
        هذا.الحالة = "متوقف"
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# منحنيات الحركة (Easing Curves)
# ═══════════════════════════════════════════════════════════════════════════

صنف منحنيات
    # منحنيات قياسية
    متغير خطي = "linear"
    متغير ease_in = "easeIn"
    متغير ease_out = "easeOut"
    متغير ease_in_out = "easeInOut"
    
    # منحنيات متقدمة
    متغير bounce_in = "bounceIn"
    متغير bounce_out = "bounceOut"
    متغير bounce_in_out = "bounceInOut"
    
    متغير elastic_in = "elasticIn"
    متغير elastic_out = "elasticOut"
    متغير elastic_in_out = "elasticInOut"
    
    متغير back_in = "backIn"
    متغير back_out = "backOut"
    متغير back_in_out = "backInOut"
    
    # منحنيات مادية
    متغير fast_out_slow_in = "fastOutSlowIn"
    متغير slow_middle = "slowMiddle"
    متغير fast_linear_to_slow = "fastLinearToSlow"
    
    # منحنى مخصص (Cubic Bezier)
    دالة مخصص(x1، y1، x2، y2)
        ارجع "cubic(" + نص(x1) + "," + نص(y1) + "," + نص(x2) + "," + نص(y2) + ")"
    نهاية
    
    # سلسلة منحنيات
    دالة سلسلة(منحنيات_متعددة)
        ارجع "chain:" + منحنيات_متعددة.انضم("|")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# الحركات الفيزيائية (Spring Physics)
# ═══════════════════════════════════════════════════════════════════════════

صنف حركة_نابض
    متغير الصلابة
    متغير التخميد
    متغير الكتلة
    متغير القيمة_الهدف
    متغير السرعة
    
    باني(الإعدادات)
        هذا.الصلابة = الإعدادات["الصلابة"] أو 500
        هذا.التخميد = الإعدادات["التخميد"] أو 20
        هذا.الكتلة = الإعدادات["الكتلة"] أو 1.0
        هذا.القيمة_الهدف = الإعدادات["الهدف"] أو 0.0
        هذا.السرعة = 0.0
    نهاية
    
    دالة حدّث(القيمة_الحالية، dt)
        # معادلة الحركة التوافقية المخمدة
        متغير التسارع = -هذا.الصلابة * (القيمة_الحالية - هذا.القيمة_الهدف) - هذا.التخميد * هذا.السرعة
        التسارع = التسارع / هذا.الكتلة
        
        هذا.السرعة += التسارع * dt
        متغير قيمة_جديدة = القيمة_الحالية + هذا.السرعة * dt
        
        ارجع قيمة_جديدة
    نهاية
نهاية

دالة عنصر_نابض(الابن، الإعدادات)
    متغير النابض = حركة_نابض(الإعدادات)
    
    ارجع مسموع_السحب({
        "عند_السحب" = دالة(تفاصيل)
            النابض.القيمة_الهدف = تفاصيل.الإزاحة.x
        نهاية،
        "عند_انتهاء_السحب" = دالة()
            النابض.القيمة_الهدف = 0
        نهاية،
        "ابن" = حركة_قيمة(النابض، الابن)
    })
نهاية

# حركة الجاذبية
صنف حركة_جاذبية
    متغير التسارع
    متغير السرعة
    متغير الموقع
    متغير الأرضية
    متغير الارتداد
    
    باني(الإعدادات)
        هذا.التسارع = الإعدادات["الجاذبية"] أو 9.8
        هذا.السرعة = 0
        هذا.الموقع = الإعدادات["البداية"] أو 0
        هذا.الأرضية = الإعدادات["الأرضية"] أو 500
        هذا.الارتداد = الإعدادات["الارتداد"] أو 0.7
    نهاية
    
    دالة حدّث(dt)
        هذا.السرعة += هذا.التسارع * dt
        هذا.الموقع += هذا.السرعة * dt
        
        # ارتداد من الأرضية
        إذا (هذا.الموقع >= هذا.الأرضية)
            هذا.الموقع = هذا.الأرضية
            هذا.السرعة = -هذا.السرعة * هذا.الارتداد
        نهاية
        
        ارجع هذا.الموقع
    نهاية
نهاية

# حركة الاحتكاك
صنف حركة_احتكاك
    متغير معامل_الاحتكاك
    متغير السرعة
    متغير الحد_الأدنى
    
    باني(الإعدادات)
        هذا.معامل_الاحتكاك = الإعدادات["الاحتكاك"] أو 0.015
        هذا.السرعة = الإعدادات["السرعة_الأولية"] أو 0
        هذا.الحد_الأدنى = 0.1
    نهاية
    
    دالة حدّث(dt)
        هذا.السرعة *= (1 - هذا.معامل_الاحتكاك)
        
        إذا (قيمة_مطلقة(هذا.السرعة) < هذا.الحد_الأدنى)
            هذا.السرعة = 0
        نهاية
        
        ارجع هذا.السرعة * dt
    نهاية
نهاية

