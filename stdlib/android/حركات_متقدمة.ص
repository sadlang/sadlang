# حركات القائمة
# ═══════════════════════════════════════════════════════════════════════════

دالة قائمة_متحركة(العناصر، الإعدادات)
    متغير التأخير = الإعدادات["تأخير_بين_العناصر"] أو 50
    متغير نوع_الحركة = الإعدادات["نوع_الحركة"] أو "تلاشي_انزلاق"
    
    ارجع عمود(
        العناصر.خريطة_بفهرس(دالة(عنصر، فهرس)
            ارجع حركة_مؤجلة({
                "تأخير" = فهرس * التأخير،
                "ابن" = حركة_عنصر_قائمة(عنصر، نوع_الحركة)
            })
        نهاية)
    )
نهاية

دالة حركة_عنصر_قائمة(عنصر، نوع)
    إذا (نوع == "تلاشي_انزلاق")
        ارجع تلاشي_دخول(انزلاق_من_اليمين(عنصر))
    وإلا إذا (نوع == "تكبير")
        ارجع تكبير_دخول(عنصر)
    وإلا
        ارجع تلاشي_دخول(عنصر)
    نهاية
نهاية

