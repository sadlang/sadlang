    باني()
        هذا.الحركات = []
        هذا.الفهرس_الحالي = 0
    نهاية
    
    دالة ثم(حركة)
        هذا.الحركات.أضف(حركة)
        ارجع هذا
    نهاية
    
    دالة ابدأ()
        هذا.الفهرس_الحالي = 0
