دالة أرقام_عربية(رقم)
    # تحويل إلى أرقام هندية: ٠١٢٣٤٥٦٧٨٩
    متغير الأرقام_الهندية = ["٠"، "١"، "٢"، "٣"، "٤"، "٥"، "٦"، "٧"، "٨"، "٩"]
    متغير النتيجة = ""
    
    لكل حرف في نص(رقم)
        إذا (حرف >= "0" و حرف <= "9")
            النتيجة += الأرقام_الهندية[رقم(حرف) - رقم("0")]
        وإلا
            النتيجة += حرف
        نهاية
    نهاية
    
    ارجع النتيجة
نهاية

دالة أرقام_لاتينية(رقم)
    # إبقاء الأرقام اللاتينية: 0123456789
    ارجع نص(رقم)
نهاية

