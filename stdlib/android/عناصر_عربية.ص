دالة زخرفة_إسلامية(النمط)
    # أنماط: "هندسي"، "نباتي"، "أرابيسك"، "نجمي"
    ارجع صورة("assets/islamic_patterns/" + النمط + ".svg")
نهاية

دالة إطار_إسلامي(الابن، النمط)
    ارجع طبقات([
        زخرفة_إسلامية(النمط)،
        حشوة({
            "الكل" = 20،
            "ابن" = الابن
        })
    ])
نهاية

دالة بطاقة_إسلامية(الإعدادات)
    ارجع بطاقة({
        "خلفية" = تدرج_لوني(
            لون("#1a472a")،  # أخضر داكن
            لون("#2d5a3d")
        )،
        "محتوى" = طبقات([
            # زخرفة الخلفية
            شفافية(زخرفة_إسلامية("هندسي")، 0.1)،
            # المحتوى
            حشوة({
                "الكل" = 20،
                "ابن" = الإعدادات["محتوى"]
            })
        ])
    })
