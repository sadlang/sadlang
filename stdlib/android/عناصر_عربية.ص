صنف التاريخ_الهجري
    متغير يوم
    متغير شهر
    متغير سنة
    
    باني(يوم، شهر، سنة)
        هذا.يوم = يوم
        هذا.شهر = شهر
        هذا.سنة = سنة
    نهاية
    
    دالة اسم_الشهر()
        متغير الأشهر = [
            "محرم"، "صفر"، "ربيع الأول"، "ربيع الثاني"،
            "جمادى الأولى"، "جمادى الآخرة"، "رجب"، "شعبان"،
            "رمضان"، "شوال"، "ذو القعدة"، "ذو الحجة"
        ]
        ارجع الأشهر[هذا.شهر - 1]
    نهاية
    
    دالة اسم_اليوم()
        متغير الأيام = ["الأحد"، "الإثنين"، "الثلاثاء"، "الأربعاء"، "الخميس"، "الجمعة"، "السبت"]
        ارجع الأيام[هذا.يوم_الأسبوع()]
    نهاية
    
    دالة يوم_الأسبوع()
        # حساب يوم الأسبوع
        ارجع 0
    نهاية
    
    دالة إلى_ميلادي()
        # تحويل إلى تاريخ ميلادي
        ارجع تاريخ_ميلادي(0، 0، 0)
    نهاية
    
    دالة تنسيق(صيغة)
        # صيغ: "كامل"، "مختصر"، "رقمي"
        إذا (صيغة == "كامل")
            ارجع هذا.اسم_اليوم() + " " + نص(هذا.يوم) + " " + هذا.اسم_الشهر() + " " + نص(هذا.سنة) + " هـ"
        وإلا إذا (صيغة == "مختصر")
            ارجع نص(هذا.يوم) + " " + هذا.اسم_الشهر()
        وإلا
            ارجع نص(هذا.يوم) + "/" + نص(هذا.شهر) + "/" + نص(هذا.سنة)
        نهاية
    نهاية
نهاية

