صنف أوقات_الصلاة
    متغير الفجر
    متغير الشروق
    متغير الظهر
    متغير العصر
    متغير المغرب
    متغير العشاء
    
    باني(البيانات)
        هذا.الفجر = البيانات["الفجر"]
        هذا.الشروق = البيانات["الشروق"]
        هذا.الظهر = البيانات["الظهر"]
        هذا.العصر = البيانات["العصر"]
        هذا.المغرب = البيانات["المغرب"]
        هذا.العشاء = البيانات["العشاء"]
    نهاية
    
    دالة الصلاة_التالية()
        متغير الآن = الوقت_الحالي()
        
        إذا (الآن < هذا.الفجر) ارجع {"الاسم" = "الفجر"، "الوقت" = هذا.الفجر} نهاية
        إذا (الآن < هذا.الظهر) ارجع {"الاسم" = "الظهر"، "الوقت" = هذا.الظهر} نهاية
        إذا (الآن < هذا.العصر) ارجع {"الاسم" = "العصر"، "الوقت" = هذا.العصر} نهاية
        إذا (الآن < هذا.المغرب) ارجع {"الاسم" = "المغرب"، "الوقت" = هذا.المغرب} نهاية
        إذا (الآن < هذا.العشاء) ارجع {"الاسم" = "العشاء"، "الوقت" = هذا.العشاء} نهاية
        
        ارجع {"الاسم" = "الفجر"، "الوقت" = هذا.الفجر، "غداً" = صحيح}
    نهاية
    
    دالة الوقت_المتبقي()
        متغير التالية = هذا.الصلاة_التالية()
        ارجع التالية["الوقت"] - الوقت_الحالي()
    نهاية
نهاية

