# ═══════════════════════════════════════════════════════════════════════════
# المساعدات
# ═══════════════════════════════════════════════════════════════════════════

صنف نقطة_ثلاثية
    متغير س
    متغير ص
    متغير ع
    
    باني(س، ص، ع)
        هذا.س = س
        هذا.ص = ص
        هذا.ع = ع
    نهاية
    
    دالة جمع(أخرى)
        ارجع نقطة_ثلاثية(
            هذا.س + أخرى.س،
            هذا.ص + أخرى.ص،
            هذا.ع + أخرى.ع
        )
    نهاية
    
    دالة طرح(أخرى)
        ارجع نقطة_ثلاثية(
            هذا.س - أخرى.س،
            هذا.ص - أخرى.ص،
            هذا.ع - أخرى.ع
        )
    نهاية
    
    دالة ضرب(مقدار)
        ارجع نقطة_ثلاثية(
            هذا.س * مقدار،
            هذا.ص * مقدار،
            هذا.ع * مقدار
        )
    نهاية
    
    دالة الطول()
        ارجع جذر(هذا.س * هذا.س + هذا.ص * هذا.ص + هذا.ع * هذا.ع)
    نهاية
    
    دالة تطبيع()
        متغير الطول = هذا.الطول()
        ارجع نقطة_ثلاثية(
            هذا.س / الطول،
            هذا.ص / الطول،
            هذا.ع / الطول
        )
    نهاية
نهاية

