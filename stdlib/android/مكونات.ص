دالة شريط_تقدم(القيمة، الإعدادات = خريطة{})
    متغير اللون = الإعدادات["لون"] أو ألوان.أساسي
    متغير الارتفاع = الإعدادات["الارتفاع"] أو 8
    متغير التدوير = الإعدادات["التدوير"] أو الارتفاع / 2
    متغير متحرك = الإعدادات["متحرك"] != خطأ
    متغير أظهر_نسبة = الإعدادات["أظهر_نسبة"] أو خطأ
    
    متغير النسبة = أدنى(أقصى(القيمة، 0)، 1)
    
    ارجع عمود([
        طبقات([
            # الخلفية
            حاوية(
                ارتفاع = الارتفاع،
                عرض_كامل = صحيح،
                تدوير = التدوير،
                لون = اللون.بشفافية(0.2)
            )،
            
            # التقدم
            محاذاة(
                محاذاة = "يسار"،
                ابن = حركة_حجم(
                    مدة = إذا متحرك ثم 300 وإلا 0،
                    ابن = حاوية(
                        ارتفاع = الارتفاع،
                        عرض_نسبي = النسبة،
                        تدوير = التدوير،
                        لون = اللون
                    )
                )
            )
        ])،
        
        إذا (أظهر_نسبة)
            حاشية(
                أعلى = 4،
                ابن = نص(نص(قرّب(النسبة * 100)) + "%")
                    .بنمط(طباعة.تسمية_صغيرة)
                    .بلون(ألوان.على_سطح_متغير)
                    .بمحاذاة("وسط")
            )
        نهاية
    ])
نهاية

دالة تقدم_دائري(القيمة، الإعدادات = خريطة{})
    متغير الحجم = الإعدادات["الحجم"] أو 48
    متغير السماكة = الإعدادات["السماكة"] أو 4
    متغير اللون = الإعدادات["لون"] أو ألوان.أساسي
    متغير أظهر_قيمة = الإعدادات["أظهر_قيمة"] أو خطأ
    
    ارجع طبقات_وسط([
        # الدائرة الخلفية
        رسم_دائرة(
            الحجم،
            السماكة،
            1.0،
            اللون.بشفافية(0.2)
        )،
        
        # دائرة التقدم
        رسم_دائرة(
            الحجم،
            السماكة،
            القيمة،
            اللون
        )،
        
        # القيمة
        إذا (أظهر_قيمة)
            نص(نص(قرّب(القيمة * 100)) + "%")
                .بنمط(طباعة.تسمية_صغيرة)
        نهاية
    ])
نهاية

