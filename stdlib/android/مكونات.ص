                متغير الكود = انتظر حوار_اختيار(خريطة{
                    "العنوان": "اختر البلد"،
                    "الخيارات": ["+966 🇸🇦"، "+971 🇦🇪"، "+20 🇪🇬"، "+962 🇯🇴"، "+965 🇰🇼"]
