دالة تقييم_نجوم(القيمة، الإعدادات = خريطة{})
    متغير الحجم = الإعدادات["حجم"] أو 24
    متغير اللون = الإعدادات["لون"] أو "#FFD700"
    متغير الأقصى = الإعدادات["الأقصى"] أو 5
    متغير قابل_للتعديل = الإعدادات["قابل_للتعديل"] أو خطأ
    متغير عند_التغيير = الإعدادات["عند_التغيير"]
    
    ارجع صف(
        مدى(1، الأقصى + 1).خرّط(دالة(رقم)
            متغير نسبة_امتلاء = أدنى(أقصى(القيمة - رقم + 1، 0)، 1)
            
            ارجع قابل_للضغط(
                عند_الضغط = إذا قابل_للتعديل ثم دالة()
                    عند_التغيير(رقم)
                نهاية وإلا لا_شيء،
                ابن = طبقات([
                    # النجمة الفارغة
                    أيقونة(أيقونات.نجمة_فارغة)
                        .بحجم(الحجم)
                        .بلون(اللون.بشفافية(0.3))،
                    
                    # النجمة الممتلئة (جزئياً أو كلياً)
                    قص(
                        عرض = الحجم * نسبة_امتلاء،
                        ابن = أيقونة(أيقونات.نجمة_ممتلئة)
                            .بحجم(الحجم)
                            .بلون(اللون)
                    )
                ])
            )
        نهاية)
    )
نهاية

