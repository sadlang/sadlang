دالة شارة(النص، الإعدادات = خريطة{})
    متغير اللون = الإعدادات["لون"] أو ألوان.خطأ
    متغير حجم = الإعدادات["حجم"] أو "متوسط"
    
    متغير الحاشية = حالة(حجم)
        عندما "صغير" ثم خريطة{"أفقي": 4، "عمودي": 2}
        عندما "كبير" ثم خريطة{"أفقي": 10، "عمودي": 4}
        افتراضي خريطة{"أفقي": 6، "عمودي": 2}
    نهاية
    
    متغير نمط_خط = حالة(حجم)
        عندما "صغير" ثم طباعة.تسمية_صغيرة
        عندما "كبير" ثم طباعة.تسمية_كبيرة
        افتراضي طباعة.تسمية_متوسطة
    نهاية
    
