# الحوارات
# ═══════════════════════════════════════════════════════════════════════════

# حوار تأكيد
دالة غير_متزامنة حوار_تأكيد(الإعدادات)
    متغير العنوان = الإعدادات["العنوان"] أو "تأكيد"
    متغير الرسالة = الإعدادات["الرسالة"]
    متغير زر_تأكيد = الإعدادات["زر_تأكيد"] أو "تأكيد"
    متغير زر_إلغاء = الإعدادات["زر_إلغاء"] أو "إلغاء"
    متغير خطير = الإعدادات["خطير"] أو خطأ
    
    ارجع انتظر أظهر_حوار(
        حوار(
            عنوان = العنوان،
            محتوى = نص(الرسالة).بنمط(طباعة.جسم_كبير)،
            أزرار = [
                زر_حوار(زر_إلغاء، دالة()
                    أغلق_حوار(خطأ)
                نهاية)،
                
                زر_حوار(
                    زر_تأكيد،
                    دالة()
                        أغلق_حوار(صحيح)
                    نهاية،
                    لون = إذا خطير ثم ألوان.خطأ وإلا ألوان.أساسي
                )
            ]
        )
    )
نهاية

# حوار الإدخال
دالة غير_متزامنة حوار_إدخال(الإعدادات)
    متغير العنوان = الإعدادات["العنوان"] أو "إدخال"
    متغير التسمية = الإعدادات["التسمية"]
    متغير القيمة_الأولية = الإعدادات["القيمة_الأولية"] أو ""
    متغير التلميح = الإعدادات["التلميح"]
    متغير التحقق = الإعدادات["التحقق"]
    
    متغير القيمة = إشارة(القيمة_الأولية)
    متغير الخطأ = إشارة("")
    
    ارجع انتظر أظهر_حوار(
        حوار(
            عنوان = العنوان،
            محتوى = عمود([
                حقل_نص(
                    التسمية = التسمية،
                    القيمة = القيمة.اقرأ()،
                    التلميح = التلميح،
                    الخطأ = الخطأ.اقرأ()،
                    عند_التغيير = دالة(نص)
                        القيمة.عيّن(نص)
                        الخطأ.عيّن("")
                    نهاية
                )
            ])،
            أزرار = [
                زر_حوار("إلغاء"، دالة()
                    أغلق_حوار(لا_شيء)
                نهاية)،
                
                زر_حوار("موافق"، دالة()
                    إذا (التحقق != لا_شيء)
                        متغير نتيجة_تحقق = التحقق(القيمة.اقرأ())
                        إذا (نتيجة_تحقق != صحيح)
                            الخطأ.عيّن(نتيجة_تحقق)
                            ارجع
                        نهاية
                    نهاية
                    أغلق_حوار(القيمة.اقرأ())
                نهاية)
            ]
        )
    )
نهاية

# حوار الاختيار
دالة غير_متزامنة حوار_اختيار(الإعدادات)
    متغير العنوان = الإعدادات["العنوان"]
    متغير الخيارات = الإعدادات["الخيارات"]
    متغير المحدد = الإعدادات["المحدد"]
    
    ارجع انتظر أظهر_حوار(
        حوار(
            عنوان = العنوان،
            محتوى = عمود(
                الخيارات.خرّط(دالة(خيار، فهرس)
                    ارجع قابل_للضغط(
                        عند_الضغط = دالة()
                            أغلق_حوار(خيار)
                        نهاية،
                        ابن = صف([
                            زر_راديو(
                                محدد = خيار == المحدد،
                                عند_التغيير = دالة()
                                    أغلق_حوار(خيار)
                                نهاية
                            )،
                            مسافة_أفقية(16)،
                            نص(خيار).بنمط(طباعة.جسم_كبير)
                        ]).بحاشية_عمودية(12)
                    )
                نهاية)
            )
        )
    )
نهاية

