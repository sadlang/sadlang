# عناصر القوائم
# ═══════════════════════════════════════════════════════════════════════════

# عنصر قائمة مع أيقونة
دالة عنصر_قائمة(الإعدادات)
    متغير الأيقونة = الإعدادات["الأيقونة"]
    متغير العنوان = الإعدادات["العنوان"]
    متغير العنوان_الفرعي = الإعدادات["العنوان_الفرعي"]
    متغير القيمة = الإعدادات["القيمة"]
    متغير عند_الضغط = الإعدادات["عند_الضغط"]
    متغير سهم = الإعدادات["سهم"] != خطأ
    متغير اللون = الإعدادات["اللون"] أو ألوان.على_سطح
    
    ارجع قابل_للضغط(
        عند_الضغط = عند_الضغط،
        ابن = حاشية(
            أفقي = 16،
            عمودي = 12،
            ابن = صف([
                # الأيقونة
                إذا (الأيقونة != لا_شيء)
                    حاوية(
                        عرض = 40،
                        ارتفاع = 40،
                        تدوير = 12،
                        لون = اللون.بشفافية(0.1)،
                        ابن = أيقونة(الأيقونة).بلون(اللون).بحجم(20).وسط()
                    )
                نهاية،
                
                مسافة_أفقية(16)،
                
                # النص
                عمود_توسيع_يسار([
                    نص(العنوان).بنمط(طباعة.جسم_كبير)،
                    
                    إذا (العنوان_الفرعي != لا_شيء)
                        نص(العنوان_الفرعي)
                            .بنمط(طباعة.جسم_صغير)
                            .بلون(ألوان.على_سطح_متغير)
                    نهاية
                ])،
                
                # القيمة أو السهم
                إذا (القيمة != لا_شيء)
                    نص(القيمة)
                        .بنمط(طباعة.جسم_متوسط)
                        .بلون(ألوان.على_سطح_متغير)
                والا_اذا (سهم)
                    أيقونة(أيقونات.سهم_يسار).بلون(ألوان.على_سطح_متغير)
                نهاية
            ])
        )
    )
نهاية

# عنصر قائمة مع مفتاح
دالة عنصر_قائمة_مفتاح(الإعدادات)
    متغير الأيقونة = الإعدادات["الأيقونة"]
    متغير العنوان = الإعدادات["العنوان"]
    متغير العنوان_الفرعي = الإعدادات["العنوان_الفرعي"]
    متغير القيمة = الإعدادات["القيمة"] أو خطأ
    متغير عند_التغيير = الإعدادات["عند_التغيير"]
    
    ارجع حاشية(
        أفقي = 16،
        عمودي = 12،
        ابن = صف([
            # الأيقونة
            إذا (الأيقونة != لا_شيء)
                حاوية(
                    عرض = 40،
                    ارتفاع = 40،
                    تدوير = 12،
                    لون = ألوان.أساسي.بشفافية(0.1)،
                    ابن = أيقونة(الأيقونة).بلون(ألوان.أساسي).بحجم(20).وسط()
                )
            نهاية،
            
            مسافة_أفقية(16)،
            
            # النص
            عمود_توسيع_يسار([
                نص(العنوان).بنمط(طباعة.جسم_كبير)،
                
                إذا (العنوان_الفرعي != لا_شيء)
                    نص(العنوان_الفرعي)
                        .بنمط(طباعة.جسم_صغير)
                        .بلون(ألوان.على_سطح_متغير)
                نهاية
            ])،
            
            # المفتاح
            مفتاح(القيمة، عند_التغيير)
        ])
    )
نهاية

