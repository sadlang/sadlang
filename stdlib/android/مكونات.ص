دالة صورة_رمزية(المصدر، الإعدادات = خريطة{})
    متغير الحجم = الإعدادات["حجم"] أو 40
    متغير التدوير = الإعدادات["تدوير"] أو الحجم / 2
    متغير الحدود = الإعدادات["حدود"]
    
    إذا (المصدر == لا_شيء أو المصدر == "")
        # صورة افتراضية
        ارجع حاوية(
            عرض = الحجم،
            ارتفاع = الحجم،
            تدوير = التدوير،
            لون = ألوان.أساسي.بشفافية(0.2)،
            حدود = الحدود،
            ابن = أيقونة(أيقونات.شخص).بحجم(الحجم * 0.6).بلون(ألوان.أساسي).وسط()
        )
    نهاية
    
    ارجع قص_دائري(
        التدوير،
        ابن = صورة(المصدر)
            .بأبعاد(الحجم، الحجم)
            .بتغطية()
    )
نهاية

دالة مجموعة_صور_رمزية(الصور، الإعدادات = خريطة{})
    متغير الحجم = الإعدادات["حجم"] أو 32
    متغير الأقصى = الإعدادات["الأقصى"] أو 5
    متغير التداخل = الإعدادات["التداخل"] أو الحجم * 0.3
    
    متغير المعروضة = الصور.شريحة(0، الأقصى)
    متغير المتبقية = الصور.طول() - الأقصى
    
    ارجع صف(
        المعروضة.خرّط_مع_فهرس(دالة(صورة، فهرس)
            ارجع حاشية(
                يسار = إذا فهرس > 0 ثم -التداخل وإلا 0،
                ابن = صورة_رمزية(صورة، خريطة{
                    "حجم": الحجم،
                    "حدود": حد(2، ألوان.سطح)
                })
            )
        نهاية).دمج(
            إذا (المتبقية > 0)
                [حاشية(
                    يسار = -التداخل،
                    ابن = حاوية(
                        عرض = الحجم،
                        ارتفاع = الحجم،
                        تدوير = الحجم / 2،
                        لون = ألوان.أساسي،
                        حدود = حد(2، ألوان.سطح)،
                        ابن = نص("+" + نص(المتبقية))
                            .بنمط(طباعة.تسمية_صغيرة)
                            .بلون(ألوان.على_أساسي)
                            .وسط()
                    )
                )]
            وإلا
                []
            نهاية
        )
    )
نهاية

