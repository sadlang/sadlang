دالة احسب_خصم(السعر_الجديد، السعر_القديم)
    ارجع قرّب((السعر_القديم - السعر_الجديد) / السعر_القديم * 100)
نهاية

دالة نسق_سعر(السعر، العملة = "ر.س")
    ارجع نص(السعر) + " " + العملة
نهاية

دالة نسق_تاريخ_نسبي(التاريخ)
    متغير الفرق = الوقت_الحالي() - التاريخ
    متغير الثواني = الفرق / 1000
    متغير الدقائق = الثواني / 60
    متغير الساعات = الدقائق / 60
    متغير الأيام = الساعات / 24
    
    إذا (الثواني < 60)
        ارجع "الآن"
    والا_اذا (الدقائق < 60)
        ارجع "منذ " + نص(قرّب(الدقائق)) + " دقيقة"
    والا_اذا (الساعات < 24)
        ارجع "منذ " + نص(قرّب(الساعات)) + " ساعة"
    والا_اذا (الأيام < 7)
        ارجع "منذ " + نص(قرّب(الأيام)) + " يوم"
    وإلا
        ارجع نسق_تاريخ(التاريخ، "d MMM yyyy")
    نهاية
نهاية
