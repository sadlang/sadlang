# ═══════════════════════════════════════════════════════════════════════════
# بطاقات متقدمة
# ═══════════════════════════════════════════════════════════════════════════

# بطاقة منتج
دالة بطاقة_منتج(الإعدادات)
    متغير الصورة = الإعدادات["الصورة"]
    متغير الاسم = الإعدادات["الاسم"]
    متغير السعر = الإعدادات["السعر"]
    متغير السعر_القديم = الإعدادات["السعر_القديم"]
    متغير التقييم = الإعدادات["التقييم"] أو 0
    متغير عدد_التقييمات = الإعدادات["عدد_التقييمات"] أو 0
    متغير عند_الضغط = الإعدادات["عند_الضغط"]
    متغير عند_إضافة_سلة = الإعدادات["عند_إضافة_سلة"]
    متغير مفضل = الإعدادات["مفضل"] أو خطأ
    متغير عند_تبديل_مفضل = الإعدادات["عند_تبديل_مفضل"]
    
    ارجع بطاقة(
        عند_الضغط = عند_الضغط،
        محتوى = عمود([
            # الصورة مع زر المفضلة
            طبقات([
                صورة(الصورة)
                    .بارتفاع(180)
                    .بعرض_كامل()
                    .بتغطية()،
                
                # خصم
                إذا (السعر_القديم != لا_شيء)
                    موضع_مطلق(
                        شارة(
                            نص("-" + نص(احسب_خصم(السعر، السعر_القديم)) + "%")،
                            لون = ألوان.خطأ
                        )،
                        أعلى = 8،
                        يسار = 8
                    )
                نهاية،
                
                # زر المفضلة
                موضع_مطلق(
                    زر_أيقونة(
                        أيقونة = إذا مفضل ثم أيقونات.قلب_ممتلئ وإلا أيقونات.قلب،
                        لون = إذا مفضل ثم ألوان.خطأ وإلا ألوان.على_سطح،
                        عند_الضغط = عند_تبديل_مفضل
                    )،
                    أعلى = 8،
                    يمين = 8
                )
            ])،
            
            # المحتوى
            حاشية(
                مقدار = 12،
                ابن = عمود([
                    # الاسم
                    نص(الاسم)
                        .بنمط(طباعة.عنوان_صغير)
                        .بحد_أقصى_أسطر(2)،
                    
                    مسافة(4)،
                    
                    # التقييم
                    إذا (التقييم > 0)
                        صف([
                            تقييم_نجوم(التقييم، حجم = 14)،
                            مسافة_أفقية(4)،
                            نص("(" + نص(عدد_التقييمات) + ")")
                                .بنمط(طباقة.تسمية_صغيرة)
                                .بلون(ألوان.على_سطح_متغير)
                        ])
                    نهاية،
                    
                    مسافة(8)،
                    
                    # السعر
                    صف_بين([
                        صف([
                            نص(نسق_سعر(السعر))
                                .بنمط(طباعة.عنوان_متوسط)
                                .بلون(ألوان.أساسي)،
                            
                            إذا (السعر_القديم != لا_شيء)
                                حاشية(
                                    يسار = 8،
                                    ابن = نص(نسق_سعر(السعر_القديم))
                                        .بنمط(طباعة.جسم_صغير)
                                        .بلون(ألوان.على_سطح_متغير)
                                        .بخط_وسط()
                                )
                            نهاية
                        ])،
                        
                        # زر الإضافة للسلة
                        زر_أيقونة(
                            أيقونة = أيقونات.سلة_إضافة،
                            عند_الضغط = عند_إضافة_سلة
                        )
                    ])
                ])
            )
        ])
    )
نهاية

# بطاقة مستخدم
دالة بطاقة_مستخدم(الإعدادات)
    متغير الصورة = الإعدادات["الصورة"]
    متغير الاسم = الإعدادات["الاسم"]
    متغير الوصف = الإعدادات["الوصف"]
    متغير متصل = الإعدادات["متصل"] أو خطأ
    متغير الإجراءات = الإعدادات["الإجراءات"] أو []
    متغير عند_الضغط = الإعدادات["عند_الضغط"]
    
    ارجع بطاقة(
        عند_الضغط = عند_الضغط،
        محتوى = حاشية(
            مقدار = 16،
            ابن = صف([
                # الصورة الرمزية
                طبقات([
                    صورة_رمزية(الصورة، حجم = 56)،
                    
                    إذا (متصل)
                        موضع_مطلق(
                            حاوية(
                                عرض = 14،
                                ارتفاع = 14،
                                تدوير = 7،
                                لون = ألوان.نجاح،
                                حدود = حد(2، ألوان.سطح)
                            )،
                            أسفل = 0،
                            يمين = 0
                        )
                    نهاية
                ])،
                
                مسافة_أفقية(16)،
                
                # المعلومات
                عمود_توسيع([
                    نص(الاسم).بنمط(طباعة.عنوان_صغير)،
                    
                    إذا (الوصف != لا_شيء)
                        نص(الوصف)
                            .بنمط(طباعة.جسم_صغير)
                            .بلون(ألوان.على_سطح_متغير)
                    نهاية
                ])،
                
                # الإجراءات
                لكل إجراء في الإجراءات
                    زر_أيقونة(
                        أيقونة = إجراء["أيقونة"]،
                        عند_الضغط = إجراء["عند_الضغط"]
                    )
                نهاية
            ])
        )
    )
نهاية

# بطاقة إحصائية
دالة بطاقة_إحصائية(الإعدادات)
    متغير العنوان = الإعدادات["العنوان"]
    متغير القيمة = الإعدادات["القيمة"]
    متغير الأيقونة = الإعدادات["الأيقونة"]
    متغير اللون = الإعدادات["اللون"] أو ألوان.أساسي
    متغير التغيير = الإعدادات["التغيير"]
    متغير إيجابي = الإعدادات["إيجابي"]
    
    ارجع بطاقة(
        محتوى = حاشية(
            مقدار = 16،
            ابن = عمود_يسار([
                # العنوان والأيقونة
                صف_بين([
                    نص(العنوان)
                        .بنمط(طباعة.تسمية_كبيرة)
                        .بلون(ألوان.على_سطح_متغير)،
                    
                    حاوية(
                        حاشية = 8،
                        تدوير = 8،
                        لون = اللون.بشفافية(0.1)،
                        ابن = أيقونة(الأيقونة).بلون(اللون)
                    )
                ])،
                
                مسافة(12)،
                
                # القيمة
                نص(نص(القيمة)).بنمط(طباعة.عنوان_كبير)،
                
                # التغيير
                إذا (التغيير != لا_شيء)
                    صف([
                        أيقونة(
                            إذا إيجابي ثم أيقونات.سهم_أعلى وإلا أيقونات.سهم_أسفل
                        ).بحجم(16).بلون(إذا إيجابي ثم ألوان.نجاح وإلا ألوان.خطأ)،
                        
                        مسافة_أفقية(4)،
                        
                        نص(نص(التغيير) + "%")
                            .بنمط(طباعة.جسم_صغير)
                            .بلون(إذا إيجابي ثم ألوان.نجاح وإلا ألوان.خطأ)
                    ])
                نهاية
            ])
        )
    )
نهاية

# بطاقة مقال/خبر
دالة بطاقة_مقال(الإعدادات)
    متغير الصورة = الإعدادات["الصورة"]
    متغير العنوان = الإعدادات["العنوان"]
    متغير الملخص = الإعدادات["الملخص"]
    متغير المصدر = الإعدادات["المصدر"]
    متغير التاريخ = الإعدادات["التاريخ"]
    متغير الفئة = الإعدادات["الفئة"]
    متغير عند_الضغط = الإعدادات["عند_الضغط"]
    
    ارجع بطاقة(
        عند_الضغط = عند_الضغط،
        محتوى = عمود([
            # الصورة
            طبقات([
                صورة(الصورة)
                    .بارتفاع(200)
                    .بعرض_كامل()
                    .بتغطية()،
                
                # الفئة
                إذا (الفئة != لا_شيء)
                    موضع_مطلق(
                        شريحة(الفئة، لون = ألوان.أساسي)،
                        أسفل = 12،
                        يسار = 12
                    )
                نهاية
            ])،
            
            # المحتوى
            حاشية(
                مقدار = 16،
                ابن = عمود_يسار([
                    # العنوان
                    نص(العنوان)
                        .بنمط(طباعة.عنوان_متوسط)
                        .بحد_أقصى_أسطر(2)،
                    
                    مسافة(8)،
                    
                    # الملخص
                    إذا (الملخص != لا_شيء)
                        نص(الملخص)
                            .بنمط(طباعة.جسم_متوسط)
                            .بلون(ألوان.على_سطح_متغير)
                            .بحد_أقصى_أسطر(3)
                    نهاية،
                    
                    مسافة(12)،
                    
                    # المصدر والتاريخ
                    صف_بين([
                        نص(المصدر)
                            .بنمط(طباقة.تسمية_متوسطة)
                            .بلون(ألوان.أساسي)،
                        
                        نص(نسق_تاريخ_نسبي(التاريخ))
                            .بنمط(طباعة.تسمية_صغيرة)
                            .بلون(ألوان.على_سطح_متغير)
                    ])
                ])
            )
        ])
    )
نهاية

