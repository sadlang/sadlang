# الشرائح والشارات
# ═══════════════════════════════════════════════════════════════════════════

دالة شريحة(النص، الإعدادات = خريطة{})
    متغير اللون = الإعدادات["لون"] أو ألوان.أساسي
    متغير محدد = الإعدادات["محدد"] أو خطأ
    متغير أيقونة_يسار = الإعدادات["أيقونة"]
    متغير قابل_للحذف = الإعدادات["قابل_للحذف"] أو خطأ
    متغير عند_الضغط = الإعدادات["عند_الضغط"]
    متغير عند_الحذف = الإعدادات["عند_الحذف"]
    
    ارجع قابل_للضغط(
        عند_الضغط = عند_الضغط،
        ابن = حاوية(
            حاشية_أفقية = 12،
            حاشية_عمودية = 6،
            تدوير = 16،
            لون = إذا محدد ثم اللون وإلا اللون.بشفافية(0.1)،
            حدود = إذا محدد ثم لا_شيء وإلا حد(1، اللون)،
            ابن = صف([
                # الأيقونة
                إذا (أيقونة_يسار != لا_شيء)
                    أيقونة(أيقونة_يسار)
                        .بحجم(18)
                        .بلون(إذا محدد ثم ألوان.على_أساسي وإلا اللون)
                نهاية،
                
                إذا (أيقونة_يسار != لا_شيء)
                    مسافة_أفقية(6)
                نهاية،
                
                # النص
                نص(النص)
                    .بنمط(طباعة.تسمية_كبيرة)
                    .بلون(إذا محدد ثم ألوان.على_أساسي وإلا اللون)،
                
                # زر الحذف
                إذا (قابل_للحذف)
                    مسافة_أفقية(6)
