                إذا (قابل_للحذف)
                    قابل_للضغط(
                        عند_الضغط = عند_الحذف،
                        ابن = أيقونة(أيقونات.إغلاق)
                            .بحجم(18)
                            .بلون(إذا محدد ثم ألوان.على_أساسي وإلا اللون)
                    )
                نهاية
            ])
        )
    )
