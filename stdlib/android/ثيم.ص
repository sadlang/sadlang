# محول الثيمات (Theme Provider)
# ═══════════════════════════════════════════════════════════════════════════

#** محول الثيمات **#
صنف _محول_ثيم
    متغير الثيم_الفاتح = لا_شيء
    متغير الثيم_الداكن = لا_شيء
    متغير الثيم_الحالي = لا_شيء
    متغير استخدام_ثيم_النظام = صحيح
    متغير _المراقبون = []
    
    باني()
        هذا.الثيم_الفاتح = جديد ثيم("فاتح")
        هذا.الثيم_الداكن = جديد ثيم("داكن")
        هذا.الثيم_الحالي = هذا.الثيم_الفاتح
    نهاية
    
    #** تعيين الثيم الفاتح **#
    دالة عيّن_ثيم_فاتح(الثيم)
        هذا.الثيم_الفاتح = الثيم
        إذا (هذا.الثيم_الحالي.الوضع == "فاتح")
            هذا.الثيم_الحالي = الثيم
            هذا._أشعر()
        نهاية
    نهاية
    
    #** تعيين الثيم الداكن **#
    دالة عيّن_ثيم_داكن(الثيم)
        هذا.الثيم_الداكن = الثيم
        إذا (هذا.الثيم_الحالي.الوضع == "داكن")
            هذا.الثيم_الحالي = الثيم
            هذا._أشعر()
        نهاية
    نهاية
    
    #** التبديل للوضع الفاتح **#
    دالة وضع_فاتح()
        هذا.استخدام_ثيم_النظام = خطأ
        هذا.الثيم_الحالي = هذا.الثيم_الفاتح
        هذا._أشعر()
    نهاية
    
    #** التبديل للوضع الداكن **#
    دالة وضع_داكن()
        هذا.استخدام_ثيم_النظام = خطأ
        هذا.الثيم_الحالي = هذا.الثيم_الداكن
        هذا._أشعر()
    نهاية
    
    #** التبديل التلقائي (حسب النظام) **#
    دالة وضع_تلقائي()
        هذا.استخدام_ثيم_النظام = صحيح
        # الحصول على وضع النظام
        متغير وضع_النظام = __وضع_ثيم_النظام()
        إذا (وضع_النظام == "داكن")
            هذا.الثيم_الحالي = هذا.الثيم_الداكن
        وإلا
            هذا.الثيم_الحالي = هذا.الثيم_الفاتح
        نهاية
        هذا._أشعر()
    نهاية
    
    #** تبديل الوضع **#
    دالة بدّل()
        إذا (هذا.الثيم_الحالي.الوضع == "فاتح")
            هذا.وضع_داكن()
        وإلا
            هذا.وضع_فاتح()
        نهاية
    نهاية
    
    #** هل الوضع داكن **#
    دالة داكن()
        ارجع هذا.الثيم_الحالي.الوضع == "داكن"
    نهاية
    
    #** الحصول على الثيم الحالي **#
    دالة الحالي()
        ارجع هذا.الثيم_الحالي
    نهاية
    
    #** الحصول على الألوان الحالية **#
    دالة الألوان()
        ارجع هذا.الثيم_الحالي.الألوان
    نهاية
    
    #** مراقبة تغيير الثيم **#
    دالة راقب(الدالة)
        هذا._المراقبون.أضف(الدالة)
        ارجع دالة()
            هذا._المراقبون.احذف(الدالة)
        نهاية
    نهاية
    
    دالة _أشعر()
        لكل مراقب في هذا._المراقبون
            مراقب(هذا.الثيم_الحالي)
        نهاية
        
        # تحديث واجهة المستخدم
        __حدّث_ثيم(هذا.الثيم_الحالي.إلى_json())
    نهاية

نهاية

