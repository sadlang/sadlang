        هذا.الألوان.أساسي = اللون
        ارجع هذا
    نهاية
    
    دالة بلون_ثانوي(اللون)
        هذا.الألوان.ثانوي = اللون
        ارجع هذا
    نهاية
    
    دالة بلون_ثالثي(اللون)
        هذا.الألوان.ثالثي = اللون
