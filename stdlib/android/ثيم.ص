#** لون مع درجات **#
صنف لون
    متغير القيمة = "#000000"
    متغير _درجات = خريطة()
    
    باني(القيمة)
        هذا.القيمة = القيمة
    نهاية
    
    #** إنشاء لون من RGB **#
    دالة ثابتة من_rgb(أحمر، أخضر، أزرق)
        متغير hex = "#" + __إلى_hex(أحمر) + __إلى_hex(أخضر) + __إلى_hex(أزرق)
        ارجع جديد لون(hex)
    نهاية
    
    #** إنشاء لون من ARGB **#
    دالة ثابتة من_argb(شفافية، أحمر، أخضر، أزرق)
        متغير hex = "#" + __إلى_hex(شفافية) + __إلى_hex(أحمر) + __إلى_hex(أخضر) + __إلى_hex(أزرق)
        ارجع جديد لون(hex)
    نهاية
    
    #** تفتيح اللون **#
    دالة فاتح(النسبة = 0.1)
        # TODO: تنفيذ تفتيح اللون
        ارجع هذا
    نهاية
    
    #** تغميق اللون **#
    دالة داكن(النسبة = 0.1)
        # TODO: تنفيذ تغميق اللون  
        ارجع هذا
    نهاية
    
    #** تعيين الشفافية **#
    دالة بشفافية(الشفافية)
        # الشفافية من 0 إلى 1
        متغير hex_شفافية = __إلى_hex(__تقريب(الشفافية * 255))
        ارجع جديد لون(hex_شفافية + هذا.القيمة.قص(1))
    نهاية
    
    #** تحويل لنص **#
    دالة إلى_نص()
        ارجع هذا.القيمة
    نهاية

نهاية

