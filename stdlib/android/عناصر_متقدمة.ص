# القوائم الكسولة (Lazy Lists)
# ═══════════════════════════════════════════════════════════════════════════

#** قائمة كسولة - تحمّل العناصر حسب الحاجة فقط **#
صنف قائمة_كسولة
    متغير _العناصر = []
    متغير _دالة_البناء = لا_شيء
    متغير _ارتفاع_العنصر = 0  # 0 = تلقائي
    متغير _العناصر_المرئية = []
    متغير _موضع_التمرير = 0
    متغير _الفهرس_الأول = 0
    متغير _عدد_المرئي = 10
    متغير _تحديث_أثناء_السحب = صحيح
    متغير _دالة_نهاية_القائمة = لا_شيء
    متغير _عتبة_نهاية_القائمة = 5
    متغير _جاري_التحميل = خطأ
    
    باني(العناصر، دالة_البناء)
        هذا._العناصر = العناصر
        هذا._دالة_البناء = دالة_البناء
    نهاية
    
    #** تعيين ارتفاع ثابت للعناصر (أفضل للأداء) **#
    دالة بارتفاع_ثابت(الارتفاع)
        هذا._ارتفاع_العنصر = الارتفاع
        ارجع هذا
    نهاية
    
    #** تفعيل التحميل اللانهائي **#
    دالة عند_نهاية_القائمة(الدالة، العتبة = 5)
        هذا._دالة_نهاية_القائمة = الدالة
        هذا._عتبة_نهاية_القائمة = العتبة
        ارجع هذا
    نهاية
    
    #** تحديث العناصر **#
    دالة حدّث_العناصر(عناصر_جديدة)
        هذا._العناصر = عناصر_جديدة
        هذا._جاري_التحميل = خطأ
    نهاية
    
    #** إضافة عناصر **#
    دالة أضف_عناصر(عناصر_جديدة)
        لكل عنصر في عناصر_جديدة
            هذا._العناصر.أضف(عنصر)
        نهاية
        هذا._جاري_التحميل = خطأ
    نهاية
    
    #** التمرير لعنصر **#
    دالة اذهب_إلى(الفهرس، متحرك = صحيح)
        __تمرير_قائمة(هذا، الفهرس، متحرك)
    نهاية
    
    #** بناء JSON **#
    دالة إلى_json()
        ارجع خريطة{
            "النوع": "قائمة_كسولة"،
            "عدد_العناصر": هذا._العناصر.طول()،
            "ارتفاع_العنصر": هذا._ارتفاع_العنصر،
            "تحميل_لانهائي": هذا._دالة_نهاية_القائمة != لا_شيء،
            "العتبة": هذا._عتبة_نهاية_القائمة
        }
    نهاية

نهاية

#** شبكة كسولة **#
صنف شبكة_كسولة
    متغير _العناصر = []
    متغير _دالة_البناء = لا_شيء
    متغير _الأعمدة = 2
    متغير _التباعد = 8
    متغير _التباعد_العمودي = 8
    متغير _نسبة_العرض_للارتفاع = 1.0
    
    باني(العناصر، دالة_البناء، الأعمدة = 2)
        هذا._العناصر = العناصر
        هذا._دالة_البناء = دالة_البناء
        هذا._الأعمدة = الأعمدة
    نهاية
    
    #** تعيين التباعد **#
    دالة بتباعد(التباعد، عمودي = -1)
        هذا._التباعد = التباعد
        إذا (عمودي >= 0)
            هذا._التباعد_العمودي = عمودي
        وإلا
            هذا._التباعد_العمودي = التباعد
        نهاية
        ارجع هذا
    نهاية
    
    #** تعيين نسبة العرض للارتفاع **#
    دالة بنسبة(النسبة)
        هذا._نسبة_العرض_للارتفاع = النسبة
        ارجع هذا
    نهاية
    
    دالة إلى_json()
        ارجع خريطة{
            "النوع": "شبكة_كسولة"،
            "الأعمدة": هذا._الأعمدة،
            "عدد_العناصر": هذا._العناصر.طول()،
            "التباعد": هذا._التباعد،
            "التباعد_العمودي": هذا._التباعد_العمودي،
            "نسبة_العرض_للارتفاع": هذا._نسبة_العرض_للارتفاع
        }
    نهاية

نهاية

