    متغير _إجراءات_يمين = []
    متغير _إجراءات_يسار = []
    متغير _حذف_تلقائي = خطأ
    
    باني(المحتوى)
        هذا._المحتوى = المحتوى
    نهاية
    
    #** إضافة إجراء للسحب يميناً **#
    دالة إجراء_يمين(الأيقونة، النص، اللون، الدالة)
        هذا._إجراءات_يمين.أضف(جديد إجراء_سحب(الأيقونة، النص، اللون، الدالة))
        ارجع هذا
    نهاية
    
    #** إضافة إجراء للسحب يساراً **#
