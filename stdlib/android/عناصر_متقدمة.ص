    متغير _لون_الخلفية = "#FFFFFF"
    متغير _المسافة = 80
    متغير _جاري_التحديث = خطأ
    
    باني(المحتوى، دالة_التحديث)
        هذا._المحتوى = المحتوى
        هذا._دالة_التحديث = دالة_التحديث
    نهاية
    
    #** تعيين الألوان **#
    دالة بألوان(اللون، الخلفية = "#FFFFFF")
        هذا._لون_المؤشر = اللون
        هذا._لون_الخلفية = الخلفية
        ارجع هذا
    نهاية
    
    #** إنهاء التحديث **#
    دالة أنهِ_التحديث()
        هذا._جاري_التحديث = خطأ
        __أنهِ_سحب_للتحديث()
    نهاية
    
    دالة إلى_json()
        ارجع خريطة{
            "النوع": "سحب_للتحديث"،
            "المحتوى": هذا._المحتوى.إلى_json()،
            "لون_المؤشر": هذا._لون_المؤشر،
            "لون_الخلفية": هذا._لون_الخلفية
