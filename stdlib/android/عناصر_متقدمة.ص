        هذا._إجراءات_يسار.أضف(جديد إجراء_سحب(الأيقونة، النص، اللون، الدالة))
        ارجع هذا
    نهاية
    
    #** حذف تلقائي عند السحب الكامل **#
    دالة مع_حذف_تلقائي()
        هذا._حذف_تلقائي = صحيح
        ارجع هذا
    نهاية
    
    دالة إلى_json()
        متغير إجراءات_يمين_json = []
        لكل إجراء في هذا._إجراءات_يمين
            إجراءات_يمين_json.أضف(خريطة{
                "الأيقونة": إجراء.الأيقونة،
                "النص": إجراء.النص،
                "اللون": إجراء.اللون
