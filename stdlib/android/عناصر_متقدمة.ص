        نهاية
        
        ارجع خريطة{
            "النوع": "عنصر_قابل_للسحب"،
            "المحتوى": هذا._المحتوى.إلى_json()،
            "إجراءات_يمين": إجراءات_يمين_json،
            "حذف_تلقائي": هذا._حذف_تلقائي
        }
    نهاية

