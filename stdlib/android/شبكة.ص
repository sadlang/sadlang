# إنشاء نسخة افتراضية
# ═══════════════════════════════════════════════════════════════════════════

متغير طلبات = جديد http()

#**
# دوال مختصرة للطلبات السريعة
**#
دالة احصل(الرابط)
    ارجع طلبات.احصل(الرابط)
نهاية

دالة أرسل(الرابط، البيانات)
    ارجع طلبات.أرسل(الرابط، البيانات)
نهاية

دالة احصل_json(الرابط)
    ارجع طلبات.احصل_json(الرابط)
نهاية

دالة أرسل_json(الرابط، البيانات)
    ارجع طلبات.أرسل_json(الرابط، البيانات)
نهاية
