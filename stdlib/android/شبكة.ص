#**
# نتيجة طلب HTTP
**#
صنف نتيجة_طلب
    متغير نجح = خطأ
    متغير حالة = 0
    متغير محتوى = ""
    متغير خطأ = ""
    متغير رؤوس = خريطة()
    
    باني(نجح، حالة، محتوى، خطأ = "")
        هذا.نجح = نجح
        هذا.حالة = حالة
        هذا.محتوى = محتوى
        هذا.خطأ = خطأ
    نهاية
    
    #** تحويل المحتوى إلى JSON **#
    دالة إلى_json()
        ارجع __تحليل_json(هذا.محتوى)
    نهاية
نهاية

#**
# صنف HTTP الأساسي
**#
صنف http
    
    # الرؤوس الافتراضية
    متغير _رؤوس_افتراضية = خريطة()
    
    # مهلة الاتصال (ملي ثانية)
    متغير _مهلة = 30000
    
    #** تعيين رأس افتراضي **#
    دالة رأس_افتراضي(الاسم، القيمة)
        هذا._رؤوس_افتراضية[الاسم] = القيمة
    نهاية
    
    #** تعيين المهلة **#
    دالة مهلة(المدة)
        هذا._مهلة = المدة
    نهاية
    
    #** دمج الرؤوس الافتراضية مع الرؤوس المحددة **#
    دالة _دمج_رؤوس(رؤوس)
        متغير نتيجة = خريطة()
        
        لكل مفتاح في هذا._رؤوس_افتراضية
            نتيجة[مفتاح] = هذا._رؤوس_افتراضية[مفتاح]
        نهاية
        
        لكل مفتاح في رؤوس
            نتيجة[مفتاح] = رؤوس[مفتاح]
        نهاية
        
        ارجع نتيجة
    نهاية
    
    # ═══════════════════════════════════════════════════════════════════
    # طلبات HTTP
    # ═══════════════════════════════════════════════════════════════════
    
    #** طلب GET **#
    دالة احصل(الرابط، رؤوس = خريطة())
        متغير رؤوس_كاملة = هذا._دمج_رؤوس(رؤوس)
        متغير استجابة = __اندرويد_http_get(الرابط، رؤوس_كاملة، هذا._مهلة)
        ارجع هذا._حلل_استجابة(استجابة)
    نهاية
    
    #** طلب POST **#
    دالة أرسل(الرابط، البيانات، رؤوس = خريطة())
        متغير رؤوس_كاملة = هذا._دمج_رؤوس(رؤوس)
        متغير جسم = هذا._جهز_الجسم(البيانات)
        متغير استجابة = __اندرويد_http_post(الرابط، جسم، رؤوس_كاملة، هذا._مهلة)
        ارجع هذا._حلل_استجابة(استجابة)
    نهاية
    
    #** طلب PUT **#
    دالة حدث(الرابط، البيانات، رؤوس = خريطة())
        متغير رؤوس_كاملة = هذا._دمج_رؤوس(رؤوس)
        متغير جسم = هذا._جهز_الجسم(البيانات)
        متغير استجابة = __اندرويد_http_put(الرابط، جسم، رؤوس_كاملة، هذا._مهلة)
        ارجع هذا._حلل_استجابة(استجابة)
    نهاية
    
    #** طلب DELETE **#
    دالة احذف(الرابط، رؤوس = خريطة())
        متغير رؤوس_كاملة = هذا._دمج_رؤوس(رؤوس)
        متغير استجابة = __اندرويد_http_delete(الرابط، رؤوس_كاملة، هذا._مهلة)
        ارجع هذا._حلل_استجابة(استجابة)
    نهاية
    
    #** طلب PATCH **#
    دالة رقع(الرابط، البيانات، رؤوس = خريطة())
        متغير رؤوس_كاملة = هذا._دمج_رؤوس(رؤوس)
        متغير جسم = هذا._جهز_الجسم(البيانات)
        متغير استجابة = __اندرويد_http_patch(الرابط، جسم، رؤوس_كاملة، هذا._مهلة)
        ارجع هذا._حلل_استجابة(استجابة)
    نهاية
    
    # ═══════════════════════════════════════════════════════════════════
    # طلبات JSON
    # ═══════════════════════════════════════════════════════════════════
    
    #** GET مع JSON **#
    دالة احصل_json(الرابط، رؤوس = خريطة())
        رؤوس["Accept"] = "application/json"
        متغير نتيجة = هذا.احصل(الرابط، رؤوس)
        إذا (نتيجة.نجح)
            نتيجة.محتوى = نتيجة.إلى_json()
        نهاية
        ارجع نتيجة
    نهاية
    
    #** POST مع JSON **#
    دالة أرسل_json(الرابط، البيانات، رؤوس = خريطة())
        رؤوس["Content-Type"] = "application/json"
        رؤوس["Accept"] = "application/json"
        متغير نتيجة = هذا.أرسل(الرابط، البيانات، رؤوس)
        إذا (نتيجة.نجح)
            نتيجة.محتوى = نتيجة.إلى_json()
        نهاية
        ارجع نتيجة
    نهاية
    
    # ═══════════════════════════════════════════════════════════════════
    # مساعدات داخلية
    # ═══════════════════════════════════════════════════════════════════
    
    #** تحليل الاستجابة **#
    دالة _حلل_استجابة(استجابة)
        إذا (استجابة["خطأ"] != "")
            ارجع جديد نتيجة_طلب(خطأ، 0، ""، استجابة["خطأ"])
        نهاية
        
        متغير نجح = استجابة["حالة"] >= 200 و استجابة["حالة"] < 300
        ارجع جديد نتيجة_طلب(
            نجح،
            استجابة["حالة"]،
            استجابة["محتوى"]
        )
    نهاية
    
    #** تجهيز جسم الطلب **#
    دالة _جهز_الجسم(البيانات)
        إذا (نوع(البيانات) == "نص")
            ارجع البيانات
        وإلا
            ارجع __إلى_json(البيانات)
        نهاية
    نهاية

نهاية

#**
# عميل REST API
**#
صنف عميل_api
    متغير _رابط_أساسي = ""
    متغير _http = جديد http()
    
    باني(الرابط_الأساسي)
        هذا._رابط_أساسي = الرابط_الأساسي
    نهاية
    
    #** تعيين رمز التوثيق Bearer **#
    دالة رمز_التوثيق(الرمز)
        هذا._http.رأس_افتراضي("Authorization"، "Bearer " + الرمز)
    نهاية
    
    #** تعيين مفتاح API **#
    دالة مفتاح_api(اسم_الرأس، المفتاح)
        هذا._http.رأس_افتراضي(اسم_الرأس، المفتاح)
    نهاية
    
    #** بناء الرابط الكامل **#
    دالة _رابط_كامل(المسار)
        إذا (هذا._رابط_أساسي.ينتهي_بـ("/"))
            ارجع هذا._رابط_أساسي + المسار
        وإلا
            ارجع هذا._رابط_أساسي + "/" + المسار
        نهاية
    نهاية
    
    #** GET **#
    دالة احصل(المسار)
        ارجع هذا._http.احصل_json(هذا._رابط_كامل(المسار))
    نهاية
    
    #** POST **#
    دالة أنشئ(المسار، البيانات)
        ارجع هذا._http.أرسل_json(هذا._رابط_كامل(المسار)، البيانات)
    نهاية
    
    #** PUT **#
    دالة حدث(المسار، البيانات)
        متغير رؤوس = خريطة()
        رؤوس["Content-Type"] = "application/json"
        ارجع هذا._http.حدث(هذا._رابط_كامل(المسار)، البيانات، رؤوس)
    نهاية
    
    #** DELETE **#
    دالة احذف(المسار)
        ارجع هذا._http.احذف(هذا._رابط_كامل(المسار))
    نهاية

نهاية

