# دالة مساعدة لاكتشاف الزوايا
دالة اكتشف_زوايا(مسار، العدد_المطلوب)
    متغير الزوايا = []
    متغير النقاط = مسار.النقاط
    
    إذا (النقاط.طول() < 3)
        ارجع الزوايا
    نهاية
    
    متغير حد_الزاوية = 30  # درجة
    
    لكل ن في مدى(1، النقاط.طول() - 1)
        متغير السابقة = النقاط[ن - 1]
        متغير الحالية = النقاط[ن]
        متغير التالية = النقاط[ن + 1]
        
        متغير زاوية1 = السابقة.الزاوية_إلى(الحالية)
        متغير زاوية2 = الحالية.الزاوية_إلى(التالية)
        متغير الفرق = قيمة_مطلقة(زاوية2 - زاوية1)
        
        إذا (الفرق > حد_الزاوية)
            الزوايا.أضف(الحالية)
        نهاية
    نهاية
    
    ارجع الزوايا
نهاية

