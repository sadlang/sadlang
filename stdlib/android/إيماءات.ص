# ═══════════════════════════════════════════════════════════════════════════
# نقطة اللمس
# ═══════════════════════════════════════════════════════════════════════════

صنف نقطة_لمس
    متغير س = 0
    متغير ص = 0
    متغير الوقت = 0
    متغير الضغط = 1.0        # قوة الضغط (للشاشات الداعمة)
    متغير الحجم = 1.0        # حجم نقطة اللمس
    متغير المعرف = 0         # معرف الإصبع (للمس متعدد)
    
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
        هذا.الوقت = الوقت_الحالي()
    نهاية
    
    دالة المسافة_إلى(نقطة)
        متغير فرق_س = هذا.س - نقطة.س
        متغير فرق_ص = هذا.ص - نقطة.ص
        ارجع جذر((فرق_س * فرق_س) + (فرق_ص * فرق_ص))
    نهاية
    
    دالة الزاوية_إلى(نقطة)
        ارجع زاوية_قطبية(نقطة.ص - هذا.ص، نقطة.س - هذا.س)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# مسار اللمس (تتبع حركة الإصبع)
# ═══════════════════════════════════════════════════════════════════════════

صنف مسار_لمس
    متغير النقاط = []
    متغير المعرف = 0
    متغير نشط = صحيح
    
    باني(معرف = 0)
        هذا.المعرف = معرف
    نهاية
    
    دالة أضف(نقطة)
        هذا.النقاط.أضف(نقطة)
        ارجع هذا
    نهاية
    
    دالة البداية()
        إذا (هذا.النقاط.طول() == 0)
            ارجع لا_شيء
        نهاية
        ارجع هذا.النقاط[0]
    نهاية
    
    دالة النهاية()
        إذا (هذا.النقاط.طول() == 0)
            ارجع لا_شيء
        نهاية
        ارجع هذا.النقاط[هذا.النقاط.طول() - 1]
    نهاية
    
    دالة المسافة_الكلية()
        متغير المسافة = 0
        لكل ن في مدى(1، هذا.النقاط.طول())
            المسافة = المسافة + هذا.النقاط[ن].المسافة_إلى(هذا.النقاط[ن - 1])
        نهاية
        ارجع المسافة
    نهاية
    
    دالة السرعة()
        إذا (هذا.النقاط.طول() < 2)
            ارجع 0
        نهاية
        
        متغير المسافة = هذا.البداية().المسافة_إلى(هذا.النهاية())
        متغير الوقت = هذا.النهاية().الوقت - هذا.البداية().الوقت
        
        إذا (الوقت == 0)
            ارجع 0
        نهاية
        
        ارجع المسافة / الوقت
    نهاية
    
    دالة الاتجاه()
        إذا (هذا.النقاط.طول() < 2)
            ارجع "غير محدد"
        نهاية
        
        متغير فرق_س = هذا.النهاية().س - هذا.البداية().س
        متغير فرق_ص = هذا.النهاية().ص - هذا.البداية().ص
        
        إذا (قيمة_مطلقة(فرق_س) > قيمة_مطلقة(فرق_ص))
            ارجع إذا (فرق_س > 0) "يمين" وإلا "يسار"
        وإلا
            ارجع إذا (فرق_ص > 0) "أسفل" وإلا "أعلى"
        نهاية
    نهاية
    
    دالة هو_خط_مستقيم(تسامح = 20)
        إذا (هذا.النقاط.طول() < 3)
            ارجع صحيح
        نهاية
        
        # حساب الانحراف عن الخط المستقيم
        متغير البداية = هذا.البداية()
        متغير النهاية = هذا.النهاية()
        
        لكل نقطة في هذا.النقاط
            متغير المسافة = مسافة_نقطة_من_خط(نقطة، البداية، النهاية)
            إذا (المسافة > تسامح)
                ارجع خطأ
            نهاية
        نهاية
        
        ارجع صحيح
    نهاية
    
    دالة المربع_المحيط()
        متغير أدنى_س = ما_لا_نهاية
        متغير أدنى_ص = ما_لا_نهاية
        متغير أعلى_س = سالب_ما_لا_نهاية
        متغير أعلى_ص = سالب_ما_لا_نهاية
        
        لكل نقطة في هذا.النقاط
            أدنى_س = أصغر(أدنى_س، نقطة.س)
            أدنى_ص = أصغر(أدنى_ص، نقطة.ص)
            أعلى_س = أكبر(أعلى_س، نقطة.س)
            أعلى_ص = أكبر(أعلى_ص، نقطة.ص)
        نهاية
        
        ارجع خريطة{
            "س": أدنى_س،
            "ص": أدنى_ص،
            "عرض": أعلى_س - أدنى_س،
            "ارتفاع": أعلى_ص - أدنى_ص
        }
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# كاشف الإيماءات الأساسي
# ═══════════════════════════════════════════════════════════════════════════

صنف كاشف_إيماءات
    متغير _المسارات = خريطة{}
    متغير _معالجات = خريطة{}
    
    # إعدادات
    متغير حد_الضغط = 200        # مللي ثانية
    متغير حد_الضغط_المطول = 500
    متغير حد_التمرير = 50       # بكسل
    متغير حد_السرعة = 0.5
    
    باني()
    نهاية
    
    # ═══════════════════════════════════════════════════════════════════════
    # معالجات الأحداث
    # ═══════════════════════════════════════════════════════════════════════
    
    دالة عند_الضغط(معالج)
        هذا._معالجات["ضغط"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_الضغط_المزدوج(معالج)
        هذا._معالجات["ضغط_مزدوج"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_الضغط_المطول(معالج)
        هذا._معالجات["ضغط_مطول"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_السحب(معالج)
        هذا._معالجات["سحب"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_بدء_السحب(معالج)
        هذا._معالجات["بدء_سحب"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_انتهاء_السحب(معالج)
        هذا._معالجات["انتهاء_سحب"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_التمرير(معالج)
        هذا._معالجات["تمرير"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_التمرير_يمين(معالج)
        هذا._معالجات["تمرير_يمين"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_التمرير_يسار(معالج)
        هذا._معالجات["تمرير_يسار"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_التمرير_أعلى(معالج)
        هذا._معالجات["تمرير_أعلى"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_التمرير_أسفل(معالج)
        هذا._معالجات["تمرير_أسفل"] = معالج
        ارجع هذا
    نهاية
    
    # ═══════════════════════════════════════════════════════════════════════
    # معالجة اللمس
    # ═══════════════════════════════════════════════════════════════════════
    
    دالة _عند_نزول(س، ص، المعرف = 0)
        متغير نقطة = جديد نقطة_لمس(س، ص)
        نقطة.المعرف = المعرف
        
        متغير مسار = جديد مسار_لمس(المعرف)
        مسار.أضف(نقطة)
        هذا._المسارات[المعرف] = مسار
    نهاية
    
    دالة _عند_تحرك(س، ص، المعرف = 0)
        إذا (هذا._المسارات[المعرف] == لا_شيء)
            ارجع
        نهاية
        
        متغير نقطة = جديد نقطة_لمس(س، ص)
        نقطة.المعرف = المعرف
        هذا._المسارات[المعرف].أضف(نقطة)
        
        # معالج السحب
        إذا (هذا._معالجات["سحب"] != لا_شيء)
            هذا._معالجات["سحب"](خريطة{
                "س": س،
                "ص": ص،
                "المسار": هذا._المسارات[المعرف]
            })
        نهاية
    نهاية
    
    دالة _عند_رفع(س، ص، المعرف = 0)
        إذا (هذا._المسارات[المعرف] == لا_شيء)
            ارجع
        نهاية
        
        متغير مسار = هذا._المسارات[المعرف]
        متغير نقطة = جديد نقطة_لمس(س، ص)
        مسار.أضف(نقطة)
        مسار.نشط = خطأ
        
        # تحليل الإيماءة
        هذا._حلل_إيماءة(مسار)
        
        # حذف المسار
        احذف هذا._المسارات[المعرف]
    نهاية
    
    دالة _حلل_إيماءة(مسار)
        متغير المدة = مسار.النهاية().الوقت - مسار.البداية().الوقت
        متغير المسافة = مسار.البداية().المسافة_إلى(مسار.النهاية())
        متغير السرعة = مسار.السرعة()
        
        # ضغط بسيط
        إذا (المسافة < 10 و المدة < هذا.حد_الضغط)
            إذا (هذا._معالجات["ضغط"] != لا_شيء)
                هذا._معالجات["ضغط"](خريطة{
                    "س": مسار.البداية().س،
                    "ص": مسار.البداية().ص
                })
            نهاية
            ارجع
        نهاية
        
        # ضغط مطول
        إذا (المسافة < 10 و المدة >= هذا.حد_الضغط_المطول)
            إذا (هذا._معالجات["ضغط_مطول"] != لا_شيء)
                هذا._معالجات["ضغط_مطول"](خريطة{
                    "س": مسار.البداية().س،
                    "ص": مسار.البداية().ص،
                    "المدة": المدة
                })
            نهاية
            ارجع
        نهاية
        
        # تمرير
        إذا (المسافة >= هذا.حد_التمرير و السرعة >= هذا.حد_السرعة)
            متغير الاتجاه = مسار.الاتجاه()
            
            إذا (هذا._معالجات["تمرير"] != لا_شيء)
                هذا._معالجات["تمرير"](خريطة{
                    "الاتجاه": الاتجاه،
                    "السرعة": السرعة،
                    "المسافة": المسافة
                })
            نهاية
            
            # معالجات الاتجاه المحدد
            إذا (الاتجاه == "يمين" و هذا._معالجات["تمرير_يمين"] != لا_شيء)
                هذا._معالجات["تمرير_يمين"](خريطة{"السرعة": السرعة})
            والا_اذا (الاتجاه == "يسار" و هذا._معالجات["تمرير_يسار"] != لا_شيء)
                هذا._معالجات["تمرير_يسار"](خريطة{"السرعة": السرعة})
            والا_اذا (الاتجاه == "أعلى" و هذا._معالجات["تمرير_أعلى"] != لا_شيء)
                هذا._معالجات["تمرير_أعلى"](خريطة{"السرعة": السرعة})
            والا_اذا (الاتجاه == "أسفل" و هذا._معالجات["تمرير_أسفل"] != لا_شيء)
                هذا._معالجات["تمرير_أسفل"](خريطة{"السرعة": السرعة})
            نهاية
        نهاية
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# كاشف اللمس المتعدد (Pinch, Rotate)
# ═══════════════════════════════════════════════════════════════════════════

صنف كاشف_لمس_متعدد يرث كاشف_إيماءات
    متغير _المسافة_الأولية = 0
    متغير _الزاوية_الأولية = 0
    متغير _المقياس_الحالي = 1
    متغير _الزاوية_الحالية = 0
    
    باني()
        أصل()
    نهاية
    
    دالة عند_القرصة(معالج)
        هذا._معالجات["قرصة"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_بدء_القرصة(معالج)
        هذا._معالجات["بدء_قرصة"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_انتهاء_القرصة(معالج)
        هذا._معالجات["انتهاء_قرصة"] = معالج
        ارجع هذا
    نهاية
    
    دالة عند_التدوير(معالج)
        هذا._معالجات["تدوير"] = معالج
        ارجع هذا
    نهاية
    
    دالة _حدّث_لمس_متعدد()
        متغير المفاتيح = هذا._المسارات.المفاتيح()
        
        إذا (المفاتيح.طول() < 2)
            ارجع
        نهاية
        
        متغير مسار1 = هذا._المسارات[المفاتيح[0]]
        متغير مسار2 = هذا._المسارات[المفاتيح[1]]
        
        متغير نقطة1 = مسار1.النهاية()
        متغير نقطة2 = مسار2.النهاية()
        
        متغير المسافة = نقطة1.المسافة_إلى(نقطة2)
        متغير الزاوية = نقطة1.الزاوية_إلى(نقطة2)
        
        # القرصة (Pinch)
        إذا (هذا._المسافة_الأولية == 0)
            هذا._المسافة_الأولية = المسافة
            هذا._الزاوية_الأولية = الزاوية
            
            إذا (هذا._معالجات["بدء_قرصة"] != لا_شيء)
                هذا._معالجات["بدء_قرصة"](خريطة{})
            نهاية
        وإلا
            هذا._المقياس_الحالي = المسافة / هذا._المسافة_الأولية
            هذا._الزاوية_الحالية = الزاوية - هذا._الزاوية_الأولية
            
            إذا (هذا._معالجات["قرصة"] != لا_شيء)
                هذا._معالجات["قرصة"](خريطة{
                    "المقياس": هذا._المقياس_الحالي،
                    "المركز_س": (نقطة1.س + نقطة2.س) / 2،
                    "المركز_ص": (نقطة1.ص + نقطة2.ص) / 2
                })
            نهاية
            
            إذا (هذا._معالجات["تدوير"] != لا_شيء)
                هذا._معالجات["تدوير"](خريطة{
                    "الزاوية": هذا._الزاوية_الحالية،
                    "المركز_س": (نقطة1.س + نقطة2.س) / 2،
                    "المركز_ص": (نقطة1.ص + نقطة2.ص) / 2
                })
            نهاية
        نهاية
    نهاية
    
    دالة _أعد_ضبط()
        هذا._المسافة_الأولية = 0
        هذا._الزاوية_الأولية = 0
        هذا._المقياس_الحالي = 1
        هذا._الزاوية_الحالية = 0
        
        إذا (هذا._معالجات["انتهاء_قرصة"] != لا_شيء)
            هذا._معالجات["انتهاء_قرصة"](خريطة{
                "المقياس_النهائي": هذا._المقياس_الحالي
            })
        نهاية
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# التعرف على الأشكال المرسومة
# ═══════════════════════════════════════════════════════════════════════════

صنف معرّف_أشكال
    متغير _قوالب = []
    
    باني()
        # تسجيل الأشكال الأساسية
        هذا._سجّل_أشكال_أساسية()
    نهاية
    
    دالة _سجّل_أشكال_أساسية()
        # دائرة
        هذا.سجّل("دائرة"، دالة(مسار)
            # التحقق من الاستدارة
            متغير المربع = مسار.المربع_المحيط()
            متغير النسبة = المربع["عرض"] / المربع["ارتفاع"]
            
            إذا (النسبة < 0.7 أو النسبة > 1.3)
                ارجع 0
            نهاية
            
            # التحقق من الإغلاق
            متغير مسافة_الإغلاق = مسار.البداية().المسافة_إلى(مسار.النهاية())
            متغير المحيط = مسار.المسافة_الكلية()
            
            إذا (مسافة_الإغلاق > المحيط * 0.3)
                ارجع 0
            نهاية
            
            ارجع 0.8
        نهاية)
        
        # مربع/مستطيل
        هذا.سجّل("مربع"، دالة(مسار)
            # البحث عن 4 زوايا
            متغير الزوايا = اكتشف_زوايا(مسار، 4)
            
            إذا (الزوايا.طول() != 4)
                ارجع 0
            نهاية
            
            # التحقق من الإغلاق
            متغير مسافة_الإغلاق = مسار.البداية().المسافة_إلى(مسار.النهاية())
            إذا (مسافة_الإغلاق > 50)
                ارجع 0
            نهاية
            
            ارجع 0.8
        نهاية)
        
        # مثلث
        هذا.سجّل("مثلث"، دالة(مسار)
            متغير الزوايا = اكتشف_زوايا(مسار، 3)
            
            إذا (الزوايا.طول() != 3)
                ارجع 0
            نهاية
            
            ارجع 0.8
        نهاية)
        
        # خط
        هذا.سجّل("خط"، دالة(مسار)
            إذا (مسار.هو_خط_مستقيم(15))
                ارجع 0.9
            نهاية
            ارجع 0
        نهاية)
        
        # سهم
        هذا.سجّل("سهم"، دالة(مسار)
            # البحث عن شكل V في النهاية
            # ... تحليل متقدم
            ارجع 0
        نهاية)
        
        # علامة صح ✓
        هذا.سجّل("صح"، دالة(مسار)
            متغير الزوايا = اكتشف_زوايا(مسار، 1)
            
            إذا (الزوايا.طول() != 1)
                ارجع 0
            نهاية
            
            # التحقق من اتجاه الأضلاع
            متغير زاوية = الزوايا[0]
            
