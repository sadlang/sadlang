صنف نوع_إيماءة
    ثابت ضغط = "ضغط"
    ثابت ضغط_مزدوج = "ضغط_مزدوج"
    ثابت ضغط_مطول = "ضغط_مطول"
    ثابت سحب = "سحب"
    ثابت قرصة = "قرصة"           # pinch
    ثابت تدوير = "تدوير"          # rotate
