        "عند_نص" = دالة(نص)
            الإعدادات["عند_نص"](نص)
        نهاية
    })
    
    ارجع صف([
        حقل_نص({
            "قيمة" = الإعدادات["قيمة"]،
            "عند_التغيير" = الإعدادات["عند_التغيير"]
        })،
        زر_أيقونة({
            "أيقونة" = أيقونات.ميكروفون،
            "عند_الضغط" = دالة()
                المتعرف.ابدأ()
            نهاية
        })
    ])
نهاية

