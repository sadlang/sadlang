# تحديث_ساخن.ص - نظام Hot Reload للتطوير السريع
# ═══════════════════════════════════════════════════════════════════════════
#
# نظام تحديث ساخن يتفوق على Flutter Hot Reload
# المميزات:
# - تحديث فوري للكود بدون إعادة تشغيل
# - الحفاظ على حالة التطبيق
# - تحديث جزئي (الملفات المتغيرة فقط)
# - تتبع التغييرات
# - رسائل تشخيصية
# - تراجع عند الخطأ
#
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# خادم التحديث الساخن
# ═══════════════════════════════════════════════════════════════════════════

#** معلومات ملف **#
صنف معلومات_ملف
    متغير المسار = ""
    متغير آخر_تعديل = 0
    متغير الحجم = 0
    متغير التجزئة = ""
    
    باني(المسار)
        هذا.المسار = المسار
    نهاية
نهاية

#** خادم التحديث الساخن **#
صنف خادم_تحديث_ساخن
    متغير _نشط = خطأ
    متغير _المنفذ = 8585
    متغير _مجلد_المشروع = ""
    متغير _الملفات = خريطة()
    متغير _المراقبون = []
    متغير _فترة_المراقبة = 500  # مللي ثانية
    متغير _اتصالات = []
    متغير _تسجيل = صحيح
    
    باني(مجلد_المشروع، المنفذ = 8585)
        هذا._مجلد_المشروع = مجلد_المشروع
        هذا._المنفذ = المنفذ
    نهاية
    
    #** بدء الخادم **#
    دالة ابدأ()
        إذا (هذا._نشط)
            هذا._سجّل("الخادم يعمل بالفعل")
            ارجع
        نهاية
        
        هذا._نشط = صحيح
        
        # فحص الملفات الأولية
        هذا._افحص_الملفات()
        
        # بدء خادم WebSocket
        __ابدأ_خادم_websocket(هذا._المنفذ، دالة(اتصال)
            هذا._اتصالات.أضف(اتصال)
            
            اتصال.عند_الإغلاق(دالة()
                هذا._اتصالات.احذف(اتصال)
            نهاية)
        نهاية)
        
        # بدء مراقبة الملفات
        هذا._ابدأ_المراقبة()
        
        هذا._سجّل("🔥 خادم التحديث الساخن يعمل على المنفذ " + هذا._المنفذ)
    نهاية
    
    #** إيقاف الخادم **#
    دالة أوقف()
        هذا._نشط = خطأ
        __أوقف_خادم_websocket()
        هذا._سجّل("الخادم متوقف")
    نهاية
    
    #** فحص الملفات **#
    دالة _افحص_الملفات()
        متغير الملفات = __ابحث_عن_ملفات(هذا._مجلد_المشروع، "*.ص")
        
        لكل مسار في الملفات
            متغير معلومات = جديد معلومات_ملف(مسار)
            معلومات.آخر_تعديل = __آخر_تعديل_ملف(مسار)
            معلومات.الحجم = __حجم_ملف(مسار)
            معلومات.التجزئة = __تجزئة_ملف(مسار)
            
            هذا._الملفات[مسار] = معلومات
        نهاية
    نهاية
    
    #** بدء مراقبة الملفات **#
    دالة _ابدأ_المراقبة()
        __كرر_كل(هذا._فترة_المراقبة، دالة()
            إذا (ليس هذا._نشط)
                ارجع خطأ  # إيقاف التكرار
            نهاية
            
            هذا._تحقق_من_التغييرات()
            ارجع صحيح  # استمرار التكرار
        نهاية)
    نهاية
    
    #** التحقق من التغييرات **#
    دالة _تحقق_من_التغييرات()
        متغير الملفات_المتغيرة = []
        متغير ملفات_جديدة = []
        متغير ملفات_محذوفة = []
        
        # البحث عن الملفات الحالية
        متغير الملفات_الحالية = __ابحث_عن_ملفات(هذا._مجلد_المشروع، "*.ص")
        متغير المسارات_الحالية = خريطة()
        
        لكل مسار في الملفات_الحالية
            المسارات_الحالية[مسار] = صحيح
            
            متغير آخر_تعديل = __آخر_تعديل_ملف(مسار)
            
            إذا (ليس هذا._الملفات.يحتوي(مسار))
                # ملف جديد
                ملفات_جديدة.أضف(مسار)
                
                متغير معلومات = جديد معلومات_ملف(مسار)
                معلومات.آخر_تعديل = آخر_تعديل
                هذا._الملفات[مسار] = معلومات
            والا_اذا (هذا._الملفات[مسار].آخر_تعديل != آخر_تعديل)
                # ملف متغير
                الملفات_المتغيرة.أضف(مسار)
                هذا._الملفات[مسار].آخر_تعديل = آخر_تعديل
            نهاية
        نهاية
        
        # البحث عن الملفات المحذوفة
        لكل مسار في هذا._الملفات
            إذا (ليس المسارات_الحالية.يحتوي(مسار))
                ملفات_محذوفة.أضف(مسار)
            نهاية
        نهاية
        
        # حذف الملفات المحذوفة من القائمة
        لكل مسار في ملفات_محذوفة
            هذا._الملفات.احذف(مسار)
        نهاية
        
        # إرسال التحديثات إذا وجدت تغييرات
        إذا (الملفات_المتغيرة.طول() > 0 أو ملفات_جديدة.طول() > 0 أو ملفات_محذوفة.طول() > 0)
            هذا._أرسل_تحديث(الملفات_المتغيرة، ملفات_جديدة، ملفات_محذوفة)
        نهاية
    نهاية
    
    #** إرسال التحديث للعملاء **#
    دالة _أرسل_تحديث(متغيرة، جديدة، محذوفة)
        هذا._سجّل("🔄 تم اكتشاف تغييرات:")
        
        لكل مسار في متغيرة
            هذا._سجّل("  📝 تعديل: " + مسار)
        نهاية
        
        لكل مسار في جديدة
            هذا._سجّل("  ➕ جديد: " + مسار)
        نهاية
        
        لكل مسار في محذوفة
            هذا._سجّل("  ➖ محذوف: " + مسار)
        نهاية
        
        # قراءة محتوى الملفات المتغيرة والجديدة
        متغير الملفات = []
        
        لكل مسار في متغيرة
            الملفات.أضف(خريطة{
                "المسار": مسار،
                "المحتوى": __اقرأ_ملف(مسار)،
                "النوع": "تعديل"
            })
        نهاية
        
        لكل مسار في جديدة
            الملفات.أضف(خريطة{
                "المسار": مسار،
                "المحتوى": __اقرأ_ملف(مسار)،
                "النوع": "جديد"
            })
        نهاية
        
        لكل مسار في محذوفة
            الملفات.أضف(خريطة{
                "المسار": مسار،
                "النوع": "حذف"
            })
        نهاية
        
        # إرسال للعملاء
        متغير رسالة = __إلى_json(خريطة{
            "النوع": "تحديث_ساخن"،
            "الملفات": الملفات،
            "الوقت": __الآن()
        })
        
        لكل اتصال في هذا._اتصالات
            اتصال.أرسل(رسالة)
        نهاية
        
        # إشعار المراقبين المحليين
        لكل مراقب في هذا._المراقبون
            مراقب(الملفات)
        نهاية
        
        هذا._سجّل("✅ تم إرسال التحديث")
    نهاية
    
    #** إضافة مراقب **#
    دالة راقب(الدالة)
        هذا._المراقبون.أضف(الدالة)
    نهاية
    
    #** تسجيل رسالة **#
    دالة _سجّل(الرسالة)
        إذا (هذا._تسجيل)
            اطبع_سطر("[Hot Reload] " + الرسالة)
        نهاية
    نهاية
    
    #** تفعيل/تعطيل التسجيل **#
    دالة التسجيل(مفعّل)
        هذا._تسجيل = مفعّل
    نهاية

نهاية

# ═══════════════════════════════════════════════════════════════════════════
# عميل التحديث الساخن (يعمل على الجهاز/المحاكي)
# ═══════════════════════════════════════════════════════════════════════════

#** عميل التحديث الساخن **#
صنف عميل_تحديث_ساخن
    متغير _متصل = خطأ
    متغير _عنوان_الخادم = ""
    متغير _اتصال = لا_شيء
    متغير _دالة_تحديث = لا_شيء
    متغير _الحالة_المحفوظة = خريطة()
    متغير _إعادة_الاتصال_تلقائي = صحيح
    متغير _محاولات_إعادة_الاتصال = 0
    متغير _الحد_الأقصى_للمحاولات = 10
    
    باني(عنوان_الخادم = "ws://localhost:8585")
        هذا._عنوان_الخادم = عنوان_الخادم
    نهاية
    
    #** الاتصال بالخادم **#
    دالة اتصل()
        هذا._اتصال = __اتصل_websocket(هذا._عنوان_الخادم)
        
        هذا._اتصال.عند_الفتح(دالة()
            هذا._متصل = صحيح
            هذا._محاولات_إعادة_الاتصال = 0
            __أظهر_رسالة_تحديث_ساخن("🔗 متصل بخادم التحديث الساخن")
        نهاية)
        
        هذا._اتصال.عند_الرسالة(دالة(البيانات)
            هذا._عالج_رسالة(البيانات)
        نهاية)
        
        هذا._اتصال.عند_الإغلاق(دالة()
            هذا._متصل = خطأ
            __أظهر_رسالة_تحديث_ساخن("🔌 انقطع الاتصال")
            
            إذا (هذا._إعادة_الاتصال_تلقائي)
                هذا._أعد_الاتصال()
            نهاية
        نهاية)
        
        هذا._اتصال.عند_الخطأ(دالة(الخطأ)
            __أظهر_رسالة_تحديث_ساخن("❌ خطأ: " + الخطأ)
        نهاية)
    نهاية
    
    #** إعادة الاتصال **#
    دالة _أعد_الاتصال()
        إذا (هذا._محاولات_إعادة_الاتصال >= هذا._الحد_الأقصى_للمحاولات)
            __أظهر_رسالة_تحديث_ساخن("⚠️ تم تجاوز الحد الأقصى لمحاولات الاتصال")
            ارجع
        نهاية
        
        هذا._محاولات_إعادة_الاتصال = هذا._محاولات_إعادة_الاتصال + 1
        
        متغير التأخير = هذا._محاولات_إعادة_الاتصال * 1000  # زيادة تدريجية
        
        __بعد(التأخير، دالة()
            __أظهر_رسالة_تحديث_ساخن("🔄 محاولة إعادة الاتصال #" + هذا._محاولات_إعادة_الاتصال)
            هذا.اتصل()
        نهاية)
    نهاية
    
    #** معالجة رسالة من الخادم **#
    دالة _عالج_رسالة(البيانات)
        متغير الرسالة = __من_json(البيانات)
        
        إذا (الرسالة["النوع"] == "تحديث_ساخن")
            هذا._طبّق_تحديث(الرسالة["الملفات"])
        نهاية
    نهاية
    
    #** تطبيق التحديث **#
    دالة _طبّق_تحديث(الملفات)
        # حفظ الحالة الحالية
        هذا._احفظ_الحالة()
        
        حاول
            __أظهر_رسالة_تحديث_ساخن("🔄 جاري تطبيق التحديث...")
            
            # تحديث كل ملف
            لكل ملف في الملفات
                إذا (ملف["النوع"] == "حذف")
                    __احذف_ملف_مؤقت(ملف["المسار"])
                وإلا
                    __اكتب_ملف_مؤقت(ملف["المسار"]، ملف["المحتوى"])
                نهاية
            نهاية
            
            # إعادة تحميل الكود
            __أعد_تحميل_الكود()
            
            # استعادة الحالة
            هذا._استعد_الحالة()
            
            # إعادة بناء الواجهة
            إذا (هذا._دالة_تحديث != لا_شيء)
                هذا._دالة_تحديث()
            نهاية
            
            __أظهر_رسالة_تحديث_ساخن("✅ تم التحديث بنجاح")
            
        امسك خطأ
            # التراجع عند الخطأ
            __أظهر_رسالة_تحديث_ساخن("❌ فشل التحديث: " + خطأ)
            هذا._تراجع()
        نهاية
    نهاية
    
    #** حفظ الحالة **#
    دالة _احفظ_الحالة()
        # الحصول على حالة جميع الإشارات والمخازن
        هذا._الحالة_المحفوظة = __احصل_على_حالة_التطبيق()
    نهاية
    
    #** استعادة الحالة **#
    دالة _استعد_الحالة()
        __استعد_حالة_التطبيق(هذا._الحالة_المحفوظة)
    نهاية
    
    #** التراجع عن التحديث **#
    دالة _تراجع()
        __تراجع_عن_تحديث()
        هذا._استعد_الحالة()
        __أظهر_رسالة_تحديث_ساخن("↩️ تم التراجع عن التحديث")
    نهاية
    
    #** تعيين دالة التحديث **#
    دالة عند_التحديث(الدالة)
        هذا._دالة_تحديث = الدالة
    نهاية
    
    #** قطع الاتصال **#
    دالة اقطع()
        هذا._إعادة_الاتصال_تلقائي = خطأ
        إذا (هذا._اتصال != لا_شيء)
            هذا._اتصال.أغلق()
        نهاية
    نهاية
    
    #** هل متصل **#
    دالة متصل()
        ارجع هذا._متصل
    نهاية

نهاية

# ═══════════════════════════════════════════════════════════════════════════
# أدوات التطوير
# ═══════════════════════════════════════════════════════════════════════════

#** وضع التطوير **#
صنف _وضع_التطوير
    متغير _مفعّل = خطأ
    متغير _عميل = لا_شيء
    متغير _إظهار_شبكة = خطأ
    متغير _إظهار_حدود = خطأ
    متغير _إظهار_أداء = خطأ
    
    #** تفعيل وضع التطوير **#
    دالة فعّل(عنوان_الخادم = "ws://localhost:8585")
        هذا._مفعّل = صحيح
        
        # إنشاء عميل التحديث الساخن
        هذا._عميل = جديد عميل_تحديث_ساخن(عنوان_الخادم)
        هذا._عميل.اتصل()
        
        # تفعيل أدوات التصحيح
        __فعّل_وضع_التطوير()
        
        اطبع_سطر("🔧 وضع التطوير مفعّل")
    نهاية
    
    #** تعطيل وضع التطوير **#
    دالة عطّل()
        هذا._مفعّل = خطأ
        
        إذا (هذا._عميل != لا_شيء)
            هذا._عميل.اقطع()
        نهاية
        
        __عطّل_وضع_التطوير()
    نهاية
    
    #** هل مفعّل **#
    دالة مفعّل()
        ارجع هذا._مفعّل
    نهاية
    
    #** إظهار شبكة التخطيط **#
    دالة أظهر_شبكة()
        هذا._إظهار_شبكة = صحيح
        __أظهر_شبكة_التخطيط()
    نهاية
    
    #** إخفاء شبكة التخطيط **#
    دالة أخفِ_شبكة()
        هذا._إظهار_شبكة = خطأ
        __أخفِ_شبكة_التخطيط()
    نهاية
    
    #** إظهار حدود العناصر **#
    دالة أظهر_حدود()
        هذا._إظهار_حدود = صحيح
        __أظهر_حدود_العناصر()
    نهاية
    
    #** إظهار معلومات الأداء **#
    دالة أظهر_أداء()
        هذا._إظهار_أداء = صحيح
        __أظهر_معلومات_الأداء()
    نهاية
    
    #** طباعة شجرة العناصر **#
    دالة اطبع_شجرة()
        __اطبع_شجرة_العناصر()
    نهاية
    
    #** التقط لقطة شاشة **#
    دالة التقط_شاشة(المسار = "")
        ارجع __التقط_شاشة(المسار)
    نهاية
    
    #** الحصول على عميل التحديث الساخن **#
    دالة العميل()
        ارجع هذا._عميل
    نهاية

نهاية

متغير وضع_التطوير = جديد _وضع_التطوير()

# ═══════════════════════════════════════════════════════════════════════════
# تسجيل الأخطاء والتصحيح
# ═══════════════════════════════════════════════════════════════════════════

#** مستويات التسجيل **#
متغير مستوى_تصحيح = 0
متغير مستوى_معلومات = 1
متغير مستوى_تحذير = 2
متغير مستوى_خطأ = 3

#** مسجّل **#
صنف _مسجّل
    متغير _المستوى = مستوى_تصحيح
    متغير _إرسال_للجهاز = صحيح
    متغير _حفظ_في_ملف = خطأ
    متغير _مسار_الملف = ""
    متغير _السجلات = []
    متغير _الحد_الأقصى = 1000
    
    #** تعيين المستوى **#
    دالة المستوى(المستوى)
        هذا._المستوى = المستوى
    نهاية
    
    #** تصحيح **#
    دالة تصحيح(الرسالة، البيانات = لا_شيء)
        إذا (هذا._المستوى <= مستوى_تصحيح)
            هذا._سجّل("DEBUG"، الرسالة، البيانات)
        نهاية
    نهاية
    
    #** معلومات **#
    دالة معلومات(الرسالة، البيانات = لا_شيء)
        إذا (هذا._المستوى <= مستوى_معلومات)
            هذا._سجّل("INFO"، الرسالة، البيانات)
        نهاية
    نهاية
    
    #** تحذير **#
    دالة تحذير(الرسالة، البيانات = لا_شيء)
        إذا (هذا._المستوى <= مستوى_تحذير)
            هذا._سجّل("WARN"، الرسالة، البيانات)
        نهاية
    نهاية
    
    #** خطأ **#
    دالة خطأ(الرسالة، البيانات = لا_شيء)
        إذا (هذا._المستوى <= مستوى_خطأ)
            هذا._سجّل("ERROR"، الرسالة، البيانات)
        نهاية
    نهاية
    
    دالة _سجّل(النوع، الرسالة، البيانات)
        متغير السجل = خريطة{
            "الوقت": __الآن()،
            "النوع": النوع،
            "الرسالة": الرسالة،
            "البيانات": البيانات
        }
        
        # إضافة للقائمة
        هذا._السجلات.أضف(السجل)
        
