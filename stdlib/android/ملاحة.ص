# ملاحة التبويبات (Tab Navigation)
# ═══════════════════════════════════════════════════════════════════════════

#** تبويب **#
صنف تبويب
    متغير الاسم = ""
    متغير الأيقونة = ""
    متغير العنصر = لا_شيء
    متغير الشارة = ""
    
    باني(الاسم، الأيقونة، العنصر)
        هذا.الاسم = الاسم
        هذا.الأيقونة = الأيقونة
        هذا.العنصر = العنصر
    نهاية
    
    دالة بشارة(النص)
        هذا.الشارة = النص
        ارجع هذا
    نهاية
نهاية

#** شريط التبويبات السفلي **#
صنف شريط_تبويبات
    متغير _التبويبات = []
    متغير التبويب_الحالي = 0
    متغير _المراقبون = []
    متغير اللون = "#2196F3"
    متغير لون_الخلفية = "#FFFFFF"
    متغير لون_غير_نشط = "#9E9E9E"
    
    باني()
        # فارغ
    نهاية
    
    #** إضافة تبويب **#
    دالة أضف(التبويب)
        هذا._التبويبات.أضف(التبويب)
        ارجع هذا
    نهاية
    
    #** تعيين التبويب الحالي **#
    دالة اختر(الفهرس)
        إذا (الفهرس < 0 أو الفهرس >= هذا._التبويبات.طول())
            ارجع
        نهاية
        
        هذا.التبويب_الحالي = الفهرس
        
        لكل مراقب في هذا._المراقبون
            مراقب(الفهرس، هذا._التبويبات[الفهرس])
        نهاية
    نهاية
    
    #** الحصول على التبويب الحالي **#
    دالة الحالي()
        ارجع هذا._التبويبات[هذا.التبويب_الحالي]
    نهاية
    
    #** مراقبة التغيير **#
    دالة راقب(الدالة)
        هذا._المراقبون.أضف(الدالة)
        ارجع هذا
    نهاية
    
    #** تعيين الألوان **#
    دالة بألوان(اللون، الخلفية = "#FFFFFF"، غير_نشط = "#9E9E9E")
        هذا.اللون = اللون
        هذا.لون_الخلفية = الخلفية
        هذا.لون_غير_نشط = غير_نشط
        ارجع هذا
    نهاية
    
    #** بناء JSON **#
    دالة إلى_json()
        متغير تبويبات_json = []
        
        لكل فهرس في مدى(0، هذا._التبويبات.طول())
            متغير تبويب = هذا._التبويبات[فهرس]
            تبويبات_json.أضف(خريطة{
                "الاسم": تبويب.الاسم،
                "الأيقونة": تبويب.الأيقونة،
                "الشارة": تبويب.الشارة،
                "نشط": فهرس == هذا.التبويب_الحالي
            })
        نهاية
        
        ارجع خريطة{
            "النوع": "شريط_تبويبات"،
            "التبويبات": تبويبات_json،
            "الحالي": هذا.التبويب_الحالي،
            "اللون": هذا.اللون،
            "لون_الخلفية": هذا.لون_الخلفية،
            "لون_غير_نشط": هذا.لون_غير_نشط
        }
    نهاية

نهاية

