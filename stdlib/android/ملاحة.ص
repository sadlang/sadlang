        متغير عناصر_json = []
        
        لكل عنصر في هذا._العناصر
            إذا (عنصر.مقسم)
                عناصر_json.أضف(خريطة{"النوع": "مقسم"})
            وإلا
                عناصر_json.أضف(خريطة{
                    "النوع": "عنصر"،
                    "الاسم": عنصر.الاسم،
                    "الأيقونة": عنصر.الأيقونة،
                    "المسار": عنصر.المسار
                })
            نهاية
        نهاية
        
        متغير json = خريطة{
            "النوع": "قائمة_جانبية"،
            "العناصر": عناصر_json،
            "مفتوحة": هذا._مفتوحة
        }
        
        إذا (هذا._الرأس != لا_شيء)
            json["الرأس"] = خريطة{
                "الاسم": هذا._الرأس.الاسم،
                "البريد": هذا._الرأس.البريد،
                "الصورة": هذا._الرأس.الصورة،
