# ═══════════════════════════════════════════════════════════════════════════
# المسار (Route)
# ═══════════════════════════════════════════════════════════════════════════

#** تعريف مسار **#
صنف مسار
    متغير الاسم = ""
    متغير المسار = ""
    متغير دالة_البناء = لا_شيء
    متغير الانتقال = لا_شيء
    متغير الحارس = لا_شيء
    متغير العنوان = ""
    متغير المعلمات = خريطة()
    متغير البيانات = لا_شيء
    
    باني(الاسم، المسار، دالة_البناء)
        هذا.الاسم = الاسم
        هذا.المسار = المسار
        هذا.دالة_البناء = دالة_البناء
    نهاية
    
    #** تعيين الانتقال **#
    دالة بانتقال(الانتقال)
        هذا.الانتقال = الانتقال
        ارجع هذا
    نهاية
    
    #** تعيين حارس المسار **#
    دالة بحارس(الحارس)
        هذا.الحارس = الحارس
        ارجع هذا
    نهاية
    
    #** تعيين العنوان **#
    دالة بعنوان(العنوان)
        هذا.العنوان = العنوان
        ارجع هذا
    نهاية
    
    #** بناء الصفحة **#
    دالة ابنِ(المعلمات = خريطة())
        ارجع هذا.دالة_البناء(المعلمات)
    نهاية
    
    #** مطابقة المسار **#
    دالة يطابق(المسار_المطلوب)
        # مطابقة بسيطة
        إذا (هذا.المسار == المسار_المطلوب)
            ارجع صحيح
        نهاية
        
        # مطابقة مع معلمات (مثل /user/:id)
        متغير أجزاء_النمط = هذا.المسار.قسّم("/")
        متغير أجزاء_المسار = المسار_المطلوب.قسّم("/")
        
        إذا (أجزاء_النمط.طول() != أجزاء_المسار.طول())
            ارجع خطأ
        نهاية
        
        متغير المعلمات_المستخرجة = خريطة()
        
        لكل فهرس في مدى(0، أجزاء_النمط.طول())
            متغير جزء_النمط = أجزاء_النمط[فهرس]
            متغير جزء_المسار = أجزاء_المسار[فهرس]
            
            إذا (جزء_النمط.يبدأ_بـ(":"))
                # معلمة
                متغير اسم_المعلمة = جزء_النمط.قص(1)
                المعلمات_المستخرجة[اسم_المعلمة] = جزء_المسار
            والا_اذا (جزء_النمط != جزء_المسار)
                ارجع خطأ
            نهاية
        نهاية
        
        هذا.المعلمات = المعلمات_المستخرجة
        ارجع صحيح
    نهاية

نهاية

# ═══════════════════════════════════════════════════════════════════════════
# جهاز التوجيه (Router)
# ═══════════════════════════════════════════════════════════════════════════

#** جهاز التوجيه الرئيسي **#
صنف موجه
    متغير _المسارات = خريطة()
    متغير _المكدس = []
    متغير _المراقبون = []
    متغير المسار_الحالي = لا_شيء
    متغير المسار_الافتراضي = "/"
    متغير _الانتقال_الافتراضي = لا_شيء
    متغير _حارس_عام = لا_شيء
    متغير _دالة_خطأ_404 = لا_شيء
    
    باني()
        هذا._الانتقال_الافتراضي = انتقالات.انزلاق_يمين()
    نهاية
    
    #** تسجيل مسار **#
    دالة سجّل(الاسم، المسار، دالة_البناء)
        متغير مسار_جديد = جديد مسار(الاسم، المسار، دالة_البناء)
        هذا._المسارات[الاسم] = مسار_جديد
        ارجع مسار_جديد
    نهاية
    
    #** تسجيل مسارات متعددة **#
    دالة سجّل_مسارات(المسارات)
        لكل مسار في المسارات
            هذا.سجّل(مسار.الاسم، مسار.المسار، مسار.دالة_البناء)
        نهاية
    نهاية
    
    #** تعيين الانتقال الافتراضي **#
    دالة الانتقال_الافتراضي(الانتقال)
        هذا._الانتقال_الافتراضي = الانتقال
    نهاية
    
    #** تعيين حارس عام **#
    دالة الحارس_العام(الحارس)
        هذا._حارس_عام = الحارس
    نهاية
    
    #** تعيين صفحة 404 **#
    دالة صفحة_غير_موجودة(الدالة)
        هذا._دالة_خطأ_404 = الدالة
    نهاية
    
    #** الانتقال إلى مسار **#
    دالة اذهب_إلى(الاسم_أو_المسار، المعلمات = خريطة()، البيانات = لا_شيء)
        متغير المسار = هذا._جد_مسار(الاسم_أو_المسار)
        
        إذا (المسار == لا_شيء)
            # مسار غير موجود
            إذا (هذا._دالة_خطأ_404 != لا_شيء)
                هذا._دالة_خطأ_404(الاسم_أو_المسار)
            نهاية
            ارجع خطأ
        نهاية
        
        # تحقق من الحارس العام
        إذا (هذا._حارس_عام != لا_شيء)
            إذا (ليس هذا._حارس_عام(المسار، المعلمات))
                ارجع خطأ
            نهاية
        نهاية
        
        # تحقق من حارس المسار
        إذا (المسار.الحارس != لا_شيء)
            إذا (ليس المسار.الحارس(المسار، المعلمات))
                ارجع خطأ
            نهاية
        نهاية
        
        # إضافة للمكدس
        المسار.المعلمات = المعلمات
        المسار.البيانات = البيانات
        هذا._المكدس.أضف(المسار)
        هذا.المسار_الحالي = المسار
        
        # إشعار المراقبين
        هذا._أشعر_المراقبين("اذهب"، المسار)
        
        ارجع صحيح
    نهاية
    
    #** استبدال المسار الحالي **#
    دالة استبدل(الاسم_أو_المسار، المعلمات = خريطة())
        إذا (هذا._المكدس.طول() > 0)
            هذا._المكدس.احذف_عند(هذا._المكدس.طول() - 1)
        نهاية
        
        ارجع هذا.اذهب_إلى(الاسم_أو_المسار، المعلمات)
    نهاية
    
    #** العودة للخلف **#
    دالة ارجع()
        إذا (هذا._المكدس.طول() <= 1)
            ارجع خطأ
        نهاية
        
        هذا._المكدس.احذف_عند(هذا._المكدس.طول() - 1)
        هذا.المسار_الحالي = هذا._المكدس[هذا._المكدس.طول() - 1]
        
        هذا._أشعر_المراقبين("رجوع"، هذا.المسار_الحالي)
        
        ارجع صحيح
    نهاية
    
    #** العودة لأول صفحة **#
    دالة ارجع_للبداية()
        إذا (هذا._المكدس.طول() <= 1)
            ارجع
        نهاية
        
        متغير الأول = هذا._المكدس[0]
        هذا._المكدس = [الأول]
        هذا.المسار_الحالي = الأول
        
        هذا._أشعر_المراقبين("رجوع_للبداية"، الأول)
    نهاية
    
    #** هل يمكن الرجوع **#
    دالة يمكن_الرجوع()
        ارجع هذا._المكدس.طول() > 1
    نهاية
    
    #** مسح المكدس والذهاب لمسار **#
    دالة امسح_واذهب(الاسم_أو_المسار، المعلمات = خريطة())
        هذا._المكدس = []
        ارجع هذا.اذهب_إلى(الاسم_أو_المسار، المعلمات)
    نهاية
    
    #** البحث عن مسار **#
    دالة _جد_مسار(الاسم_أو_المسار)
        # بحث بالاسم أولاً
        إذا (هذا._المسارات.يحتوي(الاسم_أو_المسار))
            ارجع هذا._المسارات[الاسم_أو_المسار]
        نهاية
        
        # بحث بالمسار
        لكل اسم في هذا._المسارات
            متغير مسار = هذا._المسارات[اسم]
            إذا (مسار.يطابق(الاسم_أو_المسار))
                ارجع مسار
            نهاية
        نهاية
        
        ارجع لا_شيء
    نهاية
    
    #** إضافة مراقب للملاحة **#
    دالة راقب(الدالة)
        هذا._المراقبون.أضف(الدالة)
        ارجع دالة()
            هذا._المراقبون.احذف(الدالة)
        نهاية
    نهاية
    
    #** إشعار المراقبين **#
    دالة _أشعر_المراقبين(الحدث، المسار)
        لكل مراقب في هذا._المراقبون
            مراقب(الحدث، المسار)
        نهاية
    نهاية
    
    #** الحصول على المكدس **#
    دالة المكدس()
        ارجع هذا._المكدس
    نهاية
    
    #** عمق المكدس **#
    دالة عمق_المكدس()
        ارجع هذا._المكدس.طول()
    نهاية

نهاية

