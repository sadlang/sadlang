# الروابط العميقة (Deep Links)
# ═══════════════════════════════════════════════════════════════════════════

#** معالج الروابط العميقة **#
صنف معالج_روابط
    متغير _النمط = ""  # مثل: myapp://
    متغير _المعالجات = خريطة()
    متغير _الموجه = لا_شيء
    
    باني(النمط، الموجه)
        هذا._النمط = النمط
        هذا._الموجه = الموجه
    نهاية
    
    #** تسجيل معالج **#
    دالة سجّل(المسار، الدالة)
        هذا._المعالجات[المسار] = الدالة
        ارجع هذا
    نهاية
    
    #** معالجة رابط **#
    دالة عالج(الرابط)
        إذا (ليس الرابط.يبدأ_بـ(هذا._النمط))
            ارجع خطأ
        نهاية
        
        متغير المسار = الرابط.قص(هذا._النمط.طول())
        متغير أجزاء = المسار.قسّم("?")
        متغير المسار_الأساسي = أجزاء[0]
        متغير المعلمات = خريطة()
        
        # تحليل المعلمات
        إذا (أجزاء.طول() > 1)
            متغير استعلام = أجزاء[1]
            متغير أزواج = استعلام.قسّم("&")
            
            لكل زوج في أزواج
                متغير مفتاح_قيمة = زوج.قسّم("=")
                إذا (مفتاح_قيمة.طول() == 2)
                    المعلمات[مفتاح_قيمة[0]] = مفتاح_قيمة[1]
                نهاية
            نهاية
        نهاية
        
        # البحث عن معالج
        إذا (هذا._المعالجات.يحتوي(المسار_الأساسي))
            هذا._المعالجات[المسار_الأساسي](المعلمات)
            ارجع صحيح
        نهاية
        
