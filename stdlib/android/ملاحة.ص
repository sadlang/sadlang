#** القائمة الجانبية **#
صنف قائمة_جانبية
    متغير _الرأس = لا_شيء
    متغير _العناصر = []
    متغير _مفتوحة = خطأ
    متغير _المراقبون = []
    
    باني()
        # فارغ
    نهاية
    
    #** تعيين الرأس **#
    دالة الرأس(الرأس)
        هذا._الرأس = الرأس
        ارجع هذا
    نهاية
    
    #** إضافة عنصر **#
    دالة أضف(العنصر)
        هذا._العناصر.أضف(العنصر)
        ارجع هذا
    نهاية
    
    #** فتح القائمة **#
    دالة افتح()
        هذا._مفتوحة = صحيح
        هذا._أشعر("فتح")
    نهاية
    
    #** إغلاق القائمة **#
    دالة أغلق()
