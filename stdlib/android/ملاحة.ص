        إذا (هذا._مفتوحة)
            هذا.أغلق()
        وإلا
            هذا.افتح()
        نهاية
    نهاية
    
    دالة _أشعر(الحدث)
        لكل مراقب في هذا._المراقبون
            مراقب(الحدث، هذا._مفتوحة)
        نهاية
    نهاية
    
    دالة راقب(الدالة)
