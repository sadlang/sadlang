                         "\033[33m"
            
            اطبع(لون + الرمز + " " + النتيجة["الاسم"] + "\033[0m")
            
            إذا (النتيجة["الحالة"] == "فشل")
                اطبع("    " + النتيجة["الخطأ"])
            نهاية
        نهاية
    نهاية
    
    دالة ثابتة _أبلغ_ملخص(الملخص)
        إذا (مشغّل_اختبارات._مقرر != لا_شيء)
            مشغّل_اختبارات._مقرر.سجّل_ملخص(الملخص)
        وإلا
            اطبع("")
            اطبع("═══════════════════════════════════════════")
            اطبع("ملخص الاختبارات:")
            اطبع("  إجمالي: " + نص(الملخص["إجمالي"]))
            اطبع("  \033[32mنجاح: " + نص(الملخص["نجاح"]) + "\033[0m")
            اطبع("  \033[31mفشل: " + نص(الملخص["فشل"]) + "\033[0m")
            اطبع("  \033[33mتخطي: " + نص(الملخص["تخطي"]) + "\033[0m")
            اطبع("  المدة: " + نص(الملخص["المدة"]) + " مللي ثانية")
            اطبع("═══════════════════════════════════════════")
            
            إذا (الملخص["نجح_الكل"])
                اطبع("\033[32m✓ جميع الاختبارات نجحت!\033[0m")
            وإلا
                اطبع("\033[31m✗ بعض الاختبارات فشلت\033[0m")
            نهاية
        نهاية
    نهاية
نهاية

