# إطار الاختبار المدمج - لغة ص
# Built-in Testing Framework
# ═══════════════════════════════════════════════════════════════════════════
#
# إطار اختبار شامل ومتكامل يتفوق على Flutter Test:
# - اختبارات الوحدات
# - اختبارات العناصر (Widget Tests)
# - اختبارات التكامل
# - اختبارات E2E
# - إعادة تشغيل ذهبية (Golden Tests)
# - اختبارات الأداء
# - التغطية بالكود
# - تقارير مفصلة
#
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# التأكيدات
# ═══════════════════════════════════════════════════════════════════════════

صنف تأكيد
    
    # ─────────────────────────────────────────────────────────────────────
    # المساواة
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة يساوي(الفعلي، المتوقع، الرسالة = "")
        إذا (الفعلي != المتوقع)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المتوقع: " + نص(المتوقع) + "\n" +
                "الفعلي: " + نص(الفعلي)
            )
        نهاية
    نهاية
    
    دالة ثابتة لا_يساوي(الفعلي، غير_المتوقع، الرسالة = "")
        إذا (الفعلي == غير_المتوقع)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "القيمة يجب أن لا تساوي: " + نص(غير_المتوقع)
            )
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # القيم المنطقية
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة صحيح(القيمة، الرسالة = "")
        إذا (القيمة != صحيح)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المتوقع: صحيح\n" +
                "الفعلي: " + نص(القيمة)
            )
        نهاية
    نهاية
    
    دالة ثابتة خطأ(القيمة، الرسالة = "")
        إذا (القيمة != خطأ)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المتوقع: خطأ\n" +
                "الفعلي: " + نص(القيمة)
            )
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # القيم الفارغة
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة لا_شيء(القيمة، الرسالة = "")
        إذا (القيمة != لا_شيء)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المتوقع: لا_شيء\n" +
                "الفعلي: " + نص(القيمة)
            )
        نهاية
    نهاية
    
    دالة ثابتة ليس_لا_شيء(القيمة، الرسالة = "")
        إذا (القيمة == لا_شيء)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "القيمة يجب أن لا تكون لا_شيء"
            )
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # المقارنات العددية
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة أكبر_من(الفعلي، الحد، الرسالة = "")
        إذا (الفعلي <= الحد)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المتوقع: قيمة أكبر من " + نص(الحد) + "\n" +
                "الفعلي: " + نص(الفعلي)
            )
        نهاية
    نهاية
    
    دالة ثابتة أصغر_من(الفعلي، الحد، الرسالة = "")
        إذا (الفعلي >= الحد)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المتوقع: قيمة أصغر من " + نص(الحد) + "\n" +
                "الفعلي: " + نص(الفعلي)
            )
        نهاية
    نهاية
    
    دالة ثابتة بين(الفعلي، الأدنى، الأقصى، الرسالة = "")
        إذا (الفعلي < الأدنى أو الفعلي > الأقصى)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المتوقع: قيمة بين " + نص(الأدنى) + " و " + نص(الأقصى) + "\n" +
                "الفعلي: " + نص(الفعلي)
            )
        نهاية
    نهاية
    
    دالة ثابتة قريب_من(الفعلي، المتوقع، الهامش = 0.0001، الرسالة = "")
        إذا (مطلق(الفعلي - المتوقع) > الهامش)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المتوقع: قيمة قريبة من " + نص(المتوقع) +
                " (هامش: " + نص(الهامش) + ")\n" +
                "الفعلي: " + نص(الفعلي)
            )
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # النصوص
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة يحتوي(النص، الجزء، الرسالة = "")
        إذا (ليس النص.يحتوي(الجزء))
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "النص لا يحتوي على: " + الجزء + "\n" +
                "النص الفعلي: " + النص
            )
        نهاية
    نهاية
    
    دالة ثابتة يبدأ_بـ(النص، البداية، الرسالة = "")
        إذا (ليس النص.يبدأ_بـ(البداية))
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "النص يجب أن يبدأ بـ: " + البداية + "\n" +
                "النص الفعلي: " + النص
            )
        نهاية
    نهاية
    
    دالة ثابتة ينتهي_بـ(النص، النهاية، الرسالة = "")
        إذا (ليس النص.ينتهي_بـ(النهاية))
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "النص يجب أن ينتهي بـ: " + النهاية + "\n" +
                "النص الفعلي: " + النص
            )
        نهاية
    نهاية
    
    دالة ثابتة يطابق_نمط(النص، النمط، الرسالة = "")
        إذا (ليس نمط_regex(النمط).يطابق(النص))
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "النص لا يطابق النمط: " + النمط + "\n" +
                "النص الفعلي: " + النص
            )
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # المصفوفات والخرائط
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة يحتوي_على_عنصر(المصفوفة، العنصر، الرسالة = "")
        إذا (ليس المصفوفة.يحتوي(العنصر))
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المصفوفة لا تحتوي على: " + نص(العنصر)
            )
        نهاية
    نهاية
    
    دالة ثابتة طول_يساوي(المصفوفة، الطول، الرسالة = "")
        إذا (المصفوفة.طول() != الطول)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "الطول المتوقع: " + نص(الطول) + "\n" +
                "الطول الفعلي: " + نص(المصفوفة.طول())
            )
        نهاية
    نهاية
    
    دالة ثابتة فارغة(المصفوفة، الرسالة = "")
        إذا (المصفوفة.طول() > 0)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المصفوفة يجب أن تكون فارغة\n" +
                "الطول الفعلي: " + نص(المصفوفة.طول())
            )
        نهاية
    نهاية
    
    دالة ثابتة ليست_فارغة(المصفوفة، الرسالة = "")
        إذا (المصفوفة.طول() == 0)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "المصفوفة يجب أن لا تكون فارغة"
            )
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # الأنواع
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة من_نوع(القيمة، النوع، الرسالة = "")
        إذا (نوع(القيمة) != النوع)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "النوع المتوقع: " + النوع + "\n" +
                "النوع الفعلي: " + نوع(القيمة)
            )
        نهاية
    نهاية
    
    دالة ثابتة نسخة_من(الكائن، الصنف، الرسالة = "")
        إذا (ليس (الكائن هو الصنف))
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "الكائن ليس نسخة من الصنف المتوقع"
            )
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # الاستثناءات
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة يلقي(الدالة، نوع_الخطأ = لا_شيء، الرسالة = "")
        حاول
            الدالة()
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "الدالة يجب أن تلقي استثناء"
            )
        امسك (خطأ)
            إذا (نوع_الخطأ != لا_شيء)
                إذا (ليس (خطأ هو نوع_الخطأ))
                    ألقِ خطأ_تأكيد(
                        "فشل التأكيد: " + الرسالة + "\n" +
                        "نوع الاستثناء غير متوقع"
                    )
                نهاية
            نهاية
            # نجاح - تم إلقاء الاستثناء المتوقع
        نهاية
    نهاية
    
    دالة ثابتة لا_يلقي(الدالة، الرسالة = "")
        حاول
            الدالة()
            # نجاح - لم يلقِ استثناء
        امسك (خطأ)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "الدالة ألقت استثناء غير متوقع: " + خطأ.رسالة
            )
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # غير متزامن
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة يكتمل_خلال(الوعد، المهلة، الرسالة = "")
        متغير نجح = خطأ
        متغير سباق = انتظر سباق([
            الوعد.ثم(دالة(نتيجة)
                نجح = صحيح
                ارجع نتيجة
            نهاية)،
            انتظر(المهلة)
        ])
        
        إذا (ليس نجح)
            ألقِ خطأ_تأكيد(
                "فشل التأكيد: " + الرسالة + "\n" +
                "الوعد لم يكتمل خلال " + نص(المهلة) + " مللي ثانية"
            )
        نهاية
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# حالة الاختبار
# ═══════════════════════════════════════════════════════════════════════════

صنف حالة_اختبار
    متغير الاسم = ""
    متغير الدالة = لا_شيء
    متغير المهلة = 30000
    متغير _قبل = لا_شيء
    متغير _بعد = لا_شيء
    متغير _تخطي = خطأ
    متغير _سبب_التخطي = ""
    متغير _وسوم = []
    
    باني(الاسم، الدالة)
        هذا.الاسم = الاسم
        هذا.الدالة = الدالة
    نهاية
    
    دالة بمهلة(المهلة)
        هذا.المهلة = المهلة
        ارجع هذا
    نهاية
    
    دالة قبل(الدالة)
        هذا._قبل = الدالة
        ارجع هذا
    نهاية
    
    دالة بعد(الدالة)
        هذا._بعد = الدالة
        ارجع هذا
    نهاية
    
    دالة تخطي(السبب = "")
        هذا._تخطي = صحيح
        هذا._سبب_التخطي = السبب
        ارجع هذا
    نهاية
    
    دالة بوسوم(الوسوم)
        هذا._وسوم = الوسوم
        ارجع هذا
    نهاية
    
    دالة غير_متزامنة شغّل()
        إذا (هذا._تخطي)
            ارجع خريطة{
                "الحالة": "تخطي"،
                "الاسم": هذا.الاسم،
                "السبب": هذا._سبب_التخطي
            }
        نهاية
        
        متغير البداية = الوقت_الحالي()
        
        حاول
            # قبل
            إذا (هذا._قبل != لا_شيء)
                انتظر هذا._قبل()
            نهاية
            
            # الاختبار
            انتظر هذا.الدالة()
            
            # بعد
            إذا (هذا._بعد != لا_شيء)
                انتظر هذا._بعد()
            نهاية
            
            ارجع خريطة{
                "الحالة": "نجاح"،
                "الاسم": هذا.الاسم،
                "المدة": الوقت_الحالي() - البداية
            }
        امسك (خطأ)
            ارجع خريطة{
                "الحالة": "فشل"،
                "الاسم": هذا.الاسم،
                "الخطأ": خطأ.رسالة،
                "المكدس": خطأ.مكدس،
                "المدة": الوقت_الحالي() - البداية
            }
        نهاية
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# مجموعة الاختبارات
# ═══════════════════════════════════════════════════════════════════════════

صنف مجموعة_اختبارات
    متغير الاسم = ""
    متغير _الاختبارات = []
    متغير _قبل_الكل = لا_شيء
    متغير _بعد_الكل = لا_شيء
    متغير _قبل_كل = لا_شيء
    متغير _بعد_كل = لا_شيء
    
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية
    
    دالة أضف(اختبار)
        هذا._الاختبارات.أضف(اختبار)
        ارجع هذا
    نهاية
    
    دالة اختبار(الاسم، الدالة)
        هذا._الاختبارات.أضف(جديد حالة_اختبار(الاسم، الدالة))
        ارجع هذا
    نهاية
    
    دالة قبل_الكل(الدالة)
        هذا._قبل_الكل = الدالة
        ارجع هذا
    نهاية
    
    دالة بعد_الكل(الدالة)
        هذا._بعد_الكل = الدالة
        ارجع هذا
    نهاية
    
    دالة قبل_كل(الدالة)
        هذا._قبل_كل = الدالة
        ارجع هذا
    نهاية
    
    دالة بعد_كل(الدالة)
        هذا._بعد_كل = الدالة
        ارجع هذا
    نهاية
    
    دالة غير_متزامنة شغّل()
        متغير النتائج = []
        
        # قبل الكل
        إذا (هذا._قبل_الكل != لا_شيء)
            انتظر هذا._قبل_الكل()
        نهاية
        
        # تشغيل الاختبارات
        لكل اختبار في هذا._الاختبارات
            # قبل كل
            إذا (هذا._قبل_كل != لا_شيء)
                انتظر هذا._قبل_كل()
            نهاية
            
            متغير النتيجة = انتظر اختبار.شغّل()
            النتائج.أضف(النتيجة)
            
            # بعد كل
            إذا (هذا._بعد_كل != لا_شيء)
                انتظر هذا._بعد_كل()
            نهاية
        نهاية
        
        # بعد الكل
        إذا (هذا._بعد_الكل != لا_شيء)
            انتظر هذا._بعد_الكل()
        نهاية
        
        ارجع خريطة{
            "الاسم": هذا.الاسم،
            "النتائج": النتائج
        }
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# مشغل الاختبارات
# ═══════════════════════════════════════════════════════════════════════════

صنف مشغّل_اختبارات
    ثابت _المجموعات = []
    ثابت _الفلتر = لا_شيء
    ثابت _وسوم_فلتر = []
    ثابت _مقرر = لا_شيء
    
    دالة ثابتة أضف(مجموعة)
        مشغّل_اختبارات._المجموعات.أضف(مجموعة)
    نهاية
    
    دالة ثابتة فلتر_بالاسم(النمط)
        مشغّل_اختبارات._الفلتر = النمط
    نهاية
    
    دالة ثابتة فلتر_بالوسوم(الوسوم)
        مشغّل_اختبارات._وسوم_فلتر = الوسوم
    نهاية
    
    دالة ثابتة بمقرر(المقرر)
        مشغّل_اختبارات._مقرر = المقرر
    نهاية
    
    دالة ثابتة غير_متزامنة شغّل()
        متغير البداية = الوقت_الحالي()
        متغير كل_النتائج = []
        
        متغير إجمالي = 0
        متغير نجاح = 0
        متغير فشل = 0
        متغير تخطي = 0
        
        لكل مجموعة في مشغّل_اختبارات._المجموعات
            متغير نتيجة_مجموعة = انتظر مجموعة.شغّل()
            كل_النتائج.أضف(نتيجة_مجموعة)
            
            لكل نتيجة في نتيجة_مجموعة["النتائج"]
                إجمالي = إجمالي + 1
                
                إذا (نتيجة["الحالة"] == "نجاح")
                    نجاح = نجاح + 1
                    مشغّل_اختبارات._أبلغ("✓"، نتيجة)
                والا_اذا (نتيجة["الحالة"] == "فشل")
                    فشل = فشل + 1
                    مشغّل_اختبارات._أبلغ("✗"، نتيجة)
                والا_اذا (نتيجة["الحالة"] == "تخطي")
                    تخطي = تخطي + 1
                    مشغّل_اختبارات._أبلغ("○"، نتيجة)
                نهاية
            نهاية
        نهاية
        
        متغير الملخص = خريطة{
            "إجمالي": إجمالي،
            "نجاح": نجاح،
            "فشل": فشل،
            "تخطي": تخطي،
            "المدة": الوقت_الحالي() - البداية،
            "نجح_الكل": فشل == 0،
            "النتائج": كل_النتائج
        }
        
        مشغّل_اختبارات._أبلغ_ملخص(الملخص)
        
        ارجع الملخص
    نهاية
    
    دالة ثابتة _أبلغ(الرمز، النتيجة)
        إذا (مشغّل_اختبارات._مقرر != لا_شيء)
            مشغّل_اختبارات._مقرر.سجّل_نتيجة(الرمز، النتيجة)
        وإلا
            متغير لون = إذا النتيجة["الحالة"] == "نجاح" ثم "\033[32m" وإلا
