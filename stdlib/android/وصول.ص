# ═══════════════════════════════════════════════════════════════════════════
# إعدادات إمكانية الوصول
# ═══════════════════════════════════════════════════════════════════════════

صنف إعدادات_وصول
    ثابت _مفعّل = صحيح
    ثابت _حجم_الخط = 1.0
    ثابت _تباين_عالي = خطأ
    ثابت _تقليل_الحركة = خطأ
    ثابت _قارئ_شاشة_مفعّل = خطأ
    ثابت _ألوان_مقلوبة = خطأ
    ثابت _نص_عريض = خطأ
    
    دالة ثابتة غير_متزامنة حمّل()
        # تحميل من إعدادات النظام
        إعدادات_وصول._حجم_الخط = انتظر أصلي_احصل_حجم_خط_نظام()
        إعدادات_وصول._تباين_عالي = أصلي_تباين_عالي_مفعّل()
        إعدادات_وصول._تقليل_الحركة = أصلي_تقليل_حركة_مفعّل()
        إعدادات_وصول._قارئ_شاشة_مفعّل = أصلي_قارئ_شاشة_مفعّل()
        إعدادات_وصول._ألوان_مقلوبة = أصلي_ألوان_مقلوبة()
        إعدادات_وصول._نص_عريض = أصلي_نص_عريض_مفعّل()
    نهاية
    
    دالة ثابتة حجم_الخط()
        ارجع إعدادات_وصول._حجم_الخط
    نهاية
    
    دالة ثابتة تباين_عالي()
        ارجع إعدادات_وصول._تباين_عالي
    نهاية
    
    دالة ثابتة تقليل_الحركة()
        ارجع إعدادات_وصول._تقليل_الحركة
    نهاية
    
    دالة ثابتة قارئ_شاشة()
        ارجع إعدادات_وصول._قارئ_شاشة_مفعّل
    نهاية
    
    دالة ثابتة ألوان_مقلوبة()
        ارجع إعدادات_وصول._ألوان_مقلوبة
    نهاية
    
    دالة ثابتة نص_عريض()
        ارجع إعدادات_وصول._نص_عريض
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # الاستماع للتغييرات
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة عند_تغيير_إعدادات(المعالج)
        أصلي_استمع_تغييرات_وصول(دالة(الإعدادات)
            إعدادات_وصول._حجم_الخط = الإعدادات["حجم_الخط"]
            إعدادات_وصول._تباين_عالي = الإعدادات["تباين_عالي"]
            إعدادات_وصول._تقليل_الحركة = الإعدادات["تقليل_الحركة"]
            إعدادات_وصول._قارئ_شاشة_مفعّل = الإعدادات["قارئ_شاشة"]
            المعالج(الإعدادات)
        نهاية)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# دلالات إمكانية الوصول
# ═══════════════════════════════════════════════════════════════════════════

صنف دور_وصول
    ثابت زر = "Button"
    ثابت رابط = "Link"
    ثابت صورة = "Image"
    ثابت نص = "Text"
    ثابت عنوان = "Header"
    ثابت قائمة = "List"
    ثابت عنصر_قائمة = "ListItem"
    ثابت مربع_تحديد = "CheckBox"
    ثابت زر_راديو = "RadioButton"
    ثابت مفتاح = "Switch"
    ثابت منزلق = "Slider"
    ثابت حقل_نص = "TextField"
    ثابت شريط_تقدم = "ProgressBar"
    ثابت علامة_تبويب = "Tab"
    ثابت حوار = "Dialog"
    ثابت قائمة_منسدلة = "DropdownList"
    ثابت شريط_تطبيق = "AppBar"
    ثابت تنبيه = "Alert"
نهاية

صنف دلالات
    متغير _التسمية = لا_شيء
    متغير _الوصف = لا_شيء
    متغير _القيمة = لا_شيء
    متغير _الحد_الأدنى = لا_شيء
    متغير _الحد_الأقصى = لا_شيء
    متغير _الخطوة = لا_شيء
    متغير _الدور = لا_شيء
    متغير _عنوان = خطأ
    متغير _مستوى_عنوان = 0
    متغير _محدد = لا_شيء
    متغير _مفعّل = صحيح
    متغير _قابل_للتركيز = صحيح
    متغير _حي = خطأ
    متغير _نوع_حي = "polite"
    متغير _مرتبط_بـ = لا_شيء
    متغير _يخفي_أبناء = خطأ
    متغير _إجراءات = []
    
    باني()
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # التسميات والأوصاف
    # ─────────────────────────────────────────────────────────────────────
    
    دالة تسمية(التسمية)
        هذا._التسمية = التسمية
        ارجع هذا
    نهاية
    
    دالة وصف(الوصف)
        هذا._الوصف = الوصف
        ارجع هذا
    نهاية
    
    دالة تلميح(التلميح)
        # تلميح للمستخدم عن كيفية استخدام العنصر
        ارجع هذا.وصف(التلميح)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # القيم للمنزلقات والتقدم
    # ─────────────────────────────────────────────────────────────────────
    
    دالة قيمة(القيمة)
        هذا._القيمة = القيمة
        ارجع هذا
    نهاية
    
    دالة نطاق(الأدنى، الأقصى، الخطوة = 1)
        هذا._الحد_الأدنى = الأدنى
        هذا._الحد_الأقصى = الأقصى
        هذا._الخطوة = الخطوة
        ارجع هذا
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # الأدوار
    # ─────────────────────────────────────────────────────────────────────
    
    دالة دور(الدور)
        هذا._الدور = الدور
        ارجع هذا
    نهاية
    
    دالة كزر()
        ارجع هذا.دور(دور_وصول.زر)
    نهاية
    
    دالة كرابط()
        ارجع هذا.دور(دور_وصول.رابط)
    نهاية
    
    دالة كصورة()
        ارجع هذا.دور(دور_وصول.صورة)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # العناوين
    # ─────────────────────────────────────────────────────────────────────
    
    دالة عنوان(المستوى = 1)
        هذا._عنوان = صحيح
        هذا._مستوى_عنوان = المستوى
        ارجع هذا
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # الحالة
    # ─────────────────────────────────────────────────────────────────────
    
    دالة محدد(محدد)
        هذا._محدد = محدد
        ارجع هذا
    نهاية
    
    دالة معطّل()
        هذا._مفعّل = خطأ
        ارجع هذا
    نهاية
    
    دالة غير_قابل_للتركيز()
        هذا._قابل_للتركيز = خطأ
        ارجع هذا
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # المحتوى الحي
    # ─────────────────────────────────────────────────────────────────────
    
    دالة حي(مهذب = صحيح)
        هذا._حي = صحيح
        هذا._نوع_حي = إذا مهذب ثم "polite" وإلا "assertive"
        ارجع هذا
    نهاية
    
    دالة تنبيه_حي()
        # للتنبيهات المهمة التي تقاطع القراءة
        ارجع هذا.حي(خطأ)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # الإجراءات المخصصة
    # ─────────────────────────────────────────────────────────────────────
    
    دالة إجراء(الاسم، المعالج)
        هذا._إجراءات.أضف(خريطة{
            "الاسم": الاسم،
            "المعالج": المعالج
        })
        ارجع هذا
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # إخفاء من قارئ الشاشة
    # ─────────────────────────────────────────────────────────────────────
    
    دالة مخفي()
        هذا._قابل_للتركيز = خطأ
        هذا._يخفي_أبناء = صحيح
        ارجع هذا
    نهاية
    
    دالة يخفي_أبناء()
        هذا._يخفي_أبناء = صحيح
        ارجع هذا
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # التصدير
    # ─────────────────────────────────────────────────────────────────────
    
    دالة بناء()
        ارجع خريطة{
            "التسمية": هذا._التسمية،
            "الوصف": هذا._الوصف،
            "القيمة": هذا._القيمة،
            "الحد_الأدنى": هذا._الحد_الأدنى،
            "الحد_الأقصى": هذا._الحد_الأقصى،
            "الخطوة": هذا._الخطوة،
            "الدور": هذا._الدور،
            "عنوان": هذا._عنوان،
            "مستوى_عنوان": هذا._مستوى_عنوان،
            "محدد": هذا._محدد،
            "مفعّل": هذا._مفعّل،
            "قابل_للتركيز": هذا._قابل_للتركيز،
            "حي": هذا._حي،
            "نوع_حي": هذا._نوع_حي،
            "يخفي_أبناء": هذا._يخفي_أبناء،
            "إجراءات": هذا._إجراءات
        }
    نهاية
نهاية

# دالة مختصرة
دالة دلالات_وصول()
    ارجع جديد دلالات()
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# عناصر واجهة بإمكانية وصول
# ═══════════════════════════════════════════════════════════════════════════

دالة نص_وصول(المحتوى، الدلالات = لا_شيء)
    متغير عنصر = نص(المحتوى)
    
    إذا (الدلالات != لا_شيء)
        عنصر = عنصر.بدلالات(الدلالات.بناء())
    وإلا
        عنصر = عنصر.بدلالات(
            جديد دلالات().تسمية(المحتوى).بناء()
        )
    نهاية
    
    # تكبير حسب إعدادات النظام
    متغير الحجم = عنصر.حجم_الخط() * إعدادات_وصول.حجم_الخط()
    عنصر = عنصر.بحجم_خط(الحجم)
    
    # نص عريض إذا مفعّل
    إذا (إعدادات_وصول.نص_عريض())
        عنصر = عنصر.بوزن_خط("عريض")
    نهاية
    
    ارجع عنصر
نهاية

دالة زر_وصول(النص، عند_الضغط، الدلالات = لا_شيء)
    متغير عنصر = زر_ممتلئ(النص، عند_الضغط)
    
    إذا (الدلالات != لا_شيء)
        عنصر = عنصر.بدلالات(الدلالات.بناء())
    وإلا
        عنصر = عنصر.بدلالات(
            جديد دلالات()
                .كزر()
                .تسمية(النص)
                .بناء()
        )
    نهاية
    
    # حجم لمس أكبر (48dp minimum)
    عنصر = عنصر.بحد_أدنى_ارتفاع(48).بحد_أدنى_عرض(48)
    
    ارجع عنصر
نهاية

دالة صورة_وصول(المصدر، الوصف)
    ارجع صورة(المصدر)
        .بدلالات(
            جديد دلالات()
                .كصورة()
                .تسمية(الوصف)
                .بناء()
        )
نهاية

دالة أيقونة_وصول(الأيقونة، الوصف)
    ارجع أيقونة(الأيقونة)
        .بدلالات(
            جديد دلالات()
                .كصورة()
                .تسمية(الوصف)
                .بناء()
        )
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# إعلانات قارئ الشاشة
# ═══════════════════════════════════════════════════════════════════════════

صنف قارئ_شاشة
    
    دالة ثابتة أعلن(الرسالة، مهذب = صحيح)
        # إعلان رسالة لقارئ الشاشة
        إذا (إعدادات_وصول.قارئ_شاشة())
            أصلي_أعلن_وصول(الرسالة، مهذب)
        نهاية
    نهاية
    
    دالة ثابتة أعلن_فوراً(الرسالة)
        # إعلان مهم يقاطع القراءة الحالية
        قارئ_شاشة.أعلن(الرسالة، خطأ)
    نهاية
    
    دالة ثابتة ركّز_على(العنصر)
        # نقل تركيز قارئ الشاشة لعنصر محدد
        أصلي_ركّز_وصول(العنصر)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# التنقل بإمكانية الوصول
# ═══════════════════════════════════════════════════════════════════════════

صنف ترتيب_تنقل
    ثابت _العناصر = []
    
    دالة ثابتة أضف(العنصر، الترتيب)
        ترتيب_تنقل._العناصر.أضف(خريطة{
            "العنصر": العنصر،
            "الترتيب": الترتيب
        })
    نهاية
    
    دالة ثابتة رتّب()
        ترتيب_تنقل._العناصر.رتّب(دالة(أ، ب)
            ارجع أ["الترتيب"] - ب["الترتيب"]
        نهاية)
    نهاية
    
    دالة ثابتة طبّق()
        ترتيب_تنقل.رتّب()
        لكل فهرس، عنصر في ترتيب_تنقل._العناصر
            عنصر["العنصر"].فهرس_تنقل = فهرس + 1
        نهاية
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# ثيم إمكانية الوصول
# ═══════════════════════════════════════════════════════════════════════════

صنف ثيم_وصول
    
    دالة ثابتة ألوان_تباين_عالي()
        ارجع خريطة{
            "أساسي": "#000000"،
            "على_أساسي": "#FFFFFF"،
            "ثانوي": "#FFFF00"،
            "على_ثانوي": "#000000"،
            "خلفية": "#FFFFFF"،
            "على_خلفية": "#000000"،
            "سطح": "#FFFFFF"،
            "على_سطح": "#000000"،
            "خطأ": "#FF0000"،
            "على_خطأ": "#FFFFFF"
        }
    نهاية
    
    دالة ثابتة طبّق_تباين_عالي(الثيم)
        إذا (إعدادات_وصول.تباين_عالي())
            ارجع الثيم.بألوان(ثيم_وصول.ألوان_تباين_عالي())
        نهاية
        ارجع الثيم
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# تجميع التركيز
# ═══════════════════════════════════════════════════════════════════════════

دالة مجموعة_تركيز(الأبناء، التسمية = "")
    # تجميع عناصر للتنقل كوحدة واحدة
    ارجع حاوية(الأبناء)
        .بدلالات(
            جديد دلالات()
                .تسمية(التسمية)
                .يخفي_أبناء()
                .بناء()
        )
نهاية

دالة خارج_التركيز(العنصر)
    # إخفاء عنصر من التنقل بإمكانية الوصول
    ارجع العنصر.بدلالات(
        جديد دلالات()
            .مخفي()
            .بناء()
    )
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# حركات مناسبة
# ═══════════════════════════════════════════════════════════════════════════

دالة حركة_آمنة(الحركة)
    # تعطيل الحركة إذا كان المستخدم يفضل تقليل الحركة
    إذا (إعدادات_وصول.تقليل_الحركة())
        ارجع لا_شيء
    نهاية
    ارجع الحركة
نهاية

دالة مدة_حركة_آمنة(المدة)
    إذا (إعدادات_وصول.تقليل_الحركة())
        ارجع 0
    نهاية
    ارجع المدة
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# فاحص إمكانية الوصول
# ═══════════════════════════════════════════════════════════════════════════

صنف فاحص_وصول
    
    دالة ثابتة افحص(العنصر)
        متغير المشاكل = []
        
        # فحص التباين
        متغير نسبة_التباين = فاحص_وصول._احسب_تباين(
            العنصر.لون_النص،
            العنصر.لون_الخلفية
        )
        
        إذا (نسبة_التباين < 4.5)
            المشاكل.أضف(خريطة{
                "النوع": "تباين_منخفض"،
                "الرسالة": "نسبة التباين (" + نسبة_التباين + ") أقل من 4.5:1"،
                "WCAG": "1.4.3"
            })
        نهاية
        
        # فحص النص البديل للصور
        إذا (العنصر.نوع == "صورة" و العنصر.وصف == لا_شيء)
            المشاكل.أضف(خريطة{
                "النوع": "بدون_وصف"،
                "الرسالة": "الصورة بدون وصف نصي"،
                "WCAG": "1.1.1"
            })
        نهاية
        
        # فحص حجم اللمس
        إذا (العنصر.تفاعلي)
            إذا (العنصر.عرض < 44 أو العنصر.ارتفاع < 44)
                المشاكل.أضف(خريطة{
                    "النوع": "حجم_لمس_صغير"،
                    "الرسالة": "حجم منطقة اللمس أقل من 44x44 بكسل"،
                    "WCAG": "2.5.5"
                })
            نهاية
        نهاية
        
        # فحص التسمية للحقول
        إذا (العنصر.نوع == "حقل_نص" و العنصر.تسمية == لا_شيء)
            المشاكل.أضف(خريطة{
                "النوع": "حقل_بدون_تسمية"،
                "الرسالة": "حقل النص بدون تسمية"،
                "WCAG": "1.3.1"
            })
        نهاية
        
        ارجع المشاكل
    نهاية
    
    دالة ثابتة افحص_الشاشة(العناصر)
        متغير كل_المشاكل = []
        
        لكل عنصر في العناصر
            متغير مشاكل_عنصر = فاحص_وصول.افحص(عنصر)
            كل_المشاكل = كل_المشاكل.دمج(مشاكل_عنصر)
        نهاية
        
        ارجع كل_المشاكل
    نهاية
    
    دالة ثابتة _احسب_تباين(لون1، لون2)
        متغير نصوع1 = فاحص_وصول._نصوع(لون1)
        متغير نصوع2 = فاحص_وصول._نصوع(لون2)
        
        متغير أفتح = أقصى(نصوع1، نصوع2)
        متغير أغمق = أدنى(نصوع1، نصوع2)
        
        ارجع (أفتح + 0.05) / (أغمق + 0.05)
    نهاية
    
    دالة ثابتة _نصوع(اللون)
        # تحويل hex إلى RGB ثم حساب النصوع النسبي
        متغير ر = فاحص_وصول._قيمة_لون(اللون، 0)
        متغير خ = فاحص_وصول._قيمة_لون(اللون، 1)
        متغير ز = فاحص_وصول._قيمة_لون(اللون، 2)
        
        ارجع 0.2126 * ر + 0.7152 * خ + 0.0722 * ز
    نهاية
    
    دالة ثابتة _قيمة_لون(اللون، الفهرس)
        متغير قيمة = من_سداسي_عشر(اللون، الفهرس) / 255
        
        إذا (قيمة <= 0.03928)
            ارجع قيمة / 12.92
        وإلا
            ارجع ((قيمة + 0.055) / 1.055) ** 2.4
        نهاية
    نهاية
نهاية

