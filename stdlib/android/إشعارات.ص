# ═══════════════════════════════════════════════════════════════════════════
# الإشعار
# ═══════════════════════════════════════════════════════════════════════════

صنف إشعار
    متغير المعرف = 0
    متغير القناة = ""
    متغير العنوان = ""
    متغير المحتوى = ""
    متغير الأيقونة = ""
    متغير الأيقونة_الكبيرة = ""
    متغير الصورة = ""
    متغير اللون = ""
    متغير النمط = نمط_إشعار.افتراضي
    متغير الإجراءات = []
    متغير البيانات = خريطة{}
    متغير التقدم = لا_شيء      # للإشعارات ذات التقدم
    متغير مستمر = خطأ          # لا يمكن مسحه
    متغير تلقائي_الإغلاق = صحيح
    متغير الوقت = لا_شيء       # للجدولة
    متغير مجموعة = ""
    متغير ملخص_مجموعة = خطأ
    
    باني(العنوان، المحتوى = "")
        هذا.المعرف = توليد_معرف_عشوائي()
        هذا.العنوان = العنوان
        هذا.المحتوى = المحتوى
    نهاية
    
    دالة بقناة(المعرف)
        هذا.القناة = المعرف
        ارجع هذا
    نهاية
    
    دالة بأيقونة(المسار)
        هذا.الأيقونة = المسار
        ارجع هذا
    نهاية
    
    دالة بأيقونة_كبيرة(المسار)
        هذا.الأيقونة_الكبيرة = المسار
        ارجع هذا
    نهاية
    
    دالة بصورة(المسار)
        هذا.الصورة = المسار
        هذا.النمط = نمط_إشعار.صورة
        ارجع هذا
    نهاية
    
    دالة بلون(اللون)
        هذا.اللون = اللون
        ارجع هذا
    نهاية
    
    دالة نص_كبير(النص)
        هذا.المحتوى = النص
        هذا.النمط = نمط_إشعار.نص_كبير
        ارجع هذا
    نهاية
    
    دالة صندوق_وارد(الأسطر)
        هذا.البيانات["أسطر"] = الأسطر
        هذا.النمط = نمط_إشعار.صندوق_وارد
        ارجع هذا
    نهاية
    
    دالة بتقدم(الحالي، الأقصى، غير_محدد = خطأ)
        هذا.التقدم = خريطة{
            "الحالي": الحالي،
            "الأقصى": الأقصى،
            "غير_محدد": غير_محدد
        }
        هذا.النمط = نمط_إشعار.تقدم
        ارجع هذا
    نهاية
    
    دالة مستمرة()
        هذا.مستمر = صحيح
        هذا.تلقائي_الإغلاق = خطأ
        ارجع هذا
    نهاية
    
    دالة أضف_إجراء(إجراء)
        هذا.الإجراءات.أضف(إجراء)
        ارجع هذا
    نهاية
    
    دالة ببيانات(البيانات)
        هذا.البيانات = البيانات
        ارجع هذا
    نهاية
    
    دالة في_مجموعة(المعرف، ملخص = خطأ)
        هذا.مجموعة = المعرف
        هذا.ملخص_مجموعة = ملخص
        ارجع هذا
    نهاية
    
    دالة جدول(الوقت)
        هذا.الوقت = الوقت
        ارجع هذا
    نهاية
    
    دالة غير_متزامنة أظهر()
        إذا (هذا.الوقت != لا_شيء)
            ارجع انتظر جدول_إشعار(هذا)
        نهاية
        ارجع انتظر أظهر_إشعار(هذا)
    نهاية
    
    دالة ألغِ()
        ألغِ_إشعار(هذا.المعرف)
    نهاية
    
    دالة حدّث()
        حدّث_إشعار(هذا)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# مدير الإشعارات
# ═══════════════════════════════════════════════════════════════════════════

صنف مدير_إشعارات
    ثابت _قنوات = خريطة{}
    ثابت _معالج_فتح = لا_شيء
    ثابت _معالج_إجراء = لا_شيء
    ثابت رمز_fcm = ""
    
    # ─────────────────────────────────────────────────────────────────────
    # القنوات
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة سجّل_قناة(قناة)
        مدير_إشعارات._قنوات[قناة.المعرف] = قناة
        قناة.سجّل()
    نهاية
    
    دالة ثابتة احذف_قناة(المعرف)
        احذف مدير_إشعارات._قنوات[المعرف]
        أصلي_احذف_قناة(المعرف)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # معالجات الأحداث
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة عند_فتح_إشعار(المعالج)
        مدير_إشعارات._معالج_فتح = المعالج
        أصلي_استمع_فتح_إشعار(دالة(البيانات)
            المعالج(البيانات)
        نهاية)
    نهاية
    
    دالة ثابتة عند_إجراء(المعالج)
        مدير_إشعارات._معالج_إجراء = المعالج
        أصلي_استمع_إجراء_إشعار(دالة(معرف_الإجراء، البيانات، النص_المدخل)
            المعالج(معرف_الإجراء، البيانات، النص_المدخل)
        نهاية)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # FCM (Firebase Cloud Messaging)
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة هيئ_fcm()
        مدير_إشعارات.رمز_fcm = انتظر أصلي_احصل_رمز_fcm()
        ارجع مدير_إشعارات.رمز_fcm
    نهاية
    
    دالة ثابتة عند_رسالة_fcm(المعالج)
        أصلي_استمع_رسائل_fcm(دالة(الرسالة)
            المعالج(خريطة{
                "العنوان": الرسالة["notification"]["title"]،
                "المحتوى": الرسالة["notification"]["body"]،
                "البيانات": الرسالة["data"]
            })
        نهاية)
    نهاية
    
    دالة ثابتة غير_متزامنة اشترك_في_موضوع(الموضوع)
        انتظر أصلي_اشترك_fcm(الموضوع)
    نهاية
    
    دالة ثابتة غير_متزامنة ألغِ_اشتراك_موضوع(الموضوع)
        انتظر أصلي_ألغِ_اشتراك_fcm(الموضوع)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # الصلاحيات
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة اطلب_إذن()
        ارجع انتظر أصلي_اطلب_إذن_إشعارات()
    نهاية
    
    دالة ثابتة غير_متزامنة حالة_الإذن()
        ارجع انتظر أصلي_حالة_إذن_إشعارات()
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # إدارة الإشعارات
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة ألغِ_الكل()
        أصلي_ألغِ_كل_الإشعارات()
    نهاية
    
    دالة ثابتة ألغِ(المعرف)
        ألغِ_إشعار(المعرف)
    نهاية
    
    دالة ثابتة غير_متزامنة الإشعارات_النشطة()
        ارجع انتظر أصلي_الإشعارات_النشطة()
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# الخدمات الخلفية
# ═══════════════════════════════════════════════════════════════════════════

صنف خدمة_خلفية
    متغير المعرف = ""
    متغير العنوان = ""
    متغير الوصف = ""
    متغير _مشغلة = خطأ
    متغير _معالج_بدء = لا_شيء
    متغير _معالج_إيقاف = لا_شيء
    
    باني(المعرف)
        هذا.المعرف = المعرف
    نهاية
    
    دالة بعنوان(العنوان)
        هذا.العنوان = العنوان
        ارجع هذا
    نهاية
    
    دالة بوصف(الوصف)
        هذا.الوصف = الوصف
        ارجع هذا
    نهاية
    
    دالة عند_البدء(المعالج)
        هذا._معالج_بدء = المعالج
        ارجع هذا
    نهاية
    
    دالة عند_الإيقاف(المعالج)
        هذا._معالج_إيقاف = المعالج
        ارجع هذا
    نهاية
    
    دالة غير_متزامنة ابدأ()
        إذا (هذا._مشغلة)
            ارجع
        نهاية
        
        هذا._مشغلة = صحيح
        
        # إنشاء إشعار للخدمة (مطلوب في Android 8+)
        متغير إشعار_الخدمة = جديد إشعار(هذا.العنوان، هذا.الوصف)
            .مستمرة()
            .بقناة("خدمات")
        
        انتظر أصلي_ابدأ_خدمة_أمامية(هذا.المعرف، إشعار_الخدمة)
        
        إذا (هذا._معالج_بدء != لا_شيء)
            هذا._معالج_بدء()
        نهاية
    نهاية
    
    دالة أوقف()
        إذا (ليس هذا._مشغلة)
            ارجع
        نهاية
        
        هذا._مشغلة = خطأ
        أصلي_أوقف_خدمة_أمامية(هذا.المعرف)
        
        إذا (هذا._معالج_إيقاف != لا_شيء)
            هذا._معالج_إيقاف()
        نهاية
    نهاية
    
    دالة مشغلة()
        ارجع هذا._مشغلة
    نهاية
نهاية

