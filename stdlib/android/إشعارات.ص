    دالة بوسم(الوسم)
        هذا.الوسوم.أضف(الوسم)
        ارجع هذا
    نهاية
    
    دالة المنفذ(الدالة)
        هذا._المنفذ = الدالة
        ارجع هذا
    نهاية
    
    دالة بدون_استبدال()
        هذا.استبدال = خطأ
        ارجع هذا
    نهاية
    
    دالة بدون_إعادة_محاولة()
        هذا.إعادة_المحاولة = خطأ
        ارجع هذا
    نهاية
    
    دالة غير_متزامنة جدول()
        ارجع انتظر أصلي_جدول_مهمة(هذا)
    نهاية
    
    دالة ألغِ()
        أصلي_ألغِ_مهمة(هذا.المعرف)
    نهاية
نهاية

# مدير المهام
صنف مدير_مهام
    ثابت _مهام = خريطة{}
    ثابت _منفذات = خريطة{}
    
    دالة ثابتة سجّل_منفذ(معرف_المهمة، المنفذ)
        مدير_مهام._منفذات[معرف_المهمة] = المنفذ
    نهاية
    
    دالة ثابتة غير_متزامنة جدول(المهمة)
        مدير_مهام._مهام[المهمة.المعرف] = المهمة
        
        # تسجيل المنفذ
        إذا (المهمة._المنفذ != لا_شيء)
            مدير_مهام.سجّل_منفذ(المهمة.المعرف، المهمة._المنفذ)
        نهاية
        
        انتظر المهمة.جدول()
    نهاية
    
    دالة ثابتة ألغِ(المعرف)
        إذا (مدير_مهام._مهام[المعرف] != لا_شيء)
            مدير_مهام._مهام[المعرف].ألغِ()
            احذف مدير_مهام._مهام[المعرف]
        نهاية
    نهاية
    
    دالة ثابتة ألغِ_بوسم(الوسم)
        أصلي_ألغِ_مهام_بوسم(الوسم)
    نهاية
    
    دالة ثابتة ألغِ_الكل()
        أصلي_ألغِ_كل_المهام()
        مدير_مهام._مهام = خريطة{}
    نهاية
    
    دالة ثابتة غير_متزامنة حالة(المعرف)
        ارجع انتظر أصلي_حالة_مهمة(المعرف)
    نهاية
نهاية

# استقبال تنفيذ المهام من النظام
أصلي_استمع_تنفيذ_مهمة(دالة(معرف_المهمة، البيانات) غير_متزامنة
    متغير المنفذ = مدير_مهام._منفذات[معرف_المهمة]
    
    إذا (المنفذ != لا_شيء)
        حاول
            متغير النتيجة = انتظر المنفذ(البيانات)
            أصلي_نتيجة_مهمة(معرف_المهمة، صحيح، النتيجة)
        امسك خطأ
            أصلي_نتيجة_مهمة(معرف_المهمة، خطأ، خطأ.رسالة)
        نهاية
    نهاية
نهاية)

