# التخزين الآمن
# ═══════════════════════════════════════════════════════════════════════════

صنف تخزين_آمن
    باني()
        # استخدام Android Keystore
    نهاية
    
    دالة احفظ(المفتاح، القيمة)
        ارجع وعد(دالة(نجح، فشل)
            # تشفير وحفظ
            نجح()
        نهاية)
    نهاية
    
    دالة اقرأ(المفتاح)
        ارجع وعد(دالة(نجح، فشل)
            # قراءة وفك التشفير
            نجح(لا_شيء)
        نهاية)
    نهاية
    
    دالة احذف(المفتاح)
        ارجع وعد(دالة(نجح، فشل)
