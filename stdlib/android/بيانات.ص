# ═══════════════════════════════════════════════════════════════════════════
# التفاعلية (Reactive)
# ═══════════════════════════════════════════════════════════════════════════

صنف استعلام_حي
    متغير الاستعلام
    متغير المراقبون
    متغير آخر_نتيجة
    
    باني(الاستعلام)
        هذا.الاستعلام = الاستعلام
        هذا.المراقبون = []
        هذا.آخر_نتيجة = []
    نهاية
    
    دالة راقب(معالج)
        هذا.المراقبون.أضف(معالج)
        
        # إرسال النتيجة الحالية فوراً
        إذا (هذا.آخر_نتيجة.الطول() > 0)
            معالج(هذا.آخر_نتيجة)
        نهاية
        
        # إرجاع دالة إلغاء الاشتراك
        ارجع دالة()
            هذا.المراقبون = هذا.المراقبون.صفّي(دالة(م) ارجع م != معالج نهاية)
        نهاية
    نهاية
    
    دالة أعد_التنفيذ()
        هذا.الاستعلام.نفّذ().ثم(دالة(نتائج)
            هذا.آخر_نتيجة = نتائج
            
            لكل مراقب في هذا.المراقبون
                مراقب(نتائج)
            نهاية
        نهاية)
    نهاية
نهاية

دالة استعلام_تفاعلي(الجدول)
    ارجع استعلام_حي(الجدول.استعلام())
نهاية

