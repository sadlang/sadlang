# ═══════════════════════════════════════════════════════════════════════════

صنف نسخ_احتياطي
    متغير قاعدة_البيانات
    متغير الوجهات
    
    باني(قاعدة_البيانات، الإعدادات)
        هذا.قاعدة_البيانات = قاعدة_البيانات
        هذا.الوجهات = الإعدادات["الوجهات"] أو []
    نهاية
    
    دالة انسخ_الآن()
        ارجع وعد(دالة(نجح، فشل)
            متغير البيانات = هذا.قاعدة_البيانات.صدّر()
            
            لكل وجهة في هذا.الوجهات
                وجهة.احفظ(البيانات)
            نهاية
            
            نجح()
        نهاية)
    نهاية
    
    دالة استعد(مصدر)
        ارجع وعد(دالة(نجح، فشل)
            متغير البيانات = مصدر.اقرأ()
            هذا.قاعدة_البيانات.استورد(البيانات)
            نجح()
        نهاية)
    نهاية
    
    دالة جدولة(فترة)
        # جدولة نسخ تلقائي
        # فترة: "يومي"، "أسبوعي"، "شهري"
    نهاية
    
    دالة قائمة_النسخ()
        ارجع وعد(دالة(نجح، فشل)
            نجح([])
        نهاية)
    نهاية
نهاية

