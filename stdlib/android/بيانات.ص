# قاعدة البيانات المحلية
# ═══════════════════════════════════════════════════════════════════════════

صنف قاعدة_بيانات
    متغير الاسم
    متغير الإصدار
    متغير مشفرة
    متغير الجداول
    
    باني(الإعدادات)
        هذا.الاسم = الإعدادات["الاسم"]
        هذا.الإصدار = الإعدادات["الإصدار"] أو 1
        هذا.مشفرة = الإعدادات["مشفرة"] أو خطأ
        هذا.الجداول = {}
    نهاية
    
    دالة سجّل_جدول(الاسم، المخطط)
        هذا.الجداول[الاسم] = جدول(الاسم، المخطط)
        ارجع هذا.الجداول[الاسم]
    نهاية
    
    دالة جدول(الاسم)
        ارجع هذا.الجداول[الاسم]
    نهاية
    
    دالة افتح()
        ارجع وعد(دالة(نجح، فشل)
            # فتح قاعدة البيانات
            نجح(هذا)
        نهاية)
    نهاية
    
    دالة أغلق()
        # إغلاق قاعدة البيانات
    نهاية
    
    دالة امسح_الكل()
        لكل اسم في هذا.الجداول
            هذا.الجداول[اسم].امسح_الكل()
        نهاية
    نهاية
    
    دالة صدّر()
        # تصدير قاعدة البيانات كملف JSON
        ارجع {}
    نهاية
    
    دالة استورد(البيانات)
        # استيراد من JSON
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# الجداول والمخططات
# ═══════════════════════════════════════════════════════════════════════════

صنف مخطط
    متغير الحقول
    متغير الفهارس
    متغير العلاقات
    
    باني()
        هذا.الحقول = {}
        هذا.الفهارس = []
        هذا.العلاقات = []
    نهاية
    
    دالة حقل(الاسم، النوع، الخيارات)
        هذا.الحقول[الاسم] = {
            "النوع" = النوع،
            "مطلوب" = الخيارات["مطلوب"] أو خطأ،
            "فريد" = الخيارات["فريد"] أو خطأ،
            "افتراضي" = الخيارات["افتراضي"]،
            "تحقق" = الخيارات["تحقق"]
        }
        ارجع هذا
    نهاية
    
    دالة معرف()
        ارجع هذا.حقل("المعرف"، "uuid"، {"مطلوب" = صحيح، "فريد" = صحيح})
    نهاية
    
    دالة نص(الاسم، الخيارات)
        ارجع هذا.حقل(الاسم، "نص"، الخيارات أو {})
    نهاية
    
    دالة رقم(الاسم، الخيارات)
        ارجع هذا.حقل(الاسم، "رقم"، الخيارات أو {})
    نهاية
    
    دالة عشري(الاسم، الخيارات)
        ارجع هذا.حقل(الاسم، "عشري"، الخيارات أو {})
    نهاية
    
    دالة منطقي(الاسم، الخيارات)
        ارجع هذا.حقل(الاسم، "منطقي"، الخيارات أو {})
    نهاية
    
    دالة تاريخ(الاسم، الخيارات)
        ارجع هذا.حقل(الاسم، "تاريخ"، الخيارات أو {})
    نهاية
    
    دالة قائمة(الاسم، نوع_العناصر، الخيارات)
        ارجع هذا.حقل(الاسم، "قائمة:" + نوع_العناصر، الخيارات أو {})
    نهاية
    
    دالة كائن(الاسم، المخطط_الفرعي، الخيارات)
        ارجع هذا.حقل(الاسم، "كائن"، {
            "المخطط" = المخطط_الفرعي،
            ...الخيارات
        })
    نهاية
    
    دالة فهرس(الحقول)
        هذا.الفهارس.أضف(الحقول)
        ارجع هذا
    نهاية
    
    دالة علاقة_واحد(الاسم، الجدول_الهدف، الخيارات)
        هذا.العلاقات.أضف({
            "الاسم" = الاسم،
            "النوع" = "واحد"،
            "الهدف" = الجدول_الهدف،
            "عكسية" = الخيارات["عكسية"]
        })
        ارجع هذا
    نهاية
    
    دالة علاقة_متعدد(الاسم، الجدول_الهدف، الخيارات)
        هذا.العلاقات.أضف({
            "الاسم" = الاسم،
            "النوع" = "متعدد"،
            "الهدف" = الجدول_الهدف،
            "عكسية" = الخيارات["عكسية"]
        })
        ارجع هذا
    نهاية
    
    دالة طابع_زمني()
        ارجع هذا
            .تاريخ("تاريخ_الإنشاء"، {"افتراضي" = "الآن"})
            .تاريخ("تاريخ_التحديث"، {"افتراضي" = "الآن"})
    نهاية
نهاية

صنف جدول
    متغير الاسم
    متغير المخطط
    متغير البيانات
    
    باني(الاسم، المخطط)
        هذا.الاسم = الاسم
        هذا.المخطط = المخطط
        هذا.البيانات = []
    نهاية
    
    دالة أنشئ(الكائن)
        # التحقق من المخطط
        إذا (!هذا.تحقق(الكائن))
            ارجع وعد_فاشل("بيانات غير صالحة")
        نهاية
        
        # إنشاء معرف إذا لم يكن موجوداً
        إذا (!الكائن["المعرف"])
            الكائن["المعرف"] = uuid_جديد()
        نهاية
        
        # إضافة الطوابع الزمنية
        الكائن["تاريخ_الإنشاء"] = الآن()
        الكائن["تاريخ_التحديث"] = الآن()
        
        ارجع وعد(دالة(نجح، فشل)
            هذا.البيانات.أضف(الكائن)
            نجح(الكائن)
        نهاية)
    نهاية
    
    دالة أنشئ_عديد(الكائنات)
        ارجع وعد.كل(الكائنات.خريطة(دالة(ك) ارجع هذا.أنشئ(ك) نهاية))
    نهاية
    
    دالة جد(المعرف)
        ارجع وعد(دالة(نجح، فشل)
            متغير النتيجة = هذا.البيانات.جد(دالة(ك) ارجع ك["المعرف"] == المعرف نهاية)
            نجح(النتيجة)
        نهاية)
    نهاية
    
    دالة جد_أول(الشرط)
        ارجع وعد(دالة(نجح، فشل)
            متغير النتيجة = هذا.البيانات.جد(دالة(ك) ارجع شرط(ك) نهاية)
            نجح(النتيجة)
        نهاية)
    نهاية
    
    دالة جد_كل(الشرط)
        ارجع وعد(دالة(نجح، فشل)
            متغير النتائج = هذا.البيانات.صفّي(دالة(ك) ارجع شرط(ك) نهاية)
            نجح(النتائج)
        نهاية)
    نهاية
    
    دالة الكل()
        ارجع وعد(دالة(نجح، فشل)
            نجح(هذا.البيانات)
        نهاية)
    نهاية
    
    دالة حدّث(المعرف، التغييرات)
        ارجع وعد(دالة(نجح، فشل)
            متغير الفهرس = هذا.البيانات.فهرس_أول(دالة(ك) ارجع ك["المعرف"] == المعرف نهاية)
            
            إذا (الفهرس >= 0)
                لكل مفتاح في التغييرات
                    هذا.البيانات[الفهرس][مفتاح] = التغييرات[مفتاح]
                نهاية
                هذا.البيانات[الفهرس]["تاريخ_التحديث"] = الآن()
                نجح(هذا.البيانات[الفهرس])
            وإلا
                فشل("غير موجود")
            نهاية
        نهاية)
    نهاية
    
    دالة احذف(المعرف)
        ارجع وعد(دالة(نجح، فشل)
            هذا.البيانات = هذا.البيانات.صفّي(دالة(ك) ارجع ك["المعرف"] != المعرف نهاية)
            نجح(صحيح)
        نهاية)
    نهاية
    
    دالة احذف_حيث(الشرط)
        هذا.البيانات = هذا.البيانات.صفّي(دالة(ك) ارجع !شرط(ك) نهاية)
    نهاية
    
    دالة امسح_الكل()
        هذا.البيانات = []
    نهاية
    
    دالة عدد()
        ارجع هذا.البيانات.الطول()
    نهاية
    
    دالة تحقق(الكائن)
        # التحقق من المخطط
        ارجع صحيح
    نهاية
    
    # استعلام متقدم
    دالة استعلام()
        ارجع استعلام_متقدم(هذا)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# الاستعلامات المتقدمة
# ═══════════════════════════════════════════════════════════════════════════

صنف استعلام_متقدم
    متغير الجدول
    متغير الشروط
    متغير الترتيب
    متغير الحد
    متغير التخطي
    متغير التضمين
    
    باني(الجدول)
        هذا.الجدول = الجدول
        هذا.الشروط = []
        هذا.الترتيب = لا_شيء
        هذا.الحد = لا_شيء
        هذا.التخطي = 0
        هذا.التضمين = []
    نهاية
    
    دالة حيث(الحقل، العامل، القيمة)
        هذا.الشروط.أضف({"الحقل" = الحقل، "العامل" = العامل، "القيمة" = القيمة})
        ارجع هذا
    نهاية
    
    دالة و(الحقل، العامل، القيمة)
        ارجع هذا.حيث(الحقل، العامل، القيمة)
    نهاية
    
    دالة أو(الحقل، العامل، القيمة)
        هذا.الشروط.أضف({"الحقل" = الحقل، "العامل" = العامل، "القيمة" = القيمة، "منطق" = "أو"})
        ارجع هذا
    نهاية
    
    دالة يساوي(الحقل، القيمة)
        ارجع هذا.حيث(الحقل، "=="، القيمة)
    نهاية
    
    دالة لا_يساوي(الحقل، القيمة)
        ارجع هذا.حيث(الحقل، "!="، القيمة)
    نهاية
    
    دالة أكبر_من(الحقل، القيمة)
        ارجع هذا.حيث(الحقل، ">"، القيمة)
    نهاية
    
    دالة أصغر_من(الحقل، القيمة)
        ارجع هذا.حيث(الحقل، "<"، القيمة)
    نهاية
    
    دالة بين(الحقل، من، إلى)
        ارجع هذا
            .حيث(الحقل، ">="، من)
            .حيث(الحقل، "<="، إلى)
    نهاية
    
    دالة يحتوي(الحقل، القيمة)
        ارجع هذا.حيث(الحقل، "يحتوي"، القيمة)
    نهاية
    
    دالة يبدأ_بـ(الحقل، القيمة)
        ارجع هذا.حيث(الحقل، "يبدأ"، القيمة)
    نهاية
    
    دالة ينتهي_بـ(الحقل، القيمة)
        ارجع هذا.حيث(الحقل، "ينتهي"، القيمة)
    نهاية
    
    دالة في_قائمة(الحقل، القائمة)
        ارجع هذا.حيث(الحقل، "في"، القائمة)
    نهاية
    
    دالة رتب_بـ(الحقل، الاتجاه)
        هذا.الترتيب = {"الحقل" = الحقل، "الاتجاه" = الاتجاه أو "تصاعدي"}
        ارجع هذا
    نهاية
    
    دالة رتب_تصاعدي(الحقل)
        ارجع هذا.رتب_بـ(الحقل، "تصاعدي")
    نهاية
    
    دالة رتب_تنازلي(الحقل)
        ارجع هذا.رتب_بـ(الحقل، "تنازلي")
    نهاية
    
    دالة خذ(العدد)
        هذا.الحد = العدد
        ارجع هذا
    نهاية
    
    دالة تخطَ(العدد)
        هذا.التخطي = العدد
        ارجع هذا
    نهاية
    
    دالة صفحة(رقم_الصفحة، حجم_الصفحة)
        هذا.التخطي = (رقم_الصفحة - 1) * حجم_الصفحة
        هذا.الحد = حجم_الصفحة
        ارجع هذا
    نهاية
    
    دالة ضمّن(علاقة)
        هذا.التضمين.أضف(علاقة)
        ارجع هذا
    نهاية
    
    دالة نفّذ()
        ارجع وعد(دالة(نجح، فشل)
            متغير نتائج = هذا.الجدول.البيانات
            
            # تطبيق الشروط
            لكل شرط في هذا.الشروط
                نتائج = نتائج.صفّي(دالة(ك)
                    ارجع هذا.طبّق_شرط(ك، شرط)
                نهاية)
            نهاية
            
            # تطبيق الترتيب
            إذا (هذا.الترتيب)
                نتائج = نتائج.رتب(دالة(أ، ب)
                    إذا (هذا.الترتيب.الاتجاه == "تصاعدي")
                        ارجع أ[هذا.الترتيب.الحقل] - ب[هذا.الترتيب.الحقل]
                    وإلا
                        ارجع ب[هذا.الترتيب.الحقل] - أ[هذا.الترتيب.الحقل]
                    نهاية
                نهاية)
            نهاية
            
            # تطبيق التخطي والحد
            إذا (هذا.التخطي > 0)
                نتائج = نتائج.شريحة(هذا.التخطي)
            نهاية
            
            إذا (هذا.الحد)
                نتائج = نتائج.شريحة(0، هذا.الحد)
            نهاية
            
            نجح(نتائج)
        نهاية)
    نهاية
    
    دالة طبّق_شرط(كائن، شرط)
        متغير القيمة = كائن[شرط.الحقل]
        متغير القيمة_المطلوبة = شرط.القيمة
        
        إذا (شرط.العامل == "==") ارجع القيمة == القيمة_المطلوبة نهاية
        إذا (شرط.العامل == "!=") ارجع القيمة != القيمة_المطلوبة نهاية
        إذا (شرط.العامل == ">") ارجع القيمة > القيمة_المطلوبة نهاية
        إذا (شرط.العامل == "<") ارجع القيمة < القيمة_المطلوبة نهاية
        إذا (شرط.العامل == ">=") ارجع القيمة >= القيمة_المطلوبة نهاية
        إذا (شرط.العامل == "<=") ارجع القيمة <= القيمة_المطلوبة نهاية
        إذا (شرط.العامل == "يحتوي") ارجع القيمة.يحتوي(القيمة_المطلوبة) نهاية
        إذا (شرط.العامل == "يبدأ") ارجع القيمة.يبدأ_بـ(القيمة_المطلوبة) نهاية
        إذا (شرط.العامل == "ينتهي") ارجع القيمة.ينتهي_بـ(القيمة_المطلوبة) نهاية
        إذا (شرط.العامل == "في") ارجع القيمة_المطلوبة.يحتوي(القيمة) نهاية
        
        ارجع صحيح
    نهاية
    
    دالة أول()
        ارجع هذا.خذ(1).نفّذ().ثم(دالة(نتائج) ارجع نتائج[0] نهاية)
    نهاية
    
    دالة عدد()
        ارجع هذا.نفّذ().ثم(دالة(نتائج) ارجع نتائج.الطول() نهاية)
    نهاية
نهاية

