#** حركة زنبركية (Spring) **#
صنف حركة_زنبركية
    متغير الهدف = 0
    متغير القيمة = 0
    متغير السرعة = 0
    متغير الصلابة = 180  # stiffness
    متغير التخميد = 12   # damping
    متغير الكتلة = 1
    متغير _المراقبون = []
    متغير _نشطة = خطأ
    متغير _العتبة = 0.001
    
    باني(القيمة_الأولية = 0، الصلابة = 180، التخميد = 12)
        هذا.القيمة = القيمة_الأولية
        هذا.الهدف = القيمة_الأولية
        هذا.الصلابة = الصلابة
        هذا.التخميد = التخميد
    نهاية
    
    #** تحريك إلى هدف جديد **#
    دالة حرّك_إلى(الهدف_الجديد)
        هذا.الهدف = الهدف_الجديد
        
        إذا (ليس هذا._نشطة)
            هذا._نشطة = صحيح
            __نظام_الحركات.سجل_فيزياء(هذا)
        نهاية
        
        ارجع هذا
    نهاية
    
    #** تحديث الفيزياء **#
    دالة حدّث(الدلتا)
        # معادلة الزنبرك: F = -kx - cv
        متغير الإزاحة = هذا.القيمة - هذا.الهدف
        متغير قوة_الزنبرك = -هذا.الصلابة * الإزاحة
        متغير قوة_التخميد = -هذا.التخميد * هذا.السرعة
        متغير التسارع = (قوة_الزنبرك + قوة_التخميد) / هذا.الكتلة
        
        هذا.السرعة = هذا.السرعة + التسارع * الدلتا
        هذا.القيمة = هذا.القيمة + هذا.السرعة * الدلتا
        
        # إشعار المراقبين
        لكل مراقب في هذا._المراقبون
            مراقب(هذا.القيمة)
        نهاية
        
        # التحقق من الاستقرار
        إذا (__قيمة_مطلقة(الإزاحة) < هذا._العتبة و __قيمة_مطلقة(هذا.السرعة) < هذا._العتبة)
            هذا.القيمة = هذا.الهدف
            هذا.السرعة = 0
            هذا._نشطة = خطأ
            ارجع خطأ
        نهاية
        
        ارجع صحيح
    نهاية
    
    دالة راقب(الدالة)
        هذا._المراقبون.أضف(الدالة)
        ارجع هذا
    نهاية

نهاية

#** حركة احتكاكية (Friction/Decay) **#
صنف حركة_احتكاكية
    متغير القيمة = 0
    متغير السرعة = 0
    متغير الاحتكاك = 0.95  # معامل الاحتكاك (0-1)
    متغير _المراقبون = []
    متغير _نشطة = خطأ
    متغير _العتبة = 0.01
    
    باني(القيمة_الأولية = 0، الاحتكاك = 0.95)
        هذا.القيمة = القيمة_الأولية
        هذا.الاحتكاك = الاحتكاك
    نهاية
    
    #** دفع بسرعة ابتدائية **#
    دالة ادفع(السرعة_الابتدائية)
        هذا.السرعة = السرعة_الابتدائية
        
        إذا (ليس هذا._نشطة)
            هذا._نشطة = صحيح
            __نظام_الحركات.سجل_فيزياء(هذا)
        نهاية
        
        ارجع هذا
    نهاية
    
    دالة حدّث(الدلتا)
        هذا.السرعة = هذا.السرعة * هذا.الاحتكاك
        هذا.القيمة = هذا.القيمة + هذا.السرعة * الدلتا
        
        لكل مراقب في هذا._المراقبون
            مراقب(هذا.القيمة)
        نهاية
        
        إذا (__قيمة_مطلقة(هذا.السرعة) < هذا._العتبة)
            هذا.السرعة = 0
            هذا._نشطة = خطأ
            ارجع خطأ
        نهاية
        
        ارجع صحيح
    نهاية
    
    دالة راقب(الدالة)
        هذا._المراقبون.أضف(الدالة)
        ارجع هذا
    نهاية

