# نظام إدارة الحركات المركزي
# ═══════════════════════════════════════════════════════════════════════════

صنف _نظام_الحركات_صنف
    متغير _الحركات = []
    متغير _حركات_الفيزياء = []
    متغير _نشط = خطأ
    متغير _وقت_سابق = 0
    
    دالة سجل(الحركة)
        هذا._الحركات.أضف(الحركة)
        
        إذا (ليس هذا._نشط)
            هذا._ابدأ_الحلقة()
        نهاية
    نهاية
    
    دالة احذف(الحركة)
        هذا._الحركات.احذف(الحركة)
    نهاية
    
    دالة سجل_فيزياء(الحركة)
        هذا._حركات_الفيزياء.أضف(الحركة)
        
        إذا (ليس هذا._نشط)
            هذا._ابدأ_الحلقة()
        نهاية
    نهاية
    
    دالة _ابدأ_الحلقة()
        هذا._نشط = صحيح
        هذا._وقت_سابق = __الآن()
        
        # بدء حلقة التحديث
        __طلب_إطار_حركة(دالة()
            هذا._حدّث_الإطار()
        نهاية)
    نهاية
    
    دالة _حدّث_الإطار()
        متغير الآن = __الآن()
        متغير الدلتا = (الآن - هذا._وقت_سابق) / 1000  # بالثواني
        هذا._وقت_سابق = الآن
        
        # تحديث الحركات العادية
        متغير حركات_نشطة = []
        لكل حركة في هذا._الحركات
            إذا (حركة.حدّث())
                حركات_نشطة.أضف(حركة)
            نهاية
        نهاية
        هذا._الحركات = حركات_نشطة
        
        # تحديث الحركات الفيزيائية
        متغير فيزياء_نشطة = []
        لكل حركة في هذا._حركات_الفيزياء
            إذا (حركة.حدّث(الدلتا))
                فيزياء_نشطة.أضف(حركة)
            نهاية
        نهاية
        هذا._حركات_الفيزياء = فيزياء_نشطة
        
        # استمرار الحلقة إذا هناك حركات نشطة
        إذا (هذا._الحركات.طول() > 0 أو هذا._حركات_الفيزياء.طول() > 0)
            __طلب_إطار_حركة(دالة()
                هذا._حدّث_الإطار()
            نهاية)
        وإلا
            هذا._نشط = خطأ
        نهاية
    نهاية

نهاية

