#** حركة لون **#
صنف حركة_لون
    متغير من_أحمر = 0
    متغير من_أخضر = 0
    متغير من_أزرق = 0
    متغير من_شفافية = 255
    
    متغير إلى_أحمر = 255
    متغير إلى_أخضر = 255
    متغير إلى_أزرق = 255
    متغير إلى_شفافية = 255
    
    متغير _حركة_داخلية = لا_شيء
    متغير اللون_الحالي = ""
    
    باني(من_لون، إلى_لون، المدة = 300)
        # تحليل الألوان
        هذا._حلل_لون(من_لون، "من")
        هذا._حلل_لون(إلى_لون، "إلى")
        
        هذا._حركة_داخلية = جديد حركة(0، 1، المدة)
        هذا._حركة_داخلية.راقب(دالة(القيمة، التقدم)
            هذا._حدّث_اللون(القيمة)
        نهاية)
    نهاية
    
    دالة _حلل_لون(اللون، البادئة)
        # تحليل لون hex مثل #RRGGBB أو #AARRGGBB
        # TODO: تنفيذ تحليل اللون
    نهاية
    
    دالة _حدّث_اللون(التقدم)
        متغير أحمر = هذا.من_أحمر + (هذا.إلى_أحمر - هذا.من_أحمر) * التقدم
        متغير أخضر = هذا.من_أخضر + (هذا.إلى_أخضر - هذا.من_أخضر) * التقدم
        متغير أزرق = هذا.من_أزرق + (هذا.إلى_أزرق - هذا.من_أزرق) * التقدم
        متغير شفافية = هذا.من_شفافية + (هذا.إلى_شفافية - هذا.من_شفافية) * التقدم
        
        هذا.اللون_الحالي = "#" + __إلى_hex(شفافية) + __إلى_hex(أحمر) + __إلى_hex(أخضر) + __إلى_hex(أزرق)
    نهاية
    
    دالة ابدأ()
        هذا._حركة_داخلية.ابدأ()
        ارجع هذا
    نهاية
    
    دالة راقب(الدالة)
        # ربط المراقب
        ارجع هذا
    نهاية

نهاية

#** حركة موضع (x, y) **#
صنف حركة_موضع
    متغير من_س = 0
    متغير من_ص = 0
    متغير إلى_س = 0
    متغير إلى_ص = 0
    متغير س_حالي = 0
    متغير ص_حالي = 0
    متغير _حركة_داخلية = لا_شيء
    متغير _المراقبون = []
    
    باني(من_س، من_ص، إلى_س، إلى_ص، المدة = 300)
        هذا.من_س = من_س
        هذا.من_ص = من_ص
        هذا.إلى_س = إلى_س
        هذا.إلى_ص = إلى_ص
        هذا.س_حالي = من_س
        هذا.ص_حالي = من_ص
        
        هذا._حركة_داخلية = جديد حركة(0، 1، المدة)
        هذا._حركة_داخلية.راقب(دالة(القيمة، التقدم)
            هذا.س_حالي = هذا.من_س + (هذا.إلى_س - هذا.من_س) * القيمة
            هذا.ص_حالي = هذا.من_ص + (هذا.إلى_ص - هذا.من_ص) * القيمة
            
            لكل مراقب في هذا._المراقبون
                مراقب(هذا.س_حالي، هذا.ص_حالي)
            نهاية
