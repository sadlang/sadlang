    نهاية
    
    دالة بمنحنى(المنحنى)
        هذا._حركة_داخلية.بمنحنى(المنحنى)
        ارجع هذا
    نهاية
    
    دالة ابدأ()
        هذا._حركة_داخلية.ابدأ()
        ارجع هذا
    نهاية
    
    دالة راقب(الدالة)
        هذا._المراقبون.أضف(الدالة)
