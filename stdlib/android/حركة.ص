#** حركات متتابعة (Sequence) **#
صنف حركة_متتابعة
    متغير _الحركات = []
    متغير _الفهرس_الحالي = 0
    متغير _دالة_الإكمال = لا_شيء
    
    باني()
        # فارغ
    نهاية
    
    #** إضافة حركة **#
    دالة ثم(الحركة)
        هذا._الحركات.أضف(الحركة)
        ارجع هذا
    نهاية
    
    #** إضافة تأخير **#
    دالة انتظر(المدة)
        متغير حركة_انتظار = جديد حركة(0، 0، المدة)
        هذا._الحركات.أضف(حركة_انتظار)
        ارجع هذا
    نهاية
    
    #** بدء التشغيل **#
    دالة ابدأ()
        هذا._الفهرس_الحالي = 0
        هذا._شغّل_التالية()
        ارجع هذا
    نهاية
    
    دالة _شغّل_التالية()
        إذا (هذا._الفهرس_الحالي >= هذا._الحركات.طول())
            # انتهت كل الحركات
            إذا (هذا._دالة_الإكمال != لا_شيء)
                هذا._دالة_الإكمال()
            نهاية
            ارجع
        نهاية
        
        متغير الحركة = هذا._الحركات[هذا._الفهرس_الحالي]
        الحركة.عند_الإكمال(دالة()
            هذا._الفهرس_الحالي = هذا._الفهرس_الحالي + 1
            هذا._شغّل_التالية()
        نهاية)
        
        الحركة.ابدأ()
    نهاية
    
    دالة عند_الإكمال(الدالة)
        هذا._دالة_الإكمال = الدالة
        ارجع هذا
    نهاية

نهاية

#** حركات متوازية (Parallel) **#
صنف حركة_متوازية
    متغير _الحركات = []
    متغير _المكتملة = 0
    متغير _دالة_الإكمال = لا_شيء
    
    باني()
        # فارغ
    نهاية
    
    #** إضافة حركة **#
    دالة مع(الحركة)
        هذا._الحركات.أضف(الحركة)
        ارجع هذا
    نهاية
    
    #** بدء جميع الحركات معاً **#
    دالة ابدأ()
        هذا._المكتملة = 0
        
        لكل حركة في هذا._الحركات
            حركة.عند_الإكمال(دالة()
                هذا._المكتملة = هذا._المكتملة + 1
                
                إذا (هذا._المكتملة >= هذا._الحركات.طول())
                    إذا (هذا._دالة_الإكمال != لا_شيء)
                        هذا._دالة_الإكمال()
                    نهاية
                نهاية
            نهاية)
            
            حركة.ابدأ()
        نهاية
        
        ارجع هذا
    نهاية
    
    دالة عند_الإكمال(الدالة)
        هذا._دالة_الإكمال = الدالة
        ارجع هذا
    نهاية

