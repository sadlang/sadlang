# منحنيات التسهيل (Easing Curves)
# ═══════════════════════════════════════════════════════════════════════════

#** منحنى تسهيل أساسي **#
صنف منحنى
    متغير الاسم = ""
    
    باني(الاسم)
        هذا.الاسم = الاسم
    نهاية
    
    دالة احسب(ت)
        ارجع ت  # خطي افتراضياً
    نهاية
نهاية

#** المنحنيات المدمجة **#
صنف _منحنيات
    متغير خطي = جديد منحنى("خطي")
    
    متغير سهل_للداخل = لا_شيء
    متغير سهل_للخارج = لا_شيء
    متغير سهل_للداخل_والخارج = لا_شيء
    
    متغير تربيعي_للداخل = لا_شيء
    متغير تربيعي_للخارج = لا_شيء
    
    متغير مرن = لا_شيء
    متغير ارتداد = لا_شيء
    
    باني()
        # Ease In
        هذا.سهل_للداخل = هذا._أنشئ_منحنى("سهل_للداخل"، دالة(ت)
            ارجع ت * ت
        نهاية)
        
        # Ease Out
        هذا.سهل_للخارج = هذا._أنشئ_منحنى("سهل_للخارج"، دالة(ت)
            ارجع 1 - (1 - ت) * (1 - ت)
        نهاية)
        
        # Ease In Out
        هذا.سهل_للداخل_والخارج = هذا._أنشئ_منحنى("سهل_للداخل_والخارج"، دالة(ت)
            إذا (ت < 0.5)
                ارجع 2 * ت * ت
            وإلا
                ارجع 1 - ((-2 * ت + 2) ** 2) / 2
            نهاية
        نهاية)
        
        # Cubic
        هذا.تربيعي_للداخل = هذا._أنشئ_منحنى("تربيعي_للداخل"، دالة(ت)
            ارجع ت * ت * ت
        نهاية)
        
        هذا.تربيعي_للخارج = هذا._أنشئ_منحنى("تربيعي_للخارج"، دالة(ت)
            ارجع 1 - (1 - ت) ** 3
        نهاية)
        
        # Elastic
        هذا.مرن = هذا._أنشئ_منحنى("مرن"، دالة(ت)
            إذا (ت == 0 أو ت == 1)
                ارجع ت
            نهاية
            ارجع (2 ** (-10 * ت)) * __جا((ت - 0.075) * (2 * __ط) / 0.3) + 1
        نهاية)
        
        # Bounce
        هذا.ارتداد = هذا._أنشئ_منحنى("ارتداد"، دالة(ت)
            متغير ن1 = 7.5625
            متغير د1 = 2.75
            
            إذا (ت < 1 / د1)
                ارجع ن1 * ت * ت
            والا_اذا (ت < 2 / د1)
                ت = ت - 1.5 / د1
                ارجع ن1 * ت * ت + 0.75
            والا_اذا (ت < 2.5 / د1)
                ت = ت - 2.25 / د1
                ارجع ن1 * ت * ت + 0.9375
            وإلا
                ت = ت - 2.625 / د1
                ارجع ن1 * ت * ت + 0.984375
            نهاية
        نهاية)
    نهاية
    
    دالة _أنشئ_منحنى(الاسم، دالة_الحساب)
        متغير م = جديد منحنى(الاسم)
        م.احسب = دالة_الحساب
        ارجع م
    نهاية
نهاية

متغير منحنيات = جديد _منحنيات()

# ═══════════════════════════════════════════════════════════════════════════
# الحركة الأساسية (Animation)
# ═══════════════════════════════════════════════════════════════════════════

#** حالات الحركة **#
متغير حالة_متوقفة = 0
متغير حالة_قيد_التشغيل = 1
متغير حالة_مكتملة = 2
متغير حالة_ملغاة = 3

#** حركة أساسية (Tween Animation) **#
صنف حركة
    متغير من = 0
    متغير إلى = 1
    متغير المدة = 300  # بالمللي ثانية
    متغير التأخير = 0
    متغير المنحنى = لا_شيء
    متغير الحالة = حالة_متوقفة
    متغير القيمة_الحالية = 0
    متغير التقدم = 0
    متغير _وقت_البدء = 0
    متغير _المراقبون = []
    متغير _دالة_الإكمال = لا_شيء
    متغير التكرار = 1
    متغير التكرار_الحالي = 0
    متغير عكس_تلقائي = خطأ
    متغير _معكوسة = خطأ
    
    باني(من = 0، إلى = 1، المدة = 300)
        هذا.من = من
        هذا.إلى = إلى
        هذا.المدة = المدة
        هذا.المنحنى = منحنيات.سهل_للداخل_والخارج
        هذا.القيمة_الحالية = من
    نهاية
    
    #** تعيين المنحنى **#
    دالة بمنحنى(المنحنى)
        هذا.المنحنى = المنحنى
        ارجع هذا
    نهاية
    
    #** تعيين التأخير **#
    دالة بتأخير(التأخير)
        هذا.التأخير = التأخير
        ارجع هذا
    نهاية
    
    #** تعيين التكرار **#
    دالة بتكرار(العدد، عكس = خطأ)
        هذا.التكرار = العدد
        هذا.عكس_تلقائي = عكس
        ارجع هذا
    نهاية
    
    #** تكرار لا نهائي **#
    دالة بتكرار_لا_نهائي(عكس = خطأ)
        هذا.التكرار = -1
        هذا.عكس_تلقائي = عكس
        ارجع هذا
    نهاية
    
    #** بدء الحركة **#
    دالة ابدأ()
        هذا.الحالة = حالة_قيد_التشغيل
        هذا._وقت_البدء = __الآن() + هذا.التأخير
        هذا.التكرار_الحالي = 0
        هذا._معكوسة = خطأ
        
        # تسجيل في نظام الحركات
        __نظام_الحركات.سجل(هذا)
        
        ارجع هذا
    نهاية
    
    #** إيقاف الحركة **#
    دالة أوقف()
        هذا.الحالة = حالة_متوقفة
        __نظام_الحركات.احذف(هذا)
    نهاية
    
    #** إلغاء الحركة **#
    دالة ألغِ()
        هذا.الحالة = حالة_ملغاة
        __نظام_الحركات.احذف(هذا)
    نهاية
    
    #** تحديث الحركة (يُستدعى من نظام الحركات) **#
    دالة حدّث()
        إذا (هذا.الحالة != حالة_قيد_التشغيل)
            ارجع خطأ
        نهاية
        
        متغير الآن = __الآن()
        
        # التحقق من التأخير
        إذا (الآن < هذا._وقت_البدء)
            ارجع صحيح
        نهاية
        
        # حساب التقدم
        متغير الوقت_المنقضي = الآن - هذا._وقت_البدء
        هذا.التقدم = الوقت_المنقضي / هذا.المدة
        
        إذا (هذا.التقدم >= 1)
            هذا.التقدم = 1
        نهاية
        
        # تطبيق المنحنى
        متغير تقدم_معدل = هذا.التقدم
        إذا (هذا.المنحنى != لا_شيء)
            تقدم_معدل = هذا.المنحنى.احسب(هذا.التقدم)
        نهاية
        
        # عكس إذا لزم
        إذا (هذا._معكوسة)
            تقدم_معدل = 1 - تقدم_معدل
        نهاية
        
        # حساب القيمة
        هذا.القيمة_الحالية = هذا.من + (هذا.إلى - هذا.من) * تقدم_معدل
        
        # إشعار المراقبين
        هذا._أشعر_المراقبين()
        
        # التحقق من الإكمال
        إذا (هذا.التقدم >= 1)
            ارجع هذا._عالج_الإكمال()
        نهاية
        
        ارجع صحيح
    نهاية
    
    #** معالجة إكمال دورة واحدة **#
    دالة _عالج_الإكمال()
        هذا.التكرار_الحالي = هذا.التكرار_الحالي + 1
        
        # تكرار لا نهائي
        إذا (هذا.التكرار == -1)
            إذا (هذا.عكس_تلقائي)
                هذا._معكوسة = ليس هذا._معكوسة
            نهاية
            هذا._وقت_البدء = __الآن()
            هذا.التقدم = 0
            ارجع صحيح
        نهاية
        
        # تكرار محدود
        إذا (هذا.التكرار_الحالي < هذا.التكرار)
            إذا (هذا.عكس_تلقائي)
                هذا._معكوسة = ليس هذا._معكوسة
            نهاية
            هذا._وقت_البدء = __الآن()
            هذا.التقدم = 0
            ارجع صحيح
        نهاية
        
        # انتهت الحركة
        هذا.الحالة = حالة_مكتملة
        
        إذا (هذا._دالة_الإكمال != لا_شيء)
            هذا._دالة_الإكمال()
        نهاية
        
        ارجع خطأ
    نهاية
    
    #** إضافة مراقب **#
    دالة راقب(دالة_المراقبة)
        هذا._المراقبون.أضف(دالة_المراقبة)
        ارجع هذا
    نهاية
    
    #** عند الإكمال **#
    دالة عند_الإكمال(الدالة)
        هذا._دالة_الإكمال = الدالة
        ارجع هذا
    نهاية
    
    #** إشعار المراقبين **#
    دالة _أشعر_المراقبين()
        لكل مراقب في هذا._المراقبون
            مراقب(هذا.القيمة_الحالية، هذا.التقدم)
        نهاية
    نهاية

نهاية

