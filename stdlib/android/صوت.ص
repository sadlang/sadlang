        نهاية
        
        # رد صوتي
        هذا.قل("نعم، كيف يمكنني مساعدتك؟")
        
        # مهلة انتظار الأمر
        بعد(5000، دالة()
            إذا (هذا._ينتظر_أمر)
                هذا._ينتظر_أمر = خطأ
                هذا.قل("حسناً، أخبرني إذا احتجت شيئاً")
            نهاية
