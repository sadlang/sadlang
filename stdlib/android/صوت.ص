# ═══════════════════════════════════════════════════════════════════════════
# إعدادات الأوامر الصوتية
# ═══════════════════════════════════════════════════════════════════════════

صنف لهجة_عربية
    ثابت فصحى = "ar-SA"
    ثابت مصرية = "ar-EG"
    ثابت خليجية = "ar-AE"
    ثابت شامية = "ar-SY"
    ثابت مغربية = "ar-MA"
    ثابت عراقية = "ar-IQ"
    ثابت سعودية = "ar-SA"
    ثابت إماراتية = "ar-AE"
    ثابت أردنية = "ar-JO"
    ثابت لبنانية = "ar-LB"
نهاية

صنف إعدادات_صوت
    ثابت _اللهجة = لهجة_عربية.فصحى
    ثابت _مستمر = خطأ
    ثابت _كلمة_تنشيط = "يا تطبيق"
    ثابت _مهلة_صمت = 2000
    ثابت _نتائج_جزئية = صحيح
    
    دالة ثابتة اللهجة()
        ارجع إعدادات_صوت._اللهجة
    نهاية
    
    دالة ثابتة عيّن_لهجة(اللهجة)
        إعدادات_صوت._اللهجة = اللهجة
    نهاية
    
    دالة ثابتة كلمة_التنشيط()
        ارجع إعدادات_صوت._كلمة_تنشيط
    نهاية
    
    دالة ثابتة عيّن_كلمة_تنشيط(الكلمة)
        إعدادات_صوت._كلمة_تنشيط = الكلمة
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# محرك التعرف على الكلام
# ═══════════════════════════════════════════════════════════════════════════

صنف معرّف_كلام
    متغير _اللهجة = لهجة_عربية.فصحى
    متغير _مستمع_نتائج = لا_شيء
    متغير _مستمع_جزئي = لا_شيء
    متغير _مستمع_خطأ = لا_شيء
    متغير _مستمع_بدء = لا_شيء
    متغير _مستمع_انتهاء = لا_شيء
    متغير _مستمر = خطأ
    متغير _يستمع = خطأ
    
    باني(اللهجة = لهجة_عربية.فصحى)
        هذا._اللهجة = اللهجة
    نهاية
    
    دالة بلهجة(اللهجة)
        هذا._اللهجة = اللهجة
        ارجع هذا
    نهاية
    
    دالة مستمر()
        هذا._مستمر = صحيح
        ارجع هذا
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # المستمعين
    # ─────────────────────────────────────────────────────────────────────
    
    دالة عند_نتيجة(المعالج)
        هذا._مستمع_نتائج = المعالج
        ارجع هذا
    نهاية
    
    دالة عند_نتيجة_جزئية(المعالج)
        هذا._مستمع_جزئي = المعالج
        ارجع هذا
    نهاية
    
    دالة عند_خطأ(المعالج)
        هذا._مستمع_خطأ = المعالج
        ارجع هذا
    نهاية
    
    دالة عند_البدء(المعالج)
        هذا._مستمع_بدء = المعالج
        ارجع هذا
    نهاية
    
    دالة عند_الانتهاء(المعالج)
        هذا._مستمع_انتهاء = المعالج
        ارجع هذا
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # التشغيل
    # ─────────────────────────────────────────────────────────────────────
    
    دالة غير_متزامنة ابدأ()
        إذا (هذا._يستمع)
            ارجع خطأ
        نهاية
        
        # التحقق من الصلاحيات
        متغير لديه_صلاحية = انتظر أصلي_تحقق_صلاحية_ميكروفون()
        إذا (ليس لديه_صلاحية)
            لديه_صلاحية = انتظر أصلي_اطلب_صلاحية_ميكروفون()
            إذا (ليس لديه_صلاحية)
                إذا (هذا._مستمع_خطأ != لا_شيء)
                    هذا._مستمع_خطأ("لا توجد صلاحية الميكروفون")
                نهاية
                ارجع خطأ
            نهاية
        نهاية
        
        هذا._يستمع = صحيح
        
        إذا (هذا._مستمع_بدء != لا_شيء)
            هذا._مستمع_بدء()
        نهاية
        
        متغير ذات = هذا
        
        انتظر أصلي_ابدأ_تعرف_كلام(خريطة{
            "اللغة": هذا._اللهجة،
            "مستمر": هذا._مستمر،
            "نتائج_جزئية": صحيح،
            "عند_نتيجة": دالة(النص، نهائي)
                إذا (نهائي)
                    إذا (ذات._مستمع_نتائج != لا_شيء)
                        ذات._مستمع_نتائج(النص)
                    نهاية
                وإلا
                    إذا (ذات._مستمع_جزئي != لا_شيء)
                        ذات._مستمع_جزئي(النص)
                    نهاية
                نهاية
            نهاية،
            "عند_خطأ": دالة(الخطأ)
                ذات._يستمع = خطأ
                إذا (ذات._مستمع_خطأ != لا_شيء)
                    ذات._مستمع_خطأ(الخطأ)
                نهاية
            نهاية،
            "عند_انتهاء": دالة()
                ذات._يستمع = خطأ
                إذا (ذات._مستمع_انتهاء != لا_شيء)
                    ذات._مستمع_انتهاء()
                نهاية
                
                # إعادة التشغيل إذا كان مستمراً
                إذا (ذات._مستمر)
                    ذات.ابدأ()
                نهاية
            نهاية
        })
        
        ارجع صحيح
    نهاية
    
    دالة أوقف()
        هذا._يستمع = خطأ
        هذا._مستمر = خطأ
        أصلي_أوقف_تعرف_كلام()
    نهاية
    
    دالة يستمع()
        ارجع هذا._يستمع
    نهاية
نهاية

# دالة مختصرة للتعرف لمرة واحدة
دالة غير_متزامنة استمع_للكلام(اللهجة = لهجة_عربية.فصحى)
    متغير وعد = جديد وعد()
    
    متغير معرّف = جديد معرّف_كلام(اللهجة)
        .عند_نتيجة(دالة(النص)
            وعد.حل(النص)
        نهاية)
        .عند_خطأ(دالة(الخطأ)
            وعد.رفض(الخطأ)
        نهاية)
    
    انتظر معرّف.ابدأ()
    
    ارجع انتظر وعد
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# نظام الأوامر الصوتية
# ═══════════════════════════════════════════════════════════════════════════

صنف أمر_صوتي
    متغير الأنماط = []
    متغير المعالج = لا_شيء
    متغير الوصف = ""
    متغير الفئة = "عام"
    متغير المتغيرات = []
    
    باني(الأنماط، المعالج)
        هذا.الأنماط = إذا (نوع(الأنماط) == "مصفوفة") ثم الأنماط وإلا [الأنماط]
        هذا.المعالج = المعالج
    نهاية
    
    دالة بوصف(الوصف)
        هذا.الوصف = الوصف
        ارجع هذا
    نهاية
    
    دالة بفئة(الفئة)
        هذا.الفئة = الفئة
        ارجع هذا
    نهاية
    
    دالة يطابق(النص)
        لكل نمط في هذا.الأنماط
            متغير النتيجة = هذا._طابق_نمط(نمط، النص)
            إذا (النتيجة != لا_شيء)
                ارجع النتيجة
            نهاية
        نهاية
        ارجع لا_شيء
    نهاية
    
    دالة _طابق_نمط(النمط، النص)
        # تحويل النمط إلى regex
        # {الاسم} = متغير
        # [اختياري] = جزء اختياري
        
        متغير regex = النمط
        متغير المتغيرات = []
        
        # استخراج المتغيرات
        متغير نمط_متغير = /\{(\w+)\}/g
        متغير مطابقة
        
        بينما ((مطابقة = نمط_متغير.exec(النمط)) != لا_شيء)
            المتغيرات.أضف(مطابقة[1])
            regex = regex.استبدل(مطابقة[0]، "(.+)")
        نهاية
        
        # الأجزاء الاختيارية
        regex = regex.استبدل("[", "(؟:")
        regex = regex.استبدل("]", ")?")
        
        # المطابقة
        متغير نتيجة = النص.طابق(جديد Regex("^" + regex + "$", "i"))
        
        إذا (نتيجة == لا_شيء)
            ارجع لا_شيء
        نهاية
        
        # بناء خريطة المتغيرات
        متغير خريطة_متغيرات = خريطة{}
        لكل فهرس، اسم في المتغيرات
            خريطة_متغيرات[اسم] = نتيجة[فهرس + 1]
        نهاية
        
        ارجع خريطة_متغيرات
    نهاية
    
    دالة نفّذ(المتغيرات)
        ارجع هذا.المعالج(المتغيرات)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# مدير الأوامر الصوتية
# ═══════════════════════════════════════════════════════════════════════════

صنف مدير_أوامر
    ثابت _الأوامر = []
    ثابت _نشط = خطأ
    ثابت _معرّف_كلام = لا_شيء
    ثابت _عند_أمر_غير_معروف = لا_شيء
    ثابت _عند_استماع = لا_شيء
    ثابت _عند_توقف = لا_شيء
    
    # ─────────────────────────────────────────────────────────────────────
    # تسجيل الأوامر
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة سجّل(أمر)
        مدير_أوامر._الأوامر.أضف(أمر)
    نهاية
    
    دالة ثابتة سجّل_أمر(الأنماط، المعالج)
        مدير_أوامر.سجّل(جديد أمر_صوتي(الأنماط، المعالج))
    نهاية
    
    دالة ثابتة أزل(الأمر)
        متغير الفهرس = مدير_أوامر._الأوامر.فهرس(الأمر)
        إذا (الفهرس >= 0)
            مدير_أوامر._الأوامر.احذف(الفهرس)
        نهاية
    نهاية
    
    دالة ثابتة امسح_الكل()
        مدير_أوامر._الأوامر = []
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # المعالجين
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة عند_أمر_غير_معروف(المعالج)
        مدير_أوامر._عند_أمر_غير_معروف = المعالج
    نهاية
    
    دالة ثابتة عند_الاستماع(المعالج)
        مدير_أوامر._عند_استماع = المعالج
    نهاية
    
    دالة ثابتة عند_التوقف(المعالج)
        مدير_أوامر._عند_توقف = المعالج
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # معالجة الأوامر
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة عالج(النص)
        متغير نص_منظف = النص.قص().صغّر()
        
        لكل أمر في مدير_أوامر._الأوامر
            متغير المتغيرات = أمر.يطابق(نص_منظف)
            
            إذا (المتغيرات != لا_شيء)
                ارجع أمر.نفّذ(المتغيرات)
            نهاية
        نهاية
        
        # أمر غير معروف
        إذا (مدير_أوامر._عند_أمر_غير_معروف != لا_شيء)
            ارجع مدير_أوامر._عند_أمر_غير_معروف(النص)
        نهاية
        
        ارجع لا_شيء
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # التشغيل المستمر
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة فعّل()
        إذا (مدير_أوامر._نشط)
            ارجع
        نهاية
        
        مدير_أوامر._نشط = صحيح
        
        مدير_أوامر._معرّف_كلام = جديد معرّف_كلام(إعدادات_صوت.اللهجة())
            .مستمر()
            .عند_نتيجة(دالة(النص)
                مدير_أوامر.عالج(النص)
            نهاية)
            .عند_البدء(دالة()
                إذا (مدير_أوامر._عند_استماع != لا_شيء)
                    مدير_أوامر._عند_استماع()
                نهاية
            نهاية)
            .عند_الانتهاء(دالة()
                إذا (مدير_أوامر._عند_توقف != لا_شيء)
                    مدير_أوامر._عند_توقف()
                نهاية
            نهاية)
        
        انتظر مدير_أوامر._معرّف_كلام.ابدأ()
    نهاية
    
    دالة ثابتة عطّل()
        مدير_أوامر._نشط = خطأ
        
        إذا (مدير_أوامر._معرّف_كلام != لا_شيء)
            مدير_أوامر._معرّف_كلام.أوقف()
        نهاية
    نهاية
    
    دالة ثابتة نشط()
        ارجع مدير_أوامر._نشط
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # قائمة الأوامر
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة الأوامر_المتاحة()
        متغير القائمة = []
        
        لكل أمر في مدير_أوامر._الأوامر
            القائمة.أضف(خريطة{
                "الأنماط": أمر.الأنماط،
                "الوصف": أمر.الوصف،
                "الفئة": أمر.الفئة
            })
        نهاية
        
        ارجع القائمة
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# أوامر شائعة مدمجة
# ═══════════════════════════════════════════════════════════════════════════

صنف أوامر_ملاحة
    
    دالة ثابتة سجّل()
        # الانتقال للصفحات
        مدير_أوامر.سجّل(
            جديد أمر_صوتي(
                ["اذهب إلى {الصفحة}"، "افتح {الصفحة}"، "انتقل إلى {الصفحة}"],
                دالة(م)
                    انتقل_إلى(م["الصفحة"])
                نهاية
            ).بوصف("الانتقال لصفحة").بفئة("ملاحة")
        )
        
        # الرجوع
        مدير_أوامر.سجّل(
            جديد أمر_صوتي(
                ["ارجع"، "رجوع"، "للخلف"],
                دالة(م)
                    ارجع_للخلف()
                نهاية
            ).بوصف("الرجوع للصفحة السابقة").بفئة("ملاحة")
        )
        
        # الصفحة الرئيسية
        مدير_أوامر.سجّل(
            جديد أمر_صوتي(
                ["الرئيسية"، "الصفحة الرئيسية"، "البداية"],
                دالة(م)
                    انتقل_إلى("/")
                نهاية
            ).بوصف("العودة للصفحة الرئيسية").بفئة("ملاحة")
        )
    نهاية
نهاية

صنف أوامر_تفاعل
    
    دالة ثابتة سجّل()
        # التمرير
        مدير_أوامر.سجّل(
            جديد أمر_صوتي(
                ["مرر لأعلى"، "اصعد"، "للأعلى"],
                دالة(م)
                    مرّر_للأعلى()
                نهاية
            ).بوصف("التمرير لأعلى").بفئة("تفاعل")
        )
        
        مدير_أوامر.سجّل(
            جديد أمر_صوتي(
                ["مرر لأسفل"، "انزل"، "للأسفل"],
                دالة(م)
                    مرّر_للأسفل()
                نهاية
            ).بوصف("التمرير لأسفل").بفئة("تفاعل")
        )
        
        # الضغط على زر
        مدير_أوامر.سجّل(
            جديد أمر_صوتي(
                ["اضغط على {الزر}"، "انقر {الزر}"],
                دالة(م)
                    اضغط_على_عنصر(م["الزر"])
                نهاية
            ).بوصف("الضغط على زر").بفئة("تفاعل")
        )
    نهاية
نهاية

صنف أوامر_بحث
    
    دالة ثابتة سجّل()
        # البحث
        مدير_أوامر.سجّل(
            جديد أمر_صوتي(
                ["ابحث عن {النص}"، "بحث {النص}"],
                دالة(م)
                    نفّذ_بحث(م["النص"])
                نهاية
            ).بوصف("البحث عن شيء").بفئة("بحث")
        )
    نهاية
نهاية

# تسجيل الأوامر المدمجة
دالة سجّل_أوامر_مدمجة()
    أوامر_ملاحة.سجّل()
    أوامر_تفاعل.سجّل()
    أوامر_بحث.سجّل()
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# المساعد الصوتي
# ═══════════════════════════════════════════════════════════════════════════

صنف مساعد_صوتي
    متغير _الاسم = "مُساعد"
    متغير _كلمات_تنشيط = ["يا مساعد"، "هاي مساعد"، "مساعد"]
    متغير _نشط = خطأ
    متغير _ينتظر_أمر = خطأ
    متغير _معرّف_كلام = لا_شيء
    متغير _مولّد_كلام = لا_شيء
    متغير _الأوامر = []
    متغير _عند_تنشيط = لا_شيء
    متغير _عند_استجابة = لا_شيء
    
    باني(الاسم = "مُساعد")
        هذا._الاسم = الاسم
        هذا._كلمات_تنشيط = ["يا " + الاسم، "هاي " + الاسم، الاسم]
    نهاية
    
    دالة بكلمات_تنشيط(الكلمات)
        هذا._كلمات_تنشيط = الكلمات
        ارجع هذا
    نهاية
    
    دالة عند_التنشيط(المعالج)
        هذا._عند_تنشيط = المعالج
        ارجع هذا
    نهاية
    
    دالة عند_الاستجابة(المعالج)
        هذا._عند_استجابة = المعالج
        ارجع هذا
    نهاية
    
    دالة أضف_أمر(أمر)
        هذا._الأوامر.أضف(أمر)
        ارجع هذا
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # التشغيل
    # ─────────────────────────────────────────────────────────────────────
    
    دالة غير_متزامنة فعّل()
        إذا (هذا._نشط)
            ارجع
        نهاية
        
        هذا._نشط = صحيح
        
        متغير ذات = هذا
        
        هذا._معرّف_كلام = جديد معرّف_كلام(إعدادات_صوت.اللهجة())
            .مستمر()
            .عند_نتيجة(دالة(النص)
                ذات._عالج_كلام(النص)
            نهاية)
        
        انتظر هذا._معرّف_كلام.ابدأ()
