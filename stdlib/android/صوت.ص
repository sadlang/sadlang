                إذا (نص_صغير.يحتوي(كلمة.صغّر()))
                    هذا._نشّط()
                    ارجع
                نهاية
            نهاية
            ارجع
        نهاية
        
        # معالجة الأمر
        هذا._ينتظر_أمر = خطأ
        هذا._نفّذ_أمر(النص)
    نهاية
    
    دالة _نشّط()
