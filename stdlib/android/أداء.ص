# التخزين المؤقت (Caching)
# ═══════════════════════════════════════════════════════════════════════════

#** عنصر مؤقت **#
صنف عنصر_مؤقت
    متغير المفتاح = ""
    متغير القيمة = لا_شيء
    متغير وقت_الإنشاء = 0
    متغير وقت_آخر_وصول = 0
    متغير عدد_الوصول = 0
    متغير مدة_الصلاحية = 0  # 0 = لا تنتهي
    متغير الحجم = 0
    
    باني(المفتاح، القيمة، المدة = 0)
        هذا.المفتاح = المفتاح
        هذا.القيمة = القيمة
        هذا.وقت_الإنشاء = __الآن()
        هذا.وقت_آخر_وصول = __الآن()
        هذا.مدة_الصلاحية = المدة
        هذا.الحجم = __حجم_الكائن(القيمة)
    نهاية
    
    #** هل منتهي الصلاحية **#
    دالة منتهي()
        إذا (هذا.مدة_الصلاحية == 0)
            ارجع خطأ
        نهاية
        ارجع (__الآن() - هذا.وقت_الإنشاء) > هذا.مدة_الصلاحية
    نهاية
    
    #** تحديث وقت الوصول **#
    دالة وُصِل()
        هذا.وقت_آخر_وصول = __الآن()
        هذا.عدد_الوصول = هذا.عدد_الوصول + 1
    نهاية

نهاية

#** ذاكرة مؤقتة (LRU Cache) **#
صنف ذاكرة_مؤقتة
    متغير _العناصر = خريطة()
    متغير _الترتيب = []  # للـ LRU
    متغير _الحد_الأقصى = 100
    متغير _الحجم_الأقصى = 50 * 1024 * 1024  # 50 MB
    متغير _الحجم_الحالي = 0
    متغير _إصابات = 0
    متغير _إخفاقات = 0
    
    باني(الحد_الأقصى = 100، الحجم_الأقصى = 50 * 1024 * 1024)
        هذا._الحد_الأقصى = الحد_الأقصى
        هذا._الحجم_الأقصى = الحجم_الأقصى
    نهاية
    
    #** الحصول على قيمة **#
    دالة احصل(المفتاح)
        إذا (ليس هذا._العناصر.يحتوي(المفتاح))
            هذا._إخفاقات = هذا._إخفاقات + 1
            ارجع لا_شيء
        نهاية
        
        متغير العنصر = هذا._العناصر[المفتاح]
        
        # التحقق من الصلاحية
        إذا (العنصر.منتهي())
            هذا.احذف(المفتاح)
            هذا._إخفاقات = هذا._إخفاقات + 1
            ارجع لا_شيء
        نهاية
        
        # تحديث LRU
        العنصر.وُصِل()
        هذا._حدّث_ترتيب(المفتاح)
        
        هذا._إصابات = هذا._إصابات + 1
        ارجع العنصر.القيمة
    نهاية
    
    #** تخزين قيمة **#
    دالة خزّن(المفتاح، القيمة، المدة = 0)
        # إذا موجود بالفعل، احذفه أولاً
        إذا (هذا._العناصر.يحتوي(المفتاح))
            هذا.احذف(المفتاح)
        نهاية
        
        متغير عنصر = جديد عنصر_مؤقت(المفتاح، القيمة، المدة)
        
        # التحقق من الحجم
        بينما (هذا._الحجم_الحالي + عنصر.الحجم > هذا._الحجم_الأقصى و هذا._الترتيب.طول() > 0)
            هذا._أزل_أقدم()
        نهاية
        
        # التحقق من العدد
        بينما (هذا._الترتيب.طول() >= هذا._الحد_الأقصى و هذا._الترتيب.طول() > 0)
            هذا._أزل_أقدم()
        نهاية
        
        # إضافة العنصر
        هذا._العناصر[المفتاح] = عنصر
        هذا._الترتيب.أضف(المفتاح)
        هذا._الحجم_الحالي = هذا._الحجم_الحالي + عنصر.الحجم
    نهاية
    
    #** حذف قيمة **#
    دالة احذف(المفتاح)
        إذا (هذا._العناصر.يحتوي(المفتاح))
            متغير العنصر = هذا._العناصر[المفتاح]
            هذا._الحجم_الحالي = هذا._الحجم_الحالي - العنصر.الحجم
            هذا._العناصر.احذف(المفتاح)
            هذا._الترتيب.احذف(المفتاح)
        نهاية
    نهاية
    
    #** مسح الكل **#
    دالة امسح()
        هذا._العناصر = خريطة()
        هذا._الترتيب = []
        هذا._الحجم_الحالي = 0
    نهاية
    
    #** تحديث ترتيب LRU **#
    دالة _حدّث_ترتيب(المفتاح)
        هذا._الترتيب.احذف(المفتاح)
        هذا._الترتيب.أضف(المفتاح)
    نهاية
    
    #** إزالة أقدم عنصر **#
    دالة _أزل_أقدم()
        إذا (هذا._الترتيب.طول() == 0)
            ارجع
        نهاية
        
        متغير الأقدم = هذا._الترتيب[0]
        هذا.احذف(الأقدم)
    نهاية
    
    #** تنظيف المنتهية **#
    دالة نظّف()
        متغير للحذف = []
        
        لكل مفتاح في هذا._العناصر
            إذا (هذا._العناصر[مفتاح].منتهي())
                للحذف.أضف(مفتاح)
            نهاية
        نهاية
        
        لكل مفتاح في للحذف
            هذا.احذف(مفتاح)
        نهاية
    نهاية
    
    #** إحصائيات **#
    دالة إحصائيات()
        متغير الإجمالي = هذا._إصابات + هذا._إخفاقات
        متغير نسبة_الإصابة = إذا (الإجمالي > 0) (هذا._إصابات / الإجمالي) * 100 وإلا 0
        
        ارجع خريطة{
            "العناصر": هذا._الترتيب.طول()،
            "الحجم": هذا._الحجم_الحالي،
            "الإصابات": هذا._إصابات،
            "الإخفاقات": هذا._إخفاقات،
            "نسبة_الإصابة": نسبة_الإصابة
        }
    نهاية
    
    #** هل يحتوي **#
    دالة يحتوي(المفتاح)
        إذا (ليس هذا._العناصر.يحتوي(المفتاح))
            ارجع خطأ
        نهاية
        ارجع ليس هذا._العناصر[المفتاح].منتهي()
    نهاية

نهاية

# ذاكرة مؤقتة افتراضية
متغير ذاكرة = جديد ذاكرة_مؤقتة()

# ═══════════════════════════════════════════════════════════════════════════
# ذاكرة الصور المؤقتة
# ═══════════════════════════════════════════════════════════════════════════

#** ذاكرة الصور **#
صنف ذاكرة_صور
    متغير _ذاكرة = لا_شيء
    متغير _جاري_التحميل = خريطة()
    متغير _ضغط_تلقائي = صحيح
    متغير _جودة_الضغط = 80
    متغير _الحجم_الأقصى_للصورة = 2048
    
    باني(الحجم_الأقصى = 100 * 1024 * 1024)  # 100 MB
        هذا._ذاكرة = جديد ذاكرة_مؤقتة(200، الحجم_الأقصى)
    نهاية
    
    #** تحميل صورة مع تخزين مؤقت **#
    دالة حمّل(الرابط، دالة_النجاح، دالة_الخطأ = لا_شيء)
        # التحقق من الذاكرة المؤقتة
        متغير المخزنة = هذا._ذاكرة.احصل(الرابط)
        
        إذا (المخزنة != لا_شيء)
            دالة_النجاح(المخزنة)
            ارجع
        نهاية
        
        # التحقق إذا كان جاري التحميل
        إذا (هذا._جاري_التحميل.يحتوي(الرابط))
            # إضافة للقائمة الانتظار
            هذا._جاري_التحميل[الرابط].أضف(دالة_النجاح)
            ارجع
        نهاية
        
        # بدء التحميل
        هذا._جاري_التحميل[الرابط] = [دالة_النجاح]
        
        __حمّل_صورة(الرابط، دالة(بيانات_الصورة)
            # ضغط إذا لزم
            متغير البيانات = بيانات_الصورة
            
            إذا (هذا._ضغط_تلقائي)
                البيانات = هذا._اضغط(بيانات_الصورة)
            نهاية
            
            # تخزين في الذاكرة المؤقتة
            هذا._ذاكرة.خزّن(الرابط، البيانات)
            
            # إشعار جميع المنتظرين
            لكل دالة_انتظار في هذا._جاري_التحميل[الرابط]
                دالة_انتظار(البيانات)
            نهاية
            
            هذا._جاري_التحميل.احذف(الرابط)
        نهاية، دالة(خطأ)
            إذا (دالة_الخطأ != لا_شيء)
                دالة_الخطأ(خطأ)
            نهاية
            
            هذا._جاري_التحميل.احذف(الرابط)
        نهاية)
    نهاية
    
    #** ضغط الصورة **#
    دالة _اضغط(البيانات)
        ارجع __اضغط_صورة(البيانات، هذا._جودة_الضغط، هذا._الحجم_الأقصى_للصورة)
    نهاية
    
    #** تحميل مسبق **#
    دالة حمّل_مسبقاً(الروابط)
        لكل رابط في الروابط
            هذا.حمّل(رابط، دالة(صورة)
                # تم التحميل
            نهاية)
        نهاية
    نهاية
    
    #** مسح الذاكرة **#
    دالة امسح()
        هذا._ذاكرة.امسح()
    نهاية
    
    #** تعيين إعدادات الضغط **#
    دالة إعدادات_الضغط(مفعّل، الجودة = 80، الحجم_الأقصى = 2048)
        هذا._ضغط_تلقائي = مفعّل
        هذا._جودة_الضغط = الجودة
        هذا._الحجم_الأقصى_للصورة = الحجم_الأقصى
    نهاية

نهاية

متغير صور = جديد ذاكرة_صور()

