# تجميع الكائنات (Object Pooling)
# ═══════════════════════════════════════════════════════════════════════════

#** مجمع كائنات **#
صنف مجمع
    متغير _المتاحة = []
    متغير _المستخدمة = []
    متغير _دالة_الإنشاء = لا_شيء
    متغير _دالة_إعادة_التعيين = لا_شيء
    متغير _الحد_الأقصى = 50
    
    باني(دالة_الإنشاء، دالة_إعادة_التعيين = لا_شيء، الحد_الأقصى = 50)
        هذا._دالة_الإنشاء = دالة_الإنشاء
        هذا._دالة_إعادة_التعيين = دالة_إعادة_التعيين
        هذا._الحد_الأقصى = الحد_الأقصى
    نهاية
    
    #** الحصول على كائن **#
    دالة احصل()
        متغير الكائن = لا_شيء
        
        إذا (هذا._المتاحة.طول() > 0)
            # استخدام كائن موجود
            الكائن = هذا._المتاحة[هذا._المتاحة.طول() - 1]
            هذا._المتاحة.احذف_عند(هذا._المتاحة.طول() - 1)
        وإلا
            # إنشاء كائن جديد
            الكائن = هذا._دالة_الإنشاء()
        نهاية
        
        هذا._المستخدمة.أضف(الكائن)
        ارجع الكائن
    نهاية
    
    #** إرجاع كائن للمجمع **#
    دالة أرجع(الكائن)
        متغير الفهرس = هذا._المستخدمة.ابحث(الكائن)
        
        إذا (الفهرس >= 0)
            هذا._المستخدمة.احذف_عند(الفهرس)
            
            # إعادة تعيين الكائن
            إذا (هذا._دالة_إعادة_التعيين != لا_شيء)
                هذا._دالة_إعادة_التعيين(الكائن)
            نهاية
            
            # إضافة للمتاحة إذا لم نتجاوز الحد
            إذا (هذا._المتاحة.طول() < هذا._الحد_الأقصى)
                هذا._المتاحة.أضف(الكائن)
            نهاية
        نهاية
    نهاية
    
    #** إرجاع جميع الكائنات **#
    دالة أرجع_الكل()
        بينما (هذا._المستخدمة.طول() > 0)
            هذا.أرجع(هذا._المستخدمة[0])
        نهاية
    نهاية
    
    #** تهيئة مسبقة **#
    دالة هيّئ_مسبقاً(العدد)
        لكل ف في مدى(0، العدد)
            متغير كائن = هذا._دالة_الإنشاء()
            هذا._المتاحة.أضف(كائن)
        نهاية
    نهاية
    
    #** إحصائيات **#
    دالة إحصائيات()
        ارجع خريطة{
            "متاحة": هذا._المتاحة.طول()،
            "مستخدمة": هذا._المستخدمة.طول()،
            "إجمالي": هذا._المتاحة.طول() + هذا._المستخدمة.طول()
        }
    نهاية

نهاية

# ═══════════════════════════════════════════════════════════════════════════
# التحميل الكسول (Lazy Loading)
# ═══════════════════════════════════════════════════════════════════════════

#** محمّل كسول **#
صنف محمّل_كسول
    متغير _دالة_التحميل = لا_شيء
    متغير _القيمة = لا_شيء
    متغير _محمّل = خطأ
    متغير _جاري_التحميل = خطأ
    متغير _المنتظرون = []
    
    باني(دالة_التحميل)
        هذا._دالة_التحميل = دالة_التحميل
    نهاية
    
    #** الحصول على القيمة **#
    دالة احصل(دالة_النتيجة)
        إذا (هذا._محمّل)
            دالة_النتيجة(هذا._القيمة)
            ارجع
        نهاية
        
        هذا._المنتظرون.أضف(دالة_النتيجة)
        
        إذا (ليس هذا._جاري_التحميل)
            هذا._حمّل()
        نهاية
    نهاية
    
    #** تحميل القيمة **#
    دالة _حمّل()
        هذا._جاري_التحميل = صحيح
        
        هذا._دالة_التحميل(دالة(القيمة)
            هذا._القيمة = القيمة
            هذا._محمّل = صحيح
            هذا._جاري_التحميل = خطأ
            
            # إشعار المنتظرين
            لكل منتظر في هذا._المنتظرون
                منتظر(القيمة)
            نهاية
            
            هذا._المنتظرون = []
        نهاية)
    نهاية
    
    #** إعادة تعيين **#
    دالة أعد()
        هذا._القيمة = لا_شيء
        هذا._محمّل = خطأ
    نهاية
    
    #** هل محمّل **#
    دالة محمّل()
        ارجع هذا._محمّل
    نهاية

نهاية

