# تحسين إعادة الرسم
# ═══════════════════════════════════════════════════════════════════════════

#** محسّن إعادة الرسم **#
صنف محسّن_رسم
    متغير _مناطق_قذرة = []
    متغير _إعادة_رسم_كاملة = خطأ
    
    باني()
        # فارغ
    نهاية
    
    #** تحديد منطقة قذرة **#
    دالة منطقة_قذرة(س، ص، العرض، الارتفاع)
        هذا._مناطق_قذرة.أضف(خريطة{
            "س": س،
            "ص": ص،
            "العرض": العرض،
            "الارتفاع": الارتفاع
        })
    نهاية
    
    #** طلب إعادة رسم كاملة **#
    دالة إعادة_رسم_كاملة()
        هذا._إعادة_رسم_كاملة = صحيح
    نهاية
    
    #** الحصول على المناطق للرسم **#
    دالة المناطق()
        إذا (هذا._إعادة_رسم_كاملة)
            هذا._إعادة_رسم_كاملة = خطأ
            هذا._مناطق_قذرة = []
            ارجع لا_شيء  # رسم كل شيء
        نهاية
        
        # دمج المناطق المتداخلة
        متغير المناطق = هذا._دمج_المناطق()
