# تجميع التحديثات (Batched Updates)
# ═══════════════════════════════════════════════════════════════════════════

#** مجمّع التحديثات **#
صنف مجمّع_تحديثات
    متغير _التحديثات = []
    متغير _مجدول = خطأ
    متغير _التأخير = 16  # ~60fps
    
    باني()
        # فارغ
    نهاية
    
    #** إضافة تحديث **#
    دالة أضف(دالة_التحديث)
        هذا._التحديثات.أضف(دالة_التحديث)
        
        إذا (ليس هذا._مجدول)
            هذا._جدول_التنفيذ()
        نهاية
    نهاية
    
    #** جدولة التنفيذ **#
    دالة _جدول_التنفيذ()
        هذا._مجدول = صحيح
        
        __طلب_إطار_حركة(دالة()
            هذا._نفّذ_التحديثات()
        نهاية)
    نهاية
    
    #** تنفيذ التحديثات المجمعة **#
    دالة _نفّذ_التحديثات()
        متغير التحديثات_الحالية = هذا._التحديثات
        هذا._التحديثات = []
        هذا._مجدول = خطأ
        
        # تنفيذ جميع التحديثات
        لكل تحديث في التحديثات_الحالية
            حاول
                تحديث()
            امسك خطأ
                سجل.خطأ("خطأ في تحديث مجمّع"، خطأ)
            نهاية
        نهاية
        
        # إعادة بناء الواجهة مرة واحدة
        __أعد_بناء_الواجهة()
    نهاية
    
    #** تعيين التأخير **#
    دالة التأخير(المدة)
        هذا._التأخير = المدة
    نهاية

نهاية

متغير مجمّع = جديد مجمّع_تحديثات()

