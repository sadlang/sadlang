#** 
# صنف للتعامل مع الجهاز
**#
صنف الجهاز
    
    #** الحصول على اسم الشركة المصنعة **#
    دالة الشركة_المصنعة()
        ارجع __اندرويد_معلومات_الجهاز("الشركة")
    نهاية
    
    #** الحصول على موديل الجهاز **#
    دالة الموديل()
        ارجع __اندرويد_معلومات_الجهاز("الموديل")
    نهاية
    
    #** الحصول على إصدار أندرويد **#
    دالة إصدار_اندرويد()
        ارجع __اندرويد_معلومات_الجهاز("الإصدار")
    نهاية
    
    #** الحصول على مستوى SDK **#
    دالة مستوى_sdk()
        ارجع __اندرويد_معلومات_الجهاز("SDK")
    نهاية
    
    #** الحصول على لغة الجهاز **#
    دالة اللغة()
        ارجع __اندرويد_معلومات_الجهاز("اللغة")
    نهاية
    
    #** الحصول على عرض الشاشة **#
    دالة عرض_الشاشة()
        ارجع __اندرويد_معلومات_الجهاز("عرض_الشاشة")
    نهاية
    
    #** الحصول على ارتفاع الشاشة **#
    دالة ارتفاع_الشاشة()
        ارجع __اندرويد_معلومات_الجهاز("ارتفاع_الشاشة")
    نهاية
    
    #** مستوى البطارية (0-100) **#
    دالة مستوى_البطارية()
        ارجع __اندرويد_بطارية("المستوى")
    نهاية
    
    #** هل الجهاز يشحن **#
    دالة يشحن()
        ارجع __اندرويد_بطارية("شحن") == "صحيح"
    نهاية
    
    #** هل متصل بالإنترنت **#
    دالة متصل_بالإنترنت()
        ارجع __اندرويد_شبكة("متصل") == "صحيح"
    نهاية
    
    #** نوع الاتصال (wifi/mobile) **#
    دالة نوع_الاتصال()
        ارجع __اندرويد_شبكة("النوع")
    نهاية

نهاية

#** 
# صنف التخزين المحلي
**#
صنف تخزين
    
    #** حفظ نص **#
    دالة احفظ(المفتاح، القيمة)
        __اندرويد_تخزين_احفظ(المفتاح، القيمة)
    نهاية
    
    #** قراءة نص **#
    دالة اقرأ(المفتاح، الافتراضي = "")
        ارجع __اندرويد_تخزين_اقرأ(المفتاح، الافتراضي)
    نهاية
    
    #** حفظ رقم **#
    دالة احفظ_رقم(المفتاح، القيمة)
        هذا.احفظ(المفتاح، القيمة.إلى_نص())
    نهاية
    
    #** قراءة رقم **#
    دالة اقرأ_رقم(المفتاح، الافتراضي = 0)
        متغير قيمة = هذا.اقرأ(المفتاح، الافتراضي.إلى_نص())
        ارجع قيمة.إلى_رقم()
    نهاية
    
    #** حفظ منطقي **#
    دالة احفظ_منطقي(المفتاح، القيمة)
        هذا.احفظ(المفتاح، إذا (القيمة) "صحيح" وإلا "خطأ")
    نهاية
    
    #** قراءة منطقي **#
    دالة اقرأ_منطقي(المفتاح، الافتراضي = خطأ)
        متغير قيمة = هذا.اقرأ(المفتاح، "")
        إذا (قيمة == "صحيح")
            ارجع صحيح
        وإلا إذا (قيمة == "خطأ")
            ارجع خطأ
        وإلا
            ارجع الافتراضي
        نهاية
    نهاية
    
    #** حذف مفتاح **#
    دالة احذف(المفتاح)
        __اندرويد_تخزين_احذف(المفتاح)
    نهاية
    
    #** هل المفتاح موجود **#
    دالة موجود(المفتاح)
        ارجع __اندرويد_تخزين_موجود(المفتاح) == "صحيح"
    نهاية
    
    #** مسح الكل **#
    دالة امسح_الكل()
        __اندرويد_تخزين_امسح()
    نهاية

نهاية

#** 
# صنف الملفات
**#
صنف ملفات
    
    #** مسار التخزين الداخلي **#
    دالة المسار_الداخلي()
        ارجع __اندرويد_ملفات_مسار("داخلي")
    نهاية
    
    #** مسار التخزين الخارجي **#
    دالة المسار_الخارجي()
        ارجع __اندرويد_ملفات_مسار("خارجي")
    نهاية
    
    #** مسار الكاش **#
    دالة مسار_الكاش()
        ارجع __اندرويد_ملفات_مسار("كاش")
    نهاية
    
    #** هل الملف موجود **#
    دالة موجود(المسار)
        ارجع __اندرويد_ملف_موجود(المسار) == "صحيح"
    نهاية
    
    #** قراءة ملف نصي **#
    دالة اقرأ_نص(المسار)
        ارجع __اندرويد_ملف_اقرأ(المسار)
    نهاية
    
    #** كتابة ملف نصي **#
    دالة اكتب_نص(المسار، المحتوى)
        ارجع __اندرويد_ملف_اكتب(المسار، المحتوى) == "صحيح"
    نهاية
    
    #** حذف ملف **#
    دالة احذف(المسار)
        ارجع __اندرويد_ملف_احذف(المسار) == "صحيح"
    نهاية
    
    #** إنشاء مجلد **#
    دالة أنشئ_مجلد(المسار)
        ارجع __اندرويد_مجلد_أنشئ(المسار) == "صحيح"
    نهاية
    
    #** قائمة الملفات في مجلد **#
    دالة قائمة_الملفات(المسار)
        ارجع __اندرويد_مجلد_قائمة(المسار)
    نهاية
    
    #** حجم الملف **#
    دالة حجم_الملف(المسار)
        ارجع __اندرويد_ملف_حجم(المسار)
    نهاية

نهاية

#** 
# صنف الموقع الجغرافي
**#
صنف موقع
    
    #** هل الصلاحية متاحة **#
    دالة الصلاحية_متاحة()
        ارجع __اندرويد_موقع_صلاحية() == "صحيح"
    نهاية
    
    #** طلب الصلاحية **#
    دالة اطلب_الصلاحية()
        __اندرويد_موقع_اطلب_صلاحية()
    نهاية
    
    #** الحصول على الموقع الحالي **#
    دالة الموقع_الحالي()
        متغير بيانات = __اندرويد_موقع_حالي()
        ارجع خريطة{
            "خط_العرض": بيانات["lat"]،
            "خط_الطول": بيانات["lon"]،
            "الدقة": بيانات["accuracy"]،
            "الارتفاع": بيانات["altitude"]
        }
    نهاية
    
    #** حساب المسافة بين نقطتين (بالأمتار) **#
    دالة المسافة_بين(خط_عرض1، خط_طول1، خط_عرض2، خط_طول2)
        ارجع __اندرويد_موقع_مسافة(خط_عرض1، خط_طول1، خط_عرض2، خط_طول2)
    نهاية

نهاية

#** 
# صنف الإشعارات
**#
صنف إشعارات
    
    #** عرض إشعار **#
    دالة أظهر(العنوان، المحتوى، المعرف = 1)
        __اندرويد_إشعار_أظهر(المعرف، العنوان، المحتوى)
    نهاية
    
    #** إلغاء إشعار **#
    دالة ألغِ(المعرف)
        __اندرويد_إشعار_ألغ(المعرف)
    نهاية
    
    #** إلغاء كل الإشعارات **#
    دالة ألغِ_الكل()
        __اندرويد_إشعار_ألغ_الكل()
    نهاية

نهاية

#** 
# صنف المشاركة
**#
صنف مشاركة
    
    #** مشاركة نص **#
    دالة شارك_نص(النص، العنوان = "مشاركة")
        __اندرويد_شارك_نص(النص، العنوان)
    نهاية
    
    #** مشاركة صورة **#
    دالة شارك_صورة(مسار_الصورة، النص = "")
        __اندرويد_شارك_صورة(مسار_الصورة، النص)
    نهاية
    
    #** مشاركة ملف **#
    دالة شارك_ملف(المسار، نوع_الملف)
        __اندرويد_شارك_ملف(المسار، نوع_الملف)
    نهاية

نهاية

#** 
# صنف الحافظة
**#
صنف حافظة
    
    #** نسخ نص **#
    دالة انسخ(النص)
        __اندرويد_حافظة_انسخ(النص)
    نهاية
    
    #** لصق نص **#
    دالة الصق()
        ارجع __اندرويد_حافظة_الصق()
    نهاية
    
    #** هل يوجد نص **#
    دالة يوجد_نص()
        ارجع __اندرويد_حافظة_يوجد() == "صحيح"
    نهاية

نهاية

#** 
# صنف الاهتزاز
**#
صنف اهتزاز
    
    #** هل الجهاز يدعم الاهتزاز **#
    دالة مدعوم()
        ارجع __اندرويد_اهتزاز_مدعوم() == "صحيح"
    نهاية
    
    #** اهتزاز لمدة معينة (ملي ثانية) **#
    دالة اهتز(المدة = 100)
        __اندرويد_اهتزاز(المدة)
    نهاية
    
    #** اهتزاز قصير **#
    دالة قصير()
        هذا.اهتز(50)
    نهاية
    
    #** اهتزاز متوسط **#
    دالة متوسط()
        هذا.اهتز(100)
    نهاية
    
    #** اهتزاز طويل **#
    دالة طويل()
        هذا.اهتز(300)
    نهاية

نهاية

#** 
# صنف فتح الروابط
**#
صنف روابط
    
    #** فتح رابط في المتصفح **#
    دالة افتح(الرابط)
        __اندرويد_افتح_رابط(الرابط)
    نهاية
    
    #** فتح البريد **#
    دالة بريد(العنوان، الموضوع = ""، المحتوى = "")
        __اندرويد_افتح_بريد(العنوان، الموضوع، المحتوى)
    نهاية
    
    #** فتح الهاتف **#
    دالة هاتف(الرقم)
        __اندرويد_افتح_هاتف(الرقم)
    نهاية
    
    #** فتح الخريطة **#
    دالة خريطة(خط_العرض، خط_الطول)
        __اندرويد_افتح_خريطة(خط_العرض، خط_الطول)
    نهاية
    
    #** فتح إعدادات التطبيق **#
    دالة إعدادات_التطبيق()
        __اندرويد_افتح_إعدادات()
    نهاية

نهاية

#** 
# صنف الحوارات
**#
صنف حوار
    
    #** عرض رسالة Toast **#
    دالة رسالة(النص، طويل = خطأ)
        __اندرويد_رسالة(النص، إذا (طويل) "طويل" وإلا "قصير")
    نهاية
    
    #** عرض حوار تنبيه **#
    دالة تنبيه(العنوان، الرسالة، زر_موافق = "موافق")
        __اندرويد_حوار_تنبيه(العنوان، الرسالة، زر_موافق)
    نهاية
    
    #** عرض حوار تأكيد **#
    دالة تأكيد(العنوان، الرسالة، زر_نعم = "نعم"، زر_لا = "لا")
        ارجع __اندرويد_حوار_تأكيد(العنوان، الرسالة، زر_نعم، زر_لا)
    نهاية
    
    #** عرض حوار إدخال **#
    دالة إدخال(العنوان، التلميح = ""، زر_موافق = "موافق")
        ارجع __اندرويد_حوار_إدخال(العنوان، التلميح، زر_موافق)
    نهاية

نهاية

