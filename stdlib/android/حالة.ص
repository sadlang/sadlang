# ═══════════════════════════════════════════════════════════════════════════
# حالة.ص - نظام إدارة الحالة التفاعلي (Reactive State Management)
# ═══════════════════════════════════════════════════════════════════════════
#
# نظام إدارة حالة متقدم يتفوق على Flutter's setState و Provider
# يستخدم نمط Signals/Observables للتحديث التلقائي
#
# المميزات:
# - إشارات (Signals) للقيم التفاعلية
# - إشارات محسوبة (Computed)
# - تأثيرات جانبية (Effects)
# - مخازن حالة (Stores)
# - تتبع تلقائي للتبعيات
# - تحديث ذكي للواجهة
#
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# الإشارات (Signals) - القيم التفاعلية الأساسية
# ═══════════════════════════════════════════════════════════════════════════

#**
# إشارة: قيمة تفاعلية تُحدّث الواجهة تلقائياً عند تغيرها
# أفضل من setState لأنها تُحدّث فقط الأجزاء المتأثرة
**#
صنف إشارة
    متغير _القيمة = لا_شيء
    متغير _المراقبون = []
    متغير _الاسم = ""
    متغير _النوع = "عام"
    
    باني(القيمة_الأولية، الاسم = "")
        هذا._القيمة = القيمة_الأولية
        هذا._الاسم = الاسم
        
        # تسجيل في نظام التتبع
        __نظام_الحالة.سجل_إشارة(هذا)
    نهاية
    
    #** الحصول على القيمة مع تتبع التبعيات **#
    دالة القيمة()
        # تسجيل هذه الإشارة كتبعية للقراءة الحالية
        __نظام_الحالة.سجل_تبعية(هذا)
        ارجع هذا._القيمة
    نهاية
    
    #** تعيين القيمة مع إشعار المراقبين **#
    دالة عيّن(القيمة_الجديدة)
        إذا (هذا._القيمة == القيمة_الجديدة)
            ارجع  # لا تغيير
        نهاية
        
        متغير القيمة_القديمة = هذا._القيمة
        هذا._القيمة = القيمة_الجديدة
        
        # إشعار جميع المراقبين
        هذا._أشعر_المراقبين(القيمة_القديمة، القيمة_الجديدة)
    نهاية
    
    #** تحديث القيمة باستخدام دالة **#
    دالة حدّث(دالة_التحديث)
        متغير قيمة_جديدة = دالة_التحديث(هذا._القيمة)
        هذا.عيّن(قيمة_جديدة)
    نهاية
    
    #** إضافة مراقب **#
    دالة راقب(دالة_المراقبة)
        هذا._المراقبون.أضف(دالة_المراقبة)
        
        # إرجاع دالة لإلغاء المراقبة
        ارجع دالة()
            هذا._المراقبون.احذف(دالة_المراقبة)
        نهاية
    نهاية
    
    #** إشعار المراقبين **#
    دالة _أشعر_المراقبين(القديمة، الجديدة)
        لكل مراقب في هذا._المراقبون
            حاول
                مراقب(الجديدة، القديمة)
            امسك خطأ
                سجل_خطأ("خطأ في مراقب الإشارة: " + خطأ)
            نهاية
        نهاية
        
        # طلب تحديث الواجهة
        __نظام_الحالة.اطلب_تحديث()
    نهاية
    
    #** الحصول على الاسم **#
    دالة الاسم()
        ارجع هذا._الاسم
    نهاية

نهاية

# ═══════════════════════════════════════════════════════════════════════════
# الإشارات المحسوبة (Computed Signals)
# ═══════════════════════════════════════════════════════════════════════════

#**
# إشارة محسوبة: قيمة مشتقة من إشارات أخرى
# تُحدّث تلقائياً عند تغير أي من التبعيات
**#
صنف إشارة_محسوبة
    متغير _دالة_الحساب = لا_شيء
    متغير _القيمة_المخزنة = لا_شيء
    متغير _التبعيات = []
    متغير _صالحة = خطأ
    متغير _المراقبون = []
    
    باني(دالة_الحساب)
        هذا._دالة_الحساب = دالة_الحساب
        
        # حساب القيمة الأولية وتتبع التبعيات
        هذا._أعد_الحساب()
    نهاية
    
    #** الحصول على القيمة المحسوبة **#
    دالة القيمة()
        إذا (ليس هذا._صالحة)
            هذا._أعد_الحساب()
        نهاية
        
        __نظام_الحالة.سجل_تبعية(هذا)
        ارجع هذا._القيمة_المخزنة
    نهاية
    
    #** إعادة حساب القيمة **#
    دالة _أعد_الحساب()
        # بدء تتبع التبعيات
        __نظام_الحالة.ابدأ_التتبع()
        
        # تنفيذ دالة الحساب
        هذا._القيمة_المخزنة = هذا._دالة_الحساب()
        
        # الحصول على التبعيات والاشتراك فيها
        متغير تبعيات_جديدة = __نظام_الحالة.أنهِ_التتبع()
        
        # إلغاء الاشتراك من التبعيات القديمة
        لكل تبعية في هذا._التبعيات
            تبعية._المراقبون.احذف(هذا._عند_تغير_تبعية)
        نهاية
        
        # الاشتراك في التبعيات الجديدة
        هذا._التبعيات = تبعيات_جديدة
        لكل تبعية في هذا._التبعيات
            تبعية.راقب(هذا._عند_تغير_تبعية)
        نهاية
        
        هذا._صالحة = صحيح
    نهاية
    
    #** عند تغير أي تبعية **#
    دالة _عند_تغير_تبعية(الجديدة، القديمة)
        هذا._صالحة = خطأ
        
        # إشعار المراقبين
        لكل مراقب في هذا._المراقبون
            مراقب(هذا.القيمة()، لا_شيء)
        نهاية
    نهاية
    
    #** إضافة مراقب **#
    دالة راقب(دالة_المراقبة)
        هذا._المراقبون.أضف(دالة_المراقبة)
        ارجع دالة()
            هذا._المراقبون.احذف(دالة_المراقبة)
        نهاية
    نهاية

نهاية

# ═══════════════════════════════════════════════════════════════════════════
# التأثيرات (Effects)
# ═══════════════════════════════════════════════════════════════════════════

#**
# تأثير: كود يُنفذ تلقائياً عند تغير التبعيات
# مثالي للعمليات الجانبية (طلبات شبكة، تخزين، سجلات)
**#
صنف تأثير
    متغير _دالة_التأثير = لا_شيء
    متغير _دالة_التنظيف = لا_شيء
    متغير _التبعيات = []
    متغير _نشط = صحيح
    
    باني(دالة_التأثير)
        هذا._دالة_التأثير = دالة_التأثير
        
        # تنفيذ التأثير للمرة الأولى
        هذا._نفّذ()
    نهاية
    
    #** تنفيذ التأثير **#
    دالة _نفّذ()
        إذا (ليس هذا._نشط)
            ارجع
        نهاية
        
        # تنظيف التأثير السابق
        إذا (هذا._دالة_التنظيف != لا_شيء)
            هذا._دالة_التنظيف()
        نهاية
        
        # بدء تتبع التبعيات
        __نظام_الحالة.ابدأ_التتبع()
        
        # تنفيذ دالة التأثير
        هذا._دالة_التنظيف = هذا._دالة_التأثير()
        
        # الحصول على التبعيات
        متغير تبعيات_جديدة = __نظام_الحالة.أنهِ_التتبع()
        
        # الاشتراك في التبعيات
        هذا._التبعيات = تبعيات_جديدة
        لكل تبعية في هذا._التبعيات
            تبعية.راقب(هذا._عند_تغير)
        نهاية
    نهاية
    
    #** عند تغير التبعيات **#
    دالة _عند_تغير(الجديدة، القديمة)
        هذا._نفّذ()
    نهاية
    
    #** إيقاف التأثير **#
    دالة أوقف()
        هذا._نشط = خطأ
        
        إذا (هذا._دالة_التنظيف != لا_شيء)
            هذا._دالة_التنظيف()
        نهاية
    نهاية

نهاية

# ═══════════════════════════════════════════════════════════════════════════
# المخزن (Store) - حاوية حالة مركزية
# ═══════════════════════════════════════════════════════════════════════════

#**
# مخزن: حاوية مركزية للحالة مع إجراءات وطفرات
# مشابه لـ Redux/Vuex لكن بصيغة عربية أبسط
**#
صنف مخزن
    متغير _الحالة = خريطة()
    متغير _الإشارات = خريطة()
    متغير _الإجراءات = خريطة()
    متغير _الطفرات = خريطة()
    متغير _المراقبون = []
    متغير _السجل = []
    متغير _تسجيل_السجل = صحيح
    
    باني(الحالة_الأولية = خريطة())
        # تحويل كل قيمة إلى إشارة
        لكل مفتاح في الحالة_الأولية
            هذا._الإشارات[مفتاح] = جديد إشارة(الحالة_الأولية[مفتاح]، مفتاح)
            هذا._الحالة[مفتاح] = الحالة_الأولية[مفتاح]
        نهاية
    نهاية
    
    #** الحصول على قيمة من الحالة **#
    دالة احصل(المفتاح)
        إذا (هذا._الإشارات.يحتوي(المفتاح))
            ارجع هذا._الإشارات[المفتاح].القيمة()
        نهاية
        ارجع لا_شيء
    نهاية
    
    #** تعيين قيمة في الحالة **#
    دالة عيّن(المفتاح، القيمة)
        إذا (ليس هذا._الإشارات.يحتوي(المفتاح))
            هذا._الإشارات[المفتاح] = جديد إشارة(القيمة، المفتاح)
        وإلا
            هذا._الإشارات[المفتاح].عيّن(القيمة)
        نهاية
        
        هذا._الحالة[المفتاح] = القيمة
        
        # تسجيل في السجل
        إذا (هذا._تسجيل_السجل)
            هذا._السجل.أضف(خريطة{
                "النوع": "تعيين"،
                "المفتاح": المفتاح،
                "القيمة": القيمة،
                "الوقت": __الآن()
            })
        نهاية
    نهاية
    
    #** الحصول على إشارة للاستخدام التفاعلي **#
    دالة إشارة(المفتاح)
        ارجع هذا._الإشارات[المفتاح]
    نهاية
    
    #** تعريف طفرة (mutation) **#
    دالة عرّف_طفرة(الاسم، دالة_الطفرة)
        هذا._الطفرات[الاسم] = دالة_الطفرة
    نهاية
    
    #** تنفيذ طفرة **#
    دالة طفرة(الاسم، البيانات = خريطة())
        إذا (ليس هذا._الطفرات.يحتوي(الاسم))
            سجل_خطأ("الطفرة غير موجودة: " + الاسم)
            ارجع
        نهاية
        
        هذا._الطفرات[الاسم](هذا، البيانات)
        
        # تسجيل في السجل
        إذا (هذا._تسجيل_السجل)
            هذا._السجل.أضف(خريطة{
                "النوع": "طفرة"،
                "الاسم": الاسم،
                "البيانات": البيانات،
                "الوقت": __الآن()
            })
        نهاية
    نهاية
    
    #** تعريف إجراء (action) - قد يكون غير متزامن **#
    دالة عرّف_إجراء(الاسم، دالة_الإجراء)
        هذا._الإجراءات[الاسم] = دالة_الإجراء
    نهاية
    
    #** تنفيذ إجراء **#
    دالة إجراء(الاسم، البيانات = خريطة())
        إذا (ليس هذا._الإجراءات.يحتوي(الاسم))
            سجل_خطأ("الإجراء غير موجود: " + الاسم)
            ارجع
        نهاية
        
        ارجع هذا._الإجراءات[الاسم](هذا، البيانات)
    نهاية
    
    #** الحصول على نسخة من الحالة الكاملة **#
    دالة الحالة()
        متغير نسخة = خريطة()
        لكل مفتاح في هذا._الحالة
            نسخة[مفتاح] = هذا._الحالة[مفتاح]
        نهاية
        ارجع نسخة
    نهاية
    
    #** الحصول على سجل التغييرات **#
    دالة السجل()
        ارجع هذا._السجل
    نهاية
    
    #** التراجع عن آخر تغيير **#
    دالة تراجع()
        إذا (هذا._السجل.طول() == 0)
            ارجع خطأ
        نهاية
        
        # TODO: تنفيذ التراجع
        ارجع صحيح
    نهاية

نهاية

# ═══════════════════════════════════════════════════════════════════════════
# نظام إدارة الحالة المركزي
# ═══════════════════════════════════════════════════════════════════════════

صنف _نظام_الحالة
    متغير _الإشارات = []
    متغير _التبعيات_الحالية = []
    متغير _في_وضع_التتبع = خطأ
    متغير _تحديث_مطلوب = خطأ
    متغير _دالة_التحديث = لا_شيء
    
    #** تسجيل إشارة جديدة **#
    دالة سجل_إشارة(الإشارة)
        هذا._الإشارات.أضف(الإشارة)
    نهاية
    
    #** تسجيل تبعية أثناء القراءة **#
    دالة سجل_تبعية(الإشارة)
        إذا (هذا._في_وضع_التتبع)
            # تجنب التكرار
            متغير موجودة = خطأ
            لكل تبعية في هذا._التبعيات_الحالية
                إذا (تبعية == الإشارة)
                    موجودة = صحيح
                    اخرج
                نهاية
            نهاية
            
            إذا (ليس موجودة)
                هذا._التبعيات_الحالية.أضف(الإشارة)
            نهاية
        نهاية
    نهاية
    
    #** بدء تتبع التبعيات **#
    دالة ابدأ_التتبع()
        هذا._في_وضع_التتبع = صحيح
        هذا._التبعيات_الحالية = []
    نهاية
    
    #** إنهاء التتبع والحصول على التبعيات **#
    دالة أنهِ_التتبع()
        هذا._في_وضع_التتبع = خطأ
        متغير التبعيات = هذا._التبعيات_الحالية
        هذا._التبعيات_الحالية = []
        ارجع التبعيات
    نهاية
    
    #** طلب تحديث الواجهة **#
    دالة اطلب_تحديث()
        هذا._تحديث_مطلوب = صحيح
        
        إذا (هذا._دالة_التحديث != لا_شيء)
            هذا._دالة_التحديث()
            هذا._تحديث_مطلوب = خطأ
        نهاية
    نهاية
    
    #** تعيين دالة التحديث **#
    دالة عيّن_دالة_التحديث(الدالة)
        هذا._دالة_التحديث = الدالة
    نهاية

نهاية

# إنشاء النظام المركزي
متغير __نظام_الحالة = جديد _نظام_الحالة()

# ═══════════════════════════════════════════════════════════════════════════
# دوال مساعدة للإنشاء السريع
# ═══════════════════════════════════════════════════════════════════════════

#** إنشاء إشارة جديدة **#
دالة إشارة(القيمة_الأولية، الاسم = "")
    ارجع جديد إشارة(القيمة_الأولية، الاسم)
نهاية

#** إنشاء إشارة محسوبة **#
دالة محسوبة(دالة_الحساب)
    ارجع جديد إشارة_محسوبة(دالة_الحساب)
نهاية

#** إنشاء تأثير **#
دالة تأثير(دالة_التأثير)
    ارجع جديد تأثير(دالة_التأثير)
نهاية

#** إنشاء مخزن **#
دالة مخزن(الحالة_الأولية = خريطة())
    ارجع جديد مخزن(الحالة_الأولية)
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# أنواع الإشارات المتخصصة
# ═══════════════════════════════════════════════════════════════════════════

#** إشارة قائمة تفاعلية **#
صنف إشارة_قائمة يرث إشارة
    
    باني(القائمة_الأولية = [])
        الأصل.باني(القائمة_الأولية، "قائمة")
    نهاية
    
    #** إضافة عنصر **#
    دالة أضف(العنصر)
        متغير قائمة = هذا._القيمة
        قائمة.أضف(العنصر)
        هذا._أشعر_المراقبين(لا_شيء، قائمة)
    نهاية
    
    #** حذف عنصر **#
    دالة احذف(الفهرس)
        متغير قائمة = هذا._القيمة
        متغير المحذوف = قائمة[الفهرس]
        قائمة.احذف_عند(الفهرس)
        هذا._أشعر_المراقبين(المحذوف، قائمة)
    نهاية
    
    #** تحديث عنصر **#
    دالة حدّث_عند(الفهرس، القيمة_الجديدة)
        متغير قائمة = هذا._القيمة
        قائمة[الفهرس] = القيمة_الجديدة
        هذا._أشعر_المراقبين(لا_شيء، قائمة)
    نهاية
    
    #** الطول **#
    دالة الطول()
        ارجع هذا._القيمة.طول()
    نهاية
    
    #** مسح الكل **#
    دالة امسح()
        هذا.عيّن([])
    نهاية

نهاية

#** إشارة خريطة تفاعلية **#
صنف إشارة_خريطة يرث إشارة
    
    باني(الخريطة_الأولية = خريطة())
        الأصل.باني(الخريطة_الأولية، "خريطة")
    نهاية
    
    #** تعيين قيمة **#
    دالة ضع(المفتاح، القيمة)
        متغير خريطة_حالية = هذا._القيمة
        خريطة_حالية[المفتاح] = القيمة
        هذا._أشعر_المراقبين(لا_شيء، خريطة_حالية)
    نهاية
    
    #** الحصول على قيمة **#
    دالة خذ(المفتاح)
        ارجع هذا._القيمة[المفتاح]
    نهاية
    
    #** حذف مفتاح **#
    دالة احذف(المفتاح)
        متغير خريطة_حالية = هذا._القيمة
        خريطة_حالية.احذف(المفتاح)
        هذا._أشعر_المراقبين(لا_شيء، خريطة_حالية)
    نهاية
    
    #** هل يحتوي المفتاح **#
    دالة يحتوي(المفتاح)
        ارجع هذا._القيمة.يحتوي(المفتاح)
    نهاية

