# نظام الجسيمات (Particle System)
# ═══════════════════════════════════════════════════════════════════════════

صنف نظام_جسيمات
    متغير الموقع
    متغير عدد_الجسيمات
    متغير لون_البداية
    متغير لون_النهاية
    متغير حجم_البداية
    متغير حجم_النهاية
    متغير السرعة
    متغير الاتجاه
    متغير العمر
    متغير الجاذبية
    متغير الشكل
    
    باني(الإعدادات)
        هذا.الموقع = الإعدادات["الموقع"] أو نقطة(0، 0)
        هذا.عدد_الجسيمات = الإعدادات["العدد"] أو 100
        هذا.لون_البداية = الإعدادات["لون_البداية"] أو ألوان.أبيض
        هذا.لون_النهاية = الإعدادات["لون_النهاية"] أو ألوان.شفاف
        هذا.حجم_البداية = الإعدادات["حجم_البداية"] أو 10
        هذا.حجم_النهاية = الإعدادات["حجم_النهاية"] أو 0
        هذا.السرعة = الإعدادات["السرعة"] أو 100
        هذا.الاتجاه = الإعدادات["الاتجاه"] أو نقطة(0، -1)
        هذا.العمر = الإعدادات["العمر"] أو 2000
        هذا.الجاذبية = الإعدادات["الجاذبية"] أو نقطة(0، 0)
        هذا.الشكل = الإعدادات["الشكل"] أو "دائرة"
    نهاية
    
    دالة ابدأ()
        ارجع هذا
    نهاية
    
    دالة أوقف()
        ارجع هذا
    نهاية
    
    دالة انفجار(العدد)
        # إطلاق انفجار من الجسيمات
        ارجع هذا
    نهاية
    
    دالة ابنِ()
        ارجع عنصر_جسيمات(هذا)
    نهاية
نهاية

