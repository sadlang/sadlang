دالة منطقة_آمنة(المحتوى، الإعدادات = خريطة{})
    متغير الحواف = الشاشة.حواف_آمنة
    
    متغير أعلى = إذا (الإعدادات["أعلى"] != خطأ) الحواف["أعلى"] وإلا 0
    متغير أسفل = إذا (الإعدادات["أسفل"] != خطأ) الحواف["أسفل"] وإلا 0
    متغير يمين = إذا (الإعدادات["يمين"] != خطأ) الحواف["يمين"] وإلا 0
    متغير يسار = إذا (الإعدادات["يسار"] != خطأ) الحواف["يسار"] وإلا 0
    
    ارجع حاشية_مخصصة(أعلى، أسفل، يمين، يسار، المحتوى)
نهاية

