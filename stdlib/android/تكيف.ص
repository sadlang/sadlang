صنف منشئ_متكيف
    متغير _منشئ_هاتف = لا_شيء
    متغير _منشئ_تابلت = لا_شيء
    متغير _منشئ_سطح_مكتب = لا_شيء
    متغير _منشئ_افتراضي = لا_شيء
    
    باني()
    نهاية
    
    دالة هاتف(المنشئ)
        هذا._منشئ_هاتف = المنشئ
        ارجع هذا
    نهاية
    
    دالة تابلت(المنشئ)
        هذا._منشئ_تابلت = المنشئ
        ارجع هذا
    نهاية
    
    دالة سطح_مكتب(المنشئ)
        هذا._منشئ_سطح_مكتب = المنشئ
        ارجع هذا
    نهاية
    
    دالة افتراضي(المنشئ)
        هذا._منشئ_افتراضي = المنشئ
        ارجع هذا
    نهاية
    
    دالة ابنِ()
        إذا (الشاشة.هاتف() و هذا._منشئ_هاتف != لا_شيء)
            ارجع هذا._منشئ_هاتف(الشاشة)
        والا_اذا (الشاشة.تابلت() و هذا._منشئ_تابلت != لا_شيء)
            ارجع هذا._منشئ_تابلت(الشاشة)
        والا_اذا (الشاشة.سطح_مكتب() و هذا._منشئ_سطح_مكتب != لا_شيء)
            ارجع هذا._منشئ_سطح_مكتب(الشاشة)
        والا_اذا (هذا._منشئ_افتراضي != لا_شيء)
            ارجع هذا._منشئ_افتراضي(الشاشة)
        وإلا
            ارجع حاوية_فارغة()
        نهاية
    نهاية
نهاية

# دالة مختصرة
دالة متكيف()
    ارجع جديد منشئ_متكيف()
