# شريط التطبيق المتكيف
# ═══════════════════════════════════════════════════════════════════════════

صنف شريط_تطبيق_متكيف
    متغير العنوان = ""
    متغير _الإجراءات = []
    متغير _إجراءات_قائمة = []
    متغير _زر_قائمة = خطأ
    متغير _زر_رجوع = خطأ
    
    باني(العنوان)
        هذا.العنوان = العنوان
    نهاية
    
    دالة بزر_قائمة()
        هذا._زر_قائمة = صحيح
        ارجع هذا
    نهاية
    
    دالة بزر_رجوع()
        هذا._زر_رجوع = صحيح
        ارجع هذا
    نهاية
    
    دالة أضف_إجراء(الأيقونة، العنوان، المنفذ)
        هذا._الإجراءات.أضف(خريطة{
            "أيقونة": الأيقونة،
            "عنوان": العنوان،
            "منفذ": المنفذ
        })
        ارجع هذا
    نهاية
    
    دالة ابنِ()
        # كم إجراء نعرض في الشريط؟
        متغير أقصى_ظاهر = الشاشة.قيمة_متكيفة(خريطة{
            "هاتف": 2،
            "تابلت": 4،
            "سطح_مكتب": 6
        })
        
        متغير إجراءات_ظاهرة = []
        متغير إجراءات_قائمة = []
        
        لكل ن في مدى(0، هذا._الإجراءات.طول())
            إذا (ن < أقصى_ظاهر)
                إجراءات_ظاهرة.أضف(هذا._الإجراءات[ن])
            وإلا
                إجراءات_قائمة.أضف(هذا._الإجراءات[ن])
            نهاية
        نهاية
        
        ارجع شريط_تطبيق(
            هذا.العنوان،
            زر_رجوع = هذا._زر_رجوع،
            أيقونة_قائمة = هذا._زر_قائمة،
            إجراءات = [
                لكل إجراء في إجراءات_ظاهرة
                    زر_أيقونة(إجراء["أيقونة"]، إجراء["منفذ"])
                نهاية،
                
                إذا (إجراءات_قائمة.طول() > 0)
                    قائمة_منسدلة(
                        زر_أيقونة(أيقونات.المزيد، لا_شيء)،
                        [
                            لكل إجراء في إجراءات_قائمة
                                عنصر_قائمة_منسدلة(إجراء["عنوان"]، إجراء["منفذ"])
                            نهاية
                        ]
                    )
                نهاية
            ]
        )
    نهاية
نهاية

دالة شريط_متكيف(العنوان)
    ارجع جديد شريط_تطبيق_متكيف(العنوان)
