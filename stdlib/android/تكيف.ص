# تخطيط Master-Detail
# ═══════════════════════════════════════════════════════════════════════════

صنف تخطيط_رئيسي_تفصيلي
    متغير _عنصر_رئيسي = لا_شيء
    متغير _عنصر_تفصيلي = لا_شيء
    متغير _عرض_رئيسي = 300
    متغير _حد_دمج = نقاط_توقف.تابلت
    متغير _عنصر_فارغ = لا_شيء
    
    باني()
    نهاية
    
    دالة رئيسي(العنصر)
        هذا._عنصر_رئيسي = العنصر
        ارجع هذا
    نهاية
    
    دالة تفصيلي(العنصر)
        هذا._عنصر_تفصيلي = العنصر
        ارجع هذا
    نهاية
    
    دالة عرض_رئيسي(العرض)
        هذا._عرض_رئيسي = العرض
        ارجع هذا
    نهاية
    
    دالة عند_فراغ(العنصر)
        هذا._عنصر_فارغ = العنصر
        ارجع هذا
    نهاية
    
    دالة ابنِ()
        # في الشاشات الكبيرة: جنباً لجنب
        إذا (الشاشة.العرض >= هذا._حد_دمج)
            ارجع صف([
                حاوية(هذا._عنصر_رئيسي)
                    .بعرض(هذا._عرض_رئيسي)
                    .بلون_خلفية(ألوان.سطح)
                    .بحد_يمين(1، ألوان.حدود)،
                
                موسّع(
                    هذا._عنصر_تفصيلي أو هذا._عنصر_فارغ أو 
                    حالة_فارغة("اختر عنصراً")
                )
            ])
        وإلا
            # في الشاشات الصغيرة: صفحة منفصلة
            إذا (هذا._عنصر_تفصيلي != لا_شيء)
                ارجع هذا._عنصر_تفصيلي
            وإلا
                ارجع هذا._عنصر_رئيسي
            نهاية
        نهاية
    نهاية
نهاية

دالة رئيسي_تفصيلي()
    ارجع جديد تخطيط_رئيسي_تفصيلي()
نهاية

