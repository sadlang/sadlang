دالة صف_أو_عمود(العناصر، الإعدادات = خريطة{})
    # أفقي في الشاشات الكبيرة، عمودي في الصغيرة
    متغير أفقي_في = الإعدادات["أفقي_في"] أو نقاط_توقف.تابلت
    
    إذا (الشاشة.العرض >= أفقي_في)
        ارجع صف(العناصر)
    وإلا
        ارجع عمود(العناصر)
    نهاية
نهاية

دالة عمود_أو_صف(العناصر، الإعدادات = خريطة{})
    # عمودي في الشاشات الكبيرة، أفقي في الصغيرة
    متغير عمودي_في = الإعدادات["عمودي_في"] أو نقاط_توقف.تابلت
    
    إذا (الشاشة.العرض >= عمودي_في)
        ارجع عمود(العناصر)
    وإلا
        ارجع صف(العناصر)
    نهاية
