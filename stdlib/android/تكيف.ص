# القائمة الجانبية المتكيفة
# ═══════════════════════════════════════════════════════════════════════════

صنف قائمة_جانبية_متكيفة
    متغير _المحتوى = لا_شيء
    متغير _القائمة = لا_شيء
    متغير _عرض_القائمة = 280
    متغير _ثابتة = خطأ
    متغير _مفتوحة = خطأ
    
    باني()
    نهاية
    
    دالة القائمة(العنصر)
        هذا._القائمة = العنصر
        ارجع هذا
    نهاية
    
    دالة المحتوى(العنصر)
        هذا._المحتوى = العنصر
        ارجع هذا
    نهاية
    
    دالة بعرض(العرض)
        هذا._عرض_القائمة = العرض
        ارجع هذا
    نهاية
    
    دالة افتح()
        هذا._مفتوحة = صحيح
        ارجع هذا
    نهاية
    
    دالة أغلق()
        هذا._مفتوحة = خطأ
        ارجع هذا
    نهاية
    
    دالة بدّل()
        هذا._مفتوحة = ليس هذا._مفتوحة
        ارجع هذا
    نهاية
    
    دالة ابنِ()
        # في الشاشات الكبيرة: قائمة ثابتة
        إذا (الشاشة.سطح_مكتب() أو (الشاشة.تابلت() و الشاشة.أفقي()))
            ارجع صف([
                حاوية(هذا._القائمة)
                    .بعرض(هذا._عرض_القائمة)
                    .بلون_خلفية(ألوان.سطح)،
                
                موسّع(هذا._المحتوى)
            ])
        وإلا
            # قائمة منزلقة
            ارجع رصة([
                هذا._المحتوى،
                
                إذا (هذا._مفتوحة)
                    رصة([
                        # خلفية معتمة
                        ضاغط(
                            حاوية()
                                .بلون_خلفية("#000000".بشفافية(0.5))
                                .بأبعاد("كامل"، "كامل")،
                            دالة()
                                هذا.أغلق()
                            نهاية
                        )،
                        
                        # القائمة
                        متحرك_موضع(
                            حاوية(هذا._القائمة)
                                .بعرض(هذا._عرض_القائمة)
                                .بارتفاع("كامل")
                                .بلون_خلفية(ألوان.سطح)،
                            من_اليمين = 0
                        )
                    ])
                وإلا
                    فارغ()
                نهاية
            ])
        نهاية
    نهاية
نهاية

