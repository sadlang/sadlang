# ═══════════════════════════════════════════════════════════════════════════
# معلومات الشاشة
# ═══════════════════════════════════════════════════════════════════════════

صنف معلومات_شاشة
    متغير العرض = 0
    متغير الارتفاع = 0
    متغير الكثافة = 1
    متغير الاتجاه = "عمودي"
    متغير نوع_الجهاز = ""
    متغير حواف_آمنة = خريطة{}
    متغير لوحة_مفاتيح_مرئية = خطأ
    متغير ارتفاع_لوحة_مفاتيح = 0
    
    باني()
        هذا._حدّث()
    نهاية
    
    دالة _حدّث()
        متغير البيانات = احصل_معلومات_شاشة()
        
        هذا.العرض = البيانات["العرض"]
        هذا.الارتفاع = البيانات["الارتفاع"]
        هذا.الكثافة = البيانات["الكثافة"]
        هذا.حواف_آمنة = البيانات["حواف_آمنة"] أو خريطة{
            "أعلى": 0،
            "أسفل": 0،
            "يمين": 0،
            "يسار": 0
        }
        
        # تحديد الاتجاه
        هذا.الاتجاه = إذا (هذا.العرض > هذا.الارتفاع) "أفقي" وإلا "عمودي"
        
        # تحديد نوع الجهاز
        هذا.نوع_الجهاز = هذا._حدد_نوع_الجهاز()
    نهاية
    
    دالة _حدد_نوع_الجهاز()
        متغير أصغر_بُعد = أصغر(هذا.العرض، هذا.الارتفاع)
        
        إذا (أصغر_بُعد < نقاط_توقف.هاتف_كبير)
            ارجع نوع_جهاز.هاتف
        والا_اذا (أصغر_بُعد < نقاط_توقف.تابلت)
            ارجع نوع_جهاز.هاتف_كبير
        والا_اذا (أصغر_بُعد < نقاط_توقف.تابلت_كبير)
            ارجع نوع_جهاز.تابلت
        والا_اذا (أصغر_بُعد < نقاط_توقف.سطح_مكتب)
            ارجع نوع_جهاز.تابلت_كبير
        وإلا
            ارجع نوع_جهاز.سطح_مكتب
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # فحوصات مساعدة
    # ─────────────────────────────────────────────────────────────────────
    
    دالة هاتف()
        ارجع هذا.نوع_الجهاز == نوع_جهاز.هاتف أو هذا.نوع_الجهاز == نوع_جهاز.هاتف_كبير
    نهاية
    
    دالة تابلت()
        ارجع هذا.نوع_الجهاز == نوع_جهاز.تابلت أو هذا.نوع_الجهاز == نوع_جهاز.تابلت_كبير
    نهاية
    
    دالة سطح_مكتب()
        ارجع هذا.نوع_الجهاز == نوع_جهاز.سطح_مكتب
    نهاية
    
    دالة أفقي()
        ارجع هذا.الاتجاه == "أفقي"
    نهاية
    
    دالة عمودي()
        ارجع هذا.الاتجاه == "عمودي"
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # قيم متكيفة
    # ─────────────────────────────────────────────────────────────────────
    
    دالة قيمة_متكيفة(قيم)
        # قيم = خريطة{"هاتف": x, "تابلت": y, "سطح_مكتب": z}
        
        إذا (هذا.هاتف() و قيم["هاتف"] != لا_شيء)
            ارجع قيم["هاتف"]
        والا_اذا (هذا.تابلت() و قيم["تابلت"] != لا_شيء)
            ارجع قيم["تابلت"]
        والا_اذا (هذا.سطح_مكتب() و قيم["سطح_مكتب"] != لا_شيء)
            ارجع قيم["سطح_مكتب"]
        وإلا
            ارجع قيم["افتراضي"] أو قيم["هاتف"]
        نهاية
    نهاية
    
    دالة نسبة_عرض(النسبة)
        ارجع هذا.العرض * النسبة
    نهاية
    
    دالة نسبة_ارتفاع(النسبة)
        ارجع هذا.الارتفاع * النسبة
    نهاية
    
    دالة العرض_الآمن()
        ارجع هذا.العرض - هذا.حواف_آمنة["يمين"] - هذا.حواف_آمنة["يسار"]
    نهاية
    
    دالة الارتفاع_الآمن()
        ارجع هذا.الارتفاع - هذا.حواف_آمنة["أعلى"] - هذا.حواف_آمنة["أسفل"]
    نهاية
نهاية

# متغير عام للشاشة
متغير الشاشة = جديد معلومات_شاشة()

# تحديث عند تغيير الحجم
عند_تغيير_حجم_شاشة(دالة()
    الشاشة._حدّث()
نهاية)

