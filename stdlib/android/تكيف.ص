صنف صورة_متكيفة
    متغير _المصادر = خريطة{}
    متغير _الوصف = ""
    
    باني()
    نهاية
    
    دالة صغيرة(المصدر)
        هذا._المصادر["صغير"] = المصدر
        ارجع هذا
    نهاية
    
    دالة متوسطة(المصدر)
        هذا._المصادر["متوسط"] = المصدر
        ارجع هذا
    نهاية
    
    دالة كبيرة(المصدر)
        هذا._المصادر["كبير"] = المصدر
        ارجع هذا
    نهاية
    
    دالة بوصف(الوصف)
        هذا._الوصف = الوصف
        ارجع هذا
    نهاية
    
    دالة ابنِ()
        متغير المصدر = ""
        
        إذا (الشاشة.هاتف())
            المصدر = هذا._المصادر["صغير"] أو هذا._المصادر["متوسط"] أو هذا._المصادر["كبير"]
        والا_اذا (الشاشة.تابلت())
            المصدر = هذا._المصادر["متوسط"] أو هذا._المصادر["كبير"] أو هذا._المصادر["صغير"]
        وإلا
            المصدر = هذا._المصادر["كبير"] أو هذا._المصادر["متوسط"] أو هذا._المصادر["صغير"]
        نهاية
        
        ارجع صورة(المصدر).بوصف(هذا._الوصف)
    نهاية
نهاية

