صنف حاوية_متكيفة
    متغير _المحتوى = لا_شيء
    متغير _أقصى_عرض = 1200
    متغير _حاشية = خريطة{}
    متغير _محاذاة = "وسط"
    
    باني(المحتوى)
        هذا._المحتوى = المحتوى
        
        # حاشية افتراضية متكيفة
        هذا._حاشية = خريطة{
            "هاتف": 16،
            "تابلت": 24،
            "سطح_مكتب": 32
        }
    نهاية
    
    دالة بأقصى_عرض(العرض)
        هذا._أقصى_عرض = العرض
        ارجع هذا
    نهاية
    
    دالة بحاشية(الحاشية)
        إذا (نوع(الحاشية) == "عدد")
            هذا._حاشية = خريطة{
                "هاتف": الحاشية،
                "تابلت": الحاشية،
                "سطح_مكتب": الحاشية
            }
        وإلا
            هذا._حاشية = الحاشية
        نهاية
        ارجع هذا
    نهاية
    
    دالة بمحاذاة(المحاذاة)
        هذا._محاذاة = المحاذاة
        ارجع هذا
    نهاية
    
    دالة ابنِ()
        متغير الحاشية = الشاشة.قيمة_متكيفة(هذا._حاشية)
        متغير العرض = أصغر(الشاشة.العرض - (الحاشية * 2)، هذا._أقصى_عرض)
        
        ارجع محاذاة(
            حاوية(هذا._المحتوى)
                .بعرض(العرض)
                .بحاشية(الحاشية)،
            هذا._محاذاة
        )
    نهاية
نهاية

دالة حاوية_قصوى(المحتوى)
    ارجع جديد حاوية_متكيفة(المحتوى)
نهاية

