# ═══════════════════════════════════════════════════════════════════════════
# الشبكة المتجاوبة
# ═══════════════════════════════════════════════════════════════════════════

صنف شبكة_متجاوبة
    متغير _الأعمدة = خريطة{}
    متغير _الفجوة = 16
    متغير _العناصر = []
    
    باني()
        # أعمدة افتراضية لكل حجم شاشة
        هذا._الأعمدة = خريطة{
            "هاتف": 4،
            "تابلت": 8،
            "سطح_مكتب": 12
        }
    نهاية
    
    دالة أعمدة(العدد_أو_الخريطة)
        إذا (نوع(العدد_أو_الخريطة) == "عدد")
            هذا._الأعمدة["هاتف"] = العدد_أو_الخريطة
            هذا._الأعمدة["تابلت"] = العدد_أو_الخريطة
            هذا._الأعمدة["سطح_مكتب"] = العدد_أو_الخريطة
        وإلا
            هذا._الأعمدة = العدد_أو_الخريطة
        نهاية
        ارجع هذا
    نهاية
    
    دالة بفجوة(الفجوة)
        هذا._الفجوة = الفجوة
        ارجع هذا
    نهاية
    
    دالة أضف(العنصر، المدى = خريطة{})
        # المدى = خريطة{"هاتف": 4, "تابلت": 4, "سطح_مكتب": 3}
        هذا._العناصر.أضف(خريطة{
            "العنصر": العنصر،
            "المدى": المدى
        })
        ارجع هذا
    نهاية
    
    دالة ابنِ()
        متغير عدد_الأعمدة = هذا._احصل_على_أعمدة()
        متغير عرض_العمود = (الشاشة.العرض - (هذا._الفجوة * (عدد_الأعمدة + 1))) / عدد_الأعمدة
        
        متغير الصفوف = []
        متغير الصف_الحالي = []
        متغير العمود_الحالي = 0
        
        لكل عنصر في هذا._العناصر
            متغير المدى = هذا._احصل_على_مدى(عنصر["المدى"])
            
            # هل يتسع في الصف الحالي؟
            إذا (العمود_الحالي + المدى > عدد_الأعمدة)
                # ابدأ صفاً جديداً
                الصفوف.أضف(الصف_الحالي)
                الصف_الحالي = []
                العمود_الحالي = 0
            نهاية
            
            # أضف العنصر
            الصف_الحالي.أضف(خريطة{
                "العنصر": عنصر["العنصر"]،
                "العرض": عرض_العمود * المدى + (هذا._الفجوة * (المدى - 1))
            })
            العمود_الحالي = العمود_الحالي + المدى
        نهاية
        
        # أضف الصف الأخير
        إذا (الصف_الحالي.طول() > 0)
            الصفوف.أضف(الصف_الحالي)
        نهاية
        
        # بناء الواجهة
        ارجع عمود([
            لكل صف في الصفوف
                صف([
                    لكل عنصر في صف
                        حاوية(عنصر["العنصر"])
                            .بعرض(عنصر["العرض"])
                            .بهامش_يمين(هذا._الفجوة)
                    نهاية
                ]).بهامش_أسفل(هذا._الفجوة)
            نهاية
        ]).بحاشية(هذا._الفجوة)
    نهاية
    
    دالة _احصل_على_أعمدة()
        إذا (الشاشة.هاتف())
            ارجع هذا._الأعمدة["هاتف"]
        والا_اذا (الشاشة.تابلت())
            ارجع هذا._الأعمدة["تابلت"]
        وإلا
            ارجع هذا._الأعمدة["سطح_مكتب"]
        نهاية
    نهاية
    
    دالة _احصل_على_مدى(المدى)
        إذا (نوع(المدى) == "عدد")
            ارجع المدى
        نهاية
        
        إذا (الشاشة.هاتف())
            ارجع المدى["هاتف"] أو هذا._الأعمدة["هاتف"]
        والا_اذا (الشاشة.تابلت())
            ارجع المدى["تابلت"] أو المدى["هاتف"] أو 4
        وإلا
            ارجع المدى["سطح_مكتب"] أو المدى["تابلت"] أو 3
        نهاية
    نهاية
نهاية

