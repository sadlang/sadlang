دالة شاشة_قفل(الإعدادات = خريطة{})
    متغير العنوان = الإعدادات["العنوان"] أو "مرحباً بك"
    متغير الرسالة = الإعدادات["الرسالة"] أو "استخدم بصمتك للدخول"
    متغير الشعار = الإعدادات["الشعار"]
    متغير عند_الفتح = الإعدادات["عند_الفتح"]
    
    ارجع صفحة(
        خلفية = الإعدادات["الخلفية"] أو ألوان.أساسي،
        محتوى = عمود_وسط([
            # الشعار
            إذا (الشعار != لا_شيء)
                صورة(الشعار).بأبعاد(150، 150)
            وإلا
                أيقونة(أيقونات.قفل).بحجم(100).بلون(ألوان.على_أساسي)
            نهاية،
            
            مسافة(32)،
            
            نص(العنوان)
                .بنمط(طباعة.عنوان_كبير)
                .بلون(ألوان.على_أساسي)،
            
            مسافة(8)،
            
            نص(الرسالة)
                .بنمط(طباعة.جسم_كبير)
                .بلون(ألوان.على_أساسي.بشفافية(0.8))
                .بمحاذاة("وسط")،
            
            مسافة(48)،
            
            # زر فتح بالبصمة
            زر_ممتلئ(
                "افتح بالبصمة"،
                دالة() غير_متزامنة
                    متغير نجح = انتظر حماية_تطبيق.افتح()
                    إذا (نجح و عند_الفتح != لا_شيء)
                        عند_الفتح()
                    نهاية
                نهاية،
                أيقونة = أيقونات.بصمة
            ).بلون(ألوان.على_أساسي).بلون_نص(ألوان.أساسي)،
            
            مسافة(16)،
            
            # زر بديل
            إذا (الإعدادات["بديل"] != لا_شيء)
                زر_نص(
                    "استخدم كلمة المرور"،
                    الإعدادات["بديل"]
                ).بلون(ألوان.على_أساسي.بشفافية(0.8))
            نهاية
        ]).بحاشية(32)
    )
نهاية
