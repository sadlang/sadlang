صنف تثبيت_شهادات
    ثابت _الشهادات = خريطة{}
    
    دالة ثابتة أضف(النطاق، البصمات)
        # البصمات = مصفوفة من SHA-256 hashes للشهادات
        تثبيت_شهادات._الشهادات[النطاق] = البصمات
    نهاية
    
    دالة ثابتة أزل(النطاق)
        احذف تثبيت_شهادات._الشهادات[النطاق]
    نهاية
    
    دالة ثابتة غير_متزامنة تحقق(النطاق، الشهادة)
        إذا (تثبيت_شهادات._الشهادات[النطاق] == لا_شيء)
            ارجع صحيح  # لا يوجد تثبيت
        نهاية
        
        متغير البصمة = انتظر أصلي_بصمة_شهادة(الشهادة)
        ارجع تثبيت_شهادات._الشهادات[النطاق].يحتوي(البصمة)
    نهاية
    
    دالة ثابتة فعّل()
        أصلي_فعّل_تثبيت_شهادات(تثبيت_شهادات._الشهادات)
    نهاية
نهاية

