# ═══════════════════════════════════════════════════════════════════════════

صنف مصادقة_بيومترية
    متغير _العنوان = "تأكيد الهوية"
    متغير _العنوان_الفرعي = ""
    متغير _الوصف = "استخدم بصمتك للتأكيد"
    متغير _زر_إلغاء = "إلغاء"
    متغير _زر_بديل = "استخدم كلمة المرور"
    متغير _السماح_بالبديل = صحيح
    متغير _النوع = نوع_بيومتري.أي
    متغير _تأكيد_مطلوب = صحيح
    
    باني()
    نهاية
    
    دالة بعنوان(العنوان)
        هذا._العنوان = العنوان
        ارجع هذا
    نهاية
    
    دالة بعنوان_فرعي(العنوان)
        هذا._العنوان_الفرعي = العنوان
        ارجع هذا
    نهاية
    
    دالة بوصف(الوصف)
        هذا._الوصف = الوصف
        ارجع هذا
    نهاية
    
    دالة بزر_إلغاء(النص)
        هذا._زر_إلغاء = النص
        ارجع هذا
    نهاية
    
    دالة بزر_بديل(النص)
        هذا._زر_بديل = النص
        هذا._السماح_بالبديل = صحيح
        ارجع هذا
    نهاية
    
    دالة بدون_بديل()
        هذا._السماح_بالبديل = خطأ
        ارجع هذا
    نهاية
    
    دالة بنوع(النوع)
        هذا._النوع = النوع
        ارجع هذا
    نهاية
    
    دالة بدون_تأكيد()
        هذا._تأكيد_مطلوب = خطأ
        ارجع هذا
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # فحص التوفر
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة متاح()
        ارجع انتظر أصلي_بيومتري_متاح()
    نهاية
    
    دالة ثابتة غير_متزامنة الأنواع_المتاحة()
        ارجع انتظر أصلي_أنواع_بيومترية()
    نهاية
    
    دالة ثابتة غير_متزامنة مسجّل()
        ارجع انتظر أصلي_بيومتري_مسجّل()
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # المصادقة
    # ─────────────────────────────────────────────────────────────────────
    
    دالة غير_متزامنة صادق()
        # التحقق من التوفر
        متغير متاح = انتظر مصادقة_بيومترية.متاح()
        إذا (ليس متاح)
            ارجع خريطة{
                "النتيجة": نتيجة_مصادقة.غير_متاح،
                "رسالة": "المصادقة البيومترية غير متاحة على هذا الجهاز"
            }
        نهاية
        
        # التحقق من التسجيل
        متغير مسجّل = انتظر مصادقة_بيومترية.مسجّل()
        إذا (ليس مسجّل)
            ارجع خريطة{
                "النتيجة": نتيجة_مصادقة.غير_مسجل،
                "رسالة": "لم يتم تسجيل أي بيانات بيومترية"
            }
        نهاية
        
        # تنفيذ المصادقة
        متغير النتيجة = انتظر أصلي_مصادقة_بيومترية(خريطة{
            "العنوان": هذا._العنوان،
            "العنوان_الفرعي": هذا._العنوان_الفرعي،
            "الوصف": هذا._الوصف،
            "زر_إلغاء": هذا._زر_إلغاء،
            "زر_بديل": هذا._زر_بديل،
            "السماح_بالبديل": هذا._السماح_بالبديل،
            "النوع": هذا._النوع،
            "تأكيد_مطلوب": هذا._تأكيد_مطلوب
        })
        
        ارجع النتيجة
    نهاية
نهاية

