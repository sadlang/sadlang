# حماية التطبيق
# ═══════════════════════════════════════════════════════════════════════════

صنف حماية_تطبيق
    ثابت _مفعّل = خطأ
    ثابت _مهلة = 5 * 60 * 1000  # 5 دقائق
    ثابت _آخر_نشاط = 0
    ثابت _مقفل = خطأ
    ثابت _معالج_قفل = لا_شيء
    
    # ─────────────────────────────────────────────────────────────────────
    # تفعيل الحماية
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة فعّل(الإعدادات = خريطة{})
        حماية_تطبيق._مفعّل = صحيح
        حماية_تطبيق._مهلة = الإعدادات["المهلة"] أو 5 * 60 * 1000
        حماية_تطبيق._آخر_نشاط = الوقت_الحالي()
        
        # منع لقطات الشاشة
        إذا (الإعدادات["منع_لقطات"] != خطأ)
            أصلي_منع_لقطات_شاشة(صحيح)
        نهاية
        
        # كشف Root/Jailbreak
        إذا (الإعدادات["كشف_root"] == صحيح)
            إذا (أصلي_كشف_root())
                ألقِ خطأ("الجهاز معدّل - خطر أمني")
            نهاية
        نهاية
        
        # كشف المحاكي
        إذا (الإعدادات["كشف_محاكي"] == صحيح)
            إذا (أصلي_كشف_محاكي())
                ألقِ خطأ("تم الكشف عن محاكي")
            نهاية
        نهاية
        
        # كشف تصحيح الأخطاء
        إذا (الإعدادات["كشف_تصحيح"] == صحيح)
            إذا (أصلي_كشف_مصحح())
                ألقِ خطأ("تم الكشف عن مصحح أخطاء")
            نهاية
        نهاية
        
        # بدء مراقبة النشاط
        حماية_تطبيق._راقب_نشاط()
    نهاية
    
    دالة ثابتة _راقب_نشاط()
        # مراقبة دورية للنشاط
        كل(1000، دالة()
            إذا (ليس حماية_تطبيق._مفعّل)
                ارجع
            نهاية
            
            متغير الآن = الوقت_الحالي()
            
            إذا (الآن - حماية_تطبيق._آخر_نشاط > حماية_تطبيق._مهلة)
                حماية_تطبيق.اقفل()
            نهاية
        نهاية)
        
        # تحديث النشاط عند أي تفاعل
        عند_تفاعل_مستخدم(دالة()
            حماية_تطبيق._آخر_نشاط = الوقت_الحالي()
        نهاية)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # القفل والفتح
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة اقفل()
        حماية_تطبيق._مقفل = صحيح
        
        إذا (حماية_تطبيق._معالج_قفل != لا_شيء)
            حماية_تطبيق._معالج_قفل()
        نهاية
    نهاية
    
    دالة ثابتة غير_متزامنة افتح()
        متغير النتيجة = انتظر صادق_بيومترياً("فتح التطبيق"، "استخدم بصمتك لفتح التطبيق")
        
        إذا (النتيجة["النتيجة"] == نتيجة_مصادقة.نجاح)
            حماية_تطبيق._مقفل = خطأ
            حماية_تطبيق._آخر_نشاط = الوقت_الحالي()
            ارجع صحيح
        نهاية
        
        ارجع خطأ
    نهاية
    
    دالة ثابتة مقفل()
        ارجع حماية_تطبيق._مقفل
    نهاية
    
    دالة ثابتة عند_القفل(المعالج)
        حماية_تطبيق._معالج_قفل = المعالج
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # حماية إضافية
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة منع_لقطات_شاشة(منع)
        أصلي_منع_لقطات_شاشة(منع)
    نهاية
    
    دالة ثابتة امسح_الذاكرة_المؤقتة()
        أصلي_امسح_ذاكرة_مؤقتة()
    نهاية
نهاية

