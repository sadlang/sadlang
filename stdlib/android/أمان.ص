# إدارة كلمات المرور
# ═══════════════════════════════════════════════════════════════════════════

صنف مدير_كلمات_مرور
    
    # ─────────────────────────────────────────────────────────────────────
    # إنشاء كلمة مرور
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة ولّد(الطول = 16، الإعدادات = خريطة{})
        متغير أحرف_كبيرة = الإعدادات["أحرف_كبيرة"] != خطأ
        متغير أحرف_صغيرة = الإعدادات["أحرف_صغيرة"] != خطأ
        متغير أرقام = الإعدادات["أرقام"] != خطأ
        متغير رموز = الإعدادات["رموز"] != خطأ
        متغير استثناء = الإعدادات["استثناء"] أو ""
        
        متغير مجموعة = ""
        
        إذا (أحرف_كبيرة)
            مجموعة = مجموعة + "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        نهاية
        
        إذا (أحرف_صغيرة)
            مجموعة = مجموعة + "abcdefghijklmnopqrstuvwxyz"
        نهاية
        
        إذا (أرقام)
            مجموعة = مجموعة + "0123456789"
        نهاية
        
        إذا (رموز)
            مجموعة = مجموعة + "!@#$%^&*()_+-=[]{}|;:,.<>?"
        نهاية
        
        # إزالة الأحرف المستثناة
        لكل حرف في استثناء
            مجموعة = مجموعة.استبدل(حرف، "")
        نهاية
        
        متغير كلمة_المرور = ""
        لكل ن في مدى(0، الطول)
            متغير فهرس = عشوائي_آمن(0، مجموعة.طول() - 1)
            كلمة_المرور = كلمة_المرور + مجموعة[فهرس]
        نهاية
        
        ارجع كلمة_المرور
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # فحص قوة كلمة المرور
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة قوة(كلمة_المرور)
        متغير النقاط = 0
        
        # الطول
        إذا (كلمة_المرور.طول() >= 8)
            النقاط = النقاط + 1
        نهاية
        إذا (كلمة_المرور.طول() >= 12)
            النقاط = النقاط + 1
        نهاية
        إذا (كلمة_المرور.طول() >= 16)
            النقاط = النقاط + 1
        نهاية
        
        # أحرف كبيرة
        إذا (يحتوي_على_نمط(كلمة_المرور، "[A-Z]"))
            النقاط = النقاط + 1
        نهاية
        
        # أحرف صغيرة
        إذا (يحتوي_على_نمط(كلمة_المرور، "[a-z]"))
            النقاط = النقاط + 1
        نهاية
        
        # أرقام
        إذا (يحتوي_على_نمط(كلمة_المرور، "[0-9]"))
            النقاط = النقاط + 1
        نهاية
        
        # رموز
        إذا (يحتوي_على_نمط(كلمة_المرور، "[^A-Za-z0-9]"))
            النقاط = النقاط + 1
        نهاية
        
        # التصنيف
        إذا (النقاط <= 2)
            ارجع خريطة{"المستوى": "ضعيفة"، "النقاط": النقاط، "اللون": "#F44336"}
        والا_اذا (النقاط <= 4)
            ارجع خريطة{"المستوى": "متوسطة"، "النقاط": النقاط، "اللون": "#FF9800"}
        والا_اذا (النقاط <= 5)
            ارجع خريطة{"المستوى": "قوية"، "النقاط": النقاط، "اللون": "#8BC34A"}
        وإلا
            ارجع خريطة{"المستوى": "قوية جداً"، "النقاط": النقاط، "اللون": "#4CAF50"}
        نهاية
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # تخزين كلمات المرور
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة احفظ(الموقع، اسم_المستخدم، كلمة_المرور)
        متغير البيانات = خريطة{
            "الموقع": الموقع،
            "اسم_المستخدم": اسم_المستخدم،
            "كلمة_المرور": كلمة_المرور،
            "التاريخ": الوقت_الحالي()
        }
        
        متغير المفتاح = "password_" + هاش(الموقع + اسم_المستخدم)
        انتظر تخزين_آمن.احفظ_محمي(المفتاح، نص_json(البيانات))
    نهاية
    
    دالة ثابتة غير_متزامنة اقرأ(الموقع، اسم_المستخدم)
        متغير المفتاح = "password_" + هاش(الموقع + اسم_المستخدم)
        متغير البيانات = انتظر تخزين_آمن.اقرأ_محمي(المفتاح)
        
        إذا (البيانات == لا_شيء)
            ارجع لا_شيء
        نهاية
        
        ارجع من_json(البيانات)
    نهاية
نهاية

