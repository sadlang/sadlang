# التشفير
# ═══════════════════════════════════════════════════════════════════════════

صنف خوارزمية_تشفير
    ثابت AES_256_GCM = "AES-256-GCM"
    ثابت AES_256_CBC = "AES-256-CBC"
    ثابت RSA_2048 = "RSA-2048"
    ثابت RSA_4096 = "RSA-4096"
    ثابت ChaCha20 = "ChaCha20-Poly1305"
نهاية

صنف تشفير
    
    # ─────────────────────────────────────────────────────────────────────
    # تشفير متماثل
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة شفّر(النص، المفتاح، الخوارزمية = خوارزمية_تشفير.AES_256_GCM)
        ارجع انتظر أصلي_شفّر_متماثل(النص، المفتاح، الخوارزمية)
    نهاية
    
    دالة ثابتة غير_متزامنة فك_تشفير(النص_المشفر، المفتاح، الخوارزمية = خوارزمية_تشفير.AES_256_GCM)
        ارجع انتظر أصلي_فك_تشفير_متماثل(النص_المشفر، المفتاح، الخوارزمية)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # تشفير غير متماثل
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة ولّد_مفاتيح(الخوارزمية = خوارزمية_تشفير.RSA_2048)
        ارجع انتظر أصلي_ولّد_مفاتيح(الخوارزمية)
        # يرجع خريطة{"عام": "...", "خاص": "..."}
    نهاية
    
    دالة ثابتة غير_متزامنة شفّر_بمفتاح_عام(النص، المفتاح_العام)
        ارجع انتظر أصلي_شفّر_غير_متماثل(النص، المفتاح_العام)
    نهاية
    
    دالة ثابتة غير_متزامنة فك_بمفتاح_خاص(النص_المشفر، المفتاح_الخاص)
        ارجع انتظر أصلي_فك_غير_متماثل(النص_المشفر، المفتاح_الخاص)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # التوقيع الرقمي
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة وقّع(البيانات، المفتاح_الخاص)
        ارجع انتظر أصلي_وقّع(البيانات، المفتاح_الخاص)
    نهاية
    
    دالة ثابتة غير_متزامنة تحقق_توقيع(البيانات، التوقيع، المفتاح_العام)
        ارجع انتظر أصلي_تحقق_توقيع(البيانات، التوقيع، المفتاح_العام)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # الهاش
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة هاش_SHA256(النص)
        ارجع أصلي_هاش("SHA-256"، النص)
    نهاية
    
    دالة ثابتة هاش_SHA512(النص)
        ارجع أصلي_هاش("SHA-512"، النص)
    نهاية
    
    دالة ثابتة هاش_BLAKE3(النص)
        ارجع أصلي_هاش("BLAKE3"، النص)
    نهاية
    
    # HMAC
    دالة ثابتة HMAC_SHA256(النص، المفتاح)
        ارجع أصلي_hmac("SHA-256"، النص، المفتاح)
    نهاية
    
    # ─────────────────────────────────────────────────────────────────────
    # كلمات المرور
    # ─────────────────────────────────────────────────────────────────────
    
    دالة ثابتة غير_متزامنة هاش_كلمة_مرور(كلمة_المرور)
        # Argon2id - أقوى خوارزمية لهاش كلمات المرور
        ارجع انتظر أصلي_argon2id(كلمة_المرور)
    نهاية
    
    دالة ثابتة غير_متزامنة تحقق_كلمة_مرور(كلمة_المرور، الهاش)
        ارجع انتظر أصلي_تحقق_argon2id(كلمة_المرور، الهاش)
    نهاية
نهاية

