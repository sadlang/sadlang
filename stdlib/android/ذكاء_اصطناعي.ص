# OCR (استخراج النص من الصور)
# ═══════════════════════════════════════════════════════════════════════════

صنف قارئ_النصوص
    متغير القارئ
    متغير اللغات
    
    باني(الإعدادات)
        هذا.اللغات = الإعدادات["اللغات"] أو ["ar"، "en"]
    نهاية
    
    دالة هيئ()
        ارجع وعد(دالة(نجح، فشل)
            هذا.القارئ = _ocr_init(هذا.اللغات)
            نجح()
        نهاية)
    نهاية
    
    دالة اقرأ(الصورة)
        ارجع وعد(دالة(نجح، فشل)
            متغير النتائج = هذا.القارئ.معالجة(الصورة)
            
            نجح({
                "النص" = النتائج.النص_الكامل،
                "الكتل" = النتائج.الكتل،
                "الأسطر" = النتائج.الأسطر،
                "الكلمات" = النتائج.الكلمات
            })
        نهاية)
    نهاية
    
    دالة اقرأ_مستند(الصورة)
        ارجع وعد(دالة(نجح، فشل)
            متغير النتائج = هذا.القارئ.معالجة_مستند(الصورة)
            
            نجح({
                "النص" = النتائج.النص،
                "الجداول" = النتائج.الجداول،
                "النماذج" = النتائج.النماذج
            })
        نهاية)
    نهاية
نهاية

