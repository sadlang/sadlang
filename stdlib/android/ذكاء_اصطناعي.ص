# TensorFlow Lite
# ═══════════════════════════════════════════════════════════════════════════

صنف نموذج_TFLite
    متغير المسار
    متغير المترجم
    متغير الأبعاد_الدخول
    متغير الأبعاد_الخروج
    
    باني(المسار)
        هذا.المسار = المسار
        هذا.المترجم = لا_شيء
    نهاية
    
    دالة حمّل()
        ارجع وعد(دالة(نجح، فشل)
            هذا.المترجم = _tflite_load(هذا.المسار)
            
            إذا (هذا.المترجم)
                هذا.الأبعاد_الدخول = هذا.المترجم.أبعاد_الدخول()
                هذا.الأبعاد_الخروج = هذا.المترجم.أبعاد_الخروج()
                نجح()
            وإلا
                فشل("فشل تحميل النموذج")
            نهاية
        نهاية)
    نهاية
    
    دالة نفّذ(البيانات)
        ارجع وعد(دالة(نجح، فشل)
            متغير النتيجة = هذا.المترجم.نفّذ(البيانات)
            نجح(النتيجة)
        نهاية)
    نهاية
    
    دالة نفّذ_صورة(الصورة)
        ارجع وعد(دالة(نجح، فشل)
            # تحويل الصورة إلى tensor
            متغير tensor = _image_to_tensor(الصورة، هذا.الأبعاد_الدخول)
            متغير النتيجة = هذا.المترجم.نفّذ(tensor)
            نجح(النتيجة)
        نهاية)
    نهاية
    
    دالة أغلق()
        إذا (هذا.المترجم)
            هذا.المترجم.أغلق()
        نهاية
    نهاية
نهاية

# GPU Delegate للتسريع
دالة نموذج_GPU(المسار)
    متغير النموذج = نموذج_TFLite(المسار)
    النموذج.فعّل_GPU()
    ارجع النموذج
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# التعرف على الصور
# ═══════════════════════════════════════════════════════════════════════════

صنف مصنف_الصور
    متغير النموذج
    متغير التسميات
    
    باني(الإعدادات)
        هذا.النموذج = لا_شيء
        هذا.التسميات = []
    نهاية
    
    دالة حمّل(مسار_النموذج، مسار_التسميات)
        ارجع وعد(دالة(نجح، فشل)
            هذا.النموذج = نموذج_TFLite(مسار_النموذج)
            انتظر هذا.النموذج.حمّل()
            
            هذا.التسميات = _load_labels(مسار_التسميات)
            نجح()
        نهاية)
    نهاية
    
    دالة صنّف(الصورة، الحد_الأدنى)
        ارجع وعد(دالة(نجح، فشل)
            متغير الحد = الحد_الأدنى أو 0.5
            متغير النتائج = انتظر هذا.النموذج.نفّذ_صورة(الصورة)
            
            متغير التصنيفات = []
            لكل فهرس، درجة في النتائج[0]
                إذا (درجة >= الحد)
                    التصنيفات.أضف({
                        "التسمية" = هذا.التسميات[فهرس]،
                        "الثقة" = درجة
                    })
                نهاية
            نهاية
            
            # ترتيب حسب الثقة
            التصنيفات.رتب(دالة(أ، ب) ارجع ب.الثقة - أ.الثقة نهاية)
            
            نجح(التصنيفات)
        نهاية)
    نهاية
نهاية

# نماذج جاهزة
