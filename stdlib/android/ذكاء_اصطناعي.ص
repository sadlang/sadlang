# التعرف على الكلام (Speech-to-Text)
# ═══════════════════════════════════════════════════════════════════════════

صنف التعرف_على_الكلام
    متغير اللغة
    متغير المعرف
    متغير نتائج_جزئية
    
    باني(الإعدادات)
        هذا.اللغة = الإعدادات["اللغة"] أو "ar-SA"
        هذا.نتائج_جزئية = الإعدادات["نتائج_جزئية"] أو صحيح
    نهاية
    
    دالة هيئ()
        ارجع وعد(دالة(نجح، فشل)
            هذا.المعرف = _speech_recognizer_init({
                "اللغة" = هذا.اللغة
            })
            نجح()
        نهاية)
    نهاية
    
    دالة ابدأ_الاستماع(معالج_النتائج، معالج_جزئي)
        هذا.المعرف.ابدأ({
            "عند_نتيجة" = معالج_النتائج،
            "عند_نتيجة_جزئية" = معالج_جزئي
        })
    نهاية
    
    دالة أوقف_الاستماع()
        هذا.المعرف.أوقف()
    نهاية
    
    دالة حوّل_صوت(مسار_الملف)
        ارجع وعد(دالة(نجح، فشل)
            متغير النص = _transcribe_audio(مسار_الملف، هذا.اللغة)
            نجح(النص)
        نهاية)
    نهاية
نهاية

# للأوامر الصوتية
صنف أوامر_صوتية
    متغير المعرف
    متغير الأوامر
    
    باني()
        هذا.المعرف = لا_شيء
        هذا.الأوامر = {}
    نهاية
    
    دالة سجّل_أمر(العبارة، المعالج)
        هذا.الأوامر[العبارة] = المعالج
        ارجع هذا
    نهاية
    
    دالة ابدأ()
        هذا.المعرف = التعرف_على_الكلام({"اللغة" = "ar-SA"})
        انتظر هذا.المعرف.هيئ()
        
        هذا.المعرف.ابدأ_الاستماع(دالة(النص)
            لكل عبارة، معالج في هذا.الأوامر
                إذا (النص.يحتوي(عبارة))
                    معالج(النص)
                    اخرج
                نهاية
            نهاية
        نهاية)
    نهاية
    
    دالة أوقف()
        إذا (هذا.المعرف)
            هذا.المعرف.أوقف_الاستماع()
        نهاية
    نهاية
نهاية

