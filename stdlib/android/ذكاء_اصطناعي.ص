# تحويل النص لكلام (Text-to-Speech)
# ═══════════════════════════════════════════════════════════════════════════

صنف تحويل_النص_كلام
    متغير المحرك
    متغير اللغة
    متغير السرعة
    متغير النغمة
    
    باني(الإعدادات)
        هذا.اللغة = الإعدادات["اللغة"] أو "ar-SA"
        هذا.السرعة = الإعدادات["السرعة"] أو 1.0
        هذا.النغمة = الإعدادات["النغمة"] أو 1.0
    نهاية
    
    دالة هيئ()
        ارجع وعد(دالة(نجح، فشل)
            هذا.المحرك = _tts_init({
                "اللغة" = هذا.اللغة،
                "السرعة" = هذا.السرعة،
                "النغمة" = هذا.النغمة
            })
            نجح()
        نهاية)
    نهاية
    
    دالة انطق(النص)
        ارجع وعد(دالة(نجح، فشل)
            هذا.المحرك.انطق(النص، دالة()
                نجح()
            نهاية)
        نهاية)
    نهاية
    
    دالة أوقف()
        هذا.المحرك.أوقف()
    نهاية
    
    دالة هل_يتكلم()
        ارجع هذا.المحرك.يتكلم
    نهاية
    
    دالة قائمة_الأصوات()
        ارجع هذا.المحرك.الأصوات_المتاحة()
    نهاية
    
    دالة عيّن_الصوت(معرف_الصوت)
        هذا.المحرك.عيّن_الصوت(معرف_الصوت)
    نهاية
نهاية

