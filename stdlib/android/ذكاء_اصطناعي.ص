    ارجع المصنف
نهاية

# كاشف الكائنات
صنف كاشف_الكائنات
    متغير النموذج
    متغير التسميات
    
    باني()
        هذا.النموذج = لا_شيء
        هذا.التسميات = []
    نهاية
    
    دالة حمّل(مسار_النموذج، مسار_التسميات)
        ارجع وعد(دالة(نجح، فشل)
            هذا.النموذج = نموذج_TFLite(مسار_النموذج)
            انتظر هذا.النموذج.حمّل()
            
            هذا.التسميات = _load_labels(مسار_التسميات)
            نجح()
        نهاية)
    نهاية
    
    دالة اكشف(الصورة، الحد_الأدنى)
        ارجع وعد(دالة(نجح، فشل)
            متغير النتائج = انتظر هذا.النموذج.نفّذ_صورة(الصورة)
            
            متغير الكائنات = []
            
            # معالجة نتائج الكشف
            لكل كائن في النتائج
                إذا (كائن.الثقة >= الحد_الأدنى أو 0.5)
                    الكائنات.أضف({
                        "التسمية" = هذا.التسميات[كائن.الفئة]،
                        "الثقة" = كائن.الثقة،
                        "المربع" = {
                            "x" = كائن.مربع[0]،
                            "y" = كائن.مربع[1]،
                            "العرض" = كائن.مربع[2]،
                            "الارتفاع" = كائن.مربع[3]
                        }
                    })
                نهاية
            نهاية
            
            نجح(الكائنات)
        نهاية)
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# التعرف على الوجوه
# ═══════════════════════════════════════════════════════════════════════════

صنف كاشف_الوجوه
    متغير الكاشف
    متغير اكتشاف_المعالم
    متغير اكتشاف_المشاعر
    
    باني(الإعدادات)
        هذا.اكتشاف_المعالم = الإعدادات["المعالم"] أو صحيح
        هذا.اكتشاف_المشاعر = الإعدادات["المشاعر"] أو صحيح
    نهاية
    
    دالة هيئ()
        ارجع وعد(دالة(نجح، فشل)
            هذا.الكاشف = _face_detector_init({
                "المعالم" = هذا.اكتشاف_المعالم،
                "المشاعر" = هذا.اكتشاف_المشاعر
            })
            نجح()
        نهاية)
    نهاية
    
    دالة اكشف(الصورة)
        ارجع وعد(دالة(نجح، فشل)
            متغير الوجوه = هذا.الكاشف.اكشف(الصورة)
            
            متغير النتائج = الوجوه.خريطة(دالة(وجه)
                ارجع {
                    "المربع" = وجه.المربع،
                    "زاوية_الدوران" = وجه.زاوية_الدوران،
                    "الابتسامة" = وجه.الابتسامة،
                    "عين_يمنى_مفتوحة" = وجه.عين_يمنى،
                    "عين_يسرى_مفتوحة" = وجه.عين_يسرى،
                    
                    # المعالم
                    "المعالم" = إذا (هذا.اكتشاف_المعالم) وجه.المعالم وإلا لا_شيء نهاية،
                    
                    # المشاعر
                    "المشاعر" = إذا (هذا.اكتشاف_المشاعر) {
                        "سعادة" = وجه.سعادة،
                        "حزن" = وجه.حزن،
                        "غضب" = وجه.غضب،
                        "دهشة" = وجه.دهشة،
                        "خوف" = وجه.خوف،
                        "اشمئزاز" = وجه.اشمئزاز
                    } وإلا لا_شيء نهاية
                }
            نهاية)
            
            نجح(النتائج)
        نهاية)
    نهاية
نهاية

# التعرف على الوجوه (Face Recognition)
صنف متعرف_الوجوه
    متغير النموذج
    متغير الوجوه_المسجلة
    
    باني()
        هذا.الوجوه_المسجلة = {}
    نهاية
    
    دالة هيئ()
        ارجع وعد(دالة(نجح، فشل)
            هذا.النموذج = نموذج_TFLite("models/facenet.tflite")
            انتظر هذا.النموذج.حمّل()
            نجح()
        نهاية)
    نهاية
    
    دالة سجّل_وجه(الاسم، الصورة)
        ارجع وعد(دالة(نجح، فشل)
            متغير التضمين = انتظر هذا.استخرج_تضمين(الصورة)
            هذا.الوجوه_المسجلة[الاسم] = التضمين
            نجح()
        نهاية)
    نهاية
    
    دالة تعرّف(الصورة)
        ارجع وعد(دالة(نجح، فشل)
            متغير التضمين = انتظر هذا.استخرج_تضمين(الصورة)
            
            متغير أقرب_تطابق = لا_شيء
            متغير أقل_مسافة = 1.0
            
            لكل اسم، تضمين_مسجل في هذا.الوجوه_المسجلة
                متغير المسافة = هذا.مسافة_يوكليدية(التضمين، تضمين_مسجل)
                
                إذا (المسافة < أقل_مسافة)
                    أقل_مسافة = المسافة
                    أقرب_تطابق = اسم
                نهاية
            نهاية
            
            إذا (أقل_مسافة < 0.6)  # عتبة التعرف
                نجح({"الاسم" = أقرب_تطابق، "الثقة" = 1 - أقل_مسافة})
            وإلا
                نجح({"الاسم" = لا_شيء، "الثقة" = 0})
            نهاية
        نهاية)
    نهاية
    
    دالة استخرج_تضمين(الصورة)
        ارجع هذا.النموذج.نفّذ_صورة(الصورة)
    نهاية
    
    دالة مسافة_يوكليدية(أ، ب)
        متغير المجموع = 0
        لكل ف في نطاق(أ.الطول())
            المجموع += (أ[ف] - ب[ف]) ** 2
        نهاية
        ارجع جذر(المجموع)
    نهاية
نهاية

