# الترجمة الفورية
# ═══════════════════════════════════════════════════════════════════════════

صنف مترجم
    متغير اللغة_المصدر
    متغير اللغة_الهدف
    متغير دون_اتصال
    
    باني(الإعدادات)
        هذا.اللغة_المصدر = الإعدادات["من"] أو "auto"
        هذا.اللغة_الهدف = الإعدادات["إلى"] أو "ar"
        هذا.دون_اتصال = الإعدادات["دون_اتصال"] أو خطأ
    نهاية
    
    دالة حمّل_نموذج_دون_اتصال()
        ارجع وعد(دالة(نجح، فشل)
            _download_translation_model(هذا.اللغة_المصدر، هذا.اللغة_الهدف)
            نجح()
        نهاية)
    نهاية
    
    دالة ترجم(النص)
        ارجع وعد(دالة(نجح، فشل)
            متغير الترجمة = _translate(النص، هذا.اللغة_المصدر، هذا.اللغة_الهدف، هذا.دون_اتصال)
            نجح(الترجمة)
        نهاية)
    نهاية
    
    دالة اكتشف_اللغة(النص)
        ارجع _detect_language(النص)
    نهاية
نهاية

دالة ترجم(النص، من، إلى)
    متغير المترجم = مترجم({"من" = من، "إلى" = إلى})
    ارجع المترجم.ترجم(النص)
نهاية

# ═══════════════════════════════════════════════════════════════════════════
# المساعد الذكي
# ═══════════════════════════════════════════════════════════════════════════

صنف مساعد_ذكي
    متغير السياق
    متغير المهارات
    متغير الذاكرة
    
    باني(الإعدادات)
        هذا.السياق = الإعدادات["السياق"] أو ""
        هذا.المهارات = []
        هذا.الذاكرة = []
    نهاية
    
    دالة أضف_مهارة(الاسم، المعالج)
        هذا.المهارات.أضف({"الاسم" = الاسم، "المعالج" = المعالج})
        ارجع هذا
    نهاية
    
    دالة تحدث(الرسالة)
        ارجع وعد(دالة(نجح، فشل)
            # إضافة للذاكرة
            هذا.الذاكرة.أضف({"الدور" = "مستخدم"، "المحتوى" = الرسالة})
            
            # تحليل النية
            متغير النية = هذا.حلل_النية(الرسالة)
            
            # البحث عن المهارة المناسبة
            لكل مهارة في هذا.المهارات
                إذا (هذا.تطابق_نية(النية، مهارة.الاسم))
                    متغير الرد = مهارة.المعالج(الرسالة، هذا.الذاكرة)
                    هذا.الذاكرة.أضف({"الدور" = "مساعد"، "المحتوى" = الرد})
                    نجح(الرد)
                    ارجع
                نهاية
            نهاية
            
            # رد افتراضي
            متغير الرد = هذا.رد_افتراضي(الرسالة)
            هذا.الذاكرة.أضف({"الدور" = "مساعد"، "المحتوى" = الرد})
            نجح(الرد)
        نهاية)
    نهاية
    
    دالة حلل_النية(النص)
        ارجع _analyze_intent(النص)
    نهاية
    
    دالة تطابق_نية(النية، اسم_المهارة)
        ارجع النية.يحتوي(اسم_المهارة)
    نهاية
    
    دالة رد_افتراضي(الرسالة)
        ارجع "آسف، لم أفهم طلبك. هل يمكنك إعادة صياغته؟"
    نهاية
    
    دالة امسح_الذاكرة()
        هذا.الذاكرة = []
    نهاية
نهاية

