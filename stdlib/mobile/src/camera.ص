/// نتيجة التقاط صورة
بنية عامة صورة_ملتقطة {
    /// مسار الملف
    مسار: نص،
    
    /// العرض بالبكسل
    عرض: ع32،
    
    /// الارتفاع بالبكسل
    ارتفاع: ع32،
    
    /// حجم الملف بالبايت
    حجم: ع64،
    
    /// التنسيق
    تنسيق: تنسيق_صورة،
    
    /// وقت الالتقاط
    وقت_التقاط: ع64،
    
    /// بيانات الموقع (إن توفرت)
    موقع: اختياري<(عش64، عش64)>،
    
    /// البيانات الثنائية (إن طُلبت في الذاكرة)
    بيانات: اختياري<قائمة<ع8>>
}

تنفيذ صورة_ملتقطة {
    /// تحميل البيانات إلى الذاكرة
    دالة عامة غير_متزامن تحميل(&ذات) -> نتيجة<قائمة<ع8>، خطأ_كاميرا> {
        إذا دع بعض(بيانات) = &ذات.بيانات {
            أرجع نجاح(بيانات.نسخ())
        }
        // قراءة من الملف
        // التنفيذ الفعلي في المنصة
        أرجع نجاح(قائمة::جديد())
    }
    
    /// حذف الصورة
    دالة عامة غير_متزامن حذف(&ذات) -> نتيجة<()، خطأ_كاميرا> {
        // حذف الملف
        // التنفيذ الفعلي في المنصة
        أرجع نجاح(())
    }
}

