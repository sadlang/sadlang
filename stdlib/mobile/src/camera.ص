// القسم التاسع: ماسح الباركود/QR
// ==========================================================================

/// ماسح الباركود و QR
بنية عامة ماسح_باركود {
    /// الكاميرا المستخدمة
    كاميرا: كاميرا،
    
    /// أنواع الباركود المدعومة
    أنواع: قائمة<نوع_باركود>،
    
    /// معاود عند المسح
    عند_مسح: اختياري<دالة(نتيجة_مسح)>
}

/// أنواع الباركود
تعداد عام نوع_باركود {
    /// QR Code
    qr،
    
    /// EAN-13
    ean13،
    
    /// EAN-8
    ean8،
    
    /// UPC-A
    upc_a،
    
    /// UPC-E
    upc_e،
    
    /// Code 128
    code128،
    
    /// Code 39
    code39،
    
    /// ITF
    itf،
    
    /// PDF417
    pdf417،
    
    /// Data Matrix
    data_matrix،
    
    /// Aztec
    aztec،
    
    /// الكل
    الكل
}

/// نتيجة المسح
بنية عامة نتيجة_مسح {
    /// المحتوى المقروء
    محتوى: نص،
    
    /// نوع الباركود
    نوع: نوع_باركود،
    
    /// موقع الباركود في الإطار
    موقع: (عش32، عش32، عش32، عش32)، // x, y, عرض, ارتفاع
    
    /// وقت المسح
    وقت: ع64
}

تنفيذ ماسح_باركود {
    /// إنشاء ماسح جديد
    دالة عامة غير_متزامن جديد() -> نتيجة<ماسح_باركود، خطأ_كاميرا> {
        دع كاميرا = انتظر كاميرا::جديد(نوع_كاميرا::خلفية)?
        
        أرجع نجاح(ماسح_باركود {
            كاميرا،
            أنواع: قائمة::من([نوع_باركود::الكل])،
            عند_مسح: لا_شيء
        })
    }
    
    /// بدء المسح
    دالة عامة غير_متزامن ابدأ(&متغير ذات) -> نتيجة<()، خطأ_كاميرا> {
        انتظر ذات.كاميرا.هيئ()?
        انتظر ذات.كاميرا.ابدأ_معاينة()?
        // بدء تحليل الإطارات
        // التنفيذ الفعلي في المنصة
        أرجع نجاح(())
    }
    
    /// إيقاف المسح
    دالة عامة غير_متزامن أوقف(&متغير ذات) -> نتيجة<()، خطأ_كاميرا> {
        انتظر ذات.كاميرا.أوقف_معاينة()?
        أرجع نجاح(())
    }
    
    /// تعيين أنواع الباركود المطلوبة
    دالة عامة أنواع(&متغير ذات، أنواع: قائمة<نوع_باركود>) -> &متغير ماسح_باركود {
        ذات.أنواع = أنواع
        أرجع ذات
    }
    
    /// تعيين معالج المسح
    دالة عامة عند_مسح(&متغير ذات، معالج: دالة(نتيجة_مسح)) -> &متغير ماسح_باركود {
        ذات.عند_مسح = بعض(معالج)
        أرجع ذات
    }
}

