    /// تسجيل الصوت
    تسجيل_صوت: منطقي،
    
    /// وضع الفلاش (شعلة)
    فلاش: وضع_فلاش،
    
    /// تثبيت الفيديو
    تثبيت: منطقي،
    
    /// الحد الأقصى للمدة (بالثواني، 0 = بلا حد)
    أقصى_مدة: ع32،
    
    /// الحد الأقصى للحجم (بايت، 0 = بلا حد)
    أقصى_حجم: ع64
}

تنفيذ إعدادات_فيديو {
    /// إعدادات افتراضية
    دالة عامة افتراضي() -> إعدادات_فيديو {
        أرجع إعدادات_فيديو {
            دقة: دقة::fhd()،
            تنسيق: تنسيق_فيديو::mp4_h264،
            معدل_إطارات: معدل_إطارات::fps_30،
            معدل_بت: 10_000_000، // 10 Mbps
            تسجيل_صوت: صحيح،
            فلاش: وضع_فلاش::إيقاف،
            تثبيت: صحيح،
            أقصى_مدة: 0،
            أقصى_حجم: 0
        }
    }
    
    /// تعيين الدقة
    دالة عامة بدقة(متغير ذات، دقة: دقة) -> إعدادات_فيديو {
        ذات.دقة = دقة
        أرجع ذات
    }
    
    /// تعيين معدل الإطارات
    دالة عامة بمعدل(متغير ذات، معدل: معدل_إطارات) -> إعدادات_فيديو {
        ذات.معدل_إطارات = معدل
        أرجع ذات
    }
    
    /// إعداد للحركة البطيئة
    دالة عامة حركة_بطيئة() -> إعدادات_فيديو {
        أرجع إعدادات_فيديو::افتراضي()
            .بدقة(دقة::hd())
            .بمعدل(معدل_إطارات::fps_120)
    }
}

