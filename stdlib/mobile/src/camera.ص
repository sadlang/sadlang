/// أخطاء الكاميرا المحتملة
تعداد عام خطأ_كاميرا {
    /// الكاميرا غير متاحة على الجهاز
    غير_متاحة،
    
    /// لم يتم منح إذن الوصول
    لا_يوجد_إذن،
    
    /// الكاميرا قيد الاستخدام من تطبيق آخر
    قيد_الاستخدام،
    
    /// فشل في تهيئة الكاميرا
    فشل_تهيئة(نص)،
    
    /// فشل في التقاط الصورة
    فشل_التقاط(نص)،
    
    /// فشل في تسجيل الفيديو
    فشل_تسجيل(نص)،
    
    /// الدقة غير مدعومة
    دقة_غير_مدعومة،
    
    /// تنسيق غير مدعوم
    تنسيق_غير_مدعوم،
    
    /// خطأ في التخزين
    خطأ_تخزين(نص)،
    
    /// خطأ عام
    خطأ_عام(نص)
}

تنفيذ خطأ_كاميرا {
    /// الحصول على رسالة الخطأ
    دالة عامة رسالة(&ذات) -> نص {
        طابق ذات {
            خطأ_كاميرا::غير_متاحة => "الكاميرا غير متاحة على هذا الجهاز"،
            خطأ_كاميرا::لا_يوجد_إذن => "لم يتم منح إذن الوصول للكاميرا"،
            خطأ_كاميرا::قيد_الاستخدام => "الكاميرا قيد الاستخدام من تطبيق آخر"،
            خطأ_كاميرا::فشل_تهيئة(رسالة) => "فشل في تهيئة الكاميرا: " + رسالة،
            خطأ_كاميرا::فشل_التقاط(رسالة) => "فشل في التقاط الصورة: " + رسالة،
            خطأ_كاميرا::فشل_تسجيل(رسالة) => "فشل في تسجيل الفيديو: " + رسالة،
            خطأ_كاميرا::دقة_غير_مدعومة => "الدقة المطلوبة غير مدعومة"،
            خطأ_كاميرا::تنسيق_غير_مدعوم => "التنسيق المطلوب غير مدعوم"،
            خطأ_كاميرا::خطأ_تخزين(رسالة) => "خطأ في التخزين: " + رسالة،
            خطأ_كاميرا::خطأ_عام(رسالة) => "خطأ: " + رسالة
        }
    }
}

