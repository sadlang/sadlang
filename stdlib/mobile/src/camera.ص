/// دقة الصورة/الفيديو
بنية عامة دقة {
    /// العرض بالبكسل
    عرض: ع32،
    
    /// الارتفاع بالبكسل
    ارتفاع: ع32
}

تنفيذ دقة {
    /// إنشاء دقة جديدة
    دالة عامة جديد(عرض: ع32، ارتفاع: ع32) -> دقة {
        أرجع دقة { عرض، ارتفاع }
    }
    
    // ═══════════════════════════════════════════
    // دقات شائعة معرّفة مسبقاً
    // ═══════════════════════════════════════════
    
    /// 480p (SD)
    دالة عامة sd() -> دقة { أرجع دقة::جديد(640, 480) }
    
    /// 720p (HD)
    دالة عامة hd() -> دقة { أرجع دقة::جديد(1280, 720) }
    
    /// 1080p (Full HD)
    دالة عامة fhd() -> دقة { أرجع دقة::جديد(1920, 1080) }
    
    /// 4K (Ultra HD)
    دالة عامة uhd() -> دقة { أرجع دقة::جديد(3840, 2160) }
    
    /// نسبة العرض إلى الارتفاع
    دالة عامة نسبة(&ذات) -> عش32 {
        أرجع ذات.عرض كـ عش32 / ذات.ارتفاع كـ عش32
    }
    
    /// إجمالي البكسلات (ميغابكسل)
    دالة عامة ميغابكسل(&ذات) -> عش32 {
        أرجع (ذات.عرض * ذات.ارتفاع) كـ عش32 / 1_000_000.0
    }
}

