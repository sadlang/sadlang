/// إعدادات التقاط الصورة
بنية عامة إعدادات_صورة {
    /// الدقة المطلوبة
    دقة: دقة،
    
    /// تنسيق الصورة
    تنسيق: تنسيق_صورة،
    
    /// وضع الفلاش
    فلاش: وضع_فلاش،
    
    /// وضع التركيز
    تركيز: وضع_تركيز،
    
    /// توازن اللون الأبيض
    توازن_أبيض: توازن_أبيض،
    
    /// تعويض التعريض (-2.0 إلى +2.0)
    تعويض_تعريض: عش32،
    
    /// تشغيل HDR
    hdr: منطقي،
    
    /// تثبيت الصورة
    تثبيت: منطقي،
    
    /// حفظ بيانات الموقع
    حفظ_موقع: منطقي،
    
    /// عكس الصورة (للكاميرا الأمامية)
    عكس: منطقي
}

تنفيذ إعدادات_صورة {
    /// إعدادات افتراضية
    دالة عامة افتراضي() -> إعدادات_صورة {
        أرجع إعدادات_صورة {
            دقة: دقة::fhd()،
            تنسيق: تنسيق_صورة::jpeg(90)،
            فلاش: وضع_فلاش::تلقائي،
            تركيز: وضع_تركيز::تلقائي،
            توازن_أبيض: توازن_أبيض::تلقائي،
            تعويض_تعريض: 0.0،
            hdr: خطأ،
            تثبيت: صحيح،
            حفظ_موقع: خطأ،
            عكس: خطأ
        }
    }
    
    /// تعيين الدقة
    دالة عامة بدقة(متغير ذات، دقة: دقة) -> إعدادات_صورة {
        ذات.دقة = دقة
        أرجع ذات
    }
    
    /// تعيين التنسيق
    دالة عامة بتنسيق(متغير ذات، تنسيق: تنسيق_صورة) -> إعدادات_صورة {
        ذات.تنسيق = تنسيق
        أرجع ذات
    }
    
    /// تفعيل HDR
    دالة عامة مع_hdr(متغير ذات) -> إعدادات_صورة {
        ذات.hdr = صحيح
        أرجع ذات
    }
}

/// إعدادات تسجيل الفيديو
بنية عامة إعدادات_فيديو {
    /// الدقة المطلوبة
