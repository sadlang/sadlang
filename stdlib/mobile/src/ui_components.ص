/// لون يمثل قيمة RGBA
///
/// # أمثلة
/// ```
/// دع أحمر = لون(255, 0, 0, 1.0)
/// دع أزرق_شفاف = لون::من_hex("#0000FF80")
/// ```
بنية عامة لون {
    /// القيمة الحمراء (0-255)
    أحمر: ع8،
    
    /// القيمة الخضراء (0-255)
    أخضر: ع8،
    
    /// القيمة الزرقاء (0-255)
    أزرق: ع8،
    
    /// الشفافية (0.0 = شفاف، 1.0 = معتم)
    شفافية: عش32
}

تنفيذ لون {
    /// إنشاء لون جديد
    دالة عامة جديد(أحمر: ع8، أخضر: ع8، أزرق: ع8، شفافية: عش32 = 1.0) -> لون {
        أرجع لون { أحمر، أخضر، أزرق، شفافية }
    }
    
    /// إنشاء لون من قيمة Hex
    دالة عامة من_hex(قيمة: نص) -> لون {
        // تحليل القيمة السداسية عشرية
        // مثال: "#FF0000" أو "#FF0000FF"
        // التنفيذ الفعلي في المترجم
        أرجع لون::أسود()
    }
    
    // ═══════════════════════════════════════════
    // الألوان الأساسية المعرّفة مسبقاً
    // ═══════════════════════════════════════════
    
    /// اللون الأحمر
    دالة عامة أحمر() -> لون { أرجع لون::جديد(255, 0, 0) }
    
    /// اللون الأخضر
    دالة عامة أخضر() -> لون { أرجع لون::جديد(0, 255, 0) }
    
    /// اللون الأزرق
    دالة عامة أزرق() -> لون { أرجع لون::جديد(0, 0, 255) }
    
    /// اللون الأصفر
    دالة عامة أصفر() -> لون { أرجع لون::جديد(255, 255, 0) }
    
    /// اللون البرتقالي
    دالة عامة برتقالي() -> لون { أرجع لون::جديد(255, 165, 0) }
    
    /// اللون البنفسجي
    دالة عامة بنفسجي() -> لون { أرجع لون::جديد(128, 0, 128) }
    
    /// اللون الوردي
    دالة عامة وردي() -> لون { أرجع لون::جديد(255, 192, 203) }
    
    /// اللون الأبيض
    دالة عامة أبيض() -> لون { أرجع لون::جديد(255, 255, 255) }
    
    /// اللون الأسود
    دالة عامة أسود() -> لون { أرجع لون::جديد(0, 0, 0) }
    
    /// اللون الرمادي
    دالة عامة رمادي() -> لون { أرجع لون::جديد(128, 128, 128) }
    
    /// اللون الشفاف
    دالة عامة شفاف() -> لون { أرجع لون::جديد(0, 0, 0, 0.0) }
    
    /// اللون الأساسي للتطبيق (يتغير حسب الثيم)
    دالة عامة أساسي() -> لون { أرجع لون::أزرق() }
    
    /// اللون الثانوي للتطبيق
    دالة عامة ثانوي() -> لون { أرجع لون::رمادي() }
}

