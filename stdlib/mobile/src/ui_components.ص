/// مكون نص - يعرض نصاً على الشاشة
///
/// # أمثلة
/// ```
/// نص("مرحباً بالعالم!")
///     .لون(.أزرق)
///     .حجم_خط(24)
///     .خط_عريض()
/// ```
بنية عامة نص {
    /// محتوى النص
    محتوى: نص،
    
    /// لون النص
    لون: لون،
    
    /// حجم الخط
    حجم_خط: عش32،
    
    /// وزن الخط (100-900)
    وزن_خط: ع32،
    
    /// محاذاة النص
    محاذاة: محاذاة،
    
    /// الحد الأقصى للأسطر (صفر = بلا حد)
    أقصى_أسطر: ع32،
    
    /// مائل أم لا
    مائل: منطقي،
    
    /// تحته خط أم لا
    تحته_خط: منطقي
}

تنفيذ نص {
    /// إنشاء نص جديد
    دالة عامة جديد(محتوى: نص) -> نص {
        أرجع نص {
            محتوى،
            لون: لون::أسود()،
            حجم_خط: 16.0،
            وزن_خط: 400،
            محاذاة: محاذاة::يمين، // افتراضي RTL
            أقصى_أسطر: 0،
            مائل: خطأ،
            تحته_خط: خطأ
        }
    }
    
    /// تعيين لون النص
    دالة عامة لون(متغير ذات، لون: لون) -> نص {
        ذات.لون = لون
        أرجع ذات
    }
    
    /// تعيين حجم الخط
    دالة عامة حجم_خط(متغير ذات، حجم: عش32) -> نص {
        ذات.حجم_خط = حجم
        أرجع ذات
    }
    
    /// جعل النص عريضاً
    دالة عامة خط_عريض(متغير ذات) -> نص {
        ذات.وزن_خط = 700
        أرجع ذات
    }
    
    /// جعل النص مائلاً
    دالة عامة مائل(متغير ذات) -> نص {
        ذات.مائل = صحيح
        أرجع ذات
    }
    
    /// تعيين محاذاة النص
    دالة عامة محاذاة(متغير ذات، م: محاذاة) -> نص {
        ذات.محاذاة = م
        أرجع ذات
    }
    
    /// تحديد الحد الأقصى للأسطر
    دالة عامة أقصى_أسطر(متغير ذات، عدد: ع32) -> نص {
        ذات.أقصى_أسطر = عدد
        أرجع ذات
    }
}

تنفيذ مكون_واجهة لـ نص {
    دالة رسم(&ذات) {
        // يُنفذ في المنصة المحددة
    }
    
    دالة الحجم(&ذات) -> (عش32، عش32) {
        // حساب الحجم بناءً على النص والخط
        أرجع (0.0، 0.0)
    }
    
    دالة تفاعلي(&ذات) -> منطقي {
        أرجع خطأ // النص غير تفاعلي افتراضياً
    }
}

