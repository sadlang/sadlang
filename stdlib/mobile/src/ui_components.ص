/// هوامش العنصر (المسافة حول العنصر)
بنية عامة هوامش {
    /// الهامش العلوي
    أعلى: عش32،
    
    /// الهامش السفلي
    أسفل: عش32،
    
    /// الهامش الأيسر (البداية في RTL)
    يسار: عش32،
    
    /// الهامش الأيمن (النهاية في RTL)
    يمين: عش32
}

تنفيذ هوامش {
    /// هوامش متساوية من جميع الجهات
    دالة عامة الكل(قيمة: عش32) -> هوامش {
        أرجع هوامش { أعلى: قيمة، أسفل: قيمة، يسار: قيمة، يمين: قيمة }
    }
    
    /// هوامش أفقية ورأسية منفصلة
    دالة عامة متماثل(أفقي: عش32، رأسي: عش32) -> هوامش {
        أرجع هوامش { أعلى: رأسي، أسفل: رأسي، يسار: أفقي، يمين: أفقي }
    }
    
    /// هوامش مخصصة لكل جهة
    دالة عامة جديد(أعلى: عش32، أسفل: عش32، يسار: عش32، يمين: عش32) -> هوامش {
        أرجع هوامش { أعلى، أسفل، يسار، يمين }
    }
    
    /// بدون هوامش
    دالة عامة صفر() -> هوامش {
        أرجع هوامش::الكل(0.0)
    }
}

