/// مكون لكل - تكرار على مجموعة
///
/// # أمثلة
/// ```
/// لكل(العناصر، معرف: \.id) { عنصر في
///     نص(عنصر.اسم)
/// }
/// ```
بنية عامة لكل<عنصر، معرف: قابل_للتجزئة> {
    /// البيانات
    بيانات: قائمة<عنصر>،
    
    /// دالة استخراج المعرف
    معرف: دالة(&عنصر) -> معرف،
    
    /// دالة بناء المحتوى
    محتوى: دالة(عنصر) -> سمة مكون_واجهة
}

تنفيذ<عنصر، معرف: قابل_للتجزئة> لكل<عنصر، معرف> {
    /// إنشاء تكرار جديد
    دالة عامة جديد(
        بيانات: قائمة<عنصر>،
        معرف: دالة(&عنصر) -> معرف،
        محتوى: دالة(عنصر) -> سمة مكون_واجهة
    ) -> لكل<عنصر، معرف> {
        أرجع لكل { بيانات، معرف، محتوى }
    }
}

// ==========================================================================
// القسم العاشر: مكونات الحوار والتنبيه
// ==========================================================================

/// مكون تنبيه - نافذة تنبيه منبثقة
///
/// # أمثلة
/// ```
/// @حالة متغير إظهار_تنبيه = خطأ
/// 
/// زر("حذف") { إظهار_تنبيه = صحيح }
///     .تنبيه($إظهار_تنبيه) {
///         تنبيه("تأكيد الحذف"، رسالة: "هل أنت متأكد؟") {
///             زر_تنبيه("حذف"، دور: .مدمر) { حذف() }
///             زر_تنبيه("إلغاء"، دور: .إلغاء) {}
///         }
///     }
/// ```
بنية عامة تنبيه {
    /// عنوان التنبيه
    عنوان: نص،
    
    /// رسالة التنبيه
    رسالة: نص،
    
    /// الأزرار
    أزرار: قائمة<زر_تنبيه>
}

/// زر داخل التنبيه
بنية عامة زر_تنبيه {
    /// نص الزر
    نص: نص،
    
    /// دور الزر
    دور: دور_زر،
    
    /// الإجراء
    إجراء: دالة()
}

/// أدوار الأزرار
تعداد عام دور_زر {
    /// افتراضي
    افتراضي،
    
    /// إلغاء
    إلغاء،
    
    /// مدمر (خطير)
    مدمر
}

تنفيذ تنبيه {
    /// إنشاء تنبيه جديد
    دالة عامة جديد(عنوان: نص، رسالة: نص = "") -> تنبيه {
        أرجع تنبيه {
            عنوان،
            رسالة،
            أزرار: قائمة::جديد()
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────

/// مكون ورقة - لوحة منزلقة من الأسفل
///
/// # أمثلة
/// ```
/// @حالة متغير إظهار_ورقة = خطأ
/// 
/// زر("عرض التفاصيل") { إظهار_ورقة = صحيح }
///     .ورقة($إظهار_ورقة) {
///         شاشة_تفاصيل()
///     }
/// ```
بنية عامة ورقة<محتوى: مكون_واجهة> {
    /// ربط الإظهار
    إظهار: &متغير منطقي،
    
    /// المحتوى
    محتوى: محتوى،
    
    /// قابل للإغلاق بالسحب
    قابل_للإغلاق: منطقي
}

تنفيذ<محتوى: مكون_واجهة> ورقة<محتوى> {
    /// إنشاء ورقة جديدة
    دالة عامة جديد(إظهار: &متغير منطقي، محتوى: محتوى) -> ورقة<محتوى> {
        أرجع ورقة {
            إظهار،
            محتوى،
            قابل_للإغلاق: صحيح
        }
    }
}

// ==========================================================================
// القسم الحادي عشر: المعدّلات العامة
// ==========================================================================

/// معدّلات يمكن تطبيقها على أي مكون
سمة عامة معدّل<ذات: مكون_واجهة> {
    /// تعيين الحشوة
    دالة حشوة(ذات، قيمة: حشوة) -> ذات
    
    /// تعيين لون الخلفية
    دالة لون_خلفية(ذات، لون: لون) -> ذات
    
    /// تعيين العرض والارتفاع
    دالة إطار(ذات، عرض: بُعد، ارتفاع: بُعد) -> ذات
    
    /// إضافة ظل
    دالة ظل(ذات، نصف_قطر: عش32، لون: لون) -> ذات
    
    /// تعيين الشفافية
    دالة شفافية(ذات، قيمة: عش32) -> ذات
    
    /// إضافة زوايا مستديرة
    دالة زوايا(ذات، نصف_قطر: عش32) -> ذات
    
    /// إضافة حد
    دالة حد(ذات، لون: لون، سمك: عش32) -> ذات
    
    /// إضافة معالج نقر
    دالة عند_النقر(ذات، معالج: دالة()) -> ذات
    
    /// تعيين الإخفاء
    دالة مخفي(ذات، قيمة: منطقي) -> ذات
    
    /// تعيين التعطيل
    دالة معطّل(ذات، قيمة: منطقي) -> ذات
}

