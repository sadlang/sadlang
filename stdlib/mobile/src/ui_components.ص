/// مكون أيقونة - يعرض أيقونة من مجموعة الأيقونات
///
/// # أمثلة
/// ```
/// أيقونة("home")
///     .لون(.أساسي)
///     .حجم(24)
/// ```
بنية عامة أيقونة {
    /// اسم الأيقونة
    اسم: نص،
    
    /// لون الأيقونة
    لون: لون،
    
    /// حجم الأيقونة
    حجم: عش32
}

تنفيذ أيقونة {
    /// إنشاء أيقونة جديدة
    دالة عامة جديد(اسم: نص) -> أيقونة {
        أرجع أيقونة {
            اسم،
            لون: لون::أساسي()،
            حجم: 24.0
        }
    }
    
    /// تعيين اللون
    دالة عامة لون(متغير ذات، لون: لون) -> أيقونة {
        ذات.لون = لون
        أرجع ذات
    }
    
    /// تعيين الحجم
    دالة عامة حجم(متغير ذات، حجم: عش32) -> أيقونة {
        ذات.حجم = حجم
        أرجع ذات
    }
    
    // ═══════════════════════════════════════════
    // أيقونات شائعة معرّفة مسبقاً
    // ═══════════════════════════════════════════
    
    دالة عامة رئيسية() -> أيقونة { أرجع أيقونة::جديد("home") }
    دالة عامة بحث() -> أيقونة { أرجع أيقونة::جديد("search") }
    دالة عامة إعدادات() -> أيقونة { أرجع أيقونة::جديد("settings") }
    دالة عامة ملف_شخصي() -> أيقونة { أرجع أيقونة::جديد("person") }
    دالة عامة إضافة() -> أيقونة { أرجع أيقونة::جديد("add") }
    دالة عامة حذف() -> أيقونة { أرجع أيقونة::جديد("delete") }
    دالة عامة تعديل() -> أيقونة { أرجع أيقونة::جديد("edit") }
    دالة عامة رسالة() -> أيقونة { أرجع أيقونة::جديد("message") }
    دالة عامة قلب() -> أيقونة { أرجع أيقونة::جديد("favorite") }
    دالة عامة نجمة() -> أيقونة { أرجع أيقونة::جديد("star") }
}

