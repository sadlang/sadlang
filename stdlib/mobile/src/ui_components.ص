/// ```
بنية عامة قائمة {
    /// نمط القائمة
    نمط: نمط_قائمة،
    
    /// إظهار الفواصل
    إظهار_فواصل: منطقي
}

/// أنماط القائمة
تعداد عام نمط_قائمة {
    /// عادي
    عادي،
    
    /// مجمّع (بخلفية)
    مجمّع،
    
    /// بطاقة
    بطاقة،
    
    /// مضمّن (بدون حشوة)
    مضمّن
}

تنفيذ قائمة {
    /// إنشاء قائمة جديدة
    دالة عامة جديد() -> قائمة {
        أرجع قائمة {
            نمط: نمط_قائمة::عادي،
            إظهار_فواصل: صحيح
        }
    }
    
    /// تعيين النمط
    دالة عامة نمط(متغير ذات، نمط: نمط_قائمة) -> قائمة {
        ذات.نمط = نمط
        أرجع ذات
    }
    
    /// إخفاء الفواصل
    دالة عامة بدون_فواصل(متغير ذات) -> قائمة {
        ذات.إظهار_فواصل = خطأ
        أرجع ذات
    }
}

