/// مكون منتقي - لاختيار عنصر من قائمة
///
/// # أمثلة
/// ```
/// @حالة متغير الاختيار = 0
/// 
/// منتقي($الاختيار) {
///     نص("الخيار أ")
///     نص("الخيار ب")
///     نص("الخيار ج")
/// }
/// ```
بنية عامة منتقي<T> {
    /// ربط القيمة المختارة
    اختيار: &متغير T،
    
    /// عنوان المنتقي
    عنوان: نص،
    
    /// نمط العرض
    نمط: نمط_منتقي
}

/// أنماط عرض المنتقي
تعداد عام نمط_منتقي {
    /// عجلة (افتراضي iOS)
    عجلة،
    
    /// قائمة منسدلة
    منسدل،
    
    /// أزرار مقسمة
    مقسم،
    
    /// قائمة
    قائمة
}

تنفيذ<T> منتقي<T> {
    /// إنشاء منتقي جديد
    دالة عامة جديد(اختيار: &متغير T) -> منتقي<T> {
        أرجع منتقي {
            اختيار،
            عنوان: ""،
            نمط: نمط_منتقي::منسدل
        }
    }
    
    /// تعيين العنوان
    دالة عامة عنوان(متغير ذات، نص: نص) -> منتقي<T> {
        ذات.عنوان = نص
        أرجع ذات
    }
    
    /// تعيين نمط العرض
    دالة عامة نمط(متغير ذات، نمط: نمط_منتقي) -> منتقي<T> {
        ذات.نمط = نمط
        أرجع ذات
    }
}

