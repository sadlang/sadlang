/// مكون قسم - قسم داخل القائمة
///
/// # أمثلة
/// ```
/// قائمة {
///     قسم("الإعدادات العامة") {
///         مبدّل($إشعارات).تسمية("الإشعارات")
///         مبدّل($الوضع_الليلي).تسمية("الوضع الليلي")
///     }
/// }
/// ```
بنية عامة قسم {
    /// عنوان القسم
    عنوان: نص،
    
    /// تذييل القسم
    تذييل: اختياري<نص>
}

تنفيذ قسم {
    /// إنشاء قسم جديد
    دالة عامة جديد(عنوان: نص) -> قسم {
        أرجع قسم {
            عنوان،
            تذييل: لا_شيء
        }
    }
    
    /// تعيين التذييل
    دالة عامة تذييل(متغير ذات، نص: نص) -> قسم {
        ذات.تذييل = بعض(نص)
        أرجع ذات
    }
}

