    حد_أقصى: عش32،
    
    /// الخطوة
    خطوة: عش32،
    
    /// لون الشريط
    لون: لون
}

تنفيذ شريط_تمرير {
    /// إنشاء شريط تمرير جديد
    دالة عامة جديد(قيمة: &متغير عش32، حد_أدنى: عش32 = 0.0، حد_أقصى: عش32 = 1.0) -> شريط_تمرير {
        أرجع شريط_تمرير {
            قيمة،
            حد_أدنى،
            حد_أقصى،
            خطوة: 0.0، // مستمر
