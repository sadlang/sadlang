/// بُعد يمثل قياس حجم أو مسافة
///
/// # الوحدات المدعومة
/// - نقاط: وحدات مستقلة الكثافة
/// - نسبة: نسبة مئوية من الحاوية
/// - ملء: يملأ المساحة المتاحة
/// - ملائم: يتناسب مع المحتوى
تعداد عام بُعد {
    /// قيمة بالنقاط (dp على Android، pt على iOS)
    نقاط(عش32)،
    
    /// نسبة مئوية من الأب (0.0 - 1.0)
    نسبة(عش32)،
    
    /// يملأ كل المساحة المتاحة
    ملء،
    
    /// يتناسب مع حجم المحتوى
    ملائم،
    
    /// تلقائي (يحدده النظام)
    تلقائي
}

تنفيذ بُعد {
    /// إنشاء بُعد بالنقاط
    دالة عامة نق(قيمة: عش32) -> بُعد {
        أرجع بُعد::نقاط(قيمة)
    }
    
    /// إنشاء بُعد بالنسبة المئوية
    دالة عامة في_المئة(قيمة: عش32) -> بُعد {
        أرجع بُعد::نسبة(قيمة / 100.0)
    }
}

