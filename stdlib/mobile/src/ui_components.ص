/// 
/// شريط_تمرير($القيمة، نطاق: 0.0...100.0)
///     .خطوة(1.0)
/// ```
بنية عامة شريط_تمرير {
    /// ربط القيمة
    قيمة: &متغير عش32،
    
    /// الحد الأدنى
    حد_أدنى: عش32،
    
