/// مكون صورة - يعرض صورة من ملف أو رابط
///
/// # أمثلة
/// ```
/// صورة("assets/logo.png")
///     .عرض(100)
///     .ارتفاع(100)
///     .دائري(50)
/// ```
بنية عامة صورة {
    /// مصدر الصورة (مسار أو رابط)
    مصدر: نص،
    
    /// عرض الصورة
    عرض: بُعد،
    
    /// ارتفاع الصورة
    ارتفاع: بُعد،
    
    /// نصف قطر الزوايا
    نصف_قطر_زاوية: عش32،
    
    /// وصف الصورة (للوصول)
    وصف: نص،
    
    /// وضع الملاءمة
    ملاءمة: وضع_ملاءمة
}

/// أوضاع ملاءمة الصورة
تعداد عام وضع_ملاءمة {
    /// تمدد الصورة لتملأ المساحة
    تمدد،
    
    /// تحافظ على النسبة وتملأ المساحة (قد يقطع)
    تغطية،
    
    /// تحافظ على النسبة وتظهر كاملة (قد يظهر فراغ)
    احتواء،
    
    /// الحجم الأصلي
    أصلي
}

تنفيذ صورة {
    /// إنشاء صورة جديدة
    دالة عامة جديد(مصدر: نص) -> صورة {
        أرجع صورة {
            مصدر،
            عرض: بُعد::ملائم،
            ارتفاع: بُعد::ملائم،
            نصف_قطر_زاوية: 0.0،
            وصف: ""،
            ملاءمة: وضع_ملاءمة::احتواء
        }
    }
    
    /// تعيين العرض
    دالة عامة عرض(متغير ذات، قيمة: عش32) -> صورة {
        ذات.عرض = بُعد::نقاط(قيمة)
        أرجع ذات
    }
    
    /// تعيين الارتفاع
    دالة عامة ارتفاع(متغير ذات، قيمة: عش32) -> صورة {
        ذات.ارتفاع = بُعد::نقاط(قيمة)
        أرجع ذات
    }
    
    /// جعل الصورة دائرية
    دالة عامة دائري(متغير ذات، نصف_قطر: عش32) -> صورة {
        ذات.نصف_قطر_زاوية = نصف_قطر
        أرجع ذات
    }
    
    /// تعيين وصف للوصول
    دالة عامة وصف(متغير ذات، نص: نص) -> صورة {
        ذات.وصف = نص
        أرجع ذات
    }
}

تنفيذ مكون_واجهة لـ صورة {
    دالة رسم(&ذات) {
        // يُنفذ في المنصة المحددة
    }
    
    دالة الحجم(&ذات) -> (عش32، عش32) {
        // إرجاع الحجم المحدد أو الأصلي
        أرجع (0.0، 0.0)
    }
    
    دالة تفاعلي(&ذات) -> منطقي {
        أرجع خطأ
    }
}

