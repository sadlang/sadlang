/// مكون زر - زر تفاعلي يمكن النقر عليه
///
/// # أمثلة
/// ```
/// زر("اضغط هنا") {
///     اطبع("تم الضغط!")
/// }
/// .لون_خلفية(.أساسي)
/// .لون_نص(.أبيض)
/// ```
بنية عامة زر {
    /// نص الزر
    نص: نص،
    
    /// دالة الإجراء عند الضغط
    إجراء: دالة()،
    
    /// لون الخلفية
    لون_خلفية: لون،
    
    /// لون النص
    لون_نص: لون،
    
    /// مفعّل أم لا
    مفعّل: منطقي،
    
    /// نصف قطر الزاوية
    نصف_قطر_زاوية: عش32،
    
    /// الحشوة الداخلية
    حشوة: حشوة
}

تنفيذ زر {
    /// إنشاء زر جديد
    دالة عامة جديد(نص: نص، إجراء: دالة()) -> زر {
        أرجع زر {
            نص،
            إجراء،
            لون_خلفية: لون::أساسي()،
            لون_نص: لون::أبيض()،
            مفعّل: صحيح،
            نصف_قطر_زاوية: 8.0،
            حشوة: حشوة::متماثل(16.0، 8.0)
        }
    }
    
    /// تعيين لون الخلفية
    دالة عامة لون_خلفية(متغير ذات، لون: لون) -> زر {
        ذات.لون_خلفية = لون
        أرجع ذات
    }
    
    /// تعيين لون النص
    دالة عامة لون_نص(متغير ذات، لون: لون) -> زر {
        ذات.لون_نص = لون
        أرجع ذات
    }
    
    /// تعطيل الزر
    دالة عامة معطّل(متغير ذات، قيمة: منطقي = صحيح) -> زر {
        ذات.مفعّل = !قيمة
        أرجع ذات
    }
    
    /// تعيين نصف قطر الزاوية
    دالة عامة زوايا(متغير ذات، نصف_قطر: عش32) -> زر {
        ذات.نصف_قطر_زاوية = نصف_قطر
        أرجع ذات
    }
}

تنفيذ قابل_للنقر لـ زر {
    دالة عند_النقر(&متغير ذات) {
        إذا ذات.مفعّل {
            (ذات.إجراء)()
        }
    }
    
    دالة عند_ضغط_مطول(&متغير ذات) {
        // لا إجراء افتراضي
    }
}

