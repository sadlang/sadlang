/// مكون حقل نص - حقل إدخال نص
///
/// # أمثلة
/// ```
/// @حالة متغير الاسم = ""
/// 
/// حقل_نص("أدخل اسمك"، $الاسم)
///     .نوع_لوحة(.عادي)
/// ```
بنية عامة حقل_نص {
    /// نص التلميح
    تلميح: نص،
    
    /// ربط القيمة
    قيمة: &متغير نص،
    
    /// نوع لوحة المفاتيح
    نوع_لوحة: نوع_لوحة_مفاتيح،
    
    /// إخفاء النص (كلمة مرور)
    آمن: منطقي،
    
    /// تسمية الحقل
    تسمية: نص،
    
    /// رسالة الخطأ
    خطأ: اختياري<نص>
}

/// أنواع لوحة المفاتيح
تعداد عام نوع_لوحة_مفاتيح {
    /// لوحة عادية
    عادي،
    
    /// بريد إلكتروني
    بريد،
    
    /// أرقام فقط
    أرقام،
    
    /// هاتف
    هاتف،
    
    /// رابط
    رابط،
    
    /// كلمة مرور
    كلمة_مرور
}

تنفيذ حقل_نص {
    /// إنشاء حقل نص جديد
    دالة عامة جديد(تلميح: نص، قيمة: &متغير نص) -> حقل_نص {
        أرجع حقل_نص {
            تلميح،
            قيمة،
            نوع_لوحة: نوع_لوحة_مفاتيح::عادي،
            آمن: خطأ،
            تسمية: ""،
            خطأ: لا_شيء
        }
    }
    
    /// تعيين نوع لوحة المفاتيح
    دالة عامة نوع_لوحة(متغير ذات، نوع: نوع_لوحة_مفاتيح) -> حقل_نص {
        ذات.نوع_لوحة = نوع
        أرجع ذات
    }
    
    /// جعل الحقل آمناً (كلمة مرور)
    دالة عامة آمن(متغير ذات، قيمة: منطقي = صحيح) -> حقل_نص {
        ذات.آمن = قيمة
        إذا قيمة {
            ذات.نوع_لوحة = نوع_لوحة_مفاتيح::كلمة_مرور
        }
        أرجع ذات
    }
    
    /// تعيين التسمية
    دالة عامة تسمية(متغير ذات، نص: نص) -> حقل_نص {
        ذات.تسمية = نص
        أرجع ذات
    }
    
    /// تعيين رسالة الخطأ
    دالة عامة خطأ(متغير ذات، رسالة: نص) -> حقل_نص {
        ذات.خطأ = بعض(رسالة)
        أرجع ذات
    }
}

