// ============== المكونات الأساسية ==============

/**
 * مكون التحويل
 */
صنف مكون_تحويل:
    خاص:
        _الموضع: متجه٣
        _الدوران: رباعي
        _المقياس: متجه٣
        _مصفوفة_محلية: مصفوفة٤
        _مصفوفة_عالمية: مصفوفة٤
        _متغير: منطقي
    
    عام:
        دالة جديد() -> مكون_تحويل:
            متغير ت = مكون_تحويل()
            ت._الموضع = متجه٣_صفر()
            ت._الدوران = رباعي_هوية()
            ت._المقياس = متجه٣_واحد()
            ت._متغير = صحيح
            أرجع ت
        نهاية
        
        // الموضع
        دالة الموضع(ذاتي) -> متجه٣:
            أرجع ذاتي._الموضع
        نهاية
        
        دالة تعيين_الموضع(ذاتي، موضع: متجه٣):
            ذاتي._الموضع = موضع
            ذاتي._متغير = صحيح
        نهاية
        
        دالة إزاحة(ذاتي، إزاحة: متجه٣):
            ذاتي._الموضع = ذاتي._الموضع.جمع(إزاحة)
            ذاتي._متغير = صحيح
        نهاية
        
        // الدوران
        دالة الدوران(ذاتي) -> رباعي:
            أرجع ذاتي._الدوران
        نهاية
        
        دالة تعيين_الدوران(ذاتي، دوران: رباعي):
            ذاتي._الدوران = دوران
            ذاتي._متغير = صحيح
        نهاية
        
        دالة تعيين_أويلر(ذاتي، أويلر: متجه٣):
            ذاتي._الدوران = رباعي_من_أويلر(أويلر.س، أويلر.ص، أويلر.ع)
            ذاتي._متغير = صحيح
        نهاية
        
        دالة تدوير(ذاتي، محور: متجه٣، زاوية: عدد_حقيقي):
            ذاتي._الدوران = رباعي_من_محور(محور، زاوية).ضرب(ذاتي._الدوران)
            ذاتي._متغير = صحيح
        نهاية
        
        // المقياس
        دالة المقياس(ذاتي) -> متجه٣:
            أرجع ذاتي._المقياس
        نهاية
        
        دالة تعيين_المقياس(ذاتي، مقياس: متجه٣):
            ذاتي._المقياس = مقياس
            ذاتي._متغير = صحيح
        نهاية
        
        // المصفوفات
        دالة المصفوفة_المحلية(ذاتي) -> مصفوفة٤:
            إذا ذاتي._متغير:
                ذاتي._تحديث_المصفوفة()
            نهاية
            أرجع ذاتي._مصفوفة_محلية
        نهاية
        
        دالة _تحديث_المصفوفة(ذاتي):
            متغير إزاحة = مصفوفة_إزاحة(ذاتي._الموضع)
            متغير دوران = مصفوفة_من_رباعي(ذاتي._الدوران)
            متغير مقياس = مصفوفة_مقياس(ذاتي._المقياس)
            
            ذاتي._مصفوفة_محلية = إزاحة.ضرب(دوران).ضرب(مقياس)
            ذاتي._متغير = خطأ
        نهاية
        
        // الاتجاهات
        دالة الأمام(ذاتي) -> متجه٣:
            أرجع ذاتي._الدوران.دوّر(متجه٣(0، 0، -1))
        نهاية
        
        دالة اليمين(ذاتي) -> متجه٣:
            أرجع ذاتي._الدوران.دوّر(متجه٣(1، 0، 0))
        نهاية
        
        دالة الأعلى(ذاتي) -> متجه٣:
            أرجع ذاتي._الدوران.دوّر(متجه٣(0، 1، 0))
        نهاية
        
        دالة نظر_إلى(ذاتي، هدف: متجه٣):
            ذاتي._الدوران = رباعي_نظر_إلى(ذاتي._الموضع، هدف)
            ذاتي._متغير = صحيح
        نهاية
نهاية

// ============== عقدة المشهد ==============

/**
 * عقدة في شجرة المشهد
 */
صنف عقدة:
    خاص:
        _الاسم: نص
        _التحويل: مكون_تحويل
        _الأب: عقدة؟
        _الأبناء: قائمة<عقدة>
        _المكونات: قائمة<مكون>
        _نشط: منطقي
        _مرئي: منطقي
    
    عام:
        دالة جديد(اسم: نص = "عقدة") -> عقدة:
            متغير ع = عقدة()
            ع._الاسم = اسم
            ع._التحويل = مكون_تحويل.جديد()
            ع._الأبناء = قائمة<عقدة>()
            ع._المكونات = قائمة<مكون>()
            ع._نشط = صحيح
            ع._مرئي = صحيح
            أرجع ع
        نهاية
        
        // الخصائص
        دالة الاسم(ذاتي) -> نص:
            أرجع ذاتي._الاسم
        نهاية
        
        دالة تعيين_الاسم(ذاتي، اسم: نص):
            ذاتي._الاسم = اسم
        نهاية
        
        دالة التحويل(ذاتي) -> مكون_تحويل:
            أرجع ذاتي._التحويل
        نهاية
        
        دالة نشط(ذاتي) -> منطقي:
            أرجع ذاتي._نشط
        نهاية
        
        دالة تعيين_النشاط(ذاتي، نشط: منطقي):
            ذاتي._نشط = نشط
        نهاية
        
        دالة مرئي(ذاتي) -> منطقي:
            أرجع ذاتي._مرئي
        نهاية
        
        دالة تعيين_الرؤية(ذاتي، مرئي: منطقي):
            ذاتي._مرئي = مرئي
        نهاية
        
        // التسلسل الهرمي
        دالة الأب(ذاتي) -> عقدة؟:
            أرجع ذاتي._الأب
        نهاية
        
        دالة الأبناء(ذاتي) -> قائمة<عقدة>:
            أرجع ذاتي._الأبناء
        نهاية
        
        دالة إضافة_ابن(ذاتي، ابن: عقدة):
            إذا ابن._الأب != فارغ:
                ابن._الأب.إزالة_ابن(ابن)
            نهاية
            
            ابن._الأب = ذاتي
            ذاتي._الأبناء.أضف(ابن)
        نهاية
        
        دالة إزالة_ابن(ذاتي، ابن: عقدة):
            متغير فهرس = ذاتي._الأبناء.فهرس(ابن)
            إذا فهرس >= 0:
                ذاتي._الأبناء.احذف(فهرس)
                ابن._الأب = فارغ
            نهاية
        نهاية
        
        دالة البحث(ذاتي، اسم: نص) -> عقدة؟:
            إذا ذاتي._الاسم == اسم:
                أرجع ذاتي
            نهاية
            
            لكل ابن في ذاتي._الأبناء:
                متغير نتيجة = ابن.البحث(اسم)
                إذا نتيجة != فارغ:
                    أرجع نتيجة
                نهاية
            نهاية
            
            أرجع فارغ
        نهاية
        
        // المكونات
        دالة إضافة_مكون<ت: مكون>(ذاتي، مكون: ت):
            مكون._تعيين_العقدة(ذاتي)
            ذاتي._المكونات.أضف(مكون)
        نهاية
        
        دالة الحصول_على_مكون<ت: مكون>(ذاتي) -> ت؟:
            لكل مكون في ذاتي._المكونات:
                إذا مكون هو ت:
                    أرجع مكون كـ ت
                نهاية
            نهاية
            أرجع فارغ
        نهاية
        
        دالة الحصول_على_كل_مكونات<ت: مكون>(ذاتي) -> قائمة<ت>:
            متغير نتيجة = قائمة<ت>()
            لكل مكون في ذاتي._المكونات:
                إذا مكون هو ت:
                    نتيجة.أضف(مكون كـ ت)
                نهاية
            نهاية
            أرجع نتيجة
        نهاية
        
        // التحديث والرسم
        دالة تحديث(ذاتي، دلتا: عدد_حقيقي):
            إذا !ذاتي._نشط:
                أرجع
            نهاية
            
            // تحديث المكونات
            لكل مكون في ذاتي._المكونات:
                مكون.تحديث(دلتا)
            نهاية
            
            // تحديث الأبناء
            لكل ابن في ذاتي._الأبناء:
                ابن.تحديث(دلتا)
            نهاية
        نهاية
        
        دالة رسم(ذاتي، سياق: سياق_رسم):
            إذا !ذاتي._نشط أو !ذاتي._مرئي:
                أرجع
            نهاية
            
            // حفظ المصفوفة
            سياق.دفع_مصفوفة()
            سياق.ضرب_مصفوفة(ذاتي._التحويل.المصفوفة_المحلية())
            
            // رسم المكونات
            لكل مكون في ذاتي._المكونات:
                مكون.رسم(سياق)
            نهاية
            
            // رسم الأبناء
            لكل ابن في ذاتي._الأبناء:
                ابن.رسم(سياق)
            نهاية
            
            // استعادة المصفوفة
            سياق.سحب_مصفوفة()
        نهاية
        
        // الموضع العالمي
        دالة الموضع_العالمي(ذاتي) -> متجه٣:
            إذا ذاتي._الأب == فارغ:
                أرجع ذاتي._التحويل.الموضع()
            نهاية
            
            // حساب المصفوفة العالمية
            متغير مصفوفة = ذاتي._حساب_المصفوفة_العالمية()
            أرجع متجه٣(مصفوفة.عناصر[12]، مصفوفة.عناصر[13]، مصفوفة.عناصر[14])
        نهاية
        
        دالة _حساب_المصفوفة_العالمية(ذاتي) -> مصفوفة٤:
            إذا ذاتي._الأب == فارغ:
                أرجع ذاتي._التحويل.المصفوفة_المحلية()
            نهاية
            
            أرجع ذاتي._الأب._حساب_المصفوفة_العالمية().ضرب(ذاتي._التحويل.المصفوفة_المحلية())
        نهاية
نهاية

// ============== واجهة المكون ==============

/**
 * واجهة المكون الأساسية
 */
واجهة مكون:
    دالة _تعيين_العقدة(عقدة: عقدة)
    دالة العقدة() -> عقدة؟
    دالة تحديث(دلتا: عدد_حقيقي)
    دالة رسم(سياق: سياق_رسم)
نهاية

// ============== المشهد ==============

/**
 * المشهد الرئيسي
 */
صنف مشهد:
    خاص:
        _الجذر: عقدة
        _الكاميرات: قائمة<كاميرا>
        _الأضواء: قائمة<ضوء>
        _الكاميرا_النشطة: كاميرا؟
    
    عام:
        دالة جديد() -> مشهد:
            متغير م = مشهد()
            م._الجذر = عقدة.جديد("الجذر")
            م._الكاميرات = قائمة<كاميرا>()
            م._الأضواء = قائمة<ضوء>()
            أرجع م
        نهاية
        
        دالة الجذر(ذاتي) -> عقدة:
            أرجع ذاتي._الجذر
        نهاية
        
        دالة إضافة(ذاتي، عقدة: عقدة):
            ذاتي._الجذر.إضافة_ابن(عقدة)
        نهاية
        
        دالة البحث(ذاتي، اسم: نص) -> عقدة؟:
            أرجع ذاتي._الجذر.البحث(اسم)
        نهاية
        
        // الكاميرات
        دالة إضافة_كاميرا(ذاتي، كاميرا: كاميرا):
            ذاتي._الكاميرات.أضف(كاميرا)
            إذا ذاتي._الكاميرا_النشطة == فارغ:
                ذاتي._الكاميرا_النشطة = كاميرا
            نهاية
        نهاية
        
        دالة الكاميرا_النشطة(ذاتي) -> كاميرا؟:
            أرجع ذاتي._الكاميرا_النشطة
        نهاية
        
        دالة تعيين_الكاميرا_النشطة(ذاتي، كاميرا: كاميرا):
            ذاتي._الكاميرا_النشطة = كاميرا
        نهاية
        
        // الأضواء
        دالة إضافة_ضوء(ذاتي، ضوء: ضوء):
            ذاتي._الأضواء.أضف(ضوء)
        نهاية
        
        دالة الأضواء(ذاتي) -> قائمة<ضوء>:
            أرجع ذاتي._الأضواء
        نهاية
        
        // التحديث والرسم
        دالة تحديث(ذاتي، دلتا: عدد_حقيقي):
            ذاتي._الجذر.تحديث(دلتا)
        نهاية
        
        دالة رسم(ذاتي، سياق: سياق_رسم):
            إذا ذاتي._الكاميرا_النشطة != فارغ:
                سياق.تعيين_مصفوفة_العرض(ذاتي._الكاميرا_النشطة.مصفوفة_العرض())
                سياق.تعيين_مصفوفة_الإسقاط(ذاتي._الكاميرا_النشطة.مصفوفة_الإسقاط())
            نهاية
            
            ذاتي._الجذر.رسم(سياق)
        نهاية
نهاية

// ============== الكاميرا ==============

تعداد نوع_إسقاط:
    منظوري
    متعامد
نهاية

صنف كاميرا:
    خاص:
        _العقدة: عقدة؟
        _نوع_الإسقاط: نوع_إسقاط
        _مجال_الرؤية: عدد_حقيقي
        _القريب: عدد_حقيقي
        _البعيد: عدد_حقيقي
        _نسبة_العرض: عدد_حقيقي
    
    عام:
        دالة جديد() -> كاميرا:
            متغير ك = كاميرا()
            ك._نوع_الإسقاط = نوع_إسقاط.منظوري
            ك._مجال_الرؤية = ط / 4  // 45 درجة
            ك._القريب = 0.1
            ك._البعيد = 1000.0
            ك._نسبة_العرض = 16.0 / 9.0
            أرجع ك
        نهاية
        
        دالة مصفوفة_العرض(ذاتي) -> مصفوفة٤:
            إذا ذاتي._العقدة == فارغ:
                أرجع مصفوفة_هوية()
            نهاية
            
            متغير تحويل = ذاتي._العقدة.التحويل()
            أرجع مصفوفة_نظر(
                تحويل.الموضع()،
                تحويل.الموضع().جمع(تحويل.الأمام())،
                تحويل.الأعلى()
            )
        نهاية
        
        دالة مصفوفة_الإسقاط(ذاتي) -> مصفوفة٤:
            اختر ذاتي._نوع_الإسقاط:
                حالة نوع_إسقاط.منظوري:
                    أرجع مصفوفة_منظور(
                        ذاتي._مجال_الرؤية،
                        ذاتي._نسبة_العرض،
                        ذاتي._القريب،
                        ذاتي._البعيد
                    )
                نهاية
                حالة نوع_إسقاط.متعامد:
                    متغير حجم = 10.0
                    أرجع مصفوفة_متعامدة(
                        -حجم * ذاتي._نسبة_العرض،
                        حجم * ذاتي._نسبة_العرض،
                        -حجم،
                        حجم،
                        ذاتي._القريب،
                        ذاتي._البعيد
                    )
                نهاية
            نهاية
        نهاية
        
        دالة تعيين_مجال_الرؤية(ذاتي، درجات: عدد_حقيقي):
            ذاتي._مجال_الرؤية = درجات * إلى_راديان
        نهاية
        
        دالة تعيين_نسبة_العرض(ذاتي، نسبة: عدد_حقيقي):
            ذاتي._نسبة_العرض = نسبة
        نهاية
نهاية

// ============== الأضواء ==============

تعداد نوع_ضوء:
    اتجاهي
    نقطي
    كشاف
نهاية

صنف ضوء:
    خاص:
        _العقدة: عقدة؟
        _النوع: نوع_ضوء
        _اللون: متجه٣
        _الشدة: عدد_حقيقي
        _المدى: عدد_حقيقي
        _زاوية_الكشاف: عدد_حقيقي
    
    عام:
        دالة جديد(نوع: نوع_ضوء = نوع_ضوء.اتجاهي) -> ضوء:
            متغير ض = ضوء()
            ض._النوع = نوع
            ض._اللون = متجه٣(1، 1، 1)
            ض._الشدة = 1.0
            ض._المدى = 10.0
            ض._زاوية_الكشاف = ط / 6  // 30 درجة
            أرجع ض
        نهاية
        
        دالة النوع(ذاتي) -> نوع_ضوء:
            أرجع ذاتي._النوع
        نهاية
        
        دالة اللون(ذاتي) -> متجه٣:
            أرجع ذاتي._اللون
        نهاية
        
        دالة تعيين_اللون(ذاتي، لون: متجه٣):
            ذاتي._اللون = لون
        نهاية
        
        دالة الشدة(ذاتي) -> عدد_حقيقي:
            أرجع ذاتي._الشدة
        نهاية
        
        دالة تعيين_الشدة(ذاتي، شدة: عدد_حقيقي):
            ذاتي._الشدة = شدة
        نهاية
نهاية

// ============== سياق الرسم ==============

صنف سياق_رسم:
    خاص:
        _مكدس_مصفوفات: قائمة<مصفوفة٤>
        _مصفوفة_النموذج: مصفوفة٤
        _مصفوفة_العرض: مصفوفة٤
        _مصفوفة_الإسقاط: مصفوفة٤
    
    عام:
        دالة جديد() -> سياق_رسم:
            متغير س = سياق_رسم()
            س._مكدس_مصفوفات = قائمة<مصفوفة٤>()
            س._مصفوفة_النموذج = مصفوفة_هوية()
            س._مصفوفة_العرض = مصفوفة_هوية()
            س._مصفوفة_الإسقاط = مصفوفة_هوية()
            أرجع س
        نهاية
        
        دالة دفع_مصفوفة(ذاتي):
            ذاتي._مكدس_مصفوفات.أضف(ذاتي._مصفوفة_النموذج)
        نهاية
        
        دالة سحب_مصفوفة(ذاتي):
            إذا ذاتي._مكدس_مصفوفات.الطول() > 0:
                ذاتي._مصفوفة_النموذج = ذاتي._مكدس_مصفوفات.آخر()
                ذاتي._مكدس_مصفوفات.احذف_آخر()
            نهاية
        نهاية
        
        دالة ضرب_مصفوفة(ذاتي، مصفوفة: مصفوفة٤):
            ذاتي._مصفوفة_النموذج = ذاتي._مصفوفة_النموذج.ضرب(مصفوفة)
        نهاية
        
        دالة تعيين_مصفوفة_العرض(ذاتي، مصفوفة: مصفوفة٤):
            ذاتي._مصفوفة_العرض = مصفوفة
        نهاية
        
        دالة تعيين_مصفوفة_الإسقاط(ذاتي، مصفوفة: مصفوفة٤):
            ذاتي._مصفوفة_الإسقاط = مصفوفة
        نهاية
        
        دالة مصفوفة_MVP(ذاتي) -> مصفوفة٤:
            أرجع ذاتي._مصفوفة_الإسقاط.ضرب(ذاتي._مصفوفة_العرض).ضرب(ذاتي._مصفوفة_النموذج)
        نهاية
نهاية
