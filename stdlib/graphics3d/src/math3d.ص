دالة مصفوفة_منظور(مجال_رؤية: عدد_حقيقي، نسبة: عدد_حقيقي، قريب: عدد_حقيقي، بعيد: عدد_حقيقي) -> مصفوفة٤:
    متغير م = مصفوفة٤()
    متغير ف = 1.0 / ظل(مجال_رؤية * 0.5)
    
    م.عناصر[0] = ف / نسبة
    م.عناصر[5] = ف
    م.عناصر[10] = (بعيد + قريب) / (قريب - بعيد)
    م.عناصر[11] = -1
    م.عناصر[14] = (2 * بعيد * قريب) / (قريب - بعيد)
    
    أرجع م
نهاية

دالة مصفوفة_متعامدة(يسار: عدد_حقيقي، يمين: عدد_حقيقي، أسفل: عدد_حقيقي، أعلى: عدد_حقيقي، قريب: عدد_حقيقي، بعيد: عدد_حقيقي) -> مصفوفة٤:
    متغير م = مصفوفة٤()
    
    م.عناصر[0] = 2 / (يمين - يسار)
    م.عناصر[5] = 2 / (أعلى - أسفل)
    م.عناصر[10] = -2 / (بعيد - قريب)
    م.عناصر[12] = -(يمين + يسار) / (يمين - يسار)
    م.عناصر[13] = -(أعلى + أسفل) / (أعلى - أسفل)
    م.عناصر[14] = -(بعيد + قريب) / (بعيد - قريب)
    م.عناصر[15] = 1
    
    أرجع م
