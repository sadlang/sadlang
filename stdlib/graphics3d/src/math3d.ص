// ============== رباعي (Quaternion) ==============

هيكل رباعي:
    س: عدد_حقيقي
    ص: عدد_حقيقي
    ع: عدد_حقيقي
    و: عدد_حقيقي
    
    // العمليات الأساسية
    دالة ضرب(ذاتي، أخر: رباعي) -> رباعي:
        أرجع رباعي(
            ذاتي.و * أخر.س + ذاتي.س * أخر.و + ذاتي.ص * أخر.ع - ذاتي.ع * أخر.ص،
            ذاتي.و * أخر.ص - ذاتي.س * أخر.ع + ذاتي.ص * أخر.و + ذاتي.ع * أخر.س،
            ذاتي.و * أخر.ع + ذاتي.س * أخر.ص - ذاتي.ص * أخر.س + ذاتي.ع * أخر.و،
            ذاتي.و * أخر.و - ذاتي.س * أخر.س - ذاتي.ص * أخر.ص - ذاتي.ع * أخر.ع
        )
    نهاية
    
    دالة معكوس(ذاتي) -> رباعي:
        أرجع رباعي(-ذاتي.س، -ذاتي.ص، -ذاتي.ع، ذاتي.و)
    نهاية
    
    دالة طبيعي(ذاتي) -> رباعي:
        متغير طول = جذر(ذاتي.س*ذاتي.س + ذاتي.ص*ذاتي.ص + ذاتي.ع*ذاتي.ع + ذاتي.و*ذاتي.و)
        إذا طول > 0.0001:
            أرجع رباعي(ذاتي.س/طول، ذاتي.ص/طول، ذاتي.ع/طول، ذاتي.و/طول)
        نهاية
        أرجع رباعي_هوية()
    نهاية
    
    // تدوير متجه
    دالة دوّر(ذاتي، متجه: متجه٣) -> متجه٣:
        متغير م = رباعي(متجه.س، متجه.ص، متجه.ع، 0)
        متغير نتيجة = ذاتي.ضرب(م).ضرب(ذاتي.معكوس())
        أرجع متجه٣(نتيجة.س، نتيجة.ص، نتيجة.ع)
    نهاية
    
    // إلى زوايا أويلر
    دالة إلى_أويلر(ذاتي) -> متجه٣:
        // ترتيب YXZ
        متغير سينرول = 2.0 * (ذاتي.و * ذاتي.س - ذاتي.ص * ذاتي.ع)
        متغير كوسرول = 1.0 - 2.0 * (ذاتي.س * ذاتي.س + ذاتي.ص * ذاتي.ص)
        متغير رول = ظا٢(سينرول، كوسرول)
        
        متغير سينبتش = 2.0 * (ذاتي.و * ذاتي.ص + ذاتي.ع * ذاتي.س)
        متغير بتش = إذا |سينبتش| >= 1 فإن نصف_ط * إشارة(سينبتش) وإلا قوس_جيب(سينبتش)
        
        متغير سينيو = 2.0 * (ذاتي.و * ذاتي.ع - ذاتي.س * ذاتي.ص)
        متغير كوسيو = 1.0 - 2.0 * (ذاتي.ص * ذاتي.ص + ذاتي.ع * ذاتي.ع)
        متغير يو = ظا٢(سينيو، كوسيو)
        
        أرجع متجه٣(رول، بتش، يو)
    نهاية
نهاية

// إنشاء رباعي
دالة رباعي_هوية() -> رباعي:
    أرجع رباعي(0، 0، 0، 1)
نهاية

دالة رباعي_من_أويلر(س: عدد_حقيقي، ص: عدد_حقيقي، ع: عدد_حقيقي) -> رباعي:
    متغير نصف_س = س * 0.5
    متغير نصف_ص = ص * 0.5
    متغير نصف_ع = ع * 0.5
    
    متغير جا_س = جيب(نصف_س)
    متغير جتا_س = جتا(نصف_س)
    متغير جا_ص = جيب(نصف_ص)
    متغير جتا_ص = جتا(نصف_ص)
    متغير جا_ع = جيب(نصف_ع)
    متغير جتا_ع = جتا(نصف_ع)
    
    أرجع رباعي(
        جا_س * جتا_ص * جتا_ع - جتا_س * جا_ص * جا_ع،
        جتا_س * جا_ص * جتا_ع + جا_س * جتا_ص * جا_ع،
        جتا_س * جتا_ص * جا_ع - جا_س * جا_ص * جتا_ع،
        جتا_س * جتا_ص * جتا_ع + جا_س * جا_ص * جا_ع
    )
نهاية

دالة رباعي_من_محور(محور: متجه٣، زاوية: عدد_حقيقي) -> رباعي:
    متغير نصف = زاوية * 0.5
    متغير جا = جيب(نصف)
    متغير م = محور.طبيعي()
    أرجع رباعي(م.س * جا، م.ص * جا، م.ع * جا، جتا(نصف))
نهاية

دالة رباعي_نظر_إلى(من: متجه٣، إلى: متجه٣، أعلى: متجه٣ = متجه٣_أعلى()) -> رباعي:
    متغير اتجاه = إلى.طرح(من).طبيعي()
    متغير يمين = أعلى.ضرب_تقاطعي(اتجاه).طبيعي()
    متغير أعلى_جديد = اتجاه.ضرب_تقاطعي(يمين)
    
    // تحويل مصفوفة الدوران إلى رباعي
    متغير تتبع = يمين.س + أعلى_جديد.ص + اتجاه.ع
    
    إذا تتبع > 0:
        متغير ق = جذر(تتبع + 1.0) * 2
        أرجع رباعي(
            (أعلى_جديد.ع - اتجاه.ص) / ق،
            (اتجاه.س - يمين.ع) / ق،
            (يمين.ص - أعلى_جديد.س) / ق،
            ق * 0.25
        )
    نهاية
    
    أرجع رباعي_هوية()
نهاية

// استيفاء كروي
دالة استيفاء_كروي(أ: رباعي، ب: رباعي، ت: عدد_حقيقي) -> رباعي:
    متغير جتا_زاوية = أ.س*ب.س + أ.ص*ب.ص + أ.ع*ب.ع + أ.و*ب.و
    
    // تأكد من أخذ أقصر طريق
    متغير ب٢ = ب
    إذا جتا_زاوية < 0:
        ب٢ = رباعي(-ب.س، -ب.ص، -ب.ع، -ب.و)
        جتا_زاوية = -جتا_زاوية
    نهاية
    
    // إذا كانت الزاوية صغيرة جداً، استخدم الاستيفاء الخطي
    إذا جتا_زاوية > 0.9995:
        أرجع رباعي(
            أ.س + (ب٢.س - أ.س) * ت،
            أ.ص + (ب٢.ص - أ.ص) * ت،
            أ.ع + (ب٢.ع - أ.ع) * ت،
            أ.و + (ب٢.و - أ.و) * ت
        ).طبيعي()
    نهاية
    
    متغير زاوية = قوس_جتا(جتا_زاوية)
    متغير جا_زاوية = جيب(زاوية)
    
    متغير عامل_أ = جيب((1 - ت) * زاوية) / جا_زاوية
    متغير عامل_ب = جيب(ت * زاوية) / جا_زاوية
    
    أرجع رباعي(
        أ.س * عامل_أ + ب٢.س * عامل_ب،
        أ.ص * عامل_أ + ب٢.ص * عامل_ب،
        أ.ع * عامل_أ + ب٢.ع * عامل_ب،
        أ.و * عامل_أ + ب٢.و * عامل_ب
    )
نهاية

// ============== مصفوفة 4×4 ==============

هيكل مصفوفة٤:
    عناصر: مصفوفة[16]<عدد_حقيقي>
    
    دالة ضرب(ذاتي، أخر: مصفوفة٤) -> مصفوفة٤:
        متغير ن = مصفوفة٤()
        
        لكل ص في نطاق(0، 4):
            لكل س في نطاق(0، 4):
                متغير مجموع = 0.0
                لكل ك في نطاق(0، 4):
                    مجموع = مجموع + ذاتي.عناصر[ص * 4 + ك] * أخر.عناصر[ك * 4 + س]
                نهاية
                ن.عناصر[ص * 4 + س] = مجموع
            نهاية
        نهاية
        
        أرجع ن
    نهاية
    
    دالة تحويل_نقطة(ذاتي، نقطة: متجه٣) -> متجه٣:
        متغير س = ذاتي.عناصر[0]*نقطة.س + ذاتي.عناصر[4]*نقطة.ص + ذاتي.عناصر[8]*نقطة.ع + ذاتي.عناصر[12]
        متغير ص = ذاتي.عناصر[1]*نقطة.س + ذاتي.عناصر[5]*نقطة.ص + ذاتي.عناصر[9]*نقطة.ع + ذاتي.عناصر[13]
        متغير ع = ذاتي.عناصر[2]*نقطة.س + ذاتي.عناصر[6]*نقطة.ص + ذاتي.عناصر[10]*نقطة.ع + ذاتي.عناصر[14]
        متغير و = ذاتي.عناصر[3]*نقطة.س + ذاتي.عناصر[7]*نقطة.ص + ذاتي.عناصر[11]*نقطة.ع + ذاتي.عناصر[15]
        
        إذا |و| > 0.0001:
            أرجع متجه٣(س/و، ص/و، ع/و)
        نهاية
        
        أرجع متجه٣(س، ص، ع)
    نهاية
    
    دالة تحويل_اتجاه(ذاتي، اتجاه: متجه٣) -> متجه٣:
        أرجع متجه٣(
            ذاتي.عناصر[0]*اتجاه.س + ذاتي.عناصر[4]*اتجاه.ص + ذاتي.عناصر[8]*اتجاه.ع،
            ذاتي.عناصر[1]*اتجاه.س + ذاتي.عناصر[5]*اتجاه.ص + ذاتي.عناصر[9]*اتجاه.ع،
            ذاتي.عناصر[2]*اتجاه.س + ذاتي.عناصر[6]*اتجاه.ص + ذاتي.عناصر[10]*اتجاه.ع
        )
    نهاية
نهاية

