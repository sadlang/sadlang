// ============== متجه ثنائي ==============

هيكل متجه٢:
    س: عدد_حقيقي
    ص: عدد_حقيقي
    
    // العمليات الأساسية
    دالة جمع(ذاتي، أخر: متجه٢) -> متجه٢:
        أرجع متجه٢(ذاتي.س + أخر.س، ذاتي.ص + أخر.ص)
    نهاية
    
    دالة طرح(ذاتي، أخر: متجه٢) -> متجه٢:
        أرجع متجه٢(ذاتي.س - أخر.س، ذاتي.ص - أخر.ص)
    نهاية
    
    دالة ضرب(ذاتي، عامل: عدد_حقيقي) -> متجه٢:
        أرجع متجه٢(ذاتي.س * عامل، ذاتي.ص * عامل)
    نهاية
    
    دالة قسم(ذاتي، عامل: عدد_حقيقي) -> متجه٢:
        أرجع متجه٢(ذاتي.س / عامل، ذاتي.ص / عامل)
    نهاية
    
    // الخصائص
    دالة الطول(ذاتي) -> عدد_حقيقي:
        أرجع جذر(ذاتي.س * ذاتي.س + ذاتي.ص * ذاتي.ص)
    نهاية
    
    دالة الطول_مربع(ذاتي) -> عدد_حقيقي:
        أرجع ذاتي.س * ذاتي.س + ذاتي.ص * ذاتي.ص
    نهاية
    
    دالة طبيعي(ذاتي) -> متجه٢:
        متغير ط = ذاتي.الطول()
        إذا ط > 0.0001:
            أرجع ذاتي.قسم(ط)
        نهاية
        أرجع متجه٢(0، 0)
    نهاية
    
    // العمليات المتقدمة
    دالة ضرب_نقطي(ذاتي، أخر: متجه٢) -> عدد_حقيقي:
        أرجع ذاتي.س * أخر.س + ذاتي.ص * أخر.ص
    نهاية
    
    دالة الزاوية(ذاتي) -> عدد_حقيقي:
        أرجع ظا٢(ذاتي.ص، ذاتي.س)
    نهاية
    
    دالة دوران(ذاتي، زاوية: عدد_حقيقي) -> متجه٢:
        متغير جا = جيب(زاوية)
        متغير جتا = جتا(زاوية)
        أرجع متجه٢(
            ذاتي.س * جتا - ذاتي.ص * جا،
            ذاتي.س * جا + ذاتي.ص * جتا
        )
    نهاية
نهاية

