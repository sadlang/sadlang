دالة مصفوفة_من_رباعي(ر: رباعي) -> مصفوفة٤:
    متغير م = مصفوفة_هوية()
    
    متغير س٢ = ر.س * 2
    متغير ص٢ = ر.ص * 2
    متغير ع٢ = ر.ع * 2
    
    متغير وس = ر.و * س٢
    متغير وص = ر.و * ص٢
    متغير وع = ر.و * ع٢
    متغير سس = ر.س * س٢
    متغير سص = ر.س * ص٢
    متغير سع = ر.س * ع٢
    متغير صص = ر.ص * ص٢
    متغير صع = ر.ص * ع٢
    متغير عع = ر.ع * ع٢
    
    م.عناصر[0] = 1 - (صص + عع)
    م.عناصر[1] = سص + وع
    م.عناصر[2] = سع - وص
    م.عناصر[4] = سص - وع
    م.عناصر[5] = 1 - (سس + عع)
    م.عناصر[6] = صع + وس
    م.عناصر[8] = سع + وص
    م.عناصر[9] = صع - وس
    م.عناصر[10] = 1 - (سس + صص)
    
    أرجع م
نهاية

دالة مصفوفة_نظر(موضع: متجه٣، هدف: متجه٣، أعلى: متجه٣) -> مصفوفة٤:
    متغير ع = موضع.طرح(هدف).طبيعي()
    متغير س = أعلى.ضرب_تقاطعي(ع).طبيعي()
    متغير ص = ع.ضرب_تقاطعي(س)
    
    متغير م = مصفوفة_هوية()
    
    م.عناصر[0] = س.س؛ م.عناصر[4] = س.ص؛ م.عناصر[8] = س.ع
    م.عناصر[1] = ص.س؛ م.عناصر[5] = ص.ص؛ م.عناصر[9] = ص.ع
    م.عناصر[2] = ع.س؛ م.عناصر[6] = ع.ص؛ م.عناصر[10] = ع.ع
    
    م.عناصر[12] = -س.ضرب_نقطي(موضع)
    م.عناصر[13] = -ص.ضرب_نقطي(موضع)
    م.عناصر[14] = -ع.ضرب_نقطي(موضع)
    
    أرجع م
