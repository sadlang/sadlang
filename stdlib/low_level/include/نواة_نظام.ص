// =============================================================================
// ثوابت النظام
// =============================================================================

// أعلام CR0
ثابت CR0_PE: ط64 = 0x1          // وضع الحماية
ثابت CR0_MP: ط64 = 0x2          // مراقبة المعالج المساعد
ثابت CR0_EM: ط64 = 0x4          // محاكاة المعالج المساعد
ثابت CR0_TS: ط64 = 0x8          // تبديل المهمة
ثابت CR0_ET: ط64 = 0x10         // نوع الامتداد
ثابت CR0_NE: ط64 = 0x20         // خطأ رقمي
ثابت CR0_WP: ط64 = 0x10000      // حماية الكتابة
ثابت CR0_AM: ط64 = 0x40000      // فحص المحاذاة
ثابت CR0_NW: ط64 = 0x20000000   // بدون كتابة خلفية
ثابت CR0_CD: ط64 = 0x40000000   // تعطيل الذاكرة المؤقتة
ثابت CR0_PG: ط64 = 0x80000000   // تفعيل الترحيل

// أعلام CR4
ثابت CR4_VME: ط64 = 0x1         // امتدادات الوضع الافتراضي
ثابت CR4_PVI: ط64 = 0x2         // مقاطعات افتراضية محمية
ثابت CR4_TSD: ط64 = 0x4         // تعطيل عداد الزمن
ثابت CR4_DE: ط64 = 0x8          // امتدادات التصحيح
ثابت CR4_PSE: ط64 = 0x10        // امتدادات حجم الصفحة
ثابت CR4_PAE: ط64 = 0x20        // امتداد العنوان الفيزيائي
ثابت CR4_MCE: ط64 = 0x40        // تفعيل فحص الآلة
ثابت CR4_PGE: ط64 = 0x80        // تفعيل الصفحات العامة
ثابت CR4_OSFXSR: ط64 = 0x200    // دعم FXSAVE/FXRSTOR
ثابت CR4_OSXMMEXCPT: ط64 = 0x400  // استثناءات SIMD

// منافذ VGA النصية
ثابت VGA_CTRL_PORT: ط16 = 0x3D4
ثابت VGA_DATA_PORT: ط16 = 0x3D5
ثابت VGA_TEXT_BUFFER: ط64 = 0xB8000

// منافذ لوحة المفاتيح
ثابت KB_DATA_PORT: ط16 = 0x60
ثابت KB_STATUS_PORT: ط16 = 0x64
ثابت KB_COMMAND_PORT: ط16 = 0x64

// منافذ PIC (وحدة التحكم بالمقاطعات)
ثابت PIC1_COMMAND: ط16 = 0x20
ثابت PIC1_DATA: ط16 = 0x21
ثابت PIC2_COMMAND: ط16 = 0xA0
ثابت PIC2_DATA: ط16 = 0xA1

// منافذ PIT (مؤقت)
ثابت PIT_CHANNEL0: ط16 = 0x40
ثابت PIT_CHANNEL1: ط16 = 0x41
ثابت PIT_CHANNEL2: ط16 = 0x42
ثابت PIT_COMMAND: ط16 = 0x43

// =============================================================================
// دوال مساعدة عالية المستوى
// =============================================================================

/**
 * انتظار جهاز I/O (للتأخير القصير)
 */
دالة انتظر_إدخال_إخراج() {
    اكتب_منفذ8(0x80، 0)
}

/**
 * إرسال إنهاء المقاطعة إلى PIC
 */
دالة أنهِ_مقاطعة(رقم: ط8) {
    إذا رقم >= 8 {
        اكتب_منفذ8(PIC2_COMMAND، 0x20)
    }
    اكتب_منفذ8(PIC1_COMMAND، 0x20)
}

/**
 * تهيئة وحدة التحكم بالمقاطعات (PIC)
 */
دالة هيّئ_مقاطعات() {
    // ICW1: بدء التهيئة
    اكتب_منفذ8(PIC1_COMMAND، 0x11)
    اكتب_منفذ8(PIC2_COMMAND، 0x11)
    انتظر_إدخال_إخراج()
    
    // ICW2: إزاحة المتجهات
    اكتب_منفذ8(PIC1_DATA، 0x20)  // IRQ 0-7 -> INT 32-39
    اكتب_منفذ8(PIC2_DATA، 0x28)  // IRQ 8-15 -> INT 40-47
    انتظر_إدخال_إخراج()
    
    // ICW3: التسلسل
    اكتب_منفذ8(PIC1_DATA، 0x04)  // PIC2 على IRQ2
    اكتب_منفذ8(PIC2_DATA، 0x02)
    انتظر_إدخال_إخراج()
    
    // ICW4: وضع 8086
    اكتب_منفذ8(PIC1_DATA، 0x01)
    اكتب_منفذ8(PIC2_DATA، 0x01)
    انتظر_إدخال_إخراج()
    
    // تعطيل كل المقاطعات مبدئياً
    اكتب_منفذ8(PIC1_DATA، 0xFF)
    اكتب_منفذ8(PIC2_DATA، 0xFF)
}

/**
 * تفعيل/تعطيل مقاطعة محددة
 */
دالة فعّل_مقاطعة_جهاز(رقم: ط8) {
    إذا رقم < 8 {
        متغير قناع = اقرأ_منفذ8(PIC1_DATA)
        قناع = قناع و_بتي (~(1 << رقم))
        اكتب_منفذ8(PIC1_DATA، قناع)
    } وإلا {
        متغير قناع = اقرأ_منفذ8(PIC2_DATA)
        قناع = قناع و_بتي (~(1 << (رقم - 8)))
        اكتب_منفذ8(PIC2_DATA، قناع)
    }
}
