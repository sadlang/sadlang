/**
 * ==========================================================
 * مكتبة صOS القياسية المصغرة
 * للأجهزة المدمجة (Embedded Systems)
 * ==========================================================
 * 
 * 📚 شرح للمبتدئين:
 * ================
 * هذه المكتبة توفر الدوال الأساسية لنظام صOS.
 * صُممت لتكون صغيرة وفعالة للأجهزة ذات الموارد المحدودة.
 */

// ==========================================================
// 📌 الأنواع الأساسية
// ==========================================================

/**
 * نوع عدد صحيح 8 بت
 * يخزّن قيم من -128 إلى 127
 */
نوع ع8 = عدد_صحيح_8_بت

/**
 * نوع عدد صحيح 16 بت
 * يخزّن قيم من -32768 إلى 32767
 */
نوع ع16 = عدد_صحيح_16_بت

/**
 * نوع عدد صحيح 32 بت
 * يخزّن قيم من -2 مليار إلى 2 مليار
 */
نوع ع32 = عدد_صحيح_32_بت

/**
 * نوع عدد صحيح 64 بت
 * يخزّن أعداد ضخمة جداً
 */
نوع ع64 = عدد_صحيح_64_بت

/**
 * نوع عدد صحيح بدون إشارة 8 بت
 * يخزّن قيم من 0 إلى 255
 */
نوع ح8 = حرف_8_بت

/**
 * نوع عدد صحيح بدون إشارة 32 بت
 */
نوع ط32 = طبيعي_32_بت

/**
 * نوع عشري 32 بت
 */
نوع عش32 = عشري_32_بت

/**
 * نوع منطقي
 */
نوع منطقي = صحيح | خطأ

// ==========================================================
// 📌 دوال النظام
// ==========================================================

/**
 * 📚 للمبتدئين:
 * تأخير التنفيذ لفترة محددة
 * 
 * مثال:
 *   انتظر(1000)  // انتظر ثانية واحدة
 */
دالة انتظر(ميلي_ثانية: ط32) -> لاشيء
    // في التنفيذ الحقيقي: استدعاء sad_os_sleep
    _خارجي_انتظر(ميلي_ثانية)
نهاية

/**
 * الحصول على الوقت منذ بدء التشغيل (بالميلي ثانية)
 */
دالة وقت_التشغيل() -> ط64
    أرجع _خارجي_وقت_التشغيل()
نهاية

/**
 * إعادة تشغيل النظام
 */
دالة أعد_التشغيل() -> لاشيء
    _خارجي_أعد_التشغيل()
نهاية

// ==========================================================
// 📌 دوال GPIO
// ==========================================================

/**
 * 📚 للمبتدئين:
 * GPIO = General Purpose Input/Output
 * هي "الأرجل" التي يمكنك برمجتها للتحكم في الأجهزة
 */

/**
 * أوضاع الرِجل
 */
تعداد وضع_رِجل:
    إدخال = 0        // لقراءة إشارة (مثل زر)
    إخراج = 1        // لإرسال إشارة (مثل LED)
    إدخال_سحب_علوي = 2
    إدخال_سحب_سفلي = 3
نهاية

/**
 * تهيئة رِجل GPIO
 * 
 * مثال:
 *   هيّئ_رِجل(2, وضع_رِجل.إخراج)  // رِجل 2 للإخراج
 */
دالة هيّئ_رِجل(الرقم: ح8، الوضع: وضع_رِجل) -> منطقي
    أرجع _خارجي_هيّئ_رِجل(الرقم، الوضع)
نهاية

/**
 * قراءة قيمة رِجل
 * 
 * مثال:
 *   إذا اقرأ_رِجل(0) == صحيح:
 *       اطبع("الزر مضغوط!")
 *   نهاية
 */
دالة اقرأ_رِجل(الرقم: ح8) -> منطقي
    أرجع _خارجي_اقرأ_رِجل(الرقم)
نهاية

/**
 * كتابة قيمة لرِجل
 * 
 * مثال:
 *   اكتب_رِجل(2، صحيح)   // شغّل LED
 *   اكتب_رِجل(2، خطأ)    // أطفئ LED
 */
دالة اكتب_رِجل(الرقم: ح8، القيمة: منطقي) -> لاشيء
    _خارجي_اكتب_رِجل(الرقم، القيمة)
نهاية

/**
 * تبديل حالة رِجل (إذا كانت 1 تصبح 0 والعكس)
 */
دالة بدّل_رِجل(الرقم: ح8) -> لاشيء
    _خارجي_بدّل_رِجل(الرقم)
نهاية

// اختصارات مفيدة
دالة شغّل(الرقم: ح8) -> لاشيء
    اكتب_رِجل(الرقم، صحيح)
نهاية

دالة أطفئ(الرقم: ح8) -> لاشيء
    اكتب_رِجل(الرقم، خطأ)
نهاية

// ==========================================================
// 📌 دوال PWM
// ==========================================================

/**
 * 📚 للمبتدئين:
 * PWM = Pulse Width Modulation
 * يُستخدم للتحكم في سطوع LED أو سرعة محرك
 * 
 * بدلاً من تشغيل/إطفاء فقط، نتحكم في "نسبة التشغيل"
 * 50% = نصف السطوع، 100% = كامل السطوع
 */

/**
 * تهيئة PWM على رِجل
 * 
 * مثال:
 *   هيّئ_PWM(2، 1000)  // PWM بتردد 1000 هرتز
 */
دالة هيّئ_PWM(الرقم: ح8، التردد: ط32) -> منطقي
    أرجع _خارجي_هيّئ_PWM(الرقم، التردد)
نهاية

/**
 * تعيين قيمة PWM (0-255)
 * 
 * مثال:
 *   اكتب_PWM(2، 128)  // سطوع 50%
 */
دالة اكتب_PWM(الرقم: ح8، القيمة: ح8) -> لاشيء
    _خارجي_اكتب_PWM(الرقم، القيمة)
نهاية

// ==========================================================
// 📌 دوال WiFi
// ==========================================================

/**
 * 📚 للمبتدئين:
 * WiFi يسمح للجهاز بالاتصال بالإنترنت لاسلكياً
 */

/**
 * حالة WiFi
 */
تعداد حالة_واي_فاي:
    غير_متصل = 0
    يبحث = 1
    يتصل = 2
    متصل = 3
    فشل = 4
نهاية

/**
 * تهيئة WiFi
 */
دالة هيّئ_واي_فاي() -> منطقي
    أرجع _خارجي_هيّئ_واي_فاي()
نهاية

/**
 * الاتصال بشبكة WiFi
 * 
 * مثال:
 *   اتصل_واي_فاي("اسم_الشبكة"، "كلمة_السر")
 */
دالة اتصل_واي_فاي(الاسم: نص، كلمة_المرور: نص) -> منطقي
    أرجع _خارجي_اتصل_واي_فاي(الاسم، كلمة_المرور)
نهاية

/**
 * قطع الاتصال
 */
دالة اقطع_واي_فاي() -> لاشيء
    _خارجي_اقطع_واي_فاي()
نهاية

/**
 * التحقق من حالة الاتصال
 */
دالة متصل_بالواي_فاي() -> منطقي
    أرجع _خارجي_متصل_بالواي_فاي()
نهاية

/**
 * الحصول على عنوان IP
 */
دالة أحضر_عنوان_IP() -> نص
    أرجع _خارجي_أحضر_IP()
نهاية

// ==========================================================
// 📌 دوال I2C
// ==========================================================

/**
 * 📚 للمبتدئين:
 * I2C = Inter-Integrated Circuit
 * طريقة للتواصل مع الحساسات والشاشات
 * يستخدم سلكين فقط (SDA للبيانات، SCL للساعة)
 */

/**
 * تهيئة I2C
 * 
 * مثال:
 *   هيّئ_I2C(0، 21، 22)  // ناقل 0، SDA=21، SCL=22
 */
دالة هيّئ_I2C(الناقل: ح8، رِجل_SDA: ح8، رِجل_SCL: ح8) -> منطقي
    أرجع _خارجي_هيّئ_I2C(الناقل، رِجل_SDA، رِجل_SCL)
نهاية

/**
 * كتابة بيانات عبر I2C
 */
دالة اكتب_I2C(الناقل: ح8، العنوان: ح8، البيانات: [ح8]) -> منطقي
    أرجع _خارجي_اكتب_I2C(الناقل، العنوان، البيانات)
نهاية

/**
 * قراءة بيانات عبر I2C
 */
دالة اقرأ_I2C(الناقل: ح8، العنوان: ح8، الطول: ح8) -> [ح8]
    أرجع _خارجي_اقرأ_I2C(الناقل، العنوان، الطول)
نهاية

// ==========================================================
// 📌 دوال الطباعة
// ==========================================================

/**
 * طباعة نص (للتصحيح عبر USB/Serial)
 * 
 * مثال:
 *   اطبع("مرحباً من صOS!")
 */
دالة اطبع(الرسالة: نص) -> لاشيء
    _خارجي_اطبع(الرسالة)
نهاية

/**
 * طباعة نص مع سطر جديد
 */
دالة اطبع_سطر(الرسالة: نص) -> لاشيء
    اطبع(الرسالة)
    اطبع("\n")
نهاية

/**
 * طباعة عدد
 */
دالة اطبع_عدد(القيمة: ع32) -> لاشيء
    _خارجي_اطبع_عدد(القيمة)
نهاية

// ==========================================================
// 📌 دوال الذاكرة
// ==========================================================

/**
 * الحصول على الذاكرة الحرة
 */
دالة ذاكرة_حرة() -> ط32
    أرجع _خارجي_ذاكرة_حرة()
نهاية

/**
 * الحصول على إجمالي الذاكرة
 */
دالة ذاكرة_إجمالية() -> ط32
    أرجع _خارجي_ذاكرة_إجمالية()
نهاية

// ==========================================================
// 📌 مثال: وميض LED
// ==========================================================

/**
 * 📚 مثال للمبتدئين:
 * هذا البرنامج يجعل LED يومض كل ثانية
 * 
 * دالة رئيسية():
 *     // تهيئة الرِجل 2 للإخراج
 *     هيّئ_رِجل(2، وضع_رِجل.إخراج)
 *     
 *     // حلقة لا نهائية
 *     طالما صحيح:
 *         شغّل(2)          // شغّل LED
 *         انتظر(1000)      // انتظر ثانية
 *         أطفئ(2)          // أطفئ LED
 *         انتظر(1000)      // انتظر ثانية
 *     نهاية
 * نهاية
 */

// ==========================================================
// 📌 مثال: قراءة حساس الحرارة عبر I2C
// ==========================================================

/**
 * 📚 مثال للمبتدئين:
 * قراءة درجة الحرارة من حساس LM75
 * 
 * دالة اقرأ_الحرارة() -> عش32:
 *     // عنوان حساس LM75
 *     ثابت العنوان: ح8 = 0x48
 *     
 *     // قراءة بايتين من الحساس
 *     متغير البيانات = اقرأ_I2C(0، العنوان، 2)
 *     
 *     // تحويل البيانات لدرجة حرارة
 *     متغير الخام = (البيانات[0] << 8) | البيانات[1]
 *     متغير الحرارة = الخام / 256.0
 *     
 *     أرجع الحرارة
 * نهاية
 */
