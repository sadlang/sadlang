 *                              نظرة عامة | Overview
 * ═══════════════════════════════════════════════════════════════════════════════
 *
 * 🌟 الهدف | Goal:
 *    توفير دوال لحساب طول النصوص العربية بطرق مختلفة
 *    Provide functions to calculate Arabic text length in different ways
 *
 * 📋 أنواع الطول | Length Types:
 *
 *    1️⃣ طول_البايت | Byte Length:
 *       عدد البايتات في UTF-8
 *       "مرحباً" = 14 بايت
 *
 *    2️⃣ طول_الأحرف | Character Length (Codepoints):
 *       عدد نقاط الكود Unicode
 *       "مرحباً" = 7 (مع التشكيل)
 *
 *    3️⃣ طول_الحروف | Letter Length (Grapheme Clusters):
 *       عدد الحروف المرئية
 *       "مَرْحَباً" = 5 حروف (بدون التشكيل)
 *
 *    4️⃣ طول_العرض | Display Width:
 *       عرض العرض على الشاشة
 *       حرف عربي = 1-2 وحدة
 *
 * 🎯 مثال | Example:
 *
 *    دع نص = "السَّلامُ عَلَيْكُم"
 *    
 *    طول_البايت(نص)   → 35
 *    طول_الأحرف(نص)   → 17
 *    طول_الحروف(نص)   → 12
 *    طول_العرض(نص)    → 13
 *
 * ═══════════════════════════════════════════════════════════════════════════════
 */

// ═══════════════════════════════════════════════════════════════════════════════
//                          استيراد المكتبات | Imports
// ═══════════════════════════════════════════════════════════════════════════════

استورد حزمة::نواة::نص::*
استورد حزمة::نواة::خيار::*
استورد حزمة::نواة::مكرر::*

// ═══════════════════════════════════════════════════════════════════════════════
//                          ثوابت Unicode | Unicode Constants
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * 📋 نطاقات التشكيل العربي | Arabic Diacritics Ranges
 */
ثابت نطاق_تشكيل_بداية: عدد_صحيح = 0x064B
ثابت نطاق_تشكيل_نهاية: عدد_صحيح = 0x065F
ثابت ألف_خنجرية: عدد_صحيح = 0x0670

/**
 * 📋 نطاقات الحروف العربية | Arabic Letter Ranges
 */
ثابت عربي_أساسي_بداية: عدد_صحيح = 0x0600
ثابت عربي_أساسي_نهاية: عدد_صحيح = 0x06FF
ثابت عربي_تكميلي_بداية: عدد_صحيح = 0x0750
ثابت عربي_تكميلي_نهاية: عدد_صحيح = 0x077F

// ═══════════════════════════════════════════════════════════════════════════════
//                       دوال فحص الأحرف | Character Check Functions
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * 🔍 هل_تشكيل | Is Diacritical Mark (Tashkeel)
 * 
 * التحقق من أن نقطة الكود هي علامة تشكيل
 */
دالة عامة هل_تشكيل(نقطة_كود: عدد_صحيح) -> منطقي {
    // التشكيل الأساسي: U+064B - U+065F
    إذا نقطة_كود >= نطاق_تشكيل_بداية && نقطة_كود <= نطاق_تشكيل_نهاية {
        أرجع صحيح
    }
    
    // الألف الخنجرية: U+0670
    إذا نقطة_كود == ألف_خنجرية {
        أرجع صحيح
    }
    
    // علامات التشكيل الإضافية: U+06D6 - U+06ED
    إذا نقطة_كود >= 0x06D6 && نقطة_كود <= 0x06ED {
        أرجع صحيح
    }
    
    أرجع خطأ
}

/**
 * 🔍 هل_حرف_عربي | Is Arabic Letter
 * 
 * التحقق من أن نقطة الكود هي حرف عربي
 */
دالة عامة هل_حرف_عربي(نقطة_كود: عدد_صحيح) -> منطقي {
    // النطاق الأساسي: U+0600 - U+06FF
    إذا نقطة_كود >= عربي_أساسي_بداية && نقطة_كود <= عربي_أساسي_نهاية {
        // استثناء التشكيل والأرقام
        إذا هل_تشكيل(نقطة_كود) {
            أرجع خطأ
        }
        // استثناء الأرقام العربية: U+0660 - U+0669
        إذا نقطة_كود >= 0x0660 && نقطة_كود <= 0x0669 {
            أرجع خطأ
        }
        أرجع صحيح
    }
    
    // النطاق التكميلي: U+0750 - U+077F
    إذا نقطة_كود >= عربي_تكميلي_بداية && نقطة_كود <= عربي_تكميلي_نهاية {
        أرجع صحيح
    }
    
    // النطاق الممتد: U+08A0 - U+08FF
    إذا نقطة_كود >= 0x08A0 && نقطة_كود <= 0x08FF {
        أرجع صحيح
    }
    
    // أشكال العرض: U+FB50 - U+FDFF
    إذا نقطة_كود >= 0xFB50 && نقطة_كود <= 0xFDFF {
        أرجع صحيح
    }
    
    // أشكال العرض B: U+FE70 - U+FEFF
    إذا نقطة_كود >= 0xFE70 && نقطة_كود <= 0xFEFF {
        أرجع صحيح
    }
    
    أرجع خطأ
}

/**
 * 🔍 هل_رقم_عربي | Is Arabic-Indic Digit
 */
دالة عامة هل_رقم_عربي(نقطة_كود: عدد_صحيح) -> منطقي {
    // الأرقام العربية: U+0660 - U+0669
    إذا نقطة_كود >= 0x0660 && نقطة_كود <= 0x0669 {
        أرجع صحيح
    }
    // الأرقام العربية الممتدة: U+06F0 - U+06F9
    إذا نقطة_كود >= 0x06F0 && نقطة_كود <= 0x06F9 {
        أرجع صحيح
    }
    أرجع خطأ
}

/**
 * 🔍 هل_مسافة | Is Whitespace
 */
دالة عامة هل_مسافة(نقطة_كود: عدد_صحيح) -> منطقي {
    أرجع نقطة_كود == 0x20 ||     // مسافة
           نقطة_كود == 0x09 ||     // tab
           نقطة_كود == 0x0A ||     // سطر جديد
           نقطة_كود == 0x0D ||     // carriage return
           نقطة_كود == 0x00A0 ||   // non-breaking space
           نقطة_كود == 0x200B      // zero-width space
}

// ═══════════════════════════════════════════════════════════════════════════════
//                       قراءة UTF-8 | UTF-8 Reading
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * 📖 مكرر_نقاط_الكود | Codepoint Iterator
 * 
 * يمر على نقاط الكود في نص UTF-8
 */
بنية عامة مكرر_نقاط_الكود {
    خاص نص_: نص،
    خاص موضع_: عدد_طبيعي
}

تنفيذ مكرر_نقاط_الكود {
    /**
     * إنشاء مكرر جديد | Create new iterator
     */
    ثابت دالة عامة جديد(نص_: نص) -> ذاتي {
        أرجع مكرر_نقاط_الكود {
            نص_: نص_،
            موضع_: 0
        }
    }
    
    /**
     * قراءة نقطة الكود التالية | Read next codepoint
     */
    دالة عامة التالي(&متغير ذاتي) -> اختياري<(عدد_صحيح، عدد_طبيعي)> {
        إذا ذاتي.موضع_ >= ذاتي.نص_.طول() {
            أرجع فارغ
        }
        
        دع بايت_أول = ذاتي.نص_.بايت_في(ذاتي.موضع_)
        دع (نقطة_كود، طول_بايت) = اقرأ_نقطة_كود(بايت_أول، ذاتي.نص_، ذاتي.موضع_)
        
        ذاتي.موضع_ += طول_بايت
        
        أرجع بعض((نقطة_كود، طول_بايت))
    }
}

/**
 * 📖 قراءة نقطة كود من UTF-8 | Read codepoint from UTF-8
 */
دالة خاصة اقرأ_نقطة_كود(بايت_أول: عدد_صحيح_8، نص_: نص، موضع: عدد_طبيعي) -> (عدد_صحيح، عدد_طبيعي) {
    // ASCII (0xxxxxxx)
    إذا (بايت_أول & 0x80) == 0 {
        أرجع (بايت_أول كـ عدد_صحيح، 1)
    }
    
    // 2 bytes (110xxxxx 10xxxxxx)
    إذا (بايت_أول & 0xE0) == 0xC0 {
        دع ب2 = نص_.بايت_في(موضع + 1)
        دع نقطة = ((بايت_أول & 0x1F) << 6) | (ب2 & 0x3F)
        أرجع (نقطة كـ عدد_صحيح، 2)
    }
    
    // 3 bytes (1110xxxx 10xxxxxx 10xxxxxx)
    إذا (بايت_أول & 0xF0) == 0xE0 {
        دع ب2 = نص_.بايت_في(موضع + 1)
        دع ب3 = نص_.بايت_في(موضع + 2)
        دع نقطة = ((بايت_أول & 0x0F) << 12) | ((ب2 & 0x3F) << 6) | (ب3 & 0x3F)
        أرجع (نقطة كـ عدد_صحيح، 3)
    }
    
    // 4 bytes (11110xxx 10xxxxxx 10xxxxxx 10xxxxxx)
    إذا (بايت_أول & 0xF8) == 0xF0 {
        دع ب2 = نص_.بايت_في(موضع + 1)
        دع ب3 = نص_.بايت_في(موضع + 2)
        دع ب4 = نص_.بايت_في(موضع + 3)
        دع نقطة = ((بايت_أول & 0x07) << 18) | ((ب2 & 0x3F) << 12) | 
                   ((ب3 & 0x3F) << 6) | (ب4 & 0x3F)
        أرجع (نقطة كـ عدد_صحيح، 4)
    }
    
    // خطأ - حرف استبدال
    أرجع (0xFFFD، 1)
}

// ═══════════════════════════════════════════════════════════════════════════════
//                       دوال حساب الطول | Length Functions
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * 📏 طول_البايت | Byte Length
 * 
 * عدد البايتات في التمثيل UTF-8
 */
دالة عامة طول_البايت(نص_: نص) -> عدد_طبيعي {
    أرجع نص_.طول()
}

/**
 * 📏 طول_الأحرف | Character Length (Codepoints)
 * 
 * عدد نقاط الكود Unicode
 */
دالة عامة طول_الأحرف(نص_: نص) -> عدد_طبيعي {
    متغير عداد: عدد_طبيعي = 0
    متغير مكرر = مكرر_نقاط_الكود::جديد(نص_)
    
    طالما دع بعض(_) = مكرر.التالي() {
        عداد += 1
    }
    
    أرجع عداد
}

/**
 * 📏 طول_الحروف | Grapheme Cluster Length
 * 
 * عدد الحروف المرئية (بدون احتساب التشكيل منفصلاً)
 */
دالة عامة طول_الحروف(نص_: نص) -> عدد_طبيعي {
    متغير عداد: عدد_طبيعي = 0
    متغير مكرر = مكرر_نقاط_الكود::جديد(نص_)
    
    طالما دع بعض((نقطة_كود، _)) = مكرر.التالي() {
        // لا نحتسب التشكيل
        إذا !هل_تشكيل(نقطة_كود) {
            عداد += 1
        }
    }
    
    أرجع عداد
}

/**
 * 📏 طول_الحروف_العربية | Arabic Letter Count
 * 
 * عدد الحروف العربية فقط
 */
دالة عامة طول_الحروف_العربية(نص_: نص) -> عدد_طبيعي {
    متغير عداد: عدد_طبيعي = 0
    متغير مكرر = مكرر_نقاط_الكود::جديد(نص_)
    
    طالما دع بعض((نقطة_كود، _)) = مكرر.التالي() {
        إذا هل_حرف_عربي(نقطة_كود) {
            عداد += 1
        }
    }
    
    أرجع عداد
}

/**
 * 📏 طول_العرض | Display Width
 * 
 * عرض النص على الشاشة
 * الأحرف العربية عادة بعرض 1 أو 2
 */
دالة عامة طول_العرض(نص_: نص) -> عدد_طبيعي {
    متغير عرض: عدد_طبيعي = 0
    متغير مكرر = مكرر_نقاط_الكود::جديد(نص_)
    
    طالما دع بعض((نقطة_كود، _)) = مكرر.التالي() {
        // التشكيل لا يأخذ مساحة
        إذا هل_تشكيل(نقطة_كود) {
            واصل
        }
        
        // أحرف التحكم لا تأخذ مساحة
        إذا نقطة_كود < 0x20 {
            واصل
        }
        
        // Zero-width characters
        إذا نقطة_كود == 0x200B || نقطة_كود == 0x200C || نقطة_كود == 0x200D {
            واصل
        }
        
        // CJK والإيموجي عرضها 2
        إذا (نقطة_كود >= 0x4E00 && نقطة_كود <= 0x9FFF) ||  // CJK
           (نقطة_كود >= 0x1F300 && نقطة_كود <= 0x1F9FF) {   // Emoji
            عرض += 2
        } وإلا {
            عرض += 1
        }
    }
    
    أرجع عرض
}

/**
 * 📏 طول_الكلمات | Word Count
 * 
 * عدد الكلمات في النص
 */
دالة عامة طول_الكلمات(نص_: نص) -> عدد_طبيعي {
    متغير عداد: عدد_طبيعي = 0
    متغير في_كلمة: منطقي = خطأ
    متغير مكرر = مكرر_نقاط_الكود::جديد(نص_)
    
    طالما دع بعض((نقطة_كود، _)) = مكرر.التالي() {
        دع هل_مسافة_حالية = هل_مسافة(نقطة_كود)
        
        إذا !هل_مسافة_حالية && !هل_تشكيل(نقطة_كود) {
            إذا !في_كلمة {
                عداد += 1
                في_كلمة = صحيح
            }
        } وإلا إذا هل_مسافة_حالية {
            في_كلمة = خطأ
        }
    }
    
    أرجع عداد
}

// ═══════════════════════════════════════════════════════════════════════════════
//                       معلومات النص | Text Info
// ═══════════════════════════════════════════════════════════════════════════════

/**
 * 📋 معلومات_النص | Text Info Structure
 */
بنية عامة معلومات_النص {
    عام طول_بايت: عدد_طبيعي،
    عام طول_أحرف: عدد_طبيعي،
    عام طول_حروف: عدد_طبيعي،
    عام طول_عرض: عدد_طبيعي،
    عام عدد_كلمات: عدد_طبيعي،
    عام حروف_عربية: عدد_طبيعي،
    عام حروف_تشكيل: عدد_طبيعي،
    عام يحتوي_عربي: منطقي،
    عام يحتوي_لاتيني: منطقي
}

/**
 * 🔍 حلل_نص | Analyze Text
 * 
 * تحليل شامل للنص وإرجاع كل المعلومات
 */
دالة عامة حلل_نص(نص_: نص) -> معلومات_النص {
    متغير معلومات = معلومات_النص {
        طول_بايت: نص_.طول()،
        طول_أحرف: 0،
        طول_حروف: 0،
        طول_عرض: 0،
        عدد_كلمات: 0،
        حروف_عربية: 0،
        حروف_تشكيل: 0،
        يحتوي_عربي: خطأ،
        يحتوي_لاتيني: خطأ
    }
    
    متغير مكرر = مكرر_نقاط_الكود::جديد(نص_)
    متغير في_كلمة = خطأ
    
    طالما دع بعض((نقطة_كود، _)) = مكرر.التالي() {
        معلومات.طول_أحرف += 1
        
        // فحص التشكيل
        إذا هل_تشكيل(نقطة_كود) {
            معلومات.حروف_تشكيل += 1
            واصل
        }
        
        معلومات.طول_حروف += 1
        
        // فحص العربية
        إذا هل_حرف_عربي(نقطة_كود) {
            معلومات.حروف_عربية += 1
            معلومات.يحتوي_عربي = صحيح
        }
        
        // فحص اللاتينية
        إذا (نقطة_كود >= 0x41 && نقطة_كود <= 0x5A) ||
           (نقطة_كود >= 0x61 && نقطة_كود <= 0x7A) {
            معلومات.يحتوي_لاتيني = صحيح
        }
        
        // عرض العرض
        إذا نقطة_كود >= 0x20 {
            إذا (نقطة_كود >= 0x4E00 && نقطة_كود <= 0x9FFF) ||
               (نقطة_كود >= 0x1F300 && نقطة_كود <= 0x1F9FF) {
                معلومات.طول_عرض += 2
            } وإلا {
                معلومات.طول_عرض += 1
            }
        }
        
        // عد الكلمات
        إذا !هل_مسافة(نقطة_كود) {
            إذا !في_كلمة {
                معلومات.عدد_كلمات += 1
                في_كلمة = صحيح
            }
        } وإلا {
            في_كلمة = خطأ
        }
    }
    
    أرجع معلومات
}

// ═══════════════════════════════════════════════════════════════════════════════
//                          الاختبارات | Tests
// ═══════════════════════════════════════════════════════════════════════════════

#[اختبار]
دالة اختبار_طول_البايت() {
    // "مرحباً" = م(2) + ر(2) + ح(2) + ب(2) + ا(2) + ً(2) = 12 بايت + null
    دع نص = "مرحباً"
    تأكد!(طول_البايت(نص) == 12)
}

#[اختبار]
دالة اختبار_طول_الأحرف() {
    // "مرحباً" = 6 نقاط كود
    دع نص = "مرحباً"
    تأكد!(طول_الأحرف(نص) == 6)
}

#[اختبار]
دالة اختبار_طول_الحروف() {
    // "السَّلام" = ا + ل + س + ل + ا + م = 6 حروف (بدون التشكيل)
    دع نص = "السَّلام"
    تأكد!(طول_الحروف(نص) == 6)
}

#[اختبار]
دالة اختبار_هل_تشكيل() {
    تأكد!(هل_تشكيل(0x064E))  // فتحة
    تأكد!(هل_تشكيل(0x064F))  // ضمة
    تأكد!(هل_تشكيل(0x0650))  // كسرة
    تأكد!(هل_تشكيل(0x0651))  // شدة
    تأكد!(!هل_تشكيل(0x0645)) // م - ليس تشكيلاً
}

#[اختبار]
دالة اختبار_هل_حرف_عربي() {
    تأكد!(هل_حرف_عربي(0x0645))  // م
    تأكد!(هل_حرف_عربي(0x0631))  // ر
    تأكد!(!هل_حرف_عربي(0x0041)) // A - ليس عربياً
    تأكد!(!هل_حرف_عربي(0x064E)) // فتحة - تشكيل
}

#[اختبار]
دالة اختبار_طول_الكلمات() {
    دع نص = "السلام عليكم ورحمة الله"
    تأكد!(طول_الكلمات(نص) == 4)
}

#[اختبار]
دالة اختبار_حلل_نص() {
    دع نص = "Hello مرحباً"
    دع معلومات = حلل_نص(نص)
    
    تأكد!(معلومات.يحتوي_عربي)
    تأكد!(معلومات.يحتوي_لاتيني)
    تأكد!(معلومات.حروف_عربية == 5)  // م ر ح ب ا
    تأكد!(معلومات.حروف_تشكيل == 1)  // ً فقط
}
