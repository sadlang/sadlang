// ============== أنواع القياس ==============

/**
 * أساس القياس
 * يحدد المحاور التي يتم القياس عليها
 */
تعداد أساس_قياس:
    حسابي      // |0⟩, |1⟩ - الأساس المعياري (Z)
    هادمارد    // |+⟩, |-⟩ - أساس X
    دائري      // |i⟩, |-i⟩ - أساس Y
    مخصص       // أساس محدد من المستخدم
نهاية

/**
 * نوع القياس
 */
تعداد نوع_قياس:
    مفرد         // قياس كيوبت واحد
    متعدد       // قياس عدة كيوبتات
    جزئي       // قياس جزء من السجل
    كلي        // قياس كل الكيوبتات
    متكرر     // قياس متعدد (عينات)
نهاية

// ============== نتيجة القياس ==============

/**
 * نتيجة قياس كيوبت واحد
 */
هيكل نتيجة_قياس_مفرد:
    كيوبت: عدد
    قيمة: عدد                    // 0 أو 1
    احتمال: عدد_حقيقي           // احتمال هذه النتيجة
    أساس: أساس_قياس
نهاية

/**
 * نتيجة قياس متعدد
 */
صنف نتيجة_قياس:
    خاص:
        _النتائج: قائمة<نتيجة_قياس_مفرد>
        _السلسلة_الثنائية: نص
        _القيمة_الصحيحة: عدد
        _عدد_الكيوبتات: عدد
    
    عام:
        // المنشئ
        دالة جديد(عدد_كيوبتات: عدد) -> نتيجة_قياس:
            متغير ن = نتيجة_قياس()
            ن._عدد_الكيوبتات = عدد_كيوبتات
            ن._النتائج = قائمة<نتيجة_قياس_مفرد>()
            ن._السلسلة_الثنائية = ""
            ن._القيمة_الصحيحة = 0
            أرجع ن
        نهاية
        
        // إضافة نتيجة
        دالة إضافة(ذاتي، نتيجة: نتيجة_قياس_مفرد):
            ذاتي._النتائج.أضف(نتيجة)
            
            // تحديث السلسلة الثنائية
            ذاتي._السلسلة_الثنائية = ذاتي._السلسلة_الثنائية + نص(نتيجة.قيمة)
            
            // تحديث القيمة الصحيحة
            إذا نتيجة.قيمة == 1:
                ذاتي._القيمة_الصحيحة = ذاتي._القيمة_الصحيحة | (1 << نتيجة.كيوبت)
            نهاية
        نهاية
        
        // الحصول على النتائج
        دالة النتائج(ذاتي) -> قائمة<نتيجة_قياس_مفرد>:
            أرجع ذاتي._النتائج
        نهاية
        
        // كسلسلة ثنائية
        دالة إلى_ثنائي(ذاتي) -> نص:
            أرجع ذاتي._السلسلة_الثنائية
        نهاية
        
        // كعدد صحيح
        دالة إلى_عدد(ذاتي) -> عدد:
            أرجع ذاتي._القيمة_الصحيحة
        نهاية
        
        // قراءة كيوبت معين
        دالة قيمة(ذاتي، كيوبت: عدد) -> عدد:
            لكل نتيجة في ذاتي._النتائج:
                إذا نتيجة.كيوبت == كيوبت:
                    أرجع نتيجة.قيمة
                نهاية
            نهاية
            أرجع -1
        نهاية
        
        // تمثيل نصي
        دالة إلى_نص(ذاتي) -> نص:
            أرجع "|" + ذاتي._السلسلة_الثنائية + "⟩"
        نهاية
نهاية

// ============== إحصائيات القياس ==============

/**
 * تجميع نتائج قياسات متعددة
 */
صنف إحصائيات_قياس:
    خاص:
        _العدادات: خريطة<نص، عدد>
        _عدد_التشغيلات: عدد
        _عدد_الكيوبتات: عدد
    
    عام:
        دالة جديد(عدد_كيوبتات: عدد) -> إحصائيات_قياس:
            متغير إ = إحصائيات_قياس()
            إ._العدادات = خريطة<نص، عدد>()
            إ._عدد_التشغيلات = 0
            إ._عدد_الكيوبتات = عدد_كيوبتات
            أرجع إ
        نهاية
        
        // تسجيل نتيجة
        دالة سجل(ذاتي، نتيجة: نتيجة_قياس):
            متغير مفتاح = نتيجة.إلى_ثنائي()
            
            إذا ذاتي._العدادات.يحتوي(مفتاح):
                ذاتي._العدادات[مفتاح] = ذاتي._العدادات[مفتاح] + 1
            وإلا:
                ذاتي._العدادات[مفتاح] = 1
            نهاية
            
            ذاتي._عدد_التشغيلات = ذاتي._عدد_التشغيلات + 1
        نهاية
        
        // الاحتمالات
        دالة الاحتمالات(ذاتي) -> خريطة<نص، عدد_حقيقي>:
            متغير نتيجة = خريطة<نص، عدد_حقيقي>()
            
            لكل مفتاح، عدد في ذاتي._العدادات:
                نتيجة[مفتاح] = عدد / ذاتي._عدد_التشغيلات
            نهاية
            
            أرجع نتيجة
        نهاية
        
        // العدادات
        دالة العدادات(ذاتي) -> خريطة<نص، عدد>:
            أرجع ذاتي._العدادات
        نهاية
        
        // النتيجة الأكثر شيوعاً
        دالة الأكثر_شيوعاً(ذاتي) -> نص:
            متغير أفضل_مفتاح = ""
            متغير أعلى_عدد = 0
            
            لكل مفتاح، عدد في ذاتي._العدادات:
                إذا عدد > أعلى_عدد:
                    أعلى_عدد = عدد
                    أفضل_مفتاح = مفتاح
                نهاية
            نهاية
            
            أرجع أفضل_مفتاح
        نهاية
        
        // الإنتروبيا (مقياس عدم اليقين)
        دالة الإنتروبيا(ذاتي) -> عدد_حقيقي:
            متغير H = 0.0
            متغير الاحتمالات = ذاتي.الاحتمالات()
            
            لكل _، احتمال في الاحتمالات:
                إذا احتمال > 0.0:
                    H = H - احتمال * لوغاريتم٢(احتمال)
                نهاية
            نهاية
            
            أرجع H
        نهاية
        
        // التمثيل النصي
        دالة إلى_نص(ذاتي) -> نص:
            متغير نتيجة = "إحصائيات القياس:\n"
            نتيجة = نتيجة + "═══════════════════════════════\n"
            نتيجة = نتيجة + "عدد التشغيلات: " + نص(ذاتي._عدد_التشغيلات) + "\n\n"
            
            متغير الاحتمالات = ذاتي.الاحتمالات()
            
            لكل مفتاح، احتمال في الاحتمالات:
                متغير نسبة = احتمال * 100.0
                متغير شريط = ""
                متغير طول_شريط = عدد_صحيح(نسبة / 5.0)
                
                كرر طول_شريط:
                    شريط = شريط + "█"
                نهاية
                
                نتيجة = نتيجة + "|" + مفتاح + "⟩: "
                نتيجة = نتيجة + شريط + " "
                نتيجة = نتيجة + نص_حقيقي(نسبة، 2) + "%\n"
            نهاية
            
            نتيجة = نتيجة + "\nالإنتروبيا: " + نص_حقيقي(ذاتي.الإنتروبيا()، 3) + " بت"
            
            أرجع نتيجة
        نهاية
نهاية

// ============== عامل القياس ==============

/**
 * عامل القياس الكمومي
 */
صنف عامل_قياس:
    خاص:
        _الأساس: أساس_قياس
        _المولد: مولد_عشوائي
        
        // تحويل الأساس
        دالة _تحويل_قبل(ذاتي، حالة: متجه_حالة، كيوبت: عدد):
            اختر ذاتي._الأساس:
                حالة أساس_قياس.هادمارد:
                    // تطبيق H لتحويل من أساس X إلى Z
                    حالة.H(كيوبت)
                نهاية
                حالة أساس_قياس.دائري:
                    // تطبيق S† ثم H لتحويل من أساس Y إلى Z
                    حالة.S_معكوس(كيوبت)
                    حالة.H(كيوبت)
                نهاية
            نهاية
        نهاية
        
        دالة _تحويل_بعد(ذاتي، حالة: متجه_حالة، كيوبت: عدد):
            اختر ذاتي._الأساس:
                حالة أساس_قياس.هادمارد:
                    حالة.H(كيوبت)
                نهاية
                حالة أساس_قياس.دائري:
                    حالة.H(كيوبت)
                    حالة.S(كيوبت)
                نهاية
            نهاية
        نهاية
    
    عام:
        دالة جديد(أساس: أساس_قياس = أساس_قياس.حسابي) -> عامل_قياس:
            متغير ع = عامل_قياس()
            ع._الأساس = أساس
            ع._المولد = مولد_عشوائي()
            أرجع ع
        نهاية
        
        // قياس كيوبت واحد
        دالة قياس_مفرد(ذاتي، حالة: متجه_حالة، كيوبت: عدد) -> نتيجة_قياس_مفرد:
            // تحويل الأساس إذا لزم الأمر
            ذاتي._تحويل_قبل(حالة، كيوبت)
            
            // حساب احتمال |1⟩
            متغير احتمال_واحد = حالة.احتمال_واحد(كيوبت)
            
            // توليد قيمة عشوائية
            متغير عشوائي = ذاتي._المولد.عشوائي_حقيقي(0.0، 1.0)
            
            // تحديد النتيجة
            متغير القيمة = 0
            إذا عشوائي < احتمال_واحد:
                القيمة = 1
            نهاية
            
            // انهيار الحالة
            حالة.انهيار(كيوبت، القيمة)
            
            // إرجاع التحويل
            ذاتي._تحويل_بعد(حالة، كيوبت)
            
            // إنشاء النتيجة
            متغير نتيجة = نتيجة_قياس_مفرد()
            نتيجة.كيوبت = كيوبت
            نتيجة.قيمة = القيمة
            نتيجة.احتمال = إذا القيمة == 1 فإن احتمال_واحد وإلا 1.0 - احتمال_واحد
            نتيجة.أساس = ذاتي._الأساس
            
            أرجع نتيجة
        نهاية
        
        // قياس عدة كيوبتات
        دالة قياس_متعدد(ذاتي، حالة: متجه_حالة، كيوبتات: قائمة<عدد>) -> نتيجة_قياس:
            متغير نتيجة = نتيجة_قياس.جديد(كيوبتات.الطول())
            
            لكل كيوبت في كيوبتات:
                متغير نتيجة_مفردة = ذاتي.قياس_مفرد(حالة، كيوبت)
                نتيجة.إضافة(نتيجة_مفردة)
            نهاية
            
            أرجع نتيجة
        نهاية
        
        // قياس كل الكيوبتات
        دالة قياس_الكل(ذاتي، حالة: متجه_حالة) -> نتيجة_قياس:
            متغير كيوبتات = قائمة<عدد>()
            
            لكل i في نطاق(0، حالة.عدد_الكيوبتات()):
                كيوبتات.أضف(i)
            نهاية
            
            أرجع ذاتي.قياس_متعدد(حالة، كيوبتات)
        نهاية
        
        // قياس متعدد التشغيلات (عينات)
        دالة عينات(ذاتي، حالة: متجه_حالة، عدد: عدد) -> إحصائيات_قياس:
            متغير إحصائيات = إحصائيات_قياس.جديد(حالة.عدد_الكيوبتات())
            
            // نسخ الحالة الأصلية
            متغير الحالة_الأصلية = حالة.نسخ()
            
            كرر عدد:
                // قياس نسخة من الحالة
                حالة = الحالة_الأصلية.نسخ()
                متغير نتيجة = ذاتي.قياس_الكل(حالة)
                إحصائيات.سجل(نتيجة)
            نهاية
            
            أرجع إحصائيات
        نهاية
نهاية

// ============== قياسات خاصة ==============

/**
 * قياس بيل - للتشابك الكمومي
 */
صنف قياس_بيل:
    عام:
        // قياس في أساس بيل
        دالة قياس(حالة: متجه_حالة، كيوبت1: عدد، كيوبت2: عدد) -> نص:
            // تحويل من أساس بيل إلى حسابي
            حالة.CNOT(كيوبت1، كيوبت2)
            حالة.H(كيوبت1)
            
            // قياس
            متغير عامل = عامل_قياس.جديد()
            متغير ن1 = عامل.قياس_مفرد(حالة، كيوبت1)
            متغير ن2 = عامل.قياس_مفرد(حالة، كيوبت2)
            
            // تحديد حالة بيل
            اختر (ن1.قيمة، ن2.قيمة):
                حالة (0، 0): أرجع "|Φ+⟩"  // (|00⟩ + |11⟩)/√2
                حالة (0، 1): أرجع "|Ψ+⟩"  // (|01⟩ + |10⟩)/√2
                حالة (1، 0): أرجع "|Φ-⟩"  // (|00⟩ - |11⟩)/√2
                حالة (1، 1): أرجع "|Ψ-⟩"  // (|01⟩ - |10⟩)/√2
            نهاية
            
            أرجع "غير معروف"
        نهاية
نهاية

/**
 * قياس GHZ - للتشابك متعدد الكيوبتات
 */
صنف قياس_GHZ:
    عام:
        دالة قياس(حالة: متجه_حالة، كيوبتات: قائمة<عدد>) -> نص:
            // فك التشابك
            لكل i في نطاق(كيوبتات.الطول() - 1، 0، -1):
                حالة.CNOT(كيوبتات[0]، كيوبتات[i])
            نهاية
            حالة.H(كيوبتات[0])
            
            // قياس الكيوبت الأول
            متغير عامل = عامل_قياس.جديد()
            متغير نتيجة = عامل.قياس_مفرد(حالة، كيوبتات[0])
            
            إذا نتيجة.قيمة == 0:
                أرجع "|GHZ+⟩"  // (|00...0⟩ + |11...1⟩)/√2
            وإلا:
                أرجع "|GHZ-⟩"  // (|00...0⟩ - |11...1⟩)/√2
            نهاية
        نهاية
نهاية

// ============== التحقق من القياس ==============

/**
 * التحقق من صحة القياس
 */
صنف محقق_قياس:
    عام:
        // التحقق من التطبيع
        دالة تحقق_التطبيع(حالة: متجه_حالة) -> منطقي:
            متغير مجموع = 0.0
            
            لكل i في نطاق(0، حالة.الحجم()):
                مجموع = مجموع + حالة.احتمال(i)
            نهاية
            
            // يجب أن يكون المجموع ≈ 1
            أرجع |مجموع - 1.0| < 0.0001
        نهاية
        
        // التحقق من الانهيار
        دالة تحقق_الانهيار(حالة: متجه_حالة، كيوبت: عدد، قيمة: عدد) -> منطقي:
            // بعد القياس، يجب أن يكون الكيوبت في حالة محددة
            متغير احتمال = إذا قيمة == 1 فإن حالة.احتمال_واحد(كيوبت) وإلا حالة.احتمال_صفر(كيوبت)
            
            أرجع احتمال > 0.9999
        نهاية
نهاية

// ============== دوال مساعدة ==============

دالة لوغاريتم٢(س: عدد_حقيقي) -> عدد_حقيقي:
    أرجع لوغاريتم(س) / لوغاريتم(2.0)
نهاية

دالة نص_حقيقي(قيمة: عدد_حقيقي، دقة: عدد) -> نص:
    // تحويل رقم حقيقي إلى نص بدقة محددة
    أرجع تنسيق("{:.{}f}"، قيمة، دقة)
نهاية
