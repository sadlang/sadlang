/**
 * ===================================================================================
 *  البوابات الكمومية - Quantum Gates (T453)
 * ===================================================================================
 * 
 *  الوصف: مكتبة البوابات الكمومية بالعربية
 *  Description: Quantum gates library in Arabic
 *
 *  توفر:
 *  - البوابات الأحادية (single-qubit)
 *  - البوابات الثنائية (two-qubit)
 *  - البوابات المتعددة
 *  - بوابات مخصصة
 * 
 * ===================================================================================
 */

// ==========================================
// البوابات الكمومية
// باللغة العربية الأصيلة
// ==========================================

/**
 * نوع البوابة الكمومية
 */
تعداد نوع_بوابة:
    أحادية,      // تعمل على كيوبت واحد
    ثنائية,      // تعمل على كيوبتين
    متعددة,      // تعمل على عدة كيوبتات
    مخصصة        // بوابة معرفة من المستخدم
نهاية

/**
 * البوابة الكمومية الأساسية
 */
واجهة بوابة_كمومية:
    دالة الاسم() -> نص
    دالة النوع() -> نوع_بوابة
    دالة عدد_الكيوبتات() -> عدد_صحيح
    دالة المصفوفة() -> مصفوفة<عدد_مركب>
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>)
نهاية

// ==========================================
// البوابات الأحادية - Single-Qubit Gates
// ==========================================

/**
 * بوابة باولي-X (NOT الكمومية)
 * تقلب الحالة: |0⟩ ↔ |1⟩
 */
صنف بوابة_X ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "X"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.أحادية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 1
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        // [[0, 1], [1, 0]]
        أرجع مصفوفة_من([
            [مركب(0, 0), مركب(1, 0)],
            [مركب(1, 0), مركب(0, 0)]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        لكل هدف في أهداف:
            سجل[هدف].X()
        نهاية
    نهاية
نهاية

/**
 * بوابة باولي-Y
 */
صنف بوابة_Y ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "Y"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.أحادية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 1
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        // [[0, -i], [i, 0]]
        أرجع مصفوفة_من([
            [مركب(0, 0), مركب(0, -1)],
            [مركب(0, 1), مركب(0, 0)]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        لكل هدف في أهداف:
            سجل[هدف].Y()
        نهاية
    نهاية
نهاية

/**
 * بوابة باولي-Z
 * تضيف طور π للحالة |1⟩
 */
صنف بوابة_Z ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "Z"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.أحادية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 1
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        // [[1, 0], [0, -1]]
        أرجع مصفوفة_من([
            [مركب(1, 0), مركب(0, 0)],
            [مركب(0, 0), مركب(-1, 0)]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        لكل هدف في أهداف:
            سجل[هدف].Z()
        نهاية
    نهاية
نهاية

/**
 * بوابة هادامارد (H)
 * تحول |0⟩ إلى |+⟩ و |1⟩ إلى |-⟩
 * تخلق التراكب الكمومي
 */
صنف بوابة_H ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "H"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.أحادية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 1
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        // (1/√2) * [[1, 1], [1, -1]]
        متغير ج = 1.0 / جذر(2.0)
        أرجع مصفوفة_من([
            [مركب(ج, 0), مركب(ج, 0)],
            [مركب(ج, 0), مركب(-ج, 0)]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        لكل هدف في أهداف:
            سجل[هدف].H()
        نهاية
    نهاية
نهاية

/**
 * بوابة S (بوابة الطور)
 * تضيف طور π/2 للحالة |1⟩
 */
صنف بوابة_S ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "S"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.أحادية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 1
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        // [[1, 0], [0, i]]
        أرجع مصفوفة_من([
            [مركب(1, 0), مركب(0, 0)],
            [مركب(0, 0), مركب(0, 1)]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        لكل هدف في أهداف:
            سجل[هدف].S()
        نهاية
    نهاية
نهاية

/**
 * بوابة T (π/8)
 * تضيف طور π/4 للحالة |1⟩
 */
صنف بوابة_T ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "T"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.أحادية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 1
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        متغير زاوية = ط / 4.0  // π/4
        أرجع مصفوفة_من([
            [مركب(1, 0), مركب(0, 0)],
            [مركب(0, 0), مركب(جتا(زاوية), جا(زاوية))]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        لكل هدف في أهداف:
            سجل[هدف].T()
        نهاية
    نهاية
نهاية

/**
 * بوابة الدوران حول محور X
 */
صنف بوابة_Rx ينفذ بوابة_كمومية:
    خاص زاوية: عدد_حقيقي
    
    دالة جديد(ز: عدد_حقيقي):
        ذاتي.زاوية = ز
    نهاية
    
    دالة الاسم() -> نص:
        أرجع "Rx(" + نص(ذاتي.زاوية) + ")"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.أحادية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 1
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        متغير نصف = ذاتي.زاوية / 2.0
        أرجع مصفوفة_من([
            [مركب(جتا(نصف), 0), مركب(0, -جا(نصف))],
            [مركب(0, -جا(نصف)), مركب(جتا(نصف), 0)]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        لكل هدف في أهداف:
            سجل[هدف].Rx(ذاتي.زاوية)
        نهاية
    نهاية
نهاية

// ==========================================
// البوابات الثنائية - Two-Qubit Gates
// ==========================================

/**
 * بوابة CNOT (التحكم-NOT)
 * إذا كان الكيوبت المتحكم |1⟩، تقلب الكيوبت الهدف
 */
صنف بوابة_CNOT ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "CNOT"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.ثنائية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 2
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        // مصفوفة 4×4
        أرجع مصفوفة_من([
            [مركب(1,0), مركب(0,0), مركب(0,0), مركب(0,0)],
            [مركب(0,0), مركب(1,0), مركب(0,0), مركب(0,0)],
            [مركب(0,0), مركب(0,0), مركب(0,0), مركب(1,0)],
            [مركب(0,0), مركب(0,0), مركب(1,0), مركب(0,0)]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        إذا أهداف.الطول() != 2:
            خطأ("CNOT تحتاج كيوبتين بالضبط")
        نهاية
        
        متغير متحكم = أهداف[0]
        متغير هدف = أهداف[1]
        
        // تطبيق CNOT على السجل
        سجل.تطبيق_CNOT(متحكم، هدف)
    نهاية
نهاية

/**
 * بوابة CZ (التحكم-Z)
 */
صنف بوابة_CZ ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "CZ"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.ثنائية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 2
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        أرجع مصفوفة_من([
            [مركب(1,0), مركب(0,0), مركب(0,0), مركب(0,0)],
            [مركب(0,0), مركب(1,0), مركب(0,0), مركب(0,0)],
            [مركب(0,0), مركب(0,0), مركب(1,0), مركب(0,0)],
            [مركب(0,0), مركب(0,0), مركب(0,0), مركب(-1,0)]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        إذا أهداف.الطول() != 2:
            خطأ("CZ تحتاج كيوبتين بالضبط")
        نهاية
        
        سجل.تطبيق_CZ(أهداف[0]، أهداف[1])
    نهاية
نهاية

/**
 * بوابة SWAP
 * تبادل حالتي كيوبتين
 */
صنف بوابة_SWAP ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "SWAP"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.ثنائية
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 2
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        أرجع مصفوفة_من([
            [مركب(1,0), مركب(0,0), مركب(0,0), مركب(0,0)],
            [مركب(0,0), مركب(0,0), مركب(1,0), مركب(0,0)],
            [مركب(0,0), مركب(1,0), مركب(0,0), مركب(0,0)],
            [مركب(0,0), مركب(0,0), مركب(0,0), مركب(1,0)]
        ])
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        سجل.تبادل(أهداف[0]، أهداف[1])
    نهاية
نهاية

// ==========================================
// البوابات المتعددة - Multi-Qubit Gates
// ==========================================

/**
 * بوابة Toffoli (CCNOT)
 * بوابة AND الكمومية العكسية
 */
صنف بوابة_توفولي ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "Toffoli"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.متعددة
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 3
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        // مصفوفة 8×8
        أرجع مصفوفة_وحدة(8).مع_تبديل(6, 7)
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        إذا أهداف.الطول() != 3:
            خطأ("Toffoli تحتاج 3 كيوبتات")
        نهاية
        
        سجل.تطبيق_توفولي(أهداف[0]، أهداف[1]، أهداف[2])
    نهاية
نهاية

/**
 * بوابة Fredkin (CSWAP)
 * التحكم-تبادل
 */
صنف بوابة_فريدكين ينفذ بوابة_كمومية:
    دالة الاسم() -> نص:
        أرجع "Fredkin"
    نهاية
    
    دالة النوع() -> نوع_بوابة:
        أرجع نوع_بوابة.متعددة
    نهاية
    
    دالة عدد_الكيوبتات() -> عدد_صحيح:
        أرجع 3
    نهاية
    
    دالة المصفوفة() -> مصفوفة<عدد_مركب>:
        أرجع مصفوفة_وحدة(8).مع_تبديل(5, 6)
    نهاية
    
    دالة تطبيق(سجل: سجل_كمومي، أهداف: قائمة<عدد_صحيح>):
        سجل.تطبيق_فريدكين(أهداف[0]، أهداف[1]، أهداف[2])
    نهاية
نهاية

// ==========================================
// دوال مساعدة
// ==========================================

/**
 * إنشاء مصفوفة وحدة
 */
دالة مصفوفة_وحدة(حجم: عدد_صحيح) -> مصفوفة<عدد_مركب>:
    متغير م = مصفوفة_جديدة<عدد_مركب>(حجم، حجم)
    
    لكل ي في نطاق(0، حجم):
        م[ي][ي] = مركب(1.0، 0.0)
    نهاية
    
    أرجع م
نهاية

/**
 * تطبيق بوابات متسلسلة
 */
دالة تطبيق_سلسلة(سجل: سجل_كمومي، بوابات: قائمة<(بوابة_كمومية، قائمة<عدد_صحيح>)>):
    لكل (بوابة، أهداف) في بوابات:
        بوابة.تطبيق(سجل، أهداف)
    نهاية
نهاية

// ==========================================
// ثوابت مفيدة
// ==========================================

ثابت ط = 3.14159265358979323846   // π
ثابت ط٢ = 6.28318530717958647692   // 2π
ثابت ط_نصف = 1.57079632679489661923 // π/2
ثابت ط_ربع = 0.78539816339744830961 // π/4
