/**
 * إنشاء دائرة بسرعة
 */
دالة دائرة(كيوبتات: عدد_صحيح) -> دائرة_كمومية:
    أرجع دائرة_كمومية.جديد(كيوبتات)
نهاية

/**
 * دائرة تشابك Bell
 */
دالة دائرة_بيل() -> دائرة_كمومية:
    أرجع دائرة(2)
        .H(0)
        .CNOT(0، 1)
        .قياس_الكل()
نهاية

/**
 * دائرة GHZ لـ n كيوبتات
 */
دالة دائرة_GHZ(ن: عدد_صحيح) -> دائرة_كمومية:
    متغير د = دائرة(ن)
    د.H(0)
    
    لكل ي في نطاق(1، ن):
        د.CNOT(0، ي)
    نهاية
    
    أرجع د.قياس_الكل()
نهاية

/**
 * دائرة QFT (تحويل فورييه الكمومي)
 */
دالة دائرة_QFT(ن: عدد_صحيح) -> دائرة_كمومية:
    متغير د = دائرة(ن)
    
    لكل ي في نطاق(0، ن):
        د.H(ي)
        
        لكل ك في نطاق(ي + 1، ن):
            متغير زاوية = ط / قوة(2، ك - ي)
            // تطبيق بوابة CR المتحكمة
            د.Rz(ي، زاوية / 2)
            د.CNOT(ك، ي)
            د.Rz(ي، -زاوية / 2)
            د.CNOT(ك، ي)
        نهاية
    نهاية
    
    // عكس ترتيب الكيوبتات
    لكل ي في نطاق(0، ن / 2):
        د.SWAP(ي، ن - 1 - ي)
    نهاية
    
    أرجع د
نهاية
