/// (AR) غلاف آمن لـ malloc
/// (EN) Safe wrapper for malloc
/// @return (AR) نتيجة<*فراغ> بدلاً من مؤشر قد يكون null
دالة احجز_ذاكرة_آمن(الحجم: حجم) -> نتيجة<غلاف_آمن<*فراغ>>
    ثابت مؤشر = malloc(الحجم)
    إذا مؤشر == فارغ {
        إرجاع خطأ("فشل حجز الذاكرة")
    }
    إرجاع نجاح(غلاف_آمن(مؤشر, free))
نهاية

/// (AR) غلاف آمن لـ fopen
/// (EN) Safe wrapper for fopen
دالة افتح_ملف_آمن(المسار: *ثابت[حرف], الوضع: *ثابت[حرف]) -> نتيجة<غلاف_آمن<مؤشر_ملف>>
    ثابت ملف = fopen(المسار, الوضع)
    إذا ملف == فارغ {
        إرجاع خطأ("فشل فتح الملف")
    }
    إرجاع نجاح(غلاف_آمن(ملف, fclose))
نهاية

/// (AR) غلاف آمن لقراءة ملف كامل
/// (EN) Safe wrapper for reading entire file
دالة اقرأ_ملف_كامل(المسار: *ثابت[حرف]) -> نتيجة<غلاف_آمن<*حرف>>
    // فتح الملف
    ثابت ملف = fopen(المسار, "rb")
    إذا ملف == فارغ {
        إرجاع خطأ("فشل فتح الملف للقراءة")
    }
    
    // الحصول على حجم الملف
    fseek(ملف, 0, 2)  // SEEK_END
    ثابت الحجم = ftell(ملف)
    fseek(ملف, 0, 0)  // SEEK_SET
    
    // حجز ذاكرة
    ثابت محتوى = malloc(الحجم + 1)
    إذا محتوى == فارغ {
        fclose(ملف)
        إرجاع خطأ("فشل حجز الذاكرة")
    }
    
    // قراءة المحتوى
    ثابت مقروء = fread(محتوى, 1, الحجم, ملف)
    fclose(ملف)
    
    // إضافة نهاية النص
    محتوى[مقروء] = 0
    
    إرجاع نجاح(غلاف_آمن(محتوى, free))
نهاية

/// (AR) غلاف آمن لنسخ النص
/// (EN) Safe wrapper for string duplication
دالة انسخ_نص_آمن(النص: *ثابت[حرف]) -> نتيجة<غلاف_آمن<*حرف>>
    ثابت نسخة = strdup(النص)
    إذا نسخة == فارغ {
        إرجاع خطأ("فشل نسخ النص")
    }
    إرجاع نجاح(غلاف_آمن(نسخة, free))
نهاية

