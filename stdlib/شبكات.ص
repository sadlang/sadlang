# صنف خادم_ويب — خادم HTTP كائني
# ════════════════════════════════════════════════════════════════════

##
# صنف خادم_ويب
#
# يُغلّف خادم HTTP. يدعم GET/POST/PUT/DELETE وإعدادات CORS.
#
# الاستخدام:
#   متغير خ = خادم_ويب()
#   خ.اسمح_بالوصول("*")
#   خ.ابدأ(8080)
#   خ.أوقف()
#   خ.أزل()
#
# وتسجيلُ المسارات بالمدمَجةِ مباشرةً، باسمِ دالّةٍ **حرفيٍّ بلا معاملات**:
#   دالة معالج_جذر()
#       عين_نص_الرد("مرحبا")
#   نهاية
#   متغير خ = أنشئ_خادم(0)
#   عند_طلب_جلب(خ، "/"، "معالج_جذر")
#
# (والمدمَجةُ تأخذُ مقبضَ الخادمِ الخامَّ لا كائنَ «خادم_ويب» — فحقلُه خاصّ.
#  والصيغةُ مقيسةٌ خضراءَ في 033_http_server_full_routes.ص.)
#
# 🔑 وكان هنا مثالٌ يضربُ «خ.عند_جلب("/مرحبا"، لامدا(طلب، رد) …)»
# ويخالفُ العقدَ في موضعَين معًا: المعالجُ **لامدا** لا اسمًا حرفيًّا، وله
# **معاملان** والعقدُ `void()` بلا معاملات. والمثالُ المنثورُ عقدٌ يُقاس، فلا
# يُترَكُ يصفُ واجهةً محذوفةً ولا صيغةً مرفوضة.
#
# جدول الميثودات:
#   ابدأ(منفذ)                — بدء الاستماع
#   أوقف()                   — إيقاف الخادم
#   اسمح_بالوصول(نطاق)       — إعداد CORS
#   أزل()                    — إزالة الخادم وتحرير الموارد
#   هل_صالح()               — هل الخادم نشط؟
##
صدّر صنف خادم_ويب

    ## معرّف الخادم الداخلي
    متغير خاص _م

    ##
    # الباني — ينشئ خادم HTTP جديداً
    # منفذ_بداية: اختياري — المنفذ عند الإنشاء
    ##
    باني(منفذ_بداية)
        إذا (منفذ_بداية != لاشيء و منفذ_بداية > 0)
            هذا._م = أنشئ_خادم(منفذ_بداية)
        وإلا
            هذا._م = أنشئ_خادم(0)
        نهاية
    نهاية

    ## الهدّام — إيقاف وإزالة تلقائية
    هدم()
        إذا (هذا._م > 0)
            أوقف_الخادم(هذا._م)
            أزل_خادم(هذا._م)
            هذا._م = 0
        نهاية
    نهاية

    # ── تسجيل المسارات: لا أغلفةَ هنا ────────────────────────────
    #
    # 🔑 حُذفت أربعةُ أغلفةٍ (عند_جلب · عند_إرسال · عند_استبدال · عند_حذف)
    # كان كلٌّ منها يُمرّرُ `معالج` **معاملًا** إلى مدمَجةِ تسجيلِ المسار. وليست
    # ناقصةَ التنفيذِ بل **غيرَ قابلةٍ للتمثيلِ أصلًا**: المدمَجةُ تبني ثانكَ
    # `void()` وقتَ التوليد، فتلزمُها الدالّةُ **حرفيّةً في موضعِ ندائِها نفسِه**.
    # ومقيسٌ (٢٠٢٦-٠٩-٠٣) أنّ الأمرَ ليس خاصًّا بالطرائق: حتّى دالّةٌ حرّةٌ
    # `دالة سجل(خادم، مسار، معالج)` تُمرّرُ المعالجَ تفشلُ بالرمزِ نفسِه.
    #
    # وأثرُها المقيسُ كان أوسعَ من ميزةٍ ناقصة: مجرّدُ `استورد شبكات` يُخفّضُ
    # أغلفةَ الوحدةِ كلَّها ولو لم تُستعمَل، فكان يُخرجُ أربعةَ أخطاءِ SEM049
    # ويُفشلُ الترجمة — فتحمرُّ **عشرُ بذورٍ تسعٌ منها لا تمسُّ مساراتِ HTTP
    # إطلاقًا**. أي أنّ الأغلفةَ الأربعةَ كانت تُسقِطُ الوحدةَ القياسيّةَ كلَّها.
    #
    # والصيغةُ العاملةُ اليومَ هي المدمَجةُ مباشرةً باسمِ دالّةٍ حرفيّ:
    #     دالة معالج_جذر()
    #         عين_نص_الرد("مرحبا")
    #     نهاية
    #     متغير خ = أنشئ_خادم(0)
    #     عند_طلب_جلب(خ، "/"، "معالج_جذر")
    #
    # والمعالجُ غيرُ المباشر (متغيّر · معامل · لامدا) دَينٌ مُقيَّدٌ يلزمُه
    # **ترامبولينُ وقتِ تشغيلٍ يعرفُ اتّفاقيّةَ المُغلَقات** — وهو ما يقولُه
    # تلميحُ SEM049 نفسُه. انظر: compiler/src/backend/llvm/builders/builtins/
    # builtins_network_ops.cpp (emitRouteRegistration).

    # ── التحكم بالخادم ───────────────────────────────────────────

    ## ابدأ — بدء الاستماع على المنفذ المحدد
    دالة ابدأ(منفذ)
        ارجع ابدأ_الاستماع(هذا._م، منفذ)
    نهاية

    ## أوقف — إيقاف الخادم
    دالة أوقف()
        ارجع أوقف_الخادم(هذا._م)
    نهاية

    ## اسمح_بالوصول — تفعيل CORS ("*" للجميع أو نطاق محدد)
    دالة اسمح_بالوصول(نطاق)
        ارجع اسمح_بالوصول_الخارجي(هذا._م، نطاق)
    نهاية

    ## أزل — إزالة الخادم وتحرير الموارد
    دالة أزل()
        إذا (هذا._م > 0)
            متغير ن = أزل_خادم(هذا._م)
            هذا._م = 0
            ارجع ن
        نهاية
        ارجع خطأ
    نهاية

    ## هل_صالح — هل الخادم نشط؟
    دالة هل_صالح()
        ارجع هذا._م > 0
    نهاية

نهاية


