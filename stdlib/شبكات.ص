# ════════════════════════════════════════════════════════════════════

##
# صنف مقبس_رسائل
#
# يُغلّف مقبس UDP. UDP أسرع من TCP ولا يضمن الترتيب أو الوصول.
#
# الاستخدام:
#   متغير م = مقبس_رسائل()
#   م.ربط(9000)
#   م.أرسل_لـ("مرحبا"، "127.0.0.1"، 9001)
#   متغير رسالة = م.استقبل()
#   م.أغلق()
#
# جدول الميثودات:
#   ربط(منفذ)                — ربط بمنفذ (0 = تلقائي)
#   أرسل_لـ(بيانات,مضيف,منفذ) — إرسال رسالة UDP
#   استقبل(حجم)              — استقبال رسالة (حجم اختياري)
#   أغلق()                   — إغلاق المقبس
#   حدد_مهلة_الاستقبال(مللي) — مهلة الاستقبال
#   حدد_مهلة_الإرسال(مللي)  — مهلة الإرسال
#   المنفذ()                 — رقم المنفذ المحلي (تستدعي منفذ_محلي)
#   هل_صالح()               — هل المقبس مفتوح؟
##
صدّر صنف مقبس_رسائل

    ## المعرّف الداخلي
    متغير خاص _م

    ## الباني — ينشئ مقبس UDP جديداً
    باني()
        هذا._م = أنشئ_مرسال()
    نهاية

    ## الهدّام — إغلاق تلقائي
    هدم()
        إذا (هذا._م > 0)
            أغلق_مرسال(هذا._م)
            هذا._م = 0
        نهاية
    نهاية

    ## ربط — ربط بمنفذ محلي
    دالة ربط(منفذ)
        ارجع خصص_منفذ_رسائل(هذا._م، منفذ)
    نهاية

    ## أرسل_لـ — إرسال رسالة UDP لوجهة محددة
    دالة أرسل_لـ(بيانات، مضيف، منفذ)
        ارجع أرسل_رسالة(هذا._م، بيانات، مضيف، منفذ)
    نهاية

    ## استقبل — استقبال رسالة UDP (حجم اختياري)
    دالة استقبل(حجم)
        إذا (حجم != لاشيء)
            ارجع استقبل_رسالة(هذا._م، حجم)
        وإلا
            ارجع استقبل_رسالة(هذا._م)
        نهاية
    نهاية

    ## أغلق — إغلاق المقبس
    دالة أغلق()
        إذا (هذا._م > 0)
            متغير ن = أغلق_مرسال(هذا._م)
            هذا._م = 0
            ارجع ن
        نهاية
        ارجع خطأ
    نهاية

    ## حدد_مهلة_الاستقبال — مهلة الاستقبال بالمللي ثانية
    دالة حدد_مهلة_الاستقبال(مللي)
        ارجع حدد_انتظار_الاستقبال(هذا._م، مللي)
    نهاية

    ## حدد_مهلة_الإرسال — مهلة الإرسال بالمللي ثانية
    دالة حدد_مهلة_الإرسال(مللي)
        ارجع حدد_انتظار_الإرسال(هذا._م، مللي)
    نهاية

    ##
    # المنفذ — رقم المنفذ المحلي
    # الاسم مختلف عن منفذ_محلي(م) لتجنب التعارض الداخلي
    ##
    دالة المنفذ()
        إذا (هذا._م <= 0)
            ارجع 0
        نهاية
        ارجع منفذ_محلي(هذا._م)
    نهاية

    ## هل_صالح — هل المقبس مفتوح؟
    دالة هل_صالح()
        ارجع هذا._م > 0
    نهاية

نهاية


