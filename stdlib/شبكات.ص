# ════════════════════════════════════════════════════════════════════

##
# صنف عنوان_شبكة
#
# يُغلّف عنوان شبكة IPv4 أو IPv6.
#
# الاستخدام:
#   متغير ع4 = عنوان_شبكة("127.0.0.1"، 8080)      # IPv4
#   متغير ع6 = عنوان_شبكة("::1"، 8888، 6)           # IPv6
#
#   اطبع_سطر(ع4.عنوان_جهاز())   # "127.0.0.1"  (تستدعي رقم_الجهاز)
#   اطبع_سطر(ع4.عدد_منفذ())     # 8080         (تستدعي رقم_المنفذ)
#   اطبع_سطر(ع4.هل_قديم())      # صحيح
#   اطبع_سطر(ع4.كنص())          # "127.0.0.1:8080"
#   ع4.أغلق()
##
صدّر صنف عنوان_شبكة

    ## المعرّف الداخلي للعنوان
    متغير خاص _م

    ##
    # الباني — ينشئ عنوان شبكة
    # رقم_جهاز: عنوان IP كنص ("127.0.0.1" أو "::1")
    # منفذ:     رقم المنفذ
    # نوع:      اختياري — 4 لـ IPv4 (افتراضي)، 6 لـ IPv6
    ##
    باني(رقم_جهاز، منفذ، نوع)
        إذا (نوع != لاشيء و نوع == 6)
            هذا._م = عنوان_حديث(رقم_جهاز، منفذ)
        وإلا
            هذا._م = عنوان(رقم_جهاز، منفذ)
        نهاية
    نهاية

    ## الهدّام — تحرير تلقائي
    هدم()
        إذا (هذا._م > 0)
            حرر_عنوان(هذا._م)
            هذا._م = 0
        نهاية
    نهاية

    ## أغلق — تحرير يدوي
    دالة أغلق()
        إذا (هذا._م > 0)
            حرر_عنوان(هذا._م)
            هذا._م = 0
        نهاية
    نهاية

    ##
    # عنوان_جهاز — يُرجع عنوان IP كنص ("127.0.0.1" أو "::1")
    # الاسم مختلف عن رقم_الجهاز(م) لتجنب التعارض الداخلي
    ##
    دالة عنوان_جهاز()
        إذا (هذا._م <= 0)
            ارجع ""
        نهاية
        ارجع رقم_الجهاز(هذا._م)
    نهاية

    ##
    # عدد_منفذ — يُرجع رقم المنفذ
    # الاسم مختلف عن رقم_المنفذ(م) لتجنب التعارض الداخلي
    ##
    دالة عدد_منفذ()
        إذا (هذا._م <= 0)
            ارجع 0
        نهاية
        ارجع رقم_المنفذ(هذا._م)
    نهاية

    ##
    # المنفذ — مرادف لـ عدد_منفذ() للاتساق مع مقبس_اتصال
    # يُرجع رقم المنفذ في عنوان الشبكة
    ##
    دالة المنفذ()
        ارجع هذا.عدد_منفذ()
    نهاية

    ## هل_قديم — هل العنوان IPv4؟
    دالة هل_قديم()
        إذا (هذا._م <= 0)
            ارجع خطأ
        نهاية
        ارجع هل_عنوان_قديم(هذا._م)
    نهاية

    ## هل_حديث — هل العنوان IPv6؟
    دالة هل_حديث()
        إذا (هذا._م <= 0)
            ارجع خطأ
        نهاية
        ارجع هل_عنوان_حديث(هذا._م)
    نهاية

    ## كنص — يُرجع "IP:منفذ"
    دالة كنص()
        إذا (هذا._م <= 0)
            ارجع ""
        نهاية
        ارجع العنوان_كنص(هذا._م)
    نهاية

    ## هل_صالح — هل العنوان أُنشئ بنجاح؟
    دالة هل_صالح()
        ارجع هذا._م > 0
    نهاية

نهاية


# ════════════════════════════════════════════════════════════════════
# صنف متصفح_ويب — عميل HTTP كائني
# ════════════════════════════════════════════════════════════════════

##
# صنف متصفح_ويب
#
# يُغلّف عميل HTTP ويدعم GET/POST/PUT/DELETE/PATCH.
#
# الاستخدام:
#   متغير م = متصفح_ويب()
#   م.اضبط_الرابط("https://api.example.com")
#   م.اضبط_المهلة(5000)
#   م.استرجع("/users")
#   إذا (م.ناجح())
#       اطبع_سطر(م.جسم_الرد())
#   وإلا
#       اطبع_سطر("خطأ: " + م.وصف_الخطأ())
#   نهاية
#   م.أغلق()
#
# جدول الميثودات (مع الدالة المضمّنة التي تستدعيها):
#   اضبط_الرابط(ر)         ← حدد_الموقع
#   أضف_رأس(م,ق)           ← أضف_ترويسة
#   اضبط_المهلة(مللي)      ← حدد_الانتظار
#   مصادقة(رمز)            ← سجل_دخول_برمز
#   استرجع(مسار)           ← اجلب       (GET)
#   أرسل_طلب(مسار,بيانات) ← أرسل       (POST)
#   أرسل_تحديث(م,بيانات)  ← استبدل     (PUT)
#   أحذف(مسار)             ← احذف_مورد  (DELETE)
#   رقّع(مسار,بيانات)      ← عدل_مورد   (PATCH)
#   ناجح()                 ← هل_نجح
#   وصف_الخطأ()            ← سبب_الفشل
#   رمز_الرد()             ← رمز_الحالة
#   جسم_الرد()             ← نص_الرد
#   رأس_الرد(اسم)          ← معلومة_الرد
#   الرد_ناجح()            ← هل_الرد_ناجح
#   أفرغ_الرد()            ← تجاهل_الرد
#   أغلق()                 ← أغلق_متصفح
##
صدّر صنف متصفح_ويب

    ## معرّف عميل HTTP الداخلي
    متغير خاص _م

    ## الباني — ينشئ عميل HTTP جديداً
    باني()
        هذا._م = أنشئ_متصفح()
    نهاية

    ## الهدّام — إغلاق تلقائي
    هدم()
        إذا (هذا._م > 0)
            أغلق_متصفح(هذا._م)
            هذا._م = 0
        نهاية
    نهاية

    # ── إعداد العميل ─────────────────────────────────────────────

    ##
    # اضبط_الرابط — يضبط الرابط الأساسي لجميع الطلبات
    # يستدعي المضمّنة: حدد_الموقع(م، رابط)
    ##
    دالة اضبط_الرابط(رابط)
        ارجع حدد_الموقع(هذا._م، رابط)
    نهاية

    ##
    # أضف_رأس — يضيف ترويسة HTTP مخصصة
    # يستدعي المضمّنة: أضف_ترويسة(م، مفتاح، قيمة)
    ##
    دالة أضف_رأس(مفتاح، قيمة)
        ارجع أضف_ترويسة(هذا._م، مفتاح، قيمة)
    نهاية

    ##
    # اضبط_المهلة — يضبط المهلة القصوى بالمللي ثانية
    # يستدعي المضمّنة: حدد_الانتظار(م، مللي)
