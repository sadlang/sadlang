# ════════════════════════════════════════════════════════════════════
# صنف مقبس_اتصال — مقبس TCP كائني
# ════════════════════════════════════════════════════════════════════

##
# صنف مقبس_اتصال
#
# يُغلّف مقبس TCP ويُقدّم واجهة كائنية. يدعم نمطَي العميل والخادم.
#
# الاستخدام كعميل:
#   متغير و = مقبس_اتصال()
#   و.اتصل("127.0.0.1"، 8080)
#   و.أرسل("رسالتي")
#   متغير رد = و.استقبل()
#   و.أغلق()
#
# الاستخدام كخادم:
#   متغير خ = مقبس_اتصال()
#   خ.ربط(8080)
#   خ.استمع()
#   متغير وصلة = خ.اقبل()
#   متغير بيانات = وصلة.استقبل()
#   وصلة.أرسل("ردي")
#   وصلة.أغلق()
#
# جدول الميثودات:
#   ربط(منفذ)                — ربط بمنفذ محلي
#   استمع(طاقة)              — الاستماع للاتصالات الواردة
#   اقبل()                   — قبول اتصال جديد → مقبس_اتصال
#   اتصل(مضيف، منفذ)         — الاتصال بخادم بعيد
#   أرسل(بيانات)              — إرسال بيانات
#   استقبل(حجم)              — استقبال بيانات
#   أغلق()                   — إغلاق المقبس
#   متصلة()                  — هل المقبس متصل؟ (تستدعي هل_متصلة)
#   عنوان_الطرف()            — عنوان الطرف الآخر
#   حدد_مهلة_الاستقبال(مللي) — مهلة الاستقبال
#   حدد_مهلة_الإرسال(مللي)  — مهلة الإرسال
#   أرسل_فوراً(تفعيل)        — تعطيل/تفعيل Nagle
#   المنفذ()                 — رقم المنفذ المحلي (تستدعي منفذ_محلي)
#   هل_صالح()               — هل المقبس مفتوح؟
##
صدّر صنف مقبس_اتصال

    ## المعرّف الداخلي للمقبس
    متغير خاص _م

    ##
    # الباني — ينشئ مقبس TCP جديد، أو يُغلّف معرّفاً موجوداً
    # م: اختياري — بدونه ينشئ جديداً، به يلتف حول موجود (مع اقبل)
    ##
    باني(م)
        إذا (م != لاشيء و م > 0)
            هذا._م = م
        وإلا
            هذا._م = أنشئ_وصلة()
        نهاية
    نهاية

    ## الهدّام — يُغلق المقبس تلقائياً
    هدم()
        إذا (هذا._م > 0)
            أغلق_وصلة(هذا._م)
            هذا._م = 0
        نهاية
    نهاية

    ## ربط — يربط المقبس بمنفذ محلي (0 = اختيار تلقائي)
    دالة ربط(منفذ)
        ارجع خصص_منفذ(هذا._م، منفذ)
    نهاية

    ## استمع — يبدأ الاستماع للاتصالات الواردة
    دالة استمع(طاقة)
        إذا (طاقة != لاشيء)
            ارجع انتظر_اتصالات(هذا._م، طاقة)
        وإلا
            ارجع انتظر_اتصالات(هذا._م)
        نهاية
    نهاية

    ## اقبل — يقبل اتصالاً وارداً ويُرجع مقبس_اتصال جديد (أو لاشيء)
    دالة اقبل()
        متغير م_جديد = اقبل_متصل(هذا._م)
        إذا (م_جديد <= 0)
            ارجع لاشيء
        نهاية
        ارجع مقبس_اتصال(م_جديد)
    نهاية

    ## اتصل — يتصل بخادم TCP بعيد
    دالة اتصل(مضيف، منفذ)
        ارجع اتصل_بـ(هذا._م، مضيف، منفذ)
    نهاية

    ## أرسل — يرسل بيانات نصية
    دالة أرسل(بيانات)
        ارجع أرسل_عبر_وصلة(هذا._م، بيانات)
    نهاية

    ## استقبل — يستقبل بيانات (حجم اختياري)
    دالة استقبل(حجم)
        إذا (حجم != لاشيء)
            ارجع استقبل_عبر_وصلة(هذا._م، حجم)
        وإلا
            ارجع استقبل_عبر_وصلة(هذا._م)
        نهاية
    نهاية

    ## أغلق — يُغلق المقبس ويُحرر الموارد
    دالة أغلق()
        إذا (هذا._م > 0)
            متغير ن = أغلق_وصلة(هذا._م)
            هذا._م = 0
            ارجع ن
        نهاية
        ارجع خطأ
    نهاية

    ##
    # متصلة — هل المقبس متصل حالياً؟
    # الاسم مختلف عن هل_متصلة(م) لتجنب التعارض الداخلي
    ##
    دالة متصلة()
        إذا (هذا._م <= 0)
            ارجع خطأ
        نهاية
        ارجع هل_متصلة(هذا._م)
    نهاية

    ## عنوان_الطرف — عنوان الجهاز المتصل بصيغة "IP:منفذ"
    دالة عنوان_الطرف()
        إذا (هذا._م <= 0)
            ارجع ""
        نهاية
        ارجع عنوان_الطرف_الآخر(هذا._م)
    نهاية

    ## حدد_مهلة_الاستقبال — مهلة انتظار البيانات الواردة
    دالة حدد_مهلة_الاستقبال(مللي)
        ارجع حدد_انتظار_الاستقبال(هذا._م، مللي)
    نهاية

    ## حدد_مهلة_الإرسال — مهلة انتظار إرسال البيانات
    دالة حدد_مهلة_الإرسال(مللي)
        ارجع حدد_انتظار_الإرسال(هذا._م، مللي)
    نهاية

    ## أرسل_فوراً — تفعيل/تعطيل الإرسال الفوري (تعطيل Nagle)
    دالة أرسل_فوراً(تفعيل)
        ارجع أرسل_فورا(هذا._م، تفعيل)
    نهاية

    ##
    # المنفذ — رقم المنفذ المحلي
    # الاسم مختلف عن منفذ_محلي(م) لتجنب التعارض الداخلي
    ##
    دالة المنفذ()
        إذا (هذا._م <= 0)
            ارجع 0
        نهاية
        ارجع منفذ_محلي(هذا._م)
    نهاية

    ## هل_صالح — هل المقبس مفتوح؟
    دالة هل_صالح()
        ارجع هذا._م > 0
    نهاية

نهاية


