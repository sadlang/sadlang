## Test: trace parsing step-by-step - direct محلل only
من مكتبات_خارجية.تعبيرات_منتظمة.src.محلل استورد محلل

# اختبار abc
متغير م1 = جديد محلل("abc"، 0)
متغير ن1 = م1.تحليل()
اطبع("abc → نوع: ")
اطبع_سطر(ن1.النوع)

# اختبار مجموعة
متغير م2 = جديد محلل("(abc)"، 0)
متغير ن2 = م2.تحليل()
اطبع("(abc) → نوع: ")
اطبع_سطر(ن2.النوع)

إذا (ن2.النوع == 6)
    اطبع("مجموعة ✓ | طفل النوع: ")
    اطبع_سطر(ن2.طفل.النوع)
نهاية

إذا (ن2.النوع == 5)
    اطبع("تناوب! عدد الخيارات: ")
    اطبع_سطر(طول(ن2.الخيارات))
    اطبع("الخيار[0] نوع: ")
    اطبع_سطر(ن2.الخيارات[0].النوع)
نهاية

إذا (ن2.النوع == 4)
    اطبع("تسلسل! عدد الأبناء: ")
    اطبع_سطر(طول(ن2.الأبناء))
    اطبع("الابن[0] نوع: ")
    اطبع_سطر(ن2.الأبناء[0].النوع)
