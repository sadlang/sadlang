{
  "name": "sad-lang-debugger",
  "displayName": "ص Language Debugger",
  "displayNameAr": "مصحح لغة ص",
  "version": "1.0.0",
  "description": "Debug Adapter Protocol implementation for Sad Programming Language",
  "publisher": "sad-lang",
  "icon": "images/sad-icon.png",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "keywords": [
    "sad",
    "ص",
    "arabic",
    "debugger",
    "arabic programming"
  ],
  "activationEvents": [
    "onLanguage:sad",
    "onDebug"
  ],
  "contributes": {
    "debuggers": [
      {
        "type": "sad",
        "label": "ص (Sad) Debugger",
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "languages": ["sad"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .ص file to debug",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line",
                "default": true
              },
              "trace": {
                "type": "boolean",
                "description": "Enable debug trace",
                "default": false
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Command line arguments",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables",
                "default": {}
              },
              "interpreterPath": {
                "type": "string",
                "description": "Path to sad.exe interpreter",
                "default": "sad"
              }
            }
          },
          "attach": {
            "required": ["port"],
            "properties": {
              "port": {
                "type": "number",
                "description": "Debug server port",
                "default": 9229
              },
              "host": {
                "type": "string",
                "description": "Debug server host",
                "default": "localhost"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sad",
            "request": "launch",
            "name": "تشغيل وتصحيح ملف ص",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "ص: Launch Program",
            "description": "تشغيل برنامج ص مع التصحيح",
            "body": {
              "type": "sad",
              "request": "launch",
              "name": "تشغيل ${1:البرنامج}",
              "program": "^\"\\${workspaceFolder}/${2:main}.ص\"",
              "stopOnEntry": false
            }
          },
          {
            "label": "ص: Attach to Process",
            "description": "الاتصال بعملية قيد التشغيل",
            "body": {
              "type": "sad",
              "request": "attach",
              "name": "اتصال بالمنفذ ${1:9229}",
              "port": "^${1:9229}",
              "host": "localhost"
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "sad"
      }
    ],
    "commands": [
      {
        "command": "sad.debug.toggleBreakpoint",
        "title": "Toggle Breakpoint",
        "title_ar": "تبديل نقطة التوقف"
      },
      {
        "command": "sad.debug.runToCursor",
        "title": "Run to Cursor",
        "title_ar": "تشغيل حتى المؤشر"
      },
      {
        "command": "sad.debug.evaluateExpression",
        "title": "Evaluate Expression",
        "title_ar": "تقييم تعبير"
      },
      {
        "command": "sad.debug.showVariables",
        "title": "Show All Variables",
        "title_ar": "عرض جميع المتغيرات"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sad.debug.toggleBreakpoint",
          "when": "editorLangId == sad",
          "group": "debug"
        },
        {
          "command": "sad.debug.runToCursor",
          "when": "editorLangId == sad && inDebugMode",
          "group": "debug"
        },
        {
          "command": "sad.debug.evaluateExpression",
          "when": "editorLangId == sad && inDebugMode",
          "group": "debug"
        }
      ]
    },
    "views": {
      "debug": [
        {
          "id": "sadVariables",
          "name": "المتغيرات (ص)",
          "when": "debugType == sad"
        },
        {
          "id": "sadCallStack",
          "name": "مكدس الاستدعاءات",
          "when": "debugType == sad"
        },
        {
          "id": "sadBreakpoints",
          "name": "نقاط التوقف",
          "when": "debugType == sad"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "dependencies": {
    "vscode-debugadapter": "^1.51.0",
    "vscode-debugprotocol": "^1.51.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  }
}
