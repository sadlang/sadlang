{
  "دالة / Function": {
    "prefix": ["دالة", "function"],
    "body": [
      "دالة ${1:اسم_الدالة}(${2:معامل})",
      "    ${3:# كود الدالة}",
      "    إرجاع ${4:قيمة}",
      "نهاية"
    ],
    "description": "تعريف دالة جديدة / Define a new function"
  },
  "إذا / If": {
    "prefix": ["إذا", "if"],
    "body": [
      "إذا ${1:الشرط} أعمل",
      "    ${2:# كود}",
      "نهاية"
    ],
    "description": "شرط إذا / If statement"
  },
  "إذا وإلا / If Else": {
    "prefix": ["إذا_وإلا", "ifelse"],
    "body": [
      "إذا ${1:الشرط} أعمل",
      "    ${2:# كود}",
      "وإلا أعمل",
      "    ${3:# كود بديل}",
      "نهاية"
    ],
    "description": "شرط إذا-وإلا / If-else statement"
  },
  "بينما / While": {
    "prefix": ["بينما", "while"],
    "body": [
      "بينما ${1:الشرط} أعمل",
      "    ${2:# كود}",
      "نهاية"
    ],
    "description": "حلقة بينما / While loop"
  },
  "لـ / For": {
    "prefix": ["لـ", "for"],
    "body": [
      "لـ ${1:متغير} من ${2:0} إلى ${3:10} أعمل",
      "    ${4:# كود}",
      "نهاية"
    ],
    "description": "حلقة لـ / For loop"
  },
  "صنف / Class": {
    "prefix": ["صنف", "class"],
    "body": [
      "صنف ${1:اسم_الصنف}",
      "    # خصائص / Properties",
      "    ${2:خاصية} = ${3:قيمة}",
      "    ",
      "    # منشئ / Constructor",
      "    دالة بناء()",
      "        ${4:# كود التهيئة}",
      "    نهاية",
      "    ",
      "    # دوال / Methods",
      "    دالة ${5:اسم_الدالة}()",
      "        ${6:# كود}",
      "    نهاية",
      "نهاية"
    ],
    "description": "تعريف صنف / Define a class"
  },
  "اطبع / Print": {
    "prefix": ["اطبع", "print"],
    "body": [
      "اطبع(${1:\"نص\"})"
    ],
    "description": "طباعة نص / Print text"
  },
  "أدخل / Input": {
    "prefix": ["أدخل", "input"],
    "body": [
      "${1:متغير} = أدخل(${2:\"أدخل قيمة: \"})"
    ],
    "description": "قراءة إدخال / Read input"
  },
  "مصفوفة / Array": {
    "prefix": ["مصفوفة", "array"],
    "body": [
      "${1:اسم} = [${2:1}, ${3:2}, ${4:3}]"
    ],
    "description": "تعريف مصفوفة / Define an array"
  },
  "قاموس / Dictionary": {
    "prefix": ["قاموس", "dict"],
    "body": [
      "${1:اسم} = {",
      "    ${2:\"مفتاح\"}: ${3:قيمة},",
      "    ${4:\"مفتاح2\"}: ${5:قيمة2}",
      "}"
    ],
    "description": "تعريف قاموس / Define a dictionary"
  },
  "محاولة / Try": {
    "prefix": ["محاولة", "try"],
    "body": [
      "محاولة",
      "    ${1:# كود قد يسبب خطأ}",
      "التقط ${2:خطأ}",
      "    ${3:# معالجة الخطأ}",
      "نهاية"
    ],
    "description": "محاولة التقاط الأخطاء / Try-catch errors"
  },
  "برنامج كامل / Complete Program": {
    "prefix": ["برنامج", "program"],
    "body": [
      "# بسم الله الرحمن الرحيم",
      "# ${1:اسم البرنامج}",
      "# ${2:وصف}",
      "",
      "دالة main()",
      "    ${3:# كود البرنامج الرئيسي}",
      "    اطبع(\"مرحباً بك في لغة ص!\")",
      "نهاية",
      "",
      "# تشغيل البرنامج",
      "main()"
    ],
    "description": "قالب برنامج كامل / Complete program template"
  }
}
