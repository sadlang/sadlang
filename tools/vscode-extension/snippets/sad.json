{
  "دالة / Function": {
    "prefix": ["دالة", "func", "fn"],
    "body": [
      "دالة ${1:اسم_الدالة}(${2:المعلمات})",
      "\t${3:# جسم الدالة}",
      "\tارجع ${4:لاشيء}",
      "نهاية"
    ],
    "description": "تعريف دالة جديدة"
  },
  "دالة بدون إرجاع / Void Function": {
    "prefix": ["دالة_فراغ", "vfunc"],
    "body": [
      "دالة ${1:اسم_الدالة}(${2:المعلمات})",
      "\t${0}",
      "نهاية"
    ],
    "description": "تعريف دالة بدون إرجاع"
  },
  "إذا / If": {
    "prefix": ["إذا", "اذا", "if"],
    "body": [
      "إذا (${1:الشرط})",
      "\t${0}",
      "نهاية"
    ],
    "description": "كتلة شرطية"
  },
  "إذا وإلا / If Else": {
    "prefix": ["إذا_وإلا", "ifelse"],
    "body": [
      "إذا (${1:الشرط})",
      "\t${2}",
      "وإلا",
      "\t${0}",
      "نهاية"
    ],
    "description": "كتلة شرطية مع بديل"
  },
  "بينما / While": {
    "prefix": ["بينما", "while"],
    "body": [
      "بينما (${1:الشرط})",
      "\t${0}",
      "نهاية"
    ],
    "description": "حلقة تكرارية"
  },
  "لكل / For Each": {
    "prefix": ["لكل", "foreach", "for"],
    "body": [
      "لكل ${1:عنصر} في ${2:المجموعة}",
      "\t${0}",
      "نهاية"
    ],
    "description": "حلقة لكل عنصر في مجموعة"
  },
  "صنف / Class": {
    "prefix": ["صنف", "class"],
    "body": [
      "صنف ${1:اسم_الصنف}",
      "\tباني(${2:المعلمات})",
      "\t\t${3:# تهيئة}",
      "\tnهاية",
      "",
      "\tدالة ${4:اسم_الطريقة}(${5})",
      "\t\t${0}",
      "\tنهاية",
      "نهاية"
    ],
    "description": "تعريف صنف جديد"
  },
  "صنف يرث / Class Inherits": {
    "prefix": ["صنف_يرث", "classi"],
    "body": [
      "صنف ${1:الصنف_الابن} يرث ${2:الصنف_الأب}",
      "\tباني(${3:المعلمات})",
      "\t\tالأساس(${4})",
      "\t\t${0}",
      "\تنهاية",
      "نهاية"
    ],
    "description": "تعريف صنف يرث من صنف آخر"
  },
  "بنية / Struct": {
    "prefix": ["بنية", "struct"],
    "body": [
      "بنية ${1:اسم_البنية}",
      "\t${2:الحقل_الأول}",
      "\t${0}",
      "نهاية"
    ],
    "description": "تعريف بنية بيانات"
  },
  "تعداد / Enum": {
    "prefix": ["تعداد", "enum"],
    "body": [
      "تعداد ${1:اسم_التعداد}",
      "\t${2:القيمة_الأولى}",
      "\t${3:القيمة_الثانية}",
      "\t${0}",
      "نهاية"
    ],
    "description": "تعريف تعداد"
  },
  "طابق / Match": {
    "prefix": ["طابق", "match"],
    "body": [
      "طابق (${1:القيمة})",
      "\tعندما ${2:النمط_الأول}",
      "\t\t${3}",
      "\tعندما ${4:النمط_الثاني}",
      "\t\t${5}",
      "\tافتراضي",
      "\t\t${0}",
      "نهاية"
    ],
    "description": "مطابقة الأنماط"
  },
  "حاول / Try Catch": {
    "prefix": ["حاول", "try"],
    "body": [
      "حاول",
      "\t${1}",
      "امسك (${2:خطأ})",
      "\t${3:اطبع_سطر(خطأ)}",
      "نهاية"
    ],
    "description": "معالجة الأخطاء"
  },
  "حاول كامل / Try Catch Finally": {
    "prefix": ["حاول_كامل", "trycf"],
    "body": [
      "حاول",
      "\t${1}",
      "امسك (${2:خطأ})",
      "\t${3:اطبع_سطر(خطأ)}",
      "أخيراً",
      "\t${0}",
      "نهاية"
    ],
    "description": "معالجة أخطاء كاملة مع أخيراً"
  },
  "استورد / Import": {
    "prefix": ["استورد", "import"],
    "body": [
      "استورد ${1:الوحدة} من \"${2:المسار}\""
    ],
    "description": "استيراد وحدة"
  },
  "استورد كـ / Import As": {
    "prefix": ["استورد_كـ", "importas"],
    "body": [
      "استورد ${1:الوحدة} كـ ${2:الاسم_البديل} من \"${3:المسار}\""
    ],
    "description": "استيراد وحدة باسم بديل"
  },
  "متغير / Variable": {
    "prefix": ["متغير", "var"],
    "body": [
      "متغير ${1:الاسم} = ${0:القيمة}"
    ],
    "description": "تعريف متغير"
  },
  "ثابت / Constant": {
    "prefix": ["ثابت", "const"],
    "body": [
      "ثابت ${1:الاسم} = ${0:القيمة}"
    ],
    "description": "تعريف ثابت"
  },
  "اطبع / Print": {
    "prefix": ["اطبع", "print"],
    "body": [
      "اطبع(${0:\"النص\"})"
    ],
    "description": "طباعة بدون سطر جديد"
  },
  "اطبع_سطر / Println": {
    "prefix": ["اطبع_سطر", "println"],
    "body": [
      "اطبع_سطر(${0:\"النص\"})"
    ],
    "description": "طباعة مع سطر جديد"
  },
  "سمة / Trait": {
    "prefix": ["سمة", "trait"],
    "body": [
      "سمة ${1:اسم_السمة}",
      "\tدالة ${2:اسم_الطريقة}(${3})",
      "\t\t${0}",
      "\تنهاية",
      "نهاية"
    ],
    "description": "تعريف سمة (واجهة)"
  },
  "نفّذ / Implement": {
    "prefix": ["نفذ", "نفّذ", "impl"],
    "body": [
      "نفّذ ${1:اسم_السمة} لـ ${2:اسم_الصنف}",
      "\tدالة ${3:اسم_الطريقة}(${4})",
      "\t\t${0}",
      "\تنهاية",
      "نهاية"
    ],
    "description": "تنفيذ سمة لصنف"
  },
  "لامدا / Lambda": {
    "prefix": ["لامدا", "lambda"],
    "body": [
      "لامدا (${1:المعلمات}) ${0:التعبير}"
    ],
    "description": "دالة مجهولة (لامدا)"
  },
  "غير_متزامن / Async Function": {
    "prefix": ["غير_متزامن", "async"],
    "body": [
      "غير_متزامن دالة ${1:اسم_الدالة}(${2:المعلمات})",
      "\t${0}",
      "نهاية"
    ],
    "description": "دالة غير متزامنة"
  },
  "فضاء / Namespace": {
    "prefix": ["فضاء", "namespace"],
    "body": [
      "فضاء ${1:اسم_الفضاء}",
      "\t${0}",
      "نهاية_فضاء"
    ],
    "description": "فضاء أسماء"
  },
  "خاصية / Property": {
    "prefix": ["خاصية", "prop"],
    "body": [
      "خاصية ${1:الاسم}",
      "\تاحصل",
      "\t\تارجع هذا.${2:_الحقل}",
      "\تنهاية",
      "\تعيّن (${3:قيمة})",
      "\t\تهذا.${2:_الحقل} = ${3:قيمة}",
      "\تنهاية",
      "نهاية"
    ],
    "description": "خاصية مع getter و setter"
  },
  "اختبر / Test": {
    "prefix": ["اختبر", "test"],
    "body": [
      "اختبر \"${1:وصف الاختبار}\"",
      "\t${0}",
      "نهاية"
    ],
    "description": "كتلة اختبار"
  },
  "ارمي / Throw": {
    "prefix": ["ارمي", "throw"],
    "body": [
      "ارمي ${0:\"رسالة الخطأ\"}"
    ],
    "description": "رمي خطأ"
  },
  "باستخدام / Using": {
    "prefix": ["باستخدام", "using"],
    "body": [
      "باستخدام ${1:المورد}",
      "\t${0}",
      "نهاية_استخدام"
    ],
    "description": "إدارة الموارد التلقائية"
  },
  "تعليق كتلة / Block Comment": {
    "prefix": ["تعليق", "comment"],
    "body": [
      "#*",
      " * ${0:التعليق}",
      " *#"
    ],
    "description": "تعليق متعدد الأسطر"
  },
  "توثيق / Documentation": {
    "prefix": ["توثيق", "doc"],
    "body": [
      "#**",
      " * ${1:وصف الدالة}",
      " * @معلمة ${2:اسم} — ${3:الوصف}",
      " * @إرجاع ${0:وصف القيمة المرجعة}",
      " **#"
    ],
    "description": "تعليق توثيقي"
  },
  "رئيسية / Main": {
    "prefix": ["رئيسية", "main"],
    "body": [
      "رئيسية",
      "\t${0}",
      "نهاية"
    ],
    "description": "نقطة الدخول الرئيسية"
  }
}
