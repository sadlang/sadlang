{
  "comments": {
    "lineComment": "#",
    "blockComment": ["#*", "*#"]
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "«", "close": "»" },
    { "open": "#*", "close": "*#", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"],
    ["«", "»"]
  ],
  "colorizedBracketPairs": [
    ["[", "]"],
    ["(", ")"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(دالة|صنف|بنية|تعداد|إذا|اذا|بينما|لكل|حاول|طابق|سمة|واجهة|نفّذ|نفذ|فضاء)\\b",
      "end": "^\\s*نهاية\\b"
    }
  },
  "wordPattern": "([\\u0600-\\u06FF\\u0750-\\u077F\\w_][\\u0600-\\u06FF\\u0750-\\u077F\\w\\d_]*)|(-?\\d*\\.\\d\\w*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(دالة|صنف|بنية|تعداد|إذا|اذا|وإلا|والا|بينما|لكل|حاول|امسك|أخيراً|اخيرا|طابق|عندما|افتراضي|سمة|واجهة|نفّذ|نفذ|فضاء|باستخدام)\\b.*$",
    "decreaseIndentPattern": "^\\s*(نهاية|وإلا|والا|امسك|أخيراً|اخيرا|نهاية_استخدام|نهاية_فضاء)\\b.*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(دالة|صنف|بنية|تعداد|إذا|اذا|بينما|لكل|حاول|طابق|سمة|واجهة|نفّذ|نفذ|فضاء|باستخدام)\\b.*$",
      "afterText": "^\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*(وإلا|والا|امسك|أخيراً|اخيرا|عندما|افتراضي)\\b.*$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
