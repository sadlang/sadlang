# ─── دوال الترتيب ───

## دالة فرز الفقاعات
## تأخذ مصفوفة وتعيدها مرتبة تصاعدياً
دالة فرز_فقاعات(مصفوفة)
   متغير ن = طول(مصفوفة)
   متغير ي = 0
   بينما (ي < ن - 1)
      متغير ج = 0
      بينما (ج < ن - ي - 1)
         إذا (مصفوفة[ج] > مصفوفة[ج + 1])
            # تبديل
            متغير مؤقت = مصفوفة[ج]
            مصفوفة[ج] = مصفوفة[ج + 1]
            مصفوفة[ج + 1] = مؤقت
         نهاية
         ج = ج + 1
      نهاية
      ي = ي + 1
   نهاية
   ارجع مصفوفة
نهاية

# ─── بحث ثنائي ───
دالة بحث_ثنائي(مصفوفة، هدف)
   متغير يسار = 0
   متغير يمين = طول(مصفوفة) - 1

   بينما (يسار <= يمين)
      متغير وسط = (يسار + يمين) / 2
      إذا (مصفوفة[وسط] == هدف)
         ارجع وسط
      وإلا
         إذا (مصفوفة[وسط] < هدف)
            يسار = وسط + 1
         وإلا
            يمين = وسط - 1
         نهاية
      نهاية
   نهاية
   ارجع -1
نهاية

# ─── متتالية فيبوناتشي ───
دالة فيبوناتشي(ن)
   إذا (ن <= 0)
      ارجع 0
   نهاية
   إذا (ن == 1)
      ارجع 1
   نهاية
   ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

