# مثال شامل: أساسيات لغة ص
# يشمل: متغيرات، دوال، أصناف، حلقات، شروط

# ─── المتغيرات والثوابت ───
متغير اسم = "أحمد"
متغير عمر = 25
ثابت PI = 3.14159

اطبع_سطر("مرحباً يا " + اسم)
اطبع_سطر("عمرك: " + عمر)

# ─── الدوال ───
دالة جمع(أ، ب)
   ارجع أ + ب
نهاية

دالة مضروب(ن)
   إذا (ن <= 1)
      ارجع 1
   نهاية
   ارجع ن * مضروب(ن - 1)
نهاية

اطبع_سطر("3 + 5 = " + جمع(3، 5))
اطبع_سطر("5! = " + مضروب(5))

# ─── الشروط ───
متغير درجة = 85

إذا (درجة >= 90)
   اطبع_سطر("ممتاز")
وإلا
   إذا (درجة >= 80)
      اطبع_سطر("جيد جداً")
   وإلا
      إذا (درجة >= 70)
         اطبع_سطر("جيد")
      وإلا
         اطبع_سطر("مقبول")
      نهاية
   نهاية
نهاية

# ─── الحلقات ───
اطبع_سطر("--- لكل ---")
لكل رقم في [1، 2، 3، 4، 5]
   اطبع(رقم + " ")
نهاية
اطبع_سطر("")

اطبع_سطر("--- بينما ---")
متغير عداد = 0
بينما (عداد < 5)
   اطبع(عداد + " ")
   عداد = عداد + 1
نهاية
اطبع_سطر("")

# ─── الأصناف ───
صنف شخص
   باني(الاسم، العمر)
      هذا.الاسم = الاسم
      هذا.العمر = العمر
   نهاية

   دالة تحية()
      ارجع "مرحباً، أنا " + هذا.الاسم + " وعمري " + هذا.العمر
   نهاية
نهاية

صنف طالب يرث شخص
   باني(الاسم، العمر، الجامعة)
      الأساس(الاسم، العمر)
      هذا.الجامعة = الجامعة
   نهاية

   دالة تحية()
      ارجع الأساس.تحية() + " وأدرس في " + هذا.الجامعة
   نهاية
نهاية

متغير ط = جديد طالب("سارة"، 20، "جامعة القاهرة")
اطبع_سطر(ط.تحية())

# ─── المطابقة ───
متغير يوم = 3
طابق (يوم)
   عندما 1
      اطبع_سطر("الأحد")
   عندما 2
      اطبع_سطر("الاثنين")
   عندما 3
      اطبع_سطر("الثلاثاء")
   افتراضي
      اطبع_سطر("يوم آخر")
نهاية

# ─── معالجة الأخطاء ───
حاول
   متغير نتيجة = 10 / 0
   اطبع_سطر(نتيجة)
امسك (خطأ)
   اطبع_سطر("خطأ: " + خطأ)
أخيراً
   اطبع_سطر("انتهى البرنامج")
نهاية
