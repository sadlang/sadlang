# مثال: البرمجة الكائنية المتقدمة في لغة ص

# ─── صنف مجرد: شكل هندسي ───
صنف شكل
   باني(اللون)
      هذا.اللون = اللون
   نهاية

   دالة المساحة()
      ارجع 0
   نهاية

   دالة المحيط()
      ارجع 0
   نهاية

   دالة وصف()
      ارجع "شكل بلون " + هذا.اللون + " — المساحة: " + هذا.المساحة()
   نهاية
نهاية

# ─── دائرة ───
صنف دائرة يرث شكل
   باني(اللون، نصف_القطر)
      الأساس(اللون)
      هذا.نصف_القطر = نصف_القطر
   نهاية

   دالة المساحة()
      ارجع 3.14159 * هذا.نصف_القطر ** 2
   نهاية

   دالة المحيط()
      ارجع 2 * 3.14159 * هذا.نصف_القطر
   نهاية
نهاية

# ─── مستطيل ───
صنف مستطيل يرث شكل
   باني(اللون، العرض، الارتفاع)
      الأساس(اللون)
      هذا.العرض = العرض
      هذا.الارتفاع = الارتفاع
   نهاية

   دالة المساحة()
      ارجع هذا.العرض * هذا.الارتفاع
   نهاية

   دالة المحيط()
      ارجع 2 * (هذا.العرض + هذا.الارتفاع)
   نهاية
نهاية

# ─── مربع (يرث من مستطيل) ───
صنف مربع يرث مستطيل
   باني(اللون، الضلع)
      الأساس(اللون، الضلع، الضلع)
      هذا.الضلع = الضلع
   نهاية
نهاية

# ─── الاستخدام ───
متغير أشكال = [
   جديد دائرة("أحمر"، 5)،
   جديد مستطيل("أزرق"، 10، 5)،
   جديد مربع("أخضر"، 7)
]

لكل شكل في أشكال
   اطبع_سطر(شكل.وصف())
   اطبع_سطر("  المحيط: " + شكل.المحيط())
   اطبع_سطر("---")
نهاية

# ─── مصفوفة + خريطة ───
متغير طلاب = [
   {"اسم": "أحمد"، "درجة": 95}،
   {"اسم": "سارة"، "درجة": 88}،
   {"اسم": "خالد"، "درجة": 72}
]

دالة أفضل_طالب(قائمة)
   متغير أفضل = قائمة[0]
   لكل طالب في قائمة
      إذا (طالب["درجة"] > أفضل["درجة"])
         أفضل = طالب
      نهاية
   نهاية
   ارجع أفضل
نهاية

متغير الأفضل = أفضل_طالب(طلاب)
اطبع_سطر("أفضل طالب: " + الأفضل["اسم"] + " بدرجة " + الأفضل["درجة"])
