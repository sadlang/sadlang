{
  "name": "Sad Language Light — سمة لغة ص الفاتحة",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#fafafa",
    "editor.foreground": "#212121",
    "editor.lineHighlightBackground": "#f0f0f5",
    "editor.selectionBackground": "#bbdefb",
    "editor.inactiveSelectionBackground": "#e3f2fd",
    "editor.selectionHighlightBackground": "#bbdefb55",
    "editor.wordHighlightBackground": "#bbdefb44",
    "editor.findMatchBackground": "#ffecb3",
    "editor.findMatchHighlightBackground": "#ffe08255",
    "editorCursor.foreground": "#1565c0",
    "editorLineNumber.foreground": "#b0bec5",
    "editorLineNumber.activeForeground": "#1565c0",
    "editorIndentGuide.background1": "#e0e0e0",
    "editorIndentGuide.activeBackground1": "#1565c0",
    "editorBracketMatch.background": "#bbdefb55",
    "editorBracketMatch.border": "#1565c0",

    "activityBar.background": "#e3f2fd",
    "activityBar.foreground": "#1565c0",
    "activityBar.activeBorder": "#1565c0",
    "activityBarBadge.background": "#1565c0",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.background": "#f5f5f5",
    "sideBar.foreground": "#424242",
    "sideBarTitle.foreground": "#1565c0",
    "sideBarSectionHeader.background": "#e8eaf6",
    "sideBarSectionHeader.foreground": "#1565c0",

    "titleBar.activeBackground": "#e3f2fd",
    "titleBar.activeForeground": "#212121",

    "statusBar.background": "#1565c0",
    "statusBar.foreground": "#ffffff",
    "statusBar.debuggingBackground": "#c62828",
    "statusBar.noFolderBackground": "#757575",

    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#212121",
    "tab.activeBorderTop": "#1565c0",
    "tab.inactiveBackground": "#f5f5f5",
    "tab.inactiveForeground": "#757575",
    "tab.border": "#e0e0e0",

    "terminal.background": "#fafafa",
    "terminal.foreground": "#212121",
    "terminal.ansiBlue": "#1565c0",
    "terminal.ansiGreen": "#2e7d32",
    "terminal.ansiRed": "#c62828",
    "terminal.ansiYellow": "#f57f17",
    "terminal.ansiCyan": "#00838f",
    "terminal.ansiMagenta": "#7b1fa2",

    "input.background": "#ffffff",
    "input.border": "#bdbdbd",
    "input.foreground": "#212121",
    "focusBorder": "#1565c0",

    "button.background": "#1565c0",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1976d2",

    "list.activeSelectionBackground": "#1565c0",
    "list.activeSelectionForeground": "#ffffff",
    "list.hoverBackground": "#e3f2fd",

    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#e0e0e0",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.selectedBackground": "#e3f2fd",
    "editorSuggestWidget.highlightForeground": "#1565c0",

    "editorError.foreground": "#c62828",
    "editorWarning.foreground": "#f57f17",
    "editorInfo.foreground": "#1565c0",

    "editorGutter.addedBackground": "#2e7d32",
    "editorGutter.modifiedBackground": "#1565c0",
    "editorGutter.deletedBackground": "#c62828"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "comment.line", "comment.block", "punctuation.definition.comment"],
      "settings": { "foreground": "#9e9e9e", "fontStyle": "italic" }
    },
    {
      "name": "Documentation Comment",
      "scope": ["comment.block.documentation", "comment.line.documentation"],
      "settings": { "foreground": "#5c6bc0", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted.double", "string.quoted.single"],
      "settings": { "foreground": "#2e7d32" }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#e65100", "fontStyle": "bold" }
    },
    {
      "name": "String Interpolation",
      "scope": ["meta.interpolation", "punctuation.section.interpolation"],
      "settings": { "foreground": "#1565c0" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"],
      "settings": { "foreground": "#ad1457" }
    },
    {
      "name": "Language Constant — صحيح/خطأ/لاشيء",
      "scope": ["constant.language"],
      "settings": { "foreground": "#d84315", "fontStyle": "bold" }
    },
    {
      "name": "Control Keywords — إذا/بينما/لكل/ارجع/نهاية",
      "scope": ["keyword.control", "keyword.control.sad"],
      "settings": { "foreground": "#7b1fa2", "fontStyle": "bold" }
    },
    {
      "name": "Match Keywords — طابق/عندما",
      "scope": ["keyword.control.match"],
      "settings": { "foreground": "#6a1b9a", "fontStyle": "bold" }
    },
    {
      "name": "Exception Keywords — حاول/امسك",
      "scope": ["keyword.control.exception"],
      "settings": { "foreground": "#c62828", "fontStyle": "bold" }
    },
    {
      "name": "Declaration — دالة/صنف/بنية/تعداد",
      "scope": ["keyword.declaration", "keyword.declaration.sad"],
      "settings": { "foreground": "#1565c0", "fontStyle": "bold" }
    },
    {
      "name": "OOP Keywords — يرث/جديد/هذا/باني/الأساس",
      "scope": ["keyword.other.oop", "keyword.other.oop.sad"],
      "settings": { "foreground": "#00838f", "fontStyle": "bold" }
    },
    {
      "name": "Import Keywords — استورد/من/صدّر/كـ",
      "scope": ["keyword.control.import", "keyword.control.import.sad"],
      "settings": { "foreground": "#2e7d32" }
    },
    {
      "name": "Access Modifiers — عام/خاص/محمي/مجرد",
      "scope": ["keyword.other.access", "keyword.other.access.sad"],
      "settings": { "foreground": "#e65100" }
    },
    {
      "name": "Variable Keywords — متغير/ثابت/ساكن/خارجي",
      "scope": ["keyword.other.variable", "keyword.other.variable.sad"],
      "settings": { "foreground": "#1565c0" }
    },
    {
      "name": "Async Keywords — غير_متزامن/انتظر",
      "scope": ["keyword.other.async", "keyword.other.async.sad"],
      "settings": { "foreground": "#7b1fa2" }
    },
    {
      "name": "Lambda",
      "scope": ["keyword.other.lambda"],
      "settings": { "foreground": "#9c27b0" }
    },
    {
      "name": "Trait/Interface",
      "scope": ["keyword.other.trait"],
      "settings": { "foreground": "#00695c", "fontStyle": "italic" }
    },
    {
      "name": "Built-in Types — رقم/نص/عشري/منطقي",
      "scope": ["support.type", "support.type.sad"],
      "settings": { "foreground": "#00838f", "fontStyle": "italic" }
    },
    {
      "name": "Function Name",
      "scope": ["entity.name.function", "entity.name.function.sad"],
      "settings": { "foreground": "#1565c0" }
    },
    {
      "name": "Built-in Functions — اطبع...",
      "scope": ["support.function.builtin", "support.function.builtin.sad"],
      "settings": { "foreground": "#0d47a1", "fontStyle": "bold" }
    },
    {
      "name": "Logical Operators Arabic — و/أو/ليس",
      "scope": ["keyword.operator.logical.arabic"],
      "settings": { "foreground": "#7b1fa2", "fontStyle": "bold" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.arithmetic", "keyword.operator.comparison", "keyword.operator.assignment"],
      "settings": { "foreground": "#546e7a" }
    },
    {
      "name": "Arrow Operator",
      "scope": ["keyword.operator.arrow"],
      "settings": { "foreground": "#1565c0", "fontStyle": "bold" }
    },
    {
      "name": "Variable Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#795548", "fontStyle": "italic" }
    },
    {
      "name": "Class Name",
      "scope": ["entity.name.class", "entity.name.type.class"],
      "settings": { "foreground": "#00838f", "fontStyle": "bold" }
    },
    {
      "name": "Inherited Class",
      "scope": ["entity.other.inherited-class"],
      "settings": { "foreground": "#00695c", "fontStyle": "italic underline" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c62828", "fontStyle": "strikethrough" }
    }
  ]
}
