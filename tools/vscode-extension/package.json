{
  "name": "sad-language",
  "displayName": "Sad Language Support (لغة ص)",
  "description": "دعم كامل للغة ص - Full Language Support for Sad Programming Language",
  "version": "2.0.0",
  "publisher": "sad-language",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sad-lang/sad-language"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "sad",
    "arabic",
    "عربي",
    "لغة ص"
  ],
  "activationEvents": [
    "onLanguage:sad",
    "onView:sadFeatures",
    "onView:sadQuickActions"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sad",
        "aliases": [
          "Sad",
          "لغة ص",
          "ص"
        ],
        "extensions": [
          ".ص"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.png",
          "dark": "./images/file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "sad",
        "scopeName": "source.sad",
        "path": "./syntaxes/sad.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "سمة لغة ص الداكنة — Sad Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/sad-dark-theme.json"
      },
      {
        "label": "سمة لغة ص الفاتحة — Sad Light",
        "uiTheme": "vs",
        "path": "./themes/sad-light-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "sad",
        "path": "./snippets/sad.json"
      }
    ],
    "debuggers": [
      {
        "type": "sad",
        "languages": [
          "sad"
        ],
        "label": "مصحح لغة ص — Sad Debugger",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "مسار ملف .ص المراد تصحيحه / Path to the .ص file to debug",
                "default": "${file}"
              },
              "interpreter": {
                "type": "string",
                "description": "مسار المفسر (sad.exe) / Path to interpreter (sad.exe)",
                "default": ""
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "التوقف عند نقطة الدخول / Stop at entry point",
                "default": true
              },
              "cwd": {
                "type": "string",
                "description": "مجلد العمل / Working directory",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "متغيرات البيئة / Environment variables",
                "default": {}
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sad",
            "request": "launch",
            "name": "تصحيح ملف ص / Debug Sad File",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "ص: تصحيح ملف / Sad: Debug File",
            "description": "تشغيل وتصحيح ملف لغة ص / Launch and debug a Sad file",
            "body": {
              "type": "sad",
              "request": "launch",
              "name": "تصحيح ${2:ملف ص}",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "sad"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sad-explorer",
          "title": "لغة ص — Sad Language",
          "icon": "images/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "sad-explorer": [
        {
          "id": "sadQuickActions",
          "name": "⚡ إجراءات سريعة"
        },
        {
          "id": "sadFeatures",
          "name": "📋 جميع الميزات"
        }
      ]
    },
    "configuration": {
      "title": "Sad Language",
      "properties": {
        "sad.server.path": {
          "type": "string",
          "default": "",
          "description": "مسار خادم اللغة / Path to the language server executable"
        },
        "sad.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "تفعيل خادم اللغة / Enable language server"
        },
        "sad.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "تتبع اتصالات الخادم / Trace server communications"
        },
        "sad.formatting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "تفعيل التنسيق التلقائي / Enable automatic formatting"
        },
        "sad.formatting.tabSize": {
          "type": "number",
          "default": 4,
          "description": "حجم التاب / Tab size"
        },
        "sad.formatting.insertSpaces": {
          "type": "boolean",
          "default": true,
          "description": "استخدام المسافات بدلاً من التاب / Use spaces instead of tabs"
        },
        "sad.interpreter.path": {
          "type": "string",
          "default": "",
          "description": "مسار مفسر لغة ص / Path to the sad interpreter executable (sad.exe)"
        },
        "sad.compiler.path": {
          "type": "string",
          "default": "",
          "description": "مسار مترجم لغة ص / Path to the sad compiler executable (sadc.exe)"
        },
        "sad.execution.mode": {
          "type": "string",
          "enum": [
            "ask",
            "interpreter",
            "compiler"
          ],
          "enumDescriptions": [
            "اسأل كل مرة عند التشغيل / Ask every time when running",
            "استخدم المفسر دائماً (sad.exe) / Always use interpreter",
            "استخدم المترجم دائماً (sadc.exe) / Always use compiler"
          ],
          "default": "ask",
          "description": "وضع التنفيذ الافتراضي / Default execution mode"
        },
        "sad.rtl.enabled": {
          "type": "boolean",
          "default": true,
          "description": "تفعيل اتجاه النص من اليمين لليسار تلقائياً / Enable RTL text direction automatically for .ص files"
        }
      }
    },
    "commands": [
      {
        "command": "sad.restartServer",
        "title": "إعادة تشغيل خادم اللغة / Restart Language Server",
        "category": "Sad"
      },
      {
