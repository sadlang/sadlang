    "menus": {
      "editor/title/run": [
        {
          "command": "sad.runFile",
          "when": "resourceLangId == sad",
          "group": "navigation@1"
        },
        {
          "command": "sad.runWithInterpreter",
          "when": "resourceLangId == sad",
          "group": "1_run@1"
        },
        {
          "command": "sad.runWithCompiler",
          "when": "resourceLangId == sad",
          "group": "1_run@2"
        }
      ],
      "view/title": [
        {
          "command": "sad.refreshSidebar",
          "when": "view == sadFeatures",
          "group": "navigation"
        },
        {
          "command": "sad.commandCenter",
          "when": "view == sadQuickActions",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "[sad]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.nonBasicASCII": false,
        "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.autoClosingBrackets": "always",
        "editor.suggest.showKeywords": true,
        "editor.unicodeBidi": "plaintext",
        "editor.renderControlCharacters": true,
        "editor.wordWrap": "on"
      }
    },
    "keybindings": [
      {
        "command": "sad.runFile",
        "key": "f5",
        "when": "resourceLangId == sad && !inDebugMode"
      },
      {
        "command": "sad.restartServer",
        "key": "ctrl+shift+r",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.generateDoc",
        "key": "ctrl+shift+d",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.showAST",
        "key": "ctrl+shift+a",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.translateAuto",
        "key": "ctrl+shift+t",
        "when": "resourceLangId == sad || resourceLangId == python"
      },
      {
        "command": "sad.previewGraphics",
        "key": "ctrl+shift+g",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.openTutorial",
        "key": "ctrl+shift+l",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.toggleRTL",
        "key": "ctrl+shift+;",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.toggleBookmark",
        "key": "ctrl+f2",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.nextBookmark",
        "key": "f2",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.smartRename",
        "key": "f6",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.runSelection",
        "key": "ctrl+shift+enter",
        "when": "resourceLangId == sad"
      },
      {
        "command": "sad.organizeImports",
