# بسم الله الرحمن الرحيم
# ======================================================================
# Dockerfile — سجل حزم لغة ص (Sad Language Package Registry)
# ======================================================================
#
# هذا الملف يبني صورة Docker للخادم باستخدام بناء متعدد المراحل
# (multi-stage build) لتقليل حجم الصورة النهائية.
#
# المراحل:
#   1. builder  — تثبيت التبعيات وبناء better-sqlite3 الأصلي
#   2. runtime  — صورة خفيفة للتشغيل فقط (بدون أدوات البناء)
#
# الاستخدام:
#   docker build -t sad-registry .
#   docker run -p 3000:3000 -v sad-data:/app/data sad-registry
#
# أو مع docker-compose:
#   docker compose up -d
# ======================================================================


# ======================================================================
# المرحلة 1: البناء (Builder Stage)
# ======================================================================
# نستخدم صورة Alpine الخفيفة مع Node.js 20.
# نثبّت أدوات البناء الأصلية (python3, make, g++) لأن مكتبة
# better-sqlite3 تحتاج لتجميع C++ أثناء التثبيت.
# ======================================================================
FROM node:20-alpine AS builder

# تثبيت أدوات بناء C++ — مطلوبة لـ better-sqlite3 (binding أصلي)
# python3: مطلوب لـ node-gyp (نظام بناء الإضافات الأصلية)
# make + g++: مترجم C++ ونظام البناء
RUN apk add --no-cache python3 make g++

WORKDIR /app

# ---------------------------------------------------------------
# نسخ ملفات الحزم أولاً (قبل الكود المصدري)
# هذا يستفيد من طبقات Docker المخزنة مؤقتاً:
# إذا لم يتغير package.json، لن يُعاد تثبيت التبعيات
# ---------------------------------------------------------------
COPY package.json package-lock.json* ./

# تثبيت التبعيات الإنتاجية فقط (بدون devDependencies)
# --omit=dev: لا نحتاج jest, nodemon, eslint في الإنتاج
RUN npm ci --omit=dev

# ======================================================================
# المرحلة 2: التشغيل (Runtime Stage)
# ======================================================================
# صورة خفيفة بدون أدوات البناء (python3, make, g++).
# هذا يقلل حجم الصورة بشكل كبير (~200MB أقل).
# ======================================================================
FROM node:20-alpine AS runtime

# ---------------------------------------------------------------
# إضافة حزم وقت التشغيل الضرورية
# curl: مطلوب لفحص الصحة (healthcheck)
# tini: معالج init خفيف — يعالج إشارات SIGTERM/SIGINT بشكل صحيح
#       (بدونه، Node.js لا يستجيب لـ docker stop بشكل نظيف)
# ---------------------------------------------------------------
RUN apk add --no-cache curl tini

WORKDIR /app

# نسخ node_modules المبنية من مرحلة البناء (بدون أدوات البناء)
COPY --from=builder /app/node_modules ./node_modules

# نسخ الكود المصدري والقوالب والملفات الثابتة
COPY package.json ./
COPY src/ ./src/
COPY views/ ./views/
COPY public/ ./public/
COPY scripts/ ./scripts/
COPY migrations/ ./migrations/

# ---------------------------------------------------------------
# إنشاء المجلدات الضرورية
# data/: قاعدة بيانات SQLite
# storage/packages/: أرشيفات الحزم المنشورة
# logs/: سجلات الخادم
# ---------------------------------------------------------------
RUN mkdir -p data storage/packages logs

# ---------------------------------------------------------------
# إنشاء مستخدم غير جذري للأمان
# لا نشغّل الخادم كـ root — هذا أمان أساسي في Docker
# ---------------------------------------------------------------
RUN addgroup -g 1001 -S saduser && \
    adduser -S saduser -u 1001 -G saduser && \
    chown -R saduser:saduser /app

USER saduser

# ---------------------------------------------------------------
# متغيرات البيئة الافتراضية
# يمكن تجاوزها عبر docker run -e أو docker-compose.yml
# ---------------------------------------------------------------
ENV NODE_ENV=production \
    PORT=3000 \
    DB_PATH=./data/registry.db \
    STORAGE_PATH=./storage/packages

# ---------------------------------------------------------------
# فحص الصحة — Docker يستخدمه لمعرفة هل الخادم يعمل
# يرسل طلب GET لنقطة API الجذرية كل 30 ثانية
# إذا فشل 3 مرات متتالية → الحاوية "unhealthy"
# ---------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/api/v1 || exit 1

# الكشف عن المنفذ (للتوثيق — لا يفتح المنفذ فعلياً)
EXPOSE 3000

# ---------------------------------------------------------------
# استخدام tini كنقطة دخول (init process)
# tini يتعامل مع:
#   - إعادة توجيه SIGTERM إلى Node.js (إغلاق نظيف)
#   - منع عمليات zombie
#   - الخروج بكود صحيح
# ---------------------------------------------------------------
ENTRYPOINT ["/sbin/tini", "--"]

# تشغيل الخادم
CMD ["node", "src/server.js"]
