# ======================================================================
# بسم الله الرحمن الرحيم
# ======================================================================
# إعدادات البيئة لخادم مستودع حزم لغة ص
# Environment Configuration for Sad Language Package Registry
# ======================================================================
#
# هذا الملف يحتوي على كل متغيرات البيئة المدعومة مع شرح مفصل.
# انسخه إلى .env وعدّله حسب حاجتك:
#   cp .env.example .env
#
# القيم الافتراضية مناسبة لبيئة التطوير.
# ⚠️  في الإنتاج: غيّر JWT_SECRET وNODE_ENV حتماً!
# ======================================================================

# ──────────────────────────────────────────────────────────────────────
# الخادم / Server
# ──────────────────────────────────────────────────────────────────────
# PORT: المنفذ الذي يستمع عليه الخادم
#   القيمة الافتراضية: 3000
#   في Docker: لا تغيّره (حدد المنفذ في docker-compose بدلاً من ذلك)
PORT=3000

# HOST: العنوان الذي يستمع عليه الخادم
#   0.0.0.0 = يقبل اتصالات من كل الشبكات (مطلوب في Docker)
#   127.0.0.1 = محلي فقط (أكثر أماناً في التطوير)
HOST=0.0.0.0

# NODE_ENV: بيئة التشغيل
#   development: تفعيل رسائل الخطأ المفصلة + سجلات تنقيح
#   production: إخفاء التفاصيل + تفعيل cache + تحسين الأداء
#   test: مستخدم تلقائياً من Jest (لا تحتاج تعيينه يدوياً)
NODE_ENV=development

# ──────────────────────────────────────────────────────────────────────
# قاعدة البيانات / Database
# ──────────────────────────────────────────────────────────────────────
# DB_PATH: مسار ملف SQLite
#   يُنشأ تلقائياً إذا لم يكن موجوداً.
#   في Docker: اجعله داخل volume لحفظ البيانات بين إعادة التشغيل.
#   مثال Docker: /app/data/registry.db
DB_PATH=./data/registry.db

# ──────────────────────────────────────────────────────────────────────
# المصادقة / Authentication
# ──────────────────────────────────────────────────────────────────────
# JWT_SECRET: السر المستخدم لتوقيع رموز JWT
#   ⚠️  مهم جداً! غيّره في الإنتاج إلى قيمة عشوائية طويلة:
#   openssl rand -hex 64
#   أو: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sad-registry-secret-change-me-in-production-2026

# JWT_EXPIRY: مدة صلاحية رمز JWT
#   الصيغ المقبولة: 30d (يوم), 24h (ساعة), 60m (دقيقة), 3600s (ثانية)
#   الافتراضي: 30d (30 يوم) — مناسب لأداة CLI التي تخزن الرمز محلياً
JWT_EXPIRY=30d

# BCRYPT_ROUNDS: عدد جولات تشفير bcrypt
#   كلما زاد الرقم = أبطأ + أكثر أماناً
#   10: سريع (تطوير)
#   12: توازن جيد (إنتاج) — ~0.3 ثانية/كلمة مرور
#   14: أمان عالي — ~1.0 ثانية/كلمة مرور
BCRYPT_ROUNDS=12

# ──────────────────────────────────────────────────────────────────────
# التخزين / Storage
# ──────────────────────────────────────────────────────────────────────
# STORAGE_PATH: مجلد تخزين أرشيفات الحزم (.tar.gz)
#   يُنشأ تلقائياً. في Docker: اجعله volume.
#   البنية: STORAGE_PATH/<اسم_الحزمة>/<الإصدار>/<اسم>-<إصدار>.tar.gz
STORAGE_PATH=./storage/packages

# MAX_PACKAGE_SIZE: الحد الأقصى لحجم الحزمة المرفوعة
#   يقبل: 10mb, 50mb, 100mb
MAX_PACKAGE_SIZE=50mb

# ──────────────────────────────────────────────────────────────────────
# معلومات السجل / Registry Information
# ──────────────────────────────────────────────────────────────────────
# هذه القيم تظهر في API وواجهة الويب
REGISTRY_NAME=سجل حزم لغة ص
REGISTRY_URL=http://185.47.174.39:3000
REGISTRY_DESCRIPTION=المستودع الرسمي لحزم لغة ص البرمجية العربية

# ──────────────────────────────────────────────────────────────────────
# الحدود / Rate Limiting
# ──────────────────────────────────────────────────────────────────────
# هذه الحدود تمنع الإفراط في استخدام API والهجمات.

# RATE_LIMIT_WINDOW_MS: نافذة الحد بالمللي ثانية
#   الافتراضي: 900000 (15 دقيقة)
RATE_LIMIT_WINDOW_MS=900000

# RATE_LIMIT_MAX_REQUESTS: الحد الأقصى للطلبات في النافذة
#   الافتراضي: 100 طلب/15 دقيقة لكل IP
#   في التطوير: ارفعه إلى 1000 لتجنب الحظر أثناء الاختبار
RATE_LIMIT_MAX_REQUESTS=100

# PUBLISH_RATE_LIMIT_MAX: الحد الأقصى لعمليات النشر/ساعة
#   الافتراضي: 10 — يمنع spam النشر
PUBLISH_RATE_LIMIT_MAX=10

# ──────────────────────────────────────────────────────────────────────
# التسجيل / Logging
# ──────────────────────────────────────────────────────────────────────
# LOG_LEVEL: مستوى التسجيل
#   debug: كل التفاصيل (تطوير)
#   info: عمليات عادية (إنتاج)
#   warn: تحذيرات فقط
#   error: أخطاء فقط
LOG_LEVEL=debug

# LOG_FILE: ملف السجل (اختياري — افتراضياً يطبع في stdout)
LOG_FILE=./logs/registry.log
