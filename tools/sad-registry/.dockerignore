# ======================================================================== #
# ملف .dockerignore - سجل الملفات                                          #
# ======================================================================== #
#                                                                          #
# الوصف:                                                                   #
#   يحدد هذا الملف الملفات والمجلدات التي يجب استبعادها من سياق بناء       #
#   Docker (Docker build context). هذا يسرّع عملية البناء ويقلل حجم        #
#   الصورة النهائية بشكل كبير.                                              #
#                                                                          #
# لماذا هذا مهم؟                                                            #
#   1) عند تشغيل `docker build .`، يُرسل Docker كل الملفات في المجلد      #
#      الحالي كـ "build context" إلى Docker daemon.                        #
#   2) بدون .dockerignore، يُرسل node_modules (مئات الميغابايت)            #
#      والملفات المؤقتة دون داعٍ.                                            #
#   3) هذا يبطئ البناء ويهدر المساحة والنطاق.                              #
#                                                                          #
# النتيجة المتوقعة:                                                        #
#   - تقليل حجم سياق البناء من ~200MB+ إلى ~2MB                           #
#   - تسريع عملية `docker build` بشكل ملحوظ                               #
#   - حماية البيانات الحساسة من الدخول في الصورة                           #
#                                                                          #
# ======================================================================== #

# ────────────────────────────────────────────────────────────
# الاعتماديات المثبتة محلياً (سيتم تثبيتها داخل Docker)
# ────────────────────────────────────────────────────────────
node_modules/

# ────────────────────────────────────────────────────────────
# البيانات المحلية (قاعدة البيانات، الحزم المرفوعة، السجلات)
# ────────────────────────────────────────────────────────────
data/
storage/
logs/

# ────────────────────────────────────────────────────────────
# ملفات الاختبار والتغطية (لا حاجة لها في الإنتاج)
# ────────────────────────────────────────────────────────────
tests/
coverage/
.nyc_output/
jest.config.*

# ────────────────────────────────────────────────────────────
# ملفات البيئة الحساسة (يجب تمريرها كمتغيرات بيئة)
# ────────────────────────────────────────────────────────────
.env
.env.local
.env.production
# ملاحظة: .env.example مسموح به (لا يحتوي أسرار)

# ────────────────────────────────────────────────────────────
# ملفات Docker نفسها (لا حاجة لها داخل الصورة)
# ────────────────────────────────────────────────────────────
Dockerfile
docker-compose.yml
docker/
.dockerignore

# ────────────────────────────────────────────────────────────
# ملفات Git والتوثيق (لا حاجة لها في الإنتاج)
# ────────────────────────────────────────────────────────────
.git/
.gitignore
README.md
LICENSE
docs/
*.md

# ────────────────────────────────────────────────────────────
# ملفات المحرر والنظام
# ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ────────────────────────────────────────────────────────────
# سكربتات التطوير (الـ seeder وأدوات التطوير)
# ────────────────────────────────────────────────────────────
scripts/

# ────────────────────────────────────────────────────────────
# ملفات npm المؤقتة
# ────────────────────────────────────────────────────────────
npm-debug.log*
package-lock.json.bak
