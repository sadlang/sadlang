{
  "name": "sad-registry",
  "version": "1.0.0",
  "description": "سجل حزم لغة ص - Sad Language Package Registry",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node migrations/run.js",
    "seed": "node scripts/seed.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "docker:build": "docker build -t sad-registry .",
    "docker:run": "docker-compose up -d"
  },
  "keywords": ["sad", "arabic", "programming-language", "package-registry", "لغة-ص"],
  "author": "فريق لغة ص / Sad Language Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "morgan": "^1.10.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "tar": "^7.0.1",
    "semver": "^7.5.4",
    "ejs": "^3.1.9",
    "dotenv": "^16.3.1",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
