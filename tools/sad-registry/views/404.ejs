<%# بسم الله الرحمن الرحيم %>
<%# ======================================================================= %>
<%# صفحة 404 - الصفحة غير موجودة                                            %>
<%# 404 Page - Page Not Found                                               %>
<%#                                                                         %>
<%# تُعرض عندما يزور المستخدم رابطاً غير موجود في واجهة الويب              %>
<%# Shown when a user visits a non-existent URL in the web interface        %>
<%#                                                                         %>
<%# المتغيرات المتوقعة:                                                     %>
<%#   - message: رسالة الخطأ (اختيارية)                                      %>
<%# ======================================================================= %>

<%- include('partials/header') %>

<!-- ====================================================================== -->
<!-- صفحة الخطأ 404: تصميم بسيط ومركزي مع رابط للعودة                      -->
<!-- 404 Error Page: simple centered design with back link                  -->
<!-- ====================================================================== -->
<section class="page-content">
    <div class="container">
        <div class="error-page">

            <!-- رمز الخطأ الكبير / Large Error Code -->
            <h1>٤٠٤</h1>

            <!-- رسالة الخطأ / Error Message -->
            <p>
                <% if (typeof message !== 'undefined' && message) { %>
                    <%= message %>
                <% } else { %>
                    الصفحة المطلوبة غير موجودة 😕
                <% } %>
            </p>

            <!-- أزرار التنقل: للعودة للرئيسية أو البحث -->
            <a href="/" class="btn-primary">🏠 العودة للرئيسية</a>
            &nbsp;&nbsp;
            <a href="/search" class="btn-primary">🔍 بحث عن حزمة</a>

        </div>
    </div>
</section>

<%- include('partials/footer') %>
