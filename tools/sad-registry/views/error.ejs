<%# بسم الله الرحمن الرحيم %>
<%# ======================================================================= %>
<%# صفحة الخطأ العام - خطأ في الخادم (500 وغيره)                            %>
<%# General Error Page - Server errors (500, etc.)                          %>
<%#                                                                         %>
<%# تُعرض عند حدوث خطأ غير متوقع في الخادم                                 %>
<%# Shown when an unexpected server error occurs                            %>
<%#                                                                         %>
<%# المتغيرات المتوقعة:                                                     %>
<%#   - message: رسالة الخطأ                                                 %>
<%# ======================================================================= %>

<%- include('partials/header') %>

<!-- ====================================================================== -->
<!-- صفحة خطأ الخادم: تعرض رسالة عامة مع رابط للعودة                       -->
<!-- Server Error Page: shows general message with back link                -->
<!-- ====================================================================== -->
<section class="page-content">
    <div class="container">
        <div class="error-page">

            <!-- رمز الخطأ / Error Icon -->
            <h1>⚠️</h1>

            <h2>حدث خطأ في الخادم</h2>

            <!-- رسالة الخطأ (تعرض التفاصيل فقط في وضع التطوير) -->
            <p>
                <% if (typeof message !== 'undefined' && message) { %>
                    <%= message %>
                <% } else { %>
                    حدث خطأ غير متوقع. يرجى المحاولة مرة أخرى لاحقاً.
                <% } %>
            </p>

            <!-- زر العودة / Back Button -->
            <a href="/" class="btn-primary">🏠 العودة للرئيسية</a>

        </div>
    </div>
</section>

<%- include('partials/footer') %>
