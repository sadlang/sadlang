<%# بسم الله الرحمن الرحيم %>
<%# ======================================================================= %>
<%# صفحة البحث عن الحزم في سجل لغة ص                                       %>
<%# Package Search Page for Sad Language Registry                           %>
<%#                                                                         %>
<%# هذه الصفحة تعرض:                                                        %>
<%#   1. نموذج بحث كبير مع حقل إدخال                                       %>
<%#   2. شريط تصفية التصنيفات (أزرار تصفية)                                 %>
<%#   3. نتائج البحث في شكل قائمة                                          %>
<%#   4. حالة فارغة إذا لم تُوجد نتائج                                      %>
<%#                                                                         %>
<%# المتغيرات المتوقعة من web.js:                                           %>
<%#   - q: نص البحث الحالي (string)                                         %>
<%#   - category: التصنيف المختار حالياً (string)                           %>
<%#   - packages: مصفوفة نتائج البحث                                        %>
<%#   - categories: مصفوفة كل التصنيفات                                     %>
<%# ======================================================================= %>

<%- include('partials/header') %>

<!-- ====================================================================== -->
<!-- قسم البحث الرئيسي                                                      -->
<!-- Main Search Section                                                    -->
<!-- ====================================================================== -->
<section class="page-content">
    <div class="container">

        <!-- عنوان الصفحة / Page Title -->
        <h1 class="section-title">🔍 البحث عن حزم</h1>

        <!-- ============================================================== -->
        <!-- نموذج البحث: حقل إدخال كبير مع زر بحث                          -->
        <!-- يرسل GET إلى /search?q=...&category=...                        -->
        <!-- Search Form: large input with search button                    -->
        <!-- Sends GET to /search?q=...&category=...                        -->
        <!-- ============================================================== -->
        <form action="/search" method="GET" class="search-form-page">
            <input 
                type="text" 
                name="q" 
                class="search-input-large" 
                placeholder="ابحث باسم الحزمة أو الوصف... (عربي أو إنجليزي)"
                value="<%= q %>"
                autocomplete="off"
                dir="rtl"
            >

            <%# حقل مخفي لحفظ التصنيف المحدد عند البحث %>
            <% if (category) { %>
                <input type="hidden" name="category" value="<%= category %>">
            <% } %>

            <button type="submit" class="btn-primary">🔍 بحث</button>
        </form>

        <!-- ============================================================== -->
        <!-- شريط التصنيفات: أزرار تصفية لتضييق نتائج البحث                 -->
        <!-- التصنيف النشط يحصل على كلاس tag-active                        -->
        <!-- Category Filter Bar: filter buttons to narrow search results    -->
        <!-- Active category gets tag-active class                          -->
        <!-- ============================================================== -->
        <div class="filter-tags">
            <%# زر "الكل" — يزيل تصفية التصنيف %>
            <a href="/search?q=<%= encodeURIComponent(q) %>" 
               class="tag <%= !category ? 'tag-active' : '' %>">
                الكل
            </a>

            <% categories.forEach(function(cat) { %>
                <a href="/search?q=<%= encodeURIComponent(q) %>&category=<%= cat.slug %>" 
                   class="tag <%= category === cat.slug ? 'tag-active' : '' %>">
                    <%= cat.icon %> <%= cat.name_ar %>
                </a>
            <% }); %>
        </div>

        <!-- ============================================================== -->
        <!-- عداد النتائج: يعرض عدد النتائج المطابقة                        -->
        <!-- Results Counter: shows number of matching results               -->
        <!-- ============================================================== -->
        <p class="results-count">
            <% if (q || category) { %>
                تم العثور على <strong><%= packages.length %></strong> حزمة
                <% if (q) { %> للبحث "<%= q %>"<% } %>
                <% if (category) { %> في تصنيف "<%= category %>"<% } %>
            <% } else { %>
                عرض جميع الحزم (<%= packages.length %>)
            <% } %>
        </p>

        <!-- ============================================================== -->
        <!-- قائمة نتائج البحث                                               -->
        <!-- كل نتيجة تعرض: اسم الحزمة، الإصدار، الوصف، التنزيلات، المؤلف  -->
        <!-- Search Results List                                             -->
        <!-- Each result shows: name, version, description, downloads, author-->
        <!-- ============================================================== -->
        <% if (packages.length > 0) { %>
            <div class="packages-list">
                <% packages.forEach(function(pkg) { %>
                    <a href="/packages/<%= pkg.name %>" class="package-list-item">
                        <!-- رأس النتيجة: الاسم والإصدار -->
                        <div class="package-list-info">
                            <span class="package-list-name"><%= pkg.name %></span>
                            <% if (pkg.latest_version) { %>
                                <span class="package-list-version">v<%= pkg.latest_version %></span>
                            <% } %>
                        </div>

                        <!-- وصف الحزمة (عربي أولاً، ثم إنجليزي كاحتياط) -->
                        <p class="package-list-desc">
                            <%= pkg.description_ar || pkg.description || 'بدون وصف' %>
                        </p>

                        <!-- معلومات إضافية: التنزيلات والمؤلف والكلمات المفتاحية -->
                        <div class="package-list-meta">
                            <span>⬇️ <%= (pkg.total_downloads || 0).toLocaleString('ar-SA') %></span>
                            <span>👤 <%= pkg.author || 'مجهول' %></span>
                            <% if (pkg.keywords) { %>
                                <% var kw = typeof pkg.keywords === 'string' ? JSON.parse(pkg.keywords) : pkg.keywords; %>
                                <% if (kw.length > 0) { %>
                                    <span>🏷️ <%= kw.slice(0, 3).join('، ') %></span>
                                <% } %>
                            <% } %>
                        </div>
                    </a>
                <% }); %>
            </div>

        <% } else { %>
            <!-- ========================================================== -->
            <!-- حالة فارغة: تظهر عندما لا توجد نتائج مطابقة                -->
            <!-- Empty State: shown when no results match                    -->
            <!-- ========================================================== -->
            <div class="empty-state">
                <p>😕 لم يتم العثور على حزم مطابقة</p>
                <% if (q) { %>
                    <p class="text-muted">جرّب كلمات بحث مختلفة أو تصفح التصنيفات</p>
                <% } else { %>
                    <p class="text-muted">لا توجد حزم في هذا التصنيف بعد</p>
                <% } %>
            </div>
        <% } %>

    </div>
</section>

<%- include('partials/footer') %>
