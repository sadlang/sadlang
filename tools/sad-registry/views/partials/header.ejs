<%# بسم الله الرحمن الرحيم %>
<%# ======================================================================= %>
<%# رأس الصفحة المشترك — يُضمن في كل صفحات الموقع                          %>
<%# Shared Header Partial — included in all site pages                      %>
<%#                                                                         %>
<%# يحتوي على:                                                              %>
<%#   - إعدادات HTML الأساسية (UTF-8, RTL, viewport)                       %>
<%#   - خطوط Google (Noto Kufi Arabic)                                     %>
<%#   - ملف CSS الرئيسي                                                     %>
<%#   - شريط التنقل مع بحث وروابط                                          %>
<%#                                                                         %>
<%# المتغيرات الاختيارية:                                                   %>
<%#   - title: عنوان مخصص للصفحة (يُضاف قبل اسم الموقع)                   %>
<%# ======================================================================= %>

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="سجل حزم لغة ص - المستودع الرسمي للغة البرمجة العربية">

    <!-- العنوان: يُضاف عنوان الصفحة المخصص قبل اسم الموقع إذا وُجد -->
    <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>سجل حزم لغة ص</title>

    <!-- خط Noto Kufi Arabic من Google — يدعم كل الأحرف العربية والتشكيل -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- الأنماط الرئيسية -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- ==================================================================== -->
    <!-- شريط التنقل الرئيسي — ثابت في أعلى الصفحة (sticky)                 -->
    <!-- Main Navigation Bar — fixed at the top (sticky)                      -->
    <!-- ==================================================================== -->
    <nav class="navbar">
        <div class="container nav-content">

            <!-- الشعار — ينقل للصفحة الرئيسية -->
            <a href="/" class="logo">
                <span class="logo-icon">📦</span>
                <span>حزم <strong>ص</strong></span>
            </a>

            <!-- حقل بحث سريع مضمن في شريط التنقل -->
            <div class="nav-search">
                <form action="/search" method="GET">
                    <input 
                        type="text" 
                        name="q" 
                        class="search-input" 
                        placeholder="ابحث عن حزمة..."
                        dir="rtl"
                    >
                    <button type="submit" class="search-btn">بحث</button>
                </form>
            </div>

            <!-- روابط التنقل -->
            <div class="nav-links">
                <a href="/search">🔍 تصفح</a>
                <a href="/api/v1">📡 API</a>
            </div>

        </div>
    </nav>

    <!-- بداية المحتوى الرئيسي -->
    <main>
