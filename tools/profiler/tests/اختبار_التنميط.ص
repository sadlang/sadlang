# === دوال حسابية بسيطة ===

دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

دالة فيبوناتشي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

# === دوال حلقات ===

دالة مجموع_إلى(حد)
    متغير المجموع = 0
    متغير ع = 1
    بينما (ع <= حد)
        المجموع = المجموع + ع
        ع = ع + 1
    نهاية
    ارجع المجموع
نهاية

دالة عد_تنازلي(من)
    متغير ع = من
    بينما (ع > 0)
        ع = ع - 1
    نهاية
    ارجع 0
نهاية

# === دوال نصية ===

دالة كرر_نص(النص، العدد)
    متغير النتيجة = ""
    متغير ع = 0
    بينما (ع < العدد)
        النتيجة = النتيجة + النص
        ع = ع + 1
    نهاية
    ارجع النتيجة
نهاية

# === دالة بطيئة متعمدة ===

دالة عملية_بطيئة()
    متغير س = 0
    متغير ع = 0
    بينما (ع < 5000)
        س = س + ع * ع
        ع = ع + 1
    نهاية
    ارجع س
نهاية

# === دالة سريعة ===

دالة عملية_سريعة()
    ارجع 42
نهاية

