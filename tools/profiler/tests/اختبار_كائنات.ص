صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية

    دالة المسافة(أخرى)
        متغير فرق_س = هذا.س - أخرى.س
        متغير فرق_ص = هذا.ص - أخرى.ص
        ارجع (فرق_س * فرق_س + فرق_ص * فرق_ص)
    نهاية

    دالة حرّك(دس، دص)
        هذا.س = هذا.س + دس
        هذا.ص = هذا.ص + دص
    نهاية

    دالة نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

صنف مستطيل
    باني(نقطة1، نقطة2)
        هذا.نقطة1 = نقطة1
        هذا.نقطة2 = نقطة2
    نهاية

    دالة العرض()
        متغير العرض = هذا.نقطة2.س - هذا.نقطة1.س
        إذا (العرض < 0)
            العرض = العرض * -1
        نهاية
        ارجع العرض
    نهاية

    دالة الارتفاع()
        متغير الارتفاع = هذا.نقطة2.ص - هذا.نقطة1.ص
        إذا (الارتفاع < 0)
            الارتفاع = الارتفاع * -1
        نهاية
        ارجع الارتفاع
    نهاية

    دالة المساحة()
        ارجع هذا.العرض() * هذا.الارتفاع()
    نهاية
نهاية

# === البرنامج الرئيسي ===

اطبع_سطر("═══ اختبار OOP مع المصحح ═══")

# إنشاء نقاط كثيرة
متغير النقاط = []
متغير ع = 0
بينما (ع < 50)
    متغير ن = جديد نقطة(ع، ع * 2)
    النقاط.أضف(ن)
    ع = ع + 1
نهاية

اطبع_سطر("تم إنشاء " + طول(النقاط) + " نقطة")

# حساب المسافات
متغير مجموع_المسافات = 0
ع = 0
بينما (ع < طول(النقاط) - 1)
    مجموع_المسافات = مجموع_المسافات + النقاط[ع].المسافة(النقاط[ع + 1])
    ع = ع + 1
نهاية
اطبع_سطر("مجموع المسافات: " + مجموع_المسافات)

# تحريك النقاط
ع = 0
بينما (ع < طول(النقاط))
    النقاط[ع].حرّك(1، -1)
    ع = ع + 1
نهاية

# مستطيلات
متغير م = جديد مستطيل(جديد نقطة(0، 0)، جديد نقطة(10، 20))
اطبع_سطر("مساحة المستطيل: " + م.المساحة())

