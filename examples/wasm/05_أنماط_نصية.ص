# البرنامج 5: أنماط نصية (رسم بالأحرف)
# رسم أشكال هندسية بالنصوص

# ═══════════════════════════════════════════
#  فن الرسم النصي — لغة ص
# ═══════════════════════════════════════════

اطبع_سطر("═══════════════════════════════")
اطبع_سطر("  🎨 فن الرسم النصي — لغة ص")
اطبع_سطر("═══════════════════════════════")

# ═══ مثلث ═══
اطبع_سطر("")
اطبع_سطر("▲ مثلث:")
متغير ص = 1
بينما (ص <= 10)
    متغير مسافات = ""
    متغير ف = 0
    بينما (ف < 10 - ص)
        مسافات = مسافات + " "
        ف = ف + 1
    نهاية
    
    متغير نجوم = ""
    متغير ن = 0
    بينما (ن < 2 * ص - 1)
        نجوم = نجوم + "★"
        ن = ن + 1
    نهاية
    
    اطبع_سطر(مسافات + نجوم)
    ص = ص + 1
نهاية

# ═══ مربع ═══
اطبع_سطر("")
اطبع_سطر("■ مربع مزخرف:")
متغير الحجم = 12
متغير س = 0
بينما (س < الحجم)
    متغير السطر = ""
    متغير ع = 0
    بينما (ع < الحجم)
        إذا (س == 0 أو س == الحجم - 1 أو ع == 0 أو ع == الحجم - 1)
            السطر = السطر + "█"
        وإلا
            إذا ((س + ع) % 2 == 0)
                السطر = السطر + "░"
            وإلا
                السطر = السطر + "▓"
            نهاية
        نهاية
        ع = ع + 1
    نهاية
    اطبع_سطر("  " + السطر)
    س = س + 1
نهاية

# ═══ ماسة ═══
اطبع_سطر("")
اطبع_سطر("◆ ماسة:")
متغير نصف = 7

# النصف العلوي
متغير ت = 1
بينما (ت <= نصف)
    متغير مسافة = ""
    متغير ف2 = 0
    بينما (ف2 < نصف - ت)
        مسافة = مسافة + " "
        ف2 = ف2 + 1
    نهاية
    
    متغير حروف = ""
    متغير ح = 0
    بينما (ح < 2 * ت - 1)
        حروف = حروف + "◆"
        ح = ح + 1
    نهاية
    
    اطبع_سطر(مسافة + حروف)
    ت = ت + 1
نهاية

# النصف السفلي
متغير ت2 = نصف - 1
بينما (ت2 >= 1)
    متغير مسافة2 = ""
    متغير ف3 = 0
    بينما (ف3 < نصف - ت2)
        مسافة2 = مسافة2 + " "
        ف3 = ف3 + 1
    نهاية
    
    متغير حروف2 = ""
    متغير ح2 = 0
    بينما (ح2 < 2 * ت2 - 1)
        حروف2 = حروف2 + "◆"
        ح2 = ح2 + 1
    نهاية
    
    اطبع_سطر(مسافة2 + حروف2)
    ت2 = ت2 - 1
نهاية

