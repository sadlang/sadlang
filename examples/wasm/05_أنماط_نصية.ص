# ═══ رسالة بإطار ═══
اطبع_سطر("")
اطبع_سطر("💬 رسالة مؤطرة:")

دالة اطبع_إطار(الرسالة)
    متغير العرض = طول(الرسالة) + 4
    
    # الحد العلوي
    متغير حد_علوي = "╔"
    متغير خ = 0
    بينما (خ < العرض)
        حد_علوي = حد_علوي + "═"
        خ = خ + 1
    نهاية
    حد_علوي = حد_علوي + "╗"
    اطبع_سطر("  " + حد_علوي)
    
    # النص
    اطبع_سطر("  ║  " + الرسالة + "  ║")
    
    # الحد السفلي
    متغير حد_سفلي = "╚"
    متغير خ2 = 0
    بينما (خ2 < العرض)
        حد_سفلي = حد_سفلي + "═"
        خ2 = خ2 + 1
    نهاية
    حد_سفلي = حد_سفلي + "╝"
    اطبع_سطر("  " + حد_سفلي)
نهاية

اطبع_إطار("مرحباً بكم في لغة ص!")
اطبع_إطار("لغة برمجة عربية حديثة")
