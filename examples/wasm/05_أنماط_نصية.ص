# ═══ شريط التقدم ═══
اطبع_سطر("")
اطبع_سطر("📊 أشرطة التقدم:")

دالة شريط_تقدم(التسمية، النسبة)
    متغير ممتلئ = النسبة / 5
    متغير فارغ = 20 - ممتلئ
    
    متغير الشريط = "["
    متغير ب = 0
    بينما (ب < ممتلئ)
        الشريط = الشريط + "█"
        ب = ب + 1
    نهاية
    بينما (ب < 20)
        الشريط = الشريط + "░"
        ب = ب + 1
    نهاية
    الشريط = الشريط + "] " + النسبة + "%"
    
    اطبع_سطر("  " + التسمية + ": " + الشريط)
نهاية

شريط_تقدم("التصميم  ", 100)
شريط_تقدم("التطوير  ", 75)
شريط_تقدم("الاختبار ", 45)
شريط_تقدم("النشر    ", 20)

