# البرنامج 4: إدارة مهام
# نظام إدارة مهام بسيط

# ═══════════════════════════════════════════
#  نظام إدارة المهام — لغة ص
# ═══════════════════════════════════════════

اطبع_سطر("═══════════════════════════════")
اطبع_سطر("  📋 نظام إدارة المهام — لغة ص")
اطبع_سطر("═══════════════════════════════")

# تخزين المهام
متغير المهام_عناوين = []
متغير المهام_حالات = []
متغير المهام_أولويات = []
متغير عدد_المهام = 0

# إضافة مهمة
دالة أضف_مهمة(العنوان، الأولوية)
    أضف(المهام_عناوين، العنوان)
    أضف(المهام_حالات، "قيد_الانتظار")
    أضف(المهام_أولويات، الأولوية)
    عدد_المهام = عدد_المهام + 1
    اطبع_سطر("  ➕ تمت إضافة: " + العنوان + " [" + الأولوية + "]")
نهاية

# إكمال مهمة
دالة أكمل_مهمة(الفهرس)
    إذا (الفهرس >= 0 و الفهرس < عدد_المهام)
        المهام_حالات[الفهرس] = "مكتمل"
        اطبع_سطر("  ✅ تم إكمال: " + المهام_عناوين[الفهرس])
    نهاية
نهاية

# عرض جميع المهام
دالة اعرض_المهام()
    اطبع_سطر("")
    اطبع_سطر("  ╔════════════════════════════════════════════╗")
    اطبع_سطر("  ║          📋 قائمة المهام الحالية           ║")
    اطبع_سطر("  ╚════════════════════════════════════════════╝")
    
    متغير ع = 0
    بينما (ع < عدد_المهام)
        متغير الرمز = "⏳"
        إذا (المهام_حالات[ع] == "مكتمل")
            الرمز = "✅"
        نهاية
        
        متغير رمز_أولوية = "🟢"
        إذا (المهام_أولويات[ع] == "عالية")
            رمز_أولوية = "🔴"
        وإلا
            إذا (المهام_أولويات[ع] == "متوسطة")
                رمز_أولوية = "🟡"
            نهاية
        نهاية
        
        اطبع_سطر("  " + الرمز + " " + (ع + 1) + ". " + المهام_عناوين[ع] + " " + رمز_أولوية)
        ع = ع + 1
    نهاية
نهاية

# إحصائيات
دالة اعرض_إحصائيات()
    متغير مكتمل = 0
    متغير قيد_انتظار = 0
    متغير عالية = 0
    
    متغير ع = 0
    بينما (ع < عدد_المهام)
        إذا (المهام_حالات[ع] == "مكتمل")
            مكتمل = مكتمل + 1
        وإلا
            قيد_انتظار = قيد_انتظار + 1
        نهاية
        
        إذا (المهام_أولويات[ع] == "عالية")
            عالية = عالية + 1
        نهاية
        ع = ع + 1
    نهاية
    
    اطبع_سطر("")
    اطبع_سطر("  📊 الإحصائيات:")
    اطبع_سطر("  ─────────────────────────")
    اطبع_سطر("  📁 المجموع:     " + عدد_المهام)
    اطبع_سطر("  ✅ مكتمل:       " + مكتمل)
    اطبع_سطر("  ⏳ قيد الانتظار: " + قيد_انتظار)
    اطبع_سطر("  🔴 أولوية عالية: " + عالية)
    
    إذا (عدد_المهام > 0)
        متغير النسبة = (مكتمل * 100) / عدد_المهام
        اطبع_سطر("  📈 نسبة الإكمال: " + النسبة + "%")
    نهاية
نهاية

# ═══ تشغيل النظام ═══
اطبع_سطر("")
اطبع_سطر("➕ إضافة المهام:")
اطبع_سطر("─────────────────────────────")

أضف_مهمة("تصميم واجهة المشروع"، "عالية")
أضف_مهمة("كتابة التوثيق"، "متوسطة")
أضف_مهمة("إضافة اختبارات الوحدة"، "عالية")
أضف_مهمة("تحسين الأداء"، "متوسطة")
أضف_مهمة("إصلاح الأخطاء المعروفة"، "عالية")
أضف_مهمة("إعداد بيئة النشر"، "منخفضة")
أضف_مهمة("مراجعة الكود"، "متوسطة")
أضف_مهمة("تحديث المكتبات"، "منخفضة")

# عرض المهام
اعرض_المهام()

# إكمال بعض المهام
اطبع_سطر("")
اطبع_سطر("🔄 إكمال المهام:")
اطبع_سطر("─────────────────────────────")
أكمل_مهمة(0)
أكمل_مهمة(2)
أكمل_مهمة(4)

# عرض المهام بعد التحديث
اعرض_المهام()

# عرض الإحصائيات
اعرض_إحصائيات()

اطبع_سطر("")
اطبع_سطر("═══════════════════════════════")
اطبع_سطر("✅ تم تنفيذ نظام إدارة المهام بنجاح!")
