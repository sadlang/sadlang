# تحقق من الأعداد الأولية
دالة أولي(ن)
    إذا (ن < 2)
        ارجع خطأ
    نهاية
    متغير ق = 2
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            ارجع خطأ
        نهاية
        ق = ق + 1
    نهاية
    ارجع صحيح
نهاية

