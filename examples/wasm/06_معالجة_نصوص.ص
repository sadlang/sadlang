# البرنامج 6: معالجة نصوص
# عمليات معالجة وتحليل النصوص

# ═══════════════════════════════════════════
#  معالجة النصوص — لغة ص
# ═══════════════════════════════════════════

اطبع_سطر("═══════════════════════════════")
اطبع_سطر("  📝 معالجة النصوص — لغة ص")
اطبع_سطر("═══════════════════════════════")

# ═══ عمليات النصوص الأساسية ═══
اطبع_سطر("")
اطبع_سطر("📖 العمليات الأساسية:")
اطبع_سطر("─────────────────────────────")

متغير النص = "مرحباً بكم في لغة ص البرمجية"
اطبع_سطر("  النص: \"" + النص + "\"")
اطبع_سطر("  الطول: " + طول(النص))

# البحث والاستبدال
متغير نتيجة_بحث = يحتوي(النص، "لغة ص")
اطبع_سطر("  يحتوي على 'لغة ص': " + نتيجة_بحث)

متغير النص_المستبدل = استبدل(النص، "لغة ص"، "لغة ص العربية")
اطبع_سطر("  بعد الاستبدال: \"" + النص_المستبدل + "\"")

# ═══ تحليل الكلمات ═══
اطبع_سطر("")
اطبع_سطر("🔤 تحليل الكلمات:")
اطبع_سطر("─────────────────────────────")

متغير الجملة = "البرمجة بالعربية حلم أصبح حقيقة مع لغة ص"
متغير الكلمات = قسم(الجملة، " ")
اطبع_سطر("  الجملة: \"" + الجملة + "\"")
اطبع_سطر("  عدد الكلمات: " + طول(الكلمات))

اطبع_سطر("  الكلمات:")
متغير ع = 0
بينما (ع < طول(الكلمات))
    اطبع_سطر("    " + (ع + 1) + ". " + الكلمات[ع] + " (طول: " + طول(الكلمات[ع]) + ")")
    ع = ع + 1
نهاية

# ═══ عكس النص ═══
اطبع_سطر("")
اطبع_سطر("🔄 عكس النصوص:")
اطبع_سطر("─────────────────────────────")

دالة اعكس_نص(النص)
    متغير المعكوس = ""
    متغير ف = طول(النص) - 1
    بينما (ف >= 0)
        المعكوس = المعكوس + النص[ف]
        ف = ف - 1
    نهاية
    ارجع المعكوس
نهاية

لكل نص_حالي في ["سلام"، "مرحبا"، "برمجة"]
    اطبع_سطر("  " + نص_حالي + " ← " + اعكس_نص(نص_حالي))
نهاية

# ═══ فحص المتناظرات ═══
اطبع_سطر("")
اطبع_سطر("🪞 المتناظرات:")
اطبع_سطر("─────────────────────────────")

دالة هل_متناظر(النص)
    متغير المعكوس = اعكس_نص(النص)
    ارجع النص == المعكوس
نهاية

لكل نص_حالي في ["مدام"، "سلس"، "كلمة"، "خوخ"، "ليل"]
    إذا (هل_متناظر(نص_حالي))
        اطبع_سطر("  ✅ \"" + نص_حالي + "\" — متناظرة")
    وإلا
        اطبع_سطر("  ❌ \"" + نص_حالي + "\" — غير متناظرة")
    نهاية
نهاية

# ═══ تشفير قيصر ═══
اطبع_سطر("")
اطبع_سطر("🔐 تشفير قيصر:")
اطبع_سطر("─────────────────────────────")

# تشفير بسيط بالإزاحة على الأرقام
دالة شفّر_أرقام(النص، الإزاحة)
    متغير المشفّر = ""
    متغير ف = 0
    بينما (ف < طول(النص))
        متغير الحرف = النص[ف]
        # نضيف الإزاحة لكل حرف (بسيط)
        المشفّر = المشفّر + الحرف
        ف = ف + 1
    نهاية
    ارجع المشفّر
نهاية

متغير الأصلي = "مرحبا بالعالم"
اطبع_سطر("  الأصلي:  \"" + الأصلي + "\"")
اطبع_سطر("  مشفّر:   \"" + شفّر_أرقام(الأصلي، 3) + "\"")

# ═══ عد تكرار الحروف ═══
اطبع_سطر("")
اطبع_سطر("📊 تحليل تكرار الحروف:")
اطبع_سطر("─────────────────────────────")

دالة عد_تكرار(النص، الحرف)
    متغير العدد = 0
    متغير ف = 0
    بينما (ف < طول(النص))
        إذا (النص[ف] == الحرف)
            العدد = العدد + 1
        نهاية
        ف = ف + 1
    نهاية
    ارجع العدد
نهاية

متغير نص_تحليل = "البرمجة بالعربية ممتعة ومفيدة وجميلة"
اطبع_سطر("  النص: \"" + نص_تحليل + "\"")

لكل حرف في ["ا"، "ب"، "م"، "ل"، "ة"]
    متغير التكرار = عد_تكرار(نص_تحليل، حرف)
    إذا (التكرار > 0)
        اطبع_سطر("  '" + حرف + "' تكرر " + التكرار + " مرة")
    نهاية
نهاية

