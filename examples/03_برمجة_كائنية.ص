# مثال — البرمجة الكائنية
# يوضح: صنف، باني، وراثة، الأساس

صنف حيوان
    متغير عام الاسم
    متغير عام العمر

    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية

    دالة عام وصف()
        ارجع هذا.الاسم + " (عمره " + هذا.العمر + " سنوات)"
    نهاية

    دالة عام صوت()
        ارجع "..."
    نهاية
نهاية

صنف قطة يرث حيوان
    باني(اسم، عمر)
        الأساس(اسم، عمر)
    نهاية

    دالة عام صوت()
        ارجع "مياو!"
    نهاية
نهاية

صنف كلب يرث حيوان
    باني(اسم، عمر)
        الأساس(اسم، عمر)
    نهاية

    دالة عام صوت()
        ارجع "هاو!"
    نهاية
نهاية

# إنشاء كائنات
متغير حيواناتي = [قطة("ميمي"، 3)، كلب("ريكس"، 5)]

لكل ح في حيواناتي
    اطبع_سطر(ح.وصف() + " → " + ح.صوت())
