// بسم الله الرحمن الرحيم
/**
 * @file ffi_example.sad
 * @brief FFI (Foreign Function Interface) Example - مثال نظام FFI
 * 
 * يوضح كيفية استدعاء دوال من مكتبات C/C++ خارجية
 * Demonstrates how to call functions from external C/C++ libraries
 * 
 * @author Sad Language Team
 * @date December 2025
 */

استيراد "ffi"

// ============================================================================
// مثال 1: استدعاء دالة بسيطة من مكتبة C القياسية
// Example 1: Call simple function from C standard library
// ============================================================================

دالة example_call_c_stdlib() {
    اطبع("📚 مثال 1: استدعاء مكتبة C القياسية\n")
    اطبع("==================================\n\n")
    
    // تحميل مكتبة C القياسية / Load C standard library
    متغير libc = ffi.load_library("msvcrt.dll")  // Windows
    // For Linux/Mac: "libc.so.6" or "libc.dylib"
    
    إذا (!libc) {
        اطبع("❌ فشل تحميل مكتبة C\n")
        ارجع
    }
    
    اطبع("✅ تم تحميل مكتبة C بنجاح\n\n")
    
    // تعريف توقيع دالة strlen / Define strlen signature
    متغير strlen_sig = ffi.create_signature(
        "strlen",           // اسم الدالة / Function name
        ffi.Type.UInt64,   // نوع الإرجاع / Return type
        [ffi.Type.Pointer] // معاملات / Parameters
    )
    
    // تحميل دالة strlen / Load strlen function
    متغير strlen_func = libc.get_function("strlen", strlen_sig)
    
    إذا (!strlen_func) {
        اطبع("❌ فشل تحميل دالة strlen\n")
        ارجع
    }
    
    // استدعاء strlen / Call strlen
    متغير test_string = "مرحباً بالعالم! Hello World!"
    متغير length = strlen_func.call([test_string])
    
    اطبع("📏 طول النص: ")
    اطبع(length)
    اطبع("\n")
    اطبع("   النص: \"")
    اطبع(test_string)
    اطبع("\"\n\n")
    
    // إغلاق المكتبة / Close library
    libc.close()
    
    اطبع("✅ تم بنجاح!\n\n")
}

// ============================================================================
// مثال 2: استدعاء دالة مع عدة معاملات
// Example 2: Call function with multiple parameters
// ============================================================================

دالة example_multiple_params() {
    اطبع("🔢 مثال 2: دالة مع عدة معاملات\n")
    اطبع("===========================\n\n")
    
    متغير libc = ffi.load_library("msvcrt.dll")
    
    // تعريف توقيع printf / Define printf signature
    متغير printf_sig = ffi.create_signature(
        "printf",
        ffi.Type.Int32,
        [ffi.Type.Pointer],
        صحيح  // is_variadic
    )
    
    // تحميل printf / Load printf
    متغير printf_func = libc.get_function("printf", printf_sig)
    
    إذا (printf_func) {
        اطبع("✅ تم تحميل printf\n")
        
        // استدعاء printf / Call printf
        // ملاحظة: هذا مثال - في الواقع يحتاج معالجة خاصة
        // Note: This is an example - needs special handling in reality
        
        اطبع("📝 printf متاحة للاستدعاء\n\n")
    }
    
    libc.close()
}

// ============================================================================
// مثال 3: استخدام Callbacks
// Example 3: Using Callbacks
// ============================================================================

دالة example_callbacks() {
    اطبع("🔄 مثال 3: Callbacks من C إلى ص\n")
    اطبع("==============================\n\n")
    
    // تعريف callback / Define callback
    متغير my_callback = دالة(args) {
        اطبع("🎯 تم استدعاء callback من C!\n")
        اطبع("   عدد المعاملات: ")
        اطبع(args.length)
        اطبع("\n")
        
        ارجع 42  // قيمة إرجاع / Return value
    }
    
    // تسجيل callback / Register callback
    متغير callback_sig = ffi.create_signature(
        "my_callback",
        ffi.Type.Int32,
        [ffi.Type.Pointer]
    )
    
    متغير callback_obj = ffi.register_callback(
        "my_callback",
        callback_sig,
        my_callback
    )
    
    إذا (callback_obj) {
        اطبع("✅ تم تسجيل callback بنجاح\n")
        
        // الحصول على مؤشر C / Get C pointer
        متغير c_ptr = callback_obj.get_c_pointer()
        
        اطبع("📍 مؤشر C للـ callback: ")
        اطبع(c_ptr)
        اطبع("\n")
        
        // يمكن تمرير هذا المؤشر لدوال C التي تتوقع callback
        // This pointer can be passed to C functions expecting callbacks
        
        اطبع("✅ Callback جاهز للاستخدام!\n\n")
        
        // إلغاء التسجيل / Unregister
        ffi.unregister_callback("my_callback")
        اطبع("🗑️  تم إلغاء تسجيل callback\n\n")
    }
}

// ============================================================================
// مثال 4: إدارة المكتبات
// Example 4: Library Management
// ============================================================================

دالة example_library_management() {
    اطبع("📦 مثال 4: إدارة المكتبات\n")
    اطبع("=======================\n\n")
    
    // الحصول على FFI Manager / Get FFI Manager
    متغير manager = ffi.get_manager()
    
    // إضافة مسار بحث / Add search path
    manager.add_search_path("C:\\libs")
    manager.add_search_path("./custom_libs")
    
    اطبع("✅ تمت إضافة مسارات البحث\n")
    
    // عرض المسارات / Display paths
    متغير paths = manager.get_search_paths()
    اطبع("📂 مسارات البحث:\n")
    
    لكل path في paths {
        اطبع("   - ")
        اطبع(path)
        اطبع("\n")
    }
    
    اطبع("\n")
    
    // البحث عن مكتبة / Find library
    متغير lib_path = manager.find_library("example.dll")
    
    إذا (lib_path != "") {
        اطبع("✅ تم العثور على المكتبة: ")
        اطبع(lib_path)
        اطبع("\n")
    } وإلا {
        اطبع("⚠️  لم يتم العثور على example.dll\n")
    }
    
    اطبع("\n")
    
    // عرض الإحصائيات / Display statistics
    متغير stats = manager.get_stats()
    
    اطبع("📊 إحصائيات FFI:\n")
    اطبع("   - مكتبات محملة: ")
    اطبع(stats.libraries_loaded)
    اطبع("\n")
    اطبع("   - دوال محملة: ")
    اطبع(stats.functions_loaded)
    اطبع("\n")
    اطبع("   - callbacks مسجلة: ")
    اطبع(stats.callbacks_registered)
    اطبع("\n")
    اطبع("   - مجموع الاستدعاءات: ")
    اطبع(stats.total_calls)
    اطبع("\n")
    اطبع("   - استدعاءات فاشلة: ")
    اطبع(stats.failed_calls)
    اطبع("\n\n")
}

// ============================================================================
// مثال 5: استدعاء سريع لمرة واحدة
// Example 5: One-time Quick Call
// ============================================================================

دالة example_quick_call() {
    اطبع("⚡ مثال 5: استدعاء سريع\n")
    اطبع("====================\n\n")
    
    // استدعاء دالة مباشرة بدون تحميل صريح / Direct call without explicit loading
    متغير sig = ffi.create_signature(
        "strlen",
        ffi.Type.UInt64,
        [ffi.Type.Pointer]
    )
    
    متغير result = ffi.call_once(
        "msvcrt.dll",
        "strlen",
        sig,
        ["Test String"]
    )
    
    إذا (result) {
        اطبع("✅ استدعاء سريع ناجح!\n")
        اطبع("   النتيجة: ")
        اطبع(result)
        اطبع("\n\n")
    } وإلا {
        اطبع("❌ فشل الاستدعاء السريع\n\n")
    }
}

// ============================================================================
// مثال 6: معالجة الأخطاء
// Example 6: Error Handling
// ============================================================================

دالة example_error_handling() {
    اطبع("🔍 مثال 6: معالجة الأخطاء\n")
    اطبع("=======================\n\n")
    
    متغير manager = ffi.get_manager()
    
    // محاولة تحميل مكتبة غير موجودة / Try loading non-existent library
    متغير bad_lib = manager.load_library("nonexistent.dll")
    
    إذا (!bad_lib) {
        اطبع("⚠️  فشل تحميل المكتبة (متوقع)\n")
        
        // الحصول على آخر خطأ / Get last error
        متغير error = manager.get_last_error()
        
        اطبع("📋 تفاصيل الخطأ:\n")
        اطبع("   - الكود: ")
        اطبع(error.code)
        اطبع("\n")
        اطبع("   - الرسالة: ")
        اطبع(error.message)
        اطبع("\n")
        
        إذا (error.library_path != "") {
            اطبع("   - المكتبة: ")
            اطبع(error.library_path)
            اطبع("\n")
        }
        
        اطبع("\n")
        
        // مسح الخطأ / Clear error
        manager.clear_error()
        اطبع("🧹 تم مسح الخطأ\n\n")
    }
}

// ============================================================================
// مثال 7: استخدام مكتبة قياسية
// Example 7: Using Standard Library
// ============================================================================

دالة example_standard_library() {
    اطبع("📚 مثال 7: مكتبة قياسية\n")
    اطبع("======================\n\n")
    
    // تحميل مكتبة قياسية بشكل تلقائي / Load standard library automatically
    متغير math_lib = ffi.load_std_library("m")  // libm (math library)
    
    إذا (math_lib) {
        اطبع("✅ تم تحميل مكتبة الرياضيات\n")
        
        // يمكن استدعاء دوال مثل sin، cos، sqrt، إلخ
        // Can call functions like sin, cos, sqrt, etc.
        
        اطبع("📐 مكتبة الرياضيات جاهزة!\n\n")
        
        math_lib.close()
    } وإلا {
        اطبع("⚠️  لم يتم العثور على مكتبة الرياضيات\n\n")
    }
}

// ============================================================================
// الدالة الرئيسية / Main Function
// ============================================================================

دالة البداية() {
    اطبع("🔌 أمثلة نظام FFI - FFI System Examples\n")
    اطبع("========================================\n\n")
    
    اطبع("بسم الله الرحمن الرحيم\n")
    اطبع("الحمد لله رب العالمين\n\n")
    
    // تشغيل جميع الأمثلة / Run all examples
    example_call_c_stdlib()
    example_multiple_params()
    example_callbacks()
    example_library_management()
    example_quick_call()
    example_error_handling()
    example_standard_library()
    
    اطبع("✨ انتهت جميع الأمثلة بنجاح!\n")
    اطبع("الحمد لله رب العالمين\n")
}

// ============================================================================
// ملاحظات مهمة / Important Notes
// ============================================================================

/*
ملاحظات حول FFI / FFI Notes:

1. **الأمان / Safety:**
   - FFI يتجاوز نظام الأنواع / FFI bypasses type system
   - يجب التأكد من صحة التوقيعات / Signatures must be correct
   - أخطاء التوقيع قد تسبب crashes / Signature errors may cause crashes

2. **المنصات / Platforms:**
   - Windows: .dll files
   - Linux: .so files  
   - macOS: .dylib files

3. **Callbacks:**
   - تسمح لـ C باستدعاء كود ص / Allow C to call Sad code
   - تحتاج trampoline code / Require trampoline code
   - محدودة بـ calling conventions / Limited by calling conventions

4. **الأداء / Performance:**
   - FFI calls أبطأ من استدعاءات عادية / FFI calls slower than normal
   - استخدم caching للدوال المستخدمة كثيراً / Use caching for frequently used functions
   - تجنب FFI في حلقات ضيقة / Avoid FFI in tight loops

5. **التوافق / Compatibility:**
   - يدعم C ABI فقط / Supports C ABI only
   - لا يدعم C++ name mangling مباشرة / No direct C++ name mangling support
   - استخدم extern "C" في C++ / Use extern "C" in C++

الحمد لله رب العالمين
*/

