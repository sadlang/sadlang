# مثال — المصفوفات والخرائط
# يوضح: عمليات المصفوفات، الخرائط، الطرق المضمنة

# === المصفوفات ===
متغير الأرقام = [5، 3، 8، 1، 9، 2، 7]

# ترتيب
الأرقام.رتب()
اطبع_سطر("مرتبة: " + الأرقام)

# تصفية: الأرقام الزوجية
متغير زوجية = الأرقام.رشح(لامدا(ن) ارجع ن % 2 == 0 نهاية)
اطبع_سطر("زوجية: " + زوجية)

# تحويل: مضاعفة كل عنصر
متغير مضاعفة = الأرقام.خريطة(لامدا(ن) ارجع ن * 2 نهاية)
اطبع_سطر("مضاعفة: " + مضاعفة)

# مجموع
متغير المجموع = الأرقام.اختزل(لامدا(مج، ن) ارجع مج + ن نهاية، 0)
اطبع_سطر("المجموع: " + المجموع)

# === الخرائط ===
متغير الطالب = {
    "الاسم": "أحمد"،
    "العمر": 20،
    "التخصص": "علوم حاسب"
}

اطبع_سطر("الاسم: " + الطالب.احصل("الاسم"))
اطبع_سطر("المفاتيح: " + الطالب.مفاتيح())

# إضافة مفتاح جديد
الطالب.عيّن("المعدل"، 3.8)
اطبع_سطر("المعدل: " + الطالب.احصل("المعدل"))
