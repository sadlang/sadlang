# ═══════════════════════════════════════════════════════════════
# آلة حاسبة تفاعليّة بلغة ص — تعمل على المفسّر والمترجم (تكافؤ)
# النمط: شجرة ثابتة + تعديل عنصر العرض في مكانه + تحديث_حالة
# ═══════════════════════════════════════════════════════════════
استورد رسومات

# ─── الحالة ───
متغير الشاشة = "0"
متغير الرقم_الأول = 0
متغير العملية = ""
متغير رقم_جديد = صحيح

# ─── عنصر العرض (مرجع عامّ نعدّله في مكانه) ───
متغير عرض_الشاشة = نص_عنصر("0").حجم(44).لون("أبيض")

دالة اعرض()
    عرض_الشاشة.محتوى(الشاشة)
    تحديث_حالة()
نهاية

# ─── منطق الأرقام ───
دالة أدخل_رقم(ر)
    إذا (رقم_جديد أو الشاشة == "0")
        الشاشة = نص(ر)
        رقم_جديد = خطأ
    وإلا
        الشاشة = الشاشة + نص(ر)
    نهاية
    اعرض()
نهاية

# ─── منطق العمليّات ───
دالة أدخل_عملية(ع)
    الرقم_الأول = عشري(الشاشة)
    العملية = ع
    رقم_جديد = صحيح
نهاية

دالة احسب()
    متغير الرقم_الثاني = عشري(الشاشة)
    متغير نتيجة = 0
    إذا (العملية == "+")
        نتيجة = الرقم_الأول + الرقم_الثاني
    وإلا
        إذا (العملية == "-")
            نتيجة = الرقم_الأول - الرقم_الثاني
        وإلا
            إذا (العملية == "×")
                نتيجة = الرقم_الأول * الرقم_الثاني
            وإلا
                إذا (العملية == "÷")
                    إذا (الرقم_الثاني == 0)
                        الشاشة = "خطأ"
                        رقم_جديد = صحيح
                        اعرض()
                        ارجع لاشيء
                    نهاية
                    نتيجة = الرقم_الأول / الرقم_الثاني
                نهاية
            نهاية
        نهاية
    نهاية
    الشاشة = نص(نتيجة)
    رقم_جديد = صحيح
    اعرض()
نهاية

دالة امسح()
    الشاشة = "0"
    العملية = ""
    الرقم_الأول = 0
    رقم_جديد = صحيح
    اعرض()
نهاية

# ─── معالِجات الأزرار (دوال عليا لا تلتقط حالة ⇒ تعمل على المحرّكين) ───
دالة ص0() أدخل_رقم(0) نهاية
دالة ص1() أدخل_رقم(1) نهاية
دالة ص2() أدخل_رقم(2) نهاية
دالة ص3() أدخل_رقم(3) نهاية
دالة ص4() أدخل_رقم(4) نهاية
دالة ص5() أدخل_رقم(5) نهاية
دالة ص6() أدخل_رقم(6) نهاية
دالة ص7() أدخل_رقم(7) نهاية
دالة ص8() أدخل_رقم(8) نهاية
دالة ص9() أدخل_رقم(9) نهاية
دالة ع_جمع() أدخل_عملية("+") نهاية
دالة ع_طرح() أدخل_عملية("-") نهاية
دالة ع_ضرب() أدخل_عملية("×") نهاية
دالة ع_قسمة() أدخل_عملية("÷") نهاية
دالة ع_يساوي() احسب() نهاية
دالة ع_مسح() امسح() نهاية

# ─── مصنع زرّ منسّق ───
دالة زر_حاسبة(نصّ، معالِج، لون_خ)
    ارجع زر(نصّ).عند_النقر(معالِج).لون_خلفية(لون_خ).لون("أبيض").عرض(64).ارتفاع(56).حجم(22).زوايا(8)
نهاية

# ─── بناء الواجهة (شجرة ثابتة تحوي عرض_الشاشة) ───
متغير الواجهة = عمود().أبناء(
    حاوية().ابن(عرض_الشاشة).لون_خلفية("#1E1E1E").حشو(24، 24، 24، 24),
    صف().أبناء(
        زر_حاسبة("7"، ص7، "#424242")، زر_حاسبة("8"، ص8، "#424242")،
        زر_حاسبة("9"، ص9، "#424242")، زر_حاسبة("÷"، ع_قسمة، "#FF9800")
    ),
    صف().أبناء(
        زر_حاسبة("4"، ص4، "#424242")، زر_حاسبة("5"، ص5، "#424242")،
        زر_حاسبة("6"، ص6، "#424242")، زر_حاسبة("×"، ع_ضرب، "#FF9800")
    ),
    صف().أبناء(
        زر_حاسبة("1"، ص1، "#424242")، زر_حاسبة("2"، ص2، "#424242")،
        زر_حاسبة("3"، ص3، "#424242")، زر_حاسبة("-"، ع_طرح، "#FF9800")
    ),
    صف().أبناء(
        زر_حاسبة("C"، ع_مسح، "#F44336")، زر_حاسبة("0"، ص0، "#424242")،
        زر_حاسبة("="، ع_يساوي، "#4CAF50")، زر_حاسبة("+"، ع_جمع، "#FF9800")
    )
).لون_خلفية("#2D2D2D").حشو(12، 12، 12، 12)

اطبع_سطر("جارٍ تشغيل الآلة الحاسبة…")
تشغيل_تطبيق(الواجهة)
