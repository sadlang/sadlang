# مثال — مطابقة الأنماط ومعالجة الأخطاء
# يوضح: طابق/عندما، حاول/امسك/ارمي

# مطابقة أنماط
دالة وصف_يوم(رقم_يوم)
    طابق (رقم_يوم)
        عندما 1:
            ارجع "الأحد"
        عندما 2:
            ارجع "الاثنين"
        عندما 3:
            ارجع "الثلاثاء"
        عندما 4:
            ارجع "الأربعاء"
        عندما 5:
            ارجع "الخميس"
        عندما 6:
            ارجع "الجمعة ☀️"
        عندما 7:
            ارجع "السبت ☀️"
        افتراضي:
            ارجع "يوم غير معروف"
    نهاية
نهاية

# معالجة الأخطاء
دالة قسمة_آمنة(أ، ب)
    إذا (ب == 0)
        ارمي "لا يمكن القسمة على صفر!"
    نهاية
    ارجع أ / ب
نهاية

# البرنامج الرئيسي
لكل ي في [1، 2، 3، 4، 5، 6، 7، 8]
    اطبع_سطر("اليوم " + ي + ": " + وصف_يوم(ي))
نهاية

اطبع_سطر("")

حاول
    متغير نتيجة = قسمة_آمنة(10، 0)
    اطبع_سطر("النتيجة: " + نتيجة)
امسك خطأ
    اطبع_سطر("خطأ: " + خطأ)
نهاية
