صنف محادثة
    متغير العنوان
    متغير العدد
    
    باني(عنوان)
        هذا.العنوان = عنوان
        هذا.العدد = 0
    نهاية
    
    دالة أرسل(نص)
        هذا.العدد = هذا.العدد + 1
        اطبع_سطر("[" + هذا.العنوان + "] " + نص)
    نهاية
نهاية

صنف تطبيق
    متغير الاسم
    
    باني(اسم)
        هذا.الاسم = اسم
    نهاية
    
    دالة أرسل(م، نص)
        م.أرسل(هذا.الاسم + ": " + نص)
    نهاية
نهاية

متغير ت = جديد تطبيق("أحمد")
متغير م = جديد محادثة("العائلة")
ت.أرسل(م، "مرحباً")
