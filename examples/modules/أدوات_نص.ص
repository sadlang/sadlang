صدّر دالة يحتوي(نص، بحث)
    متغير ف = 0
    بينما (ف <= طول(نص) - طول(بحث))
        إذا (نص[ف] == بحث[0])
            متغير تطابق = صحيح
            متغير ج = 1
            بينما (ج < طول(بحث))
                إذا (نص[ف + ج] != بحث[ج])
                    تطابق = خطأ
                    توقف
                نهاية
                ج += 1
            نهاية
            إذا (تطابق)
                ارجع صحيح
            نهاية
        نهاية
        ف += 1
    نهاية
    ارجع خطأ
