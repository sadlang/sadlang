# دوال معالجة النصوص

صدّر دالة عكس_نص(نص)
    متغير النتيجة = ""
    متغير ف = طول(نص) - 1
    بينما (ف >= 0)
        النتيجة += نص[ف]
        ف -= 1
    نهاية
    ارجع النتيجة
