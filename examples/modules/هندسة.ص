# وحدة: هندسة
# دوال لحساب المساحات والمحيطات
# تعتمد على وحدة رياضيات_أساسية

من "رياضيات_أساسية" استورد ضرب

# ثابت محلي
ثابت باي = 3.14159265

صدّر دالة مساحة_مستطيل(عرض، ارتفاع)
    ارجع ضرب(عرض، ارتفاع)
نهاية

صدّر دالة محيط_مستطيل(عرض، ارتفاع)
    ارجع ضرب(2، عرض + ارتفاع)
نهاية

صدّر دالة مساحة_دائرة(نصف_القطر)
    ارجع 3.14159265 * نصف_القطر * نصف_القطر
نهاية

صدّر دالة محيط_دائرة(نصف_القطر)
    ارجع 2 * 3.14159265 * نصف_القطر
نهاية

صدّر دالة مساحة_مثلث(قاعدة، ارتفاع)
    ارجع ضرب(قاعدة، ارتفاع) / 2
نهاية
