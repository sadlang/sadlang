# اختبار 5: مشروع كامل — حاسبة هندسية
# يجمع كل الوحدات في تطبيق واحد

من "رياضيات_أساسية" استورد جمع، قسمة، باي
من "هندسة" استورد مساحة_مستطيل، مساحة_دائرة، مساحة_مثلث
من "أدوات_نص" استورد تكرار

# دالة محلية للتنسيق
دالة خط_فاصل()
    اطبع_سطر(تكرار("═"، 30))
نهاية

# البرنامج الرئيسي
اطبع_سطر("=== الحاسبة الهندسية ===")
خط_فاصل()

# حساب مساحات
متغير م1 = مساحة_مستطيل(8، 5)
متغير م2 = مساحة_دائرة(7)
متغير م3 = مساحة_مثلث(12، 9)

اطبع_سطر("مساحة مستطيل 8×5  = " + م1)
اطبع_سطر("مساحة دائرة نق=7  = " + م2)
اطبع_سطر("مساحة مثلث 12×9  = " + م3)

خط_فاصل()

# المجموع
متغير المجموع = جمع(جمع(م1، م2)، م3)
اطبع_سطر("مجموع المساحات = " + المجموع)

# المتوسط
متغير المتوسط = قسمة(المجموع، 3)
اطبع_سطر("متوسط المساحات = " + المتوسط)

خط_فاصل()
اطبع_سطر("الاختبار نجح ✓")
