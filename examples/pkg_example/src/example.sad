// بسم الله الرحمن الرحيم
/**
 * @file example.sad
 * @description مثال على استخدام مكتبة math-utils
 * Example of using math-utils library
 */

استورد math من "math-utils"؛

دالة main() {
    اطبع("=== بسم الله الرحمن الرحيم ===\n")؛
    اطبع("مثال استخدام مكتبة الأدوات الرياضية\n")؛
    اطبع("Math Utils Library Example\n")؛
    اطبع("================================\n\n")؛
    
    // دوال القوى والجذور
    اطبع("📐 دوال القوى والجذور - Power & Root Functions:")؛
    اطبع("2^10 = " + math.power(2، 10))؛
    اطبع("√144 = " + math.sqrt(144))؛
    اطبع("∛27 = " + math.cbrt(27))؛
    اطبع("")؛
    
    // دوال هندسية
    اطبع("🔵 دوال هندسية - Geometric Functions:")؛
    متغير radius = 5؛
    اطبع("مساحة دائرة نصف قطرها " + radius + " = " + math.circle_area(radius))؛
    اطبع("محيط دائرة نصف قطرها " + radius + " = " + math.circle_circumference(radius))؛
    اطبع("مساحة مستطيل 10×5 = " + math.rectangle_area(10، 5))؛
    اطبع("مساحة مثلث قاعدته 8 وارتفاعه 6 = " + math.triangle_area(8، 6))؛
    اطبع("")؛
    
    // دوال إحصائية
    اطبع("📊 دوال إحصائية - Statistical Functions:")؛
    متغير numbers = [10، 20، 30، 40، 50]؛
    اطبع("الأرقام: " + numbers)؛
    اطبع("المجموع = " + math.sum(numbers))؛
    اطبع("المتوسط = " + math.average(numbers))؛
    اطبع("الأصغر = " + math.min(numbers))؛
    اطبع("الأكبر = " + math.max(numbers))؛
    اطبع("")؛
    
    // دوال متقدمة
    اطبع("🔢 دوال متقدمة - Advanced Functions:")؛
    اطبع("|(-15)| = " + math.abs(-15))؛
    اطبع("5! = " + math.factorial(5))؛
    اطبع("هل 17 عدد أولي؟ " + math.is_prime(17))؛
    اطبع("هل 20 عدد أولي؟ " + math.is_prime(20))؛
    اطبع("")؛
    
    اطبع("================================")؛
    اطبع("الحمد لله رب العالمين")؛
}

// تشغيل البرنامج
main()؛
