/**
 * @file phase14_test.sad
 * @brief اختبار المرحلة 14: تحسين البايت كود
 * @brief Phase 14 Test: Bytecode Optimization
 * 
 * @description
 * (AR) يختبر تحسينات البايت كود التي تم تنفيذها:
 *      - إزالة الكود الميت (Dead Code Elimination)
 *      - تحسينات Peephole (أنماط التحسين الصغيرة)
 *      - دمج التعليمات المتكررة (Duplicate Merging)
 * 
 * (EN) Tests bytecode optimizations implemented:
 *      - Dead Code Elimination
 *      - Peephole Optimizations
 *      - Duplicate Instruction Merging
 * 
 * @author Sad Language Team
 * @date December 8, 2025
 * @version 1.0
 */

// ============================================================================
// Dead Code Elimination Tests - اختبارات إزالة الكود الميت
// ============================================================================

/**
 * @test Test 1: Unreachable code after return
 * @description كود غير قابل للوصول بعد return
 */
دالة اختبار_كود_ميت_1():
    اطبع("دالة تحتوي على كود ميت")
    أرجع 42
    
    // (AR) هذا الكود لن يُنفذ أبداً - يجب إزالته
    // (EN) This code will never execute - should be removed
    اطبع("هذا الكود ميت!")
    متغير ميت = 100
    أرجع ميت


/**
 * @test Test 2: Unreachable branch
 * @description فرع غير قابل للوصول
 */
دالة اختبار_كود_ميت_2():
    اذا(صحيح):
        اطبع("هذا الفرع دائماً يُنفذ")
        أرجع 1
    والا:
        // (AR) هذا الفرع لن يُنفذ أبداً - كود ميت
        // (EN) This branch will never execute - dead code
        اطبع("كود ميت في الفرع والا")
        أرجع 2


/**
 * @test Test 3: Multiple unreachable returns
 * @description عدة returns غير قابلة للوصول
 */
دالة اختبار_كود_ميت_3():
    متغير س = 10
    اذا(س > 5):
        أرجع س
    والا:
        أرجع 0
    
    // (AR) كل ما بعد هذا كود ميت
    // (EN) Everything after this is dead code
    اطبع("لن يطبع")
    أرجع -1


// ============================================================================
// Peephole Optimization Tests - اختبارات تحسينات Peephole
// ============================================================================

/**
 * @test Test 4: Arithmetic identity optimizations
 * @description تحسينات عمليات حسابية بديهية
 */
دالة اختبار_تحسين_حسابي():
    // (AR) إضافة 0 - يجب إزالتها
    // (EN) Adding 0 - should be eliminated
    متغير س = 5
    س = س + 0  // تحسين: س = س
    
    // (AR) طرح 0 - يجب إزالته
    // (EN) Subtracting 0 - should be eliminated
    متغير ص = 10
    ص = ص - 0  // تحسين: ص = ص
    
    // (AR) ضرب في 1 - يجب إزالته
    // (EN) Multiplying by 1 - should be eliminated
    متغير ز = 7
    ز = ز * 1  // تحسين: ز = ز
    
    اطبع("س = " + نص(س))
    اطبع("ص = " + نص(ص))
    اطبع("ز = " + نص(ز))
    
    أرجع س + ص + ز


/**
 * @test Test 5: Double negation elimination
 * @description إزالة النفي المزدوج
 */
دالة اختبار_نفي_مزدوج():
    متغير شرط = صحيح
    
    // (AR) نفي مزدوج - يجب إزالته
    // (EN) Double negation - should be eliminated
    متغير نتيجة = لا(لا(شرط))  // تحسين: نتيجة = شرط
    
    اطبع("النتيجة: " + نص(نتيجة))
    أرجع نتيجة


/**
 * @test Test 6: Constant folding candidates
 * @description مرشحات طي الثوابت
 */
دالة اختبار_طي_ثوابت():
    // (AR) عمليات على ثوابت - يمكن حسابها في وقت الترجمة
    // (EN) Operations on constants - can be computed at compile time
    متغير نتيجة1 = 5 + 3      // تحسين: 8
    متغير نتيجة2 = 10 * 2     // تحسين: 20
    متغير نتيجة3 = 100 / 4    // تحسين: 25
    
    اطبع("نتيجة1 = " + نص(نتيجة1))
    اطبع("نتيجة2 = " + نص(نتيجة2))
    اطبع("نتيجة3 = " + نص(نتيجة3))
    
    أرجع نتيجة1 + نتيجة2 + نتيجة3


/**
 * @test Test 7: Jump to next instruction elimination
 * @description إزالة قفزة إلى التعليمة التالية
 */
دالة اختبار_قفزة_تالية():
    متغير س = 0
    
    // (AR) في بعض الحالات، المترجم قد يولد قفزة للتعليمة التالية
    // (EN) In some cases, compiler may generate jump to next instruction
    // هذا يحدث في حالات التحسين الخاطئ
    // This happens in cases of incorrect optimization
    
    لكل(متغير ع من 0 الى 5):
        س = س + ع
    
    أرجع س


// ============================================================================
// Duplicate Instruction Tests - اختبارات التعليمات المتكررة
// ============================================================================

/**
 * @test Test 8: Repeated calculation
 * @description حساب متكرر
 */
دالة اختبار_حساب_متكرر(س، ص):
    // (AR) نفس الحساب متكرر - يمكن دمجه
    // (EN) Same calculation repeated - can be merged
    متغير نتيجة1 = س * 2 + ص
    متغير نتيجة2 = س * 2 + ص  // مكرر
    متغير نتيجة3 = س * 2 + ص  // مكرر
    
    أرجع نتيجة1 + نتيجة2 + نتيجة3


/**
 * @test Test 9: Common subexpression
 * @description تعبير فرعي مشترك
 */
دالة اختبار_تعبير_مشترك(س):
    // (AR) تعبير فرعي مشترك - يجب حسابه مرة واحدة
    // (EN) Common subexpression - should be computed once
    متغير أ = س * س + 10
    متغير ب = س * س + 20  // س * س مكرر
    متغير ج = س * س + 30  // س * س مكرر
    
    أرجع أ + ب + ج


/**
 * @test Test 10: Loop invariant code
 * @description كود ثابت في الحلقة
 */
دالة اختبار_كود_ثابت_حلقة():
    متغير مجموع = 0
    متغير عامل = 5
    
    // (AR) عامل * 2 ثابت في الحلقة - يجب نقله للخارج
    // (EN) factor * 2 is loop invariant - should be hoisted
    لكل(متغير ع من 0 الى 10):
        مجموع = مجموع + (عامل * 2)  // عامل * 2 ثابت
    
    أرجع مجموع


// ============================================================================
// Complex Optimization Tests - اختبارات تحسينات معقدة
// ============================================================================

/**
 * @test Test 11: Combined optimizations
 * @description تحسينات مدمجة
 */
دالة اختبار_تحسينات_مدمجة():
    متغير س = 10
    
    // (AR) عدة أنماط تحسين في دالة واحدة
    // (EN) Multiple optimization patterns in one function
    
    // نمط 1: إضافة 0
    س = س + 0
    
    // نمط 2: نفي مزدوج
    متغير شرط = لا(لا(س > 5))
    
    اذا(شرط):
        أرجع س * 1  // نمط 3: ضرب في 1
    
    // كود ميت
    أرجع -1


/**
 * @test Test 12: Nested control flow
 * @description تدفق تحكم متداخل
 */
دالة اختبار_تدفق_متداخل(س):
    اذا(س > 0):
        اذا(س > 10):
            أرجع "كبير"
        والا:
            أرجع "متوسط"
    والا:
        اذا(س < -10):
            أرجع "صغير جداً"
            اطبع("كود ميت")  // لن يُنفذ
        والا:
            أرجع "صغير"
    
    // كود ميت - كل الفروع تُرجع
    أرجع "افتراضي"


/**
 * @test Test 13: Redundant assignments
 * @description إسنادات زائدة
 */
دالة اختبار_اسنادات_زائدة():
    متغير س = 5
    س = 10      // يستبدل القيمة السابقة
    س = 15      // يستبدل القيمة السابقة
    س = 20      // القيمة النهائية المستخدمة فقط
    
    اطبع("س = " + نص(س))
    أرجع س


// ============================================================================
// Benchmark and Statistics - معايير وإحصائيات
// ============================================================================

/**
 * @test Test 14: Optimization effectiveness
 * @description فعالية التحسين
 */
دالة قياس_تحسين():
    متغير بدون_تحسين = 0
    متغير مع_تحسين = 0
    
    // (AR) محاكاة كود بدون تحسين
    // (EN) Simulate unoptimized code
    لكل(متغير ع من 0 الى 1000):
        بدون_تحسين = بدون_تحسين + 0  // سيُحسّن
        بدون_تحسين = بدون_تحسين * 1  // سيُحسّن
    
    // (AR) كود محسّن
    // (EN) Optimized code
    لكل(متغير ع من 0 الى 1000):
        مع_تحسين = مع_تحسين + ع
    
    اطبع("اكتمل القياس")
    أرجع مع_تحسين


/**
 * @test Test 15: Real-world example
 * @description مثال واقعي
 */
دالة حساب_فيبوناتشي(ن):
    اذا(ن <= 1):
        أرجع ن
    
    متغير سابق = 0
    متغير حالي = 1
    
    لكل(متغير ع من 2 الى ن):
        متغير تالي = سابق + حالي
        سابق = حالي
        حالي = تالي
    
    أرجع حالي


