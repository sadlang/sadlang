# مثال — الشروط والحلقات
# يوضح: إذا/وإلا، بينما، لكل

# دالة لتحديد فئة العمر
دالة فئة_عمر(عمر)
    إذا (عمر < 13)
        ارجع "طفل"
    وإلا
        إذا (عمر < 20)
            ارجع "مراهق"
        وإلا
            ارجع "بالغ"
        نهاية
    نهاية
نهاية

# حلقة بينما
متغير عداد = 1
بينما (عداد <= 5)
    اطبع_سطر("العدد: " + عداد)
    عداد = عداد + 1
نهاية

# حلقة لكل
متغير الأعمار = [8، 15، 25، 12، 30]
لكل عمر في الأعمار
    اطبع_سطر(عمر + " سنة → " + فئة_عمر(عمر))
نهاية
