# اختبار الوسائط المسمّاة (بنمط Flutter)
# Test named arguments (Flutter-like style)

# ─── اختبار 1: دالة عادية مع وسائط مسمّاة ───
دالة معلومات(الاسم، العمر، المدينة)
    اطبع_سطر("الاسم: " + الاسم)
    اطبع_سطر("العمر: " + العمر)
    اطبع_سطر("المدينة: " + المدينة)
نهاية

# استدعاء عادي (موضعي)
اطبع_سطر("=== اختبار 1: استدعاء عادي ===")
معلومات("أحمد"، 25، "الرياض")

# ─── اختبار 2: الوسائط المسمّاة مع _autoChildren ───
# هذا يختبر أن الوسائط المسمّاة تُحوّل إلى أزواج اسم/قيمة
اطبع_سطر("")
اطبع_سطر("=== اختبار 2: وسائط مسمّاة بنمط Flutter ===")

# دالة تطبع الوسائط كما تصلها
دالة اطبع_وسائط(المعاملات)
    اطبع_سطر("عدد المعاملات: " + طول(المعاملات))
    لكل م في المعاملات
        اطبع_سطر("  - " + م)
    نهاية
نهاية

# ─── اختبار 3: خليط وسائط موضعية ومسمّاة ───
اطبع_سطر("")
اطبع_سطر("=== اختبار 3: خليط موضعي ومسمّى ===")

دالة عرض(أ، ب، ج، د، هـ، و)
    اطبع_سطر("أ=" + أ + " ب=" + ب + " ج=" + ج + " د=" + د + " هـ=" + هـ + " و=" + و)
نهاية

# (أ=1, ب=2) ثم الوسائط المسمّاة تُلحق كأزواج: ("تباعد", 10, "خلفية", "ابيض")
# النتيجة: عرض(1, 2, "تباعد", 10, "خلفية", "ابيض")
عرض(1، 2، تباعد: 10، خلفية: "ابيض")

# ─── اختبار 4: التأكد من أن الصيغة القديمة ما زالت تعمل ───
اطبع_سطر("")
اطبع_سطر("=== اختبار 4: صيغة قديمة ===")
معلومات("سارة"، 30، "جدة")

