صنف تطبيق
    متغير المستخدم
    
    باني(اسم)
        هذا.المستخدم = اسم
    نهاية
    
    دالة أنشئ_محادثة(عنوان)
        ارجع جديد محادثة(عنوان)
    نهاية
    
    دالة أرسل(م، نص)
        م.أرسل(هذا.المستخدم، نص)
    نهاية
نهاية

