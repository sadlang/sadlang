    متغير العنوان
    
    باني(عنوان)
        هذا.العنوان = عنوان
    نهاية
    
    دالة أرسل(مرسل، نص)
        اطبع_سطر("[" + هذا.العنوان + "] " + مرسل + ": " + نص)
    نهاية
