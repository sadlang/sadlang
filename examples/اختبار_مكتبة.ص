# اختبار سريع لمكتبة الرسومات — بدون SDL2
استورد * من رسومات.واجهات

# اختبار إنشاء العناصر
متغير ن = جديد نص("مرحباً!", حجم_الخط: 24)
اطبع_سطر("نوع النص: " + ن._نوع)
اطبع_سطر("محتوى: " + ن.محتوى)
اطبع_سطر("حجم الخط: " + ن.حجم_الخط)

متغير ز = جديد زر("اضغط هنا", لون_خلفية: "#4CAF50")
اطبع_سطر("نوع الزر: " + ز._نوع)
اطبع_سطر("نص الزر: " + ز.نص_الزر)
اطبع_سطر("لون الخلفية: " + ز.لون_خلفية)

متغير ع = جديد عمود([جديد نص("سطر 1"), جديد نص("سطر 2")], تباعد: 10)
اطبع_سطر("نوع العمود: " + ع._نوع)
اطبع_سطر("عدد الأبناء: " + طول(ع.أبناء))
اطبع_سطر("تباعد: " + ع.تباعد)

متغير ب = جديد بطاقة(ابن: جديد نص("بطاقة"), ارتفاع_الظل: 4)
اطبع_سطر("نوع البطاقة: " + ب._نوع)
اطبع_سطر("ارتفاع الظل: " + ب.ارتفاع_الظل)

اطبع_سطر("─── لون أحمر: " + أحمر)
اطبع_سطر("─── كل الاختبارات نجحت! ───")
