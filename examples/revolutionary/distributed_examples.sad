/**
 * ===================================================================================
 *  مثال شامل: الحوسبة الموزعة - Distributed Computing Example
 * ===================================================================================
 * 
 *  يوضح هذا المثال كيفية استخدام مميزات الحوسبة الموزعة في لغة ص
 * 
 * ===================================================================================
 */

// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ١: مهمة موزعة بسيطة
// ═══════════════════════════════════════════════════════════════════════════════════

استورد توزيع_ص/عنقود
استورد توزيع_ص/مهام

// الاتصال بالعنقود
عنقود = عنقود_حوسبة()
عنقود.اتصل("cluster://master.local:7000")

اطبع("🖥️ معلومات العنقود:")
اطبع("  العقد المتاحة: " + عنقود.عدد_العقد())
اطبع("  الأنوية الكلية: " + عنقود.إجمالي_الأنوية())
اطبع("  الذاكرة المتاحة: " + عنقود.الذاكرة_المتاحة() + " GB")

// تعريف مهمة بسيطة
@موزع
دالة احسب_مربع(عدد: عدد_صحيح) -> عدد_صحيح ثم
    أرجع عدد * عدد
نهاية

// تنفيذ على البيانات
أعداد = نطاق(١، ١٠٠٠٠٠١)
نتائج = عنقود.خريطة(أعداد، احسب_مربع)

مجموع = عنقود.اختزل(نتائج، دالة(أ، ب) { أرجع أ + ب })
اطبع("مجموع المربعات: " + مجموع)


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٢: MapReduce
// ═══════════════════════════════════════════════════════════════════════════════════

استورد توزيع_ص/mapreduce

// عد الكلمات في ملفات كبيرة
@mapper
دالة عدّ_كلمات_mapper(سطر: نص) -> قائمة<زوج<نص، عدد_صحيح>> ثم
    نتائج = قائمة_جديدة()
    كلمات = سطر.قسّم(" ")
    
    لكل كلمة في كلمات افعل
        كلمة_نظيفة = كلمة.صغّر().أزل_علامات()
        إذا كلمة_نظيفة.الطول() > ٠ ثم
            نتائج.أضف(زوج(كلمة_نظيفة، ١))
        نهاية
    نهاية
    
    أرجع نتائج
نهاية

@reducer
دالة عدّ_كلمات_reducer(مفتاح: نص، قيم: قائمة<عدد_صحيح>) -> زوج<نص، عدد_صحيح> ثم
    مجموع = ٠
    لكل قيمة في قيم افعل
        مجموع += قيمة
    نهاية
    أرجع زوج(مفتاح، مجموع)
نهاية

// تنفيذ MapReduce
مهمة = مهمة_MapReduce()
مهمة.ضبط_مدخلات("hdfs://data/books/*.txt")
مهمة.ضبط_مخرجات("hdfs://results/word_count")
مهمة.ضبط_mapper(عدّ_كلمات_mapper)
مهمة.ضبط_reducer(عدّ_كلمات_reducer)

نتيجة = عنقود.نفّذ(مهمة)
اطبع("تم عد الكلمات. عدد الكلمات الفريدة: " + نتيجة.عدد_المفاتيح())


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٣: الذاكرة الموزعة
// ═══════════════════════════════════════════════════════════════════════════════════

استورد توزيع_ص/ذاكرة

// إنشاء كائن موزع
@موزع
صنف مصفوفة_موزعة (
    بيانات: قائمة<عشري>
    أبعاد: زوج<عدد_صحيح، عدد_صحيح>
    
    دالة إنشاء(صفوف: عدد_صحيح، أعمدة: عدد_صحيح) ثم
        أبعاد = زوج(صفوف، أعمدة)
        بيانات = قائمة_جديدة(صفوف * أعمدة، ٠.٠)
    نهاية
    
    @موزع
    دالة ضرب(أخرى: مصفوفة_موزعة) -> مصفوفة_موزعة ثم
        تحقق(أبعاد.ثاني == أخرى.أبعاد.أول، "أبعاد غير متوافقة")
        
        نتيجة = مصفوفة_موزعة(أبعاد.أول، أخرى.أبعاد.ثاني)
        
        // التوزيع على العقد
        لكل_موزع ص في نطاق(أبعاد.أول) افعل
            لكل ع في نطاق(أخرى.أبعاد.ثاني) افعل
                مجموع = ٠.٠
                لكل ك في نطاق(أبعاد.ثاني) افعل
                    مجموع += هذا[ص، ك] * أخرى[ك، ع]
                نهاية
                نتيجة[ص، ع] = مجموع
            نهاية
        نهاية
        
        أرجع نتيجة
    نهاية
)

// استخدام المصفوفة الموزعة
م١ = مصفوفة_موزعة(١٠٠٠، ١٠٠٠)
م٢ = مصفوفة_موزعة(١٠٠٠، ١٠٠٠)

// ملء بقيم عشوائية (موزع)
م١.ملء_عشوائي()
م٢.ملء_عشوائي()

// الضرب الموزع
نتيجة = م١.ضرب(م٢)
اطبع("تم ضرب المصفوفات")


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٤: الرسائل والتنسيق
// ═══════════════════════════════════════════════════════════════════════════════════

استورد توزيع_ص/رسائل

// إنشاء ممثل (Actor)
@ممثل
صنف عامل_حساب (
    معرف: نص
    
    دالة إنشاء(id: نص) ثم
        معرف = id
    نهاية
    
    @رسالة
    دالة احسب(مهمة: نص، بيانات: قائمة<عشري>) -> عشري ثم
        إذا مهمة == "مجموع" ثم
            أرجع بيانات.مجموع()
        أو_إذا مهمة == "متوسط" ثم
            أرجع بيانات.مجموع() / بيانات.الطول()
        أو_إذا مهمة == "أقصى" ثم
            أرجع بيانات.أقصى()
        نهاية
        أرجع ٠.٠
    نهاية
)

// إنشاء نظام الممثلين
نظام = نظام_ممثلين()
نظام.ابدأ()

// إنشاء عمال
عمال = قائمة_جديدة()
لكل ن في نطاق(١٠) افعل
    عامل = نظام.أنشئ_ممثل(عامل_حساب، "عامل_" + ن)
    عمال.أضف(عامل)
نهاية

// توزيع المهام
بيانات = قائمة_أعداد_عشوائية(١٠٠٠٠٠٠)
أجزاء = بيانات.قسّم(١٠)

مستقبلات = قائمة_جديدة()
لكل ترتيب، جزء في أجزاء.تعداد() افعل
    مستقبل = عمال[ترتيب].أرسل("احسب"، "مجموع"، جزء)
    مستقبلات.أضف(مستقبل)
نهاية

// جمع النتائج
مجموع_كلي = ٠.٠
لكل مستقبل في مستقبلات افعل
    مجموع_كلي += مستقبل.انتظر()
نهاية

اطبع("المجموع الكلي: " + مجموع_كلي)


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٥: التدفق الموزع
// ═══════════════════════════════════════════════════════════════════════════════════

استورد توزيع_ص/تدفق

// إنشاء مصدر تدفق
مصدر = مصدر_كافكا("broker1:9092,broker2:9092")
مصدر.اشترك("أحداث_المستخدم")

// معالجة التدفق
تدفق = تدفق_البيانات(مصدر)
    .خريطة(دالة(حدث) {
        // تحويل JSON
        أرجع من_json(حدث.القيمة())
    })
    .مرشح(دالة(حدث) {
        // تصفية أحداث الشراء فقط
        أرجع حدث.النوع == "شراء"
    })
    .نافذة_زمنية(٦٠ * ثانية)  // نافذة دقيقة واحدة
    .تجميع_بواسطة(دالة(حدث) {
        أرجع حدث.المنتج
    })
    .اختزال(دالة(مجموعة) {
        أرجع {
            المنتج: مجموعة.المفتاح,
            المبيعات: مجموعة.القيم.مجموع(دالة(ح) { أرجع ح.المبلغ }),
            العدد: مجموعة.القيم.الطول()
        }
    })

// إرسال النتائج
حوض = حوض_كافكا("broker1:9092")
حوض.ضبط_موضوع("مبيعات_دقيقة")

تدفق.إلى(حوض)

// بدء المعالجة
تدفق.ابدأ()
اطبع("بدأت معالجة التدفق...")


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٦: التخزين الموزع
// ═══════════════════════════════════════════════════════════════════════════════════

استورد توزيع_ص/تخزين

// الاتصال بقاعدة بيانات موزعة
قاعدة = قاعدة_موزعة()
قاعدة.اتصل([
    "node1.db.local:5432",
    "node2.db.local:5432",
    "node3.db.local:5432"
])

// إنشاء جدول موزع
@موزع
@مقسم_بواسطة("المنطقة")
صنف طلب (
    @مفتاح معرف: نص
    المنطقة: نص
    المستخدم: نص
    المنتجات: قائمة<نص>
    المبلغ: عشري
    الحالة: نص
    التاريخ: تاريخ_وقت
)

قاعدة.سجّل_نموذج(طلب)

// إدراج بيانات
طلب_جديد = طلب {
    معرف: UUID.جديد()،
    المنطقة: "الشرق_الأوسط"،
    المستخدم: "user123"،
    المنتجات: ["منتج_١"، "منتج_٢"]،
    المبلغ: ١٥٠.٠٠،
    الحالة: "جديد"،
    التاريخ: الآن()
}

قاعدة.أدرج(طلب_جديد)

// استعلام موزع
نتائج = قاعدة.استعلم(طلب)
    .حيث(طلب.المنطقة == "الشرق_الأوسط")
    .و(طلب.المبلغ > ١٠٠)
    .رتّب_بـ(طلب.التاريخ، تنازلي: صحيح)
    .حدّد(١٠٠)
    .نفّذ()

اطبع("عدد الطلبات: " + نتائج.الطول())

// تجميع موزع
إحصائيات = قاعدة.استعلم(طلب)
    .جمّع_بواسطة(طلب.المنطقة)
    .احسب({
        العدد: عدد()،
        المجموع: مجموع(طلب.المبلغ)،
        المتوسط: متوسط(طلب.المبلغ)
    })
    .نفّذ()

لكل منطقة في إحصائيات افعل
    اطبع(منطقة.المنطقة + ": " + 
         منطقة.العدد + " طلب، " +
         "المجموع: " + منطقة.المجموع)
نهاية
