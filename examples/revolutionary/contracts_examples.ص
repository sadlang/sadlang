// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ١: عقد تخزين بسيط
// ═══════════════════════════════════════════════════════════════════════════════════

استورد عقود_ص/عقد

@عقد
صنف عقد_تخزين (
    // المتغيرات المخزنة على السلسلة
    @مخزن قيمة: عدد_صحيح = ٠
    @مخزن مالك: عنوان
    
    // حدث عند تغيير القيمة
    @حدث تم_التخزين(قيمة_جديدة: عدد_صحيح)
    
    // المنشئ
    دالة إنشاء() ثم
        مالك = الرسالة.المرسل
    نهاية
    
    // تخزين قيمة جديدة
    @عام
    دالة خزّن(قيمة_جديدة: عدد_صحيح) ثم
        تحقق(الرسالة.المرسل == مالك، "فقط المالك يمكنه التخزين")
        قيمة = قيمة_جديدة
        أطلق تم_التخزين(قيمة_جديدة)
    نهاية
    
    // قراءة القيمة
    @عام
    @قراءة
    دالة اقرأ() -> عدد_صحيح ثم
        أرجع قيمة
    نهاية
)


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٢: عملة رقمية (Token)
// ═══════════════════════════════════════════════════════════════════════════════════

@عقد
@ERC20
صنف عملة_ص (
    @مخزن اسم_العملة: نص = "عملة ص"
    @مخزن رمز: نص = "ص"
    @مخزن كسور: عدد_صحيح = ١٨
    @مخزن إجمالي_العرض: عدد_صحيح
    @مخزن أرصدة: قاموس<عنوان، عدد_صحيح>
    @مخزن مخولون: قاموس<عنوان، قاموس<عنوان، عدد_صحيح>>
    
    @حدث تحويل(من: عنوان، إلى: عنوان، كمية: عدد_صحيح)
    @حدث موافقة(مالك: عنوان، مخول: عنوان، كمية: عدد_صحيح)
    
    دالة إنشاء(عرض_أولي: عدد_صحيح) ثم
        إجمالي_العرض = عرض_أولي * (١٠ ** كسور)
        أرصدة[الرسالة.المرسل] = إجمالي_العرض
        أطلق تحويل(عنوان_صفر، الرسالة.المرسل، إجمالي_العرض)
    نهاية
    
    @عام
    @قراءة
    دالة رصيد(حساب: عنوان) -> عدد_صحيح ثم
        أرجع أرصدة[حساب]
    نهاية
    
    @عام
    دالة حوّل(إلى: عنوان، كمية: عدد_صحيح) -> منطقي ثم
        تحقق(أرصدة[الرسالة.المرسل] >= كمية، "رصيد غير كافٍ")
        تحقق(إلى != عنوان_صفر، "لا يمكن التحويل للعنوان الصفري")
        
        أرصدة[الرسالة.المرسل] -= كمية
        أرصدة[إلى] += كمية
        
        أطلق تحويل(الرسالة.المرسل، إلى، كمية)
        أرجع صحيح
    نهاية
    
    @عام
    دالة وافق(مخول: عنوان، كمية: عدد_صحيح) -> منطقي ثم
        مخولون[الرسالة.المرسل][مخول] = كمية
        أطلق موافقة(الرسالة.المرسل، مخول، كمية)
        أرجع صحيح
    نهاية
    
    @عام
    دالة حوّل_من(من: عنوان، إلى: عنوان، كمية: عدد_صحيح) -> منطقي ثم
        تحقق(مخولون[من][الرسالة.المرسل] >= كمية، "غير مخول")
        تحقق(أرصدة[من] >= كمية، "رصيد غير كافٍ")
        
        مخولون[من][الرسالة.المرسل] -= كمية
        أرصدة[من] -= كمية
        أرصدة[إلى] += كمية
        
        أطلق تحويل(من، إلى، كمية)
        أرجع صحيح
    نهاية
)


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٣: NFT (رمز غير قابل للاستبدال)
// ═══════════════════════════════════════════════════════════════════════════════════

@عقد
@ERC721
صنف مجموعة_NFT (
    @مخزن اسم_المجموعة: نص = "فن ص"
    @مخزن رمز_المجموعة: نص = "صART"
    @مخزن ملاك: قاموس<عدد_صحيح، عنوان>
    @مخزن بيانات_وصفية: قاموس<عدد_صحيح، نص>
    @مخزن عداد_الرموز: عدد_صحيح = ٠
    @مخزن مدير: عنوان
    
    @حدث تم_السك(إلى: عنوان، معرف: عدد_صحيح)
    @حدث تم_النقل(من: عنوان، إلى: عنوان، معرف: عدد_صحيح)
    
    دالة إنشاء() ثم
        مدير = الرسالة.المرسل
    نهاية
    
    @عام
    دالة اسكُ(إلى: عنوان، رابط_بيانات: نص) -> عدد_صحيح ثم
        تحقق(الرسالة.المرسل == مدير، "فقط المدير يمكنه السك")
        
        عداد_الرموز += ١
        معرف = عداد_الرموز
        
        ملاك[معرف] = إلى
        بيانات_وصفية[معرف] = رابط_بيانات
        
        أطلق تم_السك(إلى، معرف)
        أرجع معرف
    نهاية
    
    @عام
    @قراءة
    دالة مالك_الرمز(معرف: عدد_صحيح) -> عنوان ثم
        تحقق(ملاك[معرف] != عنوان_صفر، "الرمز غير موجود")
        أرجع ملاك[معرف]
    نهاية
    
    @عام
    دالة انقل(إلى: عنوان، معرف: عدد_صحيح) ثم
        تحقق(ملاك[معرف] == الرسالة.المرسل، "لست مالك الرمز")
        
        من = ملاك[معرف]
        ملاك[معرف] = إلى
        
        أطلق تم_النقل(من، إلى، معرف)
    نهاية
)


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٤: سوق لامركزي
// ═══════════════════════════════════════════════════════════════════════════════════

@عقد
صنف سوق_NFT (
    بنية عرض (
        بائع: عنوان
        سعر: عدد_صحيح
        نشط: منطقي
    )
    
    @مخزن عقد_NFT: عنوان
    @مخزن عروض: قاموس<عدد_صحيح، عرض>
    @مخزن عمولة: عدد_صحيح = ٢٥٠  // 2.5%
    @مخزن مالك_السوق: عنوان
    
    @حدث تم_العرض(معرف: عدد_صحيح، بائع: عنوان، سعر: عدد_صحيح)
    @حدث تم_البيع(معرف: عدد_صحيح، بائع: عنوان، مشتري: عنوان، سعر: عدد_صحيح)
    @حدث تم_الإلغاء(معرف: عدد_صحيح)
    
    دالة إنشاء(عنوان_nft: عنوان) ثم
        عقد_NFT = عنوان_nft
        مالك_السوق = الرسالة.المرسل
    نهاية
    
    @عام
    دالة اعرض(معرف: عدد_صحيح، سعر: عدد_صحيح) ثم
        nft = مجموعة_NFT(عقد_NFT)
        تحقق(nft.مالك_الرمز(معرف) == الرسالة.المرسل، "لست المالك")
        
        عروض[معرف] = عرض {
            بائع: الرسالة.المرسل،
            سعر: سعر،
            نشط: صحيح
        }
        
        أطلق تم_العرض(معرف، الرسالة.المرسل، سعر)
    نهاية
    
    @عام
    @مدفوع
    دالة اشترِ(معرف: عدد_صحيح) ثم
        ع = عروض[معرف]
        تحقق(ع.نشط، "العرض غير نشط")
        تحقق(الرسالة.القيمة >= ع.سعر، "المبلغ غير كافٍ")
        
        // حساب العمولة
        مبلغ_عمولة = ع.سعر * عمولة / ١٠٠٠٠
        مبلغ_بائع = ع.سعر - مبلغ_عمولة
        
        // نقل NFT
        nft = مجموعة_NFT(عقد_NFT)
        nft.انقل_من(ع.بائع، الرسالة.المرسل، معرف)
        
        // نقل الأموال
        أرسل_أموال(ع.بائع، مبلغ_بائع)
        أرسل_أموال(مالك_السوق، مبلغ_عمولة)
        
        عروض[معرف].نشط = خطأ
        
        أطلق تم_البيع(معرف، ع.بائع، الرسالة.المرسل، ع.سعر)
    نهاية
    
    @عام
    دالة ألغِ_العرض(معرف: عدد_صحيح) ثم
        تحقق(عروض[معرف].بائع == الرسالة.المرسل، "لست البائع")
        عروض[معرف].نشط = خطأ
        أطلق تم_الإلغاء(معرف)
    نهاية
)


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٥: منظمة لامركزية (DAO)
// ═══════════════════════════════════════════════════════════════════════════════════

@عقد
صنف منظمة_ص (
    بنية اقتراح (
        مقدم: عنوان
        وصف: نص
        قيمة: عدد_صحيح
        مستهدف: عنوان
        بيانات: بايتات
        أصوات_مع: عدد_صحيح
        أصوات_ضد: عدد_صحيح
        منتهي: منطقي
        منفذ: منطقي
        موعد_انتهاء: عدد_صحيح
    )
    
    @مخزن عملة_الحوكمة: عنوان
    @مخزن اقتراحات: قاموس<عدد_صحيح، اقتراح>
    @مخزن عداد: عدد_صحيح = ٠
    @مخزن صوّت: قاموس<عدد_صحيح، قاموس<عنوان، منطقي>>
    @مخزن فترة_تصويت: عدد_صحيح = ٧ * ٢٤ * ٦٠ * ٦٠  // أسبوع
    @مخزن نصاب: عدد_صحيح = ١٠  // 10% للنصاب
    
    @حدث اقتراح_جديد(معرف: عدد_صحيح، مقدم: عنوان)
    @حدث تم_التصويت(معرف: عدد_صحيح، ناخب: عنوان، مع: منطقي، وزن: عدد_صحيح)
    @حدث تم_التنفيذ(معرف: عدد_صحيح)
    
    دالة إنشاء(عنوان_عملة: عنوان) ثم
        عملة_الحوكمة = عنوان_عملة
    نهاية
    
    @عام
    دالة قدّم_اقتراح(
        وصف: نص،
        مستهدف: عنوان،
        قيمة: عدد_صحيح،
        بيانات: بايتات
    ) -> عدد_صحيح ثم
        عملة = عملة_ص(عملة_الحوكمة)
        تحقق(عملة.رصيد(الرسالة.المرسل) > ٠، "يجب امتلاك عملات")
        
        عداد += ١
        اقتراحات[عداد] = اقتراح {
            مقدم: الرسالة.المرسل،
            وصف: وصف،
            قيمة: قيمة،
            مستهدف: مستهدف،
            بيانات: بيانات،
            أصوات_مع: ٠،
            أصوات_ضد: ٠،
            منتهي: خطأ،
            منفذ: خطأ،
            موعد_انتهاء: الكتلة.الوقت + فترة_تصويت
        }
        
        أطلق اقتراح_جديد(عداد، الرسالة.المرسل)
        أرجع عداد
    نهاية
    
    @عام
    دالة صوّت(معرف: عدد_صحيح، مع: منطقي) ثم
        ق = اقتراحات[معرف]
        تحقق(!ق.منتهي، "الاقتراح منتهٍ")
        تحقق(الكتلة.الوقت < ق.موعد_انتهاء، "انتهت فترة التصويت")
        تحقق(!صوّت[معرف][الرسالة.المرسل]، "صوّت مسبقاً")
        
        عملة = عملة_ص(عملة_الحوكمة)
        وزن = عملة.رصيد(الرسالة.المرسل)
        تحقق(وزن > ٠، "لا تملك حق التصويت")
        
        صوّت[معرف][الرسالة.المرسل] = صحيح
        
        إذا مع ثم
            اقتراحات[معرف].أصوات_مع += وزن
        أو ثم
            اقتراحات[معرف].أصوات_ضد += وزن
        نهاية
        
        أطلق تم_التصويت(معرف، الرسالة.المرسل، مع، وزن)
    نهاية
    
    @عام
    دالة نفّذ(معرف: عدد_صحيح) ثم
        ق = اقتراحات[معرف]
        تحقق(الكتلة.الوقت >= ق.موعد_انتهاء، "لم تنتهِ فترة التصويت")
        تحقق(!ق.منفذ، "نُفذ مسبقاً")
        
        عملة = عملة_ص(عملة_الحوكمة)
        إجمالي = عملة.إجمالي_العرض
        
        // التحقق من النصاب
        مشاركة = (ق.أصوات_مع + ق.أصوات_ضد) * ١٠٠ / إجمالي
        تحقق(مشاركة >= نصاب، "لم يتحقق النصاب")
        
        // التحقق من الموافقة
        تحقق(ق.أصوات_مع > ق.أصوات_ضد، "الاقتراح مرفوض")
        
        // التنفيذ
        اقتراحات[معرف].منتهي = صحيح
        اقتراحات[معرف].منفذ = صحيح
        
        استدعِ(ق.مستهدف، ق.بيانات، قيمة: ق.قيمة)
        
        أطلق تم_التنفيذ(معرف)
    نهاية
)


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٦: نشر وتفاعل
// ═══════════════════════════════════════════════════════════════════════════════════

استورد عقود_ص/نشر

// نشر العقد
ناشر = ناشر_عقود()
ناشر.اتصل("https://rpc.example.com")
ناشر.ضبط_محفظة("مفتاح_خاص")

// نشر عقد التخزين
عنوان_تخزين = ناشر.انشر(عقد_تخزين)
اطبع("تم نشر عقد التخزين: " + عنوان_تخزين)

// التفاعل مع العقد
عقد = ناشر.حمّل_عقد(عنوان_تخزين، عقد_تخزين)

// كتابة قيمة
نتيجة = عقد.خزّن(٤٢)
اطبع("تم التخزين. المعاملة: " + نتيجة.رقم_المعاملة)

// قراءة القيمة
قيمة = عقد.اقرأ()
اطبع("القيمة المخزنة: " + قيمة)
