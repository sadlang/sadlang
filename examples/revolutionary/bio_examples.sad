// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ١: تحليل تسلسل DNA
// ═══════════════════════════════════════════════════════════════════════════════════

استورد حيوي_ص/تسلسلات
استورد حيوي_ص/تحليل

// قراءة تسلسل DNA
تسلسل = DNA("ATGCGATCGATCGATCGATCGATCGTAA")

اطبع("🧬 تحليل تسلسل DNA:")
اطبع("  الطول: " + تسلسل.الطول() + " نيوكليوتيد")
اطبع("  نسبة GC: " + تسلسل.نسبة_GC() + "%")

// التكملة العكسية
مكمل = تسلسل.المكمل_العكسي()
اطبع("  التكملة العكسية: " + مكمل)

// النسخ إلى RNA
rna = تسلسل.انسخ()
اطبع("  RNA: " + rna)

// الترجمة إلى بروتين
بروتين = rna.ترجم()
اطبع("  البروتين: " + بروتين)


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٢: محاذاة التسلسلات
// ═══════════════════════════════════════════════════════════════════════════════════

استورد حيوي_ص/محاذاة

// تسلسلان للمقارنة
تسلسل١ = "ACGTACGTACGT"
تسلسل٢ = "ACGTTCGTACGT"

// محاذاة عالمية (Needleman-Wunsch)
محاذاة = محاذاة_عالمية()
محاذاة.ضبط_نقاط(تطابق: ٢، عدم_تطابق: -١، فجوة: -٢)

نتيجة = محاذاة.نفّذ(تسلسل١، تسلسل٢)

اطبع("\n🔗 محاذاة التسلسلات:")
اطبع("  " + نتيجة.تسلسل١_محاذي)
اطبع("  " + نتيجة.رموز_المحاذاة)
اطبع("  " + نتيجة.تسلسل٢_محاذي)
اطبع("  النتيجة: " + نتيجة.النقاط)
اطبع("  نسبة التطابق: " + نتيجة.نسبة_التطابق + "%")


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٣: تحليل التعبير الجيني
// ═══════════════════════════════════════════════════════════════════════════════════

استورد حيوي_ص/تعبير_جيني

// قراءة بيانات التعبير
بيانات = قارئ_تعبير("عينات.csv")

// التطبيع باستخدام TPM
مطبّع = مطبّع_TPM()
بيانات_مطبعة = مطبّع.طبّع(بيانات)

// التحليل التفاضلي
محلل = محلل_تفاضلي()
جينات_مميزة = محلل.قارن(
    مجموعة_أ: بيانات_مطبعة.اختر("عادي_١", "عادي_٢"),
    مجموعة_ب: بيانات_مطبعة.اختر("سرطان_١", "سرطان_٢"),
    عتبة_p: ٠.٠٥,
    عتبة_log2FC: ١.٥
)

اطبع("\n📊 نتائج التحليل التفاضلي:")
اطبع("  جينات مرتفعة التعبير: " + جينات_مميزة.مرتفعة.عدد())
اطبع("  جينات منخفضة التعبير: " + جينات_مميزة.منخفضة.عدد())

// أعلى ١٠ جينات
اطبع("\n  أعلى ١٠ جينات تغيراً:")
لكل ترتيب، جين في جينات_مميزة.أعلى(١٠).تعداد() افعل
    اطبع("    " + (ترتيب + ١) + ". " + جين.الاسم + 
         " (log2FC: " + جين.log2FC + ", p: " + جين.قيمة_p + ")")
نهاية


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٤: المحاكاة الجزيئية
// ═══════════════════════════════════════════════════════════════════════════════════

استورد حيوي_ص/محاكاة

// تحميل بنية البروتين
بروتين = حمّل_PDB("1AKE.pdb")

اطبع("\n⚛️ محاكاة جزيئية:")
اطبع("  البروتين: " + بروتين.الاسم)
اطبع("  عدد الذرات: " + بروتين.عدد_الذرات())
اطبع("  عدد السلاسل: " + بروتين.عدد_السلاسل())

// إنشاء محاكي
محاكي = محاكي_جزيئي(
    حقل_قوة: "AMBER",
    منظم_حرارة: "Berendsen",
    درجة_حرارة: ٣٠٠.٠  // كلفن
)

// إضافة الماء والأيونات
نظام = محاكي.أعد_النظام(بروتين)
نظام.أضف_ماء(سماكة: ١٠.٠)  // أنغستروم
نظام.أضف_أيونات(تركيز: ٠.١٥)  // مولار

// تقليل الطاقة
اطبع("  تقليل الطاقة...")
محاكي.قلل_الطاقة(خطوات: ١٠٠٠)

// التسخين
اطبع("  التسخين إلى 300K...")
محاكي.سخّن(من: ٠، إلى: ٣٠٠، خطوات: ١٠٠٠٠)

// المحاكاة الإنتاجية
اطبع("  المحاكاة (1 ns)...")
محاكي.نفّذ(
    خطوات: ٥٠٠٠٠٠,  // 1 ns مع خطوة 2 fs
    خطوة_زمنية: ٢.٠,  // فيمتوثانية
    احفظ_كل: ١٠٠٠
)

// تحليل المسار
مسار = محاكي.المسار()
اطبع("\n  تحليل المسار:")
اطبع("    RMSD النهائي: " + مسار.RMSD_النهائي() + " Å")
اطبع("    تذبذب الجذر: " + مسار.RMSF_المتوسط() + " Å")


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٥: البحث في قواعد البيانات
// ═══════════════════════════════════════════════════════════════════════════════════

استورد حيوي_ص/قواعد_بيانات

// البحث في NCBI
عميل = عميل_Entrez(بريد: "your@email.com")

// البحث في PubMed
اطبع("\n🔍 البحث في PubMed:")
مقالات = عميل.ابحث_pubmed("CRISPR Cas9", عدد: ٥)

لكل مقال في مقالات افعل
    اطبع("  • " + مقال.العنوان)
    اطبع("    المؤلفون: " + مقال.المؤلفون.انضم(", "))
    اطبع("    السنة: " + مقال.السنة)
نهاية

// جلب تسلسل من GenBank
اطبع("\n📥 جلب تسلسل من GenBank:")
تسلسل = عميل.جلب_تسلسل("NC_000001.11")
اطبع("  المعرف: " + تسلسل.المعرف)
اطبع("  الوصف: " + تسلسل.الوصف)
اطبع("  الطول: " + تسلسل.الطول())


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٦: التحليل التطوري
// ═══════════════════════════════════════════════════════════════════════════════════

استورد حيوي_ص/تطور

// قراءة تسلسلات متعددة
تسلسلات = قارئ_FASTA("sequences.fasta").اقرأ_الكل()

// محاذاة متعددة
محاذاة = محاذاة_متعددة()
محاذاة_نتيجة = محاذاة.نفّذ(تسلسلات)

// بناء شجرة تطورية
بانٍ = بانٍ_شجرة(طريقة: "neighbor_joining")
شجرة = بانٍ.ابنِ(محاذاة_نتيجة)

اطبع("\n🌳 الشجرة التطورية:")
شجرة.اطبع()

// حفظ الشجرة
شجرة.احفظ("phylo_tree.nwk", تنسيق: "newick")
