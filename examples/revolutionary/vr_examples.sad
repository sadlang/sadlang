/**
 * ===================================================================================
 *  مثال شامل: الواقع الافتراضي والمعزز - VR/AR Example
 * ===================================================================================
 * 
 *  يوضح هذا المثال كيفية استخدام مميزات الواقع الافتراضي في لغة ص
 * 
 * ===================================================================================
 */

// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ١: عالم افتراضي بسيط
// ═══════════════════════════════════════════════════════════════════════════════════

استورد واقع_ص/عالم
استورد واقع_ص/كائنات

// إنشاء العالم
عالم = عالم_افتراضي("عالمي الأول")
عالم.ضبط_جاذبية(٩.٨)
عالم.ضبط_إضاءة_محيطة(٠.٣)

// إضافة أرضية
أرضية = مستوي(
    موقع: متجه٣(٠، ٠، ٠),
    حجم: متجه٢(١٠٠، ١٠٠),
    مادة: مادة(لون: "أخضر", نسيج: "عشب.jpg")
)
عالم.أضف(أرضية)

// إضافة سماء
سماء = سماء_قبة("سماء_صافية.hdr")
عالم.ضبط_سماء(سماء)

// إضافة مكعب
مكعب = مكعب(
    موقع: متجه٣(٠، ١، ٠),
    حجم: متجه٣(١، ١، ١),
    مادة: مادة(لون: "أحمر", لمعان: ٠.٨)
)
عالم.أضف(مكعب)

// إضافة كرة
كرة = كرة(
    موقع: متجه٣(٣، ٢، ٠),
    نصف_قطر: ٠.٥,
    مادة: مادة(لون: "أزرق", معدني: صحيح)
)
عالم.أضف(كرة)

// تشغيل العالم
عالم.ابدأ()


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٢: تفاعل اليد
// ═══════════════════════════════════════════════════════════════════════════════════

استورد واقع_ص/تفاعل

// تتبع اليدين
متتبع = متتبع_يدين()
متتبع.فعّل()

// تعريف إيماءات
إيماءات = مدير_إيماءات()

// إيماءة القبض
إيماءات.سجّل("قبض", دالة(يد) {
    أرجع يد.الإبهام.مغلق و يد.السبابة.مغلق و يد.الوسطى.مغلق
})

// إيماءة الإشارة
إيماءات.سجّل("إشارة", دالة(يد) {
    أرجع يد.السبابة.مفتوح و يد.الوسطى.مغلق
})

// حلقة التفاعل
طالما عالم.نشط افعل
    لكل يد في متتبع.اليدين() افعل
        إيماءة = إيماءات.اكشف(يد)
        
        إذا إيماءة == "قبض" ثم
            // التقاط أقرب كائن
            كائن = عالم.أقرب_كائن(يد.راحة_اليد.موقع، مسافة: ٠.٥)
            إذا كائن ثم
                كائن.التصق_بـ(يد.راحة_اليد)
            نهاية
        أو_إذا إيماءة == "إشارة" ثم
            // إنشاء شعاع ليزر
            شعاع = شعاع(
                بداية: يد.السبابة.طرف.موقع,
                اتجاه: يد.السبابة.اتجاه,
                لون: "أخضر"
            )
            عالم.أضف_مؤقت(شعاع, مدة: ٠.١)
        نهاية
    نهاية
    
    عالم.تحديث()
نهاية


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٣: الفيزياء التفاعلية
// ═══════════════════════════════════════════════════════════════════════════════════

استورد واقع_ص/فيزياء

// إنشاء محرك الفيزياء
فيزياء = محرك_فيزياء()

// إضافة جسم صلب للمكعب
جسم_مكعب = جسم_صلب(
    كائن: مكعب,
    كتلة: ١.٠,
    احتكاك: ٠.٥,
    مرونة: ٠.٣
)
فيزياء.أضف(جسم_مكعب)

// إضافة قيود (مفصل)
مفصل = مفصل_كروي(
    جسم_أ: جسم_مكعب,
    نقطة: متجه٣(٠، ٢، ٠)
)
فيزياء.أضف_قيد(مفصل)

// محاكاة الفيزياء
عند_تصادم = دالة(أ، ب، نقطة) {
    // إصدار صوت عند التصادم
    قوة = أ.سرعة.حجم() * أ.كتلة
    إذا قوة > ١.٠ ثم
        صوت.شغّل("تصادم.wav", قوة: قوة / ١٠)
    نهاية
}

فيزياء.عند_تصادم = عند_تصادم


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٤: واقع معزز
// ═══════════════════════════════════════════════════════════════════════════════════

استورد واقع_ص/معزز

// تهيئة الكاميرا
كاميرا_AR = كاميرا_واقع_معزز()
كاميرا_AR.ابدأ()

// كشف الأسطح
كاشف = كاشف_أسطح()

طالما صحيح افعل
    إطار = كاميرا_AR.التقط()
    
    // كشف الأسطح المستوية
    أسطح = كاشف.اكشف(إطار)
    
    لكل سطح في أسطح افعل
        // رسم شبكة على السطح
        سطح.ارسم_شبكة(لون: "أزرق", شفافية: ٠.٣)
    نهاية
    
    // عند النقر، ضع كائن
    إذا كاميرا_AR.تم_نقر ثم
        نقطة = كاميرا_AR.نقطة_النقر
        سطح = أسطح.أقرب(نقطة)
        
        إذا سطح ثم
            // وضع نموذج ثلاثي الأبعاد
            نموذج = نموذج_ثلاثي("robot.glb")
            نموذج.موقع = نقطة
            نموذج.على_سطح(سطح)
            عالم.أضف(نموذج)
        نهاية
    نهاية
    
    إطار.اعرض()
نهاية


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٥: التجربة الاجتماعية
// ═══════════════════════════════════════════════════════════════════════════════════

استورد واقع_ص/اجتماعي
استورد توزيع_ص/شبكة

// الاتصال بالخادم
خادم = خادم_VR("wss://vr.example.com")
خادم.اتصل()

// إنشاء شخصية اللاعب
شخصيتي = شخصية_افتراضية()
شخصيتي.حمّل_نموذج("avatar.glb")
شخصيتي.ضبط_اسم("محمد")

// مزامنة الموقع
طالما خادم.متصل افعل
    // إرسال موقعي
    خادم.أرسل({
        نوع: "موقع",
        موقع: شخصيتي.موقع,
        دوران: شخصيتي.دوران,
        حالة: شخصيتي.حالة
    })
    
    // استقبال مواقع الآخرين
    لكل رسالة في خادم.الرسائل() افعل
        إذا رسالة.نوع == "موقع" ثم
            لاعب = عالم.جد_لاعب(رسالة.معرف)
            إذا لاعب ثم
                لاعب.حرك_سلس(رسالة.موقع, رسالة.دوران)
            نهاية
        نهاية
    نهاية
    
    عالم.تحديث()
نهاية


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٦: تأثيرات بصرية
// ═══════════════════════════════════════════════════════════════════════════════════

استورد واقع_ص/تأثيرات

// إضافة جسيمات
نظام_جسيمات = نظام_جسيمات({
    عدد: ١٠٠٠,
    عمر: ٢.٠,
    سرعة_ابتدائية: متجه٣(٠، ٥، ٠),
    لون_بداية: "برتقالي",
    لون_نهاية: "أحمر",
    حجم_بداية: ٠.٢,
    حجم_نهاية: ٠.٠
})
نظام_جسيمات.موقع = متجه٣(٠، ٠، ٠)
عالم.أضف(نظام_جسيمات)

// إضافة ضباب
ضباب = ضباب(
    كثافة: ٠.٠٢,
    لون: "أبيض",
    بداية: ١٠,
    نهاية: ٥٠
)
عالم.ضبط_ضباب(ضباب)

// معالجة لاحقة
معالج = معالج_لاحق()
معالج.أضف(توهج(شدة: ٠.٥))
معالج.أضف(SSAO(نصف_قطر: ٠.٥))
معالج.أضف(تصحيح_ألوان(تشبع: ١.٢))

عالم.ضبط_معالج_لاحق(معالج)
