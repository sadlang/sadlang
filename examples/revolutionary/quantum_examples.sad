// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ١: دائرة كمومية بسيطة
// ═══════════════════════════════════════════════════════════════════════════════════

استورد كمومي_ص/دائرة
استورد كمومي_ص/محاكاة

// إنشاء دائرة بـ ٣ كيوبتات
دائرة = دائرة_كمومية(٣)

// تطبيق بوابات
دائرة.H(٠)           // هادامارد على الكيوبت ٠
دائرة.CNOT(٠، ١)     // تشابك الكيوبت ٠ و ١
دائرة.CNOT(١، ٢)     // تشابك الكيوبت ١ و ٢

// قياس جميع الكيوبتات
دائرة.قِس_الكل()

// محاكاة
محاكي = محاكي_كمومي()
نتائج = محاكي.نفّذ(دائرة، تكرارات: ١٠٠٠)

اطبع("📊 نتائج القياس:")
لكل حالة، عدد في نتائج.التوزيع() افعل
    نسبة = عدد / ١٠٠٠ * ١٠٠
    اطبع("  |" + حالة + "⟩: " + نسبة + "% (" + عدد + " مرة)")
نهاية


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٢: خوارزمية جروفر للبحث
// ═══════════════════════════════════════════════════════════════════════════════════

استورد كمومي_ص/خوارزميات

// البحث عن قيمة في قاعدة بيانات
قيمة_مطلوبة = "1010"
عدد_كيوبتات = ٤

// إنشاء أوراكل جروفر
أوراكل = أوراكل_جروفر(عدد_كيوبتات، قيمة_مطلوبة)

// بناء الدائرة
دائرة = خوارزمية_جروفر(عدد_كيوبتات، أوراكل)

// تنفيذ
نتيجة = محاكي.نفّذ(دائرة، تكرارات: ١٠٠٠)

اطبع("🔍 نتيجة بحث جروفر:")
أعلى = نتيجة.أعلى_نتيجة()
اطبع("  الحالة الأكثر احتمالاً: |" + أعلى.حالة + "⟩")
اطبع("  الاحتمال: " + أعلى.احتمال * ١٠٠ + "%")


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٣: خوارزمية شور لتحليل الأعداد
// ═══════════════════════════════════════════════════════════════════════════════════

استورد كمومي_ص/تشفير

// تحليل عدد إلى عوامله الأولية
عدد = ١٥

اطبع("🔐 تحليل العدد " + عدد + " باستخدام خوارزمية شور...")

// إنشاء دائرة شور
دائرة = خوارزمية_شور(عدد)

// تنفيذ (يتطلب حاسوب كمومي حقيقي للأعداد الكبيرة)
نتيجة = محاكي_شور.نفّذ(دائرة)

اطبع("  العوامل: " + نتيجة.عامل١ + " × " + نتيجة.عامل٢)
اطبع("  تحقق: " + نتيجة.عامل١ * نتيجة.عامل٢)


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٤: التشابك الكمومي
// ═══════════════════════════════════════════════════════════════════════════════════

استورد كمومي_ص/تشابك

// إنشاء زوج بيل (حالة متشابكة)
زوج = زوج_بيل()

اطبع("🔗 حالة التشابك:")
اطبع("  |Φ+⟩ = (|00⟩ + |11⟩) / √2")

// قياس الكيوبت الأول
نتيجة١ = زوج.قِس(٠)
اطبع("  قياس الكيوبت ٠: " + نتيجة١)

// قياس الكيوبت الثاني (سيكون دائماً مطابقاً!)
نتيجة٢ = زوج.قِس(١)
اطبع("  قياس الكيوبت ١: " + نتيجة٢)

إذا نتيجة١ == نتيجة٢ ثم
    اطبع("  ✅ التشابك مؤكد! النتائج متطابقة")
نهاية


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٥: VQE للكيمياء الكمومية
// ═══════════════════════════════════════════════════════════════════════════════════

استورد كمومي_ص/كيمياء

// حساب طاقة جزيء الهيدروجين H₂
جزيء = جزيء("H2", مسافة_رابطة: ٠.٧٤)

// إنشاء دائرة VQE
دائرة = VQE(جزيء، أنصاتز: "UCCSD")

// تحسين المعاملات
محسن = محسن_كوبيلا()
نتيجة = محسن.حسّن(دائرة)

اطبع("⚛️ طاقة جزيء H₂:")
اطبع("  الطاقة المحسوبة: " + نتيجة.طاقة + " هارتري")
اطبع("  الطاقة التجريبية: -1.174 هارتري")
اطبع("  الخطأ: " + قيمة_مطلقة(نتيجة.طاقة + ١.١٧٤) + " هارتري")


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٦: التصحيح الكمومي للأخطاء
// ═══════════════════════════════════════════════════════════════════════════════════

استورد كمومي_ص/تصحيح

// شفرة ستيين للتصحيح (7 كيوبتات منطقية لكل كيوبت)
كيوبت_منطقي = كيوبت_ستيين()

// تطبيق بوابة X المنطقية
كيوبت_منطقي.X_منطقي()

// محاكاة خطأ (قلب بت عشوائي)
كيوبت_منطقي.أضف_خطأ(معدل: ٠.٠١)

// تصحيح الخطأ
أخطاء = كيوبت_منطقي.صحّح()

اطبع("🛡️ تصحيح الأخطاء الكمومية:")
اطبع("  أخطاء مكتشفة: " + أخطاء.عدد)
اطبع("  أخطاء مصححة: " + أخطاء.مصحح)
اطبع("  الحالة النهائية: سليمة")
