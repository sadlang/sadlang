// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ١: شبكة عصبية بسيطة
// ═══════════════════════════════════════════════════════════════════════════════════

استورد ذكاء_ص/شبكة_عصبية
استورد ذكاء_ص/تدريب

// تعريف الشبكة
شبكة = شبكة_عصبية.أنشئ() ثم
    أضف_طبقة(كثيفة: ٧٨٤) ثم        // طبقة الإدخال (صورة 28×28)
    أضف_طبقة(كثيفة: ١٢٨، تفعيل: "relu") ثم
    أضف_طبقة(كثيفة: ٦٤، تفعيل: "relu") ثم
    أضف_طبقة(كثيفة: ١٠، تفعيل: "softmax")  // ١٠ أصناف
نهاية

// تجميع الشبكة
شبكة.جمّع(
    محسن: "آدم",
    خسارة: "categorical_crossentropy",
    مقاييس: ["دقة"]
)

// تدريب الشبكة
اطبع("🧠 بدء التدريب...")
تاريخ = شبكة.درّب(
    بيانات_تدريب,
    بيانات_اختبار,
    حقب: ١٠,
    حجم_دفعة: ٣٢
)

// تقييم النموذج
دقة = شبكة.قيّم(بيانات_اختبار)
اطبع("✅ دقة النموذج: " + دقة * ١٠٠ + "%")

// حفظ النموذج
شبكة.احفظ("نموذج_تصنيف_صور.sad")


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٢: تعلم معزز
// ═══════════════════════════════════════════════════════════════════════════════════

استورد ذكاء_ص/تعلم_معزز

// تعريف البيئة
بيئة = بيئة_لعبة("CartPole")

// تعريف العميل
عميل = عميل_DQN(
    حالة: بيئة.شكل_الحالة(),
    أفعال: بيئة.عدد_الأفعال(),
    ذاكرة: ١٠٠٠٠,
    غاما: ٠.٩٩
)

// حلقة التدريب
لكل حلقة في نطاق(١٠٠٠) افعل
    حالة = بيئة.أعد_ضبط()
    مكافأة_إجمالية = ٠
    
    طالما ليس انتهت افعل
        فعل = عميل.اختر_فعل(حالة)
        حالة_جديدة، مكافأة، انتهت = بيئة.خطوة(فعل)
        
        عميل.تذكر(حالة، فعل، مكافأة، حالة_جديدة، انتهت)
        عميل.تعلم()
        
        حالة = حالة_جديدة
        مكافأة_إجمالية += مكافأة
    نهاية
    
    اطبع("الحلقة " + حلقة + ": المكافأة = " + مكافأة_إجمالية)
نهاية


