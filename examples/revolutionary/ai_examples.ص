//                              مثال ٣: معالجة اللغة الطبيعية
// ═══════════════════════════════════════════════════════════════════════════════════

استورد ذكاء_ص/لغة_طبيعية

// تحليل المشاعر
محلل = محلل_مشاعر("ar")

نصوص = [
    "هذا المنتج رائع جداً!",
    "خدمة سيئة للغاية",
    "جودة متوسطة، لا بأس بها"
]

لكل نص في نصوص افعل
    نتيجة = محلل.حلل(نص)
    اطبع("النص: " + نص)
    اطبع("  المشاعر: " + نتيجة.المشاعر)
    اطبع("  الثقة: " + نتيجة.الثقة * ١٠٠ + "%")
نهاية


// ═══════════════════════════════════════════════════════════════════════════════════
//                              مثال ٤: رؤية حاسوبية
// ═══════════════════════════════════════════════════════════════════════════════════

استورد ذكاء_ص/رؤية

// تحميل نموذج YOLO للكشف عن الكائنات
كاشف = كاشف_كائنات.حمّل("yolo_v8")

// فتح كاميرا
كاميرا = رؤية.افتح_كاميرا(٠)

طالما صحيح افعل
    إطار = كاميرا.اقرأ()
    
    // الكشف عن الكائنات
    كائنات = كاشف.اكشف(إطار)
    
    // رسم المربعات
    لكل كائن في كائنات افعل
        إطار.ارسم_مربع(
            كائن.س، كائن.ص،
            كائن.عرض، كائن.ارتفاع،
            لون: "أخضر",
            نص: كائن.الصنف + " (" + كائن.الثقة * ١٠٠ + "%)"
        )
    نهاية
    
    إطار.اعرض("الكشف المباشر")
    
    إذا رؤية.مفتاح_مضغوط("q") ثم
        توقف
    نهاية
نهاية

كاميرا.أغلق()
