# يُنشئ نافذة SDL2 مع تسمية وزر ورسوميات بسيطة
# Creates an SDL2 window with a label, button, and simple graphics

# ── إنشاء النافذة ──
متغير نافذة = نافذة_جديدة("مرحبا بالعالم — لغة ص", 800, 600)

# ── إنشاء الرسام ──
متغير رسام = رسام_ثنائي_جديد(نافذة)

# ── إنشاء عناصر الواجهة ──
متغير تسمية = تسمية_جديدة("مرحبا بالعالم!", 250, 50, 300, 40)
متغير زر1 = زر_جديد("اضغطني", 300, 200, 200, 50)

# ── عرض النافذة ──
نافذة_عرض(نافذة)
اطبع_سطر("✅ النافذة مفتوحة — اضغط × للإغلاق")

# ── حلقة الأحداث الرئيسية ──
بينما (ليس نافذة_يجب_الإغلاق(نافذة))
    نافذة_استقبال_أحداث(نافذة)

    # بدء إطار الرسم
    رسام_بدء_إطار(رسام)

    # مسح الشاشة بلون داكن (رمادي غامق)
    رسام_مسح(رسام, 40, 44, 52, 255)

    # رسم خلفية مستطيل مستدير
    رسام_مستطيل(رسام, 50, 30, 700, 540, 60, 64, 72, 255, صحيح)

    # رسم نص عنوان
    رسام_نص(رسام, "مرحبا بالعالم — لغة ص!", 220, 100, 28, 255, 255, 255, 255)

    # رسم دائرة زخرفية
    رسام_دائرة(رسام, 400, 400, 60, 100, 149, 237, 255, صحيح)

    # رسم خط فاصل
    رسام_خط(رسام, 100, 300, 700, 300, 255, 255, 255, 128)

    # رسم عناصر الواجهة
    عنصر_رسم(تسمية, رسام)
    عنصر_رسم(زر1, رسام)

    # فحص النقر على الزر
    إذا (زر_تم_النقر(زر1))
        اطبع_سطر("🎉 تم النقر على الزر!")
    نهاية

    # إنهاء الإطار
    رسام_إنهاء_إطار(رسام)
نهاية

# ── تنظيف ──
نافذة_إغلاق(نافذة)
اطبع_سطر("✅ تم إغلاق النافذة بنجاح")
