# =============================================
# 6. اختبار تحميل العوامل الزائد
# =============================================
اطبع_سطر("")
اطبع_سطر("=== اختبار تحميل العوامل ===")

صنف نقطة
    باني(س، ص)
        هذا.س = س
        هذا.ص = ص
    نهاية
    
    عامل +(أخرى)
        ارجع جديد نقطة(هذا.س + أخرى.س، هذا.ص + أخرى.ص)
    نهاية
    
    دالة نص()
        ارجع "(" + هذا.س + "، " + هذا.ص + ")"
    نهاية
نهاية

متغير ن1 = جديد نقطة(1، 2)
متغير ن2 = جديد نقطة(3، 4)
متغير ن3 = ن1 + ن2
اطبع_سطر("نقطة1 + نقطة2 = " + ن3.نص())

