# =============================================
# 1. اختبار اللامدا والإغلاقات (Closures)
# =============================================
اطبع_سطر("=== اختبار اللامدا ===")

# لامدا بسيطة بدون إغلاق
متغير مضاعف = لامدا س: س * 2
اطبع_سطر("مضاعف(5) = " + مضاعف(5))

# لامدا مع إغلاق (التقاط متغير خارجي)
متغير قاعدة = 10
متغير جامع = لامدا س: س + قاعدة
اطبع_سطر("جامع(5) = " + جامع(5))

# لامدا مع معاملين
متغير جامع2 = لامدا أ، ب: أ + ب
اطبع_سطر("جامع2(3, 4) = " + جامع2(3، 4))

# =============================================
# 2. اختبار السمات والواجهات (Traits)
# =============================================
اطبع_سطر("")
اطبع_سطر("=== اختبار السمات ===")

سمة قابل_للطباعة
    دالة اطبع_نفسك()
نهاية

صنف شخص
    باني(اسم، عمر)
        هذا.الاسم = اسم
        هذا.العمر = عمر
    نهاية
نهاية

نفذ قابل_للطباعة لـ شخص
    دالة اطبع_نفسك()
        اطبع_سطر("اسمي: " + هذا.الاسم + "، عمري: " + هذا.العمر)
    نهاية
نهاية

متغير ش = جديد شخص("أحمد"، 25)
ش.اطبع_نفسك()

