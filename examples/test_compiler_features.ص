# 7. اختبار مطابقة الأنماط
# =============================================
اطبع_سطر("")
اطبع_سطر("=== اختبار مطابقة الأنماط ===")

دالة وصف_عمر(عمر)
    طابق (عمر)
        عندما 0..13:
            ارجع "طفل"
        عندما 13..20:
            ارجع "مراهق"
        افتراضي:
            ارجع "بالغ"
    نهاية
نهاية

اطبع_سطر("عمر 5: " + وصف_عمر(5))
اطبع_سطر("عمر 15: " + وصف_عمر(15))
اطبع_سطر("عمر 30: " + وصف_عمر(30))

