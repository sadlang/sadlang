# ===================================================================
# مثال: تطبيق قائمة مهام — تطبيق عملي متكامل
# ===================================================================
# يوضح استخدام:
#   - هيكل + شريط_تطبيق (بنية التطبيق)
#   - قائمة + عنصر_قائمة (عرض البيانات)
#   - حقل_نص + زر (إدخال البيانات)
#   - خانة_اختيار (تحديد الإنجاز)
#   - حوار (تأكيد الحذف)
#   - حالة_عنصر (إدارة الحالة)
# ===================================================================

استورد * من رسومات.واجهات

# ─── تطبيق قائمة المهام ───
صنف تطبيق_مهام يرث حالة_عنصر
    متغير مهام = []
    متغير نص_جديد = ""

    دالة هيئ()
        # إضافة مهام افتراضية
        هذا.مهام = [
            {"نص": "تعلم لغة ص", "مكتمل": خطأ},
            {"نص": "بناء تطبيق أول", "مكتمل": خطأ},
            {"نص": "قراءة التوثيق", "مكتمل": صحيح}
        ]
    نهاية

    دالة بناء()
        # بناء قائمة عناصر المهام
        متغير عناصر_المهام = []
        لكل مهمة في هذا.مهام
            متغير م = مهمة
            عناصر_المهام.أضف(
                جديد عنصر_قائمة(
                    عنوان: م["نص"],
                    بادئ: جديد خانة_اختيار(
                        محدد: م["مكتمل"],
                        عند_التغيير: لامدا()
                            هذا.عيّن_حالة(لامدا()
                                م["مكتمل"] = ليس م["مكتمل"]
                            نهاية)
                        نهاية
                    )
                )
            )
        نهاية

        ارجع جديد هيكل(
            عنوان: "قائمة المهام",
            شريط_علوي: جديد شريط_تطبيق(
                عنوان: "📋 مهامي",
                لون_خلفية: "#673AB7"
            ),
            جسم: جديد عمود([
                # حقل إدخال مهمة جديدة
                جديد حاوية(
                    حشوة: 16,
                    ابن: جديد صف([
                        جديد حقل_نص(
                            قيمة: هذا.نص_جديد,
                            تلميح: "أضف مهمة جديدة...",
                            عند_التغيير: لامدا(قيمة)
                                هذا.نص_جديد = قيمة
                            نهاية
                        ),
                        جديد زر("إضافة", لون_خلفية: "#673AB7", عند_الضغط: لامدا()
                            إذا (هذا.نص_جديد != "")
                                هذا.عيّن_حالة(لامدا()
                                    هذا.مهام.أضف({"نص": هذا.نص_جديد, "مكتمل": خطأ})
                                    هذا.نص_جديد = ""
                                نهاية)
                            نهاية
                        نهاية)
                    ], تباعد: 8, محاذاة_ثانوية: "وسط")
                ),
                جديد فاصل_خط(),
                # قائمة المهام
                جديد قائمة(عناصر_المهام)
            ])
        )
    نهاية
نهاية

# تشغيل التطبيق
تشغيل_تطبيق(جديد تطبيق_مهام())
