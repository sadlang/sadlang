# قاعدة بيانات الملاحظات
متغير ملاحظات = []
متغير عداد = 0

# إضافة ملاحظة جديدة
دالة أضف_ملاحظة(عنوان، محتوى، تصنيف)
    عداد = عداد + 1
    متغير ملاحظة = {
        "رقم": عداد,
        "عنوان": عنوان,
        "محتوى": محتوى,
        "تصنيف": تصنيف
    }
    ملاحظات = ملاحظات + [ملاحظة]
    اطبع_سطر("✓ تمت إضافة ملاحظة: " + عنوان)
نهاية

# البحث في الملاحظات حسب التصنيف
دالة ابحث_بالتصنيف(تصنيف_مطلوب)
    اطبع_سطر("")
    اطبع_سطر("--- ملاحظات [" + تصنيف_مطلوب + "] ---")
    متغير وجد = 0
    لكل ملاحظة في ملاحظات
        إذا (ملاحظة["تصنيف"] == تصنيف_مطلوب)
            اطبع_سطر("  #" + ملاحظة["رقم"] + " " + ملاحظة["عنوان"])
            اطبع_سطر("    " + ملاحظة["محتوى"])
            وجد = وجد + 1
        نهاية
    نهاية
    إذا (وجد == 0)
        اطبع_سطر("  (لا توجد ملاحظات)")
    نهاية
نهاية

# عرض جميع الملاحظات
دالة اعرض_الكل()
    اطبع_سطر("")
    اطبع_سطر("=== جميع الملاحظات ===")
    لكل ملاحظة في ملاحظات
        اطبع_سطر("  #" + ملاحظة["رقم"] + " [" + ملاحظة["تصنيف"] + "] " + ملاحظة["عنوان"])
        اطبع_سطر("    " + ملاحظة["محتوى"])
    نهاية
    اطبع_سطر("--- المجموع: " + عداد + " ملاحظات ---")
نهاية

# عد الملاحظات حسب التصنيف
دالة عد_بالتصنيف(تصنيف)
    متغير عدد = 0
    لكل ملاحظة في ملاحظات
        إذا (ملاحظة["تصنيف"] == تصنيف)
            عدد = عدد + 1
        نهاية
    نهاية
    ارجع عدد
نهاية

# === تشغيل التطبيق ===
اطبع_سطر("=== تطبيق الملاحظات بلغة ص ===")

# إضافة ملاحظات متنوعة
أضف_ملاحظة("تعلم لغة ص"، "البدء بالمتغيرات والدوال ثم الأصناف"، "تعلم")
أضف_ملاحظة("فكرة مشروع"، "بناء تطبيق ويب بلغة ص مع واجهة عربية"، "أفكار")
أضف_ملاحظة("ملاحظة عن الأنواع"، "رقم وعشري ونص ومنطقي ومصفوفة وخريطة"، "تعلم")
أضف_ملاحظة("اجتماع الفريق"، "مناقشة خطة الإصدار الأول"، "عمل")
أضف_ملاحظة("مكتبة الرسوميات"، "استخدام SDL2 مع OpenGL"، "أفكار")

# عرض الكل
اعرض_الكل()

# بحث حسب التصنيف
ابحث_بالتصنيف("تعلم")
ابحث_بالتصنيف("أفكار")

# إحصائيات
اطبع_سطر("")
اطبع_سطر("=== إحصائيات ===")
اطبع_سطر("تعلم: " + عد_بالتصنيف("تعلم"))
اطبع_سطر("أفكار: " + عد_بالتصنيف("أفكار"))
اطبع_سطر("عمل: " + عد_بالتصنيف("عمل"))
