# قائمة المهام
متغير مهام = []
متغير عداد_المهام = 0

# إضافة مهمة جديدة
دالة أضف_مهمة(عنوان، أولوية)
    عداد_المهام = عداد_المهام + 1
    متغير مهمة = {
        "رقم": عداد_المهام,
        "عنوان": عنوان,
        "أولوية": أولوية,
        "مكتملة": خطأ
    }
    مهام = مهام + [مهمة]
    اطبع_سطر("✓ تمت إضافة: " + عنوان)
نهاية

# إتمام مهمة
دالة أتم_مهمة(رقم)
    لكل مهمة في مهام
        إذا (مهمة["رقم"] == رقم)
            مهمة["مكتملة"] = صحيح
            اطبع_سطر("✓ تم إتمام: " + مهمة["عنوان"])
            ارجع صحيح
        نهاية
    نهاية
    اطبع_سطر("✗ مهمة غير موجودة: " + رقم)
    ارجع خطأ
نهاية

# عرض جميع المهام
دالة اعرض_المهام()
    اطبع_سطر("")
    اطبع_سطر("=== قائمة المهام ===")
    إذا (مهام == [])
        اطبع_سطر("  (لا توجد مهام)")
        ارجع لاشيء
    نهاية
    
    لكل مهمة في مهام
        متغير رمز = "[ ]"
        إذا (مهمة["مكتملة"])
            رمز = "[✓]"
        نهاية
        اطبع_سطر("  " + رمز + " #" + مهمة["رقم"] + " " + مهمة["عنوان"] + " [" + مهمة["أولوية"] + "]")
    نهاية
نهاية

# عد المهام المكتملة
دالة عد_المكتملة()
    متغير عدد = 0
    لكل مهمة في مهام
        إذا (مهمة["مكتملة"])
            عدد = عدد + 1
        نهاية
    نهاية
    ارجع عدد
نهاية

# تشغيل التطبيق
اطبع_سطر("=== مدير المهام بلغة ص ===")

أضف_مهمة("تعلم أساسيات لغة ص"، "عالية")
أضف_مهمة("كتابة أول برنامج"، "عالية")
أضف_مهمة("قراءة التوثيق"، "متوسطة")
أضف_مهمة("إنشاء مشروع"، "متوسطة")
أضف_مهمة("نشر المشروع"، "منخفضة")

اعرض_المهام()

اطبع_سطر("")
أتم_مهمة(1)
أتم_مهمة(2)

اعرض_المهام()

اطبع_سطر("")
اطبع_سطر("المكتملة: " + عد_المكتملة() + " من " + عداد_المهام)
