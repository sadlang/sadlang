# (AR) تطبيق إدارة مهام كامل بأنماط iOS/SwiftUI
# =============================================================================

# --- نموذج المهمة ---

صنف مهمة_ios
    باني(عنوان، وصف، أولوية)
        هذا.المعرف = 0
        هذا.العنوان = عنوان
        هذا.الوصف = وصف
        هذا.مكتملة = خطأ
        هذا.الأولوية = أولوية
        هذا.الفئة = "عامة"
        هذا.مكررة = خطأ
    نهاية

    دالة نص_العرض()
        متغير رمز = "○"
        إذا (هذا.مكتملة)
            رمز = "●"
        نهاية
        متغير نجمة = ""
        إذا (هذا.الأولوية == "عالية")
            نجمة = " ⭐"
        نهاية
        ارجع رمز + " " + هذا.العنوان + نجمة
    نهاية
نهاية

# --- مدير المهام ---

صنف مدير_مهام_ios
    باني()
        هذا.المهام = []
        هذا.العداد = 0
        هذا.الفئات = ["عامة"، "عمل"، "شخصي"، "تسوق"]
    نهاية

    دالة اضف(عنوان، وصف، أولوية)
        هذا.العداد = هذا.العداد + 1
        متغير مهمة_جديدة = جديد مهمة_ios(عنوان، وصف، أولوية)
        مهمة_جديدة.المعرف = هذا.العداد
        هذا.المهام = هذا.المهام + [مهمة_جديدة]
        ارجع مهمة_جديدة
    نهاية

    دالة اكمل(معرف)
        لكل م في هذا.المهام
            إذا (م.المعرف == معرف)
                م.مكتملة = صحيح
            نهاية
        نهاية
    نهاية

    دالة الغ_اكمال(معرف)
        لكل م في هذا.المهام
            إذا (م.المعرف == معرف)
                م.مكتملة = خطأ
            نهاية
        نهاية
    نهاية

    دالة احذف(معرف)
        متغير محدثة = []
        لكل م في هذا.المهام
            إذا (م.المعرف != معرف)
                محدثة = محدثة + [م]
            نهاية
        نهاية
        هذا.المهام = محدثة
    نهاية

    دالة عيّن_فئة(معرف، فئة_النشاط)
        لكل م في هذا.المهام
            إذا (م.المعرف == معرف)
                م.الفئة = فئة_النشاط
            نهاية
        نهاية
    نهاية

    دالة عدد_الكل()
        متغير عدد = 0
        لكل م في هذا.المهام
            عدد = عدد + 1
        نهاية
        ارجع عدد
    نهاية

    دالة عدد_المكتملة()
        متغير عدد = 0
        لكل م في هذا.المهام
            إذا (م.مكتملة)
                عدد = عدد + 1
            نهاية
        نهاية
        ارجع عدد
    نهاية

    دالة عدد_المتبقية()
        ارجع هذا.عدد_الكل() - هذا.عدد_المكتملة()
    نهاية

    دالة عدد_العالية()
        متغير عدد = 0
        لكل م في هذا.المهام
            إذا (م.الأولوية == "عالية" و م.مكتملة == خطأ)
                عدد = عدد + 1
            نهاية
        نهاية
        ارجع عدد
    نهاية

    دالة عدد_فئة(فئة_البحث)
        متغير عدد = 0
        لكل م في هذا.المهام
            إذا (م.الفئة == فئة_البحث)
                عدد = عدد + 1
            نهاية
        نهاية
        ارجع عدد
    نهاية

    دالة نسبة_الإنجاز()
        إذا (هذا.عدد_الكل() == 0)
            ارجع 0
        نهاية
        ارجع (هذا.عدد_المكتملة() * 100) / هذا.عدد_الكل()
    نهاية

    دالة ملخص()
        ارجع "الكل: " + نص(هذا.عدد_الكل()) + " | مكتمل: " + نص(هذا.عدد_المكتملة()) + " | متبقي: " + نص(هذا.عدد_المتبقية())
    نهاية
نهاية

