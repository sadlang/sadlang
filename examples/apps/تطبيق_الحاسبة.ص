# عمليات حسابية أساسية
دالة جمع(أ، ب)
    ارجع أ + ب
نهاية

دالة طرح(أ، ب)
    ارجع أ - ب
نهاية

دالة ضرب(أ، ب)
    ارجع أ * ب
نهاية

دالة قسمة(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("خطأ: لا يمكن القسمة على صفر!")
        ارجع 0
    نهاية
    ارجع أ / ب
نهاية

دالة باقي_قسمة(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("خطأ: لا يمكن القسمة على صفر!")
        ارجع 0
    نهاية
    ارجع أ % ب
نهاية

دالة قوة(أساس، أس)
    ارجع أساس ** أس
نهاية

# دالة القيمة المطلقة
دالة مطلقة(س)
    إذا (س < 0)
        ارجع -س
    نهاية
    ارجع س
نهاية

# حساب المضروب (Factorial)
دالة مضروب(ن)
    إذا (ن <= 1)
        ارجع 1
    نهاية
    ارجع ن * مضروب(ن - 1)
نهاية

# حساب فيبوناتشي
دالة فيبوناتشي(ن)
    إذا (ن <= 0)
        ارجع 0
    نهاية
    إذا (ن == 1)
        ارجع 1
    نهاية
    ارجع فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)
نهاية

# العدد الأولي
دالة أولي(ن)
    إذا (ن < 2)
        ارجع خطأ
    نهاية
    متغير ق = 2
    بينما (ق * ق <= ن)
        إذا (ن % ق == 0)
            ارجع خطأ
        نهاية
        ق = ق + 1
    نهاية
    ارجع صحيح
نهاية

