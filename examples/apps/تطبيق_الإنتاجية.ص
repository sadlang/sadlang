    إذا (مهمة3 != لاشيء)
        اطبع_سطر("🟢 " + مهمة3.العنوان + " [" + مهمة3.الحالة + "]")
    نهاية
    
    اطبع_سطر("")
    اطبع_سطر("--- العادات ---")
    
    # عرض العادات
    متغير عادة1 = التطبيق.العادات["habit1"]
