# ═══════════════════════════════════════════════════════════════
#                         تطبيق الإنتاجية
# ═══════════════════════════════════════════════════════════════

صنف تطبيق_الإنتاجية
    عام متغير المهام
    عام متغير المشاريع
    عام متغير العادات
    عام متغير الأحداث
    
    باني()
        هذا.المهام = {}
        هذا.المشاريع = {}
        هذا.العادات = {}
        هذا.الأحداث = {}
    نهاية
    
    ## تهيئة التطبيق
    عام دالة هيئ()
        هذا.أنشئ_بيانات_تجريبية()
        اطبع_سطر("✓ تم تهيئة تطبيق الإنتاجية")
    نهاية
    
    ## إنشاء بيانات تجريبية
    عام دالة أنشئ_بيانات_تجريبية()
        # مشاريع تجريبية
        متغير مشروع_عمل = جديد مشروع("proj1"، "العمل")
        مشروع_عمل.الرمز = "💼"
        مشروع_عمل.عدد_المهام = 2
        هذا.المشاريع["proj1"] = مشروع_عمل
        
        متغير مشروع_شخصي = جديد مشروع("proj2"، "شخصي")
        مشروع_شخصي.الرمز = "🏠"
        مشروع_شخصي.اللون = 0x4CAF50
        مشروع_شخصي.عدد_المهام = 1
        هذا.المشاريع["proj2"] = مشروع_شخصي
        
        # مهام تجريبية
        متغير مهمة1 = جديد مهمة("task1"، "إنهاء تقرير المشروع")
        مهمة1.الوصف = "تقرير الربع الأول"
        مهمة1.الأولوية = "عالية"
        مهمة1.معرف_المشروع = "proj1"
        هذا.المهام["task1"] = مهمة1
        
        متغير مهمة2 = جديد مهمة("task2"، "اجتماع مع الفريق")
        مهمة2.الأولوية = "متوسطة"
        مهمة2.معرف_المشروع = "proj1"
        هذا.المهام["task2"] = مهمة2
        
        متغير مهمة3 = جديد مهمة("task3"، "تمارين رياضية")
        مهمة3.الأولوية = "منخفضة"
        مهمة3.معرف_المشروع = "proj2"
        هذا.المهام["task3"] = مهمة3
        
        # أحداث تجريبية
        متغير حدث1 = جديد حدث_تقويم("event1"، "اجتماع الفريق"، 1700003600000)
        حدث1.الموقع = "غرفة الاجتماعات"
        هذا.الأحداث["event1"] = حدث1
        
        # عادات تجريبية
        متغير عادة1 = جديد عادة("habit1"، "قراءة")
        عادة1.الرمز = "📚"
        عادة1.السلسلة = 5
        هذا.العادات["habit1"] = عادة1
        
        متغير عادة2 = جديد عادة("habit2"، "رياضة")
        عادة2.الرمز = "🏃"
        عادة2.السلسلة = 3
        هذا.العادات["habit2"] = عادة2
        
        اطبع_سطر("✓ تم إنشاء البيانات التجريبية")
    نهاية
    
    ## إضافة مهمة
    عام دالة أضف_مهمة(العنوان، الأولوية، معرف_المشروع)
        متغير المعرف = "task_" + 1700000001000
        متغير مهمة_جديدة = جديد مهمة(المعرف، العنوان)
        مهمة_جديدة.الأولوية = الأولوية
        مهمة_جديدة.معرف_المشروع = معرف_المشروع
        
        هذا.المهام[المعرف] = مهمة_جديدة
        
        اطبع_سطر("✓ تم إضافة المهمة: " + العنوان)
        ارجع مهمة_جديدة
    نهاية
    
    ## إكمال مهمة
    عام دالة أكمل_مهمة(معرف_المهمة)
        متغير مهمة = هذا.المهام[معرف_المهمة]
        إذا (مهمة == لاشيء)
            ارجع خطأ
        نهاية
        
        مهمة.الحالة = "مكتملة"
        مهمة.تاريخ_الإكمال = 1700000000000
        
        اطبع_سطر("✓ تم إكمال المهمة: " + مهمة.العنوان)
        ارجع صحيح
    نهاية
    
    ## تسجيل إكمال عادة
    عام دالة سجل_إكمال_عادة(معرف_العادة)
        متغير عادة = هذا.العادات[معرف_العادة]
        إذا (عادة == لاشيء)
            ارجع خطأ
        نهاية
        
        إذا (عادة.مكتملة_اليوم)
            اطبع_سطر("⚠ العادة مكتملة اليوم بالفعل")
            ارجع خطأ
        نهاية
        
        عادة.مكتملة_اليوم = صحيح
        عادة.السلسلة = عادة.السلسلة + 1
        
        اطبع_سطر("✓ تم تسجيل إكمال العادة: " + عادة.الاسم + " (السلسلة: " + عادة.السلسلة + ")")
        ارجع صحيح
    نهاية
    
    ## احصل على إحصائيات
    عام دالة اعرض_الإحصائيات()
        متغير مهام_مكتملة = 0
        متغير إجمالي_مهام = 0
        
        # حساب المهام
        متغير م1 = هذا.المهام["task1"]
        متغير م2 = هذا.المهام["task2"]
        متغير م3 = هذا.المهام["task3"]
        
        إذا (م1 != لاشيء)
            إجمالي_مهام = إجمالي_مهام + 1
            إذا (م1.الحالة == "مكتملة")
                مهام_مكتملة = مهام_مكتملة + 1
            نهاية
        نهاية
        
        إذا (م2 != لاشيء)
            إجمالي_مهام = إجمالي_مهام + 1
            إذا (م2.الحالة == "مكتملة")
                مهام_مكتملة = مهام_مكتملة + 1
            نهاية
        نهاية
        
        إذا (م3 != لاشيء)
            إجمالي_مهام = إجمالي_مهام + 1
            إذا (م3.الحالة == "مكتملة")
                مهام_مكتملة = مهام_مكتملة + 1
            نهاية
        نهاية
        
        # حساب العادات
        متغير عادات_مكتملة = 0
        متغير إجمالي_عادات = 0
        
        متغير ع1 = هذا.العادات["habit1"]
        متغير ع2 = هذا.العادات["habit2"]
        
        إذا (ع1 != لاشيء)
            إجمالي_عادات = إجمالي_عادات + 1
            إذا (ع1.مكتملة_اليوم)
                عادات_مكتملة = عادات_مكتملة + 1
            نهاية
        نهاية
        
        إذا (ع2 != لاشيء)
            إجمالي_عادات = إجمالي_عادات + 1
            إذا (ع2.مكتملة_اليوم)
                عادات_مكتملة = عادات_مكتملة + 1
            نهاية
        نهاية
        
        اطبع_سطر("• المهام: " + مهام_مكتملة + "/" + إجمالي_مهام)
        اطبع_سطر("• العادات: " + عادات_مكتملة + "/" + إجمالي_عادات)
    نهاية
    
    ## تحرير الموارد
    عام دالة حرر()
        هذا.المهام = {}
        هذا.المشاريع = {}
        هذا.العادات = {}
        هذا.الأحداث = {}
        اطبع_سطر("✓ تم تحرير موارد تطبيق الإنتاجية")
    نهاية
نهاية

