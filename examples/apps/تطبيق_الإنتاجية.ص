    إذا (عادة1 != لاشيء)
        اطبع_سطر(عادة1.الرمز + " " + عادة1.الاسم + " 🔥" + عادة1.السلسلة)
    نهاية
    
    إذا (عادة2 != لاشيء)
        اطبع_سطر(عادة2.الرمز + " " + عادة2.الاسم + " 🔥" + عادة2.السلسلة)
    نهاية
    
    اطبع_سطر("")
    اطبع_سطر("--- إضافة مهمة جديدة ---")
    
    # إضافة مهمة
    التطبيق.أضف_مهمة("مراجعة الكود"، "عالية"، "proj1")
    
    اطبع_سطر("")
    اطبع_سطر("--- إكمال مهمة ---")
    
    # إكمال مهمة
    التطبيق.أكمل_مهمة("task3")
    
    اطبع_سطر("")
    اطبع_سطر("--- تسجيل إكمال عادة ---")
    
    # تسجيل عادة
    التطبيق.سجل_إكمال_عادة("habit1")
    
    اطبع_سطر("")
    اطبع_سطر("--- الإحصائيات ---")
    
    # عرض الإحصائيات
    التطبيق.اعرض_الإحصائيات()
    
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════")
    اطبع_سطر("      ✓ اكتمل الاختبار بنجاح")
    اطبع_سطر("═══════════════════════════════════════")
    
    # تحرير الموارد
    التطبيق.حرر()
نهاية

