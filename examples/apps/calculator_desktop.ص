        هذا.السجل = []
    نهاية

    # إدخال رقم
    دالة ادخل_رقم(رقم)
        إذا (هذا.بداية_جديدة)
            هذا.الشاشة = نص(رقم)
            هذا.بداية_جديدة = خطأ
        وإلا
            إذا (هذا.الشاشة == "0")
                هذا.الشاشة = نص(رقم)
            وإلا
                هذا.الشاشة = هذا.الشاشة + نص(رقم)
            نهاية
        نهاية
        هذا.القيمة_الحالية = عدد(هذا.الشاشة)
    نهاية

    # إدخال نقطة عشرية
    دالة ادخل_نقطة()
        إذا (هذا.بداية_جديدة)
            هذا.الشاشة = "0."
            هذا.بداية_جديدة = خطأ
        وإلا
            # تحقق من عدم وجود نقطة مسبقاً
            متغير يوجد_نقطة = خطأ
            لكل حرف في هذا.الشاشة
                إذا (حرف == ".")
                    يوجد_نقطة = صحيح
                نهاية
            نهاية
            إذا (ليس يوجد_نقطة)
                هذا.الشاشة = هذا.الشاشة + "."
            نهاية
        نهاية
    نهاية

    # تعيين العملية
    دالة عيّن_عملية(عملية)
        هذا.احسب()
        هذا.القيمة_السابقة = هذا.القيمة_الحالية
        هذا.العملية = عملية
        هذا.بداية_جديدة = صحيح
    نهاية

    # حساب النتيجة
    دالة احسب()
        متغير النتيجة = 0

        إذا (هذا.العملية == "+")
            النتيجة = هذا.القيمة_السابقة + هذا.القيمة_الحالية
        وإلا
            إذا (هذا.العملية == "-")
                النتيجة = هذا.القيمة_السابقة - هذا.القيمة_الحالية
            وإلا
                إذا (هذا.العملية == "*")
                    النتيجة = هذا.القيمة_السابقة * هذا.القيمة_الحالية
                وإلا
                    إذا (هذا.العملية == "/")
                        إذا (هذا.القيمة_الحالية != 0)
                            النتيجة = هذا.القيمة_السابقة / هذا.القيمة_الحالية
                        وإلا
                            هذا.الشاشة = "خطأ: قسمة على صفر"
                            هذا.بداية_جديدة = صحيح
                            ارجع
                        نهاية
                    وإلا
                        إذا (هذا.العملية == "%")
                            النتيجة = هذا.القيمة_السابقة % هذا.القيمة_الحالية
                        وإلا
                            ارجع
                        نهاية
                    نهاية
                نهاية
            نهاية
        نهاية

        # حفظ في السجل
        إذا (هذا.العملية != "")
            متغير سجل = نص(هذا.القيمة_السابقة) + " " + هذا.العملية + " " + نص(هذا.القيمة_الحالية) + " = " + نص(النتيجة)
            # إضافة للسجل - يمكن إضافة push لاحقاً
        نهاية

        هذا.القيمة_الحالية = النتيجة
        هذا.الشاشة = نص(النتيجة)
        هذا.العملية = ""
        هذا.بداية_جديدة = صحيح
    نهاية

    # مسح كامل
    دالة مسح()
        هذا.الشاشة = "0"
        هذا.القيمة_الحالية = 0
        هذا.القيمة_السابقة = 0
        هذا.العملية = ""
        هذا.بداية_جديدة = صحيح
    نهاية

    # مسح الإدخال الحالي
    دالة مسح_إدخال()
        هذا.الشاشة = "0"
        هذا.القيمة_الحالية = 0
        هذا.بداية_جديدة = صحيح
    نهاية

    # تبديل الإشارة
    دالة تبديل_إشارة()
        هذا.القيمة_الحالية = هذا.القيمة_الحالية * -1
        هذا.الشاشة = نص(هذا.القيمة_الحالية)
    نهاية

    # حذف آخر رقم
    دالة حذف()
        إذا (طول(هذا.الشاشة) > 1)
            # إزالة آخر حرف
            متغير نص_معدل = ""
            لكل ي في نطاق(0، طول(هذا.الشاشة) - 1)
                نص_معدل = نص_معدل + هذا.الشاشة[ي]
            نهاية
            هذا.الشاشة = نص_معدل
            هذا.القيمة_الحالية = عدد(هذا.الشاشة)
        وإلا
            هذا.الشاشة = "0"
            هذا.القيمة_الحالية = 0
        نهاية
    نهاية
نهاية

