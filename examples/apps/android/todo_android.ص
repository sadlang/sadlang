# ═══════════════════════════════════════════
# نموذج البيانات
# ═══════════════════════════════════════════

صنف مهمة
    باني(العنوان، الوصف)
        هذا.المعرف = 0
        هذا.العنوان = العنوان
        هذا.الوصف = الوصف
        هذا.مكتملة = خطأ
        هذا.الأولوية = "عادية"
        هذا.التاريخ = ""
    نهاية

    دالة اكتمل()
        هذا.مكتملة = صحيح
    نهاية

    دالة الغ_اكتمال()
        هذا.مكتملة = خطأ
    نهاية

    دالة عيّن_أولوية(أولوية)
        هذا.الأولوية = أولوية
    نهاية

    دالة نص_عرض()
        متغير الرمز = "⬜"
        إذا (هذا.مكتملة)
            الرمز = "✅"
        نهاية
        
        متغير علامة = ""
        إذا (هذا.الأولوية == "عالية")
            علامة = " 🔴"
        وإلا
            إذا (هذا.الأولوية == "متوسطة")
                علامة = " 🟡"
            نهاية
        نهاية
        
        ارجع الرمز + " " + هذا.العنوان + علامة
    نهاية
نهاية

# ═══════════════════════════════════════════
# مدير المهام
# ═══════════════════════════════════════════

صنف مدير_المهام
    باني()
        هذا.المهام = []
        هذا.المعرف_التالي = 1
    نهاية

    دالة اضف(العنوان، الوصف)
        متغير م = جديد مهمة(العنوان، الوصف)
        م.المعرف = هذا.المعرف_التالي
        هذا.المعرف_التالي = هذا.المعرف_التالي + 1
        هذا.المهام = هذا.المهام + [م]
        ارجع م
    نهاية

    دالة احذف(المعرف)
        متغير مهام_محدثة = []
        لكل م في هذا.المهام
            إذا (م.المعرف != المعرف)
                مهام_محدثة = مهام_محدثة + [م]
            نهاية
        نهاية
        هذا.المهام = مهام_محدثة
    نهاية

    دالة اكتمل(المعرف)
        لكل م في هذا.المهام
            إذا (م.المعرف == المعرف)
                م.اكتمل()
            نهاية
        نهاية
    نهاية

    دالة الغ_اكتمال(المعرف)
        لكل م في هذا.المهام
            إذا (م.المعرف == المعرف)
                م.الغ_اكتمال()
            نهاية
        نهاية
    نهاية

    دالة عدد_الكل()
        ارجع طول(هذا.المهام)
    نهاية

    دالة عدد_المكتملة()
        متغير عدد = 0
        لكل م في هذا.المهام
            إذا (م.مكتملة)
                عدد = عدد + 1
            نهاية
        نهاية
        ارجع عدد
    نهاية

    دالة عدد_المتبقية()
        ارجع هذا.عدد_الكل() - هذا.عدد_المكتملة()
    نهاية

    دالة المتبقية()
        متغير نتائج = []
        لكل م في هذا.المهام
            إذا (ليس م.مكتملة)
                نتائج = نتائج + [م]
            نهاية
        نهاية
        ارجع نتائج
    نهاية

    دالة المكتملة()
        متغير نتائج = []
        لكل م في هذا.المهام
            إذا (م.مكتملة)
                نتائج = نتائج + [م]
            نهاية
        نهاية
        ارجع نتائج
    نهاية

    دالة العالية_الأولوية()
        متغير نتائج = []
        لكل م في هذا.المهام
            إذا (م.الأولوية == "عالية" و ليس م.مكتملة)
                نتائج = نتائج + [م]
            نهاية
        نهاية
        ارجع نتائج
    نهاية

    دالة اعرض_الكل()
        إذا (طول(هذا.المهام) == 0)
            اطبع("  📭 لا توجد مهام")
            ارجع
        نهاية
        لكل م في هذا.المهام
            اطبع("  " + م.نص_عرض())
        نهاية
    نهاية

    دالة ملخص()
        اطبع("📊 الملخص: " + نص(هذا.عدد_الكل()) + " مهمة — " + نص(هذا.عدد_المكتملة()) + " مكتملة، " + نص(هذا.عدد_المتبقية()) + " متبقية")
    نهاية
نهاية

