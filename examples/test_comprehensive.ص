# اختبار شامل لمزايا لغة ص

دالة رئيسية()
    # المتغيرات والأنواع الأساسية
    رقم س = 10
    رقم ص = 20
    نص اسم = "أحمد"
    
    اطبع("=== اختبار شامل للغة ص ===")
    اطبع("")
    
    # اختبار المتغيرات
    اطبع("المتغيرات:")
    اطبع(س)
    اطبع(ص)
    اطبع(اسم)
    اطبع("")
    
    # العمليات الحسابية
    رقم أ = 15
    رقم ب = 4
    
    اطبع("العمليات الحسابية:")
    اطبع(أ + ب)
    اطبع(أ - ب)
    اطبع(أ * ب)
    اطبع("")
    
    # اختبار الشروط
    رقم عمر = 25
    
    اطبع("اختبار الشروط:")
    إذا (عمر >= 18)
        اطبع("بالغ")
    وإلا
        اطبع("قاصر")
    نهاية
    اطبع("")
    
    # اختبار حلقة while
    اطبع("العد من 0 الى 2:")
    رقم ع = 0
    بينما (ع < 3)
        اطبع(ع)
        ع = ع + 1
    نهاية
    اطبع("")
    
    # اختبار حلقة for
    اطبع("العد في مصفوفة:")
    مصفوفة أرقام = [1، 2، 3، 4، 5]
    رقم مجموع = 0
    لكل (ع في أرقام)
        مجموع = مجموع + ع
    نهاية
    اطبع("المجموع:")
    اطبع(مجموع)
    اطبع("")
    
    اطبع("=== انتهى الاختبار بنجاح ===")
    ارجع 0
نهاية
