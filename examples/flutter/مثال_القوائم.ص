#  قائمة المهام
# ═══════════════════════════════════════════════════════════════

صنف صفحة_المهام يرث مكون_بحالة
    
    صنف الحالة يرث حالة
        متغير المهام = [
            "تعلم لغة ص"،
            "بناء تطبيق Flutter"،
            "اختبار المكونات"،
            "نشر التطبيق"،
            "مشاركة الكود"
        ]
        
        دالة اضف_مهمة(نص_المهمة)
            عيّن_حالة(دالة()
                المهام.اضف(نص_المهمة)
            نهاية)
        نهاية
        
        دالة احذف_مهمة(الفهرس)
            عيّن_حالة(دالة()
                المهام.احذف_عند(الفهرس)
            نهاية)
        نهاية
        
        دالة بناء(سياق)
            ارجع هيكل(
                شريط_تطبيق: شريط(عنوان: "قائمة المهام")،
                جسم: قائمة_عرض.باني(
                    عدد_العناصر: المهام.طول()،
                    باني_عنصر: دالة(سياق، فهرس)
                        ارجع بطاقة(
                            هامش: حواف.كل(8)،
                            ابن: عنصر_قائمة(
                                عنوان: نص(المهام[فهرس])،
                                قيادة: ايقونة(ايقونة.مهمة)،
                                متابعة: زر_ايقونة(
                                    ايقونة: ايقونة(ايقونة.حذف، لون: الالوان.احمر)،
                                    عند_الضغط: دالة()
                                        احذف_مهمة(فهرس)
                                    نهاية
                                )
                            )
                        )
                    نهاية
                )،
                زر_عائم: زر_عائم(
                    ابن: ايقونة(ايقونة.اضافة)،
                    عند_الضغط: دالة()
                        اظهر_حوار(
                            سياق: سياق،
                            باني: دالة(سياق)
                                ارجع حوار_ادخال(
                                    عنوان: "مهمة جديدة"،
                                    تلميح: "أدخل نص المهمة"،
                                    عند_الحفظ: دالة(نص)
                                        اضف_مهمة(نص)
                                    نهاية
                                )
                            نهاية
                        )
                    نهاية
                )
            )
        نهاية
    نهاية
    
    دالة انشئ_حالة()
        ارجع جديد الحالة()
    نهاية
نهاية

