# ═══════════════════════════════════════════════════════════════
#  العداد — مكون بحالة
# ═══════════════════════════════════════════════════════════════

صنف صفحة_العداد يرث مكون_بحالة
    
    صنف الحالة يرث حالة
        متغير العداد = 0
        
        دالة زيادة()
            عيّن_حالة(دالة()
                العداد = العداد + 1
            نهاية)
        نهاية
        
        دالة نقصان()
            عيّن_حالة(دالة()
                إذا (العداد > 0)
                    العداد = العداد - 1
                نهاية
            نهاية)
        نهاية
        
        دالة إعادة_تعيين()
            عيّن_حالة(دالة()
                العداد = 0
            نهاية)
        نهاية
        
        دالة بناء(سياق)
            ارجع هيكل(
                شريط_تطبيق: شريط(
                    عنوان: "العداد"،
                    اجراءات: [
                        زر_ايقونة(
                            ايقونة: ايقونة.اعادة_تعيين،
                            عند_الضغط: إعادة_تعيين
                        )
                    ]
                )،
                جسم: مركز(
                    ابن: عمود(
                        محاذاة_رئيسية: محاذاة.مركز،
                        ابناء: [
                            نص("القيمة الحالية:")،
                            صندوق(ارتفاع: 10)،
                            نص_كبير(العداد.الى_نص()، نمط: نمط_نص(حجم: 72))،
                            صندوق(ارتفاع: 30)،
                            صف(
                                محاذاة_رئيسية: محاذاة.مركز،
                                ابناء: [
                                    زر_عائم(
                                        ابن: ايقونة(ايقونة.ناقص)،
                                        عند_الضغط: نقصان،
                                        تلميح: "نقصان"
                                    )،
                                    صندوق(عرض: 20)،
                                    زر_عائم(
                                        ابن: ايقونة(ايقونة.زائد)،
                                        عند_الضغط: زيادة،
                                        تلميح: "زيادة"
                                    )
                                ]
                            )
                        ]
                    )
                )
            )
        نهاية
    نهاية
    
    دالة انشئ_حالة()
        ارجع جديد الحالة()
    نهاية
نهاية

# نقطة الدخول
دالة رئيسية()
    شغل(
        تطبيق_ماتيريال(
            عنوان: "مثال العداد"،
            ثيم: بيانات_ثيم.فاتح()،
            الصفحة_الرئيسية: جديد صفحة_العداد()
        )
    )
نهاية
