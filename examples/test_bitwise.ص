    # اختبار الضرب المتسلسل بـ ×
    متغير أ = 3
    متغير ب = 5
    متغير ج = 7
    متغير ناتج1 = أ × ب × ج
    اطبع_سطر("أ × ب × ج = " + ناتج1)   # يجب: 105

    # اختبار داخل الأقواس
    متغير ناتج2 = (أ × ب) × ج
    اطبع_سطر("(أ × ب) × ج = " + ناتج2)  # يجب: 105

    # اختبار XOR
    متغير س = 255
    متغير ص = 15
    متغير xor_ناتج = س ^ ص
    اطبع_سطر("255 ^ 15 = " + xor_ناتج)  # يجب: 240

    # اختبار OR البتّي
    متغير or_ناتج = 12 | 10
    اطبع_سطر("12 | 10 = " + or_ناتج)   # يجب: 14

    # اختبار الإزاحة
    متغير shift_ناتج = 1 << 4
    اطبع_سطر("1 << 4 = " + shift_ناتج)  # يجب: 16

    متغير rshift_ناتج = 256 >> 3
    اطبع_سطر("256 >> 3 = " + rshift_ناتج)  # يجب: 32
