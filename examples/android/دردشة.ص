# تطبيق دردشة بسيط - مثال على أندرويد
# Simple Chat App - Android Example

صنف تطبيق_دردشة
    باني()
        هذا.الرسائل = []
        هذا.اسم_المستخدم = "مستخدم"
    نهاية
    
    دالة أرسل_رسالة(نص)
        متغير رسالة = {
            "المرسل": هذا.اسم_المستخدم،
            "النص": نص،
            "الوقت": الآن()
        }
        هذا.الرسائل.أضف(رسالة)
        ارجع رسالة
    نهاية
    
    دالة اعرض_الرسائل()
        لكل رسالة في هذا.الرسائل
            اطبع_سطر(رسالة.المرسل + ": " + رسالة.النص)
        نهاية
    نهاية
نهاية

# نقطة الدخول الرئيسية
دالة رئيسية()
    متغير تطبيق = جديد تطبيق_دردشة()
    تطبيق.أرسل_رسالة("مرحباً بالعالم!")
    تطبيق.أرسل_رسالة("هذا تطبيق دردشة بلغة ص")
    تطبيق.اعرض_الرسائل()
نهاية
