# تطبيق مهامي - قائمة مهام بلغة ص
# يستخدم جسور Android المتعددة

استورد "android/ui/شريحة"
استورد "android/storage/تفضيلات"
استورد "android/notifications/إشعارات"
استورد "android/haptic/لمس"
استورد "android/date/تاريخ"
استورد "android/dialog/حوار"
استورد "android/toast/رسائل"
استورد "android/theme/سمة"

# ═══════════════════════════════════════════════════════════════
#                          نموذج البيانات
# ═══════════════════════════════════════════════════════════════

بنية مهمة {
    معرف: نص
    عنوان: نص
    مكتملة: منطقي
    تاريخ_الإنشاء: رقم
    تاريخ_الاستحقاق: رقم      # اختياري
    أولوية: رقم              # 1=عالية، 2=متوسطة، 3=منخفضة
}

# ═══════════════════════════════════════════════════════════════
#                       مدير المهام
# ═══════════════════════════════════════════════════════════════

صنف مدير_المهام {
    خاص متغير المهام: مصفوفة<مهمة> = []
    خاص متغير التفضيلات: تفضيلات
    
    باني() {
        التفضيلات = تفضيلات.جديد("مهامي_db")
        تحميل_المهام()
    نهاية
    
    # حفظ وتحميل من التخزين المحلي
    خاص دالة تحميل_المهام() {
        متغير json = التفضيلات.احصل("المهام"، "[]")
        المهام = من_json(json)
    نهاية
    
    خاص دالة حفظ_المهام() {
        متغير json = إلى_json(المهام)
        التفضيلات.عيّن("المهام"، json)
    نهاية
    
    # عمليات CRUD
    دالة أضف_مهمة(عنوان: نص، أولوية: رقم = 2) {
        متغير م = مهمة {
            معرف: uuid()،
            عنوان: عنوان،
            مكتملة: خطأ،
            تاريخ_الإنشاء: الآن()،
            تاريخ_الاستحقاق: 0،
            أولوية: أولوية
        }
        المهام.أضف(م)
        حفظ_المهام()
        
        # إظهار رسالة توكيد
        رسائل.قصيرة("تمت إضافة المهمة ✓")
        لمس.نقرة()
    نهاية
    
    دالة أكمل_مهمة(معرف: نص) {
        لكل م في المهام {
            إذا (م.معرف == معرف) {
                م.مكتملة = صحيح
                حفظ_المهام()
                
                # اهتزاز تأكيد
                لمس.نجاح()
                رسائل.قصيرة("أحسنت! 🎉")
                ارجع
            نهاية
        نهاية
    نهاية
    
    دالة احذف_مهمة(معرف: نص) {
        المهام = المهام.رشح(دالة(م) { ارجع م.معرف != معرف })
        حفظ_المهام()
        لمس.نقرة()
    نهاية
    
    دالة المهام_النشطة() -> مصفوفة<مهمة> {
        ارجع المهام.رشح(دالة(م) { ارجع ليس م.مكتملة })
    نهاية
    
    دالة المهام_المكتملة() -> مصفوفة<مهمة> {
        ارجع المهام.رشح(دالة(م) { ارجع م.مكتملة })
    نهاية
    
    دالة عدد_النشطة() -> رقم {
        ارجع المهام_النشطة().طول
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════
#                       الواجهة الرئيسية
# ═══════════════════════════════════════════════════════════════

واجهة تطبيق_مهامي {
    @حالة مدير: مدير_المهام = مدير_المهام.جديد()
    @حالة نص_جديد: نص = ""
    @حالة تبويب_حالي: رقم = 0   # 0=نشطة، 1=مكتملة
    @حالة سمة_داكنة: منطقي = خطأ
    
    عرض() {
        متغير ألوان = إذا (سمة_داكنة) سمة.داكنة وإلا سمة.فاتحة
        
        هيكل(سمة: ألوان) {
            # ═══════ شريط التطبيق ═══════
            شريط_تطبيق("📝 مهامي") {
                أيقونة(إذا (سمة_داكنة) "☀️" وإلا "🌙") {
                    سمة_داكنة = ليس سمة_داكنة
                    لمس.نقرة()
                }
            }
            
            عمود(حشوة: 16) {
                # ═══════ حقل إدخال مهمة جديدة ═══════
                صف(تباعد: 8) {
                    حقل_نص("أضف مهمة جديدة...")
                        .قيمة(نص_جديد)
                        .عند_التغيير { نص_جديد = $0 }
                        .مرن(1)
                    
                    زر_دائري("+") {
                        إذا (نص_جديد.طول > 0) {
                            مدير.أضف_مهمة(نص_جديد)
                            نص_جديد = ""
                        نهاية
                    }
                    .لون_خلفية(ألوان.أساسي)
                }
                
                فاصل(ارتفاع: 16)
                
                # ═══════ التبويبات ═══════
                تبويبات(تبويب_حالي) {
                    تبويب("نشطة (" + مدير.عدد_النشطة() + ")")
                    تبويب("مكتملة")
                }
                .عند_التغيير { تبويب_حالي = $0 }
                
                فاصل(ارتفاع: 8)
                
                # ═══════ قائمة المهام ═══════
                إذا (تبويب_حالي == 0) {
                    عرض_المهام_النشطة()
                } وإلا {
                    عرض_المهام_المكتملة()
                }
            }
            
            # ═══════ زر عائم ═══════
            زر_عائم("🔔") {
                جدول_إشعارات()
            }
        }
    }
    
    # مكون عرض المهام النشطة
    دالة عرض_المهام_النشطة() {
        متغير مهام = مدير.المهام_النشطة()
        
        إذا (مهام.طول == 0) {
            وسط {
                عمود(محاذاة: .وسط) {
                    نص("🎉")
                        .حجم_خط(64)
                    نص("لا توجد مهام!")
                        .حجم_خط(20)
                        .لون(.رمادي)
                }
            }
        } وإلا {
            قائمة_تمرير {
                لكل م في مهام {
                    بطاقة_مهمة(م، نشطة: صحيح)
                }
            }
        }
    }
    
    # مكون عرض المهام المكتملة
    دالة عرض_المهام_المكتملة() {
        متغير مهام = مدير.المهام_المكتملة()
        
        إذا (مهام.طول == 0) {
            وسط {
                نص("لم تكمل أي مهمة بعد")
                    .لون(.رمادي)
            }
        } وإلا {
            قائمة_تمرير {
                لكل م في مهام {
                    بطاقة_مهمة(م، نشطة: خطأ)
                }
            }
        }
    }
    
    # مكون بطاقة مهمة واحدة
    دالة بطاقة_مهمة(م: مهمة، نشطة: منطقي) {
        بطاقة(حشوة: 12، هامش: 4) {
            صف(تباعد: 12) {
                # أيقونة الحالة
                أيقونة_قابلة_للضغط(
                    إذا (م.مكتملة) "✓" وإلا "○"
                ) {
                    إذا (نشطة) {
                        مدير.أكمل_مهمة(م.معرف)
                    نهاية
                }
                .لون(إذا (م.مكتملة) .أخضر وإلا .رمادي)
                
                # نص المهمة
                عمود(مرن: 1) {
                    نص(م.عنوان)
                        .حجم_خط(16)
                        .خط_وسط(م.مكتملة)
                    
                    نص(صيغة_تاريخ(م.تاريخ_الإنشاء))
                        .حجم_خط(12)
                        .لون(.رمادي)
                }
                
                # أيقونة الأولوية
                إذا (ليس م.مكتملة) {
                    نص(رمز_الأولوية(م.أولوية))
                }
                
                # زر الحذف
                أيقونة_قابلة_للضغط("🗑️") {
                    حوار.تأكيد(
                        "حذف المهمة؟"،
                        "هل تريد حذف هذه المهمة نهائياً؟"،
                        دالة() {
                            مدير.احذف_مهمة(م.معرف)
                        }
                    )
                }
            }
        }
        .عند_السحب_يمين {
            مدير.أكمل_مهمة(م.معرف)
        }
        .عند_السحب_يسار {
            مدير.احذف_مهمة(م.معرف)
        }
    }
    
    # جدولة إشعار يومي للتذكير
    دالة جدول_إشعارات() {
        متغير عدد = مدير.عدد_النشطة()
        
        إذا (عدد > 0) {
            إشعارات.جدول(
                عنوان: "مهامي",
                محتوى: "لديك " + عدد + " مهمة تنتظرك!",
                وقت: الغد_صباحاً(8)،
                أيقونة: "📝"
            )
            رسائل.قصيرة("سيتم تذكيرك غداً ⏰")
        } وإلا {
            رسائل.قصيرة("لا توجد مهام للتذكير بها")
        نهاية
    }
    
    # دوال مساعدة
    دالة رمز_الأولوية(أولوية: رقم) -> نص {
        طابق (أولوية) {
            عندما 1: ارجع "🔴"   # عالية
            عندما 2: ارجع "🟡"   # متوسطة
            عندما 3: ارجع "🟢"   # منخفضة
            افتراضي: ارجع ""
        }
    }
    
    دالة صيغة_تاريخ(طابع: رقم) -> نص {
        متغير ت = تاريخ.من_طابع(طابع)
        ارجع ت.نسق("yyyy/MM/dd")
    نهاية
نهاية

# ═══════════════════════════════════════════════════════════════
#                          نقطة الدخول
# ═══════════════════════════════════════════════════════════════

دالة رئيسية() {
    # تهيئة قناة الإشعارات
    إشعارات.إنشاء_قناة(
        معرف: "reminders"،
        اسم: "تذكيرات"،
        وصف: "إشعارات تذكير المهام"
    )
    
    # تشغيل التطبيق
    تطبيق_مهامي.تشغيل()
نهاية
