## مثال واجهة بلغة ص
## عداد بسيط مع إدخال نص

واجهة تطبيق_عداد {
    @حالة عداد: عدد = ٠
    @حالة رسالة: نص = "مرحباً"
    
    عرض() {
        هيكل {
            شريط_تطبيق("عداد لغة ص")
            
            عمود(حشوة: ١٦، تباعد: ١٢) {
                نص("مرحباً بك في لغة ص!")
                    .حجم_خط(٢٤)
                    .سمك_خط(.غامق)
                    .لون(.أزرق)
                
                بطاقة {
                    عمود(حشوة: ١٦) {
                        نص("لغة ص — لغة البرمجة العربية")
                            .حجم_خط(١٨)
                        نص("أول لغة تدعم أندرويد بالكامل")
                            .لون(.رمادي)
                    }
                }
                
                فاصل(ارتفاع: ٣٢)
                
                صف(تباعد: ١٦) {
                    زر_أيقونة("−") { عداد = عداد - ١ }
                    نص("\(عداد)")
                        .حجم_خط(٤٨)
                        .سمك_خط(.غامق)
                    زر_أيقونة("+") { عداد = عداد + ١ }
                }
                
                زر("إعادة تعيين") { عداد = ٠ }
                    .لون_خلفية(.برتقالي)
                
                فاصل(مملوء)
                
                حقل_نص("أدخل رسالة...")
                    .قيمة(رسالة)
                    .عند_التغيير { رسالة = $٠ }
                
                نص(رسالة)
                    .لون(.رمادي)
            }
        }
    }
}
