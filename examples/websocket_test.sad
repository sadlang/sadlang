// بسم الله الرحمن الرحيم
/**
 * @file websocket_test.sad
 * @brief WebSocket Test Example - مثال اختبار WebSocket
 * 
 * برنامج بسيط لاختبار WebSocket في لغة ص
 * Simple program to test WebSocket in Sad Language
 * 
 * @author Sad Language Team
 * @date December 2025
 */

استيراد "http"

دالة البداية() {
    اطبع("🔌 اختبار WebSocket - WebSocket Test\n")
    اطبع("===============================\n\n")
    
    // إنشاء اتصال WebSocket / Create WebSocket connection
    اطبع("📡 جاري الاتصال بخادم WebSocket...\n")
    
    متغير ws = http.WebSocket()
    
    // تعيين معالج الاتصال / Set connect handler
    ws.on_connect(دالة() {
        اطبع("✅ تم الاتصال بنجاح!\n")
    })
    
    // تعيين معالج الرسائل / Set message handler
    ws.on_message(دالة(رسالة، نوع) {
        اطبع("📨 رسالة واردة: ")
        اطبع(رسالة)
        اطبع("\n")
    })
    
    // تعيين معالج الإغلاق / Set close handler
    ws.on_close(دالة() {
        اطبع("🔴 تم إغلاق الاتصال\n")
    })
    
    // محاولة الاتصال / Attempt connection
    // ملاحظة: يحتاج خادم WebSocket حقيقي للاختبار
    // Note: Requires a real WebSocket server for testing
    
    متغير url = "ws://echo.websocket.org/"
    
    إذا (ws.connect(url)) {
        اطبع("🎉 الاتصال ناجح!\n\n")
        
        // إرسال رسالة نصية / Send text message
        اطبع("📤 إرسال رسالة نصية...\n")
        ws.send_text("مرحباً من لغة ص! Hello from Sad!")
        
        // استقبال رسالة / Receive message
        اطبع("📥 انتظار الرسائل...\n")
        متغير reply = ws.receive()
        
        إذا (reply != "") {
            اطبع("📬 تم استقبال: ")
            اطبع(reply)
            اطبع("\n")
        }
        
        // إرسال رسالة ثنائية / Send binary message
        اطبع("\n📤 إرسال رسالة ثنائية...\n")
        متغير data = [72, 101, 108, 108, 111]  // "Hello" in ASCII
        ws.send_binary(data)
        
        // فحص وجود رسائل / Check for messages
        إذا (ws.has_message()) {
            اطبع("✅ هناك رسائل في الطابور\n")
        }
        
        // إغلاق الاتصال / Close connection
        اطبع("\n🔚 إغلاق الاتصال...\n")
        ws.close()
        
    } وإلا {
        اطبع("❌ فشل الاتصال!\n")
        اطبع("ℹ️  تأكد من توفر خادم WebSocket على العنوان: ")
        اطبع(url)
        اطبع("\n")
    }
    
    اطبع("\n✨ انتهى الاختبار\n")
    اطبع("الحمد لله رب العالمين\n")
}

// ============================================================================
// مثال استخدام متقدم / Advanced Usage Example
// ============================================================================

دالة مثال_websocket_متقدم() {
    اطبع("🚀 مثال WebSocket متقدم\n")
    اطبع("======================\n\n")
    
    متغير ws = http.WebSocket()
    متغير messages_received = 0
    
    // معالج رسائل مع عداد / Message handler with counter
    ws.on_message(دالة(msg، type) {
        messages_received = messages_received + 1
        اطبع("📨 رسالة ")
        اطبع(messages_received)
        اطبع(": ")
        اطبع(msg)
        اطبع("\n")
    })
    
    // الاتصال وإرسال عدة رسائل / Connect and send multiple messages
    إذا (ws.connect("ws://echo.websocket.org/")) {
        اطبع("✅ متصل! إرسال 5 رسائل...\n\n")
        
        متغير i = 1
        بينما (i <= 5) {
            متغير message = "رسالة رقم " + نص(i)
            ws.send_text(message)
            
            // استقبال الرد / Receive reply
            متغير reply = ws.receive()
            
            i = i + 1
        }
        
        اطبع("\n📊 الإحصائيات:\n")
        اطبع("   - رسائل مستقبلة: ")
        اطبع(messages_received)
        اطبع("\n")
        
        ws.close()
        اطبع("✅ تم بنجاح!\n")
    }
}

// ============================================================================
// Chat Client Example - مثال عميل دردشة
// ============================================================================

دالة websocket_chat_client() {
    اطبع("💬 عميل دردشة WebSocket\n")
    اطبع("=======================\n\n")
    
    متغير ws = http.WebSocket()
    متغير username = "مستخدم_" + نص(عشوائي(1000))
    
    ws.on_connect(دالة() {
        اطبع("✅ متصل بخادم الدردشة\n")
        اطبع("👤 اسم المستخدم: ")
        اطبع(username)
        اطبع("\n\n")
    })
    
    ws.on_message(دالة(msg، type) {
        اطبع("💬 ")
        اطبع(msg)
        اطبع("\n")
    })
    
    ws.on_close(دالة() {
        اطبع("\n👋 تم قطع الاتصال\n")
    })
    
    // Note: Replace with actual chat server URL
    متغير chat_server = "ws://localhost:8080/chat"
    
    إذا (ws.connect(chat_server)) {
        // إرسال رسالة انضمام / Send join message
        ws.send_text("انضم: " + username)
        
        // محاكاة إرسال رسائل / Simulate sending messages
        ws.send_text("مرحباً بالجميع!")
        ws.send_text("كيف حالكم؟")
        
        // استقبال الردود / Receive replies
        بينما (ws.is_open()) {
            إذا (ws.has_message()) {
                متغير msg = ws.receive()
            }
        }
        
        ws.close()
    } وإلا {
        اطبع("❌ لا يمكن الاتصال بخادم الدردشة\n")
    }
}

// الحمد لله رب العالمين
