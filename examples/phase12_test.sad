    اكتب("")
    
    اكتب("If FIN=0 (fragmented):")
    اكتب("  • Store payload in fragmented_message")
    اكتب("  • Set fragmented_type = Text")
    اكتب("  • Return empty string")
    اكتب("")
    
    اكتب("If FIN=1 (complete):")
    اكتب("  • Process immediately")
    اكتب("  • Add to queue")
    اكتب("  • Call message_handler")
    اكتب("  • Return message")
    اكتب("")
}

