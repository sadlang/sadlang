    اكتب("")
    
    اكتب("Phases:")
    اكتب("  1. Calculate new addresses - حساب العناوين الجديدة")
    اكتب("  2. Allocate new space - تخصيص مساحة جديدة")
    اكتب("  3. Copy objects - نسخ الكائنات")
    اكتب("  4. Update references - تحديث المراجع")
    اكتب("  5. Free old heap - تحرير الكومة القديمة")
    اكتب("")
    
    اكتب("Benefits:")
    اكتب("  ✓ Reduces memory fragmentation")
    اكتب("  ✓ Improves cache performance")
    اكتب("  ✓ Better memory locality")
    اكتب("  ✓ Configurable (enable_compaction)")
    اكتب("")
}

// ==== اختبار 2: خوارزمية الضغط ====
// ==== Test 2: Compaction algorithm ====
دالة test_compaction_algorithm() {
    اكتب("=== اختبار 2: خوارزمية الضغط ===")
    اكتب("=== Test 2: Compaction algorithm ===")
    اكتب("")
    
    اكتب("Algorithm details:")
    اكتب("")
    
    اكتب("Phase 1 - Calculate new addresses:")
    اكتب("  • Iterate through live objects")
    اكتب("  • Calculate offset for each object")
    اكتب("  • Store in forwarding_address field")
    اكتب("")
    
    اكتب("Phase 2 - Allocate new space:")
    اكتب("  • Allocate contiguous memory")
    اكتب("  • Size = sum of all live objects")
    اكتب("  • Fallback if allocation fails")
    اكتب("")
    
    اكتب("Phase 3 - Copy objects:")
    اكتب("  • memcpy each object to new location")
    اكتب("  • Update forwarding_address to actual pointer")
    اكتب("  • Preserve object state and data")
    اكتب("")
    
    اكتب("Phase 4 - Update references:")
    اكتب("  • Update all GC roots")
    اكتب("  • Update linked list pointers")
    اكتب("  • Call trace_fn for internal references")
    اكتب("")
    
    اكتب("Phase 5 - Cleanup:")
    اكتب("  • Update objects_list_ pointer")
    اكتب("  • Update statistics")
    اكتب("  • Calculate freed memory")
    اكتب("")
}

