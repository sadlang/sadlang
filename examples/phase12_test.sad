// ==== اختبار 5: WebSocket Fragmented Messages ====
// ==== Test 5: WebSocket Fragmented Messages ====
دالة test_websocket_fragmentation() {
    اكتب("=== اختبار 5: رسائل WebSocket المجزأة ===")
    اكتب("=== Test 5: WebSocket Fragmented Messages ===")
    اكتب("")
    
    اكتب("RFC 6455 Fragmentation:")
    اكتب("  • Large messages can be split across frames")
    اكتب("  • FIN bit indicates last frame")
    اكتب("  • Opcode 0x0 = Continuation frame")
    اكتب("")
    
    اكتب("Implementation:")
    اكتب("  ✓ fragmented_message buffer (vector<uint8_t>)")
    اكتب("  ✓ fragmented_type tracking (Text/Binary)")
    اكتب("  ✓ Accumulate data from continuation frames")
    اكتب("  ✓ Complete message when FIN=1")
    اكتب("")
}

// ==== اختبار 6: معالجة Continuation Frames ====
// ==== Test 6: Continuation Frame handling ====
دالة test_continuation_frames() {
    اكتب("=== اختبار 6: معالجة Continuation Frames ===")
    اكتب("=== Test 6: Continuation Frame handling ===")
    اكتب("")
    
    اكتب("Frame sequence:")
    اكتب("  1. Initial frame (opcode 0x1 or 0x2, FIN=0)")
    اكتب("     → Store in fragmented_message")
    اكتب("     → Remember type in fragmented_type")
    اكتب("")
    
    اكتب("  2. Continuation frames (opcode 0x0, FIN=0)")
    اكتب("     → Append to fragmented_message")
    اكتب("")
    
    اكتب("  3. Final frame (opcode 0x0, FIN=1)")
    اكتب("     → Append to fragmented_message")
    اكتب("     → Complete message")
    اكتب("     → Add to queue")
    اكتب("     → Clear buffers")
    اكتب("")
}

