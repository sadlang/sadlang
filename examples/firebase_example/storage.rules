rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read, authenticated write for packages
    match /packages/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null &&
                       request.resource.contentType.matches('application/gzip|application/x-gzip');
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
                       resource.metadata.userId == request.auth.uid;
    }
    
    // User uploads - restricted to owner
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Temp files - clean up after 24 hours
    match /temp/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Archives - public read
    match /archives/{year}/{month}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
