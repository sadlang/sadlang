دالة test_calling_conventions() {
    اكتب("=== اختبار 6: نمط الاستدعاء ===")
    اكتب("=== Test 6: Calling conventions ===")
    اكتب("")
    
    اكتب("Supported conventions:")
    اكتب("  • System V x64 (Unix/Linux/macOS)")
    اكتب("  • Microsoft x64 (Windows)")
    اكتب("  • ARM64 AAPCS")
    
    اكتب("")
    اكتب("Platform detection:")
    
    // يتم تحديد المنصة عند البناء
    // Platform determined at build time
    #ifdef SAD_PLATFORM_WINDOWS
        اكتب("  ✓ Windows detected")
    #endif
    
    #ifdef SAD_PLATFORM_LINUX
        اكتب("  ✓ Linux detected")
    #endif
    
    #ifdef SAD_PLATFORM_MACOS
        اكتب("  ✓ macOS detected")
    #endif
    
    اكتب("")
}

