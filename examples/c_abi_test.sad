}

// ==== اختبار 3: استدعاء دالة بمعاملات متعددة ====
// ==== Test 3: Call function with multiple arguments ====
دالة test_multiple_args() {
    اكتب("=== اختبار 3: استدعاء بمعاملات متعددة ===")
    اكتب("=== Test 3: Multiple arguments call ===")
    اكتب("")
    
    متغير arg1 = 10
    متغير arg2 = 20
    متغير arg3 = 30
    
    اكتب("Arguments: " + نص(arg1) + ", " + نص(arg2) + ", " + نص(arg3))
    
    // Windows x64: RCX, RDX, R8 (first 3 args)
    // Unix x64: RDI, RSI, RDX (first 3 args)
    اكتب("✓ execute_call() handles 3 args on x64")
    اكتب("")
}

// ==== اختبار 4: تحويل أنواع مختلفة ====
// ==== Test 4: Convert different types ====
دالة test_type_conversion() {
    اكتب("=== اختبار 4: تحويل الأنواع ===")
    اكتب("=== Test 4: Type conversion ===")
    اكتب("")
    
    // Integer
    متغير int_val = 123
    اكتب("Integer: " + نص(int_val))
    اكتب("✓ Integer → Int64")
    
    // Float
    متغير float_val = 3.14
    اكتب("Float: " + نص(float_val))
    اكتب("✓ Float → Double")
    
    // Boolean
    متغير bool_val = صحيح
    اكتب("Boolean: " + نص(bool_val))
    اكتب("✓ Boolean → Int32")
    
    // String
    متغير str_val = "Hello C ABI"
    اكتب("String: " + str_val)
    اكتب("✓ String → const char*")
    
    اكتب("")
}

