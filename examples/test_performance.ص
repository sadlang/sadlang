# اختبار أداء: حلقة لكل على مصفوفة كبيرة
# Performance test: ForRange loop on large array

دالة إنشاء_مصفوفة(الحجم)
   متغير م = []
   متغير ع = 0
   بينما (ع < الحجم)
      م = م + [ع]
      ع = ع + 1
   نهاية
   ارجع م
نهاية

# اختبار 1: مجموع مصفوفة
متغير البيانات = إنشاء_مصفوفة(1000)
متغير المجموع = 0

لكل عنصر في البيانات
   المجموع = المجموع + عنصر
نهاية

اطبع_سطر("مجموع 1000 عنصر: " + المجموع)

# اختبار 2: تكرار على نص
متغير النص = "مرحباً بالعربية"
متغير عدد_الأحرف = 0

لكل حرف في النص
   عدد_الأحرف = عدد_الأحرف + 1
نهاية

اطبع_سطر("عدد أحرف النص: " + عدد_الأحرف)

# اختبار 3: دوال متعددة
دالة مضروب(ن)
   إذا (ن <= 1)
      ارجع 1
   نهاية
   ارجع ن * مضروب(ن - 1)
نهاية

متغير نتيجة = مضروب(10)
اطبع_سطر("مضروب 10 = " + نتيجة)

# اختبار 4: التعداد
تعداد الألوان
   أحمر
   أخضر
   أزرق
نهاية

اطبع_سطر("عدد الألوان: " + الألوان["__عدد__"])

اطبع_سطر("✅ جميع اختبارات الأداء نجحت!")
