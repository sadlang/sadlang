# مثال: تطبيق عداد — أبسط تطبيق تفاعلي بلغة ص
# ===================================================================
# يوضح استخدام:
#   - هيكل + شريط_تطبيق (بنية الصفحة)
#   - عمود + نص + زر (العناصر الأساسية)
#   - حالة_عنصر + عيّن_حالة (إدارة الحالة)
# ===================================================================

استورد * من رسومات.واجهات

# ─── تطبيق العداد ───
صنف تطبيق_عداد يرث حالة_عنصر
    متغير عداد = 0

    دالة بناء()
        ارجع جديد هيكل(
            عنوان: "عداد بلغة ص",
            شريط_علوي: جديد شريط_تطبيق(
                عنوان: "تطبيق العداد",
                لون_خلفية: "#2196F3"
            ),
            جسم: جديد حاوية(
                محاذاة: "وسط",
                ابن: جديد عمود([
                    جديد نص("عدد الضغطات:", حجم_الخط: 18, لون: رمادي_داكن),
                    جديد نص("" + هذا.عداد, حجم_الخط: 48, وزن: "عريض"),
                    جديد فاصل(مرونة: 1),
                    جديد صف([
                        جديد زر("➖ إنقاص", لون_خلفية: "#F44336", عند_الضغط: لامدا()
                            هذا.عيّن_حالة(لامدا()
                                هذا.عداد = هذا.عداد - 1
                            نهاية)
                        نهاية),
                        جديد فاصل(مرونة: 1),
                        جديد زر("➕ زيادة", لون_خلفية: "#4CAF50", عند_الضغط: لامدا()
                            هذا.عيّن_حالة(لامدا()
                                هذا.عداد = هذا.عداد + 1
                            نهاية)
                        نهاية)
                    ], تباعد: 16, محاذاة_رئيسية: "وسط"),
                    جديد فاصل(مرونة: 1),
                    جديد زر("🔄 إعادة تعيين", لون_خلفية: "#FF9800", عند_الضغط: لامدا()
                        هذا.عيّن_حالة(لامدا()
                            هذا.عداد = 0
                        نهاية)
                    نهاية)
                ], محاذاة_رئيسية: "وسط", محاذاة_ثانوية: "وسط", تباعد: 16)
            )
        )
    نهاية
نهاية

# تشغيل التطبيق
تشغيل_تطبيق(جديد تطبيق_عداد())
