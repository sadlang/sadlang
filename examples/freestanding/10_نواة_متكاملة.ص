# ==============================================================================
# المثال 10: نواة متكاملة مع حماية الذاكرة (MPU) — وضع Freestanding
# ==============================================================================
#
# هذا المثال الختامي يجمع كل مفاهيم Freestanding في نواة متكاملة:
#   - MPU: وحدة حماية الذاكرة (Memory Protection Unit)
#   - جدول ناقلات المقاطعة (Interrupt Vector Table)
#   - إدارة نقل الذاكرة المباشر DMA
#   - معالجة الاستثناءات الجسيمة (Hard Fault, Bus Fault)
#   - نظام تتبع سلامة النواة (Watchdog)
#   - إحصائيات النظام (System Statistics)
#
# هذه النواة يمكن أن تعمل فعلياً على STM32F4 أو ARM Cortex-M4
#
# الاستخدام:
#   sadc --freestanding 10_نواة_متكاملة.ص \
#         --linker-script=linker/cortex_m4.ld \
#         -o نواة.elf
# ==============================================================================

#![بلا_مكتبة_قياسية]
#![بلا_رئيسية]

#تضمين <runtime_new/freestanding/sad_core.h>

# ==============================================================================
# القسم 1: ثوابت النواة
# ==============================================================================

# عناوين MPU (Cortex-M4)
ثابت MPU_TYPE: عنوان = 0xE000ED90      # نوع MPU وعدد المناطق
ثابت MPU_CTRL: عنوان = 0xE000ED94      # سجل التحكم الرئيسي
ثابت MPU_RNR: عنوان = 0xE000ED98       # رقم المنطقة
ثابت MPU_RBAR: عنوان = 0xE000ED9C      # عنوان القاعدة
ثابت MPU_RASR: عنوان = 0xE000EDA0      # سجل الحجم والسمات

# عنوان Watchdog (IWDG)
ثابت IWDG_KR: عنوان = 0x40003000       # سجل المفتاح
ثابت IWDG_PR: عنوان = 0x40003004       # سجل المُقسِّم
ثابت IWDG_RLR: عنوان = 0x40003008      # سجل الحد الأدنى
ثابت IWDG_SR: عنوان = 0x4000300C       # سجل الحالة

# مفاتيح Watchdog
ثابت IWDG_مفتاح_تغذية: ع32 = 0xAAAA    # إعادة تعيين العداد
ثابت IWDG_مفتاح_تعطيل: ع32 = 0x5555   # تعطيل الحماية
ثابت IWDG_مفتاح_بدء: ع32 = 0xCCCC     # بدء تشغيل Watchdog

# عدد مناطق MPU المدعومة (Cortex-M4 لديه 8)
ثابت عدد_مناطق_MPU: ع32 = 8

# عناوين أقسام الذاكرة
ثابت عنوان_Flash: عنوان = 0x08000000      # ذاكرة البرنامج (512 كيلوبايت)
ثابت عنوان_RAM: عنوان = 0x20000000        # ذاكرة البيانات (128 كيلوبايت)
ثابت عنوان_Peripheral: عنوان = 0x40000000  # الذاكرة المُخصَّصة للأجهزة
ثابت عنوان_CCM: عنوان = 0x10000000        # Core Coupled Memory (64 كيلوبايت)
ثابت حجم_Stack: عنوان = 0x00001000        # حجم المكدس (4 كيلوبايت)
ثابت حجم_Heap: عنوان = 0x00010000         # حجم الكومة (64 كيلوبايت)

# ==============================================================================
# القسم 2: هياكل البيانات
# ==============================================================================

# وصف منطقة MPU واحدة
هيكل منطقة_MPU {
    رقم_المنطقة: ع32;        # 0 إلى 7
    العنوان: عنوان;           # عنوان القاعدة (محاذاة لـ 2^N)
    الحجم: ع32;              # رمز الحجم (log2 - 1)
    الصلاحيات: ع32;          # قراءة/كتابة/تنفيذ
    مُفعَّلة: منطق;           # هل المنطقة مفعَّلة؟
}

# إحصائيات النظام في الوقت الفعلي
هيكل إحصائيات_النظام {
    uptime_ثانية: ع32;        # الوقت منذ آخر إعادة تشغيل
    عدد_المقاطعات: ع32;       # إجمالي المقاطعات المعالَجة
    عدد_الأخطاء: ع32;         # أخطاء الحافلة والفقدان
    ذاكرة_مستخدمة: ع32;      # بايتات الذاكرة المستخدمة
    أعلى_استخدام_RAM: ع32;    # الحد الأقصى الذي وصل إليه RAM
    حرارة_المعالج: ع32;       # درجة الحرارة (إذا كان هناك حساس)
    عدد_إعادة_التشغيل: ع32;  # عدد مرات إعادة التشغيل (محفوظ في NVRAM)
}

# رأس جدول ناقلات المقاطعة
هيكل معلومات_مقاطعة {
    الرقم: ع32;              # رقم المقاطعة
    الاسم: [ح8; 16];         # اسم للتشخيص
    عدد_الاستدعاءات: ع32;    # كم مرة وقعت هذه المقاطعة
    آخر_استدعاء: ع32;        # وقت آخر مقاطعة (uptime)
}

# ==============================================================================
# القسم 3: حالة النواة العامة
# ==============================================================================

# إحصائيات النظام
متغير_عام الإحصائيات: إحصائيات_النظام = إحصائيات_النظام {
    uptime_ثانية: 0,
    عدد_المقاطعات: 0,
    عدد_الأخطاء: 0,
    ذاكرة_مستخدمة: 0,
    أعلى_استخدام_RAM: 0,
    حرارة_المعالج: 0,
    عدد_إعادة_التشغيل: 0
}

# جدول مناطق MPU
متغير_عام مناطق_MPU: [منطقة_MPU; 8]

# هل تم التهيئة بنجاح؟
متغير_عام النواة_جاهزة: منطق = خطأ

# سجل آخر خطأ للتشخيص
متغير_عام سبب_آخر_خطأ: ع32 = 0

# ==============================================================================
# القسم 4: وحدة حماية الذاكرة (MPU)
# ==============================================================================

# كتابة قيمة لسجل
دالة اكتب32(عنوان_س: عنوان, قيمة: ع32)
    متغير مؤشر: *ع32 = عنوان_س كـ *ع32
    *مؤشر = قيمة
نهاية

# قراءة قيمة من سجل
دالة اقرأ32(عنوان_س: عنوان) -> ع32
    متغير مؤشر: *ع32 = عنوان_س كـ *ع32
    أرجع *مؤشر
نهاية

# تهيئة MPU بمناطق الحماية
# يُعين صلاحيات مختلفة لكل منطقة من الذاكرة
دالة هيئ_MPU()
    # إيقاف MPU أثناء التهيئة
    اكتب32(MPU_CTRL, 0x00)

    # منطقة 0: Flash ROM — قراءة وتنفيذ فقط (512 كيلوبايت)
    اكتب32(MPU_RNR, 0)
    اكتب32(MPU_RBAR, عنوان_Flash كـ ع32)
    # حجم 512KB = log2(512*1024)-1 = 18 | مكتبة | Privileged Only
    اكتب32(MPU_RASR, 0x0702002B)  # تنفيذ + قراءة + حجم 512K

    # منطقة 1: RAM الكاملة — قراءة وكتابة، لا تنفيذ
    اكتب32(MPU_RNR, 1)
    اكتب32(MPU_RBAR, عنوان_RAM كـ ع32)
    # حجم 128KB = 16 | XN (لا تنفيذ) | full access
    اكتب32(MPU_RASR, 0x03040025)  # XN + قراءة/كتابة + حجم 128K

    # منطقة 2: المحيط — قراءة وكتابة، لا تنفيذ
    اكتب32(MPU_RNR, 2)
    اكتب32(MPU_RBAR, عنوان_Peripheral كـ ع32)
    اكتب32(MPU_RASR, 0x13040033)  # Device memory + قراءة/كتابة + 1GB

    # منطقة 3: المكدس — محمي من الفيضان (Stack Guard)
    # أول 32 بايت من المكدس محمية (Privileged No Access)
    اكتب32(MPU_RNR, 3)
    متغير نهاية_stack: عنوان = عنوان_RAM + حجم_Stack
    اكتب32(MPU_RBAR, نهاية_stack كـ ع32)
    اكتب32(MPU_RASR, 0x00000015)  # No access + حجم 32 بايت

    # حفظ معلومات المناطق
    مناطق_MPU[0].العنوان = عنوان_Flash
    مناطق_MPU[0].مُفعَّلة = صحيح
    مناطق_MPU[1].العنوان = عنوان_RAM
    مناطق_MPU[1].مُفعَّلة = صحيح
    مناطق_MPU[2].العنوان = عنوان_Peripheral
    مناطق_MPU[2].مُفعَّلة = صحيح
    مناطق_MPU[3].مُفعَّلة = صحيح

    # تفعيل MPU مع تمكين الحماية في وضع الاستثناءات
    # والتعامل مع HardFault مع MPU
    اكتب32(MPU_CTRL, 0x07)
نهاية

# ==============================================================================
# القسم 5: Watchdog Timer
# ==============================================================================

# تهيئة Watchdog بمهلة 2 ثانية
# إذا لم تُغذَّ الـ Watchdog في غضون ثانيتين → إعادة التشغيل
دالة هيئ_Watchdog()
    # فتح السجلات للكتابة
    اكتب32(IWDG_KR, IWDG_مفتاح_تعطيل)

    # ضبط المُقسِّم: LSI 32kHz / 256 = 125 هرتز
    اكتب32(IWDG_PR, 0x06)

    # ضبط قيمة إعادة التحميل: 250 نبضة = 2 ثانية
    اكتب32(IWDG_RLR, 250)

    # بدء تشغيل Watchdog
    اكتب32(IWDG_KR, IWDG_مفتاح_بدء)
نهاية

# تغذية Watchdog (يجب استدعاؤها قبل انتهاء المهلة)
دالة غذِّ_Watchdog()
    اكتب32(IWDG_KR, IWDG_مفتاح_تغذية)
نهاية

# ==============================================================================
# القسم 6: معالجات الاستثناءات الجسيمة
# ==============================================================================

# معالج HardFault — يُستدعى عند الخطأ الجسيم
# يُسجِّل سبب الخطأ ثم ينتظر Watchdog لإعادة التشغيل
#[معالج_استثناء]
لن_ترجع دالة عند_HardFault()
    # قراءة سجل HFSR لمعرفة سبب الخطأ
    متغير سجل_HFSR: ع32 = اقرأ32(0xE000ED2C)
    سبب_آخر_خطأ = سجل_HFSR
    الإحصائيات.عدد_الأخطاء = الإحصائيات.عدد_الأخطاء + 1

    # لا ندعو غذِّ_Watchdog — سيُعيد التشغيل خلال ثانيتين
    حلقة {}
نهاية

# معالج MPU Fault — انتهاك الصلاحيات
#[معالج_استثناء]
لن_ترجع دالة عند_MPUFault()
    # قراءة سجل MMFSR لمعرفة العنوان المخالف
    متغير مخالفة: ع32 = اقرأ32(0xE000ED28)
    سبب_آخر_خطأ = 0xFF000000 | (مخالفة & 0xFF)
    الإحصائيات.عدد_الأخطاء = الإحصائيات.عدد_الأخطاء + 1

    حلقة {}
نهاية

# معالج الذعر المطلوب لـ فريستاندينج
#[معالج_ذعر]
لن_ترجع دالة عند_الذعر(معلومات: *معلومات_ذعر)
    سبب_آخر_خطأ = 0xDEAD0000
    الإحصائيات.عدد_الأخطاء = الإحصائيات.عدد_الأخطاء + 1
    حلقة {}
نهاية

# ==============================================================================
# القسم 7: نظام التهيئة والمراقبة
# ==============================================================================

# تهيئة شاملة للنواة
دالة هيئ_النواة()
    # 1. تفعيل MPU
    هيئ_MPU()

    # 2. تفعيل Watchdog
    هيئ_Watchdog()

    # 3. إعادة تعيين الإحصائيات
    الإحصائيات.uptime_ثانية = 0
    الإحصائيات.عدد_المقاطعات = 0
    الإحصائيات.عدد_الأخطاء = 0
    الإحصائيات.ذاكرة_مستخدمة = 0
    الإحصائيات.أعلى_استخدام_RAM = 0
    الإحصائيات.عدد_إعادة_التشغيل = الإحصائيات.عدد_إعادة_التشغيل + 1

    # 4. تهيئة ناجحة
    النواة_جاهزة = صحيح
نهاية

# ==============================================================================
# القسم 8: نقطة الدخول
# ==============================================================================

#[نقطة_دخول]
لن_ترجع دالة _start()
    # تهيئة النواة الكاملة
    هيئ_النواة()

    # حلقة المراقبة الرئيسية
    حلقة {
        # تحديث uptime
        الإحصائيات.uptime_ثانية = الإحصائيات.uptime_ثانية + 1

        # تغذية Watchdog — ضروري كل دورة
        غذِّ_Watchdog()

        # تأخير 1 ثانية (مقدَّر)
        متغير ت: ع32 = 0
        بينما (ت < 8400000)
            ت = ت + 1
        نهاية
    }
نهاية
