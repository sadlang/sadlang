# ==============================================================================
# المثال 04: شاشة TFT-LCD (ST7735) عبر SPI — وضع Freestanding
# ==============================================================================
#
# متحكم شاشة ST7735 هو من أشهر شاشات TFT الصغيرة (1.8 بوصة، 128×160 بكسل)
# المستخدمة في المشاريع المدمجة. هذا المثال يُطبق:
#   - بروتوكول SPI للتواصل مع الشاشة
#   - إرسال أوامر ضبط الشاشة (Initialization Sequence)
#   - رسم المستطيلات والنصوص الأساسية
#   - العمل المباشر مع ذاكرة الشاشة (Framebuffer)
#   - تنسيق ألوان RGB565 (16-بت لكل بكسل)
#
# الاستخدام:
#   sadc --freestanding 04_شاشة_TFT.ص -o tft_kernel.elf
# ==============================================================================

#![بلا_مكتبة_قياسية]
#![بلا_رئيسية]

#تضمين <runtime_new/freestanding/sad_core.h>

# ==============================================================================
# القسم 1: ثوابت العتاد — عناوين SPI و GPIO
# ==============================================================================

# عناوين سجلات SPI0 (لـ ARM Cortex-A/Raspberry Pi)
ثابت SPI0_قاعدة: عنوان = 0x3F204000
ثابت SPI0_CS: عنوان = SPI0_قاعدة + 0x00    # سجل التحكم والحالة
ثابت SPI0_FIFO: عنوان = SPI0_قاعدة + 0x04  # صندوق رسائل البيانات
ثابت SPI0_CLK: عنوان = SPI0_قاعدة + 0x08   # سجل التردد
ثابت SPI0_DLEN: عنوان = SPI0_قاعدة + 0x0C  # طول البيانات

# عناوين GPIO (لـ Raspberry Pi)
ثابت GPIO_قاعدة: عنوان = 0x3F200000
ثابت GPFSEL0: عنوان = GPIO_قاعدة + 0x00   # تحديد وظيفة Pin 0-9
ثابت GPSET0: عنوان = GPIO_قاعدة + 0x1C    # رفع Pin
ثابت GPCLR0: عنوان = GPIO_قاعدة + 0x28   # خفض Pin

# دبابيس GPIO للشاشة
ثابت دبوس_RST: ع32 = 25    # إعادة ضبط الشاشة (Reset)
ثابت دبوس_DC: ع32 = 24     # أمر/بيانات (Command/Data)
ثابت دبوس_CS: ع32 = 8      # تحديد الشريحة (Chip Select)

# ==============================================================================
# القسم 2: أبعاد ومواصفات الشاشة ST7735
# ==============================================================================

# دقة الشاشة بالبكسل
ثابت عرض_الشاشة: ع32 = 128
ثابت ارتفاع_الشاشة: ع32 = 160
# إجمالي البكسلات
ثابت إجمالي_بكسلات: ع32 = 20480   # 128 × 160

# ==============================================================================
# القسم 3: ألوان RGB565 الأساسية
# ==============================================================================

# RGB565 = 5 بتات أحمر + 6 بتات أخضر + 5 بتات أزرق
# الحساب: اللون = (أحمر << 11) | (أخضر << 5) | أزرق

ثابت لون_أبيض: ع16 = 0xFFFF
ثابت لون_أسود: ع16 = 0x0000
ثابت لون_أحمر: ع16 = 0xF800
ثابت لون_أخضر: ع16 = 0x07E0
ثابت لون_أزرق: ع16 = 0x001F
ثابت لون_أصفر: ع16 = 0xFFE0
ثابت لون_سماوي: ع16 = 0x07FF
ثابت لون_وردي: ع16 = 0xF81F
ثابت لون_رمادي: ع16 = 0x8410

# ==============================================================================
# القسم 4: أوامر متحكم ST7735
# ==============================================================================

ثابت أمر_إعادة_ضبط: ع8 = 0x01   # إعادة ضبط البرمجيات
ثابت أمر_تجاوز_النوم: ع8 = 0x11  # الخروج من وضع النوم
ثابت أمر_تشغيل_عرض: ع8 = 0x29   # تشغيل عرض الصورة
ثابت أمر_تعيين_عمود: ع8 = 0x2A  # تعيين نطاق العمود
ثابت أمر_تعيين_صف: ع8 = 0x2B   # تعيين نطاق الصف
ثابت أمر_كتابة_بيانات: ع8 = 0x2C # بدء كتابة بيانات الصورة
ثابت أمر_وضع_ألوان: ع8 = 0x3A   # تعيين تنسيق الألوان
ثابت أمر_عكس_الألوان: ع8 = 0x21  # عكس ألوان الشاشة
ثابت قيمة_RGB565: ع8 = 0x55     # تنسيق 16-بت (RGB565)

# ==============================================================================
# القسم 5: إطار الشاشة (Framebuffer)
# ==============================================================================

# مخزن الإطار في ذاكرة الوصول العشوائي
# كل بكسل = 2 بايت (RGB565) → الحجم الكلي = 128 × 160 × 2 = 40960 بايت
ثابت عنوان_framebuffer: عنوان = 0x00600000

# ==============================================================================
# القسم 6: دوال GPIO و SPI
# ==============================================================================

# كتابة قيمة إلى سجل GPIO
دالة اكتب_GPIO(عنوان_سجل: عنوان, قيمة: ع32)
    متغير مؤشر: *ع32 = عنوان_سجل كـ *ع32
    *مؤشر = قيمة
نهاية

# رفع دبوس GPIO (High)
دالة ارفع_دبوس(رقم: ع32)
    اكتب_GPIO(GPSET0, 1 << رقم)
نهاية

# خفض دبوس GPIO (Low)
دالة اخفض_دبوس(رقم: ع32)
    اكتب_GPIO(GPCLR0, 1 << رقم)
نهاية

# تبديل وضع الدبوس بين أمر (Command) وبيانات (Data)
# وضع الأمر: DC = 0
# وضع البيانات: DC = 1
دالة ضبط_وضع_DC(هو_بيانات: منطق)
    إذا (هو_بيانات)
        ارفع_دبوس(دبوس_DC)
    وإلا
        اخفض_دبوس(دبوس_DC)
    نهاية
نهاية

# إرسال بايت واحد عبر SPI
# تُفعِّل CS، ترسل البيانات، تُوقف CS
دالة أرسل_بايت_SPI(البايت: ع8)
    اخفض_دبوس(دبوس_CS)  # تفعيل الشريحة

    # كتابة البايت في صندوق رسائل SPI
    متغير مؤشر_FIFO: *ع8 = SPI0_FIFO كـ *ع8
    *مؤشر_FIFO = البايت

    # انتظار انتهاء الإرسال (فحص بت DONE في سجل CS)
    متغير مؤشر_CS: *ع32 = SPI0_CS كـ *ع32
    بينما ((*مؤشر_CS & 0x00010000) == 0)
        # الانتظار النشط (busy wait)
    نهاية

    ارفع_دبوس(دبوس_CS)  # إيقاف الشريحة
نهاية

# إرسال أمر للشاشة (Command Mode: DC = 0)
دالة أرسل_أمر(الأمر: ع8)
    ضبط_وضع_DC(خطأ)  # وضع الأمر
    أرسل_بايت_SPI(الأمر)
نهاية

# إرسال بيانات للشاشة (Data Mode: DC = 1)
دالة أرسل_بيانات(البيانات: ع8)
    ضبط_وضع_DC(صحيح)  # وضع البيانات
    أرسل_بايت_SPI(البيانات)
نهاية

# إرسال كلمة 16-بت (للألوان RGB565)
دالة أرسل_لون(اللون: ع16)
    أرسل_بيانات((اللون >> 8) كـ ع8)  # البايت العالي أولاً
    أرسل_بيانات((اللون & 0xFF) كـ ع8) # البايت المنخفض ثانياً
نهاية

# ==============================================================================
# القسم 7: تهيئة الشاشة
# ==============================================================================

# تأخير بسيط (busy wait)
# في النظام الحقيقي: نستخدم مؤقت الأجهزة
دالة تأخير(عدد_دورات: ع32)
    متغير ن: ع32 = 0
    بينما (ن < عدد_دورات)
        ن = ن + 1
    نهاية
نهاية

# تهيئة شاشة ST7735 بتسلسل الأوامر الكامل
# يجب استدعاء هذه الدالة مرة واحدة عند بدء التشغيل
دالة هيئ_الشاشة()
    # إعادة ضبط الشاشة عبر دبوس RST
    اخفض_دبوس(دبوس_RST)
    تأخير(100000)     # انتظار 100 ميلي ثانية
    ارفع_دبوس(دبوس_RST)
    تأخير(200000)     # انتظار 200 ميلي ثانية

    # تسلسل تهيئة ST7735
    أرسل_أمر(أمر_إعادة_ضبط)   # إعادة ضبط برمجيات
    تأخير(150000)

    أرسل_أمر(أمر_تجاوز_النوم)  # الخروج من وضع النوم
    تأخير(150000)

    # ضبط تنسيق الألوان على 16-بت (RGB565)
    أرسل_أمر(أمر_وضع_ألوان)
    أرسل_بيانات(قيمة_RGB565)

    # تشغيل عرض الصورة
    أرسل_أمر(أمر_تشغيل_عرض)
نهاية

# ==============================================================================
# القسم 8: رسم الأشكال
# ==============================================================================

# تحديد نافذة الكتابة على الشاشة
# جميع عمليات الكتابة اللاحقة ستكون داخل هذه النافذة
دالة حدِّد_نافذة(س1: ع8, ص1: ع8, س2: ع8, ص2: ع8)
    # تعيين نطاق الأعمدة
    أرسل_أمر(أمر_تعيين_عمود)
    أرسل_بيانات(0)
    أرسل_بيانات(س1)
    أرسل_بيانات(0)
    أرسل_بيانات(س2)

    # تعيين نطاق الصفوف
    أرسل_أمر(أمر_تعيين_صف)
    أرسل_بيانات(0)
    أرسل_بيانات(ص1)
    أرسل_بيانات(0)
    أرسل_بيانات(ص2)

    # بدء كتابة البيانات
    أرسل_أمر(أمر_كتابة_بيانات)
نهاية

# ملء الشاشة بلون واحد
# يُستخدم لمسح الشاشة أو رسم خلفية
دالة امسح_الشاشة(اللون: ع16)
    حدِّد_نافذة(0, 0, (عرض_الشاشة - 1) كـ ع8, (ارتفاع_الشاشة - 1) كـ ع8)

    # إرسال اللون لكل بكسل
    متغير ن: ع32 = 0
    بينما (ن < إجمالي_بكسلات)
        أرسل_لون(اللون)
        ن = ن + 1
    نهاية
نهاية

# رسم بكسل واحد في إحداثيات محددة
دالة ارسم_بكسل(س: ع8, ص: ع8, اللون: ع16)
    حدِّد_نافذة(س, ص, س, ص)
    أرسل_لون(اللون)
نهاية

# رسم مستطيل ممتلئ
دالة ارسم_مستطيل(س1: ع8, ص1: ع8, العرض: ع8, الارتفاع: ع8, اللون: ع16)
    متغير س2: ع8 = س1 + العرض - 1
    متغير ص2: ع8 = ص1 + الارتفاع - 1

    حدِّد_نافذة(س1, ص1, س2, ص2)

    متغير بكسلات: ع32 = (العرض كـ ع32) × (الارتفاع كـ ع32)
    متغير ن: ع32 = 0
    بينما (ن < بكسلات)
        أرسل_لون(اللون)
        ن = ن + 1
    نهاية
نهاية

# رسم إطار مستطيل (غير ممتلئ)
دالة ارسم_إطار(س1: ع8, ص1: ع8, العرض: ع8, الارتفاع: ع8, اللون: ع16)
    متغير س2: ع8 = س1 + العرض - 1
    متغير ص2: ع8 = ص1 + الارتفاع - 1

    # الحافة العليا
    ارسم_مستطيل(س1, ص1, العرض, 1, اللون)
    # الحافة السفلية
    ارسم_مستطيل(س1, ص2, العرض, 1, اللون)
    # الحافة اليسرى
    ارسم_مستطيل(س1, ص1, 1, الارتفاع, اللون)
    # الحافة اليمنى
    ارسم_مستطيل(س2, ص1, 1, الارتفاع, اللون)
نهاية

# ==============================================================================
# القسم 9: نقطة الدخول ومعالج الذعر
# ==============================================================================

#[معالج_ذعر]
لن_ترجع دالة عند_الذعر(معلومات: *معلومات_ذعر)
    حلقة {}
نهاية

#[نقطة_دخول]
لن_ترجع دالة _start()
    # تهيئة الشاشة
    هيئ_الشاشة()

    # مسح الشاشة بالخلفية الزرقاء الداكنة
    امسح_الشاشة(0x0010)

    # رسم عنوان في أعلى الشاشة (أبيض)
    ارسم_مستطيل(0, 0, 128, 20, لون_أزرق)

    # رسم منطقة المحتوى (رمادي فاتح)
    ارسم_مستطيل(0, 20, 128, 120, لون_رمادي)

    # رسم شريط الحالة في الأسفل (أخضر)
    ارسم_مستطيل(0, 140, 128, 20, لون_أخضر)

    # رسم إطار تزييني حول الشاشة
    ارسم_إطار(1, 1, 126, 158, لون_أصفر)

    # رسم نقاط للاختبار
    ارسم_بكسل(64, 80, لون_أحمر)   # مركز الشاشة
    ارسم_بكسل(10, 10, لون_أبيض)   # الزاوية العلوية اليسرى
    ارسم_بكسل(117, 10, لون_أبيض)  # الزاوية العلوية اليمنى

    # الشاشة تعمل — انتظار للأبد
    حلقة {}
نهاية
