#![بلا_رئيسية]

#تضمين <runtime_new/freestanding/sad_core.h>

# ==============================================================================
# القسم 1: عناوين سجلات STM32F4
# ==============================================================================

# قاعدة عنوان RCC (Reset and Clock Control)
ثابت RCC_AHB1ENR: عنوان = 0x40023830   # سجل تفعيل ساعة AHB1

# عناوين GPIO A
ثابت GPIOA_MODER: عنوان = 0x40020000   # وضع الدبوس
ثابت GPIOA_ODR: عنوان = 0x40020014     # إخراج البيانات
ثابت GPIOA_ODR_رقم: ع32 = 0x40020014

# عناوين TIM2 (للـ PWM)
ثابت TIM2_قاعدة: عنوان = 0x40000000
ثابت TIM2_CR1: عنوان = TIM2_قاعدة + 0x00   # سجل التحكم 1
ثابت TIM2_PSC: عنوان = TIM2_قاعدة + 0x28   # المُقسِّم
ثابت TIM2_ARR: عنوان = TIM2_قاعدة + 0x2C   # القيمة القصوى
ثابت TIM2_CCR1: عنوان = TIM2_قاعدة + 0x34  # مقارن القناة 1
ثابت TIM2_CCMR1: عنوان = TIM2_قاعدة + 0x18 # وضع مقارنة القناة
ثابت TIM2_CCER: عنوان = TIM2_قاعدة + 0x20  # تفعيل التقاط/مقارنة

# عناوين ADC1
ثابت ADC1_قاعدة: عنوان = 0x40012000
ثابت ADC1_SR: عنوان = ADC1_قاعدة + 0x00    # سجل الحالة
ثابت ADC1_CR1: عنوان = ADC1_قاعدة + 0x04   # سجل التحكم 1
ثابت ADC1_CR2: عنوان = ADC1_قاعدة + 0x08   # سجل التحكم 2
ثابت ADC1_SQR3: عنوان = ADC1_قاعدة + 0x34  # تسلسل القنوات
ثابت ADC1_DR: عنوان = ADC1_قاعدة + 0x4C    # سجل البيانات

# عناوين USART2
ثابت USART2_قاعدة: عنوان = 0x40004400
ثابت USART2_SR: عنوان = USART2_قاعدة + 0x00   # سجل الحالة
ثابت USART2_DR: عنوان = USART2_قاعدة + 0x04   # سجل البيانات
ثابت USART2_BRR: عنوان = USART2_قاعدة + 0x08  # سجل معدل الإرسال
ثابت USART2_CR1: عنوان = USART2_قاعدة + 0x0C  # سجل التحكم 1

# ==============================================================================
# القسم 2: دوال مساعدة للكتابة/القراءة من السجلات
# ==============================================================================

دالة اكتب_سجل(عنوان_سجل: عنوان, قيمة: ع32)
    متغير مؤشر: *ع32 = عنوان_سجل كـ *ع32
    *مؤشر = قيمة
نهاية

دالة اقرأ_سجل(عنوان_سجل: عنوان) -> ع32
    متغير مؤشر: *ع32 = عنوان_سجل كـ *ع32
    أرجع *مؤشر
نهاية

دالة عدِّل_سجل(عنوان_سجل: عنوان, قناع: ع32, قيمة: ع32)
    متغير مؤشر: *ع32 = عنوان_سجل كـ *ع32
    *مؤشر = (*مؤشر & ~قناع) | (قيمة & قناع)
نهاية

# ==============================================================================
# القسم 3: تهيئة وحدات الأجهزة
# ==============================================================================

# تهيئة وحدة PWM على TIM2 CH1 (PA0)
# تردد PWM = 1 كيلوهرتز، دورة عمل قابلة للتعديل 0-100%
دالة هيئ_PWM()
    # تفعيل ساعة TIM2
    عدِّل_سجل(RCC_AHB1ENR, 0x00000001, 0x00000001)

    # ضبط المُقسِّم (PSC = 84-1): 84 ميغاهرتز / 84 = 1 ميغاهرتز
    اكتب_سجل(TIM2_PSC, 83)

    # ضبط القيمة القصوى (ARR = 1000): 1 ميغاهرتز / 1000 = 1 كيلوهرتز
    اكتب_سجل(TIM2_ARR, 999)

    # ضبط وضع PWM Mode 1 على القناة 1
    اكتب_سجل(TIM2_CCMR1, 0x0068)

    # تفعيل مخرج القناة 1
    اكتب_سجل(TIM2_CCER, 0x0001)

    # ضبط دورة العمل الأولية (50%)
    اكتب_سجل(TIM2_CCR1, 500)

    # تشغيل المؤقت
    اكتب_سجل(TIM2_CR1, 0x0001)
نهاية

# تعديل دورة عمل PWM
# نسبة: 0 (إيقاف كامل) إلى 100 (تشغيل كامل)
دالة ضبط_PWM(نسبة: ع32)
    متغير قيمة: ع32 = نسبة × 10  # تحويل من % إلى 0-1000
    إذا (قيمة > 1000)
        قيمة = 1000
    نهاية
    اكتب_سجل(TIM2_CCR1, قيمة)
نهاية

# تهيئة محوِّل ADC1 (قراءة حساس درجة الحرارة)
دالة هيئ_ADC()
    # تفعيل ساعة ADC1
    عدِّل_سجل(0x40023844, 0x00000100, 0x00000100)

    # تفعيل ADC
    اكتب_سجل(ADC1_CR2, 0x00000001)

    # انتظار الاستقرار
    متغير ن: ع32 = 0
    بينما (ن < 1000)
        ن = ن + 1
    نهاية

    # اختيار القناة 0 (PA0)
    اكتب_سجل(ADC1_SQR3, 0)
نهاية

# قراءة قيمة من ADC (0 إلى 4095 لـ 12-بت)
دالة اقرأ_ADC() -> ع32
    # بدء التحويل
    عدِّل_سجل(ADC1_CR2, 0x40000000, 0x40000000)

    # انتظار اكتمال التحويل (EOC bit)
    بينما ((اقرأ_سجل(ADC1_SR) & 0x02) == 0)
        # انتظار
    نهاية

    أرجع اقرأ_سجل(ADC1_DR) & 0xFFF
نهاية

# تهيئة USART2 (115200 بود، 8N1)
دالة هيئ_UART()
    # تفعيل ساعة USART2
    عدِّل_سجل(0x40023840, 0x00020000, 0x00020000)

    # ضبط معدل الإرسال (BRR = 45.5625 لـ 115200 بود على 84 ميغاهرتز)
    # القيمة = 0x002D = 45 صحيح، 0x09 = كسر
    اكتب_سجل(USART2_BRR, 0x0000022B)

    # تفعيل UART (إرسال + استقبال)
    اكتب_سجل(USART2_CR1, 0x000C)

    # تشغيل UART
    عدِّل_سجل(USART2_CR1, 0x2000, 0x2000)
نهاية

# إرسال حرف عبر UART
دالة UART_أرسل_حرف(الحرف: ح8)
    # انتظار حتى يفرغ مخزن الإرسال
    بينما ((اقرأ_سجل(USART2_SR) & 0x80) == 0)
        # انتظار
    نهاية
    اكتب_سجل(USART2_DR, الحرف كـ ع32)
نهاية

# إرسال سلسلة نصية عبر UART
دالة UART_أرسل_نص(نص: *ح8, الطول: ع32)
    متغير ن: ع32 = 0
    بينما (ن < الطول)
        متغير حرف: ح8 = *((نص + (ن كـ عنوان)) كـ *ح8)
        إذا (حرف == 0)
            أرجع
        نهاية
        UART_أرسل_حرف(حرف)
        ن = ن + 1
    نهاية
نهاية

# تحويل رقم إلى نص ASCII وإرساله
دالة UART_أرسل_رقم(رقم: ع32)
    متغير أحرف: [ح8; 12]
    متغير طول: ع32 = 0

    إذا (رقم == 0)
        UART_أرسل_حرف('0')
        أرجع
    نهاية

    متغير ن: ع32 = رقم
    بينما (ن > 0)
        أحرف[طول] = (('0' كـ ع32) + (ن % 10)) كـ ح8
        ن = ن / 10
        طول = طول + 1
    نهاية

    # عكس الأحرف
    متغير ي: ع32 = 0
    بينما (ي < طول)
        متغير حرف: ح8 = أحرف[طول - ي - 1]
        UART_أرسل_حرف(حرف)
        ي = ي + 1
    نهاية
نهاية

# ==============================================================================
# القسم 4: تحويل قراءة ADC إلى درجة حرارة
# ==============================================================================

# حساس مقاومة NTC: V = ADC × 3300 / 4096 ميلي فولت
# درجة الحرارة = (V - 500) / 10 (لـ TMP36)
دالة احسب_الحرارة(قراءة_ADC: ع32) -> ع32
    متغير ميلي_فولت: ع32 = قراءة_ADC × 3300 / 4096
    إذا (ميلي_فولت < 500)
        أرجع 0  # درجة حرارة خارج النطاق
    نهاية
    أرجع (ميلي_فولت - 500) / 10
نهاية

# ==============================================================================
# القسم 5: نقطة الدخول ومعالج الذعر
# ==============================================================================

#[معالج_ذعر]
لن_ترجع دالة عند_الذعر(معلومات: *معلومات_ذعر)
    حلقة {}
نهاية

#[نقطة_دخول]
لن_ترجع دالة _start()
    # تهيئة جميع الأجهزة
    هيئ_PWM()
    هيئ_ADC()
    هيئ_UART()

    # إرسال رسالة ترحيب
    متغير رسالة: [ح8; 20] = [
        'S','y','s','t','e','m',' ','R','e','a','d','y','\r','\n',0,
        0,0,0,0,0
    ]
    UART_أرسل_نص(رسالة كـ *ح8, 14)

    # حلقة المراقبة الرئيسية
    حلقة {
        # قراءة درجة الحرارة
        متغير قراءة: ع32 = اقرأ_ADC()
        متغير حرارة: ع32 = احسب_الحرارة(قراءة)

        # إرسال درجة الحرارة عبر UART
        UART_أرسل_حرف('T')
        UART_أرسل_حرف('=')
        UART_أرسل_رقم(حرارة)
        UART_أرسل_حرف('C')
        UART_أرسل_حرف('\r')
        UART_أرسل_حرف('\n')

        # ضبط PWM بناءً على درجة الحرارة
        # فوق 40: تشغيل المروحة بالكامل
        # دون 25: إيقاف المروحة
        إذا (حرارة > 40)
            ضبط_PWM(100)
        وإلا
            إذا (حرارة > 30)
                ضبط_PWM(50)
            وإلا
                إذا (حرارة > 25)
                    ضبط_PWM(25)
                وإلا
                    ضبط_PWM(0)
                نهاية
            نهاية
        نهاية

        # انتظار ثانية واحدة (بطريقة busy wait مقدَّرة)
        متغير تأخير: ع32 = 0
        بينما (تأخير < 8400000)
            تأخير = تأخير + 1
        نهاية
    }
نهاية
