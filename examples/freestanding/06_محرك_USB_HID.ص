# ==============================================================================
# المثال 06: محرِّك USB HID — وضع Freestanding
# ==============================================================================
#
# USB HID (Human Interface Device) هو بروتوكول USB للأجهزة التفاعلية مثل
# لوحات المفاتيح والفأرات. هذا المثال يُطبق:
#   - هياكل واصفات USB (USB Descriptors)
#   - جدول واصفات الجهاز (Device Descriptor)
#   - واصفات التهيئة والواجهة (Config/Interface Descriptors)
#   - واصفات HID وتقرير HID
#   - منطق معالجة طلبات المضيف (Host Requests)
#   - إرسال تقارير لوحة المفاتيح
#
# الاستخدام:
#   sadc --freestanding 06_محرك_USB_HID.ص -o usb_hid_kernel.elf
# ==============================================================================

#![بلا_مكتبة_قياسية]
#![بلا_رئيسية]

#تضمين <runtime_new/freestanding/sad_core.h>

# ==============================================================================
# القسم 1: ثوابت USB الأساسية
# ==============================================================================

# عناوين سجلات USB (ARM Cortex-M / STM32)
ثابت USB_قاعدة: عنوان = 0x40005C00
ثابت USB_CNTR: عنوان = USB_قاعدة + 0x40   # سجل التحكم
ثابت USB_ISTR: عنوان = USB_قاعدة + 0x44   # سجل المقاطعة
ثابت USB_DADDR: عنوان = USB_قاعدة + 0x4C  # سجل عنوان الجهاز
ثابت USB_BTABLE: عنوان = USB_قاعدة + 0x50  # جدول المخازن المؤقتة

# ذاكرة USB المشتركة (PMA - Packet Memory Area)
ثابت USB_PMA: عنوان = 0x40006000

# معرِّفات USB
ثابت USB_VID: ع16 = 0x1234  # معرِّف المصنِّع (Vendor ID)
ثابت USB_PID: ع16 = 0x5678  # معرِّف المنتج (Product ID)

# أنواع الواصفات
ثابت نوع_واصف_جهاز: ع8 = 0x01
ثابت نوع_واصف_تهيئة: ع8 = 0x02
ثابت نوع_واصف_نص: ع8 = 0x03
ثابت نوع_واصف_واجهة: ع8 = 0x04
ثابت نوع_واصف_نقطة_نهاية: ع8 = 0x05
ثابت نوع_واصف_HID: ع8 = 0x21
ثابت نوع_واصف_تقرير: ع8 = 0x22

# رموز طلبات USB القياسية
ثابت طلب_المواصفات: ع8 = 0x06    # GET_DESCRIPTOR
ثابت طلب_ضبط_العنوان: ع8 = 0x05  # SET_ADDRESS
ثابت طلب_ضبط_التهيئة: ع8 = 0x09  # SET_CONFIGURATION
ثابت طلب_HID_GET_REPORT: ع8 = 0x01

# أحجام الواصفات
ثابت حجم_واصف_الجهاز: ع32 = 18
ثابت حجم_واصف_التهيئة: ع32 = 9

# ==============================================================================
# القسم 2: هياكل واصفات USB
# ==============================================================================

# واصف الجهاز (Device Descriptor) — 18 بايت
هيكل واصف_الجهاز {
    الحجم: ع8;              # 18 دائماً
    النوع: ع8;              # 0x01
    مواصفة_USB: ع16;         # 0x0200 لـ USB 2.0
    فئة_الجهاز: ع8;         # 0
    فئة_فرعية: ع8;          # 0
    بروتوكول: ع8;           # 0
    أقصى_باكت_EP0: ع8;      # 64 بايت
    VID: ع16;               # معرِّف المصنِّع
    PID: ع16;               # معرِّف المنتج
    إصدار_الجهاز: ع16;       # 0x0100 = الإصدار 1.0
    فهرس_المصنِّع: ع8;       # فهرس النص
    فهرس_المنتج: ع8;        # فهرس النص
    فهرس_الرقم_التسلسلي: ع8; # فهرس النص
    عدد_التهيئات: ع8;       # 1
}

# واصف التهيئة (Configuration Descriptor) — 9 بايت
هيكل واصف_التهيئة {
    الحجم: ع8;                # 9
    النوع: ع8;                # 0x02
    الحجم_الكلي: ع16;          # حجم جميع الواصفات مجمَّعة
    عدد_الواجهات: ع8;          # 1
    قيمة_التهيئة: ع8;          # 1
    فهرس_النص: ع8;             # 0
    الخصائص: ع8;               # 0x80 (يعمل من Bus Power)
    الحد_الأقصى_للطاقة: ع8;    # 50 × 2mA = 100mA
}

# واصف الواجهة (Interface Descriptor) — 9 بايت
هيكل واصف_الواجهة {
    الحجم: ع8;          # 9
    النوع: ع8;          # 0x04
    رقم_الواجهة: ع8;    # 0
    رقم_الإعداد: ع8;    # 0
    عدد_نقاط_النهاية: ع8; # 1
    فئة: ع8;            # 0x03 = HID
    فئة_فرعية: ع8;      # 0x01 = Boot Interface
    بروتوكول: ع8;       # 0x01 = Keyboard
    فهرس_النص: ع8;      # 0
}

# واصف HID — 9 بايت
هيكل واصف_HID {
    الحجم: ع8;              # 9
    النوع: ع8;              # 0x21
    إصدار_HID: ع16;          # 0x0111 = HID 1.11
    كود_البلد: ع8;           # 0
    عدد_الواصفات: ع8;       # 1
    نوع_الواصف: ع8;         # 0x22 = Report Descriptor
    حجم_التقرير: ع16;        # حجم تقرير HID
}

# واصف نقطة النهاية (Endpoint Descriptor) — 7 بايت
هيكل واصف_نقطة_النهاية {
    الحجم: ع8;              # 7
    النوع: ع8;              # 0x05
    عنوان: ع8;              # 0x81 = EP1 IN
    السمات: ع8;             # 0x03 = Interrupt
    أقصى_باكيت: ع16;         # 8 بايت لـ HID Keyboard
    الفترة: ع8;             # 10 ميلي ثانية
}

# ==============================================================================
# القسم 3: تقرير لوحة المفاتيح HID
# ==============================================================================

# تقرير لوحة المفاتيح (8 بايت حسب HID Boot Protocol)
هيكل تقرير_لوحة_المفاتيح {
    الأزرار_المعدِّلة: ع8;     # Ctrl, Shift, Alt, Win...
    محجوز: ع8;                 # دائماً 0
    مفتاح1: ع8;               # أول مفتاح مضغوط
    مفتاح2: ع8;               # ثاني مفتاح مضغوط
    مفتاح3: ع8;               # ثالث مفتاح مضغوط
    مفتاح4: ع8;               # رابع مفتاح مضغوط
    مفتاح5: ع8;               # خامس مفتاح مضغوط
    مفتاح6: ع8;               # سادس مفتاح مضغوط
}

# ==============================================================================
# القسم 4: ثوابت رموز مفاتيح HID
# ==============================================================================

# رموز المفاتيح الأساسية (HID Keyboard Usage Page)
ثابت مفتاح_A: ع8 = 0x04
ثابت مفتاح_B: ع8 = 0x05
ثابت مفتاح_C: ع8 = 0x06
ثابت مفتاح_ENTER: ع8 = 0x28
ثابت مفتاح_ESCAPE: ع8 = 0x29
ثابت مفتاح_BACKSPACE: ع8 = 0x2A
ثابت مفتاح_SPACE: ع8 = 0x2C
ثابت مفتاح_0: ع8 = 0x27
ثابت مفتاح_1: ع8 = 0x1E
ثابت مفتاح_LEFT_CTRL: ع8 = 0x01  # بت في الأزرار المعدِّلة
ثابت مفتاح_LEFT_SHIFT: ع8 = 0x02 # بت في الأزرار المعدِّلة

# ==============================================================================
# القسم 5: حالة المحرِّك
# ==============================================================================

# التقرير الحالي الجاهز للإرسال
متغير_عام التقرير_الحالي: تقرير_لوحة_المفاتيح = تقرير_لوحة_المفاتيح {
    الأزرار_المعدِّلة: 0,
    محجوز: 0,
    مفتاح1: 0, مفتاح2: 0, مفتاح3: 0,
    مفتاح4: 0, مفتاح5: 0, مفتاح6: 0
}
# عنوان الجهاز USB المخصص من المضيف
متغير_عام عنوان_USB: ع8 = 0
# هل الجهاز مُهيَّأ وجاهز؟
متغير_عام الجهاز_مُهيَّأ: منطق = خطأ
# عداد الإطارات (Frame Counter)
متغير_عام عداد_الإطارات: ع32 = 0

# ==============================================================================
# القسم 6: دوال المحرِّك
# ==============================================================================

# تهيئة وحدة USB في الجهاز
دالة هيئ_USB()
    # إعادة ضبط USB
    متغير cntr: *ع32 = USB_CNTR كـ *ع32
    *cntr = 0x0001  # تفعيل إعادة الضبط

    # انتظار قصير
    متغير ن: ع32 = 0
    بينما (ن < 1000)
        ن = ن + 1
    نهاية

    # إلغاء إعادة الضبط وتفعيل USB
    *cntr = 0x0000

    # تعيين عنوان الجهاز
    متغير daddr: *ع32 = USB_DADDR كـ *ع32
    *daddr = 0x0080  # تفعيل مع عنوان 0

    الجهاز_مُهيَّأ = صحيح
نهاية

# إنشاء تقرير لمفتاح محدد
# يُنظِّف جميع المفاتيح أولاً ثم يُعيِّن المفتاح الجديد
دالة اضغط_مفتاح(رمز_المفتاح: ع8)
    التقرير_الحالي.مفتاح1 = رمز_المفتاح
    التقرير_الحالي.مفتاح2 = 0
    التقرير_الحالي.مفتاح3 = 0
نهاية

# إفراج المفاتيح (إرسال تقرير فارغ)
دالة أفرج_المفاتيح()
    التقرير_الحالي.الأزرار_المعدِّلة = 0
    التقرير_الحالي.مفتاح1 = 0
    التقرير_الحالي.مفتاح2 = 0
    التقرير_الحالي.مفتاح3 = 0
نهاية

# إرسال التقرير الحالي إلى المضيف USB
# يكتب البيانات في ذاكرة PMA ثم يُبلِّغ وحدة USB
دالة أرسل_تقرير()
    إذا (!الجهاز_مُهيَّأ)
        أرجع
    نهاية

    # كتابة التقرير في ذاكرة PMA
    متغير pma: *ع8 = (USB_PMA + 0x40) كـ *ع8
    *pma = التقرير_الحالي.الأزرار_المعدِّلة
    *((pma + 1 كـ عنوان) كـ *ع8) = التقرير_الحالي.محجوز
    *((pma + 2 كـ عنوان) كـ *ع8) = التقرير_الحالي.مفتاح1
    *((pma + 3 كـ عنوان) كـ *ع8) = التقرير_الحالي.مفتاح2

    عداد_الإطارات = عداد_الإطارات + 1
نهاية

# ==============================================================================
# القسم 7: نقطة الدخول ومعالج الذعر
# ==============================================================================

#[معالج_ذعر]
لن_ترجع دالة عند_الذعر(معلومات: *معلومات_ذعر)
    حلقة {}
نهاية

#[نقطة_دخول]
لن_ترجع دالة _start()
    هيئ_USB()

    # محاكاة ضغط مفاتيح: يكتب "A B C ENTER" كل ثانية
    حلقة {
        # ضغط مفتاح A
        اضغط_مفتاح(مفتاح_A)
        أرسل_تقرير()

        # تأخير
        متغير ن1: ع32 = 0
        بينما (ن1 < 100000)
            ن1 = ن1 + 1
        نهاية

        # إفراج
        أفرج_المفاتيح()
        أرسل_تقرير()

        # تأخير
        متغير ن2: ع32 = 0
        بينما (ن2 < 100000)
            ن2 = ن2 + 1
        نهاية
    }
نهاية
