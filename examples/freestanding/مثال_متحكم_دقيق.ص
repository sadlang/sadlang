// ════════════════════════════════════════════════════════════════════════════
// مثال_متحكم_دقيق.ص — مثال كامل للنظام المدمج بوضع Freestanding
// ════════════════════════════════════════════════════════════════════════════
//
// هذا المثال يُظهر كيفية كتابة برنامج كامل لمتحكم دقيق ARM Cortex-M
// (مثل STM32 أو QEMU -machine virt) بلغة ص بدون أي مكتبة قياسية.
//
// الميزات المُستعرضة في هذا المثال:
// ─────────────────────────────────────────────────────────────────────────
//   1. السمات: #![بلا_مكتبة_قياسية]، #![بلا_رئيسية]
//   2. نقطة الدخول: #[نقطة_دخول] → _start
//   3. معالج الذعر: #[معالج_ذعر]
//   4. معالجات المقاطعات: #[معالج_مقاطعة(IRQ0)] للساعة
//   5. MMIO: اقرأ_mmio32، اكتب_mmio32، سجل32
//   6. حماية عمليات MMIO: قسم_حرج_مقاطعة_بدء/نهاية
//   7. أنواع لغة ص: ع8، ع32، ح32، حجم، منطق
//   8. التحكم: إذا، وإلا، طالما، لكل، حلقة، تطابق
//   9. دوال الذاكرة: sad_memset، sad_memcpy
//   10. UART: أرسل_نص_UART_PL011 للتشخيص
//
// طريقة الترجمة لـ QEMU ARM virt:
// ─────────────────────────────────────────────────────────────────────────
//   sadc مثال_متحكم_دقيق.ص \
//       --target=aarch64-unknown-none \
//       --linker-script=مثال_متحكم_دقيق.ld \
//       -o مثال_متحكم_دقيق.elf
//
// طريقة التشغيل في QEMU:
// ─────────────────────────────────────────────────────────────────────────
//   qemu-system-aarch64 \
//       -machine virt \
//       -cpu cortex-a53 \
//       -kernel مثال_متحكم_دقيق.elf \
//       -serial stdio \
//       -nographic
//
// ════════════════════════════════════════════════════════════════════════════

// ── السمات العامة للوحدة ──────────────────────────────────────────────────
// هذه السمات تُخبر المترجم sadc بأننا في وضع bare-metal الكامل
#![بلا_مكتبة_قياسية]
#![بلا_رئيسية]

// ── استيراد بيئة التشغيل freestanding ────────────────────────────────────
//
// sad_core.h يُوفِّر:
//   • الأنواع: ع8/16/32/64، ح8/16/32/64، حجم، منطق
//   • التحكم: إذا، وإلا، طالما، لكل، حلقة، تطابق، أكمل، أوقف
//   • الذاكرة: sad_memset، sad_memcpy، sad_memzero
//   • MMIO: اقرأ_mmio32، اكتب_mmio32، ضبط_بت_32، ...
//   • المقاطعات: تفعيل_مقاطعات، تعطيل_مقاطعات، توقف، ...
//   • الذعر: ذعر()، تأكد()
#تضمين <runtime_new/freestanding/sad_core.h>

// ════════════════════════════════════════════════════════════════════════════
// القسم 1: ثوابت العتاد — خاصة بلوحة QEMU ARM virt
// ════════════════════════════════════════════════════════════════════════════

// ─── UART PL011 ─────────────────────────────────────────────────────────────
// يُستخدم للإخراج التسلسلي (printf البديل في freestanding)
ثابت عنوان UART0_BASE    = 0x09000000;  // عنوان UART0 على QEMU virt ARM

// ─── GIC (Generic Interrupt Controller) ────────────────────────────────────
// يُستخدم لاكتشاف وخدمة المقاطعات على ARM Cortex-A
ثابت عنوان GICD_BASE     = 0x08000000;  // GIC Distributor
ثابت عنوان GICC_BASE     = 0x08010000;  // GIC CPU Interface

// ─── مؤقّت النظام (ARM Generic Timer) ─────────────────────────────────────
// مؤقّت مُدمَج في معالج ARM — يُستخدم كساعة جدولة المهام
ثابت ع32 TIMER_FREQ_HZ   = 100;         // 100 مقاطعة في الثانية = 10ms لكل دورة

// ─── ذاكرة SRAM ─────────────────────────────────────────────────────────────
ثابت عنوان SRAM_BASE      = 0x40000000; // بداية ذاكرة SRAM
ثابت حجم  SRAM_SIZE       = 0x10000000; // 256 ميغابايت

// ─── تسجيل الأجهزة المدعومة ────────────────────────────────────────────────
ثابت ع32 MAX_DEVICES      = 16;         // أقصى عدد أجهزة مدعومة

// ════════════════════════════════════════════════════════════════════════════
// القسم 2: الحالة العالمية للنظام
// ════════════════════════════════════════════════════════════════════════════

// ─── عداد المؤقّت ──────────────────────────────────────────────────────────
// يزيد في كل مقاطعة ساعة (كل 10ms)
// متطاير volatile لأنه يُعدَّل في معالج المقاطعة
ح64 متطاير عداد_المؤقت    = 0;

// ─── إحصائيات النظام ────────────────────────────────────────────────────────
هيكل إحصائيات_نظام {
    ع32 عدد_مقاطعات_ساعة;    // عدد مقاطعات المؤقّت منذ البدء
    ع32 عدد_أذعار;            // عدد مرات استدعاء معالج الذعر
    ع32 عدد_خطأ_صفحة;        // عدد أخطاء الصفحة (صفر في بداية التشغيل)
    ع32 عدد_استثناءات;        // إجمالي الاستثناءات المُعالَجة
};

متغير إحصائيات_نظام إحصاء = {0, 0, 0, 0};

// ─── سجل أجهزة النظام ──────────────────────────────────────────────────────
// قائمة بسيطة للأجهزة المُسجَّلة والمهيّأة
هيكل جهاز_نظام {
    ع32     معرّف;           // رقم تعريف الجهاز (فريد)
    ح8      اسم[16];         // اسم الجهاز (UTF-8)
    منطق    مهيّأ;            // هل تمت التهيئة بنجاح؟
    عنوان  عنوان_أساسي;     // عنوان MMIO للجهاز
    ع32     رقم_IRQ;         // رقم مقاطعة الجهاز (0 = بلا مقاطعة)
};

متغير جهاز_نظام أجهزة_نظام[MAX_DEVICES];
متغير ع32 عدد_أجهزة = 0;

// ════════════════════════════════════════════════════════════════════════════
// القسم 3: دوال التشخيص (بديل printf في freestanding)
// ════════════════════════════════════════════════════════════════════════════

// ── إرسال نص على UART (تشخيص النواة) ────────────────────────────────────
دالة طباعة(ثابت ح8* النص) → فراغ {
    أرسل_نص_UART_PL011(UART0_BASE, النص);
}

// ── طباعة سطر (نص + سطر جديد) ───────────────────────────────────────────
دالة طباعة_سطر(ثابت ح8* النص) → فراغ {
    طباعة(النص);
    أرسل_حرف_UART_PL011(UART0_BASE, '\n');
}

// ── طباعة عدد صحيح غير موقَّع (عد البتات) ──────────────────────────────
دالة طباعة_عدد(ع64 عدد, ع8 أساس) → فراغ {
    // بافر لتخزين الأرقام العكسية
    ح8 بافر[24] = {0};
    ع8 موضع = 0;

    إذا (عدد == 0) {
        أرسل_حرف_UART_PL011(UART0_BASE, '0');
        أرجع;
    }

    // تحويل العدد لأرقام عكسياً
    طالما (عدد > 0) {
        ع8 رقم = (ع8)(عدد % أساس);
        إذا (رقم < 10) {
            بافر[موضع] = ('0' + رقم);
        } وإلا {
            بافر[موضع] = ('A' + رقم - 10);
        }
        موضع = موضع + 1;
        عدد = عدد / أساس;
    }

    // طباعة الأرقام بالترتيب الصحيح
    طالما (موضع > 0) {
        موضع = موضع - 1;
        أرسل_حرف_UART_PL011(UART0_BASE, بافر[موضع]);
    }
}

// ── طباعة عنوان بنظام 16 ─────────────────────────────────────────────────
دالة طباعة_عنوان(عنوان العنوان) → فراغ {
    طباعة("0x");
    طباعة_عدد((ع64)العنوان, 16);
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 4: معالج الذعر — مطلوب في كل وحدة freestanding
// ════════════════════════════════════════════════════════════════════════════
//
// (AR) معالج الذعر هو دالة تُستدعى عند حدوث خطأ حرج لا يمكن التعافي منه.
//      في وضع freestanding:
//        - لا يوجد std::terminate
//        - لا يوجد stack unwinding
//        - المعالج يجب أن لا يرجع (!  → لن_ترجع)
//
// هذا المعالج:
//   1. يُسجِّل الذعر في الإحصاء
//   2. يُطبع رسالة تشخيص على UART
//   3. يعلّق المعالج في حلقة لانهائية (الطريقة الأمثل للنواة)
//

#[معالج_ذعر]
لن_ترجع دالة عند_الذعر() {
    // 1. تعطيل جميع المقاطعات فوراً (نحن في حالة طارئة)
    تعطيل_مقاطعات();

    // 2. تسجيل الحادثة في الإحصاء
    إحصاء.عدد_أذعار = إحصاء.عدد_أذعار + 1;

    // 3. إرسال رسالة طارئة على UART
    طباعة("\r\n");
    طباعة("═══════════════════════════════════════\r\n");
    طباعة("  ☠ ذعر النظام (System Panic)         \r\n");
    طباعة("═══════════════════════════════════════\r\n");
    طباعة("  عداد المؤقت: ");
    طباعة_عدد((ع64)عداد_المؤقت, 10);
    طباعة("\r\n");
    طباعة("  عدد الأذعار: ");
    طباعة_عدد((ع64)إحصاء.عدد_أذعار, 10);
    طباعة("\r\n");
    طباعة("═══════════════════════════════════════\r\n");
    طباعة("  النظام معلَّق. أعد تشغيل اليدوي.\r\n");

    // 4. تعليق المعالج
    //    لا يمكن استخدام exit() أو abort() في freestanding
    //    الحل الوحيد: حلقة لانهائية مع HLT لتوفير الطاقة
    حلقة {
        توقف();  // HLT — توقف حتى المقاطعة التالية (لن تأتي: معطّلة)
    }
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 5: معالجات المقاطعات
// ════════════════════════════════════════════════════════════════════════════

// ─── معالج مقاطعة ساعة النظام (Timer IRQ) ──────────────────────────────────
//
// يُستدعى كل 10ms (بمعدل TIMER_FREQ_HZ = 100 مرة/ثانية).
// المهام:
//   1. زيادة عداد المؤقّت
//   2. تسجيل الإحصاء
//   3. إرسال EOI للـ GIC

#[معالج_مقاطعة(IRQ0)]
معالج_مقاطع_اتفاقية دالة معالج_ساعة() {
    // (AR) زيادة العداد العالمي
    // قسم_حرج_مقاطعة غير ضروري هنا لأننا بالفعل في معالج مقاطعة
    // (المقاطعات معطّلة تلقائياً خلال ISR على x86/ARM)
    عداد_المؤقت = عداد_المؤقت + 1;
    إحصاء.عدد_مقاطعات_ساعة = إحصاء.عدد_مقاطعات_ساعة + 1;

    // (AR) كل ثانية (100 مقاطعة): طباعة نبضة حياة
    إذا ((عداد_المؤقت % 100) == 0) {
        طباعة("  ◆ نبضة الساعة  | الوقت: ");
        طباعة_عدد((ع64)(عداد_المؤقت / 100), 10);
        طباعة("s\r\n");
    }

    // (AR) إرسال EOI للـ GIC لإعلامه بانتهاء المعالجة
    // (بدون هذا، لن تُعالَج أي مقاطعة ساعة أخرى)
    اكتب_mmio32(GICC_BASE + GICC_EOIR, IRQ0);
}

// ─── معالج مقاطعة UART (استقبال بيانات) ───────────────────────────────────
//
// يُستدعى عند وصول بيانات على UART (ضغط مفتاح في QEMU).

#[معالج_مقاطعة(IRQ1)]
معالج_مقاطع_اتفاقية دالة معالج_uart() {
    // قراءة البيانات المستقبَلة من UART
    volatile إطار_UART_PL011* uart = (volatile إطار_UART_PL011*)UART0_BASE;

    // استنزاف بافر الاستقبال
    طالما (!(uart->علامات & UART_FR_RXFE)) {
        ع8 حرف = (ع8)(uart->بيانات & 0xFF);  // قراءة الحرف

        // صدى الحرف المُستقبَل
        أرسل_حرف_UART_PL011(UART0_BASE, (ح8)حرف);

        // إذا Enter: طباعة معلومات النظام
        إذا (حرف == '\r' || حرف == '\n') {
            طباعة("\r\n=== حالة النظام ===\r\n");
            طباعة("  الوقت منذ البدء: ");
            طباعة_عدد((ع64)(عداد_المؤقت / 100), 10);
            طباعة("s\r\n");
            طباعة("  مقاطعات الساعة: ");
            طباعة_عدد((ع64)إحصاء.عدد_مقاطعات_ساعة, 10);
            طباعة("\r\n");
            طباعة("  الأذعار: ");
            طباعة_عدد((ع64)إحصاء.عدد_أذعار, 10);
            طباعة("\r\n===================\r\n");
        }
    }

    // إرسال EOI
    اكتب_mmio32(GICC_BASE + GICC_EOIR, IRQ1);
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 6: دوال تهيئة الأجهزة
// ════════════════════════════════════════════════════════════════════════════

// ─── تهيئة GIC (Generic Interrupt Controller) ──────────────────────────────
دالة تهيئة_GIC() → فراغ {
    // 1. تفعيل GIC Distributor
    اكتب_mmio32(GICD_BASE + GICD_CTLR, 1);

    // 2. ضبط أولوية CPU Interface (0xFF = أقبَل جميع الأولويات)
    اكتب_mmio32(GICC_BASE + GICC_PMR, 0xFF);

    // 3. تفعيل CPU Interface
    اكتب_mmio32(GICC_BASE + GICC_CTLR, 1);

    // 4. تفعيل مقاطعات الأجهزة التي نحتاجها
    تفعيل_مقاطعة_GIC(GICD_BASE, IRQ0);   // ساعة النظام
    تفعيل_مقاطعة_GIC(GICD_BASE, IRQ1);   // UART

    طباعة_سطر("  ✓ GIC مُهيَّأ");
}

// ─── تهيئة UART ───────────────────────────────────────────────────────────
دالة تهيئة_UART() → فراغ {
    // تهيئة UART PL011 بـ 115200 baud و24MHz تردد ساعة
    تهيئة_UART_PL011(UART0_BASE, 24000000, 115200);

    // تسجيل UART في قائمة الأجهزة
    إذا (عدد_أجهزة < MAX_DEVICES) {
        أجهزة_نظام[عدد_أجهزة].معرّف        = 1;
        // نسخ اسم الجهاز
        sad_memcpy(أجهزة_نظام[عدد_أجهزة].اسم, "UART0", 6);
        أجهزة_نظام[عدد_أجهزة].مهيّأ         = صحيح;
        أجهزة_نظام[عدد_أجهزة].عنوان_أساسي  = UART0_BASE;
        أجهزة_نظام[عدد_أجهزة].رقم_IRQ      = IRQ1;
        عدد_أجهزة = عدد_أجهزة + 1;
    }

    طباعة_سطر("  ✓ UART0 مُهيَّأ (115200 baud)");
}

// ─── تهيئة مؤقّت النظام (ARM Generic Timer) ────────────────────────────────
دالة تهيئة_المؤقّت() → فراغ {
    // ARM Generic Timer تُهيَّأ عبر مسجلات النظام (System Registers)
    // CNTV_CTL_EL0: Virtual Timer Control Register
    // CNTV_TVAL_EL0: Timer Value Register (عداد العد التنازلي)

    // احصل على تردد ساعة المؤقّت
    ع64 تردد_ساعة = 0;
#ifdef SAD_ARCH_AARCH64
    __asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(تردد_ساعة));
#else
    تردد_ساعة = 1000000;  // 1MHz افتراضي
#endif

    // احسب عدد الدورات لـ 10ms
    ع64 دورات = تردد_ساعة / TIMER_FREQ_HZ;

    // اضبط القيمة الأولية للعداد التنازلي
#ifdef SAD_ARCH_AARCH64
    __asm__ volatile ("msr cntv_tval_el0, %0" :: "r"(دورات));
    // فعّل المؤقّت (بت ENABLE = 1، بت IMASK = 0 = مقاطعات مُفعَّلة)
    __asm__ volatile ("msr cntv_ctl_el0, %0" :: "r"((ع64)1));
#endif

    طباعة("  ✓ مؤقّت النظام مُهيَّأ (");
    طباعة_عدد(TIMER_FREQ_HZ, 10);
    طباعة_سطر(" مقاطعة/ثانية)");
}

// ─── تصفير BSS ─────────────────────────────────────────────────────────────
// tقطعة BSS تحتوي على متغيرات مُهيَّأة بصفر — يجب تصفيرها يدوياً
// لأن في freestanding لا يوجد CRT runtime يفعل ذلك
دالة تصفير_BSS() → فراغ {
    // الرموز __bss_start و__bss_end محدَّدة في سكريبت الرابط (.ld)
    // في هذا المثال نُعلِّق عليها فقط
    // الكود الفعلي يتطلب رموز من سكريبت الرابط:
    //   extern ع8 __bss_start[];
    //   extern ع8 __bss_end[];
    //   sad_memzero(__bss_start, __bss_end - __bss_start);

    // تصفير هياكل البيانات العالمية يدوياً
    sad_memset(&إحصاء, 0, sizeof(إحصائيات_نظام));
    sad_memset(أجهزة_نظام, 0, sizeof(جهاز_نظام) * MAX_DEVICES);
    عدد_أجهزة = 0;
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 7: الحلقة الرئيسية للنظام
// ════════════════════════════════════════════════════════════════════════════

دالة حلقة_النظام() → فراغ {
    طباعة_سطر("\n  ══ الحلقة الرئيسية للنظام تعمل ══");
    طباعة_سطر("  اضغط Enter لإظهار حالة النظام");
    طباعة_سطر("  أي مفتاح آخر لاختبار المقاطعات\n");

    ع64 آخر_طباعة = 0;

    حلقة {
        // انتظار مقاطعة (توفير الطاقة)
        // المعالج ينام حتى تصل SAT أي مقاطعة: ساعة أو UART
        توقف_حتى_مقاطعة();

        // التحقق من التغييرات depthsبعد الاستيقاظ
        ع64 الوقت_الحالي = (ع64)عداد_المؤقت;

        // طباعة ملخص إحصائي كل 5 ثواني
        إذا ((الوقت_الحالي - آخر_طباعة) >= 500) {
            آخر_طباعة = الوقت_الحالي;

            // (AR)
            طباعة("\r\n  [ وقت النظام: ");
            طباعة_عدد(الوقت_الحالي / 100, 10);
            طباعة("s | مقاطعات: ");
            طباعة_عدد((ع64)إحصاء.عدد_مقاطعات_ساعة, 10);
            طباعة(" | أجهزة: ");
            طباعة_عدد((ع64)عدد_أجهزة, 10);
            طباعة(" ]\r\n");
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 8: نقطة الدخول (_start)
// ════════════════════════════════════════════════════════════════════════════
//
// هذه الدالة هي أول ما يُنفَّذ عند تشغيل النظام بعد إعداد المكدّس البجهاز.
// (المكدّس يُعيَّن بسكريبت الرابط أو بكود Assembly قصير قبل الاستدعاء)
//
// مراحل التهيئة:
//   boot → تصفير BSS → تهيئة UART → تهيئة GIC → تهيئة المؤقّت
//   → تفعيل المقاطعات → الحلقة الرئيسية

#[نقطة_دخول]
لن_ترجع دالة _start() {
    // ─── المرحلة 1: تصفير منطقة BSS ─────────────────────────────────────
    // يجب أن تكون أولى العمليات! تضمن أن المتغيرات العالمية = 0
    تصفير_BSS();

    // ─── المرحلة 2: تهيئة UART ───────────────────────────────────────────
    // نهيّئ UART أولاً قبل أي شيء لنتمكن من طباعة رسائل التشخيص
    // Note: تهيئة_UART تستخدم sad_memcpy -> يجب أن تكون BSS مُصفَّرة أولاً
    تهيئة_UART();

    // ─── شاشة الترحيب ────────────────────────────────────────────────────
    طباعة("\r\n");
    طباعة("╔══════════════════════════════════════════════╗\r\n");
    طباعة("║    مرحباً بنظام لغة ص للنظام المدمج         ║\r\n");
    طباعة("║    Sad Language Freestanding Demo            ║\r\n");
    طباعة("║    QEMU ARM virt (Cortex-A53)               ║\r\n");
    طباعة("╚══════════════════════════════════════════════╝\r\n");
    طباعة("\r\n");

    // ─── المرحلة 3: تهيئة وحدة التحكم بالمقاطعات ────────────────────────
    طباعة_سطر("• تهيئة GIC...");
    تهيئة_GIC();

    // ─── المرحلة 4: تهيئة مؤقّت النظام ──────────────────────────────────
    طباعة_سطر("• تهيئة المؤقّت...");
    تهيئة_المؤقّت();

    // ─── اختبار: قراءة عنوان MMIO والتحقق من GIC ─────────────────────────
    طباعة("• اختبار MMIO — قراءة GIC TYPER: ");
    ع32 gic_typer = اقرأ_mmio32(GICD_BASE + GICD_TYPER);
    طباعة_عدد(gic_typer, 16);
    طباعة_سطر("");

    // ─── اختبار: وضع بت وقراءته للتحقق من صحة MMIO ──────────────────────
    طباعة("• اختبار ضبط_بت_32 وفحص_بت_32: ");
    ع32 قيمة_اختبار = 0;
    // اكتب قيمة اختبارية على SRAM
    اكتب_mmio32(SRAM_BASE, 0x12345678);
    قيمة_اختبار = اقرأ_mmio32(SRAM_BASE);
    إذا (قيمة_اختبار == 0x12345678) {
        طباعة_سطر("✓ MMIO يعمل بشكل صحيح");
    } وإلا {
        طباعة("✗ خطأ MMIO! القيمة المقروءة: ");
        طباعة_عدد(قيمة_اختبار, 16);
        طباعة_سطر("");
    }

    // ─── اختبار: دوال الذاكرة ────────────────────────────────────────────
    طباعة("• اختبار sad_memset/sad_memcmp: ");
    ح8 بافر1[32];
    ح8 بافر2[32];
    sad_memset(بافر1, 0xAA, 32);
    sad_memset(بافر2, 0xAA, 32);
    إذا (sad_memcmp(بافر1, بافر2, 32) == 0) {
        طباعة_سطر("✓ دوال الذاكرة تعمل");
    } وإلا {
        طباعة_سطر("✗ خطأ في دوال الذاكرة!");
    }

    // ─── اختبار: حلقة لكل مع الأنواع العربية ────────────────────────────
    طباعة("• اختبار حلقات لكل بأنواع ع32: ");
    ع32 مجموع = 0;
    لكل (ع32 ن = 1; ن <= 10; ن = ن + 1) {
        مجموع = مجموع + ن;  // 1 + 2 + ... + 10 = 55
    }
    إذا (مجموع == 55) {
        طباعة("✓ مجموع 1..10 = ");
        طباعة_عدد(مجموع, 10);
        طباعة_سطر("");
    } وإلا {
        طباعة("✗ خطأ! المجموع = ");
        طباعة_عدد(مجموع, 10);
        طباعة_سطر(" (متوقع 55)");
    }

    // ─── اختبار: تطابق (switch) ────────────────────────────────────────
    طباعة("• اختبار تطابق/switch: ");
    ع8 رمز = 3;
    تطابق (رمز) {
        حالة 1:
            طباعة("خطأ!");
            أوقف;
        حالة 2:
            طباعة("خطأ!");
            أوقف;
        حالة 3:
            طباعة_سطر("✓ تطابق يعمل (الحالة 3)");
            أوقف;
        افتراضي:
            طباعة("خطأ!");
            أوقف;
    }

    // ─── اختبار: قسم_حرج_مقاطعة_بدء/نهاية ──────────────────────────────
    طباعة("• اختبار قسم_حرج_مقاطعة: ");
    {
        قسم_حرج_مقاطعة_بدء(حالة_المقاطعات);
        // كود حرج: لا مقاطعات هنا
        ع32 عملية_حرجة = 7 * 8;
        قسم_حرج_مقاطعة_نهاية(حالة_المقاطعات);
        إذا (عملية_حرجة == 56) {
            طباعة_سطر("✓ قسم حرج يعمل");
        }
    }

    // ─── المرحلة 5: تفعيل المقاطعات ─────────────────────────────────────
    //    يجب أن يكون آخر خطوة في التهيئة!
    //    بعد هذا السطر ستبدأ المقاطعات بالوصول.
    طباعة_سطر("\n• تفعيل المقاطعات...");
    تفعيل_مقاطعات();
    طباعة_سطر("  ✓ النظام جاهز — المقاطعات مُفعَّلة\n");

    // ─── الحلقة الرئيسية ─────────────────────────────────────────────────
    // لا رجوع من هنا — النظام يعمل إلى الأبد
    حلقة_النظام();

    // لن نصل هنا — لكن المترجم يحتاج لرؤية نهاية غير قابلة للوصول
    // (التأكيد على لن_ترجع)
    حلقة { توقف(); }
}
