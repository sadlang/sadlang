# ==============================================================================
# المثال 08: بروتوكول I2C وشاشة OLED SSD1306 — وضع Freestanding
# ==============================================================================
#
# OLED SSD1306 هو من أشهر شاشات العرض الصغيرة (128×64 بكسل) في المشاريع
# المدمجة. تتواصل عبر بروتوكول I2C ذي السلكين (SDA + SCL). هذا المثال يطبق:
#   - بروتوكول I2C البرمجي (Bit-banging) عبر GPIO
#   - تسلسل تهيئة SSD1306 الكامل
#   - رسم نصوص وأشكال على الشاشة
#   - مخزن إطار (Framebuffer) بحجم 1024 بايت (128×64 بت)
#
# الاستخدام:
#   sadc --freestanding 08_شاشة_OLED_I2C.ص -o oled_kernel.elf
# ==============================================================================

#![بلا_مكتبة_قياسية]
#![بلا_رئيسية]

#تضمين <runtime_new/freestanding/sad_core.h>

# ==============================================================================
# القسم 1: ثوابت I2C و SSD1306
# ==============================================================================

# عناوين GPIO (ARM Cortex-M STM32)
ثابت GPIOB_ODR: عنوان = 0x40010C0C    # سجل إخراج بيانات GPIO B
ثابت GPIOB_IDR: عنوان = 0x40010C08    # سجل إدخال بيانات GPIO B

# دبابيس I2C
ثابت دبوس_SDA: ع32 = 7     # PB7 = خط البيانات
ثابت دبوس_SCL: ع32 = 6     # PB6 = خط الساعة

# عنوان I2C لشاشة SSD1306 (0x3C أو 0x3D حسب دبوس SA0)
ثابت عنوان_SSD1306: ع8 = 0x3C
# رمز إرسال الأوامر
ثابت وضع_أمر: ع8 = 0x00
# رمز إرسال البيانات
ثابت وضع_بيانات: ع8 = 0x40

# أبعاد الشاشة
ثابت عرض: ع32 = 128
ثابت ارتفاع: ع32 = 64
# حجم مخزن الإطار (128 × 64 بت = 1024 بايت)
ثابت حجم_مخزن_الإطار: ع32 = 1024

# ==============================================================================
# القسم 2: أوامر SSD1306 الأساسية
# ==============================================================================

ثابت CMD_DISPLAY_OFF: ع8 = 0xAE
ثابت CMD_DISPLAY_ON: ع8 = 0xAF
ثابت CMD_SET_CONTRAST: ع8 = 0x81
ثابت CMD_SET_MEMORY_MODE: ع8 = 0x20
ثابت CMD_SET_COL_ADDR: ع8 = 0x21
ثابت CMD_SET_PAGE_ADDR: ع8 = 0x22
ثابت CMD_SET_START_LINE: ع8 = 0x40
ثابت CMD_SET_SEGMENT_REMAP: ع8 = 0xA1
ثابت CMD_SET_MUX_RATIO: ع8 = 0xA8
ثابت CMD_SET_COM_SCAN_DIR: ع8 = 0xC8
ثابت CMD_SET_DISPLAY_OFFSET: ع8 = 0xD3
ثابت CMD_SET_COM_PINS: ع8 = 0xDA
ثابت CMD_SET_CLOCK_DIV: ع8 = 0xD5
ثابت CMD_SET_PRECHARGE: ع8 = 0xD9
ثابت CMD_SET_VCOM_DESEL: ع8 = 0xDB
ثابت CMD_CHARGE_PUMP: ع8 = 0x8D

# ==============================================================================
# القسم 3: مخزن الإطار
# ==============================================================================

# مخزن الإطار في ذاكرة القراءة/الكتابة
# 128 عمود × 8 صفحات × 8 بتات = 128 × 64 بكسل
ثابت عنوان_مخزن_الإطار: عنوان = 0x00700000

# ==============================================================================
# القسم 4: بروتوكول I2C (Bit-banging)
# ==============================================================================

# تعيين قيمة دبوس GPIO
دالة ضبط_دبوس(رقم: ع32, قيمة: منطق)
    متغير مؤشر: *ع32 = GPIOB_ODR كـ *ع32
    متغير cntr: ع32 = *مؤشر
    إذا (قيمة)
        *مؤشر = cntr | (1 << رقم)
    وإلا
        *مؤشر = cntr & ~(1 << رقم)
    نهاية
نهاية

# تأخير مُعايَر للـ I2C (100 كيلوهرتز = 10 ميكروثانية لكل نبضة)
دالة تأخير_I2C()
    متغير ن: ع32 = 0
    بينما (ن < 20)
        ن = ن + 1
    نهاية
نهاية

# إشارة البدء (START Condition): SDA ينزل بينما SCL مرتفع
دالة I2C_بدء()
    ضبط_دبوس(دبوس_SDA, صحيح)
    ضبط_دبوس(دبوس_SCL, صحيح)
    تأخير_I2C()
    ضبط_دبوس(دبوس_SDA, خطأ)  # SDA ينزل
    تأخير_I2C()
    ضبط_دبوس(دبوس_SCL, خطأ)  # SCL ينزل
    تأخير_I2C()
نهاية

# إشارة التوقف (STOP Condition): SDA يرتفع بينما SCL مرتفع
دالة I2C_توقف()
    ضبط_دبوس(دبوس_SDA, خطأ)
    تأخير_I2C()
    ضبط_دبوس(دبوس_SCL, صحيح)
    تأخير_I2C()
    ضبط_دبوس(دبوس_SDA, صحيح)  # SDA يرتفع
    تأخير_I2C()
نهاية

# إرسال بايت واحد عبر I2C (بت واحد في كل نبضة ساعة)
# يُرجع: صحيح إذا تلقينا ACK من العبد
دالة I2C_أرسل_بايت(البايت: ع8) -> منطق
    متغير ن: ع32 = 7
    بينما (ن <= 7)  # إرسال من أعلى بت لأسفل بت
        متغير بت: منطق = ((البايت >> (ن كـ ع8)) & 1) != 0
        ضبط_دبوس(دبوس_SDA, بت)
        تأخير_I2C()
        ضبط_دبوس(دبوس_SCL, صحيح)   # نبضة ساعة
        تأخير_I2C()
        ضبط_دبوس(دبوس_SCL, خطأ)
        إذا (ن == 0)
            أوقف
        نهاية
        ن = ن - 1
    نهاية

    # قراءة ACK (العبد يُخفض SDA)
    ضبط_دبوس(دبوس_SDA, صحيح)  # تحرير الخط للعبد
    تأخير_I2C()
    ضبط_دبوس(دبوس_SCL, صحيح)
    تأخير_I2C()

    # قراءة حالة SDA
    متغير مؤشر_IDR: *ع32 = GPIOB_IDR كـ *ع32
    متغير ack: منطق = ((*مؤشر_IDR >> دبوس_SDA) & 1) == 0

    ضبط_دبوس(دبوس_SCL, خطأ)
    تأخير_I2C()

    أرجع ack
نهاية

# ==============================================================================
# القسم 5: إرسال الأوامر والبيانات لـ SSD1306
# ==============================================================================

# إرسال أمر واحد (بايت واحد)
دالة أرسل_أمر(الأمر: ع8)
    I2C_بدء()
    I2C_أرسل_بايت((عنوان_SSD1306 << 1) & 0xFE)  # عنوان + Write
    I2C_أرسل_بايت(وضع_أمر)
    I2C_أرسل_بايت(الأمر)
    I2C_توقف()
نهاية

# إرسال أمرين متتاليين
دالة أرسل_أمرين(أمر1: ع8, أمر2: ع8)
    I2C_بدء()
    I2C_أرسل_بايت((عنوان_SSD1306 << 1) & 0xFE)
    I2C_أرسل_بايت(وضع_أمر)
    I2C_أرسل_بايت(أمر1)
    I2C_أرسل_بايت(أمر2)
    I2C_توقف()
نهاية

# ==============================================================================
# القسم 6: تهيئة SSD1306
# ==============================================================================

دالة هيئ_SSD1306()
    # إيقاف العرض أثناء الإعداد
    أرسل_أمر(CMD_DISPLAY_OFF)

    # ضبط تردد الساعة والمُقسِّم
    أرسل_أمرين(CMD_SET_CLOCK_DIV, 0x80)

    # ضبط نسبة المضاعفة (64 خطاً)
    أرسل_أمرين(CMD_SET_MUX_RATIO, 0x3F)

    # ضبط إزاحة العرض
    أرسل_أمرين(CMD_SET_DISPLAY_OFFSET, 0x00)

    # تعيين السطر الأول
    أرسل_أمر(CMD_SET_START_LINE | 0x00)

    # تفعيل مضخة الشحن (الطاقة الداخلية)
    أرسل_أمرين(CMD_CHARGE_PUMP, 0x14)

    # ضبط وضع العنونة على وضع الصفحات
    أرسل_أمرين(CMD_SET_MEMORY_MODE, 0x00)

    # عكس الأعمدة للعرض الصحيح
    أرسل_أمر(CMD_SET_SEGMENT_REMAP)

    # عكس اتجاه الصفوف
    أرسل_أمر(CMD_SET_COM_SCAN_DIR)

    # ضبط دبابيس COM (لـ 128×64)
    أرسل_أمرين(CMD_SET_COM_PINS, 0x12)

    # ضبط التباين
    أرسل_أمرين(CMD_SET_CONTRAST, 0xCF)

    # ضبط فترة الإفراز
    أرسل_أمرين(CMD_SET_PRECHARGE, 0xF1)

    # ضبط مستوى VCOM
    أرسل_أمرين(CMD_SET_VCOM_DESEL, 0x40)

    # تشغيل الإخراج (عرض ما في الذاكرة)
    أرسل_أمر(0xA4)   # Display RAM content
    أرسل_أمر(0xA6)   # Normal (not inverted)

    # تشغيل الشاشة
    أرسل_أمر(CMD_DISPLAY_ON)
نهاية

# ==============================================================================
# القسم 7: رسم البكسلات والأشكال
# ==============================================================================

# رسم بكسل واحد في مخزن الإطار (لم يُرسَل للشاشة بعد)
دالة ضبط_بكسل(س: ع32, ص: ع32, قيمة: منطق)
    إذا ((س >= عرض) | (ص >= ارتفاع))
        أرجع
    نهاية

    # حساب موقع البايت في مخزن الإطار
    # الشاشة مقسمة لـ 8 صفحات (pages) كل صفحة 8 صفوف
    متغير صفحة: ع32 = ص / 8
    متغير بت_في_صفحة: ع32 = ص % 8
    متغير إزاحة: ع32 = صفحة × عرض + س
    متغير مؤشر: *ع8 = (عنوان_مخزن_الإطار + (إزاحة كـ عنوان)) كـ *ع8

    إذا (قيمة)
        *مؤشر = *مؤشر | (1 << (بت_في_صفحة كـ ع8))
    وإلا
        *مؤشر = *مؤشر & ~(1 << (بت_في_صفحة كـ ع8))
    نهاية
نهاية

# مسح الشاشة (تصفير مخزن الإطار)
دالة امسح_الشاشة()
    sad_memset(عنوان_مخزن_الإطار كـ *فراغ, 0, حجم_مخزن_الإطار)
نهاية

# إرسال مخزن الإطار للشاشة (flush)
دالة أرسل_الإطار()
    # تعيين نطاق العمود الكامل
    أرسل_أمر(CMD_SET_COL_ADDR)
    أرسل_أمر(0)     # البداية
    أرسل_أمر(127)   # النهاية

    # تعيين نطاق الصفحة الكاملة
    أرسل_أمر(CMD_SET_PAGE_ADDR)
    أرسل_أمر(0)     # صفحة 0
    أرسل_أمر(7)     # صفحة 7

    # إرسال 1024 بايت من مخزن الإطار
    I2C_بدء()
    I2C_أرسل_بايت((عنوان_SSD1306 << 1) & 0xFE)
    I2C_أرسل_بايت(وضع_بيانات)

    متغير ن: ع32 = 0
    بينما (ن < حجم_مخزن_الإطار)
        متغير بايت: ع8 = *((عنوان_مخزن_الإطار + (ن كـ عنوان)) كـ *ع8)
        I2C_أرسل_بايت(بايت)
        ن = ن + 1
    نهاية

    I2C_توقف()
نهاية

# رسم خط أفقي
دالة خط_أفقي(ص: ع32, س_بداية: ع32, س_نهاية: ع32)
    متغير س: ع32 = س_بداية
    بينما (س <= س_نهاية)
        ضبط_بكسل(س, ص, صحيح)
        س = س + 1
    نهاية
نهاية

# رسم خط عمودي
دالة خط_عمودي(س: ع32, ص_بداية: ع32, ص_نهاية: ع32)
    متغير ص: ع32 = ص_بداية
    بينما (ص <= ص_نهاية)
        ضبط_بكسل(س, ص, صحيح)
        ص = ص + 1
    نهاية
نهاية

# رسم إطار مستطيل
دالة رسم_إطار(س: ع32, ص: ع32, عرض_م: ع32, ارتفاع_م: ع32)
    خط_أفقي(ص, س, س + عرض_م - 1)
    خط_أفقي(ص + ارتفاع_م - 1, س, س + عرض_م - 1)
    خط_عمودي(س, ص, ص + ارتفاع_م - 1)
    خط_عمودي(س + عرض_م - 1, ص, ص + ارتفاع_م - 1)
نهاية

# ==============================================================================
# القسم 8: نقطة الدخول ومعالج الذعر
# ==============================================================================

#[معالج_ذعر]
لن_ترجع دالة عند_الذعر(معلومات: *معلومات_ذعر)
    حلقة {}
نهاية

#[نقطة_دخول]
لن_ترجع دالة _start()
    # تهيئة الشاشة OLED
    هيئ_SSD1306()

    # مسح الشاشة
    امسح_الشاشة()

    # رسم إطار خارجي
    رسم_إطار(0, 0, 128, 64)

    # رسم شعار (+) في المنتصف
    خط_أفقي(32, 54, 74)
    خط_عمودي(64, 16, 48)

    # رسم نقطة في المركز
    ضبط_بكسل(64, 32, صحيح)
    ضبط_بكسل(63, 32, صحيح)
    ضبط_بكسل(65, 32, صحيح)
    ضبط_بكسل(64, 31, صحيح)
    ضبط_بكسل(64, 33, صحيح)

    # إرسال الإطار للشاشة
    أرسل_الإطار()

    # النظام يعمل — دوران لانهائي
    حلقة {}
نهاية
