/* ─── الثوابت الأساسية للنواة ───────────────────────────────────────────────── */
/*
 * عناوين أجهزة x86 للتواصل مع الـ hardware مباشرة.
 * هذه القيم ثوابت مُعرَّفة بالعتاد (hardcoded by hardware).
 */

/* عنوان ذاكرة شاشة VGA النصية — كل حرف بايتان (حرف + لون) */
ثابت عنوان_VGA: *ع16 = 0xB8000 كـ *ع16;

/* أبعاد الشاشة النصية القياسية */
ثابت عرض_الشاشة:  ع32 = 80;
ثابت ارتفاع_الشاشة: ع32 = 25;

/* ألوان VGA — النيبل الأعلى (لون الخلفية)، الأسفل (لون النص) */
ثابت لون_أبيض_على_أزرق: ع8 = 0x1F; /* أبيض على خلفية زرقاء  */
ثابت لون_أخضر_على_أسود: ع8 = 0x0A; /* أخضر على خلفية سوداء */
ثابت لون_أحمر_على_أسود: ع8 = 0x0C; /* أحمر على خلفية سوداء */


/* ─── دوال الإخراج للشاشة ──────────────────────────────────────────────────── */

/*
 * مسح الشاشة — يملأ كل الشاشة بالمسافات بلون معين
 * @param لون لون الخلفية والنص (بايت ألوان VGA)
 */
دالة امسح_الشاشة(لون: ع8) {
    /* الحرف الفارغ بالخلفية المطلوبة */
    متغير إدخال: ع16 = ((لون كـ ع16) << 8) | (' ' كـ ع16);

    لكل (متغير ن: ع32 = 0; ن < عرض_الشاشة * ارتفاع_الشاشة; ن++) {
        /* الكتابة مباشرة في ذاكرة VGA */
        عنوان_VGA[ن] = إدخال;
    }
}

/*
 * كتابة حرف واحد على الشاشة في موضع محدد
 * @param صف  رقم الصف (0-24)
 * @param عمود رقم العمود (0-79)
 * @param حرف الحرف المراد كتابته
 * @param لون  لون الحرف (بايت ألوان VGA)
 */
دالة اكتب_حرف(صف: ع32, عمود: ع32, حرف: ح8, لون: ع8) {
    متغير مكدس: ع32 = صف * عرض_الشاشة + عمود;
    عنوان_VGA[مكدس] = ((لون كـ ع16) << 8) | (حرف كـ ع16);
}

/*
 * كتابة نص ASCII على الشاشة ابتداءً من عمود معين في صف معين
 * @param صف    رقم الصف
 * @param عمود  عمود البداية
 * @param نص_c  نص ASCII تقليدي (منتهي بـ \0)
 * @param لون   لون النص
 */
دالة اكتب_نص(صف: ع32, عمود: ع32, نص_c: *ح8, لون: ع8) {
    متغير ع: ع32 = عمود;

    طالما (*نص_c != 0 وَ ع < عرض_الشاشة) {
        اكتب_حرف(صف, ع, *نص_c, لون);
        نص_c++;
        ع++;
    }
}

/*
 * رسم إطار حول الشاشة
 * يستخدم أحرف رسومية ASCII لرسم الحدود
 */
دالة ارسم_إطار() {
    /* الزوايا */
    اكتب_حرف(0,  0,  '+' كـ ح8, لون_أبيض_على_أزرق);
    اكتب_حرف(0,  79, '+' كـ ح8, لون_أبيض_على_أزرق);
    اكتب_حرف(24, 0,  '+' كـ ح8, لون_أبيض_على_أزرق);
    اكتب_حرف(24, 79, '+' كـ ح8, لون_أبيض_على_أزرق);

    /* الحدود الأفقية */
    لكل (متغير ع: ع32 = 1; ع < 79; ع++) {
        اكتب_حرف(0,  ع, '-' كـ ح8, لون_أبيض_على_أزرق);
        اكتب_حرف(24, ع, '-' كـ ح8, لون_أبيض_على_أزرق);
    }

    /* الحدود الرأسية */
    لكل (متغير ص: ع32 = 1; ص < 24; ص++) {
        اكتب_حرف(ص, 0,  '|' كـ ح8, لون_أبيض_على_أزرق);
        اكتب_حرف(ص, 79, '|' كـ ح8, لون_أبيض_على_أزرق);
    }
}


/* ─── إدارة الذاكرة البسيطة (Bump Allocator) ──────────────────────────────── */
/*
 * مُخصّص ذاكرة بسيط من نوع Bump Allocator.
 *
 * المبدأ: نحتفظ بمؤشر "البداية الحرة"،
 * كل تخصيص يُحرِّك المؤشر للأمام.
 * لا يدعم التحرير (dealloc) — مناسب لتخصيصات وقت بدء التشغيل.
 *
 * مثال تخطيط الذاكرة:
 *   [_heap_start ... مؤشر_التخصيص ... _heap_end]
 *   ←── مُخصَّص ───→←────── حر ─────────────→
 */

/* بداية ونهاية الـ heap — تُعرَّف في سكريبت الرابط */
خارجي ع8* _heap_start;
خارجي ع8* _heap_end;

/* المؤشر الحالي لمنطقة التخصيص */
متغير_عام مؤشر_heap: *ع8 = فراغ;

/*
 * تهيئة مُخصّص الـ heap البسيط
 * يجب استدعاؤها مرة واحدة في _start
 */
دالة هيئ_heap() {
    مؤشر_heap = &_heap_start;
}

/*
 * تخصيص كتلة ذاكرة
 * @param الحجم  عدد البايتات المطلوبة
 * @param المحاذاة محاذاة الذاكرة (يجب أن تكون قوة 2)
 * @return مؤشر للذاكرة المُخصَّصة أو فراغ إذا نفد
 */
دالة خصّص(الحجم: حجم, المحاذاة: حجم) -> *ع8 {
    /* محاذاة المؤشر الحالي */
    متغير عنوان: حجم = مؤشر_heap كـ حجم;
    متغير عنوان_محاذى: حجم = (عنوان + المحاذاة - 1) & !(المحاذاة - 1);

    /* التحقق من وجود مساحة كافية */
    إذا (عنوان_محاذى + الحجم > &_heap_end كـ حجم) {
        أرجع فراغ; /* نُرجع فراغ — المُستدعي يتحقق */
    }

    /* تحريك المؤشر وإعادة العنوان المُحاذى */
    مؤشر_heap = (عنوان_محاذى + الحجم) كـ *ع8;
    أرجع عنوان_محاذى كـ *ع8;
}


/* ─── نقطة الدخول الرئيسية ──────────────────────────────────────────────────── */
/*
 * دالة _start — نقطة دخول النواة
 *
 * تُستدعى مباشرةً من bootloader (مثلاً: GRUB بعد Multiboot).
 * يجب أن تُنجز المهام الأولية قبل استدعاء أي كود C/Sad آخر:
 *
 *   1. تصفير قسم .bss (المتغيرات غير المُهيّأة)
 *   2. تهيئة Heap
 *   3. إعداد شاشة VGA
 *   4. بدء الكود الفعلي للنواة
 *   5. حلقة لانهائية (يجب ألّا تنتهي النواة)
 *
 * ملاحظة: مؤشر المكدس (RSP) يُعيَّن في كود تجميع _start_asm
 * قبل استدعاء هذه الدالة.
 */
#[نقطة_دخول]
لن_ترجع دالة _start() {

    /* ── 1. تصفير قسم .bss ─────────────────────────────────────────────── */
    /*
     * .bss يحتوي متغيرات غير مُهيّأة — يجب تصفيرها يدوياً.
     * في Linux هذا يحدث تلقائياً، لكن في bare-metal نفعله بأنفسنا.
     */
    خارجي ع8* _bss_start;
    خارجي ع8* _bss_end;
    sad_memzero(&_bss_start, (&_bss_end كـ حجم) - (&_bss_start كـ حجم));

    /* ── 2. تهيئة الـ heap ─────────────────────────────────────────────── */
    هيئ_heap();

    /* ── 3. إعداد الشاشة ─────────────────────────────────────────────── */
    امسح_الشاشة(لون_أبيض_على_أزرق);
    ارسم_إطار();

    /* ── 4. رسالة الترحيب ───────────────────────────────────────────────── */
    اكتب_نص(2, 2, "===== نواة لغة ص (BeeOS) =====",        لون_أخضر_على_أسود);
    اكتب_نص(3, 2, "الإصدار: 0.1.0 — وضع Freestanding",     لون_أبيض_على_أزرق);
    اكتب_نص(5, 2, "تهيئة النواة...",                         لون_أبيض_على_أزرق);

    /* ── 5. اختبار دوال التحكم في freestanding ──────────────────────────── */

    /* اختبار جملة إذا/وإلا */
    متغير حالة_النواة: ع32 = 1;
    إذا (مرجَّح(حالة_النواة == 1)) {
        اكتب_نص(7, 2, "[OK] التحقق من إذا/وإلا — نجح", لون_أخضر_على_أسود);
    } وإلا {
        اكتب_نص(7, 2, "[!!] خطأ في التحكم", لون_أحمر_على_أسود);
    }

    /* اختبار حلقة لكل */
    متغير مجموع: ع32 = 0;
    لكل (متغير ن: ع32 = 1; ن <= 10; ن++) {
        مجموع += ن;
    }
    /* يجب أن يكون 55 */
    إذا (مجموع == 55) {
        اكتب_نص(8, 2, "[OK] حلقة لكل (1+2+...+10=55) — نجح", لون_أخضر_على_أسود);
    } وإلا {
        اكتب_نص(8, 2, "[!!] خطأ في حلقة لكل", لون_أحمر_على_أسود);
    }

    /* اختبار حلقة طالما مع أوقف */
    متغير رقم: ع32 = 0;
    طالما (صحيح) {
        رقم++;
        إذا (رقم >= 5) {
            أوقف;
        }
    }
    إذا (رقم == 5) {
        اكتب_نص(9, 2, "[OK] طالما + أوقف — نجح", لون_أخضر_على_أسود);
    } وإلا {
        اكتب_نص(9, 2, "[!!] خطأ في طالما/أوقف", لون_أحمر_على_أسود);
    }

    /* اختبار تطابق (match/switch) */
    متغير رمز: ع32 = 2;
    متغير نتيجة_تطابق: ع32 = 0;
    تطابق (رمز) {
        حالة 1 => { نتيجة_تطابق = 100; }
        حالة 2 => { نتيجة_تطابق = 200; }
        حالة 3 => { نتيجة_تطابق = 300; }
        _    => { نتيجة_تطابق = 999; }
    }
    إذا (نتيجة_تطابق == 200) {
        اكتب_نص(10, 2, "[OK] تطابق/حالة — نجح", لون_أخضر_على_أسود);
    } وإلا {
        اكتب_نص(10, 2, "[!!] خطأ في تطابق", لون_أحمر_على_أسود);
    }

    /* اختبار تخصيص heap */
    متغير كتلة: *ع8 = خصّص(256, 8);
    إذا (كتلة != فراغ) {
        sad_memset(كتلة, 0xAA, 256);
        اكتب_نص(11, 2, "[OK] تخصيص 256 بايت — نجح", لون_أخضر_على_أسود);
    } وإلا {
        اكتب_نص(11, 2, "[!!] فشل تخصيص الذاكرة", لون_أحمر_على_أسود);
    }

    /* ── 6. رسالة الانتهاء ───────────────────────────────────────────────── */
    اكتب_نص(13, 2, "تمت تهيئة النواة.",               لون_أبيض_على_أزرق);
    اكتب_نص(14, 2, "النواة جاهزة — الحلقة الرئيسية.", لون_أخضر_على_أسود);
    اكتب_نص(22, 2, "لغة ص | BeeOS v0.1 | Freestanding Mode", لون_أبيض_على_أزرق);

    /* ── 7. الحلقة الرئيسية للنواة ─────────────────────────────────────── */
    /*
     * النواة يجب أن تعمل إلى الأبد.
     * في نواة حقيقية: ندير المقاطعات، الجدولة، ملفات النظام...
     */
    حلقة {
        /* في مرحلة التطوير: نوقف المعالج وننتظر مقاطعة */
        /* هذا يوفر الطاقة ويمنع حلقة busy-wait             */
    }
}
