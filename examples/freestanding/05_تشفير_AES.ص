    متغير مفتاح: [ع8; 16] = [
        0x2B, 0x7E, 0x15, 0x16, 0x28, 0xAE, 0xD2, 0xA6,
        0xAB, 0xF7, 0x15, 0x88, 0x09, 0xCF, 0x4F, 0x3C
    ]

    # مصفوفة النتيجة المشفَّرة
    متغير مشفر: [ع8; 16]

    # تشفير الكتلة
    # النتيجة المتوقعة: 3925841D02DC09FBDC118597196A0B32
    شفِّر_AES(&نص, &مفتاح, &مشفر)

    # التحقق من النتيجة (القيمة المتوقعة هي المعروفة من معيار NIST)
    متغير صحيحة: منطق = (مشفر[0] == 0x39) & (مشفر[1] == 0x25)

    متغير _م: منطق = صحيحة

    حلقة {}
نهاية
