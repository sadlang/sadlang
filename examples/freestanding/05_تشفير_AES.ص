# ==============================================================================
# القسم 3: دوال العمليات الأساسية
# ==============================================================================

# SubBytes: تطبيق S-Box على كل بايت في الكتلة
# يُربك العلاقة بين النص الأصلي والمشفَّر
دالة sub_bytes(حالة: *[ع8; 16])
    متغير ن: ع32 = 0
    بينما (ن < 16)
        متغير قيمة: ع8 = (*حالة)[ن]
        (*حالة)[ن] = S_BOX[قيمة كـ ع32]
        ن = ن + 1
    نهاية
نهاية

# ShiftRows: إزاحة صفوف المصفوفة دورياً
# الصف 0: بدون إزاحة
# الصف 1: إزاحة بمقدار 1 يساراً
# الصف 2: إزاحة بمقدار 2 يساراً
# الصف 3: إزاحة بمقدار 3 يساراً
دالة shift_rows(حالة: *[ع8; 16])
    # الصف 1: إزاحة 1
    متغير مؤقت: ع8 = (*حالة)[1]
    (*حالة)[1]  = (*حالة)[5]
    (*حالة)[5]  = (*حالة)[9]
    (*حالة)[9]  = (*حالة)[13]
    (*حالة)[13] = مؤقت

    # الصف 2: إزاحة 2
    متغير م1: ع8 = (*حالة)[2]
    متغير م2: ع8 = (*حالة)[6]
    (*حالة)[2]  = (*حالة)[10]
    (*حالة)[6]  = (*حالة)[14]
    (*حالة)[10] = م1
    (*حالة)[14] = م2

    # الصف 3: إزاحة 3 (أو إزاحة 1 يميناً)
    متغير م3: ع8 = (*حالة)[15]
    (*حالة)[15] = (*حالة)[11]
    (*حالة)[11] = (*حالة)[7]
    (*حالة)[7]  = (*حالة)[3]
    (*حالة)[3]  = م3
نهاية

# ضرب في GF(2^8) — الحقل الثنائي المستخدم في AES
# الضرب في 2 مع الاختزال بالكثير حداً الأصيل 0x1B
دالة ضرب_GF(أ: ع8, ب: ع8) -> ع8
    متغير نتيجة: ع8 = 0
    متغير أأ: ع8 = أ
    متغير بب: ع8 = ب
    متغير ن: ع32 = 0
    بينما (ن < 8)
        إذا ((بب & 1) != 0)
            نتيجة = نتيجة ^ أأ
        نهاية
        متغير أعلى_بت: ع8 = أأ & 0x80
        أأ = (أأ << 1) & 0xFF
        إذا (أعلى_بت != 0)
            أأ = أأ ^ 0x1B  # الاختزال بالكثير حداً 0x11B
        نهاية
        بب = (بب >> 1) & 0xFF
        ن = ن + 1
    نهاية
    أرجع نتيجة
نهاية

# MixColumns: خلط أعمدة المصفوفة في GF(2^8)
# يُضيف انتشاراً للبتات عبر الكتلة
دالة mix_columns(حالة: *[ع8; 16])
    متغير ع: ع32 = 0
    بينما (ع < 4)
        متغير س0: ع8 = (*حالة)[ع × 4]
        متغير س1: ع8 = (*حالة)[ع × 4 + 1]
        متغير س2: ع8 = (*حالة)[ع × 4 + 2]
        متغير س3: ع8 = (*حالة)[ع × 4 + 3]

        (*حالة)[ع × 4]     = ضرب_GF(0x02, س0) ^ ضرب_GF(0x03, س1) ^ س2 ^ س3
        (*حالة)[ع × 4 + 1] = س0 ^ ضرب_GF(0x02, س1) ^ ضرب_GF(0x03, س2) ^ س3
        (*حالة)[ع × 4 + 2] = س0 ^ س1 ^ ضرب_GF(0x02, س2) ^ ضرب_GF(0x03, س3)
        (*حالة)[ع × 4 + 3] = ضرب_GF(0x03, س0) ^ س1 ^ س2 ^ ضرب_GF(0x02, س3)

        ع = ع + 1
    نهاية
نهاية

# AddRoundKey: جمع XOR مع مفتاح الجولة
دالة add_round_key(حالة: *[ع8; 16], مفاتيح: *ع8, جولة: ع32)
    متغير بداية: ع32 = جولة × 16
    متغير ن: ع32 = 0
    بينما (ن < 16)
        (*حالة)[ن] = (*حالة)[ن] ^ *((مفاتيح + ((بداية + ن) كـ عنوان)) كـ *ع8)
        ن = ن + 1
    نهاية
نهاية

# ==============================================================================
# القسم 4: توسيع المفتاح وتشفير الكتلة
# ==============================================================================

# توسيع المفتاح الأصلي (128 بت) إلى جدول مفاتيح الجولات (176 بايت)
دالة وسِّع_المفتاح(مفتاح: *[ع8; 16], جدول: *[ع8; 176])
    # نسخ المفتاح الأصلي للكلمات الأولى
    متغير ن: ع32 = 0
    بينما (ن < 16)
        (*جدول)[ن] = (*مفتاح)[ن]
        ن = ن + 1
    نهاية

    # توليد بقية مفاتيح الجولات
    متغير ي: ع32 = 4  # عدد الكلمات (كل كلمة = 4 بايت)
    بينما (ي < 44)
        متغير ك: ع32 = ي × 4
        متغير ق: ع32 = (ي - 1) × 4
        متغير ر: ع32 = (ي - 4) × 4

        إذا ((ي % 4) == 0)
            # RotWord: دوران الكلمة
            متغير ر0: ع8 = (*جدول)[ق]
            متغير ر1: ع8 = (*جدول)[ق + 1]
            متغير ر2: ع8 = (*جدول)[ق + 2]
            متغير ر3: ع8 = (*جدول)[ق + 3]
            # SubWord: تطبيق S-Box
            متغير س0: ع8 = S_BOX[ر1 كـ ع32]
            متغير س1: ع8 = S_BOX[ر2 كـ ع32]
            متغير س2: ع8 = S_BOX[ر3 كـ ع32]
            متغير س3: ع8 = S_BOX[ر0 كـ ع32]
            # XOR مع Rcon
            متغير rcon: ع8 = RCON[ي / 4]
            (*جدول)[ك]     = (*جدول)[ر]     ^ س0 ^ rcon
            (*جدول)[ك + 1] = (*جدول)[ر + 1] ^ س1
            (*جدول)[ك + 2] = (*جدول)[ر + 2] ^ س2
            (*جدول)[ك + 3] = (*جدول)[ر + 3] ^ س3
        وإلا
            (*جدول)[ك]     = (*جدول)[ر]     ^ (*جدول)[ق]
            (*جدول)[ك + 1] = (*جدول)[ر + 1] ^ (*جدول)[ق + 1]
            (*جدول)[ك + 2] = (*جدول)[ر + 2] ^ (*جدول)[ق + 2]
            (*جدول)[ك + 3] = (*جدول)[ر + 3] ^ (*جدول)[ق + 3]
        نهاية

        ي = ي + 1
    نهاية
نهاية

# تشفير كتلة 16 بايت باستخدام AES-128
دالة شفِّر_AES(نص_واضح: *[ع8; 16], مفتاح: *[ع8; 16], نص_مشفر: *[ع8; 16])
    # جدول مفاتيح الجولات
    متغير جدول_مفاتيح: [ع8; 176]
    وسِّع_المفتاح(مفتاح, &جدول_مفاتيح)

    # نسخ النص الواضح إلى مصفوفة الحالة
    متغير حالة: [ع8; 16]
    متغير ن: ع32 = 0
    بينما (ن < 16)
        حالة[ن] = (*نص_واضح)[ن]
        ن = ن + 1
    نهاية

    # الجولة الأولية: AddRoundKey فقط
    add_round_key(&حالة, جدول_مفاتيح كـ *ع8, 0)

    # الجولات 1-9: جميع العمليات الأربع
    متغير جولة: ع32 = 1
    بينما (جولة < 10)
        sub_bytes(&حالة)
        shift_rows(&حالة)
        mix_columns(&حالة)
        add_round_key(&حالة, جدول_مفاتيح كـ *ع8, جولة)
        جولة = جولة + 1
    نهاية

    # الجولة الأخيرة (10): بدون MixColumns
    sub_bytes(&حالة)
    shift_rows(&حالة)
    add_round_key(&حالة, جدول_مفاتيح كـ *ع8, 10)

    # نسخ الناتج إلى مصفوفة النص المشفَّر
    متغير ن2: ع32 = 0
    بينما (ن2 < 16)
        (*نص_مشفر)[ن2] = حالة[ن2]
        ن2 = ن2 + 1
    نهاية
نهاية

