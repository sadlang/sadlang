// ── استيراد رأس freestanding الخاص بلغة ص ───────────────────────────────
//
// sad_core.h يوفر:
//   - الأنواع الأساسية: ع8, ع16, ع32, ع64, ح8, ح16, ح32, ح64, حجم, عنوان
//   - ماكروهات التحكم: إذا, وإلا, طالما, لكل, حلقة, أوقف, أكمل
//   - دوال الذاكرة: sad_memcpy, sad_memset, sad_memzero
//   - دوال النصوص: sad_strlen, sad_strncpy
//   - ماكرو الذعر: تأكد(), تأكد_لن_يُنفَّذ
//   - ماكروهات المزامنة: قسم_حرج_بدء, قسم_حرج_نهاية, حاجز_ذاكرة
//
#تضمين <runtime_new/freestanding/sad_core.h>

// ════════════════════════════════════════════════════════════════════════════
// القسم 1: ثوابت العتاد (Hardware Constants)
// ════════════════════════════════════════════════════════════════════════════
//
// هذه الثوابت تُمثِّل عناوين المسجلات ومناطق الذاكرة المعرّفة بالعتاد.
// قيمها ثابتة ومُحدَّدة في وثيقة عتاد الجهاز المستهدف.
//

// عنوان مسجل UART0 للكتابة على المنفذ التسلسلي (لوحة QEMU virt ARM)
ثابت عنوان عنوان_UART0 = 0x09000000;

// عنوان معالج المقاطعات (GIC Distributor على ARM Cortex-A)
ثابت عنوان عنوان_GIC  = 0x08000000;

// الحجم الكلي للذاكرة العشوائية (RAM) — 128 ميغابايت
ثابت حجم  حجم_RAM    = 128 * 1024 * 1024;

// عنوان بداية كومة الذاكرة (heap) بعد نهاية كود النواة
// يُحدَّد هذا عادةً بواسطة سكريبت الرابط عبر رمز __heap_start
ثابت عنوان بداية_الكومة = 0x40100000;

// ════════════════════════════════════════════════════════════════════════════
// القسم 2: هياكل البيانات (Data Structures)
// ════════════════════════════════════════════════════════════════════════════

// معلومات عملية النظام (Process Control Block مُبسَّط)
// في نواة حقيقية هذا أكثر تعقيداً يشمل جداول الصفحات، مسجِّلات المعالج، ...
هيكل معلومات_العملية {
    ع32 المعرّف;          // Process ID - رقم تعريف العملية
    ع32 الأولوية;         // Priority - مستوى الأولوية (0=الأعلى)
    عنوان المكدّس;        // Stack pointer - مؤشر مكدّس العملية
    عنوان البرنامج_العداد; // Program counter - مؤشر التعليمة التالية
    ح8  اسم[32];          // Process name - اسم العملية (UTF-8)
    ح8  الحالة;           // State: 0=منتظر, 1=يعمل, 2=محجوب, 3=منتهي
};

// ════════════════════════════════════════════════════════════════════════════
// القسم 3: دوال وضع Freestanding الأساسية
// ════════════════════════════════════════════════════════════════════════════

// ── دالة الكتابة على UART (المنفذ التسلسلي) ─────────────────────────────
//
// في بيئة freestanding لا يوجد printf أو cout.
// نكتب مباشرة على مسجل UART للحصول على مخرجات تشخيصية.
//
// الطريقة: نكتب كل بايت مباشرة إلى عنوان الذاكرة المُعيَّن للـUART.
// المعالج سيرسل البايت تلقائياً عبر المنفذ التسلسلي.
//
دالة كتابة_حرف(ح8 حرف) → فراغ {
    // الوصول المباشر لذاكرة العتاد عبر مؤشر متطاير (volatile pointer)
    // volatile يمنع المترجم من تحسين أو حذف عملية الكتابة
    ح8 متطاير* مسجل_uart = (ح8 متطاير*)عنوان_UART0;
    *مسجل_uart = حرف;
}

// ── دالة طباعة نص على UART ───────────────────────────────────────────────
//
// تطبع نصاً كاملاً حرفاً بحرف على المنفذ التسلسلي.
// تتوقف عند بايت الصفر (نهاية النص بنظام C).
//
دالة طباعة_نص(ثابت ح8* نص) → فراغ {
    // (AR) استخدام ماكرو طالما من sad_control_flow.h
    طالما (*نص != 0) {
        كتابة_حرف(*نص);
        نص = نص + 1;  // التقدم للحرف التالي
    }
}

// ── دالة طباعة رقم سداسي عشري على UART ──────────────────────────────────
//
// في freestanding لا يوجد printf لطباعة الأرقام.
// نحول الرقم يدوياً إلى تمثيله السداسي عشري ونطبعه.
//
دالة طباعة_سداسي(ع64 رقم) → فراغ {
    ثابت ح8* أرقام_سداسي = "0123456789ABCDEF";
    ح8  مخزن[19];    // "0x" + 16 خانة + '\0'
    ع32 موضع = 18;
    
    مخزن[18] = 0;    // نهاية النص
    
    // (AR) ماكرو إذا للتحقق من صفر
    إذا (رقم == 0) {
        طباعة_نص("0x0");
        أرجع;
    }
    
    // تحويل الرقم خانة خانة من اليمين إلى اليسار
    طالما (رقم > 0) {
        موضع = موضع - 1;
        مخزن[موضع] = أرقام_سداسي[رقم & 0xF];
        رقم = رقم >> 4;
    }
    موضع = موضع - 1; مخزن[موضع] = 'x';
    موضع = موضع - 1; مخزن[موضع] = '0';
    
    طباعة_نص(&مخزن[موضع]);
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 4: مدير الذاكرة المبسَّط (Simple Memory Manager)
// ════════════════════════════════════════════════════════════════════════════
//
// في وضع freestanding لا يوجد malloc/free من مكتبة C.
// نُنفِّذ مخصِّص ذاكرة بسيطاً (bump allocator) يعمل بالمبدأ التالي:
//   1. لدينا مؤشر لبداية الذاكرة المتاحة (مؤشر_الكومة)
//   2. عند طلب تخصيص n بايت، نُعيد المؤشر الحالي ونُقدِّمه n خطوة
//   3. لا يوجد تحرير فعلي للذاكرة (مناسب للأنظمة البسيطة)
//
// ملاحظة: في نواة حقيقية تستخدم خوارزميات أعقد مثل:
//   - Buddy System (نظام التوأم)
//   - Slab Allocator
//   - SLUB/SLOB في لينكس

متغير عنوان مؤشر_الكومة = بداية_الكومة;
متغير حجم   ذاكرة_مستخدمة = 0;

// تخصيص ذاكرة بسيط (Bump Allocator)
دالة مُخصِّص_بسيط(حجم عدد_البايتات) → عنوان {
    // (AR) محاذاة 8 بايت لأداء أفضل على x86-64 وARM64
    //      المحاذاة تضمن الوصول الفعّال لمسجلات 64 بت
    ثابت حجم محاذاة = 8;
    حجم باقي = عدد_البايتات % محاذاة;
    إذا (باقي != 0) {
        عدد_البايتات = عدد_البايتات + (محاذاة - باقي);
    }
    
    // التحقق من توفر ذاكرة كافية
    إذا (ذاكرة_مستخدمة + عدد_البايتات > حجم_RAM) {
        // الذاكرة ممتلئة — ذعر النواة!
        // (AR) ماكرو تأكد يتوقف إذا فشل الشرط
        تأكد(خطأ);  // الذاكرة ممتلئة — لا يمكن الاستمرار
        أرجع 0;
    }
    
    عنوان نتيجة = مؤشر_الكومة;
    مؤشر_الكومة     = مؤشر_الكومة + عدد_البايتات;
    ذاكرة_مستخدمة  = ذاكرة_مستخدمة + عدد_البايتات;
    
    // تصفير الذاكرة المُخصَّصة (أمان أساسي)
    sad_memzero((ح8*)نتيجة, عدد_البايتات);
    
    أرجع نتيجة;
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 5: معالج الذعر (Panic Handler)
// ════════════════════════════════════════════════════════════════════════════
//
// في وضع freestanding، عند حدوث خطأ فادح لا يمكن استرجاعه،
// تستدعي لغة ص دالة الذعر. هذه الدالة يجب أن:
//   1. تطبع رسالة الخطأ (إن أمكن)
//   2. تُوقف المعالج بشكل آمن
//   3. لا ترجع أبداً (noreturn/لن_ترجع)
//
// السمة #[معالج_ذعر] تُخبر المترجم أن يستخدم هذه الدالة عند الذعر.
//

#[معالج_ذعر]
لن_ترجع دالة معالج_الذعر(ثابت ح8* رسالة, ثابت ح8* ملف, ع32 سطر) {
    // طباعة معلومات الذعر على UART
    طباعة_نص("\n╔══════════════════════════════╗\n");
    طباعة_نص("║       ذعر النواة!             ║\n");
    طباعة_نص("║       KERNEL PANIC!           ║\n");
    طباعة_نص("╚══════════════════════════════╝\n");
    طباعة_نص("الرسالة: ");
    طباعة_نص(رسالة);
    طباعة_نص("\nالملف: ");
    طباعة_نص(ملف);
    طباعة_نص(" | السطر: ");
    طباعة_سداسي((ع64)سطر);
    طباعة_نص("\n");
    طباعة_نص("النظام متوقف. / System halted.\n");
    
    // إيقاف المعالج بحلقة لا نهائية مع تعطيل المقاطعات
    // (AR) قسم_حرج_بدء يعطّل المقاطعات (cli على x86)
    قسم_حرج_بدء;
    حلقة {
        // (AR) ماكرو انتظر_حتى(خطأ) → حلقة توقف ابدية
        // في x86 يمكن استخدام hlt instruction هنا
        // hlt;
    }
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 6: تهيئة الجدول المتجه (Interrupt Vector Table)
// ════════════════════════════════════════════════════════════════════════════
//
// جدول المتجهات يُخبر المعالج أين توجد معالجات المقاطعات والاستثناءات.
// على ARM يُسمى Vector Table، على x86 يُسمى IDT (Interrupt Descriptor Table).
//

// نوع دالة معالج المقاطعة
// نوع معالج_مقاطعة = دالة() → فراغ;

// معالج افتراضي للمقاطعات غير المعالجة
دالة معالج_افتراضي() → فراغ {
    طباعة_نص("تحذير: مقاطعة غير معالجة!\n");
    // في نظام حقيقي: تسجيل المقاطعة وإيقافها
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 7: جدولة العمليات المبسَّطة (Simple Process Scheduler)
// ════════════════════════════════════════════════════════════════════════════
//
// جدولة دورية (Round-Robin) مبسَّطة لتوضيح المفاهيم
//

ثابت ع32 الحد_الأقصى_للعمليات = 8;
متغير معلومات_العملية  قائمة_العمليات[8];  // مصفوفة ثابتة الحجم (لا dynamic arrays)
متغير ع32              عدد_العمليات = 0;
متغير ع32              العملية_الحالية = 0;

// إضافة عملية جديدة للجدول
دالة أضف_عملية(ثابت ح8* الاسم, ع32 الأولوية) → ع32 {
    إذا (عدد_العمليات >= الحد_الأقصى_للعمليات) {
        طباعة_نص("خطأ: الجدول ممتلئ!\n");
        أرجع 0xFFFFFFFF;  // معرّف خاطئ
    }
    
    ع32 معرّف = عدد_العمليات;
    معلومات_العملية* عملية = &قائمة_العمليات[معرّف];
    
    عملية->المعرّف   = معرّف;
    عملية->الأولوية = الأولوية;
    عملية->الحالة   = 0;  // منتظر
    
    // نسخ الاسم بأمان (لا strcpy بدون مكتبة قياسية)
    sad_strncpy(عملية->اسم, الاسم, 31);
    عملية->اسم[31] = 0;  // التأكد من نهاية النص
    
    عدد_العمليات = عدد_العمليات + 1;
    أرجع معرّف;
}

// الانتقال للعملية التالية (Round-Robin)
دالة جدولة_التالية() → فراغ {
    إذا (عدد_العمليات == 0) {
        أرجع;
    }
    
    // الانتقال للعملية التالية بشكل دوري
    العملية_الحالية = (العملية_الحالية + 1) % عدد_العمليات;
    
    معلومات_العملية* عملية = &قائمة_العمليات[العملية_الحالية];
    عملية->الحالة = 1;  // يعمل
    
    طباعة_نص("الجدولة: تشغيل العملية [");
    طباعة_نص(عملية->اسم);
    طباعة_نص("]\n");
}

// ════════════════════════════════════════════════════════════════════════════
// القسم 8: نقطة الدخول الرئيسية (_start)
// ════════════════════════════════════════════════════════════════════════════
//
// هذه الدالة هي أول كود يُنفَّذ بعد تحميل النواة في الذاكرة.
// في نظام x86 الحقيقي تسبقها مرحلة:
//   1. BIOS/UEFI يُحمِّل boot sector
//   2. Boot loader (GRUB) يضغط النواة في الذاكرة
//   3. يقفز إلى _start في وضع 64 بت محمي
//
// على QEMU virt ARM:
//   1. QEMU يضع صورة النواة مباشرة في الذاكرة من العنوان 0x40000000
//   2. يقفز مباشرة إلى _start
//
// مسؤوليات _start:
//   ✓ تهيئة قسم .bss (صفر متغيرات غير مهيَّأة)
//   ✓ إعداد مكدّس C
//   ✓ طباعة رسالة ترحيب
//   ✓ تهيئة المكوّنات الأساسية
//   ✓ الدخول في الحلقة الرئيسية
//

#[نقطة_دخول]
لن_ترجع دالة _start() {
    // ════════════════════════════════════════════════════
    // الخطوة 1: تهيئة قسم .bss
    // ════════════════════════════════════════════════════
    // (AR) سكريبت الرابط يُعرِّف رموز __bss_start و __bss_end
    //      يجب تصفير هذه المنطقة يدوياً قبل استخدام أي متغيرات عامة
    //      لأن ELF لا يُهيِّئها تلقائياً بدون CRT
    // (EN) Linker script defines __bss_start and __bss_end
    //      Must be zeroed manually before using global variables
    // ════════════════════════════════════════════════════
    // تصريح خارجي لرموز سكريبت الرابط
    // extern ع8 __bss_start[], __bss_end[];
    // sad_memzero(__bss_start, (حجم)(__bss_end - __bss_start));
    
    // ════════════════════════════════════════════════════
    // الخطوة 2: رسالة الترحيب على UART
    // ════════════════════════════════════════════════════
    طباعة_نص("\n");
    طباعة_نص("╔═══════════════════════════════════════╗\n");
    طباعة_نص("║    نواة لغة ص — Sad OS Kernel         ║\n");
    طباعة_نص("║    إصدار 0.1.0 (Alpha)                ║\n");
    طباعة_نص("╚═══════════════════════════════════════╝\n");
    طباعة_نص("\n");

    // ════════════════════════════════════════════════════
    // الخطوة 3: عرض معلومات النظام
    // ════════════════════════════════════════════════════
    طباعة_نص("عنوان UART0: ");
    طباعة_سداسي((ع64)عنوان_UART0);
    طباعة_نص("\n");
    
    طباعة_نص("بداية الكومة: ");
    طباعة_سداسي((ع64)بداية_الكومة);
    طباعة_نص("\n");
    
    طباعة_نص("حجم RAM: ");
    طباعة_سداسي((ع64)حجم_RAM);
    طباعة_نص(" بايت\n\n");

    // ════════════════════════════════════════════════════
    // الخطوة 4: اختبار مُخصِّص الذاكرة
    // ════════════════════════════════════════════════════
    طباعة_نص("── اختبار تخصيص الذاكرة ──\n");
    
    عنوان مخزن1 = مُخصِّص_بسيط(1024);
    طباعة_نص("مخزن 1024 بايت: ");
    طباعة_سداسي((ع64)مخزن1);
    طباعة_نص("\n");
    
    عنوان مخزن2 = مُخصِّص_بسيط(4096);
    طباعة_نص("مخزن 4096 بايت: ");
    طباعة_سداسي((ع64)مخزن2);
    طباعة_نص("\n");
    
    // التحقق من أن المخازن متتالية ومحاذاة
    تأكد(مخزن2 == مخزن1 + 1024);  // يجب أن تكون متتالية
    طباعة_نص("✓ تخصيص الذاكرة يعمل بشكل صحيح\n\n");

    // ════════════════════════════════════════════════════
    // الخطوة 5: اختبار هياكل البيانات
    // ════════════════════════════════════════════════════
    طباعة_نص("── اختبار الجدولة ──\n");
    
    أضف_عملية("نظام_الملفات", 1);
    أضف_عملية("مدير_الذاكرة", 0);
    أضف_عملية("واجهة_المستخدم", 2);
    
    طباعة_نص("عدد العمليات المسجَّلة: ");
    طباعة_سداسي((ع64)عدد_العمليات);
    طباعة_نص("\n");
    
    // (AR) تشغيل دورتين من الجدولة لاختبارها
    // (EN) Run two scheduling rounds to test it
    جدولة_التالية();
    جدولة_التالية();
    جدولة_التالية();
    طباعة_نص("\n");

    // ════════════════════════════════════════════════════
    // الخطوة 6: اختبار ماكروهات التحكم في sad_control_flow.h
    // ════════════════════════════════════════════════════
    طباعة_نص("── اختبار هياكل التحكم ──\n");
    
    // اختبار إذا/وإلا
    ع32 قيمة = 42;
    إذا (قيمة > 100) {
        طباعة_نص("القيمة كبيرة\n");
    } وإلا_إذا (قيمة > 10) {
        طباعة_نص("✓ إذا/وإلا_إذا: القيمة متوسطة (42)\n");
    } وإلا {
        طباعة_نص("القيمة صغيرة\n");
    }
    
    // اختبار لكل
    طباعة_نص("✓ لكل [0..4]: ");
    لكل (ع32 ع = 0; ع < 5; ع = ع + 1) {
        طباعة_سداسي((ع64)ع);
        طباعة_نص(" ");
    }
    طباعة_نص("\n");
    
    // اختبار طالما مع أوقف
    ع32 عداد = 0;
    طالما (صحيح) {
        عداد = عداد + 1;
        إذا (عداد >= 5) {
            أوقف;  // ← ماكرو أوقف = break
        }
    }
    طباعة_نص("✓ طالما + أوقف: العداد = ");
    طباعة_سداسي((ع64)عداد);
    طباعة_نص(" (يجب أن يكون 5)\n");
    
    // اختبار تطابق (switch)
    ع32 حالة_النظام = 2;
    تطابق (حالة_النظام) {
        حالة 0: طباعة_نص("النظام: متوقف\n"); أوقف;
        حالة 1: طباعة_نص("النظام: يهدأ\n"); أوقف;
        حالة 2: طباعة_نص("✓ تطابق: النظام يعمل\n"); أوقف;
        افتراضي: طباعة_نص("النظام: حالة غير معروفة\n");
    }

    // ════════════════════════════════════════════════════
    // الخطوة 7: اختبار عمليات الذاكرة من sad_core.h
    // ════════════════════════════════════════════════════
    طباعة_نص("\n── اختبار عمليات الذاكرة ──\n");
    
    ح8 مصدر[16] = "مرحباً بالنواة!";  // تعليق: سيكون UTF-8
    ح8 هدف[16]  = {0};
    
    // نسخ الذاكرة
    sad_memcpy(هدف, مصدر, 16);
    طباعة_نص("✓ sad_memcpy: ");
    طباعة_نص(هدف);
    طباعة_نص("\n");
    
    // تعبئة الذاكرة
    sad_memset(هدف, 0xAB, 4);
    طباعة_نص("✓ sad_memset [4 بايت → 0xAB]\n");
    
    // تصفير الذاكرة
    sad_memzero(هدف, 16);
    طباعة_نص("✓ sad_memzero\n");

    // ════════════════════════════════════════════════════
    // الخطوة 8: الحلقة الرئيسية للنواة (Kernel Main Loop)
    // ════════════════════════════════════════════════════
    //
    // في نواة حقيقية هذه الحلقة تُنفِّذ:
    //   - انتظار المقاطعات (WFI/WFE على ARM)
    //   - جدولة العمليات عند كل مقاطعة مؤقت (timer tick)
    //   - معالجة دوال time-critical
    //
    طباعة_نص("\n══════════════════════════════════════════\n");
    طباعة_نص("  النظام جاهز. / System ready.\n");
    طباعة_نص("  الحلقة الرئيسية... / Main loop...\n");
    طباعة_نص("══════════════════════════════════════════\n");
    
    // الحلقة الرئيسية — لن تنتهي أبداً
    حلقة {
        // الانتظار بين دورات الجدولة
        // في بيئة حقيقية: hlt (x86) أو wfi (ARM) لتوفير الطاقة
        انتظر_بينما(خطأ);  // ← سيدور مباشرة في هذا المثال
        
        // جدولة العملية التالية عند كل دورة (مُبسَّط)
        // في الحقيقة: يُستدعى من معالج مقاطعة المؤقت
        // جدولة_التالية();
        
        أوقف;  // ← للاختبار فقط: نخرج بعد دورة واحدة
    }
    
    // هذا السطر لن يُنفَّذ أبداً (لن_ترجع)
    // لكن المترجم يتطلبه للتحقق من الأنواع
    تأكد_لن_يُنفَّذ;
}

