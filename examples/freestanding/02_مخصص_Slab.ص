# ==============================================================================
# المثال 02: مخصِّص ذاكرة Slab — وضع Freestanding  
# ==============================================================================
#
# مخصِّص Slab هو خوارزمية إدارة ذاكرة عالية الكفاءة تستخدم في أنوية
# لينكس (Linux Kernel) وأنظمة التشغيل الاحترافية. المبدأ:
#   - تقسيم الذاكرة إلى "ألواح" (Slabs) من كائنات بنفس الحجم
#   - إعادة استخدام الكائنات بدلاً من التخصيص/التحرير المتكرر
#   - أداء O(1) للتخصيص والتحرير
#   - القضاء التام على تجزئة الذاكرة (Memory Fragmentation)
#
# الاستخدام مع sadc:
#   sadc --freestanding 02_مخصص_Slab.ص -o slab_kernel.elf
# ==============================================================================

#![بلا_مكتبة_قياسية]
#![بلا_رئيسية]

#تضمين <runtime_new/freestanding/sad_core.h>

# ==============================================================================
# القسم 1: ثوابت مخصِّص Slab
# ==============================================================================

# عدد طبقات الحجم المدعومة (8، 16، 32، 64، 128، 256، 512، 1024 بايت)
ثابت عدد_الطبقات: ع32 = 8
# الحجم الأدنى لكائن واحد (بايت)
ثابت حجم_أدنى: ع32 = 8
# عدد الكائنات في كل لوح (Slab)
ثابت كائنات_كل_لوح: ع32 = 64
# عنوان ذاكرة كومة الـ Slab (1 ميغابايت)
ثابت عنوان_كومة_Slab: عنوان = 0x00400000
# حجم حوض الذاكرة (4 ميغابايت)
ثابت حجم_حوض: عنوان = 0x00400000
# قيمة الحارس `magic` للكشف عن تلف الذاكرة
ثابت قيمة_حارس: ع32 = 0xDEADBEEF

# ==============================================================================
# القسم 2: هياكل البيانات
# ==============================================================================

# رأس الكائن — موجود في بداية كل كائن محرَّر (free object)
# عند التحرير: يُحوَّل الكائن إلى عقدة في قائمة الكائنات الحرة
هيكل رأس_كائن_حر {
    التالي: *رأس_كائن_حر;  # مؤشر للكائن الحر التالي
    حارس: ع32;             # قيمة 0xDEADBEEF للتحقق من سلامة الذاكرة
}

# رأس اللوح (Slab) — يحتوي معلومات عن كل لوح من الذاكرة
هيكل رأس_لوح {
    التالي: *رأس_لوح;          # اللوح التالي في القائمة
    أول_حر: *رأس_كائن_حر;     # أول كائن حر في هذا اللوح
    المستخدم: ع32;             # عدد الكائنات المستخدمة حالياً
    إجمالي: ع32;               # إجمالي عدد الكائنات في اللوح
    حجم_الكائن: ع32;           # حجم كل كائن بالبايت
    حارس: ع32;                 # حارس سلامة اللوح
}

# ذاكرة التخزين المؤقت (Cache) — قائمة الألواح لحجم كائن معين
هيكل ذاكرة_مؤقتة_Slab {
    أول_لوح: *رأس_لوح;         # أول لوح في القائمة
    حجم_الكائن: ع32;           # حجم الكائن الذي تخدمه هذه الذاكرة المؤقتة
    إجمالي_مخصص: ع32;          # إجمالي الكائنات المخصصة
    إجمالي_محرر: ع32;           # إجمالي الكائنات المحررة
}

# ==============================================================================
# القسم 3: حالة المخصِّص العامة  
# ==============================================================================

# مصفوفة ذاكرات مؤقتة لكل حجم كائن مدعوم
# الأحجام: 8، 16، 32، 64، 128، 256، 512، 1024 بايت
متغير_عام ذاكرات_مؤقتة: [ذاكرة_مؤقتة_Slab; 8] = [
    ذاكرة_مؤقتة_Slab { أول_لوح: 0 كـ *رأس_لوح, حجم_الكائن: 8,    إجمالي_مخصص: 0, إجمالي_محرر: 0 },
    ذاكرة_مؤقتة_Slab { أول_لوح: 0 كـ *رأس_لوح, حجم_الكائن: 16,   إجمالي_مخصص: 0, إجمالي_محرر: 0 },
    ذاكرة_مؤقتة_Slab { أول_لوح: 0 كـ *رأس_لوح, حجم_الكائن: 32,   إجمالي_مخصص: 0, إجمالي_محرر: 0 },
    ذاكرة_مؤقتة_Slab { أول_لوح: 0 كـ *رأس_لوح, حجم_الكائن: 64,   إجمالي_مخصص: 0, إجمالي_محرر: 0 },
    ذاكرة_مؤقتة_Slab { أول_لوح: 0 كـ *رأس_لوح, حجم_الكائن: 128,  إجمالي_مخصص: 0, إجمالي_محرر: 0 },
    ذاكرة_مؤقتة_Slab { أول_لوح: 0 كـ *رأس_لوح, حجم_الكائن: 256,  إجمالي_مخصص: 0, إجمالي_محرر: 0 },
    ذاكرة_مؤقتة_Slab { أول_لوح: 0 كـ *رأس_لوح, حجم_الكائن: 512,  إجمالي_مخصص: 0, إجمالي_محرر: 0 },
    ذاكرة_مؤقتة_Slab { أول_لوح: 0 كـ *رأس_لوح, حجم_الكائن: 1024, إجمالي_مخصص: 0, إجمالي_محرر: 0 }
]

# مؤشر حوض الذاكرة — من أين نأخذ ذاكرة جديدة للألواح
متغير_عام مؤشر_حوض: عنوان = عنوان_كومة_Slab
# نهاية حوض الذاكرة
متغير_عام نهاية_حوض: عنوان = عنوان_كومة_Slab + حجم_حوض

# ==============================================================================
# القسم 4: دوال مساعدة
# ==============================================================================

# تخصيص ذاكرة خام من الحوض بمحاذاة 8 بايت
# هذا التخصيص أولي — الـ Slab allocator يبني فوقه
دالة خصص_من_حوض(الحجم: عنوان) -> عنوان
    # محاذاة لـ 8 بايت لضمان الكفاءة
    متغير محاذاة: عنوان = (مؤشر_حوض + 7) & 0xFFFFFFFFFFFFFFF8
    متغير نهاية_التخصيص: عنوان = محاذاة + الحجم

    إذا (نهاية_التخصيص > نهاية_حوض)
        أرجع 0  # نفاد الذاكرة
    نهاية

    مؤشر_حوض = نهاية_التخصيص
    أرجع محاذاة
نهاية

# الحصول على فهرس الطبقة المناسبة لحجم معين
# مثال: 10 بايت → فهرس 1 (طبقة 16 بايت)
دالة طبقة_لـ_حجم(الحجم: ع32) -> ع32
    متغير حجم_طبقة: ع32 = 8
    متغير فهرس: ع32 = 0

    بينما (فهرس < عدد_الطبقات)
        إذا (الحجم <= حجم_طبقة)
            أرجع فهرس
        نهاية
        حجم_طبقة = حجم_طبقة × 2
        فهرس = فهرس + 1
    نهاية

    أرجع عدد_الطبقات  # أكبر من 1024 — خارج نطاق الـ Slab
نهاية

# ==============================================================================
# القسم 5: إنشاء لوح جديد
# ==============================================================================

# إنشاء لوح جديد وتهيئته لحجم كائن معين
# يُقسِّم الذاكرة المخصصة إلى قائمة مترابطة من الكائنات الحرة
دالة أنشئ_لوح(حجم_كائن: ع32) -> *رأس_لوح
    # حساب حجم اللوح الكلي: رأس + (عدد_كائنات × حجم_كائن)
    متغير حجم_كلي: عنوان = (حجم_رأس_لوح كـ عنوان) + (كائنات_كل_لوح × حجم_كائن كـ عنوان)
    متغير عنوان_لوح: عنوان = خصص_من_حوض(حجم_كلي)

    إذا (عنوان_لوح == 0)
        أرجع 0 كـ *رأس_لوح  # فشل التخصيص
    نهاية

    # تهيئة رأس اللوح
    متغير لوح: *رأس_لوح = عنوان_لوح كـ *رأس_لوح
    (*لوح).التالي = 0 كـ *رأس_لوح
    (*لوح).المستخدم = 0
    (*لوح).إجمالي = كائنات_كل_لوح
    (*لوح).حجم_الكائن = حجم_كائن
    (*لوح).حارس = قيمة_حارس

    # بناء قائمة الكائنات الحرة
    # بداية منطقة الكائنات (بعد رأس اللوح)
    متغير عنوان_كائنات: عنوان = عنوان_لوح + (حجم_رأس_لوح كـ عنوان)
    متغير أخير: *رأس_كائن_حر = 0 كـ *رأس_كائن_حر

    # ربط الكائنات من الأخير للأول (ليكون الأول هو رأس القائمة)
    متغير ن: ع32 = كائنات_كل_لوح
    بينما (ن > 0)
        ن = ن - 1
        متغير عنوان_ك: عنوان = عنوان_كائنات + ((ن × حجم_كائن) كـ عنوان)
        متغير كائن: *رأس_كائن_حر = عنوان_ك كـ *رأس_كائن_حر
        (*كائن).التالي = أخير
        (*كائن).حارس = قيمة_حارس
        أخير = كائن
    نهاية

    (*لوح).أول_حر = أخير
    أرجع لوح
نهاية

# ==============================================================================
# القسم 6: التخصيص والتحرير
# ==============================================================================

# تخصيص كائن من المخصِّص — أداء O(1) مضمون
دالة slab_خصص(الحجم: ع32) -> عنوان
    متغير فهرس: ع32 = طبقة_لـ_حجم(الحجم)
    إذا (فهرس >= عدد_الطبقات)
        أرجع 0  # حجم غير مدعوم
    نهاية

    متغير ذاكرة: *ذاكرة_مؤقتة_Slab = &ذاكرات_مؤقتة[فهرس]

    # البحث عن لوح فيه مكان فارغ
    متغير لوح: *رأس_لوح = (*ذاكرة).أول_لوح
    بينما (لوح != (0 كـ *رأس_لوح))
        إذا ((*لوح).أول_حر != (0 كـ *رأس_كائن_حر))
            # وجدنا لوحاً فيه مكان — خصص الكائن الأول الحر
            متغير كائن: *رأس_كائن_حر = (*لوح).أول_حر
            (*لوح).أول_حر = (*كائن).التالي
            (*لوح).المستخدم = (*لوح).المستخدم + 1
            (*ذاكرة).إجمالي_مخصص = (*ذاكرة).إجمالي_مخصص + 1
            أرجع كائن كـ عنوان
        نهاية
        لوح = (*لوح).التالي
    نهاية

    # لا يوجد لوح فارغ — أنشئ لوحاً جديداً
    متغير لوح_جديد: *رأس_لوح = أنشئ_لوح((*ذاكرة).حجم_الكائن)
    إذا (لوح_جديد == (0 كـ *رأس_لوح))
        أرجع 0  # فشل إنشاء اللوح
    نهاية

    # ربط اللوح الجديد في بداية القائمة
    (*لوح_جديد).التالي = (*ذاكرة).أول_لوح
    (*ذاكرة).أول_لوح = لوح_جديد

    # تخصيص من اللوح الجديد
    متغير كائن_جديد: *رأس_كائن_حر = (*لوح_جديد).أول_حر
    (*لوح_جديد).أول_حر = (*كائن_جديد).التالي
    (*لوح_جديد).المستخدم = 1
    (*ذاكرة).إجمالي_مخصص = (*ذاكرة).إجمالي_مخصص + 1
    أرجع كائن_جديد كـ عنوان
نهاية

# تحرير كائن وإعادته للمجمع — أداء O(1) مضمون
دالة slab_حرر(عنوان_كائن: عنوان, الحجم: ع32)
    متغير فهرس: ع32 = طبقة_لـ_حجم(الحجم)
    إذا (فهرس >= عدد_الطبقات)
        أرجع
    نهاية

    متغير ذاكرة: *ذاكرة_مؤقتة_Slab = &ذاكرات_مؤقتة[فهرس]

    # البحث عن اللوح الذي يحتوي هذا العنوان
    متغير لوح: *رأس_لوح = (*ذاكرة).أول_لوح
    بينما (لوح != (0 كـ *رأس_لوح))
        # حساب نطاق اللوح
        متغير بداية_لوح: عنوان = لوح كـ عنوان
        متغير حجم_لوح: عنوان = (حجم_رأس_لوح + كائنات_كل_لوح × (*لوح).حجم_الكائن) كـ عنوان
        متغير نهاية_لوح: عنوان = بداية_لوح + حجم_لوح

        إذا ((عنوان_كائن >= بداية_لوح) & (عنوان_كائن < نهاية_لوح))
            # الكائن ينتمي لهذا اللوح — أضفه لقائمة الحرية
            متغير كائن: *رأس_كائن_حر = عنوان_كائن كـ *رأس_كائن_حر
            (*كائن).التالي = (*لوح).أول_حر
            (*كائن).حارس = قيمة_حارس
            (*لوح).أول_حر = كائن
            (*لوح).المستخدم = (*لوح).المستخدم - 1
            (*ذاكرة).إجمالي_محرر = (*ذاكرة).إجمالي_محرر + 1
            أرجع
        نهاية

        لوح = (*لوح).التالي
    نهاية
نهاية

# ==============================================================================
# القسم 7: نقطة الدخول ومعالج الذعر
# ==============================================================================

#[معالج_ذعر]
لن_ترجع دالة عند_الذعر(معلومات: *معلومات_ذعر)
    حلقة {}
نهاية

#[نقطة_دخول]
لن_ترجع دالة _start()
    # تخصيص سلسلة من الكائنات (مثال: هياكل عمليات النواة)
    متغير ع1: عنوان = slab_خصص(64)   # كائن حجمه 64 بايت
    متغير ع2: عنوان = slab_خصص(64)   # كائن ثانٍ من نفس الطبقة
    متغير ع3: عنوان = slab_خصص(128)  # كائن من طبقة مختلفة
    متغير ع4: عنوان = slab_خصص(8)    # كائن صغير جداً

    # تحرير وإعادة التخصيص — الأداء O(1)
    slab_حرر(ع1, 64)    # تحرير الكائن الأول
    متغير ع5: عنوان = slab_خصص(64)  # يُعيد نفس الكائن المحرر

    # تجنب تحذير المتغيرات غير المستخدمة
    متغير _ب: عنوان = ع2 + ع3 + ع4 + ع5

    حلقة {}
نهاية
