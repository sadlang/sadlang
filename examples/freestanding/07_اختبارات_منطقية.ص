    # محاكاة 8 خانات ذاكرة (مُشغَّلة/فارغة)
    متغير م0 = خطأ
    متغير م1 = خطأ
    متغير م2 = خطأ
    متغير م3 = خطأ
    متغير م4 = خطأ
    متغير م5 = خطأ
    متغير م6 = خطأ
    متغير م7 = خطأ

    # تخصيص 5 خانات
    م0 = صحيح
    م1 = صحيح
    م2 = صحيح
    م3 = صحيح
    م4 = صحيح
    اطبع_سطر("  تم تخصيص 5 خانات")

    # تحرير 0 و2
    م0 = خطأ
    م2 = خطأ
    اطبع_سطر("  تم تحرير الخانتين 0 و2")

    # إعادة التخصيص للخانات الفارغة
    م0 = صحيح
