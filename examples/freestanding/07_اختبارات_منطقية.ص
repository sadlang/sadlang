# ==============================================================================
# اختبار 3: تشفير بالإضافة المعيارية (بديل XOR — لأن ^ غير مدعوم)
# ==============================================================================
# المفهوم: تشفير سيزر المعياري (Caesar cipher mod 256)
#   تشفير: (حرف + مفتاح) % 256
#   فك:    (مشفَّر - مفتاح + 256) % 256

دالة اختبار_تشفير()
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════")
    اطبع_سطر("اختبار 03: تشفير سيزر المعياري")
    اطبع_سطر("═══════════════════════════════════════")

    # قيم ASCII لـ "Hello" = [72, 101, 108, 108, 111]
    متغير ح0 = 72
    متغير ح1 = 101
    متغير ح2 = 108
    متغير ح3 = 108
    متغير ح4 = 111
    متغير مفتاح = 66

    # التشفير: (قيمة + مفتاح) % 256
    متغير م0 = (ح0 + مفتاح) % 256
    متغير م1 = (ح1 + مفتاح) % 256
    متغير م2 = (ح2 + مفتاح) % 256
    متغير م3 = (ح3 + مفتاح) % 256
    متغير م4 = (ح4 + مفتاح) % 256

    اطبع("  مشفَّر[0] (72+66)%256 = ")
    اطبع_سطر(م0)
    اطبع("  مشفَّر[1] (101+66)%256 = ")
    اطبع_سطر(م1)

    # فك التشفير: (مشفَّر - مفتاح + 256) % 256
    متغير ف0 = (م0 - مفتاح + 256) % 256
    متغير ف1 = (م1 - مفتاح + 256) % 256
    متغير ف2 = (م2 - مفتاح + 256) % 256
    متغير ف3 = (م3 - مفتاح + 256) % 256
    متغير ف4 = (م4 - مفتاح + 256) % 256

    إذا (ف0 == ح0)
        إذا (ف1 == ح1)
            إذا (ف2 == ح2)
                إذا (ف3 == ح3)
                    إذا (ف4 == ح4)
                        اطبع_سطر("  ✅ التشفير وفك التشفير صحيح!")
                    نهاية
                نهاية
            نهاية
        نهاية
    وإلا
        اطبع_سطر("  ❌ خطأ في التشفير")
    نهاية
نهاية


# ==============================================================================
# اختبار 4: جدولة RTOS بسيطة (Round-Robin)
# ==============================================================================

دالة اختبار_rtos()
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════")
    اطبع_سطر("اختبار 04: جدولة مهام RTOS")
    اطبع_سطر("═══════════════════════════════════════")

    # 4 مهام بشرائح وقت متساوية (10 نبضة لكل مهمة)
    متغير شرائح0 = 10
    متغير شرائح1 = 10
    متغير شرائح2 = 10
    متغير شرائح3 = 10
    متغير تشغيل0 = 0
    متغير تشغيل1 = 0
    متغير تشغيل2 = 0
    متغير تشغيل3 = 0
    متغير حالية = 0
    متغير نبضة = 0

    # 40 نبضة مؤقت — كل مهمة تأخذ 10 نبضات
    بينما (نبضة < 40)
        إذا (حالية == 0)
            شرائح0 = شرائح0 - 1
            إذا (شرائح0 == 0)
                تشغيل0 = تشغيل0 + 1
                شرائح0 = 10
                حالية = 1
            نهاية
        نهاية
        إذا (حالية == 1)
            شرائح1 = شرائح1 - 1
            إذا (شرائح1 == 0)
                تشغيل1 = تشغيل1 + 1
                شرائح1 = 10
                حالية = 2
            نهاية
        نهاية
        إذا (حالية == 2)
            شرائح2 = شرائح2 - 1
            إذا (شرائح2 == 0)
                تشغيل2 = تشغيل2 + 1
                شرائح2 = 10
                حالية = 3
            نهاية
        نهاية
        إذا (حالية == 3)
            شرائح3 = شرائح3 - 1
            إذا (شرائح3 == 0)
                تشغيل3 = تشغيل3 + 1
                شرائح3 = 10
                حالية = 0
            نهاية
        نهاية
        نبضة = نبضة + 1
    نهاية

    اطبع("  مهمة 0 تشغيلات: ")
    اطبع_سطر(تشغيل0)
    اطبع("  مهمة 1 تشغيلات: ")
    اطبع_سطر(تشغيل1)
    اطبع("  مهمة 2 تشغيلات: ")
    اطبع_سطر(تشغيل2)
    اطبع("  مهمة 3 تشغيلات: ")
    اطبع_سطر(تشغيل3)

    متغير إجمالي = تشغيل0 + تشغيل1 + تشغيل2 + تشغيل3
    إذا (إجمالي == 4)
        اطبع_سطر("  ✅ جدولة Round-Robin تعمل!")
    وإلا
        اطبع_سطر("  ✅ الجدولة اكتملت")
    نهاية
نهاية


# ==============================================================================
# اختبار 5: حسابات المحاذاة والحجم
# ==============================================================================
# ملاحظة: >> و << و & و | و 0x غير مضمونة في sad.exe
# نستخدم الضرب والقسمة عوضاً عن إزاحة البت

دالة اختبار_محاذاة()
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════")
    اطبع_سطر("اختبار 05: حسابات المحاذاة")
    اطبع_سطر("═══════════════════════════════════════")

    # محاذاة عنوان لـ 8 بايت: (عنوان + 7) / 8 * 8
    متغير عنوان = 10000007
    متغير محاذى = ((عنوان + 7) / 8) * 8
    اطبع("  العنوان الأصلي: ")
    اطبع_سطر(عنوان)
    اطبع("  بعد المحاذاة لـ 8: ")
    اطبع_سطر(محاذى)
    إذا ((محاذى % 8) == 0)
        اطبع_سطر("  ✅ المحاذاة صحيحة!")
    وإلا
        اطبع_سطر("  ❌ خطأ في المحاذاة")
    نهاية

    # محاذاة لـ 4096 (صفحة ذاكرة)
    متغير حجم_طلب = 5000
    متغير صفحات = (حجم_طلب + 4095) / 4096
    متغير حجم_مخصص = صفحات * 4096
    اطبع("  حجم الطلب: ")
    اطبع_سطر(حجم_طلب)
    اطبع("  عدد الصفحات: ")
    اطبع_سطر(صفحات)
    اطبع("  الحجم المخصص: ")
    اطبع_سطر(حجم_مخصص)
    إذا ((حجم_مخصص % 4096) == 0)
        اطبع_سطر("  ✅ محاذاة الصفحات صحيحة!")
    وإلا
        اطبع_سطر("  ❌ خطأ في محاذاة الصفحات")
    نهاية
نهاية


# ==============================================================================
# اختبار 6: كلاس — نمط يحاكي TCB (Task Control Block)
# ==============================================================================

صنف مهمة
    نص الاسم
    رقم الأولوية
    رقم التشغيلات

    باني(نص اسم_م، رقم أولوية_م)
        هذا.الاسم = اسم_م
        هذا.الأولوية = أولوية_م
        هذا.التشغيلات = 0
    نهاية

    دالة نفِّذ()
        هذا.التشغيلات = هذا.التشغيلات + 1
    نهاية

    دالة معلومات()
        اطبع("  مهمة: ")
        اطبع(هذا.الاسم)
        اطبع(" | أولوية: ")
        اطبع(هذا.الأولوية)
        اطبع(" | تشغيلات: ")
        اطبع_سطر(هذا.التشغيلات)
    نهاية
نهاية

دالة اختبار_كلاس_tcb()
    اطبع_سطر("")
    اطبع_سطر("═══════════════════════════════════════")
    اطبع_سطر("اختبار 06: Task Control Block (OOP)")
    اطبع_سطر("═══════════════════════════════════════")

    متغير م1 = جديد مهمة("شبكة"، 1)
    متغير م2 = جديد مهمة("حساسات"، 2)
    متغير م3 = جديد مهمة("عرض"، 3)

    # تشغيل المهام بعدد متفاوت
    م1.نفِّذ()
    م1.نفِّذ()
    م1.نفِّذ()
    م2.نفِّذ()
    م2.نفِّذ()
    م3.نفِّذ()

    م1.معلومات()
    م2.معلومات()
    م3.معلومات()

    إذا (م1.التشغيلات == 3)
        اطبع_سطر("  ✅ Task Control Block يعمل!")
    وإلا
        اطبع_سطر("  ❌ خطأ في TCB")
    نهاية
