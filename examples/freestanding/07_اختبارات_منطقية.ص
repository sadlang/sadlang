# ==============================================================================
# المثال 07: اختبارات منطق Freestanding (بالمترجم التفاعلي)
# ==============================================================================
#
# هذا الملف يختبر خوارزميات freestanding في المترجم التفاعلي sad.exe
# باستخدام متغيرات غير مكتوبة (dynamic typing) يدعمها المترجم
#
# ملاحظة: sad.exe يدعم العمليات الأساسية فقط:
#   + - * / % == != < > <= >=
#   و (AND المنطقي)، أو (OR المنطقي)
#   لا يدعم: ^  >>  <<  &  |  (عمليات البت)
#
# لتشغيل:
#   .\build\bin\Debug\sad.exe .\examples\freestanding\07_اختبارات_منطقية.ص
# ==============================================================================


# ==============================================================================
# اختبار 1: حسابات عناوين FAT32
# ==============================================================================

دالة اختبار_FAT32()
    اطبع_سطر("═══════════════════════════════════════")
    اطبع_سطر("اختبار 01: حسابات نظام ملفات FAT32")
    اطبع_سطر("═══════════════════════════════════════")

    متغير قطاعات_محجوزة = 2
    متغير حجم_قطاع = 512
    متغير حجم_FAT = 32
    متغير عدد_FATs = 2
    متغير قطاعات_كل_كتلة = 8

    # عنوان جدول FAT
    متغير إزاحة_FAT = قطاعات_محجوزة * حجم_قطاع
    اطبع("  إزاحة جدول FAT: ")
    اطبع_سطر(إزاحة_FAT)

    # بداية منطقة البيانات — نحسب خطوة بخطوة (بدون × داخل أقواس)
    متغير حجم_FATs_كلي = حجم_FAT * عدد_FATs * حجم_قطاع
    متغير بداية_البيانات = إزاحة_FAT + حجم_FATs_كلي
    اطبع("  بداية منطقة البيانات: ")
    اطبع_سطر(بداية_البيانات)

    # حجم الكتلة
    متغير حجم_الكتلة = قطاعات_كل_كتلة * حجم_قطاع
    اطبع("  حجم الكتلة: ")
    اطبع_سطر(حجم_الكتلة)

    # عنوان الكتلة رقم 5 — (كتلة - 2) × حجم_الكتلة + بداية
    متغير رقم_كتلة = 5
    متغير رقم_معدل = رقم_كتلة - 2
    متغير إزاحة_كتلة = رقم_معدل * حجم_الكتلة
    متغير عنوان_كتلة = بداية_البيانات + إزاحة_كتلة
    اطبع("  عنوان الكتلة 5: ")
    اطبع_سطر(عنوان_كتلة)

    # التحقق: إزاحة_FAT=1024، حجم_FATs_كلي=32768، بداية=33792
    # كتلة 5: (5-2)*4096 = 12288، العنوان = 33792 + 12288 = 46080
    متغير حجم_FATs_متوقع = 32 * 2 * 512
    متغير بداية_متوقعة = 1024 + حجم_FATs_متوقع
    متغير إزاحة_متوقعة = 3 * 4096
    متغير متوقع = بداية_متوقعة + إزاحة_متوقعة
    إذا (عنوان_كتلة == متوقع)
        اطبع_سطر("  ✅ حسابات FAT32 صحيحة!")
    وإلا
        اطبع("  ❌ خطأ! المتوقع: ")
        اطبع_سطر(متوقع)
        اطبع("  الفعلي: ")
        اطبع_سطر(عنوان_كتلة)
    نهاية
نهاية


