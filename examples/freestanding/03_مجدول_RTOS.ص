# ==============================================================================
# المثال 03: مُجدِّل مهام RTOS — وضع Freestanding
# ==============================================================================
#
# نظام RTOS (Real-Time Operating System) هو نظام تشغيل للأنظمة المدمجة
# يضمن تنفيذ المهام في وقتها المحدد. هذا المثال يُطبق:
#   - هياكل بيانات حظائر المهام (Task Control Blocks)
#   - جدولة Round-Robin (التناوب المتساوي بين المهام)
#   - تبديل السياق (Context Switching) بين المهام
#   - الأعلام والإشارات للتزامن بين المهام (Semaphores)
#   - مؤقتات الأجهزة (Hardware Timers) كمصدر للإيقاع
#
# الاستخدام:
#   sadc --freestanding 03_مجدول_RTOS.ص -o rtos_kernel.elf
# ==============================================================================

#![بلا_مكتبة_قياسية]
#![بلا_رئيسية]

#تضمين <runtime_new/freestanding/sad_core.h>

# ==============================================================================
# القسم 1: ثوابت نظام RTOS
# ==============================================================================

# أقصى عدد مهام مدعوم في النظام
ثابت أقصى_مهام: ع32 = 16
# حجم مكدس كل مهمة (4 كيلوبايت)
ثابت حجم_المكدس: ع32 = 4096
# تكرار المؤقت للجدول (1 ميلي ثانية — 1000 هرتز)
ثابت تكرار_المؤقت: ع32 = 1000
# عنوان سجل التحكم في المؤقت (ARM Cortex-M SysTick)
ثابت عنوان_SysTick: عنوان = 0xE000E010
# عدد شرائح الوقت لكل مهمة (10 ميلي ثانية)
ثابت شرائح_وقت: ع32 = 10

# ==============================================================================
# القسم 2: حالات المهام
# ==============================================================================

# المهمة جاهزة للتنفيذ
ثابت حالة_جاهزة: ع8 = 0
# المهمة تُنفَّذ حالياً على المعالج
ثابت حالة_تنفيذ: ع8 = 1
# المهمة تنتظر حدثاً (إشارة، مؤقت، مصدر I/O)
ثابت حالة_انتظار: ع8 = 2
# المهمة مُعلَّقة (Suspended)
ثابت حالة_معلقة: ع8 = 3
# المهمة انتهت من تنفيذها
ثابت حالة_منتهية: ع8 = 4

# ==============================================================================
# القسم 3: هياكل البيانات
# ==============================================================================

# سياق المعالج (Processor Context) — كل ما يُحفظ عند تبديل المهام
# ترتيب الحقول يتوافق مع ترتيب دفع ARMv8 إلى المكدس
هيكل سياق_معالج {
    r0: ع64;    # سجل 0 — الوسيط الأول / القيمة المُرجعة
    r1: ع64;    # سجل 1 — الوسيط الثاني
    r2: ع64;    # سجل 2 — الوسيط الثالث
    r3: ع64;    # سجل 3 — الوسيط الرابع
    r4: ع64;    # سجل 4 — متغير محفوظ (Callee-saved)
    r5: ع64;    # سجل 5 — متغير محفوظ
    r6: ع64;    # سجل 6 — متغير محفوظ
    r7: ع64;    # سجل 7 — متغير محفوظ
    r8: ع64;    # سجل 8 — متغير محفوظ
    r9: ع64;    # سجل 9 — متغير محفوظ
    r10: ع64;   # سجل 10 — متغير محفوظ
    r11: ع64;   # سجل 11 — متغير إطار
    r12: ع64;   # سجل 12 — متغير مؤقت (Caller-saved)
    lr: ع64;    # Link Register — عنوان العودة
    pc: ع64;    # Program Counter — عنوان التعليمة التالية
    pstate: ع64; # Processor State — وضع المعالج وعلامات الحساب
}

# حظيرة التحكم في المهمة (Task Control Block — TCB)
# البنية الأساسية التي يُدير بها نظام RTOS كل مهمة
هيكل حظيرة_مهمة {
    المعرف: ع32;               # معرف فريد للمهمة (0 إلى أقصى_مهام-1)
    الاسم: [ح8; 32];           # اسم المهمة للتشخيص
    الحالة: ع8;                # حالة المهمة (جاهزة/تنفيذ/انتظار/...)
    الأولوية: ع8;              # أولوية المهمة (0=أعلى، 255=أدنى)
    شرائح_متبقية: ع32;         # شرائح الوقت المتبقية قبل التبديل
    عدد_التشغيلات: ع32;        # كم مرة نُفِّذت هذه المهمة
    دالة_المهمة: *فراغ;        # مؤشر لدالة المهمة fn() -> !
    إشارة_انتظار: ع32;         # معرف الإشارة التي تنتظرها المهمة
    مؤقت_مهمة: ع32;            # عداد تأجيل المهمة (بالميلي ثانية)
    مؤشر_مكدس: عنوان;          # مؤشر مكدس المهمة الحالي (SP)
    قاعدة_مكدس: عنوان;         # عنوان بداية مكدس المهمة
    سياق: سياق_معالج;          # سياق المعالج المحفوظ
}

# الإشارة (Semaphore) للتزامن بين المهام
هيكل إشارة {
    العداد: ع32;          # قيمة الإشارة الحالية
    الحد_الأقصى: ع32;     # القيمة القصوى المسموح بها
    المُعرِّف: ع32;        # معرف فريد للإشارة
    قائمة_الانتظار: ع32;  # قناع المهام التي تنتظر هذه الإشارة
}

# ==============================================================================
# القسم 4: حالة المُجدِّل العامة
# ==============================================================================

# جدول جميع المهام المسجلة
متغير_عام جدول_المهام: [حظيرة_مهمة; 16]
# فهرس المهمة الحالية
متغير_عام المهمة_الحالية: ع32 = 0
# عدد المهام المسجلة
متغير_عام عدد_المهام: ع32 = 0
# عداد النبضات (Tick Counter)
متغير_عام عداد_النبضات: ع32 = 0
# هل الجدولة مفعَّلة؟
متغير_عام المُجدِّل_مفعَّل: منطق = خطأ

# مساحات ذاكرة مكدسات المهام (عنوان البداية)
ثابت عنوان_مكدسات: عنوان = 0x00500000

# ==============================================================================
# القسم 5: إدارة المهام
# ==============================================================================

# تسجيل مهمة جديدة في النظام
# تُهيئ حظيرة التحكم وتُحضِّر مكدس المهمة
دالة سجِّل_مهمة(
    الاسم: *ح8,
    طول_الاسم: ع32,
    الدالة: *فراغ,
    الأولوية: ع8
) -> ع32
    إذا (عدد_المهام >= أقصى_مهام)
        أرجع 0xFFFFFFFF  # الجدول ممتلئ
    نهاية

    متغير معرف: ع32 = عدد_المهام
    متغير حظيرة: *حظيرة_مهمة = &جدول_المهام[معرف]

    # تهيئة الحظيرة
    (*حظيرة).المعرف = معرف
    (*حظيرة).الحالة = حالة_جاهزة
    (*حظيرة).الأولوية = الأولوية
    (*حظيرة).شرائح_متبقية = شرائح_وقت
    (*حظيرة).عدد_التشغيلات = 0
    (*حظيرة).دالة_المهمة = الدالة
    (*حظيرة).إشارة_انتظار = 0xFFFFFFFF
    (*حظيرة).مؤقت_مهمة = 0

    # نسخ اسم المهمة
    متغير ن: ع32 = 0
    بينما ((ن < طول_الاسم) & (ن < 31))
        متغير حرف: ح8 = *((الاسم + (ن كـ عنوان)) كـ *ح8)
        (*حظيرة).الاسم[ن] = حرف
        ن = ن + 1
    نهاية
    (*حظيرة).الاسم[ن] = 0  # محدد نهاية النص

    # إعداد مكدس المهمة
    متغير مكدس: عنوان = عنوان_مكدسات + ((معرف × حجم_المكدس) كـ عنوان)
    (*حظيرة).قاعدة_مكدس = مكدس
    # المكدس ينمو للأسفل — نبدأ من الأعلى
    (*حظيرة).مؤشر_مكدس = مكدس + (حجم_المكدس كـ عنوان)
    # PC = عنوان دالة المهمة
    (*حظيرة).سياق.pc = الدالة كـ ع64

    عدد_المهام = عدد_المهام + 1
    أرجع معرف
نهاية

# ==============================================================================
# القسم 6: خوارزمية الجدولة Round-Robin
# ==============================================================================

# اختيار المهمة التالية للتنفيذ
# Round-Robin: كل مهمة تأخذ وقتها بالتساوي بنفس الأولوية
دالة اختر_المهمة_التالية() -> ع32
    متغير ابتداء: ع32 = (المهمة_الحالية + 1) % عدد_المهام
    متغير ن: ع32 = 0

    # جولة أولى: البحث عن مهمة بنفس الأولوية أو أعلى
    بينما (ن < عدد_المهام)
        متغير فهرس: ع32 = (ابتداء + ن) % عدد_المهام
        متغير حظيرة: *حظيرة_مهمة = &جدول_المهام[فهرس]

        إذا ((*حظيرة).الحالة == حالة_جاهزة)
            أرجع فهرس
        نهاية

        ن = ن + 1
    نهاية

    # إذا لم نجد — بقى المهمة الحالية
    أرجع المهمة_الحالية
نهاية

# معالجة نبضة المؤقت (Timer Tick)
# تُستدعى 1000 مرة في الثانية من معالج المقاطعة
دالة نبضة_مؤقت()
    عداد_النبضات = عداد_النبضات + 1

    إذا (عدد_المهام == 0)
        أرجع
    نهاية

    # تحديث مؤقتات التأجيل
    متغير ن: ع32 = 0
    بينما (ن < عدد_المهام)
        متغير حظيرة: *حظيرة_مهمة = &جدول_المهام[ن]
        إذا ((*حظيرة).مؤقت_مهمة > 0)
            (*حظيرة).مؤقت_مهمة = (*حظيرة).مؤقت_مهمة - 1
            إذا ((*حظيرة).مؤقت_مهمة == 0)
                # انتهى تأجيل المهمة — أعِدها للجدول
                (*حظيرة).الحالة = حالة_جاهزة
            نهاية
        نهاية
        ن = ن + 1
    نهاية

    # التحقق من شرائح الوقت للمهمة الحالية
    متغير حالية: *حظيرة_مهمة = &جدول_المهام[المهمة_الحالية]
    إذا ((*حالية).شرائح_متبقية > 0)
        (*حالية).شرائح_متبقية = (*حالية).شرائح_متبقية - 1
    نهاية

    # طلب تبديل السياق إذا نفدت الشرائح
    إذا ((*حالية).شرائح_متبقية == 0)
        (*حالية).شرائح_متبقية = شرائح_وقت
        (*حالية).الحالة = حالة_جاهزة
        المهمة_الحالية = اختر_المهمة_التالية()
        متغير جديدة: *حظيرة_مهمة = &جدول_المهام[المهمة_الحالية]
        (*جديدة).الحالة = حالة_تنفيذ
        (*جديدة).عدد_التشغيلات = (*جديدة).عدد_التشغيلات + 1
    نهاية
نهاية

# ==============================================================================
# القسم 7: الإشارات (Semaphores)
# ==============================================================================

# الإنتظار على إشارة (P operation — يُخفِّض العداد)
# إذا كانت الإشارة صفر: تُعلَّق المهمة حتى تُطلَق الإشارة
دالة انتظر_إشارة(إشارة: *إشارة) -> منطق
    إذا ((*إشارة).العداد > 0)
        (*إشارة).العداد = (*إشارة).العداد - 1
        أرجع صحيح  # حصلنا على الإشارة
    نهاية

    # الإشارة محجوزة — علِّق المهمة الحالية
    متغير حظيرة: *حظيرة_مهمة = &جدول_المهام[المهمة_الحالية]
    (*حظيرة).الحالة = حالة_انتظار
    (*حظيرة).إشارة_انتظار = (*إشارة).المُعرِّف
    أرجع خطأ
نهاية

# إطلاق إشارة (V operation — يُرفع العداد)
# إذا كانت هناك مهمة تنتظر: تُستيقظ الآن
دالة أطلق_إشارة(إشارة: *إشارة)
    # إيقاظ مهمة منتظرة
    متغير ن: ع32 = 0
    بينما (ن < عدد_المهام)
        متغير حظيرة: *حظيرة_مهمة = &جدول_المهام[ن]
        إذا (((*حظيرة).الحالة == حالة_انتظار) & ((*حظيرة).إشارة_انتظار == (*إشارة).المُعرِّف))
            (*حظيرة).الحالة = حالة_جاهزة
            (*حظيرة).إشارة_انتظار = 0xFFFFFFFF
            أرجع  # أيقظنا مهمة واحدة فقط
        نهاية
        ن = ن + 1
    نهاية

    # لا مهام تنتظر — ارفع العداد
    إذا ((*إشارة).العداد < (*إشارة).الحد_الأقصى)
        (*إشارة).العداد = (*إشارة).العداد + 1
    نهاية
نهاية

# ==============================================================================
# القسم 8: تشغيل المُجدِّل
# ==============================================================================

# تهيئة المُجدِّل وإعداد مؤقت النظام
دالة هيئ_المجدل()
    عدد_المهام = 0
    المهمة_الحالية = 0
    عداد_النبضات = 0
    المُجدِّل_مفعَّل = صحيح
نهاية

# تأجيل مهمة لعدد من الميلي ثواني
دالة أجِّل_مهمة(مللي_ثانية: ع32)
    متغير حظيرة: *حظيرة_مهمة = &جدول_المهام[المهمة_الحالية]
    (*حظيرة).الحالة = حالة_انتظار
    (*حظيرة).مؤقت_مهمة = مللي_ثانية
نهاية

# ==============================================================================
# القسم 9: نقطة الدخول ومعالج الذعر
# ==============================================================================

#[معالج_ذعر]
لن_ترجع دالة عند_الذعر(معلومات: *معلومات_ذعر)
    # في نظام RTOS: نسجل الخطأ ونعيد تشغيل أهم مهمة
    حلقة {}
نهاية

#[نقطة_دخول]
لن_ترجع دالة _start()
    # تهيئة المُجدِّل
    هيئ_المجدل()

    # مثال: تسجيل 3 مهام متوازية
    # في النظام الحقيقي: الدوال تكون defined مسبقاً
    متغير شبكة_placeholder: *فراغ = 0x1000 كـ *فراغ
    متغير حساسات_placeholder: *فراغ = 0x2000 كـ *فراغ
    متغير عرض_placeholder: *فراغ = 0x3000 كـ *فراغ

    متغير اسم1: [ح8; 8] = ['s', 'h', 'a', 'b', 'k', 'a', ' ', 0]
    متغير _م1: ع32 = سجِّل_مهمة(اسم1 كـ *ح8, 6, شبكة_placeholder, 1)
    متغير اسم2: [ح8; 9] = ['h', 'a', 's', 's', 'a', 's', 'a', 't', 0]
    متغير _م2: ع32 = سجِّل_مهمة(اسم2 كـ *ح8, 8, حساسات_placeholder, 2)
    متغير اسم3: [ح8; 5] = ['a', 'r', 'd', 'h', 0]
    متغير _م3: ع32 = سجِّل_مهمة(اسم3 كـ *ح8, 4, عرض_placeholder, 3)

    # بدء الجدولة — هنا يبدأ RTOS
    متغير أولى: *حظيرة_مهمة = &جدول_المهام[0]
    (*أولى).الحالة = حالة_تنفيذ
    (*أولى).عدد_التشغيلات = 1

    حلقة {}
نهاية
