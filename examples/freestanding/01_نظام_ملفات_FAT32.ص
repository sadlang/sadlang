# ==============================================================================
# المثال 01: نظام ملفات FAT32 — وضع Freestanding
# ==============================================================================
#
# هذا المثال يُظهر كيفية تطبيق نظام ملفات FAT32 على الحديد مباشرة
# بدون أي مكتبة قياسية. يتضمن:
#   - تحليل قطاع الإقلاع (Boot Sector)
#   - قراءة جدول تخصيص الملفات (FAT)
#   - تصفح مدخلات الدليل الجذري (Root Directory)
#   - قراءة بيانات الملفات عبر سلاسل الكتل (Cluster Chains)
#
# لتشغيل مع المترجم:
#   sadc --freestanding 01_نظام_ملفات_FAT32.ص -o fat32_kernel.elf
# ==============================================================================

#![بلا_مكتبة_قياسية]
#![بلا_رئيسية]

#تضمين <runtime_new/freestanding/sad_core.h>

# ==============================================================================
# القسم 1: ثوابت FAT32 الأساسية
# ==============================================================================

# عنوان ذاكرة محاكي القرص (RAMDISK)
ثابت عنوان_القرص: عنوان = 0x00100000
# حجم القطاع بالبايت (512 — المعيار الدولي)
ثابت حجم_القطاع: ع32 = 512
# علامة نهاية سلسلة الكتل في جدول FAT
ثابت كتلة_نهاية: ع32 = 0x0FFFFFFF
# علامة الكتلة التالفة
ثابت كتلة_تالفة: ع32 = 0x0FFFFFF7
# سمة الدليل الفرعي
ثابت سمة_دليل: ع8 = 0x10
# سمة الملف العادي
ثابت سمة_ملف: ع8 = 0x20

# ==============================================================================
# القسم 2: هياكل البيانات
# ==============================================================================

# قطاع الإقلاع FAT32 (512 بايت حسب معيار مايكروسوفت)
هيكل قطاع_الإقلاع {
    رمز_القفز: [ع8; 3];        # رمز الانتقال إلى كود الإقلاع
    اسم_المصنع: [ح8; 8];       # معرف الشركة المصنعة
    حجم_القطاع: ع16;            # حجم القطاع بالبايت (512)
    قطاعات_كل_كتلة: ع8;        # عدد القطاعات في الكتلة الواحدة
    قطاعات_محجوزة: ع16;         # القطاعات قبل جدول FAT الأول
    عدد_جداول_FAT: ع8;          # عدد جداول FAT (عادةً 2)
    مدخلات_الجذر: ع16;          # مدخلات دليل الجذر (0 لـ FAT32)
    قطاعات_إجمالية_قديم: ع16;   # إجمالي القطاعات (قيمة قديمة)
    نوع_الوسيط: ع8;             # نوع الوسيط (0xF8 للقرص الصلب)
    حجم_FAT_قديم: ع16;          # حجم FAT قديم (0 لـ FAT32)
    قطاعات_كل_مسار: ع16;        # قطاعات في كل مسار مغناطيسي
    عدد_الرؤوس: ع16;            # عدد الرؤوس المغناطيسية
    قطاعات_مخفية: ع32;          # قطاعات مخفية قبل القسم
    قطاعات_إجمالية: ع32;        # إجمالي القطاعات (32-بت لـ FAT32)
    حجم_FAT32: ع32;             # حجم جدول FAT بالقطاعات
    أعلام_FAT: ع16;             # أعلام التمديد
    الإصدار: ع16;               # إصدار نظام الملفات
    كتلة_الجذر: ع32;            # رقم كتلة دليل الجذر
    قطاع_FSInfo: ع16;           # قطاع معلومات نظام الملفات
    قطاع_النسخة_الاحتياطية: ع16; # قطاع النسخة الاحتياطية
    محجوز: [ع8; 12];            # محجوز
    رقم_المحرك: ع8;             # رقم محرك الأقراص
    محجوز_نظام: ع8;             # محجوز للنظام
    توقيع: ع8;                  # توقيع التمديد (0x29)
    رقم_المجلد: ع32;            # الرقم التسلسلي للمجلد
    تسمية_المجلد: [ح8; 11];     # تسمية المجلد (11 حرف)
    نوع_نظام_الملفات: [ح8; 8];  # نوع نظام الملفات ("FAT32   ")
}

# مدخلة الدليل FAT32 (32 بايت حسب المعيار)
هيكل مدخلة_دليل {
    الاسم: [ح8; 8];         # اسم الملف (8 أحرف)
    الامتداد: [ح8; 3];      # امتداد الملف (3 أحرف)
    السمات: ع8;             # السمات (ملف/دليل/نظام/...)
    محجوز_NT: ع8;           # محجوز لـ Windows NT
    وقت_إنشاء_أجزاء: ع8;   # أجزاء من الثانية لوقت الإنشاء
    وقت_الإنشاء: ع16;       # وقت الإنشاء
    تاريخ_الإنشاء: ع16;     # تاريخ الإنشاء
    تاريخ_الوصول: ع16;      # تاريخ آخر وصول
    كتلة_عليا: ع16;         # النصف الأعلى من رقم الكتلة الأولى
    وقت_التعديل: ع16;       # وقت آخر تعديل
    تاريخ_التعديل: ع16;     # تاريخ آخر تعديل
    كتلة_سفلى: ع16;         # النصف الأسفل من رقم الكتلة الأولى
    الحجم: ع32;             # حجم الملف بالبايت
}

# ==============================================================================
# القسم 3: متغيرات الحالة العامة
# ==============================================================================

# عنوان جدول FAT في الذاكرة
متغير_عام عنوان_جدول_FAT: عنوان = 0
# عنوان بداية منطقة البيانات
متغير_عام عنوان_بداية_البيانات: عنوان = 0
# حجم الكتلة بالبايت
متغير_عام حجم_الكتلة: ع32 = 0
# هل تمت التهيئة بنجاح؟
متغير_عام تم_التهيئة: منطق = خطأ

# ==============================================================================
# القسم 4: دوال نظام الملفات
# ==============================================================================

# تحويل رقم الكتلة إلى عنوان ذاكرة
# الكتل 0 و1 محجوزتان — البيانات تبدأ من الكتلة 2
دالة كتلة_إلى_عنوان(رقم: ع32) -> عنوان
    متغير إزاحة: ع32 = (رقم - 2) × حجم_الكتلة
    أرجع عنوان_بداية_البيانات + (إزاحة كـ عنوان)
نهاية

# قراءة رقم الكتلة التالية من جدول FAT
# كل مدخلة في FAT32 تأخذ 4 بايت
دالة الكتلة_التالية(رقم: ع32) -> ع32
    متغير إزاحة: عنوان = (رقم كـ عنوان) × 4
    متغير مؤشر_FAT: *ع32 = (عنوان_جدول_FAT + إزاحة) كـ *ع32
    أرجع *مؤشر_FAT & 0x0FFFFFFF
نهاية

# تهيئة نظام FAT32 من قطاع الإقلاع
دالة هيئ_FAT32() -> منطق
    متغير قطاع: *قطاع_الإقلاع = عنوان_القرص كـ *قطاع_الإقلاع

    # التحقق من صحة حجم القطاع
    متغير حجم: ع32 = (*قطاع).حجم_القطاع كـ ع32
    إذا (حجم != 512)
        أرجع خطأ
    نهاية

    # حساب عنوان جدول FAT الأول
    متغير محجوز: ع32 = (*قطاع).قطاعات_محجوزة كـ ع32
    عنوان_جدول_FAT = عنوان_القرص + ((محجوز × 512) كـ عنوان)

    # حساب عنوان بداية البيانات
    متغير حجم_fat: ع32 = (*قطاع).حجم_FAT32
    متغير عدد_fat: ع32 = (*قطاع).عدد_جداول_FAT كـ ع32
    عنوان_بداية_البيانات = عنوان_جدول_FAT + ((حجم_fat × عدد_fat × 512) كـ عنوان)

    # حساب حجم الكتلة
    متغير قطاعات_ك: ع32 = (*قطاع).قطاعات_كل_كتلة كـ ع32
    حجم_الكتلة = قطاعات_ك × 512

    تم_التهيئة = صحيح
    أرجع صحيح
نهاية

# قراءة ملف كامل إلى مخزن في الذاكرة
# يُرجع عدد البايتات المقروءة فعلياً
دالة اقرأ_ملف(كتلة_أولى: ع32, مخزن: *ع8, حجم_مخزن: ع32) -> ع32
    متغير مقروء: ع32 = 0
    متغير كتلة: ع32 = كتلة_أولى

    # المشي عبر سلسلة الكتل حتى نهاية الملف
    بينما (كتلة < كتلة_نهاية)
        متغير عنوان_ك: عنوان = كتلة_إلى_عنوان(كتلة)

        # لا نتجاوز حجم المخزن
        متغير حجم_ن: ع32 = حجم_الكتلة
        إذا ((مقروء + حجم_ن) > حجم_مخزن)
            حجم_ن = حجم_مخزن - مقروء
        نهاية

        # نسخ محتوى الكتلة
        متغير وجهة: عنوان = (مخزن كـ عنوان) + (مقروء كـ عنوان)
        sad_memcpy(وجهة كـ *فراغ, عنوان_ك كـ *فراغ, حجم_ن)
        مقروء = مقروء + حجم_ن

        إذا (مقروء >= حجم_مخزن)
            أرجع مقروء
        نهاية

        كتلة = الكتلة_التالية(كتلة)
    نهاية

    أرجع مقروء
نهاية

# ==============================================================================
# القسم 5: نقطة الدخول ومعالج الذعر
# ==============================================================================

#[معالج_ذعر]
لن_ترجع دالة عند_الذعر(معلومات: *معلومات_ذعر)
    حلقة {}
نهاية

#[نقطة_دخول]
لن_ترجع دالة _start()
    # تهيئة نظام الملفات
    متغير ناجح: منطق = هيئ_FAT32()

    إذا (ناجح)
        # نظام الملفات جاهز — هنا تبدأ قراءة الكيرنل أو الإعدادات
        # مثال: قراءة ملف البيانات من كتلة 2 إلى عنوان 0x00200000
        متغير مخزن: ع32 = اقرأ_ملف(2, 0x00200000 كـ *ع8, 65536)
        متغير _ب: ع32 = مخزن
    نهاية

    حلقة {}
نهاية
