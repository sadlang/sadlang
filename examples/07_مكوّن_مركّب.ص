# ══════════════════════════════════════════════════════════════════════
# مثال ٠٧ — تأليفُ المكوّناتِ المركّبةِ بلغةِ ص من الأوّليّاتِ وحدَها
# ══════════════════════════════════════════════════════════════════════
# القاعدةُ الحاكمة: كتالوجُ عُقَدِ الواجهةِ مغلقٌ للتوسّع، فكلُّ مركّبٍ —
# بطاقةٌ أو شريطُ أدواتٍ أو حوارٌ — يُؤلَّفُ هنا من عمود/صف/رصة/نص_عنصر/زر
# وسلسلةِ المعدّلات. النمطُ: **دالّةٌ تُرجِعُ عنصرًا**، تُستدعى فتُركَّب.
#
# ولأنّ أبناءَ الحاويةِ يقبلون مصفوفةً فتُنشَرُ ترتيبًا، يمكنُ بناءُ شريطٍ
# ديناميِّ الطولِ من مصفوفةٍ تُبنى وقتَ التشغيل.
#
# ملاحظةٌ تُوفّرُ على القارئِ ساعة: اسمُ حدثِ النقرِ القانونيُّ **عند_النقر**.
# أسماءُ `عند_*` غيرُ القانونيّةِ تُقبَلُ اليومَ صامتةً ولا تُطلَقُ أبدًا.
# ══════════════════════════════════════════════════════════════════════

استورد رسومات

# ─── ثوابتُ العرضِ: لا قيمةَ حرفيّةً في منطقِ التأليفِ أدناه ───
ثابت لون_سطح_البطاقة = "#FFFFFF"
ثابت لون_عنوان_البطاقة = "#212121"
ثابت لون_متن_البطاقة = "#616161"
ثابت لون_سطح_الشريط = "#1E88E5"
ثابت لون_نص_الشريط = "#FFFFFF"

ثابت حجم_عنوان_البطاقة = 22
ثابت حجم_متن_البطاقة = 16
ثابت حجم_عنوان_الشريط = 20
ثابت حشوة_البطاقة = 16
ثابت حشوة_الشريط = 12
ثابت تباعد_البطاقة = 8
ثابت تباعد_الشريط = 12
ثابت زوايا_البطاقة = 12

# ══════════════════════════════════════════════════════════════════════
# بطاقة_محتوى(عنوان، متن) ⇐ عنصر
#   عمودٌ بسطحٍ فاتحٍ وزوايا مدوَّرة: عنوانٌ بارزٌ فوقَ متنٍ خافت.
# ══════════════════════════════════════════════════════════════════════
دالة بطاقة_محتوى(نص عنوان_البطاقة، نص متن_البطاقة)
    ارجع عمود(
        نص_عنصر(عنوان_البطاقة)
            .لون(لون_عنوان_البطاقة)
            .حجم_خط(حجم_عنوان_البطاقة)،

        نص_عنصر(متن_البطاقة)
            .لون(لون_متن_البطاقة)
            .حجم_خط(حجم_متن_البطاقة)
    )
        .لون_خلفية(لون_سطح_البطاقة)
        .زوايا(زوايا_البطاقة)
        .حشوة(حشوة_البطاقة)
        .تباعد(تباعد_البطاقة)
نهاية

# ══════════════════════════════════════════════════════════════════════
# شريط_أدوات(عنوان، أزرار) ⇐ عنصر
#   صفٌّ: عنوانٌ ثمّ **مصفوفةُ** أزرارٍ تُنشَرُ أبناءً بترتيبِها — فطولُها حرٌّ
#   ويُبنى وقتَ التشغيل.
# ══════════════════════════════════════════════════════════════════════
دالة شريط_أدوات(نص عنوان_الشريط، مصفوفة أزرار_الشريط)
    ارجع صف(
        نص_عنصر(عنوان_الشريط)
            .لون(لون_نص_الشريط)
            .حجم_خط(حجم_عنوان_الشريط)،

        أزرار_الشريط
    )
        .لون_خلفية(لون_سطح_الشريط)
        .حشوة(حشوة_الشريط)
        .تباعد(تباعد_الشريط)
نهاية

# ══════════════════════════════════════════════════════════════════════
# التركيبُ النهائيّ
# ══════════════════════════════════════════════════════════════════════
ثابت عنوان_التطبيق = "دفترُ الملاحظات"
ثابت عنوان_الملاحظة = "ملاحظةٌ أولى"
ثابت متن_الملاحظة = "تُؤلَّفُ هذه البطاقةُ بلغةِ ص من عمودٍ ونصَّين — بلا عقدةٍ جديدةٍ في المحرّك."
ثابت نص_زر_جديد = "جديد"
ثابت نص_زر_حفظ = "حفظ"

دالة أنشئ_ملاحظة()
    اطبع_سطر("طلبُ إنشاءِ ملاحظة")
نهاية

دالة احفظ_ملاحظة()
    اطبع_سطر("طلبُ حفظِ الملاحظة")
نهاية

متغير أزرار_شريط_الأدوات = [
    زر(نص_زر_جديد).عند_النقر(أنشئ_ملاحظة)،
    زر(نص_زر_حفظ).عند_النقر(احفظ_ملاحظة)
]

متغير شاشة_التطبيق = عمود(
    شريط_أدوات(عنوان_التطبيق، أزرار_شريط_الأدوات)،
    بطاقة_محتوى(عنوان_الملاحظة، متن_الملاحظة)
)

طباعة_شجرة(شاشة_التطبيق)
