# الدرس 6: الدوال
# Tutorial 6: Functions
# المستوى: متوسط
# ═══════════════════════════════════════════════════════════════════
# في هذا الدرس ستتعلم:
#   - تعريف واستدعاء الدوال
#   - الوسائط والقيم المرجعة
#   - المتغيرات المحلية والنطاقات
#   - التكرار (الاستدعاء الذاتي)
# ═══════════════════════════════════════════════════════════════════

# ── دالة بسيطة ──
اطبع_سطر("── دالة بسيطة ──")

دالة تحية(الاسم)
    اطبع_سطر("مرحباً يا " + الاسم + "! 👋")
نهاية

تحية("أحمد")
تحية("سارة")

# ── دالة ترجع قيمة ──
اطبع_سطر("── دالة ترجع قيمة ──")

دالة مربع(س)
    ارجع س * س
نهاية

اطبع_سطر("مربع 5 = " + لنص(مربع(5)))
اطبع_سطر("مربع 12 = " + لنص(مربع(12)))

# ── دالة بعدة وسائط ──
اطبع_سطر("── دالة بعدة وسائط ──")

دالة مساحة_مستطيل(الطول، العرض)
    ارجع الطول * العرض
نهاية

اطبع_سطر("مساحة 5×3 = " + لنص(مساحة_مستطيل(5، 3)))
اطبع_سطر("مساحة 10×7 = " + لنص(مساحة_مستطيل(10، 7)))

# ── دالة مع شرط ──
اطبع_سطر("── دالة مع شرط ──")

دالة القيمة_المطلقة(س)
    إذا (س < 0)
        ارجع -س
    نهاية
    ارجع س
نهاية

اطبع_سطر("|−7| = " + لنص(القيمة_المطلقة(-7)))
اطبع_سطر("|5| = " + لنص(القيمة_المطلقة(5)))

# ── دالة تستدعي دالة أخرى ──
اطبع_سطر("── تركيب الدوال ──")

دالة محيط_دائرة(نصف_القطر)
    ارجع 2 * 3.14159 * نصف_القطر
نهاية

دالة مساحة_دائرة(نصف_القطر)
    ارجع 3.14159 * مربع(نصف_القطر)
نهاية

متغير نق = 5
اطبع_سطر("دائرة بنصف قطر " + لنص(نق))
اطبع_سطر("  المحيط = " + لنص(محيط_دائرة(نق)))
اطبع_سطر("  المساحة = " + لنص(مساحة_دائرة(نق)))

# ── التكرار (العد التنازلي) ──
اطبع_سطر("── التكرار ──")

دالة عد_تنازلي(ن)
    إذا (ن <= 0)
        اطبع_سطر("🚀 انطلق!")
        ارجع 0
    نهاية
    اطبع_سطر(لنص(ن) + "...")
    ارجع عد_تنازلي(ن - 1)
نهاية

عد_تنازلي(3)

# ═══════════════════════════════════════════════════════════════════
# 📌 ملخص:
#   - دالة اسم(وسائط) ... نهاية → تعريف دالة
#   - ارجع قيمة → إرجاع قيمة من الدالة
#   - الدوال يمكن أن تستدعي دوال أخرى أو نفسها (تكرار)
# ═══════════════════════════════════════════════════════════════════
