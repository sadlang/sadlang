# الدرس 1: مرحباً بالعالم
# Tutorial 1: Hello World
# المستوى: مبتدئ
# ═══════════════════════════════════════════════════════════════════
# في هذا الدرس ستتعلم:
#   - كيفية طباعة نص على الشاشة
#   - استخدام دالة اطبع و اطبع_سطر
#   - كتابة أول برنامج بلغة ص
# ═══════════════════════════════════════════════════════════════════

# أبسط برنامج: طباعة رسالة
اطبع_سطر("مرحباً بالعالم! 🌍")

# يمكنك طباعة عدة أسطر
اطبع_سطر("أهلاً بك في لغة ص")
اطبع_سطر("لغة برمجة عربية حديثة")

# دالة اطبع لا تضيف سطر جديد في النهاية
اطبع("اسمي ")
اطبع_سطر("لغة ص")

# طباعة أرقام
اطبع_سطر(42)
اطبع_سطر(3.14)

# طباعة نتائج عمليات حسابية
اطبع_سطر("2 + 3 = " + لنص(2 + 3))

# ═══════════════════════════════════════════════════════════════════
# 📌 ملخص:
#   - اطبع_سطر("نص") → طباعة مع سطر جديد
#   - اطبع("نص") → طباعة بدون سطر جديد
#   - لنص(قيمة) → تحويل قيمة إلى نص
#   - + → دمج النصوص
# ═══════════════════════════════════════════════════════════════════
