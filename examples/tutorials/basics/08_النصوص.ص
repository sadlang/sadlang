# الدرس 8: النصوص ومعالجتها
# Tutorial 8: Strings
# المستوى: متوسط
# ═══════════════════════════════════════════════════════════════════
# في هذا الدرس ستتعلم:
#   - دمج النصوص ومقارنتها
#   - تحويل الأحرف (كبيرة/صغيرة)
#   - تقسيم ودمج النصوص
#   - البحث والاستبدال
# ═══════════════════════════════════════════════════════════════════

# ── دمج النصوص ──
اطبع_سطر("── دمج النصوص ──")
متغير الأول = "مرحباً"
متغير الثاني = "بالعالم"
متغير جملة = الأول + " " + الثاني + "!"
اطبع_سطر(جملة)

# ── طول النص ──
اطبع_سطر("── طول النص ──")
متغير نص = "لغة ص البرمجية"
اطبع_سطر("النص: " + نص)
اطبع_سطر("الطول: " + لنص(الطول(نص)))

# ── تحويل الأحرف ──
اطبع_سطر("── تحويل الأحرف ──")
متغير نص_إنج = "Hello World"
اطبع_سطر("الأصل: " + نص_إنج)
اطبع_سطر("كبيرة: " + أحرف_كبيرة(نص_إنج))
اطبع_سطر("صغيرة: " + أحرف_صغيرة(نص_إنج))

# ── تقسيم النص ──
اطبع_سطر("── تقسيم النص ──")
متغير فواكه_نص = "تفاح-موز-برتقال-عنب"
متغير فواكه = قسم(فواكه_نص، "-")
اطبع_سطر("النص الأصلي: " + فواكه_نص)
اطبع_سطر("بعد التقسيم: " + لنص(فواكه))
اطبع_سطر("عدد الفواكه: " + لنص(الطول(فواكه)))

# ── دمج مصفوفة إلى نص ──
اطبع_سطر("── دمج إلى نص ──")
متغير مدموج = دمج(فواكه، "، ")
اطبع_سطر("مدموج: " + مدموج)

# ── المقارنة ──
اطبع_سطر("── مقارنة النصوص ──")
اطبع_سطر("\"أحمد\" == \"أحمد\": " + لنص("أحمد" == "أحمد"))
اطبع_سطر("\"أحمد\" == \"سارة\": " + لنص("أحمد" == "سارة"))

# ── تحويل الأنواع ──
اطبع_سطر("── تحويل الأنواع ──")
متغير سعر = 99
متغير رسالة = "السعر: " + لنص(سعر) + " ريال"
اطبع_سطر(رسالة)

متغير رقم_نصي = "2024"
اطبع_سطر("السنة + 1 = " + لنص(لرقم(رقم_نصي) + 1))

# ═══════════════════════════════════════════════════════════════════
# 📌 ملخص:
#   - + → دمج النصوص
#   - الطول(نص) → طول النص
#   - أحرف_كبيرة(نص) / أحرف_صغيرة(نص) → تحويل
#   - قسم(نص، فاصل) → تقسيم نص إلى مصفوفة
#   - دمج(مصفوفة، فاصل) → دمج مصفوفة إلى نص
#   - لنص(قيمة) / لرقم(نص) → تحويل الأنواع
# ═══════════════════════════════════════════════════════════════════
