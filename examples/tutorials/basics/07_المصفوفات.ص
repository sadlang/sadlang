# الدرس 7: المصفوفات
# Tutorial 7: Arrays
# المستوى: متوسط
# ═══════════════════════════════════════════════════════════════════
# في هذا الدرس ستتعلم:
#   - إنشاء المصفوفات والتعامل معها
#   - إضافة وإزالة العناصر
#   - البحث والفرز
#   - دوال المصفوفات المدمجة
# ═══════════════════════════════════════════════════════════════════

# ── إنشاء مصفوفة ──
اطبع_سطر("── إنشاء مصفوفة ──")
متغير ألوان = ["أحمر"، "أخضر"، "أزرق"]
اطبع_سطر("الألوان: " + لنص(ألوان))
اطبع_سطر("عدد الألوان: " + لنص(الطول(ألوان)))

# ── الوصول للعناصر ──
اطبع_سطر("── الوصول للعناصر ──")
اطبع_سطر("اللون الأول: " + ألوان[0])
اطبع_سطر("اللون الثاني: " + ألوان[1])
اطبع_سطر("اللون الثالث: " + ألوان[2])

# ── إضافة عناصر ──
اطبع_سطر("── إضافة عناصر ──")
أضف(ألوان، "أصفر")
أضف(ألوان، "بنفسجي")
اطبع_سطر("بعد الإضافة: " + لنص(ألوان))

# ── تعديل عنصر ──
ألوان[0] = "وردي"
اطبع_سطر("بعد التعديل: " + لنص(ألوان))

# ── التكرار على مصفوفة ──
اطبع_سطر("── التكرار ──")
لكل لون في ألوان
    اطبع_سطر("  🎨 " + لون)
نهاية

# ── مصفوفة أرقام ──
اطبع_سطر("── عمليات على الأرقام ──")
متغير درجات = [95، 80، 72، 88، 65، 91]
اطبع_سطر("الدرجات: " + لنص(درجات))
اطبع_سطر("المجموع: " + لنص(مجموع(درجات)))

# حساب المتوسط يدوياً
متغير المجموع = مجموع(درجات)
متغير المتوسط = المجموع / الطول(درجات)
اطبع_سطر("المتوسط: " + لنص(المتوسط))

# ── مصفوفة فارغة وبناؤها ──
اطبع_سطر("── بناء مصفوفة ──")
متغير مربعات = []
متغير ع = 1
بينما (ع <= 5)
    أضف(مربعات، ع * ع)
    ع = ع + 1
نهاية
اطبع_سطر("المربعات: " + لنص(مربعات))

# ═══════════════════════════════════════════════════════════════════
# 📌 ملخص:
#   - [عنصر1، عنصر2] → إنشاء مصفوفة
#   - م[فهرس] → الوصول لعنصر (الفهرس يبدأ من 0)
#   - أضف(م، قيمة) → إضافة عنصر (تعديل مباشر)
#   - الطول(م) → عدد العناصر
#   - مجموع(م) → مجموع الأرقام
#   - لكل عنصر في م → التكرار على العناصر
# ═══════════════════════════════════════════════════════════════════
