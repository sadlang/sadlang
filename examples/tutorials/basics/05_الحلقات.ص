# الدرس 5: الحلقات التكرارية
# Tutorial 5: Loops
# المستوى: مبتدئ
# ═══════════════════════════════════════════════════════════════════
# في هذا الدرس ستتعلم:
#   - حلقة بينما (while)
#   - حلقة لكل (for each)
#   - أنماط التكرار الشائعة
# ═══════════════════════════════════════════════════════════════════

# ── حلقة بينما ──
اطبع_سطر("── العد من 1 إلى 5 ──")
متغير عداد = 1
بينما (عداد <= 5)
    اطبع_سطر("العدد: " + لنص(عداد))
    عداد = عداد + 1
نهاية

# ── حلقة لكل ──
اطبع_سطر("── حلقة لكل ──")
متغير فواكه = ["تفاح"، "موز"، "برتقال"، "عنب"]
لكل فاكهة في فواكه
    اطبع_سطر("🍎 " + فاكهة)
نهاية

# ── التكرار على الأرقام ──
اطبع_سطر("── جدول الضرب 3 ──")
متغير ي = 1
بينما (ي <= 10)
    اطبع_سطر("3 × " + لنص(ي) + " = " + لنص(3 * ي))
    ي = ي + 1
نهاية

# ── مجموع الأعداد ──
اطبع_سطر("── مجموع الأعداد من 1 إلى 100 ──")
متغير المجموع = 0
متغير ن = 1
بينما (ن <= 100)
    المجموع = المجموع + ن
    ن = ن + 1
نهاية
اطبع_سطر("المجموع = " + لنص(المجموع))

# ── إيجاد أكبر عدد ──
اطبع_سطر("── إيجاد أكبر عدد ──")
متغير أعداد = [34، 67، 12، 89، 45، 23، 78]
متغير الأكبر = أعداد[0]
متغير م = 1
بينما (م < الطول(أعداد))
    إذا (أعداد[م] > الأكبر)
        الأكبر = أعداد[م]
    نهاية
    م = م + 1
نهاية
اطبع_سطر("أكبر عدد: " + لنص(الأكبر))

# ── العد التنازلي ──
اطبع_سطر("── العد التنازلي ──")
متغير ت = 5
بينما (ت >= 1)
    اطبع_سطر(لنص(ت) + "...")
    ت = ت - 1
نهاية
اطبع_سطر("🚀 انطلاق!")

# ═══════════════════════════════════════════════════════════════════
# 📌 ملخص:
#   - بينما (شرط) ... نهاية → تكرار طالما الشرط صحيح
#   - لكل عنصر في مجموعة ... نهاية → تكرار على كل عنصر
#   - لا تنسَ تحديث العداد في بينما لتجنب حلقة لا نهائية
# ═══════════════════════════════════════════════════════════════════
