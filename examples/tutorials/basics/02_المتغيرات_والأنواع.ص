# الدرس 2: المتغيرات والأنواع
# Tutorial 2: Variables and Types
# المستوى: مبتدئ
# ═══════════════════════════════════════════════════════════════════
# في هذا الدرس ستتعلم:
#   - تعريف المتغيرات بكلمة متغير
#   - تعريف الثوابت بكلمة ثابت
#   - الأنواع الأساسية: أرقام، نصوص، منطقي
#   - معرفة نوع القيمة
# ═══════════════════════════════════════════════════════════════════

# ── تعريف المتغيرات ──
متغير الاسم = "أحمد"
متغير العمر = 25
متغير الطول = 1.75
متغير طالب = صحيح

اطبع_سطر("الاسم: " + الاسم)
اطبع_سطر("العمر: " + لنص(العمر))
اطبع_سطر("الطول: " + لنص(الطول))
اطبع_سطر("طالب: " + لنص(طالب))

# ── تغيير قيم المتغيرات ──
العمر = 26
اطبع_سطر("العمر بعد التحديث: " + لنص(العمر))

# ── الثوابت لا تتغير ──
ثابت باي = 3.14159
اطبع_سطر("قيمة باي: " + لنص(باي))

# ── معرفة نوع القيمة ──
اطبع_سطر("نوع الاسم: " + نوع_القيمة(الاسم))
اطبع_سطر("نوع العمر: " + نوع_القيمة(العمر))
اطبع_سطر("نوع الطول: " + نوع_القيمة(الطول))
اطبع_سطر("نوع طالب: " + نوع_القيمة(طالب))

# ── القيمة الفارغة ──
متغير فارغ = لاشيء
اطبع_سطر("نوع فارغ: " + نوع_القيمة(فارغ))

# ── تحويل الأنواع ──
متغير نص_رقمي = "42"
متغير رقم = لرقم(نص_رقمي)
اطبع_سطر("النص '" + نص_رقمي + "' كرقم: " + لنص(رقم + 8))

# ═══════════════════════════════════════════════════════════════════
# 📌 ملخص:
#   - متغير اسم = قيمة → تعريف متغير
#   - ثابت اسم = قيمة → تعريف ثابت (لا يتغير)
#   - الأنواع: رقم، عشري، نص، منطقي (صحيح/خطأ)
#   - نوع_القيمة(س) → معرفة نوع القيمة
#   - لرقم("42") → تحويل نص إلى رقم
#   - لنص(42) → تحويل رقم إلى نص
# ═══════════════════════════════════════════════════════════════════
