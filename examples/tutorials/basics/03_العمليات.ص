# الدرس 3: العمليات الحسابية والمنطقية
# Tutorial 3: Arithmetic and Logic
# المستوى: مبتدئ
# ═══════════════════════════════════════════════════════════════════
# في هذا الدرس ستتعلم:
#   - العمليات الحسابية: +، -، *، /، %، **
#   - عمليات المقارنة: ==، !=، <، >
#   - العمليات المنطقية: و، أو، ليس
#   - الدوال الرياضية المدمجة
# ═══════════════════════════════════════════════════════════════════

# ── العمليات الحسابية الأساسية ──
اطبع_سطر("── العمليات الحسابية ──")
اطبع_سطر("5 + 3 = " + لنص(5 + 3))
اطبع_سطر("10 - 4 = " + لنص(10 - 4))
اطبع_سطر("6 * 7 = " + لنص(6 * 7))
اطبع_سطر("15 / 4 = " + لنص(15 / 4))
اطبع_سطر("17 % 5 = " + لنص(17 % 5))
اطبع_سطر("2 ** 10 = " + لنص(2 ** 10))

# ── أولوية العمليات ──
اطبع_سطر("── أولوية العمليات ──")
اطبع_سطر("2 + 3 * 4 = " + لنص(2 + 3 * 4))
اطبع_سطر("(2 + 3) * 4 = " + لنص((2 + 3) * 4))

# ── عمليات المقارنة ──
اطبع_سطر("── عمليات المقارنة ──")
اطبع_سطر("5 == 5: " + لنص(5 == 5))
اطبع_سطر("5 != 3: " + لنص(5 != 3))
اطبع_سطر("10 > 7: " + لنص(10 > 7))
اطبع_سطر("3 < 8: " + لنص(3 < 8))
اطبع_سطر("5 >= 5: " + لنص(5 >= 5))
اطبع_سطر("4 <= 3: " + لنص(4 <= 3))

# ── العمليات المنطقية ──
اطبع_سطر("── العمليات المنطقية ──")
متغير س = 15
اطبع_سطر("س = " + لنص(س))
اطبع_سطر("س > 10 و س < 20: " + لنص(س > 10 و س < 20))
اطبع_سطر("س < 5 أو س > 10: " + لنص(س < 5 أو س > 10))
اطبع_سطر("ليس (س == 15): " + لنص(ليس (س == 15)))

# ── دوال رياضية مدمجة ──
اطبع_سطر("── دوال رياضية ──")
اطبع_سطر("مطلق(-7): " + لنص(مطلق(-7)))
اطبع_سطر("جذر(144): " + لنص(جذر(144)))
اطبع_سطر("أكبر(3، 9): " + لنص(أكبر(3، 9)))
اطبع_سطر("أصغر(3، 9): " + لنص(أصغر(3، 9)))
اطبع_سطر("أس(2، 8): " + لنص(أس(2، 8)))

# ═══════════════════════════════════════════════════════════════════
# 📌 ملخص:
#   - حسابية: + - * / % **
#   - مقارنة: == != < > <= >=
#   - منطقية: و (AND)، أو (OR)، ليس (NOT)
#   - دوال: مطلق، جذر، أكبر، أصغر، أس
# ═══════════════════════════════════════════════════════════════════
