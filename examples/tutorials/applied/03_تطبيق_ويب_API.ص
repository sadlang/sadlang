# === الجزء 1: نموذج البيانات ===

# قاعدة بيانات الكتب (محاكاة)
متغير كتب = []
متغير عداد_كتب = 0

# إنشاء كتاب
دالة أنشئ_كتاب(عنوان، كاتب، سنة، تصنيف)
    عداد_كتب = عداد_كتب + 1
    ارجع {
        "رقم": عداد_كتب,
        "عنوان": عنوان,
        "كاتب": كاتب,
        "سنة": سنة,
        "تصنيف": تصنيف,
        "متاح": صحيح
    }
نهاية

# === الجزء 2: عمليات CRUD ===

# إنشاء (Create)
دالة أضف_كتاب(عنوان، كاتب، سنة، تصنيف)
    متغير كتاب = أنشئ_كتاب(عنوان، كاتب، سنة، تصنيف)
    كتب = كتب + [كتاب]
    ارجع {"حالة": 201، "رسالة": "تم إنشاء الكتاب"، "بيانات": كتاب}
نهاية

# قراءة الكل (Read All)
دالة احصل_كل_الكتب()
    ارجع {"حالة": 200، "عدد": عداد_كتب، "بيانات": كتب}
نهاية

# قراءة كتاب واحد (Read One)
دالة احصل_كتاب(رقم)
    لكل كتاب في كتب
        إذا (كتاب["رقم"] == رقم)
            ارجع {"حالة": 200، "بيانات": كتاب}
        نهاية
    نهاية
    ارجع {"حالة": 404، "رسالة": "كتاب غير موجود"}
نهاية

# حذف (Delete)
دالة احذف_كتاب(رقم)
    متغير كتب_جديدة = []
    متغير وُجد = خطأ
    لكل كتاب في كتب
        إذا (كتاب["رقم"] == رقم)
            وُجد = صحيح
        وإلا
            كتب_جديدة = كتب_جديدة + [كتاب]
        نهاية
    نهاية
    إذا (وُجد)
        كتب = كتب_جديدة
        ارجع {"حالة": 200، "رسالة": "تم حذف الكتاب"}
    نهاية
    ارجع {"حالة": 404، "رسالة": "كتاب غير موجود"}
نهاية

# === الجزء 3: البحث والتصفية ===

# بحث بالعنوان
دالة ابحث_بالعنوان(كلمة)
    متغير نتائج = []
    لكل كتاب في كتب
        # بحث بسيط — في التطبيق الحقيقي نستخدم contains
        إذا (كتاب["عنوان"] == كلمة)
            نتائج = نتائج + [كتاب]
        نهاية
    نهاية
    ارجع {"حالة": 200، "عدد_النتائج": 0، "بيانات": نتائج}
نهاية

# تصفية بالتصنيف
دالة صفّ_بالتصنيف(تصنيف)
    متغير نتائج = []
    لكل كتاب في كتب
        إذا (كتاب["تصنيف"] == تصنيف)
            نتائج = نتائج + [كتاب]
        نهاية
    نهاية
    ارجع {"حالة": 200، "بيانات": نتائج}
نهاية

# تصفية بالكاتب
دالة كتب_الكاتب(اسم_كاتب)
    متغير نتائج = []
    لكل كتاب في كتب
        إذا (كتاب["كاتب"] == اسم_كاتب)
            نتائج = نتائج + [كتاب]
        نهاية
    نهاية
    ارجع {"حالة": 200، "بيانات": نتائج}
نهاية

# === الجزء 4: محاكاة API Router ===

دالة عالج_طلب(طريقة، مسار، بيانات)
    اطبع_سطر("─────────────────────────────")
    اطبع_سطر("📡 " + طريقة + " " + مسار)
    
    متغير استجابة = لاشيء
    
    إذا (طريقة == "GET" و مسار == "/كتب")
        استجابة = احصل_كل_الكتب()
    نهاية
    
    إذا (طريقة == "POST" و مسار == "/كتب")
        استجابة = أضف_كتاب(بيانات["عنوان"]، بيانات["كاتب"]، بيانات["سنة"]، بيانات["تصنيف"])
    نهاية
    
    إذا (طريقة == "DELETE" و مسار == "/كتب")
        استجابة = احذف_كتاب(بيانات["رقم"])
    نهاية
    
    إذا (استجابة == لاشيء)
        استجابة = {"حالة": 404، "رسالة": "مسار غير موجود"}
    نهاية
    
    اطبع_سطر("  ← الحالة: " + استجابة["حالة"])
    إذا (استجابة["حالة"] < 300)
        اطبع_سطر("  ← نجاح ✓")
    وإلا
        اطبع_سطر("  ← خطأ ✗")
    نهاية
    ارجع استجابة
نهاية

# === تشغيل التطبيق ===
اطبع_سطر("╔══════════════════════════════════╗")
اطبع_سطر("║   واجهة برمجة المكتبة بلغة ص   ║")
اطبع_سطر("╚══════════════════════════════════╝")
اطبع_سطر("")

# إضافة كتب
عالج_طلب("POST"، "/كتب"، {"عنوان": "تعلم لغة ص"، "كاتب": "أحمد"، "سنة": 2026، "تصنيف": "برمجة"})
عالج_طلب("POST"، "/كتب"، {"عنوان": "الخوارزميات"، "كاتب": "سارة"، "سنة": 2025، "تصنيف": "برمجة"})
عالج_طلب("POST"، "/كتب"، {"عنوان": "الذكاء الاصطناعي"، "كاتب": "أحمد"، "سنة": 2024، "تصنيف": "علوم"})

# جلب الكل
اطبع_سطر("")
عالج_طلب("GET"، "/كتب"، لاشيء)

# تصفية
اطبع_سطر("")
اطبع_سطر("─────────────────────────────")
اطبع_سطر("📚 كتب التصنيف 'برمجة':")
متغير برمجة = صفّ_بالتصنيف("برمجة")
لكل كتاب في برمجة["بيانات"]
    اطبع_سطر("  • " + كتاب["عنوان"] + " — " + كتاب["كاتب"])
نهاية

اطبع_سطر("")
اطبع_سطر("📚 كتب الكاتب 'أحمد':")
متغير كتب_أحمد = كتب_الكاتب("أحمد")
لكل كتاب في كتب_أحمد["بيانات"]
    اطبع_سطر("  • " + كتاب["عنوان"] + " (" + كتاب["سنة"] + ")")
نهاية

# حذف كتاب
اطبع_سطر("")
عالج_طلب("DELETE"، "/كتب"، {"رقم": 2})

# التحقق
اطبع_سطر("")
متغير النتيجة = احصل_كل_الكتب()
اطبع_سطر("عدد الكتب بعد الحذف: " + النتيجة["عدد"])

# الخاتمة
اطبع_سطر("")
اطبع_سطر("════════════════════════════════")
اطبع_سطر("🎉 مبروك! بنيت واجهة API كاملة")
اطبع_سطر("════════════════════════════════")
اطبع_سطر("الخطوة التالية: الدرس 04 — تطبيق هاتف")
