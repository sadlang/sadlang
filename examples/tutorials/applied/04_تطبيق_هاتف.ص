# === الجزء 1: نظام المكونات ===

# مكون أساسي
دالة أنشئ_مكون(نوع، خصائص، أبناء)
    ارجع {
        "نوع": نوع,
        "خصائص": خصائص,
        "أبناء": أبناء
    }
نهاية

# مكونات واجهة المستخدم
دالة نص_عنوان(محتوى)
    ارجع أنشئ_مكون("نص"، {"حجم": 24، "لون": "أسود"، "سميك": صحيح}، محتوى)
نهاية

دالة نص_عادي(محتوى)
    ارجع أنشئ_مكون("نص"، {"حجم": 16، "لون": "رمادي"، "سميك": خطأ}، محتوى)
نهاية

دالة زر(عنوان، عند_الضغط)
    ارجع أنشئ_مكون("زر"، {"عنوان": عنوان، "لون_خلفية": "أزرق"، "عند_الضغط": عند_الضغط}، لاشيء)
نهاية

دالة بطاقة(عنوان، وصف، لون)
    ارجع أنشئ_مكون("بطاقة"، {"لون": لون}، [نص_عنوان(عنوان)، نص_عادي(وصف)])
نهاية

# === الجزء 2: إدارة الحالة ===

# حالة التطبيق
متغير حالة_التطبيق = {
    "الشاشة_الحالية": "الرئيسية",
    "المستخدم": لاشيء,
    "المهام": [],
    "عداد_المهام": 0,
    "الوضع_الداكن": خطأ
}

# تحديث الحالة
دالة حدّث_الحالة(مفتاح، قيمة)
    حالة_التطبيق[مفتاح] = قيمة
    اطبع_سطر("  🔄 تحديث: " + مفتاح)
نهاية

# === الجزء 3: شاشة تسجيل الدخول ===

دالة شاشة_الدخول()
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════╗")
    اطبع_سطر("║    تسجيل الدخول         ║")
    اطبع_سطر("╠══════════════════════════╣")
    اطبع_سطر("║  👤 اسم المستخدم: أحمد  ║")
    اطبع_سطر("║  🔑 كلمة المرور: ****   ║")
    اطبع_سطر("║  [  دخول  ]             ║")
    اطبع_سطر("╚══════════════════════════╝")
    
    # محاكاة تسجيل الدخول
    حدّث_الحالة("المستخدم"، {"اسم": "أحمد"، "بريد": "ahmed@example.com"})
    حدّث_الحالة("الشاشة_الحالية"، "الرئيسية")
    اطبع_سطر("  ✓ تم تسجيل الدخول بنجاح!")
نهاية

# === الجزء 4: الشاشة الرئيسية ===

دالة أضف_مهمة_هاتف(عنوان)
    حالة_التطبيق["عداد_المهام"] = حالة_التطبيق["عداد_المهام"] + 1
    متغير مهمة = {
        "رقم": حالة_التطبيق["عداد_المهام"],
        "عنوان": عنوان,
        "مكتملة": خطأ
    }
    حالة_التطبيق["المهام"] = حالة_التطبيق["المهام"] + [مهمة]
نهاية

دالة شاشة_الرئيسية()
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════╗")
    اطبع_سطر("║  📱 تطبيق المهام         ║")
    اطبع_سطر("╠══════════════════════════╣")
    
    متغير مستخدم = حالة_التطبيق["المستخدم"]
    اطبع_سطر("║  مرحباً " + مستخدم["اسم"] + "!     ║")
    اطبع_سطر("╠══════════════════════════╣")
    
    إذا (حالة_التطبيق["المهام"] == [])
        اطبع_سطر("║  لا توجد مهام بعد       ║")
    وإلا
        لكل مهمة في حالة_التطبيق["المهام"]
            متغير رمز = "○"
            إذا (مهمة["مكتملة"])
                رمز = "●"
            نهاية
            اطبع_سطر("║  " + رمز + " " + مهمة["عنوان"])
        نهاية
    نهاية
    
    اطبع_سطر("╠══════════════════════════╣")
    اطبع_سطر("║  [+] إضافة  [⚙] إعدادات ║")
    اطبع_سطر("╚══════════════════════════╝")
نهاية

# === الجزء 5: شاشة الإعدادات ===

دالة شاشة_الإعدادات()
    اطبع_سطر("")
    اطبع_سطر("╔══════════════════════════╗")
    اطبع_سطر("║  ⚙ الإعدادات            ║")
    اطبع_سطر("╠══════════════════════════╣")
    
    متغير وضع = "فاتح ☀️"
    إذا (حالة_التطبيق["الوضع_الداكن"])
        وضع = "داكن 🌙"
    نهاية
    
    اطبع_سطر("║  🎨 المظهر: " + وضع)
    اطبع_سطر("║  🌐 اللغة: العربية")
    اطبع_سطر("║  🔔 الإشعارات: مفعّلة")
    اطبع_سطر("║  📦 الإصدار: 1.0.0")
    اطبع_سطر("╠══════════════════════════╣")
    اطبع_سطر("║  [← رجوع]               ║")
    اطبع_سطر("╚══════════════════════════╝")
نهاية

# === الجزء 6: التنقل بين الشاشات ===

دالة انتقل_إلى(شاشة)
    اطبع_سطر("")
    اطبع_سطر("📱 الانتقال إلى: " + شاشة)
    حدّث_الحالة("الشاشة_الحالية"، شاشة)
    
    إذا (شاشة == "دخول")
        شاشة_الدخول()
    نهاية
    إذا (شاشة == "الرئيسية")
        شاشة_الرئيسية()
    نهاية
    إذا (شاشة == "الإعدادات")
        شاشة_الإعدادات()
    نهاية
نهاية

# === تشغيل التطبيق ===
اطبع_سطر("🚀 تشغيل التطبيق...")

# 1. تسجيل الدخول
انتقل_إلى("دخول")

# 2. الشاشة الرئيسية (فارغة)
انتقل_إلى("الرئيسية")

# 3. إضافة مهام
اطبع_سطر("")
اطبع_سطر("➕ إضافة مهام...")
أضف_مهمة_هاتف("إكمال الدرس")
أضف_مهمة_هاتف("بناء تطبيق")
أضف_مهمة_هاتف("نشر المشروع")

# 4. الشاشة الرئيسية مع المهام
انتقل_إلى("الرئيسية")

# 5. الإعدادات
انتقل_إلى("الإعدادات")

# 6. تغيير الوضع
اطبع_سطر("")
حدّث_الحالة("الوضع_الداكن"، صحيح)
انتقل_إلى("الإعدادات")

