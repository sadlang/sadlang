# === الجزء 1: العمليات الأساسية ===

دالة جمع(أ، ب)
    ارجع أ + ب
نهاية

دالة طرح(أ، ب)
    ارجع أ - ب
نهاية

دالة ضرب(أ، ب)
    ارجع أ * ب
نهاية

دالة قسمة(أ، ب)
    إذا (ب == 0)
        اطبع_سطر("⚠️ خطأ: لا يمكن القسمة على صفر!")
        ارجع لاشيء
    نهاية
    ارجع أ / ب
نهاية

# === الجزء 2: عمليات متقدمة ===

دالة الأس(قاعدة، أس)
    متغير نتيجة = 1
    متغير ع = 0
    بينما (ع < أس)
        نتيجة = نتيجة * قاعدة
        ع = ع + 1
    نهاية
    ارجع نتيجة
نهاية

دالة القيمة_المطلقة(رقم)
    إذا (رقم < 0)
        ارجع -رقم
    نهاية
    ارجع رقم
نهاية

دالة المضاعف(رقم)
    ارجع رقم * 2
نهاية

دالة المربع(رقم)
    ارجع رقم * رقم
نهاية

دالة المكعب(رقم)
    ارجع رقم * رقم * رقم
نهاية

# === الجزء 3: عمليات على القوائم ===

دالة مجموع_قائمة(قائمة)
    متغير مجموع = 0
    لكل عنصر في قائمة
        مجموع = مجموع + عنصر
    نهاية
    ارجع مجموع
نهاية

دالة متوسط_قائمة(قائمة)
    متغير مجموع = مجموع_قائمة(قائمة)
    متغير عدد = 0
    لكل ع في قائمة
        عدد = عدد + 1
    نهاية
    إذا (عدد == 0)
        ارجع 0
    نهاية
    ارجع مجموع / عدد
نهاية

دالة أكبر_عنصر(قائمة)
    متغير أكبر = قائمة[0]
    لكل عنصر في قائمة
        إذا (عنصر > أكبر)
            أكبر = عنصر
        نهاية
    نهاية
    ارجع أكبر
نهاية

دالة أصغر_عنصر(قائمة)
    متغير أصغر = قائمة[0]
    لكل عنصر في قائمة
        إذا (عنصر < أصغر)
            أصغر = عنصر
        نهاية
    نهاية
    ارجع أصغر
نهاية

# === الجزء 4: تنفيذ عملية ===

دالة نفّذ_عملية(عملية، أ، ب)
    إذا (عملية == "+")
        ارجع جمع(أ، ب)
    نهاية
    إذا (عملية == "-")
        ارجع طرح(أ، ب)
    نهاية
    إذا (عملية == "*")
        ارجع ضرب(أ، ب)
    نهاية
    إذا (عملية == "/")
        ارجع قسمة(أ، ب)
    نهاية
    إذا (عملية == "**")
        ارجع الأس(أ، ب)
    نهاية
    اطبع_سطر("⚠️ عملية غير معروفة: " + عملية)
    ارجع لاشيء
نهاية

# === تشغيل الآلة الحاسبة ===
اطبع_سطر("╔══════════════════════╗")
اطبع_سطر("║   آلة حاسبة بلغة ص  ║")
اطبع_سطر("╚══════════════════════╝")

# عمليات أساسية
اطبع_سطر("")
اطبع_سطر("--- العمليات الأساسية ---")
اطبع_سطر("10 + 3 = " + نفّذ_عملية("+"، 10، 3))
اطبع_سطر("10 - 3 = " + نفّذ_عملية("-"، 10، 3))
اطبع_سطر("10 * 3 = " + نفّذ_عملية("*"، 10، 3))
اطبع_سطر("10 / 3 = " + نفّذ_عملية("/"، 10، 3))
اطبع_سطر("2 ** 8 = " + نفّذ_عملية("**"، 2، 8))

# القسمة على صفر
اطبع_سطر("")
اطبع_سطر("--- حالة خاصة ---")
نفّذ_عملية("/"، 5، 0)

# عمليات متقدمة
اطبع_سطر("")
اطبع_سطر("--- عمليات متقدمة ---")
اطبع_سطر("|-7| = " + القيمة_المطلقة(-7))
اطبع_سطر("مربع 9 = " + المربع(9))
اطبع_سطر("مكعب 3 = " + المكعب(3))

# عمليات على القوائم
اطبع_سطر("")
اطبع_سطر("--- عمليات القوائم ---")
متغير أرقام = [15، 8، 23، 4، 42، 16، 7]
اطبع_سطر("الأرقام: " + أرقام)
اطبع_سطر("المجموع: " + مجموع_قائمة(أرقام))
اطبع_سطر("المتوسط: " + متوسط_قائمة(أرقام))
اطبع_سطر("الأكبر: " + أكبر_عنصر(أرقام))
اطبع_سطر("الأصغر: " + أصغر_عنصر(أرقام))

