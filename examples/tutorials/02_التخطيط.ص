متغير نص1 = نص_عرض("البطاقة الأولى")
أضف_ابن(بطاقة1، نص1)

# البطاقة الثانية
متغير بطاقة2 = بطاقة()
عين_الحشوة(بطاقة2، 12.0، 12.0، 12.0، 12.0)
متغير نص2 = نص_عرض("البطاقة الثانية")
أضف_ابن(بطاقة2، نص2)

أضف_ابن(صف_البطاقات، بطاقة1)
أضف_ابن(صف_البطاقات، بطاقة2)
أضف_ابن(الرئيسي، صف_البطاقات)

# ─── القسم 4: خط فاصل + نص ───
متغير الفاصل = خط_فاصل()
أضف_ابن(الرئيسي، الفاصل)

متغير نص_نهاية = نص_عرض("─ نهاية المثال ─")
أضف_ابن(الرئيسي، نص_نهاية)

